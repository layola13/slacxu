// Converted 1:1 from sdk-frontend/src/index.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.

@import "sa_std/ptr.sa"
@import "web.sla"
@import "feature.sla"
@import "workbenchTypes.sla"
@import "waterfallTypes.sla"
@import "jevConfig.sla"

// PluginManifest (shared plugin.json schema) -- same shape as
// the backend SDK's manifest; carried as JSON text:
// { id, kind, version, displayName, sides: { server, web },
//   defaultInstalled,
//   presentation?: { label, icon, labelKey? },
//   capabilities: { history, compaction, slashCommandForwarding,
//     skills, mcp, fileParts, permissionRoundTrips } }
//
// TranslationKey = string
// TranslateFn = (key, values?) => string  (host function value)
// DEFECT: function values have no SLA counterpart; the translate
// function is a host-provided fn-id in this conversion.

// WebPluginRegistry: Map<string, WebPlugin> with duplicate-id
// throw. A WebPlugin value is its JSON text (manifest +
// descriptor + linkage + classification + contributions).
struct WebPluginEntry {
    id: [u8; 128],
    id_len: u64,
    plugin_json: [u8; 32768],
    plugin_json_len: u64,
    defaultInstalled: bool,
    used: bool,
}

struct WebPluginRegistry {
    entries: [WebPluginEntry; 64],
    count: u64,
}

fn webRegistry_new(reg: &WebPluginRegistry) -> void {
    reg.count = 0;
    for i in 0..64 {
        reg.entries[i].used = false;
        reg.entries[i].id_len = 0;
        reg.entries[i].plugin_json_len = 0;
        reg.entries[i].defaultInstalled = false;
    }
}

fn webRegistry_find(reg: &WebPluginRegistry, id_ptr: ptr, id_len: u64) -> u64 {
    for i in 0..reg.count {
        if reg.entries[i].used {
            let ep: ptr = PTR_NULL();
            PTR_BYTE_ADD(ep, &reg.entries[i].id, 0);
            if id_len == reg.entries[i].id_len {
                let same = true;
                for j in 0..id_len {
                    let a: u8 = 0;
                    let b: u8 = 0;
                    PTR_BYTE_AT(a, id_ptr, j);
                    PTR_BYTE_AT(b, ep, j);
                    if a != b { same = false; break; };
                }
                if same { return i + 1; };
            };
        };
    }
    return 0;
}

// register: status 5 = duplicate id (TS throws)
fn webRegistry_register(reg: &WebPluginRegistry, id_ptr: ptr, id_len: u64, json_ptr: ptr, json_len: u64, default_installed: bool) -> i32 {
    if webRegistry_find(reg, id_ptr, id_len) != 0 { return 5; };
    if reg.count >= 64 { return 5; };
    let slot = reg.count;
    reg.entries[slot].used = true;
    reg.entries[slot].id_len = id_len;
    for j in 0..id_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, id_ptr, j);
        reg.entries[slot].id[j] = b;
    }
    reg.entries[slot].plugin_json_len = json_len;
    for j in 0..json_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, json_ptr, j);
        reg.entries[slot].plugin_json[j] = b;
    }
    reg.entries[slot].defaultInstalled = default_installed;
    reg.count = reg.count + 1;
    return 0;
}

fn webRegistry_unregister(reg: &WebPluginRegistry, id_ptr: ptr, id_len: u64) -> bool {
    let f = webRegistry_find(reg, id_ptr, id_len);
    if f == 0 { return false; };
    reg.entries[f - 1].used = false;
    return true;
}

// get: status 0 + copies the plugin JSON out; 1 = undefined
fn webRegistry_get(reg: &WebPluginRegistry, id_ptr: ptr, id_len: u64, out: &[u8; 32768], out_len: &u64) -> i32 {
    let f = webRegistry_find(reg, id_ptr, id_len);
    if f == 0 { return 1; };
    let n = reg.entries[f - 1].plugin_json_len;
    *out_len = n;
    for j in 0..n {
        out[j] = reg.entries[f - 1].plugin_json[j];
    }
    return 0;
}

fn webRegistry_has(reg: &WebPluginRegistry, id_ptr: ptr, id_len: u64) -> bool {
    return webRegistry_find(reg, id_ptr, id_len) != 0;
}

// ids(): newline-joined into out (cap 8192)
fn webRegistry_ids(reg: &WebPluginRegistry, out: &[u8; 8192], out_len: &u64) -> void {
    let n: u64 = 0;
    for i in 0..reg.count {
        if reg.entries[i].used {
            for j in 0..reg.entries[i].id_len {
                if n < 8191 {
                    out[n] = reg.entries[i].id[j];
                    n = n + 1;
                };
            }
            if n < 8192 {
                out[n] = 10;
                n = n + 1;
            };
        };
    }
    *out_len = n;
}

// defaultPlugin: first entry whose manifest.defaultInstalled
fn webRegistry_defaultPlugin(reg: &WebPluginRegistry, out: &[u8; 32768], out_len: &u64) -> i32 {
    for i in 0..reg.count {
        if reg.entries[i].used && reg.entries[i].defaultInstalled {
            let n = reg.entries[i].plugin_json_len;
            *out_len = n;
            for j in 0..n {
                out[j] = reg.entries[i].plugin_json[j];
            }
            return 0;
        };
    }
    return 1;
}
