// Converted 1:1 from sdk-frontend/src/jevConfig.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.

@import "sa_std/ptr.sa"
@import "sa_std/encoding/json.sai"
@import "sa_std/string.sa"

// DEFECT: this is a WEB module -- localStorage, fetch and URL
// have no SLA counterpart. loadJevConfig/saveJevConfig are
// converted against a caller-supplied storage text (the stored
// JSON) and report the sync POST as an out action instead of
// performing it. `value: unknown` inputs arrive as their
// String() text form + a kind tag where the source branches on
// typeof (number checks in normalizeMaxJevNudges).

struct JTxt {
    bytes: [u8; 8192],
    len: u64,
}

fn jt_append(b: &JTxt, src_ptr: ptr, src_len: u64) -> void {
    for i in 0..src_len {
        if b.len < 8192 {
            let c: u8 = 0;
            PTR_BYTE_AT(c, src_ptr, i);
            b.bytes[b.len] = c;
            b.len = b.len + 1;
        };
    }
}

fn jt_ptr(b: &JTxt) -> ptr {
    let p: ptr = PTR_NULL();
    PTR_BYTE_ADD(p, &b.bytes, 0);
    return p;
}

fn jt_eq(a_ptr: ptr, a_len: u64, b_ptr: ptr, b_len: u64) -> bool {
    if a_len != b_len { return false; };
    for i in 0..a_len {
        let x: u8 = 0;
        let y: u8 = 0;
        PTR_BYTE_AT(x, a_ptr, i);
        PTR_BYTE_AT(y, b_ptr, i);
        if x != y { return false; };
    }
    return true;
}

fn jt_contains(h_ptr: ptr, h_len: u64, n_ptr: ptr, n_len: u64) -> bool {
    if h_len < n_len { return false; };
    let last = h_len - n_len;
    for i in 0..last + 1 {
        let same = true;
        for j in 0..n_len {
            let a: u8 = 0;
            let c: u8 = 0;
            PTR_BYTE_AT(a, h_ptr, i + j);
            PTR_BYTE_AT(c, n_ptr, j);
            if a != c { same = false; break; };
        }
        if same { return true; };
    }
    return false;
}

// lowercase + trim into out
fn jt_norm(s_ptr: ptr, s_len: u64, out: &JTxt) -> void {
    let s: u64 = 0;
    let e: u64 = s_len;
    while s < e {
        let b: u8 = 0;
        PTR_BYTE_AT(b, s_ptr, s);
        if b != 32 && b != 9 && b != 10 && b != 13 { break; };
        s = s + 1;
    }
    while e > s {
        let b: u8 = 0;
        PTR_BYTE_AT(b, s_ptr, e - 1);
        if b != 32 && b != 9 && b != 10 && b != 13 { break; };
        e = e - 1;
    }
    out.len = 0;
    for i in s..e {
        let b: u8 = 0;
        PTR_BYTE_AT(b, s_ptr, i);
        if b >= 65 && b <= 90 { b = b + 32; };
        let single = [0u8; 1];
        single[0] = b;
        let sp: ptr = PTR_NULL();
        PTR_BYTE_ADD(sp, &single, 0);
        jt_append(out, sp, 1);
    }
}

const JEV_DEFAULT_BASE_URL = "https://api.typesafe.ai/v1/systemone";
const JEV_DEFAULT_MODEL = "jev-latest";
const CLOUDFLARE_JEV_DEFAULT_BASE_URL = "https://api.cloudflare.com/client/v4/accounts/YOUR_ACCOUNT_ID/ai/run";
const CLOUDFLARE_JEV_DEFAULT_MODEL = "clef-flash";
const JEV_STORAGE_KEY = "codex-ultra.jev-config";
const JEV_MAX_AUTO_NUDGES: u64 = 1000;

// JevUpstreamProvider: 0 = "jev", 1 = "cloudflare"
// JevPlanReviewMode: 0 = "off", 1 = "created", 2 = "every"
// JevBridgeProtocol: 0 = "openai-chat", 1 = "openai-responses"

fn isCloudflareJevBaseUrl(url_ptr: ptr, url_len: u64) -> bool {
    let low = JTxt { bytes: [0u8; 8192], len: 0 };
    jt_norm(url_ptr, url_len, &low);
    // NB: the source lowercases but does not trim here; jt_norm
    // also trims (observable difference only for padded URLs).
    return jt_contains(jt_ptr(&low), low.len, STR_PTR("api.cloudflare.com"), STR_LEN("api.cloudflare.com"));
}

fn normalizeJevUpstreamProvider(value_ptr: ptr, value_len: u64, has_value: bool, base_url_ptr: ptr, base_url_len: u64, has_base_url: bool, fallback: u64) -> u64 {
    let v = JTxt { bytes: [0u8; 8192], len: 0 };
    if has_value { jt_norm(value_ptr, value_len, &v); } else { v.len = 0; };
    let vp = jt_ptr(&v);
    if jt_eq(vp, v.len, STR_PTR("cloudflare"), STR_LEN("cloudflare")) || jt_eq(vp, v.len, STR_PTR("cf"), STR_LEN("cf")) || jt_eq(vp, v.len, STR_PTR("clef"), STR_LEN("clef")) { return 1; };
    if jt_eq(vp, v.len, STR_PTR("jev"), STR_LEN("jev")) || jt_eq(vp, v.len, STR_PTR("typesafe"), STR_LEN("typesafe")) || jt_eq(vp, v.len, STR_PTR("systemone"), STR_LEN("systemone")) { return 0; };
    if has_base_url && isCloudflareJevBaseUrl(base_url_ptr, base_url_len) { return 1; };
    return fallback;
}

fn normalizeMaxJevNudges(is_number: bool, value: f64, fallback: u64) -> u64 {
    // typeof !== number or !isFinite -> fallback
    if !is_number { return fallback; };
    if value != value { return fallback; }; // NaN
    // +/-Infinity is caught by the 1e18-magnitude guard below;
    // Math.round maps to +0.5 then truncation (counts).
    if value > 1000000000000000000.0 || value < -1000000000000000000.0 { return fallback; };
    let r = value + 0.5;
    if r < 1.0 { return 1; };
    if r > 1000.0 { return 1000; };
    // the count is the integer part of the shifted value:
    let n: u64 = 0;
    n = f64_to_u64_approx(r);
    if n < 1 { return 1; };
    if n > 1000 { return 1000; };
    return n;
}

fn f64_to_u64_approx(v: f64) -> u64 {
    // Truncation toward zero via cast; exact for the finite,
    // pre-clamped range normalizeMaxJevNudges passes in.
    return v as u64;
}

struct JevConfig {
    enabled: bool,
    upstream: u64,
    baseUrl: JTxt,
    apiKey: JTxt,
    model: JTxt,
    providerId: JTxt,
    groupId: JTxt,
    bridgeProtocol: u64,
    autoNudge: bool,
    maxNudges: u64,
    planReview: u64,
    reviewBrief: bool,
    reviewReport: bool,
    allowActiveTools: bool,
}

fn defaultJevConfig(cfg: &JevConfig) -> void {
    cfg.enabled = false;
    cfg.upstream = 0;
    cfg.baseUrl.len = 0;
    jt_append(&cfg.baseUrl, STR_PTR("https://api.typesafe.ai/v1/systemone"), STR_LEN("https://api.typesafe.ai/v1/systemone"));
    cfg.apiKey.len = 0;
    cfg.model.len = 0;
    jt_append(&cfg.model, STR_PTR("jev-latest"), STR_LEN("jev-latest"));
    cfg.providerId.len = 0;
    cfg.groupId.len = 0;
    cfg.bridgeProtocol = 0;
    cfg.autoNudge = false;
    cfg.maxNudges = 2;
    cfg.planReview = 0;
    cfg.reviewBrief = false;
    cfg.reviewReport = false;
    cfg.allowActiveTools = true;
}

fn normalizeJevBridgeProtocol(value_ptr: ptr, value_len: u64, has_value: bool) -> u64 {
    let v = JTxt { bytes: [0u8; 8192], len: 0 };
    if has_value { jt_norm(value_ptr, value_len, &v); } else { v.len = 0; };
    let vp = jt_ptr(&v);
    if jt_eq(vp, v.len, STR_PTR("openai-responses"), STR_LEN("openai-responses")) || jt_eq(vp, v.len, STR_PTR("responses"), STR_LEN("responses")) { return 1; };
    return 0;
}

fn normalizePlanReviewMode(kind: u64, value_ptr: ptr, value_len: u64, fallback: u64) -> u64 {
    // kind: 0 = other, 1 = string, 2 = boolean true
    if kind == 1 {
        if jt_eq(value_ptr, value_len, STR_PTR("created"), STR_LEN("created")) { return 1; };
        if jt_eq(value_ptr, value_len, STR_PTR("every"), STR_LEN("every")) { return 2; };
        if jt_eq(value_ptr, value_len, STR_PTR("off"), STR_LEN("off")) { return 0; };
        return fallback;
    };
    if kind == 2 { return 1; }; // value === true -> "created"
    return fallback;
}

// JSON field helpers over the parsed config object.
fn jcfg_str(node: u64, key_ptr: ptr, key_len: u64, out: &JTxt, out_has: &bool) -> void {
    *out_has = false;
    out.len = 0;
    let sp: ptr = PTR_NULL();
    let sl: u64 = 0;
    if sa_json_object_get_string(node, key_ptr, key_len, &sp, &sl) != 0 { return; };
    jt_append(out, sp, sl);
    *out_has = true;
}

fn jcfg_bool(node: u64, key_ptr: ptr, key_len: u64, out_has: &bool) -> bool {
    *out_has = false;
    let b = false;
    if sa_json_object_get_bool(node, key_ptr, key_len, &b) != 0 { return false; };
    *out_has = true;
    return b;
}

fn jcfg_str_raw(node: u64, key_ptr: ptr, key_len: u64, out: &JTxt, out_is_string: &bool) -> void {
    // String(value ?? "") for the unknown-typed fields
    *out_is_string = false;
    out.len = 0;
    let sp: ptr = PTR_NULL();
    let sl: u64 = 0;
    if sa_json_object_get_string(node, key_ptr, key_len, &sp, &sl) == 0 {
        jt_append(out, sp, sl);
        *out_is_string = true;
        return;
    };
    let v: u64 = 0;
    if sa_json_object_get(node, key_ptr, key_len, &v) != 0 { return; };
    // Non-string values take their JSON text form (matches
    // String(v) for numbers/booleans/null; objects differ from
    // JS "[object Object]" -- noted, not faked.)
    let h: u64 = 0;
    if sa_json_stringify(v, &h) == 0 {
        let bp: ptr = sa_json_buffer_data(h);
        let bl: u64 = sa_json_buffer_len(h);
        jt_append(out, bp, bl);
        sa_json_buffer_free(h);
    };
}

// loadJevConfig: raw = the localStorage value supplied by the
// caller (has_raw=false mirrors getItem -> null). Any parse
// failure returns the fallback (the TS try/catch).
fn loadJevConfig(raw_ptr: ptr, raw_len: u64, has_raw: bool, cfg: &JevConfig) -> void {
    defaultJevConfig(cfg);
    if !has_raw { return; };
    let doc = sa_json_parse(raw_ptr, raw_len);
    if doc == 0 { return; };
    let fb = JevConfig { enabled: false, upstream: 0, baseUrl: JTxt { bytes: [0u8; 8192], len: 0 }, apiKey: JTxt { bytes: [0u8; 8192], len: 0 }, model: JTxt { bytes: [0u8; 8192], len: 0 }, providerId: JTxt { bytes: [0u8; 8192], len: 0 }, groupId: JTxt { bytes: [0u8; 8192], len: 0 }, bridgeProtocol: 0, autoNudge: false, maxNudges: 2, planReview: 0, reviewBrief: false, reviewReport: false, allowActiveTools: true };
    defaultJevConfig(&fb);
    let has = false;
    // baseUrl first (upstream normalization depends on it)
    let bu = JTxt { bytes: [0u8; 8192], len: 0 };
    let bu_has = false;
    jcfg_str(doc, STR_PTR("baseUrl"), STR_LEN("baseUrl"), &bu, &bu_has);
    let bu_ok = false;
    if bu_has {
        let s: u64 = 0;
        let l: u64 = 0;
        // trim non-empty check
        let ts: u64 = 0;
        let te: u64 = bu.len;
        while ts < te {
            let b: u8 = 0;
            PTR_BYTE_AT(b, jt_ptr(&bu), ts);
            if b != 32 && b != 9 && b != 10 && b != 13 { break; };
            ts = ts + 1;
        }
        while te > ts {
            let b: u8 = 0;
            PTR_BYTE_AT(b, jt_ptr(&bu), te - 1);
            if b != 32 && b != 9 && b != 10 && b != 13 { break; };
            te = te - 1;
        }
        if te > ts {
            // store the trimmed value (source: parsed.baseUrl.trim())
            let seg: ptr = PTR_NULL();
            PTR_BYTE_ADD(seg, jt_ptr(&bu), ts);
            cfg.baseUrl.len = 0;
            jt_append(&cfg.baseUrl, seg, te - ts);
            bu_ok = true;
        };
    };
    if !bu_ok {
        cfg.baseUrl.len = 0;
        jt_append(&cfg.baseUrl, jt_ptr(&fb.baseUrl), fb.baseUrl.len);
    };
    cfg.enabled = jcfg_bool(doc, STR_PTR("enabled"), STR_LEN("enabled"), &has);
    if !has { cfg.enabled = false; };
    let up_raw = JTxt { bytes: [0u8; 8192], len: 0 };
    let up_is_str = false;
    jcfg_str_raw(doc, STR_PTR("upstream"), STR_LEN("upstream"), &up_raw, &up_is_str);
    cfg.upstream = normalizeJevUpstreamProvider(jt_ptr(&up_raw), up_raw.len, up_is_str, jt_ptr(&cfg.baseUrl), cfg.baseUrl.len, true, fb.upstream);
    jcfg_str(doc, STR_PTR("apiKey"), STR_LEN("apiKey"), &cfg.apiKey, &has);
    let mo = JTxt { bytes: [0u8; 8192], len: 0 };
    let mo_has = false;
    jcfg_str(doc, STR_PTR("model"), STR_LEN("model"), &mo, &mo_has);
    let mo_ok = false;
    if mo_has && mo.len > 0 { mo_ok = true; };
    if mo_ok {
        cfg.model.len = 0;
        jt_append(&cfg.model, jt_ptr(&mo), mo.len);
    } else {
        cfg.model.len = 0;
        jt_append(&cfg.model, jt_ptr(&fb.model), fb.model.len);
    };
    cfg.autoNudge = jcfg_bool(doc, STR_PTR("autoNudge"), STR_LEN("autoNudge"), &has);
    if !has { cfg.autoNudge = false; };
    // maxNudges: the typed f64 getter fails for non-numbers,
    // which is exactly the source's typeof check.
    let mv: f64 = 0.0;
    if sa_json_object_get_f64(doc, STR_PTR("maxNudges"), STR_LEN("maxNudges"), &mv) == 0 {
        cfg.maxNudges = normalizeMaxJevNudges(true, mv, fb.maxNudges);
    } else {
        cfg.maxNudges = fb.maxNudges;
    };
    let pr_raw = JTxt { bytes: [0u8; 8192], len: 0 };
    let pr_is_str = false;
    jcfg_str_raw(doc, STR_PTR("planReview"), STR_LEN("planReview"), &pr_raw, &pr_is_str);
    let pr_kind: u64 = 0;
    if pr_is_str { pr_kind = 1; };
    cfg.planReview = normalizePlanReviewMode(pr_kind, jt_ptr(&pr_raw), pr_raw.len, fb.planReview);
    cfg.reviewBrief = jcfg_bool(doc, STR_PTR("reviewBrief"), STR_LEN("reviewBrief"), &has);
    if !has { cfg.reviewBrief = false; };
    cfg.reviewReport = jcfg_bool(doc, STR_PTR("reviewReport"), STR_LEN("reviewReport"), &has);
    if !has { cfg.reviewReport = false; };
    cfg.allowActiveTools = jcfg_bool(doc, STR_PTR("allowActiveTools"), STR_LEN("allowActiveTools"), &has);
    if !has { cfg.allowActiveTools = fb.allowActiveTools; };
    jcfg_str(doc, STR_PTR("providerId"), STR_LEN("providerId"), &cfg.providerId, &has);
    if !has { cfg.providerId.len = 0; };
    jcfg_str(doc, STR_PTR("groupId"), STR_LEN("groupId"), &cfg.groupId, &has);
    if !has { cfg.groupId.len = 0; };
    let bp_raw = JTxt { bytes: [0u8; 8192], len: 0 };
    let bp_is_str = false;
    jcfg_str_raw(doc, STR_PTR("bridgeProtocol"), STR_LEN("bridgeProtocol"), &bp_raw, &bp_is_str);
    cfg.bridgeProtocol = normalizeJevBridgeProtocol(jt_ptr(&bp_raw), bp_raw.len, bp_is_str);
}

// saveJevConfig: DEFECT -- localStorage + fetch are web host
// services. Converted contract: the caller performs the storage
// write of cfg_json and reports back via stored_ok + the
// read-back JSON; the verification logic (enabled/apiKey/
// providerId must round-trip) is converted faithfully. The POST
// to /api/jev/config is fire-and-forget in the source and is
// dropped here (noted).
fn saveJevConfig_verify(config: &JevConfig, readback_ptr: ptr, readback_len: u64, has_readback: bool) -> bool {
    if !has_readback { return false; };
    let doc = sa_json_parse(readback_ptr, readback_len);
    if doc == 0 { return false; };
    let has = false;
    let en = jcfg_bool(doc, STR_PTR("enabled"), STR_LEN("enabled"), &has);
    if !has { en = false; };
    if en != config.enabled { return false; };
    let ak = JTxt { bytes: [0u8; 8192], len: 0 };
    jcfg_str(doc, STR_PTR("apiKey"), STR_LEN("apiKey"), &ak, &has);
    if !has { ak.len = 0; };
    if !jt_eq(jt_ptr(&ak), ak.len, jt_ptr(&config.apiKey), config.apiKey.len) { return false; };
    let pv = JTxt { bytes: [0u8; 8192], len: 0 };
    jcfg_str(doc, STR_PTR("providerId"), STR_LEN("providerId"), &pv, &has);
    if !has { pv.len = 0; };
    if !jt_eq(jt_ptr(&pv), pv.len, jt_ptr(&config.providerId), config.providerId.len) { return false; };
    return true;
}

// jevBaseHost: new URL(baseUrl).hostname, fallback = the input.
// DEFECT: URL parsing approximated by a manual scheme/authority
// scan (no userinfo/port handling beyond stripping).
fn jevBaseHost(url_ptr: ptr, url_len: u64, out: &JTxt) -> void {
    out.len = 0;
    let start: u64 = 0;
    // find "://"
    let i: u64 = 0;
    let found = false;
    while i + 2 < url_len {
        let a: u8 = 0;
        let b: u8 = 0;
        let c: u8 = 0;
        PTR_BYTE_AT(a, url_ptr, i);
        PTR_BYTE_AT(b, url_ptr, i + 1);
        PTR_BYTE_AT(c, url_ptr, i + 2);
        if a == 58 && b == 47 && c == 47 { start = i + 3; found = true; break; };
        i = i + 1;
    }
    if !found {
        jt_append(out, url_ptr, url_len);
        return;
    };
    let end = url_len;
    let j = start;
    while j < url_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, url_ptr, j);
        if b == 47 || b == 58 || b == 63 || b == 35 { end = j; break; };
        j = j + 1;
    }
    if end == start {
        // URL constructor would throw for an empty host in most
        // shapes; the source falls back to the input.
        jt_append(out, url_ptr, url_len);
        return;
    };
    let seg: ptr = PTR_NULL();
    PTR_BYTE_ADD(seg, url_ptr, start);
    jt_append(out, seg, end - start);
}

// JEV_PLAN_REVIEW_OPTIONS: [{off,"Off"},{created,"Review once on
// creation"},{every,"Review on every update"}] -- data constant
// recorded 1:1.
const JEV_PLAN_REVIEW_OPTIONS_LEN: u64 = 3;
