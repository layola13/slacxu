// Converted 1:1 from packages/shared/src/tokenPricing.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
// Conventions: string -> (ptr,len); number -> f64; optional number ->
// f64 + <name>_present flag; readonly arrays -> (ptr,len) slices of structs.

@import "./tokenUsage.sla"
@import "./modelCapabilities.sla"

struct TokenUsageRate {
    model_ptr: ptr,
    model_len: u64,
    inputUsdPerMillion: f64,
    inputUsdPerMillion_present: bool,
    cachedInputUsdPerMillion: f64,
    cachedInputUsdPerMillion_present: bool,
    cacheWriteUsdPerMillion: f64,
    cacheWriteUsdPerMillion_present: bool,
    outputUsdPerMillion: f64,
    outputUsdPerMillion_present: bool,
    multiplier: f64,
    multiplier_present: bool,
    inputMultiplier: f64,
    inputMultiplier_present: bool,
    cacheReadMultiplier: f64,
    cacheReadMultiplier_present: bool,
    cacheWriteMultiplier: f64,
    cacheWriteMultiplier_present: bool,
    outputMultiplier: f64,
    outputMultiplier_present: bool,
}

struct TokenUsageBillingSnapshot {
    inputUsdPerMillion: f64,
    cachedInputUsdPerMillion: f64,
    cacheWriteUsdPerMillion: f64,
    outputUsdPerMillion: f64,
    modelMultiplier: f64,
    inputMultiplier: f64,
    cacheReadMultiplier: f64,
    cacheWriteMultiplier: f64,
    outputMultiplier: f64,
    groupRatio: f64,
}

struct PricedTokenUsage_CostBreakdownUsd {
    input: f64,
    cachedInput: f64,
    cacheWrite: f64,
    output: f64,
}

// PricedTokenUsage = TokenUsageBreakdown & { ... } — intersection
// flattened into one struct (same fields, same order groups).
struct PricedTokenUsage {
    totalTokens: f64,
    inputTokens: f64,
    cachedInputTokens: f64,
    cacheWriteInputTokens: f64,
    outputTokens: f64,
    reasoningOutputTokens: f64,
    estimatedCostUsd: f64,
    estimatedCostUsd_present: bool,
    costBreakdownUsd: PricedTokenUsage_CostBreakdownUsd,
    costBreakdownUsd_present: bool,
    billingSnapshot: TokenUsageBillingSnapshot,
    billingSnapshot_present: bool,
}

// DEFAULT_TOKEN_USAGE_RATES (TS const array of 3 literals).
fn default_token_usage_rates(out: &TokenUsageRate, idx: u64) -> bool {
    if idx == 0 {
        out.model_ptr = STR_PTR("gpt-5.5");
        out.model_len = STR_LEN("gpt-5.5");
        out.inputUsdPerMillion = 5.0; out.inputUsdPerMillion_present = true;
        out.cachedInputUsdPerMillion = 0.5; out.cachedInputUsdPerMillion_present = true;
        out.cacheWriteUsdPerMillion = 5.0; out.cacheWriteUsdPerMillion_present = true;
        out.outputUsdPerMillion = 30.0; out.outputUsdPerMillion_present = true;
        out.multiplier_present = false; out.inputMultiplier_present = false;
        out.cacheReadMultiplier_present = false; out.cacheWriteMultiplier_present = false;
        out.outputMultiplier_present = false;
        return true;
    };
    if idx == 1 {
        out.model_ptr = STR_PTR("gpt-5.4");
        out.model_len = STR_LEN("gpt-5.4");
        out.inputUsdPerMillion = 2.5; out.inputUsdPerMillion_present = true;
        out.cachedInputUsdPerMillion = 0.25; out.cachedInputUsdPerMillion_present = true;
        out.cacheWriteUsdPerMillion = 2.5; out.cacheWriteUsdPerMillion_present = true;
        out.outputUsdPerMillion = 15.0; out.outputUsdPerMillion_present = true;
        out.multiplier_present = false; out.inputMultiplier_present = false;
        out.cacheReadMultiplier_present = false; out.cacheWriteMultiplier_present = false;
        out.outputMultiplier_present = false;
        return true;
    };
    if idx == 2 {
        out.model_ptr = STR_PTR("gpt-5.6-sol");
        out.model_len = STR_LEN("gpt-5.6-sol");
        out.inputUsdPerMillion = 5.0; out.inputUsdPerMillion_present = true;
        out.cachedInputUsdPerMillion = 0.5; out.cachedInputUsdPerMillion_present = true;
        out.cacheWriteUsdPerMillion = 5.0; out.cacheWriteUsdPerMillion_present = true;
        out.outputUsdPerMillion = 30.0; out.outputUsdPerMillion_present = true;
        out.multiplier_present = false; out.inputMultiplier_present = false;
        out.cacheReadMultiplier_present = false; out.cacheWriteMultiplier_present = false;
        out.outputMultiplier_present = false;
        return true;
    };
    return false;
}

fn default_token_usage_rates_len() -> u64 { return 3; }

fn str_eq(a_ptr: ptr, a_len: u64, b_ptr: ptr, b_len: u64) -> bool {
    if a_len != b_len { return false; };
    for i in 0..a_len {
        let x: u8 = 0;
        let y: u8 = 0;
        PTR_BYTE_AT(x, a_ptr, i);
        PTR_BYTE_AT(y, b_ptr, i);
        if x != y { return false; };
    }
    return true;
}

// Array.prototype.find with closure -> sequential scan (DEFECT: closure).
// which: 0 = caller rates, 1 = fallback defaults (materialized via fn above).
fn find_rate(rates_ptr: ptr, rates_len: u64, use_defaults: bool, model_ptr: ptr, model_len: u64, out: &TokenUsageRate) -> bool {
    if use_defaults {
        let n = default_token_usage_rates_len();
        for i in 0..n {
            if default_token_usage_rates(out, i) {
                if str_eq(out.model_ptr, out.model_len, model_ptr, model_len) { return true; };
            };
        }
        return false;
    };
    // DEFECT: slice-of-struct pointer arithmetic assumed
    // (rates_ptr points at a TokenUsageRate array).
    for i in 0..rates_len {
        let r_ptr: ptr = PTR_NULL();
        PTR_ELEM_ADD(r_ptr, rates_ptr, i);
        rate_copy(out, r_ptr);
        if str_eq(out.model_ptr, out.model_len, model_ptr, model_len) { return true; };
    }
    return false;
}

fn rate_copy(dst: &TokenUsageRate, src: ptr) {
    // DEFECT: struct load through raw ptr assumed (fix phase: typed slice API).
    STRUCT_LOAD(dst, src);
}

fn validRate(rate_present: bool, rate: &TokenUsageRate) -> bool {
    return rate_present && rate.inputUsdPerMillion_present && rate.outputUsdPerMillion_present;
}

// resolveTokenUsageRate(rates, model, fallbacks = DEFAULT) -> TokenUsageRate | undefined
// SLA form: returns false for TS undefined. fallbacks encoded as a
// slice; pass use_default_fallbacks=true to use DEFAULT_TOKEN_USAGE_RATES.
// DEFECT: TS object spread merge {...fallback, ...primary} -> field-wise
// merge below; default parameter -> explicit flag.
fn resolveTokenUsageRate(rates_ptr: ptr, rates_len: u64, model_ptr: ptr, model_len: u64, fb_ptr: ptr, fb_len: u64, use_default_fallbacks: bool, out: &TokenUsageRate) -> bool {
    // model.trim() + stripModelContextVariant(...).baseModel
    let trimmed_ptr: ptr = model_ptr;
    let trimmed_len: u64 = model_len;
    str_trim(model_ptr, model_len, &trimmed_ptr, &trimmed_len);
    let base_ptr: ptr = PTR_NULL();
    let base_len: u64 = 0;
    let cw: f64 = 0.0;
    let has_cw = false;
    stripModelContextVariant(trimmed_ptr, trimmed_len, &base_ptr, &base_len, &cw, &has_cw);
    let primary = TokenUsageRate { model_ptr: PTR_NULL(), model_len: 0, inputUsdPerMillion: 0.0, inputUsdPerMillion_present: false, cachedInputUsdPerMillion: 0.0, cachedInputUsdPerMillion_present: false, cacheWriteUsdPerMillion: 0.0, cacheWriteUsdPerMillion_present: false, outputUsdPerMillion: 0.0, outputUsdPerMillion_present: false, multiplier: 0.0, multiplier_present: false, inputMultiplier: 0.0, inputMultiplier_present: false, cacheReadMultiplier: 0.0, cacheReadMultiplier_present: false, cacheWriteMultiplier: 0.0, cacheWriteMultiplier_present: false, outputMultiplier: 0.0, outputMultiplier_present: false };
    let has_primary = find_rate(rates_ptr, rates_len, false, trimmed_ptr, trimmed_len, &primary);
    if !has_primary { has_primary = find_rate(rates_ptr, rates_len, false, base_ptr, base_len, &primary); };
    let fallback = TokenUsageRate { model_ptr: PTR_NULL(), model_len: 0, inputUsdPerMillion: 0.0, inputUsdPerMillion_present: false, cachedInputUsdPerMillion: 0.0, cachedInputUsdPerMillion_present: false, cacheWriteUsdPerMillion: 0.0, cacheWriteUsdPerMillion_present: false, outputUsdPerMillion: 0.0, outputUsdPerMillion_present: false, multiplier: 0.0, multiplier_present: false, inputMultiplier: 0.0, inputMultiplier_present: false, cacheReadMultiplier: 0.0, cacheReadMultiplier_present: false, cacheWriteMultiplier: 0.0, cacheWriteMultiplier_present: false, outputMultiplier: 0.0, outputMultiplier_present: false };
    let has_fallback = find_rate(fb_ptr, fb_len, use_default_fallbacks, trimmed_ptr, trimmed_len, &fallback);
    if !has_fallback { has_fallback = find_rate(fb_ptr, fb_len, use_default_fallbacks, base_ptr, base_len, &fallback); };
    if !has_primary {
        if validRate(has_fallback, &fallback) {
            rate_assign(out, &fallback);
            return true;
        };
        return false;
    };
    // merge fallback <- primary, then override the four price fields
    rate_assign(out, &fallback);
    rate_assign(out, &primary);
    if primary.inputUsdPerMillion_present { out.inputUsdPerMillion = primary.inputUsdPerMillion; out.inputUsdPerMillion_present = true; } else if has_fallback && fallback.inputUsdPerMillion_present { out.inputUsdPerMillion = fallback.inputUsdPerMillion; out.inputUsdPerMillion_present = true; };
    if primary.outputUsdPerMillion_present { out.outputUsdPerMillion = primary.outputUsdPerMillion; out.outputUsdPerMillion_present = true; } else if has_fallback && fallback.outputUsdPerMillion_present { out.outputUsdPerMillion = fallback.outputUsdPerMillion; out.outputUsdPerMillion_present = true; };
    if !out.inputUsdPerMillion_present || !out.outputUsdPerMillion_present { return false; };
    if primary.cachedInputUsdPerMillion_present { out.cachedInputUsdPerMillion = primary.cachedInputUsdPerMillion; out.cachedInputUsdPerMillion_present = true; } else if has_fallback && fallback.cachedInputUsdPerMillion_present { out.cachedInputUsdPerMillion = fallback.cachedInputUsdPerMillion; out.cachedInputUsdPerMillion_present = true; };
    if primary.cacheWriteUsdPerMillion_present { out.cacheWriteUsdPerMillion = primary.cacheWriteUsdPerMillion; out.cacheWriteUsdPerMillion_present = true; } else if has_fallback && fallback.cacheWriteUsdPerMillion_present { out.cacheWriteUsdPerMillion = fallback.cacheWriteUsdPerMillion; out.cacheWriteUsdPerMillion_present = true; };
    return true;
}

fn rate_assign(dst: &TokenUsageRate, src: &TokenUsageRate) {
    dst.model_ptr = src.model_ptr; dst.model_len = src.model_len;
    if src.inputUsdPerMillion_present { dst.inputUsdPerMillion = src.inputUsdPerMillion; dst.inputUsdPerMillion_present = true; };
    if src.cachedInputUsdPerMillion_present { dst.cachedInputUsdPerMillion = src.cachedInputUsdPerMillion; dst.cachedInputUsdPerMillion_present = true; };
    if src.cacheWriteUsdPerMillion_present { dst.cacheWriteUsdPerMillion = src.cacheWriteUsdPerMillion; dst.cacheWriteUsdPerMillion_present = true; };
    if src.outputUsdPerMillion_present { dst.outputUsdPerMillion = src.outputUsdPerMillion; dst.outputUsdPerMillion_present = true; };
    if src.multiplier_present { dst.multiplier = src.multiplier; dst.multiplier_present = true; };
    if src.inputMultiplier_present { dst.inputMultiplier = src.inputMultiplier; dst.inputMultiplier_present = true; };
    if src.cacheReadMultiplier_present { dst.cacheReadMultiplier = src.cacheReadMultiplier; dst.cacheReadMultiplier_present = true; };
    if src.cacheWriteMultiplier_present { dst.cacheWriteMultiplier = src.cacheWriteMultiplier; dst.cacheWriteMultiplier_present = true; };
    if src.outputMultiplier_present { dst.outputMultiplier = src.outputMultiplier; dst.outputMultiplier_present = true; };
}

// priceNormalizedTokenUsage(usage, rates, model, groupRatio, fallbacks)
// -> PricedTokenUsage (TS returns `usage` unchanged when unpriced;
// SLA form fills out and sets priced=false in that case).
fn priceNormalizedTokenUsage(usage: &TokenUsageBreakdown, rates_ptr: ptr, rates_len: u64, model_ptr: ptr, model_len: u64, groupRatio: f64, fb_ptr: ptr, fb_len: u64, use_default_fallbacks: bool, out: &PricedTokenUsage) -> void {
    out.totalTokens = usage.totalTokens;
    out.inputTokens = usage.inputTokens;
    out.cachedInputTokens = usage.cachedInputTokens;
    out.cacheWriteInputTokens = usage.cacheWriteInputTokens;
    out.outputTokens = usage.outputTokens;
    out.reasoningOutputTokens = usage.reasoningOutputTokens;
    out.estimatedCostUsd_present = false;
    out.costBreakdownUsd_present = false;
    out.billingSnapshot_present = false;
    let rate = TokenUsageRate { model_ptr: PTR_NULL(), model_len: 0, inputUsdPerMillion: 0.0, inputUsdPerMillion_present: false, cachedInputUsdPerMillion: 0.0, cachedInputUsdPerMillion_present: false, cacheWriteUsdPerMillion: 0.0, cacheWriteUsdPerMillion_present: false, outputUsdPerMillion: 0.0, outputUsdPerMillion_present: false, multiplier: 0.0, multiplier_present: false, inputMultiplier: 0.0, inputMultiplier_present: false, cacheReadMultiplier: 0.0, cacheReadMultiplier_present: false, cacheWriteMultiplier: 0.0, cacheWriteMultiplier_present: false, outputMultiplier: 0.0, outputMultiplier_present: false };
    if !resolveTokenUsageRate(rates_ptr, rates_len, model_ptr, model_len, fb_ptr, fb_len, use_default_fallbacks, &rate) { return; };
    if !rate.inputUsdPerMillion_present || !rate.outputUsdPerMillion_present { return; };
    let cachedTokens = usage.cachedInputTokens;
    if cachedTokens < 0.0 { cachedTokens = 0.0; };
    let cacheWriteTokens = usage.cacheWriteInputTokens;
    if cacheWriteTokens < 0.0 { cacheWriteTokens = 0.0; };
    let cacheSum = cachedTokens + cacheWriteTokens;
    let standardInputTokens: f64 = 0.0;
    if usage.inputTokens >= cacheSum {
        standardInputTokens = usage.inputTokens - cacheSum;
        if standardInputTokens < 0.0 { standardInputTokens = 0.0; };
    } else {
        standardInputTokens = usage.inputTokens;
        if standardInputTokens < 0.0 { standardInputTokens = 0.0; };
    };
    let cachedRate = rate.inputUsdPerMillion;
    if rate.cachedInputUsdPerMillion_present { cachedRate = rate.cachedInputUsdPerMillion; };
    let cacheWriteRate = rate.inputUsdPerMillion;
    if rate.cacheWriteUsdPerMillion_present { cacheWriteRate = rate.cacheWriteUsdPerMillion; };
    let modelMultiplier: f64 = 1.0;
    if rate.multiplier_present { modelMultiplier = rate.multiplier; };
    let inputMultiplier = modelMultiplier;
    if rate.inputMultiplier_present { inputMultiplier = rate.inputMultiplier; };
    let cacheReadMultiplier = modelMultiplier;
    if rate.cacheReadMultiplier_present { cacheReadMultiplier = rate.cacheReadMultiplier; };
    let cacheWriteMultiplier = modelMultiplier;
    if rate.cacheWriteMultiplier_present { cacheWriteMultiplier = rate.cacheWriteMultiplier; };
    let outputMultiplier = modelMultiplier;
    if rate.outputMultiplier_present { outputMultiplier = rate.outputMultiplier; };
    // DEFECT: Number.isFinite(groupRatio) check approximated by >= 0 test.
    let normalizedGroupRatio: f64 = 1.0;
    if groupRatio >= 0.0 { normalizedGroupRatio = groupRatio; };
    let input = standardInputTokens * rate.inputUsdPerMillion / 1000000.0 * inputMultiplier * normalizedGroupRatio;
    let cachedInput = cachedTokens * cachedRate / 1000000.0 * cacheReadMultiplier * normalizedGroupRatio;
    let cacheWrite = cacheWriteTokens * cacheWriteRate / 1000000.0 * cacheWriteMultiplier * normalizedGroupRatio;
    let output = usage.outputTokens * rate.outputUsdPerMillion / 1000000.0 * outputMultiplier * normalizedGroupRatio;
    out.estimatedCostUsd = input + cachedInput + cacheWrite + output;
    out.estimatedCostUsd_present = true;
    out.costBreakdownUsd = PricedTokenUsage_CostBreakdownUsd { input: input, cachedInput: cachedInput, cacheWrite: cacheWrite, output: output };
    out.costBreakdownUsd_present = true;
    out.billingSnapshot = TokenUsageBillingSnapshot { inputUsdPerMillion: rate.inputUsdPerMillion, cachedInputUsdPerMillion: cachedRate, cacheWriteUsdPerMillion: cacheWriteRate, outputUsdPerMillion: rate.outputUsdPerMillion, modelMultiplier: modelMultiplier, inputMultiplier: inputMultiplier, cacheReadMultiplier: cacheReadMultiplier, cacheWriteMultiplier: cacheWriteMultiplier, outputMultiplier: outputMultiplier, groupRatio: normalizedGroupRatio };
    out.billingSnapshot_present = true;
}
