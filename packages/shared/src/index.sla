// alias of TypeofValue
struct EnhanceToolKey {
    value: TypeofValue,
}


// ENHANCE_TOOLS_KEYS (34 keys, const above) are exactly these
// SaVmToolsConfig fields; TS .some(key => tools[key] === true) ->
// explicit field checks (DEFECT: dynamic key access -> field list).
fn hasEnhanceToolsEnabled(tools: &SaVmToolsConfig, has_tools: bool) -> bool {
    if !has_tools { return false; };
    return tools.readFiles || tools.fastSearch || tools.editFiles || tools.applyPatch
        || tools.fileOutline || tools.codeGraph || tools.findDefinition || tools.renameSymbol
        || tools.extractToFile || tools.moveWithImports || tools.addImport || tools.getDiagnostics
        || tools.organizeImports || tools.analyzeScope || tools.findReferences || tools.clearToolHistory
        || tools.jevChoose || tools.jevChecklist || tools.jevEvaluate || tools.jevThinking
        || tools.jevRedteam || tools.jevRank || tools.jevScope || tools.jevDispatch
        || tools.jevConsistency || tools.jevDone || tools.jevDiagnose || tools.jevEdgeCases
        || tools.jevBlastRadius || tools.jevIntent || tools.jevNext || tools.jevCompress
        || tools.jevProgress || tools.jevMemory;
}



fn countActiveEnhanceTools(tools: &SaVmToolsConfig, has_tools: bool) -> u64 {
    if !has_tools { return 0; };
    let count: u64 = 0;
    if tools.readFiles { count = count + 1; };
    if tools.fastSearch { count = count + 1; };
    if tools.editFiles { count = count + 1; };
    if tools.applyPatch { count = count + 1; };
    if tools.fileOutline { count = count + 1; };
    if tools.codeGraph { count = count + 1; };
    if tools.findDefinition { count = count + 1; };
    if tools.renameSymbol { count = count + 1; };
    if tools.extractToFile { count = count + 1; };
    if tools.moveWithImports { count = count + 1; };
    if tools.addImport { count = count + 1; };
    if tools.getDiagnostics { count = count + 1; };
    if tools.organizeImports { count = count + 1; };
    if tools.analyzeScope { count = count + 1; };
    if tools.findReferences { count = count + 1; };
    if tools.clearToolHistory { count = count + 1; };
    if tools.jevChoose { count = count + 1; };
    if tools.jevChecklist { count = count + 1; };
    if tools.jevEvaluate { count = count + 1; };
    if tools.jevThinking { count = count + 1; };
    if tools.jevRedteam { count = count + 1; };
    if tools.jevRank { count = count + 1; };
    if tools.jevScope { count = count + 1; };
    if tools.jevDispatch { count = count + 1; };
    if tools.jevConsistency { count = count + 1; };
    if tools.jevDone { count = count + 1; };
    if tools.jevDiagnose { count = count + 1; };
    if tools.jevEdgeCases { count = count + 1; };
    if tools.jevBlastRadius { count = count + 1; };
    if tools.jevIntent { count = count + 1; };
    if tools.jevNext { count = count + 1; };
    if tools.jevCompress { count = count + 1; };
    if tools.jevProgress { count = count + 1; };
    if tools.jevMemory { count = count + 1; };
    return count;
}



// TS: { ...tools, ...Object.fromEntries(KEYS.map(k => [k, enabled])) }
// DEFECT: dynamic key construction -> explicit field writes; the
// leading struct copy uses value assignment (assumed SLA semantics).
fn setAllEnhanceTools(tools: &SaVmToolsConfig, enabled: bool, out: &SaVmToolsConfig) -> void {
    *out = *tools;
    out.readFiles = enabled;
    out.fastSearch = enabled;
    out.editFiles = enabled;
    out.applyPatch = enabled;
    out.fileOutline = enabled;
    out.codeGraph = enabled;
    out.findDefinition = enabled;
    out.renameSymbol = enabled;
    out.extractToFile = enabled;
    out.moveWithImports = enabled;
    out.addImport = enabled;
    out.getDiagnostics = enabled;
    out.organizeImports = enabled;
    out.analyzeScope = enabled;
    out.findReferences = enabled;
    out.clearToolHistory = enabled;
    out.jevChoose = enabled;
    out.jevChecklist = enabled;
    out.jevEvaluate = enabled;
    out.jevThinking = enabled;
    out.jevRedteam = enabled;
    out.jevRank = enabled;
    out.jevScope = enabled;
    out.jevDispatch = enabled;
    out.jevConsistency = enabled;
    out.jevDone = enabled;
    out.jevDiagnose = enabled;
    out.jevEdgeCases = enabled;
    out.jevBlastRadius = enabled;
    out.jevIntent = enabled;
    out.jevNext = enabled;
    out.jevCompress = enabled;
    out.jevProgress = enabled;
    out.jevMemory = enabled;
}



// createDefaultSaVmPolicyConfig() -> SaVmPolicyConfig literal.
// DEFECT: array/object leaves of the literal (fs.entries, read/write/
// transfer lists, process.exec rules, bunProfiles) are (ptr,len)
// fields in the converted structs and cannot be materialized as
// typed arrays in this pass; they are left empty and the exact TS
// values remain in the source-order comments of the defect log.
// Scalar leaves are filled exactly.
fn createDefaultSaVmPolicyConfig(out: &SaVmPolicyConfig) -> void {
    out.engine = SaVmRuntimeEngine { value: 0 };
    // fs: entries [{PROJECT}/**, write] + legacy mirrors; delete
    // "rename" (SaVmDeletePolicy tag 1); backupDir set.
    out.fs.delete = SaVmDeletePolicy { value: 1 };
    out.fs.backupDir_ptr = STR_PTR("${PROJECT}/.codex-ultra/vm-trash/**");
    out.fs.backupDir_len = STR_LEN("${PROJECT}/.codex-ultra/vm-trash/**");
    // http.allow = [] ; env.allow = ["CWD", "PROJECT"] (see log)
    // process: spawn=false, exec rules (see log), bun=true,
    // bunProfiles = ALL_SA_VM_BUN_PROFILES (see log)
    out.process.spawn = false;
    out.process.bun_ptr = STR_PTR("true");
    out.process.bun_len = STR_LEN("true");
    // execution: javascript=false, python=false
    out.execution.javascript = false;
    out.execution.python = false;
    // tools: the 16 true flags from the source literal
    out.tools.replaceRead = true;
    out.tools.replaceWrite = true;
    out.tools.replaceApplyPatch = true;
    out.tools.replaceExec = true;
    out.tools.clearToolHistory = true;
    out.tools.findReferences = true;
    out.tools.renameSymbol = true;
    out.tools.fileOutline = true;
    out.tools.codeGraph = true;
    out.tools.moveWithImports = true;
    out.tools.findDefinition = true;
    out.tools.extractToFile = true;
    out.tools.addImport = true;
    out.tools.getDiagnostics = true;
    out.tools.organizeImports = true;
    out.tools.analyzeScope = true;
    // contextSavings: the 8 true flags from the source literal
    out.contextSavings.locateBeforeRead = true;
    out.contextSavings.grepCircuitBreaker = true;
    out.contextSavings.slimRunnerOutput = true;
    out.contextSavings.parallelBudget = true;
    out.contextSavings.parallelDeduplication = true;
    out.contextSavings.tieredSkillInjection = true;
    out.contextSavings.foldWaterfallEvents = true;
    out.contextSavings.foldHistoryReadSummaries = true;
    // accountability: enabled=false, autoPenalize=true, red=50, yellow=80
    out.accountability.enabled = false;
    out.accountability.autoPenalize = true;
    out.accountability.reputationThresholdRed = 50.0;
    out.accountability.reputationThresholdYellow = 80.0;
}


// Per-conversation compression strategy (mutually exclusive radio). Default "off".
// CompactMode is one of:
//   "off" = 0
//   "cheap" = 1
//   "jev-sub" = 2
//   "jev-token" = 3
struct CompactMode {
    value: u64,
}

// Relay and model selection actually used by a persisted Codex conversation.
struct ThreadRuntimeMetadata {
    threadId_ptr: ptr,
    threadId_len: u64,
    providerId_ptr: ptr,
    providerId_len: u64,
    groupId_ptr: ptr,
    groupId_len: u64,
    model_ptr: ptr,
    model_len: u64,
    reasoningEffort_ptr: ptr,
    reasoningEffort_len: u64,
    // Per-conversation preference; never a process-wide Codex setting.
    freeAutoCompactEnabled: bool, // optional in TS
    // Per-conversation compaction threshold, clamped to 50–95.
    freeAutoCompactThreshold: f64, // optional in TS
    // Optional per-conversation free model override used only for compaction.
    freeAutoCompactModel_ptr: ptr, // optional in TS
    freeAutoCompactModel_len: u64,
    // Optional per-conversation compaction relay override. Null uses automatic free relay matching.
    freeAutoCompactProviderId_ptr: ptr, // optional in TS
    freeAutoCompactProviderId_len: u64,
    // Optional per-conversation compaction relay group override.
    freeAutoCompactGroupId_ptr: ptr, // optional in TS
    freeAutoCompactGroupId_len: u64,
    // Per-conversation compression strategy; legacy freeAutoCompactEnabled maps to cheap/off.
    compactMode: CompactMode, // optional in TS
    // Per-conversation jev_compress threshold, clamped to 50–95. Default 85.
    jevCompressThreshold: f64, // optional in TS
    permission: PermissionPresetId, // optional in TS
    agents: AgentRuntimeOverride, // optional in TS
    cwd_ptr: ptr, // optional in TS
    cwd_len: u64,
    additionalRoots_ptr: ptr, // DEFECT: TS Array<string> -> (ptr,len) slice // optional in TS
    additionalRoots_len: u64,
    // Local .code-workspace file selected for this conversation, if any.
    workspaceFilePath_ptr: ptr, // optional in TS
    workspaceFilePath_len: u64,
    // Per-conversation CLI backend; defaults to "codex".
    cliBackend: CliBackend, // optional in TS
    // Per-conversation fast-mode preference.
    fastModeEnabled: bool, // optional in TS
    // Per-conversation plan-mode preference.
    planModeEnabled: bool, // optional in TS
    // Per-conversation code enhancement / efficiency tools mode.
    enhanceEnabled: bool, // optional in TS
    // Per-conversation strict SA-VM tool execution mode.
    vmEnabled: bool, // optional in TS
    // Per-conversation VM broker policy; never process-global.
    vmPolicy: SaVmPolicyConfig, // optional in TS
    createdAt: f64,
    updatedAt: f64,
}

