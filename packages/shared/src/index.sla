    // one of: "chatgpt", "openai", "responsesRelay", "ollama", "lmstudio", "bedrock"
    kind: u64,
    name_ptr: ptr,
    name_len: u64,
    serviceProvider: ProviderConfig_ServiceProvider, // optional in TS
    baseUrl_ptr: ptr, // optional in TS
    baseUrl_len: u64,
    apiKeyRef_ptr: ptr, // optional in TS
    apiKeyRef_len: u64,
    apiKeyPreview_ptr: ptr, // optional in TS
    apiKeyPreview_len: u64,
    // one of: "database", "keyring", "memory", "none" // optional in TS
    apiKeyStorage: u64,
    defaultModel_ptr: ptr, // optional in TS
    defaultModel_len: u64,
    // Maximum retries after an interrupted response stream. Codex defaults to 5.
    streamMaxRetries: f64, // optional in TS
    image: ProviderConfig_Image, // optional in TS
    nativeModels_ptr: ptr, // DEFECT: TS Array<string> -> (ptr,len) slice
    nativeModels_len: u64,
    modelAliases_ptr: ptr, // DEFECT: TS Array<{object}> -> (ptr,len) slice
    modelAliases_len: u64,
    // Optional UI-only labels keyed by the real model id. Never used for request routing.
    modelDisplayNames_ptr: ptr, // DEFECT: TS Record -> JSON text buffer // optional in TS
    modelDisplayNames_len: u64,
    modelRates_ptr: ptr, // DEFECT: TS Array<{object}> -> (ptr,len) slice // optional in TS
    modelRates_len: u64,
    // Imported New API-style model, group, vendor, pricing and endpoint catalog.
    capabilityCatalog: RelayCapabilityCatalog, // optional in TS
    // Remote New API-style pricing endpoint used to refresh the capability catalog.
    capabilityCatalogUrl_ptr: ptr, // optional in TS
    capabilityCatalogUrl_len: u64,
    // Relay Channel Mode: "fast" (default) or "advanced"
    // one of: "fast", "advanced" // optional in TS
    channelMode: u64,
    // Multi-group configuration for advanced mode
    groups_ptr: ptr, // DEFECT: TS Array<ChannelGroupConfig> -> (ptr,len) slice // optional in TS
    groups_len: u64,
    // Total quota / max usage quota in USD (null/undefined = unlimited)
    quotaUsd: f64, // optional in TS
    // Current accumulated usage in USD
    usedQuotaUsd: f64, // optional in TS
    // Station Type Tag: "third_party" (default), "rich", "charity", "official"
    stationType: StationType, // optional in TS
    // For Charity Station (公益站): Enable daily check-in feature
    enableCheckin: bool, // optional in TS
    // For Charity Station (公益站): Daily check-in reminder (default: true, once per day)
    remindCheckin: bool, // optional in TS
    // Free-form notes for the relay/channel, shown in list/detail views.
    remark_ptr: ptr, // optional in TS
    remark_len: u64,
    // Marks a relay imported through Codex Ultra's encrypted sharing format.
    sharedImport: ProviderConfig_SharedImport, // optional in TS
    // Soft-delete timestamp. Trashed relays remain persisted until restored.
    trashedAt: f64, // optional in TS
    createdAt: f64,
    updatedAt: f64,
}

