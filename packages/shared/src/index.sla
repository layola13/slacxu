// value preserved verbatim above; accessor functions are hand-written where used.


// permissionPresets data (from the const above) as a materializer.
// severity tags: normal=0 warning=1 critical=2. sandbox tags:
// read-only=0 workspace-write=1 danger-full-access=2 (CodexSandboxMode
// union order). approval tags: on-request=0 never=1.
fn permission_preset_at(idx: u64, out: &PermissionPreset) -> bool {
    if idx == 0 {
        out.id = PermissionPresetId { value: 0 };
        out.label_ptr = STR_PTR("Read-only + ask"); out.label_len = STR_LEN("Read-only + ask");
        out.description_ptr = STR_PTR("Analyze and inspect files. Writes and risky actions require changing permissions."); out.description_len = STR_LEN("Analyze and inspect files. Writes and risky actions require changing permissions.");
        out.sandbox = CodexSandboxMode { value: 0 };
        out.approvalPolicy = CodexApprovalPolicy { value: 0 };
        out.severity = 0;
        return true;
    };
    if idx == 1 {
        out.id = PermissionPresetId { value: 1 };
        out.label_ptr = STR_PTR("Workspace write + ask"); out.label_len = STR_LEN("Workspace write + ask");
        out.description_ptr = STR_PTR("Default. Allows workspace edits while commands, network, and extra paths request approval."); out.description_len = STR_LEN("Default. Allows workspace edits while commands, network, and extra paths request approval.");
        out.sandbox = CodexSandboxMode { value: 1 };
        out.approvalPolicy = CodexApprovalPolicy { value: 0 };
        out.severity = 0;
        return true;
    };
    if idx == 2 {
        out.id = PermissionPresetId { value: 2 };
        out.label_ptr = STR_PTR("Full access + ask"); out.label_len = STR_LEN("Full access + ask");
        out.description_ptr = STR_PTR("Allows broad filesystem access, while still asking before sensitive actions."); out.description_len = STR_LEN("Allows broad filesystem access, while still asking before sensitive actions.");
        out.sandbox = CodexSandboxMode { value: 2 };
        out.approvalPolicy = CodexApprovalPolicy { value: 0 };
        out.severity = 1;
        return true;
    };
    if idx == 3 {
        out.id = PermissionPresetId { value: 3 };
        out.label_ptr = STR_PTR("Safe bypass with full access"); out.label_len = STR_LEN("Safe bypass with full access");
        out.description_ptr = STR_PTR("Full local access without per-action approval prompts; configured command safeguards remain active."); out.description_len = STR_LEN("Full local access without per-action approval prompts; configured command safeguards remain active.");
        out.sandbox = CodexSandboxMode { value: 2 };
        out.approvalPolicy = CodexApprovalPolicy { value: 1 };
        out.severity = 2;
        return true;
    };
    return false;
}

fn permission_presets_len() -> u64 { return 4; }

// Flattened logic form of CodexSandboxPolicy (the converter's
// tagged-union wrapper above is the type-parity form; functions use
// this value form). DEFECT: two representations until fix phase.
struct SandboxPolicyValue {
    variant: u64,
    networkAccess: bool,
    writableRoots: StrList,
    excludeTmpdirEnvVar: bool,
    excludeSlashTmp: bool,
}

struct PermissionTurnOverrides {
    sandbox: CodexSandboxMode,
    sandboxPolicy: SandboxPolicyValue,
    approvalPolicy: CodexApprovalPolicy,
}

fn sandboxModeToPolicy(sandbox: u64, cwd_ptr: ptr, cwd_len: u64, additionalRoots: &StrList, out: &SandboxPolicyValue) -> void {
    out.writableRoots.len = 0;
    out.networkAccess = false;
    out.excludeTmpdirEnvVar = false;
    out.excludeSlashTmp = false;
    if sandbox == 0 {
        out.variant = 0;
        return;
    };
    if sandbox == 1 {
        out.variant = 1;
        list_push(&out.writableRoots, cwd_ptr, cwd_len);
        for i in 0..additionalRoots.len {
            let rp = additionalRoots.items[i].ptr;
            let rl = additionalRoots.items[i].len;
            if rl > 0 && !str_eq_lit(rp, rl, cwd_ptr, cwd_len) {
                list_push(&out.writableRoots, rp, rl);
            };
        }
        return;
    };
    out.variant = 2;
}

// permissionToTurnOverrides(id, cwd, additionalRoots = [])
// TS throws on unknown preset; SLA form returns false.
fn permissionToTurnOverrides(id: u64, cwd_ptr: ptr, cwd_len: u64, additionalRoots: &StrList, out: &PermissionTurnOverrides) -> bool {
    let preset = PermissionPreset { id: PermissionPresetId { value: 0 }, label_ptr: PTR_NULL(), label_len: 0, description_ptr: PTR_NULL(), description_len: 0, sandbox: CodexSandboxMode { value: 0 }, approvalPolicy: CodexApprovalPolicy { value: 0 }, severity: 0 };
    let found = false;
    for i in 0..4 {
        if permission_preset_at(i, &preset) && preset.id.value == id { found = true; break; };
    }
    if !found { return false; };
    out.sandbox = preset.sandbox;
    sandboxModeToPolicy(preset.sandbox.value, cwd_ptr, cwd_len, additionalRoots, &out.sandboxPolicy);
    out.approvalPolicy = preset.approvalPolicy;
    return true;
}


