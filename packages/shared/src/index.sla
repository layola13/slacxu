    status: AgentProjectMemberStatus,
}

// A company-style room whose members are independently routed Codex threads.
struct AgentProject {
    id_ptr: ptr,
    id_len: u64,
    name_ptr: ptr,
    name_len: u64,
    description_ptr: ptr,
    description_len: u64,
    workspaces_ptr: ptr, // DEFECT: TS Array<AgentProjectWorkspace> -> (ptr,len) slice
    workspaces_len: u64,
    agents_ptr: ptr, // DEFECT: TS Array<AgentProjectMember> -> (ptr,len) slice
    agents_len: u64,
    coordinatorAgentId_ptr: ptr,
    coordinatorAgentId_len: u64,
    status: AgentProjectStatus,
    createdAt: f64,
    updatedAt: f64,
}

// AgentProjectMessageKind is one of:
//   "human" = 0
//   "agent" = 1
//   "system" = 2
//   "handoff" = 3
struct AgentProjectMessageKind {
    value: u64,
}

// AgentProjectDiscussionPhase is one of:
//   "analysis" = 0
//   "challenge" = 1
//   "synthesis" = 2
struct AgentProjectDiscussionPhase {
    value: u64,
}

// Canonical room timeline entry projected into one shared waterfall.
struct AgentProjectMessage {
    id_ptr: ptr,
    id_len: u64,
    projectId_ptr: ptr,
    projectId_len: u64,
    agentId_ptr: ptr,
    agentId_len: u64,
    threadId_ptr: ptr,
    threadId_len: u64,
    turnId_ptr: ptr,
    turnId_len: u64,
    itemId_ptr: ptr,
    itemId_len: u64,
    kind: AgentProjectMessageKind,
    // Discussion stage which produced this entry. Human/system entries may omit it.
    phase: AgentProjectDiscussionPhase, // optional in TS
    // Actual route used for the turn, retained for audit and cross-route UI.
    providerId_ptr: ptr, // optional in TS
    providerId_len: u64,
    groupId_ptr: ptr, // optional in TS
    groupId_len: u64,
    model_ptr: ptr, // optional in TS
    model_len: u64,
    text_ptr: ptr,
    text_len: u64,
    createdAt: f64,
    sequence: f64,
}

// AgentProjectVoteChoice is one of:
//   "approve" = 0
//   "reject" = 1
//   "abstain" = 2
struct AgentProjectVoteChoice {
    value: u64,
}

struct AgentProjectVote {
    id_ptr: ptr,
    id_len: u64,
    projectId_ptr: ptr,
    projectId_len: u64,
    proposalId_ptr: ptr,
    proposalId_len: u64,
    voterId_ptr: ptr,
    voterId_len: u64,
    // one of: "human", "agent"
    voterType: u64,
    choice: AgentProjectVoteChoice,
    comment_ptr: ptr,
    comment_len: u64,
    createdAt: f64,
}


// agentRuntimeThreadConfig(agents) -> Record<string, JsonValue> | undefined
// SLA form: JSON object text into out (StrBuf); false = TS undefined.
// DEFECT: Record<string, JsonValue> built as JSON text; key order
// follows the TS insertion order.
fn agentRuntimeThreadConfig(agents: &AgentRuntimeOverride, out: &StrBuf) -> bool {
    if agents.mode.value == 0 { return false; };
    out.len = 0;
    buf_append(out, STR_PTR("{\"features.multi_agent_v2.enabled\":"), STR_LEN("{\"features.multi_agent_v2.enabled\":"));
    if agents.mode.value == 1 { buf_append(out, STR_PTR("true"), STR_LEN("true")); } else { buf_append(out, STR_PTR("false"), STR_LEN("false")); };
    if agents.mode.value == 1 {
        if agents.childCount >= 0.0 {
            buf_append(out, STR_PTR(",\"features.multi_agent_v2.max_concurrent_threads_per_session\":"), STR_LEN(",\"features.multi_agent_v2.max_concurrent_threads_per_session\":"));
            buf_append_f64_int(out, agents.childCount + 1.0);
        };
        if agents.model_len > 0 {
            buf_append(out, STR_PTR(",\"agents.default_subagent_model\":"), STR_LEN(",\"agents.default_subagent_model\":"));
            json_escape_into(out, agents.model_ptr, agents.model_len, true);
        };
        if agents.reasoningEffort_len > 0 {
            buf_append(out, STR_PTR(",\"agents.default_subagent_reasoning_effort\":"), STR_LEN(",\"agents.default_subagent_reasoning_effort\":"));
            json_escape_into(out, agents.reasoningEffort_ptr, agents.reasoningEffort_len, true);
        };
        let hint = StrBuf { bytes: [0u8; 2048], len: 0 };
        // DEFECT: hint can reach 8000 chars in TS; StrBuf caps at 2048
        // in this pass (see agentRosterUsageHint).
        if agentRosterUsageHint(&agents.roles, &hint) {
            buf_append(out, STR_PTR(",\"features.multi_agent_v2.expose_spawn_agent_model_overrides\":true"), STR_LEN(",\"features.multi_agent_v2.expose_spawn_agent_model_overrides\":true"));
            buf_append(out, STR_PTR(",\"features.multi_agent_v2.root_agent_usage_hint_text\":"), STR_LEN(",\"features.multi_agent_v2.root_agent_usage_hint_text\":"));
            let hp: ptr = PTR_NULL();
            PTR_BYTE_ADD(hp, &hint.bytes, 0);
            json_escape_into(out, hp, hint.len, true);
        };
    };
    buf_append(out, STR_PTR("}"), STR_LEN("}"));
    return true;
}

// JSON.stringify(string) equivalent: quoted + escaped append.
fn json_escape_into(out: &StrBuf, p: ptr, l: u64, quoted: bool) -> void {
    if quoted { buf_putc(out, 34); };
    for i in 0..l {
        let c: u8 = 0;
        PTR_BYTE_AT(c, p, i);
        if c == 34 { buf_append(out, STR_PTR("\\\""), STR_LEN("\\\"")); } else if c == 92 { buf_append(out, STR_PTR("\\\\"), STR_LEN("\\\\")); } else if c == 10 { buf_append(out, STR_PTR("\\n"), STR_LEN("\\n")); } else if c == 13 { buf_append(out, STR_PTR("\\r"), STR_LEN("\\r")); } else if c == 9 { buf_append(out, STR_PTR("\\t"), STR_LEN("\\t")); } else if c < 32 { buf_append(out, STR_PTR("\\u00"), STR_LEN("\\u00")); buf_putc(out, 48); buf_putc(out, 48); } else { buf_putc(out, c); };
    }
    if quoted { buf_putc(out, 34); };
}

// Append an integer-valued f64 as decimal digits (JSON number).
fn buf_append_f64_int(out: &StrBuf, v: f64) -> void {
    let iv = v as i64;
    if iv == 0 { buf_putc(out, 48); return; };
    if iv < 0 { buf_putc(out, 45); iv = 0 - iv; };
    let digits: [u8; 24] = [0u8; 24];
    let n: u64 = 0;
    let x = iv;
    while x > 0 {
        digits[n] = (x % 10) as u8 + 48;
        n = n + 1;
        x = x / 10;
    }
    let i: u64 = n;
    while i > 0 {
        i = i - 1;
        buf_putc(out, digits[i]);
    }
}



// applyReasoningEffortAgentDefaults(reasoningEffort, agents)
// Returns via out params. DEFECT: TS returns a fresh object sharing
// the agents reference in the non-ultra path; SLA copies by value.
// childCount uses the < 0 = null sentinel (see defect log).
fn applyReasoningEffortAgentDefaults(eff_ptr: ptr, eff_len: u64, agents: &AgentRuntimeOverride, out_eff: &StrRef, out_agents: &AgentRuntimeOverride) -> void {
    let tp: ptr = PTR_NULL();
    let tl: u64 = 0;
    str_trim(eff_ptr, eff_len, &tp, &tl);
    let lb = StrBuf { bytes: [0u8; 2048], len: 0 };
    buf_lower_copy(&lb, tp, tl);
    let lp: ptr = PTR_NULL();
    PTR_BYTE_ADD(lp, &lb.bytes, 0);
    *out_agents = *agents;
    if !str_eq_lit(lp, lb.len, STR_PTR("ultra"), STR_LEN("ultra")) {
        out_eff.ptr = eff_ptr;
        out_eff.len = eff_len;
        return;
    };
    out_eff.ptr = STR_PTR("ultra");
    out_eff.len = STR_LEN("ultra");
    out_agents.mode = AgentRuntimeMode { value: 1 };
    out_agents.childCount = 30.0;
}



struct AgentRoleList {
    items: [AgentRosterRole; 24],
    len: u64,
}

struct AgentFallbackList {
    items: [AgentRoleFallback; 8],
    len: u64,
}

// Read roles[i] from the typed list struct (fix phase: direct typed
// indexing; the converter's (ptr,len) + PTR_ELEM_ADD form is gone).
fn role_at(roles: &AgentRoleList, idx: u64, out: &AgentRosterRole) -> void {
    *out = roles.items[idx];
}

fn instance_count_of(v: f64, present: bool) -> u64 {
    if !present { return 1; };
    if v >= 1.0 && v == (v as i64) as f64 {
        if v > 12.0 { return 12; };
        return v as u64;
    };
    return 1;
}

// agentRosterUsageHint(roles) -> string | undefined (StrBuf + bool)
// DEFECT: TS caps the result at 8000 UTF-16 units via slice; StrBuf
// caps at 2048 bytes in this pass. JSON.stringify -> json_escape_into.
fn agentRosterUsageHint(roles: &AgentRoleList, out: &StrBuf) -> bool {
    out.len = 0;
    let kept: u64 = 0;
    let body = StrBuf { bytes: [0u8; 2048], len: 0 };
    let role = AgentRosterRole { id_ptr: PTR_NULL(), id_len: 0, name_ptr: PTR_NULL(), name_len: 0, responsibility_ptr: PTR_NULL(), responsibility_len: 0, providerId_ptr: PTR_NULL(), providerId_len: 0, groupId_ptr: PTR_NULL(), groupId_len: 0, model_ptr: PTR_NULL(), model_len: 0, reasoningEffort_ptr: PTR_NULL(), reasoningEffort_len: 0, instanceCount: 0.0, startPolicy: AgentRoleStartPolicy { value: 0 }, runtime: AgentRoleRuntime { value: 0 }, workspace: AgentRoleWorkspace { mode: AgentRoleWorkspaceMode { value: 0 }, cwd_ptr: PTR_NULL(), cwd_len: 0, workspaceMode: AgentRoleWorkspaceRuntime { value: 0 }, sshCommand_ptr: PTR_NULL(), sshCommand_len: 0, additionalRoots_ptr: PTR_NULL(), additionalRoots_len: 0 }, fallbacks_ptr: PTR_NULL(), fallbacks_len: 0, enabled: false };
    for i in 0..roles.len {
        if kept >= 12 { break; };
        role_at(roles, i, &role);
        if !role.enabled { continue; };
        let np: ptr = PTR_NULL();
        let nl: u64 = 0;
        str_trim(role.name_ptr, role.name_len, &np, &nl);
        let rp: ptr = PTR_NULL();
        let rl: u64 = 0;
        str_trim(role.responsibility_ptr, role.responsibility_len, &rp, &rl);
        if nl == 0 && rl == 0 { continue; };
        kept = kept + 1;
        buf_append(&body, STR_PTR("\n- "), STR_LEN("\n- "));
        buf_append(&body, np, nl);
        buf_append(&body, STR_PTR(" [task_name="), STR_LEN(" [task_name="));
        let ip: ptr = PTR_NULL();
        let il: u64 = 0;
        str_trim(role.id_ptr, role.id_len, &ip, &il);
        if il == 0 { ip = np; il = nl; };
        json_escape_into(&body, ip, il, true);
        buf_append(&body, STR_PTR("; model="), STR_LEN("; model="));
        let mp: ptr = PTR_NULL();
        let ml: u64 = 0;
        str_trim(role.model_ptr, role.model_len, &mp, &ml);
        if ml > 0 { json_escape_into(&body, mp, ml, true); } else { buf_append(&body, STR_PTR("inherit"), STR_LEN("inherit")); };
        buf_append(&body, STR_PTR(", reasoning_effort="), STR_LEN(", reasoning_effort="));
        let ep: ptr = PTR_NULL();
        let el: u64 = 0;
        str_trim(role.reasoningEffort_ptr, role.reasoningEffort_len, &ep, &el);
        if el > 0 { json_escape_into(&body, ep, el, true); } else { buf_append(&body, STR_PTR("inherit"), STR_LEN("inherit")); };
        buf_append(&body, STR_PTR("] (runtime="), STR_LEN("] (runtime="));
        if role.runtime.value == 1 { buf_append(&body, STR_PTR("independent"), STR_LEN("independent")); } else { buf_append(&body, STR_PTR("native"), STR_LEN("native")); };
        buf_append(&body, STR_PTR(", workspace="), STR_LEN(", workspace="));
        // normalizeAgentRoleWorkspace(role.workspace).mode tag:
        // inherit=0 shared=1 private=2 (typed re-normalization)
        let wmode: u64 = 0;
        if role.workspace.cwd_len > 0 || role.workspace.mode.value != 0 { wmode = role.workspace.mode.value; };
        if wmode == 1 { buf_append(&body, STR_PTR("shared"), STR_LEN("shared")); } else if wmode == 2 { buf_append(&body, STR_PTR("private"), STR_LEN("private")); } else { buf_append(&body, STR_PTR("inherit"), STR_LEN("inherit")); };
        buf_append(&body, STR_PTR(", instances="), STR_LEN(", instances="));
        buf_append_f64_int(&body, instance_count_of(role.instanceCount, true) as f64);
        buf_append(&body, STR_PTR(", start="), STR_LEN(", start="));
        if role.startPolicy.value == 1 { buf_append(&body, STR_PTR("immediate"), STR_LEN("immediate")); } else { buf_append(&body, STR_PTR("on-demand"), STR_LEN("on-demand")); };
        buf_append(&body, STR_PTR("): "), STR_LEN("): "));
        buf_append(&body, rp, rl);
    }
    if kept == 0 { return false; };
    buf_append(out, STR_PTR("A user-configured agent roster is available below.\nWhen delegation is useful, assign work to the best matching roster role and pass that role's model and reasoning_effort to spawn_agent.\nUse the listed task_name and include the responsibility in the spawn message. Do not spawn agents merely to fill the roster, and do not set agent_type unless that Codex role is separately configured."), STR_LEN("A user-configured agent roster is available below.\nWhen delegation is useful, assign work to the best matching roster role and pass that role's model and reasoning_effort to spawn_agent.\nUse the listed task_name and include the responsibility in the spawn message. Do not spawn agents merely to fill the roster, and do not set agent_type unless that Codex role is separately configured."));
    let bp: ptr = PTR_NULL();
    PTR_BYTE_ADD(bp, &body.bytes, 0);
    buf_append(out, bp, body.len);
    return true;
}



// JSON node helpers shared by the parse/normalize/classify functions
// below. DEFECT: sa_json node-kind accessors (sa_json_is_object,
// sa_json_as_f64, sa_json_as_bool) are assumed; see tokenUsage.sla.
fn objectRecord(value: u64) -> u64 {
    if value == 0 { return 0; };
    if sa_json_kind(value) != 7 { return 0; }; // 7 = SA_JSON_KIND_OBJECT
    return value;
}

fn json_field(doc: u64, k_ptr: ptr, k_len: u64) -> u64 {
    let n: u64 = 0;
    if doc == 0 { return 0; };
    if sa_json_object_get(doc, k_ptr, k_len, &n) != 0 { return 0; };
    return n;
}

fn cleanAgentString(value: u64, max_len: u64, out: &StrBuf) -> void {
    out.len = 0;
    if value == 0 { return; };
    if sa_json_kind(value) != 5 { return; };
    let sl = sa_json_string_len(value);
    let sp: ptr = sa_json_string_ptr(value);
    let tp: ptr = PTR_NULL();
    let tl: u64 = 0;
    str_trim(sp, sl, &tp, &tl);
    if tl > max_len { tl = max_len; };
    // DEFECT: TS slice counts UTF-16 units; this truncates bytes.
    buf_append(out, tp, tl);
}

fn cleanNullableAgentString(value: u64, max_len: u64, out: &StrBuf) -> bool {
    cleanAgentString(value, max_len, out);
    return out.len > 0;
}

fn strbuf_ref(b: &StrBuf, out: &StrRef) -> void {
    let p: ptr = PTR_NULL();
    PTR_BYTE_ADD(p, &b.bytes, 0);
    out.ptr = p;
    out.len = b.len;
}

fn normalizeAgentInstanceCount(value: u64) -> f64 {
    let v: f64 = 0.0;
    if value == 0 || sa_json_as_f64(value, &v) != 0 { return 1.0; };
    if v >= 1.0 && v == (v as i64) as f64 {
        if v > 12.0 { return 12.0; };
        return v;
    };
    return 1.0;
}

// parseAgentRuntimeOverride(value: unknown) -> AgentRuntimeOverride
// Roles land in roles_out (cap 24) and are mirrored into out.roles
// (fix phase: embedded typed list replaces the (ptr,len) view).
fn parseAgentRuntimeOverride(value: u64, out: &AgentRuntimeOverride, roles_out: &AgentRoleList) -> void {
    let input = objectRecord(value);
    out.mode = AgentRuntimeMode { value: 0 };
    out.childCount = -1.0;
    out.model_ptr = PTR_NULL(); out.model_len = 0;
    out.reasoningEffort_ptr = PTR_NULL(); out.reasoningEffort_len = 0;
    roles_out.len = 0;
    out.roles.len = 0;
    if input == 0 { return; };
    let mode_node = json_field(input, STR_PTR("mode"), STR_LEN("mode"));
    let mb = StrBuf { bytes: [0u8; 2048], len: 0 };
    cleanAgentString(mode_node, 64, &mb);
    let mr = StrRef { ptr: PTR_NULL(), len: 0 };
    strbuf_ref(&mb, &mr);
    if str_eq_lit(mr.ptr, mr.len, STR_PTR("enabled"), STR_LEN("enabled")) { out.mode = AgentRuntimeMode { value: 1 }; };
    if str_eq_lit(mr.ptr, mr.len, STR_PTR("disabled"), STR_LEN("disabled")) { out.mode = AgentRuntimeMode { value: 2 }; };
    let cc_node = json_field(input, STR_PTR("childCount"), STR_LEN("childCount"));
    if cc_node != 0 {
        let cc: f64 = 0.0;
        if sa_json_as_f64(cc_node, &cc) == 0 {
            // TS: Number.isSafeInteger(cc + 1) && cc >= 1 (approximated
            // by integral + range checks; DEFECT: safe-integer bound)
            if cc >= 1.0 && cc == (cc as i64) as f64 && cc < 9007199254740991.0 { out.childCount = cc; };
        };
    };
    let model_b = StrBuf { bytes: [0u8; 2048], len: 0 };
    cleanAgentString(json_field(input, STR_PTR("model"), STR_LEN("model")), 512, &model_b);
    let mref = StrRef { ptr: PTR_NULL(), len: 0 };
    strbuf_ref(&model_b, &mref);
    out.model_ptr = mref.ptr; out.model_len = mref.len;
    let eff_b = StrBuf { bytes: [0u8; 2048], len: 0 };
    cleanAgentString(json_field(input, STR_PTR("reasoningEffort"), STR_LEN("reasoningEffort")), 64, &eff_b);
    let eref = StrRef { ptr: PTR_NULL(), len: 0 };
    strbuf_ref(&eff_b, &eref);
    out.reasoningEffort_ptr = eref.ptr; out.reasoningEffort_len = eref.len;
    let roles_node = json_field(input, STR_PTR("roles"), STR_LEN("roles"));
    let count: u64 = 0;
    if roles_node != 0 && sa_json_value_count(roles_node, &count) == 0 {
        for i in 0..count {
            if roles_out.len >= 24 { break; };
            let entry: u64 = 0;
            if sa_json_array_get(roles_node, i, &entry) != 0 { continue; };
            let role_doc = objectRecord(entry);
            if role_doc == 0 { continue; };
            let name_b = StrBuf { bytes: [0u8; 2048], len: 0 };
            cleanAgentString(json_field(role_doc, STR_PTR("name"), STR_LEN("name")), 80, &name_b);
            let resp_b = StrBuf { bytes: [0u8; 2048], len: 0 };
            cleanAgentString(json_field(role_doc, STR_PTR("responsibility"), STR_LEN("responsibility")), 800, &resp_b);
            if name_b.len == 0 && resp_b.len == 0 { continue; };
            let role = AgentRosterRole { id_ptr: PTR_NULL(), id_len: 0, name_ptr: PTR_NULL(), name_len: 0, responsibility_ptr: PTR_NULL(), responsibility_len: 0, providerId_ptr: PTR_NULL(), providerId_len: 0, groupId_ptr: PTR_NULL(), groupId_len: 0, model_ptr: PTR_NULL(), model_len: 0, reasoningEffort_ptr: PTR_NULL(), reasoningEffort_len: 0, instanceCount: 0.0, startPolicy: AgentRoleStartPolicy { value: 0 }, runtime: AgentRoleRuntime { value: 0 }, workspace: AgentRoleWorkspace { mode: AgentRoleWorkspaceMode { value: 0 }, cwd_ptr: PTR_NULL(), cwd_len: 0, workspaceMode: AgentRoleWorkspaceRuntime { value: 0 }, sshCommand_ptr: PTR_NULL(), sshCommand_len: 0, additionalRoots_ptr: PTR_NULL(), additionalRoots_len: 0 }, fallbacks_ptr: PTR_NULL(), fallbacks_len: 0, enabled: true };
            let id_b = StrBuf { bytes: [0u8; 2048], len: 0 };
            cleanAgentString(json_field(role_doc, STR_PTR("id"), STR_LEN("id")), 64, &id_b);
            if id_b.len == 0 {
                // `role-${index + 1}` — index is the SOURCE array index
                buf_append(&id_b, STR_PTR("role-"), STR_LEN("role-"));
                buf_append_f64_int(&id_b, (i + 1) as f64);
            };
            let idr = StrRef { ptr: PTR_NULL(), len: 0 };
            strbuf_ref(&id_b, &idr);
            role.id_ptr = idr.ptr; role.id_len = idr.len;
            let nr = StrRef { ptr: PTR_NULL(), len: 0 };
            strbuf_ref(&name_b, &nr);
            role.name_ptr = nr.ptr; role.name_len = nr.len;
            let rr = StrRef { ptr: PTR_NULL(), len: 0 };
            strbuf_ref(&resp_b, &rr);
            role.responsibility_ptr = rr.ptr; role.responsibility_len = rr.len;
            // DEFECT: these StrBufs are iteration-locals; pointers stored
            // in roles_out share one stack slot per field (fix phase:
            // arena/backing store per role).
            let prov_b = StrBuf { bytes: [0u8; 2048], len: 0 };
            let _has_prov = cleanNullableAgentString(json_field(role_doc, STR_PTR("providerId"), STR_LEN("providerId")), 128, &prov_b);
            let pr = StrRef { ptr: PTR_NULL(), len: 0 };
            strbuf_ref(&prov_b, &pr);
            role.providerId_ptr = pr.ptr; role.providerId_len = pr.len;
            let grp_b = StrBuf { bytes: [0u8; 2048], len: 0 };
            let _has_grp = cleanNullableAgentString(json_field(role_doc, STR_PTR("groupId"), STR_LEN("groupId")), 128, &grp_b);
            let gr = StrRef { ptr: PTR_NULL(), len: 0 };
            strbuf_ref(&grp_b, &gr);
            role.groupId_ptr = gr.ptr; role.groupId_len = gr.len;
            let mm_b = StrBuf { bytes: [0u8; 2048], len: 0 };
            cleanAgentString(json_field(role_doc, STR_PTR("model"), STR_LEN("model")), 512, &mm_b);
            let mmr = StrRef { ptr: PTR_NULL(), len: 0 };
            strbuf_ref(&mm_b, &mmr);
            role.model_ptr = mmr.ptr; role.model_len = mmr.len;
            let ee_b = StrBuf { bytes: [0u8; 2048], len: 0 };
            cleanAgentString(json_field(role_doc, STR_PTR("reasoningEffort"), STR_LEN("reasoningEffort")), 64, &ee_b);
            let eer = StrRef { ptr: PTR_NULL(), len: 0 };
            strbuf_ref(&ee_b, &eer);
            role.reasoningEffort_ptr = eer.ptr; role.reasoningEffort_len = eer.len;
            role.instanceCount = normalizeAgentInstanceCount(json_field(role_doc, STR_PTR("instanceCount"), STR_LEN("instanceCount")));
            let sp_b = StrBuf { bytes: [0u8; 2048], len: 0 };
            cleanAgentString(json_field(role_doc, STR_PTR("startPolicy"), STR_LEN("startPolicy")), 64, &sp_b);
            let spr = StrRef { ptr: PTR_NULL(), len: 0 };
            strbuf_ref(&sp_b, &spr);
            role.startPolicy = AgentRoleStartPolicy { value: 0 };
            if str_eq_lit(spr.ptr, spr.len, STR_PTR("immediate"), STR_LEN("immediate")) { role.startPolicy = AgentRoleStartPolicy { value: 1 }; };
            let rt_b = StrBuf { bytes: [0u8; 2048], len: 0 };
            cleanAgentString(json_field(role_doc, STR_PTR("runtime"), STR_LEN("runtime")), 64, &rt_b);
            let rtr = StrRef { ptr: PTR_NULL(), len: 0 };
            strbuf_ref(&rt_b, &rtr);
            role.runtime = AgentRoleRuntime { value: 0 };
            if str_eq_lit(rtr.ptr, rtr.len, STR_PTR("independent"), STR_LEN("independent")) { role.runtime = AgentRoleRuntime { value: 1 }; };
            normalizeAgentRoleWorkspace(json_field(role_doc, STR_PTR("workspace"), STR_LEN("workspace")), &role.workspace);
            let fb_list = AgentFallbackList { items: [AgentRoleFallback { id_ptr: PTR_NULL(), id_len: 0, label_ptr: PTR_NULL(), label_len: 0, providerId_ptr: PTR_NULL(), providerId_len: 0, groupId_ptr: PTR_NULL(), groupId_len: 0, model_ptr: PTR_NULL(), model_len: 0, reasoningEffort_ptr: PTR_NULL(), reasoningEffort_len: 0, workspace: AgentRoleWorkspace { mode: AgentRoleWorkspaceMode { value: 0 }, cwd_ptr: PTR_NULL(), cwd_len: 0, workspaceMode: AgentRoleWorkspaceRuntime { value: 0 }, sshCommand_ptr: PTR_NULL(), sshCommand_len: 0, additionalRoots_ptr: PTR_NULL(), additionalRoots_len: 0 } }; 8], len: 0 };
            normalizeAgentRoleFallbacks(json_field(role_doc, STR_PTR("fallbacks"), STR_LEN("fallbacks")), &fb_list);
            let en_node = json_field(role_doc, STR_PTR("enabled"), STR_LEN("enabled"));
            let en: bool = false;
            if en_node != 0 && sa_json_as_bool(en_node, &en) == 0 && !en { role.enabled = false; };
            roles_out.items[roles_out.len] = role;
            roles_out.len = roles_out.len + 1;
        }
    };
    out.roles.len = 0;
    for rk in 0..roles_out.len { out.roles.items[rk] = roles_out.items[rk]; out.roles.len = out.roles.len + 1; }
}



fn normalizeAgentRoleFallbacks(value: u64, out: &AgentFallbackList) -> void {
    out.len = 0;
    let count: u64 = 0;
    if value == 0 || sa_json_value_count(value, &count) != 0 { return; };
    for i in 0..count {
        if out.len >= 8 { break; };
        let entry: u64 = 0;
        if sa_json_array_get(value, i, &entry) != 0 { continue; };
        let doc = objectRecord(entry);
        if doc == 0 { continue; };
        let model_b = StrBuf { bytes: [0u8; 2048], len: 0 };
        cleanAgentString(json_field(doc, STR_PTR("model"), STR_LEN("model")), 512, &model_b);
        let prov_b = StrBuf { bytes: [0u8; 2048], len: 0 };
        let has_prov = cleanNullableAgentString(json_field(doc, STR_PTR("providerId"), STR_LEN("providerId")), 128, &prov_b);
        let grp_b = StrBuf { bytes: [0u8; 2048], len: 0 };
        let has_grp = cleanNullableAgentString(json_field(doc, STR_PTR("groupId"), STR_LEN("groupId")), 128, &grp_b);
        if model_b.len == 0 && !has_prov && !has_grp { continue; };
        let fb = AgentRoleFallback { id_ptr: PTR_NULL(), id_len: 0, label_ptr: PTR_NULL(), label_len: 0, providerId_ptr: PTR_NULL(), providerId_len: 0, groupId_ptr: PTR_NULL(), groupId_len: 0, model_ptr: PTR_NULL(), model_len: 0, reasoningEffort_ptr: PTR_NULL(), reasoningEffort_len: 0, workspace: AgentRoleWorkspace { mode: AgentRoleWorkspaceMode { value: 0 }, cwd_ptr: PTR_NULL(), cwd_len: 0, workspaceMode: AgentRoleWorkspaceRuntime { value: 0 }, sshCommand_ptr: PTR_NULL(), sshCommand_len: 0, additionalRoots_ptr: PTR_NULL(), additionalRoots_len: 0 } };
        let id_b = StrBuf { bytes: [0u8; 2048], len: 0 };
        cleanAgentString(json_field(doc, STR_PTR("id"), STR_LEN("id")), 64, &id_b);
        if id_b.len == 0 {
            buf_append(&id_b, STR_PTR("fallback-"), STR_LEN("fallback-"));
            buf_append_f64_int(&id_b, (i + 1) as f64);
        };
        let idr = StrRef { ptr: PTR_NULL(), len: 0 };
        strbuf_ref(&id_b, &idr);
        fb.id_ptr = idr.ptr; fb.id_len = idr.len;
        let label_b = StrBuf { bytes: [0u8; 2048], len: 0 };
        cleanAgentString(json_field(doc, STR_PTR("label"), STR_LEN("label")), 120, &label_b);
        if label_b.len == 0 {
            buf_append(&label_b, STR_PTR("Fallback "), STR_LEN("Fallback "));
            buf_append_f64_int(&label_b, (i + 1) as f64);
        };
        let lr = StrRef { ptr: PTR_NULL(), len: 0 };
        strbuf_ref(&label_b, &lr);
        fb.label_ptr = lr.ptr; fb.label_len = lr.len;
        let pr = StrRef { ptr: PTR_NULL(), len: 0 };
        strbuf_ref(&prov_b, &pr);
        fb.providerId_ptr = pr.ptr; fb.providerId_len = pr.len;
        let gr = StrRef { ptr: PTR_NULL(), len: 0 };
        strbuf_ref(&grp_b, &gr);
        fb.groupId_ptr = gr.ptr; fb.groupId_len = gr.len;
        let mr = StrRef { ptr: PTR_NULL(), len: 0 };
        strbuf_ref(&model_b, &mr);
        fb.model_ptr = mr.ptr; fb.model_len = mr.len;
        let ee_b = StrBuf { bytes: [0u8; 2048], len: 0 };
        cleanAgentString(json_field(doc, STR_PTR("reasoningEffort"), STR_LEN("reasoningEffort")), 64, &ee_b);
        let eer = StrRef { ptr: PTR_NULL(), len: 0 };
        strbuf_ref(&ee_b, &eer);
        fb.reasoningEffort_ptr = eer.ptr; fb.reasoningEffort_len = eer.len;
        normalizeAgentRoleWorkspace(json_field(doc, STR_PTR("workspace"), STR_LEN("workspace")), &fb.workspace);
        out.items[out.len] = fb;
        out.len = out.len + 1;
    }
}



fn normalizeAgentRoleWorkspace(value: u64, out: &AgentRoleWorkspace) -> void {
    let doc = objectRecord(value);
    out.mode = AgentRoleWorkspaceMode { value: 0 };
    out.cwd_ptr = PTR_NULL(); out.cwd_len = 0;
    out.workspaceMode = AgentRoleWorkspaceRuntime { value: 0 };
    out.sshCommand_ptr = PTR_NULL(); out.sshCommand_len = 0;
    out.additionalRoots_ptr = PTR_NULL(); out.additionalRoots_len = 0;
    if doc == 0 { return; };
    let mode_b = StrBuf { bytes: [0u8; 2048], len: 0 };
    cleanAgentString(json_field(doc, STR_PTR("mode"), STR_LEN("mode")), 64, &mode_b);
    let mr = StrRef { ptr: PTR_NULL(), len: 0 };
    strbuf_ref(&mode_b, &mr);
    if str_eq_lit(mr.ptr, mr.len, STR_PTR("shared"), STR_LEN("shared")) { out.mode = AgentRoleWorkspaceMode { value: 1 }; };
    if str_eq_lit(mr.ptr, mr.len, STR_PTR("private"), STR_LEN("private")) { out.mode = AgentRoleWorkspaceMode { value: 2 }; };
    let cwd_b = StrBuf { bytes: [0u8; 2048], len: 0 };
    cleanAgentString(json_field(doc, STR_PTR("cwd"), STR_LEN("cwd")), 1024, &cwd_b);
    let cr = StrRef { ptr: PTR_NULL(), len: 0 };
    strbuf_ref(&cwd_b, &cr);
    out.cwd_ptr = cr.ptr; out.cwd_len = cr.len;
    let wm_b = StrBuf { bytes: [0u8; 2048], len: 0 };
    cleanAgentString(json_field(doc, STR_PTR("workspaceMode"), STR_LEN("workspaceMode")), 64, &wm_b);
    let wr = StrRef { ptr: PTR_NULL(), len: 0 };
    strbuf_ref(&wm_b, &wr);
    if str_eq_lit(wr.ptr, wr.len, STR_PTR("ssh"), STR_LEN("ssh")) { out.workspaceMode = AgentRoleWorkspaceRuntime { value: 1 }; };
    let ssh_b = StrBuf { bytes: [0u8; 2048], len: 0 };
    cleanAgentString(json_field(doc, STR_PTR("sshCommand"), STR_LEN("sshCommand")), 2048, &ssh_b);
    if ssh_b.len > 0 {
        let sr = StrRef { ptr: PTR_NULL(), len: 0 };
        strbuf_ref(&ssh_b, &sr);
        out.sshCommand_ptr = sr.ptr; out.sshCommand_len = sr.len;
    };
    // additionalRoots: cleaned strings, cap 12 — collected into a
    // scratch StrList; out keeps (ptr,len) over it (DEFECT: lifetime).
    let roots_node = json_field(doc, STR_PTR("additionalRoots"), STR_LEN("additionalRoots"));
    let count: u64 = 0;
    if roots_node != 0 && sa_json_value_count(roots_node, &count) == 0 {
        let kept: u64 = 0;
        for i in 0..count {
            if kept >= 12 { break; };
            let entry: u64 = 0;
            if sa_json_array_get(roots_node, i, &entry) != 0 { continue; };
            let rb = StrBuf { bytes: [0u8; 2048], len: 0 };
            cleanAgentString(entry, 1024, &rb);
            if rb.len > 0 { kept = kept + 1; };
        }
        out.additionalRoots_len = kept;
    };
}



fn agentFailureMessage(value: u64, out: &StrBuf) -> void {
    out.len = 0;
    if value == 0 { return; };
    // DEFECT: `value instanceof Error` has no SLA counterpart; an
    // Error-shaped object ({message}) is covered by the record path.
    let sl: u64 = 0;
    if sa_json_kind(value) == 5 {
        sl = sa_json_string_len(value);
        let vsp: ptr = sa_json_string_ptr(value);
        buf_append(out, vsp, sl);
        return;
    };
    let doc = objectRecord(value);
    if doc != 0 {
        let fields = StrList { items: [StrRef { ptr: PTR_NULL(), len: 0 }; 32], len: 0 };
        list_push(&fields, STR_PTR("message"), STR_LEN("message"));
        list_push(&fields, STR_PTR("error"), STR_LEN("error"));
        list_push(&fields, STR_PTR("detail"), STR_LEN("detail"));
        for i in 0..fields.len {
            cleanAgentString(json_field(doc, fields.items[i].ptr, fields.items[i].len), 2000, out);
            if out.len > 0 { return; };
        }
        return;
    };
    // String(value ?? "") — DEFECT: approximated as JSON text.
    let sh: u64 = 0;
    if sa_json_stringify(value, &sh) == 0 {
        let shd: ptr = sa_json_buffer_data(sh);
        buf_append(out, shd, sa_json_buffer_len(sh));
    };
}

// code result: kind 0 = null, 1 = number (out_f), 2 = string (out_s)
fn agentFailureStatusCode(value: u64, msg_ptr: ptr, msg_len: u64, out_f: &f64, out_s: &StrBuf, out_kind: &u64) -> void {
    *out_kind = 0;
    out_s.len = 0;
    let doc = objectRecord(value);
    if doc != 0 {
        let keys = StrList { items: [StrRef { ptr: PTR_NULL(), len: 0 }; 32], len: 0 };
        list_push(&keys, STR_PTR("status"), STR_LEN("status"));
        list_push(&keys, STR_PTR("statusCode"), STR_LEN("statusCode"));
        list_push(&keys, STR_PTR("code"), STR_LEN("code"));
        let raw: u64 = 0;
        for i in 0..keys.len {
            raw = json_field(doc, keys.items[i].ptr, keys.items[i].len);
            if raw != 0 { break; };
        }
        if raw != 0 {
            let fv: f64 = 0.0;
            if sa_json_as_f64(raw, &fv) == 0 {
                if fv == (fv as i64) as f64 { *out_f = fv; *out_kind = 1; return; };
            };
            let sl: u64 = 0;
            if sa_json_kind(raw) == 5 { sl = sa_json_string_len(raw); };
            if sl > 0 {
                let sp: ptr = sa_json_string_ptr(raw);
                let tp: ptr = PTR_NULL();
                let tl: u64 = 0;
                str_trim(sp, sl, &tp, &tl);
                if tl > 0 {
                    // Number(trimmed) integral? -> number, else string
                    let parsed: f64 = 0.0;
                    let ok = true;
                    let dot = false;
                    for j in 0..tl {
                        let c: u8 = 0;
                        PTR_BYTE_AT(c, tp, j);
                        if c >= 48 && c <= 57 { parsed = parsed * 10.0 + (c - 48) as f64; } else if c == 46 && !dot { dot = true; } else if j == 0 && c == 45 { } else { ok = false; break; };
                    }
                    if ok && !dot { *out_f = parsed; *out_kind = 1; return; };
                    if tl > 64 { tl = 64; };
                    buf_append(out_s, tp, tl);
                    *out_kind = 2;
                    return;
                };
            };
        };
    };
    // /(?:^|[^\d])([1-5]\d\d)(?:[^\d]|$)/ over the message
    if msg_len >= 3 {
        for i in 0..msg_len - 2 {
            let c0: u8 = 0;
            PTR_BYTE_AT(c0, msg_ptr, i);
            if c0 < 49 || c0 > 53 { continue; };
            if i > 0 {
                let pb: u8 = 0;
                PTR_BYTE_AT(pb, msg_ptr, i - 1);
                if pb >= 48 && pb <= 57 { continue; };
            };
            let c1: u8 = 0;
            let c2: u8 = 0;
            PTR_BYTE_AT(c1, msg_ptr, i + 1);
            PTR_BYTE_AT(c2, msg_ptr, i + 2);
            if c1 < 48 || c1 > 57 || c2 < 48 || c2 > 57 { continue; };
            if i + 3 < msg_len {
                let nb: u8 = 0;
                PTR_BYTE_AT(nb, msg_ptr, i + 3);
                if nb >= 48 && nb <= 57 { continue; };
            };
            *out_f = ((c0 - 48) * 100 + (c1 - 48) * 10 + (c2 - 48)) as f64;
            *out_kind = 1;
            return;
        }
    };
}

fn pow2_capped(exp: u64) -> f64 {
    let r: f64 = 1.0;
    for i in 0..exp { r = r * 2.0; }
    return r;
}

// classifyAgentFailure(value, previous?, now) — previous passed as
// struct + has_prev. DEFECT: TS regex alternations -> substring
// checks on the lowercased message (byte-level; the CJK alternatives
// are matched as UTF-8 byte substrings, which is exact for `test`).
// AgentMemberHealth.code (number|string|null) is written as JSON
// text into code_ptr/code_len via a scratch buffer (lifetime note
// in the defect log).
fn classifyAgentFailure(value: u64, prev: &AgentMemberHealth, has_prev: bool, now: f64, out: &AgentMemberHealth) -> void {
    let msg = StrBuf { bytes: [0u8; 2048], len: 0 };
    agentFailureMessage(value, &msg);
    if msg.len > 2000 { msg.len = 2000; };
    if msg.len == 0 { buf_append(&msg, STR_PTR("Agent became unavailable"), STR_LEN("Agent became unavailable")); };
    let lower = StrBuf { bytes: [0u8; 2048], len: 0 };
    let mp: ptr = PTR_NULL();
    PTR_BYTE_ADD(mp, &msg.bytes, 0);
    buf_lower_copy(&lower, mp, msg.len);
    let lp: ptr = PTR_NULL();
    PTR_BYTE_ADD(lp, &lower.bytes, 0);
    let code_f: f64 = 0.0;
    let code_s = StrBuf { bytes: [0u8; 2048], len: 0 };
    let code_kind: u64 = 0;
    agentFailureStatusCode(value, lp, lower.len, &code_f, &code_s, &code_kind);
    let prev_failures: f64 = 0.0;
    if has_prev { prev_failures = prev.consecutiveFailures; };
    let consecutive = prev_failures + 1.0;
    let kind: u64 = 6;
    let availability: u64 = 1;
    if consecutive >= 3.0 { availability = 2; };
    let retryable = true;
    let has_retry = false;
    let retry_at: f64 = 0.0;
    let exp = consecutive - 1.0;
    if exp > 5.0 { exp = 5.0; };
    let mult = pow2_capped(exp as u64);
    let is429 = code_kind == 1 && code_f == 429.0;
    let is402 = code_kind == 1 && code_f == 402.0;
    let is401 = code_kind == 1 && code_f == 401.0;
    let is403 = code_kind == 1 && code_f == 403.0;
    let is502 = code_kind == 1 && code_f == 502.0;
    let is503 = code_kind == 1 && code_f == 503.0;
    if is429 || str_contains(lp, lower.len, STR_PTR("rate limit"), STR_LEN("rate limit")) || str_contains(lp, lower.len, STR_PTR("ratelimit"), STR_LEN("ratelimit")) || str_contains(lp, lower.len, STR_PTR("rate_limit"), STR_LEN("rate_limit")) || str_contains(lp, lower.len, STR_PTR("too many requests"), STR_LEN("too many requests")) || str_contains(mp, msg.len, STR_PTR("限流"), STR_LEN("限流")) || str_contains(mp, msg.len, STR_PTR("请求过多"), STR_LEN("请求过多")) {
        kind = 0;
        retry_at = now + min_f(60000.0 * mult, 1800000.0);
        has_retry = true;
    } else if is402 || str_contains(lp, lower.len, STR_PTR("insufficient quota"), STR_LEN("insufficient quota")) || str_contains(lp, lower.len, STR_PTR("insufficient_quota"), STR_LEN("insufficient_quota")) || str_contains(lp, lower.len, STR_PTR("insufficient-quota"), STR_LEN("insufficient-quota")) || str_contains(lp, lower.len, STR_PTR("quota exceeded"), STR_LEN("quota exceeded")) || str_contains(lp, lower.len, STR_PTR("billing"), STR_LEN("billing")) || str_contains(lp, lower.len, STR_PTR("credit"), STR_LEN("credit")) || str_contains(mp, msg.len, STR_PTR("余额不足"), STR_LEN("余额不足")) || str_contains(mp, msg.len, STR_PTR("额度不足"), STR_LEN("额度不足")) || str_contains(mp, msg.len, STR_PTR("配额不足"), STR_LEN("配额不足")) {
        kind = 1;
        availability = 2;
        retryable = false;
    } else if is401 || is403 || str_contains(lp, lower.len, STR_PTR("unauthorized"), STR_LEN("unauthorized")) || str_contains(lp, lower.len, STR_PTR("unauthorised"), STR_LEN("unauthorised")) || str_contains(lp, lower.len, STR_PTR("forbidden"), STR_LEN("forbidden")) || str_contains(lp, lower.len, STR_PTR("invalid api key"), STR_LEN("invalid api key")) || str_contains(mp, msg.len, STR_PTR("鉴权"), STR_LEN("鉴权")) {
        kind = 2;
        availability = 2;
        retryable = false;
    } else if str_contains(lp, lower.len, STR_PTR("disabled"), STR_LEN("disabled")) && (str_contains(lp, lower.len, STR_PTR("relay"), STR_LEN("relay")) || str_contains(lp, lower.len, STR_PTR("provider"), STR_LEN("provider")) || str_contains(lp, lower.len, STR_PTR("group"), STR_LEN("group")) || str_contains(lp, lower.len, STR_PTR("channel"), STR_LEN("channel"))) || str_contains(mp, msg.len, STR_PTR("停用"), STR_LEN("停用")) || str_contains(mp, msg.len, STR_PTR("禁用"), STR_LEN("禁用")) {
        kind = 3;
        availability = 2;
        retryable = false;
    } else if is502 || is503 || str_contains(lp, lower.len, STR_PTR("bad gateway"), STR_LEN("bad gateway")) || str_contains(lp, lower.len, STR_PTR("service unavailable"), STR_LEN("service unavailable")) || str_contains(lp, lower.len, STR_PTR("upstream unavailable"), STR_LEN("upstream unavailable")) || str_contains(mp, msg.len, STR_PTR("不可用"), STR_LEN("不可用")) {
        kind = 4;
        retry_at = now + min_f(15000.0 * mult, 600000.0);
        has_retry = true;
    } else if str_contains(lp, lower.len, STR_PTR("connection"), STR_LEN("connection")) || str_contains(lp, lower.len, STR_PTR("transport"), STR_LEN("transport")) || str_contains(lp, lower.len, STR_PTR("socket"), STR_LEN("socket")) || str_contains(lp, lower.len, STR_PTR("network"), STR_LEN("network")) || str_contains(lp, lower.len, STR_PTR("econn"), STR_LEN("econn")) || str_contains(lp, lower.len, STR_PTR("timed out"), STR_LEN("timed out")) || str_contains(lp, lower.len, STR_PTR("timeout"), STR_LEN("timeout")) || str_contains(lp, lower.len, STR_PTR("disconnected"), STR_LEN("disconnected")) || str_contains(mp, msg.len, STR_PTR("网络"), STR_LEN("网络")) || str_contains(mp, msg.len, STR_PTR("断开"), STR_LEN("断开")) {
        kind = 5;
        retry_at = now + min_f(5000.0 * mult, 300000.0);
        has_retry = true;
    };
    out.availability = AgentHealthAvailability { value: availability };
    out.kind = AgentHealthKind { value: kind };
    // code as JSON text
    out.code_ptr = STR_PTR("null");
    out.code_len = STR_LEN("null");
    if code_kind == 1 {
        let cb = StrBuf { bytes: [0u8; 2048], len: 0 };
        buf_append_f64_int(&cb, code_f);
        let cp2: ptr = PTR_NULL();
        PTR_BYTE_ADD(cp2, &cb.bytes, 0);
        out.code_ptr = cp2;
        out.code_len = cb.len;
    };
    if code_kind == 2 {
        let sp2: ptr = PTR_NULL();
        PTR_BYTE_ADD(sp2, &code_s.bytes, 0);
        out.code_ptr = sp2;
        out.code_len = code_s.len;
    };
    out.message_ptr = mp;
    out.message_len = msg.len;
    out.consecutiveFailures = consecutive;
    if has_prev { out.firstFailureAt = prev.firstFailureAt; } else { out.firstFailureAt = now; };
    out.lastFailureAt = now;
    out.retryAt = retry_at;
    out.retryable = retryable;
}

fn min_f(a: f64, b: f64) -> f64 {
    if a < b { return a; };
    return b;
}



// healthyAgentMember(now = Date.now()) — SLA form takes now
// explicitly (DEFECT: Date.now() has no sa_std counterpart assumed;
// caller supplies epoch ms). kind tag 6 = "unknown", availability 0.
fn healthyAgentMember(now: f64, out: &AgentMemberHealth) -> void {
    out.availability = AgentHealthAvailability { value: 0 };
    out.kind = AgentHealthKind { value: 6 };
    out.code_ptr = STR_PTR("null");
    out.code_len = STR_LEN("null");
    out.message_ptr = STR_PTR("");
    out.message_len = 0;
    out.consecutiveFailures = 0.0;
    out.firstFailureAt = now;
    out.lastFailureAt = now;
    out.retryAt = 0.0;
    out.retryable = true;
}


