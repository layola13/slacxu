// const FREE_OLLAMA_ENABLED = false;
// DEFECT: const data table — SLA has no module-level const arrays/objects;
// value preserved verbatim above; accessor functions are hand-written where used.

// const FREE_MODEL_LICENSE_ENFORCEMENT_ENABLED = false;
// DEFECT: const data table — SLA has no module-level const arrays/objects;
// value preserved verbatim above; accessor functions are hand-written where used.


// isProviderFeatureEnabled(providerId): FREE_OLLAMA_ENABLED is the
// const false above, so this is `id.trim().toLowerCase() !== "free-ollama"`.
fn isProviderFeatureEnabled(id_ptr: ptr, id_len: u64) -> bool {
    let tp: ptr = PTR_NULL();
    let tl: u64 = 0;
    str_trim(id_ptr, id_len, &tp, &tl);
    let lb = StrBuf { bytes: [0u8; 2048], len: 0 };
    buf_lower_copy(&lb, tp, tl);
    let lp: ptr = PTR_NULL();
    PTR_BYTE_ADD(lp, &lb.bytes, 0);
    return !str_eq_lit(lp, lb.len, STR_PTR("free-ollama"), STR_LEN("free-ollama"));
}
