// Converted 1:1 from packages/shared/src/tokenUsage.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
// Conventions (same as packages/codex-protocol): string -> (ptr,len); number -> f64;
// token counts are f64 here because TS number semantics (finite() rounds them);
// dynamic JSON (unknown) -> sa_json_* node handles (u64, 0 = none).

@import "sa_std/json.sai"

struct TokenUsageBreakdown {
    totalTokens: f64,
    inputTokens: f64,
    cachedInputTokens: f64,
    cacheWriteInputTokens: f64,
    outputTokens: f64,
    reasoningOutputTokens: f64,
}

// "openai" = 0, "anthropic" = 1, "gemini" = 2, "normalized" = 3, "opencode" = 4
struct TokenUsageSource {
    value: u64,
}

struct NormalizedTokenUsage {
    totalTokens: f64,
    inputTokens: f64,
    cachedInputTokens: f64,
    cacheWriteInputTokens: f64,
    outputTokens: f64,
    reasoningOutputTokens: f64,
    source: TokenUsageSource,
    reasoningIncludedInOutput: bool,
    reasoningIncludedInOutput_present: bool,
    uncachedInputTokens: f64,
    uncachedInputTokens_present: bool,
}

// DEFECT: TS finite(value: unknown) inspects a dynamic JSON value
// (typeof number + Number.isFinite + >= 0 + Math.round). SLA side
// receives a sa_json node handle; node-kind inspection is assumed
// via sa_json_object_get_f64-style access in the caller helpers
// below (json_num_field). Rounding uses sa_ math-free truncation
// + 0.5 for non-negative values, matching Math.round for >= 0.
fn finite(node: u64, out: &f64) -> bool {
    if node == 0 { return false; };
    let v: f64 = 0.0;
    // DEFECT: no sa_json node-kind/f64 accessor confirmed; assumed
    // sa_json_as_f64(node, &v) shape. Fix phase: align with sci json.sai.
    if sa_json_as_f64(node, &v) != 0 { return false; };
    if v < 0.0 { return false; };
    *out = v + 0.5;
    // truncation toward zero via i64 cast approximates Math.round for v >= 0
    let iv = *out as i64;
    *out = iv as f64;
    return true;
}

fn record_of(value: u64) -> u64 {
    // DEFECT: typeof/isArray checks on unknown approximated by
    // "node exists and is an object" via sa_json kind probe (assumed).
    if value == 0 { return 0; };
    if sa_json_is_object(value) != 0 { return 0; };
    return value;
}

// First present key wins (TS ?? chain). Returns node handle or 0.
fn pick(doc: u64, k1_ptr: ptr, k1_len: u64, k2_ptr: ptr, k2_len: u64, k3_ptr: ptr, k3_len: u64, k4_ptr: ptr, k4_len: u64, k5_ptr: ptr, k5_len: u64, k6_ptr: ptr, k6_len: u64) -> u64 {
    let n: u64 = 0;
    if sa_json_object_get(doc, k1_ptr, k1_len, &n) == 0 && n != 0 { return n; };
    if sa_json_object_get(doc, k2_ptr, k2_len, &n) == 0 && n != 0 { return n; };
    if sa_json_object_get(doc, k3_ptr, k3_len, &n) == 0 && n != 0 { return n; };
    if sa_json_object_get(doc, k4_ptr, k4_len, &n) == 0 && n != 0 { return n; };
    if sa_json_object_get(doc, k5_ptr, k5_len, &n) == 0 && n != 0 { return n; };
    if sa_json_object_get(doc, k6_ptr, k6_len, &n) == 0 && n != 0 { return n; };
    return 0;
}

fn finite_field(doc: u64, k1_ptr: ptr, k1_len: u64, k2_ptr: ptr, k2_len: u64, k3_ptr: ptr, k3_len: u64, k4_ptr: ptr, k4_len: u64, k5_ptr: ptr, k5_len: u64, k6_ptr: ptr, k6_len: u64) -> f64 {
    let node = pick(doc, k1_ptr, k1_len, k2_ptr, k2_len, k3_ptr, k3_len, k4_ptr, k4_len, k5_ptr, k5_len, k6_ptr, k6_len);
    let v: f64 = 0.0;
    if finite(node, &v) { return v; };
    return 0.0;
}

fn has_key(doc: u64, k_ptr: ptr, k_len: u64) -> bool {
    let n: u64 = 0;
    return sa_json_object_get(doc, k_ptr, k_len, &n) == 0;
}

// normalizeTokenUsage(value: unknown, sourceHint?) -> NormalizedTokenUsage | null
// SLA form: fills `out`, returns false for TS null.
// sourceHint: -1 = absent, else TokenUsageSource.value.
// DEFECT: dynamic JSON navigation approximated with sa_json_* node
// handles; `in` operator -> has_key; ?? chains -> pick/first-hit.
fn normalizeTokenUsage(value: u64, sourceHint: i64, out: &NormalizedTokenUsage) -> bool {
    let usage = record_of(value);
    let empty1: ptr = PTR_NULL();
    let promptDetailsDoc = record_of(pick(usage, STR_PTR("prompt_tokens_details"), STR_LEN("prompt_tokens_details"), STR_PTR("input_tokens_details"), STR_LEN("input_tokens_details"), empty1, 0, empty1, 0, empty1, 0, empty1, 0));
    let completionDetailsDoc = record_of(pick(usage, STR_PTR("completion_tokens_details"), STR_LEN("completion_tokens_details"), STR_PTR("output_tokens_details"), STR_LEN("output_tokens_details"), empty1, 0, empty1, 0, empty1, 0, empty1, 0));
    // responsesShape: has *_tokens_details and no anthropic cache keys
    let responsesShape = (has_key(usage, STR_PTR("input_tokens_details"), STR_LEN("input_tokens_details")) || has_key(usage, STR_PTR("output_tokens_details"), STR_LEN("output_tokens_details")))
        && !(has_key(usage, STR_PTR("cache_read_input_tokens"), STR_LEN("cache_read_input_tokens")) || has_key(usage, STR_PTR("cache_creation_input_tokens"), STR_LEN("cache_creation_input_tokens")));
    let source: u64 = 3;
    if sourceHint >= 0 {
        source = sourceHint as u64;
    } else if responsesShape {
        source = 0;
    } else if has_key(usage, STR_PTR("cache_read_input_tokens"), STR_LEN("cache_read_input_tokens")) || has_key(usage, STR_PTR("cache_creation_input_tokens"), STR_LEN("cache_creation_input_tokens")) || has_key(usage, STR_PTR("input_tokens"), STR_LEN("input_tokens")) {
        source = 1;
    } else if has_key(usage, STR_PTR("promptTokenCount"), STR_LEN("promptTokenCount")) || has_key(usage, STR_PTR("cachedContentTokenCount"), STR_LEN("cachedContentTokenCount")) {
        source = 2;
    } else if has_key(usage, STR_PTR("prompt_tokens"), STR_LEN("prompt_tokens")) || has_key(usage, STR_PTR("completion_tokens"), STR_LEN("completion_tokens")) {
        source = 0;
    };
    let empty: ptr = PTR_NULL();
    let inputTokens = finite_field(usage, STR_PTR("inputTokens"), STR_LEN("inputTokens"), STR_PTR("input_tokens"), STR_LEN("input_tokens"), STR_PTR("prompt_tokens"), STR_LEN("prompt_tokens"), STR_PTR("promptTokenCount"), STR_LEN("promptTokenCount"), empty, 0, empty, 0);
    let cachedInputTokens = finite_field(usage, STR_PTR("cachedInputTokens"), STR_LEN("cachedInputTokens"), STR_PTR("cached_input_tokens"), STR_LEN("cached_input_tokens"), STR_PTR("cache_read_input_tokens"), STR_LEN("cache_read_input_tokens"), STR_PTR("cached_tokens"), STR_LEN("cached_tokens"), empty, 0, empty, 0);
    let cachedViaDetails: f64 = 0.0;
    let cd_node: u64 = 0;
    if sa_json_object_get(promptDetailsDoc, STR_PTR("cached_tokens"), STR_LEN("cached_tokens"), &cd_node) == 0 {
        let tmp: f64 = 0.0;
        if finite(cd_node, &tmp) { cachedViaDetails = tmp; };
    };
    if cachedInputTokens == 0.0 && cachedViaDetails != 0.0 { cachedInputTokens = cachedViaDetails; };
    let cachedContent: f64 = 0.0;
    let cc_node: u64 = 0;
    if sa_json_object_get(usage, STR_PTR("cachedContentTokenCount"), STR_LEN("cachedContentTokenCount"), &cc_node) == 0 {
        let tmp: f64 = 0.0;
        if finite(cc_node, &tmp) { cachedContent = tmp; };
    };
    if cachedInputTokens == 0.0 && cachedContent != 0.0 { cachedInputTokens = cachedContent; };
    let cacheWriteInputTokens = finite_field(usage, STR_PTR("cacheWriteInputTokens"), STR_LEN("cacheWriteInputTokens"), STR_PTR("cache_write_input_tokens"), STR_LEN("cache_write_input_tokens"), STR_PTR("cache_creation_input_tokens"), STR_LEN("cache_creation_input_tokens"), STR_PTR("cache_write_tokens"), STR_LEN("cache_write_tokens"), empty, 0, empty, 0);
    let cw_node: u64 = 0;
    if sa_json_object_get(promptDetailsDoc, STR_PTR("cache_write_tokens"), STR_LEN("cache_write_tokens"), &cw_node) == 0 {
        let tmp: f64 = 0.0;
        if finite(cw_node, &tmp) && cacheWriteInputTokens == 0.0 { cacheWriteInputTokens = tmp; };
    };
    let outputTokens = finite_field(usage, STR_PTR("outputTokens"), STR_LEN("outputTokens"), STR_PTR("output_tokens"), STR_LEN("output_tokens"), STR_PTR("completion_tokens"), STR_LEN("completion_tokens"), STR_PTR("candidatesTokenCount"), STR_LEN("candidatesTokenCount"), empty, 0, empty, 0);
    let reasoningOutputTokens = finite_field(usage, STR_PTR("reasoningOutputTokens"), STR_LEN("reasoningOutputTokens"), STR_PTR("reasoning_output_tokens"), STR_LEN("reasoning_output_tokens"), STR_PTR("reasoning_tokens"), STR_LEN("reasoning_tokens"), STR_PTR("reasoningTokenCount"), STR_LEN("reasoningTokenCount"), empty, 0, empty, 0);
    let cr_node: u64 = 0;
    if sa_json_object_get(completionDetailsDoc, STR_PTR("reasoning_tokens"), STR_LEN("reasoning_tokens"), &cr_node) == 0 {
        let tmp: f64 = 0.0;
        if finite(cr_node, &tmp) && reasoningOutputTokens == 0.0 { reasoningOutputTokens = tmp; };
    };
    let cr2_node: u64 = 0;
    if sa_json_object_get(completionDetailsDoc, STR_PTR("reasoningTokenCount"), STR_LEN("reasoningTokenCount"), &cr2_node) == 0 {
        let tmp: f64 = 0.0;
        if finite(cr2_node, &tmp) && reasoningOutputTokens == 0.0 { reasoningOutputTokens = tmp; };
    };
    if inputTokens == 0.0 && cachedInputTokens == 0.0 && cacheWriteInputTokens == 0.0 && outputTokens == 0.0 && reasoningOutputTokens == 0.0 { return false; };
    let reasoningFlag: bool = false;
    let rf_node: u64 = 0;
    if sa_json_object_get(usage, STR_PTR("reasoningIncludedInOutput"), STR_LEN("reasoningIncludedInOutput"), &rf_node) == 0 {
        let b: bool = false;
        if sa_json_as_bool(rf_node, &b) == 0 && b { reasoningFlag = true; };
    };
    let reasoningIncludedInOutput = (source == 1 && reasoningOutputTokens == 0.0) || reasoningFlag;
    // raw total heuristic for legacy inclusive rows
    let rawTotal: f64 = 0.0;
    let hasRawTotal = false;
    let rt_node = pick(usage, STR_PTR("totalTokens"), STR_LEN("totalTokens"), STR_PTR("total_tokens"), STR_LEN("total_tokens"), empty, 0, empty, 0, empty, 0, empty, 0);
    if finite(rt_node, &rawTotal) { hasRawTotal = true; };
    let inclusiveInput: f64 = 0.0;
    let cacheSum = cachedInputTokens + cacheWriteInputTokens;
    if source == 0 || source == 2 {
        inclusiveInput = inputTokens;
        if cacheSum > inclusiveInput { inclusiveInput = cacheSum; };
    } else if hasRawTotal && cacheSum > 0.0 {
        let exclusiveHyp = inputTokens + cachedInputTokens + cacheWriteInputTokens;
        let inclusiveHyp = inputTokens;
        if cacheSum > inclusiveHyp { inclusiveHyp = cacheSum; };
        let outputHyp: f64 = 0.0;
        if reasoningIncludedInOutput {
            outputHyp = outputTokens;
            if reasoningOutputTokens > outputHyp { outputHyp = reasoningOutputTokens; };
        } else {
            outputHyp = outputTokens + reasoningOutputTokens;
        };
        let diffExclusive = rawTotal - (exclusiveHyp + outputHyp);
        if diffExclusive < 0.0 { diffExclusive = 0.0 - diffExclusive; };
        let diffInclusive = rawTotal - (inclusiveHyp + outputHyp);
        if diffInclusive < 0.0 { diffInclusive = 0.0 - diffInclusive; };
        if diffInclusive + 1.0 < diffExclusive { inclusiveInput = inclusiveHyp; } else { inclusiveInput = exclusiveHyp; };
    } else {
        inclusiveInput = inputTokens + cachedInputTokens + cacheWriteInputTokens;
    };
    let inclusiveOutput: f64 = 0.0;
    if reasoningIncludedInOutput || source == 0 || source == 2 {
        inclusiveOutput = outputTokens;
        if reasoningOutputTokens > inclusiveOutput { inclusiveOutput = reasoningOutputTokens; };
    } else {
        inclusiveOutput = outputTokens + reasoningOutputTokens;
    };
    let uncached = inclusiveInput - cachedInputTokens - cacheWriteInputTokens;
    if uncached < 0.0 { uncached = 0.0; };
    out.totalTokens = inclusiveInput + inclusiveOutput;
    out.inputTokens = inclusiveInput;
    out.cachedInputTokens = cachedInputTokens;
    out.cacheWriteInputTokens = cacheWriteInputTokens;
    out.outputTokens = inclusiveOutput;
    out.reasoningOutputTokens = reasoningOutputTokens;
    out.source = TokenUsageSource { value: source };
    out.reasoningIncludedInOutput = reasoningIncludedInOutput;
    out.reasoningIncludedInOutput_present = reasoningIncludedInOutput;
    out.uncachedInputTokens = uncached;
    out.uncachedInputTokens_present = true;
    return true;
}
