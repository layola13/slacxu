// Converted 1:1 from packages/shared/src/agentEngines.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
// Conventions: string -> (ptr,len); string unions -> u64 tag + the
// original string kept alongside for matching; arrays -> StrList;
// catalog consts -> per-index materializer functions (no SLA const
// arrays), mirroring DEFAULT_TOKEN_USAGE_RATES in tokenPricing.sla.

@import "./modelCapabilities.sla"

// AgentEngineId values (tag): codex=0 claude=1 agy=2 gemini=3 crush=4
// auggie=5 grok=6 freebuff=7 coderabbit=8 pi=9 opencode=10
struct AgentEngineId {
    value: u64,
}

// AgentProtocol values (tag): responses=0 anthropic_messages=1
// gemini_generate=2 chat_completions=3 pi_rpc=4 unknown=5
struct AgentProtocol {
    value: u64,
}

struct AgentEngineCapabilities {
    listHistory: bool,
    readTranscript: bool,
    resumeInUi: bool,
    chatRuntime: bool,
    mutateSessions: bool,
}

struct AgentEngineDefinition {
    id: u64,
    id_ptr: ptr,
    id_len: u64,
    label_ptr: ptr,
    label_len: u64,
    product_ptr: ptr,
    product_len: u64,
    launchId_ptr: ptr,
    launchId_len: u64,
    launchId_present: bool,
    altLaunchIds: StrList,
    protocol: u64,
    mark_ptr: ptr,
    mark_len: u64,
    color_ptr: ptr,
    color_len: u64,
    capabilities: AgentEngineCapabilities,
    historyRoots: StrList,
    notes_ptr: ptr,
    notes_len: u64,
    notes_present: bool,
}

// AgentRuntimeBridgePlan.startMode tag: app_server_stdio=0
// cli_subprocess=1 unavailable=2
struct AgentRuntimeBridgePlan {
    engine: u64,
    binaryCandidates: StrList,
    launchEnvPrefix_ptr: ptr,
    launchEnvPrefix_len: u64,
    launchEnvPrefix_present: bool,
    startMode: u64,
}

fn cap_set(out: &AgentEngineCapabilities, lh: bool, rt: bool, resume: bool, chat: bool, mut: bool) -> void {
    out.listHistory = lh;
    out.readTranscript = rt;
    out.resumeInUi = resume;
    out.chatRuntime = chat;
    out.mutateSessions = mut;
}

fn def_reset(out: &AgentEngineDefinition) -> void {
    out.altLaunchIds.len = 0;
    out.historyRoots.len = 0;
    out.launchId_present = false;
    out.notes_present = false;
    out.notes_ptr = PTR_NULL();
    out.notes_len = 0;
}

// AGENT_ENGINE_CATALOG — 11 entries, source order.
// CAP_CODEX / CAP_CLAUDE / CAP_HISTORY_ONLY / CAP_LOGS_ONLY are the
// shared capability literals from the TS module (inlined per entry,
// matching TS reference sharing — SLA structs are values, so the
// sharing is by copy; noted in the defect log).
fn agent_engine_at(idx: u64, out: &AgentEngineDefinition) -> bool {
    def_reset(out);
    if idx == 0 {
        out.id = 0; out.id_ptr = STR_PTR("codex"); out.id_len = STR_LEN("codex");
        out.label_ptr = STR_PTR("Codex"); out.label_len = STR_LEN("Codex");
        out.product_ptr = STR_PTR("OpenAI Codex CLI"); out.product_len = STR_LEN("OpenAI Codex CLI");
        out.launchId_ptr = STR_PTR("code-launch"); out.launchId_len = STR_LEN("code-launch"); out.launchId_present = true;
        out.protocol = 0;
        out.mark_ptr = STR_PTR("Cx"); out.mark_len = STR_LEN("Cx");
        out.color_ptr = STR_PTR("#14b8a6"); out.color_len = STR_LEN("#14b8a6");
        cap_set(&out.capabilities, true, true, true, true, true);
        list_push(&out.historyRoots, STR_PTR("~/.codex/sessions"), STR_LEN("~/.codex/sessions"));
        list_push(&out.historyRoots, STR_PTR("~/.codex/session_index.jsonl"), STR_LEN("~/.codex/session_index.jsonl"));
        out.notes_ptr = STR_PTR("Live engine in this UI via codex app-server."); out.notes_len = STR_LEN("Live engine in this UI via codex app-server."); out.notes_present = true;
        return true;
    };
    if idx == 1 {
        out.id = 1; out.id_ptr = STR_PTR("claude"); out.id_len = STR_LEN("claude");
        out.label_ptr = STR_PTR("Claude"); out.label_len = STR_LEN("Claude");
        out.product_ptr = STR_PTR("Claude Code CLI"); out.product_len = STR_LEN("Claude Code CLI");
        out.launchId_ptr = STR_PTR("claude-launch"); out.launchId_len = STR_LEN("claude-launch"); out.launchId_present = true;
        out.protocol = 1;
        out.mark_ptr = STR_PTR("Cl"); out.mark_len = STR_LEN("Cl");
        out.color_ptr = STR_PTR("#f59e0b"); out.color_len = STR_LEN("#f59e0b");
        cap_set(&out.capabilities, true, true, true, true, false);
        list_push(&out.historyRoots, STR_PTR("~/.claude/history.jsonl"), STR_LEN("~/.claude/history.jsonl"));
        list_push(&out.historyRoots, STR_PTR("~/.claude/projects/**/*.jsonl"), STR_LEN("~/.claude/projects/**/*.jsonl"));
        out.notes_ptr = STR_PTR("Live engine via Claude-compatible CLI runtime (stream-json). Feature flag required."); out.notes_len = STR_LEN("Live engine via Claude-compatible CLI runtime (stream-json). Feature flag required."); out.notes_present = true;
        return true;
    };
    if idx == 2 {
        out.id = 2; out.id_ptr = STR_PTR("agy"); out.id_len = STR_LEN("agy");
        out.label_ptr = STR_PTR("AGY"); out.label_len = STR_LEN("AGY");
        out.product_ptr = STR_PTR("Antigravity (agy) CLI"); out.product_len = STR_LEN("Antigravity (agy) CLI");
        out.launchId_ptr = STR_PTR("agy-launch"); out.launchId_len = STR_LEN("agy-launch"); out.launchId_present = true;
        out.protocol = 2;
        out.mark_ptr = STR_PTR("Ag"); out.mark_len = STR_LEN("Ag");
        out.color_ptr = STR_PTR("#8b5cf6"); out.color_len = STR_LEN("#8b5cf6");
        cap_set(&out.capabilities, true, true, false, false, false);
        list_push(&out.historyRoots, STR_PTR("~/.gemini/antigravity-cli/cache/conversation_metadata.json"), STR_LEN("~/.gemini/antigravity-cli/cache/conversation_metadata.json"));
        list_push(&out.historyRoots, STR_PTR("~/.gemini/antigravity-cli/brain/<id>"), STR_LEN("~/.gemini/antigravity-cli/brain/<id>"));
        list_push(&out.historyRoots, STR_PTR("~/.gemini/antigravity-cli/conversations/<id>.db"), STR_LEN("~/.gemini/antigravity-cli/conversations/<id>.db"));
        return true;
    };
    if idx == 3 {
        out.id = 3; out.id_ptr = STR_PTR("gemini"); out.id_len = STR_LEN("gemini");
        out.label_ptr = STR_PTR("Gemini"); out.label_len = STR_LEN("Gemini");
        out.product_ptr = STR_PTR("Gemini CLI"); out.product_len = STR_LEN("Gemini CLI");
        out.launchId_ptr = STR_PTR("gemini-launch"); out.launchId_len = STR_LEN("gemini-launch"); out.launchId_present = true;
        out.protocol = 2;
        out.mark_ptr = STR_PTR("Gm"); out.mark_len = STR_LEN("Gm");
        out.color_ptr = STR_PTR("#3b82f6"); out.color_len = STR_LEN("#3b82f6");
        cap_set(&out.capabilities, true, true, false, false, false);
        list_push(&out.historyRoots, STR_PTR("~/.gemini/tmp/**/chats/session-*.jsonl"), STR_LEN("~/.gemini/tmp/**/chats/session-*.jsonl"));
        list_push(&out.historyRoots, STR_PTR("~/.gemini/history"), STR_LEN("~/.gemini/history"));
        return true;
    };
    if idx == 4 {
        out.id = 4; out.id_ptr = STR_PTR("crush"); out.id_len = STR_LEN("crush");
        out.label_ptr = STR_PTR("Crush"); out.label_len = STR_LEN("Crush");
        out.product_ptr = STR_PTR("Charm Crush"); out.product_len = STR_LEN("Charm Crush");
        out.launchId_ptr = STR_PTR("crush-launch"); out.launchId_len = STR_LEN("crush-launch"); out.launchId_present = true;
        out.protocol = 3;
        out.mark_ptr = STR_PTR("Cr"); out.mark_len = STR_LEN("Cr");
        out.color_ptr = STR_PTR("#ec4899"); out.color_len = STR_LEN("#ec4899");
        cap_set(&out.capabilities, true, true, false, false, false);
        list_push(&out.historyRoots, STR_PTR("<project>/.crush/crush.db"), STR_LEN("<project>/.crush/crush.db"));
        list_push(&out.historyRoots, STR_PTR("~/.local/share/crush/projects.json"), STR_LEN("~/.local/share/crush/projects.json"));
        return true;
    };
    if idx == 5 {
        out.id = 5; out.id_ptr = STR_PTR("auggie"); out.id_len = STR_LEN("auggie");
        out.label_ptr = STR_PTR("Auggie"); out.label_len = STR_LEN("Auggie");
        out.product_ptr = STR_PTR("Augment Code (auggie)"); out.product_len = STR_LEN("Augment Code (auggie)");
        out.launchId_ptr = STR_PTR("auggie-launch"); out.launchId_len = STR_LEN("auggie-launch"); out.launchId_present = true;
        out.protocol = 5;
        out.mark_ptr = STR_PTR("Au"); out.mark_len = STR_LEN("Au");
        out.color_ptr = STR_PTR("#06b6d4"); out.color_len = STR_LEN("#06b6d4");
        cap_set(&out.capabilities, true, true, false, false, false);
        list_push(&out.historyRoots, STR_PTR("~/.augment/sessions/*.json"), STR_LEN("~/.augment/sessions/*.json"));
        return true;
    };
    if idx == 6 {
        out.id = 6; out.id_ptr = STR_PTR("grok"); out.id_len = STR_LEN("grok");
        out.label_ptr = STR_PTR("Grok"); out.label_len = STR_LEN("Grok");
        out.product_ptr = STR_PTR("xAI Grok / agent CLI"); out.product_len = STR_LEN("xAI Grok / agent CLI");
        out.launchId_ptr = STR_PTR("grok-launch"); out.launchId_len = STR_LEN("grok-launch"); out.launchId_present = true;
        list_push(&out.altLaunchIds, STR_PTR("agent-launch"), STR_LEN("agent-launch"));
        out.protocol = 3;
        out.mark_ptr = STR_PTR("X"); out.mark_len = STR_LEN("X");
        out.color_ptr = STR_PTR("#64748b"); out.color_len = STR_LEN("#64748b");
        cap_set(&out.capabilities, true, true, false, false, false);
        list_push(&out.historyRoots, STR_PTR("~/.grok/sessions/**/summary.json"), STR_LEN("~/.grok/sessions/**/summary.json"));
        list_push(&out.historyRoots, STR_PTR("~/.grok/sessions/**/chat_history.jsonl"), STR_LEN("~/.grok/sessions/**/chat_history.jsonl"));
        return true;
    };
    if idx == 7 {
        out.id = 7; out.id_ptr = STR_PTR("freebuff"); out.id_len = STR_LEN("freebuff");
        out.label_ptr = STR_PTR("Freebuff"); out.label_len = STR_LEN("Freebuff");
        out.product_ptr = STR_PTR("Freebuff / manicode"); out.product_len = STR_LEN("Freebuff / manicode");
        out.launchId_ptr = STR_PTR("freebuff-launch"); out.launchId_len = STR_LEN("freebuff-launch"); out.launchId_present = true;
        out.protocol = 5;
        out.mark_ptr = STR_PTR("Fb"); out.mark_len = STR_LEN("Fb");
        out.color_ptr = STR_PTR("#22c55e"); out.color_len = STR_LEN("#22c55e");
        cap_set(&out.capabilities, true, true, false, false, false);
        list_push(&out.historyRoots, STR_PTR("~/.config/manicode/projects/**/chats/*/chat-meta.json"), STR_LEN("~/.config/manicode/projects/**/chats/*/chat-meta.json"));
        return true;
    };
    if idx == 8 {
        out.id = 8; out.id_ptr = STR_PTR("coderabbit"); out.id_len = STR_LEN("coderabbit");
        out.label_ptr = STR_PTR("CodeRabbit"); out.label_len = STR_LEN("CodeRabbit");
        out.product_ptr = STR_PTR("CodeRabbit CLI"); out.product_len = STR_LEN("CodeRabbit CLI");
        out.launchId_ptr = STR_PTR("coderabbit-launch"); out.launchId_len = STR_LEN("coderabbit-launch"); out.launchId_present = true;
        out.protocol = 5;
        out.mark_ptr = STR_PTR("Rb"); out.mark_len = STR_LEN("Rb");
        out.color_ptr = STR_PTR("#f97316"); out.color_len = STR_LEN("#f97316");
        cap_set(&out.capabilities, true, true, false, false, false);
        list_push(&out.historyRoots, STR_PTR("~/.coderabbit/logs/*.log"), STR_LEN("~/.coderabbit/logs/*.log"));
        out.notes_ptr = STR_PTR("No durable chat sessions found; history lists CLI runs only."); out.notes_len = STR_LEN("No durable chat sessions found; history lists CLI runs only."); out.notes_present = true;
        return true;
    };
    if idx == 9 {
        out.id = 9; out.id_ptr = STR_PTR("pi"); out.id_len = STR_LEN("pi");
        out.label_ptr = STR_PTR("Pi"); out.label_len = STR_LEN("Pi");
        out.product_ptr = STR_PTR("Pi coding agent"); out.product_len = STR_LEN("Pi coding agent");
        out.launchId_ptr = STR_PTR("pi-launch"); out.launchId_len = STR_LEN("pi-launch"); out.launchId_present = true;
        out.protocol = 4;
        out.mark_ptr = STR_PTR("Pi"); out.mark_len = STR_LEN("Pi");
        out.color_ptr = STR_PTR("#a855f7"); out.color_len = STR_LEN("#a855f7");
        cap_set(&out.capabilities, true, true, false, false, false);
