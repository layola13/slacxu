fn agent_engine_catalog_len() -> u64 { return 11; }

// isAgentEngineId(value: string): value is AgentEngineId
// DEFECT: TS type predicate -> plain bool.
fn isAgentEngineId(v_ptr: ptr, v_len: u64) -> bool {
    let e = AgentEngineDefinition { id: 0, id_ptr: PTR_NULL(), id_len: 0, label_ptr: PTR_NULL(), label_len: 0, product_ptr: PTR_NULL(), product_len: 0, launchId_ptr: PTR_NULL(), launchId_len: 0, launchId_present: false, altLaunchIds: StrList { items: [StrRef { ptr: PTR_NULL(), len: 0 }; 32], len: 0 }, protocol: 0, mark_ptr: PTR_NULL(), mark_len: 0, color_ptr: PTR_NULL(), color_len: 0, capabilities: AgentEngineCapabilities { listHistory: false, readTranscript: false, resumeInUi: false, chatRuntime: false, mutateSessions: false }, historyRoots: StrList { items: [StrRef { ptr: PTR_NULL(), len: 0 }; 32], len: 0 }, notes_ptr: PTR_NULL(), notes_len: 0, notes_present: false };
    for i in 0..11 {
        if agent_engine_at(i, &e) {
            if str_eq_lit(e.id_ptr, e.id_len, v_ptr, v_len) { return true; };
        };
    }
    return false;
}

// getAgentEngine(id) — TS throws on unknown; SLA form returns
// false (DEFECT: throw -> status return).
fn getAgentEngine(id: u64, out: &AgentEngineDefinition) -> bool {
    for i in 0..11 {
        if agent_engine_at(i, out) {
            if out.id == id { return true; };
        };
    }
    return false;
}

// agentEngineByLaunchId(launchId) -> definition or undefined(false)
fn agentEngineByLaunchId(l_ptr: ptr, l_len: u64, out: &AgentEngineDefinition) -> bool {
    for i in 0..11 {
        if agent_engine_at(i, out) {
            if out.launchId_present && str_eq_lit(out.launchId_ptr, out.launchId_len, l_ptr, l_len) { return true; };
            if list_contains(&out.altLaunchIds, l_ptr, l_len) { return true; };
        };
    }
    return false;
}

// plannedChatEngines() -> writes matching engine tags into out_ids
// (DEFECT: TS returns definition objects; SLA returns tag list).
fn plannedChatEngines(out_ids: &StrList) -> void {
    out_ids.len = 0;
    let e = AgentEngineDefinition { id: 0, id_ptr: PTR_NULL(), id_len: 0, label_ptr: PTR_NULL(), label_len: 0, product_ptr: PTR_NULL(), product_len: 0, launchId_ptr: PTR_NULL(), launchId_len: 0, launchId_present: false, altLaunchIds: StrList { items: [StrRef { ptr: PTR_NULL(), len: 0 }; 32], len: 0 }, protocol: 0, mark_ptr: PTR_NULL(), mark_len: 0, color_ptr: PTR_NULL(), color_len: 0, capabilities: AgentEngineCapabilities { listHistory: false, readTranscript: false, resumeInUi: false, chatRuntime: false, mutateSessions: false }, historyRoots: StrList { items: [StrRef { ptr: PTR_NULL(), len: 0 }; 32], len: 0 }, notes_ptr: PTR_NULL(), notes_len: 0, notes_present: false };
    for i in 0..11 {
        if agent_engine_at(i, &e) {
            if e.capabilities.chatRuntime || e.capabilities.listHistory {
                list_push(out_ids, e.id_ptr, e.id_len);
            };
        };
    }
}

// AGENT_RUNTIME_BRIDGE_PLAN — 11 entries, source order.
fn agent_runtime_bridge_plan_at(idx: u64, out: &AgentRuntimeBridgePlan) -> bool {
    out.binaryCandidates.len = 0;
    out.launchEnvPrefix_present = true;
    if idx == 0 { out.engine = 0; list_push(&out.binaryCandidates, STR_PTR("codex"), STR_LEN("codex")); out.launchEnvPrefix_ptr = STR_PTR("CODE_LAUNCH_"); out.launchEnvPrefix_len = STR_LEN("CODE_LAUNCH_"); out.startMode = 0; return true; };
    if idx == 1 { out.engine = 1; list_push(&out.binaryCandidates, STR_PTR("claude"), STR_LEN("claude")); out.launchEnvPrefix_ptr = STR_PTR("CLAUDE_LAUNCH_"); out.launchEnvPrefix_len = STR_LEN("CLAUDE_LAUNCH_"); out.startMode = 1; return true; };
    if idx == 2 { out.engine = 2; list_push(&out.binaryCandidates, STR_PTR("agy"), STR_LEN("agy")); out.launchEnvPrefix_ptr = STR_PTR("AGY_LAUNCH_"); out.launchEnvPrefix_len = STR_LEN("AGY_LAUNCH_"); out.startMode = 1; return true; };
    if idx == 3 { out.engine = 3; list_push(&out.binaryCandidates, STR_PTR("gemini"), STR_LEN("gemini")); out.launchEnvPrefix_ptr = STR_PTR("GEMINI_LAUNCH_"); out.launchEnvPrefix_len = STR_LEN("GEMINI_LAUNCH_"); out.startMode = 1; return true; };
    if idx == 4 { out.engine = 4; list_push(&out.binaryCandidates, STR_PTR("crush"), STR_LEN("crush")); out.launchEnvPrefix_ptr = STR_PTR("CRUSH_LAUNCH_"); out.launchEnvPrefix_len = STR_LEN("CRUSH_LAUNCH_"); out.startMode = 1; return true; };
    if idx == 5 { out.engine = 5; list_push(&out.binaryCandidates, STR_PTR("auggie"), STR_LEN("auggie")); out.launchEnvPrefix_ptr = STR_PTR("AUGGIE_LAUNCH_"); out.launchEnvPrefix_len = STR_LEN("AUGGIE_LAUNCH_"); out.startMode = 1; return true; };
    if idx == 6 { out.engine = 6; list_push(&out.binaryCandidates, STR_PTR("agent"), STR_LEN("agent")); list_push(&out.binaryCandidates, STR_PTR("grok"), STR_LEN("grok")); out.launchEnvPrefix_ptr = STR_PTR("GROK_LAUNCH_"); out.launchEnvPrefix_len = STR_LEN("GROK_LAUNCH_"); out.startMode = 1; return true; };
    if idx == 7 { out.engine = 7; list_push(&out.binaryCandidates, STR_PTR("freebuff"), STR_LEN("freebuff")); out.launchEnvPrefix_ptr = STR_PTR("FREEBUFF_LAUNCH_"); out.launchEnvPrefix_len = STR_LEN("FREEBUFF_LAUNCH_"); out.startMode = 1; return true; };
    if idx == 8 { out.engine = 8; list_push(&out.binaryCandidates, STR_PTR("coderabbit"), STR_LEN("coderabbit")); out.launchEnvPrefix_ptr = STR_PTR("CODERABBIT_LAUNCH_"); out.launchEnvPrefix_len = STR_LEN("CODERABBIT_LAUNCH_"); out.startMode = 2; return true; };
    if idx == 9 { out.engine = 9; list_push(&out.binaryCandidates, STR_PTR("pi"), STR_LEN("pi")); out.launchEnvPrefix_ptr = STR_PTR("PI_LAUNCH_"); out.launchEnvPrefix_len = STR_LEN("PI_LAUNCH_"); out.startMode = 1; return true; };
    if idx == 10 { out.engine = 10; list_push(&out.binaryCandidates, STR_PTR("opencode"), STR_LEN("opencode")); out.launchEnvPrefix_ptr = STR_PTR("OPENCODE_LAUNCH_"); out.launchEnvPrefix_len = STR_LEN("OPENCODE_LAUNCH_"); out.startMode = 1; return true; };
    return false;
}

fn agent_runtime_bridge_plan_len() -> u64 { return 11; }
