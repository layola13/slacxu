// TS: #!/usr/bin/env node + top-level statements with top-level
// await and process.exit(n) calls.
// DEFECT: the top-level script becomes cliMain(args, argc, ambient)
// returning the process exit code; process.exit(0) after serveHelp
// etc. map to early returns. process.argv is the (ptr, len) table;
// process.stdin/stdout.isTTY arrive as flags; pkgDir stands in for
// createRequire(import.meta.url)("../package.json").

struct CArg {
    ptr: ptr,
    len: u64,
}

fn argEq(a: &CArg, s_ptr: ptr, s_len: u64) -> bool {
    if a.len != s_len { return false; };
    for i in 0..s_len {
        let c: u8 = 0;
        PTR_BYTE_AT(c, a.ptr, i);
        let d: u8 = 0;
        PTR_BYTE_AT(d, s_ptr, i);
        if c != d { return false; };
    }
    return true;
}

fn argsContain(args: &[CArg; 64], argc: u64, s_ptr: ptr, s_len: u64) -> bool {
    for i in 0..argc {
        if argEq(&args[i], s_ptr, s_len) { return true; };
    }
    return false;
}

fn argStartsWithDash(a: &CArg) -> bool {
    if a.len == 0 { return false; };
    let c: u8 = 0;
    PTR_BYTE_AT(c, a.ptr, 0);
    return c == 45;
}

// /^\d+$/ — Boolean(s && /^\d+$/.test(s))
fn argIsNumeric(a: &CArg, present: bool) -> bool {
    if !present || a.len == 0 { return false; };
    for i in 0..a.len {
        let c: u8 = 0;
        PTR_BYTE_AT(c, a.ptr, i);
        if c < 48 || c > 57 { return false; };
    }
    return true;
}

fn printLine(p: ptr, l: u64) -> void {
    sa_print_bytes(p, l);
    sa_print_bytes(STR_PTR("\n"), STR_LEN("\n"));
}

// --- cli-doctor.sla wrappers (DEFECT: shapes follow the TS usage;
// the doctor() result rides as a doc handle + extracted views) ---
struct DoctorStatusView {
    id_bytes: [u8; 64],
    id_len: u64,
    found: bool,
    has_note: bool,
    note: [u8; 1024],
    note_len: u64,
    install_hint: [u8; 1024],
    install_hint_len: u64,
}

struct DoctorView {
    is_ready: bool,
    statuses: [DoctorStatusView; 16],
    statuses_count: u64,
}

struct InstallResultView {
    ran: bool,
    has_note: bool,
    note: [u8; 1024],
    note_len: u64,
}

fn doctorW(out: &DoctorView) -> void {
    out.is_ready = false;
    out.statuses_count = 0;
}

fn listToolIdsW(out_ids: &[u8; 1024], out_len: &u64, out_count: &u64) -> void {
    // DEFECT: tool id list serialized as a NUL-joined span.
    out_len = 0;
    out_count = 0;
}

fn printDoctorW() -> bool { return false; }

// DEFECT: async prompt — synchronous call in this pass.
fn promptDoctorInteractiveW(has_options: bool, no_prompt: bool) -> void {}

fn runInstallW(id_ptr: ptr, id_len: u64, out: &InstallResultView) -> void {
    out.ran = false;
    out.has_note = false;
    out.note_len = 0;
}

// --- serve.sla wrappers ---
fn serveHelpW() -> void {}
// DEFECT: serve.sla's runServe takes (argv, argc, pkgDir, execPath,
// env) — cli.ts calls runServe(serveArgs) only; the ambient values
// are threaded from cliMain's parameters.
fn runServeW(args: &[CArg; 64], argc: u64, pkg_dir_ptr: ptr, pkg_dir_len: u64, exec_path_ptr: ptr, exec_path_len: u64) -> i32 {
    return 0;
}

// function getCxuVersion(): string (createRequire ../package.json)
// -> server-build.sla's twin; both read <pkgDir>/package.json.
// DEFECT: duplicated TS definitions stay duplicated here.
fn cliGetCxuVersion(pkg_dir_ptr: ptr, pkg_dir_len: u64, out_bytes: &[u8; 128], out_len: &u64) -> void {
    out_len = 0;
    for i in 0..STR_LEN("0.0.0-unknown") {
        let c: u8 = 0;
        PTR_BYTE_AT(c, STR_PTR("0.0.0-unknown"), i);
        out_bytes[out_len] = c;
        out_len = out_len + 1;
    }
}

fn printVersion(pkg_dir_ptr: ptr, pkg_dir_len: u64) -> void {
    let vb = [0u8; 128];
    let vl: u64 = 0;
    cliGetCxuVersion(pkg_dir_ptr, pkg_dir_len, &vb, &vl);
    sa_print_bytes(STR_PTR("cxu v"), STR_LEN("cxu v"));
    for i in 0..vl {
        let one = [0u8; 1];
        one[0] = vb[i];
        let op: ptr = PTR_NULL();
        PTR_BYTE_ADD(op, &one, 0);
        sa_print_bytes(op, 1);
    }
    sa_print_bytes(STR_PTR("\n"), STR_LEN("\n"));
}

// Top-level body. rawArgs = process.argv.slice(2); [cmd, arg, flag].
fn cliMain(args: &[CArg; 64], argc: u64, stdin_tty: bool, stdout_tty: bool, pkg_dir_ptr: ptr, pkg_dir_len: u64, exec_path_ptr: ptr, exec_path_len: u64) -> i32 {
    let has_first = argc > 0;
    let first = CArg { ptr: PTR_NULL(), len: 0 };
    if has_first { first = args[0]; };
    // if (first === "--help" || "-h" || "help") { serveHelp(); exit 0 }
    if has_first && (argEq(&first, STR_PTR("--help"), STR_LEN("--help")) || argEq(&first, STR_PTR("-h"), STR_LEN("-h")) || argEq(&first, STR_PTR("help"), STR_LEN("help"))) {
        serveHelpW();
        return 0;
    };
    // if (first === "--version" || "-v" || "version")
    if has_first && (argEq(&first, STR_PTR("--version"), STR_LEN("--version")) || argEq(&first, STR_PTR("-v"), STR_LEN("-v")) || argEq(&first, STR_PTR("version"), STR_LEN("version"))) {
        printVersion(pkg_dir_ptr, pkg_dir_len);
        return 0;
    };
    let is_serve_action = !has_first
        || argEq(&first, STR_PTR("serve"), STR_LEN("serve"))
        || argEq(&first, STR_PTR("up"), STR_LEN("up"))
        || argEq(&first, STR_PTR("start"), STR_LEN("start"))
        || argIsNumeric(&first, has_first)
        || argStartsWithDash(&first);
    if is_serve_action {
        // serveArgs = (serve|up|start) ? rawArgs.slice(1) : rawArgs
        let skip: u64 = 0;
        if has_first && (argEq(&first, STR_PTR("serve"), STR_LEN("serve")) || argEq(&first, STR_PTR("up"), STR_LEN("up")) || argEq(&first, STR_PTR("start"), STR_LEN("start"))) {
            skip = 1;
        };
        let serve_args = [CArg { ptr: PTR_NULL(), len: 0 }; 64];
        let serve_argc: u64 = 0;
        let si = skip;
        while si < argc {
            serve_args[serve_argc] = args[si];
            serve_argc = serve_argc + 1;
            si = si + 1;
        }
        if argsContain(&serve_args, serve_argc, STR_PTR("--help"), STR_LEN("--help")) || argsContain(&serve_args, serve_argc, STR_PTR("-h"), STR_LEN("-h")) {
            serveHelpW();
            return 0;
        };
        let no_prompt = argsContain(args, argc, STR_PTR("--no-prompt"), STR_LEN("--no-prompt"));
        // 1. Doctor inspection.
        printDoctorW();
        // 2. await promptDoctorInteractive({ noPrompt });
        promptDoctorInteractiveW(true, no_prompt);
        if !stdin_tty || !stdout_tty {
            let after = DoctorView { is_ready: false, statuses: [DoctorStatusView { id_bytes: [0u8; 64], id_len: 0, found: false, has_note: false, note: [0u8; 1024], note_len: 0, install_hint: [0u8; 1024], install_hint_len: 0 }; 16], statuses_count: 0 };
            doctorW(&after);
            // stillMissing = statuses.filter(s => s.id !== "mini" && (!s.found || s.note))
            let still_missing: u64 = 0;
            for k in 0..after.statuses_count {
                let st = &after.statuses[k];
                let is_mini = st.id_len == 4 && st.id_bytes[0] == 109 && st.id_bytes[1] == 105 && st.id_bytes[2] == 110 && st.id_bytes[3] == 105;
                if !is_mini && (!st.found || st.has_note) { still_missing = still_missing + 1; };
            }
            if still_missing > 0 && !no_prompt {
                printLine(STR_PTR("Tip: run `cxu install --all --yes` to auto-install, or `cxu install [tool]` for one tool."), STR_LEN("Tip: run `cxu install --all --yes` to auto-install, or `cxu install [tool]` for one tool."));
            };
        };
        // 3. process.exit(await runServe(serveArgs));
        return runServeW(&serve_args, serve_argc, pkg_dir_ptr, pkg_dir_len, exec_path_ptr, exec_path_len);
    };
    // if (cmd === "doctor")
    if has_first && argEq(&first, STR_PTR("doctor"), STR_LEN("doctor")) {
        let wants_yes = argsContain(args, argc, STR_PTR("--yes"), STR_LEN("--yes")) || argsContain(args, argc, STR_PTR("--all"), STR_LEN("--all"));
        let no_prompt = argsContain(args, argc, STR_PTR("--no-prompt"), STR_LEN("--no-prompt")) || !stdin_tty;
        if wants_yes {
            let ids = [0u8; 1024];
            let ids_len: u64 = 0;
            let ids_count: u64 = 0;
            listToolIdsW(&ids, &ids_len, &ids_count);
            // for (const id of ids): skip when found && !note; else runInstall + log
            // DEFECT: id iteration over the serialized span is
            // expanded in the fix phase with the real listToolIds.
            let view = DoctorView { is_ready: false, statuses: [DoctorStatusView { id_bytes: [0u8; 64], id_len: 0, found: false, has_note: false, note: [0u8; 1024], note_len: 0, install_hint: [0u8; 1024], install_hint_len: 0 }; 16], statuses_count: 0 };
            doctorW(&view);
            if view.is_ready { return 0; };
            return 2;
        };
        let ready = printDoctorW();
        if !ready && !no_prompt {
            promptDoctorInteractiveW(false, false);
            let view2 = DoctorView { is_ready: false, statuses: [DoctorStatusView { id_bytes: [0u8; 64], id_len: 0, found: false, has_note: false, note: [0u8; 1024], note_len: 0, install_hint: [0u8; 1024], install_hint_len: 0 }; 16], statuses_count: 0 };
            doctorW(&view2);
            if view2.is_ready { return 0; };
            return 2;
        };
        if ready { return 0; };
        return 2;
    };
    // if (cmd === "install")
    if has_first && argEq(&first, STR_PTR("install"), STR_LEN("install")) {
        let has_arg = argc > 1;
        let has_flag = argc > 2;
        let arg = CArg { ptr: PTR_NULL(), len: 0 };
        if has_arg { arg = args[1]; };
        let flag = CArg { ptr: PTR_NULL(), len: 0 };
        if has_flag { flag = args[2]; };
        let arg_is_help = has_arg && argEq(&arg, STR_PTR("--help"), STR_LEN("--help"));
        let flag_is_help = has_flag && argEq(&flag, STR_PTR("--help"), STR_LEN("--help"));
        if arg_is_help || flag_is_help || (!has_arg && !has_flag) {
            printLine(STR_PTR("Usage:"), STR_LEN("Usage:"));
            printLine(STR_PTR("  cxu install [tool]        Print install command only, changes nothing"), STR_LEN("  cxu install [tool]        Print install command only, changes nothing"));
            printLine(STR_PTR("  cxu install [tool] --yes  Run the official installer"), STR_LEN("  cxu install [tool] --yes  Run the official installer"));
            printLine(STR_PTR("  cxu install --all --yes   Install every missing tool"), STR_LEN("  cxu install --all --yes   Install every missing tool"));
            // `  Tools: ${listToolIds().join(", ")}`
            sa_print_bytes(STR_PTR("  Tools: "), STR_LEN("  Tools: "));
            sa_print_bytes(STR_PTR("\n"), STR_LEN("\n"));
            return 0;
        };
        let yes = (has_arg && (argEq(&arg, STR_PTR("--yes"), STR_LEN("--yes")) || argEq(&arg, STR_PTR("--all"), STR_LEN("--all")))) || (has_flag && argEq(&flag, STR_PTR("--yes"), STR_LEN("--yes")));
        let wants_all = (has_arg && argEq(&arg, STR_PTR("--all"), STR_LEN("--all"))) || (has_flag && argEq(&flag, STR_PTR("--all"), STR_LEN("--all")));
        let has_target = has_arg && !argEq(&arg, STR_PTR("--yes"), STR_LEN("--yes")) && !argEq(&arg, STR_PTR("--all"), STR_LEN("--all"));
        if !yes {
            // statuses = doctor().statuses.filter(target ? id === target : !found)
            let view = DoctorView { is_ready: false, statuses: [DoctorStatusView { id_bytes: [0u8; 64], id_len: 0, found: false, has_note: false, note: [0u8; 1024], note_len: 0, install_hint: [0u8; 1024], install_hint_len: 0 }; 16], statuses_count: 0 };
            doctorW(&view);
            let matched: u64 = 0;
            for k in 0..view.statuses_count {
                let st = &view.statuses[k];
                let take = false;
                if has_target {
                    take = st.id_len == arg.len;
                    if take {
                        for q in 0..arg.len {
                            let c: u8 = 0;
                            PTR_BYTE_AT(c, arg.ptr, q);
                            if st.id_bytes[q] != c { take = false; };
                        }
                    };
                } else {
                    take = !st.found;
                };
                if take {
                    matched = matched + 1;
                    // console.log(`${s.id}: ${s.installHint}`)
                    let idp: ptr = PTR_NULL();
                    PTR_BYTE_ADD(idp, &st.id_bytes, 0);
                    sa_print_bytes(idp, st.id_len);
                    sa_print_bytes(STR_PTR(": "), STR_LEN(": "));
                    let hp: ptr = PTR_NULL();
                    PTR_BYTE_ADD(hp, &st.install_hint, 0);
                    sa_print_bytes(hp, st.install_hint_len);
                    sa_print_bytes(STR_PTR("\n"), STR_LEN("\n"));
                };
            }
            if has_target && matched == 0 {
                // console.log(`Unknown tool: ${target}. Choices: ${listToolIds().join(", ")}`)
                sa_print_bytes(STR_PTR("Unknown tool: "), STR_LEN("Unknown tool: "));
                sa_print_bytes(arg.ptr, arg.len);
                sa_print_bytes(STR_PTR(". Choices: \n"), STR_LEN(". Choices: \n"));
                return 1;
            };
            printLine(STR_PTR("Re-run with --yes to execute (e.g. `cxu install codex --yes`)."), STR_LEN("Re-run with --yes to execute (e.g. `cxu install codex --yes`)."));
            return 0;
        };
        // ids = wantsAll || !target ? listToolIds() : [target]
        // for (const id of ids) { result = runInstall(id); log note ?? (ran ? `${id} installed.` : `${id} skipped.`) }
        // DEFECT: the loop body is expanded against the real
        // listToolIds shape in the fix phase (same family as the
        // doctor --yes loop above).
        let view3 = DoctorView { is_ready: false, statuses: [DoctorStatusView { id_bytes: [0u8; 64], id_len: 0, found: false, has_note: false, note: [0u8; 1024], note_len: 0, install_hint: [0u8; 1024], install_hint_len: 0 }; 16], statuses_count: 0 };
        doctorW(&view3);
        if view3.is_ready { return 0; };
        return 2;
    };
    // fallthrough: serveHelp(); (implicit exit 0)
    serveHelpW();
    return 0;
}
