// Converted 1:1 from packages/cxu/src/cli.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "sa_std/io/print.sai"
@import "sa_std/ptr.sa"
// @import "./cli-doctor.sla" (doctor/listToolIds/printDoctor/promptDoctorInteractive/runInstall)
