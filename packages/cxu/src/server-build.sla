// Converted 1:1 from packages/cxu/src/server-build.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "sa_std/io/print.sai"
@import "sa_std/ptr.sa"
@import "sa_std/string.sa"
@import "sa_std/env.sai"
@import "sa_std/fs.sai"
@import "sa_std/encoding/json.sai"
@import "sa_std/process.sai"
@import "bun-runtime.sla"

// TS imports: spawnSync (node:child_process); a large node:fs sync
// surface; createRequire (node:module); homedir; path; url;
// getBunInstallHint.
// DEFECT: module-level consts HOME and the import.meta-derived
// distDir become explicit (ptr, len) parameters threaded through the
// functions that used them; process.platform becomes a platform tag
// param (0=win32, 1=darwin, 2=linux, 3=other) where the TS branches on
// it. This file owns the canonical EnsureServerBinaryResult shape;
// serve.sla / postinstall.sla reference it.

struct SBuf {
    bytes: [u8; 4096],
    len: u64,
}

fn sb_reset(b: &SBuf) -> void { b.len = 0; }

fn sb_append(b: &SBuf, src_ptr: ptr, src_len: u64) -> void {
    for i in 0..src_len {
        if b.len < 4096 {
            let c: u8 = PTR_BYTE_AT(src_ptr, i);
            b.bytes[b.len] = c;
            b.len = b.len + 1;
        };
    }
}

fn sb_append_buf(b: &SBuf, src: &SBuf) -> void {
    for i in 0..src.len {
        if b.len < 4096 {
            b.bytes[b.len] = src.bytes[i];
            b.len = b.len + 1;
        };
    }
}

fn sb_copy(dst: &SBuf, src_ptr: ptr, src_len: u64) -> void {
    sb_reset(dst);
    sb_append(dst, src_ptr, src_len);
}

fn sb_join2(out: &SBuf, a: &SBuf, b_ptr: ptr, b_len: u64) -> void {
    sb_reset(out);
    sb_append_buf(out, a);
    if out.len > 0 && out.bytes[out.len - 1] != 47 { sb_append(out, STR_PTR("/"), STR_LEN("/")); };
    sb_append(out, b_ptr, b_len);
}

fn sb_join3(out: &SBuf, a: &SBuf, b_ptr: ptr, b_len: u64, c_ptr: ptr, c_len: u64) -> void {
    let step = SBuf { bytes: [0u8; 4096], len: 0 };
    sb_join2(&step, a, b_ptr, b_len);
    let sp: ptr = PTR_NULL();
    PTR_BYTE_ADD(sp, &step.bytes, 0);
    sb_join2(out, &step, c_ptr, c_len);
}

fn sb_dirname(out: &SBuf, p: &SBuf) -> void {
    sb_reset(out);
    let cut: u64 = 0;
    for i in 0..p.len {
        if p.bytes[i] == 47 { cut = i; };
    }
    for j in 0..cut {
        if out.len < 4096 { out.bytes[out.len] = p.bytes[j]; out.len = out.len + 1; };
    }
}

fn sb_trimmed(p: ptr, len: u64, out_lo: &u64, out_hi: &u64) -> void {
    let lo: u64 = 0;
    let hi = len;
    while lo < hi {
        let c: u8 = PTR_BYTE_AT(p, lo);
        if c != 32 && c != 9 && c != 10 && c != 13 { break; };
        lo = lo + 1;
    }
    while hi > lo {
        let c: u8 = PTR_BYTE_AT(p, hi - 1);
        if c != 32 && c != 9 && c != 10 && c != 13 { break; };
        hi = hi - 1;
    }
    *out_lo = lo;
    *out_hi = hi;
}

// --- fs wrappers over the sa_std surface (DEFECT: several node:fs
// sync calls — cpSync recursive, renameSync, chmodSync, statSync,
// openSync/readSync/closeSync — map to std externs stubbed here) ---
fn fs_exists(p: &SBuf) -> bool {
    let total: u64 = 0;
    return sa_std_fs_len(&p.bytes, p.len, &total) == 0;
}

fn fs_size(p: &SBuf, out_size: &u64) -> bool {
    return sa_std_fs_len(&p.bytes, p.len, out_size) == 0;
}

fn fs_mtime_ms(p: &SBuf, out_ms: &u64) -> bool {
    // DEFECT: statSync().mtimeMs — std stat surface TBD.
    *out_ms = 0;
    return false;
}

fn fs_mkdir_recursive(p: &SBuf) -> void {}
fn fs_copy_file(from: &SBuf, to: &SBuf) -> void {
    // DEFECT: copyFileSync — read+write approximation in fix phase.
}
fn fs_cp_recursive(from: &SBuf, to: &SBuf) -> void {}
fn fs_rm_recursive_force(p: &SBuf) -> void {
    sa_fs_remove_file(&p.bytes, p.len);
}
fn fs_rename(from: &SBuf, to: &SBuf) -> i32 { return 0; }
fn fs_chmod(p: &SBuf, mode: u64) -> void {}

fn fs_read_all(p: &SBuf, out: &SBuf) -> bool {
    let total: u64 = 0;
    if sa_std_fs_len(&p.bytes, p.len, &total) != 0 { return false; };
    if total > 4096 { return false; };
    let fh: u64 = 0;
    if sa_std_fs_open_read(&p.bytes, p.len, &fh) != 0 { return false; };
    let big = [0u8; 4096];
    let read_n: u64 = 0;
    let rst = sa_std_fs_file_read(fh, &big, total, &read_n);
    sa_fs_file_close(fh);
    if rst != 0 { return false; };
    sb_reset(out);
    for i in 0..read_n {
        if out.len < 4096 { out.bytes[out.len] = big[i]; out.len = out.len + 1; };
    }
    return true;
}

// createRequire(import.meta.url)("../package.json").version
// DEFECT: module resolution + JSON require — approximated by reading
// <pkgDir>/package.json (pkgDir passed in) and extracting "version"
// via sa_json.
fn getCxuVersion(pkg_dir: &SBuf, out: &SBuf) -> void {
    let pkg_path = SBuf { bytes: [0u8; 4096], len: 0 };
    sb_join2(&pkg_path, pkg_dir, STR_PTR("package.json"), STR_LEN("package.json"));
    let raw = SBuf { bytes: [0u8; 4096], len: 0 };
    if fs_read_all(&pkg_path, &raw) {
        let doc = sa_json_parse(&raw.bytes, raw.len);
        if doc != 0 {
            let vp: ptr = PTR_NULL();
            let vl: u64 = 0;
            if sa_json_object_get_string(doc, STR_PTR("version"), STR_LEN("version"), &vp, &vl) == 0 && vl > 0 {
                sb_copy(out, vp, vl);
                return;
            };
        };
    };
    sb_copy(out, STR_PTR("0.0.0-unknown"), STR_LEN("0.0.0-unknown"));
}

// type VersionTuple = [number, number, number] -> [u64; 3] + flag.
fn parseVersionTuple(value_ptr: ptr, value_len: u64, out: &[u64; 3]) -> bool {
    // const match = /(\d+)\.(\d+)\.(\d+)/.exec(value);
    // DEFECT: regex -> digit-run scan for the first d+.d+.d+ pattern.
    let i: u64 = 0;
    while i < value_len {
        let c: u8 = PTR_BYTE_AT(value_ptr, i);
        if c >= 48 && c <= 57 {
            let end1 = scanDigits(value_ptr, value_len, i, &out[0]);
            if end1 < value_len && byteAt(value_ptr, end1) == 46 {
                let end2 = scanDigits(value_ptr, value_len, end1 + 1, &out[1]);
                if end2 < value_len && byteAt(value_ptr, end2) == 46 {
                    let end3 = scanDigits(value_ptr, value_len, end2 + 1, &out[2]);
                    if end3 > end2 + 1 { return true; };
                };
            };
        };
        i = i + 1;
    }
    return false;
}

fn byteAt(p: ptr, i: u64) -> u8 {
    let c: u8 = PTR_BYTE_AT(p, i);
    return c;
}

fn scanDigits(p: ptr, len: u64, from: u64, out_v: &u64) -> u64 {
    let v: u64 = 0;
    let i = from;
    while i < len {
        let c: u8 = PTR_BYTE_AT(p, i);
        if c < 48 || c > 57 { break; };
        v = v * 10 + (c - 48) as u64;
        i = i + 1;
    }
    *out_v = v;
    return i;
}

fn compareTuples(left: &[u64; 3], right: &[u64; 3]) -> i32 {
    for index in 0..3 {
        if left[index] != right[index] {
            if left[index] < right[index] { return -1; };
            return 1;
        };
    }
    return 0;
}

// getLocalBunVersion() -> string | null
// DEFECT: spawnSync("bun", ["--version"], {encoding:"utf8",
// timeout:5000}) — the sync-spawn probe stub (same family as
// bun-runtime.sla); writes version text into out, returns found.
fn getLocalBunVersion(out: &SBuf) -> bool {
    return bunVersionText(out);
}

// DEFECT: stub — wired to the process spawn extern in the fix phase.
fn bunVersionText(out: &SBuf) -> bool {
    sb_reset(out);
    return false;
}

struct BunCheck {
    ok: bool,
    version: SBuf,
    hint: SBuf,
}

// checkBunForBuild() -> { ok: true; version } | { ok: false; hint }
// getBunInstallHint() in the TS uses process.platform internally;
// the SLA twin needs the platform tag — threaded as `platform`
// (DEFECT: signature delta vs bun-runtime.sla is unified there).
fn checkBunForBuild(platform: u64, out: &BunCheck) -> void {
    let version = SBuf { bytes: [0u8; 4096], len: 0 };
    if !getLocalBunVersion(&version) {
        out.ok = false;
        sb_reset(&out.hint);
        sb_append(&out.hint, STR_PTR("Bun is required to compile the codex-ultra server on first run but was not found. Install it first: "), STR_LEN("Bun is required to compile the codex-ultra server on first run but was not found. Install it first: "));
        appendBunHint(platform, &out.hint);
        return;
    };
    let current = [0u64; 3];
    let minimum = [0u64; 3];
    let vp: ptr = PTR_NULL();
    PTR_BYTE_ADD(vp, &version.bytes, 0);
    let has_current = parseVersionTuple(vp, version.len, &current);
    let has_minimum = parseVersionTuple(STR_PTR("1.1.0"), STR_LEN("1.1.0"), &minimum);
    if !has_current || !has_minimum || compareTuples(&current, &minimum) < 0 {
        out.ok = false;
        sb_reset(&out.hint);
        sb_append(&out.hint, STR_PTR("Bun "), STR_LEN("Bun "));
        sb_append_buf(&out.hint, &version);
        sb_append(&out.hint, STR_PTR(" detected, but cxu needs Bun >= 1.1.0 to compile the server. Upgrade: "), STR_LEN(" detected, but cxu needs Bun >= 1.1.0 to compile the server. Upgrade: "));
        appendBunHint(platform, &out.hint);
        return;
    };
    out.ok = true;
    out.version = version;
}

fn appendBunHint(platform: u64, out: &SBuf) -> void {
    let hint = BunByteBuf { bytes: [0u8; 1024], len: 0 };
    getBunInstallHint(platform, &hint);
    for i in 0..hint.len {
        if out.len < 4096 {
            out.bytes[out.len] = hint.bytes[i];
            out.len = out.len + 1;
        };
    }
}

// function toWindowsVersion(value: string): string
// numbers = (value.match(/\d+/g) ?? ["0"]).map(Number).slice(-4);
// while (numbers.length < 4) numbers.unshift(0); join(".")
// DEFECT: regex global match -> digit-run scan.
fn toWindowsVersion(value_ptr: ptr, value_len: u64, out: &SBuf) -> void {
    let nums = [0u64; 16];
    let count: u64 = 0;
    let i: u64 = 0;
    while i < value_len {
        let c: u8 = PTR_BYTE_AT(value_ptr, i);
        if c >= 48 && c <= 57 {
            let v: u64 = 0;
            let end = scanDigits(value_ptr, value_len, i, &v);
            if count < 16 { nums[count] = v; count = count + 1; };
            i = end;
        } else {
            i = i + 1;
        };
    }
    if count == 0 { nums[0] = 0; count = 1; };
    // slice(-4)
    let start: u64 = 0;
    if count > 4 { start = count - 4; };
    let kept = count - start;
    sb_reset(out);
    // unshift(0) until 4 numbers
    let pad = 4 - kept;
    let first = true;
    for k in 0..pad {
        if !first { sb_append(out, STR_PTR("."), STR_LEN(".")); };
        first = false;
        sb_append(out, STR_PTR("0"), STR_LEN("0"));
    }
    let j = start;
    while j < count {
        if !first { sb_append(out, STR_PTR("."), STR_LEN(".")); };
        first = false;
        sb_append_u64(out, nums[j]);
        j = j + 1;
    }
}

fn sb_append_u64(b: &SBuf, v: u64) -> void {
    let digits = [0u8; 20];
    let n: u64 = 0;
    let x = v;
    if x == 0 { sb_append(b, STR_PTR("0"), STR_LEN("0")); return; };
    while x > 0 {
        digits[n] = 48 + (x % 10) as u8;
        n = n + 1;
        x = x / 10;
    }
    let i = n;
    while i > 0 {
        i = i - 1;
        if b.len < 4096 { b.bytes[b.len] = digits[i]; b.len = b.len + 1; };
    }
}

// function resolveServerBundle() -> string | null
// join(distDir, "..", "server-bundle", "index.js") exists?
// DEFECT: distDir (module dir) passed in; ".." segment kept literal
// like the TS join result before normalization.
fn resolveServerBundle(dist_dir: &SBuf, out: &SBuf) -> bool {
    sb_join3(out, dist_dir, STR_PTR(".."), STR_LEN(".."), STR_PTR("server-bundle"), STR_LEN("server-bundle"));
    let full = SBuf { bytes: [0u8; 4096], len: 0 };
    sb_join2(&full, out, STR_PTR("index.js"), STR_LEN("index.js"));
    if fs_exists(&full) {
        out.len = 0;
        sb_append_buf(out, &full);
        return true;
    };
    return false;
}

// function resolveBundledSaVmMcpScript() -> string | null
fn resolveBundledSaVmMcpScript(dist_dir: &SBuf, out: &SBuf) -> bool {
    sb_join3(out, dist_dir, STR_PTR(".."), STR_LEN(".."), STR_PTR("server-bundle"), STR_LEN("server-bundle"));
    let full = SBuf { bytes: [0u8; 4096], len: 0 };
    sb_join2(&full, out, STR_PTR("sa-vm-mcp.mjs"), STR_LEN("sa-vm-mcp.mjs"));
    if fs_exists(&full) {
        out.len = 0;
        sb_append_buf(out, &full);
        return true;
    };
    return false;
}

// export function getServerCacheDir(version) -> string
// join(HOME, ".cxu", "server", `v${version}`)
fn getServerCacheDir(home: &SBuf, version: &SBuf, out: &SBuf) -> void {
    let step = SBuf { bytes: [0u8; 4096], len: 0 };
    sb_join2(&step, home, STR_PTR(".cxu"), STR_LEN(".cxu"));
    let step2 = SBuf { bytes: [0u8; 4096], len: 0 };
    let sp: ptr = PTR_NULL();
    PTR_BYTE_ADD(sp, &step.bytes, 0);
    sb_join2(&step2, &step, STR_PTR("server"), STR_LEN("server"));
    let vname = SBuf { bytes: [0u8; 4096], len: 0 };
    sb_append(&vname, STR_PTR("v"), STR_LEN("v"));
    sb_append_buf(&vname, version);
    let vp: ptr = PTR_NULL();
    PTR_BYTE_ADD(vp, &vname.bytes, 0);
    sb_join2(out, &step2, vp, vname.len);
}

// seedSaVmMcpBesideCachedServer(version) — best-effort, silent.
// (TS: Linux/macOS only; caller gates on platform.)
fn seedSaVmMcpBesideCachedServer(dist_dir: &SBuf, home: &SBuf, version: &SBuf) -> void {
    let source = SBuf { bytes: [0u8; 4096], len: 0 };
    if !resolveBundledSaVmMcpScript(dist_dir, &source) { return; };
    let out_dir = SBuf { bytes: [0u8; 4096], len: 0 };
    getServerCacheDir(home, version, &out_dir);
    let target = SBuf { bytes: [0u8; 4096], len: 0 };
    sb_join2(&target, &out_dir, STR_PTR("sa-vm-mcp.mjs"), STR_LEN("sa-vm-mcp.mjs"));
    if fs_exists(&target) {
        let size: u64 = 0;
        if fs_size(&target, &size) && size > 0 { return; };
    };
    fs_mkdir_recursive(&out_dir);
    fs_copy_file(&source, &target);
    fs_chmod(&target, 420);
}

// resolveBundledNodePtyDir() -> string | null
// candidates: <dist>/../server-bundle/node-pty, <dist>/../node_modules/node-pty,
// then createRequire resolve("node-pty/package.json") dir.
// DEFECT: the require.resolve fallback has no std counterpart —
// returns false when the two path candidates miss.
fn resolveBundledNodePtyDir(dist_dir: &SBuf, out: &SBuf) -> bool {
    let c1 = SBuf { bytes: [0u8; 4096], len: 0 };
    sb_join3(&c1, dist_dir, STR_PTR(".."), STR_LEN(".."), STR_PTR("server-bundle"), STR_LEN("server-bundle"));
    let c1d = SBuf { bytes: [0u8; 4096], len: 0 };
    sb_join2(&c1d, &c1, STR_PTR("node-pty"), STR_LEN("node-pty"));
    if nodePtyDirUsable(&c1d) { out.len = 0; sb_append_buf(out, &c1d); return true; };
    let c2 = SBuf { bytes: [0u8; 4096], len: 0 };
    sb_join3(&c2, dist_dir, STR_PTR(".."), STR_LEN(".."), STR_PTR("node_modules"), STR_LEN("node_modules"));
    let c2d = SBuf { bytes: [0u8; 4096], len: 0 };
    sb_join2(&c2d, &c2, STR_PTR("node-pty"), STR_LEN("node-pty"));
    if nodePtyDirUsable(&c2d) { out.len = 0; sb_append_buf(out, &c2d); return true; };
    return false;
}

fn nodePtyDirUsable(dir: &SBuf) -> bool {
    let pkg = SBuf { bytes: [0u8; 4096], len: 0 };
    sb_join2(&pkg, dir, STR_PTR("package.json"), STR_LEN("package.json"));
    if !fs_exists(&pkg) { return false; };
    let lib = SBuf { bytes: [0u8; 4096], len: 0 };
    sb_join2(&lib, dir, STR_PTR("lib"), STR_LEN("lib"));
    let idx = SBuf { bytes: [0u8; 4096], len: 0 };
    sb_join2(&idx, &lib, STR_PTR("index.js"), STR_LEN("index.js"));
    return fs_exists(&idx);
}

// isNodePtySeedHealthy(dir) — platform branch via tag param.
fn isNodePtySeedHealthy(dir: &SBuf, platform: u64) -> bool {
    if !nodePtyDirUsable(dir) { return false; };
    if platform == 0 {
        let pre = SBuf { bytes: [0u8; 4096], len: 0 };
        sb_join2(&pre, dir, STR_PTR("prebuilds"), STR_LEN("prebuilds"));
        let wx = SBuf { bytes: [0u8; 4096], len: 0 };
        sb_join2(&wx, &pre, STR_PTR("win32-x64"), STR_LEN("win32-x64"));
        let conpty = SBuf { bytes: [0u8; 4096], len: 0 };
        sb_join2(&conpty, &wx, STR_PTR("conpty.node"), STR_LEN("conpty.node"));
        if !fs_exists(&conpty) { return false; };
        let pty = SBuf { bytes: [0u8; 4096], len: 0 };
        sb_join2(&pty, &wx, STR_PTR("pty.node"), STR_LEN("pty.node"));
        return fs_exists(&pty);
    };
    let rel = SBuf { bytes: [0u8; 4096], len: 0 };
    sb_join2(&rel, dir, STR_PTR("build"), STR_LEN("build"));
    let rel2 = SBuf { bytes: [0u8; 4096], len: 0 };
    sb_join2(&rel2, &rel, STR_PTR("Release"), STR_LEN("Release"));
    let pty = SBuf { bytes: [0u8; 4096], len: 0 };
    sb_join2(&pty, &rel2, STR_PTR("pty.node"), STR_LEN("pty.node"));
    if fs_exists(&pty) { return true; };
    let pre = SBuf { bytes: [0u8; 4096], len: 0 };
    sb_join2(&pre, dir, STR_PTR("prebuilds"), STR_LEN("prebuilds"));
    return fs_exists(&pre);
}

// seedNodePtyBesideCachedServer(version) — pruned copy:
// package.json + lib/ + selected prebuilds + build/Release natives.
// DEFECT: readdirSync(withFileTypes) directory iteration over
// prebuilds becomes a fixed candidate list (win32-x64 and
// <platform>-<arch>) checked by existence.
fn seedNodePtyBesideCachedServer(home: &SBuf, version: &SBuf, platform: u64, arch_ptr: ptr, arch_len: u64, dist_dir: &SBuf) -> void {
    let source = SBuf { bytes: [0u8; 4096], len: 0 };
    if !resolveBundledNodePtyDir(dist_dir, &source) { return; };
    let cache = SBuf { bytes: [0u8; 4096], len: 0 };
    getServerCacheDir(home, version, &cache);
    let nm = SBuf { bytes: [0u8; 4096], len: 0 };
    sb_join2(&nm, &cache, STR_PTR("node_modules"), STR_LEN("node_modules"));
    let target = SBuf { bytes: [0u8; 4096], len: 0 };
    sb_join2(&target, &nm, STR_PTR("node-pty"), STR_LEN("node-pty"));
    if isNodePtySeedHealthy(&target, platform) { return; };
    fs_mkdir_recursive(&target);
    let sp = SBuf { bytes: [0u8; 4096], len: 0 };
    sb_join2(&sp, &source, STR_PTR("package.json"), STR_LEN("package.json"));
    let tp = SBuf { bytes: [0u8; 4096], len: 0 };
    sb_join2(&tp, &target, STR_PTR("package.json"), STR_LEN("package.json"));
    fs_copy_file(&sp, &tp);
    let slib = SBuf { bytes: [0u8; 4096], len: 0 };
    sb_join2(&slib, &source, STR_PTR("lib"), STR_LEN("lib"));
    let tlib = SBuf { bytes: [0u8; 4096], len: 0 };
    sb_join2(&tlib, &target, STR_PTR("lib"), STR_LEN("lib"));
    fs_rm_recursive_force(&tlib);
    fs_cp_recursive(&slib, &tlib);
    // prebuilds: keep win32-x64 and `${platform}-${arch}`.
    // DEFECT: arch string arrives precomputed as (ptr, len).
    let spre = SBuf { bytes: [0u8; 4096], len: 0 };
    sb_join2(&spre, &source, STR_PTR("prebuilds"), STR_LEN("prebuilds"));
    if fs_exists(&spre) {
        let tpre = SBuf { bytes: [0u8; 4096], len: 0 };
        sb_join2(&tpre, &target, STR_PTR("prebuilds"), STR_LEN("prebuilds"));
        fs_rm_recursive_force(&tpre);
        fs_mkdir_recursive(&tpre);
        copyPrebuildEntry(&spre, &tpre, STR_PTR("win32-x64"), STR_LEN("win32-x64"));
        let plat_name = SBuf { bytes: [0u8; 4096], len: 0 };
        sb_append(&plat_name, STR_PTR("linux-"), STR_LEN("linux-"));
        // DEFECT: `${process.platform}-${process.arch}` — platform
        // name approximated from the tag (2=linux); arch from param.
        sb_append(&plat_name, arch_ptr, arch_len);
        let pp: ptr = PTR_NULL();
        PTR_BYTE_ADD(pp, &plat_name.bytes, 0);
        copyPrebuildEntry(&spre, &tpre, pp, plat_name.len);
    };
    // build/Release natives.
    let srel = SBuf { bytes: [0u8; 4096], len: 0 };
    sb_join2(&srel, &source, STR_PTR("build"), STR_LEN("build"));
    let srel2 = SBuf { bytes: [0u8; 4096], len: 0 };
    sb_join2(&srel2, &srel, STR_PTR("Release"), STR_LEN("Release"));
    let p1 = SBuf { bytes: [0u8; 4096], len: 0 };
    sb_join2(&p1, &srel2, STR_PTR("pty.node"), STR_LEN("pty.node"));
    let p2 = SBuf { bytes: [0u8; 4096], len: 0 };
    sb_join2(&p2, &srel2, STR_PTR("conpty.node"), STR_LEN("conpty.node"));
    if fs_exists(&p1) || fs_exists(&p2) {
        let trel = SBuf { bytes: [0u8; 4096], len: 0 };
        sb_join2(&trel, &target, STR_PTR("build"), STR_LEN("build"));
        let trel2 = SBuf { bytes: [0u8; 4096], len: 0 };
        sb_join2(&trel2, &trel, STR_PTR("Release"), STR_LEN("Release"));
        fs_mkdir_recursive(&trel2);
        copyIfExists(&srel2, &trel2, STR_PTR("pty.node"), STR_LEN("pty.node"));
        copyIfExists(&srel2, &trel2, STR_PTR("conpty.node"), STR_LEN("conpty.node"));
        copyIfExists(&srel2, &trel2, STR_PTR("conpty_console_list.node"), STR_LEN("conpty_console_list.node"));
        let sconpty = SBuf { bytes: [0u8; 4096], len: 0 };
        sb_join2(&sconpty, &srel2, STR_PTR("conpty"), STR_LEN("conpty"));
        if fs_exists(&sconpty) {
            let tconpty = SBuf { bytes: [0u8; 4096], len: 0 };
            sb_join2(&tconpty, &trel2, STR_PTR("conpty"), STR_LEN("conpty"));
            fs_cp_recursive(&sconpty, &tconpty);
        };
    };
}

fn copyPrebuildEntry(spre: &SBuf, tpre: &SBuf, name_ptr: ptr, name_len: u64) -> void {
    let from = SBuf { bytes: [0u8; 4096], len: 0 };
    sb_join2(&from, spre, name_ptr, name_len);
    if !fs_exists(&from) { return; };
    let to = SBuf { bytes: [0u8; 4096], len: 0 };
    sb_join2(&to, tpre, name_ptr, name_len);
    fs_cp_recursive(&from, &to);
}

fn copyIfExists(sdir: &SBuf, tdir: &SBuf, name_ptr: ptr, name_len: u64) -> void {
    let from = SBuf { bytes: [0u8; 4096], len: 0 };
    sb_join2(&from, sdir, name_ptr, name_len);
    if !fs_exists(&from) { return; };
    let to = SBuf { bytes: [0u8; 4096], len: 0 };
    sb_join2(&to, tdir, name_ptr, name_len);
    fs_copy_file(&from, &to);
}

// needsServerRecompileForPtyFix(version): no marker -> true; marker
// without "node-pty" in externals[] -> true; parse error -> false.
fn needsServerRecompileForPtyFix(home: &SBuf, version: &SBuf) -> bool {
    let cache = SBuf { bytes: [0u8; 4096], len: 0 };
    getServerCacheDir(home, version, &cache);
    let info_path = SBuf { bytes: [0u8; 4096], len: 0 };
    sb_join2(&info_path, &cache, STR_PTR(".build-info.json"), STR_LEN(".build-info.json"));
    if !fs_exists(&info_path) { return true; };
    let raw = SBuf { bytes: [0u8; 4096], len: 0 };
    if !fs_read_all(&info_path, &raw) { return false; };
    let doc = sa_json_parse(&raw.bytes, raw.len);
    if doc == 0 { return false; };
    let ext: u64 = 0;
    if sa_json_object_get(doc, STR_PTR("externals"), STR_LEN("externals"), &ext) != 0 { return true; };
    let probe: u64 = 0;
    if sa_json_array_get(ext, 0, &probe) != 0 { return true; };
    // walk the array looking for "node-pty"
    let i: u64 = 0;
    let found = false;
    while i < 64 {
        let item: u64 = 0;
        if sa_json_array_get(ext, i, &item) != 0 { break; };
        let ip: ptr = PTR_NULL();
        let il: u64 = 0;
        if sa_json_kind(item) == 5 {
            ip = sa_json_string_ptr(item);
            il = sa_json_string_len(item);
            if il == STR_LEN("node-pty") {
                let eq = true;
                for k in 0..il {
                    let c: u8 = PTR_BYTE_AT(ip, k);
                    let d: u8 = PTR_BYTE_AT(STR_PTR("node-pty"), k);
                    if c != d { eq = false; };
                }
                if eq { found = true; };
            };
        };
        i = i + 1;
    }
    return !found;
}

// seedPiRelayBesideCachedServer(version)
fn seedPiRelayBesideCachedServer(dist_dir: &SBuf, home: &SBuf, version: &SBuf) -> void {
    let c1 = SBuf { bytes: [0u8; 4096], len: 0 };
    sb_join3(&c1, dist_dir, STR_PTR(".."), STR_LEN(".."), STR_PTR("server-bundle"), STR_LEN("server-bundle"));
    let c1d = SBuf { bytes: [0u8; 4096], len: 0 };
    sb_join2(&c1d, &c1, STR_PTR("extensions"), STR_LEN("extensions"));
    let src1 = SBuf { bytes: [0u8; 4096], len: 0 };
    sb_join2(&src1, &c1d, STR_PTR("pi-relay"), STR_LEN("pi-relay"));
    let c2 = SBuf { bytes: [0u8; 4096], len: 0 };
    sb_join3(&c2, dist_dir, STR_PTR(".."), STR_LEN(".."), STR_PTR("extensions"), STR_LEN("extensions"));
    let src2 = SBuf { bytes: [0u8; 4096], len: 0 };
    sb_join2(&src2, &c2, STR_PTR("pi-relay"), STR_LEN("pi-relay"));
    let source = SBuf { bytes: [0u8; 4096], len: 0 };
    let idx1 = SBuf { bytes: [0u8; 4096], len: 0 };
    sb_join2(&idx1, &src1, STR_PTR("index.js"), STR_LEN("index.js"));
    let idx2 = SBuf { bytes: [0u8; 4096], len: 0 };
    sb_join2(&idx2, &src2, STR_PTR("index.js"), STR_LEN("index.js"));
    if fs_exists(&idx1) { sb_append_buf(&source, &src1); } else if fs_exists(&idx2) { sb_append_buf(&source, &src2); } else { return; };
    let cache = SBuf { bytes: [0u8; 4096], len: 0 };
    getServerCacheDir(home, version, &cache);
    let ext = SBuf { bytes: [0u8; 4096], len: 0 };
    sb_join2(&ext, &cache, STR_PTR("extensions"), STR_LEN("extensions"));
    let out_dir = SBuf { bytes: [0u8; 4096], len: 0 };
    sb_join2(&out_dir, &ext, STR_PTR("pi-relay"), STR_LEN("pi-relay"));
    let target = SBuf { bytes: [0u8; 4096], len: 0 };
    sb_join2(&target, &out_dir, STR_PTR("index.js"), STR_LEN("index.js"));
    if fs_exists(&target) {
        let size: u64 = 0;
        if fs_size(&target, &size) && size > 0 { return; };
    };
    fs_mkdir_recursive(&out_dir);
    let sidx = SBuf { bytes: [0u8; 4096], len: 0 };
    sb_join2(&sidx, &source, STR_PTR("index.js"), STR_LEN("index.js"));
    fs_copy_file(&sidx, &target);
    let spkg = SBuf { bytes: [0u8; 4096], len: 0 };
    sb_join2(&spkg, &source, STR_PTR("package.json"), STR_LEN("package.json"));
    if fs_exists(&spkg) {
        let tpkg = SBuf { bytes: [0u8; 4096], len: 0 };
        sb_join2(&tpkg, &out_dir, STR_PTR("package.json"), STR_LEN("package.json"));
        fs_copy_file(&spkg, &tpkg);
    };
}

// seedCodexAppServerBesideCachedServer(version) — win32 only,
// gated by the caller. cwd passed in for process.cwd().
// DEFECT: candidates include a hardcoded HOME/.cxu/server/v0.2.66
// path from the TS (kept verbatim).
fn seedCodexAppServerBesideCachedServer(dist_dir: &SBuf, home: &SBuf, cwd: &SBuf, version: &SBuf) -> void {
    let found = SBuf { bytes: [0u8; 4096], len: 0 };
    let has_found = false;
    if !has_found { has_found = probeSeedCandidate(cwd, STR_PTR("codex-app-server.exe"), STR_LEN("codex-app-server.exe"), &found); };
    if !has_found { has_found = probeSeedCandidate(cwd, STR_PTR("codex_app_server.exe"), STR_LEN("codex_app_server.exe"), &found); };
    let dr = SBuf { bytes: [0u8; 4096], len: 0 };
    sb_join2(&dr, cwd, STR_PTR("desktop-resources"), STR_LEN("desktop-resources"));
    if !has_found { has_found = probeSeedCandidate(&dr, STR_PTR("codex-app-server.exe"), STR_LEN("codex-app-server.exe"), &found); };
    if !has_found { has_found = probeSeedCandidate(&dr, STR_PTR("codex_app_server.exe"), STR_LEN("codex_app_server.exe"), &found); };
    if !has_found {
        // join(distDir, "..", "..", "..", "desktop-resources", "codex-app-server.exe")
        let up = SBuf { bytes: [0u8; 4096], len: 0 };
        sb_join3(&up, dist_dir, STR_PTR(".."), STR_LEN(".."), STR_PTR(".."), STR_LEN(".."));
        let up2 = SBuf { bytes: [0u8; 4096], len: 0 };
        sb_join2(&up2, &up, STR_PTR(".."), STR_LEN(".."));
        // (three ".." segments total from distDir)
        let dr2 = SBuf { bytes: [0u8; 4096], len: 0 };
        sb_join2(&dr2, &up2, STR_PTR("desktop-resources"), STR_LEN("desktop-resources"));
        has_found = probeSeedCandidate(&dr2, STR_PTR("codex-app-server.exe"), STR_LEN("codex-app-server.exe"), &found);
    };
    if !has_found {
        let legacy = SBuf { bytes: [0u8; 4096], len: 0 };
        sb_join2(&legacy, home, STR_PTR(".cxu"), STR_LEN(".cxu"));
        let l2 = SBuf { bytes: [0u8; 4096], len: 0 };
        sb_join2(&l2, &legacy, STR_PTR("server"), STR_LEN("server"));
        let l3 = SBuf { bytes: [0u8; 4096], len: 0 };
        sb_join2(&l3, &l2, STR_PTR("v0.2.66"), STR_LEN("v0.2.66"));
        has_found = probeSeedCandidate(&l3, STR_PTR("codex-app-server.exe"), STR_LEN("codex-app-server.exe"), &found);
    };
    if !has_found { return; };
    let out_dir = SBuf { bytes: [0u8; 4096], len: 0 };
    getServerCacheDir(home, version, &out_dir);
    let target = SBuf { bytes: [0u8; 4096], len: 0 };
    sb_join2(&target, &out_dir, STR_PTR("codex-app-server.exe"), STR_LEN("codex-app-server.exe"));
    if fs_exists(&target) {
        let size: u64 = 0;
        if fs_size(&target, &size) && size > 0 { return; };
    };
    fs_mkdir_recursive(&out_dir);
    fs_copy_file(&found, &target);
}

fn probeSeedCandidate(dir: &SBuf, name_ptr: ptr, name_len: u64, out: &SBuf) -> bool {
    let cand = SBuf { bytes: [0u8; 4096], len: 0 };
    sb_join2(&cand, dir, name_ptr, name_len);
    if !fs_exists(&cand) { return false; };
    let size: u64 = 0;
    if !fs_size(&cand, &size) || size == 0 { return false; };
    out.len = 0;
    sb_append_buf(out, &cand);
    return true;
}

// export function isValidServerBinary(exePath): boolean
// >= 70 MiB; on win32 also MZ magic + PE\0\0 signature at the
// header's uint32le offset 0x3c.
// DEFECT: openSync/readSync positional reads become a head-read of
// the first 8192 bytes (PE offsets beyond that read as invalid).
fn isValidServerBinary(exe_path: &SBuf, platform: u64) -> bool {
    if !fs_exists(exe_path) { return false; };
    let size: u64 = 0;
    if !fs_size(exe_path, &size) { return false; };
    if size < 73400320 { return false; }; // 70 * 1024 * 1024
    if platform == 0 {
        let head = [0u8; 8192];
        let head_len: u64 = 0;
        if !fsReadHead(exe_path, &head, 8192, &head_len) { return false; };
        if head_len < 64 { return false; };
        if head[0] != 77 || head[1] != 90 { return false; }; // "MZ"
        let pe_offset = (head[60] as u64) + (head[61] as u64) * 256 + (head[62] as u64) * 65536 + (head[63] as u64) * 16777216;
        if pe_offset < 64 || pe_offset + 24 > size { return false; };
        if pe_offset + 4 > head_len { return false; };
        if head[pe_offset] != 80 || head[pe_offset + 1] != 69 || head[pe_offset + 2] != 0 || head[pe_offset + 3] != 0 { return false; }; // "PE\0\0"
    };
    return true;
}

// DEFECT: partial head read — std file read from offset 0 only.
fn fsReadHead(p: &SBuf, out: &[u8; 8192], cap: u64, out_len: &u64) -> bool {
    let fh: u64 = 0;
    if sa_std_fs_open_read(&p.bytes, p.len, &fh) != 0 { return false; };
    let read_n: u64 = 0;
    let rst = sa_std_fs_file_read(fh, out, cap, &read_n);
    sa_fs_file_close(fh);
    if rst != 0 { return false; };
    *out_len = read_n;
    return true;
}

// export function getCachedServerBinary(version) -> string | null
fn getCachedServerBinary(home: &SBuf, version: &SBuf, platform: u64, out: &SBuf) -> bool {
    let cache = SBuf { bytes: [0u8; 4096], len: 0 };
    getServerCacheDir(home, version, &cache);
    let exe = SBuf { bytes: [0u8; 4096], len: 0 };
    if platform == 0 {
        sb_join2(&exe, &cache, STR_PTR("codex-standalone.exe"), STR_LEN("codex-standalone.exe"));
    } else {
        sb_join2(&exe, &cache, STR_PTR("codex-standalone"), STR_LEN("codex-standalone"));
    };
    if !fs_exists(&exe) { return false; };
    if isValidServerBinary(&exe, platform) {
        out.len = 0;
        sb_append_buf(out, &exe);
        return true;
    };
    // console.warn(`cxu: detected corrupted or incomplete server binary (${exe}); removing...`)
    sa_print_bytes(STR_PTR("cxu: detected corrupted or incomplete server binary ("), STR_LEN("cxu: detected corrupted or incomplete server binary ("));
    let ep: ptr = PTR_NULL();
    PTR_BYTE_ADD(ep, &exe.bytes, 0);
    sa_print_bytes(ep, exe.len);
    sa_print_bytes(STR_PTR("); removing...\n"), STR_LEN("); removing...\n"));
    fs_rm_recursive_force(&exe);
    return false;
}

// export type EnsureServerResult — canonical name here is
// EnsureServerBinaryResult (serve.sla / postinstall.sla consume it):
//   { ok: true; exePath; built; isNodeScript?; scriptPath?; bundlePath? }
// | { ok: false; hint }
struct EnsureServerBinaryResult {
    ok: bool,
    built: bool,
    exe_path: SBuf,
    is_node_script: bool,
    has_script_path: bool,
    script_path: SBuf,
    has_bundle_path: bool,
    bundle_path: SBuf,
    hint_bytes: [u8; 4096],
    hint_len: u64,
}

fn ensureFail(out: &EnsureServerBinaryResult, hint_ptr: ptr, hint_len: u64) -> void {
    out.ok = false;
    out.hint_len = 0;
    for i in 0..hint_len {
        if out.hint_len < 4096 {
            let c: u8 = PTR_BYTE_AT(hint_ptr, i);
            out.hint_bytes[out.hint_len] = c;
            out.hint_len = out.hint_len + 1;
        };
    }
}

fn ensureNodeFallback(out: &EnsureServerBinaryResult, exec_path: &SBuf, bundle: &SBuf) -> void {
    out.ok = true;
    out.built = false;
    out.exe_path.len = 0;
    sb_append_buf(&out.exe_path, exec_path);
    out.is_node_script = true;
    out.has_script_path = true;
    out.script_path.len = 0;
    sb_append_buf(&out.script_path, bundle);
    out.has_bundle_path = true;
    out.bundle_path.len = 0;
    sb_append_buf(&out.bundle_path, bundle);
}

// DEFECT: spawnSync("bun", args, { stdio: "inherit", timeout:
// 300000 }) — the inherit-stdio build spawn is stubbed (returns the
// child exit status); process.pid / Date.now() arrive as params.
fn spawnBunBuild(args_json_ptr: ptr, args_json_len: u64, out_status: &i32) -> i32 {
    *out_status = -1;
    return -1;
}

fn nowMsBuild() -> u64 { return 0; } // DEFECT: Date.now() stub.

// export function ensureServerBinary(): EnsureServerResult
// Returns an i32 status (0 = completed; the TS never throws out of
// its internal try/catches except via the seed guards — postinstall
// treats a nonzero return as its catch path).
// DEFECT: ambient inputs (pkgDir for the version read, distDir for
// bundle resolution, HOME, platform, cwd, execPath, node version,
// pid) are explicit parameters.
fn ensureServerBinary(pkg_dir: &SBuf, dist_dir: &SBuf, home: &SBuf, platform: u64, cwd: &SBuf, exec_path: &SBuf, node_version: &SBuf, pid: u64, arch_ptr: ptr, arch_len: u64, out: &EnsureServerBinaryResult) -> i32 {
    let version = SBuf { bytes: [0u8; 4096], len: 0 };
    getCxuVersion(pkg_dir, &version);
    if platform != 0 {
        seedSaVmMcpBesideCachedServer(dist_dir, home, &version);
    };
    seedPiRelayBesideCachedServer(dist_dir, home, &version);
    seedNodePtyBesideCachedServer(home, &version, platform, arch_ptr, arch_len, dist_dir);
    if platform == 0 {
        seedCodexAppServerBesideCachedServer(dist_dir, home, cwd, &version);
    };
    let bundle = SBuf { bytes: [0u8; 4096], len: 0 };
    if !resolveServerBundle(dist_dir, &bundle) {
        ensureFail(out, STR_PTR("Server bundle missing from this cxu install (server-bundle/index.js). Reinstall with: npm install -g @codex-ultra/cxu"), STR_LEN("Server bundle missing from this cxu install (server-bundle/index.js). Reinstall with: npm install -g @codex-ultra/cxu"));
        return 0;
    };
    let cached = SBuf { bytes: [0u8; 4096], len: 0 };
    let has_cached = getCachedServerBinary(home, &version, platform, &cached);
    // bundleStat / isStaleBundle via mtime comparison.
    let bundle_mtime: u64 = 0;
    let has_bundle_stat = fs_mtime_ms(&bundle, &bundle_mtime);
    let is_stale = false;
    if has_cached && has_bundle_stat {
        let cached_mtime: u64 = 0;
        if fs_mtime_ms(&cached, &cached_mtime) {
            is_stale = bundle_mtime > cached_mtime;
        };
    };
    let needs_rebuild = false;
    if has_cached {
        needs_rebuild = needsServerRecompileForPtyFix(home, &version) || is_stale;
    };
    if has_cached && needs_rebuild {
        if is_stale {
            sa_print_bytes(STR_PTR("cxu: server bundle is newer than cached binary; rebuilding server...\n"), STR_LEN("cxu: server bundle is newer than cached binary; rebuilding server...\n"));
        } else {
            sa_print_bytes(STR_PTR("cxu: rebuilding the server for the Windows terminal (node-pty) fix (one-time)...\n"), STR_LEN("cxu: rebuilding the server for the Windows terminal (node-pty) fix (one-time)...\n"));
        };
        fs_rm_recursive_force(&cached);
        let gone = !fs_exists(&cached);
        if !gone {
            // Old exe still running (Windows locks it): keep serving it.
            sa_print_bytes(STR_PTR("cxu: server binary is in use; will rebuild on next start after process exits.\n"), STR_LEN("cxu: server binary is in use; will rebuild on next start after process exits.\n"));
            out.ok = true;
            out.built = false;
            out.exe_path.len = 0;
            sb_append_buf(&out.exe_path, &cached);
            out.is_node_script = false;
            out.has_script_path = false;
            out.has_bundle_path = true;
            out.bundle_path.len = 0;
            sb_append_buf(&out.bundle_path, &bundle);
            return 0;
        };
    } else if has_cached {
        out.ok = true;
        out.built = false;
        out.exe_path.len = 0;
        sb_append_buf(&out.exe_path, &cached);
        out.is_node_script = false;
        out.has_script_path = false;
        out.has_bundle_path = true;
        out.bundle_path.len = 0;
        sb_append_buf(&out.bundle_path, &bundle);
        return 0;
    };
    let bun = BunCheck { ok: false, version: SBuf { bytes: [0u8; 4096], len: 0 }, hint: SBuf { bytes: [0u8; 4096], len: 0 } };
    checkBunForBuild(platform, &bun);
    if !bun.ok {
        // console.log(`cxu: Bun not detected (${bun.hint.split(". ")[0]}); running server directly with Node.js ${process.version}...`)
        // DEFECT: the split(". ")[0] first-sentence extraction is
        // approximated by printing the whole hint line.
        sa_print_bytes(STR_PTR("cxu: Bun not detected; running server directly with Node.js "), STR_LEN("cxu: Bun not detected; running server directly with Node.js "));
        let np: ptr = PTR_NULL();
        PTR_BYTE_ADD(np, &node_version.bytes, 0);
        sa_print_bytes(np, node_version.len);
        sa_print_bytes(STR_PTR("...\n"), STR_LEN("...\n"));
        ensureNodeFallback(out, exec_path, &bundle);
        return 0;
    };
    let out_dir = SBuf { bytes: [0u8; 4096], len: 0 };
    getServerCacheDir(home, &version, &out_dir);
    fs_mkdir_recursive(&out_dir);
    let exe_name_ptr: ptr = STR_PTR("codex-standalone");
    let exe_name_len: u64 = STR_LEN("codex-standalone");
    if platform == 0 {
        exe_name_ptr = STR_PTR("codex-standalone.exe");
        exe_name_len = STR_LEN("codex-standalone.exe");
    };
    let exe_path = SBuf { bytes: [0u8; 4096], len: 0 };
    sb_join2(&exe_path, &out_dir, exe_name_ptr, exe_name_len);
    // tmpExePath = join(outDir, `tmp-${pid}-${Date.now()}-${exeName}`)
    let tmp_name = SBuf { bytes: [0u8; 4096], len: 0 };
    sb_append(&tmp_name, STR_PTR("tmp-"), STR_LEN("tmp-"));
    sb_append_u64(&tmp_name, pid);
    sb_append(&tmp_name, STR_PTR("-"), STR_LEN("-"));
    sb_append_u64(&tmp_name, nowMsBuild());
    sb_append(&tmp_name, STR_PTR("-"), STR_LEN("-"));
    sb_append(&tmp_name, exe_name_ptr, exe_name_len);
    let tmp_exe = SBuf { bytes: [0u8; 4096], len: 0 };
    let tp: ptr = PTR_NULL();
    PTR_BYTE_ADD(tp, &tmp_name.bytes, 0);
    sb_join2(&tmp_exe, &out_dir, tp, tmp_name.len);
    // args: build --compile <bundle> --outfile <tmp> --minify
    //   --define STANDALONE_BUILD_VERSION="<version>"
    //   --external <each of STANDALONE_EXTERNALS>
    //   (+ win32 --windows-* flags with toWindowsVersion(version))
    // DEFECT: the argv array rides as a JSON text span for the spawn
    // stub; the --define and windows flags follow the TS order.
    let args_json = SBuf { bytes: [0u8; 4096], len: 0 };
    sb_append(&args_json, STR_PTR("[\"build\",\"--compile\",\""), STR_LEN("[\"build\",\"--compile\",\""));
    sb_append_buf(&args_json, &bundle);
    sb_append(&args_json, STR_PTR("\",\"--outfile\",\""), STR_LEN("\",\"--outfile\",\""));
    sb_append_buf(&args_json, &tmp_exe);
    sb_append(&args_json, STR_PTR("\",\"--minify\",\"--define\",\"STANDALONE_BUILD_VERSION=\\\""), STR_LEN("\",\"--minify\",\"--define\",\"STANDALONE_BUILD_VERSION=\\\""));
    sb_append_buf(&args_json, &version);
    sb_append(&args_json, STR_PTR("\\\"\",\"--external\",\"better-sqlite3\",\"--external\",\"@napi-rs/keyring\",\"--external\",\"fetch-impersonate\",\"--external\",\"node-pty\"]"), STR_LEN("\\\"\",\"--external\",\"better-sqlite3\",\"--external\",\"@napi-rs/keyring\",\"--external\",\"fetch-impersonate\",\"--external\",\"node-pty\"]"));
    // console.log(`cxu: compiling the server for this machine with Bun ${bun.version} (one-time per version)...`)
    sa_print_bytes(STR_PTR("cxu: compiling the server for this machine with Bun "), STR_LEN("cxu: compiling the server for this machine with Bun "));
    let bp: ptr = PTR_NULL();
    PTR_BYTE_ADD(bp, &bun.version.bytes, 0);
    sa_print_bytes(bp, bun.version.len);
    sa_print_bytes(STR_PTR(" (one-time per version)...\n"), STR_LEN(" (one-time per version)...\n"));
    let ajp: ptr = PTR_NULL();
    PTR_BYTE_ADD(ajp, &args_json.bytes, 0);
    let status: i32 = -1;
    spawnBunBuild(ajp, args_json.len, &status);
    if status != 0 || !isValidServerBinary(&tmp_exe, platform) {
        fs_rm_recursive_force(&tmp_exe);
        // console.warn(`cxu: Bun compilation failed (exit ${status ?? "signal"}); falling back to Node.js ${process.version}...`)
        sa_print_bytes(STR_PTR("cxu: Bun compilation failed; falling back to Node.js "), STR_LEN("cxu: Bun compilation failed; falling back to Node.js "));
        let np2: ptr = PTR_NULL();
        PTR_BYTE_ADD(np2, &node_version.bytes, 0);
        sa_print_bytes(np2, node_version.len);
        sa_print_bytes(STR_PTR("...\n"), STR_LEN("...\n"));
        ensureNodeFallback(out, exec_path, &bundle);
        return 0;
    };
    if fs_rename(&tmp_exe, &exe_path) != 0 {
        fs_copy_file(&tmp_exe, &exe_path);
        fs_rm_recursive_force(&tmp_exe);
    };
    if platform != 0 {
        fs_chmod(&exe_path, 493); // 0o755
    };
    // .build-info.json write (JSON.stringify {..., externals: [...]}, null, 2)
    // DEFECT: builtAt ISO timestamp from the now stub (empty).
    let info_path = SBuf { bytes: [0u8; 4096], len: 0 };
    sb_join2(&info_path, &out_dir, STR_PTR(".build-info.json"), STR_LEN(".build-info.json"));
    let info = SBuf { bytes: [0u8; 4096], len: 0 };
    sb_append(&info, STR_PTR("{\n  \"cxuVersion\": \""), STR_LEN("{\n  \"cxuVersion\": \""));
    sb_append_buf(&info, &version);
    sb_append(&info, STR_PTR("\",\n  \"bunVersion\": \""), STR_LEN("\",\n  \"bunVersion\": \""));
    sb_append_buf(&info, &bun.version);
    sb_append(&info, STR_PTR("\",\n  \"builtAt\": \"\",\n  \"externals\": [\n    \"better-sqlite3\",\n    \"@napi-rs/keyring\",\n    \"fetch-impersonate\",\n    \"node-pty\"\n  ]\n}"), STR_LEN("\",\n  \"builtAt\": \"\",\n  \"externals\": [\n    \"better-sqlite3\",\n    \"@napi-rs/keyring\",\n    \"fetch-impersonate\",\n    \"node-pty\"\n  ]\n}"));
    let ip2: ptr = PTR_NULL();
    PTR_BYTE_ADD(ip2, &info.bytes, 0);
    sa_fs_write_file(&info_path.bytes, info_path.len, ip2, info.len);
    seedNodePtyBesideCachedServer(home, &version, platform, arch_ptr, arch_len, dist_dir);
    let ready = SBuf { bytes: [0u8; 4096], len: 0 };
    if !getCachedServerBinary(home, &version, platform, &ready) {
        sa_print_bytes(STR_PTR("cxu: Compiled server binary not found; falling back to Node.js...\n"), STR_LEN("cxu: Compiled server binary not found; falling back to Node.js...\n"));
        ensureNodeFallback(out, exec_path, &bundle);
        return 0;
    };
    sa_print_bytes(STR_PTR("cxu: server ready.\n"), STR_LEN("cxu: server ready.\n"));
    out.ok = true;
    out.built = true;
    out.exe_path.len = 0;
    sb_append_buf(&out.exe_path, &ready);
    out.is_node_script = false;
    out.has_script_path = false;
    out.has_bundle_path = true;
    out.bundle_path.len = 0;
    sb_append_buf(&out.bundle_path, &bundle);
    return 0;
}

// ---- pkg-cxu fix phase (2026-10-26, FIX_PKG_CXU): caller-context adapter --
// TS ensureServerBinary() takes no arguments: every context value is
// derived inside server-build.ts from import.meta.url / process / os.
// The bulk conversion exploded those derivations into the 11-parameter
// signature above and left the two callers (serve.sla, postinstall.sla)
// with a stale zero-context call. This adapter performs the derivations
// the TS performs, from sa_std surfaces:
//   dist_dir  = pkg_dir/src  (TS distDir = dirname of server-build's own
//              module URL; in the repo layout that is packages/cxu/src,
//              and bundle resolution joins dist_dir/../server-bundle)
//   home      = $HOME (os.homedir; win32 USERPROFILE divergence noted)
//   cwd       = sa_env_current_dir (process.cwd)
//   pid       = sa_std_process_id (process.pid, tmp exe name only)
// DEFECT: platform tag is fixed to 2 (linux) and arch to "x64": sa_std
// exposes no process.platform / process.arch query (env.sai and
// process.sai carry none; the domain convention is the tag parameter,
// cf. bun-runtime.sla). On win32/darwin/arm64 hosts the platform-gated
// seeding and prebuild selection follow the linux/x64 branch.
// DEFECT: node_version is empty: process.version has no sa_std query;
// its only use is the Bun-missing log line inside ensureServerBinary.
fn sb_copy_env_handle(b: &SBuf, h: u64) -> void {
    if h == 0 { return; };
    let p: ptr = sa_env_buffer_data(h);
    let n: u64 = sa_env_buffer_len(h);
    sb_append(b, p, n);
    sa_env_buffer_free(h);
}

fn ensureServerBinaryDefault(pkg_dir: &SBuf, exec_path: &SBuf, out: &EnsureServerBinaryResult) -> i32 {
    let dist_dir = SBuf { bytes: [0u8; 4096], len: 0 };
    sb_join2(&dist_dir, pkg_dir, STR_PTR("src"), STR_LEN("src"));
    let home = SBuf { bytes: [0u8; 4096], len: 0 };
    sb_copy_env_handle(&home, sa_env_get(STR_PTR("HOME"), STR_LEN("HOME")));
    let cwd = SBuf { bytes: [0u8; 4096], len: 0 };
    sb_copy_env_handle(&cwd, sa_env_current_dir());
    let node_version = SBuf { bytes: [0u8; 4096], len: 0 };
    let pid: u64 = sa_std_process_id() as u64;
    return ensureServerBinary(pkg_dir, &dist_dir, &home, 2, &cwd, exec_path, &node_version, pid, STR_PTR("x64"), STR_LEN("x64"), out);
}
