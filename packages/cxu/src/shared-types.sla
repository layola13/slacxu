// Converted 1:1 from packages/cxu/src/shared-types.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "sa_std/ptr.sa"

// Pure type + constant module. TS string unions -> u64 tags;
// interfaces -> structs; optional fields (x?: T) collapse to the
// field plus a has_* flag where the distinction is load-bearing,
// otherwise to the zero value (DEFECT: optionality — most consumers
// test === true / truthiness, where undefined and false agree).
// DEFECT: readonly const string arrays -> pipe-joined text constants
// with linear membership scans (helpers at the bottom).

// export type SaVmDeletePolicy = "deny" | "rename" | "move";
const DELETE_DENY: u64 = 0;
const DELETE_RENAME: u64 = 1;
const DELETE_MOVE: u64 = 2;

// export type SaVmFsAccess = "read" | "write" | "deny";
const FS_ACCESS_READ: u64 = 0;
const FS_ACCESS_WRITE: u64 = 1;
const FS_ACCESS_DENY: u64 = 2;

struct TxtBuf {
    bytes: [u8; 1024],
    len: u64,
}

fn tb_set(b: &TxtBuf, src_ptr: ptr, src_len: u64) -> void {
    b.len = 0;
    for i in 0..src_len {
        if b.len < 1024 {
            let c: u8 = 0;
            PTR_BYTE_AT(c, src_ptr, i);
            b.bytes[b.len] = c;
            b.len = b.len + 1;
        };
    }
}

// export interface SaVmFsEntry { path: string; access: SaVmFsAccess }
struct SaVmFsEntry {
    path: TxtBuf,
    access: u64,
}

// export interface SaVmProcessExecRule { path: string; args?: string[] }
struct SaVmProcessExecRule {
    path: TxtBuf,
    has_args: bool,
    args_json: [u8; 1024],
    args_json_len: u64,
}

