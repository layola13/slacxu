// export const ENHANCE_TOOLS_KEYS (36 keys, TS order) —
// export type EnhanceToolKey = typeof ENHANCE_TOOLS_KEYS[number];
const ENHANCE_TOOLS_KEYS_TEXT = "readFiles|fastSearch|editFiles|applyPatch|fileOutline|codeGraph|findDefinition|renameSymbol|extractToFile|moveWithImports|addImport|getDiagnostics|organizeImports|analyzeScope|findReferences|clearToolHistory|jevChoose|jevChecklist|jevEvaluate|jevThinking|jevRedteam|jevRank|jevScope|jevDispatch|jevConsistency|jevDone|jevDiagnose|jevEdgeCases|jevBlastRadius|jevIntent|jevNext|jevCompress|jevProgress|jevMemory";
const ENHANCE_TOOLS_KEYS_COUNT: u64 = 36;

// Membership in a pipe-joined table (exact segment equality).
fn pipe_table_contains(table_ptr: ptr, table_len: u64, key_ptr: ptr, key_len: u64) -> bool {
    let seg_start: u64 = 0;
    let i: u64 = 0;
    while i <= table_len {
        let at_end = i == table_len;
        let at_sep = false;
        if !at_end {
            let c: u8 = 0;
            PTR_BYTE_AT(c, table_ptr, i);
            if c == 124 { at_sep = true; };
        };
        if at_end || at_sep {
            let seg_len = i - seg_start;
            if seg_len == key_len {
                let eq = true;
                for j in 0..key_len {
                    let a: u8 = 0;
                    let b: u8 = 0;
                    PTR_BYTE_AT(a, table_ptr, seg_start + j);
                    PTR_BYTE_AT(b, key_ptr, j);
                    if a != b { eq = false; break; };
                }
                if eq { return true; };
            };
            seg_start = i + 1;
        };
        i = i + 1;
    }
    return false;
}

// hasEnhanceToolsEnabled(tools?: SaVmToolsConfig | null) -> boolean
// TS: ENHANCE_TOOLS_KEYS.some((key) => tools[key] === true)
// The key->field mapping is the if-chain in toolsKeyEnabled below.
fn hasEnhanceToolsEnabled(has_tools: bool, tools: &SaVmToolsConfig) -> bool {
    if !has_tools { return false; };
    for k in 0..ENHANCE_TOOLS_KEYS_COUNT {
        if toolsKeyEnabled(tools, k) { return true; };
    }
    return false;
}

// countActiveEnhanceTools(tools?: SaVmToolsConfig | null) -> number
fn countActiveEnhanceTools(has_tools: bool, tools: &SaVmToolsConfig) -> u64 {
    if !has_tools { return 0; };
    let count: u64 = 0;
    for k in 0..ENHANCE_TOOLS_KEYS_COUNT {
        if toolsKeyEnabled(tools, k) { count = count + 1; };
    }
    return count;
}

// ENHANCE_TOOLS_KEYS[k] -> the corresponding SaVmToolsConfig field.
// (Order follows the TS ENHANCE_TOOLS_KEYS array, which differs from
// the interface declaration order.)
fn toolsKeyEnabled(t: &SaVmToolsConfig, k: u64) -> bool {
    if k == 0 { return t.read_files; };
    if k == 1 { return t.fast_search; };
    if k == 2 { return t.edit_files; };
    if k == 3 { return t.apply_patch; };
    if k == 4 { return t.file_outline; };
    if k == 5 { return t.code_graph; };
    if k == 6 { return t.find_definition; };
    if k == 7 { return t.rename_symbol; };
    if k == 8 { return t.extract_to_file; };
    if k == 9 { return t.move_with_imports; };
    if k == 10 { return t.add_import; };
    if k == 11 { return t.get_diagnostics; };
    if k == 12 { return t.organize_imports; };
    if k == 13 { return t.analyze_scope; };
    if k == 14 { return t.find_references; };
    if k == 15 { return t.clear_tool_history; };
    if k == 16 { return t.jev_choose; };
    if k == 17 { return t.jev_checklist; };
    if k == 18 { return t.jev_evaluate; };
    if k == 19 { return t.jev_thinking; };
    if k == 20 { return t.jev_redteam; };
    if k == 21 { return t.jev_rank; };
    if k == 22 { return t.jev_scope; };
    if k == 23 { return t.jev_dispatch; };
    if k == 24 { return t.jev_consistency; };
    if k == 25 { return t.jev_done; };
    if k == 26 { return t.jev_diagnose; };
    if k == 27 { return t.jev_edge_cases; };
    if k == 28 { return t.jev_blast_radius; };
    if k == 29 { return t.jev_intent; };
    if k == 30 { return t.jev_next; };
    if k == 31 { return t.jev_compress; };
    if k == 32 { return t.jev_progress; };
    if k == 33 { return t.jev_memory; };
    return false;
}

// createDefaultSaVmPolicyConfig() -> SaVmPolicyConfig
// The TS object literal, field for field.
fn createDefaultSaVmPolicyConfig(out: &SaVmPolicyConfig) -> void {
    out.has_engine = true;
    out.engine = ENGINE_NATIVE;
    // fs
    out.has_fs = true;
    out.fs.has_entries = true;
    out.fs.entries_count = 1;
    tb_set(&out.fs.entries[0].path, STR_PTR("${PROJECT}/**"), STR_LEN("${PROJECT}/**"));
    out.fs.entries[0].access = FS_ACCESS_WRITE;
    out.fs.has_read = true;
    json_set_text(&out.fs.read_json, &out.fs.read_json_len, STR_PTR("[\"${PROJECT}/**\"]"), STR_LEN("[\"${PROJECT}/**\"]"));
    out.fs.has_write = true;
    json_set_text(&out.fs.write_json, &out.fs.write_json_len, STR_PTR("[\"${PROJECT}/**\"]"), STR_LEN("[\"${PROJECT}/**\"]"));
    out.fs.has_transfer = true;
    json_set_text(&out.fs.transfer_json, &out.fs.transfer_json_len, STR_PTR("[\"${PROJECT}/**\"]"), STR_LEN("[\"${PROJECT}/**\"]"));
    out.fs.has_delete = true;
    out.fs.delete_policy = DELETE_RENAME;
    out.fs.has_backup_dir = true;
    out.fs.backup_dir_is_null = false;
    tb_set(&out.fs.backup_dir, STR_PTR("${PROJECT}/.codex-ultra/vm-trash/**"), STR_LEN("${PROJECT}/.codex-ultra/vm-trash/**"));
    out.fs.has_sala_root = false;
    // http: { allow: [] }
    out.has_http = true;
    out.http.has_allow = true;
    out.http.allow_count = 0;
    // env: { allow: ["CWD", "PROJECT"] }
    out.has_env = true;
    out.env.has_allow = true;
    json_set_text(&out.env.allow_json, &out.env.allow_json_len, STR_PTR("[\"CWD\",\"PROJECT\"]"), STR_LEN("[\"CWD\",\"PROJECT\"]"));
    // process
    out.has_process = true;
    out.process.has_spawn = true;
    out.process.spawn = false;
    out.process.has_exec = true;
    out.process.exec_count = 3;
    tb_set(&out.process.exec[0].path, STR_PTR("git"), STR_LEN("git"));
    out.process.exec[0].has_args = true;
    json_set_text(&out.process.exec[0].args_json, &out.process.exec[0].args_json_len, STR_PTR("[\"status\",\"*\"]"), STR_LEN("[\"status\",\"*\"]"));
    tb_set(&out.process.exec[1].path, STR_PTR("git"), STR_LEN("git"));
    out.process.exec[1].has_args = true;
    json_set_text(&out.process.exec[1].args_json, &out.process.exec[1].args_json_len, STR_PTR("[\"pull\"]"), STR_LEN("[\"pull\"]"));
    tb_set(&out.process.exec[2].path, STR_PTR("git"), STR_LEN("git"));
    out.process.exec[2].has_args = true;
    json_set_text(&out.process.exec[2].args_json, &out.process.exec[2].args_json_len, STR_PTR("[\"push\"]"), STR_LEN("[\"push\"]"));
    out.process.has_bun = true;
    out.process.bun_is_bool = true;
    out.process.bun_bool = true;
    // bunProfiles: [...ALL_SA_VM_BUN_PROFILES]
    out.process.has_bun_profiles = true;
    json_set_text(&out.process.bun_profiles_json, &out.process.bun_profiles_json_len, STR_PTR("[\"shared-typecheck\",\"protocol-typecheck\",\"server-typecheck\",\"web-typecheck\",\"free-key-typecheck\",\"root-typecheck\",\"shared-build\",\"web-build\",\"server-test-file\",\"web-test-file\",\"shared-test-file\"]"), STR_LEN("[\"shared-typecheck\",\"protocol-typecheck\",\"server-typecheck\",\"web-typecheck\",\"free-key-typecheck\",\"root-typecheck\",\"shared-build\",\"web-build\",\"server-test-file\",\"web-test-file\",\"shared-test-file\"]"));
    // execution: { javascript: false, python: false }
    out.has_execution = true;
    out.execution.has_javascript = true;
    out.execution.javascript = false;
    out.execution.has_python = true;
    out.execution.python = false;
    // tools (only the TS-listed keys are true; the rest stay false)
    out.has_tools = true;
    defaultTools(&out.tools);
    // contextSavings (listed keys true)
    out.has_context_savings = true;
    defaultContextSavings(&out.context_savings);
    // accountability
    out.has_accountability = true;
    out.accountability.has_enabled = true;
    out.accountability.enabled = false;
    out.accountability.has_auto_penalize = true;
    out.accountability.auto_penalize = true;
    out.accountability.has_reputation_threshold_red = true;
    out.accountability.reputation_threshold_red = 50.0;
    out.accountability.has_reputation_threshold_yellow = true;
    out.accountability.reputation_threshold_yellow = 80.0;
    out.accountability.has_ledger_path = false;
    out.accountability.has_manual_override = false;
}

fn defaultTools(t: &SaVmToolsConfig) -> void {
    t.replace_read = true;
    t.replace_write = true;
    t.replace_apply_patch = true;
    t.replace_exec = true;
    t.clear_tool_history = true;
    t.find_references = true;
    t.rename_symbol = true;
    t.file_outline = true;
    t.move_with_imports = true;
    t.find_definition = true;
    t.extract_to_file = true;
    t.add_import = true;
    t.get_diagnostics = true;
    t.organize_imports = true;
    t.analyze_scope = true;
    // All other tools fields remain false (TS omits them).
}

fn defaultContextSavings(c: &SaVmContextSavingsConfig) -> void {
    c.locate_before_read = true;
    c.grep_circuit_breaker = true;
    c.slim_runner_output = true;
    c.parallel_budget = true;
    c.parallel_deduplication = true;
    c.tiered_skill_injection = true;
    c.fold_waterfall_events = true;
    c.fold_history_read_summaries = true;
    // Numeric/remaining fields remain unset (TS omits them).
}

fn json_set_text(dst: &[u8; 2048], out_len: &u64, src_ptr: ptr, src_len: u64) -> void {
    let n = src_len;
    if n > 2048 { n = 2048; };
    for i in 0..n {
        let c: u8 = 0;
        PTR_BYTE_AT(c, src_ptr, i);
        dst[i] = c;
    }
    out_len = n;
}
