// Converted 1:1 from packages/cxu/src/postinstall.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "sa_std/io/print.sai"
@import "sa_std/env.sai"
@import "sa_std/string.sa"
@import "server-build.sla"

// TS top-level script body: try { ensureServerBinary(); if (!result.ok)
// log skip line } catch (error) { log skip line with detail }.
// Converted to main() with the same two log paths.
// DEFECT: JS try/catch + Error.message — SLA has no exceptions; the
// fallible call returns a status and the "detail" text is approximated
// by the status-derived message in server-build.sla.
fn main() -> i32 {
    let result = EnsureServerBinaryResult { ok: false, built: false, exe_path: SBuf { bytes: [0u8; 4096], len: 0 }, is_node_script: false, has_script_path: false, script_path: SBuf { bytes: [0u8; 4096], len: 0 }, has_bundle_path: false, bundle_path: SBuf { bytes: [0u8; 4096], len: 0 }, hint_bytes: [0u8; 4096], hint_len: 0 };
    // pkg_dir := cwd: npm runs postinstall with cwd = the package root,
    // which is exactly the directory the TS derives from import.meta.url
    // (registered in FIX_PKG_CXU). exec_path := sa_env_current_exe
    // (process.execPath).
    let pkg_dir = SBuf { bytes: [0u8; 4096], len: 0 };
    sb_copy_env_handle(&pkg_dir, sa_env_current_dir());
    let exec_path = SBuf { bytes: [0u8; 4096], len: 0 };
    sb_copy_env_handle(&exec_path, sa_env_current_exe());
    let st = ensureServerBinaryDefault(&pkg_dir, &exec_path, &result);
    if st != 0 {
        println("cxu postinstall: skipped local server build. It will compile on first `cxu serve`.");
        return 0;
    };
    if !result.ok {
        // TS: console.log(`cxu postinstall: skipped local server build. ${result.hint}`)
        sa_print_bytes(STR_PTR("cxu postinstall: skipped local server build. "), STR_LEN("cxu postinstall: skipped local server build. "));
        sa_print_bytes(&result.hint_bytes, result.hint_len);
        println("");
    };
    return 0;
}
