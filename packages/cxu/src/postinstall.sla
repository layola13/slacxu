// Converted 1:1 from packages/cxu/src/postinstall.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "sa_std/io/print.sai"
@import "server-build.sla"

// TS top-level script body: try { ensureServerBinary(); if (!result.ok)
// log skip line } catch (error) { log skip line with detail }.
// Converted to main() with the same two log paths.
// DEFECT: JS try/catch + Error.message — SLA has no exceptions; the
// fallible call returns a status and the "detail" text is approximated
// by the status-derived message in server-build.sla.
fn main() -> i32 {
    let result = EnsureServerBinaryResult { ok: false, hint_bytes: [0u8; 512], hint_len: 0 };
    let st = ensureServerBinary(&result);
    if st != 0 {
        println("cxu postinstall: skipped local server build. It will compile on first `cxu serve`.");
        return 0;
    };
    if !result.ok {
        // TS: console.log(`cxu postinstall: skipped local server build. ${result.hint}`)
        print("cxu postinstall: skipped local server build. ");
        sa_print_bytes(&result.hint_bytes, result.hint_len);
        println("");
    };
    return 0;
}
