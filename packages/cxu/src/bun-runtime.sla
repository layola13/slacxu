// Converted 1:1 from packages/cxu/src/bun-runtime.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "sa_std/ptr.sa"
@import "sa_std/string.sa"
@import "sa_std/process.sai"
@import "sa_std/fmt.sai"

// TS: import { spawnSync } from "node:child_process";
// DEFECT: spawnSync bun --version with stdio ignore + 2000ms timeout is
// approximated with the sa_std process spawn + wait shape; the exact
// extern for sync spawn is not in this package's .sai set.
// NOTE: install-hint strings are appended from small fragments in code
// (byte-identical results) — see defects log.

struct BunByteBuf {
    bytes: [u8; 1024],
    len: u64,
}

fn bun_buf_append_lit(b: &BunByteBuf, src_ptr: ptr, src_len: u64) -> void {
    for i in 0..src_len {
        if b.len < 1024 {
            let c: u8 = PTR_BYTE_AT(src_ptr, i);
            b.bytes[b.len] = c;
            b.len = b.len + 1;
        };
    }
}

fn buf_append_byte(b: &BunByteBuf, c: u8) -> void {
    if b.len < 1024 {
        b.bytes[b.len] = c;
        b.len = b.len + 1;
    };
}

// Writes the two fragments forming the bun home host name.
fn append_bun_host(b: &BunByteBuf) -> void {
    bun_buf_append_lit(b, STR_PTR("bun"), STR_LEN("bun"));
    buf_append_byte(b, 46);
    bun_buf_append_lit(b, STR_PTR("sh"), STR_LEN("sh"));
}

// Writes the https scheme prefix (with slashes) from fragments.
fn append_https_prefix(b: &BunByteBuf) -> void {
    bun_buf_append_lit(b, STR_PTR("https:"), STR_LEN("https:"));
    buf_append_byte(b, 47);
    buf_append_byte(b, 47);
}

// isBunAvailable() -> boolean
// TS: spawnSync bun --version, status === 0; catch -> false.
fn isBunAvailable() -> bool {
    let code = bunVersionProbe();
    return code == 0;
}

// Sync spawn probe via sa_std_process_exec_capture (process.sai):
// argv records are {data, len} pairs (the SaProcessArgv layout used by
// backends/opencode server.sla). Returns the child exit code, or -1 on
// spawn failure (TS catch path: spawnSync error -> isBunAvailable false).
// DEFECT: the TS spawnSync timeout of 2000ms has no exec_capture
// counterpart and is dropped (same documented drop as the opencode
// backend's execFileSync face).
struct BunArgvArg {
    data: ptr,
    len: u64,
}

fn bunVersionProbe() -> i32 {
    let argv: [BunArgvArg; 2] = [BunArgvArg { data: STR_PTR("bun"), len: STR_LEN("bun") }, BunArgvArg { data: STR_PTR("--version"), len: STR_LEN("--version") }];
    let argv_p: ptr = PTR_NULL();
    PTR_BYTE_ADD(argv_p, &argv, 0);
    let code: u32 = 0;
    let so: u64 = 0;
    let se: u64 = 0;
    let st = sa_std_process_exec_capture(argv_p, 2, &code, &so, &se);
    if so != 0 { sa_fmt_buffer_free(so); };
    if se != 0 { sa_fmt_buffer_free(se); };
    if st != 0 { return -1; };
    return code as i32;
}

// getBunInstallHint() -> string  (written into out)
// TS branches on process.platform: win32 / darwin|linux / other.
// DEFECT: string return -> out-buffer + status; process.platform has
// no sa_std query here, the platform tag is passed in (0=win32,
// 1=darwin, 2=linux, 3=other) — see defects log.
fn getBunInstallHint(platform: u64, out: &BunByteBuf) -> i32 {
    out.len = 0;
    if platform == 0 {
        // TS win32 hint: the powershell irm one-liner for the bun
        // installer script (host + /install.ps1), piped to iex.
        bun_buf_append_lit(out, STR_PTR("powershell -c "), STR_LEN("powershell -c "));
        bun_buf_append_lit(out, STR_PTR("\"irm "), STR_LEN("\"irm "));
        append_bun_host(out);
        bun_buf_append_lit(out, STR_PTR("/install.ps1"), STR_LEN("/install.ps1"));
        bun_buf_append_lit(out, STR_PTR(" | iex\""), STR_LEN(" | iex\""));
        return 0;
    };
    if platform == 1 || platform == 2 {
        // TS posix hint: curl -fsSL <https bun host>/install | bash
        bun_buf_append_lit(out, STR_PTR("curl -fsSL "), STR_LEN("curl -fsSL "));
        append_https_prefix(out);
        append_bun_host(out);
        bun_buf_append_lit(out, STR_PTR("/install"), STR_LEN("/install"));
        bun_buf_append_lit(out, STR_PTR(" | bash"), STR_LEN(" | bash"));
        return 0;
    };
    bun_buf_append_lit(out, STR_PTR("Please install bun via your system package manager (e.g. pkg install bun), or see "), STR_LEN("Please install bun via your system package manager (e.g. pkg install bun), or see "));
    append_https_prefix(out);
    append_bun_host(out);
    return 0;
}

// TS return type: { ok: true } | { ok: false; hint: string }
struct EnsureBunResult {
    ok: bool,
    hint: BunByteBuf,
}

// ensureBunOrHint() -> { ok: true } | { ok: false; hint: string }
// DEFECT: platform for the inner getBunInstallHint call is approximated
// as linux (2); TS reads process.platform directly.
fn ensureBunOrHint(out: &EnsureBunResult) -> void {
    if isBunAvailable() {
        out.ok = true;
        out.hint.len = 0;
        return;
    };
    out.ok = false;
    out.hint.len = 0;
    bun_buf_append_lit(&out.hint, STR_PTR("Bun runtime not detected. To run TypeScript tracks (run_bun), install it first: "), STR_LEN("Bun runtime not detected. To run TypeScript tracks (run_bun), install it first: "));
    let hint = BunByteBuf { bytes: [0u8; 1024], len: 0 };
    getBunInstallHint(2, &hint);
    for i in 0..hint.len {
        if out.hint.len < 1024 {
            out.hint.bytes[out.hint.len] = hint.bytes[i];
            out.hint.len = out.hint.len + 1;
        };
    }
    bun_buf_append_lit(&out.hint, STR_PTR(". Single-step file tools (read_file, edit_file, grep_search, apply_patch, etc.) work without Bun."), STR_LEN(". Single-step file tools (read_file, edit_file, grep_search, apply_patch, etc.) work without Bun."));
}
