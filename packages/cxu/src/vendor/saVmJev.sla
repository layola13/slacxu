// pkg-cxu vendor port (2026-10-26, FIX_PKG_CXU): content = backends/jev/src/jev/saVmJev.sla -- the verified SLA
// translation of the identical TS source; only @import paths remapped to vendor
// siblings (registered diffs in _defects/FIX_PKG_CXU.md).
// Converted 1:1 from backends/jev/src/jev/saVmJev.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
//
// TS imports:
//   import { basename } from "node:path";
//   import type { JevPolicyConfig } from "@codex-ui/shared";
//   import type { RegressionCase, JevRunInput, JevRunResult } from "@cxu/sdk-backend";
//   import { loadRegressionCases, SaVmInputError } from "@cxu/sdk-backend";
// JevPolicyConfig / RegressionCase / JevRunInput / JevRunResult are
// types from the shared / sdk-backend units; they are re-declared
// here as structs in the same shapes the units use. loadRegressionCases
// is implemented in the sdk-backend unit (declared below as an
// intent-level extern). SaVmInputError throws become return code 2
// with the message in out.stderr. basename() becomes the local
// jev_basename helper.
//
// Conversion scaffolding used throughout this file:
// - Strings are (ptr, len) pairs or ByteBuf buffers.
// - Record<string, string> becomes StringMap (fixed capacity 64).
// - Record<string, unknown> / dynamic input fields become JSON text
//   buffers inspected through sa_json_* node handles (u64).
//   sa_json_* handles are inspected through the local access layer
//   below (jev_json_* / jev_now_ms / jev_sleep_ms helpers over the
//   real sa_json_* / sa_time_* externs). jev_http_post_json is
//   bound to the real sa_std HTTP client below; the relay executor
//   stays a registered host seam (jev_relay_executor_call).
// - Module-level mutable state (sharedJevConfig, relayExecutor, the
//   throttle slot chain and overrides) becomes JevModuleState,
//   passed by reference as an extra first parameter.
// DEFECT: dynamic object — JevRunInput dynamic keys are read from
// the input's JSON text buffer; see the defect log.

@import "sa_std/io/print.sai"
@import "sa_std/ptr.sa"
@import "sa_std/string.sa"
@import "sa_std/env.sai"
@import "sa_std/fs.sai"
@import "sa_std/http_client.sai"
@import "sa_std/encoding/json.sai"
@import "sa_std/time.sai"

// ---- buffer / string scaffolding ----

struct ByteBuf {
    bytes: [u8; 262144],
    len: u64,
}

fn buf_reset(out: &ByteBuf) -> void {
    out.len = 0;
}

fn buf_ptr(b: &ByteBuf) -> ptr {
    let p: ptr = PTR_NULL();
    PTR_BYTE_ADD(p, &b.bytes, 0);
    return p;
}

fn buf_append(out: &ByteBuf, src_ptr: ptr, src_len: u64) -> void {
    let i: u64 = 0;
    while i < src_len {
        if out.len >= 262144 { return; };
        let b: u8 = 0;
        PTR_BYTE_AT(b, src_ptr, i);
        out.bytes[out.len] = b;
        out.len = out.len + 1;
        i = i + 1;
    }
}

fn buf_append_lit(out: &ByteBuf, lit_ptr: ptr, lit_len: u64) -> void {
    buf_append(out, lit_ptr, lit_len);
}

fn buf_append_buf(out: &ByteBuf, src: &ByteBuf) -> void {
    buf_append(out, buf_ptr(src), src.len);
}

fn buf_copy_into(dst: &ByteBuf, src: &ByteBuf) -> void {
    buf_reset(dst);
    buf_append_buf(dst, src);
}

fn buf_append_json_str(out: &ByteBuf, src_ptr: ptr, src_len: u64) -> void {
    buf_append_lit(out, STR_PTR("\""), STR_LEN("\""));
    let i: u64 = 0;
    while i < src_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, src_ptr, i);
        if b == 34 {
            buf_append_lit(out, STR_PTR("\\\""), STR_LEN("\\\""));
        } else {
            if b == 92 {
                buf_append_lit(out, STR_PTR("\\\\"), STR_LEN("\\\\"));
            } else {
                if b == 10 {
                    buf_append_lit(out, STR_PTR("\\n"), STR_LEN("\\n"));
                } else {
                    if out.len < 262144 {
                        out.bytes[out.len] = b;
                        out.len = out.len + 1;
                    };
                };
            };
        };
        i = i + 1;
    }
    buf_append_lit(out, STR_PTR("\""), STR_LEN("\""));
}

fn buf_append_u64(out: &ByteBuf, v: u64) -> void {
    if v >= 10 {
        buf_append_u64(out, v / 10);
    };
    if out.len < 262144 {
        out.bytes[out.len] = 48 + (v % 10) as u8;
        out.len = out.len + 1;
    };
}

fn buf_append_i64(out: &ByteBuf, v: i64) -> void {
    if v < 0 {
        buf_append_lit(out, STR_PTR("-"), STR_LEN("-"));
        buf_append_u64(out, (0 - v) as u64);
        return;
    };
    buf_append_u64(out, v as u64);
}

// DEFECT: number formatting — JS Number#toString semantics
// approximated (integer part + up to 6 fractional digits).
fn buf_append_f64(out: &ByteBuf, v: f64) -> void {
    if v < 0.0 {
        buf_append_lit(out, STR_PTR("-"), STR_LEN("-"));
        buf_append_f64(out, 0.0 - v);
        return;
    };
    let whole: u64 = v as u64;
    buf_append_u64(out, whole);
    let frac = v - (whole as f64);
    if frac > 0.0000005 {
        buf_append_lit(out, STR_PTR("."), STR_LEN("."));
        let scale: u64 = 100000;
        let digits: u64 = (frac * 1000000.0 + 0.5) as u64;
        let started = false;
        while scale > 0 {
            let d = (digits / scale) % 10;
            if d != 0 || started || scale == 1 {
                started = true;
                if out.len < 262144 {
                    out.bytes[out.len] = 48 + d as u8;
                    out.len = out.len + 1;
                };
            };
            scale = scale / 10;
        }
    };
}

fn jev_str_eq(a_ptr: ptr, a_len: u64, b_ptr: ptr, b_len: u64) -> bool {
    if a_len != b_len { return false; };
    let i: u64 = 0;
    while i < a_len {
        let a: u8 = 0;
        let b: u8 = 0;
        PTR_BYTE_AT(a, a_ptr, i);
        PTR_BYTE_AT(b, b_ptr, i);
        if a != b { return false; };
        i = i + 1;
    }
    return true;
}


// ---- local JSON/time access layer (rebind, FIX_JEV) ----
// The bulk conversion targeted a fabricated node_* extern family
// with a LOCAL kind numbering (0 null/absent, 1 string, 2 array,
// 3 object, 4 number, 5 boolean). The real sa_json_kind numbering
// is 0 null, 1 bool, 2 int, 3 float, 4 number_string, 5 string,
// 6 array, 7 object. The helpers below adapt the real externs to
// the local convention so every existing call site stays valid.
fn jev_json_kind(node: u64) -> u64 {
    let k = sa_json_kind(node);
    if k == 5 { return 1; };
    if k == 6 { return 2; };
    if k == 7 { return 3; };
    if k == 2 || k == 3 || k == 4 { return 4; };
    if k == 1 { return 5; };
    return 0;
}

fn jev_json_string(node: u64, out_ptr: &ptr, out_len: &u64) -> void {
    *out_ptr = PTR_NULL();
    *out_len = 0;
    if sa_json_kind(node) != 5 { return; };
    let p: ptr = sa_json_string_ptr(node);
    *out_ptr = p;
    *out_len = sa_json_string_len(node);
}

fn jev_json_number(node: u64, out: &f64) -> i32 {
    let v: f64 = 0.0;
    let rc = sa_json_as_f64(node, &v);
    if rc == 0 { *out = v; };
    return rc;
}

fn jev_json_bool(node: u64, out: &bool) -> i32 {
    let v: u8 = 0;
    let rc = sa_json_as_bool(node, &v);
    if rc == 0 { *out = v != 0; };
    return rc;
}

fn jev_json_text(node: u64, out_ptr: &ptr, out_len: &u64) -> void {
    *out_ptr = PTR_NULL();
    *out_len = 0;
    let buf: u64 = 0;
    if sa_json_stringify(node, &buf) != 0 { return; };
    // The stringify buffer is deliberately not freed: callers copy
    // the bytes out immediately, and freeing here would leave the
    // returned ptr dangling (registered leak, same class as the
    // FIX_SAVMTOOL json_text stringify deviation).
    let p: ptr = sa_json_buffer_data(buf);
    *out_ptr = p;
    *out_len = sa_json_buffer_len(buf);
}

fn jev_json_count(node: u64) -> u64 {
    let c: u64 = 0;
    let rc = sa_json_value_count(node, &c);
    if rc != 0 { return 0; };
    return c;
}

fn jev_json_object_value_at(node: u64, index: u64, out: &u64) -> void {
    *out = 0;
    let kp: ptr = PTR_NULL();
    let kl: u64 = 0;
    if sa_json_object_key_at(node, index, &kp, &kl) != 0 { return; };
    let v: u64 = 0;
    if sa_json_object_get(node, kp, kl, &v) == 0 { *out = v; };
}

fn jev_now_ms() -> u64 {
    let ms = sa_time_unix_ms();
    if ms < 0 { return 0; };
    return ms as u64;
}

fn jev_sleep_ms(ms: u64) -> void {
    sa_time_sleep_ms(ms);
}

// Direct upstream POST (TS fetch with Authorization + JSON body),
// bound to the real sa_std stateful HTTP client (http_client.sai
// v2 surface): real transport, real status code, real body. The
// timeoutMs argument becomes req_set_timeout_v2; a v2 timeout
// status (3) maps to out.timed_out (the TS AbortError branch).
// Returns 0 when an HTTP exchange completed (any status), 1 on
// transport failure.
fn jev_http_post_json(url_ptr: ptr, url_len: u64, auth_ptr: ptr, auth_len: u64, body_ptr: ptr, body_len: u64, timeout_ms: u64, out: &JevHttpResponse) -> i32 {
    out.ok = false;
    out.status = 0;
    out.body_len = 0;
    out.timed_out = false;
    let use_tls: u8 = 0;
    if url_len >= 6 {
        let c0: u8 = 0;
        PTR_BYTE_AT(c0, url_ptr, 0);
        let c4: u8 = 0;
        PTR_BYTE_AT(c4, url_ptr, 4);
        let c5: u8 = 0;
        PTR_BYTE_AT(c5, url_ptr, 5);
        if c0 == 104 && c4 == 115 && c5 == 58 { use_tls = 1; };
    };
    let client: ptr = PTR_NULL();
    if sa_http_client_new_v2(use_tls, PTR_NULL(), 0, &client) != 0 || client == PTR_NULL() { return 1; };
    let req: ptr = PTR_NULL();
    if sa_http_client_req_new_v2(client, 2, url_ptr, url_len, &req) != 0 || req == PTR_NULL() {
        let cf0: u32 = sa_http_client_free(client);
        return 1;
    };
    let tst: u32 = sa_http_client_req_set_timeout_v2(req, timeout_ms as u32);
    let h1: u32 = sa_http_client_req_add_header_v2(req, STR_PTR("Authorization"), STR_LEN("Authorization"), auth_ptr, auth_len);
    let h2: u32 = sa_http_client_req_add_header_v2(req, STR_PTR("Content-Type"), STR_LEN("Content-Type"), STR_PTR("application/json"), STR_LEN("application/json"));
    let bst: u32 = sa_http_client_req_set_body_v2(req, body_ptr, body_len);
    let resp: ptr = PTR_NULL();
    let sst: u32 = sa_http_client_req_send_v2(req, &resp);
    if sst != 0 || resp == PTR_NULL() {
        if sst == 3 { out.timed_out = true; };
        let rf0: u32 = sa_http_client_req_free(req);
        let cf1: u32 = sa_http_client_free(client);
        return 1;
    };
    let status = sa_http_client_resp_status(resp) as i32;
    out.status = status;
    out.ok = status >= 200 && status < 300;
    let bp: ptr = sa_http_client_resp_body_ptr(resp);
    let bl: u64 = sa_http_client_resp_body_len(resp);
    if bp != PTR_NULL() && bl > 0 {
        let n = bl;
        if n > 262144 { n = 262144; };
        let dp: ptr = PTR_NULL();
        PTR_BYTE_ADD(dp, &out.body_bytes, 0);
        PTR_COPY_BYTES(dp, bp, n);
        out.body_len = n;
    };
    let pf: u32 = sa_http_client_resp_free(resp);
    let rf1: u32 = sa_http_client_req_free(req);
    let cf2: u32 = sa_http_client_free(client);
    return 0;
}

// HOST SEAM (registered, FIX_JEV): the relay executor is a
// host-registered function value in TS (setJevRelayExecutor); SLA
// has no host-callback registry surface, so no executor can ever
// be invoked from here. This seam fails explicitly: it returns 1
// with the response left zeroed, which routes the caller through
// the TS catch path ("JEV relay executor failed", status 502) --
// the same outcome as a throwing executor. It is not a silent
// stub: the failure is observable in the result, and wiring a real
// executor requires a host registration surface that does not
// exist yet.
fn jev_relay_executor_call(executor_id: u64, payload: &JevRelayPayload, timeout_ms: u64, out: &JevHttpResponse) -> i32 {
    out.ok = false;
    out.status = 0;
    out.body_len = 0;
    out.timed_out = false;
    return 1;
}

fn str_contains_ci(hay_ptr: ptr, hay_len: u64, nd_ptr: ptr, nd_len: u64) -> bool {
    if nd_len == 0 { return true; };
    if hay_len < nd_len { return false; };
    let last = hay_len - nd_len;
    let i: u64 = 0;
    while i <= last {
        let ok = true;
        let j: u64 = 0;
        while j < nd_len {
            let a: u8 = 0;
            let b: u8 = 0;
            PTR_BYTE_AT(a, hay_ptr, i + j);
            PTR_BYTE_AT(b, nd_ptr, j);
            if a >= 65 && a <= 90 { a = a + 32; };
            if b >= 65 && b <= 90 { b = b + 32; };
            if a != b { ok = false; break; };
            j = j + 1;
        }
        if ok { return true; };
        i = i + 1;
    }
    return false;
}

// Index of the first case-insensitive occurrence of needle, or -1.
fn str_index_of_ci(hay_ptr: ptr, hay_len: u64, nd_ptr: ptr, nd_len: u64) -> i64 {
    if nd_len == 0 { return 0; };
    if hay_len < nd_len { return -1; };
    let last = hay_len - nd_len;
    let i: u64 = 0;
    while i <= last {
        let ok = true;
        let j: u64 = 0;
        while j < nd_len {
            let a: u8 = 0;
            let b: u8 = 0;
            PTR_BYTE_AT(a, hay_ptr, i + j);
            PTR_BYTE_AT(b, nd_ptr, j);
            if a >= 65 && a <= 90 { a = a + 32; };
            if b >= 65 && b <= 90 { b = b + 32; };
            if a != b { ok = false; break; };
            j = j + 1;
        }
        if ok { return i as i64; };
        i = i + 1;
    }
    return -1;
}

fn is_ws_byte(b: u8) -> bool {
    return b == 32 || b == 9 || b == 10 || b == 13;
}

fn str_trim_range(src_ptr: ptr, src_len: u64, out_start: &u64, out_len: &u64) -> void {
    let start: u64 = 0;
    while start < src_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, src_ptr, start);
        if !is_ws_byte(b) { break; };
        start = start + 1;
    }
    let end = src_len;
    while end > start {
        let b: u8 = 0;
        PTR_BYTE_AT(b, src_ptr, end - 1);
        if !is_ws_byte(b) { break; };
        end = end - 1;
    }
    *out_start = start;
    *out_len = end - start;
}

fn str_trim_into(out: &ByteBuf, src_ptr: ptr, src_len: u64) -> void {
    let s: u64 = 0;
    let n: u64 = 0;
    str_trim_range(src_ptr, src_len, &s, &n);
    buf_reset(out);
    let p: ptr = PTR_NULL();
    PTR_BYTE_ADD(p, src_ptr, s);
    buf_append(out, p, n);
}

fn str_lower_into(out: &ByteBuf, src_ptr: ptr, src_len: u64) -> void {
    buf_reset(out);
    let i: u64 = 0;
    while i < src_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, src_ptr, i);
        if b >= 65 && b <= 90 { b = b + 32; };
        if out.len < 262144 {
            out.bytes[out.len] = b;
            out.len = out.len + 1;
        };
        i = i + 1;
    }
}

fn str_trim_lower_into(out: &ByteBuf, src_ptr: ptr, src_len: u64) -> void {
    let t = ByteBuf { bytes: [0u8; 262144], len: 0 };
    str_trim_into(&t, src_ptr, src_len);
    str_lower_into(out, buf_ptr(&t), t.len);
}

// basename from node:path — the part after the last '/' or '\'.
fn jev_basename(path_ptr: ptr, path_len: u64, out: &ByteBuf) -> void {
    buf_reset(out);
    let start: u64 = 0;
    let i: u64 = 0;
    while i < path_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, path_ptr, i);
        if b == 47 || b == 92 { start = i + 1; };
        i = i + 1;
    }
    let p: ptr = PTR_NULL();
    PTR_BYTE_ADD(p, path_ptr, start);
    buf_append(out, p, path_len - start);
}

// process.env lookup: returns true and fills out when set.
// DEFECT: Node process.env has no direct sa_std counterpart;
// approximated via sa_env_get / sa_env_buffer_*.
fn jev_env_get(name_ptr: ptr, name_len: u64, out: &ByteBuf) -> bool {
    buf_reset(out);
    let h = sa_env_get(name_ptr, name_len);
    if h == 0 { return false; };
    let p: ptr = sa_env_buffer_data(h);
    let n: u64 = sa_env_buffer_len(h);
    buf_append(out, p, n);
    return true;
}

// ---- StringMap: Record<string, string> ----
// DEFECT: dynamic object — TS Records are unbounded, insertion
// ordered Maps; StringMap has a fixed capacity of 64 entries with
// concatenated key/value byte storage.
struct StringMap {
    key_off: [u64; 64],
    key_len: [u64; 64],
    val_off: [u64; 64],
    val_len: [u64; 64],
    keys_bytes: [u8; 8192],
    keys_len: u64,
    vals_bytes: [u8; 65536],
    vals_len: u64,
    len: u64,
}

fn stringmap_init(m: &StringMap) -> void {
    m.keys_len = 0;
    m.vals_len = 0;
    m.len = 0;
}

fn stringmap_key_ptr(m: &StringMap, idx: u64) -> ptr {
    let p: ptr = PTR_NULL();
    PTR_BYTE_ADD(p, &m.keys_bytes, m.key_off[idx]);
    return p;
}

fn stringmap_val_ptr(m: &StringMap, idx: u64) -> ptr {
    let p: ptr = PTR_NULL();
    PTR_BYTE_ADD(p, &m.vals_bytes, m.val_off[idx]);
    return p;
}

fn stringmap_find(m: &StringMap, k_ptr: ptr, k_len: u64) -> i64 {
    let i: u64 = 0;
    for i in 0..m.len {
        if jev_str_eq(stringmap_key_ptr(m, i), m.key_len[i], k_ptr, k_len) {
            return i as i64;
        };
    }
    return -1;
}

fn stringmap_has(m: &StringMap, k_ptr: ptr, k_len: u64) -> bool {
    return stringmap_find(m, k_ptr, k_len) >= 0;
}

fn stringmap_get(m: &StringMap, k_ptr: ptr, k_len: u64, out: &ByteBuf) -> bool {
    let idx = stringmap_find(m, k_ptr, k_len);
    if idx < 0 { return false; };
    buf_reset(out);
    buf_append(out, stringmap_val_ptr(m, idx as u64), m.val_len[idx as u64]);
    return true;
}

// Insert or replace (TS object property assignment semantics).
fn stringmap_set(m: &StringMap, k_ptr: ptr, k_len: u64, v_ptr: ptr, v_len: u64) -> void {
    let existing = stringmap_find(m, k_ptr, k_len);
    if existing >= 0 {
        // Replace value bytes in place when they fit, else append.
        let idx = existing as u64;
        if v_len <= m.val_len[idx] {
            let dst: ptr = stringmap_val_ptr(m, idx);
            let i: u64 = 0;
            while i < v_len {
                let b: u8 = 0;
                PTR_BYTE_AT(b, v_ptr, i);
                // Byte store through ptr arithmetic (scaffolding).
                let dp: ptr = PTR_NULL();
                PTR_BYTE_ADD(dp, dst, i);
                PTR_WRITE_BYTES(dp, b, 1);
                i = i + 1;
            }
            m.val_len[idx] = v_len;
            return;
        };
    };
    if m.len >= 64 { return; };
    let idx = m.len;
    m.key_off[idx] = m.keys_len;
    m.key_len[idx] = k_len;
    let kp: ptr = PTR_NULL();
    PTR_BYTE_ADD(kp, &m.keys_bytes, m.keys_len);
    let i: u64 = 0;
    while i < k_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, k_ptr, i);
        if m.keys_len < 8192 {
            m.keys_bytes[m.keys_len] = b;
            m.keys_len = m.keys_len + 1;
        };
        i = i + 1;
    }
    m.val_off[idx] = m.vals_len;
    m.val_len[idx] = v_len;
    let j: u64 = 0;
    while j < v_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, v_ptr, j);
        if m.vals_len < 65536 {
            m.vals_bytes[m.vals_len] = b;
            m.vals_len = m.vals_len + 1;
        };
        j = j + 1;
    }
    m.len = m.len + 1;
}

fn stringmap_set_lit(m: &StringMap, k_ptr: ptr, k_len: u64, v_ptr: ptr, v_len: u64) -> void {
    stringmap_set(m, k_ptr, k_len, v_ptr, v_len);
}

// TS `delete options[k]` — removes the entry, shifting later
// offset records down (byte storage keeps stale bytes, unreferenced).
fn stringmap_delete(m: &StringMap, k_ptr: ptr, k_len: u64) -> void {
    let idx = stringmap_find(m, k_ptr, k_len);
    if idx < 0 { return; };
    let i = idx as u64;
    while i + 1 < m.len {
        m.key_off[i] = m.key_off[i + 1];
        m.key_len[i] = m.key_len[i + 1];
        m.val_off[i] = m.val_off[i + 1];
        m.val_len[i] = m.val_len[i + 1];
        i = i + 1;
    }
    m.len = m.len - 1;
}

fn stringmap_key_at(m: &StringMap, idx: u64, out: &ByteBuf) -> bool {
    if idx >= m.len { return false; };
    buf_reset(out);
    buf_append(out, stringmap_key_ptr(m, idx), m.key_len[idx]);
    return true;
}

fn stringmap_val_at(m: &StringMap, idx: u64, out: &ByteBuf) -> bool {
    if idx >= m.len { return false; };
    buf_reset(out);
    buf_append(out, stringmap_val_ptr(m, idx), m.val_len[idx]);
    return true;
}

// ---- shared SDK-ish types (declared in the sdk-backend / shared units) ----

// TS: JevRunInput — the statically known fields are struct fields;
// every other key stays in the json text buffer and is read through
// input_dyn_* helpers below.
// DEFECT: dynamic object — the TS input is an open Record; only the
// fields the host adapter extracts are struct fields here.
struct JevRunInput {
    json_bytes: [u8; 262144],
    json_len: u64,
    question_bytes: [u8; 16384],
    question_len: u64,
    has_question: bool,
    options_bytes: [u8; 65536],
    options_len: u64,
    options_kind: u64,
    has_options: bool,
    criteria_bytes: [u8; 65536],
    criteria_len: u64,
    criteria_kind: u64,
    has_criteria: bool,
    checks_bytes: [u8; 65536],
    checks_len: u64,
    checks_kind: u64,
    has_checks: bool,
    context_bytes: [u8; 16384],
    context_len: u64,
    has_context: bool,
    content_bytes: [u8; 16384],
    content_len: u64,
    has_content: bool,
    patch_bytes: [u8; 65536],
    patch_len: u64,
    has_patch: bool,
}

fn input_json_ptr(input: &JevRunInput) -> ptr {
    let p: ptr = PTR_NULL();
    PTR_BYTE_ADD(p, &input.json_bytes, 0);
    return p;
}

// Read a dynamic string key from the input JSON text. Returns false
// when the key is absent or not a string (matching the TS
// `typeof rawInput.x === "string"` guards). Numbers/booleans are
// stringified (matching the `.toString()` alias reads).
// DEFECT: dynamic object — see header note.
fn input_dyn_str(input: &JevRunInput, key_ptr: ptr, key_len: u64, out: &ByteBuf) -> bool {
    buf_reset(out);
    let doc = sa_json_parse(input_json_ptr(input), input.json_len);
    if doc == 0 { return false; };
    let node: u64 = 0;
    if sa_json_object_get(doc, key_ptr, key_len, &node) != 0 { return false; };
    let kind = jev_json_kind(node);
    if kind == 1 {
        let p: ptr = PTR_NULL();
        let n: u64 = 0;
        jev_json_string(node, &p, &n);
        buf_append(out, p, n);
        return true;
    };
    if kind == 4 {
        let v: f64 = 0.0;
        if jev_json_number(node, &v) != 0 { return false; };
        buf_append_f64(out, v);
        return true;
    };
    if kind == 5 {
        let b: bool = false;
        if jev_json_bool(node, &b) != 0 { return false; };
        if b {
            buf_append_lit(out, STR_PTR("true"), STR_LEN("true"));
        } else {
            buf_append_lit(out, STR_PTR("false"), STR_LEN("false"));
        };
        return true;
    };
    return false;
}

// Read a dynamic key as raw JSON text + kind tag (0 null/absent,
// 1 string, 2 array, 3 object, 4 number, 5 boolean).
fn input_dyn_json(input: &JevRunInput, key_ptr: ptr, key_len: u64, out: &ByteBuf, out_kind: &u64) -> bool {
    buf_reset(out);
    *out_kind = 0;
    let doc = sa_json_parse(input_json_ptr(input), input.json_len);
    if doc == 0 { return false; };
    let node: u64 = 0;
    if sa_json_object_get(doc, key_ptr, key_len, &node) != 0 { return false; };
    *out_kind = jev_json_kind(node);
    let p: ptr = PTR_NULL();
    let n: u64 = 0;
    jev_json_text(node, &p, &n);
    buf_append(out, p, n);
    return true;
}

// Read a dynamic numeric key (TS `typeof rawInput.x === "number"`).
fn input_dyn_num(input: &JevRunInput, key_ptr: ptr, key_len: u64, out: &f64) -> bool {
    let doc = sa_json_parse(input_json_ptr(input), input.json_len);
    if doc == 0 { return false; };
    let node: u64 = 0;
    if sa_json_object_get(doc, key_ptr, key_len, &node) != 0 { return false; };
    if jev_json_kind(node) != 4 { return false; };
    return jev_json_number(node, out) == 0;
}

// TS: JevPolicyConfig — opaque to this module (parameters are
// named _policy at every call site); kept as its JSON text.
struct JevPolicyConfig {
    json_bytes: [u8; 65536],
    json_len: u64,
}

// TS: JevRunResult — saVmEvents entries and saVmViolation are
// reduced to the single violation shape this module emits:
// { event: "violation", kind: "jev_error", reason } / { reason }.
// DEFECT: dynamic object — the events array / violation object are
// kept as flags + the reason string.
struct JevRunResult {
    ok: bool,
    kind_bytes: [u8; 64],
    kind_len: u64,
    exitCode: i32,
    stdout_bytes: [u8; 262144],
    stdout_len: u64,
    stderr_bytes: [u8; 16384],
    stderr_len: u64,
    has_violation_event: bool,
    violation_reason_bytes: [u8; 16384],
    violation_reason_len: u64,
    has_violation: bool,
    durationMs: u64,
}

fn result_stdout(result: &JevRunResult) -> ptr {
    let p: ptr = PTR_NULL();
    PTR_BYTE_ADD(p, &result.stdout_bytes, 0);
    return p;
}

fn result_set_kind(result: &JevRunResult, k_ptr: ptr, k_len: u64) -> void {
    result.kind_len = 0;
    let i: u64 = 0;
    while i < k_len && i < 64 {
        let b: u8 = 0;
        PTR_BYTE_AT(b, k_ptr, i);
        result.kind_bytes[result.kind_len] = b;
        result.kind_len = result.kind_len + 1;
        i = i + 1;
    }
}

fn result_set_stdout(result: &JevRunResult, src: &ByteBuf) -> void {
    result.stdout_len = 0;
    let i: u64 = 0;
    while i < src.len {
        if result.stdout_len >= 262144 { break; };
        result.stdout_bytes[result.stdout_len] = src.bytes[i];
        result.stdout_len = result.stdout_len + 1;
        i = i + 1;
    }
}

fn result_set_stderr(result: &JevRunResult, s_ptr: ptr, s_len: u64) -> void {
    result.stderr_len = 0;
    let i: u64 = 0;
    while i < s_len && result.stderr_len < 16384 {
        let b: u8 = 0;
        PTR_BYTE_AT(b, s_ptr, i);
        result.stderr_bytes[result.stderr_len] = b;
        result.stderr_len = result.stderr_len + 1;
        i = i + 1;
    }
}

fn result_set_violation_reason(result: &JevRunResult, s_ptr: ptr, s_len: u64) -> void {
    result.violation_reason_len = 0;
    let i: u64 = 0;
    while i < s_len && result.violation_reason_len < 16384 {
        let b: u8 = 0;
        PTR_BYTE_AT(b, s_ptr, i);
        result.violation_reason_bytes[result.violation_reason_len] = b;
        result.violation_reason_len = result.violation_reason_len + 1;
        i = i + 1;
    }
}

// Shared failure-result shape repeated at every nativeJev* call
// site in TS:
//   { ok: false, kind: status === 401 ? "capability_denied" : "sa_error",
//     exitCode: status === 401 ? 228 : 1, stdout: "", stderr: <built>,
//     saVmEvents: [...], saVmViolation: { reason }, durationMs }
// with_violation_event mirrors the TS variants that include the
// violation event versus the ones with saVmEvents: [].
fn jev_fill_failure(result: &JevRunResult, has_status: bool, status: i32, error_ptr: ptr, error_len: u64, stderr: &ByteBuf, with_violation_event: bool, startedAt: u64) -> void {
    result.ok = false;
    if has_status && status == 401 {
        result_set_kind(result, STR_PTR("capability_denied"), STR_LEN("capability_denied"));
        result.exitCode = 228;
    } else {
        result_set_kind(result, STR_PTR("sa_error"), STR_LEN("sa_error"));
        result.exitCode = 1;
    };
    result.stdout_len = 0;
    result_set_stderr(result, buf_ptr(stderr), stderr.len);
    result.has_violation_event = with_violation_event;
    result_set_violation_reason(result, error_ptr, error_len);
    result.has_violation = true;
    result.durationMs = jev_now_ms() - startedAt;
}

// Shared success-result skeleton:
//   { ok: true, kind: "success", exitCode: 0, stdout: <built>,
//     stderr: "", saVmEvents: [], saVmViolation: null, durationMs }
fn jev_fill_success(result: &JevRunResult, stdout: &ByteBuf, startedAt: u64) -> void {
    result.ok = true;
    result_set_kind(result, STR_PTR("success"), STR_LEN("success"));
    result.exitCode = 0;
    result_set_stdout(result, stdout);
    result.stderr_len = 0;
    result.has_violation_event = false;
    result.violation_reason_len = 0;
    result.has_violation = false;
    result.durationMs = jev_now_ms() - startedAt;
}

// SaVmInputError throw: return code 2, message in out.stderr.
// DEFECT: exceptions — SLA has no throw; native fns return 2 for
// the TS `throw new SaVmInputError(...)` paths.
fn jev_input_error(result: &JevRunResult, msg_ptr: ptr, msg_len: u64) -> i32 {
    result.ok = false;
    result_set_stderr(result, msg_ptr, msg_len);
    return 2;
}

fn jev_input_error_buf(result: &JevRunResult, msg: &ByteBuf) -> i32 {
    return jev_input_error(result, buf_ptr(msg), msg.len);
}

// ---- exported constants (TS `export const`) ----
// SLA has no module-level const strings; each TS const becomes an
// accessor fn delivering the literal through out, keeping the name.
// DEFECT: language — no exported const values in SLA.

// export const JEV_DEFAULT_BASE_URL = "https://api.typesafe.ai/v1/systemone";
fn JEV_DEFAULT_BASE_URL(out: &ByteBuf) -> void {
    buf_reset(out);
    buf_append_lit(out, STR_PTR("https://api.typesafe.ai/v1/systemone"), STR_LEN("https://api.typesafe.ai/v1/systemone"));
}

// export const JEV_DEFAULT_MODEL = "jev-latest";
fn JEV_DEFAULT_MODEL(out: &ByteBuf) -> void {
    buf_reset(out);
    buf_append_lit(out, STR_PTR("jev-latest"), STR_LEN("jev-latest"));
}

// export const JEV_DEFAULT_TIMEOUT_MS = 15_000;
fn JEV_DEFAULT_TIMEOUT_MS() -> u64 {
    return 15000;
}

// export const JEV_MAX_CONTEXT_LENGTH = 8_000;
fn JEV_MAX_CONTEXT_LENGTH() -> u64 {
    return 8000;
}

// Default minimum interval between JEV upstream calls. Serializes burst
// jev_* tool calls so the upstream 503/429 crunch observed on 2026-09-21
// (parallel calls failed, ≥100ms serial spacing succeeded) does not recur.
// export const JEV_DEFAULT_MIN_INTERVAL_MS = 500;
fn JEV_DEFAULT_MIN_INTERVAL_MS() -> u64 {
    return 500;
}

// Default cap on queued + in-flight JEV upstream calls. Beyond this the slot
// acquisition fails fast instead of queueing behind long (15s-timeout) calls.
// export const JEV_DEFAULT_MAX_QUEUE = 16;
fn JEV_DEFAULT_MAX_QUEUE() -> u64 {
    return 16;
}

// ---- Cloudflare-hosted JEV (clef series, e.g. clef-flash) ----
// Runs behind Cloudflare Workers AI `ai/run`: the configured Base URL is the
// account run root
//   https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/run
// and each call appends the model path, e.g.
//   {base}/@cf/cloudflare/clef-flash
// with body { model: "clef-flash", state, questions } and a Cloudflare API
// token as the Bearer key (NOT the JEV apikey).

// export const CLOUDFLARE_JEV_DEFAULT_BASE_URL =
//   "https://api.cloudflare.com/client/v4/accounts/YOUR_ACCOUNT_ID/ai/run";
fn CLOUDFLARE_JEV_DEFAULT_BASE_URL(out: &ByteBuf) -> void {
    buf_reset(out);
    buf_append_lit(out, STR_PTR("https://api.cloudflare.com/client/v4/accounts/YOUR_ACCOUNT_ID/ai/run"), STR_LEN("https://api.cloudflare.com/client/v4/accounts/YOUR_ACCOUNT_ID/ai/run"));
}

// export const CLOUDFLARE_JEV_DEFAULT_MODEL = "clef-flash";
fn CLOUDFLARE_JEV_DEFAULT_MODEL(out: &ByteBuf) -> void {
    buf_reset(out);
    buf_append_lit(out, STR_PTR("clef-flash"), STR_LEN("clef-flash"));
}

// export const CLOUDFLARE_JEV_MODEL_PATH_PREFIX = "@cf/cloudflare/";
fn CLOUDFLARE_JEV_MODEL_PATH_PREFIX(out: &ByteBuf) -> void {
    buf_reset(out);
    buf_append_lit(out, STR_PTR("@cf/cloudflare/"), STR_LEN("@cf/cloudflare/"));
}

//* True when the configured Base URL points at Cloudflare ai/run. 
// TS: export function isCloudflareJevUpstream(baseUrl: string): boolean
fn isCloudflareJevUpstream(baseUrl_ptr: ptr, baseUrl_len: u64) -> bool {
    return str_contains_ci(baseUrl_ptr, baseUrl_len, STR_PTR("api.cloudflare.com"), STR_LEN("api.cloudflare.com"));
}

//*
// * Compose the full Cloudflare run URL for a JEV model.
// * - "clef-flash" -> "{base}/@cf/cloudflare/clef-flash"
// * - "@cf/cloudflare/clef-flash" (or any "@..."/"a/b" path) -> "{base}/{path}"
// 
// TS: export function buildCloudflareJevRequestUrl(baseUrl: string, model: string): string
fn buildCloudflareJevRequestUrl(baseUrl_ptr: ptr, baseUrl_len: u64, model_ptr: ptr, model_len: u64, out: &ByteBuf) -> void {
    // const base = (baseUrl || "").trim().replace(/\/+$/, "");
    // DEFECT: regex — trailing-slash strip via replace(/\/+$/, "")
    // approximated by a manual end scan.
    let b_start: u64 = 0;
    let b_len: u64 = 0;
    str_trim_range(baseUrl_ptr, baseUrl_len, &b_start, &b_len);
    while b_len > 0 {
        let b: u8 = 0;
        PTR_BYTE_AT(b, baseUrl_ptr, b_start + b_len - 1);
        if b != 47 { break; };
        b_len = b_len - 1;
    }
    let base = ByteBuf { bytes: [0u8; 262144], len: 0 };
    let bp: ptr = PTR_NULL();
    PTR_BYTE_ADD(bp, baseUrl_ptr, b_start);
    buf_append(&base, bp, b_len);
    // const name = (model || "").trim() || CLOUDFLARE_JEV_DEFAULT_MODEL;
    let name = ByteBuf { bytes: [0u8; 262144], len: 0 };
    str_trim_into(&name, model_ptr, model_len);
    if name.len == 0 {
        CLOUDFLARE_JEV_DEFAULT_MODEL(&name);
    };
    // const path = name.startsWith("@") ? name.replace(/^\/+/, "")
    //   : (name.includes("/") ? name : `${CLOUDFLARE_JEV_MODEL_PATH_PREFIX}${name}`);
    buf_reset(out);
    buf_append_buf(out, &base);
    buf_append_lit(out, STR_PTR("/"), STR_LEN("/"));
    let first: u8 = 0;
    if name.len > 0 {
        PTR_BYTE_AT(first, buf_ptr(&name), 0);
    };
    if name.len > 0 && first == 64 {
        // startsWith("@"): strip leading '/' characters (none can
        // precede '@'; the TS replace applies to the name itself —
        // kept as-is).
        buf_append_buf(out, &name);
    } else {
        if str_contains_ci(buf_ptr(&name), name.len, STR_PTR("/"), STR_LEN("/")) {
            buf_append_buf(out, &name);
        } else {
            let prefix = ByteBuf { bytes: [0u8; 262144], len: 0 };
            CLOUDFLARE_JEV_MODEL_PATH_PREFIX(&prefix);
            buf_append_buf(out, &prefix);
            buf_append_buf(out, &name);
        };
    };
}

//*
// * Effective model for a Cloudflare upstream: an explicit model is kept, while
// * a blank value (or the JEV-official default, which means the caller did not
// * choose a Cloudflare model) falls back to clef-flash instead of requesting
// * a nonexistent `@cf/cloudflare/jev-latest` path.
// 
// TS: export function resolveCloudflareJevModel(model: string): string
fn resolveCloudflareJevModel(model_ptr: ptr, model_len: u64, out: &ByteBuf) -> void {
    str_trim_into(out, model_ptr, model_len);
    let def = ByteBuf { bytes: [0u8; 262144], len: 0 };
    JEV_DEFAULT_MODEL(&def);
    if out.len == 0 || jev_str_eq(buf_ptr(out), out.len, buf_ptr(&def), def.len) {
        CLOUDFLARE_JEV_DEFAULT_MODEL(out);
    };
}

//* Body model is always the bare name ("clef-flash"), never the @cf/... path. 
// TS: export function cloudflareJevBodyModel(model: string): string
fn cloudflareJevBodyModel(model_ptr: ptr, model_len: u64, out: &ByteBuf) -> void {
    let name = ByteBuf { bytes: [0u8; 262144], len: 0 };
    str_trim_into(&name, model_ptr, model_len);
    if name.len == 0 {
        CLOUDFLARE_JEV_DEFAULT_MODEL(out);
        return;
    };
    // const last = name.split("/").pop()?.trim();
    let start: u64 = 0;
    let i: u64 = 0;
    while i < name.len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, buf_ptr(&name), i);
        if b == 47 { start = i + 1; };
        i = i + 1;
    }
    let seg_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(seg_ptr, buf_ptr(&name), start);
    str_trim_into(out, seg_ptr, name.len - start);
    if out.len == 0 {
        CLOUDFLARE_JEV_DEFAULT_MODEL(out);
    };
}

//*
// * Tolerate both JEV-native ({ answers } / { data }) and Cloudflare-style
// * ({ result }) success envelopes.
// 
// TS: export function unwrapJevUpstreamPayload(parsed: unknown): Record<string, unknown>
// parsed arrives as a sa_json doc handle; returns the unwrapped
// object node handle.
// DEFECT: dynamic object — unknown payload probed through sa_json.
fn unwrapJevUpstreamPayload(parsed_doc: u64) -> u64 {
    let root = parsed_doc;
    let inner: u64 = 0;
    let has_inner = false;
    let tmp: u64 = 0;
    if sa_json_object_get(root, STR_PTR("data"), STR_LEN("data"), &tmp) == 0 {
        inner = tmp;
        has_inner = true;
    } else {
        if sa_json_object_get(root, STR_PTR("result"), STR_LEN("result"), &tmp) == 0 {
            inner = tmp;
            has_inner = true;
        } else {
            inner = root;
            has_inner = true;
        };
    };
    if has_inner {
        let kind = jev_json_kind(inner);
        if kind == 3 {
            return inner;
        };
    };
    return root;
}

//*
// * Namespace for the padding probe below. Downstream verdict parsers only read
// * their own question ids, so this extra answer is always ignored.
// 
// export const CLOUDFLARE_JEV_PAD_QUESTION_ID = "_cf_pad";
fn CLOUDFLARE_JEV_PAD_QUESTION_ID(out: &ByteBuf) -> void {
    buf_reset(out);
    buf_append_lit(out, STR_PTR("_cf_pad"), STR_LEN("_cf_pad"));
}

//*
// * Cloudflare rejects payloads with fewer than 2 valid questions (HTTP 422).
// * Pad single-question calls (e.g. jev_choose's lone `decision`) with a trivial
// * namespaced probe so every action works unchanged on clef models.
// 
// TS: export function padCloudflareJevQuestions(questions: Record<string, unknown>): Record<string, unknown>
// questions arrives as JSON text; the (possibly padded) questions
// object JSON text is built in out.
// DEFECT: dynamic object — object spread {...questions, _cf_pad: ...}
// approximated by JSON text surgery (strip the closing brace and
// append the pad entry).
fn padCloudflareJevQuestions(questions_ptr: ptr, questions_len: u64, out: &ByteBuf) -> void {
    let doc = sa_json_parse(questions_ptr, questions_len);
    let n: u64 = 0;
    if doc != 0 {
        n = jev_json_count(doc);
    };
    let pad_id = ByteBuf { bytes: [0u8; 262144], len: 0 };
    CLOUDFLARE_JEV_PAD_QUESTION_ID(&pad_id);
    let has_pad = false;
    if doc != 0 {
        let tmp: u64 = 0;
        has_pad = sa_json_object_get(doc, buf_ptr(&pad_id), pad_id.len, &tmp) == 0;
    };
    buf_reset(out);
    if n >= 2 || has_pad {
        buf_append(out, questions_ptr, questions_len);
        return;
    };
    // Find the closing '}' of the object text and insert before it.
    let end = questions_len;
    while end > 0 {
        let b: u8 = 0;
        PTR_BYTE_AT(b, questions_ptr, end - 1);
        if !is_ws_byte(b) { break; };
        end = end - 1;
    }
    if end > 0 {
        let last: u8 = 0;
        PTR_BYTE_AT(last, questions_ptr, end - 1);
        if last == 125 {
            end = end - 1;
        };
    };
    buf_append(out, questions_ptr, end);
    if n > 0 {
        buf_append_lit(out, STR_PTR(","), STR_LEN(","));
    };
    buf_append_json_str(out, buf_ptr(&pad_id), pad_id.len);
    buf_append_lit(out, STR_PTR(":{\"type\":\"choice\",\"instructions\":\"Padding probe: reply with the ok option.\",\"criteria\":{\"ok\":\"padding probe expects ok\",\"bad\":\"padding probe rejects bad\"}}}"), STR_LEN(":{\"type\":\"choice\",\"instructions\":\"Padding probe: reply with the ok option.\",\"criteria\":{\"ok\":\"padding probe expects ok\",\"bad\":\"padding probe rejects bad\"}}}"));
}

//*
// * Connectivity-test questions for the /api/jev/test probe. Cloudflare needs
// * two well-formed choice questions; JEV official keeps its single noul probe.
// 
// TS: export function buildJevConnectivityQuestions(baseUrl: string): Record<string, unknown>
// The returned Record is built as JSON text in out.
// DEFECT: dynamic object — Record return kept as JSON text buffer.
fn buildJevConnectivityQuestions(baseUrl_ptr: ptr, baseUrl_len: u64, out: &ByteBuf) -> void {
    buf_reset(out);
    if isCloudflareJevUpstream(baseUrl_ptr, baseUrl_len) {
        buf_append_lit(out, STR_PTR("{\"cf_test_choice\":{\"type\":\"choice\",\"instructions\":\"Reply with the ok option.\",\"criteria\":{\"ok\":\"connectivity probe expects ok\",\"bad\":\"connectivity probe rejects bad\"}},\"cf_test_confirm\":{\"type\":\"choice\",\"instructions\":\"Confirm this connectivity probe.\",\"criteria\":{\"yes\":\"probe confirmed\",\"no\":\"probe denied\"}}}"), STR_LEN("{\"cf_test_choice\":{\"type\":\"choice\",\"instructions\":\"Reply with the ok option.\",\"criteria\":{\"ok\":\"connectivity probe expects ok\",\"bad\":\"connectivity probe rejects bad\"}},\"cf_test_confirm\":{\"type\":\"choice\",\"instructions\":\"Confirm this connectivity probe.\",\"criteria\":{\"yes\":\"probe confirmed\",\"no\":\"probe denied\"}}}"));
        return;
    };
    buf_append_lit(out, STR_PTR("{\"is_test\":{\"type\":\"noul\",\"instructions\":\"Is this a connectivity test?\"}}"), STR_LEN("{\"is_test\":{\"type\":\"noul\",\"instructions\":\"Is this a connectivity test?\"}}"));
}

// ---- shared JEV config + module state ----

// TS: export interface JevSharedConfig { baseUrl?: string; apiKey?:
// string; model?: string; providerId?: string; groupId?: string;
// bridgeProtocol?: string; minIntervalMs?: number;
// throttleEnabled?: boolean; maxQueueLength?: number }
// Optional string fields are fixed buffers + has_* flags.
// DEFECT: dynamic typing — TS optional fields / undefined have no
// SLA counterpart; has_* flags carry the distinction.
struct JevSharedConfig {
    baseUrl_bytes: [u8; 1024],
    baseUrl_len: u64,
    has_baseUrl: bool,
    apiKey_bytes: [u8; 1024],
    apiKey_len: u64,
    has_apiKey: bool,
    model_bytes: [u8; 512],
    model_len: u64,
    has_model: bool,
    providerId_bytes: [u8; 512],
    providerId_len: u64,
    has_providerId: bool,
    groupId_bytes: [u8; 512],
    groupId_len: u64,
    has_groupId: bool,
    bridgeProtocol_bytes: [u8; 256],
    bridgeProtocol_len: u64,
    has_bridgeProtocol: bool,
    // Minimum ms between JEV upstream calls (default 500).
    minIntervalMs: u64,
    has_minIntervalMs: bool,
    // Set false to disable the throttle.
    throttleEnabled: bool,
    has_throttleEnabled: bool,
    // Max queued + in-flight JEV calls before failing fast (default 16).
    maxQueueLength: u64,
    has_maxQueueLength: bool,
}

fn shared_field_ptr(cfg: &JevSharedConfig, field: u64, out_len: &u64) -> ptr {
    let p: ptr = PTR_NULL();
    if field == 0 { PTR_BYTE_ADD(p, &cfg.baseUrl_bytes, 0); *out_len = cfg.baseUrl_len; return p; };
    if field == 1 { PTR_BYTE_ADD(p, &cfg.apiKey_bytes, 0); *out_len = cfg.apiKey_len; return p; };
    if field == 2 { PTR_BYTE_ADD(p, &cfg.model_bytes, 0); *out_len = cfg.model_len; return p; };
    if field == 3 { PTR_BYTE_ADD(p, &cfg.providerId_bytes, 0); *out_len = cfg.providerId_len; return p; };
    if field == 4 { PTR_BYTE_ADD(p, &cfg.groupId_bytes, 0); *out_len = cfg.groupId_len; return p; };
    PTR_BYTE_ADD(p, &cfg.bridgeProtocol_bytes, 0);
    *out_len = cfg.bridgeProtocol_len;
    return p;
}

fn shared_field_has(cfg: &JevSharedConfig, field: u64) -> bool {
    if field == 0 { return cfg.has_baseUrl; };
    if field == 1 { return cfg.has_apiKey; };
    if field == 2 { return cfg.has_model; };
    if field == 3 { return cfg.has_providerId; };
    if field == 4 { return cfg.has_groupId; };
    return cfg.has_bridgeProtocol;
}

// Module-level state (TS top-level `let` bindings in this module):
//   sharedJevConfig, relayExecutor, jevSlotChain, jevLastStartAt,
//   jevWaiting, jevMinIntervalOverride, jevMaxQueueOverride,
//   jevThrottleEnabledOverride.
// DEFECT: module-level mutable state — SLA has no module globals;
// the state is an explicit struct the host owns and passes in.
struct JevModuleState {
    shared: JevSharedConfig,
    has_shared: bool,
    // JevRelayExecutor callback handle (see setJevRelayExecutor).
    relay_executor_id: u64,
    has_relay_executor: bool,
    // Throttle slot-chain state: jevSlotChain is a Promise chain in
    // TS; here only the counters survive (see acquireJevSlot).
    jevWaiting: u64,
    jevLastStartAt: u64,
    slot_held: bool,
    min_interval_override: u64,
    has_min_interval_override: bool,
    max_queue_override: u64,
    has_max_queue_override: bool,
    throttle_enabled_override: bool,
    has_throttle_enabled_override: bool,
}

fn jev_module_state_init(state: &JevModuleState) -> void {
    state.has_shared = false;
    state.shared.has_baseUrl = false;
    state.shared.baseUrl_len = 0;
    state.shared.has_apiKey = false;
    state.shared.apiKey_len = 0;
    state.shared.has_model = false;
    state.shared.model_len = 0;
    state.shared.has_providerId = false;
    state.shared.providerId_len = 0;
    state.shared.has_groupId = false;
    state.shared.groupId_len = 0;
    state.shared.has_bridgeProtocol = false;
    state.shared.bridgeProtocol_len = 0;
    state.shared.has_minIntervalMs = false;
    state.shared.has_throttleEnabled = false;
    state.shared.has_maxQueueLength = false;
    state.relay_executor_id = 0;
    state.has_relay_executor = false;
    state.jevWaiting = 0;
    state.jevLastStartAt = 0;
    state.slot_held = false;
    state.has_min_interval_override = false;
    state.has_max_queue_override = false;
    state.has_throttle_enabled_override = false;
}

// Copy one string field of a JevSharedConfig (field ids as in
// shared_field_ptr) from src into dst.
fn shared_copy_field(dst: &JevSharedConfig, src: &JevSharedConfig, field: u64) -> void {
    let n: u64 = 0;
    let sp: ptr = shared_field_ptr(src, field, &n);
    let dn: u64 = 0;
    let dp: ptr = shared_field_ptr(dst, field, &dn);
    let cap: u64 = 1024;
    if field >= 2 && field <= 4 { cap = 512; };
    if field == 5 { cap = 256; };
    if n > cap { n = cap; };
    let i: u64 = 0;
    while i < n {
        let b: u8 = 0;
        PTR_BYTE_AT(b, sp, i);
        let tp: ptr = PTR_NULL();
        PTR_BYTE_ADD(tp, dp, i);
        PTR_WRITE_BYTES(tp, b, 1);
        i = i + 1;
    }
    // Record the new length / presence on dst.
    if field == 0 { dst.baseUrl_len = n; dst.has_baseUrl = src.has_baseUrl; };
    if field == 1 { dst.apiKey_len = n; dst.has_apiKey = src.has_apiKey; };
    if field == 2 { dst.model_len = n; dst.has_model = src.has_model; };
    if field == 3 { dst.providerId_len = n; dst.has_providerId = src.has_providerId; };
    if field == 4 { dst.groupId_len = n; dst.has_groupId = src.has_groupId; };
    if field == 5 { dst.bridgeProtocol_len = n; dst.has_bridgeProtocol = src.has_bridgeProtocol; };
}

fn shared_copy(dst: &JevSharedConfig, src: &JevSharedConfig) -> void {
    let f: u64 = 0;
    for f in 0..6 {
        shared_copy_field(dst, src, f);
    }
    dst.minIntervalMs = src.minIntervalMs;
    dst.has_minIntervalMs = src.has_minIntervalMs;
    dst.throttleEnabled = src.throttleEnabled;
    dst.has_throttleEnabled = src.has_throttleEnabled;
    dst.maxQueueLength = src.maxQueueLength;
    dst.has_maxQueueLength = src.has_maxQueueLength;
}

// TS: let sharedJevConfig: JevSharedConfig | null = null;
// TS: export function setSharedJevConfig(config: JevSharedConfig | null): void
fn setSharedJevConfig(state: &JevModuleState, config: &JevSharedConfig, has_config: bool) -> void {
    if !has_config {
        state.has_shared = false;
        return;
    };
    shared_copy(&state.shared, config);
    state.has_shared = true;
}

// TS: export function getSharedJevConfig(): JevSharedConfig | null
// Returns false for TS null; otherwise copies into out.
fn getSharedJevConfig(state: &JevModuleState, out: &JevSharedConfig) -> bool {
    if !state.has_shared { return false; };
    shared_copy(out, &state.shared);
    return true;
}

// TS: export type JevRelayExecutor = (payload: {
//   state: string; model: string;
//   questions: Record<string, unknown>;
//   providerId: string; groupId?: string; bridgeProtocol?: string;
//   signal?: AbortSignal;
// }) => Promise<Response>;
// DEFECT: callbacks / Promise — a function-typed value returning a
// Promise<Response> has no SLA counterpart. The executor is an
// opaque id registered with the host; jev_relay_executor_call is
// the intent-level extern that invokes it, and the Response becomes
// JevHttpResponse below. AbortSignal is dropped (timeout handled by
// the call extern).
struct JevRelayPayload {
    state_bytes: [u8; 262144],
    state_len: u64,
    model_bytes: [u8; 512],
    model_len: u64,
    questions_bytes: [u8; 131072],
    questions_len: u64,
    providerId_bytes: [u8; 512],
    providerId_len: u64,
    groupId_bytes: [u8; 512],
    groupId_len: u64,
    has_groupId: bool,
    bridgeProtocol_bytes: [u8; 256],
    bridgeProtocol_len: u64,
    has_bridgeProtocol: bool,
}

// TS: let relayExecutor: JevRelayExecutor | null = null;
// TS: export function setJevRelayExecutor(executor: JevRelayExecutor | null): void
fn setJevRelayExecutor(state: &JevModuleState, executor_id: u64, has_executor: bool) -> void {
    state.relay_executor_id = executor_id;
    state.has_relay_executor = has_executor;
}

// fetch() Response / relay executor Response, reduced to what this
// module reads: ok, status, text() body. timed_out carries the
// AbortError distinction for the timeout message.
// DEFECT: streams / Response object — body is fully buffered text.
struct JevHttpResponse {
    ok: bool,
    status: i32,
    body_bytes: [u8; 262144],
    body_len: u64,
    timed_out: bool,
}

fn response_body_ptr(resp: &JevHttpResponse) -> ptr {
    let p: ptr = PTR_NULL();
    PTR_BYTE_ADD(p, &resp.body_bytes, 0);
    return p;
}

// ---- JEV upstream throttle (serial slot + minimum interval) ----
// Control switches (precedence: explicit override > env > shared config > default):
// - JEV_MIN_INTERVAL_MS: minimum ms between upstream calls (default 500)
// - JEV_MAX_QUEUE: max queued + in-flight calls before failing fast (default 16)
// - JEV_THROTTLE_DISABLED=1: disable the throttle entirely
// - setJevThrottle({ minIntervalMs, maxQueueLength, enabled }): programmatic control (tests/settings)
// TS module state:
//   let jevSlotChain: Promise<void> = Promise.resolve();
//   let jevLastStartAt = 0;
//   let jevWaiting = 0;
//   let jevMinIntervalOverride: number | null = null;
//   let jevMaxQueueOverride: number | null = null;
//   let jevThrottleEnabledOverride: boolean | null = null;
// All of it lives in JevModuleState (see above).

// TS: export function setJevThrottle(config: { minIntervalMs?: number; maxQueueLength?: number; enabled?: boolean } | null): void
// has_config=false is TS null (clears all overrides); the has_*
// flags carry which optional fields were provided.
fn setJevThrottle(state: &JevModuleState, has_config: bool, minIntervalMs: u64, has_minIntervalMs: bool, maxQueueLength: u64, has_maxQueueLength: bool, enabled: bool, has_enabled: bool) -> void {
    if !has_config {
        state.has_min_interval_override = false;
        state.has_max_queue_override = false;
        state.has_throttle_enabled_override = false;
        return;
    };
    if has_minIntervalMs {
        state.min_interval_override = minIntervalMs;
        state.has_min_interval_override = true;
    };
    if has_maxQueueLength {
        state.max_queue_override = maxQueueLength;
        state.has_max_queue_override = true;
    };
    if has_enabled {
        state.throttle_enabled_override = enabled;
        state.has_throttle_enabled_override = true;
    };
}

// Parse a non-negative integer env string (TS: Number(raw)); sets
// ok=false when the text is not a finite number. Integers only —
// DEFECT: number parsing — JS Number() accepts floats/hex; the
// approximation accepts plain decimal integers.
fn jev_parse_env_u64(text_ptr: ptr, text_len: u64, out: &u64) -> bool {
    if text_len == 0 { return false; };
    let v: u64 = 0;
    let i: u64 = 0;
    while i < text_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, text_ptr, i);
        if b < 48 || b > 57 { return false; };
        v = v * 10 + (b - 48) as u64;
        i = i + 1;
    }
    *out = v;
    return true;
}

// TS: export function resolveJevMinIntervalMs(): number
fn resolveJevMinIntervalMs(state: &JevModuleState) -> u64 {
    if state.has_min_interval_override {
        // Number.isFinite(override) && override >= 0 — overrides are
        // stored as u64, so both hold by construction.
        let v = state.min_interval_override;
        if v > 60000 { v = 60000; };
        return v;
    };
    let env_buf = ByteBuf { bytes: [0u8; 262144], len: 0 };
    if jev_env_get(STR_PTR("JEV_MIN_INTERVAL_MS"), STR_LEN("JEV_MIN_INTERVAL_MS"), &env_buf) {
        let t = ByteBuf { bytes: [0u8; 262144], len: 0 };
        str_trim_into(&t, buf_ptr(&env_buf), env_buf.len);
        if t.len > 0 {
            let parsed: u64 = 0;
            if jev_parse_env_u64(buf_ptr(&t), t.len, &parsed) {
                if parsed > 60000 { parsed = 60000; };
                return parsed;
            };
        };
    };
    if state.has_shared && state.shared.has_minIntervalMs {
        let shared = state.shared.minIntervalMs;
        if shared > 60000 { shared = 60000; };
        return shared;
    };
    return JEV_DEFAULT_MIN_INTERVAL_MS();
}

// TS: export function isJevThrottleEnabled(): boolean
fn isJevThrottleEnabled(state: &JevModuleState) -> bool {
    if state.has_throttle_enabled_override { return state.throttle_enabled_override; };
    let env_buf = ByteBuf { bytes: [0u8; 262144], len: 0 };
    if jev_env_get(STR_PTR("JEV_THROTTLE_DISABLED"), STR_LEN("JEV_THROTTLE_DISABLED"), &env_buf) {
        let t = ByteBuf { bytes: [0u8; 262144], len: 0 };
        str_trim_into(&t, buf_ptr(&env_buf), env_buf.len);
        if jev_str_eq(buf_ptr(&t), t.len, STR_PTR("1"), STR_LEN("1")) { return false; };
    };
    if state.has_shared && state.shared.has_throttleEnabled && !state.shared.throttleEnabled { return false; };
    return true;
}

// TS: export function resolveJevMaxQueue(): number
fn resolveJevMaxQueue(state: &JevModuleState) -> u64 {
    if state.has_max_queue_override && state.max_queue_override > 0 {
        let v = state.max_queue_override;
        if v > 256 { v = 256; };
        return v;
    };
    let env_buf = ByteBuf { bytes: [0u8; 262144], len: 0 };
    if jev_env_get(STR_PTR("JEV_MAX_QUEUE"), STR_LEN("JEV_MAX_QUEUE"), &env_buf) {
        let t = ByteBuf { bytes: [0u8; 262144], len: 0 };
        str_trim_into(&t, buf_ptr(&env_buf), env_buf.len);
        if t.len > 0 {
            let parsed: u64 = 0;
            if jev_parse_env_u64(buf_ptr(&t), t.len, &parsed) && parsed > 0 {
                if parsed > 256 { parsed = 256; };
                return parsed;
            };
        };
    };
    if state.has_shared && state.shared.has_maxQueueLength && state.shared.maxQueueLength > 0 {
        let shared = state.shared.maxQueueLength;
        if shared > 256 { shared = 256; };
        return shared;
    };
    return JEV_DEFAULT_MAX_QUEUE();
}

// TS: export function getJevThrottle(): { minIntervalMs: number; maxQueueLength: number; enabled: boolean }
// The returned object is delivered through the out fields.
fn getJevThrottle(state: &JevModuleState, out_minIntervalMs: &u64, out_maxQueueLength: &u64, out_enabled: &bool) -> void {
    *out_minIntervalMs = resolveJevMinIntervalMs(state);
    *out_maxQueueLength = resolveJevMaxQueue(state);
    *out_enabled = isJevThrottleEnabled(state);
}

// TS: async function acquireJevSlot(): Promise<() => void>
// Returns 0 when the slot is held (release with jev_release_slot),
// 2 when the TS code throws SaVmInputError (queue full).
// DEFECT: async — the Promise slot chain (jevSlotChain) serializes
// callers in TS; here acquisition is synchronous: the caller is
// assumed to hold the chain exclusively, jevWaiting is only a
// counter, and the minimum-interval wait becomes jev_sleep_ms.
// DEFECT: closures — the returned release closure `done` becomes
// the jev_release_slot fn keyed on state.slot_held.
// DEFECT: timers — setTimeout-based waiting becomes jev_sleep_ms.
fn acquireJevSlot(state: &JevModuleState) -> i32 {
    // Disabled: pre-fix behavior, no serialization or counting.
    if !isJevThrottleEnabled(state) {
        state.slot_held = false;
        return 0;
    };
    let maxQueue = resolveJevMaxQueue(state);
    if state.jevWaiting >= maxQueue {
        // throw new SaVmInputError(
        //   `JEV overloaded: ${jevWaiting} calls already queued/in-flight (max ${maxQueue}); retry later.`)
        // The message is rebuilt by the caller chain (executeJevCall
        // propagates code 2 unchanged); stored here for inspection:
        state.slot_held = false;
        return 2;
    };
    state.jevWaiting = state.jevWaiting + 1;
    state.slot_held = true;
    // await previous; (chain wait — synchronous approximation, see above)
    let interval = resolveJevMinIntervalMs(state);
    if interval > 0 {
        let now = jev_now_ms();
        let elapsed: u64 = 0;
        if now >= state.jevLastStartAt { elapsed = now - state.jevLastStartAt; };
        if interval > elapsed {
            let waitMs = interval - elapsed;
            // await new Promise((resolve) => setTimeout(resolve, waitMs));
            jev_sleep_ms(waitMs);
        };
    };
    state.jevLastStartAt = jev_now_ms();
    return 0;
}

// The release closure returned by acquireJevSlot in TS.
fn jev_release_slot(state: &JevModuleState) -> void {
    if state.slot_held {
        if state.jevWaiting > 0 {
            state.jevWaiting = state.jevWaiting - 1;
        };
        state.slot_held = false;
    };
}

// ---- compact string field (credentials / payload model) ----
struct JevStr {
    bytes: [u8; 8192],
    len: u64,
}

fn js_ptr(s: &JevStr) -> ptr {
    let p: ptr = PTR_NULL();
    PTR_BYTE_ADD(p, &s.bytes, 0);
    return p;
}

fn js_set(s: &JevStr, src_ptr: ptr, src_len: u64) -> void {
    s.len = 0;
    let i: u64 = 0;
    while i < src_len && s.len < 8192 {
        let b: u8 = 0;
        PTR_BYTE_AT(b, src_ptr, i);
        s.bytes[s.len] = b;
        s.len = s.len + 1;
        i = i + 1;
    }
}

fn js_set_buf(s: &JevStr, b: &ByteBuf) -> void {
    js_set(s, buf_ptr(b), b.len);
}

fn js_trimmed_set(s: &JevStr, src_ptr: ptr, src_len: u64) -> void {
    let st: u64 = 0;
    let n: u64 = 0;
    str_trim_range(src_ptr, src_len, &st, &n);
    let p: ptr = PTR_NULL();
    PTR_BYTE_ADD(p, src_ptr, st);
    js_set(s, p, n);
}

// String(node) for JSON values.
// DEFECT: dynamic typing — JS String() coercion approximated:
// string -> itself, number -> decimal, boolean -> "true"/"false",
// null -> "null", array -> comma-joined elements, object ->
// "[object Object]".
fn jev_node_to_string(node: u64, out: &ByteBuf) -> void {
    buf_reset(out);
    let kind = jev_json_kind(node);
    if kind == 1 {
        let p: ptr = PTR_NULL();
        let n: u64 = 0;
        jev_json_string(node, &p, &n);
        buf_append(out, p, n);
        return;
    };
    if kind == 4 {
        let v: f64 = 0.0;
        jev_json_number(node, &v);
        buf_append_f64(out, v);
        return;
    };
    if kind == 5 {
        let b: bool = false;
        jev_json_bool(node, &b);
        if b {
            buf_append_lit(out, STR_PTR("true"), STR_LEN("true"));
        } else {
            buf_append_lit(out, STR_PTR("false"), STR_LEN("false"));
        };
        return;
    };
    if kind == 2 {
        let n = jev_json_count(node);
        let i: u64 = 0;
        for i in 0..n {
            if i > 0 {
                buf_append_lit(out, STR_PTR(","), STR_LEN(","));
            };
            let elem: u64 = 0;
            sa_json_array_get(node, i, &elem);
            let tmp = ByteBuf { bytes: [0u8; 262144], len: 0 };
            jev_node_to_string(elem, &tmp);
            buf_append_buf(out, &tmp);
        }
        return;
    };
    if kind == 3 {
        buf_append_lit(out, STR_PTR("[object Object]"), STR_LEN("[object Object]"));
        return;
    };
    buf_append_lit(out, STR_PTR("null"), STR_LEN("null"));
}

// Convert a parsed JSON value (array or object node) into a
// StringMap. key_mode 0: array items keyed "1", "2", ... (choice);
// key_mode 1: array items keyed "check_1", ... (checklist). Object
// entries keep their own keys in both modes. Values pass through
// String(...) + trim and are skipped when key or value is empty.
fn jev_json_value_to_map(node: u64, key_mode: u64, out: &StringMap) -> void {
    stringmap_init(out);
    let kind = jev_json_kind(node);
    if kind == 2 {
        let n = jev_json_count(node);
        let i: u64 = 0;
        for i in 0..n {
            let elem: u64 = 0;
            sa_json_array_get(node, i, &elem);
            let raw = ByteBuf { bytes: [0u8; 262144], len: 0 };
            jev_node_to_string(elem, &raw);
            let text = ByteBuf { bytes: [0u8; 262144], len: 0 };
            str_trim_into(&text, buf_ptr(&raw), raw.len);
            if text.len > 0 {
                let key = ByteBuf { bytes: [0u8; 262144], len: 0 };
                if key_mode == 1 {
                    buf_append_lit(&key, STR_PTR("check_"), STR_LEN("check_"));
                };
                buf_append_u64(&key, i + 1);
                stringmap_set(out, buf_ptr(&key), key.len, buf_ptr(&text), text.len);
            };
        }
        return;
    };
    if kind == 3 {
        let n = jev_json_count(node);
        let i: u64 = 0;
        for i in 0..n {
            let kp: ptr = PTR_NULL();
            let kl: u64 = 0;
            sa_json_object_key_at(node, i, &kp, &kl);
            let val: u64 = 0;
            jev_json_object_value_at(node, i, &val);
            let k = ByteBuf { bytes: [0u8; 262144], len: 0 };
            str_trim_into(&k, kp, kl);
            let raw = ByteBuf { bytes: [0u8; 262144], len: 0 };
            jev_node_to_string(val, &raw);
            let v = ByteBuf { bytes: [0u8; 262144], len: 0 };
            str_trim_into(&v, buf_ptr(&raw), raw.len);
            if k.len > 0 && v.len > 0 {
                stringmap_set(out, buf_ptr(&k), k.len, buf_ptr(&v), v.len);
            };
        }
        return;
    };
}

// Split text into lines the way normalizeChoiceOptions /
// normalizeChecklistItems do:
//   trimmed.split(/\r?\n/).map(l => l.trim().replace(/^[\d+*•-]\.?\s*/, "")).filter(Boolean)
// and, when the count reaches min_lines, fill out with generated
// keys (key_mode as above). Returns true when the line path
// produced the map.
// DEFECT: regex — the bullet-strip regex /^[\d+*•-]\.?\s*/ is
// approximated by hand: one leading class char (digit, '*', '•',
// '-'), one optional '.', then spaces/tabs.
fn jev_lines_to_map(text_ptr: ptr, text_len: u64, min_lines: u64, key_mode: u64, out: &StringMap) -> bool {
    stringmap_init(out);
    // First pass: count surviving lines into a scratch map with
    // generated keys; commit only when the count reaches min_lines.
    let scratch = StringMap { key_off: [0u64; 64], key_len: [0u64; 64], val_off: [0u64; 64], val_len: [0u64; 64], keys_bytes: [0u8; 8192], keys_len: 0, vals_bytes: [0u8; 65536], vals_len: 0, len: 0 };
    stringmap_init(&scratch);
    let pos: u64 = 0;
    let line_no: u64 = 0;
    while pos <= text_len {
        // Extract one line [pos, line_end) split on '\n'.
        let line_end = pos;
        while line_end < text_len {
            let b: u8 = 0;
            PTR_BYTE_AT(b, text_ptr, line_end);
            if b == 10 { break; };
            line_end = line_end + 1;
        }
        let seg_len = line_end - pos;
        // Strip a trailing '\r' (the /\r?\n/ split).
        if seg_len > 0 {
            let b: u8 = 0;
            PTR_BYTE_AT(b, text_ptr, pos + seg_len - 1);
            if b == 13 { seg_len = seg_len - 1; };
        };
        let seg_ptr: ptr = PTR_NULL();
        PTR_BYTE_ADD(seg_ptr, text_ptr, pos);
        let line = ByteBuf { bytes: [0u8; 262144], len: 0 };
        str_trim_into(&line, seg_ptr, seg_len);
        // Strip the bullet prefix.
        if line.len > 0 {
            let b0: u8 = 0;
            PTR_BYTE_AT(b0, buf_ptr(&line), 0);
            let is_bullet = (b0 >= 48 && b0 <= 57) || b0 == 42 || b0 == 45;
            let bullet_len: u64 = 1;
            if b0 == 226 {
                // '•' is the 3-byte UTF-8 sequence E2 80 A2.
                if line.len >= 3 {
                    let b1: u8 = 0;
                    let b2: u8 = 0;
                    PTR_BYTE_AT(b1, buf_ptr(&line), 1);
                    PTR_BYTE_AT(b2, buf_ptr(&line), 2);
                    if b1 == 128 && b2 == 162 {
                        is_bullet = true;
                        bullet_len = 3;
                    };
                };
            };
            if is_bullet {
                let p = bullet_len;
                if p < line.len {
                    let bd: u8 = 0;
                    PTR_BYTE_AT(bd, buf_ptr(&line), p);
                    if bd == 46 { p = p + 1; };
                };
                while p < line.len {
                    let bs: u8 = 0;
                    PTR_BYTE_AT(bs, buf_ptr(&line), p);
                    if bs != 32 && bs != 9 { break; };
                    p = p + 1;
                }
                let rest = ByteBuf { bytes: [0u8; 262144], len: 0 };
                let rp: ptr = PTR_NULL();
                PTR_BYTE_ADD(rp, buf_ptr(&line), p);
                buf_append(&rest, rp, line.len - p);
                buf_copy_into(&line, &rest);
            };
        };
        if line.len > 0 {
            line_no = line_no + 1;
            let key = ByteBuf { bytes: [0u8; 262144], len: 0 };
            if key_mode == 1 {
                buf_append_lit(&key, STR_PTR("check_"), STR_LEN("check_"));
            };
            buf_append_u64(&key, line_no);
            stringmap_set(&scratch, buf_ptr(&key), key.len, buf_ptr(&line), line.len);
        };
        if line_end >= text_len { break; };
        pos = line_end + 1;
    }
    if scratch.len >= min_lines {
        // Commit scratch into out.
        let i: u64 = 0;
        for i in 0..scratch.len {
            let k = ByteBuf { bytes: [0u8; 262144], len: 0 };
            let v = ByteBuf { bytes: [0u8; 262144], len: 0 };
            stringmap_key_at(&scratch, i, &k);
            stringmap_val_at(&scratch, i, &v);
            stringmap_set(out, buf_ptr(&k), k.len, buf_ptr(&v), v.len);
        }
        return true;
    };
    return false;
}

//*
// * Normalizes single-choice options into a 2~8 entry Record<string, string>.
// * Accepts object `{ a: "...", b: "..." }`, array `["Option A", "Option B"]`,
// * or JSON-encoded object/array string.
// 
// TS: export function normalizeChoiceOptions(raw: unknown): Record<string, string>
// raw arrives as JSON text + kind tag (0 absent/null, 1 string,
// 2 array, 3 object, 4 number, 5 boolean).
// DEFECT: dynamic object — unknown input kept as JSON text.
fn normalizeChoiceOptions(raw_ptr: ptr, raw_len: u64, raw_kind: u64, out: &StringMap) -> void {
    stringmap_init(out);
    if raw_kind == 0 { return; };
    if raw_kind == 1 {
        let trimmed = ByteBuf { bytes: [0u8; 262144], len: 0 };
        str_trim_into(&trimmed, raw_ptr, raw_len);
        if trimmed.len == 0 { return; };
        let first: u8 = 0;
        PTR_BYTE_AT(first, buf_ptr(&trimmed), 0);
        if first == 123 || first == 91 {
            // try { return normalizeChoiceOptions(JSON.parse(trimmed)); } catch {}
            let doc = sa_json_parse(buf_ptr(&trimmed), trimmed.len);
            if doc != 0 {
                jev_json_value_to_map(doc, 0, out);
                return;
            };
        };
        jev_lines_to_map(buf_ptr(&trimmed), trimmed.len, 2, 0, out);
        return;
    };
    if raw_kind == 4 || raw_kind == 5 { return; };
    // typeof raw === "object": array or object JSON text.
    let doc = sa_json_parse(raw_ptr, raw_len);
    if doc == 0 { return; };
    jev_json_value_to_map(doc, 0, out);
}

//*
// * Normalizes multi-check checklist items into a 1~8 entry Record<string, string>.
// * Accepts object `{ null_safe: "...", compat: "..." }`, array `["Check A", "Check B"]`,
// * or JSON-encoded object/array string.
// 
// TS: export function normalizeChecklistItems(raw: unknown): Record<string, string>
// DEFECT: dynamic object — see normalizeChoiceOptions.
fn normalizeChecklistItems(raw_ptr: ptr, raw_len: u64, raw_kind: u64, out: &StringMap) -> void {
    stringmap_init(out);
    if raw_kind == 0 { return; };
    if raw_kind == 1 {
        let trimmed = ByteBuf { bytes: [0u8; 262144], len: 0 };
        str_trim_into(&trimmed, raw_ptr, raw_len);
        if trimmed.len == 0 { return; };
        let first: u8 = 0;
        PTR_BYTE_AT(first, buf_ptr(&trimmed), 0);
        if first == 123 || first == 91 {
            let doc = sa_json_parse(buf_ptr(&trimmed), trimmed.len);
            if doc != 0 {
                jev_json_value_to_map(doc, 1, out);
                return;
            };
        };
        jev_lines_to_map(buf_ptr(&trimmed), trimmed.len, 1, 1, out);
        return;
    };
    if raw_kind == 4 || raw_kind == 5 { return; };
    let doc = sa_json_parse(raw_ptr, raw_len);
    if doc == 0 { return; };
    jev_json_value_to_map(doc, 1, out);
}

// ---- credentials ----

// TS: resolveJevCredentials' return type (an object literal type).
struct JevCredentials {
    baseUrl: JevStr,
    apiKey: JevStr,
    model: JevStr,
    providerId: JevStr,
    groupId: JevStr,
    bridgeProtocol: JevStr,
    timeoutMs: u64,
}

// One precedence step shared by every credential field:
//   raw (already trimmed) -> env var -> shared config field -> default
// Each source is trimmed by the TS code (?.trim()); empty means
// "fall through" (the TS || chain).
fn jev_cred_chain(out: &JevStr, raw: &ByteBuf, env_name_ptr: ptr, env_name_len: u64, state: &JevModuleState, shared_field: u64, default_buf: &ByteBuf, has_default: bool) -> void {
    if raw.len > 0 {
        js_set_buf(out, raw);
        return;
    };
    let env_buf = ByteBuf { bytes: [0u8; 262144], len: 0 };
    if env_name_len > 0 && jev_env_get(env_name_ptr, env_name_len, &env_buf) {
        let t = ByteBuf { bytes: [0u8; 262144], len: 0 };
        str_trim_into(&t, buf_ptr(&env_buf), env_buf.len);
        if t.len > 0 {
            js_set_buf(out, &t);
            return;
        };
    };
    if state.has_shared && shared_field_has(&state.shared, shared_field) {
        let n: u64 = 0;
        let p: ptr = shared_field_ptr(&state.shared, shared_field, &n);
        let t = ByteBuf { bytes: [0u8; 262144], len: 0 };
        str_trim_into(&t, p, n);
        if t.len > 0 {
            js_set_buf(out, &t);
            return;
        };
    };
    if has_default {
        js_set_buf(out, default_buf);
        return;
    };
    js_set(out, STR_PTR(""), 0);
}

// TS: export function resolveJevCredentials(rawInput: Record<string, unknown>): {
//   baseUrl: string; apiKey: string; model: string; providerId: string;
//   groupId: string; bridgeProtocol: string; timeoutMs: number }
fn resolveJevCredentials(state: &JevModuleState, rawInput: &JevRunInput, out: &JevCredentials) -> void {
    // Raw picks: the typeof-string guards map to input_dyn_str
    // succeeding; each pick is trimmed.
    let raw_api_key = ByteBuf { bytes: [0u8; 262144], len: 0 };
    if !input_dyn_str(rawInput, STR_PTR("api_key"), STR_LEN("api_key"), &raw_api_key) {
        input_dyn_str(rawInput, STR_PTR("apiKey"), STR_LEN("apiKey"), &raw_api_key);
    };
    let raw_api_key_t = ByteBuf { bytes: [0u8; 262144], len: 0 };
    str_trim_into(&raw_api_key_t, buf_ptr(&raw_api_key), raw_api_key.len);

    let raw_base_url = ByteBuf { bytes: [0u8; 262144], len: 0 };
    if !input_dyn_str(rawInput, STR_PTR("base_url"), STR_LEN("base_url"), &raw_base_url) {
        input_dyn_str(rawInput, STR_PTR("baseUrl"), STR_LEN("baseUrl"), &raw_base_url);
    };
    let raw_base_url_t = ByteBuf { bytes: [0u8; 262144], len: 0 };
    str_trim_into(&raw_base_url_t, buf_ptr(&raw_base_url), raw_base_url.len);

    let raw_model = ByteBuf { bytes: [0u8; 262144], len: 0 };
    if !input_dyn_str(rawInput, STR_PTR("jev_model"), STR_LEN("jev_model"), &raw_model) {
        input_dyn_str(rawInput, STR_PTR("model"), STR_LEN("model"), &raw_model);
    };
    let raw_model_t = ByteBuf { bytes: [0u8; 262144], len: 0 };
    str_trim_into(&raw_model_t, buf_ptr(&raw_model), raw_model.len);

    let raw_provider = ByteBuf { bytes: [0u8; 262144], len: 0 };
    if !input_dyn_str(rawInput, STR_PTR("jev_provider_id"), STR_LEN("jev_provider_id"), &raw_provider) {
        input_dyn_str(rawInput, STR_PTR("providerId"), STR_LEN("providerId"), &raw_provider);
    };
    let raw_provider_t = ByteBuf { bytes: [0u8; 262144], len: 0 };
    str_trim_into(&raw_provider_t, buf_ptr(&raw_provider), raw_provider.len);

    let raw_group = ByteBuf { bytes: [0u8; 262144], len: 0 };
    if !input_dyn_str(rawInput, STR_PTR("jev_group_id"), STR_LEN("jev_group_id"), &raw_group) {
        input_dyn_str(rawInput, STR_PTR("groupId"), STR_LEN("groupId"), &raw_group);
    };
    let raw_group_t = ByteBuf { bytes: [0u8; 262144], len: 0 };
    str_trim_into(&raw_group_t, buf_ptr(&raw_group), raw_group.len);

    let raw_bridge = ByteBuf { bytes: [0u8; 262144], len: 0 };
    if !input_dyn_str(rawInput, STR_PTR("bridgeProtocol"), STR_LEN("bridgeProtocol"), &raw_bridge) {
        if !input_dyn_str(rawInput, STR_PTR("bridge_protocol"), STR_LEN("bridge_protocol"), &raw_bridge) {
            input_dyn_str(rawInput, STR_PTR("protocol"), STR_LEN("protocol"), &raw_bridge);
        };
    };
    let raw_bridge_t = ByteBuf { bytes: [0u8; 262144], len: 0 };
    str_trim_into(&raw_bridge_t, buf_ptr(&raw_bridge), raw_bridge.len);

    let empty = ByteBuf { bytes: [0u8; 262144], len: 0 };
    let def_base = ByteBuf { bytes: [0u8; 262144], len: 0 };
    JEV_DEFAULT_BASE_URL(&def_base);
    let def_model = ByteBuf { bytes: [0u8; 262144], len: 0 };
    JEV_DEFAULT_MODEL(&def_model);

    // const apiKey = rawApiKey || process.env.JEV_API_KEY?.trim() || shared?.apiKey?.trim() || "";
    jev_cred_chain(&out.apiKey, &raw_api_key_t, STR_PTR("JEV_API_KEY"), STR_LEN("JEV_API_KEY"), state, 1, &empty, true);
    // const baseUrl = rawBaseUrl || process.env.JEV_BASE_URL?.trim() || shared?.baseUrl?.trim() || JEV_DEFAULT_BASE_URL;
    jev_cred_chain(&out.baseUrl, &raw_base_url_t, STR_PTR("JEV_BASE_URL"), STR_LEN("JEV_BASE_URL"), state, 0, &def_base, true);
    // const model = rawModel || process.env.JEV_MODEL?.trim() || shared?.model?.trim() || JEV_DEFAULT_MODEL;
    jev_cred_chain(&out.model, &raw_model_t, STR_PTR("JEV_MODEL"), STR_LEN("JEV_MODEL"), state, 2, &def_model, true);
    // const providerId = rawProviderId || process.env.JEV_PROVIDER_ID?.trim() || shared?.providerId?.trim() || "";
    jev_cred_chain(&out.providerId, &raw_provider_t, STR_PTR("JEV_PROVIDER_ID"), STR_LEN("JEV_PROVIDER_ID"), state, 3, &empty, true);
    // const groupId = rawGroupId || process.env.JEV_GROUP_ID?.trim() || shared?.groupId?.trim() || "";
    jev_cred_chain(&out.groupId, &raw_group_t, STR_PTR("JEV_GROUP_ID"), STR_LEN("JEV_GROUP_ID"), state, 4, &empty, true);
    // const bridgeProtocol = rawBridge || (typeof shared?.bridgeProtocol === "string" ? shared.bridgeProtocol : "") || process.env.JEV_BRIDGE_PROTOCOL?.trim() || "";
    // NOTE the differing order: shared config BEFORE env here, and
    // the shared value is not trimmed in TS.
    if raw_bridge_t.len > 0 {
        js_set_buf(&out.bridgeProtocol, &raw_bridge_t);
    } else {
        let from_shared = false;
        if state.has_shared && state.shared.has_bridgeProtocol {
            let n: u64 = 0;
            let p: ptr = shared_field_ptr(&state.shared, 5, &n);
            if n > 0 {
                js_set(&out.bridgeProtocol, p, n);
                from_shared = true;
            };
        };
        if !from_shared {
            let env_buf = ByteBuf { bytes: [0u8; 262144], len: 0 };
            let done = false;
            if jev_env_get(STR_PTR("JEV_BRIDGE_PROTOCOL"), STR_LEN("JEV_BRIDGE_PROTOCOL"), &env_buf) {
                let t = ByteBuf { bytes: [0u8; 262144], len: 0 };
                str_trim_into(&t, buf_ptr(&env_buf), env_buf.len);
                if t.len > 0 {
                    js_set_buf(&out.bridgeProtocol, &t);
                    done = true;
                };
            };
            if !done {
                js_set(&out.bridgeProtocol, STR_PTR(""), 0);
            };
        };
    };

    // const timeoutMs = typeof rawInput.timeout_ms === "number" && rawInput.timeout_ms > 0
    //   ? Math.min(60_000, rawInput.timeout_ms)
    //   : (typeof rawInput.timeout === "number" && rawInput.timeout > 0 ? Math.min(60_000, rawInput.timeout) : JEV_DEFAULT_TIMEOUT_MS);
    let tms: f64 = 0.0;
    if input_dyn_num(rawInput, STR_PTR("timeout_ms"), STR_LEN("timeout_ms"), &tms) && tms > 0.0 {
        if tms > 60000.0 { tms = 60000.0; };
        out.timeoutMs = tms as u64;
    } else {
        let t2: f64 = 0.0;
        if input_dyn_num(rawInput, STR_PTR("timeout"), STR_LEN("timeout"), &t2) && t2 > 0.0 {
            if t2 > 60000.0 { t2 = 60000.0; };
            out.timeoutMs = t2 as u64;
        } else {
            out.timeoutMs = JEV_DEFAULT_TIMEOUT_MS();
        };
    };
}

// TS: export function truncateJevContext(contextRaw: unknown): string
// contextRaw arrives as (ptr, len) + kind tag (0 absent/null,
// 1 string, 2 array, 3 object, 4 number, 5 boolean). For non-string
// kinds the (ptr, len) carry the value's JSON text.
// DEFECT: dynamic object — unknown input kept as JSON text.
fn truncateJevContext(raw_ptr: ptr, raw_len: u64, raw_kind: u64, out: &ByteBuf) -> void {
    buf_reset(out);
    if raw_kind == 0 || raw_kind == 4 {
        // null/undefined and numbers both yield the placeholder.
        buf_append_lit(out, STR_PTR("(no context provided)"), STR_LEN("(no context provided)"));
        return;
    };
    if raw_kind != 1 {
        // try { return JSON.stringify(contextRaw).slice(0, JEV_MAX_CONTEXT_LENGTH); }
        // catch { return String(contextRaw).slice(0, JEV_MAX_CONTEXT_LENGTH); }
        // The JSON text stands in for both branches.
        let n = raw_len;
        if n > JEV_MAX_CONTEXT_LENGTH() { n = JEV_MAX_CONTEXT_LENGTH(); };
        buf_append(out, raw_ptr, n);
        return;
    };
    let trimmed = ByteBuf { bytes: [0u8; 262144], len: 0 };
    str_trim_into(&trimmed, raw_ptr, raw_len);
    if trimmed.len == 0 {
        buf_append_lit(out, STR_PTR("(empty context)"), STR_LEN("(empty context)"));
        return;
    };
    if trimmed.len <= JEV_MAX_CONTEXT_LENGTH() {
        buf_append_buf(out, &trimmed);
        return;
    };
    // `${trimmed.slice(0, JEV_MAX_CONTEXT_LENGTH - 30)}\n...[truncated for JEV limit]`
    buf_append(out, buf_ptr(&trimmed), JEV_MAX_CONTEXT_LENGTH() - 30);
    buf_append_lit(out, STR_PTR("\n...[truncated for JEV limit]"), STR_LEN("\n...[truncated for JEV limit]"));
}

// Resolve the context argument shared by most native fns:
//   rawInput.context ?? rawInput.content ?? (cast).state
// ?? only skips null/undefined, so has_* flags (presence) decide.
// Non-string state values arrive via the JSON buffer (kind != 1).
fn jev_pick_context(input: &JevRunInput, out_kind: &u64, out: &ByteBuf) -> void {
    buf_reset(out);
    if input.has_context {
        *out_kind = 1;
        let p: ptr = PTR_NULL();
        PTR_BYTE_ADD(p, &input.context_bytes, 0);
        buf_append(out, p, input.context_len);
        return;
    };
    if input.has_content {
        *out_kind = 1;
        let p: ptr = PTR_NULL();
        PTR_BYTE_ADD(p, &input.content_bytes, 0);
        buf_append(out, p, input.content_len);
        return;
    };
    let kind: u64 = 0;
    if input_dyn_json(input, STR_PTR("state"), STR_LEN("state"), out, &kind) {
        *out_kind = kind;
        if kind == 1 {
            // A JSON string's text includes quotes; use the string value.
            let doc = sa_json_parse(input_json_ptr(input), input.json_len);
            let node: u64 = 0;
            if sa_json_object_get(doc, STR_PTR("state"), STR_LEN("state"), &node) == 0 {
                let sp: ptr = PTR_NULL();
                let sn: u64 = 0;
                jev_json_string(node, &sp, &sn);
                buf_reset(out);
                buf_append(out, sp, sn);
            };
        };
        return;
    };
    *out_kind = 0;
}

// ---- upstream call ----

// TS payload: { state: string; model: string; questions: Record<string, unknown> }
// questions is JSON text; state/model are string fields.
struct JevPayload {
    state: ByteBuf,
    model: JevStr,
    questions: ByteBuf,
}

// TS executeJevCall result union:
//   { ok: true; data: Record<string, unknown>; latencyMs: number }
//   | { ok: false; error: string; latencyMs: number; status?: number }
// data is kept as JSON text + its sa_json doc handle.
// DEFECT: dynamic object — data Record kept as JSON text buffer.
struct JevCallResult {
    ok: bool,
    data_doc: u64,
    data_bytes: [u8; 262144],
    data_len: u64,
    latencyMs: u64,
    has_status: bool,
    status: i32,
    error_bytes: [u8; 16384],
    error_len: u64,
}

fn call_data_ptr(r: &JevCallResult) -> ptr {
    let p: ptr = PTR_NULL();
    PTR_BYTE_ADD(p, &r.data_bytes, 0);
    return p;
}

fn call_set_data(r: &JevCallResult, src_ptr: ptr, src_len: u64) -> void {
    r.data_len = 0;
    let i: u64 = 0;
    while i < src_len && r.data_len < 262144 {
        let b: u8 = 0;
        PTR_BYTE_AT(b, src_ptr, i);
        r.data_bytes[r.data_len] = b;
        r.data_len = r.data_len + 1;
        i = i + 1;
    }
    r.data_doc = sa_json_parse(call_data_ptr(r), r.data_len);
}

fn call_set_error(r: &JevCallResult, src_ptr: ptr, src_len: u64) -> void {
    r.error_len = 0;
    let i: u64 = 0;
    while i < src_len && r.error_len < 16384 {
        let b: u8 = 0;
        PTR_BYTE_AT(b, src_ptr, i);
        r.error_bytes[r.error_len] = b;
        r.error_len = r.error_len + 1;
        i = i + 1;
    }
}

fn call_error_into(r: &JevCallResult, out: &ByteBuf) -> void {
    buf_reset(out);
    let p: ptr = PTR_NULL();
    PTR_BYTE_ADD(p, &r.error_bytes, 0);
    buf_append(out, p, r.error_len);
}

// Extract `(parsed as { error?: string })?.error` from a parsed
// response body; returns false when absent / not a string.
fn jev_parsed_error(doc: u64, out: &ByteBuf) -> bool {
    buf_reset(out);
    if doc == 0 { return false; };
    let node: u64 = 0;
    if sa_json_object_get(doc, STR_PTR("error"), STR_LEN("error"), &node) != 0 { return false; };
    if jev_json_kind(node) != 1 { return false; };
    let p: ptr = PTR_NULL();
    let n: u64 = 0;
    jev_json_string(node, &p, &n);
    buf_append(out, p, n);
    return out.len > 0;
}

// Parse a response body the way executeJevCall does:
//   try { parsed = text ? JSON.parse(text) : null; } catch { parsed = { raw: text }; }
// On success doc_out is the parsed doc (0 for empty/null) and
// raw_fallback is false; on parse failure doc_out is a synthesized
// { raw: text } doc text in fallback_buf.
fn jev_parse_response_text(text_ptr: ptr, text_len: u64, doc_out: &u64, fallback_buf: &ByteBuf) -> void {
    buf_reset(fallback_buf);
    *doc_out = 0;
    if text_len == 0 { return; };
    let doc = sa_json_parse(text_ptr, text_len);
    if doc != 0 {
        *doc_out = doc;
        return;
    };
    buf_append_lit(fallback_buf, STR_PTR("{\"raw\":"), STR_LEN("{\"raw\":"));
    buf_append_json_str(fallback_buf, text_ptr, text_len);
    buf_append_lit(fallback_buf, STR_PTR("}"), STR_LEN("}"));
}

// TS: async function executeJevCall(
//   payload: { state: string; model: string; questions: Record<string, unknown> },
//   creds: ReturnType<typeof resolveJevCredentials>
// ): Promise<{ ok: true; data: ...; latencyMs: number } | { ok: false; error: string; latencyMs: number; status?: number }>
// Returns 0 with the result in out, or 2 when the slot acquisition
// throws SaVmInputError (TS: the await sits before the try block,
// so the overload error propagates to the caller).
// DEFECT: async — Promise<Response>/fetch awaited synchronously;
// jev_http_post_json performs the whole request on the real
// sa_std HTTP client; jev_relay_executor_call is the registered
// host seam for the injected executor. AbortController/setTimeout become
// the timeoutMs argument; an abort surfaces as resp.timed_out.
// DEFECT: exceptions — the TS try/catch/finally becomes explicit
// status propagation + jev_release_slot on every exit path.
fn executeJevCall(state: &JevModuleState, payload: &JevPayload, creds: &JevCredentials, out: &JevCallResult) -> i32 {
    let startedAt = jev_now_ms();
    // Serialize upstream calls with a minimum start interval (see throttle above).
    let slot_rc = acquireJevSlot(state);
    if slot_rc != 0 {
        return slot_rc;
    };
    out.ok = false;
    out.data_len = 0;
    out.data_doc = 0;
    out.error_len = 0;
    out.has_status = false;
    out.status = 0;

    // ---- relay executor path ----
    if creds.apiKey.len == 0 && creds.providerId.len > 0 && state.has_relay_executor {
        let rp = JevRelayPayload { state_bytes: [0u8; 262144], state_len: 0, model_bytes: [0u8; 512], model_len: 0, questions_bytes: [0u8; 131072], questions_len: 0, providerId_bytes: [0u8; 512], providerId_len: 0, groupId_bytes: [0u8; 512], groupId_len: 0, has_groupId: false, bridgeProtocol_bytes: [0u8; 256], bridgeProtocol_len: 0, has_bridgeProtocol: false };
        // rp.state = payload.state; rp.model = payload.model; ...
        let i: u64 = 0;
        while i < payload.state.len && rp.state_len < 262144 {
            rp.state_bytes[rp.state_len] = payload.state.bytes[i];
            rp.state_len = rp.state_len + 1;
            i = i + 1;
        }
        let m: u64 = 0;
        while m < payload.model.len && rp.model_len < 512 {
            rp.model_bytes[rp.model_len] = payload.model.bytes[m];
            rp.model_len = rp.model_len + 1;
            m = m + 1;
        }
        let q: u64 = 0;
        while q < payload.questions.len && rp.questions_len < 131072 {
            rp.questions_bytes[rp.questions_len] = payload.questions.bytes[q];
            rp.questions_len = rp.questions_len + 1;
            q = q + 1;
        }
        // providerId: creds.providerId; groupId: creds.groupId || undefined;
        // bridgeProtocol: creds.bridgeProtocol || undefined; signal: controller.signal
        // (JevRelayPayload string fields are raw byte arrays, copied byte-wise.)
        rp.providerId_len = 0;
        let pi: u64 = 0;
        while pi < creds.providerId.len && rp.providerId_len < 512 {
            rp.providerId_bytes[rp.providerId_len] = creds.providerId.bytes[pi];
            rp.providerId_len = rp.providerId_len + 1;
            pi = pi + 1;
        }
        if creds.groupId.len > 0 {
            rp.has_groupId = true;
            let gi: u64 = 0;
            while gi < creds.groupId.len && rp.groupId_len < 512 {
                rp.groupId_bytes[rp.groupId_len] = creds.groupId.bytes[gi];
                rp.groupId_len = rp.groupId_len + 1;
                gi = gi + 1;
            }
        };
        if creds.bridgeProtocol.len > 0 {
            rp.has_bridgeProtocol = true;
            let bi: u64 = 0;
            while bi < creds.bridgeProtocol.len && rp.bridgeProtocol_len < 256 {
                rp.bridgeProtocol_bytes[rp.bridgeProtocol_len] = creds.bridgeProtocol.bytes[bi];
                rp.bridgeProtocol_len = rp.bridgeProtocol_len + 1;
                bi = bi + 1;
            }
        };
        let resp = JevHttpResponse { ok: false, status: 0, body_bytes: [0u8; 262144], body_len: 0, timed_out: false };
        let call_rc = jev_relay_executor_call(state.relay_executor_id, &rp, creds.timeoutMs, &resp);
        out.latencyMs = jev_now_ms() - startedAt;
        if call_rc != 0 {
            // The await threw: TS catch maps AbortError to the
            // timeout message, other errors to error.message.
            if resp.timed_out {
                let msg = ByteBuf { bytes: [0u8; 262144], len: 0 };
                buf_append_lit(&msg, STR_PTR("JEV upstream timed out after "), STR_LEN("JEV upstream timed out after "));
                buf_append_u64(&msg, creds.timeoutMs);
                buf_append_lit(&msg, STR_PTR("ms"), STR_LEN("ms"));
                call_set_error(out, buf_ptr(&msg), msg.len);
            } else {
                if resp.body_len > 0 {
                    call_set_error(out, response_body_ptr(&resp), resp.body_len);
                } else {
                    call_set_error(out, STR_PTR("JEV relay executor failed"), STR_LEN("JEV relay executor failed"));
                };
            };
            out.has_status = true;
            out.status = 502;
            jev_release_slot(state);
            return 0;
        };
        let doc: u64 = 0;
        let fallback = ByteBuf { bytes: [0u8; 262144], len: 0 };
        jev_parse_response_text(response_body_ptr(&resp), resp.body_len, &doc, &fallback);
        if !resp.ok {
            let err = ByteBuf { bytes: [0u8; 262144], len: 0 };
            if !jev_parsed_error(doc, &err) {
                buf_reset(&err);
                buf_append_lit(&err, STR_PTR("Relay upstream failed ("), STR_LEN("Relay upstream failed ("));
                buf_append_i64(&err, resp.status as i64);
                buf_append_lit(&err, STR_PTR(")"), STR_LEN(")"));
            };
            call_set_error(out, buf_ptr(&err), err.len);
            out.has_status = true;
            out.status = resp.status;
            jev_release_slot(state);
            return 0;
        };
        // const data = (parsed as { data?: ... })?.data || (parsed as ...);
        let data_node: u64 = 0;
        let has_data = false;
        if doc != 0 {
            let dn: u64 = 0;
            if sa_json_object_get(doc, STR_PTR("data"), STR_LEN("data"), &dn) == 0 {
                // TS `||` also skips falsy data (null/0/""/false);
                // approximated by skipping JSON null only.
                if jev_json_kind(dn) != 0 {
                    data_node = dn;
                    has_data = true;
                };
            };
        };
        if has_data {
            let dp: ptr = PTR_NULL();
            let dl: u64 = 0;
            jev_json_text(data_node, &dp, &dl);
            call_set_data(out, dp, dl);
        } else {
            if doc != 0 {
                call_set_data(out, response_body_ptr(&resp), resp.body_len);
            } else {
                if fallback.len > 0 {
                    call_set_data(out, buf_ptr(&fallback), fallback.len);
                } else {
                    call_set_data(out, STR_PTR("null"), STR_LEN("null"));
                };
            };
        };
        out.ok = true;
        jev_release_slot(state);
        return 0;
    };

    // ---- no credentials at all ----
    if creds.apiKey.len == 0 {
        out.latencyMs = jev_now_ms() - startedAt;
        call_set_error(out, STR_PTR("JEV is not configured. Please set JEV_API_KEY in environment or configure JEV in settings."), STR_LEN("JEV is not configured. Please set JEV_API_KEY in environment or configure JEV in settings."));
        out.has_status = true;
        out.status = 401;
        jev_release_slot(state);
        return 0;
    };

    // ---- direct upstream fetch ----
    // Cloudflare-hosted JEV (clef series): POST {base}/@cf/cloudflare/{model}
    // with a bare body model name. JEV official: POST base directly.
    let cloudflareUpstream = isCloudflareJevUpstream(js_ptr(&creds.baseUrl), creds.baseUrl.len);
    let effectiveModel = JevStr { bytes: [0u8; 8192], len: 0 };
    if cloudflareUpstream {
        let tmp = ByteBuf { bytes: [0u8; 262144], len: 0 };
        resolveCloudflareJevModel(js_ptr(&payload.model), payload.model.len, &tmp);
        js_set_buf(&effectiveModel, &tmp);
    } else {
        js_set(&effectiveModel, js_ptr(&payload.model), payload.model.len);
    };
    let requestUrl = ByteBuf { bytes: [0u8; 262144], len: 0 };
    if cloudflareUpstream {
        buildCloudflareJevRequestUrl(js_ptr(&creds.baseUrl), creds.baseUrl.len, js_ptr(&effectiveModel), effectiveModel.len, &requestUrl);
    } else {
        buf_append(&requestUrl, js_ptr(&creds.baseUrl), creds.baseUrl.len);
    };
    // const requestBody = cloudflareUpstream ? { state, model: cloudflareJevBodyModel(effectiveModel), questions: padCloudflareJevQuestions(payload.questions) } : payload;
    let requestBody = ByteBuf { bytes: [0u8; 262144], len: 0 };
    buf_append_lit(&requestBody, STR_PTR("{\"state\":"), STR_LEN("{\"state\":"));
    buf_append_json_str(&requestBody, buf_ptr(&payload.state), payload.state.len);
    buf_append_lit(&requestBody, STR_PTR(",\"model\":"), STR_LEN(",\"model\":"));
    if cloudflareUpstream {
        let bodyModel = ByteBuf { bytes: [0u8; 262144], len: 0 };
        cloudflareJevBodyModel(js_ptr(&effectiveModel), effectiveModel.len, &bodyModel);
        buf_append_json_str(&requestBody, buf_ptr(&bodyModel), bodyModel.len);
    } else {
        buf_append_json_str(&requestBody, js_ptr(&payload.model), payload.model.len);
    };
    buf_append_lit(&requestBody, STR_PTR(",\"questions\":"), STR_LEN(",\"questions\":"));
    if cloudflareUpstream {
        let padded = ByteBuf { bytes: [0u8; 262144], len: 0 };
        padCloudflareJevQuestions(buf_ptr(&payload.questions), payload.questions.len, &padded);
        buf_append_buf(&requestBody, &padded);
    } else {
        buf_append_buf(&requestBody, &payload.questions);
    };
    buf_append_lit(&requestBody, STR_PTR("}"), STR_LEN("}"));
    // fetch(requestUrl, { method: "POST", headers: { Authorization: `Bearer ${creds.apiKey}`, "Content-Type": "application/json" }, body: JSON.stringify(requestBody), signal: controller.signal })
    let auth = ByteBuf { bytes: [0u8; 262144], len: 0 };
    buf_append_lit(&auth, STR_PTR("Bearer "), STR_LEN("Bearer "));
    buf_append(&auth, js_ptr(&creds.apiKey), creds.apiKey.len);
    let resp2 = JevHttpResponse { ok: false, status: 0, body_bytes: [0u8; 262144], body_len: 0, timed_out: false };
    let fetch_rc = jev_http_post_json(buf_ptr(&requestUrl), requestUrl.len, buf_ptr(&auth), auth.len, buf_ptr(&requestBody), requestBody.len, creds.timeoutMs, &resp2);
    out.latencyMs = jev_now_ms() - startedAt;
    if fetch_rc != 0 {
        // TS catch: AbortError -> timeout message; else error.message.
        if resp2.timed_out {
            let msg = ByteBuf { bytes: [0u8; 262144], len: 0 };
            buf_append_lit(&msg, STR_PTR("JEV upstream timed out after "), STR_LEN("JEV upstream timed out after "));
            buf_append_u64(&msg, creds.timeoutMs);
            buf_append_lit(&msg, STR_PTR("ms"), STR_LEN("ms"));
            call_set_error(out, buf_ptr(&msg), msg.len);
        } else {
            if resp2.body_len > 0 {
                call_set_error(out, response_body_ptr(&resp2), resp2.body_len);
            } else {
                call_set_error(out, STR_PTR("JEV upstream request failed"), STR_LEN("JEV upstream request failed"));
            };
        };
        out.has_status = true;
        out.status = 502;
        jev_release_slot(state);
        return 0;
    };
    let doc2: u64 = 0;
    let fallback2 = ByteBuf { bytes: [0u8; 262144], len: 0 };
    jev_parse_response_text(response_body_ptr(&resp2), resp2.body_len, &doc2, &fallback2);
    if !resp2.ok {
        let err = ByteBuf { bytes: [0u8; 262144], len: 0 };
        if !jev_parsed_error(doc2, &err) {
            buf_reset(&err);
            buf_append_lit(&err, STR_PTR("JEV upstream returned "), STR_LEN("JEV upstream returned "));
            buf_append_i64(&err, resp2.status as i64);
        };
        call_set_error(out, buf_ptr(&err), err.len);
        out.has_status = true;
        out.status = resp2.status;
        jev_release_slot(state);
        return 0;
    };
    // const data = unwrapJevUpstreamPayload(parsed);
    if doc2 != 0 {
        let inner = unwrapJevUpstreamPayload(doc2);
        let dp: ptr = PTR_NULL();
        let dl: u64 = 0;
        jev_json_text(inner, &dp, &dl);
        call_set_data(out, dp, dl);
    } else {
        if fallback2.len > 0 {
            // parsed was { raw: text }; unwrap returns it as root.
            call_set_data(out, buf_ptr(&fallback2), fallback2.len);
        } else {
            call_set_data(out, STR_PTR("null"), STR_LEN("null"));
        };
    };
    out.ok = true;
    // finally { clearTimeout(timeout); releaseSlot(); }
    jev_release_slot(state);
    return 0;
}

// ---- answer access helpers (scaffolding for the native fns) ----

// rootData.answers node; false when absent / not an object.
fn jev_answers_node(data_doc: u64, out_node: &u64) -> bool {
    if data_doc == 0 { return false; };
    let n: u64 = 0;
    if sa_json_object_get(data_doc, STR_PTR("answers"), STR_LEN("answers"), &n) != 0 { return false; };
    if jev_json_kind(n) != 3 { return false; };
    *out_node = n;
    return true;
}

// answers[qid] node.
fn jev_answer_node(data_doc: u64, qid_ptr: ptr, qid_len: u64, out_node: &u64) -> bool {
    let answers: u64 = 0;
    if !jev_answers_node(data_doc, &answers) { return false; };
    return sa_json_object_get(answers, qid_ptr, qid_len, out_node) == 0;
}

// answers[qid].choice as a trimmed string ("" when not a string).
fn jev_answer_choice(data_doc: u64, qid_ptr: ptr, qid_len: u64, out: &ByteBuf) -> void {
    buf_reset(out);
    let ans: u64 = 0;
    if !jev_answer_node(data_doc, qid_ptr, qid_len, &ans) { return; };
    let c: u64 = 0;
    if sa_json_object_get(ans, STR_PTR("choice"), STR_LEN("choice"), &c) != 0 { return; };
    if jev_json_kind(c) != 1 { return; };
    let p: ptr = PTR_NULL();
    let n: u64 = 0;
    jev_json_string(c, &p, &n);
    str_trim_into(out, p, n);
}

// answers[qid].confidence when a finite number, else 1.0 (the TS
// `typeof === "number" && Number.isFinite(...) ? ... : 1.0` shape).
fn jev_answer_confidence(data_doc: u64, qid_ptr: ptr, qid_len: u64) -> f64 {
    let ans: u64 = 0;
    if !jev_answer_node(data_doc, qid_ptr, qid_len, &ans) { return 1.0; };
    let c: u64 = 0;
    if sa_json_object_get(ans, STR_PTR("confidence"), STR_LEN("confidence"), &c) != 0 { return 1.0; };
    if jev_json_kind(c) != 4 { return 1.0; };
    let v: f64 = 0.0;
    if jev_json_number(c, &v) != 0 { return 1.0; };
    return v;
}

// Math.round(confidence * 100) for the summary percentages.
fn jev_percent(confidence: f64) -> u64 {
    if confidence <= 0.0 { return 0; };
    return (confidence * 100.0 + 0.5) as u64;
}

// Append a StringMap as a JSON object {"k":"v",...}.
fn buf_append_map_json(out: &ByteBuf, m: &StringMap) -> void {
    buf_append_lit(out, STR_PTR("{"), STR_LEN("{"));
    let i: u64 = 0;
    for i in 0..m.len {
        if i > 0 {
            buf_append_lit(out, STR_PTR(","), STR_LEN(","));
        };
        buf_append_json_str(out, stringmap_key_ptr(m, i), m.key_len[i]);
        buf_append_lit(out, STR_PTR(":"), STR_LEN(":"));
        buf_append_json_str(out, stringmap_val_ptr(m, i), m.val_len[i]);
    }
    buf_append_lit(out, STR_PTR("}"), STR_LEN("}"));
}

// Append one question entry: "qid":{"type":...,"instructions":...,"criteria":<json>}
// (leading comma emitted by the caller when not first).
fn buf_append_question(out: &ByteBuf, qid_ptr: ptr, qid_len: u64, type_ptr: ptr, type_len: u64, instructions: &ByteBuf, criteria_json_ptr: ptr, criteria_json_len: u64) -> void {
    buf_append_json_str(out, qid_ptr, qid_len);
    buf_append_lit(out, STR_PTR(":{\"type\":"), STR_LEN(":{\"type\":"));
    buf_append_json_str(out, type_ptr, type_len);
    buf_append_lit(out, STR_PTR(",\"instructions\":"), STR_LEN(",\"instructions\":"));
    buf_append_json_str(out, buf_ptr(instructions), instructions.len);
    buf_append_lit(out, STR_PTR(",\"criteria\":"), STR_LEN(",\"criteria\":"));
    buf_append(out, criteria_json_ptr, criteria_json_len);
    buf_append_lit(out, STR_PTR("}"), STR_LEN("}"));
}

// Build a JevPayload from state text + creds + questions JSON.
fn jev_make_payload(state_text: &ByteBuf, creds: &JevCredentials, questions: &ByteBuf, out: &JevPayload) -> void {
    buf_reset(&out.state);
    buf_append_buf(&out.state, state_text);
    js_set(&out.model, js_ptr(&creds.model), creds.model.len);
    buf_reset(&out.questions);
    buf_append_buf(&out.questions, questions);
}

// Rebuild the acquireJevSlot overload SaVmInputError message (the
// throw crosses executeJevCall as return code 2; see there).
fn jev_overload_error(state: &JevModuleState, result: &JevRunResult) -> i32 {
    let msg = ByteBuf { bytes: [0u8; 262144], len: 0 };
    buf_append_lit(&msg, STR_PTR("JEV overloaded: "), STR_LEN("JEV overloaded: "));
    buf_append_u64(&msg, state.jevWaiting);
    buf_append_lit(&msg, STR_PTR(" calls already queued/in-flight (max "), STR_LEN(" calls already queued/in-flight (max "));
    buf_append_u64(&msg, resolveJevMaxQueue(state));
    buf_append_lit(&msg, STR_PTR("); retry later."), STR_LEN("); retry later."));
    return jev_input_error_buf(result, &msg);
}

// ---- regression cases (sdk-backend unit) ----
// TS: import { loadRegressionCases } from "@cxu/sdk-backend";
// TS: export interface RegressionCase (sdk-backend) — used fields:
// id, title, component. The case list is kept as a JSON array text.
// DEFECT: cross-unit dependency — loadRegressionCases is
// implemented in the sdk-backend unit. The conversion's invented
// extern for it was never bindable across the unit boundary; the
// local fn below is a registered HOST SEAM (see FIX_JEV) that
// returns the empty list until the host wires the sdk loader in.
// Its first TS argument is the `undefined` filter (always
// undefined at this unit's call sites).
struct RegressionCaseList {
    json_bytes: [u8; 262144],
    json_len: u64,
    len: u64,
}

fn loadRegressionCases(out: &RegressionCaseList, cwd_ptr: ptr, cwd_len: u64, has_cwd: bool) -> void {
    // HOST SEAM (registered, FIX_JEV): the sdk-backend unit owns the
    // real loader (sdk-backend/src/regressionCases.sla), but its
    // RegressionCaseSet representation ([RegressionCase; 256] of
    // ~64 KiB raw-JSON cases) cannot be adapted into this unit's
    // JSON-text RegressionCaseList across the @import boundary, and
    // the vendor copy must stay identical to this provider copy.
    // Until the host wires this seam, the loader returns the empty
    // case list explicitly (the same result TS produces for a
    // missing cases directory); replay-case callers observe len 0.
    // This is a documented seam, not a silent stub.
    out.len = 0;
    out.json_len = 0;
}

fn regression_case_field(list: &RegressionCaseList, idx: u64, field_ptr: ptr, field_len: u64, out: &ByteBuf) -> bool {
    buf_reset(out);
    let p: ptr = PTR_NULL();
    PTR_BYTE_ADD(p, &list.json_bytes, 0);
    let doc = sa_json_parse(p, list.json_len);
    if doc == 0 { return false; };
    let item: u64 = 0;
    if sa_json_array_get(doc, idx, &item) != 0 { return false; };
    let node: u64 = 0;
    if sa_json_object_get(item, field_ptr, field_len, &node) != 0 { return false; };
    if jev_json_kind(node) != 1 { return false; };
    let sp: ptr = PTR_NULL();
    let sn: u64 = 0;
    jev_json_string(node, &sp, &sn);
    buf_append(out, sp, sn);
    return true;
}

// Named-field accessors for JevRunInput struct fields.
// field: 0 question, 1 context, 2 content, 3 patch (strings);
// 4 options, 5 criteria, 6 checks (JSON values with kind tags).
fn input_str_field(input: &JevRunInput, field: u64, out: &ByteBuf) -> bool {
    buf_reset(out);
    let p: ptr = PTR_NULL();
    if field == 0 {
        if !input.has_question { return false; };
        PTR_BYTE_ADD(p, &input.question_bytes, 0);
        buf_append(out, p, input.question_len);
        return true;
    };
    if field == 1 {
        if !input.has_context { return false; };
        PTR_BYTE_ADD(p, &input.context_bytes, 0);
        buf_append(out, p, input.context_len);
        return true;
    };
    if field == 2 {
        if !input.has_content { return false; };
        PTR_BYTE_ADD(p, &input.content_bytes, 0);
        buf_append(out, p, input.content_len);
        return true;
    };
    if !input.has_patch { return false; };
    PTR_BYTE_ADD(p, &input.patch_bytes, 0);
    buf_append(out, p, input.patch_len);
    return true;
}

fn input_json_field(input: &JevRunInput, field: u64, out: &ByteBuf, out_kind: &u64) -> bool {
    buf_reset(out);
    *out_kind = 0;
    let p: ptr = PTR_NULL();
    if field == 4 {
        if !input.has_options { return false; };
        PTR_BYTE_ADD(p, &input.options_bytes, 0);
        buf_append(out, p, input.options_len);
        *out_kind = input.options_kind;
        return true;
    };
    if field == 5 {
        if !input.has_criteria { return false; };
        PTR_BYTE_ADD(p, &input.criteria_bytes, 0);
        buf_append(out, p, input.criteria_len);
        *out_kind = input.criteria_kind;
        return true;
    };
    if !input.has_checks { return false; };
    PTR_BYTE_ADD(p, &input.checks_bytes, 0);
    buf_append(out, p, input.checks_len);
    *out_kind = input.checks_kind;
    return true;
}

// Truncate a StringMap to at most `max` entries, deleting the keys
// past the cap one by one (the TS `for (const k of keys.slice(N)) delete map[k]` loops).
fn jev_map_truncate(m: &StringMap, max: u64) -> void {
    while m.len > max {
        let k = ByteBuf { bytes: [0u8; 262144], len: 0 };
        stringmap_key_at(m, max, &k);
        stringmap_delete(m, buf_ptr(&k), k.len);
    }
}

// ---- native jev_* actions ----
// All nativeJev* fns share the TS signature shape:
// async function nativeJevX(rawInput: JevRunInput,
// _policy?: JevPolicyConfig, _cwd?: string,
// startedAt: number = Date.now()): Promise<JevRunResult>
// DEFECT: async — converted to synchronous fns returning 0 when a
// result was produced (out filled), 2 when TS throws
// SaVmInputError (message in out.stderr). The module state is an
// extra first parameter (see JevModuleState). _policy/_cwd are
// unused in TS as well.

//*
//* Autonomous Single-Choice evaluation (分叉单选).
//* Evaluates 2~8 options against the given question and context.
//
// TS: export async function nativeJevChoose(...): Promise<JevRunResult>
// DEFECT: async
fn nativeJevChoose(state: &JevModuleState, rawInput: &JevRunInput, policy: &JevPolicyConfig, cwd_ptr: ptr, cwd_len: u64, startedAt: u64, out: &JevRunResult) -> i32 {
// const question = (rawInput.question || (cast).query || (cast).prompt || "").toString().trim();
let q_raw = ByteBuf { bytes: [0u8; 262144], len: 0};
if!input_str_field(rawInput, 0, &q_raw) || q_raw.len == 0 {
if!input_dyn_str(rawInput, STR_PTR("query"), STR_LEN("query"), &q_raw) || q_raw.len == 0 {
input_dyn_str(rawInput, STR_PTR("prompt"), STR_LEN("prompt"), &q_raw);
};
};
let question = ByteBuf { bytes: [0u8; 262144], len: 0};
str_trim_into(&question, buf_ptr(&q_raw), q_raw.len);
if question.len == 0 {
return jev_input_error(out, STR_PTR("action 'jev_choose' requires a non-empty 'question' parameter"), STR_LEN("action 'jev_choose' requires a non-empty 'question' parameter"));
};
// const rawOptions = rawInput.options?? rawInput.criteria?? (cast).choices;
let raw_opts = ByteBuf { bytes: [0u8; 262144], len: 0};
let raw_kind: u64 = 0;
if!input_json_field(rawInput, 4, &raw_opts, &raw_kind) {
if!input_json_field(rawInput, 5, &raw_opts, &raw_kind) {
input_dyn_json(rawInput, STR_PTR("choices"), STR_LEN("choices"), &raw_opts, &raw_kind);
};
};
let options = StringMap { key_off: [0u64; 64], key_len: [0u64; 64], val_off: [0u64; 64], val_len: [0u64; 64], keys_bytes: [0u8; 8192], keys_len: 0, vals_bytes: [0u8; 65536], vals_len: 0, len: 0};
normalizeChoiceOptions(buf_ptr(&raw_opts), raw_opts.len, raw_kind, &options);
if options.len < 2 {
let msg = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&msg, STR_PTR("action 'jev_choose' requires at least 2 options (received "), STR_LEN("action 'jev_choose' requires at least 2 options (received "));
buf_append_u64(&msg, options.len);
buf_append_lit(&msg, STR_PTR(")"), STR_LEN(")"));
return jev_input_error_buf(out, &msg);
};
if options.len > 8 {
// Truncate to first 8 options
jev_map_truncate(&options, 8);
};
// const context = truncateJevContext(rawInput.context?? rawInput.content?? (cast).state);
let ctx_kind: u64 = 0;
let ctx_raw = ByteBuf { bytes: [0u8; 262144], len: 0};
jev_pick_context(rawInput, &ctx_kind, &ctx_raw);
let context = ByteBuf { bytes: [0u8; 262144], len: 0};
truncateJevContext(buf_ptr(&ctx_raw), ctx_raw.len, ctx_kind, &context);
let creds = JevCredentials { baseUrl: JevStr { bytes: [0u8; 8192], len: 0}, apiKey: JevStr { bytes: [0u8; 8192], len: 0}, model: JevStr { bytes: [0u8; 8192], len: 0}, providerId: JevStr { bytes: [0u8; 8192], len: 0}, groupId: JevStr { bytes: [0u8; 8192], len: 0}, bridgeProtocol: JevStr { bytes: [0u8; 8192], len: 0}, timeoutMs: 0};
resolveJevCredentials(state, rawInput, &creds);
// const payload = { state: `[Question Context]\n${context}\n\n[Decision Question]\n${question}`, model: creds.model, questions: { decision: { type: "choice", instructions: question, criteria: options}}};
let state_text = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&state_text, STR_PTR("[Question Context]\n"), STR_LEN("[Question Context]\n"));
buf_append_buf(&state_text, &context);
buf_append_lit(&state_text, STR_PTR("\n\n[Decision Question]\n"), STR_LEN("\n\n[Decision Question]\n"));
buf_append_buf(&state_text, &question);
let crit_json = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_map_json(&crit_json, &options);
let questions = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&questions, STR_PTR("{"), STR_LEN("{"));
buf_append_question(&questions, STR_PTR("decision"), STR_LEN("decision"), STR_PTR("choice"), STR_LEN("choice"), &question, buf_ptr(&crit_json), crit_json.len);
buf_append_lit(&questions, STR_PTR("}"), STR_LEN("}"));
let payload = JevPayload { state: ByteBuf { bytes: [0u8; 262144], len: 0}, model: JevStr { bytes: [0u8; 8192], len: 0}, questions: ByteBuf { bytes: [0u8; 262144], len: 0}};
jev_make_payload(&state_text, &creds, &questions, &payload);
let call = JevCallResult { ok: false, data_doc: 0, data_bytes: [0u8; 262144], data_len: 0, latencyMs: 0, has_status: false, status: 0, error_bytes: [0u8; 16384], error_len: 0};
let rc = executeJevCall(state, &payload, &creds, &call);
if rc == 2 { return jev_overload_error(state, out);};
if!call.ok {
let err = ByteBuf { bytes: [0u8; 262144], len: 0};
call_error_into(&call, &err);
let stderr = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&stderr, STR_PTR("JEV evaluate failed ("), STR_LEN("JEV evaluate failed ("));
if call.has_status {
buf_append_i64(&stderr, call.status as i64);
} else {
buf_append_lit(&stderr, STR_PTR("502"), STR_LEN("502"));
};
buf_append_lit(&stderr, STR_PTR("): "), STR_LEN("): "));
buf_append_buf(&stderr, &err);
jev_fill_failure(out, call.has_status, call.status, buf_ptr(&err), err.len, &stderr, true, startedAt);
return 0;
};
// const answers = (rootData.answers?? {})...; const decisionAnswer = answers.decision?? {};
let chosenKey = ByteBuf { bytes: [0u8; 262144], len: 0};
jev_answer_choice(call.data_doc, STR_PTR("decision"), STR_LEN("decision"), &chosenKey);
let confidence = jev_answer_confidence(call.data_doc, STR_PTR("decision"), STR_LEN("decision"));
// const chosenDesc = options[chosenKey] || options[chosenKey.toLowerCase()] || chosenKey;
let chosenDesc = ByteBuf { bytes: [0u8; 262144], len: 0};
if!stringmap_get(&options, buf_ptr(&chosenKey), chosenKey.len, &chosenDesc) || chosenDesc.len == 0 {
let lower = ByteBuf { bytes: [0u8; 262144], len: 0};
str_lower_into(&lower, buf_ptr(&chosenKey), chosenKey.len);
if!stringmap_get(&options, buf_ptr(&lower), lower.len, &chosenDesc) || chosenDesc.len == 0 {
buf_copy_into(&chosenDesc, &chosenKey);
};
};
let summary = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&summary, STR_PTR("\n• 推荐方案：["), STR_LEN("\n• 推荐方案：["));
buf_append_buf(&summary, &chosenKey);
buf_append_lit(&summary, STR_PTR("]（置信度 "), STR_LEN("]（置信度 "));
buf_append_u64(&summary, jev_percent(confidence));
buf_append_lit(&summary, STR_PTR("%）\n• 方案描述："), STR_LEN("%）\n• 方案描述："));
buf_append_buf(&summary, &chosenDesc);
buf_append_lit(&summary, STR_PTR("\n• 耗时："), STR_LEN("\n• 耗时："));
buf_append_u64(&summary, call.latencyMs);
buf_append_lit(&summary, STR_PTR("ms · 模型："), STR_LEN("ms · 模型："));
buf_append(&summary, js_ptr(&creds.model), creds.model.len);
// const outputObject = { action: "jev_choose", question, choice: chosenKey, confidence, description: chosenDesc, all_options: options, summary, latencyMs: callResult.latencyMs, raw: rootData};
let stdout = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&stdout, STR_PTR("{\"action\":\"jev_choose\",\"question\":"), STR_LEN("{\"action\":\"jev_choose\",\"question\":"));
buf_append_json_str(&stdout, buf_ptr(&question), question.len);
buf_append_lit(&stdout, STR_PTR(",\"choice\":"), STR_LEN(",\"choice\":"));
buf_append_json_str(&stdout, buf_ptr(&chosenKey), chosenKey.len);
buf_append_lit(&stdout, STR_PTR(",\"confidence\":"), STR_LEN(",\"confidence\":"));
buf_append_f64(&stdout, confidence);
buf_append_lit(&stdout, STR_PTR(",\"description\":"), STR_LEN(",\"description\":"));
buf_append_json_str(&stdout, buf_ptr(&chosenDesc), chosenDesc.len);
buf_append_lit(&stdout, STR_PTR(",\"all_options\":"), STR_LEN(",\"all_options\":"));
buf_append_map_json(&stdout, &options);
buf_append_lit(&stdout, STR_PTR(",\"summary\":"), STR_LEN(",\"summary\":"));
buf_append_json_str(&stdout, buf_ptr(&summary), summary.len);
buf_append_lit(&stdout, STR_PTR(",\"latencyMs\":"), STR_LEN(",\"latencyMs\":"));
buf_append_u64(&stdout, call.latencyMs);
buf_append_lit(&stdout, STR_PTR(",\"raw\":"), STR_LEN(",\"raw\":"));
buf_append(&stdout, call_data_ptr(&call), call.data_len);
buf_append_lit(&stdout, STR_PTR("}"), STR_LEN("}"));
jev_fill_success(out, &stdout, startedAt);
return 0;
}

//*
//* Autonomous Multi-Choice Checklist evaluation (交付多选自检).
//* Concurrently evaluates 1~8 checklist criteria against the context.
//
// TS: export async function nativeJevChecklist(...): Promise<JevRunResult>
// DEFECT: async
fn nativeJevChecklist(state: &JevModuleState, rawInput: &JevRunInput, policy: &JevPolicyConfig, cwd_ptr: ptr, cwd_len: u64, startedAt: u64, out: &JevRunResult) -> i32 {
// const rawChecks = rawInput.checks?? rawInput.options?? rawInput.criteria;
let raw_checks = ByteBuf { bytes: [0u8; 262144], len: 0};
let raw_kind: u64 = 0;
if!input_json_field(rawInput, 6, &raw_checks, &raw_kind) {
if!input_json_field(rawInput, 4, &raw_checks, &raw_kind) {
input_json_field(rawInput, 5, &raw_checks, &raw_kind);
};
};
let checks = StringMap { key_off: [0u64; 64], key_len: [0u64; 64], val_off: [0u64; 64], val_len: [0u64; 64], keys_bytes: [0u8; 8192], keys_len: 0, vals_bytes: [0u8; 65536], vals_len: 0, len: 0};
normalizeChecklistItems(buf_ptr(&raw_checks), raw_checks.len, raw_kind, &checks);
if checks.len < 1 {
return jev_input_error(out, STR_PTR("action 'jev_checklist' requires at least 1 check item in 'checks'"), STR_LEN("action 'jev_checklist' requires at least 1 check item in 'checks'"));
};
if checks.len > 8 {
jev_map_truncate(&checks, 8);
};
let ctx_kind: u64 = 0;
let ctx_raw = ByteBuf { bytes: [0u8; 262144], len: 0};
jev_pick_context(rawInput, &ctx_kind, &ctx_raw);
let context = ByteBuf { bytes: [0u8; 262144], len: 0};
truncateJevContext(buf_ptr(&ctx_raw), ctx_raw.len, ctx_kind, &context);
let creds = JevCredentials { baseUrl: JevStr { bytes: [0u8; 8192], len: 0}, apiKey: JevStr { bytes: [0u8; 8192], len: 0}, model: JevStr { bytes: [0u8; 8192], len: 0}, providerId: JevStr { bytes: [0u8; 8192], len: 0}, groupId: JevStr { bytes: [0u8; 8192], len: 0}, bridgeProtocol: JevStr { bytes: [0u8; 8192], len: 0}, timeoutMs: 0};
resolveJevCredentials(state, rawInput, &creds);
// const questions: Record<string, unknown> = {};
// for (const [key, desc] of Object.entries(checks)) { questions[key] = { type: "choice", instructions: `Does the provided code/context satisfy this requirement: ${desc}?`, criteria: { pass: `Yes, satisfied: ${desc}`, fail: `No, not satisfied or violated: ${desc}`}};}
let questions = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&questions, STR_PTR("{"), STR_LEN("{"));
let qi: u64 = 0;
for qi in 0..checks.len {
if qi > 0 {
buf_append_lit(&questions, STR_PTR(","), STR_LEN(","));
};
let desc = ByteBuf { bytes: [0u8; 262144], len: 0};
stringmap_val_at(&checks, qi, &desc);
let instr = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&instr, STR_PTR("Does the provided code/context satisfy this requirement: "), STR_LEN("Does the provided code/context satisfy this requirement: "));
buf_append_buf(&instr, &desc);
buf_append_lit(&instr, STR_PTR("?"), STR_LEN("?"));
let crit = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&crit, STR_PTR("{\"pass\":"), STR_LEN("{\"pass\":"));
let pass_text = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&pass_text, STR_PTR("Yes, satisfied: "), STR_LEN("Yes, satisfied: "));
buf_append_buf(&pass_text, &desc);
buf_append_json_str(&crit, buf_ptr(&pass_text), pass_text.len);
buf_append_lit(&crit, STR_PTR(",\"fail\":"), STR_LEN(",\"fail\":"));
let fail_text = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&fail_text, STR_PTR("No, not satisfied or violated: "), STR_LEN("No, not satisfied or violated: "));
buf_append_buf(&fail_text, &desc);
buf_append_json_str(&crit, buf_ptr(&fail_text), fail_text.len);
buf_append_lit(&crit, STR_PTR("}"), STR_LEN("}"));
buf_append_question(&questions, stringmap_key_ptr(&checks, qi), checks.key_len[qi], STR_PTR("choice"), STR_LEN("choice"), &instr, buf_ptr(&crit), crit.len);
}
buf_append_lit(&questions, STR_PTR("}"), STR_LEN("}"));
let state_text = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&state_text, STR_PTR("[Context to Verify]\n"), STR_LEN("[Context to Verify]\n"));
buf_append_buf(&state_text, &context);
let payload = JevPayload { state: ByteBuf { bytes: [0u8; 262144], len: 0}, model: JevStr { bytes: [0u8; 8192], len: 0}, questions: ByteBuf { bytes: [0u8; 262144], len: 0}};
jev_make_payload(&state_text, &creds, &questions, &payload);
let call = JevCallResult { ok: false, data_doc: 0, data_bytes: [0u8; 262144], data_len: 0, latencyMs: 0, has_status: false, status: 0, error_bytes: [0u8; 16384], error_len: 0};
let rc = executeJevCall(state, &payload, &creds, &call);
if rc == 2 { return jev_overload_error(state, out);};
if!call.ok {
let err = ByteBuf { bytes: [0u8; 262144], len: 0};
call_error_into(&call, &err);
let stderr = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&stderr, STR_PTR("JEV checklist failed ("), STR_LEN("JEV checklist failed ("));
if call.has_status {
buf_append_i64(&stderr, call.status as i64);
} else {
buf_append_lit(&stderr, STR_PTR("502"), STR_LEN("502"));
};
buf_append_lit(&stderr, STR_PTR("): "), STR_LEN("): "));
buf_append_buf(&stderr, &err);
jev_fill_failure(out, call.has_status, call.status, buf_ptr(&err), err.len, &stderr, true, startedAt);
return 0;
};
// const checkResults: Record<string, { passed; confidence; choice; description}> = {};
// Built directly as JSON text, in checks order.
let results_json = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&results_json, STR_PTR("{"), STR_LEN("{"));
let passedCount: u64 = 0;
let totalCount = checks.len;
// Summary item lines are collected alongside (same order).
let item_lines = ByteBuf { bytes: [0u8; 262144], len: 0};
let ci: u64 = 0;
for ci in 0..checks.len {
let key = ByteBuf { bytes: [0u8; 262144], len: 0};
stringmap_key_at(&checks, ci, &key);
let desc = ByteBuf { bytes: [0u8; 262144], len: 0};
stringmap_val_at(&checks, ci, &desc);
// const choice = typeof ans.choice === "string"? ans.choice.trim().toLowerCase(): "";
let choice_raw = ByteBuf { bytes: [0u8; 262144], len: 0};
jev_answer_choice(call.data_doc, buf_ptr(&key), key.len, &choice_raw);
let choice = ByteBuf { bytes: [0u8; 262144], len: 0};
str_lower_into(&choice, buf_ptr(&choice_raw), choice_raw.len);
let confidence = jev_answer_confidence(call.data_doc, buf_ptr(&key), key.len);
let passed = jev_str_eq(buf_ptr(&choice), choice.len, STR_PTR("pass"), STR_LEN("pass"));
if passed { passedCount = passedCount + 1;};
if ci > 0 {
buf_append_lit(&results_json, STR_PTR(","), STR_LEN(","));
};
buf_append_json_str(&results_json, buf_ptr(&key), key.len);
buf_append_lit(&results_json, STR_PTR(":{\"passed\":"), STR_LEN(":{\"passed\":"));
if passed {
buf_append_lit(&results_json, STR_PTR("true"), STR_LEN("true"));
} else {
buf_append_lit(&results_json, STR_PTR("false"), STR_LEN("false"));
};
buf_append_lit(&results_json, STR_PTR(",\"confidence\":"), STR_LEN(",\"confidence\":"));
buf_append_f64(&results_json, confidence);
buf_append_lit(&results_json, STR_PTR(",\"choice\":"), STR_LEN(",\"choice\":"));
buf_append_json_str(&results_json, buf_ptr(&choice), choice.len);
buf_append_lit(&results_json, STR_PTR(",\"description\":"), STR_LEN(",\"description\":"));
buf_append_json_str(&results_json, buf_ptr(&desc), desc.len);
buf_append_lit(&results_json, STR_PTR("}"), STR_LEN("}"));
// summaryLines.push(` - [${key}] ${icon} (${conf}%): ${item.description}`);
buf_append_lit(&item_lines, STR_PTR("\n - ["), STR_LEN("\n - ["));
buf_append_buf(&item_lines, &key);
buf_append_lit(&item_lines, STR_PTR("] "), STR_LEN("] "));
if passed {
buf_append_lit(&item_lines, STR_PTR("✅ 通过"), STR_LEN("✅ 通过"));
} else {
buf_append_lit(&item_lines, STR_PTR("❌ 未通过"), STR_LEN("❌ 未通过"));
};
buf_append_lit(&item_lines, STR_PTR(" ("), STR_LEN(" ("));
buf_append_u64(&item_lines, jev_percent(confidence));
buf_append_lit(&item_lines, STR_PTR("%): "), STR_LEN("%): "));
buf_append_buf(&item_lines, &desc);
}
buf_append_lit(&results_json, STR_PTR("}"), STR_LEN("}"));
let allPassed = passedCount == totalCount;
let summary = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&summary, STR_PTR("\n• 总体判定："), STR_LEN("\n• 总体判定："));
if allPassed {
buf_append_lit(&summary, STR_PTR("✅ 全部通过"), STR_LEN("✅ 全部通过"));
} else {
buf_append_lit(&summary, STR_PTR("⚠️ "), STR_LEN("⚠️ "));
buf_append_u64(&summary, totalCount - passedCount);
buf_append_lit(&summary, STR_PTR(" 项未通过"), STR_LEN(" 项未通过"));
};
buf_append_lit(&summary, STR_PTR(" ("), STR_LEN(" ("));
buf_append_u64(&summary, passedCount);
buf_append_lit(&summary, STR_PTR("/"), STR_LEN("/"));
buf_append_u64(&summary, totalCount);
buf_append_lit(&summary, STR_PTR(")\n• 逐项结果："), STR_LEN(")\n• 逐项结果："));
buf_append_buf(&summary, &item_lines);
buf_append_lit(&summary, STR_PTR("\n• 耗时："), STR_LEN("\n• 耗时："));
buf_append_u64(&summary, call.latencyMs);
buf_append_lit(&summary, STR_PTR("ms · 模型："), STR_LEN("ms · 模型："));
buf_append(&summary, js_ptr(&creds.model), creds.model.len);
// const outputObject = { action: "jev_checklist", all_passed: allPassed, passed_count: passedCount, total_count: totalCount, checks: checkResults, summary, latencyMs, raw: rootData};
let stdout = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&stdout, STR_PTR("{\"action\":\"jev_checklist\",\"all_passed\":"), STR_LEN("{\"action\":\"jev_checklist\",\"all_passed\":"));
if allPassed {
buf_append_lit(&stdout, STR_PTR("true"), STR_LEN("true"));
} else {
buf_append_lit(&stdout, STR_PTR("false"), STR_LEN("false"));
};
buf_append_lit(&stdout, STR_PTR(",\"passed_count\":"), STR_LEN(",\"passed_count\":"));
buf_append_u64(&stdout, passedCount);
buf_append_lit(&stdout, STR_PTR(",\"total_count\":"), STR_LEN(",\"total_count\":"));
buf_append_u64(&stdout, totalCount);
buf_append_lit(&stdout, STR_PTR(",\"checks\":"), STR_LEN(",\"checks\":"));
buf_append_buf(&stdout, &results_json);
buf_append_lit(&stdout, STR_PTR(",\"summary\":"), STR_LEN(",\"summary\":"));
buf_append_json_str(&stdout, buf_ptr(&summary), summary.len);
buf_append_lit(&stdout, STR_PTR(",\"latencyMs\":"), STR_LEN(",\"latencyMs\":"));
buf_append_u64(&stdout, call.latencyMs);
buf_append_lit(&stdout, STR_PTR(",\"raw\":"), STR_LEN(",\"raw\":"));
buf_append(&stdout, call_data_ptr(&call), call.data_len);
buf_append_lit(&stdout, STR_PTR("}"), STR_LEN("}"));
jev_fill_success(out, &stdout, startedAt);
return 0;
}

//*
//* Autonomous raw JEV evaluate (通用原生评估).
//
// TS: export async function nativeJevEvaluate(...): Promise<JevRunResult>
// DEFECT: async
fn nativeJevEvaluate(state: &JevModuleState, rawInput: &JevRunInput, policy: &JevPolicyConfig, cwd_ptr: ptr, cwd_len: u64, startedAt: u64, out: &JevRunResult) -> i32 {
// const questions = (cast).questions as Record<string, unknown> | undefined;
// if (!questions || typeof questions!== "object" || Array.isArray(questions)) throw...
let questions = ByteBuf { bytes: [0u8; 262144], len: 0};
let q_kind: u64 = 0;
let has_q = input_dyn_json(rawInput, STR_PTR("questions"), STR_LEN("questions"), &questions, &q_kind);
if!has_q || q_kind!= 3 {
return jev_input_error(out, STR_PTR("action 'jev_evaluate' requires a 'questions' object"), STR_LEN("action 'jev_evaluate' requires a 'questions' object"));
};
let ctx_kind: u64 = 0;
let ctx_raw = ByteBuf { bytes: [0u8; 262144], len: 0};
jev_pick_context(rawInput, &ctx_kind, &ctx_raw);
let state_text = ByteBuf { bytes: [0u8; 262144], len: 0};
truncateJevContext(buf_ptr(&ctx_raw), ctx_raw.len, ctx_kind, &state_text);
let creds = JevCredentials { baseUrl: JevStr { bytes: [0u8; 8192], len: 0}, apiKey: JevStr { bytes: [0u8; 8192], len: 0}, model: JevStr { bytes: [0u8; 8192], len: 0}, providerId: JevStr { bytes: [0u8; 8192], len: 0}, groupId: JevStr { bytes: [0u8; 8192], len: 0}, bridgeProtocol: JevStr { bytes: [0u8; 8192], len: 0}, timeoutMs: 0};
resolveJevCredentials(state, rawInput, &creds);
let payload = JevPayload { state: ByteBuf { bytes: [0u8; 262144], len: 0}, model: JevStr { bytes: [0u8; 8192], len: 0}, questions: ByteBuf { bytes: [0u8; 262144], len: 0}};
jev_make_payload(&state_text, &creds, &questions, &payload);
let call = JevCallResult { ok: false, data_doc: 0, data_bytes: [0u8; 262144], data_len: 0, latencyMs: 0, has_status: false, status: 0, error_bytes: [0u8; 16384], error_len: 0};
let rc = executeJevCall(state, &payload, &creds, &call);
if rc == 2 { return jev_overload_error(state, out);};
if!call.ok {
let err = ByteBuf { bytes: [0u8; 262144], len: 0};
call_error_into(&call, &err);
let stderr = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&stderr, STR_PTR("JEV evaluate failed: "), STR_LEN("JEV evaluate failed: "));
buf_append_buf(&stderr, &err);
// NOTE: this TS variant has saVmEvents: [] (no violation event).
jev_fill_failure(out, call.has_status, call.status, buf_ptr(&err), err.len, &stderr, false, startedAt);
return 0;
};
// stdout: JSON.stringify(callResult.data, null, 2) — the data JSON text itself.
let stdout = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append(&stdout, call_data_ptr(&call), call.data_len);
jev_fill_success(out, &stdout, startedAt);
return 0;
}

//* Reserved JEV thinking verdict: enough information, act now instead of further thinking. 
// export const JEV_ACT_NOW_KEY = "__act_now";
fn JEV_ACT_NOW_KEY(out: &ByteBuf) -> void {
buf_reset(out);
buf_append_lit(out, STR_PTR("__act_now"), STR_LEN("__act_now"));
}

// export const JEV_ACT_NOW_DESC = "已有足够信息，直接行动，避免过度思考";
fn JEV_ACT_NOW_DESC(out: &ByteBuf) -> void {
buf_reset(out);
buf_append_lit(out, STR_PTR("已有足够信息，直接行动，避免过度思考"), STR_LEN("已有足够信息，直接行动，避免过度思考"));
}

//* Fixed red-team risk taxonomy for `jev_redteam` (keys are stable verdict codes). 
// export const JEV_REDTEAM_RISKS: Record<string, string> = {...};
fn JEV_REDTEAM_RISKS(out: &StringMap) -> void {
stringmap_init(out);
stringmap_set_lit(out, STR_PTR("data_loss"), STR_LEN("data_loss"), STR_PTR("数据丢失/污染：迁移、删除、重命名、并发写覆盖导致数据不可恢复"), STR_LEN("数据丢失/污染：迁移、删除、重命名、并发写覆盖导致数据不可恢复"));
stringmap_set_lit(out, STR_PTR("security_hole"), STR_LEN("security_hole"), STR_PTR("安全缺口：鉴权绕过、越权、密钥/凭据泄露、注入面扩大"), STR_LEN("安全缺口：鉴权绕过、越权、密钥/凭据泄露、注入面扩大"));
stringmap_set_lit(out, STR_PTR("race_condition"), STR_LEN("race_condition"), STR_PTR("竞态与一致性：并发、时序、缓存/订阅状态错乱、双写冲突"), STR_LEN("竞态与一致性：并发、时序、缓存/订阅状态错乱、双写冲突"));
stringmap_set_lit(out, STR_PTR("compat_break"), STR_LEN("compat_break"), STR_PTR("兼容性断裂：公开 API/存储格式/协议变更，老客户端与历史数据遭殃"), STR_LEN("兼容性断裂：公开 API/存储格式/协议变更，老客户端与历史数据遭殃"));
stringmap_set_lit(out, STR_PTR("silent_wrong"), STR_LEN("silent_wrong"), STR_PTR("静默错误：不报错但结果错，最难发现（金额、权限判定、计费）"), STR_LEN("静默错误：不报错但结果错，最难发现（金额、权限判定、计费）"));
stringmap_set_lit(out, STR_PTR("perf_regression"), STR_LEN("perf_regression"), STR_PTR("性能退化：慢查询、N+1、内存泄漏、上下文爆炸拖垮服务"), STR_LEN("性能退化：慢查询、N+1、内存泄漏、上下文爆炸拖垮服务"));
stringmap_set_lit(out, STR_PTR("rollback_impossible"), STR_LEN("rollback_impossible"), STR_PTR("无法回滚：一旦上线出问题，没有安全回退路径"), STR_LEN("无法回滚：一旦上线出问题，没有安全回退路径"));
stringmap_set_lit(out, STR_PTR("scope_creep"), STR_LEN("scope_creep"), STR_PTR("范围蔓延：改动超出目标，把不相关模块拖下水"), STR_LEN("范围蔓延：改动超出目标，把不相关模块拖下水"));
}

//* Go / no-go verdict options for `jev_redteam`. 
// export const JEV_REDTEAM_VERDICTS: Record<string, string> = {...};
fn JEV_REDTEAM_VERDICTS(out: &StringMap) -> void {
stringmap_init(out);
stringmap_set_lit(out, STR_PTR("proceed"), STR_LEN("proceed"), STR_PTR("可按原计划执行，未发现阻塞性风险"), STR_LEN("可按原计划执行，未发现阻塞性风险"));
stringmap_set_lit(out, STR_PTR("harden_first"), STR_LEN("harden_first"), STR_PTR("先加固再执行：补测试、回滚方案、灰度或 feature flag 后再上"), STR_LEN("先加固再执行：补测试、回滚方案、灰度或 feature flag 后再上"));
stringmap_set_lit(out, STR_PTR("stop"), STR_LEN("stop"), STR_PTR("风险过高，建议推倒重来或大幅缩小范围"), STR_LEN("风险过高，建议推倒重来或大幅缩小范围"));
}

//*
//* Advisory red-team review (红队找茬, purely opt-in).
//* The model submits a target plan/decision; JEV returns the most likely
//* failure mode (fixed risk taxonomy) plus a go / harden-first / stop verdict.
//* Complements `jev_choose` (which picks among the model's own options) by
//* pointing at blind spots the model did not list.
//
// TS: export async function nativeJevRedteam(...): Promise<JevRunResult>
// DEFECT: async
fn nativeJevRedteam(state: &JevModuleState, rawInput: &JevRunInput, policy: &JevPolicyConfig, cwd_ptr: ptr, cwd_len: u64, startedAt: u64, out: &JevRunResult) -> i32 {
// const rawTarget = (cast).target?? rawInput.question?? (cast).prompt;
let t_raw = ByteBuf { bytes: [0u8; 262144], len: 0};
if!input_dyn_str(rawInput, STR_PTR("target"), STR_LEN("target"), &t_raw) {
if!input_str_field(rawInput, 0, &t_raw) {
input_dyn_str(rawInput, STR_PTR("prompt"), STR_LEN("prompt"), &t_raw);
};
};
let target = ByteBuf { bytes: [0u8; 262144], len: 0};
str_trim_into(&target, buf_ptr(&t_raw), t_raw.len);
if target.len == 0 {
return jev_input_error(out, STR_PTR("action 'jev_redteam' requires a non-empty 'target' parameter"), STR_LEN("action 'jev_redteam' requires a non-empty 'target' parameter"));
};
let ctx_kind: u64 = 0;
let ctx_raw = ByteBuf { bytes: [0u8; 262144], len: 0};
jev_pick_context(rawInput, &ctx_kind, &ctx_raw);
let context = ByteBuf { bytes: [0u8; 262144], len: 0};
truncateJevContext(buf_ptr(&ctx_raw), ctx_raw.len, ctx_kind, &context);
let creds = JevCredentials { baseUrl: JevStr { bytes: [0u8; 8192], len: 0}, apiKey: JevStr { bytes: [0u8; 8192], len: 0}, model: JevStr { bytes: [0u8; 8192], len: 0}, providerId: JevStr { bytes: [0u8; 8192], len: 0}, groupId: JevStr { bytes: [0u8; 8192], len: 0}, bridgeProtocol: JevStr { bytes: [0u8; 8192], len: 0}, timeoutMs: 0};
resolveJevCredentials(state, rawInput, &creds);
let risks = StringMap { key_off: [0u64; 64], key_len: [0u64; 64], val_off: [0u64; 64], val_len: [0u64; 64], keys_bytes: [0u8; 8192], keys_len: 0, vals_bytes: [0u8; 65536], vals_len: 0, len: 0};
JEV_REDTEAM_RISKS(&risks);
let verdicts = StringMap { key_off: [0u64; 64], key_len: [0u64; 64], val_off: [0u64; 64], val_len: [0u64; 64], keys_bytes: [0u8; 8192], keys_len: 0, vals_bytes: [0u8; 65536], vals_len: 0, len: 0};
JEV_REDTEAM_VERDICTS(&verdicts);
let risks_json = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_map_json(&risks_json, &risks);
let verdicts_json = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_map_json(&verdicts_json, &verdicts);
let instr1 = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&instr1, STR_PTR("Which failure mode is most likely if this plan is executed as described? Target: "), STR_LEN("Which failure mode is most likely if this plan is executed as described? Target: "));
buf_append_buf(&instr1, &target);
let instr2 = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&instr2, STR_PTR("Given the most likely failure mode above, can this plan proceed? Target: "), STR_LEN("Given the most likely failure mode above, can this plan proceed? Target: "));
buf_append_buf(&instr2, &target);
let questions = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&questions, STR_PTR("{"), STR_LEN("{"));
buf_append_question(&questions, STR_PTR("primary_risk"), STR_LEN("primary_risk"), STR_PTR("choice"), STR_LEN("choice"), &instr1, buf_ptr(&risks_json), risks_json.len);
buf_append_lit(&questions, STR_PTR(","), STR_LEN(","));
buf_append_question(&questions, STR_PTR("verdict"), STR_LEN("verdict"), STR_PTR("choice"), STR_LEN("choice"), &instr2, buf_ptr(&verdicts_json), verdicts_json.len);
buf_append_lit(&questions, STR_PTR("}"), STR_LEN("}"));
let state_text = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&state_text, STR_PTR("[Red-Team Target]\n"), STR_LEN("[Red-Team Target]\n"));
buf_append_buf(&state_text, &target);
buf_append_lit(&state_text, STR_PTR("\n\n[Context]\n"), STR_LEN("\n\n[Context]\n"));
buf_append_buf(&state_text, &context);
let payload = JevPayload { state: ByteBuf { bytes: [0u8; 262144], len: 0}, model: JevStr { bytes: [0u8; 8192], len: 0}, questions: ByteBuf { bytes: [0u8; 262144], len: 0}};
jev_make_payload(&state_text, &creds, &questions, &payload);
let call = JevCallResult { ok: false, data_doc: 0, data_bytes: [0u8; 262144], data_len: 0, latencyMs: 0, has_status: false, status: 0, error_bytes: [0u8; 16384], error_len: 0};
let rc = executeJevCall(state, &payload, &creds, &call);
if rc == 2 { return jev_overload_error(state, out);};
if!call.ok {
let err = ByteBuf { bytes: [0u8; 262144], len: 0};
call_error_into(&call, &err);
let stderr = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&stderr, STR_PTR("JEV red-team review failed ("), STR_LEN("JEV red-team review failed ("));
if call.has_status {
buf_append_i64(&stderr, call.status as i64);
} else {
buf_append_lit(&stderr, STR_PTR("502"), STR_LEN("502"));
};
buf_append_lit(&stderr, STR_PTR("): "), STR_LEN("): "));
buf_append_buf(&stderr, &err);
jev_fill_failure(out, call.has_status, call.status, buf_ptr(&err), err.len, &stderr, true, startedAt);
return 0;
};
let riskKey = ByteBuf { bytes: [0u8; 262144], len: 0};
jev_answer_choice(call.data_doc, STR_PTR("primary_risk"), STR_LEN("primary_risk"), &riskKey);
let riskConfidence = jev_answer_confidence(call.data_doc, STR_PTR("primary_risk"), STR_LEN("primary_risk"));
let verdictKey = ByteBuf { bytes: [0u8; 262144], len: 0};
jev_answer_choice(call.data_doc, STR_PTR("verdict"), STR_LEN("verdict"), &verdictKey);
let verdictConfidence = jev_answer_confidence(call.data_doc, STR_PTR("verdict"), STR_LEN("verdict"));
// const riskDesc = JEV_REDTEAM_RISKS[riskKey] || JEV_REDTEAM_RISKS[riskKey.toLowerCase()] || riskKey;
let riskDesc = ByteBuf { bytes: [0u8; 262144], len: 0};
if!stringmap_get(&risks, buf_ptr(&riskKey), riskKey.len, &riskDesc) || riskDesc.len == 0 {
let lower = ByteBuf { bytes: [0u8; 262144], len: 0};
str_lower_into(&lower, buf_ptr(&riskKey), riskKey.len);
if!stringmap_get(&risks, buf_ptr(&lower), lower.len, &riskDesc) || riskDesc.len == 0 {
buf_copy_into(&riskDesc, &riskKey);
};
};
let verdictDesc = ByteBuf { bytes: [0u8; 262144], len: 0};
if!stringmap_get(&verdicts, buf_ptr(&verdictKey), verdictKey.len, &verdictDesc) || verdictDesc.len == 0 {
buf_copy_into(&verdictDesc, &verdictKey);
};
let summary = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&summary, STR_PTR("\n• 最可能翻车点：["), STR_LEN("\n• 最可能翻车点：["));
buf_append_buf(&summary, &riskKey);
buf_append_lit(&summary, STR_PTR("] "), STR_LEN("] "));
buf_append_buf(&summary, &riskDesc);
buf_append_lit(&summary, STR_PTR("（置信度 "), STR_LEN("（置信度 "));
buf_append_u64(&summary, jev_percent(riskConfidence));
buf_append_lit(&summary, STR_PTR("%）\n• 裁决：["), STR_LEN("%）\n• 裁决：["));
buf_append_buf(&summary, &verdictKey);
buf_append_lit(&summary, STR_PTR("] "), STR_LEN("] "));
buf_append_buf(&summary, &verdictDesc);
buf_append_lit(&summary, STR_PTR("（置信度 "), STR_LEN("（置信度 "));
buf_append_u64(&summary, jev_percent(verdictConfidence));
buf_append_lit(&summary, STR_PTR("%）\n• 目标："), STR_LEN("%）\n• 目标："));
buf_append_buf(&summary, &target);
buf_append_lit(&summary, STR_PTR("\n• 耗时："), STR_LEN("\n• 耗时："));
buf_append_u64(&summary, call.latencyMs);
buf_append_lit(&summary, STR_PTR("ms · 模型："), STR_LEN("ms · 模型："));
buf_append(&summary, js_ptr(&creds.model), creds.model.len);
let stdout = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&stdout, STR_PTR("{\"action\":\"jev_redteam\",\"target\":"), STR_LEN("{\"action\":\"jev_redteam\",\"target\":"));
buf_append_json_str(&stdout, buf_ptr(&target), target.len);
buf_append_lit(&stdout, STR_PTR(",\"primary_risk\":"), STR_LEN(",\"primary_risk\":"));
buf_append_json_str(&stdout, buf_ptr(&riskKey), riskKey.len);
buf_append_lit(&stdout, STR_PTR(",\"risk_confidence\":"), STR_LEN(",\"risk_confidence\":"));
buf_append_f64(&stdout, riskConfidence);
buf_append_lit(&stdout, STR_PTR(",\"risk_description\":"), STR_LEN(",\"risk_description\":"));
buf_append_json_str(&stdout, buf_ptr(&riskDesc), riskDesc.len);
buf_append_lit(&stdout, STR_PTR(",\"verdict\":"), STR_LEN(",\"verdict\":"));
buf_append_json_str(&stdout, buf_ptr(&verdictKey), verdictKey.len);
buf_append_lit(&stdout, STR_PTR(",\"verdict_confidence\":"), STR_LEN(",\"verdict_confidence\":"));
buf_append_f64(&stdout, verdictConfidence);
buf_append_lit(&stdout, STR_PTR(",\"verdict_description\":"), STR_LEN(",\"verdict_description\":"));
buf_append_json_str(&stdout, buf_ptr(&verdictDesc), verdictDesc.len);
buf_append_lit(&stdout, STR_PTR(",\"summary\":"), STR_LEN(",\"summary\":"));
buf_append_json_str(&stdout, buf_ptr(&summary), summary.len);
buf_append_lit(&stdout, STR_PTR(",\"latencyMs\":"), STR_LEN(",\"latencyMs\":"));
buf_append_u64(&stdout, call.latencyMs);
buf_append_lit(&stdout, STR_PTR(",\"raw\":"), STR_LEN(",\"raw\":"));
buf_append(&stdout, call_data_ptr(&call), call.data_len);
buf_append_lit(&stdout, STR_PTR("}"), STR_LEN("}"));
jev_fill_success(out, &stdout, startedAt);
return 0;
}

//*
//* Advisory pre-thinking adjudication (思考前裁决, purely opt-in).
//* The model lists 1~4 candidate lines of thought for a goal; JEV picks the
//* most promising one or returns the built-in `__act_now` brake verdict.
//* Never blocks: on failure/timeout the caller falls back to model_decide.
//
// TS: export async function nativeJevThinking(...): Promise<JevRunResult>
// DEFECT: async
fn nativeJevThinking(state: &JevModuleState, rawInput: &JevRunInput, policy: &JevPolicyConfig, cwd_ptr: ptr, cwd_len: u64, startedAt: u64, out: &JevRunResult) -> i32 {
// const rawGoal = (cast).goal?? rawInput.question?? (cast).query?? (cast).prompt?? (cast).task?? rawInput.content;
let g_raw = ByteBuf { bytes: [0u8; 262144], len: 0};
let has_goal = input_dyn_str(rawInput, STR_PTR("goal"), STR_LEN("goal"), &g_raw);
if!has_goal { has_goal = input_str_field(rawInput, 0, &g_raw);};
if!has_goal { has_goal = input_dyn_str(rawInput, STR_PTR("query"), STR_LEN("query"), &g_raw);};
if!has_goal { has_goal = input_dyn_str(rawInput, STR_PTR("prompt"), STR_LEN("prompt"), &g_raw);};
if!has_goal { has_goal = input_dyn_str(rawInput, STR_PTR("task"), STR_LEN("task"), &g_raw);};
if!has_goal { has_goal = input_str_field(rawInput, 2, &g_raw);};
let goal = ByteBuf { bytes: [0u8; 262144], len: 0};
str_trim_into(&goal, buf_ptr(&g_raw), g_raw.len);
if goal.len == 0 {
return jev_input_error(out, STR_PTR("action 'jev_thinking' requires a non-empty 'goal' parameter"), STR_LEN("action 'jev_thinking' requires a non-empty 'goal' parameter"));
};
// const rawThoughts = (cast).thoughts?? rawInput.options?? rawInput.criteria?? (cast).choices;
let raw_thoughts = ByteBuf { bytes: [0u8; 262144], len: 0};
let raw_kind: u64 = 0;
if!input_dyn_json(rawInput, STR_PTR("thoughts"), STR_LEN("thoughts"), &raw_thoughts, &raw_kind) {
if!input_json_field(rawInput, 4, &raw_thoughts, &raw_kind) {
if!input_json_field(rawInput, 5, &raw_thoughts, &raw_kind) {
input_dyn_json(rawInput, STR_PTR("choices"), STR_LEN("choices"), &raw_thoughts, &raw_kind);
};
};
};
let thoughts = StringMap { key_off: [0u64; 64], key_len: [0u64; 64], val_off: [0u64; 64], val_len: [0u64; 64], keys_bytes: [0u8; 8192], keys_len: 0, vals_bytes: [0u8; 65536], vals_len: 0, len: 0};
normalizeChoiceOptions(buf_ptr(&raw_thoughts), raw_thoughts.len, raw_kind, &thoughts);
if thoughts.len < 1 {
return jev_input_error(out, STR_PTR("action 'jev_thinking' requires at least 1 thought in 'thoughts'"), STR_LEN("action 'jev_thinking' requires at least 1 thought in 'thoughts'"));
};
if thoughts.len > 4 {
// Truncate to first 4 thoughts; the brake option always stays.
jev_map_truncate(&thoughts, 4);
};
let act_key = ByteBuf { bytes: [0u8; 262144], len: 0};
JEV_ACT_NOW_KEY(&act_key);
if stringmap_has(&thoughts, buf_ptr(&act_key), act_key.len) {
let msg = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&msg, STR_PTR("thought key '"), STR_LEN("thought key '"));
buf_append_buf(&msg, &act_key);
buf_append_lit(&msg, STR_PTR("' is reserved for the act-now brake verdict"), STR_LEN("' is reserved for the act-now brake verdict"));
return jev_input_error_buf(out, &msg);
};
let ctx_kind: u64 = 0;
let ctx_raw = ByteBuf { bytes: [0u8; 262144], len: 0};
jev_pick_context(rawInput, &ctx_kind, &ctx_raw);
let context = ByteBuf { bytes: [0u8; 262144], len: 0};
truncateJevContext(buf_ptr(&ctx_raw), ctx_raw.len, ctx_kind, &context);
let creds = JevCredentials { baseUrl: JevStr { bytes: [0u8; 8192], len: 0}, apiKey: JevStr { bytes: [0u8; 8192], len: 0}, model: JevStr { bytes: [0u8; 8192], len: 0}, providerId: JevStr { bytes: [0u8; 8192], len: 0}, groupId: JevStr { bytes: [0u8; 8192], len: 0}, bridgeProtocol: JevStr { bytes: [0u8; 8192], len: 0}, timeoutMs: 0};
resolveJevCredentials(state, rawInput, &creds);
// criteria: {...thoughts, [JEV_ACT_NOW_KEY]: JEV_ACT_NOW_DESC}
let crit_map = StringMap { key_off: [0u64; 64], key_len: [0u64; 64], val_off: [0u64; 64], val_len: [0u64; 64], keys_bytes: [0u8; 8192], keys_len: 0, vals_bytes: [0u8; 65536], vals_len: 0, len: 0};
stringmap_init(&crit_map);
let ti: u64 = 0;
for ti in 0..thoughts.len {
stringmap_set(&crit_map, stringmap_key_ptr(&thoughts, ti), thoughts.key_len[ti], stringmap_val_ptr(&thoughts, ti), thoughts.val_len[ti]);
}
let act_desc = ByteBuf { bytes: [0u8; 262144], len: 0};
JEV_ACT_NOW_DESC(&act_desc);
stringmap_set(&crit_map, buf_ptr(&act_key), act_key.len, buf_ptr(&act_desc), act_desc.len);
let crit_json = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_map_json(&crit_json, &crit_map);
let instr = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&instr, STR_PTR("Which line of thought should be pursued for this goal, or is there enough information to act now without further thinking? Goal: "), STR_LEN("Which line of thought should be pursued for this goal, or is there enough information to act now without further thinking? Goal: "));
buf_append_buf(&instr, &goal);
let questions = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&questions, STR_PTR("{"), STR_LEN("{"));
buf_append_question(&questions, STR_PTR("direction"), STR_LEN("direction"), STR_PTR("choice"), STR_LEN("choice"), &instr, buf_ptr(&crit_json), crit_json.len);
buf_append_lit(&questions, STR_PTR("}"), STR_LEN("}"));
let state_text = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&state_text, STR_PTR("[Thinking Goal]\n"), STR_LEN("[Thinking Goal]\n"));
buf_append_buf(&state_text, &goal);
buf_append_lit(&state_text, STR_PTR("\n\n[Context]\n"), STR_LEN("\n\n[Context]\n"));
buf_append_buf(&state_text, &context);
let payload = JevPayload { state: ByteBuf { bytes: [0u8; 262144], len: 0}, model: JevStr { bytes: [0u8; 8192], len: 0}, questions: ByteBuf { bytes: [0u8; 262144], len: 0}};
jev_make_payload(&state_text, &creds, &questions, &payload);
let call = JevCallResult { ok: false, data_doc: 0, data_bytes: [0u8; 262144], data_len: 0, latencyMs: 0, has_status: false, status: 0, error_bytes: [0u8; 16384], error_len: 0};
let rc = executeJevCall(state, &payload, &creds, &call);
if rc == 2 { return jev_overload_error(state, out);};
if!call.ok {
let err = ByteBuf { bytes: [0u8; 262144], len: 0};
call_error_into(&call, &err);
let stderr = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&stderr, STR_PTR("JEV thinking adjudication failed ("), STR_LEN("JEV thinking adjudication failed ("));
if call.has_status {
buf_append_i64(&stderr, call.status as i64);
} else {
buf_append_lit(&stderr, STR_PTR("502"), STR_LEN("502"));
};
buf_append_lit(&stderr, STR_PTR("): "), STR_LEN("): "));
buf_append_buf(&stderr, &err);
jev_fill_failure(out, call.has_status, call.status, buf_ptr(&err), err.len, &stderr, true, startedAt);
return 0;
};
let chosenKey = ByteBuf { bytes: [0u8; 262144], len: 0};
jev_answer_choice(call.data_doc, STR_PTR("direction"), STR_LEN("direction"), &chosenKey);
let confidence = jev_answer_confidence(call.data_doc, STR_PTR("direction"), STR_LEN("direction"));
let actNow = jev_str_eq(buf_ptr(&chosenKey), chosenKey.len, buf_ptr(&act_key), act_key.len);
let chosenDesc = ByteBuf { bytes: [0u8; 262144], len: 0};
if actNow {
buf_copy_into(&chosenDesc, &act_desc);
} else {
if!stringmap_get(&thoughts, buf_ptr(&chosenKey), chosenKey.len, &chosenDesc) || chosenDesc.len == 0 {
let lower = ByteBuf { bytes: [0u8; 262144], len: 0};
str_lower_into(&lower, buf_ptr(&chosenKey), chosenKey.len);
if!stringmap_get(&thoughts, buf_ptr(&lower), lower.len, &chosenDesc) || chosenDesc.len == 0 {
buf_copy_into(&chosenDesc, &chosenKey);
};
};
};
let summary = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&summary, STR_PTR("\n"), STR_LEN("\n"));
if actNow {
buf_append_lit(&summary, STR_PTR("• 裁决：无需再想，直接行动（置信度 "), STR_LEN("• 裁决：无需再想，直接行动（置信度 "));
buf_append_u64(&summary, jev_percent(confidence));
buf_append_lit(&summary, STR_PTR("%）\n• 目标："), STR_LEN("%）\n• 目标："));
buf_append_buf(&summary, &goal);
} else {
buf_append_lit(&summary, STR_PTR("• 建议深入思路：["), STR_LEN("• 建议深入思路：["));
buf_append_buf(&summary, &chosenKey);
buf_append_lit(&summary, STR_PTR("]（置信度 "), STR_LEN("]（置信度 "));
buf_append_u64(&summary, jev_percent(confidence));
buf_append_lit(&summary, STR_PTR("%）\n• 思路描述："), STR_LEN("%）\n• 思路描述："));
buf_append_buf(&summary, &chosenDesc);
buf_append_lit(&summary, STR_PTR("\n• 目标："), STR_LEN("\n• 目标："));
buf_append_buf(&summary, &goal);
};
buf_append_lit(&summary, STR_PTR("\n• 耗时："), STR_LEN("\n• 耗时："));
buf_append_u64(&summary, call.latencyMs);
buf_append_lit(&summary, STR_PTR("ms · 模型："), STR_LEN("ms · 模型："));
buf_append(&summary, js_ptr(&creds.model), creds.model.len);
// const outputObject = { action: "jev_thinking", goal, choice: chosenKey, act_now: actNow, confidence, description: chosenDesc, all_thoughts: thoughts, summary, latencyMs, raw: rootData};
let stdout = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&stdout, STR_PTR("{\"action\":\"jev_thinking\",\"goal\":"), STR_LEN("{\"action\":\"jev_thinking\",\"goal\":"));
buf_append_json_str(&stdout, buf_ptr(&goal), goal.len);
buf_append_lit(&stdout, STR_PTR(",\"choice\":"), STR_LEN(",\"choice\":"));
buf_append_json_str(&stdout, buf_ptr(&chosenKey), chosenKey.len);
buf_append_lit(&stdout, STR_PTR(",\"act_now\":"), STR_LEN(",\"act_now\":"));
if actNow {
buf_append_lit(&stdout, STR_PTR("true"), STR_LEN("true"));
} else {
buf_append_lit(&stdout, STR_PTR("false"), STR_LEN("false"));
};
buf_append_lit(&stdout, STR_PTR(",\"confidence\":"), STR_LEN(",\"confidence\":"));
buf_append_f64(&stdout, confidence);
buf_append_lit(&stdout, STR_PTR(",\"description\":"), STR_LEN(",\"description\":"));
buf_append_json_str(&stdout, buf_ptr(&chosenDesc), chosenDesc.len);
buf_append_lit(&stdout, STR_PTR(",\"all_thoughts\":"), STR_LEN(",\"all_thoughts\":"));
buf_append_map_json(&stdout, &thoughts);
buf_append_lit(&stdout, STR_PTR(",\"summary\":"), STR_LEN(",\"summary\":"));
buf_append_json_str(&stdout, buf_ptr(&summary), summary.len);
buf_append_lit(&stdout, STR_PTR(",\"latencyMs\":"), STR_LEN(",\"latencyMs\":"));
buf_append_u64(&stdout, call.latencyMs);
buf_append_lit(&stdout, STR_PTR(",\"raw\":"), STR_LEN(",\"raw\":"));
buf_append(&stdout, call_data_ptr(&call), call.data_len);
buf_append_lit(&stdout, STR_PTR("}"), STR_LEN("}"));
jev_fill_success(out, &stdout, startedAt);
return 0;
}

//* Size verdict options for `jev_scope`. 
// export const JEV_SCOPE_VERDICTS: Record<string, string> = {...};
fn JEV_SCOPE_VERDICTS(out: &StringMap) -> void {
stringmap_init(out);
stringmap_set_lit(out, STR_PTR("right_sized"), STR_LEN("right_sized"), STR_PTR("大小合适，一次可交付，无需拆分或合并"), STR_LEN("大小合适，一次可交付，无需拆分或合并"));
stringmap_set_lit(out, STR_PTR("split_2_3"), STR_LEN("split_2_3"), STR_PTR("太大，建议拆成 2~3 个可独立交付的子任务"), STR_LEN("太大，建议拆成 2~3 个可独立交付的子任务"));
stringmap_set_lit(out, STR_PTR("split_many"), STR_LEN("split_many"), STR_PTR("太大，建议拆成 4 个以上子任务或先切出 MVP"), STR_LEN("太大，建议拆成 4 个以上子任务或先切出 MVP"));
stringmap_set_lit(out, STR_PTR("merge"), STR_LEN("merge"), STR_PTR("太小，建议合并到相邻任务一起做，避免碎片化"), STR_LEN("太小，建议合并到相邻任务一起做，避免碎片化"));
}

//* Per-constraint status options for `jev_consistency`. 
// export const JEV_CONSISTENCY_STATUS: Record<string, string> = {...};
fn JEV_CONSISTENCY_STATUS(out: &StringMap) -> void {
stringmap_init(out);
stringmap_set_lit(out, STR_PTR("holds"), STR_LEN("holds"), STR_PTR("计划满足该约束"), STR_LEN("计划满足该约束"));
stringmap_set_lit(out, STR_PTR("violated"), STR_LEN("violated"), STR_PTR("计划违反该约束，必须修改计划"), STR_LEN("计划违反该约束，必须修改计划"));
stringmap_set_lit(out, STR_PTR("unclear"), STR_LEN("unclear"), STR_PTR("上下文不足，无法判定是否满足"), STR_LEN("上下文不足，无法判定是否满足"));
}

//*
//* Advisory top-k ranking (排序, purely opt-in).
//* The model submits 2~6 items with a ranking criterion; JEV picks rank_1..rank_k
//* (k = min(n, 3)) as separate choice questions. The server dedupes repeated
//* picks and appends unranked items in submission order.
//
// TS: export async function nativeJevRank(...): Promise<JevRunResult>
// DEFECT: async
fn nativeJevRank(state: &JevModuleState, rawInput: &JevRunInput, policy: &JevPolicyConfig, cwd_ptr: ptr, cwd_len: u64, startedAt: u64, out: &JevRunResult) -> i32 {
// const rawItems = (cast).items?? rawInput.options?? (cast).choices;
let raw_items = ByteBuf { bytes: [0u8; 262144], len: 0};
let raw_kind: u64 = 0;
if!input_dyn_json(rawInput, STR_PTR("items"), STR_LEN("items"), &raw_items, &raw_kind) {
if!input_json_field(rawInput, 4, &raw_items, &raw_kind) {
input_dyn_json(rawInput, STR_PTR("choices"), STR_LEN("choices"), &raw_items, &raw_kind);
};
};
let items = StringMap { key_off: [0u64; 64], key_len: [0u64; 64], val_off: [0u64; 64], val_len: [0u64; 64], keys_bytes: [0u8; 8192], keys_len: 0, vals_bytes: [0u8; 65536], vals_len: 0, len: 0};
normalizeChoiceOptions(buf_ptr(&raw_items), raw_items.len, raw_kind, &items);
if items.len < 2 {
return jev_input_error(out, STR_PTR("action 'jev_rank' requires at least 2 items in 'items'"), STR_LEN("action 'jev_rank' requires at least 2 items in 'items'"));
};
if items.len > 6 {
jev_map_truncate(&items, 6);
};
// const criterion = ((cast).criterion?? (cast).criteria?? rawInput.question?? "overall value").toString().trim() || "overall value";
let c_raw = ByteBuf { bytes: [0u8; 262144], len: 0};
let has_c = input_dyn_str(rawInput, STR_PTR("criterion"), STR_LEN("criterion"), &c_raw);
if!has_c { has_c = input_dyn_str(rawInput, STR_PTR("criteria"), STR_LEN("criteria"), &c_raw);};
if!has_c { has_c = input_str_field(rawInput, 0, &c_raw);};
let criterion = ByteBuf { bytes: [0u8; 262144], len: 0};
str_trim_into(&criterion, buf_ptr(&c_raw), c_raw.len);
if criterion.len == 0 {
buf_append_lit(&criterion, STR_PTR("overall value"), STR_LEN("overall value"));
};
let ctx_kind: u64 = 0;
let ctx_raw = ByteBuf { bytes: [0u8; 262144], len: 0};
jev_pick_context(rawInput, &ctx_kind, &ctx_raw);
let context = ByteBuf { bytes: [0u8; 262144], len: 0};
truncateJevContext(buf_ptr(&ctx_raw), ctx_raw.len, ctx_kind, &context);
let creds = JevCredentials { baseUrl: JevStr { bytes: [0u8; 8192], len: 0}, apiKey: JevStr { bytes: [0u8; 8192], len: 0}, model: JevStr { bytes: [0u8; 8192], len: 0}, providerId: JevStr { bytes: [0u8; 8192], len: 0}, groupId: JevStr { bytes: [0u8; 8192], len: 0}, bridgeProtocol: JevStr { bytes: [0u8; 8192], len: 0}, timeoutMs: 0};
resolveJevCredentials(state, rawInput, &creds);
let rankCount = items.len;
if rankCount > 3 { rankCount = 3;};
let items_json = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_map_json(&items_json, &items);
let questions = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&questions, STR_PTR("{"), STR_LEN("{"));
let rank: u64 = 1;
for rank in 1..(rankCount + 1) {
if rank > 1 {
buf_append_lit(&questions, STR_PTR(","), STR_LEN(","));
};
let qid = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&qid, STR_PTR("rank_"), STR_LEN("rank_"));
buf_append_u64(&qid, rank);
let instr = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&instr, STR_PTR("Which item ranks #"), STR_LEN("Which item ranks #"));
buf_append_u64(&instr, rank);
buf_append_lit(&instr, STR_PTR(" by "), STR_LEN(" by "));
buf_append_buf(&instr, &criterion);
buf_append_lit(&instr, STR_PTR("?"), STR_LEN("?"));
if rank > 1 {
buf_append_lit(&instr, STR_PTR(" Do NOT repeat items already chosen for higher ranks."), STR_LEN(" Do NOT repeat items already chosen for higher ranks."));
};
buf_append_question(&questions, buf_ptr(&qid), qid.len, STR_PTR("choice"), STR_LEN("choice"), &instr, buf_ptr(&items_json), items_json.len);
}
buf_append_lit(&questions, STR_PTR("}"), STR_LEN("}"));
let state_text = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&state_text, STR_PTR("[Ranking Criterion]\n"), STR_LEN("[Ranking Criterion]\n"));
buf_append_buf(&state_text, &criterion);
buf_append_lit(&state_text, STR_PTR("\n\n[Context]\n"), STR_LEN("\n\n[Context]\n"));
buf_append_buf(&state_text, &context);
let payload = JevPayload { state: ByteBuf { bytes: [0u8; 262144], len: 0}, model: JevStr { bytes: [0u8; 8192], len: 0}, questions: ByteBuf { bytes: [0u8; 262144], len: 0}};
jev_make_payload(&state_text, &creds, &questions, &payload);
let call = JevCallResult { ok: false, data_doc: 0, data_bytes: [0u8; 262144], data_len: 0, latencyMs: 0, has_status: false, status: 0, error_bytes: [0u8; 16384], error_len: 0};
let rc = executeJevCall(state, &payload, &creds, &call);
if rc == 2 { return jev_overload_error(state, out);};
if!call.ok {
let err = ByteBuf { bytes: [0u8; 262144], len: 0};
call_error_into(&call, &err);
let stderr = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&stderr, STR_PTR("JEV ranking failed ("), STR_LEN("JEV ranking failed ("));
if call.has_status {
buf_append_i64(&stderr, call.status as i64);
} else {
buf_append_lit(&stderr, STR_PTR("502"), STR_LEN("502"));
};
buf_append_lit(&stderr, STR_PTR("): "), STR_LEN("): "));
buf_append_buf(&stderr, &err);
jev_fill_failure(out, call.has_status, call.status, buf_ptr(&err), err.len, &stderr, true, startedAt);
return 0;
};
// const ranking: Array<{ key; description; rank; confidence}> = [];
// const picked = new Set<string>();
// DEFECT: Set — the picked set is a StringMap with value "1".
let picked = StringMap { key_off: [0u64; 64], key_len: [0u64; 64], val_off: [0u64; 64], val_len: [0u64; 64], keys_bytes: [0u8; 8192], keys_len: 0, vals_bytes: [0u8; 65536], vals_len: 0, len: 0};
stringmap_init(&picked);
let ranking_json = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&ranking_json, STR_PTR("["), STR_LEN("["));
let rank_lines = ByteBuf { bytes: [0u8; 262144], len: 0};
let first_entry = true;
let r2: u64 = 1;
for r2 in 1..(rankCount + 1) {
let qid = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&qid, STR_PTR("rank_"), STR_LEN("rank_"));
buf_append_u64(&qid, r2);
let rawKey = ByteBuf { bytes: [0u8; 262144], len: 0};
jev_answer_choice(call.data_doc, buf_ptr(&qid), qid.len, &rawKey);
// const key = items[rawKey]!== undefined? rawKey: items[rawKey.toLowerCase()]!== undefined? rawKey.toLowerCase(): "";
let key = ByteBuf { bytes: [0u8; 262144], len: 0};
if stringmap_has(&items, buf_ptr(&rawKey), rawKey.len) {
buf_copy_into(&key, &rawKey);
} else {
let lower = ByteBuf { bytes: [0u8; 262144], len: 0};
str_lower_into(&lower, buf_ptr(&rawKey), rawKey.len);
if stringmap_has(&items, buf_ptr(&lower), lower.len) {
buf_copy_into(&key, &lower);
};
};
if key.len == 0 || stringmap_has(&picked, buf_ptr(&key), key.len) {
continue;
};
stringmap_set(&picked, buf_ptr(&key), key.len, STR_PTR("1"), STR_LEN("1"));
let confidence = jev_answer_confidence(call.data_doc, buf_ptr(&qid), qid.len);
let desc = ByteBuf { bytes: [0u8; 262144], len: 0};
stringmap_get(&items, buf_ptr(&key), key.len, &desc);
if!first_entry {
buf_append_lit(&ranking_json, STR_PTR(","), STR_LEN(","));
};
first_entry = false;
buf_append_lit(&ranking_json, STR_PTR("{\"key\":"), STR_LEN("{\"key\":"));
buf_append_json_str(&ranking_json, buf_ptr(&key), key.len);
buf_append_lit(&ranking_json, STR_PTR(",\"description\":"), STR_LEN(",\"description\":"));
buf_append_json_str(&ranking_json, buf_ptr(&desc), desc.len);
buf_append_lit(&ranking_json, STR_PTR(",\"rank\":"), STR_LEN(",\"rank\":"));
buf_append_u64(&ranking_json, r2);
buf_append_lit(&ranking_json, STR_PTR(",\"confidence\":"), STR_LEN(",\"confidence\":"));
buf_append_f64(&ranking_json, confidence);
buf_append_lit(&ranking_json, STR_PTR("}"), STR_LEN("}"));
// `• #${entry.rank} [${entry.key}] ${entry.description}（置信度 ${...}%）`
buf_append_lit(&rank_lines, STR_PTR("\n• #"), STR_LEN("\n• #"));
buf_append_u64(&rank_lines, r2);
buf_append_lit(&rank_lines, STR_PTR(" ["), STR_LEN(" ["));
buf_append_buf(&rank_lines, &key);
buf_append_lit(&rank_lines, STR_PTR("] "), STR_LEN("] "));
buf_append_buf(&rank_lines, &desc);
buf_append_lit(&rank_lines, STR_PTR("（置信度 "), STR_LEN("（置信度 "));
buf_append_u64(&rank_lines, jev_percent(confidence));
buf_append_lit(&rank_lines, STR_PTR("%）"), STR_LEN("%）"));
}
buf_append_lit(&ranking_json, STR_PTR("]"), STR_LEN("]"));
// const unranked = itemKeys.filter((k) =>!picked.has(k));
// DEFECT: closure — Array.filter predicate inlined as a loop.
let unranked_json = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&unranked_json, STR_PTR("["), STR_LEN("["));
let unranked_text = ByteBuf { bytes: [0u8; 262144], len: 0};
let unranked_count: u64 = 0;
let ui: u64 = 0;
for ui in 0..items.len {
let k = ByteBuf { bytes: [0u8; 262144], len: 0};
stringmap_key_at(&items, ui, &k);
if!stringmap_has(&picked, buf_ptr(&k), k.len) {
if unranked_count > 0 {
buf_append_lit(&unranked_json, STR_PTR(","), STR_LEN(","));
buf_append_lit(&unranked_text, STR_PTR("、"), STR_LEN("、"));
};
buf_append_json_str(&unranked_json, buf_ptr(&k), k.len);
buf_append_lit(&unranked_text, STR_PTR("["), STR_LEN("["));
buf_append_buf(&unranked_text, &k);
buf_append_lit(&unranked_text, STR_PTR("]"), STR_LEN("]"));
unranked_count = unranked_count + 1;
};
}
buf_append_lit(&unranked_json, STR_PTR("]"), STR_LEN("]"));
let summary = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&summary, STR_PTR("【JEV 排序（"), STR_LEN("【JEV 排序（"));
buf_append_buf(&summary, &criterion);
buf_append_lit(&summary, STR_PTR("）】"), STR_LEN("）】"));
buf_append_buf(&summary, &rank_lines);
if unranked_count > 0 {
buf_append_lit(&summary, STR_PTR("\n• 未入围："), STR_LEN("\n• 未入围："));
buf_append_buf(&summary, &unranked_text);
};
buf_append_lit(&summary, STR_PTR("\n• 耗时："), STR_LEN("\n• 耗时："));
buf_append_u64(&summary, call.latencyMs);
buf_append_lit(&summary, STR_PTR("ms · 模型："), STR_LEN("ms · 模型："));
buf_append(&summary, js_ptr(&creds.model), creds.model.len);
let stdout = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&stdout, STR_PTR("{\"action\":\"jev_rank\",\"criterion\":"), STR_LEN("{\"action\":\"jev_rank\",\"criterion\":"));
buf_append_json_str(&stdout, buf_ptr(&criterion), criterion.len);
buf_append_lit(&stdout, STR_PTR(",\"ranking\":"), STR_LEN(",\"ranking\":"));
buf_append_buf(&stdout, &ranking_json);
buf_append_lit(&stdout, STR_PTR(",\"unranked\":"), STR_LEN(",\"unranked\":"));
buf_append_buf(&stdout, &unranked_json);
buf_append_lit(&stdout, STR_PTR(",\"summary\":"), STR_LEN(",\"summary\":"));
buf_append_json_str(&stdout, buf_ptr(&summary), summary.len);
buf_append_lit(&stdout, STR_PTR(",\"latencyMs\":"), STR_LEN(",\"latencyMs\":"));
buf_append_u64(&stdout, call.latencyMs);
buf_append_lit(&stdout, STR_PTR(",\"raw\":"), STR_LEN(",\"raw\":"));
buf_append(&stdout, call_data_ptr(&call), call.data_len);
buf_append_lit(&stdout, STR_PTR("}"), STR_LEN("}"));
jev_fill_success(out, &stdout, startedAt);
return 0;
}

//*
//* Advisory task-scope triage (范围把关, purely opt-in).
//* The model submits a task (optionally with candidate split phases); JEV
//* returns a size verdict and, when phases are given, the weakest unit.
//
// TS: export async function nativeJevScope(...): Promise<JevRunResult>
// DEFECT: async
fn nativeJevScope(state: &JevModuleState, rawInput: &JevRunInput, policy: &JevPolicyConfig, cwd_ptr: ptr, cwd_len: u64, startedAt: u64, out: &JevRunResult) -> i32 {
// const rawTask = (cast).task?? rawInput.question?? (cast).prompt?? (cast).goal?? rawInput.content;
let t_raw = ByteBuf { bytes: [0u8; 262144], len: 0};
let has_t = input_dyn_str(rawInput, STR_PTR("task"), STR_LEN("task"), &t_raw);
if!has_t { has_t = input_str_field(rawInput, 0, &t_raw);};
if!has_t { has_t = input_dyn_str(rawInput, STR_PTR("prompt"), STR_LEN("prompt"), &t_raw);};
if!has_t { has_t = input_dyn_str(rawInput, STR_PTR("goal"), STR_LEN("goal"), &t_raw);};
if!has_t { has_t = input_str_field(rawInput, 2, &t_raw);};
let task = ByteBuf { bytes: [0u8; 262144], len: 0};
str_trim_into(&task, buf_ptr(&t_raw), t_raw.len);
if task.len == 0 {
return jev_input_error(out, STR_PTR("action 'jev_scope' requires a non-empty 'task' parameter"), STR_LEN("action 'jev_scope' requires a non-empty 'task' parameter"));
};
// const rawPhases = (cast).phases?? rawInput.options?? (cast).units;
let raw_phases = ByteBuf { bytes: [0u8; 262144], len: 0};
let raw_kind: u64 = 0;
if!input_dyn_json(rawInput, STR_PTR("phases"), STR_LEN("phases"), &raw_phases, &raw_kind) {
if!input_json_field(rawInput, 4, &raw_phases, &raw_kind) {
input_dyn_json(rawInput, STR_PTR("units"), STR_LEN("units"), &raw_phases, &raw_kind);
};
};
let phases = StringMap { key_off: [0u64; 64], key_len: [0u64; 64], val_off: [0u64; 64], val_len: [0u64; 64], keys_bytes: [0u8; 8192], keys_len: 0, vals_bytes: [0u8; 65536], vals_len: 0, len: 0};
normalizeChoiceOptions(buf_ptr(&raw_phases), raw_phases.len, raw_kind, &phases);
if phases.len > 6 {
jev_map_truncate(&phases, 6);
};
let ctx_kind: u64 = 0;
let ctx_raw = ByteBuf { bytes: [0u8; 262144], len: 0};
jev_pick_context(rawInput, &ctx_kind, &ctx_raw);
let context = ByteBuf { bytes: [0u8; 262144], len: 0};
truncateJevContext(buf_ptr(&ctx_raw), ctx_raw.len, ctx_kind, &context);
let creds = JevCredentials { baseUrl: JevStr { bytes: [0u8; 8192], len: 0}, apiKey: JevStr { bytes: [0u8; 8192], len: 0}, model: JevStr { bytes: [0u8; 8192], len: 0}, providerId: JevStr { bytes: [0u8; 8192], len: 0}, groupId: JevStr { bytes: [0u8; 8192], len: 0}, bridgeProtocol: JevStr { bytes: [0u8; 8192], len: 0}, timeoutMs: 0};
resolveJevCredentials(state, rawInput, &creds);
let scope_map = StringMap { key_off: [0u64; 64], key_len: [0u64; 64], val_off: [0u64; 64], val_len: [0u64; 64], keys_bytes: [0u8; 8192], keys_len: 0, vals_bytes: [0u8; 65536], vals_len: 0, len: 0};
JEV_SCOPE_VERDICTS(&scope_map);
let scope_json = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_map_json(&scope_json, &scope_map);
let instr_size = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&instr_size, STR_PTR("Is this task rightly sized for a single delivery? Task: "), STR_LEN("Is this task rightly sized for a single delivery? Task: "));
buf_append_buf(&instr_size, &task);
let questions = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&questions, STR_PTR("{"), STR_LEN("{"));
buf_append_question(&questions, STR_PTR("size"), STR_LEN("size"), STR_PTR("choice"), STR_LEN("choice"), &instr_size, buf_ptr(&scope_json), scope_json.len);
if phases.len > 0 {
let instr_w = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&instr_w, STR_PTR("Which candidate split unit is riskiest or least clearly defined? Task: "), STR_LEN("Which candidate split unit is riskiest or least clearly defined? Task: "));
buf_append_buf(&instr_w, &task);
let phases_json = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_map_json(&phases_json, &phases);
buf_append_lit(&questions, STR_PTR(","), STR_LEN(","));
buf_append_question(&questions, STR_PTR("weakest_unit"), STR_LEN("weakest_unit"), STR_PTR("choice"), STR_LEN("choice"), &instr_w, buf_ptr(&phases_json), phases_json.len);
};
buf_append_lit(&questions, STR_PTR("}"), STR_LEN("}"));
let state_text = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&state_text, STR_PTR("[Task]\n"), STR_LEN("[Task]\n"));
buf_append_buf(&state_text, &task);
buf_append_lit(&state_text, STR_PTR("\n\n[Context]\n"), STR_LEN("\n\n[Context]\n"));
buf_append_buf(&state_text, &context);
let payload = JevPayload { state: ByteBuf { bytes: [0u8; 262144], len: 0}, model: JevStr { bytes: [0u8; 8192], len: 0}, questions: ByteBuf { bytes: [0u8; 262144], len: 0}};
jev_make_payload(&state_text, &creds, &questions, &payload);
let call = JevCallResult { ok: false, data_doc: 0, data_bytes: [0u8; 262144], data_len: 0, latencyMs: 0, has_status: false, status: 0, error_bytes: [0u8; 16384], error_len: 0};
let rc = executeJevCall(state, &payload, &creds, &call);
if rc == 2 { return jev_overload_error(state, out);};
if!call.ok {
let err = ByteBuf { bytes: [0u8; 262144], len: 0};
call_error_into(&call, &err);
let stderr = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&stderr, STR_PTR("JEV scope triage failed ("), STR_LEN("JEV scope triage failed ("));
if call.has_status {
buf_append_i64(&stderr, call.status as i64);
} else {
buf_append_lit(&stderr, STR_PTR("502"), STR_LEN("502"));
};
buf_append_lit(&stderr, STR_PTR("): "), STR_LEN("): "));
buf_append_buf(&stderr, &err);
jev_fill_failure(out, call.has_status, call.status, buf_ptr(&err), err.len, &stderr, true, startedAt);
return 0;
};
let sizeKey = ByteBuf { bytes: [0u8; 262144], len: 0};
jev_answer_choice(call.data_doc, STR_PTR("size"), STR_LEN("size"), &sizeKey);
let sizeConfidence = jev_answer_confidence(call.data_doc, STR_PTR("size"), STR_LEN("size"));
let weakestUnit = ByteBuf { bytes: [0u8; 262144], len: 0};
let weakestConfidence: f64 = 1.0;
if phases.len > 0 {
let rawWeakest = ByteBuf { bytes: [0u8; 262144], len: 0};
jev_answer_choice(call.data_doc, STR_PTR("weakest_unit"), STR_LEN("weakest_unit"), &rawWeakest);
if stringmap_has(&phases, buf_ptr(&rawWeakest), rawWeakest.len) {
buf_copy_into(&weakestUnit, &rawWeakest);
};
weakestConfidence = jev_answer_confidence(call.data_doc, STR_PTR("weakest_unit"), STR_LEN("weakest_unit"));
};
let sizeDesc = ByteBuf { bytes: [0u8; 262144], len: 0};
if!stringmap_get(&scope_map, buf_ptr(&sizeKey), sizeKey.len, &sizeDesc) || sizeDesc.len == 0 {
buf_copy_into(&sizeDesc, &sizeKey);
};
let summary = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&summary, STR_PTR("\n• 体量裁决：["), STR_LEN("\n• 体量裁决：["));
buf_append_buf(&summary, &sizeKey);
buf_append_lit(&summary, STR_PTR("] "), STR_LEN("] "));
buf_append_buf(&summary, &sizeDesc);
buf_append_lit(&summary, STR_PTR("（置信度 "), STR_LEN("（置信度 "));
buf_append_u64(&summary, jev_percent(sizeConfidence));
buf_append_lit(&summary, STR_PTR("%）"), STR_LEN("%）"));
if weakestUnit.len > 0 {
let wdesc = ByteBuf { bytes: [0u8; 262144], len: 0};
stringmap_get(&phases, buf_ptr(&weakestUnit), weakestUnit.len, &wdesc);
buf_append_lit(&summary, STR_PTR("\n• 最弱环节：["), STR_LEN("\n• 最弱环节：["));
buf_append_buf(&summary, &weakestUnit);
buf_append_lit(&summary, STR_PTR("] "), STR_LEN("] "));
buf_append_buf(&summary, &wdesc);
buf_append_lit(&summary, STR_PTR("（置信度 "), STR_LEN("（置信度 "));
buf_append_u64(&summary, jev_percent(weakestConfidence));
buf_append_lit(&summary, STR_PTR("%）"), STR_LEN("%）"));
};
buf_append_lit(&summary, STR_PTR("\n• 任务："), STR_LEN("\n• 任务："));
buf_append_buf(&summary, &task);
buf_append_lit(&summary, STR_PTR("\n• 耗时："), STR_LEN("\n• 耗时："));
buf_append_u64(&summary, call.latencyMs);
buf_append_lit(&summary, STR_PTR("ms · 模型："), STR_LEN("ms · 模型："));
buf_append(&summary, js_ptr(&creds.model), creds.model.len);
let stdout = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&stdout, STR_PTR("{\"action\":\"jev_scope\",\"task\":"), STR_LEN("{\"action\":\"jev_scope\",\"task\":"));
buf_append_json_str(&stdout, buf_ptr(&task), task.len);
buf_append_lit(&stdout, STR_PTR(",\"size_verdict\":"), STR_LEN(",\"size_verdict\":"));
buf_append_json_str(&stdout, buf_ptr(&sizeKey), sizeKey.len);
buf_append_lit(&stdout, STR_PTR(",\"size_confidence\":"), STR_LEN(",\"size_confidence\":"));
buf_append_f64(&stdout, sizeConfidence);
buf_append_lit(&stdout, STR_PTR(",\"size_description\":"), STR_LEN(",\"size_description\":"));
buf_append_json_str(&stdout, buf_ptr(&sizeDesc), sizeDesc.len);
buf_append_lit(&stdout, STR_PTR(",\"weakest_unit\":"), STR_LEN(",\"weakest_unit\":"));
if weakestUnit.len > 0 {
buf_append_json_str(&stdout, buf_ptr(&weakestUnit), weakestUnit.len);
} else {
buf_append_lit(&stdout, STR_PTR("null"), STR_LEN("null"));
};
buf_append_lit(&stdout, STR_PTR(",\"weakest_confidence\":"), STR_LEN(",\"weakest_confidence\":"));
buf_append_f64(&stdout, weakestConfidence);
buf_append_lit(&stdout, STR_PTR(",\"summary\":"), STR_LEN(",\"summary\":"));
buf_append_json_str(&stdout, buf_ptr(&summary), summary.len);
buf_append_lit(&stdout, STR_PTR(",\"latencyMs\":"), STR_LEN(",\"latencyMs\":"));
buf_append_u64(&stdout, call.latencyMs);
buf_append_lit(&stdout, STR_PTR(",\"raw\":"), STR_LEN(",\"raw\":"));
buf_append(&stdout, call_data_ptr(&call), call.data_len);
buf_append_lit(&stdout, STR_PTR("}"), STR_LEN("}"));
jev_fill_success(out, &stdout, startedAt);
return 0;
}

//* Dispatch strategy verdicts for `jev_dispatch` (subagents 分配前门禁). 
// export const JEV_DISPATCH_STRATEGIES: Record<string, string> = {...};
fn JEV_DISPATCH_STRATEGIES(out: &StringMap) -> void {
stringmap_init(out);
stringmap_set_lit(out, STR_PTR("single"), STR_LEN("single"), STR_PTR("单 agent 直做，无需拆分或派 subagents"), STR_LEN("单 agent 直做，无需拆分或派 subagents"));
stringmap_set_lit(out, STR_PTR("parallel"), STR_LEN("parallel"), STR_PTR("子任务相互独立，可并行派多个 subagents"), STR_LEN("子任务相互独立，可并行派多个 subagents"));
stringmap_set_lit(out, STR_PTR("sequential"), STR_LEN("sequential"), STR_PTR("子任务有依赖，必须串行执行，一次只派一个"), STR_LEN("子任务有依赖，必须串行执行，一次只派一个"));
stringmap_set_lit(out, STR_PTR("parallel_batches"), STR_LEN("parallel_batches"), STR_PTR("部分独立部分依赖，按批次并行，每批内并行、批间串行"), STR_LEN("部分独立部分依赖，按批次并行，每批内并行、批间串行"));
}

//*
//* Advisory subagent-dispatch gate (分配前门禁, purely opt-in but REQUIRED before Task/subagents).
//* The model submits a task plus optional candidate subtasks (2~6); JEV returns
//* a dispatch strategy (single/parallel/sequential/parallel_batches), the weakest
//* unit, and a deterministic dispatch_plan with parallelism. Bridge-safe:
//* task<=question, subtasks<=options, constraints<=context, slots<=target.
//
// TS: export async function nativeJevDispatch(...): Promise<JevRunResult>
// DEFECT: async
fn nativeJevDispatch(state: &JevModuleState, rawInput: &JevRunInput, policy: &JevPolicyConfig, cwd_ptr: ptr, cwd_len: u64, startedAt: u64, out: &JevRunResult) -> i32 {
// const rawTask = (cast).task?? rawInput.question?? (cast).prompt?? (cast).goal?? rawInput.content;
let t_raw = ByteBuf { bytes: [0u8; 262144], len: 0};
let has_t = input_dyn_str(rawInput, STR_PTR("task"), STR_LEN("task"), &t_raw);
if!has_t { has_t = input_str_field(rawInput, 0, &t_raw);};
if!has_t { has_t = input_dyn_str(rawInput, STR_PTR("prompt"), STR_LEN("prompt"), &t_raw);};
if!has_t { has_t = input_dyn_str(rawInput, STR_PTR("goal"), STR_LEN("goal"), &t_raw);};
if!has_t { has_t = input_str_field(rawInput, 2, &t_raw);};
let task = ByteBuf { bytes: [0u8; 262144], len: 0};
str_trim_into(&task, buf_ptr(&t_raw), t_raw.len);
if task.len == 0 {
return jev_input_error(out, STR_PTR("action 'jev_dispatch' requires a non-empty 'task' parameter (alias: 'question')"), STR_LEN("action 'jev_dispatch' requires a non-empty 'task' parameter (alias: 'question')"));
};
// const rawSubtasks = (cast).subtasks?? rawInput.options?? (cast).items?? (cast).phases?? (cast).choices;
let raw_subs = ByteBuf { bytes: [0u8; 262144], len: 0};
let raw_kind: u64 = 0;
let has_raw_subs = input_dyn_json(rawInput, STR_PTR("subtasks"), STR_LEN("subtasks"), &raw_subs, &raw_kind);
if!has_raw_subs { has_raw_subs = input_json_field(rawInput, 4, &raw_subs, &raw_kind);};
if!has_raw_subs { has_raw_subs = input_dyn_json(rawInput, STR_PTR("items"), STR_LEN("items"), &raw_subs, &raw_kind);};
if!has_raw_subs { has_raw_subs = input_dyn_json(rawInput, STR_PTR("phases"), STR_LEN("phases"), &raw_subs, &raw_kind);};
if!has_raw_subs { has_raw_subs = input_dyn_json(rawInput, STR_PTR("choices"), STR_LEN("choices"), &raw_subs, &raw_kind);};
// const hasSubtasks = rawSubtasks!== undefined && rawSubtasks!== null
// && (typeof rawSubtasks!== "string" || rawSubtasks.trim()!== "");
let hasSubtasks = false;
if has_raw_subs && raw_kind!= 0 {
if raw_kind == 1 {
let t = ByteBuf { bytes: [0u8; 262144], len: 0};
// String values in the JSON buffer are raw text here; a
// blank string value has an empty decoded form — the
// field accessor stores decoded strings for kind 1.
str_trim_into(&t, buf_ptr(&raw_subs), raw_subs.len);
hasSubtasks = t.len > 0;
} else {
hasSubtasks = true;
};
};
let subtasks = StringMap { key_off: [0u64; 64], key_len: [0u64; 64], val_off: [0u64; 64], val_len: [0u64; 64], keys_bytes: [0u8; 8192], keys_len: 0, vals_bytes: [0u8; 65536], vals_len: 0, len: 0};
normalizeChoiceOptions(buf_ptr(&raw_subs), raw_subs.len, raw_kind, &subtasks);
if hasSubtasks && subtasks.len == 1 {
return jev_input_error(out, STR_PTR("action 'jev_dispatch' requires at least 2 subtasks in 'options' when subtasks are provided (or omit 'options' for single-vs-split verdict)"), STR_LEN("action 'jev_dispatch' requires at least 2 subtasks in 'options' when subtasks are provided (or omit 'options' for single-vs-split verdict)"));
};
if subtasks.len > 6 {
jev_map_truncate(&subtasks, 6);
};
// const context = truncateJevContext(rawInput.context?? (cast).state);
// NOTE: unlike the other actions, content is NOT in this chain.
let ctx_kind: u64 = 0;
let ctx_raw = ByteBuf { bytes: [0u8; 262144], len: 0};
if rawInput.has_context {
ctx_kind = 1;
let p: ptr = PTR_NULL();
PTR_BYTE_ADD(p, &rawInput.context_bytes, 0);
buf_append(&ctx_raw, p, rawInput.context_len);
} else {
let k2: u64 = 0;
if input_dyn_json(rawInput, STR_PTR("state"), STR_LEN("state"), &ctx_raw, &k2) {
ctx_kind = k2;
if k2 == 1 {
let s = ByteBuf { bytes: [0u8; 262144], len: 0};
input_dyn_str(rawInput, STR_PTR("state"), STR_LEN("state"), &s);
buf_copy_into(&ctx_raw, &s);
};
} else {
ctx_kind = 0;
};
};
let context = ByteBuf { bytes: [0u8; 262144], len: 0};
truncateJevContext(buf_ptr(&ctx_raw), ctx_raw.len, ctx_kind, &context);
// const slotHint = ((cast).target?? "").toString().trim();
let slot_raw = ByteBuf { bytes: [0u8; 262144], len: 0};
input_dyn_str(rawInput, STR_PTR("target"), STR_LEN("target"), &slot_raw);
let slotHint = ByteBuf { bytes: [0u8; 262144], len: 0};
str_trim_into(&slotHint, buf_ptr(&slot_raw), slot_raw.len);
let creds = JevCredentials { baseUrl: JevStr { bytes: [0u8; 8192], len: 0}, apiKey: JevStr { bytes: [0u8; 8192], len: 0}, model: JevStr { bytes: [0u8; 8192], len: 0}, providerId: JevStr { bytes: [0u8; 8192], len: 0}, groupId: JevStr { bytes: [0u8; 8192], len: 0}, bridgeProtocol: JevStr { bytes: [0u8; 8192], len: 0}, timeoutMs: 0};
resolveJevCredentials(state, rawInput, &creds);
// const subtaskList = subtaskKeys.length > 0? subtaskKeys.map((k) => `[${k}] ${subtasks[k]}`).join("\n"): "(none — judge single vs need_split)";
// DEFECT: closure — map/join inlined as a loop.
let subtaskList = ByteBuf { bytes: [0u8; 262144], len: 0};
if subtasks.len > 0 {
let si: u64 = 0;
for si in 0..subtasks.len {
if si > 0 {
buf_append_lit(&subtaskList, STR_PTR("\n"), STR_LEN("\n"));
};
buf_append_lit(&subtaskList, STR_PTR("["), STR_LEN("["));
buf_append(&subtaskList, stringmap_key_ptr(&subtasks, si), subtasks.key_len[si]);
buf_append_lit(&subtaskList, STR_PTR("] "), STR_LEN("] "));
buf_append(&subtaskList, stringmap_val_ptr(&subtasks, si), subtasks.val_len[si]);
}
} else {
buf_append_lit(&subtaskList, STR_PTR("(none — judge single vs need_split)"), STR_LEN("(none — judge single vs need_split)"));
};
let strategies = StringMap { key_off: [0u64; 64], key_len: [0u64; 64], val_off: [0u64; 64], val_len: [0u64; 64], keys_bytes: [0u8; 8192], keys_len: 0, vals_bytes: [0u8; 65536], vals_len: 0, len: 0};
JEV_DISPATCH_STRATEGIES(&strategies);
let strat_json = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_map_json(&strat_json, &strategies);
let instr_s = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&instr_s, STR_PTR("Before spawning subagents, which dispatch strategy fits this task? Task: "), STR_LEN("Before spawning subagents, which dispatch strategy fits this task? Task: "));
buf_append_buf(&instr_s, &task);
let questions = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&questions, STR_PTR("{"), STR_LEN("{"));
buf_append_question(&questions, STR_PTR("strategy"), STR_LEN("strategy"), STR_PTR("choice"), STR_LEN("choice"), &instr_s, buf_ptr(&strat_json), strat_json.len);
if subtasks.len > 0 {
let instr_w = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&instr_w, STR_PTR("Which candidate subtask is riskiest or least clearly defined? Task: "), STR_LEN("Which candidate subtask is riskiest or least clearly defined? Task: "));
buf_append_buf(&instr_w, &task);
let subs_json = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_map_json(&subs_json, &subtasks);
buf_append_lit(&questions, STR_PTR(","), STR_LEN(","));
buf_append_question(&questions, STR_PTR("weakest_unit"), STR_LEN("weakest_unit"), STR_PTR("choice"), STR_LEN("choice"), &instr_w, buf_ptr(&subs_json), subs_json.len);
};
buf_append_lit(&questions, STR_PTR("}"), STR_LEN("}"));
let state_text = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&state_text, STR_PTR("[Task]\n"), STR_LEN("[Task]\n"));
buf_append_buf(&state_text, &task);
buf_append_lit(&state_text, STR_PTR("\n\n[Candidate Subtasks]\n"), STR_LEN("\n\n[Candidate Subtasks]\n"));
buf_append_buf(&state_text, &subtaskList);
buf_append_lit(&state_text, STR_PTR("\n\n[Constraints]\n"), STR_LEN("\n\n[Constraints]\n"));
buf_append_buf(&state_text, &context);
buf_append_lit(&state_text, STR_PTR("\n\n[Slots]\n"), STR_LEN("\n\n[Slots]\n"));
if slotHint.len > 0 {
buf_append_buf(&state_text, &slotHint);
} else {
buf_append_lit(&state_text, STR_PTR("(no slot hint)"), STR_LEN("(no slot hint)"));
};
let payload = JevPayload { state: ByteBuf { bytes: [0u8; 262144], len: 0}, model: JevStr { bytes: [0u8; 8192], len: 0}, questions: ByteBuf { bytes: [0u8; 262144], len: 0}};
jev_make_payload(&state_text, &creds, &questions, &payload);
let call = JevCallResult { ok: false, data_doc: 0, data_bytes: [0u8; 262144], data_len: 0, latencyMs: 0, has_status: false, status: 0, error_bytes: [0u8; 16384], error_len: 0};
let rc = executeJevCall(state, &payload, &creds, &call);
if rc == 2 { return jev_overload_error(state, out);};
if!call.ok {
let err = ByteBuf { bytes: [0u8; 262144], len: 0};
call_error_into(&call, &err);
let stderr = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&stderr, STR_PTR("JEV dispatch gate failed ("), STR_LEN("JEV dispatch gate failed ("));
if call.has_status {
buf_append_i64(&stderr, call.status as i64);
} else {
buf_append_lit(&stderr, STR_PTR("502"), STR_LEN("502"));
};
buf_append_lit(&stderr, STR_PTR("): "), STR_LEN("): "));
buf_append_buf(&stderr, &err);
jev_fill_failure(out, call.has_status, call.status, buf_ptr(&err), err.len, &stderr, true, startedAt);
return 0;
};
// const rawStrategy =....trim().toLowerCase()...;
// const strategy = JEV_DISPATCH_STRATEGIES[rawStrategy]!== undefined? rawStrategy: "single";
let strat_raw = ByteBuf { bytes: [0u8; 262144], len: 0};
jev_answer_choice(call.data_doc, STR_PTR("strategy"), STR_LEN("strategy"), &strat_raw);
let strat_lower = ByteBuf { bytes: [0u8; 262144], len: 0};
str_lower_into(&strat_lower, buf_ptr(&strat_raw), strat_raw.len);
let strategy = ByteBuf { bytes: [0u8; 262144], len: 0};
if stringmap_has(&strategies, buf_ptr(&strat_lower), strat_lower.len) {
buf_copy_into(&strategy, &strat_lower);
} else {
buf_append_lit(&strategy, STR_PTR("single"), STR_LEN("single"));
};
let strategyConfidence = jev_answer_confidence(call.data_doc, STR_PTR("strategy"), STR_LEN("strategy"));
let weakestUnit = ByteBuf { bytes: [0u8; 262144], len: 0};
let weakestConfidence: f64 = 1.0;
if subtasks.len > 0 {
let rawWeakest = ByteBuf { bytes: [0u8; 262144], len: 0};
jev_answer_choice(call.data_doc, STR_PTR("weakest_unit"), STR_LEN("weakest_unit"), &rawWeakest);
if stringmap_has(&subtasks, buf_ptr(&rawWeakest), rawWeakest.len) {
buf_copy_into(&weakestUnit, &rawWeakest);
};
weakestConfidence = jev_answer_confidence(call.data_doc, STR_PTR("weakest_unit"), STR_LEN("weakest_unit"));
};
// const slotMatch = `${slotHint}\n${context}`.match(/max_parallel\s*=\s*(\d+)/i);
// const hintedParallel = slotMatch? Math.max(1, Math.min(8, parseInt(slotMatch[1]!, 10))): 0;
// DEFECT: regex — the match is a manual case-insensitive scan
// for "max_parallel", optional spaces, '=', optional spaces,
// then digits.
let hintedParallel: u64 = 0;
let hay = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_buf(&hay, &slotHint);
buf_append_lit(&hay, STR_PTR("\n"), STR_LEN("\n"));
buf_append_buf(&hay, &context);
let mpos = str_index_of_ci(buf_ptr(&hay), hay.len, STR_PTR("max_parallel"), STR_LEN("max_parallel"));
if mpos >= 0 {
let p = (mpos as u64) + STR_LEN("max_parallel");
while p < hay.len {
let b: u8 = 0;
PTR_BYTE_AT(b, buf_ptr(&hay), p);
if b!= 32 && b!= 9 { break;};
p = p + 1;
}
if p < hay.len {
let b: u8 = 0;
PTR_BYTE_AT(b, buf_ptr(&hay), p);
if b == 61 {
p = p + 1;
while p < hay.len {
let b2: u8 = 0;
PTR_BYTE_AT(b2, buf_ptr(&hay), p);
if b2!= 32 && b2!= 9 { break;};
p = p + 1;
}
let v: u64 = 0;
let any = false;
while p < hay.len {
let b3: u8 = 0;
PTR_BYTE_AT(b3, buf_ptr(&hay), p);
if b3 < 48 || b3 > 57 { break;};
v = v * 10 + (b3 - 48) as u64;
any = true;
p = p + 1;
}
if any {
if v < 1 { v = 1;};
if v > 8 { v = 8;};
hintedParallel = v;
};
};
};
};
let n = subtasks.len;
let parallelism: u64 = 0;
if hintedParallel > 0 {
parallelism = hintedParallel;
} else {
if jev_str_eq(buf_ptr(&strategy), strategy.len, STR_PTR("single"), STR_LEN("single")) || jev_str_eq(buf_ptr(&strategy), strategy.len, STR_PTR("sequential"), STR_LEN("sequential")) || n == 0 {
parallelism = 1;
} else {
if jev_str_eq(buf_ptr(&strategy), strategy.len, STR_PTR("parallel"), STR_LEN("parallel")) {
parallelism = n;
if parallelism < 1 { parallelism = 1;};
if parallelism > 8 { parallelism = 8;};
} else {
parallelism = n;
if parallelism < 1 { parallelism = 1;};
if parallelism > 4 { parallelism = 4;};
};
};
};
// const dispatchPlan =... (deterministic per strategy)
let plan_json = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&plan_json, STR_PTR("["), STR_LEN("["));
if n == 0 || jev_str_eq(buf_ptr(&strategy), strategy.len, STR_PTR("single"), STR_LEN("single")) {
buf_append_lit(&plan_json, STR_PTR("{\"key\":\"single\",\"description\":"), STR_LEN("{\"key\":\"single\",\"description\":"));
buf_append_json_str(&plan_json, buf_ptr(&task), task.len);
buf_append_lit(&plan_json, STR_PTR(",\"batch\":1}"), STR_LEN(",\"batch\":1}"));
} else {
let is_seq = jev_str_eq(buf_ptr(&strategy), strategy.len, STR_PTR("sequential"), STR_LEN("sequential"));
let is_par = jev_str_eq(buf_ptr(&strategy), strategy.len, STR_PTR("parallel"), STR_LEN("parallel"));
let half = (n + 1) / 2;
let pi: u64 = 0;
for pi in 0..n {
if pi > 0 {
buf_append_lit(&plan_json, STR_PTR(","), STR_LEN(","));
};
let batch: u64 = 1;
if is_seq {
batch = pi + 1;
} else {
if!is_par {
// parallel_batches: i < Math.ceil(n / 2)? 1: 2
if pi >= half { batch = 2;};
};
};
buf_append_lit(&plan_json, STR_PTR("{\"key\":"), STR_LEN("{\"key\":"));
buf_append_json_str(&plan_json, stringmap_key_ptr(&subtasks, pi), subtasks.key_len[pi]);
buf_append_lit(&plan_json, STR_PTR(",\"description\":"), STR_LEN(",\"description\":"));
let d = ByteBuf { bytes: [0u8; 262144], len: 0};
stringmap_val_at(&subtasks, pi, &d);
buf_append_json_str(&plan_json, buf_ptr(&d), d.len);
buf_append_lit(&plan_json, STR_PTR(",\"batch\":"), STR_LEN(",\"batch\":"));
buf_append_u64(&plan_json, batch);
buf_append_lit(&plan_json, STR_PTR("}"), STR_LEN("}"));
}
};
buf_append_lit(&plan_json, STR_PTR("]"), STR_LEN("]"));
let stratDesc = ByteBuf { bytes: [0u8; 262144], len: 0};
if!stringmap_get(&strategies, buf_ptr(&strategy), strategy.len, &stratDesc) || stratDesc.len == 0 {
buf_copy_into(&stratDesc, &strategy);
};
let summary = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&summary, STR_PTR("\n• 策略：["), STR_LEN("\n• 策略：["));
buf_append_buf(&summary, &strategy);
buf_append_lit(&summary, STR_PTR("] "), STR_LEN("] "));
buf_append_buf(&summary, &stratDesc);
buf_append_lit(&summary, STR_PTR("（置信度 "), STR_LEN("（置信度 "));
buf_append_u64(&summary, jev_percent(strategyConfidence));
buf_append_lit(&summary, STR_PTR("%）"), STR_LEN("%）"));
if weakestUnit.len > 0 {
let wdesc = ByteBuf { bytes: [0u8; 262144], len: 0};
stringmap_get(&subtasks, buf_ptr(&weakestUnit), weakestUnit.len, &wdesc);
buf_append_lit(&summary, STR_PTR("\n• 最弱环节：["), STR_LEN("\n• 最弱环节：["));
buf_append_buf(&summary, &weakestUnit);
buf_append_lit(&summary, STR_PTR("] "), STR_LEN("] "));
buf_append_buf(&summary, &wdesc);
buf_append_lit(&summary, STR_PTR("（置信度 "), STR_LEN("（置信度 "));
buf_append_u64(&summary, jev_percent(weakestConfidence));
buf_append_lit(&summary, STR_PTR("%）"), STR_LEN("%）"));
};
buf_append_lit(&summary, STR_PTR("\n• 并行度："), STR_LEN("\n• 并行度："));
buf_append_u64(&summary, parallelism);
buf_append_lit(&summary, STR_PTR("\n• 任务："), STR_LEN("\n• 任务："));
buf_append_buf(&summary, &task);
buf_append_lit(&summary, STR_PTR("\n• 耗时："), STR_LEN("\n• 耗时："));
buf_append_u64(&summary, call.latencyMs);
buf_append_lit(&summary, STR_PTR("ms · 模型："), STR_LEN("ms · 模型："));
buf_append(&summary, js_ptr(&creds.model), creds.model.len);
let subs_json = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_map_json(&subs_json, &subtasks);
let stdout = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&stdout, STR_PTR("{\"action\":\"jev_dispatch\",\"task\":"), STR_LEN("{\"action\":\"jev_dispatch\",\"task\":"));
buf_append_json_str(&stdout, buf_ptr(&task), task.len);
buf_append_lit(&stdout, STR_PTR(",\"strategy\":"), STR_LEN(",\"strategy\":"));
buf_append_json_str(&stdout, buf_ptr(&strategy), strategy.len);
buf_append_lit(&stdout, STR_PTR(",\"strategy_confidence\":"), STR_LEN(",\"strategy_confidence\":"));
buf_append_f64(&stdout, strategyConfidence);
buf_append_lit(&stdout, STR_PTR(",\"strategy_description\":"), STR_LEN(",\"strategy_description\":"));
buf_append_json_str(&stdout, buf_ptr(&stratDesc), stratDesc.len);
buf_append_lit(&stdout, STR_PTR(",\"subtasks\":"), STR_LEN(",\"subtasks\":"));
buf_append_buf(&stdout, &subs_json);
buf_append_lit(&stdout, STR_PTR(",\"weakest_unit\":"), STR_LEN(",\"weakest_unit\":"));
if weakestUnit.len > 0 {
buf_append_json_str(&stdout, buf_ptr(&weakestUnit), weakestUnit.len);
} else {
buf_append_lit(&stdout, STR_PTR("null"), STR_LEN("null"));
};
buf_append_lit(&stdout, STR_PTR(",\"weakest_confidence\":"), STR_LEN(",\"weakest_confidence\":"));
buf_append_f64(&stdout, weakestConfidence);
buf_append_lit(&stdout, STR_PTR(",\"parallelism\":"), STR_LEN(",\"parallelism\":"));
buf_append_u64(&stdout, parallelism);
buf_append_lit(&stdout, STR_PTR(",\"dispatch_plan\":"), STR_LEN(",\"dispatch_plan\":"));
buf_append_buf(&stdout, &plan_json);
buf_append_lit(&stdout, STR_PTR(",\"summary\":"), STR_LEN(",\"summary\":"));
buf_append_json_str(&stdout, buf_ptr(&summary), summary.len);
buf_append_lit(&stdout, STR_PTR(",\"latencyMs\":"), STR_LEN(",\"latencyMs\":"));
buf_append_u64(&stdout, call.latencyMs);
buf_append_lit(&stdout, STR_PTR(",\"raw\":"), STR_LEN(",\"raw\":"));
buf_append(&stdout, call_data_ptr(&call), call.data_len);
buf_append_lit(&stdout, STR_PTR("}"), STR_LEN("}"));
jev_fill_success(out, &stdout, startedAt);
return 0;
}

//*
//* Advisory plan-vs-constraints audit (一致性审计, purely opt-in).
//* Unlike `jev_checklist` (which audits whether evidence satisfies checks),
//* this judges whether the PLAN itself violates each hard constraint:
//* per-constraint {holds, violated, unclear} plus an overall verdict.
//
// TS: export async function nativeJevConsistency(...): Promise<JevRunResult>
// DEFECT: async
fn nativeJevConsistency(state: &JevModuleState, rawInput: &JevRunInput, policy: &JevPolicyConfig, cwd_ptr: ptr, cwd_len: u64, startedAt: u64, out: &JevRunResult) -> i32 {
// const rawPlan = (cast).plan?? rawInput.question?? (cast).prompt?? rawInput.content;
let p_raw = ByteBuf { bytes: [0u8; 262144], len: 0};
let has_p = input_dyn_str(rawInput, STR_PTR("plan"), STR_LEN("plan"), &p_raw);
if!has_p { has_p = input_str_field(rawInput, 0, &p_raw);};
if!has_p { has_p = input_dyn_str(rawInput, STR_PTR("prompt"), STR_LEN("prompt"), &p_raw);};
if!has_p { has_p = input_str_field(rawInput, 2, &p_raw);};
let plan = ByteBuf { bytes: [0u8; 262144], len: 0};
str_trim_into(&plan, buf_ptr(&p_raw), p_raw.len);
if plan.len == 0 {
return jev_input_error(out, STR_PTR("action 'jev_consistency' requires a non-empty 'plan' parameter"), STR_LEN("action 'jev_consistency' requires a non-empty 'plan' parameter"));
};
// const rawConstraints = (cast).constraints?? rawInput.checks?? (cast).criteria;
let raw_cons = ByteBuf { bytes: [0u8; 262144], len: 0};
let raw_kind: u64 = 0;
if!input_dyn_json(rawInput, STR_PTR("constraints"), STR_LEN("constraints"), &raw_cons, &raw_kind) {
if!input_json_field(rawInput, 6, &raw_cons, &raw_kind) {
input_dyn_json(rawInput, STR_PTR("criteria"), STR_LEN("criteria"), &raw_cons, &raw_kind);
};
};
let constraints = StringMap { key_off: [0u64; 64], key_len: [0u64; 64], val_off: [0u64; 64], val_len: [0u64; 64], keys_bytes: [0u8; 8192], keys_len: 0, vals_bytes: [0u8; 65536], vals_len: 0, len: 0};
normalizeChecklistItems(buf_ptr(&raw_cons), raw_cons.len, raw_kind, &constraints);
if constraints.len < 1 {
return jev_input_error(out, STR_PTR("action 'jev_consistency' requires at least 1 constraint in 'constraints'"), STR_LEN("action 'jev_consistency' requires at least 1 constraint in 'constraints'"));
};
if constraints.len > 8 {
// TS deletes keys past 8 from the (re-fetched) key list.
jev_map_truncate(&constraints, 8);
};
let ctx_kind: u64 = 0;
let ctx_raw = ByteBuf { bytes: [0u8; 262144], len: 0};
jev_pick_context(rawInput, &ctx_kind, &ctx_raw);
let context = ByteBuf { bytes: [0u8; 262144], len: 0};
truncateJevContext(buf_ptr(&ctx_raw), ctx_raw.len, ctx_kind, &context);
let creds = JevCredentials { baseUrl: JevStr { bytes: [0u8; 8192], len: 0}, apiKey: JevStr { bytes: [0u8; 8192], len: 0}, model: JevStr { bytes: [0u8; 8192], len: 0}, providerId: JevStr { bytes: [0u8; 8192], len: 0}, groupId: JevStr { bytes: [0u8; 8192], len: 0}, bridgeProtocol: JevStr { bytes: [0u8; 8192], len: 0}, timeoutMs: 0};
resolveJevCredentials(state, rawInput, &creds);
let status_map = StringMap { key_off: [0u64; 64], key_len: [0u64; 64], val_off: [0u64; 64], val_len: [0u64; 64], keys_bytes: [0u8; 8192], keys_len: 0, vals_bytes: [0u8; 65536], vals_len: 0, len: 0};
JEV_CONSISTENCY_STATUS(&status_map);
let status_json = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_map_json(&status_json, &status_map);
let questions = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&questions, STR_PTR("{"), STR_LEN("{"));
let qi: u64 = 0;
for qi in 0..constraints.len {
if qi > 0 {
buf_append_lit(&questions, STR_PTR(","), STR_LEN(","));
};
let desc = ByteBuf { bytes: [0u8; 262144], len: 0};
stringmap_val_at(&constraints, qi, &desc);
let instr = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&instr, STR_PTR("Does the plan violate this constraint? Constraint: "), STR_LEN("Does the plan violate this constraint? Constraint: "));
buf_append_buf(&instr, &desc);
buf_append_question(&questions, stringmap_key_ptr(&constraints, qi), constraints.key_len[qi], STR_PTR("choice"), STR_LEN("choice"), &instr, buf_ptr(&status_json), status_json.len);
}
buf_append_lit(&questions, STR_PTR("}"), STR_LEN("}"));
let state_text = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&state_text, STR_PTR("[Plan]\n"), STR_LEN("[Plan]\n"));
buf_append_buf(&state_text, &plan);
buf_append_lit(&state_text, STR_PTR("\n\n[Context]\n"), STR_LEN("\n\n[Context]\n"));
buf_append_buf(&state_text, &context);
let payload = JevPayload { state: ByteBuf { bytes: [0u8; 262144], len: 0}, model: JevStr { bytes: [0u8; 8192], len: 0}, questions: ByteBuf { bytes: [0u8; 262144], len: 0}};
jev_make_payload(&state_text, &creds, &questions, &payload);
let call = JevCallResult { ok: false, data_doc: 0, data_bytes: [0u8; 262144], data_len: 0, latencyMs: 0, has_status: false, status: 0, error_bytes: [0u8; 16384], error_len: 0};
let rc = executeJevCall(state, &payload, &creds, &call);
if rc == 2 { return jev_overload_error(state, out);};
if!call.ok {
let err = ByteBuf { bytes: [0u8; 262144], len: 0};
call_error_into(&call, &err);
let stderr = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&stderr, STR_PTR("JEV consistency audit failed ("), STR_LEN("JEV consistency audit failed ("));
if call.has_status {
buf_append_i64(&stderr, call.status as i64);
} else {
buf_append_lit(&stderr, STR_PTR("502"), STR_LEN("502"));
};
buf_append_lit(&stderr, STR_PTR("): "), STR_LEN("): "));
buf_append_buf(&stderr, &err);
jev_fill_failure(out, call.has_status, call.status, buf_ptr(&err), err.len, &stderr, true, startedAt);
return 0;
};
// const details: Record<string, { status; confidence; description}> = {};
let details_json = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&details_json, STR_PTR("{"), STR_LEN("{"));
let detail_lines = ByteBuf { bytes: [0u8; 262144], len: 0};
let violatedCount: u64 = 0;
let unclearCount: u64 = 0;
let di: u64 = 0;
for di in 0..constraints.len {
let key = ByteBuf { bytes: [0u8; 262144], len: 0};
stringmap_key_at(&constraints, di, &key);
let desc = ByteBuf { bytes: [0u8; 262144], len: 0};
stringmap_val_at(&constraints, di, &desc);
// const rawStatus =....trim().toLowerCase()...;
// const status = rawStatus === "violated" || rawStatus === "unclear"? rawStatus: "holds";
let raw_status = ByteBuf { bytes: [0u8; 262144], len: 0};
jev_answer_choice(call.data_doc, buf_ptr(&key), key.len, &raw_status);
let lower = ByteBuf { bytes: [0u8; 262144], len: 0};
str_lower_into(&lower, buf_ptr(&raw_status), raw_status.len);
let status = ByteBuf { bytes: [0u8; 262144], len: 0};
if jev_str_eq(buf_ptr(&lower), lower.len, STR_PTR("violated"), STR_LEN("violated")) || jev_str_eq(buf_ptr(&lower), lower.len, STR_PTR("unclear"), STR_LEN("unclear")) {
buf_copy_into(&status, &lower);
} else {
buf_append_lit(&status, STR_PTR("holds"), STR_LEN("holds"));
};
let confidence = jev_answer_confidence(call.data_doc, buf_ptr(&key), key.len);
if jev_str_eq(buf_ptr(&status), status.len, STR_PTR("violated"), STR_LEN("violated")) { violatedCount = violatedCount + 1;};
if jev_str_eq(buf_ptr(&status), status.len, STR_PTR("unclear"), STR_LEN("unclear")) { unclearCount = unclearCount + 1;};
if di > 0 {
buf_append_lit(&details_json, STR_PTR(","), STR_LEN(","));
};
buf_append_json_str(&details_json, buf_ptr(&key), key.len);
buf_append_lit(&details_json, STR_PTR(":{\"status\":"), STR_LEN(":{\"status\":"));
buf_append_json_str(&details_json, buf_ptr(&status), status.len);
buf_append_lit(&details_json, STR_PTR(",\"confidence\":"), STR_LEN(",\"confidence\":"));
buf_append_f64(&details_json, confidence);
buf_append_lit(&details_json, STR_PTR(",\"description\":"), STR_LEN(",\"description\":"));
buf_append_json_str(&details_json, buf_ptr(&desc), desc.len);
buf_append_lit(&details_json, STR_PTR("}"), STR_LEN("}"));
// summary line per entry
buf_append_lit(&detail_lines, STR_PTR("\n• ["), STR_LEN("\n• ["));
buf_append_buf(&detail_lines, &key);
buf_append_lit(&detail_lines, STR_PTR("] "), STR_LEN("] "));
if jev_str_eq(buf_ptr(&status), status.len, STR_PTR("holds"), STR_LEN("holds")) {
buf_append_lit(&detail_lines, STR_PTR("✅ 满足（置信度 "), STR_LEN("✅ 满足（置信度 "));
buf_append_u64(&detail_lines, jev_percent(confidence));
buf_append_lit(&detail_lines, STR_PTR("%）"), STR_LEN("%）"));
} else {
if jev_str_eq(buf_ptr(&status), status.len, STR_PTR("violated"), STR_LEN("violated")) {
buf_append_lit(&detail_lines, STR_PTR("❌ 违反（置信度 "), STR_LEN("❌ 违反（置信度 "));
} else {
buf_append_lit(&detail_lines, STR_PTR("❓ 存疑（置信度 "), STR_LEN("❓ 存疑（置信度 "));
};
buf_append_u64(&detail_lines, jev_percent(confidence));
buf_append_lit(&detail_lines, STR_PTR("%）："), STR_LEN("%）："));
buf_append_buf(&detail_lines, &desc);
};
}
buf_append_lit(&details_json, STR_PTR("}"), STR_LEN("}"));
let consistent = violatedCount == 0;
let total = constraints.len;
let summary = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&summary, STR_PTR("\n• 总体："), STR_LEN("\n• 总体："));
if consistent {
buf_append_lit(&summary, STR_PTR("一致"), STR_LEN("一致"));
} else {
buf_append_lit(&summary, STR_PTR("存在违反"), STR_LEN("存在违反"));
};
buf_append_lit(&summary, STR_PTR("（"), STR_LEN("（"));
buf_append_u64(&summary, total - violatedCount);
buf_append_lit(&summary, STR_PTR("/"), STR_LEN("/"));
buf_append_u64(&summary, total);
buf_append_lit(&summary, STR_PTR(" 通过"), STR_LEN(" 通过"));
if unclearCount > 0 {
buf_append_lit(&summary, STR_PTR("，"), STR_LEN("，"));
buf_append_u64(&summary, unclearCount);
buf_append_lit(&summary, STR_PTR(" 项存疑"), STR_LEN(" 项存疑"));
};
buf_append_lit(&summary, STR_PTR("）"), STR_LEN("）"));
buf_append_buf(&summary, &detail_lines);
buf_append_lit(&summary, STR_PTR("\n• 耗时："), STR_LEN("\n• 耗时："));
buf_append_u64(&summary, call.latencyMs);
buf_append_lit(&summary, STR_PTR("ms · 模型："), STR_LEN("ms · 模型："));
buf_append(&summary, js_ptr(&creds.model), creds.model.len);
let stdout = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&stdout, STR_PTR("{\"action\":\"jev_consistency\",\"plan\":"), STR_LEN("{\"action\":\"jev_consistency\",\"plan\":"));
buf_append_json_str(&stdout, buf_ptr(&plan), plan.len);
buf_append_lit(&stdout, STR_PTR(",\"consistent\":"), STR_LEN(",\"consistent\":"));
if consistent {
buf_append_lit(&stdout, STR_PTR("true"), STR_LEN("true"));
} else {
buf_append_lit(&stdout, STR_PTR("false"), STR_LEN("false"));
};
buf_append_lit(&stdout, STR_PTR(",\"violated_count\":"), STR_LEN(",\"violated_count\":"));
buf_append_u64(&stdout, violatedCount);
buf_append_lit(&stdout, STR_PTR(",\"unclear_count\":"), STR_LEN(",\"unclear_count\":"));
buf_append_u64(&stdout, unclearCount);
buf_append_lit(&stdout, STR_PTR(",\"total_count\":"), STR_LEN(",\"total_count\":"));
buf_append_u64(&stdout, total);
buf_append_lit(&stdout, STR_PTR(",\"constraints\":"), STR_LEN(",\"constraints\":"));
buf_append_buf(&stdout, &details_json);
buf_append_lit(&stdout, STR_PTR(",\"summary\":"), STR_LEN(",\"summary\":"));
buf_append_json_str(&stdout, buf_ptr(&summary), summary.len);
buf_append_lit(&stdout, STR_PTR(",\"latencyMs\":"), STR_LEN(",\"latencyMs\":"));
buf_append_u64(&stdout, call.latencyMs);
buf_append_lit(&stdout, STR_PTR(",\"raw\":"), STR_LEN(",\"raw\":"));
buf_append(&stdout, call_data_ptr(&call), call.data_len);
buf_append_lit(&stdout, STR_PTR("}"), STR_LEN("}"));
jev_fill_success(out, &stdout, startedAt);
return 0;
}

//* Completion states for `jev_done`. 
// export const JEV_DONE_STATES: Record<string, string> = { ... };
fn JEV_DONE_STATES(out: &StringMap) -> void {
    stringmap_init(out);
    stringmap_set_lit(out, STR_PTR("truly_completed"), STR_LEN("truly_completed"), STR_PTR("原始要求均有实际代码和测试支撑，无偷工减料"), STR_LEN("原始要求均有实际代码和测试支撑，无偷工减料"));
    stringmap_set_lit(out, STR_PTR("incomplete_with_todos"), STR_LEN("incomplete_with_todos"), STR_PTR("遗留 TODO、跳过未测或只完成部分子项"), STR_LEN("遗留 TODO、跳过未测或只完成部分子项"));
    stringmap_set_lit(out, STR_PTR("unverified_claim"), STR_LEN("unverified_claim"), STR_PTR("宣称完成但缺乏可信验证证据（未跑测试/编译）"), STR_LEN("宣称完成但缺乏可信验证证据（未跑测试/编译）"));
    stringmap_set_lit(out, STR_PTR("diverged"), STR_LEN("diverged"), STR_PTR("解决的问题并非用户最初要的问题"), STR_LEN("解决的问题并非用户最初要的问题"));
}

//* Delivery verdicts for `jev_done`. 
// export const JEV_DONE_VERDICTS: Record<string, string> = { ... };
fn JEV_DONE_VERDICTS(out: &StringMap) -> void {
    stringmap_init(out);
    stringmap_set_lit(out, STR_PTR("deliver_to_user"), STR_LEN("deliver_to_user"), STR_PTR("可向用户汇报交付"), STR_LEN("可向用户汇报交付"));
    stringmap_set_lit(out, STR_PTR("keep_working"), STR_LEN("keep_working"), STR_PTR("存在缺口，必须继续工作，不得交差"), STR_LEN("存在缺口，必须继续工作，不得交差"));
}

// Marker sets for splitPackedDoneSections (TS literal arrays):
//   workMarkers = ["[actual work]", "实际工作"]
//   evMarkers = ["[verification evidence]", "[evidence]", "验证证据", "验证结果", "证据"]
//   reqMarkers = ["[original request]", "原始需求", "原始请求"]
// set_id: 0 = work, 1 = evidence, 2 = request.
// jev_find_marker returns the earliest case-insensitive index of
// any marker in the set (TS firstIndexOf over toLowerCase() text)
// and the matched marker's byte length via out_mlen; -1 when none.
// DEFECT: regex / case folding — String.toLowerCase is Unicode;
// the search folds ASCII only (the Chinese markers are unaffected).
fn jev_marker_literal(set_id: u64, which: u64, out_len: &u64) -> ptr {
    if set_id == 0 {
        if which == 0 { *out_len = STR_LEN("[actual work]"); return STR_PTR("[actual work]"); };
        *out_len = STR_LEN("实际工作");
        return STR_PTR("实际工作");
    };
    if set_id == 1 {
        if which == 0 { *out_len = STR_LEN("[verification evidence]"); return STR_PTR("[verification evidence]"); };
        if which == 1 { *out_len = STR_LEN("[evidence]"); return STR_PTR("[evidence]"); };
        if which == 2 { *out_len = STR_LEN("验证证据"); return STR_PTR("验证证据"); };
        if which == 3 { *out_len = STR_LEN("验证结果"); return STR_PTR("验证结果"); };
        *out_len = STR_LEN("证据");
        return STR_PTR("证据");
    };
    if which == 0 { *out_len = STR_LEN("[original request]"); return STR_PTR("[original request]"); };
    if which == 1 { *out_len = STR_LEN("原始需求"); return STR_PTR("原始需求"); };
    *out_len = STR_LEN("原始请求");
    return STR_PTR("原始请求");
}

fn jev_marker_count(set_id: u64) -> u64 {
    if set_id == 0 { return 2; };
    if set_id == 1 { return 5; };
    return 3;
}

fn jev_find_marker(hay_ptr: ptr, hay_len: u64, set_id: u64, out_mlen: &u64) -> i64 {
    let best: i64 = -1;
    *out_mlen = 0;
    let n = jev_marker_count(set_id);
    let i: u64 = 0;
    for i in 0..n {
        let ml: u64 = 0;
        let mp: ptr = jev_marker_literal(set_id, i, &ml);
        let idx = str_index_of_ci(hay_ptr, hay_len, mp, ml);
        if idx >= 0 && (best < 0 || idx < best) {
            best = idx;
            *out_mlen = ml;
        };
    }
    return best;
}

// Whether a marker of the set starts exactly at pos; returns its
// byte length (longest match, mirroring the TS sort by length in
// splitPackedDoneSections' request-marker handling), else 0.
fn jev_marker_at(hay_ptr: ptr, hay_len: u64, pos: u64, set_id: u64) -> u64 {
    let best: u64 = 0;
    let n = jev_marker_count(set_id);
    let i: u64 = 0;
    for i in 0..n {
        let ml: u64 = 0;
        let mp: ptr = jev_marker_literal(set_id, i, &ml);
        if pos + ml <= hay_len {
            let seg: ptr = PTR_NULL();
            PTR_BYTE_ADD(seg, hay_ptr, pos);
            // Case-insensitive compare of the segment to the marker.
            let ok = true;
            let j: u64 = 0;
            while j < ml {
                let a: u8 = 0;
                let b: u8 = 0;
                PTR_BYTE_AT(a, seg, j);
                PTR_BYTE_AT(b, mp, j);
                if a >= 65 && a <= 90 { a = a + 32; };
                if b >= 65 && b <= 90 { b = b + 32; };
                if a != b { ok = false; break; };
                j = j + 1;
            }
            if ok && ml > best {
                best = ml;
            };
        };
    }
    return best;
}

// Strip a leading section marker per the TS replaces:
//   rest.replace(/^(\[actual work\]|实际工作)\s*[:：|]?\s*/i, "")
//   evPart.replace(/^(\[verification evidence\]|\[evidence\]|验证证据|验证结果|证据)\s*[:：|]?\s*/i, "")
// Returns the offset of the remaining content.
// DEFECT: regex — approximated by hand (marker, \s*, one optional
// ':' / '：' / '|', \s*).
fn jev_strip_section_prefix(src_ptr: ptr, src_len: u64, marker_len: u64) -> u64 {
    let p = marker_len;
    while p < src_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, src_ptr, p);
        if !is_ws_byte(b) { break; };
        p = p + 1;
    }
    if p < src_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, src_ptr, p);
        if b == 58 || b == 124 {
            p = p + 1;
        } else {
            if b == 239 && p + 2 < src_len {
                // '：' is EF BC 9A in UTF-8.
                let b1: u8 = 0;
                let b2: u8 = 0;
                PTR_BYTE_AT(b1, src_ptr, p + 1);
                PTR_BYTE_AT(b2, src_ptr, p + 2);
                if b1 == 188 && b2 == 154 { p = p + 3; };
            };
        };
    };
    while p < src_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, src_ptr, p);
        if !is_ws_byte(b) { break; };
        p = p + 1;
    }
    return p;
}

//*
// * Splits a bridge-packed triple back into sections. Only used when the caller
// * could only send `question` (bridge drops every other jev_done field).
// * Markers (case-insensitive): 原始需求/原始请求/[Original Request] for the
// * request, 实际工作/[Actual Work] for the work, 证据/验证证据/[Verification
// * Evidence]/[Evidence] for the evidence. Returns only sections found.
// 
// TS: export function splitPackedDoneSections(text: string): { request?: string; work?: string; evidence?: string }
// Sections are delivered through out_* + has_* (TS optional fields).
// DEFECT: regex — the marker-prefix replaces are approximated by
// jev_strip_section_prefix; case folding is ASCII-only.
fn splitPackedDoneSections(text_ptr: ptr, text_len: u64, out_req: &ByteBuf, has_req: &bool, out_work: &ByteBuf, has_work: &bool, out_ev: &ByteBuf, has_ev: &bool) -> void {
    buf_reset(out_req);
    buf_reset(out_work);
    buf_reset(out_ev);
    *has_req = false;
    *has_work = false;
    *has_ev = false;
    let work_mlen: u64 = 0;
    let workIdx = jev_find_marker(text_ptr, text_len, 0, &work_mlen);
    if workIdx < 0 { return; };
    // const requestPart = text.slice(0, workIdx).trim();
    let requestPart = ByteBuf { bytes: [0u8; 262144], len: 0 };
    str_trim_into(&requestPart, text_ptr, workIdx as u64);
    // const rest = text.slice(workIdx).replace(/^(\[actual work\]|实际工作)\s*[:：|]?\s*/i, "");
    let rest_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(rest_ptr, text_ptr, workIdx as u64);
    let rest_len = text_len - (workIdx as u64);
    let strip = jev_strip_section_prefix(rest_ptr, rest_len, work_mlen);
    let rest = ByteBuf { bytes: [0u8; 262144], len: 0 };
    let rp2: ptr = PTR_NULL();
    PTR_BYTE_ADD(rp2, rest_ptr, strip);
    buf_append(&rest, rp2, rest_len - strip);
    // const evIdx = firstIndexOf(rest.toLowerCase(), evMarkers);
    let ev_mlen: u64 = 0;
    let evIdx = jev_find_marker(buf_ptr(&rest), rest.len, 1, &ev_mlen);
    // const workPart = (evIdx >= 0 ? rest.slice(0, evIdx) : rest).trim();
    let workPart = ByteBuf { bytes: [0u8; 262144], len: 0 };
    if evIdx >= 0 {
        str_trim_into(&workPart, buf_ptr(&rest), evIdx as u64);
    } else {
        str_trim_into(&workPart, buf_ptr(&rest), rest.len);
    };
    // const evPart = evIdx >= 0 ? rest.slice(evIdx).replace(/.../i, "").trim() : "";
    let evPart = ByteBuf { bytes: [0u8; 262144], len: 0 };
    if evIdx >= 0 {
        let ev_ptr: ptr = PTR_NULL();
        PTR_BYTE_ADD(ev_ptr, buf_ptr(&rest), evIdx as u64);
        let ev_len = rest.len - (evIdx as u64);
        let strip2 = jev_strip_section_prefix(ev_ptr, ev_len, ev_mlen);
        let body = ByteBuf { bytes: [0u8; 262144], len: 0 };
        let bp: ptr = PTR_NULL();
        PTR_BYTE_ADD(bp, ev_ptr, strip2);
        buf_append(&body, bp, ev_len - strip2);
        str_trim_into(&evPart, buf_ptr(&body), body.len);
    };
    // let reqOut = requestPart;
    // const reqIdx = firstIndexOf(requestPart.toLowerCase(), reqMarkers);
    // if (reqIdx >= 0) { ... reqOut = requestPart.slice(reqIdx + marker.length).replace(/^[\s:：|]+/, "").trim(); }
    let reqOut = ByteBuf { bytes: [0u8; 262144], len: 0 };
    buf_copy_into(&reqOut, &requestPart);
    let req_mlen0: u64 = 0;
    let reqIdx = jev_find_marker(buf_ptr(&requestPart), requestPart.len, 2, &req_mlen0);
    if reqIdx >= 0 {
        // const matched = reqMarkers.filter((m) => requestPart.toLowerCase().indexOf(m) === reqIdx).sort((a, b) => b.length - a.length);
        // const marker = matched[0] ?? "";
        let mlen = jev_marker_at(buf_ptr(&requestPart), requestPart.len, reqIdx as u64, 2);
        let from = (reqIdx as u64) + mlen;
        // .replace(/^[\s:：|]+/, "") — strip leading whitespace, ':', '：', '|'.
        let p = from;
        while p < requestPart.len {
            let b: u8 = 0;
            PTR_BYTE_AT(b, buf_ptr(&requestPart), p);
            if is_ws_byte(b) || b == 58 || b == 124 {
                p = p + 1;
            } else {
                if b == 239 && p + 2 < requestPart.len {
                    let b1: u8 = 0;
                    let b2: u8 = 0;
                    PTR_BYTE_AT(b1, buf_ptr(&requestPart), p + 1);
                    PTR_BYTE_AT(b2, buf_ptr(&requestPart), p + 2);
                    if b1 == 188 && b2 == 154 { p = p + 3; } else { break; };
                } else {
                    break;
                };
            };
        }
        let seg = ByteBuf { bytes: [0u8; 262144], len: 0 };
        let sp: ptr = PTR_NULL();
        PTR_BYTE_ADD(sp, buf_ptr(&requestPart), p);
        buf_append(&seg, sp, requestPart.len - p);
        str_trim_into(&reqOut, buf_ptr(&seg), seg.len);
    };
    // return { request: reqOut || undefined, work: workPart || undefined, evidence: evPart || undefined };
    if reqOut.len > 0 {
        buf_copy_into(out_req, &reqOut);
        *has_req = true;
    };
    if workPart.len > 0 {
        buf_copy_into(out_work, &workPart);
        *has_work = true;
    };
    if evPart.len > 0 {
        buf_copy_into(out_ev, &evPart);
        *has_ev = true;
    };
}

//*
//* Advisory delivery sign-off (交付核准, purely opt-in).
//* Before telling the user "done", the model submits the original request,
//* the actual work and the verification evidence; JEV judges the completion
//* state plus an explicit deliver / keep-working verdict. Counters false
//* completion (TODO leftovers, unverified claims, diverged work).
//
// TS: export async function nativeJevDone(...): Promise<JevRunResult>
// DEFECT: async
fn nativeJevDone(state: &JevModuleState, rawInput: &JevRunInput, policy: &JevPolicyConfig, cwd_ptr: ptr, cwd_len: u64, startedAt: u64, out: &JevRunResult) -> i32 {
// const rawRequest = (cast).user_request?? (cast).request?? rawInput.question?? (cast).goal?? (cast).prompt;
let r_raw = ByteBuf { bytes: [0u8; 262144], len: 0};
let has_r = input_dyn_str(rawInput, STR_PTR("user_request"), STR_LEN("user_request"), &r_raw);
if!has_r { has_r = input_dyn_str(rawInput, STR_PTR("request"), STR_LEN("request"), &r_raw);};
if!has_r { has_r = input_str_field(rawInput, 0, &r_raw);};
if!has_r { has_r = input_dyn_str(rawInput, STR_PTR("goal"), STR_LEN("goal"), &r_raw);};
if!has_r { has_r = input_dyn_str(rawInput, STR_PTR("prompt"), STR_LEN("prompt"), &r_raw);};
let userRequest = ByteBuf { bytes: [0u8; 262144], len: 0};
str_trim_into(&userRequest, buf_ptr(&r_raw), r_raw.len);
if userRequest.len == 0 {
return jev_input_error(out, STR_PTR("action 'jev_done' requires a non-empty 'user_request' parameter"), STR_LEN("action 'jev_done' requires a non-empty 'user_request' parameter"));
};
// const rawWork = (cast).actual_work?? (cast).work?? rawInput.content?? rawInput.context;
// Bridge compat: the opencode sa_vm_run bridge forwards question+context
// for jev_done but drops content/user_request/actual_work/evidence, so the
// packed triple may arrive via context (see.opencode/skills/jev/SKILL.md).
let w_raw = ByteBuf { bytes: [0u8; 262144], len: 0};
let has_w = input_dyn_str(rawInput, STR_PTR("actual_work"), STR_LEN("actual_work"), &w_raw);
if!has_w { has_w = input_dyn_str(rawInput, STR_PTR("work"), STR_LEN("work"), &w_raw);};
if!has_w { has_w = input_str_field(rawInput, 2, &w_raw);};
if!has_w { has_w = input_str_field(rawInput, 1, &w_raw);};
let actualWork = ByteBuf { bytes: [0u8; 262144], len: 0};
str_trim_into(&actualWork, buf_ptr(&w_raw), w_raw.len);
// let evidence = (((cast).evidence)?? "").toString().trim();
let ev_raw = ByteBuf { bytes: [0u8; 262144], len: 0};
input_dyn_str(rawInput, STR_PTR("evidence"), STR_LEN("evidence"), &ev_raw);
let evidence = ByteBuf { bytes: [0u8; 262144], len: 0};
str_trim_into(&evidence, buf_ptr(&ev_raw), ev_raw.len);
let packedRequest = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_copy_into(&packedRequest, &userRequest);
// Last resort: only `question` survived transit. Callers may pack the whole
// triple into it with section markers (原始需求/实际工作/证据 or
// [Original Request]/[Actual Work]/[Verification Evidence]); split it back.
// Only triggers when actual_work is otherwise empty, so direct callers that
// pass actual_work explicitly are never affected.
if actualWork.len == 0 && packedRequest.len > 0 {
let s_req = ByteBuf { bytes: [0u8; 262144], len: 0};
let s_work = ByteBuf { bytes: [0u8; 262144], len: 0};
let s_ev = ByteBuf { bytes: [0u8; 262144], len: 0};
let has_s_req = false;
let has_s_work = false;
let has_s_ev = false;
splitPackedDoneSections(buf_ptr(&packedRequest), packedRequest.len, &s_req, &has_s_req, &s_work, &has_s_work, &s_ev, &has_s_ev);
if has_s_work {
if has_s_req {
buf_copy_into(&packedRequest, &s_req);
};
buf_copy_into(&actualWork, &s_work);
if has_s_ev {
buf_copy_into(&evidence, &s_ev);
};
};
};
if actualWork.len == 0 {
return jev_input_error(out, STR_PTR("action 'jev_done' requires a non-empty 'actual_work' parameter"), STR_LEN("action 'jev_done' requires a non-empty 'actual_work' parameter"));
};
let ctx_kind: u64 = 0;
let ctx_raw = ByteBuf { bytes: [0u8; 262144], len: 0};
jev_pick_context(rawInput, &ctx_kind, &ctx_raw);
let context = ByteBuf { bytes: [0u8; 262144], len: 0};
truncateJevContext(buf_ptr(&ctx_raw), ctx_raw.len, ctx_kind, &context);
let creds = JevCredentials { baseUrl: JevStr { bytes: [0u8; 8192], len: 0}, apiKey: JevStr { bytes: [0u8; 8192], len: 0}, model: JevStr { bytes: [0u8; 8192], len: 0}, providerId: JevStr { bytes: [0u8; 8192], len: 0}, groupId: JevStr { bytes: [0u8; 8192], len: 0}, bridgeProtocol: JevStr { bytes: [0u8; 8192], len: 0}, timeoutMs: 0};
resolveJevCredentials(state, rawInput, &creds);
let done_states = StringMap { key_off: [0u64; 64], key_len: [0u64; 64], val_off: [0u64; 64], val_len: [0u64; 64], keys_bytes: [0u8; 8192], keys_len: 0, vals_bytes: [0u8; 65536], vals_len: 0, len: 0};
JEV_DONE_STATES(&done_states);
let done_verdicts = StringMap { key_off: [0u64; 64], key_len: [0u64; 64], val_off: [0u64; 64], val_len: [0u64; 64], keys_bytes: [0u8; 8192], keys_len: 0, vals_bytes: [0u8; 65536], vals_len: 0, len: 0};
JEV_DONE_VERDICTS(&done_verdicts);
let states_json = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_map_json(&states_json, &done_states);
let verdicts_json = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_map_json(&verdicts_json, &done_verdicts);
let instr_c = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&instr_c, STR_PTR("Does the actual work with its evidence truly fulfill the original request?"), STR_LEN("Does the actual work with its evidence truly fulfill the original request?"));
let instr_d = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&instr_d, STR_PTR("Should this be delivered to the user now, or must work continue?"), STR_LEN("Should this be delivered to the user now, or must work continue?"));
let questions = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&questions, STR_PTR("{"), STR_LEN("{"));
buf_append_question(&questions, STR_PTR("completion"), STR_LEN("completion"), STR_PTR("choice"), STR_LEN("choice"), &instr_c, buf_ptr(&states_json), states_json.len);
buf_append_lit(&questions, STR_PTR(","), STR_LEN(","));
buf_append_question(&questions, STR_PTR("delivery"), STR_LEN("delivery"), STR_PTR("choice"), STR_LEN("choice"), &instr_d, buf_ptr(&verdicts_json), verdicts_json.len);
buf_append_lit(&questions, STR_PTR("}"), STR_LEN("}"));
let state_text = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&state_text, STR_PTR("[Original Request]\n"), STR_LEN("[Original Request]\n"));
buf_append_buf(&state_text, &packedRequest);
buf_append_lit(&state_text, STR_PTR("\n\n[Actual Work]\n"), STR_LEN("\n\n[Actual Work]\n"));
if actualWork.len > 0 {
buf_append_buf(&state_text, &actualWork);
} else {
buf_append_lit(&state_text, STR_PTR("(not described)"), STR_LEN("(not described)"));
};
buf_append_lit(&state_text, STR_PTR("\n\n[Verification Evidence]\n"), STR_LEN("\n\n[Verification Evidence]\n"));
if evidence.len > 0 {
buf_append_buf(&state_text, &evidence);
} else {
buf_append_lit(&state_text, STR_PTR("(no evidence provided)"), STR_LEN("(no evidence provided)"));
};
buf_append_lit(&state_text, STR_PTR("\n\n[Context]\n"), STR_LEN("\n\n[Context]\n"));
buf_append_buf(&state_text, &context);
let payload = JevPayload { state: ByteBuf { bytes: [0u8; 262144], len: 0}, model: JevStr { bytes: [0u8; 8192], len: 0}, questions: ByteBuf { bytes: [0u8; 262144], len: 0}};
jev_make_payload(&state_text, &creds, &questions, &payload);
let call = JevCallResult { ok: false, data_doc: 0, data_bytes: [0u8; 262144], data_len: 0, latencyMs: 0, has_status: false, status: 0, error_bytes: [0u8; 16384], error_len: 0};
let rc = executeJevCall(state, &payload, &creds, &call);
if rc == 2 { return jev_overload_error(state, out);};
if!call.ok {
let err = ByteBuf { bytes: [0u8; 262144], len: 0};
call_error_into(&call, &err);
let stderr = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&stderr, STR_PTR("JEV delivery sign-off failed ("), STR_LEN("JEV delivery sign-off failed ("));
if call.has_status {
buf_append_i64(&stderr, call.status as i64);
} else {
buf_append_lit(&stderr, STR_PTR("502"), STR_LEN("502"));
};
buf_append_lit(&stderr, STR_PTR("): "), STR_LEN("): "));
buf_append_buf(&stderr, &err);
jev_fill_failure(out, call.has_status, call.status, buf_ptr(&err), err.len, &stderr, true, startedAt);
return 0;
};
let completionKey = ByteBuf { bytes: [0u8; 262144], len: 0};
jev_answer_choice(call.data_doc, STR_PTR("completion"), STR_LEN("completion"), &completionKey);
let completionConfidence = jev_answer_confidence(call.data_doc, STR_PTR("completion"), STR_LEN("completion"));
let deliveryKey = ByteBuf { bytes: [0u8; 262144], len: 0};
jev_answer_choice(call.data_doc, STR_PTR("delivery"), STR_LEN("delivery"), &deliveryKey);
let deliveryConfidence = jev_answer_confidence(call.data_doc, STR_PTR("delivery"), STR_LEN("delivery"));
// Audit historical regression cases touched by the request/work/evidence
// const allCases = loadRegressionCases(undefined, (cast).cwd as string | undefined);
let case_cwd = ByteBuf { bytes: [0u8; 262144], len: 0};
let has_case_cwd = input_dyn_str(rawInput, STR_PTR("cwd"), STR_LEN("cwd"), &case_cwd);
let cases = RegressionCaseList { json_bytes: [0u8; 262144], json_len: 0, len: 0};
loadRegressionCases(&cases, buf_ptr(&case_cwd), case_cwd.len, has_case_cwd);
// const auditedCases = allCases.filter((c) =>... includes checks...);
// DEFECT: closure — Array.filter predicate inlined as a loop;
// String.includes is case-sensitive in TS after toLowerCase()
// on both sides — mirrored by lowercasing both sides here.
let work_lower = ByteBuf { bytes: [0u8; 262144], len: 0};
str_lower_into(&work_lower, buf_ptr(&actualWork), actualWork.len);
let req_lower = ByteBuf { bytes: [0u8; 262144], len: 0};
str_lower_into(&req_lower, buf_ptr(&userRequest), userRequest.len);
let ev_lower = ByteBuf { bytes: [0u8; 262144], len: 0};
str_lower_into(&ev_lower, buf_ptr(&evidence), evidence.len);
let audited_json = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&audited_json, STR_PTR("["), STR_LEN("["));
let audited_ids = ByteBuf { bytes: [0u8; 262144], len: 0};
let audited_count: u64 = 0;
let ci: u64 = 0;
for ci in 0..cases.len {
let comp = ByteBuf { bytes: [0u8; 262144], len: 0};
regression_case_field(&cases, ci, STR_PTR("component"), STR_LEN("component"), &comp);
let base = ByteBuf { bytes: [0u8; 262144], len: 0};
jev_basename(buf_ptr(&comp), comp.len, &base);
let c_base = ByteBuf { bytes: [0u8; 262144], len: 0};
str_lower_into(&c_base, buf_ptr(&base), base.len);
let cid = ByteBuf { bytes: [0u8; 262144], len: 0};
regression_case_field(&cases, ci, STR_PTR("id"), STR_LEN("id"), &cid);
let c_id = ByteBuf { bytes: [0u8; 262144], len: 0};
str_lower_into(&c_id, buf_ptr(&cid), cid.len);
let matched = str_contains_ci(buf_ptr(&work_lower), work_lower.len, buf_ptr(&c_base), c_base.len)
|| str_contains_ci(buf_ptr(&req_lower), req_lower.len, buf_ptr(&c_base), c_base.len)
|| str_contains_ci(buf_ptr(&ev_lower), ev_lower.len, buf_ptr(&c_base), c_base.len)
|| str_contains_ci(buf_ptr(&ev_lower), ev_lower.len, buf_ptr(&c_id), c_id.len);
if matched {
let title = ByteBuf { bytes: [0u8; 262144], len: 0};
regression_case_field(&cases, ci, STR_PTR("title"), STR_LEN("title"), &title);
if audited_count > 0 {
buf_append_lit(&audited_json, STR_PTR(","), STR_LEN(","));
buf_append_lit(&audited_ids, STR_PTR(", "), STR_LEN(", "));
};
buf_append_lit(&audited_json, STR_PTR("{\"id\":"), STR_LEN("{\"id\":"));
buf_append_json_str(&audited_json, buf_ptr(&cid), cid.len);
buf_append_lit(&audited_json, STR_PTR(",\"title\":"), STR_LEN(",\"title\":"));
buf_append_json_str(&audited_json, buf_ptr(&title), title.len);
buf_append_lit(&audited_json, STR_PTR(",\"component\":"), STR_LEN(",\"component\":"));
buf_append_json_str(&audited_json, buf_ptr(&comp), comp.len);
buf_append_lit(&audited_json, STR_PTR("}"), STR_LEN("}"));
buf_append_buf(&audited_ids, &cid);
audited_count = audited_count + 1;
};
}
buf_append_lit(&audited_json, STR_PTR("]"), STR_LEN("]"));
let completionDesc = ByteBuf { bytes: [0u8; 262144], len: 0};
if!stringmap_get(&done_states, buf_ptr(&completionKey), completionKey.len, &completionDesc) || completionDesc.len == 0 {
buf_copy_into(&completionDesc, &completionKey);
};
let deliveryDesc = ByteBuf { bytes: [0u8; 262144], len: 0};
if!stringmap_get(&done_verdicts, buf_ptr(&deliveryKey), deliveryKey.len, &deliveryDesc) || deliveryDesc.len == 0 {
buf_copy_into(&deliveryDesc, &deliveryKey);
};
let summary = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&summary, STR_PTR("\n• 完成态：["), STR_LEN("\n• 完成态：["));
buf_append_buf(&summary, &completionKey);
buf_append_lit(&summary, STR_PTR("] "), STR_LEN("] "));
buf_append_buf(&summary, &completionDesc);
buf_append_lit(&summary, STR_PTR("（置信度 "), STR_LEN("（置信度 "));
buf_append_u64(&summary, jev_percent(completionConfidence));
buf_append_lit(&summary, STR_PTR("%）\n• 裁决：["), STR_LEN("%）\n• 裁决：["));
buf_append_buf(&summary, &deliveryKey);
buf_append_lit(&summary, STR_PTR("] "), STR_LEN("] "));
buf_append_buf(&summary, &deliveryDesc);
buf_append_lit(&summary, STR_PTR("（置信度 "), STR_LEN("（置信度 "));
buf_append_u64(&summary, jev_percent(deliveryConfidence));
buf_append_lit(&summary, STR_PTR("%）"), STR_LEN("%）"));
if audited_count > 0 {
buf_append_lit(&summary, STR_PTR("\n• 历史案例审计：关联到 "), STR_LEN("\n• 历史案例审计：关联到 "));
buf_append_u64(&summary, audited_count);
buf_append_lit(&summary, STR_PTR(" 个历史防回归案例 ["), STR_LEN(" 个历史防回归案例 ["));
buf_append_buf(&summary, &audited_ids);
buf_append_lit(&summary, STR_PTR("]"), STR_LEN("]"));
};
buf_append_lit(&summary, STR_PTR("\n• 耗时："), STR_LEN("\n• 耗时："));
buf_append_u64(&summary, call.latencyMs);
buf_append_lit(&summary, STR_PTR("ms · 模型："), STR_LEN("ms · 模型："));
buf_append(&summary, js_ptr(&creds.model), creds.model.len);
let stdout = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&stdout, STR_PTR("{\"action\":\"jev_done\",\"user_request\":"), STR_LEN("{\"action\":\"jev_done\",\"user_request\":"));
buf_append_json_str(&stdout, buf_ptr(&userRequest), userRequest.len);
buf_append_lit(&stdout, STR_PTR(",\"completion_state\":"), STR_LEN(",\"completion_state\":"));
buf_append_json_str(&stdout, buf_ptr(&completionKey), completionKey.len);
buf_append_lit(&stdout, STR_PTR(",\"completion_confidence\":"), STR_LEN(",\"completion_confidence\":"));
buf_append_f64(&stdout, completionConfidence);
buf_append_lit(&stdout, STR_PTR(",\"delivery\":"), STR_LEN(",\"delivery\":"));
buf_append_json_str(&stdout, buf_ptr(&deliveryKey), deliveryKey.len);
buf_append_lit(&stdout, STR_PTR(",\"delivery_confidence\":"), STR_LEN(",\"delivery_confidence\":"));
buf_append_f64(&stdout, deliveryConfidence);
buf_append_lit(&stdout, STR_PTR(",\"historical_regression_cases_audited\":"), STR_LEN(",\"historical_regression_cases_audited\":"));
buf_append_buf(&stdout, &audited_json);
buf_append_lit(&stdout, STR_PTR(",\"summary\":"), STR_LEN(",\"summary\":"));
buf_append_json_str(&stdout, buf_ptr(&summary), summary.len);
buf_append_lit(&stdout, STR_PTR(",\"latencyMs\":"), STR_LEN(",\"latencyMs\":"));
buf_append_u64(&stdout, call.latencyMs);
buf_append_lit(&stdout, STR_PTR(",\"raw\":"), STR_LEN(",\"raw\":"));
buf_append(&stdout, call_data_ptr(&call), call.data_len);
buf_append_lit(&stdout, STR_PTR("}"), STR_LEN("}"));
jev_fill_success(out, &stdout, startedAt);
return 0;
}

//* Fix-nature verdicts for `jev_diagnose`. 
// export const JEV_FIX_NATURE: Record<string, string> = {...};
fn JEV_FIX_NATURE(out: &StringMap) -> void {
stringmap_init(out);
stringmap_set_lit(out, STR_PTR("root_cause_fix"), STR_LEN("root_cause_fix"), STR_PTR("治本：修复真正根因"), STR_LEN("治本：修复真正根因"));
stringmap_set_lit(out, STR_PTR("symptom_patch"), STR_LEN("symptom_patch"), STR_PTR("治标：防御性补丁，缓解症状但根因仍在"), STR_LEN("治标：防御性补丁，缓解症状但根因仍在"));
stringmap_set_lit(out, STR_PTR("risky_mask"), STR_LEN("risky_mask"), STR_PTR("掩盖：可能隐藏真正错误，制造更大隐患"), STR_LEN("掩盖：可能隐藏真正错误，制造更大隐患"));
}

//*
//* Advisory root-cause arbitration (根因仲裁, purely opt-in).
//* Given an error/failure plus 2~4 hypotheses, JEV picks the most likely true
//* root cause; when a proposed fix is supplied it additionally judges whether
//* the fix cures the cause or merely patches (or masks) the symptom.
//
// TS: export async function nativeJevDiagnose(...): Promise<JevRunResult>
// DEFECT: async
fn nativeJevDiagnose(state: &JevModuleState, rawInput: &JevRunInput, policy: &JevPolicyConfig, cwd_ptr: ptr, cwd_len: u64, startedAt: u64, out: &JevRunResult) -> i32 {
// const rawError = (cast).error_summary?? (cast).error?? rawInput.question?? rawInput.content;
let e_raw = ByteBuf { bytes: [0u8; 262144], len: 0};
let has_e = input_dyn_str(rawInput, STR_PTR("error_summary"), STR_LEN("error_summary"), &e_raw);
if!has_e { has_e = input_dyn_str(rawInput, STR_PTR("error"), STR_LEN("error"), &e_raw);};
if!has_e { has_e = input_str_field(rawInput, 0, &e_raw);};
if!has_e { has_e = input_str_field(rawInput, 2, &e_raw);};
let errorSummary = ByteBuf { bytes: [0u8; 262144], len: 0};
str_trim_into(&errorSummary, buf_ptr(&e_raw), e_raw.len);
if errorSummary.len == 0 {
return jev_input_error(out, STR_PTR("action 'jev_diagnose' requires a non-empty 'error_summary' parameter"), STR_LEN("action 'jev_diagnose' requires a non-empty 'error_summary' parameter"));
};
// const rawHypotheses = (cast).hypotheses?? rawInput.options?? (cast).causes;
let raw_hyp = ByteBuf { bytes: [0u8; 262144], len: 0};
let raw_kind: u64 = 0;
if!input_dyn_json(rawInput, STR_PTR("hypotheses"), STR_LEN("hypotheses"), &raw_hyp, &raw_kind) {
if!input_json_field(rawInput, 4, &raw_hyp, &raw_kind) {
input_dyn_json(rawInput, STR_PTR("causes"), STR_LEN("causes"), &raw_hyp, &raw_kind);
};
};
let hypotheses = StringMap { key_off: [0u64; 64], key_len: [0u64; 64], val_off: [0u64; 64], val_len: [0u64; 64], keys_bytes: [0u8; 8192], keys_len: 0, vals_bytes: [0u8; 65536], vals_len: 0, len: 0};
normalizeChoiceOptions(buf_ptr(&raw_hyp), raw_hyp.len, raw_kind, &hypotheses);
if hypotheses.len < 2 {
return jev_input_error(out, STR_PTR("action 'jev_diagnose' requires at least 2 hypotheses in 'hypotheses'"), STR_LEN("action 'jev_diagnose' requires at least 2 hypotheses in 'hypotheses'"));
};
if hypotheses.len > 4 {
jev_map_truncate(&hypotheses, 4);
};
// const rawFix = (cast).proposed_fix?? (cast).fix;
let f_raw = ByteBuf { bytes: [0u8; 262144], len: 0};
let has_f = input_dyn_str(rawInput, STR_PTR("proposed_fix"), STR_LEN("proposed_fix"), &f_raw);
if!has_f { has_f = input_dyn_str(rawInput, STR_PTR("fix"), STR_LEN("fix"), &f_raw);};
let proposedFix = ByteBuf { bytes: [0u8; 262144], len: 0};
str_trim_into(&proposedFix, buf_ptr(&f_raw), f_raw.len);
let ctx_kind: u64 = 0;
let ctx_raw = ByteBuf { bytes: [0u8; 262144], len: 0};
jev_pick_context(rawInput, &ctx_kind, &ctx_raw);
let context = ByteBuf { bytes: [0u8; 262144], len: 0};
truncateJevContext(buf_ptr(&ctx_raw), ctx_raw.len, ctx_kind, &context);
let creds = JevCredentials { baseUrl: JevStr { bytes: [0u8; 8192], len: 0}, apiKey: JevStr { bytes: [0u8; 8192], len: 0}, model: JevStr { bytes: [0u8; 8192], len: 0}, providerId: JevStr { bytes: [0u8; 8192], len: 0}, groupId: JevStr { bytes: [0u8; 8192], len: 0}, bridgeProtocol: JevStr { bytes: [0u8; 8192], len: 0}, timeoutMs: 0};
resolveJevCredentials(state, rawInput, &creds);
let hyp_json = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_map_json(&hyp_json, &hypotheses);
let instr_cause = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&instr_cause, STR_PTR("Which hypothesis is the true root cause of this failure? Error: "), STR_LEN("Which hypothesis is the true root cause of this failure? Error: "));
buf_append_buf(&instr_cause, &errorSummary);
let questions = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&questions, STR_PTR("{"), STR_LEN("{"));
buf_append_question(&questions, STR_PTR("most_likely_cause"), STR_LEN("most_likely_cause"), STR_PTR("choice"), STR_LEN("choice"), &instr_cause, buf_ptr(&hyp_json), hyp_json.len);
if proposedFix.len > 0 {
let fix_map = StringMap { key_off: [0u64; 64], key_len: [0u64; 64], val_off: [0u64; 64], val_len: [0u64; 64], keys_bytes: [0u8; 8192], keys_len: 0, vals_bytes: [0u8; 65536], vals_len: 0, len: 0};
JEV_FIX_NATURE(&fix_map);
let fix_json = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_map_json(&fix_json, &fix_map);
let instr_fix = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&instr_fix, STR_PTR("Does the proposed fix cure the root cause, merely patch the symptom, or risk masking the real error? Proposed fix: "), STR_LEN("Does the proposed fix cure the root cause, merely patch the symptom, or risk masking the real error? Proposed fix: "));
buf_append_buf(&instr_fix, &proposedFix);
buf_append_lit(&questions, STR_PTR(","), STR_LEN(","));
buf_append_question(&questions, STR_PTR("fix_nature"), STR_LEN("fix_nature"), STR_PTR("choice"), STR_LEN("choice"), &instr_fix, buf_ptr(&fix_json), fix_json.len);
};
buf_append_lit(&questions, STR_PTR("}"), STR_LEN("}"));
let state_text = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&state_text, STR_PTR("[Error]\n"), STR_LEN("[Error]\n"));
buf_append_buf(&state_text, &errorSummary);
buf_append_lit(&state_text, STR_PTR("\n\n[Proposed Fix]\n"), STR_LEN("\n\n[Proposed Fix]\n"));
if proposedFix.len > 0 {
buf_append_buf(&state_text, &proposedFix);
} else {
buf_append_lit(&state_text, STR_PTR("(none proposed)"), STR_LEN("(none proposed)"));
};
buf_append_lit(&state_text, STR_PTR("\n\n[Context]\n"), STR_LEN("\n\n[Context]\n"));
buf_append_buf(&state_text, &context);
let payload = JevPayload { state: ByteBuf { bytes: [0u8; 262144], len: 0}, model: JevStr { bytes: [0u8; 8192], len: 0}, questions: ByteBuf { bytes: [0u8; 262144], len: 0}};
jev_make_payload(&state_text, &creds, &questions, &payload);
let call = JevCallResult { ok: false, data_doc: 0, data_bytes: [0u8; 262144], data_len: 0, latencyMs: 0, has_status: false, status: 0, error_bytes: [0u8; 16384], error_len: 0};
let rc = executeJevCall(state, &payload, &creds, &call);
if rc == 2 { return jev_overload_error(state, out);};
if!call.ok {
let err = ByteBuf { bytes: [0u8; 262144], len: 0};
call_error_into(&call, &err);
let stderr = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&stderr, STR_PTR("JEV diagnosis failed ("), STR_LEN("JEV diagnosis failed ("));
if call.has_status {
buf_append_i64(&stderr, call.status as i64);
} else {
buf_append_lit(&stderr, STR_PTR("502"), STR_LEN("502"));
};
buf_append_lit(&stderr, STR_PTR("): "), STR_LEN("): "));
buf_append_buf(&stderr, &err);
jev_fill_failure(out, call.has_status, call.status, buf_ptr(&err), err.len, &stderr, true, startedAt);
return 0;
};
// const causeKey = hypotheses[rawCause]!== undefined? rawCause: "";
let rawCause = ByteBuf { bytes: [0u8; 262144], len: 0};
jev_answer_choice(call.data_doc, STR_PTR("most_likely_cause"), STR_LEN("most_likely_cause"), &rawCause);
let causeKey = ByteBuf { bytes: [0u8; 262144], len: 0};
if stringmap_has(&hypotheses, buf_ptr(&rawCause), rawCause.len) {
buf_copy_into(&causeKey, &rawCause);
};
let causeConfidence = jev_answer_confidence(call.data_doc, STR_PTR("most_likely_cause"), STR_LEN("most_likely_cause"));
let fixNature = ByteBuf { bytes: [0u8; 262144], len: 0};
let fixConfidence: f64 = 1.0;
if proposedFix.len > 0 {
let nat_raw = ByteBuf { bytes: [0u8; 262144], len: 0};
jev_answer_choice(call.data_doc, STR_PTR("fix_nature"), STR_LEN("fix_nature"), &nat_raw);
let nat_lower = ByteBuf { bytes: [0u8; 262144], len: 0};
str_lower_into(&nat_lower, buf_ptr(&nat_raw), nat_raw.len);
// fixNature = rawNature === "symptom_patch" || rawNature === "risky_mask"? rawNature: "root_cause_fix";
if jev_str_eq(buf_ptr(&nat_lower), nat_lower.len, STR_PTR("symptom_patch"), STR_LEN("symptom_patch")) || jev_str_eq(buf_ptr(&nat_lower), nat_lower.len, STR_PTR("risky_mask"), STR_LEN("risky_mask")) {
buf_copy_into(&fixNature, &nat_lower);
} else {
buf_append_lit(&fixNature, STR_PTR("root_cause_fix"), STR_LEN("root_cause_fix"));
};
fixConfidence = jev_answer_confidence(call.data_doc, STR_PTR("fix_nature"), STR_LEN("fix_nature"));
};
let causeDesc = ByteBuf { bytes: [0u8; 262144], len: 0};
let has_cause_desc = stringmap_get(&hypotheses, buf_ptr(&causeKey), causeKey.len, &causeDesc);
let summary = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&summary, STR_PTR("\n• 最可能根因：["), STR_LEN("\n• 最可能根因：["));
if causeKey.len > 0 {
buf_append_buf(&summary, &causeKey);
} else {
buf_append_lit(&summary, STR_PTR("?"), STR_LEN("?"));
};
buf_append_lit(&summary, STR_PTR("] "), STR_LEN("] "));
if has_cause_desc && causeDesc.len > 0 {
buf_append_buf(&summary, &causeDesc);
} else {
buf_append_lit(&summary, STR_PTR("未能判定"), STR_LEN("未能判定"));
};
buf_append_lit(&summary, STR_PTR("（置信度 "), STR_LEN("（置信度 "));
buf_append_u64(&summary, jev_percent(causeConfidence));
buf_append_lit(&summary, STR_PTR("%）"), STR_LEN("%）"));
if proposedFix.len > 0 {
let fix_map2 = StringMap { key_off: [0u64; 64], key_len: [0u64; 64], val_off: [0u64; 64], val_len: [0u64; 64], keys_bytes: [0u8; 8192], keys_len: 0, vals_bytes: [0u8; 65536], vals_len: 0, len: 0};
JEV_FIX_NATURE(&fix_map2);
let fixDesc = ByteBuf { bytes: [0u8; 262144], len: 0};
stringmap_get(&fix_map2, buf_ptr(&fixNature), fixNature.len, &fixDesc);
buf_append_lit(&summary, STR_PTR("\n• 拟定修复性质：["), STR_LEN("\n• 拟定修复性质：["));
buf_append_buf(&summary, &fixNature);
buf_append_lit(&summary, STR_PTR("] "), STR_LEN("] "));
buf_append_buf(&summary, &fixDesc);
buf_append_lit(&summary, STR_PTR("（置信度 "), STR_LEN("（置信度 "));
buf_append_u64(&summary, jev_percent(fixConfidence));
buf_append_lit(&summary, STR_PTR("%）"), STR_LEN("%）"));
};
buf_append_lit(&summary, STR_PTR("\n• 报错："), STR_LEN("\n• 报错："));
buf_append_buf(&summary, &errorSummary);
buf_append_lit(&summary, STR_PTR("\n• 耗时："), STR_LEN("\n• 耗时："));
buf_append_u64(&summary, call.latencyMs);
buf_append_lit(&summary, STR_PTR("ms · 模型："), STR_LEN("ms · 模型："));
buf_append(&summary, js_ptr(&creds.model), creds.model.len);
let stdout = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&stdout, STR_PTR("{\"action\":\"jev_diagnose\",\"error_summary\":"), STR_LEN("{\"action\":\"jev_diagnose\",\"error_summary\":"));
buf_append_json_str(&stdout, buf_ptr(&errorSummary), errorSummary.len);
buf_append_lit(&stdout, STR_PTR(",\"most_likely_cause\":"), STR_LEN(",\"most_likely_cause\":"));
if causeKey.len > 0 {
buf_append_json_str(&stdout, buf_ptr(&causeKey), causeKey.len);
} else {
buf_append_lit(&stdout, STR_PTR("null"), STR_LEN("null"));
};
buf_append_lit(&stdout, STR_PTR(",\"cause_confidence\":"), STR_LEN(",\"cause_confidence\":"));
buf_append_f64(&stdout, causeConfidence);
buf_append_lit(&stdout, STR_PTR(",\"cause_description\":"), STR_LEN(",\"cause_description\":"));
if has_cause_desc && causeDesc.len > 0 {
buf_append_json_str(&stdout, buf_ptr(&causeDesc), causeDesc.len);
} else {
buf_append_lit(&stdout, STR_PTR("null"), STR_LEN("null"));
};
buf_append_lit(&stdout, STR_PTR(",\"proposed_fix\":"), STR_LEN(",\"proposed_fix\":"));
if proposedFix.len > 0 {
buf_append_json_str(&stdout, buf_ptr(&proposedFix), proposedFix.len);
} else {
buf_append_lit(&stdout, STR_PTR("null"), STR_LEN("null"));
};
buf_append_lit(&stdout, STR_PTR(",\"fix_nature\":"), STR_LEN(",\"fix_nature\":"));
if fixNature.len > 0 {
buf_append_json_str(&stdout, buf_ptr(&fixNature), fixNature.len);
} else {
buf_append_lit(&stdout, STR_PTR("null"), STR_LEN("null"));
};
buf_append_lit(&stdout, STR_PTR(",\"fix_confidence\":"), STR_LEN(",\"fix_confidence\":"));
buf_append_f64(&stdout, fixConfidence);
buf_append_lit(&stdout, STR_PTR(",\"summary\":"), STR_LEN(",\"summary\":"));
buf_append_json_str(&stdout, buf_ptr(&summary), summary.len);
buf_append_lit(&stdout, STR_PTR(",\"latencyMs\":"), STR_LEN(",\"latencyMs\":"));
buf_append_u64(&stdout, call.latencyMs);
buf_append_lit(&stdout, STR_PTR(",\"raw\":"), STR_LEN(",\"raw\":"));
buf_append(&stdout, call_data_ptr(&call), call.data_len);
buf_append_lit(&stdout, STR_PTR("}"), STR_LEN("}"));
jev_fill_success(out, &stdout, startedAt);
return 0;
}

//* Boundary-risk dimensions for `jev_edge_cases` (keys are stable codes). 
// export const JEV_EDGE_DIMENSIONS: Record<string, string> = {...};
fn JEV_EDGE_DIMENSIONS(out: &StringMap) -> void {
stringmap_init(out);
stringmap_set_lit(out, STR_PTR("boundary_numbers"), STR_LEN("boundary_numbers"), STR_PTR("边界数值：0、-1、NaN、MAX_SAFE_INTEGER、越界浮点"), STR_LEN("边界数值：0、-1、NaN、MAX_SAFE_INTEGER、越界浮点"));
stringmap_set_lit(out, STR_PTR("null_empty_omitted"), STR_LEN("null_empty_omitted"), STR_PTR("空与缺省：空串、空白串、未传可选参数、显式 null"), STR_LEN("空与缺省：空串、空白串、未传可选参数、显式 null"));
stringmap_set_lit(out, STR_PTR("encoding_and_symbols"), STR_LEN("encoding_and_symbols"), STR_PTR("编码符号：中文 UTF-8、反斜杠转义、emoji、URL 编码字符"), STR_LEN("编码符号：中文 UTF-8、反斜杠转义、emoji、URL 编码字符"));
stringmap_set_lit(out, STR_PTR("reentrancy_and_idempotency"), STR_LEN("reentrancy_and_idempotency"), STR_PTR("重入幂等：重复调用、并发触发、非幂等副作用"), STR_LEN("重入幂等：重复调用、并发触发、非幂等副作用"));
stringmap_set_lit(out, STR_PTR("abort_and_timeout"), STR_LEN("abort_and_timeout"), STR_PTR("中断超时：处理中途被上游断开、超时、取消信号"), STR_LEN("中断超时：处理中途被上游断开、超时、取消信号"));
}

// TS pick() helper inside nativeJevEdgeCases (a local closure):
// const pick = (answerKey: string): { key: string; confidence: number} => {...}
// DEFECT: closure — the local arrow function becomes a free fn;
// the captured `answers` becomes the data_doc parameter.
fn jev_edge_pick(data_doc: u64, dims: &StringMap, answerKey_ptr: ptr, answerKey_len: u64, out_key: &ByteBuf) -> f64 {
let raw_choice = ByteBuf { bytes: [0u8; 262144], len: 0};
jev_answer_choice(data_doc, answerKey_ptr, answerKey_len, &raw_choice);
let lower = ByteBuf { bytes: [0u8; 262144], len: 0};
str_lower_into(&lower, buf_ptr(&raw_choice), raw_choice.len);
buf_reset(out_key);
if stringmap_has(dims, buf_ptr(&lower), lower.len) {
buf_copy_into(out_key, &lower);
};
return jev_answer_confidence(data_doc, answerKey_ptr, answerKey_len);
}

//*
//* Advisory boundary-risk screen (边界筛查, purely opt-in).
//* Given a code signature plus implementation, JEV names the 1~2 boundary
//* dimensions most likely to be missed or crash-prone, so the model can add
//* targeted assertions. Counters happy-path-only test habits.
//
// TS: export async function nativeJevEdgeCases(...): Promise<JevRunResult>
// DEFECT: async
fn nativeJevEdgeCases(state: &JevModuleState, rawInput: &JevRunInput, policy: &JevPolicyConfig, cwd_ptr: ptr, cwd_len: u64, startedAt: u64, out: &JevRunResult) -> i32 {
// const rawCode = (cast).code?? rawInput.content?? (cast).source?? (cast).diff;
let c_raw = ByteBuf { bytes: [0u8; 262144], len: 0};
let has_c = input_dyn_str(rawInput, STR_PTR("code"), STR_LEN("code"), &c_raw);
if!has_c { has_c = input_str_field(rawInput, 2, &c_raw);};
if!has_c { has_c = input_dyn_str(rawInput, STR_PTR("source"), STR_LEN("source"), &c_raw);};
if!has_c { has_c = input_dyn_str(rawInput, STR_PTR("diff"), STR_LEN("diff"), &c_raw);};
let code = ByteBuf { bytes: [0u8; 262144], len: 0};
str_trim_into(&code, buf_ptr(&c_raw), c_raw.len);
if code.len == 0 {
return jev_input_error(out, STR_PTR("action 'jev_edge_cases' requires a non-empty 'code' parameter"), STR_LEN("action 'jev_edge_cases' requires a non-empty 'code' parameter"));
};
let ctx_kind: u64 = 0;
let ctx_raw = ByteBuf { bytes: [0u8; 262144], len: 0};
jev_pick_context(rawInput, &ctx_kind, &ctx_raw);
let context = ByteBuf { bytes: [0u8; 262144], len: 0};
truncateJevContext(buf_ptr(&ctx_raw), ctx_raw.len, ctx_kind, &context);
let creds = JevCredentials { baseUrl: JevStr { bytes: [0u8; 8192], len: 0}, apiKey: JevStr { bytes: [0u8; 8192], len: 0}, model: JevStr { bytes: [0u8; 8192], len: 0}, providerId: JevStr { bytes: [0u8; 8192], len: 0}, groupId: JevStr { bytes: [0u8; 8192], len: 0}, bridgeProtocol: JevStr { bytes: [0u8; 8192], len: 0}, timeoutMs: 0};
resolveJevCredentials(state, rawInput, &creds);
let dims = StringMap { key_off: [0u64; 64], key_len: [0u64; 64], val_off: [0u64; 64], val_len: [0u64; 64], keys_bytes: [0u8; 8192], keys_len: 0, vals_bytes: [0u8; 65536], vals_len: 0, len: 0};
JEV_EDGE_DIMENSIONS(&dims);
let dims_json = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_map_json(&dims_json, &dims);
let instr_w = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&instr_w, STR_PTR("Which boundary dimension is most likely missed or crash-prone in this implementation?"), STR_LEN("Which boundary dimension is most likely missed or crash-prone in this implementation?"));
let instr_r = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&instr_r, STR_PTR("Which boundary dimension is the second most likely missed or crash-prone? Do NOT repeat the weakest one."), STR_LEN("Which boundary dimension is the second most likely missed or crash-prone? Do NOT repeat the weakest one."));
let questions = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&questions, STR_PTR("{"), STR_LEN("{"));
buf_append_question(&questions, STR_PTR("weakest_dimension"), STR_LEN("weakest_dimension"), STR_PTR("choice"), STR_LEN("choice"), &instr_w, buf_ptr(&dims_json), dims_json.len);
buf_append_lit(&questions, STR_PTR(","), STR_LEN(","));
buf_append_question(&questions, STR_PTR("runner_up_dimension"), STR_LEN("runner_up_dimension"), STR_PTR("choice"), STR_LEN("choice"), &instr_r, buf_ptr(&dims_json), dims_json.len);
buf_append_lit(&questions, STR_PTR("}"), STR_LEN("}"));
// state: `[Code Under Review]\n${code.slice(0, 4000)}\n\n[Context]\n${context}`
let code_slice = ByteBuf { bytes: [0u8; 262144], len: 0};
let cn = code.len;
if cn > 4000 { cn = 4000;};
buf_append(&code_slice, buf_ptr(&code), cn);
let state_text = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&state_text, STR_PTR("[Code Under Review]\n"), STR_LEN("[Code Under Review]\n"));
buf_append_buf(&state_text, &code_slice);
buf_append_lit(&state_text, STR_PTR("\n\n[Context]\n"), STR_LEN("\n\n[Context]\n"));
buf_append_buf(&state_text, &context);
let payload = JevPayload { state: ByteBuf { bytes: [0u8; 262144], len: 0}, model: JevStr { bytes: [0u8; 8192], len: 0}, questions: ByteBuf { bytes: [0u8; 262144], len: 0}};
jev_make_payload(&state_text, &creds, &questions, &payload);
let call = JevCallResult { ok: false, data_doc: 0, data_bytes: [0u8; 262144], data_len: 0, latencyMs: 0, has_status: false, status: 0, error_bytes: [0u8; 16384], error_len: 0};
let rc = executeJevCall(state, &payload, &creds, &call);
if rc == 2 { return jev_overload_error(state, out);};
if!call.ok {
let err = ByteBuf { bytes: [0u8; 262144], len: 0};
call_error_into(&call, &err);
let stderr = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&stderr, STR_PTR("JEV edge-case screen failed ("), STR_LEN("JEV edge-case screen failed ("));
if call.has_status {
buf_append_i64(&stderr, call.status as i64);
} else {
buf_append_lit(&stderr, STR_PTR("502"), STR_LEN("502"));
};
buf_append_lit(&stderr, STR_PTR("): "), STR_LEN("): "));
buf_append_buf(&stderr, &err);
jev_fill_failure(out, call.has_status, call.status, buf_ptr(&err), err.len, &stderr, true, startedAt);
return 0;
};
let weakest_key = ByteBuf { bytes: [0u8; 262144], len: 0};
let weakest_conf = jev_edge_pick(call.data_doc, &dims, STR_PTR("weakest_dimension"), STR_LEN("weakest_dimension"), &weakest_key);
let runner_raw_key = ByteBuf { bytes: [0u8; 262144], len: 0};
let runner_raw_conf = jev_edge_pick(call.data_doc, &dims, STR_PTR("runner_up_dimension"), STR_LEN("runner_up_dimension"), &runner_raw_key);
// const runnerUp = runnerUpRaw.key && runnerUpRaw.key!== weakest.key? runnerUpRaw: { key: "", confidence: 1.0};
let runner_key = ByteBuf { bytes: [0u8; 262144], len: 0};
let runner_conf: f64 = 1.0;
if runner_raw_key.len > 0 &&!jev_str_eq(buf_ptr(&runner_raw_key), runner_raw_key.len, buf_ptr(&weakest_key), weakest_key.len) {
buf_copy_into(&runner_key, &runner_raw_key);
runner_conf = runner_raw_conf;
};
let weakest_desc = ByteBuf { bytes: [0u8; 262144], len: 0};
let has_wd = stringmap_get(&dims, buf_ptr(&weakest_key), weakest_key.len, &weakest_desc);
let summary = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&summary, STR_PTR("\n• 最脆弱维度：["), STR_LEN("\n• 最脆弱维度：["));
if weakest_key.len > 0 {
buf_append_buf(&summary, &weakest_key);
} else {
buf_append_lit(&summary, STR_PTR("?"), STR_LEN("?"));
};
buf_append_lit(&summary, STR_PTR("] "), STR_LEN("] "));
if has_wd && weakest_desc.len > 0 {
buf_append_buf(&summary, &weakest_desc);
} else {
buf_append_lit(&summary, STR_PTR("未能判定"), STR_LEN("未能判定"));
};
buf_append_lit(&summary, STR_PTR("（置信度 "), STR_LEN("（置信度 "));
buf_append_u64(&summary, jev_percent(weakest_conf));
buf_append_lit(&summary, STR_PTR("%）"), STR_LEN("%）"));
if runner_key.len > 0 {
let rdesc = ByteBuf { bytes: [0u8; 262144], len: 0};
stringmap_get(&dims, buf_ptr(&runner_key), runner_key.len, &rdesc);
buf_append_lit(&summary, STR_PTR("\n• 次脆弱维度：["), STR_LEN("\n• 次脆弱维度：["));
buf_append_buf(&summary, &runner_key);
buf_append_lit(&summary, STR_PTR("] "), STR_LEN("] "));
buf_append_buf(&summary, &rdesc);
buf_append_lit(&summary, STR_PTR("（置信度 "), STR_LEN("（置信度 "));
buf_append_u64(&summary, jev_percent(runner_conf));
buf_append_lit(&summary, STR_PTR("%）"), STR_LEN("%）"));
};
buf_append_lit(&summary, STR_PTR("\n• 建议：针对上述维度补充断言（空/边界/编码/重入/中断），不要只测 Happy Path"), STR_LEN("\n• 建议：针对上述维度补充断言（空/边界/编码/重入/中断），不要只测 Happy Path"));
buf_append_lit(&summary, STR_PTR("\n• 耗时："), STR_LEN("\n• 耗时："));
buf_append_u64(&summary, call.latencyMs);
buf_append_lit(&summary, STR_PTR("ms · 模型："), STR_LEN("ms · 模型："));
buf_append(&summary, js_ptr(&creds.model), creds.model.len);
let stdout = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&stdout, STR_PTR("{\"action\":\"jev_edge_cases\",\"weakest_dimension\":"), STR_LEN("{\"action\":\"jev_edge_cases\",\"weakest_dimension\":"));
if weakest_key.len > 0 {
buf_append_json_str(&stdout, buf_ptr(&weakest_key), weakest_key.len);
} else {
buf_append_lit(&stdout, STR_PTR("null"), STR_LEN("null"));
};
buf_append_lit(&stdout, STR_PTR(",\"weakest_confidence\":"), STR_LEN(",\"weakest_confidence\":"));
buf_append_f64(&stdout, weakest_conf);
buf_append_lit(&stdout, STR_PTR(",\"runner_up_dimension\":"), STR_LEN(",\"runner_up_dimension\":"));
if runner_key.len > 0 {
buf_append_json_str(&stdout, buf_ptr(&runner_key), runner_key.len);
} else {
buf_append_lit(&stdout, STR_PTR("null"), STR_LEN("null"));
};
buf_append_lit(&stdout, STR_PTR(",\"runner_up_confidence\":"), STR_LEN(",\"runner_up_confidence\":"));
buf_append_f64(&stdout, runner_conf);
buf_append_lit(&stdout, STR_PTR(",\"summary\":"), STR_LEN(",\"summary\":"));
buf_append_json_str(&stdout, buf_ptr(&summary), summary.len);
buf_append_lit(&stdout, STR_PTR(",\"latencyMs\":"), STR_LEN(",\"latencyMs\":"));
buf_append_u64(&stdout, call.latencyMs);
buf_append_lit(&stdout, STR_PTR(",\"raw\":"), STR_LEN(",\"raw\":"));
buf_append(&stdout, call_data_ptr(&call), call.data_len);
buf_append_lit(&stdout, STR_PTR("}"), STR_LEN("}"));
jev_fill_success(out, &stdout, startedAt);
return 0;
}

//* Blast-radius side-effect classes for `jev_blast_radius` (review a DIFF, not a plan). 
// export const JEV_BLAST_CLASSES: Record<string, string> = {...};
fn JEV_BLAST_CLASSES(out: &StringMap) -> void {
stringmap_init(out);
stringmap_set_lit(out, STR_PTR("local_only"), STR_LEN("local_only"), STR_PTR("纯内部实现优化，零外部依赖泄露"), STR_LEN("纯内部实现优化，零外部依赖泄露"));
stringmap_set_lit(out, STR_PTR("api_break"), STR_LEN("api_break"), STR_PTR("破坏外部调用方、SDK 或 HTTP/WebSocket 协议格式"), STR_LEN("破坏外部调用方、SDK 或 HTTP/WebSocket 协议格式"));
stringmap_set_lit(out, STR_PTR("state_leak"), STR_LEN("state_leak"), STR_PTR("订阅、Lease、定时器或未清理缓存跨会话残留"), STR_LEN("订阅、Lease、定时器或未清理缓存跨会话残留"));
stringmap_set_lit(out, STR_PTR("perf_cliff"), STR_LEN("perf_cliff"), STR_PTR("引入 N+1、全表扫描或无上界的上下文堆积"), STR_LEN("引入 N+1、全表扫描或无上界的上下文堆积"));
}

//* Merge verdicts for `jev_blast_radius`. 
// export const JEV_BLAST_VERDICTS: Record<string, string> = {...};
fn JEV_BLAST_VERDICTS(out: &StringMap) -> void {
stringmap_init(out);
stringmap_set_lit(out, STR_PTR("safe_to_apply"), STR_LEN("safe_to_apply"), STR_PTR("安全可合入"), STR_LEN("安全可合入"));
stringmap_set_lit(out, STR_PTR("needs_compat_shim"), STR_LEN("needs_compat_shim"), STR_PTR("需补兼容层后再合入"), STR_LEN("需补兼容层后再合入"));
stringmap_set_lit(out, STR_PTR("needs_regression_tests"), STR_LEN("needs_regression_tests"), STR_PTR("需加固回归测试后再合入"), STR_LEN("需加固回归测试后再合入"));
}

//*
//* Advisory diff blast-radius review (爆炸半径审查, purely opt-in).
//* Unlike `jev_redteam` (which reviews a PLAN before acting), this reviews a
//* concrete DIFF before apply/commit: fixed side-effect classes plus a
//* merge verdict. Use redteam for plans, blast_radius for diffs.
//
// TS: export async function nativeJevBlastRadius(...): Promise<JevRunResult>
// DEFECT: async
fn nativeJevBlastRadius(state: &JevModuleState, rawInput: &JevRunInput, policy: &JevPolicyConfig, cwd_ptr: ptr, cwd_len: u64, startedAt: u64, out: &JevRunResult) -> i32 {
// const rawDiff = (cast).diff?? rawInput.patch?? rawInput.content;
let d_raw = ByteBuf { bytes: [0u8; 262144], len: 0};
let has_d = input_dyn_str(rawInput, STR_PTR("diff"), STR_LEN("diff"), &d_raw);
if!has_d { has_d = input_str_field(rawInput, 3, &d_raw);};
if!has_d { has_d = input_str_field(rawInput, 2, &d_raw);};
let diff = ByteBuf { bytes: [0u8; 262144], len: 0};
str_trim_into(&diff, buf_ptr(&d_raw), d_raw.len);
if diff.len == 0 {
return jev_input_error(out, STR_PTR("action 'jev_blast_radius' requires a non-empty 'diff' parameter"), STR_LEN("action 'jev_blast_radius' requires a non-empty 'diff' parameter"));
};
// const rawTarget = (cast).target_component?? (cast).target?? (cast).file;
let tg_raw = ByteBuf { bytes: [0u8; 262144], len: 0};
let has_tg = input_dyn_str(rawInput, STR_PTR("target_component"), STR_LEN("target_component"), &tg_raw);
if!has_tg { has_tg = input_dyn_str(rawInput, STR_PTR("target"), STR_LEN("target"), &tg_raw);};
if!has_tg { has_tg = input_dyn_str(rawInput, STR_PTR("file"), STR_LEN("file"), &tg_raw);};
let targetComponent = ByteBuf { bytes: [0u8; 262144], len: 0};
str_trim_into(&targetComponent, buf_ptr(&tg_raw), tg_raw.len);
let ctx_kind: u64 = 0;
let ctx_raw = ByteBuf { bytes: [0u8; 262144], len: 0};
jev_pick_context(rawInput, &ctx_kind, &ctx_raw);
let context = ByteBuf { bytes: [0u8; 262144], len: 0};
truncateJevContext(buf_ptr(&ctx_raw), ctx_raw.len, ctx_kind, &context);
let creds = JevCredentials { baseUrl: JevStr { bytes: [0u8; 8192], len: 0}, apiKey: JevStr { bytes: [0u8; 8192], len: 0}, model: JevStr { bytes: [0u8; 8192], len: 0}, providerId: JevStr { bytes: [0u8; 8192], len: 0}, groupId: JevStr { bytes: [0u8; 8192], len: 0}, bridgeProtocol: JevStr { bytes: [0u8; 8192], len: 0}, timeoutMs: 0};
resolveJevCredentials(state, rawInput, &creds);
let classes = StringMap { key_off: [0u64; 64], key_len: [0u64; 64], val_off: [0u64; 64], val_len: [0u64; 64], keys_bytes: [0u8; 8192], keys_len: 0, vals_bytes: [0u8; 65536], vals_len: 0, len: 0};
JEV_BLAST_CLASSES(&classes);
let verdicts = StringMap { key_off: [0u64; 64], key_len: [0u64; 64], val_off: [0u64; 64], val_len: [0u64; 64], keys_bytes: [0u8; 8192], keys_len: 0, vals_bytes: [0u8; 65536], vals_len: 0, len: 0};
JEV_BLAST_VERDICTS(&verdicts);
let classes_json = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_map_json(&classes_json, &classes);
let verdicts_json = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_map_json(&verdicts_json, &verdicts);
let instr_e = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&instr_e, STR_PTR("Which side-effect class best describes this diff?"), STR_LEN("Which side-effect class best describes this diff?"));
if targetComponent.len > 0 {
buf_append_lit(&instr_e, STR_PTR(" Target component: "), STR_LEN(" Target component: "));
buf_append_buf(&instr_e, &targetComponent);
buf_append_lit(&instr_e, STR_PTR("."), STR_LEN("."));
};
let instr_v = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&instr_v, STR_PTR("Can this diff be merged as-is, or what must happen first?"), STR_LEN("Can this diff be merged as-is, or what must happen first?"));
let questions = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&questions, STR_PTR("{"), STR_LEN("{"));
buf_append_question(&questions, STR_PTR("side_effect"), STR_LEN("side_effect"), STR_PTR("choice"), STR_LEN("choice"), &instr_e, buf_ptr(&classes_json), classes_json.len);
buf_append_lit(&questions, STR_PTR(","), STR_LEN(","));
buf_append_question(&questions, STR_PTR("merge_verdict"), STR_LEN("merge_verdict"), STR_PTR("choice"), STR_LEN("choice"), &instr_v, buf_ptr(&verdicts_json), verdicts_json.len);
buf_append_lit(&questions, STR_PTR("}"), STR_LEN("}"));
// state: `[Diff Under Review]${targetComponent? ` (${targetComponent})`: ""}\n${diff.slice(0, 6000)}\n\n[Context]\n${context}`
let diff_slice = ByteBuf { bytes: [0u8; 262144], len: 0};
let dn = diff.len;
if dn > 6000 { dn = 6000;};
buf_append(&diff_slice, buf_ptr(&diff), dn);
let state_text = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&state_text, STR_PTR("[Diff Under Review]"), STR_LEN("[Diff Under Review]"));
if targetComponent.len > 0 {
buf_append_lit(&state_text, STR_PTR(" ("), STR_LEN(" ("));
buf_append_buf(&state_text, &targetComponent);
buf_append_lit(&state_text, STR_PTR(")"), STR_LEN(")"));
};
buf_append_lit(&state_text, STR_PTR("\n"), STR_LEN("\n"));
buf_append_buf(&state_text, &diff_slice);
buf_append_lit(&state_text, STR_PTR("\n\n[Context]\n"), STR_LEN("\n\n[Context]\n"));
buf_append_buf(&state_text, &context);
let payload = JevPayload { state: ByteBuf { bytes: [0u8; 262144], len: 0}, model: JevStr { bytes: [0u8; 8192], len: 0}, questions: ByteBuf { bytes: [0u8; 262144], len: 0}};
jev_make_payload(&state_text, &creds, &questions, &payload);
let call = JevCallResult { ok: false, data_doc: 0, data_bytes: [0u8; 262144], data_len: 0, latencyMs: 0, has_status: false, status: 0, error_bytes: [0u8; 16384], error_len: 0};
let rc = executeJevCall(state, &payload, &creds, &call);
if rc == 2 { return jev_overload_error(state, out);};
if!call.ok {
let err = ByteBuf { bytes: [0u8; 262144], len: 0};
call_error_into(&call, &err);
let stderr = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&stderr, STR_PTR("JEV blast-radius review failed ("), STR_LEN("JEV blast-radius review failed ("));
if call.has_status {
buf_append_i64(&stderr, call.status as i64);
} else {
buf_append_lit(&stderr, STR_PTR("502"), STR_LEN("502"));
};
buf_append_lit(&stderr, STR_PTR("): "), STR_LEN("): "));
buf_append_buf(&stderr, &err);
jev_fill_failure(out, call.has_status, call.status, buf_ptr(&err), err.len, &stderr, true, startedAt);
return 0;
};
let effect_raw = ByteBuf { bytes: [0u8; 262144], len: 0};
jev_answer_choice(call.data_doc, STR_PTR("side_effect"), STR_LEN("side_effect"), &effect_raw);
let effect_lower = ByteBuf { bytes: [0u8; 262144], len: 0};
str_lower_into(&effect_lower, buf_ptr(&effect_raw), effect_raw.len);
let effect = ByteBuf { bytes: [0u8; 262144], len: 0};
if stringmap_has(&classes, buf_ptr(&effect_lower), effect_lower.len) {
buf_copy_into(&effect, &effect_lower);
};
let effectConfidence = jev_answer_confidence(call.data_doc, STR_PTR("side_effect"), STR_LEN("side_effect"));
let verdict_raw = ByteBuf { bytes: [0u8; 262144], len: 0};
jev_answer_choice(call.data_doc, STR_PTR("merge_verdict"), STR_LEN("merge_verdict"), &verdict_raw);
let verdict_lower = ByteBuf { bytes: [0u8; 262144], len: 0};
str_lower_into(&verdict_lower, buf_ptr(&verdict_raw), verdict_raw.len);
let verdict = ByteBuf { bytes: [0u8; 262144], len: 0};
if stringmap_has(&verdicts, buf_ptr(&verdict_lower), verdict_lower.len) {
buf_copy_into(&verdict, &verdict_lower);
};
let verdictConfidence = jev_answer_confidence(call.data_doc, STR_PTR("merge_verdict"), STR_LEN("merge_verdict"));
// Identify historical regression cases associated with the target component or diff
let case_cwd = ByteBuf { bytes: [0u8; 262144], len: 0};
let has_case_cwd = input_dyn_str(rawInput, STR_PTR("cwd"), STR_LEN("cwd"), &case_cwd);
let cases = RegressionCaseList { json_bytes: [0u8; 262144], json_len: 0, len: 0};
loadRegressionCases(&cases, buf_ptr(&case_cwd), case_cwd.len, has_case_cwd);
// const matchedCases = allCases.filter((c) => {...});
// DEFECT: closure — filter predicate inlined as a loop. TS uses
// case-sensitive includes on toLowerCase()'d strings here.
let tc_lower = ByteBuf { bytes: [0u8; 262144], len: 0};
str_lower_into(&tc_lower, buf_ptr(&targetComponent), targetComponent.len);
let diff_lower = ByteBuf { bytes: [0u8; 262144], len: 0};
str_lower_into(&diff_lower, buf_ptr(&diff), diff.len);
let matched_json = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&matched_json, STR_PTR("["), STR_LEN("["));
let matched_ids = ByteBuf { bytes: [0u8; 262144], len: 0};
let matched_count: u64 = 0;
let first_comp = ByteBuf { bytes: [0u8; 262144], len: 0};
let ci: u64 = 0;
for ci in 0..cases.len {
let comp = ByteBuf { bytes: [0u8; 262144], len: 0};
regression_case_field(&cases, ci, STR_PTR("component"), STR_LEN("component"), &comp);
let cc_lower = ByteBuf { bytes: [0u8; 262144], len: 0};
str_lower_into(&cc_lower, buf_ptr(&comp), comp.len);
let matched = false;
if targetComponent.len > 0 {
let base = ByteBuf { bytes: [0u8; 262144], len: 0};
jev_basename(buf_ptr(&cc_lower), cc_lower.len, &base);
if str_contains_ci(buf_ptr(&cc_lower), cc_lower.len, buf_ptr(&tc_lower), tc_lower.len)
|| str_contains_ci(buf_ptr(&tc_lower), tc_lower.len, buf_ptr(&base), base.len) {
matched = true;
};
};
if!matched {
let base2 = ByteBuf { bytes: [0u8; 262144], len: 0};
jev_basename(buf_ptr(&comp), comp.len, &base2);
let c_base = ByteBuf { bytes: [0u8; 262144], len: 0};
str_lower_into(&c_base, buf_ptr(&base2), base2.len);
if str_contains_ci(buf_ptr(&diff_lower), diff_lower.len, buf_ptr(&c_base), c_base.len) {
matched = true;
};
};
if matched {
let cid = ByteBuf { bytes: [0u8; 262144], len: 0};
regression_case_field(&cases, ci, STR_PTR("id"), STR_LEN("id"), &cid);
let title = ByteBuf { bytes: [0u8; 262144], len: 0};
regression_case_field(&cases, ci, STR_PTR("title"), STR_LEN("title"), &title);
if matched_count > 0 {
buf_append_lit(&matched_json, STR_PTR(","), STR_LEN(","));
buf_append_lit(&matched_ids, STR_PTR(", "), STR_LEN(", "));
} else {
buf_copy_into(&first_comp, &comp);
};
buf_append_lit(&matched_json, STR_PTR("{\"id\":"), STR_LEN("{\"id\":"));
buf_append_json_str(&matched_json, buf_ptr(&cid), cid.len);
buf_append_lit(&matched_json, STR_PTR(",\"title\":"), STR_LEN(",\"title\":"));
buf_append_json_str(&matched_json, buf_ptr(&title), title.len);
buf_append_lit(&matched_json, STR_PTR(",\"component\":"), STR_LEN(",\"component\":"));
buf_append_json_str(&matched_json, buf_ptr(&comp), comp.len);
buf_append_lit(&matched_json, STR_PTR("}"), STR_LEN("}"));
buf_append_buf(&matched_ids, &cid);
matched_count = matched_count + 1;
};
}
buf_append_lit(&matched_json, STR_PTR("]"), STR_LEN("]"));
let effectDesc = ByteBuf { bytes: [0u8; 262144], len: 0};
let has_ed = stringmap_get(&classes, buf_ptr(&effect), effect.len, &effectDesc);
let verdictDesc = ByteBuf { bytes: [0u8; 262144], len: 0};
let has_vd = stringmap_get(&verdicts, buf_ptr(&verdict), verdict.len, &verdictDesc);
let summary = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&summary, STR_PTR("\n• 副作用分类：["), STR_LEN("\n• 副作用分类：["));
if effect.len > 0 {
buf_append_buf(&summary, &effect);
} else {
buf_append_lit(&summary, STR_PTR("?"), STR_LEN("?"));
};
buf_append_lit(&summary, STR_PTR("] "), STR_LEN("] "));
if has_ed && effectDesc.len > 0 {
buf_append_buf(&summary, &effectDesc);
} else {
buf_append_lit(&summary, STR_PTR("未能判定"), STR_LEN("未能判定"));
};
buf_append_lit(&summary, STR_PTR("（置信度 "), STR_LEN("（置信度 "));
buf_append_u64(&summary, jev_percent(effectConfidence));
buf_append_lit(&summary, STR_PTR("%）\n• 合入裁决：["), STR_LEN("%）\n• 合入裁决：["));
if verdict.len > 0 {
buf_append_buf(&summary, &verdict);
} else {
buf_append_lit(&summary, STR_PTR("?"), STR_LEN("?"));
};
buf_append_lit(&summary, STR_PTR("] "), STR_LEN("] "));
if has_vd && verdictDesc.len > 0 {
buf_append_buf(&summary, &verdictDesc);
} else {
buf_append_lit(&summary, STR_PTR("未能判定"), STR_LEN("未能判定"));
};
buf_append_lit(&summary, STR_PTR("（置信度 "), STR_LEN("（置信度 "));
buf_append_u64(&summary, jev_percent(verdictConfidence));
buf_append_lit(&summary, STR_PTR("%）"), STR_LEN("%）"));
if targetComponent.len > 0 {
buf_append_lit(&summary, STR_PTR("\n• 目标组件："), STR_LEN("\n• 目标组件："));
buf_append_buf(&summary, &targetComponent);
};
if matched_count > 0 {
buf_append_lit(&summary, STR_PTR("\n• 历史回归风险：关联到 "), STR_LEN("\n• 历史回归风险：关联到 "));
buf_append_u64(&summary, matched_count);
buf_append_lit(&summary, STR_PTR(" 个历史案例 ["), STR_LEN(" 个历史案例 ["));
buf_append_buf(&summary, &matched_ids);
buf_append_lit(&summary, STR_PTR("]\n 建议交付前执行: sa_vm_run({ action: 'replay_case', component: '"), STR_LEN("]\n 建议交付前执行: sa_vm_run({ action: 'replay_case', component: '"));
if targetComponent.len > 0 {
buf_append_buf(&summary, &targetComponent);
} else {
buf_append_buf(&summary, &first_comp);
};
buf_append_lit(&summary, STR_PTR("'})"), STR_LEN("'})"));
};
buf_append_lit(&summary, STR_PTR("\n• 耗时："), STR_LEN("\n• 耗时："));
buf_append_u64(&summary, call.latencyMs);
buf_append_lit(&summary, STR_PTR("ms · 模型："), STR_LEN("ms · 模型："));
buf_append(&summary, js_ptr(&creds.model), creds.model.len);
let stdout = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&stdout, STR_PTR("{\"action\":\"jev_blast_radius\",\"target_component\":"), STR_LEN("{\"action\":\"jev_blast_radius\",\"target_component\":"));
if targetComponent.len > 0 {
buf_append_json_str(&stdout, buf_ptr(&targetComponent), targetComponent.len);
} else {
buf_append_lit(&stdout, STR_PTR("null"), STR_LEN("null"));
};
buf_append_lit(&stdout, STR_PTR(",\"side_effect\":"), STR_LEN(",\"side_effect\":"));
if effect.len > 0 {
buf_append_json_str(&stdout, buf_ptr(&effect), effect.len);
} else {
buf_append_lit(&stdout, STR_PTR("null"), STR_LEN("null"));
};
buf_append_lit(&stdout, STR_PTR(",\"side_effect_confidence\":"), STR_LEN(",\"side_effect_confidence\":"));
buf_append_f64(&stdout, effectConfidence);
buf_append_lit(&stdout, STR_PTR(",\"merge_verdict\":"), STR_LEN(",\"merge_verdict\":"));
if verdict.len > 0 {
buf_append_json_str(&stdout, buf_ptr(&verdict), verdict.len);
} else {
buf_append_lit(&stdout, STR_PTR("null"), STR_LEN("null"));
};
buf_append_lit(&stdout, STR_PTR(",\"merge_confidence\":"), STR_LEN(",\"merge_confidence\":"));
buf_append_f64(&stdout, verdictConfidence);
buf_append_lit(&stdout, STR_PTR(",\"historical_regression_cases\":"), STR_LEN(",\"historical_regression_cases\":"));
buf_append_buf(&stdout, &matched_json);
buf_append_lit(&stdout, STR_PTR(",\"summary\":"), STR_LEN(",\"summary\":"));
buf_append_json_str(&stdout, buf_ptr(&summary), summary.len);
buf_append_lit(&stdout, STR_PTR(",\"latencyMs\":"), STR_LEN(",\"latencyMs\":"));
buf_append_u64(&stdout, call.latencyMs);
buf_append_lit(&stdout, STR_PTR(",\"raw\":"), STR_LEN(",\"raw\":"));
buf_append(&stdout, call_data_ptr(&call), call.data_len);
buf_append_lit(&stdout, STR_PTR("}"), STR_LEN("}"));
jev_fill_success(out, &stdout, startedAt);
return 0;
}

//* Intent taxonomy for `jev_intent` (keys are stable codes). 
// export const JEV_INTENT_TYPES: Record<string, string> = {...};
fn JEV_INTENT_TYPES(out: &StringMap) -> void {
stringmap_init(out);
stringmap_set_lit(out, STR_PTR("code_change"), STR_LEN("code_change"), STR_PTR("代码变更：新增功能、修改逻辑、重构、样式调整"), STR_LEN("代码变更：新增功能、修改逻辑、重构、样式调整"));
stringmap_set_lit(out, STR_PTR("bug_fix"), STR_LEN("bug_fix"), STR_PTR("修 Bug：复现、定位根因、修复并补回归测试"), STR_LEN("修 Bug：复现、定位根因、修复并补回归测试"));
stringmap_set_lit(out, STR_PTR("investigation"), STR_LEN("investigation"), STR_PTR("勘察诊断：只读排查、找根因、收敛证据再下结论"), STR_LEN("勘察诊断：只读排查、找根因、收敛证据再下结论"));
stringmap_set_lit(out, STR_PTR("explanation"), STR_LEN("explanation"), STR_PTR("答疑解惑：解释概念、代码逻辑、文档说明"), STR_LEN("答疑解惑：解释概念、代码逻辑、文档说明"));
stringmap_set_lit(out, STR_PTR("review"), STR_LEN("review"), STR_PTR("评审：审 diff、审方案、找风险与边界遗漏"), STR_LEN("评审：审 diff、审方案、找风险与边界遗漏"));
stringmap_set_lit(out, STR_PTR("plan"), STR_LEN("plan"), STR_PTR("规划：拆任务、排优先级、定方案"), STR_LEN("规划：拆任务、排优先级、定方案"));
stringmap_set_lit(out, STR_PTR("test_verify"), STR_LEN("test_verify"), STR_PTR("验证：跑测试、复现步骤、确认修复效果"), STR_LEN("验证：跑测试、复现步骤、确认修复效果"));
stringmap_set_lit(out, STR_PTR("other"), STR_LEN("other"), STR_PTR("其他：以上均不贴切，需进一步澄清"), STR_LEN("其他：以上均不贴切，需进一步澄清"));
}

//* Clarity verdicts for `jev_intent`. 
// export const JEV_INTENT_CLARITY: Record<string, string> = {...};
fn JEV_INTENT_CLARITY(out: &StringMap) -> void {
stringmap_init(out);
stringmap_set_lit(out, STR_PTR("clear"), STR_LEN("clear"), STR_PTR("意图明确，可直接动手"), STR_LEN("意图明确，可直接动手"));
stringmap_set_lit(out, STR_PTR("needs_clarification"), STR_LEN("needs_clarification"), STR_PTR("缺关键信息，动手前必须追问"), STR_LEN("缺关键信息，动手前必须追问"));
stringmap_set_lit(out, STR_PTR("ambiguous"), STR_LEN("ambiguous"), STR_PTR("存在多种合理解读，需用户确认后再动手"), STR_LEN("存在多种合理解读，需用户确认后再动手"));
}

//* First-step playbook per intent type (local, deterministic). 
// export const JEV_INTENT_FIRST_STEPS: Record<string, string> = {...};
fn JEV_INTENT_FIRST_STEPS(out: &StringMap) -> void {
stringmap_init(out);
stringmap_set_lit(out, STR_PTR("code_change"), STR_LEN("code_change"), STR_PTR("先定位相关文件与符号，小步修改并验证"), STR_LEN("先定位相关文件与符号，小步修改并验证"));
stringmap_set_lit(out, STR_PTR("bug_fix"), STR_LEN("bug_fix"), STR_PTR("先复现并锁定最小复现，再修再补回归测试"), STR_LEN("先复现并锁定最小复现，再修再补回归测试"));
stringmap_set_lit(out, STR_PTR("investigation"), STR_LEN("investigation"), STR_PTR("先只读勘察收敛证据，再下结论，不急着改代码"), STR_LEN("先只读勘察收敛证据，再下结论，不急着改代码"));
stringmap_set_lit(out, STR_PTR("explanation"), STR_LEN("explanation"), STR_PTR("直接回答，必要时引用文件行号"), STR_LEN("直接回答，必要时引用文件行号"));
stringmap_set_lit(out, STR_PTR("review"), STR_LEN("review"), STR_PTR("拉取 diff 逐项过风险与边界"), STR_LEN("拉取 diff 逐项过风险与边界"));
stringmap_set_lit(out, STR_PTR("plan"), STR_LEN("plan"), STR_PTR("先拆范围再排优先级，避免 epic 直接开干"), STR_LEN("先拆范围再排优先级，避免 epic 直接开干"));
stringmap_set_lit(out, STR_PTR("test_verify"), STR_LEN("test_verify"), STR_PTR("先跑相关测试看红绿，再谈结论"), STR_LEN("先跑相关测试看红绿，再谈结论"));
stringmap_set_lit(out, STR_PTR("other"), STR_LEN("other"), STR_PTR("先向用户确认理解再动手"), STR_LEN("先向用户确认理解再动手"));
}

//*
//* Advisory user-intent analysis (意图分析, purely opt-in).
//* Call right after user input: JEV picks the most likely interpretation
//* (from caller-provided candidates, or from the built-in intent taxonomy)
//* plus a clarity verdict, so the model knows whether to act, ask, or confirm.
//
// TS: export async function nativeJevIntent(...): Promise<JevRunResult>
// DEFECT: async
fn nativeJevIntent(state: &JevModuleState, rawInput: &JevRunInput, policy: &JevPolicyConfig, cwd_ptr: ptr, cwd_len: u64, startedAt: u64, out: &JevRunResult) -> i32 {
// const rawText = (cast).input?? rawInput.question?? rawInput.content;
let x_raw = ByteBuf { bytes: [0u8; 262144], len: 0};
let has_x = input_dyn_str(rawInput, STR_PTR("input"), STR_LEN("input"), &x_raw);
if!has_x { has_x = input_str_field(rawInput, 0, &x_raw);};
if!has_x { has_x = input_str_field(rawInput, 2, &x_raw);};
let userText = ByteBuf { bytes: [0u8; 262144], len: 0};
str_trim_into(&userText, buf_ptr(&x_raw), x_raw.len);
if userText.len == 0 {
return jev_input_error(out, STR_PTR("action 'jev_intent' requires a non-empty 'question' parameter (the raw user input)"), STR_LEN("action 'jev_intent' requires a non-empty 'question' parameter (the raw user input)"));
};
// const rawOptions = (cast).interpretations?? rawInput.options;
let raw_opts = ByteBuf { bytes: [0u8; 262144], len: 0};
let raw_kind: u64 = 0;
let has_raw_opts = input_dyn_json(rawInput, STR_PTR("interpretations"), STR_LEN("interpretations"), &raw_opts, &raw_kind);
if!has_raw_opts { has_raw_opts = input_json_field(rawInput, 4, &raw_opts, &raw_kind);};
let hasCandidates = false;
if has_raw_opts && raw_kind!= 0 {
if raw_kind == 1 {
let t = ByteBuf { bytes: [0u8; 262144], len: 0};
str_trim_into(&t, buf_ptr(&raw_opts), raw_opts.len);
hasCandidates = t.len > 0;
} else {
hasCandidates = true;
};
};
let candidates = StringMap { key_off: [0u64; 64], key_len: [0u64; 64], val_off: [0u64; 64], val_len: [0u64; 64], keys_bytes: [0u8; 8192], keys_len: 0, vals_bytes: [0u8; 65536], vals_len: 0, len: 0};
stringmap_init(&candidates);
if hasCandidates {
normalizeChoiceOptions(buf_ptr(&raw_opts), raw_opts.len, raw_kind, &candidates);
if candidates.len < 2 {
return jev_input_error(out, STR_PTR("action 'jev_intent' requires at least 2 candidate interpretations in 'options' (or omit 'options' to use the built-in taxonomy)"), STR_LEN("action 'jev_intent' requires at least 2 candidate interpretations in 'options' (or omit 'options' to use the built-in taxonomy)"));
};
if candidates.len > 6 {
jev_map_truncate(&candidates, 6);
};
};
let ctx_kind: u64 = 0;
let ctx_raw = ByteBuf { bytes: [0u8; 262144], len: 0};
jev_pick_context(rawInput, &ctx_kind, &ctx_raw);
let context = ByteBuf { bytes: [0u8; 262144], len: 0};
truncateJevContext(buf_ptr(&ctx_raw), ctx_raw.len, ctx_kind, &context);
let creds = JevCredentials { baseUrl: JevStr { bytes: [0u8; 8192], len: 0}, apiKey: JevStr { bytes: [0u8; 8192], len: 0}, model: JevStr { bytes: [0u8; 8192], len: 0}, providerId: JevStr { bytes: [0u8; 8192], len: 0}, groupId: JevStr { bytes: [0u8; 8192], len: 0}, bridgeProtocol: JevStr { bytes: [0u8; 8192], len: 0}, timeoutMs: 0};
resolveJevCredentials(state, rawInput, &creds);
// const intentCriteria = hasCandidates? candidates: JEV_INTENT_TYPES;
let criteria_map = StringMap { key_off: [0u64; 64], key_len: [0u64; 64], val_off: [0u64; 64], val_len: [0u64; 64], keys_bytes: [0u8; 8192], keys_len: 0, vals_bytes: [0u8; 65536], vals_len: 0, len: 0};
if hasCandidates {
// Copy candidates into criteria_map.
stringmap_init(&criteria_map);
let ci: u64 = 0;
for ci in 0..candidates.len {
stringmap_set(&criteria_map, stringmap_key_ptr(&candidates, ci), candidates.key_len[ci], stringmap_val_ptr(&candidates, ci), candidates.val_len[ci]);
}
} else {
JEV_INTENT_TYPES(&criteria_map);
};
let clarity_map = StringMap { key_off: [0u64; 64], key_len: [0u64; 64], val_off: [0u64; 64], val_len: [0u64; 64], keys_bytes: [0u8; 8192], keys_len: 0, vals_bytes: [0u8; 65536], vals_len: 0, len: 0};
JEV_INTENT_CLARITY(&clarity_map);
let crit_json = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_map_json(&crit_json, &criteria_map);
let clarity_json = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_map_json(&clarity_json, &clarity_map);
let instr_i = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&instr_i, STR_PTR("What does the user most likely want? User input: "), STR_LEN("What does the user most likely want? User input: "));
buf_append_buf(&instr_i, &userText);
let instr_c = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&instr_c, STR_PTR("Is the user input clear enough to act on directly, or must the model ask/confirm first? User input: "), STR_LEN("Is the user input clear enough to act on directly, or must the model ask/confirm first? User input: "));
buf_append_buf(&instr_c, &userText);
let questions = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&questions, STR_PTR("{"), STR_LEN("{"));
buf_append_question(&questions, STR_PTR("primary_intent"), STR_LEN("primary_intent"), STR_PTR("choice"), STR_LEN("choice"), &instr_i, buf_ptr(&crit_json), crit_json.len);
buf_append_lit(&questions, STR_PTR(","), STR_LEN(","));
buf_append_question(&questions, STR_PTR("clarity"), STR_LEN("clarity"), STR_PTR("choice"), STR_LEN("choice"), &instr_c, buf_ptr(&clarity_json), clarity_json.len);
buf_append_lit(&questions, STR_PTR("}"), STR_LEN("}"));
let state_text = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&state_text, STR_PTR("[User Input]\n"), STR_LEN("[User Input]\n"));
buf_append_buf(&state_text, &userText);
buf_append_lit(&state_text, STR_PTR("\n\n[Context]\n"), STR_LEN("\n\n[Context]\n"));
buf_append_buf(&state_text, &context);
let payload = JevPayload { state: ByteBuf { bytes: [0u8; 262144], len: 0}, model: JevStr { bytes: [0u8; 8192], len: 0}, questions: ByteBuf { bytes: [0u8; 262144], len: 0}};
jev_make_payload(&state_text, &creds, &questions, &payload);
let call = JevCallResult { ok: false, data_doc: 0, data_bytes: [0u8; 262144], data_len: 0, latencyMs: 0, has_status: false, status: 0, error_bytes: [0u8; 16384], error_len: 0};
let rc = executeJevCall(state, &payload, &creds, &call);
if rc == 2 { return jev_overload_error(state, out);};
if!call.ok {
let err = ByteBuf { bytes: [0u8; 262144], len: 0};
call_error_into(&call, &err);
let stderr = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&stderr, STR_PTR("JEV intent analysis failed ("), STR_LEN("JEV intent analysis failed ("));
if call.has_status {
buf_append_i64(&stderr, call.status as i64);
} else {
buf_append_lit(&stderr, STR_PTR("502"), STR_LEN("502"));
};
buf_append_lit(&stderr, STR_PTR("): "), STR_LEN("): "));
buf_append_buf(&stderr, &err);
jev_fill_failure(out, call.has_status, call.status, buf_ptr(&err), err.len, &stderr, true, startedAt);
return 0;
};
let rawIntent = ByteBuf { bytes: [0u8; 262144], len: 0};
jev_answer_choice(call.data_doc, STR_PTR("primary_intent"), STR_LEN("primary_intent"), &rawIntent);
let intentKey = ByteBuf { bytes: [0u8; 262144], len: 0};
if stringmap_has(&criteria_map, buf_ptr(&rawIntent), rawIntent.len) {
buf_copy_into(&intentKey, &rawIntent);
};
let intentConfidence = jev_answer_confidence(call.data_doc, STR_PTR("primary_intent"), STR_LEN("primary_intent"));
let rawClarity0 = ByteBuf { bytes: [0u8; 262144], len: 0};
jev_answer_choice(call.data_doc, STR_PTR("clarity"), STR_LEN("clarity"), &rawClarity0);
let rawClarity = ByteBuf { bytes: [0u8; 262144], len: 0};
str_lower_into(&rawClarity, buf_ptr(&rawClarity0), rawClarity0.len);
let clarity = ByteBuf { bytes: [0u8; 262144], len: 0};
if stringmap_has(&clarity_map, buf_ptr(&rawClarity), rawClarity.len) {
buf_copy_into(&clarity, &rawClarity);
};
let clarityConfidence = jev_answer_confidence(call.data_doc, STR_PTR("clarity"), STR_LEN("clarity"));
// const firstStep = hasCandidates? "按该解读制定计划并着手执行": (JEV_INTENT_FIRST_STEPS[intentKey]?? "先确认理解再动手");
let firstStep = ByteBuf { bytes: [0u8; 262144], len: 0};
if hasCandidates {
buf_append_lit(&firstStep, STR_PTR("按该解读制定计划并着手执行"), STR_LEN("按该解读制定计划并着手执行"));
} else {
let steps = StringMap { key_off: [0u64; 64], key_len: [0u64; 64], val_off: [0u64; 64], val_len: [0u64; 64], keys_bytes: [0u8; 8192], keys_len: 0, vals_bytes: [0u8; 65536], vals_len: 0, len: 0};
JEV_INTENT_FIRST_STEPS(&steps);
if!stringmap_get(&steps, buf_ptr(&intentKey), intentKey.len, &firstStep) || firstStep.len == 0 {
buf_reset(&firstStep);
buf_append_lit(&firstStep, STR_PTR("先确认理解再动手"), STR_LEN("先确认理解再动手"));
};
};
let intentDesc = ByteBuf { bytes: [0u8; 262144], len: 0};
let has_idesc = stringmap_get(&criteria_map, buf_ptr(&intentKey), intentKey.len, &intentDesc);
let clarityDesc = ByteBuf { bytes: [0u8; 262144], len: 0};
let has_cdesc = stringmap_get(&clarity_map, buf_ptr(&clarity), clarity.len, &clarityDesc);
let summary = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&summary, STR_PTR("\n• 最可能意图：["), STR_LEN("\n• 最可能意图：["));
if intentKey.len > 0 {
buf_append_buf(&summary, &intentKey);
} else {
buf_append_lit(&summary, STR_PTR("?"), STR_LEN("?"));
};
buf_append_lit(&summary, STR_PTR("] "), STR_LEN("] "));
if has_idesc && intentDesc.len > 0 {
buf_append_buf(&summary, &intentDesc);
} else {
buf_append_lit(&summary, STR_PTR("未能判定"), STR_LEN("未能判定"));
};
buf_append_lit(&summary, STR_PTR("（置信度 "), STR_LEN("（置信度 "));
buf_append_u64(&summary, jev_percent(intentConfidence));
buf_append_lit(&summary, STR_PTR("%）\n• 清晰度：["), STR_LEN("%）\n• 清晰度：["));
if clarity.len > 0 {
buf_append_buf(&summary, &clarity);
} else {
buf_append_lit(&summary, STR_PTR("?"), STR_LEN("?"));
};
buf_append_lit(&summary, STR_PTR("] "), STR_LEN("] "));
if has_cdesc && clarityDesc.len > 0 {
buf_append_buf(&summary, &clarityDesc);
} else {
buf_append_lit(&summary, STR_PTR("未能判定"), STR_LEN("未能判定"));
};
buf_append_lit(&summary, STR_PTR("（置信度 "), STR_LEN("（置信度 "));
buf_append_u64(&summary, jev_percent(clarityConfidence));
buf_append_lit(&summary, STR_PTR("%）\n• 建议第一步："), STR_LEN("%）\n• 建议第一步："));
buf_append_buf(&summary, &firstStep);
buf_append_lit(&summary, STR_PTR("\n• 输入："), STR_LEN("\n• 输入："));
let in_n = userText.len;
if in_n > 200 { in_n = 200;};
buf_append(&summary, buf_ptr(&userText), in_n);
buf_append_lit(&summary, STR_PTR("\n• 耗时："), STR_LEN("\n• 耗时："));
buf_append_u64(&summary, call.latencyMs);
buf_append_lit(&summary, STR_PTR("ms · 模型："), STR_LEN("ms · 模型："));
buf_append(&summary, js_ptr(&creds.model), creds.model.len);
let stdout = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&stdout, STR_PTR("{\"action\":\"jev_intent\",\"user_input\":"), STR_LEN("{\"action\":\"jev_intent\",\"user_input\":"));
buf_append_json_str(&stdout, buf_ptr(&userText), userText.len);
buf_append_lit(&stdout, STR_PTR(",\"primary_intent\":"), STR_LEN(",\"primary_intent\":"));
if intentKey.len > 0 {
buf_append_json_str(&stdout, buf_ptr(&intentKey), intentKey.len);
} else {
buf_append_lit(&stdout, STR_PTR("null"), STR_LEN("null"));
};
buf_append_lit(&stdout, STR_PTR(",\"intent_confidence\":"), STR_LEN(",\"intent_confidence\":"));
buf_append_f64(&stdout, intentConfidence);
buf_append_lit(&stdout, STR_PTR(",\"intent_description\":"), STR_LEN(",\"intent_description\":"));
if has_idesc && intentDesc.len > 0 {
buf_append_json_str(&stdout, buf_ptr(&intentDesc), intentDesc.len);
} else {
buf_append_lit(&stdout, STR_PTR("null"), STR_LEN("null"));
};
buf_append_lit(&stdout, STR_PTR(",\"clarity\":"), STR_LEN(",\"clarity\":"));
if clarity.len > 0 {
buf_append_json_str(&stdout, buf_ptr(&clarity), clarity.len);
} else {
buf_append_lit(&stdout, STR_PTR("null"), STR_LEN("null"));
};
buf_append_lit(&stdout, STR_PTR(",\"clarity_confidence\":"), STR_LEN(",\"clarity_confidence\":"));
buf_append_f64(&stdout, clarityConfidence);
buf_append_lit(&stdout, STR_PTR(",\"clarity_description\":"), STR_LEN(",\"clarity_description\":"));
if has_cdesc && clarityDesc.len > 0 {
buf_append_json_str(&stdout, buf_ptr(&clarityDesc), clarityDesc.len);
} else {
buf_append_lit(&stdout, STR_PTR("null"), STR_LEN("null"));
};
buf_append_lit(&stdout, STR_PTR(",\"suggested_first_step\":"), STR_LEN(",\"suggested_first_step\":"));
buf_append_json_str(&stdout, buf_ptr(&firstStep), firstStep.len);
buf_append_lit(&stdout, STR_PTR(",\"summary\":"), STR_LEN(",\"summary\":"));
buf_append_json_str(&stdout, buf_ptr(&summary), summary.len);
buf_append_lit(&stdout, STR_PTR(",\"latencyMs\":"), STR_LEN(",\"latencyMs\":"));
buf_append_u64(&stdout, call.latencyMs);
buf_append_lit(&stdout, STR_PTR(",\"raw\":"), STR_LEN(",\"raw\":"));
buf_append(&stdout, call_data_ptr(&call), call.data_len);
buf_append_lit(&stdout, STR_PTR("}"), STR_LEN("}"));
jev_fill_success(out, &stdout, startedAt);
return 0;
}

//* Momentum verdicts for `jev_next` (keys are stable codes). 
// export const JEV_NEXT_VERDICTS: Record<string, string> = {...};
fn JEV_NEXT_VERDICTS(out: &StringMap) -> void {
stringmap_init(out);
stringmap_set_lit(out, STR_PTR("continue_now"), STR_LEN("continue_now"), STR_PTR("有明确下一步，主动续上"), STR_LEN("有明确下一步，主动续上"));
stringmap_set_lit(out, STR_PTR("confirm_first"), STR_LEN("confirm_first"), STR_PTR("有候选但需用户确认再续"), STR_LEN("有候选但需用户确认再续"));
stringmap_set_lit(out, STR_PTR("stop"), STR_LEN("stop"), STR_PTR("已收尾，无需续接"), STR_LEN("已收尾，无需续接"));
}

//*
//* Advisory next-task continuation (续接下一步, purely opt-in).
//* Call right after a task completes: JEV picks the best next task from
//* caller-provided candidates (or judges momentum from context backlog)
//* plus a continue/confirm/stop verdict, so the model can chain work
//* proactively instead of idling after each delivery.
//
// TS: export async function nativeJevNext(...): Promise<JevRunResult>
// DEFECT: async
fn nativeJevNext(state: &JevModuleState, rawInput: &JevRunInput, policy: &JevPolicyConfig, cwd_ptr: ptr, cwd_len: u64, startedAt: u64, out: &JevRunResult) -> i32 {
// const rawWork = (cast).completed_work?? (cast).completed?? rawInput.question?? rawInput.content;
let w_raw = ByteBuf { bytes: [0u8; 262144], len: 0};
let has_w = input_dyn_str(rawInput, STR_PTR("completed_work"), STR_LEN("completed_work"), &w_raw);
if!has_w { has_w = input_dyn_str(rawInput, STR_PTR("completed"), STR_LEN("completed"), &w_raw);};
if!has_w { has_w = input_str_field(rawInput, 0, &w_raw);};
if!has_w { has_w = input_str_field(rawInput, 2, &w_raw);};
let completedWork = ByteBuf { bytes: [0u8; 262144], len: 0};
str_trim_into(&completedWork, buf_ptr(&w_raw), w_raw.len);
if completedWork.len == 0 {
return jev_input_error(out, STR_PTR("action 'jev_next' requires a non-empty 'question' parameter (summary of the just-completed work)"), STR_LEN("action 'jev_next' requires a non-empty 'question' parameter (summary of the just-completed work)"));
};
// const rawOptions = (cast).candidates?? rawInput.options;
let raw_opts = ByteBuf { bytes: [0u8; 262144], len: 0};
let raw_kind: u64 = 0;
let has_raw_opts = input_dyn_json(rawInput, STR_PTR("candidates"), STR_LEN("candidates"), &raw_opts, &raw_kind);
if!has_raw_opts { has_raw_opts = input_json_field(rawInput, 4, &raw_opts, &raw_kind);};
let hasCandidates = false;
if has_raw_opts && raw_kind!= 0 {
if raw_kind == 1 {
let t = ByteBuf { bytes: [0u8; 262144], len: 0};
str_trim_into(&t, buf_ptr(&raw_opts), raw_opts.len);
hasCandidates = t.len > 0;
} else {
hasCandidates = true;
};
};
let candidates = StringMap { key_off: [0u64; 64], key_len: [0u64; 64], val_off: [0u64; 64], val_len: [0u64; 64], keys_bytes: [0u8; 8192], keys_len: 0, vals_bytes: [0u8; 65536], vals_len: 0, len: 0};
stringmap_init(&candidates);
if hasCandidates {
normalizeChoiceOptions(buf_ptr(&raw_opts), raw_opts.len, raw_kind, &candidates);
if candidates.len < 2 {
return jev_input_error(out, STR_PTR("action 'jev_next' requires at least 2 candidate next tasks in 'options' (or omit 'options' to judge momentum from context)"), STR_LEN("action 'jev_next' requires at least 2 candidate next tasks in 'options' (or omit 'options' to judge momentum from context)"));
};
if candidates.len > 6 {
jev_map_truncate(&candidates, 6);
};
};
let ctx_kind: u64 = 0;
let ctx_raw = ByteBuf { bytes: [0u8; 262144], len: 0};
jev_pick_context(rawInput, &ctx_kind, &ctx_raw);
let context = ByteBuf { bytes: [0u8; 262144], len: 0};
truncateJevContext(buf_ptr(&ctx_raw), ctx_raw.len, ctx_kind, &context);
let creds = JevCredentials { baseUrl: JevStr { bytes: [0u8; 8192], len: 0}, apiKey: JevStr { bytes: [0u8; 8192], len: 0}, model: JevStr { bytes: [0u8; 8192], len: 0}, providerId: JevStr { bytes: [0u8; 8192], len: 0}, groupId: JevStr { bytes: [0u8; 8192], len: 0}, bridgeProtocol: JevStr { bytes: [0u8; 8192], len: 0}, timeoutMs: 0};
resolveJevCredentials(state, rawInput, &creds);
let questions = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&questions, STR_PTR("{"), STR_LEN("{"));
let first_q = true;
if hasCandidates {
let cand_json = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_map_json(&cand_json, &candidates);
let instr_n = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&instr_n, STR_PTR("Given the just-completed work, which candidate should be done next? Completed: "), STR_LEN("Given the just-completed work, which candidate should be done next? Completed: "));
buf_append_buf(&instr_n, &completedWork);
buf_append_question(&questions, STR_PTR("next_task"), STR_LEN("next_task"), STR_PTR("choice"), STR_LEN("choice"), &instr_n, buf_ptr(&cand_json), cand_json.len);
first_q = false;
};
let verdicts = StringMap { key_off: [0u64; 64], key_len: [0u64; 64], val_off: [0u64; 64], val_len: [0u64; 64], keys_bytes: [0u8; 8192], keys_len: 0, vals_bytes: [0u8; 65536], vals_len: 0, len: 0};
JEV_NEXT_VERDICTS(&verdicts);
let verdicts_json = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_map_json(&verdicts_json, &verdicts);
let instr_m = ByteBuf { bytes: [0u8; 262144], len: 0};
if hasCandidates {
buf_append_lit(&instr_m, STR_PTR("Should the model continue into the next task immediately, confirm with the user first, or stop? Completed: "), STR_LEN("Should the model continue into the next task immediately, confirm with the user first, or stop? Completed: "));
} else {
buf_append_lit(&instr_m, STR_PTR("Based on the completed work and remaining backlog in context, should the model continue working, or is everything done? Completed: "), STR_LEN("Based on the completed work and remaining backlog in context, should the model continue working, or is everything done? Completed: "));
};
buf_append_buf(&instr_m, &completedWork);
if!first_q {
buf_append_lit(&questions, STR_PTR(","), STR_LEN(","));
};
buf_append_question(&questions, STR_PTR("momentum"), STR_LEN("momentum"), STR_PTR("choice"), STR_LEN("choice"), &instr_m, buf_ptr(&verdicts_json), verdicts_json.len);
buf_append_lit(&questions, STR_PTR("}"), STR_LEN("}"));
let state_text = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&state_text, STR_PTR("[Completed]\n"), STR_LEN("[Completed]\n"));
buf_append_buf(&state_text, &completedWork);
buf_append_lit(&state_text, STR_PTR("\n\n[Context]\n"), STR_LEN("\n\n[Context]\n"));
buf_append_buf(&state_text, &context);
let payload = JevPayload { state: ByteBuf { bytes: [0u8; 262144], len: 0}, model: JevStr { bytes: [0u8; 8192], len: 0}, questions: ByteBuf { bytes: [0u8; 262144], len: 0}};
jev_make_payload(&state_text, &creds, &questions, &payload);
let call = JevCallResult { ok: false, data_doc: 0, data_bytes: [0u8; 262144], data_len: 0, latencyMs: 0, has_status: false, status: 0, error_bytes: [0u8; 16384], error_len: 0};
let rc = executeJevCall(state, &payload, &creds, &call);
if rc == 2 { return jev_overload_error(state, out);};
if!call.ok {
let err = ByteBuf { bytes: [0u8; 262144], len: 0};
call_error_into(&call, &err);
let stderr = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&stderr, STR_PTR("JEV next-task analysis failed ("), STR_LEN("JEV next-task analysis failed ("));
if call.has_status {
buf_append_i64(&stderr, call.status as i64);
} else {
buf_append_lit(&stderr, STR_PTR("502"), STR_LEN("502"));
};
buf_append_lit(&stderr, STR_PTR("): "), STR_LEN("): "));
buf_append_buf(&stderr, &err);
jev_fill_failure(out, call.has_status, call.status, buf_ptr(&err), err.len, &stderr, true, startedAt);
return 0;
};
let nextKey = ByteBuf { bytes: [0u8; 262144], len: 0};
let nextConfidence: f64 = 1.0;
if hasCandidates {
let rawNext = ByteBuf { bytes: [0u8; 262144], len: 0};
jev_answer_choice(call.data_doc, STR_PTR("next_task"), STR_LEN("next_task"), &rawNext);
if stringmap_has(&candidates, buf_ptr(&rawNext), rawNext.len) {
buf_copy_into(&nextKey, &rawNext);
};
nextConfidence = jev_answer_confidence(call.data_doc, STR_PTR("next_task"), STR_LEN("next_task"));
};
let mom_raw = ByteBuf { bytes: [0u8; 262144], len: 0};
jev_answer_choice(call.data_doc, STR_PTR("momentum"), STR_LEN("momentum"), &mom_raw);
let mom_lower = ByteBuf { bytes: [0u8; 262144], len: 0};
str_lower_into(&mom_lower, buf_ptr(&mom_raw), mom_raw.len);
let momentum = ByteBuf { bytes: [0u8; 262144], len: 0};
if stringmap_has(&verdicts, buf_ptr(&mom_lower), mom_lower.len) {
buf_copy_into(&momentum, &mom_lower);
};
let momentumConfidence = jev_answer_confidence(call.data_doc, STR_PTR("momentum"), STR_LEN("momentum"));
let autoContinue = jev_str_eq(buf_ptr(&momentum), momentum.len, STR_PTR("continue_now"), STR_LEN("continue_now"));
let nextDesc = ByteBuf { bytes: [0u8; 262144], len: 0};
let has_ndesc = false;
if hasCandidates {
has_ndesc = stringmap_get(&candidates, buf_ptr(&nextKey), nextKey.len, &nextDesc);
};
let momDesc = ByteBuf { bytes: [0u8; 262144], len: 0};
let has_mdesc = stringmap_get(&verdicts, buf_ptr(&momentum), momentum.len, &momDesc);
let summary = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&summary, STR_PTR(""), STR_LEN(""));
if hasCandidates {
buf_append_lit(&summary, STR_PTR("\n• 下一步：["), STR_LEN("\n• 下一步：["));
if nextKey.len > 0 {
buf_append_buf(&summary, &nextKey);
} else {
buf_append_lit(&summary, STR_PTR("?"), STR_LEN("?"));
};
buf_append_lit(&summary, STR_PTR("] "), STR_LEN("] "));
if has_ndesc && nextDesc.len > 0 {
buf_append_buf(&summary, &nextDesc);
} else {
buf_append_lit(&summary, STR_PTR("未能判定"), STR_LEN("未能判定"));
};
buf_append_lit(&summary, STR_PTR("（置信度 "), STR_LEN("（置信度 "));
buf_append_u64(&summary, jev_percent(nextConfidence));
buf_append_lit(&summary, STR_PTR("%）"), STR_LEN("%）"));
} else {
buf_append_lit(&summary, STR_PTR("\n• 候选未给，按上下文 backlog 判定动量"), STR_LEN("\n• 候选未给，按上下文 backlog 判定动量"));
};
buf_append_lit(&summary, STR_PTR("\n• 动量裁决：["), STR_LEN("\n• 动量裁决：["));
if momentum.len > 0 {
buf_append_buf(&summary, &momentum);
} else {
buf_append_lit(&summary, STR_PTR("?"), STR_LEN("?"));
};
buf_append_lit(&summary, STR_PTR("] "), STR_LEN("] "));
if has_mdesc && momDesc.len > 0 {
buf_append_buf(&summary, &momDesc);
} else {
buf_append_lit(&summary, STR_PTR("未能判定"), STR_LEN("未能判定"));
};
buf_append_lit(&summary, STR_PTR("（置信度 "), STR_LEN("（置信度 "));
buf_append_u64(&summary, jev_percent(momentumConfidence));
buf_append_lit(&summary, STR_PTR("%）\n• 是否主动续上："), STR_LEN("%）\n• 是否主动续上："));
if autoContinue {
buf_append_lit(&summary, STR_PTR("是（直接开干下一步）"), STR_LEN("是（直接开干下一步）"));
} else {
buf_append_lit(&summary, STR_PTR("否（先确认或收尾）"), STR_LEN("否（先确认或收尾）"));
};
buf_append_lit(&summary, STR_PTR("\n• 已完成："), STR_LEN("\n• 已完成："));
let cw_n = completedWork.len;
if cw_n > 200 { cw_n = 200;};
buf_append(&summary, buf_ptr(&completedWork), cw_n);
buf_append_lit(&summary, STR_PTR("\n• 耗时："), STR_LEN("\n• 耗时："));
buf_append_u64(&summary, call.latencyMs);
buf_append_lit(&summary, STR_PTR("ms · 模型："), STR_LEN("ms · 模型："));
buf_append(&summary, js_ptr(&creds.model), creds.model.len);
let stdout = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&stdout, STR_PTR("{\"action\":\"jev_next\",\"completed_work\":"), STR_LEN("{\"action\":\"jev_next\",\"completed_work\":"));
buf_append_json_str(&stdout, buf_ptr(&completedWork), completedWork.len);
buf_append_lit(&stdout, STR_PTR(",\"next_task\":"), STR_LEN(",\"next_task\":"));
if nextKey.len > 0 {
buf_append_json_str(&stdout, buf_ptr(&nextKey), nextKey.len);
} else {
buf_append_lit(&stdout, STR_PTR("null"), STR_LEN("null"));
};
buf_append_lit(&stdout, STR_PTR(",\"next_confidence\":"), STR_LEN(",\"next_confidence\":"));
buf_append_f64(&stdout, nextConfidence);
buf_append_lit(&stdout, STR_PTR(",\"next_description\":"), STR_LEN(",\"next_description\":"));
if has_ndesc && nextDesc.len > 0 {
buf_append_json_str(&stdout, buf_ptr(&nextDesc), nextDesc.len);
} else {
buf_append_lit(&stdout, STR_PTR("null"), STR_LEN("null"));
};
buf_append_lit(&stdout, STR_PTR(",\"momentum\":"), STR_LEN(",\"momentum\":"));
if momentum.len > 0 {
buf_append_json_str(&stdout, buf_ptr(&momentum), momentum.len);
} else {
buf_append_lit(&stdout, STR_PTR("null"), STR_LEN("null"));
};
buf_append_lit(&stdout, STR_PTR(",\"momentum_confidence\":"), STR_LEN(",\"momentum_confidence\":"));
buf_append_f64(&stdout, momentumConfidence);
buf_append_lit(&stdout, STR_PTR(",\"auto_continue\":"), STR_LEN(",\"auto_continue\":"));
if autoContinue {
buf_append_lit(&stdout, STR_PTR("true"), STR_LEN("true"));
} else {
buf_append_lit(&stdout, STR_PTR("false"), STR_LEN("false"));
};
buf_append_lit(&stdout, STR_PTR(",\"summary\":"), STR_LEN(",\"summary\":"));
buf_append_json_str(&stdout, buf_ptr(&summary), summary.len);
buf_append_lit(&stdout, STR_PTR(",\"latencyMs\":"), STR_LEN(",\"latencyMs\":"));
buf_append_u64(&stdout, call.latencyMs);
buf_append_lit(&stdout, STR_PTR(",\"raw\":"), STR_LEN(",\"raw\":"));
buf_append(&stdout, call_data_ptr(&call), call.data_len);
buf_append_lit(&stdout, STR_PTR("}"), STR_LEN("}"));
jev_fill_success(out, &stdout, startedAt);
return 0;
}

//* Progress bands for `jev_progress` (keys are stable codes). 
// export const JEV_PROGRESS_BANDS: Record<string, string> = {...};
fn JEV_PROGRESS_BANDS(out: &StringMap) -> void {
stringmap_init(out);
stringmap_set_lit(out, STR_PTR("s0_25"), STR_LEN("s0_25"), STR_PTR("起步 0–25%：刚开工或仍在探路"), STR_LEN("起步 0–25%：刚开工或仍在探路"));
stringmap_set_lit(out, STR_PTR("s25_50"), STR_LEN("s25_50"), STR_PTR("推进 25–50%：骨架已立，主体未成"), STR_LEN("推进 25–50%：骨架已立，主体未成"));
stringmap_set_lit(out, STR_PTR("s50_75"), STR_LEN("s50_75"), STR_PTR("过半 50–75%：主体完成，收尾未验"), STR_LEN("过半 50–75%：主体完成，收尾未验"));
stringmap_set_lit(out, STR_PTR("s75_99"), STR_LEN("s75_99"), STR_PTR("收尾 75–99%：只差验证与合入"), STR_LEN("收尾 75–99%：只差验证与合入"));
stringmap_set_lit(out, STR_PTR("s100"), STR_LEN("s100"), STR_PTR("完成 100%：已交付可验收"), STR_LEN("完成 100%：已交付可验收"));
}

//* Health verdicts for `jev_progress` (keys are stable codes). 
// export const JEV_PROGRESS_VERDICTS: Record<string, string> = {...};
fn JEV_PROGRESS_VERDICTS(out: &StringMap) -> void {
stringmap_init(out);
stringmap_set_lit(out, STR_PTR("on_track"), STR_LEN("on_track"), STR_PTR("在轨：按计划推进，继续当前下一步"), STR_LEN("在轨：按计划推进，继续当前下一步"));
stringmap_set_lit(out, STR_PTR("at_risk"), STR_LEN("at_risk"), STR_PTR("风险：有阻塞苗头，需先清障碍再推进"), STR_LEN("风险：有阻塞苗头，需先清障碍再推进"));
stringmap_set_lit(out, STR_PTR("blocked"), STR_LEN("blocked"), STR_PTR("阻塞：已被卡住，停下先解阻塞"), STR_LEN("阻塞：已被卡住，停下先解阻塞"));
stringmap_set_lit(out, STR_PTR("done"), STR_LEN("done"), STR_PTR("已完成：无需再推进，转验收"), STR_LEN("已完成：无需再推进，转验收"));
}

// const JEV_PROGRESS_BAND_PERCENT: Record<string, number> = {
// s0_25: 12, s25_50: 37, s50_75: 62, s75_99: 87, s100: 100};
// (Not exported in TS.) Unknown keys yield TS undefined; the
// caller applies `?? 12`, mirrored here by returning 12.
fn JEV_PROGRESS_BAND_PERCENT(band_ptr: ptr, band_len: u64) -> u64 {
if jev_str_eq(band_ptr, band_len, STR_PTR("s0_25"), STR_LEN("s0_25")) { return 12;};
if jev_str_eq(band_ptr, band_len, STR_PTR("s25_50"), STR_LEN("s25_50")) { return 37;};
if jev_str_eq(band_ptr, band_len, STR_PTR("s50_75"), STR_LEN("s50_75")) { return 62;};
if jev_str_eq(band_ptr, band_len, STR_PTR("s75_99"), STR_LEN("s75_99")) { return 87;};
if jev_str_eq(band_ptr, band_len, STR_PTR("s100"), STR_LEN("s100")) { return 100;};
return 12;
}

//*
//* Advisory task-progress check (任务进度裁决, purely opt-in).
//* For a named task with optional phases and a completed-so-far summary,
//* JEV returns a progress band + health verdict + next step, like a boss
//* asking for status. Trigger manually on long multi-phase work only;
//* never poll every turn. Bridge-safe aliases: task <= question,
//* phases <= options, completed <= content.
//
// TS: export async function nativeJevProgress(...): Promise<JevRunResult>
// DEFECT: async
fn nativeJevProgress(state: &JevModuleState, rawInput: &JevRunInput, policy: &JevPolicyConfig, cwd_ptr: ptr, cwd_len: u64, startedAt: u64, out: &JevRunResult) -> i32 {
// const rawTask = (cast).task?? rawInput.question?? (cast).prompt?? (cast).goal;
let t_raw = ByteBuf { bytes: [0u8; 262144], len: 0};
let has_t = input_dyn_str(rawInput, STR_PTR("task"), STR_LEN("task"), &t_raw);
if!has_t { has_t = input_str_field(rawInput, 0, &t_raw);};
if!has_t { has_t = input_dyn_str(rawInput, STR_PTR("prompt"), STR_LEN("prompt"), &t_raw);};
if!has_t { has_t = input_dyn_str(rawInput, STR_PTR("goal"), STR_LEN("goal"), &t_raw);};
let task = ByteBuf { bytes: [0u8; 262144], len: 0};
str_trim_into(&task, buf_ptr(&t_raw), t_raw.len);
if task.len == 0 {
return jev_input_error(out, STR_PTR("action 'jev_progress' requires a non-empty 'task' parameter (use 'question' through the bridge)"), STR_LEN("action 'jev_progress' requires a non-empty 'task' parameter (use 'question' through the bridge)"));
};
// const rawCompleted = (cast).completed?? (cast).actual_work?? (cast).work?? rawInput.content?? "";
let c_raw = ByteBuf { bytes: [0u8; 262144], len: 0};
let has_c = input_dyn_str(rawInput, STR_PTR("completed"), STR_LEN("completed"), &c_raw);
if!has_c { has_c = input_dyn_str(rawInput, STR_PTR("actual_work"), STR_LEN("actual_work"), &c_raw);};
if!has_c { has_c = input_dyn_str(rawInput, STR_PTR("work"), STR_LEN("work"), &c_raw);};
if!has_c { has_c = input_str_field(rawInput, 2, &c_raw);};
let completed = ByteBuf { bytes: [0u8; 262144], len: 0};
str_trim_into(&completed, buf_ptr(&c_raw), c_raw.len);
// const rawPhases = (cast).phases?? rawInput.options?? (cast).units;
let raw_phases = ByteBuf { bytes: [0u8; 262144], len: 0};
let raw_kind: u64 = 0;
if!input_dyn_json(rawInput, STR_PTR("phases"), STR_LEN("phases"), &raw_phases, &raw_kind) {
if!input_json_field(rawInput, 4, &raw_phases, &raw_kind) {
input_dyn_json(rawInput, STR_PTR("units"), STR_LEN("units"), &raw_phases, &raw_kind);
};
};
let phases = StringMap { key_off: [0u64; 64], key_len: [0u64; 64], val_off: [0u64; 64], val_len: [0u64; 64], keys_bytes: [0u8; 8192], keys_len: 0, vals_bytes: [0u8; 65536], vals_len: 0, len: 0};
normalizeChoiceOptions(buf_ptr(&raw_phases), raw_phases.len, raw_kind, &phases);
if phases.len > 6 {
jev_map_truncate(&phases, 6);
};
let ctx_kind: u64 = 0;
let ctx_raw = ByteBuf { bytes: [0u8; 262144], len: 0};
jev_pick_context(rawInput, &ctx_kind, &ctx_raw);
let context = ByteBuf { bytes: [0u8; 262144], len: 0};
truncateJevContext(buf_ptr(&ctx_raw), ctx_raw.len, ctx_kind, &context);
let creds = JevCredentials { baseUrl: JevStr { bytes: [0u8; 8192], len: 0}, apiKey: JevStr { bytes: [0u8; 8192], len: 0}, model: JevStr { bytes: [0u8; 8192], len: 0}, providerId: JevStr { bytes: [0u8; 8192], len: 0}, groupId: JevStr { bytes: [0u8; 8192], len: 0}, bridgeProtocol: JevStr { bytes: [0u8; 8192], len: 0}, timeoutMs: 0};
resolveJevCredentials(state, rawInput, &creds);
let bands = StringMap { key_off: [0u64; 64], key_len: [0u64; 64], val_off: [0u64; 64], val_len: [0u64; 64], keys_bytes: [0u8; 8192], keys_len: 0, vals_bytes: [0u8; 65536], vals_len: 0, len: 0};
JEV_PROGRESS_BANDS(&bands);
let healths = StringMap { key_off: [0u64; 64], key_len: [0u64; 64], val_off: [0u64; 64], val_len: [0u64; 64], keys_bytes: [0u8; 8192], keys_len: 0, vals_bytes: [0u8; 65536], vals_len: 0, len: 0};
JEV_PROGRESS_VERDICTS(&healths);
let bands_json = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_map_json(&bands_json, &bands);
let health_json = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_map_json(&health_json, &healths);
let instr_b = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&instr_b, STR_PTR("How far along is this task? Task: "), STR_LEN("How far along is this task? Task: "));
buf_append_buf(&instr_b, &task);
let instr_h = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&instr_h, STR_PTR("Is this task on track, at risk, blocked, or done? Task: "), STR_LEN("Is this task on track, at risk, blocked, or done? Task: "));
buf_append_buf(&instr_h, &task);
let questions = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&questions, STR_PTR("{"), STR_LEN("{"));
buf_append_question(&questions, STR_PTR("progress_band"), STR_LEN("progress_band"), STR_PTR("choice"), STR_LEN("choice"), &instr_b, buf_ptr(&bands_json), bands_json.len);
buf_append_lit(&questions, STR_PTR(","), STR_LEN(","));
buf_append_question(&questions, STR_PTR("health"), STR_LEN("health"), STR_PTR("choice"), STR_LEN("choice"), &instr_h, buf_ptr(&health_json), health_json.len);
if phases.len > 0 {
let instr_n = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&instr_n, STR_PTR("Given what is completed, which phase should be done next? Task: "), STR_LEN("Given what is completed, which phase should be done next? Task: "));
buf_append_buf(&instr_n, &task);
let phases_json = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_map_json(&phases_json, &phases);
buf_append_lit(&questions, STR_PTR(","), STR_LEN(","));
buf_append_question(&questions, STR_PTR("next_step"), STR_LEN("next_step"), STR_PTR("choice"), STR_LEN("choice"), &instr_n, buf_ptr(&phases_json), phases_json.len);
};
buf_append_lit(&questions, STR_PTR("}"), STR_LEN("}"));
let state_text = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&state_text, STR_PTR("[Task]\n"), STR_LEN("[Task]\n"));
buf_append_buf(&state_text, &task);
buf_append_lit(&state_text, STR_PTR("\n\n[Completed]\n"), STR_LEN("\n\n[Completed]\n"));
if completed.len > 0 {
buf_append_buf(&state_text, &completed);
} else {
buf_append_lit(&state_text, STR_PTR("(nothing reported yet)"), STR_LEN("(nothing reported yet)"));
};
buf_append_lit(&state_text, STR_PTR("\n\n[Context]\n"), STR_LEN("\n\n[Context]\n"));
buf_append_buf(&state_text, &context);
let payload = JevPayload { state: ByteBuf { bytes: [0u8; 262144], len: 0}, model: JevStr { bytes: [0u8; 8192], len: 0}, questions: ByteBuf { bytes: [0u8; 262144], len: 0}};
jev_make_payload(&state_text, &creds, &questions, &payload);
let call = JevCallResult { ok: false, data_doc: 0, data_bytes: [0u8; 262144], data_len: 0, latencyMs: 0, has_status: false, status: 0, error_bytes: [0u8; 16384], error_len: 0};
let rc = executeJevCall(state, &payload, &creds, &call);
if rc == 2 { return jev_overload_error(state, out);};
if!call.ok {
let err = ByteBuf { bytes: [0u8; 262144], len: 0};
call_error_into(&call, &err);
let stderr = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&stderr, STR_PTR("JEV progress check failed ("), STR_LEN("JEV progress check failed ("));
if call.has_status {
buf_append_i64(&stderr, call.status as i64);
} else {
buf_append_lit(&stderr, STR_PTR("502"), STR_LEN("502"));
};
buf_append_lit(&stderr, STR_PTR("): "), STR_LEN("): "));
buf_append_buf(&stderr, &err);
jev_fill_failure(out, call.has_status, call.status, buf_ptr(&err), err.len, &stderr, true, startedAt);
return 0;
};
// let band = JEV_PROGRESS_BANDS[rawBand]!== undefined? rawBand: "s0_25";
let rawBand = ByteBuf { bytes: [0u8; 262144], len: 0};
jev_answer_choice(call.data_doc, STR_PTR("progress_band"), STR_LEN("progress_band"), &rawBand);
let band = ByteBuf { bytes: [0u8; 262144], len: 0};
if stringmap_has(&bands, buf_ptr(&rawBand), rawBand.len) {
buf_copy_into(&band, &rawBand);
} else {
buf_append_lit(&band, STR_PTR("s0_25"), STR_LEN("s0_25"));
};
let bandConfidence = jev_answer_confidence(call.data_doc, STR_PTR("progress_band"), STR_LEN("progress_band"));
let rawHealth0 = ByteBuf { bytes: [0u8; 262144], len: 0};
jev_answer_choice(call.data_doc, STR_PTR("health"), STR_LEN("health"), &rawHealth0);
let rawHealth = ByteBuf { bytes: [0u8; 262144], len: 0};
str_lower_into(&rawHealth, buf_ptr(&rawHealth0), rawHealth0.len);
// const health = JEV_PROGRESS_VERDICTS[rawHealth]!== undefined? rawHealth: "on_track";
let health = ByteBuf { bytes: [0u8; 262144], len: 0};
if stringmap_has(&healths, buf_ptr(&rawHealth), rawHealth.len) {
buf_copy_into(&health, &rawHealth);
} else {
buf_append_lit(&health, STR_PTR("on_track"), STR_LEN("on_track"));
};
let healthConfidence = jev_answer_confidence(call.data_doc, STR_PTR("health"), STR_LEN("health"));
let nextStep = ByteBuf { bytes: [0u8; 262144], len: 0};
let nextConfidence: f64 = 1.0;
if phases.len > 0 {
let rawNext = ByteBuf { bytes: [0u8; 262144], len: 0};
jev_answer_choice(call.data_doc, STR_PTR("next_step"), STR_LEN("next_step"), &rawNext);
if stringmap_has(&phases, buf_ptr(&rawNext), rawNext.len) {
buf_copy_into(&nextStep, &rawNext);
};
nextConfidence = jev_answer_confidence(call.data_doc, STR_PTR("next_step"), STR_LEN("next_step"));
};
// if (health === "done") band = "s100";
if jev_str_eq(buf_ptr(&health), health.len, STR_PTR("done"), STR_LEN("done")) {
buf_reset(&band);
buf_append_lit(&band, STR_PTR("s100"), STR_LEN("s100"));
};
let percent = JEV_PROGRESS_BAND_PERCENT(buf_ptr(&band), band.len);
let bandDesc = ByteBuf { bytes: [0u8; 262144], len: 0};
stringmap_get(&bands, buf_ptr(&band), band.len, &bandDesc);
let healthDesc = ByteBuf { bytes: [0u8; 262144], len: 0};
stringmap_get(&healths, buf_ptr(&health), health.len, &healthDesc);
let summary = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&summary, STR_PTR("\n• 进度：["), STR_LEN("\n• 进度：["));
buf_append_buf(&summary, &band);
buf_append_lit(&summary, STR_PTR("] "), STR_LEN("] "));
buf_append_buf(&summary, &bandDesc);
buf_append_lit(&summary, STR_PTR("（约 "), STR_LEN("（约 "));
buf_append_u64(&summary, percent);
buf_append_lit(&summary, STR_PTR("%，置信度 "), STR_LEN("%，置信度 "));
buf_append_u64(&summary, jev_percent(bandConfidence));
buf_append_lit(&summary, STR_PTR("%）\n• 健康度：["), STR_LEN("%）\n• 健康度：["));
buf_append_buf(&summary, &health);
buf_append_lit(&summary, STR_PTR("] "), STR_LEN("] "));
buf_append_buf(&summary, &healthDesc);
buf_append_lit(&summary, STR_PTR("（置信度 "), STR_LEN("（置信度 "));
buf_append_u64(&summary, jev_percent(healthConfidence));
buf_append_lit(&summary, STR_PTR("%）"), STR_LEN("%）"));
if nextStep.len > 0 {
let ndesc = ByteBuf { bytes: [0u8; 262144], len: 0};
stringmap_get(&phases, buf_ptr(&nextStep), nextStep.len, &ndesc);
buf_append_lit(&summary, STR_PTR("\n• 下一步：["), STR_LEN("\n• 下一步：["));
buf_append_buf(&summary, &nextStep);
buf_append_lit(&summary, STR_PTR("] "), STR_LEN("] "));
buf_append_buf(&summary, &ndesc);
buf_append_lit(&summary, STR_PTR("（置信度 "), STR_LEN("（置信度 "));
buf_append_u64(&summary, jev_percent(nextConfidence));
buf_append_lit(&summary, STR_PTR("%）"), STR_LEN("%）"));
} else {
buf_append_lit(&summary, STR_PTR("\n• 下一步：未给候选阶段，按健康度行动"), STR_LEN("\n• 下一步：未给候选阶段，按健康度行动"));
};
buf_append_lit(&summary, STR_PTR("\n• 任务："), STR_LEN("\n• 任务："));
let tk_n = task.len;
if tk_n > 200 { tk_n = 200;};
buf_append(&summary, buf_ptr(&task), tk_n);
buf_append_lit(&summary, STR_PTR("\n• 耗时："), STR_LEN("\n• 耗时："));
buf_append_u64(&summary, call.latencyMs);
buf_append_lit(&summary, STR_PTR("ms · 模型："), STR_LEN("ms · 模型："));
buf_append(&summary, js_ptr(&creds.model), creds.model.len);
let stdout = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&stdout, STR_PTR("{\"action\":\"jev_progress\",\"task\":"), STR_LEN("{\"action\":\"jev_progress\",\"task\":"));
buf_append_json_str(&stdout, buf_ptr(&task), task.len);
buf_append_lit(&stdout, STR_PTR(",\"completed\":"), STR_LEN(",\"completed\":"));
if completed.len > 0 {
buf_append_json_str(&stdout, buf_ptr(&completed), completed.len);
} else {
buf_append_lit(&stdout, STR_PTR("null"), STR_LEN("null"));
};
buf_append_lit(&stdout, STR_PTR(",\"progress_band\":"), STR_LEN(",\"progress_band\":"));
buf_append_json_str(&stdout, buf_ptr(&band), band.len);
buf_append_lit(&stdout, STR_PTR(",\"percent_hint\":"), STR_LEN(",\"percent_hint\":"));
buf_append_u64(&stdout, percent);
buf_append_lit(&stdout, STR_PTR(",\"band_confidence\":"), STR_LEN(",\"band_confidence\":"));
buf_append_f64(&stdout, bandConfidence);
buf_append_lit(&stdout, STR_PTR(",\"health\":"), STR_LEN(",\"health\":"));
buf_append_json_str(&stdout, buf_ptr(&health), health.len);
buf_append_lit(&stdout, STR_PTR(",\"health_confidence\":"), STR_LEN(",\"health_confidence\":"));
buf_append_f64(&stdout, healthConfidence);
buf_append_lit(&stdout, STR_PTR(",\"health_description\":"), STR_LEN(",\"health_description\":"));
buf_append_json_str(&stdout, buf_ptr(&healthDesc), healthDesc.len);
buf_append_lit(&stdout, STR_PTR(",\"next_step\":"), STR_LEN(",\"next_step\":"));
if nextStep.len > 0 {
buf_append_json_str(&stdout, buf_ptr(&nextStep), nextStep.len);
} else {
buf_append_lit(&stdout, STR_PTR("null"), STR_LEN("null"));
};
buf_append_lit(&stdout, STR_PTR(",\"next_confidence\":"), STR_LEN(",\"next_confidence\":"));
buf_append_f64(&stdout, nextConfidence);
buf_append_lit(&stdout, STR_PTR(",\"summary\":"), STR_LEN(",\"summary\":"));
buf_append_json_str(&stdout, buf_ptr(&summary), summary.len);
buf_append_lit(&stdout, STR_PTR(",\"latencyMs\":"), STR_LEN(",\"latencyMs\":"));
buf_append_u64(&stdout, call.latencyMs);
buf_append_lit(&stdout, STR_PTR(",\"raw\":"), STR_LEN(",\"raw\":"));
buf_append(&stdout, call_data_ptr(&call), call.data_len);
buf_append_lit(&stdout, STR_PTR("}"), STR_LEN("}"));
jev_fill_success(out, &stdout, startedAt);
return 0;
}

//* Memory-scope verdicts for `jev_memory` (skip/workspace/global). 
// export const JEV_MEMORY_SCOPES: Record<string, string> = {...};
fn JEV_MEMORY_SCOPES(out: &StringMap) -> void {
stringmap_init(out);
stringmap_set_lit(out, STR_PTR("skip"), STR_LEN("skip"), STR_PTR("不值得记忆：临时任务状态、一次性输出、无复用价值"), STR_LEN("不值得记忆：临时任务状态、一次性输出、无复用价值"));
stringmap_set_lit(out, STR_PTR("workspace"), STR_LEN("workspace"), STR_PTR("工程记忆：仅当前工作区复用（架构暗知识、环境规则、调试线索）"), STR_LEN("工程记忆：仅当前工作区复用（架构暗知识、环境规则、调试线索）"));
stringmap_set_lit(out, STR_PTR("global"), STR_LEN("global"), STR_PTR("全局记忆：跨工程复用（用户偏好、通用约定、工具链密码端口等）"), STR_LEN("全局记忆：跨工程复用（用户偏好、通用约定、工具链密码端口等）"));
}

// Memory key derivation shared by both nativeJevMemory paths:
// const key = fact.slice(0, 24).replace(/\s+/g, "_") || "memory";
// DEFECT: regex — the \s+ collapse is a manual scan; \s covers more
// Unicode whitespace in JS than the ASCII set used here.
fn jev_memory_key(fact: &ByteBuf, out: &ByteBuf) -> void {
buf_reset(out);
let n = fact.len;
if n > 24 { n = 24;};
let in_ws = false;
let i: u64 = 0;
while i < n {
let b: u8 = 0;
PTR_BYTE_AT(b, buf_ptr(fact), i);
if is_ws_byte(b) {
if!in_ws {
if out.len < 262144 {
out.bytes[out.len] = 95;
out.len = out.len + 1;
};
in_ws = true;
};
} else {
in_ws = false;
if out.len < 262144 {
out.bytes[out.len] = b;
out.len = out.len + 1;
};
};
i = i + 1;
}
if out.len == 0 {
buf_append_lit(out, STR_PTR("memory"), STR_LEN("memory"));
};
}

//* Judge whether a fact should enter long-term memory (skip/workspace/global). Never throws on input; throws SaVmInputError on empty fact. 
// TS: export async function nativeJevMemory(...): Promise<JevRunResult>
// DEFECT: async
fn nativeJevMemory(state: &JevModuleState, rawInput: &JevRunInput, policy: &JevPolicyConfig, cwd_ptr: ptr, cwd_len: u64, startedAt: u64, out: &JevRunResult) -> i32 {
// const rawFact = (cast).fact?? (cast).content?? (cast).text?? rawInput.question?? (cast).prompt?? "";
let f_raw = ByteBuf { bytes: [0u8; 262144], len: 0};
let has_f = input_dyn_str(rawInput, STR_PTR("fact"), STR_LEN("fact"), &f_raw);
if!has_f { has_f = input_dyn_str(rawInput, STR_PTR("content"), STR_LEN("content"), &f_raw);};
if!has_f { has_f = input_dyn_str(rawInput, STR_PTR("text"), STR_LEN("text"), &f_raw);};
if!has_f { has_f = input_str_field(rawInput, 0, &f_raw);};
if!has_f { has_f = input_dyn_str(rawInput, STR_PTR("prompt"), STR_LEN("prompt"), &f_raw);};
let fact = ByteBuf { bytes: [0u8; 262144], len: 0};
str_trim_into(&fact, buf_ptr(&f_raw), f_raw.len);
if fact.len == 0 {
return jev_input_error(out, STR_PTR("action 'jev_memory' requires a non-empty 'fact' parameter (use 'question' through the bridge)"), STR_LEN("action 'jev_memory' requires a non-empty 'fact' parameter (use 'question' through the bridge)"));
};
// const context = truncateJevContext((cast).context);
// NOTE: only the dynamic context key feeds this one (no content/state chain).
let m_ctx_kind: u64 = 0;
let m_ctx_raw = ByteBuf { bytes: [0u8; 262144], len: 0};
input_dyn_json(rawInput, STR_PTR("context"), STR_LEN("context"), &m_ctx_raw, &m_ctx_kind);
if m_ctx_kind == 1 {
let s = ByteBuf { bytes: [0u8; 262144], len: 0};
input_dyn_str(rawInput, STR_PTR("context"), STR_LEN("context"), &s);
buf_copy_into(&m_ctx_raw, &s);
};
let context = ByteBuf { bytes: [0u8; 262144], len: 0};
truncateJevContext(buf_ptr(&m_ctx_raw), m_ctx_raw.len, m_ctx_kind, &context);
let creds = JevCredentials { baseUrl: JevStr { bytes: [0u8; 8192], len: 0}, apiKey: JevStr { bytes: [0u8; 8192], len: 0}, model: JevStr { bytes: [0u8; 8192], len: 0}, providerId: JevStr { bytes: [0u8; 8192], len: 0}, groupId: JevStr { bytes: [0u8; 8192], len: 0}, bridgeProtocol: JevStr { bytes: [0u8; 8192], len: 0}, timeoutMs: 0};
resolveJevCredentials(state, rawInput, &creds);
let scopes = StringMap { key_off: [0u64; 64], key_len: [0u64; 64], val_off: [0u64; 64], val_len: [0u64; 64], keys_bytes: [0u8; 8192], keys_len: 0, vals_bytes: [0u8; 65536], vals_len: 0, len: 0};
JEV_MEMORY_SCOPES(&scopes);
let scopes_json = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_map_json(&scopes_json, &scopes);
// fact.slice(0, 2000) in state; fact.slice(0, 300) in instructions.
let fact2000 = ByteBuf { bytes: [0u8; 262144], len: 0};
let f2n = fact.len;
if f2n > 2000 { f2n = 2000;};
buf_append(&fact2000, buf_ptr(&fact), f2n);
let fact300 = ByteBuf { bytes: [0u8; 262144], len: 0};
let f3n = fact.len;
if f3n > 300 { f3n = 300;};
buf_append(&fact300, buf_ptr(&fact), f3n);
let instr = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&instr, STR_PTR("Should this fact enter long-term memory? Fact: "), STR_LEN("Should this fact enter long-term memory? Fact: "));
buf_append_buf(&instr, &fact300);
let questions = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&questions, STR_PTR("{"), STR_LEN("{"));
buf_append_question(&questions, STR_PTR("memory_scope"), STR_LEN("memory_scope"), STR_PTR("choice"), STR_LEN("choice"), &instr, buf_ptr(&scopes_json), scopes_json.len);
buf_append_lit(&questions, STR_PTR("}"), STR_LEN("}"));
let state_text = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&state_text, STR_PTR("[Fact]\n"), STR_LEN("[Fact]\n"));
buf_append_buf(&state_text, &fact2000);
buf_append_lit(&state_text, STR_PTR("\n\n[Context]\n"), STR_LEN("\n\n[Context]\n"));
buf_append_buf(&state_text, &context);
let payload = JevPayload { state: ByteBuf { bytes: [0u8; 262144], len: 0}, model: JevStr { bytes: [0u8; 8192], len: 0}, questions: ByteBuf { bytes: [0u8; 262144], len: 0}};
jev_make_payload(&state_text, &creds, &questions, &payload);
let call = JevCallResult { ok: false, data_doc: 0, data_bytes: [0u8; 262144], data_len: 0, latencyMs: 0, has_status: false, status: 0, error_bytes: [0u8; 16384], error_len: 0};
let rc = executeJevCall(state, &payload, &creds, &call);
if rc == 2 { return jev_overload_error(state, out);};
// Local fallback when JEV upstream is unavailable: cheap durability heuristic
// so SessionEnd auto-triage still works offline (skip ephemeral, workspace by default).
if!call.ok {
// const t = fact.slice(0, 600);
let t = ByteBuf { bytes: [0u8; 262144], len: 0};
let tn = fact.len;
if tn > 600 { tn = 600;};
buf_append(&t, buf_ptr(&fact), tn);
// const ephemeral = /^(ok|done|好的|收到|执行完毕|temp|tmp|log|日志片段)/i.test(t) || t.length < 16;
// DEFECT: regex — prefix alternation checked by hand,
// case-insensitively for the ASCII alternatives.
let ephemeral = t.len < 16
|| str_starts_with_ci(buf_ptr(&t), t.len, STR_PTR("ok"), STR_LEN("ok"))
|| str_starts_with_ci(buf_ptr(&t), t.len, STR_PTR("done"), STR_LEN("done"))
|| str_starts_with_ci(buf_ptr(&t), t.len, STR_PTR("好的"), STR_LEN("好的"))
|| str_starts_with_ci(buf_ptr(&t), t.len, STR_PTR("收到"), STR_LEN("收到"))
|| str_starts_with_ci(buf_ptr(&t), t.len, STR_PTR("执行完毕"), STR_LEN("执行完毕"))
|| str_starts_with_ci(buf_ptr(&t), t.len, STR_PTR("temp"), STR_LEN("temp"))
|| str_starts_with_ci(buf_ptr(&t), t.len, STR_PTR("tmp"), STR_LEN("tmp"))
|| str_starts_with_ci(buf_ptr(&t), t.len, STR_PTR("log"), STR_LEN("log"))
|| str_starts_with_ci(buf_ptr(&t), t.len, STR_PTR("日志片段"), STR_LEN("日志片段"));
// const globalHint = /偏好|记住|always |never |别再|下次|以后|password|port|端口|token|key:|env|环境|全局|global|convention|user prefers/i.test(t);
// DEFECT: regex — alternation becomes substring scans.
let globalHint = str_contains_ci(buf_ptr(&t), t.len, STR_PTR("偏好"), STR_LEN("偏好"))
|| str_contains_ci(buf_ptr(&t), t.len, STR_PTR("记住"), STR_LEN("记住"))
|| str_contains_ci(buf_ptr(&t), t.len, STR_PTR("always "), STR_LEN("always "))
|| str_contains_ci(buf_ptr(&t), t.len, STR_PTR("never "), STR_LEN("never "))
|| str_contains_ci(buf_ptr(&t), t.len, STR_PTR("别再"), STR_LEN("别再"))
|| str_contains_ci(buf_ptr(&t), t.len, STR_PTR("下次"), STR_LEN("下次"))
|| str_contains_ci(buf_ptr(&t), t.len, STR_PTR("以后"), STR_LEN("以后"))
|| str_contains_ci(buf_ptr(&t), t.len, STR_PTR("password"), STR_LEN("password"))
|| str_contains_ci(buf_ptr(&t), t.len, STR_PTR("port"), STR_LEN("port"))
|| str_contains_ci(buf_ptr(&t), t.len, STR_PTR("端口"), STR_LEN("端口"))
|| str_contains_ci(buf_ptr(&t), t.len, STR_PTR("token"), STR_LEN("token"))
|| str_contains_ci(buf_ptr(&t), t.len, STR_PTR("key:"), STR_LEN("key:"))
|| str_contains_ci(buf_ptr(&t), t.len, STR_PTR("env"), STR_LEN("env"))
|| str_contains_ci(buf_ptr(&t), t.len, STR_PTR("环境"), STR_LEN("环境"))
|| str_contains_ci(buf_ptr(&t), t.len, STR_PTR("全局"), STR_LEN("全局"))
|| str_contains_ci(buf_ptr(&t), t.len, STR_PTR("global"), STR_LEN("global"))
|| str_contains_ci(buf_ptr(&t), t.len, STR_PTR("convention"), STR_LEN("convention"))
|| str_contains_ci(buf_ptr(&t), t.len, STR_PTR("user prefers"), STR_LEN("user prefers"));
let scope = ByteBuf { bytes: [0u8; 262144], len: 0};
if ephemeral {
buf_append_lit(&scope, STR_PTR("skip"), STR_LEN("skip"));
} else {
if globalHint {
buf_append_lit(&scope, STR_PTR("global"), STR_LEN("global"));
} else {
buf_append_lit(&scope, STR_PTR("workspace"), STR_LEN("workspace"));
};
};
let key = ByteBuf { bytes: [0u8; 262144], len: 0};
jev_memory_key(&fact, &key);
let err = ByteBuf { bytes: [0u8; 262144], len: 0};
call_error_into(&call, &err);
let fact1000 = ByteBuf { bytes: [0u8; 262144], len: 0};
let f1n = fact.len;
if f1n > 1000 { f1n = 1000;};
buf_append(&fact1000, buf_ptr(&fact), f1n);
let stdout = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&stdout, STR_PTR("{\"action\":\"jev_memory\",\"scope\":"), STR_LEN("{\"action\":\"jev_memory\",\"scope\":"));
buf_append_json_str(&stdout, buf_ptr(&scope), scope.len);
buf_append_lit(&stdout, STR_PTR(",\"confidence\":0.5,\"fallback\":"), STR_LEN(",\"confidence\":0.5,\"fallback\":"));
buf_append_json_str(&stdout, buf_ptr(&err), err.len);
buf_append_lit(&stdout, STR_PTR(",\"suggested_params\":"), STR_LEN(",\"suggested_params\":"));
let is_skip = jev_str_eq(buf_ptr(&scope), scope.len, STR_PTR("skip"), STR_LEN("skip"));
if is_skip {
buf_append_lit(&stdout, STR_PTR("null"), STR_LEN("null"));
} else {
buf_append_lit(&stdout, STR_PTR("{\"action\":\"add_memory\",\"key\":"), STR_LEN("{\"action\":\"add_memory\",\"key\":"));
buf_append_json_str(&stdout, buf_ptr(&key), key.len);
buf_append_lit(&stdout, STR_PTR(",\"content\":"), STR_LEN(",\"content\":"));
buf_append_json_str(&stdout, buf_ptr(&fact1000), fact1000.len);
buf_append_lit(&stdout, STR_PTR(",\"scope\":"), STR_LEN(",\"scope\":"));
buf_append_json_str(&stdout, buf_ptr(&scope), scope.len);
buf_append_lit(&stdout, STR_PTR("}"), STR_LEN("}"));
};
buf_append_lit(&stdout, STR_PTR(",\"summary\":"), STR_LEN(",\"summary\":"));
let fb_summary = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&fb_summary, STR_PTR("scope="), STR_LEN("scope="));
buf_append_buf(&fb_summary, &scope);
buf_append_lit(&fb_summary, STR_PTR("（上游不可用："), STR_LEN("（上游不可用："));
buf_append_buf(&fb_summary, &err);
buf_append_lit(&fb_summary, STR_PTR("）"), STR_LEN("）"));
buf_append_json_str(&stdout, buf_ptr(&fb_summary), fb_summary.len);
buf_append_lit(&stdout, STR_PTR("}"), STR_LEN("}"));
jev_fill_success(out, &stdout, startedAt);
return 0;
};
let scope_raw = ByteBuf { bytes: [0u8; 262144], len: 0};
jev_answer_choice(call.data_doc, STR_PTR("memory_scope"), STR_LEN("memory_scope"), &scope_raw);
let scope_lower = ByteBuf { bytes: [0u8; 262144], len: 0};
str_lower_into(&scope_lower, buf_ptr(&scope_raw), scope_raw.len);
// const scope = JEV_MEMORY_SCOPES[rawScope]!== undefined? rawScope: "workspace";
let scope = ByteBuf { bytes: [0u8; 262144], len: 0};
if stringmap_has(&scopes, buf_ptr(&scope_lower), scope_lower.len) {
buf_copy_into(&scope, &scope_lower);
} else {
buf_append_lit(&scope, STR_PTR("workspace"), STR_LEN("workspace"));
};
let confidence = jev_answer_confidence(call.data_doc, STR_PTR("memory_scope"), STR_LEN("memory_scope"));
let key = ByteBuf { bytes: [0u8; 262144], len: 0};
jev_memory_key(&fact, &key);
let scopeDesc = ByteBuf { bytes: [0u8; 262144], len: 0};
stringmap_get(&scopes, buf_ptr(&scope), scope.len, &scopeDesc);
let is_skip2 = jev_str_eq(buf_ptr(&scope), scope.len, STR_PTR("skip"), STR_LEN("skip"));
let summary = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&summary, STR_PTR("\n• 范围：["), STR_LEN("\n• 范围：["));
buf_append_buf(&summary, &scope);
buf_append_lit(&summary, STR_PTR("] "), STR_LEN("] "));
buf_append_buf(&summary, &scopeDesc);
buf_append_lit(&summary, STR_PTR("（置信度 "), STR_LEN("（置信度 "));
buf_append_u64(&summary, jev_percent(confidence));
buf_append_lit(&summary, STR_PTR("%）\n• 建议："), STR_LEN("%）\n• 建议："));
if is_skip2 {
buf_append_lit(&summary, STR_PTR("跳过，不写记忆"), STR_LEN("跳过，不写记忆"));
} else {
buf_append_lit(&summary, STR_PTR("add_memory key='"), STR_LEN("add_memory key='"));
buf_append_buf(&summary, &key);
buf_append_lit(&summary, STR_PTR("' scope='"), STR_LEN("' scope='"));
buf_append_buf(&summary, &scope);
buf_append_lit(&summary, STR_PTR("'"), STR_LEN("'"));
};
buf_append_lit(&summary, STR_PTR("\n• 耗时："), STR_LEN("\n• 耗时："));
buf_append_u64(&summary, call.latencyMs);
buf_append_lit(&summary, STR_PTR("ms · 模型："), STR_LEN("ms · 模型："));
buf_append(&summary, js_ptr(&creds.model), creds.model.len);
let fact1000 = ByteBuf { bytes: [0u8; 262144], len: 0};
let f1n = fact.len;
if f1n > 1000 { f1n = 1000;};
buf_append(&fact1000, buf_ptr(&fact), f1n);
let stdout = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&stdout, STR_PTR("{\"action\":\"jev_memory\",\"scope\":"), STR_LEN("{\"action\":\"jev_memory\",\"scope\":"));
buf_append_json_str(&stdout, buf_ptr(&scope), scope.len);
buf_append_lit(&stdout, STR_PTR(",\"confidence\":"), STR_LEN(",\"confidence\":"));
buf_append_f64(&stdout, confidence);
buf_append_lit(&stdout, STR_PTR(",\"suggested_params\":"), STR_LEN(",\"suggested_params\":"));
if is_skip2 {
buf_append_lit(&stdout, STR_PTR("null"), STR_LEN("null"));
} else {
buf_append_lit(&stdout, STR_PTR("{\"action\":\"add_memory\",\"key\":"), STR_LEN("{\"action\":\"add_memory\",\"key\":"));
buf_append_json_str(&stdout, buf_ptr(&key), key.len);
buf_append_lit(&stdout, STR_PTR(",\"content\":"), STR_LEN(",\"content\":"));
buf_append_json_str(&stdout, buf_ptr(&fact1000), fact1000.len);
buf_append_lit(&stdout, STR_PTR(",\"scope\":"), STR_LEN(",\"scope\":"));
buf_append_json_str(&stdout, buf_ptr(&scope), scope.len);
buf_append_lit(&stdout, STR_PTR("}"), STR_LEN("}"));
};
buf_append_lit(&stdout, STR_PTR(",\"summary\":"), STR_LEN(",\"summary\":"));
buf_append_json_str(&stdout, buf_ptr(&summary), summary.len);
buf_append_lit(&stdout, STR_PTR(",\"latencyMs\":"), STR_LEN(",\"latencyMs\":"));
buf_append_u64(&stdout, call.latencyMs);
buf_append_lit(&stdout, STR_PTR(",\"raw\":"), STR_LEN(",\"raw\":"));
buf_append(&stdout, call_data_ptr(&call), call.data_len);
buf_append_lit(&stdout, STR_PTR("}"), STR_LEN("}"));
jev_fill_success(out, &stdout, startedAt);
return 0;
}

// Case-insensitive prefix test (scaffolding for the jev_memory
// fallback regexes).
fn str_starts_with_ci(hay_ptr: ptr, hay_len: u64, nd_ptr: ptr, nd_len: u64) -> bool {
if hay_len < nd_len { return false;};
let j: u64 = 0;
while j < nd_len {
let a: u8 = 0;
let b: u8 = 0;
PTR_BYTE_AT(a, hay_ptr, j);
PTR_BYTE_AT(b, nd_ptr, j);
if a >= 65 && a <= 90 { a = a + 32;};
if b >= 65 && b <= 90 { b = b + 32;};
if a!= b { return false;};
j = j + 1;
}
return true;
}

//* Efficiency tiers for `jev_which` 
// export const JEV_WHICH_EFFICIENCY_TIERS: Record<string, string> = {...};
fn JEV_WHICH_EFFICIENCY_TIERS(out: &StringMap) -> void {
stringmap_init(out);
stringmap_set_lit(out, STR_PTR("maximum_efficiency"), STR_LEN("maximum_efficiency"), STR_PTR("极致能效：单步 AST/结构化直达，节省 90%+ Token，零副作用"), STR_LEN("极致能效：单步 AST/结构化直达，节省 90%+ Token，零副作用"));
stringmap_set_lit(out, STR_PTR("high_efficiency"), STR_LEN("high_efficiency"), STR_PTR("高能效：定向切片或批量并发，杜绝低效循环与大文件漫灌"), STR_LEN("高能效：定向切片或批量并发，杜绝低效循环与大文件漫灌"));
stringmap_set_lit(out, STR_PTR("moderate_efficiency"), STR_LEN("moderate_efficiency"), STR_PTR("常规能效：可用但需警惕上下文开销与边界"), STR_LEN("常规能效：可用但需警惕上下文开销与边界"));
stringmap_set_lit(out, STR_PTR("anti_pattern_avoided"), STR_LEN("anti_pattern_avoided"), STR_PTR("低效/危险反模式拦截：原方案存在严重浪费或风险，已重定向至推荐工具"), STR_LEN("低效/危险反模式拦截：原方案存在严重浪费或风险，已重定向至推荐工具"));
}

//* Built-in engineering tool catalog for tool arbitration 
// export const JEV_DEFAULT_ENGINEERING_TOOLS: Record<string, string> = {...};
fn JEV_DEFAULT_ENGINEERING_TOOLS(out: &StringMap) -> void {
stringmap_init(out);
stringmap_set_lit(out, STR_PTR("find_definition"), STR_LEN("find_definition"), STR_PTR("查函数/类/符号定义与源头实现预览（AST 单步直达，防大文件全文 read_file）"), STR_LEN("查函数/类/符号定义与源头实现预览（AST 单步直达，防大文件全文 read_file）"));
stringmap_set_lit(out, STR_PTR("find_references"), STR_LEN("find_references"), STR_PTR("查函数/符号调用方与所有被引用处（精确词法索引，防泛搜 grep）"), STR_LEN("查函数/符号调用方与所有被引用处（精确词法索引，防泛搜 grep）"));
stringmap_set_lit(out, STR_PTR("file_outline"), STR_LEN("file_outline"), STR_PTR("提取单文件结构、函数签名与行号大纲（防盲读超大源码）"), STR_LEN("提取单文件结构、函数签名与行号大纲（防盲读超大源码）"));
stringmap_set_lit(out, STR_PTR("workspace_outline"), STR_LEN("workspace_outline"), STR_PTR("提取目录/工程级符号大纲与 repo_map 架构总览"), STR_LEN("提取目录/工程级符号大纲与 repo_map 架构总览"));
stringmap_set_lit(out, STR_PTR("read_lines"), STR_LEN("read_lines"), STR_PTR("定向阅读已知行号区间代码（文件 > 500 行严禁全量 read_file）"), STR_LEN("定向阅读已知行号区间代码（文件 > 500 行严禁全量 read_file）"));
stringmap_set_lit(out, STR_PTR("read_file_tail"), STR_LEN("read_file_tail"), STR_PTR("末尾流式直读排查日志与崩溃异常栈（严禁全量读大日志）"), STR_LEN("末尾流式直读排查日志与崩溃异常栈（严禁全量读大日志）"));
stringmap_set_lit(out, STR_PTR("edit_file"), STR_LEN("edit_file"), STR_PTR("单处代码精准局部原子替换（带安全备份，防全量覆写）"), STR_LEN("单处代码精准局部原子替换（带安全备份，防全量覆写）"));
stringmap_set_lit(out, STR_PTR("apply_patch"), STR_LEN("apply_patch"), STR_PTR("跨文件批量修改与复杂重构（标准 Unified Diff，带回滚检验）"), STR_LEN("跨文件批量修改与复杂重构（标准 Unified Diff，带回滚检验）"));
stringmap_set_lit(out, STR_PTR("code_graph"), STR_LEN("code_graph"), STR_PTR("宏观类继承拓扑与模块调用链（仅用于宏观依赖梳理，严禁微观编码替代）"), STR_LEN("宏观类继承拓扑与模块调用链（仅用于宏观依赖梳理，严禁微观编码替代）"));
stringmap_set_lit(out, STR_PTR("grep_search_async"), STR_LEN("grep_search_async"), STR_PTR("高并发多关键词搜索与大范围模式定位"), STR_LEN("高并发多关键词搜索与大范围模式定位"));
stringmap_set_lit(out, STR_PTR("run_js"), STR_LEN("run_js"), STR_PTR("跨文件批量复杂循环与数据处理（受限 TS 脚本，单次替代 3 次以上单步）"), STR_LEN("跨文件批量复杂循环与数据处理（受限 TS 脚本，单次替代 3 次以上单步）"));
}

// TS: function generateToolUsageRecommendation(
// bestTool: string, target?: string, _intent?: string
//): { suggested_params: Record<string, unknown>; anti_pattern: string}
// The TS switch becomes an if-chain on the tool name;
// suggested_params is built as JSON text in out_params (the TS
// Record return), anti_pattern in out_anti.
// DEFECT: dynamic object — suggested_params Record kept as JSON text.
fn generateToolUsageRecommendation(bestTool_ptr: ptr, bestTool_len: u64, target_ptr: ptr, target_len: u64, out_params: &ByteBuf, out_anti: &ByteBuf) -> void {
buf_reset(out_params);
buf_reset(out_anti);
let has_target = target_len > 0;
if jev_str_eq(bestTool_ptr, bestTool_len, STR_PTR("find_definition"), STR_LEN("find_definition")) {
buf_append_lit(out_params, STR_PTR("{\"action\":\"find_definition\",\"symbol\":"), STR_LEN("{\"action\":\"find_definition\",\"symbol\":"));
if has_target {
buf_append_json_str(out_params, target_ptr, target_len);
} else {
buf_append_json_str(out_params, STR_PTR("TargetSymbol"), STR_LEN("TargetSymbol"));
};
buf_append_lit(out_params, STR_PTR(",\"include_body\":true}"), STR_LEN(",\"include_body\":true}"));
buf_append_lit(out_anti, STR_PTR("严禁针对符号盲目 grep_search 广域泛搜，严禁大文件全量 read_file 读取数千行！"), STR_LEN("严禁针对符号盲目 grep_search 广域泛搜，严禁大文件全量 read_file 读取数千行！"));
return;
};
if jev_str_eq(bestTool_ptr, bestTool_len, STR_PTR("find_references"), STR_LEN("find_references")) {
buf_append_lit(out_params, STR_PTR("{\"action\":\"find_references\",\"symbol\":"), STR_LEN("{\"action\":\"find_references\",\"symbol\":"));
if has_target {
buf_append_json_str(out_params, target_ptr, target_len);
} else {
buf_append_json_str(out_params, STR_PTR("TargetSymbol"), STR_LEN("TargetSymbol"));
};
buf_append_lit(out_params, STR_PTR(",\"detail\":false}"), STR_LEN(",\"detail\":false}"));
buf_append_lit(out_anti, STR_PTR("严禁循环 grep_search 或手写脚本逐个读文件正则拼凑调用方！"), STR_LEN("严禁循环 grep_search 或手写脚本逐个读文件正则拼凑调用方！"));
return;
};
if jev_str_eq(bestTool_ptr, bestTool_len, STR_PTR("file_outline"), STR_LEN("file_outline")) {
buf_append_lit(out_params, STR_PTR("{\"action\":\"file_outline\",\"path\":"), STR_LEN("{\"action\":\"file_outline\",\"path\":"));
if has_target {
buf_append_json_str(out_params, target_ptr, target_len);
} else {
buf_append_json_str(out_params, STR_PTR("path/to/file.ts"), STR_LEN("path/to/file.ts"));
};
buf_append_lit(out_params, STR_PTR("}"), STR_LEN("}"));
buf_append_lit(out_anti, STR_PTR("仅为查看文件结构大纲时，严禁盲目调用 read_file 吞入上千行源码！"), STR_LEN("仅为查看文件结构大纲时，严禁盲目调用 read_file 吞入上千行源码！"));
return;
};
if jev_str_eq(bestTool_ptr, bestTool_len, STR_PTR("workspace_outline"), STR_LEN("workspace_outline")) {
buf_append_lit(out_params, STR_PTR("{\"action\":\"workspace_outline\",\"dir\":"), STR_LEN("{\"action\":\"workspace_outline\",\"dir\":"));
if has_target {
buf_append_json_str(out_params, target_ptr, target_len);
} else {
buf_append_json_str(out_params, STR_PTR("."), STR_LEN("."));
};
buf_append_lit(out_params, STR_PTR("}"), STR_LEN("}"));
buf_append_lit(out_anti, STR_PTR("严禁在终端运行递归列目录脚本或递归读取全仓文件！"), STR_LEN("严禁在终端运行递归列目录脚本或递归读取全仓文件！"));
return;
};
if jev_str_eq(bestTool_ptr, bestTool_len, STR_PTR("read_lines"), STR_LEN("read_lines")) {
buf_append_lit(out_params, STR_PTR("{\"action\":\"read_lines\",\"path\":"), STR_LEN("{\"action\":\"read_lines\",\"path\":"));
if has_target {
buf_append_json_str(out_params, target_ptr, target_len);
} else {
buf_append_json_str(out_params, STR_PTR("path/to/file.ts"), STR_LEN("path/to/file.ts"));
};
buf_append_lit(out_params, STR_PTR(",\"start_line\":1,\"end_line\":100}"), STR_LEN(",\"start_line\":1,\"end_line\":100}"));
buf_append_lit(out_anti, STR_PTR("文件超过 500 行时，严禁使用 read_file 全量读取，必须使用 read_lines 定向切片！"), STR_LEN("文件超过 500 行时，严禁使用 read_file 全量读取，必须使用 read_lines 定向切片！"));
return;
};
if jev_str_eq(bestTool_ptr, bestTool_len, STR_PTR("read_file_tail"), STR_LEN("read_file_tail")) {
buf_append_lit(out_params, STR_PTR("{\"action\":\"read_file_tail\",\"path\":"), STR_LEN("{\"action\":\"read_file_tail\",\"path\":"));
if has_target {
buf_append_json_str(out_params, target_ptr, target_len);
} else {
buf_append_json_str(out_params, STR_PTR("path/to/log.log"), STR_LEN("path/to/log.log"));
};
buf_append_lit(out_params, STR_PTR(",\"lines\":50}"), STR_LEN(",\"lines\":50}"));
buf_append_lit(out_anti, STR_PTR("排查错误日志时，严禁使用 read_file 或终端 cat 读整个大日志！"), STR_LEN("排查错误日志时，严禁使用 read_file 或终端 cat 读整个大日志！"));
return;
};
if jev_str_eq(bestTool_ptr, bestTool_len, STR_PTR("edit_file"), STR_LEN("edit_file")) {
buf_append_lit(out_params, STR_PTR("{\"action\":\"edit_file\",\"path\":"), STR_LEN("{\"action\":\"edit_file\",\"path\":"));
if has_target {
buf_append_json_str(out_params, target_ptr, target_len);
} else {
buf_append_json_str(out_params, STR_PTR("path/to/file.ts"), STR_LEN("path/to/file.ts"));
};
buf_append_lit(out_params, STR_PTR(",\"old_text\":\"/* exact target */\",\"new_text\":\"/* replacement */\"}"), STR_LEN(",\"old_text\":\"/* exact target */\",\"new_text\":\"/* replacement */\"}"));
buf_append_lit(out_anti, STR_PTR("单处局部修改严禁手写脚本或用 write_file 覆写数千行全文件！"), STR_LEN("单处局部修改严禁手写脚本或用 write_file 覆写数千行全文件！"));
return;
};
if jev_str_eq(bestTool_ptr, bestTool_len, STR_PTR("apply_patch"), STR_LEN("apply_patch")) {
buf_append_lit(out_params, STR_PTR("{\"action\":\"apply_patch\",\"patch\":"), STR_LEN("{\"action\":\"apply_patch\",\"patch\":"));
buf_append_json_str(out_params, STR_PTR("*** Begin Patch\n*** Update File: path/to/file.ts\n..."), STR_LEN("*** Begin Patch\n*** Update File: path/to/file.ts\n..."));
buf_append_lit(out_params, STR_PTR("}"), STR_LEN("}"));
buf_append_lit(out_anti, STR_PTR("跨文件或多处联动修改，严禁连续调用多次碎片化 edit_file！"), STR_LEN("跨文件或多处联动修改，严禁连续调用多次碎片化 edit_file！"));
return;
};
if jev_str_eq(bestTool_ptr, bestTool_len, STR_PTR("code_graph"), STR_LEN("code_graph")) {
buf_append_lit(out_params, STR_PTR("{\"action\":\"code_graph\",\"target\":"), STR_LEN("{\"action\":\"code_graph\",\"target\":"));
if has_target {
buf_append_json_str(out_params, target_ptr, target_len);
} else {
buf_append_json_str(out_params, STR_PTR("ClassName"), STR_LEN("ClassName"));
};
buf_append_lit(out_params, STR_PTR(",\"mode\":\"symbol_hierarchy\",\"depth\":2,\"format\":\"dot\"}"), STR_LEN(",\"mode\":\"symbol_hierarchy\",\"depth\":2,\"format\":\"dot\"}"));
buf_append_lit(out_anti, STR_PTR("严禁将 code_graph 用于微观写代码场景；拿到拓扑后切忌无脑遍历，应结合 find_definition！"), STR_LEN("严禁将 code_graph 用于微观写代码场景；拿到拓扑后切忌无脑遍历，应结合 find_definition！"));
return;
};
if jev_str_eq(bestTool_ptr, bestTool_len, STR_PTR("grep_search_async"), STR_LEN("grep_search_async")) {
buf_append_lit(out_params, STR_PTR("{\"action\":\"grep_search_async\",\"queries\":["), STR_LEN("{\"action\":\"grep_search_async\",\"queries\":["));
if has_target {
buf_append_json_str(out_params, target_ptr, target_len);
} else {
buf_append_json_str(out_params, STR_PTR("pattern1"), STR_LEN("pattern1"));
buf_append_lit(out_params, STR_PTR(","), STR_LEN(","));
buf_append_json_str(out_params, STR_PTR("pattern2"), STR_LEN("pattern2"));
};
buf_append_lit(out_params, STR_PTR("]}"), STR_LEN("]}"));
buf_append_lit(out_anti, STR_PTR("多个关键词搜索时，严禁串行循环单个 grep_search！"), STR_LEN("多个关键词搜索时，严禁串行循环单个 grep_search！"));
return;
};
if jev_str_eq(bestTool_ptr, bestTool_len, STR_PTR("run_js"), STR_LEN("run_js")) {
buf_append_lit(out_params, STR_PTR("{\"action\":\"run_js\",\"content\":"), STR_LEN("{\"action\":\"run_js\",\"content\":"));
buf_append_json_str(out_params, STR_PTR("export async function main(): Promise<number> {\n // computation logic\n return 0;\n}"), STR_LEN("export async function main(): Promise<number> {\n // computation logic\n return 0;\n}"));
buf_append_lit(out_params, STR_PTR("}"), STR_LEN("}"));
buf_append_lit(out_anti, STR_PTR("单文件单步操作绝不手写 TS，大文本字面量与多文件搬运严禁内联写入 TS source！"), STR_LEN("单文件单步操作绝不手写 TS，大文本字面量与多文件搬运严禁内联写入 TS source！"));
return;
};
// default:
// suggested_params: { action: bestTool,...(target? { target}: {})},
// anti_pattern: `请遵从 ${bestTool} 的边界与能效准则，避免低效重复调用。`,
buf_append_lit(out_params, STR_PTR("{\"action\":"), STR_LEN("{\"action\":"));
buf_append_json_str(out_params, bestTool_ptr, bestTool_len);
if has_target {
buf_append_lit(out_params, STR_PTR(",\"target\":"), STR_LEN(",\"target\":"));
buf_append_json_str(out_params, target_ptr, target_len);
};
buf_append_lit(out_params, STR_PTR("}"), STR_LEN("}"));
buf_append_lit(out_anti, STR_PTR("请遵从 "), STR_LEN("请遵从 "));
buf_append(out_anti, bestTool_ptr, bestTool_len);
buf_append_lit(out_anti, STR_PTR(" 的边界与能效准则，避免低效重复调用。"), STR_LEN(" 的边界与能效准则，避免低效重复调用。"));
}

//*
//* Advisory engineering tool efficiency arbitration (工具高能效选型与反模式拦截, purely opt-in).
//* Given an engineering intent and optional candidate tools, JEV arbitrates the
//* highest-efficiency, lowest-context-cost tool (e.g. find_definition vs grep vs read_file),
//* emits concrete parameter templates, and flags anti-patterns.
//
// TS: export async function nativeJevWhich(...): Promise<JevRunResult>
// DEFECT: async
fn nativeJevWhich(state: &JevModuleState, rawInput: &JevRunInput, policy: &JevPolicyConfig, cwd_ptr: ptr, cwd_len: u64, startedAt: u64, out: &JevRunResult) -> i32 {
// const rawIntent = (cast).intent?? (cast).task?? rawInput.question?? rawInput.content;
let i_raw = ByteBuf { bytes: [0u8; 262144], len: 0};
let has_i = input_dyn_str(rawInput, STR_PTR("intent"), STR_LEN("intent"), &i_raw);
if!has_i { has_i = input_dyn_str(rawInput, STR_PTR("task"), STR_LEN("task"), &i_raw);};
if!has_i { has_i = input_str_field(rawInput, 0, &i_raw);};
if!has_i { has_i = input_str_field(rawInput, 2, &i_raw);};
let intent = ByteBuf { bytes: [0u8; 262144], len: 0};
str_trim_into(&intent, buf_ptr(&i_raw), i_raw.len);
if intent.len == 0 {
return jev_input_error(out, STR_PTR("action 'jev_which' requires a non-empty 'intent' or 'question' parameter (engineering task or purpose)"), STR_LEN("action 'jev_which' requires a non-empty 'intent' or 'question' parameter (engineering task or purpose)"));
};
// const target = ((cast).target?? "").toString().trim();
let tg_raw = ByteBuf { bytes: [0u8; 262144], len: 0};
input_dyn_str(rawInput, STR_PTR("target"), STR_LEN("target"), &tg_raw);
let target = ByteBuf { bytes: [0u8; 262144], len: 0};
str_trim_into(&target, buf_ptr(&tg_raw), tg_raw.len);
// const rawOptions = (cast).candidates?? (cast).tools?? rawInput.options;
let raw_opts = ByteBuf { bytes: [0u8; 262144], len: 0};
let raw_kind: u64 = 0;
let has_raw_opts = input_dyn_json(rawInput, STR_PTR("candidates"), STR_LEN("candidates"), &raw_opts, &raw_kind);
if!has_raw_opts { has_raw_opts = input_dyn_json(rawInput, STR_PTR("tools"), STR_LEN("tools"), &raw_opts, &raw_kind);};
if!has_raw_opts { has_raw_opts = input_json_field(rawInput, 4, &raw_opts, &raw_kind);};
let hasCandidates = false;
if has_raw_opts && raw_kind!= 0 {
if raw_kind == 1 {
let t = ByteBuf { bytes: [0u8; 262144], len: 0};
str_trim_into(&t, buf_ptr(&raw_opts), raw_opts.len);
hasCandidates = t.len > 0;
} else {
hasCandidates = true;
};
};
let candidates = StringMap { key_off: [0u64; 64], key_len: [0u64; 64], val_off: [0u64; 64], val_len: [0u64; 64], keys_bytes: [0u8; 8192], keys_len: 0, vals_bytes: [0u8; 65536], vals_len: 0, len: 0};
if hasCandidates {
normalizeChoiceOptions(buf_ptr(&raw_opts), raw_opts.len, raw_kind, &candidates);
if candidates.len < 2 {
return jev_input_error(out, STR_PTR("action 'jev_which' requires at least 2 candidate tools in 'candidates' or 'options' (or omit to let JEV select from the full engineering catalog)"), STR_LEN("action 'jev_which' requires at least 2 candidate tools in 'candidates' or 'options' (or omit to let JEV select from the full engineering catalog)"));
};
if candidates.len > 8 {
jev_map_truncate(&candidates, 8);
};
} else {
// Default to the built-in engineering tool catalog
JEV_DEFAULT_ENGINEERING_TOOLS(&candidates);
};
let ctx_kind: u64 = 0;
let ctx_raw = ByteBuf { bytes: [0u8; 262144], len: 0};
jev_pick_context(rawInput, &ctx_kind, &ctx_raw);
let context = ByteBuf { bytes: [0u8; 262144], len: 0};
truncateJevContext(buf_ptr(&ctx_raw), ctx_raw.len, ctx_kind, &context);
let creds = JevCredentials { baseUrl: JevStr { bytes: [0u8; 8192], len: 0}, apiKey: JevStr { bytes: [0u8; 8192], len: 0}, model: JevStr { bytes: [0u8; 8192], len: 0}, providerId: JevStr { bytes: [0u8; 8192], len: 0}, groupId: JevStr { bytes: [0u8; 8192], len: 0}, bridgeProtocol: JevStr { bytes: [0u8; 8192], len: 0}, timeoutMs: 0};
resolveJevCredentials(state, rawInput, &creds);
let tiers = StringMap { key_off: [0u64; 64], key_len: [0u64; 64], val_off: [0u64; 64], val_len: [0u64; 64], keys_bytes: [0u8; 8192], keys_len: 0, vals_bytes: [0u8; 65536], vals_len: 0, len: 0};
JEV_WHICH_EFFICIENCY_TIERS(&tiers);
let cand_json = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_map_json(&cand_json, &candidates);
let tiers_json = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_map_json(&tiers_json, &tiers);
let instr_t = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&instr_t, STR_PTR("Given the engineering intent"), STR_LEN("Given the engineering intent"));
if target.len > 0 {
buf_append_lit(&instr_t, STR_PTR(" targeting '"), STR_LEN(" targeting '"));
buf_append_buf(&instr_t, &target);
buf_append_lit(&instr_t, STR_PTR("'"), STR_LEN("'"));
};
buf_append_lit(&instr_t, STR_PTR(", which tool provides the highest token efficiency, lowest context footprint, and fastest execution without anti-patterns? Intent: "), STR_LEN(", which tool provides the highest token efficiency, lowest context footprint, and fastest execution without anti-patterns? Intent: "));
buf_append_buf(&instr_t, &intent);
let instr_e = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&instr_e, STR_PTR("What efficiency tier does this tool selection represent? Intent: "), STR_LEN("What efficiency tier does this tool selection represent? Intent: "));
buf_append_buf(&instr_e, &intent);
let questions = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&questions, STR_PTR("{"), STR_LEN("{"));
buf_append_question(&questions, STR_PTR("best_tool"), STR_LEN("best_tool"), STR_PTR("choice"), STR_LEN("choice"), &instr_t, buf_ptr(&cand_json), cand_json.len);
buf_append_lit(&questions, STR_PTR(","), STR_LEN(","));
buf_append_question(&questions, STR_PTR("efficiency_tier"), STR_LEN("efficiency_tier"), STR_PTR("choice"), STR_LEN("choice"), &instr_e, buf_ptr(&tiers_json), tiers_json.len);
buf_append_lit(&questions, STR_PTR("}"), STR_LEN("}"));
let state_text = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&state_text, STR_PTR("[Engineering Intent]\n"), STR_LEN("[Engineering Intent]\n"));
buf_append_buf(&state_text, &intent);
if target.len > 0 {
buf_append_lit(&state_text, STR_PTR("\n\n[Target]\n"), STR_LEN("\n\n[Target]\n"));
buf_append_buf(&state_text, &target);
};
buf_append_lit(&state_text, STR_PTR("\n\n[Context]\n"), STR_LEN("\n\n[Context]\n"));
buf_append_buf(&state_text, &context);
let payload = JevPayload { state: ByteBuf { bytes: [0u8; 262144], len: 0}, model: JevStr { bytes: [0u8; 8192], len: 0}, questions: ByteBuf { bytes: [0u8; 262144], len: 0}};
jev_make_payload(&state_text, &creds, &questions, &payload);
let call = JevCallResult { ok: false, data_doc: 0, data_bytes: [0u8; 262144], data_len: 0, latencyMs: 0, has_status: false, status: 0, error_bytes: [0u8; 16384], error_len: 0};
let rc = executeJevCall(state, &payload, &creds, &call);
if rc == 2 { return jev_overload_error(state, out);};
if!call.ok {
let err = ByteBuf { bytes: [0u8; 262144], len: 0};
call_error_into(&call, &err);
let stderr = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&stderr, STR_PTR("JEV tool efficiency arbitration failed ("), STR_LEN("JEV tool efficiency arbitration failed ("));
if call.has_status {
buf_append_i64(&stderr, call.status as i64);
} else {
buf_append_lit(&stderr, STR_PTR("502"), STR_LEN("502"));
};
buf_append_lit(&stderr, STR_PTR("): "), STR_LEN("): "));
buf_append_buf(&stderr, &err);
jev_fill_failure(out, call.has_status, call.status, buf_ptr(&err), err.len, &stderr, true, startedAt);
return 0;
};
// const bestTool = candidates[rawTool]!== undefined? rawTool: Object.keys(candidates)[0]?? "";
let rawTool = ByteBuf { bytes: [0u8; 262144], len: 0};
jev_answer_choice(call.data_doc, STR_PTR("best_tool"), STR_LEN("best_tool"), &rawTool);
let bestTool = ByteBuf { bytes: [0u8; 262144], len: 0};
if stringmap_has(&candidates, buf_ptr(&rawTool), rawTool.len) {
buf_copy_into(&bestTool, &rawTool);
} else {
if candidates.len > 0 {
stringmap_key_at(&candidates, 0, &bestTool);
};
};
let toolConfidence = jev_answer_confidence(call.data_doc, STR_PTR("best_tool"), STR_LEN("best_tool"));
let tier_raw = ByteBuf { bytes: [0u8; 262144], len: 0};
jev_answer_choice(call.data_doc, STR_PTR("efficiency_tier"), STR_LEN("efficiency_tier"), &tier_raw);
let tier_lower = ByteBuf { bytes: [0u8; 262144], len: 0};
str_lower_into(&tier_lower, buf_ptr(&tier_raw), tier_raw.len);
// const efficiencyTier = JEV_WHICH_EFFICIENCY_TIERS[rawTier]!== undefined? rawTier: "high_efficiency";
let efficiencyTier = ByteBuf { bytes: [0u8; 262144], len: 0};
if stringmap_has(&tiers, buf_ptr(&tier_lower), tier_lower.len) {
buf_copy_into(&efficiencyTier, &tier_lower);
} else {
buf_append_lit(&efficiencyTier, STR_PTR("high_efficiency"), STR_LEN("high_efficiency"));
};
// Generate suggested call pattern & anti-pattern warnings based on bestTool
let rec_params = ByteBuf { bytes: [0u8; 262144], len: 0};
let rec_anti = ByteBuf { bytes: [0u8; 262144], len: 0};
generateToolUsageRecommendation(buf_ptr(&bestTool), bestTool.len, buf_ptr(&target), target.len, &rec_params, &rec_anti);
let toolDesc = ByteBuf { bytes: [0u8; 262144], len: 0};
let has_tool_desc = stringmap_get(&candidates, buf_ptr(&bestTool), bestTool.len, &toolDesc);
let tierDesc = ByteBuf { bytes: [0u8; 262144], len: 0};
stringmap_get(&tiers, buf_ptr(&efficiencyTier), efficiencyTier.len, &tierDesc);
let summary = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&summary, STR_PTR("\n• 推荐首选工具：["), STR_LEN("\n• 推荐首选工具：["));
buf_append_buf(&summary, &bestTool);
buf_append_lit(&summary, STR_PTR("] "), STR_LEN("] "));
if has_tool_desc && toolDesc.len > 0 {
buf_append_buf(&summary, &toolDesc);
} else {
buf_append_buf(&summary, &bestTool);
};
buf_append_lit(&summary, STR_PTR("（置信度 "), STR_LEN("（置信度 "));
buf_append_u64(&summary, jev_percent(toolConfidence));
buf_append_lit(&summary, STR_PTR("%）\n• 能效等级：["), STR_LEN("%）\n• 能效等级：["));
buf_append_buf(&summary, &efficiencyTier);
buf_append_lit(&summary, STR_PTR("] "), STR_LEN("] "));
buf_append_buf(&summary, &tierDesc);
buf_append_lit(&summary, STR_PTR("\n• 推荐调用范式：sa_vm_run("), STR_LEN("\n• 推荐调用范式：sa_vm_run("));
buf_append_buf(&summary, &rec_params);
buf_append_lit(&summary, STR_PTR(")\n• 严禁反模式："), STR_LEN(")\n• 严禁反模式："));
buf_append_buf(&summary, &rec_anti);
buf_append_lit(&summary, STR_PTR("\n• 意图："), STR_LEN("\n• 意图："));
let in_n = intent.len;
if in_n > 160 { in_n = 160;};
buf_append(&summary, buf_ptr(&intent), in_n);
buf_append_lit(&summary, STR_PTR("\n• 耗时："), STR_LEN("\n• 耗时："));
buf_append_u64(&summary, call.latencyMs);
buf_append_lit(&summary, STR_PTR("ms · 模型："), STR_LEN("ms · 模型："));
buf_append(&summary, js_ptr(&creds.model), creds.model.len);
let stdout = ByteBuf { bytes: [0u8; 262144], len: 0};
buf_append_lit(&stdout, STR_PTR("{\"action\":\"jev_which\",\"intent\":"), STR_LEN("{\"action\":\"jev_which\",\"intent\":"));
buf_append_json_str(&stdout, buf_ptr(&intent), intent.len);
buf_append_lit(&stdout, STR_PTR(",\"target\":"), STR_LEN(",\"target\":"));
if target.len > 0 {
buf_append_json_str(&stdout, buf_ptr(&target), target.len);
} else {
buf_append_lit(&stdout, STR_PTR("null"), STR_LEN("null"));
};
buf_append_lit(&stdout, STR_PTR(",\"recommended_action\":"), STR_LEN(",\"recommended_action\":"));
buf_append_json_str(&stdout, buf_ptr(&bestTool), bestTool.len);
buf_append_lit(&stdout, STR_PTR(",\"confidence\":"), STR_LEN(",\"confidence\":"));
buf_append_f64(&stdout, toolConfidence);
buf_append_lit(&stdout, STR_PTR(",\"tool_description\":"), STR_LEN(",\"tool_description\":"));
if has_tool_desc && toolDesc.len > 0 {
buf_append_json_str(&stdout, buf_ptr(&toolDesc), toolDesc.len);
} else {
buf_append_lit(&stdout, STR_PTR("null"), STR_LEN("null"));
};
buf_append_lit(&stdout, STR_PTR(",\"efficiency_tier\":"), STR_LEN(",\"efficiency_tier\":"));
buf_append_json_str(&stdout, buf_ptr(&efficiencyTier), efficiencyTier.len);
buf_append_lit(&stdout, STR_PTR(",\"tier_description\":"), STR_LEN(",\"tier_description\":"));
buf_append_json_str(&stdout, buf_ptr(&tierDesc), tierDesc.len);
buf_append_lit(&stdout, STR_PTR(",\"suggested_params\":"), STR_LEN(",\"suggested_params\":"));
buf_append_buf(&stdout, &rec_params);
buf_append_lit(&stdout, STR_PTR(",\"anti_pattern\":"), STR_LEN(",\"anti_pattern\":"));
buf_append_json_str(&stdout, buf_ptr(&rec_anti), rec_anti.len);
buf_append_lit(&stdout, STR_PTR(",\"summary\":"), STR_LEN(",\"summary\":"));
buf_append_json_str(&stdout, buf_ptr(&summary), summary.len);
buf_append_lit(&stdout, STR_PTR(",\"latencyMs\":"), STR_LEN(",\"latencyMs\":"));
buf_append_u64(&stdout, call.latencyMs);
buf_append_lit(&stdout, STR_PTR(",\"raw\":"), STR_LEN(",\"raw\":"));
buf_append(&stdout, call_data_ptr(&call), call.data_len);
buf_append_lit(&stdout, STR_PTR("}"), STR_LEN("}"));
jev_fill_success(out, &stdout, startedAt);
return 0;
}
