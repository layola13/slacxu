// Helper shared by all nativeJev* functions (source repeats this block inline in each function — kept inline per function below, this note records the pattern):
//   failure return: {ok:false, kind: status==401?"capability_denied":"sa_error", exitCode: status==401?228:1, stdout:"", stderr:<msg>, saVmEvents:[{event:"violation",kind:"jev_error",reason:error}], saVmViolation:{reason:error}, durationMs}
