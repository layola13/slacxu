// L31-34: export function isCloudflareJevUpstream(baseUrl: string): boolean — v.toLowerCase().includes("api.cloudflare.com")
fn isCloudflareJevUpstream(baseUrl_ptr: ptr, baseUrl_len: u64) -> bool {
    // DEFECT: string toLowerCase/includes — approximated by case-sensitive substring scan over (ptr,len); ASCII hostnames only in practice.
    let needle_len: u64 = STR_LEN("api.cloudflare.com");
    if baseUrl_len < needle_len { return false; };
    for i in 0..baseUrl_len {
        let j: u64 = 0;
        let ok = true;
        if i + needle_len > baseUrl_len { break; };
        while j < needle_len {
            let a: u8 = 0;
            let b: u8 = 0;
            PTR_BYTE_AT(a, baseUrl_ptr, i + j);
            PTR_BYTE_AT(b, STR_PTR("api.cloudflare.com"), j);
            if a != b { ok = false; };
            j = j + 1;
            if !ok { break; };
        }
        if ok { return true; };
    }
    return false;
}

