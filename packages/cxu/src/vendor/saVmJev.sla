// DEFECT: dynamic object — SaVmRunResult object literal + JSON.stringify approximated as JsonBuf assembly in out.stdout.
fn jev_fail_result(out: &SaVmRunResult, status: i32, durationMs: u64) -> i32 {
    out.ok = false;
    if status == 401 { out.exitCode = 228; } else { out.exitCode = 1; };
    out.durationMs = durationMs;
    out.has_violation = true;
    return 0;
}
fn jev_ok_result(out: &SaVmRunResult, durationMs: u64) -> i32 { out.ok = true; out.exitCode = 0; out.durationMs = durationMs; out.has_violation = false; return 0; }

