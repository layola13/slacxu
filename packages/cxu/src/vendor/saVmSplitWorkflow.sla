// Converted 1:1 from packages/cxu/src/vendor/saVmSplitWorkflow.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "sa_std/ptr.sa"

// TS imports: createHash/randomUUID (node:crypto), existsSync
// (node:fs), mkdir/readFile/rename/rm/writeFile (node:fs/promises),
// homedir (node:os), path helpers, SaVmPolicyConfig type,
// tree-sitter outline/coupling/diagnostics, policy normalize/check,
// parseAndCheckSaVmPatch.
// DEFECT: the whole module is async + throw-based. Conversion: every
// function is synchronous; a "throw" becomes (status != 0 + err text
// in the caller's WErr buffer), and runSplitWorkflowAction catches at
// its single outer boundary exactly like the TS try/catch. Cross-file
// calls (policy/tree-sitter/patch) are declared as local wrappers
// with assumed signatures — unification is a fix-phase item.

struct WBuf {
    bytes: [u8; 8192],
    len: u64,
}

fn wb_reset(b: &WBuf) -> void { b.len = 0; }

fn wb_append(b: &WBuf, src_ptr: ptr, src_len: u64) -> void {
    for i in 0..src_len {
        if b.len < 8192 {
            let c: u8 = 0;
            PTR_BYTE_AT(c, src_ptr, i);
            b.bytes[b.len] = c;
            b.len = b.len + 1;
        };
    }
}

fn wb_append_buf(b: &WBuf, src: &WBuf) -> void {
    for i in 0..src.len {
        if b.len < 8192 {
            b.bytes[b.len] = src.bytes[i];
            b.len = b.len + 1;
        };
    }
}

fn wb_append_u64(b: &WBuf, v: u64) -> void {
    let digits = [0u8; 20];
    let n: u64 = 0;
    let x = v;
    if x == 0 { wb_append(b, STR_PTR("0"), STR_LEN("0")); return; };
    while x > 0 {
        digits[n] = 48 + (x % 10) as u8;
        n = n + 1;
        x = x / 10;
    }
    let i = n;
    while i > 0 {
        i = i - 1;
        if b.len < 8192 { b.bytes[b.len] = digits[i]; b.len = b.len + 1; };
    }
}

fn wb_eq(b: &WBuf, s_ptr: ptr, s_len: u64) -> bool {
    if b.len != s_len { return false; };
    for i in 0..s_len {
        let c: u8 = 0;
        PTR_BYTE_AT(c, s_ptr, i);
        if b.bytes[i] != c { return false; };
    }
    return true;
}

// Error channel replacing throw: err text + flag.
struct WErr {
    has: bool,
    msg: WBuf,
}

fn werr_set(e: &WErr, src_ptr: ptr, src_len: u64) -> void {
    e.has = true;
    wb_reset(&e.msg);
    wb_append(&e.msg, src_ptr, src_len);
}

fn werr_set_buf(e: &WErr, src: &WBuf) -> void {
    e.has = true;
    wb_reset(&e.msg);
    wb_append_buf(&e.msg, src);
}

// type SplitFileState -> struct (contents are large text buffers;
// DEFECT: string fields capped at 1 MiB buffers in this pass).
struct BigBuf {
    bytes: [u8; 1048576],
    len: u64,
}

fn bb_reset(b: &BigBuf) -> void { b.len = 0; }

fn bb_append(b: &BigBuf, src_ptr: ptr, src_len: u64) -> void {
    for i in 0..src_len {
        if b.len < 1048576 {
            let c: u8 = 0;
            PTR_BYTE_AT(c, src_ptr, i);
            b.bytes[b.len] = c;
            b.len = b.len + 1;
        };
    }
}

fn bb_append_buf(b: &BigBuf, src: &BigBuf) -> void {
    for i in 0..src.len {
        if b.len < 1048576 {
            b.bytes[b.len] = src.bytes[i];
            b.len = b.len + 1;
        };
    }
}

fn bb_eq(a: &BigBuf, b: &BigBuf) -> bool {
    if a.len != b.len { return false; };
    for i in 0..a.len {
        if a.bytes[i] != b.bytes[i] { return false; };
    }
    return true;
}

struct SplitFileState {
    base_exists: bool,
    base_content: BigBuf,
    has_base_hash: bool,
    base_hash: WBuf,
    staged_content: BigBuf,
    has_committed_hash: bool,
    committed_hash: WBuf,
}

// files: Record<string, SplitFileState> -> fixed keyed table.
struct SplitFileEntry {
    path: WBuf,
    state: SplitFileState,
}

struct SplitStage {
    at: WBuf,
    kind: u64,
    module_name: WBuf,
    paths_json: [u8; 4096],
    paths_json_len: u64,
}

const STAGE_COARSE: u64 = 0;
const STAGE_REFINE: u64 = 1;

// type SplitManifest -> struct. status union -> tags:
