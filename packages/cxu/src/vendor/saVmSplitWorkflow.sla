    task: WBuf,
    has_reviewed_hash: bool,
    reviewed_hash: WBuf,
    has_validated_hash: bool,
    validated_hash: WBuf,
    files: [SplitFileEntry; 64],
    files_count: u64,
    stages: [SplitStage; 32],
    stages_count: u64,
}

const STATUS_PLANNED: u64 = 0;
const STATUS_STAGED: u64 = 1;
const STATUS_COMMITTED: u64 = 2;
const STATUS_ROLLED_BACK: u64 = 3;

// type SplitInput -> struct (policy/additionalRoots stay external:
