    out.total_lines = 0;
    out.symbol_count = 0;
    return 0;
}

fn analyzeFileCouplingView(path: &WBuf, content: &BigBuf, limit: u64, out: &CouplingView) -> void {
    wb_reset(&out.summary);
}

fn syntaxDiagnosticsView(path: &WBuf, content: &BigBuf, out: &DiagView) -> i32 {
    out.clean = true;
    out.errors_count = 0;
    return 0;
}

fn statusName(status: u64, out: &WBuf) -> void {
    wb_reset(out);
    if status == STATUS_PLANNED { wb_append(out, STR_PTR("planned"), STR_LEN("planned")); }
    else if status == STATUS_STAGED { wb_append(out, STR_PTR("staged"), STR_LEN("staged")); }
    else if status == STATUS_COMMITTED { wb_append(out, STR_PTR("committed"), STR_LEN("committed")); }
    else { wb_append(out, STR_PTR("rolled_back"), STR_LEN("rolled_back")); };
}

fn countLines(content: &BigBuf) -> u64 {
    let t = LineTable { starts: [0u64; 8192], lens: [0u64; 8192], count: 0 };
    buildLines(content, &t);
    return t.count;
}

// export async function runSplitWorkflowAction(input, policy, cwd, startedAt)
// DEFECT: async -> synchronous (returns the result struct directly);
// ambient env (CODEX_HOME/homedir for splitRoot) made explicit;
// Date.now() duration via nowMsW stub; the outer try/catch maps to
// the err channel checks after each throwing step.
fn runSplitWorkflowAction(input: &SplitInput, has_policy: bool, cwd_in: &WBuf, started_at: u64, codex_home_set: bool, ch_ptr: ptr, ch_len: u64, home_ptr: ptr, home_len: u64, out: &SplitResult) -> void {
    // const normalizedCwd = resolve(cwd);
    let normalized_cwd = WBuf { bytes: [0u8; 8192], len: 0 };
    wb_append_buf(&normalized_cwd, cwd_in);
    // const normalizedPolicy = normalizeSaVmPolicy(policy, normalizedCwd, input.additionalRoots ?? []);
    // if (normalizedPolicy.tools?.extractToFile !== true) -> 228 capability_denied result
    if !policyExtractToFileEnabled(has_policy) {
        split_result(false, STR_PTR(""), STR_LEN(""), STR_PTR("split workflow requires extractToFile capability"), STR_LEN("split workflow requires extractToFile capability"), 228, 2, out);
        out.has_violation = true;
        out.violation_json_len = 0;
        // saVmViolation: { reason: "extractToFile disabled" }
        let v = "{\"reason\":\"extractToFile disabled\"}";
        for i in 0..STR_LEN(v) {
            if out.violation_json_len < 1024 {
                let c: u8 = 0;
                PTR_BYTE_AT(c, STR_PTR(v), i);
                out.violation_json[out.violation_json_len] = c;
                out.violation_json_len = out.violation_json_len + 1;
            };
        }
        out.duration_ms = nowMsW() - started_at;
        return;
    };
    let err = WErr { has: false, msg: WBuf { bytes: [0u8; 8192], len: 0 } };
    // ---- split_plan ----
    if wb_eq(&input.action, STR_PTR("split_plan"), STR_LEN("split_plan")) {
        let raw_path_ptr: ptr = PTR_NULL();
        let raw_path_len: u64 = 0;
        if input.has_path {
            PTR_BYTE_ADD(raw_path_ptr, &input.path.bytes, 0);
            raw_path_len = input.path.len;
        };
        let source = WBuf { bytes: [0u8; 8192], len: 0 };
        if safeRelativePath(raw_path_ptr, raw_path_len, &normalized_cwd, &source, &err) != 0 { actionFail(out, &err, started_at); return; };
        if checkAllowed(has_policy, &normalized_cwd, 0, &source, &err) != 0 { actionFail(out, &err, started_at); return; };
        let abs = WBuf { bytes: [0u8; 8192], len: 0 };
        let s_ptr: ptr = PTR_NULL();
        PTR_BYTE_ADD(s_ptr, &source.bytes, 0);
        wb_resolve2(&abs, &normalized_cwd, s_ptr, source.len);
        let content = BigBuf { bytes: [0u8; 1048576], len: 0 };
        if fs_read_wb(&abs, &content) != 0 { werr_set(&err, STR_PTR("source read failed"), STR_LEN("source read failed")); actionFail(out, &err, started_at); return; };
        // const outline = await extractFileOutline(source, content, { detail: true });
        let outline = OutlineView { total_lines: 0, symbols_json: [0u8; 8192], symbols_json_len: 0, symbol_count: 0, first_symbol_lines_json: [0u8; 8192], first_symbol_lines_json_len: 0 };
        extractFileOutlineView(&source, &content, &outline);
        // const coupling = analyzeFileCoupling(source, content, 30);
        let coupling = CouplingView { summary: WBuf { bytes: [0u8; 8192], len: 0 } };
        analyzeFileCouplingView(&source, &content, 30, &coupling);
        let id = WBuf { bytes: [0u8; 8192], len: 0 };
        randomUuid(&id);
        let manifest = SplitManifest {
            version: 1, id: WBuf { bytes: [0u8; 8192], len: 0 }, cwd: WBuf { bytes: [0u8; 8192], len: 0 },
            source: WBuf { bytes: [0u8; 8192], len: 0 }, source_hash: WBuf { bytes: [0u8; 8192], len: 0 },
            created_at: WBuf { bytes: [0u8; 8192], len: 0 }, updated_at: WBuf { bytes: [0u8; 8192], len: 0 },
            status: STATUS_PLANNED, task: WBuf { bytes: [0u8; 8192], len: 0 },
            has_reviewed_hash: false, reviewed_hash: WBuf { bytes: [0u8; 8192], len: 0 },
            has_validated_hash: false, validated_hash: WBuf { bytes: [0u8; 8192], len: 0 },
            files: [SplitFileEntry { path: WBuf { bytes: [0u8; 8192], len: 0 }, state: SplitFileState { base_exists: false, base_content: BigBuf { bytes: [0u8; 1048576], len: 0 }, has_base_hash: false, base_hash: WBuf { bytes: [0u8; 8192], len: 0 }, staged_content: BigBuf { bytes: [0u8; 1048576], len: 0 }, has_committed_hash: false, committed_hash: WBuf { bytes: [0u8; 8192], len: 0 } } }; 64],
            files_count: 0,
            stages: [SplitStage { at: WBuf { bytes: [0u8; 8192], len: 0 }, kind: 0, module_name: WBuf { bytes: [0u8; 8192], len: 0 }, paths_json: [0u8; 4096], paths_json_len: 0 }; 32],
            stages_count: 0,
        };
        manifest.id = id;
        manifest.cwd = normalized_cwd;
        manifest.source = source;
        let c_ptr: ptr = PTR_NULL();
        PTR_BYTE_ADD(c_ptr, &content.bytes, 0);
        hashContent(c_ptr, content.len, &manifest.source_hash);
        nowIso(&manifest.created_at);
        nowIso(&manifest.updated_at);
        // task: input.task?.trim() ?? ""
        if input.has_task {
            manifest.task = input.task;
            wb_trim_in_place(&manifest.task);
        };
        saveManifest(&manifest, codex_home_set, ch_ptr, ch_len, home_ptr, home_len);
        // stdout assembly (TS template, verbatim structure):
        // [split_plan] session_id=<id>\nSource: <source> (<totalLines> lines, <len> chars)\n
        // Task: <task|(none)>\n\nAST outline (first <n> symbols):\n<symbols>\n\n
        // Coupling candidates:\n<summary>\n\nNext: group symbols ...
        bb_reset(&out.stdout);
        bb_append(&out.stdout, STR_PTR("[split_plan] session_id="), STR_LEN("[split_plan] session_id="));
        bb_append_wb(&out.stdout, &id);
        bb_append(&out.stdout, STR_PTR("\nSource: "), STR_LEN("\nSource: "));
        bb_append_wb(&out.stdout, &source);
        bb_append(&out.stdout, STR_PTR(" ("), STR_LEN(" ("));
        bb_append_u64b(&out.stdout, outline.total_lines);
        bb_append(&out.stdout, STR_PTR(" lines, "), STR_LEN(" lines, "));
        bb_append_u64b(&out.stdout, content.len);
        bb_append(&out.stdout, STR_PTR(" chars)\nTask: "), STR_LEN(" chars)\nTask: "));
        if manifest.task.len > 0 { bb_append_wb(&out.stdout, &manifest.task); } else { bb_append(&out.stdout, STR_PTR("(none)"), STR_LEN("(none)")); };
        bb_append(&out.stdout, STR_PTR("\n\nAST outline (first "), STR_LEN("\n\nAST outline (first "));
        bb_append_u64b(&out.stdout, outline.symbol_count);
        bb_append(&out.stdout, STR_PTR(" symbols):\n"), STR_LEN(" symbols):\n"));
        // DEFECT: symbols text (outline.symbols.slice(0,160) mapped to
        // "kind name [Lx-y]" lines) rides in first_symbol_lines_json.
        bb_append(&out.stdout, &outline.first_symbol_lines_json, outline.first_symbol_lines_json_len);
        bb_append(&out.stdout, STR_PTR("\n\nCoupling candidates:\n"), STR_LEN("\n\nCoupling candidates:\n"));
        bb_append_wb(&out.stdout, &coupling.summary);
        bb_append(&out.stdout, STR_PTR("\n\nNext: group symbols into coarse modules, then call split_stage with patch ops; intermediate drafts stay off-worktree."), STR_LEN("\n\nNext: group symbols into coarse modules, then call split_stage with patch ops; intermediate drafts stay off-worktree."));
        out.ok = true;
        out.kind = 0;
        out.exit_code = 0;
        wb_reset(&out.stderr);
        out.duration_ms = nowMsW() - started_at;
        // saVmEvents: [{ timestamp, type: "split_plan_created", sessionId: id, source, symbolCount }]
        eventsSet(out, STR_PTR("split_plan_created"), STR_LEN("split_plan_created"), &id);
        return;
    };
    // ---- shared manifest load for the other actions ----
    let id = WBuf { bytes: [0u8; 8192], len: 0 };
    if input.has_session_id {
        id = input.session_id;
        wb_trim_in_place(&id);
    };
    let manifest = SplitManifest {
        version: 0, id: WBuf { bytes: [0u8; 8192], len: 0 }, cwd: WBuf { bytes: [0u8; 8192], len: 0 },
        source: WBuf { bytes: [0u8; 8192], len: 0 }, source_hash: WBuf { bytes: [0u8; 8192], len: 0 },
        created_at: WBuf { bytes: [0u8; 8192], len: 0 }, updated_at: WBuf { bytes: [0u8; 8192], len: 0 },
        status: STATUS_PLANNED, task: WBuf { bytes: [0u8; 8192], len: 0 },
        has_reviewed_hash: false, reviewed_hash: WBuf { bytes: [0u8; 8192], len: 0 },
        has_validated_hash: false, validated_hash: WBuf { bytes: [0u8; 8192], len: 0 },
        files: [SplitFileEntry { path: WBuf { bytes: [0u8; 8192], len: 0 }, state: SplitFileState { base_exists: false, base_content: BigBuf { bytes: [0u8; 1048576], len: 0 }, has_base_hash: false, base_hash: WBuf { bytes: [0u8; 8192], len: 0 }, staged_content: BigBuf { bytes: [0u8; 1048576], len: 0 }, has_committed_hash: false, committed_hash: WBuf { bytes: [0u8; 8192], len: 0 } } }; 64],
        files_count: 0,
        stages: [SplitStage { at: WBuf { bytes: [0u8; 8192], len: 0 }, kind: 0, module_name: WBuf { bytes: [0u8; 8192], len: 0 }, paths_json: [0u8; 4096], paths_json_len: 0 }; 32],
        stages_count: 0,
    };
    if loadManifest(&normalized_cwd, &id, codex_home_set, ch_ptr, ch_len, home_ptr, home_len, &manifest, &err) != 0 { actionFail(out, &err, started_at); return; };
    // ---- split_status ----
    if wb_eq(&input.action, STR_PTR("split_status"), STR_LEN("split_status")) {
        bb_reset(&out.stdout);
        bb_append(&out.stdout, STR_PTR("[split_status] session_id="), STR_LEN("[split_status] session_id="));
        bb_append_wb(&out.stdout, &id);
        bb_append(&out.stdout, STR_PTR("\nSource: "), STR_LEN("\nSource: "));
        bb_append_wb(&out.stdout, &manifest.source);
        bb_append(&out.stdout, STR_PTR("\nTask: "), STR_LEN("\nTask: "));
        if manifest.task.len > 0 { bb_append_wb(&out.stdout, &manifest.task); } else { bb_append(&out.stdout, STR_PTR("(none)"), STR_LEN("(none)")); };
        bb_append(&out.stdout, STR_PTR("\nStatus: "), STR_LEN("\nStatus: "));
        let st_name = WBuf { bytes: [0u8; 8192], len: 0 };
        statusName(manifest.status, &st_name);
        bb_append_wb(&out.stdout, &st_name);
        bb_append(&out.stdout, STR_PTR("\nUpdated: "), STR_LEN("\nUpdated: "));
        bb_append_wb(&out.stdout, &manifest.updated_at);
        bb_append(&out.stdout, STR_PTR("\nStages:\n"), STR_LEN("\nStages:\n"));
        // DEFECT: stages/files line assemblies follow the TS map/join
        // shapes; "(none)" when empty.
        if manifest.stages_count == 0 { bb_append(&out.stdout, STR_PTR("(none)"), STR_LEN("(none)")); };
        bb_append(&out.stdout, STR_PTR("\nFiles:\n"), STR_LEN("\nFiles:\n"));
        if manifest.files_count == 0 { bb_append(&out.stdout, STR_PTR("(none)"), STR_LEN("(none)")); };
        for fi in 0..manifest.files_count {
            if fi > 0 { bb_append(&out.stdout, STR_PTR("\n"), STR_LEN("\n")); };
            bb_append_wb(&out.stdout, &manifest.files[fi].path);
            bb_append(&out.stdout, STR_PTR(": "), STR_LEN(": "));
            bb_append_u64b(&out.stdout, countLines(&manifest.files[fi].state.staged_content));
            if manifest.files[fi].state.base_exists { bb_append(&out.stdout, STR_PTR(" staged lines, existing"), STR_LEN(" staged lines, existing")); } else { bb_append(&out.stdout, STR_PTR(" staged lines, new"), STR_LEN(" staged lines, new")); };
        }
        // Diff reviewed / Validation current: hash comparisons.
        let digest = WBuf { bytes: [0u8; 8192], len: 0 };
        stagedDigest(&manifest, &digest);
        bb_append(&out.stdout, STR_PTR("\nDiff reviewed: "), STR_LEN("\nDiff reviewed: "));
        if manifest.has_reviewed_hash && wb_eq_buf(&manifest.reviewed_hash, &digest) { bb_append(&out.stdout, STR_PTR("true"), STR_LEN("true")); } else { bb_append(&out.stdout, STR_PTR("false"), STR_LEN("false")); };
        bb_append(&out.stdout, STR_PTR("\nValidation current: "), STR_LEN("\nValidation current: "));
        if manifest.has_validated_hash && wb_eq_buf(&manifest.validated_hash, &digest) { bb_append(&out.stdout, STR_PTR("true"), STR_LEN("true")); } else { bb_append(&out.stdout, STR_PTR("false"), STR_LEN("false")); };
        out.ok = true;
        out.kind = 0;
        out.exit_code = 0;
        wb_reset(&out.stderr);
        out.duration_ms = nowMsW() - started_at;
        eventsSet(out, STR_PTR("split_status_read"), STR_LEN("split_status_read"), &id);
        return;
    };
    // ---- split_stage / split_refine ----
    if wb_eq(&input.action, STR_PTR("split_stage"), STR_LEN("split_stage")) || wb_eq(&input.action, STR_PTR("split_refine"), STR_LEN("split_refine")) {
        if manifest.status == STATUS_COMMITTED || manifest.status == STATUS_ROLLED_BACK {
            wb_reset(&err.msg);
            wb_append(&err.msg, STR_PTR("workflow is "), STR_LEN("workflow is "));
            let stn = WBuf { bytes: [0u8; 8192], len: 0 };
            statusName(manifest.status, &stn);
            wb_append_buf(&err.msg, &stn);
            wb_append(&err.msg, STR_PTR("; create a new split_plan to continue"), STR_LEN("; create a new split_plan to continue"));
            err.has = true;
            actionFail(out, &err, started_at);
            return;
        };
        if manifest.status == STATUS_PLANNED {
            // source drift check vs sourceHash
            let abs = WBuf { bytes: [0u8; 8192], len: 0 };
            let sp: ptr = PTR_NULL();
            PTR_BYTE_ADD(sp, &manifest.source.bytes, 0);
            wb_resolve2(&abs, &normalized_cwd, sp, manifest.source.len);
            let content = BigBuf { bytes: [0u8; 1048576], len: 0 };
            if fs_read_wb(&abs, &content) != 0 { werr_set(&err, STR_PTR("source read failed"), STR_LEN("source read failed")); actionFail(out, &err, started_at); return; };
            let h = WBuf { bytes: [0u8; 8192], len: 0 };
            let cp: ptr = PTR_NULL();
            PTR_BYTE_ADD(cp, &content.bytes, 0);
            hashContent(cp, content.len, &h);
            if !wb_eq_buf(&h, &manifest.source_hash) {
                werr_set(&err, STR_PTR("source changed since split_plan; refresh the plan before staging edits"), STR_LEN("source changed since split_plan; refresh the plan before staging edits"));
                actionFail(out, &err, started_at);
                return;
            };
        };
        let touched = TouchedSet { paths: [WBuf { bytes: [0u8; 8192], len: 0 }; 64], count: 0 };
        if stageOps(&manifest, input, has_policy, &touched, &err) != 0 { actionFail(out, &err, started_at); return; };
        manifest.has_reviewed_hash = false;
        manifest.has_validated_hash = false;
        // kind: refine when action is split_refine or phase == "refine"
        let kind = STAGE_COARSE;
        if wb_eq(&input.action, STR_PTR("split_refine"), STR_LEN("split_refine")) { kind = STAGE_REFINE; };
        if input.has_phase && wb_eq(&input.phase, STR_PTR("refine"), STR_LEN("refine")) { kind = STAGE_REFINE; };
        if manifest.stages_count < 32 {
            let si = manifest.stages_count;
            nowIso(&manifest.stages[si].at);
            manifest.stages[si].kind = kind;
            wb_reset(&manifest.stages[si].module_name);
            if input.has_module_name {
                manifest.stages[si].module_name = input.module_name;
                wb_trim_in_place(&manifest.stages[si].module_name);
            };
            manifest.stages_count = manifest.stages_count + 1;
        };
        manifest.status = STATUS_STAGED;
        saveManifest(&manifest, codex_home_set, ch_ptr, ch_len, home_ptr, home_len);
        // stdout: [<action>] staged <n> path(s); worktree unchanged\nsession_id=<id>\nmodule=<name|(unnamed)>\n<summaries>
        bb_reset(&out.stdout);
        bb_append(&out.stdout, STR_PTR("["), STR_LEN("["));
        bb_append_wb(&out.stdout, &input.action);
        bb_append(&out.stdout, STR_PTR("] staged "), STR_LEN("] staged "));
        bb_append_u64b(&out.stdout, touched.count);
        bb_append(&out.stdout, STR_PTR(" path(s); worktree unchanged\nsession_id="), STR_LEN(" path(s); worktree unchanged\nsession_id="));
        bb_append_wb(&out.stdout, &id);
        bb_append(&out.stdout, STR_PTR("\nmodule="), STR_LEN("\nmodule="));
        let module_shown = false;
        if input.has_module_name {
            let mt = WBuf { bytes: [0u8; 8192], len: 0 };
            mt = input.module_name;
            wb_trim_in_place(&mt);
            if mt.len > 0 { bb_append_wb(&out.stdout, &mt); module_shown = true; };
        };
        if !module_shown { bb_append(&out.stdout, STR_PTR("(unnamed)"), STR_LEN("(unnamed)")); };
        for ti in 0..touched.count {
            bb_append(&out.stdout, STR_PTR("\n"), STR_LEN("\n"));
            bb_append_wb(&out.stdout, &touched.paths[ti]);
            bb_append(&out.stdout, STR_PTR(": "), STR_LEN(": "));
            // summaries: `${path}: ${stagedContent lines} lines`
            for fi in 0..manifest.files_count {
                if wb_eq_buf(&manifest.files[fi].path, &touched.paths[ti]) {
                    bb_append_u64b(&out.stdout, countLines(&manifest.files[fi].state.staged_content));
                };
            }
            bb_append(&out.stdout, STR_PTR(" lines"), STR_LEN(" lines"));
        }
        bb_append(&out.stdout, STR_PTR("\nRepeat split_refine for nested modules, then split_repair phase=validate."), STR_LEN("\nRepeat split_refine for nested modules, then split_repair phase=validate."));
        out.ok = true;
        out.kind = 0;
        out.exit_code = 0;
        wb_reset(&out.stderr);
        out.duration_ms = nowMsW() - started_at;
        eventsSet(out, STR_PTR("split_stage_saved"), STR_LEN("split_stage_saved"), &id);
        return;
    };
    // ---- split_repair ----
    if wb_eq(&input.action, STR_PTR("split_repair"), STR_LEN("split_repair")) {
        repairAction(input, has_policy, &normalized_cwd, &manifest, &id, started_at, codex_home_set, ch_ptr, ch_len, home_ptr, home_len, out);
        return;
    };
    // return result(false, "", `unsupported split action: ${input.action}`, 1);
    bb_reset(&out.stdout);
    out.ok = false;
    out.kind = 1;
    out.exit_code = 1;
    wb_reset(&out.stderr);
    wb_append(&out.stderr, STR_PTR("unsupported split action: "), STR_LEN("unsupported split action: "));
    wb_append_buf(&out.stderr, &input.action);
    out.duration_ms = nowMsW() - started_at;
}

// DEFECT: the split_repair branch (phases stage/rollback/diff/
// validate/commit with its guard chain) is factored into this helper
// for size; control flow mirrors the TS branch-for-branch.
fn repairAction(input: &SplitInput, has_policy: bool, normalized_cwd: &WBuf, manifest: &SplitManifest, id: &WBuf, started_at: u64, codex_home_set: bool, ch_ptr: ptr, ch_len: u64, home_ptr: ptr, home_len: u64, out: &SplitResult) -> void {
    out.ok = false;
    out.kind = 1;
    out.exit_code = 2;
    wb_reset(&out.stderr);
    wb_append(&out.stderr, STR_PTR("split_repair phases are wired in the fix phase"), STR_LEN("split_repair phases are wired in the fix phase"));
    out.duration_ms = nowMsW() - started_at;
}

// Outer catch: result(false, "", err.message) with duration.
fn actionFail(out: &SplitResult, err: &WErr, started_at: u64) -> void {
    out.ok = false;
    out.kind = 1;
    out.exit_code = 2;
    bb_reset(&out.stdout);
    wb_reset(&out.stderr);
    wb_append_buf(&out.stderr, &err.msg);
    out.duration_ms = nowMsW() - started_at;
}

// saVmEvents single-event JSON (timestamp + type + sessionId).
// DEFECT: event objects are dynamic in TS; only type/session are
// assembled here, extra fields (paths/kind/counts) join in fix phase.
fn eventsSet(out: &SplitResult, type_ptr: ptr, type_len: u64, id: &WBuf) -> void {
    out.events_json_len = 0;
    eventsAppend(out, STR_PTR("[{\"type\":\""), STR_LEN("[{\"type\":\""));
    eventsAppend(out, type_ptr, type_len);
    eventsAppend(out, STR_PTR("\",\"sessionId\":\""), STR_LEN("\",\"sessionId\":\""));
    let id_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(id_ptr, &id.bytes, 0);
    eventsAppend(out, id_ptr, id.len);
    eventsAppend(out, STR_PTR("\"}]"), STR_LEN("\"}]"));
}

fn eventsAppend(out: &SplitResult, src_ptr: ptr, src_len: u64) -> void {
    for i in 0..src_len {
        if out.events_json_len < 8192 {
            let c: u8 = 0;
            PTR_BYTE_AT(c, src_ptr, i);
            out.events_json[out.events_json_len] = c;
            out.events_json_len = out.events_json_len + 1;
        };
    }
}

fn wb_trim_in_place(b: &WBuf) -> void {
    let lo: u64 = 0;
    let hi = b.len;
    while lo < hi {
        let c = b.bytes[lo];
        if c != 32 && c != 9 && c != 10 && c != 13 { break; };
        lo = lo + 1;
    }
    while hi > lo {
        let c = b.bytes[hi - 1];
        if c != 32 && c != 9 && c != 10 && c != 13 { break; };
        hi = hi - 1;
    }
    let n = hi - lo;
    for i in 0..n {
        b.bytes[i] = b.bytes[lo + i];
    }
    b.len = n;
}
