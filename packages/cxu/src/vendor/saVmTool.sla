// fn estimateTokenCount (lines 637-650): ceil(cjk*0.8 + ascii/3.5) over
// UTF-16 code units; CJK range 0x4E00-0x9FFF.
// DEFECT: charCodeAt iterates UTF-16 units; SLA bytes are UTF-8 — count
// approximated per byte with a DEFECT-level divergence for astral chars.
fn estimateTokenCount(text_ptr: ptr, text_len: u64) -> u64 {
    if text_len == 0 { return 0; };
    let cjk: u64 = 0;
    let ascii: u64 = 0;
    let i: u64 = 0;
    while i < text_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, text_ptr, i);
        if b >= 128 { cjk = cjk + 1; } else { ascii = ascii + 1; };
        i = i + 1;
    }
    // ceil(cjk*0.8 + ascii/3.5) in fixed point (x100): (80*cjk + 28*ascii)
    let scaled: u64 = 80 * cjk + 28 * ascii;
    return (scaled + 99) / 100;
}

