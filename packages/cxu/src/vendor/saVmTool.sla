// class AsyncSemaphore (lines 568-589) -> struct + &Struct function family.
// DEFECT: Promise waiter queue / closure release callbacks — approximated
// with a waiter count; acquire returns status (0 acquired, 1 busy-error).
struct AsyncSemaphore {
    active: u64,
    waiters: u64,
}

fn AsyncSemaphore_acquire(sem: &AsyncSemaphore, ok: &bool) -> void {
    ok = false;
    if sem.active < 2 {
        sem.active = sem.active + 1;
        ok = true;
        return;
    };
    if sem.waiters >= 64 {
        // TS throws SaVmInputError("SA-VM is busy; ...")
        return;
    };
    // DEFECT: await new Promise(...) — no async wait in SLA; caller polls.
    sem.waiters = sem.waiters + 1;
}

fn AsyncSemaphore_release(sem: &AsyncSemaphore) -> void {
    if sem.waiters > 0 {
        sem.waiters = sem.waiters - 1;
        // TS resolves the next waiter, which re-acquires.
        return;
    };
    if sem.active > 0 { sem.active = sem.active - 1; };
}

