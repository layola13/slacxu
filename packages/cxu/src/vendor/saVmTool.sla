fn sliceAndFilterOutput(raw_ptr: ptr, raw_len: u64, opts: &JsonBuf, out: &JsonBuf) -> void {
    out.len = 0;
}

// SpawnHostProcessResult (lines 8159-8168): {ok, kind:
// success|crashed|timeout|running, exitCode|null, stdout, stderr,
// durationMs, sessionId?, pid?} -> struct with flags.
struct SpawnHostProcessResult {
    ok: bool,
    kind: u64, // 0 success, 1 crashed, 2 timeout, 3 running
    has_exit_code: bool,
    exit_code: i32,
    stdout: [0u8; 524288],
    stdout_len: u64,
    stderr: [0u8; 131072],
    stderr_len: u64,
    duration_ms: u64,
    has_session: bool,
    session_id: [0u8; 64],
    session_id_len: u64,
    has_pid: bool,
    pid: u64,
}

// fn spawnHostProcess (lines 8170-8344). DEFECT: async/Promise +
// EventEmitter child streams + setTimeout timers — approximated with
// sa_std_process_spawn_bidi + deadline polling. Semantics preserved:
// spawn (win32 .cmd/.bat via COMSPEC /d /s /c), stdout capped at
// MAX_STDOUT_BYTES and stderr at MAX_STDERR_BYTES while streaming;
// overall timeout kills the tree and resolves kind timeout exit 124
// with "[timeout] run_host execution timed out after <ms>ms" appended;
// spawn error -> crashed; close -> success iff code 0 else crashed.
// With yieldTimeMs: at the yield deadline the still-running child is
// registered as a SaVmProcessSession (id "proc-<uuid8>") whose chunk
// buffers keep appending (chunk lists compacted past 2000/1000 entries),
// an auto-kill timer at max(timeoutMs, 60000) marks timed_out, and the
// call resolves kind "running" with sessionId/pid.
fn spawnHostProcess(bin_ptr: ptr, bin_len: u64, args: &StrList, cwd_ptr: ptr, cwd_len: u64, env_json: &JsonBuf, timeout_ms: u64, started_at: u64, has_yield: bool, yield_ms: u64, table: &SaVmSessionTable, out: &SpawnHostProcessResult) -> void {
    out.ok = false;
    out.kind = 1;
}

