// ---------------------------------------------------------------------------
// SaVmRunResult (from sdk-backend): every native* function returns this
// shape. DEFECT: dynamic object + saVmEvents array -> JSON text buffers.
// kind is one of: success | capability_denied | sa_error | (others by
// string). exitCode 228 = capability denied, per source convention.
// ---------------------------------------------------------------------------
struct SaVmRunResult {
    ok: bool,
    kind: [0u8; 64],
    kind_len: u64,
    exit_code: i32,
    stdout: [0u8; 524288],
    stdout_len: u64,
    stderr: [0u8; 131072],
    stderr_len: u64,
    events_json: [0u8; 65536],
    events_len: u64,
    violation_json: [0u8; 4096],
    violation_len: u64,
    has_violation: bool,
    duration_ms: u64,
}

fn resultDenied(res: &SaVmRunResult, reason_ptr: ptr, reason_len: u64, started_at: u64, now_ms: u64) -> void {
    res.ok = false;
    res.exit_code = 228;
    // kind = "capability_denied"; stderr = reason; violation = {reason}
    res.duration_ms = now_ms - started_at;
}

fn resultError(res: &SaVmRunResult, msg_ptr: ptr, msg_len: u64, started_at: u64, now_ms: u64) -> void {
    res.ok = false;
    res.exit_code = 1;
    // kind = "sa_error"; stderr = msg
    res.duration_ms = now_ms - started_at;
}

fn resultOk(res: &SaVmRunResult, started_at: u64, now_ms: u64) -> void {
    res.ok = true;
    res.exit_code = 0;
    // kind = "success"
    res.duration_ms = now_ms - started_at;
}

