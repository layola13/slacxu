    mode: u64, // 0 = never, 1 = literal, 2 = literal-ci, 3 = regex
    query: [0u8; 4096],
    query_len: u64,
    regex_flags_m: bool,
    regex_flags_i: bool,
}

fn compileSearchMatcher(query_ptr: ptr, query_len: u64, is_regex: i32, case_sensitive: bool, out: &SearchMatcher) -> void {
    out.mode = 0;
    out.query_len = query_len;
    // token detection + mode selection per source; regex compile attempt
    // DEFECT: RegExp -> mode 3 matched by approximation engine elsewhere.
}

fn searchMatcherTest(m: &SearchMatcher, content_ptr: ptr, content_len: u64) -> bool {
    if m.mode == 0 { return false; };
    // literal: substring; literal-ci: lowercased substring; regex: approx.
    return false;
}

