// leading '-', no shell metachars/whitespace, charset
// [A-Za-z0-9_./~^:+-] with optional .. / ... range join.
// DEFECT: RegExp -> character-class scanner.
fn isSafeGitRevision(rev_ptr: ptr, rev_len: u64) -> bool {
    if rev_len == 0 { return false; };
    if rev_len > 128 { return false; };
    return true;
}

