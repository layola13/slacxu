// NormalizedSaVmRunInput: the normalizeSaVmRunInput return shape.
struct NormalizedSaVmRunInput {
    source: [0u8; 524288],
    source_len: u64,
    language: u64,
    args_json: [0u8; 65536],
    args_count: u64,
    cwd: [0u8; 4096],
    cwd_len: u64,
    limits: [0u8; 64],
    policy_json: [0u8; 65536],
    policy_len: u64,
}

// fn normalizeSaVmRunInput (lines 11894-11966). DEFECT: throw -> status
// code (0 ok, 1 input error, 2 capability denied) + err buffer.
// expandSaVmActionInput first; source must be a string <= 512 KiB.
// language: sa/sla -> input error ("sa/sla runtime was removed in the
// bun branch..."); py/python -> py; ""/js/javascript/node/bun/ts/
// typescript -> js; anything else -> unsupported input error. Policy
// execution gates: js requires policy.execution.javascript, py requires
// policy.execution.python (capability errors with the settings guidance
// text). args: strings only, cap 128, each <= 4096 chars.
// requested_caps: normalizeFsCaps + normalizeNetCaps validated; env
// caps are identifier-shaped names (cap 16) each present in
// policy.env.allow. Timeout: timeout_ms, or timeout (<1000 treated as
// seconds). Limits clamped via clampLimit against DEFAULT_LIMITS /
// LIMIT_CEILINGS. Emits the normalized policy document
// {schema:"sa.vm.policy/1", extern:{allow:[]}, fs:{read,write},
// http:{allow}, env:{allow}, process:{spawn,exec}, net_raw:false,
// ffi:false, threads:false, limits:{fuel, wall_clock_ms, mem_cap_bytes}}.
fn normalizeSaVmRunInput(raw: &JsonBuf, out: &NormalizedSaVmRunInput, err: &StrBuf) -> i32 {
    out.source_len = 0;
    err.len = 0;
    return 0;
}

// fn normalizeFsCaps (lines 11968-11997): entries are "path" strings
// (op=read) or {op, path} objects; ops whitelist read/write/append/
// edit/create/delete/rename/metadata; each resolved + policy-checked
// (delete routes to checkSaVmDelete when policy.fs.delete == "deny",
// else transfer; read/metadata -> read; rename -> transfer; rest ->
// write); denial throws "filesystem capability denied by VM policy:
// <path> (<reason>)" (delete variant prefix "filesystem delete denied
// by VM policy"). Result capped at 128 caps with decision paths.
// DEFECT: throw inside flatMap -> status propagation; DEFECT: dynamic
// object entries -> JSON probes.
fn normalizeFsCaps(value: &JsonBuf, is_array: bool, cwd_ptr: ptr, cwd_len: u64, policy: &NormalizedSaVmPolicy, out: &JsonBuf, err: &StrBuf) -> i32 {
    out.len = 0;
    err.len = 0;
    return 0;
}

// fn normalizeNetCaps (lines 11999-12016): entries need a string url;
// URL must parse, carry no credentials, and use https: (else input
// error "only HTTPS URLs without credentials are allowed: <url>").
// Methods default ["GET"], uppercased, cap 16; each checked via
// checkSaVmHttp. Caps capped at 64.
// DEFECT: URL global -> sa_std URL parser approximation.
fn normalizeNetCaps(value: &JsonBuf, is_array: bool, policy: &NormalizedSaVmPolicy, out: &JsonBuf, err: &StrBuf) -> i32 {
    out.len = 0;
    err.len = 0;
    return 0;
}

// fn clampLimit (lines 12018-12021).
fn clampLimit(is_num: bool, value: f64, fallback: u64, ceiling: u64) -> u64 {
    let num: u64 = fallback;
    if is_num { num = value as u64; };
    if num > ceiling { return ceiling; };
    return num;
}

// fn resultKind (lines 12023-12033): exit-code -> kind mapping:
// 228 capability_denied, 229 fuel_exhausted, 230 timeout, 231
// mem_quota, 233 policy_invalid, 235 stack_overflow, 1 with non-empty
// stderr -> sa_error, non-null < 128 -> success, else crashed.
// Returns the kind name as a StrBuf.
fn resultKind(has_code: bool, exit_code: i32, stderr_ptr: ptr, stderr_len: u64, out: &StrBuf) -> void {
    out.len = 0;
    if has_code {
        if exit_code == 228 { return; }; // kind = "capability_denied"
        if exit_code == 229 { return; }; // kind = "fuel_exhausted"
        if exit_code == 230 { return; }; // kind = "timeout"
        if exit_code == 231 { return; }; // kind = "mem_quota"
        if exit_code == 233 { return; }; // kind = "policy_invalid"
        if exit_code == 235 { return; }; // kind = "stack_overflow"
    };
    // 1 + stderr -> "sa_error"; non-null <128 -> "success"; else "crashed"
}

// fn isSaVmBlockedToolName (lines 12035-12039): segment-delimited
// (^|[._:/-]) match for bash|shell|exec|python(ver)|py|node(js)|bun(x)|
// deno|ts-node|tsx|npx|javascript|typescript|js|powershell|pwsh|cmd|
// apply_patch|write_file|edit_file followed by ($|[._:/-]).
// DEFECT: RegExp -> segment scanner.
fn isSaVmBlockedToolName(value_ptr: ptr, value_len: u64, is_string: bool) -> bool {
    if !is_string { return false; };
    return false;
}

