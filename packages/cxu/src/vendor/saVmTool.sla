// ---------------------------------------------------------------------------
// fn runSaVmTool (lines 9512-11459) — the central dispatcher.
// DEFECT: async -> synchronous; DEFECT: throw SaVmInputError /
// SaVmCapabilityDeniedError -> error results assembled at the single
// exit (capability -> kind capability_denied exit 228 rule "execution";
// input -> sa_error; other -> unavailable), semaphore release in
// finally-equivalent epilogue.
// Entry: policy/cwd resolved from the options-object overload
// ({cwd, policy} when it carries cwd or policy-without-tools) or plain
// policy + cwdOverride + input.cwd + process.cwd() fallback chain.
// targetFilePath = extractRawFilePath(input) back-fills path/file/
// target. No-action write-intent sniffing (same rules as
// expandSaVmActionInput) yields effectiveAction.
// Branch inventory (each branch extracts aliased params from the JSON
// input — DEFECT: dynamic object — and delegates to the native above):
//   read/read_file/vm-read/vm_read -> nativeReadFile (tail=true or
//     lines<0 -> nativeReadFileTail); read_lines -> nativeReadFile with
//     coerced bounds (default window 250) or tail; read_file_tail/
//     tail_file/tail -> nativeReadFileTail (lines default 100);
//   find/find_files/list_files -> nativeFindFiles (100/5 defaults, full
//     pagination alias forwarding); write/write_file -> nativeWriteFile
//     (content aliases content/contents/text/body/data; missing body is
//     an explicit input error refusing an empty truncate);
//   edit/edit_file -> nativeEditFile (old/new alias families; {input,
//     output} misuse gets a corrective input error);
//   apply_patch/patch (explicit action always wins; bare patch field
//     only when no explicit action) -> nativeApplyPatch(patch|diff|
//     content, additionalRoots); delete/delete_file/remove_file ->
//     nativeDeleteFile; safe_delete -> nativeSafeDelete; move/move_file/
//     rename/rename_file -> nativeMoveFile (from: path/file/from/source,
//     to: to/dest/target2/target or args[0]); ensure_dir/mkdir ->
//     nativeEnsureDir; list_dir -> nativeListDir (depth: max_depth ??
//     depth ?? recursive?5:1, parseExcludeDirs, pagination aliases);
//   grep/grep_search -> nativeGrepSearch (query ?? content fallback);
//   grep_async/grep_search_async/async_grep -> nativeGrepSearchAsync
//     (concurrency default 16); copy/copy_file -> nativeCopyFile;
//   stat/file_info/test_path/file_exists/exists -> nativeFileInfo;
//   count_lines/line_count/wc/count -> nativeCountLines;
//   git_status/git-status, git_diff/git-diff (revision/target split,
//   diff_context coercion), git_log/git-log -> git natives;
//   http_fetch -> nativeHttpFetch;
//   jev_* family (choose/select, checklist/multi_choice, evaluate/eval,
//   thinking/think, redteam/red, rank, scope, dispatch/allocate/
//   delegate, consistency, done, diagnose, edge_cases, blast_radius,
//   intent, next, progress, memory) — each first gated by
//   denyJevActiveTool with its flag, then nativeJev* (saVmJev.sla);
//   jev_compress -> gated plan builder (mode whitelist
//   subscription|token|auto, keep_last_n_turns>=2 guard, requires the
//   clearToolHistory capability else capability_denied);
//   ledger_status/accountability_status/vm_reputation/reputation_status
//   -> getReputationStatus; record_penalty/penalize -> recordPenalty
//   (path/target required); submit_redemption/redeem_penalty/
//   claim_reward -> submitRedemption (penalty_id required);
//   get_antibodies/list_antibodies -> ledger antibody listing;
//   find_references/find_all_references/find_callers/references/
//   find_usages -> nativeFindReferences; find_implementations/find_impl/
//   implementations -> nativeFindImplementations; file_outline/outline/
//   list_symbols/file_symbols/document_symbols -> nativeFileOutline;
//   code_graph/relation_graph/symbol_graph -> nativeCodeGraph
//   (saVmCodeGraph.sla); workspace_outline/outline_many/
//   project_outline -> nativeWorkspaceOutline; read_many/read_files ->
//   nativeReadMany; rename_symbol/symbol_rename -> nativeRenameSymbol;
//   move_file_with_imports/move_with_imports ->
//   nativeMoveFileWithImports; find_definition/goto_definition/def/
//   lookup_symbol/get_definition -> nativeFindDefinition;
//   extract_to_file/extract_file/extract_module -> nativeExtractToFile;
//   add_import/insert_import -> nativeAddImport; get_diagnostics/
//   diagnostics/check_syntax -> nativeGetDiagnostics;
//   workspace_diagnostics/project_diagnostics/all_diagnostics ->
//   nativeWorkspaceDiagnostics; repo_map/repo-map -> nativeRepoMap;
//   notes/memory families -> nativeSaveNote/nativeReadNotes/
//   nativeDeleteNote with effectiveAction forwarded (clear_notes/
//   clear_memory imply all=true); verify_loop/verify-loop/
//   verify_changed -> nativeVerifyLoop; replay_case/run_regression/
//   regression_replay -> nativeReplayCase; record_case/save_case ->
//   nativeRecordCase; organize_imports/clean_unused_imports/
//   sort_imports -> nativeOrganizeImports; analyze_scope/
//   scope_analysis -> nativeAnalyzeScope; extract_component/
//   extract_hook -> nativeExtractComponent; auto_fix_missing_imports/
//   fix_missing_imports -> nativeAutoFixMissingImports;
//   analyze_coupling/cluster_symbols -> nativeAnalyzeCoupling;
//   atomic_refactor/refactor_dry_run -> nativeAtomicRefactor;
//   split_plan/split_stage/split_refine/split_repair/split_status ->
//   runSplitWorkflowAction (saVmSplitWorkflow.sla);
//   run_bun -> bun subcommand/profile pipeline: resolveBunBinary,
//   checkSaVmBunExecution / ALL_SA_VM_BUN_* tables, filter-script
//   handling (ALL_SA_VM_BUN_FILTER_SCRIPTS), validateTestFilePath +
//   verifyBunProfileIntegrity for *-test-file profiles,
//   minimalRunnerEnv, spawnScriptRunner; run_bun_profile/
//   run_project_check/project_check -> profile resolution
//   (checkSaVmBunProfile; unknown profile -> input error) then the same
//   runner; run_host/exec_host/host -> nativeRunHost; write_stdin/stdin/
//   input_stdin -> nativeWriteStdin; session_status/read_session/
//   poll_session -> nativeSessionStatus; kill_session/kill_process/
//   stop_session -> nativeKillSession; list_sessions ->
//   nativeListSessions; local_checkpoint/checkpoint/git_checkpoint ->
//   nativeLocalCheckpoint; restore_checkpoint/restore_git_checkpoint ->
//   nativeRestoreCheckpoint.
// Fallbacks after all branches: (2) legacy template source via
// tryHandleLegacyTemplateSourceNatively; (3) expandSaVmActionInput ->
// parallel array (policy/cwd forwarded explicitly) ->
// runParallelSaVmTool; otherwise semaphore acquire +
// cleanupStaleSaVmTempRoots + normalizeSaVmRunInput, mkdtemp script
// file (mode 0o600, name script-<uuid>.ts/.py) under a
// SA_VM_TEMP_PREFIX root, js -> bun spawnScriptRunner, py ->
// resolvePythonBinary + ["-u", script, ...args]; any other language ->
// capability_denied "sa/sla runtime was removed in the bun branch;
// resubmit as js/ts via bun." (rule execution.sa_removed). Temp root
// always removed afterwards.
// ---------------------------------------------------------------------------
fn runSaVmTool(raw: &JsonBuf, policy: &SaVmPolicyConfig, has_policy: bool, opts: &JsonBuf, has_opts: bool, cwd_override_ptr: ptr, cwd_override_len: u64, has_cwd_override: bool, sem: &AsyncSemaphore, table: &SaVmSessionTable, cache: &GitIgnoreCache, res: &SaVmRunResult) -> void {
    res.stdout_len = 0;
    // dispatch chain per inventory above.
}

