    has_max_line_length: bool,
    max_line_length: u64,
    numbered: bool,
}

// fn nativeReadFile (lines 670-964). DEFECT: async -> synchronous.
// Flow (1:1 with source): resolve path; normalize policy; checkSaVmPath
// read gate -> denied result (228). stat: directory -> EISDIR sa_error
// naming list_dir; size 0 -> "[File: ... is empty (0 bytes)]".
// OPT-1 locateBeforeRead gate: non-targeted reads over
// savings.maxReadFileBytes (default 50*1024) -> capability_denied with
// violation {rule:"contextSavings.locateBeforeRead", blocked:false}.
// Read bytes; NUL scan of first 4096 -> binary notice (+ image hint for
// png/jpg/jpeg/webp/gif/bmp/avif/svg/ico suggesting image_view).
// Token budget: requested = maxTokens>0 ? maxTokens : 4000; remaining
// known -> min(requested, max(500, remaining-3000)); unknown ->
// min(requested, 32000). maxBytes default min(maxTokens*4, 131072);
// maxLines default 250 (cap 1000); maxLineLength default 2000 (cap 4000);
// numbered default true.
// Minified/offset case: char chunk [offset, offset+min(maxTokens*3,
// maxBytes)) with header + truncation continuation notice.
// Line case: slice [startLine..endLine] clamped by maxLines, per-line
// truncation at maxLineLength with minified notice, "NNN: " numbering with
// padWidth = max(len(endLine),3), accumulate until token/byte budget,
// header "[File: ... | Total Lines: ...]" + "[... N more lines truncated
// (...). Call read_file with ... start_line: ...]" footer.
// ENOENT -> success with JSON {path, exists:false, lines:[], total_lines:0};
// other errors -> sa_error with err.message.
// DEFECT: Buffer/utf8 decode + template strings -> byte buffer assembly;
// DEFECT: try/catch(err.code) -> fs extern status codes.
fn nativeReadFile(path_ptr: ptr, path_len: u64, opts: &NativeReadFileOptions, policy: &SaVmPolicyConfig, cwd_ptr: ptr, cwd_len: u64, started_at: u64, res: &SaVmRunResult) -> void {
    res.stdout_len = 0;
    // body per flow above; all header/footer literals preserved as
    // STR_PTR/STR_LEN appends into res.stdout.
}

