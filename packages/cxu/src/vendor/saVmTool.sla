// --git-dir/--work-tree/--namespace/--super-prefix/--config-env with
// separate or = values, "--" terminator). Blocks: clean, revert, and
// reset with --hard (each with its explanatory reason); all else allowed.
fn checkGitSafety(args: &StrList, allowed: &bool, reason: &StrBuf) -> void {
    allowed = true;
    reason.len = 0;
}

