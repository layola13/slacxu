// fn isGitIgnored (lines 330-351): dirs in ALWAYS_EXCLUDED_DIRS are always
// ignored; otherwise last matching rule wins (negated flips).
fn isGitIgnored(name_ptr: ptr, name_len: u64, is_dir: bool, rules: &GitIgnoreRuleList, rel_ptr: ptr, rel_len: u64, has_rel: bool) -> bool {
    if is_dir {
        if alwaysExcludedDir(name_ptr, name_len) { return true; };
    };
    let ignored = false;
    let i: u64 = 0;
    while i < rules.count {
        // rule = rules[i]; dirOnly rules skip files; slash/anchored rules
        // test rel path, others test name; match sets ignored = !negated.
        i = i + 1;
    }
    return ignored;
}

