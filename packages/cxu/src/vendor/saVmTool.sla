// fn hasGlobMagic (lines 500-502): /[*?[]/ test.
fn hasGlobMagic(value_ptr: ptr, value_len: u64) -> bool {
    let i: u64 = 0;
    while i < value_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, value_ptr, i);
        if b == 42 { return true; };
        if b == 63 { return true; };
        if b == 91 { return true; };
        i = i + 1;
    }
    return false;
}

