// fn expandSaVmActionInput (lines 38-237): normalizes action aliases,
// sniffs write intent from record fields, coerces `parallel` JSON strings,
// rewrites run_bun / run_js / run_py / run_project_check / run_host inputs.
// DEFECT: dynamic object — input is a JSON text buffer; field sniffing and
// spread-rewrites are approximated with sa_json_* lookups and buffer edits.
// DEFECT: throw SaVmInputError -> returns status code 1 with error text in
// `err` buffer; 0 = ok (input rewritten in place in `input`).
fn expandSaVmActionInput(input: &JsonBuf, err: &StrBuf) -> i32 {
    // DEFECT: typeof/Array.isArray/JSON.parse dynamic checks approximated
    // by sa_json_* probes on the JSON buffer.
    let action_len: u64 = 0;
    // action = trim(lower(input.action)) when string, else ""
    // parallel coercion via normalizeSaVmParallelTasks (saVmRequest.sla);
    // on !ok the TS throws SaVmInputError(parsed.error).
    // Intent sniffing: hasOldText (old_text/oldText/old_string/oldString/old
    // string fields), hasBody (content/contents/text/body/data present),
    // hasPatch (patch/diff strings), hasPath (path string, no source).
    // sniffedAction = edit_file|apply_patch|write_file|read_file; written
    // back into the buffer when action was empty.
    // read_many/read_files: files aliases (paths/filenames/file_list/
    // fileList/path/file, comma string, "[...]" JSON string) normalized.
    // split_stage/split_refine/split_repair/split_status/split_plan:
    // sessionId->session_id, moduleName->module_name, tasks->ops,
    // file->path aliases normalized.
    // Native pass-through actions (read_lines, read_file_tail/tail_file/
    // tail, find/find_files/list_files, write/write_file, edit/edit_file)
    // return input unchanged.
    // run_bun branch: subcommand/args/filter/test_file/path normalization,
    // returns {action:"run_bun", subcommand, args}.
    // run_js family (run_js/exec_js/js/javascript/node/bun/run_node/
    // exec_node/exec_bun/eval_js): source = source||content, error when
    // empty, returns {language:"js", source}.
    // run_py family (run_py/run_python/exec_py/py/python): same with "py".
    // run_project_check/project_check/run_bun_profile: action rewritten,
    // source defaults to "// run_project_check".
    // run_host/exec_host/host: action rewritten to "run_host".
    return 0;
}

// Constants (lines 239-244).
// MAX_SOURCE_BYTES = 512 * 1024; MAX_STDOUT_BYTES = 512 * 1024;
// MAX_STDERR_BYTES = 128 * 1024; MAX_ACTIVE_SA_VM_PROCESSES = 2.
// DEFAULT_LIMITS  = { fuel: 1000000, deadline_ms: 15000,
//   mem_cap_bytes: 128*1024*1024, max_call_depth: 50000 }
// LIMIT_CEILINGS  = { fuel: 100000000, deadline_ms: 600000,
//   mem_cap_bytes: 1073741824, max_call_depth: 1000000 }
struct SaVmLimits {
    fuel: u64,
    deadline_ms: u64,
    mem_cap_bytes: u64,
    max_call_depth: u64,
}

fn defaultLimits(out: &SaVmLimits) -> void {
    out.fuel = 1000000;
    out.deadline_ms = 15000;
    out.mem_cap_bytes = 134217728;
    out.max_call_depth = 50000;
}

fn limitCeilings(out: &SaVmLimits) -> void {
    out.fuel = 100000000;
    out.deadline_ms = 600000;
    out.mem_cap_bytes = 1073741824;
    out.max_call_depth = 1000000;
}

// fn resolveTimeoutMs (lines 245-262): timeout_ms wins; timeout <= 300 is
// seconds; result clamped to [50, 300000], default defaultMs (15000).
fn resolveTimeoutMs(has_timeout_ms: bool, timeout_ms: f64, has_timeout: bool, timeout: f64, default_ms: u64) -> u64 {
    let val: f64 = 0.0;
    let have = false;
    if has_timeout_ms {
        val = timeout_ms;
        have = true;
    } else {
        if has_timeout {
            if timeout <= 300.0 { val = timeout * 1000.0; } else { val = timeout; };
            have = true;
        };
    };
    if !have { return default_ms; };
    let rounded: u64 = val as u64;
    if rounded < 50 { return 50; };
    if rounded > 300000 { return 300000; };
    return rounded;
}

