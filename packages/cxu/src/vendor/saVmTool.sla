// fn paginateItems<T> (lines 420-434).
// DEFECT: generic <T> — SLA has no generics; items are an index range over
// the caller's array, page slice expressed as [slice_off, slice_len).
fn paginateItems(total: u64, pg: &ResolvedPagination, slice_off: &u64, slice_len: &u64, total_pages: &u64, has_next: &bool, has_prev: &bool) -> void {
    total_pages = 0;
    if total > 0 { total_pages = (total + pg.page_size - 1) / pg.page_size; };
    slice_off = pg.offset;
    slice_len = 0;
    if pg.offset < total {
        let avail: u64 = total - pg.offset;
        if avail < pg.page_size { slice_len = avail; } else { slice_len = pg.page_size; };
    };
    has_next = pg.offset + pg.page_size < total;
    has_prev = pg.offset > 0;
}

// fn resolveMaxFileBytes (lines 436-441).
fn resolveMaxFileBytes(is_num: bool, value: f64, default_bytes: u64) -> u64 {
    if is_num {
        if value > 0.0 {
            let v: u64 = value as u64;
            if v < 1024 { v = 1024; };
            if v > 20971520 { v = 20971520; };
            return v;
        };
    };
    return default_bytes;
}

