// fn clampInt (lines 359-362).
fn clampInt(is_num: bool, value: f64, fallback: u64, min_v: u64, max_v: u64) -> u64 {
    let num: u64 = fallback;
    if is_num { num = value as u64; };
    if num < min_v { return min_v; };
    if num > max_v { return max_v; };
    return num;
}

