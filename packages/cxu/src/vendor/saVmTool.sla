// DEFECT: Record<enum, number> -> weight lookup function.
// ---------------------------------------------------------------------------
fn noteLevelWeight(level: u64) -> u64 {
    // 0=low 1=normal 2=important 3=critical (NotePriorityLevel as ordinal)
    if level == 0 { return 1; };
    if level == 2 { return 3; };
    if level == 3 { return 4; };
    return 2;
}

