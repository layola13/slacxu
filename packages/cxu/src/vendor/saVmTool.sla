// fn containsNulByte (lines 472-478): scans first 4096 chars for U+0000.
fn containsNulByte(text_ptr: ptr, text_len: u64) -> bool {
    let scan: u64 = text_len;
    if scan > 4096 { scan = 4096; };
    let i: u64 = 0;
    while i < scan {
        let b: u8 = 0;
        PTR_BYTE_AT(b, text_ptr, i);
        if b == 0 { return true; };
        i = i + 1;
    }
    return false;
}

