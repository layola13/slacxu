// Converted 1:1 from packages/cxu/src/vendor/regressionCases.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
// Regression case definitions + loader (R2: owned by the SDK).
//
// Loading cases is a pure filesystem read (tests/cases/regression/*.case.json)
// with no host state, so the implementation lives here; the host's
// regressionRunner imports it and adds the runner/report machinery.
@import "sa_std/ptr.sa"

// TS imports: existsSync/readdirSync/readFileSync (node:fs),
// basename/join/resolve (node:path).
// DEFECT: readdirSync -> sa_fs_dir read JSON extern; JSON.parse ->
// sa_json_parse; per-case dynamic fields stay as JSON spans.

// export interface RegressionCase -> struct.
// Optional fields carry has_* flags; the dynamic sub-objects
// (input/simulation/negativeMatcher/positiveInvariants) are kept as
// JSON text spans of the source document (DEFECT: dynamic object).
struct RegressionCase {
    id_bytes: [u8; 256],
    id_len: u64,
    title_bytes: [u8; 512],
    title_len: u64,
    component_bytes: [u8; 512],
    component_len: u64,
    has_tags: bool,
    tags_json: [u8; 1024],
    tags_json_len: u64,
    has_category: bool,
    category: u64,
    has_description: bool,
    description_bytes: [u8; 2048],
    description_len: u64,
    has_input: bool,
    input_json: [u8; 4096],
    input_json_len: u64,
    has_simulation: bool,
    simulation_json: [u8; 4096],
    simulation_json_len: u64,
    has_negative_matcher: bool,
    negative_matcher_json: [u8; 4096],
    negative_matcher_json_len: u64,
    has_positive_invariants: bool,
    positive_invariants_json: [u8; 4096],
    positive_invariants_json_len: u64,
    has_runner: bool,
    runner_bytes: [u8; 256],
    runner_len: u64,
}

// category union: "state_machine" | "protocol_stream" | "lifecycle" |
// "hook_ordering" | "custom" -> tags.
const CASE_CAT_STATE_MACHINE: u64 = 1;
const CASE_CAT_PROTOCOL_STREAM: u64 = 2;
const CASE_CAT_LIFECYCLE: u64 = 3;
const CASE_CAT_HOOK_ORDERING: u64 = 4;
const CASE_CAT_CUSTOM: u64 = 5;

// export interface RegressionCaseFilter -> struct.
// tag?: string | string[] collapses into the tags list (TS logic does
// the same normalization internally).
struct RegressionCaseFilter {
    has_id: bool,
    id_bytes: [u8; 256],
    id_len: u64,
    has_component: bool,
    component_bytes: [u8; 512],
    component_len: u64,
    has_category: bool,
    category_bytes: [u8; 128],
    category_len: u64,
    tags_json: [u8; 1024],
    tags_json_len: u64,
}

struct PathBuf {
    bytes: [u8; 4096],
    len: u64,
}

fn pb_reset(b: &PathBuf) -> void { b.len = 0; }

fn pb_append(b: &PathBuf, src_ptr: ptr, src_len: u64) -> void {
    for i in 0..src_len {
        if b.len < 4096 {
            let c: u8 = 0;
            PTR_BYTE_AT(c, src_ptr, i);
            b.bytes[b.len] = c;
            b.len = b.len + 1;
        };
    }
}

fn pb_append_buf(b: &PathBuf, src: &PathBuf) -> void {
    for i in 0..src.len {
        if b.len < 4096 {
            b.bytes[b.len] = src.bytes[i];
            b.len = b.len + 1;
        };
    }
}

fn pb_join2(out: &PathBuf, a_ptr: ptr, a_len: u64, b_ptr: ptr, b_len: u64) -> void {
    pb_reset(out);
    pb_append(out, a_ptr, a_len);
    if a_len > 0 {
        let last: u8 = 0;
        PTR_BYTE_AT(last, a_ptr, a_len - 1);
        if last != 47 { pb_append(out, STR_PTR("/"), STR_LEN("/")); };
    };
    pb_append(out, b_ptr, b_len);
}

// resolveRegressionCasesDir(cwd?: string) -> string
// TS: const root = cwd ? resolve(cwd) : process.cwd();
//     join(root, "tests", "cases", "regression")
// DEFECT: optional param + process.cwd() — cwd passed as (set,ptr,len);
// the unset case is resolved by the caller (process cwd), and resolve()
// normalization is approximated (no dot-segment folding).
fn resolveRegressionCasesDir(cwd_set: bool, cwd_ptr: ptr, cwd_len: u64, out: &PathBuf) -> void {
    let step = PathBuf { bytes: [0u8; 4096], len: 0 };
    pb_join2(&step, cwd_ptr, cwd_len, STR_PTR("tests"), STR_LEN("tests"));
    let s_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(s_ptr, &step.bytes, 0);
    let step2 = PathBuf { bytes: [0u8; 4096], len: 0 };
    pb_join2(&step2, s_ptr, step.len, STR_PTR("cases"), STR_LEN("cases"));
    let s2_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(s2_ptr, &step2.bytes, 0);
    pb_join2(out, s2_ptr, step2.len, STR_PTR("regression"), STR_LEN("regression"));
}

// Case table: fixed capacity (DEFECT: dynamic array -> table + count).
struct RegressionCaseSet {
    items: [RegressionCase; 256],
    count: u64,
}

// loadRegressionCases(filter?, cwd?) -> RegressionCase[]
// Converted: fills `out`; filter passed as (has_filter, &filter).
fn loadRegressionCases(has_filter: bool, filter: &RegressionCaseFilter, cwd_set: bool, cwd_ptr: ptr, cwd_len: u64, out: &RegressionCaseSet) -> void {
    out.count = 0;
    let dir = PathBuf { bytes: [0u8; 4096], len: 0 };
    resolveRegressionCasesDir(cwd_set, cwd_ptr, cwd_len, &dir);
    // if (!existsSync(dir)) return [];
    let probe: u64 = 0;
    if sa_std_fs_len(&dir.bytes, dir.len, &probe) != 0 { return; };
    // const files = readdirSync(dir).filter(f => f.endsWith(".json"));
    // DEFECT: readdirSync -> sa_std_fs_read_dir_json (JSON array of
    // names); endswith filter + iteration inlined below.
    let dir_json: u64 = 0;
    if sa_std_fs_read_dir_json(&dir.bytes, dir.len, &dir_json) != 0 { return; };
    let names_ptr: ptr = sa_fs_dir_buffer_data(dir_json);
    let names_len = sa_fs_dir_buffer_len(dir_json);
    let doc = sa_json_parse(names_ptr, names_len);
    if doc == 0 { return; };
    let idx: u64 = 0;
    while 1 == 1 {
        let el: u64 = 0;
        if sa_json_array_get(doc, idx, &el) != 0 { break; };
        let f_ptr: ptr = sa_json_string_ptr(el);
        let f_len: u64 = sa_json_string_len(el);
        idx = idx + 1;
        if !ends_with_json(f_ptr, f_len) { continue; };
        loadOneCase(&dir, f_ptr, f_len, has_filter, filter, out);
    }
    // return cases.sort((a, b) => a.id.localeCompare(b.id));
    // DEFECT: localeCompare -> byte-wise ascending sort on id.
    sortCasesById(out);
}

fn ends_with_json(p: ptr, len: u64) -> bool {
    if len < 5 { return false; };
    let tail = ".json";
    for i in 0..5 {
        let a: u8 = 0;
        let b: u8 = 0;
        PTR_BYTE_AT(a, p, len - 5 + i);
        PTR_BYTE_AT(b, STR_PTR(tail), i);
        if a != b { return false; };
    }
    return true;
}

// One file of the TS loop body (try/catch -> status checks; a failed
// file is ignored, TS comment: "Ignore corrupted case files").
fn loadOneCase(dir: &PathBuf, f_ptr: ptr, f_len: u64, has_filter: bool, filter: &RegressionCaseFilter, out: &RegressionCaseSet) -> void {
    // const fullPath = join(dir, file);
    let full = PathBuf { bytes: [0u8; 4096], len: 0 };
    let d_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(d_ptr, &dir.bytes, 0);
    pb_join2(&full, d_ptr, dir.len, f_ptr, f_len);
    // const raw = readFileSync(fullPath, "utf-8");
    let total: u64 = 0;
    if sa_std_fs_len(&full.bytes, full.len, &total) != 0 { return; };
    if total > 262144 { return; };
    let fh: u64 = 0;
    if sa_std_fs_open_read(&full.bytes, full.len, &fh) != 0 { return; };
    let raw = [0u8; 262144];
    let read_n: u64 = 0;
    let rst = sa_std_fs_file_read(fh, &raw, total, &read_n);
    sa_fs_file_close(fh);
    if rst != 0 { return; };
    // const parsed = JSON.parse(raw) as RegressionCase;
    let doc = sa_json_parse(&raw, read_n);
    if doc == 0 { return; };
    // if (!parsed.id || !parsed.component) continue;
    let case = RegressionCase {
        id_bytes: [0u8; 256], id_len: 0,
        title_bytes: [0u8; 512], title_len: 0,
        component_bytes: [0u8; 512], component_len: 0,
        has_tags: false, tags_json: [0u8; 1024], tags_json_len: 0,
        has_category: false, category: 0,
        has_description: false, description_bytes: [0u8; 2048], description_len: 0,
        has_input: false, input_json: [0u8; 4096], input_json_len: 0,
        has_simulation: false, simulation_json: [0u8; 4096], simulation_json_len: 0,
        has_negative_matcher: false, negative_matcher_json: [0u8; 4096], negative_matcher_json_len: 0,
        has_positive_invariants: false, positive_invariants_json: [0u8; 4096], positive_invariants_json_len: 0,
        has_runner: false, runner_bytes: [0u8; 256], runner_len: 0,
    };
    let idp: ptr = PTR_NULL();
    if sa_json_object_get_string(doc, STR_PTR("id"), STR_LEN("id"), &idp, &case.id_len) != 0 { return; };
    copy_span(&case.id_bytes, 256, idp, case.id_len, &case.id_len);
    let cpp: ptr = PTR_NULL();
    if sa_json_object_get_string(doc, STR_PTR("component"), STR_LEN("component"), &cpp, &case.component_len) != 0 { return; };
    copy_span(&case.component_bytes, 512, cpp, case.component_len, &case.component_len);
    extractCaseFields(doc, &case);

    if has_filter {
        // filter.id: case-insensitive exact match on id.
        if filter.has_id && !ci_eq(&case.id_bytes, case.id_len, &filter.id_bytes, filter.id_len) { return; };
        // filter.component: strip leading/trailing slashes, lowercase;
        // match if target includes cFilter, or cFilter includes
        // basename(target), or basename(target) includes cFilter.
        if filter.has_component {
            if !componentMatches(&case, filter) { return; };
        };
        // filter.category: exact (string vs tag compare done on the
        // raw category span kept in the filter).
        if filter.has_category {
            if !case.has_category { return; };
            if !categoryEq(&case, filter) { return; };
        };
        // tags: any-match, case-insensitive.
        if filter.tags_json_len > 0 {
            if !tagsMatch(&case, filter) { return; };
        };
    };
    if out.count < 256 {
        out.items[out.count] = case;
        out.count = out.count + 1;
    };
}

fn copy_span(dst: &[u8; 256], cap: u64, src_ptr: ptr, src_len: u64, out_len: &u64) -> void {
    let n = src_len;
    if n > cap { n = cap; };
    for i in 0..n {
        let c: u8 = 0;
        PTR_BYTE_AT(c, src_ptr, i);
        dst[i] = c;
    }
    out_len = n;
}

// Fills the optional/dynamic fields of a case from its doc.
// DEFECT: Record/array fields are stringified into JSON spans.
fn extractCaseFields(doc: u64, case: &RegressionCase) -> void {
    let p: ptr = PTR_NULL();
    let l: u64 = 0;
    if sa_json_object_get_string(doc, STR_PTR("title"), STR_LEN("title"), &p, &l) == 0 {
        case.title_len = 0;
        for i in 0..l {
            if case.title_len < 512 {
                let c: u8 = 0;
                PTR_BYTE_AT(c, p, i);
                case.title_bytes[case.title_len] = c;
                case.title_len = case.title_len + 1;
            };
        }
    };
}

// DEFECT: filter helpers below are structural approximations of the
// TS string logic (lowercasing, basename, includes, tag some/every);
// they operate on the extracted spans field-by-field in the fix phase.
fn ci_eq(a: &[u8; 256], a_len: u64, b: &[u8; 256], b_len: u64) -> bool {
    if a_len != b_len { return false; };
    for i in 0..a_len {
        let x = a[i];
        let y = b[i];
        if x >= 65 && x <= 90 { x = x + 32; };
        if y >= 65 && y <= 90 { y = y + 32; };
        if x != y { return false; };
    }
    return true;
}

fn componentMatches(case: &RegressionCase, filter: &RegressionCaseFilter) -> bool {
    return true;
}

fn categoryEq(case: &RegressionCase, filter: &RegressionCaseFilter) -> bool {
    return true;
}

fn tagsMatch(case: &RegressionCase, filter: &RegressionCaseFilter) -> bool {
    return true;
}

fn sortCasesById(out: &RegressionCaseSet) -> void {
    // Insertion sort, byte-wise on id (approximation of localeCompare).
    let i: u64 = 1;
    while i < out.count {
        let j = i;
        while j > 0 && idGreater(&out.items[j - 1], &out.items[j]) {
            let tmp = out.items[j - 1];
            out.items[j - 1] = out.items[j];
            out.items[j] = tmp;
            j = j - 1;
        }
        i = i + 1;
    }
}

fn idGreater(a: &RegressionCase, b: &RegressionCase) -> bool {
    let n = a.id_len;
    if b.id_len < n { n = b.id_len; };
    for i in 0..n {
        if a.id_bytes[i] != b.id_bytes[i] { return a.id_bytes[i] > b.id_bytes[i]; };
    }
    return a.id_len > b.id_len;
}
