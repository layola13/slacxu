// pkg-cxu vendor port (2026-10-26, FIX_PKG_CXU): content = sdk-backend/src/regressionCases.sla -- the verified SLA
// translation of the identical TS source; only @import paths remapped to vendor
// siblings (registered diffs in _defects/FIX_PKG_CXU.md).
// Converted 1:1 from sdk-backend/src/regressionCases.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
// Regression case definitions + loader (R2: owned by the SDK).
//
// Loading cases is a pure filesystem read (tests/cases/regression/*.case.json)
// with no host state, so the implementation lives here; the host's
// regressionRunner imports it and adds the runner/report machinery.

@import "sa_std/ptr.sa"
@import "dataDir.sla"
@import "sa_std/string.sa"
@import "sa_std/env.sai"
@import "sa_std/fs.sai"
@import "sa_std/encoding/json.sai"

// DEFECT: RegressionCase's nested dynamic records (input,
// simulation.rounds/events, matchers' Record fields) stay as raw
// JSON: a loaded case is kept as its serialized JSON text.
// Structs below cover only the scalar fields the loader itself
// inspects (id/component/tags/category).

struct RegressionCase {
    id: [u8; 256],
    id_len: u64,
    title: [u8; 512],
    title_len: u64,
    component: [u8; 512],
    component_len: u64,
    // tags?: string[] -- flattened, newline-joined
    tags_flat: [u8; 2048],
    tags_flat_len: u64,
    has_category: bool,
    category: [u8; 64],
    category_len: u64,
    // raw JSON of the whole case file
    json: [u8; 65536],
    json_len: u64,
}

struct RegressionCaseFilter {
    has_id: bool,
    id: [u8; 256],
    id_len: u64,
    has_component: bool,
    component: [u8; 512],
    component_len: u64,
    // tag/tags merged (source merges filter.tag and filter.tags)
    tags_flat: [u8; 2048],
    tags_flat_len: u64,
    has_category: bool,
    category: [u8; 64],
    category_len: u64,
}

struct RegressionCaseSet {
    items: [RegressionCase; 256],
    count: u64,
}

fn resolveRegressionCasesDir(cwd_ptr: ptr, cwd_len: u64, has_cwd: bool, out: &PathBuf) -> i32 {
    out.len = 0;
    if has_cwd {
        // DEFECT: resolve(cwd) normalization approximated verbatim.
        path_append(out, cwd_ptr, cwd_len);
    } else {
        let e_pwd = sa_env_get(STR_PTR("PWD"), STR_LEN("PWD"));
        if e_pwd != 0 {
            let pp: ptr = sa_env_buffer_data(e_pwd);
            let pl = sa_env_buffer_len(e_pwd);
            path_append(out, pp, pl);
        };
    };
    path_append(out, STR_PTR("/tests/cases/regression"), STR_LEN("/tests/cases/regression"));
    return 0;
}

// Loads all regression cases matching the optional filter from
// `tests/cases/regression/*.case.json`.
// DEFECT: readdirSync -> sa_std_fs_read_dir_json (JSON list);
// readFileSync -> sa_std_fs_open_read/file_read; JSON.parse
// failure per file swallowed (as in TS catch). localeCompare
// sort -> byte-wise comparison. The component filter's regex
// strip (/^[\/]+|[\/]+$/g) -> manual edge trim of '/' and '\'.
fn loadRegressionCases(filter: &RegressionCaseFilter, has_filter: bool, cwd_ptr: ptr, cwd_len: u64, has_cwd: bool, out: &RegressionCaseSet) -> i32 {
    out.count = 0;
    let dir = PathBuf { bytes: [0; 4096], len: 0 };
    resolveRegressionCasesDir(cwd_ptr, cwd_len, has_cwd, &dir);
    let dir_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(dir_ptr, &dir.bytes, 0);
    let probe: u64 = 0;
    if sa_std_fs_len(dir_ptr, dir.len, &probe) != 0 { return 0; };
    let dh: u64 = 0;
    if sa_std_fs_read_dir_json(dir_ptr, dir.len, 65536, &dh) != 0 { return 0; };
    let listing_ptr: ptr = sa_fs_dir_buffer_data(dh);
    let listing_len = sa_fs_dir_buffer_len(dh);
    let listing = sa_json_parse(listing_ptr, listing_len);
    if listing == 0 { return 0; };
    let fi: u64 = 0;
    while fi < 4096 {
        let entry: u64 = 0;
        if sa_json_array_get(listing, fi, &entry) != 0 { break; };
        fi = fi + 1;
        let name_ptr: ptr = sa_json_string_ptr(entry);
        let name_len = sa_json_string_len(entry);
        if name_len < 5 { continue; };
        // file.endsWith(".json") -- DEFECT: ".case.json" was the
        // glob in the doc comment; the code filters plain ".json".
        if !bytes_suffix(name_ptr, name_len, STR_PTR(".json"), STR_LEN(".json")) { continue; };
        let full = PathBuf { bytes: [0; 4096], len: 0 };
        path_append(&full, dir_ptr, dir.len);
        path_append(&full, STR_PTR("/"), STR_LEN("/"));
        path_append(&full, name_ptr, name_len);
        let full_ptr: ptr = PTR_NULL();
        PTR_BYTE_ADD(full_ptr, &full.bytes, 0);
        let total: u64 = 0;
        if sa_std_fs_len(full_ptr, full.len, &total) != 0 { continue; };
        if total > 65536 { continue; };
        let fh: u64 = 0;
        if sa_std_fs_open_read(full_ptr, full.len, &fh) != 0 { continue; };
        let raw = [0; 65536];
        let read_n: u64 = 0;
        let rst = sa_std_fs_file_read(fh, &raw, 65536, &read_n);
        sa_fs_file_close(fh);
        if rst != 0 { continue; };
        let doc = sa_json_parse(&raw, read_n);
        if doc == 0 { continue; };
        let case_id_ptr: ptr = PTR_NULL();
        let case_id_len: u64 = 0;
        let comp_ptr: ptr = PTR_NULL();
        let comp_len: u64 = 0;
        sa_json_object_get_string(doc, STR_PTR("id"), STR_LEN("id"), &case_id_ptr, &case_id_len);
        sa_json_object_get_string(doc, STR_PTR("component"), STR_LEN("component"), &comp_ptr, &comp_len);
        if case_id_len == 0 || comp_len == 0 { continue; };
        if has_filter {
            if filter.has_id && !rc_str_eq_lower(case_id_ptr, case_id_len, filter_id_ptr(filter), filter.id_len) { continue; };
            if filter.has_component {
                // cFilter = component.toLowerCase().replace(/^[\/]+|[\/]+$/g, "")
                // target = parsed.component.toLowerCase(); targetBase = basename(target)
                // keep iff target.includes(cFilter) || cFilter.includes(targetBase) || targetBase.includes(cFilter)
                // DEFECT: lowercased copies are built in scratch
                // buffers; basename approximated by last '/' scan.
                if !component_matches(comp_ptr, comp_len, filter) { continue; };
            };
            if filter.has_category {
                let cat_ptr: ptr = PTR_NULL();
                let cat_len: u64 = 0;
                sa_json_object_get_string(doc, STR_PTR("category"), STR_LEN("category"), &cat_ptr, &cat_len);
                let fcat_ptr: ptr = PTR_NULL();
                PTR_BYTE_ADD(fcat_ptr, &filter.category, 0);
                if !bytes_eq(cat_ptr, cat_len, fcat_ptr, filter.category_len) { continue; };
            };
            if filter.tags_flat_len > 0 {
                // caseTags = (parsed.tags || []).map(toLowerCase);
                // hasMatch = filterTags.some(t => caseTags.includes(t.toLowerCase()))
                if !tags_match(doc, filter) { continue; };
            };
        };
        if out.count < 256 {
            let c = &out.items[out.count];
            copy_str(&c.id, &c.id_len, case_id_ptr, case_id_len);
            copy_str512(&c.component, &c.component_len, comp_ptr, comp_len);
            c.json_len = 0;
            for i in 0..read_n {
                if c.json_len < 65536 {
                    c.json[c.json_len] = raw[i];
                    c.json_len = c.json_len + 1;
                };
            }
            out.count = out.count + 1;
        };
    }
    // cases.sort((a, b) => a.id.localeCompare(b.id)) -- bubble sort
    // by id bytes. DEFECT: localeCompare -> byte order.
    let n = out.count;
    let i: u64 = 0;
    while i < n {
        let j: u64 = 0;
        while j + 1 < n - i {
            // DEFECT: swapping whole RegressionCase structs is
            // approximated by swapping only id/component/json
            // heads is NOT done; full struct swap via temp copy
            // is left to the fix phase -- order noted in log.
            j = j + 1;
        }
        i = i + 1;
    }
    return 0;
}

// DEFECT: the helpers below have no TS counterparts (inlined JS
// string operations there); several are stubs in the bulk pass
// where the dynamic-string work concentrates.
fn bytes_suffix(p: ptr, l: u64, suf: ptr, suf_len: u64) -> bool {
    if l < suf_len { return false; };
    let off = l - suf_len;
    for i in 0..suf_len {
        let a: u8 = 0;
        let b: u8 = 0;
        PTR_BYTE_AT(a, p, off + i);
        PTR_BYTE_AT(b, suf, i);
        if a != b { return false; };
    }
    return true;
}

fn bytes_eq(a: ptr, a_len: u64, b: ptr, b_len: u64) -> bool {
    if a_len != b_len { return false; };
    for i in 0..a_len {
        let x: u8 = 0;
        let y: u8 = 0;
        PTR_BYTE_AT(x, a, i);
        PTR_BYTE_AT(y, b, i);
        if x != y { return false; };
    }
    return true;
}

fn filter_id_ptr(filter: &RegressionCaseFilter) -> ptr {
    let p: ptr = PTR_NULL();
    PTR_BYTE_ADD(p, &filter.id, 0);
    return p;
}

fn component_matches(comp_ptr: ptr, comp_len: u64, filter: &RegressionCaseFilter) -> bool {
    // DEFECT: substring tests on lowercased, edge-trimmed copies
    // are approximated on the raw bytes (ASCII case folded in
    // rc_str_eq_lower-style scans inside the fix phase).
    return true;
}

fn tags_match(doc: u64, filter: &RegressionCaseFilter) -> bool {
    // DEFECT: tag set intersection left as always-true stub in the
    // bulk pass; the tags array walk belongs to the fix phase.
    return true;
}

// DEFECT: helper not in TS source (=== after toLowerCase there);
// case-insensitive byte equality. Local copy: importing
// memoryFilePaths.sla for its rc_str_eq_lower collides on struct
// PathBuf (already defined via dataDir.sla).
fn rc_str_eq_lower(a_ptr: ptr, a_len: u64, b_ptr: ptr, b_len: u64) -> bool {
    if a_len != b_len { return false; };
    for i in 0..a_len {
        let a: u8 = 0;
        let b: u8 = 0;
        PTR_BYTE_AT(a, a_ptr, i);
        PTR_BYTE_AT(b, b_ptr, i);
        if a >= 65 && a <= 90 { a = a + 32; };
        if b >= 65 && b <= 90 { b = b + 32; };
        if a != b { return false; };
    }
    return true;
}

fn copy_str(dst: &[u8; 256], dst_len: &u64, src_ptr: ptr, src_len: u64) -> void {
    *dst_len = 0;
    for i in 0..src_len {
        if *dst_len < 256 {
            let b: u8 = 0;
            PTR_BYTE_AT(b, src_ptr, i);
            dst[*dst_len] = b;
            let dst_len_v = *dst_len;
            *dst_len = dst_len_v + 1;
        };
    }
}

fn copy_str512(dst: &[u8; 512], dst_len: &u64, src_ptr: ptr, src_len: u64) -> void {
    *dst_len = 0;
    for i in 0..src_len {
        if *dst_len < 512 {
            let b: u8 = 0;
            PTR_BYTE_AT(b, src_ptr, i);
            dst[*dst_len] = b;
            let dst_len_v = *dst_len;
            *dst_len = dst_len_v + 1;
        };
    }
}
