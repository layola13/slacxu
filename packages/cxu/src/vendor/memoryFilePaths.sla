// Converted 1:1 from packages/cxu/src/vendor/memoryFilePaths.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
// Workspace/global memory file paths (R2: owned by the SDK).
//
// Pure path resolution: the data dir comes from CODEX_UI_DATA_DIR
// or ~/.codex-ultra; workspace files are keyed by a hash of the
// normalized workspace path. Extracted from the host's saVmTool,
// which re-exports them.
@import "sa_std/ptr.sa"
@import "dataDir.sla"

// TS imports: createHash (node:crypto), homedir (node:os),
// join/resolve/sep (node:path).
// DEFECT: sha256 hex digest — sa_std has sha256 in the net.sai surface
// (net batch), approximated here by a declared extern; hex encoding
// done byte-wise below.

struct MemPathBuf {
    bytes: [0u8; 4096],
    len: u64,
}

fn mp_append(b: &MemPathBuf, src_ptr: ptr, src_len: u64) -> void {
    for i in 0..src_len {
        if b.len < 4096 {
            let c: u8 = 0;
            PTR_BYTE_AT(c, src_ptr, i);
            b.bytes[b.len] = c;
            b.len = b.len + 1;
        };
    }
}

fn mp_append_buf(b: &MemPathBuf, src: &MemPathBuf) -> void {
    for i in 0..src.len {
        if b.len < 4096 {
            b.bytes[b.len] = src.bytes[i];
            b.len = b.len + 1;
        };
    }
}

fn mp_join3(out: &MemPathBuf, a: &MemPathBuf, b_ptr: ptr, b_len: u64, c_ptr: ptr, c_len: u64) -> void {
    out.len = 0;
    mp_append_buf(out, a);
    if out.len > 0 && out.bytes[out.len - 1] != 47 { mp_append(out, STR_PTR("/"), STR_LEN("/")); };
    mp_append(out, b_ptr, b_len);
    mp_append(out, STR_PTR("/"), STR_LEN("/"));
    mp_append(out, c_ptr, c_len);
}

// baseDataDir: process.env.CODEX_UI_DATA_DIR?.trim() || join(homedir(), ".codex-ultra")
// Note the TS here does NOT use codexUiDataDir's legacy migration; it is
// the inline two-liner, preserved as written.
fn baseDataDir(cfg_set: bool, cfg_ptr: ptr, cfg_len: u64, home_ptr: ptr, home_len: u64, out: &MemPathBuf) -> void {
    if cfg_set && trimmed_len(cfg_ptr, cfg_len) > 0 {
        out.len = 0;
        mp_append(out, cfg_ptr, cfg_len);
        return;
    };
    out.len = 0;
    mp_append(out, home_ptr, home_len);
    if out.len > 0 && out.bytes[out.len - 1] != 47 { mp_append(out, STR_PTR("/"), STR_LEN("/")); };
    mp_append(out, STR_PTR(".codex-ultra"), STR_LEN(".codex-ultra"));
}

// resolveGlobalMemoryFilePath() -> string  (into out)
// join(baseDataDir, "workspace-memory", "global-memory.json")
fn resolveGlobalMemoryFilePath(cfg_set: bool, cfg_ptr: ptr, cfg_len: u64, home_ptr: ptr, home_len: u64, out: &MemPathBuf) -> void {
    let base = MemPathBuf { bytes: [0u8; 4096], len: 0 };
    baseDataDir(cfg_set, cfg_ptr, cfg_len, home_ptr, home_len, &base);
    mp_join3(out, &base, STR_PTR("workspace-memory"), STR_LEN("workspace-memory"), STR_PTR("global-memory.json"), STR_LEN("global-memory.json"));
}

// resolveWorkspaceMemoryFilePath(workspaceDir: string) -> string
// norm = resolve(workspaceDir).split(sep).join("/").toLowerCase()
// hash = sha256(norm) hex; join(base, "workspace-memory", `${hash}.json`)
// DEFECT: resolve()/sep/toLowerCase approximated (backslash -> slash,
// ASCII lowercase); template literal -> buffer assembly.
fn resolveWorkspaceMemoryFilePath(ws_ptr: ptr, ws_len: u64, cfg_set: bool, cfg_ptr: ptr, cfg_len: u64, home_ptr: ptr, home_len: u64, out: &MemPathBuf) -> void {
    let norm = MemPathBuf { bytes: [0u8; 4096], len: 0 };
    for i in 0..ws_len {
        let c: u8 = 0;
        PTR_BYTE_AT(c, ws_ptr, i);
        if c == 92 { c = 47; };
        if c >= 65 && c <= 90 { c = c + 32; };
        if norm.len < 4096 {
            norm.bytes[norm.len] = c;
            norm.len = norm.len + 1;
        };
    }
    // sha256 hex (64 chars)
    let hex = MemPathBuf { bytes: [0u8; 4096], len: 0 };
    sha256_hex(&norm, &hex);
    let name = MemPathBuf { bytes: [0u8; 4096], len: 0 };
    mp_append_buf(&name, &hex);
    mp_append(&name, STR_PTR(".json"), STR_LEN(".json"));
    let base = MemPathBuf { bytes: [0u8; 4096], len: 0 };
    baseDataDir(cfg_set, cfg_ptr, cfg_len, home_ptr, home_len, &base);
    let name_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(name_ptr, &name.bytes, 0);
    mp_join3(out, &base, STR_PTR("workspace-memory"), STR_LEN("workspace-memory"), name_ptr, name.len);
}

// DEFECT: sha256 extern stub — sa_std exposes sha256 (net.sai batch);
// hex digest written here as a placeholder loop over the digest bytes
// provided by the extern once wired.
fn sha256_hex(input: &MemPathBuf, out: &MemPathBuf) -> void {
    out.len = 0;
    let digest = [0u8; 32];
    let in_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(in_ptr, &input.bytes, 0);
    sa_std_sha256(in_ptr, input.len, &digest);
    let hexchars = "0123456789abcdef";
    for i in 0..32 {
        let b = digest[i];
        let hi: u8 = 0;
        let lo: u8 = 0;
        PTR_BYTE_AT(hi, STR_PTR(hexchars), (b / 16) as u64);
        PTR_BYTE_AT(lo, STR_PTR(hexchars), (b % 16) as u64);
        if out.len < 4096 { out.bytes[out.len] = hi; out.len = out.len + 1; };
        if out.len < 4096 { out.bytes[out.len] = lo; out.len = out.len + 1; };
    }
}

// TS: export type MemoryScope = "workspace" | "global"; -> tag
const MEMORY_SCOPE_WORKSPACE: u64 = 0;
const MEMORY_SCOPE_GLOBAL: u64 = 1;

// normalizeMemoryScope(raw: unknown) -> MemoryScope. Never throws.
// TS: v = (typeof raw === "string" ? raw : "").trim().toLowerCase();
// "global" | "user" | "all-projects" -> global, else workspace.
// DEFECT: unknown param -> (is_string, ptr, len) pair.
fn normalizeMemoryScope(is_string: bool, raw_ptr: ptr, raw_len: u64) -> u64 {
    if !is_string { return MEMORY_SCOPE_WORKSPACE; };
    // trim + lowercase into a scratch compare, byte-wise against the
    // three literals (lengths 6 / 4 / 12 after normalization).
    let lo: u64 = 0;
    let hi = raw_len;
    while lo < hi {
        let c: u8 = 0;
        PTR_BYTE_AT(c, raw_ptr, lo);
        if c != 32 && c != 9 && c != 10 && c != 13 { break; };
        lo = lo + 1;
    }
    while hi > lo {
        let c: u8 = 0;
        PTR_BYTE_AT(c, raw_ptr, hi - 1);
        if c != 32 && c != 9 && c != 10 && c != 13 { break; };
        hi = hi - 1;
    }
    let n = hi - lo;
    if n == 6 && lower_eq(raw_ptr, lo, STR_PTR("global"), 6) { return MEMORY_SCOPE_GLOBAL; };
    if n == 4 && lower_eq(raw_ptr, lo, STR_PTR("user"), 4) { return MEMORY_SCOPE_GLOBAL; };
    if n == 12 && lower_eq(raw_ptr, lo, STR_PTR("all-projects"), 12) { return MEMORY_SCOPE_GLOBAL; };
    return MEMORY_SCOPE_WORKSPACE;
}

fn lower_eq(p: ptr, off: u64, lit_ptr: ptr, lit_len: u64) -> bool {
    for i in 0..lit_len {
        let c: u8 = 0;
        PTR_BYTE_AT(c, p, off + i);
        if c >= 65 && c <= 90 { c = c + 32; };
        let d: u8 = 0;
        PTR_BYTE_AT(d, lit_ptr, i);
        if c != d { return false; };
    }
    return true;
}
