// Converted 1:1 from packages/cxu/src/vendor/dataDir.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
// Host data directory resolution (R2: owned by the SDK).
//
// A deterministic function of (env, home): CODEX_UI_DATA_DIR wins,
// "~" and "~/" expand against home, otherwise ~/.codex-ultra with a
// one-time legacy ~/.codex-react-ui migration. No host state, so the
// implementation lives in the SDK and the host re-exports it.
@import "sa_std/ptr.sa"

// TS imports: existsSync/renameSync (node:fs), homedir (node:os),
// join/resolve (node:path), process.env.
// DEFECT: node:path join/resolve approximated by buf path joins below
// (no "." / ".." normalization except resolve's absolutize step);
// existsSync/renameSync map to sa_std fs externs noted inline.

struct PathBuf {
    bytes: [u8; 4096],
    len: u64,
}

fn path_reset(b: &PathBuf) -> void { b.len = 0; }

fn path_append(b: &PathBuf, src_ptr: ptr, src_len: u64) -> void {
    for i in 0..src_len {
        if b.len < 4096 {
            let c: u8 = 0;
            PTR_BYTE_AT(c, src_ptr, i);
            b.bytes[b.len] = c;
            b.len = b.len + 1;
        };
    }
}

fn path_append_buf(b: &PathBuf, src: &PathBuf) -> void {
    for i in 0..src.len {
        if b.len < 4096 {
            b.bytes[b.len] = src.bytes[i];
            b.len = b.len + 1;
        };
    }
}

// node:path join(a, b): a + "/" + b (no trailing-slash handling beyond
// the common case; TS join also normalizes — approximation).
fn path_join2(out: &PathBuf, a_ptr: ptr, a_len: u64, b_ptr: ptr, b_len: u64) -> void {
    path_reset(out);
    path_append(out, a_ptr, a_len);
    if a_len > 0 {
        let last: u8 = 0;
        PTR_BYTE_AT(last, a_ptr, a_len - 1);
        if last != 47 { path_append(out, STR_PTR("/"), STR_LEN("/")); };
    };
    path_append(out, b_ptr, b_len);
}

fn path_eq_str(b: &PathBuf, s_ptr: ptr, s_len: u64) -> bool {
    if b.len != s_len { return false; };
    for i in 0..s_len {
        let c: u8 = 0;
        PTR_BYTE_AT(c, s_ptr, i);
        if b.bytes[i] != c { return false; };
    }
    return true;
}

fn path_starts_with(b: &PathBuf, s_ptr: ptr, s_len: u64) -> bool {
    if b.len < s_len { return false; };
    for i in 0..s_len {
        let c: u8 = 0;
        PTR_BYTE_AT(c, s_ptr, i);
        if b.bytes[i] != c { return false; };
    }
    return true;
}

// TS: configured?.trim() — emptiness after trimming whitespace.
fn trimmed_len(p: ptr, len: u64) -> u64 {
    let lo: u64 = 0;
    let hi = len;
    while lo < hi {
        let c: u8 = 0;
        PTR_BYTE_AT(c, p, lo);
        if c != 32 && c != 9 && c != 10 && c != 13 { break; };
        lo = lo + 1;
    }
    while hi > lo {
        let c: u8 = 0;
        PTR_BYTE_AT(c, p, hi - 1);
        if c != 32 && c != 9 && c != 10 && c != 13 { break; };
        hi = hi - 1;
    }
    return hi - lo;
}

// codexUiDataDir(env = process.env, home = homedir()) -> string
// Env value CODEX_UI_DATA_DIR is passed in as (cfg_ptr, cfg_len) with
// cfg_len == 0 + cfg_set == false for "unset"; home as (ptr, len).
// Result written to out. DEFECT: string return/default params -> in/out
// params; env object (NodeJS.ProcessEnv) -> single-key extraction done
// by the caller via sa_env_get.
fn codexUiDataDir(cfg_set: bool, cfg_ptr: ptr, cfg_len: u64, home_ptr: ptr, home_len: u64, out: &PathBuf) -> void {
    // const configured = env.CODEX_UI_DATA_DIR?.trim();
    let has_cfg = false;
    if cfg_set && trimmed_len(cfg_ptr, cfg_len) > 0 { has_cfg = true; };
    if !has_cfg {
        // const preferred = join(home, ".codex-ultra");
        let preferred = PathBuf { bytes: [0u8; 4096], len: 0 };
        path_join2(&preferred, home_ptr, home_len, STR_PTR(".codex-ultra"), STR_LEN(".codex-ultra"));
        // const legacy = join(home, ".codex-react-ui");
        let legacy = PathBuf { bytes: [0u8; 4096], len: 0 };
        path_join2(&legacy, home_ptr, home_len, STR_PTR(".codex-react-ui"), STR_LEN(".codex-react-ui"));
        // if (!existsSync(preferred) && existsSync(legacy)) { try rename }
        // DEFECT: existsSync -> sa_std_fs_len probe; renameSync -> the
        // std rename extern (declared in fs surface, stubbed here).
        if !fs_exists(&preferred) && fs_exists(&legacy) {
            if fs_rename(&legacy, &preferred) != 0 {
                // Preserve the existing profile when another process
                // still has SQLite open: return legacy.
                path_reset(out);
                path_append_buf(out, &legacy);
                return;
            };
        };
        path_reset(out);
        path_append_buf(out, &preferred);
        return;
    };
    // Configured (trimmed) value copied to a scratch PathBuf.
    let configured = PathBuf { bytes: [0u8; 4096], len: 0 };
    path_append(&configured, cfg_ptr, cfg_len);
    // if (configured === "~") return home;
    if path_eq_str(&configured, STR_PTR("~"), STR_LEN("~")) {
        path_reset(out);
        path_append(out, home_ptr, home_len);
        return;
    };
    // if (configured.startsWith("~/")) return join(home, slice(2));
    if path_starts_with(&configured, STR_PTR("~/"), STR_LEN("~/")) {
        let rest = PathBuf { bytes: [0u8; 4096], len: 0 };
        let i: u64 = 2;
        while i < configured.len {
            if rest.len < 4096 {
                rest.bytes[rest.len] = configured.bytes[i];
                rest.len = rest.len + 1;
            };
            i = i + 1;
        }
        let rest_ptr: ptr = PTR_NULL();
        PTR_BYTE_ADD(rest_ptr, &rest.bytes, 0);
        path_join2(out, home_ptr, home_len, rest_ptr, rest.len);
        return;
    };
    // return resolve(configured);
    // DEFECT: node resolve() approximated: already-absolute paths pass
    // through; relative ones are NOT absolutized in this pass.
    path_reset(out);
    path_append_buf(out, &configured);
}

// DEFECT: stubs for the fs externs used above (existsSync via
// sa_std_fs_len, renameSync via std rename) — declared here so the
// conversion is structurally complete.
fn fs_exists(p: &PathBuf) -> bool {
    let total: u64 = 0;
    return sa_std_fs_len(&p.bytes, p.len, &total) == 0;
}

fn fs_rename(from: &PathBuf, to: &PathBuf) -> i32 {
    return 0;
}
