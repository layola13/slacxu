    return 0;
}
// export function formatAsNetworkX(graph) -> string
fn formatAsNetworkX(g: &CodeGraph, out_ptr: ptr, out_cap: u64) -> u64 {
    // "import networkx as nx", G = nx.DiGraph(); add_node lines
