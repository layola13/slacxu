// --- Native Action Entry Point ---
// export async function nativeCodeGraph(rawInput, policy, cwd, startedAt)
// DEFECT: async; Record<string, any> -> JSON buffer; Date.now() ->
// now_ms parameter (duration = now - startedAt computed by caller
// helper duration_since(startedAt)).
fn nativeCodeGraph(raw_json_ptr: ptr, raw_json_len: u64, has_policy: bool, policy_json_ptr: ptr, policy_json_len: u64, cwd_ptr: ptr, cwd_len: u64, started_at: u64, now_ms: u64, out: &SaVmRunResult) -> i32 {
    // target = rawInput.target ?? symbol ?? path ?? query ?? name,
    // stringified + trimmed; empty -> sa_error exit 1 result with
    // "target parameter is required for code_graph ..." stderr.
    // normalized = normalizeSaVmPolicy(policy, cwd); options built
    // with typeof-number/string guards (depth, max_nodes,
    // max_tokens, output_file, candidate_files ?? files, format
    // default "dot"). buildScopedCodeGraph; format by format.
    // output_file: resolve, checkSaVmPath write; denied ->
    // capability_denied exit 228 result carrying the formatted
    // output on stdout; allowed -> writeFile utf8 and prefix
    // "[Graph saved to <output_file>]\n\n".
    // success: ok, exit 0, one code_graph event {timestamp, type,
    // target, nodes, edges}, stderr notes truncation.
    // exception -> sa_error exit 1 "[code_graph] error analyzing
    // <target>: <msg>".
    // DEFECT: SaVmRunResult here is the saVmTypes.sla shape; the
    // source imports it from saVmResultKind.ts — kept as one struct.
    out.ok = false;
    return 0;
}
