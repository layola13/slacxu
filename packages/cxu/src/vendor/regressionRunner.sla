// Converted 1:1 from packages/cxu/src/vendor/regressionRunner.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "sa_std/ptr.sa"

// TS imports: existsSync/mkdirSync/readdirSync/readFileSync/
// writeFileSync (node:fs), join/resolve (node:path).
// NOTE: this vendored copy defines its own RegressionCase types and
// loader (duplicated from regressionCases.ts in the source too — the
// duplication is preserved 1:1, including its slightly different
// filter semantics: component = substring includes, tag/tags =
// exact case-sensitive membership, no sort).
// DEFECT: dynamic JSON case objects -> parsed docs + extracted spans;
// Date.now() -> monotonic clock extern noted inline.

struct RPathBuf {
bytes: [u8; 4096],
len: u64,
}

fn rp_reset(b: &RPathBuf) -> void { b.len = 0;}

fn rp_append(b: &RPathBuf, src_ptr: ptr, src_len: u64) -> void {
for i in 0..src_len {
if b.len < 4096 {
let c: u8 = 0;
PTR_BYTE_AT(c, src_ptr, i);
b.bytes[b.len] = c;
b.len = b.len + 1;
};
}
}

fn rp_append_buf(b: &RPathBuf, src: &RPathBuf) -> void {
for i in 0..src.len {
if b.len < 4096 {
b.bytes[b.len] = src.bytes[i];
b.len = b.len + 1;
};
}
}

fn rp_join2(out: &RPathBuf, a_ptr: ptr, a_len: u64, b_ptr: ptr, b_len: u64) -> void {
rp_reset(out);
rp_append(out, a_ptr, a_len);
if a_len > 0 {
let last: u8 = 0;
PTR_BYTE_AT(last, a_ptr, a_len - 1);
if last!= 47 { rp_append(out, STR_PTR("/"), STR_LEN("/"));};
};
rp_append(out, b_ptr, b_len);
}

fn rp_trimmed(p: ptr, len: u64, out_lo: &u64, out_hi: &u64) -> void {
let lo: u64 = 0;
let hi = len;
while lo < hi {
let c: u8 = 0;
PTR_BYTE_AT(c, p, lo);
if c!= 32 && c!= 9 && c!= 10 && c!= 13 { break;};
lo = lo + 1;
}
while hi > lo {
let c: u8 = 0;
PTR_BYTE_AT(c, p, hi - 1);
if c!= 32 && c!= 9 && c!= 10 && c!= 13 { break;};
hi = hi - 1;
}
out_lo = lo;
out_hi = hi;
}

// export interface RegressionCase -> struct (this file's own copy).
struct RegressionCase {
id_bytes: [u8; 256],
id_len: u64,
title_bytes: [u8; 512],
title_len: u64,
component_bytes: [u8; 512],
component_len: u64,
has_tags: bool,
tags_json: [u8; 1024],
tags_json_len: u64,
has_category: bool,
category_bytes: [u8; 128],
category_len: u64,
has_description: bool,
description_bytes: [u8; 2048],
description_len: u64,
has_input: bool,
input_json: [u8; 4096],
input_json_len: u64,
has_simulation: bool,
simulation_json: [u8; 8192],
simulation_json_len: u64,
has_negative_matcher: bool,
negative_matcher_json: [u8; 4096],
negative_matcher_json_len: u64,
has_positive_invariants: bool,
positive_invariants_json: [u8; 4096],
positive_invariants_json_len: u64,
has_runner: bool,
runner_bytes: [u8; 256],
runner_len: u64,
// Parsed doc handle for the dynamic sub-objects (rounds etc.).
doc: u64,
}

// export interface RegressionCaseResult -> struct.
struct RegressionCaseResult {
