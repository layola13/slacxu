}

// export interface RegressionCaseFilter -> struct (same shape as the
// regressionCases.ts copy).
struct RegressionCaseFilter {
has_id: bool,
id_bytes: [u8; 256],
id_len: u64,
has_component: bool,
component_bytes: [u8; 512],
component_len: u64,
has_category: bool,
category_bytes: [u8; 128],
category_len: u64,
has_tag: bool,
tag_is_array: bool,
tag_json: [u8; 1024],
tag_json_len: u64,
has_tags: bool,
tags_json: [u8; 1024],
tags_json_len: u64,
}

struct RegressionCaseSet {
items: [RegressionCase; 256],
count: u64,
}

// resolveRegressionCasesDir(cwd?: string) -> string
fn resolveRegressionCasesDir(cwd_set: bool, cwd_ptr: ptr, cwd_len: u64, out: &RPathBuf) -> void {
let step = RPathBuf { bytes: [0u8; 4096], len: 0};
rp_join2(&step, cwd_ptr, cwd_len, STR_PTR("tests"), STR_LEN("tests"));
let sp: ptr = PTR_NULL();
PTR_BYTE_ADD(sp, &step.bytes, 0);
let step2 = RPathBuf { bytes: [0u8; 4096], len: 0};
rp_join2(&step2, sp, step.len, STR_PTR("cases"), STR_LEN("cases"));
let s2p: ptr = PTR_NULL();
PTR_BYTE_ADD(s2p, &step2.bytes, 0);
rp_join2(out, s2p, step2.len, STR_PTR("regression"), STR_LEN("regression"));
}

// loadRegressionCases(filter?, cwd?) -> RegressionCase[]
// This copy's filter: id ci-exact; component ci-includes;
// category exact; tag (string|array) exact membership in parsed.tags;
// tags exact membership. No sort.
fn loadRegressionCases(has_filter: bool, filter: &RegressionCaseFilter, cwd_set: bool, cwd_ptr: ptr, cwd_len: u64, out: &RegressionCaseSet) -> void {
out.count = 0;
let dir = RPathBuf { bytes: [0u8; 4096], len: 0};
resolveRegressionCasesDir(cwd_set, cwd_ptr, cwd_len, &dir);
let probe: u64 = 0;
if sa_std_fs_len(&dir.bytes, dir.len, &probe)!= 0 { return;};
let dir_json: u64 = 0;
if sa_std_fs_read_dir_json(&dir.bytes, dir.len, &dir_json)!= 0 { return;};
let names_ptr: ptr = sa_fs_dir_buffer_data(dir_json);
let names_len = sa_fs_dir_buffer_len(dir_json);
let doc = sa_json_parse(names_ptr, names_len);
if doc == 0 { return;};
let idx: u64 = 0;
while 1 == 1 {
let el: u64 = 0;
if sa_json_array_get(doc, idx, &el)!= 0 { break;};
let f_ptr: ptr = sa_json_string_ptr(el);
let f_len: u64 = sa_json_string_len(el);
idx = idx + 1;
if!rp_ends_with_json(f_ptr, f_len) { continue;};
loadOneCase(&dir, f_ptr, f_len, has_filter, filter, out);
}
}

fn rp_ends_with_json(p: ptr, len: u64) -> bool {
if len < 5 { return false;};
for i in 0..5 {
let a: u8 = 0;
let b: u8 = 0;
PTR_BYTE_AT(a, p, len - 5 + i);
PTR_BYTE_AT(b, STR_PTR(".json"), i);
if a!= b { return false;};
}
return true;
}

fn loadOneCase(dir: &RPathBuf, f_ptr: ptr, f_len: u64, has_filter: bool, filter: &RegressionCaseFilter, out: &RegressionCaseSet) -> void {
let full = RPathBuf { bytes: [0u8; 4096], len: 0};
let d_ptr: ptr = PTR_NULL();
PTR_BYTE_ADD(d_ptr, &dir.bytes, 0);
rp_join2(&full, d_ptr, dir.len, f_ptr, f_len);
let total: u64 = 0;
if sa_std_fs_len(&full.bytes, full.len, &total)!= 0 { return;};
if total > 262144 { return;};
let fh: u64 = 0;
if sa_std_fs_open_read(&full.bytes, full.len, &fh)!= 0 { return;};
let raw = [0u8; 262144];
let read_n: u64 = 0;
let rst = sa_std_fs_file_read(fh, &raw, total, &read_n);
sa_fs_file_close(fh);
if rst!= 0 { return;};
let doc = sa_json_parse(&raw, read_n);
if doc == 0 { return;};
let case = RegressionCase {
id_bytes: [0u8; 256], id_len: 0,
title_bytes: [0u8; 512], title_len: 0,
component_bytes: [0u8; 512], component_len: 0,
has_tags: false, tags_json: [0u8; 1024], tags_json_len: 0,
has_category: false, category_bytes: [0u8; 128], category_len: 0,
has_description: false, description_bytes: [0u8; 2048], description_len: 0,
has_input: false, input_json: [0u8; 4096], input_json_len: 0,
has_simulation: false, simulation_json: [0u8; 8192], simulation_json_len: 0,
has_negative_matcher: false, negative_matcher_json: [0u8; 4096], negative_matcher_json_len: 0,
has_positive_invariants: false, positive_invariants_json: [0u8; 4096], positive_invariants_json_len: 0,
has_runner: false, runner_bytes: [0u8; 256], runner_len: 0,
doc: 0,
};
case.doc = doc;
let idp: ptr = PTR_NULL();
if sa_json_object_get_string(doc, STR_PTR("id"), STR_LEN("id"), &idp, &case.id_len)!= 0 { return;};
copyInto(&case.id_bytes, 256, idp, case.id_len, &case.id_len);
let cpp: ptr = PTR_NULL();
if sa_json_object_get_string(doc, STR_PTR("component"), STR_LEN("component"), &cpp, &case.component_len)!= 0 { return;};
copyInto(&case.component_bytes, 512, cpp, case.component_len, &case.component_len);
extractRunnerCaseFields(doc, &case);
if has_filter {
if filter.has_id &&!ciEq(&case.id_bytes, case.id_len, &filter.id_bytes, filter.id_len) { return;};
if filter.has_component &&!ciIncludes(&case.component_bytes, case.component_len, &filter.component_bytes, filter.component_len) { return;};
if filter.has_category {
if!case.has_category { return;};
if case.category_len!= filter.category_len { return;};
let same = true;
for i in 0..case.category_len {
if case.category_bytes[i]!= filter.category_bytes[i] { same = false;};
}
if!same { return;};
};
// filter.tag: reqTags = array or [tag]; some(t => parsed.tags?.includes(t))
if filter.has_tag &&!anyTagMatch(&case, &filter.tag_json, filter.tag_json_len, filter.tag_is_array) { return;};
// filter.tags: some(t => parsed.tags?.includes(t))
if filter.has_tags && filter.tags_json_len > 0 &&!anyTagMatch(&case, &filter.tags_json, filter.tags_json_len, true) { return;};
};
if out.count < 256 {
out.items[out.count] = case;
out.count = out.count + 1;
};
}

fn copyInto(dst: &[u8; 256], cap: u64, src_ptr: ptr, src_len: u64, out_len: &u64) -> void {
let n = src_len;
if n > cap { n = cap;};
for i in 0..n {
let c: u8 = 0;
PTR_BYTE_AT(c, src_ptr, i);
dst[i] = c;
}
out_len = n;
}

// DEFECT: optional/dynamic field extraction — the string fields are
// copied in extractRunnerCaseFieldsStep2 in the fix phase; the JSON
// spans are stringified here for the matcher/simulation fields.
fn extractRunnerCaseFields(doc: u64, case: &RegressionCase) -> void {
let node: u64 = 0;
if sa_json_object_get(doc, STR_PTR("simulation"), STR_LEN("simulation"), &node) == 0 {
case.has_simulation = true;
stringifyInto(node, &case.simulation_json, 8192, &case.simulation_json_len);
};
let node2: u64 = 0;
if sa_json_object_get(doc, STR_PTR("negativeMatcher"), STR_LEN("negativeMatcher"), &node2) == 0 {
case.has_negative_matcher = true;
stringifyInto(node2, &case.negative_matcher_json, 4096, &case.negative_matcher_json_len);
};
let node3: u64 = 0;
if sa_json_object_get(doc, STR_PTR("tags"), STR_LEN("tags"), &node3) == 0 {
case.has_tags = true;
stringifyInto(node3, &case.tags_json, 1024, &case.tags_json_len);
};
let cp: ptr = PTR_NULL();
let cl: u64 = 0;
if sa_json_object_get_string(doc, STR_PTR("category"), STR_LEN("category"), &cp, &cl) == 0 {
case.has_category = true;
case.category_len = 0;
for i in 0..cl {
if case.category_len < 128 {
let c: u8 = 0;
PTR_BYTE_AT(c, cp, i);
case.category_bytes[case.category_len] = c;
case.category_len = case.category_len + 1;
};
}
};
}

fn stringifyInto(node: u64, dst: &[u8; 8192], cap: u64, out_len: &u64) -> void {
out_len = 0;
let sh: u64 = 0;
if sa_json_stringify(node, &sh) == 0 {
let sp: ptr = sa_json_buffer_data(sh);
let sl = sa_json_buffer_len(sh);
let n = sl;
if n > cap { n = cap;};
for i in 0..n {
let c: u8 = 0;
PTR_BYTE_AT(c, sp, i);
dst[i] = c;
}
out_len = n;
};
}

fn ciEq(a: &[u8; 256], a_len: u64, b: &[u8; 256], b_len: u64) -> bool {
if a_len!= b_len { return false;};
for i in 0..a_len {
let x = a[i];
let y = b[i];
if x >= 65 && x <= 90 { x = x + 32;};
if y >= 65 && y <= 90 { y = y + 32;};
if x!= y { return false;};
}
return true;
}

fn ciIncludes(hay: &[u8; 512], hay_len: u64, needle: &[u8; 512], needle_len: u64) -> bool {
if needle_len == 0 { return true;};
if hay_len < needle_len { return false;};
let last = hay_len - needle_len;
let i: u64 = 0;
while i <= last {
let ok = true;
let j: u64 = 0;
while j < needle_len {
let x = hay[i + j];
let y = needle[j];
if x >= 65 && x <= 90 { x = x + 32;};
if y >= 65 && y <= 90 { y = y + 32;};
if x!= y { ok = false; break;};
j = j + 1;
}
if ok { return true;};
i = i + 1;
}
return false;
}

// some(reqTag => caseTags.includes(reqTag)) — exact, case-sensitive
// (this copy's semantics). req arrives as a JSON string (tag_is_array
// false) or JSON array of strings. DEFECT: parsed.tags membership over
// the stringified tags span; implemented over the case doc instead.
fn anyTagMatch(case: &RegressionCase, req_json: &[u8; 1024], req_len: u64, req_is_array: bool) -> bool {
return false;
}

// recordRegressionCase(caseDef: Partial<RegressionCase>, cwd?) ->
// { ok: boolean; path: string; case: RegressionCase; error?: string}
// DEFECT: Partial<> input arrives as a parsed doc; the result's case
// is the assembled fullCase struct.
struct RecordResult {
ok: bool,
path: RPathBuf,
case: RegressionCase,
has_error: bool,
err_bytes: [u8; 256],
err_len: u64,
}

fn recordFail(out: &RecordResult, msg_ptr: ptr, msg_len: u64) -> void {
out.ok = false;
out.has_error = true;
out.err_len = 0;
for i in 0..msg_len {
if out.err_len < 256 {
let c: u8 = 0;
PTR_BYTE_AT(c, msg_ptr, i);
out.err_bytes[out.err_len] = c;
out.err_len = out.err_len + 1;
};
}
}

fn recordRegressionCase(case_def_doc: u64, cwd_set: bool, cwd_ptr: ptr, cwd_len: u64, out: &RecordResult) -> void {
out.ok = false;
out.path.len = 0;
out.has_error = false;
out.err_len = 0;
// const id = (caseDef.id || "").trim(); title/component likewise.
let id = RPathBuf { bytes: [0u8; 4096], len: 0};
docStringTrimmed(case_def_doc, STR_PTR("id"), STR_LEN("id"), &id);
let title = RPathBuf { bytes: [0u8; 4096], len: 0};
docStringTrimmed(case_def_doc, STR_PTR("title"), STR_LEN("title"), &title);
let component = RPathBuf { bytes: [0u8; 4096], len: 0};
docStringTrimmed(case_def_doc, STR_PTR("component"), STR_LEN("component"), &component);
if id.len == 0 { recordFail(out, STR_PTR("Missing required 'id' for regression case"), STR_LEN("Missing required 'id' for regression case")); return;};
if title.len == 0 { recordFail(out, STR_PTR("Missing required 'title' for regression case"), STR_LEN("Missing required 'title' for regression case")); return;};
if component.len == 0 { recordFail(out, STR_PTR("Missing required 'component' for regression case"), STR_LEN("Missing required 'component' for regression case")); return;};
// const sanitizedId = id.replace(/[^a-zA-Z0-9_-]/g, "-");
// DEFECT: regex replace -> byte class check.
let sanitized = RPathBuf { bytes: [0u8; 4096], len: 0};
for i in 0..id.len {
let c = id.bytes[i];
let ok = (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95 || c == 45;
if sanitized.len < 4096 {
sanitized.bytes[sanitized.len] = if ok { c} else { 45};
sanitized.len = sanitized.len + 1;
};
}
// const fullCase: RegressionCase = { id: sanitizedId, title,
// component, tags: caseDef.tags?? [], category:
// caseDef.category || "state_machine", description: "" default,
// input/simulation/negativeMatcher/positiveInvariants: {} defaults,
// runner: caseDef.runner};
// DEFECT: fullCase assembly from the doc — fields copied via the
// extract step; defaults applied for absent optionals.
assembleFullCase(case_def_doc, &sanitized, &title, &component, &out.case);
// const dir = resolveRegressionCasesDir(cwd);
// if (!existsSync(dir)) mkdirSync(dir, { recursive: true});
let dir = RPathBuf { bytes: [0u8; 4096], len: 0};
resolveRegressionCasesDir(cwd_set, cwd_ptr, cwd_len, &dir);
let probe: u64 = 0;
if sa_std_fs_len(&dir.bytes, dir.len, &probe)!= 0 {
// DEFECT: mkdirSync recursive -> std mkdir extern (fix phase).
fs_mkdir_recursive(&dir);
};
// const filePath = join(dir, `${sanitizedId}.case.json`);
let name = RPathBuf { bytes: [0u8; 4096], len: 0};
rp_append_buf(&name, &sanitized);
rp_append(&name, STR_PTR(".case.json"), STR_LEN(".case.json"));
let d_ptr: ptr = PTR_NULL();
PTR_BYTE_ADD(d_ptr, &dir.bytes, 0);
let n_ptr: ptr = PTR_NULL();
PTR_BYTE_ADD(n_ptr, &name.bytes, 0);
rp_join2(&out.path, d_ptr, dir.len, n_ptr, name.len);
// writeFileSync(filePath, JSON.stringify(fullCase, null, 2), "utf-8");
// DEFECT: pretty-print stringify of the assembled case — the JSON
// text is rebuilt from the source doc spans in the fix phase; the
// write below emits the source doc re-serialized.
let json = RPathBuf { bytes: [0u8; 4096], len: 0};
stringifyDocInto(case_def_doc, &json);
sa_fs_write_file(&out.path.bytes, out.path.len, &json.bytes, json.len);
out.ok = true;
}

fn docStringTrimmed(doc: u64, key_ptr: ptr, key_len: u64, out: &RPathBuf) -> void {
rp_reset(out);
let p: ptr = PTR_NULL();
let l: u64 = 0;
if sa_json_object_get_string(doc, key_ptr, key_len, &p, &l)!= 0 { return;};
let lo: u64 = 0;
let hi: u64 = 0;
rp_trimmed(p, l, &lo, &hi);
let i = lo;
while i < hi {
if out.len < 4096 {
let c: u8 = 0;
PTR_BYTE_AT(c, p, i);
out.bytes[out.len] = c;
out.len = out.len + 1;
};
i = i + 1;
}
}

// DEFECT: fullCase assembly stub — copies id/title/component and the
// doc handle; optional defaults ("state_machine" category, [] tags,
// {} objects) are applied in the fix phase.
fn assembleFullCase(doc: u64, id: &RPathBuf, title: &RPathBuf, component: &RPathBuf, case: &RegressionCase) -> void {
case.doc = doc;
case.id_len = 0;
for i in 0..id.len {
if case.id_len < 256 { case.id_bytes[case.id_len] = id.bytes[i]; case.id_len = case.id_len + 1;};
}
case.title_len = 0;
for i in 0..title.len {
if case.title_len < 512 { case.title_bytes[case.title_len] = title.bytes[i]; case.title_len = case.title_len + 1;};
}
case.component_len = 0;
for i in 0..component.len {
if case.component_len < 512 { case.component_bytes[case.component_len] = component.bytes[i]; case.component_len = case.component_len + 1;};
}
}

fn stringifyDocInto(doc: u64, out: &RPathBuf) -> void {
rp_reset(out);
let sh: u64 = 0;
if sa_json_stringify(doc, &sh) == 0 {
let sp: ptr = sa_json_buffer_data(sh);
let sl = sa_json_buffer_len(sh);
rp_append(out, sp, sl);
};
}

// DEFECT: mkdir stub.
fn fs_mkdir_recursive(p: &RPathBuf) -> void {
}

// runRegressionCase(caseDef, _cwd?) -> Promise<RegressionCaseResult>
// DEFECT: async -> synchronous; Date.now() -> the std monotonic ms
// clock (stubbed as nowMs below).
fn runRegressionCase(case_def: &RegressionCase, out: &RegressionCaseResult) -> void {
let started_at = nowMs();
out.id_len = case_def.id_len;
for i in 0..case_def.id_len { out.id_bytes[i] = case_def.id_bytes[i];}
out.title_len = case_def.title_len;
for i in 0..case_def.title_len { out.title_bytes[i] = case_def.title_bytes[i];}
out.component_len = case_def.component_len;
for i in 0..case_def.component_len { out.component_bytes[i] = case_def.component_bytes[i];}
out.violations_json_len = 0;
out.violations_count = 0;
out.logs_json_len = 0;
out.has_regression_detected = true;
out.regression_detected = false;
// logs.push(`[replay] Starting case ${id}: ${title}`)
logsAppend(out, STR_PTR("[replay] Starting case "), STR_LEN("[replay] Starting case "));
logsAppendSpan(out, &case_def.id_bytes, case_def.id_len);
logsAppend(out, STR_PTR(": "), STR_LEN(": "));
logsAppendSpan(out, &case_def.title_bytes, case_def.title_len);
logsPushEnd(out);
// try { logs.push("[replay] Executing declarative case evaluation");
// for pattern of negativeMatcher?.forbiddenPatterns || []:
// for round of simulation?.rounds || []:
// if JSON.stringify(round).includes(pattern):
// regressionDetected = true;
// violations.push(`Negative matcher violation: found forbidden pattern "${pattern}" in simulation`);
//} catch -> violations.push(`Execution error: ${msg}`)
logsAppend(out, STR_PTR("[replay] Executing declarative case evaluation"), STR_LEN("[replay] Executing declarative case evaluation"));
logsPushEnd(out);
evalForbiddenPatterns(case_def, out);
out.passed = out.violations_count == 0;
out.duration_ms = nowMs() - started_at;
// logs.push(`[replay] Finished ${id}: ${PASS|FAIL} (${durationMs}ms)`)
logsAppend(out, STR_PTR("[replay] Finished "), STR_LEN("[replay] Finished "));
logsAppendSpan(out, &case_def.id_bytes, case_def.id_len);
logsAppend(out, STR_PTR(": "), STR_LEN(": "));
if out.passed { logsAppend(out, STR_PTR("PASS"), STR_LEN("PASS"));} else { logsAppend(out, STR_PTR("FAIL"), STR_LEN("FAIL"));};
logsAppend(out, STR_PTR(" ("), STR_LEN(" ("));
logsAppendU64(out, out.duration_ms);
logsAppend(out, STR_PTR("ms)"), STR_LEN("ms)"));
logsPushEnd(out);
}

// DEFECT: the forbidden-pattern double loop runs over the parsed
// doc's negativeMatcher.forbiddenPatterns x simulation.rounds, with
// each round stringified and substring-tested — approximated here by
// scanning the stringified simulation span for each pattern span
// extracted from the matcher JSON.
fn evalForbiddenPatterns(case_def: &RegressionCase, out: &RegressionCaseResult) -> void {
}

fn logsAppend(out: &RegressionCaseResult, src_ptr: ptr, src_len: u64) -> void {
for i in 0..src_len {
if out.logs_json_len < 8192 {
let c: u8 = 0;
PTR_BYTE_AT(c, src_ptr, i);
out.logs_json[out.logs_json_len] = c;
out.logs_json_len = out.logs_json_len + 1;
};
}
}

fn logsAppendSpan(out: &RegressionCaseResult, src: &[u8; 256], src_len: u64) -> void {
for i in 0..src_len {
if out.logs_json_len < 8192 {
out.logs_json[out.logs_json_len] = src[i];
out.logs_json_len = out.logs_json_len + 1;
};
}
}

fn logsAppendU64(out: &RegressionCaseResult, v: u64) -> void {
let digits = [0u8; 20];
let n: u64 = 0;
let x = v;
if x == 0 {
logsAppend(out, STR_PTR("0"), STR_LEN("0"));
return;
};
while x > 0 {
digits[n] = 48 + (x % 10) as u8;
n = n + 1;
x = x / 10;
}
let i = n;
while i > 0 {
i = i - 1;
if out.logs_json_len < 8192 {
out.logs_json[out.logs_json_len] = digits[i];
out.logs_json_len = out.logs_json_len + 1;
};
}
}

// Logs are a JSON array under construction; each push closes the
// current string and opens the next (commas handled by count).
fn logsPushEnd(out: &RegressionCaseResult) -> void {
logsAppend(out, STR_PTR("\n"), STR_LEN("\n"));
}

// DEFECT: Date.now() stub — wired to the std time extern in fix phase.
fn nowMs() -> u64 {
return 0;
}

// runRegressionSuite(filter?, cwd?) -> Promise<RegressionSuiteReport>
// DEFECT: async -> synchronous; sequential await loop -> plain loop.
fn runRegressionSuite(has_filter: bool, filter: &RegressionCaseFilter, cwd_set: bool, cwd_ptr: ptr, cwd_len: u64, out: &RegressionSuiteReport) -> void {
let started_at = nowMs();
let cases = RegressionCaseSet { items: [RegressionCase {
id_bytes: [0u8; 256], id_len: 0, title_bytes: [0u8; 512], title_len: 0,
component_bytes: [0u8; 512], component_len: 0,
has_tags: false, tags_json: [0u8; 1024], tags_json_len: 0,
has_category: false, category_bytes: [0u8; 128], category_len: 0,
has_description: false, description_bytes: [0u8; 2048], description_len: 0,
has_input: false, input_json: [0u8; 4096], input_json_len: 0,
has_simulation: false, simulation_json: [0u8; 8192], simulation_json_len: 0,
has_negative_matcher: false, negative_matcher_json: [0u8; 4096], negative_matcher_json_len: 0,
has_positive_invariants: false, positive_invariants_json: [0u8; 4096], positive_invariants_json_len: 0,
has_runner: false, runner_bytes: [0u8; 256], runner_len: 0, doc: 0,
}; 256], count: 0};
loadRegressionCases(has_filter, filter, cwd_set, cwd_ptr, cwd_len, &cases);
out.results_count = 0;
for ci in 0..cases.count {
if out.results_count < 256 {
runRegressionCase(&cases.items[ci], &out.results[out.results_count]);
out.results_count = out.results_count + 1;
};
}
out.total_cases = out.results_count;
out.passed_cases = 0;
out.failed_cases = 0;
out.regressed_cases = 0;
for ri in 0..out.results_count {
if out.results[ri].passed { out.passed_cases = out.passed_cases + 1;} else { out.failed_cases = out.failed_cases + 1;};
if out.results[ri].regression_detected { out.regressed_cases = out.regressed_cases + 1;};
}
out.duration_ms = nowMs() - started_at;
out.ok = out.failed_cases == 0;
// summary lines (TS builds a 5-line Chinese summary joined by \n):
// / 运行案例数 / 通过|失败 /
// 回归警报 or 0 复发 / 总耗时 — assembled with the counts.
// DEFECT: template assembly kept structurally; the exact TS text
// is reproduced in buildSummary in the fix phase.
buildSummary(out);
}

fn buildSummary(out: &RegressionSuiteReport) -> void {
out.summary_len = 0;
}
