// Converted 1:1 from packages/cxu/src/vendor/regressionRunner.ts (CXU plugins @ f2cb649d).
// pkg-cxu fix phase (2026-10-26, FIX_PKG_CXU): full retranslation of the vendor
// runner. The vendor TS is a SELF-CONTAINED declarative runner (its sibling in
// apps/server is a different module: it re-exports the SDK loader and drives a
// runtime client; only the export surface coincides). Declaration shapes
// (RegressionCase / RegressionCaseFilter / RegressionCaseResult /
// RegressionSuiteReport / RecordRegressionCaseResult) mirror the apps runner
// unit 1:1 because packages/cxu/src/vendor/saVmTool.sla (the only consumer)
// was translated against them.
// DEFECT: load/resolve are exported by the vendor TS from this module AND by
// regressionCases.sla (the SDK loader, identical semantics for dir resolve;
// the loader here is rr_-internal to avoid a second public definition in the
// package closure; the public names live in regressionCases.sla).
// DEFECT: async fns -> synchronous + status code (ASYNC_MODEL: awaited APIs
// are blocking externs in sa_std; the suite loop is sequential in TS too).
// DEFECT: try/catch -> status branches; parse failures of a case file skip
// the file (TS catch-swallow), matcher evaluation has no throwing ops, so
// the TS "Execution error: ..." violation path is unreachable here.
// DEFECT: string case folding (toLowerCase) is ASCII-only; the Chinese
// literals are unaffected. String.prototype.trim is ASCII-whitespace-only.
// DEFECT: caps -- cases per suite run are streamed (no materialized set);
// patterns per case 64, tags per case 32, results per report 512 (the
// consumer's lens array), file size 131072 bytes (case JSON scratch).
// DEFECT: recordRegressionCase writes the case file with a hand-rolled
// pretty printer (JSON.stringify(x, null, 2) equivalent for this shape);
// on fs write failure TS throws (caller catch) while here ok=false +
// error text is returned, which the consumer renders identically.
// DEFECT: readdir order is the sa_std dir listing order (TS: readdirSync
// order); both are filesystem order, not sorted.

@import "sa_std/io/print.sai"
@import "sa_std/ptr.sa"
@import "sa_std/string.sa"
@import "sa_std/fs.sai"
@import "sa_std/encoding/json.sai"
@import "sa_std/time.sai"
@import "sa_std/env.sai"

// sa_json_kind codes (empirical, same table as saVmTool unit).
const RR_JK_STRING: u32 = 5;
const RR_JK_ARRAY: u32 = 6;
const RR_JK_OBJECT: u32 = 7;

// RegressionCase (type from @cxu/sdk-backend; shape mirrored 1:1 for this unit)
// DEFECT: input/simulation/negativeMatcher/positiveInvariants are dynamic objects -> JSON text buffers.
struct RegressionCase {
id: [u8; 256], id_len: u64,
title: [u8; 512], title_len: u64,
component: [u8; 256], component_len: u64,
// DEFECT: tags: string[] -> fixed array capacity 32
tags: [u8; 4096], tag_lens: [u64; 32], tags_len: u64,
category: [u8; 128], category_len: u64,
description: [u8; 2048], description_len: u64,
input_json: [u8; 65536], input_json_len: u64,
simulation_json: [u8; 65536], simulation_json_len: u64,
negative_matcher_json: [u8; 16384], negative_matcher_json_len: u64,
positive_invariants_json: [u8; 16384], positive_invariants_json_len: u64,
has_runner: bool, runner: [u8; 128], runner_len: u64,
}

// RegressionCaseFilter (type from @cxu/sdk-backend) — filter fields kept as JSON buffer.
// DEFECT: dynamic filter object -> JSON text buffer.
struct RegressionCaseFilter {
json: [u8; 8192], json_len: u64, has_filter: bool,
}

// L19-29: export interface RegressionCaseResult
struct RegressionCaseResult {
id: [u8; 256], id_len: u64,
title: [u8; 512], title_len: u64,
component: [u8; 256], component_len: u64,
passed: bool,
duration_ms: u64,
regression_detected: bool,
// DEFECT: violations: string[] / logs: string[] -> append buffers with per-line lens (capacity 256 lines each)
violations: [u8; 65536], violation_lens: [u64; 256], violations_len: u64,
logs: [u8; 131072], log_lens: [u64; 256], logs_len: u64,
}

// L31-41: export interface RegressionSuiteReport
struct RegressionSuiteReport {
ok: bool,
total_cases: u64,
passed_cases: u64,
failed_cases: u64,
regressed_cases: u64,
duration_ms: u64,
// DEFECT: results: RegressionCaseResult[] -> fixed array capacity 512 of serialized results
results: [u8; 4194304], result_lens: [u64; 512], results_len: u64,
summary: [u8; 4096], summary_len: u64,
err: [u8; 1024], err_len: u64,
}

// L44-78: export function recordRegressionCase(caseDef: Partial<RegressionCase>, cwd?): {ok, path, case, error?}
// DEFECT: Partial<> + cast `caseDef as RegressionCase` on early return -> full struct always carried; error via has_error + buffer on out param struct.
struct RecordRegressionCaseResult {
ok: bool,
path: [u8; 2048], path_len: u64,
case_json: [u8; 131072], case_json_len: u64, // DEFECT: returned RegressionCase serialized scratch
has_error: bool, error: [u8; 1024], error_len: u64,
}


// ---- local scratch types ----

struct RrStr {
    bytes: [u8; 131072],
    len: u64,
}

struct RrPatterns {
    bytes: [u8; 32768],
    lens: [u64; 64],
    count: u64,
    used: u64,
}

// ---- RrStr helpers ----

fn rr_str_ptr(s: &RrStr) -> ptr {
    let p: ptr = PTR_NULL();
    PTR_BYTE_ADD(p, &s.bytes, 0);
    return p;
}

fn rr_clear(s: &RrStr) -> void {
    s.len = 0;
}

fn rr_push(s: &RrStr, src: ptr, n: u64) -> void {
    let i: u64 = 0;
    while i < n {
        if s.len >= 131072 { return; };
        let b: u8 = PTR_BYTE_AT(src, i);
        s.bytes[s.len] = b;
        s.len = s.len + 1;
        i = i + 1;
    }
}

fn rr_push_lit(s: &RrStr, lit: ptr, lit_len: u64) -> void {
    rr_push(s, lit, lit_len);
}

fn rr_push_buf(s: &RrStr, src: &RrStr) -> void {
    let p: ptr = rr_str_ptr(src);
    rr_push(s, p, src.len);
}

fn rr_push_u64(s: &RrStr, v: u64) -> void {
    let digits: [u8; 20] = [0u8; 20];
    let n: u64 = 0;
    let x: u64 = v;
    if x == 0 {
        s.bytes[s.len] = 48;
        s.len = s.len + 1;
        return;
    };
    while x > 0 {
        let d: u64 = x % 10;
        digits[n] = (d + 48) as u8;
        n = n + 1;
        x = x / 10;
    }
    let i: u64 = n;
    while i > 0 {
        i = i - 1;
        if s.len >= 131072 { return; };
        s.bytes[s.len] = digits[i];
        s.len = s.len + 1;
    }
}

fn rr_push_json_escape(s: &RrStr, src: ptr, n: u64) -> void {
    let i: u64 = 0;
    while i < n {
        let b: u8 = PTR_BYTE_AT(src, i);
        if b == 34 {
            rr_push_lit(s, STR_PTR("\\\""), STR_LEN("\\\""));
        } else if b == 92 {
            rr_push_lit(s, STR_PTR("\\\\"), STR_LEN("\\\\"));
        } else if b == 10 {
            rr_push_lit(s, STR_PTR("\\n"), STR_LEN("\\n"));
        } else if b == 13 {
            rr_push_lit(s, STR_PTR("\\r"), STR_LEN("\\r"));
        } else if b == 9 {
            rr_push_lit(s, STR_PTR("\\t"), STR_LEN("\\t"));
        } else if b == 8 {
            rr_push_lit(s, STR_PTR("\\b"), STR_LEN("\\b"));
        } else if b == 12 {
            rr_push_lit(s, STR_PTR("\\f"), STR_LEN("\\f"));
        } else if b < 32 {
            rr_push_lit(s, STR_PTR("\\u00"), STR_LEN("\\u00"));
            let hi: u8 = b / 16;
            let lo: u8 = b % 16;
            let hc: u8 = 0;
            if hi < 10 { hc = hi + 48; } else { hc = hi + 87; };
            let lc: u8 = 0;
            if lo < 10 { lc = lo + 48; } else { lc = lo + 87; };
            if s.len < 131072 { s.bytes[s.len] = hc; s.len = s.len + 1; };
            if s.len < 131072 { s.bytes[s.len] = lc; s.len = s.len + 1; };
        } else {
            if s.len < 131072 { s.bytes[s.len] = b; s.len = s.len + 1; };
        };
        i = i + 1;
    }
}

// ---- byte utilities ----

fn rr_byte_eq(a: ptr, a_len: u64, b: ptr, b_len: u64) -> bool {
    if a_len != b_len { return false; };
    let i: u64 = 0;
    while i < a_len {
        let x: u8 = PTR_BYTE_AT(a, i);
        let y: u8 = PTR_BYTE_AT(b, i);
        if x != y { return false; };
        i = i + 1;
    }
    return true;
}

fn rr_fold(c: u8) -> u8 {
    if c >= 65 && c <= 90 { return c + 32; };
    return c;
}

fn rr_eq_ci(a: ptr, a_len: u64, b: ptr, b_len: u64) -> bool {
    if a_len != b_len { return false; };
    let i: u64 = 0;
    while i < a_len {
        let x: u8 = PTR_BYTE_AT(a, i);
        let y: u8 = PTR_BYTE_AT(b, i);
        if rr_fold(x) != rr_fold(y) { return false; };
        i = i + 1;
    }
    return true;
}

fn rr_contains(hay: ptr, hay_len: u64, needle: ptr, needle_len: u64) -> bool {
    if needle_len == 0 { return true; };
    if needle_len > hay_len { return false; };
    let last: u64 = hay_len - needle_len;
    let i: u64 = 0;
    while i <= last {
        let j: u64 = 0;
        let ok: bool = true;
        while j < needle_len {
            let x: u8 = PTR_BYTE_AT(hay, i + j);
            let y: u8 = PTR_BYTE_AT(needle, j);
            if x != y { ok = false; break; };
            j = j + 1;
        }
        if ok { return true; };
        i = i + 1;
    }
    return false;
}

fn rr_contains_ci(hay: ptr, hay_len: u64, needle: ptr, needle_len: u64) -> bool {
    if needle_len == 0 { return true; };
    if needle_len > hay_len { return false; };
    let last: u64 = hay_len - needle_len;
    let i: u64 = 0;
    while i <= last {
        let j: u64 = 0;
        let ok: bool = true;
        while j < needle_len {
            let x: u8 = PTR_BYTE_AT(hay, i + j);
            let y: u8 = PTR_BYTE_AT(needle, j);
            if rr_fold(x) != rr_fold(y) { ok = false; break; };
            j = j + 1;
        }
        if ok { return true; };
        i = i + 1;
    }
    return false;
}

fn rr_is_ws(b: u8) -> bool {
    return b == 32 || b == 9 || b == 10 || b == 13 || b == 11 || b == 12;
}

// ---- field-array accessors for RegressionCase ----
// which: 0 id, 1 title, 2 component, 3 category, 4 description, 5 runner,
// 6 input_json, 7 simulation_json, 8 negative_matcher_json,
// 9 positive_invariants_json.

fn rr_case_field_ptr(case: &RegressionCase, which: u64) -> ptr {
    let p: ptr = PTR_NULL();
    if which == 0 { PTR_BYTE_ADD(p, &case.id, 0); return p; };
    if which == 1 { PTR_BYTE_ADD(p, &case.title, 0); return p; };
    if which == 2 { PTR_BYTE_ADD(p, &case.component, 0); return p; };
    if which == 3 { PTR_BYTE_ADD(p, &case.category, 0); return p; };
    if which == 4 { PTR_BYTE_ADD(p, &case.description, 0); return p; };
    if which == 5 { PTR_BYTE_ADD(p, &case.runner, 0); return p; };
    if which == 6 { PTR_BYTE_ADD(p, &case.input_json, 0); return p; };
    if which == 7 { PTR_BYTE_ADD(p, &case.simulation_json, 0); return p; };
    if which == 8 { PTR_BYTE_ADD(p, &case.negative_matcher_json, 0); return p; };
    if which == 9 { PTR_BYTE_ADD(p, &case.positive_invariants_json, 0); return p; };
    return p;
}

fn rr_case_field_len(case: &RegressionCase, which: u64) -> u64 {
    if which == 0 { return case.id_len; };
    if which == 1 { return case.title_len; };
    if which == 2 { return case.component_len; };
    if which == 3 { return case.category_len; };
    if which == 4 { return case.description_len; };
    if which == 5 { return case.runner_len; };
    if which == 6 { return case.input_json_len; };
    if which == 7 { return case.simulation_json_len; };
    if which == 8 { return case.negative_matcher_json_len; };
    if which == 9 { return case.positive_invariants_json_len; };
    return 0;
}

fn rr_case_set_field(case: &RegressionCase, which: u64, src: ptr, n: u64) -> u64 {
    let m: u64 = n;
    let i: u64 = 0;
    if which == 0 {
        if m > 256 { m = 256; };
        while i < m { case.id[i] = PTR_BYTE_AT(src, i); i = i + 1; }
        case.id_len = m;
        return m;
    };
    if which == 1 {
        if m > 512 { m = 512; };
        while i < m { case.title[i] = PTR_BYTE_AT(src, i); i = i + 1; }
        case.title_len = m;
        return m;
    };
    if which == 2 {
        if m > 256 { m = 256; };
        while i < m { case.component[i] = PTR_BYTE_AT(src, i); i = i + 1; }
        case.component_len = m;
        return m;
    };
    if which == 3 {
        if m > 128 { m = 128; };
        while i < m { case.category[i] = PTR_BYTE_AT(src, i); i = i + 1; }
        case.category_len = m;
        return m;
    };
    if which == 4 {
        if m > 2048 { m = 2048; };
        while i < m { case.description[i] = PTR_BYTE_AT(src, i); i = i + 1; }
        case.description_len = m;
        return m;
    };
    if which == 5 {
        if m > 128 { m = 128; };
        while i < m { case.runner[i] = PTR_BYTE_AT(src, i); i = i + 1; }
        case.runner_len = m;
        return m;
    };
    if which == 6 {
        if m > 65536 { m = 65536; };
        while i < m { case.input_json[i] = PTR_BYTE_AT(src, i); i = i + 1; }
        case.input_json_len = m;
        return m;
    };
    if which == 7 {
        if m > 65536 { m = 65536; };
        while i < m { case.simulation_json[i] = PTR_BYTE_AT(src, i); i = i + 1; }
        case.simulation_json_len = m;
        return m;
    };
    if which == 8 {
        if m > 16384 { m = 16384; };
        while i < m { case.negative_matcher_json[i] = PTR_BYTE_AT(src, i); i = i + 1; }
        case.negative_matcher_json_len = m;
        return m;
    };
    if which == 9 {
        if m > 16384 { m = 16384; };
        while i < m { case.positive_invariants_json[i] = PTR_BYTE_AT(src, i); i = i + 1; }
        case.positive_invariants_json_len = m;
        return m;
    };
    return 0;
}

fn rr_case_reset(case: &RegressionCase) -> void {
    case.id_len = 0;
    case.title_len = 0;
    case.component_len = 0;
    case.tags_len = 0;
    case.category_len = 0;
    case.description_len = 0;
    case.input_json_len = 0;
    case.simulation_json_len = 0;
    case.negative_matcher_json_len = 0;
    case.positive_invariants_json_len = 0;
    case.has_runner = false;
    case.runner_len = 0;
}

fn rr_tag_push(case: &RegressionCase, src: ptr, n: u64) -> void {
    if case.tags_len >= 32 { return; };
    let off: u64 = 0;
    let i: u64 = 0;
    while i < case.tags_len {
        off = off + case.tag_lens[i];
        i = i + 1;
    }
    if off + n > 4096 { return; };
    let j: u64 = 0;
    while j < n {
        case.tags[off + j] = PTR_BYTE_AT(src, j);
        j = j + 1;
    }
    case.tag_lens[case.tags_len] = n;
    case.tags_len = case.tags_len + 1;
}

fn rr_case_tag_at(case: &RegressionCase, idx: u64, out_off: &u64, out_len: &u64) -> void {
    let off: u64 = 0;
    let i: u64 = 0;
    while i < idx {
        off = off + case.tag_lens[i];
        i = i + 1;
    }
    *out_off = off;
    *out_len = case.tag_lens[idx];
}

// ---- RrSmall (path / short-string scratch) ----

struct RrSmall {
    bytes: [u8; 4096],
    len: u64,
}

fn rs_ptr(s: &RrSmall) -> ptr {
    let p: ptr = PTR_NULL();
    PTR_BYTE_ADD(p, &s.bytes, 0);
    return p;
}

fn rs_clear(s: &RrSmall) -> void {
    s.len = 0;
}

fn rs_push(s: &RrSmall, src: ptr, n: u64) -> void {
    let i: u64 = 0;
    while i < n {
        if s.len >= 4096 { return; };
        s.bytes[s.len] = PTR_BYTE_AT(src, i);
        s.len = s.len + 1;
        i = i + 1;
    }
}

fn rs_push_lit(s: &RrSmall, lit: ptr, lit_len: u64) -> void {
    rs_push(s, lit, lit_len);
}

// copy a RegressionCase string field into s with ASCII whitespace trimmed
fn rs_copy_trimmed_field(s: &RrSmall, case: &RegressionCase, which: u64) -> void {
    rs_clear(s);
    let p: ptr = rr_case_field_ptr(case, which);
    let n: u64 = rr_case_field_len(case, which);
    let start: u64 = 0;
    let end: u64 = n;
    while start < end {
        let b: u8 = PTR_BYTE_AT(p, start);
        if !rr_is_ws(b) { break; };
        start = start + 1;
    }
    while end > start {
        let b: u8 = PTR_BYTE_AT(p, end - 1);
        if !rr_is_ws(b) { break; };
        end = end - 1;
    }
    let i: u64 = start;
    while i < end {
        if s.len >= 4096 { return; };
        s.bytes[s.len] = PTR_BYTE_AT(p, i);
        s.len = s.len + 1;
        i = i + 1;
    }
}

fn rs_sanitize_id(dst: &RrSmall, src: &RrSmall) -> void {
    rs_clear(dst);
    let i: u64 = 0;
    while i < src.len {
        let b: u8 = src.bytes[i];
        let ok: bool = (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || (b >= 48 && b <= 57) || b == 95 || b == 45;
        if dst.len < 4096 {
            if ok { dst.bytes[dst.len] = b; } else { dst.bytes[dst.len] = 45; };
            dst.len = dst.len + 1;
        };
        i = i + 1;
    }
}

// ---- JSON field extraction into RegressionCase ----

fn rr_doc_set_str_field(doc: u64, key: ptr, key_len: u64, case: &RegressionCase, which: u64) -> bool {
    let p: ptr = PTR_NULL();
    let n: u64 = 0;
    if sa_json_object_get_string(doc, key, key_len, &p, &n) != 0 { return false; };
    rr_case_set_field(case, which, p, n);
    return true;
}

fn rr_doc_set_obj_field(doc: u64, key: ptr, key_len: u64, case: &RegressionCase, which: u64) -> bool {
    let node: u64 = 0;
    if sa_json_object_get(doc, key, key_len, &node) != 0 { return false; };
    let bh: u64 = 0;
    if sa_json_stringify(node, &bh) != 0 { return false; };
    let p: ptr = sa_json_buffer_data(bh);
    let n: u64 = sa_json_buffer_len(bh);
    let stored: u64 = rr_case_set_field(case, which, p, n);
    sa_json_buffer_free(bh);
    return true;
}

// ---- dir resolve (vendor TS resolveRegressionCasesDir) ----
// root = cwd ? resolve(cwd) : process.cwd(); join(root, "tests/cases/regression")
// DEFECT: resolve() normalization + process.cwd() approximated exactly as
// the SDK loader unit does (verbatim cwd, else PWD env).

fn rr_resolve_dir(out: &RrSmall, has_cwd: bool, cwd_ptr: ptr, cwd_len: u64) -> void {
    rs_clear(out);
    if has_cwd {
        rs_push(out, cwd_ptr, cwd_len);
    } else {
        let e_pwd: u64 = sa_env_get(STR_PTR("PWD"), STR_LEN("PWD"));
        if e_pwd != 0 {
            let pp: ptr = sa_env_buffer_data(e_pwd);
            let pl: u64 = sa_env_buffer_len(e_pwd);
            rs_push(out, pp, pl);
        };
    };
    rs_push_lit(out, STR_PTR("/tests/cases/regression"), STR_LEN("/tests/cases/regression"));
}

// ---- single-case file parse (vendor TS load loop body) ----

fn rr_parse_case_file(path_ptr: ptr, path_len: u64, case: &RegressionCase) -> bool {
    rr_case_reset(case);
    let total: u64 = 0;
    if sa_std_fs_len(path_ptr, path_len, &total) != 0 { return false; };
    if total > 131072 { return false; };
    let fh: u64 = 0;
    if sa_std_fs_open_read(path_ptr, path_len, &fh) != 0 { return false; };
    let raw = [0u8; 131072];
    let read_n: u64 = 0;
    let rst: i32 = sa_std_fs_file_read(fh, &raw, 131072, &read_n);
    sa_fs_file_close(fh);
    if rst != 0 { return false; };
    let doc: u64 = sa_json_parse(&raw, read_n);
    if doc == 0 { return false; };
    if sa_json_kind(doc) != RR_JK_OBJECT { return false; };
    rr_doc_set_str_field(doc, STR_PTR("id"), STR_LEN("id"), case, 0);
    rr_doc_set_str_field(doc, STR_PTR("title"), STR_LEN("title"), case, 1);
    rr_doc_set_str_field(doc, STR_PTR("component"), STR_LEN("component"), case, 2);
    rr_doc_set_str_field(doc, STR_PTR("category"), STR_LEN("category"), case, 3);
    rr_doc_set_str_field(doc, STR_PTR("description"), STR_LEN("description"), case, 4);
    let tags_node: u64 = 0;
    if sa_json_object_get(doc, STR_PTR("tags"), STR_LEN("tags"), &tags_node) == 0 {
        if sa_json_kind(tags_node) == RR_JK_ARRAY {
            let cnt: u64 = 0;
            sa_json_value_count(tags_node, &cnt);
            let i: u64 = 0;
            while i < cnt {
                let el: u64 = 0;
                if sa_json_array_get(tags_node, i, &el) == 0 {
                    if sa_json_kind(el) == RR_JK_STRING {
                        let sp: ptr = sa_json_string_ptr(el);
                        let sl: u64 = sa_json_string_len(el);
                        rr_tag_push(case, sp, sl);
                    };
                };
                i = i + 1;
            }
        };
    };
    rr_doc_set_obj_field(doc, STR_PTR("input"), STR_LEN("input"), case, 6);
    rr_doc_set_obj_field(doc, STR_PTR("simulation"), STR_LEN("simulation"), case, 7);
    rr_doc_set_obj_field(doc, STR_PTR("negativeMatcher"), STR_LEN("negativeMatcher"), case, 8);
    rr_doc_set_obj_field(doc, STR_PTR("positiveInvariants"), STR_LEN("positiveInvariants"), case, 9);
    let rp: ptr = PTR_NULL();
    let rn: u64 = 0;
    if sa_json_object_get_string(doc, STR_PTR("runner"), STR_LEN("runner"), &rp, &rn) == 0 {
        case.has_runner = true;
        rr_case_set_field(case, 5, rp, rn);
    };
    return case.id_len > 0 && case.component_len > 0;
}

// ---- filter match (vendor TS load filter semantics) ----

fn rr_case_has_tag(case: &RegressionCase, tp: ptr, tn: u64) -> bool {
    let base: ptr = PTR_NULL();
    PTR_BYTE_ADD(base, &case.tags, 0);
    let i: u64 = 0;
    while i < case.tags_len {
        let off: u64 = 0;
        let ln: u64 = 0;
        rr_case_tag_at(case, i, &off, &ln);
        let tp2: ptr = base;
        PTR_BYTE_ADD(tp2, tp2, off);
        if rr_byte_eq(tp2, ln, tp, tn) { return true; };
        i = i + 1;
    }
    return false;
}

fn rr_filter_tag_constraint(fdoc: u64, key: ptr, key_len: u64, case: &RegressionCase) -> bool {
    // true = constraint satisfied (or absent). TS: a present tag/tags filter
    // requires at least one required tag in parsed.tags.
    let node: u64 = 0;
    if sa_json_object_get(fdoc, key, key_len, &node) != 0 { return true; };
    if sa_json_kind(node) == RR_JK_STRING {
        let sp: ptr = sa_json_string_ptr(node);
        let sl: u64 = sa_json_string_len(node);
        return rr_case_has_tag(case, sp, sl);
    };
    if sa_json_kind(node) == RR_JK_ARRAY {
        let cnt: u64 = 0;
        sa_json_value_count(node, &cnt);
        let i: u64 = 0;
        while i < cnt {
            let el: u64 = 0;
            if sa_json_array_get(node, i, &el) == 0 {
                if sa_json_kind(el) == RR_JK_STRING {
                    let sp: ptr = sa_json_string_ptr(el);
                    let sl: u64 = sa_json_string_len(el);
                    if rr_case_has_tag(case, sp, sl) { return true; };
                };
            };
            i = i + 1;
        }
        return false;
    };
    return true;
}

fn rr_filter_match(filter: &RegressionCaseFilter, case: &RegressionCase) -> bool {
    if !filter.has_filter { return true; };
    let fp: ptr = PTR_NULL();
    PTR_BYTE_ADD(fp, &filter.json, 0);
    let fdoc: u64 = sa_json_parse(fp, filter.json_len);
    if fdoc == 0 { return true; };
    let p: ptr = PTR_NULL();
    let n: u64 = 0;
    if sa_json_object_get_string(fdoc, STR_PTR("id"), STR_LEN("id"), &p, &n) == 0 && n > 0 {
        let cp: ptr = rr_case_field_ptr(case, 0);
        if !rr_eq_ci(cp, case.id_len, p, n) { return false; };
    };
    if sa_json_object_get_string(fdoc, STR_PTR("component"), STR_LEN("component"), &p, &n) == 0 && n > 0 {
        let cp: ptr = rr_case_field_ptr(case, 2);
        if !rr_contains_ci(cp, case.component_len, p, n) { return false; };
    };
    if sa_json_object_get_string(fdoc, STR_PTR("category"), STR_LEN("category"), &p, &n) == 0 {
        let cp: ptr = rr_case_field_ptr(case, 3);
        if !rr_byte_eq(cp, case.category_len, p, n) { return false; };
    };
    if !rr_filter_tag_constraint(fdoc, STR_PTR("tag"), STR_LEN("tag"), case) { return false; };
    if !rr_filter_tag_constraint(fdoc, STR_PTR("tags"), STR_LEN("tags"), case) { return false; };
    return true;
}

// ---- pretty printer (JSON.stringify(x, null, 2) for parsed docs) ----

fn rr_pretty_indent(out: &RrStr, depth: u64) -> void {
    let i: u64 = 0;
    let total: u64 = depth * 2;
    while i < total {
        if out.len < 131072 { out.bytes[out.len] = 32; out.len = out.len + 1; };
        i = i + 1;
    }
}

fn rr_pretty(node: u64, depth: u64, out: &RrStr) -> void {
    if depth > 24 {
        let bh: u64 = 0;
        if sa_json_stringify(node, &bh) == 0 {
            let p: ptr = sa_json_buffer_data(bh);
            let n: u64 = sa_json_buffer_len(bh);
            rr_push(out, p, n);
            sa_json_buffer_free(bh);
        };
        return;
    };
    let k: u32 = sa_json_kind(node);
    if k == RR_JK_OBJECT {
        let cnt: u64 = 0;
        sa_json_value_count(node, &cnt);
        if cnt == 0 {
            rr_push_lit(out, STR_PTR("{}"), STR_LEN("{}"));
            return;
        };
        rr_push_lit(out, STR_PTR("{"), STR_LEN("{"));
        let i: u64 = 0;
        while i < cnt {
            if i > 0 { rr_push_lit(out, STR_PTR(","), STR_LEN(",")); };
            rr_push_lit(out, STR_PTR("\n"), STR_LEN("\n"));
            rr_pretty_indent(out, depth + 1);
            let kp: ptr = PTR_NULL();
            let kl: u64 = 0;
            sa_json_object_key_at(node, i, &kp, &kl);
            rr_push_lit(out, STR_PTR("\""), STR_LEN("\""));
            rr_push_json_escape(out, kp, kl);
            rr_push_lit(out, STR_PTR("\": "), STR_LEN("\": "));
            let child: u64 = 0;
            if sa_json_object_get(node, kp, kl, &child) == 0 {
                rr_pretty(child, depth + 1, out);
            } else {
                rr_push_lit(out, STR_PTR("null"), STR_LEN("null"));
            };
            i = i + 1;
        }
        rr_push_lit(out, STR_PTR("\n"), STR_LEN("\n"));
        rr_pretty_indent(out, depth);
        rr_push_lit(out, STR_PTR("}"), STR_LEN("}"));
        return;
    };
    if k == RR_JK_ARRAY {
        let cnt: u64 = 0;
        sa_json_value_count(node, &cnt);
        if cnt == 0 {
            rr_push_lit(out, STR_PTR("[]"), STR_LEN("[]"));
            return;
        };
        rr_push_lit(out, STR_PTR("["), STR_LEN("["));
        let i: u64 = 0;
        while i < cnt {
            if i > 0 { rr_push_lit(out, STR_PTR(","), STR_LEN(",")); };
            rr_push_lit(out, STR_PTR("\n"), STR_LEN("\n"));
            rr_pretty_indent(out, depth + 1);
            let el: u64 = 0;
            if sa_json_array_get(node, i, &el) == 0 {
                rr_pretty(el, depth + 1, out);
            } else {
                rr_push_lit(out, STR_PTR("null"), STR_LEN("null"));
            };
            i = i + 1;
        }
        rr_push_lit(out, STR_PTR("\n"), STR_LEN("\n"));
        rr_pretty_indent(out, depth);
        rr_push_lit(out, STR_PTR("]"), STR_LEN("]"));
        return;
    };
    if k == RR_JK_STRING {
        let sp: ptr = sa_json_string_ptr(node);
        let sl: u64 = sa_json_string_len(node);
        rr_push_lit(out, STR_PTR("\""), STR_LEN("\""));
        rr_push_json_escape(out, sp, sl);
        rr_push_lit(out, STR_PTR("\""), STR_LEN("\""));
        return;
    };
    // numbers / bool / null: compact text of the scalar node
    let bh: u64 = 0;
    if sa_json_stringify(node, &bh) == 0 {
        let p: ptr = sa_json_buffer_data(bh);
        let n: u64 = sa_json_buffer_len(bh);
        rr_push(out, p, n);
        sa_json_buffer_free(bh);
    };
}

// ---- RegressionCaseResult list + field helpers ----

fn rr_result_set_str(result: &RegressionCaseResult, which: u64, src: ptr, n: u64) -> void {
let m: u64 = n;
let i: u64 = 0;
if which == 0 {
if m > 256 { m = 256;};
while i < m { result.id[i] = PTR_BYTE_AT(src, i); i = i + 1;}
result.id_len = m;
return;
};
if which == 1 {
if m > 512 { m = 512;};
while i < m { result.title[i] = PTR_BYTE_AT(src, i); i = i + 1;}
result.title_len = m;
return;
};
if m > 256 { m = 256;};
while i < m { result.component[i] = PTR_BYTE_AT(src, i); i = i + 1;}
result.component_len = m;
}

fn rr_result_reset(result: &RegressionCaseResult) -> void {
result.id_len = 0;
result.title_len = 0;
result.component_len = 0;
result.passed = false;
result.duration_ms = 0;
result.regression_detected = false;
result.violations_len = 0;
result.logs_len = 0;
}

fn rr_viol_push(result: &RegressionCaseResult, src: ptr, n: u64) -> void {
if result.violations_len >= 256 { return;};
let off: u64 = 0;
let i: u64 = 0;
while i < result.violations_len {
off = off + result.violation_lens[i];
i = i + 1;
}
if off + n > 65536 { return;};
let j: u64 = 0;
while j < n {
result.violations[off + j] = PTR_BYTE_AT(src, j);
j = j + 1;
}
result.violation_lens[result.violations_len] = n;
result.violations_len = result.violations_len + 1;
}

fn rr_log_push(result: &RegressionCaseResult, src: ptr, n: u64) -> void {
if result.logs_len >= 256 { return;};
let off: u64 = 0;
let i: u64 = 0;
while i < result.logs_len {
off = off + result.log_lens[i];
i = i + 1;
}
if off + n > 131072 { return;};
let j: u64 = 0;
while j < n {
result.logs[off + j] = PTR_BYTE_AT(src, j);
j = j + 1;
}
result.log_lens[result.logs_len] = n;
result.logs_len = result.logs_len + 1;
}

fn rr_result_json(result: &RegressionCaseResult, out: &RrStr) -> void {
rr_clear(out);
rr_push_lit(out, STR_PTR("{\"id\":\""), STR_LEN("{\"id\":\""));
let p: ptr = PTR_NULL();
PTR_BYTE_ADD(p, &result.id, 0);
rr_push_json_escape(out, p, result.id_len);
rr_push_lit(out, STR_PTR("\",\"title\":\""), STR_LEN("\",\"title\":\""));
let p2: ptr = PTR_NULL();
PTR_BYTE_ADD(p2, &result.title, 0);
rr_push_json_escape(out, p2, result.title_len);
rr_push_lit(out, STR_PTR("\",\"component\":\""), STR_LEN("\",\"component\":\""));
let p3: ptr = PTR_NULL();
PTR_BYTE_ADD(p3, &result.component, 0);
rr_push_json_escape(out, p3, result.component_len);
rr_push_lit(out, STR_PTR("\",\"passed\":"), STR_LEN("\",\"passed\":"));
if result.passed { rr_push_lit(out, STR_PTR("true"), STR_LEN("true"));} else { rr_push_lit(out, STR_PTR("false"), STR_LEN("false"));};
rr_push_lit(out, STR_PTR(",\"durationMs\":"), STR_LEN(",\"durationMs\":"));
rr_push_u64(out, result.duration_ms);
rr_push_lit(out, STR_PTR(",\"regressionDetected\":"), STR_LEN(",\"regressionDetected\":"));
if result.regression_detected { rr_push_lit(out, STR_PTR("true"), STR_LEN("true"));} else { rr_push_lit(out, STR_PTR("false"), STR_LEN("false"));};
rr_push_lit(out, STR_PTR(",\"violations\":["), STR_LEN(",\"violations\":["));
let vb: ptr = PTR_NULL();
PTR_BYTE_ADD(vb, &result.violations, 0);
let off: u64 = 0;
let i: u64 = 0;
while i < result.violations_len {
if i > 0 { rr_push_lit(out, STR_PTR(","), STR_LEN(","));};
rr_push_lit(out, STR_PTR("\""), STR_LEN("\""));
let ep: ptr = vb;
PTR_BYTE_ADD(ep, ep, off);
rr_push_json_escape(out, ep, result.violation_lens[i]);
rr_push_lit(out, STR_PTR("\""), STR_LEN("\""));
off = off + result.violation_lens[i];
i = i + 1;
}
rr_push_lit(out, STR_PTR("],\"logs\":["), STR_LEN("],\"logs\":["));
let lb: ptr = PTR_NULL();
PTR_BYTE_ADD(lb, &result.logs, 0);
let off2: u64 = 0;
let j: u64 = 0;
while j < result.logs_len {
if j > 0 { rr_push_lit(out, STR_PTR(","), STR_LEN(","));};
rr_push_lit(out, STR_PTR("\""), STR_LEN("\""));
let ep2: ptr = lb;
PTR_BYTE_ADD(ep2, ep2, off2);
rr_push_json_escape(out, ep2, result.log_lens[j]);
rr_push_lit(out, STR_PTR("\""), STR_LEN("\""));
off2 = off2 + result.log_lens[j];
j = j + 1;
}
rr_push_lit(out, STR_PTR("]}"), STR_LEN("]}"));
}

fn rr_report_push(report: &RegressionSuiteReport, src: ptr, n: u64) -> void {
if report.results_len >= 512 { return;};
let off: u64 = 0;
let i: u64 = 0;
while i < report.results_len {
off = off + report.result_lens[i];
i = i + 1;
}
if off + n > 4194304 { return;};
let j: u64 = 0;
while j < n {
report.results[off + j] = PTR_BYTE_AT(src, j);
j = j + 1;
}
report.result_lens[report.results_len] = n;
report.results_len = report.results_len + 1;
}

fn rr_suffix_json(p: ptr, n: u64) -> bool {
if n < 5 { return false;};
let base: u64 = n - 5;
let want: ptr = STR_PTR(".json");
let i: u64 = 0;
while i < 5 {
let x: u8 = PTR_BYTE_AT(p, base + i);
let y: u8 = PTR_BYTE_AT(want, i);
if x!= y { return false;};
i = i + 1;
}
return true;
}

// ---- pattern extraction (negativeMatcher.forbiddenPatterns) ----

fn rr_extract_patterns(case_def: &RegressionCase, pats: &RrPatterns) -> void {
pats.count = 0;
pats.used = 0;
if case_def.negative_matcher_json_len == 0 { return;};
let np: ptr = rr_case_field_ptr(case_def, 8);
let doc: u64 = sa_json_parse(np, case_def.negative_matcher_json_len);
if doc == 0 { return;};
let arr: u64 = 0;
if sa_json_object_get(doc, STR_PTR("forbiddenPatterns"), STR_LEN("forbiddenPatterns"), &arr)!= 0 { return;};
if sa_json_kind(arr)!= RR_JK_ARRAY { return;};
let cnt: u64 = 0;
sa_json_value_count(arr, &cnt);
let i: u64 = 0;
while i < cnt && pats.count < 64 {
let el: u64 = 0;
if sa_json_array_get(arr, i, &el) == 0 {
if sa_json_kind(el) == RR_JK_STRING {
let sp: ptr = sa_json_string_ptr(el);
let sl: u64 = sa_json_string_len(el);
let m: u64 = sl;
if pats.used + m > 32768 { m = 32768 - pats.used;};
let j: u64 = 0;
while j < m {
pats.bytes[pats.used + j] = PTR_BYTE_AT(sp, j);
j = j + 1;
}
pats.lens[pats.count] = m;
pats.used = pats.used + m;
pats.count = pats.count + 1;
};
};
i = i + 1;
}
}

fn rr_pattern_at(pats: &RrPatterns, idx: u64, out_ptr: &ptr, out_len: &u64) -> void {
let off: u64 = 0;
let i: u64 = 0;
while i < idx {
off = off + pats.lens[i];
i = i + 1;
}
let p: ptr = PTR_NULL();
PTR_BYTE_ADD(p, &pats.bytes, off);
*out_ptr = p;
*out_len = pats.lens[idx];
}

// ---- recordRegressionCase (vendor TS L114-150) ----

fn rr_case_doc_obj_or_empty(case_def: &RegressionCase, which: u64, doc: u64, key: ptr, key_len: u64, defaults: bool) -> void {
let flen: u64 = rr_case_field_len(case_def, which);
if flen > 0 {
let fp: ptr = rr_case_field_ptr(case_def, which);
let sub: u64 = sa_json_parse(fp, flen);
if sub!= 0 {
sa_json_object_set_node(doc, key, key_len, sub);
return;
};
};
if defaults {
let empty: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
if empty!= 0 {
sa_json_object_set_node(doc, key, key_len, empty);
};
};
}

fn rr_build_case_doc(case_def: &RegressionCase, id_s: &RrSmall, title_s: &RrSmall, comp_s: &RrSmall, defaults: bool) -> u64 {
let doc: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
if doc == 0 { return 0;};
sa_json_object_set_string(doc, STR_PTR("id"), STR_LEN("id"), rs_ptr(id_s), id_s.len);
sa_json_object_set_string(doc, STR_PTR("title"), STR_LEN("title"), rs_ptr(title_s), title_s.len);
sa_json_object_set_string(doc, STR_PTR("component"), STR_LEN("component"), rs_ptr(comp_s), comp_s.len);
let adoc: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
if adoc!= 0 {
let base: ptr = PTR_NULL();
PTR_BYTE_ADD(base, &case_def.tags, 0);
let i: u64 = 0;
while i < case_def.tags_len {
let off: u64 = 0;
let ln: u64 = 0;
rr_case_tag_at(case_def, i, &off, &ln);
let tp: ptr = base;
PTR_BYTE_ADD(tp, tp, off);
sa_json_array_push_string(adoc, tp, ln);
i = i + 1;
}
sa_json_object_set_node(doc, STR_PTR("tags"), STR_LEN("tags"), adoc);
};
if case_def.category_len > 0 {
let cp: ptr = rr_case_field_ptr(case_def, 3);
let sc1: i32 = sa_json_object_set_string(doc, STR_PTR("category"), STR_LEN("category"), cp, case_def.category_len);
} else if defaults {
let sc2: i32 = sa_json_object_set_string(doc, STR_PTR("category"), STR_LEN("category"), STR_PTR("state_machine"), STR_LEN("state_machine"));
};
if case_def.description_len > 0 {
let dp: ptr = rr_case_field_ptr(case_def, 4);
let sd1: i32 = sa_json_object_set_string(doc, STR_PTR("description"), STR_LEN("description"), dp, case_def.description_len);
} else if defaults {
let sd2: i32 = sa_json_object_set_string(doc, STR_PTR("description"), STR_LEN("description"), STR_PTR(""), STR_LEN(""));
};
rr_case_doc_obj_or_empty(case_def, 6, doc, STR_PTR("input"), STR_LEN("input"), defaults);
rr_case_doc_obj_or_empty(case_def, 7, doc, STR_PTR("simulation"), STR_LEN("simulation"), defaults);
rr_case_doc_obj_or_empty(case_def, 8, doc, STR_PTR("negativeMatcher"), STR_LEN("negativeMatcher"), defaults);
rr_case_doc_obj_or_empty(case_def, 9, doc, STR_PTR("positiveInvariants"), STR_LEN("positiveInvariants"), defaults);
if case_def.has_runner {
let rp: ptr = rr_case_field_ptr(case_def, 5);
sa_json_object_set_string(doc, STR_PTR("runner"), STR_LEN("runner"), rp, case_def.runner_len);
};
return doc;
}

fn rr_doc_to_case_json(doc: u64, out: &RecordRegressionCaseResult) -> void {
let bh: u64 = 0;
if sa_json_stringify(doc, &bh)!= 0 { return;};
let p: ptr = sa_json_buffer_data(bh);
let n: u64 = sa_json_buffer_len(bh);
let m: u64 = n;
if m > 131072 { m = 131072;};
let i: u64 = 0;
while i < m {
out.case_json[i] = PTR_BYTE_AT(p, i);
i = i + 1;
}
out.case_json_len = m;
sa_json_buffer_free(bh);
}

fn rr_record_fail(out: &RecordRegressionCaseResult, case_def: &RegressionCase, msg: ptr, msg_len: u64) -> void {
out.has_error = true;
let m: u64 = msg_len;
if m > 1024 { m = 1024;};
let i: u64 = 0;
while i < m {
out.error[i] = PTR_BYTE_AT(msg, i);
i = i + 1;
}
out.error_len = m;
// TS early return carries the input case verbatim ("case: caseDef as RegressionCase")
let id_r = RrSmall { bytes: [0u8; 4096], len: 0};
let title_r = RrSmall { bytes: [0u8; 4096], len: 0};
let comp_r = RrSmall { bytes: [0u8; 4096], len: 0};
let ip: ptr = rr_case_field_ptr(case_def, 0);
rs_push(&id_r, ip, case_def.id_len);
let tp: ptr = rr_case_field_ptr(case_def, 1);
rs_push(&title_r, tp, case_def.title_len);
let cp: ptr = rr_case_field_ptr(case_def, 2);
rs_push(&comp_r, cp, case_def.component_len);
let doc: u64 = rr_build_case_doc(case_def, &id_r, &title_r, &comp_r, false);
if doc!= 0 {
rr_doc_to_case_json(doc, out);
};
}

fn recordRegressionCase(case_def: &RegressionCase, has_cwd: bool, cwd_ptr: ptr, cwd_len: u64, out: &RecordRegressionCaseResult) -> i32 {
out.ok = false;
out.path_len = 0;
out.case_json_len = 0;
out.has_error = false;
out.error_len = 0;
let id_t = RrSmall { bytes: [0u8; 4096], len: 0};
let title_t = RrSmall { bytes: [0u8; 4096], len: 0};
let comp_t = RrSmall { bytes: [0u8; 4096], len: 0};
rs_copy_trimmed_field(&id_t, case_def, 0);
rs_copy_trimmed_field(&title_t, case_def, 1);
rs_copy_trimmed_field(&comp_t, case_def, 2);
if id_t.len == 0 {
rr_record_fail(out, case_def, STR_PTR("Missing required 'id' for regression case"), STR_LEN("Missing required 'id' for regression case"));
return 0;
};
if title_t.len == 0 {
rr_record_fail(out, case_def, STR_PTR("Missing required 'title' for regression case"), STR_LEN("Missing required 'title' for regression case"));
return 0;
};
if comp_t.len == 0 {
rr_record_fail(out, case_def, STR_PTR("Missing required 'component' for regression case"), STR_LEN("Missing required 'component' for regression case"));
return 0;
};
let sid = RrSmall { bytes: [0u8; 4096], len: 0};
rs_sanitize_id(&sid, &id_t);
let doc: u64 = rr_build_case_doc(case_def, &sid, &title_t, &comp_t, true);
if doc == 0 {
rr_record_fail(out, case_def, STR_PTR("Failed to build regression case"), STR_LEN("Failed to build regression case"));
return 0;
};
rr_doc_to_case_json(doc, out);
let pretty = RrStr { bytes: [0u8; 131072], len: 0};
rr_pretty(doc, 0, &pretty);
let dir = RrSmall { bytes: [0u8; 4096], len: 0};
rr_resolve_dir(&dir, has_cwd, cwd_ptr, cwd_len);
let probe: u64 = 0;
if sa_std_fs_len(rs_ptr(&dir), dir.len, &probe)!= 0 {
sa_fs_mkdir_p(rs_ptr(&dir), dir.len);
};
let path = RrSmall { bytes: [0u8; 4096], len: 0};
rs_push(&path, rs_ptr(&dir), dir.len);
rs_push_lit(&path, STR_PTR("/"), STR_LEN("/"));
rs_push(&path, rs_ptr(&sid), sid.len);
rs_push_lit(&path, STR_PTR(".case.json"), STR_LEN(".case.json"));
if sa_fs_write_file(rs_ptr(&path), path.len, rr_str_ptr(&pretty), pretty.len)!= 0 {
out.path_len = 0;
rr_record_fail(out, case_def, STR_PTR("Failed to write regression case file"), STR_LEN("Failed to write regression case file"));
return 0;
};
let i: u64 = 0;
while i < path.len && i < 2048 {
out.path[i] = path.bytes[i];
i = i + 1;
}
out.path_len = i;
out.ok = true;
return 0;
}

// ---- runRegressionCase (vendor TS L155-192: declarative evaluation only) ----

fn runRegressionCase(case_def: &RegressionCase, result: &RegressionCaseResult) -> i32 {
let started: i64 = sa_time_unix_ms();
rr_result_reset(result);
let ip: ptr = rr_case_field_ptr(case_def, 0);
rr_result_set_str(result, 0, ip, case_def.id_len);
let tp: ptr = rr_case_field_ptr(case_def, 1);
rr_result_set_str(result, 1, tp, case_def.title_len);
let cp: ptr = rr_case_field_ptr(case_def, 2);
rr_result_set_str(result, 2, cp, case_def.component_len);
let line = RrStr { bytes: [0u8; 131072], len: 0};
rr_push_lit(&line, STR_PTR("[replay] Starting case "), STR_LEN("[replay] Starting case "));
rr_push(&line, ip, case_def.id_len);
rr_push_lit(&line, STR_PTR(": "), STR_LEN(": "));
rr_push(&line, tp, case_def.title_len);
rr_log_push(result, rr_str_ptr(&line), line.len);
rr_log_push(result, STR_PTR("[replay] Executing declarative case evaluation"), STR_LEN("[replay] Executing declarative case evaluation"));
let pats = RrPatterns { bytes: [0u8; 32768], lens: [0u64; 64], count: 0, used: 0};
rr_extract_patterns(case_def, &pats);
let rounds: u64 = 0;
let rcnt: u64 = 0;
if case_def.simulation_json_len > 0 {
let sp: ptr = rr_case_field_ptr(case_def, 7);
let sdoc: u64 = sa_json_parse(sp, case_def.simulation_json_len);
if sdoc!= 0 {
if sa_json_object_get(sdoc, STR_PTR("rounds"), STR_LEN("rounds"), &rounds) == 0 {
if sa_json_kind(rounds) == RR_JK_ARRAY {
let vc9: i32 = sa_json_value_count(rounds, &rcnt);
} else {
rounds = 0;
};
};
};
};
let round_txt = RrStr { bytes: [0u8; 131072], len: 0};
let pi: u64 = 0;
while pi < pats.count {
let pptr: ptr = PTR_NULL();
let plen: u64 = 0;
rr_pattern_at(&pats, pi, &pptr, &plen);
let ri: u64 = 0;
while ri < rcnt {
let el: u64 = 0;
if sa_json_array_get(rounds, ri, &el) == 0 {
rr_clear(&round_txt);
let bh: u64 = 0;
if sa_json_stringify(el, &bh) == 0 {
let bp: ptr = sa_json_buffer_data(bh);
let bn: u64 = sa_json_buffer_len(bh);
rr_push(&round_txt, bp, bn);
sa_json_buffer_free(bh);
};
if rr_contains(rr_str_ptr(&round_txt), round_txt.len, pptr, plen) {
result.regression_detected = true;
rr_clear(&line);
rr_push_lit(&line, STR_PTR("Negative matcher violation: found forbidden pattern \""), STR_LEN("Negative matcher violation: found forbidden pattern \""));
rr_push(&line, pptr, plen);
rr_push_lit(&line, STR_PTR("\" in simulation"), STR_LEN("\" in simulation"));
rr_viol_push(result, rr_str_ptr(&line), line.len);
};
};
ri = ri + 1;
}
pi = pi + 1;
}
let ended: i64 = sa_time_unix_ms();
let dur: i64 = ended - started;
if dur < 0 { dur = 0;};
result.duration_ms = dur as u64;
result.passed = result.violations_len == 0;
rr_clear(&line);
rr_push_lit(&line, STR_PTR("[replay] Finished "), STR_LEN("[replay] Finished "));
rr_push(&line, ip, case_def.id_len);
rr_push_lit(&line, STR_PTR(": "), STR_LEN(": "));
if result.passed {
rr_push_lit(&line, STR_PTR("PASS"), STR_LEN("PASS"));
} else {
rr_push_lit(&line, STR_PTR("FAIL"), STR_LEN("FAIL"));
};
rr_push_lit(&line, STR_PTR(" ("), STR_LEN(" ("));
rr_push_u64(&line, result.duration_ms);
rr_push_lit(&line, STR_PTR("ms)"), STR_LEN("ms)"));
rr_log_push(result, rr_str_ptr(&line), line.len);
return 0;
}

// ---- runRegressionSuite (vendor TS L197-231) ----

fn runRegressionSuite(filter: &RegressionCaseFilter, has_cwd: bool, cwd_ptr: ptr, cwd_len: u64, report: &RegressionSuiteReport) -> i32 {
let started: i64 = sa_time_unix_ms();
report.ok = false;
report.total_cases = 0;
report.passed_cases = 0;
report.failed_cases = 0;
report.regressed_cases = 0;
report.duration_ms = 0;
report.results_len = 0;
report.summary_len = 0;
report.err_len = 0;
let dir = RrSmall { bytes: [0u8; 4096], len: 0};
rr_resolve_dir(&dir, has_cwd, cwd_ptr, cwd_len);
let case = RegressionCase { id: [0u8; 256], id_len: 0, title: [0u8; 512], title_len: 0, component: [0u8; 256], component_len: 0, tags: [0u8; 4096], tag_lens: [0u64; 32], tags_len: 0, category: [0u8; 128], category_len: 0, description: [0u8; 2048], description_len: 0, input_json: [0u8; 65536], input_json_len: 0, simulation_json: [0u8; 65536], simulation_json_len: 0, negative_matcher_json: [0u8; 16384], negative_matcher_json_len: 0, positive_invariants_json: [0u8; 16384], positive_invariants_json_len: 0, has_runner: false, runner: [0u8; 128], runner_len: 0 };
let result = RegressionCaseResult { id: [0u8; 256], id_len: 0, title: [0u8; 512], title_len: 0, component: [0u8; 256], component_len: 0, passed: false, duration_ms: 0, regression_detected: false, violations: [0u8; 65536], violation_lens: [0u64; 256], violations_len: 0, logs: [0u8; 131072], log_lens: [0u64; 256], logs_len: 0 };
let probe: u64 = 0;
if sa_std_fs_len(rs_ptr(&dir), dir.len, &probe) == 0 {
let dh: u64 = 0;
if sa_std_fs_read_dir_json(rs_ptr(&dir), dir.len, 65536, &dh) == 0 {
let lp: ptr = sa_fs_dir_buffer_data(dh);
let ll: u64 = sa_fs_dir_buffer_len(dh);
let listing: u64 = sa_json_parse(lp, ll);
if listing!= 0 && sa_json_kind(listing) == RR_JK_ARRAY {
let cnt: u64 = 0;
sa_json_value_count(listing, &cnt);
let path = RrSmall { bytes: [0u8; 4096], len: 0};
let rjson = RrStr { bytes: [0u8; 131072], len: 0};
let i: u64 = 0;
while i < cnt {
let entry: u64 = 0;
if sa_json_array_get(listing, i, &entry) == 0 {
if sa_json_kind(entry) == RR_JK_STRING {
let np: ptr = sa_json_string_ptr(entry);
let nl: u64 = sa_json_string_len(entry);
if rr_suffix_json(np, nl) {
rs_clear(&path);
rs_push(&path, rs_ptr(&dir), dir.len);
rs_push_lit(&path, STR_PTR("/"), STR_LEN("/"));
rs_push(&path, np, nl);
if rr_parse_case_file(rs_ptr(&path), path.len, &case) {
if rr_filter_match(filter, &case) {
runRegressionCase(&case, &result);
report.total_cases = report.total_cases + 1;
if result.passed {
report.passed_cases = report.passed_cases + 1;
} else {
report.failed_cases = report.failed_cases + 1;
};
if result.regression_detected {
report.regressed_cases = report.regressed_cases + 1;
};
rr_result_json(&result, &rjson);
rr_report_push(report, rr_str_ptr(&rjson), rjson.len);
};
};
};
};
};
i = i + 1;
}
};
sa_fs_dir_buffer_free(dh);
};
};
let ended: i64 = sa_time_unix_ms();
let dur: i64 = ended - started;
if dur < 0 { dur = 0;};
report.duration_ms = dur as u64;
report.ok = report.failed_cases == 0;
let sum = RrStr { bytes: [0u8; 131072], len: 0};
rr_push_lit(&sum, STR_PTR("\n• 运行案例数："), STR_LEN("\n• 运行案例数："));
rr_push_u64(&sum, report.total_cases);
rr_push_lit(&sum, STR_PTR(" 个\n• 通过："), STR_LEN(" 个\n• 通过："));
rr_push_u64(&sum, report.passed_cases);
rr_push_lit(&sum, STR_PTR(" | 失败："), STR_LEN(" | 失败："));
rr_push_u64(&sum, report.failed_cases);
rr_push_lit(&sum, STR_PTR("\n"), STR_LEN("\n"));
if report.regressed_cases > 0 {
rr_push_lit(&sum, STR_PTR("• 🚨 历史回归警报：发现 "), STR_LEN("• 🚨 历史回归警报：发现 "));
rr_push_u64(&sum, report.regressed_cases);
rr_push_lit(&sum, STR_PTR(" 个旧 Bug 再次复发！"), STR_LEN(" 个旧 Bug 再次复发！"));
} else {
rr_push_lit(&sum, STR_PTR("• ✅ 历史回归检测：0 个旧 Bug 复发"), STR_LEN("• ✅ 历史回归检测：0 个旧 Bug 复发"));
};
rr_push_lit(&sum, STR_PTR("\n• 总耗时："), STR_LEN("\n• 总耗时："));
rr_push_u64(&sum, report.duration_ms);
rr_push_lit(&sum, STR_PTR("ms"), STR_LEN("ms"));
let m: u64 = sum.len;
if m > 4096 { m = 4096;};
let si: u64 = 0;
while si < m {
report.summary[si] = sum.bytes[si];
si = si + 1;
}
report.summary_len = m;
return 0;
}
