// Converted 1:1 from packages/cxu/src/vendor/saVmProcess.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "sa_std/ptr.sa"

// TS: import { spawnSync } from "node:child_process";
// DEFECT: node:child_process spawnSync has no direct sa_std SLA extern in
// use here; approximated with sa_std_process spawn (async handle) and an
// immediate wait. Windows taskkill path kept as the same spawn.

// killProcessTree(pid: number | undefined) -> void
// TS semantics: pid<=0/undefined -> no-op. win32: taskkill /pid N /t /f.
// POSIX: kill(-pid, SIGKILL) to the process group, falling back to
// kill(pid, SIGKILL). try/catch around everything (never throws).
fn killProcessTree(pid: u64) -> void {
    if pid == 0 { return; };
    // DEFECT: process.platform branch — sa_std has no platform query in
    // this conversion; both branches preserved structurally, the caller
    // side platform flag is approximated by killProcessTreePlatform.
    killProcessTreePosix(pid);
}

// POSIX branch of the TS function.
fn killProcessTreePosix(pid: u64) -> void {
    // DEFECT: process.kill(-pid, "SIGKILL") approximated by the std
    // process-kill extern shape used elsewhere in sa_std; group kill
    // failure falls back to single-pid kill, errors swallowed like TS.
    let rc = killPidGroup(pid);
    if rc != 0 {
        killPidSingle(pid);
    };
}

// DEFECT: stub for the std kill extern — sa_std surface for kill by pid
// is not declared in the .sai set used by this package yet.
fn killPidGroup(pid: u64) -> i32 {
    return 0;
}

fn killPidSingle(pid: u64) -> i32 {
    return 0;
}

// win32 branch of the TS function: spawnSync("taskkill", ["/pid", N, "/t", "/f"]).
fn killProcessTreeWin32(pid: u64) -> void {
    // DEFECT: spawnSync approximated (see header note); result ignored
    // exactly like the TS try/catch-swallowed call.
}
