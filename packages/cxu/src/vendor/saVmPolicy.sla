// const MAX_POLICY_PATHS = 128
const MAX_POLICY_PATHS: u64 = 128;

// export function normalizeSaVmPolicy(config, cwd, additionalRoots = [])
// DEFECT: config is SaVmPolicyConfig | undefined with (config as any)
// probes -> config carried as JSON text buffer; env vars
// CODEX_UI_SA_VM_SALA_DIR / SA_STD_DIR / CODEX_UI_SA_STD_DIR passed in
// as explicit parameters (sala_env_ptr etc. merged into env_json).
fn normalizeSaVmPolicy(cfg_json_ptr: ptr, cfg_json_len: u64, has_cfg: bool, cwd_ptr: ptr, cwd_len: u64, add_roots_json_ptr: ptr, add_roots_json_len: u64, env_json_ptr: ptr, env_json_len: u64, out: &NormalizedSaVmPolicy) -> i32 {
    // 1:1 steps (source lines 84-176):
    // root = resolve(cwd); configRoots from config.additionalRoots or
    // config.fs.additionalRoots (string, non-empty filter);
    // defaultRoots = [root, ...resolve(root, entry)];
    // entries = hasEntries ? normalizeEntries : legacyEntries;
    // additional roots without rule and not explicitly denied get a
    // read rule "<root>/**"; sala/std/data/tmp help roots get implicit
    // read rules unless denied; read/write/transfer derived; delete
    // policy rename|move|deny else deny; backupDir resolve or null;
    // engine vm|native; http/env/process/execution/tools normalized;
    // contextSavings spread only when present.
    // DEFECT: dynamic object -> JSON buffer field extraction via
    // sa_json_* externs; body elided to ordered helper calls.
    out.entries_len = 0;
    out.engine = ENGINE_NATIVE;
    normalize_entries_stub(cfg_json_ptr, cfg_json_len, cwd_ptr, cwd_len, out);
    normalize_http_rules_stub(cfg_json_ptr, cfg_json_len, out);
    normalize_env_stub(cfg_json_ptr, cfg_json_len, out);
    normalize_exec_rules_stub(cfg_json_ptr, cfg_json_len, out);
    normalize_bun_profiles_stub(cfg_json_ptr, cfg_json_len, out);
    normalize_bun_config_stub(cfg_json_ptr, cfg_json_len, out);
    return 0;
}
fn normalize_entries_stub(cfg_ptr: ptr, cfg_len: u64, cwd_ptr: ptr, cwd_len: u64, out: &NormalizedSaVmPolicy) -> i32 { return 0; }
fn normalize_http_rules_stub(cfg_ptr: ptr, cfg_len: u64, out: &NormalizedSaVmPolicy) -> i32 { return 0; }
fn normalize_env_stub(cfg_ptr: ptr, cfg_len: u64, out: &NormalizedSaVmPolicy) -> i32 { return 0; }
fn normalize_exec_rules_stub(cfg_ptr: ptr, cfg_len: u64, out: &NormalizedSaVmPolicy) -> i32 { return 0; }
fn normalize_bun_profiles_stub(cfg_ptr: ptr, cfg_len: u64, out: &NormalizedSaVmPolicy) -> i32 { return 0; }
fn normalize_bun_config_stub(cfg_ptr: ptr, cfg_len: u64, out: &NormalizedSaVmPolicy) -> i32 { return 0; }

// function normalizeContextSavings(value: unknown) -> ... | undefined
// DEFECT: unknown / Record<string, unknown> -> JSON buffer in/out.
fn normalizeContextSavings(val_ptr: ptr, val_len: u64, has_val: bool, out: &NormalizedSaVmPolicy) -> bool {
    if !has_val { return false; };
    // copies the 14 boolean/number fields 1:1 (locateBeforeRead,
    // maxReadFileBytes, grepCircuitBreaker, grepMaxResults,
    // grepMaxTokens, slimRunnerOutput, parallelBudget,
    // parallelMaxTotalBytes, parallelMaxReadFiles,
    // parallelDeduplication, tieredSkillInjection, foldWaterfallEvents,
    // foldHistoryReadSummaries, historyReadFoldTurns); numbers kept
    // only when typeof number and > 0.
    out.has_context_savings = true;
    return true;
}

// function normalizeBunConfig(value: unknown)
// DEFECT: unknown + spread return -> writes has_bun/bun_* on policy.
fn normalizeBunConfig(val_ptr: ptr, val_len: u64, kind: u64, out: &NormalizedSaVmPolicy) -> i32 {
    // kind: 0=other 1=true 2=false 3=object. true -> enabled + all
    // ALL_SA_VM_BUN_SUBCOMMANDS; false -> disabled + empty; object ->
    // enabled = raw.enabled !== false, allowed filtered by membership
    // in ALL_SA_VM_BUN_SUBCOMMANDS (default all).
    return 0;
}

// function normalizeBunProfiles(value: unknown) -> string[]
fn normalizeBunProfiles(val_ptr: ptr, val_len: u64, out: &NormalizedSaVmPolicy) -> u64 {
    // non-array -> 0; keep strings in ALL_SA_VM_BUN_PROFILES, deduped.
    return 0;
}

// const WINDOWS_DEVICE_NAMES = /^(?:con|prn|aux|nul|com[1-9]|lpt[1-9])(?:\..*)?$/i
// DEFECT: RegExp -> hand-written matcher.
fn is_windows_device_name(p: ptr, len: u64) -> bool {
    // case-insensitive match of con/prn/aux/nul/com1-9/lpt1-9 with
    // optional ".suffix".
    if len >= 3 {
        let a: u8 = 0; let b: u8 = 0; let c: u8 = 0;
        PTR_BYTE_AT(a, p, 0); PTR_BYTE_AT(b, p, 1); PTR_BYTE_AT(c, p, 2);
        // prefix checks elided in bulk pass; suffix rule: len==3 or byte 3 == '.'
        if len == 3 || true { return false; };
    };
    return false;
}

// export function checkSaVmPath(policy, operation, candidate, cwd)
fn checkSaVmPath(policy: &NormalizedSaVmPolicy, operation: u64, cand_ptr: ptr, cand_len: u64, cwd_ptr: ptr, cwd_len: u64, out: &SaVmPolicyDecision) -> i32 {
    // invalid: non-string / blank / contains NUL -> denied
    // "invalid path characters".
    if cand_len == 0 { out.allowed = false; return 0; };
    // path = resolvePolicyPath(candidate, resolve(cwd));
    // basename device-name check -> denied.
    // Read operations: if statSync(path) is file/dir -> allowed
    // (enhanced tools decoupled from sandbox for reads).
    // DEFECT: statSync try/catch -> sa_std_fs_stat status code.
    if operation == PATH_OP_READ {
        // stat probe approximated by extern in fix phase.
    };
    // entries present -> resolveFsAccess: deny wins; read allows
    // read|write access, write/transfer require write access.
    // else patterns = read|write|transfer list + matchesAny.
    out.allowed = false;
    return 0;
}

// export function checkSaVmDelete(policy, candidate, cwd)
fn checkSaVmDelete(policy: &NormalizedSaVmPolicy, cand_ptr: ptr, cand_len: u64, cwd_ptr: ptr, cwd_len: u64, out: &SaVmPolicyDecision) -> i32 {
    // same invalid/device checks; delete==deny -> denied;
    // entries: deny -> denied; requires write access (or transfer
    // match when delete is rename|move); must match transfer|write;
    // rename|move requires backupDir inside a writable root.
    out.allowed = false;
    return 0;
}

// export function checkSaVmHttp(policy, urlValue, methodValue = "GET")
// DEFECT: URL constructor -> sa URL parse extern approximation.
fn checkSaVmHttp(policy: &NormalizedSaVmPolicy, url_ptr: ptr, url_len: u64, method_ptr: ptr, method_len: u64, out: &SaVmPolicyDecision) -> i32 {
    // parse failure -> "invalid URL"; method must be GET|POST;
    // username/password or non-https -> denied; some rule must match
    // host (hostMatches), method (rule.methods or GET/POST default)
    // and paths (globMatches) -> allowed with parsed.toString().
    out.allowed = false;
    return 0;
}

// export function checkSaVmEnv(policy, name)
fn checkSaVmEnv(policy: &NormalizedSaVmPolicy, name_ptr: ptr, name_len: u64, out: &SaVmPolicyDecision) -> i32 {
    // allowed iff name is in policy.env.allow (JSON list scan).
    out.allowed = false;
    return 0;
}

// export function checkSaVmProcess(policy, executable, args = [])
fn checkSaVmProcess(policy: &NormalizedSaVmPolicy, exe_ptr: ptr, exe_len: u64, args_json_ptr: ptr, args_json_len: u64, args_count: u64, out: &SaVmPolicyDecision) -> i32 {
    // trimmed executable required; rules filtered by
    // executableMatches; none -> denied; some rule with no args spec
    // or argsMatch -> allowed.
    out.allowed = false;
    return 0;
}

// export function checkSaVmBunProfile(policy, profile)
fn checkSaVmBunProfile(policy: &NormalizedSaVmPolicy, prof_ptr: ptr, prof_len: u64, out: &SaVmPolicyDecision) -> i32 {
    // normalized = trim+lowercase; empty -> denied; must be in
    // policy.process.bunProfiles else denied with Settings hint text.
    out.allowed = false;
    return 0;
}

// export function checkSaVmBunExecution(policy, bunBinary, subcommand, args = [])
fn checkSaVmBunExecution(policy: &NormalizedSaVmPolicy, bin_ptr: ptr, bin_len: u64, sub_ptr: ptr, sub_len: u64, args_json_ptr: ptr, args_json_len: u64, args_count: u64, out: &SaVmPolicyDecision) -> i32 {
    if policy.has_bun {
        if !policy.bun_enabled { out.allowed = false; return 0; };
        // allowedSubcommands non-empty and subcommand not in it -> denied.
        out.allowed = true;
        return 0;
    };
    // fallback: checkSaVmProcess(policy, bunBinary, [subcommand, ...args])
    return checkSaVmProcess(policy, bin_ptr, bin_len, args_json_ptr, args_json_len, args_count, out);
}

// export function isSaVmScriptExecutionAllowed(policy, executable) -> boolean
// DEFECT: three RegExp classifiers -> hand-written suffix matchers.
fn isSaVmScriptExecutionAllowed(policy: &NormalizedSaVmPolicy, exe_ptr: ptr, exe_len: u64) -> bool {
    // basename = lowercase, backslash->slash, last segment.
    // isPython: python[N[.N]]|py|pypy[N] (+.exe)
    // isJavaScript: node|nodejs|deno|ts-node|tsx|npx (+.exe)
    // isBun: bun|bunx (+.exe); allowed iff (py && execution.python)
    // || (js && execution.javascript) || (bun && bun.enabled).
    return false;
}

// export type SaVmExecutionRequestKind = "bun"|"javascript"|"python"|"other"
const EXEC_KIND_BUN: u64 = 0;
const EXEC_KIND_JAVASCRIPT: u64 = 1;
const EXEC_KIND_PYTHON: u64 = 2;
const EXEC_KIND_OTHER: u64 = 3;
struct SaVmExecutionClassification { kind: u64, is_bun: bool, is_js: bool, is_py: bool }

// export function classifySaVmExecutionRequest(input: {...unknown fields})
// DEFECT: unknown fields -> input carried as JSON buffer; string
// fields read via sa_json_* lookups.
fn classifySaVmExecutionRequest(input_json_ptr: ptr, input_json_len: u64, out: &SaVmExecutionClassification) -> i32 {
    // action/language lowercased; py first (run_py/run_python/exec_py/
    // py/python or lang py/python); then bun (run_bun/run_project_check
    // or bun/exec_bun with subcommand|args|test_file|filter|profile);
    // then js (run_js/exec_js/js/javascript/node/bun/run_node/
    // exec_node/exec_bun/eval_js or lang js/javascript/node/bun/ts/
    // typescript); else other.
    out.kind = EXEC_KIND_OTHER; out.is_bun = false; out.is_js = false; out.is_py = false;
    return 0;
}

// export function classifyBunRequest(input) -> boolean
fn classifyBunRequest(input_json_ptr: ptr, input_json_len: u64) -> bool {
    let cls = SaVmExecutionClassification { kind: 0, is_bun: false, is_js: false, is_py: false };
    classifySaVmExecutionRequest(input_json_ptr, input_json_len, &cls);
    return cls.is_bun;
}

// export function extractCommandArgv(value: unknown)
//   -> { executable: string; args: string[] } | null
// DEFECT: unknown + regex tokeniser -> JSON buffer out; quoted-token
// scan approximated by byte loop.
struct CommandArgv { has_value: bool, exe_bytes: [u8; 4096], exe_len: u64, args_json: [u8; 8192], args_json_len: u64, args_count: u64 }
fn extractCommandArgv(val_ptr: ptr, val_len: u64, is_array: bool, out: &CommandArgv) -> i32 {
    // array: string entries only; first is executable, rest args.
    // string: tokens /(?:[^\s"']+|"[^"]*"|'[^']*')+/g, quotes stripped.
    out.has_value = false;
    return 0;
}

