// pkg-cxu vendor port (2026-10-26, FIX_PKG_CXU): content = backends/vmtool-security/src/security/saVmPolicy.sla -- the verified SLA
// translation of the identical TS source; only @import paths remapped to vendor
// siblings (registered diffs in _defects/FIX_PKG_CXU.md).
// Converted 1:1 from backends/vmtool-security/src/security/saVmPolicy.ts (CXU plugins @ f2cb649d).
// Source imports: { isAbsolute, join, relative, resolve, sep } from "node:path";
//   { statSync } from "node:fs"; { tmpdir } from "node:os";
//   types { SaVmBunSubcommand, SaVmContextSavingsConfig, SaVmDeletePolicy,
//     SaVmFsEntry, SaVmHttpAllowRule, SaVmPolicyConfig, SaVmProcessExecRule } from "@codex-ui/shared";
//   { ALL_SA_VM_BUN_PROFILES, ALL_SA_VM_BUN_SUBCOMMANDS } from "@codex-ui/shared";
//   { codexUiDataDir } from "@cxu/sdk-backend";
//
// FIX (fix phase, FIX_BACKENDS named item 1): in the bulk pass every
// function below was a comment-only stub, and the file did not even check
// standalone (bare assignment to a borrow in normalizeContextSavings).
// All functions are now faithful retranslations of the TS source over
// the JSON doc-handle model. Path handling is a local POSIX-style
// resolver (segment normalization) with the source's win32 drive-letter
// cases kept (resolvePattern's ^[A-Za-z]:\/ test, device names); statSync
// maps to sa_std_fs_metadata; process.env / tmpdir() map to sa_env_get
// (TMPDIR, fallback "/tmp"); codexUiDataDir is imported from the
// sdk-backend unit; the ALL_SA_VM_BUN_* tables are materialized locally
// with the exact @codex-ui/shared values (the same values the pkg units
// materialized in packages/cxu shared-types).
// Deliberate approximations: (1) checkSaVmHttp rebuilds parsed.toString()
// as scheme://host[:port]path[?query][#fragment] with a lowercased host
// and the default https port dropped — WHATWG percent-encoding
// normalization is not reproduced; (2) strings are bytes capped by the
// converted shapes (StrItem 1024, exec-rule path 4096 per the source
// slice, lists 128); non-string members of typed string arrays are
// skipped where the TS types guarantee strings (a non-string would
// throw in TS); (3) resolve() of a relative cwd resolves against itself
// (callers pass absolute cwds).

@import "sa_std/ptr.sa"
@import "sa_std/string.sa"
@import "sa_std/string.sai"
@import "sa_std/encoding/json.sai"
@import "sa_std/env.sai"
@import "sa_std/fs.sai"
@import "./dataDir.sla"

// ---------- shared shapes ----------
struct StrItem {
    bytes: [u8; 1024],
    len: u64,
}
struct StrList {
    items: [StrItem; 128],
    len: u64,
}

// SaVmPathOperation = "read" | "write" | "transfer" -> tag 0/1/2.
// SaVmDeletePolicy = "rename" | "move" | "deny" -> tag 0/1/2 (2 = deny).

struct SaVmFsEntry {
    path: [u8; 1024],
    path_len: u64,
    access: u32, // 0 = read, 1 = write, 2 = deny
}
struct FsEntryList {
    items: [SaVmFsEntry; 128],
    len: u64,
}

// From @codex-ui/shared (converted in the pkg units); field shape kept 1:1.
struct SaVmHttpAllowRule {
    host: [u8; 512],
    host_len: u64,
    methods: StrList,
    has_methods: bool,
    paths: StrList,
    has_paths: bool,
}
struct HttpRuleList {
    items: [SaVmHttpAllowRule; 128],
    len: u64,
}
struct SaVmProcessExecRule {
    path: [u8; 4096],
    path_len: u64,
    args: StrList,
    has_args: bool,
}
struct ExecRuleList {
    items: [SaVmProcessExecRule; 128],
    len: u64,
}

struct NormalizedFs {
    entries: FsEntryList,
    read: StrList,
    write: StrList,
    transfer: StrList,
    delete: u32, // SaVmDeletePolicy tag
    backupDir: [u8; 1024],
    backupDir_len: u64,
    backupDir_has: bool,
}
struct NormalizedProcess {
    spawn: bool,
    exec: ExecRuleList,
    bunProfiles: StrList,
    has_bunProfiles: bool,
    bun_enabled: bool,
    bun_allowedSubcommands: StrList,
    has_bun: bool,
}
struct NormalizedTools {
    replaceRead: bool,
    replaceWrite: bool,
    replaceApplyPatch: bool,
    replaceExec: bool,
    readFiles: bool,
    editFiles: bool,
    applyPatch: bool,
    fastSearch: bool,
    clearToolHistory: bool,
    findReferences: bool,
    renameSymbol: bool,
    fileOutline: bool,
    moveWithImports: bool,
    findDefinition: bool,
    extractToFile: bool,
    addImport: bool,
    getDiagnostics: bool,
    organizeImports: bool,
    analyzeScope: bool,
    codeGraph: bool,
}
// SaVmContextSavingsConfig (shared): booleans + optional positive numbers
// (u64 + has flag per optional number).
struct SaVmContextSavingsConfig {
    locateBeforeRead: bool,
    maxReadFileBytes: u64,
    maxReadFileBytes_has: bool,
    grepCircuitBreaker: bool,
    grepMaxResults: u64,
    grepMaxResults_has: bool,
    grepMaxTokens: u64,
    grepMaxTokens_has: bool,
    slimRunnerOutput: bool,
    parallelBudget: bool,
    parallelMaxTotalBytes: u64,
    parallelMaxTotalBytes_has: bool,
    parallelMaxReadFiles: u64,
    parallelMaxReadFiles_has: bool,
    parallelDeduplication: bool,
    tieredSkillInjection: bool,
    foldWaterfallEvents: bool,
    foldHistoryReadSummaries: bool,
    historyReadFoldTurns: u64,
    historyReadFoldTurns_has: bool,
}
struct NormalizedSaVmPolicy {
    engine: u32, // 0 = "native", 1 = "vm"
    fs: NormalizedFs,
    http_allow: HttpRuleList,
    env_allow: StrList,
    process: NormalizedProcess,
    execution_javascript: bool,
    execution_python: bool,
    tools: NormalizedTools,
    contextSavings: SaVmContextSavingsConfig,
    contextSavings_has: bool,
}

// SaVmPolicyDecision = { allowed: true; path } | { allowed: false; reason; path? }
struct SaVmPolicyDecision {
    allowed: bool,
    reason: [u8; 2048],
    reason_len: u64,
    path: [u8; 1024],
    path_len: u64,
    path_has: bool,
}

// ---------- byte / item helpers (fix phase) ----------
fn pol_item_ptr(item: &StrItem) -> ptr {
    let p: ptr = PTR_NULL();
    PTR_BYTE_ADD(p, &item.bytes, 0);
    return p;
}
fn pol_byte_at(p: ptr, i: u64) -> u8 {
    let b: u8 = 0;
    PTR_BYTE_AT(b, p, i);
    return b;
}
fn pol_item_byte(item: &StrItem, i: u64) -> u8 {
    let base: ptr = PTR_NULL();
    PTR_BYTE_ADD(base, &item.bytes, 0);
    let b: u8 = 0;
    PTR_BYTE_AT(b, base, i);
    return b;
}
fn pol_bytes_eq(a: ptr, a_len: u64, b: ptr, b_len: u64) -> bool {
    if a_len != b_len { return false; };
    let i: u64 = 0;
    while i < a_len {
        if pol_byte_at(a, i) != pol_byte_at(b, i) { return false; };
        i = i + 1;
    }
    return true;
}
fn pol_item_copy_from(item: &StrItem, src: ptr, n: u64, cap: u64) -> void {
    let m: u64 = n;
    if m > cap { m = cap; };
    let dst: ptr = PTR_NULL();
    PTR_BYTE_ADD(dst, &item.bytes, 0);
    let i: u64 = 0;
    while i < m {
        let b: u8 = pol_byte_at(src, i);
        let dp: ptr = PTR_NULL();
        PTR_BYTE_ADD(dp, dst, i);
        PTR_WRITE_U8(dp, b);
        i = i + 1;
    }
    item.len = m;
    return;
}
fn pol_item_set(item: &StrItem, src: ptr, n: u64) -> void {
    pol_item_copy_from(item, src, n, 1024);
    return;
}
fn pol_item_append(item: &StrItem, src: ptr, n: u64) -> void {
    let dst: ptr = PTR_NULL();
    PTR_BYTE_ADD(dst, &item.bytes, 0);
    let i: u64 = 0;
    while i < n {
        if item.len >= 1024 { return; };
        let b: u8 = pol_byte_at(src, i);
        let dp: ptr = PTR_NULL();
        PTR_BYTE_ADD(dp, dst, item.len);
        PTR_WRITE_U8(dp, b);
        item.len = item.len + 1;
        i = i + 1;
    }
    return;
}
fn pol_item_push_byte(item: &StrItem, b: u8) -> void {
    if item.len >= 1024 { return; };
    let dst: ptr = PTR_NULL();
    PTR_BYTE_ADD(dst, &item.bytes, item.len);
    PTR_WRITE_U8(dst, b);
    item.len = item.len + 1;
    return;
}
fn pol_lower_byte(b: u8) -> u8 {
    let ci: i32 = b as i32;
    if ci >= 65 && ci <= 90 { ci = ci + 32; };
    return ci as u8;
}
fn pol_is_letter(b: u8) -> bool {
    let ci: i32 = b as i32;
    if ci >= 65 && ci <= 90 { return true; };
    if ci >= 97 && ci <= 122 { return true; };
    return false;
}
fn pol_is_digit(b: u8) -> bool {
    return b >= 48 && b <= 57;
}
fn pol_is_ws(b: u8) -> bool {
    return b == 32 || b == 9 || b == 10 || b == 11 || b == 12 || b == 13;
}
fn pol_trimmed_range(p: ptr, n: u64, out_s: &u64, out_e: &u64) -> void {
    // sa_str_trim_ascii_end_len returns the end index within the slice it
    // is given, so it is applied to the suffix after the start index.
    let s: u64 = sa_str_trim_ascii_start_index(p, n);
    let rest: ptr = PTR_NULL();
    PTR_BYTE_ADD(rest, p, s);
    let el: u64 = sa_str_trim_ascii_end_len(rest, n - s);
    *out_s = s;
    *out_e = s + el;
    return;
}
fn pol_item_trimmed(item: &StrItem, p: ptr, n: u64) -> void {
    let s: u64 = 0;
    let e: u64 = 0;
    pol_trimmed_range(p, n, &s, &e);
    if e > s {
        let tp: ptr = PTR_NULL();
        PTR_BYTE_ADD(tp, p, s);
        pol_item_set(item, tp, e - s);
    } else {
        item.len = 0;
    };
    return;
}
fn pol_lower_in_place(item: &StrItem) -> void {
    let base: ptr = PTR_NULL();
    PTR_BYTE_ADD(base, &item.bytes, 0);
    let i: u64 = 0;
    while i < item.len {
        let b: u8 = pol_byte_at(base, i);
        let lb: u8 = pol_lower_byte(b);
        if lb != b {
            let dp: ptr = PTR_NULL();
            PTR_BYTE_ADD(dp, base, i);
            PTR_WRITE_U8(dp, lb);
        };
        i = i + 1;
    }
    return;
}
fn pol_upper_in_place(item: &StrItem) -> void {
    let base: ptr = PTR_NULL();
    PTR_BYTE_ADD(base, &item.bytes, 0);
    let i: u64 = 0;
    while i < item.len {
        let b: u8 = pol_byte_at(base, i);
        let ci: i32 = b as i32;
        if ci >= 97 && ci <= 122 {
            let dp: ptr = PTR_NULL();
            PTR_BYTE_ADD(dp, base, i);
            PTR_WRITE_U8(dp, (ci - 32) as u8);
        };
        i = i + 1;
    }
    return;
}
fn pol_slash_in_place(item: &StrItem) -> void {
    let base: ptr = PTR_NULL();
    PTR_BYTE_ADD(base, &item.bytes, 0);
    let i: u64 = 0;
    while i < item.len {
        if pol_byte_at(base, i) == 92 {
            let dp: ptr = PTR_NULL();
            PTR_BYTE_ADD(dp, base, i);
            PTR_WRITE_U8(dp, 47);
        };
        i = i + 1;
    }
    return;
}
fn pol_norm_slash_lower(item: &StrItem, p: ptr, n: u64) -> void {
    pol_item_set(item, p, n);
    pol_slash_in_place(item);
    pol_lower_in_place(item);
    return;
}
fn pol_starts_with(p: ptr, n: u64, q: ptr, m: u64) -> bool {
    if n < m { return false; };
    let i: u64 = 0;
    while i < m {
        if pol_byte_at(p, i) != pol_byte_at(q, i) { return false; };
        i = i + 1;
    }
    return true;
}
fn pol_ci_match(p: ptr, off: u64, lit_ptr: ptr, lit_len: u64) -> bool {
    let i: u64 = 0;
    while i < lit_len {
        if pol_lower_byte(pol_byte_at(p, off + i)) != pol_lower_byte(pol_byte_at(lit_ptr, i)) { return false; };
        i = i + 1;
    }
    return true;
}
fn pol_list_contains(list: &StrList, p: ptr, n: u64) -> bool {
    let i: u64 = 0;
    while i < list.len {
        if pol_bytes_eq(pol_item_ptr(&list.items[i]), list.items[i].len, p, n) { return true; };
        i = i + 1;
    }
    return false;
}
fn pol_list_push(list: &StrList, p: ptr, n: u64) -> void {
    if list.len >= 128 { return; };
    pol_item_set(&list.items[list.len], p, n);
    list.len = list.len + 1;
    return;
}

// ---------- decision helpers (fix phase) ----------
fn pol_dec_reset(dec: &SaVmPolicyDecision, allowed: bool) -> void {
    dec.allowed = allowed;
    dec.reason_len = 0;
    dec.path_len = 0;
    dec.path_has = false;
    return;
}
fn pol_dec_put(dec: &SaVmPolicyDecision, src: ptr, n: u64) -> void {
    let base: ptr = PTR_NULL();
    PTR_BYTE_ADD(base, &dec.reason, 0);
    let i: u64 = 0;
    while i < n {
        if dec.reason_len >= 2048 { return; };
        let b: u8 = pol_byte_at(src, i);
        let dp: ptr = PTR_NULL();
        PTR_BYTE_ADD(dp, base, dec.reason_len);
        PTR_WRITE_U8(dp, b);
        dec.reason_len = dec.reason_len + 1;
        i = i + 1;
    }
    return;
}
fn pol_dec_path_put(dec: &SaVmPolicyDecision, src: ptr, n: u64) -> void {
    let base: ptr = PTR_NULL();
    PTR_BYTE_ADD(base, &dec.path, 0);
    let m: u64 = n;
    if m > 1024 { m = 1024; };
    let i: u64 = 0;
    while i < m {
        let b: u8 = pol_byte_at(src, i);
        let dp: ptr = PTR_NULL();
        PTR_BYTE_ADD(dp, base, i);
        PTR_WRITE_U8(dp, b);
        i = i + 1;
    }
    dec.path_len = m;
    dec.path_has = true;
    return;
}
fn pol_dec_path_append(dec: &SaVmPolicyDecision, src: ptr, n: u64) -> void {
    let base: ptr = PTR_NULL();
    PTR_BYTE_ADD(base, &dec.path, 0);
    let i: u64 = 0;
    while i < n {
        if dec.path_len >= 1024 { return; };
        let b: u8 = pol_byte_at(src, i);
        let dp: ptr = PTR_NULL();
        PTR_BYTE_ADD(dp, base, dec.path_len);
        PTR_WRITE_U8(dp, b);
        dec.path_len = dec.path_len + 1;
        i = i + 1;
    }
    dec.path_has = true;
    return;
}
fn pol_dec_path_append_u64(dec: &SaVmPolicyDecision, v: u64) -> void {
    let digits: [u8; 20] = [0; 20];
    let digits_p: ptr = PTR_NULL(); PTR_BYTE_ADD(digits_p, &digits, 0);
    let cnt: u64 = 0;
    let x: u64 = v;
    if x == 0 {
        pol_dec_path_append(dec, STR_PTR("0"), STR_LEN("0"));
        return;
    };
    while x > 0 {
        let d: u8 = (x % 10) as u8;
        let dp: ptr = PTR_NULL();
        PTR_BYTE_ADD(dp, digits_p, cnt);
        PTR_WRITE_U8(dp, (48 + (d as i32)) as u8);
        cnt = cnt + 1;
        x = x / 10;
    }
    let base: ptr = PTR_NULL();
    PTR_BYTE_ADD(base, &dec.path, 0);
    let i: u64 = cnt;
    while i > 0 {
        if dec.path_len >= 1024 { return; };
        let b: u8 = 0;
        let sp: ptr = PTR_NULL();
        PTR_BYTE_ADD(sp, digits_p, i - 1);
        PTR_BYTE_AT(b, sp, 0);
        let dp: ptr = PTR_NULL();
        PTR_BYTE_ADD(dp, base, dec.path_len);
        PTR_WRITE_U8(dp, b);
        dec.path_len = dec.path_len + 1;
        i = i - 1;
    }
    dec.path_has = true;
    return;
}

// ---------- JSON probing helpers (fix phase) ----------
// Kind codes (sci sa_std): 0 null, 1 bool, 2 int, 3 float,
// 4 number-string, 5 string, 6 array, 7 object.
fn pol_json_kind(doc: u64) -> u32 {
    if doc == 0 { return 0; };
    return sa_json_kind(doc);
}
fn pol_json_obj(doc: u64, key_ptr: ptr, key_len: u64) -> u64 {
    if doc == 0 { return 0; };
    let h: u64 = 0;
    if sa_json_object_get(doc, key_ptr, key_len, &h) != 0 { return 0; };
    return h;
}
fn pol_json_str_field(doc: u64, key_ptr: ptr, key_len: u64, out: &StrItem, has: &bool) -> void {
    *has = false;
    out.len = 0;
    if doc == 0 { return; };
    let sp: ptr = PTR_NULL();
    let sl: u64 = 0;
    if sa_json_object_get_string(doc, key_ptr, key_len, &sp, &sl) != 0 { return; };
    pol_item_set(out, sp, sl);
    *has = true;
    return;
}
fn pol_node_str(doc: u64, out: &StrItem, has: &bool) -> void {
    *has = false;
    out.len = 0;
    if pol_json_kind(doc) != 5 { return; };
    let sp: ptr = sa_json_string_ptr(doc);
    let sl: u64 = sa_json_string_len(doc);
    pol_item_set(out, sp, sl);
    *has = true;
    return;
}
fn pol_json_is_true(doc: u64, key_ptr: ptr, key_len: u64) -> bool {
    let h: u64 = pol_json_obj(doc, key_ptr, key_len);
    if pol_json_kind(h) != 1 { return false; };
    let bv: bool = false;
    if sa_json_as_bool(h, &bv) != 0 { return false; };
    return bv;
}
fn pol_json_not_false(doc: u64, key_ptr: ptr, key_len: u64) -> bool {
    let h: u64 = pol_json_obj(doc, key_ptr, key_len);
    if pol_json_kind(h) != 1 { return true; };
    let bv: bool = false;
    if sa_json_as_bool(h, &bv) != 0 { return true; };
    return bv;
}
fn pol_json_truthy(doc: u64) -> bool {
    let k: u32 = pol_json_kind(doc);
    if k == 7 || k == 6 { return true; };
    if k == 5 { return sa_json_string_len(doc) > 0; };
    if k == 1 {
        let bv: bool = false;
        if sa_json_as_bool(doc, &bv) != 0 { return false; };
        return bv;
    };
    if k == 2 || k == 3 || k == 4 {
        let fv: f64 = 0.0;
        if sa_json_as_f64(doc, &fv) != 0 { return false; };
        return fv != 0.0;
    };
    return false;
}
fn pol_json_array_count(doc: u64) -> u64 {
    if pol_json_kind(doc) != 6 { return 0; };
    let cnt: u64 = 0;
    if sa_json_value_count(doc, &cnt) != 0 { return 0; };
    return cnt;
}
fn pol_json_array_at(doc: u64, idx: u64) -> u64 {
    let h: u64 = 0;
    if sa_json_array_get(doc, idx, &h) != 0 { return 0; };
    return h;
}
fn pol_json_str_list(doc: u64, out: &StrList) -> void {
    out.len = 0;
    if pol_json_kind(doc) != 6 { return; };
    let cnt: u64 = pol_json_array_count(doc);
    let it = StrItem { bytes: [0u8; 1024], len: 0 };
    let has_s: bool = false;
    let i: u64 = 0;
    while i < cnt {
        let h: u64 = pol_json_array_at(doc, i);
        pol_node_str(h, &it, &has_s);
        if has_s { pol_list_push(out, pol_item_ptr(&it), it.len); };
        i = i + 1;
    }
    return;
}

// ---------- environment / data dir (fix phase) ----------
fn pol_env_item(key_ptr: ptr, key_len: u64, out: &StrItem, has: &bool) -> void {
    *has = false;
    out.len = 0;
    let h = sa_env_get(key_ptr, key_len);
    if h == 0 { return; };
    let dp: ptr = sa_env_buffer_data(h);
    let dl: u64 = sa_env_buffer_len(h);
    pol_item_set(out, dp, dl);
    *has = true;
    return;
}
fn pol_env_trimmed(key_ptr: ptr, key_len: u64, out: &StrItem, has: &bool) -> void {
    let raw = StrItem { bytes: [0u8; 1024], len: 0 };
    let raw_has: bool = false;
    pol_env_item(key_ptr, key_len, &raw, &raw_has);
    *has = false;
    out.len = 0;
    if !raw_has { return; };
    pol_item_trimmed(out, pol_item_ptr(&raw), raw.len);
    if out.len > 0 { *has = true; };
    return;
}
fn pol_data_dir(out: &StrItem) -> void {
    out.len = 0;
    let home = StrItem { bytes: [0u8; 1024], len: 0 };
    let home_has: bool = false;
    pol_env_item(STR_PTR("HOME"), STR_LEN("HOME"), &home, &home_has);
    let pb = PathBuf { bytes: [0; 4096], len: 0 };
    let st: i32 = codexUiDataDir(pol_item_ptr(&home), home.len, &pb);
    if st == 0 {
        let bp: ptr = PTR_NULL();
        PTR_BYTE_ADD(bp, &pb.bytes, 0);
        pol_item_set(out, bp, pb.len);
    };
    return;
}
fn pol_tmpdir(out: &StrItem) -> void {
    let has: bool = false;
    pol_env_item(STR_PTR("TMPDIR"), STR_LEN("TMPDIR"), out, &has);
    if !has || out.len == 0 {
        pol_item_set(out, STR_PTR("/tmp"), STR_LEN("/tmp"));
    };
    return;
}

// ENHANCED_TOOLS_READ_ONLY (source lines 13-35, 18 names): Set<string> ->
// literal table + membership fn, names in source order.
fn ENHANCED_TOOLS_READ_ONLY_has(name_ptr: ptr, name_len: u64) -> bool {
    if pol_bytes_eq(name_ptr, name_len, STR_PTR("read_file"), STR_LEN("read_file")) { return true; };
    if pol_bytes_eq(name_ptr, name_len, STR_PTR("read_lines"), STR_LEN("read_lines")) { return true; };
    if pol_bytes_eq(name_ptr, name_len, STR_PTR("read_many"), STR_LEN("read_many")) { return true; };
    if pol_bytes_eq(name_ptr, name_len, STR_PTR("read_files"), STR_LEN("read_files")) { return true; };
    if pol_bytes_eq(name_ptr, name_len, STR_PTR("read_file_tail"), STR_LEN("read_file_tail")) { return true; };
    if pol_bytes_eq(name_ptr, name_len, STR_PTR("count_lines"), STR_LEN("count_lines")) { return true; };
    if pol_bytes_eq(name_ptr, name_len, STR_PTR("file_info"), STR_LEN("file_info")) { return true; };
    if pol_bytes_eq(name_ptr, name_len, STR_PTR("test_path"), STR_LEN("test_path")) { return true; };
    if pol_bytes_eq(name_ptr, name_len, STR_PTR("file_exists"), STR_LEN("file_exists")) { return true; };
    if pol_bytes_eq(name_ptr, name_len, STR_PTR("exists"), STR_LEN("exists")) { return true; };
    if pol_bytes_eq(name_ptr, name_len, STR_PTR("stat"), STR_LEN("stat")) { return true; };
    if pol_bytes_eq(name_ptr, name_len, STR_PTR("find_files"), STR_LEN("find_files")) { return true; };
    if pol_bytes_eq(name_ptr, name_len, STR_PTR("list_dir"), STR_LEN("list_dir")) { return true; };
    if pol_bytes_eq(name_ptr, name_len, STR_PTR("grep_search"), STR_LEN("grep_search")) { return true; };
    if pol_bytes_eq(name_ptr, name_len, STR_PTR("grep_search_async"), STR_LEN("grep_search_async")) { return true; };
    if pol_bytes_eq(name_ptr, name_len, STR_PTR("code_graph"), STR_LEN("code_graph")) { return true; };
    if pol_bytes_eq(name_ptr, name_len, STR_PTR("relation_graph"), STR_LEN("relation_graph")) { return true; };
    if pol_bytes_eq(name_ptr, name_len, STR_PTR("symbol_graph"), STR_LEN("symbol_graph")) { return true; };
    return false;
}

// DEFAULT_ENV = ["CWD", "PROJECT"] (source line 73).
fn DEFAULT_ENV_at(idx: u64, out: &StrItem) -> bool {
    if idx == 0 {
        pol_item_set(out, STR_PTR("CWD"), STR_LEN("CWD"));
        return true;
    };
    if idx == 1 {
        pol_item_set(out, STR_PTR("PROJECT"), STR_LEN("PROJECT"));
        return true;
    };
    out.len = 0;
    return false;
}

// ALL_SA_VM_BUN_SUBCOMMANDS (5) and ALL_SA_VM_BUN_PROFILES (11) from
// @codex-ui/shared, materialized as literal tables.
fn pol_bun_sub_at(idx: u64, out: &StrItem) -> bool {
    if idx == 0 { pol_item_set(out, STR_PTR("test"), STR_LEN("test")); return true; };
    if idx == 1 { pol_item_set(out, STR_PTR("run"), STR_LEN("run")); return true; };
    if idx == 2 { pol_item_set(out, STR_PTR("build"), STR_LEN("build")); return true; };
    if idx == 3 { pol_item_set(out, STR_PTR("--filter"), STR_LEN("--filter")); return true; };
    if idx == 4 { pol_item_set(out, STR_PTR("filter"), STR_LEN("filter")); return true; };
    out.len = 0;
    return false;
}
fn pol_bun_prof_at(idx: u64, out: &StrItem) -> bool {
    if idx == 0 { pol_item_set(out, STR_PTR("shared-typecheck"), STR_LEN("shared-typecheck")); return true; };
    if idx == 1 { pol_item_set(out, STR_PTR("protocol-typecheck"), STR_LEN("protocol-typecheck")); return true; };
    if idx == 2 { pol_item_set(out, STR_PTR("server-typecheck"), STR_LEN("server-typecheck")); return true; };
    if idx == 3 { pol_item_set(out, STR_PTR("web-typecheck"), STR_LEN("web-typecheck")); return true; };
    if idx == 4 { pol_item_set(out, STR_PTR("free-key-typecheck"), STR_LEN("free-key-typecheck")); return true; };
    if idx == 5 { pol_item_set(out, STR_PTR("root-typecheck"), STR_LEN("root-typecheck")); return true; };
    if idx == 6 { pol_item_set(out, STR_PTR("shared-build"), STR_LEN("shared-build")); return true; };
    if idx == 7 { pol_item_set(out, STR_PTR("web-build"), STR_LEN("web-build")); return true; };
    if idx == 8 { pol_item_set(out, STR_PTR("server-test-file"), STR_LEN("server-test-file")); return true; };
    if idx == 9 { pol_item_set(out, STR_PTR("web-test-file"), STR_LEN("web-test-file")); return true; };
    if idx == 10 { pol_item_set(out, STR_PTR("shared-test-file"), STR_LEN("shared-test-file")); return true; };
    out.len = 0;
    return false;
}
fn pol_bun_sub_member(p: ptr, n: u64) -> bool {
    let it = StrItem { bytes: [0u8; 1024], len: 0 };
    let i: u64 = 0;
    while i < 5 {
        pol_bun_sub_at(i, &it);
        if pol_bytes_eq(p, n, pol_item_ptr(&it), it.len) { return true; };
        i = i + 1;
    }
    return false;
}
fn pol_bun_prof_member(p: ptr, n: u64) -> bool {
    let it = StrItem { bytes: [0u8; 1024], len: 0 };
    let i: u64 = 0;
    while i < 11 {
        pol_bun_prof_at(i, &it);
        if pol_bytes_eq(p, n, pol_item_ptr(&it), it.len) { return true; };
        i = i + 1;
    }
    return false;
}
fn pol_bun_all_subs(out: &StrList) -> void {
    out.len = 0;
    let it = StrItem { bytes: [0u8; 1024], len: 0 };
    let i: u64 = 0;
    while i < 5 {
        pol_bun_sub_at(i, &it);
        pol_list_push(out, pol_item_ptr(&it), it.len);
        i = i + 1;
    }
    return;
}

// ---------- path machinery (fix phase) ----------
fn pol_is_abs(p: ptr, n: u64) -> bool {
    if n >= 1 && pol_byte_at(p, 0) == 47 { return true; };
    if n >= 2 && pol_byte_at(p, 0) == 92 && pol_byte_at(p, 1) == 92 { return true; };
    if n >= 3 && pol_is_letter(pol_byte_at(p, 0)) && pol_byte_at(p, 1) == 58 {
        let c2: u8 = pol_byte_at(p, 2);
        if c2 == 47 || c2 == 92 { return true; };
    };
    return false;
}
fn pol_append_slashnorm(item: &StrItem, p: ptr, n: u64) -> void {
    let i: u64 = 0;
    while i < n {
        let b: u8 = pol_byte_at(p, i);
        if b == 92 { b = 47; };
        pol_item_push_byte(item, b);
        i = i + 1;
    }
    return;
}
fn pol_normalize_segments(item: &StrItem) -> void {
    // In-place Node-resolve-style segment normalization of an already
    // slash-normalized string: "." and empty segments drop, ".." pops
    // the last kept segment (dropped at a rooted prefix, kept on a
    // relative path). marks[k] = write cursor before segment k.
    let base: ptr = PTR_NULL();
    PTR_BYTE_ADD(base, &item.bytes, 0);
    let n: u64 = item.len;
    let prefix: u64 = 0;
    if n >= 3 && pol_is_letter(pol_byte_at(base, 0)) && pol_byte_at(base, 1) == 58 && pol_byte_at(base, 2) == 47 {
        prefix = 3;
    };
    if prefix == 0 && n >= 1 && pol_byte_at(base, 0) == 47 {
        prefix = 1;
    };
    let marks: [u64; 64] = [0; 64];
    let marks_p: ptr = PTR_NULL(); PTR_BYTE_ADD(marks_p, &marks, 0);
    let mcount: u64 = 0;
    let w: u64 = prefix;
    let r: u64 = prefix;
    while r < n {
        let e: u64 = r;
        let scanning: bool = true;
        while scanning {
            if e >= n {
                scanning = false;
            } else {
                if pol_byte_at(base, e) == 47 { scanning = false; } else { e = e + 1; };
            };
        }
        let seg_len: u64 = e - r;
        let is_dot: bool = seg_len == 1 && pol_byte_at(base, r) == 46;
        let is_dotdot: bool = seg_len == 2 && pol_byte_at(base, r) == 46 && pol_byte_at(base, r + 1) == 46;
        if seg_len == 0 || is_dot {
            // skip
        } else if is_dotdot && mcount > 0 {
            mcount = mcount - 1;
            w = marks[mcount];
        } else if is_dotdot && prefix > 0 {
            // rooted: ".." at the root drops
        } else {
            let need_sep: bool = mcount > 0 || w > prefix;
            if mcount < 64 {
                marks[mcount] = w;
                mcount = mcount + 1;
            };
            if need_sep {
                let dp0: ptr = PTR_NULL();
                PTR_BYTE_ADD(dp0, base, w);
                PTR_WRITE_U8(dp0, 47);
                w = w + 1;
            };
            let k: u64 = 0;
            while k < seg_len {
                let b: u8 = pol_byte_at(base, r + k);
                let dp: ptr = PTR_NULL();
                PTR_BYTE_ADD(dp, base, w + k);
                PTR_WRITE_U8(dp, b);
                k = k + 1;
            }
            w = w + seg_len;
        };
        r = e + 1;
    }
    if w == 0 {
        if prefix > 0 {
            w = prefix;
        } else {
            let dp: ptr = PTR_NULL();
            PTR_BYTE_ADD(dp, base, 0);
            PTR_WRITE_U8(dp, 46);
            w = 1;
        };
    };
    item.len = w;
    return;
}
fn pol_resolve_normalized(out: &StrItem, base_ptr: ptr, base_len: u64, value_ptr: ptr, value_len: u64, lower: bool) -> void {
    out.len = 0;
    if pol_is_abs(value_ptr, value_len) {
        pol_append_slashnorm(out, value_ptr, value_len);
    } else {
        pol_append_slashnorm(out, base_ptr, base_len);
        if out.len == 0 || pol_item_byte(out, out.len - 1) != 47 {
            pol_item_push_byte(out, 47);
        };
        pol_append_slashnorm(out, value_ptr, value_len);
    };
    pol_normalize_segments(out);
    if lower { pol_lower_in_place(out); };
    return;
}
fn pol_expand_project(out: &StrItem, p: ptr, n: u64, cwd_ptr: ptr, cwd_len: u64) -> void {
    // ${PROJECT} / $PROJECT (case-insensitive) -> cwd, single pass,
    // braced form first (the source runs two replaces; equivalent here
    // unless cwd itself contains a $PROJECT token).
    out.len = 0;
    let i: u64 = 0;
    while i < n {
        let b: u8 = pol_byte_at(p, i);
        if b == 36 {
            let done: bool = false;
            if i + 10 <= n && pol_byte_at(p, i + 1) == 123 && pol_ci_match(p, i + 2, STR_PTR("PROJECT"), STR_LEN("PROJECT")) && pol_byte_at(p, i + 9) == 125 {
                pol_item_append(out, cwd_ptr, cwd_len);
                i = i + 10;
                done = true;
            };
            if !done && i + 8 <= n && pol_ci_match(p, i + 1, STR_PTR("PROJECT"), STR_LEN("PROJECT")) {
                pol_item_append(out, cwd_ptr, cwd_len);
                i = i + 8;
                done = true;
            };
            if !done {
                pol_item_push_byte(out, 36);
                i = i + 1;
            };
        } else {
            pol_item_push_byte(out, b);
            i = i + 1;
        };
    }
    return;
}
fn resolvePattern(value_ptr: ptr, value_len: u64, cwd_ptr: ptr, cwd_len: u64, out: &StrItem) -> void {
    // Source: expanded = value.replace(PROJECT, cwd).replace(/\\/g, "/");
    // drive-letter or "/" absolute -> lowercase only (NO resolve);
    // otherwise resolve(cwd, expanded) -> slashes -> lowercase.
    let exp = StrItem { bytes: [0u8; 1024], len: 0 };
    pol_expand_project(&exp, value_ptr, value_len, cwd_ptr, cwd_len);
    pol_slash_in_place(&exp);
    let ep: ptr = pol_item_ptr(&exp);
    let isabs: bool = false;
    if exp.len >= 1 && pol_byte_at(ep, 0) == 47 { isabs = true; };
    if exp.len >= 3 && pol_is_letter(pol_byte_at(ep, 0)) && pol_byte_at(ep, 1) == 58 && pol_byte_at(ep, 2) == 47 { isabs = true; };
    if isabs {
        pol_item_set(out, ep, exp.len);
        pol_lower_in_place(out);
        return;
    };
    pol_resolve_normalized(out, cwd_ptr, cwd_len, ep, exp.len, true);
    return;
}
fn resolvePolicyPath(value_ptr: ptr, value_len: u64, cwd_ptr: ptr, cwd_len: u64, out: &StrItem) -> void {
    // Source: expanded (no slash pass before the absolute test);
    // isAbsolute ? resolve(expanded) : resolve(cwd, expanded);
    // then slashes -> lowercase. pol_resolve_normalized covers both.
    let exp = StrItem { bytes: [0u8; 1024], len: 0 };
    pol_expand_project(&exp, value_ptr, value_len, cwd_ptr, cwd_len);
    pol_resolve_normalized(out, cwd_ptr, cwd_len, pol_item_ptr(&exp), exp.len, true);
    return;
}

// ---------- glob / matchers (fix phase) ----------
fn pol_glob_match(v: ptr, vl: u64, p: ptr, pl: u64) -> bool {
    // Iterative equivalent of the source's regex build: "**" -> .*,
    // "*" -> [^/]*, "?" -> [^/], every other byte literal, anchored.
    let vi: u64 = 0;
    let pi: u64 = 0;
    let star_after: u64 = 0;
    let star_v: u64 = 0;
    let star_dbl: bool = false;
    let has_star: bool = false;
    while vi < vl {
        let matched: bool = false;
        if pi < pl {
            let pc: u8 = pol_byte_at(p, pi);
            if pc == 42 {
                let dbl: bool = false;
                if pi + 1 < pl && pol_byte_at(p, pi + 1) == 42 { dbl = true; };
                has_star = true;
                star_dbl = dbl;
                star_v = vi;
                if dbl { star_after = pi + 2; } else { star_after = pi + 1; };
                pi = star_after;
                matched = true;
            } else if pc == 63 {
                if pol_byte_at(v, vi) != 47 {
                    vi = vi + 1;
                    pi = pi + 1;
                    matched = true;
                };
            } else {
                if pol_byte_at(v, vi) == pc {
                    vi = vi + 1;
                    pi = pi + 1;
                    matched = true;
                };
            };
        };
        if !matched {
            if !has_star { return false; };
            if !star_dbl && pol_byte_at(v, star_v) == 47 { return false; };
            star_v = star_v + 1;
            vi = star_v;
            pi = star_after;
        };
    }
    while pi < pl {
        if pol_byte_at(p, pi) != 42 { return false; };
        pi = pi + 1;
    }
    return true;
}
fn pol_glob_pp(v_ptr: ptr, v_len: u64, p_ptr: ptr, p_len: u64) -> bool {
    let v = StrItem { bytes: [0u8; 1024], len: 0 };
    let p = StrItem { bytes: [0u8; 1024], len: 0 };
    pol_norm_slash_lower(&v, v_ptr, v_len);
    pol_norm_slash_lower(&p, p_ptr, p_len);
    if p.len >= 3 {
        let bp: ptr = pol_item_ptr(&p);
        if pol_byte_at(bp, p.len - 3) == 47 && pol_byte_at(bp, p.len - 2) == 42 && pol_byte_at(bp, p.len - 1) == 42 {
            if v.len == p.len - 3 && pol_bytes_eq(pol_item_ptr(&v), v.len, bp, p.len - 3) { return true; };
        };
    };
    return pol_glob_match(pol_item_ptr(&v), v.len, pol_item_ptr(&p), p.len);
}
fn globMatches(value_ptr: ptr, value_len: u64, pattern: &StrItem) -> bool {
    return pol_glob_pp(value_ptr, value_len, pol_item_ptr(pattern), pattern.len);
}
fn matchesAny(path_ptr: ptr, path_len: u64, patterns: &StrList) -> bool {
    let i: u64 = 0;
    while i < patterns.len {
        if globMatches(path_ptr, path_len, &patterns.items[i]) { return true; };
        i = i + 1;
    }
    return false;
}
fn pol_fs_match(v_ptr: ptr, v_len: u64, p_ptr: ptr, p_len: u64) -> bool {
    if pol_glob_pp(v_ptr, v_len, p_ptr, p_len) { return true; };
    let i: u64 = 0;
    let has_glob: bool = false;
    while i < p_len {
        let b: u8 = pol_byte_at(p_ptr, i);
        if b == 63 || b == 42 { has_glob = true; };
        i = i + 1;
    }
    if has_glob { return false; };
    if pol_bytes_eq(v_ptr, v_len, p_ptr, p_len) { return true; };
    let tl: u64 = p_len;
    let trimming: bool = true;
    while trimming {
        if tl == 0 {
            trimming = false;
        } else {
            let b: u8 = pol_byte_at(p_ptr, tl - 1);
            if b == 47 || b == 92 { tl = tl - 1; } else { trimming = false; };
        };
    }
    if v_len > tl && pol_starts_with(v_ptr, v_len, p_ptr, tl) && pol_byte_at(v_ptr, tl) == 47 { return true; };
    return false;
}
fn fsPatternMatches(value_ptr: ptr, value_len: u64, pattern: &StrItem) -> bool {
    return pol_fs_match(value_ptr, value_len, pol_item_ptr(pattern), pattern.len);
}
fn patternSpecificity(pattern_ptr: ptr, pattern_len: u64) -> u64 {
    let base_len: u64 = pattern_len;
    if pattern_len >= 3 && pol_byte_at(pattern_ptr, pattern_len - 3) == 47 && pol_byte_at(pattern_ptr, pattern_len - 2) == 42 && pol_byte_at(pattern_ptr, pattern_len - 1) == 42 {
        base_len = pattern_len - 3;
    };
    let cnt: u64 = 0;
    let i: u64 = 0;
    while i < base_len {
        let b: u8 = pol_byte_at(pattern_ptr, i);
        if b != 63 && b != 42 { cnt = cnt + 1; };
        i = i + 1;
    }
    return cnt;
}
fn hostMatches(host_ptr: ptr, host_len: u64, pattern_ptr: ptr, pattern_len: u64) -> bool {
    let h = StrItem { bytes: [0u8; 1024], len: 0 };
    pol_item_set(&h, host_ptr, host_len);
    pol_lower_in_place(&h);
    let strip: u64 = 0;
    if pattern_len >= 2 && pol_byte_at(pattern_ptr, 0) == 42 && pol_byte_at(pattern_ptr, 1) == 46 { strip = 2; };
    let sp: ptr = PTR_NULL();
    PTR_BYTE_ADD(sp, pattern_ptr, strip);
    let p = StrItem { bytes: [0u8; 1024], len: 0 };
    pol_item_set(&p, sp, pattern_len - strip);
    pol_lower_in_place(&p);
    let hp: ptr = pol_item_ptr(&h);
    let pp: ptr = pol_item_ptr(&p);
    if pol_bytes_eq(hp, h.len, pp, p.len) { return true; };
    if h.len > p.len {
        let off: u64 = h.len - p.len;
        if pol_byte_at(hp, off - 1) == 46 {
            let suffix: ptr = PTR_NULL();
            PTR_BYTE_ADD(suffix, hp, off);
            if pol_bytes_eq(suffix, p.len, pp, p.len) { return true; };
        };
    };
    return false;
}
fn pol_exec_match(v_ptr: ptr, v_len: u64, p_ptr: ptr, p_len: u64) -> bool {
    let v = StrItem { bytes: [0u8; 1024], len: 0 };
    let p = StrItem { bytes: [0u8; 1024], len: 0 };
    pol_norm_slash_lower(&v, v_ptr, v_len);
    pol_norm_slash_lower(&p, p_ptr, p_len);
    let vp: ptr = pol_item_ptr(&v);
    let pp: ptr = pol_item_ptr(&p);
    if pol_bytes_eq(vp, v.len, pp, p.len) { return true; };
    let has_slash: bool = false;
    let i: u64 = 0;
    while i < p.len {
        if pol_byte_at(pp, i) == 47 { has_slash = true; };
        i = i + 1;
    }
    if !has_slash {
        let bs: u64 = 0;
        let j: u64 = 0;
        while j < v.len {
            if pol_byte_at(vp, j) == 47 { bs = j + 1; };
            j = j + 1;
        }
        let bl: u64 = v.len - bs;
        let bptr: ptr = PTR_NULL();
        PTR_BYTE_ADD(bptr, vp, bs);
        if pol_bytes_eq(bptr, bl, pp, p.len) { return true; };
        if bl == p.len + 4 && pol_bytes_eq(bptr, p.len, pp, p.len) {
            let dot: ptr = PTR_NULL();
            PTR_BYTE_ADD(dot, bptr, p.len);
            if pol_bytes_eq(dot, 4, STR_PTR(".exe"), STR_LEN(".exe")) { return true; };
        };
    };
    return pol_glob_pp(vp, v.len, pp, p.len);
}
fn executableMatches(value_ptr: ptr, value_len: u64, pattern: &StrItem) -> bool {
    return pol_exec_match(value_ptr, value_len, pol_item_ptr(pattern), pattern.len);
}
fn argsMatch(patterns: &StrList, args: &StrList) -> bool {
    let trailing: bool = false;
    if patterns.len > 0 {
        let li: u64 = patterns.len - 1;
        if pol_bytes_eq(pol_item_ptr(&patterns.items[li]), patterns.items[li].len, STR_PTR("*"), STR_LEN("*")) { trailing = true; };
    };
    let fixed: u64 = patterns.len;
    if trailing { fixed = fixed - 1; };
    if trailing {
        if args.len < fixed { return false; };
    } else {
        if args.len != fixed { return false; };
    };
    let i: u64 = 0;
    while i < fixed {
        if !globMatches(pol_item_ptr(&args.items[i]), args.items[i].len, &patterns.items[i]) { return false; };
        i = i + 1;
    }
    return true;
}
fn dedupe(values: &StrList) -> void {
    // In-place order-preserving dedupe (source: [...new Set(values)]).
    let w: u64 = 0;
    let i: u64 = 0;
    while i < values.len {
        let seen: bool = false;
        let j: u64 = 0;
        while j < w {
            if pol_bytes_eq(pol_item_ptr(&values.items[j]), values.items[j].len, pol_item_ptr(&values.items[i]), values.items[i].len) { seen = true; };
            j = j + 1;
        }
        if !seen {
            if w != i {
                pol_item_set(&values.items[w], pol_item_ptr(&values.items[i]), values.items[i].len);
            };
            w = w + 1;
        };
        i = i + 1;
    }
    values.len = w;
    return;
}
fn pol_entry_set(e: &SaVmFsEntry, p: ptr, n: u64, access: u32) -> void {
    let dst: ptr = PTR_NULL();
    PTR_BYTE_ADD(dst, &e.path, 0);
    let m: u64 = n;
    if m > 1024 { m = 1024; };
    let i: u64 = 0;
    while i < m {
        let b: u8 = pol_byte_at(p, i);
        let dp: ptr = PTR_NULL();
        PTR_BYTE_ADD(dp, dst, i);
        PTR_WRITE_U8(dp, b);
        i = i + 1;
    }
    e.path_len = m;
    e.access = access;
    return;
}
fn pol_entry_push(list: &FsEntryList, p: ptr, n: u64, access: u32) -> void {
    if list.len >= 128 { return; };
    pol_entry_set(&list.items[list.len], p, n, access);
    list.len = list.len + 1;
    return;
}
fn dedupeEntries(entries: &FsEntryList) -> void {
    // In-place; key is `${access}:${path}` (source dedupeEntries).
    let w: u64 = 0;
    let i: u64 = 0;
    while i < entries.len {
        let seen: bool = false;
        let j: u64 = 0;
        while j < w {
            if entries.items[j].access == entries.items[i].access {
                let ap: ptr = PTR_NULL();
                PTR_BYTE_ADD(ap, &entries.items[j].path, 0);
                let bp: ptr = PTR_NULL();
                PTR_BYTE_ADD(bp, &entries.items[i].path, 0);
                if pol_bytes_eq(ap, entries.items[j].path_len, bp, entries.items[i].path_len) { seen = true; };
            };
            j = j + 1;
        }
        if !seen {
            if w != i {
                let sp: ptr = PTR_NULL();
                PTR_BYTE_ADD(sp, &entries.items[i].path, 0);
                pol_entry_set(&entries.items[w], sp, entries.items[i].path_len, entries.items[i].access);
            };
            w = w + 1;
        };
        i = i + 1;
    }
    entries.len = w;
    return;
}
fn resolveFsAccess(entries: &FsEntryList, path_ptr: ptr, path_len: u64, out_access: &u32, has: &bool) -> void {
    // Source: filter matches; none -> null; any deny -> "deny"; else
    // sort by patternSpecificity desc, write-before-read on ties, take
    // the first. The incremental pick below is that sort's head.
    *has = false;
    *out_access = 0;
    let best_spec: u64 = 0;
    let best_access: u32 = 0;
    let found: bool = false;
    let i: u64 = 0;
    while i < entries.len {
        let ep: ptr = PTR_NULL();
        PTR_BYTE_ADD(ep, &entries.items[i].path, 0);
        let el: u64 = entries.items[i].path_len;
        if pol_fs_match(path_ptr, path_len, ep, el) {
            let acc: u32 = entries.items[i].access;
            if acc == 2 {
                *out_access = 2;
                *has = true;
                return;
            };
            let spec: u64 = patternSpecificity(ep, el);
            let better: bool = false;
            if !found { better = true; };
            if spec > best_spec { better = true; };
            if spec == best_spec && acc == 1 && best_access == 0 { better = true; };
            if better {
                found = true;
                best_spec = spec;
                best_access = acc;
            };
        };
        i = i + 1;
    }
    if found {
        *out_access = best_access;
        *has = true;
    };
    return;
}

// ---------- normalize group (fix phase) ----------
fn normalizePatterns(value: &StrList, value_has: bool, cwd_ptr: ptr, cwd_len: u64, fallback: &StrList, out: &StrList) -> void {
    // Source: entries = (Array.isArray(value) && value.length > 0)
    //   ? value
    //   : fallback.map(e => e.endsWith("*") ? e : stripSlashes(e)+"/**");
    // result = dedupe(entries.slice(0, 128).map(e => resolvePattern(e, cwd))).
    // value_has carries the Array.isArray bit; out may alias value.
    let use_value: bool = value_has && value.len > 0;
    let total: u64 = 0;
    if use_value { total = value.len; } else { total = fallback.len; };
    if total > 128 { total = 128; };
    let raw = StrItem { bytes: [0u8; 1024], len: 0 };
    let res = StrItem { bytes: [0u8; 1024], len: 0 };
    let n: u64 = 0;
    let i: u64 = 0;
    while i < total {
        if use_value {
            pol_item_set(&raw, pol_item_ptr(&value.items[i]), value.items[i].len);
        } else {
            let fp: ptr = pol_item_ptr(&fallback.items[i]);
            let fl: u64 = fallback.items[i].len;
            if fl > 0 && pol_byte_at(fp, fl - 1) == 42 {
                pol_item_set(&raw, fp, fl);
            } else {
                let tl: u64 = fl;
                let trimming: bool = true;
                while trimming {
                    if tl == 0 {
                        trimming = false;
                    } else {
                        let b: u8 = pol_byte_at(fp, tl - 1);
                        if b == 47 || b == 92 { tl = tl - 1; } else { trimming = false; };
                    };
                }
                pol_item_set(&raw, fp, tl);
                pol_item_push_byte(&raw, 47);
                pol_item_push_byte(&raw, 42);
                pol_item_push_byte(&raw, 42);
            };
        };
        resolvePattern(pol_item_ptr(&raw), raw.len, cwd_ptr, cwd_len, &res);
        pol_item_set(&out.items[n], pol_item_ptr(&res), res.len);
        n = n + 1;
        i = i + 1;
    }
    out.len = n;
    dedupe(out);
    return;
}
fn legacyEntries(fsConfig_doc: u64, cwd_ptr: ptr, cwd_len: u64, defaultRoots: &StrList, out: &FsEntryList) -> void {
    // Source: read/write via normalizePatterns with fallback
    // [defaultRoots[0]]; when neither fs.read nor fs.write is present
    // (array-ness, an empty array still counts as present), every
    // additional default root also yields a raw "<root>/**" read entry
    // (NOT resolved/lowercased — the source pushes it verbatim);
    // dedupeEntries at the end.
    out.len = 0;
    let scratch = StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 };
    let fb = StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 };
    if defaultRoots.len > 0 {
        pol_list_push(&fb, pol_item_ptr(&defaultRoots.items[0]), defaultRoots.items[0].len);
    };
    let read_doc: u64 = pol_json_obj(fsConfig_doc, STR_PTR("read"), STR_LEN("read"));
    let write_doc: u64 = pol_json_obj(fsConfig_doc, STR_PTR("write"), STR_LEN("write"));
    pol_json_str_list(read_doc, &scratch);
    normalizePatterns(&scratch, pol_json_kind(read_doc) == 6, cwd_ptr, cwd_len, &fb, &scratch);
    let i: u64 = 0;
    while i < scratch.len {
        pol_entry_push(out, pol_item_ptr(&scratch.items[i]), scratch.items[i].len, 0);
        i = i + 1;
    }
    pol_json_str_list(write_doc, &scratch);
    normalizePatterns(&scratch, pol_json_kind(write_doc) == 6, cwd_ptr, cwd_len, &fb, &scratch);
    i = 0;
    while i < scratch.len {
        pol_entry_push(out, pol_item_ptr(&scratch.items[i]), scratch.items[i].len, 1);
        i = i + 1;
    }
    if pol_json_kind(read_doc) != 6 && pol_json_kind(write_doc) != 6 {
        let pat = StrItem { bytes: [0u8; 1024], len: 0 };
        let j: u64 = 1;
        while j < defaultRoots.len {
            let rp: ptr = pol_item_ptr(&defaultRoots.items[j]);
            let rl: u64 = defaultRoots.items[j].len;
            let tl: u64 = rl;
            let trimming: bool = true;
            while trimming {
                if tl == 0 {
                    trimming = false;
                } else {
                    let b: u8 = pol_byte_at(rp, tl - 1);
                    if b == 47 || b == 92 { tl = tl - 1; } else { trimming = false; };
                };
            }
            pol_item_set(&pat, rp, tl);
            pol_item_push_byte(&pat, 47);
            pol_item_push_byte(&pat, 42);
            pol_item_push_byte(&pat, 42);
            pol_entry_push(out, pol_item_ptr(&pat), pat.len, 0);
            j = j + 1;
        }
    };
    dedupeEntries(out);
    return;
}
fn normalizeEntries(value_doc: u64, cwd_ptr: ptr, cwd_len: u64, out: &FsEntryList) -> void {
    out.len = 0;
    if pol_json_kind(value_doc) != 6 { return; };
    let cnt: u64 = pol_json_array_count(value_doc);
    if cnt > 128 { cnt = 128; };
    let item = StrItem { bytes: [0u8; 1024], len: 0 };
    let acc_s = StrItem { bytes: [0u8; 1024], len: 0 };
    let res = StrItem { bytes: [0u8; 1024], len: 0 };
    let i: u64 = 0;
    while i < cnt {
        let node: u64 = pol_json_array_at(value_doc, i);
        let has_p: bool = false;
        pol_json_str_field(node, STR_PTR("path"), STR_LEN("path"), &item, &has_p);
        if has_p {
            let ts: u64 = 0;
            let te: u64 = 0;
            pol_trimmed_range(pol_item_ptr(&item), item.len, &ts, &te);
            if te > ts {
                let has_a: bool = false;
                pol_json_str_field(node, STR_PTR("access"), STR_LEN("access"), &acc_s, &has_a);
                if has_a {
                    let acc: u32 = 3;
                    if pol_bytes_eq(pol_item_ptr(&acc_s), acc_s.len, STR_PTR("read"), STR_LEN("read")) { acc = 0; };
                    if pol_bytes_eq(pol_item_ptr(&acc_s), acc_s.len, STR_PTR("write"), STR_LEN("write")) { acc = 1; };
                    if pol_bytes_eq(pol_item_ptr(&acc_s), acc_s.len, STR_PTR("deny"), STR_LEN("deny")) { acc = 2; };
                    if acc != 3 {
                        resolvePattern(pol_item_ptr(&item), item.len, cwd_ptr, cwd_len, &res);
                        pol_entry_push(out, pol_item_ptr(&res), res.len, acc);
                    };
                };
            };
        };
        i = i + 1;
    }
    dedupeEntries(out);
    return;
}
fn normalizeHttpRules(value_doc: u64, out: &HttpRuleList) -> void {
    out.len = 0;
    if pol_json_kind(value_doc) != 6 { return; };
    let cnt: u64 = pol_json_array_count(value_doc);
    if cnt > 128 { cnt = 128; };
    let host = StrItem { bytes: [0u8; 1024], len: 0 };
    let m = StrItem { bytes: [0u8; 1024], len: 0 };
    let i: u64 = 0;
    while i < cnt {
        let node: u64 = pol_json_array_at(value_doc, i);
        let has_h: bool = false;
        pol_json_str_field(node, STR_PTR("host"), STR_LEN("host"), &host, &has_h);
        if has_h {
            let ts: u64 = 0;
            let te: u64 = 0;
            pol_trimmed_range(pol_item_ptr(&host), host.len, &ts, &te);
            if te > ts {
                let n: u64 = out.len;
                if n < 128 {
                    // host = trim + lowercase, capped at the 512-byte field
                    let tp: ptr = PTR_NULL();
                    PTR_BYTE_ADD(tp, pol_item_ptr(&host), ts);
                    let trimmed = StrItem { bytes: [0u8; 1024], len: 0 };
                    pol_item_set(&trimmed, tp, te - ts);
                    pol_lower_in_place(&trimmed);
                    let dst: ptr = PTR_NULL();
                    PTR_BYTE_ADD(dst, &out.items[n].host, 0);
                    let hl: u64 = trimmed.len;
                    if hl > 512 { hl = 512; };
                    let k: u64 = 0;
                    while k < hl {
                        let b: u8 = pol_byte_at(pol_item_ptr(&trimmed), k);
                        let dp: ptr = PTR_NULL();
                        PTR_BYTE_ADD(dp, dst, k);
                        PTR_WRITE_U8(dp, b);
                        k = k + 1;
                    }
                    out.items[n].host_len = hl;
                    // methods: entry.methods (non-empty) else DEFAULT,
                    // uppercased, filtered to GET/POST, no dedupe.
                    out.items[n].methods.len = 0;
                    out.items[n].has_methods = true;
                    let mdoc: u64 = pol_json_obj(node, STR_PTR("methods"), STR_LEN("methods"));
                    if pol_json_kind(mdoc) == 6 && pol_json_array_count(mdoc) > 0 {
                        let mc: u64 = pol_json_array_count(mdoc);
                        let mi: u64 = 0;
                        while mi < mc {
                            let mh: u64 = pol_json_array_at(mdoc, mi);
                            let mhas: bool = false;
                            pol_node_str(mh, &m, &mhas);
                            if mhas {
                                pol_upper_in_place(&m);
                                if pol_bytes_eq(pol_item_ptr(&m), m.len, STR_PTR("GET"), STR_LEN("GET")) || pol_bytes_eq(pol_item_ptr(&m), m.len, STR_PTR("POST"), STR_LEN("POST")) {
                                    pol_list_push(&out.items[n].methods, pol_item_ptr(&m), m.len);
                                };
                            };
                            mi = mi + 1;
                        }
                    } else {
                        pol_list_push(&out.items[n].methods, STR_PTR("GET"), STR_LEN("GET"));
                        pol_list_push(&out.items[n].methods, STR_PTR("POST"), STR_LEN("POST"));
                    };
                    // paths: only when entry.paths is a non-empty array
                    out.items[n].paths.len = 0;
                    out.items[n].has_paths = false;
                    let pdoc: u64 = pol_json_obj(node, STR_PTR("paths"), STR_LEN("paths"));
                    if pol_json_kind(pdoc) == 6 && pol_json_array_count(pdoc) > 0 {
                        out.items[n].has_paths = true;
                        let pc: u64 = pol_json_array_count(pdoc);
                        if pc > 64 { pc = 64; };
                        let pi2: u64 = 0;
                        while pi2 < pc {
                            let ph: u64 = pol_json_array_at(pdoc, pi2);
                            let phas: bool = false;
                            pol_node_str(ph, &m, &phas);
                            if phas { pol_list_push(&out.items[n].paths, pol_item_ptr(&m), m.len); };
                            pi2 = pi2 + 1;
                        }
                    };
                    out.len = n + 1;
                };
            };
        };
        i = i + 1;
    }
    return;
}
fn pol_env_name_ok(p: ptr, n: u64) -> bool {
    // /^[A-Za-z_][A-Za-z0-9_]*$/
    if n == 0 { return false; };
    let b0: u8 = pol_byte_at(p, 0);
    if !pol_is_letter(b0) && b0 != 95 { return false; };
    let i: u64 = 1;
    while i < n {
        let b: u8 = pol_byte_at(p, i);
        if !pol_is_letter(b) && !pol_is_digit(b) && b != 95 { return false; };
        i = i + 1;
    }
    return true;
}
fn normalizeEnv(value: &StrList, value_has: bool, out: &StrList) -> void {
    // Source: source = (array && length > 0) ? value : DEFAULT_ENV;
    // result = dedupe(source.filter(name-regex).slice(0, 64)).
    // Out may alias value.
    if !(value_has && value.len > 0) {
        out.len = 0;
        let it = StrItem { bytes: [0u8; 1024], len: 0 };
        let idx: u64 = 0;
        while idx < 2 {
            DEFAULT_ENV_at(idx, &it);
            pol_list_push(out, pol_item_ptr(&it), it.len);
            idx = idx + 1;
        }
        dedupe(out);
        return;
    };
    let w: u64 = 0;
    let i: u64 = 0;
    let total: u64 = value.len;
    while i < total {
        let ip: ptr = pol_item_ptr(&value.items[i]);
        let il: u64 = value.items[i].len;
        if pol_env_name_ok(ip, il) && w < 64 {
            pol_item_set(&out.items[w], ip, il);
            w = w + 1;
        };
        i = i + 1;
    }
    out.len = w;
    dedupe(out);
    return;
}
fn normalizeExecRules(value_doc: u64, out: &ExecRuleList) -> void {
    out.len = 0;
    if pol_json_kind(value_doc) != 6 { return; };
    let cnt: u64 = pol_json_array_count(value_doc);
    if cnt > 128 { cnt = 128; };
    let i: u64 = 0;
    while i < cnt {
        let node: u64 = pol_json_array_at(value_doc, i);
        // path = entry.path.trim().slice(0, 4096): probed on the raw
        // JSON string bytes so the full 4096 range survives (no 1024
        // StrItem round-trip).
        let sp: ptr = PTR_NULL();
        let sl: u64 = 0;
        if sa_json_object_get_string(node, STR_PTR("path"), STR_LEN("path"), &sp, &sl) == 0 {
            let ts: u64 = 0;
            let te: u64 = 0;
            pol_trimmed_range(sp, sl, &ts, &te);
            if te > ts {
                let n: u64 = out.len;
                if n < 128 {
                    let dst: ptr = PTR_NULL();
                    PTR_BYTE_ADD(dst, &out.items[n].path, 0);
                    let m: u64 = te - ts;
                    if m > 4096 { m = 4096; };
                    let k: u64 = 0;
                    while k < m {
                        let b: u8 = pol_byte_at(sp, ts + k);
                        let dp: ptr = PTR_NULL();
                        PTR_BYTE_ADD(dp, dst, k);
                        PTR_WRITE_U8(dp, b);
                        k = k + 1;
                    }
                    out.items[n].path_len = m;
                    out.items[n].args.len = 0;
                    out.items[n].has_args = false;
                    let adoc: u64 = pol_json_obj(node, STR_PTR("args"), STR_LEN("args"));
                    if pol_json_kind(adoc) == 6 && pol_json_array_count(adoc) > 0 {
                        out.items[n].has_args = true;
                        pol_json_str_list(adoc, &out.items[n].args);
                        if out.items[n].args.len > 64 {
                            out.items[n].args.len = 64;
                        };
                    };
                    out.len = n + 1;
                };
            };
        };
        i = i + 1;
    }
    return;
}
fn normalizeContextSavings(value_doc: u64, out: &SaVmContextSavingsConfig, has: &bool) -> void {
    out.locateBeforeRead = false;
    out.maxReadFileBytes = 0;
    out.maxReadFileBytes_has = false;
    out.grepCircuitBreaker = false;
    out.grepMaxResults = 0;
    out.grepMaxResults_has = false;
    out.grepMaxTokens = 0;
    out.grepMaxTokens_has = false;
    out.slimRunnerOutput = false;
    out.parallelBudget = false;
    out.parallelMaxTotalBytes = 0;
    out.parallelMaxTotalBytes_has = false;
    out.parallelMaxReadFiles = 0;
    out.parallelMaxReadFiles_has = false;
    out.parallelDeduplication = false;
    out.tieredSkillInjection = false;
    out.foldWaterfallEvents = false;
    out.foldHistoryReadSummaries = false;
    out.historyReadFoldTurns = 0;
    out.historyReadFoldTurns_has = false;
    let k: u32 = pol_json_kind(value_doc);
    // Source: !value || typeof value !== "object" -> undefined. Arrays
    // are typeof "object" in JS, so kinds 7 and 6 both proceed.
    if k != 7 && k != 6 {
        *has = false;
        return;
    };
    *has = true;
    out.locateBeforeRead = pol_json_is_true(value_doc, STR_PTR("locateBeforeRead"), STR_LEN("locateBeforeRead"));
    pol_cs_num(value_doc, STR_PTR("maxReadFileBytes"), STR_LEN("maxReadFileBytes"), &out.maxReadFileBytes, &out.maxReadFileBytes_has);
    out.grepCircuitBreaker = pol_json_is_true(value_doc, STR_PTR("grepCircuitBreaker"), STR_LEN("grepCircuitBreaker"));
    pol_cs_num(value_doc, STR_PTR("grepMaxResults"), STR_LEN("grepMaxResults"), &out.grepMaxResults, &out.grepMaxResults_has);
    pol_cs_num(value_doc, STR_PTR("grepMaxTokens"), STR_LEN("grepMaxTokens"), &out.grepMaxTokens, &out.grepMaxTokens_has);
    out.slimRunnerOutput = pol_json_is_true(value_doc, STR_PTR("slimRunnerOutput"), STR_LEN("slimRunnerOutput"));
    out.parallelBudget = pol_json_is_true(value_doc, STR_PTR("parallelBudget"), STR_LEN("parallelBudget"));
    pol_cs_num(value_doc, STR_PTR("parallelMaxTotalBytes"), STR_LEN("parallelMaxTotalBytes"), &out.parallelMaxTotalBytes, &out.parallelMaxTotalBytes_has);
    pol_cs_num(value_doc, STR_PTR("parallelMaxReadFiles"), STR_LEN("parallelMaxReadFiles"), &out.parallelMaxReadFiles, &out.parallelMaxReadFiles_has);
    out.parallelDeduplication = pol_json_is_true(value_doc, STR_PTR("parallelDeduplication"), STR_LEN("parallelDeduplication"));
    out.tieredSkillInjection = pol_json_is_true(value_doc, STR_PTR("tieredSkillInjection"), STR_LEN("tieredSkillInjection"));
    out.foldWaterfallEvents = pol_json_is_true(value_doc, STR_PTR("foldWaterfallEvents"), STR_LEN("foldWaterfallEvents"));
    out.foldHistoryReadSummaries = pol_json_is_true(value_doc, STR_PTR("foldHistoryReadSummaries"), STR_LEN("foldHistoryReadSummaries"));
    pol_cs_num(value_doc, STR_PTR("historyReadFoldTurns"), STR_LEN("historyReadFoldTurns"), &out.historyReadFoldTurns, &out.historyReadFoldTurns_has);
    return;
}
fn pol_cs_num(doc: u64, key_ptr: ptr, key_len: u64, val_out: &u64, has_out: &bool) -> void {
    // Source: typeof raw === "number" && raw > 0 ? raw : undefined.
    *has_out = false;
    *val_out = 0;
    let h: u64 = pol_json_obj(doc, key_ptr, key_len);
    let k: u32 = pol_json_kind(h);
    if k == 2 || k == 3 || k == 4 {
        let fv: f64 = 0.0;
        if sa_json_as_f64(h, &fv) == 0 {
            if fv > 0.0 {
                *val_out = fv as u64;
                *has_out = true;
            };
        };
    };
    return;
}
struct BunConfigResult {
    has_bun: bool,
    enabled: bool,
    allowedSubcommands: StrList,
}
fn normalizeBunConfig(value_doc: u64, value_kind: u32, has_out: &bool, enabled_out: &bool, allowed: &StrList) -> void {
    // Signature adapted from the bulk pass (which returned a
    // BunConfigResult struct by out-param): the three result fields are
    // written through out-params so normalizeSaVmPolicy can target the
    // policy fields directly. value_kind: 0 = other/undefined,
    // 1 = true, 2 = false, 3 = object (arrays included — typeof [] ===
    // "object"). Source returns { bun: {...} } for true/false/object,
    // {} otherwise.
    *has_out = false;
    *enabled_out = false;
    allowed.len = 0;
    if value_kind == 1 {
        *has_out = true;
        *enabled_out = true;
        pol_bun_all_subs(allowed);
        return;
    };
    if value_kind == 2 {
        *has_out = true;
        *enabled_out = false;
        return;
    };
    if value_kind == 3 {
        *has_out = true;
        *enabled_out = pol_json_not_false(value_doc, STR_PTR("enabled"), STR_LEN("enabled"));
        let adoc: u64 = pol_json_obj(value_doc, STR_PTR("allowedSubcommands"), STR_LEN("allowedSubcommands"));
        if pol_json_kind(adoc) == 6 {
            let cnt: u64 = pol_json_array_count(adoc);
            let it = StrItem { bytes: [0u8; 1024], len: 0 };
            let i: u64 = 0;
            while i < cnt {
                let h: u64 = pol_json_array_at(adoc, i);
                let has_s: bool = false;
                pol_node_str(h, &it, &has_s);
                if has_s && pol_bun_sub_member(pol_item_ptr(&it), it.len) {
                    pol_list_push(allowed, pol_item_ptr(&it), it.len);
                };
                i = i + 1;
            }
        } else {
            pol_bun_all_subs(allowed);
        };
        return;
    };
    return;
}
fn normalizeBunProfiles(value_doc: u64, out: &StrList) -> void {
    // Source: non-array -> []; else [...new Set(filter(member of
    // ALL_SA_VM_BUN_PROFILES))] — filter keeps order, Set dedupes.
    out.len = 0;
    if pol_json_kind(value_doc) != 6 { return; };
    let cnt: u64 = pol_json_array_count(value_doc);
    let it = StrItem { bytes: [0u8; 1024], len: 0 };
    let i: u64 = 0;
    while i < cnt {
        let h: u64 = pol_json_array_at(value_doc, i);
        let has_s: bool = false;
        pol_node_str(h, &it, &has_s);
        if has_s && pol_bun_prof_member(pol_item_ptr(&it), it.len) {
            if !pol_list_contains(out, pol_item_ptr(&it), it.len) {
                pol_list_push(out, pol_item_ptr(&it), it.len);
            };
        };
        i = i + 1;
    }
    return;
}
fn isWindowsDeviceName(name_ptr: ptr, name_len: u64) -> bool {
    // /^(?:con|prn|aux|nul|com[1-9]|lpt[1-9])(?:\..*)?$/i — hand scanner.
    if name_len >= 3 {
        let b0: u8 = pol_lower_byte(pol_byte_at(name_ptr, 0));
        let b1: u8 = pol_lower_byte(pol_byte_at(name_ptr, 1));
        let b2: u8 = pol_lower_byte(pol_byte_at(name_ptr, 2));
        let word3: bool = false;
        if b0 == 99 && b1 == 111 && b2 == 110 { word3 = true; };
        if b0 == 112 && b1 == 114 && b2 == 110 { word3 = true; };
        if b0 == 97 && b1 == 117 && b2 == 120 { word3 = true; };
        if b0 == 110 && b1 == 117 && b2 == 108 { word3 = true; };
        if word3 {
            if name_len == 3 { return true; };
            if pol_byte_at(name_ptr, 3) == 46 { return true; };
            return false;
        };
        if name_len >= 4 {
            let b3: u8 = pol_byte_at(name_ptr, 3);
            let fam: bool = false;
            if b0 == 99 && b1 == 111 && b2 == 109 { fam = true; };
            if b0 == 108 && b1 == 112 && b2 == 116 { fam = true; };
            if fam && b3 >= 49 && b3 <= 57 {
                if name_len == 4 { return true; };
                if pol_byte_at(name_ptr, 4) == 46 { return true; };
                return false;
            };
        };
    };
    return false;
}

// ---------- normalizeSaVmPolicy (fix phase) ----------
fn pol_help_root(entries: &FsEntryList, cand_ptr: ptr, cand_len: u64, root: &StrItem) -> void {
    // Source help-root rule: resolvedRoot = absolute ? resolve(it)
    // : resolve(root, it); pattern = slashes(resolvedRoot) minus
    // trailing slashes + "/**", lowercased; an explicit deny glob wins;
    // an existing identical read entry suppresses the push.
    let resolved = StrItem { bytes: [0u8; 1024], len: 0 };
    pol_resolve_normalized(&resolved, pol_item_ptr(root), root.len, cand_ptr, cand_len, false);
    let pat = StrItem { bytes: [0u8; 1024], len: 0 };
    let tl: u64 = resolved.len;
    let trimming: bool = true;
    while trimming {
        if tl == 0 {
            trimming = false;
        } else {
            if pol_item_byte(&resolved, tl - 1) == 47 { tl = tl - 1; } else { trimming = false; };
        };
    }
    pol_item_set(&pat, pol_item_ptr(&resolved), tl);
    pol_item_push_byte(&pat, 47);
    pol_item_push_byte(&pat, 42);
    pol_item_push_byte(&pat, 42);
    pol_lower_in_place(&pat);
    let denied: bool = false;
    let i: u64 = 0;
    while i < entries.len {
        if entries.items[i].access == 2 {
            let ep: ptr = PTR_NULL();
            PTR_BYTE_ADD(ep, &entries.items[i].path, 0);
            if pol_glob_pp(pol_item_ptr(&pat), pat.len, ep, entries.items[i].path_len) { denied = true; };
        };
        i = i + 1;
    }
    if denied { return; };
    i = 0;
    while i < entries.len {
        if entries.items[i].access == 0 {
            let ep: ptr = PTR_NULL();
            PTR_BYTE_ADD(ep, &entries.items[i].path, 0);
            if pol_bytes_eq(ep, entries.items[i].path_len, pol_item_ptr(&pat), pat.len) { return; };
        };
        i = i + 1;
    }
    pol_entry_push(entries, pol_item_ptr(&pat), pat.len, 0);
    return;
}
fn normalizeSaVmPolicy(config_doc: u64, cwd_ptr: ptr, cwd_len: u64, additionalRoots: &StrList, out: &NormalizedSaVmPolicy) -> void {
    out.engine = 0;
    out.fs.entries.len = 0;
    out.fs.read.len = 0;
    out.fs.write.len = 0;
    out.fs.transfer.len = 0;
    out.fs.delete = 2;
    out.fs.backupDir_len = 0;
    out.fs.backupDir_has = false;
    out.http_allow.len = 0;
    out.env_allow.len = 0;
    out.process.spawn = false;
    out.process.exec.len = 0;
    out.process.bunProfiles.len = 0;
    out.process.has_bunProfiles = false;
    out.process.bun_enabled = false;
    out.process.bun_allowedSubcommands.len = 0;
    out.process.has_bun = false;
    out.execution_javascript = false;
    out.execution_python = false;
    out.tools.replaceRead = true;
    out.tools.replaceWrite = true;
    out.tools.replaceApplyPatch = true;
    out.tools.replaceExec = true;
    out.tools.readFiles = true;
    out.tools.editFiles = true;
    out.tools.applyPatch = true;
    out.tools.fastSearch = true;
    out.tools.clearToolHistory = true;
    out.tools.findReferences = true;
    out.tools.renameSymbol = true;
    out.tools.fileOutline = true;
    out.tools.moveWithImports = true;
    out.tools.findDefinition = true;
    out.tools.extractToFile = true;
    out.tools.addImport = true;
    out.tools.getDiagnostics = true;
    out.tools.organizeImports = true;
    out.tools.analyzeScope = true;
    out.tools.codeGraph = true;
    out.contextSavings.locateBeforeRead = false;
    out.contextSavings.maxReadFileBytes = 0;
    out.contextSavings.maxReadFileBytes_has = false;
    out.contextSavings.grepCircuitBreaker = false;
    out.contextSavings.grepMaxResults = 0;
    out.contextSavings.grepMaxResults_has = false;
    out.contextSavings.grepMaxTokens = 0;
    out.contextSavings.grepMaxTokens_has = false;
    out.contextSavings.slimRunnerOutput = false;
    out.contextSavings.parallelBudget = false;
    out.contextSavings.parallelMaxTotalBytes = 0;
    out.contextSavings.parallelMaxTotalBytes_has = false;
    out.contextSavings.parallelMaxReadFiles = 0;
    out.contextSavings.parallelMaxReadFiles_has = false;
    out.contextSavings.parallelDeduplication = false;
    out.contextSavings.tieredSkillInjection = false;
    out.contextSavings.foldWaterfallEvents = false;
    out.contextSavings.foldHistoryReadSummaries = false;
    out.contextSavings.historyReadFoldTurns = 0;
    out.contextSavings.historyReadFoldTurns_has = false;
    out.contextSavings_has = false;

    // root = resolve(cwd)
    let root = StrItem { bytes: [0u8; 1024], len: 0 };
    pol_resolve_normalized(&root, cwd_ptr, cwd_len, cwd_ptr, cwd_len, false);
    let fs_doc: u64 = pol_json_obj(config_doc, STR_PTR("fs"), STR_LEN("fs"));

    // defaultRoots = [root, ...allAdditionalRoots.map(r => resolve(root, r))]
    // allAdditionalRoots = [...additionalRoots, ...configRoots];
    // configRoots: config.additionalRoots if an array, else
    // fs.additionalRoots if an array, else []; entries are raw strings
    // whose trim is non-empty.
    let defaultRoots = StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 };
    pol_list_push(&defaultRoots, pol_item_ptr(&root), root.len);
    let tmp = StrItem { bytes: [0u8; 1024], len: 0 };
    let i: u64 = 0;
    while i < additionalRoots.len {
        pol_resolve_normalized(&tmp, pol_item_ptr(&root), root.len, pol_item_ptr(&additionalRoots.items[i]), additionalRoots.items[i].len, false);
        pol_list_push(&defaultRoots, pol_item_ptr(&tmp), tmp.len);
        i = i + 1;
    }
    let croots_doc: u64 = pol_json_obj(config_doc, STR_PTR("additionalRoots"), STR_LEN("additionalRoots"));
    if pol_json_kind(croots_doc) != 6 {
        croots_doc = pol_json_obj(fs_doc, STR_PTR("additionalRoots"), STR_LEN("additionalRoots"));
    };
    if pol_json_kind(croots_doc) == 6 {
        let cc: u64 = pol_json_array_count(croots_doc);
        let cit = StrItem { bytes: [0u8; 1024], len: 0 };
        let k: u64 = 0;
        while k < cc {
            let h: u64 = pol_json_array_at(croots_doc, k);
            let has_s: bool = false;
            pol_node_str(h, &cit, &has_s);
            if has_s {
                let ts: u64 = 0;
                let te: u64 = 0;
                pol_trimmed_range(pol_item_ptr(&cit), cit.len, &ts, &te);
                if te > ts {
                    pol_resolve_normalized(&tmp, pol_item_ptr(&root), root.len, pol_item_ptr(&cit), cit.len, false);
                    pol_list_push(&defaultRoots, pol_item_ptr(&tmp), tmp.len);
                };
            };
            k = k + 1;
        }
    };

    // entries: fs.entries (non-empty array) -> normalizeEntries(.., root),
    // else legacyEntries(fs, root, defaultRoots). NOTE the source passes
    // the RESOLVED root as those helpers' cwd argument.
    let entries_doc: u64 = pol_json_obj(fs_doc, STR_PTR("entries"), STR_LEN("entries"));
    if pol_json_kind(entries_doc) == 6 && pol_json_array_count(entries_doc) > 0 {
        normalizeEntries(entries_doc, pol_item_ptr(&root), root.len, &out.fs.entries);
    } else {
        legacyEntries(fs_doc, pol_item_ptr(&root), root.len, &defaultRoots, &out.fs.entries);
    };

    // Additional roots become implicit read entries unless an entry with
    // the same pattern exists or a deny glob covers the pattern.
    let pat = StrItem { bytes: [0u8; 1024], len: 0 };
    let j: u64 = 1;
    while j < defaultRoots.len {
        let rp: ptr = pol_item_ptr(&defaultRoots.items[j]);
        let rl: u64 = defaultRoots.items[j].len;
        let tl: u64 = rl;
        let trimming: bool = true;
        while trimming {
            if tl == 0 {
                trimming = false;
            } else {
                let b: u8 = pol_byte_at(rp, tl - 1);
                if b == 47 || b == 92 { tl = tl - 1; } else { trimming = false; };
            };
        }
        pol_item_set(&pat, rp, tl);
        pol_item_push_byte(&pat, 47);
        pol_item_push_byte(&pat, 42);
        pol_item_push_byte(&pat, 42);
        pol_slash_in_place(&pat);
        pol_lower_in_place(&pat);
        let has_rule: bool = false;
        let denied: bool = false;
        let ei: u64 = 0;
        while ei < out.fs.entries.len {
            let ep: ptr = PTR_NULL();
            PTR_BYTE_ADD(ep, &out.fs.entries.items[ei].path, 0);
            let el: u64 = out.fs.entries.items[ei].path_len;
            if pol_bytes_eq(ep, el, pol_item_ptr(&pat), pat.len) { has_rule = true; };
            if out.fs.entries.items[ei].access == 2 && pol_glob_pp(pol_item_ptr(&pat), pat.len, ep, el) { denied = true; };
            ei = ei + 1;
        }
        if !has_rule && !denied {
            pol_entry_push(&out.fs.entries, pol_item_ptr(&pat), pat.len, 0);
        };
        j = j + 1;
    }

    // Help roots: configured sala root, configured std dir,
    // join(codexUiDataDir(), "sa-vm"), tmpdir(), "/tmp", "C:/tmp".
    let cand = StrItem { bytes: [0u8; 1024], len: 0 };
    let cand_has: bool = false;
    let sr = StrItem { bytes: [0u8; 1024], len: 0 };
    let sr_has: bool = false;
    pol_json_str_field(fs_doc, STR_PTR("salaRoot"), STR_LEN("salaRoot"), &sr, &sr_has);
    if sr_has {
        let ts2: u64 = 0;
        let te2: u64 = 0;
        pol_trimmed_range(pol_item_ptr(&sr), sr.len, &ts2, &te2);
        if te2 > ts2 {
            pol_item_set(&cand, pol_item_ptr(&sr), sr.len);
            cand_has = true;
        };
    };
    if !cand_has {
        pol_env_trimmed(STR_PTR("CODEX_UI_SA_VM_SALA_DIR"), STR_LEN("CODEX_UI_SA_VM_SALA_DIR"), &cand, &cand_has);
    };
    if cand_has { pol_help_root(&out.fs.entries, pol_item_ptr(&cand), cand.len, &root); };
    cand_has = false;
    pol_env_trimmed(STR_PTR("SA_STD_DIR"), STR_LEN("SA_STD_DIR"), &cand, &cand_has);
    if !cand_has {
        pol_env_trimmed(STR_PTR("CODEX_UI_SA_STD_DIR"), STR_LEN("CODEX_UI_SA_STD_DIR"), &cand, &cand_has);
    };
    if cand_has { pol_help_root(&out.fs.entries, pol_item_ptr(&cand), cand.len, &root); };
    let dd = StrItem { bytes: [0u8; 1024], len: 0 };
    pol_data_dir(&dd);
    let joined = StrItem { bytes: [0u8; 1024], len: 0 };
    if dd.len > 0 {
        pol_resolve_normalized(&joined, pol_item_ptr(&dd), dd.len, STR_PTR("sa-vm"), STR_LEN("sa-vm"), false);
    } else {
        pol_item_set(&joined, STR_PTR("sa-vm"), STR_LEN("sa-vm"));
    };
    pol_help_root(&out.fs.entries, pol_item_ptr(&joined), joined.len, &root);
    let td = StrItem { bytes: [0u8; 1024], len: 0 };
    pol_tmpdir(&td);
    pol_help_root(&out.fs.entries, pol_item_ptr(&td), td.len, &root);
    pol_help_root(&out.fs.entries, STR_PTR("/tmp"), STR_LEN("/tmp"), &root);
    pol_help_root(&out.fs.entries, STR_PTR("C:/tmp"), STR_LEN("C:/tmp"), &root);

    // read = dedupe(paths of entries with access read OR write);
    // write = dedupe(paths of write entries).
    let ei2: u64 = 0;
    while ei2 < out.fs.entries.len {
        let acc: u32 = out.fs.entries.items[ei2].access;
        let ep: ptr = PTR_NULL();
        PTR_BYTE_ADD(ep, &out.fs.entries.items[ei2].path, 0);
        let el: u64 = out.fs.entries.items[ei2].path_len;
        if acc == 0 || acc == 1 { pol_list_push(&out.fs.read, ep, el); };
        if acc == 1 { pol_list_push(&out.fs.write, ep, el); };
        ei2 = ei2 + 1;
    }
    dedupe(&out.fs.read);
    dedupe(&out.fs.write);

    // transfer = normalizePatterns(fs.transfer, root, write)
    let transfer_doc: u64 = pol_json_obj(fs_doc, STR_PTR("transfer"), STR_LEN("transfer"));
    pol_json_str_list(transfer_doc, &out.fs.transfer);
    normalizePatterns(&out.fs.transfer, pol_json_kind(transfer_doc) == 6, pol_item_ptr(&root), root.len, &out.fs.write, &out.fs.transfer);

    // delete: rename -> 0, move -> 1, deny -> 2, anything else -> 2
    let del_s = StrItem { bytes: [0u8; 1024], len: 0 };
    let del_has: bool = false;
    pol_json_str_field(fs_doc, STR_PTR("delete"), STR_LEN("delete"), &del_s, &del_has);
    out.fs.delete = 2;
    if del_has {
        if pol_bytes_eq(pol_item_ptr(&del_s), del_s.len, STR_PTR("rename"), STR_LEN("rename")) { out.fs.delete = 0; };
        if pol_bytes_eq(pol_item_ptr(&del_s), del_s.len, STR_PTR("move"), STR_LEN("move")) { out.fs.delete = 1; };
    };

    // backupDir: null/absent -> none; string -> resolvePolicyPath(it, root)
    let bd_doc: u64 = pol_json_obj(fs_doc, STR_PTR("backupDir"), STR_LEN("backupDir"));
    if pol_json_kind(bd_doc) == 5 {
        let bd = StrItem { bytes: [0u8; 1024], len: 0 };
        let bd_has: bool = false;
        pol_node_str(bd_doc, &bd, &bd_has);
        if bd_has && bd.len > 0 {
            let res = StrItem { bytes: [0u8; 1024], len: 0 };
            resolvePolicyPath(pol_item_ptr(&bd), bd.len, pol_item_ptr(&root), root.len, &res);
            let dst: ptr = PTR_NULL();
            PTR_BYTE_ADD(dst, &out.fs.backupDir, 0);
            let bi: u64 = 0;
            while bi < res.len {
                let b: u8 = pol_byte_at(pol_item_ptr(&res), bi);
                let dp: ptr = PTR_NULL();
                PTR_BYTE_ADD(dp, dst, bi);
                PTR_WRITE_U8(dp, b);
                bi = bi + 1;
            }
            out.fs.backupDir_len = res.len;
            out.fs.backupDir_has = true;
        };
    };

    // engine: "vm" -> 1, else 0 ("native")
    let eng = StrItem { bytes: [0u8; 1024], len: 0 };
    let eng_has: bool = false;
    pol_json_str_field(config_doc, STR_PTR("engine"), STR_LEN("engine"), &eng, &eng_has);
    if eng_has && pol_bytes_eq(pol_item_ptr(&eng), eng.len, STR_PTR("vm"), STR_LEN("vm")) {
        out.engine = 1;
    };

    normalizeHttpRules(pol_json_obj(pol_json_obj(config_doc, STR_PTR("http"), STR_LEN("http")), STR_PTR("allow"), STR_LEN("allow")), &out.http_allow);
    let env_allow_doc: u64 = pol_json_obj(pol_json_obj(config_doc, STR_PTR("env"), STR_LEN("env")), STR_PTR("allow"), STR_LEN("allow"));
    pol_json_str_list(env_allow_doc, &out.env_allow);
    normalizeEnv(&out.env_allow, pol_json_kind(env_allow_doc) == 6, &out.env_allow);

    let proc_doc: u64 = pol_json_obj(config_doc, STR_PTR("process"), STR_LEN("process"));
    out.process.spawn = pol_json_is_true(proc_doc, STR_PTR("spawn"), STR_LEN("spawn"));
    normalizeExecRules(pol_json_obj(proc_doc, STR_PTR("exec"), STR_LEN("exec")), &out.process.exec);
    normalizeBunProfiles(pol_json_obj(proc_doc, STR_PTR("bunProfiles"), STR_LEN("bunProfiles")), &out.process.bunProfiles);
    out.process.has_bunProfiles = out.process.bunProfiles.len > 0;
    let bun_doc: u64 = pol_json_obj(proc_doc, STR_PTR("bun"), STR_LEN("bun"));
    let bun_kind: u32 = 0;
    let bk: u32 = pol_json_kind(bun_doc);
    if bk == 1 {
        let bv: bool = false;
        let bst: i32 = sa_json_as_bool(bun_doc, &bv);
        if bv { bun_kind = 1; } else { bun_kind = 2; };
    };
    if bk == 7 || bk == 6 { bun_kind = 3; };
    normalizeBunConfig(bun_doc, bun_kind, &out.process.has_bun, &out.process.bun_enabled, &out.process.bun_allowedSubcommands);

    let exec_doc: u64 = pol_json_obj(config_doc, STR_PTR("execution"), STR_LEN("execution"));
    out.execution_javascript = pol_json_is_true(exec_doc, STR_PTR("javascript"), STR_LEN("javascript"));
    out.execution_python = pol_json_is_true(exec_doc, STR_PTR("python"), STR_LEN("python"));

    let tools_doc: u64 = pol_json_obj(config_doc, STR_PTR("tools"), STR_LEN("tools"));
    out.tools.replaceRead = pol_json_not_false(tools_doc, STR_PTR("replaceRead"), STR_LEN("replaceRead"));
    out.tools.replaceWrite = pol_json_not_false(tools_doc, STR_PTR("replaceWrite"), STR_LEN("replaceWrite"));
    out.tools.replaceApplyPatch = pol_json_not_false(tools_doc, STR_PTR("replaceApplyPatch"), STR_LEN("replaceApplyPatch"));
    out.tools.replaceExec = pol_json_not_false(tools_doc, STR_PTR("replaceExec"), STR_LEN("replaceExec"));
    out.tools.readFiles = pol_json_not_false(tools_doc, STR_PTR("readFiles"), STR_LEN("readFiles"));
    out.tools.editFiles = pol_json_not_false(tools_doc, STR_PTR("editFiles"), STR_LEN("editFiles"));
    out.tools.applyPatch = pol_json_not_false(tools_doc, STR_PTR("applyPatch"), STR_LEN("applyPatch"));
    out.tools.fastSearch = pol_json_not_false(tools_doc, STR_PTR("fastSearch"), STR_LEN("fastSearch"));
    out.tools.clearToolHistory = pol_json_not_false(tools_doc, STR_PTR("clearToolHistory"), STR_LEN("clearToolHistory"));
    out.tools.findReferences = pol_json_not_false(tools_doc, STR_PTR("findReferences"), STR_LEN("findReferences"));
    out.tools.renameSymbol = pol_json_not_false(tools_doc, STR_PTR("renameSymbol"), STR_LEN("renameSymbol"));
    out.tools.fileOutline = pol_json_not_false(tools_doc, STR_PTR("fileOutline"), STR_LEN("fileOutline"));
    out.tools.moveWithImports = pol_json_not_false(tools_doc, STR_PTR("moveWithImports"), STR_LEN("moveWithImports"));
    out.tools.findDefinition = pol_json_not_false(tools_doc, STR_PTR("findDefinition"), STR_LEN("findDefinition"));
    out.tools.extractToFile = pol_json_not_false(tools_doc, STR_PTR("extractToFile"), STR_LEN("extractToFile"));
    out.tools.addImport = pol_json_not_false(tools_doc, STR_PTR("addImport"), STR_LEN("addImport"));
    out.tools.getDiagnostics = pol_json_not_false(tools_doc, STR_PTR("getDiagnostics"), STR_LEN("getDiagnostics"));
    out.tools.organizeImports = pol_json_not_false(tools_doc, STR_PTR("organizeImports"), STR_LEN("organizeImports"));
    out.tools.analyzeScope = pol_json_not_false(tools_doc, STR_PTR("analyzeScope"), STR_LEN("analyzeScope"));
    out.tools.codeGraph = pol_json_not_false(tools_doc, STR_PTR("codeGraph"), STR_LEN("codeGraph"));

    // contextSavings spreads only when the value is truthy in JS terms.
    let cs_doc: u64 = pol_json_obj(config_doc, STR_PTR("contextSavings"), STR_LEN("contextSavings"));
    if pol_json_truthy(cs_doc) {
        normalizeContextSavings(cs_doc, &out.contextSavings, &out.contextSavings_has);
    };
    return;
}

// ---------- checks (fix phase) ----------
fn pol_candidate_path(candidate_ptr: ptr, candidate_len: u64, cwd_ptr: ptr, cwd_len: u64, path: &StrItem) -> bool {
    // Shared head of checkSaVmPath / checkSaVmDelete: false when the
    // candidate is blank-after-trim or contains a NUL byte; otherwise
    // path = resolvePolicyPath(candidate, resolve(cwd)).
    let ts: u64 = 0;
    let te: u64 = 0;
    pol_trimmed_range(candidate_ptr, candidate_len, &ts, &te);
    let has_nul: bool = false;
    let i: u64 = 0;
    while i < candidate_len {
        if pol_byte_at(candidate_ptr, i) == 0 { has_nul = true; };
        i = i + 1;
    }
    if te <= ts || has_nul { return false; };
    let rcwd = StrItem { bytes: [0u8; 1024], len: 0 };
    pol_resolve_normalized(&rcwd, cwd_ptr, cwd_len, cwd_ptr, cwd_len, false);
    resolvePolicyPath(candidate_ptr, candidate_len, pol_item_ptr(&rcwd), rcwd.len, path);
    return true;
}
fn pol_basename_start(p: ptr, n: u64) -> u64 {
    let bs: u64 = 0;
    let j: u64 = 0;
    while j < n {
        if pol_byte_at(p, j) == 47 { bs = j + 1; };
        j = j + 1;
    }
    return bs;
}
fn pol_dec_op_reason(out: &SaVmPolicyDecision, denied: bool, operation: u32, candidate_ptr: ptr, candidate_len: u64, cwd_ptr: ptr, cwd_len: u64, path_ptr: ptr, path_len: u64) -> void {
    // `path is (not allowed|denied) for ${operation}: '${candidate}'. Workspace root is '${cwd}'.`
    // — candidate and cwd interpolate RAW, exactly as the source does.
    pol_dec_reset(out, false);
    if denied {
        pol_dec_put(out, STR_PTR("path is denied for "), STR_LEN("path is denied for "));
    } else {
        pol_dec_put(out, STR_PTR("path is not allowed for "), STR_LEN("path is not allowed for "));
    };
    if operation == 0 { pol_dec_put(out, STR_PTR("read"), STR_LEN("read")); };
    if operation == 1 { pol_dec_put(out, STR_PTR("write"), STR_LEN("write")); };
    if operation == 2 { pol_dec_put(out, STR_PTR("transfer"), STR_LEN("transfer")); };
    pol_dec_put(out, STR_PTR(": '"), STR_LEN(": '"));
    pol_dec_put(out, candidate_ptr, candidate_len);
    pol_dec_put(out, STR_PTR("'. Workspace root is '"), STR_LEN("'. Workspace root is '"));
    pol_dec_put(out, cwd_ptr, cwd_len);
    pol_dec_put(out, STR_PTR("'."), STR_LEN("'."));
    pol_dec_path_put(out, path_ptr, path_len);
    return;
}
fn pol_dec_device(out: &SaVmPolicyDecision, path: &StrItem) -> bool {
    let pp: ptr = pol_item_ptr(path);
    let bs: u64 = pol_basename_start(pp, path.len);
    let bptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(bptr, pp, bs);
    if isWindowsDeviceName(bptr, path.len - bs) {
        pol_dec_reset(out, false);
        pol_dec_put(out, STR_PTR("path targets reserved device name: "), STR_LEN("path targets reserved device name: "));
        pol_dec_put(out, bptr, path.len - bs);
        pol_dec_path_put(out, pp, path.len);
        return true;
    };
    return false;
}
fn checkSaVmPath(policy: &NormalizedSaVmPolicy, operation: u32, candidate_ptr: ptr, candidate_len: u64, cwd_ptr: ptr, cwd_len: u64, out: &SaVmPolicyDecision) -> void {
    pol_dec_reset(out, false);
    let path = StrItem { bytes: [0u8; 1024], len: 0 };
    if !pol_candidate_path(candidate_ptr, candidate_len, cwd_ptr, cwd_len, &path) {
        pol_dec_put(out, STR_PTR("invalid path characters"), STR_LEN("invalid path characters"));
        return;
    };
    if pol_dec_device(out, &path) { return; };
    let pp: ptr = pol_item_ptr(&path);
    if operation == 0 {
        // Read fast-path: an existing file/directory is allowed even
        // outside the policy roots (source statSync branch).
        let mh: u64 = 0;
        if sa_std_fs_metadata(pp, path.len, &mh) == 0 && mh != 0 {
            let isf: u8 = sa_fs_metadata_is_file(mh);
            let isd: u8 = sa_fs_metadata_is_directory(mh);
            if isf != 0 || isd != 0 {
                pol_dec_reset(out, true);
                pol_dec_path_put(out, pp, path.len);
                return;
            };
        };
    };
    if policy.fs.entries.len > 0 {
        let acc: u32 = 0;
        let has: bool = false;
        resolveFsAccess(&policy.fs.entries, pp, path.len, &acc, &has);
        if has && acc == 2 {
            pol_dec_op_reason(out, true, operation, candidate_ptr, candidate_len, cwd_ptr, cwd_len, pp, path.len);
            return;
        };
        let allowed: bool = false;
        if has {
            if operation == 0 {
                if acc == 0 || acc == 1 { allowed = true; };
            } else {
                if acc == 1 { allowed = true; };
            };
        };
        if allowed {
            pol_dec_reset(out, true);
            pol_dec_path_put(out, pp, path.len);
            return;
        };
        pol_dec_op_reason(out, false, operation, candidate_ptr, candidate_len, cwd_ptr, cwd_len, pp, path.len);
        return;
    };
    let matched: bool = false;
    if operation == 0 { matched = matchesAny(pp, path.len, &policy.fs.read); };
    if operation == 1 { matched = matchesAny(pp, path.len, &policy.fs.write); };
    if operation == 2 { matched = matchesAny(pp, path.len, &policy.fs.transfer); };
    if matched {
        pol_dec_reset(out, true);
        pol_dec_path_put(out, pp, path.len);
        return;
    };
    pol_dec_op_reason(out, false, operation, candidate_ptr, candidate_len, cwd_ptr, cwd_len, pp, path.len);
    return;
}
fn checkSaVmDelete(policy: &NormalizedSaVmPolicy, candidate_ptr: ptr, candidate_len: u64, cwd_ptr: ptr, cwd_len: u64, out: &SaVmPolicyDecision) -> void {
    pol_dec_reset(out, false);
    let path = StrItem { bytes: [0u8; 1024], len: 0 };
    if !pol_candidate_path(candidate_ptr, candidate_len, cwd_ptr, cwd_len, &path) {
        pol_dec_put(out, STR_PTR("invalid path characters"), STR_LEN("invalid path characters"));
        return;
    };
    if pol_dec_device(out, &path) { return; };
    let pp: ptr = pol_item_ptr(&path);
    if policy.fs.delete == 2 {
        pol_dec_put(out, STR_PTR("delete policy is deny"), STR_LEN("delete policy is deny"));
        pol_dec_path_put(out, pp, path.len);
        return;
    };
    if policy.fs.entries.len > 0 {
        let acc: u32 = 0;
        let has: bool = false;
        resolveFsAccess(&policy.fs.entries, pp, path.len, &acc, &has);
        if has && acc == 2 {
            pol_dec_put(out, STR_PTR("path is denied for delete"), STR_LEN("path is denied for delete"));
            pol_dec_path_put(out, pp, path.len);
            return;
        };
        let access_write: bool = has && acc == 1;
        if !access_write {
            let backup_move: bool = policy.fs.delete == 0 || policy.fs.delete == 1;
            if !(backup_move && matchesAny(pp, path.len, &policy.fs.transfer)) {
                pol_dec_put(out, STR_PTR("path is not writable for delete"), STR_LEN("path is not writable for delete"));
                pol_dec_path_put(out, pp, path.len);
                return;
            };
        };
    };
    if !matchesAny(pp, path.len, &policy.fs.transfer) && !matchesAny(pp, path.len, &policy.fs.write) {
        pol_dec_put(out, STR_PTR("path is not allowed for transfer"), STR_LEN("path is not allowed for transfer"));
        pol_dec_path_put(out, pp, path.len);
        return;
    };
    if policy.fs.delete == 0 || policy.fs.delete == 1 {
        let bd_ok: bool = false;
        if policy.fs.backupDir_has {
            let bdp: ptr = PTR_NULL();
            PTR_BYTE_ADD(bdp, &policy.fs.backupDir, 0);
            bd_ok = matchesAny(bdp, policy.fs.backupDir_len, &policy.fs.write);
        };
        if !bd_ok {
            pol_dec_put(out, STR_PTR("delete backupDir must be inside a writable policy root"), STR_LEN("delete backupDir must be inside a writable policy root"));
            pol_dec_path_put(out, pp, path.len);
            return;
        };
    };
    pol_dec_reset(out, true);
    pol_dec_path_put(out, pp, path.len);
    return;
}
fn pol_parse_port(p: ptr, s: u64, e: u64, out_port: &u64, out_has: &bool, out_ok: &bool) -> void {
    *out_has = false;
    *out_ok = true;
    *out_port = 0;
    if s >= e { return; };
    let v: u64 = 0;
    let i: u64 = s;
    while i < e {
        let b: u8 = pol_byte_at(p, i);
        if !pol_is_digit(b) {
            *out_ok = false;
            return;
        };
        v = v * 10 + ((b - 48) as u64);
        i = i + 1;
    }
    *out_port = v;
    *out_has = true;
    return;
}
fn checkSaVmHttp(policy: &NormalizedSaVmPolicy, url_ptr: ptr, url_len: u64, method_ptr: ptr, method_len: u64, out: &SaVmPolicyDecision) -> void {
    pol_dec_reset(out, false);
    // Parse first (source: new URL throws -> "invalid URL", before the
    // method check). Hand parser: scheme "://" authority, credentials
    // via '@', hostname (bracketed IPv6 keeps its brackets, as Node's
    // URL.hostname does), port, pathname, query, fragment.
    let scheme_end: u64 = 0;
    let has_scheme: bool = false;
    let i: u64 = 0;
    let scanning: bool = true;
    while scanning {
        if i + 2 >= url_len {
            scanning = false;
        } else {
            if pol_byte_at(url_ptr, i) == 58 && pol_byte_at(url_ptr, i + 1) == 47 && pol_byte_at(url_ptr, i + 2) == 47 {
                scheme_end = i;
                has_scheme = true;
                scanning = false;
            } else {
                i = i + 1;
            };
        };
    }
    if !has_scheme || scheme_end == 0 {
        pol_dec_put(out, STR_PTR("invalid URL"), STR_LEN("invalid URL"));
        return;
    };
    let scheme_ok: bool = pol_is_letter(pol_byte_at(url_ptr, 0));
    let si: u64 = 1;
    while si < scheme_end {
        let b: u8 = pol_byte_at(url_ptr, si);
        if !pol_is_letter(b) && !pol_is_digit(b) && b != 43 && b != 45 && b != 46 { scheme_ok = false; };
        si = si + 1;
    }
    let bad_char: bool = false;
    let ci: u64 = 0;
    while ci < url_len {
        if pol_byte_at(url_ptr, ci) <= 32 { bad_char = true; };
        ci = ci + 1;
    }
    if !scheme_ok || bad_char {
        pol_dec_put(out, STR_PTR("invalid URL"), STR_LEN("invalid URL"));
        return;
    };
    let auth_s: u64 = scheme_end + 3;
    let auth_e: u64 = auth_s;
    let ascanning: bool = true;
    while ascanning {
        if auth_e >= url_len {
            ascanning = false;
        } else {
            let b: u8 = pol_byte_at(url_ptr, auth_e);
            if b == 47 || b == 63 || b == 35 { ascanning = false; } else { auth_e = auth_e + 1; };
        };
    }
    let creds: bool = false;
    let host_s: u64 = auth_s;
    let ai: u64 = auth_s;
    while ai < auth_e {
        if pol_byte_at(url_ptr, ai) == 64 {
            creds = true;
            host_s = ai + 1;
        };
        ai = ai + 1;
    }
    let host_e: u64 = auth_e;
    let port_s: u64 = 0;
    let has_colon: bool = false;
    if host_s < auth_e && pol_byte_at(url_ptr, host_s) == 91 {
        let bi: u64 = host_s + 1;
        let found_close: bool = false;
        let bscanning: bool = true;
        while bscanning {
            if bi >= auth_e {
                bscanning = false;
            } else {
                if pol_byte_at(url_ptr, bi) == 93 {
                    found_close = true;
                    host_e = bi + 1;
                    bscanning = false;
                } else {
                    bi = bi + 1;
                };
            };
        }
        if !found_close {
            pol_dec_reset(out, false);
            pol_dec_put(out, STR_PTR("invalid URL"), STR_LEN("invalid URL"));
            return;
        };
        if host_e < auth_e {
            if pol_byte_at(url_ptr, host_e) == 58 {
                has_colon = true;
                port_s = host_e + 1;
            } else {
                pol_dec_reset(out, false);
                pol_dec_put(out, STR_PTR("invalid URL"), STR_LEN("invalid URL"));
                return;
            };
        };
    } else {
        let hi: u64 = host_s;
        let hscanning: bool = true;
        while hscanning {
            if hi >= auth_e {
                hscanning = false;
            } else {
                if pol_byte_at(url_ptr, hi) == 58 {
                    host_e = hi;
                    has_colon = true;
                    port_s = hi + 1;
                    hscanning = false;
                } else {
                    hi = hi + 1;
                };
            };
        }
    };
    let port: u64 = 0;
    let port_has: bool = false;
    if has_colon {
        let pok: bool = true;
        pol_parse_port(url_ptr, port_s, auth_e, &port, &port_has, &pok);
        if !pok {
            pol_dec_put(out, STR_PTR("invalid URL"), STR_LEN("invalid URL"));
            return;
        };
    };
    if host_e <= host_s {
        pol_dec_put(out, STR_PTR("invalid URL"), STR_LEN("invalid URL"));
        return;
    };
    let path_s: u64 = auth_e;
    let path_e: u64 = auth_e;
    let has_path: bool = false;
    if auth_e < url_len && pol_byte_at(url_ptr, auth_e) == 47 {
        has_path = true;
        let pscanning: bool = true;
        while pscanning {
            if path_e >= url_len {
                pscanning = false;
            } else {
                let b: u8 = pol_byte_at(url_ptr, path_e);
                if b == 63 || b == 35 { pscanning = false; } else { path_e = path_e + 1; };
            };
        }
    };
    let q_s: u64 = 0;
    let q_e: u64 = 0;
    let q_has: bool = false;
    let f_s: u64 = 0;
    let f_has: bool = false;
    let rest: u64 = path_e;
    if rest < url_len && pol_byte_at(url_ptr, rest) == 63 {
        q_has = true;
        q_s = rest + 1;
        q_e = q_s;
        let qscanning: bool = true;
        while qscanning {
            if q_e >= url_len {
                qscanning = false;
            } else {
                if pol_byte_at(url_ptr, q_e) == 35 { qscanning = false; } else { q_e = q_e + 1; };
            };
        }
        rest = q_e;
    };
    if rest < url_len && pol_byte_at(url_ptr, rest) == 35 {
        f_has = true;
        f_s = rest + 1;
    };
    // Method (source: after parse): trim + uppercase, GET/POST only.
    let mm = StrItem { bytes: [0u8; 1024], len: 0 };
    pol_item_trimmed(&mm, method_ptr, method_len);
    pol_upper_in_place(&mm);
    let mp: ptr = pol_item_ptr(&mm);
    if !pol_bytes_eq(mp, mm.len, STR_PTR("GET"), STR_LEN("GET")) && !pol_bytes_eq(mp, mm.len, STR_PTR("POST"), STR_LEN("POST")) {
        pol_dec_put(out, STR_PTR("HTTP method "), STR_LEN("HTTP method "));
        if mm.len > 0 {
            pol_dec_put(out, mp, mm.len);
        } else {
            pol_dec_put(out, STR_PTR("<empty>"), STR_LEN("<empty>"));
        };
        pol_dec_put(out, STR_PTR(" is not allowed"), STR_LEN(" is not allowed"));
        return;
    };
    // Credentials / protocol.
    let scheme = StrItem { bytes: [0u8; 1024], len: 0 };
    pol_item_set(&scheme, url_ptr, scheme_end);
    pol_lower_in_place(&scheme);
    if creds || !pol_bytes_eq(pol_item_ptr(&scheme), scheme.len, STR_PTR("https"), STR_LEN("https")) {
        pol_dec_put(out, STR_PTR("only HTTPS URLs without credentials are allowed"), STR_LEN("only HTTPS URLs without credentials are allowed"));
        return;
    };
    // Allowlist match.
    let host = StrItem { bytes: [0u8; 1024], len: 0 };
    let host_ptr2: ptr = PTR_NULL();
    PTR_BYTE_ADD(host_ptr2, url_ptr, host_s);
    pol_item_set(&host, host_ptr2, host_e - host_s);
    let pathname = StrItem { bytes: [0u8; 1024], len: 0 };
    if has_path {
        let pp3: ptr = PTR_NULL();
        PTR_BYTE_ADD(pp3, url_ptr, path_s);
        pol_item_set(&pathname, pp3, path_e - path_s);
    } else {
        pol_item_set(&pathname, STR_PTR("/"), STR_LEN("/"));
    };
    let matched: bool = false;
    let ri: u64 = 0;
    while ri < policy.http_allow.len {
        let rhp: ptr = PTR_NULL();
        PTR_BYTE_ADD(rhp, &policy.http_allow.items[ri].host, 0);
        if hostMatches(pol_item_ptr(&host), host.len, rhp, policy.http_allow.items[ri].host_len) {
            let mok: bool = false;
            if policy.http_allow.items[ri].methods.len == 0 {
                mok = true;
            } else {
                let mi: u64 = 0;
                while mi < policy.http_allow.items[ri].methods.len {
                    let ml2: u64 = policy.http_allow.items[ri].methods.items[mi].len;
                    let mp2: ptr = pol_item_ptr(&policy.http_allow.items[ri].methods.items[mi]);
                    if ml2 == mm.len && pol_ci_match(mp2, 0, mp, mm.len) { mok = true; };
                    mi = mi + 1;
                }
            };
            if mok {
                if policy.http_allow.items[ri].paths.len == 0 {
                    matched = true;
                } else {
                    let pi3: u64 = 0;
                    while pi3 < policy.http_allow.items[ri].paths.len {
                        if pol_glob_pp(pol_item_ptr(&pathname), pathname.len, pol_item_ptr(&policy.http_allow.items[ri].paths.items[pi3]), policy.http_allow.items[ri].paths.items[pi3].len) { matched = true; };
                        pi3 = pi3 + 1;
                    }
                };
            };
        };
        ri = ri + 1;
    }
    if !matched {
        pol_dec_put(out, STR_PTR("host, path, or method is not in the HTTP allowlist"), STR_LEN("host, path, or method is not in the HTTP allowlist"));
        return;
    };
    // allowed: path = parsed.toString() (approximation, see header)
    pol_dec_reset(out, true);
    pol_dec_path_append(out, STR_PTR("https://"), STR_LEN("https://"));
    let lh = StrItem { bytes: [0u8; 1024], len: 0 };
    pol_item_set(&lh, host_ptr2, host_e - host_s);
    pol_lower_in_place(&lh);
    pol_dec_path_append(out, pol_item_ptr(&lh), lh.len);
    if port_has && port != 443 {
        pol_dec_path_append(out, STR_PTR(":"), STR_LEN(":"));
        pol_dec_path_append_u64(out, port);
    };
    pol_dec_path_append(out, pol_item_ptr(&pathname), pathname.len);
    if q_has {
        pol_dec_path_append(out, STR_PTR("?"), STR_LEN("?"));
        let qp: ptr = PTR_NULL();
        PTR_BYTE_ADD(qp, url_ptr, q_s);
        pol_dec_path_append(out, qp, q_e - q_s);
    };
    if f_has {
        pol_dec_path_append(out, STR_PTR("#"), STR_LEN("#"));
        let fp: ptr = PTR_NULL();
        PTR_BYTE_ADD(fp, url_ptr, f_s);
        pol_dec_path_append(out, fp, url_len - f_s);
    };
    return;
}
fn checkSaVmEnv(policy: &NormalizedSaVmPolicy, name_ptr: ptr, name_len: u64, out: &SaVmPolicyDecision) -> void {
    pol_dec_reset(out, false);
    if pol_list_contains(&policy.env_allow, name_ptr, name_len) {
        pol_dec_reset(out, true);
        pol_dec_path_put(out, name_ptr, name_len);
        return;
    };
    pol_dec_put(out, STR_PTR("environment variable "), STR_LEN("environment variable "));
    pol_dec_put(out, name_ptr, name_len);
    pol_dec_put(out, STR_PTR(" is not allowed"), STR_LEN(" is not allowed"));
    return;
}
fn checkSaVmProcess(policy: &NormalizedSaVmPolicy, executable_ptr: ptr, executable_len: u64, args: &StrList, out: &SaVmPolicyDecision) -> void {
    pol_dec_reset(out, false);
    let ex = StrItem { bytes: [0u8; 1024], len: 0 };
    pol_item_trimmed(&ex, executable_ptr, executable_len);
    if ex.len == 0 {
        pol_dec_put(out, STR_PTR("process executable is required"), STR_LEN("process executable is required"));
        return;
    };
    let ep: ptr = pol_item_ptr(&ex);
    let any_exec: bool = false;
    let allowed: bool = false;
    let ri: u64 = 0;
    while ri < policy.process.exec.len {
        let rp: ptr = PTR_NULL();
        PTR_BYTE_ADD(rp, &policy.process.exec.items[ri].path, 0);
        if pol_exec_match(ep, ex.len, rp, policy.process.exec.items[ri].path_len) {
            any_exec = true;
            if !policy.process.exec.items[ri].has_args || argsMatch(&policy.process.exec.items[ri].args, args) {
                allowed = true;
            };
        };
        ri = ri + 1;
    }
    if allowed {
        pol_dec_reset(out, true);
        pol_dec_path_put(out, ep, ex.len);
        return;
    };
    if any_exec {
        pol_dec_put(out, STR_PTR("arguments for "), STR_LEN("arguments for "));
        pol_dec_put(out, ep, ex.len);
        pol_dec_put(out, STR_PTR(" are not allowed"), STR_LEN(" are not allowed"));
        return;
    };
    pol_dec_put(out, STR_PTR("executable "), STR_LEN("executable "));
    pol_dec_put(out, ep, ex.len);
    pol_dec_put(out, STR_PTR(" is not in the process allowlist"), STR_LEN(" is not in the process allowlist"));
    return;
}
fn checkSaVmBunProfile(policy: &NormalizedSaVmPolicy, profile_ptr: ptr, profile_len: u64, out: &SaVmPolicyDecision) -> void {
    pol_dec_reset(out, false);
    let norm = StrItem { bytes: [0u8; 1024], len: 0 };
    pol_item_trimmed(&norm, profile_ptr, profile_len);
    pol_lower_in_place(&norm);
    if norm.len == 0 {
        pol_dec_put(out, STR_PTR("Bun profile is required"), STR_LEN("Bun profile is required"));
        return;
    };
    let np: ptr = pol_item_ptr(&norm);
    if policy.process.has_bunProfiles && pol_list_contains(&policy.process.bunProfiles, np, norm.len) {
        pol_dec_reset(out, true);
        pol_dec_path_put(out, np, norm.len);
        return;
    };
    pol_dec_put(out, STR_PTR("Bun profile "), STR_LEN("Bun profile "));
    pol_dec_put(out, np, norm.len);
    pol_dec_put(out, STR_PTR(" is not enabled in the VM policy. Enable it in Settings -> VM Tools -> Fixed Project Check Profiles for this thread, then retry via sa_vm_run run_project_check"), STR_LEN(" is not enabled in the VM policy. Enable it in Settings -> VM Tools -> Fixed Project Check Profiles for this thread, then retry via sa_vm_run run_project_check"));
    return;
}
fn checkSaVmBunExecution(policy: &NormalizedSaVmPolicy, bunBinary_ptr: ptr, bunBinary_len: u64, subcommand_ptr: ptr, subcommand_len: u64, args: &StrList, out: &SaVmPolicyDecision) -> void {
    pol_dec_reset(out, false);
    if policy.process.has_bun {
        if !policy.process.bun_enabled {
            pol_dec_put(out, STR_PTR("Bun execution is disabled in the VM policy"), STR_LEN("Bun execution is disabled in the VM policy"));
            return;
        };
        if policy.process.bun_allowedSubcommands.len > 0 && !pol_list_contains(&policy.process.bun_allowedSubcommands, subcommand_ptr, subcommand_len) {
            pol_dec_put(out, STR_PTR("Bun subcommand '"), STR_LEN("Bun subcommand '"));
            pol_dec_put(out, subcommand_ptr, subcommand_len);
            pol_dec_put(out, STR_PTR("' is not in the allowed list: ["), STR_LEN("' is not in the allowed list: ["));
            let li: u64 = 0;
            while li < policy.process.bun_allowedSubcommands.len {
                if li > 0 { pol_dec_put(out, STR_PTR(", "), STR_LEN(", ")); };
                pol_dec_put(out, pol_item_ptr(&policy.process.bun_allowedSubcommands.items[li]), policy.process.bun_allowedSubcommands.items[li].len);
                li = li + 1;
            }
            pol_dec_put(out, STR_PTR("]"), STR_LEN("]"));
            return;
        };
        pol_dec_reset(out, true);
        pol_dec_path_put(out, bunBinary_ptr, bunBinary_len);
        return;
    };
    let argv = StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 };
    pol_list_push(&argv, subcommand_ptr, subcommand_len);
    let ai: u64 = 0;
    while ai < args.len {
        pol_list_push(&argv, pol_item_ptr(&args.items[ai]), args.items[ai].len);
        ai = ai + 1;
    }
    checkSaVmProcess(policy, bunBinary_ptr, bunBinary_len, &argv, out);
    return;
}
fn pol_stem_len(p: ptr, n: u64) -> u64 {
    // Length of the basename stem with a trailing ".exe" removed.
    if n >= 4 {
        let d: ptr = PTR_NULL();
        PTR_BYTE_ADD(d, p, n - 4);
        if pol_bytes_eq(d, 4, STR_PTR(".exe"), STR_LEN(".exe")) { return n - 4; };
    };
    return n;
}
fn pol_py_family(p: ptr, n: u64) -> bool {
    // ^(?:python(?:\d+(?:\.\d+)?)?|py|pypy(?:\d+)?)(?:\.exe)?$ on the
    // already-lowercased basename.
    let m: u64 = pol_stem_len(p, n);
    if pol_bytes_eq(p, m, STR_PTR("py"), STR_LEN("py")) { return true; };
    if m >= 4 && pol_starts_with(p, m, STR_PTR("pypy"), STR_LEN("pypy")) {
        let i: u64 = 4;
        let ok: bool = true;
        while i < m {
            if !pol_is_digit(pol_byte_at(p, i)) { ok = false; };
            i = i + 1;
        }
        if ok { return true; };
    };
    if m >= 6 && pol_starts_with(p, m, STR_PTR("python"), STR_LEN("python")) {
        if m == 6 { return true; };
        let q: ptr = PTR_NULL();
        PTR_BYTE_ADD(q, p, 6);
        let rest: u64 = m - 6;
        let i: u64 = 0;
        let d1: u64 = 0;
        while i < rest && pol_is_digit(pol_byte_at(q, i)) {
            i = i + 1;
            d1 = d1 + 1;
        }
        if d1 == 0 { return false; };
        if i == rest { return true; };
        if pol_byte_at(q, i) == 46 {
            i = i + 1;
            let d2: u64 = 0;
            while i < rest && pol_is_digit(pol_byte_at(q, i)) {
                i = i + 1;
                d2 = d2 + 1;
            }
            if d2 > 0 && i == rest { return true; };
        };
        return false;
    };
    return false;
}
fn pol_node_family(p: ptr, n: u64) -> bool {
    let m: u64 = pol_stem_len(p, n);
    if pol_bytes_eq(p, m, STR_PTR("node"), STR_LEN("node")) { return true; };
    if pol_bytes_eq(p, m, STR_PTR("nodejs"), STR_LEN("nodejs")) { return true; };
    if pol_bytes_eq(p, m, STR_PTR("deno"), STR_LEN("deno")) { return true; };
    if pol_bytes_eq(p, m, STR_PTR("ts-node"), STR_LEN("ts-node")) { return true; };
    if pol_bytes_eq(p, m, STR_PTR("tsx"), STR_LEN("tsx")) { return true; };
    if pol_bytes_eq(p, m, STR_PTR("npx"), STR_LEN("npx")) { return true; };
    return false;
}
fn pol_bun_family(p: ptr, n: u64) -> bool {
    let m: u64 = pol_stem_len(p, n);
    if pol_bytes_eq(p, m, STR_PTR("bun"), STR_LEN("bun")) { return true; };
    if pol_bytes_eq(p, m, STR_PTR("bunx"), STR_LEN("bunx")) { return true; };
    return false;
}
fn isSaVmScriptExecutionAllowed(policy: &NormalizedSaVmPolicy, executable_ptr: ptr, executable_len: u64) -> bool {
    // Source: basename of the slash-normalized lowercased executable;
    // (isPython && execution.python) || (isJavaScript &&
    // execution.javascript) || (isBun && bun?.enabled).
    let norm = StrItem { bytes: [0u8; 1024], len: 0 };
    pol_norm_slash_lower(&norm, executable_ptr, executable_len);
    let np: ptr = pol_item_ptr(&norm);
    let bs: u64 = pol_basename_start(np, norm.len);
    let bp: ptr = PTR_NULL();
    PTR_BYTE_ADD(bp, np, bs);
    let bl: u64 = norm.len - bs;
    let is_py: bool = pol_py_family(bp, bl);
    let is_js: bool = pol_node_family(bp, bl);
    let is_bun: bool = pol_bun_family(bp, bl);
    let bun_allowed: bool = policy.process.has_bun && policy.process.bun_enabled;
    return (is_py && policy.execution_python) || (is_js && policy.execution_javascript) || (is_bun && bun_allowed);
}

// ---------- classify (fix phase) ----------
struct ClassifyResult {
    kind: u32,
    isBun: bool,
    isJs: bool,
    isPy: bool,
}
struct ClassifyInput {
    action_doc: u64,      // each field is an `unknown` JSON node handle;
    language_doc: u64,    // string-ness/length probed via sa_json_string_*
    subcommand_doc: u64,
    args_doc: u64,
    test_file_doc: u64,
    filter_doc: u64,
    profile_doc: u64,
}
fn classifySaVmExecutionRequest(input: &ClassifyInput, out: &ClassifyResult) -> void {
    // Source precedence: python first (action in {run_py, run_python,
    // exec_py, py, python} or lang in {py, python}); then bun (action
    // run_bun | run_project_check, or action in {bun, exec_bun} WITH any
    // of subcommand(string)/args(array)/test_file/filter/profile
    // present); then javascript (action in {run_js, exec_js, js,
    // javascript, node, bun, run_node, exec_node, exec_bun, eval_js} or
    // lang in {js, javascript, node, bun, ts, typescript}); else other.
    // All comparisons are trim+lowercase string equalities.
    out.kind = 3;
    out.isBun = false;
    out.isJs = false;
    out.isPy = false;
    let act = StrItem { bytes: [0u8; 1024], len: 0 };
    let act_has: bool = false;
    pol_node_str(input.action_doc, &act, &act_has);
    let akey = StrItem { bytes: [0u8; 1024], len: 0 };
    if act_has {
        pol_item_trimmed(&akey, pol_item_ptr(&act), act.len);
        pol_lower_in_place(&akey);
    };
    let lang = StrItem { bytes: [0u8; 1024], len: 0 };
    let lang_has: bool = false;
    pol_node_str(input.language_doc, &lang, &lang_has);
    let lkey = StrItem { bytes: [0u8; 1024], len: 0 };
    if lang_has {
        pol_item_trimmed(&lkey, pol_item_ptr(&lang), lang.len);
        pol_lower_in_place(&lkey);
    };
    let ap: ptr = pol_item_ptr(&akey);
    let al: u64 = akey.len;
    let lp: ptr = pol_item_ptr(&lkey);
    let ll: u64 = lkey.len;
    let is_py: bool = pol_bytes_eq(ap, al, STR_PTR("run_py"), STR_LEN("run_py"))
        || pol_bytes_eq(ap, al, STR_PTR("run_python"), STR_LEN("run_python"))
        || pol_bytes_eq(ap, al, STR_PTR("exec_py"), STR_LEN("exec_py"))
        || pol_bytes_eq(ap, al, STR_PTR("py"), STR_LEN("py"))
        || pol_bytes_eq(ap, al, STR_PTR("python"), STR_LEN("python"))
        || pol_bytes_eq(lp, ll, STR_PTR("py"), STR_LEN("py"))
        || pol_bytes_eq(lp, ll, STR_PTR("python"), STR_LEN("python"));
    if is_py {
        out.kind = 2;
        out.isPy = true;
        return;
    };
    let is_bun: bool = pol_bytes_eq(ap, al, STR_PTR("run_bun"), STR_LEN("run_bun"))
        || pol_bytes_eq(ap, al, STR_PTR("run_project_check"), STR_LEN("run_project_check"));
    if !is_bun && (pol_bytes_eq(ap, al, STR_PTR("bun"), STR_LEN("bun")) || pol_bytes_eq(ap, al, STR_PTR("exec_bun"), STR_LEN("exec_bun"))) {
        if pol_json_kind(input.subcommand_doc) == 5
            || pol_json_kind(input.args_doc) == 6
            || pol_json_kind(input.test_file_doc) == 5
            || pol_json_kind(input.filter_doc) == 5
            || pol_json_kind(input.profile_doc) == 5 {
            is_bun = true;
        };
    };
    if is_bun {
        out.kind = 0;
        out.isBun = true;
        return;
    };
    let is_js: bool = pol_bytes_eq(ap, al, STR_PTR("run_js"), STR_LEN("run_js"))
        || pol_bytes_eq(ap, al, STR_PTR("exec_js"), STR_LEN("exec_js"))
        || pol_bytes_eq(ap, al, STR_PTR("js"), STR_LEN("js"))
        || pol_bytes_eq(ap, al, STR_PTR("javascript"), STR_LEN("javascript"))
        || pol_bytes_eq(ap, al, STR_PTR("node"), STR_LEN("node"))
        || pol_bytes_eq(ap, al, STR_PTR("bun"), STR_LEN("bun"))
        || pol_bytes_eq(ap, al, STR_PTR("run_node"), STR_LEN("run_node"))
        || pol_bytes_eq(ap, al, STR_PTR("exec_node"), STR_LEN("exec_node"))
        || pol_bytes_eq(ap, al, STR_PTR("exec_bun"), STR_LEN("exec_bun"))
        || pol_bytes_eq(ap, al, STR_PTR("eval_js"), STR_LEN("eval_js"))
        || pol_bytes_eq(lp, ll, STR_PTR("js"), STR_LEN("js"))
        || pol_bytes_eq(lp, ll, STR_PTR("javascript"), STR_LEN("javascript"))
        || pol_bytes_eq(lp, ll, STR_PTR("node"), STR_LEN("node"))
        || pol_bytes_eq(lp, ll, STR_PTR("bun"), STR_LEN("bun"))
        || pol_bytes_eq(lp, ll, STR_PTR("ts"), STR_LEN("ts"))
        || pol_bytes_eq(lp, ll, STR_PTR("typescript"), STR_LEN("typescript"));
    if is_js {
        out.kind = 1;
        out.isJs = true;
        return;
    };
    return;
}
fn classifyBunRequest(input: &ClassifyInput) -> bool {
    let r = ClassifyResult { kind: 3, isBun: false, isJs: false, isPy: false };
    classifySaVmExecutionRequest(input, &r);
    return r.isBun;
}

// ---------- extractCommandArgv (fix phase) ----------
struct ArgvResult {
    executable: [u8; 1024],
    executable_len: u64,
    args: StrList,
    has: bool,
}
fn pol_argv_fill(out: &ArgvResult, all: &StrList) -> void {
    let ep: ptr = pol_item_ptr(&all.items[0]);
    let el: u64 = all.items[0].len;
    let dst: ptr = PTR_NULL();
    PTR_BYTE_ADD(dst, &out.executable, 0);
    let i: u64 = 0;
    while i < el {
        let b: u8 = pol_byte_at(ep, i);
        let dp: ptr = PTR_NULL();
        PTR_BYTE_ADD(dp, dst, i);
        PTR_WRITE_U8(dp, b);
        i = i + 1;
    }
    out.executable_len = el;
    out.args.len = 0;
    let j: u64 = 1;
    while j < all.len {
        pol_list_push(&out.args, pol_item_ptr(&all.items[j]), all.items[j].len);
        j = j + 1;
    }
    out.has = true;
    return;
}
fn pol_tokenize(sp: ptr, ts: u64, te: u64, out: &StrList) -> void {
    // Hand scanner for the source tokenizer /(?:[^\s"']+|"[^"]*"|'[^']*')+/g
    // over the pre-trimmed range: a token is a run of unquoted bytes and
    // quoted sections (quotes retained in the raw token); whitespace
    // outside quotes separates; an unterminated quote is skipped by the
    // regex engine, which ends any token in progress and starts fresh
    // after it. After the match, a token whose first and last bytes are
    // the same quote char is unwrapped by one layer.
    let tok = StrItem { bytes: [0u8; 1024], len: 0 };
    let i: u64 = ts;
    while i < te {
        if pol_is_ws(pol_byte_at(sp, i)) {
            i = i + 1;
        } else {
            tok.len = 0;
            let had_content: bool = false;
            let in_tok: bool = true;
            while in_tok {
                if i >= te {
                    in_tok = false;
                } else {
                    let c: u8 = pol_byte_at(sp, i);
                    if pol_is_ws(c) {
                        in_tok = false;
                    } else if c == 34 || c == 39 {
                        let j: u64 = i + 1;
                        let close: u64 = 0;
                        let has_close: bool = false;
                        let seeking: bool = true;
                        while seeking {
                            if j >= te {
                                seeking = false;
                            } else {
                                if pol_byte_at(sp, j) == c {
                                    close = j;
                                    has_close = true;
                                    seeking = false;
                                } else {
                                    j = j + 1;
                                };
                            };
                        }
                        if has_close {
                            let k: u64 = i;
                            while k <= close {
                                pol_item_push_byte(&tok, pol_byte_at(sp, k));
                                k = k + 1;
                            }
                            had_content = true;
                            i = close + 1;
                        } else {
                            i = i + 1;
                            in_tok = false;
                        };
                    } else {
                        pol_item_push_byte(&tok, c);
                        had_content = true;
                        i = i + 1;
                    };
                };
            }
            if had_content {
                let tp: ptr = pol_item_ptr(&tok);
                let stripped: bool = false;
                if tok.len >= 2 {
                    let f: u8 = pol_byte_at(tp, 0);
                    let l: u8 = pol_byte_at(tp, tok.len - 1);
                    if f == l && (f == 34 || f == 39) {
                        let inner: ptr = PTR_NULL();
                        PTR_BYTE_ADD(inner, tp, 1);
                        pol_list_push(out, inner, tok.len - 2);
                        stripped = true;
                    };
                };
                if !stripped {
                    pol_list_push(out, tp, tok.len);
                };
            };
        };
    }
    return;
}
fn extractCommandArgv(value_doc: u64, value_is_array: bool, value_is_string: bool, out: &ArgvResult) -> void {
    out.has = false;
    out.executable_len = 0;
    out.args.len = 0;
    if value_is_array {
        let all = StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 };
        pol_json_str_list(value_doc, &all);
        if all.len == 0 { return; };
        pol_argv_fill(out, &all);
        return;
    };
    if !value_is_string { return; };
    if pol_json_kind(value_doc) != 5 { return; };
    let sp: ptr = sa_json_string_ptr(value_doc);
    let sl: u64 = sa_json_string_len(value_doc);
    let ts: u64 = 0;
    let te: u64 = 0;
    pol_trimmed_range(sp, sl, &ts, &te);
    if te <= ts { return; };
    let all = StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 };
    pol_tokenize(sp, ts, te, &all);
    if all.len == 0 { return; };
    pol_argv_fill(out, &all);
    return;
}
fn pathWithin(root_ptr: ptr, root_len: u64, candidate_ptr: ptr, candidate_len: u64) -> bool {
    // Source: rest = relative(resolve(root), resolve(candidate));
    // within iff rest === "" or (rest !== ".." && !rest.startsWith
    // (".." + sep) && !isAbsolute(rest)). Both paths are segment-
    // normalized here (absolute inputs in practice); the comparison is
    // the equivalent prefix test on the normalized forms.
    let r = StrItem { bytes: [0u8; 1024], len: 0 };
    let c = StrItem { bytes: [0u8; 1024], len: 0 };
    pol_resolve_normalized(&r, root_ptr, root_len, root_ptr, root_len, false);
    pol_resolve_normalized(&c, candidate_ptr, candidate_len, candidate_ptr, candidate_len, false);
    let rp: ptr = pol_item_ptr(&r);
    let cp: ptr = pol_item_ptr(&c);
    if pol_bytes_eq(cp, c.len, rp, r.len) { return true; };
    if r.len == 1 && pol_byte_at(rp, 0) == 47 {
        return c.len > 0 && pol_byte_at(cp, 0) == 47;
    };
    if c.len > r.len && pol_starts_with(cp, c.len, rp, r.len) && pol_byte_at(cp, r.len) == 47 { return true; };
    return false;
}
