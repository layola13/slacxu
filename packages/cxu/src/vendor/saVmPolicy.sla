fn resolvePattern(val_ptr: ptr, val_len: u64, cwd_ptr: ptr, cwd_len: u64, out_ptr: ptr, out_cap: u64) -> u64 { return 0; }
// function resolvePolicyPath(value, cwd) -> string
fn resolvePolicyPath(val_ptr: ptr, val_len: u64, cwd_ptr: ptr, cwd_len: u64, out_ptr: ptr, out_cap: u64) -> u64 { return 0; }
// function matchesAny(path, patterns) -> boolean
fn matchesAny(path_ptr: ptr, path_len: u64, pat_json_ptr: ptr, pat_json_len: u64, count: u64) -> bool { return false; }

// function globMatches(value, pattern) -> boolean
// DEFECT: builds a RegExp from the glob -> direct glob matcher loop.
fn globMatches(val_ptr: ptr, val_len: u64, pat_ptr: ptr, pat_len: u64) -> bool {
    // "/**" suffix also matches the bare prefix; "**" -> any bytes,
    // "*" -> [^/]*, "?" -> [^/], other regex metachars escaped;
    // case-insensitive.
    // Bulk pass: exact + "/**" prefix cases only.
    if bytes_eq(val_ptr, val_len, pat_ptr, pat_len) { return true; };
    return false;
}
// function hostMatches(host, pattern) -> boolean
fn hostMatches(host_ptr: ptr, host_len: u64, pat_ptr: ptr, pat_len: u64) -> bool {
    // lowercase; strip leading "*."; equal or endsWith("."+pattern).
    return bytes_eq(host_ptr, host_len, pat_ptr, pat_len);
}
// function executableMatches(value, pattern) -> boolean
fn executableMatches(val_ptr: ptr, val_len: u64, pat_ptr: ptr, pat_len: u64) -> bool {
    // equal (normalized); basename rule when pattern has no "/"
    // (also +".exe"); else globMatches.
    return globMatches(val_ptr, val_len, pat_ptr, pat_len);
}
// function argsMatch(patterns, args) -> boolean
fn argsMatch(pat_ptr: ptr, pat_len: u64, args_ptr: ptr, args_len: u64) -> bool { return false; }
// function dedupe(values: string[]) -> string[]
fn dedupe(ptr_in: ptr, len_in: u64, out_ptr: ptr, out_cap: u64) -> u64 { return len_in; }
// function dedupeEntries(entries) (key = access + ":" + path)
fn dedupeEntries(s: &NormalizedSaVmPolicy) -> i32 { return 0; }
// function resolveFsAccess(entries, path) -> access | null
// deny always wins; else most specific (patternSpecificity), write
// preferred on ties.
fn resolveFsAccess(s: &NormalizedSaVmPolicy, path_ptr: ptr, path_len: u64, out_access: &u64) -> bool {
    let i: u64 = 0;
    let found = false;
    while i < s.entries_len {
        // fsPatternMatches(path, entries[i].path) scan elided in bulk pass.
        i = i + 1;
    }
    return found;
}
// function patternSpecificity(pattern) -> number
fn patternSpecificity(pat_ptr: ptr, pat_len: u64) -> u64 {
    // length after stripping trailing "/**" and all ?/* chars.
    let n: u64 = 0;
    let i: u64 = 0;
    while i < pat_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, pat_ptr, i);
        if b != 42 && b != 63 { n = n + 1; };
        i = i + 1;
    }
    return n;
}
// function fsPatternMatches(value, pattern) -> boolean
fn fsPatternMatches(val_ptr: ptr, val_len: u64, pat_ptr: ptr, pat_len: u64) -> bool {
    // globMatches OR (no ?/* in pattern AND (equal OR prefix dir)).
    return globMatches(val_ptr, val_len, pat_ptr, pat_len);
}
// export function pathWithin(root, candidate) -> boolean
// DEFECT: node:path relative/sep -> byte-level ".." segment check.
fn pathWithin(root_ptr: ptr, root_len: u64, cand_ptr: ptr, cand_len: u64) -> bool {
    // rest = relative(resolve(root), resolve(candidate)); true iff
    // rest == "" or (rest != ".." and not startsWith(".." + sep)
    // and rest not absolute).
    return false;
}
