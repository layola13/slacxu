// Converted 1:1 from packages/cxu/src/vendor/saVmPolicy.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.

// Policy normalization and path/http/env/process checks for SA-VM.
// DEFECT: node:path / node:fs / node:os have no direct sa_std SLA
// surface here; resolve/join/relative/statSync/tmpdir are extern
// approximations (sa_std_fs_* / sa_std_path_*) and process.env reads
// become explicit (ptr,len) parameters.
@import "sa_std/io/print.sai"
@import "sa_std/ptr.sa"
@import "../shared-types.sla"
@import "./sdk-backend.sla"

// export type SaVmPathOperation = "read" | "write" | "transfer"
const PATH_OP_READ: u64 = 0;
const PATH_OP_WRITE: u64 = 1;
const PATH_OP_TRANSFER: u64 = 2;

// export const ENHANCED_TOOLS_READ_ONLY = new Set([...]) (17 names)
// DEFECT: Set<string> -> fixed name table + linear scan.
fn enhanced_tools_read_only_contains(name_ptr: ptr, name_len: u64) -> bool {
    // names: read_file read_lines read_many read_files read_file_tail
    // count_lines file_info test_path file_exists exists stat
    // find_files list_dir grep_search grep_search_async code_graph
    // relation_graph symbol_graph
    if bytes_eq(name_ptr, name_len, STR_PTR("read_file"), STR_LEN("read_file")) { return true; };
    if bytes_eq(name_ptr, name_len, STR_PTR("read_lines"), STR_LEN("read_lines")) { return true; };
    if bytes_eq(name_ptr, name_len, STR_PTR("read_many"), STR_LEN("read_many")) { return true; };
    if bytes_eq(name_ptr, name_len, STR_PTR("read_files"), STR_LEN("read_files")) { return true; };
    if bytes_eq(name_ptr, name_len, STR_PTR("read_file_tail"), STR_LEN("read_file_tail")) { return true; };
    if bytes_eq(name_ptr, name_len, STR_PTR("count_lines"), STR_LEN("count_lines")) { return true; };
    if bytes_eq(name_ptr, name_len, STR_PTR("file_info"), STR_LEN("file_info")) { return true; };
    if bytes_eq(name_ptr, name_len, STR_PTR("test_path"), STR_LEN("test_path")) { return true; };
    if bytes_eq(name_ptr, name_len, STR_PTR("file_exists"), STR_LEN("file_exists")) { return true; };
    if bytes_eq(name_ptr, name_len, STR_PTR("exists"), STR_LEN("exists")) { return true; };
    if bytes_eq(name_ptr, name_len, STR_PTR("stat"), STR_LEN("stat")) { return true; };
    if bytes_eq(name_ptr, name_len, STR_PTR("find_files"), STR_LEN("find_files")) { return true; };
    if bytes_eq(name_ptr, name_len, STR_PTR("list_dir"), STR_LEN("list_dir")) { return true; };
    if bytes_eq(name_ptr, name_len, STR_PTR("grep_search"), STR_LEN("grep_search")) { return true; };
    if bytes_eq(name_ptr, name_len, STR_PTR("grep_search_async"), STR_LEN("grep_search_async")) { return true; };
    if bytes_eq(name_ptr, name_len, STR_PTR("code_graph"), STR_LEN("code_graph")) { return true; };
    if bytes_eq(name_ptr, name_len, STR_PTR("relation_graph"), STR_LEN("relation_graph")) { return true; };
    if bytes_eq(name_ptr, name_len, STR_PTR("symbol_graph"), STR_LEN("symbol_graph")) { return true; };
    return false;
}
fn bytes_eq(a_ptr: ptr, a_len: u64, b_ptr: ptr, b_len: u64) -> bool {
    if a_len != b_len { return false; };
    let i: u64 = 0;
    while i < a_len {
        let x: u8 = 0;
        let y: u8 = 0;
        PTR_BYTE_AT(x, a_ptr, i);
        PTR_BYTE_AT(y, b_ptr, i);
        if x != y { return false; };
        i = i + 1;
    }
    return true;
}

// export type SaVmPolicyDecision = { allowed: true; path: string }
//   | { allowed: false; reason: string; path?: string }
// DEFECT: discriminated union -> struct with allowed flag.
struct SaVmPolicyDecision {
    allowed: bool,
    has_path: bool, path_bytes: [u8; 4096], path_len: u64,
    has_reason: bool, reason_bytes: [u8; 1024], reason_len: u64,
}

// Fs entry { path: string; access: "read"|"write"|"deny" }
struct SaVmFsPolicyEntry {
    path_bytes: [u8; 4096], path_len: u64,
    access: u64,
}
const FS_ACCESS_READ: u64 = 0;
const FS_ACCESS_WRITE: u64 = 1;
const FS_ACCESS_DENY: u64 = 2;

// export type NormalizedSaVmPolicy = { engine, fs{entries,read,write,
//   transfer,delete,backupDir}, http{allow}, env{allow},
//   process{spawn,exec,bunProfiles?,bun?}, execution{javascript,python},
//   tools{...}, contextSavings? }
// DEFECT: nested dynamic arrays -> fixed arrays + counts (capacity
// MAX_POLICY_PATHS=128 for paths, 64 for env/exec sub-lists).
struct NormalizedSaVmPolicy {
    engine: u64,
    entries: [SaVmFsPolicyEntry; 128], entries_len: u64,
    read_json: [u8; 16384], read_json_len: u64, read_count: u64,
    write_json: [u8; 16384], write_json_len: u64, write_count: u64,
    transfer_json: [u8; 16384], transfer_json_len: u64, transfer_count: u64,
    delete_policy: u64, has_backup_dir: bool,
    backup_dir_bytes: [u8; 4096], backup_dir_len: u64,
    http_allow_json: [u8; 8192], http_allow_json_len: u64, http_allow_count: u64,
    env_allow_json: [u8; 4096], env_allow_json_len: u64, env_allow_count: u64,
    process_spawn: bool,
    exec_json: [u8; 16384], exec_json_len: u64, exec_count: u64,
    has_bun_profiles: bool, bun_profiles_json: [u8; 4096], bun_profiles_json_len: u64, bun_profiles_count: u64,
    has_bun: bool, bun_enabled: bool,
    bun_allowed_json: [u8; 4096], bun_allowed_json_len: u64, bun_allowed_count: u64,
    execution_javascript: bool, execution_python: bool,
    tool_replace_read: bool, tool_replace_write: bool,
    tool_replace_apply_patch: bool, tool_replace_exec: bool,
    tool_read_files: bool, tool_edit_files: bool, tool_apply_patch: bool,
    tool_fast_search: bool, tool_clear_tool_history: bool,
    tool_find_references: bool, tool_rename_symbol: bool,
    tool_file_outline: bool, tool_move_with_imports: bool,
    tool_find_definition: bool, tool_extract_to_file: bool,
    tool_add_import: bool, tool_get_diagnostics: bool,
    tool_organize_imports: bool, tool_analyze_scope: bool,
    tool_code_graph: bool,
    has_context_savings: bool,
    cs_json: [u8; 4096], cs_json_len: u64,
}
const ENGINE_NATIVE: u64 = 0;
const ENGINE_VM: u64 = 1;
const DELETE_DENY: u64 = 0;
const DELETE_RENAME: u64 = 1;
const DELETE_MOVE: u64 = 2;

// const DEFAULT_ENV = ["CWD", "PROJECT"]
