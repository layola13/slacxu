// Converted 1:1 from packages/cxu/src/vendor/saVmResultKind.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.

// TS type SaVmRunResult (object shape) -> struct.
// DEFECT: TS string-union kind and Record<string, unknown> fields have
// no SLA equivalent; kind is a u64 enum tag (constants below) and the
// Record fields are JSON text buffers.
struct SaVmRunResult {
    ok: bool,
    kind: u64,
    has_exit_code: bool,
    exit_code: i32,
    stdout_bytes: [u8; 8192],
    stdout_len: u64,
    stderr_bytes: [u8; 8192],
    stderr_len: u64,
    // DEFECT: Array<Record<string, unknown>> -> JSON array text buffer.
    sa_vm_events_json: [u8; 8192],
    sa_vm_events_json_len: u64,
    // DEFECT: Record<string, unknown> | null -> JSON text buffer + flag.
    has_sa_vm_violation: bool,
    sa_vm_violation_json: [u8; 4096],
    sa_vm_violation_json_len: u64,
    duration_ms: u64,
}

// TS type SaVmRunResultKind (string union) -> u64 tag constants.
const KIND_SUCCESS: u64 = 0;
const KIND_SA_ERROR: u64 = 1;
const KIND_CAPABILITY_DENIED: u64 = 2;
const KIND_FUEL_EXHAUSTED: u64 = 3;
const KIND_TIMEOUT: u64 = 4;
const KIND_MEM_QUOTA: u64 = 5;
const KIND_POLICY_INVALID: u64 = 6;
const KIND_STACK_OVERFLOW: u64 = 7;
const KIND_CRASHED: u64 = 8;
const KIND_UNAVAILABLE: u64 = 9;

// resultKind(exitCode: number | null, stderr = "") -> SaVmRunResultKind
// has_exit_code=false represents TS null.
fn resultKind(has_exit_code: bool, exit_code: i32, stderr_ptr: ptr, stderr_len: u64) -> u64 {
    if has_exit_code && exit_code == 228 { return KIND_CAPABILITY_DENIED; };
    if has_exit_code && exit_code == 229 { return KIND_FUEL_EXHAUSTED; };
    if has_exit_code && exit_code == 230 { return KIND_TIMEOUT; };
    if has_exit_code && exit_code == 231 { return KIND_MEM_QUOTA; };
    if has_exit_code && exit_code == 233 { return KIND_POLICY_INVALID; };
    if has_exit_code && exit_code == 235 { return KIND_STACK_OVERFLOW; };
    if has_exit_code && exit_code == 1 && str_trim_len(stderr_ptr, stderr_len) > 0 { return KIND_SA_ERROR; };
    if has_exit_code && exit_code < 128 { return KIND_SUCCESS; };
    return KIND_CRASHED;
}

// TS stderr.trim() length: count of non-whitespace bytes (approximation
// of JS trim for the emptiness check in resultKind).
fn str_trim_len(p: ptr, len: u64) -> u64 {
    let n: u64 = 0;
    let i: u64 = 0;
    while i < len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, p, i);
        if b != 32 && b != 9 && b != 10 && b != 13 { n = n + 1; };
        i = i + 1;
    }
    return n;
}
