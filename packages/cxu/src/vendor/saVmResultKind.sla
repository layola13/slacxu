@import "sa_std/io/print.sai"
// pkg-cxu fix phase (2026-10-26, FIX_PKG_CXU): this file's SaVmRunResult
// renamed RkSaVmRunResult. The TS declares a module-local SaVmRunResult
// type here (saVmResultKind.ts L1-12) distinct from saVmTypes'
// SaVmRunResult; SLA's name-based checker forbids both in the
// index.sla barrel closure. The saVmTypes shape stays canonical
// (saVmTool consumes it); this kind-classifier shape is local.

// ---- saVmResultKind.ts:1-12 — RkSaVmRunResult ----
// kind union approximated as u8 tag: 0=success 1=sa_error 2=capability_denied 3=fuel_exhausted
// 4=timeout 5=mem_quota 6=policy_invalid 7=stack_overflow 8=crashed 9=unavailable.
struct RkSaVmRunResult {
    ok: bool,
    kind: u8,
    exitCode: i32, has_exitCode: bool, // number | null
    stdout_ptr: ptr, stdout_len: u64, // string
    stderr_ptr: ptr, stderr_len: u64, // string
    saVmEvents: u64, // Array<Record<string, unknown>> — DEFECT: dynamic object array -> JSON handle
    saVmViolation: u64, has_saVmViolation: bool, // Record | null — DEFECT: dynamic object
    durationMs: u64,
}

// ---- saVmResultKind.ts:14-24 — SaVmRunResultKind (same tag encoding as above) ----

fn rk_resultKind(exitCode: i32, has_exitCode: bool, stderr_ptr: ptr, stderr_len: u64) -> u8 {
    if has_exitCode && exitCode == 228 { return 2; };
    if has_exitCode && exitCode == 229 { return 3; };
    if has_exitCode && exitCode == 230 { return 4; };
    if has_exitCode && exitCode == 231 { return 5; };
    if has_exitCode && exitCode == 233 { return 6; };
    if has_exitCode && exitCode == 235 { return 7; };
    // if (exitCode === 1 && stderr.trim()) return "sa_error" — DEFECT: trim needs byte scan
    if has_exitCode && exitCode == 1 && stderr_len > 0 { return 1; };
    if has_exitCode && exitCode < 128 { return 0; };
    return 8;
}
