// Converted 1:1 from packages/cxu/src/vendor/saVmFindWorker.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
// Bun.Worker prefilter for find_definition workspace scans.
// Runs disk I/O + substring prefilter off the main event loop; the main
// thread keeps precise tree-sitter parsing (findDefinitionInContent) on
// the few candidates only. Message protocol:
//   inbound: { files: string[]; symbol: string }
//   outbound: { ok: true; matches: string[] } | { ok: false; error: string }
@import "sa_std/ptr.sa"

// DEFECT: Bun Worker (self.onmessage / postMessage) has no counterpart
// in sa_std yet — the whole worker is converted as a synchronous
// handler function over JSON text buffers (dynamic message objects),
// and the async Bun.file(f).text() read becomes a blocking fs read.
struct FindWorkerReply {
    ok: bool,
    // DEFECT: matches: string[] -> JSON array text buffer.
    matches_json: [u8; 16384],
    matches_json_len: u64,
    err_bytes: [u8; 1024],
    err_len: u64,
}

// self.onmessage = async (event) => { ... }
// Converted: findWorkerOnMessage(msg_json, reply) — status 0 handled.
// TS logic: data.files (array else []), data.symbol (string else "");
// empty symbol or no files -> { ok: true, matches: [] }; else for each
// file, read text, includes(symbol) -> matches.push; per-file errors
// skipped; outer catch -> { ok: false, error }.
// DEFECT: async handler -> synchronous; dynamic JSON message -> the
// two fields are extracted by the caller-side JSON parse (fields below
// are the already-extracted spans).
fn findWorkerOnMessage(files_json_ptr: ptr, files_json_len: u64, symbol_ptr: ptr, symbol_len: u64, reply: &FindWorkerReply) -> i32 {
    reply.ok = true;
    reply.matches_json_len = 0;
    reply.err_len = 0;
    reply_append(reply, STR_PTR("["), STR_LEN("["));
    if symbol_len == 0 || files_json_len == 0 {
        reply_append(reply, STR_PTR("]"), STR_LEN("]"));
        return 0;
    };
    // DEFECT: Array.isArray / element iteration over the dynamic JSON
    // array is approximated with sa_json_array_get on the parsed doc;
    // the parse + per-element string extraction happen here inline.
    let doc = sa_json_parse(files_json_ptr, files_json_len);
    if doc == 0 {
        reply_append(reply, STR_PTR("]"), STR_LEN("]"));
        return 0;
    };
    let first = true;
    let idx: u64 = 0;
    while 1 == 1 {
        let el: u64 = 0;
        if sa_json_array_get(doc, idx, &el) != 0 { break; };
        let f_ptr: ptr = sa_json_string_ptr(el);
        let f_len: u64 = sa_json_string_len(el);
        // const text = await Bun.file(f).text();  (blocking fs read)
        // if (text.includes(symbol)) matches.push(f);
        // catch { skip unreadable files }
        if fileContains(f_ptr, f_len, symbol_ptr, symbol_len) {
            if !first { reply_append(reply, STR_PTR(","), STR_LEN(",")); };
            first = false;
            reply_append(reply, STR_PTR("\""), STR_LEN("\""));
            reply_append(reply, f_ptr, f_len);
            reply_append(reply, STR_PTR("\""), STR_LEN("\""));
        };
        idx = idx + 1;
    }
    reply_append(reply, STR_PTR("]"), STR_LEN("]"));
    return 0;
}

fn reply_append(r: &FindWorkerReply, src_ptr: ptr, src_len: u64) -> void {
    for i in 0..src_len {
        if r.matches_json_len < 16384 {
            let c: u8 = 0;
            PTR_BYTE_AT(c, src_ptr, i);
            r.matches_json[r.matches_json_len] = c;
            r.matches_json_len = r.matches_json_len + 1;
        };
    }
}

// Blocking whole-file read + substring test (Bun.file().text() +
// String.includes). Returns false on any read error (TS catch-skip).
fn fileContains(path_ptr: ptr, path_len: u64, needle_ptr: ptr, needle_len: u64) -> bool {
    let total: u64 = 0;
    if sa_std_fs_len(path_ptr, path_len, &total) != 0 { return false; };
    if total > 1048576 { return false; };
    let fh: u64 = 0;
    if sa_std_fs_open_read(path_ptr, path_len, &fh) != 0 { return false; };
    let buf = [0u8; 1048576];
    let read_n: u64 = 0;
    let rst = sa_std_fs_file_read(fh, &buf, total, &read_n);
    sa_fs_file_close(fh);
    if rst != 0 { return false; };
    if needle_len == 0 { return true; };
    if read_n < needle_len { return false; };
    let last = read_n - needle_len;
    let i: u64 = 0;
    while i <= last {
        let ok = true;
        let j: u64 = 0;
        while j < needle_len {
            let nb: u8 = 0;
            PTR_BYTE_AT(nb, needle_ptr, j);
            if buf[i + j] != nb { ok = false; break; };
            j = j + 1;
        }
        if ok { return true; };
        i = i + 1;
    }
    return false;
}

// TS: export {}; (module marker only — no SLA counterpart needed.)
