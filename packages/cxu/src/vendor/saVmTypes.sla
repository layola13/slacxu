// Converted 1:1 from packages/cxu/src/vendor/saVmTypes.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.

// SA-VM tool protocol contract types (R2: owned by the SDK).
// Wire contract between the host SA-VM tool dispatcher and plugin-side
// engines (JEV) and bridges (Mini). TS class identity for
// SaVmInputError / SaVmCapabilityDeniedError lives here so instanceof
// checks agree across host and plugins; in SLA this is struct + tag.
// DEFECT: TS string unions, optional fields, index signatures and
// generics have no SLA equivalent; unions become u64 tag constants,
// optional string fields become (bytes,len,has) triples, and dynamic
// objects become JSON text buffers.

// import type { SaVmPolicyConfig } from "../shared-types.js"
// DEFECT: type-only import -> declaration dependency only.
@import "../shared-types.sla"
@import "sa_std/ptr.sa"

// export type SaVmFsCapability = { op: "read"|...; path: string }
struct SaVmFsCapability {
    op: u64,
    path_bytes: [u8; 4096], path_len: u64,
}
const FS_OP_READ: u64 = 0;
const FS_OP_WRITE: u64 = 1;
const FS_OP_APPEND: u64 = 2;
const FS_OP_EDIT: u64 = 3;
const FS_OP_CREATE: u64 = 4;
const FS_OP_DELETE: u64 = 5;
const FS_OP_RENAME: u64 = 6;
const FS_OP_METADATA: u64 = 7;

// export type SaVmNetCapability = { url: string; methods?: string[] }
struct SaVmNetCapability {
    url_bytes: [u8; 2048], url_len: u64,
    // DEFECT: string[] -> fixed array + len (capacity 16 estimated).
    methods_bytes: [u8; 512], methods_len: u64, methods_count: u64,
    has_methods: bool,
}

