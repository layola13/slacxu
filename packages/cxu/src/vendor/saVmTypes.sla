// export type SaVmRunInput = { ... } (lines 202-422 of source)
// DEFECT: dynamic object with ~200 optional fields, string[] arrays,
// Record<string,string> maps, nested requested_caps/limits objects,
// Omit<> and recursive parallel field -> single JSON text buffer for
// the full payload plus extracted scalar fast-path fields below.
// Field-name inventory is preserved in the comment block at file end.
struct SaVmRunInput {
    json_bytes: [u8; 65536], json_len: u64,
    has_action: bool, action_bytes: [u8; 128], action_len: u64,
    has_path: bool, path_bytes: [u8; 4096], path_len: u64,
    has_content: bool, content_bytes: [u8; 32768], content_len: u64,
    has_query: bool, query_bytes: [u8; 4096], query_len: u64,
    has_pattern: bool, pattern_bytes: [u8; 1024], pattern_len: u64,
    has_old_text: bool, has_new_text: bool,
    has_symbol: bool, symbol_bytes: [u8; 512], symbol_len: u64,
    has_url: bool, url_bytes: [u8; 2048], url_len: u64,
    has_method: bool, method_bytes: [u8; 32], method_len: u64,
    has_cwd: bool, cwd_bytes: [u8; 4096], cwd_len: u64,
    has_session_id: bool, session_id_bytes: [u8; 256], session_id_len: u64,
    has_input: bool, input_bytes: [u8; 8192], input_len: u64,
    limit: i64, max_results: i64, max_files: i64, max_errors: i64,
    start_line: i64, end_line: i64, offset: i64,
    max_tokens: i64, max_lines: i64, timeout_ms: i64, timeout: i64,
    top_n: i64, context: i64, diff_context: i64, max_count: i64,
    page: i64, page_size: i64, concurrency: i64, yield_time_ms: i64,
    threshold: f64,
    all_flag: bool, confirm: bool, sort: bool, remove_unused: bool,
    merge_duplicates: bool, include_body: bool, is_type: bool,
    dry_run: bool, replace_all: bool, raw: bool, keep_source: bool,
    check_references: bool, force: bool, manual_override: bool,
    detail: bool, numbered: bool, recursive: bool, is_regex: bool,
    regex: bool, case_sensitive: bool, exclude_comments: bool,
    include_declarations: bool, tail: bool, short: bool, staged: bool,
    stat_only: bool, oneline: bool, exact_total: bool,
    close_stdin: bool, drain: bool,
    // DEFECT: nested objects requested_caps / limits / policy and the
    // recursive parallel array stay inside json_bytes only.
    has_policy: bool,
    has_parallel: bool, parallel_json_len: u64,
}

// export type SaVmRunResult = { ok, kind, exitCode, stdout, stderr,
//   saVmEvents, saVmViolation, durationMs, ... [key: string]: unknown }
// DEFECT: index signature [key: string]: unknown -> extra_json buffer;
// kind string union -> u64 tag (see saVmResultKind.sla for tag values,
// extended here with "running").
struct SaVmRunResult {
    ok: bool,
    kind: u64,
    has_exit_code: bool, exit_code: i32,
    stdout_bytes: [u8; 32768], stdout_len: u64,
    stderr_bytes: [u8; 8192], stderr_len: u64,
    // DEFECT: Array<Record<string, unknown>> -> JSON array text buffer.
    sa_vm_events_json: [u8; 8192], sa_vm_events_json_len: u64,
    // DEFECT: Record<string, unknown> | null -> JSON buffer + flag.
    has_sa_vm_violation: bool,
    sa_vm_violation_json: [u8; 4096], sa_vm_violation_json_len: u64,
    duration_ms: u64,
    has_session_id: bool, session_id_bytes: [u8; 256], session_id_len: u64,
    has_pid: bool, pid: i64,
    has_status: bool, status_bytes: [u8; 256], status_len: u64,
    has_message: bool, message_bytes: [u8; 2048], message_len: u64,
    has_commit: bool, commit_bytes: [u8; 256], commit_len: u64,
    has_created: bool, created: bool,
    extra_json: [u8; 8192], extra_json_len: u64,
}
const RESULT_KIND_RUNNING: u64 = 10;

// export class SaVmInputError extends Error {}
// DEFECT: class inheritance / instanceof -> struct + kind tag.
struct SaVmInputError {
    message_bytes: [u8; 2048], message_len: u64,
}
const ERR_KIND_INPUT: u64 = 1;
fn sa_vm_input_error_new(msg_ptr: ptr, msg_len: u64, out: &SaVmInputError) -> i32 {
    out.message_len = msg_len;
    return 0;
}

// export class SaVmCapabilityDeniedError extends Error {
//   readonly exitCode = 228; }
struct SaVmCapabilityDeniedError {
    message_bytes: [u8; 2048], message_len: u64,
    exit_code: i32,
}
fn sa_vm_capability_denied_error_new(msg_ptr: ptr, msg_len: u64, out: &SaVmCapabilityDeniedError) -> i32 {
    out.message_len = msg_len;
    out.exit_code = 228;
    return 0;
}
fn sa_vm_capability_denied_exit_code(e: &SaVmCapabilityDeniedError) -> i32 {
    return 228;
}

