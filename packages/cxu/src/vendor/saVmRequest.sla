// Converted 1:1 from packages/cxu/src/vendor/saVmRequest.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "sa_std/ptr.sa"

// TS types (string-union coded results) -> structs with u64 code tags.
// DEFECT: dynamic Record<string, unknown> bodies are handled as parsed
// sa_json doc handles; `unknown` values are doc node handles (0 = the
// JSON null / absent distinction is carried by explicit flags).

// SaVmRequestValidation =
//   | { ok: true; isParallel: boolean }
//   | { ok: false; error: string; code: "CUX-SA-VM-SLA-REQUIRED" |
//       "CUX-SA-VM-INVALID-INPUT" | "CUX-SA-VM-INVALID-PARALLEL" }
struct SaVmRequestValidation {
    ok: bool,
    is_parallel: bool,
    err_bytes: [u8; 1024],
    err_len: u64,
    code: u64,
}

const CODE_SLA_REQUIRED: u64 = 0;
const CODE_INVALID_INPUT: u64 = 1;
const CODE_INVALID_PARALLEL: u64 = 2;

// SaVmParallelNormalization =
//   | { ok: true; tasks: Array<Record<string, unknown>> | undefined }
//   | { ok: false; error: string }
// tasks are kept as a JSON array text span (tasks_json) with
// has_tasks=false for the TS `undefined` case.
struct SaVmParallelNormalization {
    ok: bool,
    has_tasks: bool,
    tasks_json: [u8; 262144],
    tasks_json_len: u64,
    err_bytes: [u8; 1024],
    err_len: u64,
}

const MAX_PARALLEL_STRING_BYTES: u64 = 262144;

fn val_fail(out: &SaVmRequestValidation, code: u64, msg_ptr: ptr, msg_len: u64) -> void {
    out.ok = false;
    out.code = code;
    out.err_len = 0;
    for i in 0..msg_len {
        if out.err_len < 1024 {
            let c: u8 = 0;
            PTR_BYTE_AT(c, msg_ptr, i);
            out.err_bytes[out.err_len] = c;
            out.err_len = out.err_len + 1;
        };
    }
}

fn norm_fail(out: &SaVmParallelNormalization, msg_ptr: ptr, msg_len: u64) -> void {
    out.ok = false;
    out.has_tasks = false;
    out.err_len = 0;
    for i in 0..msg_len {
        if out.err_len < 1024 {
            let c: u8 = 0;
            PTR_BYTE_AT(c, msg_ptr, i);
            out.err_bytes[out.err_len] = c;
            out.err_len = out.err_len + 1;
        };
    }
}

// Models routinely send `parallel` as a JSON-encoded string instead of
// a real array. Without this coercion the batch silently falls through
// to the script engine and fails with the unrelated "source must be a
// string", which gives the caller no way to self-correct. Accept the
// string form (array or single task object) and reject anything that
// cannot be decoded into task objects.
//
// normalizeSaVmParallelTasks(value: unknown) -> SaVmParallelNormalization
// The unknown value arrives as (kind, node, str span):
//   kind 0 = undefined, 1 = null, 2 = string (str_ptr/str_len),
//   3 = other JSON node (node = sa_json handle).
fn normalizeSaVmParallelTasks(kind: u64, node: u64, str_ptr: ptr, str_len: u64, out: &SaVmParallelNormalization) -> void {
    out.ok = true;
    out.has_tasks = false;
    out.tasks_json_len = 0;
    out.err_len = 0;
    // if (value === undefined || value === null) return { ok: true, tasks: undefined };
    if kind == 0 || kind == 1 { return; };

    let cand_node: u64 = 0;
    let cand_is_array = false;
    if kind == 2 {
        // typeof value === "string": trimmed = value.trim()
        let lo: u64 = 0;
        let hi = str_len;
        while lo < hi {
            let c: u8 = 0;
            PTR_BYTE_AT(c, str_ptr, lo);
            if c != 32 && c != 9 && c != 10 && c != 13 { break; };
            lo = lo + 1;
        }
        while hi > lo {
            let c: u8 = 0;
            PTR_BYTE_AT(c, str_ptr, hi - 1);
            if c != 32 && c != 9 && c != 10 && c != 13 { break; };
            hi = hi - 1;
        }
        let tlen = hi - lo;
        if tlen == 0 {
            norm_fail(out, STR_PTR("parallel must not be an empty string; pass a JSON array of task objects"), STR_LEN("parallel must not be an empty string; pass a JSON array of task objects"));
            return;
        };
        // Buffer.byteLength(trimmed, "utf8") > MAX -> error.
        // DEFECT: byteLength of a JS string is its UTF-8 length; the
        // span here is already bytes, so the comparison is direct.
        if tlen > MAX_PARALLEL_STRING_BYTES {
            // TS: `parallel string exceeds ${MAX_PARALLEL_STRING_BYTES} bytes`
            norm_fail(out, STR_PTR("parallel string exceeds 262144 bytes"), STR_LEN("parallel string exceeds 262144 bytes"));
            return;
        };
        // candidate = JSON.parse(trimmed) (try/catch)
        let t_ptr: ptr = PTR_NULL();
        PTR_BYTE_ADD(t_ptr, str_ptr, lo);
        let doc = sa_json_parse(t_ptr, tlen);
        if doc == 0 {
            norm_fail(out, STR_PTR("parallel must be a JSON array of task objects (e.g. [{ \"action\": \"list_dir\", \"dir\": \".\" }]); a JSON-encoded string is accepted but must decode to an array or a single task object"), STR_LEN("parallel must be a JSON array of task objects (e.g. [{ \"action\": \"list_dir\", \"dir\": \".\" }]); a JSON-encoded string is accepted but must decode to an array or a single task object"));
            return;
        };
        cand_node = doc;
        cand_is_array = json_is_array(doc);
    } else {
        cand_node = node;
        cand_is_array = json_is_array(node);
    };

    // if (!Array.isArray(candidate) && (typeof candidate !== "object" || candidate === null)) -> error
    // DEFECT: typeof on a JSON node is approximated by the node-kind
    // query (json_is_object); non-object scalars fail like TS.
    if !cand_is_array && !json_is_object(cand_node) {
        norm_fail(out, STR_PTR("parallel must be an array of task objects (received non-object)"), STR_LEN("parallel must be an array of task objects (received non-object)"));
        return;
    };

    // const tasks = Array.isArray(candidate) ? candidate : [candidate];
    // for each task: array or non-object -> error with index.
    // The normalized tasks are re-serialized into tasks_json.
    out.has_tasks = true;
    out.tasks_json_len = 0;
    tasks_append(out, STR_PTR("["), STR_LEN("["));
    if cand_is_array {
        let idx: u64 = 0;
        while 1 == 1 {
            let el: u64 = 0;
            if sa_json_array_get(cand_node, idx, &el) != 0 { break; };
            if json_is_array(el) || !json_is_object(el) {
                // TS: `parallel[${index}] must be a task object with an 'action' or 'path' field`
                // DEFECT: index interpolation — message keeps the
                // prefix; the numeric index is appended by callers in
                // the fix phase.
                norm_fail(out, STR_PTR("parallel task must be a task object with an 'action' or 'path' field"), STR_LEN("parallel task must be a task object with an 'action' or 'path' field"));
                return;
            };
            if idx > 0 { tasks_append(out, STR_PTR(","), STR_LEN(",")); };
            tasks_append_node(out, el);
            idx = idx + 1;
        }
    } else {
        tasks_append_node(out, cand_node);
    };
    tasks_append(out, STR_PTR("]"), STR_LEN("]"));
    out.ok = true;
}

fn tasks_append(out: &SaVmParallelNormalization, src_ptr: ptr, src_len: u64) -> void {
    for i in 0..src_len {
        if out.tasks_json_len < 262144 {
            let c: u8 = 0;
            PTR_BYTE_AT(c, src_ptr, i);
            out.tasks_json[out.tasks_json_len] = c;
            out.tasks_json_len = out.tasks_json_len + 1;
        };
    }
}

fn tasks_append_node(out: &SaVmParallelNormalization, node: u64) -> void {
    let sh: u64 = 0;
    if sa_json_stringify(node, &sh) == 0 {
        let sp: ptr = sa_json_buffer_data(sh);
        let sl = sa_json_buffer_len(sh);
        tasks_append(out, sp, sl);
    };
}

// DEFECT: node-kind queries — sa_json surface has no direct kind tag
// accessor in the .sai set used here; approximated by probe calls.
fn json_is_array(node: u64) -> bool {
    let el: u64 = 0;
    return sa_json_array_get(node, 0, &el) == 0 || json_array_len_probe(node) > 0;
}

fn json_array_len_probe(node: u64) -> u64 {
    return 0;
}

fn json_is_object(node: u64) -> bool {
    return node != 0;
}

// validateSaVmRequestBody(body: Record<string, unknown>) -> SaVmRequestValidation
// body is a parsed sa_json doc handle.
fn validateSaVmRequestBody(body: u64, out: &SaVmRequestValidation) -> void {
    out.ok = true;
    out.is_parallel = false;
    out.err_len = 0;
    // const parallel = normalizeSaVmParallelTasks(body.parallel);
    // DEFECT: the field's (kind,node,str) extraction inlines the
    // sa_json kind probes; absent field -> kind 0 (undefined).
    let p_kind: u64 = 0;
    let p_node: u64 = 0;
    let p_ptr: ptr = PTR_NULL();
    let p_len: u64 = 0;
    body_parallel_field(body, &p_kind, &p_node, &p_ptr, &p_len);
    let norm = SaVmParallelNormalization { ok: false, has_tasks: false, tasks_json: [0u8; 262144], tasks_json_len: 0, err_bytes: [0u8; 1024], err_len: 0 };
    normalizeSaVmParallelTasks(p_kind, p_node, p_ptr, p_len, &norm);
    if !norm.ok {
        val_fail(out, CODE_INVALID_PARALLEL, &norm.err_bytes, norm.err_len);
        return;
    };
    let is_parallel = norm.has_tasks;
    out.is_parallel = is_parallel;
    // const hasAction = typeof body.action === "string" || typeof body.path === "string";
    let has_action = body_field_is_string(body, STR_PTR("action"), STR_LEN("action")) || body_field_is_string(body, STR_PTR("path"), STR_LEN("path"));
    // const hasSource = typeof body.source === "string";
    let has_source = body_field_is_string(body, STR_PTR("source"), STR_LEN("source"));
    if !is_parallel && !has_action {
        // if (body.language !== undefined && !== "js" && !== "py") -> SLA_REQUIRED
        if body_field_present(body, STR_PTR("language"), STR_LEN("language")) && !body_field_is_string_eq(body, STR_PTR("language"), STR_LEN("language"), STR_PTR("js"), STR_LEN("js")) && !body_field_is_string_eq(body, STR_PTR("language"), STR_LEN("language"), STR_PTR("py"), STR_LEN("py")) {
            val_fail(out, CODE_SLA_REQUIRED, STR_PTR("SA-VM requests require language=\"js\" or language=\"py\" when source is provided (bun branch; sa/sla removed)"), STR_LEN("SA-VM requests require language=\"js\" or language=\"py\" when source is provided (bun branch; sa/sla removed)"));
            return;
        };
        if !has_source {
            val_fail(out, CODE_SLA_REQUIRED, STR_PTR("SA-VM requests require an action (e.g. read_file, find_files, write_file) or source"), STR_LEN("SA-VM requests require an action (e.g. read_file, find_files, write_file) or source"));
            return;
        };
    };

    // const rawAction = typeof body.action === "string" ? body.action.trim().toLowerCase() : "";
    let act_ptr: ptr = PTR_NULL();
    let act_len: u64 = 0;
    let act_is_str = body_field_string(body, STR_PTR("action"), STR_LEN("action"), &act_ptr, &act_len);
    if act_is_str && str_eq_lower_trim(act_ptr, act_len, STR_PTR("run_project_check"), STR_LEN("run_project_check")) {
        if body_field_present(body, STR_PTR("profile"), STR_LEN("profile")) && !body_field_is_string(body, STR_PTR("profile"), STR_LEN("profile")) {
            val_fail(out, CODE_INVALID_INPUT, STR_PTR("run_project_check requires a string 'profile'"), STR_LEN("run_project_check requires a string 'profile'"));
            return;
        };
        if body_field_present(body, STR_PTR("test_file"), STR_LEN("test_file")) && !body_field_is_string(body, STR_PTR("test_file"), STR_LEN("test_file")) {
            val_fail(out, CODE_INVALID_INPUT, STR_PTR("run_project_check 'test_file' must be a string"), STR_LEN("run_project_check 'test_file' must be a string"));
            return;
        };
    } else if act_is_str && str_eq_lower_trim(act_ptr, act_len, STR_PTR("run_bun"), STR_LEN("run_bun")) {
        if body_field_present(body, STR_PTR("subcommand"), STR_LEN("subcommand")) && !body_field_is_string(body, STR_PTR("subcommand"), STR_LEN("subcommand")) {
            val_fail(out, CODE_INVALID_INPUT, STR_PTR("run_bun 'subcommand' must be a string"), STR_LEN("run_bun 'subcommand' must be a string"));
            return;
        };
        // body.args !== undefined && (!Array.isArray || some non-string)
        if body_field_present(body, STR_PTR("args"), STR_LEN("args")) && !body_args_all_strings(body) {
            val_fail(out, CODE_INVALID_INPUT, STR_PTR("run_bun 'args' must be an array of strings"), STR_LEN("run_bun 'args' must be an array of strings"));
            return;
        };
    };
    out.ok = true;
}

// --- body field probes over a sa_json doc (structural equivalents of
// the TS typeof checks) ---
fn body_field_present(doc: u64, key_ptr: ptr, key_len: u64) -> bool {
    let n: u64 = 0;
    return sa_json_object_get(doc, key_ptr, key_len, &n) == 0;
}

fn body_field_string(doc: u64, key_ptr: ptr, key_len: u64, out_ptr: &ptr, out_len: &u64) -> bool {
    return sa_json_object_get_string(doc, key_ptr, key_len, out_ptr, out_len) == 0;
}

fn body_field_is_string(doc: u64, key_ptr: ptr, key_len: u64) -> bool {
    let p: ptr = PTR_NULL();
    let l: u64 = 0;
    return sa_json_object_get_string(doc, key_ptr, key_len, &p, &l) == 0;
}

fn body_field_is_string_eq(doc: u64, key_ptr: ptr, key_len: u64, lit_ptr: ptr, lit_len: u64) -> bool {
    let p: ptr = PTR_NULL();
    let l: u64 = 0;
    if sa_json_object_get_string(doc, key_ptr, key_len, &p, &l) != 0 { return false; };
    if l != lit_len { return false; };
    for i in 0..lit_len {
        let a: u8 = 0;
        let b: u8 = 0;
        PTR_BYTE_AT(a, p, i);
        PTR_BYTE_AT(b, lit_ptr, i);
        if a != b { return false; };
    }
    return true;
}

fn body_args_all_strings(doc: u64) -> bool {
    let arr: u64 = 0;
    if sa_json_object_get(doc, STR_PTR("args"), STR_LEN("args"), &arr) != 0 { return false; };
    let idx: u64 = 0;
    while 1 == 1 {
        let el: u64 = 0;
        if sa_json_array_get(arr, idx, &el) != 0 { break; };
        // DEFECT: element string-kind probe approximated by the
        // string ptr/len accessors (null ptr for non-strings).
        let sp: ptr = sa_json_string_ptr(el);
        if sp == PTR_NULL() { return false; };
        idx = idx + 1;
    }
    return true;
}

fn body_parallel_field(doc: u64, out_kind: &u64, out_node: &u64, out_ptr: &ptr, out_len: &u64) -> void {
    let n: u64 = 0;
    if sa_json_object_get(doc, STR_PTR("parallel"), STR_LEN("parallel"), &n) != 0 {
        out_kind = 0;
        out_node = 0;
        return;
    };
    // string?
    let sp: ptr = sa_json_string_ptr(n);
    if sp != PTR_NULL() {
        out_kind = 2;
        out_ptr = sp;
        out_len = sa_json_string_len(n);
        out_node = n;
        return;
    };
    out_kind = 3;
    out_node = n;
}

// trim + ASCII-lowercase equality against a literal.
fn str_eq_lower_trim(p: ptr, len: u64, lit_ptr: ptr, lit_len: u64) -> bool {
    let lo: u64 = 0;
    let hi = len;
    while lo < hi {
        let c: u8 = 0;
        PTR_BYTE_AT(c, p, lo);
        if c != 32 && c != 9 && c != 10 && c != 13 { break; };
        lo = lo + 1;
    }
    while hi > lo {
        let c: u8 = 0;
        PTR_BYTE_AT(c, p, hi - 1);
        if c != 32 && c != 9 && c != 10 && c != 13 { break; };
        hi = hi - 1;
    }
    if hi - lo != lit_len { return false; };
    for i in 0..lit_len {
        let c: u8 = 0;
        PTR_BYTE_AT(c, p, lo + i);
        if c >= 65 && c <= 90 { c = c + 32; };
        let d: u8 = 0;
        PTR_BYTE_AT(d, lit_ptr, i);
        if c != d { return false; };
    }
    return true;
}
