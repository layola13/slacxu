// Converted 1:1 from packages/cxu/src/vendor/saVmAccountabilityLedger.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.

// Append-only accountability ledger: penalties, rewards/redemptions,
// reputation tiers and antibodies, with a JEV-gated RED-tier write gate.
// DEFECT: async/Promise fs APIs, Map/Set, JSON.parse/stringify,
// randomUUID and Date.now have no direct SLA equivalents; async fns
// become synchronous + status code, collections become fixed arrays,
// JSON lines become JSON text buffers, ids/timestamps are parameters
// or sa_std extern approximations.
@import "sa_std/io/print.sai"
@import "sa_std/ptr.sa"
@import "../shared-types.sla"
@import "./saVmJev.sla"

// export type PenaltyLevel = "L1_SYNTAX"|"L2_REGRESSION"|"L3_THRASH"|"CUSTOM"
const PENALTY_L1_SYNTAX: u64 = 0;
const PENALTY_L2_REGRESSION: u64 = 1;
const PENALTY_L3_THRASH: u64 = 2;
const PENALTY_CUSTOM: u64 = 3;
// export const PENALTY_SCORES: Record<PenaltyLevel, number>
fn penalty_score(level: u64) -> i64 {
    if level == PENALTY_L1_SYNTAX { return 0 - 10; };
    if level == PENALTY_L2_REGRESSION { return 0 - 20; };
    if level == PENALTY_L3_THRASH { return 0 - 30; };
    return 0 - 10;
}

// export interface PenaltyRecord
struct PenaltyRecord {
    id_bytes: [u8; 128], id_len: u64,
    level: u64,
    target_file_bytes: [u8; 4096], target_file_len: u64,
    error_sig_bytes: [u8; 2048], error_sig_len: u64,
    score_delta: i64,
    has_details: bool, details_bytes: [u8; 4096], details_len: u64,
    timestamp: u64,
    status: u64, has_redeemed_by: bool,
    redeemed_by_bytes: [u8; 128], redeemed_by_len: u64,
}
const PENALTY_STATUS_ACTIVE: u64 = 0;
const PENALTY_STATUS_REDEEMED: u64 = 1;

// export interface RewardRecord
struct RewardRecord {
    id_bytes: [u8; 128], id_len: u64,
    linked_penalty_id_bytes: [u8; 128], linked_penalty_id_len: u64,
    score_delta: i64,
    evidence_bytes: [u8; 8192], evidence_len: u64,
    lesson_bytes: [u8; 4096], lesson_len: u64,
    antibody_rule_bytes: [u8; 4096], antibody_rule_len: u64,
    timestamp: u64,
}

// export type LedgerEntry = PenaltyRecord | RewardRecord
// DEFECT: union -> tagged struct (tag 0=penalty, 1=reward).
struct LedgerEntry {
    tag: u64,
    penalty: PenaltyRecord,
    reward: RewardRecord,
    json_bytes: [u8; 16384], json_len: u64,
}
// DEFECT: dynamic entry list -> fixed array + len (capacity 1024).
struct LedgerEntries { items: [LedgerEntry; 1024], len: u64 }

// export type ReputationTier = "GREEN" | "YELLOW" | "RED"
const TIER_GREEN: u64 = 0;
const TIER_YELLOW: u64 = 1;
const TIER_RED: u64 = 2;

// export interface Antibody
struct Antibody {
    target_file_bytes: [u8; 4096], target_file_len: u64,
    rule_bytes: [u8; 4096], rule_len: u64,
    lesson_bytes: [u8; 4096], lesson_len: u64,
    penalty_id_bytes: [u8; 128], penalty_id_len: u64,
    reward_id_bytes: [u8; 128], reward_id_len: u64,
    timestamp: u64,
}

// export interface ReputationStatus
struct ReputationStatus {
    score: i64, tier: u64,
    active: [PenaltyRecord; 512], active_len: u64,
    redeemed: [PenaltyRecord; 512], redeemed_len: u64,
    antibodies: [Antibody; 512], antibodies_len: u64,
    total_penalties: u64, total_rewards: u64,
    ledger_path_bytes: [u8; 4096], ledger_path_len: u64,
}

// export interface AccountabilityGateResult
struct AccountabilityGateResult {
    allowed: bool, tier: u64, score: i64,
    has_kind: bool, kind: u64,
    has_reason: bool, reason_bytes: [u8; 8192], reason_len: u64,
    has_notice: bool, notice_bytes: [u8; 8192], notice_len: u64,
    has_antibody_notice: bool, antibody_notice_bytes: [u8; 8192], antibody_notice_len: u64,
    has_jev_verdict: bool,
    jev_verdict_bytes: [u8; 512], jev_verdict_len: u64,
    has_jev_risk: bool, jev_risk_bytes: [u8; 512], jev_risk_len: u64,
    has_jev_summary: bool, jev_summary_bytes: [u8; 4096], jev_summary_len: u64,
}
const GATE_KIND_CAPABILITY_DENIED: u64 = 0;
const GATE_KIND_SA_ERROR: u64 = 1;

// export type JevAuditFunction = (context) => Promise<{...}>
