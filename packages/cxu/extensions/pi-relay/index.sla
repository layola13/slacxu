// Converted 1:1 from packages/cxu/extensions/pi-relay/index.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "sa_std/ptr.sa"
@import "sa_std/string.sa"

// Pi Relay Extension for Codex Ultra
//
// Reads PI_LAUNCH_BASE_URL, PI_LAUNCH_MODEL, and PI_LAUNCH_API_KEY (or
// PI_LAUNCH_API) and registers the "pi-relay" provider dynamically
// with Pi.
//
// TS: import type { ExtensionAPI, ProviderModelConfig } from
// "@earendil-works/pi-coding-agent";
// DEFECT: the Pi ExtensionAPI (pi.registerProvider) is a host JS API
// with no sa_std counterpart; the registration payload is built as
// structs/JSON below and the register call is a declared stub.

struct StrBuf {
    bytes: [u8; 2048],
    len: u64,
}

fn sb_reset(b: &StrBuf) -> void { b.len = 0; }

fn sb_append(b: &StrBuf, src_ptr: ptr, src_len: u64) -> void {
    for i in 0..src_len {
        if b.len < 2048 {
            let c: u8 = PTR_BYTE_AT(src_ptr, i);
            b.bytes[b.len] = c;
            b.len = b.len + 1;
        };
    }
}

fn sb_eq_str(b: &StrBuf, s_ptr: ptr, s_len: u64) -> bool {
    if b.len != s_len { return false; };
    for i in 0..s_len {
        let c: u8 = PTR_BYTE_AT(s_ptr, i);
        if b.bytes[i] != c { return false; };
    }
    return true;
}

fn sb_contains(b: &StrBuf, n_ptr: ptr, n_len: u64) -> bool {
    if b.len < n_len { return false; };
    let last = b.len - n_len;
    let i: u64 = 0;
    while i <= last {
        let ok = true;
        let j: u64 = 0;
        while j < n_len {
            let c: u8 = PTR_BYTE_AT(n_ptr, j);
            if b.bytes[i + j] != c { ok = false; break; };
            j = j + 1;
        }
        if ok { return true; };
        i = i + 1;
    }
    return false;
}

// TS (process.env.X || "default").trim() -> env-or-default + trim.
// env_get writes the raw env value into out when set; here the caller
// passes (set, ptr, len) and the default literal.
fn envOrDefault(set: bool, v_ptr: ptr, v_len: u64, def_ptr: ptr, def_len: u64, out: &StrBuf) -> void {
    sb_reset(out);
    if set && v_len > 0 {
        sb_append(out, v_ptr, v_len);
    } else {
        sb_append(out, def_ptr, def_len);
    };
    sb_trim(out);
}

fn sb_trim(b: &StrBuf) -> void {
    let lo: u64 = 0;
    let hi = b.len;
    while lo < hi {
        let c = b.bytes[lo];
        if c != 32 && c != 9 && c != 10 && c != 13 { break; };
        lo = lo + 1;
    }
    while hi > lo {
        let c = b.bytes[hi - 1];
        if c != 32 && c != 9 && c != 10 && c != 13 { break; };
        hi = hi - 1;
    }
    let n = hi - lo;
    for i in 0..n {
        b.bytes[i] = b.bytes[lo + i];
    }
    b.len = n;
}

// TS type ProviderModelConfig -> struct (one model entry).
struct ProviderModelConfig {
    id: StrBuf,
    name: StrBuf,
    reasoning: bool,
    // DEFECT: input: ["text", "image"] — fixed two-entry list kept as
    // a JSON fragment in the registration builder below.
    cost_input: u64,
    cost_output: u64,
    cost_cache_read: u64,
    cost_cache_write: u64,
    context_window: u64,
    max_tokens: u64,
    compat_supports_store: bool,
    compat_supports_developer_role: bool,
    compat_supports_reasoning_effort: bool,
    compat_supports_usage_in_streaming: bool,
    compat_supports_strict_mode: bool,
    compat_max_tokens_field: StrBuf,
}

// export default function piRelayExtension(pi: ExtensionAPI): void
// Env values are passed in as (set, ptr, len) triples extracted by the
// caller via sa_env_get: PI_LAUNCH_BASE_URL, PI_LAUNCH_API_KEY,
// PI_LAUNCH_MODEL, PI_LAUNCH_API.
fn piRelayExtension(
    base_set: bool, base_ptr: ptr, base_len: u64,
    key_set: bool, key_ptr: ptr, key_len: u64,
    model_set: bool, model_ptr: ptr, model_len: u64,
    api_set: bool, api_ptr: ptr, api_len: u64
) -> void {
    // const baseUrl = (process.env.PI_LAUNCH_BASE_URL || "https://api.kilo.ai/api/openrouter").trim();
    let baseUrl = StrBuf { bytes: [0u8; 2048], len: 0 };
    let def_base = "https:";
    // DEFECT: default URL assembled from fragments (same bytes).
    let def_base_full = StrBuf { bytes: [0u8; 2048], len: 0 };
    sb_append(&def_base_full, STR_PTR("https:"), STR_LEN("https:"));
    sb_append(&def_base_full, STR_PTR("//api.kilo.ai/api/openrouter"), STR_LEN("//api.kilo.ai/api/openrouter"));
    let dfp: ptr = PTR_NULL();
    PTR_BYTE_ADD(dfp, &def_base_full.bytes, 0);
    envOrDefault(base_set, base_ptr, base_len, dfp, def_base_full.len, &baseUrl);
    // const apiKey = (process.env.PI_LAUNCH_API_KEY || "public").trim();
    let apiKey = StrBuf { bytes: [0u8; 2048], len: 0 };
    envOrDefault(key_set, key_ptr, key_len, STR_PTR("public"), STR_LEN("public"), &apiKey);
    // const modelSpec = (process.env.PI_LAUNCH_MODEL || "stepfun/step-3.7-flash:free,kilo-auto/free,nvidia/nemotron-3.5-lightning:free").trim();
    let modelSpec = StrBuf { bytes: [0u8; 2048], len: 0 };
    envOrDefault(model_set, model_ptr, model_len, STR_PTR("stepfun/step-3.7-flash:free,kilo-auto/free,nvidia/nemotron-3.5-lightning:free"), STR_LEN("stepfun/step-3.7-flash:free,kilo-auto/free,nvidia/nemotron-3.5-lightning:free"), &modelSpec);
    // const apiType = (process.env.PI_LAUNCH_API || "openai-completions").trim();
    let apiType = StrBuf { bytes: [0u8; 2048], len: 0 };
    envOrDefault(api_set, api_ptr, api_len, STR_PTR("openai-completions"), STR_LEN("openai-completions"), &apiType);

    // If no baseUrl is provided, do not register
    if baseUrl.len == 0 { return; };

    // const modelIds = modelSpec ? modelSpec.split(",").map(trim).filter(Boolean)
    //                            : ["stepfun/step-3.7-flash:free"];
    // DEFECT: dynamic string array -> fixed table of up to 32 ids.
    let ids = [StrBuf { bytes: [0u8; 2048], len: 0 }; 32];
    let n_ids: u64 = 0;
    if modelSpec.len > 0 {
        let seg = StrBuf { bytes: [0u8; 2048], len: 0 };
        let i: u64 = 0;
        while i <= modelSpec.len {
            let at_end = i == modelSpec.len;
            let at_comma = false;
            if !at_end && modelSpec.bytes[i] == 44 { at_comma = true; };
            if at_end || at_comma {
                sb_trim(&seg);
                if seg.len > 0 && n_ids < 32 {
sb_reset(&ids[n_ids]);
                    let segp: ptr = PTR_NULL();
                    PTR_BYTE_ADD(segp, &seg.bytes, 0);
                    sb_append(&ids[n_ids], segp, seg.len);
                    n_ids = n_ids + 1;
                };
                sb_reset(&seg);
            } else {
                if seg.len < 2048 {
                    seg.bytes[seg.len] = modelSpec.bytes[i];
                    seg.len = seg.len + 1;
                };
            };
            i = i + 1;
        }
    } else {
        sb_append(&ids[0], STR_PTR("stepfun/step-3.7-flash:free"), STR_LEN("stepfun/step-3.7-flash:free"));
        n_ids = 1;
    };

    // const headers: Record<string, string> = {};
    // if (baseUrl.includes("kilo.ai")) headers["User-Agent"] = "opencode-kilo-provider";
    // DEFECT: Record -> two-slot fixed header table.
    let hdr_name = StrBuf { bytes: [0u8; 2048], len: 0 };
    let hdr_value = StrBuf { bytes: [0u8; 2048], len: 0 };
    let has_header = false;
    if sb_contains(&baseUrl, STR_PTR("kilo.ai"), STR_LEN("kilo.ai")) {
        sb_append(&hdr_name, STR_PTR("User-Agent"), STR_LEN("User-Agent"));
        sb_append(&hdr_value, STR_PTR("opencode-kilo-provider"), STR_LEN("opencode-kilo-provider"));
        has_header = true;
    };

    // const models: ProviderModelConfig[] = modelIds.map((id) => ({...}));
    let models = [ProviderModelConfig {
        id: StrBuf { bytes: [0u8; 2048], len: 0 },
        name: StrBuf { bytes: [0u8; 2048], len: 0 },
        reasoning: true,
        cost_input: 0, cost_output: 0, cost_cache_read: 0, cost_cache_write: 0,
        context_window: 128000, max_tokens: 32768,
        compat_supports_store: false, compat_supports_developer_role: true,
        compat_supports_reasoning_effort: true, compat_supports_usage_in_streaming: true,
        compat_supports_strict_mode: false,
        compat_max_tokens_field: StrBuf { bytes: [0u8; 2048], len: 0 },
    }; 32];
    for k in 0..n_ids {
        let idp: ptr = PTR_NULL();
        PTR_BYTE_ADD(idp, &ids[k].bytes, 0);
        sb_reset(&models[k].id);
        sb_append(&models[k].id, idp, ids[k].len);
        // name: `${id} (Relay)` — template literal -> assembly.
        sb_reset(&models[k].name);
        sb_append(&models[k].name, idp, ids[k].len);
        sb_append(&models[k].name, STR_PTR(" (Relay)"), STR_LEN(" (Relay)"));
        sb_append(&models[k].compat_max_tokens_field, STR_PTR("max_tokens"), STR_LEN("max_tokens"));
    }

    // pi.registerProvider("pi-relay", { name: "Codex Ultra Relay",
    //   baseUrl, apiKey: apiKey || "$PI_LAUNCH_API_KEY", api: apiType,
    //   headers, models });
    // DEFECT: host registerProvider call — payload serialized to JSON
    // and handed to the declared stub below.
    let effective_key = StrBuf { bytes: [0u8; 2048], len: 0 };
    if apiKey.len > 0 {
        effective_key = apiKey;
    } else {
        sb_append(&effective_key, STR_PTR("$PI_LAUNCH_API_KEY"), STR_LEN("$PI_LAUNCH_API_KEY"));
    };
    registerProvider(&baseUrl, &effective_key, &apiType, has_header, &hdr_name, &hdr_value, &models, n_ids);
}

// DEFECT: stub for pi.registerProvider("pi-relay", {...}) — no Pi host
// in SLA; the fix phase wires this to the SAX/host bridge.
fn registerProvider(base_url: &StrBuf, api_key: &StrBuf, api_type: &StrBuf, has_header: bool, hdr_name: &StrBuf, hdr_value: &StrBuf, models: &[ProviderModelConfig; 32], n_models: u64) -> void {
}
