// cxu-bridge entry (P1 pilot): run one bridge session. The child
// command line comes from CXU_AGENT_CMDLINE / CXU_AGENT_CMD (see
// bridge.sla); the exit code is the failing pump stage, 0 on success.
@import "sa_std/io/print.sai"
@import "bridge.sla"

fn main() -> i32 {
    let rc = bridge_pump();
    if rc != 0 {
        return rc;
    };
    println("cxu-bridge pump ok");
    return 0;
}
