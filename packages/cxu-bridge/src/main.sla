// cxu-bridge entry (P1 pilot slice 1): pick the child agent command
// from CXU_AGENT_CMD (single executable path; default /bin/cat for the
// offline echo smoke), run one bridge pump round, report the stage.
@import "sa_std/env.sai"
@import "sa_std/string.sa"
@import "sa_std/io/print.sai"
@import "bridge.sla"

fn main() -> i32 {
    let key = "CXU_AGENT_CMD";
    let h = sa_env_get(STR_PTR(key), STR_LEN(key));
    let rc: i32 = 0;
    if h == 0 {
        rc = bridge_pump(STR_PTR("/bin/cat"), STR_LEN("/bin/cat"));
    } else {
        let p: ptr = sa_env_buffer_data(h);
        let l = sa_env_buffer_len(h);
        rc = bridge_pump(p, l);
        sa_env_buffer_free(h);
    };
    if rc != 0 {
        return rc;
    };
    println("cxu-bridge pump ok");
    return 0;
}
