// cxu-bridge pump kernel: spawn a child agent over bidirectional
// stdio and run a JSON-RPC session: request rounds (write one line,
// read one reply line; stdin stays open), write-only notifications,
// and a generalized chained phase (slices 5 + P2-1): extract an id
// from a reply (round 2 or the phase-A result), splice it into the
// next request, and read streams until a configurable needle. The
// defaults reproduce the codex app-server session; ACP-speaking
// agents (opencode) override the knobs via env.
// Child selection (slice 3): CXU_AGENT_CMDLINE carries a full
// command line, tokenized on spaces (no quoting — agent CLI paths
// and flags do not contain spaces in practice); otherwise
// CXU_AGENT_CMD is a single executable path; otherwise /bin/cat.
@import "sa_std/process.sa"
@import "sa_std/string.sa"
@import "sa_std/env.sai"
@import "argv1.sa"
@import "argvfill.sa"
@import "ptradd.sa"

struct CmdLine {
    buf: [u8; 256],
    len: u64,
    t_off: [u64; 4],
    t_len: [u64; 4],
    count: u64,
}

struct ReqLine {
    buf: [u8; 256],
    len: u64,
}

// Persistent receive buffer: bytes read past a newline belong to
// the next line and must survive between calls (agent CLIs emit
// notifications back to back; the slice-4 per-round accumulator
// silently dropped those bytes).
struct LineBuf {
    buf: [u8; 4096],
    len: u64,
}

struct LineOut {
    buf: [u8; 4096],
    len: u64,
}

struct IdBuf {
    buf: [u8; 96],
    len: u64,
}

struct FindPos {
    at: u64,
    found: bool,
}

// Fills req from a literal byte string, appending a newline when the
// literal does not end with one (the pump protocol is line-based).
fn req_from_literal(req: &ReqLine, lit_ptr: ptr, lit_len: u64) -> void {
    let i: u64 = 0;
    let byte: u8 = 0;
    while i < lit_len {
        BYTE_AT_OUT(byte, lit_ptr, i);
        req.buf[i] = byte;
        i = i + 1;
    }
    req.len = lit_len;
    if lit_len == 0 || req.buf[lit_len - 1] != 10 {
        req.buf[lit_len] = 10;
        req.len = lit_len + 1;
    };
}

// Fills req from an env value when set (newline appended if
// missing). Returns true when the variable was present and fit.
fn req_from_env(req: &ReqLine, key_ptr: ptr, key_len: u64) -> bool {
    let h = sa_env_get(key_ptr, key_len);
    if h == 0 { return false; };
    let p: ptr = sa_env_buffer_data(h);
    let l = sa_env_buffer_len(h);
    if l > 254 {
        sa_env_buffer_free(h);
        return false;
    };
    req_from_literal(req, p, l);
    sa_env_buffer_free(h);
    return true;
}

// Copies an env value into req verbatim (no newline handling), for
// request assembly parts. Returns true when present and fit.
fn env_copy_raw(req: &ReqLine, key_ptr: ptr, key_len: u64) -> bool {
    let h = sa_env_get(key_ptr, key_len);
    if h == 0 { return false; };
    let p: ptr = sa_env_buffer_data(h);
    let l = sa_env_buffer_len(h);
    if l > 255 {
        sa_env_buffer_free(h);
        return false;
    };
    let i: u64 = 0;
    let byte: u8 = 0;
    while i < l {
        BYTE_AT_OUT(byte, p, i);
        req.buf[i] = byte;
        i = i + 1;
    }
    req.len = l;
    sa_env_buffer_free(h);
    return true;
}

// Appends another ReqLine's bytes to req (assembly). Caller
// guarantees capacity. Takes the source by reference: &struct.buf
// is a capability and cannot cross a plain ptr parameter.
fn req_append_req(req: &ReqLine, src: &ReqLine) -> void {
    let i: u64 = 0;
    while i < src.len {
        req.buf[req.len] = src.buf[i];
        req.len = req.len + 1;
        i = i + 1;
    }
}

fn req_append_id(req: &ReqLine, id: &IdBuf) -> void {
    let i: u64 = 0;
    while i < id.len {
        req.buf[req.len] = id.buf[i];
        req.len = req.len + 1;
        i = i + 1;
    }
}

// Splits cl.buf[0..len] on spaces into at most 4 tokens.
fn cmdline_tokenize(cl: &CmdLine) -> void {
    let i: u64 = 0;
    let start: u64 = 0;
    let in_tok = false;
    while i <= cl.len {
        let at_end = i == cl.len;
        let is_sp = false;
        if !at_end {
            if cl.buf[i] == 32 { is_sp = true; };
        };
        if in_tok {
            if at_end || is_sp {
                if cl.count < 4 {
                    cl.t_off[cl.count] = start;
                    cl.t_len[cl.count] = i - start;
                    cl.count = cl.count + 1;
                };
                in_tok = false;
            };
        } else {
            if !at_end && !is_sp {
                start = i;
                in_tok = true;
            };
        };
        i = i + 1;
    }
}

// Copies the env value named by key into cl (tokenized), when set.
// Returns true when the variable was present.
fn cmdline_from_env(cl: &CmdLine, key_ptr: ptr, key_len: u64) -> bool {
    let h = sa_env_get(key_ptr, key_len);
    if h == 0 { return false; };
    let p: ptr = sa_env_buffer_data(h);
    let l = sa_env_buffer_len(h);
    if l > 255 {
        sa_env_buffer_free(h);
        return false;
    };
    let ci: u64 = 0;
    let byte: u8 = 0;
    while ci < l {
        BYTE_AT_OUT(byte, p, ci);
        cl.buf[ci] = byte;
        ci = ci + 1;
    }
    cl.len = l;
    sa_env_buffer_free(h);
    cmdline_tokenize(cl);
    return true;
}

// Extracts the next complete line from lb into out, reading more
// from hout as needed. Returns 0 on a line, 8 on read error, 20 on
// EOF before a newline, 21 when a single line exceeds the buffer.
fn lb_next_line(lb: &LineBuf, hout: u64, out: &LineOut) -> i32 {
    let chunk = [0u8; 256];
    while true {
        let k: u64 = 0;
        let found = false;
        while k < lb.len {
            if lb.buf[k] == 10 { found = true; break; };
            k = k + 1;
        }
        if found {
            let linelen = k + 1;
            let i: u64 = 0;
            while i < linelen {
                out.buf[i] = lb.buf[i];
                i = i + 1;
            }
            out.len = linelen;
            let rest = lb.len - linelen;
            let j: u64 = 0;
            while j < rest {
                lb.buf[j] = lb.buf[linelen + j];
                j = j + 1;
            }
            lb.len = rest;
            return 0;
        };
        if lb.len >= 4096 { return 21; };
        let n: u64 = 0;
        let rst = sa_io_read(hout, &chunk, 256, &n);
        if rst != 0 { return 8; };
        if n == 0 { return 20; };
        let i: u64 = 0;
        while i < n {
            if lb.len < 4096 {
                lb.buf[lb.len] = chunk[i];
                lb.len = lb.len + 1;
            };
            i = i + 1;
        }
    }
    return 20;
}

// Naive substring search over a copied line. The needle travels
// as a ReqLine reference: &struct.buf is a capability and cannot
// cross a plain ptr parameter.
fn find_sub(line: &LineOut, needle: &ReqLine, pos: &FindPos) -> void {
    pos.found = false;
    pos.at = 0;
    if needle.len == 0 || line.len < needle.len { return; };
    let i: u64 = 0;
    let last_start = line.len - needle.len;
    while i <= last_start {
        if line.buf[i] == needle.buf[0] {
            let j: u64 = 1;
            let ok = true;
            while j < needle.len {
                if line.buf[i + j] != needle.buf[j] { ok = false; break; };
                j = j + 1;
            }
            if ok {
                pos.found = true;
                pos.at = i;
                return;
            };
        };
        i = i + 1;
    }
}

// Materializes a search needle: env value when the key is set,
// else the literal default (req_from_literal appends a newline;
// a needle must not carry one, so it is trimmed back off).
fn needle_or(dst: &ReqLine, key_ptr: ptr, key_len: u64, def_ptr: ptr, def_len: u64) -> void {
    if env_copy_raw(dst, key_ptr, key_len) { return; };
    req_from_literal(dst, def_ptr, def_len);
    if dst.len > 0 && dst.buf[dst.len - 1] == 10 { dst.len = dst.len - 1; };
}

// Extracts the value after marker in line (up to the next '"')
// into id. Returns false when the marker or closing quote is
// missing or the value does not fit.
fn extract_after(line: &LineOut, marker: &ReqLine, id: &IdBuf) -> bool {
    let pos = FindPos { at: 0, found: false };
    find_sub(line, marker, &pos);
    if !pos.found { return false; };
    let start = pos.at + marker.len;
    let i: u64 = 0;
    while start + i < line.len {
        if line.buf[start + i] == 34 {
            id.len = i;
            return i > 0;
        };
        if i >= 96 { return false; };
        id.buf[i] = line.buf[start + i];
        i = i + 1;
    }
    return false;
}

// Writes one request line without reading (JSON-RPC notifications
// have no reply; reading for one would deadlock the session). Also
// used for requests whose replies are consumed by pump_until.
fn pump_notify(hin: u64, line: &ReqLine) -> i32 {
    let written: u64 = 0;
    let wst = sa_io_write(hin, &line.buf, line.len, &written);
    if wst != 0 { return 5; };
    if written != line.len { return 6; };
    return 0;
}

// One round: write req, then read exactly one reply line. Returns
// 0 when the reply is a non-empty JSON-framed line ('{' .. '\n');
// otherwise the failing stage number.
fn pump_round(hin: u64, lb: &LineBuf, hout: u64, req: &ReqLine, line: &LineOut) -> i32 {
    let wst = pump_notify(hin, req);
    if wst != 0 { return wst; };
    let rst = lb_next_line(lb, hout, line);
    if rst != 0 { return rst; };
    if line.len == 0 { return 9; };
    if line.buf[0] != 123 { return 10; };
    if line.buf[line.len - 1] != 10 { return 11; };
    return 0;
}

// Reads lines until one contains the needle; the matching line is
// left in out. Returns lb_next_line errors, or 22 when max_lines
// is exhausted first.
fn pump_until(lb: &LineBuf, hout: u64, needle: &ReqLine, max_lines: u64, out: &LineOut) -> i32 {
    let pos = FindPos { at: 0, found: false };
    let count: u64 = 0;
    while count < max_lines {
        let rst = lb_next_line(lb, hout, out);
        if rst != 0 { return rst; };
        find_sub(out, needle, &pos);
        if pos.found { return 0; };
        count = count + 1;
    }
    return 22;
}

// Full session: resolve the child command line, spawn it, run the
// handshake rounds (ids 1 and 2, optional notification between),
// then the optional turn phase (slice 5) when CXU_REQ3 is set:
// thread/start, extract the thread id, splice it into
// CXU_REQ4_PRE/POST as turn/start, and read the stream through
// turn/completed. Finally close stdin and reap.
fn bridge_pump() -> i32 {
    let cl = CmdLine { buf: [0u8; 256], len: 0, t_off: [0u64; 4], t_len: [0u64; 4], count: 0 };
    let have = cmdline_from_env(&cl, STR_PTR("CXU_AGENT_CMDLINE"), STR_LEN("CXU_AGENT_CMDLINE"));
    if !have {
        let have2 = cmdline_from_env(&cl, STR_PTR("CXU_AGENT_CMD"), STR_LEN("CXU_AGENT_CMD"));
        if !have2 {
            let di: u64 = 0;
            let dbyte: u8 = 0;
            let dsrc = "/bin/cat";
            while di < STR_LEN("/bin/cat") {
                BYTE_AT_OUT(dbyte, STR_PTR(dsrc), di);
                cl.buf[di] = dbyte;
                di = di + 1;
            }
            cl.len = STR_LEN("/bin/cat");
            cmdline_tokenize(&cl);
        };
    };
    if cl.count == 0 { return 40; };
    let argv = [0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64];
    let tp0: ptr = STR_PTR("x");
    PTR_ADD_OUT(tp0, &cl.buf, cl.t_off[0]);
    ARGV_SET0(&argv, tp0, cl.t_len[0]);
    if cl.count > 1 {
        let tp1: ptr = STR_PTR("x");
        PTR_ADD_OUT(tp1, &cl.buf, cl.t_off[1]);
        ARGV_SET1(&argv, tp1, cl.t_len[1]);
    };
    if cl.count > 2 {
        let tp2: ptr = STR_PTR("x");
        PTR_ADD_OUT(tp2, &cl.buf, cl.t_off[2]);
        ARGV_SET2(&argv, tp2, cl.t_len[2]);
    };
    if cl.count > 3 {
        let tp3: ptr = STR_PTR("x");
        PTR_ADD_OUT(tp3, &cl.buf, cl.t_off[3]);
        ARGV_SET3(&argv, tp3, cl.t_len[3]);
    };
    let proc: u64 = 0;
    let hin: u64 = 0;
    let hout: u64 = 0;
    let herr: u64 = 0;
    let st = sa_std_process_spawn_bidi(&argv, cl.count, &proc, &hin, &hout, &herr);
    if st != 0 { return 2; };
    if proc == 0 { return 3; };
    if hin == 0 { return 4; };
    let lb = LineBuf { buf: [0u8; 4096], len: 0 };
    let line1 = LineOut { buf: [0u8; 4096], len: 0 };
    let req1 = ReqLine { buf: [0u8; 256], len: 0 };
    if !req_from_env(&req1, STR_PTR("CXU_REQ1"), STR_LEN("CXU_REQ1")) {
        let d1 = "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"ping\"}";
        req_from_literal(&req1, STR_PTR(d1), STR_LEN(d1));
    };
    let r1 = pump_round(hin, &lb, hout, &req1, &line1);
    if r1 != 0 { return 30 + r1; };
    let note = ReqLine { buf: [0u8; 256], len: 0 };
    if req_from_env(&note, STR_PTR("CXU_NOTIFY"), STR_LEN("CXU_NOTIFY")) {
        let rn = pump_notify(hin, &note);
        if rn != 0 { return 50 + rn; };
    };
    let line2 = LineOut { buf: [0u8; 4096], len: 0 };
    let req2 = ReqLine { buf: [0u8; 256], len: 0 };
    if !req_from_env(&req2, STR_PTR("CXU_REQ2"), STR_LEN("CXU_REQ2")) {
        let d2 = "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"ping\"}";
        req_from_literal(&req2, STR_PTR(d2), STR_LEN(d2));
    };
    let r2 = pump_round(hin, &lb, hout, &req2, &line2);
    if r2 != 0 { return 60 + r2; };
    // Generalized session phases. Defaults reproduce the codex
    // session exactly; ACP-style protocols override the knobs:
    // CXU_MARKER (extraction marker), CXU_EXTRACT_FROM ("2" takes
    // the id from round 2's reply), CXU_ID3 (phase-A wait needle),
    // CXU_UNTIL (final stream needle), CXU_REQ3_PRE/POST (phase-A
    // request assembled around the extracted id instead of a
    // verbatim CXU_REQ3).
    let marker = ReqLine { buf: [0u8; 256], len: 0 };
    let dm = "\"thread\":{\"id\":\"";
    needle_or(&marker, STR_PTR("CXU_MARKER"), STR_LEN("CXU_MARKER"), STR_PTR(dm), STR_LEN(dm));
    let from = ReqLine { buf: [0u8; 256], len: 0 };
    let from2 = env_copy_raw(&from, STR_PTR("CXU_EXTRACT_FROM"), STR_LEN("CXU_EXTRACT_FROM")) && from.len > 0 && from.buf[0] == 50;
    let id = IdBuf { buf: [0u8; 96], len: 0 };
    let have_id = false;
    if from2 {
        if !extract_after(&line2, &marker, &id) { return 73; };
        have_id = true;
    };
    let req3 = ReqLine { buf: [0u8; 256], len: 0 };
    let pre3 = ReqLine { buf: [0u8; 256], len: 0 };
    let has_pre3 = env_copy_raw(&pre3, STR_PTR("CXU_REQ3_PRE"), STR_LEN("CXU_REQ3_PRE"));
    let has_req3 = has_pre3 || env_copy_raw(&req3, STR_PTR("CXU_REQ3"), STR_LEN("CXU_REQ3"));
    if has_req3 {
        if has_pre3 {
            if !have_id { return 77; };
            let post3 = ReqLine { buf: [0u8; 256], len: 0 };
            if !env_copy_raw(&post3, STR_PTR("CXU_REQ3_POST"), STR_LEN("CXU_REQ3_POST")) { return 74; };
            req_append_req(&req3, &pre3);
            req_append_id(&req3, &id);
            req_append_req(&req3, &post3);
            req3.buf[req3.len] = 10;
            req3.len = req3.len + 1;
        } else {
            if req3.len == 0 || req3.buf[req3.len - 1] != 10 {
                req3.buf[req3.len] = 10;
                req3.len = req3.len + 1;
            };
        };
        let w3 = pump_notify(hin, &req3);
        if w3 != 0 { return 70 + w3; };
        let id3 = ReqLine { buf: [0u8; 256], len: 0 };
        let dn = "\"id\":3";
        needle_or(&id3, STR_PTR("CXU_ID3"), STR_LEN("CXU_ID3"), STR_PTR(dn), STR_LEN(dn));
        let line3 = LineOut { buf: [0u8; 4096], len: 0 };
        let u3 = pump_until(&lb, hout, &id3, 4000, &line3);
        if u3 != 0 { return 72; };
        if !have_id {
            if !extract_after(&line3, &marker, &id) { return 73; };
            have_id = true;
        };
    };
    let pre4 = ReqLine { buf: [0u8; 256], len: 0 };
    if env_copy_raw(&pre4, STR_PTR("CXU_REQ4_PRE"), STR_LEN("CXU_REQ4_PRE")) {
        if !have_id { return 77; };
        let post4 = ReqLine { buf: [0u8; 256], len: 0 };
        if !env_copy_raw(&post4, STR_PTR("CXU_REQ4_POST"), STR_LEN("CXU_REQ4_POST")) { return 74; };
        let req4 = ReqLine { buf: [0u8; 256], len: 0 };
        req_append_req(&req4, &pre4);
        req_append_id(&req4, &id);
        req_append_req(&req4, &post4);
        req4.buf[req4.len] = 10;
        req4.len = req4.len + 1;
        let w4 = pump_notify(hin, &req4);
        if w4 != 0 { return 75 + w4; };
        let until = ReqLine { buf: [0u8; 256], len: 0 };
        let du = "\"turn/completed\"";
        needle_or(&until, STR_PTR("CXU_UNTIL"), STR_LEN("CXU_UNTIL"), STR_PTR(du), STR_LEN(du));
        let linedone = LineOut { buf: [0u8; 4096], len: 0 };
        let u4 = pump_until(&lb, hout, &until, 4000, &linedone);
        if u4 != 0 { return 76; };
    };
    if sa_std_close(hin) != 0 { return 7; };
    let code: u32 = 99;
    if sa_std_process_wait(proc, &code) != 0 { return 12; };
    if code != 0 { return 13; };
    if sa_std_close(hout) != 0 { return 14; };
    if sa_std_close(herr) != 0 { return 15; };
    if sa_std_process_close(proc) != 0 { return 16; };
    return 0;
}
