// cxu-bridge pump kernel: spawn a child agent over bidirectional
// stdio and run a multi-round line protocol — write one JSON-RPC
// line, read exactly one reply line (stdin stays open), repeat.
// This is the shape a real agent session needs (slice 1 closed stdin
// after a single line). Reply framing is verified per round: a round
// completes on '\n'; EOF mid-round is a hard failure, never a pass.
@import "sa_std/process.sa"
@import "sa_std/string.sa"
@import "argv1.sa"

struct PumpAcc {
    buf: [u8; 256],
    total: u64,
    last: u8,
    got: u64,
}

// Reads chunks from hout into acc until a newline has been consumed
// (one full reply line) or the stream ends. Returns 0 on a complete
// line, 20 on EOF before any newline, 8 on a read error.
fn pump_read_line(acc: &PumpAcc, hout: u64) -> i32 {
    let chunk = [0u8; 64];
    let n: u64 = 0;
    let done = false;
    while done != true {
        let rst = sa_io_read(hout, &chunk, 64, &n);
        if rst != 0 { return 8; };
        if n == 0 { return 20; };
        let i: u64 = 0;
        while i < n {
            if acc.total < 256 {
                acc.buf[acc.total] = chunk[i];
            };
            acc.total = acc.total + 1;
            acc.got = acc.got + 1;
            acc.last = chunk[i];
            i = i + 1;
        }
        if acc.last == 10 {
            done = true;
        };
    }
    return 0;
}

// One round: write req, then pump one reply line into a fresh
// accumulator. Returns 0 when the reply is a non-empty JSON-framed
// line ('{' .. '\n'); otherwise the failing stage number.
fn pump_round(hin: u64, hout: u64, req_ptr: ptr, req_len: u64) -> i32 {
    let written: u64 = 0;
    let wst = sa_io_write(hin, req_ptr, req_len, &written);
    if wst != 0 { return 5; };
    if written != req_len { return 6; };
    let acc = PumpAcc { buf: [0u8; 256], total: 0, last: 0, got: 0 };
    let rst = pump_read_line(&acc, hout);
    if rst != 0 { return rst; };
    if acc.got == 0 { return 9; };
    if acc.buf[0] != 123 { return 10; };
    if acc.last != 10 { return 11; };
    return 0;
}

// Full session: spawn, two rounds (ids 1 and 2), close stdin, reap.
fn bridge_pump(cmd_ptr: ptr, cmd_len: u64) -> i32 {
    let argv = [0u64, 0u64];
    ARGV_FILL1(&argv, cmd_ptr, cmd_len);
    let proc: u64 = 0;
    let hin: u64 = 0;
    let hout: u64 = 0;
    let herr: u64 = 0;
    let st = sa_std_process_spawn_bidi(&argv, 1, &proc, &hin, &hout, &herr);
    if st != 0 { return 2; };
    if proc == 0 { return 3; };
    if hin == 0 { return 4; };
    let req1 = "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"ping\"}\n";
    let r1 = pump_round(hin, hout, STR_PTR(req1), STR_LEN(req1));
    if r1 != 0 { return 30 + r1; };
    let req2 = "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"ping\"}\n";
    let r2 = pump_round(hin, hout, STR_PTR(req2), STR_LEN(req2));
    if r2 != 0 { return 60 + r2; };
    if sa_std_close(hin) != 0 { return 7; };
    let code: u32 = 99;
    if sa_std_process_wait(proc, &code) != 0 { return 12; };
    if code != 0 { return 13; };
    if sa_std_close(hout) != 0 { return 14; };
    if sa_std_close(herr) != 0 { return 15; };
    if sa_std_process_close(proc) != 0 { return 16; };
    return 0;
}
