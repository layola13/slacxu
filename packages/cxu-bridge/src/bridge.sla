// cxu-bridge pump kernel: spawn a child agent over bidirectional
// stdio, send one JSON-RPC line, pump the reply stream to EOF, reap.
// Grown from demo D1 (demos/cxu/01_bridge_stdio) into project form:
// the child command is a parameter, not a hard-coded /bin/cat.
@import "sa_std/process.sa"
@import "sa_std/string.sa"
@import "argv1.sa"

// Returns 0 on a clean round-trip (reply is a non-empty byte stream
// framed like JSON text: first byte '{', last byte '\n'); otherwise a
// stage number identifying where the pump failed.
fn bridge_pump(cmd_ptr: ptr, cmd_len: u64) -> i32 {
    let argv = [0u64, 0u64];
    ARGV_FILL1(&argv, cmd_ptr, cmd_len);
    let proc: u64 = 0;
    let hin: u64 = 0;
    let hout: u64 = 0;
    let herr: u64 = 0;
    let st = sa_std_process_spawn_bidi(&argv, 1, &proc, &hin, &hout, &herr);
    if st != 0 { return 2; };
    if proc == 0 { return 3; };
    if hin == 0 { return 4; };
    let req = "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"ping\"}\n";
    let written: u64 = 0;
    let wst = sa_io_write(hin, STR_PTR(req), STR_LEN(req), &written);
    if wst != 0 { return 5; };
    if written != STR_LEN(req) { return 6; };
    if sa_std_close(hin) != 0 { return 7; };
    let buf = [0u8; 256];
    let chunk = [0u8; 64];
    let total: u64 = 0;
    let n: u64 = 0;
    let last_byte: u8 = 0;
    let eof = false;
    while eof != true {
        let rst = sa_io_read(hout, &chunk, 64, &n);
        if rst != 0 { return 8; };
        if n == 0 {
            eof = true;
        } else {
            last_byte = chunk[n - 1];
            let i: u64 = 0;
            while i < n {
                if total + i < 256 {
                    buf[total + i] = chunk[i];
                };
                i = i + 1;
            }
            total = total + n;
        }
    }
    if total == 0 { return 9; };
    if buf[0] != 123 { return 10; };
    if last_byte != 10 { return 11; };
    let code: u32 = 99;
    if sa_std_process_wait(proc, &code) != 0 { return 12; };
    if code != 0 { return 13; };
    if sa_std_close(hout) != 0 { return 14; };
    if sa_std_close(herr) != 0 { return 15; };
    if sa_std_process_close(proc) != 0 { return 16; };
    return 0;
}
