// ARGV_SET<i>: writes (ptr, len) pair i of a [u64; 2N] argv array.
// The offsets are baked into each macro (pair i: ptr at 16i, len at
// 16i+8) because SLA macro arguments are evaluated registers — an
// offset passed as an argument lands in the address-offset position
// as a register, which the SA flattener rejects. arr_ptr must be
// &array from .sla (ptr -> u64 casts are not allowed in .sla, hence
// SA macros; same pattern as argv1.sa's ARGV_FILL1).
[MACRO] ARGV_SET0 %arr_ptr, %p, %l
    store %arr_ptr+0, %p as ptr
    store %arr_ptr+8, %l as u64
[END_MACRO]

[MACRO] ARGV_SET1 %arr_ptr, %p, %l
    store %arr_ptr+16, %p as ptr
    store %arr_ptr+24, %l as u64
[END_MACRO]

[MACRO] ARGV_SET2 %arr_ptr, %p, %l
    store %arr_ptr+32, %p as ptr
    store %arr_ptr+40, %l as u64
[END_MACRO]

[MACRO] ARGV_SET3 %arr_ptr, %p, %l
    store %arr_ptr+48, %p as ptr
    store %arr_ptr+56, %l as u64
[END_MACRO]
