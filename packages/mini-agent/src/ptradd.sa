// PTR_ADD_OUT %out, %base, %off — %out = ptr_add %base, %off.
// Statement macro in the style of the ptr_helpers fixtures: writing
// the result into an existing ptr local keeps SLA's capability rules
// satisfied (no ptr arithmetic in .sla expression position).
[MACRO] PTR_ADD_OUT %out_ptr, %base, %off
    %out_ptr = ptr_add %base, %off
[END_MACRO]

// BYTE_AT_OUT %out, %ptr, %off — %out = load byte at %ptr+%off.
[MACRO] BYTE_AT_OUT %out_byte, %ptr, %off
    __cxu_ba_addr = ptr_add %ptr, %off
    %out_byte = load __cxu_ba_addr+0 as u8
    !__cxu_ba_addr
[END_MACRO]
