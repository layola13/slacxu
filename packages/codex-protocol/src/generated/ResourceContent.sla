// Converted 1:1 from packages/codex-protocol/src/generated/ResourceContent.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
// ts-rs generated protocol types. Conventions: string -> (ptr,len) pair;
// Array<T>/Record/unknown/union -> (ptr,len) JSON or slice buffer; number -> f64;
// string-literal union -> u64 tag (values in comments); optional -> plain field + note.
@import "./serde_json/JsonValue.sla"

// Contents returned when reading a resource from an MCP server.
struct ResourceContent_Variant0 {
    // The URI of this resource.
    uri_ptr: ptr,
    uri_len: u64,
    mimeType_ptr: ptr, // optional in TS
    mimeType_len: u64,
    text_ptr: ptr,
    text_len: u64,
    _meta: JsonValue, // optional in TS
}

struct ResourceContent_Variant1 {
    // The URI of this resource.
    uri_ptr: ptr,
    uri_len: u64,
    mimeType_ptr: ptr, // optional in TS
    mimeType_len: u64,
    blob_ptr: ptr,
    blob_len: u64,
    _meta: JsonValue, // optional in TS
}

// DEFECT: tagged union ResourceContent — variant selected by the
// "type" tag; payload approximated as JSON text.
struct ResourceContent {
    variant: u64,
    payload_ptr: ptr,
    payload_len: u64,
}
