// ts-rs generated protocol types. Conventions: string -> (ptr,len) pair;
// Array<T>/Record/unknown/union -> (ptr,len) JSON or slice buffer; number -> f64;
// string-literal union -> u64 tag (values in comments); optional -> plain field + note.
@import "./FuzzyFileSearchMatchType.sla"

// Superset of [`codex_file_search::FileMatch`]
struct FuzzyFileSearchResult {
    root_ptr: ptr,
    root_len: u64,
    path_ptr: ptr,
    path_len: u64,
    match_type: FuzzyFileSearchMatchType,
    file_name_ptr: ptr,
    file_name_len: u64,
    score: f64,
    indices_ptr: ptr, // DEFECT: TS Array<number> -> (ptr,len) slice
    indices_len: u64,
}
