// Converted 1:1 from packages/codex-protocol/src/generated/ContentItem.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
// ts-rs generated protocol types. Conventions: string -> (ptr,len) pair;
// Array<T>/Record/unknown/union -> (ptr,len) JSON or slice buffer; number -> f64;
// string-literal union -> u64 tag (values in comments); optional -> plain field + note.
@import "./ImageDetail.sla"

struct ContentItem_Input_text {
    type: u64, // literal value: "input_text"
    text_ptr: ptr,
    text_len: u64,
}

struct ContentItem_Input_image {
    type: u64, // literal value: "input_image"
    image_url_ptr: ptr,
    image_url_len: u64,
    detail: ImageDetail, // optional in TS
}

struct ContentItem_Output_text {
    type: u64, // literal value: "output_text"
    text_ptr: ptr,
    text_len: u64,
}

// DEFECT: tagged union ContentItem — variant selected by the
// "type" tag; payload approximated as JSON text.
struct ContentItem {
    variant: u64,
    payload_ptr: ptr,
    payload_len: u64,
}
