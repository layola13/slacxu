@import "./serde_json/JsonValue.sla"

// Presentation metadata advertised by an initialized MCP server.
struct McpServerInfo {
    name_ptr: ptr,
    name_len: u64,
    title_ptr: ptr,
    title_len: u64,
    version_ptr: ptr,
    version_len: u64,
    description_ptr: ptr,
    description_len: u64,
    icons_ptr: ptr, // DEFECT: TS Array<JsonValue> -> (ptr,len) slice
    icons_len: u64,
    websiteUrl_ptr: ptr,
    websiteUrl_len: u64,
}
