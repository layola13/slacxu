// Converted 1:1 from packages/codex-protocol/src/generated/v2/ConfigWarningNotification.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
// ts-rs generated protocol types. Conventions: string -> (ptr,len) pair;
// Array<T>/Record/unknown/union -> (ptr,len) JSON or slice buffer; number -> f64;
// string-literal union -> u64 tag (values in comments); optional -> plain field + note.
@import "./TextRange.sla"

struct ConfigWarningNotification {
    // Concise summary of the warning.
    summary_ptr: ptr,
    summary_len: u64,
    // Optional extra guidance or error details.
    details_ptr: ptr,
    details_len: u64,
    // Optional path to the config file that triggered the warning.
    path_ptr: ptr, // optional in TS
    path_len: u64,
    // Optional range for the error location inside the config file.
    range: TextRange, // optional in TS
}
