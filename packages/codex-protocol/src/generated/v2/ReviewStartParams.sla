// Converted 1:1 from packages/codex-protocol/src/generated/v2/ReviewStartParams.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
// ts-rs generated protocol types. Conventions: string -> (ptr,len) pair;
// Array<T>/Record/unknown/union -> (ptr,len) JSON or slice buffer; number -> f64;
// string-literal union -> u64 tag (values in comments); optional -> plain field + note.
@import "./ReviewDelivery.sla"
@import "./ReviewTarget.sla"

struct ReviewStartParams {
    threadId_ptr: ptr,
    threadId_len: u64,
    target: ReviewTarget,
    // Where to run the review: inline (default) on the current thread or
    // detached on a new thread (returned in `reviewThreadId`).
    delivery: ReviewDelivery, // optional in TS
}
