// Converted 1:1 from packages/codex-protocol/src/generated/v2/Turn.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
// ts-rs generated protocol types. Conventions: string -> (ptr,len) pair;
// Array<T>/Record/unknown/union -> (ptr,len) JSON or slice buffer; number -> f64;
// string-literal union -> u64 tag (values in comments); optional -> plain field + note.
@import "./ThreadItem.sla"
@import "./TurnError.sla"
@import "./TurnItemsView.sla"
@import "./TurnStatus.sla"

struct Turn {
    // Identifier for this turn. Codex-generated turn IDs are UUIDv7.
    id_ptr: ptr,
    id_len: u64,
    // Thread items currently included in this turn payload.
    items_ptr: ptr, // DEFECT: TS Array<ThreadItem> -> (ptr,len) slice
    items_len: u64,
    // Describes how much of `items` has been loaded for this turn.
    itemsView: TurnItemsView,
    status: TurnStatus,
    // Only populated when the Turn's status is failed.
    error: TurnError,
    // Unix timestamp (in seconds) when the turn started.
    startedAt: f64,
    // Unix timestamp (in seconds) when the turn completed.
    completedAt: f64,
    // Duration between turn start and completion in milliseconds, if known.
    durationMs: f64,
}
