// Converted 1:1 from packages/codex-protocol/src/generated/v2/ThreadResumeParams.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
// ts-rs generated protocol types. Conventions: string -> (ptr,len) pair;
// Array<T>/Record/unknown/union -> (ptr,len) JSON or slice buffer; number -> f64;
// string-literal union -> u64 tag (values in comments); optional -> plain field + note.
@import "../Personality.sla"
@import "../serde_json/JsonValue.sla"
@import "./ApprovalsReviewer.sla"
@import "./AskForApproval.sla"
@import "./SandboxMode.sla"

// There are three ways to resume a thread:
// 1. By thread_id: load the thread from disk by thread_id and resume it.
// 2. By history: instantiate the thread from memory and resume it.
// 3. By path: load the thread from disk by path and resume it.
//
// For non-running threads, the precedence is: history > non-empty path > thread_id.
// If using history or a non-empty path for a non-running thread, the thread_id
// param will be ignored.
//
// If thread_id identifies a running thread, app-server rejoins that thread and
// treats a non-empty path as a consistency check against the active rollout path.
// Empty string path values are treated as absent.
//
// Prefer using thread_id whenever possible.
struct ThreadResumeParams_Config {
    index_ptr: ptr, // DEFECT: TS index signature -> JSON text buffer
    index_len: u64,
}
struct ThreadResumeParams {
    threadId_ptr: ptr,
    threadId_len: u64,
    // Configuration overrides for the resumed thread, if any.
    model_ptr: ptr, // optional in TS
    model_len: u64,
    modelProvider_ptr: ptr, // optional in TS
    modelProvider_len: u64,
    serviceTier_ptr: ptr, // optional in TS
    serviceTier_len: u64,
    cwd_ptr: ptr, // optional in TS
    cwd_len: u64,
    approvalPolicy: AskForApproval, // optional in TS
    // Override where approval requests are routed for review on this thread
    // and subsequent turns.
    approvalsReviewer: ApprovalsReviewer, // optional in TS
    sandbox: SandboxMode, // optional in TS
    config: ThreadResumeParams_Config, // optional in TS
    baseInstructions_ptr: ptr, // optional in TS
    baseInstructions_len: u64,
    developerInstructions_ptr: ptr, // optional in TS
    developerInstructions_len: u64,
    personality: Personality, // optional in TS
}
