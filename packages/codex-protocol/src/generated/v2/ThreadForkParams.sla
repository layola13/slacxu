// Converted 1:1 from packages/codex-protocol/src/generated/v2/ThreadForkParams.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
// ts-rs generated protocol types. Conventions: string -> (ptr,len) pair;
// Array<T>/Record/unknown/union -> (ptr,len) JSON or slice buffer; number -> f64;
// string-literal union -> u64 tag (values in comments); optional -> plain field + note.
@import "../serde_json/JsonValue.sla"
@import "./ApprovalsReviewer.sla"
@import "./AskForApproval.sla"
@import "./SandboxMode.sla"
@import "./ThreadSource.sla"

// There are two ways to fork a thread:
// 1. By thread_id: load the thread from disk by thread_id and fork it into a new thread.
// 2. By path: load the thread from disk by path and fork it into a new thread.
//
// If using a non-empty path, the thread_id param will be ignored.
// Empty string path values are treated as absent.
//
// Prefer using thread_id whenever possible.
struct ThreadForkParams_Config {
    index_ptr: ptr, // DEFECT: TS index signature -> JSON text buffer
    index_len: u64,
}
struct ThreadForkParams {
    threadId_ptr: ptr,
    threadId_len: u64,
    // Optional last turn id to fork through, inclusive.
    //
    // When specified, turns after `last_turn_id` are omitted from the fork.
    // The referenced turn cannot be in progress.
    lastTurnId_ptr: ptr, // optional in TS
    lastTurnId_len: u64,
    // Configuration overrides for the forked thread, if any.
    model_ptr: ptr, // optional in TS
    model_len: u64,
    modelProvider_ptr: ptr, // optional in TS
    modelProvider_len: u64,
    serviceTier_ptr: ptr, // optional in TS
    serviceTier_len: u64,
    cwd_ptr: ptr, // optional in TS
    cwd_len: u64,
    approvalPolicy: AskForApproval, // optional in TS
    // Override where approval requests are routed for review on this thread
    // and subsequent turns.
    approvalsReviewer: ApprovalsReviewer, // optional in TS
    sandbox: SandboxMode, // optional in TS
    config: ThreadForkParams_Config, // optional in TS
    baseInstructions_ptr: ptr, // optional in TS
    baseInstructions_len: u64,
    developerInstructions_ptr: ptr, // optional in TS
    developerInstructions_len: u64,
    ephemeral: bool, // optional in TS
    // Optional client-supplied analytics source classification for this forked thread.
    threadSource: ThreadSource, // optional in TS
}
