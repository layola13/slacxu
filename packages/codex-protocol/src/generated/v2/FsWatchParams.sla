// Converted 1:1 from packages/codex-protocol/src/generated/v2/FsWatchParams.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
// ts-rs generated protocol types. Conventions: string -> (ptr,len) pair;
// Array<T>/Record/unknown/union -> (ptr,len) JSON or slice buffer; number -> f64;
// string-literal union -> u64 tag (values in comments); optional -> plain field + note.
@import "../AbsolutePathBuf.sla"

// Start filesystem watch notifications for an absolute path.
struct FsWatchParams {
    // Connection-scoped watch identifier used for `fs/unwatch` and `fs/changed`.
    watchId_ptr: ptr,
    watchId_len: u64,
    // Absolute file or directory path to watch.
    path: AbsolutePathBuf,
}
