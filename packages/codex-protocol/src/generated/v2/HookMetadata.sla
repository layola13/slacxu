// Converted 1:1 from packages/codex-protocol/src/generated/v2/HookMetadata.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
// ts-rs generated protocol types. Conventions: string -> (ptr,len) pair;
// Array<T>/Record/unknown/union -> (ptr,len) JSON or slice buffer; number -> f64;
// string-literal union -> u64 tag (values in comments); optional -> plain field + note.
@import "../AbsolutePathBuf.sla"
@import "./HookEventName.sla"
@import "./HookHandlerType.sla"
@import "./HookSource.sla"
@import "./HookTrustStatus.sla"

struct HookMetadata {
    key_ptr: ptr,
    key_len: u64,
    eventName: HookEventName,
    handlerType: HookHandlerType,
    matcher_ptr: ptr,
    matcher_len: u64,
    command_ptr: ptr,
    command_len: u64,
    timeoutSec: i64, // DEFECT: TS bigint -> i64 (range)
    statusMessage_ptr: ptr,
    statusMessage_len: u64,
    sourcePath: AbsolutePathBuf,
    source: HookSource,
    pluginId_ptr: ptr,
    pluginId_len: u64,
    displayOrder: i64, // DEFECT: TS bigint -> i64 (range)
    enabled: bool,
    isManaged: bool,
    currentHash_ptr: ptr,
    currentHash_len: u64,
    trustStatus: HookTrustStatus,
}
