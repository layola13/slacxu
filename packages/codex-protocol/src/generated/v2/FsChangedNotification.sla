// ts-rs generated protocol types. Conventions: string -> (ptr,len) pair;
// Array<T>/Record/unknown/union -> (ptr,len) JSON or slice buffer; number -> f64;
// string-literal union -> u64 tag (values in comments); optional -> plain field + note.
@import "../AbsolutePathBuf.sla"

// Filesystem watch notification emitted for `fs/watch` subscribers.
struct FsChangedNotification {
    // Watch identifier previously provided to `fs/watch`.
    watchId_ptr: ptr,
    watchId_len: u64,
    // File or directory paths associated with this event.
    changedPaths_ptr: ptr, // DEFECT: TS Array<AbsolutePathBuf> -> (ptr,len) slice
    changedPaths_len: u64,
}
