// Converted 1:1 from packages/codex-protocol/src/generated/v2/ProcessOutputDeltaNotification.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
// ts-rs generated protocol types. Conventions: string -> (ptr,len) pair;
// Array<T>/Record/unknown/union -> (ptr,len) JSON or slice buffer; number -> f64;
// string-literal union -> u64 tag (values in comments); optional -> plain field + note.
@import "./ProcessOutputStream.sla"

// Base64-encoded output chunk emitted for a streaming `process/spawn` request.
struct ProcessOutputDeltaNotification {
    // Client-supplied, connection-scoped `processHandle` from `process/spawn`.
    processHandle_ptr: ptr,
    processHandle_len: u64,
    // Output stream this chunk belongs to.
    stream: ProcessOutputStream,
    // Base64-encoded output bytes.
    deltaBase64_ptr: ptr,
    deltaBase64_len: u64,
    // True on the final streamed chunk for this stream when output was
    // truncated by `outputBytesCap`.
    capReached: bool,
}
