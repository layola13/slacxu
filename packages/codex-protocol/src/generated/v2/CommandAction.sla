// Converted 1:1 from packages/codex-protocol/src/generated/v2/CommandAction.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
// ts-rs generated protocol types. Conventions: string -> (ptr,len) pair;
// Array<T>/Record/unknown/union -> (ptr,len) JSON or slice buffer; number -> f64;
// string-literal union -> u64 tag (values in comments); optional -> plain field + note.
@import "../AbsolutePathBuf.sla"

struct CommandAction_Read {
    type: u64, // literal value: "read"
    command_ptr: ptr,
    command_len: u64,
    name_ptr: ptr,
    name_len: u64,
    path: AbsolutePathBuf,
}

struct CommandAction_ListFiles {
    type: u64, // literal value: "listFiles"
    command_ptr: ptr,
    command_len: u64,
    path_ptr: ptr,
    path_len: u64,
}

struct CommandAction_Search {
    type: u64, // literal value: "search"
    command_ptr: ptr,
    command_len: u64,
    query_ptr: ptr,
    query_len: u64,
    path_ptr: ptr,
    path_len: u64,
}

struct CommandAction_Unknown {
    type: u64, // literal value: "unknown"
    command_ptr: ptr,
    command_len: u64,
}

// DEFECT: tagged union CommandAction — variant selected by the
// "type" tag; payload approximated as JSON text.
struct CommandAction {
    variant: u64,
    payload_ptr: ptr,
    payload_len: u64,
}
