// Converted 1:1 from packages/codex-protocol/src/generated/v2/SkillMetadata.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
// ts-rs generated protocol types. Conventions: string -> (ptr,len) pair;
// Array<T>/Record/unknown/union -> (ptr,len) JSON or slice buffer; number -> f64;
// string-literal union -> u64 tag (values in comments); optional -> plain field + note.
@import "../AbsolutePathBuf.sla"
@import "./SkillDependencies.sla"
@import "./SkillInterface.sla"
@import "./SkillScope.sla"

struct SkillMetadata {
    name_ptr: ptr,
    name_len: u64,
    description_ptr: ptr,
    description_len: u64,
    // Legacy short_description from SKILL.md. Prefer SKILL.json interface.short_description.
    shortDescription_ptr: ptr, // optional in TS
    shortDescription_len: u64,
    interface: SkillInterface, // optional in TS
    dependencies: SkillDependencies, // optional in TS
    path: AbsolutePathBuf,
    scope: SkillScope,
    enabled: bool,
}
