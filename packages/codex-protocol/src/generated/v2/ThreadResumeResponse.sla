// Array<T>/Record/unknown/union -> (ptr,len) JSON or slice buffer; number -> f64;
// string-literal union -> u64 tag (values in comments); optional -> plain field + note.
@import "../AbsolutePathBuf.sla"
@import "../LegacyAppPathString.sla"
@import "../ReasoningEffort.sla"
@import "./ApprovalsReviewer.sla"
@import "./AskForApproval.sla"
@import "./SandboxPolicy.sla"
@import "./Thread.sla"

struct ThreadResumeResponse {
    thread: Thread,
    model_ptr: ptr,
    model_len: u64,
    modelProvider_ptr: ptr,
    modelProvider_len: u64,
    serviceTier_ptr: ptr,
    serviceTier_len: u64,
    cwd: AbsolutePathBuf,
    // Environment-native paths to instruction source files currently loaded for this thread.
    instructionSources_ptr: ptr, // DEFECT: TS Array<LegacyAppPathString> -> (ptr,len) slice
    instructionSources_len: u64,
    approvalPolicy: AskForApproval,
    // Reviewer currently used for approval requests on this thread.
    approvalsReviewer: ApprovalsReviewer,
    // Legacy sandbox policy retained for compatibility. Experimental clients
    // should prefer `activePermissionProfile` for profile provenance.
    sandbox: SandboxPolicy,
    reasoningEffort: ReasoningEffort,
}
