// Converted 1:1 from packages/codex-protocol/src/generated/v2/ExperimentalFeature.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
// ts-rs generated protocol types. Conventions: string -> (ptr,len) pair;
// Array<T>/Record/unknown/union -> (ptr,len) JSON or slice buffer; number -> f64;
// string-literal union -> u64 tag (values in comments); optional -> plain field + note.
@import "./ExperimentalFeatureStage.sla"

struct ExperimentalFeature {
    // Stable key used in config.toml and CLI flag toggles.
    name_ptr: ptr,
    name_len: u64,
    // Lifecycle stage of this feature flag.
    stage: ExperimentalFeatureStage,
    // User-facing display name shown in the experimental features UI.
    // Null when this feature is not in beta.
    displayName_ptr: ptr,
    displayName_len: u64,
    // Short summary describing what the feature does.
    // Null when this feature is not in beta.
    description_ptr: ptr,
    description_len: u64,
    // Announcement copy shown to users when the feature is introduced.
    // Null when this feature is not in beta.
    announcement_ptr: ptr,
    announcement_len: u64,
    // Whether this feature is currently enabled in the loaded config.
    enabled: bool,
    // Whether this feature is enabled by default.
    defaultEnabled: bool,
}
