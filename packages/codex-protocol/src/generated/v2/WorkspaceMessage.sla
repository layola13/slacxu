// Converted 1:1 from packages/codex-protocol/src/generated/v2/WorkspaceMessage.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
// ts-rs generated protocol types. Conventions: string -> (ptr,len) pair;
// Array<T>/Record/unknown/union -> (ptr,len) JSON or slice buffer; number -> f64;
// string-literal union -> u64 tag (values in comments); optional -> plain field + note.
@import "./WorkspaceMessageType.sla"

struct WorkspaceMessage {
    messageId_ptr: ptr,
    messageId_len: u64,
    messageType: WorkspaceMessageType,
    messageBody_ptr: ptr,
    messageBody_len: u64,
    // Unix timestamp (in seconds) when the message was created.
    createdAt: f64,
    // Unix timestamp (in seconds) when the message was archived.
    archivedAt: f64,
}
