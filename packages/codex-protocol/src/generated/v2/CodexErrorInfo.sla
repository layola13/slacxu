// Converted 1:1 from packages/codex-protocol/src/generated/v2/CodexErrorInfo.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
// ts-rs generated protocol types. Conventions: string -> (ptr,len) pair;
// Array<T>/Record/unknown/union -> (ptr,len) JSON or slice buffer; number -> f64;
// string-literal union -> u64 tag (values in comments); optional -> plain field + note.
@import "./NonSteerableTurnKind.sla"

// This translation layer make sure that we expose codex error code in camel case.
//
// When an upstream HTTP status is available (for example, from the Responses API or a provider),
// it is forwarded in `httpStatusCode` on the relevant `codexErrorInfo` variant.
// DEFECT: TS union type has no SLA union; held as JSON text.
struct CodexErrorInfo {
    json_ptr: ptr,
    json_len: u64,
}
