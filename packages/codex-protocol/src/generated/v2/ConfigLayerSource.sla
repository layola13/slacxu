// Converted 1:1 from packages/codex-protocol/src/generated/v2/ConfigLayerSource.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
// ts-rs generated protocol types. Conventions: string -> (ptr,len) pair;
// Array<T>/Record/unknown/union -> (ptr,len) JSON or slice buffer; number -> f64;
// string-literal union -> u64 tag (values in comments); optional -> plain field + note.
@import "../AbsolutePathBuf.sla"

struct ConfigLayerSource_Mdm {
    type_: u64, // literal value: "mdm"
    domain_ptr: ptr,
    domain_len: u64,
    key_ptr: ptr,
    key_len: u64,
}

struct ConfigLayerSource_System {
    type_: u64, // literal value: "system"
    // This is the path to the system config.toml file, though it is not
    // guaranteed to exist.
    file: AbsolutePathBuf,
}

struct ConfigLayerSource_EnterpriseManaged {
    type_: u64, // literal value: "enterpriseManaged"
    // Stable identifier for the delivered layer.
    id_ptr: ptr,
    id_len: u64,
    // Admin-facing name for the delivered layer. This is surfaced in
    // diagnostics so users know which cloud layer needs administrator
    // attention.
    name_ptr: ptr,
    name_len: u64,
}

struct ConfigLayerSource_User {
    type_: u64, // literal value: "user"
    // This is the path to the user's config.toml file, though it is not
    // guaranteed to exist.
    file: AbsolutePathBuf,
    // Name of the selected profile-v2 config layered on top of the base
    // user config, when this layer represents one.
    profile_ptr: ptr,
    profile_len: u64,
}

struct ConfigLayerSource_Project {
    type_: u64, // literal value: "project"
    dotCodexFolder: AbsolutePathBuf,
}

struct ConfigLayerSource_SessionFlags {
    type_: u64, // literal value: "sessionFlags"
}

struct ConfigLayerSource_LegacyManagedConfigTomlFromFile {
    type_: u64, // literal value: "legacyManagedConfigTomlFromFile"
    file: AbsolutePathBuf,
}

struct ConfigLayerSource_LegacyManagedConfigTomlFromMdm {
    type_: u64, // literal value: "legacyManagedConfigTomlFromMdm"
}

// DEFECT: tagged union ConfigLayerSource — variant selected by the
// "type" tag; payload approximated as JSON text.
struct ConfigLayerSource {
    variant: u64,
    payload_ptr: ptr,
    payload_len: u64,
}
