// Converted 1:1 from packages/codex-protocol/src/generated/v2/AccountRateLimitsUpdatedNotification.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
// ts-rs generated protocol types. Conventions: string -> (ptr,len) pair;
// Array<T>/Record/unknown/union -> (ptr,len) JSON or slice buffer; number -> f64;
// string-literal union -> u64 tag (values in comments); optional -> plain field + note.
@import "./RateLimitSnapshot.sla"

// Sparse rolling rate-limit update.
//
// Clients should merge available values into the most recent `account/rateLimits/read` response
// or refetch that snapshot. Nullable account metadata may be unavailable in a rolling update and
// does not clear a previously observed value.
struct AccountRateLimitsUpdatedNotification {
    rateLimits: RateLimitSnapshot,
}
