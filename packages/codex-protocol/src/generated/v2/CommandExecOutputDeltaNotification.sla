// Converted 1:1 from packages/codex-protocol/src/generated/v2/CommandExecOutputDeltaNotification.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
// ts-rs generated protocol types. Conventions: string -> (ptr,len) pair;
// Array<T>/Record/unknown/union -> (ptr,len) JSON or slice buffer; number -> f64;
// string-literal union -> u64 tag (values in comments); optional -> plain field + note.
@import "./CommandExecOutputStream.sla"

// Base64-encoded output chunk emitted for a streaming `command/exec` request.
//
// These notifications are connection-scoped. If the originating connection
// closes, the server terminates the process.
struct CommandExecOutputDeltaNotification {
    // Client-supplied, connection-scoped `processId` from the original
    // `command/exec` request.
    processId_ptr: ptr,
    processId_len: u64,
    // Output stream for this chunk.
    stream: CommandExecOutputStream,
    // Base64-encoded output bytes.
    deltaBase64_ptr: ptr,
    deltaBase64_len: u64,
    // `true` on the final streamed chunk for a stream when `outputBytesCap`
    // truncated later output on that stream.
    capReached: bool,
}
