// Converted 1:1 from packages/codex-protocol/src/generated/v2/Thread.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
// ts-rs generated protocol types. Conventions: string -> (ptr,len) pair;
// Array<T>/Record/unknown/union -> (ptr,len) JSON or slice buffer; number -> f64;
// string-literal union -> u64 tag (values in comments); optional -> plain field + note.
@import "../AbsolutePathBuf.sla"
@import "./GitInfo.sla"
@import "./SessionSource.sla"
@import "./ThreadSource.sla"
@import "./ThreadStatus.sla"
@import "./Turn.sla"

struct Thread {
    // Identifier for this thread. Codex-generated thread IDs are UUIDv7.
    id_ptr: ptr,
    id_len: u64,
    // Session id shared by threads that belong to the same session tree.
    sessionId_ptr: ptr,
    sessionId_len: u64,
    // Source thread id when this thread was created by forking another thread.
    forkedFromId_ptr: ptr,
    forkedFromId_len: u64,
    // The ID of the parent thread. This will only be set if this thread is a subagent.
    parentThreadId_ptr: ptr,
    parentThreadId_len: u64,
    // Usually the first user message in the thread, if available.
    preview_ptr: ptr,
    preview_len: u64,
    // Whether the thread is ephemeral and should not be materialized on disk.
    ephemeral: bool,
    // Model provider used for this thread (for example, 'openai').
    modelProvider_ptr: ptr,
    modelProvider_len: u64,
    // Unix timestamp (in seconds) when the thread was created.
    createdAt: f64,
    // Unix timestamp (in seconds) when the thread was last updated.
    updatedAt: f64,
    // Unix timestamp (in seconds) used for thread recency ordering.
    recencyAt: f64,
    // Current runtime status for the thread.
    status: ThreadStatus,
    // [UNSTABLE] Path to the thread on disk.
    path_ptr: ptr,
    path_len: u64,
    // Working directory captured for the thread.
    cwd: AbsolutePathBuf,
    // Version of the CLI that created the thread.
    cliVersion_ptr: ptr,
    cliVersion_len: u64,
    // Origin of the thread (CLI, VSCode, codex exec, codex app-server, etc.).
    source: SessionSourceV2,
    // Optional analytics source classification for this thread.
    threadSource: ThreadSource,
    // Optional random unique nickname assigned to an AgentControl-spawned sub-agent.
    agentNickname_ptr: ptr,
    agentNickname_len: u64,
    // Optional role (agent_role) assigned to an AgentControl-spawned sub-agent.
    agentRole_ptr: ptr,
    agentRole_len: u64,
    // Optional Git metadata captured when the thread was created.
    gitInfo: GitInfo,
    // Optional user-facing thread title.
    name_ptr: ptr,
    name_len: u64,
    // Only populated on `thread/resume`, `thread/rollback`, `thread/fork`, and `thread/read`
    // (when `includeTurns` is true) responses.
    // For all other responses and notifications returning a Thread,
    // the turns field will be an empty list.
    turns_ptr: ptr, // DEFECT: TS Array<Turn> -> (ptr,len) slice
    turns_len: u64,
}
