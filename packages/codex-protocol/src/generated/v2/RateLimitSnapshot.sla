// Converted 1:1 from packages/codex-protocol/src/generated/v2/RateLimitSnapshot.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
// ts-rs generated protocol types. Conventions: string -> (ptr,len) pair;
// Array<T>/Record/unknown/union -> (ptr,len) JSON or slice buffer; number -> f64;
// string-literal union -> u64 tag (values in comments); optional -> plain field + note.
@import "../PlanType.sla"
@import "./CreditsSnapshot.sla"
@import "./RateLimitReachedType.sla"
@import "./RateLimitWindow.sla"
@import "./SpendControlLimitSnapshot.sla"

struct RateLimitSnapshot {
    limitId_ptr: ptr,
    limitId_len: u64,
    limitName_ptr: ptr,
    limitName_len: u64,
    primary: RateLimitWindow,
    secondary: RateLimitWindow,
    credits: CreditsSnapshot,
    individualLimit: SpendControlLimitSnapshot,
    // Backend-reported spend-control state. `None` is unavailable, not a sparse-update recovery.
    spendControlReached: bool,
    planType: PlanType,
    rateLimitReachedType: RateLimitReachedType,
}
