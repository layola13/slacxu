// Array<T>/Record/unknown/union -> (ptr,len) JSON or slice buffer; number -> f64;
// string-literal union -> u64 tag (values in comments); optional -> plain field + note.
@import "../Personality.sla"
@import "../ReasoningEffort.sla"
@import "../ReasoningSummary.sla"
@import "../serde_json/JsonValue.sla"
@import "./ApprovalsReviewer.sla"
@import "./AskForApproval.sla"
@import "./SandboxPolicy.sla"
@import "./UserInput.sla"

struct TurnStartParams {
    threadId_ptr: ptr,
    threadId_len: u64,
    clientUserMessageId_ptr: ptr, // optional in TS
    clientUserMessageId_len: u64,
    input_ptr: ptr, // DEFECT: TS Array<UserInput> -> (ptr,len) slice
    input_len: u64,
    // Override the working directory for this turn and subsequent turns.
    cwd_ptr: ptr, // optional in TS
    cwd_len: u64,
    // Override the approval policy for this turn and subsequent turns.
    approvalPolicy: AskForApproval, // optional in TS
    // Override where approval requests are routed for review on this turn and
    // subsequent turns.
    approvalsReviewer: ApprovalsReviewer, // optional in TS
    // Override the sandbox policy for this turn and subsequent turns.
    sandboxPolicy: SandboxPolicy, // optional in TS
    // Override the model for this turn and subsequent turns.
    model_ptr: ptr, // optional in TS
    model_len: u64,
    // Override the service tier for this turn and subsequent turns.
    serviceTier_ptr: ptr, // optional in TS
    serviceTier_len: u64,
    // Override the reasoning effort for this turn and subsequent turns.
    effort: ReasoningEffort, // optional in TS
    // Override the reasoning summary for this turn and subsequent turns.
    summary: ReasoningSummary, // optional in TS
    // Override the personality for this turn and subsequent turns.
    personality: Personality, // optional in TS
    // Optional JSON Schema used to constrain the final assistant message for
    // this turn.
    outputSchema: JsonValue, // optional in TS
}
