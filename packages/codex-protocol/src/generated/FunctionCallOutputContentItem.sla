// Converted 1:1 from packages/codex-protocol/src/generated/FunctionCallOutputContentItem.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
// ts-rs generated protocol types. Conventions: string -> (ptr,len) pair;
// Array<T>/Record/unknown/union -> (ptr,len) JSON or slice buffer; number -> f64;
// string-literal union -> u64 tag (values in comments); optional -> plain field + note.
@import "./ImageDetail.sla"

// Responses API compatible content items that can be returned by a tool call.
// This is a subset of ContentItem with the types we support as function call outputs.
struct FunctionCallOutputContentItem_Input_text {
    type_: u64, // literal value: "input_text"
    text_ptr: ptr,
    text_len: u64,
}

struct FunctionCallOutputContentItem_Input_image {
    type_: u64, // literal value: "input_image"
    image_url_ptr: ptr,
    image_url_len: u64,
    detail: ImageDetail, // optional in TS
}

struct FunctionCallOutputContentItem_Encrypted_content {
    type_: u64, // literal value: "encrypted_content"
    encrypted_content_ptr: ptr,
    encrypted_content_len: u64,
}

// DEFECT: tagged union FunctionCallOutputContentItem — variant selected by the
// "type" tag; payload approximated as JSON text.
struct FunctionCallOutputContentItem {
    variant: u64,
    payload_ptr: ptr,
    payload_len: u64,
}
