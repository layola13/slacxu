// Converted 1:1 from sdk-backend/src/systemWebSearch.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
// System web search is a bounded product capability, not an arbitrary model URL request.

// DEFECT: RegExp /\b(?:web\s+search|search|browser|bing|google|duckduckgo)\b/i
// has no sa_std regex engine; approximated with case-insensitive
// substring scans (word-boundary semantics lost).
fn isSystemWebSearchPermissionRequest(details_ptr: ptr, details_len: u64) -> bool {
    if contains_word_ci(details_ptr, details_len, STR_PTR("web search"), STR_LEN("web search")) { return true; };
    if contains_word_ci(details_ptr, details_len, STR_PTR("search"), STR_LEN("search")) { return true; };
    if contains_word_ci(details_ptr, details_len, STR_PTR("browser"), STR_LEN("browser")) { return true; };
    if contains_word_ci(details_ptr, details_len, STR_PTR("bing"), STR_LEN("bing")) { return true; };
    if contains_word_ci(details_ptr, details_len, STR_PTR("google"), STR_LEN("google")) { return true; };
    if contains_word_ci(details_ptr, details_len, STR_PTR("duckduckgo"), STR_LEN("duckduckgo")) { return true; };
    return false;
}

// DEFECT: helper not present in the TS source (inlined regex there);
// case-insensitive substring search used as the approximation.
fn contains_word_ci(hay_ptr: ptr, hay_len: u64, nd_ptr: ptr, nd_len: u64) -> bool {
    if nd_len == 0 || hay_len < nd_len { return false; };
    let last = hay_len - nd_len;
    let i: u64 = 0;
    while i <= last {
        let ok = true;
        let j: u64 = 0;
        while j < nd_len {
            let a: u8 = 0;
            let b: u8 = 0;
            PTR_BYTE_AT(a, hay_ptr, i + j);
            PTR_BYTE_AT(b, nd_ptr, j);
            if a >= 65 && a <= 90 { a = a + 32; };
            if b >= 65 && b <= 90 { b = b + 32; };
            if a != b { ok = false; break; };
            j = j + 1;
        }
        if ok { return true; };
        i = i + 1;
    }
    return false;
}
