// Converted 1:1 from sdk-backend/src/runtimeClient.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
//
// The runtime-client contract every backend engine implements.
//
// Historically defined in the host's daemonCodexBridge.ts (hence the
// name) and implemented by ALL bridges — daemon Codex, the compatible
// CLI runtimes, SSH/remote variants, Mini and OpencodeBridge alike.
// It is a shared contract, so it lives in the SDK: plugins implement
// it, the host consumes engines through it, and no plugin ever imports
// another plugin (or a host file) just for this type.

// DEFECT: TS interface extending node:events EventEmitter has no SLA
// interface mechanism; the contract is recorded as a function-pointer
// table struct (typed fields, fix phase — see below).
// EngineStatus / JsonRpcId / JsonValue / JsonRpcFailure come from
// @codex-ui/shared (dynamic JSON) -> JSON text buffers here.
// DEFECT: dynamic JSON values (JsonValue) -> JSON text buffer.
// DEFECT: EventEmitter on/emit listener registry has no counterpart
// (CAPABILITY_MAP §2: confirmed unsupported); listener storage lives
// in the implementing bridge, only its state handle is carried here.
//
// CALLING CONVENTION (fix phase): every method fn takes `ctx`
// first — the table's own emitter_state value, an opaque
// implementer-owned state handle (typically the bridge state
// pointer as u64). A raw ptr field cannot be called in SLA
// (probe: TypeMismatch); fields are typed fn pointers, loaded into
// a local before calling (probe: direct field call is Undefined).
// ASYNC (ASYNC_MODEL R1/R2/R7): Promise-returning methods return
// future<i32> (0 = ok, else domain status); callers `.await` inside
// an async fn or drive with task::new/task::poll at a sync
// boundary. EngineStatus results are written as JSON text into the
// caller's out buffer (out_cap in, &out_len out).
struct CodexRuntimeClient {
    // getStatus(): EngineStatus (sync; writes status JSON text)
    getStatus: fn(u64, ptr, u64, &u64) -> i32,
    // start(): Promise<EngineStatus> (status JSON text via out)
    start: fn(u64, ptr, u64, &u64) -> future<i32>,
    // stop(): void
    stop: fn(u64) -> void,
    // restart(): Promise<EngineStatus> (status JSON text via out)
    restart: fn(u64, ptr, u64, &u64) -> future<i32>,
    // request(method: string, params?: JsonValue, timeoutMs?: number): Promise<JsonValue>
    // -> (ctx, method_ptr, method_len, params_ptr, params_len,
    //     timeout_ms (0 = none), out_ptr, out_cap, &out_len);
    // params/result as JSON text, params_len 0 = no params.
    request: fn(u64, ptr, u64, ptr, u64, u64, ptr, u64, &u64) -> future<i32>,
    // notify(method: string, params?: JsonValue): Promise<void>
    // -> (ctx, method_ptr, method_len, params_ptr, params_len)
    notify: fn(u64, ptr, u64, ptr, u64) -> future<i32>,
    // respond(id: JsonRpcId, result?: JsonValue, error?: JsonRpcFailure["error"]): void
    // -> (ctx, id_ptr, id_len, result_ptr, result_len, error_ptr,
    //     error_len); id/result/error as JSON text, len 0 = absent.
    respond: fn(u64, ptr, u64, ptr, u64, ptr, u64) -> void,
    // Implementer-owned state handle (EventEmitter listener storage
    // + bridge state); passed as ctx to every method fn above.
    emitter_state: u64,
}

// ---- call helpers -------------------------------------------------
// Probed checker restriction (fix phase): at a call through an
// fn-typed value, a reference argument must be a reference the
// caller itself received as a parameter, passed verbatim —
// &local and &struct.field do not typecheck there. These helpers
// are ordinary fns: callers hand them their out slots (ordinary
// calls accept &local / &field), and each helper forwards its own
// parameters into the table call. Async helpers return the future;
// await it or drive it at the call site (ASYNC_MODEL R7).
fn rcGetStatus(c: &CodexRuntimeClient, out_ptr: ptr, out_cap: u64, out_len: &u64) -> i32 {
    let f = c.getStatus;
    return f(c.emitter_state, out_ptr, out_cap, out_len);
}

fn rcStart(c: &CodexRuntimeClient, out_ptr: ptr, out_cap: u64, out_len: &u64) -> future<i32> {
    let f = c.start;
    return f(c.emitter_state, out_ptr, out_cap, out_len);
}

fn rcRestart(c: &CodexRuntimeClient, out_ptr: ptr, out_cap: u64, out_len: &u64) -> future<i32> {
    let f = c.restart;
    return f(c.emitter_state, out_ptr, out_cap, out_len);
}

fn rcRequest(c: &CodexRuntimeClient, method_ptr: ptr, method_len: u64, params_ptr: ptr, params_len: u64, timeout_ms: u64, out_ptr: ptr, out_cap: u64, out_len: &u64) -> future<i32> {
    let f = c.request;
    return f(c.emitter_state, method_ptr, method_len, params_ptr, params_len, timeout_ms, out_ptr, out_cap, out_len);
}

fn rcNotify(c: &CodexRuntimeClient, method_ptr: ptr, method_len: u64, params_ptr: ptr, params_len: u64) -> future<i32> {
    let f = c.notify;
    return f(c.emitter_state, method_ptr, method_len, params_ptr, params_len);
}

fn rcRespond(c: &CodexRuntimeClient, id_ptr: ptr, id_len: u64, result_ptr: ptr, result_len: u64, error_ptr: ptr, error_len: u64) -> void {
    let f = c.respond;
    f(c.emitter_state, id_ptr, id_len, result_ptr, result_len, error_ptr, error_len);
}
