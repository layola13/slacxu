// Converted 1:1 from sdk-backend/src/runtimeClient.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
//
// The runtime-client contract every backend engine implements.
//
// Historically defined in the host's daemonCodexBridge.ts (hence the
// name) and implemented by ALL bridges — daemon Codex, the compatible
// CLI runtimes, SSH/remote variants, Mini and OpencodeBridge alike.
// It is a shared contract, so it lives in the SDK: plugins implement
// it, the host consumes engines through it, and no plugin ever imports
// another plugin (or a host file) just for this type.

// DEFECT: TS interface extending node:events EventEmitter with
// Promise-returning methods has no SLA interface mechanism; the
// contract is recorded as a function-pointer table struct.
// EngineStatus / JsonRpcId / JsonValue / JsonRpcFailure come from
// @codex-ui/shared (dynamic JSON) -> JSON text buffers here.
// DEFECT: dynamic JSON values (JsonValue) -> JSON text buffer.
struct CodexRuntimeClient {
    // getStatus(): EngineStatus
    getStatus: ptr,
    // start(): Promise<EngineStatus>  // DEFECT: async
    start: ptr,
    // stop(): void
    stop: ptr,
    // restart(): Promise<EngineStatus>  // DEFECT: async
    restart: ptr,
    // request(method: string, params?: JsonValue, timeoutMs?: number): Promise<JsonValue>  // DEFECT: async
    request: ptr,
    // notify(method: string, params?: JsonValue): Promise<void>  // DEFECT: async
    notify: ptr,
    // respond(id: JsonRpcId, result?: JsonValue, error?: JsonRpcFailure["error"]): void
    respond: ptr,
    // DEFECT: EventEmitter on/emit listener registry has no counterpart;
    // listener storage would live in the implementing bridge.
    emitter_state: u64,
}
