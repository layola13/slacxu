//   * \`zig version\` -> \`sa_vm_run({ action: 'run_host', exe: 'zig', args: ['version'] })\`
//   * \`bun test --filter pat | findstr FAIL\` -> \`sa_vm_run({ action: 'run_host', exe: 'bun', args: ['test', '--filter', 'pat'], filter: 'FAIL' })\`
