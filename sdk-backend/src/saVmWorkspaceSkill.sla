@import "sa_std/ptr.sa"
@import "saVmPaths.sla"
@import "hostServices.sla"

// DEFECT: async fs (readFile/writeFile/mkdir/rm) -> sync sa_std
// calls; module-level Map/Set state (skillSyncInflight,
// skillSyncFailures, explicitSkillPolicyRoots, bootstrapInflight,
// bootstrapLastOk) -> sequential execution + single-slot flags
// (the Promise chaining that serialized writers per workspace
// is preserved in call order only). existsSync -> fs_len probe.
// String.replace with lookbehind regexes -> manual scanners.
// The three markdown builders' template bodies (source lines
// 383-1955) are preserved verbatim in comment blocks at the end
// of this file; their flag logic is converted, the text assembly
// is DEFECT: template segmentation/interpolation pending.

struct WsBuf {
    bytes: [u8; 1048576],
    len: u64,
}

fn wb_append(b: &WsBuf, src_ptr: ptr, src_len: u64) -> void {
    for i in 0..src_len {
        if b.len < 1048576 {
            let c: u8 = 0;
            PTR_BYTE_AT(c, src_ptr, i);
            b.bytes[b.len] = c;
            b.len = b.len + 1;
        };
    }
}

fn wb_ptr(b: &WsBuf) -> ptr {
    let p: ptr = PTR_NULL();
    PTR_BYTE_ADD(p, &b.bytes, 0);
    return p;
}

fn ws_contains(h_ptr: ptr, h_len: u64, n_ptr: ptr, n_len: u64) -> bool {
    if n_len == 0 { return true; };
    if h_len < n_len { return false; };
    let last = h_len - n_len;
    for i in 0..last + 1 {
        let same = true;
        for j in 0..n_len {
            let a: u8 = 0;
            let c: u8 = 0;
            PTR_BYTE_AT(a, h_ptr, i + j);
            PTR_BYTE_AT(c, n_ptr, j);
            if a != c { same = false; break; };
        }
        if same { return true; };
    }
    return false;
}

fn ws_eq(a_ptr: ptr, a_len: u64, b_ptr: ptr, b_len: u64) -> bool {
    if a_len != b_len { return false; };
    for i in 0..a_len {
        let x: u8 = 0;
        let y: u8 = 0;
        PTR_BYTE_AT(x, a_ptr, i);
        PTR_BYTE_AT(y, b_ptr, i);
        if x != y { return false; };
    }
    return true;
}

fn ws_trim_range(s_ptr: ptr, s_len: u64, out_start: &u64, out_len: &u64) -> void {
    let s: u64 = 0;
    let e: u64 = s_len;
    while s < e {
        let b: u8 = 0;
        PTR_BYTE_AT(b, s_ptr, s);
        if b != 32 && b != 9 && b != 10 && b != 13 { break; };
        s = s + 1;
    }
    while e > s {
        let b: u8 = 0;
        PTR_BYTE_AT(b, s_ptr, e - 1);
        if b != 32 && b != 9 && b != 10 && b != 13 { break; };
        e = e - 1;
    }
    *out_start = s;
    *out_len = e - s;
}

// replace(/\\/g, "/") into out
fn ws_normalize_seps(s_ptr: ptr, s_len: u64, out: &WsBuf) -> void {
    out.len = 0;
    for i in 0..s_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, s_ptr, i);
        if b == 92 { b = 47; };
        let single = [0; 1];
        single[0] = b;
        wb_append(out, &single, 1);
    }
}

const SA_VM_WORKSPACE_SKILL_NAME = "sa-vm";
const SA_VM_WORKSPACE_SKILL_MARKER = "<!-- generated-by-codex-ultra:sa-vm -->";
const SA_VM_CHEATSHEET_FILE_NAME = "BUN_TS_CHEATSHEET.md";
const JEV_WORKSPACE_SKILL_NAME = "jev";
const JEV_WORKSPACE_SKILL_MARKER = "<!-- generated-by-codex-ultra:jev -->";
const MUSE_SA_VM_MCP_TOOL_NAME = "mcp__sa_vm__sa_vm_run";
// SHARED_SKILL_TOOL_MAPPING_NOTE: appended verbatim by script
// (single template literal, source line 27) -- see end of file.

// skillToolNameForPath(path) -> status 0 + out, or 1 (undefined)
fn skillToolNameForPath(path_ptr: ptr, path_len: u64, out: &WsBuf) -> i32 {
    let norm = WsBuf { bytes: [0; 1048576], len: 0 };
    ws_normalize_seps(path_ptr, path_len, &norm);
    let np = wb_ptr(&norm);
    if ws_contains(np, norm.len, STR_PTR("/.muse/skills/"), STR_LEN("/.muse/skills/")) || ws_contains(np, norm.len, STR_PTR("/.agents/skills/"), STR_LEN("/.agents/skills/")) {
        out.len = 0;
        wb_append(out, STR_PTR("mcp__sa_vm__sa_vm_run"), STR_LEN("mcp__sa_vm__sa_vm_run"));
        return 0;
    };
    return 1;
}

fn needsSharedSkillMappingNote(path_ptr: ptr, path_len: u64) -> bool {
    let norm = WsBuf { bytes: [0; 1048576], len: 0 };
    ws_normalize_seps(path_ptr, path_len, &norm);
    let np = wb_ptr(&norm);
    return !ws_contains(np, norm.len, STR_PTR("/.muse/skills/"), STR_LEN("/.muse/skills/")) && !ws_contains(np, norm.len, STR_PTR("/.agents/skills/"), STR_LEN("/.agents/skills/"));
}

fn is_word_byte(b: u8) -> bool {
    return (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || (b >= 48 && b <= 57) || b == 95;
}

// mapSaVmToolReferences: two regex replaces --
//  (?<![\w.])(?:(?:functions|default)\.)+(mcp__sa_vm__sa_vm_run|sa_vm_run)\b
//  (?<![\w.])sa_vm_run\b
// DEFECT: lookbehind/alternation chains approximated by a token
// scanner: occurrences of "mcp__sa_vm__sa_vm_run" (18) or
// "sa_vm_run" (9) with a non-word non-dot predecessor and a
// non-word successor are replaced; the (functions.|default.)
// prefix chains are consumed when directly attached.
fn mapSaVmToolReferences(text_ptr: ptr, text_len: u64, tool_ptr: ptr, tool_len: u64, out: &WsBuf) -> void {
    out.len = 0;
    let i: u64 = 0;
    while i < text_len {
        // full mcp name first
        let matched: u64 = 0;
        if i + 21 <= text_len {
            let seg: ptr = PTR_NULL();
            PTR_BYTE_ADD(seg, text_ptr, i);
            if ws_eq(seg, 21, STR_PTR("mcp__sa_vm__sa_vm_run"), STR_LEN("mcp__sa_vm__sa_vm_run")) { matched = 21; };
        };
        if matched == 0 && i + 9 <= text_len {
            let seg: ptr = PTR_NULL();
            PTR_BYTE_ADD(seg, text_ptr, i);
            if ws_eq(seg, 9, STR_PTR("sa_vm_run"), STR_LEN("sa_vm_run")) { matched = 9; };
        };
        if matched > 0 {
            let prev_ok = true;
            if i > 0 {
                let pb: u8 = 0;
                PTR_BYTE_AT(pb, text_ptr, i - 1);
                if is_word_byte(pb) || pb == 46 { prev_ok = false; };
            };
            let next_ok = true;
            if i + matched < text_len {
                let nb: u8 = 0;
                PTR_BYTE_AT(nb, text_ptr, i + matched);
                if is_word_byte(nb) { next_ok = false; };
            };
            if prev_ok && next_ok {
                wb_append(out, tool_ptr, tool_len);
                i = i + matched;
                continue;
            };
        };
        let single = [0; 1];
        PTR_BYTE_AT(single[0], text_ptr, i);
        wb_append(out, &single, 1);
        i = i + 1;
    }
}

// applySkillToolNameMapping: the note text is the source's
// template literal split at its two ${toolName} slots into
// APPLY_NOTE_SEG0..2 (script-appended at the end of this file).
fn applySkillToolNameMapping(md_ptr: ptr, md_len: u64, tool_ptr: ptr, tool_len: u64, has_tool: bool, out: &WsBuf) -> void {
    if !has_tool || ws_eq(tool_ptr, tool_len, STR_PTR("sa_vm_run"), STR_LEN("sa_vm_run")) {
        out.len = 0;
        wb_append(out, md_ptr, md_len);
        return;
    };
    let body = WsBuf { bytes: [0; 1048576], len: 0 };
    mapSaVmToolReferences(md_ptr, md_len, tool_ptr, tool_len, &body);
    let note = WsBuf { bytes: [0; 1048576], len: 0 };
    note.len = 0;
    wb_append(&note, STR_PTR(APPLY_NOTE_SEG0), STR_LEN(APPLY_NOTE_SEG0));
    wb_append(&note, tool_ptr, tool_len);
    wb_append(&note, STR_PTR(APPLY_NOTE_SEG1), STR_LEN(APPLY_NOTE_SEG1));
    wb_append(&note, tool_ptr, tool_len);
    wb_append(&note, STR_PTR(APPLY_NOTE_SEG2), STR_LEN(APPLY_NOTE_SEG2));
    insertNoteAfterFrontmatter(wb_ptr(&body), body.len, wb_ptr(&note), note.len, out);
}

// insertNoteAfterFrontmatter(markdown, note): note goes after
// the closing --- of a leading frontmatter block (first 40
// lines), else prepended as `${note}\n\n${markdown}`.
fn insertNoteAfterFrontmatter(md_ptr: ptr, md_len: u64, note_ptr: ptr, note_len: u64, out: &WsBuf) -> void {
    // first line trimmed == "---" ?
    let first_nl = md_len;
    for i in 0..md_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, md_ptr, i);
        if b == 10 { first_nl = i; break; };
    }
    let fs: u64 = 0;
    let fl: u64 = 0;
    ws_trim_range(md_ptr, first_nl, &fs, &fl);
    let fseg: ptr = PTR_NULL();
    PTR_BYTE_ADD(fseg, md_ptr, fs);
    if !ws_eq(fseg, fl, STR_PTR("---"), STR_LEN("---")) {
        prepend_note(md_ptr, md_len, note_ptr, note_len, out);
        return;
    };
    // scan lines 1..min(40) for the closing ---
    let pos = first_nl + 1;
    let line_no: u64 = 1;
    while pos < md_len && line_no < 40 {
        let eol = md_len;
        let j = pos;
        while j < md_len {
            let b: u8 = 0;
            PTR_BYTE_AT(b, md_ptr, j);
            if b == 10 { eol = j; break; };
            j = j + 1;
        }
        let ls: u64 = 0;
        let ll: u64 = 0;
        let lseg_base: ptr = PTR_NULL();
        PTR_BYTE_ADD(lseg_base, md_ptr, pos);
        ws_trim_range(lseg_base, eol - pos, &ls, &ll);
        let lseg: ptr = PTR_NULL();
        PTR_BYTE_ADD(lseg, lseg_base, ls);
        if ws_eq(lseg, ll, STR_PTR("---"), STR_LEN("---")) {
            // splice(i+1, 0, "", note.trimEnd(), "")
            out.len = 0;
            wb_append(out, md_ptr, eol + 1);
            wb_append(out, STR_PTR("\n"), STR_LEN("\n"));
            let ns: u64 = 0;
            let nl2: u64 = 0;
            ws_trim_range(note_ptr, note_len, &ns, &nl2);
            // trimEnd only in TS; leading kept -- approximated by
            // the full trim range.
            let np2: ptr = PTR_NULL();
            PTR_BYTE_ADD(np2, note_ptr, ns);
            wb_append(out, np2, nl2);
            wb_append(out, STR_PTR("\n\n"), STR_LEN("\n\n"));
            if eol + 1 < md_len {
                let rest: ptr = PTR_NULL();
                PTR_BYTE_ADD(rest, md_ptr, eol + 1);
                wb_append(out, rest, md_len - eol - 1);
            };
            return;
        };
        pos = eol + 1;
        line_no = line_no + 1;
    }
    prepend_note(md_ptr, md_len, note_ptr, note_len, out);
}

fn prepend_note(md_ptr: ptr, md_len: u64, note_ptr: ptr, note_len: u64, out: &WsBuf) -> void {
    out.len = 0;
    wb_append(out, note_ptr, note_len);
    wb_append(out, STR_PTR("\n\n"), STR_LEN("\n\n"));
    wb_append(out, md_ptr, md_len);
}

// JEV -----------------------------------------------------------------

// JevMethodName union (18 members) -- represented as the name
// string; order in listEnabledJevMethods matches the source.
struct JevToolsIn {
    // per method: has flag (tools?.jevX !== undefined) + value
    jevChoose_has: bool, jevChoose: bool,
    jevChecklist_has: bool, jevChecklist: bool,
    jevEvaluate_has: bool, jevEvaluate: bool,
    jevThinking_has: bool, jevThinking: bool,
    jevRedteam_has: bool, jevRedteam: bool,
    jevRank_has: bool, jevRank: bool,
    jevScope_has: bool, jevScope: bool,
    jevDispatch_has: bool, jevDispatch: bool,
    jevConsistency_has: bool, jevConsistency: bool,
    jevDone_has: bool, jevDone: bool,
    jevDiagnose_has: bool, jevDiagnose: bool,
    jevEdgeCases_has: bool, jevEdgeCases: bool,
    jevBlastRadius_has: bool, jevBlastRadius: bool,
    jevIntent_has: bool, jevIntent: bool,
    jevNext_has: bool, jevNext: bool,
    jevCompress_has: bool, jevCompress: bool,
    jevProgress_has: bool, jevProgress: bool,
    jevMemory_has: bool, jevMemory: bool,
    has_tools: bool,
}

struct JevMethodFlags {
    showJevChoose: bool,
    showJevChecklist: bool,
    showJevEvaluate: bool,
    showJevThinking: bool,
    showJevRedteam: bool,
    showJevRank: bool,
    showJevScope: bool,
    showJevDispatch: bool,
    showJevConsistency: bool,
    showJevDone: bool,
    showJevDiagnose: bool,
    showJevEdgeCases: bool,
    showJevBlastRadius: bool,
    showJevIntent: bool,
    showJevNext: bool,
    showJevCompress: bool,
    showJevProgress: bool,
    showJevMemory: bool,
}

fn jev_touched(t: &JevToolsIn) -> bool {
    return t.jevChoose_has || t.jevChecklist_has || t.jevEvaluate_has || t.jevThinking_has || t.jevRedteam_has || t.jevRank_has || t.jevScope_has || t.jevDispatch_has || t.jevConsistency_has || t.jevDone_has || t.jevDiagnose_has || t.jevEdgeCases_has || t.jevBlastRadius_has || t.jevIntent_has || t.jevNext_has || t.jevCompress_has || t.jevProgress_has || t.jevMemory_has;
}

fn resolveJevMethodFlags(t: &JevToolsIn, jev_active: bool, has_jev_active: bool, out: &JevMethodFlags) -> void {
    let touched = jev_touched(t);
    let fallback = has_jev_active && jev_active;
    if touched { out.showJevChoose = t.jevChoose_has && t.jevChoose; } else { out.showJevChoose = fallback; };
    if touched { out.showJevChecklist = t.jevChecklist_has && t.jevChecklist; } else { out.showJevChecklist = fallback; };
    // NB: showJevEvaluate ignores the touched/fallback rule in
    // the source (direct === true check) -- preserved.
    out.showJevEvaluate = t.jevEvaluate_has && t.jevEvaluate;
    if touched { out.showJevThinking = t.jevThinking_has && t.jevThinking; } else { out.showJevThinking = fallback; };
    if touched { out.showJevRedteam = t.jevRedteam_has && t.jevRedteam; } else { out.showJevRedteam = fallback; };
    if touched { out.showJevRank = t.jevRank_has && t.jevRank; } else { out.showJevRank = fallback; };
    if touched { out.showJevScope = t.jevScope_has && t.jevScope; } else { out.showJevScope = fallback; };
    if touched { out.showJevDispatch = t.jevDispatch_has && t.jevDispatch; } else { out.showJevDispatch = fallback; };
    if touched { out.showJevConsistency = t.jevConsistency_has && t.jevConsistency; } else { out.showJevConsistency = fallback; };
    if touched { out.showJevDone = t.jevDone_has && t.jevDone; } else { out.showJevDone = fallback; };
    if touched { out.showJevDiagnose = t.jevDiagnose_has && t.jevDiagnose; } else { out.showJevDiagnose = fallback; };
    if touched { out.showJevEdgeCases = t.jevEdgeCases_has && t.jevEdgeCases; } else { out.showJevEdgeCases = fallback; };
    if touched { out.showJevBlastRadius = t.jevBlastRadius_has && t.jevBlastRadius; } else { out.showJevBlastRadius = fallback; };
    if touched { out.showJevIntent = t.jevIntent_has && t.jevIntent; } else { out.showJevIntent = fallback; };
    if touched { out.showJevNext = t.jevNext_has && t.jevNext; } else { out.showJevNext = fallback; };
    if touched { out.showJevCompress = t.jevCompress_has && t.jevCompress; } else { out.showJevCompress = fallback; };
    if touched { out.showJevProgress = t.jevProgress_has && t.jevProgress; } else { out.showJevProgress = fallback; };
    if touched { out.showJevMemory = t.jevMemory_has && t.jevMemory; } else { out.showJevMemory = fallback; };
}

// listEnabledJevMethods -> names joined by '\n' in out.
fn listEnabledJevMethods(t: &JevToolsIn, jev_active: bool, has_jev_active: bool, out: &WsBuf) -> void {
    let flags = JevMethodFlags { showJevChoose: false, showJevChecklist: false, showJevEvaluate: false, showJevThinking: false, showJevRedteam: false, showJevRank: false, showJevScope: false, showJevDispatch: false, showJevConsistency: false, showJevDone: false, showJevDiagnose: false, showJevEdgeCases: false, showJevBlastRadius: false, showJevIntent: false, showJevNext: false, showJevCompress: false, showJevProgress: false, showJevMemory: false };
    resolveJevMethodFlags(t, jev_active, has_jev_active, &flags);
    out.len = 0;
    if flags.showJevChoose { wb_append(out, STR_PTR("jev_choose\n"), STR_LEN("jev_choose\n")); };
    if flags.showJevChecklist { wb_append(out, STR_PTR("jev_checklist\n"), STR_LEN("jev_checklist\n")); };
    if flags.showJevEvaluate { wb_append(out, STR_PTR("jev_evaluate\n"), STR_LEN("jev_evaluate\n")); };
    if flags.showJevThinking { wb_append(out, STR_PTR("jev_thinking\n"), STR_LEN("jev_thinking\n")); };
    if flags.showJevRedteam { wb_append(out, STR_PTR("jev_redteam\n"), STR_LEN("jev_redteam\n")); };
    if flags.showJevRank { wb_append(out, STR_PTR("jev_rank\n"), STR_LEN("jev_rank\n")); };
    if flags.showJevScope { wb_append(out, STR_PTR("jev_scope\n"), STR_LEN("jev_scope\n")); };
    if flags.showJevDispatch { wb_append(out, STR_PTR("jev_dispatch\n"), STR_LEN("jev_dispatch\n")); };
    if flags.showJevConsistency { wb_append(out, STR_PTR("jev_consistency\n"), STR_LEN("jev_consistency\n")); };
    if flags.showJevDone { wb_append(out, STR_PTR("jev_done\n"), STR_LEN("jev_done\n")); };
    if flags.showJevDiagnose { wb_append(out, STR_PTR("jev_diagnose\n"), STR_LEN("jev_diagnose\n")); };
    if flags.showJevEdgeCases { wb_append(out, STR_PTR("jev_edge_cases\n"), STR_LEN("jev_edge_cases\n")); };
    if flags.showJevBlastRadius { wb_append(out, STR_PTR("jev_blast_radius\n"), STR_LEN("jev_blast_radius\n")); };
    if flags.showJevIntent { wb_append(out, STR_PTR("jev_intent\n"), STR_LEN("jev_intent\n")); };
    if flags.showJevNext { wb_append(out, STR_PTR("jev_next\n"), STR_LEN("jev_next\n")); };
    if flags.showJevCompress { wb_append(out, STR_PTR("jev_compress\n"), STR_LEN("jev_compress\n")); };
    if flags.showJevProgress { wb_append(out, STR_PTR("jev_progress\n"), STR_LEN("jev_progress\n")); };
    if flags.showJevMemory { wb_append(out, STR_PTR("jev_memory\n"), STR_LEN("jev_memory\n")); };
}

// Paths ----------------------------------------------------------------

fn ws_join2(out: &WsBuf, a_ptr: ptr, a_len: u64, b: &str) -> void {
    out.len = 0;
    wb_append(out, a_ptr, a_len);
    wb_append(out, STR_PTR("/"), STR_LEN("/"));
    wb_append(out, STR_PTR(b), STR_LEN(b));
}

// threadId.trim().replace(/[^A-Za-z0-9._-]/g, "_")
fn sanitize_thread_id(t_ptr: ptr, t_len: u64, out: &WsBuf) -> void {
    let s: u64 = 0;
    let l: u64 = 0;
    ws_trim_range(t_ptr, t_len, &s, &l);
    out.len = 0;
    for i in 0..l {
        let b: u8 = 0;
        PTR_BYTE_AT(b, t_ptr, s + i);
        let ok = (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || (b >= 48 && b <= 57) || b == 46 || b == 95 || b == 45;
        if !ok { b = 95; };
        let single = [0; 1];
        single[0] = b;
        wb_append(out, &single, 1);
    }
}

fn skill_path_for_backend_dir(cwd_ptr: ptr, cwd_len: u64, dir: &str, out: &WsBuf) -> void {
    out.len = 0;
    wb_append(out, cwd_ptr, cwd_len);
    wb_append(out, STR_PTR("/"), STR_LEN("/"));
    wb_append(out, STR_PTR(dir), STR_LEN(dir));
    wb_append(out, STR_PTR("/skills/sa-vm/SKILL.md"), STR_LEN("/skills/sa-vm/SKILL.md"));
}

fn workspaceSaVmSkillPath(cwd_ptr: ptr, cwd_len: u64, thread_ptr: ptr, thread_len: u64, has_thread: bool, backend_ptr: ptr, backend_len: u64, has_backend: bool, out: &WsBuf) -> void {
    if has_thread {
        let s: u64 = 0;
        let l: u64 = 0;
        ws_trim_range(thread_ptr, thread_len, &s, &l);
        if l > 0 {
            let safe = WsBuf { bytes: [0; 1048576], len: 0 };
            sanitize_thread_id(thread_ptr, thread_len, &safe);
            out.len = 0;
            wb_append(out, cwd_ptr, cwd_len);
            wb_append(out, STR_PTR("/.codex-ultra/thread-skills/"), STR_LEN("/.codex-ultra/thread-skills/"));
            wb_append(out, wb_ptr(&safe), safe.len);
            wb_append(out, STR_PTR("/sa-vm/SKILL.md"), STR_LEN("/sa-vm/SKILL.md"));
            return;
        };
    };
    if has_backend {
        if ws_eq(backend_ptr, backend_len, STR_PTR("claude"), STR_LEN("claude")) { skill_path_for_backend_dir(cwd_ptr, cwd_len, ".claude", out); return; };
        if ws_eq(backend_ptr, backend_len, STR_PTR("codex"), STR_LEN("codex")) { skill_path_for_backend_dir(cwd_ptr, cwd_len, ".codex", out); return; };
        if ws_eq(backend_ptr, backend_len, STR_PTR("mini"), STR_LEN("mini")) || ws_eq(backend_ptr, backend_len, STR_PTR("mini-agent"), STR_LEN("mini-agent")) { skill_path_for_backend_dir(cwd_ptr, cwd_len, ".mini-agent", out); return; };
        if ws_eq(backend_ptr, backend_len, STR_PTR("agy"), STR_LEN("agy")) { skill_path_for_backend_dir(cwd_ptr, cwd_len, ".gemini", out); return; };
        if ws_eq(backend_ptr, backend_len, STR_PTR("auggie"), STR_LEN("auggie")) { skill_path_for_backend_dir(cwd_ptr, cwd_len, ".augment", out); return; };
        if ws_eq(backend_ptr, backend_len, STR_PTR("cline"), STR_LEN("cline")) { skill_path_for_backend_dir(cwd_ptr, cwd_len, ".cline", out); return; };
        if ws_eq(backend_ptr, backend_len, STR_PTR("command-code"), STR_LEN("command-code")) { skill_path_for_backend_dir(cwd_ptr, cwd_len, ".commandcode", out); return; };
        if ws_eq(backend_ptr, backend_len, STR_PTR("grok"), STR_LEN("grok")) { skill_path_for_backend_dir(cwd_ptr, cwd_len, ".grok", out); return; };
        if ws_eq(backend_ptr, backend_len, STR_PTR("opencode"), STR_LEN("opencode")) || ws_eq(backend_ptr, backend_len, STR_PTR("opencode-v2"), STR_LEN("opencode-v2")) { skill_path_for_backend_dir(cwd_ptr, cwd_len, ".opencode", out); return; };
        if ws_eq(backend_ptr, backend_len, STR_PTR("pi"), STR_LEN("pi")) { skill_path_for_backend_dir(cwd_ptr, cwd_len, ".pi", out); return; };
        if ws_eq(backend_ptr, backend_len, STR_PTR("muse"), STR_LEN("muse")) { skill_path_for_backend_dir(cwd_ptr, cwd_len, ".agents", out); return; };
    };
    skill_path_for_backend_dir(cwd_ptr, cwd_len, ".agents", out);
}

fn resolveSaVmHelpRoot(cwd_ptr: ptr, cwd_len: u64, configured_ptr: ptr, configured_len: u64, has_configured: bool, process_cwd_ptr: ptr, process_cwd_len: u64, out: &WsBuf) -> void {
    if has_configured {
        let s: u64 = 0;
        let l: u64 = 0;
        ws_trim_range(configured_ptr, configured_len, &s, &l);
        if l > 0 {
            let seg: ptr = PTR_NULL();
            PTR_BYTE_ADD(seg, configured_ptr, s);
            // isAbsolute ? resolve(selected) : resolve(cwd, selected)
            // DEFECT: resolve() normalization approximated.
            out.len = 0;
            if l > 0 {
                let b0: u8 = 0;
                PTR_BYTE_AT(b0, seg, 0);
                if b0 != 47 {
                    wb_append(out, cwd_ptr, cwd_len);
                    wb_append(out, STR_PTR("/"), STR_LEN("/"));
                };
            };
            wb_append(out, seg, l);
            return;
        };
    };
    // globalSala = join(getSaVmGlobalDataDir(), "sala")
    let gd = PathBuf { bytes: [0; 4096], len: 0 };
    getSaVmGlobalDataDir(&gd);
    let probe = WsBuf { bytes: [0; 1048576], len: 0 };
    probe.len = 0;
    let gp: ptr = PTR_NULL();
    PTR_BYTE_ADD(gp, &gd.bytes, 0);
    wb_append(&probe, gp, gd.len);
    wb_append(&probe, STR_PTR("/sala/dist/index.html"), STR_LEN("/sala/dist/index.html"));
    let t: u64 = 0;
    if sa_std_fs_len(wb_ptr(&probe), probe.len, &t) == 0 {
        out.len = 0;
        wb_append(out, gp, gd.len);
        wb_append(out, STR_PTR("/sala"), STR_LEN("/sala"));
        return;
    };
    // env CODEX_UI_SA_VM_SALA_DIR or join(process.cwd(),
    // "desktop-resources", "sa-vm", "sala")
    let ev = sa_env_get(STR_PTR("CODEX_UI_SA_VM_SALA_DIR"), STR_LEN("CODEX_UI_SA_VM_SALA_DIR"));
    out.len = 0;
    if ev != 0 {
        let vp = sa_env_buffer_data(ev);
        let vl = sa_env_buffer_len(ev);
        let s: u64 = 0;
        let l: u64 = 0;
        ws_trim_range(vp, vl, &s, &l);
        if l > 0 {
            let seg: ptr = PTR_NULL();
            PTR_BYTE_ADD(seg, vp, s);
            let b0: u8 = 0;
            PTR_BYTE_AT(b0, seg, 0);
            if b0 != 47 {
                wb_append(out, cwd_ptr, cwd_len);
                wb_append(out, STR_PTR("/"), STR_LEN("/"));
            };
            wb_append(out, seg, l);
            return;
        };
    };
    wb_append(out, process_cwd_ptr, process_cwd_len);
    wb_append(out, STR_PTR("/desktop-resources/sa-vm/sala"), STR_LEN("/desktop-resources/sa-vm/sala"));
}

// BunTsVerifiedRecipe + BUN_TS_VERIFIED_RECIPES: the recipe
// table (source lines 230-382) is string data; it is preserved
// verbatim in a comment block at the end of this file.
// DEFECT: data table not yet lifted into constants.
struct BunTsVerifiedRecipe {
    id: [u8; 64],
    id_len: u64,
    name: WsBuf,
    sourceOrigin: [u8; 256],
    sourceOrigin_len: u64,
    jsConcept: WsBuf,
    tsPattern: WsBuf,
    fullSource: WsBuf,
}

const BUN_TS_VERIFIED_RECIPES_LEN: u64 = 12;

// buildSaVmWorkspaceSkillMarkdown --------------------------------------

// Policy access over the JSON twin of SaVmPolicyConfig.
fn pol_bool(node: u64, obj_ptr: ptr, obj_len: u64, key: &str, out_has: &bool, out_val: &bool) -> void {
    *out_has = false;
    *out_val = false;
    if node == 0 { return; };
    let obj: u64 = 0;
    if obj_len > 0 {
        if sa_json_object_get(node, obj_ptr, obj_len, &obj) != 0 { return; };
    } else {
        obj = node;
    };
    let v: u64 = 0;
    if sa_json_object_get(obj, STR_PTR(key), STR_LEN(key)) != 0 { return; };
    *out_has = true;
    let b = false;
    if sa_json_as_bool(v, &b) == 0 { *out_val = b; };
}

fn pol_tools_bool(policy: u64, key: &str, out_has: &bool, out_val: &bool) -> void {
    pol_bool(policy, STR_PTR("tools"), STR_LEN("tools"), key, out_has, out_val);
}

struct SkillMarkdownFlags {
    hasExplicitPolicy: bool,
    isEnhanceActive: bool,
    isEnabled: bool,
    isEnhanceOnly: bool,
    // statusHeading: 0/1 both render "已开启" except disabled ->
    // "未开启" (the source's ternary is kept as-is)
    statusHeadingIsOn: bool,
    allowRead: bool,
    allowWrite: bool,
    allowPatch: bool,
    allowJs: bool,
    allowPy: bool,
    allowClearHistory: bool,
    allowFindReferences: bool,
    allowRenameSymbol: bool,
    allowFileOutline: bool,
    allowMoveWithImports: bool,
    allowFindDefinition: bool,
    allowExtractToFile: bool,
    allowAddImport: bool,
    allowGetDiagnostics: bool,
    allowOrganizeImports: bool,
    allowAnalyzeScope: bool,
    allowCodeGraph: bool,
    allowHttp: bool,
    allowBunProfiles: bool,
    allowBun: bool,
    allowNotes: bool,
    allowTsTrack: bool,
}

// hasEnhanceToolsEnabled(tools) is defined in @codex-ui/shared
// (packages/shared unit); approximated here by its known shape:
// any replace* enhance flag true. DEFECT: cross-unit call.
fn hasEnhanceToolsEnabledApprox(policy: u64) -> bool {
    let h = false;
    let v = false;
    pol_tools_bool(policy, "replaceExec", &h, &v);
    if h && v { return true; };
    pol_tools_bool(policy, "replaceRead", &h, &v);
    if h && v { return true; };
    pol_tools_bool(policy, "replaceWrite", &h, &v);
    if h && v { return true; };
    pol_tools_bool(policy, "replaceApplyPatch", &h, &v);
    if h && v { return true; };
    return false;
}

fn deriveSkillMarkdownFlags(policy: u64, has_policy: bool, enabled: u64, flags: &SkillMarkdownFlags) -> void {
    // enabled: 0 = undefined, 1 = true, 2 = false
    flags.hasExplicitPolicy = has_policy;
    flags.isEnhanceActive = has_policy && hasEnhanceToolsEnabledApprox(policy);
    flags.isEnabled = enabled != 2;
    flags.isEnhanceOnly = (enabled == 2 || (enabled != 1 && !flag_tools_replaceExec(policy))) && flags.isEnhanceActive;
    flags.statusHeadingIsOn = flags.isEnhanceOnly || flags.isEnabled;
    let explicit = has_policy;
    let h = false;
    let v = false;
    let h2 = false;
    let v2 = false;
    pol_tools_bool(policy, "replaceRead", &h, &v);
    pol_tools_bool(policy, "readFiles", &h2, &v2);
    if explicit { flags.allowRead = (h && v) || (h2 && v2); } else { flags.allowRead = true; };
    pol_tools_bool(policy, "replaceWrite", &h, &v);
    pol_tools_bool(policy, "editFiles", &h2, &v2);
    if explicit { flags.allowWrite = (h && v) || (h2 && v2); } else { flags.allowWrite = true; };
    pol_tools_bool(policy, "replaceApplyPatch", &h, &v);
    pol_tools_bool(policy, "applyPatch", &h2, &v2);
    if explicit { flags.allowPatch = (h && v) || (h2 && v2); } else { flags.allowPatch = true; };
    pol_bool(policy, STR_PTR("execution"), STR_LEN("execution"), "javascript", &h, &v);
    flags.allowJs = h && v;
    pol_bool(policy, STR_PTR("execution"), STR_LEN("execution"), "python", &h, &v);
    flags.allowPy = h && v;
    pol_tools_bool(policy, "clearToolHistory", &h, &v);
    if explicit { flags.allowClearHistory = h && v; } else { flags.allowClearHistory = false; };
    pol_tools_bool(policy, "findReferences", &h, &v);
    if explicit { flags.allowFindReferences = !(h && !v); } else { flags.allowFindReferences = true; };
    pol_tools_bool(policy, "renameSymbol", &h, &v);
    if explicit { flags.allowRenameSymbol = h && v; } else { flags.allowRenameSymbol = false; };
    pol_tools_bool(policy, "fileOutline", &h, &v);
    if explicit { flags.allowFileOutline = !(h && !v); } else { flags.allowFileOutline = true; };
    pol_tools_bool(policy, "moveWithImports", &h, &v);
    if explicit { flags.allowMoveWithImports = h && v; } else { flags.allowMoveWithImports = false; };
    pol_tools_bool(policy, "findDefinition", &h, &v);
    if explicit { flags.allowFindDefinition = !(h && !v); } else { flags.allowFindDefinition = true; };
    pol_tools_bool(policy, "extractToFile", &h, &v);
    if explicit { flags.allowExtractToFile = h && v; } else { flags.allowExtractToFile = false; };
    pol_tools_bool(policy, "addImport", &h, &v);
    if explicit { flags.allowAddImport = h && v; } else { flags.allowAddImport = false; };
    pol_tools_bool(policy, "getDiagnostics", &h, &v);
    if explicit { flags.allowGetDiagnostics = h && v; } else { flags.allowGetDiagnostics = false; };
    pol_tools_bool(policy, "organizeImports", &h, &v);
    if explicit { flags.allowOrganizeImports = h && v; } else { flags.allowOrganizeImports = false; };
    pol_tools_bool(policy, "analyzeScope", &h, &v);
    if explicit { flags.allowAnalyzeScope = h && v; } else { flags.allowAnalyzeScope = false; };
    pol_tools_bool(policy, "codeGraph", &h, &v);
    if explicit { flags.allowCodeGraph = !(h && !v); } else { flags.allowCodeGraph = true; };
    // allowHttp: policy.http.allow is a non-empty array
    flags.allowHttp = false;
    if explicit {
        let http: u64 = 0;
        if sa_json_object_get(policy, STR_PTR("http"), STR_LEN("http"), &http) == 0 {
            let allow: u64 = 0;
            if sa_json_object_get(http, STR_PTR("allow"), STR_LEN("allow"), &allow) == 0 {
                let n: u64 = 0;
                if sa_json_value_count(allow, &n) == 0 && n > 0 { flags.allowHttp = true; };
            };
        };
    };
    // bunProfiles: policy.process.bunProfiles ?? []
    flags.allowBunProfiles = false;
    let proc: u64 = 0;
    if has_policy && sa_json_object_get(policy, STR_PTR("process"), STR_LEN("process"), &proc) == 0 {
        let bp: u64 = 0;
        if sa_json_object_get(proc, STR_PTR("bunProfiles"), STR_LEN("bunProfiles"), &bp) == 0 {
            let n: u64 = 0;
            if sa_json_value_count(bp, &n) == 0 && n > 0 { flags.allowBunProfiles = true; };
        };
        // allowBun: process.bun === true || object.enabled
        flags.allowBun = false;
        let bun: u64 = 0;
        if sa_json_object_get(proc, STR_PTR("bun"), STR_LEN("bun"), &bun) == 0 {
            let bb = false;
            if sa_json_as_bool(bun, &bb) == 0 {
                flags.allowBun = bb;
            } else {
                let en: u64 = 0;
                if sa_json_object_get(bun, STR_PTR("enabled"), STR_LEN("enabled"), &en) == 0 {
                    let eb = false;
                    if sa_json_as_bool(en, &eb) == 0 { flags.allowBun = eb; };
                };
            };
        };
    } else {
        flags.allowBun = false;
    };
    flags.allowNotes = flags.allowRead || flags.allowWrite;
    flags.allowTsTrack = !flags.isEnhanceOnly && flags.isEnabled && (flags.allowJs || flags.allowPy || flags.allowBun || !explicit);
}

fn flag_tools_replaceExec(policy: u64) -> bool {
    let h = false;
    let v = false;
    pol_tools_bool(policy, "replaceExec", &h, &v);
    return h && v;
}

// enabledToolNames assembly (order matches the source exactly),
// names joined by '\n' into out.
fn buildEnabledToolNames(flags: &SkillMarkdownFlags, out: &WsBuf) -> void {
    out.len = 0;
    if flags.allowPatch { wb_append(out, STR_PTR("apply_patch\n"), STR_LEN("apply_patch\n")); };
    if flags.allowWrite { wb_append(out, STR_PTR("edit_file\nwrite_file\ndelete_file\nsafe_delete\nmove_file\ncopy_file\n"), STR_LEN("edit_file\nwrite_file\ndelete_file\nsafe_delete\nmove_file\ncopy_file\n")); };
    if flags.allowRead { wb_append(out, STR_PTR("read_file\nread_lines\nread_many\nread_file_tail\ncount_lines\nfile_info\n"), STR_LEN("read_file\nread_lines\nread_many\nread_file_tail\ncount_lines\nfile_info\n")); };
    wb_append(out, STR_PTR("find_files\nlist_dir\ngrep_search\ngrep_search_async\n"), STR_LEN("find_files\nlist_dir\ngrep_search\ngrep_search_async\n"));
    wb_append(out, STR_PTR("git_status\ngit_diff\n"), STR_LEN("git_status\ngit_diff\n"));
    if flags.allowFindReferences { wb_append(out, STR_PTR("find_references\nfind_implementations\n"), STR_LEN("find_references\nfind_implementations\n")); };
    if flags.allowFileOutline { wb_append(out, STR_PTR("file_outline\nworkspace_outline\nrepo_map\n"), STR_LEN("file_outline\nworkspace_outline\nrepo_map\n")); };
    if flags.allowCodeGraph { wb_append(out, STR_PTR("code_graph\nrelation_graph\nsymbol_graph\n"), STR_LEN("code_graph\nrelation_graph\nsymbol_graph\n")); };
    if flags.allowRenameSymbol { wb_append(out, STR_PTR("rename_symbol\n"), STR_LEN("rename_symbol\n")); };
    if flags.allowMoveWithImports { wb_append(out, STR_PTR("move_file_with_imports\n"), STR_LEN("move_file_with_imports\n")); };
    if flags.allowFindDefinition { wb_append(out, STR_PTR("find_definition\n"), STR_LEN("find_definition\n")); };
    if flags.allowExtractToFile { wb_append(out, STR_PTR("extract_to_file\nextract_component\nextract_hook\natomic_refactor\nsplit_plan\nsplit_stage\nsplit_refine\nsplit_repair\nsplit_status\n"), STR_LEN("extract_to_file\nextract_component\nextract_hook\natomic_refactor\nsplit_plan\nsplit_stage\nsplit_refine\nsplit_repair\nsplit_status\n")); };
    if flags.allowAddImport { wb_append(out, STR_PTR("add_import\n"), STR_LEN("add_import\n")); };
    if flags.allowGetDiagnostics { wb_append(out, STR_PTR("get_diagnostics\nworkspace_diagnostics\nverify_loop\nverify_changed\nreplay_case\nrecord_case\n"), STR_LEN("get_diagnostics\nworkspace_diagnostics\nverify_loop\nverify_changed\nreplay_case\nrecord_case\n")); };
    if flags.allowOrganizeImports || flags.allowGetDiagnostics { wb_append(out, STR_PTR("auto_fix_missing_imports\n"), STR_LEN("auto_fix_missing_imports\n")); };
    if flags.allowOrganizeImports { wb_append(out, STR_PTR("organize_imports\n"), STR_LEN("organize_imports\n")); };
    if flags.allowAnalyzeScope { wb_append(out, STR_PTR("analyze_scope\nanalyze_coupling\n"), STR_LEN("analyze_scope\nanalyze_coupling\n")); };
    if flags.allowJs { wb_append(out, STR_PTR("run_js\n"), STR_LEN("run_js\n")); };
    if flags.allowPy { wb_append(out, STR_PTR("run_py\n"), STR_LEN("run_py\n")); };
    if flags.allowHttp { wb_append(out, STR_PTR("http_fetch\n"), STR_LEN("http_fetch\n")); };
    if flags.allowBunProfiles { wb_append(out, STR_PTR("run_project_check\n"), STR_LEN("run_project_check\n")); };
    if flags.allowBun { wb_append(out, STR_PTR("run_bun\n"), STR_LEN("run_bun\n")); };
    if flags.allowClearHistory { wb_append(out, STR_PTR("clear_tool_history\n"), STR_LEN("clear_tool_history\n")); };
    if flags.allowNotes { wb_append(out, STR_PTR("add_memory\nread_memory\ndelete_memory\nedit_memory\nsave_note\nread_notes\ndelete_note\n"), STR_LEN("add_memory\nread_memory\ndelete_memory\nedit_memory\nsave_note\nread_notes\ndelete_note\n")); };
    wb_append(out, STR_PTR("run_host\n"), STR_LEN("run_host\n"));
}

// buildSaVmWorkspaceSkillMarkdown(input) -> markdown text.
// The flag derivation and tool-name assembly above are the
// converted logic; the document text assembly (source lines
// ~470-1704: statusRule, sections per flag, recipes, sala links)
// is DEFECT: pending template segmentation -- the full source
// text is preserved in the comment block at the end of this
// file. Returns status 0 with the enabled-tools block standing
// in for the document in the bulk pass.
fn buildSaVmWorkspaceSkillMarkdown(policy: u64, has_policy: bool, enabled: u64, jev_active: bool, has_jev_active: bool, out: &WsBuf) -> i32 {
    let flags = SkillMarkdownFlags { hasExplicitPolicy: false, isEnhanceActive: false, isEnabled: false, isEnhanceOnly: false, statusHeadingIsOn: false, allowRead: false, allowWrite: false, allowPatch: false, allowJs: false, allowPy: false, allowClearHistory: false, allowFindReferences: false, allowRenameSymbol: false, allowFileOutline: false, allowMoveWithImports: false, allowFindDefinition: false, allowExtractToFile: false, allowAddImport: false, allowGetDiagnostics: false, allowOrganizeImports: false, allowAnalyzeScope: false, allowCodeGraph: false, allowHttp: false, allowBunProfiles: false, allowBun: false, allowNotes: false, allowTsTrack: false };
    deriveSkillMarkdownFlags(policy, has_policy, enabled, &flags);
    buildEnabledToolNames(&flags, out);
    return 0;
}

// buildSaVmBunTsCheatsheetMarkdown(input) -> text.
// DEFECT: body is a template over BUN_TS_VERIFIED_RECIPES --
// preserved verbatim in the end-of-file comment block; the
// bulk pass emits only the document title line.
fn buildSaVmBunTsCheatsheetMarkdown(out: &WsBuf) -> i32 {
    out.len = 0;
    wb_append(out, STR_PTR("# BUN_TS_CHEATSHEET\n"), STR_LEN("# BUN_TS_CHEATSHEET\n"));
    return 0;
}

// buildJevWorkspaceSkillMarkdown(input) -> text or null
// (status 1). Content depends on listEnabledJevMethods: no
// enabled methods -> null. DEFECT: section text assembly
// pending (verbatim source in the end-of-file comment block);
// the null/non-null decision IS converted.
fn buildJevWorkspaceSkillMarkdown(policy_tools: &JevToolsIn, jev_active: bool, has_jev_active: bool, out: &WsBuf) -> i32 {
    let methods = WsBuf { bytes: [0; 1048576], len: 0 };
    listEnabledJevMethods(policy_tools, jev_active, has_jev_active, &methods);
    if methods.len == 0 { return 1; };
    out.len = 0;
    wb_append(out, wb_ptr(&methods), methods.len);
    return 0;
}

// isGenerated* ---------------------------------------------------------

fn read_small_file(path_ptr: ptr, path_len: u64, out: &WsBuf) -> i32 {
    let total: u64 = 0;
    if sa_std_fs_len(path_ptr, path_len, &total) != 0 { return 3; };
    if total > 1048576 { return 6; };
    let fh: u64 = 0;
    if sa_std_fs_open_read(path_ptr, path_len, &fh) != 0 { return 3; };
    out.len = 0;
    let chunk = [0; 4096];
    let guard: u64 = 0;
    while guard < 300 {
        let read_n: u64 = 0;
        if sa_std_fs_file_read(fh, &chunk, 4096, &read_n) != 0 {
            sa_fs_file_close(fh);
            return 6;
        };
        if read_n == 0 { break; };
        for ci in 0..read_n {
            if out.len < 1048576 {
                out.bytes[out.len] = chunk[ci];
                out.len = out.len + 1;
            };
        }
        guard = guard + 1;
    }
    sa_fs_file_close(fh);
    return 0;
}

fn isGeneratedJevWorkspaceSkill(path_ptr: ptr, path_len: u64) -> bool {
    let content = WsBuf { bytes: [0; 1048576], len: 0 };
    if read_small_file(path_ptr, path_len, &content) != 0 { return false; };
    return ws_contains(wb_ptr(&content), content.len, STR_PTR("<!-- generated-by-codex-ultra:jev -->"), STR_LEN("<!-- generated-by-codex-ultra:jev -->"));
}

fn isGeneratedSaVmWorkspaceSkill(path_ptr: ptr, path_len: u64) -> bool {
    let content = WsBuf { bytes: [0; 1048576], len: 0 };
    if read_small_file(path_ptr, path_len, &content) != 0 { return false; };
    return ws_contains(wb_ptr(&content), content.len, STR_PTR("<!-- generated-by-codex-ultra:sa-vm -->"), STR_LEN("<!-- generated-by-codex-ultra:sa-vm -->"));
}

fn ws_exists(path_ptr: ptr, path_len: u64) -> bool {
    let t: u64 = 0;
    return sa_std_fs_len(path_ptr, path_len, &t) == 0;
}

fn ws_dirname(path_ptr: ptr, path_len: u64, out: &WsBuf) -> void {
    let end = path_len;
    // strip trailing slashes (except root) -- approximated
    let k = path_len;
    let dir_len: u64 = 0;
    while k > 0 {
        let b: u8 = 0;
        PTR_BYTE_AT(b, path_ptr, k - 1);
        if b == 47 { dir_len = k - 1; break; };
        k = k - 1;
    }
    out.len = 0;
    wb_append(out, path_ptr, dir_len);
}

// cleanupAllWorkspaceSaVmSkills: candidate dirs (workspace
// skill path dirname, the 8 backend dirs, thread-skills root)
// plus the jev sibling of every dir ending in "sa-vm". Only
// generated content is removed; every error is swallowed.
// DEFECT: rm recursive -> sa_fs_remove_dir_all.
fn cleanupAllWorkspaceSaVmSkills(cwd_ptr: ptr, cwd_len: u64, thread_ptr: ptr, thread_len: u64, has_thread: bool) -> void {
    let dirs: [WsBuf; 24] = [WsBuf { bytes: [0; 1048576], len: 0 }; 24];
    let n: u64 = 0;
    if has_thread {
        let p = WsBuf { bytes: [0; 1048576], len: 0 };
        workspaceSaVmSkillPath(cwd_ptr, cwd_len, thread_ptr, thread_len, true, STR_PTR(""), 0, false, &p);
        ws_dirname(wb_ptr(&p), p.len, &dirs[n]);
        n = n + 1;
    };
    let def = WsBuf { bytes: [0; 1048576], len: 0 };
    workspaceSaVmSkillPath(cwd_ptr, cwd_len, STR_PTR(""), 0, false, STR_PTR(""), 0, false, &def);
    ws_dirname(wb_ptr(&def), def.len, &dirs[n]);
    n = n + 1;
    let subs = [".mini-agent", ".codex", ".claude", ".gemini", ".grok", ".opencode", ".pi", ".muse", ".agents"];
    for si in 0..9 {
        dirs[n].len = 0;
        wb_append(&dirs[n], cwd_ptr, cwd_len);
        wb_append(&dirs[n], STR_PTR("/"), STR_LEN("/"));
        wb_append(&dirs[n], STR_PTR(subs[si]), STR_LEN(subs[si]));
        wb_append(&dirs[n], STR_PTR("/skills/sa-vm"), STR_LEN("/skills/sa-vm"));
        n = n + 1;
    }
    dirs[n].len = 0;
    wb_append(&dirs[n], cwd_ptr, cwd_len);
    wb_append(&dirs[n], STR_PTR("/.codex-ultra/thread-skills"), STR_LEN("/.codex-ultra/thread-skills"));
    n = n + 1;
    // jev siblings for dirs ending with the skill name
    let base_n = n;
    for i in 0..base_n {
        let d = &dirs[i];
        if d.len >= 5 {
            let tail: ptr = PTR_NULL();
            PTR_BYTE_ADD(tail, wb_ptr(d), d.len - 5);
            if ws_eq(tail, 5, STR_PTR("sa-vm"), STR_LEN("sa-vm")) {
                let parent = WsBuf { bytes: [0; 1048576], len: 0 };
                ws_dirname(wb_ptr(d), d.len, &parent);
                dirs[n].len = 0;
                wb_append(&dirs[n], wb_ptr(&parent), parent.len);
                wb_append(&dirs[n], STR_PTR("/jev"), STR_LEN("/jev"));
                n = n + 1;
            };
        };
    }
    for i in 0..n {
        let d = &dirs[i];
        let dp = wb_ptr(d);
        // cheatsheet file first
        let cheat = WsBuf { bytes: [0; 1048576], len: 0 };
        cheat.len = 0;
        wb_append(&cheat, dp, d.len);
        wb_append(&cheat, STR_PTR("/BUN_TS_CHEATSHEET.md"), STR_LEN("/BUN_TS_CHEATSHEET.md"));
        if ws_exists(wb_ptr(&cheat), cheat.len) {
            sa_fs_remove_file(wb_ptr(&cheat), cheat.len);
        };
        let skill = WsBuf { bytes: [0; 1048576], len: 0 };
        skill.len = 0;
        wb_append(&skill, dp, d.len);
        wb_append(&skill, STR_PTR("/SKILL.md"), STR_LEN("/SKILL.md"));
        if ws_exists(wb_ptr(&skill), skill.len) {
            if isGeneratedSaVmWorkspaceSkill(wb_ptr(&skill), skill.len) || isGeneratedJevWorkspaceSkill(wb_ptr(&skill), skill.len) {
                sa_fs_remove_dir_all(dp, d.len);
            };
        } else if ws_exists(dp, d.len) {
            let ends_skill = false;
            if d.len >= 5 {
                let tail: ptr = PTR_NULL();
                PTR_BYTE_ADD(tail, dp, d.len - 5);
                if ws_eq(tail, 5, STR_PTR("sa-vm"), STR_LEN("sa-vm")) { ends_skill = true; };
            };
            if d.len >= 3 {
                let tail: ptr = PTR_NULL();
                PTR_BYTE_ADD(tail, dp, d.len - 3);
                if ws_eq(tail, 3, STR_PTR("jev"), STR_LEN("jev")) { ends_skill = true; };
            };
            if ends_skill { sa_fs_remove_dir_all(dp, d.len); };
        };
    }
}

// jevToolsFromPolicy: fills JevToolsIn from policy.tools.
fn jevToolsFromPolicy(policy: u64, has_policy: bool, t: &JevToolsIn) -> void {
    t.has_tools = has_policy;
    let h = false;
    let v = false;
    pol_tools_bool(policy, "jevChoose", &h, &v); t.jevChoose_has = h; t.jevChoose = v;
    pol_tools_bool(policy, "jevChecklist", &h, &v); t.jevChecklist_has = h; t.jevChecklist = v;
    pol_tools_bool(policy, "jevEvaluate", &h, &v); t.jevEvaluate_has = h; t.jevEvaluate = v;
    pol_tools_bool(policy, "jevThinking", &h, &v); t.jevThinking_has = h; t.jevThinking = v;
    pol_tools_bool(policy, "jevRedteam", &h, &v); t.jevRedteam_has = h; t.jevRedteam = v;
    pol_tools_bool(policy, "jevRank", &h, &v); t.jevRank_has = h; t.jevRank = v;
    pol_tools_bool(policy, "jevScope", &h, &v); t.jevScope_has = h; t.jevScope = v;
    pol_tools_bool(policy, "jevDispatch", &h, &v); t.jevDispatch_has = h; t.jevDispatch = v;
    pol_tools_bool(policy, "jevConsistency", &h, &v); t.jevConsistency_has = h; t.jevConsistency = v;
    pol_tools_bool(policy, "jevDone", &h, &v); t.jevDone_has = h; t.jevDone = v;
    pol_tools_bool(policy, "jevDiagnose", &h, &v); t.jevDiagnose_has = h; t.jevDiagnose = v;
    pol_tools_bool(policy, "jevEdgeCases", &h, &v); t.jevEdgeCases_has = h; t.jevEdgeCases = v;
    pol_tools_bool(policy, "jevBlastRadius", &h, &v); t.jevBlastRadius_has = h; t.jevBlastRadius = v;
    pol_tools_bool(policy, "jevIntent", &h, &v); t.jevIntent_has = h; t.jevIntent = v;
    pol_tools_bool(policy, "jevNext", &h, &v); t.jevNext_has = h; t.jevNext = v;
    pol_tools_bool(policy, "jevCompress", &h, &v); t.jevCompress_has = h; t.jevCompress = v;
    pol_tools_bool(policy, "jevProgress", &h, &v); t.jevProgress_has = h; t.jevProgress = v;
    pol_tools_bool(policy, "jevMemory", &h, &v); t.jevMemory_has = h; t.jevMemory = v;
}

// forceUpdateWorkspaceSkill(cwd, threadId, enabled, policy,
// extra) -> first target path in out. Writes the sa-vm SKILL.md
// (+ jev sibling) into the 8 backend dirs (+ thread dir).
fn forceUpdateWorkspaceSkill(cwd_ptr: ptr, cwd_len: u64, thread_ptr: ptr, thread_len: u64, has_thread: bool, enabled: bool, policy: u64, has_policy: bool, jev_active: bool, out_first: &WsBuf) -> i32 {
    let targets: [WsBuf; 9] = [WsBuf { bytes: [0; 1048576], len: 0 }; 9];
    let subs = [".mini-agent", ".codex", ".claude", ".gemini", ".grok", ".opencode", ".pi", ".agents"];
    let n: u64 = 0;
    for si in 0..8 {
        targets[n].len = 0;
        wb_append(&targets[n], cwd_ptr, cwd_len);
        wb_append(&targets[n], STR_PTR("/"), STR_LEN("/"));
        wb_append(&targets[n], STR_PTR(subs[si]), STR_LEN(subs[si]));
        wb_append(&targets[n], STR_PTR("/skills/sa-vm/SKILL.md"), STR_LEN("/skills/sa-vm/SKILL.md"));
        n = n + 1;
    }
    if has_thread {
        let s: u64 = 0;
        let l: u64 = 0;
        ws_trim_range(thread_ptr, thread_len, &s, &l);
        if l > 0 {
            let safe = WsBuf { bytes: [0; 1048576], len: 0 };
            sanitize_thread_id(thread_ptr, thread_len, &safe);
            targets[n].len = 0;
            wb_append(&targets[n], cwd_ptr, cwd_len);
            wb_append(&targets[n], STR_PTR("/.codex-ultra/thread-skills/"), STR_LEN("/.codex-ultra/thread-skills/"));
            wb_append(&targets[n], wb_ptr(&safe), safe.len);
            wb_append(&targets[n], STR_PTR("/sa-vm/SKILL.md"), STR_LEN("/sa-vm/SKILL.md"));
            n = n + 1;
        };
    };
    let en: u64 = 2;
    if enabled { en = 1; };
    let base = WsBuf { bytes: [0; 1048576], len: 0 };
    buildSaVmWorkspaceSkillMarkdown(policy, has_policy, en, jev_active, true, &base);
    let tools_in = JevToolsIn { jevChoose_has: false, jevChoose: false, jevChecklist_has: false, jevChecklist: false, jevEvaluate_has: false, jevEvaluate: false, jevThinking_has: false, jevThinking: false, jevRedteam_has: false, jevRedteam: false, jevRank_has: false, jevRank: false, jevScope_has: false, jevScope: false, jevDispatch_has: false, jevDispatch: false, jevConsistency_has: false, jevConsistency: false, jevDone_has: false, jevDone: false, jevDiagnose_has: false, jevDiagnose: false, jevEdgeCases_has: false, jevEdgeCases: false, jevBlastRadius_has: false, jevBlastRadius: false, jevIntent_has: false, jevIntent: false, jevNext_has: false, jevNext: false, jevCompress_has: false, jevCompress: false, jevProgress_has: false, jevProgress: false, jevMemory_has: false, jevMemory: false, has_tools: false };
    jevToolsFromPolicy(policy, has_policy, &tools_in);
    let base_jev = WsBuf { bytes: [0; 1048576], len: 0 };
    let jev_st = buildJevWorkspaceSkillMarkdown(&tools_in, jev_active, true, &base_jev);
    let has_jev = jev_st == 0;
    for ti in 0..n {
        let tp = wb_ptr(&targets[ti]);
        let tl = targets[ti].len;
        let dir = WsBuf { bytes: [0; 1048576], len: 0 };
        ws_dirname(tp, tl, &dir);
        sa_fs_mkdir_p_ws(wb_ptr(&dir), dir.len);
        let tool = WsBuf { bytes: [0; 1048576], len: 0 };
        let tool_st = skillToolNameForPath(tp, tl, &tool);
        let content = WsBuf { bytes: [0; 1048576], len: 0 };
        applySkillToolNameMapping(wb_ptr(&base), base.len, wb_ptr(&tool), tool.len, tool_st == 0, &content);
        if tool_st != 0 && needsSharedSkillMappingNote(tp, tl) {
            // prepend SHARED note when not already included
            if !ws_contains(wb_ptr(&content), content.len, STR_PTR("工具名按环境映射"), STR_LEN("工具名按环境映射")) {
                let with_note = WsBuf { bytes: [0; 1048576], len: 0 };
                // DEFECT: TS inserts SHARED_SKILL_TOOL_MAPPING_NOTE
                // .trim() -- trimming approximated by the trim
                // range inside insertNoteAfterFrontmatter's note
                // handling.
                insertNoteAfterFrontmatter(wb_ptr(&content), content.len, STR_PTR(SHARED_SKILL_TOOL_MAPPING_NOTE), STR_LEN(SHARED_SKILL_TOOL_MAPPING_NOTE), &with_note);
                content.len = 0;
                wb_append(&content, wb_ptr(&with_note), with_note.len);
            };
        };
        sa_fs_write_file(tp, tl, wb_ptr(&content), content.len);
        // jev sibling: dirname(dirname(target))/jev/SKILL.md
        let parent = WsBuf { bytes: [0; 1048576], len: 0 };
        ws_dirname(wb_ptr(&dir), dir.len, &parent);
        let jev_dir = WsBuf { bytes: [0; 1048576], len: 0 };
        jev_dir.len = 0;
        wb_append(&jev_dir, wb_ptr(&parent), parent.len);
        wb_append(&jev_dir, STR_PTR("/jev"), STR_LEN("/jev"));
        let jev_file = WsBuf { bytes: [0; 1048576], len: 0 };
        jev_file.len = 0;
        wb_append(&jev_file, wb_ptr(&jev_dir), jev_dir.len);
        wb_append(&jev_file, STR_PTR("/SKILL.md"), STR_LEN("/SKILL.md"));
        if has_jev {
            let mapped = WsBuf { bytes: [0; 1048576], len: 0 };
            applySkillToolNameMapping(wb_ptr(&base_jev), base_jev.len, wb_ptr(&tool), tool.len, tool_st == 0, &mapped);
            let final_jev = WsBuf { bytes: [0; 1048576], len: 0 };
            if tool_st != 0 && needsSharedSkillMappingNote(wb_ptr(&jev_file), jev_file.len) && !ws_contains(wb_ptr(&mapped), mapped.len, STR_PTR("工具名按环境映射"), STR_LEN("工具名按环境映射")) {
                insertNoteAfterFrontmatter(wb_ptr(&mapped), mapped.len, STR_PTR(SHARED_SKILL_TOOL_MAPPING_NOTE), STR_LEN(SHARED_SKILL_TOOL_MAPPING_NOTE), &final_jev);
            } else {
                final_jev.len = 0;
                wb_append(&final_jev, wb_ptr(&mapped), mapped.len);
            };
            sa_fs_mkdir_p_ws(wb_ptr(&jev_dir), jev_dir.len);
            sa_fs_write_file(wb_ptr(&jev_file), jev_file.len, wb_ptr(&final_jev), final_jev.len);
        } else if ws_exists(wb_ptr(&jev_file), jev_file.len) && isGeneratedJevWorkspaceSkill(wb_ptr(&jev_file), jev_file.len) {
            sa_fs_remove_dir_all(wb_ptr(&jev_dir), jev_dir.len);
        };
        // legacy cheatsheet removal
        let legacy = WsBuf { bytes: [0; 1048576], len: 0 };
        legacy.len = 0;
        wb_append(&legacy, wb_ptr(&dir), dir.len);
        wb_append(&legacy, STR_PTR("/BUN_TS_CHEATSHEET.md"), STR_LEN("/BUN_TS_CHEATSHEET.md"));
        if ws_exists(wb_ptr(&legacy), legacy.len) {
            sa_fs_remove_file(wb_ptr(&legacy), legacy.len);
        };
    }
    out_first.len = 0;
    wb_append(out_first, wb_ptr(&targets[0]), targets[0].len);
    return 0;
}

// workspaceSkillKey: resolve(trim(cwd)), lowercased on win32.
// DEFECT: resolve() normalization + platform check approximated.
fn workspaceSkillKey(cwd_ptr: ptr, cwd_len: u64, out: &WsBuf) -> void {
    let s: u64 = 0;
    let l: u64 = 0;
    ws_trim_range(cwd_ptr, cwd_len, &s, &l);
    out.len = 0;
    let seg: ptr = PTR_NULL();
    PTR_BYTE_ADD(seg, cwd_ptr, s);
    wb_append(out, seg, l);
}

// DEFECT: the inflight/failure/explicit-root maps are module
// state; in this conversion the sync entry points execute
// sequentially and keep no cross-call state (noted per function).
struct SyncResult {
    // path text when enabled; enabled flag; salaRoot text
    path: WsBuf,
    has_path: bool,
    enabled: bool,
    salaRoot: WsBuf,
}

fn syncSaVmWorkspaceSkillDirectoryNow(cwd_ptr: ptr, cwd_len: u64, thread_ptr: ptr, thread_len: u64, has_thread: bool, enabled: u64, sala_root_ptr: ptr, sala_root_len: u64, has_sala_root: bool, policy: u64, has_policy: bool, jev_active: u64, result: &SyncResult) -> i32 {
    // jev_active: 0 = undefined, 1 = true, 2 = false
    let effective_sala = WsBuf { bytes: [0; 1048576], len: 0 };
    resolveSaVmHelpRoot(cwd_ptr, cwd_len, sala_root_ptr, sala_root_len, has_sala_root, cwd_ptr, cwd_len, &effective_sala);
    let is_enhance = has_policy && hasEnhanceToolsEnabledApprox(policy);
    let is_vm = enabled == 1;
    let effective_enabled = is_vm || is_enhance;
    result.salaRoot.len = 0;
    wb_append(&result.salaRoot, wb_ptr(&effective_sala), effective_sala.len);
    if !effective_enabled {
        cleanupAllWorkspaceSaVmSkills(cwd_ptr, cwd_len, thread_ptr, thread_len, has_thread);
        result.has_path = false;
        result.enabled = false;
        return 0;
    };
    // 打开即全量: jev defaults on unless explicitly false
    let jev_on = jev_active != 2;
    let first = WsBuf { bytes: [0; 1048576], len: 0 };
    let st = forceUpdateWorkspaceSkill(cwd_ptr, cwd_len, thread_ptr, thread_len, has_thread, is_vm, policy, has_policy, jev_on, &first);
    if st != 0 { return st; };
    result.path.len = 0;
    wb_append(&result.path, wb_ptr(&first), first.len);
    result.has_path = true;
    result.enabled = true;
    return 0;
}

fn syncSaVmWorkspaceSkillDirectory(cwd_ptr: ptr, cwd_len: u64, thread_ptr: ptr, thread_len: u64, has_thread: bool, enabled: u64, sala_root_ptr: ptr, sala_root_len: u64, has_sala_root: bool, policy: u64, has_policy: bool, jev_active: u64, result: &SyncResult) -> i32 {
    // TS: registers the root in explicitSkillPolicyRoots, chains
    // onto the previous inflight job for the same root, records
    // failures for the preload barrier. DEFECT: chaining/state
    // -> direct sequential call.
    return syncSaVmWorkspaceSkillDirectoryNow(cwd_ptr, cwd_len, thread_ptr, thread_len, has_thread, enabled, sala_root_ptr, sala_root_len, has_sala_root, policy, has_policy, jev_active, result);
}

fn waitForWorkspaceSkillSyncs(cwd_ptr: ptr, cwd_len: u64) -> i32 {
    // TS: awaits inflight jobs for the root, then rethrows a
    // recorded failure. No inflight state here -> always ok.
    return 0;
}

fn waitForProjectSaVmAssets(cwd_ptr: ptr, cwd_len: u64) -> i32 {
    let st = waitForWorkspaceSkillSyncs(cwd_ptr, cwd_len);
    return st;
}

// bootstrapProjectSaVmAssets: fire-and-forget in TS (returns
// void, job runs in background). DEFECT: executed synchronously
// here; the inflight/cooldown dedupe collapses to the
// SA_VM_BOOTSTRAP_DISABLED check + existence checks.
fn bootstrapProjectSaVmAssets(cwd_ptr: ptr, cwd_len: u64, thread_ptr: ptr, thread_len: u64, has_thread: bool) -> void {
    let s: u64 = 0;
    let l: u64 = 0;
    ws_trim_range(cwd_ptr, cwd_len, &s, &l);
    if l == 0 { return; };
    let ev = sa_env_get(STR_PTR("SA_VM_BOOTSTRAP_DISABLED"), STR_LEN("SA_VM_BOOTSTRAP_DISABLED"));
    if ev != 0 {
        let vp = sa_env_buffer_data(ev);
        let vl = sa_env_buffer_len(ev);
        let es: u64 = 0;
        let el: u64 = 0;
        ws_trim_range(vp, vl, &es, &el);
        let eseg: ptr = PTR_NULL();
        PTR_BYTE_ADD(eseg, vp, es);
        if ws_eq(eseg, el, STR_PTR("1"), STR_LEN("1")) { return; };
    };
    // pluginHostServices().saVm.ensureProjectBundleInstalled(cwd)
    // -- errors swallowed in TS.
    // DEFECT: host-services table call (see hostServices.sla);
    // invoked via pluginHostServices() status only.
    let hs_status: u64 = 0;
    let hs = PluginHostServices { revision: 0, saVm: 0, saVm_len: 0, has_saVm: false };
    pluginHostServices(&hs_status, &hs);
    // fallback sync only when no skill file exists yet
    let p1 = WsBuf { bytes: [0; 1048576], len: 0 };
    workspaceSaVmSkillPath(cwd_ptr, cwd_len, thread_ptr, thread_len, has_thread, STR_PTR(""), 0, false, &p1);
    let p2 = WsBuf { bytes: [0; 1048576], len: 0 };
    workspaceSaVmSkillPath(cwd_ptr, cwd_len, STR_PTR(""), 0, false, STR_PTR(""), 0, false, &p2);
    if !ws_exists(wb_ptr(&p1), p1.len) && !ws_exists(wb_ptr(&p2), p2.len) {
        let result = SyncResult { path: WsBuf { bytes: [0; 1048576], len: 0 }, has_path: false, enabled: false, salaRoot: WsBuf { bytes: [0; 1048576], len: 0 } };
        syncSaVmWorkspaceSkillDirectory(cwd_ptr, cwd_len, thread_ptr, thread_len, has_thread, 1, STR_PTR(""), 0, false, 0, false, 1, &result);
    };
}

// DEFECT: mkdir -p variant (sa_fs_mkdir_p_ws) has no sa_std
// counterpart (gap 3: sa_std fs has no mkdir -p); its call sites
// stay unbound. Recursive rm binds the real sa_fs_remove_dir_all.

