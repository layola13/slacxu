// ${SA_VM_WORKSPACE_SKILL_MARKER}
//
// # 封装函数工具使用指南 (Packaged Function Tools Guide)
//
// > 速查（先看这 3 个，带全参一次调对，严禁发空 \`{}\`）：
// > \`mcp__sa_vm__sa_vm_run({"action":"list_dir","dir":"."})\`（Muse 经 MCP 名；mini 等原生环境用 \`sa_vm_run\` 同参）
// > \`mcp__sa_vm__sa_vm_run({"action":"read_file","path":"package.json"})\`
// > \`mcp__sa_vm__sa_vm_run({"action":"grep_search","query":"foo","dir":"."})\`
// > 不确定先调哪个 → 默认 \`list_dir\`（\`dir:"."\`）；空 \`{}\` 只会返回目录探针，不算答案，不要重发 \`{}\`。
//
// ${statusRule}
//
// ${sections.join("\n\n")}
// `;
// }
//

// ---- buildSaVmBunTsCheatsheetMarkdown body (source lines 1705-1871, verbatim) ----
// export function buildSaVmBunTsCheatsheetMarkdown(_input: { cwd?: string; salaRoot?: string } = {}): string {
//   return `# Codex Ultra 封装函数工具速查 (Packaged Function Tools)
//
// > **核心准则**：本工作区已开启安全策略与封装原生工具支持。**只用封装动作，不手写脚本源码（严禁传递 \`source\` / \`language\`，复杂计算走轨道 2 受限 TS）！**
// > 大模型必须直接调用 \`sa_vm_run\` 传入封装好的动作参数（\`action\`），底层将以原生极速毫秒级执行。
//
// ---
//
// ## 一、常用操作速查表
//
// | 操作 | 对应 action | 必填参数 | 说明 |
// | :--- | :--- | :--- | :--- |
// | 多文件补丁应用 | \`apply_patch\` | \`patch\` | 应用结构化统一补丁，多文件批量原子修改与备份 |
// | 搜索文件列表 | \`find_files\` | \`dir\`, \`pattern\` | 极速遍历匹配模式的文件 |
// | 目录结构清单 | \`list_dir\` | \`dir\` | 列出目录树（gitignore 感知，支持 depth/type/pattern/path_pattern/exclude_dirs，结果按名排序） |
// | 代码文本搜索 | \`grep_search\` | \`query\`, \`dir\` | 快速全文关键字匹配搜索（自动跳过大文件/二进制，支持 max_file_bytes/exclude_dirs） |
// | 异步并发搜索 | \`grep_search_async\` | \`query\` / \`queries\`, \`dir\` | 16 并发极速异步搜索，支持单词或批量多词查找 |
// | 工程批量大纲 | \`workspace_outline\` | \`dir\` | 一次拿下整个目录的结构地图（gitignore 感知，按 max_tokens 熔断），大库探索首选 |
// | 全局符号图谱 | \`repo_map\` | \`dir\` | 全局符号定义、依赖图与模块边界地图，自带缓存与毫秒级增量索引 |
// | 快速验证闭环 | \`verify_loop\` | \`files\` / \`dir\` | 真实语法与安全验证裁判，针对改动文件秒级验证，返回 pass/fail 与行号 |
// | 批量文件读取 | \`read_many\` | \`files\` | 一次读取最多 10 个文件（可选同切片行号范围），省交互轮次 |
// | 读取文件内容 | \`read_file\` | \`path\` | 安全读取文件内容，自带 max_tokens 上下文溢出保护与压缩 JS 分页 |
// | 按行切片读取 | \`read_lines\` | \`path\`, \`start_line\`, \`end_line\` | 大文件按行切片读取 |
// | 尾部切片读取 | \`read_file_tail\` | \`path\`, \`lines\` | 高效从文件末尾反向读取指定行数（日志/报错排查首选） |
// | 极速统计行数 | \`count_lines\` | \`path\` | 毫秒级统计文本文件真实总行数，杜绝终端 PowerShell .Count |
// | 检查文件存在/状态 | \`test_path\` / \`file_info\` | \`path\` | 物理磁盘直读文件存在性、大小、修改时间与真实总行数，对等替代 PowerShell Test-Path |
// | 创建目录 | \`ensure_dir\` / \`mkdir\` | \`path\` | 递归创建目录（对等替代 mkdir -p） |
// | 创建/写入文件 | \`write_file\` | \`path\`, \`content\` | 写入文件，覆写前自动备份 |
// | 精确局部替换 | \`edit_file\` | \`path\`, \`old_text\`, \`new_text\` | 替换文本，替换前自动备份 |
// | 安全删除文件 | \`delete_file\` | \`path\` | 安全删除文件，删除前自动备份 |
// | 移动/重命名 | \`move_file\` | \`from\`, \`to\` | 安全重命名或移动路径 |
// | 复制文件 | \`copy_file\` | \`from\`, \`to\` | 安全复制文件至目标路径 |
// | 批处理并行任务 | \`parallel\` | \`parallel\` | 并发执行多个独立任务（最多 32 个，多文件内容写入与并发读取优先） |
// | 受控工程验证 | \`run_project_check\` | \`profile\` | 策略允许时运行服务端白名单工程验证（如 web-typecheck, server-test-file） |
// | 受控 Bun 执行 | \`run_bun\` | \`subcommand\` | 策略允许时在沙箱中运行受限 bun 命令（test, run, build, --filter） |
// | 整理清理导入 | \`organize_imports\` | \`path\` | AST 级自动清除未用 import、合并同源导入与规范排序 |
// | 分析代码块作用域 | \`analyze_scope\` | \`path\`, \`start_line\`, \`end_line\` | 分析自由变量与闭包依赖，生成子组件 Props 接口与调用示例 |
// | 运行 Node 脚本 | \`run_js\` | \`content\` | 策略允许时执行 JS/TS（默认禁用） |
// | 运行 Python 脚本 | \`run_py\` | \`content\` | 策略允许时执行 Python（默认禁用，严禁绕过沙箱） |
// | HTTP 数据请求 | \`http_fetch\` | \`url\` | 策略允许时发起网络请求 |
//
// ---
//
// ## 终端常用命令映射表 (PowerShell / Bash -> sa_vm_run)
//
// | 原生命令 | 推荐对等 \`sa_vm_run\` 调用 |
// | :--- | :--- |
// | \`Test-Path file.ext\` | \`sa_vm_run({ action: 'test_path', path: 'file.ext' })\` |
// | \`Get-ChildItem -Directory \\| Select FullName\` | \`sa_vm_run({ action: 'list_dir', dir: '.', type: 'directory' })\` |
// | \`Get-ChildItem bin \\| Format-Table\` | \`sa_vm_run({ action: 'list_dir', dir: 'bin', max_entries: 50, depth: 1 })\` |
// | \`Get-Content file \\| Select -First 200\` | \`sa_vm_run({ action: 'read_lines', path: 'file', start_line: 1, end_line: 200 })\` |
// | \`Get-Content F \\| Select-String P \\| Select -First N\` | \`sa_vm_run({ action: 'grep_search', path: 'F', query: 'P', max_matches: N })\` |
// | \`Select-String -Path F -Pattern P\` | \`sa_vm_run({ action: 'grep_search', path: 'F', query: 'P' })\` |
// | \`Set-Content -Path F -Encoding UTF8\` | \`sa_vm_run({ action: 'write_file', path: 'F', content: '...' })\` |
// | \`mkdir dir / New-Item -ItemType Directory\` | \`sa_vm_run({ action: 'ensure_dir', path: 'dir' })\` |
//
// ---
//
// ## 二、JSON 调用范例
//
// ### 1. 查找文件列表
// \`\`\`json
// {
//   "action": "find_files",
//   "dir": ".",
//   "pattern": "*"
// }
// \`\`\`
//
// ### 2. 读取文件
// \`\`\`json
// {
//   "action": "read_file",
//   "path": "package.json"
// }
// \`\`\`
//
// ### 3. 写入新文件
// \`\`\`json
// {
//   "action": "write_file",
//   "path": "output.txt",
//   "content": "Hello World"
// }
// \`\`\`
//
// ### 4. 局部替换文本
// \`\`\`json
// {
//   "action": "edit_file",
//   "path": "output.txt",
//   "old_text": "World",
//   "new_text": "Ultra"
// }
// \`\`\`
//
// ### 5. 受控工程验证与单测 (run_project_check)
// \`\`\`json
// {
//   "action": "run_project_check",
//   "profile": "server-test-file",
//   "test_file": "tests/server/saVmTool.test.ts"
// }
// \`\`\`
//
// ### 6. 受控 Bun 命令执行 (run_bun)
// \`\`\`json
// {
//   "action": "run_bun",
//   "subcommand": "test",
//   "args": ["tests/server/foo.test.ts"]
// }
// \`\`\`
//
// ### 7. 批处理并行任务 (parallel，多文件写入优先)
// \`\`\`json
// {
//   "concurrency": 4,
//   "parallel": [
//     { "action": "edit_file", "path": "file1.txt", "old_text": "old", "new_text": "new" },
//     { "action": "edit_file", "path": "file2.txt", "old_text": "old", "new_text": "new" }
//   ]
// }
// \`\`\`
//
// ### 8. 尾部读取文件/日志 (read_file_tail)
// \`\`\`json
// {
//   "action": "read_file_tail",
//   "path": "logs/app.log",
//   "lines": 100
// }
// \`\`\`
//
// ### 9. 异步并发批量检索 (grep_search_async)
// \`\`\`json
// {
//   "action": "grep_search_async",
//   "queries": ["fetchUser", "updateUser", "deleteUser"],
//   "dir": "src",
//   "pattern": "*.ts"
// }
// \`\`\`
//
// ### 10. 整理清理导入语句 (organize_imports)
// \`\`\`json
// {
//   "action": "organize_imports",
//   "path": "apps/web/src/App.tsx",
//   "dry_run": false
// }
// \`\`\`
//
// ### 11. 代码块作用域与闭包依赖分析 (analyze_scope)
// \`\`\`json
// {
//   "action": "analyze_scope",
//   "path": "apps/web/src/App.tsx",
//   "start_line": 200,
//   "end_line": 350,
//   "component_name": "ExtractedChild"
// }
// \`\`\`
// `;
// }
//
