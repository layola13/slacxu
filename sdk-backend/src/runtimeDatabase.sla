// Converted 1:1 from sdk-backend/src/runtimeDatabase.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.

@import "runtimeDetect.sla"

// DEFECT: createRequire(import.meta.url) + dynamic require of
// "bun:sqlite" / "node:sqlite" / "better-sqlite3" has no SLA
// counterpart; sa_std has no SQLite binding in this conversion.
// RuntimeDatabase is a handle + function-pointer table; the open
// functions record which driver WOULD be selected and return a
// status: 0 ok, 3 = the TS "No SQLite driver available" throw.
// DEFECT: throw new Error(...) -> status code 3 + error text kept
// as a constant below.

struct RuntimeDatabase {
    // exec(sql: string): void
    exec: ptr,
    // prepare(sql: string): any  // DEFECT: `any` return
    prepare: ptr,
    // close(): void
    close: ptr,
    // driver tag: 1 = bun:sqlite, 2 = node:sqlite, 3 = better-sqlite3
    driver: u64,
    handle: u64,
}

let NO_SQLITE_DRIVER_ERROR = "No SQLite driver available on the Node.js track: built-in node:sqlite requires Node.js >= 22.13. Upgrade Node instead of installing better-sqlite3 (native builds are not required).";

fn openRuntimeDatabase(file_ptr: ptr, file_len: u64, out: &RuntimeDatabase) -> i32 {
    if isBunRuntime {
        // const { Database } = require("bun:sqlite"); return new Database(file);
        // DEFECT: dynamic require/constructor -> driver tag only.
        out.driver = 1;
        out.handle = 0;
        return 0;
    };
    return openNodeRuntimeDatabase(file_ptr, file_len, false, false, out);
}

struct NodeSqliteOptions {
    has_readonly: bool,
    readonly: bool,
}

// Node.js track SQLite driver. Built-in `node:sqlite` is the only supported
// driver: it needs no install and no native compilation, which keeps fresh
// machines (e.g. FreeBSD with only `pkg install node`) working out of the box.
// `better-sqlite3` is never installed or built by us; it is only reused
// passively when already present (e.g. an existing desktop install).
fn openNodeRuntimeDatabase(file_ptr: ptr, file_len: u64, has_opts: bool, readonly_opt: bool, out: &RuntimeDatabase) -> i32 {
    // const sqlite = loadNodeSqlite();
    if loadNodeSqlite() {
        // return new sqlite.DatabaseSync(file, { ...rest, readOnly })
        // DEFECT: options object spread -> only readonly carried.
        out.driver = 2;
        out.handle = 0;
        return 0;
    };
    // try require("better-sqlite3") -> catch -> throw
    // DEFECT: presence probe of an optional native module has no
    // counterpart; the fallthrough reports the TS throw.
    out.driver = 3;
    out.handle = 0;
    return 3;
}

fn loadNodeSqlite() -> bool {
    // try { return require("node:sqlite") } catch { return null }
    // DEFECT: always reports unavailable in the bulk pass; wiring
    // to a real sa_std sqlite surface is a fix-phase item.
    return false;
}
