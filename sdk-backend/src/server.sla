// Converted 1:1 from sdk-backend/src/server.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
// Server side of the plugin SDK. A plugin's server entry point exports a
// `ServerPlugin`; the server host holds one live engine per installed
// plugin and routes work to it by plugin id.

// DEFECT: interfaces + Promise methods + string-union types ->
// function-pointer table structs, string fields as fixed buffers,
// unions as string fields with the value set in comments.
// PluginManifest comes from ./index.ts (index.sla).

struct EngineStatus {
    // phase: "stopped" | "starting" | "ready" | "error"
    phase: [u8; 16],
    phase_len: u64,
    has_transport: bool,
    transport: [u8; 64],
    transport_len: u64,
    has_version: bool,
    version: [u8; 64],
    version_len: u64,
    has_error: bool,
    error: [u8; 1024],
    error_len: u64,
}

// One discovered installation of the plugin's CLI on this machine.
struct PluginInstallation {
    // Absolute path to the executable.
    path: [u8; 4096],
    path_len: u64,
    // Probed version string, when the binary answered a version probe.
    has_version: bool,
    version: [u8; 128],
    version_len: u64,
    // How it was found: "well-known-dir" | "path" | "env"
    source: [u8; 16],
    source_len: u64,
}

struct RpcContext {
    // Authenticated user id, or "local" in local-token mode.
    ownerId: [u8; 128],
    ownerId_len: u64,
    // The API session the call belongs to.
    has_apiSessionId: bool,
    apiSessionId: [u8; 128],
    apiSessionId_len: u64,
}

// A live engine for one installed plugin. The engine owns its threads end
// to end and stamps its own plugin id on every thread/session object it
// returns — identity is never re-derived by the host.
struct EngineHandle {
    // readonly pluginId: string
    pluginId: [u8; 128],
    pluginId_len: u64,
    // start(): Promise<EngineStatus>  // DEFECT: async
    start: ptr,
    // stop(): Promise<void>  // DEFECT: async
    stop: ptr,
    // status(): EngineStatus
    status: ptr,
    // handleRpc(method, params: Record<string, unknown>, ctx): Promise<unknown>
    // DEFECT: async; throws Error -> status code in implementations;
    // dynamic params/result -> JSON text buffers.
    handleRpc: ptr,
}

struct ServerHost {
    // dataDir(pluginId: string): string
    dataDir: ptr,
    // workspaceRoot(): string
    workspaceRoot: ptr,
    // log(pluginId: string, message: string): void
    log: ptr,
}

// The per-backend discovery knowledge a plugin owns (see TS doc).
struct CliDiscoverySpec {
    // binaryNames: readonly string[] -> fixed table, newline-joined
    binaryNames_flat: [u8; 1024],
    binaryNames_flat_len: u64,
    binaryNames_count: u64,
    // envBinVars: readonly string[]
    envBinVars_flat: [u8; 1024],
    envBinVars_flat_len: u64,
    envBinVars_count: u64,
    // matchesKind(entry: { path: string; version?: string }): boolean
    matchesKind: ptr,
    // preferredPathPrefKey?: string
    has_preferredPathPrefKey: bool,
    preferredPathPrefKey: [u8; 128],
    preferredPathPrefKey_len: u64,
}

// Host wiring a CLI plugin declares for its Settings toggle (R3).
struct CliSettingsDeclaration {
    // Route slug: the toggle lives at /api/codex/settings/<slug>.
    slug: [u8; 64],
    slug_len: u64,
    // Env var that enables the plugin by default (1/true/yes).
    enabledEnvVar: [u8; 128],
    enabledEnvVar_len: u64,
    // Key under which the toggle URL appears in the settings links document.
    has_linkKey: bool,
    linkKey: [u8; 128],
    linkKey_len: u64,
}

struct ServerPlugin {
    // readonly manifest: PluginManifest (index.sla)
    manifest: u64,
    // readonly cliSettings?: CliSettingsDeclaration
    has_cliSettings: bool,
    cliSettings: CliSettingsDeclaration,
    // readonly officialProviderId?: string
    has_officialProviderId: bool,
    officialProviderId: [u8; 128],
    officialProviderId_len: u64,
    // createEngine(host: ServerHost): EngineHandle
    createEngine: ptr,
    // readonly discovery: CliDiscoverySpec
    discovery: CliDiscoverySpec,
    // findInstallations(env): Promise<PluginInstallation[]>  // DEFECT: async; env dynamic record
    findInstallations: ptr,
    // skillRoots(cwd: string): string[]
    skillRoots: ptr,
}

// export * from "./runtimeClient.ts" ->
@import "runtimeClient.sla"
