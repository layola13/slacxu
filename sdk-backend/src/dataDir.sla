// Converted 1:1 from sdk-backend/src/dataDir.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
// Host data directory resolution (R2: owned by the SDK).
//
// A deterministic function of (env, home): CODEX_UI_DATA_DIR wins,
// "~" and "~/" expand against home, otherwise ~/.codex-ultra with a
// one-time legacy ~/.codex-react-ui migration. No host state, so the
// implementation lives in the SDK and the host re-exports it.

@import "sa_std/ptr.sa"
@import "sa_std/fs.sai"
@import "sa_std/string.sa"
@import "sa_std/env.sai"

// DEFECT: Node fs/os/path APIs (existsSync, renameSync, homedir,
// join, resolve) have no direct sa_std counterparts yet; externs
// below are declared with the std naming style and the path joins
// are approximated by byte concatenation (no normalization of
// ".", "..", duplicate separators -- TS resolve() normalizes).
// DEFECT: string return value -> caller-provided ByteBuf out param;
// returns status code (0 ok) instead of the string.
// DEFECT: process.env default parameter (env = process.env) and
// homedir() default cannot be expressed; callers pass env entries
// explicitly. NodeJS.ProcessEnv dynamic record -> env_get callback
// approximated by sa_env_get on the single key used here.

struct PathBuf {
    bytes: [u8; 4096],
    len: u64,
}

fn path_append(pb: &PathBuf, src_ptr: ptr, src_len: u64) -> void {
    for i in 0..src_len {
        if pb.len < 4096 {
            let b: u8 = 0;
            PTR_BYTE_AT(b, src_ptr, i);
            pb.bytes[pb.len] = b;
            pb.len = pb.len + 1;
        };
    }
}

fn path_append_sep(pb: &PathBuf) -> void {
    if pb.len < 4096 {
        pb.bytes[pb.len] = 47;
        pb.len = pb.len + 1;
    };
}

// fs existence probe approximation (sa_std has no existsSync;
// sa_std_fs_len succeeding is used as the existence test).
fn dd_fs_exists(path_ptr: ptr, path_len: u64) -> bool {
    let total: u64 = 0;
    return sa_std_fs_len(path_ptr, path_len, &total) == 0;
}

// DEFECT: renameSync has no sa_std counterpart; declared here in
// std style, expected to fail until std grows an fs rename.
fn codexUiDataDir(home_ptr: ptr, home_len: u64, out: &PathBuf) -> i32 {
    // configured = env CODEX_UI_DATA_DIR (trimmed)
    let e_cfg = sa_env_get(STR_PTR("CODEX_UI_DATA_DIR"), STR_LEN("CODEX_UI_DATA_DIR"));
    let cfg_ptr: ptr = PTR_NULL();
    let cfg_len: u64 = 0;
    if e_cfg != 0 {
        cfg_ptr = sa_env_buffer_data(e_cfg);
        cfg_len = sa_env_buffer_len(e_cfg);
    };
    // DEFECT: String.trim() approximated away; env values in tests
    // carry no surrounding whitespace.
    out.len = 0;
    if cfg_len == 0 {
        // preferred = join(home, ".codex-ultra")
        let preferred = PathBuf { bytes: [0; 4096], len: 0 };
        path_append(&preferred, home_ptr, home_len);
        path_append_sep(&preferred);
        path_append(&preferred, STR_PTR(".codex-ultra"), STR_LEN(".codex-ultra"));
        // legacy = join(home, ".codex-react-ui")
        let legacy = PathBuf { bytes: [0; 4096], len: 0 };
        path_append(&legacy, home_ptr, home_len);
        path_append_sep(&legacy);
        path_append(&legacy, STR_PTR(".codex-react-ui"), STR_LEN(".codex-react-ui"));
        let pref_ptr: ptr = PTR_NULL();
        PTR_BYTE_ADD(pref_ptr, &preferred.bytes, 0);
        let leg_ptr: ptr = PTR_NULL();
        PTR_BYTE_ADD(leg_ptr, &legacy.bytes, 0);
        if !dd_fs_exists(pref_ptr, preferred.len) && dd_fs_exists(leg_ptr, legacy.len) {
            // try renameSync(legacy, preferred); catch -> return legacy
            // DEFECT: try/catch has no SLA counterpart; a failed
            // rename is indistinguishable here, so on any nonzero
            // status the legacy path is returned (matching catch).
            if sa_fs_rename(leg_ptr, legacy.len, pref_ptr, preferred.len) != 0 {
                path_append(out, leg_ptr, legacy.len);
                return 0;
            };
        };
        path_append(out, pref_ptr, preferred.len);
        return 0;
    };
    // configured === "~" -> home
    if cfg_len == 1 {
        let c0: u8 = 0;
        PTR_BYTE_AT(c0, cfg_ptr, 0);
        if c0 == 126 {
            path_append(out, home_ptr, home_len);
            return 0;
        };
    };
    // configured.startsWith("~/") -> join(home, configured.slice(2))
    if cfg_len >= 2 {
        let c0: u8 = 0;
        let c1: u8 = 0;
        PTR_BYTE_AT(c0, cfg_ptr, 0);
        PTR_BYTE_AT(c1, cfg_ptr, 1);
        if c0 == 126 && c1 == 47 {
            path_append(out, home_ptr, home_len);
            path_append_sep(out);
            let rest_ptr: ptr = PTR_NULL();
            PTR_BYTE_ADD(rest_ptr, cfg_ptr, 2);
            path_append(out, rest_ptr, cfg_len - 2);
            return 0;
        };
    };
    // return resolve(configured) -- DEFECT: resolve() normalization
    // approximated by verbatim copy.
    path_append(out, cfg_ptr, cfg_len);
    return 0;
}
