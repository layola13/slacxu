// Converted 1:1 from sdk-backend/src/service.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
// Service plugins (kind "service"): long-lived server features that are
// not agent backends — relay-station configuration, MCP hosting, skills
// hosting, … A service plugin has a lifecycle and may expose RPC
// namespaces to the workbench; its web side (when it has one) is a
// WebFeaturePlugin from the web SDK.

// DEFECT: TS interfaces + function types + interface extension
// (RelayConfigPlugin extends ServicePlugin) have no SLA
// counterpart; contracts are function-pointer table structs.
// PluginManifest comes from ./index.ts (index.sla); RpcContext is
// defined in server.sla (imported below).
// FIX PHASE (async): Promise methods are typed fn pointers
// returning future<i32> (ASYNC_MODEL R1/R2/R7 — await in async fn,
// or task::new/poll at a sync boundary). Convention: ctx (u64,
// implementer-owned state handle) first; dynamic values travel as
// JSON text buffers. DEFECT: Record<string, RpcHandler>
// rpcNamespaces -> fixed table of (name, handler) pairs. DEFECT:
// Promise<RelayStation | undefined> -> future status (0 ok,
// 1 undefined) + out param.

struct ServiceHost {
    // dataDir(pluginId: string): string
    dataDir: ptr,
    // log(pluginId: string, message: string): void
    log: ptr,
}

// RpcHandler = (method: string, params: Record<string, unknown>,
// ctx: RpcContext) => Promise<unknown>
// -> (method_ptr, method_len, params_ptr, params_len, &rpc_ctx,
//     out_ptr, out_cap, &out_len); params/result as JSON text.
struct RpcHandler {
    call: fn(ptr, u64, ptr, u64, &RpcContext, ptr, u64, &u64) -> future<i32>,
}

struct RpcNamespace {
    name: [u8; 64],
    name_len: u64,
    handler: RpcHandler,
}

struct ServicePlugin {
    // readonly manifest: PluginManifest (see index.sla)
    manifest: u64,
    // start(host: ServiceHost): Promise<void>
    start: fn(u64, &ServiceHost) -> future<i32>,
    // stop(): Promise<void>
    stop: fn(u64) -> future<i32>,
    // readonly rpcNamespaces?: Readonly<Record<string, RpcHandler>>
    rpcNamespaces: [RpcNamespace; 16],
    rpcNamespaces_count: u64,
}

@import "server.sla"

// One configured relay station (中转站). Secrets are references, never raw keys.
struct RelayStation {
    id: [u8; 128],
    id_len: u64,
    name: [u8; 256],
    name_len: u64,
    // Gateway base URL, e.g. "https://relay.example.com/v1".
    baseUrl: [u8; 1024],
    baseUrl_len: u64,
    // Reference to the API key in the host's secure storage.
    apiKeyRef: [u8; 256],
    apiKeyRef_len: u64,
    enabled: bool,
    // Model ids this relay is known to serve; empty = discover.
    // DEFECT: string[] -> fixed table of string buffers.
    models: [u8; 8192],
    models_flat_len: u64,
    models_count: u64,
}

// Relay-station configuration service (kind "service", id "relay-config").
// In TS this interface extends ServicePlugin; here the base table
// is embedded as the first field.
struct RelayConfigPlugin {
    base: ServicePlugin,
    // listRelays(): Promise<RelayStation[]>
    // -> (ctx, out_ptr, out_cap, &out_len); array as JSON text.
    listRelays: fn(u64, ptr, u64, &u64) -> future<i32>,
    // upsertRelay(relay: RelayStation): Promise<RelayStation>
    // -> (ctx, &relay, out_ptr, out_cap, &out_len); saved relay as
    // JSON text.
    upsertRelay: fn(u64, &RelayStation, ptr, u64, &u64) -> future<i32>,
    // removeRelay(id: string): Promise<boolean>
    // -> (ctx, id_ptr, id_len, &out_removed 1/0)
    removeRelay: fn(u64, ptr, u64, &u64) -> future<i32>,
    // resolveRelay(id: string): Promise<RelayStation | undefined>
    // -> (ctx, id_ptr, id_len, out_ptr, out_cap, &out_len);
    // future status 1 = undefined (no such relay).
    resolveRelay: fn(u64, ptr, u64, ptr, u64, &u64) -> future<i32>,
}

// ---- call helpers (see runtimeClient.sla for the probed
// fn-pointer reference-argument restriction these work around) ----
fn rpcCall(h: &RpcHandler, method_ptr: ptr, method_len: u64, params_ptr: ptr, params_len: u64, ctx: &RpcContext, out_ptr: ptr, out_cap: u64, out_len: &u64) -> future<i32> {
    let f = h.call;
    return f(method_ptr, method_len, params_ptr, params_len, ctx, out_ptr, out_cap, out_len);
}

fn spStart(p: &ServicePlugin, ctx: u64, host: &ServiceHost) -> future<i32> {
    let f = p.start;
    return f(ctx, host);
}

fn spStop(p: &ServicePlugin, ctx: u64) -> future<i32> {
    let f = p.stop;
    return f(ctx);
}

fn relayList(p: &RelayConfigPlugin, ctx: u64, out_ptr: ptr, out_cap: u64, out_len: &u64) -> future<i32> {
    let f = p.listRelays;
    return f(ctx, out_ptr, out_cap, out_len);
}

fn relayUpsert(p: &RelayConfigPlugin, ctx: u64, relay: &RelayStation, out_ptr: ptr, out_cap: u64, out_len: &u64) -> future<i32> {
    let f = p.upsertRelay;
    return f(ctx, relay, out_ptr, out_cap, out_len);
}

fn relayRemove(p: &RelayConfigPlugin, ctx: u64, id_ptr: ptr, id_len: u64, out_removed: &u64) -> future<i32> {
    let f = p.removeRelay;
    return f(ctx, id_ptr, id_len, out_removed);
}

fn relayResolve(p: &RelayConfigPlugin, ctx: u64, id_ptr: ptr, id_len: u64, out_ptr: ptr, out_cap: u64, out_len: &u64) -> future<i32> {
    let f = p.resolveRelay;
    return f(ctx, id_ptr, id_len, out_ptr, out_cap, out_len);
}
