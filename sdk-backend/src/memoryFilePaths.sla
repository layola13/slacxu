// Converted 1:1 from sdk-backend/src/memoryFilePaths.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
// Workspace/global memory file paths (R2: owned by the SDK).
//
// Pure path resolution: the data dir comes from CODEX_UI_DATA_DIR
// or ~/.codex-ultra; workspace files are keyed by a hash of the
// normalized workspace path. Extracted from the host's saVmTool,
// which re-exports them.

@import "sa_std/ptr.sa"
@import "sa_std/string.sa"
@import "sa_std/env.sai"
@import "sa_std/net.sai"
@import "dataDir.sla"

// node:crypto createHash("sha256") -- bound to the real sa_std
// extern sa_std_net_sha256_hex (sa_std/net.sai). DEFECT: node:path resolve/sep/join approximated by byte
// concatenation; resolve() absolutization/normalization not done.
// DEFECT: string returns -> PathBuf out params + status code.

// PathBuf + path_append come from dataDir.sla (identical
// definitions; the barrel index.sla cannot carry both).
fn base_data_dir(out: &PathBuf) -> void {
    out.len = 0;
    let e_cfg = sa_env_get(STR_PTR("CODEX_UI_DATA_DIR"), STR_LEN("CODEX_UI_DATA_DIR"));
    if e_cfg != 0 {
        let vp: ptr = sa_env_buffer_data(e_cfg);
        let vl = sa_env_buffer_len(e_cfg);
        if vl > 0 {
            path_append(out, vp, vl);
            return;
        };
    };
    let e_home = sa_env_get(STR_PTR("HOME"), STR_LEN("HOME"));
    if e_home != 0 {
        let hp: ptr = sa_env_buffer_data(e_home);
        let hl = sa_env_buffer_len(e_home);
        path_append(out, hp, hl);
    };
    path_append(out, STR_PTR("/.codex-ultra"), STR_LEN("/.codex-ultra"));
}

fn resolveGlobalMemoryFilePath(out: &PathBuf) -> i32 {
    base_data_dir(out);
    path_append(out, STR_PTR("/workspace-memory/global-memory.json"), STR_LEN("/workspace-memory/global-memory.json"));
    return 0;
}

fn resolveWorkspaceMemoryFilePath(workspace_ptr: ptr, workspace_len: u64, out: &PathBuf) -> i32 {
    // norm = resolve(workspaceDir).split(sep).join("/").toLowerCase()
    // DEFECT: resolve() approximated verbatim; platform separator
    // is "/" on the target platforms so split/join is identity.
    let norm = PathBuf { bytes: [0; 4096], len: 0 };
    for i in 0..workspace_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, workspace_ptr, i);
        if b >= 65 && b <= 90 { b = b + 32; };
        if norm.len < 4096 {
            norm.bytes[norm.len] = b;
            norm.len = norm.len + 1;
        };
    }
    let norm_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(norm_ptr, &norm.bytes, 0);
    let hex = [0; 64];
    let hex_len: u64 = 0;
    let hst: i32 = sa_std_net_sha256_hex(norm_ptr, norm.len, &hex, 64, &hex_len);
    if hst != 0 { return hst; };
    base_data_dir(out);
    path_append(out, STR_PTR("/workspace-memory/"), STR_LEN("/workspace-memory/"));
    let hex_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(hex_ptr, &hex, 0);
    path_append(out, hex_ptr, 64);
    path_append(out, STR_PTR(".json"), STR_LEN(".json"));
    return 0;
}

// MemoryScope: "workspace" | "global" -> 0 = workspace, 1 = global.
// DEFECT: string union type -> u64 tag.
// Normalize the `scope` param for note actions: workspace (default) | global. Never throws.
// DEFECT: `unknown` parameter -> raw (ptr,len); non-string inputs in
// TS collapse to "" -- callers pass len 0 for non-strings.
fn normalizeMemoryScope(raw_ptr: ptr, raw_len: u64) -> u64 {
    // v = raw.trim().toLowerCase(); approximated: lowercase scan with
    // leading/trailing space skip (trim of all whitespace kinds is
    // approximated by space-only).
    let start: u64 = 0;
    let end: u64 = raw_len;
    while start < end {
        let b: u8 = 0;
        PTR_BYTE_AT(b, raw_ptr, start);
        if b != 32 { break; };
        start = start + 1;
    }
    while end > start {
        let b: u8 = 0;
        PTR_BYTE_AT(b, raw_ptr, end - 1);
        if b != 32 { break; };
        end = end - 1;
    }
    let vlen = end - start;
    let vptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(vptr, raw_ptr, start);
    if str_eq_lower(vptr, vlen, STR_PTR("global"), STR_LEN("global")) { return 1; };
    if str_eq_lower(vptr, vlen, STR_PTR("user"), STR_LEN("user")) { return 1; };
    if str_eq_lower(vptr, vlen, STR_PTR("all-projects"), STR_LEN("all-projects")) { return 1; };
    return 0;
}

// DEFECT: helper not in TS source (String === after toLowerCase
// there); case-insensitive byte equality used as approximation.
fn str_eq_lower(a_ptr: ptr, a_len: u64, b_ptr: ptr, b_len: u64) -> bool {
    if a_len != b_len { return false; };
    for i in 0..a_len {
        let a: u8 = 0;
        let b: u8 = 0;
        PTR_BYTE_AT(a, a_ptr, i);
        PTR_BYTE_AT(b, b_ptr, i);
        if a >= 65 && a <= 90 { a = a + 32; };
        if a != b { return false; };
    }
    return true;
}
