// Converted 1:1 from sdk-backend/src/saVmPaths.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
// SA-VM MCP script/data path resolution (R2: owned by the SDK).
//
// Pure path probing (env + fs existence) with no host state: the
// global data dir derives from codexUiDataDir, the project dir from
// the workspace cwd, and the MCP script location from a candidate
// list. The host's saVmBundle keeps the installer and re-exports
// these helpers.

@import "sa_std/ptr.sa"
@import "dataDir.sla"
@import "sa_std/string.sa"
@import "sa_std/env.sai"

// DEFECT: string returns -> PathBuf out params; string[] return ->
// fixed-capacity PathBuf array + count. process.cwd() ->
// sa_env_get("PWD") approximation; process.platform /
// process.execPath have no sa_std counterpart (execPath read from
// /proc/self/exe is a later-stage concern) -> exe-dir candidate
// skipped with DEFECT. try/catch -> status branch. String.trim()
// approximated by space-only trim.

const SA_VM_MCP_SCRIPT_NAME = "sa-vm-mcp.mjs";

fn getSaVmGlobalDataDir(out: &PathBuf) -> i32 {
    let home = PathBuf { bytes: [0; 4096], len: 0 };
    let e_home = sa_env_get(STR_PTR("HOME"), STR_LEN("HOME"));
    if e_home != 0 {
        let hp: ptr = sa_env_buffer_data(e_home);
        let hl = sa_env_buffer_len(e_home);
        path_append(&home, hp, hl);
    };
    let home_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(home_ptr, &home.bytes, 0);
    codexUiDataDir(home_ptr, home.len, out);
    path_append(out, STR_PTR("/sa-vm"), STR_LEN("/sa-vm"));
    return 0;
}

fn getSaVmProjectDataDir(cwd_ptr: ptr, cwd_len: u64, out: &PathBuf) -> i32 {
    // root = (cwd ?? "").trim() || process.cwd()
    let root = PathBuf { bytes: [0; 4096], len: 0 };
    let s: u64 = 0;
    let e: u64 = cwd_len;
    while s < e {
        let b: u8 = 0;
        PTR_BYTE_AT(b, cwd_ptr, s);
        if b != 32 { break; };
        s = s + 1;
    }
    while e > s {
        let b: u8 = 0;
        PTR_BYTE_AT(b, cwd_ptr, e - 1);
        if b != 32 { break; };
        e = e - 1;
    }
    if e > s {
        let rp: ptr = PTR_NULL();
        PTR_BYTE_ADD(rp, cwd_ptr, s);
        path_append(&root, rp, e - s);
    } else {
        let e_pwd = sa_env_get(STR_PTR("PWD"), STR_LEN("PWD"));
        if e_pwd != 0 {
            let pp: ptr = sa_env_buffer_data(e_pwd);
            let pl = sa_env_buffer_len(e_pwd);
            path_append(&root, pp, pl);
        };
    };
    // join(resolve(root), ".codex-ultra", "sa-vm") -- DEFECT:
    // resolve() normalization approximated verbatim.
    out.len = 0;
    let root_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(root_ptr, &root.bytes, 0);
    path_append(out, root_ptr, root.len);
    path_append(out, STR_PTR("/.codex-ultra/sa-vm"), STR_LEN("/.codex-ultra/sa-vm"));
    return 0;
}

struct SaVmCandidates {
    items: [PathBuf; 8],
    count: u64,
}

fn candidates_push(c: &SaVmCandidates, p: &PathBuf) -> void {
    if c.count < 8 {
        let dst_ptr: ptr = PTR_NULL();
        PTR_BYTE_ADD(dst_ptr, &p.bytes, 0);
        // DEFECT: struct array element assignment approximated by
        // field-wise copy through path_append on a reset element.
        c.items[c.count].len = 0;
        path_append(&c.items[c.count], dst_ptr, p.len);
        c.count = c.count + 1;
    };
}

fn resolveSaVmMcpSourceCandidates(sourceRoot_ptr: ptr, sourceRoot_len: u64, has_sourceRoot: bool, out: &SaVmCandidates) -> i32 {
    out.count = 0;
    let tmp = PathBuf { bytes: [0; 4096], len: 0 };
    if has_sourceRoot && sourceRoot_len > 0 {
        // join(resolve(sourceRoot.trim()), SA_VM_MCP_SCRIPT_NAME)
        tmp.len = 0;
        path_append(&tmp, sourceRoot_ptr, sourceRoot_len);
        path_append(&tmp, STR_PTR("/"), STR_LEN("/"));
        path_append(&tmp, STR_PTR("sa-vm-mcp.mjs"), STR_LEN("sa-vm-mcp.mjs"));
        candidates_push(out, &tmp);
    };
    let fromEnv = sa_env_get(STR_PTR("SA_VM_MCP_SOURCE_PATH"), STR_LEN("SA_VM_MCP_SOURCE_PATH"));
    if fromEnv != 0 {
        let vp: ptr = sa_env_buffer_data(fromEnv);
        let vl = sa_env_buffer_len(fromEnv);
        if vl > 0 {
            tmp.len = 0;
            path_append(&tmp, vp, vl);
            candidates_push(out, &tmp);
        };
    };
    // join(process.cwd(), "scripts", SA_VM_MCP_SCRIPT_NAME)
    tmp.len = 0;
    let e_pwd = sa_env_get(STR_PTR("PWD"), STR_LEN("PWD"));
    if e_pwd != 0 {
        let pp: ptr = sa_env_buffer_data(e_pwd);
        let pl = sa_env_buffer_len(e_pwd);
        path_append(&tmp, pp, pl);
    };
    path_append(&tmp, STR_PTR("/scripts/sa-vm-mcp.mjs"), STR_LEN("/scripts/sa-vm-mcp.mjs"));
    candidates_push(out, &tmp);
    // join(getSaVmGlobalDataDir(), SA_VM_MCP_SCRIPT_NAME)
    tmp.len = 0;
    getSaVmGlobalDataDir(&tmp);
    path_append(&tmp, STR_PTR("/sa-vm-mcp.mjs"), STR_LEN("/sa-vm-mcp.mjs"));
    candidates_push(out, &tmp);
    // DEFECT: process.platform !== "win32" exec-dir candidate
    // (dirname(process.execPath)) skipped: no sa_std execPath.
    return 0;
}

// returns 0 = found (out holds the path), 1 = null in TS terms.
fn resolveSaVmMcpScriptPath(cwd_ptr: ptr, cwd_len: u64, has_cwd: bool, out: &PathBuf) -> i32 {
    if has_cwd && cwd_len > 0 {
        let proj = PathBuf { bytes: [0; 4096], len: 0 };
        getSaVmProjectDataDir(cwd_ptr, cwd_len, &proj);
        path_append(&proj, STR_PTR("/sa-vm-mcp.mjs"), STR_LEN("/sa-vm-mcp.mjs"));
        let pp: ptr = PTR_NULL();
        PTR_BYTE_ADD(pp, &proj.bytes, 0);
        if dd_fs_exists(pp, proj.len) {
            out.len = 0;
            path_append(out, pp, proj.len);
            return 0;
        };
    };
    let glob = PathBuf { bytes: [0; 4096], len: 0 };
    getSaVmGlobalDataDir(&glob);
    path_append(&glob, STR_PTR("/sa-vm-mcp.mjs"), STR_LEN("/sa-vm-mcp.mjs"));
    let gp: ptr = PTR_NULL();
    PTR_BYTE_ADD(gp, &glob.bytes, 0);
    if dd_fs_exists(gp, glob.len) {
        out.len = 0;
        path_append(out, gp, glob.len);
        return 0;
    };
    return 1;
}
