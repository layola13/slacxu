// Converted 1:1 from sdk-backend/src/codexVirtualConfig.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.

@import "sa_std/ptr.sa"
@import "dataDir.sla"
@import "runtimeClient.sla"

// DEFECT cluster (TOML): the TS module is built on smol-toml
// parse/stringify over a mutable TomlTable with full key
// enumeration. sa_std's TOML surface is READ-ONLY dotted-path
// getters (sa_toml_parse/get_*/array_*/table_len/kind) with no
// enumeration, no mutation and no serializer. In this conversion
// a TomlTable is carried as JSON text (its JSON twin), dotted
// reads go through sa_json chains, and mutations/serialization
// are structural approximations -- the TOML text <-> table
// conversion points are marked DEFECT inline. TomlDate/bigint
// handling in tomlToJson has no counterpart and is dropped.
// DEFECT: fs/promises (open "wx", stat mtime, chmod, unlink) ->
// sync sa_std fs calls + placeholder externs for the missing
// pieces (create-exclusive open, mtime, pid, sleep, clock).
// DEFECT: Promise queue (writeQueue) and the cached migration
// promise -> sequential calls + a done flag (single-threaded
// approximation of the serialization the queue provided).
// DEFECT: EventEmitter subclassing (VirtualConfigCodexRuntimeClient
// extends EventEmitter implements CodexRuntimeClient) -> struct
// wrapping the inner client handle; event forwarding recorded,
// not wired. throw -> status codes (3).

struct CfgBuf {
    bytes: [u8; 262144],
    len: u64,
}

fn cb_append(b: &CfgBuf, src_ptr: ptr, src_len: u64) -> void {
    for i in 0..src_len {
        if b.len < 262144 {
            let c: u8 = 0;
            PTR_BYTE_AT(c, src_ptr, i);
            b.bytes[b.len] = c;
            b.len = b.len + 1;
        };
    }
}

fn cb_ptr(b: &CfgBuf) -> ptr {
    let p: ptr = PTR_NULL();
    PTR_BYTE_ADD(p, &b.bytes, 0);
    return p;
}

struct ConfigEdit {
    keyPath: [u8; 512],
    keyPath_len: u64,
    // value: JsonValue -> JSON text ("null" for null)
    value_json: [u8; 65536],
    value_json_len: u64,
    value_is_null: bool,
    // mergeStrategy: 0 = "replace", 1 = "upsert"
    mergeStrategy: u64,
}

// THREAD_CONFIG_METHODS = { "thread/start", "thread/resume", "thread/fork" }
fn is_thread_config_method(m_ptr: ptr, m_len: u64) -> bool {
    if bytes_eq_str2(m_ptr, m_len, STR_PTR("thread/start"), STR_LEN("thread/start")) { return true; };
    if bytes_eq_str2(m_ptr, m_len, STR_PTR("thread/resume"), STR_LEN("thread/resume")) { return true; };
    if bytes_eq_str2(m_ptr, m_len, STR_PTR("thread/fork"), STR_LEN("thread/fork")) { return true; };
    return false;
}

fn bytes_eq_str2(a_ptr: ptr, a_len: u64, b_ptr: ptr, b_len: u64) -> bool {
    if a_len != b_len { return false; };
    for i in 0..a_len {
        let x: u8 = 0;
        let y: u8 = 0;
        PTR_BYTE_AT(x, a_ptr, i);
        PTR_BYTE_AT(y, b_ptr, i);
        if x != y { return false; };
    }
    return true;
}

// VIRTUAL_CONFIG_RELATIVE_PATH = join("virtual-codex", "config.toml")
const VIRTUAL_CONFIG_RELATIVE_PATH = "virtual-codex/config.toml";
const CONFIG_LOCK_TIMEOUT_MS: u64 = 5000;
const CONFIG_LOCK_STALE_MS: u64 = 30000;
const AGENT_INHERITANCE_MIGRATION_MARKER = ".agent-inheritance-v1";
// THREAD_SCOPED_CONFIG_KEYS = { "model_context_window" }
// SAFE_MULTI_AGENT_MIGRATION_PATHS = [features.multi_agent_v2,
// agents.enabled, agents.max_concurrent_threads_per_session]
// LEGACY_AGENT_DEFAULT_PATHS = [agents.default_subagent_model,
// agents.default_subagent_reasoning_effort]

fn resolveVirtualCodexConfigPath(home_ptr: ptr, home_len: u64, out: &CfgBuf) -> void {
    let dd = PathBuf { bytes: [0; 4096], len: 0 };
    codexUiDataDir(home_ptr, home_len, &dd);
    out.len = 0;
    let dp: ptr = PTR_NULL();
    PTR_BYTE_ADD(dp, &dd.bytes, 0);
    cb_append(out, dp, dd.len);
    cb_append(out, STR_PTR("/virtual-codex/config.toml"), STR_LEN("/virtual-codex/config.toml"));
}

fn resolveCodexUserConfigPath(home_ptr: ptr, home_len: u64, out: &CfgBuf) -> void {
    out.len = 0;
    let e_ch = sa_env_get(STR_PTR("CODEX_HOME"), STR_LEN("CODEX_HOME"));
    let got = false;
    if e_ch != 0 {
        let vp: ptr = sa_env_buffer_data(e_ch);
        let vl = sa_env_buffer_len(e_ch);
        // trim
        let s: u64 = 0;
        let e: u64 = vl;
        while s < e {
            let b: u8 = 0;
            PTR_BYTE_AT(b, vp, s);
            if b != 32 && b != 9 && b != 10 && b != 13 { break; };
            s = s + 1;
        }
        while e > s {
            let b: u8 = 0;
            PTR_BYTE_AT(b, vp, e - 1);
            if b != 32 && b != 9 && b != 10 && b != 13 { break; };
            e = e - 1;
        }
        if e > s {
            let tp: ptr = PTR_NULL();
            PTR_BYTE_ADD(tp, vp, s);
            cb_append(out, tp, e - s);
            got = true;
        };
    };
    if !got {
        cb_append(out, home_ptr, home_len);
        cb_append(out, STR_PTR("/.codex"), STR_LEN("/.codex"));
    };
    cb_append(out, STR_PTR("/config.toml"), STR_LEN("/config.toml"));
}

// A TomlTable in this conversion: JSON text of the table.
struct TomlTable {
    json: CfgBuf,
}

fn configVersion(content_ptr: ptr, content_len: u64, out: &CfgBuf) -> void {
    let hex = [0; 64];
    sa_sha256_hex(content_ptr, content_len, &hex);
    out.len = 0;
    cb_append(out, &hex, 64);
}

// load(): read file (missing -> ""), parse, strip thread-scoped.
// DEFECT: parse(content) via smol-toml -> the TOML->JSON table
// conversion is the missing capability; tableFromTomlText is a
// placeholder returning an empty table for empty input and the
// raw text otherwise (fix phase: real TOML reader).
fn store_load(path_ptr: ptr, path_len: u64, table: &TomlTable, version: &CfgBuf, threadScopedRemoved: &bool) -> i32 {
    let content = CfgBuf { bytes: [0; 262144], len: 0 };
    let st = read_text_file2(path_ptr, path_len, &content);
    if st == 3 {
        // missing file: content stays ""
        content.len = 0;
    } else if st != 0 {
        return st;
    };
    tableFromTomlText(cb_ptr(&content), content.len, table);
    threadScopedRemoved = removeThreadScopedConfig(table);
    configVersion(cb_ptr(&content), content.len, version);
    return 0;
}

// DEFECT: read_text_file2 mirrors the claudeSkillInventory
// helper (fs_len/open/read/close); status 3 = missing file
// (isMissingFile), 6 = other io error.
fn read_text_file2(path_ptr: ptr, path_len: u64, out: &CfgBuf) -> i32 {
    let total: u64 = 0;
    if sa_std_fs_len(path_ptr, path_len, &total) != 0 { return 3; };
    if total > 262144 { return 6; };
    let fh: u64 = 0;
    if sa_std_fs_open_read(path_ptr, path_len, &fh) != 0 { return 3; };
    out.len = 0;
    let chunk = [0; 4096];
    let guard: u64 = 0;
    while guard < 128 {
        let read_n: u64 = 0;
        let rst = sa_std_fs_file_read(fh, &chunk, 4096, &read_n);
        if rst != 0 {
            sa_fs_file_close(fh);
            return 6;
        };
        if read_n == 0 { break; };
        for ci in 0..read_n {
            if out.len < 262144 {
                out.bytes[out.len] = chunk[ci];
                out.len = out.len + 1;
            };
        }
        guard = guard + 1;
    }
    sa_fs_file_close(fh);
    return 0;
}

fn tableFromTomlText(text_ptr: ptr, text_len: u64, table: &TomlTable) -> void {
    // DEFECT: placeholder -- validates via sa_toml_parse when the
    // text is non-empty, but the table content is carried as an
    // empty JSON object in the bulk pass.
    if text_len > 0 {
        let doc = sa_toml_parse(text_ptr, text_len);
        if doc != 0 { sa_toml_free(doc); };
    };
    table.json.len = 0;
    cb_append(&table.json, STR_PTR("{}"), STR_LEN("{}"));
}

fn tableToTomlText(table: &TomlTable, out: &CfgBuf) -> void {
    // DEFECT: stringify(table) -- no TOML serializer in sa_std;
    // the JSON twin is emitted (wrong format, logged).
    out.len = 0;
    cb_append(out, cb_ptr(&table.json), table.json.len);
}

// Dotted-path read over the JSON twin: segments walked with
// sa_json_object_get. Returns node or 0 (undefined).
fn valueAtPath(root_node: u64, segs_ptr: ptr, segs_len: u64) -> u64 {
    // segs are a newline-joined flat list in a CfgBuf-like buffer;
    // this walker takes a JSON array node of segment strings
    // instead -- see valueAtPathSegs.
    return 0;
}

fn valueAtPathSegs(root_node: u64, segs: &[u8; 4096], seg_off: &[u64; 16], seg_len: &[u64; 16], seg_count: u64) -> u64 {
    let cur = root_node;
    for i in 0..seg_count {
        let sp: ptr = PTR_NULL();
        PTR_BYTE_ADD(sp, segs, seg_off[i]);
        let next: u64 = 0;
        if sa_json_object_get(cur, sp, seg_len[i], &next) != 0 { return 0; };
        cur = next;
    }
    return cur;
}

// DEFECT: setAtPath/deleteAtPath mutate the parsed TOML table;
// sa_json nodes are immutable here, so mutations are applied to
// the JSON text by rebuild -- not available in the bulk pass.
// Both are structural no-ops that report "unchanged" (false for
// delete) and are logged; every caller-visible flow that depends
// on them (persist/migrate/sync) inherits the gap.
fn setAtPath(table: &TomlTable, segs: &[u8; 4096], seg_off: &[u64; 16], seg_len: &[u64; 16], seg_count: u64, value_json_ptr: ptr, value_json_len: u64) -> void {
}

fn deleteAtPath(table: &TomlTable, segs: &[u8; 4096], seg_off: &[u64; 16], seg_len: &[u64; 16], seg_count: u64) -> void {
}

fn removeThreadScopedConfig(table: &TomlTable) -> bool {
    // for keyPath of THREAD_SCOPED_CONFIG_KEYS: if present, delete
    // DEFECT: presence check works over the JSON twin; deletion
    // inherits the setAtPath/deleteAtPath gap above.
    let doc = sa_json_parse(cb_ptr(&table.json), table.json.len);
    if doc == 0 { return false; };
    let v: u64 = 0;
    if sa_json_object_get(doc, STR_PTR("model_context_window"), STR_LEN("model_context_window"), &v) != 0 { return false; };
    return true;
}

// parseKeyPath: TS parses `${keyPath} = "sentinel"` as TOML to
// recover the segment list (handles quoted segments).
// DEFECT: approximated with a hand parser: split on '.' outside
// quotes; quoted segments are JSON-unescaped via sa_json_parse
// of the quoted token. Bare segments are taken verbatim
// (trailing/leading spaces trimmed per TOML bare-key rules is
// approximated).
fn parseKeyPath(kp_ptr: ptr, kp_len: u64, segs: &[u8; 4096], seg_off: &[u64; 16], seg_len: &[u64; 16], seg_count: &u64) -> i32 {
    seg_count = 0;
    let i: u64 = 0;
    let cur_off: u64 = 0;
    let cur_len: u64 = 0;
    let cur_start: u64 = 0;
    // segments are stored contiguously in `segs`
    let write: u64 = 0;
    while i <= kp_len {
        let at_end = i == kp_len;
        let b: u8 = 0;
        if !at_end { PTR_BYTE_AT(b, kp_ptr, i); };
        if at_end || b == 46 {
            // emit segment [cur_start, i)
            let s = cur_start;
            let e = i;
            // trim spaces (bare keys)
            while s < e {
                let c: u8 = 0;
                PTR_BYTE_AT(c, kp_ptr, s);
                if c != 32 && c != 9 { break; };
                s = s + 1;
            }
            while e > s {
                let c: u8 = 0;
                PTR_BYTE_AT(c, kp_ptr, e - 1);
                if c != 32 && c != 9 { break; };
                e = e - 1;
            }
            if e <= s { return 3; };
            if seg_count >= 16 { return 3; };
            seg_off[seg_count] = write;
            let first: u8 = 0;
            PTR_BYTE_AT(first, kp_ptr, s);
            if first == 34 {
                // quoted: JSON-parse the token for unescaping
                // DEFECT: approximated by copying the inner bytes.
                if e - s < 2 { return 3; };
                for j in s + 1..e - 1 {
                    let c: u8 = 0;
                    PTR_BYTE_AT(c, kp_ptr, j);
                    if write < 4096 {
                        segs[write] = c;
                        write = write + 1;
                    };
                }
                seg_len[seg_count] = write - seg_off[seg_count];
            } else {
                for j in s..e {
                    let c: u8 = 0;
                    PTR_BYTE_AT(c, kp_ptr, j);
                    if write < 4096 {
                        segs[write] = c;
                        write = write + 1;
                    };
                }
                seg_len[seg_count] = write - seg_off[seg_count];
            };
            seg_count = seg_count + 1;
            cur_start = i + 1;
        };
        i = i + 1;
    }
    if seg_count == 0 { return 3; };
    return 0;
}

struct VirtualCodexConfigStore {
    path: CfgBuf,
    migrationSourcePath: CfgBuf,
    migration_done: bool,
    // DEFECT: writeQueue Promise chain -> flag only.
    write_busy: bool,
}

fn store_new(home_ptr: ptr, home_len: u64, store: &VirtualCodexConfigStore) -> void {
    store.path.len = 0;
    store.migrationSourcePath.len = 0;
    resolveVirtualCodexConfigPath(home_ptr, home_len, &store.path);
    resolveCodexUserConfigPath(home_ptr, home_len, &store.migrationSourcePath);
    store.migration_done = false;
    store.write_busy = false;
}

fn store_read(store: &VirtualCodexConfigStore, params_node: u64, out: &CfgBuf) -> i32 {
    // -> { config, origins, layers }
    let mst = store_ensureMigrated(store);
    if mst != 0 { return mst; };
    let table = TomlTable { json: CfgBuf { bytes: [0; 262144], len: 0 } };
    let version = CfgBuf { bytes: [0; 262144], len: 0 };
    let removed = false;
    let lst = store_load(cb_ptr(&store.path), store.path.len, &table, &version, &removed);
    if lst != 0 { return lst; };
    // DEFECT: tomlToJson(table) + flattenConfig origins need key
    // enumeration of the whole table; origins emitted as {} and
    // config as the JSON twin. layers mirrors includeLayers.
    let include_layers = false;
    if params_node != 0 {
        let il: u64 = 0;
        if sa_json_object_get(params_node, STR_PTR("includeLayers"), STR_LEN("includeLayers"), &il) == 0 {
            let b = false;
            if sa_json_get_bool(il, &b) == 0 { include_layers = b; };
        };
    };
    out.len = 0;
    cb_append(out, STR_PTR("{\"config\":"), STR_LEN("{\"config\":"));
    cb_append(out, cb_ptr(&table.json), table.json.len);
    cb_append(out, STR_PTR(",\"origins\":{},\"layers\":"), STR_LEN(",\"origins\":{},\"layers\":"));
    if include_layers {
        cb_append(out, STR_PTR("[{\"name\":{\"type\":\"user\",\"file\":\""), STR_LEN("[{\"name\":{\"type\":\"user\",\"file\":\""));
        jsonEscapeInto(out, cb_ptr(&store.path), store.path.len);
        cb_append(out, STR_PTR("\",\"profile\":null},\"version\":\""), STR_LEN("\",\"profile\":null},\"version\":\""));
        cb_append(out, cb_ptr(&version), version.len);
        cb_append(out, STR_PTR("\",\"config\":"), STR_LEN("\",\"config\":"));
        cb_append(out, cb_ptr(&table.json), table.json.len);
        cb_append(out, STR_PTR(",\"disabledReason\":null}]"), STR_LEN(",\"disabledReason\":null}]"));
    } else {
        cb_append(out, STR_PTR("null"), STR_LEN("null"));
    };
    cb_append(out, STR_PTR("}"), STR_LEN("}"));
    return 0;
}

fn jsonEscapeInto(out: &CfgBuf, s_ptr: ptr, s_len: u64) -> void {
    for i in 0..s_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, s_ptr, i);
        if b == 34 || b == 92 {
            cb_append(out, STR_PTR("\\"), STR_LEN("\\"));
        };
        let single = [0; 1];
        single[0] = b;
        cb_append(out, &single, 1);
    }
}

fn store_prepare(store: &VirtualCodexConfigStore) -> i32 {
    return store_ensureMigrated(store);
}

fn store_writeValue(store: &VirtualCodexConfigStore, params_node: u64, out: &CfgBuf) -> i32 {
    let mst = store_ensureMigrated(store);
    if mst != 0 { return mst; };
    let edit = ConfigEdit { keyPath: [0; 512], keyPath_len: 0, value_json: [0; 65536], value_json_len: 0, value_is_null: true, mergeStrategy: 0 };
    let est = configEditFromRecord(params_node, &edit);
    if est != 0 { return est; };
    let edits = [edit];
    let ev: u64 = 0;
    let expected: u64 = 0;
    let has_expected = false;
    if sa_json_object_get(params_node, STR_PTR("expectedVersion"), STR_LEN("expectedVersion"), &ev) == 0 {
        // stringOrNull
        let sp: ptr = PTR_NULL();
        let sl: u64 = 0;
        if sa_json_string_ptr(ev, &sp) == 0 {
            sa_json_string_len(ev, &sl);
            if sl > 0 { has_expected = true; expected = ev; };
        };
    };
    return store_enqueueWrite(store, &edits, 1, expected, has_expected, out);
}

fn store_batchWrite(store: &VirtualCodexConfigStore, params_node: u64, out: &CfgBuf) -> i32 {
    let mst = store_ensureMigrated(store);
    if mst != 0 { return mst; };
    let edits_node: u64 = 0;
    // throw "config/batchWrite requires an edits array" -> status 3
    if sa_json_object_get(params_node, STR_PTR("edits"), STR_LEN("edits"), &edits_node) != 0 { return 3; };
    let alen: u64 = 0;
    if sa_json_array_len(edits_node, &alen) != 0 { return 3; };
    if alen > 32 { return 3; };
    let edits: [ConfigEdit; 32] = [ConfigEdit { keyPath: [0; 512], keyPath_len: 0, value_json: [0; 65536], value_json_len: 0, value_is_null: true, mergeStrategy: 0 }; 32];
    for i in 0..alen {
        let en: u64 = 0;
        sa_json_array_get(edits_node, i, &en);
        let one = ConfigEdit { keyPath: [0; 512], keyPath_len: 0, value_json: [0; 65536], value_json_len: 0, value_is_null: true, mergeStrategy: 0 };
        let est = configEditFromRecord(en, &one);
        if est != 0 { return est; };
        edits[i] = one;
    }
    let ev: u64 = 0;
    let expected: u64 = 0;
    let has_expected = false;
    if sa_json_object_get(params_node, STR_PTR("expectedVersion"), STR_LEN("expectedVersion"), &ev) == 0 {
        let sp: ptr = PTR_NULL();
        let sl: u64 = 0;
        if sa_json_string_ptr(ev, &sp) == 0 {
            sa_json_string_len(ev, &sl);
            if sl > 0 { has_expected = true; expected = ev; };
        };
    };
    return store_enqueueWrite(store, &edits, alen, expected, has_expected, out);
}

// injectThreadConfig: for thread/* config methods, merges the
// flattened virtual config under the request config.
// out: new params JSON text; status 1 = params returned unchanged
// (non-thread method), 0 = merged.
fn store_injectThreadConfig(store: &VirtualCodexConfigStore, method_ptr: ptr, method_len: u64, params_node: u64, out: &CfgBuf) -> i32 {
    if !is_thread_config_method(method_ptr, method_len) {
        // return params
        out.len = 0;
        if params_node != 0 {
            let h: u64 = 0;
            if sa_json_stringify(params_node, &h) == 0 {
                cb_append(out, sa_json_buffer_data(h), sa_json_buffer_len(h));
                sa_json_buffer_free(h);
            };
        };
        return 1;
    };
    let mst = store_ensureMigrated(store);
    if mst != 0 { return mst; };
    let table = TomlTable { json: CfgBuf { bytes: [0; 262144], len: 0 } };
    let version = CfgBuf { bytes: [0; 262144], len: 0 };
    let removed = false;
    let lst = store_load(cb_ptr(&store.path), store.path.len, &table, &version, &removed);
    if lst != 0 { return lst; };
    // DEFECT: flattenConfig(virtual) minus model_context_window,
    // then { ...request, config: { ...virtual, ...requestConfig } }
    // with model_context_window sanitized (finite number > 0 ->
    // rounded, else deleted) and modelProvider/model copied into
    // requestConfig -- the merge needs JSON object enumeration /
    // reconstruction; emitted as the request params unchanged in
    // the bulk pass (status 1), merge rules logged.
    out.len = 0;
    if params_node != 0 {
        let h: u64 = 0;
        if sa_json_stringify(params_node, &h) == 0 {
            cb_append(out, sa_json_buffer_data(h), sa_json_buffer_len(h));
            sa_json_buffer_free(h);
        };
    };
    return 1;
}

fn store_enqueueWrite(store: &VirtualCodexConfigStore, edits: &[ConfigEdit; 32], edits_len: u64, expected: u64, has_expected: bool, out: &CfgBuf) -> i32 {
    // TS: writeQueue.then(persist).catch-swallow for the queue.
    // Sequential: direct persist.
    return store_persist(store, edits, edits_len, expected, has_expected, out);
}

fn store_persist(store: &VirtualCodexConfigStore, edits: &[ConfigEdit; 32], edits_len: u64, expected: u64, has_expected: bool, out: &CfgBuf) -> i32 {
    // withConfigLock(path, ...) -- the lock wrapper is inlined as
    // lock acquire/release calls (see withConfigLock below used
    // as acquire/release pair; TS passes a closure).
    let lst0 = configLockAcquire(cb_ptr(&store.path), store.path.len);
    if lst0 != 0 { return lst0; };
    let table = TomlTable { json: CfgBuf { bytes: [0; 262144], len: 0 } };
    let version = CfgBuf { bytes: [0; 262144], len: 0 };
    let removed = false;
    let lst = store_load(cb_ptr(&store.path), store.path.len, &table, &version, &removed);
    if lst != 0 { configLockRelease(cb_ptr(&store.path), store.path.len); return lst; };
    if has_expected {
        let esp: ptr = PTR_NULL();
        let esl: u64 = 0;
        sa_json_string_ptr(expected, &esp);
        sa_json_string_len(expected, &esl);
        if !bytes_eq_str2(esp, esl, cb_ptr(&version), version.len) {
            configLockRelease(cb_ptr(&store.path), store.path.len);
            return 3; // "Virtual Codex config version conflict"
        };
    };
    for i in 0..edits_len {
        // edits touching THREAD_SCOPED keys are filtered out
        if edits[i].keyPath_len == 18 {
            let kp: ptr = PTR_NULL();
            PTR_BYTE_ADD(kp, &edits[i].keyPath, 0);
            if bytes_eq_str2(kp, 18, STR_PTR("model_context_window"), STR_LEN("model_context_window")) { continue; };
        };
        applyEdit(&table, &edits[i]);
    }
    removeThreadScopedConfig(&table);
    let content = CfgBuf { bytes: [0; 262144], len: 0 };
    tableToTomlText(&table, &content);
    let next_version = CfgBuf { bytes: [0; 262144], len: 0 };
    configVersion(cb_ptr(&content), content.len, &next_version);
    let wst = atomicWrite(cb_ptr(&store.path), store.path.len, cb_ptr(&content), content.len);
    if wst != 0 { configLockRelease(cb_ptr(&store.path), store.path.len); return wst; };
    configLockRelease(cb_ptr(&store.path), store.path.len);
    out.len = 0;
    cb_append(out, STR_PTR("{\"status\":\"ok\",\"version\":\""), STR_LEN("{\"status\":\"ok\",\"version\":\""));
    cb_append(out, cb_ptr(&next_version), next_version.len);
    cb_append(out, STR_PTR("\",\"filePath\":\""), STR_LEN("\",\"filePath\":\""));
    jsonEscapeInto(out, cb_ptr(&store.path), store.path.len);
    cb_append(out, STR_PTR("\",\"overriddenMetadata\":null}"), STR_LEN("\",\"overriddenMetadata\":null}"));
    return 0;
}

fn store_ensureMigrated(store: &VirtualCodexConfigStore) -> i32 {
    if store.migration_done { return 0; };
    let st = store_migrate(store);
    if st == 0 { store.migration_done = true; };
    return st;
}

fn store_migrate(store: &VirtualCodexConfigStore) -> i32 {
    // source = parse(readFile(migrationSourcePath)) or null
    let src = CfgBuf { bytes: [0; 262144], len: 0 };
    let src_st = read_text_file2(cb_ptr(&store.migrationSourcePath), store.migrationSourcePath.len, &src);
    let has_source = src_st == 0;
    if !has_source {
        // still needs legacy cleanup; only if this.path exists
        let t: u64 = 0;
        if sa_std_fs_len(cb_ptr(&store.path), store.path.len, &t) != 0 { return 0; };
    };
    let lst0 = configLockAcquire(cb_ptr(&store.path), store.path.len);
    if lst0 != 0 { return lst0; };
    let table = TomlTable { json: CfgBuf { bytes: [0; 262144], len: 0 } };
    let version = CfgBuf { bytes: [0; 262144], len: 0 };
    let removed = false;
    let lst = store_load(cb_ptr(&store.path), store.path.len, &table, &version, &removed);
    if lst != 0 { configLockRelease(cb_ptr(&store.path), store.path.len); return lst; };
    let changed = removed;
    // inheritance marker presence
    let marker = CfgBuf { bytes: [0; 262144], len: 0 };
    marker.len = 0;
    cb_append(&marker, cb_ptr(&store.path), store.path.len);
    // dirname(path) + "/" + marker -- approximated: strip file name
    // DEFECT: path dirname/join approximated by scanning for '/'.
    let dir_len = store.path.len;
    let k = store.path.len;
    while k > 0 {
        if store.path.bytes[k - 1] == 47 { dir_len = k - 1; break; };
        k = k - 1;
    }
    marker.len = 0;
    cb_append(&marker, cb_ptr(&store.path), dir_len);
    cb_append(&marker, STR_PTR("/.agent-inheritance-v1"), STR_LEN("/.agent-inheritance-v1"));
    let mt: u64 = 0;
    let inheritance_migrated = sa_std_fs_len(cb_ptr(&marker), marker.len, &mt) == 0;
    if has_source {
        // DEFECT: for SAFE_MULTI_AGENT_MIGRATION_PATHS: copy the
        // value from source when absent in the virtual table;
        // for LEGACY_AGENT_DEFAULT_PATHS (when not migrated):
        // delete when virtual == source. Both need table mutation
        // (setAtPath/deleteAtPath gap) -- structure only here.
        changed = changed;
    };
    if changed {
        let content = CfgBuf { bytes: [0; 262144], len: 0 };
        tableToTomlText(&table, &content);
        atomicWrite(cb_ptr(&store.path), store.path.len, cb_ptr(&content), content.len);
    };
    if !inheritance_migrated {
        // mkdir -p + writeFile(marker, "inherit parent model\n")
        sa_fs_write_file(cb_ptr(&marker), marker.len, STR_PTR("inherit parent model\n"), STR_LEN("inherit parent model\n"));
    };
    configLockRelease(cb_ptr(&store.path), store.path.len);
    return 0;
}

fn applyEdit(table: &TomlTable, edit: &ConfigEdit) -> void {
    let segs = [0; 4096];
    let off = [0; 16];
    let sl = [0; 16];
    let count: u64 = 0;
    let kp: ptr = PTR_NULL();
    PTR_BYTE_ADD(kp, &edit.keyPath, 0);
    if parseKeyPath(kp, edit.keyPath_len, &segs, &off, &sl, &count) != 0 { return; };
    if edit.value_is_null {
        deleteAtPath(table, &segs, &off, &sl, count);
        return;
    };
    // upsert: merge tables when both are tables (mergeTables) --
    // DEFECT: inherits the mutation gap.
    setAtPath(table, &segs, &off, &sl, count, &edit.value_json, edit.value_json_len);
}

fn configEditFromRecord(record_node: u64, edit: &ConfigEdit) -> i32 {
    // keyPath: string, trimmed, required (throw -> 3)
    let kn: u64 = 0;
    if sa_json_object_get(record_node, STR_PTR("keyPath"), STR_LEN("keyPath"), &kn) != 0 { return 3; };
    let sp: ptr = PTR_NULL();
    let sl: u64 = 0;
    if sa_json_string_ptr(kn, &sp) != 0 { return 3; };
    sa_json_string_len(kn, &sl);
    let s: u64 = 0;
    let e: u64 = sl;
    while s < e {
        let b: u8 = 0;
        PTR_BYTE_AT(b, sp, s);
        if b != 32 && b != 9 && b != 10 && b != 13 { break; };
        s = s + 1;
    }
    while e > s {
        let b: u8 = 0;
        PTR_BYTE_AT(b, sp, e - 1);
        if b != 32 && b != 9 && b != 10 && b != 13 { break; };
        e = e - 1;
    }
    if e <= s { return 3; };
    edit.keyPath_len = e - s;
    for j in 0..edit.keyPath_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, sp, s + j);
        edit.keyPath[j] = b;
    }
    // value ?? null -> JSON text
    edit.value_is_null = true;
    edit.value_json_len = 0;
    let vn: u64 = 0;
    if sa_json_object_get(record_node, STR_PTR("value"), STR_LEN("value"), &vn) == 0 {
        let h: u64 = 0;
        if sa_json_stringify(vn, &h) == 0 {
            let bl = sa_json_buffer_len(h);
            if bl == 4 {
                // "null"
                edit.value_is_null = true;
            } else {
                edit.value_is_null = false;
                if bl <= 65536 {
                    edit.value_json_len = bl;
                    for j in 0..bl {
                        let b: u8 = 0;
                        PTR_BYTE_AT(b, sa_json_buffer_data(h), j);
                        edit.value_json[j] = b;
                    }
                };
            };
            sa_json_buffer_free(h);
        };
    };
    // mergeStrategy: "upsert" -> 1 else 0
    edit.mergeStrategy = 0;
    let mn: u64 = 0;
    if sa_json_object_get(record_node, STR_PTR("mergeStrategy"), STR_LEN("mergeStrategy"), &mn) == 0 {
        let mp: ptr = PTR_NULL();
        let ml: u64 = 0;
        if sa_json_string_ptr(mn, &mp) == 0 {
            sa_json_string_len(mn, &ml);
            if bytes_eq_str2(mp, ml, STR_PTR("upsert"), STR_LEN("upsert")) { edit.mergeStrategy = 1; };
        };
    };
    return 0;
}

// syncModelProvidersToUserConfig: copies model_providers (+ the
// active/default model_provider and model) from the virtual
// config into the user config. DEFECT: whole body depends on
// table enumeration + mutation + stringify (see header cluster);
// structure preserved, table operations inherit those gaps, and
// the try/catch-swallows-all semantics are kept (always returns
// 0; failures only logged in TS via console.warn).
fn syncModelProvidersToUserConfig(virtual_ptr: ptr, virtual_len: u64, user_ptr: ptr, user_len: u64, active_provider_ptr: ptr, active_provider_len: u64, has_active_provider: bool, active_model_ptr: ptr, active_model_len: u64, has_active_model: bool) -> i32 {
    if bytes_eq_str2(virtual_ptr, virtual_len, user_ptr, user_len) { return 0; };
    let vraw = CfgBuf { bytes: [0; 262144], len: 0 };
    if read_text_file2(virtual_ptr, virtual_len, &vraw) != 0 { return 0; };
    let vdoc = sa_toml_parse(cb_ptr(&vraw), vraw.len);
    if vdoc == 0 { return 0; };
    let plen = sa_toml_table_len(vdoc, STR_PTR("model_providers"), STR_LEN("model_providers"));
    // DEFECT: isTable + Object.keys length 0 check approximated
    // by table_len < 0 (kind query unavailable per-key).
    if plen <= 0 { sa_toml_free(vdoc); return 0; };
    let uraw = CfgBuf { bytes: [0; 262144], len: 0 };
    if read_text_file2(user_ptr, user_len, &uraw) != 0 { sa_toml_free(vdoc); return 0; };
    // DEFECT: per-provider merge + model_provider/model fallback
    // + model_catalog_json copy + atomicWrite of stringify(user)
    // -- all behind the TOML mutation/serializer gap. The two
    // scalar fallbacks are representable but pointless without a
    // writer; left to the fix phase as one unit.
    sa_toml_free(vdoc);
    return 0;
}

fn prepareVirtualCodexConfig(home_ptr: ptr, home_len: u64) -> i32 {
    let store = VirtualCodexConfigStore { path: CfgBuf { bytes: [0; 262144], len: 0 }, migrationSourcePath: CfgBuf { bytes: [0; 262144], len: 0 }, migration_done: false, write_busy: false };
    store_new(home_ptr, home_len, &store);
    let st = store_prepare(&store);
    if st != 0 { return st; };
    let vp = CfgBuf { bytes: [0; 262144], len: 0 };
    let up = CfgBuf { bytes: [0; 262144], len: 0 };
    resolveVirtualCodexConfigPath(home_ptr, home_len, &vp);
    resolveCodexUserConfigPath(home_ptr, home_len, &up);
    return syncModelProvidersToUserConfig(cb_ptr(&vp), vp.len, cb_ptr(&up), up.len, STR_PTR(""), 0, false, STR_PTR(""), 0, false);
}

// VirtualConfigCodexRuntimeClient: wraps an inner CodexRuntimeClient.
// DEFECT: class extends EventEmitter -- the three forwarded
// events ("status", "message", "stderr") have no emitter
// counterpart; the wrapper forwards calls only.
struct VirtualConfigCodexRuntimeClient {
    inner: CodeCliBridgeClient,
    store: VirtualCodexConfigStore,
}

fn vcClient_getStatus(c: &VirtualConfigCodexRuntimeClient, out_status: &u64, out_label: &CfgBuf) -> i32 {
    return codeCliBridgeClient_getStatus(&c.inner, out_status, out_label);
}

fn vcClient_start(c: &VirtualConfigCodexRuntimeClient) -> i32 {
    return codeCliBridgeClient_start(&c.inner);
}

fn vcClient_stop(c: &VirtualConfigCodexRuntimeClient) -> void {
    codeCliBridgeClient_stop(&c.inner);
}

fn vcClient_restart(c: &VirtualConfigCodexRuntimeClient) -> i32 {
    return codeCliBridgeClient_restart(&c.inner);
}

fn vcClient_request(c: &VirtualConfigCodexRuntimeClient, method_ptr: ptr, method_len: u64, params_node: u64, timeout_ms: u64, out: &CfgBuf) -> i32 {
    if bytes_eq_str2(method_ptr, method_len, STR_PTR("config/read"), STR_LEN("config/read")) {
        return store_read(&c.store, params_node, out);
    };
    if bytes_eq_str2(method_ptr, method_len, STR_PTR("config/value/write"), STR_LEN("config/value/write")) {
        return store_writeValue(&c.store, params_node, out);
    };
    if bytes_eq_str2(method_ptr, method_len, STR_PTR("config/batchWrite"), STR_LEN("config/batchWrite")) {
        return store_batchWrite(&c.store, params_node, out);
    };
    // inner.request(method, await injectThreadConfig(...), timeout)
    let injected = CfgBuf { bytes: [0; 262144], len: 0 };
    let ist = store_injectThreadConfig(&c.store, method_ptr, method_len, params_node, &injected);
    // DEFECT: injected params JSON text -> node re-parse skipped;
    // the inner request is issued with the original params node
    // when injection returned "unchanged" (status 1).
    let req_node = params_node;
    // DEFECT: request framing delegated to the codeCliBridge
    // unit's client in the fix phase; here we surface the call.
    return 0;
}

fn vcClient_notify(c: &VirtualConfigCodexRuntimeClient, method_ptr: ptr, method_len: u64, params_node: u64) -> i32 {
    return codeCliBridgeClient_notify(&c.inner, method_ptr, method_len, params_node);
}

fn vcClient_respond(c: &VirtualConfigCodexRuntimeClient, id_json_ptr: ptr, id_json_len: u64, result_node: u64, has_result: bool, error_node: u64, has_error: bool) -> i32 {
    return codeCliBridgeClient_respond(&c.inner, id_json_ptr, id_json_len, result_node, has_result, error_node, has_error);
}

// Remaining helpers -------------------------------------------------

// flattenConfig + encodeKeySegment: DEFECT -- key enumeration of
// nested objects is unavailable; flattenConfig emits nothing in
// the bulk pass. encodeKeySegment itself is implementable:
fn encodeKeySegment(seg_ptr: ptr, seg_len: u64, out: &CfgBuf) -> void {
    let bare = true;
    if seg_len == 0 { bare = false; };
    for i in 0..seg_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, seg_ptr, i);
        let ok = (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || (b >= 48 && b <= 57) || b == 95 || b == 45;
        if !ok { bare = false; break; };
    }
    out.len = 0;
    if bare {
        cb_append(out, seg_ptr, seg_len);
    } else {
        // JSON.stringify(segment)
        cb_append(out, STR_PTR("\""), STR_LEN("\""));
        jsonEscapeInto(out, seg_ptr, seg_len);
        cb_append(out, STR_PTR("\""), STR_LEN("\""));
    };
}

// tomlToJson / jsonToToml / cloneTomlValue: DEFECT -- identity
// over the JSON twin in this conversion (see header cluster);
// TomlDate -> ISO string and bigint -> number/string branches
// have no representation and are dropped.
fn cloneTomlValue(json_ptr: ptr, json_len: u64, out: &CfgBuf) -> void {
    out.len = 0;
    cb_append(out, json_ptr, json_len);
}

// atomicWrite: write temp file in the same dir, rename over,
// chmod 0600 best-effort, unlink temp in finally.
// DEFECT: temp name uses pid + randomUUID -> placeholder
// externs (process pid, uuid text); chmod via placeholder.
fn atomicWrite(path_ptr: ptr, path_len: u64, content_ptr: ptr, content_len: u64) -> i32 {
    let dir_len = path_len;
    let k = path_len;
    while k > 0 {
        let b: u8 = 0;
        PTR_BYTE_AT(b, path_ptr, k - 1);
        if b == 47 { dir_len = k - 1; break; };
        k = k - 1;
    }
    sa_fs_mkdir_p2(path_ptr, dir_len);
    let tmp = CfgBuf { bytes: [0; 262144], len: 0 };
    tmp.len = 0;
    cb_append(&tmp, path_ptr, dir_len);
    cb_append(&tmp, STR_PTR("/.config.toml.tmp"), STR_LEN("/.config.toml.tmp"));
    // DEFECT: unique suffix (pid.uuid) omitted in the bulk pass.
    let wst = sa_fs_write_file(cb_ptr(&tmp), tmp.len, content_ptr, content_len);
    if wst != 0 { sa_fs_remove_file(cb_ptr(&tmp), tmp.len); return 6; };
    let rst = sa_fs_rename_file(cb_ptr(&tmp), tmp.len, path_ptr, path_len);
    sa_fs_remove_file(cb_ptr(&tmp), tmp.len);
    if rst != 0 { return 6; };
    return 0;
}

// withConfigLock as an acquire/release pair (TS takes a closure).
// Loop: open(lockPath, "wx") -> contention (EEXIST, or EPERM /
// EACCES on win32) -> drop stale (>30s by mtime) -> deadline 5s
// -> delay(10ms) and retry.
// DEFECT: create-exclusive open, mtime, wall clock, pid and
// sleep are placeholder externs (sa_fs_open_create_excl,
// sa_fs_stat_mtime_ms, sa_now_ms, sa_process_pid, sa_sleep_ms);
// the loop structure and constants are preserved.
fn configLockAcquire(path_ptr: ptr, path_len: u64) -> i32 {
    let lock = CfgBuf { bytes: [0; 262144], len: 0 };
    lock.len = 0;
    cb_append(&lock, path_ptr, path_len);
    cb_append(&lock, STR_PTR(".lock"), STR_LEN(".lock"));
    let deadline = sa_now_ms() + CONFIG_LOCK_TIMEOUT_MS;
    let tries: u64 = 0;
    while tries < 1000 {
        let fh: u64 = 0;
        let ost = sa_fs_open_create_excl(cb_ptr(&lock), lock.len, &fh);
        if ost == 0 {
            // write "<pid>\n<now>\n" (content shape preserved)
            sa_fs_close_quiet(fh);
            return 0;
        };
        if ost != 17 {
            // not EEXIST -> throw (isLockContention false)
            return 3;
        };
        let mt = sa_fs_stat_mtime_ms(cb_ptr(&lock), lock.len);
        if mt == 0 || sa_now_ms() - mt > CONFIG_LOCK_STALE_MS {
            sa_fs_remove_file(cb_ptr(&lock), lock.len);
        };
        if sa_now_ms() >= deadline { return 3; }; // lock timeout throw
        sa_sleep_ms(10);
        tries = tries + 1;
    }
    return 3;
}

fn configLockRelease(path_ptr: ptr, path_len: u64) -> void {
    let lock = CfgBuf { bytes: [0; 262144], len: 0 };
    lock.len = 0;
    cb_append(&lock, path_ptr, path_len);
    cb_append(&lock, STR_PTR(".lock"), STR_LEN(".lock"));
    sa_fs_remove_file(cb_ptr(&lock), lock.len);
}

// isMissingFile / isLockContention operate on error objects in
// TS; here they are folded into the status checks above
// (status 3 from fs_len = ENOENT-ish; open status 17 = EEXIST).

// Externs used above (shared declarations also appear in
// dataDir.sla / claudeSkillInventory.sla; TOML + lock helpers
// are declared here).
@extern sa_toml_parse(doc_ptr: ptr, doc_len: u64) -> u64;
@extern sa_toml_free(doc: u64) -> i32;
@extern sa_toml_table_len(doc: u64, path_ptr: ptr, path_len: u64) -> i64;
@extern sa_sha256_hex(data_ptr: ptr, data_len: u64, out_hex: &[u8; 64]) -> void;
// DEFECT: placeholder externs (no sa_std counterpart yet):
@extern sa_fs_mkdir_p2(path_ptr: ptr, path_len: u64) -> i32;
@extern sa_fs_open_create_excl(path_ptr: ptr, path_len: u64, out_handle: &u64) -> i32;
@extern sa_fs_close_quiet(handle: u64) -> i32;
@extern sa_fs_stat_mtime_ms(path_ptr: ptr, path_len: u64) -> u64;
@extern sa_now_ms() -> u64;
@extern sa_sleep_ms(ms: u64) -> void;
