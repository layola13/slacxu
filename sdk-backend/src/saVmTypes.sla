struct SaVmFsCapability {
    // op: "read" | "write" | "append" | "edit" | "create" | "delete" | "rename" | "metadata"
    op: [u8; 16],
    op_len: u64,
    path: [u8; 4096],
    path_len: u64,
}

struct SaVmNetCapability {
    url: [u8; 2048],
    url_len: u64,
    has_methods: bool,
    // methods?: string[] -> newline-joined flat table
    methods_flat: [u8; 512],
    methods_flat_len: u64,
    methods_count: u64,
}

// SaVmRunInput: ~250 optional fields (string/number/boolean/
// string[]/Record fields plus nested requested_caps/limits/
// policy/parallel). DEFECT: dynamic object -> the input is kept
// as JSON text + parsed node; field access goes through
// sa_json_object_get_* with the TS field names. The complete
// field inventory is preserved in the defect log entry for this
// file (sdk.md) so the fix phase can grow typed accessors.
struct SaVmRunInput {
    json: [u8; 262144],
    json_len: u64,
    node: u64,
}

struct SaVmRunResult {
    ok: bool,
    // kind: "success" | "sa_error" | "capability_denied" |
    // "fuel_exhausted" | "timeout" | "mem_quota" |
    // "policy_invalid" | "stack_overflow" | "crashed" |
    // "unavailable" | "running"
    kind: [u8; 32],
    kind_len: u64,
    has_exitCode: bool,
    exitCode: i64,
    stdout: [u8; 65536],
    stdout_len: u64,
    stderr: [u8; 65536],
    stderr_len: u64,
    // saVmEvents: Array<Record<string, unknown>> -> JSON text
    saVmEvents_json: [u8; 65536],
    saVmEvents_json_len: u64,
    // saVmViolation: Record<string, unknown> | null -> JSON text
    has_saVmViolation: bool,
    saVmViolation_json: [u8; 16384],
    saVmViolation_json_len: u64,
    durationMs: u64,
    has_session_id: bool,
    session_id: [u8; 128],
    session_id_len: u64,
    has_sessionId: bool,
    sessionId: [u8; 128],
    sessionId_len: u64,
    has_pid: bool,
    pid: u64,
    has_status: bool,
    status: [u8; 128],
    status_len: u64,
    has_message: bool,
    message: [u8; 4096],
    message_len: u64,
    has_commit: bool,
    commit: [u8; 128],
    commit_len: u64,
    has_created: bool,
    created: bool,
    // DEFECT: the TS type has an index signature
    // ([key: string]: unknown) -- extra fields stay in the raw
    // JSON of the producing call, not in this struct.
}

// NotePriorityLevel = "low" | "normal" | "important" | "critical"
// -> string field wherever used.

// DEFECT: TS Error subclasses with a single class identity for
// instanceof checks -> structs; identity is by construction site
// (the SDK's constructors below), exitCode is a field constant.
struct SaVmInputError {
    message: [u8; 1024],
    message_len: u64,
}

struct SaVmCapabilityDeniedError {
    message: [u8; 1024],
    message_len: u64,
    // readonly exitCode = 228
    exitCode: u64,
}

fn saVmCapabilityDeniedError_new(msg_ptr: ptr, msg_len: u64, out: &SaVmCapabilityDeniedError) -> void {
    out.message_len = 0;
    for i in 0..msg_len {
        if out.message_len < 1024 {
            let b: u8 = 0;
            PTR_BYTE_AT(b, msg_ptr, i);
            out.message[out.message_len] = b;
            out.message_len = out.message_len + 1;
        };
    }
    out.exitCode = 228;
}
