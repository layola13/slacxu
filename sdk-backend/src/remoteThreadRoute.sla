// Converted 1:1 from sdk-backend/src/remoteThreadRoute.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
// Remote thread route record (R2: owned by the SDK).
//
// The route shape the host's remoteThreadRouteStore persists and
// the Codex backend's remote bridges consume. Pure data.

// DEFECT: CliBackend is imported from @codex-ui/shared (string union
// in TS); represented here as a string buffer field.
struct RemoteThreadRoute {
    threadId: [u8; 128],
    threadId_len: u64,
    command: [u8; 512],
    command_len: u64,
    cwd: [u8; 1024],
    cwd_len: u64,
    remotePort: u64,
    // lifecycleMode: "foreground" | "background"
    lifecycleMode: [u8; 16],
    lifecycleMode_len: u64,
    cliBackend: [u8; 64],
    cliBackend_len: u64,
    eventCursor: u64,
    createdAt: u64,
    updatedAt: u64,
}
