{
  "name": "@codex-ui/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "codex-ui": "dist/index.js"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit --noUnusedLocals --noUnusedParameters --noFallthroughCasesInSwitch --noImplicitReturns --noImplicitOverride && node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit --noUnusedLocals --noUnusedParameters --noFallthroughCasesInSwitch --noImplicitReturns --noImplicitOverride",
    "lint": "tsc -p tsconfig.json --noEmit --noUnusedLocals --noUnusedParameters --noFallthroughCasesInSwitch --noImplicitReturns --noImplicitOverride",
    "start": "bun dist/index.js"
  },
  "dependencies": {
    "@codex-ui/shared": "file:../../packages/shared",
    "@hono/zod-validator": "^0.9.1",
    "@napi-rs/keyring": "^1.3.0",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.4.1",
    "fetch-impersonate": "^0.1.0-alpha.2",
    "hono": "^4.7.0",
    "js-tiktoken": "^1.0.21",
    "postgres": "^3.4.7",
    "smol-toml": "^1.7.1",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "0.25.10",
    "ws": "^8.21.1",
    "zod": "^4.6.5",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3"
  }
}
