fn freeModelAccessStatus_new() -> FreeModelAccessStatus {
    return FreeModelAccessStatus {
        configured: false, development_machine: false,
        machine_code: [0u8; 16], machine_code_len: 0,
        license_valid: false, license_reason: 1,
        license_key_preview: [0u8; 128], license_key_preview_len: 0, license_has_key_preview: false,
        license_issued_at: 0.0, license_has_issued_at: false,
        license_expires_at: 0.0, license_has_expires_at: false,
        refresh_interval_hours: 0.0,
        last_refreshed_at: 0.0, has_last_refreshed_at: false,
        next_required_refresh_at: 0.0, has_next_required_refresh_at: false,
        refresh_required: false,
        discord_invite_url: [0u8; 512], discord_invite_url_len: 0,
        has_campaign: false, campaign: [0u8; 4096], campaign_len: 0,
        storage: 3,
        has_requirement: false, requirement_code: [0u8; 256], requirement_code_len: 0, requirement_expires_at: 0.0,
        has_service_error: false, service_error: [0u8; 1024], service_error_len: 0,
    };
}

fn freeModelRefreshAuthorization_new() -> FreeModelRefreshAuthorization {
    return FreeModelRefreshAuthorization {
        status: freeModelAccessStatus_new(),
        allowed: false,
        has_authorization_id: false, authorization_id: [0u8; 256], authorization_id_len: 0,
        has_authorization_expires_at: false, authorization_expires_at: 0.0,
    };
}

fn freeModelAccessManager_alloc() -> FreeModelAccessManager {
    return FreeModelAccessManager {
        has_service_url: false, service_url: [0u8; 1024], service_url_len: 0,
        has_service_secret: false, service_secret: [0u8; 1024], service_secret_len: 0,
        has_env_key: false, env_key: [0u8; 256], env_key_len: 0,
        has_memory_key: false, memory_key: [0u8; 256], memory_key_len: 0,
        machine_hash: [0u8; 65], machine_hash_len: 0, machine_hash_resolved: false,
        has_status_cache: false, cache_key: [0u8; 256], cache_key_len: 0, cache_has_key: false,
        cache_expires_at: 0.0, cache_value: freeModelAccessStatus_new(),
        env_id: 0,
        out_status: freeModelAccessStatus_new(),
        out_auth: freeModelRefreshAuthorization_new(),
        err: [0u8; 1024], err_len: 0,
        read_key: [0u8; 256], read_key_len: 0, read_has_key: false, read_storage: 3,
        req_body: [0u8; 4096], req_body_len: 0,
        url_buf: [0u8; 2176], url_len: 0,
        auth_buf: [0u8; 1200], auth_len: 0,
        resp: [0u8; 16384], resp_len: 0,
        resp_doc: 0, resp_data: 0,
        scratch: [0u8; 1024], scratch_len: 0,
    };
}
