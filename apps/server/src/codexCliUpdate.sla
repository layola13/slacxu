// Converted 1:1 from apps/server/src/codexCliUpdate.ts (CXU plugins @ f2cb649d).
//
// Fix pass (launch/install family batch): all stub bodies retranslated
// from the TS.
// - Exec: [DEFECT std: sa_std_process_exec_capture returns empty
//   stdout/stderr for a successful child in the current sci build —
//   isolated probe evidence, _defects/probes/exec_iso.sla.] All
//   execFile calls therefore run through sa_std_process_run +
//   try_wait poll + post-exit drain (the tree's execGitSync shape).
//   Timeouts are enforced by kill (status 24); per-stream totals are
//   enforced against the TS maxBuffer caps (status 9 on overflow).
//   execFile's rejection on a nonzero exit code maps to status 1.
//   probeLocal's Promise.all runs sequentially here (ASYNC_MODEL R5:
//   the two probes are independent; order is unobservable).
// - argv is a sa_json string-array doc expanded to flat argv slots in
//   the executing frame (struct-array argv does not land at runtime —
//   probe evidence in the launch/install batch).
// - fetch: HTTP client v2 with req_set_timeout_v2 as the 10 s
//   AbortController; any nonzero send status is a transport failure
//   (status 3 = timeout). response.ok = status 200-299.
// - String-returning helpers (fetchLatestVersion*, shellQuote, redact,
//   update output) hand out sa_fmt buffer storage retained by design
//   (the signatures provide no caller buffer); the update output is the
//   fmt handle itself (out_text: &u64).
// - [BLOCKED cross-file: codexCommand.sla findCodexBinary is still a
//   conversion skeleton returning 0.] probeLocal calls it with the TS
//   no-argument defaults (no custom bin, platform from the /proc
//   dispatch below, no env/lookup handles, cwd = $PWD) and applies the
//   TS final fallback literal ("codex.cmd" on win32, else "codex")
//   when it yields nothing — faithful in both states of that unit.
// - Platform: TS reads process.platform; here win32 is inferred from
//   the absence of /proc (single fs-exists throat), which also selects
//   the Windows install command and the findCodexBinary platform code.
// - Regexes are manual scans: parseVersion is a dotted-number scan;
//   the help probe is a case-insensitive scan for "Update Codex" or
//   "Usage:" + whitespace + "codex update"; sshArgs is a segment
//   tokenizer with the TS's independent leading/trailing quote strip;
//   redact replaces /sk-[A-Za-z0-9_-]{12,}/ runs and keeps the last
//   16384 bytes. JS trim is approximated by ASCII whitespace.
// - Struct field caps truncate stored text (path 1024, versions 128,
//   install command 512), the tree's fixed-buffer DEFECT class.
@import "sa_std/io/print.sai"
@import "sa_std/string.sa"
@import "sa_std/ptr.sa"
@import "sa_std/fs.sai"
@import "sa_std/fmt.sai"
@import "sa_std/time.sai"
@import "sa_std/env.sai"
@import "sa_std/process.sa"
@import "sa_std/http_client.sai"
@import "sa_std/encoding/json.sai"
@import "./codexCommand.sla"

struct CodexCliUpdateProbe {
    scope: u8, // 0=local 1=ssh ("local" | "ssh")
    path: [u8; 1024], path_len: u64,
    version: [u8; 128], version_len: u64,
    latestVersion: [u8; 128], latestVersion_len: u64, has_latestVersion: bool, // string | null
    updateAvailable: bool,
    updateSupported: bool,
    checkedAt: u64,
}

struct CodexCliUpdateStatus {
    installed: bool,
    currentVersion: [u8; 128], currentVersion_len: u64, has_currentVersion: bool,
    latestVersion: [u8; 128], latestVersion_len: u64, has_latestVersion: bool,
    updateAvailable: bool,
    installCommand: [u8; 512], installCommand_len: u64,
    checkedAt: u64,
}

// ---------------------------------------------------------------------------
// cu_ helpers
// ---------------------------------------------------------------------------

fn cu_byte(p: ptr, i: u64) -> u8 {
    let b: u8 = 0;
    PTR_BYTE_AT(b, p, i);
    return b;
}

fn cu_field_copy(dst: ptr, cap: u64, src: ptr, n: u64) -> u64 {
    let m = n;
    if m > cap { m = cap; };
    if m > 0 { PTR_COPY_BYTES(dst, src, m); };
    return m;
}

// The single fs_exists throat (status code, 0 = exists).
fn cu_fs_exists(p: ptr, n: u64) -> bool {
    return sa_std_fs_exists(p, n) == 0;
}

fn cu_is_win32() -> bool {
    return !cu_fs_exists(STR_PTR("/proc"), STR_LEN("/proc"));
}

fn cu_now_ms() -> u64 {
    return (sa_time_unix_ms()) as u64;
}

fn cu_fold(b: u8) -> u8 {
    if b >= 65 && b <= 90 { return b + 32; };
    return b;
}

fn cu_contains_ci(hay_p: ptr, hay_n: u64, needle_p: ptr, needle_n: u64) -> bool {
    if needle_n == 0 { return true; };
    if hay_n < needle_n { return false; };
    let i: u64 = 0;
    while i + needle_n <= hay_n {
        let j: u64 = 0;
        let ok = true;
        while j < needle_n {
            if cu_fold(cu_byte(hay_p, i + j)) != cu_fold(cu_byte(needle_p, j)) { ok = false; break; };
            j = j + 1;
        }
        if ok { return true; };
        i = i + 1;
    }
    return false;
}

fn cu_match_ci_at(hay_p: ptr, pos: u64, needle_p: ptr, needle_n: u64) -> bool {
    let j: u64 = 0;
    while j < needle_n {
        if cu_fold(cu_byte(hay_p, pos + j)) != cu_fold(cu_byte(needle_p, j)) { return false; };
        j = j + 1;
    }
    return true;
}

// /Update Codex|Usage:\s+codex update/i over the help text.
fn cu_help_supported(help_p: ptr, help_n: u64) -> bool {
    if cu_contains_ci(help_p, help_n, STR_PTR("Update Codex"), STR_LEN("Update Codex")) { return true; };
    // find "Usage:" (ci), then \s+ then "codex update" (ci)
    let un = STR_LEN("Usage:");
    if help_n < un { return false; };
    let i: u64 = 0;
    while i + un <= help_n {
        if cu_match_ci_at(help_p, i, STR_PTR("Usage:"), un) {
            let k = i + un;
            let ws: u64 = 0;
            while k < help_n {
                let b = cu_byte(help_p, k);
                if b == 32 || (b >= 9 && b <= 13) { k = k + 1; ws = ws + 1; } else { break; };
            }
            if ws > 0 && k + STR_LEN("codex update") <= help_n && cu_match_ci_at(help_p, k, STR_PTR("codex update"), STR_LEN("codex update")) {
                return true;
            };
        };
        i = i + 1;
    }
    return false;
}

// ASCII-whitespace trim range (JS trim approximation).
fn cu_trim_range(p: ptr, n: u64, out_s: &u64, out_e: &u64) -> void {
    let s: u64 = 0;
    let e = n;
    while s < e {
        let b = cu_byte(p, s);
        if b == 32 || (b >= 9 && b <= 13) { s = s + 1; } else { break; };
    }
    while e > s {
        let b = cu_byte(p, e - 1);
        if b == 32 || (b >= 9 && b <= 13) { e = e - 1; } else { break; };
    }
    *out_s = s;
    *out_e = e;
}

// Copy (p, n) into a fresh sa_fmt buffer; returns its data ptr + len
// via out params (the handle is retained by design, see header).
fn cu_fmt_result(p: ptr, n: u64, out_ptr: &ptr, out_len: &u64) -> void {
    let h = sa_fmt_bytes(p, n);
    if h == 0 {
        *out_ptr = STR_PTR("");
        *out_len = 0;
        return;
    };
    let dp: ptr = sa_fmt_buffer_data(h);
    *out_ptr = dp;
    *out_len = sa_fmt_buffer_len(h);
}

struct CuStr {
    bytes: [u8; 8192], len: u64
}

fn cu_free_json(h: u64) -> void {
    if h == 0 { return; };
    sa_json_free(h);
}

fn cu_str_ptr(s: &CuStr) -> ptr {
    let p: ptr = PTR_NULL();
    PTR_BYTE_ADD(p, &s.bytes, 0);
    return p;
}

fn cu_str_push(s: &CuStr, p: ptr, n: u64) -> void {
    let i: u64 = 0;
    while i < n {
        if s.len < 8192 {
            s.bytes[s.len] = cu_byte(p, i);
            s.len = s.len + 1;
        };
        i = i + 1;
    }
}

fn cu_str_push_lit(s: &CuStr, lit_p: ptr, lit_n: u64) -> void {
    cu_str_push(s, lit_p, lit_n);
}

// ---------------------------------------------------------------------------
// Exec plumbing (see header for the exec_capture defect note)
// ---------------------------------------------------------------------------

fn cu_args_new() -> u64 {
    return sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
}

fn cu_args_push(doc: u64, p: ptr, n: u64) -> void {
    if doc != 0 {
        sa_json_array_push_string(doc, p, n);
    };
}

struct CuExecBuf {
    bytes: [u8; 65536], len: u64
}

struct CuBigBuf {
    bytes: [u8; 4194304], len: u64, overflow: bool
}

fn cu_execbuf_ptr(b: &CuExecBuf) -> ptr {
    let p: ptr = PTR_NULL();
    PTR_BYTE_ADD(p, &b.bytes, 0);
    return p;
}

fn cu_bigbuf_ptr(b: &CuBigBuf) -> ptr {
    let p: ptr = PTR_NULL();
    PTR_BYTE_ADD(p, &b.bytes, 0);
    return p;
}


// Drain one stream (which: 0=stdout, 1=stderr) into buf until EOF,
// flagging overflow past cap. Factored out of cu_spawn_poll_big: two
// inlined copies exceeded the flattener's MacroExpansionBudget.
fn cu_drain(handle: u64, which: u64, cap: u64, buf: &CuBigBuf) -> void {
    let chunk: [u8; 8192] = [0u8; 8192];
    let cp: ptr = PTR_NULL();
    PTR_BYTE_ADD(cp, &chunk, 0);
    let draining = true;
    while draining {
        let rn: u64 = 0;
        let st: i32 = 0;
        if which == 0 {
            st = sa_std_process_read_stdout(handle, cp, 8192, &rn);
        } else {
            st = sa_std_process_read_stderr(handle, cp, 8192, &rn);
        };
        if rn == 0 { break; };
        let i: u64 = 0;
        while i < rn {
            if buf.len < cap {
                buf.bytes[buf.len] = cu_byte(cp, i);
                buf.len = buf.len + 1;
            } else {
                buf.overflow = true;
            };
            i = i + 1;
        }
        if st != 0 { break; };
    }
    !cp;
}

// Spawn slots with a try_wait poll and drain both streams into big
// buffers. Returns 0 on exit code 0; 9 = a stream exceeded cap;
// 24 = timeout; 1 = spawn failure or nonzero exit.
fn cu_spawn_poll_big(slots: &[u64; 42], argc: u64, timeout_ms: u64, cap: u64, out: &CuBigBuf, err: &CuBigBuf) -> i32 {
    out.len = 0;
    out.overflow = false;
    err.len = 0;
    err.overflow = false;
    let sp: ptr = PTR_NULL();
    PTR_BYTE_ADD(sp, slots, 0);
    let handle: u64 = 0;
    let rst = sa_std_process_run(sp, argc, &handle);
    if rst != 0 { return 1; };
    let elapsed: u64 = 0;
    let code: i32 = 0;
    let done = false;
    while !done {
        let rdy: bool = false;
        let c: i32 = 0;
        let wst = sa_std_process_try_wait(handle, &rdy, &c);
        if wst == 0 && rdy {
            done = true;
            code = c;
            break;
        };
        if elapsed >= timeout_ms {
            sa_std_process_kill(handle);
            let wc: i32 = 0;
            sa_std_process_wait(handle, &wc);
            sa_std_process_close(handle);
            return 24;
        };
        sa_time_sleep_ms(5);
        elapsed = elapsed + 5;
    }
    cu_drain(handle, 0, cap, out);
    cu_drain(handle, 1, cap, err);
    sa_std_process_close(handle);
    if out.overflow || err.overflow { return 9; };
    if code != 0 { return 1; };
    return 0;
}

// Execute an argv doc (<= 21 args), capturing into big buffers.
fn cu_exec_doc(args: u64, timeout_ms: u64, cap: u64, out: &CuBigBuf, err: &CuBigBuf) -> i32 {
    if args == 0 { return 1; };
    let argc: u64 = 0;
    sa_json_value_count(args, &argc);
    if argc == 0 || argc > 21 { return 1; };
    let slots: [u64; 42] = [0; 42];
    let i: u64 = 0;
    while i < argc {
        let el: u64 = 0;
        if sa_json_array_get(args, i, &el) != 0 || el == 0 || sa_json_kind(el) != 5 {
            return 1;
        };
        let ap: ptr = sa_json_string_ptr(el);
        let an = sa_json_string_len(el);
        PROCESS_ARGV_SET_PTR(&slots, i, ap, an);
        i = i + 1;
    }
    return cu_spawn_poll_big(&slots, argc, timeout_ms, cap, out, err);
}

// Small-capture convenience: run and keep stdout (cap-clamped copy).
// Expand an argv doc into flat slots and spawn into caller-provided
// big buffers. Split out of cu_exec_small: one fn carrying the ARGV
// macro loop + two 4 MiB literals + the spawn + the copies exceeded
// the flattener's per-fn MacroExpansionBudget (probe-isolated).
fn cu_exec_spawn(args: u64, timeout_ms: u64, cap: u64, bo: &CuBigBuf, be: &CuBigBuf) -> i32 {
    if args == 0 { return 1; };
    let argc: u64 = 0;
    sa_json_value_count(args, &argc);
    if argc == 0 || argc > 21 { return 1; };
    let slots: [u64; 42] = [0; 42];
    let i: u64 = 0;
    while i < argc {
        let el: u64 = 0;
        if sa_json_array_get(args, i, &el) != 0 || el == 0 || sa_json_kind(el) != 5 {
            return 1;
        };
        let ap: ptr = sa_json_string_ptr(el);
        let an = sa_json_string_len(el);
        PROCESS_ARGV_SET_PTR(&slots, i, ap, an);
        i = i + 1;
    }
    return cu_spawn_poll_big(&slots, argc, timeout_ms, cap, bo, be);
}

fn cu_exec_small(args: u64, timeout_ms: u64, cap: u64, out: &CuExecBuf, err_out: &CuExecBuf) -> i32 {
    let bo = CuBigBuf { bytes: [0u8; 4194304], len: 0, overflow: false };
    let be = CuBigBuf { bytes: [0u8; 4194304], len: 0, overflow: false };
    let rc = cu_exec_spawn(args, timeout_ms, cap, &bo, &be);
    out.len = cu_field_copy(cu_execbuf_ptr(out), 65536, cu_bigbuf_ptr(&bo), bo.len);
    err_out.len = cu_field_copy(cu_execbuf_ptr(err_out), 65536, cu_bigbuf_ptr(&be), be.len);
    return rc;
}

// ---------------------------------------------------------------------------
// parseVersion / isNewer (TS L43-55)
// ---------------------------------------------------------------------------

fn cu_parse_component(p: ptr, n: u64, pos: &u64, out: &u64, ok: &bool) -> void {
    *ok = false;
    *out = 0;
    let i = *pos;
    let start = i;
    let v: u64 = 0;
    while i < n {
        let b = cu_byte(p, i);
        if b < 48 || b > 57 { break; };
        v = v * 10 + ((b - 48) as u64);
        i = i + 1;
    }
    if i == start { return; };
    *pos = i;
    *out = v;
    *ok = true;
}

fn parseVersion(v_ptr: ptr, v_len: u64, out_major: &u64, out_minor: &u64, out_patch: &u64, out_found: &bool) -> void {
    *out_found = false;
    *out_major = 0;
    *out_minor = 0;
    *out_patch = 0;
    let s: u64 = 0;
    let e: u64 = 0;
    cu_trim_range(v_ptr, v_len, &s, &e);
    if e <= s { return; };
    let tp: ptr = PTR_NULL();
    PTR_BYTE_ADD(tp, v_ptr, s);
    let tn = e - s;
    let pos: u64 = 0;
    let a: u64 = 0;
    let ok = false;
    cu_parse_component(tp, tn, &pos, &a, &ok);
    if !ok || pos >= tn || cu_byte(tp, pos) != 46 { return; };
    pos = pos + 1;
    let b: u64 = 0;
    cu_parse_component(tp, tn, &pos, &b, &ok);
    if !ok || pos >= tn || cu_byte(tp, pos) != 46 { return; };
    pos = pos + 1;
    let c: u64 = 0;
    cu_parse_component(tp, tn, &pos, &c, &ok);
    if !ok || pos != tn { return; };
    *out_major = a;
    *out_minor = b;
    *out_patch = c;
    *out_found = true;
}

fn isNewer(latest_ptr: ptr, latest_len: u64, current_ptr: ptr, current_len: u64) -> bool {
    let l0: u64 = 0;
    let l1: u64 = 0;
    let l2: u64 = 0;
    let lf = false;
    parseVersion(latest_ptr, latest_len, &l0, &l1, &l2, &lf);
    if !lf { return false; };
    let c0: u64 = 0;
    let c1: u64 = 0;
    let c2: u64 = 0;
    let cf = false;
    parseVersion(current_ptr, current_len, &c0, &c1, &c2, &cf);
    if !cf { return false; };
    if l0 != c0 { return l0 > c0; };
    if l1 != c1 { return l1 > c1; };
    return l2 > c2;
}

// ---------------------------------------------------------------------------
// fetch latest version (TS L57-95)
// ---------------------------------------------------------------------------

// GET a URL as JSON. Returns the doc handle (0 on any failure) and sets
// ok_out (response.ok) / transport_out (send succeeded).
fn cu_fetch_json(url_p: ptr, url_n: u64, accept_p: ptr, accept_n: u64, ua_p: ptr, ua_n: u64, has_ua: bool, ok_out: &bool, transport_out: &bool) -> u64 {
    *ok_out = false;
    *transport_out = false;
    let client: ptr = PTR_NULL();
    let nst = sa_http_client_new_v2(1, STR_PTR(""), 0, &client);
    if nst != 0 || client == PTR_NULL() { return 0; };
    let req: ptr = PTR_NULL();
    let rst = sa_http_client_req_new_v2(client, 1, url_p, url_n, &req);
    if rst != 0 || req == PTR_NULL() {
        sa_http_client_free(client);
        return 0;
    };
    sa_http_client_req_add_header_v2(req, STR_PTR("Accept"), STR_LEN("Accept"), accept_p, accept_n);
    if has_ua {
        sa_http_client_req_add_header_v2(req, STR_PTR("User-Agent"), STR_LEN("User-Agent"), ua_p, ua_n);
    };
    sa_http_client_req_set_timeout_v2(req, 10000);
    let resp: ptr = PTR_NULL();
    let sst = sa_http_client_req_send_v2(req, &resp);
    if sst != 0 || resp == PTR_NULL() {
        sa_http_client_req_free(req);
        sa_http_client_free(client);
        return 0;
    };
    *transport_out = true;
    let status = sa_http_client_resp_status(resp);
    if status >= 200 && status < 300 { *ok_out = true; };
    let doc: u64 = 0;
    if *ok_out {
        let bp: ptr = sa_http_client_resp_body_ptr(resp);
        let bl = sa_http_client_resp_body_len(resp);
        if bp != PTR_NULL() && bl > 0 {
            doc = sa_json_parse(bp, bl);
        };
    };
    sa_http_client_resp_free(resp);
    sa_http_client_req_free(req);
    sa_http_client_free(client);
    return doc;
}

fn fetchLatestVersion(out_ptr: &ptr, out_len: &u64, out_found: &bool) -> i32 {
    *out_found = false;
    *out_len = 0;
    let ok = false;
    let transport = false;
    let doc = cu_fetch_json(STR_PTR("https://api.github.com/repos/openai/codex/releases/latest"), STR_LEN("https://api.github.com/repos/openai/codex/releases/latest"), STR_PTR("application/vnd.github+json"), STR_LEN("application/vnd.github+json"), STR_PTR("codex-ultra"), STR_LEN("codex-ultra"), true, &ok, &transport);
    if transport && ok && doc != 0 {
        let tag_p: ptr = PTR_NULL();
        let tag_n: u64 = 0;
        if sa_json_object_get_string(doc, STR_PTR("tag_name"), STR_LEN("tag_name"), &tag_p, &tag_n) == 0 {
            // tag present: the result is decided here (no npm fallback)
            // Strip "rust-v" then a leading "v" via an offset (a
            // second PTR_BYTE_ADD into the same register would trap
            // RegisterRedefinition at SAB lowering).
            let off: u64 = 0;
            if tag_n >= 7 && cu_eq_bytes(tag_p, 7, STR_PTR("rust-v"), STR_LEN("rust-v")) {
                off = 7;
            };
            if tag_n - off >= 1 && cu_byte(tag_p, off) == 118 {
                off = off + 1;
            };
            let vp: ptr = PTR_NULL();
            PTR_BYTE_ADD(vp, tag_p, off);
            let vn = tag_n - off;
            let a: u64 = 0;
            let b: u64 = 0;
            let c: u64 = 0;
            let f = false;
            parseVersion(vp, vn, &a, &b, &c, &f);
            if f {
                cu_fmt_result(vp, vn, out_ptr, out_len);
                *out_found = true;
            };
            sa_json_free(doc);
            return 0;
        };
    };
    cu_free_json(doc);
    return fetchLatestVersionFromNpm(out_ptr, out_len, out_found);
}

fn cu_eq_bytes(p: ptr, n: u64, q: ptr, qn: u64) -> bool {
    if n != qn { return false; };
    let i: u64 = 0;
    while i < n {
        if cu_byte(p, i) != cu_byte(q, i) { return false; };
        i = i + 1;
    }
    return true;
}

fn fetchLatestVersionFromNpm(out_ptr: &ptr, out_len: &u64, out_found: &bool) -> i32 {
    *out_found = false;
    *out_len = 0;
    let ok = false;
    let transport = false;
    let doc = cu_fetch_json(STR_PTR("https://registry.npmjs.org/@openai%2fcodex"), STR_LEN("https://registry.npmjs.org/@openai%2fcodex"), STR_PTR("application/json"), STR_LEN("application/json"), STR_PTR(""), 0, false, &ok, &transport);
    if transport && ok && doc != 0 {
        let tags: u64 = 0;
        if sa_json_object_get(doc, STR_PTR("dist-tags"), STR_LEN("dist-tags"), &tags) == 0 && tags != 0 {
            let lp: ptr = PTR_NULL();
            let ln: u64 = 0;
            if sa_json_object_get_string(tags, STR_PTR("latest"), STR_LEN("latest"), &lp, &ln) == 0 {
                let a: u64 = 0;
                let b: u64 = 0;
                let c: u64 = 0;
                let f = false;
                parseVersion(lp, ln, &a, &b, &c, &f);
                if f {
                    cu_fmt_result(lp, ln, out_ptr, out_len);
                    *out_found = true;
                };
            };
        };
    };
    cu_free_json(doc);
    return 0;
}


// ---------------------------------------------------------------------------
// probe / check / update (TS L17-32, L106-135)
// ---------------------------------------------------------------------------

fn cu_probe_clear(out: &CodexCliUpdateProbe) -> void {
    out.scope = 0;
    out.path_len = 0;
    out.version_len = 0;
    out.latestVersion_len = 0;
    out.has_latestVersion = false;
    out.updateAvailable = false;
    out.updateSupported = false;
    out.checkedAt = 0;
}

fn probeLocalCodexCliUpdate(out: &CodexCliUpdateProbe) -> i32 {
    cu_probe_clear(out);
    // path = findCodexBinary() with TS no-argument defaults; the callee
    // is a skeleton today (see header), so the TS final fallback applies.
    let sc = FindScratch { out: [0u8; 4096], out_len: 0, has_out: false, tmp: [0u8; 4096], tmp_len: 0, err: [0u8; 512], err_len: 0 };
    let win = cu_is_win32();
    let platform: u64 = 2;
    if win { platform = 0; };
    let cwd = CuStr { bytes: [0u8; 8192], len: 0 };
    {
        let h = sa_env_get(STR_PTR("PWD"), STR_LEN("PWD"));
        if h != 0 {
            let hp: ptr = sa_env_buffer_data(h);
            let hl = sa_env_buffer_len(h);
            cu_str_push(&cwd, hp, hl);
            sa_env_buffer_free(h);
        };
    }
    let found_len = findCodexBinary(&sc, false, STR_PTR(""), 0, platform, 0, 0, cu_str_ptr(&cwd), cwd.len);
    {
        let dp: ptr = PTR_NULL();
        PTR_BYTE_ADD(dp, &out.path, 0);
        if found_len > 0 {
            let sp: ptr = PTR_NULL();
            PTR_BYTE_ADD(sp, &sc.out, 0);
            out.path_len = cu_field_copy(dp, 1024, sp, found_len);
        } else if win {
            out.path_len = cu_field_copy(dp, 1024, STR_PTR("codex.cmd"), STR_LEN("codex.cmd"));
        } else {
            out.path_len = cu_field_copy(dp, 1024, STR_PTR("codex"), STR_LEN("codex"));
        };
    } 
    let path_p: ptr = PTR_NULL();
    PTR_BYTE_ADD(path_p, &out.path, 0);
    // version = execFile(path, ["--version"], 15s/64KiB); a failure here
    // rejects the probe (TS Promise.all).
    let args = cu_args_new();
    cu_args_push(args, path_p, out.path_len);
    cu_args_push(args, STR_PTR("--version"), STR_LEN("--version"));
    let so = CuExecBuf { bytes: [0u8; 65536], len: 0 };
    let se = CuExecBuf { bytes: [0u8; 65536], len: 0 };
    let vrc = cu_exec_small(args, 15000, 65536, &so, &se);
    cu_free_json(args);
    if vrc != 0 { return vrc; };
    {
        // version: String(stdout).trim()
        let s: u64 = 0;
        let e: u64 = 0;
        cu_trim_range(cu_execbuf_ptr(&so), so.len, &s, &e);
        let sp2: ptr = PTR_NULL();
        PTR_BYTE_ADD(sp2, cu_execbuf_ptr(&so), s);
        let dp2: ptr = PTR_NULL();
        PTR_BYTE_ADD(dp2, &out.version, 0);
        out.version_len = cu_field_copy(dp2, 128, sp2, e - s);
    } 
    // help = execFile(path, ["update", "--help"], 15s/256KiB) with a
    // catch -> empty stdout.
    let hargs = cu_args_new();
    cu_args_push(hargs, path_p, out.path_len);
    cu_args_push(hargs, STR_PTR("update"), STR_LEN("update"));
    cu_args_push(hargs, STR_PTR("--help"), STR_LEN("--help"));
    let ho = CuExecBuf { bytes: [0u8; 65536], len: 0 };
    let he = CuExecBuf { bytes: [0u8; 65536], len: 0 };
    let hrc = cu_exec_small(hargs, 15000, 262144, &ho, &he);
    cu_free_json(hargs);
    if hrc == 0 {
        out.updateSupported = cu_help_supported(cu_execbuf_ptr(&ho), ho.len);
    } else {
        out.updateSupported = false;
    };
    out.checkedAt = cu_now_ms();
    return 0;
}

fn checkLocalCodexCliUpdateStatus(out: &CodexCliUpdateStatus) -> i32 {
    out.installed = false;
    out.currentVersion_len = 0;
    out.has_currentVersion = false;
    out.latestVersion_len = 0;
    out.has_latestVersion = false;
    out.updateAvailable = false;
    {
        let dp: ptr = PTR_NULL();
        PTR_BYTE_ADD(dp, &out.installCommand, 0);
        if cu_is_win32() {
            out.installCommand_len = cu_field_copy(dp, 512, STR_PTR("powershell -ExecutionPolicy ByPass -c \"irm https://chatgpt.com/codex/install.ps1 | iex\""), STR_LEN("powershell -ExecutionPolicy ByPass -c \"irm https://chatgpt.com/codex/install.ps1 | iex\""));
        } else {
            out.installCommand_len = cu_field_copy(dp, 512, STR_PTR("npm install -g @openai/codex@latest"), STR_LEN("npm install -g @openai/codex@latest"));
        };
    } 
    out.checkedAt = cu_now_ms();
    let probe = CodexCliUpdateProbe { scope: 0, path: [0u8; 1024], path_len: 0, version: [0u8; 128], version_len: 0, latestVersion: [0u8; 128], latestVersion_len: 0, has_latestVersion: false, updateAvailable: false, updateSupported: false, checkedAt: 0 };
    let prc = probeLocalCodexCliUpdate(&probe);
    if prc != 0 {
        // TS catch: installed=false shape
        return 0;
    };
    out.installed = true;
    if probe.version_len > 0 {
        let sp: ptr = PTR_NULL();
        PTR_BYTE_ADD(sp, &probe.version, 0);
        let dp2: ptr = PTR_NULL();
        PTR_BYTE_ADD(dp2, &out.currentVersion, 0);
        out.currentVersion_len = cu_field_copy(dp2, 128, sp, probe.version_len);
        out.has_currentVersion = true;
    };
    let lp: ptr = PTR_NULL();
    let ln: u64 = 0;
    let lf = false;
    fetchLatestVersion(&lp, &ln, &lf);
    if lf {
        let dp3: ptr = PTR_NULL();
        PTR_BYTE_ADD(dp3, &out.latestVersion, 0);
        out.latestVersion_len = cu_field_copy(dp3, 128, lp, ln);
        out.has_latestVersion = true;
    };
    if lf && out.has_currentVersion {
        let cp: ptr = PTR_NULL();
        PTR_BYTE_ADD(cp, &out.currentVersion, 0);
        out.updateAvailable = isNewer(lp, ln, cp, out.currentVersion_len);
    };
    out.checkedAt = cu_now_ms();
    return 0;
}

// Shared tail of the two update fns: run the update exec, re-probe,
// and compose output = redact(trim(join([stdout, stderr], "\n"))).
// rc semantics: 0 ok; 1/9/24 exec classes from cu_exec_doc.
fn cu_finish_update(out_text: &u64, bo: &CuBigBuf, be: &CuBigBuf) -> void {
    let joined = CuBigBuf { bytes: [0u8; 4194304], len: 0, overflow: false };
    let jp = cu_bigbuf_ptr(&joined);
    joined.len = cu_field_copy(jp, 4194304, cu_bigbuf_ptr(bo), bo.len);
    if joined.len < 4194304 {
        let np: ptr = PTR_NULL();
        PTR_BYTE_ADD(np, jp, joined.len);
        cu_field_copy(np, 4194304 - joined.len, STR_PTR("\n"), STR_LEN("\n"));
        joined.len = joined.len + 1;
        let ep: ptr = PTR_NULL();
        PTR_BYTE_ADD(ep, jp, joined.len);
        let added = cu_field_copy(ep, 4194304 - joined.len, cu_bigbuf_ptr(be), be.len);
        joined.len = joined.len + added;
    };
    // trim
    let s: u64 = 0;
    let e: u64 = 0;
    cu_trim_range(jp, joined.len, &s, &e);
    let tp: ptr = PTR_NULL();
    PTR_BYTE_ADD(tp, jp, s);
    let rp: ptr = PTR_NULL();
    let rn: u64 = 0;
    redact(tp, e - s, &rp, &rn);
    // redact's fmt text -> keep the HANDLE for out_text
    *out_text = sa_fmt_bytes(rp, rn);
}

fn updateLocalCodexCli(out_before: &CodexCliUpdateProbe, out_after: &CodexCliUpdateProbe, out_text: &u64) -> i32 {
    *out_text = 0;
    let brc = probeLocalCodexCliUpdate(out_before);
    if brc != 0 { return brc; };
    if !out_before.updateSupported {
        // TS: throw new Error("This Codex CLI does not support `codex update`; use the platform installer instead")
        return 2;
    };
    let args = cu_args_new();
    {
        let pp: ptr = PTR_NULL();
        PTR_BYTE_ADD(pp, &out_before.path, 0);
        cu_args_push(args, pp, out_before.path_len);
    } 
    cu_args_push(args, STR_PTR("update"), STR_LEN("update"));
    let bo = CuBigBuf { bytes: [0u8; 4194304], len: 0, overflow: false };
    let be = CuBigBuf { bytes: [0u8; 4194304], len: 0, overflow: false };
    let rc = cu_exec_doc(args, 300000, 4194304, &bo, &be);
    cu_free_json(args);
    if rc != 0 { return rc; };
    let arc = probeLocalCodexCliUpdate(out_after);
    if arc != 0 { return arc; };
    cu_finish_update(out_text, &bo, &be);
    return 0;
}

// ---------------------------------------------------------------------------
// sshArgs / shellQuote / redact (TS L137-162)
// ---------------------------------------------------------------------------

// Tokenize per /(?:[^\s"']+|"[^"]*"|'[^']*')+/g with the TS's
// independent leading/trailing quote strip. Fills out_args with the
// parts AFTER "ssh"; returns 0, or -1 for the TS throw
// ("SSH command must look like: ssh user@host").
fn sshArgs(command_ptr: ptr, command_len: u64, out_args: &u64, out_count: &u64) -> i32 {
    let parts = cu_args_new();
    *out_args = 0;
    *out_count = 0;
    if parts == 0 { return -1; };
    let i: u64 = 0;
    while i < command_len {
        // skip whitespace between tokens
        let b = cu_byte(command_ptr, i);
        if b == 32 || (b >= 9 && b <= 13) {
            i = i + 1;
            continue;
        };
        // one token = glued segments
        let tok = CuStr { bytes: [0u8; 8192], len: 0 };
        let in_token = true;
        while in_token && i < command_len {
            let c = cu_byte(command_ptr, i);
            if c == 32 || (c >= 9 && c <= 13) {
                in_token = false;
                break;
            };
            if c == 34 || c == 39 {
                // quoted segment: consume through the closing quote
                let q = c;
                let seg_start = i;
                i = i + 1;
                while i < command_len && cu_byte(command_ptr, i) != q {
                    i = i + 1;
                } 
                if i < command_len { i = i + 1; };
                let sp: ptr = PTR_NULL();
                PTR_BYTE_ADD(sp, command_ptr, seg_start);
                cu_str_push(&tok, sp, i - seg_start);
            } else {
                let run_start = i;
                while i < command_len {
                    let c2 = cu_byte(command_ptr, i);
                    if c2 == 32 || (c2 >= 9 && c2 <= 13) || c2 == 34 || c2 == 39 { break; };
                    i = i + 1;
                }
                let rp: ptr = PTR_NULL();
                PTR_BYTE_ADD(rp, command_ptr, run_start);
                cu_str_push(&tok, rp, i - run_start);
            };
        }
        // strip one leading and/or one trailing quote char (independent)
        let tp = cu_str_ptr(&tok);
        let tn = tok.len;
        let ts: u64 = 0;
        let te = tn;
        if tn > 0 && (cu_byte(tp, 0) == 34 || cu_byte(tp, 0) == 39) { ts = 1; };
        if te > ts && (cu_byte(tp, te - 1) == 34 || cu_byte(tp, te - 1) == 39) { te = te - 1; };
        let fp: ptr = PTR_NULL();
        PTR_BYTE_ADD(fp, tp, ts);
        cu_args_push(parts, fp, te - ts);
    }
    let count: u64 = 0;
    sa_json_value_count(parts, &count);
    if count < 2 {
        sa_json_free(parts);
        return -1;
    };
    let first: u64 = 0;
    if sa_json_array_get(parts, 0, &first) != 0 || first == 0 || sa_json_kind(first) != 5 {
        sa_json_free(parts);
        return -1;
    };
    let fp2: ptr = sa_json_string_ptr(first);
    let fn2 = sa_json_string_len(first);
    if !cu_eq_bytes(fp2, fn2, STR_PTR("ssh"), STR_LEN("ssh")) {
        sa_json_free(parts);
        return -1;
    };
    // out = parts.slice(1)
    let rest = cu_args_new();
    let i2: u64 = 1;
    while i2 < count {
        let el: u64 = 0;
        if sa_json_array_get(parts, i2, &el) == 0 && el != 0 && sa_json_kind(el) == 5 {
            let ep: ptr = sa_json_string_ptr(el);
            cu_args_push(rest, ep, sa_json_string_len(el));
        };
        i2 = i2 + 1;
    }
    sa_json_free(parts);
    *out_args = rest;
    let rc: u64 = 0;
    if rest != 0 { sa_json_value_count(rest, &rc); };
    *out_count = rc;
    return 0;
}

fn shellQuote(value_ptr: ptr, value_len: u64, out_ptr: &ptr, out_len: &u64) -> void {
    let acc = CuStr { bytes: [0u8; 8192], len: 0 };
    cu_str_push_lit(&acc, STR_PTR("'"), STR_LEN("'"));
    let i: u64 = 0;
    while i < value_len {
        let b = cu_byte(value_ptr, i);
        if b == 39 {
            cu_str_push_lit(&acc, STR_PTR("'\\''"), STR_LEN("'\\''"));
        } else {
            let bp: ptr = PTR_NULL();
            PTR_BYTE_ADD(bp, value_ptr, i);
            cu_str_push(&acc, bp, 1);
        };
        i = i + 1;
    }
    cu_str_push_lit(&acc, STR_PTR("'"), STR_LEN("'"));
    cu_fmt_result(cu_str_ptr(&acc), acc.len, out_ptr, out_len);
}

fn cu_is_token_char(b: u8) -> bool {
    return (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || (b >= 48 && b <= 57) || b == 95 || b == 45;
}

fn redact(value_ptr: ptr, value_len: u64, out_ptr: &ptr, out_len: &u64) -> void {
    let acc = CuBigBuf { bytes: [0u8; 4194304], len: 0, overflow: false };
    let ap = cu_bigbuf_ptr(&acc);
    let i: u64 = 0;
    while i < value_len {
        // match /sk-[A-Za-z0-9_-]{12,}/ at i?
        let matched = false;
        if i + 3 <= value_len && cu_byte(value_ptr, i) == 115 && cu_byte(value_ptr, i + 1) == 107 && cu_byte(value_ptr, i + 2) == 45 {
            let j = i + 3;
            while j < value_len && cu_is_token_char(cu_byte(value_ptr, j)) {
                j = j + 1;
            }
            if j - (i + 3) >= 12 {
                // replace the whole match with "sk-***"
                if acc.len + 6 <= 4194304 {
                    let dp: ptr = PTR_NULL();
                    PTR_BYTE_ADD(dp, ap, acc.len);
                    cu_field_copy(dp, 6, STR_PTR("sk-***"), STR_LEN("sk-***"));
                    acc.len = acc.len + 6;
                };
                i = j;
                matched = true;
            };
        };
        if !matched {
            if acc.len < 4194304 {
                acc.bytes[acc.len] = cu_byte(value_ptr, i);
                acc.len = acc.len + 1;
            };
            i = i + 1;
        };
    }
    // .slice(-16384)
    if acc.len > 16384 {
        let tp: ptr = PTR_NULL();
        PTR_BYTE_ADD(tp, ap, acc.len - 16384);
        cu_fmt_result(tp, 16384, out_ptr, out_len);
        return;
    };
    cu_fmt_result(ap, acc.len, out_ptr, out_len);
}

// ---------------------------------------------------------------------------
// SSH probe / update (TS L137-152)
// ---------------------------------------------------------------------------

fn cu_set_probe_field(dst_p: ptr, dst_cap: u64, src_p: ptr, src_n: u64, out_len: &u64) -> void {
    *out_len = cu_field_copy(dst_p, dst_cap, src_p, src_n);
}

fn probeSshCodexCliUpdate(command_ptr: ptr, command_len: u64, out: &CodexCliUpdateProbe) -> i32 {
    cu_probe_clear(out);
    let args: u64 = 0;
    let argc: u64 = 0;
    let arc = sshArgs(command_ptr, command_len, &args, &argc);
    if arc != 0 { return arc; };
    let script = STR_PTR("codex_bin=\"$(command -v codex 2>/dev/null || true)\"; [ -n \"$codex_bin\" ] || codex_bin=\"$HOME/.local/bin/codex\"; [ -x \"$codex_bin\" ] || exit 127; printf 'path=%s\\n' \"$codex_bin\"; printf 'version=%s\\n' \"$(\"$codex_bin\" --version 2>/dev/null | head -n1)\"; if \"$codex_bin\" update --help 2>/dev/null | grep -q 'Update Codex'; then echo updateSupported=1; else echo updateSupported=0; fi");
    let script_n = STR_LEN("codex_bin=\"$(command -v codex 2>/dev/null || true)\"; [ -n \"$codex_bin\" ] || codex_bin=\"$HOME/.local/bin/codex\"; [ -x \"$codex_bin\" ] || exit 127; printf 'path=%s\\n' \"$codex_bin\"; printf 'version=%s\\n' \"$(\"$codex_bin\" --version 2>/dev/null | head -n1)\"; if \"$codex_bin\" update --help 2>/dev/null | grep -q 'Update Codex'; then echo updateSupported=1; else echo updateSupported=0; fi");
    cu_args_push(args, script, script_n);
    let bo = CuBigBuf { bytes: [0u8; 4194304], len: 0, overflow: false };
    let be = CuBigBuf { bytes: [0u8; 4194304], len: 0, overflow: false };
    let rc = cu_exec_doc(args, 30000, 262144, &bo, &be);
    cu_free_json(args);
    if rc != 0 { return rc; };
    // parse key=value lines (split /\r?\n/, first '=' with index > 0,
    // later entries overwrite — Object.fromEntries)
    let path_v = CuStr { bytes: [0u8; 8192], len: 0 };
    let version_v = CuStr { bytes: [0u8; 8192], len: 0 };
    let supported_v = CuStr { bytes: [0u8; 8192], len: 0 };
    let bp = cu_bigbuf_ptr(&bo);
    let line_start: u64 = 0;
    let i: u64 = 0;
    while i <= bo.len {
        if i == bo.len || cu_byte(bp, i) == 10 {
            let line_end = i;
            if line_end > line_start && cu_byte(bp, line_end - 1) == 13 { line_end = line_end - 1; };
            // find first '='
            let eq: i64 = -1;
            let j = line_start;
            while j < line_end {
                if cu_byte(bp, j) == 61 { eq = (j) as i64; break; };
                j = j + 1;
            }
            if eq > (line_start as i64) {
                let key_p: ptr = PTR_NULL();
                PTR_BYTE_ADD(key_p, bp, line_start);
                let key_n = ((eq) as u64) - line_start;
                let val_p: ptr = PTR_NULL();
                PTR_BYTE_ADD(val_p, bp, ((eq) as u64) + 1);
                let val_n = line_end - (((eq) as u64) + 1);
                if cu_eq_bytes(key_p, key_n, STR_PTR("path"), STR_LEN("path")) {
                    path_v.len = 0;
                    cu_str_push(&path_v, val_p, val_n);
                } else if cu_eq_bytes(key_p, key_n, STR_PTR("version"), STR_LEN("version")) {
                    version_v.len = 0;
                    cu_str_push(&version_v, val_p, val_n);
                } else if cu_eq_bytes(key_p, key_n, STR_PTR("updateSupported"), STR_LEN("updateSupported")) {
                    supported_v.len = 0;
                    cu_str_push(&supported_v, val_p, val_n);
                };
            };
            line_start = i + 1;
        };
        i = i + 1;
    }
    out.scope = 1;
    {
        let dp: ptr = PTR_NULL();
        PTR_BYTE_ADD(dp, &out.path, 0);
        out.path_len = cu_field_copy(dp, 1024, cu_str_ptr(&path_v), path_v.len);
        let dp2: ptr = PTR_NULL();
        PTR_BYTE_ADD(dp2, &out.version, 0);
        out.version_len = cu_field_copy(dp2, 128, cu_str_ptr(&version_v), version_v.len);
    } 
    out.updateSupported = cu_eq_bytes(cu_str_ptr(&supported_v), supported_v.len, STR_PTR("1"), STR_LEN("1"));
    out.checkedAt = cu_now_ms();
    return 0;
}

fn updateSshCodexCli(command_ptr: ptr, command_len: u64, out_before: &CodexCliUpdateProbe, out_after: &CodexCliUpdateProbe, out_text: &u64) -> i32 {
    *out_text = 0;
    let brc = probeSshCodexCliUpdate(command_ptr, command_len, out_before);
    if brc != 0 { return brc; };
    if !out_before.updateSupported || out_before.path_len == 0 {
        // TS: throw new Error("The remote Codex CLI does not support `codex update`")
        return 2;
    };
    let args: u64 = 0;
    let argc: u64 = 0;
    let arc = sshArgs(command_ptr, command_len, &args, &argc);
    if arc != 0 { return arc; };
    let qp: ptr = PTR_NULL();
    let qn: u64 = 0;
    {
        let pp: ptr = PTR_NULL();
        PTR_BYTE_ADD(pp, &out_before.path, 0);
        shellQuote(pp, out_before.path_len, &qp, &qn);
    } 
    let cmd = CuStr { bytes: [0u8; 8192], len: 0 };
    cu_str_push(&cmd, qp, qn);
    cu_str_push_lit(&cmd, STR_PTR(" update"), STR_LEN(" update"));
    cu_args_push(args, cu_str_ptr(&cmd), cmd.len);
    let bo = CuBigBuf { bytes: [0u8; 4194304], len: 0, overflow: false };
    let be = CuBigBuf { bytes: [0u8; 4194304], len: 0, overflow: false };
    let rc = cu_exec_doc(args, 300000, 4194304, &bo, &be);
    cu_free_json(args);
    if rc != 0 { return rc; };
    let arc2 = probeSshCodexCliUpdate(command_ptr, command_len, out_after);
    if arc2 != 0 { return arc2; };
    cu_finish_update(out_text, &bo, &be);
    return 0;
}
