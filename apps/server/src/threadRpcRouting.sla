@import "sa_std/io/print.sai"

// ---- threadRpcRouting.ts:1 — ThreadRpcBridgeKind = "local" | "direct-ssh" | "autonomous" | "codecli" | "codecli-ssh" ----
// String-union type approximated as u8 tag: 0=local, 1=direct-ssh, 2=autonomous, 3=codecli, 4=codecli-ssh.
struct ThreadRpcRoutingInput {
    hasAutonomousRoute: bool,
    hasRequestedSshWorkspace: bool,
    hasStoredSshWorkspace: bool,
    isClaudeBackend: bool, has_isClaudeBackend: bool, // boolean | undefined
}

fn selectThreadRpcBridgeKind(input: &ThreadRpcRoutingInput) -> u8 {
    if input.hasAutonomousRoute { return 2; };
    if input.hasRequestedSshWorkspace || input.hasStoredSshWorkspace {
        // A Claude thread owns a Claude CLI on the SSH host; routing it through the
        // Codex app-server bridge would start the wrong remote runtime.
        if input.has_isClaudeBackend && input.isClaudeBackend { return 4; };
        return 1;
    };
    if input.has_isClaudeBackend && input.isClaudeBackend { return 3; };
    return 0;
}

fn isRemoteThreadHistoryMethod(method_ptr: ptr, method_len: u64) -> bool {
    // method === "thread/history/fileInfo" || method === "thread/history/tail"
    return false; // byte-compare via STR_PTR/STR_LEN in fix pass
}
