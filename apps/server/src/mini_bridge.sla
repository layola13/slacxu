// mini_bridge: the SLA mirror of CXU's miniBridge.ts. Owns the
// thread state and the turn loop:
//   user item -> relay gateway turn (std sse_turn, chat mode)
//   -> tool_calls execute via sa_vm and results go back into the
//      thread -> next round; a text-only turn completes the turn.
// Events emitted to the client stream use the CXU vocabulary:
// turn/started, item/started, item/agentMessage/delta,
// item/completed, turn/completed, turn/failed.
@import "sa_std/http_server.sai"
@import "sa_std/http_client.sai"
@import "sa_std/encoding/json.sai"
@import "sa_std/string.sa"
@import "sa_std/ptr.sa"
@import "helpers.sla"
@import "sa_vm.sla"

struct Thread {
    msgs: [u8; 40960],
    msgs_len: u64,
    id: [u8; 64],
    id_len: u64,
    turn_seq: u64,
}

fn thread_reset(th: &Thread, id_ptr: ptr, id_len: u64) -> void {
    th.msgs_len = 0;
    th.turn_seq = 0;
    th.id_len = 0;
    let i: u64 = 0;
    let byte: u8 = 0;
    while i < id_len && i < 64 {
        BYTE_AT_OUT(byte, id_ptr, i);
        th.id[i] = byte;
        th.id_len = th.id_len + 1;
        i = i + 1;
    }
}

// Appends one JSON fragment to the thread's message list,
// comma-separated. The fragment arrives as a built ByteBuf.
fn msgs_append_buf(th: &Thread, frag: &ByteBuf) -> void {
    if th.msgs_len > 0 {
        if th.msgs_len < 40960 {
            th.msgs[th.msgs_len] = 44;
            th.msgs_len = th.msgs_len + 1;
        };
    };
    let i: u64 = 0;
    while i < frag.len {
        if th.msgs_len < 40960 {
            th.msgs[th.msgs_len] = frag.bytes[i];
            th.msgs_len = th.msgs_len + 1;
        };
        i = i + 1;
    }
}

// Writes one SSE event line ("data: <json>\n\n") to the stream.
fn emit_ev(sresp: ptr, ev: &ByteBuf) -> bool {
    if sa_http_server_resp_stream_write_v2(sresp, STR_PTR("data: "), STR_LEN("data: "), 5000) != 0 { return false; };
    if sa_http_server_resp_stream_write_v2(sresp, &ev.bytes, ev.len, 5000) != 0 { return false; };
    if sa_http_server_resp_stream_write_v2(sresp, STR_PTR("\n\n"), STR_LEN("\n\n"), 5000) != 0 { return false; };
    sa_http_server_resp_stream_flush_v2(sresp);
    return true;
}

// CXU MINI_ACTION_HINT_RE at pilot scope: an action-intent first
// turn is sent with tool_choice "required".
fn has_action_intent(p_ptr: ptr, p_len: u64) -> bool {
    if bytes_contains(p_ptr, p_len, STR_PTR("list"), STR_LEN("list")) { return true; };
    if bytes_contains(p_ptr, p_len, STR_PTR("read"), STR_LEN("read")) { return true; };
    if bytes_contains(p_ptr, p_len, STR_PTR("file"), STR_LEN("file")) { return true; };
    if bytes_contains(p_ptr, p_len, STR_PTR("director"), STR_LEN("director")) { return true; };
    if bytes_contains(p_ptr, p_len, STR_PTR("open"), STR_LEN("open")) { return true; };
    if bytes_contains(p_ptr, p_len, STR_PTR("inspect"), STR_LEN("inspect")) { return true; };
    if bytes_contains(p_ptr, p_len, STR_PTR("列出"), STR_LEN("列出")) { return true; };
    if bytes_contains(p_ptr, p_len, STR_PTR("读取"), STR_LEN("读取")) { return true; };
    if bytes_contains(p_ptr, p_len, STR_PTR("文件"), STR_LEN("文件")) { return true; };
    if bytes_contains(p_ptr, p_len, STR_PTR("目录"), STR_LEN("目录")) { return true; };
    if bytes_contains(p_ptr, p_len, STR_PTR("打开"), STR_LEN("打开")) { return true; };
    if bytes_contains(p_ptr, p_len, STR_PTR("查看"), STR_LEN("查看")) { return true; };
    return false;
}

fn ev_thread_prefix(ev: &ByteBuf, th: &Thread, method_ptr: ptr, method_len: u64) -> void {
    buf_reset(ev);
    buf_append_lit(ev, STR_PTR("{\"method\":\""), STR_LEN("{\"method\":\""));
    buf_append_lit(ev, method_ptr, method_len);
    buf_append_lit(ev, STR_PTR("\",\"params\":{\"threadId\":\""), STR_LEN("\",\"params\":{\"threadId\":\""));
    let ii: u64 = 0;
    while ii < th.id_len {
        let ib = th.id[ii];
        if ib == 34 {
            buf_append_lit(ev, STR_PTR("\\\""), STR_LEN("\\\""));
        } else if ib == 92 {
            buf_append_lit(ev, STR_PTR("\\\\"), STR_LEN("\\\\"));
        } else {
            if ev.len < 40960 {
                ev.bytes[ev.len] = ib;
                ev.len = ev.len + 1;
            };
        };
        ii = ii + 1;
    }
    buf_append_lit(ev, STR_PTR("\",\"turnId\":"), STR_LEN("\",\"turnId\":"));
    buf_append_u64(ev, th.turn_seq);
}

// Finds needle in (hay_ptr, hay_len); returns its offset or
// 4294967295 when absent.
fn find_sub_ptr(hay_ptr: ptr, hay_len: u64, needle_ptr: ptr, needle_len: u64) -> u64 {
    if hay_len < needle_len { return 4294967295; };
    let i: u64 = 0;
    let hb: u8 = 0;
    let nb: u8 = 0;
    while i + needle_len <= hay_len {
        let j: u64 = 0;
        let ok = true;
        while j < needle_len {
            BYTE_AT_OUT(hb, hay_ptr, i + j);
            BYTE_AT_OUT(nb, needle_ptr, j);
            if hb != nb { ok = false; };
            j = j + 1;
        }
        if ok { return i; };
        i = i + 1;
    }
    return 4294967295;
}

// Locates the "args" array inside a tool-call arguments object
// and returns its exact JSON span (brackets included), so
// run_host receives the array verbatim. False when absent.
struct Span {
    ptr: ptr,
    len: u64,
}

fn bytes_eq_str(a_ptr: ptr, a_len: u64, b_ptr: ptr, b_len: u64) -> bool {
    if a_len != b_len { return false; };
    return find_sub_ptr(a_ptr, a_len, b_ptr, b_len) == 0;
}

fn find_span_for_key(ar_ptr: ptr, ar_len: u64, key_ptr: ptr, key_len: u64, span: &Span) -> bool {
    let key = key_ptr;
    let key_len_v = key_len;
    let kp = find_sub_ptr(ar_ptr, ar_len, key, key_len_v);
    if kp == 4294967295 { return false; };
    let i = kp + key_len_v;
    let b: u8 = 0;
    // skip to the opening bracket
    while i < ar_len {
        BYTE_AT_OUT(b, ar_ptr, i);
        if b == 91 { break; };
        i = i + 1;
    }
    if i >= ar_len { return false; };
    let start = i;
    let depth: u64 = 0;
    let in_str = false;
    let esc = false;
    while i < ar_len {
        BYTE_AT_OUT(b, ar_ptr, i);
        if in_str {
            if esc {
                esc = false;
            } else if b == 92 {
                esc = true;
            } else if b == 34 {
                in_str = false;
            };
        } else if b == 34 {
            in_str = true;
        } else if b == 91 {
            depth = depth + 1;
        } else if b == 93 {
            depth = depth - 1;
            if depth == 0 {
                let fp: ptr = PTR_NULL();
                PTR_ADD_OUT(fp, ar_ptr, start);
                span.ptr = fp;
                span.len = i + 1 - start;
                return true;
            };
        };
        i = i + 1;
    }
    return false;
}

// Runs one user turn to completion, streaming item events.
// Returns 0 on turn/completed; 99 when the client went away;
// other codes mark bridge/upstream failures (turn/failed sent).
fn bridge_run_turn(sresp: ptr, th: &Thread, ev: &ByteBuf, scratch: &ByteBuf, body: &ByteBuf, res: &ByteBuf, prompt_ptr: ptr, prompt_len: u64) -> i32 {
    // Scratch buffers are caller-owned: an imported function may
    // not declare locals with very large arrays (the import
    // expander rejects them), so the server allocates these once.
    th.turn_seq = th.turn_seq + 1;
    buf_reset(ev);
    buf_reset(scratch);
    buf_reset(body);
    buf_reset(res);

    ev_thread_prefix(ev, th, STR_PTR("turn/started"), STR_LEN("turn/started"));
    buf_append_lit(ev, STR_PTR("}}"), STR_LEN("}}"));
    if !emit_ev(sresp, ev) { return 99; };

    if th.msgs_len == 0 {
        buf_reset(scratch);
        let sys = "{\"role\":\"system\",\"content\":\"You are Mini Agent, a workspace agent. Use the sa_vm tool to inspect real files when a task needs real data. Never invent file contents. When you have enough information, answer directly without calling tools.\"}";
        buf_append_lit(scratch, STR_PTR(sys), STR_LEN(sys));
        msgs_append_buf(th, scratch);
    };
    buf_reset(scratch);
    buf_append_lit(scratch, STR_PTR("{\"role\":\"user\",\"content\":\""), STR_LEN("{\"role\":\"user\",\"content\":\""));
    buf_append_escaped(scratch, prompt_ptr, prompt_len);
    buf_append_lit(scratch, STR_PTR("\"}"), STR_LEN("\"}"));
    msgs_append_buf(th, scratch);

    let force = has_action_intent(prompt_ptr, prompt_len);
    let url = "https://api.kilo.ai/api/gateway/chat/completions";
    let key = "";
    let schema = "{\"type\":\"function\",\"function\":{\"name\":\"sa_vm\",\"description\":\"Native workspace tool. action=list_dir lists a directory as JSON. action=read_file reads a text file. action=find_files searches file names recursively under path matching pattern. action=run_host runs exe with args (structured, no shell).\",\"parameters\":{\"type\":\"object\",\"properties\":{\"action\":{\"type\":\"string\",\"enum\":[\"list_dir\",\"read_file\",\"find_files\",\"run_host\"]},\"path\":{\"type\":\"string\"},\"pattern\":{\"type\":\"string\"},\"exe\":{\"type\":\"string\"},\"args\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}}},\"required\":[\"action\"]}}}";
    let schema2 = "{\"type\":\"function\",\"function\":{\"name\":\"read_skill\",\"description\":\"Reads a skill file (SKILL.md) by skill name from the workspace skill roots.\",\"parameters\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"}},\"required\":[\"name\"]}}}";
    let schema3 = "{\"type\":\"function\",\"function\":{\"name\":\"update_plan\",\"description\":\"Records or updates the task plan. Call this first for multi-step tasks, and again whenever step statuses change.\",\"parameters\":{\"type\":\"object\",\"properties\":{\"explanation\":{\"type\":\"string\"},\"plan\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"step\":{\"type\":\"string\"},\"status\":{\"type\":\"string\",\"enum\":[\"pending\",\"in_progress\",\"completed\"]}},\"required\":[\"step\",\"status\"]}}},\"required\":[\"plan\"]}}}";
    let usage_in: u64 = 0;
    let usage_out: u64 = 0;
    let usage_total: u64 = 0;
    let usage_seen = false;
    let rounds: u64 = 0;
    while 1 == 1 {
        if th.msgs_len > 40000 {
            ev_thread_prefix(ev, th, STR_PTR("turn/failed"), STR_LEN("turn/failed"));
            buf_append_lit(ev, STR_PTR(",\"error\":\"thread too long for the v2 in-memory cap. Start a new thread\"}}"), STR_LEN(",\"error\":\"thread too long for the v2 in-memory cap. Start a new thread\"}}"));
            emit_ev(sresp, ev);
            return 42;
        };
        buf_reset(body);
        buf_append_lit(body, STR_PTR("{\"model\":\"kilo-auto/free\",\"stream\":true,\"stream_options\":{\"include_usage\":true},\"messages\":["), STR_LEN("{\"model\":\"kilo-auto/free\",\"stream\":true,\"stream_options\":{\"include_usage\":true},\"messages\":["));
        let mi: u64 = 0;
        while mi < th.msgs_len {
            if body.len < 40960 {
                body.bytes[body.len] = th.msgs[mi];
                body.len = body.len + 1;
            };
            mi = mi + 1;
        }
        buf_append_lit(body, STR_PTR("],\"tools\":["), STR_LEN("],\"tools\":["));
        buf_append_lit(body, STR_PTR(schema), STR_LEN(schema));
        buf_append_lit(body, STR_PTR(","), STR_LEN(","));
        buf_append_lit(body, STR_PTR(schema2), STR_LEN(schema2));
        buf_append_lit(body, STR_PTR(","), STR_LEN(","));
        buf_append_lit(body, STR_PTR(schema3), STR_LEN(schema3));
        buf_append_lit(body, STR_PTR("],\"tool_choice\":\""), STR_LEN("],\"tool_choice\":\""));
        if force {
            buf_append_lit(body, STR_PTR("required"), STR_LEN("required"));
        } else {
            buf_append_lit(body, STR_PTR("auto"), STR_LEN("auto"));
        };
        buf_append_lit(body, STR_PTR("\",\"max_tokens\":1024}"), STR_LEN("\",\"max_tokens\":1024}"));

        let t_ptr: ptr = PTR_NULL();
        let t_len: u64 = 0;
        let c_ptr: ptr = PTR_NULL();
        let c_len: u64 = 0;
        let u_ptr: ptr = PTR_NULL();
        let u_len: u64 = 0;
        let r_ptr: ptr = PTR_NULL();
        let r_len: u64 = 0;
        rounds = rounds + 1;
        let st = sa_http_client_sse_turn_ex(STR_PTR(url), STR_LEN(url), &body.bytes, body.len, STR_PTR(key), STR_LEN(key), 1, &t_ptr, &t_len, &c_ptr, &c_len, &u_ptr, &u_len, &r_ptr, &r_len);
        if st != 2 && u_len > 0 {
            let udoc = sa_json_parse(u_ptr, u_len);
            if udoc != 0 {
                let v_in: u64 = 0;
                let v_out: u64 = 0;
                let v_tot: u64 = 0;
                if sa_json_object_get_i64(udoc, STR_PTR("prompt_tokens"), STR_LEN("prompt_tokens"), &v_in) == 0 {
                    usage_in = usage_in + v_in;
                    usage_seen = true;
                };
                if sa_json_object_get_i64(udoc, STR_PTR("completion_tokens"), STR_LEN("completion_tokens"), &v_out) == 0 {
                    usage_out = usage_out + v_out;
                };
                if sa_json_object_get_i64(udoc, STR_PTR("total_tokens"), STR_LEN("total_tokens"), &v_tot) == 0 {
                    usage_total = usage_total + v_tot;
                };
            };
            // usage buffer intentionally not freed: the .sai free contract takes an owned capability the out ptr cannot provide (see wall list).
        };
        if r_len > 0 {
            buf_reset(ev);
            buf_append_lit(ev, STR_PTR("{\"method\":\"item/started\",\"params\":{\"item\":{\"type\":\"reasoning\",\"id\":\"mini-rsn-"), STR_LEN("{\"method\":\"item/started\",\"params\":{\"item\":{\"type\":\"reasoning\",\"id\":\"mini-rsn-"));
            buf_append_u64(ev, th.turn_seq);
            buf_append_lit(ev, STR_PTR("-"), STR_LEN("-"));
            buf_append_u64(ev, rounds);
            buf_append_lit(ev, STR_PTR("\"}}}"), STR_LEN("\"}}}"));
            if !emit_ev(sresp, ev) { return 99; };
            buf_reset(ev);
            buf_append_lit(ev, STR_PTR("{\"method\":\"item/reasoning/textDelta\",\"params\":{\"itemId\":\"mini-rsn-"), STR_LEN("{\"method\":\"item/reasoning/textDelta\",\"params\":{\"itemId\":\"mini-rsn-"));
            buf_append_u64(ev, th.turn_seq);
            buf_append_lit(ev, STR_PTR("-"), STR_LEN("-"));
            buf_append_u64(ev, rounds);
            buf_append_lit(ev, STR_PTR("\",\"delta\":\""), STR_LEN("\",\"delta\":\""));
            buf_append_escaped(ev, r_ptr, r_len);
            buf_append_lit(ev, STR_PTR("\"}}"), STR_LEN("\"}}"));
            if !emit_ev(sresp, ev) { return 99; };
            buf_reset(ev);
            buf_append_lit(ev, STR_PTR("{\"method\":\"item/completed\",\"params\":{\"item\":{\"type\":\"reasoning\",\"id\":\"mini-rsn-"), STR_LEN("{\"method\":\"item/completed\",\"params\":{\"item\":{\"type\":\"reasoning\",\"id\":\"mini-rsn-"));
            buf_append_u64(ev, th.turn_seq);
            buf_append_lit(ev, STR_PTR("-"), STR_LEN("-"));
            buf_append_u64(ev, rounds);
            buf_append_lit(ev, STR_PTR("\",\"text\":\""), STR_LEN("\",\"text\":\""));
            buf_append_escaped(ev, r_ptr, r_len);
            buf_append_lit(ev, STR_PTR("\",\"status\":\"completed\"}}}}"), STR_LEN("\",\"status\":\"completed\"}}}}"));
            if !emit_ev(sresp, ev) { return 99; };
        };
        if st == 2 {
            ev_thread_prefix(ev, th, STR_PTR("turn/failed"), STR_LEN("turn/failed"));
            buf_append_lit(ev, STR_PTR(",\"error\":\"upstream error\"}}"), STR_LEN(",\"error\":\"upstream error\"}}"));
            emit_ev(sresp, ev);
            return 40;
        };
        if st == 1 {
            let doc = sa_json_parse(c_ptr, c_len);
            if doc == 0 {
                ev_thread_prefix(ev, th, STR_PTR("turn/failed"), STR_LEN("turn/failed"));
                buf_append_lit(ev, STR_PTR(",\"error\":\"bad tool call payload\"}}"), STR_LEN(",\"error\":\"bad tool call payload\"}}"));
                emit_ev(sresp, ev);
                return 41;
            };
            // Pass A: append the assistant tool_calls message and
            // emit a toolCall item/started per call.
            buf_reset(scratch);
            buf_append_lit(scratch, STR_PTR("{\"role\":\"assistant\",\"content\":null,\"tool_calls\":["), STR_LEN("{\"role\":\"assistant\",\"content\":null,\"tool_calls\":["));
            let idx: u64 = 0;
            let first = true;
            while 1 == 1 {
                let el: u64 = 0;
                if sa_json_array_get(doc, idx, &el) != 0 { break; };
                let cid_ptr: ptr = PTR_NULL();
                let cid_len: u64 = 0;
                let nm_ptr: ptr = PTR_NULL();
                let nm_len: u64 = 0;
                let ar_ptr: ptr = PTR_NULL();
                let ar_len: u64 = 0;
                sa_json_object_get_string(el, STR_PTR("call_id"), STR_LEN("call_id"), &cid_ptr, &cid_len);
                sa_json_object_get_string(el, STR_PTR("name"), STR_LEN("name"), &nm_ptr, &nm_len);
                sa_json_object_get_string(el, STR_PTR("args"), STR_LEN("args"), &ar_ptr, &ar_len);
                if !first {
                    buf_append_lit(scratch, STR_PTR(","), STR_LEN(","));
                };
                buf_append_lit(scratch, STR_PTR("{\"id\":\""), STR_LEN("{\"id\":\""));
                buf_append_escaped(scratch, cid_ptr, cid_len);
                buf_append_lit(scratch, STR_PTR("\",\"type\":\"function\",\"function\":{\"name\":\""), STR_LEN("\",\"type\":\"function\",\"function\":{\"name\":\""));
                buf_append_escaped(scratch, nm_ptr, nm_len);
                buf_append_lit(scratch, STR_PTR("\",\"arguments\":\""), STR_LEN("\",\"arguments\":\""));
                buf_append_escaped(scratch, ar_ptr, ar_len);
                buf_append_lit(scratch, STR_PTR("\"}}"), STR_LEN("\"}}"));
                buf_reset(ev);
                buf_append_lit(ev, STR_PTR("{\"method\":\"item/started\",\"params\":{\"item\":{\"type\":\"toolCall\",\"id\":\""), STR_LEN("{\"method\":\"item/started\",\"params\":{\"item\":{\"type\":\"toolCall\",\"id\":\""));
                buf_append_escaped(ev, cid_ptr, cid_len);
                buf_append_lit(ev, STR_PTR("\",\"name\":\""), STR_LEN("\",\"name\":\""));
                buf_append_escaped(ev, nm_ptr, nm_len);
                buf_append_lit(ev, STR_PTR("\",\"status\":\"inProgress\"}}}"), STR_LEN("\",\"status\":\"inProgress\"}}}"));
                if !emit_ev(sresp, ev) { return 99; };
                first = false;
                idx = idx + 1;
            }
            buf_append_lit(scratch, STR_PTR("]}"), STR_LEN("]}"));
            msgs_append_buf(th, scratch);
            // Pass B: execute each call, append its tool result,
            // emit the toolCall item/completed.
            idx = 0;
            while 1 == 1 {
                let el: u64 = 0;
                if sa_json_array_get(doc, idx, &el) != 0 { break; };
                let cid_ptr: ptr = PTR_NULL();
                let cid_len: u64 = 0;
                let ar_ptr: ptr = PTR_NULL();
                let ar_len: u64 = 0;
                sa_json_object_get_string(el, STR_PTR("call_id"), STR_LEN("call_id"), &cid_ptr, &cid_len);
                sa_json_object_get_string(el, STR_PTR("args"), STR_LEN("args"), &ar_ptr, &ar_len);
                let nm_ptr: ptr = PTR_NULL();
                let nm_len: u64 = 0;
                sa_json_object_get_string(el, STR_PTR("name"), STR_LEN("name"), &nm_ptr, &nm_len);
                let action_ptr: ptr = PTR_NULL();
                let action_len: u64 = 0;
                let path_ptr: ptr = PTR_NULL();
                let path_len: u64 = 0;
                let extra_ptr: ptr = PTR_NULL();
                let extra_len: u64 = 0;
                let disp_action_ptr: ptr = PTR_NULL();
                let disp_action_len: u64 = 0;
                let disp_path_ptr: ptr = PTR_NULL();
                let disp_path_len: u64 = 0;
                let adoc = sa_json_parse(ar_ptr, ar_len);
                if bytes_eq_str(nm_ptr, nm_len, STR_PTR("update_plan"), STR_LEN("update_plan")) {
                    let pspan = Span { ptr: PTR_NULL(), len: 0 };
                    let has_plan = find_span_for_key(ar_ptr, ar_len, STR_PTR("\"plan\""), STR_LEN("\"plan\""), &pspan);
                    buf_reset(res);
                    buf_append_lit(res, STR_PTR("plan recorded"), STR_LEN("plan recorded"));
                    buf_reset(ev);
                    ev_thread_prefix(ev, th, STR_PTR("turn/plan/updated"), STR_LEN("turn/plan/updated"));
                    buf_append_lit(ev, STR_PTR(",\"plan\":"), STR_LEN(",\"plan\":"));
                    if has_plan {
                        buf_append_lit(ev, pspan.ptr, pspan.len);
                    } else {
                        buf_append_lit(ev, STR_PTR("[]"), STR_LEN("[]"));
                    };
                    let ex_ptr: ptr = PTR_NULL();
                    let ex_len: u64 = 0;
                    if adoc != 0 {
                        sa_json_object_get_string(adoc, STR_PTR("explanation"), STR_LEN("explanation"), &ex_ptr, &ex_len);
                    };
                    if ex_len > 0 {
                        buf_append_lit(ev, STR_PTR(",\"explanation\":\""), STR_LEN(",\"explanation\":\""));
                        buf_append_escaped(ev, ex_ptr, ex_len);
                        buf_append_lit(ev, STR_PTR("\""), STR_LEN("\""));
                    };
                    buf_append_lit(ev, STR_PTR("}}"), STR_LEN("}}"));
                    if !emit_ev(sresp, ev) { return 99; };
                    disp_action_ptr = STR_PTR("update_plan");
                    disp_action_len = STR_LEN("update_plan");
                    disp_path_ptr = STR_PTR("");
                    disp_path_len = 0;
                } else if bytes_eq_str(nm_ptr, nm_len, STR_PTR("read_skill"), STR_LEN("read_skill")) {
                    let sk_ptr: ptr = PTR_NULL();
                    let sk_len: u64 = 0;
                    if adoc != 0 {
                        sa_json_object_get_string(adoc, STR_PTR("name"), STR_LEN("name"), &sk_ptr, &sk_len);
                    };
                    read_skill_execute(sk_ptr, sk_len, res);
                    disp_action_ptr = STR_PTR("read_skill");
                    disp_action_len = STR_LEN("read_skill");
                    disp_path_ptr = sk_ptr;
                    disp_path_len = sk_len;
                } else {
                    if adoc != 0 {
                        sa_json_object_get_string(adoc, STR_PTR("action"), STR_LEN("action"), &action_ptr, &action_len);
                        sa_json_object_get_string(adoc, STR_PTR("path"), STR_LEN("path"), &path_ptr, &path_len);
                        if bytes_eq_str(action_ptr, action_len, STR_PTR("run_host"), STR_LEN("run_host")) {
                            let exe_ptr: ptr = PTR_NULL();
                            let exe_len: u64 = 0;
                            sa_json_object_get_string(adoc, STR_PTR("exe"), STR_LEN("exe"), &exe_ptr, &exe_len);
                            if exe_len > 0 {
                                path_ptr = exe_ptr;
                                path_len = exe_len;
                            };
                            let span = Span { ptr: PTR_NULL(), len: 0 };
                            if find_span_for_key(ar_ptr, ar_len, STR_PTR("\"args\""), STR_LEN("\"args\""), &span) {
                                extra_ptr = span.ptr;
                                extra_len = span.len;
                            } else {
                                extra_ptr = STR_PTR("[]");
                                extra_len = 2;
                            };
                        } else {
                            sa_json_object_get_string(adoc, STR_PTR("pattern"), STR_LEN("pattern"), &extra_ptr, &extra_len);
                            if extra_len == 0 {
                                sa_json_object_get_string(adoc, STR_PTR("query"), STR_LEN("query"), &extra_ptr, &extra_len);
                            };
                        };
                    };
                    if path_len == 0 {
                        path_ptr = STR_PTR(".");
                        path_len = 1;
                    };
                    sa_vm_execute(action_ptr, action_len, path_ptr, path_len, extra_ptr, extra_len, res);
                    disp_action_ptr = action_ptr;
                    disp_action_len = action_len;
                    disp_path_ptr = path_ptr;
                    disp_path_len = path_len;
                };
                buf_reset(scratch);
                buf_append_lit(scratch, STR_PTR("{\"role\":\"tool\",\"tool_call_id\":\""), STR_LEN("{\"role\":\"tool\",\"tool_call_id\":\""));
                buf_append_escaped(scratch, cid_ptr, cid_len);
                buf_append_lit(scratch, STR_PTR("\",\"content\":\""), STR_LEN("\",\"content\":\""));
                buf_append_escaped_buf(scratch, res);
                buf_append_lit(scratch, STR_PTR("\"}"), STR_LEN("\"}"));
                msgs_append_buf(th, scratch);
                buf_reset(ev);
                buf_append_lit(ev, STR_PTR("{\"method\":\"item/completed\",\"params\":{\"item\":{\"type\":\"toolCall\",\"id\":\""), STR_LEN("{\"method\":\"item/completed\",\"params\":{\"item\":{\"type\":\"toolCall\",\"id\":\""));
                buf_append_escaped(ev, cid_ptr, cid_len);
                buf_append_lit(ev, STR_PTR("\",\"name\":\""), STR_LEN("\",\"name\":\""));
                if nm_len > 0 {
                    buf_append_escaped(ev, nm_ptr, nm_len);
                } else {
                    buf_append_lit(ev, STR_PTR("sa_vm"), STR_LEN("sa_vm"));
                };
                buf_append_lit(ev, STR_PTR("\",\"action\":\""), STR_LEN("\",\"action\":\""));
                buf_append_escaped(ev, disp_action_ptr, disp_action_len);
                buf_append_lit(ev, STR_PTR("\",\"path\":\""), STR_LEN("\",\"path\":\""));
                buf_append_escaped(ev, disp_path_ptr, disp_path_len);
                buf_append_lit(ev, STR_PTR("\",\"status\":\"completed\"}}}"), STR_LEN("\",\"status\":\"completed\"}}}"));
                if !emit_ev(sresp, ev) { return 99; };
                idx = idx + 1;
            }
            force = false;
            continue;
        };
        // Text turn: one agentMessage segment with the full text
        // (std sse_turn aggregates; token-level deltas are a
        // documented divergence in docs/architecture-cxu-mini.md).
        buf_reset(ev);
        buf_append_lit(ev, STR_PTR("{\"method\":\"item/started\",\"params\":{\"item\":{\"type\":\"agentMessage\",\"id\":\"mini-msg-"), STR_LEN("{\"method\":\"item/started\",\"params\":{\"item\":{\"type\":\"agentMessage\",\"id\":\"mini-msg-"));
        buf_append_u64(ev, th.turn_seq);
        buf_append_lit(ev, STR_PTR("-s1\",\"status\":\"inProgress\"}}}"), STR_LEN("-s1\",\"status\":\"inProgress\"}}}"));
        if !emit_ev(sresp, ev) { return 99; };
        buf_reset(ev);
        buf_append_lit(ev, STR_PTR("{\"method\":\"item/agentMessage/delta\",\"params\":{\"itemId\":\"mini-msg-"), STR_LEN("{\"method\":\"item/agentMessage/delta\",\"params\":{\"itemId\":\"mini-msg-"));
        buf_append_u64(ev, th.turn_seq);
        buf_append_lit(ev, STR_PTR("-s1\",\"delta\":\""), STR_LEN("-s1\",\"delta\":\""));
        buf_append_escaped(ev, t_ptr, t_len);
        buf_append_lit(ev, STR_PTR("\"}}"), STR_LEN("\"}}"));
        if !emit_ev(sresp, ev) { return 99; };
        buf_reset(ev);
        buf_append_lit(ev, STR_PTR("{\"method\":\"item/completed\",\"params\":{\"item\":{\"type\":\"agentMessage\",\"id\":\"mini-msg-"), STR_LEN("{\"method\":\"item/completed\",\"params\":{\"item\":{\"type\":\"agentMessage\",\"id\":\"mini-msg-"));
        buf_append_u64(ev, th.turn_seq);
        buf_append_lit(ev, STR_PTR("-s1\",\"text\":\""), STR_LEN("-s1\",\"text\":\""));
        buf_append_escaped(ev, t_ptr, t_len);
        buf_append_lit(ev, STR_PTR("\",\"status\":\"completed\"}}}"), STR_LEN("\",\"status\":\"completed\"}}}"));
        if !emit_ev(sresp, ev) { return 99; };
        buf_reset(scratch);
        buf_append_lit(scratch, STR_PTR("{\"role\":\"assistant\",\"content\":\""), STR_LEN("{\"role\":\"assistant\",\"content\":\""));
        buf_append_escaped(scratch, t_ptr, t_len);
        buf_append_lit(scratch, STR_PTR("\"}"), STR_LEN("\"}"));
        msgs_append_buf(th, scratch);
        if usage_seen {
            buf_reset(ev);
            ev_thread_prefix(ev, th, STR_PTR("thread/tokenUsage/updated"), STR_LEN("thread/tokenUsage/updated"));
            buf_append_lit(ev, STR_PTR(",\"usage\":{\"inputTokens\":"), STR_LEN(",\"usage\":{\"inputTokens\":"));
            buf_append_u64(ev, usage_in);
            buf_append_lit(ev, STR_PTR(",\"outputTokens\":"), STR_LEN(",\"outputTokens\":"));
            buf_append_u64(ev, usage_out);
            buf_append_lit(ev, STR_PTR(",\"totalTokens\":"), STR_LEN(",\"totalTokens\":"));
            buf_append_u64(ev, usage_total);
            buf_append_lit(ev, STR_PTR("}}}"), STR_LEN("}}}"));
            if !emit_ev(sresp, ev) { return 99; };
        };
        ev_thread_prefix(ev, th, STR_PTR("turn/completed"), STR_LEN("turn/completed"));
        buf_append_lit(ev, STR_PTR(",\"status\":\"completed\"}}"), STR_LEN(",\"status\":\"completed\"}}"));
        emit_ev(sresp, ev);
        return 0;
    }
    return 0;
}
