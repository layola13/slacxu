    out.id_len = 0;
    out.repo_ptr = STR_PTR("");
    out.repo_len = 0;
    out.hasCloneUrl = false;
    out.cloneUrl_ptr = STR_PTR("");
    out.cloneUrl_len = 0;
    out.cloneable = false;
    out.installed = false;
    out.hasWrapperPath = false;
    out.wrapperPath_ptr = STR_PTR("");
    out.wrapperPath_len = 0;
    out.hasProductCliPath = false;
    out.productCliPath_ptr = STR_PTR("");
    out.productCliPath_len = 0;
    out.productCliPresent = false;
    out.hasSourceDir = false;
    out.sourceDir_ptr = STR_PTR("");
    out.sourceDir_len = 0;
    out.sourcePresent = false;
    out.envPath_ptr = STR_PTR("");
    out.envPath_len = 0;
    out.envPresent = false;
    out.envConfigured = false;
    out.envPreviewBaseUrl_ptr = STR_PTR("");
    out.envPreviewBaseUrl_len = 0;
    out.hasEnvPreviewBaseUrl = false;
    out.envPreviewModel_ptr = STR_PTR("");
    out.envPreviewModel_len = 0;
    out.hasEnvPreviewModel = false;
    out.envPreviewHasApiKey = false;
    out.needsInstall = true;
    out.needsSetup = true;
}

fn li_empty_spec(out: &LaunchAdapterSpec) -> void {
    out.id_ptr = STR_PTR("");
    out.id_len = 0;
    out.repo_ptr = STR_PTR("");
    out.repo_len = 0;
    out.hasCloneUrl = false;
    out.cloneUrl_ptr = STR_PTR("");
    out.cloneUrl_len = 0;
    out.wrapperBins_ptr = STR_PTR("");
    out.wrapperBins_len = 0;
    out.wrapperBinsCount = 0;
    out.productBins_ptr = STR_PTR("");
    out.productBins_len = 0;
    out.productBinsCount = 0;
    out.envPrefix_ptr = STR_PTR("");
    out.envPrefix_len = 0;
    out.configDirName_ptr = STR_PTR("");
    out.configDirName_len = 0;
}

fn installOne(id_ptr: ptr, id_len: u64, opts: &InstallLaunchRequest, sink_doc: u64, arena: &LiText, out: &InstallLaunchResultItem) -> i32 {
    out.id_ptr = id_ptr;
    out.id_len = id_len;
    out.ok = false;
    out.hasError = false;
    out.hasStatus = false;
    let steps_doc = li_parse(STR_PTR("[]"), STR_LEN("[]"));
    let spec = LaunchAdapterSpec { id_ptr: STR_PTR(""), id_len: 0, repo_ptr: STR_PTR(""), repo_len: 0, hasCloneUrl: false, cloneUrl_ptr: STR_PTR(""), cloneUrl_len: 0, wrapperBins_ptr: STR_PTR(""), wrapperBins_len: 0, wrapperBinsCount: 0, productBins_ptr: STR_PTR(""), productBins_len: 0, productBinsCount: 0, envPrefix_ptr: STR_PTR(""), envPrefix_len: 0, configDirName_ptr: STR_PTR(""), configDirName_len: 0 };
    if !getSpec(id_ptr, id_len, &spec) {
        let logline = LiText { bytes: [0u8; 262144], len: 0 };
        li_push(&logline, STR_PTR("未知的适配器标识: "), STR_LEN("未知的适配器标识: "));
        li_push(&logline, id_ptr, id_len);
        li_log_line(sink_doc, li_text_ptr(&logline), logline.len, 2);
        let emsg = LiText { bytes: [0u8; 262144], len: 0 };
        li_push(&emsg, STR_PTR("Unknown adapter: "), STR_LEN("Unknown adapter: "));
        li_push(&emsg, id_ptr, id_len);
        li_arena_put(arena, li_text_ptr(&emsg), emsg.len, &out.error_ptr, &out.error_len);
        out.hasError = true;
        let stext = LiText { bytes: [0u8; 262144], len: 0 };
        li_stringify_into(steps_doc, &stext);
        li_arena_put(arena, li_text_ptr(&stext), stext.len, &out.steps_ptr, &out.steps_len);
        out.stepsCount = 0;
        li_free_doc(steps_doc);
        return 0;
    };
    // --- try block ------------------------------------------------------
    let err = LiStr { bytes: [0u8; 8192], len: 0 };
    let failed = false;
    let prep = LiText { bytes: [0u8; 262144], len: 0 };
    li_push(&prep, STR_PTR("正在准备源码 ("), STR_LEN("正在准备源码 ("));
    if spec.hasCloneUrl { li_push(&prep, spec.cloneUrl_ptr, spec.cloneUrl_len); } else { li_push(&prep, id_ptr, id_len); };
    li_push(&prep, STR_PTR(")..."), STR_LEN(")..."));
    li_log_line(sink_doc, li_text_ptr(&prep), prep.len, 0);
    let source_dir = LiStr { bytes: [0u8; 8192], len: 0 };
    if ensureCloned(&spec, steps_doc, opts.sourceRoot_ptr, opts.sourceRoot_len, opts.hasSourceRoot, sink_doc, &source_dir, &err) != 0 {
        failed = true;
    };
    let effective_skip = false;
    if !failed {
        let ready = LiText { bytes: [0u8; 262144], len: 0 };
        li_push(&ready, STR_PTR("✓ 源码目录就绪: "), STR_LEN("✓ 源码目录就绪: "));
        li_push(&ready, li_str_ptr(&source_dir), source_dir.len);
        li_log_line(sink_doc, li_text_ptr(&ready), ready.len, 1);
        // skip-cli decision
        let prod = LiStr { bytes: [0u8; 8192], len: 0 };
        let prod_found = false;
        findOnPath(spec.productBins_ptr, spec.productBins_len, spec.productBinsCount, &prod, &prod_found);
        let may_skip = true;
        if opts.hasSkipCli && !opts.skipCli { may_skip = false; };
        if may_skip {
            // bins joined with "/"
            let bins = LiStr { bytes: [0u8; 8192], len: 0 };
            let bdoc = li_parse(spec.productBins_ptr, spec.productBins_len);
            if bdoc != 0 {
                let bc: u64 = 0;
                sa_json_value_count(bdoc, &bc);
                let bi: u64 = 0;
                while bi < bc {
                    let bitem: u64 = 0;
                    if sa_json_array_get(bdoc, bi, &bitem) == 0 {
                        if bitem != 0 && sa_json_kind(bitem) == 5 {
                            if bi > 0 { li_push_str(&bins, STR_PTR("/"), STR_LEN("/")); };
                            let bip: ptr = sa_json_string_ptr(bitem);
                            li_push_str(&bins, bip, sa_json_string_len(bitem));
                        };
                    };
                    bi = bi + 1;
                }
                li_free_doc(bdoc);
            };
            if prod_found {
                effective_skip = true;
                let m = LiText { bytes: [0u8; 262144], len: 0 };
                li_push(&m, STR_PTR("["), STR_LEN("["));
                li_push(&m, id_ptr, id_len);
                li_push(&m, STR_PTR("] 检测到 "), STR_LEN("] 检测到 "));
                li_push(&m, li_str_ptr(&bins), bins.len);
                li_push(&m, STR_PTR(" CLI 已在 PATH 中，将使用 --skip-cli 跳过 CLI 重复安装"), STR_LEN(" CLI 已在 PATH 中，将使用 --skip-cli 跳过 CLI 重复安装"));
                li_log_line(sink_doc, li_text_ptr(&m), m.len, 0);
            } else {
                let m = LiText { bytes: [0u8; 262144], len: 0 };
                li_push(&m, STR_PTR("["), STR_LEN("["));
                li_push(&m, id_ptr, id_len);
                li_push(&m, STR_PTR("] 未检测到 "), STR_LEN("] 未检测到 "));
                li_push(&m, li_str_ptr(&bins), bins.len);
                li_push(&m, STR_PTR(" CLI，将正常执行 CLI 安装"), STR_LEN(" CLI，将正常执行 CLI 安装"));
                li_log_line(sink_doc, li_text_ptr(&m), m.len, 0);
            };
        } else {
            let m = LiText { bytes: [0u8; 262144], len: 0 };
            li_push(&m, STR_PTR("["), STR_LEN("["));
            li_push(&m, id_ptr, id_len);
            li_push(&m, STR_PTR("] 用户设置不跳过，将安装/重新安装 CLI"), STR_LEN("] 用户设置不跳过，将安装/重新安装 CLI"));
            li_log_line(sink_doc, li_text_ptr(&m), m.len, 0);
        };
        let runmsg = LiText { bytes: [0u8; 262144], len: 0 };
        li_push(&runmsg, STR_PTR("正在运行 bash ./install.sh "), STR_LEN("正在运行 bash ./install.sh "));
        if effective_skip { li_push(&runmsg, STR_PTR("--skip-cli"), STR_LEN("--skip-cli")); };
        li_push(&runmsg, STR_PTR(" ..."), STR_LEN(" ..."));
        li_log_line(sink_doc, li_text_ptr(&runmsg), runmsg.len, 0);
        if runInstallSh(li_str_ptr(&source_dir), source_dir.len, effective_skip, steps_doc, sink_doc, &err) != 0 {
            failed = true;
        };
    };
    if !failed {
        let done_msg = LiText { bytes: [0u8; 262144], len: 0 };
        li_push(&done_msg, STR_PTR("✓ ./install.sh 执行完成"), STR_LEN("✓ ./install.sh 执行完成"));
        li_log_line(sink_doc, li_text_ptr(&done_msg), done_msg.len, 1);
        if opts.hasEnvMode && opts.envMode != 2 {
            let values = LaunchEnvValues { hasBaseUrl: false, baseUrl_ptr: STR_PTR(""), baseUrl_len: 0, hasModel: false, model_ptr: STR_PTR(""), model_len: 0, hasApiKey: false, apiKey_ptr: STR_PTR(""), apiKey_len: 0 };
            if opts.envMode == 0 {
                values.hasBaseUrl = opts.sharedEnv.hasBaseUrl;
                values.baseUrl_ptr = opts.sharedEnv.baseUrl_ptr;
                values.baseUrl_len = opts.sharedEnv.baseUrl_len;
                values.hasModel = opts.sharedEnv.hasModel;
                values.model_ptr = opts.sharedEnv.model_ptr;
                values.model_len = opts.sharedEnv.model_len;
                values.hasApiKey = opts.sharedEnv.hasApiKey;
                values.apiKey_ptr = opts.sharedEnv.apiKey_ptr;
                values.apiKey_len = opts.sharedEnv.apiKey_len;
            } else {
                let sdoc = li_parse(opts.separateEnv_ptr, opts.separateEnv_len);
                if sdoc != 0 {
                    let sub = li_get(sdoc, id_ptr, id_len);
                    if sub != 0 {
                        let sub_text = LiText { bytes: [0u8; 262144], len: 0 };
                        li_stringify_into(sub, &sub_text);
                        li_values_from_json(li_text_ptr(&sub_text), sub_text.len, arena, &values);
                    };
                    li_free_doc(sdoc);
                };
            };
            let env_path = LiStr { bytes: [0u8; 8192], len: 0 };
            let wrote = false;
            let skipped = false;
            writeAdapterEnv(&spec, &values, opts.hasForceEnv && opts.forceEnv, &env_path, &wrote, &skipped);
            let step = LiText { bytes: [0u8; 262144], len: 0 };
            if skipped {
                li_push(&step, STR_PTR("env skip (existing): "), STR_LEN("env skip (existing): "));
            } else {
                li_push(&step, STR_PTR("env wrote: "), STR_LEN("env wrote: "));
            };
            li_push(&step, li_str_ptr(&env_path), env_path.len);
            li_steps_push(steps_doc, li_text_ptr(&step), step.len);
            let elog = LiText { bytes: [0u8; 262144], len: 0 };
            li_push(&elog, STR_PTR("✓ 环境配置文件已写入: "), STR_LEN("✓ 环境配置文件已写入: "));
            li_push(&elog, li_str_ptr(&env_path), env_path.len);
            li_log_line(sink_doc, li_text_ptr(&elog), elog.len, 1);
        };
    };
    // --- settle -----------------------------------------------------------
    let st = LaunchAdapterStatus { id_ptr: STR_PTR(""), id_len: 0, repo_ptr: STR_PTR(""), repo_len: 0, hasCloneUrl: false, cloneUrl_ptr: STR_PTR(""), cloneUrl_len: 0, cloneable: false, installed: false, hasWrapperPath: false, wrapperPath_ptr: STR_PTR(""), wrapperPath_len: 0, hasProductCliPath: false, productCliPath_ptr: STR_PTR(""), productCliPath_len: 0, productCliPresent: false, hasSourceDir: false, sourceDir_ptr: STR_PTR(""), sourceDir_len: 0, sourcePresent: false, envPath_ptr: STR_PTR(""), envPath_len: 0, envPresent: false, envConfigured: false, envPreviewBaseUrl_ptr: STR_PTR(""), envPreviewBaseUrl_len: 0, hasEnvPreviewBaseUrl: false, envPreviewModel_ptr: STR_PTR(""), envPreviewModel_len: 0, hasEnvPreviewModel: false, envPreviewHasApiKey: false, needsInstall: true, needsSetup: true };
    detectAdapter(&spec, opts.sourceRoot_ptr, opts.sourceRoot_len, opts.hasSourceRoot, arena, &st);
    out.status = st;
    out.hasStatus = true;
    if failed {
        let elog = LiText { bytes: [0u8; 262144], len: 0 };
        li_push(&elog, STR_PTR("✗ "), STR_LEN("✗ "));
        li_push(&elog, id_ptr, id_len);
        li_push(&elog, STR_PTR(" 处理异常: "), STR_LEN(" 处理异常: "));
        li_push(&elog, li_str_ptr(&err), err.len);
        li_log_line(sink_doc, li_text_ptr(&elog), elog.len, 2);
        li_arena_put(arena, li_str_ptr(&err), err.len, &out.error_ptr, &out.error_len);
        out.hasError = true;
        out.ok = false;
    } else {
        out.ok = true;
    };
    let stext = LiText { bytes: [0u8; 262144], len: 0 };
    li_stringify_into(steps_doc, &stext);
    li_arena_put(arena, li_text_ptr(&stext), stext.len, &out.steps_ptr, &out.steps_len);
    let scnt: u64 = 0;
    sa_json_value_count(steps_doc, &scnt);
    out.stepsCount = scnt;
    li_free_doc(steps_doc);
    return 0;
}

// ---------------------------------------------------------------------------
// testOpenAiApi (TS L717-839): two-step HTTP probe over the v2 client.
// ---------------------------------------------------------------------------

struct TestOpenAiApiRequest {
hasBaseUrl: bool, baseUrl_ptr: ptr, baseUrl_len: u64,
hasModel: bool, model_ptr: ptr, model_len: u64,
hasApiKey: bool, apiKey_ptr: ptr, apiKey_len: u64,
}

struct TestOpenAiApiResult {
ok: bool, step1Ok: bool, step2Ok: bool,
message_ptr: ptr, message_len: u64,
hasStatusCode: bool, statusCode: u64,
}

// One blocking HTTP call. Returns 0 with status/body filled, or -1 on
// transport failure (err filled with a short English reason).
fn li_http_call(method: u8, url_p: ptr, url_l: u64, auth_p: ptr, auth_l: u64, has_auth: bool, body_p: ptr, body_l: u64, has_body: bool, timeout_ms: u64, out_status: &i64, out_body: &LiText, out_ctype: &LiStr, err: &LiStr) -> i32 {
*out_status = 0;
out_body.len = 0;
out_ctype.len = 0;
err.len = 0;
let use_tls = 0;
if url_l > 8 && li_byte(url_p, 4) == 115 { use_tls = 1;};
let client: u64 = 0;
let nst = sa_http_client_new_v2(use_tls, STR_PTR(""), 0, &client);
if nst!= 0 || client == 0 { li_push_str(err, STR_PTR("client init failed"), STR_LEN("client init failed")); return -1;};
let req: u64 = 0;
let rst = sa_http_client_req_new_v2(client, method, url_p, url_l, &req);
if rst!= 0 || req == 0 {
sa_http_client_free(client);
li_push_str(err, STR_PTR("request init failed"), STR_LEN("request init failed"));
return -1;
};
sa_http_client_req_add_header_v2(req, STR_PTR("Accept"), STR_LEN("Accept"), STR_PTR("application/json"), STR_LEN("application/json"));
if has_auth {
let hv = LiText { bytes: [0u8; 262144], len: 0};
li_push(&hv, STR_PTR("Bearer "), STR_LEN("Bearer "));
li_push(&hv, auth_p, auth_l);
sa_http_client_req_add_header_v2(req, STR_PTR("Authorization"), STR_LEN("Authorization"), li_text_ptr(&hv), hv.len);
};
if has_body {
sa_http_client_req_add_header_v2(req, STR_PTR("Content-Type"), STR_LEN("Content-Type"), STR_PTR("application/json"), STR_LEN("application/json"));
sa_http_client_req_set_body_v2(req, body_p, body_l);
};
sa_http_client_req_set_timeout_v2(req, timeout_ms as u32);
let resp: u64 = 0;
let sst = sa_http_client_req_send_v2(req, &resp);
if sst!= 0 || resp == 0 {
sa_http_client_req_free(req);
sa_http_client_free(client);
li_push_str(err, STR_PTR("connection failed"), STR_LEN("connection failed"));
return -1;
};
*out_status = sa_http_client_resp_status(resp) as i64;
let bp: ptr = PTR_NULL();
let bl: u64 = 0;
if sa_http_client_resp_body_slice(resp, &bp, &bl) == 0 {
li_push(out_body, bp, bl);
};
let cp: ptr = PTR_NULL();
let cl: u64 = 0;
if sa_http_client_resp_get_header(resp, STR_PTR("content-type"), STR_LEN("content-type"), &cp, &cl) == 0 {
li_push_str(out_ctype, cp, cl);
};
sa_http_client_resp_free(resp);
sa_http_client_req_free(req);
sa_http_client_free(client);
return 0;
}

fn li_test_msg(out: &TestOpenAiApiResult, arena: &LiText, p: ptr, n: u64) -> void {
li_arena_put(arena, p, n, &out.message_ptr, &out.message_len);
}

fn testOpenAiApi(values: &TestOpenAiApiRequest, arena: &LiText, out: &TestOpenAiApiResult) -> i32 {
out.ok = false;
out.step1Ok = false;
out.step2Ok = false;
out.hasStatusCode = false;
out.statusCode = 0;
out.message_ptr = STR_PTR("");
out.message_len = 0;
let base_raw = LiStr { bytes: [0u8; 8192], len: 0};
if values.hasBaseUrl { li_trimmed(values.baseUrl_ptr, values.baseUrl_len, &base_raw);};
let api_key = LiStr { bytes: [0u8; 8192], len: 0};
if values.hasApiKey { li_trimmed(values.apiKey_ptr, values.apiKey_len, &api_key);};
let model = LiStr { bytes: [0u8; 8192], len: 0};
if values.hasModel { li_trimmed(values.model_ptr, values.model_len, &model);};
if model.len == 0 { li_push_str(&model, STR_PTR("gpt-5.5"), STR_LEN("gpt-5.5"));};
if base_raw.len == 0 {
li_test_msg(out, arena, STR_PTR("需填写 Base URL 才能发起模型测试。"), STR_LEN("需填写 Base URL 才能发起模型测试。"));
return 0;
};
if api_key.len == 0 {
li_test_msg(out, arena, STR_PTR("需填写 API Key 才能发起模型测试。"), STR_LEN("需填写 API Key 才能发起模型测试。"));
return 0;
};
// normalize baseUrl: strip trailing '/', ensure /v1, strip /chat/completions tail
let base = LiStr { bytes: [0u8; 8192], len: 0};
li_push_str(&base, li_str_ptr(&base_raw), base_raw.len);
while base.len > 0 && li_byte(li_str_ptr(&base), base.len - 1) == 47 { base.len = base.len - 1;}
let seg1: ptr = PTR_NULL();
if base.len >= 3 { PTR_BYTE_ADD(seg1, li_str_ptr(&base), base.len - 3); };
let ends_v1 = base.len >= 3 && li_eq(seg1, 3, STR_PTR("/v1"), STR_LEN("/v1"));
let has_v1_mid = li_contains(li_str_ptr(&base), base.len, STR_PTR("/v1/"), STR_LEN("/v1/"));
let seg2: ptr = PTR_NULL();
if base.len >= 17 { PTR_BYTE_ADD(seg2, li_str_ptr(&base), base.len - 17); };
let ends_cc = base.len >= 17 && li_eq(seg2, 17, STR_PTR("/chat/completions"), STR_LEN("/chat/completions"));
if!ends_v1 &&!has_v1_mid {
li_push_str(&base, STR_PTR("/v1"), STR_LEN("/v1"));
} else if ends_cc {
base.len = base.len - 17;
};
// Step 1: GET {base}/models (6000 ms)
let url1 = LiStr { bytes: [0u8; 8192], len: 0};
li_join2(li_str_ptr(&base), base.len, STR_PTR("models"), STR_LEN("models"), &url1);
let status: i64 = 0;
let body = LiText { bytes: [0u8; 262144], len: 0};
let ctype = LiStr { bytes: [0u8; 8192], len: 0};
let err = LiStr { bytes: [0u8; 8192], len: 0};
let t0 = sa_time_unix_ms();
let rc1 = li_http_call(1, li_str_ptr(&url1), url1.len, li_str_ptr(&api_key), api_key.len, true, STR_PTR(""), 0, false, 6000, &status, &body, &ctype, &err);
if rc1!= 0 {
let elapsed = sa_time_unix_ms() - t0;
let msg = LiText { bytes: [0u8; 262144], len: 0};
li_push(&msg, STR_PTR("获取模型列表 "), STR_LEN("获取模型列表 "));
if elapsed >= 6000 {
li_push(&msg, STR_PTR("6秒超时"), STR_LEN("6秒超时"));
} else {
li_push(&msg, STR_PTR("连接失败"), STR_LEN("连接失败"));
};
li_push(&msg, STR_PTR(": "), STR_LEN(": "));
li_push(&msg, li_str_ptr(&err), err.len);
li_test_msg(out, arena, li_text_ptr(&msg), msg.len);
return 0;
};
if status < 200 || status >= 300 {
out.hasStatusCode = true;
out.statusCode = status as u64;
let msg = LiText { bytes: [0u8; 262144], len: 0};
li_push(&msg, STR_PTR("无法获取模型列表 (HTTP "), STR_LEN("无法获取模型列表 (HTTP "));
let num = LiStr { bytes: [0u8; 8192], len: 0};
li_i64_text(status, &num);
li_push(&msg, li_str_ptr(&num), num.len);
li_push(&msg, STR_PTR(")。请检查 API Key 与 Base URL 是否正确。"), STR_LEN(")。请检查 API Key 与 Base URL 是否正确。"));
if body.len > 0 {
li_push(&msg, STR_PTR(" 错误提示: "), STR_LEN(" 错误提示: "));
let take = body.len;
if take > 150 { take = 150;};
li_push(&msg, li_text_ptr(&body), take);
};
li_test_msg(out, arena, li_text_ptr(&msg), msg.len);
return 0;
};
// Step 2: POST {base}/chat/completions (10000 ms)
let url2 = LiStr { bytes: [0u8; 8192], len: 0};
li_join2(li_str_ptr(&base), base.len, STR_PTR("chat/completions"), STR_LEN("chat/completions"), &url2);
let payload = LiText { bytes: [0u8; 262144], len: 0};
li_push(&payload, STR_PTR("{\"model\":"), STR_LEN("{\"model\":"));
let pdoc = li_parse(STR_PTR("{}"), STR_LEN("{}"));
let mdoc = li_parse(STR_PTR("[]"), STR_LEN("[]"));
let msg_obj = li_parse(STR_PTR("{}"), STR_LEN("{}"));
if msg_obj!= 0 {
sa_json_object_set_string(msg_obj, STR_PTR("role"), STR_LEN("role"), STR_PTR("user"), STR_LEN("user"));
sa_json_object_set_string(msg_obj, STR_PTR("content"), STR_LEN("content"), STR_PTR("hi"), STR_LEN("hi"));
sa_json_array_push_node(mdoc, msg_obj);
li_free_doc(msg_obj);
};
if pdoc!= 0 {
sa_json_object_set_string(pdoc, STR_PTR("model"), STR_LEN("model"), li_str_ptr(&model), model.len);
sa_json_object_set_node(pdoc, STR_PTR("messages"), STR_LEN("messages"), mdoc);
sa_json_object_set_i64(pdoc, STR_PTR("max_tokens"), STR_LEN("max_tokens"), 15);
li_stringify_into(pdoc, &payload);
li_free_doc(pdoc);
};
li_free_doc(mdoc);
let status2: i64 = 0;
let body2 = LiText { bytes: [0u8; 262144], len: 0};
let ctype2 = LiStr { bytes: [0u8; 8192], len: 0};
let err2 = LiStr { bytes: [0u8; 8192], len: 0};
let t1 = sa_time_unix_ms();
let rc2 = li_http_call(2, li_str_ptr(&url2), url2.len, li_str_ptr(&api_key), api_key.len, true, li_text_ptr(&payload), payload.len, true, 10000, &status2, &body2, &ctype2, &err2);
if rc2!= 0 {
out.step1Ok = true;
let elapsed = sa_time_unix_ms() - t1;
if elapsed >= 10000 {
let msg = LiText { bytes: [0u8; 262144], len: 0};
li_push(&msg, STR_PTR("模型对话测试10秒超时（模型 '"), STR_LEN("模型对话测试10秒超时（模型 '"));
li_push(&msg, li_str_ptr(&model), model.len);
li_push(&msg, STR_PTR("' 超过10秒未响应），无法正常完成对话"), STR_LEN("' 超过10秒未响应），无法正常完成对话"));
li_test_msg(out, arena, li_text_ptr(&msg), msg.len);
} else {
let msg = LiText { bytes: [0u8; 262144], len: 0};
li_push(&msg, STR_PTR("无法连接到对话接口 ("), STR_LEN("无法连接到对话接口 ("));
li_push(&msg, li_str_ptr(&url2), url2.len);
li_push(&msg, STR_PTR("): "), STR_LEN("): "));
li_push(&msg, li_str_ptr(&err2), err2.len);
li_test_msg(out, arena, li_text_ptr(&msg), msg.len);
};
return 0;
};
out.hasStatusCode = true;
out.statusCode = status2 as u64;
if status2 >= 200 && status2 < 300 {
out.ok = true;
out.step1Ok = true;
out.step2Ok = true;
let msg = LiText { bytes: [0u8; 262144], len: 0};
li_push(&msg, STR_PTR("【测试通过】①模型列表获取成功  ②对话测试成功（模型 '"), STR_LEN("【测试通过】①模型列表获取成功  ②对话测试成功（模型 '"));
li_push(&msg, li_str_ptr(&model), model.len);
li_push(&msg, STR_PTR("' 10秒内正常响应）"), STR_LEN("' 10秒内正常响应）"));
li_test_msg(out, arena, li_text_ptr(&msg), msg.len);
return 0;
};
out.step1Ok = true;
// json error extraction
let json_err = LiStr { bytes: [0u8; 8192], len: 0};
if li_contains(li_str_ptr(&ctype2), ctype2.len, STR_PTR("application/json"), STR_LEN("application/json")) && body2.len > 0 {
let bdoc = li_parse(li_text_ptr(&body2), body2.len);
if bdoc!= 0 {
let enode = li_get(bdoc, STR_PTR("error"), STR_LEN("error"));
if enode!= 0 {
if sa_json_kind(enode) == 7 {
li_node_string(enode, STR_PTR("message"), STR_LEN("message"), &json_err);
};
if sa_json_kind(enode) == 5 {
let ep: ptr = sa_json_string_ptr(enode);
li_push_str(&json_err, ep, sa_json_string_len(enode));
};
};
li_free_doc(bdoc);
};
};
if status2 == 502 || status2 == 503 || status2 == 504 {
out.ok = true;
out.step2Ok = false;
let msg = LiText { bytes: [0u8; 262144], len: 0};
li_push(&msg, STR_PTR("①Base URL 与 API Key 验证成功 (HTTP 200) ②上游节点返回 HTTP "), STR_LEN("①Base URL 与 API Key 验证成功 (HTTP 200) ②上游节点返回 HTTP "));
let num = LiStr { bytes: [0u8; 8192], len: 0};
li_i64_text(status2, &num);
li_push(&msg, li_str_ptr(&num), num.len);
li_push(&msg, STR_PTR(" 网关响应。配置已成功校验并就绪！"), STR_LEN(" 网关响应。配置已成功校验并就绪！"));
li_test_msg(out, arena, li_text_ptr(&msg), msg.len);
return 0;
};
let msg = LiText { bytes: [0u8; 262144], len: 0};
li_push(&msg, STR_PTR("模型对话无法正常响应 (HTTP "), STR_LEN("模型对话无法正常响应 (HTTP "));
let num = LiStr { bytes: [0u8; 8192], len: 0};
li_i64_text(status2, &num);
li_push(&msg, li_str_ptr(&num), num.len);
li_push(&msg, STR_PTR("): "), STR_LEN("): "));
if json_err.len > 0 {
li_push(&msg, li_str_ptr(&json_err), json_err.len);
} else {
let take = body2.len;
if take > 180 { take = 180;};
li_push(&msg, li_text_ptr(&body2), take);
};
li_test_msg(out, arena, li_text_ptr(&msg), msg.len);
return 0;
}

// ---------------------------------------------------------------------------
// validateEnvModeBeforeSave (TS L841-867).
// ---------------------------------------------------------------------------

fn validateEnvModeBeforeSave(mode: u64, hasMode: bool, sharedEnv: &LaunchEnvValues, hasSharedEnv: bool, separateEnv_ptr: ptr, separateEnv_len: u64, hasSeparateEnv: bool, targetIds_ptr: ptr, targetIds_len: u64, targetCount: u64, err: &LiStr) -> i32 {
err.len = 0;
if!hasMode { return 0;};
let arena = LiText { bytes: [0u8; 262144], len: 0};
if mode == 0 && hasSharedEnv {
let req = TestOpenAiApiRequest { hasBaseUrl: sharedEnv.hasBaseUrl, baseUrl_ptr: sharedEnv.baseUrl_ptr, baseUrl_len: sharedEnv.baseUrl_len, hasModel: sharedEnv.hasModel, model_ptr: sharedEnv.model_ptr, model_len: sharedEnv.model_len, hasApiKey: sharedEnv.hasApiKey, apiKey_ptr: sharedEnv.apiKey_ptr, apiKey_len: sharedEnv.apiKey_len};
let res = TestOpenAiApiResult { ok: false, step1Ok: false, step2Ok: false, message_ptr: STR_PTR(""), message_len: 0, hasStatusCode: false, statusCode: 0};
testOpenAiApi(&req, &arena, &res);
if!res.ok {
li_push_str(err, STR_PTR("OpenAI API test failed: "), STR_LEN("OpenAI API test failed: "));
li_push_str(err, res.message_ptr, res.message_len);
return -1;
};
return 0;
};
if mode == 1 && hasSeparateEnv {
let sdoc = li_parse(separateEnv_ptr, separateEnv_len);
let tdoc = li_parse(targetIds_ptr, targetIds_len);
let tested = LiText { bytes: [0u8; 262144], len: 0};
li_push(&tested, STR_PTR("[]"), STR_LEN("[]"));
let tested_count: u64 = 0;
let ii: u64 = 0;
while ii < targetCount {
if tdoc!= 0 {
let id_item: u64 = 0;
if sa_json_array_get(tdoc, ii, &id_item) == 0 {
if id_item!= 0 && sa_json_kind(id_item) == 5 {
let idp: ptr = sa_json_string_ptr(id_item);
let idl: u64 = sa_json_string_len(id_item);
if sdoc!= 0 {
let sub = li_get(sdoc, idp, idl);
if sub!= 0 {
let sub_text = LiText { bytes: [0u8; 262144], len: 0};
li_stringify_into(sub, &sub_text);
let vals = LaunchEnvValues { hasBaseUrl: false, baseUrl_ptr: STR_PTR(""), baseUrl_len: 0, hasModel: false, model_ptr: STR_PTR(""), model_len: 0, hasApiKey: false, apiKey_ptr: STR_PTR(""), apiKey_len: 0};
let varena = LiText { bytes: [0u8; 262144], len: 0};
li_values_from_json(li_text_ptr(&sub_text), sub_text.len, &varena, &vals);
if (vals.hasBaseUrl && vals.baseUrl_len > 0) || (vals.hasApiKey && vals.apiKey_len > 0) {
// dedup key baseUrl:apiKey:model
let key = LiText { bytes: [0u8; 262144], len: 0};
if vals.hasBaseUrl { li_push(&key, vals.baseUrl_ptr, vals.baseUrl_len);};
li_push(&key, STR_PTR(":"), STR_LEN(":"));
if vals.hasApiKey { li_push(&key, vals.apiKey_ptr, vals.apiKey_len);};
li_push(&key, STR_PTR(":"), STR_LEN(":"));
if vals.hasModel { li_push(&key, vals.model_ptr, vals.model_len);};
let tdoc2 = li_parse(li_text_ptr(&tested), tested.len);
let dup = false;
if tdoc2!= 0 {
let tc: u64 = 0;
sa_json_value_count(tdoc2, &tc);
let ti: u64 = 0;
while ti < tc {
let titem: u64 = 0;
if sa_json_array_get(tdoc2, ti, &titem) == 0 {
if titem!= 0 && sa_json_kind(titem) == 5 {
let tp3: ptr = sa_json_string_ptr(titem);
if li_eq(tp3, sa_json_string_len(titem), li_text_ptr(&key), key.len) { dup = true;};
};
};
ti = ti + 1;
}
li_free_doc(tdoc2);
};
if!dup {
li_dirs_push_unique(&tested, &tested_count, li_text_ptr(&key), key.len);
let req = TestOpenAiApiRequest { hasBaseUrl: vals.hasBaseUrl, baseUrl_ptr: vals.baseUrl_ptr, baseUrl_len: vals.baseUrl_len, hasModel: vals.hasModel, model_ptr: vals.model_ptr, model_len: vals.model_len, hasApiKey: vals.hasApiKey, apiKey_ptr: vals.apiKey_ptr, apiKey_len: vals.apiKey_len};
let res = TestOpenAiApiResult { ok: false, step1Ok: false, step2Ok: false, message_ptr: STR_PTR(""), message_len: 0, hasStatusCode: false, statusCode: 0};
testOpenAiApi(&req, &arena, &res);
if!res.ok {
li_push_str(err, STR_PTR("OpenAI API test failed for adapter "), STR_LEN("OpenAI API test failed for adapter "));
li_push_str(err, idp, idl);
li_push_str(err, STR_PTR(": "), STR_LEN(": "));
li_push_str(err, res.message_ptr, res.message_len);
li_free_doc(sdoc);
li_free_doc(tdoc);
return -1;
};
};
};
};
};
};
};
};
ii = ii + 1;
}
li_free_doc(sdoc);
li_free_doc(tdoc);
return 0;
};
return 0;
}

// ---------------------------------------------------------------------------
// R11 install lock (sa_global cell state) + installLaunchAdapters
// (TS L869-940) + writeEnvsOnly (TS L942-972).
// ---------------------------------------------------------------------------

fn li_cell_get(key_p: ptr, key_l: u64) -> u64 {
    let v: u64 = 0;
    sa_global_u64_get(key_p, key_l, &v);
    return v;
}

fn li_cell_set(key_p: ptr, key_l: u64, v: u64) -> void {
    sa_global_u64_set(key_p, key_l, v);
}

fn li_lock_acquire(key_p: ptr, key_l: u64) -> void {
    while true {
        if li_cell_get(key_p, key_l) == 0 {
            li_cell_set(key_p, key_l, 1);
            return;
        };
        sa_time_sleep_ms(10);
    }
}

fn li_lock_release(key_p: ptr, key_l: u64) -> void {
    li_cell_set(key_p, key_l, 0);
}

fn installLockHeldNow() -> bool {
    return li_cell_get(STR_PTR("launchinstall.lock"), STR_LEN("launchinstall.lock")) != 0;
}

struct InstallLaunchOutcome {
    results: LiText, resultsCount: u64,
    adapters: LiText, adaptersCount: u64,
}

fn li_item_json(item: &InstallLaunchResultItem, out: &LiText) -> void {
    out.len = 0;
    let doc = li_parse(STR_PTR("{}"), STR_LEN("{}"));
    if doc == 0 { li_push(out, STR_PTR("{}"), STR_LEN("{}")); return; };
    sa_json_object_set_string(doc, STR_PTR("id"), STR_LEN("id"), item.id_ptr, item.id_len);
    sa_json_object_set_bool(doc, STR_PTR("ok"), STR_LEN("ok"), item.ok);
    let sdoc = li_parse(item.steps_ptr, item.steps_len);
    if sdoc != 0 {
        sa_json_object_set_node(doc, STR_PTR("steps"), STR_LEN("steps"), sdoc);
        li_free_doc(sdoc);
    } else {
        let empty = li_parse(STR_PTR("[]"), STR_LEN("[]"));
        sa_json_object_set_node(doc, STR_PTR("steps"), STR_LEN("steps"), empty);
        li_free_doc(empty);
    };
    if item.hasError {
        sa_json_object_set_string(doc, STR_PTR("error"), STR_LEN("error"), item.error_ptr, item.error_len);
    };
    if item.hasStatus {
        let sj = LiText { bytes: [0u8; 262144], len: 0 };
        li_status_json(&item.status, &sj);
        let stdoc = li_parse(li_text_ptr(&sj), sj.len);
        if stdoc != 0 {
            sa_json_object_set_node(doc, STR_PTR("status"), STR_LEN("status"), stdoc);
            li_free_doc(stdoc);
        };
    };
    li_stringify_into(doc, out);
    li_free_doc(doc);
}

fn installLaunchAdapters(state: &LaunchInstallState, opts: &InstallLaunchRequest, sink_doc: u64, out: &InstallLaunchOutcome) -> i32 {
    out.results.len = 0;
    out.resultsCount = 0;
    out.adapters.len = 0;
    out.adaptersCount = 0;
    li_lock_acquire(STR_PTR("launchinstall.lock"), STR_LEN("launchinstall.lock"));
    state.installLockHeld = true;
    // --- resolve ids ------------------------------------------------------
    let ids = LiText { bytes: [0u8; 262144], len: 0 };
    li_push(&ids, STR_PTR("[]"), STR_LEN("[]"));
    let ids_count: u64 = 0;
    if opts.hasIds {
        let idoc = li_parse(opts.ids_ptr, opts.ids_len);
        if idoc != 0 {
            let ic: u64 = 0;
            sa_json_value_count(idoc, &ic);
            let ii: u64 = 0;
            while ii < ic {
                let iitem: u64 = 0;
                if sa_json_array_get(idoc, ii, &iitem) == 0 {
                    if iitem != 0 && sa_json_kind(iitem) == 5 {
                        let ip: ptr = sa_json_string_ptr(iitem);
                        li_dirs_push_unique(&ids, &ids_count, ip, sa_json_string_len(iitem));
                    };
                };
                ii = ii + 1;
            }
            li_free_doc(idoc);
        };
    };
    let want_all = opts.hasMissingOnly && opts.missingOnly;
    if want_all || ids_count == 0 {
        let all = LiText { bytes: [0u8; 262144], len: 0 };
        let acnt: u64 = 0;
        detectAll(opts.sourceRoot_ptr, opts.sourceRoot_len, opts.hasSourceRoot, &all, &acnt);
        let adoc = li_parse(li_text_ptr(&all), all.len);
        let picked = LiText { bytes: [0u8; 262144], len: 0 };
        li_push(&picked, STR_PTR("[]"), STR_LEN("[]"));
        let picked_count: u64 = 0;
        if adoc != 0 {
            let arr = li_get(adoc, STR_PTR("adapters"), STR_LEN("adapters"));
            if arr != 0 {
                let ac: u64 = 0;
                sa_json_value_count(arr, &ac);
                let ai: u64 = 0;
                while ai < ac {
                    let aitem: u64 = 0;
                    if sa_json_array_get(arr, ai, &aitem) == 0 {
                        if aitem != 0 {
                            let keep = true;
                            if want_all {
                                let ni = li_get(aitem, STR_PTR("needsInstall"), STR_LEN("needsInstall"));
                                let nv: bool = false;
                                if ni != 0 { sa_json_as_bool(ni, &nv); };
                                keep = nv;
                            };
                            if keep {
                                let cl = li_get(aitem, STR_PTR("cloneable"), STR_LEN("cloneable"));
                                let cv: bool = false;
                                if cl != 0 { sa_json_as_bool(cl, &cv); };
                                let sp = li_get(aitem, STR_PTR("sourcePresent"), STR_LEN("sourcePresent"));
                                let sv: bool = false;
                                if sp != 0 { sa_json_as_bool(sp, &sv); };
                                keep = cv || sv;
                            };
                            if keep {
                                let idv = LiStr { bytes: [0u8; 8192], len: 0 };
                                if li_node_string(aitem, STR_PTR("id"), STR_LEN("id"), &idv) {
                                    li_dirs_push_unique(&picked, &picked_count, li_str_ptr(&idv), idv.len);
                                };
                            };
                        };
                    };
                    ai = ai + 1;
                }
            };
            li_free_doc(adoc);
        };
        if opts.hasIds && ids_count > 0 {
            // intersect picked with the explicit ids, order = picked order
            let inter = LiText { bytes: [0u8; 262144], len: 0 };
            li_push(&inter, STR_PTR("[]"), STR_LEN("[]"));
            let inter_count: u64 = 0;
            let pdoc = li_parse(li_text_ptr(&picked), picked.len);
            let edoc = li_parse(opts.ids_ptr, opts.ids_len);
            if pdoc != 0 && edoc != 0 {
                let pc: u64 = 0;
                sa_json_value_count(pdoc, &pc);
                let pi2: u64 = 0;
                while pi2 < pc {
                    let pitem: u64 = 0;
                    if sa_json_array_get(pdoc, pi2, &pitem) == 0 {
                        if pitem != 0 && sa_json_kind(pitem) == 5 {
                            let pp3: ptr = sa_json_string_ptr(pitem);
                            let pl3: u64 = sa_json_string_len(pitem);
                            let ec: u64 = 0;
                            sa_json_value_count(edoc, &ec);
                            let ei: u64 = 0;
                            let found = false;
                            while ei < ec {
                                let eitem: u64 = 0;
                                if sa_json_array_get(edoc, ei, &eitem) == 0 {
                                    if eitem != 0 && sa_json_kind(eitem) == 5 {
                                        let ep3: ptr = sa_json_string_ptr(eitem);
                                        if li_eq(ep3, sa_json_string_len(eitem), pp3, pl3) { found = true; };
                                    };
                                };
                                ei = ei + 1;
                            }
                            if found { li_dirs_push_unique(&inter, &inter_count, pp3, pl3); };
                        };
                    };
                    pi2 = pi2 + 1;
                }
            };
            li_free_doc(pdoc);
            li_free_doc(edoc);
            ids = inter;
            ids_count = inter_count;
        } else {
            ids = picked;
            ids_count = picked_count;
        };
    };
    // --- header logs --------------------------------------------------------
    let start_msg = LiText { bytes: [0u8; 262144], len: 0 };
    li_push(&start_msg, STR_PTR("开始按顺序一键安装选定的 "), STR_LEN("开始按顺序一键安装选定的 "));
    let nnum = LiStr { bytes: [0u8; 8192], len: 0 };
    li_i64_text(ids_count as i64, &nnum);
    li_push(&start_msg, li_str_ptr(&nnum), nnum.len);
    li_push(&start_msg, STR_PTR(" 个适配器: ["), STR_LEN(" 个适配器: ["));
    let idoc2 = li_parse(li_text_ptr(&ids), ids.len);
    if idoc2 != 0 {
        let ic2: u64 = 0;
        sa_json_value_count(idoc2, &ic2);
        let ii2: u64 = 0;
        while ii2 < ic2 {
            let iitem: u64 = 0;
            if sa_json_array_get(idoc2, ii2, &iitem) == 0 {
                if iitem != 0 && sa_json_kind(iitem) == 5 {
                    if ii2 > 0 { li_push(&start_msg, STR_PTR(", "), STR_LEN(", ")); };
                    let ip: ptr = sa_json_string_ptr(iitem);
                    li_push(&start_msg, ip, sa_json_string_len(iitem));
                };
            };
            ii2 = ii2 + 1;
        }
        li_free_doc(idoc2);
    };
    li_push(&start_msg, STR_PTR("]"), STR_LEN("]"));
    li_log_line(sink_doc, li_text_ptr(&start_msg), start_msg.len, 0);
    let root = LiStr { bytes: [0u8; 8192], len: 0 };
    defaultSourceRoot(opts.sourceRoot_ptr, opts.sourceRoot_len, opts.hasSourceRoot, &root);
    let root_msg = LiText { bytes: [0u8; 262144], len: 0 };
    li_push(&root_msg, STR_PTR("源码保存路径: "), STR_LEN("源码保存路径: "));
    li_push(&root_msg, li_str_ptr(&root), root.len);
    li_log_line(sink_doc, li_text_ptr(&root_msg), root_msg.len, 0);
    // --- env model validation (warn-only) ---------------------------------
    let skip_test = opts.hasSkipModelTest && opts.skipModelTest;
    if opts.hasEnvMode && opts.envMode != 2 && !skip_test {
        li_log_line(sink_doc, STR_PTR("正在校验 OpenAI API 模型可用性..."), STR_LEN("正在校验 OpenAI API 模型可用性..."), 3);
        let verr = LiStr { bytes: [0u8; 8192], len: 0 };
        let vrc = validateEnvModeBeforeSave(opts.envMode, true, &opts.sharedEnv, opts.hasSharedEnv, opts.separateEnv_ptr, opts.separateEnv_len, opts.hasSeparateEnv, li_text_ptr(&ids), ids.len, ids_count, &verr);
        if vrc == 0 {
            li_log_line(sink_doc, STR_PTR("✓ OpenAI API 模型连通性测试通过"), STR_LEN("✓ OpenAI API 模型连通性测试通过"), 1);
        } else {
            let wm = LiText { bytes: [0u8; 262144], len: 0 };
            li_push(&wm, STR_PTR("⚠ 模型校验返回警告/超时: "), STR_LEN("⚠ 模型校验返回警告/超时: "));
            li_push(&wm, li_str_ptr(&verr), verr.len);
            li_log_line(sink_doc, li_text_ptr(&wm), wm.len, 3);
            li_log_line(sink_doc, STR_PTR("仍将继续为您克隆源码并保存 .env 配置，请在安装完成后检查网络"), STR_LEN("仍将继续为您克隆源码并保存 .env 配置，请在安装完成后检查网络"), 0);
        };
    };
    // --- sequential install loop ---------------------------------------------
    let results_doc = li_parse(STR_PTR("[]"), STR_LEN("[]"));
    let arena = LiText { bytes: [0u8; 262144], len: 0 };
    let ok_count: u64 = 0;
    let fail_count: u64 = 0;
    let current: u64 = 1;
    let loop_doc = li_parse(li_text_ptr(&ids), ids.len);
    let total = ids_count;
    let li2: u64 = 0;
    while li2 < total {
        let idp: ptr = STR_PTR("");
        let idl: u64 = 0;
        let id_scratch = LiStr { bytes: [0u8; 8192], len: 0 };
        if loop_doc != 0 {
            let iitem: u64 = 0;
            if sa_json_array_get(loop_doc, li2, &iitem) == 0 {
                if iitem != 0 && sa_json_kind(iitem) == 5 {
                    let ip: ptr = sa_json_string_ptr(iitem);
                    li_push_str(&id_scratch, ip, sa_json_string_len(iitem));
                };
            };
        };
        idp = li_str_ptr(&id_scratch);
        idl = id_scratch.len;
        li_log_line(sink_doc, STR_PTR("----------------------------------------"), STR_LEN("----------------------------------------"), 0);
        let head = LiText { bytes: [0u8; 262144], len: 0 };
        li_push(&head, STR_PTR("["), STR_LEN("["));
        let cn = LiStr { bytes: [0u8; 8192], len: 0 };
        li_i64_text(current as i64, &cn);
        li_push(&head, li_str_ptr(&cn), cn.len);
        li_push(&head, STR_PTR("/"), STR_LEN("/"));
        let tn2 = LiStr { bytes: [0u8; 8192], len: 0 };
        li_i64_text(total as i64, &tn2);
        li_push(&head, li_str_ptr(&tn2), tn2.len);
        li_push(&head, STR_PTR("] 正在处理适配器: "), STR_LEN("] 正在处理适配器: "));
        li_push(&head, idp, idl);
        li_log_line(sink_doc, li_text_ptr(&head), head.len, 0);
        arena.len = 0;
        let item = InstallLaunchResultItem { id_ptr: STR_PTR(""), id_len: 0, ok: false, steps_ptr: STR_PTR(""), steps_len: 0, stepsCount: 0, hasError: false, error_ptr: STR_PTR(""), error_len: 0, hasStatus: false, status: LaunchAdapterStatus { id_ptr: STR_PTR(""), id_len: 0, repo_ptr: STR_PTR(""), repo_len: 0, hasCloneUrl: false, cloneUrl_ptr: STR_PTR(""), cloneUrl_len: 0, cloneable: false, installed: false, hasWrapperPath: false, wrapperPath_ptr: STR_PTR(""), wrapperPath_len: 0, hasProductCliPath: false, productCliPath_ptr: STR_PTR(""), productCliPath_len: 0, productCliPresent: false, hasSourceDir: false, sourceDir_ptr: STR_PTR(""), sourceDir_len: 0, sourcePresent: false, envPath_ptr: STR_PTR(""), envPath_len: 0, envPresent: false, envConfigured: false, envPreviewBaseUrl_ptr: STR_PTR(""), envPreviewBaseUrl_len: 0, hasEnvPreviewBaseUrl: false, envPreviewModel_ptr: STR_PTR(""), envPreviewModel_len: 0, hasEnvPreviewModel: false, envPreviewHasApiKey: false, needsInstall: true, needsSetup: true } };
        installOne(idp, idl, opts, sink_doc, &arena, &item);
        let ij = LiText { bytes: [0u8; 262144], len: 0 };
        li_item_json(&item, &ij);
        let ijdoc = li_parse(li_text_ptr(&ij), ij.len);
        if ijdoc != 0 {
            sa_json_array_push_node(results_doc, ijdoc);
            li_free_doc(ijdoc);
        };
        out.resultsCount = out.resultsCount + 1;
        if item.ok {
            ok_count = ok_count + 1;
            let m = LiText { bytes: [0u8; 262144], len: 0 };
            li_push(&m, STR_PTR("["), STR_LEN("["));
            li_push(&m, li_str_ptr(&cn), cn.len);
            li_push(&m, STR_PTR("/"), STR_LEN("/"));
            li_push(&m, li_str_ptr(&tn2), tn2.len);
            li_push(&m, STR_PTR("] ✓ "), STR_LEN("] ✓ "));
            li_push(&m, idp, idl);
            li_push(&m, STR_PTR(" 安装配置完毕"), STR_LEN(" 安装配置完毕"));
            li_log_line(sink_doc, li_text_ptr(&m), m.len, 1);
        } else {
            fail_count = fail_count + 1;
            let m = LiText { bytes: [0u8; 262144], len: 0 };
            li_push(&m, STR_PTR("["), STR_LEN("["));
            li_push(&m, li_str_ptr(&cn), cn.len);
            li_push(&m, STR_PTR("/"), STR_LEN("/"));
            li_push(&m, li_str_ptr(&tn2), tn2.len);
            li_push(&m, STR_PTR("] ✗ "), STR_LEN("] ✗ "));
            li_push(&m, idp, idl);
            li_push(&m, STR_PTR(" 处理失败: "), STR_LEN(" 处理失败: "));
            if item.hasError { li_push(&m, item.error_ptr, item.error_len); };
            li_log_line(sink_doc, li_text_ptr(&m), m.len, 2);
        };
        current = current + 1;
        li2 = li2 + 1;
    }
    li_free_doc(loop_doc);
    li_log_line(sink_doc, STR_PTR("----------------------------------------"), STR_LEN("----------------------------------------"), 0);
    let summary = LiText { bytes: [0u8; 262144], len: 0 };
    li_push(&summary, STR_PTR("所有适配器处理完毕：成功 "), STR_LEN("所有适配器处理完毕：成功 "));
    let on = LiStr { bytes: [0u8; 8192], len: 0 };
    li_i64_text(ok_count as i64, &on);
    li_push(&summary, li_str_ptr(&on), on.len);
    li_push(&summary, STR_PTR(" 个，失败 "), STR_LEN(" 个，失败 "));
    let fn2 = LiStr { bytes: [0u8; 8192], len: 0 };
    li_i64_text(fail_count as i64, &fn2);
    li_push(&summary, li_str_ptr(&fn2), fn2.len);
    li_push(&summary, STR_PTR(" 个"), STR_LEN(" 个"));
    let slevel: u64 = 2;
    if ok_count > 0 { slevel = 1; };
    li_log_line(sink_doc, li_text_ptr(&summary), summary.len, slevel);
    li_stringify_into(results_doc, &out.results);
    li_free_doc(results_doc);
    let acnt: u64 = 0;
    detectAll(opts.sourceRoot_ptr, opts.sourceRoot_len, opts.hasSourceRoot, &out.adapters, &acnt);
    out.adaptersCount = acnt;
    state.installLockHeld = false;
    li_lock_release(STR_PTR("launchinstall.lock"), STR_LEN("launchinstall.lock"));
    return 0;
}

fn writeEnvsOnly(mode: u64, sharedEnv: &LaunchEnvValues, hasSharedEnv: bool, separateEnv_ptr: ptr, separateEnv_len: u64, hasSeparateEnv: bool, ids_ptr: ptr, ids_len: u64, idsCount: u64, hasIds: bool, force: bool, out: &LiText, outCount: &u64) -> i32 {
    out.len = 0;
    *outCount = 0;
    // targets = (ids | all spec ids) filtered by getSpec
    let targets = LiText { bytes: [0u8; 262144], len: 0 };
    li_push(&targets, STR_PTR("[]"), STR_LEN("[]"));
    let tcount: u64 = 0;
    if hasIds {
        let tdoc = li_parse(ids_ptr, ids_len);
        if tdoc != 0 {
            let tc: u64 = 0;
            sa_json_value_count(tdoc, &tc);
            let ti: u64 = 0;
            while ti < tc {
                let titem: u64 = 0;
                if sa_json_array_get(tdoc, ti, &titem) == 0 {
                    if titem != 0 && sa_json_kind(titem) == 5 {
                        let tp: ptr = sa_json_string_ptr(titem);
                        let tl: u64 = sa_json_string_len(titem);
                        let spec = LaunchAdapterSpec { id_ptr: STR_PTR(""), id_len: 0, repo_ptr: STR_PTR(""), repo_len: 0, hasCloneUrl: false, cloneUrl_ptr: STR_PTR(""), cloneUrl_len: 0, wrapperBins_ptr: STR_PTR(""), wrapperBins_len: 0, wrapperBinsCount: 0, productBins_ptr: STR_PTR(""), productBins_len: 0, productBinsCount: 0, envPrefix_ptr: STR_PTR(""), envPrefix_len: 0, configDirName_ptr: STR_PTR(""), configDirName_len: 0 };
                        if getSpec(tp, tl, &spec) { li_dirs_push_unique(&targets, &tcount, tp, tl); };
                    };
                };
                ti = ti + 1;
            }
            li_free_doc(tdoc);
        };
    } else {
        let si: u64 = 0;
        while si < 11 {
            let spec = LaunchAdapterSpec { id_ptr: STR_PTR(""), id_len: 0, repo_ptr: STR_PTR(""), repo_len: 0, hasCloneUrl: false, cloneUrl_ptr: STR_PTR(""), cloneUrl_len: 0, wrapperBins_ptr: STR_PTR(""), wrapperBins_len: 0, wrapperBinsCount: 0, productBins_ptr: STR_PTR(""), productBins_len: 0, productBinsCount: 0, envPrefix_ptr: STR_PTR(""), envPrefix_len: 0, configDirName_ptr: STR_PTR(""), configDirName_len: 0 };
            if launchSpecAt(si, &spec) { li_dirs_push_unique(&targets, &tcount, spec.id_ptr, spec.id_len); };
            si = si + 1;
        }
    };
    // validate (errors intentionally swallowed, TS L950-954)
    let verr = LiStr { bytes: [0u8; 8192], len: 0 };
    let vrc = validateEnvModeBeforeSave(mode, true, sharedEnv, hasSharedEnv, separateEnv_ptr, separateEnv_len, hasSeparateEnv, li_text_ptr(&targets), targets.len, tcount, &verr);
    let results = li_parse(STR_PTR("[]"), STR_LEN("[]"));
    let tdoc2 = li_parse(li_text_ptr(&targets), targets.len);
    let ii: u64 = 0;
    while ii < tcount {
        let idp: ptr = STR_PTR("");
        let idl: u64 = 0;
        let id_scratch = LiStr { bytes: [0u8; 8192], len: 0 };
        if tdoc2 != 0 {
            let titem: u64 = 0;
            if sa_json_array_get(tdoc2, ii, &titem) == 0 {
                if titem != 0 && sa_json_kind(titem) == 5 {
                    let tp: ptr = sa_json_string_ptr(titem);
                    li_push_str(&id_scratch, tp, sa_json_string_len(titem));
                    idp = li_str_ptr(&id_scratch);
                    idl = id_scratch.len;
                };
            };
        };
        let spec = LaunchAdapterSpec { id_ptr: STR_PTR(""), id_len: 0, repo_ptr: STR_PTR(""), repo_len: 0, hasCloneUrl: false, cloneUrl_ptr: STR_PTR(""), cloneUrl_len: 0, wrapperBins_ptr: STR_PTR(""), wrapperBins_len: 0, wrapperBinsCount: 0, productBins_ptr: STR_PTR(""), productBins_len: 0, productBinsCount: 0, envPrefix_ptr: STR_PTR(""), envPrefix_len: 0, configDirName_ptr: STR_PTR(""), configDirName_len: 0 };
        if getSpec(idp, idl, &spec) {
            let values = LaunchEnvValues { hasBaseUrl: false, baseUrl_ptr: STR_PTR(""), baseUrl_len: 0, hasModel: false, model_ptr: STR_PTR(""), model_len: 0, hasApiKey: false, apiKey_ptr: STR_PTR(""), apiKey_len: 0 };
            let varena = LiText { bytes: [0u8; 262144], len: 0 };
            if mode == 0 {
                values.hasBaseUrl = sharedEnv.hasBaseUrl;
                values.baseUrl_ptr = sharedEnv.baseUrl_ptr;
                values.baseUrl_len = sharedEnv.baseUrl_len;
                values.hasModel = sharedEnv.hasModel;
                values.model_ptr = sharedEnv.model_ptr;
                values.model_len = sharedEnv.model_len;
                values.hasApiKey = sharedEnv.hasApiKey;
                values.apiKey_ptr = sharedEnv.apiKey_ptr;
                values.apiKey_len = sharedEnv.apiKey_len;
            } else {
                let sdoc = li_parse(separateEnv_ptr, separateEnv_len);
                if sdoc != 0 {
                    let sub = li_get(sdoc, idp, idl);
                    if sub != 0 {
                        let sub_text = LiText { bytes: [0u8; 262144], len: 0 };
                        li_stringify_into(sub, &sub_text);
                        li_values_from_json(li_text_ptr(&sub_text), sub_text.len, &varena, &values);
                    };
                    li_free_doc(sdoc);
                };
            };
            let env_path = LiStr { bytes: [0u8; 8192], len: 0 };
            let wrote = false;
            let skipped = false;
            writeAdapterEnv(&spec, &values, force, &env_path, &wrote, &skipped);
            let item = li_parse(STR_PTR("{}"), STR_LEN("{}"));
            if item != 0 {
                sa_json_object_set_string(item, STR_PTR("id"), STR_LEN("id"), idp, idl);
                sa_json_object_set_bool(item, STR_PTR("ok"), STR_LEN("ok"), true);
                sa_json_object_set_string(item, STR_PTR("path"), STR_LEN("path"), li_str_ptr(&env_path), env_path.len);
                sa_json_object_set_bool(item, STR_PTR("wrote"), STR_LEN("wrote"), wrote);
                sa_json_array_push_node(results, item);
                li_free_doc(item);
            };
            let oc = *outCount;
            *outCount = oc + 1;
        };
        ii = ii + 1;
    }
    li_free_doc(tdoc2);
    li_stringify_into(results, out);
    li_free_doc(results);
    return 0;
}

// ---------------------------------------------------------------------------
// Install jobs (TS L974-1037). Records live in one JSON doc (handle in
// the "launchinstall.jobsdoc" cell); text fields carry the logs /
// results / adapters JSON (logsText / resultsText / adaptersText),
// reified as real arrays by getInstallJob's serializer.
// ---------------------------------------------------------------------------

struct InstallJobLogItem {
    time_ptr: ptr, time_len: u64,
    text_ptr: ptr, text_len: u64,
    level: u64,
}

struct InstallJob {
    id_ptr: ptr, id_len: u64,
    status: u64,
    progressStep_ptr: ptr, progressStep_len: u64,
    logs_ptr: ptr, logs_len: u64, logsCount: u64,
    hasResults: bool, results_ptr: ptr, results_len: u64, resultsCount: u64,
    hasAdapters: bool, adapters_ptr: ptr, adapters_len: u64, adaptersCount: u64,
    hasError: bool, error_ptr: ptr, error_len: u64,
    createdAt: u64,
}

fn li_jobsdoc() -> u64 {
    let h = li_cell_get(STR_PTR("launchinstall.jobsdoc"), STR_LEN("launchinstall.jobsdoc"));
    if h != 0 { return h; };
    let doc = li_parse(STR_PTR("{}"), STR_LEN("{}"));
    li_cell_set(STR_PTR("launchinstall.jobsdoc"), STR_LEN("launchinstall.jobsdoc"), doc);
    return doc;
}

fn li_stashdoc() -> u64 {
    let h = li_cell_get(STR_PTR("launchinstall.stashdoc"), STR_LEN("launchinstall.stashdoc"));
    if h != 0 { return h; };
    let doc = li_parse(STR_PTR("{}"), STR_LEN("{}"));
    li_cell_set(STR_PTR("launchinstall.stashdoc"), STR_LEN("launchinstall.stashdoc"), doc);
    return doc;
}

fn li_rand64() -> u64 {
    let ctr = li_cell_get(STR_PTR("launchinstall.rand"), STR_LEN("launchinstall.rand")) + 1;
    li_cell_set(STR_PTR("launchinstall.rand"), STR_LEN("launchinstall.rand"), ctr);
    let x = (sa_time_unix_ms() as u64) ^ (ctr * 2654435761);
    x = x ^ (x >> 29);
    x = x * 1099511628211;
    x = x ^ (x >> 32);
    x = x * 2246822519;
    x = x ^ (x >> 29);
    return x;
}

fn li_uuid(out: &LiStr) -> void {
    out.len = 0;
    let hexd = STR_PTR("0123456789abcdef");
    let a = li_rand64();
    let b = li_rand64();
    let i: u64 = 0;
    while i < 16 {
        if i == 4 || i == 6 || i == 8 || i == 10 {
            out.bytes[out.len] = 45;
            out.len = out.len + 1;
        };
        let v: u64 = 0;
        if i < 8 {
            v = (a >> ((7 - i) * 8)) & 255;
        } else {
            v = (b >> ((15 - i) * 8)) & 255;
        };
        if i == 6 { v = (v & 15) | 64; };
        if i == 8 { v = (v & 63) | 128; };
        out.bytes[out.len] = li_byte(hexd, (v >> 4) & 15);
        out.len = out.len + 1;
        out.bytes[out.len] = li_byte(hexd, v & 15);
        out.len = out.len + 1;
        i = i + 1;
    }
}

fn li_opts_json(opts: &InstallLaunchRequest, out: &LiText) -> void {
    out.len = 0;
    let doc = li_parse(STR_PTR("{}"), STR_LEN("{}"));
    if doc == 0 { li_push(out, STR_PTR("{}"), STR_LEN("{}")); return; };
    if opts.hasIds {
        let idoc = li_parse(opts.ids_ptr, opts.ids_len);
        if idoc != 0 {
            sa_json_object_set_node(doc, STR_PTR("ids"), STR_LEN("ids"), idoc);
            li_free_doc(idoc);
        };
    };
    if opts.hasMissingOnly { sa_json_object_set_bool(doc, STR_PTR("missingOnly"), STR_LEN("missingOnly"), opts.missingOnly); };
    if opts.hasSkipCli { sa_json_object_set_bool(doc, STR_PTR("skipCli"), STR_LEN("skipCli"), opts.skipCli); };
    if opts.hasEnvMode {
        if opts.envMode == 0 { sa_json_object_set_string(doc, STR_PTR("envMode"), STR_LEN("envMode"), STR_PTR("shared"), STR_LEN("shared")); };
        if opts.envMode == 1 { sa_json_object_set_string(doc, STR_PTR("envMode"), STR_LEN("envMode"), STR_PTR("separate"), STR_LEN("separate")); };
        if opts.envMode == 2 { sa_json_object_set_string(doc, STR_PTR("envMode"), STR_LEN("envMode"), STR_PTR("none"), STR_LEN("none")); };
    };
    if opts.hasSharedEnv {
        let sub = li_parse(STR_PTR("{}"), STR_LEN("{}"));
        if sub != 0 {
            if opts.sharedEnv.hasBaseUrl { sa_json_object_set_string(sub, STR_PTR("baseUrl"), STR_LEN("baseUrl"), opts.sharedEnv.baseUrl_ptr, opts.sharedEnv.baseUrl_len); };
            if opts.sharedEnv.hasModel { sa_json_object_set_string(sub, STR_PTR("model"), STR_LEN("model"), opts.sharedEnv.model_ptr, opts.sharedEnv.model_len); };
            if opts.sharedEnv.hasApiKey { sa_json_object_set_string(sub, STR_PTR("apiKey"), STR_LEN("apiKey"), opts.sharedEnv.apiKey_ptr, opts.sharedEnv.apiKey_len); };
            sa_json_object_set_node(doc, STR_PTR("sharedEnv"), STR_LEN("sharedEnv"), sub);
            li_free_doc(sub);
        };
    };
    if opts.hasSeparateEnv {
        let sdoc = li_parse(opts.separateEnv_ptr, opts.separateEnv_len);
        if sdoc != 0 {
            sa_json_object_set_node(doc, STR_PTR("separateEnv"), STR_LEN("separateEnv"), sdoc);
            li_free_doc(sdoc);
        };
    };
    if opts.hasForceEnv { sa_json_object_set_bool(doc, STR_PTR("forceEnv"), STR_LEN("forceEnv"), opts.forceEnv); };
    if opts.hasSourceRoot { sa_json_object_set_string(doc, STR_PTR("sourceRoot"), STR_LEN("sourceRoot"), opts.sourceRoot_ptr, opts.sourceRoot_len); };
    if opts.hasSkipModelTest { sa_json_object_set_bool(doc, STR_PTR("skipModelTest"), STR_LEN("skipModelTest"), opts.skipModelTest); };
    li_stringify_into(doc, out);
    li_free_doc(doc);
}

fn li_opts_from_json(json_p: ptr, json_l: u64, arena: &LiText, out: &InstallLaunchRequest) -> void {
    out.hasIds = false;
    out.hasMissingOnly = false;
    out.hasSkipCli = false;
    out.hasEnvMode = false;
    out.hasSharedEnv = false;
    out.hasSeparateEnv = false;
    out.hasForceEnv = false;
    out.hasSourceRoot = false;
    out.hasSkipModelTest = false;
    let doc = li_parse(json_p, json_l);
    if doc == 0 { return; };
    let ids_node = li_get(doc, STR_PTR("ids"), STR_LEN("ids"));
    if ids_node != 0 {
        let t = LiText { bytes: [0u8; 262144], len: 0 };
        li_stringify_into(ids_node, &t);
        li_arena_put(arena, li_text_ptr(&t), t.len, &out.ids_ptr, &out.ids_len);
        let c: u64 = 0;
        sa_json_value_count(ids_node, &c);
        out.idsCount = c;
        out.hasIds = true;
    };
    let bv: bool = false;
    let node = li_get(doc, STR_PTR("missingOnly"), STR_LEN("missingOnly"));
    if node != 0 { if sa_json_as_bool(node, &bv) == 0 { out.missingOnly = bv; out.hasMissingOnly = true; }; };
    node = li_get(doc, STR_PTR("skipCli"), STR_LEN("skipCli"));
    if node != 0 { if sa_json_as_bool(node, &bv) == 0 { out.skipCli = bv; out.hasSkipCli = true; }; };
    let mode_s = LiStr { bytes: [0u8; 8192], len: 0 };
    if li_node_string(doc, STR_PTR("envMode"), STR_LEN("envMode"), &mode_s) {
        out.hasEnvMode = true;
        out.envMode = 2;
        if li_eq(li_str_ptr(&mode_s), mode_s.len, STR_PTR("shared"), STR_LEN("shared")) { out.envMode = 0; };
        if li_eq(li_str_ptr(&mode_s), mode_s.len, STR_PTR("separate"), STR_LEN("separate")) { out.envMode = 1; };
    };
    let shared_node = li_get(doc, STR_PTR("sharedEnv"), STR_LEN("sharedEnv"));
    if shared_node != 0 {
        let t = LiText { bytes: [0u8; 262144], len: 0 };
        li_stringify_into(shared_node, &t);
        li_values_from_json(li_text_ptr(&t), t.len, arena, &out.sharedEnv);
        out.hasSharedEnv = true;
    };
    let sep_node = li_get(doc, STR_PTR("separateEnv"), STR_LEN("separateEnv"));
    if sep_node != 0 {
        let t = LiText { bytes: [0u8; 262144], len: 0 };
        li_stringify_into(sep_node, &t);
        li_arena_put(arena, li_text_ptr(&t), t.len, &out.separateEnv_ptr, &out.separateEnv_len);
        out.hasSeparateEnv = true;
    };
    node = li_get(doc, STR_PTR("forceEnv"), STR_LEN("forceEnv"));
    if node != 0 { if sa_json_as_bool(node, &bv) == 0 { out.forceEnv = bv; out.hasForceEnv = true; }; };
    if li_node_string(doc, STR_PTR("sourceRoot"), STR_LEN("sourceRoot"), &mode_s) {
        li_arena_put(arena, li_str_ptr(&mode_s), mode_s.len, &out.sourceRoot_ptr, &out.sourceRoot_len);
        out.hasSourceRoot = true;
    };
    node = li_get(doc, STR_PTR("skipModelTest"), STR_LEN("skipModelTest"));
    if node != 0 { if sa_json_as_bool(node, &bv) == 0 { out.skipModelTest = bv; out.hasSkipModelTest = true; }; };
    li_free_doc(doc);
}

// R9 driver: runs on the spawned thread; settles the job record.
fn li_job_drive(token: u64) -> i32 {
    let key = LiStr { bytes: [0u8; 8192], len: 0 };
    li_i64_text(token as i64, &key);
    // claim the stash entry
    li_lock_acquire(STR_PTR("launchinstall.jobslock"), STR_LEN("launchinstall.jobslock"));
    let stash = li_stashdoc();
    let entry = li_get(stash, li_str_ptr(&key), key.len);
    let job_id = LiStr { bytes: [0u8; 8192], len: 0 };
    let opts_text = LiText { bytes: [0u8; 262144], len: 0 };
    if entry != 0 {
        li_node_string(entry, STR_PTR("job"), STR_LEN("job"), &job_id);
        li_node_text(entry, STR_PTR("opts"), STR_LEN("opts"), &opts_text);
    };
    li_lock_release(STR_PTR("launchinstall.jobslock"), STR_LEN("launchinstall.jobslock"));
    if job_id.len == 0 { return 0; };
    // sink doc for the run's log lines; mirrored into the job at settle
    // (plus a live mirror via li_job_append_log for progressStep).
    let sink = li_parse(STR_PTR("[]"), STR_LEN("[]"));
    let arena = LiText { bytes: [0u8; 262144], len: 0 };
    let opts = InstallLaunchRequest { ids_ptr: STR_PTR(""), ids_len: 0, idsCount: 0, hasIds: false, missingOnly: false, hasMissingOnly: false, skipCli: false, hasSkipCli: false, envMode: 0, hasEnvMode: false, sharedEnv: LaunchEnvValues { hasBaseUrl: false, baseUrl_ptr: STR_PTR(""), baseUrl_len: 0, hasModel: false, model_ptr: STR_PTR(""), model_len: 0, hasApiKey: false, apiKey_ptr: STR_PTR(""), apiKey_len: 0 }, hasSharedEnv: false, separateEnv_ptr: STR_PTR(""), separateEnv_len: 0, hasSeparateEnv: false, forceEnv: false, hasForceEnv: false, sourceRoot_ptr: STR_PTR(""), sourceRoot_len: 0, hasSourceRoot: false, skipModelTest: false, hasSkipModelTest: false };
    li_opts_from_json(li_text_ptr(&opts_text), opts_text.len, &arena, &opts);
    let state = LaunchInstallState { installLockHeld: false, jobs_ptr: STR_PTR(""), jobs_len: 0, jobsCount: 0 };
    let outcome = InstallLaunchOutcome { results: LiText { bytes: [0u8; 262144], len: 0 }, resultsCount: 0, adapters: LiText { bytes: [0u8; 262144], len: 0 }, adaptersCount: 0 };
    installLaunchAdapters(&state, &opts, sink, &outcome);
    // settle
    li_lock_acquire(STR_PTR("launchinstall.jobslock"), STR_LEN("launchinstall.jobslock"));
    let doc = li_jobsdoc();
    let job = li_get(doc, li_str_ptr(&job_id), job_id.len);
    if job != 0 {
        sa_json_object_set_string(job, STR_PTR("status"), STR_LEN("status"), STR_PTR("completed"), STR_LEN("completed"));
        let results_doc = li_parse(li_text_ptr(&outcome.results), outcome.results.len);
        let okc: u64 = 0;
        if results_doc != 0 {
            let rc: u64 = 0;
            sa_json_value_count(results_doc, &rc);
            let ri: u64 = 0;
            while ri < rc {
                let rit: u64 = 0;
                if sa_json_array_get(results_doc, ri, &rit) == 0 {
                    if rit != 0 {
                        let ok_node = li_get(rit, STR_PTR("ok"), STR_LEN("ok"));
                        let okv: bool = false;
                        if ok_node != 0 { sa_json_as_bool(ok_node, &okv); };
                        if okv { okc = okc + 1; };
                    };
                };
                ri = ri + 1;
            }
            li_free_doc(results_doc);
        };
        let step = LiText { bytes: [0u8; 262144], len: 0 };
        li_push(&step, STR_PTR("Completed "), STR_LEN("Completed "));
        let on = LiStr { bytes: [0u8; 8192], len: 0 };
        li_i64_text(okc as i64, &on);
        li_push(&step, li_str_ptr(&on), on.len);
        li_push(&step, STR_PTR("/"), STR_LEN("/"));
        let tn = LiStr { bytes: [0u8; 8192], len: 0 };
        li_i64_text(outcome.resultsCount as i64, &tn);
        li_push(&step, li_str_ptr(&tn), tn.len);
        li_push(&step, STR_PTR(" adapters."), STR_LEN(" adapters."));
        sa_json_object_set_string(job, STR_PTR("progressStep"), STR_LEN("progressStep"), li_text_ptr(&step), step.len);
        sa_json_object_set_string(job, STR_PTR("resultsText"), STR_LEN("resultsText"), li_text_ptr(&outcome.results), outcome.results.len);
        sa_json_object_set_string(job, STR_PTR("adaptersText"), STR_LEN("adaptersText"), li_text_ptr(&outcome.adapters), outcome.adapters.len);
        // merge the sink logs into logsText (job started empty)
        let sink_text = LiText { bytes: [0u8; 262144], len: 0 };
        li_stringify_into(sink, &sink_text);
        sa_json_object_set_string(job, STR_PTR("logsText"), STR_LEN("logsText"), li_text_ptr(&sink_text), sink_text.len);
    };
    li_lock_release(STR_PTR("launchinstall.jobslock"), STR_LEN("launchinstall.jobslock"));
    li_free_doc(sink);
    return 0;
}

fn createInstallJob(state: &LaunchInstallState, opts: &InstallLaunchRequest, outId: &LiStr) -> void {
    outId.len = 0;
    let job_id = LiStr { bytes: [0u8; 8192], len: 0 };
    li_uuid(&job_id);
    li_push_str(outId, li_str_ptr(&job_id), job_id.len);
    let opts_text = LiText { bytes: [0u8; 262144], len: 0 };
    li_opts_json(opts, &opts_text);
    li_lock_acquire(STR_PTR("launchinstall.jobslock"), STR_LEN("launchinstall.jobslock"));
    let doc = li_jobsdoc();
    let rec = li_parse(STR_PTR("{}"), STR_LEN("{}"));
    if rec != 0 {
        sa_json_object_set_string(rec, STR_PTR("id"), STR_LEN("id"), li_str_ptr(&job_id), job_id.len);
        sa_json_object_set_string(rec, STR_PTR("status"), STR_LEN("status"), STR_PTR("running"), STR_LEN("running"));
        sa_json_object_set_string(rec, STR_PTR("progressStep"), STR_LEN("progressStep"), STR_PTR("Starting installation job..."), STR_LEN("Starting installation job..."));
        sa_json_object_set_string(rec, STR_PTR("logsText"), STR_LEN("logsText"), STR_PTR("[]"), STR_LEN("[]"));
        sa_json_object_set_i64(rec, STR_PTR("createdAt"), STR_LEN("createdAt"), sa_time_unix_ms());
        sa_json_object_set_node(doc, li_str_ptr(&job_id), job_id.len, rec);
        li_free_doc(rec);
    };
    // stash {job, opts} under a fresh token for the driver thread
    let token = li_cell_get(STR_PTR("launchinstall.jobctr"), STR_LEN("launchinstall.jobctr")) + 1;
    li_cell_set(STR_PTR("launchinstall.jobctr"), STR_LEN("launchinstall.jobctr"), token);
    let stash = li_stashdoc();
    let sentry = li_parse(STR_PTR("{}"), STR_LEN("{}"));
    if sentry != 0 {
        sa_json_object_set_string(sentry, STR_PTR("job"), STR_LEN("job"), li_str_ptr(&job_id), job_id.len);
        sa_json_object_set_string(sentry, STR_PTR("opts"), STR_LEN("opts"), li_text_ptr(&opts_text), opts_text.len);
        let key = LiStr { bytes: [0u8; 8192], len: 0 };
        li_i64_text(token as i64, &key);
        sa_json_object_set_node(stash, li_str_ptr(&key), key.len, sentry);
        li_free_doc(sentry);
    };
    state.jobsCount = state.jobsCount + 1;
    li_lock_release(STR_PTR("launchinstall.jobslock"), STR_LEN("launchinstall.jobslock"));
    // R9 fire-and-forget (TS: the async IIFE inside createInstallJob)
    let handle = thread::spawn(^|| li_job_drive(token));
}

fn getInstallJob(state: &LaunchInstallState, jobId_ptr: ptr, jobId_len: u64, arena: &LiText, out: &InstallJob) -> bool {
    li_lock_acquire(STR_PTR("launchinstall.jobslock"), STR_LEN("launchinstall.jobslock"));
    let doc = li_jobsdoc();
    let job = li_get(doc, jobId_ptr, jobId_len);
    if job == 0 {
        li_lock_release(STR_PTR("launchinstall.jobslock"), STR_LEN("launchinstall.jobslock"));
        return false;
    };
    li_arena_put(arena, jobId_ptr, jobId_len, &out.id_ptr, &out.id_len);
    let status_s = LiStr { bytes: [0u8; 8192], len: 0 };
    li_node_string(job, STR_PTR("status"), STR_LEN("status"), &status_s);
    out.status = 0;
    if li_eq(li_str_ptr(&status_s), status_s.len, STR_PTR("completed"), STR_LEN("completed")) { out.status = 1; };
    if li_eq(li_str_ptr(&status_s), status_s.len, STR_PTR("failed"), STR_LEN("failed")) { out.status = 2; };
    let step = LiStr { bytes: [0u8; 8192], len: 0 };
    if li_node_string(job, STR_PTR("progressStep"), STR_LEN("progressStep"), &step) {
        li_arena_put(arena, li_str_ptr(&step), step.len, &out.progressStep_ptr, &out.progressStep_len);
    };
    let logs = LiStr { bytes: [0u8; 8192], len: 0 };
    let logs_text = LiText { bytes: [0u8; 262144], len: 0 };
    if li_node_text(job, STR_PTR("logsText"), STR_LEN("logsText"), &logs_text) {
        li_arena_put(arena, li_text_ptr(&logs_text), logs_text.len, &out.logs_ptr, &out.logs_len);
        let ldoc = li_parse(li_text_ptr(&logs_text), logs_text.len);
        if ldoc != 0 {
            let c: u64 = 0;
            sa_json_value_count(ldoc, &c);
            out.logsCount = c;
            li_free_doc(ldoc);
        };
    };
    out.hasResults = false;
    let rt = LiText { bytes: [0u8; 262144], len: 0 };
    if li_node_text(job, STR_PTR("resultsText"), STR_LEN("resultsText"), &rt) {
        li_arena_put(arena, li_text_ptr(&rt), rt.len, &out.results_ptr, &out.results_len);
        let rdoc = li_parse(li_text_ptr(&rt), rt.len);
        if rdoc != 0 {
            let c: u64 = 0;
            sa_json_value_count(rdoc, &c);
            out.resultsCount = c;
            li_free_doc(rdoc);
        };
        out.hasResults = true;
    };
    out.hasAdapters = false;
    let at = LiText { bytes: [0u8; 262144], len: 0 };
    if li_node_text(job, STR_PTR("adaptersText"), STR_LEN("adaptersText"), &at) {
        li_arena_put(arena, li_text_ptr(&at), at.len, &out.adapters_ptr, &out.adapters_len);
        let adoc = li_parse(li_text_ptr(&at), at.len);
        if adoc != 0 {
            let arr = li_get(adoc, STR_PTR("adapters"), STR_LEN("adapters"));
            if arr != 0 {
                let c: u64 = 0;
                sa_json_value_count(arr, &c);
                out.adaptersCount = c;
            };
            li_free_doc(adoc);
        };
        out.hasAdapters = true;
    };
    out.hasError = false;
    let es = LiStr { bytes: [0u8; 8192], len: 0 };
    if li_node_string(job, STR_PTR("error"), STR_LEN("error"), &es) {
        li_arena_put(arena, li_str_ptr(&es), es.len, &out.error_ptr, &out.error_len);
        out.hasError = true;
    };
    let cnode = li_get(job, STR_PTR("createdAt"), STR_LEN("createdAt"));
    if cnode != 0 {
        let cv: i64 = 0;
        if sa_json_as_i64(cnode, &cv) == 0 { out.createdAt = cv as u64; };
    };
    li_lock_release(STR_PTR("launchinstall.jobslock"), STR_LEN("launchinstall.jobslock"));
    return true;
}
