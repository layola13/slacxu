// launchInstall.sla — full-body retranslation of launchInstall.ts
// (1037 lines, CXU plugins @ f2cb649d), launch/install family 8/8
// (Agent AD3 rebuild, step 5). Launch-adapter install/detect/env
// management: LAUNCH_SPECS table, PATH discovery, .env parse/upsert,
// git clone + install.sh execution, OpenAI API probe, install jobs.
//
// Async model (ASYNC_MODEL.md):
// - installLaunchAdapters / installOne / runCmd / ensureCloned /
//   runInstallSh / testOpenAiApi / validateEnvModeBeforeSave are async
//   in TS, but every await is on a process or HTTP completion -> R8
//   contract-layer blocking degeneration: synchronous bodies over the
//   blocking std process runner (defect-#1 workaround: run + try_wait
//   poll + drain, never exec_capture) and the blocking HTTP v2 client.
// - installLock (TS: `let installLock: Promise<void> | null`, spin
//   `while (installLock) await installLock`, set before the try,
//   released in finally) -> R11 explicit cell state: sa_global cell
//   "launchinstall.lock" holds 0 (free) / 1 (held); contenders poll
//   with sa_time_sleep_ms(10). NO constant-ok stub: the state is real
//   shared state, observable via installLockHeldNow().
// - createInstallJob (sync fn) launches the TS fire-and-forget async
//   IIFE -> R9: a sa_thread spawn drives installLaunchAdapters and
//   settles the job record. Job records live in ONE JSON doc whose
//   handle is kept in sa_global cell "launchinstall.jobsdoc",
//   serialized by cell "launchinstall.jobslock" (same R11 pattern).
//   getInstallJob reads the record back out of that doc.
//
// Representation choices (registered deviations from the bulk skeleton):
// - The skeleton's (out_ptr: &ptr, out_len: &u64) string outs point at
//   storage the callee cannot own; string results are returned through
//   &LiText / &LiStr out params instead (same precedent as the FMA/BU/FA
//   retranslations). Struct definitions and fn names follow the
//   skeleton; InstallLaunchResultItem.steps and job logs are JSON texts.
// - spawnRuntimeProcess (runtime/process.js) is backed directly by
//   sa_std_process_* (the runtime wrapper's POSIX shape); win32-only
//   branches of the TS (platform checks, E:/D:/ candidates) are
//   platform seams — the POSIX path is implemented.
// - toolchainDirCandidates (cliVersions.sla) is consumed defensively:
//   its JSON dir array is merged into pathDirs only when it parses.
// - InstallJob.time uses a HH:MM:SS clock text (TS toLocaleTimeString
//   is locale-shaped; the shape is preserved, the locale is not).
// - testOpenAiApi timeouts: the HTTP client call carries the 6 s /
//   10 s budgets; a transport failure after the budget reads as the
//   TS timeout message (AbortError discrimination approximated by
//   elapsed time >= budget).
@import "sa_std/io/print.sai"
@import "sa_std/fs.sai"
@import "sa_std/env.sai"
@import "sa_std/process.sai"
@import "sa_std/process.sa"
@import "sa_std/http_client.sai"
@import "sa_std/encoding/json.sai"
@import "sa_std/globals.sai"
@import "sa_std/time.sai"
@import "sa_std/string.sa"
@import "sa_std/ptr.sa"
@import "cliVersions.sla"

// ---------------------------------------------------------------------------
// Text helpers (family pattern).
// ---------------------------------------------------------------------------

struct LiText {
    bytes: [u8; 262144], len: u64
}

struct LiStr {
    bytes: [u8; 8192], len: u64
}

fn li_text_ptr(s: &LiText) -> ptr {
    let p: ptr = PTR_NULL();
    PTR_BYTE_ADD(p, &s.bytes, 0);
    return p;
}

fn li_str_ptr(s: &LiStr) -> ptr {
    let p: ptr = PTR_NULL();
    PTR_BYTE_ADD(p, &s.bytes, 0);
    return p;
}

fn li_byte(p: ptr, i: u64) -> u8 {
    let b: u8 = 0;
    PTR_BYTE_AT(b, p, i);
    return b;
}

fn li_push(s: &LiText, p: ptr, n: u64) -> void {
    let i: u64 = 0;
    while i < n {
        if s.len < 262144 { s.bytes[s.len] = li_byte(p, i); s.len = s.len + 1; };
        i = i + 1;
    }
}

fn li_push_str(s: &LiStr, p: ptr, n: u64) -> void {
    let i: u64 = 0;
    while i < n {
        if s.len < 8192 { s.bytes[s.len] = li_byte(p, i); s.len = s.len + 1; };
        i = i + 1;
    }
}

fn li_eq(p: ptr, n: u64, q: ptr, qn: u64) -> bool {
    if n != qn { return false; };
    let i: u64 = 0;
    while i < n {
        if li_byte(p, i) != li_byte(q, i) { return false; };
        i = i + 1;
    }
    return true;
}

fn li_contains(p: ptr, n: u64, q: ptr, qn: u64) -> bool {
    if qn == 0 { return true; };
    if n < qn { return false; };
    let i: u64 = 0;
    while i + qn <= n {
        let sub: ptr = PTR_NULL();
        PTR_BYTE_ADD(sub, p, i);
        if li_eq(sub, qn, q, qn) { return true; };
        i = i + 1;
    }
    return false;
}

fn li_lower(b: u8) -> u8 {
    if b >= 65 && b <= 90 { return b + 32; };
    return b;
}

fn li_trim_range(p: ptr, n: u64, out_s: &u64, out_e: &u64) -> void {
    let s: u64 = 0;
    let e: u64 = n;
    while s < e {
        let b = li_byte(p, s);
        if b == 32 || b == 9 || b == 10 || b == 13 { s = s + 1; } else { break; };
    }
    while e > s {
        let b = li_byte(p, e - 1);
        if b == 32 || b == 9 || b == 10 || b == 13 { e = e - 1; } else { break; };
    }
    *out_s = s;
    *out_e = e;
}

fn li_trimmed(p: ptr, n: u64, out: &LiStr) -> void {
    out.len = 0;
    let s: u64 = 0;
    let e: u64 = 0;
    li_trim_range(p, n, &s, &e);
    if e > s {
        let sp: ptr = PTR_NULL();
        PTR_BYTE_ADD(sp, p, s);
        li_push_str(out, sp, e - s);
    };
}

fn li_join2(a_p: ptr, a_l: u64, b_p: ptr, b_l: u64, out: &LiStr) -> void {
    out.len = 0;
    li_push_str(out, a_p, a_l);
    if a_l > 0 && li_byte(a_p, a_l - 1) != 47 { li_push_str(out, STR_PTR("/"), STR_LEN("/")); };
    li_push_str(out, b_p, b_l);
}

fn li_join3(a_p: ptr, a_l: u64, b_p: ptr, b_l: u64, c_p: ptr, c_l: u64, out: &LiStr) -> void {
    let mid = LiStr { bytes: [0u8; 8192], len: 0 };
    li_join2(a_p, a_l, b_p, b_l, &mid);
    li_join2(li_str_ptr(&mid), mid.len, c_p, c_l, out);
}

// Guard-return free helpers (PhiStateConflict family: unconditional calls).
fn li_free_doc(doc: u64) -> void {
    if doc == 0 { return; };
    sa_json_free(doc);
}

fn li_free_env_buffer(h: u64) -> void {
    if h == 0 { return; };
    sa_env_buffer_free(h);
}

fn li_free_buffer(h: u64) -> void {
    if h == 0 { return; };
    sa_json_buffer_free(h);
}

fn li_parse(p: ptr, n: u64) -> u64 {
    if n == 0 { return 0; };
    return sa_json_parse(p, n);
}

fn li_get(parent: u64, key_p: ptr, key_l: u64) -> u64 {
    if parent == 0 { return 0; };
    let v: u64 = 0;
    if sa_json_object_get(parent, key_p, key_l, &v) != 0 { return 0; };
    return v;
}

fn li_stringify_into(doc: u64, out: &LiText) -> bool {
    out.len = 0;
    if doc == 0 { return false; };
    let h: u64 = 0;
    if sa_json_stringify(doc, &h) != 0 || h == 0 { return false; };
    let dp: ptr = sa_json_buffer_data(h);
    li_push(out, dp, sa_json_buffer_len(h));
    li_free_buffer(h);
    return true;
}

fn li_node_string(doc: u64, key_p: ptr, key_l: u64, out: &LiStr) -> bool {
    out.len = 0;
    let node = li_get(doc, key_p, key_l);
    if node == 0 { return false; };
    if sa_json_kind(node) != 5 { return false; };
    let np: ptr = sa_json_string_ptr(node);
    li_push_str(out, np, sa_json_string_len(node));
    return true;
}

fn li_node_text(doc: u64, key_p: ptr, key_l: u64, out: &LiText) -> bool {
    out.len = 0;
    let node = li_get(doc, key_p, key_l);
    if node == 0 { return false; };
    if sa_json_kind(node) != 5 { return false; };
    let np: ptr = sa_json_string_ptr(node);
    li_push(out, np, sa_json_string_len(node));
    return true;
}

fn li_env_read(name_p: ptr, name_l: u64, out: &LiStr) -> bool {
    out.len = 0;
    let h: u64 = sa_env_get(name_p, name_l);
    if h == 0 { return false; };
    let bp: ptr = sa_env_buffer_data(h);
    li_push_str(out, bp, sa_env_buffer_len(h));
    sa_env_buffer_free(h);
    return out.len > 0;
}

fn li_exists(p: ptr, n: u64) -> bool {
    return sa_std_fs_exists(p, n) == 0;
}

fn li_read_file(p: ptr, n: u64, out: &LiText) -> bool {
    out.len = 0;
    let h: u64 = sa_fs_read_file(p, n, 4194304);
    if h == 0 { return false; };
    let dp: ptr = sa_fs_read_buffer_data(h);
    li_push(out, dp, sa_fs_read_buffer_len(h));
    sa_fs_read_buffer_free(h);
    return true;
}

// ---------------------------------------------------------------------------
// Skeleton struct surface (kept from the bulk pass).
// ---------------------------------------------------------------------------

struct LaunchAdapterSpec {
    id_ptr: ptr, id_len: u64,
    repo_ptr: ptr, repo_len: u64,
    hasCloneUrl: bool, cloneUrl_ptr: ptr, cloneUrl_len: u64,
    wrapperBins_ptr: ptr, wrapperBins_len: u64,
    wrapperBinsCount: u64,
    productBins_ptr: ptr, productBins_len: u64,
    productBinsCount: u64,
    envPrefix_ptr: ptr, envPrefix_len: u64,
    configDirName_ptr: ptr, configDirName_len: u64,
}

struct LaunchAdapterStatus {
    id_ptr: ptr, id_len: u64,
    repo_ptr: ptr, repo_len: u64,
    hasCloneUrl: bool, cloneUrl_ptr: ptr, cloneUrl_len: u64,
    cloneable: bool,
    installed: bool,
    hasWrapperPath: bool, wrapperPath_ptr: ptr, wrapperPath_len: u64,
    hasProductCliPath: bool, productCliPath_ptr: ptr, productCliPath_len: u64,
    productCliPresent: bool,
    hasSourceDir: bool, sourceDir_ptr: ptr, sourceDir_len: u64,
    sourcePresent: bool,
    envPath_ptr: ptr, envPath_len: u64,
    envPresent: bool,
    envConfigured: bool,
    envPreviewBaseUrl_ptr: ptr, envPreviewBaseUrl_len: u64, hasEnvPreviewBaseUrl: bool,
    envPreviewModel_ptr: ptr, envPreviewModel_len: u64, hasEnvPreviewModel: bool,
    envPreviewHasApiKey: bool,
    needsInstall: bool,
    needsSetup: bool,
}

struct LaunchEnvValues {
    hasBaseUrl: bool, baseUrl_ptr: ptr, baseUrl_len: u64,
    hasModel: bool, model_ptr: ptr, model_len: u64,
    hasApiKey: bool, apiKey_ptr: ptr, apiKey_len: u64,
}

struct InstallLaunchRequest {
    ids_ptr: ptr, ids_len: u64, idsCount: u64, hasIds: bool,
    missingOnly: bool, hasMissingOnly: bool,
    skipCli: bool, hasSkipCli: bool,
    envMode: u64, hasEnvMode: bool,
    sharedEnv: LaunchEnvValues, hasSharedEnv: bool,
    separateEnv_ptr: ptr, separateEnv_len: u64, hasSeparateEnv: bool,
    forceEnv: bool, hasForceEnv: bool,
    sourceRoot_ptr: ptr, sourceRoot_len: u64, hasSourceRoot: bool,
    skipModelTest: bool, hasSkipModelTest: bool,
}

struct InstallLaunchResultItem {
    id_ptr: ptr, id_len: u64,
    ok: bool,
    steps_ptr: ptr, steps_len: u64, stepsCount: u64,
    hasError: bool, error_ptr: ptr, error_len: u64,
    hasStatus: bool, status: LaunchAdapterStatus,
}

struct LaunchInstallState {
    installLockHeld: bool,
    jobs_ptr: ptr, jobs_len: u64,
    jobsCount: u64,
}

fn li_spec_fill(out: &LaunchAdapterSpec, id_p: ptr, id_l: u64, repo_p: ptr, repo_l: u64, has_clone: bool, clone_p: ptr, clone_l: u64, wrap_p: ptr, wrap_l: u64, wrap_n: u64, prod_p: ptr, prod_l: u64, prod_n: u64, prefix_p: ptr, prefix_l: u64, dir_p: ptr, dir_l: u64) -> void {
    out.id_ptr = id_p;
    out.id_len = id_l;
    out.repo_ptr = repo_p;
    out.repo_len = repo_l;
    out.hasCloneUrl = has_clone;
    out.cloneUrl_ptr = clone_p;
    out.cloneUrl_len = clone_l;
    out.wrapperBins_ptr = wrap_p;
    out.wrapperBins_len = wrap_l;
    out.wrapperBinsCount = wrap_n;
    out.productBins_ptr = prod_p;
    out.productBins_len = prod_l;
    out.productBinsCount = prod_n;
    out.envPrefix_ptr = prefix_p;
    out.envPrefix_len = prefix_l;
    out.configDirName_ptr = dir_p;
    out.configDirName_len = dir_l;
}

// LAUNCH_SPECS (TS L26-128): 11 entries, order preserved 1:1.
fn launchSpecsCount() -> u64 { return 11; }

fn launchSpecAt(index: u64, out: &LaunchAdapterSpec) -> bool {
    if index == 0 { li_spec_fill(out, STR_PTR("code-launch"), STR_LEN("code-launch"), STR_PTR("code-launch"), STR_LEN("code-launch"), true, STR_PTR("https://github.com/layola13/code-launch.git"), STR_LEN("https://github.com/layola13/code-launch.git"), STR_PTR("[\"code-launch\"]"), STR_LEN("[\"code-launch\"]"), 1, STR_PTR("[\"codex\"]"), STR_LEN("[\"codex\"]"), 1, STR_PTR("CODE_LAUNCH_"), STR_LEN("CODE_LAUNCH_"), STR_PTR("code-launch"), STR_LEN("code-launch")); return true; };
    if index == 1 { li_spec_fill(out, STR_PTR("agy-launch"), STR_LEN("agy-launch"), STR_PTR("agy-launch"), STR_LEN("agy-launch"), true, STR_PTR("https://github.com/layola13/agy-launch.git"), STR_LEN("https://github.com/layola13/agy-launch.git"), STR_PTR("[\"agy-launch\"]"), STR_LEN("[\"agy-launch\"]"), 1, STR_PTR("[\"agy\"]"), STR_LEN("[\"agy\"]"), 1, STR_PTR("AGY_LAUNCH_"), STR_LEN("AGY_LAUNCH_"), STR_PTR("agy-launch"), STR_LEN("agy-launch")); return true; };
    if index == 2 { li_spec_fill(out, STR_PTR("claude-launch"), STR_LEN("claude-launch"), STR_PTR("claude-launch"), STR_LEN("claude-launch"), true, STR_PTR("https://github.com/layola13/claude-launch.git"), STR_LEN("https://github.com/layola13/claude-launch.git"), STR_PTR("[\"claude-launch\"]"), STR_LEN("[\"claude-launch\"]"), 1, STR_PTR("[\"claude\",\"claudecode\"]"), STR_LEN("[\"claude\",\"claudecode\"]"), 2, STR_PTR("CLAUDE_LAUNCH_"), STR_LEN("CLAUDE_LAUNCH_"), STR_PTR("claude-launch"), STR_LEN("claude-launch")); return true; };
    if index == 3 { li_spec_fill(out, STR_PTR("gemini-launch"), STR_LEN("gemini-launch"), STR_PTR("gemini-launch"), STR_LEN("gemini-launch"), true, STR_PTR("https://github.com/layola13/gemini-launch.git"), STR_LEN("https://github.com/layola13/gemini-launch.git"), STR_PTR("[\"gemini-launch\"]"), STR_LEN("[\"gemini-launch\"]"), 1, STR_PTR("[\"gemini\"]"), STR_LEN("[\"gemini\"]"), 1, STR_PTR("GEMINI_LAUNCH_"), STR_LEN("GEMINI_LAUNCH_"), STR_PTR("gemini-launch"), STR_LEN("gemini-launch")); return true; };
    if index == 4 { li_spec_fill(out, STR_PTR("crush-launch"), STR_LEN("crush-launch"), STR_PTR("crush-launch"), STR_LEN("crush-launch"), true, STR_PTR("https://github.com/layola13/crush-launch.git"), STR_LEN("https://github.com/layola13/crush-launch.git"), STR_PTR("[\"crush-launch\"]"), STR_LEN("[\"crush-launch\"]"), 1, STR_PTR("[\"crush\"]"), STR_LEN("[\"crush\"]"), 1, STR_PTR("CRUSH_LAUNCH_"), STR_LEN("CRUSH_LAUNCH_"), STR_PTR("crush-launch"), STR_LEN("crush-launch")); return true; };
    if index == 5 { li_spec_fill(out, STR_PTR("auggie-launch"), STR_LEN("auggie-launch"), STR_PTR("auggie-launch"), STR_LEN("auggie-launch"), true, STR_PTR("https://github.com/layola13/auggie-launch.git"), STR_LEN("https://github.com/layola13/auggie-launch.git"), STR_PTR("[\"auggie-launch\"]"), STR_LEN("[\"auggie-launch\"]"), 1, STR_PTR("[\"auggie\"]"), STR_LEN("[\"auggie\"]"), 1, STR_PTR("AUGGIE_LAUNCH_"), STR_LEN("AUGGIE_LAUNCH_"), STR_PTR("auggie-launch"), STR_LEN("auggie-launch")); return true; };
    if index == 6 { li_spec_fill(out, STR_PTR("grok-launch"), STR_LEN("grok-launch"), STR_PTR("grok-launch"), STR_LEN("grok-launch"), true, STR_PTR("https://github.com/layola13/grok-launch.git"), STR_LEN("https://github.com/layola13/grok-launch.git"), STR_PTR("[\"grok-launch\"]"), STR_LEN("[\"grok-launch\"]"), 1, STR_PTR("[\"grok\",\"agent\"]"), STR_LEN("[\"grok\",\"agent\"]"), 2, STR_PTR("GROK_LAUNCH_"), STR_LEN("GROK_LAUNCH_"), STR_PTR("grok-launch"), STR_LEN("grok-launch")); return true; };
    if index == 7 { li_spec_fill(out, STR_PTR("agent-launch"), STR_LEN("agent-launch"), STR_PTR("agent-launch"), STR_LEN("agent-launch"), false, STR_PTR(""), STR_LEN(""), STR_PTR("[\"agent-launch\",\"grok-launch\"]"), STR_LEN("[\"agent-launch\",\"grok-launch\"]"), 2, STR_PTR("[\"agent\",\"grok\"]"), STR_LEN("[\"agent\",\"grok\"]"), 2, STR_PTR("GROK_LAUNCH_"), STR_LEN("GROK_LAUNCH_"), STR_PTR("grok-launch"), STR_LEN("grok-launch")); return true; };
    if index == 8 { li_spec_fill(out, STR_PTR("coderabbit-launch"), STR_LEN("coderabbit-launch"), STR_PTR("coderabbit-launch"), STR_LEN("coderabbit-launch"), false, STR_PTR(""), STR_LEN(""), STR_PTR("[\"coderabbit-launch\",\"cr-launch\"]"), STR_LEN("[\"coderabbit-launch\",\"cr-launch\"]"), 2, STR_PTR("[\"coderabbit\",\"cr\"]"), STR_LEN("[\"coderabbit\",\"cr\"]"), 2, STR_PTR("CODERABBIT_LAUNCH_"), STR_LEN("CODERABBIT_LAUNCH_"), STR_PTR("coderabbit-launch"), STR_LEN("coderabbit-launch")); return true; };
    if index == 9 { li_spec_fill(out, STR_PTR("freebuff-launch"), STR_LEN("freebuff-launch"), STR_PTR("freebuff-launch"), STR_LEN("freebuff-launch"), false, STR_PTR(""), STR_LEN(""), STR_PTR("[\"freebuff-launch\"]"), STR_LEN("[\"freebuff-launch\"]"), 1, STR_PTR("[\"freebuff\"]"), STR_LEN("[\"freebuff\"]"), 1, STR_PTR("FREEBUFF_LAUNCH_"), STR_LEN("FREEBUFF_LAUNCH_"), STR_PTR("freebuff-launch"), STR_LEN("freebuff-launch")); return true; };
    if index == 10 { li_spec_fill(out, STR_PTR("pi-launch"), STR_LEN("pi-launch"), STR_PTR("pi"), STR_LEN("pi"), false, STR_PTR(""), STR_LEN(""), STR_PTR("[\"pi\",\"pi-launch\"]"), STR_LEN("[\"pi\",\"pi-launch\"]"), 2, STR_PTR("[\"pi\"]"), STR_LEN("[\"pi\"]"), 1, STR_PTR("PI_LAUNCH_"), STR_LEN("PI_LAUNCH_"), STR_PTR("pi-launch"), STR_LEN("pi-launch")); return true; };
    return false;
}

fn getSpec(id_ptr: ptr, id_len: u64, out: &LaunchAdapterSpec) -> bool {
    let i: u64 = 0;
    while i < 11 {
        if launchSpecAt(i, out) {
            if li_eq(out.id_ptr, out.id_len, id_ptr, id_len) { return true; };
        };
        i = i + 1;
    }
    return false;
}

// ---------------------------------------------------------------------------
// home / source root / PATH discovery (TS L182-257).
// ---------------------------------------------------------------------------

fn home(out: &LiStr) -> void {
    out.len = 0;
    if li_env_read(STR_PTR("HOME"), STR_LEN("HOME"), out) { return; };
    if li_env_read(STR_PTR("USERPROFILE"), STR_LEN("USERPROFILE"), out) { return; };
    let h: u64 = sa_env_home_dir();
    if h != 0 {
        let bp: ptr = sa_env_buffer_data(h);
        li_push_str(out, bp, sa_env_buffer_len(h));
    };
    li_free_env_buffer(h);
}

fn defaultSourceRoot(custom_ptr: ptr, custom_len: u64, hasCustom: bool, out: &LiStr) -> void {
    out.len = 0;
    if hasCustom {
        let t = LiStr { bytes: [0u8; 8192], len: 0 };
        li_trimmed(custom_ptr, custom_len, &t);
        if t.len > 0 {
            if t.len > 2 && li_byte(li_str_ptr(&t), 0) == 126 && li_byte(li_str_ptr(&t), 1) == 47 {
                let hm = LiStr { bytes: [0u8; 8192], len: 0 };
                home(&hm);
                let rest: ptr = PTR_NULL();
                PTR_BYTE_ADD(rest, li_str_ptr(&t), 2);
                li_join2(li_str_ptr(&hm), hm.len, rest, t.len - 2, out);
                return;
            };
            if li_byte(li_str_ptr(&t), 0) == 47 {
                li_push_str(out, li_str_ptr(&t), t.len);
                return;
            };
            let cwd = LiStr { bytes: [0u8; 8192], len: 0 };
            let ch: u64 = sa_env_current_dir();
            if ch != 0 {
                let bp: ptr = sa_env_buffer_data(ch);
                li_push_str(&cwd, bp, sa_env_buffer_len(ch));
            };
            li_free_env_buffer(ch);
            li_join2(li_str_ptr(&cwd), cwd.len, li_str_ptr(&t), t.len, out);
            return;
        };
    };
    if li_env_read(STR_PTR("CODEX_UI_LAUNCH_SRC_ROOT"), STR_LEN("CODEX_UI_LAUNCH_SRC_ROOT"), out) { return; };
    let hm = LiStr { bytes: [0u8; 8192], len: 0 };
    home(&hm);
    li_join2(li_str_ptr(&hm), hm.len, STR_PTR("projects"), STR_LEN("projects"), out);
}

// Append dir to the JSON array text under construction when not present.
fn li_dirs_push_unique(arr: &LiText, count: &u64, dir_p: ptr, dir_l: u64) -> void {
    let doc = li_parse(li_text_ptr(arr), arr.len);
    if doc != 0 {
        let cnt: u64 = 0;
        sa_json_value_count(doc, &cnt);
        let i: u64 = 0;
        let dup = false;
        while i < cnt {
            let item: u64 = 0;
            if sa_json_array_get(doc, i, &item) == 0 {
                if item != 0 && sa_json_kind(item) == 5 {
                    let ip: ptr = sa_json_string_ptr(item);
                    if li_eq(ip, sa_json_string_len(item), dir_p, dir_l) { dup = true; };
                };
            };
            i = i + 1;
        }
        li_free_doc(doc);
        if dup { return; };
    };
    let doc2 = li_parse(li_text_ptr(arr), arr.len);
    if doc2 == 0 { return; };
    sa_json_array_push_string(doc2, dir_p, dir_l);
    let c_now = *count;
    *count = c_now + 1;
    li_stringify_into(doc2, arr);
    li_free_doc(doc2);
}

fn pathDirs(out: &LiText, outCount: &u64) -> void {
    out.len = 0;
    li_push(out, STR_PTR("[]"), STR_LEN("[]"));
    *outCount = 0;
    let hm = LiStr { bytes: [0u8; 8192], len: 0 };
    home(&hm);
    let hp: ptr = li_str_ptr(&hm);
    let d = LiStr { bytes: [0u8; 8192], len: 0 };
    li_join2(hp, hm.len, STR_PTR(".local/bin"), STR_LEN(".local/bin"), &d);
    li_dirs_push_unique(out, outCount, li_str_ptr(&d), d.len);
    li_join2(hp, hm.len, STR_PTR("bin"), STR_LEN("bin"), &d);
    li_dirs_push_unique(out, outCount, li_str_ptr(&d), d.len);
    li_join2(hp, hm.len, STR_PTR(".codex/bin"), STR_LEN(".codex/bin"), &d);
    li_dirs_push_unique(out, outCount, li_str_ptr(&d), d.len);
    li_join2(hp, hm.len, STR_PTR(".claude/bin"), STR_LEN(".claude/bin"), &d);
    li_dirs_push_unique(out, outCount, li_str_ptr(&d), d.len);
    li_join2(hp, hm.len, STR_PTR(".grok/bin"), STR_LEN(".grok/bin"), &d);
    li_dirs_push_unique(out, outCount, li_str_ptr(&d), d.len);
    li_join2(hp, hm.len, STR_PTR(".agy/bin"), STR_LEN(".agy/bin"), &d);
    li_dirs_push_unique(out, outCount, li_str_ptr(&d), d.len);
    li_join2(hp, hm.len, STR_PTR(".pi/bin"), STR_LEN(".pi/bin"), &d);
    li_dirs_push_unique(out, outCount, li_str_ptr(&d), d.len);
    li_join2(hp, hm.len, STR_PTR(".opencode/bin"), STR_LEN(".opencode/bin"), &d);
    li_dirs_push_unique(out, outCount, li_str_ptr(&d), d.len);
    li_join2(hp, hm.len, STR_PTR(".codex-ultra/bin"), STR_LEN(".codex-ultra/bin"), &d);
    li_dirs_push_unique(out, outCount, li_str_ptr(&d), d.len);
    li_join2(hp, hm.len, STR_PTR(".bun/bin"), STR_LEN(".bun/bin"), &d);
    li_dirs_push_unique(out, outCount, li_str_ptr(&d), d.len);
    li_join3(hp, hm.len, STR_PTR(".bun/install"), STR_LEN(".bun/install"), STR_PTR("global/bin"), STR_LEN("global/bin"), &d);
    li_dirs_push_unique(out, outCount, li_str_ptr(&d), d.len);
    li_join2(hp, hm.len, STR_PTR(".npm-global/bin"), STR_LEN(".npm-global/bin"), &d);
    li_dirs_push_unique(out, outCount, li_str_ptr(&d), d.len);
    // toolchainDirCandidates(homeDir, env) — defensive consumption.
    let scratch = LiText { bytes: [0u8; 262144], len: 0 };
    let env_json = LiText { bytes: [0u8; 262144], len: 0 };
    let ev: u64 = sa_env_vars_json();
    if ev != 0 {
        let bp: ptr = sa_env_buffer_data(ev);
        li_push(&env_json, bp, sa_env_buffer_len(ev));
    };
    li_free_env_buffer(ev);
    let tn = toolchainDirCandidates(hp, hm.len, hm.len > 0, li_text_ptr(&env_json), env_json.len, li_text_ptr(&scratch));
    let tdoc: u64 = 0;
    if tn > 0 && tn <= 262144 {
        scratch.len = tn;
        tdoc = li_parse(li_text_ptr(&scratch), scratch.len);
        if tdoc != 0 {
            let cnt: u64 = 0;
            sa_json_value_count(tdoc, &cnt);
            let i: u64 = 0;
            while i < cnt {
                let item: u64 = 0;
                if sa_json_array_get(tdoc, i, &item) == 0 {
                    if item != 0 && sa_json_kind(item) == 5 {
                        let ip: ptr = sa_json_string_ptr(item);
                        li_dirs_push_unique(out, outCount, ip, sa_json_string_len(item));
                    };
                };
                i = i + 1;
            }
        };
    };
    li_free_doc(tdoc);
    li_dirs_push_unique(out, outCount, STR_PTR("/usr/local/bin"), STR_LEN("/usr/local/bin"));
    li_dirs_push_unique(out, outCount, STR_PTR("/usr/local/sbin"), STR_LEN("/usr/local/sbin"));
    li_dirs_push_unique(out, outCount, STR_PTR("/usr/bin"), STR_LEN("/usr/bin"));
    li_dirs_push_unique(out, outCount, STR_PTR("/opt/bin"), STR_LEN("/opt/bin"));
    li_dirs_push_unique(out, outCount, STR_PTR("/opt/node/bin"), STR_LEN("/opt/node/bin"));
    li_dirs_push_unique(out, outCount, STR_PTR("/tools/node/bin"), STR_LEN("/tools/node/bin"));
    li_dirs_push_unique(out, outCount, STR_PTR("/opt/homebrew/bin"), STR_LEN("/opt/homebrew/bin"));
    li_dirs_push_unique(out, outCount, STR_PTR("/home/linuxbrew/.linuxbrew/bin"), STR_LEN("/home/linuxbrew/.linuxbrew/bin"));
    li_dirs_push_unique(out, outCount, STR_PTR("/home/linuxbrew/.linuxbrew/sbin"), STR_LEN("/home/linuxbrew/.linuxbrew/sbin"));
    li_dirs_push_unique(out, outCount, STR_PTR("/snap/bin"), STR_LEN("/snap/bin"));
    li_dirs_push_unique(out, outCount, STR_PTR("/var/lib/snapd/snap/bin"), STR_LEN("/var/lib/snapd/snap/bin"));
    li_dirs_push_unique(out, outCount, STR_PTR("/var/lib/flatpak/exports/bin"), STR_LEN("/var/lib/flatpak/exports/bin"));
    li_dirs_push_unique(out, outCount, STR_PTR("/nix/var/nix/profiles/default/bin"), STR_LEN("/nix/var/nix/profiles/default/bin"));
    // PATH env split on ':' (POSIX delimiter; win32 ';' is a platform seam).
    let path_env = LiText { bytes: [0u8; 262144], len: 0 };
    let ph: u64 = sa_env_get(STR_PTR("PATH"), STR_LEN("PATH"));
    if ph != 0 {
        let bp: ptr = sa_env_buffer_data(ph);
        li_push(&path_env, bp, sa_env_buffer_len(ph));
    };
    li_free_env_buffer(ph);
    if path_env.len > 0 {
        let pp: ptr = li_text_ptr(&path_env);
        let start: u64 = 0;
        let i: u64 = 0;
        while i <= path_env.len {
            if i == path_env.len || li_byte(pp, i) == 58 {
                if i > start {
                    let seg: ptr = PTR_NULL();
                    PTR_BYTE_ADD(seg, pp, start);
                    li_dirs_push_unique(out, outCount, seg, i - start);
                };
                start = i + 1;
            };
            i = i + 1;
        }
    };
}

fn li_is_exec_file(p: ptr, n: u64) -> bool {
    let md: u64 = sa_fs_metadata(p, n);
    if md == 0 { return false; };
    let is_file = sa_fs_metadata_is_file(md) != 0;
    let mode: u32 = sa_fs_metadata_mode(md);
    sa_fs_metadata_free(md);
    if !is_file { return false; };
    return (mode & 73) != 0;
}

fn findOnPath(names_ptr: ptr, names_len: u64, namesCount: u64, out: &LiStr, outFound: &bool) -> void {
    out.len = 0;
    *outFound = false;
    let dirs = LiText { bytes: [0u8; 262144], len: 0 };
    let dcnt: u64 = 0;
    pathDirs(&dirs, &dcnt);
    let ndoc = li_parse(names_ptr, names_len);
    if ndoc == 0 { return; };
    let ddoc = li_parse(li_text_ptr(&dirs), dirs.len);
    let ni: u64 = 0;
    while ni < namesCount {
        let nitem: u64 = 0;
        if sa_json_array_get(ndoc, ni, &nitem) == 0 {
            if nitem != 0 && sa_json_kind(nitem) == 5 {
                let np: ptr = sa_json_string_ptr(nitem);
                let nl: u64 = sa_json_string_len(nitem);
                if ddoc != 0 {
                    let dc: u64 = 0;
                    sa_json_value_count(ddoc, &dc);
                    let di: u64 = 0;
                    while di < dc {
                        let ditem: u64 = 0;
                        if sa_json_array_get(ddoc, di, &ditem) == 0 {
                            if ditem != 0 && sa_json_kind(ditem) == 5 {
                                let dp2: ptr = sa_json_string_ptr(ditem);
                                let dl2: u64 = sa_json_string_len(ditem);
                                let full = LiStr { bytes: [0u8; 8192], len: 0 };
                                li_join2(dp2, dl2, np, nl, &full);
                                if li_is_exec_file(li_str_ptr(&full), full.len) {
                                    li_push_str(out, li_str_ptr(&full), full.len);
                                    *outFound = true;
                                    li_free_doc(ddoc);
                                    li_free_doc(ndoc);
                                    return;
                                };
                            };
                        };
                        di = di + 1;
                    }
                };
            };
        };
        ni = ni + 1;
    }
    li_free_doc(ddoc);
    li_free_doc(ndoc);
}

fn configEnvPath(spec: &LaunchAdapterSpec, out: &LiStr) -> void {
    out.len = 0;
    let base = LiStr { bytes: [0u8; 8192], len: 0 };
    if !li_env_read(STR_PTR("XDG_CONFIG_HOME"), STR_LEN("XDG_CONFIG_HOME"), &base) {
        let hm = LiStr { bytes: [0u8; 8192], len: 0 };
        home(&hm);
        li_join2(li_str_ptr(&hm), hm.len, STR_PTR(".config"), STR_LEN(".config"), &base);
    };
    let mid = LiStr { bytes: [0u8; 8192], len: 0 };
    li_join2(li_str_ptr(&base), base.len, spec.configDirName_ptr, spec.configDirName_len, &mid);
    li_join2(li_str_ptr(&mid), mid.len, STR_PTR(".env"), STR_LEN(".env"), out);
}

// ---------------------------------------------------------------------------
// .env parsing / placeholders / source dirs / detection (TS L259-392).
// Status string fields point into a caller-provided arena (LiText) that
// outlives the status at every call site (serialized immediately).
// ---------------------------------------------------------------------------

fn li_arena_put(arena: &LiText, p: ptr, n: u64, out_p: &ptr, out_l: &u64) -> void {
    let start = arena.len;
    li_push(arena, p, n);
    let bp: ptr = PTR_NULL();
    PTR_BYTE_ADD(bp, li_text_ptr(arena), start);
    *out_p = bp;
    *out_l = n;
}

fn parseEnvFile(path_ptr: ptr, path_len: u64, out: &LiText) -> void {
    out.len = 0;
    li_push(out, STR_PTR("{}"), STR_LEN("{}"));
    if !li_exists(path_ptr, path_len) { return; };
    let content = LiText { bytes: [0u8; 262144], len: 0 };
    if !li_read_file(path_ptr, path_len, &content) { return; };
    let doc = li_parse(STR_PTR("{}"), STR_LEN("{}"));
    if doc == 0 { return; };
    let cp: ptr = li_text_ptr(&content);
    let start: u64 = 0;
    let i: u64 = 0;
    while i <= content.len {
        if i == content.len || li_byte(cp, i) == 10 {
            let lend = i;
            if lend > start && li_byte(cp, lend - 1) == 13 { lend = lend - 1; };
            if lend > start {
                let lp: ptr = PTR_NULL();
                PTR_BYTE_ADD(lp, cp, start);
                let ll = lend - start;
                let ts: u64 = 0;
                let te: u64 = 0;
                li_trim_range(lp, ll, &ts, &te);
                if te > ts {
                    let tp: ptr = PTR_NULL();
                    PTR_BYTE_ADD(tp, lp, ts);
                    let tl = te - ts;
                    if li_byte(tp, 0) != 35 {
                        // first '=' with index > 0
                        let eq: u64 = 0;
                        let has_eq = false;
                        let j: u64 = 0;
                        while j < tl {
                            if li_byte(tp, j) == 61 { eq = j; has_eq = true; j = tl; } else { j = j + 1; };
                        }
                        if has_eq && eq > 0 {
                            let ks: u64 = 0;
                            let ke: u64 = 0;
                            li_trim_range(tp, eq, &ks, &ke);
                            let vs: u64 = 0;
                            let ve: u64 = 0;
                            let vp0: ptr = PTR_NULL();
                            PTR_BYTE_ADD(vp0, tp, eq + 1);
                            li_trim_range(vp0, tl - eq - 1, &vs, &ve);
                            if ve > vs {
                                let b0 = li_byte(vp0, vs);
                                let b1 = li_byte(vp0, ve - 1);
                                if (b0 == 34 && b1 == 34) || (b0 == 39 && b1 == 39) { vs = vs + 1; ve = ve - 1; };
                            };
                            let kp: ptr = PTR_NULL();
                            PTR_BYTE_ADD(kp, tp, ks);
                            let valp: ptr = PTR_NULL();
                            PTR_BYTE_ADD(valp, vp0, vs);
                            let vlen: u64 = 0;
                            if ve >= vs { vlen = ve - vs; };
                            sa_json_object_set_string(doc, kp, ke - ks, valp, vlen);
                        };
                    };
                };
            };
            start = i + 1;
        };
        i = i + 1;
    }
    li_stringify_into(doc, out);
    li_free_doc(doc);
}

fn li_env_map_get(map_p: ptr, map_l: u64, key_p: ptr, key_l: u64, out: &LiStr) -> bool {
    out.len = 0;
    let doc = li_parse(map_p, map_l);
    if doc == 0 { return false; };
    let r = li_node_string(doc, key_p, key_l, out);
    li_free_doc(doc);
    return r;
}

fn isPlaceholder(value_ptr: ptr, value_len: u64, hasValue: bool) -> bool {
    if !hasValue { return true; };
    let t = LiStr { bytes: [0u8; 8192], len: 0 };
    li_trimmed(value_ptr, value_len, &t);
    if t.len == 0 { return true; };
    // lowercase into a scratch text for the contains checks
    let low = LiText { bytes: [0u8; 262144], len: 0 };
    let tp: ptr = li_str_ptr(&t);
    let i: u64 = 0;
    while i < t.len { low.bytes[low.len] = li_lower(li_byte(tp, i)); low.len = low.len + 1; i = i + 1; }
    let lp: ptr = li_text_ptr(&low);
    if li_contains(lp, low.len, STR_PTR("your-api-key"), STR_LEN("your-api-key")) { return true; };
    if li_contains(lp, low.len, STR_PTR("sk-your-key"), STR_LEN("sk-your-key")) { return true; };
    if li_contains(lp, low.len, STR_PTR("your-gateway"), STR_LEN("your-gateway")) { return true; };
    if li_eq(lp, low.len, STR_PTR("changeme"), STR_LEN("changeme")) { return true; };
    if li_eq(lp, low.len, STR_PTR("xxx"), STR_LEN("xxx")) { return true; };
    return false;
}

fn li_dir_qualifies(dir_p: ptr, dir_l: u64) -> bool {
    let c = LiStr { bytes: [0u8; 8192], len: 0 };
    li_join2(dir_p, dir_l, STR_PTR("install.sh"), STR_LEN("install.sh"), &c);
    if li_exists(li_str_ptr(&c), c.len) { return true; };
    li_join2(dir_p, dir_l, STR_PTR("main.py"), STR_LEN("main.py"), &c);
    if li_exists(li_str_ptr(&c), c.len) { return true; };
    li_join3(dir_p, dir_l, STR_PTR("packages"), STR_LEN("packages"), STR_PTR("coding-agent"), STR_LEN("coding-agent"), &c);
    return li_exists(li_str_ptr(&c), c.len);
}

fn resolveSourceDir(spec: &LaunchAdapterSpec, custom_ptr: ptr, custom_len: u64, hasCustom: bool, out: &LiStr, outFound: &bool) -> void {
    out.len = 0;
    *outFound = false;
    let root = LiStr { bytes: [0u8; 8192], len: 0 };
    defaultSourceRoot(custom_ptr, custom_len, hasCustom, &root);
    let cand = LiStr { bytes: [0u8; 8192], len: 0 };
    li_join2(li_str_ptr(&root), root.len, spec.repo_ptr, spec.repo_len, &cand);
    if li_dir_qualifies(li_str_ptr(&cand), cand.len) { li_push_str(out, li_str_ptr(&cand), cand.len); *outFound = true; return; };
    let hm = LiStr { bytes: [0u8; 8192], len: 0 };
    home(&hm);
    li_join3(li_str_ptr(&hm), hm.len, STR_PTR("projects"), STR_LEN("projects"), spec.repo_ptr, spec.repo_len, &cand);
    if li_dir_qualifies(li_str_ptr(&cand), cand.len) { li_push_str(out, li_str_ptr(&cand), cand.len); *outFound = true; return; };
    li_join3(li_str_ptr(&hm), hm.len, STR_PTR("src"), STR_LEN("src"), spec.repo_ptr, spec.repo_len, &cand);
    if li_dir_qualifies(li_str_ptr(&cand), cand.len) { li_push_str(out, li_str_ptr(&cand), cand.len); *outFound = true; return; };
    li_join2(STR_PTR("/root/projects"), STR_LEN("/root/projects"), spec.repo_ptr, spec.repo_len, &cand);
    if li_dir_qualifies(li_str_ptr(&cand), cand.len) { li_push_str(out, li_str_ptr(&cand), cand.len); *outFound = true; return; };
    // E:/projects, D:/projects candidates are win32 platform seams.
}

fn li_status_json(st: &LaunchAdapterStatus, out: &LiText) -> void {
    out.len = 0;
    let doc = li_parse(STR_PTR("{}"), STR_LEN("{}"));
    if doc == 0 { li_push(out, STR_PTR("{}"), STR_LEN("{}")); return; };
    sa_json_object_set_string(doc, STR_PTR("id"), STR_LEN("id"), st.id_ptr, st.id_len);
    sa_json_object_set_string(doc, STR_PTR("repo"), STR_LEN("repo"), st.repo_ptr, st.repo_len);
    if st.hasCloneUrl {
        sa_json_object_set_string(doc, STR_PTR("cloneUrl"), STR_LEN("cloneUrl"), st.cloneUrl_ptr, st.cloneUrl_len);
    } else {
        sa_json_object_set_null(doc, STR_PTR("cloneUrl"), STR_LEN("cloneUrl"));
    };
    sa_json_object_set_bool(doc, STR_PTR("cloneable"), STR_LEN("cloneable"), st.cloneable);
    sa_json_object_set_bool(doc, STR_PTR("installed"), STR_LEN("installed"), st.installed);
    if st.hasWrapperPath {
        sa_json_object_set_string(doc, STR_PTR("wrapperPath"), STR_LEN("wrapperPath"), st.wrapperPath_ptr, st.wrapperPath_len);
    } else {
        sa_json_object_set_null(doc, STR_PTR("wrapperPath"), STR_LEN("wrapperPath"));
    };
    if st.hasProductCliPath {
        sa_json_object_set_string(doc, STR_PTR("productCliPath"), STR_LEN("productCliPath"), st.productCliPath_ptr, st.productCliPath_len);
    } else {
        sa_json_object_set_null(doc, STR_PTR("productCliPath"), STR_LEN("productCliPath"));
    };
    sa_json_object_set_bool(doc, STR_PTR("productCliPresent"), STR_LEN("productCliPresent"), st.productCliPresent);
    if st.hasSourceDir {
        sa_json_object_set_string(doc, STR_PTR("sourceDir"), STR_LEN("sourceDir"), st.sourceDir_ptr, st.sourceDir_len);
    } else {
        sa_json_object_set_null(doc, STR_PTR("sourceDir"), STR_LEN("sourceDir"));
    };
    sa_json_object_set_bool(doc, STR_PTR("sourcePresent"), STR_LEN("sourcePresent"), st.sourcePresent);
    sa_json_object_set_string(doc, STR_PTR("envPath"), STR_LEN("envPath"), st.envPath_ptr, st.envPath_len);
    sa_json_object_set_bool(doc, STR_PTR("envPresent"), STR_LEN("envPresent"), st.envPresent);
    sa_json_object_set_bool(doc, STR_PTR("envConfigured"), STR_LEN("envConfigured"), st.envConfigured);
    let preview = li_parse(STR_PTR("{}"), STR_LEN("{}"));
    if preview != 0 {
        if st.hasEnvPreviewBaseUrl {
            sa_json_object_set_string(preview, STR_PTR("baseUrl"), STR_LEN("baseUrl"), st.envPreviewBaseUrl_ptr, st.envPreviewBaseUrl_len);
        } else {
            sa_json_object_set_null(preview, STR_PTR("baseUrl"), STR_LEN("baseUrl"));
        };
        if st.hasEnvPreviewModel {
            sa_json_object_set_string(preview, STR_PTR("model"), STR_LEN("model"), st.envPreviewModel_ptr, st.envPreviewModel_len);
        } else {
            sa_json_object_set_null(preview, STR_PTR("model"), STR_LEN("model"));
        };
        sa_json_object_set_bool(preview, STR_PTR("hasApiKey"), STR_LEN("hasApiKey"), st.envPreviewHasApiKey);
        sa_json_object_set_node(doc, STR_PTR("envPreview"), STR_LEN("envPreview"), preview);
        li_free_doc(preview);
    };
    sa_json_object_set_bool(doc, STR_PTR("needsInstall"), STR_LEN("needsInstall"), st.needsInstall);
    sa_json_object_set_bool(doc, STR_PTR("needsSetup"), STR_LEN("needsSetup"), st.needsSetup);
    li_stringify_into(doc, out);
    li_free_doc(doc);
}

fn detectAdapter(spec: &LaunchAdapterSpec, customRoot_ptr: ptr, customRoot_len: u64, hasCustomRoot: bool, arena: &LiText, out: &LaunchAdapterStatus) -> void {
    out.id_ptr = spec.id_ptr;
    out.id_len = spec.id_len;
    out.repo_ptr = spec.repo_ptr;
    out.repo_len = spec.repo_len;
    out.hasCloneUrl = spec.hasCloneUrl;
    out.cloneUrl_ptr = spec.cloneUrl_ptr;
    out.cloneUrl_len = spec.cloneUrl_len;
    out.cloneable = spec.hasCloneUrl;
    // wrapperPath
    let wp = LiStr { bytes: [0u8; 8192], len: 0 };
    let wp_found = false;
    findOnPath(spec.wrapperBins_ptr, spec.wrapperBins_len, spec.wrapperBinsCount, &wp, &wp_found);
    out.hasWrapperPath = wp_found;
    if wp_found { li_arena_put(arena, li_str_ptr(&wp), wp.len, &out.wrapperPath_ptr, &out.wrapperPath_len); };
    // sourceDir + sourceCliPath
    let sd = LiStr { bytes: [0u8; 8192], len: 0 };
    let sd_found = false;
    resolveSourceDir(spec, customRoot_ptr, customRoot_len, hasCustomRoot, &sd, &sd_found);
    out.hasSourceDir = sd_found;
    out.sourcePresent = sd_found;
    if sd_found { li_arena_put(arena, li_str_ptr(&sd), sd.len, &out.sourceDir_ptr, &out.sourceDir_len); };
    let source_cli = LiStr { bytes: [0u8; 8192], len: 0 };
    let source_cli_found = false;
    if sd_found {
        let mid = LiStr { bytes: [0u8; 8192], len: 0 };
        li_join3(li_str_ptr(&sd), sd.len, STR_PTR("packages/coding-agent"), STR_LEN("packages/coding-agent"), STR_PTR("src"), STR_LEN("src"), &mid);
        li_join2(li_str_ptr(&mid), mid.len, STR_PTR("cli.ts"), STR_LEN("cli.ts"), &source_cli);
        source_cli_found = li_exists(li_str_ptr(&source_cli), source_cli.len);
        if !source_cli_found { source_cli.len = 0; };
    };
    // productCliPath = findOnPath(productBins) || sourceCliPath
    let pp = LiStr { bytes: [0u8; 8192], len: 0 };
    let pp_found = false;
    findOnPath(spec.productBins_ptr, spec.productBins_len, spec.productBinsCount, &pp, &pp_found);
    if !pp_found && source_cli_found {
        li_push_str(&pp, li_str_ptr(&source_cli), source_cli.len);
        pp_found = true;
    };
    out.hasProductCliPath = pp_found;
    out.productCliPresent = pp_found;
    if pp_found { li_arena_put(arena, li_str_ptr(&pp), pp.len, &out.productCliPath_ptr, &out.productCliPath_len); };
    // env
    let env_path = LiStr { bytes: [0u8; 8192], len: 0 };
    configEnvPath(spec, &env_path);
    li_arena_put(arena, li_str_ptr(&env_path), env_path.len, &out.envPath_ptr, &out.envPath_len);
    out.envPresent = li_exists(li_str_ptr(&env_path), env_path.len);
    let map = LiText { bytes: [0u8; 262144], len: 0 };
    parseEnvFile(li_str_ptr(&env_path), env_path.len, &map);
    let key = LiStr { bytes: [0u8; 8192], len: 0 };
    li_push_str(&key, spec.envPrefix_ptr, spec.envPrefix_len);
    li_push_str(&key, STR_PTR("BASE_URL"), STR_LEN("BASE_URL"));
    let base_url = LiStr { bytes: [0u8; 8192], len: 0 };
    let has_base = li_env_map_get(li_text_ptr(&map), map.len, li_str_ptr(&key), key.len, &base_url);
    key.len = 0;
    li_push_str(&key, spec.envPrefix_ptr, spec.envPrefix_len);
    li_push_str(&key, STR_PTR("MODEL"), STR_LEN("MODEL"));
    let model = LiStr { bytes: [0u8; 8192], len: 0 };
    let has_model = li_env_map_get(li_text_ptr(&map), map.len, li_str_ptr(&key), key.len, &model);
    key.len = 0;
    li_push_str(&key, spec.envPrefix_ptr, spec.envPrefix_len);
    li_push_str(&key, STR_PTR("API_KEY"), STR_LEN("API_KEY"));
    let api_key = LiStr { bytes: [0u8; 8192], len: 0 };
    let has_key = li_env_map_get(li_text_ptr(&map), map.len, li_str_ptr(&key), key.len, &api_key);
    if !has_key {
        key.len = 0;
        li_push_str(&key, spec.envPrefix_ptr, spec.envPrefix_len);
        li_push_str(&key, STR_PTR("API_KEYS"), STR_LEN("API_KEYS"));
        has_key = li_env_map_get(li_text_ptr(&map), map.len, li_str_ptr(&key), key.len, &api_key);
    };
    let has_api_key = false;
    if has_key { has_api_key = !isPlaceholder(li_str_ptr(&api_key), api_key.len, true); };
    out.envConfigured = has_base && !isPlaceholder(li_str_ptr(&base_url), base_url.len, has_base) && has_api_key;
    // envPreview.baseUrl mirrors the TS verbatim value (placeholder or not).
    out.hasEnvPreviewBaseUrl = has_base;
    if has_base { li_arena_put(arena, li_str_ptr(&base_url), base_url.len, &out.envPreviewBaseUrl_ptr, &out.envPreviewBaseUrl_len); };
    out.hasEnvPreviewModel = has_model;
    if has_model { li_arena_put(arena, li_str_ptr(&model), model.len, &out.envPreviewModel_ptr, &out.envPreviewModel_len); };
    out.envPreviewHasApiKey = has_api_key;
    // installed: wrapperPath || (pi-launch && sourceCliPath)
    let is_pi = li_eq(spec.id_ptr, spec.id_len, STR_PTR("pi-launch"), STR_LEN("pi-launch"));
    out.installed = wp_found || (is_pi && source_cli_found);
    out.needsInstall = !out.installed;
    out.needsSetup = !out.envConfigured;
}

fn detectAll(customRoot_ptr: ptr, customRoot_len: u64, hasCustomRoot: bool, out: &LiText, outCount: &u64) -> void {
    out.len = 0;
    *outCount = 0;
    let root = LiStr { bytes: [0u8; 8192], len: 0 };
    defaultSourceRoot(customRoot_ptr, customRoot_len, hasCustomRoot, &root);
    let doc = li_parse(STR_PTR("{}"), STR_LEN("{}"));
    if doc == 0 { li_push(out, STR_PTR("{}"), STR_LEN("{}")); return; };
    sa_json_object_set_string(doc, STR_PTR("sourceRoot"), STR_LEN("sourceRoot"), li_str_ptr(&root), root.len);
    let arr = li_parse(STR_PTR("[]"), STR_LEN("[]"));
    let arena = LiText { bytes: [0u8; 262144], len: 0 };
    let i: u64 = 0;
    while i < 11 {
        let spec = LaunchAdapterSpec { id_ptr: STR_PTR(""), id_len: 0, repo_ptr: STR_PTR(""), repo_len: 0, hasCloneUrl: false, cloneUrl_ptr: STR_PTR(""), cloneUrl_len: 0, wrapperBins_ptr: STR_PTR(""), wrapperBins_len: 0, wrapperBinsCount: 0, productBins_ptr: STR_PTR(""), productBins_len: 0, productBinsCount: 0, envPrefix_ptr: STR_PTR(""), envPrefix_len: 0, configDirName_ptr: STR_PTR(""), configDirName_len: 0 };
        if launchSpecAt(i, &spec) {
            let st = LaunchAdapterStatus { id_ptr: STR_PTR(""), id_len: 0, repo_ptr: STR_PTR(""), repo_len: 0, hasCloneUrl: false, cloneUrl_ptr: STR_PTR(""), cloneUrl_len: 0, cloneable: false, installed: false, hasWrapperPath: false, wrapperPath_ptr: STR_PTR(""), wrapperPath_len: 0, hasProductCliPath: false, productCliPath_ptr: STR_PTR(""), productCliPath_len: 0, productCliPresent: false, hasSourceDir: false, sourceDir_ptr: STR_PTR(""), sourceDir_len: 0, sourcePresent: false, envPath_ptr: STR_PTR(""), envPath_len: 0, envPresent: false, envConfigured: false, envPreviewBaseUrl_ptr: STR_PTR(""), envPreviewBaseUrl_len: 0, hasEnvPreviewBaseUrl: false, envPreviewModel_ptr: STR_PTR(""), envPreviewModel_len: 0, hasEnvPreviewModel: false, envPreviewHasApiKey: false, needsInstall: true, needsSetup: true };
            arena.len = 0;
            detectAdapter(&spec, customRoot_ptr, customRoot_len, hasCustomRoot, &arena, &st);
            let sj = LiText { bytes: [0u8; 262144], len: 0 };
            li_status_json(&st, &sj);
            let sdoc = li_parse(li_text_ptr(&sj), sj.len);
            if sdoc != 0 {
                sa_json_array_push_node(arr, sdoc);
                li_free_doc(sdoc);
            };
            let c_now = *outCount;
            *outCount = c_now + 1;
        };
        i = i + 1;
    }
    sa_json_object_set_node(doc, STR_PTR("adapters"), STR_LEN("adapters"), arr);
    li_free_doc(arr);
    li_stringify_into(doc, out);
    li_free_doc(doc);
}

// ---------------------------------------------------------------------------
// .env upsert + writeAdapterEnv (TS L394-471).
// ---------------------------------------------------------------------------

fn li_parent_dir(p: ptr, n: u64, out: &LiStr) -> void {
    out.len = 0;
    let i: u64 = n;
    let cut: u64 = 0;
    while i > 0 {
        if li_byte(p, i - 1) == 47 { cut = i - 1; i = 0; } else { i = i - 1; };
    }
    if cut > 0 { li_push_str(out, p, cut); } else { li_push_str(out, STR_PTR("/"), STR_LEN("/")); };
}

fn upsertEnvKeys(path_ptr: ptr, path_len: u64, updates_ptr: ptr, updates_len: u64) -> void {
    let parent = LiStr { bytes: [0u8; 8192], len: 0 };
    li_parent_dir(path_ptr, path_len, &parent);
    sa_fs_mkdir_p(li_str_ptr(&parent), parent.len);
    let existing = LiText { bytes: [0u8; 262144], len: 0 };
    let has_existing = li_read_file(path_ptr, path_len, &existing);
    let updates = li_parse(updates_ptr, updates_len);
    if updates == 0 { return; };
    let out = LiText { bytes: [0u8; 262144], len: 0 };
    // seen keys tracked in a JSON array text
    let seen = LiText { bytes: [0u8; 262144], len: 0 };
    li_push(&seen, STR_PTR("[]"), STR_LEN("[]"));
    let seen_count: u64 = 0;
    if has_existing {
        let cp: ptr = li_text_ptr(&existing);
        let start: u64 = 0;
        let i: u64 = 0;
        while i <= existing.len {
            if i == existing.len || li_byte(cp, i) == 10 {
                let lend = i;
                if lend > start && li_byte(cp, lend - 1) == 13 { lend = lend - 1; };
                let lp: ptr = PTR_NULL();
                PTR_BYTE_ADD(lp, cp, start);
                let ll = lend - start;
                let ts: u64 = 0;
                let te: u64 = 0;
                li_trim_range(lp, ll, &ts, &te);
                let replaced = false;
                if te > ts && li_byte(lp, ts) != 35 {
                    let tp: ptr = PTR_NULL();
                    PTR_BYTE_ADD(tp, lp, ts);
                    let tl = te - ts;
                    let eq: u64 = 0;
                    let has_eq = false;
                    let j: u64 = 0;
                    while j < tl {
                        if li_byte(tp, j) == 61 { eq = j; has_eq = true; j = tl; } else { j = j + 1; };
                    }
                    if has_eq && eq > 0 {
                        let ks: u64 = 0;
                        let ke: u64 = 0;
                        li_trim_range(tp, eq, &ks, &ke);
                        let kp: ptr = PTR_NULL();
                        PTR_BYTE_ADD(kp, tp, ks);
                        let node = li_get(updates, kp, ke - ks);
                        if node != 0 && sa_json_kind(node) == 5 {
                            let np: ptr = sa_json_string_ptr(node);
                            li_push(&out, kp, ke - ks);
                            li_push(&out, STR_PTR("="), STR_LEN("="));
                            li_push(&out, np, sa_json_string_len(node));
                            li_push(&out, STR_PTR("\n"), STR_LEN("\n"));
                            li_dirs_push_unique(&seen, &seen_count, kp, ke - ks);
                            replaced = true;
                        };
                    };
                };
                if !replaced {
                    li_push(&out, lp, ll);
                    li_push(&out, STR_PTR("\n"), STR_LEN("\n"));
                };
                start = i + 1;
            };
            i = i + 1;
        }
    };
    // append unseen updates in object order (JSON doc preserves insertion)
    let keys_text = LiText { bytes: [0u8; 262144], len: 0 };
    let kh: u64 = 0;
    if sa_json_stringify(updates, &kh) == 0 && kh != 0 {
        let kdp: ptr = sa_json_buffer_data(kh);
        li_push(&keys_text, kdp, sa_json_buffer_len(kh));
        li_free_buffer(kh);
    };
    // iterate update keys by scanning the stringified object text for "key":
    // (object member order in this std's stringify follows insertion order)
    // member order: this std's stringify preserves insertion order, so
    // scanning the stringified text for "key": pairs visits updates in
    // TS Object.entries order.
    let kt: ptr = li_text_ptr(&keys_text);
    let ki: u64 = 0;
    while ki < keys_text.len {
        if li_byte(kt, ki) == 34 {
            // find the closing quote (keys are simple env names, no escapes)
            let kj = ki + 1;
            while kj < keys_text.len && li_byte(kt, kj) != 34 { kj = kj + 1; }
            if kj < keys_text.len {
                let kp2: ptr = PTR_NULL();
                PTR_BYTE_ADD(kp2, kt, ki + 1);
                let kl2 = kj - ki - 1;
                // must be followed by ':'
                if kj + 1 < keys_text.len && li_byte(kt, kj + 1) == 58 {
                    let vnode = li_get(updates, kp2, kl2);
                    if vnode != 0 {
                        // skip when seen
                        let sdoc = li_parse(li_text_ptr(&seen), seen.len);
                        let is_seen = false;
                        if sdoc != 0 {
                            let sc: u64 = 0;
                            sa_json_value_count(sdoc, &sc);
                            let si: u64 = 0;
                            while si < sc {
                                let sitem: u64 = 0;
                                if sa_json_array_get(sdoc, si, &sitem) == 0 {
                                    if sitem != 0 && sa_json_kind(sitem) == 5 {
                                        let sp2: ptr = sa_json_string_ptr(sitem);
                                        if li_eq(sp2, sa_json_string_len(sitem), kp2, kl2) { is_seen = true; };
                                    };
                                };
                                si = si + 1;
                            }
                            li_free_doc(sdoc);
                        };
                        if !is_seen && sa_json_kind(vnode) == 5 {
                            let np: ptr = sa_json_string_ptr(vnode);
                            li_push(&out, kp2, kl2);
                            li_push(&out, STR_PTR("="), STR_LEN("="));
                            li_push(&out, np, sa_json_string_len(vnode));
                            li_push(&out, STR_PTR("\n"), STR_LEN("\n"));
                        };
                    };
                };
                ki = kj;
            };
        };
        ki = ki + 1;
    }
    li_free_doc(updates);
    sa_fs_write_file(path_ptr, path_len, li_text_ptr(&out), out.len);
    sa_fs_set_permissions(path_ptr, path_len, 384);
}

fn writeAdapterEnv(spec: &LaunchAdapterSpec, values: &LaunchEnvValues, force: bool, outPath: &LiStr, outWrote: &bool, outSkipped: &bool) -> void {
    let path = LiStr { bytes: [0u8; 8192], len: 0 };
    configEnvPath(spec, &path);
    outPath.len = 0;
    li_push_str(outPath, li_str_ptr(&path), path.len);
    *outWrote = false;
    *outSkipped = false;
    if !force && li_exists(li_str_ptr(&path), path.len) {
        let map = LiText { bytes: [0u8; 262144], len: 0 };
        parseEnvFile(li_str_ptr(&path), path.len, &map);
        let key = LiStr { bytes: [0u8; 8192], len: 0 };
        li_push_str(&key, spec.envPrefix_ptr, spec.envPrefix_len);
        li_push_str(&key, STR_PTR("BASE_URL"), STR_LEN("BASE_URL"));
        let bv = LiStr { bytes: [0u8; 8192], len: 0 };
        let has_bv = li_env_map_get(li_text_ptr(&map), map.len, li_str_ptr(&key), key.len, &bv);
        let has_base = has_bv && !isPlaceholder(li_str_ptr(&bv), bv.len, true);
        key.len = 0;
        li_push_str(&key, spec.envPrefix_ptr, spec.envPrefix_len);
        li_push_str(&key, STR_PTR("API_KEY"), STR_LEN("API_KEY"));
        let kv = LiStr { bytes: [0u8; 8192], len: 0 };
        let has_kv = li_env_map_get(li_text_ptr(&map), map.len, li_str_ptr(&key), key.len, &kv);
        if !has_kv {
            key.len = 0;
            li_push_str(&key, spec.envPrefix_ptr, spec.envPrefix_len);
            li_push_str(&key, STR_PTR("API_KEYS"), STR_LEN("API_KEYS"));
            has_kv = li_env_map_get(li_text_ptr(&map), map.len, li_str_ptr(&key), key.len, &kv);
        };
        let has_key2 = has_kv && !isPlaceholder(li_str_ptr(&kv), kv.len, true);
        if has_base && has_key2 && (!values.hasBaseUrl || values.baseUrl_len == 0) && (!values.hasApiKey || values.apiKey_len == 0) && (!values.hasModel || values.model_len == 0) {
            *outSkipped = true;
            return;
        };
    };
    let updates = li_parse(STR_PTR("{}"), STR_LEN("{}"));
    if updates == 0 { *outSkipped = true; return; };
    let n_updates: u64 = 0;
    if values.hasBaseUrl && values.baseUrl_len > 0 {
        let t = LiStr { bytes: [0u8; 8192], len: 0 };
        li_trimmed(values.baseUrl_ptr, values.baseUrl_len, &t);
        let key = LiStr { bytes: [0u8; 8192], len: 0 };
        li_push_str(&key, spec.envPrefix_ptr, spec.envPrefix_len);
        li_push_str(&key, STR_PTR("BASE_URL"), STR_LEN("BASE_URL"));
        sa_json_object_set_string(updates, li_str_ptr(&key), key.len, li_str_ptr(&t), t.len);
        n_updates = n_updates + 1;
    };
    if values.hasModel && values.model_len > 0 {
        let t = LiStr { bytes: [0u8; 8192], len: 0 };
        li_trimmed(values.model_ptr, values.model_len, &t);
        let key = LiStr { bytes: [0u8; 8192], len: 0 };
        li_push_str(&key, spec.envPrefix_ptr, spec.envPrefix_len);
        li_push_str(&key, STR_PTR("MODEL"), STR_LEN("MODEL"));
        sa_json_object_set_string(updates, li_str_ptr(&key), key.len, li_str_ptr(&t), t.len);
        n_updates = n_updates + 1;
    };
    if values.hasApiKey && values.apiKey_len > 0 {
        let t = LiStr { bytes: [0u8; 8192], len: 0 };
        li_trimmed(values.apiKey_ptr, values.apiKey_len, &t);
        let key = LiStr { bytes: [0u8; 8192], len: 0 };
        li_push_str(&key, spec.envPrefix_ptr, spec.envPrefix_len);
        li_push_str(&key, STR_PTR("API_KEY"), STR_LEN("API_KEY"));
        sa_json_object_set_string(updates, li_str_ptr(&key), key.len, li_str_ptr(&t), t.len);
        n_updates = n_updates + 1;
    };
    if n_updates == 0 {
        li_free_doc(updates);
        if !li_exists(li_str_ptr(&path), path.len) {
            let parent = LiStr { bytes: [0u8; 8192], len: 0 };
            li_parent_dir(li_str_ptr(&path), path.len, &parent);
            sa_fs_mkdir_p(li_str_ptr(&parent), parent.len);
            let tpl = LiText { bytes: [0u8; 262144], len: 0 };
            li_push(&tpl, STR_PTR("# "), STR_LEN("# "));
            li_push(&tpl, spec.id_ptr, spec.id_len);
            li_push(&tpl, STR_PTR(" — created by Codex React UI\n# Fill "), STR_LEN(" — created by Codex React UI\n# Fill "));
            li_push(&tpl, spec.envPrefix_ptr, spec.envPrefix_len);
            li_push(&tpl, STR_PTR("BASE_URL / MODEL / API_KEY\n"), STR_LEN("BASE_URL / MODEL / API_KEY\n"));
            li_push(&tpl, spec.envPrefix_ptr, spec.envPrefix_len);
            li_push(&tpl, STR_PTR("BASE_URL=\n"), STR_LEN("BASE_URL=\n"));
            li_push(&tpl, spec.envPrefix_ptr, spec.envPrefix_len);
            li_push(&tpl, STR_PTR("MODEL=\n"), STR_LEN("MODEL=\n"));
            li_push(&tpl, spec.envPrefix_ptr, spec.envPrefix_len);
            li_push(&tpl, STR_PTR("API_KEY=\n"), STR_LEN("API_KEY=\n"));
            sa_fs_write_file(li_str_ptr(&path), path.len, li_text_ptr(&tpl), tpl.len);
            sa_fs_set_permissions(li_str_ptr(&path), path.len, 384);
            *outWrote = true;
            return;
        };
        *outSkipped = true;
        return;
    };
    let utext = LiText { bytes: [0u8; 262144], len: 0 };
    li_stringify_into(updates, &utext);
    li_free_doc(updates);
    upsertEnvKeys(li_str_ptr(&path), path.len, li_text_ptr(&utext), utext.len);
    *outWrote = true;
}

// ---------------------------------------------------------------------------
// Log sink + line logger (TS L473-496). The sink is a JSON array doc
// handle (0 = silent, matching TS's optional onLog). Items mirror the
// InstallJobLogItem shape {time, text, level-name}.
// ---------------------------------------------------------------------------

fn li_level_name(level: u64, out_p: &ptr, out_l: &u64) -> void {
    if level == 1 { *out_p = STR_PTR("success"); *out_l = STR_LEN("success"); return; };
    if level == 2 { *out_p = STR_PTR("error"); *out_l = STR_LEN("error"); return; };
    if level == 3 { *out_p = STR_PTR("warn"); *out_l = STR_LEN("warn"); return; };
    *out_p = STR_PTR("info");
    *out_l = STR_LEN("info");
}

fn li_clock_text(out: &LiStr) -> void {
    out.len = 0;
    let ms = sa_time_unix_ms();
    let secs = ms / 1000;
    let hh = (secs / 3600) % 24;
    let mm = (secs / 60) % 60;
    let ss = secs % 60;
    let digs = STR_PTR("0123456789");
    out.bytes[out.len] = li_byte(digs, ((hh / 10) as u64)); out.len = out.len + 1;
    out.bytes[out.len] = li_byte(digs, ((hh % 10) as u64)); out.len = out.len + 1;
    out.bytes[out.len] = 58; out.len = out.len + 1;
    out.bytes[out.len] = li_byte(digs, ((mm / 10) as u64)); out.len = out.len + 1;
    out.bytes[out.len] = li_byte(digs, ((mm % 10) as u64)); out.len = out.len + 1;
    out.bytes[out.len] = 58; out.len = out.len + 1;
    out.bytes[out.len] = li_byte(digs, ((ss / 10) as u64)); out.len = out.len + 1;
    out.bytes[out.len] = li_byte(digs, ((ss % 10) as u64)); out.len = out.len + 1;
}

fn li_log_line(sink_doc: u64, text_p: ptr, text_l: u64, level: u64) -> void {
    if sink_doc == 0 { return; };
    let item = li_parse(STR_PTR("{}"), STR_LEN("{}"));
    if item == 0 { return; };
    let clock = LiStr { bytes: [0u8; 8192], len: 0 };
    li_clock_text(&clock);
    sa_json_object_set_string(item, STR_PTR("time"), STR_LEN("time"), li_str_ptr(&clock), clock.len);
    sa_json_object_set_string(item, STR_PTR("text"), STR_LEN("text"), text_p, text_l);
    let lp: ptr = PTR_NULL();
    let ll: u64 = 0;
    li_level_name(level, &lp, &ll);
    sa_json_object_set_string(item, STR_PTR("level"), STR_LEN("level"), lp, ll);
    sa_json_array_push_node(sink_doc, item);
    li_free_doc(item);
}

struct LineLogger {
    prefix: [u8; 64], prefix_len: u64,
    level: u64,
    sink_doc: u64,
    pending: [u8; 8192], pending_len: u64,
}

fn createLineLogger(prefix_ptr: ptr, prefix_len: u64, level: u64, sink_doc: u64, out: &LineLogger) -> void {
    let i: u64 = 0;
    while i < prefix_len && i < 64 { out.prefix[i] = li_byte(prefix_ptr, i); i = i + 1; }
    out.prefix_len = i;
    out.level = level;
    out.sink_doc = sink_doc;
    out.pending_len = 0;
}

fn li_logger_emit(lg: &LineLogger, line_p: ptr, line_l: u64) -> void {
    let t = LiStr { bytes: [0u8; 8192], len: 0 };
    li_trimmed(line_p, line_l, &t);
    if t.len == 0 { return; };
    let msg = LiText { bytes: [0u8; 262144], len: 0 };
    let pp: ptr = PTR_NULL();
    PTR_BYTE_ADD(pp, &lg.prefix, 0);
    li_push(&msg, pp, lg.prefix_len);
    li_push(&msg, li_str_ptr(&t), t.len);
    li_log_line(lg.sink_doc, li_text_ptr(&msg), msg.len, lg.level);
}

fn lineLoggerWrite(lg: &LineLogger, chunk_ptr: ptr, chunk_len: u64) -> void {
    let i: u64 = 0;
    while i < chunk_len {
        let b = li_byte(chunk_ptr, i);
        let c: u8 = b;
        if b == 13 { c = 10; };
        if c == 10 {
            let pp: ptr = PTR_NULL();
            PTR_BYTE_ADD(pp, &lg.pending, 0);
            li_logger_emit(lg, pp, lg.pending_len);
            lg.pending_len = 0;
        } else {
            if lg.pending_len < 8192 { lg.pending[lg.pending_len] = c; lg.pending_len = lg.pending_len + 1; };
        };
        i = i + 1;
    }
}

fn lineLoggerFlush(lg: &LineLogger) -> void {
    let pp: ptr = PTR_NULL();
    PTR_BYTE_ADD(pp, &lg.pending, 0);
    li_logger_emit(lg, pp, lg.pending_len);
    lg.pending_len = 0;
}

// ---------------------------------------------------------------------------
// runCmd (TS L530-570): blocking process run with stream line-logging
// and a kill-on-timeout budget. Child env overrides of the TS (PATH
// prefix, GIT_TERMINAL_PROMPT, npm_config_*) ride the runtime wrapper
// in TS; the std runner inherits the process env — registered seam.
// ---------------------------------------------------------------------------

struct RunCmdResult {
    ok: bool, code: i64,
    stdout: LiText, stderr: LiText,
}

fn li_drain(handle: u64, is_err: bool, acc: &LiText, lg: &LineLogger) -> void {
    let buf: [u8; 8192] = [0u8; 8192];
    let bp: ptr = PTR_NULL();
    PTR_BYTE_ADD(bp, &buf, 0);
    let n: u64 = 0;
    let st: i32 = 0;
    if is_err {
        st = sa_std_process_read_stderr(handle, bp, 8192, &n);
    } else {
        st = sa_std_process_read_stdout(handle, bp, 8192, &n);
    };
    if st == 0 && n > 0 {
        li_push(acc, bp, n);
        lineLoggerWrite(lg, bp, n);
    };
}

fn runCmd(cmd_ptr: ptr, cmd_len: u64, cmdCount: u64, cwd_ptr: ptr, cwd_len: u64, timeoutMs: u64, sink_doc: u64, out: &RunCmdResult) -> i32 {
    out.ok = false;
    out.code = 0;
    out.stdout.len = 0;
    out.stderr.len = 0;
    let argv_doc = li_parse(cmd_ptr, cmd_len);
    if argv_doc == 0 { out.code = -1; return -1; };
    let slots: [u64; 64] = [0u64; 64];
    let si: u64 = 0;
    while si < cmdCount && si < 32 {
        let item: u64 = 0;
        if sa_json_array_get(argv_doc, si, &item) == 0 {
            if item != 0 && sa_json_kind(item) == 5 {
                let ip: ptr = sa_json_string_ptr(item);
                PROCESS_ARGV_SET_PTR(&slots, si, ip, sa_json_string_len(item));
            };
        };
        si = si + 1;
    }
    let sp: ptr = PTR_NULL();
    PTR_BYTE_ADD(sp, &slots, 0);
    let handle: u64 = 0;
    let rc = sa_std_process_run_cwd(sp, cmdCount, cwd_ptr, cwd_len, &handle);
    li_free_doc(argv_doc);
    if rc != 0 || handle == 0 { out.code = -1; return -1; };
    let out_lg = LineLogger { prefix: [0u8; 64], prefix_len: 0, level: 0, sink_doc: sink_doc, pending: [0u8; 8192], pending_len: 0 };
    let err_lg = LineLogger { prefix: [0u8; 64], prefix_len: 0, level: 3, sink_doc: sink_doc, pending: [0u8; 8192], pending_len: 0 };
    let pi: u64 = 0;
    while pi < STR_LEN("stderr: ") { err_lg.prefix[pi] = li_byte(STR_PTR("stderr: "), pi); pi = pi + 1; }
    err_lg.prefix_len = STR_LEN("stderr: ");
    let started = sa_time_unix_ms();
    let timed_out = false;
    let done = false;
    let code: i64 = 0;
    while !done {
        li_drain(handle, false, &out.stdout, &out_lg);
        li_drain(handle, true, &out.stderr, &err_lg);
        let ready: u64 = 0;
        let raw_code: i64 = 0;
        let wst = sa_std_process_try_wait(handle, &ready, &raw_code);
        if wst == 0 && ready != 0 {
            code = raw_code;
            done = true;
        } else {
            if (sa_time_unix_ms() - started) as u64 >= timeoutMs {
                timed_out = true;
                done = true;
                let krc = sa_std_process_kill(handle);
            };
            if !done { sa_time_sleep_ms(10); };
        };
    }
    li_drain(handle, false, &out.stdout, &out_lg);
    li_drain(handle, true, &out.stderr, &err_lg);
    lineLoggerFlush(&out_lg);
    lineLoggerFlush(&err_lg);
    if timed_out {
        let msg = LiText { bytes: [0u8; 262144], len: 0 };
        li_push(&msg, STR_PTR("command timed out after "), STR_LEN("command timed out after "));
        let secs = timeoutMs / 1000;
        // small itoa
        let tmp: [u8; 24] = [0u8; 24];
        let tn: u64 = 0;
        let v = secs;
        if v == 0 { tmp[0] = 48; tn = 1; };
        while v > 0 {
            let rev: [u8; 24] = [0u8; 24];
            let rn: u64 = 0;
            let vv = v;
            while vv > 0 { rev[rn] = (48 + (vv % 10)) as u8; rn = rn + 1; vv = vv / 10; }
            let ri: u64 = 0;
            while ri < rn { tmp[ri] = rev[rn - 1 - ri]; ri = ri + 1; }
            tn = rn;
            v = 0;
        }
        let tp2: ptr = PTR_NULL();
        PTR_BYTE_ADD(tp2, &tmp, 0);
        li_push(&msg, tp2, tn);
        li_push(&msg, STR_PTR("s: "), STR_LEN("s: "));
        li_push(&msg, cmd_ptr, cmd_len);
        li_log_line(sink_doc, li_text_ptr(&msg), msg.len, 2);
        out.code = 124;
        out.ok = false;
        return 0;
    };
    out.code = code;
    out.ok = code == 0;
    return 0;
}

// ---------------------------------------------------------------------------
// Clone / install.sh / installOne (TS L572-701). Errors are carried as
// text (the TS throws; callers here branch on the i32 + err text).
// ---------------------------------------------------------------------------

fn li_steps_push(steps_doc: u64, p: ptr, n: u64) -> void {
    sa_json_array_push_string(steps_doc, p, n);
}

fn li_join_texts(a_p: ptr, a_l: u64, b_p: ptr, b_l: u64, out: &LiText) -> void {
    out.len = 0;
    li_push(out, a_p, a_l);
    li_push(out, b_p, b_l);
}

fn ensureCloned(spec: &LaunchAdapterSpec, steps_doc: u64, custom_ptr: ptr, custom_len: u64, hasCustom: bool, sink_doc: u64, outDir: &LiStr, err: &LiStr) -> i32 {
    err.len = 0;
    let root = LiStr { bytes: [0u8; 8192], len: 0 };
    defaultSourceRoot(custom_ptr, custom_len, hasCustom, &root);
    sa_fs_mkdir_p(li_str_ptr(&root), root.len);
    let target = LiStr { bytes: [0u8; 8192], len: 0 };
    li_join2(li_str_ptr(&root), root.len, spec.repo_ptr, spec.repo_len, &target);
    let existing = LiStr { bytes: [0u8; 8192], len: 0 };
    let ex_found = false;
    resolveSourceDir(spec, custom_ptr, custom_len, hasCustom, &existing, &ex_found);
    if ex_found {
        let msg = LiText { bytes: [0u8; 262144], len: 0 };
        li_push(&msg, STR_PTR("source present: "), STR_LEN("source present: "));
        li_push(&msg, li_str_ptr(&existing), existing.len);
        li_steps_push(steps_doc, li_text_ptr(&msg), msg.len);
        li_push_str(outDir, li_str_ptr(&existing), existing.len);
        return 0;
    };
    if !spec.hasCloneUrl {
        li_push_str(err, spec.id_ptr, spec.id_len);
        li_push_str(err, STR_PTR(": no public GitHub clone URL (repo not published under layola13). Provide the source manually or publish the repo."), STR_LEN(": no public GitHub clone URL (repo not published under layola13). Provide the source manually or publish the repo."));
        return -1;
    };
    if li_exists(li_str_ptr(&target), target.len) {
        let msg = LiText { bytes: [0u8; 262144], len: 0 };
        li_push(&msg, STR_PTR("using existing checkout: "), STR_LEN("using existing checkout: "));
        li_push(&msg, li_str_ptr(&target), target.len);
        li_steps_push(steps_doc, li_text_ptr(&msg), msg.len);
        li_push_str(outDir, li_str_ptr(&target), target.len);
        return 0;
    };
    let step = LiText { bytes: [0u8; 262144], len: 0 };
    li_push(&step, STR_PTR("git clone "), STR_LEN("git clone "));
    li_push(&step, spec.cloneUrl_ptr, spec.cloneUrl_len);
    li_push(&step, STR_PTR(" -> "), STR_LEN(" -> "));
    li_push(&step, li_str_ptr(&target), target.len);
    li_steps_push(steps_doc, li_text_ptr(&step), step.len);
    let logline = LiText { bytes: [0u8; 262144], len: 0 };
    li_push(&logline, STR_PTR("$ git clone --depth 1 "), STR_LEN("$ git clone --depth 1 "));
    li_push(&logline, spec.cloneUrl_ptr, spec.cloneUrl_len);
    li_push(&logline, STR_PTR(" "), STR_LEN(" "));
    li_push(&logline, li_str_ptr(&target), target.len);
    li_log_line(sink_doc, li_text_ptr(&logline), logline.len, 0);
    let argv = LiText { bytes: [0u8; 262144], len: 0 };
    // build argv via doc for correct escaping
    let adoc = li_parse(STR_PTR("[]"), STR_LEN("[]"));
    li_steps_push(adoc, STR_PTR("git"), STR_LEN("git"));
    li_steps_push(adoc, STR_PTR("clone"), STR_LEN("clone"));
    li_steps_push(adoc, STR_PTR("--depth"), STR_LEN("--depth"));
    li_steps_push(adoc, STR_PTR("1"), STR_LEN("1"));
    li_steps_push(adoc, spec.cloneUrl_ptr, spec.cloneUrl_len);
    li_steps_push(adoc, li_str_ptr(&target), target.len);
    li_stringify_into(adoc, &argv);
    li_free_doc(adoc);
    let res = RunCmdResult { ok: false, code: 0, stdout: LiText { bytes: [0u8; 262144], len: 0 }, stderr: LiText { bytes: [0u8; 262144], len: 0 } };
    runCmd(li_text_ptr(&argv), argv.len, 6, li_str_ptr(&root), root.len, 180000, sink_doc, &res);
    if !res.ok {
        li_push_str(err, STR_PTR("git clone failed: "), STR_LEN("git clone failed: "));
        if res.stderr.len > 0 {
            li_push_str(err, li_text_ptr(&res.stderr), res.stderr.len);
        } else if res.stdout.len > 0 {
            li_push_str(err, li_text_ptr(&res.stdout), res.stdout.len);
        } else {
            li_push_str(err, STR_PTR("exit "), STR_LEN("exit "));
            let num = LiStr { bytes: [0u8; 8192], len: 0 };
            li_i64_text(res.code, &num);
            li_push_str(err, li_str_ptr(&num), num.len);
        };
        return -1;
    };
    li_push_str(outDir, li_str_ptr(&target), target.len);
    return 0;
}

fn li_i64_text(v: i64, out: &LiStr) -> void {
    out.len = 0;
    let neg = v < 0;
    let uv: u64 = 0;
    if neg { uv = (0 - v) as u64; } else { uv = v as u64; };
    let rev: [u8; 24] = [0u8; 24];
    let rn: u64 = 0;
    if uv == 0 { rev[0] = 48; rn = 1; };
    let vv = uv;
    while vv > 0 { rev[rn] = (48 + (vv % 10)) as u8; rn = rn + 1; vv = vv / 10; }
    if neg { out.bytes[out.len] = 45; out.len = out.len + 1; };
    let ri: u64 = 0;
    while ri < rn { out.bytes[out.len] = rev[rn - 1 - ri]; out.len = out.len + 1; ri = ri + 1; }
}

fn runInstallSh(sourceDir_ptr: ptr, sourceDir_len: u64, skipCli: bool, steps_doc: u64, sink_doc: u64, err: &LiStr) -> i32 {
    err.len = 0;
    let script = LiStr { bytes: [0u8; 8192], len: 0 };
    li_join2(sourceDir_ptr, sourceDir_len, STR_PTR("install.sh"), STR_LEN("install.sh"), &script);
    if !li_exists(li_str_ptr(&script), script.len) {
        li_push_str(err, STR_PTR("install.sh not found in "), STR_LEN("install.sh not found in "));
        li_push_str(err, sourceDir_ptr, sourceDir_len);
        return -1;
    };
    sa_fs_set_permissions(li_str_ptr(&script), script.len, 493);
    let adoc = li_parse(STR_PTR("[]"), STR_LEN("[]"));
    li_steps_push(adoc, STR_PTR("bash"), STR_LEN("bash"));
    li_steps_push(adoc, li_str_ptr(&script), script.len);
    if skipCli { li_steps_push(adoc, STR_PTR("--skip-cli"), STR_LEN("--skip-cli")); };
    let step = LiText { bytes: [0u8; 262144], len: 0 };
    li_push(&step, STR_PTR("bash "), STR_LEN("bash "));
    li_push(&step, li_str_ptr(&script), script.len);
    if skipCli { li_push(&step, STR_PTR(" --skip-cli"), STR_LEN(" --skip-cli")); };
    li_steps_push(steps_doc, li_text_ptr(&step), step.len);
    let logline = LiText { bytes: [0u8; 262144], len: 0 };
    li_push(&logline, STR_PTR("$ "), STR_LEN("$ "));
    li_push(&logline, li_text_ptr(&step), step.len);
    li_log_line(sink_doc, li_text_ptr(&logline), logline.len, 0);
    let argv = LiText { bytes: [0u8; 262144], len: 0 };
    li_stringify_into(adoc, &argv);
    li_free_doc(adoc);
    let argc: u64 = 2;
    if skipCli { argc = 3; };
    let timeout: u64 = 600000;
    if skipCli { timeout = 120000; };
    let res = RunCmdResult { ok: false, code: 0, stdout: LiText { bytes: [0u8; 262144], len: 0 }, stderr: LiText { bytes: [0u8; 262144], len: 0 } };
    runCmd(li_text_ptr(&argv), argv.len, argc, sourceDir_ptr, sourceDir_len, timeout, sink_doc, &res);
    if !res.ok {
        li_push_str(err, STR_PTR("install.sh failed (exit "), STR_LEN("install.sh failed (exit "));
        let num = LiStr { bytes: [0u8; 8192], len: 0 };
        li_i64_text(res.code, &num);
        li_push_str(err, li_str_ptr(&num), num.len);
        li_push_str(err, STR_PTR("): "), STR_LEN("): "));
        // tail 2000 of stderr || stdout
        let src_p: ptr = li_text_ptr(&res.stderr);
        let src_l: u64 = res.stderr.len;
        if src_l == 0 { src_p = li_text_ptr(&res.stdout); src_l = res.stdout.len; };
        let from: u64 = 0;
        if src_l > 2000 { from = src_l - 2000; };
        let tail_p: ptr = PTR_NULL();
        PTR_BYTE_ADD(tail_p, src_p, from);
        li_push_str(err, tail_p, src_l - from);
        return -1;
    };
    li_steps_push(steps_doc, STR_PTR("install.sh ok"), STR_LEN("install.sh ok"));
    return 0;
}

fn li_values_from_json(json_p: ptr, json_l: u64, arena: &LiText, out: &LaunchEnvValues) -> void {
    out.hasBaseUrl = false;
    out.hasModel = false;
    out.hasApiKey = false;
    let doc = li_parse(json_p, json_l);
    if doc == 0 { return; };
    let v = LiStr { bytes: [0u8; 8192], len: 0 };
    if li_node_string(doc, STR_PTR("baseUrl"), STR_LEN("baseUrl"), &v) {
        out.hasBaseUrl = true;
        li_arena_put(arena, li_str_ptr(&v), v.len, &out.baseUrl_ptr, &out.baseUrl_len);
    };
    if li_node_string(doc, STR_PTR("model"), STR_LEN("model"), &v) {
        out.hasModel = true;
        li_arena_put(arena, li_str_ptr(&v), v.len, &out.model_ptr, &out.model_len);
    };
    if li_node_string(doc, STR_PTR("apiKey"), STR_LEN("apiKey"), &v) {
        out.hasApiKey = true;
        li_arena_put(arena, li_str_ptr(&v), v.len, &out.apiKey_ptr, &out.apiKey_len);
    };
    li_free_doc(doc);
}

