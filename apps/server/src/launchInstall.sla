struct LaunchAdapterSpec {
    id_ptr: ptr, id_len: u64,
    repo_ptr: ptr, repo_len: u64,
    hasCloneUrl: bool, cloneUrl_ptr: ptr, cloneUrl_len: u64, // cloneUrl: string | null
    wrapperBins_ptr: ptr, wrapperBins_len: u64, // string[] -> JSON array text
    wrapperBinsCount: u64,
    productBins_ptr: ptr, productBins_len: u64, // string[] -> JSON array text
    productBinsCount: u64,
    envPrefix_ptr: ptr, envPrefix_len: u64,
    configDirName_ptr: ptr, configDirName_len: u64,
}

// LAUNCH_SPECS (源 L25-L144): 11 entries, order preserved 1:1:
// code-launch, agy-launch, claude-launch (productBins claude+claudecode), gemini-launch, crush-launch,
// auggie-launch, grok-launch (productBins grok+agent), agent-launch (cloneUrl null, shares GROK_LAUNCH_/grok-launch),
// coderabbit-launch (null), freebuff-launch (null), pi-launch (repo "pi", null, wrapperBins pi+pi-launch).
// DEFECT: const array of object literals -> accessor fn returning spec by index; literal table materialized at fix stage.
fn launchSpecsCount() -> u64 { return 11; }
fn launchSpecAt(index: u64, out: &LaunchAdapterSpec) -> bool {
    // DEFECT: static table data (URLs https://github.com/layola13/<repo>.git etc.) not embedded in bulk pass; fields filled at fix stage.
    if index >= 11 { return false; };
    return true;
}

struct LaunchAdapterStatus {
    id_ptr: ptr, id_len: u64,
    repo_ptr: ptr, repo_len: u64,
    hasCloneUrl: bool, cloneUrl_ptr: ptr, cloneUrl_len: u64,
    cloneable: bool,
    installed: bool,
    hasWrapperPath: bool, wrapperPath_ptr: ptr, wrapperPath_len: u64,
    hasProductCliPath: bool, productCliPath_ptr: ptr, productCliPath_len: u64,
    productCliPresent: bool,
    hasSourceDir: bool, sourceDir_ptr: ptr, sourceDir_len: u64,
    sourcePresent: bool,
    envPath_ptr: ptr, envPath_len: u64,
    envPresent: bool,
    envConfigured: bool,
    envPreviewBaseUrl_ptr: ptr, envPreviewBaseUrl_len: u64, hasEnvPreviewBaseUrl: bool,
    envPreviewModel_ptr: ptr, envPreviewModel_len: u64, hasEnvPreviewModel: bool,
    envPreviewHasApiKey: bool,
    needsInstall: bool,
    needsSetup: bool,
}

struct LaunchEnvValues {
    hasBaseUrl: bool, baseUrl_ptr: ptr, baseUrl_len: u64,
    hasModel: bool, model_ptr: ptr, model_len: u64,
    hasApiKey: bool, apiKey_ptr: ptr, apiKey_len: u64,
}

struct InstallLaunchRequest {
    ids_ptr: ptr, ids_len: u64, idsCount: u64, hasIds: bool, // string[] -> JSON array text
    missingOnly: bool, hasMissingOnly: bool,
    skipCli: bool, hasSkipCli: bool, // default true semantics in source comments; undefined check used in installOne
    envMode: u64, hasEnvMode: bool, // 0=shared 1=separate 2=none
    sharedEnv: LaunchEnvValues, hasSharedEnv: bool,
    separateEnv_ptr: ptr, separateEnv_len: u64, hasSeparateEnv: bool, // DEFECT: dynamic object Record<string, LaunchEnvValues> as JSON buffer
    forceEnv: bool, hasForceEnv: bool,
    sourceRoot_ptr: ptr, sourceRoot_len: u64, hasSourceRoot: bool,
    skipModelTest: bool, hasSkipModelTest: bool,
}

struct InstallLaunchResultItem {
    id_ptr: ptr, id_len: u64,
    ok: bool,
    steps_ptr: ptr, steps_len: u64, stepsCount: u64, // string[] -> JSON array text
    hasError: bool, error_ptr: ptr, error_len: u64,
