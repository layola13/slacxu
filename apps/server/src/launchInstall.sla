}

fn createLineLogger(prefix_ptr: ptr, prefix_len: u64, level: u64, ctxId: u64, out: &LineLogger) -> void {
    // 源 L483-L505: returns {write, flush} object closing over pending/prefix/level/onLog
    // DEFECT: closure object with methods -> struct + standalone fns lineLoggerWrite/lineLoggerFlush below.
    out.pending_len = 0;
    out.level = level;
    out.ctxId = ctxId;
}

fn lineLoggerWrite(lg: &LineLogger, chunk_ptr: ptr, chunk_len: u64) -> void {
    // 源 L493-L501: pending += chunk.replace(/\r/g,"\n"); split lines; emit each complete line (trimmed, non-empty) via onLog(prefix+text, level)
    // DEFECT: regex replace + callback invocation approximated.
}

fn lineLoggerFlush(lg: &LineLogger) -> void {
    // 源 L502-L504: emit(pending); pending = ""
    lg.pending_len = 0;
}

