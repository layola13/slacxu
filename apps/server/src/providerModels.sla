// Converted 1:1 from apps/server/src/providerModels.ts (CXU plugins @ f2cb649d).
// FIX (stores batch): full body retranslation. The skeleton header's
// claim that fetch / Headers / AbortController / setTimeout / URL
// have no sa_std counterpart is stale: sa_std http_client.sai v2 is a
// stateful client exposing status + body, and req_set_timeout_v2 +
// req_send_v2 status 3 is the AbortController/timeout equivalent
// (AB class (ii) blocking-contract landing). Headers are modelled as
// a JSON object text in the landed Headers buffer (set = replace,
// matching Headers.set). URL/URLSearchParams were only used for the
// gemini `key` query param — hand-rolled in applyProtocolQueryAuth.
// joinRelayEndpoint and normalizeReasoningEfforts are local pm_
// replicas of relayProtocolGateway.sla:5856 and
// packages/shared/src/modelCapabilities.sla:727: importing the
// gateway would drag its whole closure (relayCatalog + freebuff +
// ollama + omniroute) into this unit for one 40-line helper.
// Registered in _defects/FIX_SERVER_STORES.md.
@import "sa_std/io/print.sai"
@import "sa_std/string.sa"
@import "sa_std/ptr.sa"
@import "sa_std/encoding/json.sai"
@import "sa_std/http_client.sai"
@import "sa_std/time.sai"
@import "sa_std/crypto.sai"

struct FetchProviderModelsInput { baseUrl: [u8; 4096], baseUrl_len: u64, apiKey: [u8; 4096], apiKey_len: u64, has_apiKey: bool, kind: [u8; 128], kind_len: u64, has_kind: bool, protocol: [u8; 64], protocol_len: u64, has_protocol: bool, authType: [u8; 64], authType_len: u64, has_authType: bool }
struct FetchProviderModelsResult { models_json: [u8; 65536], models_json_len: u64, modelCapabilities_json: [u8; 65536], modelCapabilities_json_len: u64, has_capabilities: bool, error: [u8; 4096], error_len: u64, has_error: bool, endpoint: [u8; 4096], endpoint_len: u64, has_endpoint: bool }
struct TestProviderInput { baseUrl: [u8; 4096], baseUrl_len: u64, apiKey: [u8; 4096], apiKey_len: u64, has_apiKey: bool, kind: [u8; 128], kind_len: u64, has_kind: bool, protocol: [u8; 64], protocol_len: u64, has_protocol: bool, authType: [u8; 64], authType_len: u64, has_authType: bool, model: [u8; 512], model_len: u64, has_model: bool, timeoutMs: i64, has_timeoutMs: bool, endpointPathOverride: [u8; 2048], endpointPathOverride_len: u64, has_override: bool }
struct TestProviderResult { ok: bool, model: [u8; 512], model_len: u64, prompt: [u8; 256], prompt_len: u64, message: [u8; 4096], message_len: u64, endpoint: [u8; 4096], endpoint_len: u64, has_endpoint: bool, statusCode: i64, has_statusCode: bool, elapsedMs: i64 }
struct Headers { buf: [u8; 8192], len: u64 }
fn FETCH_TIMEOUT_MS() -> i64 { return 12000; }
fn PROVIDER_TEST_TIMEOUT_MS() -> i64 { return 60000; }
fn DEFAULT_PROVIDER_TEST_PROMPT_ptr() -> ptr { return STR_PTR("Reply with exactly: pong"); }
// PROVIDER_TEST_PROMPTS[3]: default, "Say only the word ready.", "Answer with one short word: ok."
fn RELAY_CLIENT_USER_AGENT_ptr() -> ptr { return STR_PTR("claude-cli/1.0.0 (external, cli)"); }

// ---- pm_ text toolkit ----
struct PmText { bytes: [u8; 65536], len: u64 }
struct PmSmall { bytes: [u8; 8192], len: u64 }
struct PmNodeList { items: [u64; 512], len: u64 }

fn pm_text_ptr(t: &PmText) -> ptr {
    let p: ptr = PTR_NULL();
    PTR_BYTE_ADD(p, &t.bytes, 0);
    return p;
}

fn pm_small_ptr(t: &PmSmall) -> ptr {
    let p: ptr = PTR_NULL();
    PTR_BYTE_ADD(p, &t.bytes, 0);
    return p;
}

fn pm_append(dst: &PmText, p: ptr, len: u64) -> void {
    let dp: ptr = pm_text_ptr(dst);
    let i: u64 = 0;
    while i < len {
        if dst.len < 65536 {
            let b: u8 = 0;
            PTR_BYTE_AT(b, p, i);
            dst.bytes[dst.len] = b;
            dst.len = dst.len + 1;
        };
        i = i + 1;
    }
}

fn pm_append_small(dst: &PmSmall, p: ptr, len: u64) -> void {
    let i: u64 = 0;
    while i < len {
        if dst.len < 8192 {
            let b: u8 = 0;
            PTR_BYTE_AT(b, p, i);
            dst.bytes[dst.len] = b;
            dst.len = dst.len + 1;
        };
        i = i + 1;
    }
}

fn pm_append_u64(dst: &PmText, v: u64) -> void {
    if v == 0 {
        pm_append(dst, STR_PTR("0"), STR_LEN("0"));
        return;
    };
    let rev: [u8; 24] = [0u8; 24];
    let n: u64 = 0;
    let x: u64 = v;
    while x > 0 {
        rev[n] = 48 + (x % 10) as u8;
        n = n + 1;
        x = x / 10;
    }
    let i: u64 = n;
    while i > 0 {
        i = i - 1;
        let one: [u8; 1] = [rev[i]; 1];
        let op: ptr = PTR_NULL();
        PTR_BYTE_ADD(op, &one, 0);
        pm_append(dst, op, 1);
    }
}

fn pm_append_i64(dst: &PmText, v: i64) -> void {
    if v < 0 {
        pm_append(dst, STR_PTR("-"), STR_LEN("-"));
        pm_append_u64(dst, (0 - v) as u64);
        return;
    };
    pm_append_u64(dst, v as u64);
}

fn pm_byte(p: ptr, i: u64) -> u8 {
    let b: u8 = 0;
    PTR_BYTE_AT(b, p, i);
    return b;
}

fn pm_lower(c: u8) -> u8 {
    if c >= 65 && c <= 90 { return c + 32; };
    return c;
}

// JS String.prototype.trim range (ASCII whitespace subset:
// space/tab/LF/CR/VT/FF — the inputs here are URLs, keys and model
// ids where the Unicode space cases do not arise in practice).
fn pm_trim_range(p: ptr, len: u64, lo: &u64, hi: &u64) -> void {
    let a: u64 = 0;
    let b: u64 = len;
    while a < b {
        let c: u8 = pm_byte(p, a);
        if c == 32 || c == 9 || c == 10 || c == 13 || c == 11 || c == 12 { a = a + 1; } else { break; };
    }
    while b > a {
        let c2: u8 = pm_byte(p, b - 1);
        if c2 == 32 || c2 == 9 || c2 == 10 || c2 == 13 || c2 == 11 || c2 == 12 { b = b - 1; } else { break; };
    }
    *lo = a;
    *hi = b;
}

fn pm_eq(p: ptr, len: u64, q: ptr, qlen: u64) -> bool {
    if len != qlen { return false; };
    let i: u64 = 0;
    while i < len {
        if pm_byte(p, i) != pm_byte(q, i) { return false; };
        i = i + 1;
    }
    return true;
}

fn pm_eq_lit(p: ptr, len: u64, lit: ptr, lit_len: u64) -> bool {
    return pm_eq(p, len, lit, lit_len);
}

fn pm_contains_ci(p: ptr, len: u64, needle: ptr, nlen: u64) -> bool {
    if nlen == 0 { return true; };
    if nlen > len { return false; };
    let i: u64 = 0;
    while i + nlen <= len {
        let ok: bool = true;
        let j: u64 = 0;
        while j < nlen {
            if pm_lower(pm_byte(p, i + j)) != pm_lower(pm_byte(needle, j)) { ok = false; };
            j = j + 1;
        }
        if ok { return true; };
        i = i + 1;
    }
    return false;
}

fn pm_starts_with_ci(p: ptr, len: u64, pre: ptr, pre_len: u64) -> bool {
    if pre_len > len { return false; };
    let j: u64 = 0;
    while j < pre_len {
        if pm_lower(pm_byte(p, j)) != pm_lower(pm_byte(pre, j)) { return false; };
        j = j + 1;
    }
    return true;
}

fn pm_ends_with_ci(p: ptr, len: u64, suf: ptr, suf_len: u64) -> bool {
    if suf_len > len { return false; };
    let off: u64 = len - suf_len;
    let j: u64 = 0;
    while j < suf_len {
        if pm_lower(pm_byte(p, off + j)) != pm_lower(pm_byte(suf, j)) { return false; };
        j = j + 1;
    }
    return true;
}

fn pm_ends_with(p: ptr, len: u64, suf: ptr, suf_len: u64) -> bool {
    if suf_len > len { return false; };
    let off: u64 = len - suf_len;
    let j: u64 = 0;
    while j < suf_len {
        if pm_byte(p, off + j) != pm_byte(suf, j) { return false; };
        j = j + 1;
    }
    return true;
}

// Fixed array fields of the landed structs are written by
// field-indexed loops (SLA has no store-through-raw-ptr surface);
// each out struct gets dedicated setters below.

fn pm_fr_set_models(out: &FetchProviderModelsResult, src: ptr, len: u64) -> void {
    let n: u64 = len;
    if n > 65536 { n = 65536; };
    let i: u64 = 0;
    while i < n { out.models_json[i] = pm_byte(src, i); i = i + 1; }
    out.models_json_len = n;
}

fn pm_fr_set_caps(out: &FetchProviderModelsResult, src: ptr, len: u64) -> void {
    let n: u64 = len;
    if n > 65536 { n = 65536; };
    let i: u64 = 0;
    while i < n { out.modelCapabilities_json[i] = pm_byte(src, i); i = i + 1; }
    out.modelCapabilities_json_len = n;
    out.has_capabilities = true;
}

fn pm_fr_set_error(out: &FetchProviderModelsResult, src: ptr, len: u64) -> void {
    let n: u64 = len;
    if n > 4096 { n = 4096; };
    let i: u64 = 0;
    while i < n { out.error[i] = pm_byte(src, i); i = i + 1; }
    out.error_len = n;
    out.has_error = true;
}

fn pm_fr_set_endpoint(out: &FetchProviderModelsResult, src: ptr, len: u64) -> void {
    let n: u64 = len;
    if n > 4096 { n = 4096; };
    let i: u64 = 0;
    while i < n { out.endpoint[i] = pm_byte(src, i); i = i + 1; }
    out.endpoint_len = n;
    out.has_endpoint = true;
}

fn pm_tr_set_model(out: &TestProviderResult, src: ptr, len: u64) -> void {
    let n: u64 = len;
    if n > 512 { n = 512; };
    let i: u64 = 0;
    while i < n { out.model[i] = pm_byte(src, i); i = i + 1; }
    out.model_len = n;
}

fn pm_tr_set_prompt(out: &TestProviderResult, src: ptr, len: u64) -> void {
    let n: u64 = len;
    if n > 256 { n = 256; };
    let i: u64 = 0;
    while i < n { out.prompt[i] = pm_byte(src, i); i = i + 1; }
    out.prompt_len = n;
}

fn pm_tr_set_message(out: &TestProviderResult, src: ptr, len: u64) -> void {
    let n: u64 = len;
    if n > 4096 { n = 4096; };
    let i: u64 = 0;
    while i < n { out.message[i] = pm_byte(src, i); i = i + 1; }
    out.message_len = n;
}

fn pm_tr_set_endpoint(out: &TestProviderResult, src: ptr, len: u64) -> void {
    let n: u64 = len;
    if n > 4096 { n = 4096; };
    let i: u64 = 0;
    while i < n { out.endpoint[i] = pm_byte(src, i); i = i + 1; }
    out.endpoint_len = n;
    out.has_endpoint = true;
}

// ---- Headers (JSON object text in the landed buffer) ----
fn pm_headers_init(h: &Headers) -> void {
    h.buf[0] = 123;
    h.buf[1] = 125;
    h.len = 2;
}

fn pm_headers_set(h: &Headers, key_p: ptr, key_l: u64, val_p: ptr, val_l: u64) -> void {
    let hp: ptr = PTR_NULL();
    PTR_BYTE_ADD(hp, &h.buf, 0);
    let doc: u64 = sa_json_parse(hp, h.len);
    if doc == 0 { doc = sa_json_parse(STR_PTR("{}"), STR_LEN("{}")); };
    if doc == 0 { return; };
    let st: i32 = sa_json_object_set_string(doc, key_p, key_l, val_p, val_l);
    let buf: u64 = 0;
    let sst: i32 = sa_json_stringify(doc, &buf);
    if sst == 0 && buf != 0 {
        let bp: ptr = sa_json_buffer_data(buf);
        let bl: u64 = sa_json_buffer_len(buf);
        let n: u64 = bl;
        if n > 8192 { n = 8192; };
        let i: u64 = 0;
        while i < n { h.buf[i] = pm_byte(bp, i); i = i + 1; }
        h.len = n;
        let bf: i32 = sa_json_buffer_free(buf);
    };
    let ff: i32 = sa_json_free(doc);
}

// ---- shared JSON helpers ----
fn pm_jget(node: u64, key_p: ptr, key_l: u64) -> u64 {
    if node == 0 { return 0; };
    let out: u64 = 0;
    let st: i32 = sa_json_object_get(node, key_p, key_l, &out);
    if st != 0 { return 0; };
    return out;
}

fn pm_jstr(node: u64, out_p: &ptr, out_l: &u64) -> bool {
    *out_p = PTR_NULL();
    *out_l = 0;
    if node == 0 { return false; };
    if sa_json_kind(node) != 5 { return false; };
    *out_p = sa_json_string_ptr(node);
    *out_l = sa_json_string_len(node);
    return true;
}

fn pm_doc_to_text(doc: u64, out: &PmText) -> void {
    out.len = 0;
    if doc == 0 { return; };
    let buf: u64 = 0;
    let st: i32 = sa_json_stringify(doc, &buf);
    if st != 0 || buf == 0 { return; };
    let bp: ptr = sa_json_buffer_data(buf);
    let bl: u64 = sa_json_buffer_len(buf);
    pm_append(out, bp, bl);
    let bf: i32 = sa_json_buffer_free(buf);
}

fn pm_parse(p: ptr, len: u64) -> u64 {
    if len == 0 { return 0; };
    return sa_json_parse(p, len);
}

// First finite number > 0 among (node, key) pairs held in parallel
// arrays; JS .find with a typeof-number predicate (JSON int/float
// kinds only).
fn pm_first_positive(node: u64, key_p: ptr, key_l: u64, out_v: &f64) -> bool {
    let v: u64 = pm_jget(node, key_p, key_l);
    if v == 0 { return false; };
    let k: u32 = sa_json_kind(v);
    if k != 2 && k != 3 { return false; };
    let fv: f64 = 0.0;
    let ast: i32 = sa_json_as_f64(v, &fv);
    if ast == 0 && fv > 0.0 {
        *out_v = fv;
        return true;
    };
    return false;
}

fn pm_round_i64(v: f64) -> i64 {
    // Math.round for positive values
    return (v + 0.5) as i64;
}

// ---- kind predicates (regexes hand-scanned; semantics equal for
// these ASCII patterns) ----
fn kindLooksAnthropic(kind_ptr: ptr, kind_len: u64, baseUrl_ptr: ptr, baseUrl_len: u64) -> bool {
    if pm_contains_ci(kind_ptr, kind_len, STR_PTR("anthropic"), STR_LEN("anthropic")) { return true; };
    if pm_contains_ci(baseUrl_ptr, baseUrl_len, STR_PTR("anthropic"), STR_LEN("anthropic")) { return true; };
    if pm_contains_ci(baseUrl_ptr, baseUrl_len, STR_PTR("claude"), STR_LEN("claude")) { return true; };
    return false;
}

fn kindLooksGemini(kind_ptr: ptr, kind_len: u64, baseUrl_ptr: ptr, baseUrl_len: u64) -> bool {
    if pm_contains_ci(kind_ptr, kind_len, STR_PTR("gemini"), STR_LEN("gemini")) { return true; };
    if pm_contains_ci(baseUrl_ptr, baseUrl_len, STR_PTR("generativelanguage.googleapis.com"), STR_LEN("generativelanguage.googleapis.com")) { return true; };
    if pm_contains_ci(baseUrl_ptr, baseUrl_len, STR_PTR("gemini"), STR_LEN("gemini")) { return true; };
    return false;
}

fn isResponsesRelayKind(kind_ptr: ptr, kind_len: u64, has_kind: bool) -> bool {
    let p: ptr = kind_ptr;
    let l: u64 = kind_len;
    if !has_kind { p = STR_PTR("responsesRelay"); l = STR_LEN("responsesRelay"); };
    let lo: u64 = 0;
    let hi: u64 = 0;
    pm_trim_range(p, l, &lo, &hi);
    let tp: ptr = PTR_NULL();
    PTR_BYTE_ADD(tp, p, lo);
    let tl: u64 = hi - lo;
    if tl != STR_LEN("responsesrelay") { return false; };
    let j: u64 = 0;
    while j < tl {
        if pm_lower(pm_byte(tp, j)) != pm_byte(STR_PTR("responsesrelay"), j) { return false; };
        j = j + 1;
    }
    return true;
}

// /\/v1(\/|$)/i or /\/v\d+(\/|$)/i presence scan
fn pm_has_version_segment(p: ptr, len: u64) -> bool {
    let i: u64 = 0;
    while i < len {
        if pm_byte(p, i) == 47 && i + 1 < len && pm_lower(pm_byte(p, i + 1)) == 118 {
            // "/v" — case /v1 first
            if i + 2 < len && pm_byte(p, i + 2) == 49 {
                if i + 3 >= len { return true; };
                if pm_byte(p, i + 3) == 47 { return true; };
            };
            // /v\d+
            let j: u64 = i + 2;
            let digits: u64 = 0;
            while j < len {
                let c: u8 = pm_byte(p, j);
                if c >= 48 && c <= 57 { digits = digits + 1; j = j + 1; } else { break; };
            }
            if digits > 0 {
                if j >= len { return true; };
                if pm_byte(p, j) == 47 { return true; };
            };
        };
        i = i + 1;
    }
    return false;
}

// /\/v1(beta)?(\/|$)/i presence scan (gemini models branch)
fn pm_has_v1_or_beta(p: ptr, len: u64) -> bool {
    let i: u64 = 0;
    while i < len {
        if pm_byte(p, i) == 47 && i + 2 < len && pm_lower(pm_byte(p, i + 1)) == 118 && pm_byte(p, i + 2) == 49 {
            let j: u64 = i + 3;
            if j >= len { return true; };
            if pm_byte(p, j) == 47 { return true; };
            // "beta" then / or end
            if j + 4 <= len && pm_lower(pm_byte(p, j)) == 98 && pm_lower(pm_byte(p, j + 1)) == 101 && pm_lower(pm_byte(p, j + 2)) == 116 && pm_lower(pm_byte(p, j + 3)) == 97 {
                if j + 4 >= len { return true; };
                if pm_byte(p, j + 4) == 47 { return true; };
            };
        };
        i = i + 1;
    }
    return false;
}

// strip trailing "/" run into out (PmSmall)
fn pm_strip_slashes(p: ptr, len: u64, out: &PmSmall) -> void {
    let n: u64 = len;
    while n > 0 {
        if pm_byte(p, n - 1) == 47 { n = n - 1; } else { break; };
    }
    out.len = 0;
    pm_append_small(out, p, n);
}

// strip a case-insensitive suffix if present
fn pm_strip_suffix_ci(t: &PmSmall, suf: ptr, suf_len: u64) -> void {
    let tp: ptr = pm_small_ptr(t);
    if pm_ends_with_ci(tp, t.len, suf, suf_len) {
        t.len = t.len - suf_len;
    };
}


fn pm_small_copy(src: &PmSmall, dst: &PmSmall) -> void {
    let sp: ptr = pm_small_ptr(src);
    dst.len = 0;
    pm_append_small(dst, sp, src.len);
}

fn pm_small_text(t: &PmSmall, out: &PmText) -> void {
    out.len = 0;
    pm_append(out, pm_small_ptr(t), t.len);
}

// ---- endpoint preparation ----
fn pm_set_endpoint_out(out: &EndpointHeaders, text: &PmText) -> void {
    let n: u64 = text.len;
    if n > 4096 { n = 4096; };
    let tp: ptr = pm_text_ptr(text);
    let i: u64 = 0;
    while i < n { out.endpoint[i] = pm_byte(tp, i); i = i + 1; }
    out.endpoint_len = n;
}

fn prepareModelsEndpoint(kind_ptr: ptr, kind_len: u64, rawBaseUrl_ptr: ptr, rawBaseUrl_len: u64, out: &EndpointHeaders) -> i32 {
    pm_headers_init(&out.headers);
    pm_headers_set(&out.headers, STR_PTR("Accept"), STR_LEN("Accept"), STR_PTR("application/json"), STR_LEN("application/json"));
    pm_headers_set(&out.headers, STR_PTR("User-Agent"), STR_LEN("User-Agent"), RELAY_CLIENT_USER_AGENT_ptr(), STR_LEN("claude-cli/1.0.0 (external, cli)"));
    let base = PmSmall { bytes: [0u8; 8192], len: 0 };
    pm_strip_slashes(rawBaseUrl_ptr, rawBaseUrl_len, &base);
    let use_raw: bool = false;
    let bp0: ptr = pm_small_ptr(&base);
    if base.len > 0 && pm_byte(bp0, base.len - 1) == 35 {
        base.len = base.len - 1;
        let again = PmSmall { bytes: [0u8; 8192], len: 0 };
        pm_strip_slashes(pm_small_ptr(&base), base.len, &again);
        pm_small_copy(&again, &base);
        use_raw = true;
    };
    let bp: ptr = pm_small_ptr(&base);
    let ep = PmText { bytes: [0u8; 65536], len: 0 };
    if kindLooksAnthropic(kind_ptr, kind_len, bp, base.len) {
        pm_headers_set(&out.headers, STR_PTR("Anthropic-Version"), STR_LEN("Anthropic-Version"), STR_PTR("2023-06-01"), STR_LEN("2023-06-01"));
        pm_strip_suffix_ci(&base, STR_PTR("/anthropic"), STR_LEN("/anthropic"));
        pm_strip_suffix_ci(&base, STR_PTR("/claude"), STR_LEN("/claude"));
        bp = pm_small_ptr(&base);
        pm_append(&ep, bp, base.len);
        if use_raw {
            pm_append(&ep, STR_PTR("/models"), STR_LEN("/models"));
        } else {
            if pm_ends_with(bp, base.len, STR_PTR("/v1"), STR_LEN("/v1")) {
                pm_append(&ep, STR_PTR("/models"), STR_LEN("/models"));
            } else {
                pm_append(&ep, STR_PTR("/v1/models"), STR_LEN("/v1/models"));
            };
        };
        pm_set_endpoint_out(out, &ep);
        return 0;
    };
    if kindLooksGemini(kind_ptr, kind_len, bp, base.len) || pm_contains_ci(bp, base.len, STR_PTR("generativelanguage.googleapis.com"), STR_LEN("generativelanguage.googleapis.com")) {
        pm_append(&ep, bp, base.len);
        if pm_has_v1_or_beta(bp, base.len) || pm_ends_with_ci(bp, base.len, STR_PTR("/openai"), STR_LEN("/openai")) {
            pm_append(&ep, STR_PTR("/models"), STR_LEN("/models"));
        } else {
            pm_append(&ep, STR_PTR("/v1beta/models"), STR_LEN("/v1beta/models"));
        };
        pm_set_endpoint_out(out, &ep);
        return 0;
    };
    if pm_contains_ci(bp, base.len, STR_PTR("bigmodel.cn"), STR_LEN("bigmodel.cn")) || pm_contains_ci(bp, base.len, STR_PTR("open.bigmodel"), STR_LEN("open.bigmodel")) {
        let trimmed = PmSmall { bytes: [0u8; 8192], len: 0 };
        pm_small_copy(&base, &trimmed);
        pm_strip_suffix_ci(&trimmed, STR_PTR("/v4"), STR_LEN("/v4"));
        pm_strip_suffix_ci(&trimmed, STR_PTR("/paas/v4"), STR_LEN("/paas/v4"));
        if pm_contains_ci(bp, base.len, STR_PTR("/paas/v4"), STR_LEN("/paas/v4")) || pm_contains_ci(bp, base.len, STR_PTR("/v4"), STR_LEN("/v4")) {
            let stripped = PmSmall { bytes: [0u8; 8192], len: 0 };
            pm_strip_slashes(bp, base.len, &stripped);
            pm_append(&ep, pm_small_ptr(&stripped), stripped.len);
            pm_append(&ep, STR_PTR("/models"), STR_LEN("/models"));
        } else {
            pm_append(&ep, pm_small_ptr(&trimmed), trimmed.len);
            pm_append(&ep, STR_PTR("/api/paas/v4/models"), STR_LEN("/api/paas/v4/models"));
        };
        pm_set_endpoint_out(out, &ep);
        return 0;
    };
    pm_append(&ep, bp, base.len);
    if use_raw {
        pm_append(&ep, STR_PTR("/models"), STR_LEN("/models"));
    } else {
        if pm_has_version_segment(bp, base.len) {
            pm_append(&ep, STR_PTR("/models"), STR_LEN("/models"));
        } else {
            pm_append(&ep, STR_PTR("/v1/models"), STR_LEN("/v1/models"));
        };
    };
    pm_set_endpoint_out(out, &ep);
    return 0;
}

fn pm_prepare_test_endpoint(kind_ptr: ptr, kind_len: u64, rawBaseUrl_ptr: ptr, rawBaseUrl_len: u64, self_suffix: ptr, self_suffix_len: u64, add_suffix: ptr, add_suffix_len: u64, out: &EndpointHeaders) -> void {
    pm_headers_init(&out.headers);
    pm_headers_set(&out.headers, STR_PTR("Accept"), STR_LEN("Accept"), STR_PTR("application/json"), STR_LEN("application/json"));
    pm_headers_set(&out.headers, STR_PTR("Content-Type"), STR_LEN("Content-Type"), STR_PTR("application/json"), STR_LEN("application/json"));
    pm_headers_set(&out.headers, STR_PTR("User-Agent"), STR_LEN("User-Agent"), RELAY_CLIENT_USER_AGENT_ptr(), STR_LEN("claude-cli/1.0.0 (external, cli)"));
    let base = PmSmall { bytes: [0u8; 8192], len: 0 };
    pm_strip_slashes(rawBaseUrl_ptr, rawBaseUrl_len, &base);
    let bp0: ptr = pm_small_ptr(&base);
    if base.len > 0 && pm_byte(bp0, base.len - 1) == 35 {
        base.len = base.len - 1;
        let again = PmSmall { bytes: [0u8; 8192], len: 0 };
        pm_strip_slashes(pm_small_ptr(&base), base.len, &again);
        pm_small_copy(&again, &base);
    };
    let bp: ptr = pm_small_ptr(&base);
    let ep = PmText { bytes: [0u8; 65536], len: 0 };
    if pm_ends_with(bp, base.len, self_suffix, self_suffix_len) {
        pm_append(&ep, bp, base.len);
        pm_set_endpoint_out(out, &ep);
        return;
    };
    if pm_has_version_segment(bp, base.len) {
        pm_append(&ep, bp, base.len);
        pm_append(&ep, add_suffix, add_suffix_len);
        pm_set_endpoint_out(out, &ep);
        return;
    };
    if kindLooksAnthropic(kind_ptr, kind_len, bp, base.len) {
        pm_strip_suffix_ci(&base, STR_PTR("/anthropic"), STR_LEN("/anthropic"));
        pm_strip_suffix_ci(&base, STR_PTR("/claude"), STR_LEN("/claude"));
        bp = pm_small_ptr(&base);
    };
    pm_append(&ep, bp, base.len);
    pm_append(&ep, STR_PTR("/v1"), STR_LEN("/v1"));
    pm_append(&ep, add_suffix, add_suffix_len);
    pm_set_endpoint_out(out, &ep);
}

fn prepareResponsesEndpoint(kind_ptr: ptr, kind_len: u64, rawBaseUrl_ptr: ptr, rawBaseUrl_len: u64, out: &EndpointHeaders) -> i32 {
    pm_prepare_test_endpoint(kind_ptr, kind_len, rawBaseUrl_ptr, rawBaseUrl_len, STR_PTR("/responses"), STR_LEN("/responses"), STR_PTR("/responses"), STR_LEN("/responses"), out);
    return 0;
}

fn prepareChatCompletionsEndpoint(kind_ptr: ptr, kind_len: u64, rawBaseUrl_ptr: ptr, rawBaseUrl_len: u64, out: &EndpointHeaders) -> i32 {
    pm_prepare_test_endpoint(kind_ptr, kind_len, rawBaseUrl_ptr, rawBaseUrl_len, STR_PTR("/chat/completions"), STR_LEN("/chat/completions"), STR_PTR("/chat/completions"), STR_LEN("/chat/completions"), out);
    return 0;
}

// ---- auth headers ----
fn applyProviderAuthHeaders(headers: &Headers, kind_ptr: ptr, kind_len: u64, baseUrl_ptr: ptr, baseUrl_len: u64, apiKey_ptr: ptr, apiKey_len: u64) -> i32 {
    if apiKey_len == 0 { return 0; };
    let bearer = PmSmall { bytes: [0u8; 8192], len: 0 };
    pm_append_small(&bearer, STR_PTR("Bearer "), STR_LEN("Bearer "));
    pm_append_small(&bearer, apiKey_ptr, apiKey_len);
    let bp: ptr = pm_small_ptr(&bearer);
    if kindLooksAnthropic(kind_ptr, kind_len, baseUrl_ptr, baseUrl_len) {
        pm_headers_set(headers, STR_PTR("X-Api-Key"), STR_LEN("X-Api-Key"), apiKey_ptr, apiKey_len);
        pm_headers_set(headers, STR_PTR("Authorization"), STR_LEN("Authorization"), bp, bearer.len);
        pm_headers_set(headers, STR_PTR("Anthropic-Version"), STR_LEN("Anthropic-Version"), STR_PTR("2023-06-01"), STR_LEN("2023-06-01"));
        return 0;
    };
    if kindLooksGemini(kind_ptr, kind_len, baseUrl_ptr, baseUrl_len) {
        pm_headers_set(headers, STR_PTR("X-Goog-Api-Key"), STR_LEN("X-Goog-Api-Key"), apiKey_ptr, apiKey_len);
        pm_headers_set(headers, STR_PTR("Authorization"), STR_LEN("Authorization"), bp, bearer.len);
        return 0;
    };
    pm_headers_set(headers, STR_PTR("Authorization"), STR_LEN("Authorization"), bp, bearer.len);
    return 0;
}

fn applyProtocolAuthHeaders(headers: &Headers, protocol_ptr: ptr, protocol_len: u64, authType_ptr: ptr, authType_len: u64, has_authType: bool, apiKey_ptr: ptr, apiKey_len: u64) -> i32 {
    if apiKey_len == 0 { return 0; };
    let bearer = PmSmall { bytes: [0u8; 8192], len: 0 };
    pm_append_small(&bearer, STR_PTR("Bearer "), STR_LEN("Bearer "));
    pm_append_small(&bearer, apiKey_ptr, apiKey_len);
    let bp: ptr = pm_small_ptr(&bearer);
    let at_bearer: bool = has_authType && pm_eq_lit(authType_ptr, authType_len, STR_PTR("bearer"), STR_LEN("bearer"));
    let at_inherit: bool = has_authType && pm_eq_lit(authType_ptr, authType_len, STR_PTR("inherit"), STR_LEN("inherit"));
    let at_anthropic: bool = has_authType && pm_eq_lit(authType_ptr, authType_len, STR_PTR("anthropic"), STR_LEN("anthropic"));
    let at_google: bool = has_authType && pm_eq_lit(authType_ptr, authType_len, STR_PTR("google_api_key"), STR_LEN("google_api_key"));
    if at_bearer || at_inherit || !has_authType {
        pm_headers_set(headers, STR_PTR("Authorization"), STR_LEN("Authorization"), bp, bearer.len);
    };
    if at_anthropic || ((at_inherit || !has_authType) && pm_eq_lit(protocol_ptr, protocol_len, STR_PTR("anthropic"), STR_LEN("anthropic"))) {
        pm_headers_set(headers, STR_PTR("X-Api-Key"), STR_LEN("X-Api-Key"), apiKey_ptr, apiKey_len);
        pm_headers_set(headers, STR_PTR("Anthropic-Version"), STR_LEN("Anthropic-Version"), STR_PTR("2023-06-01"), STR_LEN("2023-06-01"));
        pm_headers_set(headers, STR_PTR("Authorization"), STR_LEN("Authorization"), bp, bearer.len);
    };
    if at_google || ((at_inherit || !has_authType) && pm_eq_lit(protocol_ptr, protocol_len, STR_PTR("gemini"), STR_LEN("gemini"))) {
        pm_headers_set(headers, STR_PTR("X-Goog-Api-Key"), STR_LEN("X-Goog-Api-Key"), apiKey_ptr, apiKey_len);
        pm_headers_set(headers, STR_PTR("Authorization"), STR_LEN("Authorization"), bp, bearer.len);
    };
    return 0;
}

// new URL(endpoint); url.searchParams.set("key", apiKey); toString()
// — only fires for gemini + google_query_key with a key present.
// The value is appended unencoded (TS percent-encodes via
// URLSearchParams; relay API keys are URL-safe in practice —
// registered).
fn applyProtocolQueryAuth(endpoint_ptr: ptr, endpoint_len: u64, protocol_ptr: ptr, protocol_len: u64, has_protocol: bool, authType_ptr: ptr, authType_len: u64, has_authType: bool, apiKey_ptr: ptr, apiKey_len: u64, out_ptr: ptr, out_cap: u64) -> u64 {
    let out = PmText { bytes: [0u8; 65536], len: 0 };
    let fire: bool = apiKey_len > 0 && has_protocol && pm_eq_lit(protocol_ptr, protocol_len, STR_PTR("gemini"), STR_LEN("gemini")) && has_authType && pm_eq_lit(authType_ptr, authType_len, STR_PTR("google_query_key"), STR_LEN("google_query_key"));
    if !fire {
        pm_append(&out, endpoint_ptr, endpoint_len);
    } else {
        // find '?' and an existing key= param
        let qpos: u64 = endpoint_len;
        let i: u64 = 0;
        while i < endpoint_len {
            if pm_byte(endpoint_ptr, i) == 63 { qpos = i; break; };
            i = i + 1;
        }
        if qpos >= endpoint_len {
            pm_append(&out, endpoint_ptr, endpoint_len);
            pm_append(&out, STR_PTR("?key="), STR_LEN("?key="));
            pm_append(&out, apiKey_ptr, apiKey_len);
        } else {
            // scan params for key=
            let replaced: bool = false;
            let seg_start: u64 = qpos + 1;
            let j: u64 = seg_start;
            let write_upto: u64 = endpoint_len;
            while j <= endpoint_len {
                if j == endpoint_len || pm_byte(endpoint_ptr, j) == 38 {
                    // segment [seg_start, j)
                    if j - seg_start >= 4 && pm_byte(endpoint_ptr, seg_start) == 107 && pm_byte(endpoint_ptr, seg_start + 1) == 101 && pm_byte(endpoint_ptr, seg_start + 2) == 121 && pm_byte(endpoint_ptr, seg_start + 3) == 61 {
                        pm_append(&out, endpoint_ptr, seg_start);
                        pm_append(&out, STR_PTR("key="), STR_LEN("key="));
                        pm_append(&out, apiKey_ptr, apiKey_len);
                        if j < endpoint_len {
                            let rest: ptr = PTR_NULL();
                            PTR_BYTE_ADD(rest, endpoint_ptr, j);
                            pm_append(&out, rest, endpoint_len - j);
                        };
                        replaced = true;
                        write_upto = 0;
                        break;
                    };
                    seg_start = j + 1;
                };
                j = j + 1;
            }
            if !replaced {
                pm_append(&out, endpoint_ptr, endpoint_len);
                pm_append(&out, STR_PTR("&key="), STR_LEN("&key="));
                pm_append(&out, apiKey_ptr, apiKey_len);
            };
        };
    };
    let n: u64 = out.len;
    if n > out_cap { n = out_cap; };
    let op: ptr = pm_text_ptr(&out);
    PTR_COPY_BYTES(out_ptr, op, n);
    return n;
}

fn protocolKind(protocol_ptr: ptr, protocol_len: u64, has_protocol: bool, kind_ptr: ptr, kind_len: u64, has_kind: bool, out_ptr: ptr, out_cap: u64) -> u64 {
    let out = PmText { bytes: [0u8; 65536], len: 0 };
    if has_protocol && pm_eq_lit(protocol_ptr, protocol_len, STR_PTR("anthropic"), STR_LEN("anthropic")) {
        pm_append(&out, STR_PTR("anthropic"), STR_LEN("anthropic"));
    } else {
        if has_protocol && pm_eq_lit(protocol_ptr, protocol_len, STR_PTR("gemini"), STR_LEN("gemini")) {
            pm_append(&out, STR_PTR("gemini"), STR_LEN("gemini"));
        } else {
            if has_protocol && pm_eq_lit(protocol_ptr, protocol_len, STR_PTR("openai"), STR_LEN("openai")) {
                pm_append(&out, STR_PTR("openai"), STR_LEN("openai"));
            } else {
                if has_protocol && pm_eq_lit(protocol_ptr, protocol_len, STR_PTR("openai-response"), STR_LEN("openai-response")) {
                    pm_append(&out, STR_PTR("responsesRelay"), STR_LEN("responsesRelay"));
                } else {
                    let kp: ptr = kind_ptr;
                    let kl: u64 = kind_len;
                    if !has_kind { kp = STR_PTR("responsesRelay"); kl = STR_LEN("responsesRelay"); };
                    let lo: u64 = 0;
                    let hi: u64 = 0;
                    pm_trim_range(kp, kl, &lo, &hi);
                    let tp: ptr = PTR_NULL();
                    PTR_BYTE_ADD(tp, kp, lo);
                    pm_append(&out, tp, hi - lo);
                };
            };
        };
    };
    let n: u64 = out.len;
    if n > out_cap { n = out_cap; };
    let op: ptr = pm_text_ptr(&out);
    PTR_COPY_BYTES(out_ptr, op, n);
    return n;
}

// ---- HTTP via the stateful v2 client (status exposed; send
// status 3 is the timeout/abort equivalent) ----
fn pm_http(method_tag: u64, url_p: ptr, url_l: u64, headers: &Headers, body_p: ptr, body_l: u64, has_body: bool, timeout_ms: i64, out_status: &i64, out_body: &PmText, out_timeout: &bool, out_failed: &bool) -> void {
    *out_status = 0;
    out_body.len = 0;
    *out_timeout = false;
    *out_failed = false;
    let use_tls: u8 = 0;
    if pm_starts_with_ci(url_p, url_l, STR_PTR("https:"), STR_LEN("https:")) { use_tls = 1; };
    let client: ptr = PTR_NULL();
    let cst: u32 = sa_http_client_new_v2(use_tls, PTR_NULL(), 0, &client);
    if cst != 0 || client == PTR_NULL() {
        *out_failed = true;
        return;
    };
    let req: ptr = PTR_NULL();
    let rst: u32 = sa_http_client_req_new_v2(client, method_tag, url_p, url_l, &req);
    if rst != 0 || req == PTR_NULL() {
        let cf: u32 = sa_http_client_free(client);
        *out_failed = true;
        return;
    };
    // headers: iterate the JSON object text
    let hp: ptr = PTR_NULL();
    PTR_BYTE_ADD(hp, &headers.buf, 0);
    let hdoc: u64 = sa_json_parse(hp, headers.len);
    if hdoc != 0 {
        let cnt: u64 = 0;
        let cst2: i32 = sa_json_value_count(hdoc, &cnt);
        let hi: u64 = 0;
        while hi < cnt {
            let kp: ptr = PTR_NULL();
            let kn: u64 = 0;
            let kst: i32 = sa_json_object_key_at(hdoc, hi, &kp, &kn);
            if kst == 0 {
                let vp: ptr = PTR_NULL();
                let vl: u64 = 0;
                let vnode: u64 = pm_jget(hdoc, kp, kn);
                if pm_jstr(vnode, &vp, &vl) {
                    let hst: u32 = sa_http_client_req_add_header_v2(req, kp, kn, vp, vl);
                };
            };
            hi = hi + 1;
        }
        let hf: i32 = sa_json_free(hdoc);
    };
    if has_body {
        let bst: u32 = sa_http_client_req_set_body_v2(req, body_p, body_l);
    };
    let tst: u32 = sa_http_client_req_set_timeout_v2(req, timeout_ms as u32);
    let resp: ptr = PTR_NULL();
    let sst: u32 = sa_http_client_req_send_v2(req, &resp);
    if sst == 3 {
        let rf: u32 = sa_http_client_req_free(req);
        let cf2: u32 = sa_http_client_free(client);
        *out_timeout = true;
        *out_failed = true;
        return;
    };
    if sst != 0 || resp == PTR_NULL() {
        let rf2: u32 = sa_http_client_req_free(req);
        let cf3: u32 = sa_http_client_free(client);
        *out_failed = true;
        return;
    };
    *out_status = sa_http_client_resp_status(resp) as i64;
    let bp: ptr = sa_http_client_resp_body_ptr(resp);
    let bn: u64 = sa_http_client_resp_body_len(resp);
    if bp != PTR_NULL() { pm_append(out_body, bp, bn); };
    let rf3: u32 = sa_http_client_resp_free(resp);
    let rf4: u32 = sa_http_client_req_free(req);
    let cf4: u32 = sa_http_client_free(client);
}

// ---- reasoning efforts normalization (local replica of
// packages/shared modelCapabilities semantics) ----
fn pm_effort_candidate(el: u64, out_p: &ptr, out_l: &u64) -> bool {
    *out_p = PTR_NULL();
    *out_l = 0;
    if el == 0 { return false; };
    if sa_json_kind(el) == 5 {
        *out_p = sa_json_string_ptr(el);
        *out_l = sa_json_string_len(el);
        return true;
    };
    if sa_json_kind(el) != 7 { return false; };
    let keys: [ptr; 4] = [STR_PTR("reasoningEffort"), STR_PTR("reasoning_effort"), STR_PTR("value"), STR_PTR("id")];
    let klens: [u64; 4] = [STR_LEN("reasoningEffort"), STR_LEN("reasoning_effort"), STR_LEN("value"), STR_LEN("id")];
    let k: u64 = 0;
    while k < 4 {
        let f: u64 = pm_jget(el, keys[k], klens[k]);
        if f != 0 && sa_json_kind(f) == 5 {
            *out_p = sa_json_string_ptr(f);
            *out_l = sa_json_string_len(f);
            return true;
        };
        k = k + 1;
    }
    return false;
}

fn pm_normalize_efforts(list: &PmNodeList) -> u64 {
    let out: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    if out == 0 { return 0; };
    let i: u64 = 0;
    while i < list.len {
        let cp: ptr = PTR_NULL();
        let cl: u64 = 0;
        if pm_effort_candidate(list.items[i], &cp, &cl) {
            let lo: u64 = 0;
            let hi: u64 = 0;
            pm_trim_range(cp, cl, &lo, &hi);
            let tp: ptr = PTR_NULL();
            PTR_BYTE_ADD(tp, cp, lo);
            let tl: u64 = hi - lo;
            if tl >= 1 && tl <= 64 {
                // drop lowercase == "minimal"
                let is_min: bool = false;
                if tl == 7 {
                    is_min = true;
                    let lit: ptr = STR_PTR("minimal");
                    let j: u64 = 0;
                    while j < 7 {
                        if pm_lower(pm_byte(tp, j)) != pm_byte(lit, j) { is_min = false; };
                        j = j + 1;
                    }
                };
                if !is_min {
                    // dedupe (exact, order-preserving)
                    let cnt: u64 = 0;
                    let vst: i32 = sa_json_value_count(out, &cnt);
                    let dup: bool = false;
                    let d: u64 = 0;
                    while d < cnt {
                        let ev: u64 = 0;
                        let gst: i32 = sa_json_array_get(out, d, &ev);
                        if gst == 0 && ev != 0 && sa_json_kind(ev) == 5 {
                            let evp: ptr = sa_json_string_ptr(ev);
                            if pm_eq(tp, tl, evp, sa_json_string_len(ev)) { dup = true; };
                        };
                        d = d + 1;
                    }
                    if !dup {
                        let pst: i32 = sa_json_array_push_string(out, tp, tl);
                    };
                };
            };
        };
        i = i + 1;
    }
    return out;
}

// ---- model capabilities ----
fn pm_nested(node: u64, key_p: ptr, key_l: u64) -> u64 {
    let v: u64 = pm_jget(node, key_p, key_l);
    if v != 0 && sa_json_kind(v) == 7 { return v; };
    return 0;
}

fn pm_collect_effort_values(node: u64, key_p: ptr, key_l: u64, list: &PmNodeList) -> void {
    if node == 0 { return; };
    let v: u64 = pm_jget(node, key_p, key_l);
    if v == 0 || sa_json_kind(v) != 6 { return; };
    let cnt: u64 = 0;
    let st: i32 = sa_json_value_count(v, &cnt);
    let i: u64 = 0;
    while i < cnt {
        let el: u64 = 0;
        let gst: i32 = sa_json_array_get(v, i, &el);
        if gst == 0 && el != 0 && list.len < 512 {
            list.items[list.len] = el;
            list.len = list.len + 1;
        };
        i = i + 1;
    }
}

fn pm_model_caps(entry: u64) -> u64 {
    let doc: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    if doc == 0 { return 0; };
    if entry == 0 || sa_json_kind(entry) != 7 { return doc; };
    let caps: u64 = pm_nested(entry, STR_PTR("capabilities"), STR_LEN("capabilities"));
    let meta: u64 = pm_nested(entry, STR_PTR("metadata"), STR_LEN("metadata"));
    let list = PmNodeList { items: [0u64; 512], len: 0 };
    pm_collect_effort_values(entry, STR_PTR("supportedReasoningEfforts"), STR_LEN("supportedReasoningEfforts"), &list);
    pm_collect_effort_values(entry, STR_PTR("supported_reasoning_efforts"), STR_LEN("supported_reasoning_efforts"), &list);
    pm_collect_effort_values(entry, STR_PTR("reasoningEfforts"), STR_LEN("reasoningEfforts"), &list);
    pm_collect_effort_values(entry, STR_PTR("reasoning_efforts"), STR_LEN("reasoning_efforts"), &list);
    pm_collect_effort_values(entry, STR_PTR("reasoningLevels"), STR_LEN("reasoningLevels"), &list);
    pm_collect_effort_values(entry, STR_PTR("reasoning_levels"), STR_LEN("reasoning_levels"), &list);
    pm_collect_effort_values(entry, STR_PTR("efforts"), STR_LEN("efforts"), &list);
    pm_collect_effort_values(caps, STR_PTR("supportedReasoningEfforts"), STR_LEN("supportedReasoningEfforts"), &list);
    pm_collect_effort_values(caps, STR_PTR("supported_reasoning_efforts"), STR_LEN("supported_reasoning_efforts"), &list);
    pm_collect_effort_values(caps, STR_PTR("reasoningEfforts"), STR_LEN("reasoningEfforts"), &list);
    pm_collect_effort_values(caps, STR_PTR("reasoning_efforts"), STR_LEN("reasoning_efforts"), &list);
    pm_collect_effort_values(meta, STR_PTR("supportedReasoningEfforts"), STR_LEN("supportedReasoningEfforts"), &list);
    pm_collect_effort_values(meta, STR_PTR("supported_reasoning_efforts"), STR_LEN("supported_reasoning_efforts"), &list);
    let efforts: u64 = pm_normalize_efforts(&list);
    let has_any: bool = false;
    if efforts != 0 {
        let ec: u64 = 0;
        let est: i32 = sa_json_value_count(efforts, &ec);
        if ec > 0 {
            let sst: i32 = sa_json_object_set_node(doc, STR_PTR("reasoningEfforts"), STR_LEN("reasoningEfforts"), efforts);
            has_any = true;
        } else {
            let ef: i32 = sa_json_free(efforts);
        };
    };
    let fv: f64 = 0.0;
    let has_cw: bool = false;
    if pm_first_positive(entry, STR_PTR("contextWindow"), STR_LEN("contextWindow"), &fv) { has_cw = true; };
    if !has_cw && pm_first_positive(entry, STR_PTR("context_window"), STR_LEN("context_window"), &fv) { has_cw = true; };
    if !has_cw && pm_first_positive(entry, STR_PTR("maxContextWindow"), STR_LEN("maxContextWindow"), &fv) { has_cw = true; };
    if !has_cw && pm_first_positive(entry, STR_PTR("max_context_window"), STR_LEN("max_context_window"), &fv) { has_cw = true; };
    if !has_cw && pm_first_positive(caps, STR_PTR("contextWindow"), STR_LEN("contextWindow"), &fv) { has_cw = true; };
    if !has_cw && pm_first_positive(caps, STR_PTR("context_window"), STR_LEN("context_window"), &fv) { has_cw = true; };
    if !has_cw && pm_first_positive(meta, STR_PTR("contextWindow"), STR_LEN("contextWindow"), &fv) { has_cw = true; };
    if !has_cw && pm_first_positive(meta, STR_PTR("context_window"), STR_LEN("context_window"), &fv) { has_cw = true; };
    if has_cw {
        let sst2: i32 = sa_json_object_set_i64(doc, STR_PTR("contextWindow"), STR_LEN("contextWindow"), pm_round_i64(fv));
        has_any = true;
    };
    let mv: f64 = 0.0;
    let has_mo: bool = false;
    if pm_first_positive(entry, STR_PTR("maxOutputTokens"), STR_LEN("maxOutputTokens"), &mv) { has_mo = true; };
    if !has_mo && pm_first_positive(entry, STR_PTR("max_output_tokens"), STR_LEN("max_output_tokens"), &mv) { has_mo = true; };
    if !has_mo && pm_first_positive(entry, STR_PTR("maxTokens"), STR_LEN("maxTokens"), &mv) { has_mo = true; };
    if !has_mo && pm_first_positive(entry, STR_PTR("max_tokens"), STR_LEN("max_tokens"), &mv) { has_mo = true; };
    if !has_mo && pm_first_positive(caps, STR_PTR("maxOutputTokens"), STR_LEN("maxOutputTokens"), &mv) { has_mo = true; };
    if !has_mo && pm_first_positive(caps, STR_PTR("max_output_tokens"), STR_LEN("max_output_tokens"), &mv) { has_mo = true; };
    if !has_mo && pm_first_positive(meta, STR_PTR("maxOutputTokens"), STR_LEN("maxOutputTokens"), &mv) { has_mo = true; };
    if !has_mo && pm_first_positive(meta, STR_PTR("max_output_tokens"), STR_LEN("max_output_tokens"), &mv) { has_mo = true; };
    if has_mo {
        let sst3: i32 = sa_json_object_set_i64(doc, STR_PTR("maxOutputTokens"), STR_LEN("maxOutputTokens"), pm_round_i64(mv));
        has_any = true;
    };
    if has_any {
        let sst4: i32 = sa_json_object_set_string(doc, STR_PTR("source"), STR_LEN("source"), STR_PTR("upstream"), STR_LEN("upstream"));
    };
    return doc;
}

fn pm_caps_num(doc: u64, key_p: ptr, key_l: u64, out_v: &f64) -> bool {
    if doc == 0 { return false; };
    let v: u64 = pm_jget(doc, key_p, key_l);
    if v == 0 { return false; };
    let k: u32 = sa_json_kind(v);
    if k != 2 && k != 3 { return false; };
    let ast2: i32 = sa_json_as_f64(v, out_v);
    return ast2 == 0;
}

fn pm_merge_caps(prev: u64, cur: u64) -> u64 {
    let doc: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    if doc == 0 { return 0; };
    let list = PmNodeList { items: [0u64; 512], len: 0 };
    let pe: u64 = pm_jget(prev, STR_PTR("reasoningEfforts"), STR_LEN("reasoningEfforts"));
    if pe != 0 && sa_json_kind(pe) == 6 {
        let cnt: u64 = 0;
        let st: i32 = sa_json_value_count(pe, &cnt);
        let i: u64 = 0;
        while i < cnt {
            let el: u64 = 0;
            let gst: i32 = sa_json_array_get(pe, i, &el);
            if gst == 0 && el != 0 && list.len < 512 { list.items[list.len] = el; list.len = list.len + 1; };
            i = i + 1;
        }
    };
    let ce: u64 = pm_jget(cur, STR_PTR("reasoningEfforts"), STR_LEN("reasoningEfforts"));
    if ce != 0 && sa_json_kind(ce) == 6 {
        let cnt2: u64 = 0;
        let st2: i32 = sa_json_value_count(ce, &cnt2);
        let i2: u64 = 0;
        while i2 < cnt2 {
            let el2: u64 = 0;
            let gst2: i32 = sa_json_array_get(ce, i2, &el2);
            if gst2 == 0 && el2 != 0 && list.len < 512 { list.items[list.len] = el2; list.len = list.len + 1; };
            i2 = i2 + 1;
        }
    };
    let efforts: u64 = pm_normalize_efforts(&list);
    let has_any: bool = false;
    if efforts != 0 {
        let ec: u64 = 0;
        let est: i32 = sa_json_value_count(efforts, &ec);
        if ec > 0 {
            let sst: i32 = sa_json_object_set_node(doc, STR_PTR("reasoningEfforts"), STR_LEN("reasoningEfforts"), efforts);
            has_any = true;
        } else {
            let ef: i32 = sa_json_free(efforts);
        };
    };
    let cv: f64 = 0.0;
    let has_cv: bool = pm_caps_num(cur, STR_PTR("contextWindow"), STR_LEN("contextWindow"), &cv);
    if !has_cv { has_cv = pm_caps_num(prev, STR_PTR("contextWindow"), STR_LEN("contextWindow"), &cv); };
    if has_cv {
        let sst2: i32 = sa_json_object_set_i64(doc, STR_PTR("contextWindow"), STR_LEN("contextWindow"), pm_round_i64(cv));
        has_any = true;
    };
    let mv: f64 = 0.0;
    let has_mv: bool = pm_caps_num(cur, STR_PTR("maxOutputTokens"), STR_LEN("maxOutputTokens"), &mv);
    if !has_mv { has_mv = pm_caps_num(prev, STR_PTR("maxOutputTokens"), STR_LEN("maxOutputTokens"), &mv); };
    if has_mv {
        let sst3: i32 = sa_json_object_set_i64(doc, STR_PTR("maxOutputTokens"), STR_LEN("maxOutputTokens"), pm_round_i64(mv));
        has_any = true;
    };
    if has_any {
        let sst4: i32 = sa_json_object_set_string(doc, STR_PTR("source"), STR_LEN("source"), STR_PTR("upstream"), STR_LEN("upstream"));
    };
    return doc;
}

// ---- model id ----
fn pm_model_id(entry: u64, out: &PmSmall) -> bool {
    out.len = 0;
    if entry == 0 { return false; };
    let sp: ptr = PTR_NULL();
    let sl: u64 = 0;
    if sa_json_kind(entry) == 5 {
        sp = sa_json_string_ptr(entry);
        sl = sa_json_string_len(entry);
    } else {
        if sa_json_kind(entry) != 7 { return false; };
        let keys: [ptr; 5] = [STR_PTR("id"), STR_PTR("model"), STR_PTR("name"), STR_PTR("baseModelId"), STR_PTR("displayName")];
        let klens: [u64; 5] = [STR_LEN("id"), STR_LEN("model"), STR_LEN("name"), STR_LEN("baseModelId"), STR_LEN("displayName")];
        let found: bool = false;
        let k: u64 = 0;
        while k < 5 {
            let v: u64 = pm_jget(entry, keys[k], klens[k]);
            if v != 0 && sa_json_kind(v) == 5 {
                let vp: ptr = sa_json_string_ptr(v);
                let vl: u64 = sa_json_string_len(v);
                let lo2: u64 = 0;
                let hi2: u64 = 0;
                pm_trim_range(vp, vl, &lo2, &hi2);
                if hi2 > lo2 {
                    sp = vp;
                    sl = vl;
                    found = true;
                    break;
                };
            };
            k = k + 1;
        }
        if !found { return false; };
    };
    let lo: u64 = 0;
    let hi: u64 = 0;
    pm_trim_range(sp, sl, &lo, &hi);
    if hi <= lo { return false; };
    let tp: ptr = PTR_NULL();
    PTR_BYTE_ADD(tp, sp, lo);
    let tl: u64 = hi - lo;
    // strip leading "models/"
    if tl >= 7 && pm_eq(tp, STR_LEN("models/"), STR_PTR("models/"), STR_LEN("models/")) {
        let rp: ptr = PTR_NULL();
        PTR_BYTE_ADD(rp, tp, 7);
        pm_append_small(out, rp, tl - 7);
    } else {
        pm_append_small(out, tp, tl);
    };
    return out.len > 0;
}

// ---- descriptor parsing ----
struct PmName { bytes: [u8; 512], len: u64 }
struct PmModelAcc { names: [PmName; 128], caps: [u64; 128], len: u64 }

fn pm_name_copy(src: &PmSmall, dst: &PmName) -> void {
    dst.len = 0;
    let sp: ptr = pm_small_ptr(src);
    let n: u64 = src.len;
    if n > 512 { n = 512; };
    let i: u64 = 0;
    while i < n { dst.bytes[i] = pm_byte(sp, i); i = i + 1; }
    dst.len = n;
}

fn pm_collect_entries(node: u64, list: &PmNodeList) -> void {
    if node == 0 || sa_json_kind(node) != 6 { return; };
    let cnt: u64 = 0;
    let st: i32 = sa_json_value_count(node, &cnt);
    let i: u64 = 0;
    while i < cnt {
        let el: u64 = 0;
        let gst: i32 = sa_json_array_get(node, i, &el);
        if gst == 0 && el != 0 && list.len < 512 {
            list.items[list.len] = el;
            list.len = list.len + 1;
        };
        i = i + 1;
    }
}

fn parseModelDescriptors(body_ptr: ptr, body_len: u64, out_json_ptr: ptr, out_cap: u64) -> u64 {
    let doc: u64 = pm_parse(body_ptr, body_len);
    if doc == 0 {
        // fallback: first '[' .. last ']' substring re-parse
        let first: u64 = body_len;
        let last: u64 = 0;
        let has_last: bool = false;
        let i: u64 = 0;
        while i < body_len {
            let c: u8 = pm_byte(body_ptr, i);
            if c == 91 && first >= body_len { first = i; };
            if c == 93 { last = i; has_last = true; };
            i = i + 1;
        }
        if first < body_len && has_last && last > first {
            let sp: ptr = PTR_NULL();
            PTR_BYTE_ADD(sp, body_ptr, first);
            doc = pm_parse(sp, last - first + 1);
        };
    };
    let outarr: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    if doc == 0 || outarr == 0 {
        if outarr != 0 { let f0: i32 = sa_json_free(outarr); };
        PTR_COPY_BYTES(out_json_ptr, STR_PTR("[]"), 2);
        return 2;
    };
    let entries = PmNodeList { items: [0u64; 512], len: 0 };
    if sa_json_kind(doc) == 6 {
        pm_collect_entries(doc, &entries);
    } else {
        if sa_json_kind(doc) == 7 {
            let data: u64 = pm_jget(doc, STR_PTR("data"), STR_LEN("data"));
            pm_collect_entries(data, &entries);
            let models: u64 = pm_jget(doc, STR_PTR("models"), STR_LEN("models"));
            pm_collect_entries(models, &entries);
            if data != 0 && sa_json_kind(data) == 7 {
                let nested: u64 = pm_jget(data, STR_PTR("models"), STR_LEN("models"));
                pm_collect_entries(nested, &entries);
            };
        };
    };
    // byModel map: first-seen order, merge on duplicate
    let acc = PmModelAcc { names: [PmName { bytes: [0u8; 512], len: 0 }; 128], caps: [0u64; 128], len: 0 };
    let e: u64 = 0;
    while e < entries.len {
        let entry: u64 = entries.items[e];
        let name = PmSmall { bytes: [0u8; 8192], len: 0 };
        if pm_model_id(entry, &name) {
            let caps: u64 = pm_model_caps(entry);
            let np: ptr = pm_small_ptr(&name);
            let idx: u64 = acc.len;
            let j: u64 = 0;
            while j < acc.len {
                let an: ptr = PTR_NULL();
                PTR_BYTE_ADD(an, &acc.names[j].bytes, 0);
                if pm_eq(np, name.len, an, acc.names[j].len) { idx = j; break; };
                j = j + 1;
            }
            if idx < acc.len {
                let merged: u64 = pm_merge_caps(acc.caps[idx], caps);
                let f1: i32 = sa_json_free(acc.caps[idx]);
                let f2: i32 = sa_json_free(caps);
                acc.caps[idx] = merged;
            } else {
                if acc.len < 128 {
                    pm_name_copy(&name, &acc.names[acc.len]);
                    acc.caps[acc.len] = caps;
                    acc.len = acc.len + 1;
                } else {
                    let f3: i32 = sa_json_free(caps);
                };
            };
        };
        e = e + 1;
    }
    let a: u64 = 0;
    while a < acc.len {
        let obj: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
        if obj != 0 {
            let an2: ptr = PTR_NULL();
            PTR_BYTE_ADD(an2, &acc.names[a].bytes, 0);
            let sst: i32 = sa_json_object_set_string(obj, STR_PTR("model"), STR_LEN("model"), an2, acc.names[a].len);
            let cc: u64 = 0;
            let cst: i32 = sa_json_value_count(acc.caps[a], &cc);
            if cc > 0 {
                let sst2: i32 = sa_json_object_set_node(obj, STR_PTR("capabilities"), STR_LEN("capabilities"), acc.caps[a]);
            } else {
                let f4: i32 = sa_json_free(acc.caps[a]);
            };
            let pst: i32 = sa_json_array_push_node(outarr, obj);
        };
        a = a + 1;
    }
    let text = PmText { bytes: [0u8; 65536], len: 0 };
    pm_doc_to_text(outarr, &text);
    let f5: i32 = sa_json_free(outarr);
    let f6: i32 = sa_json_free(doc);
    let n: u64 = text.len;
    if n > out_cap { n = out_cap; };
    let tp: ptr = pm_text_ptr(&text);
    PTR_COPY_BYTES(out_json_ptr, tp, n);
    return n;
}

// Landed text-form wrappers (the node-form internals above carry
// the semantics).
fn modelId(entry_json_ptr: ptr, entry_json_len: u64, out_ptr: ptr, out_cap: u64, out_found: &bool) -> u64 {
    *out_found = false;
    let doc: u64 = pm_parse(entry_json_ptr, entry_json_len);
    if doc == 0 { return 0; };
    let name = PmSmall { bytes: [0u8; 8192], len: 0 };
    let ok: bool = pm_model_id(doc, &name);
    let f: i32 = sa_json_free(doc);
    if !ok { return 0; };
    *out_found = true;
    let n: u64 = name.len;
    if n > out_cap { n = out_cap; };
    PTR_COPY_BYTES(out_ptr, pm_small_ptr(&name), n);
    return n;
}

fn modelCapabilities(entry_json_ptr: ptr, entry_json_len: u64, out_json_ptr: ptr, out_cap: u64) -> u64 {
    let doc: u64 = pm_parse(entry_json_ptr, entry_json_len);
    let caps: u64 = pm_model_caps(doc);
    if doc != 0 { let f: i32 = sa_json_free(doc); };
    if caps == 0 {
        PTR_COPY_BYTES(out_json_ptr, STR_PTR("{}"), 2);
        return 2;
    };
    let text = PmText { bytes: [0u8; 65536], len: 0 };
    pm_doc_to_text(caps, &text);
    let f2: i32 = sa_json_free(caps);
    let n: u64 = text.len;
    if n > out_cap { n = out_cap; };
    PTR_COPY_BYTES(out_json_ptr, pm_text_ptr(&text), n);
    return n;
}

fn nestedRecord(value_json_ptr: ptr, value_json_len: u64, out_json_ptr: ptr, out_cap: u64) -> u64 {
    let doc: u64 = pm_parse(value_json_ptr, value_json_len);
    if doc == 0 || sa_json_kind(doc) != 7 {
        if doc != 0 { let f: i32 = sa_json_free(doc); };
        PTR_COPY_BYTES(out_json_ptr, STR_PTR("{}"), 2);
        return 2;
    };
    let text = PmText { bytes: [0u8; 65536], len: 0 };
    pm_doc_to_text(doc, &text);
    let f2: i32 = sa_json_free(doc);
    let n: u64 = text.len;
    if n > out_cap { n = out_cap; };
    PTR_COPY_BYTES(out_json_ptr, pm_text_ptr(&text), n);
    return n;
}

fn mergeParsedCapabilities(prev_json_ptr: ptr, prev_json_len: u64, has_prev: bool, cur_json_ptr: ptr, cur_json_len: u64, out_json_ptr: ptr, out_cap: u64) -> u64 {
    let prev: u64 = 0;
    if has_prev { prev = pm_parse(prev_json_ptr, prev_json_len); };
    let cur: u64 = pm_parse(cur_json_ptr, cur_json_len);
    let merged: u64 = pm_merge_caps(prev, cur);
    if prev != 0 { let f1: i32 = sa_json_free(prev); };
    if cur != 0 { let f2: i32 = sa_json_free(cur); };
    if merged == 0 {
        PTR_COPY_BYTES(out_json_ptr, STR_PTR("{}"), 2);
        return 2;
    };
    let text = PmText { bytes: [0u8; 65536], len: 0 };
    pm_doc_to_text(merged, &text);
    let f3: i32 = sa_json_free(merged);
    let n: u64 = text.len;
    if n > out_cap { n = out_cap; };
    PTR_COPY_BYTES(out_json_ptr, pm_text_ptr(&text), n);
    return n;
}

// localeCompare sensitivity "base" ≈ ASCII case-fold comparison
// (full ICU case folding is not available in sa_std — registered).
fn pm_cmp_base(a: ptr, al: u64, b: ptr, bl: u64) -> i64 {
    let n: u64 = al;
    if bl < n { n = bl; };
    let i: u64 = 0;
    while i < n {
        let ca: u8 = pm_lower(pm_byte(a, i));
        let cb: u8 = pm_lower(pm_byte(b, i));
        if ca < cb { return -1; };
        if ca > cb { return 1; };
        i = i + 1;
    }
    if al < bl { return -1; };
    if al > bl { return 1; };
    return 0;
}

fn uniqueSorted(models_json_ptr: ptr, models_json_len: u64, out_json_ptr: ptr, out_cap: u64) -> u64 {
    let doc: u64 = pm_parse(models_json_ptr, models_json_len);
    let acc = PmModelAcc { names: [PmName { bytes: [0u8; 512], len: 0 }; 128], caps: [0u64; 128], len: 0 };
    if doc != 0 && sa_json_kind(doc) == 6 {
        let cnt: u64 = 0;
        let st: i32 = sa_json_value_count(doc, &cnt);
        let i: u64 = 0;
        while i < cnt {
            let el: u64 = 0;
            let gst: i32 = sa_json_array_get(doc, i, &el);
            if gst == 0 && el != 0 && sa_json_kind(el) == 5 {
                let sp: ptr = sa_json_string_ptr(el);
                let sl: u64 = sa_json_string_len(el);
                let lo: u64 = 0;
                let hi: u64 = 0;
                pm_trim_range(sp, sl, &lo, &hi);
                if hi > lo && acc.len < 128 {
                    let tp: ptr = PTR_NULL();
                    PTR_BYTE_ADD(tp, sp, lo);
                    let tl: u64 = hi - lo;
                    let dup: bool = false;
                    let j: u64 = 0;
                    while j < acc.len {
                        let an: ptr = PTR_NULL();
                        PTR_BYTE_ADD(an, &acc.names[j].bytes, 0);
                        if pm_eq(tp, tl, an, acc.names[j].len) { dup = true; break; };
                        j = j + 1;
                    }
                    if !dup {
                        let small = PmSmall { bytes: [0u8; 8192], len: 0 };
                        pm_append_small(&small, tp, tl);
                        pm_name_copy(&small, &acc.names[acc.len]);
                        acc.len = acc.len + 1;
                    };
                };
            };
            i = i + 1;
        }
    };
    if doc != 0 { let f0: i32 = sa_json_free(doc); };
    // stable insertion sort by folded comparison
    let s: u64 = 1;
    while s < acc.len {
        let key = PmName { bytes: [0u8; 512], len: 0 };
        let srcp: ptr = PTR_NULL();
        PTR_BYTE_ADD(srcp, &acc.names[s].bytes, 0);
        let ki: u64 = 0;
        while ki < acc.names[s].len { key.bytes[ki] = pm_byte(srcp, ki); ki = ki + 1; }
        key.len = acc.names[s].len;
        let j2: u64 = s;
        while j2 > 0 {
            let ap: ptr = PTR_NULL();
            PTR_BYTE_ADD(ap, &acc.names[j2 - 1].bytes, 0);
            let kp: ptr = PTR_NULL();
            PTR_BYTE_ADD(kp, &key.bytes, 0);
            if pm_cmp_base(ap, acc.names[j2 - 1].len, kp, key.len) > 0 {
                // shift right
                let dp: ptr = PTR_NULL();
                PTR_BYTE_ADD(dp, &acc.names[j2].bytes, 0);
                let mv: u64 = 0;
                while mv < acc.names[j2 - 1].len { acc.names[j2].bytes[mv] = pm_byte(ap, mv); mv = mv + 1; }
                acc.names[j2].len = acc.names[j2 - 1].len;
                j2 = j2 - 1;
            } else { break; };
        }
        let kp2: ptr = PTR_NULL();
        PTR_BYTE_ADD(kp2, &key.bytes, 0);
        let wi: u64 = 0;
        while wi < key.len { acc.names[j2].bytes[wi] = pm_byte(kp2, wi); wi = wi + 1; }
        acc.names[j2].len = key.len;
        s = s + 1;
    }
    let outarr: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    if outarr == 0 {
        PTR_COPY_BYTES(out_json_ptr, STR_PTR("[]"), 2);
        return 2;
    };
    let a: u64 = 0;
    while a < acc.len {
        let an: ptr = PTR_NULL();
        PTR_BYTE_ADD(an, &acc.names[a].bytes, 0);
        let pst: i32 = sa_json_array_push_string(outarr, an, acc.names[a].len);
        a = a + 1;
    }
    let text = PmText { bytes: [0u8; 65536], len: 0 };
    pm_doc_to_text(outarr, &text);
    let f1: i32 = sa_json_free(outarr);
    let n: u64 = text.len;
    if n > out_cap { n = out_cap; };
    PTR_COPY_BYTES(out_json_ptr, pm_text_ptr(&text), n);
    return n;
}

struct EndpointHeaders { endpoint: [u8; 4096], endpoint_len: u64, headers: Headers }

// joinRelayEndpoint local replica (gateway semantics: trim base,
// strip trailing "/", trim path, absolute-URL passthrough, ensure
// leading "/", /v1 + /v1beta merge rules).
fn pm_join_relay_endpoint(base_p: ptr, base_l: u64, path_p: ptr, path_l: u64, out: &PmText) -> void {
    let base = PmSmall { bytes: [0u8; 8192], len: 0 };
    let lo: u64 = 0;
    let hi: u64 = 0;
    pm_trim_range(base_p, base_l, &lo, &hi);
    let bp0: ptr = PTR_NULL();
    PTR_BYTE_ADD(bp0, base_p, lo);
    pm_append_small(&base, bp0, hi - lo);
    while base.len > 0 {
        let bp1: ptr = pm_small_ptr(&base);
        if pm_byte(bp1, base.len - 1) == 47 { base.len = base.len - 1; } else { break; };
    }
    let suffix = PmSmall { bytes: [0u8; 8192], len: 0 };
    pm_trim_range(path_p, path_l, &lo, &hi);
    let sp0: ptr = PTR_NULL();
    PTR_BYTE_ADD(sp0, path_p, lo);
    pm_append_small(&suffix, sp0, hi - lo);
    let sp: ptr = pm_small_ptr(&suffix);
    if pm_starts_with_ci(sp, suffix.len, STR_PTR("http://"), STR_LEN("http://")) || pm_starts_with_ci(sp, suffix.len, STR_PTR("https://"), STR_LEN("https://")) {
        out.len = 0;
        pm_append(out, sp, suffix.len);
        return;
    };
    if suffix.len == 0 || pm_byte(sp, 0) != 47 {
        let with_slash = PmSmall { bytes: [0u8; 8192], len: 0 };
        pm_append_small(&with_slash, STR_PTR("/"), STR_LEN("/"));
        pm_append_small(&with_slash, sp, suffix.len);
        pm_small_copy(&with_slash, &suffix);
        sp = pm_small_ptr(&suffix);
    };
    let bp: ptr = pm_small_ptr(&base);
    let base_v1: bool = pm_ends_with(bp, base.len, STR_PTR("/v1"), STR_LEN("/v1"));
    let base_v1beta: bool = pm_ends_with(bp, base.len, STR_PTR("/v1beta"), STR_LEN("/v1beta"));
    out.len = 0;
    if base_v1 && pm_starts_with_ci(sp, suffix.len, STR_PTR("/v1beta/"), STR_LEN("/v1beta")) {
        pm_append(out, bp, base.len - 3);
        pm_append(out, sp, suffix.len);
        return;
    };
    if base_v1 && pm_starts_with_ci(sp, suffix.len, STR_PTR("/v1/"), STR_LEN("/v1/")) {
        pm_append(out, bp, base.len);
        let rest: ptr = PTR_NULL();
        PTR_BYTE_ADD(rest, sp, 3);
        pm_append(out, rest, suffix.len - 3);
        return;
    };
    if base_v1beta && pm_starts_with_ci(sp, suffix.len, STR_PTR("/v1beta/"), STR_LEN("/v1beta")) {
        pm_append(out, bp, base.len);
        let rest2: ptr = PTR_NULL();
        PTR_BYTE_ADD(rest2, sp, 7);
        pm_append(out, rest2, suffix.len - 7);
        return;
    };
    pm_append(out, bp, base.len);
    pm_append(out, sp, suffix.len);
}

// encodeURIComponent: unreserved [A-Za-z0-9-_.!~*'()] pass, rest %XX
fn pm_uri_encode(p: ptr, len: u64, out: &PmText) -> void {
    let hex: ptr = STR_PTR("0123456789ABCDEF");
    let i: u64 = 0;
    while i < len {
        let c: u8 = pm_byte(p, i);
        let ok: bool = (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 45 || c == 95 || c == 46 || c == 33 || c == 126 || c == 42 || c == 39 || c == 40 || c == 41;
        if ok {
            let one: [u8; 1] = [c; 1];
            let op: ptr = PTR_NULL();
            PTR_BYTE_ADD(op, &one, 0);
            pm_append(out, op, 1);
        } else {
            let h1: [u8; 1] = [pm_byte(hex, (c / 16) as u64); 1];
            let h2: [u8; 1] = [pm_byte(hex, (c % 16) as u64); 1];
            pm_append(out, STR_PTR("%"), STR_LEN("%"));
            let hp1: ptr = PTR_NULL();
            PTR_BYTE_ADD(hp1, &h1, 0);
            pm_append(out, hp1, 1);
            let hp2: ptr = PTR_NULL();
            PTR_BYTE_ADD(hp2, &h2, 0);
            pm_append(out, hp2, 1);
        };
        i = i + 1;
    }
}

fn pm_replace_all(hay: &PmText, needle: ptr, needle_len: u64, repl: ptr, repl_len: u64, out: &PmText) -> void {
    out.len = 0;
    let hp: ptr = pm_text_ptr(hay);
    let i: u64 = 0;
    while i < hay.len {
        let is_match: bool = false;
        if needle_len > 0 && i + needle_len <= hay.len {
            is_match = true;
            let j: u64 = 0;
            while j < needle_len {
                if pm_byte(hp, i + j) != pm_byte(needle, j) { is_match = false; };
                j = j + 1;
            }
        };
        if is_match {
            pm_append(out, repl, repl_len);
            i = i + needle_len;
        } else {
            let one: [u8; 1] = [pm_byte(hp, i); 1];
            let op: ptr = PTR_NULL();
            PTR_BYTE_ADD(op, &one, 0);
            pm_append(out, op, 1);
            i = i + 1;
        };
    }
}

// ---- result assembly ----
fn normalizeTimeout(value: i64, has_value: bool, is_finite: bool, fallback: i64) -> i64 {
    if !has_value { return fallback; };
    if !is_finite { return fallback; };
    if value == 0 { return fallback; };
    if value < 1000 { return 1000; };
    if value > 120000 { return 120000; };
    return value;
}

fn providerTestResult(ok: bool, model_ptr: ptr, model_len: u64, prompt_ptr: ptr, prompt_len: u64, msg_ptr: ptr, msg_len: u64, startedAt: i64, protocol_ptr: ptr, protocol_len: u64, endpoint_ptr: ptr, endpoint_len: u64, has_endpoint: bool, statusCode: i64, has_statusCode: bool, out: &TestProviderResult) -> i32 {
    out.ok = ok;
    pm_tr_set_model(out, model_ptr, model_len);
    pm_tr_set_prompt(out, prompt_ptr, prompt_len);
    pm_tr_set_message(out, msg_ptr, msg_len);
    out.endpoint_len = 0;
    out.has_endpoint = false;
    if has_endpoint { pm_tr_set_endpoint(out, endpoint_ptr, endpoint_len); };
    out.statusCode = statusCode;
    out.has_statusCode = has_statusCode;
    out.elapsedMs = sa_time_unix_ms() - startedAt;
    return 0;
}

// ---- content extractors ----
fn pm_extract_join_texts(doc: u64, arr: u64, out: &PmText) -> void {
    // shared shape for anthropic/gemini: array of records with .text
    out.len = 0;
    if arr == 0 || sa_json_kind(arr) != 6 { return; };
    let cnt: u64 = 0;
    let st: i32 = sa_json_value_count(arr, &cnt);
    let first: bool = true;
    let i: u64 = 0;
    while i < cnt {
        let el: u64 = 0;
        let gst: i32 = sa_json_array_get(arr, i, &el);
        if gst == 0 && el != 0 && sa_json_kind(el) == 7 {
            let t: u64 = pm_jget(el, STR_PTR("text"), STR_LEN("text"));
            if t != 0 && sa_json_kind(t) == 5 {
                let tp: ptr = sa_json_string_ptr(t);
                let tl: u64 = sa_json_string_len(t);
                let lo: u64 = 0;
                let hi: u64 = 0;
                pm_trim_range(tp, tl, &lo, &hi);
                if hi > lo {
                    if !first { pm_append(out, STR_PTR("\n"), STR_LEN("\n")); };
                    first = false;
                    let rp: ptr = PTR_NULL();
                    PTR_BYTE_ADD(rp, tp, lo);
                    pm_append(out, rp, hi - lo);
                };
            };
        };
        i = i + 1;
    }
    // final .trim() of the joined string
    let lo2: u64 = 0;
    let hi2: u64 = 0;
    let op: ptr = pm_text_ptr(out);
    pm_trim_range(op, out.len, &lo2, &hi2);
    if lo2 > 0 {
        let shifted = PmText { bytes: [0u8; 65536], len: 0 };
        let rp2: ptr = PTR_NULL();
        PTR_BYTE_ADD(rp2, op, lo2);
        pm_append(&shifted, rp2, hi2 - lo2);
        out.len = 0;
        pm_append(out, pm_text_ptr(&shifted), shifted.len);
    } else {
        out.len = hi2;
    };
}

fn extractResponsesContent(body_ptr: ptr, body_len: u64, out_ptr: ptr, out_cap: u64) -> u64 {
    let out = PmText { bytes: [0u8; 65536], len: 0 };
    let doc: u64 = pm_parse(body_ptr, body_len);
    if doc != 0 {
        let ot: u64 = pm_jget(doc, STR_PTR("output_text"), STR_LEN("output_text"));
        let done: bool = false;
        if ot != 0 && sa_json_kind(ot) == 5 {
            let tp: ptr = sa_json_string_ptr(ot);
            let tl: u64 = sa_json_string_len(ot);
            let lo: u64 = 0;
            let hi: u64 = 0;
            pm_trim_range(tp, tl, &lo, &hi);
            if hi > lo {
                let rp: ptr = PTR_NULL();
                PTR_BYTE_ADD(rp, tp, lo);
                pm_append(&out, rp, hi - lo);
                done = true;
            };
        };
        if !done {
            let output: u64 = pm_jget(doc, STR_PTR("output"), STR_LEN("output"));
            if output != 0 && sa_json_kind(output) == 6 {
                let parts = PmText { bytes: [0u8; 65536], len: 0 };
                let cnt: u64 = 0;
                let st: i32 = sa_json_value_count(output, &cnt);
                let first: bool = true;
                let i: u64 = 0;
                while i < cnt {
                    let item: u64 = 0;
                    let gst: i32 = sa_json_array_get(output, i, &item);
                    if gst == 0 && item != 0 && sa_json_kind(item) == 7 {
                        let dt: u64 = pm_jget(item, STR_PTR("text"), STR_LEN("text"));
                        if dt != 0 && sa_json_kind(dt) == 5 {
                            let tp2: ptr = sa_json_string_ptr(dt);
                            let tl2: u64 = sa_json_string_len(dt);
                            let lo3: u64 = 0;
                            let hi3: u64 = 0;
                            pm_trim_range(tp2, tl2, &lo3, &hi3);
                            if hi3 > lo3 {
                                if !first { pm_append(&parts, STR_PTR("\n"), STR_LEN("\n")); };
                                first = false;
                                let rp2: ptr = PTR_NULL();
                                PTR_BYTE_ADD(rp2, tp2, lo3);
                                pm_append(&parts, rp2, hi3 - lo3);
                            };
                        };
                        let content: u64 = pm_jget(item, STR_PTR("content"), STR_LEN("content"));
                        if content != 0 && sa_json_kind(content) == 6 {
                            let cc: u64 = 0;
                            let cst: i32 = sa_json_value_count(content, &cc);
                            let j: u64 = 0;
                            while j < cc {
                                let part: u64 = 0;
                                let gst2: i32 = sa_json_array_get(content, j, &part);
                                if gst2 == 0 && part != 0 && sa_json_kind(part) == 7 {
                                    let pt: u64 = pm_jget(part, STR_PTR("text"), STR_LEN("text"));
                                    if pt != 0 && sa_json_kind(pt) == 5 {
                                        let tp3: ptr = sa_json_string_ptr(pt);
                                        let tl3: u64 = sa_json_string_len(pt);
                                        let lo4: u64 = 0;
                                        let hi4: u64 = 0;
                                        pm_trim_range(tp3, tl3, &lo4, &hi4);
                                        if hi4 > lo4 {
                                            if !first { pm_append(&parts, STR_PTR("\n"), STR_LEN("\n")); };
                                            first = false;
                                            let rp3: ptr = PTR_NULL();
                                            PTR_BYTE_ADD(rp3, tp3, lo4);
                                            pm_append(&parts, rp3, hi4 - lo4);
                                        };
                                    };
                                };
                                j = j + 1;
                            }
                        };
                    };
                    i = i + 1;
                }
                if parts.len > 0 { pm_append(&out, pm_text_ptr(&parts), parts.len); };
            };
        };
        let f: i32 = sa_json_free(doc);
    };
    let n: u64 = out.len;
    if n > out_cap { n = out_cap; };
    PTR_COPY_BYTES(out_ptr, pm_text_ptr(&out), n);
    return n;
}

fn extractChatContent(body_ptr: ptr, body_len: u64, out_ptr: ptr, out_cap: u64) -> u64 {
    let out = PmText { bytes: [0u8; 65536], len: 0 };
    let doc: u64 = pm_parse(body_ptr, body_len);
    let found: bool = false;
    if doc != 0 {
        let choices: u64 = pm_jget(doc, STR_PTR("choices"), STR_LEN("choices"));
        if choices != 0 && sa_json_kind(choices) == 6 {
            let cnt: u64 = 0;
            let st: i32 = sa_json_value_count(choices, &cnt);
            let i: u64 = 0;
            while i < cnt && !found {
                let ch: u64 = 0;
                let gst: i32 = sa_json_array_get(choices, i, &ch);
                if gst == 0 && ch != 0 && sa_json_kind(ch) == 7 {
                    let msg: u64 = pm_jget(ch, STR_PTR("message"), STR_LEN("message"));
                    if msg != 0 && sa_json_kind(msg) == 7 {
                        let c: u64 = pm_jget(msg, STR_PTR("content"), STR_LEN("content"));
                        if c != 0 && sa_json_kind(c) == 5 {
                            let tp: ptr = sa_json_string_ptr(c);
                            let tl: u64 = sa_json_string_len(c);
                            let lo: u64 = 0;
                            let hi: u64 = 0;
                            pm_trim_range(tp, tl, &lo, &hi);
                            if hi > lo {
                                let rp: ptr = PTR_NULL();
                                PTR_BYTE_ADD(rp, tp, lo);
                                pm_append(&out, rp, hi - lo);
                                found = true;
                            };
                        };
                    };
                    if !found {
                        let t: u64 = pm_jget(ch, STR_PTR("text"), STR_LEN("text"));
                        if t != 0 && sa_json_kind(t) == 5 {
                            let tp2: ptr = sa_json_string_ptr(t);
                            let tl2: u64 = sa_json_string_len(t);
                            let lo2: u64 = 0;
                            let hi2: u64 = 0;
                            pm_trim_range(tp2, tl2, &lo2, &hi2);
                            if hi2 > lo2 {
                                let rp2: ptr = PTR_NULL();
                                PTR_BYTE_ADD(rp2, tp2, lo2);
                                pm_append(&out, rp2, hi2 - lo2);
                                found = true;
                            };
                        };
                    };
                };
                i = i + 1;
            }
        };
        if !found {
            let ot: u64 = pm_jget(doc, STR_PTR("output_text"), STR_LEN("output_text"));
            if ot != 0 && sa_json_kind(ot) == 5 {
                let tp3: ptr = sa_json_string_ptr(ot);
                let tl3: u64 = sa_json_string_len(ot);
                let lo3: u64 = 0;
                let hi3: u64 = 0;
                pm_trim_range(tp3, tl3, &lo3, &hi3);
                if hi3 > lo3 {
                    let rp3: ptr = PTR_NULL();
                    PTR_BYTE_ADD(rp3, tp3, lo3);
                    pm_append(&out, rp3, hi3 - lo3);
                    found = true;
                };
            };
        };
        let f: i32 = sa_json_free(doc);
    };
    if !found {
        // TS: fallthrough AND catch both land on bodyText.trim()
        let lo4: u64 = 0;
        let hi4: u64 = 0;
        pm_trim_range(body_ptr, body_len, &lo4, &hi4);
        let rp4: ptr = PTR_NULL();
        PTR_BYTE_ADD(rp4, body_ptr, lo4);
        out.len = 0;
        pm_append(&out, rp4, hi4 - lo4);
    };
    let n: u64 = out.len;
    if n > out_cap { n = out_cap; };
    PTR_COPY_BYTES(out_ptr, pm_text_ptr(&out), n);
    return n;
}

fn extractAnthropicContent(body_ptr: ptr, body_len: u64, out_ptr: ptr, out_cap: u64) -> u64 {
    let out = PmText { bytes: [0u8; 65536], len: 0 };
    let doc: u64 = pm_parse(body_ptr, body_len);
    if doc != 0 {
        let content: u64 = pm_jget(doc, STR_PTR("content"), STR_LEN("content"));
        pm_extract_join_texts(doc, content, &out);
        let f: i32 = sa_json_free(doc);
    };
    let n: u64 = out.len;
    if n > out_cap { n = out_cap; };
    PTR_COPY_BYTES(out_ptr, pm_text_ptr(&out), n);
    return n;
}

fn extractGeminiContent(body_ptr: ptr, body_len: u64, out_ptr: ptr, out_cap: u64) -> u64 {
    let out = PmText { bytes: [0u8; 65536], len: 0 };
    let doc: u64 = pm_parse(body_ptr, body_len);
    if doc != 0 {
        let cands: u64 = pm_jget(doc, STR_PTR("candidates"), STR_LEN("candidates"));
        if cands != 0 && sa_json_kind(cands) == 6 {
            let cand: u64 = 0;
            let gst: i32 = sa_json_array_get(cands, 0, &cand);
            if gst == 0 && cand != 0 && sa_json_kind(cand) == 7 {
                let content: u64 = pm_jget(cand, STR_PTR("content"), STR_LEN("content"));
                if content != 0 && sa_json_kind(content) == 7 {
                    let parts: u64 = pm_jget(content, STR_PTR("parts"), STR_LEN("parts"));
                    pm_extract_join_texts(doc, parts, &out);
                };
            };
        };
        let f: i32 = sa_json_free(doc);
    };
    let n: u64 = out.len;
    if n > out_cap { n = out_cap; };
    PTR_COPY_BYTES(out_ptr, pm_text_ptr(&out), n);
    return n;
}

fn extractErrorMessage(body_ptr: ptr, body_len: u64, out_ptr: ptr, out_cap: u64) -> u64 {
    let out = PmText { bytes: [0u8; 65536], len: 0 };
    let doc: u64 = pm_parse(body_ptr, body_len);
    let done: bool = false;
    if doc != 0 {
        let err: u64 = pm_jget(doc, STR_PTR("error"), STR_LEN("error"));
        if err != 0 && sa_json_kind(err) == 5 {
            let erp: ptr = sa_json_string_ptr(err);
            pm_append(&out, erp, sa_json_string_len(err));
            done = true;
        };
        if !done && err != 0 && sa_json_kind(err) == 7 {
            let m: u64 = pm_jget(err, STR_PTR("message"), STR_LEN("message"));
            if m != 0 && sa_json_kind(m) == 5 {
                let mp2: ptr = sa_json_string_ptr(m);
                pm_append(&out, mp2, sa_json_string_len(m));
                done = true;
            };
        };
        let f: i32 = sa_json_free(doc);
    };
    if !done {
        pm_append(&out, body_ptr, body_len);
    };
    // slice(0, 240) — bytes here (TS: UTF-16 units; registered)
    let n: u64 = out.len;
    if n > 240 { n = 240; };
    if n > out_cap { n = out_cap; };
    PTR_COPY_BYTES(out_ptr, pm_text_ptr(&out), n);
    return n;
}

// ---- fetchProviderModels ----
fn fetchProviderModels(input: &FetchProviderModelsInput, out: &FetchProviderModelsResult) -> i32 {
    out.models_json_len = 0;
    out.modelCapabilities_json_len = 0;
    out.has_capabilities = false;
    out.error_len = 0;
    out.has_error = false;
    out.endpoint_len = 0;
    out.has_endpoint = false;
    let base_raw: ptr = PTR_NULL();
    PTR_BYTE_ADD(base_raw, &input.baseUrl, 0);
    let base = PmSmall { bytes: [0u8; 8192], len: 0 };
    let blo: u64 = 0;
    let bhi: u64 = 0;
    pm_trim_range(base_raw, input.baseUrl_len, &blo, &bhi);
    let bp0: ptr = PTR_NULL();
    PTR_BYTE_ADD(bp0, base_raw, blo);
    pm_append_small(&base, bp0, bhi - blo);
    let key = PmSmall { bytes: [0u8; 8192], len: 0 };
    if input.has_apiKey {
        let key_raw: ptr = PTR_NULL();
        PTR_BYTE_ADD(key_raw, &input.apiKey, 0);
        let klo: u64 = 0;
        let khi: u64 = 0;
        pm_trim_range(key_raw, input.apiKey_len, &klo, &khi);
        let kp0: ptr = PTR_NULL();
        PTR_BYTE_ADD(kp0, key_raw, klo);
        pm_append_small(&key, kp0, khi - klo);
    };
    let kind = PmSmall { bytes: [0u8; 8192], len: 0 };
    let proto_p: ptr = PTR_NULL();
    PTR_BYTE_ADD(proto_p, &input.protocol, 0);
    let kind_in_p: ptr = PTR_NULL();
    PTR_BYTE_ADD(kind_in_p, &input.kind, 0);
    let kind_out_p: ptr = PTR_NULL();
    PTR_BYTE_ADD(kind_out_p, &kind.bytes, 0);
    kind.len = protocolKind(proto_p, input.protocol_len, input.has_protocol, kind_in_p, input.kind_len, input.has_kind, kind_out_p, 8192);
    pm_fr_set_models(out, STR_PTR("[]"), STR_LEN("[]"));
    if base.len == 0 {
        pm_fr_set_error(out, STR_PTR("Base URL is required"), STR_LEN("Base URL is required"));
        return 0;
    };
    let prep = EndpointHeaders { endpoint: [0u8; 4096], endpoint_len: 0, headers: Headers { buf: [0u8; 8192], len: 0 } };
    let kind_p: ptr = pm_small_ptr(&kind);
    let base_p: ptr = pm_small_ptr(&base);
    let pst: i32 = prepareModelsEndpoint(kind_p, kind.len, base_p, base.len, &prep);
    let ep: ptr = PTR_NULL();
    PTR_BYTE_ADD(ep, &prep.endpoint, 0);
    // request endpoint (query auth applied)
    let req_ep = PmText { bytes: [0u8; 65536], len: 0 };
    let req_ep_p: ptr = PTR_NULL();
    PTR_BYTE_ADD(req_ep_p, &req_ep.bytes, 0);
    let auth_p: ptr = PTR_NULL();
    PTR_BYTE_ADD(auth_p, &input.authType, 0);
    req_ep.len = applyProtocolQueryAuth(ep, prep.endpoint_len, proto_p, input.protocol_len, input.has_protocol, auth_p, input.authType_len, input.has_authType, pm_small_ptr(&key), key.len, req_ep_p, 65536);
    if key.len > 0 {
        if input.has_protocol {
            let ast: i32 = applyProtocolAuthHeaders(&prep.headers, proto_p, input.protocol_len, auth_p, input.authType_len, input.has_authType, pm_small_ptr(&key), key.len);
        } else {
            let ast2: i32 = applyProviderAuthHeaders(&prep.headers, kind_p, kind.len, base_p, base.len, pm_small_ptr(&key), key.len);
        };
    };
    let status: i64 = 0;
    let body = PmText { bytes: [0u8; 65536], len: 0 };
    let timed_out: bool = false;
    let failed: bool = false;
    pm_http(1, req_ep_p, req_ep.len, &prep.headers, PTR_NULL(), 0, false, FETCH_TIMEOUT_MS(), &status, &body, &timed_out, &failed);
    if failed {
        pm_fr_set_endpoint(out, ep, prep.endpoint_len);
        let msg = PmText { bytes: [0u8; 65536], len: 0 };
        if timed_out {
            pm_append(&msg, STR_PTR("Timed out fetching models from "), STR_LEN("Timed out fetching models from "));
            pm_append(&msg, ep, prep.endpoint_len);
        } else {
            pm_append(&msg, STR_PTR("Failed to fetch models: fetch failed"), STR_LEN("Failed to fetch models: fetch failed"));
        };
        pm_fr_set_error(out, pm_text_ptr(&msg), msg.len);
        return 0;
    };
    if status < 200 || status >= 300 {
        pm_fr_set_endpoint(out, ep, prep.endpoint_len);
        let msg2 = PmText { bytes: [0u8; 65536], len: 0 };
        pm_append(&msg2, STR_PTR("Failed to fetch models: HTTP "), STR_LEN("Failed to fetch models: HTTP "));
        pm_append_i64(&msg2, status);
        if body.len > 0 {
            pm_append(&msg2, STR_PTR(" — "), STR_LEN(" — "));
            let take: u64 = body.len;
            if take > 200 { take = 200; };
            pm_append(&msg2, pm_text_ptr(&body), take);
        };
        pm_fr_set_error(out, pm_text_ptr(&msg2), msg2.len);
        return 0;
    };
    let desc = PmText { bytes: [0u8; 65536], len: 0 };
    let desc_p: ptr = PTR_NULL();
    PTR_BYTE_ADD(desc_p, &desc.bytes, 0);
    desc.len = parseModelDescriptors(pm_text_ptr(&body), body.len, desc_p, 65536);
    let ddoc: u64 = pm_parse(desc_p, desc.len);
    let dcount: u64 = 0;
    if ddoc != 0 {
        let dst: i32 = sa_json_value_count(ddoc, &dcount);
    };
    if ddoc == 0 || dcount == 0 {
        if ddoc != 0 { let df: i32 = sa_json_free(ddoc); };
        pm_fr_set_endpoint(out, ep, prep.endpoint_len);
        pm_fr_set_error(out, STR_PTR("No models found in provider response"), STR_LEN("No models found in provider response"));
        return 0;
    };
    // models list in descriptor order -> uniqueSorted
    let models_arr: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    let caps_obj: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    let i: u64 = 0;
    while i < dcount {
        let dobj: u64 = 0;
        let gst: i32 = sa_json_array_get(ddoc, i, &dobj);
        if gst == 0 && dobj != 0 {
            let mp: ptr = PTR_NULL();
            let ml: u64 = 0;
            let mnode: u64 = pm_jget(dobj, STR_PTR("model"), STR_LEN("model"));
            if pm_jstr(mnode, &mp, &ml) && models_arr != 0 {
                let pst2: i32 = sa_json_array_push_string(models_arr, mp, ml);
                let cnode: u64 = pm_jget(dobj, STR_PTR("capabilities"), STR_LEN("capabilities"));
                if cnode != 0 && sa_json_kind(cnode) == 7 && caps_obj != 0 {
                    let cc: u64 = 0;
                    let cst3: i32 = sa_json_value_count(cnode, &cc);
                    if cc > 0 {
                        let sst: i32 = sa_json_object_set_node(caps_obj, mp, ml, cnode);
                    };
                };
            };
        };
        i = i + 1;
    }
    if models_arr != 0 {
        let mtext = PmText { bytes: [0u8; 65536], len: 0 };
        pm_doc_to_text(models_arr, &mtext);
        let sorted = PmText { bytes: [0u8; 65536], len: 0 };
        let sorted_p: ptr = PTR_NULL();
        PTR_BYTE_ADD(sorted_p, &sorted.bytes, 0);
        sorted.len = uniqueSorted(pm_text_ptr(&mtext), mtext.len, sorted_p, 65536);
        pm_fr_set_models(out, sorted_p, sorted.len);
        let mf: i32 = sa_json_free(models_arr);
    };
    if caps_obj != 0 {
        let cc2: u64 = 0;
        let cst4: i32 = sa_json_value_count(caps_obj, &cc2);
        if cc2 > 0 {
            let ctext = PmText { bytes: [0u8; 65536], len: 0 };
            pm_doc_to_text(caps_obj, &ctext);
            pm_fr_set_caps(out, pm_text_ptr(&ctext), ctext.len);
        };
        let cf: i32 = sa_json_free(caps_obj);
    };
    let df2: i32 = sa_json_free(ddoc);
    pm_fr_set_endpoint(out, ep, prep.endpoint_len);
    return 0;
}

fn firstProviderModel(input: &FetchProviderModelsInput, out_ptr: ptr, out_cap: u64, out_found: &bool) -> i32 {
    *out_found = false;
    let res = FetchProviderModelsResult { models_json: [0u8; 65536], models_json_len: 0, modelCapabilities_json: [0u8; 65536], modelCapabilities_json_len: 0, has_capabilities: false, error: [0u8; 4096], error_len: 0, has_error: false, endpoint: [0u8; 4096], endpoint_len: 0, has_endpoint: false };
    let st: i32 = fetchProviderModels(input, &res);
    let mp: ptr = PTR_NULL();
    PTR_BYTE_ADD(mp, &res.models_json, 0);
    let doc: u64 = pm_parse(mp, res.models_json_len);
    if doc != 0 {
        if sa_json_kind(doc) == 6 {
            let el: u64 = 0;
            let gst: i32 = sa_json_array_get(doc, 0, &el);
            if gst == 0 && el != 0 && sa_json_kind(el) == 5 {
                let sp: ptr = sa_json_string_ptr(el);
                let sl: u64 = sa_json_string_len(el);
                let n: u64 = sl;
                if n > out_cap { n = out_cap; };
                PTR_COPY_BYTES(out_ptr, sp, n);
                *out_found = true;
                let f9: i32 = sa_json_free(doc);
                return n as i32;
            };
        };
        let f: i32 = sa_json_free(doc);
    };
    return 0;
}

// Test-flow internal: first model via a constructed fetch input.
fn pm_first_model(base_p: ptr, base_l: u64, key_p: ptr, key_l: u64, kind_p: ptr, kind_l: u64, has_kind: bool, proto_p: ptr, proto_l: u64, has_proto: bool, auth_p: ptr, auth_l: u64, has_auth: bool, out: &PmSmall) -> bool {
    let fin = FetchProviderModelsInput { baseUrl: [0u8; 4096], baseUrl_len: 0, apiKey: [0u8; 4096], apiKey_len: 0, has_apiKey: false, kind: [0u8; 128], kind_len: 0, has_kind: false, protocol: [0u8; 64], protocol_len: 0, has_protocol: false, authType: [0u8; 64], authType_len: 0, has_authType: false };
    let n: u64 = base_l;
    if n > 4096 { n = 4096; };
    let i: u64 = 0;
    while i < n { fin.baseUrl[i] = pm_byte(base_p, i); i = i + 1; }
    fin.baseUrl_len = n;
    let n2: u64 = key_l;
    if n2 > 4096 { n2 = 4096; };
    let i2: u64 = 0;
    while i2 < n2 { fin.apiKey[i2] = pm_byte(key_p, i2); i2 = i2 + 1; }
    fin.apiKey_len = n2;
    fin.has_apiKey = key_l > 0;
    if has_kind {
        let n3: u64 = kind_l;
        if n3 > 128 { n3 = 128; };
        let i3: u64 = 0;
        while i3 < n3 { fin.kind[i3] = pm_byte(kind_p, i3); i3 = i3 + 1; }
        fin.kind_len = n3;
        fin.has_kind = true;
    };
    if has_proto {
        let n4: u64 = proto_l;
        if n4 > 64 { n4 = 64; };
        let i4: u64 = 0;
        while i4 < n4 { fin.protocol[i4] = pm_byte(proto_p, i4); i4 = i4 + 1; }
        fin.protocol_len = n4;
        fin.has_protocol = true;
    };
    if has_auth {
        let n5: u64 = auth_l;
        if n5 > 64 { n5 = 64; };
        let i5: u64 = 0;
        while i5 < n5 { fin.authType[i5] = pm_byte(auth_p, i5); i5 = i5 + 1; }
        fin.authType_len = n5;
        fin.has_authType = true;
    };
    let stage = PmSmall { bytes: [0u8; 8192], len: 0 };
    let stage_p: ptr = PTR_NULL();
    PTR_BYTE_ADD(stage_p, &stage.bytes, 0);
    let found: bool = false;
    // firstProviderModel's i32 return carries the written length
    // (landed convention; TS returns the string or null).
    let wlen: i32 = firstProviderModel(&fin, stage_p, 8192, &found);
    if !found || wlen <= 0 { return false; };
    out.len = 0;
    pm_append_small(out, stage_p, wlen as u64);
    return true;
}

// ---- provider test flows ----
fn pm_test_finish(label_p: ptr, label_l: u64, timeout_suffix: bool, model_p: ptr, model_l: u64, prompt_p: ptr, prompt_l: u64, startedAt: i64, endpoint_p: ptr, endpoint_l: u64, timeout_ms: i64, status: i64, body: &PmText, failed: bool, timed_out: bool, extract_kind: u64, out: &TestProviderResult) -> i32 {
    let msg = PmText { bytes: [0u8; 65536], len: 0 };
    if failed {
        pm_append(&msg, label_p, label_l);
        if timed_out {
            pm_append(&msg, STR_PTR(" test timed out after "), STR_LEN(" test timed out after "));
            pm_append_i64(&msg, (timeout_ms + 500) / 1000);
            pm_append(&msg, STR_PTR("s"), STR_LEN("s"));
            if timeout_suffix { pm_append(&msg, STR_PTR(" with no response"), STR_LEN(" with no response")); };
        } else {
            pm_append(&msg, STR_PTR(" test failed: fetch failed"), STR_LEN(" test failed: fetch failed"));
        };
        return providerTestResult(false, model_p, model_l, prompt_p, prompt_l, pm_text_ptr(&msg), msg.len, startedAt, label_p, label_l, endpoint_p, endpoint_l, true, 0, false, out);
    };
    if status < 200 || status >= 300 {
        pm_append(&msg, label_p, label_l);
        pm_append(&msg, STR_PTR(" test failed: HTTP "), STR_LEN(" test failed: HTTP "));
        pm_append_i64(&msg, status);
        if body.len > 0 {
            let em = PmSmall { bytes: [0u8; 8192], len: 0 };
            let em_p: ptr = PTR_NULL();
            PTR_BYTE_ADD(em_p, &em.bytes, 0);
            let bp: ptr = pm_text_ptr(body);
            if extract_kind == 99 { em.len = 0; };
            em.len = extractErrorMessage(bp, body.len, em_p, 8192);
            pm_append(&msg, STR_PTR(" - "), STR_LEN(" - "));
            pm_append(&msg, em_p, em.len);
        };
        return providerTestResult(false, model_p, model_l, prompt_p, prompt_l, pm_text_ptr(&msg), msg.len, startedAt, label_p, label_l, endpoint_p, endpoint_l, true, status, true, out);
    };
    let content = PmText { bytes: [0u8; 65536], len: 0 };
    let content_p: ptr = PTR_NULL();
    PTR_BYTE_ADD(content_p, &content.bytes, 0);
    let bp2: ptr = pm_text_ptr(body);
    if extract_kind == 0 { content.len = extractResponsesContent(bp2, body.len, content_p, 65536); };
    if extract_kind == 1 { content.len = extractChatContent(bp2, body.len, content_p, 65536); };
    if extract_kind == 2 { content.len = extractAnthropicContent(bp2, body.len, content_p, 65536); };
    if extract_kind == 3 { content.len = extractGeminiContent(bp2, body.len, content_p, 65536); };
    if content.len == 0 {
        pm_append(&msg, label_p, label_l);
        pm_append(&msg, STR_PTR(" test returned no assistant content"), STR_LEN(" test returned no assistant content"));
        return providerTestResult(false, model_p, model_l, prompt_p, prompt_l, pm_text_ptr(&msg), msg.len, startedAt, label_p, label_l, endpoint_p, endpoint_l, true, status, true, out);
    };
    let elapsed: i64 = sa_time_unix_ms() - startedAt;
    pm_append(&msg, label_p, label_l);
    pm_append(&msg, STR_PTR(" test passed in "), STR_LEN(" test passed in "));
    pm_append_i64(&msg, elapsed);
    pm_append(&msg, STR_PTR("ms with model "), STR_LEN("ms with model "));
    pm_append(&msg, model_p, model_l);
    pm_append(&msg, STR_PTR(": "), STR_LEN(": "));
    let take: u64 = content.len;
    if take > 120 { take = 120; };
    pm_append(&msg, content_p, take);
    return providerTestResult(true, model_p, model_l, prompt_p, prompt_l, pm_text_ptr(&msg), msg.len, startedAt, label_p, label_l, endpoint_p, endpoint_l, true, status, true, out);
}

fn pm_tin_trimmed(input: &TestProviderInput, which: u64, out: &PmSmall) -> void {
    // which: 0 baseUrl, 1 apiKey, 2 model — trimmed copies
    out.len = 0;
    let raw: ptr = PTR_NULL();
    let rl: u64 = 0;
    let has: bool = true;
    if which == 0 { PTR_BYTE_ADD(raw, &input.baseUrl, 0); rl = input.baseUrl_len; };
    if which == 1 { PTR_BYTE_ADD(raw, &input.apiKey, 0); rl = input.apiKey_len; has = input.has_apiKey; };
    if which == 2 { PTR_BYTE_ADD(raw, &input.model, 0); rl = input.model_len; has = input.has_model; };
    if !has { return; };
    let lo: u64 = 0;
    let hi: u64 = 0;
    pm_trim_range(raw, rl, &lo, &hi);
    let rp: ptr = PTR_NULL();
    PTR_BYTE_ADD(rp, raw, lo);
    pm_append_small(out, rp, hi - lo);
}

fn pm_tin_kind(input: &TestProviderInput, out: &PmSmall) -> void {
    // (input.kind ?? "responsesRelay").trim()
    out.len = 0;
    if !input.has_kind {
        pm_append_small(out, STR_PTR("responsesRelay"), STR_LEN("responsesRelay"));
        return;
    };
    let raw: ptr = PTR_NULL();
    PTR_BYTE_ADD(raw, &input.kind, 0);
    let lo: u64 = 0;
    let hi: u64 = 0;
    pm_trim_range(raw, input.kind_len, &lo, &hi);
    let rp: ptr = PTR_NULL();
    PTR_BYTE_ADD(rp, raw, lo);
    pm_append_small(out, rp, hi - lo);
}

fn pm_body_text(doc: u64, out: &PmText) -> void {
    pm_doc_to_text(doc, out);
    if doc != 0 { let f: i32 = sa_json_free(doc); };
}

fn pm_messages_body(model_p: ptr, model_l: u64, prompt_p: ptr, prompt_l: u64, max_key: ptr, max_key_l: u64, with_temperature: bool) -> u64 {
    let msg: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    let s1: i32 = sa_json_object_set_string(msg, STR_PTR("role"), STR_LEN("role"), STR_PTR("user"), STR_LEN("user"));
    let s2: i32 = sa_json_object_set_string(msg, STR_PTR("content"), STR_LEN("content"), prompt_p, prompt_l);
    let arr: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    let p1: i32 = sa_json_array_push_node(arr, msg);
    let doc: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    let s3: i32 = sa_json_object_set_string(doc, STR_PTR("model"), STR_LEN("model"), model_p, model_l);
    let s4: i32 = sa_json_object_set_node(doc, STR_PTR("messages"), STR_LEN("messages"), arr);
    let s5: i32 = sa_json_object_set_i64(doc, max_key, max_key_l, 24);
    if with_temperature {
        let s6: i32 = sa_json_object_set_f64(doc, STR_PTR("temperature"), STR_LEN("temperature"), 0.0);
    };
    return doc;
}

fn testResponsesProvider(input: &TestProviderInput, out: &TestProviderResult) -> i32 {
    let startedAt: i64 = sa_time_unix_ms();
    let base = PmSmall { bytes: [0u8; 8192], len: 0 };
    pm_tin_trimmed(input, 0, &base);
    let key = PmSmall { bytes: [0u8; 8192], len: 0 };
    pm_tin_trimmed(input, 1, &key);
    let kind = PmSmall { bytes: [0u8; 8192], len: 0 };
    pm_tin_kind(input, &kind);
    let prompt_p: ptr = DEFAULT_PROVIDER_TEST_PROMPT_ptr();
    let prompt_l: u64 = STR_LEN("Reply with exactly: pong");
    let requested = PmSmall { bytes: [0u8; 8192], len: 0 };
    pm_tin_trimmed(input, 2, &requested);
    let timeout_ms: i64 = normalizeTimeout(input.timeoutMs, input.has_timeoutMs, true, PROVIDER_TEST_TIMEOUT_MS());
    if base.len == 0 {
        return providerTestResult(false, pm_small_ptr(&requested), requested.len, prompt_p, prompt_l, STR_PTR("Base URL is required"), STR_LEN("Base URL is required"), startedAt, STR_PTR("Responses"), STR_LEN("Responses"), PTR_NULL(), 0, false, 0, false, out);
    };
    let model = PmSmall { bytes: [0u8; 8192], len: 0 };
    pm_small_copy(&requested, &model);
    if model.len == 0 {
        let fm = PmSmall { bytes: [0u8; 8192], len: 0 };
        if pm_first_model(pm_small_ptr(&base), base.len, pm_small_ptr(&key), key.len, pm_small_ptr(&kind), kind.len, true, PTR_NULL(), 0, false, PTR_NULL(), 0, false, &fm) { pm_small_copy(&fm, &model); };
    };
    if model.len == 0 { pm_append_small(&model, STR_PTR("gpt-4o-mini"), STR_LEN("gpt-4o-mini")); };
    let prep = EndpointHeaders { endpoint: [0u8; 4096], endpoint_len: 0, headers: Headers { buf: [0u8; 8192], len: 0 } };
    let pst: i32 = prepareResponsesEndpoint(pm_small_ptr(&kind), kind.len, pm_small_ptr(&base), base.len, &prep);
    let ast: i32 = applyProviderAuthHeaders(&prep.headers, pm_small_ptr(&kind), kind.len, pm_small_ptr(&base), base.len, pm_small_ptr(&key), key.len);
    let bdoc: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    let b1: i32 = sa_json_object_set_string(bdoc, STR_PTR("model"), STR_LEN("model"), pm_small_ptr(&model), model.len);
    let b2: i32 = sa_json_object_set_string(bdoc, STR_PTR("input"), STR_LEN("input"), prompt_p, prompt_l);
    let b3: i32 = sa_json_object_set_i64(bdoc, STR_PTR("max_output_tokens"), STR_LEN("max_output_tokens"), 24);
    let body = PmText { bytes: [0u8; 65536], len: 0 };
    pm_body_text(bdoc, &body);
    let ep: ptr = PTR_NULL();
    PTR_BYTE_ADD(ep, &prep.endpoint, 0);
    let status: i64 = 0;
    let rbody = PmText { bytes: [0u8; 65536], len: 0 };
    let timed_out: bool = false;
    let failed: bool = false;
    pm_http(2, ep, prep.endpoint_len, &prep.headers, pm_text_ptr(&body), body.len, true, timeout_ms, &status, &rbody, &timed_out, &failed);
    return pm_test_finish(STR_PTR("Responses"), STR_LEN("Responses"), true, pm_small_ptr(&model), model.len, prompt_p, prompt_l, startedAt, ep, prep.endpoint_len, timeout_ms, status, &rbody, failed, timed_out, 0, out);
}

fn testChatCompletionsProvider(input: &TestProviderInput, out: &TestProviderResult) -> i32 {
    let startedAt: i64 = sa_time_unix_ms();
    let base = PmSmall { bytes: [0u8; 8192], len: 0 };
    pm_tin_trimmed(input, 0, &base);
    let key = PmSmall { bytes: [0u8; 8192], len: 0 };
    pm_tin_trimmed(input, 1, &key);
    let kind = PmSmall { bytes: [0u8; 8192], len: 0 };
    pm_tin_kind(input, &kind);
    // prompt = PROVIDER_TEST_PROMPTS[floor(random * 3)]
    let pick: u64 = 0;
    let rb: [u8; 1] = [0u8; 1];
    let rbp: ptr = PTR_NULL();
    PTR_BYTE_ADD(rbp, &rb, 0);
    let rst2: i32 = sa_crypto_random_bytes(rbp, 1);
    if rst2 == 0 { pick = (rb[0] as u64) % 3; };
    let prompt_p: ptr = DEFAULT_PROVIDER_TEST_PROMPT_ptr();
    let prompt_l: u64 = STR_LEN("Reply with exactly: pong");
    if pick == 1 { prompt_p = STR_PTR("Say only the word ready."); prompt_l = STR_LEN("Say only the word ready."); };
    if pick == 2 { prompt_p = STR_PTR("Answer with one short word: ok."); prompt_l = STR_LEN("Answer with one short word: ok."); };
    let requested = PmSmall { bytes: [0u8; 8192], len: 0 };
    pm_tin_trimmed(input, 2, &requested);
    let timeout_ms: i64 = normalizeTimeout(input.timeoutMs, input.has_timeoutMs, true, PROVIDER_TEST_TIMEOUT_MS());
    if base.len == 0 {
        return providerTestResult(false, pm_small_ptr(&requested), requested.len, prompt_p, prompt_l, STR_PTR("Base URL is required"), STR_LEN("Base URL is required"), startedAt, STR_PTR("Chat Completions"), STR_LEN("Chat Completions"), PTR_NULL(), 0, false, 0, false, out);
    };
    let model = PmSmall { bytes: [0u8; 8192], len: 0 };
    pm_small_copy(&requested, &model);
    if model.len == 0 {
        let fm = PmSmall { bytes: [0u8; 8192], len: 0 };
        if pm_first_model(pm_small_ptr(&base), base.len, pm_small_ptr(&key), key.len, pm_small_ptr(&kind), kind.len, true, PTR_NULL(), 0, false, PTR_NULL(), 0, false, &fm) { pm_small_copy(&fm, &model); };
    };
    if model.len == 0 { pm_append_small(&model, STR_PTR("gpt-4o-mini"), STR_LEN("gpt-4o-mini")); };
    let prep = EndpointHeaders { endpoint: [0u8; 4096], endpoint_len: 0, headers: Headers { buf: [0u8; 8192], len: 0 } };
    let pst: i32 = prepareChatCompletionsEndpoint(pm_small_ptr(&kind), kind.len, pm_small_ptr(&base), base.len, &prep);
    let ast: i32 = applyProviderAuthHeaders(&prep.headers, pm_small_ptr(&kind), kind.len, pm_small_ptr(&base), base.len, pm_small_ptr(&key), key.len);
    let bdoc: u64 = pm_messages_body(pm_small_ptr(&model), model.len, prompt_p, prompt_l, STR_PTR("max_tokens"), STR_LEN("max_tokens"), true);
    let body = PmText { bytes: [0u8; 65536], len: 0 };
    pm_body_text(bdoc, &body);
    let ep: ptr = PTR_NULL();
    PTR_BYTE_ADD(ep, &prep.endpoint, 0);
    let status: i64 = 0;
    let rbody = PmText { bytes: [0u8; 65536], len: 0 };
    let timed_out: bool = false;
    let failed: bool = false;
    pm_http(2, ep, prep.endpoint_len, &prep.headers, pm_text_ptr(&body), body.len, true, timeout_ms, &status, &rbody, &timed_out, &failed);
    return pm_test_finish(STR_PTR("Chat Completions"), STR_LEN("Chat Completions"), true, pm_small_ptr(&model), model.len, prompt_p, prompt_l, startedAt, ep, prep.endpoint_len, timeout_ms, status, &rbody, failed, timed_out, 1, out);
}

fn testAnthropicProvider(input: &TestProviderInput, out: &TestProviderResult) -> i32 {
    let startedAt: i64 = sa_time_unix_ms();
    let base = PmSmall { bytes: [0u8; 8192], len: 0 };
    pm_tin_trimmed(input, 0, &base);
    let key = PmSmall { bytes: [0u8; 8192], len: 0 };
    pm_tin_trimmed(input, 1, &key);
    let prompt_p: ptr = DEFAULT_PROVIDER_TEST_PROMPT_ptr();
    let prompt_l: u64 = STR_LEN("Reply with exactly: pong");
    let timeout_ms: i64 = normalizeTimeout(input.timeoutMs, input.has_timeoutMs, true, PROVIDER_TEST_TIMEOUT_MS());
    if base.len == 0 {
        // TS passes input.model ?? "" UNtrimmed here
        let raw_p: ptr = PTR_NULL();
        PTR_BYTE_ADD(raw_p, &input.model, 0);
        let raw_l: u64 = 0;
        if input.has_model { raw_l = input.model_len; };
        return providerTestResult(false, raw_p, raw_l, prompt_p, prompt_l, STR_PTR("Base URL is required"), STR_LEN("Base URL is required"), startedAt, STR_PTR("Anthropic Messages"), STR_LEN("Anthropic Messages"), PTR_NULL(), 0, false, 0, false, out);
    };
    let model = PmSmall { bytes: [0u8; 8192], len: 0 };
    pm_tin_trimmed(input, 2, &model);
    if model.len == 0 {
        let kind_raw: ptr = PTR_NULL();
        PTR_BYTE_ADD(kind_raw, &input.kind, 0);
        let auth_raw: ptr = PTR_NULL();
        PTR_BYTE_ADD(auth_raw, &input.authType, 0);
        let fm = PmSmall { bytes: [0u8; 8192], len: 0 };
        if pm_first_model(pm_small_ptr(&base), base.len, pm_small_ptr(&key), key.len, kind_raw, input.kind_len, input.has_kind, STR_PTR("anthropic"), STR_LEN("anthropic"), true, auth_raw, input.authType_len, input.has_authType, &fm) { pm_small_copy(&fm, &model); };
    };
    if model.len == 0 { pm_append_small(&model, STR_PTR("claude-sonnet-4-5"), STR_LEN("claude-sonnet-4-5")); };
    let path_p: ptr = STR_PTR("/v1/messages");
    let path_l: u64 = STR_LEN("/v1/messages");
    if input.has_override && input.endpointPathOverride_len > 0 {
        PTR_BYTE_ADD(path_p, &input.endpointPathOverride, 0);
        path_l = input.endpointPathOverride_len;
    };
    let endpoint = PmText { bytes: [0u8; 65536], len: 0 };
    pm_join_relay_endpoint(pm_small_ptr(&base), base.len, path_p, path_l, &endpoint);
    let headers = Headers { buf: [0u8; 8192], len: 0 };
    pm_headers_init(&headers);
    pm_headers_set(&headers, STR_PTR("Accept"), STR_LEN("Accept"), STR_PTR("application/json"), STR_LEN("application/json"));
    pm_headers_set(&headers, STR_PTR("Content-Type"), STR_LEN("Content-Type"), STR_PTR("application/json"), STR_LEN("application/json"));
    let auth_raw2: ptr = PTR_NULL();
    PTR_BYTE_ADD(auth_raw2, &input.authType, 0);
    let ast: i32 = applyProtocolAuthHeaders(&headers, STR_PTR("anthropic"), STR_LEN("anthropic"), auth_raw2, input.authType_len, input.has_authType, pm_small_ptr(&key), key.len);
    let fetch_ep = PmText { bytes: [0u8; 65536], len: 0 };
    let fetch_ep_p: ptr = PTR_NULL();
    PTR_BYTE_ADD(fetch_ep_p, &fetch_ep.bytes, 0);
    fetch_ep.len = applyProtocolQueryAuth(pm_text_ptr(&endpoint), endpoint.len, STR_PTR("anthropic"), STR_LEN("anthropic"), true, auth_raw2, input.authType_len, input.has_authType, pm_small_ptr(&key), key.len, fetch_ep_p, 65536);
    let bdoc: u64 = pm_messages_body(pm_small_ptr(&model), model.len, prompt_p, prompt_l, STR_PTR("max_tokens"), STR_LEN("max_tokens"), false);
    let body = PmText { bytes: [0u8; 65536], len: 0 };
    pm_body_text(bdoc, &body);
    let status: i64 = 0;
    let rbody = PmText { bytes: [0u8; 65536], len: 0 };
    let timed_out: bool = false;
    let failed: bool = false;
    pm_http(2, fetch_ep_p, fetch_ep.len, &headers, pm_text_ptr(&body), body.len, true, timeout_ms, &status, &rbody, &timed_out, &failed);
    return pm_test_finish(STR_PTR("Anthropic Messages"), STR_LEN("Anthropic Messages"), false, pm_small_ptr(&model), model.len, prompt_p, prompt_l, startedAt, pm_text_ptr(&endpoint), endpoint.len, timeout_ms, status, &rbody, failed, timed_out, 2, out);
}

fn testGeminiProvider(input: &TestProviderInput, out: &TestProviderResult) -> i32 {
    let startedAt: i64 = sa_time_unix_ms();
    let base = PmSmall { bytes: [0u8; 8192], len: 0 };
    pm_tin_trimmed(input, 0, &base);
    let key = PmSmall { bytes: [0u8; 8192], len: 0 };
    pm_tin_trimmed(input, 1, &key);
    let prompt_p: ptr = DEFAULT_PROVIDER_TEST_PROMPT_ptr();
    let prompt_l: u64 = STR_LEN("Reply with exactly: pong");
    let timeout_ms: i64 = normalizeTimeout(input.timeoutMs, input.has_timeoutMs, true, PROVIDER_TEST_TIMEOUT_MS());
    if base.len == 0 {
        let raw_p: ptr = PTR_NULL();
        PTR_BYTE_ADD(raw_p, &input.model, 0);
        let raw_l: u64 = 0;
        if input.has_model { raw_l = input.model_len; };
        return providerTestResult(false, raw_p, raw_l, prompt_p, prompt_l, STR_PTR("Base URL is required"), STR_LEN("Base URL is required"), startedAt, STR_PTR("Gemini generateContent"), STR_LEN("Gemini generateContent"), PTR_NULL(), 0, false, 0, false, out);
    };
    let model = PmSmall { bytes: [0u8; 8192], len: 0 };
    pm_tin_trimmed(input, 2, &model);
    if model.len == 0 {
        let kind_raw: ptr = PTR_NULL();
        PTR_BYTE_ADD(kind_raw, &input.kind, 0);
        let auth_raw: ptr = PTR_NULL();
        PTR_BYTE_ADD(auth_raw, &input.authType, 0);
        let fm = PmSmall { bytes: [0u8; 8192], len: 0 };
        if pm_first_model(pm_small_ptr(&base), base.len, pm_small_ptr(&key), key.len, kind_raw, input.kind_len, input.has_kind, STR_PTR("gemini"), STR_LEN("gemini"), true, auth_raw, input.authType_len, input.has_authType, &fm) { pm_small_copy(&fm, &model); };
    };
    if model.len == 0 { pm_append_small(&model, STR_PTR("gemini-2.5-flash"), STR_LEN("gemini-2.5-flash")); };
    let tmpl = PmText { bytes: [0u8; 65536], len: 0 };
    if input.has_override && input.endpointPathOverride_len > 0 {
        let ov_p: ptr = PTR_NULL();
        PTR_BYTE_ADD(ov_p, &input.endpointPathOverride, 0);
        pm_append(&tmpl, ov_p, input.endpointPathOverride_len);
    } else {
        pm_append(&tmpl, STR_PTR("/v1beta/models/{model}:generateContent"), STR_LEN("/v1beta/models/{model}:generateContent"));
    };
    let enc = PmText { bytes: [0u8; 65536], len: 0 };
    pm_uri_encode(pm_small_ptr(&model), model.len, &enc);
    let path = PmText { bytes: [0u8; 65536], len: 0 };
    pm_replace_all(&tmpl, STR_PTR("{model}"), STR_LEN("{model}"), pm_text_ptr(&enc), enc.len, &path);
    let endpoint = PmText { bytes: [0u8; 65536], len: 0 };
    pm_join_relay_endpoint(pm_small_ptr(&base), base.len, pm_text_ptr(&path), path.len, &endpoint);
    let headers = Headers { buf: [0u8; 8192], len: 0 };
    pm_headers_init(&headers);
    pm_headers_set(&headers, STR_PTR("Accept"), STR_LEN("Accept"), STR_PTR("application/json"), STR_LEN("application/json"));
    pm_headers_set(&headers, STR_PTR("Content-Type"), STR_LEN("Content-Type"), STR_PTR("application/json"), STR_LEN("application/json"));
    let auth_raw2: ptr = PTR_NULL();
    PTR_BYTE_ADD(auth_raw2, &input.authType, 0);
    let ast: i32 = applyProtocolAuthHeaders(&headers, STR_PTR("gemini"), STR_LEN("gemini"), auth_raw2, input.authType_len, input.has_authType, pm_small_ptr(&key), key.len);
    let fetch_ep = PmText { bytes: [0u8; 65536], len: 0 };
    let fetch_ep_p: ptr = PTR_NULL();
    PTR_BYTE_ADD(fetch_ep_p, &fetch_ep.bytes, 0);
    fetch_ep.len = applyProtocolQueryAuth(pm_text_ptr(&endpoint), endpoint.len, STR_PTR("gemini"), STR_LEN("gemini"), true, auth_raw2, input.authType_len, input.has_authType, pm_small_ptr(&key), key.len, fetch_ep_p, 65536);
    // body: {contents: [{role: "user", parts: [{text: prompt}]}], generationConfig: {maxOutputTokens: 24, temperature: 0}}
    let part: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    let g1: i32 = sa_json_object_set_string(part, STR_PTR("text"), STR_LEN("text"), prompt_p, prompt_l);
    let parts: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    let g2: i32 = sa_json_array_push_node(parts, part);
    let content_obj: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    let g3: i32 = sa_json_object_set_string(content_obj, STR_PTR("role"), STR_LEN("role"), STR_PTR("user"), STR_LEN("user"));
    let g4: i32 = sa_json_object_set_node(content_obj, STR_PTR("parts"), STR_LEN("parts"), parts);
    let contents: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    let g5: i32 = sa_json_array_push_node(contents, content_obj);
    let gen_cfg: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    let g6: i32 = sa_json_object_set_i64(gen_cfg, STR_PTR("maxOutputTokens"), STR_LEN("maxOutputTokens"), 24);
    let g7: i32 = sa_json_object_set_f64(gen_cfg, STR_PTR("temperature"), STR_LEN("temperature"), 0.0);
    let bdoc: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    let g8: i32 = sa_json_object_set_node(bdoc, STR_PTR("contents"), STR_LEN("contents"), contents);
    let g9: i32 = sa_json_object_set_node(bdoc, STR_PTR("generationConfig"), STR_LEN("generationConfig"), gen_cfg);
    let body = PmText { bytes: [0u8; 65536], len: 0 };
    pm_body_text(bdoc, &body);
    let status: i64 = 0;
    let rbody = PmText { bytes: [0u8; 65536], len: 0 };
    let timed_out: bool = false;
    let failed: bool = false;
    pm_http(2, fetch_ep_p, fetch_ep.len, &headers, pm_text_ptr(&body), body.len, true, timeout_ms, &status, &rbody, &timed_out, &failed);
    return pm_test_finish(STR_PTR("Gemini generateContent"), STR_LEN("Gemini generateContent"), false, pm_small_ptr(&model), model.len, prompt_p, prompt_l, startedAt, pm_text_ptr(&endpoint), endpoint.len, timeout_ms, status, &rbody, failed, timed_out, 3, out);
}

fn testProvider(input: &TestProviderInput, out: &TestProviderResult) -> i32 {
    // protocol = input.protocol ?? (isResponsesRelayKind(kind) ?
    // "openai-response" : "openai")
    let proto_p: ptr = PTR_NULL();
    PTR_BYTE_ADD(proto_p, &input.protocol, 0);
    if input.has_protocol {
        if pm_eq_lit(proto_p, input.protocol_len, STR_PTR("openai-response"), STR_LEN("openai-response")) { return testResponsesProvider(input, out); };
        if pm_eq_lit(proto_p, input.protocol_len, STR_PTR("anthropic"), STR_LEN("anthropic")) { return testAnthropicProvider(input, out); };
        if pm_eq_lit(proto_p, input.protocol_len, STR_PTR("gemini"), STR_LEN("gemini")) { return testGeminiProvider(input, out); };
        return testChatCompletionsProvider(input, out);
    };
    let kind_p: ptr = PTR_NULL();
    PTR_BYTE_ADD(kind_p, &input.kind, 0);
    if isResponsesRelayKind(kind_p, input.kind_len, input.has_kind) { return testResponsesProvider(input, out); };
    return testChatCompletionsProvider(input, out);
}

fn testProviderChat(input: &TestProviderInput, out: &TestProviderResult) -> i32 { return testProvider(input, out); }
