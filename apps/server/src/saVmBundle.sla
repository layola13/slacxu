// Converted 1:1 from apps/server/src/saVmBundle.ts (CXU plugins @ f2cb649d).
// Fix stage (launch/install family rebuild, Agent AD3): full body retranslation.
// Async functions are contract-layer blocking (ASYNC_MODEL R8): every awaited
// op is an fs/process extern with a blocking sa_std form, executed in TS
// order; methods return status codes (0 = ok unless a function documents
// otherwise). TS try/catch blocks map to status branches that reproduce the
// source's swallow/propagate choice per site (noted inline).
// Representation: dynamic JSON objects are handled as sa_json doc handles
// during a merge and cross function boundaries as JSON text (BuText);
// the skeleton's bare out_ptr params become &BuText / &BuPath accordingly.
// Registered deviations:
// - JSON.stringify pretty indents (2/4 spaces) are emitted compact by
//   sa_json_stringify; the JSON values are identical.
// - path resolve() normalization is verbatim string comparison (same
//   approximation as sdk-backend saVmPaths).
// - win32 shell quoting in runClaudeCli and the win32/darwin config-dir
//   branches are platform seams: this build follows the POSIX branches.
// - DEFECT #1 workaround: process output is captured with
//   sa_std_process_run + try_wait poll + post-exit drain (exec_capture
//   returns empty streams for successful children).
// - DEFECT #18 CONFIRMED LIVE by _defects/probes/bu_cand_probe.sla
//   (resolveSaVmMcpSourceCandidates returns count=3 with every item len=0:
//   the sdk candidates_push writes through &items[count] field refs and
//   they never land). The project installer's candidate copy path is
//   therefore blocked upstream; this file consumes candidates by value
//   and skips zero-length items, exactly per the TS loop, and does NOT
//   reimplement the sdk resolver. The already-installed fast path and
//   the PWD-candidate path of ensureSaVmMcpInstalled are unaffected.

@import "sa_std/io/print.sai"
@import "sa_std/fs.sai"
@import "sa_std/env.sai"
@import "sa_std/ptr.sa"
@import "sa_std/string.sa"
@import "sa_std/time.sai"
@import "sa_std/process.sai"
@import "sa_std/process.sa"
@import "sa_std/encoding/json.sai"
@import "../../../sdk-backend/src/saVmPaths.sla"

// ---------------------------------------------------------------------------
// Text buffers and byte helpers (bu_*).
// ---------------------------------------------------------------------------

struct BuText {
    bytes: [u8; 65536], len: u64
}

struct BuPath {
    bytes: [u8; 1024], len: u64
}

fn bu_text_ptr(s: &BuText) -> ptr {
    let p: ptr = PTR_NULL();
    PTR_BYTE_ADD(p, &s.bytes, 0);
    return p;
}

fn bu_path_ptr(s: &BuPath) -> ptr {
    let p: ptr = PTR_NULL();
    PTR_BYTE_ADD(p, &s.bytes, 0);
    return p;
}

fn bu_byte(p: ptr, i: u64) -> u8 {
    let b: u8 = 0;
    PTR_BYTE_AT(b, p, i);
    return b;
}

fn bu_push(s: &BuText, p: ptr, n: u64) -> void {
    let i: u64 = 0;
    while i < n {
        if s.len < 65536 {
            s.bytes[s.len] = bu_byte(p, i);
            s.len = s.len + 1;
        };
        i = i + 1;
    }
}

fn bu_push_lit(s: &BuText, lit_p: ptr, lit_n: u64) -> void {
    bu_push(s, lit_p, lit_n);
}

fn bu_push_path(s: &BuPath, p: ptr, n: u64) -> void {
    let i: u64 = 0;
    while i < n {
        if s.len < 1024 {
            s.bytes[s.len] = bu_byte(p, i);
            s.len = s.len + 1;
        };
        i = i + 1;
    }
}

fn bu_eq(p: ptr, n: u64, q: ptr, qn: u64) -> bool {
    if n != qn { return false; };
    let i: u64 = 0;
    while i < n {
        if bu_byte(p, i) != bu_byte(q, i) { return false; };
        i = i + 1;
    }
    return true;
}

fn bu_contains(p: ptr, n: u64, q: ptr, qn: u64) -> bool {
    if qn == 0 { return true; };
    if n < qn { return false; };
    let i: u64 = 0;
    while i + qn <= n {
        let j: u64 = 0;
        let ok = true;
        while j < qn {
            if bu_byte(p, i + j) != bu_byte(q, j) { ok = false; break; };
            j = j + 1;
        }
        if ok { return true; };
        i = i + 1;
    }
    return false;
}

fn bu_is_ws(b: u8) -> bool {
    return b == 32 || (b >= 9 && b <= 13);
}

fn bu_lower_byte(b: u8) -> u8 {
    if b >= 65 && b <= 90 { return b + 32; };
    return b;
}

// Trimmed copy into out (cleared first).
fn bu_trim_copy(out: &BuText, p: ptr, n: u64) -> void {
    let s: u64 = 0;
    let e: u64 = n;
    while s < e && bu_is_ws(bu_byte(p, s)) { s = s + 1; }
    while e > s && bu_is_ws(bu_byte(p, e - 1)) { e = e - 1; }
    out.len = 0;
    let sp: ptr = PTR_NULL();
    PTR_BYTE_ADD(sp, p, s);
    bu_push(out, sp, e - s);
}

// JSON-string quoted form of (p, n) appended to out (JSON.stringify string).
fn bu_json_quote(out: &BuText, p: ptr, n: u64) -> void {
    bu_push_lit(out, STR_PTR("\""), STR_LEN("\""));
    let i: u64 = 0;
    while i < n {
        let b = bu_byte(p, i);
        if b == 34 {
            bu_push_lit(out, STR_PTR("\\\""), STR_LEN("\\\""));
        } else if b == 92 {
            bu_push_lit(out, STR_PTR("\\\\"), STR_LEN("\\\\"));
        } else if b == 10 {
            bu_push_lit(out, STR_PTR("\\n"), STR_LEN("\\n"));
        } else if b == 13 {
            bu_push_lit(out, STR_PTR("\\r"), STR_LEN("\\r"));
        } else if b == 9 {
            bu_push_lit(out, STR_PTR("\\t"), STR_LEN("\\t"));
        } else if b < 32 {
            bu_push_lit(out, STR_PTR("\\u00"), STR_LEN("\\u00"));
            let hi = (b / 16) as u8;
            let lo = (b % 16) as u8;
            let hc: u8 = 48 + hi;
            if hi > 9 { hc = 87 + hi; };
            let lc: u8 = 48 + lo;
            if lo > 9 { lc = 87 + lo; };
            if out.len < 65536 { out.bytes[out.len] = hc; out.len = out.len + 1; };
            if out.len < 65536 { out.bytes[out.len] = lc; out.len = out.len + 1; };
        } else {
            if out.len < 65536 { out.bytes[out.len] = b; out.len = out.len + 1; };
        };
        i = i + 1;
    }
    bu_push_lit(out, STR_PTR("\""), STR_LEN("\""));
}

// ---------------------------------------------------------------------------
// fs helpers.
// ---------------------------------------------------------------------------

fn bu_exists(p: ptr, n: u64) -> bool {
    return dd_fs_exists(p, n);
}

// Read a whole file as text (cap 65536; false when unreadable).
fn bu_read_text(path_p: ptr, path_l: u64, out: &BuText) -> bool {
    out.len = 0;
    let h: u64 = 0;
    let st = sa_std_fs_read_to_string(path_p, path_l, 65536, &h);
    if st != 0 { return false; };
    if h == 0 { return false; };
    let bp: ptr = sa_fs_read_buffer_data(h);
    let bl: u64 = sa_fs_read_buffer_len(h);
    bu_push(out, bp, bl);
    sa_fs_read_buffer_free(h);
    return true;
}

fn bu_write_text(path_p: ptr, path_l: u64, p: ptr, n: u64) -> bool {
    return sa_fs_write_file(path_p, path_l, p, n) == 0;
}

// Byte copy of a file (read handle -> write), false on any failure.
fn bu_copy_file(src_p: ptr, src_l: u64, dst_p: ptr, dst_l: u64) -> bool {
    let h: u64 = 0;
    let st = sa_std_fs_read_file(src_p, src_l, 16777216, &h);
    if st != 0 { return false; };
    if h == 0 { return false; };
    let bp: ptr = sa_fs_read_buffer_data(h);
    let bl: u64 = sa_fs_read_buffer_len(h);
    let ok = sa_fs_write_file(dst_p, dst_l, bp, bl) == 0;
    sa_fs_read_buffer_free(h);
    return ok;
}

fn bu_mkdir_p(p: ptr, n: u64) -> void {
    sa_fs_mkdir_p(p, n);
}

// join a/b into out path (verbatim, single slash).
fn bu_join(out: &BuPath, a_p: ptr, a_n: u64, b_p: ptr, b_n: u64) -> void {
    out.len = 0;
    bu_push_path(out, a_p, a_n);
    if a_n > 0 {
        if bu_byte(a_p, a_n - 1) != 47 {
            bu_push_path(out, STR_PTR("/"), STR_LEN("/"));
        };
    };
    bu_push_path(out, b_p, b_n);
}

fn bu_dirname(p: ptr, n: u64, out: &BuPath) -> void {
    out.len = 0;
    let e = n;
    while e > 1 && bu_byte(p, e - 1) == 47 { e = e - 1; }
    let i = e;
    let cut: u64 = 0;
    while i > 0 {
        if bu_byte(p, i - 1) == 47 { cut = i - 1; break; };
        i = i - 1;
    }
    if cut == 0 {
        bu_push_path(out, STR_PTR("/"), STR_LEN("/"));
        return;
    };
    bu_push_path(out, p, cut);
}

// env var (raw) into out path; false when unset/empty.
fn bu_env_path(name_p: ptr, name_l: u64, out: &BuPath) -> bool {
    out.len = 0;
    let h: u64 = sa_env_get(name_p, name_l);
    if h == 0 { return false; };
    let bp: ptr = sa_env_buffer_data(h);
    let bl: u64 = sa_env_buffer_len(h);
    bu_push_path(out, bp, bl);
    return out.len > 0;
}

fn bu_home(out: &BuPath) -> bool {
    return bu_env_path(STR_PTR("HOME"), STR_LEN("HOME"), out);
}

fn bu_pwd(out: &BuPath) -> bool {
    return bu_env_path(STR_PTR("PWD"), STR_LEN("PWD"), out);
}

// ---------------------------------------------------------------------------
// JSON doc helpers.
// ---------------------------------------------------------------------------

fn bu_free_doc(doc: u64) -> void {
    if doc == 0 { return; };
    sa_json_free(doc);
}

fn bu_free_buffer(h: u64) -> void {
    if h == 0 { return; };
    sa_json_buffer_free(h);
}

fn bu_parse(p: ptr, n: u64) -> u64 {
    if n == 0 { return 0; };
    return sa_json_parse(p, n);
}

fn bu_new_obj() -> u64 {
    return sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
}

fn bu_new_arr() -> u64 {
    return sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
}

fn bu_get_obj(parent: u64, key_p: ptr, key_l: u64) -> u64 {
    let node: u64 = 0;
    if sa_json_object_get(parent, key_p, key_l, &node) != 0 { return 0; };
    return node;
}

fn bu_is_obj(node: u64) -> bool {
    if node == 0 { return false; };
    return sa_json_kind(node) == 7;
}

fn bu_stringify_into(doc: u64, out: &BuText) -> bool {
    out.len = 0;
    let h: u64 = 0;
    if sa_json_stringify(doc, &h) != 0 { return false; };
    if h == 0 { return false; };
    let bp: ptr = sa_json_buffer_data(h);
    let bl: u64 = sa_json_buffer_len(h);
    bu_push(out, bp, bl);
    bu_free_buffer(h);
    return true;
}

// Build {command: "node", args: [script]} node (not yet attached).
fn bu_cmd_node(script_p: ptr, script_l: u64, with_enabled: bool, with_id: bool) -> u64 {
    let node = bu_new_obj();
    if node == 0 { return 0; };
    sa_json_object_set_string(node, STR_PTR("command"), STR_LEN("command"), STR_PTR("node"), STR_LEN("node"));
    let args = bu_new_arr();
    if args != 0 {
        sa_json_array_push_string(args, script_p, script_l);
        sa_json_object_set_node(node, STR_PTR("args"), STR_LEN("args"), args);
        bu_free_doc(args);
    };
    if with_enabled {
        sa_json_object_set_bool(node, STR_PTR("enabled"), STR_LEN("enabled"), 1);
    };
    if with_id {
        sa_json_object_set_string(node, STR_PTR("id"), STR_LEN("id"), STR_PTR("sa-vm"), STR_LEN("sa-vm"));
    };
    return node;
}

// Build {"type": "local", command: ["node", script]} node (opencode shape);
// command_array is true for this shape; enabled added when with_enabled.
fn bu_opencode_node(script_p: ptr, script_l: u64, with_enabled: bool) -> u64 {
    let node = bu_new_obj();
    if node == 0 { return 0; };
    sa_json_object_set_string(node, STR_PTR("type"), STR_LEN("type"), STR_PTR("local"), STR_LEN("local"));
    let cmd = bu_new_arr();
    if cmd != 0 {
        sa_json_array_push_string(cmd, STR_PTR("node"), STR_LEN("node"));
        sa_json_array_push_string(cmd, script_p, script_l);
        sa_json_object_set_node(node, STR_PTR("command"), STR_LEN("command"), cmd);
        bu_free_doc(cmd);
    };
    if with_enabled {
        sa_json_object_set_bool(node, STR_PTR("enabled"), STR_LEN("enabled"), 1);
    };
    return node;
}

// ---------------------------------------------------------------------------
// Result type + TS constants.
// SA_VM_MCP_BUNDLE_VERSION = 6, SA_VM_PI_EXTENSION_SOURCE_NAME =
// "sa-vm-pi-extension.ts", SA_VM_OPENCODE_SERVER_NAME = "sa-vm",
// JEV_OPENCODE_SERVER_NAME = "jev", MINI_AGENT_NAME = "mini-agent",
// MINI_AGENT_DEFAULT_USER_AGENT = "mini-agent/0.2.176" (backends/mini
// miniMcp constants, inlined per the import graph of the TS source).
// ---------------------------------------------------------------------------

struct BundleResult {
    scriptPath: BuPath, installed: bool,
    root: BuPath,
    clientsConfigured: [BuPath; 16], clientsConfigured_len: u64,
}

fn bu_result_new() -> BundleResult {
    return BundleResult {
        scriptPath: BuPath { bytes: [0u8; 1024], len: 0 },
        installed: false,
        root: BuPath { bytes: [0u8; 1024], len: 0 },
        clientsConfigured: [BuPath { bytes: [0u8; 1024], len: 0 }, BuPath { bytes: [0u8; 1024], len: 0 }, BuPath { bytes: [0u8; 1024], len: 0 }, BuPath { bytes: [0u8; 1024], len: 0 }, BuPath { bytes: [0u8; 1024], len: 0 }, BuPath { bytes: [0u8; 1024], len: 0 }, BuPath { bytes: [0u8; 1024], len: 0 }, BuPath { bytes: [0u8; 1024], len: 0 }, BuPath { bytes: [0u8; 1024], len: 0 }, BuPath { bytes: [0u8; 1024], len: 0 }, BuPath { bytes: [0u8; 1024], len: 0 }, BuPath { bytes: [0u8; 1024], len: 0 }, BuPath { bytes: [0u8; 1024], len: 0 }, BuPath { bytes: [0u8; 1024], len: 0 }, BuPath { bytes: [0u8; 1024], len: 0 }, BuPath { bytes: [0u8; 1024], len: 0 }],
        clientsConfigured_len: 0,
    };
}

fn bu_client_push(out: &BundleResult, kind_p: ptr, kind_l: u64, path_p: ptr, path_l: u64) -> void {
    if out.clientsConfigured_len >= 16 { return; };
    let entry = BuPath { bytes: [0u8; 1024], len: 0 };
    bu_push_path(&entry, kind_p, kind_l);
    bu_push_path(&entry, STR_PTR(":"), STR_LEN(":"));
    bu_push_path(&entry, path_p, path_l);
    out.clientsConfigured[out.clientsConfigured_len] = entry;
    out.clientsConfigured_len = out.clientsConfigured_len + 1;
}

// ---------------------------------------------------------------------------
// isJevMcpEnabled: env JEV_MCP_ENABLED trimmed+lowercased is "1" or "true".
// ---------------------------------------------------------------------------

fn isJevMcpEnabled() -> bool {
    let v = BuText { bytes: [0u8; 65536], len: 0 };
    let h: u64 = sa_env_get(STR_PTR("JEV_MCP_ENABLED"), STR_LEN("JEV_MCP_ENABLED"));
    if h == 0 { return false; };
    let bp: ptr = sa_env_buffer_data(h);
    let bl: u64 = sa_env_buffer_len(h);
    bu_trim_copy(&v, bp, bl);
    let vp: ptr = bu_text_ptr(&v);
    let i: u64 = 0;
    while i < v.len {
        v.bytes[i] = bu_lower_byte(bu_byte(vp, i));
        i = i + 1;
    }
    if bu_eq(vp, v.len, STR_PTR("1"), STR_LEN("1")) { return true; };
    return bu_eq(vp, v.len, STR_PTR("true"), STR_LEN("true"));
}

// ---------------------------------------------------------------------------
// isSelfManagedMcpEntry: any command/args string part, with backslashes
// normalized to slashes, ends with "/sa-vm-mcp.mjs".
// ---------------------------------------------------------------------------

fn bu_part_is_script(p: ptr, n: u64) -> bool {
    let sn: u64 = 14;
    if n < sn { return false; };
    let off = n - sn;
    let sfx: ptr = STR_PTR("/sa-vm-mcp.mjs");
    let i: u64 = 0;
    while i < sn {
        let b = bu_byte(p, off + i);
        if b == 92 { b = 47; };
        if b != bu_byte(sfx, i) { return false; };
        i = i + 1;
    }
    return true;
}

fn bu_node_is_script_part(node: u64) -> bool {
    if node == 0 { return false; };
    let kind = sa_json_kind(node);
    if kind == 5 {
        let np: ptr = sa_json_string_ptr(node);
        return bu_part_is_script(np, sa_json_string_len(node));
    };
    if kind == 6 {
        let count: u64 = 0;
        sa_json_value_count(node, &count);
        let i: u64 = 0;
        while i < count {
            let el: u64 = 0;
            if sa_json_array_get(node, i, &el) == 0 {
                if el != 0 {
                    if sa_json_kind(el) == 5 {
                        let ep: ptr = sa_json_string_ptr(el);
                        if bu_part_is_script(ep, sa_json_string_len(el)) { return true; };
                    };
                };
            };
            i = i + 1;
        }
    };
    return false;
}

fn bu_self_managed_node(entry: u64) -> bool {
    if !bu_is_obj(entry) { return false; };
    let cmd = bu_get_obj(entry, STR_PTR("command"), STR_LEN("command"));
    if bu_node_is_script_part(cmd) { return true; };
    let args = bu_get_obj(entry, STR_PTR("args"), STR_LEN("args"));
    return bu_node_is_script_part(args);
}

fn isSelfManagedMcpEntry(entry_json_ptr: ptr, entry_json_len: u64) -> bool {
    let doc = bu_parse(entry_json_ptr, entry_json_len);
    if doc == 0 { return false; };
    let r = bu_self_managed_node(doc);
    bu_free_doc(doc);
    return r;
}

// ---------------------------------------------------------------------------
// stripSelfManagedTomlServer(content, name) -> out text (len returned).
// ---------------------------------------------------------------------------

fn bu_line_is_header(p: ptr, n: u64, s: u64, e: u64, name_p: ptr, name_l: u64) -> bool {
    // trimmed line equals "[mcp_servers.<name>]"
    let a = s;
    let b = e;
    while a < b && bu_is_ws(bu_byte(p, a)) { a = a + 1; }
    while b > a && bu_is_ws(bu_byte(p, b - 1)) { b = b - 1; }
    let want = BuPath { bytes: [0u8; 1024], len: 0 };
    bu_push_path(&want, STR_PTR("[mcp_servers."), STR_LEN("[mcp_servers."));
    bu_push_path(&want, name_p, name_l);
    bu_push_path(&want, STR_PTR("]"), STR_LEN("]"));
    if b - a != want.len { return false; };
    let wp: ptr = bu_path_ptr(&want);
    let i: u64 = 0;
    while i < want.len {
        if bu_byte(p, a + i) != bu_byte(wp, i) { return false; };
        i = i + 1;
    }
    return true;
}

fn bu_line_starts_section(p: ptr, s: u64, e: u64) -> bool {
    let a = s;
    while a < e && bu_is_ws(bu_byte(p, a)) { a = a + 1; }
    if a >= e { return false; };
    return bu_byte(p, a) == 91;
}

// Line emitter state for the TOML strip (lines re-joined with "\n").
struct BuLineSink {
    out_len: u64, first: bool
}

fn bu_sink_line(mgr_out: &BuText, sink: &BuLineSink, p: ptr, s: u64, e: u64) -> void {
    if !sink.first {
        bu_push_lit(mgr_out, STR_PTR("\n"), STR_LEN("\n"));
    };
    sink.first = false;
    let lp: ptr = PTR_NULL();
    PTR_BYTE_ADD(lp, p, s);
    bu_push(mgr_out, lp, e - s);
}

// Flush a buffered block (raw lines already joined by \n in blk) line by line.
fn bu_sink_block(mgr_out: &BuText, sink: &BuLineSink, blk: &BuText) -> void {
    let bp: ptr = bu_text_ptr(blk);
    let pos: u64 = 0;
    while pos <= blk.len {
        let le = pos;
        while le < blk.len && bu_byte(bp, le) != 10 { le = le + 1; }
        bu_sink_line(mgr_out, sink, bp, pos, le);
        if le >= blk.len { break; };
        pos = le + 1;
    }
}

fn stripSelfManagedTomlServer(content_ptr: ptr, content_len: u64, name_ptr: ptr, name_len: u64, out: &BuText) -> u64 {
    out.len = 0;
    let sink = BuLineSink { out_len: 0, first: true };
    let blk = BuText { bytes: [0u8; 65536], len: 0 };
    let in_block = false;
    let pos: u64 = 0;
    while pos <= content_len {
        let le = pos;
        while le < content_len && bu_byte(content_ptr, le) != 10 { le = le + 1; }
        let lend = le;
        if lend > pos {
            if bu_byte(content_ptr, lend - 1) == 13 { lend = lend - 1; };
        };
        let is_target = bu_line_is_header(content_ptr, content_len, pos, lend, name_ptr, name_len);
        let is_section = bu_line_starts_section(content_ptr, pos, lend);
        if is_target || (is_section && in_block) {
            // close the current block first (for is_section), then maybe open
            if in_block {
                let bp0: ptr = bu_text_ptr(&blk);
                if !bu_contains(bp0, blk.len, STR_PTR("sa-vm-mcp.mjs"), STR_LEN("sa-vm-mcp.mjs")) {
                    bu_sink_block(out, &sink, &blk);
                };
                blk.len = 0;
                in_block = false;
            };
            if is_target {
                in_block = true;
                let lp: ptr = PTR_NULL();
                PTR_BYTE_ADD(lp, content_ptr, pos);
                bu_push(&blk, lp, lend - pos);
            } else {
                bu_sink_line(out, &sink, content_ptr, pos, lend);
            };
        } else {
            if in_block {
                if blk.len > 0 { bu_push_lit(&blk, STR_PTR("\n"), STR_LEN("\n")); };
                let lp: ptr = PTR_NULL();
                PTR_BYTE_ADD(lp, content_ptr, pos);
                bu_push(&blk, lp, lend - pos);
            } else {
                bu_sink_line(out, &sink, content_ptr, pos, lend);
            };
        };
        if le >= content_len { break; };
        pos = le + 1;
    }
    if in_block {
        let bp0: ptr = bu_text_ptr(&blk);
        if !bu_contains(bp0, blk.len, STR_PTR("sa-vm-mcp.mjs"), STR_LEN("sa-vm-mcp.mjs")) {
            bu_sink_block(out, &sink, &blk);
        };
    };
    return out.len;
}

// ---------------------------------------------------------------------------
// JSON merge helpers shared by the three merge surfaces.
// ---------------------------------------------------------------------------

// Ensure doc[key] is an object node; returns the (possibly new) node.
fn bu_ensure_obj_field(doc: u64, key_p: ptr, key_l: u64) -> u64 {
    let node = bu_get_obj(doc, key_p, key_l);
    if bu_is_obj(node) { return node; };
    let fresh = bu_new_obj();
    if fresh == 0 { return 0; };
    sa_json_object_set_node(doc, key_p, key_l, fresh);
    bu_free_doc(fresh);
    return bu_get_obj(doc, key_p, key_l);
}

// Apply the jev opt-in rule inside a servers map: set jev when enabled,
// otherwise delete a self-managed jev entry. build: 0 = {command,args},
// 1 = {command,args,enabled}, 2 = opencode {type,command[],enabled?}.
fn bu_apply_jev(servers: u64, script_p: ptr, script_l: u64, shape: u64) -> void {
    if isJevMcpEnabled() {
        let node: u64 = 0;
        if shape == 2 {
            node = bu_opencode_node(script_p, script_l, true);
        } else if shape == 3 {
            node = bu_opencode_node(script_p, script_l, false);
        } else if shape == 1 {
            node = bu_cmd_node(script_p, script_l, true, false);
        } else {
            node = bu_cmd_node(script_p, script_l, false, false);
        };
        if node != 0 {
            sa_json_object_set_node(servers, STR_PTR("jev"), STR_LEN("jev"), node);
            bu_free_doc(node);
        };
        return;
    };
    let jev = bu_get_obj(servers, STR_PTR("jev"), STR_LEN("jev"));
    if jev != 0 {
        if bu_self_managed_node(jev) {
            sa_json_object_remove(servers, STR_PTR("jev"), STR_LEN("jev"));
        };
    };
}

fn bu_set_savm(servers: u64, script_p: ptr, script_l: u64, shape: u64) -> void {
    let node: u64 = 0;
    if shape == 2 {
        node = bu_opencode_node(script_p, script_l, true);
    } else if shape == 3 {
        node = bu_opencode_node(script_p, script_l, false);
    } else if shape == 1 {
        node = bu_cmd_node(script_p, script_l, true, false);
    } else if shape == 4 {
        node = bu_cmd_node(script_p, script_l, false, true);
    } else {
        node = bu_cmd_node(script_p, script_l, false, false);
    };
    if node != 0 {
        sa_json_object_set_node(servers, STR_PTR("sa-vm"), STR_LEN("sa-vm"), node);
        bu_free_doc(node);
    };
}

// Parse existing JSON text as an object doc; empty/invalid -> fresh {}.
fn bu_doc_or_empty(p: ptr, n: u64) -> u64 {
    let doc = bu_parse(p, n);
    if doc != 0 {
        if bu_is_obj(doc) { return doc; };
        bu_free_doc(doc);
    };
    return bu_new_obj();
}

// ---------------------------------------------------------------------------
// mergeMcpServersJsonConfig(existing, scriptPath) -> out text.
// ---------------------------------------------------------------------------

fn mergeMcpServersJsonConfig(existing_json_ptr: ptr, existing_json_len: u64, script_ptr: ptr, script_len: u64, out: &BuText) -> u64 {
    let doc = bu_doc_or_empty(existing_json_ptr, existing_json_len);
    if doc == 0 { out.len = 0; return 0; };
    let servers = bu_ensure_obj_field(doc, STR_PTR("mcpServers"), STR_LEN("mcpServers"));
    if servers != 0 {
        bu_apply_jev(servers, script_ptr, script_len, 1);
        bu_set_savm(servers, script_ptr, script_len, 1);
    };
    // if (!conf.agent || typeof conf.agent !== "object") conf.agent = {...}
    let agent = bu_get_obj(doc, STR_PTR("agent"), STR_LEN("agent"));
    if !bu_is_obj(agent) {
        let a = bu_new_obj();
        if a != 0 {
            sa_json_object_set_string(a, STR_PTR("name"), STR_LEN("name"), STR_PTR("mini-agent"), STR_LEN("mini-agent"));
            sa_json_object_set_string(a, STR_PTR("user_agent"), STR_LEN("user_agent"), STR_PTR("mini-agent/0.2.176"), STR_LEN("mini-agent/0.2.176"));
            sa_json_object_set_node(doc, STR_PTR("agent"), STR_LEN("agent"), a);
            bu_free_doc(a);
        };
    };
    bu_stringify_into(doc, out);
    bu_free_doc(doc);
    return out.len;
}

// ---------------------------------------------------------------------------
// mergeOpencodeMcpConfig(existing, scriptPath) -> out text.
// ---------------------------------------------------------------------------

fn mergeOpencodeMcpConfig(existing_json_ptr: ptr, existing_json_len: u64, script_ptr: ptr, script_len: u64, out: &BuText) -> u64 {
    let doc = bu_doc_or_empty(existing_json_ptr, existing_json_len);
    if doc == 0 { out.len = 0; return 0; };
    let mcp = bu_ensure_obj_field(doc, STR_PTR("mcp"), STR_LEN("mcp"));
    if mcp != 0 {
        bu_apply_jev(mcp, script_ptr, script_len, 2);
        bu_set_savm(mcp, script_ptr, script_len, 2);
        let servers = bu_ensure_obj_field(mcp, STR_PTR("servers"), STR_LEN("servers"));
        if servers != 0 {
            bu_apply_jev(servers, script_ptr, script_len, 3);
            bu_set_savm(servers, script_ptr, script_len, 3);
        };
    };
    bu_stringify_into(doc, out);
    bu_free_doc(doc);
    return out.len;
}

// ---------------------------------------------------------------------------
// parseJsonObjectConfig(raw) -> canonical object text in out; -1 on throw
// (unparseable or root not an object). BOM tolerated, as in TS.
// ---------------------------------------------------------------------------

fn parseJsonObjectConfig(raw_ptr: ptr, raw_len: u64, out: &BuText) -> i32 {
    let p = raw_ptr;
    let n = raw_len;
    if n >= 3 {
        if bu_byte(p, 0) == 239 && bu_byte(p, 1) == 187 && bu_byte(p, 2) == 191 {
            let np: ptr = PTR_NULL();
            PTR_BYTE_ADD(np, p, 3);
            p = np;
            n = n - 3;
        };
    };
    let doc = bu_parse(p, n);
    if doc == 0 { return -1; };
    if !bu_is_obj(doc) {
        bu_free_doc(doc);
        return -1;
    };
    bu_stringify_into(doc, out);
    bu_free_doc(doc);
    return 0;
}

// ---------------------------------------------------------------------------
// mergeMiniAgentTomlMcpConfig(existingContent, scriptPath) -> out text.
// ---------------------------------------------------------------------------

fn bu_toml_entry(out: &BuText, name_p: ptr, name_l: u64, script_p: ptr, script_l: u64) -> void {
    bu_push_lit(out, STR_PTR("[mcp_servers."), STR_LEN("[mcp_servers."));
    bu_push(out, name_p, name_l);
    bu_push_lit(out, STR_PTR("]\ncommand = \"node\"\nargs = ["), STR_LEN("]\ncommand = \"node\"\nargs = ["));
    bu_json_quote(out, script_p, script_l);
    bu_push_lit(out, STR_PTR("]\nstartup_timeout_sec = 30\n"), STR_LEN("]\nstartup_timeout_sec = 30\n"));
}

fn mergeMiniAgentTomlMcpConfig(existing_ptr: ptr, existing_len: u64, script_ptr: ptr, script_len: u64, out: &BuText) -> u64 {
    out.len = 0;
    let content = BuText { bytes: [0u8; 65536], len: 0 };
    bu_trim_copy(&content, existing_ptr, existing_len);
    let cp: ptr = bu_text_ptr(&content);
    if content.len == 0 {
        bu_push_lit(out, STR_PTR("[agent]\nname = \"mini-agent\"\nuser_agent = \"mini-agent/0.2.176\"\n\n"), STR_LEN("[agent]\nname = \"mini-agent\"\nuser_agent = \"mini-agent/0.2.176\"\n\n"));
        if isJevMcpEnabled() {
            bu_toml_entry(out, STR_PTR("jev"), STR_LEN("jev"), script_ptr, script_len);
            bu_push_lit(out, STR_PTR("\n"), STR_LEN("\n"));
        };
        bu_toml_entry(out, STR_PTR("sa-vm"), STR_LEN("sa-vm"), script_ptr, script_len);
        return out.len;
    };
    if isJevMcpEnabled() {
        if !bu_contains(cp, content.len, STR_PTR("[mcp_servers.jev]"), STR_LEN("[mcp_servers.jev]")) {
            bu_push(out, cp, content.len);
            bu_push_lit(out, STR_PTR("\n\n"), STR_LEN("\n\n"));
            bu_toml_entry(out, STR_PTR("jev"), STR_LEN("jev"), script_ptr, script_len);
            content.len = 0;
            bu_push(&content, bu_text_ptr(out), out.len);
            cp = bu_text_ptr(&content);
        } else {
            bu_push(out, cp, content.len);
        };
    } else {
        let stripped = BuText { bytes: [0u8; 65536], len: 0 };
        stripSelfManagedTomlServer(cp, content.len, STR_PTR("jev"), STR_LEN("jev"), &stripped);
        bu_push(out, bu_text_ptr(&stripped), stripped.len);
    };
    // append sa-vm when absent (content.trimEnd() + "\n\n" + entry)
    let op: ptr = bu_text_ptr(out);
    if !bu_contains(op, out.len, STR_PTR("[mcp_servers.sa-vm]"), STR_LEN("[mcp_servers.sa-vm]")) {
        // trimEnd of current out
        while out.len > 0 && bu_is_ws(bu_byte(op, out.len - 1)) { out.len = out.len - 1; }
        bu_push_lit(out, STR_PTR("\n\n"), STR_LEN("\n\n"));
        bu_toml_entry(out, STR_PTR("sa-vm"), STR_LEN("sa-vm"), script_ptr, script_len);
    };
    if out.len == 0 { return 0; };
    if bu_byte(bu_text_ptr(out), out.len - 1) != 10 {
        bu_push_lit(out, STR_PTR("\n"), STR_LEN("\n"));
    };
    return out.len;
}

// ---------------------------------------------------------------------------
// upsertSaVmMcpServerJsonFile(confPath, scriptPath) -> 0 ok / -1 (the TS
// throw path: missing or invalid JSON config).
// ---------------------------------------------------------------------------

fn upsertSaVmMcpServerJsonFile(conf_path_ptr: ptr, conf_path_len: u64, script_path_ptr: ptr, script_path_len: u64) -> i32 {
    if !bu_exists(conf_path_ptr, conf_path_len) { return -1; };
    let raw = BuText { bytes: [0u8; 65536], len: 0 };
    if !bu_read_text(conf_path_ptr, conf_path_len, &raw) { return -1; };
    let doc: u64 = 0;
    // TS: parseJsonObjectConfig(await readFile(...)) — throws on bad input.
    let rp: ptr = bu_text_ptr(&raw);
    let rn: u64 = raw.len;
    if rn >= 3 {
        if bu_byte(rp, 0) == 239 && bu_byte(rp, 1) == 187 && bu_byte(rp, 2) == 191 {
            let np: ptr = PTR_NULL();
            PTR_BYTE_ADD(np, rp, 3);
            rp = np;
            rn = rn - 3;
        };
    };
    doc = bu_parse(rp, rn);
    if doc == 0 { return -1; };
    if !bu_is_obj(doc) {
        bu_free_doc(doc);
        return -1;
    };
    let servers = bu_ensure_obj_field(doc, STR_PTR("mcpServers"), STR_LEN("mcpServers"));
    if servers == 0 {
        bu_free_doc(doc);
        return -1;
    };
    bu_apply_jev(servers, script_path_ptr, script_path_len, 0);
    bu_set_savm(servers, script_path_ptr, script_path_len, 0);
    let text = BuText { bytes: [0u8; 65536], len: 0 };
    bu_stringify_into(doc, &text);
    bu_free_doc(doc);
    if bu_write_text(conf_path_ptr, conf_path_len, bu_text_ptr(&text), text.len) { return 0; };
    return -1;
}

// ---------------------------------------------------------------------------
// isClaudeCodeSaVmRegistered(getClaudeMcpOutput, scriptPath).
// ---------------------------------------------------------------------------

fn bu_field_value(text_p: ptr, text_l: u64, prefix_p: ptr, prefix_l: u64, out: &BuText) -> void {
    out.len = 0;
    let pos: u64 = 0;
    while pos <= text_l {
        let le = pos;
        while le < text_l && bu_byte(text_p, le) != 10 { le = le + 1; }
        let lend = le;
        if lend > pos {
            if bu_byte(text_p, lend - 1) == 13 { lend = lend - 1; };
        };
        // trimmed line
        let a = pos;
        let b = lend;
        while a < b && bu_is_ws(bu_byte(text_p, a)) { a = a + 1; }
        while b > a && bu_is_ws(bu_byte(text_p, b - 1)) { b = b - 1; }
        if b - a >= prefix_l {
            let ok = true;
            let i: u64 = 0;
            while i < prefix_l {
                if bu_byte(text_p, a + i) != bu_byte(prefix_p, i) { ok = false; break; };
                i = i + 1;
            }
            if ok {
                let vs = a + prefix_l;
                while vs < b && (bu_byte(text_p, vs) == 32 || bu_byte(text_p, vs) == 9) { vs = vs + 1; }
                let vp: ptr = PTR_NULL();
                PTR_BYTE_ADD(vp, text_p, vs);
                bu_push(out, vp, b - vs);
                return;
            };
        };
        if le >= text_l { break; };
        pos = le + 1;
    }
}

fn isClaudeCodeSaVmRegistered(output_ptr: ptr, output_len: u64, script_ptr: ptr, script_len: u64) -> bool {
    let scope = BuText { bytes: [0u8; 65536], len: 0 };
    bu_field_value(output_ptr, output_len, STR_PTR("Scope:"), STR_LEN("Scope:"), &scope);
    let sp: ptr = bu_text_ptr(&scope);
    if !(bu_eq(sp, scope.len, STR_PTR("User config"), STR_LEN("User config")) || bu_eq(sp, scope.len, STR_PTR("User"), STR_LEN("User"))) {
        return false;
    };
    let cmd = BuText { bytes: [0u8; 65536], len: 0 };
    bu_field_value(output_ptr, output_len, STR_PTR("Command:"), STR_LEN("Command:"), &cmd);
    let cp: ptr = bu_text_ptr(&cmd);
    if !(bu_eq(cp, cmd.len, STR_PTR("node"), STR_LEN("node")) || bu_eq(cp, cmd.len, STR_PTR("node.exe"), STR_LEN("node.exe"))) {
        return false;
    };
    let args = BuText { bytes: [0u8; 65536], len: 0 };
    bu_field_value(output_ptr, output_len, STR_PTR("Args:"), STR_LEN("Args:"), &args);
    // join(args.split(/\s+/)) === scriptPath, exact TS comparison
    let joined = BuText { bytes: [0u8; 65536], len: 0 };
    let ap: ptr = bu_text_ptr(&args);
    let i: u64 = 0;
    while i < args.len {
        let b = bu_byte(ap, i);
        if !bu_is_ws(b) {
            if joined.len < 65536 { joined.bytes[joined.len] = b; joined.len = joined.len + 1; };
        };
        i = i + 1;
    }
    return bu_eq(bu_text_ptr(&joined), joined.len, script_ptr, script_len);
}

// ---------------------------------------------------------------------------
// runClaudeCli(argsJson) — defect #1 workaround spawn (run + try_wait poll +
// drain). Returns 0 = exit code 0, 1 = nonzero exit/spawn error with output,
// 2 = spawn failure (the TS ENOENT/"unavailable" branch approximation).
// argsJson is a JSON array of strings; "claude" is prepended.
// ---------------------------------------------------------------------------

fn bu_drain(handle: u64, which: u64, buf: &BuText) -> void {
    let chunk: [u8; 8192] = [0u8; 8192];
    let cp: ptr = PTR_NULL();
    PTR_BYTE_ADD(cp, &chunk, 0);
    let draining = true;
    while draining {
        let rn: u64 = 0;
        let st: i32 = 0;
        if which == 0 {
            st = sa_std_process_read_stdout(handle, cp, 8192, &rn);
        } else {
            st = sa_std_process_read_stderr(handle, cp, 8192, &rn);
        };
        if rn == 0 { break; };
        bu_push(buf, cp, rn);
        if st != 0 { break; };
    }
}

fn runClaudeCli(args_json_ptr: ptr, args_json_len: u64, out: &BuText, err_out: &BuText) -> i32 {
    out.len = 0;
    err_out.len = 0;
    let args_doc = bu_parse(args_json_ptr, args_json_len);
    if args_doc == 0 { return 2; };
    let given: u64 = 0;
    sa_json_value_count(args_doc, &given);
    if given > 20 {
        bu_free_doc(args_doc);
        return 2;
    };
    let full = bu_new_arr();
    if full == 0 {
        bu_free_doc(args_doc);
        return 2;
    };
    sa_json_array_push_string(full, STR_PTR("claude"), STR_LEN("claude"));
    let slots: [u64; 42] = [0; 42];
    let i: u64 = 0;
    let bad = false;
    while i < given {
        let el: u64 = 0;
        if sa_json_array_get(args_doc, i, &el) != 0 { bad = true; break; };
        if el == 0 { bad = true; break; };
        if sa_json_kind(el) != 5 { bad = true; break; };
        sa_json_array_push_string(full, sa_json_string_ptr(el), sa_json_string_len(el));
        i = i + 1;
    }
    if bad {
        bu_free_doc(full);
        bu_free_doc(args_doc);
        return 2;
    };
    let j: u64 = 0;
    while j < given + 1 {
        let el: u64 = 0;
        if sa_json_array_get(full, j, &el) != 0 { bad = true; break; };
        if el == 0 { bad = true; break; };
        PROCESS_ARGV_SET_PTR(&slots, j, sa_json_string_ptr(el), sa_json_string_len(el));
        j = j + 1;
    }
    if bad {
        bu_free_doc(full);
        bu_free_doc(args_doc);
        return 2;
    };
    let sp: ptr = PTR_NULL();
    PTR_BYTE_ADD(sp, &slots, 0);
    let handle: u64 = 0;
    let rst = sa_std_process_run(sp, given + 1, &handle);
    bu_free_doc(full);
    bu_free_doc(args_doc);
    if rst != 0 { return 2; };
    let elapsed: u64 = 0;
    let code: i32 = 0;
    let done = false;
    let timed_out = false;
    while !done {
        let rdy: bool = false;
        let c: i32 = 0;
        let wst = sa_std_process_try_wait(handle, &rdy, &c);
        if wst == 0 {
            if rdy {
                done = true;
                code = c;
                break;
            };
        };
        if elapsed >= 30000 {
            timed_out = true;
            sa_std_process_kill(handle);
            let wc: i32 = 0;
            sa_std_process_wait(handle, &wc);
            break;
        };
        sa_time_sleep_ms(5);
        elapsed = elapsed + 5;
    }
    bu_drain(handle, 0, out);
    bu_drain(handle, 1, err_out);
    sa_std_process_close(handle);
    if timed_out { return 1; };
    if code != 0 { return 1; };
    return 0;
}

// ---------------------------------------------------------------------------
// ensureClaudeCodeSaVmRegistered(scriptPath) ->
//   0 added / 1 updated / 2 unchanged / 3 unavailable.
// ---------------------------------------------------------------------------

fn ensureClaudeCodeSaVmRegistered(script_ptr: ptr, script_len: u64) -> i32 {
    let get_out = BuText { bytes: [0u8; 65536], len: 0 };
    let get_err = BuText { bytes: [0u8; 65536], len: 0 };
    let rc = runClaudeCli(STR_PTR("[\"mcp\",\"get\",\"sa-vm\"]"), STR_LEN("[\"mcp\",\"get\",\"sa-vm\"]"), &get_out, &get_err);
    if rc == 2 { return 3; };
    let current_null = rc != 0;
    if !current_null {
        if isClaudeCodeSaVmRegistered(bu_text_ptr(&get_out), get_out.len, script_ptr, script_len) {
            return 2;
        };
        let o2 = BuText { bytes: [0u8; 65536], len: 0 };
        let e2 = BuText { bytes: [0u8; 65536], len: 0 };
        runClaudeCli(STR_PTR("[\"mcp\",\"remove\",\"sa-vm\",\"-s\",\"user\"]"), STR_LEN("[\"mcp\",\"remove\",\"sa-vm\",\"-s\",\"user\"]"), &o2, &e2);
    };
    let aj = BuText { bytes: [0u8; 65536], len: 0 };
    bu_push_lit(&aj, STR_PTR("[\"mcp\",\"add\",\"-s\",\"user\",\"sa-vm\",\"--\",\"node\","), STR_LEN("[\"mcp\",\"add\",\"-s\",\"user\",\"sa-vm\",\"--\",\"node\","));
    bu_json_quote(&aj, script_ptr, script_len);
    bu_push_lit(&aj, STR_PTR("]"), STR_LEN("]"));
    let o3 = BuText { bytes: [0u8; 65536], len: 0 };
    let e3 = BuText { bytes: [0u8; 65536], len: 0 };
    runClaudeCli(bu_text_ptr(&aj), aj.len, &o3, &e3);
    if current_null { return 0; };
    return 1;
}

// ---------------------------------------------------------------------------
// registerProjectMiniAgentConfig(cwd, scriptPath). Per-step try blocks of
// the TS source are mirrored: steps 1-2 propagate (-1), steps 3-4 skip on
// parse failure, step 5 (.mcp.json) swallows everything.
// ---------------------------------------------------------------------------

fn bu_pb_to_path(pb: &PathBuf, out: &BuPath) -> void {
    out.len = 0;
    let p: ptr = PTR_NULL();
    PTR_BYTE_ADD(p, &pb.bytes, 0);
    bu_push_path(out, p, pb.len);
}

fn bu_write_if_changed(path: &BuPath, next: &BuText, prev_p: ptr, prev_l: u64) -> bool {
    if bu_eq(bu_text_ptr(next), next.len, prev_p, prev_l) { return true; };
    return bu_write_text(bu_path_ptr(path), path.len, bu_text_ptr(next), next.len);
}

// Parse a config file softly: object doc or 0 (TS JSON.parse + object test
// inside try). Caller frees.
fn bu_read_obj_doc(path: &BuPath) -> u64 {
    let raw = BuText { bytes: [0u8; 65536], len: 0 };
    if !bu_read_text(bu_path_ptr(path), path.len, &raw) { return 0; };
    let doc = bu_parse(bu_text_ptr(&raw), raw.len);
    if doc == 0 { return 0; };
    if !bu_is_obj(doc) {
        bu_free_doc(doc);
        return 0;
    };
    return doc;
}

fn registerProjectMiniAgentConfig(cwd_ptr: ptr, cwd_len: u64, script_ptr: ptr, script_len: u64) -> i32 {
    let root = BuPath { bytes: [0u8; 1024], len: 0 };
    bu_push_path(&root, cwd_ptr, cwd_len);
    let mini_dir = BuPath { bytes: [0u8; 1024], len: 0 };
    bu_join(&mini_dir, bu_path_ptr(&root), root.len, STR_PTR(".mini-agent"), STR_LEN(".mini-agent"));
    bu_mkdir_p(bu_path_ptr(&mini_dir), mini_dir.len);

    // 1. .mini-agent/config.toml
    let toml_path = BuPath { bytes: [0u8; 1024], len: 0 };
    bu_join(&toml_path, bu_path_ptr(&mini_dir), mini_dir.len, STR_PTR("config.toml"), STR_LEN("config.toml"));
    let existing_toml = BuText { bytes: [0u8; 65536], len: 0 };
    if bu_exists(bu_path_ptr(&toml_path), toml_path.len) {
        bu_read_text(bu_path_ptr(&toml_path), toml_path.len, &existing_toml);
    };
    let merged_toml = BuText { bytes: [0u8; 65536], len: 0 };
    mergeMiniAgentTomlMcpConfig(bu_text_ptr(&existing_toml), existing_toml.len, script_ptr, script_len, &merged_toml);
    if !bu_write_if_changed(&toml_path, &merged_toml, bu_text_ptr(&existing_toml), existing_toml.len) { return -1; };

    // 2. .mini-agent/config.json
    let json_path = BuPath { bytes: [0u8; 1024], len: 0 };
    bu_join(&json_path, bu_path_ptr(&mini_dir), mini_dir.len, STR_PTR("config.json"), STR_LEN("config.json"));
    let existing_json = BuText { bytes: [0u8; 65536], len: 0 };
    bu_push_lit(&existing_json, STR_PTR("{}"), STR_LEN("{}"));
    if bu_exists(bu_path_ptr(&json_path), json_path.len) {
        let doc = bu_read_obj_doc(&json_path);
        if doc != 0 {
            bu_stringify_into(doc, &existing_json);
            bu_free_doc(doc);
        };
    };
    let merged_json = BuText { bytes: [0u8; 65536], len: 0 };
    mergeMcpServersJsonConfig(bu_text_ptr(&existing_json), existing_json.len, script_ptr, script_len, &merged_json);
    if !bu_write_text(bu_path_ptr(&json_path), json_path.len, bu_text_ptr(&merged_json), merged_json.len) { return -1; };

    // 3. opencode.json (only when present; parse failure skips the step)
    let oc_path = BuPath { bytes: [0u8; 1024], len: 0 };
    bu_join(&oc_path, bu_path_ptr(&root), root.len, STR_PTR("opencode.json"), STR_LEN("opencode.json"));
    if bu_exists(bu_path_ptr(&oc_path), oc_path.len) {
        let raw = BuText { bytes: [0u8; 65536], len: 0 };
        if bu_read_text(bu_path_ptr(&oc_path), oc_path.len, &raw) {
            let chk = bu_parse(bu_text_ptr(&raw), raw.len);
            if chk != 0 {
                bu_free_doc(chk);
                let merged = BuText { bytes: [0u8; 65536], len: 0 };
                mergeOpencodeMcpConfig(bu_text_ptr(&raw), raw.len, script_ptr, script_len, &merged);
                bu_write_text(bu_path_ptr(&oc_path), oc_path.len, bu_text_ptr(&merged), merged.len);
            };
        };
    };

    // 4. mcp.json (only when present; parse failure skips the step)
    let mcp_path = BuPath { bytes: [0u8; 1024], len: 0 };
    bu_join(&mcp_path, bu_path_ptr(&root), root.len, STR_PTR("mcp.json"), STR_LEN("mcp.json"));
    if bu_exists(bu_path_ptr(&mcp_path), mcp_path.len) {
        let raw = BuText { bytes: [0u8; 65536], len: 0 };
        if bu_read_text(bu_path_ptr(&mcp_path), mcp_path.len, &raw) {
            let chk = bu_parse(bu_text_ptr(&raw), raw.len);
            if chk != 0 {
                bu_free_doc(chk);
                let merged = BuText { bytes: [0u8; 65536], len: 0 };
                mergeMcpServersJsonConfig(bu_text_ptr(&raw), raw.len, script_ptr, script_len, &merged);
                bu_write_text(bu_path_ptr(&mcp_path), mcp_path.len, bu_text_ptr(&merged), merged.len);
            };
        };
    };

    // 5. .mcp.json (always; whole step guarded like the TS try/catch)
    let dot_path = BuPath { bytes: [0u8; 1024], len: 0 };
    bu_join(&dot_path, bu_path_ptr(&root), root.len, STR_PTR(".mcp.json"), STR_LEN(".mcp.json"));
    let conf = bu_new_obj();
    if bu_exists(bu_path_ptr(&dot_path), dot_path.len) {
        let parsed = bu_read_obj_doc(&dot_path);
        if parsed != 0 {
            bu_free_doc(conf);
            conf = parsed;
        };
    };
    if conf != 0 {
        let servers = bu_ensure_obj_field(conf, STR_PTR("mcpServers"), STR_LEN("mcpServers"));
        if servers != 0 {
            bu_apply_jev(servers, script_ptr, script_len, 0);
            bu_set_savm(servers, script_ptr, script_len, 0);
            let text = BuText { bytes: [0u8; 65536], len: 0 };
            bu_stringify_into(conf, &text);
            bu_write_text(bu_path_ptr(&dot_path), dot_path.len, bu_text_ptr(&text), text.len);
        };
        bu_free_doc(conf);
    };
    return 0;
}

// ---------------------------------------------------------------------------
// Bundle installers.
// ---------------------------------------------------------------------------

fn resolveBuiltinSaVmSourceRoot(out_root: &BuPath) -> u64 {
    out_root.len = 0;
    return 0;
}

fn ensureSaVmProjectBundleInstalled(cwd_ptr: ptr, cwd_len: u64, force: bool, has_source_root: bool, source_root_ptr: ptr, source_root_len: u64, out: &BundleResult) -> i32 {
    let target_pb = PathBuf { bytes: [0u8; 4096], len: 0 };
    getSaVmProjectDataDir(cwd_ptr, cwd_len, &target_pb);
    let target = BuPath { bytes: [0u8; 1024], len: 0 };
    bu_pb_to_path(&target_pb, &target);
    let script = BuPath { bytes: [0u8; 1024], len: 0 };
    bu_join(&script, bu_path_ptr(&target), target.len, STR_PTR("sa-vm-mcp.mjs"), STR_LEN("sa-vm-mcp.mjs"));
    let sp: ptr = bu_path_ptr(&script);
    bu_mkdir_p(bu_path_ptr(&target), target.len);
    let version_path = BuPath { bytes: [0u8; 1024], len: 0 };
    bu_join(&version_path, bu_path_ptr(&target), target.len, STR_PTR(".bundle-version"), STR_LEN(".bundle-version"));
    let version_ok = false;
    if bu_exists(bu_path_ptr(&version_path), version_path.len) {
        let vt = BuText { bytes: [0u8; 65536], len: 0 };
        if bu_read_text(bu_path_ptr(&version_path), version_path.len, &vt) {
            let trimmed = BuText { bytes: [0u8; 65536], len: 0 };
            bu_trim_copy(&trimmed, bu_text_ptr(&vt), vt.len);
            version_ok = bu_eq(bu_text_ptr(&trimmed), trimmed.len, STR_PTR("6"), STR_LEN("6"));
        };
    };
    if !force {
        if version_ok {
            if bu_exists(sp, script.len) {
                registerProjectMiniAgentConfig(cwd_ptr, cwd_len, sp, script.len);
                out.scriptPath.len = 0;
                bu_push_path(&out.scriptPath, sp, script.len);
                out.installed = true;
                return 0;
            };
        };
    };
    // Candidate copy loop (DEFECT #18: items read by value; zero-length
    // items are skipped — the probe exercises this path directly).
    let candidates = SaVmCandidates { items: [PathBuf { bytes: [0u8; 4096], len: 0 }, PathBuf { bytes: [0u8; 4096], len: 0 }, PathBuf { bytes: [0u8; 4096], len: 0 }, PathBuf { bytes: [0u8; 4096], len: 0 }, PathBuf { bytes: [0u8; 4096], len: 0 }, PathBuf { bytes: [0u8; 4096], len: 0 }, PathBuf { bytes: [0u8; 4096], len: 0 }, PathBuf { bytes: [0u8; 4096], len: 0 }], count: 0 };
    resolveSaVmMcpSourceCandidates(source_root_ptr, source_root_len, has_source_root, &candidates);
    let i: u64 = 0;
    while i < candidates.count {
        let item = candidates.items[i];
        if item.len > 0 {
            let ip: ptr = PTR_NULL();
            PTR_BYTE_ADD(ip, &item.bytes, 0);
            if bu_exists(ip, item.len) {
                if !bu_eq(ip, item.len, sp, script.len) {
                    if bu_copy_file(ip, item.len, sp, script.len) { break; };
                };
            };
        };
        i = i + 1;
    }
    let installed = bu_exists(sp, script.len);
    if installed {
        bu_write_text(bu_path_ptr(&version_path), version_path.len, STR_PTR("6"), STR_LEN("6"));
        registerProjectMiniAgentConfig(cwd_ptr, cwd_len, sp, script.len);
    };
    out.scriptPath.len = 0;
    bu_push_path(&out.scriptPath, sp, script.len);
    out.installed = installed;
    return 0;
}

// ---------------------------------------------------------------------------
// ensureSaVmMcpInstalled(targetRoot, autoRegisterClients) + the global
// installer wrapper. TS try blocks map to guarded steps; a failed step is
// skipped without its clientsConfigured push, exactly as the source.
// ---------------------------------------------------------------------------

fn bu_upsert_step(out: &BundleResult, kind_p: ptr, kind_l: u64, conf: &BuPath, script_p: ptr, script_l: u64) -> void {
    let dir = BuPath { bytes: [0u8; 1024], len: 0 };
    bu_dirname(bu_path_ptr(conf), conf.len, &dir);
    bu_mkdir_p(bu_path_ptr(&dir), dir.len);
    if upsertSaVmMcpServerJsonFile(bu_path_ptr(conf), conf.len, script_p, script_l) == 0 {
        bu_client_push(out, kind_p, kind_l, bu_path_ptr(conf), conf.len);
    };
}

// Strict object load mirroring parseJsonObjectConfig: 0 doc on throw.
fn bu_read_obj_doc_strict(path: &BuPath) -> u64 {
    if !bu_exists(bu_path_ptr(path), path.len) { return 0; };
    let raw = BuText { bytes: [0u8; 65536], len: 0 };
    if !bu_read_text(bu_path_ptr(path), path.len, &raw) { return 0; };
    let canon = BuText { bytes: [0u8; 65536], len: 0 };
    if parseJsonObjectConfig(bu_text_ptr(&raw), raw.len, &canon) != 0 { return 0; };
    return bu_parse(bu_text_ptr(&canon), canon.len);
}

fn ensureSaVmMcpInstalled(target_ptr: ptr, target_len: u64, auto_register: bool, out: &BundleResult) -> i32 {
    out.clientsConfigured_len = 0;
    out.installed = false;
    let target = BuPath { bytes: [0u8; 1024], len: 0 };
    bu_push_path(&target, target_ptr, target_len);
    let script = BuPath { bytes: [0u8; 1024], len: 0 };
    bu_join(&script, target_ptr, target_len, STR_PTR("sa-vm-mcp.mjs"), STR_LEN("sa-vm-mcp.mjs"));
    let sp: ptr = bu_path_ptr(&script);
    out.scriptPath.len = 0;
    bu_push_path(&out.scriptPath, sp, script.len);
    bu_mkdir_p(target_ptr, target_len);

    // Source copy: builtin root is null, so the repo candidate branch runs.
    let pwd = BuPath { bytes: [0u8; 1024], len: 0 };
    if bu_pwd(&pwd) {
        let scripts_dir = BuPath { bytes: [0u8; 1024], len: 0 };
        bu_join(&scripts_dir, bu_path_ptr(&pwd), pwd.len, STR_PTR("scripts"), STR_LEN("scripts"));
        let repo_script = BuPath { bytes: [0u8; 1024], len: 0 };
        bu_join(&repo_script, bu_path_ptr(&scripts_dir), scripts_dir.len, STR_PTR("sa-vm-mcp.mjs"), STR_LEN("sa-vm-mcp.mjs"));
        let rp: ptr = bu_path_ptr(&repo_script);
        if bu_exists(rp, repo_script.len) {
            if !bu_eq(rp, repo_script.len, sp, script.len) {
                if !bu_copy_file(rp, repo_script.len, sp, script.len) { return -1; };
            };
        };
        // Pi extension copy is inside its own TS try/catch: failures pass.
        let repo_pi = BuPath { bytes: [0u8; 1024], len: 0 };
        bu_join(&repo_pi, bu_path_ptr(&scripts_dir), scripts_dir.len, STR_PTR("sa-vm-pi-extension.ts"), STR_LEN("sa-vm-pi-extension.ts"));
        let pi_target = BuPath { bytes: [0u8; 1024], len: 0 };
        bu_join(&pi_target, target_ptr, target_len, STR_PTR("sa-vm-pi-extension.ts"), STR_LEN("sa-vm-pi-extension.ts"));
        let pp: ptr = bu_path_ptr(&repo_pi);
        if bu_exists(pp, repo_pi.len) {
            if !bu_eq(pp, repo_pi.len, bu_path_ptr(&pi_target), pi_target.len) {
                bu_copy_file(pp, repo_pi.len, bu_path_ptr(&pi_target), pi_target.len);
            };
        };
    };

    let installed = bu_exists(sp, script.len);
    out.installed = installed;
    if !installed { return 0; };
    if !auto_register { return 0; };

    let home = BuPath { bytes: [0u8; 1024], len: 0 };
    if !bu_home(&home) { return 0; };
    let hp: ptr = bu_path_ptr(&home);

    // Gemini (two config locations).
    let g1_dir = BuPath { bytes: [0u8; 1024], len: 0 };
    bu_join(&g1_dir, hp, home.len, STR_PTR(".gemini"), STR_LEN(".gemini"));
    let g1 = BuPath { bytes: [0u8; 1024], len: 0 };
    bu_join(&g1, bu_path_ptr(&g1_dir), g1_dir.len, STR_PTR("settings.json"), STR_LEN("settings.json"));
    bu_upsert_step(out, STR_PTR("gemini"), STR_LEN("gemini"), &g1, sp, script.len);
    let g2_mid = BuPath { bytes: [0u8; 1024], len: 0 };
    bu_join(&g2_mid, hp, home.len, STR_PTR(".config"), STR_LEN(".config"));
    let g2_dir = BuPath { bytes: [0u8; 1024], len: 0 };
    bu_join(&g2_dir, bu_path_ptr(&g2_mid), g2_mid.len, STR_PTR("gemini"), STR_LEN("gemini"));
    let g2 = BuPath { bytes: [0u8; 1024], len: 0 };
    bu_join(&g2, bu_path_ptr(&g2_dir), g2_dir.len, STR_PTR("settings.json"), STR_LEN("settings.json"));
    bu_upsert_step(out, STR_PTR("gemini"), STR_LEN("gemini"), &g2, sp, script.len);

    // Claude Desktop (only when its config dir already exists). Its jev
    // entry is unconditional in the TS source (legacy shape, preserved).
    let cd_dir = BuPath { bytes: [0u8; 1024], len: 0 };
    bu_join(&cd_dir, bu_path_ptr(&g2_mid), g2_mid.len, STR_PTR("Claude"), STR_LEN("Claude"));
    if bu_exists(bu_path_ptr(&cd_dir), cd_dir.len) {
        let cd_conf = BuPath { bytes: [0u8; 1024], len: 0 };
        bu_join(&cd_conf, bu_path_ptr(&cd_dir), cd_dir.len, STR_PTR("claude_desktop_config.json"), STR_LEN("claude_desktop_config.json"));
        let doc = bu_new_obj();
        let usable = true;
        if bu_exists(bu_path_ptr(&cd_conf), cd_conf.len) {
            let strict = bu_read_obj_doc_strict(&cd_conf);
            if strict == 0 { usable = false; } else { bu_free_doc(doc); doc = strict; };
        };
        if usable {
            let servers = bu_ensure_obj_field(doc, STR_PTR("mcpServers"), STR_LEN("mcpServers"));
            if servers != 0 {
                let jev = bu_cmd_node(sp, script.len, false, false);
                if jev != 0 {
                    sa_json_object_set_node(servers, STR_PTR("jev"), STR_LEN("jev"), jev);
                    bu_free_doc(jev);
                };
                bu_set_savm(servers, sp, script.len, 0);
                let text = BuText { bytes: [0u8; 65536], len: 0 };
                bu_stringify_into(doc, &text);
                if bu_write_text(bu_path_ptr(&cd_conf), cd_conf.len, bu_text_ptr(&text), text.len) {
                    bu_client_push(out, STR_PTR("claude"), STR_LEN("claude"), bu_path_ptr(&cd_conf), cd_conf.len);
                };
            };
        };
        bu_free_doc(doc);
    };

    // Grok TOML.
    let grok_dir = BuPath { bytes: [0u8; 1024], len: 0 };
    bu_join(&grok_dir, hp, home.len, STR_PTR(".grok"), STR_LEN(".grok"));
    bu_mkdir_p(bu_path_ptr(&grok_dir), grok_dir.len);
    let grok_conf = BuPath { bytes: [0u8; 1024], len: 0 };
    bu_join(&grok_conf, bu_path_ptr(&grok_dir), grok_dir.len, STR_PTR("config.toml"), STR_LEN("config.toml"));
    let grok_content = BuText { bytes: [0u8; 65536], len: 0 };
    if bu_exists(bu_path_ptr(&grok_conf), grok_conf.len) {
        bu_read_text(bu_path_ptr(&grok_conf), grok_conf.len, &grok_content);
    };
    if !bu_contains(bu_text_ptr(&grok_content), grok_content.len, STR_PTR("[mcp_servers.sa-vm]"), STR_LEN("[mcp_servers.sa-vm]")) {
        let entry = BuText { bytes: [0u8; 65536], len: 0 };
        bu_push_lit(&entry, STR_PTR("\n[mcp_servers.sa-vm]\ncommand = \"node\"\nargs = ["), STR_LEN("\n[mcp_servers.sa-vm]\ncommand = \"node\"\nargs = ["));
        bu_json_quote(&entry, sp, script.len);
        bu_push_lit(&entry, STR_PTR("]\nenabled = true\n"), STR_LEN("]\nenabled = true\n"));
        let next = BuText { bytes: [0u8; 65536], len: 0 };
        if grok_content.len > 0 {
            let trimmed = BuText { bytes: [0u8; 65536], len: 0 };
            bu_push(&trimmed, bu_text_ptr(&grok_content), grok_content.len);
            while trimmed.len > 0 && bu_is_ws(bu_byte(bu_text_ptr(&trimmed), trimmed.len - 1)) { trimmed.len = trimmed.len - 1; }
            bu_push(&next, bu_text_ptr(&trimmed), trimmed.len);
            bu_push_lit(&next, STR_PTR("\n"), STR_LEN("\n"));
        };
        bu_push(&next, bu_text_ptr(&entry), entry.len);
        if bu_write_text(bu_path_ptr(&grok_conf), grok_conf.len, bu_text_ptr(&next), next.len) {
            bu_client_push(out, STR_PTR("grok"), STR_LEN("grok"), bu_path_ptr(&grok_conf), grok_conf.len);
        };
    };

    // Opencode global config.
    let oc_dir_mid = BuPath { bytes: [0u8; 1024], len: 0 };
    bu_join(&oc_dir_mid, bu_path_ptr(&g2_mid), g2_mid.len, STR_PTR("opencode"), STR_LEN("opencode"));
    bu_mkdir_p(bu_path_ptr(&oc_dir_mid), oc_dir_mid.len);
    let oc_conf = BuPath { bytes: [0u8; 1024], len: 0 };
    bu_join(&oc_conf, bu_path_ptr(&oc_dir_mid), oc_dir_mid.len, STR_PTR("config.json"), STR_LEN("config.json"));
    let oc_usable = true;
    let oc_text_in = BuText { bytes: [0u8; 65536], len: 0 };
    bu_push_lit(&oc_text_in, STR_PTR("{}"), STR_LEN("{}"));
    if bu_exists(bu_path_ptr(&oc_conf), oc_conf.len) {
        let raw = BuText { bytes: [0u8; 65536], len: 0 };
        if bu_read_text(bu_path_ptr(&oc_conf), oc_conf.len, &raw) {
            if parseJsonObjectConfig(bu_text_ptr(&raw), raw.len, &oc_text_in) != 0 { oc_usable = false; };
        } else {
            oc_usable = false;
        };
    };
    if oc_usable {
        let merged = BuText { bytes: [0u8; 65536], len: 0 };
        mergeOpencodeMcpConfig(bu_text_ptr(&oc_text_in), oc_text_in.len, sp, script.len, &merged);
        if bu_write_text(bu_path_ptr(&oc_conf), oc_conf.len, bu_text_ptr(&merged), merged.len) {
            bu_client_push(out, STR_PTR("opencode"), STR_LEN("opencode"), bu_path_ptr(&oc_conf), oc_conf.len);
        };
    };

    // Mini-agent global home: TOML then JSON (separate failure domains in
    // effect — the TS try wraps both, but the TOML write+push land first).
    let mini_home = BuPath { bytes: [0u8; 1024], len: 0 };
    if !bu_env_path(STR_PTR("MINI_AGENT_HOME"), STR_LEN("MINI_AGENT_HOME"), &mini_home) {
        if !bu_env_path(STR_PTR("MINI_HOME"), STR_LEN("MINI_HOME"), &mini_home) {
            bu_join(&mini_home, hp, home.len, STR_PTR(".mini-agent"), STR_LEN(".mini-agent"));
        };
    };
    bu_mkdir_p(bu_path_ptr(&mini_home), mini_home.len);
    let m_toml = BuPath { bytes: [0u8; 1024], len: 0 };
    bu_join(&m_toml, bu_path_ptr(&mini_home), mini_home.len, STR_PTR("config.toml"), STR_LEN("config.toml"));
    let m_existing = BuText { bytes: [0u8; 65536], len: 0 };
    if bu_exists(bu_path_ptr(&m_toml), m_toml.len) {
        bu_read_text(bu_path_ptr(&m_toml), m_toml.len, &m_existing);
    };
    let m_merged = BuText { bytes: [0u8; 65536], len: 0 };
    mergeMiniAgentTomlMcpConfig(bu_text_ptr(&m_existing), m_existing.len, sp, script.len, &m_merged);
    if bu_write_if_changed(&m_toml, &m_merged, bu_text_ptr(&m_existing), m_existing.len) {
        if !bu_eq(bu_text_ptr(&m_merged), m_merged.len, bu_text_ptr(&m_existing), m_existing.len) {
            bu_client_push(out, STR_PTR("mini-agent"), STR_LEN("mini-agent"), bu_path_ptr(&m_toml), m_toml.len);
        };
    };
    let m_json = BuPath { bytes: [0u8; 1024], len: 0 };
    bu_join(&m_json, bu_path_ptr(&mini_home), mini_home.len, STR_PTR("config.json"), STR_LEN("config.json"));
    let m_usable = true;
    let m_text_in = BuText { bytes: [0u8; 65536], len: 0 };
    bu_push_lit(&m_text_in, STR_PTR("{}"), STR_LEN("{}"));
    if bu_exists(bu_path_ptr(&m_json), m_json.len) {
        let raw = BuText { bytes: [0u8; 65536], len: 0 };
        if bu_read_text(bu_path_ptr(&m_json), m_json.len, &raw) {
            if parseJsonObjectConfig(bu_text_ptr(&raw), raw.len, &m_text_in) != 0 { m_usable = false; };
        } else {
            m_usable = false;
        };
    };
    if m_usable {
        let merged = BuText { bytes: [0u8; 65536], len: 0 };
        mergeMcpServersJsonConfig(bu_text_ptr(&m_text_in), m_text_in.len, sp, script.len, &merged);
        if bu_write_text(bu_path_ptr(&m_json), m_json.len, bu_text_ptr(&merged), merged.len) {
            bu_client_push(out, STR_PTR("mini-agent"), STR_LEN("mini-agent"), bu_path_ptr(&m_json), m_json.len);
        };
    };

    // Claude Code via its CLI.
    let cc = ensureClaudeCodeSaVmRegistered(sp, script.len);
    if cc == 0 {
        bu_client_push(out, STR_PTR("claude-code"), STR_LEN("claude-code"), STR_PTR("added"), STR_LEN("added"));
    } else if cc == 1 {
        bu_client_push(out, STR_PTR("claude-code"), STR_LEN("claude-code"), STR_PTR("updated"), STR_LEN("updated"));
    } else if cc == 2 {
        bu_client_push(out, STR_PTR("claude-code"), STR_LEN("claude-code"), STR_PTR("unchanged"), STR_LEN("unchanged"));
    };

    // Pi extension install.
    let pi_ext = BuPath { bytes: [0u8; 1024], len: 0 };
    bu_join(&pi_ext, target_ptr, target_len, STR_PTR("sa-vm-pi-extension.ts"), STR_LEN("sa-vm-pi-extension.ts"));
    if bu_exists(bu_path_ptr(&pi_ext), pi_ext.len) {
        let pi_agent = BuPath { bytes: [0u8; 1024], len: 0 };
        if !bu_env_path(STR_PTR("PI_CODING_AGENT_DIR"), STR_LEN("PI_CODING_AGENT_DIR"), &pi_agent) {
            let pi_home = BuPath { bytes: [0u8; 1024], len: 0 };
            bu_join(&pi_home, hp, home.len, STR_PTR(".pi"), STR_LEN(".pi"));
            bu_join(&pi_agent, bu_path_ptr(&pi_home), pi_home.len, STR_PTR("agent"), STR_LEN("agent"));
        };
        let ext_dir = BuPath { bytes: [0u8; 1024], len: 0 };
        bu_join(&ext_dir, bu_path_ptr(&pi_agent), pi_agent.len, STR_PTR("extensions"), STR_LEN("extensions"));
        let savm_dir = BuPath { bytes: [0u8; 1024], len: 0 };
        bu_join(&savm_dir, bu_path_ptr(&ext_dir), ext_dir.len, STR_PTR("sa-vm"), STR_LEN("sa-vm"));
        let dest = BuPath { bytes: [0u8; 1024], len: 0 };
        bu_join(&dest, bu_path_ptr(&savm_dir), savm_dir.len, STR_PTR("index.ts"), STR_LEN("index.ts"));
        let next = BuText { bytes: [0u8; 65536], len: 0 };
        if bu_read_text(bu_path_ptr(&pi_ext), pi_ext.len, &next) {
            let prev = BuText { bytes: [0u8; 65536], len: 0 };
            let have_prev = false;
            if bu_exists(bu_path_ptr(&dest), dest.len) {
                have_prev = bu_read_text(bu_path_ptr(&dest), dest.len, &prev);
            };
            let differ = true;
            if have_prev {
                differ = !bu_eq(bu_text_ptr(&prev), prev.len, bu_text_ptr(&next), next.len);
            };
            if differ {
                bu_mkdir_p(bu_path_ptr(&savm_dir), savm_dir.len);
                if bu_write_text(bu_path_ptr(&dest), dest.len, bu_text_ptr(&next), next.len) {
                    bu_client_push(out, STR_PTR("pi"), STR_LEN("pi"), bu_path_ptr(&dest), dest.len);
                };
            };
        };
    };

    // Muse (two settings locations: ~/.config/muse, ~/.muse).
    let muse_dir1 = BuPath { bytes: [0u8; 1024], len: 0 };
    bu_join(&muse_dir1, bu_path_ptr(&g2_mid), g2_mid.len, STR_PTR("muse"), STR_LEN("muse"));
    bu_muse_write(out, &muse_dir1, sp, script.len);
    let muse_dir2 = BuPath { bytes: [0u8; 1024], len: 0 };
    bu_join(&muse_dir2, hp, home.len, STR_PTR(".muse"), STR_LEN(".muse"));
    bu_muse_write(out, &muse_dir2, sp, script.len);
    return 0;
}

fn bu_muse_write(out: &BundleResult, dir: &BuPath, script_p: ptr, script_l: u64) -> void {
    bu_mkdir_p(bu_path_ptr(dir), dir.len);
    let conf = BuPath { bytes: [0u8; 1024], len: 0 };
    bu_join(&conf, bu_path_ptr(dir), dir.len, STR_PTR("settings.json"), STR_LEN("settings.json"));
    let doc = bu_new_obj();
    if bu_exists(bu_path_ptr(&conf), conf.len) {
        let parsed = bu_read_obj_doc(&conf);
        if parsed != 0 {
            bu_free_doc(doc);
            doc = parsed;
        };
    };
    if doc == 0 { return; };
    let servers = bu_ensure_obj_field(doc, STR_PTR("mcpServers"), STR_LEN("mcpServers"));
    if servers != 0 {
        bu_apply_jev(servers, script_p, script_l, 0);
        bu_set_savm(servers, script_p, script_l, 4);
        let sv = bu_get_obj(doc, STR_PTR("schema_version"), STR_LEN("schema_version"));
        let is_num = false;
        if sv != 0 {
            let k = sa_json_kind(sv);
            is_num = k == 3 || k == 4 || k == 2;
        };
        if !is_num {
            sa_json_object_set_i64(doc, STR_PTR("schema_version"), STR_LEN("schema_version"), 1);
        };
        let text = BuText { bytes: [0u8; 65536], len: 0 };
        bu_stringify_into(doc, &text);
        if bu_write_text(bu_path_ptr(&conf), conf.len, bu_text_ptr(&text), text.len) {
            bu_client_push(out, STR_PTR("muse"), STR_LEN("muse"), bu_path_ptr(&conf), conf.len);
        };
    };
    bu_free_doc(doc);
}

fn ensureSaVmGlobalBundleInstalled(force: bool, has_target_root: bool, target_root_ptr: ptr, target_root_len: u64, auto_register: bool, out: &BundleResult) -> i32 {
    let target = BuPath { bytes: [0u8; 1024], len: 0 };
    if has_target_root {
        bu_push_path(&target, target_root_ptr, target_root_len);
    } else {
        let pb = PathBuf { bytes: [0u8; 4096], len: 0 };
        getSaVmGlobalDataDir(&pb);
        bu_pb_to_path(&pb, &target);
    };
    let inner = bu_result_new();
    ensureSaVmMcpInstalled(bu_path_ptr(&target), target.len, auto_register, &inner);
    out.scriptPath.len = 0;
    bu_push_path(&out.scriptPath, bu_path_ptr(&inner.scriptPath), inner.scriptPath.len);
    out.root.len = 0;
    bu_push_path(&out.root, bu_path_ptr(&target), target.len);
    // TS quirk preserved: the global installer always reports
    // installed = false (see the TS return statement).
    out.installed = false;
    out.clientsConfigured_len = 0;
    return 0;
}
