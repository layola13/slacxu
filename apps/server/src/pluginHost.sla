// Converted 1:1 from apps/server/src/pluginHost.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
// The server composition root for plugins. This is the ONLY place that knows
// the full plugin set; everything downstream consumes the registry or the
// projections below (catalog, CLI settings entries, discovery specs).
//
// BJ (2026-10-28): WIRING — the registry is real now. PluginHostRegistry
// embeds the sdk-backend ServerPluginRegistry by value (the bulk-era
// `registry: u64` placeholder predates the sdk unit being importable from
// here; the sdk registry's handles are "u64 into the host's plugin table"
// per its own header — here the handle IS the registration slot 0..11).
// Registration set and order are pluginHost.ts's serverPluginRegistry
// block verbatim: mini, codex, claude, agy, auggie, cline,
// command-code, grok, pi, opencode, opencode-v2, muse; the catalog-only
// manifests RELAY_CONFIG / JEV / VMTOOL_SECURITY / FREE_MODE / ENHANCE
// follow in allPluginManifests order (17 manifests total).
//
// Why the manifest texts and the cliSettings / discovery tables are
// transcribed at this registration point instead of imported from the
// backend units (registered seam, form only — the data and behavior are
// the TS ground truth):
// - the backend units are NOT co-importable into one compilation unit:
//   backends/codex/src/server.sla, backends/claude/src/server.sla and
//   backends/*/src/manifest.sla each define their own `struct
//   ServerPlugin` / `struct PluginManifest` and same-named free functions
//   (ServerPlugin_createEngine, ServerPlugin_findInstallations, ...),
//   so importing two of them collides. pluginHost.ts has exactly the
//   same shape in TS: it is the single registration point that reads
//   each plugin's declared values.
// - manifest JSON texts below are the plugins' plugin.json files inlined
//   verbatim (the same model as backends/mini's mini_manifest_json:
//   "inlined below; single source is the file on disk"), transcribed
//   mechanically from backends/<id>/plugin.json (+ frontends/enhance),
//   and parsed into manifest_docs at init; allPluginManifests serves
//   those docs, so id/kind/version/displayName/defaultInstalled always
//   agree with the files.
// - cliSettings values are transcribed from each backends/<b>/src/
//   server.ts cliSettings declaration (the SLA-side server.sla units
//   declare the same values; codex/claude record the byte lengths with
//   zero-filled arrays "filled by host init" — the host-side fill is
//   this table). Discovery binaryNames/envBinVars likewise from the
//   server.ts discovery blocks (the SLA accessor functions in the
//   backend units return the same strings).
// - REGISTERED SEAM: the sdk CliDiscoverySpec.matchesKind and
//   ServerPlugin.createEngine / findInstallations / skillRoots function
//   pointers stay PTR_NULL. The qualifier functions live in the
//   non-co-importable backend units; discovery DATA is delivered in
//   full (cliDiscoveryForKind), but kind-matching and engine creation
//   remain with the backend-host glue (BH/host-services scope), never
//   silently approximated here.
// - STORAGE FORM (defect-driven): the per-plugin cliSettings/discovery
//   values are the sdk CliSettingsDeclaration / CliDiscoverySpec data,
//   but they are NOT stored as [CliSettingsDeclaration; 12] /
//   [CliDiscoverySpec; 12]: in the current SAB backend, indexing an
//   array of structs (or of arrays) collapses every index to one
//   element at runtime — writes to slot k land in the same cell for
//   all k, proven by _defects/probes/bj_dbg2.sla and bj_dbg3.sla
//   (registered as a compiler defect for the BG line; flat primitive
//   arrays index correctly). The host therefore stores the texts in a
//   flat byte arena with (off, len) tables in primitive arrays — the
//   same idiom the sdk ServerPluginRegistry itself uses for its ids.
//   The data and behavior are unchanged; only the storage form bends
//   around the defect, and it returns to the sdk structs when the
//   backend is fixed.
// - pluginHostServices stays a commented import (below): its register
//   function is a stub and wiring it needs the sdk hostServices surface
//   plus cliVersions (BI) and codeCliBridge (BH) — out of BJ scope;
//   index.sla does not consume it.
// - LOCKED_PLUGIN_IDS = {"mini"} is declared by pluginHost.ts itself,
//   so it stays host-local here.
// Object-shaped results travel as JSON document handles (the server
// domain's model for pluginHost.ts's object/array/record returns).
@import "sa_std/io/print.sai"
@import "sa_std/ptr.sa"
@import "sa_std/string.sa"
@import "sa_std/encoding/json.sai"
@import "../../../sdk-backend/src/index.sla"
@import "./pluginInstallStore.sla"
// @import "pluginHostServices.sla" — REGISTERED SEAM (see header): stub
// register fn + BH/BI dependencies; not consumed by index.sla.

struct PluginCatalogEntry {
    id: [u8; 128],
    id_len: u64,
    kind: [u8; 32],
    kind_len: u64,
    version: [u8; 64],
    version_len: u64,
    displayName: [u8; 256],
    displayName_len: u64,
    defaultInstalled: bool,
    installed: bool,
    locked: bool,
}

struct CliSettingsEntry {
    pluginId: [u8; 128],
    pluginId_len: u64,
    slug: [u8; 64],
    slug_len: u64,
    enabledEnvVar: [u8; 128],
    enabledEnvVar_len: u64,
    has_linkKey: bool,
    linkKey: [u8; 128],
    linkKey_len: u64,
}

// PH_PLUGIN_COUNT = 12 (registry), PH_MANIFEST_COUNT = 17 (catalog).
struct PluginHostRegistry {
    registry: ServerPluginRegistry,
    manifest_docs: [u64; 17],
    // cliSettings + discovery storage (see STORAGE FORM note above):
    // one flat text arena; per-slot (off, len) in primitive arrays.
    text: [u8; 16384],
    text_len: u64,
    has_cliSettings: [bool; 12],
    set_slug_off: [u64; 12],
    set_slug_len: [u64; 12],
    set_env_off: [u64; 12],
    set_env_len: [u64; 12],
    set_link_off: [u64; 12],
    set_link_len: [u64; 12],
    set_has_link: [bool; 12],
    disc_names_off: [u64; 12],
    disc_names_len: [u64; 12],
    disc_names_count: [u64; 12],
    disc_env_off: [u64; 12],
    disc_env_len: [u64; 12],
    disc_env_count: [u64; 12],
    disc_pref_off: [u64; 12],
    disc_pref_len: [u64; 12],
    disc_has_pref: [bool; 12],
}

// Appends text to the host arena; returns the offset.
fn ph_text_push(r: &PluginHostRegistry, p: ptr, n: u64) -> u64 {
    let off = r.text_len;
    let i: u64 = 0;
    while i < n {
        if r.text_len < 16384 {
            let c: u8 = 0;
            PTR_BYTE_AT(c, p, i);
            r.text[r.text_len] = c;
            r.text_len = r.text_len + 1;
        };
        i = i + 1;
    }
    return off;
}

// (ptr) into the arena at a recorded offset.
fn ph_text_ptr(r: &PluginHostRegistry, off: u64) -> ptr {
    let p: ptr = PTR_NULL();
    PTR_BYTE_ADD(p, &r.text, off);
    return p;
}

fn pluginHost_alloc() -> PluginHostRegistry {
    return PluginHostRegistry {
        registry: ServerPluginRegistry {
            ids: [0u8; 8192],
            id_off: [0u64; 64],
            id_len: [0u64; 64],
            plugins: [0u64; 64],
            count: 0,
            arena_len: 0,
        },
        manifest_docs: [0u64; 17],
        text: [0u8; 16384],
        text_len: 0,
        has_cliSettings: [false; 12],
        set_slug_off: [0u64; 12],
        set_slug_len: [0u64; 12],
        set_env_off: [0u64; 12],
        set_env_len: [0u64; 12],
        set_link_off: [0u64; 12],
        set_link_len: [0u64; 12],
        set_has_link: [false; 12],
        disc_names_off: [0u64; 12],
        disc_names_len: [0u64; 12],
        disc_names_count: [0u64; 12],
        disc_env_off: [0u64; 12],
        disc_env_len: [0u64; 12],
        disc_env_count: [0u64; 12],
        disc_pref_off: [0u64; 12],
        disc_pref_len: [0u64; 12],
        disc_has_pref: [false; 12],
    };
}

fn ph_bytes_eq(a_ptr: ptr, a_len: u64, b_ptr: ptr, b_len: u64) -> bool {
    if a_len != b_len { return false; };
    let i: u64 = 0;
    while i < a_len {
        let x: u8 = 0;
        PTR_BYTE_AT(x, a_ptr, i);
        let y: u8 = 0;
        PTR_BYTE_AT(y, b_ptr, i);
        if x != y { return false; };
        i = i + 1;
    }
    return true;
}

fn ph_doc_get_string(doc: u64, key_ptr: ptr, key_len: u64, out_ptr: &ptr, out_len: &u64) -> bool {
    *out_len = 0;
    if doc == 0 || sa_json_kind(doc) != 7 { return false; };
    let child: u64 = 0;
    let st = sa_json_object_get(doc, key_ptr, key_len, &child);
    if st != 0 || child == 0 { return false; };
    if sa_json_kind(child) != 5 { return false; };
    let jp: ptr = sa_json_string_ptr(child);
    *out_ptr = jp;
    *out_len = sa_json_string_len(child);
    return true;
}

fn ph_doc_get_bool(doc: u64, key_ptr: ptr, key_len: u64, out: &bool) -> bool {
    *out = false;
    if doc == 0 || sa_json_kind(doc) != 7 { return false; };
    let v: u8 = 0;
    let st = sa_json_object_get_bool(doc, key_ptr, key_len, &v);
    if st != 0 { return false; };
    *out = v != 0;
    return true;
}

struct PhBuf {
    bytes: [u8; 8192],
    len: u64,
}

fn ph_buf_push(b: &PhBuf, p: ptr, n: u64) -> void {
    let i: u64 = 0;
    while i < n {
        if b.len < 8192 {
            let c: u8 = 0;
            PTR_BYTE_AT(c, p, i);
            b.bytes[b.len] = c;
            b.len = b.len + 1;
        };
        i = i + 1;
    }
}

fn ph_buf_byte(b: &PhBuf, c: u8) -> void {
    if b.len < 8192 {
        b.bytes[b.len] = c;
        b.len = b.len + 1;
    };
}

// Records one cliSettings declaration (sdk CliSettingsDeclaration data)
// into the arena tables for `slot`.
fn ph_fill_settings(r: &PluginHostRegistry, slot: u64, slug_ptr: ptr, slug_len: u64, env_ptr: ptr, env_len: u64, has_link: bool, link_ptr: ptr, link_len: u64) -> void {
    r.set_slug_off[slot] = ph_text_push(r, slug_ptr, slug_len);
    r.set_slug_len[slot] = slug_len;
    r.set_env_off[slot] = ph_text_push(r, env_ptr, env_len);
    r.set_env_len[slot] = env_len;
    r.set_link_off[slot] = ph_text_push(r, link_ptr, link_len);
    r.set_link_len[slot] = link_len;
    r.set_has_link[slot] = has_link;
    r.has_cliSettings[slot] = true;
}

// Records one discovery spec (sdk CliDiscoverySpec data, newline-joined
// flat form) into the arena tables for `slot`. matchesKind has no storage
// here — it is the registered seam (see the file header).
fn ph_fill_discovery(r: &PluginHostRegistry, slot: u64, names_ptr: ptr, names_len: u64, names_count: u64, env_ptr: ptr, env_len: u64, env_count: u64, has_pref: bool, pref_ptr: ptr, pref_len: u64) -> void {
    r.disc_names_off[slot] = ph_text_push(r, names_ptr, names_len);
    r.disc_names_len[slot] = names_len;
    r.disc_names_count[slot] = names_count;
    r.disc_env_off[slot] = ph_text_push(r, env_ptr, env_len);
    r.disc_env_len[slot] = env_len;
    r.disc_env_count[slot] = env_count;
    r.disc_pref_off[slot] = ph_text_push(r, pref_ptr, pref_len);
    r.disc_pref_len[slot] = pref_len;
    r.disc_has_pref[slot] = has_pref;
}

