        *out_len = STR_LEN("{\"capabilities\":{\"compaction\":false,\"fileParts\":false,\"history\":false,\"mcp\":false,\"permissionRoundTrips\":false,\"skills\":false,\"slashCommandForwarding\":false},\"defaultInstalled\":true,\"displayName\":\"Relay Station Configuration\",\"id\":\"relay-config\",\"kind\":\"service\",\"sides\":{\"server\":true,\"web\":false},\"version\":\"0.1.0\"}");
    };
    if slot == 13 {
        *out_ptr = STR_PTR("{\"capabilities\":{\"compaction\":false,\"fileParts\":false,\"history\":false,\"mcp\":false,\"permissionRoundTrips\":false,\"skills\":false,\"slashCommandForwarding\":false},\"defaultInstalled\":true,\"displayName\":\"JEV Evaluation Engine\",\"id\":\"jev\",\"kind\":\"service\",\"sides\":{\"server\":true,\"web\":false},\"version\":\"0.1.0\"}");
        *out_len = STR_LEN("{\"capabilities\":{\"compaction\":false,\"fileParts\":false,\"history\":false,\"mcp\":false,\"permissionRoundTrips\":false,\"skills\":false,\"slashCommandForwarding\":false},\"defaultInstalled\":true,\"displayName\":\"JEV Evaluation Engine\",\"id\":\"jev\",\"kind\":\"service\",\"sides\":{\"server\":true,\"web\":false},\"version\":\"0.1.0\"}");
    };
    if slot == 14 {
        *out_ptr = STR_PTR("{\"capabilities\":{\"compaction\":false,\"fileParts\":false,\"history\":false,\"mcp\":false,\"permissionRoundTrips\":false,\"skills\":false,\"slashCommandForwarding\":false},\"defaultInstalled\":true,\"displayName\":\"VM Tool Security\",\"id\":\"vmtool-security\",\"kind\":\"service\",\"sides\":{\"server\":true,\"web\":false},\"version\":\"0.1.0\"}");
        *out_len = STR_LEN("{\"capabilities\":{\"compaction\":false,\"fileParts\":false,\"history\":false,\"mcp\":false,\"permissionRoundTrips\":false,\"skills\":false,\"slashCommandForwarding\":false},\"defaultInstalled\":true,\"displayName\":\"VM Tool Security\",\"id\":\"vmtool-security\",\"kind\":\"service\",\"sides\":{\"server\":true,\"web\":false},\"version\":\"0.1.0\"}");
    };
    if slot == 15 {
        *out_ptr = STR_PTR("{\"capabilities\":{\"compaction\":true,\"fileParts\":false,\"history\":false,\"mcp\":false,\"permissionRoundTrips\":false,\"skills\":false,\"slashCommandForwarding\":false},\"defaultInstalled\":true,\"displayName\":\"Free Mode (Money Saving)\",\"id\":\"free-mode\",\"kind\":\"feature\",\"sides\":{\"server\":true,\"web\":false},\"version\":\"0.1.0\"}");
        *out_len = STR_LEN("{\"capabilities\":{\"compaction\":true,\"fileParts\":false,\"history\":false,\"mcp\":false,\"permissionRoundTrips\":false,\"skills\":false,\"slashCommandForwarding\":false},\"defaultInstalled\":true,\"displayName\":\"Free Mode (Money Saving)\",\"id\":\"free-mode\",\"kind\":\"feature\",\"sides\":{\"server\":true,\"web\":false},\"version\":\"0.1.0\"}");
    };
    if slot == 16 {
        *out_ptr = STR_PTR("{\"capabilities\":{\"compaction\":false,\"fileParts\":false,\"history\":false,\"mcp\":false,\"permissionRoundTrips\":false,\"skills\":false,\"slashCommandForwarding\":false},\"defaultInstalled\":true,\"displayName\":\"Code Enhancement Tools\",\"id\":\"enhance\",\"kind\":\"feature\",\"sides\":{\"server\":false,\"web\":true},\"version\":\"0.1.0\"}");
        *out_len = STR_LEN("{\"capabilities\":{\"compaction\":false,\"fileParts\":false,\"history\":false,\"mcp\":false,\"permissionRoundTrips\":false,\"skills\":false,\"slashCommandForwarding\":false},\"defaultInstalled\":true,\"displayName\":\"Code Enhancement Tools\",\"id\":\"enhance\",\"kind\":\"feature\",\"sides\":{\"server\":false,\"web\":true},\"version\":\"0.1.0\"}");
    };
}

fn pluginHost_init(out: &PluginHostRegistry) -> void {
    // export const serverPluginRegistry = new ServerPluginRegistry()
    //   .register(MINI_SERVER_PLUGIN).register(CODEX_SERVER_PLUGIN)...
    // manifested by parsing each plugin.json text and registering its id
    // in pluginHost.ts order; the handle is the registration slot.
    let i: u64 = 0;
    while i < 17 {
        let mp: ptr = STR_PTR("");
        let ml: u64 = 0;
        ph_manifest_text(i, &mp, &ml);
        out.manifest_docs[i] = sa_json_parse(mp, ml);
        i = i + 1;
    }
    let j: u64 = 0;
    while j < 12 {
        let ip: ptr = STR_PTR("");
        let il: u64 = 0;
        if ph_doc_get_string(out.manifest_docs[j], STR_PTR("id"), STR_LEN("id"), &ip, &il) {
            serverPluginRegistry_register(&out.registry, ip, il, j);
        };
        j = j + 1;
    }
    // cliSettings declarations (backends/<b>/src/server.ts). Slot 0 (mini)
    // has none — TS MINI_SERVER_PLUGIN declares no cliSettings.
    ph_fill_settings(out, 1, STR_PTR("codex-cli"), STR_LEN("codex-cli"), STR_PTR("CODEX_UI_CODEX_COMPATIBLE_CLI_ENABLED"), STR_LEN("CODEX_UI_CODEX_COMPATIBLE_CLI_ENABLED"), true, STR_PTR("codexCompatibleCliSettings"), STR_LEN("codexCompatibleCliSettings"));
    ph_fill_settings(out, 2, STR_PTR("claude-compatible-cli"), STR_LEN("claude-compatible-cli"), STR_PTR("CODEX_UI_CLAUDE_COMPATIBLE_CLI_ENABLED"), STR_LEN("CODEX_UI_CLAUDE_COMPATIBLE_CLI_ENABLED"), true, STR_PTR("claudeCompatibleCliSettings"), STR_LEN("claudeCompatibleCliSettings"));
    ph_fill_settings(out, 3, STR_PTR("agy-cli"), STR_LEN("agy-cli"), STR_PTR("CODEX_UI_AGY_COMPATIBLE_CLI_ENABLED"), STR_LEN("CODEX_UI_AGY_COMPATIBLE_CLI_ENABLED"), true, STR_PTR("agyCompatibleCliSettings"), STR_LEN("agyCompatibleCliSettings"));
    ph_fill_settings(out, 4, STR_PTR("auggie-cli"), STR_LEN("auggie-cli"), STR_PTR("CODEX_UI_AUGGIE_COMPATIBLE_CLI_ENABLED"), STR_LEN("CODEX_UI_AUGGIE_COMPATIBLE_CLI_ENABLED"), false, STR_PTR(""), 0);
    ph_fill_settings(out, 5, STR_PTR("cline-cli"), STR_LEN("cline-cli"), STR_PTR("CODEX_UI_CLINE_COMPATIBLE_CLI_ENABLED"), STR_LEN("CODEX_UI_CLINE_COMPATIBLE_CLI_ENABLED"), false, STR_PTR(""), 0);
    ph_fill_settings(out, 6, STR_PTR("command-code-cli"), STR_LEN("command-code-cli"), STR_PTR("CODEX_UI_COMMAND_CODE_COMPATIBLE_CLI_ENABLED"), STR_LEN("CODEX_UI_COMMAND_CODE_COMPATIBLE_CLI_ENABLED"), false, STR_PTR(""), 0);
    ph_fill_settings(out, 7, STR_PTR("grok-cli"), STR_LEN("grok-cli"), STR_PTR("CODEX_UI_GROK_COMPATIBLE_CLI_ENABLED"), STR_LEN("CODEX_UI_GROK_COMPATIBLE_CLI_ENABLED"), true, STR_PTR("grokCompatibleCliSettings"), STR_LEN("grokCompatibleCliSettings"));
    ph_fill_settings(out, 8, STR_PTR("pi-cli"), STR_LEN("pi-cli"), STR_PTR("CODEX_UI_PI_COMPATIBLE_CLI_ENABLED"), STR_LEN("CODEX_UI_PI_COMPATIBLE_CLI_ENABLED"), true, STR_PTR("piCompatibleCliSettings"), STR_LEN("piCompatibleCliSettings"));
    ph_fill_settings(out, 9, STR_PTR("opencode-cli"), STR_LEN("opencode-cli"), STR_PTR("CODEX_UI_OPENCODE_COMPATIBLE_CLI_ENABLED"), STR_LEN("CODEX_UI_OPENCODE_COMPATIBLE_CLI_ENABLED"), true, STR_PTR("opencodeCompatibleCliSettings"), STR_LEN("opencodeCompatibleCliSettings"));
    ph_fill_settings(out, 10, STR_PTR("opencode-v2-cli"), STR_LEN("opencode-v2-cli"), STR_PTR("CODEX_UI_OPENCODE_V2_COMPATIBLE_CLI_ENABLED"), STR_LEN("CODEX_UI_OPENCODE_V2_COMPATIBLE_CLI_ENABLED"), false, STR_PTR(""), 0);
    ph_fill_settings(out, 11, STR_PTR("muse-cli"), STR_LEN("muse-cli"), STR_PTR("CODEX_UI_MUSE_COMPATIBLE_CLI_ENABLED"), STR_LEN("CODEX_UI_MUSE_COMPATIBLE_CLI_ENABLED"), false, STR_PTR(""), 0);
    // Discovery data (backends/<b>/src/server.ts discovery blocks; the
    // newline-joined flat form is the sdk CliDiscoverySpec encoding).
    // mini is built-in: empty name/var lists (matchesKind is the seam).
    ph_fill_discovery(out, 0, STR_PTR(""), 0, 0, STR_PTR(""), 0, 0, false, STR_PTR(""), 0);
    ph_fill_discovery(out, 1, STR_PTR("codex"), STR_LEN("codex"), 1, STR_PTR("CODEX_BIN"), STR_LEN("CODEX_BIN"), 1, true, STR_PTR("cliPreferredCodexPath"), STR_LEN("cliPreferredCodexPath"));
    ph_fill_discovery(out, 2, STR_PTR("claude\nclaudecode"), STR_LEN("claude\nclaudecode"), 2, STR_PTR("CODECLI_BIN\nCLAUDE_CODE_BIN"), STR_LEN("CODECLI_BIN\nCLAUDE_CODE_BIN"), 2, true, STR_PTR("cliPreferredClaudePath"), STR_LEN("cliPreferredClaudePath"));
    ph_fill_discovery(out, 3, STR_PTR("agy"), STR_LEN("agy"), 1, STR_PTR("AGY_BIN\nCODEX_UI_AGY_BIN"), STR_LEN("AGY_BIN\nCODEX_UI_AGY_BIN"), 2, true, STR_PTR("cliPreferredAgyPath"), STR_LEN("cliPreferredAgyPath"));
    ph_fill_discovery(out, 4, STR_PTR("auggie"), STR_LEN("auggie"), 1, STR_PTR("AUGGIE_BIN\nCODEX_UI_AUGGIE_BIN"), STR_LEN("AUGGIE_BIN\nCODEX_UI_AUGGIE_BIN"), 2, true, STR_PTR("cliPreferredAuggiePath"), STR_LEN("cliPreferredAuggiePath"));
    ph_fill_discovery(out, 5, STR_PTR("cline"), STR_LEN("cline"), 1, STR_PTR("CLINE_BIN\nCODEX_UI_CLINE_BIN"), STR_LEN("CLINE_BIN\nCODEX_UI_CLINE_BIN"), 2, true, STR_PTR("cliPreferredClinePath"), STR_LEN("cliPreferredClinePath"));
    ph_fill_discovery(out, 6, STR_PTR("command-code"), STR_LEN("command-code"), 1, STR_PTR("COMMAND_CODE_BIN\nCODEX_UI_COMMAND_CODE_BIN"), STR_LEN("COMMAND_CODE_BIN\nCODEX_UI_COMMAND_CODE_BIN"), 2, true, STR_PTR("cliPreferredCommandCodePath"), STR_LEN("cliPreferredCommandCodePath"));
    ph_fill_discovery(out, 7, STR_PTR("grok\nagent"), STR_LEN("grok\nagent"), 2, STR_PTR("GROK_BIN\nCODEX_UI_GROK_BIN"), STR_LEN("GROK_BIN\nCODEX_UI_GROK_BIN"), 2, true, STR_PTR("cliPreferredGrokPath"), STR_LEN("cliPreferredGrokPath"));
    ph_fill_discovery(out, 8, STR_PTR("pi"), STR_LEN("pi"), 1, STR_PTR("PI_BIN\nCODEX_UI_PI_BIN"), STR_LEN("PI_BIN\nCODEX_UI_PI_BIN"), 2, true, STR_PTR("cliPreferredPiPath"), STR_LEN("cliPreferredPiPath"));
    ph_fill_discovery(out, 9, STR_PTR("opencode"), STR_LEN("opencode"), 1, STR_PTR("OPENCODE_BIN\nCODEX_UI_OPENCODE_BIN"), STR_LEN("OPENCODE_BIN\nCODEX_UI_OPENCODE_BIN"), 2, true, STR_PTR("cliPreferredOpencodePath"), STR_LEN("cliPreferredOpencodePath"));
    // opencode-v2's preferredPathPrefKey is "cliPreferredOpencodePath"
    // in the TS source — the same key as opencode's (verbatim, not a typo
    // introduced here; see backends/opencode-v2/src/server.ts).
    ph_fill_discovery(out, 10, STR_PTR("opencode2\nopencode"), STR_LEN("opencode2\nopencode"), 2, STR_PTR("OPENCODE_V2_BIN\nCODEX_UI_OPENCODE_V2_BIN"), STR_LEN("OPENCODE_V2_BIN\nCODEX_UI_OPENCODE_V2_BIN"), 2, true, STR_PTR("cliPreferredOpencodePath"), STR_LEN("cliPreferredOpencodePath"));
    ph_fill_discovery(out, 11, STR_PTR("muse"), STR_LEN("muse"), 1, STR_PTR("MUSE_BIN\nCODEX_UI_MUSE_BIN"), STR_LEN("MUSE_BIN\nCODEX_UI_MUSE_BIN"), 2, true, STR_PTR("cliPreferredMusePath"), STR_LEN("cliPreferredMusePath"));
}

// cliSelectionState.sla kind tags (TS CliPluginKind): 0=codex 1=claude
// 2=agy 3=auggie 4=cline 5=command-code 6=grok 7=pi 8=opencode
// 9=opencode-v2 10=muse. mini has no CLI kind.
fn ph_id_of_kind(kind: u8, out_ptr: &ptr, out_len: &u64) -> bool {
    *out_len = 0;
    if kind == 0 { *out_ptr = STR_PTR("codex"); *out_len = STR_LEN("codex"); return true; };
    if kind == 1 { *out_ptr = STR_PTR("claude"); *out_len = STR_LEN("claude"); return true; };
    if kind == 2 { *out_ptr = STR_PTR("agy"); *out_len = STR_LEN("agy"); return true; };
    if kind == 3 { *out_ptr = STR_PTR("auggie"); *out_len = STR_LEN("auggie"); return true; };
    if kind == 4 { *out_ptr = STR_PTR("cline"); *out_len = STR_LEN("cline"); return true; };
    if kind == 5 { *out_ptr = STR_PTR("command-code"); *out_len = STR_LEN("command-code"); return true; };
    if kind == 6 { *out_ptr = STR_PTR("grok"); *out_len = STR_LEN("grok"); return true; };
    if kind == 7 { *out_ptr = STR_PTR("pi"); *out_len = STR_LEN("pi"); return true; };
    if kind == 8 { *out_ptr = STR_PTR("opencode"); *out_len = STR_LEN("opencode"); return true; };
    if kind == 9 { *out_ptr = STR_PTR("opencode-v2"); *out_len = STR_LEN("opencode-v2"); return true; };
    if kind == 10 { *out_ptr = STR_PTR("muse"); *out_len = STR_LEN("muse"); return true; };
    return false;
}

// Splits a newline-joined flat list into a JSON string-array doc.
fn ph_flat_to_json_array(flat_ptr: ptr, flat_len: u64, count: u64) -> u64 {
    let arr = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    if count == 0 { return arr; };
    let i: u64 = 0;
    let start: u64 = 0;
    while i <= flat_len {
        let at_end = i == flat_len;
        let is_nl = false;
        if !at_end {
            let c: u8 = 0;
            PTR_BYTE_AT(c, flat_ptr, i);
            is_nl = c == 10;
        };
        if at_end || is_nl {
            let lp: ptr = PTR_NULL();
            PTR_BYTE_ADD(lp, flat_ptr, start);
            sa_json_array_push_string(arr, lp, i - start);
            start = i + 1;
        };
        i = i + 1;
    }
    return arr;
}

fn cliDiscoveryForKind(r: &PluginHostRegistry, kind: u8, out_spec: &u64) -> i32 {
    // const plugin = serverPluginRegistry.get(id); if (!plugin) throw ...
    // return plugin.discovery — delivered as a JSON doc:
    // { binaryNames: [...], envBinVars: [...], preferredPathPrefKey? }
    // (matchesKind is the registered seam — see the file header).
    *out_spec = 0;
    let idp: ptr = STR_PTR("");
    let idl: u64 = 0;
    if !ph_id_of_kind(kind, &idp, &idl) { return 1; };
    let slot: u64 = 0;
    if !serverPluginRegistry_get(&r.registry, idp, idl, &slot) { return 1; };
    let doc = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    let names = ph_flat_to_json_array(ph_text_ptr(r, r.disc_names_off[slot]), r.disc_names_len[slot], r.disc_names_count[slot]);
    sa_json_object_set_node(doc, STR_PTR("binaryNames"), STR_LEN("binaryNames"), names);
    let vars = ph_flat_to_json_array(ph_text_ptr(r, r.disc_env_off[slot]), r.disc_env_len[slot], r.disc_env_count[slot]);
    sa_json_object_set_node(doc, STR_PTR("envBinVars"), STR_LEN("envBinVars"), vars);
    if r.disc_has_pref[slot] {
        sa_json_object_set_string(doc, STR_PTR("preferredPathPrefKey"), STR_LEN("preferredPathPrefKey"), ph_text_ptr(r, r.disc_pref_off[slot]), r.disc_pref_len[slot]);
    };
    *out_spec = doc;
    return 0;
}

fn allPluginManifests(r: &PluginHostRegistry, out_manifests: &u64, out_count: &u64) -> void {
    // return [...serverPluginRegistry.list().map(p => p.manifest),
    //   RELAY_CONFIG_PLUGIN_MANIFEST, JEV_PLUGIN_MANIFEST,
    //   VMTOOL_SECURITY_PLUGIN_MANIFEST, FREE_MODE_PLUGIN_MANIFEST,
    //   ENHANCE_PLUGIN_MANIFEST] — manifest_docs holds exactly this
    // order (registry slots 0..11, then the five catalog-only plugins);
    // push_node snapshots each doc into the result array.
    let arr = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    let i: u64 = 0;
    while i < 17 {
        sa_json_array_push_node(arr, r.manifest_docs[i]);
        i = i + 1;
    }
    *out_manifests = arr;
    *out_count = 17;
}

fn cliSettingsEntries(r: &PluginHostRegistry, out_entries: &u64, out_count: &u64) -> void {
    // TS: serverPluginRegistry.list().flatMap(p => p.cliSettings ?
    //   [{ pluginId: p.manifest.id, ...p.cliSettings }] : [])
    // entry object key order follows the TS literal: pluginId, slug,
    // enabledEnvVar, linkKey (linkKey only when declared).
    let arr = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    let count: u64 = 0;
    let slot: u64 = 0;
    while slot < 12 {
        if r.has_cliSettings[slot] {
            let obj = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
            let ip: ptr = STR_PTR("");
            let il: u64 = 0;
            ph_doc_get_string(r.manifest_docs[slot], STR_PTR("id"), STR_LEN("id"), &ip, &il);
            sa_json_object_set_string(obj, STR_PTR("pluginId"), STR_LEN("pluginId"), ip, il);
            sa_json_object_set_string(obj, STR_PTR("slug"), STR_LEN("slug"), ph_text_ptr(r, r.set_slug_off[slot]), r.set_slug_len[slot]);
            sa_json_object_set_string(obj, STR_PTR("enabledEnvVar"), STR_LEN("enabledEnvVar"), ph_text_ptr(r, r.set_env_off[slot]), r.set_env_len[slot]);
            if r.set_has_link[slot] {
                sa_json_object_set_string(obj, STR_PTR("linkKey"), STR_LEN("linkKey"), ph_text_ptr(r, r.set_link_off[slot]), r.set_link_len[slot]);
            };
            sa_json_array_push_node(arr, obj);
            count = count + 1;
        };
        slot = slot + 1;
    }
    *out_entries = arr;
    *out_count = count;
}

fn cliPluginIdForSettingsSlug(r: &PluginHostRegistry, slug_ptr: ptr, slug_len: u64, out_ptr: &ptr, out_len: &u64, out_found: &bool) -> void {
    // return cliSettingsEntries().find(e => e.slug === slug)?.pluginId
    *out_len = 0;
    *out_found = false;
    let entries: u64 = 0;
    let cnt: u64 = 0;
    cliSettingsEntries(r, &entries, &cnt);
    let ec: u64 = 0;
    sa_json_value_count(entries, &ec);
    let i: u64 = 0;
    while i < ec {
        let e: u64 = 0;
        let st = sa_json_array_get(entries, i, &e);
        if st == 0 && e != 0 {
            let sp: ptr = STR_PTR("");
            let sl: u64 = 0;
            if ph_doc_get_string(e, STR_PTR("slug"), STR_LEN("slug"), &sp, &sl) {
                if ph_bytes_eq(sp, sl, slug_ptr, slug_len) {
                    let ip: ptr = STR_PTR("");
                    let il: u64 = 0;
                    if ph_doc_get_string(e, STR_PTR("pluginId"), STR_LEN("pluginId"), &ip, &il) {
                        *out_ptr = ip;
                        *out_len = il;
                        *out_found = true;
                    };
                };
            };
        };
        i = i + 1;
    }
}

fn cliSettingsLinks(r: &PluginHostRegistry, out_record: &u64) -> void {
    // TS: Object.fromEntries(entries.filter(e => e.linkKey).map(e =>
    //   [e.linkKey, "/api/codex/settings/" + e.slug]))
    let rec = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    let slot: u64 = 0;
    while slot < 12 {
        if r.has_cliSettings[slot] && r.set_has_link[slot] {
            let buf = PhBuf { bytes: [0u8; 8192], len: 0 };
            ph_buf_push(&buf, STR_PTR("/api/codex/settings/"), STR_LEN("/api/codex/settings/"));
            ph_buf_push(&buf, ph_text_ptr(r, r.set_slug_off[slot]), r.set_slug_len[slot]);
            let bp: ptr = PTR_NULL();
            PTR_BYTE_ADD(bp, &buf.bytes, 0);
            sa_json_object_set_string(rec, ph_text_ptr(r, r.set_link_off[slot]), r.set_link_len[slot], bp, buf.len);
        };
        slot = slot + 1;
    }
    *out_record = rec;
}

fn defaultInstalledPluginIds(r: &PluginHostRegistry, out_ids: &u64, out_count: &u64) -> void {
    // return allPluginManifests().filter(m => m.defaultInstalled).map(m => m.id)
    let arr = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    let count: u64 = 0;
    let i: u64 = 0;
    while i < 17 {
        let di = false;
        ph_doc_get_bool(r.manifest_docs[i], STR_PTR("defaultInstalled"), STR_LEN("defaultInstalled"), &di);
        if di {
            let ip: ptr = STR_PTR("");
            let il: u64 = 0;
            if ph_doc_get_string(r.manifest_docs[i], STR_PTR("id"), STR_LEN("id"), &ip, &il) {
                sa_json_array_push_string(arr, ip, il);
                count = count + 1;
            };
        };
        i = i + 1;
    }
    *out_ids = arr;
    *out_count = count;
}

// Newline-joined default-installed ids (the defaults argument form of
// pluginInstallStore's loadInstalledPluginIds).
fn ph_defaults_flat(r: &PluginHostRegistry, buf: &PhBuf) -> void {
    let i: u64 = 0;
    while i < 17 {
        let di = false;
        ph_doc_get_bool(r.manifest_docs[i], STR_PTR("defaultInstalled"), STR_LEN("defaultInstalled"), &di);
        if di {
            let ip: ptr = STR_PTR("");
            let il: u64 = 0;
            if ph_doc_get_string(r.manifest_docs[i], STR_PTR("id"), STR_LEN("id"), &ip, &il) {
                ph_buf_push(buf, ip, il);
                ph_buf_byte(buf, 10);
            };
        };
        i = i + 1;
    }
}

// LOCKED_PLUGIN_IDS = new Set(["mini"]) (pluginHost.ts).
fn ph_is_locked(id_ptr: ptr, id_len: u64) -> bool {
    return ph_bytes_eq(id_ptr, id_len, STR_PTR("mini"), STR_LEN("mini"));
}

// Manifest slot (0..16) for an id, or -1 (as i64 via out_found).
fn ph_manifest_slot(r: &PluginHostRegistry, id_ptr: ptr, id_len: u64, out_slot: &u64, out_found: &bool) -> void {
    *out_found = false;
    *out_slot = 0;
    let i: u64 = 0;
    while i < 17 {
        let ip: ptr = STR_PTR("");
        let il: u64 = 0;
        if ph_doc_get_string(r.manifest_docs[i], STR_PTR("id"), STR_LEN("id"), &ip, &il) {
            if ph_bytes_eq(ip, il, id_ptr, id_len) {
                *out_slot = i;
                *out_found = true;
            };
        };
        i = i + 1;
    }
}

fn pluginCatalog(r: &PluginHostRegistry, env_json: u64, out_entries: &u64, out_count: &u64) -> void {
    // TS: const installedIds = loadInstalledPluginIds(defaults, env);
    // return allPluginManifests().map(m => ({ ...m, installed:
    //   installedIds.has(m.id), locked: LOCKED_PLUGIN_IDS.has(m.id) }))
    // Entry objects carry the catalog fields in PluginCatalogEntry
    // order: id, kind, version, displayName, sides (from the manifest),
    // defaultInstalled, installed, locked.
    let dbuf = PhBuf { bytes: [0u8; 8192], len: 0 };
    ph_defaults_flat(r, &dbuf);
    let dbp: ptr = PTR_NULL();
    PTR_BYTE_ADD(dbp, &dbuf.bytes, 0);
    let installed_set: u64 = 0;
    loadInstalledPluginIds(dbp, dbuf.len, env_json, &installed_set);
    let arr = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    let i: u64 = 0;
    while i < 17 {
        let doc = r.manifest_docs[i];
        let obj = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
        let ip: ptr = STR_PTR("");
        let il: u64 = 0;
        ph_doc_get_string(doc, STR_PTR("id"), STR_LEN("id"), &ip, &il);
        sa_json_object_set_string(obj, STR_PTR("id"), STR_LEN("id"), ip, il);
        let kp: ptr = STR_PTR("");
        let kl: u64 = 0;
        ph_doc_get_string(doc, STR_PTR("kind"), STR_LEN("kind"), &kp, &kl);
        sa_json_object_set_string(obj, STR_PTR("kind"), STR_LEN("kind"), kp, kl);
        let vp: ptr = STR_PTR("");
        let vl: u64 = 0;
        ph_doc_get_string(doc, STR_PTR("version"), STR_LEN("version"), &vp, &vl);
        sa_json_object_set_string(obj, STR_PTR("version"), STR_LEN("version"), vp, vl);
        let dp: ptr = STR_PTR("");
        let dl: u64 = 0;
        ph_doc_get_string(doc, STR_PTR("displayName"), STR_LEN("displayName"), &dp, &dl);
        sa_json_object_set_string(obj, STR_PTR("displayName"), STR_LEN("displayName"), dp, dl);
        let di = false;
        ph_doc_get_bool(doc, STR_PTR("defaultInstalled"), STR_LEN("defaultInstalled"), &di);
        let dib: u8 = 0;
        if di { dib = 1; };
        sa_json_object_set_bool(obj, STR_PTR("defaultInstalled"), STR_LEN("defaultInstalled"), dib);
        let ib: u8 = 0;
        if pis_set_contains(installed_set, ip, il) { ib = 1; };
        sa_json_object_set_bool(obj, STR_PTR("installed"), STR_LEN("installed"), ib);
        let lb: u8 = 0;
        if ph_is_locked(ip, il) { lb = 1; };
        sa_json_object_set_bool(obj, STR_PTR("locked"), STR_LEN("locked"), lb);
        sa_json_array_push_node(arr, obj);
        i = i + 1;
    }
    *out_entries = arr;
    *out_count = 17;
}

fn setPluginInstalled(r: &PluginHostRegistry, id_ptr: ptr, id_len: u64, installed: bool, env_json: u64, out_entries: &u64, out_count: &u64) -> i32 {
    // TS throws on an unknown id and on uninstalling a locked plugin;
    // the status form returns 1 (unknown) / 2 (locked) and leaves
    // out_entries/out_count zeroed on those paths.
    *out_entries = 0;
    *out_count = 0;
    let slot: u64 = 0;
    let found = false;
    ph_manifest_slot(r, id_ptr, id_len, &slot, &found);
    if !found { return 1; };
    if !installed && ph_is_locked(id_ptr, id_len) { return 2; };
    let dbuf = PhBuf { bytes: [0u8; 8192], len: 0 };
    ph_defaults_flat(r, &dbuf);
    let dbp: ptr = PTR_NULL();
    PTR_BYTE_ADD(dbp, &dbuf.bytes, 0);
    let cur: u64 = 0;
    loadInstalledPluginIds(dbp, dbuf.len, env_json, &cur);
    // Rebuild the set: all current ids except the target, then the
    // target when installing (Set add/delete semantics; save sorts).
    let next = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    let cnt: u64 = 0;
    sa_json_value_count(cur, &cnt);
    let i: u64 = 0;
    while i < cnt {
        let n: u64 = 0;
        let st = sa_json_array_get(cur, i, &n);
        if st == 0 && n != 0 && sa_json_kind(n) == 5 {
            let sp: ptr = sa_json_string_ptr(n);
            let sl = sa_json_string_len(n);
            if !ph_bytes_eq(sp, sl, id_ptr, id_len) {
                sa_json_array_push_string(next, sp, sl);
            };
        };
        i = i + 1;
    }
    if installed { pis_set_push(next, id_ptr, id_len); };
    saveInstalledPluginIds(next, env_json);
    pluginCatalog(r, env_json, out_entries, out_count);
    return 0;
}
