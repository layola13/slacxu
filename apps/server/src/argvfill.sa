// ARGV_SET<i>: writes (ptr, len) pair i of a [u64; 2N] argv array.
// Offsets are baked per macro (pair i: ptr at 16i, len at 16i+8)
// because SLA macro arguments are evaluated registers. Same
// pattern as packages/cxu-bridge/src/argvfill.sa, extended to
// seven slots (exe + up to six args) for sa_vm run_host.
[MACRO] ARGV_SET0 %arr_ptr, %p, %l
    store %arr_ptr+0, %p as ptr
    store %arr_ptr+8, %l as u64
[END_MACRO]

[MACRO] ARGV_SET1 %arr_ptr, %p, %l
    store %arr_ptr+16, %p as ptr
    store %arr_ptr+24, %l as u64
[END_MACRO]

[MACRO] ARGV_SET2 %arr_ptr, %p, %l
    store %arr_ptr+32, %p as ptr
    store %arr_ptr+40, %l as u64
[END_MACRO]

[MACRO] ARGV_SET3 %arr_ptr, %p, %l
    store %arr_ptr+48, %p as ptr
    store %arr_ptr+56, %l as u64
[END_MACRO]

[MACRO] ARGV_SET4 %arr_ptr, %p, %l
    store %arr_ptr+64, %p as ptr
    store %arr_ptr+72, %l as u64
[END_MACRO]

[MACRO] ARGV_SET5 %arr_ptr, %p, %l
    store %arr_ptr+80, %p as ptr
    store %arr_ptr+88, %l as u64
[END_MACRO]

[MACRO] ARGV_SET6 %arr_ptr, %p, %l
    store %arr_ptr+96, %p as ptr
    store %arr_ptr+104, %l as u64
[END_MACRO]
