fn ps_col_name(code: u64, out_p: &ptr, out_l: &u64) -> void {
    *out_p = STR_PTR("provider_id");
    *out_l = STR_LEN("provider_id");
    if code == 1 { *out_p = STR_PTR("group_id"); *out_l = STR_LEN("group_id"); };
    if code == 2 { *out_p = STR_PTR("name"); *out_l = STR_LEN("name"); };
    if code == 3 { *out_p = STR_PTR("base_url"); *out_l = STR_LEN("base_url"); };
    if code == 4 { *out_p = STR_PTR("kind"); *out_l = STR_LEN("kind"); };
    if code == 5 { *out_p = STR_PTR("status"); *out_l = STR_LEN("status"); };
    if code == 6 { *out_p = STR_PTR("key_mode"); *out_l = STR_LEN("key_mode"); };
    if code == 7 { *out_p = STR_PTR("response_protocol"); *out_l = STR_LEN("response_protocol"); };
    if code == 8 { *out_p = STR_PTR("response_protocol_mode"); *out_l = STR_LEN("response_protocol_mode"); };
    if code == 9 { *out_p = STR_PTR("claude_code_version"); *out_l = STR_LEN("claude_code_version"); };
    if code == 10 { *out_p = STR_PTR("endpoint_path_override"); *out_l = STR_LEN("endpoint_path_override"); };
    if code == 11 { *out_p = STR_PTR("auth_type"); *out_l = STR_LEN("auth_type"); };
    if code == 12 { *out_p = STR_PTR("credential_mode"); *out_l = STR_LEN("credential_mode"); };
    if code == 13 { *out_p = STR_PTR("catalog_group_name"); *out_l = STR_LEN("catalog_group_name"); };
    if code == 14 { *out_p = STR_PTR("keys_json"); *out_l = STR_LEN("keys_json"); };
    if code == 15 { *out_p = STR_PTR("models_json"); *out_l = STR_LEN("models_json"); };
    if code == 16 { *out_p = STR_PTR("model_capabilities_json"); *out_l = STR_LEN("model_capabilities_json"); };
    if code == 17 { *out_p = STR_PTR("supported_endpoint_types_json"); *out_l = STR_LEN("supported_endpoint_types_json"); };
    if code == 18 { *out_p = STR_PTR("image_json"); *out_l = STR_LEN("image_json"); };
    if code == 19 { *out_p = STR_PTR("model_mapping_json"); *out_l = STR_LEN("model_mapping_json"); };
    if code == 20 { *out_p = STR_PTR("status_code_mapping_json"); *out_l = STR_LEN("status_code_mapping_json"); };
    if code == 21 { *out_p = STR_PTR("advanced_model_mapping_json"); *out_l = STR_LEN("advanced_model_mapping_json"); };
    if code == 22 { *out_p = STR_PTR("tag"); *out_l = STR_LEN("tag"); };
    if code == 23 { *out_p = STR_PTR("remark"); *out_l = STR_LEN("remark"); };
    if code == 24 { *out_p = STR_PTR("command_blacklist_json"); *out_l = STR_LEN("command_blacklist_json"); };
    if code == 25 { *out_p = STR_PTR("network_allowlist_json"); *out_l = STR_LEN("network_allowlist_json"); };
    if code == 26 { *out_p = STR_PTR("fallback_channel_id"); *out_l = STR_LEN("fallback_channel_id"); };
    if code == 27 { *out_p = STR_PTR("fallback_group_name"); *out_l = STR_LEN("fallback_group_name"); };
    if code == 28 { *out_p = STR_PTR("tiered_context_ratios_json"); *out_l = STR_LEN("tiered_context_ratios_json"); };
}

fn ps_row_put(out: &RelayGroupRow, code: u64, p: ptr, l: u64) -> void {
    let i: u64 = 0;
    if code == 0 { while i < l && i < 128 { out.provider_id[i] = ps_byte(p, i); i = i + 1; } out.provider_id_len = i; };
    if code == 1 { while i < l && i < 128 { out.group_id[i] = ps_byte(p, i); i = i + 1; } out.group_id_len = i; };
    if code == 2 { while i < l && i < 256 { out.name[i] = ps_byte(p, i); i = i + 1; } out.name_len = i; };
    if code == 3 { while i < l && i < 1024 { out.base_url[i] = ps_byte(p, i); i = i + 1; } out.base_url_len = i; out.has_base_url = true; };
    if code == 4 { while i < l && i < 32 { out.kind[i] = ps_byte(p, i); i = i + 1; } out.kind_len = i; };
    if code == 5 { while i < l && i < 32 { out.status[i] = ps_byte(p, i); i = i + 1; } out.status_len = i; out.has_status = true; };
    if code == 6 { while i < l && i < 32 { out.key_mode[i] = ps_byte(p, i); i = i + 1; } out.key_mode_len = i; out.has_key_mode = true; };
    if code == 7 { while i < l && i < 64 { out.response_protocol[i] = ps_byte(p, i); i = i + 1; } out.response_protocol_len = i; out.has_response_protocol = true; };
    if code == 8 { while i < l && i < 64 { out.response_protocol_mode[i] = ps_byte(p, i); i = i + 1; } out.response_protocol_mode_len = i; out.has_response_protocol_mode = true; };
    if code == 9 { while i < l && i < 64 { out.claude_code_version[i] = ps_byte(p, i); i = i + 1; } out.claude_code_version_len = i; out.has_claude_code_version = true; };
    if code == 10 { while i < l && i < 512 { out.endpoint_path_override[i] = ps_byte(p, i); i = i + 1; } out.endpoint_path_override_len = i; out.has_endpoint_path_override = true; };
    if code == 11 { while i < l && i < 64 { out.auth_type[i] = ps_byte(p, i); i = i + 1; } out.auth_type_len = i; out.has_auth_type = true; };
    if code == 12 { while i < l && i < 64 { out.credential_mode[i] = ps_byte(p, i); i = i + 1; } out.credential_mode_len = i; out.has_credential_mode = true; };
    if code == 13 { while i < l && i < 256 { out.catalog_group_name[i] = ps_byte(p, i); i = i + 1; } out.catalog_group_name_len = i; out.has_catalog_group_name = true; };
    if code == 14 { while i < l && i < 8192 { out.keys_json[i] = ps_byte(p, i); i = i + 1; } out.keys_json_len = i; };
    if code == 15 { while i < l && i < 8192 { out.models_json[i] = ps_byte(p, i); i = i + 1; } out.models_json_len = i; };
    if code == 16 { while i < l && i < 8192 { out.model_capabilities_json[i] = ps_byte(p, i); i = i + 1; } out.model_capabilities_json_len = i; out.has_model_capabilities_json = true; };
    if code == 17 { while i < l && i < 4096 { out.supported_endpoint_types_json[i] = ps_byte(p, i); i = i + 1; } out.supported_endpoint_types_json_len = i; out.has_supported_endpoint_types_json = true; };
    if code == 18 { while i < l && i < 4096 { out.image_json[i] = ps_byte(p, i); i = i + 1; } out.image_json_len = i; out.has_image_json = true; };
    if code == 19 { while i < l && i < 8192 { out.model_mapping_json[i] = ps_byte(p, i); i = i + 1; } out.model_mapping_json_len = i; };
    if code == 20 { while i < l && i < 4096 { out.status_code_mapping_json[i] = ps_byte(p, i); i = i + 1; } out.status_code_mapping_json_len = i; };
    if code == 21 { while i < l && i < 8192 { out.advanced_model_mapping_json[i] = ps_byte(p, i); i = i + 1; } out.advanced_model_mapping_json_len = i; out.has_advanced_model_mapping_json = true; };
    if code == 22 { while i < l && i < 256 { out.tag[i] = ps_byte(p, i); i = i + 1; } out.tag_len = i; out.has_tag = true; };
    if code == 23 { while i < l && i < 1024 { out.remark[i] = ps_byte(p, i); i = i + 1; } out.remark_len = i; out.has_remark = true; };
    if code == 24 { while i < l && i < 8192 { out.command_blacklist_json[i] = ps_byte(p, i); i = i + 1; } out.command_blacklist_json_len = i; };
    if code == 25 { while i < l && i < 8192 { out.network_allowlist_json[i] = ps_byte(p, i); i = i + 1; } out.network_allowlist_json_len = i; };
    if code == 26 { while i < l && i < 128 { out.fallback_channel_id[i] = ps_byte(p, i); i = i + 1; } out.fallback_channel_id_len = i; out.has_fallback_channel_id = true; };
    if code == 27 { while i < l && i < 256 { out.fallback_group_name[i] = ps_byte(p, i); i = i + 1; } out.fallback_group_name_len = i; out.has_fallback_group_name = true; };
    if code == 28 { while i < l && i < 4096 { out.tiered_context_ratios_json[i] = ps_byte(p, i); i = i + 1; } out.tiered_context_ratios_json_len = i; };
}

fn ps_fill_group_row(doc: u64, out: &RelayGroupRow) -> void {
    ps_empty_group_row(out);
    let code: u64 = 0;
    while code <= 28 {
        let kp: ptr = PTR_NULL();
        let kl: u64 = 0;
        ps_col_name(code, &kp, &kl);
        let p: ptr = PTR_NULL();
        let l: u64 = 0;
        if ps_col_text(doc, kp, kl, &p, &l) {
            ps_row_put(out, code, p, l);
        };
        code = code + 1;
    }
    out.group_ratio = ps_col_f64(doc, STR_PTR("group_ratio"), STR_LEN("group_ratio"));
    let has: bool = false;
    let qv: f64 = 0.0;
    if ps_field_num(doc, STR_PTR("quota_usd"), STR_LEN("quota_usd"), &qv) { out.quota_usd = qv; out.has_quota_usd = true; };
    if ps_field_num(doc, STR_PTR("used_quota_usd"), STR_LEN("used_quota_usd"), &qv) { out.used_quota_usd = qv; out.has_used_quota_usd = true; };
    out.priority = ps_col_i64(doc, STR_PTR("priority"), STR_LEN("priority"), &has);
    out.has_priority = has;
    out.weight = ps_col_i64(doc, STR_PTR("weight"), STR_LEN("weight"), &has);
    out.has_weight = has;
    out.claude_code_headers_enabled = ps_col_i64(doc, STR_PTR("claude_code_headers_enabled"), STR_LEN("claude_code_headers_enabled"), &has);
    out.has_claude_code_headers_enabled = has;
    out.catalog_managed = ps_col_i64(doc, STR_PTR("catalog_managed"), STR_LEN("catalog_managed"), &has);
    out.has_catalog_managed = has;
    out.auto_ban = ps_col_i64(doc, STR_PTR("auto_ban"), STR_LEN("auto_ban"), &has);
    out.has_auto_ban = has;
    out.request_limit = ps_col_i64(doc, STR_PTR("request_limit"), STR_LEN("request_limit"), &has);
    out.has_request_limit = has;
    out.request_interval_seconds = ps_col_i64(doc, STR_PTR("request_interval_seconds"), STR_LEN("request_interval_seconds"), &has);
    out.has_request_interval_seconds = has;
    out.context_window = ps_col_i64(doc, STR_PTR("context_window"), STR_LEN("context_window"), &has);
    out.has_context_window = has;
    out.command_blacklist_enabled = ps_col_i64(doc, STR_PTR("command_blacklist_enabled"), STR_LEN("command_blacklist_enabled"), &has);
    out.has_command_blacklist_enabled = has;
    out.enable_fallback = ps_col_i64(doc, STR_PTR("enable_fallback"), STR_LEN("enable_fallback"), &has);
    out.has_enable_fallback = has;
    out.enable_tiered_context = ps_col_i64(doc, STR_PTR("enable_tiered_context"), STR_LEN("enable_tiered_context"), &has);
    out.has_enable_tiered_context = has;
    out.sort_order = ps_col_i64(doc, STR_PTR("sort_order"), STR_LEN("sort_order"), &has);
    out.created_at = ps_col_i64(doc, STR_PTR("created_at"), STR_LEN("created_at"), &has) as u64;
    out.updated_at = ps_col_i64(doc, STR_PTR("updated_at"), STR_LEN("updated_at"), &has) as u64;
}

// set a nullable REAL field from a row (present value or JSON null)
fn ps_set_nullable_f64(doc: u64, key_p: ptr, key_l: u64, value: f64, has: bool, is_null: bool) -> void {
    if is_null {
        let st: i32 = sa_json_object_set_null(doc, key_p, key_l);
        return;
    };
    if has {
        let st: i32 = sa_json_object_set_f64(doc, key_p, key_l, value);
    };
}

// ---- groupFromRow ----
fn groupFromRow(row: &RelayGroupRow, out_json: &u64) -> bool {
    *out_json = 0;
    let p: ptr = PTR_NULL();
    let l: u64 = 0;
    let has: bool = false;
    ps_row_field(row, 1, &p, &l, &has);
    let id = PsText { bytes: [0; 65536], len: 0 };
    let id_ok: bool = ps_sv_text(p, l, &p, &l);
    if id_ok { ps_append(&id, p, l); };
    ps_row_field(row, 2, &p, &l, &has);
    let name = PsText { bytes: [0; 65536], len: 0 };
    let name_ok: bool = ps_sv_text(p, l, &p, &l);
    if name_ok { ps_append(&name, p, l); };
    if !id_ok || !name_ok { return false; };
    let doc: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    if doc == 0 { return false; };
    let e0: i32 = sa_json_object_set_string(doc, STR_PTR("id"), STR_LEN("id"), ps_text_ptr(&id), id.len);
    let e1: i32 = sa_json_object_set_string(doc, STR_PTR("name"), STR_LEN("name"), ps_text_ptr(&name), name.len);
    // baseUrl
    ps_row_field(row, 3, &p, &l, &has);
    if has {
        let bp: ptr = p;
        let bl: u64 = l;
        if ps_sv_text(bp, bl, &p, &l) {
            let st: i32 = sa_json_object_set_string(doc, STR_PTR("baseUrl"), STR_LEN("baseUrl"), p, l);
        };
    };
    // kind via node bridge
    ps_row_field(row, 4, &p, &l, &has);
    let kind_node: u64 = 0;
    let holder: u64 = ps_str_node(p, l, &kind_node);
    let kind_p: ptr = PTR_NULL();
    let kind_l: u64 = 0;
    groupKindValue(kind_node, &kind_p, &kind_l);
    let kind = PsText { bytes: [0; 65536], len: 0 };
    ps_append(&kind, kind_p, kind_l);
    if holder != 0 {
        let f: i32 = sa_json_free(holder);
    };
    let e2: i32 = sa_json_object_set_string(doc, STR_PTR("kind"), STR_LEN("kind"), ps_text_ptr(&kind), kind.len);
    let kind_code: u64 = 0;
    if ps_eq(ps_text_ptr(&kind), kind.len, STR_PTR("image"), STR_LEN("image")) { kind_code = 1; };
    // status
    ps_row_field(row, 5, &p, &l, &has);
    if has {
        let node: u64 = 0;
        let h2: u64 = ps_str_node(p, l, &node);
        let vp: ptr = PTR_NULL();
        let vl: u64 = 0;
        if groupStatusValue(node, &vp, &vl) {
            let st: i32 = sa_json_object_set_string(doc, STR_PTR("status"), STR_LEN("status"), vp, vl);
        };
        if h2 != 0 { let f: i32 = sa_json_free(h2); };
    };
    let e3: i32 = sa_json_object_set_f64(doc, STR_PTR("groupRatio"), STR_LEN("groupRatio"), row.group_ratio);
    // quotaUsd: nullable semantics (NULL column -> JSON null present)
    if row.has_quota_usd {
        let st: i32 = sa_json_object_set_f64(doc, STR_PTR("quotaUsd"), STR_LEN("quotaUsd"), row.quota_usd);
    } else {
        let st: i32 = sa_json_object_set_null(doc, STR_PTR("quotaUsd"), STR_LEN("quotaUsd"));
    };
    if row.has_used_quota_usd {
        let st: i32 = sa_json_object_set_f64(doc, STR_PTR("usedQuotaUsd"), STR_LEN("usedQuotaUsd"), row.used_quota_usd);
    };
    if row.has_priority {
        let st: i32 = sa_json_object_set_i64(doc, STR_PTR("priority"), STR_LEN("priority"), row.priority);
    };
    if row.has_weight {
        let st: i32 = sa_json_object_set_i64(doc, STR_PTR("weight"), STR_LEN("weight"), row.weight);
    };
    // keyMode
    ps_row_field(row, 6, &p, &l, &has);
    if has {
        let node: u64 = 0;
        let h2: u64 = ps_str_node(p, l, &node);
        let vp: ptr = PTR_NULL();
        let vl: u64 = 0;
        if groupKeyModeValue(node, &vp, &vl) {
            let st: i32 = sa_json_object_set_string(doc, STR_PTR("keyMode"), STR_LEN("keyMode"), vp, vl);
        };
        if h2 != 0 { let f: i32 = sa_json_free(h2); };
    };
    // models
    ps_row_field(row, 15, &p, &l, &has);
    let models: u64 = 0;
    stringArrayFromJson(p, l, &models);
    let e4: i32 = sa_json_object_set_node(doc, STR_PTR("models"), STR_LEN("models"), models);
    // modelCapabilities ?? "{}"
    ps_row_field(row, 16, &p, &l, &has);
    let mc: u64 = 0;
    if has {
        if modelCapabilitiesFromJson(p, l, &mc) {
            let st: i32 = sa_json_object_set_node(doc, STR_PTR("modelCapabilities"), STR_LEN("modelCapabilities"), mc);
        };
    } else {
        if modelCapabilitiesFromJson(STR_PTR("{}"), STR_LEN("{}"), &mc) {
            let st: i32 = sa_json_object_set_node(doc, STR_PTR("modelCapabilities"), STR_LEN("modelCapabilities"), mc);
        };
    };
    // supportedEndpointTypes ?? "[]"
    ps_row_field(row, 17, &p, &l, &has);
    let set_doc: u64 = 0;
    if has {
        stringArrayFromJson(p, l, &set_doc);
    } else {
        stringArrayFromJson(STR_PTR("[]"), STR_LEN("[]"), &set_doc);
    };
    let e5: i32 = sa_json_object_set_node(doc, STR_PTR("supportedEndpointTypes"), STR_LEN("supportedEndpointTypes"), set_doc);
    // responseProtocol / mode
    ps_row_field(row, 7, &p, &l, &has);
    if has {
        let node: u64 = 0;
        let h2: u64 = ps_str_node(p, l, &node);
        let vp: ptr = PTR_NULL();
        let vl: u64 = 0;
        if responseProtocolValue(node, &vp, &vl) {
            let st: i32 = sa_json_object_set_string(doc, STR_PTR("responseProtocol"), STR_LEN("responseProtocol"), vp, vl);
        };
        if h2 != 0 { let f: i32 = sa_json_free(h2); };
    };
    ps_row_field(row, 8, &p, &l, &has);
    if has {
        let node: u64 = 0;
        let h2: u64 = ps_str_node(p, l, &node);
        let vp: ptr = PTR_NULL();
        let vl: u64 = 0;
        if responseProtocolModeValue(node, &vp, &vl) {
            let st: i32 = sa_json_object_set_string(doc, STR_PTR("responseProtocolMode"), STR_LEN("responseProtocolMode"), vp, vl);
        };
        if h2 != 0 { let f: i32 = sa_json_free(h2); };
    };
    let e6: i32 = sa_json_object_set_bool(doc, STR_PTR("claudeCodeHeadersEnabled"), STR_LEN("claudeCodeHeadersEnabled"), row.claude_code_headers_enabled == 1);
    ps_row_field(row, 9, &p, &l, &has);
    if has {
        let bp: ptr = p;
        let bl: u64 = l;
        if ps_sv_text(bp, bl, &p, &l) {
            let st: i32 = sa_json_object_set_string(doc, STR_PTR("claudeCodeVersion"), STR_LEN("claudeCodeVersion"), p, l);
        };
    };
    ps_row_field(row, 10, &p, &l, &has);
    if has {
        let bp: ptr = p;
        let bl: u64 = l;
        if ps_sv_text(bp, bl, &p, &l) {
            let st: i32 = sa_json_object_set_string(doc, STR_PTR("endpointPathOverride"), STR_LEN("endpointPathOverride"), p, l);
        };
    };
    ps_row_field(row, 11, &p, &l, &has);
    if has {
        let node: u64 = 0;
        let h2: u64 = ps_str_node(p, l, &node);
        let vp: ptr = PTR_NULL();
        let vl: u64 = 0;
        if authTypeValue(node, &vp, &vl) {
            let st: i32 = sa_json_object_set_string(doc, STR_PTR("authType"), STR_LEN("authType"), vp, vl);
        };
        if h2 != 0 { let f: i32 = sa_json_free(h2); };
    };
    ps_row_field(row, 12, &p, &l, &has);
    if has {
        let node: u64 = 0;
        let h2: u64 = ps_str_node(p, l, &node);
        let vp: ptr = PTR_NULL();
        let vl: u64 = 0;
        if credentialModeValue(node, &vp, &vl) {
            let st: i32 = sa_json_object_set_string(doc, STR_PTR("credentialMode"), STR_LEN("credentialMode"), vp, vl);
        };
        if h2 != 0 { let f: i32 = sa_json_free(h2); };
    };
    ps_row_field(row, 13, &p, &l, &has);
    if has {
        let bp: ptr = p;
        let bl: u64 = l;
        if ps_sv_text(bp, bl, &p, &l) {
            let st: i32 = sa_json_object_set_string(doc, STR_PTR("catalogGroupName"), STR_LEN("catalogGroupName"), p, l);
        };
    };
    let cm: bool = false;
    if sqlBooleanValue(row.catalog_managed, row.has_catalog_managed, &cm) {
        let st: i32 = sa_json_object_set_bool(doc, STR_PTR("catalogManaged"), STR_LEN("catalogManaged"), cm);
    };
    // image before capabilities
    ps_row_field(row, 18, &p, &l, &has);
    let image_doc: u64 = 0;
    if has {
        let parsed: u64 = 0;
        if jsonFromString(p, l, true, &parsed) {
            if imageProviderConfig(parsed, &image_doc) {
                let st: i32 = sa_json_object_set_node(doc, STR_PTR("image"), STR_LEN("image"), image_doc);
            };
            let f: i32 = sa_json_free(parsed);
        };
    };
    let caps: u64 = 0;
    groupCapabilities(0, kind_code, image_doc, &caps);
    let e7: i32 = sa_json_object_set_node(doc, STR_PTR("capabilities"), STR_LEN("capabilities"), caps);
    // mappings
    ps_row_field(row, 19, &p, &l, &has);
    let mm: u64 = 0;
    if modelMappingArrayFromJson(p, l, &mm) {
        let st: i32 = sa_json_object_set_node(doc, STR_PTR("modelMapping"), STR_LEN("modelMapping"), mm);
    };
    ps_row_field(row, 20, &p, &l, &has);
    let scm: u64 = 0;
    if statusCodeMappingArrayFromJson(p, l, &scm) {
        let st: i32 = sa_json_object_set_node(doc, STR_PTR("statusCodeMapping"), STR_LEN("statusCodeMapping"), scm);
    };
    ps_row_field(row, 21, &p, &l, &has);
    let amm: u64 = 0;
    if advancedModelMappingArrayFromJson(p, l, has, &amm) {
        let st: i32 = sa_json_object_set_node(doc, STR_PTR("advancedModelMapping"), STR_LEN("advancedModelMapping"), amm);
    };
    ps_row_field(row, 22, &p, &l, &has);
    if has {
        let bp: ptr = p;
        let bl: u64 = l;
        if ps_sv_text(bp, bl, &p, &l) {
            let st: i32 = sa_json_object_set_string(doc, STR_PTR("tag"), STR_LEN("tag"), p, l);
        };
    };
    ps_row_field(row, 23, &p, &l, &has);
    if has {
        let bp: ptr = p;
        let bl: u64 = l;
        if ps_sv_text(bp, bl, &p, &l) {
            let st: i32 = sa_json_object_set_string(doc, STR_PTR("remark"), STR_LEN("remark"), p, l);
        };
    };
    let ab: bool = false;
    if sqlBooleanValue(row.auto_ban, row.has_auto_ban, &ab) {
        let st: i32 = sa_json_object_set_bool(doc, STR_PTR("autoBan"), STR_LEN("autoBan"), ab);
    };
    if row.has_request_limit {
        let st: i32 = sa_json_object_set_i64(doc, STR_PTR("requestLimit"), STR_LEN("requestLimit"), row.request_limit);
    };
    if row.has_request_interval_seconds {
        let st: i32 = sa_json_object_set_i64(doc, STR_PTR("requestIntervalSeconds"), STR_LEN("requestIntervalSeconds"), row.request_interval_seconds);
    };
    if row.has_context_window {
        let st: i32 = sa_json_object_set_i64(doc, STR_PTR("contextWindow"), STR_LEN("contextWindow"), row.context_window);
    };
    let e8: i32 = sa_json_object_set_bool(doc, STR_PTR("commandBlacklistEnabled"), STR_LEN("commandBlacklistEnabled"), row.command_blacklist_enabled != 0);
    ps_row_field(row, 24, &p, &l, &has);
    let cbl: u64 = 0;
    stringArrayFromJson(p, l, &cbl);
    let e9: i32 = sa_json_object_set_node(doc, STR_PTR("commandBlacklist"), STR_LEN("commandBlacklist"), cbl);
    ps_row_field(row, 25, &p, &l, &has);
    let nal: u64 = 0;
    stringArrayFromJson(p, l, &nal);
    let e10: i32 = sa_json_object_set_node(doc, STR_PTR("networkAllowlist"), STR_LEN("networkAllowlist"), nal);
    ps_row_field(row, 14, &p, &l, &has);
    let keys: u64 = 0;
    stringArrayFromJson(p, l, &keys);
    let e11: i32 = sa_json_object_set_node(doc, STR_PTR("keys"), STR_LEN("keys"), keys);
    let ef: bool = false;
    if sqlBooleanValue(row.enable_fallback, row.has_enable_fallback, &ef) {
        let st: i32 = sa_json_object_set_bool(doc, STR_PTR("enableFallback"), STR_LEN("enableFallback"), ef);
    };
    ps_row_field(row, 26, &p, &l, &has);
    if has {
        let bp: ptr = p;
        let bl: u64 = l;
        if ps_sv_text(bp, bl, &p, &l) {
            let st: i32 = sa_json_object_set_string(doc, STR_PTR("fallbackChannelId"), STR_LEN("fallbackChannelId"), p, l);
        };
    };
    ps_row_field(row, 27, &p, &l, &has);
    if has {
        let bp: ptr = p;
        let bl: u64 = l;
        if ps_sv_text(bp, bl, &p, &l) {
            let st: i32 = sa_json_object_set_string(doc, STR_PTR("fallbackGroupName"), STR_LEN("fallbackGroupName"), p, l);
        };
    };
    let etc: bool = false;
    if sqlBooleanValue(row.enable_tiered_context, row.has_enable_tiered_context, &etc) {
        let st: i32 = sa_json_object_set_bool(doc, STR_PTR("enableTieredContext"), STR_LEN("enableTieredContext"), etc);
    };
    ps_row_field(row, 28, &p, &l, &has);
    let tcr: u64 = 0;
    if tieredContextRatioArrayFromJson(p, l, &tcr) {
        let st: i32 = sa_json_object_set_node(doc, STR_PTR("tieredContextRatios"), STR_LEN("tieredContextRatios"), tcr);
    };
    *out_json = doc;
    return true;
}

// ---- groupArray ----
fn ps_u64_dec(v: u64, out: &PsText) -> void {
    if v == 0 {
        ps_append(out, STR_PTR("0"), STR_LEN("0"));
        return;
    };
    let digits: [u8; 20] = [0; 20];
    let n: u64 = 0;
    let x: u64 = v;
    while x > 0 {
        digits[n] = (48 + (x % 10)) as u8;
        n = n + 1;
        x = x / 10;
    }
    let dp: ptr = PTR_NULL();
    PTR_BYTE_ADD(dp, &digits, 0);
    let i: u64 = n;
    while i > 0 {
        i = i - 1;
        let one: [u8; 1] = [digits[i]];
        let op: ptr = PTR_NULL();
        PTR_BYTE_ADD(op, &one, 0);
        ps_append(out, op, 1);
    }
}

fn ps_group_entry(record: u64, index: u64, out_json: &u64) -> void {
    let doc: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    *out_json = doc;
    if doc == 0 { return; };
    // id / name with defaults
    let p: ptr = PTR_NULL();
    let l: u64 = 0;
    if ps_field_sv(record, STR_PTR("id"), STR_LEN("id"), &p, &l) {
        let st: i32 = sa_json_object_set_string(doc, STR_PTR("id"), STR_LEN("id"), p, l);
    } else {
        let dflt = PsText { bytes: [0; 65536], len: 0 };
        ps_append(&dflt, STR_PTR("group-"), STR_LEN("group-"));
        ps_u64_dec(index + 1, &dflt);
        let st: i32 = sa_json_object_set_string(doc, STR_PTR("id"), STR_LEN("id"), ps_text_ptr(&dflt), dflt.len);
    };
    if ps_field_sv(record, STR_PTR("name"), STR_LEN("name"), &p, &l) {
        let st: i32 = sa_json_object_set_string(doc, STR_PTR("name"), STR_LEN("name"), p, l);
    } else {
        let st: i32 = sa_json_object_set_string(doc, STR_PTR("name"), STR_LEN("name"), STR_PTR("default"), STR_LEN("default"));
    };
    let sbu: bool = ps_set_sv(doc, STR_PTR("baseUrl"), STR_LEN("baseUrl"), ps_jget(record, STR_PTR("baseUrl"), STR_LEN("baseUrl")));
    // kind first (capabilities + image depend on it)
    let kind_p: ptr = PTR_NULL();
    let kind_l: u64 = 0;
    groupKindValue(ps_jget(record, STR_PTR("kind"), STR_LEN("kind")), &kind_p, &kind_l);
    let kind = PsText { bytes: [0; 65536], len: 0 };
    ps_append(&kind, kind_p, kind_l);
    let ek: i32 = sa_json_object_set_string(doc, STR_PTR("kind"), STR_LEN("kind"), ps_text_ptr(&kind), kind.len);
    let kind_code: u64 = 0;
    if ps_eq(ps_text_ptr(&kind), kind.len, STR_PTR("image"), STR_LEN("image")) { kind_code = 1; };
    // image (computed before capabilities, placed at its literal position later)
    let image_doc: u64 = 0;
    let has_image: bool = imageProviderConfig(ps_jget(record, STR_PTR("image"), STR_LEN("image")), &image_doc);
    let caps: u64 = 0;
    groupCapabilities(ps_jget(record, STR_PTR("capabilities"), STR_LEN("capabilities")), kind_code, image_doc, &caps);
    let ec: i32 = sa_json_object_set_node(doc, STR_PTR("capabilities"), STR_LEN("capabilities"), caps);
    let vp: ptr = PTR_NULL();
    let vl: u64 = 0;
    if groupStatusValue(ps_jget(record, STR_PTR("status"), STR_LEN("status")), &vp, &vl) {
        let st: i32 = sa_json_object_set_string(doc, STR_PTR("status"), STR_LEN("status"), vp, vl);
    };
    let ratio: f64 = 1.0;
    let rv: f64 = 0.0;
    if ps_field_number(record, STR_PTR("groupRatio"), STR_LEN("groupRatio"), &rv) { ratio = rv; };
    let er: i32 = sa_json_object_set_f64(doc, STR_PTR("groupRatio"), STR_LEN("groupRatio"), ratio);
    let sq: bool = ps_set_nullable(doc, STR_PTR("quotaUsd"), STR_LEN("quotaUsd"), ps_jget(record, STR_PTR("quotaUsd"), STR_LEN("quotaUsd")));
    let su: bool = ps_set_num(doc, STR_PTR("usedQuotaUsd"), STR_LEN("usedQuotaUsd"), ps_jget(record, STR_PTR("usedQuotaUsd"), STR_LEN("usedQuotaUsd")));
    let sp: bool = ps_set_num(doc, STR_PTR("priority"), STR_LEN("priority"), ps_jget(record, STR_PTR("priority"), STR_LEN("priority")));
    let sw: bool = ps_set_num(doc, STR_PTR("weight"), STR_LEN("weight"), ps_jget(record, STR_PTR("weight"), STR_LEN("weight")));
    if groupKeyModeValue(ps_jget(record, STR_PTR("keyMode"), STR_LEN("keyMode")), &vp, &vl) {
        let st: i32 = sa_json_object_set_string(doc, STR_PTR("keyMode"), STR_LEN("keyMode"), vp, vl);
    };
    let models: u64 = 0;
    ps_field_str_array(record, STR_PTR("models"), STR_LEN("models"), &models);
    let em: i32 = sa_json_object_set_node(doc, STR_PTR("models"), STR_LEN("models"), models);
    let mc: u64 = 0;
    if modelCapabilitiesFromValue(ps_jget(record, STR_PTR("modelCapabilities"), STR_LEN("modelCapabilities")), &mc) {
        let st: i32 = sa_json_object_set_node(doc, STR_PTR("modelCapabilities"), STR_LEN("modelCapabilities"), mc);
    };
    let sets: u64 = 0;
    ps_field_str_array(record, STR_PTR("supportedEndpointTypes"), STR_LEN("supportedEndpointTypes"), &sets);
    let es: i32 = sa_json_object_set_node(doc, STR_PTR("supportedEndpointTypes"), STR_LEN("supportedEndpointTypes"), sets);
    if responseProtocolValue(ps_jget(record, STR_PTR("responseProtocol"), STR_LEN("responseProtocol")), &vp, &vl) {
        let st: i32 = sa_json_object_set_string(doc, STR_PTR("responseProtocol"), STR_LEN("responseProtocol"), vp, vl);
    };
    if responseProtocolModeValue(ps_jget(record, STR_PTR("responseProtocolMode"), STR_LEN("responseProtocolMode")), &vp, &vl) {
        let st: i32 = sa_json_object_set_string(doc, STR_PTR("responseProtocolMode"), STR_LEN("responseProtocolMode"), vp, vl);
    };
    let cche: bool = false;
    let has_cche: bool = ps_field_bool(record, STR_PTR("claudeCodeHeadersEnabled"), STR_LEN("claudeCodeHeadersEnabled"), &cche);
    let ecc: i32 = sa_json_object_set_bool(doc, STR_PTR("claudeCodeHeadersEnabled"), STR_LEN("claudeCodeHeadersEnabled"), has_cche && cche);
    let sccv: bool = ps_set_sv(doc, STR_PTR("claudeCodeVersion"), STR_LEN("claudeCodeVersion"), ps_jget(record, STR_PTR("claudeCodeVersion"), STR_LEN("claudeCodeVersion")));
    let sepo: bool = ps_set_sv(doc, STR_PTR("endpointPathOverride"), STR_LEN("endpointPathOverride"), ps_jget(record, STR_PTR("endpointPathOverride"), STR_LEN("endpointPathOverride")));
    if authTypeValue(ps_jget(record, STR_PTR("authType"), STR_LEN("authType")), &vp, &vl) {
        let st: i32 = sa_json_object_set_string(doc, STR_PTR("authType"), STR_LEN("authType"), vp, vl);
    };
    if credentialModeValue(ps_jget(record, STR_PTR("credentialMode"), STR_LEN("credentialMode")), &vp, &vl) {
        let st: i32 = sa_json_object_set_string(doc, STR_PTR("credentialMode"), STR_LEN("credentialMode"), vp, vl);
    };
    let scgn: bool = ps_set_sv(doc, STR_PTR("catalogGroupName"), STR_LEN("catalogGroupName"), ps_jget(record, STR_PTR("catalogGroupName"), STR_LEN("catalogGroupName")));
    let scm: bool = ps_set_boolval(doc, STR_PTR("catalogManaged"), STR_LEN("catalogManaged"), ps_jget(record, STR_PTR("catalogManaged"), STR_LEN("catalogManaged")));
    if has_image {
        let st: i32 = sa_json_object_set_node(doc, STR_PTR("image"), STR_LEN("image"), image_doc);
    };
    let mm: u64 = 0;
    if modelMappingArray(ps_jget(record, STR_PTR("modelMapping"), STR_LEN("modelMapping")), &mm) {
        let st: i32 = sa_json_object_set_node(doc, STR_PTR("modelMapping"), STR_LEN("modelMapping"), mm);
    };
    let scm2: u64 = 0;
    if statusCodeMappingArray(ps_jget(record, STR_PTR("statusCodeMapping"), STR_LEN("statusCodeMapping")), &scm2) {
        let st: i32 = sa_json_object_set_node(doc, STR_PTR("statusCodeMapping"), STR_LEN("statusCodeMapping"), scm2);
    };
    let amm: u64 = 0;
    if advancedModelMappingArray(ps_jget(record, STR_PTR("advancedModelMapping"), STR_LEN("advancedModelMapping")), &amm) {
        let st: i32 = sa_json_object_set_node(doc, STR_PTR("advancedModelMapping"), STR_LEN("advancedModelMapping"), amm);
    };
    let stag: bool = ps_set_sv(doc, STR_PTR("tag"), STR_LEN("tag"), ps_jget(record, STR_PTR("tag"), STR_LEN("tag")));
    let srem: bool = ps_set_sv(doc, STR_PTR("remark"), STR_LEN("remark"), ps_jget(record, STR_PTR("remark"), STR_LEN("remark")));
    let sab: bool = ps_set_boolval(doc, STR_PTR("autoBan"), STR_LEN("autoBan"), ps_jget(record, STR_PTR("autoBan"), STR_LEN("autoBan")));
    let srl: bool = ps_set_num(doc, STR_PTR("requestLimit"), STR_LEN("requestLimit"), ps_jget(record, STR_PTR("requestLimit"), STR_LEN("requestLimit")));
    let sris: bool = ps_set_num(doc, STR_PTR("requestIntervalSeconds"), STR_LEN("requestIntervalSeconds"), ps_jget(record, STR_PTR("requestIntervalSeconds"), STR_LEN("requestIntervalSeconds")));
    let scw: bool = ps_set_num(doc, STR_PTR("contextWindow"), STR_LEN("contextWindow"), ps_jget(record, STR_PTR("contextWindow"), STR_LEN("contextWindow")));
    let cbe: bool = false;
    let has_cbe: bool = ps_field_bool(record, STR_PTR("commandBlacklistEnabled"), STR_LEN("commandBlacklistEnabled"), &cbe);
    let cbe_val: bool = true;
    if has_cbe && !cbe { cbe_val = false; };
    let ecb: i32 = sa_json_object_set_bool(doc, STR_PTR("commandBlacklistEnabled"), STR_LEN("commandBlacklistEnabled"), cbe_val);
    let cbl: u64 = 0;
    ps_field_str_array(record, STR_PTR("commandBlacklist"), STR_LEN("commandBlacklist"), &cbl);
    let ebl: i32 = sa_json_object_set_node(doc, STR_PTR("commandBlacklist"), STR_LEN("commandBlacklist"), cbl);
    let nal: u64 = 0;
    ps_field_str_array(record, STR_PTR("networkAllowlist"), STR_LEN("networkAllowlist"), &nal);
    let enl: i32 = sa_json_object_set_node(doc, STR_PTR("networkAllowlist"), STR_LEN("networkAllowlist"), nal);
    let keys: u64 = 0;
    ps_field_str_array(record, STR_PTR("keys"), STR_LEN("keys"), &keys);
    let eky: i32 = sa_json_object_set_node(doc, STR_PTR("keys"), STR_LEN("keys"), keys);
    let sef: bool = ps_set_boolval(doc, STR_PTR("enableFallback"), STR_LEN("enableFallback"), ps_jget(record, STR_PTR("enableFallback"), STR_LEN("enableFallback")));
    let sfc: bool = ps_set_sv(doc, STR_PTR("fallbackChannelId"), STR_LEN("fallbackChannelId"), ps_jget(record, STR_PTR("fallbackChannelId"), STR_LEN("fallbackChannelId")));
    let sfg: bool = ps_set_sv(doc, STR_PTR("fallbackGroupName"), STR_LEN("fallbackGroupName"), ps_jget(record, STR_PTR("fallbackGroupName"), STR_LEN("fallbackGroupName")));
    let setc: bool = ps_set_boolval(doc, STR_PTR("enableTieredContext"), STR_LEN("enableTieredContext"), ps_jget(record, STR_PTR("enableTieredContext"), STR_LEN("enableTieredContext")));
    let tcr: u64 = 0;
    if tieredContextRatioArray(ps_jget(record, STR_PTR("tieredContextRatios"), STR_LEN("tieredContextRatios")), &tcr) {
        let st: i32 = sa_json_object_set_node(doc, STR_PTR("tieredContextRatios"), STR_LEN("tieredContextRatios"), tcr);
    };
}

fn groupArray(value_json: u64, out_json: &u64) -> bool {
    *out_json = 0;
    if value_json == 0 || sa_json_kind(value_json) != 6 { return false; };
    let out: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    if out == 0 { return false; };
    let count: u64 = 0;
    let cst: i32 = sa_json_value_count(value_json, &count);
    let i: u64 = 0;
    while i < count {
        let item: u64 = 0;
        let ast: i32 = sa_json_array_get(value_json, i, &item);
        let rec: u64 = 0;
        ps_asRecord(item, &rec);
        let entry: u64 = 0;
        ps_group_entry(rec, i, &entry);
        if rec != 0 && rec != item {
            let f: i32 = sa_json_free(rec);
        };
        if entry != 0 {
            // filter: entry.id && entry.name (defaults make both set)
            let idp: ptr = PTR_NULL();
            let idl: u64 = 0;
            let has_id: bool = ps_field_str(entry, STR_PTR("id"), STR_LEN("id"), &idp, &idl);
            let nmp: ptr = PTR_NULL();
            let nml: u64 = 0;
            let has_nm: bool = ps_field_str(entry, STR_PTR("name"), STR_LEN("name"), &nmp, &nml);
            if has_id && idl > 0 && has_nm && nml > 0 {
                let pst: i32 = sa_json_array_push_node(out, entry);
            } else {
                let f: i32 = sa_json_free(entry);
            };
        };
        i = i + 1;
    }
    let kept: u64 = 0;
    let kst: i32 = sa_json_value_count(out, &kept);
    if kept == 0 {
        let f: i32 = sa_json_free(out);
        return false;
    };
    *out_json = out;
    return true;
}

// ---- provider-level functions ----
fn isProviderLike(value_json: u64) -> bool {
    let rec: u64 = 0;
    ps_asRecord(value_json, &rec);
    if rec == 0 || value_json == 0 || sa_json_kind(value_json) != 7 { return false; };
    let id_node: u64 = ps_jget(rec, STR_PTR("id"), STR_LEN("id"));
    let name_node: u64 = ps_jget(rec, STR_PTR("name"), STR_LEN("name"));
    let kind_node: u64 = ps_jget(rec, STR_PTR("kind"), STR_LEN("kind"));
    return id_node != 0 && sa_json_kind(id_node) == 5
        && name_node != 0 && sa_json_kind(name_node) == 5
        && kind_node != 0 && sa_json_kind(kind_node) == 5;
}

fn normalizeProvider(value_json: u64, out_json: &u64) -> bool {
    *out_json = 0;
    if !isProviderLike(value_json) { return false; };
    let record: u64 = value_json;
    let now: f64 = ps_now_ms() as f64;
    let doc: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    if doc == 0 { return false; };
    let p: ptr = PTR_NULL();
    let l: u64 = 0;
    if ps_field_sv(record, STR_PTR("id"), STR_LEN("id"), &p, &l) {
        let st: i32 = sa_json_object_set_string(doc, STR_PTR("id"), STR_LEN("id"), p, l);
    } else {
        let uuid = PsText { bytes: [0; 65536], len: 0 };
        ps_random_uuid(&uuid);
        let st: i32 = sa_json_object_set_string(doc, STR_PTR("id"), STR_LEN("id"), ps_text_ptr(&uuid), uuid.len);
    };
    let kp: ptr = PTR_NULL();
    let kl: u64 = 0;
    providerKindValue(ps_jget(record, STR_PTR("kind"), STR_LEN("kind")), &kp, &kl);
    let kst: i32 = sa_json_object_set_string(doc, STR_PTR("kind"), STR_LEN("kind"), kp, kl);
    if ps_field_sv(record, STR_PTR("name"), STR_LEN("name"), &p, &l) {
        let st: i32 = sa_json_object_set_string(doc, STR_PTR("name"), STR_LEN("name"), p, l);
    } else {
        let st: i32 = sa_json_object_set_string(doc, STR_PTR("name"), STR_LEN("name"), STR_PTR("Provider"), STR_LEN("Provider"));
    };
    let sp: u64 = 0;
    if serviceProviderValue(ps_jget(record, STR_PTR("serviceProvider"), STR_LEN("serviceProvider")), &sp) {
        let st: i32 = sa_json_object_set_node(doc, STR_PTR("serviceProvider"), STR_LEN("serviceProvider"), sp);
    };
    let s1: bool = ps_set_sv(doc, STR_PTR("baseUrl"), STR_LEN("baseUrl"), ps_jget(record, STR_PTR("baseUrl"), STR_LEN("baseUrl")));
    let ep: ptr = PTR_NULL();
    let el: u64 = 0;
    if envKeyRefValue(ps_jget(record, STR_PTR("apiKeyRef"), STR_LEN("apiKeyRef")), &ep, &el) {
        let st: i32 = sa_json_object_set_string(doc, STR_PTR("apiKeyRef"), STR_LEN("apiKeyRef"), ep, el);
    };
    let s2: bool = ps_set_sv(doc, STR_PTR("apiKeyPreview"), STR_LEN("apiKeyPreview"), ps_jget(record, STR_PTR("apiKeyPreview"), STR_LEN("apiKeyPreview")));
    if apiKeyStorageValue(ps_jget(record, STR_PTR("apiKeyStorage"), STR_LEN("apiKeyStorage")), &ep, &el) {
        let st: i32 = sa_json_object_set_string(doc, STR_PTR("apiKeyStorage"), STR_LEN("apiKeyStorage"), ep, el);
    };
    let s3: bool = ps_set_sv(doc, STR_PTR("defaultModel"), STR_LEN("defaultModel"), ps_jget(record, STR_PTR("defaultModel"), STR_LEN("defaultModel")));
    let rc: f64 = 0.0;
    if retryCountValue(ps_jget(record, STR_PTR("streamMaxRetries"), STR_LEN("streamMaxRetries")), &rc) {
        let st: i32 = sa_json_object_set_f64(doc, STR_PTR("streamMaxRetries"), STR_LEN("streamMaxRetries"), rc);
    };
    let img: u64 = 0;
    if imageProviderConfig(ps_jget(record, STR_PTR("image"), STR_LEN("image")), &img) {
        let st: i32 = sa_json_object_set_node(doc, STR_PTR("image"), STR_LEN("image"), img);
    };
    let nm: u64 = 0;
    ps_stringArray(ps_jget(record, STR_PTR("nativeModels"), STR_LEN("nativeModels")), &nm);
    let s4: i32 = sa_json_object_set_node(doc, STR_PTR("nativeModels"), STR_LEN("nativeModels"), nm);
    let al: u64 = 0;
    aliasArray(ps_jget(record, STR_PTR("modelAliases"), STR_LEN("modelAliases")), &al);
    let s5: i32 = sa_json_object_set_node(doc, STR_PTR("modelAliases"), STR_LEN("modelAliases"), al);
    let mdn: u64 = 0;
    if ps_stringRecord(ps_jget(record, STR_PTR("modelDisplayNames"), STR_LEN("modelDisplayNames")), &mdn) {
        let st: i32 = sa_json_object_set_node(doc, STR_PTR("modelDisplayNames"), STR_LEN("modelDisplayNames"), mdn);
    };
    let mr: u64 = 0;
    if modelRateArray(ps_jget(record, STR_PTR("modelRates"), STR_LEN("modelRates")), &mr) {
        let st: i32 = sa_json_object_set_node(doc, STR_PTR("modelRates"), STR_LEN("modelRates"), mr);
    };
    let cc: u64 = 0;
    if capabilityCatalogValue(ps_jget(record, STR_PTR("capabilityCatalog"), STR_LEN("capabilityCatalog")), &cc) {
        let st: i32 = sa_json_object_set_node(doc, STR_PTR("capabilityCatalog"), STR_LEN("capabilityCatalog"), cc);
    };
    let s6: bool = ps_set_sv(doc, STR_PTR("capabilityCatalogUrl"), STR_LEN("capabilityCatalogUrl"), ps_jget(record, STR_PTR("capabilityCatalogUrl"), STR_LEN("capabilityCatalogUrl")));
    if channelModeValue(ps_jget(record, STR_PTR("channelMode"), STR_LEN("channelMode")), &ep, &el) {
        let st: i32 = sa_json_object_set_string(doc, STR_PTR("channelMode"), STR_LEN("channelMode"), ep, el);
    };
    let groups: u64 = 0;
    if groupArray(ps_jget(record, STR_PTR("groups"), STR_LEN("groups")), &groups) {
        let st: i32 = sa_json_object_set_node(doc, STR_PTR("groups"), STR_LEN("groups"), groups);
    };
    let s7: bool = ps_set_nullable(doc, STR_PTR("quotaUsd"), STR_LEN("quotaUsd"), ps_jget(record, STR_PTR("quotaUsd"), STR_LEN("quotaUsd")));
    let s8: bool = ps_set_num(doc, STR_PTR("usedQuotaUsd"), STR_LEN("usedQuotaUsd"), ps_jget(record, STR_PTR("usedQuotaUsd"), STR_LEN("usedQuotaUsd")));
    if stationTypeValue(ps_jget(record, STR_PTR("stationType"), STR_LEN("stationType")), &ep, &el) {
        let st: i32 = sa_json_object_set_string(doc, STR_PTR("stationType"), STR_LEN("stationType"), ep, el);
    };
    let s9: bool = ps_set_boolval(doc, STR_PTR("enableCheckin"), STR_LEN("enableCheckin"), ps_jget(record, STR_PTR("enableCheckin"), STR_LEN("enableCheckin")));
    let s10: bool = ps_set_boolval(doc, STR_PTR("remindCheckin"), STR_LEN("remindCheckin"), ps_jget(record, STR_PTR("remindCheckin"), STR_LEN("remindCheckin")));
    let s11: bool = ps_set_sv(doc, STR_PTR("remark"), STR_LEN("remark"), ps_jget(record, STR_PTR("remark"), STR_LEN("remark")));
    let si: u64 = 0;
    if sharedImportValue(ps_jget(record, STR_PTR("sharedImport"), STR_LEN("sharedImport")), &si) {
        let st: i32 = sa_json_object_set_node(doc, STR_PTR("sharedImport"), STR_LEN("sharedImport"), si);
    };
    let s12: bool = ps_set_num(doc, STR_PTR("trashedAt"), STR_LEN("trashedAt"), ps_jget(record, STR_PTR("trashedAt"), STR_LEN("trashedAt")));
    let ca: f64 = 0.0;
    if ps_field_number(record, STR_PTR("createdAt"), STR_LEN("createdAt"), &ca) {
        let st: i32 = sa_json_object_set_f64(doc, STR_PTR("createdAt"), STR_LEN("createdAt"), ca);
    } else {
        let st: i32 = sa_json_object_set_f64(doc, STR_PTR("createdAt"), STR_LEN("createdAt"), now);
    };
    let ua: f64 = 0.0;
    if ps_field_number(record, STR_PTR("updatedAt"), STR_LEN("updatedAt"), &ua) {
        let st: i32 = sa_json_object_set_f64(doc, STR_PTR("updatedAt"), STR_LEN("updatedAt"), ua);
    } else {
        let st: i32 = sa_json_object_set_f64(doc, STR_PTR("updatedAt"), STR_LEN("updatedAt"), now);
    };
    normalizeProviderTopology(doc, out_json);
    let f: i32 = sa_json_free(doc);
    return *out_json != 0;
}

fn parseProvider(payload_ptr: ptr, payload_len: u64, out_json: &u64) -> bool {
    *out_json = 0;
    let doc: u64 = sa_json_parse(payload_ptr, payload_len);
    if doc == 0 { return false; };
    let ok: bool = normalizeProvider(doc, out_json);
    let f: i32 = sa_json_free(doc);
    return ok;
}

// hostname of a URL (scheme required, userinfo/port stripped)
fn ps_hostname(p: ptr, len: u64, out: &PsText) -> bool {
    out.len = 0;
    let scheme: i64 = -1;
    let i: u64 = 0;
    while i + 3 <= len {
        if ps_byte(p, i) == 58 && ps_byte(p, i + 1) == 47 && ps_byte(p, i + 2) == 47 {
            scheme = i as i64;
            break;
        };
        i = i + 1;
    }
    if scheme < 0 { return false; };
    let start: u64 = (scheme as u64) + 3;
    let end: u64 = start;
    while end < len {
        let c: u8 = ps_byte(p, end);
        if c == 47 || c == 63 || c == 35 { break; };
        end = end + 1;
    }
    let host_start: u64 = start;
    let j: u64 = start;
    while j < end {
        if ps_byte(p, j) == 64 { host_start = j + 1; };
        j = j + 1;
    }
    let host_end: u64 = end;
    j = host_start;
    while j < end {
        if ps_byte(p, j) == 58 { host_end = j; break; };
        j = j + 1;
    }
    if host_end <= host_start { return false; };
    j = host_start;
    while j < host_end {
        if out.len < 65536 {
            out.bytes[out.len] = ps_lower(ps_byte(p, j));
            out.len = out.len + 1;
        };
        j = j + 1;
    }
    return true;
}

fn ps_is_deepkey_url(p: ptr, len: u64) -> bool {
    let host = PsText { bytes: [0; 65536], len: 0 };
    if !ps_hostname(p, len, &host) { return false; };
    if ps_eq(ps_text_ptr(&host), host.len, STR_PTR("deepkey.top"), STR_LEN("deepkey.top")) { return true; };
    let suf: ptr = STR_PTR(".deepkey.top");
    let suf_l: u64 = STR_LEN(".deepkey.top");
    if host.len <= suf_l { return false; };
    let tail: ptr = PTR_NULL();
    PTR_BYTE_ADD(tail, ps_text_ptr(&host), host.len - suf_l);
    return ps_eq(tail, suf_l, suf, suf_l);
}

fn isDeepKeyProvider(provider_json: u64) -> bool {
    let sp: u64 = 0;
    ps_asRecord(ps_jget(provider_json, STR_PTR("serviceProvider"), STR_LEN("serviceProvider")), &sp);
    let id_p: ptr = PTR_NULL();
    let id_l: u64 = 0;
    if ps_field_sv(sp, STR_PTR("id"), STR_LEN("id"), &id_p, &id_l) {
        let lowered = PsText { bytes: [0; 65536], len: 0 };
        let i: u64 = 0;
        while i < id_l {
            if lowered.len < 65536 {
                lowered.bytes[lowered.len] = ps_lower(ps_byte(id_p, i));
                lowered.len = lowered.len + 1;
            };
            i = i + 1;
        }
        if ps_eq(ps_text_ptr(&lowered), lowered.len, STR_PTR("deepkey"), STR_LEN("deepkey")) { return true; };
    };
    if sp != 0 && sp != ps_jget(provider_json, STR_PTR("serviceProvider"), STR_LEN("serviceProvider")) {
        let f: i32 = sa_json_free(sp);
    };
    let p: ptr = PTR_NULL();
    let l: u64 = 0;
    if ps_field_str(provider_json, STR_PTR("baseUrl"), STR_LEN("baseUrl"), &p, &l) {
        if ps_is_deepkey_url(p, l) { return true; };
    };
    if ps_field_str(provider_json, STR_PTR("capabilityCatalogUrl"), STR_LEN("capabilityCatalogUrl"), &p, &l) {
        if ps_is_deepkey_url(p, l) { return true; };
    };
    let groups: u64 = ps_jget(provider_json, STR_PTR("groups"), STR_LEN("groups"));
    if groups != 0 && sa_json_kind(groups) == 6 {
        let count: u64 = 0;
        let cst: i32 = sa_json_value_count(groups, &count);
        let i: u64 = 0;
        while i < count {
            let g: u64 = 0;
            let ast: i32 = sa_json_array_get(groups, i, &g);
            if ps_field_str(g, STR_PTR("baseUrl"), STR_LEN("baseUrl"), &p, &l) {
                if ps_is_deepkey_url(p, l) { return true; };
            };
            i = i + 1;
        }
    };
    return false;
}

fn normalizeProviderTopology(provider_json: u64, out_json: &u64) -> void {
    let id_p: ptr = PTR_NULL();
    let id_l: u64 = 0;
    let has_id: bool = ps_field_str(provider_json, STR_PTR("id"), STR_LEN("id"), &id_p, &id_l);
    if has_id && ps_eq(id_p, id_l, STR_PTR("omniroute-free"), STR_LEN("omniroute-free")) {
        let doc: u64 = ps_clone(provider_json);
        *out_json = doc;
        if doc == 0 { return; };
        let s1: i32 = sa_json_object_set_string(doc, STR_PTR("name"), STR_LEN("name"), STR_PTR("CodexUltraFree"), STR_LEN("CodexUltraFree"));
        let sp: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
        if sp != 0 {
            let a: i32 = sa_json_object_set_string(sp, STR_PTR("id"), STR_LEN("id"), STR_PTR("codex-ultra-free"), STR_LEN("codex-ultra-free"));
            let b: i32 = sa_json_object_set_string(sp, STR_PTR("name"), STR_LEN("name"), STR_PTR("CodexUltraFree"), STR_LEN("CodexUltraFree"));
            let s2: i32 = sa_json_object_set_node(doc, STR_PTR("serviceProvider"), STR_LEN("serviceProvider"), sp);
        };
        let groups: u64 = ps_jget(doc, STR_PTR("groups"), STR_LEN("groups"));
        if groups != 0 && sa_json_kind(groups) == 6 {
            let mapped: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
            let count: u64 = 0;
            let cst: i32 = sa_json_value_count(groups, &count);
            let i: u64 = 0;
            while i < count {
                let g: u64 = 0;
                let ast: i32 = sa_json_array_get(groups, i, &g);
                let gc: u64 = ps_clone(g);
                if gc != 0 {
                    let gid_p: ptr = PTR_NULL();
                    let gid_l: u64 = 0;
                    let has_gid: bool = ps_field_str(gc, STR_PTR("id"), STR_LEN("id"), &gid_p, &gid_l);
                    let gid = PsText { bytes: [0; 65536], len: 0 };
                    if has_gid { ps_append(&gid, gid_p, gid_l); };
                    let gname_p: ptr = PTR_NULL();
                    let gname_l: u64 = 0;
                    let has_gname: bool = ps_field_str(gc, STR_PTR("name"), STR_LEN("name"), &gname_p, &gname_l);
                    let gname = PsText { bytes: [0; 65536], len: 0 };
                    if has_gname { ps_append(&gname, gname_p, gname_l); };
                    let gp: ptr = ps_text_ptr(&gid);
                    let gl: u64 = gid.len;
                    let new_name = PsText { bytes: [0; 65536], len: 0 };
                    let proto: ptr = STR_PTR("openai-response");
                    let proto_l: u64 = STR_LEN("openai-response");
                    if ps_eq(gp, gl, STR_PTR("opencode-free"), STR_LEN("opencode-free")) {
                        ps_append(&new_name, STR_PTR("CodexUltraFree"), STR_LEN("CodexUltraFree"));
                        proto = STR_PTR("openai");
                        proto_l = STR_LEN("openai");
                    } else {
                        if ps_eq(gp, gl, STR_PTR("opencode"), STR_LEN("opencode")) {
                            if gname.len > 0 { ps_append(&new_name, ps_text_ptr(&gname), gname.len); } else { ps_append(&new_name, STR_PTR("OpenCode"), STR_LEN("OpenCode")); };
                            proto = STR_PTR("openai");
                            proto_l = STR_LEN("openai");
                        } else {
                            if ps_eq(gp, gl, STR_PTR("kilocode"), STR_LEN("kilocode")) {
                                if gname.len > 0 { ps_append(&new_name, ps_text_ptr(&gname), gname.len); } else { ps_append(&new_name, STR_PTR("KiloCode"), STR_LEN("KiloCode")); };
                            } else {
                                if ps_eq(gp, gl, STR_PTR("cline-free"), STR_LEN("cline-free")) {
                                    if gname.len > 0 { ps_append(&new_name, ps_text_ptr(&gname), gname.len); } else { ps_append(&new_name, STR_PTR("ClineFree"), STR_LEN("ClineFree")); };
                                    proto = STR_PTR("openai");
                                    proto_l = STR_LEN("openai");
                                } else {
                                    if ps_eq(gp, gl, STR_PTR("freebuff"), STR_LEN("freebuff")) {
                                        if gname.len > 0 { ps_append(&new_name, ps_text_ptr(&gname), gname.len); } else { ps_append(&new_name, STR_PTR("Freebuff"), STR_LEN("Freebuff")); };
                                        proto = STR_PTR("openai");
                                        proto_l = STR_LEN("openai");
                                    } else {
                                        if ps_eq(gp, gl, STR_PTR("d2api"), STR_LEN("d2api")) {
                                            if gname.len > 0 { ps_append(&new_name, ps_text_ptr(&gname), gname.len); } else { ps_append(&new_name, STR_PTR("D2API"), STR_LEN("D2API")); };
                                            proto = STR_PTR("openai");
                                            proto_l = STR_LEN("openai");
                                        } else {
                                            ps_append(&new_name, ps_text_ptr(&gname), gname.len);
                                        };
                                    };
                                };
                            };
                        };
                    };
                    let n1: i32 = sa_json_object_set_string(gc, STR_PTR("name"), STR_LEN("name"), ps_text_ptr(&new_name), new_name.len);
                    let n2: i32 = sa_json_object_set_string(gc, STR_PTR("responseProtocol"), STR_LEN("responseProtocol"), proto, proto_l);
                    let n3: i32 = sa_json_object_set_string(gc, STR_PTR("responseProtocolMode"), STR_LEN("responseProtocolMode"), STR_PTR("fixed"), STR_LEN("fixed"));
                    let pst: i32 = sa_json_array_push_node(mapped, gc);
                };
                i = i + 1;
            }
            let s3: i32 = sa_json_object_set_node(doc, STR_PTR("groups"), STR_LEN("groups"), mapped);
        };
        return;
    };
    if isDeepKeyProvider(provider_json) {
        let doc: u64 = ps_clone(provider_json);
        *out_json = doc;
        if doc == 0 { return; };
        let sp: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
        if sp != 0 {
            let a: i32 = sa_json_object_set_string(sp, STR_PTR("id"), STR_LEN("id"), STR_PTR("deepkey"), STR_LEN("deepkey"));
            let b: i32 = sa_json_object_set_string(sp, STR_PTR("name"), STR_LEN("name"), STR_PTR("DeepKey"), STR_LEN("DeepKey"));
            // logo: the original serviceProvider.logo, raw
            let orig_sp: u64 = ps_jget(provider_json, STR_PTR("serviceProvider"), STR_LEN("serviceProvider"));
            let logo_p: ptr = PTR_NULL();
            let logo_l: u64 = 0;
            if ps_field_str(orig_sp, STR_PTR("logo"), STR_LEN("logo"), &logo_p, &logo_l) {
                let c: i32 = sa_json_object_set_string(sp, STR_PTR("logo"), STR_LEN("logo"), logo_p, logo_l);
            };
            let s2: i32 = sa_json_object_set_node(doc, STR_PTR("serviceProvider"), STR_LEN("serviceProvider"), sp);
        };
        return;
    };
    *out_json = ps_clone(provider_json);
}

// ---- group topology helpers ----
fn ps_groups_of(provider_json: u64, out_count: &u64) -> u64 {
    let groups: u64 = ps_jget(provider_json, STR_PTR("groups"), STR_LEN("groups"));
    *out_count = 0;
    if groups == 0 || sa_json_kind(groups) != 6 { return 0; };
    let cst: i32 = sa_json_value_count(groups, out_count);
    return groups;
}

fn ensureDefaultRelayGroup(provider_json: u64, apiKey_ptr: ptr, apiKey_len: u64, out_json: &u64) -> void {
    // secret = apiKey?.trim() ?? ""
    let lo: u64 = 0;
    let hi: u64 = 0;
    ps_trim_range(apiKey_ptr, apiKey_len, &lo, &hi);
    let secret = PsText { bytes: [0; 65536], len: 0 };
    if hi > lo {
        let seg: ptr = PTR_NULL();
        PTR_BYTE_ADD(seg, apiKey_ptr, lo);
        ps_append(&secret, seg, hi - lo);
    };
    let count: u64 = 0;
    let groups: u64 = ps_groups_of(provider_json, &count);
    if groups != 0 && count > 0 {
        let first: u64 = 0;
        let ast: i32 = sa_json_array_get(groups, 0, &first);
        let keys: u64 = ps_jget(first, STR_PTR("keys"), STR_LEN("keys"));
        let key_count: u64 = 0;
        if keys != 0 && sa_json_kind(keys) == 6 {
            let kst: i32 = sa_json_value_count(keys, &key_count);
        };
        if secret.len == 0 || key_count > 0 {
            *out_json = ps_clone(provider_json);
            return;
        };
        // copy with groups[0] = {...g0, credentialMode: "group", keys: [secret]}
        let doc: u64 = ps_clone(provider_json);
        *out_json = doc;
        if doc == 0 { return; };
        let dgroups: u64 = ps_jget(doc, STR_PTR("groups"), STR_LEN("groups"));
        let mapped: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
        let i: u64 = 0;
        while i < count {
            let g: u64 = 0;
            let gst: i32 = sa_json_array_get(dgroups, i, &g);
            let gc: u64 = ps_clone(g);
            if gc != 0 {
                if i == 0 {
                    let m1: i32 = sa_json_object_set_string(gc, STR_PTR("credentialMode"), STR_LEN("credentialMode"), STR_PTR("group"), STR_LEN("group"));
                    let keys_arr: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
                    if keys_arr != 0 {
                        let pst2: i32 = sa_json_array_push_string(keys_arr, ps_text_ptr(&secret), secret.len);
                        let m2: i32 = sa_json_object_set_node(gc, STR_PTR("keys"), STR_LEN("keys"), keys_arr);
                    };
                };
                let pst: i32 = sa_json_array_push_node(mapped, gc);
            };
            i = i + 1;
        }
        let s: i32 = sa_json_object_set_node(doc, STR_PTR("groups"), STR_LEN("groups"), mapped);
        return;
    };
    if secret.len == 0 {
        *out_json = ps_clone(provider_json);
        return;
    };
    // default fast-mode group carrying the secret
    let doc: u64 = ps_clone(provider_json);
    *out_json = doc;
    if doc == 0 { return; };
    if ps_jget(doc, STR_PTR("channelMode"), STR_LEN("channelMode")) == 0 {
        let cm_p: ptr = PTR_NULL();
        let cm_l: u64 = 0;
        // channelMode ?? "fast": set only when absent
        let s0: i32 = sa_json_object_set_string(doc, STR_PTR("channelMode"), STR_LEN("channelMode"), STR_PTR("fast"), STR_LEN("fast"));
        let ig = cm_p;
    };
    let group: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    if group == 0 { return; };
    let g1: i32 = sa_json_object_set_string(group, STR_PTR("id"), STR_LEN("id"), STR_PTR("default"), STR_LEN("default"));
    let g2: i32 = sa_json_object_set_string(group, STR_PTR("name"), STR_LEN("name"), STR_PTR("default"), STR_LEN("default"));
    let g3: i32 = sa_json_object_set_string(group, STR_PTR("kind"), STR_LEN("kind"), STR_PTR("text"), STR_LEN("text"));
    let g4: i32 = sa_json_object_set_string(group, STR_PTR("status"), STR_LEN("status"), STR_PTR("enabled"), STR_LEN("enabled"));
    let g5: i32 = sa_json_object_set_f64(group, STR_PTR("groupRatio"), STR_LEN("groupRatio"), 1.0);
    let g6: i32 = sa_json_object_set_string(group, STR_PTR("keyMode"), STR_LEN("keyMode"), STR_PTR("polling"), STR_LEN("polling"));
    // models = uniqueStrings([defaultModel ?? "", ...nativeModels].filter(Boolean))
    let models_src: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    let dm_p: ptr = PTR_NULL();
    let dm_l: u64 = 0;
    if ps_field_str(doc, STR_PTR("defaultModel"), STR_LEN("defaultModel"), &dm_p, &dm_l) {
        let pst: i32 = sa_json_array_push_string(models_src, dm_p, dm_l);
    };
    let natives: u64 = ps_jget(doc, STR_PTR("nativeModels"), STR_LEN("nativeModels"));
    if natives != 0 && sa_json_kind(natives) == 6 {
        let nc: u64 = 0;
        let nst: i32 = sa_json_value_count(natives, &nc);
        let i: u64 = 0;
        while i < nc {
            let item: u64 = 0;
            let ast: i32 = sa_json_array_get(natives, i, &item);
            let pst: i32 = sa_json_array_push_node(models_src, ps_clone(item));
            i = i + 1;
        }
    };
    // filter(Boolean): drop empty strings
    let filtered: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    if models_src != 0 {
        let fc: u64 = 0;
        let fst: i32 = sa_json_value_count(models_src, &fc);
        let i: u64 = 0;
        while i < fc {
            let item: u64 = 0;
            let ast: i32 = sa_json_array_get(models_src, i, &item);
            let sp: ptr = PTR_NULL();
            let sl: u64 = 0;
            if ps_jstr(item, &sp, &sl) && sl > 0 {
                let pst: i32 = sa_json_array_push_string(filtered, sp, sl);
            };
            i = i + 1;
        }
        let f: i32 = sa_json_free(models_src);
    };
    let models: u64 = 0;
    ps_uniqueStrings(filtered, &models);
    if filtered != 0 {
        let f: i32 = sa_json_free(filtered);
    };
    let g7: i32 = sa_json_object_set_node(group, STR_PTR("models"), STR_LEN("models"), models);
    let kind_p: ptr = PTR_NULL();
    let kind_l: u64 = 0;
    let has_kind: bool = ps_field_str(doc, STR_PTR("kind"), STR_LEN("kind"), &kind_p, &kind_l);
    let proto: ptr = STR_PTR("openai-response");
    let proto_l: u64 = STR_LEN("openai-response");
    if has_kind && ps_eq(kind_p, kind_l, STR_PTR("openai"), STR_LEN("openai")) {
        proto = STR_PTR("openai");
        proto_l = STR_LEN("openai");
    };
    let g8: i32 = sa_json_object_set_string(group, STR_PTR("responseProtocol"), STR_LEN("responseProtocol"), proto, proto_l);
    let g9: i32 = sa_json_object_set_string(group, STR_PTR("responseProtocolMode"), STR_LEN("responseProtocolMode"), STR_PTR("fixed"), STR_LEN("fixed"));
    let g10: i32 = sa_json_object_set_string(group, STR_PTR("authType"), STR_LEN("authType"), STR_PTR("inherit"), STR_LEN("inherit"));
    let g11: i32 = sa_json_object_set_string(group, STR_PTR("credentialMode"), STR_LEN("credentialMode"), STR_PTR("group"), STR_LEN("group"));
    let keys_arr: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    if keys_arr != 0 {
        let pst: i32 = sa_json_array_push_string(keys_arr, ps_text_ptr(&secret), secret.len);
        let g12: i32 = sa_json_object_set_node(group, STR_PTR("keys"), STR_LEN("keys"), keys_arr);
    };
    let groups_arr: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    if groups_arr != 0 {
        let pst: i32 = sa_json_array_push_node(groups_arr, group);
        let s: i32 = sa_json_object_set_node(doc, STR_PTR("groups"), STR_LEN("groups"), groups_arr);
    };
}

fn hasValidRelayGroups(provider_json: u64) -> bool {
    let count: u64 = 0;
    let groups: u64 = ps_groups_of(provider_json, &count);
    if groups == 0 || count == 0 { return false; };
    let kind_p: ptr = PTR_NULL();
    let kind_l: u64 = 0;
    if ps_field_str(provider_json, STR_PTR("kind"), STR_LEN("kind"), &kind_p, &kind_l) {
        if ps_eq(kind_p, kind_l, STR_PTR("chatgpt"), STR_LEN("chatgpt")) { return true; };
    };
    let i: u64 = 0;
    while i < count {
        let g: u64 = 0;
        let ast: i32 = sa_json_array_get(groups, i, &g);
        let keys: u64 = ps_jget(g, STR_PTR("keys"), STR_LEN("keys"));
        if keys != 0 && sa_json_kind(keys) == 6 {
            let kc: u64 = 0;
            let kst: i32 = sa_json_value_count(keys, &kc);
            let j: u64 = 0;
            while j < kc {
                let item: u64 = 0;
                let gst: i32 = sa_json_array_get(keys, j, &item);
                let kp: ptr = PTR_NULL();
                let kl: u64 = 0;
                if ps_jstr(item, &kp, &kl) {
                    let lo: u64 = 0;
                    let hi: u64 = 0;
                    ps_trim_range(kp, kl, &lo, &hi);
                    if hi > lo { return true; };
                };
                j = j + 1;
            }
        };
        i = i + 1;
    }
    let ref_p: ptr = PTR_NULL();
    let ref_l: u64 = 0;
    if ps_field_str(provider_json, STR_PTR("apiKeyRef"), STR_LEN("apiKeyRef"), &ref_p, &ref_l) {
        let lo: u64 = 0;
        let hi: u64 = 0;
        ps_trim_range(ref_p, ref_l, &lo, &hi);
        if hi > lo { return true; };
    };
    return false;
}

fn relayGroupIdsMatch(left_json: u64, right_json: u64) -> bool {
    let lc: u64 = 0;
    let rc: u64 = 0;
    if left_json != 0 && sa_json_kind(left_json) == 6 {
        let st: i32 = sa_json_value_count(left_json, &lc);
    };
    if right_json != 0 && sa_json_kind(right_json) == 6 {
        let st: i32 = sa_json_value_count(right_json, &rc);
    };
    if lc != rc { return false; };
    let i: u64 = 0;
    while i < lc {
        let g: u64 = 0;
        let ast: i32 = sa_json_array_get(left_json, i, &g);
        let id_p: ptr = PTR_NULL();
        let id_l: u64 = 0;
        if !ps_field_str(g, STR_PTR("id"), STR_LEN("id"), &id_p, &id_l) { return false; };
        let id = PsText { bytes: [0; 65536], len: 0 };
        ps_append(&id, id_p, id_l);
        let found: bool = false;
        let j: u64 = 0;
        while j < rc {
            let g2: u64 = 0;
            let gst: i32 = sa_json_array_get(right_json, j, &g2);
            let p2: ptr = PTR_NULL();
            let l2: u64 = 0;
            if ps_field_str(g2, STR_PTR("id"), STR_LEN("id"), &p2, &l2) {
                if ps_eq(p2, l2, ps_text_ptr(&id), id.len) { found = true; };
            };
            j = j + 1;
        }
        if !found { return false; };
        i = i + 1;
    }
    return true;
}

fn relayGroupCompletenessScore(groups_json: u64) -> i64 {
    if groups_json == 0 || sa_json_kind(groups_json) != 6 { return 0; };
    let count: u64 = 0;
    let cst: i32 = sa_json_value_count(groups_json, &count);
    let score: i64 = 0;
    let i: u64 = 0;
    while i < count {
        let g: u64 = 0;
        let ast: i32 = sa_json_array_get(groups_json, i, &g);
        let keys: u64 = ps_jget(g, STR_PTR("keys"), STR_LEN("keys"));
        if keys != 0 && sa_json_kind(keys) == 6 {
            let kc: u64 = 0;
            let kst: i32 = sa_json_value_count(keys, &kc);
            let j: u64 = 0;
            while j < kc {
                let item: u64 = 0;
                let gst: i32 = sa_json_array_get(keys, j, &item);
                let kp: ptr = PTR_NULL();
                let kl: u64 = 0;
                if ps_jstr(item, &kp, &kl) {
                    let lo: u64 = 0;
                    let hi: u64 = 0;
                    ps_trim_range(kp, kl, &lo, &hi);
                    if hi > lo { score = score + 4; };
                };
                j = j + 1;
            }
        };
        let models: u64 = ps_jget(g, STR_PTR("models"), STR_LEN("models"));
        if models != 0 && sa_json_kind(models) == 6 {
            let mc: u64 = 0;
            let mst: i32 = sa_json_value_count(models, &mc);
            score = score + ((mc as i64) * 2);
        };
        let sets: u64 = ps_jget(g, STR_PTR("supportedEndpointTypes"), STR_LEN("supportedEndpointTypes"));
        if sets != 0 && sa_json_kind(sets) == 6 {
            let sc: u64 = 0;
            let sst: i32 = sa_json_value_count(sets, &sc);
            score = score + (sc as i64);
        };
        let mm: u64 = ps_jget(g, STR_PTR("modelMapping"), STR_LEN("modelMapping"));
        if mm != 0 && sa_json_kind(mm) == 6 {
            let mc2: u64 = 0;
            let mst2: i32 = sa_json_value_count(mm, &mc2);
            score = score + (mc2 as i64);
        };
        let st_p: ptr = PTR_NULL();
        let st_l: u64 = 0;
        if ps_field_str(g, STR_PTR("status"), STR_LEN("status"), &st_p, &st_l) {
            if ps_eq(st_p, st_l, STR_PTR("enabled"), STR_LEN("enabled")) { score = score + 1; };
        };
        i = i + 1;
    }
    return score;
}

fn relayGroupTopologyMatches(left_json: u64, right_json: u64) -> bool {
    if !relayGroupIdsMatch(left_json, right_json) { return false; };
    return relayGroupCompletenessScore(left_json) == relayGroupCompletenessScore(right_json);
}

fn selectConsistentRelayGroups(payload_json: u64, persisted_json: u64, has_persisted: bool, out_json: &u64) -> void {
    // borrowed selection: the caller clones before adopting
    let payload_count: u64 = 0;
    if payload_json != 0 && sa_json_kind(payload_json) == 6 {
        let st: i32 = sa_json_value_count(payload_json, &payload_count);
    };
    let persisted_count: u64 = 0;
    if has_persisted && persisted_json != 0 && sa_json_kind(persisted_json) == 6 {
        let st: i32 = sa_json_value_count(persisted_json, &persisted_count);
    };
    if !has_persisted || persisted_count == 0 {
        if payload_count > 0 {
            *out_json = payload_json;
        } else {
            *out_json = persisted_json;
        };
        return;
    };
    if payload_count == 0 {
        *out_json = persisted_json;
        return;
    };
    if relayGroupIdsMatch(payload_json, persisted_json) {
        *out_json = persisted_json;
        return;
    };
    if payload_count >= persisted_count {
        *out_json = payload_json;
    } else {
        *out_json = persisted_json;
    };
}

fn uniqueGroupValue(preferred_ptr: ptr, preferred_len: u64, used: u64, out_ptr: &ptr, out_len: &u64) -> void {
    let lo: u64 = 0;
    let hi: u64 = 0;
    ps_trim_range(preferred_ptr, preferred_len, &lo, &hi);
    let base = PsText { bytes: [0; 65536], len: 0 };
    if hi > lo {
        let seg: ptr = PTR_NULL();
        PTR_BYTE_ADD(seg, preferred_ptr, lo);
        ps_append(&base, seg, hi - lo);
    };
    if base.len == 0 {
        ps_append(&base, STR_PTR("default"), STR_LEN("default"));
    };
    let candidate = PsText { bytes: [0; 65536], len: 0 };
    ps_append(&candidate, ps_text_ptr(&base), base.len);
    let suffix: u64 = 2;
    while ps_group_name_used(used, ps_text_ptr(&candidate), candidate.len) {
        candidate.len = 0;
        ps_append(&candidate, ps_text_ptr(&base), base.len);
        ps_append(&candidate, STR_PTR("-"), STR_LEN("-"));
        ps_u64_dec(suffix, &candidate);
        suffix = suffix + 1;
    }
    // register lowercased candidate in the used set
    let lowered = PsText { bytes: [0; 65536], len: 0 };
    let i: u64 = 0;
    while i < candidate.len {
        if lowered.len < 65536 {
            lowered.bytes[lowered.len] = ps_lower(candidate.bytes[i]);
            lowered.len = lowered.len + 1;
        };
        i = i + 1;
    }
    if used != 0 {
        let st: i32 = sa_json_object_set_bool(used, ps_text_ptr(&lowered), lowered.len, true);
    };
    ps_doc_str(STR_PTR("groupvalue"), STR_LEN("groupvalue"), ps_text_ptr(&candidate), candidate.len, out_ptr, out_len);
}

fn ps_group_name_used(used: u64, p: ptr, l: u64) -> bool {
    if used == 0 { return false; };
    let lowered = PsText { bytes: [0; 65536], len: 0 };
    let i: u64 = 0;
    while i < l {
        if lowered.len < 65536 {
            lowered.bytes[lowered.len] = ps_lower(ps_byte(p, i));
            lowered.len = lowered.len + 1;
        };
        i = i + 1;
    }
    return ps_jget(used, ps_text_ptr(&lowered), lowered.len) != 0;
}

fn ps_used_set_from_groups(groups: u64, by_name: bool) -> u64 {
    let set: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    if set == 0 || groups == 0 || sa_json_kind(groups) != 6 { return set; };
    let count: u64 = 0;
    let cst: i32 = sa_json_value_count(groups, &count);
    let i: u64 = 0;
    while i < count {
        let g: u64 = 0;
        let ast: i32 = sa_json_array_get(groups, i, &g);
        let key: ptr = STR_PTR("id");
        let key_l: u64 = STR_LEN("id");
        if by_name {
            key = STR_PTR("name");
            key_l = STR_LEN("name");
        };
        let p: ptr = PTR_NULL();
        let l: u64 = 0;
        if ps_field_str(g, key, key_l, &p, &l) {
            let lo: u64 = 0;
            let hi: u64 = 0;
            ps_trim_range(p, l, &lo, &hi);
            if hi > lo {
                let seg: ptr = PTR_NULL();
                PTR_BYTE_ADD(seg, p, lo);
                let lowered = PsText { bytes: [0; 65536], len: 0 };
                let j: u64 = 0;
                while j < hi - lo {
                    if lowered.len < 65536 {
                        lowered.bytes[lowered.len] = ps_lower(ps_byte(seg, j));
                        lowered.len = lowered.len + 1;
                    };
                    j = j + 1;
                }
                let st: i32 = sa_json_object_set_bool(set, ps_text_ptr(&lowered), lowered.len, true);
            };
        };
        i = i + 1;
    }
    return set;
}

fn mergeProviderGroups(existing_json: u64, incoming_json: u64, now: u64, out_json: &u64) -> void {
    let existing_groups: u64 = ps_jget(existing_json, STR_PTR("groups"), STR_LEN("groups"));
    let used_names: u64 = ps_used_set_from_groups(existing_groups, true);
    let used_ids: u64 = ps_used_set_from_groups(existing_groups, false);
    let incoming_groups: u64 = ps_jget(incoming_json, STR_PTR("groups"), STR_LEN("groups"));
    let mapped: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    if incoming_groups != 0 && sa_json_kind(incoming_groups) == 6 && mapped != 0 {
        let count: u64 = 0;
        let cst: i32 = sa_json_value_count(incoming_groups, &count);
        let i: u64 = 0;
        while i < count {
            let g: u64 = 0;
            let ast: i32 = sa_json_array_get(incoming_groups, i, &g);
            let gc: u64 = ps_clone(g);
            if gc != 0 {
                let name_p: ptr = PTR_NULL();
                let name_l: u64 = 0;
                let has_name: bool = ps_field_str(gc, STR_PTR("name"), STR_LEN("name"), &name_p, &name_l);
                let name_in = PsText { bytes: [0; 65536], len: 0 };
                if has_name { ps_append(&name_in, name_p, name_l); };
                if name_in.len == 0 { ps_append(&name_in, STR_PTR("default"), STR_LEN("default")); };
                let new_name_p: ptr = PTR_NULL();
                let new_name_l: u64 = 0;
                uniqueGroupValue(ps_text_ptr(&name_in), name_in.len, used_names, &new_name_p, &new_name_l);
                let new_name = PsText { bytes: [0; 65536], len: 0 };
                ps_append(&new_name, new_name_p, new_name_l);
                let n1: i32 = sa_json_object_set_string(gc, STR_PTR("name"), STR_LEN("name"), ps_text_ptr(&new_name), new_name.len);
                let id_p: ptr = PTR_NULL();
                let id_l: u64 = 0;
                let has_id: bool = ps_field_str(gc, STR_PTR("id"), STR_LEN("id"), &id_p, &id_l);
                let id_in = PsText { bytes: [0; 65536], len: 0 };
                if has_id { ps_append(&id_in, id_p, id_l); };
                if id_in.len == 0 { ps_append(&id_in, ps_text_ptr(&new_name), new_name.len); };
                let new_id_p: ptr = PTR_NULL();
                let new_id_l: u64 = 0;
                uniqueGroupValue(ps_text_ptr(&id_in), id_in.len, used_ids, &new_id_p, &new_id_l);
                let n2: i32 = sa_json_object_set_string(gc, STR_PTR("id"), STR_LEN("id"), new_id_p, new_id_l);
                // baseUrl: group.baseUrl ?? (incoming.baseUrl when it
                // differs from existing.baseUrl)
                if ps_jget(gc, STR_PTR("baseUrl"), STR_LEN("baseUrl")) == 0 {
                    let inc_base_p: ptr = PTR_NULL();
                    let inc_base_l: u64 = 0;
                    let ex_base_p: ptr = PTR_NULL();
                    let ex_base_l: u64 = 0;
                    let has_inc: bool = ps_field_str(incoming_json, STR_PTR("baseUrl"), STR_LEN("baseUrl"), &inc_base_p, &inc_base_l);
                    let has_ex: bool = ps_field_str(existing_json, STR_PTR("baseUrl"), STR_LEN("baseUrl"), &ex_base_p, &ex_base_l);
                    if has_inc && !(has_ex && ps_eq(inc_base_p, inc_base_l, ex_base_p, ex_base_l)) {
                        let n3: i32 = sa_json_object_set_string(gc, STR_PTR("baseUrl"), STR_LEN("baseUrl"), inc_base_p, inc_base_l);
                    };
                };
                let pst: i32 = sa_json_array_push_node(mapped, gc);
            };
            i = i + 1;
        }
    };
    if used_names != 0 { let f: i32 = sa_json_free(used_names); };
    if used_ids != 0 { let f: i32 = sa_json_free(used_ids); };
    let doc: u64 = ps_clone(existing_json);
    *out_json = doc;
    if doc == 0 { return; };
    // nativeModels: uniqueStrings([...existing, ...incoming])
    let models_src: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    let en: u64 = ps_jget(existing_json, STR_PTR("nativeModels"), STR_LEN("nativeModels"));
    if en != 0 && sa_json_kind(en) == 6 && models_src != 0 {
        let c: u64 = 0;
        let st: i32 = sa_json_value_count(en, &c);
        let i: u64 = 0;
        while i < c {
            let item: u64 = 0;
            let ast: i32 = sa_json_array_get(en, i, &item);
            let pst: i32 = sa_json_array_push_node(models_src, ps_clone(item));
            i = i + 1;
        }
    };
    let in_m: u64 = ps_jget(incoming_json, STR_PTR("nativeModels"), STR_LEN("nativeModels"));
    if in_m != 0 && sa_json_kind(in_m) == 6 && models_src != 0 {
        let c: u64 = 0;
        let st: i32 = sa_json_value_count(in_m, &c);
        let i: u64 = 0;
        while i < c {
            let item: u64 = 0;
            let ast: i32 = sa_json_array_get(in_m, i, &item);
            let pst: i32 = sa_json_array_push_node(models_src, ps_clone(item));
            i = i + 1;
        }
    };
    let models: u64 = 0;
    ps_uniqueStrings(models_src, &models);
    if models_src != 0 { let f: i32 = sa_json_free(models_src); };
    if models != 0 {
        let s1: i32 = sa_json_object_set_node(doc, STR_PTR("nativeModels"), STR_LEN("nativeModels"), models);
    };
    // modelAliases: [...existing, ...incoming.filter(new alias)]
    let aliases: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    let ea: u64 = ps_jget(existing_json, STR_PTR("modelAliases"), STR_LEN("modelAliases"));
    if ea != 0 && sa_json_kind(ea) == 6 && aliases != 0 {
        let c: u64 = 0;
        let st: i32 = sa_json_value_count(ea, &c);
        let i: u64 = 0;
        while i < c {
            let item: u64 = 0;
            let ast: i32 = sa_json_array_get(ea, i, &item);
            let pst: i32 = sa_json_array_push_node(aliases, ps_clone(item));
            i = i + 1;
        }
    };
    let ia: u64 = ps_jget(incoming_json, STR_PTR("modelAliases"), STR_LEN("modelAliases"));
    if ia != 0 && sa_json_kind(ia) == 6 && aliases != 0 {
        let c: u64 = 0;
        let st: i32 = sa_json_value_count(ia, &c);
        let i: u64 = 0;
        while i < c {
            let item: u64 = 0;
            let ast: i32 = sa_json_array_get(ia, i, &item);
            let a_p: ptr = PTR_NULL();
            let a_l: u64 = 0;
            let has_a: bool = ps_field_str(item, STR_PTR("alias"), STR_LEN("alias"), &a_p, &a_l);
            let dup: bool = false;
            if has_a {
                let ec: u64 = 0;
                if ea != 0 && sa_json_kind(ea) == 6 {
                    let est: i32 = sa_json_value_count(ea, &ec);
                };
                let j: u64 = 0;
                while j < ec {
                    let ex: u64 = 0;
                    let gst: i32 = sa_json_array_get(ea, j, &ex);
                    let ep: ptr = PTR_NULL();
                    let el: u64 = 0;
                    if ps_field_str(ex, STR_PTR("alias"), STR_LEN("alias"), &ep, &el) {
                        if ps_eq(ep, el, a_p, a_l) { dup = true; };
                    };
                    j = j + 1;
                }
            };
            if !dup {
                let pst: i32 = sa_json_array_push_node(aliases, ps_clone(item));
            };
            i = i + 1;
        }
    };
    if aliases != 0 {
        let s2: i32 = sa_json_object_set_node(doc, STR_PTR("modelAliases"), STR_LEN("modelAliases"), aliases);
    };
    // groups: [...existing.groups ?? [], ...mapped]
    let all_groups: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    if existing_groups != 0 && sa_json_kind(existing_groups) == 6 && all_groups != 0 {
        let c: u64 = 0;
        let st: i32 = sa_json_value_count(existing_groups, &c);
        let i: u64 = 0;
        while i < c {
            let item: u64 = 0;
            let ast: i32 = sa_json_array_get(existing_groups, i, &item);
            let pst: i32 = sa_json_array_push_node(all_groups, ps_clone(item));
            i = i + 1;
        }
    };
    if mapped != 0 && all_groups != 0 {
        let c: u64 = 0;
        let st: i32 = sa_json_value_count(mapped, &c);
        let i: u64 = 0;
        while i < c {
            let item: u64 = 0;
            let ast: i32 = sa_json_array_get(mapped, i, &item);
            let pst: i32 = sa_json_array_push_node(all_groups, ps_clone(item));
            i = i + 1;
        }
        let f: i32 = sa_json_free(mapped);
    };
    if all_groups != 0 {
        let s3: i32 = sa_json_object_set_node(doc, STR_PTR("groups"), STR_LEN("groups"), all_groups);
    };
    if ps_jget(doc, STR_PTR("defaultModel"), STR_LEN("defaultModel")) == 0 {
        let dm_p: ptr = PTR_NULL();
        let dm_l: u64 = 0;
        if ps_field_sv(incoming_json, STR_PTR("defaultModel"), STR_LEN("defaultModel"), &dm_p, &dm_l) {
            let s4: i32 = sa_json_object_set_string(doc, STR_PTR("defaultModel"), STR_LEN("defaultModel"), dm_p, dm_l);
        };
    };
    let s5: i32 = sa_json_object_set_f64(doc, STR_PTR("updatedAt"), STR_LEN("updatedAt"), now as f64);
}

fn validateRelayGroupKeys(provider_json: u64, providerSecretSupplied: bool) -> i32 {
    let count: u64 = 0;
    let groups: u64 = ps_groups_of(provider_json, &count);
    if groups == 0 || count == 0 {
        return ps_throw(STR_PTR("Every relay provider requires at least one configured group"), STR_LEN("Every relay provider requires at least one configured group"));
    };
    let kind_p: ptr = PTR_NULL();
    let kind_l: u64 = 0;
    if ps_field_str(provider_json, STR_PTR("kind"), STR_LEN("kind"), &kind_p, &kind_l) {
        if ps_eq(kind_p, kind_l, STR_PTR("chatgpt"), STR_LEN("chatgpt")) { return 0; };
    };
    let id_p: ptr = PTR_NULL();
    let id_l: u64 = 0;
    if ps_field_str(provider_json, STR_PTR("id"), STR_LEN("id"), &id_p, &id_l) {
        if ps_eq(id_p, id_l, STR_PTR("omniroute-free"), STR_LEN("omniroute-free")) { return 0; };
    };
    let st_p: ptr = PTR_NULL();
    let st_l: u64 = 0;
    if ps_field_sv(provider_json, STR_PTR("stationType"), STR_LEN("stationType"), &st_p, &st_l) {
        if ps_eq(st_p, st_l, STR_PTR("charity"), STR_LEN("charity")) { return 0; };
    };
    let ref_p: ptr = PTR_NULL();
    let ref_l: u64 = 0;
    let has_ref: bool = ps_field_str(provider_json, STR_PTR("apiKeyRef"), STR_LEN("apiKeyRef"), &ref_p, &ref_l);
    let has_cred: bool = providerSecretSupplied;
    if !has_cred && has_ref {
        let lo: u64 = 0;
        let hi: u64 = 0;
        ps_trim_range(ref_p, ref_l, &lo, &hi);
        has_cred = hi > lo;
    };
    let missing = PsText { bytes: [0; 65536], len: 0 };
    let missing_count: u64 = 0;
    let i: u64 = 0;
    while i < count {
        let g: u64 = 0;
        let ast: i32 = sa_json_array_get(groups, i, &g);
        let auth_p: ptr = PTR_NULL();
        let auth_l: u64 = 0;
        let has_auth: bool = ps_field_sv(g, STR_PTR("authType"), STR_LEN("authType"), &auth_p, &auth_l);
        if has_auth && ps_eq(auth_p, auth_l, STR_PTR("none"), STR_LEN("none")) {
            i = i + 1;
            continue;
        };
        let gid_p: ptr = PTR_NULL();
        let gid_l: u64 = 0;
        let has_gid: bool = ps_field_str(g, STR_PTR("id"), STR_LEN("id"), &gid_p, &gid_l);
        if has_gid {
            if ps_eq(gid_p, gid_l, STR_PTR("cline-free"), STR_LEN("cline-free")) || ps_eq(gid_p, gid_l, STR_PTR("freebuff"), STR_LEN("freebuff")) {
                i = i + 1;
                continue;
            };
        };
        let keys: u64 = ps_jget(g, STR_PTR("keys"), STR_LEN("keys"));
        let has_key: bool = false;
        if keys != 0 && sa_json_kind(keys) == 6 {
            let kc: u64 = 0;
            let kst: i32 = sa_json_value_count(keys, &kc);
            let j: u64 = 0;
            while j < kc {
                let item: u64 = 0;
                let gst: i32 = sa_json_array_get(keys, j, &item);
                let kp: ptr = PTR_NULL();
                let kl: u64 = 0;
                if ps_jstr(item, &kp, &kl) {
                    let lo: u64 = 0;
                    let hi: u64 = 0;
                    ps_trim_range(kp, kl, &lo, &hi);
                    if hi > lo { has_key = true; };
                };
                j = j + 1;
            }
        };
        if has_key {
            i = i + 1;
            continue;
        };
        let cm_p: ptr = PTR_NULL();
        let cm_l: u64 = 0;
        let has_cm: bool = ps_field_sv(g, STR_PTR("credentialMode"), STR_LEN("credentialMode"), &cm_p, &cm_l);
        if has_cm && ps_eq(cm_p, cm_l, STR_PTR("provider"), STR_LEN("provider")) && has_cred {
            i = i + 1;
            continue;
        };
        let nm_p: ptr = PTR_NULL();
        let nm_l: u64 = 0;
        if ps_field_str(g, STR_PTR("name"), STR_LEN("name"), &nm_p, &nm_l) {
            if missing_count > 0 {
                ps_append(&missing, STR_PTR(", "), STR_LEN(", "));
            };
            ps_append(&missing, nm_p, nm_l);
            missing_count = missing_count + 1;
        };
        i = i + 1;
    }
    if missing_count > 0 {
        let msg = PsText { bytes: [0; 65536], len: 0 };
        ps_append(&msg, STR_PTR("Every configured relay group requires at least one API key: "), STR_LEN("Every configured relay group requires at least one API key: "));
        ps_append(&msg, ps_text_ptr(&missing), missing.len);
        return ps_throw(ps_text_ptr(&msg), msg.len);
    };
    return 0;
}

fn profileProvider(provider_json: u64, out_json: &u64) -> void {
    let doc: u64 = ps_clone(provider_json);
    *out_json = doc;
    if doc == 0 { return; };
    let r: i32 = sa_json_object_remove(doc, STR_PTR("apiKeyPreview"), STR_LEN("apiKeyPreview"));
    let s: i32 = sa_json_object_set_string(doc, STR_PTR("apiKeyStorage"), STR_LEN("apiKeyStorage"), STR_PTR("none"), STR_LEN("none"));
    let groups: u64 = ps_jget(doc, STR_PTR("groups"), STR_LEN("groups"));
    if groups != 0 && sa_json_kind(groups) == 6 {
        let mapped: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
        let count: u64 = 0;
        let cst: i32 = sa_json_value_count(groups, &count);
        let i: u64 = 0;
        while i < count {
            let g: u64 = 0;
            let ast: i32 = sa_json_array_get(groups, i, &g);
            let gc: u64 = ps_clone(g);
            if gc != 0 {
                let empty: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
                let ks: i32 = sa_json_object_set_node(gc, STR_PTR("keys"), STR_LEN("keys"), empty);
                let pst: i32 = sa_json_array_push_node(mapped, gc);
            };
            i = i + 1;
        }
        let s2: i32 = sa_json_object_set_node(doc, STR_PTR("groups"), STR_LEN("groups"), mapped);
    };
}

fn normalizeProfileProvider(value_json: u64, existing_json: u64, has_existing: bool, out_json: &u64) -> i32 {
    *out_json = 0;
    let record: u64 = 0;
    ps_asRecord(value_json, &record);
    let now: f64 = ps_now_ms() as f64;
    let name_p: ptr = PTR_NULL();
    let name_l: u64 = 0;
    let has_name: bool = ps_field_sv(record, STR_PTR("name"), STR_LEN("name"), &name_p, &name_l);
    let name = PsText { bytes: [0; 65536], len: 0 };
    if has_name {
        ps_append(&name, name_p, name_l);
    } else {
        ps_append(&name, STR_PTR("Imported provider"), STR_LEN("Imported provider"));
    };
    let id_p: ptr = PTR_NULL();
    let id_l: u64 = 0;
    let has_id: bool = ps_field_sv(record, STR_PTR("id"), STR_LEN("id"), &id_p, &id_l);
    let id = PsText { bytes: [0; 65536], len: 0 };
    if has_id {
        ps_append(&id, id_p, id_l);
    } else {
        let slug_p: ptr = PTR_NULL();
        let slug_l: u64 = 0;
        providerIdFromName(ps_text_ptr(&name), name.len, &slug_p, &slug_l);
        ps_append(&id, slug_p, slug_l);
    };
    // merged record: {...record, id, kind, name, apiKeyRef, ...}
    let merged: u64 = ps_clone(record);
    if merged == 0 { return ps_throw(STR_PTR("Invalid provider profile"), STR_LEN("Invalid provider profile")); };
    let m1: i32 = sa_json_object_set_string(merged, STR_PTR("id"), STR_LEN("id"), ps_text_ptr(&id), id.len);
    let kind_p: ptr = PTR_NULL();
    let kind_l: u64 = 0;
    providerKindValue(ps_jget(record, STR_PTR("kind"), STR_LEN("kind")), &kind_p, &kind_l);
    let kind = PsText { bytes: [0; 65536], len: 0 };
    ps_append(&kind, kind_p, kind_l);
    let m2: i32 = sa_json_object_set_string(merged, STR_PTR("kind"), STR_LEN("kind"), ps_text_ptr(&kind), kind.len);
    let m3: i32 = sa_json_object_set_string(merged, STR_PTR("name"), STR_LEN("name"), ps_text_ptr(&name), name.len);
    let ref_p: ptr = PTR_NULL();
    let ref_l: u64 = 0;
    let has_ref: bool = envKeyRefValue(ps_jget(record, STR_PTR("apiKeyRef"), STR_LEN("apiKeyRef")), &ref_p, &ref_l);
    let ref = PsText { bytes: [0; 65536], len: 0 };
    if has_ref {
        ps_append(&ref, ref_p, ref_l);
    } else {
        if has_existing {
            let ep: ptr = PTR_NULL();
            let el: u64 = 0;
            if ps_field_str(existing_json, STR_PTR("apiKeyRef"), STR_LEN("apiKeyRef"), &ep, &el) {
                ps_append(&ref, ep, el);
                has_ref = el > 0;
            };
        };
    };
    if has_ref && ref.len > 0 {
        let m4: i32 = sa_json_object_set_string(merged, STR_PTR("apiKeyRef"), STR_LEN("apiKeyRef"), ps_text_ptr(&ref), ref.len);
    } else {
        let m4: i32 = sa_json_object_remove(merged, STR_PTR("apiKeyRef"), STR_LEN("apiKeyRef"));
    };
    let preserve: bool = false;
    if has_existing && has_ref && ref.len > 0 {
        let ep: ptr = PTR_NULL();
        let el: u64 = 0;
        if ps_field_str(existing_json, STR_PTR("apiKeyRef"), STR_LEN("apiKeyRef"), &ep, &el) {
            preserve = ps_eq(ep, el, ps_text_ptr(&ref), ref.len);
        };
    };
    if preserve {
        let pv_p: ptr = PTR_NULL();
        let pv_l: u64 = 0;
        if ps_field_str(existing_json, STR_PTR("apiKeyPreview"), STR_LEN("apiKeyPreview"), &pv_p, &pv_l) {
            let m5: i32 = sa_json_object_set_string(merged, STR_PTR("apiKeyPreview"), STR_LEN("apiKeyPreview"), pv_p, pv_l);
        } else {
            let m5: i32 = sa_json_object_remove(merged, STR_PTR("apiKeyPreview"), STR_LEN("apiKeyPreview"));
        };
        let es_p: ptr = PTR_NULL();
        let es_l: u64 = 0;
        if ps_field_str(existing_json, STR_PTR("apiKeyStorage"), STR_LEN("apiKeyStorage"), &es_p, &es_l) {
            let m6: i32 = sa_json_object_set_string(merged, STR_PTR("apiKeyStorage"), STR_LEN("apiKeyStorage"), es_p, es_l);
        } else {
            let m6: i32 = sa_json_object_remove(merged, STR_PTR("apiKeyStorage"), STR_LEN("apiKeyStorage"));
        };
    } else {
        let m5: i32 = sa_json_object_remove(merged, STR_PTR("apiKeyPreview"), STR_LEN("apiKeyPreview"));
        let m6: i32 = sa_json_object_set_string(merged, STR_PTR("apiKeyStorage"), STR_LEN("apiKeyStorage"), STR_PTR("none"), STR_LEN("none"));
    };
    let rem_p: ptr = PTR_NULL();
    let rem_l: u64 = 0;
    if ps_field_sv(record, STR_PTR("remark"), STR_LEN("remark"), &rem_p, &rem_l) {
        let m7: i32 = sa_json_object_set_string(merged, STR_PTR("remark"), STR_LEN("remark"), rem_p, rem_l);
    } else {
        if has_existing {
            let ep: ptr = PTR_NULL();
            let el: u64 = 0;
            if ps_field_str(existing_json, STR_PTR("remark"), STR_LEN("remark"), &ep, &el) {
                let m7: i32 = sa_json_object_set_string(merged, STR_PTR("remark"), STR_LEN("remark"), ep, el);
            } else {
                let m7: i32 = sa_json_object_remove(merged, STR_PTR("remark"), STR_LEN("remark"));
            };
        } else {
            let m7: i32 = sa_json_object_remove(merged, STR_PTR("remark"), STR_LEN("remark"));
        };
    };
    let ca: f64 = 0.0;
    let has_ca: bool = ps_field_number(record, STR_PTR("createdAt"), STR_LEN("createdAt"), &ca);
    if !has_ca && has_existing {
        has_ca = ps_field_number(existing_json, STR_PTR("createdAt"), STR_LEN("createdAt"), &ca);
    };
    if has_ca {
        let m8: i32 = sa_json_object_set_f64(merged, STR_PTR("createdAt"), STR_LEN("createdAt"), ca);
    } else {
        let m8: i32 = sa_json_object_set_f64(merged, STR_PTR("createdAt"), STR_LEN("createdAt"), now);
    };
    let m9: i32 = sa_json_object_set_f64(merged, STR_PTR("updatedAt"), STR_LEN("updatedAt"), now);
    let ok: bool = normalizeProvider(merged, out_json);
    let f: i32 = sa_json_free(merged);
    if !ok {
        return ps_throw(STR_PTR("Invalid provider profile"), STR_LEN("Invalid provider profile"));
    };
    return 0;
}

fn providerIdFromName(name_ptr: ptr, name_len: u64, out_ptr: &ptr, out_len: &u64) -> void {
    let lo: u64 = 0;
    let hi: u64 = 0;
    ps_trim_range(name_ptr, name_len, &lo, &hi);
    let slug = PsText { bytes: [0; 65536], len: 0 };
    let pending_dash: bool = false;
    let i: u64 = lo;
    while i < hi {
        let c: u8 = ps_lower(ps_byte(name_ptr, i));
        let alnum: bool = (c >= 97 && c <= 122) || (c >= 48 && c <= 57);
        if alnum {
            if pending_dash && slug.len > 0 {
                ps_append(&slug, STR_PTR("-"), STR_LEN("-"));
            };
            pending_dash = false;
            let one: [u8; 1] = [c];
            let op: ptr = PTR_NULL();
            PTR_BYTE_ADD(op, &one, 0);
            ps_append(&slug, op, 1);
        } else {
            pending_dash = true;
        };
        i = i + 1;
    }
    if slug.len > 40 {
        slug.len = 40;
        // strip a trailing dash left by the cut
        while slug.len > 0 && slug.bytes[slug.len - 1] == 45 { slug.len = slug.len - 1; }
    };
    if slug.len == 0 {
        let uuid = PsText { bytes: [0; 65536], len: 0 };
        ps_random_uuid(&uuid);
        ps_doc_str(STR_PTR("slug"), STR_LEN("slug"), ps_text_ptr(&uuid), uuid.len, out_ptr, out_len);
        return;
    };
    ps_doc_str(STR_PTR("slug"), STR_LEN("slug"), ps_text_ptr(&slug), slug.len, out_ptr, out_len);
}

fn envKeyForProvider(id_ptr: ptr, id_len: u64, out_ptr: &ptr, out_len: &u64) -> void {
    let out = PsText { bytes: [0; 65536], len: 0 };
    ps_append(&out, STR_PTR("CODEX_UI_PROVIDER_"), STR_LEN("CODEX_UI_PROVIDER_"));
    let i: u64 = 0;
    while i < id_len {
        let c: u8 = ps_byte(id_ptr, i);
        let up: u8 = c;
        if c >= 97 && c <= 122 { up = c - 32; };
        let alnum: bool = (up >= 65 && up <= 90) || (c >= 48 && c <= 57);
        let one: [u8; 1] = [95];
        if alnum { one[0] = up; };
        let op: ptr = PTR_NULL();
        PTR_BYTE_ADD(op, &one, 0);
        ps_append(&out, op, 1);
        i = i + 1;
    }
    ps_append(&out, STR_PTR("_API_KEY"), STR_LEN("_API_KEY"));
    ps_doc_str(STR_PTR("envkey"), STR_LEN("envkey"), ps_text_ptr(&out), out.len, out_ptr, out_len);
}

fn previewSecret(secret_ptr: ptr, secret_len: u64, out_ptr: &ptr, out_len: &u64) -> void {
    if secret_len <= 8 {
        ps_doc_str(STR_PTR("preview"), STR_LEN("preview"), STR_PTR("********"), STR_LEN("********"), out_ptr, out_len);
        return;
    };
    let out = PsText { bytes: [0; 65536], len: 0 };
    ps_append(&out, secret_ptr, 4);
    ps_append(&out, STR_PTR("..."), STR_LEN("..."));
    let tail: ptr = PTR_NULL();
    PTR_BYTE_ADD(tail, secret_ptr, secret_len - 4);
    ps_append(&out, tail, 4);
    ps_doc_str(STR_PTR("preview"), STR_LEN("preview"), ps_text_ptr(&out), out.len, out_ptr, out_len);
}

// keyringEntry: the sa_std keyring surface exists (correcting the
// skeleton's stale claim); landing = availability flag + a
// descriptor doc {"key": "provider:<id>"}. The get/remove calls
// use that key text; sa_keyring_get has no collection parameter,
// so the "codex-react-ui" collection is implicit (registered).
fn keyringEntry(id_ptr: ptr, id_len: u64, out_handle: &u64) -> bool {
    *out_handle = 0;
    if sa_keyring_available() == 0 { return false; };
    let doc: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    if doc == 0 { return false; };
    let key = PsText { bytes: [0; 65536], len: 0 };
    ps_append(&key, STR_PTR("provider:"), STR_LEN("provider:"));
    ps_append(&key, id_ptr, id_len);
    let st: i32 = sa_json_object_set_string(doc, STR_PTR("key"), STR_LEN("key"), ps_text_ptr(&key), key.len);
    *out_handle = doc;
    return true;
}

fn ps_keyring_get(id_p: ptr, id_l: u64, out: &PsText) -> i32 {
    let key = PsText { bytes: [0; 65536], len: 0 };
    ps_append(&key, STR_PTR("provider:"), STR_LEN("provider:"));
    ps_append(&key, id_p, id_l);
    let buf: [u8; 8192] = [0; 8192];
    let bp: ptr = PTR_NULL();
    PTR_BYTE_ADD(bp, &buf, 0);
    let got: u64 = 0;
    let st: i32 = sa_keyring_get(ps_text_ptr(&key), key.len, bp, 8192, &got);
    if st == 0 {
        ps_append(out, bp, got);
    };
    return st;
}

fn ps_keyring_remove(id_p: ptr, id_l: u64) -> void {
    let key = PsText { bytes: [0; 65536], len: 0 };
    ps_append(&key, STR_PTR("provider:"), STR_LEN("provider:"));
    ps_append(&key, id_p, id_l);
    let st: i32 = sa_keyring_remove(ps_text_ptr(&key), key.len);
}

