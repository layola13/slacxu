            let price: f64 = 0.0;
            let ok_p: bool = ps_field_number(item, STR_PTR("usdPerImage"), STR_LEN("usdPerImage"), &price);
            if ok_m && ok_p && price >= 0.0 {
                let entry: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
                if entry != 0 {
                    let e1: i32 = sa_json_object_set_string(entry, STR_PTR("model"), STR_LEN("model"), ps_text_ptr(&model), model.len);
                    let e2: i32 = sa_json_object_set_f64(entry, STR_PTR("usdPerImage"), STR_LEN("usdPerImage"), price);
                    let pst: i32 = sa_json_array_push_node(out, entry);
                };
            };
        };
        i = i + 1;
    }
}

fn imageBillingValue(value_json: u64, out_json: &u64) -> bool {
    *out_json = 0;
    let rec: u64 = 0;
    ps_asRecord(value_json, &rec);
    if rec == 0 || value_json == 0 || sa_json_kind(value_json) != 7 { return false; };
    let mode_p: ptr = PTR_NULL();
    let mode_l: u64 = 0;
    if !ps_field_sv(rec, STR_PTR("mode"), STR_LEN("mode"), &mode_p, &mode_l) { return false; };
    let mode = PsText { bytes: [0; 65536], len: 0 };
    ps_append(&mode, mode_p, mode_l);
    if ps_eq(ps_text_ptr(&mode), mode.len, STR_PTR("per_image"), STR_LEN("per_image")) {
        let usd: f64 = 0.0;
        if !ps_field_number(rec, STR_PTR("usdPerImage"), STR_LEN("usdPerImage"), &usd) { return false; };
        if usd < 0.0 { return false; };
        let out: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
        if out == 0 { return false; };
        let e1: i32 = sa_json_object_set_string(out, STR_PTR("mode"), STR_LEN("mode"), STR_PTR("per_image"), STR_LEN("per_image"));
        let e2: i32 = sa_json_object_set_f64(out, STR_PTR("usdPerImage"), STR_LEN("usdPerImage"), usd);
        let e3: i32 = sa_json_object_set_string(out, STR_PTR("currency"), STR_LEN("currency"), STR_PTR("USD"), STR_LEN("USD"));
        *out_json = out;
        return true;
    };
    if ps_eq(ps_text_ptr(&mode), mode.len, STR_PTR("token_multiplier"), STR_LEN("token_multiplier")) {
        let mult: f64 = 0.0;
        if !ps_field_number(rec, STR_PTR("multiplier"), STR_LEN("multiplier"), &mult) { return false; };
        if !(mult > 0.0) { return false; };
        let out: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
        if out == 0 { return false; };
        let e1: i32 = sa_json_object_set_string(out, STR_PTR("mode"), STR_LEN("mode"), STR_PTR("token_multiplier"), STR_LEN("token_multiplier"));
        let e2: i32 = sa_json_object_set_f64(out, STR_PTR("multiplier"), STR_LEN("multiplier"), mult);
        let e3: i32 = sa_json_object_set_string(out, STR_PTR("currency"), STR_LEN("currency"), STR_PTR("USD"), STR_LEN("USD"));
        *out_json = out;
        return true;
    };
    return false;
}

fn imageAvailabilityValue(value_json: u64, out_ptr: &ptr, out_len: &u64) -> bool {
    let p: ptr = PTR_NULL();
    let l: u64 = 0;
    if !ps_stringValue(value_json, &p, &l) { return false; };
    let ok: bool = ps_eq(p, l, STR_PTR("available"), STR_LEN("available"));
    if ps_eq(p, l, STR_PTR("constrained"), STR_LEN("constrained")) { ok = true; };
    if ps_eq(p, l, STR_PTR("unavailable"), STR_LEN("unavailable")) { ok = true; };
    if !ok { return false; };
    ps_doc_str(STR_PTR("enum"), STR_LEN("enum"), p, l, out_ptr, out_len);
    return true;
}

fn imageProviderConfig(value_json: u64, out_json: &u64) -> bool {
    *out_json = 0;
    let rec: u64 = 0;
    ps_asRecord(value_json, &rec);
    if rec == 0 || value_json == 0 || sa_json_kind(value_json) != 7 { return false; };
    let gen: bool = false;
    let has_gen: bool = ps_field_bool(rec, STR_PTR("generations"), STR_LEN("generations"), &gen);
    let edits: bool = false;
    let has_edits: bool = ps_field_bool(rec, STR_PTR("edits"), STR_LEN("edits"), &edits);
    let dm_p: ptr = PTR_NULL();
    let dm_l: u64 = 0;
    let has_dm: bool = ps_field_sv(rec, STR_PTR("defaultModel"), STR_LEN("defaultModel"), &dm_p, &dm_l);
    let dm = PsText { bytes: [0; 65536], len: 0 };
    if has_dm { ps_append(&dm, dm_p, dm_l); };
    let protocols: u64 = 0;
    imageProtocolArray(ps_jget(rec, STR_PTR("protocols"), STR_LEN("protocols")), &protocols);
    let proto_count: u64 = 0;
    if protocols != 0 {
        let cst: i32 = sa_json_value_count(protocols, &proto_count);
    };
    let dp_p: ptr = PTR_NULL();
    let dp_l: u64 = 0;
    let has_dp: bool = imageProtocolValue(ps_jget(rec, STR_PTR("defaultProtocol"), STR_LEN("defaultProtocol")), &dp_p, &dp_l);
    let dp = PsText { bytes: [0; 65536], len: 0 };
    if has_dp { ps_append(&dp, dp_p, dp_l); };
    let prices: u64 = 0;
    imageModelPriceArray(ps_jget(rec, STR_PTR("modelPrices"), STR_LEN("modelPrices")), &prices);
    let price_count: u64 = 0;
    if prices != 0 {
        let cst: i32 = sa_json_value_count(prices, &price_count);
    };
    let billing: u64 = 0;
    let has_billing: bool = imageBillingValue(ps_jget(rec, STR_PTR("billing"), STR_LEN("billing")), &billing);
    let av_p: ptr = PTR_NULL();
    let av_l: u64 = 0;
    let has_av: bool = imageAvailabilityValue(ps_jget(rec, STR_PTR("availability"), STR_LEN("availability")), &av_p, &av_l);
    let av = PsText { bytes: [0; 65536], len: 0 };
    if has_av { ps_append(&av, av_p, av_l); };
    let notice_p: ptr = PTR_NULL();
    let notice_l: u64 = 0;
    let has_notice: bool = ps_field_sv(rec, STR_PTR("notice"), STR_LEN("notice"), &notice_p, &notice_l);
    let notice = PsText { bytes: [0; 65536], len: 0 };
    if has_notice { ps_append(&notice, notice_p, notice_l); };
    if !has_gen && !has_edits && !has_dm && proto_count == 0 && !has_dp && price_count == 0 && !has_billing && !has_av && !has_notice {
        if protocols != 0 { let f: i32 = sa_json_free(protocols); };
        if prices != 0 { let f: i32 = sa_json_free(prices); };
        if billing != 0 { let f: i32 = sa_json_free(billing); };
        return false;
    };
    let out: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    if out == 0 { return false; };
    if has_gen {
        let e: i32 = sa_json_object_set_bool(out, STR_PTR("generations"), STR_LEN("generations"), gen);
    };
    if has_edits {
        let e: i32 = sa_json_object_set_bool(out, STR_PTR("edits"), STR_LEN("edits"), edits);
    };
    if has_dm {
        let e: i32 = sa_json_object_set_string(out, STR_PTR("defaultModel"), STR_LEN("defaultModel"), ps_text_ptr(&dm), dm.len);
    };
    if proto_count > 0 {
        let e: i32 = sa_json_object_set_node(out, STR_PTR("protocols"), STR_LEN("protocols"), protocols);
    } else {
        if protocols != 0 { let f: i32 = sa_json_free(protocols); };
    };
    if has_dp {
        if ps_image_dp_included(rec, ps_text_ptr(&dp), dp.len) {
            let e: i32 = sa_json_object_set_string(out, STR_PTR("defaultProtocol"), STR_LEN("defaultProtocol"), ps_text_ptr(&dp), dp.len);
        };
    };
    if price_count > 0 {
        let e: i32 = sa_json_object_set_node(out, STR_PTR("modelPrices"), STR_LEN("modelPrices"), prices);
    } else {
        if prices != 0 { let f: i32 = sa_json_free(prices); };
    };
    if has_billing {
        let e: i32 = sa_json_object_set_node(out, STR_PTR("billing"), STR_LEN("billing"), billing);
    };
    if has_av {
        let e: i32 = sa_json_object_set_string(out, STR_PTR("availability"), STR_LEN("availability"), ps_text_ptr(&av), av.len);
    };
    if has_notice {
        let e: i32 = sa_json_object_set_string(out, STR_PTR("notice"), STR_LEN("notice"), ps_text_ptr(&notice), notice.len);
    };
    *out_json = out;
    return true;
}

// defaultProtocol membership against the RAW protocols array
fn ps_image_dp_included(rec: u64, dp_p: ptr, dp_l: u64) -> bool {
    let raw: u64 = 0;
    imageProtocolArray(ps_jget(rec, STR_PTR("protocols"), STR_LEN("protocols")), &raw);
    if raw == 0 { return true; };
    let count: u64 = 0;
    let cst: i32 = sa_json_value_count(raw, &count);
    if count == 0 {
        let f: i32 = sa_json_free(raw);
        return true;
    };
    let found: bool = false;
    let i: u64 = 0;
    while i < count {
        let item: u64 = 0;
        let ast: i32 = sa_json_array_get(raw, i, &item);
        let p: ptr = PTR_NULL();
        let l: u64 = 0;
        if ps_jstr(item, &p, &l) && ps_eq(p, l, dp_p, dp_l) { found = true; };
        i = i + 1;
    }
    let f: i32 = sa_json_free(raw);
    return found;
}

// ---- model capabilities ----
fn modelCapabilitiesFromValue(value_json: u64, out_json: &u64) -> bool {
    *out_json = 0;
    if value_json == 0 || sa_json_kind(value_json) != 7 { return false; };
    let out: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    if out == 0 { return false; };
    let count: u64 = 0;
    let cst: i32 = sa_json_value_count(value_json, &count);
    let kept: u64 = 0;
    let i: u64 = 0;
    while i < count {
        let kp: ptr = PTR_NULL();
        let kl: u64 = 0;
        let kst: i32 = sa_json_object_key_at(value_json, i, &kp, &kl);
        if kst == 0 {
            let raw: u64 = ps_jget(value_json, kp, kl);
            if raw != 0 && sa_json_kind(raw) == 7 {
                let efforts: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
                let eff_node: u64 = ps_jget(raw, STR_PTR("reasoningEfforts"), STR_LEN("reasoningEfforts"));
                if eff_node != 0 && sa_json_kind(eff_node) == 6 {
                    let ec: u64 = 0;
                    let est: i32 = sa_json_value_count(eff_node, &ec);
                    let j: u64 = 0;
                    while j < ec {
                        let item: u64 = 0;
                        let ast: i32 = sa_json_array_get(eff_node, j, &item);
                        let sp: ptr = PTR_NULL();
                        let sl: u64 = 0;
                        if ps_jstr(item, &sp, &sl) {
                            let lo: u64 = 0;
                            let hi: u64 = 0;
                            ps_trim_range(sp, sl, &lo, &hi);
                            if hi > lo {
                                // TS pushes the RAW (untrimmed) string
                                let pst: i32 = sa_json_array_push_string(efforts, sp, sl);
                            };
                        };
                        j = j + 1;
                    }
                };
                let eff_count: u64 = 0;
                let est2: i32 = sa_json_value_count(efforts, &eff_count);
                let cw: f64 = 0.0;
                let has_cw: bool = false;
                let cv: f64 = 0.0;
                if ps_field_number(raw, STR_PTR("contextWindow"), STR_LEN("contextWindow"), &cv) && ps_is_finite(cv) && cv > 0.0 {
                    cw = ps_round(cv);
                    has_cw = true;
                };
                let mo: f64 = 0.0;
                let has_mo: bool = false;
                if ps_field_number(raw, STR_PTR("maxOutputTokens"), STR_LEN("maxOutputTokens"), &cv) && ps_is_finite(cv) && cv > 0.0 {
                    mo = ps_round(cv);
                    has_mo = true;
                };
                if eff_count > 0 || has_cw || has_mo {
                    let entry: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
                    if entry != 0 {
                        if eff_count > 0 {
                            let e1: i32 = sa_json_object_set_node(entry, STR_PTR("reasoningEfforts"), STR_LEN("reasoningEfforts"), efforts);
                        } else {
                            let f: i32 = sa_json_free(efforts);
                        };
                        if has_cw {
                            let e2: i32 = sa_json_object_set_f64(entry, STR_PTR("contextWindow"), STR_LEN("contextWindow"), cw);
                        };
                        if has_mo {
                            let e3: i32 = sa_json_object_set_f64(entry, STR_PTR("maxOutputTokens"), STR_LEN("maxOutputTokens"), mo);
                        };
                        let src_p: ptr = PTR_NULL();
                        let src_l: u64 = 0;
                        let src: ptr = STR_PTR("upstream");
                        let src_len: u64 = STR_LEN("upstream");
                        if ps_field_sv(raw, STR_PTR("source"), STR_LEN("source"), &src_p, &src_l) {
                            if ps_eq(src_p, src_l, STR_PTR("catalog"), STR_LEN("catalog")) { src = STR_PTR("catalog"); src_len = STR_LEN("catalog"); };
                            if ps_eq(src_p, src_l, STR_PTR("inferred"), STR_LEN("inferred")) { src = STR_PTR("inferred"); src_len = STR_LEN("inferred"); };
                        };
                        let e4: i32 = sa_json_object_set_string(entry, STR_PTR("source"), STR_LEN("source"), src, src_len);
                        let sst: i32 = sa_json_object_set_node(out, kp, kl, entry);
                        kept = kept + 1;
                    };
                } else {
                    let f: i32 = sa_json_free(efforts);
                };
            };
        };
        i = i + 1;
    }
    if kept == 0 {
        let f: i32 = sa_json_free(out);
        return false;
    };
    *out_json = out;
    return true;
}

fn modelCapabilitiesFromJson(value_ptr: ptr, value_len: u64, out_json: &u64) -> bool {
    let doc: u64 = sa_json_parse(value_ptr, value_len);
    if doc == 0 { *out_json = 0; return false; };
    let ok: bool = modelCapabilitiesFromValue(doc, out_json);
    let f: i32 = sa_json_free(doc);
    return ok;
}

// kind: 0 = text/other, 1 = image
fn groupCapabilities(value_json: u64, kind: u64, image_json: u64, out_json: &u64) -> void {
    let rec: u64 = 0;
    ps_asRecord(value_json, &rec);
    let out: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    *out_json = out;
    if out == 0 { return; };
    let is_image: bool = kind == 1;
    let b: bool = false;
    if ps_field_bool(rec, STR_PTR("text"), STR_LEN("text"), &b) {
        let e: i32 = sa_json_object_set_bool(out, STR_PTR("text"), STR_LEN("text"), b);
    } else {
        let e: i32 = sa_json_object_set_bool(out, STR_PTR("text"), STR_LEN("text"), !is_image);
    };
    let gen_img: bool = false;
    let has_gen_img: bool = false;
    if image_json != 0 {
        has_gen_img = ps_field_bool(image_json, STR_PTR("generations"), STR_LEN("generations"), &gen_img);
    };
    if ps_field_bool(rec, STR_PTR("imageGeneration"), STR_LEN("imageGeneration"), &b) {
        let e: i32 = sa_json_object_set_bool(out, STR_PTR("imageGeneration"), STR_LEN("imageGeneration"), b);
    } else {
        if has_gen_img {
            let e: i32 = sa_json_object_set_bool(out, STR_PTR("imageGeneration"), STR_LEN("imageGeneration"), gen_img);
        } else {
            if is_image {
                let e: i32 = sa_json_object_set_bool(out, STR_PTR("imageGeneration"), STR_LEN("imageGeneration"), true);
            };
        };
    };
    let ed_img: bool = false;
    let has_ed_img: bool = false;
    if image_json != 0 {
        has_ed_img = ps_field_bool(image_json, STR_PTR("edits"), STR_LEN("edits"), &ed_img);
    };
    if ps_field_bool(rec, STR_PTR("imageEdits"), STR_LEN("imageEdits"), &b) {
        let e: i32 = sa_json_object_set_bool(out, STR_PTR("imageEdits"), STR_LEN("imageEdits"), b);
    } else {
        if has_ed_img {
            let e: i32 = sa_json_object_set_bool(out, STR_PTR("imageEdits"), STR_LEN("imageEdits"), ed_img);
        } else {
            if is_image {
                let e: i32 = sa_json_object_set_bool(out, STR_PTR("imageEdits"), STR_LEN("imageEdits"), true);
            };
        };
    };
    if rec != 0 && rec != value_json {
        let f: i32 = sa_json_free(rec);
    };
}

// capabilityCatalogValue: relayCatalog's parse is still a stub in
// its own unit (returns 2) — every input lands undefined until
// that unit is implemented (registered).
fn capabilityCatalogValue(value_json: u64, out_json: &u64) -> bool {
    *out_json = 0;
    if value_json == 0 || sa_json_kind(value_json) != 7 { return false; };
    let text = PsText { bytes: [0; 65536], len: 0 };
    if !ps_stringify(value_json, &text) { return false; };
    let jb = JsonBuf { bytes: [0; 2097152], len: 0 };
    let now: u64 = ps_now_ms() as u64;
    let code: i32 = parseRelayCapabilityCatalog(ps_text_ptr(&text), text.len, now, &jb);
    if code != 0 || jb.len == 0 { return false; };
    let bp: ptr = PTR_NULL();
    PTR_BYTE_ADD(bp, &jb.bytes, 0);
    let doc: u64 = sa_json_parse(bp, jb.len);
    if doc == 0 { return false; };
    *out_json = doc;
    return true;
}

fn sharedImportValue(value_json: u64, out_json: &u64) -> bool {
    *out_json = 0;
    let rec: u64 = 0;
    ps_asRecord(value_json, &rec);
    if rec == 0 || value_json == 0 || sa_json_kind(value_json) != 7 { return false; };
    let src_p: ptr = PTR_NULL();
    let src_l: u64 = 0;
    if !ps_field_sv(rec, STR_PTR("source"), STR_LEN("source"), &src_p, &src_l) { return false; };
    if !ps_eq(src_p, src_l, STR_PTR("codex-ultra-share"), STR_LEN("codex-ultra-share")) { return false; };
    let imported: f64 = 0.0;
    if !ps_field_number(rec, STR_PTR("importedAt"), STR_LEN("importedAt"), &imported) {
        imported = ps_now_ms() as f64;
    };
    let out: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    if out == 0 { return false; };
    let e1: i32 = sa_json_object_set_string(out, STR_PTR("source"), STR_LEN("source"), STR_PTR("codex-ultra-share"), STR_LEN("codex-ultra-share"));
    let e2: i32 = sa_json_object_set_f64(out, STR_PTR("importedAt"), STR_LEN("importedAt"), imported);
    *out_json = out;
    return true;
}

// ---- text -> string-node bridge (for row-text enum validators) ----
fn ps_str_node(p: ptr, l: u64, out_node: &u64) -> u64 {
    let holder: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    *out_node = 0;
    if holder == 0 { return 0; };
    let st: i32 = sa_json_object_set_string(holder, STR_PTR("v"), STR_LEN("v"), p, l);
    *out_node = ps_jget(holder, STR_PTR("v"), STR_LEN("v"));
    return holder;
}

// stringValue over raw text (trimmed); writes via scratch "sv"
fn ps_sv_text(p: ptr, l: u64, out_p: &ptr, out_l: &u64) -> bool {
    let lo: u64 = 0;
    let hi: u64 = 0;
    ps_trim_range(p, l, &lo, &hi);
    *out_p = PTR_NULL();
    *out_l = 0;
    if hi <= lo { return false; };
    let seg: ptr = PTR_NULL();
    PTR_BYTE_ADD(seg, p, lo);
    ps_doc_str(STR_PTR("sv"), STR_LEN("sv"), seg, hi - lo, out_p, out_l);
    return true;
}

// optional-field setters (omit when the value fn finds nothing)
fn ps_set_sv(doc: u64, key_p: ptr, key_l: u64, node: u64) -> bool {
    let p: ptr = PTR_NULL();
    let l: u64 = 0;
    if !ps_stringValue(node, &p, &l) { return false; };
    let st: i32 = sa_json_object_set_string(doc, key_p, key_l, p, l);
    return true;
}

fn ps_set_num(doc: u64, key_p: ptr, key_l: u64, node: u64) -> bool {
    let v: f64 = 0.0;
    if !numberValue(node, &v) { return false; };
    let st: i32 = sa_json_object_set_f64(doc, key_p, key_l, v);
    return true;
}

fn ps_set_nullable(doc: u64, key_p: ptr, key_l: u64, node: u64) -> bool {
    if node == 0 { return false; };
    if sa_json_kind(node) == 0 {
        let st: i32 = sa_json_object_set_null(doc, key_p, key_l);
        return true;
    };
    let v: f64 = 0.0;
    if !numberValue(node, &v) { return false; };
    let st: i32 = sa_json_object_set_f64(doc, key_p, key_l, v);
    return true;
}

fn ps_set_boolval(doc: u64, key_p: ptr, key_l: u64, node: u64) -> bool {
    let b: bool = false;
    if !ps_booleanValue(node, &b) { return false; };
    let st: i32 = sa_json_object_set_bool(doc, key_p, key_l, b);
    return true;
}

fn ps_set_enum(doc: u64, key_p: ptr, key_l: u64, ok: bool, val_p: ptr, val_l: u64) -> bool {
    if !ok { return false; };
    let st: i32 = sa_json_object_set_string(doc, key_p, key_l, val_p, val_l);
    return true;
}

// ---- RelayGroupRow fill from a STEP_JSON row doc (columns by name) ----
fn ps_col_text(row: u64, key_p: ptr, key_l: u64, out_p: &ptr, out_l: &u64) -> bool {
    return ps_field_str(row, key_p, key_l, out_p, out_l);
}

fn ps_col_f64(row: u64, key_p: ptr, key_l: u64) -> f64 {
    let v: f64 = 0.0;
    if ps_field_num(row, key_p, key_l, &v) { return v; };
    return 0.0;
}

fn ps_col_i64(row: u64, key_p: ptr, key_l: u64, out_has: &bool) -> i64 {
    let node: u64 = ps_jget(row, key_p, key_l);
    *out_has = false;
    if node == 0 || sa_json_kind(node) == 0 { return 0; };
    let k: u32 = sa_json_kind(node);
    if k != 2 && k != 3 { return 0; };
    let v: i64 = 0;
    let st: i32 = sa_json_as_i64(node, &v);
    if st != 0 { return 0; };
    *out_has = true;
    return v;
}

fn ps_row_field(row: &RelayGroupRow, code: u64, out_p: &ptr, out_l: &u64, out_has: &bool) -> void {
    *out_p = PTR_NULL();
    *out_l = 0;
    *out_has = true;
    if code == 0 { PTR_BYTE_ADD(*out_p, &row.provider_id, 0); *out_l = row.provider_id_len; };
    if code == 1 { PTR_BYTE_ADD(*out_p, &row.group_id, 0); *out_l = row.group_id_len; };
    if code == 2 { PTR_BYTE_ADD(*out_p, &row.name, 0); *out_l = row.name_len; };
    if code == 3 { PTR_BYTE_ADD(*out_p, &row.base_url, 0); *out_l = row.base_url_len; *out_has = row.has_base_url; };
    if code == 4 { PTR_BYTE_ADD(*out_p, &row.kind, 0); *out_l = row.kind_len; };
    if code == 5 { PTR_BYTE_ADD(*out_p, &row.status, 0); *out_l = row.status_len; *out_has = row.has_status; };
    if code == 6 { PTR_BYTE_ADD(*out_p, &row.key_mode, 0); *out_l = row.key_mode_len; *out_has = row.has_key_mode; };
    if code == 7 { PTR_BYTE_ADD(*out_p, &row.response_protocol, 0); *out_l = row.response_protocol_len; *out_has = row.has_response_protocol; };
    if code == 8 { PTR_BYTE_ADD(*out_p, &row.response_protocol_mode, 0); *out_l = row.response_protocol_mode_len; *out_has = row.has_response_protocol_mode; };
    if code == 9 { PTR_BYTE_ADD(*out_p, &row.claude_code_version, 0); *out_l = row.claude_code_version_len; *out_has = row.has_claude_code_version; };
    if code == 10 { PTR_BYTE_ADD(*out_p, &row.endpoint_path_override, 0); *out_l = row.endpoint_path_override_len; *out_has = row.has_endpoint_path_override; };
    if code == 11 { PTR_BYTE_ADD(*out_p, &row.auth_type, 0); *out_l = row.auth_type_len; *out_has = row.has_auth_type; };
    if code == 12 { PTR_BYTE_ADD(*out_p, &row.credential_mode, 0); *out_l = row.credential_mode_len; *out_has = row.has_credential_mode; };
    if code == 13 { PTR_BYTE_ADD(*out_p, &row.catalog_group_name, 0); *out_l = row.catalog_group_name_len; *out_has = row.has_catalog_group_name; };
    if code == 14 { PTR_BYTE_ADD(*out_p, &row.keys_json, 0); *out_l = row.keys_json_len; };
    if code == 15 { PTR_BYTE_ADD(*out_p, &row.models_json, 0); *out_l = row.models_json_len; };
    if code == 16 { PTR_BYTE_ADD(*out_p, &row.model_capabilities_json, 0); *out_l = row.model_capabilities_json_len; *out_has = row.has_model_capabilities_json; };
    if code == 17 { PTR_BYTE_ADD(*out_p, &row.supported_endpoint_types_json, 0); *out_l = row.supported_endpoint_types_json_len; *out_has = row.has_supported_endpoint_types_json; };
    if code == 18 { PTR_BYTE_ADD(*out_p, &row.image_json, 0); *out_l = row.image_json_len; *out_has = row.has_image_json; };
    if code == 19 { PTR_BYTE_ADD(*out_p, &row.model_mapping_json, 0); *out_l = row.model_mapping_json_len; };
    if code == 20 { PTR_BYTE_ADD(*out_p, &row.status_code_mapping_json, 0); *out_l = row.status_code_mapping_json_len; };
    if code == 21 { PTR_BYTE_ADD(*out_p, &row.advanced_model_mapping_json, 0); *out_l = row.advanced_model_mapping_json_len; *out_has = row.has_advanced_model_mapping_json; };
    if code == 22 { PTR_BYTE_ADD(*out_p, &row.tag, 0); *out_l = row.tag_len; *out_has = row.has_tag; };
    if code == 23 { PTR_BYTE_ADD(*out_p, &row.remark, 0); *out_l = row.remark_len; *out_has = row.has_remark; };
    if code == 24 { PTR_BYTE_ADD(*out_p, &row.command_blacklist_json, 0); *out_l = row.command_blacklist_json_len; };
    if code == 25 { PTR_BYTE_ADD(*out_p, &row.network_allowlist_json, 0); *out_l = row.network_allowlist_json_len; };
    if code == 26 { PTR_BYTE_ADD(*out_p, &row.fallback_channel_id, 0); *out_l = row.fallback_channel_id_len; *out_has = row.has_fallback_channel_id; };
    if code == 27 { PTR_BYTE_ADD(*out_p, &row.fallback_group_name, 0); *out_l = row.fallback_group_name_len; *out_has = row.has_fallback_group_name; };
    if code == 28 { PTR_BYTE_ADD(*out_p, &row.tiered_context_ratios_json, 0); *out_l = row.tiered_context_ratios_json_len; };
}

