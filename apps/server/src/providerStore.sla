// ---- image config values ----
fn imageProtocolValue(value_json: u64, out_ptr: &ptr, out_len: &u64) -> bool {
    let p: ptr = PTR_NULL();
    let l: u64 = 0;
    if !ps_stringValue(value_json, &p, &l) { return false; };
    let ok: bool = ps_eq(p, l, STR_PTR("openaiImages"), STR_LEN("openaiImages"));
    if ps_eq(p, l, STR_PTR("openaiImageEdits"), STR_LEN("openaiImageEdits")) { ok = true; };
    if ps_eq(p, l, STR_PTR("geminiChatCompletions"), STR_LEN("geminiChatCompletions")) { ok = true; };
    if ps_eq(p, l, STR_PTR("geminiGenerateContent"), STR_LEN("geminiGenerateContent")) { ok = true; };
    if ps_eq(p, l, STR_PTR("deepkeyAsyncVideos"), STR_LEN("deepkeyAsyncVideos")) { ok = true; };
    if !ok { return false; };
    ps_doc_str(STR_PTR("enum"), STR_LEN("enum"), p, l, out_ptr, out_len);
    return true;
}

fn imageProtocolArray(value_json: u64, out_json: &u64) -> void {
    let raw: u64 = 0;
    ps_stringArray(value_json, &raw);
    let filtered: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    *out_json = filtered;
    if raw != 0 && filtered != 0 {
        let count: u64 = 0;
        let cst: i32 = sa_json_value_count(raw, &count);
        let i: u64 = 0;
        while i < count {
            let item: u64 = 0;
            let ast: i32 = sa_json_array_get(raw, i, &item);
            let p: ptr = PTR_NULL();
            let l: u64 = 0;
            if imageProtocolValue(item, &p, &l) {
                let dup: bool = false;
                let have: u64 = 0;
                let hst: i32 = sa_json_value_count(filtered, &have);
                let j: u64 = 0;
                while j < have {
                    let ex: u64 = 0;
                    let gst: i32 = sa_json_array_get(filtered, j, &ex);
                    let ep: ptr = PTR_NULL();
                    let el: u64 = 0;
                    if ps_jstr(ex, &ep, &el) && ps_eq(ep, el, p, l) { dup = true; };
                    j = j + 1;
                }
                if !dup {
                    let pst: i32 = sa_json_array_push_string(filtered, p, l);
                };
            };
            i = i + 1;
        }
    };
    if raw != 0 {
        let f: i32 = sa_json_free(raw);
    };
}

fn imageModelPriceArray(value_json: u64, out_json: &u64) -> void {
    let out: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
