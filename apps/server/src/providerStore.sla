    if s.db == 0 { return; };
    let ddl: ptr = STR_PTR("CREATE TABLE IF NOT EXISTS providers (id TEXT PRIMARY KEY, payload TEXT NOT NULL, created_at INTEGER NOT NULL, updated_at INTEGER NOT NULL); CREATE TABLE IF NOT EXISTS provider_secrets (provider_id TEXT PRIMARY KEY, api_key TEXT NOT NULL, updated_at INTEGER NOT NULL); CREATE TABLE IF NOT EXISTS relay_groups (provider_id TEXT NOT NULL, group_id TEXT NOT NULL, name TEXT NOT NULL, base_url TEXT, kind TEXT NOT NULL DEFAULT 'text', status TEXT, group_ratio REAL NOT NULL DEFAULT 1, quota_usd REAL, used_quota_usd REAL, priority INTEGER, weight INTEGER, key_mode TEXT, response_protocol TEXT, response_protocol_mode TEXT, claude_code_headers_enabled INTEGER NOT NULL DEFAULT 0, claude_code_version TEXT, endpoint_path_override TEXT, auth_type TEXT, credential_mode TEXT, catalog_group_name TEXT, catalog_managed INTEGER, keys_json TEXT NOT NULL DEFAULT '[]', models_json TEXT NOT NULL DEFAULT '[]', model_capabilities_json TEXT NOT NULL DEFAULT '{}', supported_endpoint_types_json TEXT NOT NULL DEFAULT '[]', image_json TEXT, model_mapping_json TEXT NOT NULL DEFAULT '[]', status_code_mapping_json TEXT NOT NULL DEFAULT '[]', advanced_model_mapping_json TEXT NOT NULL DEFAULT '[]', tag TEXT, remark TEXT, auto_ban INTEGER, request_limit INTEGER, request_interval_seconds INTEGER, context_window INTEGER, command_blacklist_enabled INTEGER NOT NULL DEFAULT 1, command_blacklist_json TEXT NOT NULL DEFAULT '[]', network_allowlist_json TEXT NOT NULL DEFAULT '[]', enable_fallback INTEGER, fallback_channel_id TEXT, fallback_group_name TEXT, enable_tiered_context INTEGER, tiered_context_ratios_json TEXT NOT NULL DEFAULT '[]', sort_order INTEGER NOT NULL DEFAULT 0, created_at INTEGER NOT NULL, updated_at INTEGER NOT NULL, PRIMARY KEY (provider_id, group_id), FOREIGN KEY (provider_id) REFERENCES providers(id) ON DELETE CASCADE); CREATE INDEX IF NOT EXISTS idx_relay_groups_provider_sort ON relay_groups(provider_id, sort_order, priority); CREATE TABLE IF NOT EXISTS relay_catalogs (provider_id TEXT PRIMARY KEY, success INTEGER NOT NULL, imported_at INTEGER NOT NULL, source_hash TEXT NOT NULL, warnings_json TEXT NOT NULL DEFAULT '[]', FOREIGN KEY (provider_id) REFERENCES providers(id) ON DELETE CASCADE); CREATE TABLE IF NOT EXISTS relay_catalog_groups (provider_id TEXT NOT NULL, group_name TEXT NOT NULL, usable_group TEXT NOT NULL, group_ratio REAL NOT NULL DEFAULT 1, response_protocol TEXT, response_protocol_mode TEXT, PRIMARY KEY (provider_id, group_name), FOREIGN KEY (provider_id) REFERENCES relay_catalogs(provider_id) ON DELETE CASCADE); CREATE TABLE IF NOT EXISTS relay_catalog_models (provider_id TEXT NOT NULL, model_name TEXT NOT NULL, icon TEXT, vendor_id INTEGER, quota_type INTEGER NOT NULL DEFAULT 0, model_ratio REAL, model_price REAL, completion_ratio REAL, cache_ratio REAL, create_cache_ratio REAL, owner_by TEXT, extensions_json TEXT NOT NULL DEFAULT '{}', PRIMARY KEY (provider_id, model_name), FOREIGN KEY (provider_id) REFERENCES relay_catalogs(provider_id) ON DELETE CASCADE); CREATE TABLE IF NOT EXISTS relay_model_enable_groups (provider_id TEXT NOT NULL, model_name TEXT NOT NULL, group_name TEXT NOT NULL, PRIMARY KEY (provider_id, model_name, group_name), FOREIGN KEY (provider_id, model_name) REFERENCES relay_catalog_models(provider_id, model_name) ON DELETE CASCADE); CREATE TABLE IF NOT EXISTS relay_model_supported_endpoint_types (provider_id TEXT NOT NULL, model_name TEXT NOT NULL, endpoint_type TEXT NOT NULL, PRIMARY KEY (provider_id, model_name, endpoint_type), FOREIGN KEY (provider_id, model_name) REFERENCES relay_catalog_models(provider_id, model_name) ON DELETE CASCADE); CREATE TABLE IF NOT EXISTS relay_supported_endpoints (provider_id TEXT NOT NULL, endpoint_type TEXT NOT NULL, path TEXT NOT NULL, method TEXT NOT NULL, canonical_endpoint_type TEXT NOT NULL, aliases_json TEXT NOT NULL DEFAULT '[]', extensions_json TEXT NOT NULL DEFAULT '{}', PRIMARY KEY (provider_id, endpoint_type), FOREIGN KEY (provider_id) REFERENCES relay_catalogs(provider_id) ON DELETE CASCADE); CREATE TABLE IF NOT EXISTS relay_vendors (provider_id TEXT NOT NULL, vendor_id INTEGER NOT NULL, name TEXT NOT NULL, icon TEXT, extensions_json TEXT NOT NULL DEFAULT '{}', PRIMARY KEY (provider_id, vendor_id), FOREIGN KEY (provider_id) REFERENCES relay_catalogs(provider_id) ON DELETE CASCADE); CREATE TABLE IF NOT EXISTS relay_auto_groups (provider_id TEXT NOT NULL, group_name TEXT NOT NULL, PRIMARY KEY (provider_id, group_name), FOREIGN KEY (provider_id) REFERENCES relay_catalogs(provider_id) ON DELETE CASCADE); CREATE INDEX IF NOT EXISTS idx_relay_catalog_models_vendor ON relay_catalog_models(provider_id, vendor_id, quota_type); CREATE INDEX IF NOT EXISTS idx_relay_model_groups_group ON relay_model_enable_groups(provider_id, group_name, model_name); CREATE INDEX IF NOT EXISTS idx_relay_model_endpoints_type ON relay_model_supported_endpoint_types(provider_id, endpoint_type, model_name);");
    let ddl_l: u64 = STR_LEN("CREATE TABLE IF NOT EXISTS providers (id TEXT PRIMARY KEY, payload TEXT NOT NULL, created_at INTEGER NOT NULL, updated_at INTEGER NOT NULL); CREATE TABLE IF NOT EXISTS provider_secrets (provider_id TEXT PRIMARY KEY, api_key TEXT NOT NULL, updated_at INTEGER NOT NULL); CREATE TABLE IF NOT EXISTS relay_groups (provider_id TEXT NOT NULL, group_id TEXT NOT NULL, name TEXT NOT NULL, base_url TEXT, kind TEXT NOT NULL DEFAULT 'text', status TEXT, group_ratio REAL NOT NULL DEFAULT 1, quota_usd REAL, used_quota_usd REAL, priority INTEGER, weight INTEGER, key_mode TEXT, response_protocol TEXT, response_protocol_mode TEXT, claude_code_headers_enabled INTEGER NOT NULL DEFAULT 0, claude_code_version TEXT, endpoint_path_override TEXT, auth_type TEXT, credential_mode TEXT, catalog_group_name TEXT, catalog_managed INTEGER, keys_json TEXT NOT NULL DEFAULT '[]', models_json TEXT NOT NULL DEFAULT '[]', model_capabilities_json TEXT NOT NULL DEFAULT '{}', supported_endpoint_types_json TEXT NOT NULL DEFAULT '[]', image_json TEXT, model_mapping_json TEXT NOT NULL DEFAULT '[]', status_code_mapping_json TEXT NOT NULL DEFAULT '[]', advanced_model_mapping_json TEXT NOT NULL DEFAULT '[]', tag TEXT, remark TEXT, auto_ban INTEGER, request_limit INTEGER, request_interval_seconds INTEGER, context_window INTEGER, command_blacklist_enabled INTEGER NOT NULL DEFAULT 1, command_blacklist_json TEXT NOT NULL DEFAULT '[]', network_allowlist_json TEXT NOT NULL DEFAULT '[]', enable_fallback INTEGER, fallback_channel_id TEXT, fallback_group_name TEXT, enable_tiered_context INTEGER, tiered_context_ratios_json TEXT NOT NULL DEFAULT '[]', sort_order INTEGER NOT NULL DEFAULT 0, created_at INTEGER NOT NULL, updated_at INTEGER NOT NULL, PRIMARY KEY (provider_id, group_id), FOREIGN KEY (provider_id) REFERENCES providers(id) ON DELETE CASCADE); CREATE INDEX IF NOT EXISTS idx_relay_groups_provider_sort ON relay_groups(provider_id, sort_order, priority); CREATE TABLE IF NOT EXISTS relay_catalogs (provider_id TEXT PRIMARY KEY, success INTEGER NOT NULL, imported_at INTEGER NOT NULL, source_hash TEXT NOT NULL, warnings_json TEXT NOT NULL DEFAULT '[]', FOREIGN KEY (provider_id) REFERENCES providers(id) ON DELETE CASCADE); CREATE TABLE IF NOT EXISTS relay_catalog_groups (provider_id TEXT NOT NULL, group_name TEXT NOT NULL, usable_group TEXT NOT NULL, group_ratio REAL NOT NULL DEFAULT 1, response_protocol TEXT, response_protocol_mode TEXT, PRIMARY KEY (provider_id, group_name), FOREIGN KEY (provider_id) REFERENCES relay_catalogs(provider_id) ON DELETE CASCADE); CREATE TABLE IF NOT EXISTS relay_catalog_models (provider_id TEXT NOT NULL, model_name TEXT NOT NULL, icon TEXT, vendor_id INTEGER, quota_type INTEGER NOT NULL DEFAULT 0, model_ratio REAL, model_price REAL, completion_ratio REAL, cache_ratio REAL, create_cache_ratio REAL, owner_by TEXT, extensions_json TEXT NOT NULL DEFAULT '{}', PRIMARY KEY (provider_id, model_name), FOREIGN KEY (provider_id) REFERENCES relay_catalogs(provider_id) ON DELETE CASCADE); CREATE TABLE IF NOT EXISTS relay_model_enable_groups (provider_id TEXT NOT NULL, model_name TEXT NOT NULL, group_name TEXT NOT NULL, PRIMARY KEY (provider_id, model_name, group_name), FOREIGN KEY (provider_id, model_name) REFERENCES relay_catalog_models(provider_id, model_name) ON DELETE CASCADE); CREATE TABLE IF NOT EXISTS relay_model_supported_endpoint_types (provider_id TEXT NOT NULL, model_name TEXT NOT NULL, endpoint_type TEXT NOT NULL, PRIMARY KEY (provider_id, model_name, endpoint_type), FOREIGN KEY (provider_id, model_name) REFERENCES relay_catalog_models(provider_id, model_name) ON DELETE CASCADE); CREATE TABLE IF NOT EXISTS relay_supported_endpoints (provider_id TEXT NOT NULL, endpoint_type TEXT NOT NULL, path TEXT NOT NULL, method TEXT NOT NULL, canonical_endpoint_type TEXT NOT NULL, aliases_json TEXT NOT NULL DEFAULT '[]', extensions_json TEXT NOT NULL DEFAULT '{}', PRIMARY KEY (provider_id, endpoint_type), FOREIGN KEY (provider_id) REFERENCES relay_catalogs(provider_id) ON DELETE CASCADE); CREATE TABLE IF NOT EXISTS relay_vendors (provider_id TEXT NOT NULL, vendor_id INTEGER NOT NULL, name TEXT NOT NULL, icon TEXT, extensions_json TEXT NOT NULL DEFAULT '{}', PRIMARY KEY (provider_id, vendor_id), FOREIGN KEY (provider_id) REFERENCES relay_catalogs(provider_id) ON DELETE CASCADE); CREATE TABLE IF NOT EXISTS relay_auto_groups (provider_id TEXT NOT NULL, group_name TEXT NOT NULL, PRIMARY KEY (provider_id, group_name), FOREIGN KEY (provider_id) REFERENCES relay_catalogs(provider_id) ON DELETE CASCADE); CREATE INDEX IF NOT EXISTS idx_relay_catalog_models_vendor ON relay_catalog_models(provider_id, vendor_id, quota_type); CREATE INDEX IF NOT EXISTS idx_relay_model_groups_group ON relay_model_enable_groups(provider_id, group_name, model_name); CREATE INDEX IF NOT EXISTS idx_relay_model_endpoints_type ON relay_model_supported_endpoint_types(provider_id, endpoint_type, model_name);");
    let st: i32 = ps_exec(s.db, ddl, ddl_l);
    ProviderStore_migrateProviderSecretsSchema(s);
    // 18 legacy column migrations, each failure swallowed by TS
    let a1: i32 = ps_exec(s.db, STR_PTR("ALTER TABLE relay_groups ADD COLUMN response_protocol TEXT"), STR_LEN("ALTER TABLE relay_groups ADD COLUMN response_protocol TEXT"));
    let a2: i32 = ps_exec(s.db, STR_PTR("ALTER TABLE relay_groups ADD COLUMN base_url TEXT"), STR_LEN("ALTER TABLE relay_groups ADD COLUMN base_url TEXT"));
    let a3: i32 = ps_exec(s.db, STR_PTR("ALTER TABLE relay_groups ADD COLUMN response_protocol_mode TEXT"), STR_LEN("ALTER TABLE relay_groups ADD COLUMN response_protocol_mode TEXT"));
    let a4: i32 = ps_exec(s.db, STR_PTR("ALTER TABLE relay_groups ADD COLUMN claude_code_headers_enabled INTEGER NOT NULL DEFAULT 0"), STR_LEN("ALTER TABLE relay_groups ADD COLUMN claude_code_headers_enabled INTEGER NOT NULL DEFAULT 0"));
    let a5: i32 = ps_exec(s.db, STR_PTR("ALTER TABLE relay_groups ADD COLUMN claude_code_version TEXT"), STR_LEN("ALTER TABLE relay_groups ADD COLUMN claude_code_version TEXT"));
    let a6: i32 = ps_exec(s.db, STR_PTR("ALTER TABLE relay_groups ADD COLUMN endpoint_path_override TEXT"), STR_LEN("ALTER TABLE relay_groups ADD COLUMN endpoint_path_override TEXT"));
    let a7: i32 = ps_exec(s.db, STR_PTR("ALTER TABLE relay_groups ADD COLUMN auth_type TEXT"), STR_LEN("ALTER TABLE relay_groups ADD COLUMN auth_type TEXT"));
    let a8: i32 = ps_exec(s.db, STR_PTR("ALTER TABLE relay_groups ADD COLUMN credential_mode TEXT"), STR_LEN("ALTER TABLE relay_groups ADD COLUMN credential_mode TEXT"));
    let a9: i32 = ps_exec(s.db, STR_PTR("ALTER TABLE relay_groups ADD COLUMN catalog_group_name TEXT"), STR_LEN("ALTER TABLE relay_groups ADD COLUMN catalog_group_name TEXT"));
    let a10: i32 = ps_exec(s.db, STR_PTR("ALTER TABLE relay_groups ADD COLUMN catalog_managed INTEGER"), STR_LEN("ALTER TABLE relay_groups ADD COLUMN catalog_managed INTEGER"));
    let a11: i32 = ps_exec(s.db, STR_PTR("ALTER TABLE relay_groups ADD COLUMN supported_endpoint_types_json TEXT NOT NULL DEFAULT '[]'"), STR_LEN("ALTER TABLE relay_groups ADD COLUMN supported_endpoint_types_json TEXT NOT NULL DEFAULT '[]'"));
    let a12: i32 = ps_exec(s.db, STR_PTR("ALTER TABLE relay_groups ADD COLUMN model_capabilities_json TEXT NOT NULL DEFAULT '{}'"), STR_LEN("ALTER TABLE relay_groups ADD COLUMN model_capabilities_json TEXT NOT NULL DEFAULT '{}'"));
    let a13: i32 = ps_exec(s.db, STR_PTR("ALTER TABLE relay_groups ADD COLUMN image_json TEXT"), STR_LEN("ALTER TABLE relay_groups ADD COLUMN image_json TEXT"));
    let a14: i32 = ps_exec(s.db, STR_PTR("ALTER TABLE relay_groups ADD COLUMN context_window INTEGER"), STR_LEN("ALTER TABLE relay_groups ADD COLUMN context_window INTEGER"));
    let a15: i32 = ps_exec(s.db, STR_PTR("ALTER TABLE relay_groups ADD COLUMN command_blacklist_enabled INTEGER NOT NULL DEFAULT 1"), STR_LEN("ALTER TABLE relay_groups ADD COLUMN command_blacklist_enabled INTEGER NOT NULL DEFAULT 1"));
    let a16: i32 = ps_exec(s.db, STR_PTR("ALTER TABLE relay_groups ADD COLUMN command_blacklist_json TEXT NOT NULL DEFAULT '[]'"), STR_LEN("ALTER TABLE relay_groups ADD COLUMN command_blacklist_json TEXT NOT NULL DEFAULT '[]'"));
    let a17: i32 = ps_exec(s.db, STR_PTR("ALTER TABLE relay_groups ADD COLUMN network_allowlist_json TEXT NOT NULL DEFAULT '[]'"), STR_LEN("ALTER TABLE relay_groups ADD COLUMN network_allowlist_json TEXT NOT NULL DEFAULT '[]'"));
    let a18: i32 = ps_exec(s.db, STR_PTR("ALTER TABLE relay_groups ADD COLUMN advanced_model_mapping_json TEXT NOT NULL DEFAULT '[]'"), STR_LEN("ALTER TABLE relay_groups ADD COLUMN advanced_model_mapping_json TEXT NOT NULL DEFAULT '[]'"));
}

fn ProviderStore_migrateProviderSecretsSchema(s: &ProviderStore) -> void {
    if s.db == 0 { return; };
    let stmt: u64 = ps_prepare(s.db, STR_PTR("PRAGMA foreign_key_list(provider_secrets)"), STR_LEN("PRAGMA foreign_key_list(provider_secrets)"));
    if stmt == 0 { return; };
    let has_providers_fk: bool = false;
    let guard: u64 = 0;
    while guard < 1000 {
        guard = guard + 1;
        let doc: u64 = 0;
        if !ps_step_row(stmt, &doc) { break; };
        let tp: ptr = PTR_NULL();
        let tl: u64 = 0;
        if ps_field_str(doc, STR_PTR("table"), STR_LEN("table"), &tp, &tl) {
            if ps_eq(tp, tl, STR_PTR("providers"), STR_LEN("providers")) { has_providers_fk = true; };
        };
        let f: i32 = sa_json_free(doc);
    }
    ps_finalize(stmt);
    if !has_providers_fk { return; };
    let st: i32 = ps_exec(s.db, STR_PTR("ALTER TABLE provider_secrets RENAME TO provider_secrets_legacy; CREATE TABLE provider_secrets (provider_id TEXT PRIMARY KEY, api_key TEXT NOT NULL, updated_at INTEGER NOT NULL); INSERT INTO provider_secrets (provider_id, api_key, updated_at) SELECT provider_id, api_key, updated_at FROM provider_secrets_legacy; DROP TABLE provider_secrets_legacy;"), STR_LEN("ALTER TABLE provider_secrets RENAME TO provider_secrets_legacy; CREATE TABLE provider_secrets (provider_id TEXT PRIMARY KEY, api_key TEXT NOT NULL, updated_at INTEGER NOT NULL); INSERT INTO provider_secrets (provider_id, api_key, updated_at) SELECT provider_id, api_key, updated_at FROM provider_secrets_legacy; DROP TABLE provider_secrets_legacy;"));
}

fn ProviderStore_readPersistedProviderKey(s: &ProviderStore, id_ptr: ptr, id_len: u64, out_ptr: &ptr, out_len: &u64) -> void {
    *out_ptr = PTR_NULL();
    *out_len = 0;
    let stmt: u64 = ps_prepare(s.db, STR_PTR("SELECT api_key FROM provider_secrets WHERE provider_id = ?"), STR_LEN("SELECT api_key FROM provider_secrets WHERE provider_id = ?"));
    if stmt == 0 {
        ps_doc_str(STR_PTR("persisted"), STR_LEN("persisted"), STR_PTR(""), 0, out_ptr, out_len);
        return;
    };
    ps_bind_text(stmt, 1, id_ptr, id_len);
    let doc: u64 = 0;
    let has: bool = ps_step_row(stmt, &doc);
    ps_finalize(stmt);
    if !has {
        ps_doc_str(STR_PTR("persisted"), STR_LEN("persisted"), STR_PTR(""), 0, out_ptr, out_len);
        return;
    };
    let kp: ptr = PTR_NULL();
    let kl: u64 = 0;
    if ps_field_str(doc, STR_PTR("api_key"), STR_LEN("api_key"), &kp, &kl) {
        let lo: u64 = 0;
        let hi: u64 = 0;
        ps_trim_range(kp, kl, &lo, &hi);
        let seg: ptr = PTR_NULL();
        PTR_BYTE_ADD(seg, kp, lo);
        ps_doc_str(STR_PTR("persisted"), STR_LEN("persisted"), seg, hi - lo, out_ptr, out_len);
    } else {
        ps_doc_str(STR_PTR("persisted"), STR_LEN("persisted"), STR_PTR(""), 0, out_ptr, out_len);
    };
    let f: i32 = sa_json_free(doc);
}

fn ProviderStore_persistProviderKey(s: &ProviderStore, id_ptr: ptr, id_len: u64, secret_ptr: ptr, secret_len: u64) -> void {
    let stmt: u64 = ps_prepare(s.db, STR_PTR("INSERT INTO provider_secrets (provider_id, api_key, updated_at) VALUES (?, ?, ?) ON CONFLICT(provider_id) DO UPDATE SET api_key = excluded.api_key, updated_at = excluded.updated_at"), STR_LEN("INSERT INTO provider_secrets (provider_id, api_key, updated_at) VALUES (?, ?, ?) ON CONFLICT(provider_id) DO UPDATE SET api_key = excluded.api_key, updated_at = excluded.updated_at"));
    if stmt == 0 { return; };
    ps_bind_text(stmt, 1, id_ptr, id_len);
    ps_bind_text(stmt, 2, secret_ptr, secret_len);
    ps_bind_int(stmt, 3, ps_now_ms());
    ps_step_once(stmt);
    ps_finalize(stmt);
}

fn ProviderStore_deletePersistedProviderKey(s: &ProviderStore, id_ptr: ptr, id_len: u64) -> void {
    let stmt: u64 = ps_prepare(s.db, STR_PTR("DELETE FROM provider_secrets WHERE provider_id = ?"), STR_LEN("DELETE FROM provider_secrets WHERE provider_id = ?"));
    if stmt == 0 { return; };
    ps_bind_text(stmt, 1, id_ptr, id_len);
    ps_step_once(stmt);
    ps_finalize(stmt);
}

fn ProviderStore_readRelayGroups(s: &ProviderStore, out_json: &u64) -> void {
    let map: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    *out_json = map;
    if map == 0 || s.db == 0 { return; };
    let stmt: u64 = ps_prepare(s.db, STR_PTR("SELECT * FROM relay_groups ORDER BY provider_id ASC, sort_order ASC, priority ASC, group_id ASC"), STR_LEN("SELECT * FROM relay_groups ORDER BY provider_id ASC, sort_order ASC, priority ASC, group_id ASC"));
    if stmt == 0 { return; };
    let guard: u64 = 0;
    while guard < 100000 {
        guard = guard + 1;
        let doc: u64 = 0;
        if !ps_step_row(stmt, &doc) { break; };
        let row = RelayGroupRow { provider_id: [0; 128], provider_id_len: 0, group_id: [0; 128], group_id_len: 0, name: [0; 256], name_len: 0, base_url: [0; 1024], base_url_len: 0, has_base_url: false, kind: [0; 32], kind_len: 0, status: [0; 32], status_len: 0, has_status: false, group_ratio: 0.0, quota_usd: 0.0, has_quota_usd: false, used_quota_usd: 0.0, has_used_quota_usd: false, priority: 0, has_priority: false, weight: 0, has_weight: false, key_mode: [0; 32], key_mode_len: 0, has_key_mode: false, response_protocol: [0; 64], response_protocol_len: 0, has_response_protocol: false, response_protocol_mode: [0; 64], response_protocol_mode_len: 0, has_response_protocol_mode: false, claude_code_headers_enabled: 0, has_claude_code_headers_enabled: false, claude_code_version: [0; 64], claude_code_version_len: 0, has_claude_code_version: false, endpoint_path_override: [0; 512], endpoint_path_override_len: 0, has_endpoint_path_override: false, auth_type: [0; 64], auth_type_len: 0, has_auth_type: false, credential_mode: [0; 64], credential_mode_len: 0, has_credential_mode: false, catalog_group_name: [0; 256], catalog_group_name_len: 0, has_catalog_group_name: false, catalog_managed: 0, has_catalog_managed: false, keys_json: [0; 8192], keys_json_len: 0, models_json: [0; 8192], models_json_len: 0, model_capabilities_json: [0; 8192], model_capabilities_json_len: 0, has_model_capabilities_json: false, supported_endpoint_types_json: [0; 4096], supported_endpoint_types_json_len: 0, has_supported_endpoint_types_json: false, image_json: [0; 4096], image_json_len: 0, has_image_json: false, model_mapping_json: [0; 8192], model_mapping_json_len: 0, status_code_mapping_json: [0; 4096], status_code_mapping_json_len: 0, advanced_model_mapping_json: [0; 8192], advanced_model_mapping_json_len: 0, has_advanced_model_mapping_json: false, tag: [0; 256], tag_len: 0, has_tag: false, remark: [0; 1024], remark_len: 0, has_remark: false, auto_ban: 0, has_auto_ban: false, request_limit: 0, has_request_limit: false, request_interval_seconds: 0, has_request_interval_seconds: false, context_window: 0, has_context_window: false, command_blacklist_enabled: 0, has_command_blacklist_enabled: false, command_blacklist_json: [0; 8192], command_blacklist_json_len: 0, network_allowlist_json: [0; 8192], network_allowlist_json_len: 0, enable_fallback: 0, has_enable_fallback: false, fallback_channel_id: [0; 128], fallback_channel_id_len: 0, has_fallback_channel_id: false, fallback_group_name: [0; 256], fallback_group_name_len: 0, has_fallback_group_name: false, enable_tiered_context: 0, has_enable_tiered_context: false, tiered_context_ratios_json: [0; 4096], tiered_context_ratios_json_len: 0, sort_order: 0, created_at: 0, updated_at: 0 };
        ps_fill_group_row(doc, &row);
        let f: i32 = sa_json_free(doc);
        let group: u64 = 0;
        if groupFromRow(&row, &group) {
            let pid_p: ptr = PTR_NULL();
            let pid_l: u64 = 0;
            let pid_has: bool = false;
            ps_row_field(&row, 0, &pid_p, &pid_l, &pid_has);
            let existing: u64 = ps_jget(map, pid_p, pid_l);
            if existing != 0 && sa_json_kind(existing) == 6 {
                let pst: i32 = sa_json_array_push_node(existing, group);
            } else {
                let arr: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
                if arr != 0 {
                    let pst: i32 = sa_json_array_push_node(arr, group);
                    let sst: i32 = sa_json_object_set_node(map, pid_p, pid_l, arr);
                };
            };
        };
    }
    ps_finalize(stmt);
}

fn ps_store_providers(shape: &StoreShape, out_json: &u64) -> bool {
    let pp: ptr = PTR_NULL();
    PTR_BYTE_ADD(pp, &shape.providers_json, 0);
    let doc: u64 = sa_json_parse(pp, shape.providers_len);
    *out_json = doc;
    return doc != 0 && sa_json_kind(doc) == 6;
}

fn ps_shape_from_providers(providers: u64, out: &StoreShape) -> void {
    out.providers_len = 0;
    if providers == 0 { return; };
    let buf: u64 = 0;
    if sa_json_stringify(providers, &buf) != 0 || buf == 0 { return; };
    let bp: ptr = sa_json_buffer_data(buf);
    let bl: u64 = sa_json_buffer_len(buf);
    let n: u64 = bl;
    if n > 1048576 { n = 1048576; };
    let i: u64 = 0;
    while i < n {
        out.providers_json[i] = ps_byte(bp, i);
        i = i + 1;
    }
    out.providers_len = n;
    let f: i32 = sa_json_buffer_free(buf);
}

fn ProviderStore_read(s: &ProviderStore, out: &StoreShape) -> i32 {
    let providers: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    if providers == 0 || s.db == 0 {
        ps_shape_from_providers(providers, out);
        if providers != 0 { let f: i32 = sa_json_free(providers); };
        return 0;
    };
    let groups_map: u64 = 0;
    ProviderStore_readRelayGroups(s, &groups_map);
    let stmt: u64 = ps_prepare(s.db, STR_PTR("SELECT id, payload FROM providers ORDER BY created_at ASC, id ASC"), STR_LEN("SELECT id, payload FROM providers ORDER BY created_at ASC, id ASC"));
    if stmt != 0 {
        let guard: u64 = 0;
        while guard < 100000 {
            guard = guard + 1;
            let doc: u64 = 0;
            if !ps_step_row(stmt, &doc) { break; };
            let id_p: ptr = PTR_NULL();
            let id_l: u64 = 0;
            let has_id: bool = ps_field_str(doc, STR_PTR("id"), STR_LEN("id"), &id_p, &id_l);
            let id = PsText { bytes: [0; 65536], len: 0 };
            if has_id { ps_append(&id, id_p, id_l); };
            let pay_p: ptr = PTR_NULL();
            let pay_l: u64 = 0;
            let has_pay: bool = ps_field_str(doc, STR_PTR("payload"), STR_LEN("payload"), &pay_p, &pay_l);
            let provider: u64 = 0;
            let parsed_ok: bool = false;
            if has_pay {
                parsed_ok = parseProvider(pay_p, pay_l, &provider);
            };
            let f: i32 = sa_json_free(doc);
            if !parsed_ok { continue; };
            let persisted: u64 = ps_jget(groups_map, ps_text_ptr(&id), id.len);
            let chosen: u64 = 0;
            selectConsistentRelayGroups(ps_jget(provider, STR_PTR("groups"), STR_LEN("groups")), persisted, persisted != 0, &chosen);
            let base: u64 = provider;
            if chosen != 0 {
                let cc: u64 = 0;
                let cst2: i32 = sa_json_value_count(chosen, &cc);
                if cc > 0 {
                    let with_groups: u64 = ps_clone(provider);
                    if with_groups != 0 {
                        let sst: i32 = sa_json_object_set_node(with_groups, STR_PTR("groups"), STR_LEN("groups"), ps_clone(chosen));
                        let f2: i32 = sa_json_free(provider);
                        base = with_groups;
                    };
                };
            };
            let key_p: ptr = PTR_NULL();
            let key_l: u64 = 0;
            ProviderStore_readPersistedProviderKey(s, ps_text_ptr(&id), id.len, &key_p, &key_l);
            let key = PsText { bytes: [0; 65536], len: 0 };
            ps_append(&key, key_p, key_l);
            let grouped: u64 = 0;
            ensureDefaultRelayGroup(base, ps_text_ptr(&key), key.len, &grouped);
            if grouped != base {
                let f3: i32 = sa_json_free(base);
            };
            if grouped != 0 {
                let pst: i32 = sa_json_array_push_node(providers, grouped);
            };
        }
        ps_finalize(stmt);
    };
    ps_shape_from_providers(providers, out);
    let f: i32 = sa_json_free(providers);
    if groups_map != 0 {
        let f2: i32 = sa_json_free(groups_map);
    };
    return 0;
}

// ---- write path ----
fn ps_reset(stmt: u64) -> void {
    let st: u64 = 0;
    SA_SQLITE_RESET(st, stmt);
    let st2: u64 = 0;
    SA_SQLITE_CLEAR_BINDINGS(st2, stmt);
}

fn ps_bind_text_or_null(stmt: u64, idx: u64, has: bool, p: ptr, l: u64) -> void {
    if has {
        ps_bind_text(stmt, idx, p, l);
    } else {
        ps_bind_null(stmt, idx);
    };
}

fn ps_bind_sv_or_null(stmt: u64, idx: u64, node: u64) -> void {
    let p: ptr = PTR_NULL();
    let l: u64 = 0;
    if ps_stringValue(node, &p, &l) {
        ps_bind_text(stmt, idx, p, l);
    } else {
        ps_bind_null(stmt, idx);
    };
}

fn ps_bind_num_or_null(stmt: u64, idx: u64, node: u64) -> void {
    let v: f64 = 0.0;
    if numberValue(node, &v) {
        ps_bind_double(stmt, idx, v);
    } else {
        ps_bind_null(stmt, idx);
    };
}

fn ps_bind_json_or(stmt: u64, idx: u64, node: u64, dflt_p: ptr, dflt_l: u64) -> void {
    if node != 0 {
        let text = PsText { bytes: [0; 65536], len: 0 };
        if ps_stringify(node, &text) {
            ps_bind_text(stmt, idx, ps_text_ptr(&text), text.len);
            return;
        };
    };
    ps_bind_text(stmt, idx, dflt_p, dflt_l);
}

fn ps_bind_json_or_null(stmt: u64, idx: u64, node: u64) -> void {
    if node != 0 {
        let text = PsText { bytes: [0; 65536], len: 0 };
        if ps_stringify(node, &text) {
            ps_bind_text(stmt, idx, ps_text_ptr(&text), text.len);
            return;
        };
    };
    ps_bind_null(stmt, idx);
}

fn ps_bind_bool_sql(stmt: u64, idx: u64, node: u64) -> void {
    let v: i64 = booleanToSql(node, node != 0);
    if v < 0 {
        ps_bind_null(stmt, idx);
    } else {
        ps_bind_int(stmt, idx, v);
    };
}

fn ProviderStore_persistClaudeCodeHeaderFields(s: &ProviderStore, providerId_ptr: ptr, providerId_len: u64, group_json: u64) -> void {
    let stmt: u64 = ps_prepare(s.db, STR_PTR("UPDATE relay_groups SET claude_code_headers_enabled = ?, claude_code_version = ? WHERE provider_id = ? AND group_id = ?"), STR_LEN("UPDATE relay_groups SET claude_code_headers_enabled = ?, claude_code_version = ? WHERE provider_id = ? AND group_id = ?"));
    if stmt == 0 { return; };
    let enabled: bool = false;
    let has: bool = ps_field_bool(group_json, STR_PTR("claudeCodeHeadersEnabled"), STR_LEN("claudeCodeHeadersEnabled"), &enabled);
    let ev: i64 = 0;
    if has && enabled { ev = 1; };
    ps_bind_int(stmt, 1, ev);
    let vp: ptr = PTR_NULL();
    let vl: u64 = 0;
    let has_v: bool = ps_field_sv(group_json, STR_PTR("claudeCodeVersion"), STR_LEN("claudeCodeVersion"), &vp, &vl);
    ps_bind_text_or_null(stmt, 2, has_v, vp, vl);
    ps_bind_text(stmt, 3, providerId_ptr, providerId_len);
    let gid_p: ptr = PTR_NULL();
    let gid_l: u64 = 0;
    ps_field_str(group_json, STR_PTR("id"), STR_LEN("id"), &gid_p, &gid_l);
    ps_bind_text(stmt, 4, gid_p, gid_l);
    ps_step_once(stmt);
    ps_finalize(stmt);
}

fn ProviderStore_persistCommandBlacklistFields(s: &ProviderStore, providerId_ptr: ptr, providerId_len: u64, group_json: u64) -> void {
    let stmt: u64 = ps_prepare(s.db, STR_PTR("UPDATE relay_groups SET command_blacklist_enabled = ?, command_blacklist_json = ?, network_allowlist_json = ? WHERE provider_id = ? AND group_id = ?"), STR_LEN("UPDATE relay_groups SET command_blacklist_enabled = ?, command_blacklist_json = ?, network_allowlist_json = ? WHERE provider_id = ? AND group_id = ?"));
    if stmt == 0 { return; };
    let enabled: bool = false;
    let has: bool = ps_field_bool(group_json, STR_PTR("commandBlacklistEnabled"), STR_LEN("commandBlacklistEnabled"), &enabled);
    let ev: i64 = 1;
    if has && !enabled { ev = 0; };
    ps_bind_int(stmt, 1, ev);
    ps_bind_json_or(stmt, 2, ps_jget(group_json, STR_PTR("commandBlacklist"), STR_LEN("commandBlacklist")), STR_PTR("[]"), STR_LEN("[]"));
    ps_bind_json_or(stmt, 3, ps_jget(group_json, STR_PTR("networkAllowlist"), STR_LEN("networkAllowlist")), STR_PTR("[]"), STR_LEN("[]"));
    ps_bind_text(stmt, 4, providerId_ptr, providerId_len);
    let gid_p: ptr = PTR_NULL();
    let gid_l: u64 = 0;
    ps_field_str(group_json, STR_PTR("id"), STR_LEN("id"), &gid_p, &gid_l);
    ps_bind_text(stmt, 5, gid_p, gid_l);
    ps_step_once(stmt);
    ps_finalize(stmt);
}

fn ProviderStore_insertRelayGroups(s: &ProviderStore, insertGroup: u64, provider_json: u64) -> void {
    if insertGroup == 0 { return; };
    let pid_p: ptr = PTR_NULL();
    let pid_l: u64 = 0;
    if !ps_field_str(provider_json, STR_PTR("id"), STR_LEN("id"), &pid_p, &pid_l) { return; };
    let pid = PsText { bytes: [0; 65536], len: 0 };
    ps_append(&pid, pid_p, pid_l);
    let now: i64 = ps_now_ms();
    let created: i64 = now;
    let cv: f64 = 0.0;
    if ps_field_number(provider_json, STR_PTR("createdAt"), STR_LEN("createdAt"), &cv) { created = cv as i64; };
    let updated: i64 = now;
    if ps_field_number(provider_json, STR_PTR("updatedAt"), STR_LEN("updatedAt"), &cv) { updated = cv as i64; };
    let count: u64 = 0;
    let groups: u64 = ps_groups_of(provider_json, &count);
    if groups == 0 { return; };
    let i: u64 = 0;
    while i < count {
        let g: u64 = 0;
        let ast: i32 = sa_json_array_get(groups, i, &g);
        ps_reset(insertGroup);
        ps_bind_text(insertGroup, 1, ps_text_ptr(&pid), pid.len);
        ps_bind_sv_or_null(insertGroup, 2, ps_jget(g, STR_PTR("id"), STR_LEN("id")));
        ps_bind_sv_or_null(insertGroup, 3, ps_jget(g, STR_PTR("name"), STR_LEN("name")));
        ps_bind_sv_or_null(insertGroup, 4, ps_jget(g, STR_PTR("baseUrl"), STR_LEN("baseUrl")));
        let kind_p: ptr = PTR_NULL();
        let kind_l: u64 = 0;
        if ps_stringValue(ps_jget(g, STR_PTR("kind"), STR_LEN("kind")), &kind_p, &kind_l) {
            ps_bind_text(insertGroup, 5, kind_p, kind_l);
        } else {
            ps_bind_text(insertGroup, 5, STR_PTR("text"), STR_LEN("text"));
        };
        ps_bind_sv_or_null(insertGroup, 6, ps_jget(g, STR_PTR("status"), STR_LEN("status")));
        let ratio: f64 = 1.0;
        let rv: f64 = 0.0;
        if numberValue(ps_jget(g, STR_PTR("groupRatio"), STR_LEN("groupRatio")), &rv) { ratio = rv; };
        ps_bind_double(insertGroup, 7, ratio);
        ps_bind_num_or_null(insertGroup, 8, ps_jget(g, STR_PTR("quotaUsd"), STR_LEN("quotaUsd")));
        ps_bind_num_or_null(insertGroup, 9, ps_jget(g, STR_PTR("usedQuotaUsd"), STR_LEN("usedQuotaUsd")));
        ps_bind_num_or_null(insertGroup, 10, ps_jget(g, STR_PTR("priority"), STR_LEN("priority")));
        ps_bind_num_or_null(insertGroup, 11, ps_jget(g, STR_PTR("weight"), STR_LEN("weight")));
        ps_bind_sv_or_null(insertGroup, 12, ps_jget(g, STR_PTR("keyMode"), STR_LEN("keyMode")));
        ps_bind_sv_or_null(insertGroup, 13, ps_jget(g, STR_PTR("responseProtocol"), STR_LEN("responseProtocol")));
        ps_bind_sv_or_null(insertGroup, 14, ps_jget(g, STR_PTR("responseProtocolMode"), STR_LEN("responseProtocolMode")));
        ps_bind_sv_or_null(insertGroup, 15, ps_jget(g, STR_PTR("endpointPathOverride"), STR_LEN("endpointPathOverride")));
        ps_bind_sv_or_null(insertGroup, 16, ps_jget(g, STR_PTR("authType"), STR_LEN("authType")));
        ps_bind_sv_or_null(insertGroup, 17, ps_jget(g, STR_PTR("credentialMode"), STR_LEN("credentialMode")));
        ps_bind_sv_or_null(insertGroup, 18, ps_jget(g, STR_PTR("catalogGroupName"), STR_LEN("catalogGroupName")));
        ps_bind_bool_sql(insertGroup, 19, ps_jget(g, STR_PTR("catalogManaged"), STR_LEN("catalogManaged")));
        ps_bind_json_or(insertGroup, 20, ps_jget(g, STR_PTR("keys"), STR_LEN("keys")), STR_PTR("[]"), STR_LEN("[]"));
        ps_bind_json_or(insertGroup, 21, ps_jget(g, STR_PTR("models"), STR_LEN("models")), STR_PTR("[]"), STR_LEN("[]"));
        ps_bind_json_or(insertGroup, 22, ps_jget(g, STR_PTR("modelCapabilities"), STR_LEN("modelCapabilities")), STR_PTR("{}"), STR_LEN("{}"));
        ps_bind_json_or(insertGroup, 23, ps_jget(g, STR_PTR("supportedEndpointTypes"), STR_LEN("supportedEndpointTypes")), STR_PTR("[]"), STR_LEN("[]"));
        ps_bind_json_or_null(insertGroup, 24, ps_jget(g, STR_PTR("image"), STR_LEN("image")));
        ps_bind_json_or(insertGroup, 25, ps_jget(g, STR_PTR("modelMapping"), STR_LEN("modelMapping")), STR_PTR("[]"), STR_LEN("[]"));
        ps_bind_json_or(insertGroup, 26, ps_jget(g, STR_PTR("statusCodeMapping"), STR_LEN("statusCodeMapping")), STR_PTR("[]"), STR_LEN("[]"));
        ps_bind_json_or(insertGroup, 27, ps_jget(g, STR_PTR("advancedModelMapping"), STR_LEN("advancedModelMapping")), STR_PTR("[]"), STR_LEN("[]"));
        ps_bind_sv_or_null(insertGroup, 28, ps_jget(g, STR_PTR("tag"), STR_LEN("tag")));
        ps_bind_sv_or_null(insertGroup, 29, ps_jget(g, STR_PTR("remark"), STR_LEN("remark")));
        ps_bind_bool_sql(insertGroup, 30, ps_jget(g, STR_PTR("autoBan"), STR_LEN("autoBan")));
        ps_bind_num_or_null(insertGroup, 31, ps_jget(g, STR_PTR("requestLimit"), STR_LEN("requestLimit")));
        ps_bind_num_or_null(insertGroup, 32, ps_jget(g, STR_PTR("requestIntervalSeconds"), STR_LEN("requestIntervalSeconds")));
        let cw: f64 = 0.0;
        if numberValue(ps_jget(g, STR_PTR("contextWindow"), STR_LEN("contextWindow")), &cw) && cw > 0.0 {
            ps_bind_int(insertGroup, 33, (ps_round(cw)) as i64);
        } else {
            ps_bind_null(insertGroup, 33);
        };
        ps_bind_bool_sql(insertGroup, 34, ps_jget(g, STR_PTR("enableFallback"), STR_LEN("enableFallback")));
        ps_bind_sv_or_null(insertGroup, 35, ps_jget(g, STR_PTR("fallbackChannelId"), STR_LEN("fallbackChannelId")));
        ps_bind_sv_or_null(insertGroup, 36, ps_jget(g, STR_PTR("fallbackGroupName"), STR_LEN("fallbackGroupName")));
        ps_bind_bool_sql(insertGroup, 37, ps_jget(g, STR_PTR("enableTieredContext"), STR_LEN("enableTieredContext")));
        ps_bind_json_or(insertGroup, 38, ps_jget(g, STR_PTR("tieredContextRatios"), STR_LEN("tieredContextRatios")), STR_PTR("[]"), STR_LEN("[]"));
        ps_bind_int(insertGroup, 39, i as i64);
        ps_bind_int(insertGroup, 40, created);
        ps_bind_int(insertGroup, 41, updated);
        ps_step_once(insertGroup);
        ProviderStore_persistCommandBlacklistFields(s, ps_text_ptr(&pid), pid.len, g);
        ProviderStore_persistClaudeCodeHeaderFields(s, ps_text_ptr(&pid), pid.len, g);
        i = i + 1;
    }
}

fn ProviderStore_clearCapabilityCatalogTables(s: &ProviderStore) -> void {
    if s.db == 0 { return; };
    ps_run(s.db, STR_PTR("DELETE FROM relay_model_enable_groups"), STR_LEN("DELETE FROM relay_model_enable_groups"));
    ps_run(s.db, STR_PTR("DELETE FROM relay_model_supported_endpoint_types"), STR_LEN("DELETE FROM relay_model_supported_endpoint_types"));
    ps_run(s.db, STR_PTR("DELETE FROM relay_auto_groups"), STR_LEN("DELETE FROM relay_auto_groups"));
    ps_run(s.db, STR_PTR("DELETE FROM relay_supported_endpoints"), STR_LEN("DELETE FROM relay_supported_endpoints"));
    ps_run(s.db, STR_PTR("DELETE FROM relay_vendors"), STR_LEN("DELETE FROM relay_vendors"));
    ps_run(s.db, STR_PTR("DELETE FROM relay_catalog_groups"), STR_LEN("DELETE FROM relay_catalog_groups"));
    ps_run(s.db, STR_PTR("DELETE FROM relay_catalog_models"), STR_LEN("DELETE FROM relay_catalog_models"));
    ps_run(s.db, STR_PTR("DELETE FROM relay_catalogs"), STR_LEN("DELETE FROM relay_catalogs"));
}

// key for catalog/runtime group maps: catalogGroupName ?? name (raw)
fn ps_catalog_group_key(g: u64, out: &PsText) -> bool {
    out.len = 0;
    let p: ptr = PTR_NULL();
    let l: u64 = 0;
    if ps_field_sv(g, STR_PTR("catalogGroupName"), STR_LEN("catalogGroupName"), &p, &l) {
        ps_append(out, p, l);
        return true;
    };
    if ps_field_str(g, STR_PTR("name"), STR_LEN("name"), &p, &l) {
        ps_append(out, p, l);
        return l > 0;
    };
    return false;
}

fn ps_group_map(groups: u64) -> u64 {
    let map: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    if map == 0 || groups == 0 || sa_json_kind(groups) != 6 { return map; };
    let count: u64 = 0;
    let cst: i32 = sa_json_value_count(groups, &count);
    let i: u64 = 0;
    while i < count {
        let g: u64 = 0;
        let ast: i32 = sa_json_array_get(groups, i, &g);
        let key = PsText { bytes: [0; 65536], len: 0 };
        if ps_catalog_group_key(g, &key) {
            let st: i32 = sa_json_object_set_node(map, ps_text_ptr(&key), key.len, ps_clone(g));
        };
        i = i + 1;
    }
    return map;
}

fn ProviderStore_insertCapabilityCatalog(s: &ProviderStore, provider_json: u64) -> void {
    let catalog: u64 = ps_jget(provider_json, STR_PTR("capabilityCatalog"), STR_LEN("capabilityCatalog"));
    if catalog == 0 || s.db == 0 { return; };
    let pid_p: ptr = PTR_NULL();
    let pid_l: u64 = 0;
    if !ps_field_str(provider_json, STR_PTR("id"), STR_LEN("id"), &pid_p, &pid_l) { return; };
    let pid = PsText { bytes: [0; 65536], len: 0 };
    ps_append(&pid, pid_p, pid_l);
    let stmt: u64 = ps_prepare(s.db, STR_PTR("INSERT INTO relay_catalogs (provider_id, success, imported_at, source_hash, warnings_json) VALUES (?, ?, ?, ?, ?)"), STR_LEN("INSERT INTO relay_catalogs (provider_id, success, imported_at, source_hash, warnings_json) VALUES (?, ?, ?, ?, ?)"));
    if stmt != 0 {
        ps_bind_text(stmt, 1, ps_text_ptr(&pid), pid.len);
        let success: bool = false;
        let has_s: bool = ps_field_bool(catalog, STR_PTR("success"), STR_LEN("success"), &success);
        let sv: i64 = 0;
        if has_s && success { sv = 1; };
        ps_bind_int(stmt, 2, sv);
        let imported: f64 = 0.0;
        if ps_field_number(catalog, STR_PTR("imported_at"), STR_LEN("imported_at"), &imported) {
            ps_bind_int(stmt, 3, imported as i64);
        } else {
            ps_bind_int(stmt, 3, 0);
        };
        let hash_p: ptr = PTR_NULL();
        let hash_l: u64 = 0;
        let has_hash: bool = ps_field_str(catalog, STR_PTR("source_hash"), STR_LEN("source_hash"), &hash_p, &hash_l);
        ps_bind_text_or_null(stmt, 4, has_hash, hash_p, hash_l);
        ps_bind_json_or(stmt, 5, ps_jget(catalog, STR_PTR("warnings"), STR_LEN("warnings")), STR_PTR("[]"), STR_LEN("[]"));
        ps_step_once(stmt);
        ps_finalize(stmt);
    };
    // catalog groups via relayCatalog.deriveCatalogGroups (stub in
    // its own unit: yields no groups until implemented)
    let derived: u64 = ps_derive_catalog_groups(catalog);
    let catalog_groups: u64 = ps_group_map(derived);
    if derived != 0 { let f: i32 = sa_json_free(derived); };
    let runtime_groups: u64 = ps_group_map(ps_jget(provider_json, STR_PTR("groups"), STR_LEN("groups")));
    // groupNames = uniqueStrings([...keys(usable_group), ...keys(group_ratio), ...auto_groups, ...data.enable_groups])
    let names_src: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    let usable: u64 = ps_jget(catalog, STR_PTR("usable_group"), STR_LEN("usable_group"));
    if usable != 0 && sa_json_kind(usable) == 7 && names_src != 0 {
        let c: u64 = 0;
        let st: i32 = sa_json_value_count(usable, &c);
        let i: u64 = 0;
        while i < c {
            let kp: ptr = PTR_NULL();
            let kl: u64 = 0;
            let kst: i32 = sa_json_object_key_at(usable, i, &kp, &kl);
            if kst == 0 {
                let pst: i32 = sa_json_array_push_string(names_src, kp, kl);
            };
            i = i + 1;
        }
    };
    let ratios: u64 = ps_jget(catalog, STR_PTR("group_ratio"), STR_LEN("group_ratio"));
    if ratios != 0 && sa_json_kind(ratios) == 7 && names_src != 0 {
        let c: u64 = 0;
        let st: i32 = sa_json_value_count(ratios, &c);
        let i: u64 = 0;
        while i < c {
            let kp: ptr = PTR_NULL();
            let kl: u64 = 0;
            let kst: i32 = sa_json_object_key_at(ratios, i, &kp, &kl);
            if kst == 0 {
                let pst: i32 = sa_json_array_push_string(names_src, kp, kl);
            };
            i = i + 1;
        }
    };
    let autos: u64 = ps_jget(catalog, STR_PTR("auto_groups"), STR_LEN("auto_groups"));
    if autos != 0 && sa_json_kind(autos) == 6 && names_src != 0 {
        let c: u64 = 0;
        let st: i32 = sa_json_value_count(autos, &c);
        let i: u64 = 0;
        while i < c {
            let item: u64 = 0;
            let ast: i32 = sa_json_array_get(autos, i, &item);
            let pst: i32 = sa_json_array_push_node(names_src, ps_clone(item));
            i = i + 1;
        }
    };
    let data: u64 = ps_jget(catalog, STR_PTR("data"), STR_LEN("data"));
    if data != 0 && sa_json_kind(data) == 6 && names_src != 0 {
        let c: u64 = 0;
        let st: i32 = sa_json_value_count(data, &c);
        let i: u64 = 0;
        while i < c {
            let model: u64 = 0;
            let ast: i32 = sa_json_array_get(data, i, &model);
            let egs: u64 = ps_jget(model, STR_PTR("enable_groups"), STR_LEN("enable_groups"));
            if egs != 0 && sa_json_kind(egs) == 6 {
                let ec: u64 = 0;
                let est: i32 = sa_json_value_count(egs, &ec);
                let j: u64 = 0;
                while j < ec {
                    let item: u64 = 0;
                    let gst: i32 = sa_json_array_get(egs, j, &item);
                    let pst: i32 = sa_json_array_push_node(names_src, ps_clone(item));
                    j = j + 1;
                }
            };
            i = i + 1;
        }
    };
    let names: u64 = 0;
    ps_uniqueStrings(names_src, &names);
    if names_src != 0 { let f: i32 = sa_json_free(names_src); };
    let insert_group: u64 = ps_prepare(s.db, STR_PTR("INSERT INTO relay_catalog_groups (provider_id, group_name, usable_group, group_ratio, response_protocol, response_protocol_mode) VALUES (?, ?, ?, ?, ?, ?)"), STR_LEN("INSERT INTO relay_catalog_groups (provider_id, group_name, usable_group, group_ratio, response_protocol, response_protocol_mode) VALUES (?, ?, ?, ?, ?, ?)"));
    if insert_group != 0 && names != 0 {
        let c: u64 = 0;
        let st: i32 = sa_json_value_count(names, &c);
        let i: u64 = 0;
        while i < c {
            let item: u64 = 0;
            let ast: i32 = sa_json_array_get(names, i, &item);
            let np: ptr = PTR_NULL();
            let nl: u64 = 0;
            if ps_jstr(item, &np, &nl) {
                let name = PsText { bytes: [0; 65536], len: 0 };
                ps_append(&name, np, nl);
                ps_reset(insert_group);
                ps_bind_text(insert_group, 1, ps_text_ptr(&pid), pid.len);
                ps_bind_text(insert_group, 2, ps_text_ptr(&name), name.len);
                let up: ptr = PTR_NULL();
                let ul: u64 = 0;
                if ps_field_str(usable, ps_text_ptr(&name), name.len, &up, &ul) {
                    ps_bind_text(insert_group, 3, up, ul);
                } else {
                    ps_bind_text(insert_group, 3, ps_text_ptr(&name), name.len);
                };
                let ratio: f64 = 1.0;
                let rv: f64 = 0.0;
                if ps_field_num(ratios, ps_text_ptr(&name), name.len, &rv) { ratio = rv; };
                ps_bind_double(insert_group, 4, ratio);
                let grp: u64 = ps_jget(runtime_groups, ps_text_ptr(&name), name.len);
                if grp == 0 { grp = ps_jget(catalog_groups, ps_text_ptr(&name), name.len); };
                ps_bind_sv_or_null(insert_group, 5, ps_jget(grp, STR_PTR("responseProtocol"), STR_LEN("responseProtocol")));
                ps_bind_sv_or_null(insert_group, 6, ps_jget(grp, STR_PTR("responseProtocolMode"), STR_LEN("responseProtocolMode")));
                ps_step_once(insert_group);
            };
            i = i + 1;
        }
    };
    if insert_group != 0 { ps_finalize(insert_group); };
    if names != 0 { let f: i32 = sa_json_free(names); };
    if catalog_groups != 0 { let f: i32 = sa_json_free(catalog_groups); };
    if runtime_groups != 0 { let f: i32 = sa_json_free(runtime_groups); };
    // models
    let insert_model: u64 = ps_prepare(s.db, STR_PTR("INSERT INTO relay_catalog_models (provider_id, model_name, icon, vendor_id, quota_type, model_ratio, model_price, completion_ratio, cache_ratio, create_cache_ratio, owner_by, extensions_json) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)"), STR_LEN("INSERT INTO relay_catalog_models (provider_id, model_name, icon, vendor_id, quota_type, model_ratio, model_price, completion_ratio, cache_ratio, create_cache_ratio, owner_by, extensions_json) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)"));
    let insert_mgroup: u64 = ps_prepare(s.db, STR_PTR("INSERT INTO relay_model_enable_groups (provider_id, model_name, group_name) VALUES (?, ?, ?)"), STR_LEN("INSERT INTO relay_model_enable_groups (provider_id, model_name, group_name) VALUES (?, ?, ?)"));
    let insert_mendpoint: u64 = ps_prepare(s.db, STR_PTR("INSERT INTO relay_model_supported_endpoint_types (provider_id, model_name, endpoint_type) VALUES (?, ?, ?)"), STR_LEN("INSERT INTO relay_model_supported_endpoint_types (provider_id, model_name, endpoint_type) VALUES (?, ?, ?)"));
    if data != 0 && sa_json_kind(data) == 6 {
        let c: u64 = 0;
        let st: i32 = sa_json_value_count(data, &c);
        let i: u64 = 0;
        while i < c {
            let model: u64 = 0;
            let ast: i32 = sa_json_array_get(data, i, &model);
            let mn_p: ptr = PTR_NULL();
            let mn_l: u64 = 0;
            let has_mn: bool = ps_field_str(model, STR_PTR("model_name"), STR_LEN("model_name"), &mn_p, &mn_l);
            let mn = PsText { bytes: [0; 65536], len: 0 };
            if has_mn { ps_append(&mn, mn_p, mn_l); };
            if insert_model != 0 && has_mn {
                ps_reset(insert_model);
                ps_bind_text(insert_model, 1, ps_text_ptr(&pid), pid.len);
                ps_bind_text(insert_model, 2, ps_text_ptr(&mn), mn.len);
                let ip: ptr = PTR_NULL();
                let il: u64 = 0;
                let has_icon: bool = ps_field_str(model, STR_PTR("icon"), STR_LEN("icon"), &ip, &il);
                ps_bind_text_or_null(insert_model, 3, has_icon, ip, il);
                let vid: f64 = 0.0;
                if ps_field_number(model, STR_PTR("vendor_id"), STR_LEN("vendor_id"), &vid) {
                    ps_bind_int(insert_model, 4, vid as i64);
                } else {
                    ps_bind_null(insert_model, 4);
                };
                let qt: f64 = 0.0;
                if ps_field_number(model, STR_PTR("quota_type"), STR_LEN("quota_type"), &qt) {
                    ps_bind_int(insert_model, 5, qt as i64);
                } else {
                    ps_bind_int(insert_model, 5, 0);
                };
                ps_bind_num_or_null(insert_model, 6, ps_jget(model, STR_PTR("model_ratio"), STR_LEN("model_ratio")));
                ps_bind_num_or_null(insert_model, 7, ps_jget(model, STR_PTR("model_price"), STR_LEN("model_price")));
                ps_bind_num_or_null(insert_model, 8, ps_jget(model, STR_PTR("completion_ratio"), STR_LEN("completion_ratio")));
                ps_bind_num_or_null(insert_model, 9, ps_jget(model, STR_PTR("cache_ratio"), STR_LEN("cache_ratio")));
                ps_bind_num_or_null(insert_model, 10, ps_jget(model, STR_PTR("create_cache_ratio"), STR_LEN("create_cache_ratio")));
                let op: ptr = PTR_NULL();
                let ol: u64 = 0;
                let has_owner: bool = ps_field_str(model, STR_PTR("owner_by"), STR_LEN("owner_by"), &op, &ol);
                ps_bind_text_or_null(insert_model, 11, has_owner, op, ol);
                ps_bind_json_or(insert_model, 12, ps_jget(model, STR_PTR("extensions"), STR_LEN("extensions")), STR_PTR("{}"), STR_LEN("{}"));
                ps_step_once(insert_model);
            };
            let egs: u64 = ps_jget(model, STR_PTR("enable_groups"), STR_LEN("enable_groups"));
            if insert_mgroup != 0 && egs != 0 && sa_json_kind(egs) == 6 {
                let ec: u64 = 0;
                let est: i32 = sa_json_value_count(egs, &ec);
                let j: u64 = 0;
                while j < ec {
                    let item: u64 = 0;
                    let gst: i32 = sa_json_array_get(egs, j, &item);
                    let gp: ptr = PTR_NULL();
                    let gl: u64 = 0;
                    if ps_jstr(item, &gp, &gl) {
                        ps_reset(insert_mgroup);
                        ps_bind_text(insert_mgroup, 1, ps_text_ptr(&pid), pid.len);
                        ps_bind_text(insert_mgroup, 2, ps_text_ptr(&mn), mn.len);
                        ps_bind_text(insert_mgroup, 3, gp, gl);
                        ps_step_once(insert_mgroup);
                    };
                    j = j + 1;
                }
            };
            let sets: u64 = ps_jget(model, STR_PTR("supported_endpoint_types"), STR_LEN("supported_endpoint_types"));
            if insert_mendpoint != 0 && sets != 0 && sa_json_kind(sets) == 6 {
                let ec: u64 = 0;
                let est: i32 = sa_json_value_count(sets, &ec);
                let j: u64 = 0;
                while j < ec {
                    let item: u64 = 0;
                    let gst: i32 = sa_json_array_get(sets, j, &item);
                    let gp: ptr = PTR_NULL();
                    let gl: u64 = 0;
                    if ps_jstr(item, &gp, &gl) {
                        ps_reset(insert_mendpoint);
                        ps_bind_text(insert_mendpoint, 1, ps_text_ptr(&pid), pid.len);
                        ps_bind_text(insert_mendpoint, 2, ps_text_ptr(&mn), mn.len);
                        ps_bind_text(insert_mendpoint, 3, gp, gl);
                        ps_step_once(insert_mendpoint);
                    };
                    j = j + 1;
                }
            };
            i = i + 1;
        }
    };
    if insert_model != 0 { ps_finalize(insert_model); };
    if insert_mgroup != 0 { ps_finalize(insert_mgroup); };
    if insert_mendpoint != 0 { ps_finalize(insert_mendpoint); };
    // supported endpoints (object entries)
    let endpoints: u64 = ps_jget(catalog, STR_PTR("supported_endpoint"), STR_LEN("supported_endpoint"));
    let insert_endpoint: u64 = ps_prepare(s.db, STR_PTR("INSERT INTO relay_supported_endpoints (provider_id, endpoint_type, path, method, canonical_endpoint_type, aliases_json, extensions_json) VALUES (?, ?, ?, ?, ?, ?, ?)"), STR_LEN("INSERT INTO relay_supported_endpoints (provider_id, endpoint_type, path, method, canonical_endpoint_type, aliases_json, extensions_json) VALUES (?, ?, ?, ?, ?, ?, ?)"));
    if insert_endpoint != 0 && endpoints != 0 && sa_json_kind(endpoints) == 7 {
        let c: u64 = 0;
        let st: i32 = sa_json_value_count(endpoints, &c);
        let i: u64 = 0;
        while i < c {
            let kp: ptr = PTR_NULL();
            let kl: u64 = 0;
            let kst: i32 = sa_json_object_key_at(endpoints, i, &kp, &kl);
            if kst == 0 {
                let type_name = PsText { bytes: [0; 65536], len: 0 };
                ps_append(&type_name, kp, kl);
                let ep: u64 = ps_jget(endpoints, kp, kl);
                ps_reset(insert_endpoint);
                ps_bind_text(insert_endpoint, 1, ps_text_ptr(&pid), pid.len);
                ps_bind_text(insert_endpoint, 2, ps_text_ptr(&type_name), type_name.len);
                let pp: ptr = PTR_NULL();
                let pl: u64 = 0;
                let has_path: bool = ps_field_str(ep, STR_PTR("path"), STR_LEN("path"), &pp, &pl);
                ps_bind_text_or_null(insert_endpoint, 3, has_path, pp, pl);
                let mp: ptr = PTR_NULL();
                let ml: u64 = 0;
                let has_method: bool = ps_field_str(ep, STR_PTR("method"), STR_LEN("method"), &mp, &ml);
                ps_bind_text_or_null(insert_endpoint, 4, has_method, mp, ml);
                ps_bind_text(insert_endpoint, 5, ps_text_ptr(&type_name), type_name.len);
                ps_bind_json_or(insert_endpoint, 6, ps_jget(ep, STR_PTR("aliases"), STR_LEN("aliases")), STR_PTR("[]"), STR_LEN("[]"));
                ps_bind_json_or(insert_endpoint, 7, ps_jget(ep, STR_PTR("extensions"), STR_LEN("extensions")), STR_PTR("{}"), STR_LEN("{}"));
                ps_step_once(insert_endpoint);
            };
            i = i + 1;
        }
    };
    if insert_endpoint != 0 { ps_finalize(insert_endpoint); };
    // vendors
    let vendors: u64 = ps_jget(catalog, STR_PTR("vendors"), STR_LEN("vendors"));
    let insert_vendor: u64 = ps_prepare(s.db, STR_PTR("INSERT INTO relay_vendors (provider_id, vendor_id, name, icon, extensions_json) VALUES (?, ?, ?, ?, ?)"), STR_LEN("INSERT INTO relay_vendors (provider_id, vendor_id, name, icon, extensions_json) VALUES (?, ?, ?, ?, ?)"));
    if insert_vendor != 0 && vendors != 0 && sa_json_kind(vendors) == 6 {
        let c: u64 = 0;
        let st: i32 = sa_json_value_count(vendors, &c);
        let i: u64 = 0;
        while i < c {
            let vendor: u64 = 0;
            let ast: i32 = sa_json_array_get(vendors, i, &vendor);
            ps_reset(insert_vendor);
            ps_bind_text(insert_vendor, 1, ps_text_ptr(&pid), pid.len);
            let vid: f64 = 0.0;
            if ps_field_number(vendor, STR_PTR("id"), STR_LEN("id"), &vid) {
                ps_bind_int(insert_vendor, 2, vid as i64);
            } else {
                ps_bind_int(insert_vendor, 2, 0);
            };
            let np: ptr = PTR_NULL();
            let nl: u64 = 0;
            let has_name: bool = ps_field_str(vendor, STR_PTR("name"), STR_LEN("name"), &np, &nl);
            ps_bind_text_or_null(insert_vendor, 3, has_name, np, nl);
            let ip: ptr = PTR_NULL();
            let il: u64 = 0;
            let has_icon: bool = ps_field_str(vendor, STR_PTR("icon"), STR_LEN("icon"), &ip, &il);
            ps_bind_text_or_null(insert_vendor, 4, has_icon, ip, il);
            ps_bind_json_or(insert_vendor, 5, ps_jget(vendor, STR_PTR("extensions"), STR_LEN("extensions")), STR_PTR("{}"), STR_LEN("{}"));
            ps_step_once(insert_vendor);
            i = i + 1;
        }
    };
    if insert_vendor != 0 { ps_finalize(insert_vendor); };
    // auto groups
    let insert_auto: u64 = ps_prepare(s.db, STR_PTR("INSERT INTO relay_auto_groups (provider_id, group_name) VALUES (?, ?)"), STR_LEN("INSERT INTO relay_auto_groups (provider_id, group_name) VALUES (?, ?)"));
    if insert_auto != 0 && autos != 0 && sa_json_kind(autos) == 6 {
        let c: u64 = 0;
        let st: i32 = sa_json_value_count(autos, &c);
        let i: u64 = 0;
        while i < c {
            let item: u64 = 0;
            let ast: i32 = sa_json_array_get(autos, i, &item);
            let gp: ptr = PTR_NULL();
            let gl: u64 = 0;
            if ps_jstr(item, &gp, &gl) {
                ps_reset(insert_auto);
                ps_bind_text(insert_auto, 1, ps_text_ptr(&pid), pid.len);
                ps_bind_text(insert_auto, 2, gp, gl);
                ps_step_once(insert_auto);
            };
            i = i + 1;
        }
    };
    if insert_auto != 0 { ps_finalize(insert_auto); };
}

fn ps_count_rows(s: &ProviderStore, sql_ptr: ptr, sql_len: u64, out_count: &i64) -> void {
    *out_count = 0;
    let stmt: u64 = ps_prepare(s.db, sql_ptr, sql_len);
    if stmt == 0 { return; };
    let doc: u64 = 0;
    if ps_step_row(stmt, &doc) {
        let cnt: f64 = 0.0;
        let has: bool = false;
        let kp: ptr = PTR_NULL();
        let kl: u64 = 0;
        let c: u64 = 0;
        let st: i32 = sa_json_value_count(doc, &c);
        if c > 0 {
            let kst: i32 = sa_json_object_key_at(doc, 0, &kp, &kl);
            if kst == 0 {
                has = ps_field_num(doc, kp, kl, &cnt);
            };
        };
        if has { *out_count = cnt as i64; };
        let f: i32 = sa_json_free(doc);
    };
    ps_finalize(stmt);
}

fn ProviderStore_write(s: &ProviderStore, store: &StoreShape) -> i32 {
    if s.db == 0 {
        return ps_throw(STR_PTR("Provider store database is unavailable"), STR_LEN("Provider store database is unavailable"));
    };
    let providers: u64 = 0;
    if !ps_store_providers(store, &providers) {
        return ps_throw(STR_PTR("Provider store payload is not valid JSON"), STR_LEN("Provider store payload is not valid JSON"));
    };
    let now: i64 = ps_now_ms();
    ps_run(s.db, STR_PTR("BEGIN"), STR_LEN("BEGIN"));
    ProviderStore_clearCapabilityCatalogTables(s);
    ps_run(s.db, STR_PTR("DELETE FROM relay_groups"), STR_LEN("DELETE FROM relay_groups"));
    ps_run(s.db, STR_PTR("DELETE FROM providers"), STR_LEN("DELETE FROM providers"));
    let insert_provider: u64 = ps_prepare(s.db, STR_PTR("INSERT INTO providers (id, payload, created_at, updated_at) VALUES (?, ?, ?, ?)"), STR_LEN("INSERT INTO providers (id, payload, created_at, updated_at) VALUES (?, ?, ?, ?)"));
    let insert_group: u64 = ps_prepare(s.db, STR_PTR("INSERT INTO relay_groups (provider_id, group_id, name, base_url, kind, status, group_ratio, quota_usd, used_quota_usd, priority, weight, key_mode, response_protocol, response_protocol_mode, endpoint_path_override, auth_type, credential_mode, catalog_group_name, catalog_managed, keys_json, models_json, model_capabilities_json, supported_endpoint_types_json, image_json, model_mapping_json, status_code_mapping_json, advanced_model_mapping_json, tag, remark, auto_ban, request_limit, request_interval_seconds, context_window, enable_fallback, fallback_channel_id, fallback_group_name, enable_tiered_context, tiered_context_ratios_json, sort_order, created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)"), STR_LEN("INSERT INTO relay_groups (provider_id, group_id, name, base_url, kind, status, group_ratio, quota_usd, used_quota_usd, priority, weight, key_mode, response_protocol, response_protocol_mode, endpoint_path_override, auth_type, credential_mode, catalog_group_name, catalog_managed, keys_json, models_json, model_capabilities_json, supported_endpoint_types_json, image_json, model_mapping_json, status_code_mapping_json, advanced_model_mapping_json, tag, remark, auto_ban, request_limit, request_interval_seconds, context_window, enable_fallback, fallback_channel_id, fallback_group_name, enable_tiered_context, tiered_context_ratios_json, sort_order, created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)"));
    if insert_provider == 0 || insert_group == 0 {
        if insert_provider != 0 { ps_finalize(insert_provider); };
        if insert_group != 0 { ps_finalize(insert_group); };
        ps_run(s.db, STR_PTR("ROLLBACK"), STR_LEN("ROLLBACK"));
        let f: i32 = sa_json_free(providers);
        return ps_throw(STR_PTR("Failed to prepare provider write statements"), STR_LEN("Failed to prepare provider write statements"));
    };
    let count: u64 = 0;
    let cst: i32 = sa_json_value_count(providers, &count);
    let i: u64 = 0;
    while i < count {
        let raw: u64 = 0;
        let ast: i32 = sa_json_array_get(providers, i, &raw);
        let provider: u64 = 0;
        normalizeProviderTopology(raw, &provider);
        if provider != 0 {
            let id_p: ptr = PTR_NULL();
            let id_l: u64 = 0;
            ps_field_str(provider, STR_PTR("id"), STR_LEN("id"), &id_p, &id_l);
            let payload = PsText { bytes: [0; 65536], len: 0 };
            ps_stringify(provider, &payload);
            let created: i64 = now;
            let cv: f64 = 0.0;
            if ps_field_number(provider, STR_PTR("createdAt"), STR_LEN("createdAt"), &cv) { created = cv as i64; };
            let updated: i64 = now;
            if ps_field_number(provider, STR_PTR("updatedAt"), STR_LEN("updatedAt"), &cv) { updated = cv as i64; };
            ps_reset(insert_provider);
            ps_bind_text(insert_provider, 1, id_p, id_l);
            ps_bind_text(insert_provider, 2, ps_text_ptr(&payload), payload.len);
            ps_bind_int(insert_provider, 3, created);
            ps_bind_int(insert_provider, 4, updated);
            ps_step_once(insert_provider);
            ProviderStore_insertRelayGroups(s, insert_group, provider);
            ProviderStore_insertCapabilityCatalog(s, provider);
            let f: i32 = sa_json_free(provider);
        };
        i = i + 1;
    }
    ps_finalize(insert_provider);
    ps_finalize(insert_group);
    ps_run(s.db, STR_PTR("COMMIT"), STR_LEN("COMMIT"));
    let f: i32 = sa_json_free(providers);
    return 0;
}

fn ProviderStore_migrateRelayGroupsFromPayloads(s: &ProviderStore) -> void {
    if s.db == 0 { return; };
    let count: i64 = 0;
    ps_count_rows(s, STR_PTR("SELECT COUNT(*) AS count FROM relay_groups"), STR_LEN("SELECT COUNT(*) AS count FROM relay_groups"), &count);
    if count > 0 { return; };
    let providers: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    if providers == 0 { return; };
    let stmt: u64 = ps_prepare(s.db, STR_PTR("SELECT payload FROM providers ORDER BY created_at ASC, id ASC"), STR_LEN("SELECT payload FROM providers ORDER BY created_at ASC, id ASC"));
    if stmt != 0 {
        let guard: u64 = 0;
        while guard < 100000 {
            guard = guard + 1;
            let doc: u64 = 0;
            if !ps_step_row(stmt, &doc) { break; };
            let pay_p: ptr = PTR_NULL();
            let pay_l: u64 = 0;
            let has_pay: bool = ps_field_str(doc, STR_PTR("payload"), STR_LEN("payload"), &pay_p, &pay_l);
            let parsed: u64 = 0;
            let ok: bool = false;
            if has_pay { ok = parseProvider(pay_p, pay_l, &parsed); };
            let f: i32 = sa_json_free(doc);
            if ok {
                let pst: i32 = sa_json_array_push_node(providers, parsed);
            };
        }
        ps_finalize(stmt);
    };
    let any_groups: bool = false;
    let c: u64 = 0;
    let cst: i32 = sa_json_value_count(providers, &c);
    let i: u64 = 0;
    while i < c {
        let p: u64 = 0;
        let ast: i32 = sa_json_array_get(providers, i, &p);
        let g: u64 = ps_jget(p, STR_PTR("groups"), STR_LEN("groups"));
        if g != 0 && sa_json_kind(g) == 6 {
            let gc: u64 = 0;
            let gst: i32 = sa_json_value_count(g, &gc);
            if gc > 0 { any_groups = true; };
        };
        i = i + 1;
    }
    if !any_groups {
        let f: i32 = sa_json_free(providers);
        return;
    };
    let insert_group: u64 = ps_prepare(s.db, STR_PTR("INSERT OR REPLACE INTO relay_groups (provider_id, group_id, name, base_url, kind, status, group_ratio, quota_usd, used_quota_usd, priority, weight, key_mode, response_protocol, response_protocol_mode, endpoint_path_override, auth_type, credential_mode, catalog_group_name, catalog_managed, keys_json, models_json, model_capabilities_json, supported_endpoint_types_json, image_json, model_mapping_json, status_code_mapping_json, advanced_model_mapping_json, tag, remark, auto_ban, request_limit, request_interval_seconds, context_window, enable_fallback, fallback_channel_id, fallback_group_name, enable_tiered_context, tiered_context_ratios_json, sort_order, created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)"), STR_LEN("INSERT OR REPLACE INTO relay_groups (provider_id, group_id, name, base_url, kind, status, group_ratio, quota_usd, used_quota_usd, priority, weight, key_mode, response_protocol, response_protocol_mode, endpoint_path_override, auth_type, credential_mode, catalog_group_name, catalog_managed, keys_json, models_json, model_capabilities_json, supported_endpoint_types_json, image_json, model_mapping_json, status_code_mapping_json, advanced_model_mapping_json, tag, remark, auto_ban, request_limit, request_interval_seconds, context_window, enable_fallback, fallback_channel_id, fallback_group_name, enable_tiered_context, tiered_context_ratios_json, sort_order, created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)"));
    if insert_group == 0 {
        let f: i32 = sa_json_free(providers);
        return;
    };
    ps_run(s.db, STR_PTR("BEGIN"), STR_LEN("BEGIN"));
    let j: u64 = 0;
    while j < c {
        let p: u64 = 0;
        let ast: i32 = sa_json_array_get(providers, j, &p);
        ProviderStore_insertRelayGroups(s, insert_group, p);
        ProviderStore_insertCapabilityCatalog(s, p);
        j = j + 1;
    }
    ps_run(s.db, STR_PTR("COMMIT"), STR_LEN("COMMIT"));
    ps_finalize(insert_group);
    let f: i32 = sa_json_free(providers);
}

fn ProviderStore_migrateLegacyProviders(s: &ProviderStore) -> i32 {
    let count: i64 = 0;
    ps_count_rows(s, STR_PTR("SELECT COUNT(*) AS count FROM providers"), STR_LEN("SELECT COUNT(*) AS count FROM providers"), &count);
    if count > 0 { return 0; };
    let file_p: ptr = PTR_NULL();
    PTR_BYTE_ADD(file_p, &s.file, 0);
    let flen: u64 = 0;
    if sa_std_fs_len(file_p, s.file_len, &flen) != 0 || flen == 0 || flen > 4194304 { return 0; };
    let handle: u64 = 0;
    if sa_std_fs_read_file(file_p, s.file_len, flen, &handle) != 0 || handle == 0 { return 0; };
    let bp: ptr = sa_fs_read_buffer_data(handle);
    let bl: u64 = sa_fs_read_buffer_len(handle);
    let parsed: u64 = sa_json_parse(bp, bl);
    let providers: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    if parsed != 0 && sa_json_kind(parsed) == 6 && providers != 0 {
        let c: u64 = 0;
        let cst: i32 = sa_json_value_count(parsed, &c);
        let i: u64 = 0;
        while i < c {
            let item: u64 = 0;
            let ast: i32 = sa_json_array_get(parsed, i, &item);
            let normalized: u64 = 0;
            if normalizeProvider(item, &normalized) {
                let pst: i32 = sa_json_array_push_node(providers, normalized);
            };
            i = i + 1;
        }
    };
    if parsed != 0 { let f: i32 = sa_json_free(parsed); };
    let f2: i32 = sa_fs_read_buffer_free(handle);
    let pc: u64 = 0;
    if providers != 0 {
        let cst: i32 = sa_json_value_count(providers, &pc);
    };
    if pc == 0 {
        if providers != 0 { let f: i32 = sa_json_free(providers); };
        return 0;
    };
    let shape = StoreShape { providers_json: [0; 1048576], providers_len: 0 };
    ps_shape_from_providers(providers, &shape);
    let wst: i32 = ProviderStore_write(s, &shape);
    let f3: i32 = sa_json_free(providers);
    return 0;
}

// ---- store construction + initialization ----
fn ProviderStore_new(out: &ProviderStore, database: u64, has_database: bool) -> void {
    let dir = PsPath { bytes: [0; 4096], len: 0 };
    ps_data_dir(&dir);
    let dn: u64 = dir.len;
    if dn > 512 { dn = 512; };
    let i: u64 = 0;
    while i < dn {
        out.dir[i] = dir.bytes[i];
        i = i + 1;
    }
    out.dir_len = dn;
    let joined = PsPath { bytes: [0; 4096], len: 0 };
    ps_path_join2(ps_path_ptr(&dir), dir.len, STR_PTR("providers.json"), STR_LEN("providers.json"), &joined);
    let fn_: u64 = joined.len;
    if fn_ > 640 { fn_ = 640; };
    let j: u64 = 0;
    while j < fn_ {
        out.file[j] = joined.bytes[j];
        j = j + 1;
    }
    out.file_len = fn_;
    if has_database {
        out.db = database;
    } else {
        out.db = 0;
    };
    out.memorySecrets = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    out.transientProviders = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    out.transientOnlyProviderIds = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    if out.db != 0 {
        ProviderStore_ensureSchema(out);
        ProviderStore_migrateRelayGroupsFromPayloads(out);
    };
}

// reads the store and returns the provider array doc (caller frees)
fn ps_read_array(s: &ProviderStore) -> u64 {
    let shape = StoreShape { providers_json: [0; 1048576], providers_len: 0 };
    ProviderStore_read(s, &shape);
    let doc: u64 = 0;
    ps_store_providers(&shape, &doc);
    if doc == 0 {
        doc = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    };
    return doc;
}

fn ps_shape_write(s: &ProviderStore, providers: u64) -> i32 {
    let shape = StoreShape { providers_json: [0; 1048576], providers_len: 0 };
    ps_shape_from_providers(providers, &shape);
    return ProviderStore_write(s, &shape);
}

fn ps_find_by_id(providers: u64, id_p: ptr, id_l: u64, out_json: &u64) -> bool {
    *out_json = 0;
    if providers == 0 || sa_json_kind(providers) != 6 { return false; };
    let c: u64 = 0;
    let st: i32 = sa_json_value_count(providers, &c);
    let i: u64 = 0;
    while i < c {
        let p: u64 = 0;
        let ast: i32 = sa_json_array_get(providers, i, &p);
        let pp: ptr = PTR_NULL();
        let pl: u64 = 0;
        if ps_field_str(p, STR_PTR("id"), STR_LEN("id"), &pp, &pl) {
            if ps_eq(pp, pl, id_p, id_l) {
                *out_json = p;
                return true;
            };
        };
        i = i + 1;
    }
    return false;
}

fn ps_filtered_without(providers: u64, id_p: ptr, id_l: u64) -> u64 {
    let out: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    if out == 0 || providers == 0 { return out; };
    let c: u64 = 0;
    let st: i32 = sa_json_value_count(providers, &c);
    let i: u64 = 0;
    while i < c {
        let p: u64 = 0;
        let ast: i32 = sa_json_array_get(providers, i, &p);
        let pp: ptr = PTR_NULL();
        let pl: u64 = 0;
        let has: bool = ps_field_str(p, STR_PTR("id"), STR_LEN("id"), &pp, &pl);
        let skip: bool = false;
        if has {
            skip = ps_eq(pp, pl, id_p, id_l);
        };
        if !skip {
            let pst: i32 = sa_json_array_push_node(out, ps_clone(p));
        };
        i = i + 1;
    }
    return out;
}

fn ps_registry_get(registry: u64, id_p: ptr, id_l: u64, out_json: &u64) -> bool {
    *out_json = 0;
    if registry == 0 { return false; };
    let v: u64 = ps_jget(registry, id_p, id_l);
    if v == 0 { return false; };
    *out_json = v;
    return true;
}

fn ps_registry_set(registry: u64, id_p: ptr, id_l: u64, value: u64) -> void {
    if registry == 0 { return; };
    let st: i32 = sa_json_object_set_node(registry, id_p, id_l, value);
}

fn ps_registry_delete(registry: u64, id_p: ptr, id_l: u64) -> bool {
    if registry == 0 { return false; };
    let st: i32 = sa_json_object_remove(registry, id_p, id_l);
    return st == 0;
}

fn ps_registry_mem(registry: u64, id_p: ptr, id_l: u64) -> bool {
    if registry == 0 { return false; };
    return ps_jget(registry, id_p, id_l) != 0;
}

fn ProviderStore_initialize(s: &ProviderStore) -> i32 {
    let mig: i32 = ProviderStore_migrateLegacyProviders(s);
    let providers: u64 = ps_read_array(s);
    let valid: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    let changed: bool = false;
    let groups_map: u64 = 0;
    let count: u64 = 0;
    if providers != 0 {
        let cst: i32 = sa_json_value_count(providers, &count);
    };
    let idx: u64 = 0;
    while idx < count {
        let provider: u64 = 0;
        let ast: i32 = sa_json_array_get(providers, idx, &provider);
        let id_p: ptr = PTR_NULL();
        let id_l: u64 = 0;
        if !ps_field_str(provider, STR_PTR("id"), STR_LEN("id"), &id_p, &id_l) {
            idx = idx + 1;
            continue;
        };
        let id = PsText { bytes: [0; 65536], len: 0 };
        ps_append(&id, id_p, id_l);
        // persistedGroups = readRelayGroups().get(id) ?? []
        ProviderStore_readRelayGroups(s, &groups_map);
        let persisted: u64 = ps_jget(groups_map, ps_text_ptr(&id), id.len);
        if !relayGroupTopologyMatches(ps_jget(provider, STR_PTR("groups"), STR_LEN("groups")), persisted) {
            changed = true;
        };
        let key_p: ptr = PTR_NULL();
        let key_l: u64 = 0;
        ProviderStore_readPersistedProviderKey(s, ps_text_ptr(&id), id.len, &key_p, &key_l);
        let key = PsText { bytes: [0; 65536], len: 0 };
        ps_append(&key, key_p, key_l);
        let grouped_raw: u64 = 0;
        ensureDefaultRelayGroup(provider, ps_text_ptr(&key), key.len, &grouped_raw);
        // working copy always owned by this loop iteration (the
        // ensure step may return the read() member itself)
        let grouped: u64 = grouped_raw;
        if grouped == provider || grouped == 0 { grouped = ps_clone(provider); };
        let catalog: u64 = ps_jget(grouped, STR_PTR("capabilityCatalog"), STR_LEN("capabilityCatalog"));
        if catalog != 0 {
            let groups_node: u64 = ps_jget(grouped, STR_PTR("groups"), STR_LEN("groups"));
            let groups_text = PsText { bytes: [0; 65536], len: 0 };
            if groups_node != 0 {
                let sg1: bool = ps_stringify(groups_node, &groups_text);
            } else {
                ps_append(&groups_text, STR_PTR("[]"), STR_LEN("[]"));
            };
            let cat_text = PsText { bytes: [0; 65536], len: 0 };
            ps_stringify(catalog, &cat_text);
            let rec_text = PsText { bytes: [0; 65536], len: 0 };
            let rec_len: u64 = 0;
            let rp: ptr = ps_text_ptr(&rec_text);
            let code: i32 = reconcileRequiredImageCatalogGroups(ps_text_ptr(&groups_text), groups_text.len, ps_text_ptr(&cat_text), cat_text.len, rp, &rec_len);
            if rec_len > 0 {
                let after: u64 = sa_json_parse(rp, rec_len);
                let same: bool = false;
                if groups_node != 0 {
                    same = ps_text_eq_json(groups_node, after);
                } else {
                    if after != 0 && sa_json_kind(after) == 6 {
                        let ac: u64 = 0;
                        let ast2: i32 = sa_json_value_count(after, &ac);
                        same = ac == 0;
                    };
                };
                if after != 0 && !same {
                    let st2: i32 = sa_json_object_set_node(grouped, STR_PTR("groups"), STR_LEN("groups"), after);
                    let now: i64 = ps_now_ms();
                    let sst: i32 = sa_json_object_set_f64(grouped, STR_PTR("updatedAt"), STR_LEN("updatedAt"), now as f64);
                    changed = true;
                } else {
                    if after != 0 { let f: i32 = sa_json_free(after); };
                };
            };
        };
        if !hasValidRelayGroups(grouped) {
            changed = true;
            let d1: bool = ps_registry_delete(s.memorySecrets, ps_text_ptr(&id), id.len);
            ProviderStore_deletePersistedProviderKey(s, ps_text_ptr(&id), id.len);
            let fw: i32 = sa_json_free(grouped);
            idx = idx + 1;
            continue;
        };
        if valid != 0 {
            let pst: i32 = sa_json_array_push_node(valid, grouped);
        };
        if key.len > 0 {
            let secret_node: u64 = 0;
            ps_str_node(ps_text_ptr(&key), key.len, &secret_node);
            if secret_node != 0 { ps_registry_set(s.memorySecrets, ps_text_ptr(&id), id.len, secret_node); };
            let storage_p: ptr = PTR_NULL();
            let storage_l: u64 = 0;
            let has_storage: bool = ps_field_sv(grouped, STR_PTR("apiKeyStorage"), STR_LEN("apiKeyStorage"), &storage_p, &storage_l);
            let is_db: bool = false;
            if has_storage { is_db = ps_eq(storage_p, storage_l, STR_PTR("database"), STR_LEN("database")); };
            if !is_db {
                ps_set_text(grouped, STR_PTR("apiKeyStorage"), STR_LEN("apiKeyStorage"), STR_PTR("database"), STR_LEN("database"));
                changed = true;
            };
            idx = idx + 1;
            continue;
        };
        let api_ref: u64 = ps_jget(grouped, STR_PTR("apiKeyRef"), STR_LEN("apiKeyRef"));
        if api_ref == 0 {
            let storage_p: ptr = PTR_NULL();
            let storage_l: u64 = 0;
            let has_storage: bool = ps_field_sv(grouped, STR_PTR("apiKeyStorage"), STR_LEN("apiKeyStorage"), &storage_p, &storage_l);
            let is_none: bool = false;
            if has_storage { is_none = ps_eq(storage_p, storage_l, STR_PTR("none"), STR_LEN("none")); };
            if !is_none {
                ps_set_text(grouped, STR_PTR("apiKeyStorage"), STR_LEN("apiKeyStorage"), STR_PTR("none"), STR_LEN("none"));
                changed = true;
            };
            idx = idx + 1;
            continue;
        };
        let entry: u64 = 0;
        let has_entry: bool = keyringEntry(ps_text_ptr(&id), id.len, &entry);
        if !has_entry {
            let storage_p: ptr = PTR_NULL();
            let storage_l: u64 = 0;
            let has_storage: bool = ps_field_sv(grouped, STR_PTR("apiKeyStorage"), STR_LEN("apiKeyStorage"), &storage_p, &storage_l);
            let is_memory: bool = false;
            if has_storage { is_memory = ps_eq(storage_p, storage_l, STR_PTR("memory"), STR_LEN("memory")); };
            if !is_memory {
                ps_set_text(grouped, STR_PTR("apiKeyStorage"), STR_LEN("apiKeyStorage"), STR_PTR("memory"), STR_LEN("memory"));
                changed = true;
            };
            idx = idx + 1;
            continue;
        };
        if entry != 0 { let kf: i32 = sa_json_free(entry); };
        // keyring get: status 0 = secret, 3 = missing entry (null
        // path), any other status = the TS catch path
        let ktext = PsText { bytes: [0; 65536], len: 0 };
        let kst: i32 = ps_keyring_get(ps_text_ptr(&id), id.len, &ktext);
        if kst != 0 && kst != 3 {
            ps_set_text(grouped, STR_PTR("apiKeyStorage"), STR_LEN("apiKeyStorage"), STR_PTR("memory"), STR_LEN("memory"));
            changed = true;
            idx = idx + 1;
            continue;
        };
        if kst == 0 && ktext.len > 0 {
            let secret_node: u64 = 0;
            ps_str_node(ps_text_ptr(&ktext), ktext.len, &secret_node);
            if secret_node != 0 { ps_registry_set(s.memorySecrets, ps_text_ptr(&id), id.len, secret_node); };
            let storage_p: ptr = PTR_NULL();
            let storage_l: u64 = 0;
            let has_storage: bool = ps_field_sv(grouped, STR_PTR("apiKeyStorage"), STR_LEN("apiKeyStorage"), &storage_p, &storage_l);
            let is_keyring: bool = false;
            if has_storage { is_keyring = ps_eq(storage_p, storage_l, STR_PTR("keyring"), STR_LEN("keyring")); };
            if !is_keyring {
                ps_set_text(grouped, STR_PTR("apiKeyStorage"), STR_LEN("apiKeyStorage"), STR_PTR("keyring"), STR_LEN("keyring"));
                changed = true;
            };
        } else {
            let storage_p: ptr = PTR_NULL();
            let storage_l: u64 = 0;
            let has_storage: bool = ps_field_sv(grouped, STR_PTR("apiKeyStorage"), STR_LEN("apiKeyStorage"), &storage_p, &storage_l);
            let is_memory: bool = false;
            if has_storage { is_memory = ps_eq(storage_p, storage_l, STR_PTR("memory"), STR_LEN("memory")); };
            if !is_memory {
                ps_set_text(grouped, STR_PTR("apiKeyStorage"), STR_LEN("apiKeyStorage"), STR_PTR("memory"), STR_LEN("memory"));
                changed = true;
            };
        };
        idx = idx + 1;
    }
    if groups_map != 0 { let f: i32 = sa_json_free(groups_map); };
    if changed {
        let wst: i32 = ps_shape_write(s, valid);
    };
    if providers != 0 { let f: i32 = sa_json_free(providers); };
    if valid != 0 { let f: i32 = sa_json_free(valid); };
    return 0;
}

// ---- public API ----
fn ps_is_trashed(p: u64) -> bool {
    let t: u64 = ps_jget(p, STR_PTR("trashedAt"), STR_LEN("trashedAt"));
    if t == 0 { return false; };
    let k: u64 = sa_json_kind(t);
    if k == 0 { return false; };
    if k == 1 {
        let b: u64 = 0;
        let st: i32 = sa_json_as_bool(t, &b);
        return b != 0;
    };
    if k == 2 || k == 3 || k == 4 {
        let v: f64 = 0.0;
        if numberValue(t, &v) { return v != 0.0; };
        return true;
    };
    return true;
}

fn ProviderStore_list(s: &ProviderStore, out_json: &u64) -> i32 {
    let persisted: u64 = ps_read_array(s);
    let result: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    *out_json = result;
    if persisted != 0 && result != 0 {
        let c: u64 = 0;
        let cst: i32 = sa_json_value_count(persisted, &c);
        let i: u64 = 0;
        while i < c {
            let p: u64 = 0;
            let ast: i32 = sa_json_array_get(persisted, i, &p);
            let id_p: ptr = PTR_NULL();
            let id_l: u64 = 0;
            let has_id: bool = ps_field_str(p, STR_PTR("id"), STR_LEN("id"), &id_p, &id_l);
            let in_transient: bool = false;
            if has_id { in_transient = ps_registry_mem(s.transientProviders, id_p, id_l); };
            if !ps_is_trashed(p) {
                if !in_transient {
                    let pst: i32 = sa_json_array_push_node(result, ps_clone(p));
                };
            };
            i = i + 1;
        }
    };
    if s.transientProviders != 0 && result != 0 {
        let c: u64 = 0;
        let cst: i32 = sa_json_value_count(s.transientProviders, &c);
        let i: u64 = 0;
        while i < c {
            let kp: ptr = PTR_NULL();
            let kl: u64 = 0;
            let kst: i32 = sa_json_object_key_at(s.transientProviders, i, &kp, &kl);
            if kst == 0 {
                let p: u64 = ps_jget(s.transientProviders, kp, kl);
                if p != 0 && !ps_is_trashed(p) {
                    let pst: i32 = sa_json_array_push_node(result, ps_clone(p));
                };
            };
            i = i + 1;
        }
    };
    if persisted != 0 { let f: i32 = sa_json_free(persisted); };
    return 0;
}

fn ProviderStore_listTrashed(s: &ProviderStore, out_json: &u64) -> i32 {
    let persisted: u64 = ps_read_array(s);
    let result: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    *out_json = result;
    if persisted != 0 && result != 0 {
        let c: u64 = 0;
        let cst: i32 = sa_json_value_count(persisted, &c);
        let i: u64 = 0;
        while i < c {
            let p: u64 = 0;
            let ast: i32 = sa_json_array_get(persisted, i, &p);
            if ps_is_trashed(p) {
                let pst: i32 = sa_json_array_push_node(result, ps_clone(p));
            };
            i = i + 1;
        }
    };
    if s.transientProviders != 0 && result != 0 {
        let c: u64 = 0;
        let cst: i32 = sa_json_value_count(s.transientProviders, &c);
        let i: u64 = 0;
        while i < c {
            let kp: ptr = PTR_NULL();
            let kl: u64 = 0;
            let kst: i32 = sa_json_object_key_at(s.transientProviders, i, &kp, &kl);
            if kst == 0 {
                let p: u64 = ps_jget(s.transientProviders, kp, kl);
                if p != 0 && ps_is_trashed(p) {
                    let pst: i32 = sa_json_array_push_node(result, ps_clone(p));
                };
            };
            i = i + 1;
        }
    };
    if persisted != 0 { let f: i32 = sa_json_free(persisted); };
    return 0;
}

fn ProviderStore_get(s: &ProviderStore, id_ptr: ptr, id_len: u64, out_json: &u64) -> i32 {
    *out_json = 0;
    let hit: u64 = 0;
    if ps_registry_get(s.transientProviders, id_ptr, id_len, &hit) {
        *out_json = ps_clone(hit);
        return 0;
    };
    let providers: u64 = ps_read_array(s);
    let found: u64 = 0;
    if ps_find_by_id(providers, id_ptr, id_len, &found) {
        *out_json = ps_clone(found);
        if providers != 0 { let f: i32 = sa_json_free(providers); };
        return 0;
    };
    if providers != 0 { let f: i32 = sa_json_free(providers); };
    return 1;
}

fn ProviderStore_saveTransient(s: &ProviderStore, provider_json: u64, out_json: &u64) -> i32 {
    *out_json = 0;
    let now: i64 = ps_now_ms();
    let topo: u64 = 0;
    normalizeProviderTopology(provider_json, &topo);
    let spread: u64 = ps_clone(topo);
    if spread == 0 {
        return ps_throw(STR_PTR("Invalid transient provider config"), STR_LEN("Invalid transient provider config"));
    };
    ps_set_text(spread, STR_PTR("apiKeyStorage"), STR_LEN("apiKeyStorage"), STR_PTR("none"), STR_LEN("none"));
    let created: f64 = 0.0;
    let has_created: bool = ps_field_number(provider_json, STR_PTR("createdAt"), STR_LEN("createdAt"), &created);
    if has_created && created != 0.0 {
        let st: i32 = sa_json_object_set_f64(spread, STR_PTR("createdAt"), STR_LEN("createdAt"), created);
    } else {
        let st: i32 = sa_json_object_set_f64(spread, STR_PTR("createdAt"), STR_LEN("createdAt"), now as f64);
    };
    let st2: i32 = sa_json_object_set_f64(spread, STR_PTR("updatedAt"), STR_LEN("updatedAt"), now as f64);
    let clean: u64 = 0;
    if !normalizeProvider(spread, &clean) {
        let f: i32 = sa_json_free(spread);
        return ps_throw(STR_PTR("Invalid transient provider config"), STR_LEN("Invalid transient provider config"));
    };
    let f: i32 = sa_json_free(spread);
    let vst: i32 = validateRelayGroupKeys(clean, false);
    if vst != 0 {
        let f2: i32 = sa_json_free(clean);
        return vst;
    };
    let id_p: ptr = PTR_NULL();
    let id_l: u64 = 0;
    ps_field_str(clean, STR_PTR("id"), STR_LEN("id"), &id_p, &id_l);
    let id = PsText { bytes: [0; 65536], len: 0 };
    ps_append(&id, id_p, id_l);
    ps_registry_set(s.transientProviders, ps_text_ptr(&id), id.len, ps_clone(clean));
    *out_json = clean;
    return 0;
}

fn ProviderStore_reserveTransient(s: &ProviderStore, id_ptr: ptr, id_len: u64) -> i32 {
    let lo: u64 = 0;
    let hi: u64 = 0;
    ps_trim_range(id_ptr, id_len, &lo, &hi);
    if hi <= lo {
        return ps_throw(STR_PTR("Transient provider id is required"), STR_LEN("Transient provider id is required"));
    };
    let seg: ptr = PTR_NULL();
    PTR_BYTE_ADD(seg, id_ptr, lo);
    let d: bool = ps_registry_delete(s.transientProviders, seg, hi - lo);
    let marker: u64 = sa_json_parse(STR_PTR("true"), STR_LEN("true"));
    if marker != 0 {
        ps_registry_set(s.transientOnlyProviderIds, seg, hi - lo, marker);
    };
    return 0;
}

fn ps_throw_not_found(prefix_ptr: ptr, prefix_len: u64, id_p: ptr, id_l: u64) -> i32 {
    let msg = PsText { bytes: [0; 65536], len: 0 };
    ps_append(&msg, prefix_ptr, prefix_len);
    ps_append(&msg, id_p, id_l);
    return ps_throw(ps_text_ptr(&msg), msg.len);
}

fn ProviderStore_save(s: &ProviderStore, provider_json: u64, apiKey_ptr: ptr, apiKey_len: u64, has_apiKey: bool, mergeInto_ptr: ptr, mergeInto_len: u64, has_mergeInto: bool, out_json: &u64) -> i32 {
    *out_json = 0;
    let input: u64 = provider_json;
    let req_p: ptr = PTR_NULL();
    let req_l: u64 = 0;
    let has_req: bool = ps_field_sv(input, STR_PTR("id"), STR_LEN("id"), &req_p, &req_l);
    let requested = PsText { bytes: [0; 65536], len: 0 };
    if has_req { ps_append(&requested, req_p, req_l); };
    let secret = PsText { bytes: [0; 65536], len: 0 };
    if has_apiKey { ps_append(&secret, apiKey_ptr, apiKey_len); };
    let has_secret: bool = secret.len > 0;
    let store: u64 = ps_read_array(s);
    let merge_target = PsText { bytes: [0; 65536], len: 0 };
    if has_mergeInto { ps_append(&merge_target, mergeInto_ptr, mergeInto_len); };
    let duplicate: u64 = 0;
    if merge_target.len > 0 {
        let fnd: bool = ps_find_by_id(store, ps_text_ptr(&merge_target), merge_target.len, &duplicate);
        if !fnd {
            let f: i32 = sa_json_free(store);
            return ps_throw_not_found(STR_PTR("Provider not found: "), STR_LEN("Provider not found: "), ps_text_ptr(&merge_target), merge_target.len);
        };
    } else {
        if requested.len == 0 {
            // find by case-insensitive trimmed name
            let name_p: ptr = PTR_NULL();
            let name_l: u64 = 0;
            let has_name: bool = ps_field_sv(input, STR_PTR("name"), STR_LEN("name"), &name_p, &name_l);
            if has_name && store != 0 {
                let c: u64 = 0;
                let cst: i32 = sa_json_value_count(store, &c);
                let i: u64 = 0;
                while i < c {
                    let p: u64 = 0;
                    let ast: i32 = sa_json_array_get(store, i, &p);
                    let np: ptr = PTR_NULL();
                    let nl: u64 = 0;
                    if ps_field_sv(p, STR_PTR("name"), STR_LEN("name"), &np, &nl) {
                        if ps_fold_eq(np, nl, name_p, name_l) { duplicate = p; };
                    };
                    i = i + 1;
                }
            };
        };
    };
    let id = PsText { bytes: [0; 65536], len: 0 };
    if duplicate != 0 {
        let dp: ptr = PTR_NULL();
        let dl: u64 = 0;
        ps_field_str(duplicate, STR_PTR("id"), STR_LEN("id"), &dp, &dl);
        ps_append(&id, dp, dl);
    } else {
        if requested.len > 0 {
            ps_append(&id, ps_text_ptr(&requested), requested.len);
        } else {
            let name_p: ptr = PTR_NULL();
            let name_l: u64 = 0;
            let has_name: bool = ps_field_sv(input, STR_PTR("name"), STR_LEN("name"), &name_p, &name_l);
            let name = PsText { bytes: [0; 65536], len: 0 };
            if has_name { ps_append(&name, name_p, name_l); };
            let gen_p: ptr = PTR_NULL();
            let gen_l: u64 = 0;
            providerIdFromName(ps_text_ptr(&name), name.len, &gen_p, &gen_l);
            ps_append(&id, gen_p, gen_l);
        };
    };
    if ps_registry_mem(s.transientOnlyProviderIds, ps_text_ptr(&id), id.len) {
        let spread: u64 = ps_clone(input);
        if spread != 0 {
            ps_set_text(spread, STR_PTR("id"), STR_LEN("id"), ps_text_ptr(&id), id.len);
        };
        let rst: i32 = ProviderStore_saveTransient(s, spread, out_json);
        if spread != 0 { let f: i32 = sa_json_free(spread); };
        let f2: i32 = sa_json_free(store);
        return rst;
    };
    let dtr: bool = ps_registry_delete(s.transientProviders, ps_text_ptr(&id), id.len);
    let now: i64 = ps_now_ms();
    let base: u64 = 0;
    if duplicate != 0 {
        mergeProviderGroups(duplicate, input, now as u64, &base);
    } else {
        base = ps_clone(input);
        if base != 0 {
            ps_set_text(base, STR_PTR("id"), STR_LEN("id"), ps_text_ptr(&id), id.len);
        };
    };
    if base == 0 {
        let f: i32 = sa_json_free(store);
        return ps_throw(STR_PTR("Invalid provider config"), STR_LEN("Invalid provider config"));
    };
    let vst: i32 = validateRelayGroupKeys(base, has_secret);
    if vst != 0 {
        let f: i32 = sa_json_free(base);
        let f2: i32 = sa_json_free(store);
        return vst;
    };
    let storage = PsText { bytes: [0; 65536], len: 0 };
    let st_p: ptr = PTR_NULL();
    let st_l: u64 = 0;
    if ps_field_sv(input, STR_PTR("apiKeyStorage"), STR_LEN("apiKeyStorage"), &st_p, &st_l) {
        ps_append(&storage, st_p, st_l);
    } else {
        if ps_jget(input, STR_PTR("apiKeyRef"), STR_LEN("apiKeyRef")) != 0 {
            ps_append(&storage, STR_PTR("memory"), STR_LEN("memory"));
        } else {
            ps_append(&storage, STR_PTR("none"), STR_LEN("none"));
        };
    };
    if has_secret {
        let secret_node: u64 = 0;
        ps_str_node(ps_text_ptr(&secret), secret.len, &secret_node);
        if secret_node != 0 { ps_registry_set(s.memorySecrets, ps_text_ptr(&id), id.len, secret_node); };
        storage.len = 0;
        ps_append(&storage, STR_PTR("database"), STR_LEN("database"));
    };
    let clean_in: u64 = ps_clone(base);
    if clean_in == 0 {
        let f: i32 = sa_json_free(base);
        let f2: i32 = sa_json_free(store);
        return ps_throw(STR_PTR("Invalid provider config"), STR_LEN("Invalid provider config"));
    };
    ps_set_text(clean_in, STR_PTR("id"), STR_LEN("id"), ps_text_ptr(&id), id.len);
    if has_secret {
        let ek_p: ptr = PTR_NULL();
        let ek_l: u64 = 0;
        envKeyForProvider(ps_text_ptr(&id), id.len, &ek_p, &ek_l);
        let ref = PsText { bytes: [0; 65536], len: 0 };
        ps_append(&ref, STR_PTR("env:"), STR_LEN("env:"));
        ps_append(&ref, ek_p, ek_l);
        ps_set_text(clean_in, STR_PTR("apiKeyRef"), STR_LEN("apiKeyRef"), ps_text_ptr(&ref), ref.len);
        let pv_p: ptr = PTR_NULL();
        let pv_l: u64 = 0;
        previewSecret(ps_text_ptr(&secret), secret.len, &pv_p, &pv_l);
        ps_set_text(clean_in, STR_PTR("apiKeyPreview"), STR_LEN("apiKeyPreview"), pv_p, pv_l);
    };
    ps_set_text(clean_in, STR_PTR("apiKeyStorage"), STR_LEN("apiKeyStorage"), ps_text_ptr(&storage), storage.len);
    let created: f64 = 0.0;
    let has_created: bool = ps_field_number(input, STR_PTR("createdAt"), STR_LEN("createdAt"), &created);
    if has_created && created != 0.0 {
        let st3: i32 = sa_json_object_set_f64(clean_in, STR_PTR("createdAt"), STR_LEN("createdAt"), created);
    } else {
        let st3: i32 = sa_json_object_set_f64(clean_in, STR_PTR("createdAt"), STR_LEN("createdAt"), now as f64);
    };
    let st4: i32 = sa_json_object_set_f64(clean_in, STR_PTR("updatedAt"), STR_LEN("updatedAt"), now as f64);
    let clean: u64 = 0;
    let ok: bool = normalizeProvider(clean_in, &clean);
    let f3: i32 = sa_json_free(clean_in);
    let f4: i32 = sa_json_free(base);
    if !ok {
        let f: i32 = sa_json_free(store);
        return ps_throw(STR_PTR("Invalid provider config"), STR_LEN("Invalid provider config"));
    };
    let next: u64 = ps_filtered_without(store, ps_text_ptr(&id), id.len);
    if next != 0 {
        let pst: i32 = sa_json_array_push_node(next, ps_clone(clean));
    };
    let wst: i32 = ps_shape_write(s, next);
    if next != 0 { let f: i32 = sa_json_free(next); };
    let f5: i32 = sa_json_free(store);
    if wst != 0 {
        let f: i32 = sa_json_free(clean);
        return wst;
    };
    if has_secret {
        ProviderStore_persistProviderKey(s, ps_text_ptr(&id), id.len, ps_text_ptr(&secret), secret.len);
    };
    *out_json = clean;
    return 0;
}

fn ProviderStore_delete(s: &ProviderStore, id_ptr: ptr, id_len: u64) -> i32 {
    let d1: bool = ps_registry_delete(s.transientProviders, id_ptr, id_len);
    let d2: bool = ps_registry_delete(s.memorySecrets, id_ptr, id_len);
    ProviderStore_deletePersistedProviderKey(s, id_ptr, id_len);
    ps_keyring_remove(id_ptr, id_len);
    let store: u64 = ps_read_array(s);
    let next: u64 = ps_filtered_without(store, id_ptr, id_len);
    let wst: i32 = ps_shape_write(s, next);
    if next != 0 { let f: i32 = sa_json_free(next); };
    if store != 0 { let f: i32 = sa_json_free(store); };
    return wst;
}

fn ps_replace_in_array(providers: u64, id_p: ptr, id_l: u64, replacement: u64) -> u64 {
    let out: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    if out == 0 || providers == 0 { return out; };
    let c: u64 = 0;
    let st: i32 = sa_json_value_count(providers, &c);
    let i: u64 = 0;
    while i < c {
        let p: u64 = 0;
        let ast: i32 = sa_json_array_get(providers, i, &p);
        let pp: ptr = PTR_NULL();
        let pl: u64 = 0;
        let has: bool = ps_field_str(p, STR_PTR("id"), STR_LEN("id"), &pp, &pl);
        let is_target: bool = false;
        if has { is_target = ps_eq(pp, pl, id_p, id_l); };
        if is_target {
            let pst: i32 = sa_json_array_push_node(out, ps_clone(replacement));
        } else {
            let pst: i32 = sa_json_array_push_node(out, ps_clone(p));
        };
        i = i + 1;
    }
    return out;
}

fn ProviderStore_trash(s: &ProviderStore, id_ptr: ptr, id_len: u64, out_json: &u64) -> i32 {
    *out_json = 0;
    let hit: u64 = 0;
    if ps_registry_get(s.transientProviders, id_ptr, id_len, &hit) {
        let copy: u64 = ps_clone(hit);
        if copy != 0 {
            let n1: i64 = ps_now_ms();
            let s1: i32 = sa_json_object_set_f64(copy, STR_PTR("trashedAt"), STR_LEN("trashedAt"), n1 as f64);
            let n2: i64 = ps_now_ms();
            let s2: i32 = sa_json_object_set_f64(copy, STR_PTR("updatedAt"), STR_LEN("updatedAt"), n2 as f64);
            ps_registry_set(s.transientProviders, id_ptr, id_len, ps_clone(copy));
            *out_json = copy;
        };
        return 0;
    };
    let store: u64 = ps_read_array(s);
    let existing: u64 = 0;
    if !ps_find_by_id(store, id_ptr, id_len, &existing) {
        let f: i32 = sa_json_free(store);
        return ps_throw_not_found(STR_PTR("Provider not found: "), STR_LEN("Provider not found: "), id_ptr, id_len);
    };
    let spread: u64 = ps_clone(existing);
    if spread != 0 {
        let n1: i64 = ps_now_ms();
        let s1: i32 = sa_json_object_set_f64(spread, STR_PTR("trashedAt"), STR_LEN("trashedAt"), n1 as f64);
        let n2: i64 = ps_now_ms();
        let s2: i32 = sa_json_object_set_f64(spread, STR_PTR("updatedAt"), STR_LEN("updatedAt"), n2 as f64);
    };
    let trashed: u64 = 0;
    let ok: bool = false;
    if spread != 0 { ok = normalizeProvider(spread, &trashed); };
    if spread != 0 { let f: i32 = sa_json_free(spread); };
    if !ok {
        let f: i32 = sa_json_free(store);
        return ps_throw(STR_PTR("Invalid provider config"), STR_LEN("Invalid provider config"));
    };
    let next: u64 = ps_replace_in_array(store, id_ptr, id_len, trashed);
    let wst: i32 = ps_shape_write(s, next);
    if next != 0 { let f: i32 = sa_json_free(next); };
    let f: i32 = sa_json_free(store);
    if wst != 0 {
        let f2: i32 = sa_json_free(trashed);
        return wst;
    };
    *out_json = trashed;
    return 0;
}

fn ProviderStore_restore(s: &ProviderStore, id_ptr: ptr, id_len: u64, out_json: &u64) -> i32 {
    *out_json = 0;
    let hit: u64 = 0;
    if ps_registry_get(s.transientProviders, id_ptr, id_len, &hit) {
        let copy: u64 = ps_clone(hit);
        if copy != 0 {
            let rst: i32 = sa_json_object_remove(copy, STR_PTR("trashedAt"), STR_LEN("trashedAt"));
            let n2: i64 = ps_now_ms();
            let s2: i32 = sa_json_object_set_f64(copy, STR_PTR("updatedAt"), STR_LEN("updatedAt"), n2 as f64);
            ps_registry_set(s.transientProviders, id_ptr, id_len, ps_clone(copy));
            *out_json = copy;
        };
        return 0;
    };
    let store: u64 = ps_read_array(s);
    let existing: u64 = 0;
    if !ps_find_by_id(store, id_ptr, id_len, &existing) {
        let f: i32 = sa_json_free(store);
        return ps_throw_not_found(STR_PTR("Provider not found: "), STR_LEN("Provider not found: "), id_ptr, id_len);
    };
    let spread: u64 = ps_clone(existing);
    if spread != 0 {
        let rst: i32 = sa_json_object_remove(spread, STR_PTR("trashedAt"), STR_LEN("trashedAt"));
        let n2: i64 = ps_now_ms();
        let s2: i32 = sa_json_object_set_f64(spread, STR_PTR("updatedAt"), STR_LEN("updatedAt"), n2 as f64);
    };
    let restored: u64 = 0;
    let ok: bool = false;
    if spread != 0 { ok = normalizeProvider(spread, &restored); };
    if spread != 0 { let f: i32 = sa_json_free(spread); };
    if !ok {
        let f: i32 = sa_json_free(store);
        return ps_throw(STR_PTR("Invalid provider config"), STR_LEN("Invalid provider config"));
    };
    let next: u64 = ps_replace_in_array(store, id_ptr, id_len, restored);
    let wst: i32 = ps_shape_write(s, next);
    if next != 0 { let f: i32 = sa_json_free(next); };
    let f: i32 = sa_json_free(store);
    if wst != 0 {
        let f2: i32 = sa_json_free(restored);
        return wst;
    };
    *out_json = restored;
    return 0;
}

fn ps_lower_trimmed(p: ptr, l: u64, out: &PsText) -> void {
    out.len = 0;
    let lo: u64 = 0;
    let hi: u64 = 0;
    ps_trim_range(p, l, &lo, &hi);
    let i: u64 = lo;
    while i < hi {
        let b: u64 = ps_byte(p, i) as u64;
        if b >= 65 && b <= 90 { b = b + 32; };
        if out.len < 65536 {
            out.bytes[out.len] = b as u8;
            out.len = out.len + 1;
        };
        i = i + 1;
    }
}

fn ps_fold_eq(a_p: ptr, a_l: u64, b_p: ptr, b_l: u64) -> bool {
    let ta = PsText { bytes: [0; 65536], len: 0 };
    ps_lower_trimmed(a_p, a_l, &ta);
    let tb = PsText { bytes: [0; 65536], len: 0 };
    ps_lower_trimmed(b_p, b_l, &tb);
    return ps_eq(ps_text_ptr(&ta), ta.len, ps_text_ptr(&tb), tb.len);
}

// ---- profile / relay bundle export + import ----
fn ps_envelope(schema_ptr: ptr, schema_len: u64, providers: u64, include_secrets: bool) -> u64 {
    let doc: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    if doc == 0 { return 0; };
    ps_set_text(doc, STR_PTR("schema"), STR_LEN("schema"), schema_ptr, schema_len);
    let now: i64 = ps_now_ms();
    let st: i32 = sa_json_object_set_f64(doc, STR_PTR("exportedAt"), STR_LEN("exportedAt"), now as f64);
    if include_secrets {
        let st2: i32 = sa_json_object_set_bool(doc, STR_PTR("includesSecrets"), STR_LEN("includesSecrets"), 1);
    };
    let st3: i32 = sa_json_object_set_node(doc, STR_PTR("providers"), STR_LEN("providers"), providers);
    return doc;
}

fn ProviderStore_exportProfile(s: &ProviderStore, out_json: &u64) -> i32 {
    let store: u64 = ps_read_array(s);
    let profiled: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    if store != 0 && profiled != 0 {
        let c: u64 = 0;
        let cst: i32 = sa_json_value_count(store, &c);
        let i: u64 = 0;
        while i < c {
            let p: u64 = 0;
            let ast: i32 = sa_json_array_get(store, i, &p);
            let prof: u64 = 0;
            profileProvider(p, &prof);
            if prof != 0 {
                let pst: i32 = sa_json_array_push_node(profiled, prof);
            };
            i = i + 1;
        }
    };
    if store != 0 { let f: i32 = sa_json_free(store); };
    *out_json = ps_envelope(STR_PTR("codex-react-ui.profile.v1"), STR_LEN("codex-react-ui.profile.v1"), profiled, false);
    return 0;
}

fn ProviderStore_exportRelayConfig(s: &ProviderStore, out_json: &u64) -> i32 {
    let store: u64 = ps_read_array(s);
    *out_json = ps_envelope(STR_PTR("codex-react-ui.relay-config.v1"), STR_LEN("codex-react-ui.relay-config.v1"), store, true);
    return 0;
}

fn ProviderStore_exportRelayBackup(s: &ProviderStore, out_json: &u64) -> i32 {
    let store: u64 = ps_read_array(s);
    let secrets: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    if s.db != 0 && secrets != 0 {
        let stmt: u64 = ps_prepare(s.db, STR_PTR("SELECT provider_id, api_key FROM provider_secrets ORDER BY provider_id ASC"), STR_LEN("SELECT provider_id, api_key FROM provider_secrets ORDER BY provider_id ASC"));
        if stmt != 0 {
            let guard: u64 = 0;
            while guard < 100000 {
                guard = guard + 1;
                let doc: u64 = 0;
                if !ps_step_row(stmt, &doc) { break; };
                let id_p: ptr = PTR_NULL();
                let id_l: u64 = 0;
                let has_id: bool = ps_field_str(doc, STR_PTR("provider_id"), STR_LEN("provider_id"), &id_p, &id_l);
                let key_p: ptr = PTR_NULL();
                let key_l: u64 = 0;
                let has_key: bool = ps_field_str(doc, STR_PTR("api_key"), STR_LEN("api_key"), &key_p, &key_l);
                let known: bool = false;
                if has_id {
                    let fnd: u64 = 0;
                    known = ps_find_by_id(store, id_p, id_l, &fnd);
                };
                let trimmed_nonempty: bool = false;
                if has_key {
                    let lo: u64 = 0;
                    let hi: u64 = 0;
                    ps_trim_range(key_p, key_l, &lo, &hi);
                    trimmed_nonempty = hi > lo;
                };
                if known && trimmed_nonempty {
                    let entry: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
                    if entry != 0 {
                        ps_set_text(entry, STR_PTR("providerId"), STR_LEN("providerId"), id_p, id_l);
                        ps_set_text(entry, STR_PTR("apiKey"), STR_LEN("apiKey"), key_p, key_l);
                        let pst: i32 = sa_json_array_push_node(secrets, entry);
                    };
                };
                let f: i32 = sa_json_free(doc);
            }
            ps_finalize(stmt);
        }
    };
    let env: u64 = ps_envelope(STR_PTR("codex-react-ui.relay-backup.v1"), STR_LEN("codex-react-ui.relay-backup.v1"), store, true);
    if env != 0 {
        let st: i32 = sa_json_object_set_node(env, STR_PTR("providerSecrets"), STR_LEN("providerSecrets"), secrets);
    } else {
        if secrets != 0 { let f: i32 = sa_json_free(secrets); };
    };
    *out_json = env;
    return 0;
}

fn ps_schema_of(profile: u64, out_p: &ptr, out_l: &u64) -> bool {
    return ps_field_sv(profile, STR_PTR("schema"), STR_LEN("schema"), out_p, out_l);
}

fn ps_check_schema(profile: u64, want_ptr: ptr, want_len: u64, err_ptr: ptr, err_len: u64) -> i32 {
    let sp: ptr = PTR_NULL();
    let sl: u64 = 0;
    if ps_schema_of(profile, &sp, &sl) {
        if ps_eq(sp, sl, want_ptr, want_len) { return 0; };
    };
    return ps_throw(err_ptr, err_len);
}

fn ProviderStore_importProfile(s: &ProviderStore, profile_json: u64, out_json: &u64) -> i32 {
    *out_json = 0;
    let bad: i32 = ps_check_schema(profile_json, STR_PTR("codex-react-ui.profile.v1"), STR_LEN("codex-react-ui.profile.v1"), STR_PTR("Unsupported UI profile schema"), STR_LEN("Unsupported UI profile schema"));
    if bad != 0 { return bad; };
    let entries: u64 = ps_jget(profile_json, STR_PTR("providers"), STR_LEN("providers"));
    if entries == 0 || sa_json_kind(entries) != 6 {
        return ps_throw(STR_PTR("UI profile is missing providers"), STR_LEN("UI profile is missing providers"));
    };
    let store: u64 = ps_read_array(s);
    let by_id: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    if store != 0 && by_id != 0 {
        let c: u64 = 0;
        let cst: i32 = sa_json_value_count(store, &c);
        let i: u64 = 0;
        while i < c {
            let p: u64 = 0;
            let ast: i32 = sa_json_array_get(store, i, &p);
            let id_p: ptr = PTR_NULL();
            let id_l: u64 = 0;
            if ps_field_str(p, STR_PTR("id"), STR_LEN("id"), &id_p, &id_l) {
                let st: i32 = sa_json_object_set_node(by_id, id_p, id_l, ps_clone(p));
            };
            i = i + 1;
        }
    };
    let imported: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    let c: u64 = 0;
    let cst: i32 = sa_json_value_count(entries, &c);
    let i: u64 = 0;
    let failed: i32 = 0;
    while i < c {
        let entry: u64 = 0;
        let ast: i32 = sa_json_array_get(entries, i, &entry);
        let eid_p: ptr = PTR_NULL();
        let eid_l: u64 = 0;
        let has_eid: bool = false;
        let rec: u64 = 0;
        ps_asRecord(entry, &rec);
        if rec != 0 {
            has_eid = ps_field_sv(rec, STR_PTR("id"), STR_LEN("id"), &eid_p, &eid_l);
        };
        let existing: u64 = 0;
        if has_eid { existing = ps_jget(by_id, eid_p, eid_l); };
        let normalized: u64 = 0;
        let st: i32 = normalizeProfileProvider(entry, existing, existing != 0, &normalized);
        if st != 0 {
            failed = st;
            break;
        };
        if normalized != 0 && imported != 0 {
            let pst: i32 = sa_json_array_push_node(imported, normalized);
        };
        i = i + 1;
    }
    if failed != 0 {
        if imported != 0 { let f: i32 = sa_json_free(imported); };
        if by_id != 0 { let f: i32 = sa_json_free(by_id); };
        if store != 0 { let f: i32 = sa_json_free(store); };
        return failed;
    };
    // for (const provider of imported) byId.set(provider.id, provider)
    if imported != 0 && by_id != 0 {
        let ic: u64 = 0;
        let ist: i32 = sa_json_value_count(imported, &ic);
        let j: u64 = 0;
        while j < ic {
            let p: u64 = 0;
            let ast: i32 = sa_json_array_get(imported, j, &p);
            let id_p: ptr = PTR_NULL();
            let id_l: u64 = 0;
            if ps_field_str(p, STR_PTR("id"), STR_LEN("id"), &id_p, &id_l) {
                let st: i32 = sa_json_object_set_node(by_id, id_p, id_l, ps_clone(p));
            };
            j = j + 1;
        }
    };
    // providers = [...byId.values()] in Map insertion order
    let providers: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    if by_id != 0 && providers != 0 {
        let c2: u64 = 0;
        let cst2: i32 = sa_json_value_count(by_id, &c2);
        let j: u64 = 0;
        while j < c2 {
            let kp: ptr = PTR_NULL();
            let kl: u64 = 0;
            let kst: i32 = sa_json_object_key_at(by_id, j, &kp, &kl);
            if kst == 0 {
                let v: u64 = ps_jget(by_id, kp, kl);
                if v != 0 {
                    let pst: i32 = sa_json_array_push_node(providers, ps_clone(v));
                };
            };
            j = j + 1;
        }
    };
    let wst: i32 = ps_shape_write(s, providers);
    let ic: u64 = 0;
    if imported != 0 {
        let ist: i32 = sa_json_value_count(imported, &ic);
    };
    let out: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    if out != 0 {
        let st: i32 = sa_json_object_set_f64(out, STR_PTR("importedProviders"), STR_LEN("importedProviders"), ic as f64);
        let st2: i32 = sa_json_object_set_node(out, STR_PTR("providers"), STR_LEN("providers"), providers);
    } else {
        if providers != 0 { let f: i32 = sa_json_free(providers); };
    };
    if imported != 0 { let f: i32 = sa_json_free(imported); };
    if by_id != 0 { let f: i32 = sa_json_free(by_id); };
    if store != 0 { let f: i32 = sa_json_free(store); };
    if wst != 0 { return wst; };
    *out_json = out;
    return 0;
}

fn ps_import_relay_entries(s: &ProviderStore, entries: u64, by_id: u64, invalid_msg_ptr: ptr, invalid_msg_len: u64, out_imported: &u64) -> i32 {
    let imported: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    *out_imported = imported;
    let now: i64 = ps_now_ms();
    let c: u64 = 0;
    let cst: i32 = sa_json_value_count(entries, &c);
    let i: u64 = 0;
    while i < c {
        let entry: u64 = 0;
        let ast: i32 = sa_json_array_get(entries, i, &entry);
        let spread: u64 = ps_clone(entry);
        if spread == 0 {
            return ps_throw(invalid_msg_ptr, invalid_msg_len);
        };
        let eid_p: ptr = PTR_NULL();
        let eid_l: u64 = 0;
        let has_eid: bool = ps_field_sv(entry, STR_PTR("id"), STR_LEN("id"), &eid_p, &eid_l);
        let existing: u64 = 0;
        if has_eid { existing = ps_jget(by_id, eid_p, eid_l); };
        if existing != 0 {
            let ep: ptr = PTR_NULL();
            let el: u64 = 0;
            if ps_field_str(existing, STR_PTR("id"), STR_LEN("id"), &ep, &el) {
                ps_set_text(spread, STR_PTR("id"), STR_LEN("id"), ep, el);
            };
        } else {
            let rst: i32 = sa_json_object_remove(spread, STR_PTR("id"), STR_LEN("id"));
        };
        let created: f64 = 0.0;
        let has_created: bool = ps_field_number(entry, STR_PTR("createdAt"), STR_LEN("createdAt"), &created);
        if !has_created && existing != 0 {
            has_created = ps_field_number(existing, STR_PTR("createdAt"), STR_LEN("createdAt"), &created);
        };
        if has_created {
            let st: i32 = sa_json_object_set_f64(spread, STR_PTR("createdAt"), STR_LEN("createdAt"), created);
        } else {
            let st: i32 = sa_json_object_set_f64(spread, STR_PTR("createdAt"), STR_LEN("createdAt"), now as f64);
        };
        let st2: i32 = sa_json_object_set_f64(spread, STR_PTR("updatedAt"), STR_LEN("updatedAt"), now as f64);
        let normalized: u64 = 0;
        if !normalizeProvider(spread, &normalized) {
            let f: i32 = sa_json_free(spread);
            return ps_throw(invalid_msg_ptr, invalid_msg_len);
        };
        let f: i32 = sa_json_free(spread);
        if imported != 0 {
            let pst: i32 = sa_json_array_push_node(imported, normalized);
        };
        i = i + 1;
    }
    return 0;
}

fn ps_by_id_map(store: u64) -> u64 {
    let by_id: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    if store == 0 || by_id == 0 { return by_id; };
    let c: u64 = 0;
    let cst: i32 = sa_json_value_count(store, &c);
    let i: u64 = 0;
    while i < c {
        let p: u64 = 0;
        let ast: i32 = sa_json_array_get(store, i, &p);
        let id_p: ptr = PTR_NULL();
        let id_l: u64 = 0;
        if ps_field_str(p, STR_PTR("id"), STR_LEN("id"), &id_p, &id_l) {
            let st: i32 = sa_json_object_set_node(by_id, id_p, id_l, ps_clone(p));
        };
        i = i + 1;
    }
    return by_id;
}

fn ps_map_values(by_id: u64) -> u64 {
    let out: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    if by_id == 0 || out == 0 { return out; };
    let c: u64 = 0;
    let cst: i32 = sa_json_value_count(by_id, &c);
    let i: u64 = 0;
    while i < c {
        let kp: ptr = PTR_NULL();
        let kl: u64 = 0;
        let kst: i32 = sa_json_object_key_at(by_id, i, &kp, &kl);
        if kst == 0 {
            let v: u64 = ps_jget(by_id, kp, kl);
            if v != 0 {
                let pst: i32 = sa_json_array_push_node(out, ps_clone(v));
            };
        };
        i = i + 1;
    }
    return out;
}

fn ps_bundle_result(imported: u64, providers: u64) -> u64 {
    let out: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    if out == 0 { return 0; };
    let ic: u64 = 0;
    if imported != 0 {
        let ist: i32 = sa_json_value_count(imported, &ic);
    };
    let st: i32 = sa_json_object_set_f64(out, STR_PTR("importedProviders"), STR_LEN("importedProviders"), ic as f64);
    let st2: i32 = sa_json_object_set_node(out, STR_PTR("providers"), STR_LEN("providers"), providers);
    return out;
}

fn ProviderStore_importRelayConfig(s: &ProviderStore, config_json: u64, out_json: &u64) -> i32 {
    *out_json = 0;
    let bad: i32 = ps_check_schema(config_json, STR_PTR("codex-react-ui.relay-config.v1"), STR_LEN("codex-react-ui.relay-config.v1"), STR_PTR("Unsupported relay config schema"), STR_LEN("Unsupported relay config schema"));
    if bad != 0 { return bad; };
    let includes: u64 = ps_jget(config_json, STR_PTR("includesSecrets"), STR_LEN("includesSecrets"));
    let inc_ok: bool = false;
    if includes != 0 {
        let b: u64 = 0;
        let st: i32 = sa_json_as_bool(includes, &b);
        inc_ok = b != 0;
    };
    if !inc_ok {
        return ps_throw(STR_PTR("Relay config bundle must declare includesSecrets=true"), STR_LEN("Relay config bundle must declare includesSecrets=true"));
    };
    let entries: u64 = ps_jget(config_json, STR_PTR("providers"), STR_LEN("providers"));
    if entries == 0 || sa_json_kind(entries) != 6 {
        return ps_throw(STR_PTR("Relay config is missing providers"), STR_LEN("Relay config is missing providers"));
    };
    let store: u64 = ps_read_array(s);
    let by_id: u64 = ps_by_id_map(store);
    let imported: u64 = 0;
    let ist: i32 = ps_import_relay_entries(s, entries, by_id, STR_PTR("Invalid relay provider config"), STR_LEN("Invalid relay provider config"), &imported);
    if ist != 0 {
        if by_id != 0 { let f: i32 = sa_json_free(by_id); };
        if store != 0 { let f: i32 = sa_json_free(store); };
        return ist;
    };
    if imported != 0 && by_id != 0 {
        let ic: u64 = 0;
        let cst: i32 = sa_json_value_count(imported, &ic);
        let j: u64 = 0;
        while j < ic {
            let p: u64 = 0;
            let ast: i32 = sa_json_array_get(imported, j, &p);
            let id_p: ptr = PTR_NULL();
            let id_l: u64 = 0;
            if ps_field_str(p, STR_PTR("id"), STR_LEN("id"), &id_p, &id_l) {
                let st: i32 = sa_json_object_set_node(by_id, id_p, id_l, ps_clone(p));
            };
            j = j + 1;
        }
    };
    let providers: u64 = ps_map_values(by_id);
    let wst: i32 = ps_shape_write(s, providers);
    let out: u64 = ps_bundle_result(imported, providers);
    if imported != 0 { let f: i32 = sa_json_free(imported); };
    if by_id != 0 { let f: i32 = sa_json_free(by_id); };
    if store != 0 { let f: i32 = sa_json_free(store); };
    if wst != 0 { return wst; };
    *out_json = out;
    return 0;
}

fn ProviderStore_importRelayBackup(s: &ProviderStore, backup_json: u64, out_json: &u64) -> i32 {
    *out_json = 0;
    let bad: i32 = ps_check_schema(backup_json, STR_PTR("codex-react-ui.relay-backup.v1"), STR_LEN("codex-react-ui.relay-backup.v1"), STR_PTR("Unsupported relay backup schema"), STR_LEN("Unsupported relay backup schema"));
    if bad != 0 { return bad; };
    let includes: u64 = ps_jget(backup_json, STR_PTR("includesSecrets"), STR_LEN("includesSecrets"));
    let inc_ok: bool = false;
    if includes != 0 {
        let b: u64 = 0;
        let st: i32 = sa_json_as_bool(includes, &b);
        inc_ok = b != 0;
    };
    if !inc_ok {
        return ps_throw(STR_PTR("Relay backup must declare includesSecrets=true"), STR_LEN("Relay backup must declare includesSecrets=true"));
    };
    let entries: u64 = ps_jget(backup_json, STR_PTR("providers"), STR_LEN("providers"));
    if entries == 0 || sa_json_kind(entries) != 6 {
        return ps_throw(STR_PTR("Relay backup is missing providers"), STR_LEN("Relay backup is missing providers"));
    };
    let inner: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    if inner != 0 {
        ps_set_text(inner, STR_PTR("schema"), STR_LEN("schema"), STR_PTR("codex-react-ui.relay-config.v1"), STR_LEN("codex-react-ui.relay-config.v1"));
        let exported: f64 = 0.0;
        if ps_field_number(backup_json, STR_PTR("exportedAt"), STR_LEN("exportedAt"), &exported) {
            let st: i32 = sa_json_object_set_f64(inner, STR_PTR("exportedAt"), STR_LEN("exportedAt"), exported);
        } else {
            let now: i64 = ps_now_ms();
            let st: i32 = sa_json_object_set_f64(inner, STR_PTR("exportedAt"), STR_LEN("exportedAt"), now as f64);
        };
        let st2: i32 = sa_json_object_set_bool(inner, STR_PTR("includesSecrets"), STR_LEN("includesSecrets"), 1);
        let st3: i32 = sa_json_object_set_node(inner, STR_PTR("providers"), STR_LEN("providers"), ps_clone(entries));
    };
    let result: u64 = 0;
    let ist: i32 = ProviderStore_importRelayConfig(s, inner, &result);
    if inner != 0 { let f: i32 = sa_json_free(inner); };
    if ist != 0 { return ist; };
    let secrets: u64 = ps_jget(backup_json, STR_PTR("providerSecrets"), STR_LEN("providerSecrets"));
    let result_providers: u64 = ps_jget(result, STR_PTR("providers"), STR_LEN("providers"));
    if secrets != 0 && sa_json_kind(secrets) == 6 {
        let c: u64 = 0;
        let cst: i32 = sa_json_value_count(secrets, &c);
        let i: u64 = 0;
        while i < c {
            let entry: u64 = 0;
            let ast: i32 = sa_json_array_get(secrets, i, &entry);
            let rec: u64 = 0;
            ps_asRecord(entry, &rec);
            if rec != 0 {
                let pid_p: ptr = PTR_NULL();
                let pid_l: u64 = 0;
                let has_pid: bool = ps_field_sv(rec, STR_PTR("providerId"), STR_LEN("providerId"), &pid_p, &pid_l);
                let key_p: ptr = PTR_NULL();
                let key_l: u64 = 0;
                let has_key: bool = ps_field_sv(rec, STR_PTR("apiKey"), STR_LEN("apiKey"), &key_p, &key_l);
                if has_pid && has_key {
                    let fnd: u64 = 0;
                    if ps_find_by_id(result_providers, pid_p, pid_l, &fnd) {
                        ProviderStore_persistProviderKey(s, pid_p, pid_l, key_p, key_l);
                    };
                };
            };
            i = i + 1;
        }
    };
    *out_json = result;
    return 0;
}

// ---- capability catalog preview / import ----
fn ProviderStore_validateCatalogProvider(s: &ProviderStore, provider_json: u64) -> i32 {
    let bp: ptr = PTR_NULL();
    let bl: u64 = 0;
    let has: bool = ps_field_sv(provider_json, STR_PTR("baseUrl"), STR_LEN("baseUrl"), &bp, &bl);
    if !has || bl == 0 {
        return ps_throw(STR_PTR("Capability catalogs require an existing Provider with a Base URL"), STR_LEN("Capability catalogs require an existing Provider with a Base URL"));
    };
    return 0;
}

fn ps_catalog_preview(s: &ProviderStore, provider: u64, catalog_json: u64, out_json: &u64) -> i32 {
    let vst: i32 = ProviderStore_validateCatalogProvider(s, provider);
    if vst != 0 { return vst; };
    let existing_text = PsText { bytes: [0; 65536], len: 0 };
    ps_stringify(provider, &existing_text);
    let input_text = PsText { bytes: [0; 65536], len: 0 };
    ps_stringify(catalog_json, &input_text);
    let pid_p: ptr = PTR_NULL();
    let pid_l: u64 = 0;
    ps_field_str(provider, STR_PTR("id"), STR_LEN("id"), &pid_p, &pid_l);
    let out_text = PsText { bytes: [0; 65536], len: 0 };
    let op: ptr = ps_text_ptr(&out_text);
    let ol: u64 = 0;
    let code: i32 = buildCatalogImportPreview(pid_p, pid_l, ps_text_ptr(&existing_text), existing_text.len, ps_text_ptr(&input_text), input_text.len, op, &ol);
    let empty: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    if ol > 0 {
        let parsed: u64 = sa_json_parse(op, ol);
        if parsed != 0 {
            if empty != 0 { let f: i32 = sa_json_free(empty); };
            *out_json = parsed;
            return 0;
        };
    };
    *out_json = empty;
    return 0;
}

fn ProviderStore_previewCapabilityCatalog(s: &ProviderStore, providerId_ptr: ptr, providerId_len: u64, catalog_json: u64, out_json: &u64) -> i32 {
    *out_json = 0;
    let provider: u64 = 0;
    let gst: i32 = ProviderStore_get(s, providerId_ptr, providerId_len, &provider);
    if gst != 0 || provider == 0 {
        return ps_throw_not_found(STR_PTR("Provider not found: "), STR_LEN("Provider not found: "), providerId_ptr, providerId_len);
    };
    let rst: i32 = ps_catalog_preview(s, provider, catalog_json, out_json);
    let f: i32 = sa_json_free(provider);
    return rst;
}

fn ProviderStore_importCapabilityCatalog(s: &ProviderStore, providerId_ptr: ptr, providerId_len: u64, catalog_json: u64, mode: u64, out_json: &u64) -> i32 {
    *out_json = 0;
    let store: u64 = ps_read_array(s);
    let provider: u64 = 0;
    if !ps_find_by_id(store, providerId_ptr, providerId_len, &provider) {
        let f: i32 = sa_json_free(store);
        return ps_throw_not_found(STR_PTR("Provider not found: "), STR_LEN("Provider not found: "), providerId_ptr, providerId_len);
    };
    let preview: u64 = 0;
    let pst: i32 = ps_catalog_preview(s, provider, catalog_json, &preview);
    if pst != 0 {
        if preview != 0 { let f: i32 = sa_json_free(preview); };
        let f: i32 = sa_json_free(store);
        return pst;
    };
    let groups_text = PsText { bytes: [0; 65536], len: 0 };
    let existing_groups: u64 = ps_jget(provider, STR_PTR("groups"), STR_LEN("groups"));
    if existing_groups != 0 {
        let sg1: bool = ps_stringify(existing_groups, &groups_text);
    } else {
        ps_append(&groups_text, STR_PTR("[]"), STR_LEN("[]"));
    };
    let preview_groups_text = PsText { bytes: [0; 65536], len: 0 };
    let preview_groups: u64 = ps_jget(preview, STR_PTR("groups"), STR_LEN("groups"));
    if preview_groups != 0 {
        let sg2: bool = ps_stringify(preview_groups, &preview_groups_text);
    } else {
        ps_append(&preview_groups_text, STR_PTR("[]"), STR_LEN("[]"));
    };
    let merged_text = PsText { bytes: [0; 65536], len: 0 };
    let mp: ptr = ps_text_ptr(&merged_text);
    let ml: u64 = 0;
    let replace: bool = mode == 1;
    let code: i32 = mergeCatalogGroups(ps_text_ptr(&groups_text), groups_text.len, ps_text_ptr(&preview_groups_text), preview_groups_text.len, replace, mp, &ml);
    let merged: u64 = ps_text_or_empty_array(mp, ml);
    let catalog_models: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    let preview_catalog: u64 = ps_jget(preview, STR_PTR("catalog"), STR_LEN("catalog"));
    let data: u64 = ps_jget(preview_catalog, STR_PTR("data"), STR_LEN("data"));
    if data != 0 && sa_json_kind(data) == 6 && catalog_models != 0 {
        let c: u64 = 0;
        let cst: i32 = sa_json_value_count(data, &c);
        let i: u64 = 0;
        while i < c {
            let model: u64 = 0;
            let ast: i32 = sa_json_array_get(data, i, &model);
            let mn: u64 = ps_jget(model, STR_PTR("model_name"), STR_LEN("model_name"));
            if mn != 0 {
                let pst2: i32 = sa_json_array_push_node(catalog_models, ps_clone(mn));
            };
            i = i + 1;
        }
    };
    let next: u64 = ps_clone(provider);
    if next != 0 {
        ps_set_text(next, STR_PTR("channelMode"), STR_LEN("channelMode"), STR_PTR("advanced"), STR_LEN("advanced"));
        let natives_src: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
        let existing_natives: u64 = ps_jget(provider, STR_PTR("nativeModels"), STR_LEN("nativeModels"));
        if existing_natives != 0 && sa_json_kind(existing_natives) == 6 && natives_src != 0 {
            let c: u64 = 0;
            let cst: i32 = sa_json_value_count(existing_natives, &c);
            let i: u64 = 0;
            while i < c {
                let item: u64 = 0;
                let ast: i32 = sa_json_array_get(existing_natives, i, &item);
                let pst2: i32 = sa_json_array_push_node(natives_src, ps_clone(item));
                i = i + 1;
            }
        };
        if catalog_models != 0 && natives_src != 0 {
            let c: u64 = 0;
            let cst: i32 = sa_json_value_count(catalog_models, &c);
            let i: u64 = 0;
            while i < c {
                let item: u64 = 0;
                let ast: i32 = sa_json_array_get(catalog_models, i, &item);
                let pst2: i32 = sa_json_array_push_node(natives_src, ps_clone(item));
                i = i + 1;
            }
        };
        let natives: u64 = 0;
        ps_uniqueStrings(natives_src, &natives);
        if natives_src != 0 { let f: i32 = sa_json_free(natives_src); };
        if natives != 0 {
            let st: i32 = sa_json_object_set_node(next, STR_PTR("nativeModels"), STR_LEN("nativeModels"), natives);
        };
        if preview_catalog != 0 {
            let st: i32 = sa_json_object_set_node(next, STR_PTR("capabilityCatalog"), STR_LEN("capabilityCatalog"), ps_clone(preview_catalog));
        };
        let st2: i32 = sa_json_object_set_node(next, STR_PTR("groups"), STR_LEN("groups"), merged);
        let now: i64 = ps_now_ms();
        let st3: i32 = sa_json_object_set_f64(next, STR_PTR("updatedAt"), STR_LEN("updatedAt"), now as f64);
    };
    if catalog_models != 0 { let f: i32 = sa_json_free(catalog_models); };
    let replaced: u64 = ps_replace_in_array(store, providerId_ptr, providerId_len, next);
    let wst: i32 = ps_shape_write(s, replaced);
    if replaced != 0 { let f: i32 = sa_json_free(replaced); };
    let out: u64 = ps_clone(preview);
    if out != 0 {
        let st: i32 = sa_json_object_set_node(out, STR_PTR("provider"), STR_LEN("provider"), ps_clone(next));
        if replace {
            ps_set_text(out, STR_PTR("mode"), STR_LEN("mode"), STR_PTR("replace"), STR_LEN("replace"));
        } else {
            ps_set_text(out, STR_PTR("mode"), STR_LEN("mode"), STR_PTR("merge"), STR_LEN("merge"));
        };
    };
    if next != 0 { let f: i32 = sa_json_free(next); };
    if preview != 0 { let f: i32 = sa_json_free(preview); };
    let f: i32 = sa_json_free(store);
    if wst != 0 {
        if out != 0 { let f2: i32 = sa_json_free(out); };
        return wst;
    };
    *out_json = out;
    return 0;
}

// ---- quota + runtime env + key access ----
fn ProviderStore_addUsedQuota(s: &ProviderStore, providerId_ptr: ptr, providerId_len: u64, groupId_ptr: ptr, groupId_len: u64, amountUsd: f64) -> void {
    if providerId_len == 0 || groupId_len == 0 { return; };
    if !ps_is_finite(amountUsd) || amountUsd <= 0.0 { return; };
    if s.db == 0 { return; };
    let stmt: u64 = ps_prepare(s.db, STR_PTR("UPDATE relay_groups SET used_quota_usd = COALESCE(used_quota_usd, 0) + ?, updated_at = ? WHERE provider_id = ? AND group_id = ?"), STR_LEN("UPDATE relay_groups SET used_quota_usd = COALESCE(used_quota_usd, 0) + ?, updated_at = ? WHERE provider_id = ? AND group_id = ?"));
    if stmt == 0 { return; };
    ps_bind_double(stmt, 1, amountUsd);
    ps_bind_int(stmt, 2, ps_now_ms());
    ps_bind_text(stmt, 3, providerId_ptr, providerId_len);
    ps_bind_text(stmt, 4, groupId_ptr, groupId_len);
    ps_step_once(stmt);
    ps_finalize(stmt);
}

fn ProviderStore_runtimeEnv(s: &ProviderStore, out_json: &u64) -> void {
    let env: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    *out_json = env;
    if env == 0 { return; };
    if s.memorySecrets != 0 {
        let c: u64 = 0;
        let cst: i32 = sa_json_value_count(s.memorySecrets, &c);
        let i: u64 = 0;
        while i < c {
            let kp: ptr = PTR_NULL();
            let kl: u64 = 0;
            let kst: i32 = sa_json_object_key_at(s.memorySecrets, i, &kp, &kl);
            if kst == 0 {
                let secret: u64 = ps_jget(s.memorySecrets, kp, kl);
                let sp: ptr = PTR_NULL();
                let sl: u64 = 0;
                if ps_jstr(secret, &sp, &sl) {
                    let ek_p: ptr = PTR_NULL();
                    let ek_l: u64 = 0;
                    envKeyForProvider(kp, kl, &ek_p, &ek_l);
                    ps_set_text(env, ek_p, ek_l, sp, sl);
                };
            };
            i = i + 1;
        }
    };
    let vars: u64 = ps_env_vars();
    if vars != 0 {
        let c: u64 = 0;
        let cst: i32 = sa_json_value_count(vars, &c);
        let i: u64 = 0;
        while i < c {
            let kp: ptr = PTR_NULL();
            let kl: u64 = 0;
            let kst: i32 = sa_json_object_key_at(vars, i, &kp, &kl);
            if kst == 0 {
                let is_provider_key: bool = false;
                if ps_starts_with(kp, kl, STR_PTR("CODEX_UI_PROVIDER_"), STR_LEN("CODEX_UI_PROVIDER_")) {
                    is_provider_key = ps_ends_with(kp, kl, STR_PTR("_API_KEY"), STR_LEN("_API_KEY"));
                };
                if is_provider_key {
                    let v: u64 = ps_jget(vars, kp, kl);
                    let vp: ptr = PTR_NULL();
                    let vl: u64 = 0;
                    if ps_jstr(v, &vp, &vl) {
                        let lo: u64 = 0;
                        let hi: u64 = 0;
                        ps_trim_range(vp, vl, &lo, &hi);
                        if hi > lo {
                            ps_set_text(env, kp, kl, vp, vl);
                        };
                    };
                };
            };
            i = i + 1;
        }
        let f: i32 = sa_json_free(vars);
    };
}

fn ProviderStore_providerApiKey(s: &ProviderStore, id_ptr: ptr, id_len: u64, out_ptr: &ptr, out_len: &u64) -> void {
    *out_ptr = PTR_NULL();
    *out_len = 0;
    let hit: u64 = 0;
    if ps_registry_get(s.memorySecrets, id_ptr, id_len, &hit) {
        let sp: ptr = PTR_NULL();
        let sl: u64 = 0;
        if ps_jstr(hit, &sp, &sl) {
            let lo: u64 = 0;
            let hi: u64 = 0;
            ps_trim_range(sp, sl, &lo, &hi);
            if hi > lo {
                let seg: ptr = PTR_NULL();
                PTR_BYTE_ADD(seg, sp, lo);
                ps_doc_str(STR_PTR("apikey"), STR_LEN("apikey"), seg, hi - lo, out_ptr, out_len);
                return;
            };
        };
    };
    let key_p: ptr = PTR_NULL();
    let key_l: u64 = 0;
    ProviderStore_readPersistedProviderKey(s, id_ptr, id_len, &key_p, &key_l);
    if key_l > 0 {
        let secret_node: u64 = 0;
        ps_str_node(key_p, key_l, &secret_node);
        if secret_node != 0 { ps_registry_set(s.memorySecrets, id_ptr, id_len, secret_node); };
        ps_doc_str(STR_PTR("apikey"), STR_LEN("apikey"), key_p, key_l, out_ptr, out_len);
        return;
    };
    let ek_p: ptr = PTR_NULL();
    let ek_l: u64 = 0;
    envKeyForProvider(id_ptr, id_len, &ek_p, &ek_l);
    let vars: u64 = ps_env_vars();
    if vars != 0 {
        let v: u64 = ps_jget(vars, ek_p, ek_l);
        let vp: ptr = PTR_NULL();
        let vl: u64 = 0;
        if ps_jstr(v, &vp, &vl) {
            let lo: u64 = 0;
            let hi: u64 = 0;
            ps_trim_range(vp, vl, &lo, &hi);
            if hi > lo {
                let seg: ptr = PTR_NULL();
                PTR_BYTE_ADD(seg, vp, lo);
                ps_doc_str(STR_PTR("apikey"), STR_LEN("apikey"), seg, hi - lo, out_ptr, out_len);
            } else {
                ps_doc_str(STR_PTR("apikey"), STR_LEN("apikey"), STR_PTR(""), 0, out_ptr, out_len);
            };
        } else {
            ps_doc_str(STR_PTR("apikey"), STR_LEN("apikey"), STR_PTR(""), 0, out_ptr, out_len);
        };
        let f: i32 = sa_json_free(vars);
        return;
    };
    ps_doc_str(STR_PTR("apikey"), STR_LEN("apikey"), STR_PTR(""), 0, out_ptr, out_len);
}

fn ProviderStore_useProviderKey(s: &ProviderStore, id_ptr: ptr, id_len: u64, apiKey_ptr: ptr, apiKey_len: u64) -> void {
    let lo: u64 = 0;
    let hi: u64 = 0;
    ps_trim_range(apiKey_ptr, apiKey_len, &lo, &hi);
    if hi <= lo { return; };
    let seg: ptr = PTR_NULL();
    PTR_BYTE_ADD(seg, apiKey_ptr, lo);
    let node: u64 = 0;
    ps_str_node(seg, hi - lo, &node);
    if node != 0 {
        ps_registry_set(s.memorySecrets, id_ptr, id_len, node);
    };
}

fn ps_ends_with(p: ptr, l: u64, suf_ptr: ptr, suf_len: u64) -> bool {
    if suf_len > l { return false; };
    let off: u64 = l - suf_len;
    let seg: ptr = PTR_NULL();
    PTR_BYTE_ADD(seg, p, off);
    return ps_eq(seg, suf_len, suf_ptr, suf_len);
}

// process.env as a JSON doc (sa_std env.sai: sa_env_vars_json)
fn ps_env_vars() -> u64 {
    return sa_env_vars_json();
}

fn ps_derive_catalog_groups(catalog: u64) -> u64 {
    let empty: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    let cat_text = PsText { bytes: [0; 65536], len: 0 };
    if !ps_stringify(catalog, &cat_text) { return empty; };
    let derived_text = PsText { bytes: [0; 65536], len: 0 };
    let dp: ptr = ps_text_ptr(&derived_text);
    let dl: u64 = 0;
    let code: i32 = deriveCatalogGroups(ps_text_ptr(&cat_text), cat_text.len, dp, &dl);
    if code != 0 || dl == 0 { return empty; };
    let parsed: u64 = sa_json_parse(dp, dl);
    if parsed == 0 || sa_json_kind(parsed) != 6 {
        if parsed != 0 { let f: i32 = sa_json_free(parsed); };
        return empty;
    };
    if empty != 0 { let f: i32 = sa_json_free(empty); };
    return parsed;
}

fn ps_set_text(doc: u64, key_p: ptr, key_l: u64, val_p: ptr, val_l: u64) -> void {
    if doc == 0 { return; };
    let node: u64 = 0;
    ps_str_node(val_p, val_l, &node);
    if node != 0 {
        let st: i32 = sa_json_object_set_node(doc, key_p, key_l, node);
    };
}

fn ps_text_or_empty_array(p: ptr, l: u64) -> u64 {
    if l > 0 {
        let parsed: u64 = sa_json_parse(p, l);
        if parsed != 0 { return parsed; };
    };
    return sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
}
