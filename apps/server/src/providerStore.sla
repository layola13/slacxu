// ---- ps_ toolkit ----
struct PsText { bytes: [u8; 65536], len: u64 }
struct PsPath { bytes: [u8; 4096], len: u64 }

fn ps_text_ptr(t: &PsText) -> ptr {
    let p: ptr = PTR_NULL();
    PTR_BYTE_ADD(p, &t.bytes, 0);
    return p;
}

fn ps_path_ptr(t: &PsPath) -> ptr {
    let p: ptr = PTR_NULL();
    PTR_BYTE_ADD(p, &t.bytes, 0);
    return p;
}

fn ps_append(dst: &PsText, p: ptr, len: u64) -> void {
    let i: u64 = 0;
    while i < len {
        if dst.len < 65536 {
            let b: u8 = 0;
            PTR_BYTE_AT(b, p, i);
            dst.bytes[dst.len] = b;
            dst.len = dst.len + 1;
        };
        i = i + 1;
    }
}

fn ps_append_path(dst: &PsPath, p: ptr, len: u64) -> void {
    let i: u64 = 0;
    while i < len {
        if dst.len < 4096 {
            let b: u8 = 0;
            PTR_BYTE_AT(b, p, i);
            dst.bytes[dst.len] = b;
            dst.len = dst.len + 1;
        };
        i = i + 1;
    }
}

fn ps_byte(p: ptr, i: u64) -> u8 {
    let b: u8 = 0;
    PTR_BYTE_AT(b, p, i);
    return b;
}

fn ps_lower(c: u8) -> u8 {
    if c >= 65 && c <= 90 { return c + 32; };
    return c;
}

fn ps_eq(p: ptr, len: u64, q: ptr, qlen: u64) -> bool {
    if len != qlen { return false; };
    let i: u64 = 0;
    while i < len {
        if ps_byte(p, i) != ps_byte(q, i) { return false; };
        i = i + 1;
    }
    return true;
}

fn ps_starts_with(p: ptr, len: u64, pre: ptr, pre_len: u64) -> bool {
    if pre_len > len { return false; };
    let j: u64 = 0;
    while j < pre_len {
        if ps_byte(p, j) != ps_byte(pre, j) { return false; };
        j = j + 1;
    }
    return true;
}

fn ps_trim_range(p: ptr, len: u64, lo: &u64, hi: &u64) -> void {
    let a: u64 = 0;
    let b: u64 = len;
    while a < b {
        let c: u8 = ps_byte(p, a);
        if c == 32 || c == 9 || c == 10 || c == 13 || c == 11 || c == 12 { a = a + 1; } else { break; };
    }
    while b > a {
        let c2: u8 = ps_byte(p, b - 1);
        if c2 == 32 || c2 == 9 || c2 == 10 || c2 == 13 || c2 == 11 || c2 == 12 { b = b - 1; } else { break; };
    }
    *lo = a;
    *hi = b;
}

fn ps_floor(v: f64) -> f64 {
    if v != v { return 0.0; };
    if v >= 0.0 { return (v as i64) as f64; };
    let t: f64 = (v as i64) as f64;
    if t > v { return t - 1.0; };
    return t;
}

fn ps_round(v: f64) -> f64 {
    return ps_floor(v + 0.5);
}

fn ps_pow10(v: f64, e: i64) -> f64 {
    let r: f64 = v;
    let n: i64 = e;
    while n > 0 { r = r * 10.0; n = n - 1; }
    while n < 0 { r = r / 10.0; n = n + 1; }
    return r;
}

fn ps_is_finite(v: f64) -> bool {
    let lim: f64 = ps_pow10(1.0, 308);
    return v == v && v < lim && v > (0.0 - lim);
}

// ---- JSON helpers ----
fn ps_jget(node: u64, key_p: ptr, key_l: u64) -> u64 {
    if node == 0 { return 0; };
    let out: u64 = 0;
    let st: i32 = sa_json_object_get(node, key_p, key_l, &out);
    if st != 0 { return 0; };
    return out;
}

fn ps_jstr(node: u64, out_p: &ptr, out_l: &u64) -> bool {
    *out_p = PTR_NULL();
    *out_l = 0;
    if node == 0 || sa_json_kind(node) != 5 { return false; };
    *out_p = sa_json_string_ptr(node);
    *out_l = sa_json_string_len(node);
    return true;
}

fn ps_field_str(node: u64, key_p: ptr, key_l: u64, out_p: &ptr, out_l: &u64) -> bool {
    return ps_jstr(ps_jget(node, key_p, key_l), out_p, out_l);
}

fn ps_field_num(node: u64, key_p: ptr, key_l: u64, out_v: &f64) -> bool {
    let v: u64 = ps_jget(node, key_p, key_l);
    if v == 0 { return false; };
    let k: u32 = sa_json_kind(v);
    if k != 2 && k != 3 { return false; };
    let st: i32 = sa_json_as_f64(v, out_v);
    return st == 0;
}

fn ps_scratch() -> u64 {
    let doc: u64 = 0;
    let st: i32 = sa_global_u64_get(STR_PTR("providerstore.scratch"), STR_LEN("providerstore.scratch"), &doc);
    if st == 0 && doc != 0 { return doc; };
    let fresh: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    let sst: i32 = sa_global_u64_set(STR_PTR("providerstore.scratch"), STR_LEN("providerstore.scratch"), fresh);
    return fresh;
}

fn ps_doc_str(key_p: ptr, key_l: u64, val_p: ptr, val_l: u64, out_p: &ptr, out_l: &u64) -> void {
    let doc: u64 = ps_scratch();
    *out_p = PTR_NULL();
    *out_l = 0;
    if doc == 0 { return; };
    let st: i32 = sa_json_object_set_string(doc, key_p, key_l, val_p, val_l);
    ps_field_str(doc, key_p, key_l, out_p, out_l);
}

fn ps_throw(msg_p: ptr, msg_l: u64) -> i32 {
    let doc: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    if doc != 0 {
        let s1: i32 = sa_json_object_set_string(doc, STR_PTR("error"), STR_LEN("error"), msg_p, msg_l);
        let old: u64 = 0;
        let gst: i32 = sa_global_u64_get(STR_PTR("providerstore.lasterror"), STR_LEN("providerstore.lasterror"), &old);
        if gst == 0 && old != 0 {
            let f: i32 = sa_json_free(old);
        };
        let sst: i32 = sa_global_u64_set(STR_PTR("providerstore.lasterror"), STR_LEN("providerstore.lasterror"), doc);
    };
    return 1;
}

fn ProviderStore_takeLastError(out_json: &u64) -> bool {
    let doc: u64 = 0;
    let st: i32 = sa_global_u64_get(STR_PTR("providerstore.lasterror"), STR_LEN("providerstore.lasterror"), &doc);
    *out_json = doc;
    return st == 0 && doc != 0;
}

fn ps_clone(doc: u64) -> u64 {
    if doc == 0 { return 0; };
    let buf: u64 = 0;
    if sa_json_stringify(doc, &buf) != 0 || buf == 0 { return 0; };
    let bp: ptr = sa_json_buffer_data(buf);
    let bl: u64 = sa_json_buffer_len(buf);
    let out: u64 = sa_json_parse(bp, bl);
    let f: i32 = sa_json_buffer_free(buf);
    return out;
}

fn ps_stringify(doc: u64, out: &PsText) -> bool {
    out.len = 0;
    if doc == 0 { return false; };
    let buf: u64 = 0;
    if sa_json_stringify(doc, &buf) != 0 || buf == 0 { return false; };
    let bp: ptr = sa_json_buffer_data(buf);
    let bl: u64 = sa_json_buffer_len(buf);
    if bl > 65536 {
        let f: i32 = sa_json_buffer_free(buf);
        return false;
    };
    ps_append(out, bp, bl);
    let f: i32 = sa_json_buffer_free(buf);
    return true;
}

fn ps_text_eq_json(a: u64, b: u64) -> bool {
    let ta = PsText { bytes: [0; 65536], len: 0 };
    let tb = PsText { bytes: [0; 65536], len: 0 };
    if !ps_stringify(a, &ta) { return false; };
    if !ps_stringify(b, &tb) { return false; };
    return ps_eq(ps_text_ptr(&ta), ta.len, ps_text_ptr(&tb), tb.len);
}

// ---- sqlite wrappers (one macro per fn — agy pattern) ----
fn ps_exec(db: u64, sql_p: ptr, sql_l: u64) -> i32 {
    if db == 0 { return 1; };
    let st: u64 = 0;
    SA_SQLITE_EXEC(st, db, sql_p, sql_l);
    return st as i32;
}

fn ps_prepare(db: u64, sql_p: ptr, sql_l: u64) -> u64 {
    if db == 0 { return 0; };
    let st: u64 = 0;
    let stmt: u64 = 0;
    SA_SQLITE_PREPARE(st, stmt, db, sql_p, sql_l);
    return stmt;
}

fn ps_bind_text(stmt: u64, idx: u64, val_p: ptr, val_l: u64) -> void {
    let st: u64 = 0;
    SA_SQLITE_BIND_TEXT(st, stmt, idx, val_p, val_l);
}

fn ps_bind_int(stmt: u64, idx: u64, value: i64) -> void {
    let st: u64 = 0;
    let v: u64 = value as u64;
    SA_SQLITE_BIND_INT(st, stmt, idx, v);
}

fn ps_bind_double(stmt: u64, idx: u64, value: f64) -> void {
    let st: u64 = 0;
    SA_SQLITE_BIND_DOUBLE(st, stmt, idx, value);
}

fn ps_bind_null(stmt: u64, idx: u64) -> void {
    let st: u64 = 0;
    SA_SQLITE_BIND_NULL(st, stmt, idx);
}

fn ps_step_row(stmt: u64, out_doc: &u64) -> bool {
    *out_doc = 0;
    let st: u64 = 0;
    let ready: u64 = 0;
    let rp: ptr = PTR_NULL();
    let rl: u64 = 0;
    SA_SQLITE_STEP_JSON(st, ready, rp, rl, stmt);
    if ready == 0 { return false; };
    *out_doc = sa_json_parse(rp, rl);
    return *out_doc != 0;
}

fn ps_step_once(stmt: u64) -> void {
    let st: u64 = 0;
    let ready: u64 = 0;
    let rp: ptr = PTR_NULL();
    let rl: u64 = 0;
    SA_SQLITE_STEP_JSON(st, ready, rp, rl, stmt);
}

fn ps_finalize(stmt: u64) -> void {
    if stmt == 0 { return; };
    let st: u64 = 0;
    SA_SQLITE_FINALIZE(st, stmt);
}

// run-style: prepare + step + finalize
fn ps_run(db: u64, sql_p: ptr, sql_l: u64) -> void {
    let stmt: u64 = ps_prepare(db, sql_p, sql_l);
    if stmt == 0 { return; };
    ps_step_once(stmt);
    ps_finalize(stmt);
}

// ---- path helpers ----
fn ps_seg_eq(p: ptr, a: u64, b: u64, lit_p: ptr, lit_l: u64) -> bool {
    if b - a != lit_l { return false; };
    let j: u64 = 0;
    while j < lit_l {
        if ps_byte(p, a + j) != ps_byte(lit_p, j) { return false; };
        j = j + 1;
    }
    return true;
}

fn ps_path_normalize(p: ptr, len: u64, out: &PsPath) -> void {
    let rooted: bool = len > 0 && ps_byte(p, 0) == 47;
    out.len = 0;
    if rooted { out.bytes[0] = 47; out.len = 1; };
    let i: u64 = 0;
    while i < len {
        while i < len && ps_byte(p, i) == 47 { i = i + 1; }
        if i >= len { break; };
        let start: u64 = i;
        while i < len && ps_byte(p, i) != 47 { i = i + 1; }
        if ps_seg_eq(p, start, i, STR_PTR("."), STR_LEN(".")) { continue; };
        if ps_seg_eq(p, start, i, STR_PTR(".."), STR_LEN("..")) {
            if out.len > 1 || (out.len == 1 && !rooted) {
                let j: u64 = out.len;
                while j > 0 {
                    j = j - 1;
                    if out.bytes[j] == 47 { break; };
                }
                if rooted || j > 0 { out.len = j; } else { out.len = 0; };
                if !rooted && out.len == 0 {
                    ps_append_path(out, STR_PTR(".."), STR_LEN(".."));
                    continue;
                };
                if rooted && out.len == 0 { out.len = 1; };
                if out.len > 0 && out.bytes[out.len - 1] == 47 && out.len > 1 { out.len = out.len - 1; };
                continue;
            };
            ps_append_path(out, STR_PTR(".."), STR_LEN(".."));
            continue;
        };
        if out.len > 0 && !(out.len == 1 && rooted) { ps_append_path(out, STR_PTR("/"), STR_LEN("/")); };
        let k: u64 = start;
        while k < i {
            if out.len < 4096 {
                out.bytes[out.len] = ps_byte(p, k);
                out.len = out.len + 1;
            };
            k = k + 1;
        }
    }
    if out.len == 0 && !rooted { ps_append_path(out, STR_PTR("."), STR_LEN(".")); };
}

fn ps_path_join2(a_p: ptr, a_l: u64, b_p: ptr, b_l: u64, out: &PsPath) -> void {
    let cat = PsPath { bytes: [0; 4096], len: 0 };
    ps_append_path(&cat, a_p, a_l);
    ps_append_path(&cat, STR_PTR("/"), STR_LEN("/"));
    ps_append_path(&cat, b_p, b_l);
    ps_path_normalize(ps_path_ptr(&cat), cat.len, out);
}

fn ps_home_dir(out: &PsText) -> void {
    let buf: u64 = sa_env_home_dir();
    if buf == 0 { return; };
    let bp: ptr = sa_env_buffer_data(buf);
    let bl: u64 = sa_env_buffer_len(buf);
    ps_append(out, bp, bl);
}

fn ps_data_dir(out: &PsPath) -> void {
    let home = PsText { bytes: [0; 65536], len: 0 };
    ps_home_dir(&home);
    let pb = PathBuf { bytes: [0; 4096], len: 0 };
    let st: i32 = codexUiDataDir(ps_text_ptr(&home), home.len, &pb);
    let pp: ptr = PTR_NULL();
    PTR_BYTE_ADD(pp, &pb.bytes, 0);
    ps_append_path(out, pp, pb.len);
}

fn ps_now_ms() -> i64 {
    return sa_time_unix_ms();
}

fn ps_random_uuid(out: &PsText) -> void {
    let buf: u64 = sa_deno_random_uuid();
    if buf == 0 { return; };
    let bp: ptr = sa_fmt_buffer_data(buf);
    let bl: u64 = sa_fmt_buffer_len(buf);
    ps_append(out, bp, bl);
    let f: i32 = sa_fmt_buffer_free(buf);
}

// ---- value functions (ps_ renames noted in the header) ----
fn ps_asRecord(value_json: u64, out_json: &u64) -> void {
    if value_json != 0 && sa_json_kind(value_json) == 7 {
        *out_json = value_json;
        return;
    };
    *out_json = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
}

fn ps_stringValue(value_json: u64, out_ptr: &ptr, out_len: &u64) -> bool {
    *out_ptr = PTR_NULL();
    *out_len = 0;
    let p: ptr = PTR_NULL();
    let l: u64 = 0;
    if !ps_jstr(value_json, &p, &l) { return false; };
    let lo: u64 = 0;
    let hi: u64 = 0;
    ps_trim_range(p, l, &lo, &hi);
    if hi <= lo { return false; };
    let seg: ptr = PTR_NULL();
    PTR_BYTE_ADD(seg, p, lo);
    ps_doc_str(STR_PTR("sv"), STR_LEN("sv"), seg, hi - lo, out_ptr, out_len);
    return true;
}

fn ps_field_sv(node: u64, key_p: ptr, key_l: u64, out_p: &ptr, out_l: &u64) -> bool {
    return ps_stringValue(ps_jget(node, key_p, key_l), out_p, out_l);
}

fn numberValue(value_json: u64, out: &f64) -> bool {
    *out = 0.0;
    if value_json == 0 { return false; };
    let k: u32 = sa_json_kind(value_json);
    if k != 2 && k != 3 { return false; };
    let st: i32 = sa_json_as_f64(value_json, out);
    return st == 0;
}

fn ps_field_number(node: u64, key_p: ptr, key_l: u64, out: &f64) -> bool {
    return numberValue(ps_jget(node, key_p, key_l), out);
}

fn nullableNumberValue(value_json: u64, out: &f64, is_null: &bool) -> bool {
    *out = 0.0;
    *is_null = false;
    if value_json == 0 { return false; };
    if sa_json_kind(value_json) == 0 {
        *is_null = true;
        return true;
    };
    return numberValue(value_json, out);
}

fn retryCountValue(value_json: u64, out: &f64) -> bool {
    let v: f64 = 0.0;
    if !numberValue(value_json, &v) { return false; };
    let r: f64 = ps_round(v);
    if r < 5.0 { r = 5.0; };
    if r > 100.0 { r = 100.0; };
    *out = r;
    return true;
}

fn ps_booleanValue(value_json: u64, out: &bool) -> bool {
    *out = false;
    if value_json == 0 { return false; };
    let k: u32 = sa_json_kind(value_json);
    if k == 1 {
        let b: u64 = 0;
        let st: i32 = sa_json_as_bool(value_json, &b);
        if st != 0 { return false; };
        *out = b != 0;
        return true;
    };
    if k == 2 || k == 3 {
        let v: f64 = 0.0;
        let st: i32 = sa_json_as_f64(value_json, &v);
        if st != 0 { return false; };
        if v == 0.0 { *out = false; return true; };
        if v == 1.0 { *out = true; return true; };
        return false;
    };
    return false;
}

fn ps_field_bool(node: u64, key_p: ptr, key_l: u64, out: &bool) -> bool {
    return ps_booleanValue(ps_jget(node, key_p, key_l), out);
}

fn ps_stringArray(value_json: u64, out_json: &u64) -> void {
    let arr: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    *out_json = arr;
    if arr == 0 || value_json == 0 || sa_json_kind(value_json) != 6 { return; };
    let count: u64 = 0;
    let cst: i32 = sa_json_value_count(value_json, &count);
    let i: u64 = 0;
    while i < count {
        let item: u64 = 0;
        let ast: i32 = sa_json_array_get(value_json, i, &item);
        let p: ptr = PTR_NULL();
        let l: u64 = 0;
        if ps_stringValue(item, &p, &l) {
            let pst: i32 = sa_json_array_push_string(arr, p, l);
        };
        i = i + 1;
    }
}

fn ps_field_str_array(node: u64, key_p: ptr, key_l: u64, out_json: &u64) -> void {
    ps_stringArray(ps_jget(node, key_p, key_l), out_json);
}

fn ps_uniqueStrings(values_json: u64, out_json: &u64) -> void {
    let arr: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    *out_json = arr;
    if arr == 0 || values_json == 0 || sa_json_kind(values_json) != 6 { return; };
    let seen = PsText { bytes: [0; 65536], len: 0 };
    let count: u64 = 0;
    let cst: i32 = sa_json_value_count(values_json, &count);
    let i: u64 = 0;
    while i < count {
        let item: u64 = 0;
        let ast: i32 = sa_json_array_get(values_json, i, &item);
        let p: ptr = PTR_NULL();
        let l: u64 = 0;
        if ps_jstr(item, &p, &l) {
            // seen-set as "\n"-joined text with sentinel framing
            let probe = PsText { bytes: [0; 65536], len: 0 };
            ps_append(&probe, STR_PTR("\n"), STR_LEN("\n"));
            ps_append(&probe, p, l);
            ps_append(&probe, STR_PTR("\n"), STR_LEN("\n"));
            if !ps_contains(ps_text_ptr(&seen), seen.len, ps_text_ptr(&probe), probe.len) {
                ps_append(&seen, ps_text_ptr(&probe), probe.len);
                let pst: i32 = sa_json_array_push_string(arr, p, l);
            };
        };
        i = i + 1;
    }
}

fn ps_contains(hay_p: ptr, hay_l: u64, needle_p: ptr, needle_l: u64) -> bool {
    if needle_l > hay_l { return false; };
    if needle_l == 0 { return true; };
    let i: u64 = 0;
    while i + needle_l <= hay_l {
        let hit: bool = true;
        let j: u64 = 0;
        while j < needle_l {
            if ps_byte(hay_p, i + j) != ps_byte(needle_p, j) { hit = false; break; };
            j = j + 1;
        }
        if hit { return true; };
        i = i + 1;
    }
    return false;
}

fn stringArrayFromJson(value_ptr: ptr, value_len: u64, out_json: &u64) -> void {
    let doc: u64 = sa_json_parse(value_ptr, value_len);
    if doc == 0 {
        *out_json = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
        return;
    };
    ps_stringArray(doc, out_json);
    let f: i32 = sa_json_free(doc);
}

fn ps_stringRecord(value_json: u64, out_json: &u64) -> bool {
    *out_json = 0;
    let rec: u64 = 0;
    ps_asRecord(value_json, &rec);
    if rec == 0 || value_json == 0 || sa_json_kind(value_json) != 7 { return false; };
    let out: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    let count: u64 = 0;
    let cst: i32 = sa_json_value_count(rec, &count);
    let kept: u64 = 0;
    let i: u64 = 0;
    while i < count {
        let kp: ptr = PTR_NULL();
        let kl: u64 = 0;
        let kst: i32 = sa_json_object_key_at(rec, i, &kp, &kl);
        if kst == 0 {
            let klo: u64 = 0;
            let khi: u64 = 0;
            ps_trim_range(kp, kl, &klo, &khi);
            if khi > klo {
                let vnode: u64 = ps_jget(rec, kp, kl);
                let vp: ptr = PTR_NULL();
                let vl: u64 = 0;
                if ps_stringValue(vnode, &vp, &vl) {
                    let key_seg: ptr = PTR_NULL();
                    PTR_BYTE_ADD(key_seg, kp, klo);
                    let sst: i32 = sa_json_object_set_string(out, key_seg, khi - klo, vp, vl);
                    kept = kept + 1;
                };
            };
        };
        i = i + 1;
    }
    if kept == 0 {
        let f: i32 = sa_json_free(out);
        return false;
    };
    *out_json = out;
    return true;
}

fn serviceProviderValue(value_json: u64, out_json: &u64) -> bool {
    *out_json = 0;
    let rec: u64 = 0;
    ps_asRecord(value_json, &rec);
    if rec == 0 || value_json == 0 || sa_json_kind(value_json) != 7 { return false; };
    let id_p: ptr = PTR_NULL();
    let id_l: u64 = 0;
    if !ps_field_sv(rec, STR_PTR("id"), STR_LEN("id"), &id_p, &id_l) { return false; };
    let id = PsText { bytes: [0; 65536], len: 0 };
    ps_append(&id, id_p, id_l);
    let name_p: ptr = PTR_NULL();
    let name_l: u64 = 0;
    if !ps_field_sv(rec, STR_PTR("name"), STR_LEN("name"), &name_p, &name_l) { return false; };
    let out: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    if out == 0 { return false; };
    let s1: i32 = sa_json_object_set_string(out, STR_PTR("id"), STR_LEN("id"), ps_text_ptr(&id), id.len);
    let s2: i32 = sa_json_object_set_string(out, STR_PTR("name"), STR_LEN("name"), name_p, name_l);
    let logo_p: ptr = PTR_NULL();
    let logo_l: u64 = 0;
    if ps_field_sv(rec, STR_PTR("logo"), STR_LEN("logo"), &logo_p, &logo_l) {
        if logo_l <= 700000 && ps_is_data_image(logo_p, logo_l) {
            let s3: i32 = sa_json_object_set_string(out, STR_PTR("logo"), STR_LEN("logo"), logo_p, logo_l);
        };
    };
    *out_json = out;
    return true;
}

// /^data:image\/(?:png|jpeg|webp);base64,/i — hand check
fn ps_is_data_image(p: ptr, len: u64) -> bool {
    let pre: ptr = STR_PTR("data:image/");
    let pre_l: u64 = STR_LEN("data:image/");
    if len < pre_l + 5 { return false; };
    let i: u64 = 0;
    while i < pre_l {
        if ps_lower(ps_byte(p, i)) != ps_byte(pre, i) { return false; };
        i = i + 1;
    }
    let rest: ptr = PTR_NULL();
    PTR_BYTE_ADD(rest, p, pre_l);
    let rest_l: u64 = len - pre_l;
    let kind_l: u64 = 0;
    if ps_starts_with_ci(rest, rest_l, STR_PTR("png"), STR_LEN("png")) { kind_l = 3; };
    if kind_l == 0 && ps_starts_with_ci(rest, rest_l, STR_PTR("jpeg"), STR_LEN("jpeg")) { kind_l = 4; };
    if kind_l == 0 && ps_starts_with_ci(rest, rest_l, STR_PTR("webp"), STR_LEN("webp")) { kind_l = 4; };
    if kind_l == 0 { return false; };
    let tail: ptr = PTR_NULL();
    PTR_BYTE_ADD(tail, rest, kind_l);
    return ps_starts_with_ci(tail, rest_l - kind_l, STR_PTR(";base64,"), STR_LEN(";base64,"));
}

fn ps_starts_with_ci(p: ptr, len: u64, pre: ptr, pre_len: u64) -> bool {
    if pre_len > len { return false; };
    let j: u64 = 0;
    while j < pre_len {
        if ps_lower(ps_byte(p, j)) != ps_lower(ps_byte(pre, j)) { return false; };
        j = j + 1;
    }
    return true;
}

// enum validators over ps_stringValue
fn ps_enum2(node: u64, a_p: ptr, a_l: u64, b_p: ptr, b_l: u64, out_p: &ptr, out_l: &u64) -> bool {
    let p: ptr = PTR_NULL();
    let l: u64 = 0;
    if !ps_stringValue(node, &p, &l) { return false; };
    if ps_eq(p, l, a_p, a_l) || ps_eq(p, l, b_p, b_l) {
        ps_doc_str(STR_PTR("enum"), STR_LEN("enum"), p, l, out_p, out_l);
        return true;
    };
    return false;
}

