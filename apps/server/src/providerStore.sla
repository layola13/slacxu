fn booleanToSql(value: u64, has_value: bool) -> i64 {
    if !has_value { return -1; };
    let b: bool = false;
    if !ps_booleanValue(value, &b) { return -1; };
    if b { return 1; };
    return 0;
}

fn sqlBooleanValue(value: i64, has_value: bool, out: &bool) -> bool {
    *out = false;
    if !has_value { return false; };
    if value == 0 { *out = false; return true; };
    if value == 1 { *out = true; return true; };
    return false;
}

fn jsonFromString(value_ptr: ptr, value_len: u64, has_value: bool, out_json: &u64) -> bool {
    *out_json = 0;
    if !has_value { return false; };
    let doc: u64 = sa_json_parse(value_ptr, value_len);
    if doc == 0 { return false; };
    *out_json = doc;
    return true;
}

// ---- mapping / ratio arrays ----
fn tieredContextRatioArray(value_json: u64, out_json: &u64) -> bool {
    *out_json = 0;
    if value_json == 0 || sa_json_kind(value_json) != 6 { return false; };
    let out: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    let count: u64 = 0;
    let cst: i32 = sa_json_value_count(value_json, &count);
    let i: u64 = 0;
    while i < count {
        let item: u64 = 0;
        let ast: i32 = sa_json_array_get(value_json, i, &item);
        let rec: u64 = 0;
        ps_asRecord(item, &rec);
        if item != 0 && sa_json_kind(item) == 7 {
            let min_t: f64 = 0.0;
            let ratio: f64 = 0.0;
            let max_v: f64 = 0.0;
            let max_null: bool = false;
            let ok: bool = ps_field_number(rec, STR_PTR("minTokens"), STR_LEN("minTokens"), &min_t)
                && ps_field_number(rec, STR_PTR("ratio"), STR_LEN("ratio"), &ratio)
                && nullableNumberValue(ps_jget(rec, STR_PTR("maxTokens"), STR_LEN("maxTokens")), &max_v, &max_null);
            if ok {
                let entry: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
                if entry != 0 {
                    let e1: i32 = sa_json_object_set_f64(entry, STR_PTR("minTokens"), STR_LEN("minTokens"), min_t);
                    if max_null {
                        let e2: i32 = sa_json_object_set_null(entry, STR_PTR("maxTokens"), STR_LEN("maxTokens"));
                    } else {
                        let e2: i32 = sa_json_object_set_f64(entry, STR_PTR("maxTokens"), STR_LEN("maxTokens"), max_v);
                    };
                    let e3: i32 = sa_json_object_set_f64(entry, STR_PTR("ratio"), STR_LEN("ratio"), ratio);
                    let pst: i32 = sa_json_array_push_node(out, entry);
                };
            };
        };
        i = i + 1;
    }
    let kept: u64 = 0;
    let kst: i32 = sa_json_value_count(out, &kept);
    if kept == 0 {
        let f: i32 = sa_json_free(out);
        return false;
    };
    *out_json = out;
    return true;
}

fn tieredContextRatioArrayFromJson(value_ptr: ptr, value_len: u64, out_json: &u64) -> bool {
    let doc: u64 = sa_json_parse(value_ptr, value_len);
    if doc == 0 { *out_json = 0; return false; };
    let ok: bool = tieredContextRatioArray(doc, out_json);
    let f: i32 = sa_json_free(doc);
    return ok;
}

fn modelMappingArray(value_json: u64, out_json: &u64) -> bool {
    *out_json = 0;
    if value_json == 0 || sa_json_kind(value_json) != 6 { return false; };
    let out: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    let count: u64 = 0;
    let cst: i32 = sa_json_value_count(value_json, &count);
    let i: u64 = 0;
    while i < count {
        let item: u64 = 0;
        let ast: i32 = sa_json_array_get(value_json, i, &item);
        if item != 0 && sa_json_kind(item) == 7 {
            let from_p: ptr = PTR_NULL();
            let from_l: u64 = 0;
            let to_p: ptr = PTR_NULL();
            let to_l: u64 = 0;
            let okf: bool = ps_field_sv(item, STR_PTR("from"), STR_LEN("from"), &from_p, &from_l);
            let from = PsText { bytes: [0; 65536], len: 0 };
            if okf { ps_append(&from, from_p, from_l); };
            let okt: bool = ps_field_sv(item, STR_PTR("to"), STR_LEN("to"), &to_p, &to_l);
            if okf && okt {
                let entry: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
                if entry != 0 {
                    let e1: i32 = sa_json_object_set_string(entry, STR_PTR("from"), STR_LEN("from"), ps_text_ptr(&from), from.len);
                    let e2: i32 = sa_json_object_set_string(entry, STR_PTR("to"), STR_LEN("to"), to_p, to_l);
                    let pst: i32 = sa_json_array_push_node(out, entry);
                };
            };
        };
        i = i + 1;
    }
    let kept: u64 = 0;
    let kst: i32 = sa_json_value_count(out, &kept);
    if kept == 0 {
        let f: i32 = sa_json_free(out);
        return false;
    };
    *out_json = out;
    return true;
}

fn modelMappingArrayFromJson(value_ptr: ptr, value_len: u64, out_json: &u64) -> bool {
    let doc: u64 = sa_json_parse(value_ptr, value_len);
    if doc == 0 { *out_json = 0; return false; };
    let ok: bool = modelMappingArray(doc, out_json);
    let f: i32 = sa_json_free(doc);
    return ok;
}

fn advancedModelMappingArray(value_json: u64, out_json: &u64) -> bool {
    *out_json = 0;
    if value_json == 0 || sa_json_kind(value_json) != 6 { return false; };
    let out: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    let count: u64 = 0;
    let cst: i32 = sa_json_value_count(value_json, &count);
    let i: u64 = 0;
    while i < count {
        let item: u64 = 0;
        let ast: i32 = sa_json_array_get(value_json, i, &item);
        if item != 0 && sa_json_kind(item) == 7 {
            let req_p: ptr = PTR_NULL();
            let req_l: u64 = 0;
            let has_req: bool = ps_field_sv(item, STR_PTR("requestModel"), STR_LEN("requestModel"), &req_p, &req_l);
            let req = PsText { bytes: [0; 65536], len: 0 };
            if has_req { ps_append(&req, req_p, req_l); };
            if !has_req {
                has_req = ps_field_sv(item, STR_PTR("from"), STR_LEN("from"), &req_p, &req_l);
                if has_req { ps_append(&req, req_p, req_l); };
            };
            let tgt_p: ptr = PTR_NULL();
            let tgt_l: u64 = 0;
            let has_tgt: bool = ps_field_sv(item, STR_PTR("targetModel"), STR_LEN("targetModel"), &tgt_p, &tgt_l);
            let tgt = PsText { bytes: [0; 65536], len: 0 };
            if has_tgt { ps_append(&tgt, tgt_p, tgt_l); };
            if !has_tgt {
                has_tgt = ps_field_sv(item, STR_PTR("to"), STR_LEN("to"), &tgt_p, &tgt_l);
                if has_tgt { ps_append(&tgt, tgt_p, tgt_l); };
            };
            if has_req && has_tgt {
                let entry: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
                if entry != 0 {
