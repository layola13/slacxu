    allow_danger_bypass: i64,
    workspace_root: [u8; 512], workspace_root_len: u64,
    notes: [u8; 1024], notes_len: u64,
    totp_secret: [u8; 256], totp_secret_len: u64,
    totp_enabled: i64,
    totp_enabled_at: i64, has_totp_enabled_at: bool, // number|null
    created_at: u64,
    updated_at: u64,
    deleted_at: u64, has_deleted_at: bool,          // number|null
}

