// ---- L93-98 — const PERMISSION_RANK ----
fn PERMISSION_RANK(permission_ptr: ptr, permission_len: u64) -> i64 {
    if au_eq(permission_ptr, permission_len, STR_PTR("readonlyAsk"), STR_LEN("readonlyAsk")) { return 0; };
    if au_eq(permission_ptr, permission_len, STR_PTR("workspaceAsk"), STR_LEN("workspaceAsk")) { return 1; };
    if au_eq(permission_ptr, permission_len, STR_PTR("fullAsk"), STR_LEN("fullAsk")) { return 2; };
    if au_eq(permission_ptr, permission_len, STR_PTR("dangerBypass"), STR_LEN("dangerBypass")) { return 3; };
    return -1;
}

// ---- au_ text toolkit ----
struct AuText { bytes: [u8; 65536], len: u64 }
struct AuSmall { bytes: [u8; 8192], len: u64 }
struct AuPath { bytes: [u8; 4096], len: u64 }

fn au_text_ptr(t: &AuText) -> ptr {
    let p: ptr = PTR_NULL();
    PTR_BYTE_ADD(p, &t.bytes, 0);
    return p;
}

fn au_small_ptr(t: &AuSmall) -> ptr {
    let p: ptr = PTR_NULL();
    PTR_BYTE_ADD(p, &t.bytes, 0);
    return p;
}

fn au_path_ptr(t: &AuPath) -> ptr {
    let p: ptr = PTR_NULL();
    PTR_BYTE_ADD(p, &t.bytes, 0);
    return p;
}

fn au_append(dst: &AuText, p: ptr, len: u64) -> void {
    let i: u64 = 0;
    while i < len {
        if dst.len < 65536 {
            let b: u8 = 0;
            PTR_BYTE_AT(b, p, i);
            dst.bytes[dst.len] = b;
            dst.len = dst.len + 1;
        };
        i = i + 1;
    }
}

fn au_append_small(dst: &AuSmall, p: ptr, len: u64) -> void {
    let i: u64 = 0;
    while i < len {
        if dst.len < 8192 {
            let b: u8 = 0;
            PTR_BYTE_AT(b, p, i);
            dst.bytes[dst.len] = b;
            dst.len = dst.len + 1;
        };
        i = i + 1;
    }
}

fn au_append_path(dst: &AuPath, p: ptr, len: u64) -> void {
    let i: u64 = 0;
    while i < len {
        if dst.len < 4096 {
            let b: u8 = 0;
            PTR_BYTE_AT(b, p, i);
            dst.bytes[dst.len] = b;
            dst.len = dst.len + 1;
        };
        i = i + 1;
    }
}

fn au_byte(p: ptr, i: u64) -> u8 {
    let b: u8 = 0;
    PTR_BYTE_AT(b, p, i);
    return b;
}

fn au_lower(c: u8) -> u8 {
    if c >= 65 && c <= 90 { return c + 32; };
    return c;
}

fn au_eq(p: ptr, len: u64, q: ptr, qlen: u64) -> bool {
    if len != qlen { return false; };
    let i: u64 = 0;
    while i < len {
        if au_byte(p, i) != au_byte(q, i) { return false; };
        i = i + 1;
    }
    return true;
}

fn au_starts_with(p: ptr, len: u64, pre: ptr, pre_len: u64) -> bool {
    if pre_len > len { return false; };
    let j: u64 = 0;
    while j < pre_len {
        if au_byte(p, j) != au_byte(pre, j) { return false; };
        j = j + 1;
    }
    return true;
}

fn au_ends_with_ci(p: ptr, len: u64, suf: ptr, suf_len: u64) -> bool {
    if suf_len > len { return false; };
    let off: u64 = len - suf_len;
    let j: u64 = 0;
    while j < suf_len {
        if au_lower(au_byte(p, off + j)) != au_lower(au_byte(suf, j)) { return false; };
        j = j + 1;
    }
    return true;
}

fn au_trim_range(p: ptr, len: u64, lo: &u64, hi: &u64) -> void {
    let a: u64 = 0;
    let b: u64 = len;
    while a < b {
        let c: u8 = au_byte(p, a);
        if c == 32 || c == 9 || c == 10 || c == 13 || c == 11 || c == 12 { a = a + 1; } else { break; };
    }
    while b > a {
        let c2: u8 = au_byte(p, b - 1);
        if c2 == 32 || c2 == 9 || c2 == 10 || c2 == 13 || c2 == 11 || c2 == 12 { b = b - 1; } else { break; };
    }
    *lo = a;
    *hi = b;
}

// ---- JSON helpers ----
fn au_parse(p: ptr, len: u64) -> u64 {
    if len == 0 { return 0; };
    return sa_json_parse(p, len);
}

fn au_jget(node: u64, key_p: ptr, key_l: u64) -> u64 {
    if node == 0 { return 0; };
    let out: u64 = 0;
    let st: i32 = sa_json_object_get(node, key_p, key_l, &out);
    if st != 0 { return 0; };
    return out;
}

fn au_jstr(node: u64, out_p: &ptr, out_l: &u64) -> bool {
    *out_p = PTR_NULL();
    *out_l = 0;
    if node == 0 || sa_json_kind(node) != 5 { return false; };
    *out_p = sa_json_string_ptr(node);
    *out_l = sa_json_string_len(node);
    return true;
}

fn au_field_str(node: u64, key_p: ptr, key_l: u64, out_p: &ptr, out_l: &u64) -> bool {
    return au_jstr(au_jget(node, key_p, key_l), out_p, out_l);
}

fn au_field_num(node: u64, key_p: ptr, key_l: u64, out_v: &f64) -> bool {
    let v: u64 = au_jget(node, key_p, key_l);
    if v == 0 { return false; };
    let k: u32 = sa_json_kind(v);
    if k != 2 && k != 3 { return false; };
    let st: i32 = sa_json_as_f64(v, out_v);
    return st == 0;
}

fn au_field_bool(node: u64, key_p: ptr, key_l: u64) -> bool {
    let v: u64 = au_jget(node, key_p, key_l);
    if v == 0 || sa_json_kind(v) != 1 { return false; };
    let b: u64 = 0;
    let st: i32 = sa_json_as_bool(v, &b);
    return st == 0 && b != 0;
}

// scratch doc for string results (valid until the next write of the
// same field)
fn au_scratch() -> u64 {
    let doc: u64 = 0;
    let st: i32 = sa_global_u64_get(STR_PTR("authstore.scratch"), STR_LEN("authstore.scratch"), &doc);
    if st == 0 && doc != 0 { return doc; };
    let fresh: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    let sst: i32 = sa_global_u64_set(STR_PTR("authstore.scratch"), STR_LEN("authstore.scratch"), fresh);
    return fresh;
}

fn au_doc_str(key_p: ptr, key_l: u64, val_p: ptr, val_l: u64, out_p: &ptr, out_l: &u64) -> void {
    let doc: u64 = au_scratch();
    *out_p = PTR_NULL();
    *out_l = 0;
    if doc == 0 { return; };
    let st: i32 = sa_json_object_set_string(doc, key_p, key_l, val_p, val_l);
    au_field_str(doc, key_p, key_l, out_p, out_l);
}

// last-error channel for TS throws
fn au_throw(msg_p: ptr, msg_l: u64) -> i32 {
    let doc: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    if doc != 0 {
        let s1: i32 = sa_json_object_set_string(doc, STR_PTR("error"), STR_LEN("error"), msg_p, msg_l);
        let old: u64 = 0;
        let gst: i32 = sa_global_u64_get(STR_PTR("authstore.lasterror"), STR_LEN("authstore.lasterror"), &old);
        if gst == 0 && old != 0 {
            let f: i32 = sa_json_free(old);
        };
        let sst: i32 = sa_global_u64_set(STR_PTR("authstore.lasterror"), STR_LEN("authstore.lasterror"), doc);
    };
    return 1;
}

fn AuthStore_takeLastError(out_json: &u64) -> bool {
    let doc: u64 = 0;
    let st: i32 = sa_global_u64_get(STR_PTR("authstore.lasterror"), STR_LEN("authstore.lasterror"), &doc);
    *out_json = doc;
    return st == 0 && doc != 0;
}

// ---- sqlite wrappers (one macro per fn: macro temp names key on
// the out-variable names — the agy pattern) ----
fn au_exec(db: u64, sql_p: ptr, sql_l: u64) -> i32 {
    if db == 0 { return 1; };
    let st: u64 = 0;
    SA_SQLITE_EXEC(st, db, sql_p, sql_l);
    return st as i32;
}

fn au_prepare(db: u64, sql_p: ptr, sql_l: u64) -> u64 {
    if db == 0 { return 0; };
    let st: u64 = 0;
    let stmt: u64 = 0;
    SA_SQLITE_PREPARE(st, stmt, db, sql_p, sql_l);
    return stmt;
}

fn au_bind_text(stmt: u64, idx: u64, val_p: ptr, val_l: u64) -> void {
    let st: u64 = 0;
    SA_SQLITE_BIND_TEXT(st, stmt, idx, val_p, val_l);
}

fn au_bind_int(stmt: u64, idx: u64, value: i64) -> void {
    let st: u64 = 0;
    let v: u64 = value as u64;
    SA_SQLITE_BIND_INT(st, stmt, idx, v);
}

fn au_bind_double(stmt: u64, idx: u64, value: f64) -> void {
    let st: u64 = 0;
    SA_SQLITE_BIND_DOUBLE(st, stmt, idx, value);
}

fn au_bind_null(stmt: u64, idx: u64) -> void {
    let st: u64 = 0;
    SA_SQLITE_BIND_NULL(st, stmt, idx);
}

// Step once; on a row, out_doc receives the parsed row object
// (columns by name). Caller frees the doc.
fn au_step_row(stmt: u64, out_doc: &u64) -> bool {
    *out_doc = 0;
    let st: u64 = 0;
    let ready: u64 = 0;
    let rp: ptr = PTR_NULL();
    let rl: u64 = 0;
    SA_SQLITE_STEP_JSON(st, ready, rp, rl, stmt);
    if ready == 0 { return false; };
    *out_doc = sa_json_parse(rp, rl);
    return *out_doc != 0;
}

fn au_step_once(stmt: u64) -> void {
    let st: u64 = 0;
    let ready: u64 = 0;
    let rp: ptr = PTR_NULL();
    let rl: u64 = 0;
    SA_SQLITE_STEP_JSON(st, ready, rp, rl, stmt);
}

fn au_finalize(stmt: u64) -> void {
    if stmt == 0 { return; };
    let st: u64 = 0;
    SA_SQLITE_FINALIZE(st, stmt);
}

// prepare + step + finalize for run()-style statements
fn au_run(db: u64, sql_p: ptr, sql_l: u64) -> u64 {
    let stmt: u64 = au_prepare(db, sql_p, sql_l);
    if stmt == 0 { return 0; };
    au_step_once(stmt);
    au_finalize(stmt);
    return stmt;
}

// ---- row -> UserRow ----
fn au_col_text(row: u64, key_p: ptr, key_l: u64, out_p: &ptr, out_l: &u64) -> bool {
    return au_field_str(row, key_p, key_l, out_p, out_l);
}

fn au_col_f64(row: u64, key_p: ptr, key_l: u64) -> f64 {
    let v: f64 = 0.0;
    if au_field_num(row, key_p, key_l, &v) { return v; };
    return 0.0;
}

fn au_col_i64(row: u64, key_p: ptr, key_l: u64) -> i64 {
    let v: u64 = au_jget(row, key_p, key_l);
    if v == 0 { return 0; };
    let k: u32 = sa_json_kind(v);
    if k != 2 && k != 3 { return 0; };
    let out: i64 = 0;
    let st: i32 = sa_json_as_i64(v, &out);
    if st != 0 { return 0; };
    return out;
}

fn au_col_is_null(row: u64, key_p: ptr, key_l: u64) -> bool {
    let v: u64 = au_jget(row, key_p, key_l);
    if v == 0 { return true; };
    return sa_json_kind(v) == 0;
}

// field readers by code (arrays cannot be passed generically)
fn au_row_field(row: &UserRow, code: u64, out_p: &ptr, out_l: &u64) -> void {
    *out_p = PTR_NULL();
    *out_l = 0;
    if code == 0 { PTR_BYTE_ADD(*out_p, &row.id, 0); *out_l = row.id_len; };
    if code == 1 { PTR_BYTE_ADD(*out_p, &row.email, 0); *out_l = row.email_len; };
    if code == 2 { PTR_BYTE_ADD(*out_p, &row.username, 0); *out_l = row.username_len; };
    if code == 3 { PTR_BYTE_ADD(*out_p, &row.password_hash, 0); *out_l = row.password_hash_len; };
    if code == 4 { PTR_BYTE_ADD(*out_p, &row.role, 0); *out_l = row.role_len; };
    if code == 5 { PTR_BYTE_ADD(*out_p, &row.status, 0); *out_l = row.status_len; };
    if code == 6 { PTR_BYTE_ADD(*out_p, &row.max_permission, 0); *out_l = row.max_permission_len; };
    if code == 7 { PTR_BYTE_ADD(*out_p, &row.workspace_root, 0); *out_l = row.workspace_root_len; };
    if code == 8 { PTR_BYTE_ADD(*out_p, &row.notes, 0); *out_l = row.notes_len; };
    if code == 9 { PTR_BYTE_ADD(*out_p, &row.totp_secret, 0); *out_l = row.totp_secret_len; };
}

fn au_cfg_field(cfg: &AuthConfig, code: u64, out_p: &ptr, out_l: &u64) -> void {
    *out_p = PTR_NULL();
    *out_l = 0;
    if code == 0 { PTR_BYTE_ADD(*out_p, &cfg.jwtSecret, 0); *out_l = cfg.jwtSecret_len; };
    if code == 1 { PTR_BYTE_ADD(*out_p, &cfg.adminEmail, 0); *out_l = cfg.adminEmail_len; };
    if code == 2 { PTR_BYTE_ADD(*out_p, &cfg.adminPassword, 0); *out_l = cfg.adminPassword_len; };
    if code == 3 { PTR_BYTE_ADD(*out_p, &cfg.membersRoot, 0); *out_l = cfg.membersRoot_len; };
}

fn au_fill_user_row(row: u64, out: &UserRow) -> void {
    let p: ptr = PTR_NULL();
    let l: u64 = 0;
    out.id_len = 0;
    if au_col_text(row, STR_PTR("id"), STR_LEN("id"), &p, &l) {
        let i: u64 = 0;
        while i < l && i < 64 { out.id[i] = au_byte(p, i); i = i + 1; }
        out.id_len = i;
    };
    out.email_len = 0;
    if au_col_text(row, STR_PTR("email"), STR_LEN("email"), &p, &l) {
        let i: u64 = 0;
        while i < l && i < 320 { out.email[i] = au_byte(p, i); i = i + 1; }
        out.email_len = i;
    };
    out.username_len = 0;
    if au_col_text(row, STR_PTR("username"), STR_LEN("username"), &p, &l) {
        let i: u64 = 0;
        while i < l && i < 256 { out.username[i] = au_byte(p, i); i = i + 1; }
        out.username_len = i;
    };
    out.password_hash_len = 0;
    if au_col_text(row, STR_PTR("password_hash"), STR_LEN("password_hash"), &p, &l) {
        let i: u64 = 0;
        while i < l && i < 512 { out.password_hash[i] = au_byte(p, i); i = i + 1; }
        out.password_hash_len = i;
    };
    out.role_len = 0;
    if au_col_text(row, STR_PTR("role"), STR_LEN("role"), &p, &l) {
        let i: u64 = 0;
        while i < l && i < 16 { out.role[i] = au_byte(p, i); i = i + 1; }
        out.role_len = i;
    };
    out.status_len = 0;
    if au_col_text(row, STR_PTR("status"), STR_LEN("status"), &p, &l) {
        let i: u64 = 0;
        while i < l && i < 16 { out.status[i] = au_byte(p, i); i = i + 1; }
        out.status_len = i;
    };
    out.balance = au_col_f64(row, STR_PTR("balance"), STR_LEN("balance"));
    out.concurrency = au_col_i64(row, STR_PTR("concurrency"), STR_LEN("concurrency"));
    out.max_permission_len = 0;
    if au_col_text(row, STR_PTR("max_permission"), STR_LEN("max_permission"), &p, &l) {
        let i: u64 = 0;
        while i < l && i < 32 { out.max_permission[i] = au_byte(p, i); i = i + 1; }
        out.max_permission_len = i;
    };
    out.allow_write = au_col_i64(row, STR_PTR("allow_write"), STR_LEN("allow_write"));
    out.allow_network = au_col_i64(row, STR_PTR("allow_network"), STR_LEN("allow_network"));
    out.allow_danger_bypass = au_col_i64(row, STR_PTR("allow_danger_bypass"), STR_LEN("allow_danger_bypass"));
    out.workspace_root_len = 0;
    if au_col_text(row, STR_PTR("workspace_root"), STR_LEN("workspace_root"), &p, &l) {
        let i: u64 = 0;
        while i < l && i < 512 { out.workspace_root[i] = au_byte(p, i); i = i + 1; }
        out.workspace_root_len = i;
    };
    out.notes_len = 0;
    if au_col_text(row, STR_PTR("notes"), STR_LEN("notes"), &p, &l) {
        let i: u64 = 0;
        while i < l && i < 1024 { out.notes[i] = au_byte(p, i); i = i + 1; }
        out.notes_len = i;
    };
    out.totp_secret_len = 0;
    if au_col_text(row, STR_PTR("totp_secret"), STR_LEN("totp_secret"), &p, &l) {
        let i: u64 = 0;
        while i < l && i < 256 { out.totp_secret[i] = au_byte(p, i); i = i + 1; }
        out.totp_secret_len = i;
    };
    out.totp_enabled = au_col_i64(row, STR_PTR("totp_enabled"), STR_LEN("totp_enabled"));
    out.has_totp_enabled_at = !au_col_is_null(row, STR_PTR("totp_enabled_at"), STR_LEN("totp_enabled_at"));
    out.totp_enabled_at = au_col_i64(row, STR_PTR("totp_enabled_at"), STR_LEN("totp_enabled_at"));
    out.created_at = au_col_i64(row, STR_PTR("created_at"), STR_LEN("created_at")) as u64;
    out.updated_at = au_col_i64(row, STR_PTR("updated_at"), STR_LEN("updated_at")) as u64;
    out.has_deleted_at = !au_col_is_null(row, STR_PTR("deleted_at"), STR_LEN("deleted_at"));
    out.deleted_at = au_col_i64(row, STR_PTR("deleted_at"), STR_LEN("deleted_at")) as u64;
}

// ---- authStore.ts:1133-1149 — authUserFromRow ----
fn authUserFromRow(row: &UserRow, out_json: &u64) -> void {
    let doc: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    *out_json = doc;
    if doc == 0 { return; };
    let p: ptr = PTR_NULL();
    let l: u64 = 0;
    au_row_field(row, 0, &p, &l);
    let s1: i32 = sa_json_object_set_string(doc, STR_PTR("id"), STR_LEN("id"), p, l);
    au_row_field(row, 1, &p, &l);
    let s2: i32 = sa_json_object_set_string(doc, STR_PTR("email"), STR_LEN("email"), p, l);
    au_row_field(row, 2, &p, &l);
    let s3: i32 = sa_json_object_set_string(doc, STR_PTR("username"), STR_LEN("username"), p, l);
    au_row_field(row, 4, &p, &l);
    let s4: i32 = sa_json_object_set_string(doc, STR_PTR("role"), STR_LEN("role"), p, l);
    au_row_field(row, 5, &p, &l);
    let s5: i32 = sa_json_object_set_string(doc, STR_PTR("status"), STR_LEN("status"), p, l);
    let s6: i32 = sa_json_object_set_f64(doc, STR_PTR("balance"), STR_LEN("balance"), row.balance);
    let s7: i32 = sa_json_object_set_i64(doc, STR_PTR("concurrency"), STR_LEN("concurrency"), row.concurrency);
    au_row_field(row, 6, &p, &l);
    let s8: i32 = sa_json_object_set_string(doc, STR_PTR("maxPermission"), STR_LEN("maxPermission"), p, l);
    let s9: i32 = sa_json_object_set_bool(doc, STR_PTR("allowWrite"), STR_LEN("allowWrite"), row.allow_write != 0);
    let s10: i32 = sa_json_object_set_bool(doc, STR_PTR("allowNetwork"), STR_LEN("allowNetwork"), row.allow_network != 0);
    let s11: i32 = sa_json_object_set_bool(doc, STR_PTR("allowDangerBypass"), STR_LEN("allowDangerBypass"), row.allow_danger_bypass != 0);
    au_row_field(row, 7, &p, &l);
    let s12: i32 = sa_json_object_set_string(doc, STR_PTR("workspaceRoot"), STR_LEN("workspaceRoot"), p, l);
    au_row_field(row, 8, &p, &l);
    let s13: i32 = sa_json_object_set_string(doc, STR_PTR("notes"), STR_LEN("notes"), p, l);
    let s14: i32 = sa_json_object_set_bool(doc, STR_PTR("totpEnabled"), STR_LEN("totpEnabled"), row.totp_enabled != 0);
}

// ---- path helpers (join = normalize, POSIX subset) ----
fn au_seg_eq(p: ptr, a: u64, b: u64, lit_p: ptr, lit_l: u64) -> bool {
    if b - a != lit_l { return false; };
    let j: u64 = 0;
    while j < lit_l {
        if au_byte(p, a + j) != au_byte(lit_p, j) { return false; };
        j = j + 1;
    }
    return true;
}

fn au_path_normalize(p: ptr, len: u64, out: &AuPath) -> void {
    let rooted: bool = len > 0 && au_byte(p, 0) == 47;
    out.len = 0;
    if rooted { out.bytes[0] = 47; out.len = 1; };
    let i: u64 = 0;
    while i < len {
        while i < len && au_byte(p, i) == 47 { i = i + 1; }
        if i >= len { break; };
        let start: u64 = i;
        while i < len && au_byte(p, i) != 47 { i = i + 1; }
        if au_seg_eq(p, start, i, STR_PTR("."), STR_LEN(".")) { continue; };
        if au_seg_eq(p, start, i, STR_PTR(".."), STR_LEN("..")) {
            if out.len > 1 || (out.len == 1 && !rooted) {
                let j: u64 = out.len;
                while j > 0 {
                    j = j - 1;
                    if out.bytes[j] == 47 { break; };
                }
                if rooted || j > 0 { out.len = j; } else { out.len = 0; };
                if !rooted && out.len == 0 {
                    // stack empty: keep ".." for relative paths
                    au_append_path(out, STR_PTR(".."), STR_LEN(".."));
                    continue;
                };
                if rooted && out.len == 0 { out.len = 1; };
                if out.len > 0 && out.bytes[out.len - 1] == 47 && out.len > 1 { out.len = out.len - 1; };
                continue;
            };
            au_append_path(out, STR_PTR(".."), STR_LEN(".."));
            continue;
        };
        if out.len > 0 && !(out.len == 1 && rooted) { au_append_path(out, STR_PTR("/"), STR_LEN("/")); };
        let k: u64 = start;
        while k < i {
            if out.len < 4096 {
                out.bytes[out.len] = au_byte(p, k);
                out.len = out.len + 1;
            };
            k = k + 1;
        }
    }
    if out.len == 0 && !rooted { au_append_path(out, STR_PTR("."), STR_LEN(".")); };
}

fn au_path_join2(a_p: ptr, a_l: u64, b_p: ptr, b_l: u64, out: &AuPath) -> void {
    let cat = AuPath { bytes: [0; 4096], len: 0 };
    au_append_path(&cat, a_p, a_l);
    au_append_path(&cat, STR_PTR("/"), STR_LEN("/"));
    au_append_path(&cat, b_p, b_l);
    au_path_normalize(au_path_ptr(&cat), cat.len, out);
}

fn au_path_join3(a_p: ptr, a_l: u64, b_p: ptr, b_l: u64, c_p: ptr, c_l: u64, out: &AuPath) -> void {
    let t = AuPath { bytes: [0; 4096], len: 0 };
    au_path_join2(a_p, a_l, b_p, b_l, &t);
    au_path_join2(au_path_ptr(&t), t.len, c_p, c_l, out);
}

fn au_dirname(p: ptr, len: u64, out: &AuPath) -> void {
    let n = AuPath { bytes: [0; 4096], len: 0 };
    au_path_normalize(p, len, &n);
    let np: ptr = au_path_ptr(&n);
    let idx: u64 = n.len;
    let found: bool = false;
    while idx > 0 {
        idx = idx - 1;
        if au_byte(np, idx) == 47 { found = true; break; };
    }
    out.len = 0;
    if !found {
        au_append_path(out, STR_PTR("."), STR_LEN("."));
        return;
    };
    if idx == 0 {
        au_append_path(out, STR_PTR("/"), STR_LEN("/"));
        return;
    };
    au_append_path(out, np, idx);
}

fn au_fs_exists(p: ptr, len: u64) -> bool {
    return sa_std_fs_exists(p, len) == 0;
}

fn au_mkdir_p(p: ptr, len: u64) -> void {
    let st: i32 = sa_fs_mkdir_p(p, len);
}

// ---- random helpers ----
fn au_hex_digit(v: u8) -> u8 {
    if v < 10 { return 48 + v; };
    return 87 + v;
}

fn au_random_hex(nbytes: u64, out: &AuText) -> void {
    let raw: [u8; 64] = [0; 64];
    let rp: ptr = PTR_NULL();
    PTR_BYTE_ADD(rp, &raw, 0);
    let st: i32 = sa_crypto_random_bytes(rp, nbytes);
    let i: u64 = 0;
    while i < nbytes {
        let b: u8 = raw[i];
        if out.len < 65534 {
            out.bytes[out.len] = au_hex_digit(b / 16);
            out.len = out.len + 1;
            out.bytes[out.len] = au_hex_digit(b % 16);
            out.len = out.len + 1;
        };
        i = i + 1;
    }
}

fn au_random_uuid(out: &AuText) -> void {
    let buf: u64 = sa_deno_random_uuid();
    if buf == 0 { return; };
    let bp: ptr = sa_fmt_buffer_data(buf);
    let bl: u64 = sa_fmt_buffer_len(buf);
    au_append(out, bp, bl);
    let f: i32 = sa_fmt_buffer_free(buf);
}

fn au_home_dir(out: &AuText) -> void {
    let buf: u64 = sa_env_home_dir();
    if buf == 0 { return; };
    let bp: ptr = sa_env_buffer_data(buf);
    let bl: u64 = sa_env_buffer_len(buf);
    au_append(out, bp, bl);
}

// dataDir via the SDK fn (env comes from the real environment —
// registered seam when an env_json doc is in play)
fn au_data_dir(out: &AuPath) -> void {
    let home = AuText { bytes: [0; 65536], len: 0 };
    au_home_dir(&home);
    let pb = PathBuf { bytes: [0; 4096], len: 0 };
    let st: i32 = codexUiDataDir(au_text_ptr(&home), home.len, &pb);
    let pp: ptr = PTR_NULL();
    PTR_BYTE_ADD(pp, &pb.bytes, 0);
    au_append_path(out, pp, pb.len);
}

// ---- base64url + JWT (authStore.ts:1151-1238) ----
fn au_b64_char(v: u8) -> u8 {
    if v < 26 { return 65 + v; };
    if v < 52 { return 97 + (v - 26); };
    if v < 62 { return 48 + (v - 52); };
    if v == 62 { return 45; };
    return 95;
}

fn au_b64url_encode(p: ptr, len: u64, out: &AuText) -> void {
    let i: u64 = 0;
    while i + 3 <= len {
        let b0: u64 = au_byte(p, i) as u64;
        let b1: u64 = au_byte(p, i + 1) as u64;
        let b2: u64 = au_byte(p, i + 2) as u64;
        let n: u64 = (b0 * 65536) + (b1 * 256) + b2;
        if out.len < 65532 {
            out.bytes[out.len] = au_b64_char(((n / 262144) % 64) as u8);
            out.bytes[out.len + 1] = au_b64_char(((n / 4096) % 64) as u8);
            out.bytes[out.len + 2] = au_b64_char(((n / 64) % 64) as u8);
            out.bytes[out.len + 3] = au_b64_char((n % 64) as u8);
            out.len = out.len + 4;
        };
        i = i + 3;
    }
    let rem: u64 = len - i;
    if rem == 1 {
        let b0: u64 = au_byte(p, i) as u64;
        let n: u64 = b0 * 65536;
        if out.len < 65534 {
            out.bytes[out.len] = au_b64_char(((n / 262144) % 64) as u8);
            out.bytes[out.len + 1] = au_b64_char(((n / 4096) % 64) as u8);
            out.len = out.len + 2;
        };
    };
    if rem == 2 {
        let b0: u64 = au_byte(p, i) as u64;
        let b1: u64 = au_byte(p, i + 1) as u64;
        let n: u64 = (b0 * 65536) + (b1 * 256);
        if out.len < 65533 {
            out.bytes[out.len] = au_b64_char(((n / 262144) % 64) as u8);
            out.bytes[out.len + 1] = au_b64_char(((n / 4096) % 64) as u8);
            out.bytes[out.len + 2] = au_b64_char(((n / 64) % 64) as u8);
            out.len = out.len + 3;
        };
    };
}

fn au_b64_val(c: u8, out_v: &u64) -> bool {
    if c >= 65 && c <= 90 { *out_v = (c - 65) as u64; return true; };
    if c >= 97 && c <= 122 { *out_v = (c - 97 + 26) as u64; return true; };
    if c >= 48 && c <= 57 { *out_v = (c - 48 + 52) as u64; return true; };
    if c == 45 { *out_v = 62; return true; };
    if c == 95 { *out_v = 63; return true; };
    return false;
}

fn au_b64url_decode(p: ptr, len: u64, out: &AuText) -> bool {
    let acc: u64 = 0;
    let nbits: u64 = 0;
    let i: u64 = 0;
    while i < len {
        let c: u8 = au_byte(p, i);
        if c == 61 { break; };
        let v: u64 = 0;
        if !au_b64_val(c, &v) { return false; };
        acc = (acc * 64) + v;
        nbits = nbits + 6;
        if nbits >= 8 {
            nbits = nbits - 8;
            let byte: u8 = ((acc / (1 << nbits)) % 256) as u8;
            if out.len < 65536 {
                out.bytes[out.len] = byte;
                out.len = out.len + 1;
            };
            acc = acc % (1 << nbits);
        };
        i = i + 1;
    }
    return true;
}

fn au_hex_val(c: u8) -> i64 {
    if c >= 48 && c <= 57 { return (c - 48) as i64; };
    if c >= 97 && c <= 102 { return (c - 97 + 10) as i64; };
    if c >= 65 && c <= 70 { return (c - 65 + 10) as i64; };
    return -1;
}

// hmac(value, secret) -> base64url(HMAC-SHA256) via the std hex form
fn hmac(value_ptr: ptr, value_len: u64, secret_ptr: ptr, secret_len: u64, out_ptr: &ptr, out_len: &u64) -> void {
    *out_ptr = PTR_NULL();
    *out_len = 0;
    let hexbuf: [u8; 64] = [0; 64];
    let hp: ptr = PTR_NULL();
    PTR_BYTE_ADD(hp, &hexbuf, 0);
    let hl: u64 = 0;
    let st: i32 = sa_hmac_sha256_hex(secret_ptr, secret_len, value_ptr, value_len, hp, 64, &hl);
    if st != 0 || hl != 64 { return; };
    let raw: [u8; 32] = [0; 32];
    let i: u64 = 0;
    while i < 32 {
        let hi: i64 = au_hex_val(hexbuf[i * 2]);
        let lo: i64 = au_hex_val(hexbuf[(i * 2) + 1]);
        if hi < 0 || lo < 0 { return; };
        raw[i] = ((hi * 16) + lo) as u8;
        i = i + 1;
    }
    let rp: ptr = PTR_NULL();
    PTR_BYTE_ADD(rp, &raw, 0);
    let enc = AuText { bytes: [0; 65536], len: 0 };
    au_b64url_encode(rp, 32, &enc);
    au_doc_str(STR_PTR("hmac"), STR_LEN("hmac"), au_text_ptr(&enc), enc.len, out_ptr, out_len);
}

fn base64UrlJson(value_json: u64, out_ptr: &ptr, out_len: &u64) -> void {
    *out_ptr = PTR_NULL();
    *out_len = 0;
    if value_json == 0 { return; };
    let buf: u64 = 0;
    if sa_json_stringify(value_json, &buf) != 0 || buf == 0 { return; };
    let bp: ptr = sa_json_buffer_data(buf);
    let bl: u64 = sa_json_buffer_len(buf);
    let enc = AuText { bytes: [0; 65536], len: 0 };
    au_b64url_encode(bp, bl, &enc);
    let f: i32 = sa_json_buffer_free(buf);
    au_doc_str(STR_PTR("b64json"), STR_LEN("b64json"), au_text_ptr(&enc), enc.len, out_ptr, out_len);
}

fn parseBase64UrlJson(value_ptr: ptr, value_len: u64, out_json: &u64) -> bool {
    *out_json = 0;
    let dec = AuText { bytes: [0; 65536], len: 0 };
    if !au_b64url_decode(value_ptr, value_len, &dec) { return false; };
    let doc: u64 = sa_json_parse(au_text_ptr(&dec), dec.len);
    if doc == 0 { return false; };
    let k: u32 = sa_json_kind(doc);
    if k != 7 && k != 6 {
        let f: i32 = sa_json_free(doc);
        return false;
    };
    *out_json = doc;
    return true;
}

// constant-time compare; no early exit on content
fn safeEqual(a_ptr: ptr, a_len: u64, b_ptr: ptr, b_len: u64) -> bool {
    if a_len != b_len { return false; };
    let diff: u64 = 0;
    let i: u64 = 0;
    while i < a_len {
        let x: u64 = au_byte(a_ptr, i) as u64;
        let y: u64 = au_byte(b_ptr, i) as u64;
        diff = diff | (x ^ y);
        i = i + 1;
    }
    return diff == 0;
}

fn au_jwt_payload_fill(payload: &JwtPayload, sub_p: ptr, sub_l: u64, email_p: ptr, email_l: u64, role_p: ptr, role_l: u64, sid_p: ptr, sid_l: u64, iat: u64, exp: u64) -> void {
    payload.sub_len = 0;
    let i: u64 = 0;
    while i < sub_l && i < 64 { payload.sub[i] = au_byte(sub_p, i); i = i + 1; }
    payload.sub_len = i;
    payload.email_len = 0;
    i = 0;
    while i < email_l && i < 320 { payload.email[i] = au_byte(email_p, i); i = i + 1; }
    payload.email_len = i;
    payload.role_len = 0;
    i = 0;
    while i < role_l && i < 16 { payload.role[i] = au_byte(role_p, i); i = i + 1; }
    payload.role_len = i;
    payload.sid_len = 0;
    i = 0;
    while i < sid_l && i < 32 { payload.sid[i] = au_byte(sid_p, i); i = i + 1; }
    payload.sid_len = i;
    payload.iat = iat;
    payload.exp = exp;
}

fn signJwt(payload: &JwtPayload, secret_ptr: ptr, secret_len: u64, out_ptr: &ptr, out_len: &u64) -> void {
    *out_ptr = PTR_NULL();
    *out_len = 0;
    let header: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    if header == 0 { return; };
    let h1: i32 = sa_json_object_set_string(header, STR_PTR("alg"), STR_LEN("alg"), STR_PTR("HS256"), STR_LEN("HS256"));
    let h2: i32 = sa_json_object_set_string(header, STR_PTR("typ"), STR_LEN("typ"), STR_PTR("JWT"), STR_LEN("JWT"));
    let body: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    if body == 0 { return; };
    let sp: ptr = PTR_NULL();
    PTR_BYTE_ADD(sp, &payload.sub, 0);
    let s1: i32 = sa_json_object_set_string(body, STR_PTR("sub"), STR_LEN("sub"), sp, payload.sub_len);
    let ep: ptr = PTR_NULL();
    PTR_BYTE_ADD(ep, &payload.email, 0);
    let s2: i32 = sa_json_object_set_string(body, STR_PTR("email"), STR_LEN("email"), ep, payload.email_len);
    let rp: ptr = PTR_NULL();
    PTR_BYTE_ADD(rp, &payload.role, 0);
    let s3: i32 = sa_json_object_set_string(body, STR_PTR("role"), STR_LEN("role"), rp, payload.role_len);
    let ip: ptr = PTR_NULL();
    PTR_BYTE_ADD(ip, &payload.sid, 0);
    let s4: i32 = sa_json_object_set_string(body, STR_PTR("sid"), STR_LEN("sid"), ip, payload.sid_len);
    let s5: i32 = sa_json_object_set_i64(body, STR_PTR("iat"), STR_LEN("iat"), payload.iat as i64);
    let s6: i32 = sa_json_object_set_i64(body, STR_PTR("exp"), STR_LEN("exp"), payload.exp as i64);
    let hb_p: ptr = PTR_NULL();
    let hb_l: u64 = 0;
    base64UrlJson(header, &hb_p, &hb_l);
    let hf: i32 = sa_json_free(header);
    // copy header b64 into a local (base64UrlJson reuses the scratch field)
    let hb = AuText { bytes: [0; 65536], len: 0 };
    au_append(&hb, hb_p, hb_l);
    let pb_p: ptr = PTR_NULL();
    let pb_l: u64 = 0;
    base64UrlJson(body, &pb_p, &pb_l);
    let bf: i32 = sa_json_free(body);
    let unsigned = AuText { bytes: [0; 65536], len: 0 };
    au_append(&unsigned, au_text_ptr(&hb), hb.len);
    au_append(&unsigned, STR_PTR("."), STR_LEN("."));
    au_append(&unsigned, pb_p, pb_l);
    let sig_p: ptr = PTR_NULL();
    let sig_l: u64 = 0;
    hmac(au_text_ptr(&unsigned), unsigned.len, secret_ptr, secret_len, &sig_p, &sig_l);
    if sig_l == 0 { return; };
    au_append(&unsigned, STR_PTR("."), STR_LEN("."));
    au_append(&unsigned, sig_p, sig_l);
    au_doc_str(STR_PTR("jwt"), STR_LEN("jwt"), au_text_ptr(&unsigned), unsigned.len, out_ptr, out_len);
}

fn verifyJwt(token_ptr: ptr, token_len: u64, secret_ptr: ptr, secret_len: u64, out: &JwtPayload) -> bool {
    // split into exactly 3 non-empty parts
    let d1: i64 = -1;
    let d2: i64 = -1;
    let i: u64 = 0;
    while i < token_len {
        if au_byte(token_ptr, i) == 46 {
            if d1 < 0 { d1 = i as i64; } else {
                if d2 < 0 { d2 = i as i64; } else { return false; };
            };
        };
        i = i + 1;
    }
    if d1 <= 0 || d2 < 0 { return false; };
    let u1: u64 = d1 as u64;
    let u2: u64 = d2 as u64;
    if u2 <= u1 + 1 || u2 + 1 >= token_len { return false; };
    let sig_p: ptr = PTR_NULL();
    PTR_BYTE_ADD(sig_p, token_ptr, u2 + 1);
    let sig_l: u64 = token_len - (u2 + 1);
    let exp_p: ptr = PTR_NULL();
    let exp_l: u64 = 0;
    hmac(token_ptr, u2, secret_ptr, secret_len, &exp_p, &exp_l);
    if exp_l == 0 || !safeEqual(sig_p, sig_l, exp_p, exp_l) { return false; };
    let header: u64 = 0;
    if !parseBase64UrlJson(token_ptr, u1, &header) { return false; };
    let alg_p: ptr = PTR_NULL();
    let alg_l: u64 = 0;
    let alg_has: bool = au_field_str(header, STR_PTR("alg"), STR_LEN("alg"), &alg_p, &alg_l);
    let alg_ok: bool = alg_has && au_eq(alg_p, alg_l, STR_PTR("HS256"), STR_LEN("HS256"));
    let hf: i32 = sa_json_free(header);
    if !alg_ok { return false; };
    let mid_p: ptr = PTR_NULL();
    PTR_BYTE_ADD(mid_p, token_ptr, u1 + 1);
    let body: u64 = 0;
    if !parseBase64UrlJson(mid_p, u2 - u1 - 1, &body) { return false; };
    let sub_p: ptr = PTR_NULL();
    let sub_l: u64 = 0;
    let email_p: ptr = PTR_NULL();
    let email_l: u64 = 0;
    let role_p: ptr = PTR_NULL();
    let role_l: u64 = 0;
    let sid_p: ptr = PTR_NULL();
    let sid_l: u64 = 0;
    let ok: bool = au_field_str(body, STR_PTR("sub"), STR_LEN("sub"), &sub_p, &sub_l);
    if !au_field_str(body, STR_PTR("email"), STR_LEN("email"), &email_p, &email_l) { ok = false; };
    if !au_field_str(body, STR_PTR("role"), STR_LEN("role"), &role_p, &role_l) { ok = false; };
    let role_ok: bool = au_eq(role_p, role_l, STR_PTR("admin"), STR_LEN("admin")) || au_eq(role_p, role_l, STR_PTR("user"), STR_LEN("user"));
    if !role_ok { ok = false; };
    if !au_field_str(body, STR_PTR("sid"), STR_LEN("sid"), &sid_p, &sid_l) { ok = false; };
    let iat_v: f64 = 0.0;
    let exp_v: f64 = 0.0;
    let nums_ok: bool = au_field_num(body, STR_PTR("iat"), STR_LEN("iat"), &iat_v) && au_field_num(body, STR_PTR("exp"), STR_LEN("exp"), &exp_v);
    let bf: i32 = sa_json_free(body);
    if !ok || !nums_ok { return false; };
    let now_s: u64 = (sa_time_unix_ms() / 1000) as u64;
    if !(exp_v > (now_s as f64)) { return false; };
    au_jwt_payload_fill(out, sub_p, sub_l, email_p, email_l, role_p, role_l, sid_p, sid_l, iat_v as u64, exp_v as u64);
    return true;
}

