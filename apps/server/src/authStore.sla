// Converted 1:1 from apps/server/src/authStore.ts (CXU plugins @ f2cb649d).
// FIX (stores batch): full body retranslation. The skeleton header's
// claims are stale and are corrected here: JWT/HMAC DO have sa_std
// surfaces (crypto.sai sa_hmac_sha256_hex, sa_crypto_random_bytes,
// sa_deno_random_uuid — base64url is hand-rolled, no std surface),
// bcrypt is wired via runtime/password.sla (sa_bcrypt_*), the DB
// handle is a plugin_sqlite connection (sa_std/plugin_sqlite.sa
// facade, the LocalDatabase seam registered below), and fs/env/time
// all exist in sa_std.
// Landed-model notes (registered in _defects/FIX_SERVER_STORES.md):
// - AuthStore.db is the wiring layer's plugin_sqlite connection
//   handle; AuthStore_new with has_database=false (or fromEnv with
//   database=0) leaves db=0 and DB methods fail closed — the TS
//   default `new LocalDatabase()` has no landed channel.
// - TS throws land on the i32 status channel (0 ok, 1 thrown) with
//   the message in the module last-error doc, readable via
//   AuthStore_takeLastError (additive accessor). bool fns keep the
//   TS null semantics.
// - getUsageSummary's day boundaries use UTC midnight (sa_std time
//   getters are UTC); TS uses local-timezone midnight. toISOString
//   day keys are UTC in both.
// - String results that TS returns by value ride the module scratch
//   doc ("authstore.scratch") and are valid until the next
//   authStore call that writes the same field (ledger model).

@import "sa_std/io/print.sai"
@import "sa_std/string.sa"
@import "sa_std/ptr.sa"
@import "sa_std/encoding/json.sai"
@import "sa_std/fs.sai"
@import "sa_std/env.sai"
@import "sa_std/time.sai"
@import "sa_std/crypto.sai"
@import "sa_std/fmt.sai"
@import "sa_std/globals.sai"
@import "sa_std/plugin_sqlite.sa"
@import "./runtime/password.sla"
@import "../../../sdk-backend/src/dataDir.sla"

