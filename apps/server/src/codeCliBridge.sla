    status_message: OptStr,
    status_startedAt: u64,
    configuredModel: OptStr,
    hasConfiguredModel: bool,
    configuredCwd: OptStr,
    hasConfiguredCwd: bool,
    configuredSandbox: OptStr,
    hasConfiguredSandbox: bool,
    configuredApprovalPolicy: OptStr,
    hasConfiguredApprovalPolicy: bool,
    configuredProviderId: OptStr,
    hasConfiguredProviderId: bool,
    configuredGroupId: OptStr,
    hasConfiguredGroupId: bool,
    configuredThreadId: OptStr,
    hasConfiguredThreadId: bool,
    configuredReasoningEffort: OptStr,
    hasConfiguredReasoningEffort: bool,
    thinkingBudgetChild_pid: u64,
    thinkingBudgetChild_present: bool,
    configuredContextWindow: u64,
    hasConfiguredContextWindow: bool,
    configuredResumeSessionId: OptStr,
    hasConfiguredResumeSessionId: bool,
    claudeCodeVersion: OptStr,
    // Map<string,CodeCliSession> sessions -> fixed array + len (cap 128).
    sessions: [CodeCliSession; 128],
    sessions_len: u64,
    // Map<string,ClaudeAgentProjection> agentProjections (cap 128).
    agentProjections: [ClaudeAgentProjection; 128],
    agentProjections_len: u64,
    // Map<string,ClaudeAgentGroup> agentGroups (cap 64).
    agentGroups: [ClaudeAgentGroup; 64],
    agentGroups_len: u64,
    agentGroupByTurn_json: JsonText,
    agentToolUseByTaskId_json: JsonText,
    // Map<string,"completed"|"failed"> pendingParentTurnResults (statusCode).
    pendingParentTurnResults_json: JsonText,
    // Map<string,timer> pendingParentTurnTimers / goalContinuationTimers.
    pendingParentTurnTimers_json: JsonText,
    goalContinuationTimers_json: JsonText,
    // Map<string,{resolve,reject,threadId}> pendingTurnResolvers
    // DEFECT: Promise closures — see pendingControls note.
    pendingTurnResolvers_json: JsonText,
    // Map<string,{requestId,threadId,toolName,inputSignature}>
    pendingPermissionRequests_json: JsonText,
    pendingPermissionRequests_len: u64,
    sessionIdToThread_json: JsonText,
    // Set<string> sessionIdleTurns / openCompactionItemTurnKeys /
    // goalContinuationTurnKeys -> JSON buffers.
    sessionIdleTurns_json: JsonText,
    openCompactionItemTurnKeys_json: JsonText,
    goalContinuationTurnKeys_json: JsonText,
    goalContinuationCounts_json: JsonText,
    // Map<string,statusCode> backgroundTasks + per-turn/toolUse indexes.
    backgroundTasks_json: JsonText,
    backgroundTasksByTurn_json: JsonText,
    backgroundToolUseOwners_json: JsonText,
    backgroundTaskIdsByToolUse_json: JsonText,
    unownedBackgroundTasksByThread_json: JsonText,
    terminalAgentTasksByToolUse_json: JsonText,
    terminalAgentTasksByTaskId_json: JsonText,
    // readonly runtimeEnvSnapshot: NodeJS.ProcessEnv
    // DEFECT: process env map -> single env JSON text buffer.
    runtimeEnvSnapshot_json: JsonText,
    // readonly compactThread: ClaudeCompactionRunner (imported, opaque id).
    compactThread_id: u64,
    // ASYNC-ADJ(ii): childExitPromise: Promise<void> is modeled as the childExitSettled flag + exit code; the host-fed onChildExit sink settles it and waitForExit reads it — the host-poll form (ASYNC_MODEL R7) of the exit promise.
    childExitSettled: bool,
    pendingHandshakeThreadId: OptStr,
    pendingHandshakeThreadIdIsNull: bool,
    // Injected callbacks (constructor params): spawnCommand / terminateChild /
    // onSessionSnapshot / remoteHost.
    // DEFECT: closure/function-type params -> host callback ids.
    spawnCommand_id: u64,
    terminateChild_id: u64,
    onSessionSnapshot_id: u64,
    hasOnSessionSnapshot: bool,
    remoteHost: bool,
}

// Session lookup helper (TS: this.sessions.get(threadId)).
// DEFECT: Map.get + string key equality -> linear scan with (ptr,len) compare
// at fix stage; index returned via out param (found=false models undefined).
fn codeCliBridge_findSession(self: &CodeCliBridge, threadId_len: u64, out_idx: &u64) -> bool {
    let i: u64 = 0;
    while i < self.sessions_len {
        // DEFECT: threadId byte compare elided in this pass.
        i = i + 1;
    }
    return false;
}

// EventEmitter emit stand-in (TS: this.emit("message"|"status"|"stderr"|
// "codecli:raw", payload)). Host drains the out buffer after each call.
// DEFECT: EventEmitter — no listener registry; single host sink assumed.
fn codeCliBridge_emit(self: &CodeCliBridge, event_code: u64, payload: &JsonText) -> void { return; }

// public constructor(runtimeEnv, spawnCommand, terminateChild, compactThread?,
//   onSessionSnapshot?, remoteHost = false)  (628-640)
// super(); runtimeEnvSnapshot = {...runtimeEnv()}; compactThread ??=
// createClaudeCompactionRunner(spawnCommand, terminateChild).
// DEFECT: default param closures + spread of env object -> ids + env buffer.
fn codeCliBridge_new(self: &CodeCliBridge, remoteHost: bool) -> void {
    self.has_child = false;
    self.child_pid = 0;
    self.nextControlId = 1;
    self.pendingControls_len = 0;
    self.sessions_len = 0;
    self.agentProjections_len = 0;
    self.agentGroups_len = 0;
    self.pendingPermissionRequests_len = 0;
    self.pendingHandshakeThreadIdIsNull = true;
    self.childExitSettled = false;
    self.remoteHost = remoteHost;
    // claudeCodeVersion = DEFAULT_CLAUDE_CODE_VERSION ("2.1.222")
    self.claudeCodeVersion.len = 7;
    self.claudeCodeVersion.present = true;
    // status = { phase: "idle", transport: "stdio" }
    self.status_phase.len = 4;
    self.status_transport.len = 5;
    return;
}

// public getStatus(): EngineStatus  (642-644) — return {...this.status}
// DEFECT: object spread copy -> field-wise copy into out params at fix stage.
fn codeCliBridge_getStatus(self: &CodeCliBridge, out_phase_len: &u64) -> void {
    *out_phase_len = self.status_phase.len;
    return;
}

// private claudeCodeUserAgent(): string  (646-648) = `claude-code/${version}`
// DEFECT: template literal -> buffer concat at fix stage.
fn codeCliBridge_claudeCodeUserAgent(self: &CodeCliBridge, out: &JsonText) -> void {
    out.len = self.claudeCodeVersion.len;
    return;
}

// private emitClaudeStartupStage(threadId, stage, error?)  (655-673)
