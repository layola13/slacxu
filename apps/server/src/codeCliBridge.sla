// Converted 1:1 from apps/server/src/codeCliBridge.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
//
// CodeCliBridge: hosts one Claude CLI child process (stream-json over stdio)
// and projects its protocol onto the Codex JSON-RPC surface (thread/*, turn/*,
// item/*). TS class -> struct CodeCliBridge + fn family with &CodeCliBridge as
// first param; method names preserved verbatim. EventEmitter emit() ->
// codeCliBridge_emit() writing a JSON text buffer to the host callback slot.
// DEFECT: dynamic JSON — JsonValue / Record<string,JsonValue> have no SLA
// equivalent; represented as JsonText (raw JSON text buffer + len) throughout.

@import "sa_std/io/print.sai"
@import "sa_std/ptr.sa"
