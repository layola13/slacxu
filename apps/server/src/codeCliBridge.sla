// fn updateClaudeTokenUsage(current, value): ClaudeTokenUsage  (353-366)
// Keep non-zero fields of the parsed snapshot (see source comment: message_start
// snapshot vs message_delta zero placeholders must not leak across requests).
fn updateClaudeTokenUsage(current: &ClaudeTokenUsage, value: &JsonText, out: &ClaudeTokenUsage) -> void {
    out.inputTokens = current.inputTokens;
    out.cachedInputTokens = current.cachedInputTokens;
    out.cacheWriteInputTokens = current.cacheWriteInputTokens;
    out.outputTokens = current.outputTokens;
    // DEFECT: parseClaudeTokenUsage gate + per-field >0 merge at fix stage.
    return;
}

// fn totalClaudeTokens(usage): number  (368-370)
fn totalClaudeTokens(usage: &ClaudeTokenUsage) -> u64 {
    return usage.inputTokens + usage.cachedInputTokens + usage.cacheWriteInputTokens + usage.outputTokens;
}

