// fn normalizeGoalBudgetInput(v: unknown): number|null|undefined (261-269)
// undefined->undefined; null->null; string/number -> Number(); non-finite->
// undefined; <=0 -> null; else min(10_000_000, floor(n)).
// DEFECT: unknown/dynamic input + Number() coercion -> caller passes kind code
// (0=undefined 1=null 2=number 3=string) + f64 value; string parse at fix stage.
fn normalizeGoalBudgetInput(kind: u64, num: f64, out_value: &i64, out_is_null: &bool) -> bool {
    if kind == 0 { return false; };
    if kind == 1 { *out_is_null = true; return true; };
    if num <= 0.0 { *out_is_null = true; return true; };
    // DEFECT: Math.min/floor on f64 -> integer clamp approximation.
    *out_is_null = false;
    *out_value = 0;
    return true;
}

// fn claudeGoalState(session) (271-284): builds goal view object.
// DEFECT: dynamic object return -> fields written into out params / JsonText.
fn claudeGoalState(session: &CodeCliSession, out_tokens_used: &u64, out_time_used_s: &u64) -> void {
    let base: u64 = 0;
    if session.goalBaseTokensPresent { base = session.goalBaseTokens; };
    let total: u64 = totalClaudeTokens(&session.tokenUsage);
    if total > base { *out_tokens_used = total - base; } else { *out_tokens_used = 0; };
    // DEFECT: Date.now() has no sa_std counterpart in this pass; time 0.
    *out_time_used_s = 0;
    return;
}

// fn isClaudeGoalBudgetExhausted(session): boolean  (286-291)
fn isClaudeGoalBudgetExhausted(session: &CodeCliSession) -> bool {
    if !session.goalTokenBudgetPresent || session.goalTokenBudgetIsNull { return false; };
    if session.goalTokenBudget <= 0 { return false; };
    let base: u64 = 0;
    if session.goalBaseTokensPresent { base = session.goalBaseTokens; };
    let used: u64 = 0;
    let total: u64 = totalClaudeTokens(&session.tokenUsage);
    if total > base { used = total - base; };
    return used >= session.goalTokenBudget as u64;
}

// TS const MAX_GOAL_AUTO_CONTINUATIONS = 50 (293)
// TS const MAX_CLAUDE_REPLAY_CHARS = 24_000 (300)
fn maxGoalAutoContinuations() -> u64 { return 50; }
fn maxClaudeReplayChars() -> u64 { return 24000; }

// fn buildConversationReplay(session): string|undefined  (302-312)
// Walk conversation newest->oldest, unshift lines while budget lasts.
fn buildConversationReplay(session: &CodeCliSession, out: &JsonText) -> bool {
    let budget: u64 = 24000;
    let total: u64 = 0;
    let idx: u64 = session.conversation_len;
    while idx > 0 {
        idx = idx - 1;
        // DEFECT: array unshift + join("\n\n") ordering -> buffer prepend at fix stage.
        let line_len: u64 = session.conversation[idx].text.len;
        if line_len > budget { break; };
        budget = budget - line_len;
        total = total + line_len;
    }
    out.len = total;
    return total > 0;
}

