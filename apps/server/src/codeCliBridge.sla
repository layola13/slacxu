// DEFECT: dynamic object — string is (ptr,len) in SLA; TS string fields are
// carried as fixed byte buffers + len inside structs below.
struct JsonText {
    bytes: [u8; 16384],
    len: u64,
}

// Optional string: present flag + buffer (TS: string | undefined).
struct OptStr {
    present: bool,
    bytes: [u8; 1024],
    len: u64,
}

// TS: Array<{ id: string; status: string; createdAt: number }>
struct TurnEntry {
    id: OptStr,
    status: OptStr,
    createdAt: u64,
}

// TS: Array<{ role: "user" | "assistant"; text: string }>
struct ConversationEntry {
    roleIsUser: bool,
    text: JsonText,
}

// TS: Array<{ toolName: string; inputSignature: string }>
struct ApprovedToolAllow {
    toolName: OptStr,
    inputSignature: OptStr,
}

