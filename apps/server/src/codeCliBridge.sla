// private handleLine(line: string)  (2799-3459)
// One stdout line from the Claude CLI (stream-json). Blank -> ignore;
// JSON.parse failure -> emit stderr "Unparseable Claude CLI stdout: " +
// redactSecrets(line). Always emit("codecli:raw", message) first, then
// dispatch on message.type / subtype:
//   control_response (2811-2824): resolve pendingControls[request_id].
//     DEFECT: Promise resolve closure -> completion slot delivery.
//   control_request / can_use_tool (2826-2863): auto-allow when
//     hasApprovedToolAllow; else register pendingPermissionRequests under
//     "perm-<requestId>" and emit item/commandExecution/requestApproval as a
//     JSON-RPC request (id = serverRequestId; command string/array lifted).
//   assistant (2865-3020): fold message.usage into current/lastMessageUsage;
//     Agent/Task tool_use blocks -> startAgentGroup; every tool_use ->
//     registerBackgroundToolUse; text blocks -> dedupe against streamed items
//     (stable stream item id / reconcileStreamedItem / containment) then emit
//     agentMessage item/completed + push message/conversation/turn blocks;
//     thinking blocks -> same dedupe into reasoning items; other tool_use ->
//     task-plan tools fold via applyClaudeTaskPlanTool + emitTaskPlanItem,
//     else emit toolCall item/started + upsert + persist.
//   user / tool_result (3022-3076): asyncAgentTaskId -> bindAgentTask +
//     group re-emit; completeAgentProjection on terminal results; task-plan
//     results bind via bindClaudeTaskPlanResult and are dropped; otherwise
//     complete the matching toolCall item with { result: { content } }.
//   stream_event (3078-3210): message_start resets currentMessageUsage from
//     usage + records activeStreamMessageId; message_delta merges usage;
//     message_stop promotes usage to lastMessageUsage and emits
//     thread/tokenUsage/requestUpdated once per (turn, stream) request id;
//     content_block_start registers streamed tool blocks (evicting the prior
//     message's block at the same index) + item/started, and seeds text/
//     thinking stream items; content_block_delta appends input_json_delta
//     into the tool block arguments (re-emit item/started) and text/thinking
//     deltas into stream items, emitting item/agentMessage/delta or
//     item/reasoning/textDelta.
//   result (3212-3310): fold usage (tokenUsage/modelContextWindow via
//     resolveClaudeModelContextWindow), flush streamed items, settle open
//     compaction items, goal-complete signal on continuation turns ->
//     goalStatus complete + thread/goal/updated; project the result text as
//     agentMessage unless already projected; emit thread/tokenUsage/updated;
//     failures complete child agents as failed; park the outcome in
//     pendingParentTurnResults + schedule recovery + finishPendingParentTurn
//     (the parent turn stays running while agents/background work remain).
//   system task_started|task_progress|task_notification (3312-3358):
//     agentProjectionForTask + summary update; started -> group re-emit +
//     bindBackgroundTask + mark running (+ parent turn set); notification
//     with terminal status -> record early-terminal maps when unprojected,
//     set background task status, drop unowned entry, completeAgentProjection,
//     finishPendingParentTurnForBackgroundTask.
//   system session_state_changed (3360-3379): state idle -> mark
//     sessionIdleTurns, settle compaction, warn-and-hold when background work
//     still runs, else finishPendingParentTurn.
//   system compact_boundary (3381-3397): never touch the process; open a
//     contextCompaction item for the active turn.
//   system init (3399-3457): finish the startup handshake (ready stage),
//     adopt claude_code_version (+ status user-agent refresh), and adopt the
//     external session id onto the active-turn (or sole) session — guarded on
//     the target session not already holding it, NOT on map membership (see
//     source comment) — persist + configuredResumeSessionId = sessionId.
// DEFECT: dynamic JSON dispatch (message.type/subtype string compares) +
// nested record traversal throughout -> sa_json_* kind/field probes and
// (ptr,len) literal compares at fix stage; body kept as this dispatch map in
// the bulk pass, branches land incrementally in the fix stage.
fn codeCliBridge_handleLine(self: &CodeCliBridge, line_ptr: ptr, line_len: u64) -> void {
    if line_len == 0 { return; };
    // DEFECT: JSON.parse of the line -> sa_json parse status at fix stage.
    return;
}

// private findThreadBySession(sessionId): string|undefined  (3461-3479)
// sessionIdToThread hit; else single-session fallback (registers the mapping);
// else sessionId that is itself a threadId; else undefined.
fn codeCliBridge_findThreadBySession(self: &CodeCliBridge, sessionId: &OptStr, has_id: bool, out: &OptStr) -> bool {
    if !has_id { return false; };
    if self.sessions_len == 1 {
        out.len = self.sessions[0].threadId.len;
        out.present = true;
        return true;
    };
    out.present = false;
    return false;
}

