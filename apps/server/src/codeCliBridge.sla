// TS const CODECLI_TERMINAL_THREAD_METHODS / CODECLI_PROCESS_FREE_METHODS
// (source lines 171-197): Set<string> membership -> linear scan helpers.
// DEFECT: Set<string> has no SLA counterpart; method strings compared by the
// host-provided method code where possible, else (ptr,len) byte compare.
fn isTerminalMethodCode(methodCode: u64) -> bool {
    // 1=thread/archive 2=thread/delete 3=thread/unsubscribe 4=thread/closed
    return methodCode >= 1 && methodCode <= 4;
}

fn isProcessFreeMethodCode(methodCode: u64) -> bool {
    // terminal methods + initialize, config/read, thread/fork, thread/read,
    // thread/resume, thread/list, thread/turns/list, thread/items/list,
    // thread/name/set, thread/goal/set, thread/goal/get, thread/goal/clear,
    // thread/inject_items, thread/history/fileInfo, thread/history/tail,
    // thread/tokenUsage/updated, turn/interrupt (codes 1..21).
    return methodCode >= 1 && methodCode <= 21;
}

// Source lines 199-209: exported method-classification helpers.
fn isCodeCliTerminalThreadMethod(method_ptr: ptr, method_len: u64) -> bool {
    // DEFECT: Set.has(string) -> byte-compare against the 4 literals (elided
    // to method-code path in callers); returns false for unknown strings.
    return false;
}

fn codeCliNeedsManagedConfigDir(method_ptr: ptr, method_len: u64) -> bool {
    // return method !== "turn/interrupt" && method !== "thread/fork"
    //        && !isCodeCliTerminalThreadMethod(method);
    // DEFECT: string inequality -> (ptr,len) compare at fix stage.
    return true;
}

fn codeCliNeedsRunningProcess(method_ptr: ptr, method_len: u64) -> bool {
    // return !CODECLI_PROCESS_FREE_METHODS.has(method);
    // DEFECT: Set.has(string) -> see isProcessFreeMethodCode.
    return true;
}

