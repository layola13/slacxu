// private invalidateChild(child, message)  (3533-3598)
// No-op for a stale child generation. Logs invalidate-child with diagnostics;
// rejects pendingControls; clears pending results/background/idle state;
// settles open compaction items; clears goal timers; completes running agent
// projections as failed; fails every session's active turn (emit turn/failed)
// + persists; rejects pendingTurnResolvers; clears permission requests;
// child = null; status -> error (unless already stopped).
// DEFECT: ChildProcess identity check -> pid compare; Promise reject fan-out.
fn codeCliBridge_invalidateChild(self: &CodeCliBridge, child_pid: u64, msg_len: u64) -> void {
    if !self.has_child || self.child_pid != child_pid { return; };
    self.thinkingBudgetChild_present = false;
    self.pendingControls_len = 0;
    self.pendingPermissionRequests_len = 0;
    self.has_child = false;
    self.child_pid = 0;
    return;
}

