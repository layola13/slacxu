// public configure(params?)  (769-771) = applyStartConfig(params)
fn codeCliBridge_configure(self: &CodeCliBridge, params: &JsonText) -> void {
    codeCliBridge_applyStartConfig(self, params);
    return;
}

// public requiresRestartFor(_params?): boolean  (773-775) = false
fn codeCliBridge_requiresRestartFor(self: &CodeCliBridge) -> bool { return false; }

// private controlRequest(request, timeoutMs = 30_000): Promise<JsonValue> (777-798)
// Rejects when no child; else registers pendingControls[host-<n>] with a
// setTimeout reject, writeStdin({type:"control_request",request_id,request}).
// ASYNC-ADJ(ii): TS controlRequest (L777) returns Promise<JsonValue>, resolved by the matching control_response and rejected by a setTimeout; modelled as
// synchronous registration returning a request slot id; the matching
// control_response is consumed in handleLine and the caller polls the slot.
// DEFECT: timers — timeout enforced by host tick at fix stage.
fn codeCliBridge_controlRequest(self: &CodeCliBridge, request: &JsonText, timeoutMs: u64, out_slot: &u64) -> i32 {
    if !self.has_child { return -1; };
    *out_slot = self.nextControlId;
    self.nextControlId = self.nextControlId + 1;
    self.pendingControls_len = self.pendingControls_len + 1;
    // writeStdin of the control_request envelope happens at fix stage.
    return 0;
}

// public async applyRuntimeConfig(params?)  (800-857)
// applyStartConfig; sync session model/contextWindow + persist; defer while
// pendingHandshakeThreadId; on model change await controlRequest(set_model);
// on effort change await controlRequest(set_max_thinking_tokens, budget from
// CLAUDE_EFFORT_TOKEN_BUDGETS); failures only logged, never thrown.
// DEFECT: async [BLOCKED: the awaited controlRequest calls (TS L826 set_model, L838 set_max_thinking_tokens) are not implemented — the body stops after applyStartConfig + the pendingHandshake defer check. Sequential-call form (R8) is chosen, but the calls themselves are fix-stage.]
fn codeCliBridge_applyRuntimeConfig(self: &CodeCliBridge, params: &JsonText) -> void {
    codeCliBridge_applyStartConfig(self, params);
    if self.pendingHandshakeThreadIdIsNull == false { return; };
    // DEFECT: awaited control requests + budget table lookup at fix stage.
    return;
}

// private ensureInitialThinkingBudget()  (859-897)
// Once per child generation: skip when --effort already carries the budget
// (resolveClaudeEffortForCli), else fire-and-forget controlRequest
// set_max_thinking_tokens with .then success/failure logging.
// DEFECT: Promise .then chains (fire-and-forget) -> completion logged from
// handleLine control_response path at fix stage.
fn codeCliBridge_ensureInitialThinkingBudget(self: &CodeCliBridge) -> void {
    if !self.has_child { return; };
    if self.thinkingBudgetChild_present && self.thinkingBudgetChild_pid == self.child_pid { return; };
    return;
}

// public restoreSession(snapshot)  (899-952)
// Rebuilds a CodeCliSession from the snapshot: running turns -> "interrupted",
// fresh streaming maps, taskPlan = snapshot.taskPlan ?? restoreTaskPlanState(
// messages), token usages defaulted, modelContextWindow recomputed when
// absent; registers session + sessionIdToThread + configured* fields;
// configuredSandbox/ApprovalPolicy derived from permissionMode when absent.
// DEFECT: Map/Set construction + nullish coalescing chains -> buffer resets.
fn codeCliBridge_restoreSession(self: &CodeCliBridge, snapshot: &CodeCliSessionSnapshot) -> void {
    if self.sessions_len < 128 {
        self.sessions_len = self.sessions_len + 1;
    };
    self.hasConfiguredThreadId = true;
    self.configuredThreadId.len = snapshot.threadId.len;
    // DEFECT: per-field restore + interrupted-turn rewrite at fix stage.
    return;
}

// public getSessionSnapshot(threadId): snapshot|null  (954-957)
fn codeCliBridge_getSessionSnapshot(self: &CodeCliBridge, threadId_len: u64, out: &CodeCliSessionSnapshot) -> bool {
    let idx: u64 = 0;
    let found: bool = codeCliBridge_findSession(self, threadId_len, &idx);
    if !found { return false; };
    return true;
}

// private resolveResumeSessionId(spawnCwd): string|undefined  (967-1001)
// No resume id: seed pendingCompactionSummary = buildConversationReplay() for
// every non-child session lacking one, return undefined. Transcript gone
// (claudeTranscriptExists === false): clear resume state, seed replays, emit
// stderr notice, return undefined. Else return the resume id.
// DEFECT: imported claudeTranscriptExists + Map iteration -> fix stage.
fn codeCliBridge_resolveResumeSessionId(self: &CodeCliBridge, spawnCwd_len: u64, out: &OptStr) -> bool {
    out.present = false;
    return false;
}

// public async start(): Promise<EngineStatus>  (1003-1266)
// Guards: already ready/starting -> status; missing provider/group -> throw;
// missing binary -> log + status error + throw; missing gateway token ->
// throw. Builds permissionMode, spawnCwd (ensureClaudeSpawnCwd, fail-fast),
// spawn args (buildClaudeSpawnArgs + optional --mcp-config + resume id +
// effort flag gated by resolveClaudeEffortForCli), safe env
// (buildSafeClaudeEnv with ANTHROPIC_BASE_URL gateway URL, gateway token,
// CLAUDE_CODE_PROVIDER_MANAGED_BY_HOST, optional AUTO_COMPACT_WINDOW and
// ANTHROPIC_CUSTOM_HEADERS; win32 ComSpec/SystemRoot backfill). Sets status
// starting, emits status + startup stage spawning/handshake, spawns child
// (sync throw -> log + error + failed stage + throw), wires child handlers:
// stderr tail ring (CLAUDE_STDERR_TAIL_BUDGET, redacted), exit -> settle exit
// promise + failed stage when handshake pending + invalidateChild, error /
// stdin error -> invalidateChild, readline stdout lines -> handleLine,
// stderr data -> sampled logging + emit stderr. Ends status ready.
// DEFECT: async [BLOCKED: start() body incomplete — the spawn/args/env sequence is fix-stage and the body returns -1. The ChildProcess .once/.on handlers + readline stream are remodeled as host-fed sinks (onChildExit/onChildError/onChildStderr/handleLine, present below), but nothing spawns yet.] +
// readline createInterface line stream + closures capturing spawn locals —
// modelled as host-driven poll: host feeds stdout lines to handleLine and
// exit/stderr events to the matching fns below at fix stage.
// DEFECT: throw -> i32 status return (-1 generic, -2 missing provider/group,
// -3 missing binary, -4 missing gateway token, -5 cwd, -6 spawn).
fn codeCliBridge_start(self: &CodeCliBridge) -> i32 {
    if self.status_phase.len == 5 { return 0; };
    if !self.hasConfiguredProviderId || !self.hasConfiguredGroupId { return -2; };
    // DEFECT: binary/token/cwd/args/env/spawn sequence at fix stage.
    return -1;
}

// Child event sinks for start()'s handlers (split out for the poll model).
// child exit (code, signal): settleChildExit, handshake-failed stage,
// child-exit log, invalidateChild("Claude CLI exited with code .. signal ..").
fn codeCliBridge_onChildExit(self: &CodeCliBridge, code: i64, has_code: bool) -> void {
    self.childExitSettled = true;
    return;
}
// child error / stdin error: log + invalidateChild(message).
fn codeCliBridge_onChildError(self: &CodeCliBridge, msg_len: u64) -> void { return; }
// stderr chunk: push redacted tail + sampled warn log + emit("stderr").
// DEFECT: Buffer.toString("utf8") chunk decode -> byte buffer append.
fn codeCliBridge_onChildStderr(self: &CodeCliBridge, chunk: &JsonText) -> void { return; }

// public stop()  (1268-1299)
// Reject all pendingControls + pendingTurnResolvers ("Claude CLI stopped"),
// clear every pending/timer/background/idle/compaction/goal map, status
// stopped, terminateChild(child) with kill("SIGTERM") fallback, child = null.
// DEFECT: Promise reject fan-out + clearTimeout loops -> flag clears.
fn codeCliBridge_stop(self: &CodeCliBridge) -> void {
    self.pendingControls_len = 0;
    self.pendingPermissionRequests_len = 0;
    self.has_child = false;
    self.child_pid = 0;
    self.status_phase.len = 7;
    return;
}

// public async waitForExit(timeoutMs = 5_000): Promise<boolean>  (1301-1316)
// timeoutMs <= 0 -> await exit promise, true; else Promise.race(exit, timer).
// DEFECT: async [BLOCKED: TS waitForExit (L1301) is Promise.race(childExitPromise, timer), with an indefinite await at timeoutMs<=0; this body only reads childExitSettled without waiting. A blocking spin here would deadlock the single-threaded host pump that must feed onChildExit, so the wait has to be owned by the host drive loop (index layer), not this fn.]
fn codeCliBridge_waitForExit(self: &CodeCliBridge, timeoutMs: u64) -> bool {
    return self.childExitSettled;
}

// public async restart(): Promise<EngineStatus>  (1318-1322)
// stop(); await waitForExit(); return start().
// ASYNC-ADJ(ii): TS async restart (L1318) = stop(); await waitForExit(); return start() — the SLA body is the same sequential composition returning start()'s status code; the only async loss sits inside waitForExit and is registered at its own site above.
fn codeCliBridge_restart(self: &CodeCliBridge) -> i32 {
    codeCliBridge_stop(self);
    let ignored: bool = codeCliBridge_waitForExit(self, 5000);
    return codeCliBridge_start(self);
}

// private applyStartConfig(params?)  (1324-1374)
// Copies present fields only (absent fields preserve prior config — see
// source comment on dangerBypass clobbering): threadId, model,
// reasoningEffort|effort, contextWindow|modelContextWindow (finiteTokenCount),
// cwd, sandbox|sandboxPolicy.type, approvalPolicy, providerId|modelProvider|
// workspace.providerId, groupId|workspace.groupId,
// resumeSessionId|externalSessionId.
// DEFECT: dynamic JSON field probing (typeof checks) -> sa_json_* at fix stage.
fn codeCliBridge_applyStartConfig(self: &CodeCliBridge, params: &JsonText) -> void { return; }

// public async request(method, params?, timeoutMs = 60_000)  (1376-1392)
// thread/fork -> throw; no child: turn/interrupt and process-free methods go
// straight to handleMethod, thread/start applies config, then await start();
// still no child -> throw; else handleMethod.
// ASYNC-ADJ(ii): TS async request (L1376) awaits start() (when a child is needed) then handleMethod; SLA: the same calls as sequential blocking calls, throw -> i32 status (-7 fork unsupported, -8 not running) (ASYNC_MODEL R8).
fn codeCliBridge_request(self: &CodeCliBridge, method_code: u64, params: &JsonText, timeoutMs: u64, out: &JsonText) -> i32 {
    if method_code == 30 { return -7; };
    if !self.has_child {
        let rc: i32 = codeCliBridge_start(self);
        if rc != 0 { return rc; };
    };
    return codeCliBridge_handleMethod(self, method_code, params, timeoutMs, out);
}

// public async notify(method, params?)  (1394-1396) = handleMethod(..., 0)
// ASYNC-ADJ(ii): TS async notify (L1394) is exactly `return this.handleMethod(...)`; the SLA direct call is 1:1.
fn codeCliBridge_notify(self: &CodeCliBridge, method_code: u64, params: &JsonText, out: &JsonText) -> i32 {
    return codeCliBridge_handleMethod(self, method_code, params, 0, out);
}

// public respond(id, result?, error?)  (1398-1429)
// Permission answer path: look up pendingPermissionRequests[String(id)];
// allowed = !error && permissionResponseAllows(result); on allow, record
// approvedToolAllows (session scope -> "*" wildcard) + persist; writeStdin(
// buildControlResponse(requestId, allowed, error?.message)); then
// finishPendingParentTurn for the owning (or every active) session.
// DEFECT: JsonRpcId union + imported buildControlResponse -> JsonText build.
fn codeCliBridge_respond(self: &CodeCliBridge, id_len: u64, result: &JsonText, has_error: bool) -> void {
    if self.pendingPermissionRequests_len == 0 { return; };
    self.pendingPermissionRequests_len = self.pendingPermissionRequests_len - 1;
    return;
}

// private writeStdin(message: JsonValue)  (1431-1470)
// Validates child/stdin liveness (killed/exitCode/signalCode/destroyed/
// writable) -> log stdin-not-writable + invalidateChild + throw; else
// child.stdin.write(JSON.stringify(message) + "\n", callback) where callback
// and sync throw both log + invalidateChild (sync throw rethrows).
// DEFECT: stream write with callback + JSON.stringify -> sa_std process
// bidi write extern (sa_std_process_spawn_bidi family) at fix stage.
fn codeCliBridge_writeStdin(self: &CodeCliBridge, message: &JsonText) -> i32 {
    if !self.has_child { return -8; };
    return 0;
}

// private flushStreamedAssistantItems(session, threadId, activeTurnId) (1479-1532)
// Commits leftover streamed reasoning then assistant items: emit item/completed
// per item, push to messages, fold assistant text into assistantTextBlocksByTurn
// + conversation (deduped against last assistant entry); clears the per-turn
// streaming maps and activeStreamMessageId.
// DEFECT: nested Map iteration -> flattened buffer walk at fix stage.
fn codeCliBridge_flushStreamedAssistantItems(self: &CodeCliBridge, session: &CodeCliSession, has_turn: bool) -> void { return; }

// private async handleMethod(method, params, _timeoutMs)  (1534-2123)
// The JSON-RPC dispatcher. Switch over method string; each case is converted
// as a branch below in source order. Returns JsonValue (JsonText out) or
// throws (i32 < 0). Case inventory (source line ranges):
//   initialize | config/read (1540-1547): { userAgent, codexHome:
//     process.env.CODEX_HOME || "", capabilities:{experimentalApi:true} }
//   thread/start (1549-1620): create CodeCliSession (randomUUID threadId when
//     absent), persist, bootstrapProjectSaVmAssets(cwd, threadId) when cwd,
//     emit thread/started, log thread-created, return { thread: {...} }.
//   turn/start | turn/steer (1622-1793): resolve session/turn (steer reuses
//     activeTurnId, expectedTurnId check), preempt a goal-continuation turn
//     via interrupt control_request, complete a stale idle parent turn, reject
//     double-active turn; await extractTurnInput(p) (text/images/warnings/
//     displayText/attachmentBlocks); record developerInstructions; on start:
//     push turn, reset per-turn maps + currentMessageUsage (NOT
//     lastMessageUsage), persist, emit turn/started, ensureInitialThinking-
//     Budget(); on input: upsert userMessage item, push conversation, wrap
//     pendingCompactionSummary in <conversation-summary>, prefix developer
//     instructions, goal-objective adoption + applyGoalDirective, writeStdin
//     user message (buildClaudeUserContent) with failure cleanup (clear
//     activeTurnId, mark turn failed, emit turn/failed, rethrow); returns
//     immediately — terminal events arrive via handleLine notifications.
//   turn/steer/end | thread/steer (1795-1807): extract input, writeStdin user.
//   turn/interrupt (1809-1852): interrupt control_request when child; then
//     completeAgentsForParent(interrupted), clear goal timer, settle
//     compaction, flush streamed items, clear background tasks + permission
//     requests, mark turn interrupted, emit turn/interrupted.
//   thread/read | thread/resume (1854-1883): thread view + turns with items
//     filtered by turnId (includeTurns gate), items = messages.
//   thread/list (1885-1903): all sessions as thread summaries.
//   thread/turns/list (1905-1914): pageThreadHistory(threadId, turns,
//     messages, {cursor, limit ?? 32, sortDirection ?? "desc"}).
//   thread/items/list (1916-1920): { items: session?.messages ?? [] }.
//   thread/fork (1922-1923): throw (unsupported).
//   thread/archive|delete|unsubscribe|closed (1925-1975): collect the thread
//     + all descendants, drop their agent projections/background state/
//     sessions/sessionId mappings/pending results, emit archived/deleted/
//     closed notification for the root.
//   thread/name/set (1977-1991): session.preview = name + persist.
//   thread/goal/set (1993-2041): objective/status/budget lifecycle (see
//     normalizeGoalBudgetInput + budgetLimited transitions), persist, emit
//     thread/goal/updated, return { threadId, status, goal }.
//   thread/goal/get (2043-2050) / thread/goal/clear (2052-2067).
//   thread/inject_items (2069-2079): append items + persist.
//   thread/history/fileInfo (2081-2082): { exists: false }.
//   thread/history/tail (2084-2085): { lines: [] }.
//   thread/tokenUsage/updated (2087-2088): {}.
//   config/value/write | config/batchWrite (2090-2092): throw.
//   thread/compact/start (2094-2113): validate session + no active turn +
//     trusted __claudeCompactionRoute (providerId/groupId/model), push
//     compaction turn, emit turn/started, fire runCompaction, return turn.
//   item/permissions/requestApproval | item/commandExecution/requestApproval
//     | item/tool/requestUserInput (2115-2118): {}.
//   default (2120-2121): {}.
// DEFECT: async [BLOCKED: per-case bodies land at fix stage — the body only
// clears out and guards fork; the awaited extractTurnInput (turn/start case)
// sits inside the unimplemented case bodies. Dispatch is on method_code,
