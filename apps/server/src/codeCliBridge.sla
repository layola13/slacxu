// private snapshotSession(session): CodeCliSessionSnapshot  (713-746)
// Conditional-spread projection (only present optional fields are copied) +
// host routing fields from configured* + taskPlan only when steps.length > 0
// + approvedToolAllows only when non-empty.
// DEFECT: spread conditionals + Array.map copies -> field-wise copy at fix stage.
fn codeCliBridge_snapshotSession(self: &CodeCliBridge, session: &CodeCliSession, out: &CodeCliSessionSnapshot) -> void {
    out.threadId.len = session.threadId.len;
    out.createdAt = session.createdAt;
    out.turns_len = session.turns_len;
    out.messages_len = session.messages_len;
    out.conversation_len = session.conversation_len;
    out.approvedToolAllows_len = session.approvedToolAllows_len;
    return;
}

// private persistSession(session|undefined)  (748-750)
// if (session) onSessionSnapshot?.(snapshotSession(session))
// DEFECT: optional callback invocation -> hasOnSessionSnapshot gate.
fn codeCliBridge_persistSession(self: &CodeCliBridge, session: &CodeCliSession, present: bool) -> void {
    if !present { return; };
    if !self.hasOnSessionSnapshot { return; };
    // DEFECT: snapshot build + callback delivery at fix stage.
    return;
}

