// fn upsertSessionMessage(session, item)  (414-425)
// Replace by (id, turnId) match else push.
// DEFECT: JsonValue record field reads (item.id / item.turnId) -> JSON lookup at fix stage.
fn upsertSessionMessage(session: &CodeCliSession, item: &JsonText) -> void {
    if session.messages_len < 512 {
        session.messages[session.messages_len] = *item;
        session.messages_len = session.messages_len + 1;
    };
    return;
}

// fn streamedToolArguments(block): JsonValue  (427-435)
