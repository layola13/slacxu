// fn finiteTokenCount(value): number|undefined  (338-340)
fn finiteTokenCount(is_number: bool, is_finite: bool, value: f64, out: &u64) -> bool {
    if !is_number || !is_finite || value < 0.0 { return false; };
    // DEFECT: Math.round(f64) -> truncation approximation.
    *out = 0;
    return true;
}

