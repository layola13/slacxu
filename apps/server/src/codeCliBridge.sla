// DEFECT: JSON.parse / try-catch -> sa_json parse status at fix stage.
fn streamedToolArguments(block: &ClaudeStreamToolBlock, out: &JsonText) -> void {
    if block.argumentsJson.len == 0 { out.len = block.initialInput.len; return; };
    out.len = block.argumentsJson.len;
    return;
}

