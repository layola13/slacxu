// ASYNC-ADJ(i): TS delay (L34) returns a Promise resolved by setTimeout(ms);
// the faithful SLA form is the blocking sleep sa_time_sleep_ms (ASYNC_MODEL
// R13). (Previously the body returned instantly, which would busy-spin the
// gate's poll loop — a real semantic loss, now fixed.)
fn delay(ms: u64) -> i32 {
    let rc = sa_time_sleep_ms(ms);
    return rc;
}

