// ---- src/index.ts:10440-11113 — server requests, VM policy, notification routing ----
// routeServerRequest(message) async: a bridge-originated JSON-RPC request —
//   route by method family: VM tool requests -> handleVmServerRequest;
//   user-input/permission requests -> broadcast to subscribed clients and await
//   client response via pending promise registry (server-request/respond route
//   completes them); claude host skills handled in executeCodexRpc region;
//   responses routed back through the originating bridge's
//   respondToCodexServerRequest equivalent keyed by routed id prefix.
// isReadToolName(toolName) -> bool: read-only tool whitelist (read_file, list_dir,
//   search, ...) used by VM policy + jev clear_tool_history classification.
// isVmForbiddenServerRequest(message, runtime) -> bool: method/tool in VM
//   forbidden set for the thread's SaVmToolsConfig (disabled tool categories).
// vmRpcPolicyDenial(method, params, runtime) -> string | null: normalizeSaVmPolicy
//   (runtime.vmPolicy) -> classifySaVmExecutionRequest + checkSaVmPath /
//   checkSaVmProcess / checkSaVmDelete / parseAndCheckSaVmPatch for apply_patch;
//   script interception: classifySaVmScriptToolRequest + isSaVmDirectCommandMethod
//   + saVmScriptLanguage + detectPowerShellAntiPattern; isSaVmBlockedToolName;
//   returns denial reason string or null.
// recordVmPolicyDenial(method, params, reason) async: auditLogStore.add +
//   notification. recordVmBlockedRequest(message) async: same for forbidden set.
// routeCodexNotification(message): THE notification fan-in (all bridges):
//   - turn bookkeeping: turn/started -> turnToThreadMap.set(turnId, threadId),
//     directTurnStartedAt.set, trackCodexChildrenFromItem on item/started
//     (collabAgentToolCall), codex child terminal tracking: child turn terminal ->
//     trackCodexChildTerminal; parent terminal while children active ->
//     codexDeferredTerminalByTurn.set(parent, message) + swallow; when last
//     child terminals -> flushDeferredCodexParent(parent).
//   - token usage: thread/tokenUsage/updated -> latestThreadTokenUsage.set +
//     recordRequestUsageNotification (direct-bypass dedup window via
//     directTurnStartedAt + directUsageSeqByTurn seq synthesis) +
//     recordDirectGatewayRow for gateway accounting.
//   - project projection: projectClientId owners -> archiveProjectNotification
//     rewrites notifications into project timeline messages (projectProjectTurnMetadata
//     lookup; projectNotificationText / projectTurnErrorText); project turn
//     terminal -> continueProjectDiscussion trigger.
//   - workbench control: WORKBENCH_CONTROL_NOTIFICATION handling +
//     applyWorkbenchLayoutAction side effects.
//   - fan-out: codexApiEvents.append(type, message, threadId);
//     subscriptionRegistry.publish(threadId, message) -> send to watching
//     sockets; broadcast for global types (engine.status etc.).
// recordDirectGatewayRow(threadId, turnId, method) async: gatewayRequestStore
//   insert for direct (non-gateway) turns once per turn (method discriminator).
// recordRequestUsageNotification(message, threadId, turnId) async:
//   usage = extractRingTokenUsage(message) ?? normalizeTokenUsage(params.usage);
//   priced = priceNormalizedTokenUsage(usage, model rates); requestId synthesized
//   via nextDirectUsageRequestId(threadId, turnId, seq); requestUsageStore.record
//   + debit guarded by requestUsageDebitInFlight; duplicates inside the dedup
//   window (same turn + same totals) skipped.

