// ---- src/index.ts:1079-1099 — CLI plugin default enablement ----
// cliPluginEnabledByDefault(envValue) -> /^(1|true|yes)$/i.test((envValue ?? "").trim())  // DEFECT: RegExp
fn cliPluginEnabledByDefault(envValue_ptr: ptr, envValue_len: u64, has_value: bool) -> bool {
    // src/index.ts:957: /^(1|true|yes)$/i.test((envValue ?? "").trim()).
    // The anchored alternation is decided by exact byte compares after an
    // ASCII-whitespace trim and ASCII case folding (CAPABILITY_MAP §6: the
    // std RegExp surface is a POSIX ERE subset; no std surface is needed for
    // this fixed pattern). JS trim also strips Unicode whitespace; env values
    // here are ASCII flags, noted in FIX_INDEX.
    if !has_value { return false; };
    let lo: u64 = 0;
    let hi = envValue_len;
    let adv = true;
    while adv && lo < hi {
        let c: u8 = 0;
        PTR_BYTE_AT(c, envValue_ptr, lo);
        if idx_is_ascii_ws(c) { lo = lo + 1; } else { adv = false; };
    }
    let adv2 = true;
    while adv2 && hi > lo {
        let c: u8 = 0;
        PTR_BYTE_AT(c, envValue_ptr, hi - 1);
        if idx_is_ascii_ws(c) { hi = hi - 1; } else { adv2 = false; };
    }
    let n = hi - lo;
    if n == 1 {
        let c: u8 = 0;
        PTR_BYTE_AT(c, envValue_ptr, lo);
        return c == 49;
    };
    if n == 4 { return idx_bytes_eq_ci_range(envValue_ptr, lo, hi, STR_PTR("true"), STR_LEN("true")); };
    if n == 3 { return idx_bytes_eq_ci_range(envValue_ptr, lo, hi, STR_PTR("yes"), STR_LEN("yes")); };
    return false;
}

fn isCliPluginEnabled(g: &ServerGlobals, pluginId_ptr: ptr, pluginId_len: u64) -> bool {
    // src/index.ts:969-977: the state cache is consulted first and is fully
    // implemented here (setCliPluginEnabled below writes it).
    if g.cliPluginEnabledState != 0 {
        let bv: bool = false;
        let st = sa_json_object_get_bool(g.cliPluginEnabledState, pluginId_ptr, pluginId_len, &bv);
        if st == 0 { return bv; };
    };
    // DEFECT(F3-B3): the cache-miss path is blocked — it needs
    // cliSettingsEntries().find(pluginId) plus process.env[entry.enabledEnvVar];
    // pluginHost.sla's cliSettingsEntries is still a comment-only stub whose
    // own sdk ServerPluginRegistry wiring belongs to that unit's fix step.
    // Returning false here matches TS only when no entry exists or its env
    // flag is unset; the entry-present case is the blocked residue.
    return false;
}

fn setCliPluginEnabled(g: &ServerGlobals, pluginId_ptr: ptr, pluginId_len: u64, value: bool) -> void {
    // src/index.ts:979-982: cliPluginEnabledState.set(pluginId, value)
    if g.cliPluginEnabledState == 0 { g.cliPluginEnabledState = idx_json_doc(); };
    let bv: u8 = 0;
    if value { bv = 1; };
    sa_json_object_set_bool(g.cliPluginEnabledState, pluginId_ptr, pluginId_len, bv);
}

