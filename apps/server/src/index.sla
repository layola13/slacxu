// ---- src/index.ts:1963-1990 — resolveWebDist() ----
fn resolveWebDist(out_path: &u64) -> void {
    // src/index.ts:1827-1853: candidates in order — env CODEX_UI_WEB_DIST
    // (resolve()d), exeDir/web-dist, exeDir/web/dist, exeDir/apps/web/dist
    // (exeDir = dirname(process.execPath)), then the module-relative
    // ../../web/dist. The first candidate containing index.html wins; the
    // fallback is resolve(candidates[0] ?? module-relative). Candidates are
    // stored resolved+normalized in TS (resolve/join), and resolve() of an
    // absolute normalized path is lexically the identity, so winners are
    // delivered as stored.
    // Native mapping: this toolchain's build-exe places the binary next to
    // its source file, so exeDir is the module directory (apps/server/src)
    // and the module-relative candidate keeps its literal form
    // exeDir/../../web/dist, normalized.
    *out_path = 0;
    // Env/exe/cwd buffer handles are read but never freed: they are
    // process-lifetime values, and conditionally consuming a ^-handle in a
    // branch breaks SAB phi-state agreement (PhiStateConflict). Every fixed
    // sdk unit follows the same read-only convention for env buffers.
    let cand: IdxTextBuf = IdxTextBuf { bytes: [0u8; 8192], len: 0 };
    let first: IdxTextBuf = IdxTextBuf { bytes: [0u8; 8192], len: 0 };
    let raw: IdxTextBuf = IdxTextBuf { bytes: [0u8; 8192], len: 0 };
    let have_first = false;
    let cwd: IdxTextBuf = IdxTextBuf { bytes: [0u8; 8192], len: 0 };
    let cwdh = sa_env_current_dir();
    if cwdh != 0 {
        let cp: ptr = sa_env_buffer_data(cwdh);
        let cl = sa_env_buffer_len(cwdh);
        idx_tb_push(&cwd, cp, cl);
    };
    let exe_dir: IdxTextBuf = IdxTextBuf { bytes: [0u8; 8192], len: 0 };
    let have_exe = false;
    let exeh = sa_env_current_exe();
    if exeh != 0 {
        let ep: ptr = sa_env_buffer_data(exeh);
        let el = sa_env_buffer_len(exeh);
        idx_tb_push(&raw, ep, el);
        idx_path_dirname(&exe_dir, &raw);
        idx_tb_reset(&raw);
        have_exe = true;
    };
    // Candidate 1: CODEX_UI_WEB_DIST (trimmed; skipped when empty, as in TS).
    let envh = sa_env_get(STR_PTR("CODEX_UI_WEB_DIST"), STR_LEN("CODEX_UI_WEB_DIST"));
    if envh != 0 {
        let ep: ptr = sa_env_buffer_data(envh);
        let el = sa_env_buffer_len(envh);
        let lo: u64 = 0;
        let hi = el;
        let adv = true;
        while adv && lo < hi {
            let c: u8 = 0;
            PTR_BYTE_AT(c, ep, lo);
            if idx_is_ascii_ws(c) { lo = lo + 1; } else { adv = false; };
        }
        let adv2 = true;
        while adv2 && hi > lo {
            let c: u8 = 0;
            PTR_BYTE_AT(c, ep, hi - 1);
            if idx_is_ascii_ws(c) { hi = hi - 1; } else { adv2 = false; };
        }
        let won = false;
        if hi > lo {
            idx_path_resolve(&cand, &cwd, ep, lo, hi);
            won = idx_webdist_consider(&cand, &first, &have_first, out_path);
        };
        if won { return; };
    };
    // Candidates 2-4: under exeDir (TS wraps execPath access in try/catch and
    // skips these when it fails; have_exe is that gate).
    if have_exe {
        idx_tb_copy(&raw, &exe_dir);
        idx_tb_push(&raw, STR_PTR("/web-dist"), STR_LEN("/web-dist"));
        idx_path_normalize(&cand, &raw);
        if idx_webdist_consider(&cand, &first, &have_first, out_path) { return; };
        idx_tb_copy(&raw, &exe_dir);
        idx_tb_push(&raw, STR_PTR("/web/dist"), STR_LEN("/web/dist"));
        idx_path_normalize(&cand, &raw);
        if idx_webdist_consider(&cand, &first, &have_first, out_path) { return; };
        idx_tb_copy(&raw, &exe_dir);
        idx_tb_push(&raw, STR_PTR("/apps/web/dist"), STR_LEN("/apps/web/dist"));
        idx_path_normalize(&cand, &raw);
        if idx_webdist_consider(&cand, &first, &have_first, out_path) { return; };
    };
    // Candidate 5: module-relative ../../web/dist (anchor per header note).
    if have_exe {
        idx_tb_copy(&raw, &exe_dir);
    } else {
        idx_tb_copy(&raw, &cwd);
    };
    idx_tb_push(&raw, STR_PTR("/../../web/dist"), STR_LEN("/../../web/dist"));
    idx_path_normalize(&cand, &raw);
    if idx_webdist_consider(&cand, &first, &have_first, out_path) { return; };
    // Fallback: resolve(candidates[0]) — first considered candidate, stored
    // resolved (have_first is always set: candidate 5 is unconditional).
    if have_first {
        idx_tb_string_handle(&first, out_path);
    };
}
