// ---- src/index.ts:1653-1750 — ssh registry, exit hook, top-level startup awaits ----
// sshThreadBridges = SharedThreadBridgeRegistry<SshCodexBridge>(onRelease: purge sshBridges
//   === released; purge pendingSshServerRequests for it)
// nextSshForwardPort = randomInt(46120, 48960)  (comment: reverse forwards live on the
//   SSH host; randomize this process's allocation window instead of colliding at 46120)
fn allocateSshForwardPort(g: &ServerGlobals) -> i32 {
    // src/index.ts:1611-1615: module counter seeded once with
    // randomInt(46120, 48960); each call returns the counter, increments it,
    // and wraps it back to 46120 once it exceeds 49000. The seed is drawn
    // lazily on first allocate (indistinguishable: only this fn reads the
    // counter). TS draws from crypto randomInt; sa_math_random is the std
    // uniform source (CAPABILITY_MAP §7) — the value is an allocation-window
    // seed, not security material.
    if g.nextSshForwardPort == 0 {
        let r = sa_math_random();
        let off = (r * 2840.0) as i32;
        g.nextSshForwardPort = 46120 + off;
    };
    let port = g.nextSshForwardPort;
    let next = port + 1;
    if next > 49000 { next = 46120; };
    g.nextSshForwardPort = next;
    return port;
}
