// ---- src/index.ts:6346-6405 — project discussion types & state ----
fn projectClientId(ownerId_ptr: ptr, ownerId_len: u64, projectId_ptr: ptr, projectId_len: u64, out: &u64) -> void {
    // src/index.ts:6346: return `project:${ownerId}:${projectId}` — delivered
    // as a JSON string node handle (this unit's string-return model). The
    // bulk-pass comment here omitted the "project:" prefix; the TS source
    // governs.
    let tb: IdxTextBuf = IdxTextBuf { bytes: [0u8; 8192], len: 0 };
    idx_tb_push_byte(&tb, 34);
    idx_tb_push_escaped(&tb, STR_PTR("project:"), STR_LEN("project:"));
    idx_tb_push_escaped(&tb, ownerId_ptr, ownerId_len);
    idx_tb_push_byte(&tb, 58);
    idx_tb_push_escaped(&tb, projectId_ptr, projectId_len);
    idx_tb_push_byte(&tb, 34);
    idx_tb_json_string(&tb, out);
}
