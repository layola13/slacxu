// sa_vm: the mini-agent native tool executor. Mirrors CXU's
// saVmTool.ts at pilot scope: one multiplexed tool whose actions
// are structured ({action, path}), never a command string.
// v2 actions: list_dir, read_file. Results are plain text written
// into `out` (capped; truncation is stated, never silent).
@import "sa_std/fs.sai"
@import "sa_std/string.sa"
@import "helpers.sla"
@import "byteseq.sa"

struct SmallBuf {
    bytes: [u8; 4096],
    len: u64,
}

fn action_is(a_ptr: ptr, a_len: u64, lit_ptr: ptr, lit_len: u64) -> bool {
    let slot = [0u64; 1];
    BYTES_EQ(&slot, a_ptr, a_len, lit_ptr, lit_len);
    return slot[0] == 1;
}

fn sa_vm_execute(action_ptr: ptr, action_len: u64, path_ptr: ptr, path_len: u64, out: &ByteBuf) -> void {
    buf_reset(out);
    if action_is(action_ptr, action_len, STR_PTR("list_dir"), STR_LEN("list_dir")) || action_is(action_ptr, action_len, STR_PTR("list"), STR_LEN("list")) {
        let h: u64 = 0;
        if sa_std_fs_read_dir_json(path_ptr, path_len, 200, &h) != 0 {
            buf_append_lit(out, STR_PTR("error: cannot list directory "), STR_LEN("error: cannot list directory "));
            buf_append_lit(out, path_ptr, path_len);
            return;
        };
        let dp: ptr = sa_fs_dir_buffer_data(h);
        let dl = sa_fs_dir_buffer_len(h);
        let take = dl;
        if take > 4000 { take = 4000; };
        buf_append_lit(out, dp, take);
        if dl > 4000 {
            buf_append_lit(out, STR_PTR("\n[truncated]"), STR_LEN("\n[truncated]"));
        };
        sa_fs_dir_buffer_free(h);
        return;
    };
    if action_is(action_ptr, action_len, STR_PTR("read_file"), STR_LEN("read_file")) || action_is(action_ptr, action_len, STR_PTR("read"), STR_LEN("read")) {
        let total: u64 = 0;
        if sa_std_fs_len(path_ptr, path_len, &total) != 0 {
            buf_append_lit(out, STR_PTR("error: file not found: "), STR_LEN("error: file not found: "));
            buf_append_lit(out, path_ptr, path_len);
            return;
        };
        let fh: u64 = 0;
        if sa_std_fs_open_read(path_ptr, path_len, &fh) != 0 {
            buf_append_lit(out, STR_PTR("error: cannot open: "), STR_LEN("error: cannot open: "));
            buf_append_lit(out, path_ptr, path_len);
            return;
        };
        let chunk = SmallBuf { bytes: [0u8; 4096], len: 0 };
        let read_n: u64 = 0;
        let rst = sa_std_fs_file_read(fh, &chunk.bytes, 4000, &read_n);
        sa_fs_file_close(fh);
        if rst != 0 {
            buf_append_lit(out, STR_PTR("error: read failed: "), STR_LEN("error: read failed: "));
            buf_append_lit(out, path_ptr, path_len);
            return;
        };
        let ci: u64 = 0;
        while ci < read_n {
            if out.len < 40960 {
                out.bytes[out.len] = chunk.bytes[ci];
                out.len = out.len + 1;
            };
            ci = ci + 1;
        }
        if total > read_n {
            buf_append_lit(out, STR_PTR("\n[truncated]"), STR_LEN("\n[truncated]"));
        };
        return;
    };
    buf_append_lit(out, STR_PTR("error: unknown action (supported: list_dir, read_file)"), STR_LEN("error: unknown action (supported: list_dir, read_file)"));
}
