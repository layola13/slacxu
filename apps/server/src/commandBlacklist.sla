struct CommandBlacklistMatch {
    ruleId: [u8; 64], ruleId_len: u64, rule: [u8; 256], rule_len: u64,
    category: u64, // enum: 0 file-delete, 1 git-destructive, 2 disk-destructive, 3 database-destructive, 4 network-external, 5 restricted-read, 6 restricted-probe, 7 custom
}
struct CommandBlacklistEvidence {
    method: [u8; 128], method_len: u64, command: [u8; 8192], command_len: u64,
    cwd: [u8; 1024], cwd_len: u64, has_cwd: bool, threadId: [u8; 256], threadId_len: u64, has_threadId: bool,
    providerId: [u8; 128], providerId_len: u64, has_providerId: bool, groupId: [u8; 128], groupId_len: u64, has_groupId: bool,
    providerName: [u8; 256], providerName_len: u64, has_providerName: bool, groupName: [u8; 256], groupName_len: u64, has_groupName: bool,
    model: [u8; 256], model_len: u64, has_model: bool, workspaceMode: [u8; 64], workspaceMode_len: u64, has_workspaceMode: bool,
    match: CommandBlacklistMatch,
}
// BuiltinRule = CommandBlacklistMatch & {pattern: RegExp, identityAware?: boolean} // DEFECT: RegExp field -> pattern id + comment text
// SSH_KEY_NAMES (raw string in source): id_(rsa|dsa|ecdsa|ed25519|ed448|xmss)(_sk)? | authorized_keys2? | known_hosts2? | ssh_host_*key | .(pub|pem|ppk) negative-lookahead-slash | -----begin * private key
// SSH_SECRET_PATH = (?:[\\/]\.ssh\b|\.ssh[\\/]|SSH_KEY_NAMES); SSH_SECRET_LOOSE = (?:\.ssh\b|SSH_KEY_NAMES)
// SSH_SECRET_RAW_PATH = new RegExp(SSH_SECRET_LOOSE, "i")
// PROBE_VERBS = ls|dir|vdir|ll|stat|file|wc|du|tree|find|fd|locate|readlink|realpath|test|attrib|icacls|takeown|get-childitem|gci|get-item|gi|get-itemproperty|test-path|resolve-path|get-acl|select-string|sls|findstr|where|whereis|which|compgen
// BUILTIN_RULES (id / rule / category / pattern summary, all case-insensitive):
//  file-delete / file or directory deletion / file-delete: command-start rm|rmdir|unlink|shred|del|erase|rd|remove-item|ri with optional sudo/doas/command/env prefixes, negative lookahead for --help/--version // DEFECT: lookahead
//  find-delete / find -delete / file-delete: find ... -delete|--delete
//  git-branch-delete / git branch deletion / git-destructive: git branch ... -d|-D|--delete
//  git-remote-delete / git remote or remote-ref deletion / git-destructive: push --delete|-d|:ref, remote remove|rm|prune, update-ref -d, symbolic-ref --delete
//  git-history-destructive / git-destructive: reset --hard, clean, checkout -- / ., restore, rebase, filter-branch|repo, reflog delete|expire, tag -d, worktree remove, gc --prune, stash drop|clear, prune, notes remove, replace -d
//  git-force-write / forced Git remote update / git-destructive: git push ... --force|-f|--mirror
//  disk-format / disk-destructive: format(.com)?|mkfs.*|diskpart|clear-disk|format-volume, or dd with if=
//  database-destructive / database-destructive: drop database|schema|table|index|view, truncate, delete from, alter table drop, redis flushall|flushdb, mongo dropDatabase, docker volume|system rm|prune, kubectl delete, aws s3 rm --recursive, az storage delete
//  external-http / non-search third-party HTTP request / network-external: curl|wget|http|httpie with URL or var, invoke-webrequest|invoke-restmethod|start-bitstransfer, python requests/urllib, node fetch/axios, git clone https, scp|sftp|rsync host:path, rclone copy|sync|move
//  windows-special-read / restricted-read: drive-letter or bare windows|program files|programdata|$recycle.bin|system volume information paths, users/<name>/appdata
//  credential-probe / restricted-probe / identityAware: PROBE_VERBS or [ -x test ] ... SSH_SECRET_LOOSE; find -name/-path/-regex for key names; grep|rg|ag|select-string|findstr for private-key markers; ssh-keyscan; ssh -G; scanner tools (nmap|masscan|zmap|zgrab|rustscan|naabu|nping|hping|arp-scan|arping|netdiscover|fping|nbtscan|portqry|test-netconnection); nc -z variants
//  ssh-key-read / restricted-read / identityAware: SSH_SECRET_PATH or ssh-add -[lLe]

