// L212-217: removeTurnHold(threadId, turnId)
fn threadSubscriptionRegistry_removeTurnHold(reg: &ThreadSubscriptionRegistry, tid_ptr: ptr, tid_len: u64, turn_ptr: ptr, turn_len: u64) -> i32 {
