// L219-268: private async ensureSubscribed(entry)
// DEFECT: async -> synchronous; client.getStatus()/client.request are extern RPC approximations.
fn threadSubscriptionRegistry_ensureSubscribed(reg: &ThreadSubscriptionRegistry, ei: i64) -> i32 {
    if ei < 0 { return 0; };
    if threadSubscriptionRegistry_entry_is_subscribed(reg, ei) != 0 { return 0; };
    if threadSubscriptionRegistry_entry_has_timer(reg, ei) != 0 { return 0; };
    if threadSubscriptionRegistry_entry_is_retry_exhausted(reg, ei) != 0 { return 0; };
    if threadSubscriptionRegistry_entry_is_lease_blocked(reg, ei) != 0 { return 0; };
    // const client = this.getClient(entry.threadId); status.phase !== "ready" -> return
    // DEFECT: getClient closure dispatch -> extern client_status_phase(reg.get_client_id, threadId)
    if threadSubscriptionRegistry_client_ready(reg, ei) == 0 { return 0; };
    // if (writerLeases && !writerLeases.acquire(threadId)) { leaseBlocked=true; emit("subscriptionError", {...Error}) ; return; }
    if reg.has_writer_leases {
        if threadSubscriptionRegistry_acquire_lease(reg, ei) == 0 {
            threadSubscriptionRegistry_entry_set_lease_blocked(reg, ei, 1);
            // DEFECT: EventEmitter.emit("subscriptionError", {threadId, error: new Error(...)}) -> host callback stub
            threadSubscriptionRegistry_emit_subscription_error(reg, ei, 1);
            return 0;
        };
    };
    // try { subscribed=true; await client.request("thread/resume", {threadId});
    //       if entry replaced meanwhile -> unsubscribe + return; reset retry counters }
    // catch (error) { if replaced return; emit subscriptionError;
    //       if isActiveWriterConflict -> leaseBlocked, release lease, return;
    //       release lease; subscribed=false; scheduleRetry }
    // DEFECT: try/catch + Promise await -> blocking extern threadSubscriptionRegistry_rpc_resume returning status code; error object -> code + message buffer.
    threadSubscriptionRegistry_entry_set_subscribed(reg, ei, 1);
    let rc = threadSubscriptionRegistry_rpc_resume(reg, ei);
    if threadSubscriptionRegistry_entry_still_current(reg, ei) == 0 {
        let rc2 = threadSubscriptionRegistry_rpc_unsubscribe_current(reg, ei);
        return rc2;
    };
    if rc == 0 {
        threadSubscriptionRegistry_entry_reset_retry(reg, ei);
        return 0;
    };
    threadSubscriptionRegistry_emit_subscription_error(reg, ei, 0);
    if threadSubscriptionRegistry_last_error_is_writer_conflict(reg, ei) != 0 {
        threadSubscriptionRegistry_entry_set_subscribed(reg, ei, 0);
        threadSubscriptionRegistry_entry_set_lease_blocked(reg, ei, 1);
        threadSubscriptionRegistry_entry_reset_retry(reg, ei);
        threadSubscriptionRegistry_release_lease_idx(reg, ei);
        return 0;
    };
    threadSubscriptionRegistry_release_lease_idx(reg, ei);
    threadSubscriptionRegistry_entry_set_subscribed(reg, ei, 0);
    return threadSubscriptionRegistry_scheduleRetry(reg, ei);
}

// L270-288: private scheduleRetry(entry) — setTimeout exponential backoff
fn threadSubscriptionRegistry_scheduleRetry(reg: &ThreadSubscriptionRegistry, ei: i64) -> i32 {
    if threadSubscriptionRegistry_entry_has_timer(reg, ei) != 0 { return 0; };
    if threadSubscriptionRegistry_entry_refcount(reg, ei) == 0 { return 0; };
    if threadSubscriptionRegistry_entry_retry_attempt(reg, ei) >= SUBSCRIPTION_RETRY_MAX_ATTEMPTS {
        threadSubscriptionRegistry_entry_set_retry_exhausted(reg, ei, 1);
        return 0;
    };
    // delayMs = min(MAX, BASE * 2 ** min(attempt, 6))
    let attempt = threadSubscriptionRegistry_entry_retry_attempt(reg, ei);
    let shift = attempt;
    if shift > 6 { shift = 6; };
    let delay_ms = SUBSCRIPTION_RETRY_BASE_MS * (1 << shift);
    if delay_ms > SUBSCRIPTION_RETRY_MAX_MS { delay_ms = SUBSCRIPTION_RETRY_MAX_MS; };
    threadSubscriptionRegistry_entry_inc_retry_attempt(reg, ei);
    // DEFECT: setTimeout(callback, delayMs) timer + closure capture of entry -> host timer registration; callback re-checks entry identity then ensureSubscribed.
    threadSubscriptionRegistry_entry_set_timer(reg, ei, delay_ms);
    return 0;
}

// L290-312: private async evaluateUnsubscribe(entry)
// DEFECT: async -> synchronous; await client.request -> blocking extern.
fn threadSubscriptionRegistry_evaluateUnsubscribe(reg: &ThreadSubscriptionRegistry, ei: i64) -> i32 {
    if threadSubscriptionRegistry_entry_refcount(reg, ei) > 0 { return 0; };
    threadSubscriptionRegistry_entry_clear_timer(reg, ei);
    if threadSubscriptionRegistry_entry_is_subscribed(reg, ei) == 0 {
        // capture threadId before delete for lease release (source deletes then releases by entry.threadId)
        threadSubscriptionRegistry_delete_entry_and_release(reg, ei);
        return 0;
    };
    // client ready check, subscribed=false, delete entry, await unsubscribe (errors swallowed), release lease
    let ready = threadSubscriptionRegistry_client_ready(reg, ei);
    threadSubscriptionRegistry_entry_set_subscribed(reg, ei, 0);
    threadSubscriptionRegistry_delete_entry_keep_id(reg, ei);
    if ready != 0 {
        let rc = threadSubscriptionRegistry_rpc_unsubscribe_saved(reg, ei);
        if rc != 0 { /* catch {} in source */ };
    };
    threadSubscriptionRegistry_release_lease_saved(reg, ei);
    return 0;
}

// L314-330: private async reAttachAll()
// DEFECT: async sequential await in for..of over Map.values() -> index loop with blocking calls.
fn threadSubscriptionRegistry_reAttachAll(reg: &ThreadSubscriptionRegistry) -> i32 {
    let i: u64 = 0;
    while i < reg.entries_len {
        if threadSubscriptionRegistry_entry_refcount(reg, i) > 0 {
            threadSubscriptionRegistry_entry_clear_timer(reg, i);
            threadSubscriptionRegistry_entry_reset_flags(reg, i);
            let rc = threadSubscriptionRegistry_ensureSubscribed(reg, i);
            if rc != 0 { return rc; };
        };
        i = i + 1;
    }
    return 0;
}

