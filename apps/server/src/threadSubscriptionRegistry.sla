const SUBSCRIPTION_RETRY_BASE_MS: u64 = 500;
const SUBSCRIPTION_RETRY_MAX_MS: u64 = 30000;
const SUBSCRIPTION_RETRY_MAX_ATTEMPTS: u64 = 1;

