// L36-58: watch(threadId, clientId)
fn threadSubscriptionRegistry_watch(reg: &ThreadSubscriptionRegistry, tid_ptr: ptr, tid_len: u64, cid_ptr: ptr, cid_len: u64) -> i32 {
    // DEFECT: Map.get/set + Set.add approximated by fixed-array scan/insert (registry_find_or_create).
    let ei = threadSubscriptionRegistry_find_or_create(reg, tid_ptr, tid_len, 0);
    if ei < 0 { return -1; };
    // entry.watchers.add(clientId); if (!subscribed && !retryTimer) reset retry state
    threadSubscriptionRegistry_entry_add_watcher(reg, ei, cid_ptr, cid_len);
    // void this.ensureSubscribed(entry) — fire-and-forget async (DEFECT: async)
    let rc = threadSubscriptionRegistry_ensureSubscribed(reg, ei);
    return rc;
}

// L60-65: unwatch(threadId, clientId)
fn threadSubscriptionRegistry_unwatch(reg: &ThreadSubscriptionRegistry, tid_ptr: ptr, tid_len: u64, cid_ptr: ptr, cid_len: u64) -> i32 {
    let ei = threadSubscriptionRegistry_find(reg, tid_ptr, tid_len);
    if ei < 0 { return 0; };
    threadSubscriptionRegistry_entry_remove_watcher(reg, ei, cid_ptr, cid_len);
    return threadSubscriptionRegistry_evaluateUnsubscribe(reg, ei);
}

// L67-74: unwatchAllForClient(clientId) — iterates Map.values()
fn threadSubscriptionRegistry_unwatchAllForClient(reg: &ThreadSubscriptionRegistry, cid_ptr: ptr, cid_len: u64) -> i32 {
    let i: u64 = 0;
    while i < reg.entries_len {
        // DEFECT: mutation during Map iteration; snapshot index loop used.
        if threadSubscriptionRegistry_entry_has_watcher(reg, i, cid_ptr, cid_len) {
            threadSubscriptionRegistry_entry_remove_watcher(reg, i, cid_ptr, cid_len);
            let rc = threadSubscriptionRegistry_evaluateUnsubscribe(reg, i);
            if rc != 0 { return rc; };
        };
        i = i + 1;
    }
    return 0;
}

// L76-95: addTurnHold(threadId, turnId)
fn threadSubscriptionRegistry_addTurnHold(reg: &ThreadSubscriptionRegistry, tid_ptr: ptr, tid_len: u64, turn_ptr: ptr, turn_len: u64) -> i32 {
    let ei = threadSubscriptionRegistry_find_or_create(reg, tid_ptr, tid_len, 0);
