    get_client_id: u64,
    has_writer_leases: bool,
    writer_leases_id: u64, // ThreadWriterLeaseStore handle (opaque)
    // Diagnostics scratch (TS diagnostics() returns a fresh object; DEFECT: dynamic object -> JSON text buffer)
    diag_json: [u8; 65536],
    diag_json_len: u64,
}

