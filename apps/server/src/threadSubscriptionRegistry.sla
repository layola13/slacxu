fn threadSubscriptionRegistry_close(reg: &ThreadSubscriptionRegistry, tid_ptr: ptr, tid_len: u64) -> i32 {
    let ei = threadSubscriptionRegistry_find(reg, tid_ptr, tid_len);
    if ei < 0 {
        threadSubscriptionRegistry_release_lease(reg, tid_ptr, tid_len);
        return 0;
    };
    threadSubscriptionRegistry_entry_clear_timer(reg, ei);
    let was_sub = threadSubscriptionRegistry_entry_is_subscribed(reg, ei);
    threadSubscriptionRegistry_delete_entry(reg, ei);
    // try { if (subscribed && client ready) await client.request("thread/unsubscribe", {threadId}) } catch {} finally { writerLeases.release }
    // DEFECT: try/catch/finally + dynamic JSON-RPC params object -> extern rpc call with fixed method buffer; errors swallowed as in source.
    if was_sub != 0 {
        let rc = threadSubscriptionRegistry_rpc_unsubscribe(reg, tid_ptr, tid_len);
        if rc != 0 { /* catch {} in source */ };
    };
    threadSubscriptionRegistry_release_lease(reg, tid_ptr, tid_len);
    return 0;
}

// L174-176: isSubscribed(threadId)
fn threadSubscriptionRegistry_isSubscribed(reg: &ThreadSubscriptionRegistry, tid_ptr: ptr, tid_len: u64) -> bool {
    let ei = threadSubscriptionRegistry_find(reg, tid_ptr, tid_len);
    if ei < 0 { return false; };
    return threadSubscriptionRegistry_entry_is_subscribed(reg, ei) != 0;
}

