    threadSubscriptionRegistry_entry_add_turn_hold(reg, ei, turn_ptr, turn_len);
    return threadSubscriptionRegistry_ensureSubscribed(reg, ei);
}

// L97-120: markSubscribed(threadId)
fn threadSubscriptionRegistry_markSubscribed(reg: &ThreadSubscriptionRegistry, tid_ptr: ptr, tid_len: u64) -> i32 {
    let ei = threadSubscriptionRegistry_find_or_create(reg, tid_ptr, tid_len, 1);
    if ei < 0 { return -1; };
    // clearTimeout(entry.retryTimer); subscribed=true; reset retry/lease flags
    threadSubscriptionRegistry_entry_clear_timer(reg, ei);
    threadSubscriptionRegistry_entry_set_subscribed(reg, ei, 1);
    return 0;
}

// L122-127: markUnsubscribed(threadId)
fn threadSubscriptionRegistry_markUnsubscribed(reg: &ThreadSubscriptionRegistry, tid_ptr: ptr, tid_len: u64) -> i32 {
    let ei = threadSubscriptionRegistry_find(reg, tid_ptr, tid_len);
    if ei >= 0 {
        threadSubscriptionRegistry_entry_clear_timer(reg, ei);
        threadSubscriptionRegistry_delete_entry(reg, ei);
    };
    // this.writerLeases?.release(threadId)
    threadSubscriptionRegistry_release_lease(reg, tid_ptr, tid_len);
    return 0;
}

// L129-149: markClosed(threadId)
fn threadSubscriptionRegistry_markClosed(reg: &ThreadSubscriptionRegistry, tid_ptr: ptr, tid_len: u64) -> i32 {
    let ei = threadSubscriptionRegistry_find(reg, tid_ptr, tid_len);
    if ei < 0 {
        threadSubscriptionRegistry_release_lease(reg, tid_ptr, tid_len);
        return 0;
    };
    threadSubscriptionRegistry_entry_clear_timer(reg, ei);
    threadSubscriptionRegistry_entry_reset_flags(reg, ei);
    threadSubscriptionRegistry_release_lease(reg, tid_ptr, tid_len);
    if threadSubscriptionRegistry_entry_refcount(reg, ei) > 0 {
        return threadSubscriptionRegistry_ensureSubscribed(reg, ei);
    };
    threadSubscriptionRegistry_delete_entry(reg, ei);
    return 0;
}

// L151-172: async close(threadId): Promise<void>
