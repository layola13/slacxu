// Shared byte-buffer helpers for the mini-agent package.
@import "sa_std/string.sa"
@import "sa_std/ptr.sa"

struct ByteBuf {
    bytes: [u8; 40960],
    len: u64,
}

fn buf_reset(b: &ByteBuf) -> void {
    b.len = 0;
}

fn buf_append_lit(b: &ByteBuf, src_ptr: ptr, src_len: u64) -> void {
    let byte: u8 = 0;
    for i in 0..src_len {
        PTR_BYTE_AT(byte, src_ptr, i);
        if b.len < 40960 {
            b.bytes[b.len] = byte;
            b.len = b.len + 1;
        };
    }
}

// Appends a JSON-escaped copy of the source bytes.
fn buf_append_escaped(b: &ByteBuf, src_ptr: ptr, src_len: u64) -> void {
    let byte: u8 = 0;
    for i in 0..src_len {
        PTR_BYTE_AT(byte, src_ptr, i);
        if byte == 34 {
            buf_append_lit(b, STR_PTR("\\\""), STR_LEN("\\\""));
        } else if byte == 92 {
            buf_append_lit(b, STR_PTR("\\\\"), STR_LEN("\\\\"));
        } else if byte == 10 {
            buf_append_lit(b, STR_PTR("\\n"), STR_LEN("\\n"));
        } else if byte == 13 {
            buf_append_lit(b, STR_PTR("\\r"), STR_LEN("\\r"));
        } else if byte == 9 {
            buf_append_lit(b, STR_PTR("\\t"), STR_LEN("\\t"));
        } else {
            if b.len < 40960 {
                b.bytes[b.len] = byte;
                b.len = b.len + 1;
            };
        };
    }
}

fn buf_append_u64(b: &ByteBuf, v: u64) -> void {
    let digits = [0u8; 20];
    let n: u64 = 0;
    let x = v;
    if x == 0 {
        digits[0] = 48;
        n = 1;
    };
    while x > 0 {
        digits[n] = 48 + (x % 10) as u8;
        n = n + 1;
        x = x / 10;
    }
    let i = n;
    while i > 0 {
        i = i - 1;
        if b.len < 40960 {
            b.bytes[b.len] = digits[i];
            b.len = b.len + 1;
        };
    }
}

// Appends a JSON-escaped copy of src's contents into dst.
fn buf_append_escaped_buf(dst: &ByteBuf, src: &ByteBuf) -> void {
    for i in 0..src.len {
        let byte = src.bytes[i];
        if byte == 34 {
            buf_append_lit(dst, STR_PTR("\\\""), STR_LEN("\\\""));
        } else if byte == 92 {
            buf_append_lit(dst, STR_PTR("\\\\"), STR_LEN("\\\\"));
        } else if byte == 10 {
            buf_append_lit(dst, STR_PTR("\\n"), STR_LEN("\\n"));
        } else if byte == 13 {
            buf_append_lit(dst, STR_PTR("\\r"), STR_LEN("\\r"));
        } else if byte == 9 {
            buf_append_lit(dst, STR_PTR("\\t"), STR_LEN("\\t"));
        } else {
            if dst.len < 40960 {
                dst.bytes[dst.len] = byte;
                dst.len = dst.len + 1;
            };
        };
    }
}

// Appends src's current contents into dst (struct-to-struct copy;
// field arrays are indexed in place, never passed as ptr args).
fn buf_append_buf(dst: &ByteBuf, src: &ByteBuf) -> void {
    for i in 0..src.len {
        if dst.len < 40960 {
            dst.bytes[dst.len] = src.bytes[i];
            dst.len = dst.len + 1;
        };
    }
}

// Substring search over raw bytes (needle given as a literal).
fn bytes_contains(hay_ptr: ptr, hay_len: u64, needle_ptr: ptr, needle_len: u64) -> bool {
    if needle_len == 0 { return true; };
    if hay_len < needle_len { return false; };
    let i: u64 = 0;
    let hb: u8 = 0;
    let nb: u8 = 0;
    while i + needle_len <= hay_len {
        let ok = true;
        for j in 0..needle_len {
            PTR_BYTE_AT(hb, hay_ptr, i + j);
            PTR_BYTE_AT(nb, needle_ptr, j);
            if hb != nb { ok = false; };
        }
        if ok { return true; };
        i = i + 1;
    }
    return false;
}
