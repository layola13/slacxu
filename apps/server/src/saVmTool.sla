fn nativeReadMany(files: &ListBuf, options: &JsonBuf, policy_doc: u64, cwd: &StrBuf, started_at: f64, out: &SaVmRunResult) -> i32 {
    let list = ListBuf { bytes: [0u8; 131072], len: 0 };
    let fv = StrBuf { bytes: [0u8; 65536], len: 0 };
    let fi: u64 = 0;
    while fi < lb_count(files) && lb_count(&list) < 10 {
        let g1: bool = lb_at(files, fi, &fv);
        let ft = StrBuf { bytes: [0u8; 65536], len: 0 };
        tool_sb_trim(&fv, &ft);
        if ft.len > 0 { lb_append(&list, sb_ptr(&ft), ft.len); };
        fi = fi + 1;
    }
    if lb_count(&list) == 0 {
        res_sa_error(out, STR_PTR("files parameter is required for read_many (array of file paths, max 10). Use {\"action\":\"read_many\",\"files\":[\"src/a.ts\",\"src/b.ts\"]} with one shared start_line/end_line; for different slices use {\"action\":\"parallel\",\"parallel\":[...]}."), STR_LEN("files parameter is required for read_many (array of file paths, max 10). Use {\"action\":\"read_many\",\"files\":[\"src/a.ts\",\"src/b.ts\"]} with one shared start_line/end_line; for different slices use {\"action\":\"parallel\",\"parallel\":[...]}."), started_at);
        return 0;
    };
    let odoc: u64 = jdoc_of_jb(options);
    let per_file: f64 = clampIntKey(odoc, STR_PTR("max_tokens_per_file"), STR_LEN("max_tokens_per_file"), 2000.0, 200.0, 8000.0);
    let total_budget: f64 = 8000.0;
    let mt: f64 = 0.0;
    let mt_has: bool = false;
    if odoc != 0 { read_opt_num(odoc, STR_PTR("max_tokens"), STR_LEN("max_tokens"), STR_PTR(""), 0, &mt, &mt_has); };
    if mt_has && mt > 0.0 {
        total_budget = mt;
        if total_budget > 32000.0 { total_budget = 32000.0; };
    };
    let results: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    let used: f64 = 0.0;
    let file = StrBuf { bytes: [0u8; 65536], len: 0 };
    let ii: u64 = 0;
    while ii < lb_count(&list) {
        let g1: bool = lb_at(&list, ii, &file);
        let remaining: f64 = total_budget - used;
        let ro: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
        if ro != 0 {
            jset_str(ro, STR_PTR("path"), STR_LEN("path"), sb_ptr(&file), file.len);
            if remaining < 200.0 {
                jset_bool(ro, STR_PTR("ok"), STR_LEN("ok"), false);
                jset_str(ro, STR_PTR("error"), STR_LEN("error"), STR_PTR("total max_tokens budget exhausted"), STR_LEN("total max_tokens budget exhausted"));
            } else {
                // sub-options for nativeReadFile
                let sub_opts = JsonBuf { bytes: [0u8; 262144], len: 0 };
                jb_append(&sub_opts, STR_PTR("{"), STR_LEN("{"));
                let first_f: bool = true;
                let sv: f64 = 0.0;
                let sh: bool = false;
                if odoc != 0 { read_opt_num(odoc, STR_PTR("start_line"), STR_LEN("start_line"), STR_PTR("startLine"), STR_LEN("startLine"), &sv, &sh); };
                if sh {
                    jb_append(&sub_opts, STR_PTR("\"startLine\":"), STR_LEN("\"startLine\":"));
                    let t = StrBuf { bytes: [0u8; 65536], len: 0 };
                    fmt_f64_sb(sv, &t);
                    jb_append(&sub_opts, sb_ptr(&t), t.len);
                    first_f = false;
                };
                if odoc != 0 { read_opt_num(odoc, STR_PTR("end_line"), STR_LEN("end_line"), STR_PTR("endLine"), STR_LEN("endLine"), &sv, &sh); } else { sh = false; };
                if sh {
                    if !first_f { jb_append(&sub_opts, STR_PTR(","), STR_LEN(",")); };
                    jb_append(&sub_opts, STR_PTR("\"endLine\":"), STR_LEN("\"endLine\":"));
                    let t = StrBuf { bytes: [0u8; 65536], len: 0 };
                    fmt_f64_sb(sv, &t);
                    jb_append(&sub_opts, sb_ptr(&t), t.len);
                    first_f = false;
                };
                if !first_f { jb_append(&sub_opts, STR_PTR(","), STR_LEN(",")); };
                jb_append(&sub_opts, STR_PTR("\"maxTokens\":"), STR_LEN("\"maxTokens\":"));
                let eff: f64 = per_file;
                if remaining < eff { eff = remaining; };
                let t = StrBuf { bytes: [0u8; 65536], len: 0 };
                fmt_f64_sb(eff, &t);
                jb_append(&sub_opts, sb_ptr(&t), t.len);
                jb_append(&sub_opts, STR_PTR(",\"numbered\":true}"), STR_LEN(",\"numbered\":true}"));
                let sub = run_result_new();
                nativeReadFile(&file, &sub_opts, policy_doc, cwd, started_at, &sub);
                if sub.ok {
                    jset_bool(ro, STR_PTR("ok"), STR_LEN("ok"), true);
                    let fp102: ptr = PTR_NULL(); PTR_BYTE_ADD(fp102, &sub.stdout, 0);
                    jset_str(ro, STR_PTR("text"), STR_LEN("text"), fp102, sub.stdout_len);
                    let so = StrBuf { bytes: [0u8; 65536], len: 0 };
                    let fp13: ptr = PTR_NULL(); PTR_BYTE_ADD(fp13, &sub.stdout, 0); sb_append(&so, fp13, sub.stdout_len);
                    used = used + estimateTokenCount(&so);
                } else {
                    jset_bool(ro, STR_PTR("ok"), STR_LEN("ok"), false);
                    if sub.stderr_len > 0 {
                        let fp103: ptr = PTR_NULL(); PTR_BYTE_ADD(fp103, &sub.stderr, 0);
                        jset_str(ro, STR_PTR("error"), STR_LEN("error"), fp103, sub.stderr_len);
                    } else {
                        jset_str(ro, STR_PTR("error"), STR_LEN("error"), STR_PTR("read failed"), STR_LEN("read failed"));
                    };
                };
            };
            if results != 0 { let rp: i32 = sa_json_array_push_node(results, ro); };
        };
        ii = ii + 1;
    }
    if results != 0 {
        let cjb = JsonBuf { bytes: [0u8; 262144], len: 0 };
        jdoc_to_jb(results, &cjb);
        let pretty = JsonBuf { bytes: [0u8; 262144], len: 0 };
        json_pretty_into(jb_ptr(&cjb), cjb.len, &pretty);
        res_success(out, started_at);
        res_set_stdout(out, jb_ptr(&pretty), pretty.len);
        sa_json_free(results);
    };
    if odoc != 0 { sa_json_free(odoc); };
    return 0;
}

// ---- tree-sitter backed natives (part 1) ----
fn moveWithImports_stripExt(p: &StrBuf, out: &StrBuf) -> void {
    out.len = 0;
    let exts5 = ListBuf { bytes: [0u8; 131072], len: 0 };
    lb_append(&exts5, STR_PTR(".ctsx"), STR_LEN(".ctsx"));
    lb_append(&exts5, STR_PTR(".mtsx"), STR_LEN(".mtsx"));
    lb_append(&exts5, STR_PTR(".cjsx"), STR_LEN(".cjsx"));
    lb_append(&exts5, STR_PTR(".mjsx"), STR_LEN(".mjsx"));
    let exts4 = ListBuf { bytes: [0u8; 131072], len: 0 };
    lb_append(&exts4, STR_PTR(".tsx"), STR_LEN(".tsx"));
    lb_append(&exts4, STR_PTR(".jsx"), STR_LEN(".jsx"));
    lb_append(&exts4, STR_PTR(".cts"), STR_LEN(".cts"));
    lb_append(&exts4, STR_PTR(".mts"), STR_LEN(".mts"));
    lb_append(&exts4, STR_PTR(".cjs"), STR_LEN(".cjs"));
    lb_append(&exts4, STR_PTR(".mjs"), STR_LEN(".mjs"));
    let ev = StrBuf { bytes: [0u8; 65536], len: 0 };
    let i: u64 = 0;
    while i < lb_count(&exts5) {
        let g1: bool = lb_at(&exts5, i, &ev);
        if sb_ends(p, sb_ptr(&ev), ev.len) {
            sb_append(out, sb_ptr(p), p.len - ev.len);
            return;
        };
        i = i + 1;
    }
    i = 0;
    while i < lb_count(&exts4) {
        let g1: bool = lb_at(&exts4, i, &ev);
        if sb_ends(p, sb_ptr(&ev), ev.len) {
            sb_append(out, sb_ptr(p), p.len - ev.len);
            return;
        };
        i = i + 1;
    }
    if sb_ends(p, STR_PTR(".ts"), STR_LEN(".ts")) {
        sb_append(out, sb_ptr(p), p.len - 3);
        return;
    };
    if sb_ends(p, STR_PTR(".js"), STR_LEN(".js")) {
        sb_append(out, sb_ptr(p), p.len - 3);
        return;
    };
    sb_copy(out, p);
}

fn ts_state_and_pool(st_out: &TreeSitterState) -> void {
    ts_state_fresh(st_out);
}

fn nativeRenameSymbol(raw_symbol: &StrBuf, raw_new_name: &StrBuf, options: &JsonBuf, policy_doc: u64, cwd: &StrBuf, started_at: f64, out: &SaVmRunResult) -> i32 {
    let symbol = StrBuf { bytes: [0u8; 65536], len: 0 };
    tool_sb_trim(raw_symbol, &symbol);
    let new_name = StrBuf { bytes: [0u8; 65536], len: 0 };
    tool_sb_trim(raw_new_name, &new_name);
    if symbol.len == 0 {
        res_sa_error(out, STR_PTR("symbol (or old_name) parameter is required for rename_symbol"), STR_LEN("symbol (or old_name) parameter is required for rename_symbol"), started_at);
        return 0;
    };
    if new_name.len == 0 {
        res_sa_error(out, STR_PTR("new_name parameter is required for rename_symbol"), STR_LEN("new_name parameter is required for rename_symbol"), started_at);
        return 0;
    };
    if tool_bytes_eq(sb_ptr(&symbol), symbol.len, sb_ptr(&new_name), new_name.len) {
        let em = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_assign(&em, STR_PTR("[rename_symbol] old name '"), STR_LEN("[rename_symbol] old name '"));
        sb_append(&em, sb_ptr(&symbol), symbol.len);
        sb_append(&em, STR_PTR("' and new name '"), STR_LEN("' and new name '"));
        sb_append(&em, sb_ptr(&new_name), new_name.len);
        sb_append(&em, STR_PTR("' are identical; no changes applied."), STR_LEN("' are identical; no changes applied."));
        res_success(out, started_at);
        res_set_stdout(out, sb_ptr(&em), em.len);
