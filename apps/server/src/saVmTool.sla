fn moveWithImports_adjust(content: &StrBuf, old_dir: &StrBuf, new_dir: &StrBuf, out: &StrBuf, adjusted: &bool) -> void {
    // /(from\s+['"]|import\s*\(['"])(\.[^'"]+)(['"])/g with a resolver callback
    *adjusted = false;
    out.len = 0;
    let i: u64 = 0;
    let n: u64 = content.len;
    while i < n {
        // try "from" + ws + quote
        let matched: bool = false;
        let prefix_end: u64 = 0;
        let quote: u8 = 0;
        if i + 4 <= n && content.bytes[i] == 102 && content.bytes[i + 1] == 114 && content.bytes[i + 2] == 111 && content.bytes[i + 3] == 109 {
            let j: u64 = i + 4;
            let ws_start: u64 = j;
            while j < n && (content.bytes[j] == 32 || content.bytes[j] == 9 || content.bytes[j] == 10 || content.bytes[j] == 13) { j = j + 1; }
            if j > ws_start && j < n && (content.bytes[j] == 39 || content.bytes[j] == 34) {
                matched = true;
                prefix_end = j + 1;
                quote = content.bytes[j];
            };
        };
        if !matched && i + 6 <= n && content.bytes[i] == 105 && content.bytes[i + 1] == 109 && content.bytes[i + 2] == 112 && content.bytes[i + 3] == 111 && content.bytes[i + 4] == 114 && content.bytes[i + 5] == 116 {
            let j: u64 = i + 6;
            while j < n && (content.bytes[j] == 32 || content.bytes[j] == 9 || content.bytes[j] == 10 || content.bytes[j] == 13) { j = j + 1; }
            if j < n && content.bytes[j] == 40 {
                j = j + 1;
                if j < n && (content.bytes[j] == 39 || content.bytes[j] == 34) {
                    matched = true;
                    prefix_end = j + 1;
                    quote = content.bytes[j];
                };
            };
        };
        if matched {
            // specifier until the same quote
            let send: u64 = prefix_end;
            while send < n && content.bytes[send] != quote { send = send + 1; }
            if send < n && send > prefix_end && content.bytes[prefix_end] == 46 {
                let spec = StrBuf { bytes: [0u8; 65536], len: 0 };
                let pr11781_0: ptr = PTR_NULL();
                PTR_BYTE_ADD(pr11781_0, sb_ptr(content), prefix_end);
                sb_append(&spec, pr11781_0, send - prefix_end);
                let target = StrBuf { bytes: [0u8; 65536], len: 0 };
                path_resolve(old_dir, &spec, &target);
                let adj = StrBuf { bytes: [0u8; 65536], len: 0 };
                tool_path_relative(new_dir, &target, &adj);
                let norm_adj = StrBuf { bytes: [0u8; 65536], len: 0 };
                if adj.len > 0 && adj.bytes[0] == 46 {
                    sb_copy(&norm_adj, &adj);
                } else {
                    sb_assign(&norm_adj, STR_PTR("./"), STR_LEN("./"));
                    sb_append(&norm_adj, sb_ptr(&adj), adj.len);
                };
                let pr11793_0: ptr = PTR_NULL();
                PTR_BYTE_ADD(pr11793_0, sb_ptr(content), i);
                sb_append(out, pr11793_0, prefix_end - i);
                sb_append(out, sb_ptr(&norm_adj), norm_adj.len);
                sb_push_byte(out, quote);
                *adjusted = true;
                i = send + 1;
                continue;
            };
        };
        sb_push_byte(out, content.bytes[i]);
        i = i + 1;
    }
}

