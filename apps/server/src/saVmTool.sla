fn fs_is_file_sb(path: &StrBuf) -> bool {
    let h: u64 = sa_fs_metadata(sb_ptr(path), path.len);
    if h == 0 { return false; };
    let r: bool = sa_fs_metadata_is_file(h) != 0;
    sa_std_fs_metadata_free(h);
    return r;
}

fn env_get_sb(key: &StrBuf, out: &StrBuf) -> bool {
    out.len = 0;
    let h: u64 = sa_env_get(sb_ptr(key), key.len);
    if h == 0 { return false; };
    let dp: ptr = sa_env_buffer_data(h);
    let dn: u64 = sa_env_buffer_len(h);
    sb_append(out, dp, dn);
    sa_env_buffer_free(h);
    return true;
}

fn findInSystemPath(bin: &StrBuf, out: &StrBuf) -> bool {
    out.len = 0;
    let pathv = StrBuf { bytes: [0u8; 65536], len: 0 };
    let key = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_append(&key, STR_PTR("PATH"), STR_LEN("PATH"));
    if !env_get_sb(&key, &pathv) { return false; };
    let pp: ptr = sb_ptr(&pathv);
    let start: u64 = 0;
    let i: u64 = 0;
    while i <= pathv.len {
        let at_end: bool = i == pathv.len;
        let is_sep: bool = false;
        if !at_end { if byte_at(pp, i) == 58 { is_sep = true; }; };
        if at_end || is_sep {
            let dir = StrBuf { bytes: [0u8; 65536], len: 0 };
            let dp: ptr = PTR_NULL();
            PTR_BYTE_ADD(dp, pp, start);
            sb_append(&dir, dp, i - start);
            let cand = StrBuf { bytes: [0u8; 65536], len: 0 };
            if dir.len == 0 {
                sb_append(&cand, sb_ptr(bin), bin.len);
            } else {
                path_join(&dir, bin, &cand);
            };
            if fs_exists_sb(&cand) && fs_is_file_sb(&cand) {
                sb_append(out, sb_ptr(&cand), cand.len);
                return true;
            };
            start = i + 1;
        };
        i = i + 1;
    }
    return false;
}

// kind: "" when ok, else "capability_denied" | "unavailable" (into kind_out).
fn resolveHostExecutable(exe_in: &StrBuf, cwd: &StrBuf, out_path: &StrBuf, is_allow: &bool, reason: &StrBuf, kind_out: &StrBuf) -> bool {
    out_path.len = 0;
    reason.len = 0;
    kind_out.len = 0;
    *is_allow = false;
    let clean = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_append(&clean, sb_ptr(exe_in), exe_in.len);
    sb_trim_ip(&clean);
    if clean.len == 0 {
        sb_append(reason, STR_PTR("action 'run_host' requires an 'exe' parameter"), STR_LEN("action 'run_host' requires an 'exe' parameter"));
        sb_append(kind_out, STR_PTR("capability_denied"), STR_LEN("capability_denied"));
        return false;
    };
    let lower = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_append(&lower, sb_ptr(&clean), clean.len);
    sb_lower_ip(&lower);
    if host_name_is_allowlist(&lower) {
        *is_allow = true;
        // env overrides
        let ovr = StrBuf { bytes: [0u8; 65536], len: 0 };
        let has_ovr: bool = false;
        if sb_starts(&lower, STR_PTR("bun"), STR_LEN("bun")) {
            let k1 = StrBuf { bytes: [0u8; 65536], len: 0 };
            sb_append(&k1, STR_PTR("CODEX_UI_BUN_BIN"), STR_LEN("CODEX_UI_BUN_BIN"));
            if env_get_sb(&k1, &ovr) { sb_trim_ip(&ovr); has_ovr = ovr.len > 0; };
            if !has_ovr {
                let k2 = StrBuf { bytes: [0u8; 65536], len: 0 };
                sb_append(&k2, STR_PTR("BUN_BIN"), STR_LEN("BUN_BIN"));
                if env_get_sb(&k2, &ovr) { sb_trim_ip(&ovr); has_ovr = ovr.len > 0; };
            };
        };
        if sb_starts(&lower, STR_PTR("zig"), STR_LEN("zig")) {
            let k1 = StrBuf { bytes: [0u8; 65536], len: 0 };
            sb_append(&k1, STR_PTR("ZIG_EXE"), STR_LEN("ZIG_EXE"));
            if env_get_sb(&k1, &ovr) { sb_trim_ip(&ovr); has_ovr = ovr.len > 0; };
            if !has_ovr {
                let k2 = StrBuf { bytes: [0u8; 65536], len: 0 };
                sb_append(&k2, STR_PTR("ZIG_BIN"), STR_LEN("ZIG_BIN"));
                if env_get_sb(&k2, &ovr) { sb_trim_ip(&ovr); has_ovr = ovr.len > 0; };
            };
        };
        if has_ovr && fs_exists_sb(&ovr) {
            path_resolve(cwd, &ovr, out_path);
            return true;
        };
        if findInSystemPath(&clean, out_path) { return true; };
        if sb_starts(&lower, STR_PTR("cargo"), STR_LEN("cargo")) || sb_starts(&lower, STR_PTR("rustc"), STR_LEN("rustc")) {
            let home = StrBuf { bytes: [0u8; 65536], len: 0 };
            let hk = StrBuf { bytes: [0u8; 65536], len: 0 };
            sb_append(&hk, STR_PTR("HOME"), STR_LEN("HOME"));
            if env_get_sb(&hk, &home) {
                let cb = StrBuf { bytes: [0u8; 65536], len: 0 };
                sb_append(&cb, STR_PTR(".cargo/bin"), STR_LEN(".cargo/bin"));
                let d1 = StrBuf { bytes: [0u8; 65536], len: 0 };
                path_join(&home, &cb, &d1);
                let cand = StrBuf { bytes: [0u8; 65536], len: 0 };
                path_join(&d1, &lower, &cand);
                if fs_exists_sb(&cand) && fs_is_file_sb(&cand) {
                    sb_append(out_path, sb_ptr(&cand), cand.len);
                    return true;
                };
            };
        };
        sb_append(reason, STR_PTR("Binary '"), STR_LEN("Binary '"));
        sb_append(reason, sb_ptr(&clean), clean.len);
        sb_append(reason, STR_PTR("' was not found on PATH or standard install locations"), STR_LEN("' was not found on PATH or standard install locations"));
        sb_append(kind_out, STR_PTR("unavailable"), STR_LEN("unavailable"));
        return false;
    };
    let has_sep: bool = tool_sb_contains(&clean, STR_PTR("/"), STR_LEN("/")) || tool_sb_contains(&clean, STR_PTR("\\"), STR_LEN("\\"));
    if !has_sep {
        sb_append(reason, STR_PTR("exe '"), STR_LEN("exe '"));
        sb_append(reason, sb_ptr(&clean), clean.len);
        sb_append(reason, STR_PTR("' is not permitted. Only allowlist binaries (bun, node, python, zig, cargo, go, rustc, git) or workspace-internal binaries are allowed."), STR_LEN("' is not permitted. Only allowlist binaries (bun, node, python, zig, cargo, go, rustc, git) or workspace-internal binaries are allowed."));
        sb_append(kind_out, STR_PTR("capability_denied"), STR_LEN("capability_denied"));
        return false;
    };
    let resolved = StrBuf { bytes: [0u8; 65536], len: 0 };
    path_resolve(cwd, &clean, &resolved);
    let rl = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_append(&rl, sb_ptr(&resolved), resolved.len);
    sb_lower_ip(&rl);
    let cl = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_append(&cl, sb_ptr(cwd), cwd.len);
    sb_lower_ip(&cl);
    let inside: bool = false;
    if sb_starts(&rl, sb_ptr(&cl), cl.len) {
        if rl.len == cl.len { inside = true; };
        if rl.len > cl.len && byte_at(sb_ptr(&rl), cl.len) == 47 { inside = true; };
    };
    if !inside {
        sb_append(reason, STR_PTR("exe '"), STR_LEN("exe '"));
        sb_append(reason, sb_ptr(&clean), clean.len);
        sb_append(reason, STR_PTR("' is outside permitted workspace roots. Only allowlist binaries (bun, node, python, zig, git) or workspace-internal binaries are allowed."), STR_LEN("' is outside permitted workspace roots. Only allowlist binaries (bun, node, python, zig, git) or workspace-internal binaries are allowed."));
        sb_append(kind_out, STR_PTR("capability_denied"), STR_LEN("capability_denied"));
        return false;
    };
    if !fs_exists_sb(&resolved) || !fs_is_file_sb(&resolved) {
        sb_append(reason, STR_PTR("Workspace executable not found: "), STR_LEN("Workspace executable not found: "));
        sb_append(reason, sb_ptr(&clean), clean.len);
        sb_append(kind_out, STR_PTR("unavailable"), STR_LEN("unavailable"));
        return false;
    };
    sb_append(out_path, sb_ptr(&resolved), resolved.len);
    return true;
}

// sliceAndFilterOutput landing: raw bytes + options doc (input doc).
fn slice_filter_output(raw_p: ptr, raw_n: u64, opts_doc: u64, out: &StrBuf) -> void {
    out.len = 0;
    // split into lines on \n, stripping a trailing \r
    let lines = ListBuf { bytes: [0u8; 131072], len: 0 };
    let start: u64 = 0;
    let i: u64 = 0;
    while i <= raw_n {
        let at_end: bool = i == raw_n;
        let is_nl: bool = false;
        if !at_end { if byte_at(raw_p, i) == 10 { is_nl = true; }; };
        if at_end || is_nl {
            let ln: u64 = i - start;
            if ln > 0 && byte_at(raw_p, start + ln - 1) == 13 { ln = ln - 1; };
            if !(at_end && ln == 0 && raw_n > 0) {
                let lp: ptr = PTR_NULL();
                PTR_BYTE_ADD(lp, raw_p, start);
                lb_append(&lines, lp, ln);
            };
            start = i + 1;
        };
        i = i + 1;
    }
    if raw_n == 0 { lines.len = 0; };
    let total: u64 = lb_count(&lines);
    // optional filter
    let filter = StrBuf { bytes: [0u8; 65536], len: 0 };
    let has_filter: bool = false;
    if opts_doc != 0 {
        let fn_node: u64 = jget_node(opts_doc, STR_PTR("filter"), STR_LEN("filter"));
        if fn_node != 0 && sa_json_node_kind(fn_node) == JK_STRING {
            let fp: ptr = PTR_NULL();
            let fn2: u64 = 0;
            let gst: i32 = sa_json_node_string(fn_node, &fp, &fn2);
            sb_append(&filter, fp, fn2);
            sb_trim_ip(&filter);
            has_filter = filter.len > 0;
        };
    };
    let kept = ListBuf { bytes: [0u8; 131072], len: 0 };
    if has_filter {
        let re: u64 = sa_regex_compile(sb_ptr(&filter), filter.len, 3);
        let li: u64 = 0;
        let line = StrBuf { bytes: [0u8; 65536], len: 0 };
        while li < total {
            if lb_at(&lines, li, &line) {
                let keep: bool = false;
                if re != 0 {
                    keep = re_handle_test(re, sb_ptr(&line), line.len);
                } else {
                    let ll = StrBuf { bytes: [0u8; 65536], len: 0 };
                    sb_append(&ll, sb_ptr(&line), line.len);
                    sb_lower_ip(&ll);
                    let fl = StrBuf { bytes: [0u8; 65536], len: 0 };
                    sb_append(&fl, sb_ptr(&filter), filter.len);
                    sb_lower_ip(&fl);
                    keep = tool_sb_contains(&ll, sb_ptr(&fl), fl.len);
                };
                if keep { lb_append(&kept, sb_ptr(&line), line.len); };
            };
            li = li + 1;
        }
        if re != 0 { sa_regex_free(re); };
    } else {
        kept = lines;
    };
    let n: u64 = lb_count(&kept);
    let head: f64 = -1.0;
    let tail: f64 = -1.0;
    if opts_doc != 0 {
        let hn: u64 = jget_node(opts_doc, STR_PTR("head_lines"), STR_LEN("head_lines"));
        if hn != 0 && (sa_json_node_kind(hn) == JK_INT || sa_json_node_kind(hn) == JK_FLOAT) {
            let v: f64 = sa_json_node_as_f64(hn);
            if v > 0.0 { head = (v as i64) as f64; };
        };
        let tn: u64 = jget_node(opts_doc, STR_PTR("tail_lines"), STR_LEN("tail_lines"));
        if tn != 0 && (sa_json_node_kind(tn) == JK_INT || sa_json_node_kind(tn) == JK_FLOAT) {
            let v2: f64 = sa_json_node_as_f64(tn);
            if v2 > 0.0 { tail = (v2 as i64) as f64; };
        };
    };
    let joined = StrBuf { bytes: [0u8; 65536], len: 0 };
    let line2 = StrBuf { bytes: [0u8; 65536], len: 0 };
    if head > 0.0 && tail > 0.0 && (head + tail) < (n as f64) {
        let hn2: u64 = head as u64;
        let tn2: u64 = tail as u64;
        let a: u64 = 0;
        while a < hn2 {
            if lb_at(&kept, a, &line2) {
                if joined.len > 0 { sb_push_byte(&joined, 10); };
                sb_append(&joined, sb_ptr(&line2), line2.len);
            };
            a = a + 1;
        }
        sb_push_byte(&joined, 10);
        sb_append(&joined, STR_PTR("... [omitted "), STR_LEN("... [omitted "));
        tool_sb_append_u64(n - hn2 - tn2, &joined);
        sb_append(&joined, STR_PTR(" lines]..."), STR_LEN(" lines]..."));
        let b: u64 = n - tn2;
        while b < n {
            if lb_at(&kept, b, &line2) {
                sb_push_byte(&joined, 10);
                sb_append(&joined, sb_ptr(&line2), line2.len);
            };
            b = b + 1;
        }
    } else if head > 0.0 && (head as u64) < n {
        let hn3: u64 = head as u64;
        let a2: u64 = 0;
        while a2 < hn3 {
            if lb_at(&kept, a2, &line2) {
                if joined.len > 0 { sb_push_byte(&joined, 10); };
                sb_append(&joined, sb_ptr(&line2), line2.len);
            };
            a2 = a2 + 1;
        }
    } else if tail > 0.0 && (tail as u64) < n {
        let tn3: u64 = tail as u64;
        let b2: u64 = n - tn3;
        while b2 < n {
            if lb_at(&kept, b2, &line2) {
                if joined.len > 0 { sb_push_byte(&joined, 10); };
                sb_append(&joined, sb_ptr(&line2), line2.len);
            };
            b2 = b2 + 1;
        }
    } else {
        let c: u64 = 0;
        while c < n {
            if lb_at(&kept, c, &line2) {
                if joined.len > 0 { sb_push_byte(&joined, 10); };
                sb_append(&joined, sb_ptr(&line2), line2.len);
            };
            c = c + 1;
        }
    };
    let max_tokens: f64 = 4000.0;
    if opts_doc != 0 {
        let mn: u64 = jget_node(opts_doc, STR_PTR("max_tokens"), STR_LEN("max_tokens"));
        if mn != 0 && (sa_json_node_kind(mn) == JK_INT || sa_json_node_kind(mn) == JK_FLOAT) {
            let mv: f64 = sa_json_node_as_f64(mn);
            if mv > 0.0 { max_tokens = mv; };
        };
    };
    let max_chars: u64 = (max_tokens as u64) * 4;
    if joined.len > max_chars {
        out.len = 0;
        sb_append(out, sb_ptr(&joined), max_chars);
        sb_append(out, STR_PTR("\n[run_host] Output truncated to "), STR_LEN("\n[run_host] Output truncated to "));
        sb_append_f64(max_tokens, out);
        sb_append(out, STR_PTR(" tokens budget."), STR_LEN(" tokens budget."));
    } else {
        sb_append(out, sb_ptr(&joined), joined.len);
    };
}

// ---- process sessions (JSON doc in global bytes cell) ----
fn sessions_load() -> u64 {
    let jb = JsonBuf { bytes: [0u8; 262144], len: 0 };
    let olen: u64 = 0;
    let st: i32 = sa_global_bytes_get(STR_PTR("savmtool.sessions.v1"), STR_LEN("savmtool.sessions.v1"), jb_ptr(&jb), 262144, &olen);
    if st != 0 || olen == 0 {
        return sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    };
    jb.len = olen;
    let doc: u64 = jdoc_of_jb(&jb);
    if doc == 0 { return sa_json_parse(STR_PTR("[]"), STR_LEN("[]")); };
    return doc;
}

fn sessions_save(doc: u64) -> void {
    let jb = JsonBuf { bytes: [0u8; 262144], len: 0 };
    jdoc_to_jb(doc, &jb);
    let st: i32 = sa_global_bytes_set(STR_PTR("savmtool.sessions.v1"), STR_LEN("savmtool.sessions.v1"), jb_ptr(&jb), jb.len);
}

fn session_get_str(node: u64, key: ptr, klen: u64, out: &StrBuf) -> void {
    out.len = 0;
    let vn: u64 = jget_node(node, key, klen);
    if vn != 0 && sa_json_node_kind(vn) == JK_STRING {
        let p: ptr = PTR_NULL();
        let n: u64 = 0;
        let gst: i32 = sa_json_node_string(vn, &p, &n);
        sb_append(out, p, n);
    };
}

fn session_get_num(node: u64, key: ptr, klen: u64, def: f64) -> f64 {
    let vn: u64 = jget_node(node, key, klen);
    if vn != 0 && (sa_json_node_kind(vn) == JK_INT || sa_json_node_kind(vn) == JK_FLOAT) {
        return sa_json_node_as_f64(vn);
    };
    return def;
}

fn session_get_bool(node: u64, key: ptr, klen: u64) -> bool {
    let vn: u64 = jget_node(node, key, klen);
    if vn != 0 && sa_json_node_kind(vn) == JK_BOOL {
        return sa_json_node_as_bool(vn);
    };
    return false;
}

fn session_find(doc: u64, id: &StrBuf) -> i64 {
    let cnt: u64 = jcount(doc);
    let i: u64 = 0;
    let cur = StrBuf { bytes: [0u8; 65536], len: 0 };
    while i < cnt {
        let node: u64 = jarr_at(doc, i);
        if node != 0 {
            session_get_str(node, STR_PTR("id"), STR_LEN("id"), &cur);
            if sb_eq(&cur, sb_ptr(id), id.len) { return i as i64; };
        };
        i = i + 1;
    }
    return -1;
}

fn drain_stream_into(h: u64, acc: &StrBuf, cap: u64) -> void {
    if h == 0 { return; };
    let chunk = [0u8; 8192];
    let cp: ptr = PTR_NULL();
    PTR_BYTE_ADD(cp, &chunk, 0);
    let guard: u64 = 0;
    while guard < 4096 {
        let n: u64 = 0;
        let st: i32 = sa_io_read(h, cp, 8192, &n);
        if st != 0 || n == 0 { break; };
        if acc.len < cap {
            let take: u64 = n;
            if acc.len + take > cap { take = cap - acc.len; };
            sb_append(acc, cp, take);
        };
        guard = guard + 1;
    }
}

fn session_refresh(doc: u64, idx: u64) -> void {
    let node: u64 = jarr_at(doc, idx);
    if node == 0 { return; };
    let status = StrBuf { bytes: [0u8; 65536], len: 0 };
    session_get_str(node, STR_PTR("status"), STR_LEN("status"), &status);
    if !sb_eq(&status, STR_PTR("running"), STR_LEN("running")) { return; };
    let proc: u64 = session_get_num(node, STR_PTR("proc"), STR_LEN("proc"), 0.0) as u64;
    if proc == 0 { return; };
    let hout: u64 = session_get_num(node, STR_PTR("stdout_h"), STR_LEN("stdout_h"), 0.0) as u64;
    let herr: u64 = session_get_num(node, STR_PTR("stderr_h"), STR_LEN("stderr_h"), 0.0) as u64;
    let ready: u64 = 0;
    let code: u64 = 0;
    let wst: i32 = sa_std_process_try_wait(proc, &ready, &code);
    if ready != 0 {
        let so = StrBuf { bytes: [0u8; 65536], len: 0 };
        let se = StrBuf { bytes: [0u8; 65536], len: 0 };
        session_get_str(node, STR_PTR("stdout"), STR_LEN("stdout"), &so);
        session_get_str(node, STR_PTR("stderr"), STR_LEN("stderr"), &se);
        drain_stream_into(hout, &so, 65536);
        drain_stream_into(herr, &se, 65536);
        jset_str(node, STR_PTR("stdout"), STR_LEN("stdout"), sb_ptr(&so), so.len);
        jset_str(node, STR_PTR("stderr"), STR_LEN("stderr"), sb_ptr(&se), se.len);
        jset_bool(node, STR_PTR("has_exit"), STR_LEN("has_exit"), true);
        jset_f64(node, STR_PTR("exit_code"), STR_LEN("exit_code"), code as f64);
        jset_str(node, STR_PTR("status"), STR_LEN("status"), STR_PTR("exited"), STR_LEN("exited"));
        jset_bool(node, STR_PTR("closed"), STR_LEN("closed"), true);
        let cst: i32 = sa_std_process_close(proc);
        return;
    };
    let deadline: f64 = session_get_num(node, STR_PTR("deadline"), STR_LEN("deadline"), 0.0);
    let now: f64 = sa_time_unix_ms() as f64;
    if deadline > 0.0 && now > deadline {
        let k1: i32 = sa_std_process_kill(proc);
        let k2: i32 = sa_std_process_kill_process_group(proc);
        let wcode: u64 = 0;
        let wst2: i32 = sa_std_process_wait(proc, &wcode);
        let so2 = StrBuf { bytes: [0u8; 65536], len: 0 };
        let se2 = StrBuf { bytes: [0u8; 65536], len: 0 };
        session_get_str(node, STR_PTR("stdout"), STR_LEN("stdout"), &so2);
        session_get_str(node, STR_PTR("stderr"), STR_LEN("stderr"), &se2);
        drain_stream_into(hout, &so2, 65536);
        drain_stream_into(herr, &se2, 65536);
        jset_str(node, STR_PTR("stdout"), STR_LEN("stdout"), sb_ptr(&so2), so2.len);
        jset_str(node, STR_PTR("stderr"), STR_LEN("stderr"), sb_ptr(&se2), se2.len);
        jset_str(node, STR_PTR("status"), STR_LEN("status"), STR_PTR("timed_out"), STR_LEN("timed_out"));
        jset_bool(node, STR_PTR("closed"), STR_LEN("closed"), true);
        let cst2: i32 = sa_std_process_close(proc);
    };
}

fn session_new_id(out: &StrBuf) -> void {
    out.len = 0;
    sb_append(out, STR_PTR("proc-"), STR_LEN("proc-"));
    let seq: u64 = 0;
    let seqrc: i32 = sa_global_u64_add(STR_PTR("savmtool.session.seq"), STR_LEN("savmtool.session.seq"), 1, &seq);
    let mix: u64 = seq * 2654435761 + (sa_time_unix_ms() as u64);
    let shift: u64 = 28;
    let k: u64 = 0;
    while k < 8 {
        let nib: u64 = (mix >> shift) & 15;
        if nib < 10 { sb_push_byte(out, (48 + nib) as u8); } else { sb_push_byte(out, (87 + nib) as u8); };
        if shift >= 4 { shift = shift - 4; };
        k = k + 1;
    }
}

struct SpawnHostProcessResult { ok: bool, kind: StrBuf, has_exit: bool, exit_code: i64, stdout: GitBigBuf, stderr: StrBuf, duration_ms: f64, has_session: bool, session_id: StrBuf, has_pid: bool, pid: u64 }

fn spawn_result_zero(out: &SpawnHostProcessResult) -> void {
    out.ok = false;
    out.kind = StrBuf { bytes: [0u8; 65536], len: 0 };
    out.has_exit = false;
    out.exit_code = 0;
    out.stdout = GitBigBuf { bytes: [0u8; 524288], len: 0 };
    out.stderr = StrBuf { bytes: [0u8; 65536], len: 0 };
    out.duration_ms = 0.0;
    out.has_session = false;
    out.session_id = StrBuf { bytes: [0u8; 65536], len: 0 };
    out.has_pid = false;
    out.pid = 0;
}

fn spawn_host_drain(hout: u64, herr: u64, out: &SpawnHostProcessResult) -> void {
    let so = StrBuf { bytes: [0u8; 65536], len: 0 };
    // stdout accumulates into the GitBigBuf directly
    let chunk = [0u8; 8192];
    let cp: ptr = PTR_NULL();
    PTR_BYTE_ADD(cp, &chunk, 0);
    if hout != 0 {
        let guard: u64 = 0;
        while guard < 8192 {
            let n: u64 = 0;
            let st: i32 = sa_io_read(hout, cp, 8192, &n);
            if st != 0 || n == 0 { break; };
            if out.stdout.len < 524288 {
                let take: u64 = n;
                if out.stdout.len + take > 524288 { take = 524288 - out.stdout.len; };
                gb_append(&out.stdout, cp, take);
            };
            guard = guard + 1;
        }
    };
    if herr != 0 {
        let guard2: u64 = 0;
        while guard2 < 8192 {
            let n2: u64 = 0;
            let st2: i32 = sa_io_read(herr, cp, 8192, &n2);
            if st2 != 0 || n2 == 0 { break; };
            if so.len < 131072 {
                let take2: u64 = n2;
                if so.len + take2 > 131072 { take2 = 131072 - so.len; };
                sb_append(&so, cp, take2);
            };
            guard2 = guard2 + 1;
        }
    };
    out.stderr.len = 0;
    sb_append(&out.stderr, sb_ptr(&so), so.len);
}

fn spawnHostProcess(bin: &StrBuf, args: &ByteList, cwd: &StrBuf, timeout_ms: f64, started_at: f64, yield_ms: f64, has_yield: bool, out: &SpawnHostProcessResult) -> void {
    spawn_result_zero(out);
    let arr = GitArgvArr { slots: [0u64; 40] };
    PROCESS_ARGV_SET_PTR(&arr.slots, 0, sb_ptr(bin), bin.len);
    let argc: u64 = 1;
    if args.len > 0 {
        let bp: ptr = bl_ptr(args);
        let start: u64 = 0;
        let i: u64 = 0;
        while i <= args.len && argc < 20 {
            let at_end: bool = i == args.len;
            let is_sep: bool = false;
            if !at_end { if byte_at(bp, i) == 10 { is_sep = true; }; };
            if at_end || is_sep {
                let ep: ptr = PTR_NULL();
                PTR_BYTE_ADD(ep, bp, start);
                PROCESS_ARGV_SET_PTR(&arr.slots, argc, ep, i - start);
                argc = argc + 1;
                start = i + 1;
            };
            i = i + 1;
        }
    };
    let proc: u64 = 0;
    let hin: u64 = 0;
    let hout: u64 = 0;
    let herr: u64 = 0;
    let sst: i32 = sa_std_process_spawn_bidi_cwd(git_argv_ptr(&arr), argc, sb_ptr(cwd), cwd.len, &proc, &hin, &hout, &herr);
    if sst != 0 || proc == 0 {
        out.ok = false;
        sb_append(&out.kind, STR_PTR("crashed"), STR_LEN("crashed"));
        sb_append(&out.stderr, STR_PTR("spawn "), STR_LEN("spawn "));
        sb_append(&out.stderr, sb_ptr(bin), bin.len);
        sb_append(&out.stderr, STR_PTR(" ENOENT"), STR_LEN(" ENOENT"));
        out.duration_ms = (sa_time_unix_ms() as f64) - started_at;
        return;
    };
    let pid: u64 = 0;
    let pst: i32 = sa_std_process_child_id(proc, &pid);
    out.has_pid = true;
    out.pid = pid;
    let tmo_deadline: f64 = started_at + timeout_ms;
    let y_deadline: f64 = started_at + yield_ms;
    while true {
        let ready: u64 = 0;
        let code: u64 = 0;
        let wst: i32 = sa_std_process_try_wait(proc, &ready, &code);
        let now: f64 = sa_time_unix_ms() as f64;
        if ready != 0 {
            spawn_host_drain(hout, herr, out);
            let cst: i32 = sa_std_process_close(proc);
            out.ok = code == 0;
            if code == 0 {
                sb_append(&out.kind, STR_PTR("success"), STR_LEN("success"));
            } else {
                sb_append(&out.kind, STR_PTR("crashed"), STR_LEN("crashed"));
            };
            out.has_exit = true;
            out.exit_code = code as i64;
            out.duration_ms = now - started_at;
            return;
        };
        if has_yield && now >= y_deadline {
            // promote to a managed session
            let doc: u64 = sessions_load();
            let cnt0: u64 = jcount(doc);
            let old_doc: u64 = 0;
            if cnt0 >= 16 {
                // rebuild keeping running sessions + newest closed ones
                let nd: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
                let ki: u64 = 0;
                let keptc: u64 = 0;
                while ki < cnt0 {
                    let sn: u64 = jarr_at(doc, ki);
                    if sn != 0 {
                        let sstatus = StrBuf { bytes: [0u8; 65536], len: 0 };
                        session_get_str(sn, STR_PTR("status"), STR_LEN("status"), &sstatus);
                        let is_run: bool = sb_eq(&sstatus, STR_PTR("running"), STR_LEN("running"));
                        if is_run || ki >= cnt0 - 8 {
                            let pst2: i32 = sa_json_array_push_node(nd, sn);
                            keptc = keptc + 1;
                        };
                    };
                    ki = ki + 1;
                }
                old_doc = doc;
                doc = nd;
            };
            if old_doc != 0 { let frcd: i32 = sa_json_free(old_doc); };
            let sid = StrBuf { bytes: [0u8; 65536], len: 0 };
            session_new_id(&sid);
            let so2: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
            jset_str(so2, STR_PTR("id"), STR_LEN("id"), sb_ptr(&sid), sid.len);
            jset_f64(so2, STR_PTR("proc"), STR_LEN("proc"), proc as f64);
            jset_f64(so2, STR_PTR("stdin_h"), STR_LEN("stdin_h"), hin as f64);
            jset_f64(so2, STR_PTR("stdout_h"), STR_LEN("stdout_h"), hout as f64);
            jset_f64(so2, STR_PTR("stderr_h"), STR_LEN("stderr_h"), herr as f64);
            jset_f64(so2, STR_PTR("pid"), STR_LEN("pid"), pid as f64);
            jset_str(so2, STR_PTR("exe"), STR_LEN("exe"), sb_ptr(bin), bin.len);
            let argarr: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
            if args.len > 0 {
                let cnt2: u64 = bl_count(args);
                let ai: u64 = 0;
                let item = StrBuf { bytes: [0u8; 65536], len: 0 };
                while ai < cnt2 {
                    if bl_at(args, ai, &item) {
                        let apst: i32 = sa_json_array_push_string(argarr, sb_ptr(&item), item.len);
                    };
                    ai = ai + 1;
                }
            };
            jset_node(so2, STR_PTR("args"), STR_LEN("args"), argarr);
            jset_str(so2, STR_PTR("cwd"), STR_LEN("cwd"), sb_ptr(cwd), cwd.len);
            jset_f64(so2, STR_PTR("started_at"), STR_LEN("started_at"), started_at);
            jset_str(so2, STR_PTR("stdout"), STR_LEN("stdout"), STR_PTR(""), STR_LEN(""));
            jset_str(so2, STR_PTR("stderr"), STR_LEN("stderr"), STR_PTR(""), STR_LEN(""));
            jset_bool(so2, STR_PTR("has_exit"), STR_LEN("has_exit"), false);
            jset_f64(so2, STR_PTR("exit_code"), STR_LEN("exit_code"), 0.0);
            jset_str(so2, STR_PTR("status"), STR_LEN("status"), STR_PTR("running"), STR_LEN("running"));
            jset_bool(so2, STR_PTR("closed"), STR_LEN("closed"), false);
            let dl: f64 = timeout_ms;
            if dl < 60000.0 { dl = 60000.0; };
            jset_f64(so2, STR_PTR("deadline"), STR_LEN("deadline"), now + dl);
            let ppst: i32 = sa_json_array_push_node(doc, so2);
            sessions_save(doc);
            sa_json_free(doc);
            out.ok = true;
            sb_append(&out.kind, STR_PTR("running"), STR_LEN("running"));
            out.has_session = true;
            sb_append(&out.session_id, sb_ptr(&sid), sid.len);
            out.duration_ms = now - started_at;
            return;
        };
        if now >= tmo_deadline {
            let k1: i32 = sa_std_process_kill(proc);
            let k2: i32 = sa_std_process_kill_process_group(proc);
            let wcode: u64 = 0;
            let wst2: i32 = sa_std_process_wait(proc, &wcode);
            spawn_host_drain(hout, herr, out);
            let cst2: i32 = sa_std_process_close(proc);
            out.ok = false;
            sb_append(&out.kind, STR_PTR("timeout"), STR_LEN("timeout"));
            out.has_exit = true;
            out.exit_code = 124;
            let se = StrBuf { bytes: [0u8; 65536], len: 0 };
            sb_append(&se, sb_ptr(&out.stderr), out.stderr.len);
            sb_push_byte(&se, 10);
            sb_append(&se, STR_PTR("[timeout] run_host execution timed out after "), STR_LEN("[timeout] run_host execution timed out after "));
            sb_append_f64(timeout_ms, &se);
            sb_append(&se, STR_PTR("ms"), STR_LEN("ms"));
            sb_trim_ip(&se);
            out.stderr.len = 0;
            sb_append(&out.stderr, sb_ptr(&se), se.len);
            out.duration_ms = now - started_at;
            return;
        };
        sa_time_sleep_ms(5);
    }
}

fn checkGitSafety(args: &ByteList, reason: &StrBuf) -> bool {
    reason.len = 0;
    let cnt: u64 = bl_count(args);
    let sub = StrBuf { bytes: [0u8; 65536], len: 0 };
    let item = StrBuf { bytes: [0u8; 65536], len: 0 };
    let i: u64 = 0;
    let found: bool = false;
    while i < cnt {
        if bl_at(args, i, &item) {
            sb_trim_ip(&item);
            if item.len == 0 { i = i + 1; continue; };
            if sb_eq(&item, STR_PTR("--"), STR_LEN("--")) {
                if i + 1 < cnt {
                    if bl_at(args, i + 1, &sub) { sb_trim_ip(&sub); sb_lower_ip(&sub); found = true; };
                };
                break;
            };
            if sb_eq(&item, STR_PTR("-C"), STR_LEN("-C")) || sb_eq(&item, STR_PTR("-c"), STR_LEN("-c")) { i = i + 2; continue; };
            if item.len > 2 && byte_at(sb_ptr(&item), 0) == 45 && (byte_at(sb_ptr(&item), 1) == 67 || byte_at(sb_ptr(&item), 1) == 99) { i = i + 1; continue; };
            if sb_starts(&item, STR_PTR("--git-dir"), STR_LEN("--git-dir")) || sb_starts(&item, STR_PTR("--work-tree"), STR_LEN("--work-tree")) || sb_starts(&item, STR_PTR("--namespace"), STR_LEN("--namespace")) || sb_starts(&item, STR_PTR("--super-prefix"), STR_LEN("--super-prefix")) || sb_starts(&item, STR_PTR("--config-env"), STR_LEN("--config-env")) {
                if !tool_sb_contains(&item, STR_PTR("="), STR_LEN("=")) { i = i + 2; } else { i = i + 1; };
                continue;
            };
            if byte_at(sb_ptr(&item), 0) == 45 { i = i + 1; continue; };
            sb_append(&sub, sb_ptr(&item), item.len);
            sb_lower_ip(&sub);
            found = true;
            break;
        };
        i = i + 1;
    }
    if !found { return true; };
    if sb_eq(&sub, STR_PTR("clean"), STR_LEN("clean")) {
        sb_append(reason, STR_PTR("Blocked destructive 'git clean': permanently deletes untracked files. Use safe_delete for specific file removal."), STR_LEN("Blocked destructive 'git clean': permanently deletes untracked files. Use safe_delete for specific file removal."));
        return false;
    };
    if sb_eq(&sub, STR_PTR("revert"), STR_LEN("revert")) {
        sb_append(reason, STR_PTR("Blocked 'git revert': modifying git history via revert is prohibited by safety policy."), STR_LEN("Blocked 'git revert': modifying git history via revert is prohibited by safety policy."));
        return false;
    };
    if sb_eq(&sub, STR_PTR("reset"), STR_LEN("reset")) {
        let j: u64 = 0;
        let it2 = StrBuf { bytes: [0u8; 65536], len: 0 };
        while j < cnt {
            if bl_at(args, j, &it2) {
                sb_trim_ip(&it2);
                sb_lower_ip(&it2);
                if sb_eq(&it2, STR_PTR("--hard"), STR_LEN("--hard")) || sb_starts(&it2, STR_PTR("--hard="), STR_LEN("--hard=")) {
                    sb_append(reason, STR_PTR("Blocked destructive 'git reset --hard': permanently discards uncommitted worktree changes."), STR_LEN("Blocked destructive 'git reset --hard': permanently discards uncommitted worktree changes."));
                    return false;
                };
            };
            j = j + 1;
        }
    };
    return true;
}
// ---- batch 19b: run_host, sessions, checkpoints ----

fn input_to_jb(input: &SaVmRunInput, out: &JsonBuf) -> void {
    out.len = 0;
    let p: ptr = PTR_NULL();
    PTR_BYTE_ADD(p, &input.json, 0);
    jb_append(out, p, input.json_len);
}

fn viol_rule_json(rule: &StrBuf, jb: &JsonBuf) -> void {
    let vd: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    jb.len = 0;
    if vd != 0 {
        jset_str(vd, STR_PTR("rule"), STR_LEN("rule"), sb_ptr(rule), rule.len);
        jset_bool(vd, STR_PTR("blocked"), STR_LEN("blocked"), true);
        jdoc_to_jb(vd, jb);
        sa_json_free(vd);
    };
}

fn ev_violation(out: &SaVmRunResult, kind_s: &StrBuf, reason: &StrBuf) -> void {
    let arr: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    let eo: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    if arr != 0 && eo != 0 {
        jset_str(eo, STR_PTR("event"), STR_LEN("event"), STR_PTR("violation"), STR_LEN("violation"));
        jset_str(eo, STR_PTR("kind"), STR_LEN("kind"), sb_ptr(kind_s), kind_s.len);
        jset_str(eo, STR_PTR("reason"), STR_LEN("reason"), sb_ptr(reason), reason.len);
        let pst: i32 = sa_json_array_push_node(arr, eo);
        let ejb = JsonBuf { bytes: [0u8; 262144], len: 0 };
        jdoc_to_jb(arr, &ejb);
        res_set_events(out, jb_ptr(&ejb), ejb.len);
        sa_json_free(arr);
    };
}

// capability_denied 228 with {rule, blocked:true} violation.
fn res_denied_rule(out: &SaVmRunResult, rule: &StrBuf, stderr_s: &StrBuf, reason: &StrBuf, started_at: f64) -> void {
    res_init(out);
    out.ok = false;
    res_set_kind(out, STR_PTR("capability_denied"), STR_LEN("capability_denied"));
    out.has_exitCode = true;
    out.exitCode = 228;
    res_set_stderr(out, sb_ptr(stderr_s), stderr_s.len);
    let vjb = JsonBuf { bytes: [0u8; 262144], len: 0 };
    viol_rule_json(rule, &vjb);
    if vjb.len > 0 { res_set_violation(out, jb_ptr(&vjb), vjb.len); };
    let kd = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_append(&kd, STR_PTR("capability_denied"), STR_LEN("capability_denied"));
    ev_violation(out, &kd, reason);
    out.durationMs = dur_since(started_at);
}

fn res_set_message(out: &SaVmRunResult, msg: &StrBuf) -> void {
    out.has_message = true;
    out.message_len = 0;
    let i: u64 = 0;
    let mp: ptr = sb_ptr(msg);
    while i < msg.len && out.message_len < 4096 {
        out.message[out.message_len] = byte_at(mp, i);
        out.message_len = out.message_len + 1;
        i = i + 1;
    }
}

fn res_set_session_id(out: &SaVmRunResult, id: &StrBuf) -> void {
    out.has_session_id = true;
    out.session_id_len = 0;
    out.has_sessionId = true;
    out.sessionId_len = 0;
    let i: u64 = 0;
    let ip: ptr = sb_ptr(id);
    while i < id.len && i < 128 {
        out.session_id[out.session_id_len] = byte_at(ip, i);
        out.session_id_len = out.session_id_len + 1;
        out.sessionId[out.sessionId_len] = byte_at(ip, i);
        out.sessionId_len = out.sessionId_len + 1;
        i = i + 1;
    }
}

fn res_set_status_field(out: &SaVmRunResult, s: &StrBuf) -> void {
    out.has_status = true;
    out.status_len = 0;
    let i: u64 = 0;
    let sp: ptr = sb_ptr(s);
    while i < s.len && out.status_len < 128 {
        out.status[out.status_len] = byte_at(sp, i);
        out.status_len = out.status_len + 1;
        i = i + 1;
    }
}

fn res_set_commit_field(out: &SaVmRunResult, s: &StrBuf) -> void {
    out.has_commit = true;
    out.commit_len = 0;
    let i: u64 = 0;
    let sp: ptr = sb_ptr(s);
    while i < s.len && out.commit_len < 128 {
        out.commit[out.commit_len] = byte_at(sp, i);
        out.commit_len = out.commit_len + 1;
        i = i + 1;
    }
}

fn jnode_truthy(node: u64) -> bool {
    if node == 0 { return false; };
    let k: u64 = sa_json_node_kind(node);
    if k == JK_BOOL { return sa_json_node_as_bool(node); };
    if k == JK_INT || k == JK_FLOAT { return sa_json_node_as_f64(node) != 0.0; };
    if k == JK_STRING {
        let p: ptr = PTR_NULL();
        let n: u64 = 0;
        let gst: i32 = sa_json_node_string(node, &p, &n);
        return n > 0;
    };
    if k == JK_ARRAY || k == JK_OBJECT { return true; };
    return false;
}

fn input_args_bytelist(input: &SaVmRunInput, out: &ByteList) -> void {
    out.len = 0;
    let anode: u64 = jget_node(input.node, STR_PTR("args"), STR_LEN("args"));
    if anode == 0 || sa_json_node_kind(anode) != JK_ARRAY { return; };
    let cnt: u64 = jcount(anode);
    let i: u64 = 0;
    let item = StrBuf { bytes: [0u8; 65536], len: 0 };
    while i < cnt {
        let el: u64 = jarr_at(anode, i);
        item.len = 0;
        if el != 0 {
            if sa_json_node_kind(el) == JK_STRING {
                let p: ptr = PTR_NULL();
                let n: u64 = 0;
                let gst: i32 = sa_json_node_string(el, &p, &n);
                sb_append(&item, p, n);
            } else {
                js_string_coerce(el, &item);
            };
        };
        bl_push(out, sb_ptr(&item), item.len);
        i = i + 1;
    }
}

fn host_execution_event(out: &SaVmRunResult, exe: &StrBuf, args: &ByteList, tcwd: &StrBuf, has_exit: bool, exit_code: i64, duration_ms: f64, cached: bool, session_id: &StrBuf, has_session: bool) -> void {
    let arr: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    let eo: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    if arr == 0 || eo == 0 { return; };
    jset_str(eo, STR_PTR("event"), STR_LEN("event"), STR_PTR("host_execution"), STR_LEN("host_execution"));
    jset_str(eo, STR_PTR("exe"), STR_LEN("exe"), sb_ptr(exe), exe.len);
    let aarr: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    if aarr != 0 {
        let cnt: u64 = bl_count(args);
        let i: u64 = 0;
        let item = StrBuf { bytes: [0u8; 65536], len: 0 };
        while i < cnt {
            if bl_at(args, i, &item) {
                let pst: i32 = sa_json_array_push_string(aarr, sb_ptr(&item), item.len);
            };
            i = i + 1;
        }
        jset_node(eo, STR_PTR("args"), STR_LEN("args"), aarr);
    };
    jset_str(eo, STR_PTR("cwd"), STR_LEN("cwd"), sb_ptr(tcwd), tcwd.len);
    if has_exit { jset_i64(eo, STR_PTR("exitCode"), STR_LEN("exitCode"), exit_code); } else { jset_null(eo, STR_PTR("exitCode"), STR_LEN("exitCode")); };
    jset_f64(eo, STR_PTR("durationMs"), STR_LEN("durationMs"), duration_ms);
    jset_bool(eo, STR_PTR("cached"), STR_LEN("cached"), cached);
    if has_session { jset_str(eo, STR_PTR("sessionId"), STR_LEN("sessionId"), sb_ptr(session_id), session_id.len); };
    let pst2: i32 = sa_json_array_push_node(arr, eo);
    let ejb = JsonBuf { bytes: [0u8; 262144], len: 0 };
    jdoc_to_jb(arr, &ejb);
    res_set_events(out, jb_ptr(&ejb), ejb.len);
    sa_json_free(arr);
}

fn runhost_cache_load() -> u64 {
    let jb = JsonBuf { bytes: [0u8; 262144], len: 0 };
    let olen: u64 = 0;
    let st: i32 = sa_global_bytes_get(STR_PTR("savmtool.runhost.cache.v1"), STR_LEN("savmtool.runhost.cache.v1"), jb_ptr(&jb), 262144, &olen);
    if st != 0 || olen == 0 { return sa_json_parse(STR_PTR("{}"), STR_LEN("{}")); };
    jb.len = olen;
    let doc: u64 = jdoc_of_jb(&jb);
    if doc == 0 { return sa_json_parse(STR_PTR("{}"), STR_LEN("{}")); };
    return doc;
}

fn runhost_cache_save(doc: u64) -> void {
    let jb = JsonBuf { bytes: [0u8; 262144], len: 0 };
    jdoc_to_jb(doc, &jb);
    let st: i32 = sa_global_bytes_set(STR_PTR("savmtool.runhost.cache.v1"), STR_LEN("savmtool.runhost.cache.v1"), jb_ptr(&jb), jb.len);
}

fn nativeRunHost(input: &SaVmRunInput, policy_doc: u64, cwd: &StrBuf, started_at: f64, out: &SaVmRunResult) -> i32 {
    let norm = NormalizedSaVmPolicy { engine: 0, fs: NormalizedFs { entries: FsEntryList { items: [SaVmFsEntry { path: [0u8; 1024], path_len: 0, access: 0 }; 128], len: 0 }, read: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, write: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, transfer: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, delete: 0, backupDir: [0u8; 1024], backupDir_len: 0, backupDir_has: false }, http_allow: HttpRuleList { items: [SaVmHttpAllowRule { host: [0u8; 512], host_len: 0, methods: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_methods: false, paths: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_paths: false }; 128], len: 0 }, env_allow: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, process: NormalizedProcess { spawn: false, exec: ExecRuleList { items: [SaVmProcessExecRule { path: [0u8; 4096], path_len: 0, args: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_args: false }; 128], len: 0 }, bunProfiles: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_bunProfiles: false, bun_enabled: false, bun_allowedSubcommands: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_bun: false }, execution_javascript: false, execution_python: false, tools: NormalizedTools { replaceRead: false, replaceWrite: false, replaceApplyPatch: false, replaceExec: false, readFiles: false, editFiles: false, applyPatch: false, fastSearch: false, clearToolHistory: false, findReferences: false, renameSymbol: false, fileOutline: false, moveWithImports: false, findDefinition: false, extractToFile: false, addImport: false, getDiagnostics: false, organizeImports: false, analyzeScope: false, codeGraph: false }, contextSavings: SaVmContextSavingsConfig { locateBeforeRead: false, maxReadFileBytes: 0, maxReadFileBytes_has: false, grepCircuitBreaker: false, grepMaxResults: 0, grepMaxResults_has: false, grepMaxTokens: 0, grepMaxTokens_has: false, slimRunnerOutput: false, parallelBudget: false, parallelMaxTotalBytes: 0, parallelMaxTotalBytes_has: false, parallelMaxReadFiles: 0, parallelMaxReadFiles_has: false, parallelDeduplication: false, tieredSkillInjection: false, foldWaterfallEvents: false, foldHistoryReadSummaries: false, historyReadFoldTurns: 0, historyReadFoldTurns_has: false }, contextSavings_has: false };
    normalize_policy(policy_doc, cwd, &norm);
    let exe = StrBuf { bytes: [0u8; 65536], len: 0 };
    in_str(input, STR_PTR("exe"), STR_LEN("exe"), &exe);
    sb_trim_ip(&exe);
    let args = ByteList { items: [0u8; 4096], len: 0 };
    input_args_bytelist(input, &args);
    let argc: u64 = bl_count(&args);
    let rule = StrBuf { bytes: [0u8; 65536], len: 0 };
    let msg = StrBuf { bytes: [0u8; 65536], len: 0 };
    if exe.len == 0 {
        sb_append(&rule, STR_PTR("process.run_host.exe_required"), STR_LEN("process.run_host.exe_required"));
        sb_append(&msg, STR_PTR("action 'run_host' requires an 'exe' parameter"), STR_LEN("action 'run_host' requires an 'exe' parameter"));
        res_denied_rule(out, &rule, &msg, &msg, started_at);
        return 0;
    };
    let exe_lower = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_append(&exe_lower, sb_ptr(&exe), exe.len);
    sb_lower_ip(&exe_lower);
    let is_cargo: bool = sb_eq(&exe_lower, STR_PTR("cargo"), STR_LEN("cargo")) || sb_eq(&exe_lower, STR_PTR("cargo.exe"), STR_LEN("cargo.exe"));
    let is_go: bool = sb_eq(&exe_lower, STR_PTR("go"), STR_LEN("go")) || sb_eq(&exe_lower, STR_PTR("go.exe"), STR_LEN("go.exe"));
    let is_git: bool = sb_eq(&exe_lower, STR_PTR("git"), STR_LEN("git")) || sb_eq(&exe_lower, STR_PTR("git.exe"), STR_LEN("git.exe"));
    // first non-flag arg + version/help scan
    let first_sub = StrBuf { bytes: [0u8; 65536], len: 0 };
    let a_item = StrBuf { bytes: [0u8; 65536], len: 0 };
    let ai: u64 = 0;
    while ai < argc {
        if bl_at(&args, ai, &a_item) {
            if first_sub.len == 0 && !sb_starts(&a_item, STR_PTR("-"), STR_LEN("-")) {
                sb_append(&first_sub, sb_ptr(&a_item), a_item.len);
                sb_lower_ip(&first_sub);
            };
        };
