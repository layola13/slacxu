    sb_append(&out_sb, STR_PTR("\n- Call: "), STR_LEN("\n- Call: "));
    sb_append(&out_sb, sb_ptr(&b_call), b_call.len);
    sb_append(&out_sb, STR_PTR("\n- Import: "), STR_LEN("\n- Import: "));
