// ---- write/edit/delete cluster helpers ----
fn res_capability2(out: &SaVmRunResult, stderr_sb: &StrBuf, reason_sb: &StrBuf, started_at: f64) -> void {
    res_init(out);
    out.ok = false;
    res_set_kind(out, STR_PTR("capability_denied"), STR_LEN("capability_denied"));
    out.has_exitCode = true;
    out.exitCode = 228;
    res_set_stderr(out, sb_ptr(stderr_sb), stderr_sb.len);
    if reason_sb.len > 0 {
        let doc: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
        if doc != 0 {
            jset_str(doc, STR_PTR("reason"), STR_LEN("reason"), sb_ptr(reason_sb), reason_sb.len);
            let jb = JsonBuf { bytes: [0u8; 262144], len: 0 };
            jdoc_to_jb(doc, &jb);
            res_set_violation(out, jb_ptr(&jb), jb.len);
            sa_json_free(doc);
        };
    };
    out.durationMs = dur_since(started_at);
}

fn sb_last_index_of(s: &StrBuf, p: ptr, n: u64) -> i64 {
    if n == 0 || s.len < n { return 0 - 1; };
    let i: u64 = s.len - n + 1;
    while i > 0 {
        i = i - 1;
        let hit: bool = true;
        let j: u64 = 0;
        while j < n {
            if s.bytes[i + j] != byte_at(p, j) { hit = false; break; };
            j = j + 1;
        }
        if hit { return i as i64; };
    }
    return 0 - 1;
}

fn count_occurrences(s: &StrBuf, p: ptr, n: u64) -> u64 {
    if n == 0 || s.len < n { return 0; };
    let cnt: u64 = 0;
    let i: u64 = 0;
    while i + n <= s.len {
        let hit: bool = true;
        let j: u64 = 0;
        while j < n {
            if s.bytes[i + j] != byte_at(p, j) { hit = false; break; };
            j = j + 1;
        }
        if hit {
            cnt = cnt + 1;
            i = i + n;
        } else {
            i = i + 1;
        }
    }
    return cnt;
}

fn gate_new() -> AccountabilityGateResult {
    return AccountabilityGateResult { allowed: false, tier: 0, score: 0, kind_ptr: PTR_NULL(), kind_len: 0, has_kind: false, reason_ptr: PTR_NULL(), reason_len: 0, has_reason: false, notice_ptr: PTR_NULL(), notice_len: 0, has_notice: false, antibodyNotice_ptr: PTR_NULL(), antibodyNotice_len: 0, has_antibodyNotice: false, jev_verdict_ptr: PTR_NULL(), jev_verdict_len: 0, jev_risk_ptr: PTR_NULL(), jev_risk_len: 0, jev_summary_ptr: PTR_NULL(), jev_summary_len: 0, has_jevVerdict: false };
}

// Fills `out` with the gate-denied result when the accountability
// gate rejects; returns true when the write is denied.
fn gate_denied_result(gate: &AccountabilityGateResult, out: &SaVmRunResult, started_at: f64) -> bool {
    if gate.allowed { return false; };
    res_init(out);
    out.ok = false;
    if gate.has_kind && gate.kind_len > 0 {
        res_set_kind(out, gate.kind_ptr, gate.kind_len);
    } else {
        res_set_kind(out, STR_PTR("capability_denied"), STR_LEN("capability_denied"));
    };
    out.has_exitCode = true;
    out.exitCode = 228;
    if gate.has_reason && gate.reason_len > 0 {
        res_set_stderr(out, gate.reason_ptr, gate.reason_len);
    } else {
        res_set_stderr(out, STR_PTR("Accountability gate rejection"), STR_LEN("Accountability gate rejection"));
    };
    // events: [{event: "violation", kind: "accountability_gate", reason?}]
    let arr: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    let obj: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    if arr != 0 && obj != 0 {
        jset_str(obj, STR_PTR("event"), STR_LEN("event"), STR_PTR("violation"), STR_LEN("violation"));
        jset_str(obj, STR_PTR("kind"), STR_LEN("kind"), STR_PTR("accountability_gate"), STR_LEN("accountability_gate"));
        if gate.has_reason && gate.reason_len > 0 {
            jset_str(obj, STR_PTR("reason"), STR_LEN("reason"), gate.reason_ptr, gate.reason_len);
        };
        let rc1: i32 = sa_json_array_push_node(arr, obj);
        let jb = JsonBuf { bytes: [0u8; 262144], len: 0 };
        jdoc_to_jb(arr, &jb);
        res_set_events(out, jb_ptr(&jb), jb.len);
    };
    if arr != 0 { sa_json_free(arr); };
    if gate.has_reason && gate.reason_len > 0 {
        let vdoc: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
        if vdoc != 0 {
            jset_str(vdoc, STR_PTR("reason"), STR_LEN("reason"), gate.reason_ptr, gate.reason_len);
            let vjb = JsonBuf { bytes: [0u8; 262144], len: 0 };
            jdoc_to_jb(vdoc, &vjb);
            res_set_violation(out, jb_ptr(&vjb), vjb.len);
            sa_json_free(vdoc);
        };
    };
    out.durationMs = dur_since(started_at);
    return true;
}

fn opts_wr_parse(options: &JsonBuf, replace_all: &bool, manual_override: &bool) -> void {
    *replace_all = false;
    *manual_override = false;
    let doc: u64 = jdoc_of_jb(options);
    if doc == 0 || sa_json_kind(doc) != 7 { return; };
    let ra: u64 = jget_node(doc, STR_PTR("replaceAll"), STR_LEN("replaceAll"));
    if ra != 0 && sa_json_kind(ra) == 1 && sa_json_node_as_bool(ra) { *replace_all = true; };
    let mo: u64 = jget_node(doc, STR_PTR("manualOverride"), STR_LEN("manualOverride"));
    if mo != 0 && sa_json_kind(mo) == 1 && sa_json_node_as_bool(mo) { *manual_override = true; };
    sa_json_free(doc);
}

// source L1426: nativeWriteFile.
fn nativeWriteFile(path: &StrBuf, content: &StrBuf, policy_doc: u64, cwd: &StrBuf, started_at: f64, options: &JsonBuf, out: &SaVmRunResult) -> i32 {
