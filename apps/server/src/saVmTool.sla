// ---- nativeListDir (source L2053) ----
struct ListCtx {
    cwd: StrBuf,
    scan_cap: u64,
    target_depth: u64,
    filter_type: StrBuf,
    respect_gi: bool,
    exclude_dirs: ByteList,
    file_pattern: StrBuf,
    path_pattern: StrBuf,
    has_path_pattern: bool,
    is_regex: i32,
    names: ListBuf,
    paths: ListBuf,
    is_dir_flags: U64List,
    is_file_flags: U64List,
    skipped: u64,
    err: u64,
}

fn listDir_walk(cur_dir: &StrBuf, cur_rel: &StrBuf, depth: u64, norm: &NormalizedSaVmPolicy, gi: &GitIgnoreRules, ctx: &ListCtx) -> void {
    if lb_count(&ctx.paths) >= ctx.scan_cap || depth > ctx.target_depth { return; };
    let names = ListBuf { bytes: [0u8; 131072], len: 0 };
    let kinds = U64List { items: [0u64; 4096], len: 0 };
    if !list_dir_names(cur_dir, &names, &kinds) {
        if !fs_exists_sb(cur_dir) {
            if ctx.err == 0 { ctx.err = 1; };
        } else {
            if ctx.err == 0 { ctx.err = 2; };
        };
        return;
    };
    let cnt: u64 = lb_count(&names);
    // sort entry indices by name (localeCompare ~ byte order)
    let idx = U64List { items: [0u64; 4096], len: 0 };
    let i0: u64 = 0;
    while i0 < cnt && idx.len < 4096 {
        idx.items[idx.len] = i0;
        idx.len = idx.len + 1;
        i0 = i0 + 1;
    }
    let ea = StrBuf { bytes: [0u8; 65536], len: 0 };
    let eb = StrBuf { bytes: [0u8; 65536], len: 0 };
    let x: u64 = 1;
    while x < idx.len {
        let key: u64 = idx.items[x];
        let gk: bool = lb_at(&names, key, &ea);
        let y: u64 = x;
        while y > 0 {
            let g2: bool = lb_at(&names, idx.items[y - 1], &eb);
            if bytes_cmp(&eb, &ea) <= 0 { break; };
            idx.items[y] = idx.items[y - 1];
            y = y - 1;
        }
        idx.items[y] = key;
        x = x + 1;
    }
    let name = StrBuf { bytes: [0u8; 65536], len: 0 };
    let ii: u64 = 0;
    while ii < cnt {
        if lb_count(&ctx.paths) >= ctx.scan_cap { break; };
        let got: bool = lb_at(&names, idx.items[ii], &name);
        if got {
            let kind: u64 = kinds.items[idx.items[ii]];
            let is_dir: bool = kind == 2;
            let is_file: bool = kind == 1;
            let rel_path = StrBuf { bytes: [0u8; 65536], len: 0 };
            if cur_rel.len > 0 {
                sb_copy(&rel_path, cur_rel);
                sb_append(&rel_path, STR_PTR("/"), STR_LEN("/"));
                sb_append(&rel_path, sb_ptr(&name), name.len);
            } else {
                sb_copy(&rel_path, &name);
            };
            let full = StrBuf { bytes: [0u8; 65536], len: 0 };
            path_join(cur_dir, &name, &full);
            let rel_cwd = StrBuf { bytes: [0u8; 65536], len: 0 };
            tool_path_relative(&ctx.cwd, &full, &rel_cwd);
            if rel_cwd.len == 0 { sb_copy(&rel_cwd, &name); };
            let skip: bool = false;
            if ctx.respect_gi && isGitIgnored(&name, is_dir, gi, &rel_cwd, true) {
                ctx.skipped = ctx.skipped + 1;
                skip = true;
            };
            if !skip && isExcludedRelPath(&rel_cwd, &ctx.exclude_dirs) {
                ctx.skipped = ctx.skipped + 1;
                skip = true;
            };
            if !skip {
                if tool_bytes_eq(sb_ptr(&ctx.filter_type), ctx.filter_type.len, STR_PTR("directory"), STR_LEN("directory")) || tool_bytes_eq(sb_ptr(&ctx.filter_type), ctx.filter_type.len, STR_PTR("dir"), STR_LEN("dir")) {
                    if !is_dir { skip = true; };
                } else if tool_bytes_eq(sb_ptr(&ctx.filter_type), ctx.filter_type.len, STR_PTR("file"), STR_LEN("file")) {
                    if !is_file { skip = true; };
                };
            };
            if !skip && is_file && !matchesFilePattern(&name, &rel_cwd, &ctx.file_pattern, &ctx.path_pattern, ctx.has_path_pattern, ctx.is_regex) {
                skip = true;
            };
            if !skip && is_dir && ctx.has_path_pattern {
                let trimmed = StrBuf { bytes: [0u8; 65536], len: 0 };
                tool_sb_trim(&ctx.path_pattern, &trimmed);
                if trimmed.len > 0 {
                    let m = SearchMatcher { mode: 0, query: StrBuf { bytes: [0u8; 65536], len: 0 }, lower: StrBuf { bytes: [0u8; 65536], len: 0 }, re: 0 };
                    compile_search_matcher(&trimmed, ctx.is_regex, false, &m);
                    let ok: bool = matcher_test(&m, &rel_cwd) || matcher_test(&m, &name);
                    matcher_free(&m);
                    if !ok { skip = true; };
                };
            };
            if !skip {
                lb_append(&ctx.names, sb_ptr(&name), name.len);
                lb_append(&ctx.paths, sb_ptr(&rel_path), rel_path.len);
                if ctx.is_dir_flags.len < 4096 {
                    ctx.is_dir_flags.items[ctx.is_dir_flags.len] = 0;
                    if is_dir { ctx.is_dir_flags.items[ctx.is_dir_flags.len] = 1; };
                    ctx.is_dir_flags.len = ctx.is_dir_flags.len + 1;
                };
                if ctx.is_file_flags.len < 4096 {
                    ctx.is_file_flags.items[ctx.is_file_flags.len] = 0;
                    if is_file { ctx.is_file_flags.items[ctx.is_file_flags.len] = 1; };
                    ctx.is_file_flags.len = ctx.is_file_flags.len + 1;
                };
                if is_dir && depth < ctx.target_depth {
                    let rsn = StrBuf { bytes: [0u8; 65536], len: 0 };
                    if toolCheckPath(norm, 0, &full, &ctx.cwd, &rsn) {
                        listDir_walk(&full, &rel_path, depth + 1, norm, gi, ctx);
                    };
                };
            };
        };
        ii = ii + 1;
    }
}

fn list_items_json(ctx: &ListCtx, order: &U64List, count: u64, nested: bool, ob: &JsonBuf) -> void {
    let o_open = StrBuf { bytes: [0u8; 65536], len: 0 };
    let o_path = StrBuf { bytes: [0u8; 65536], len: 0 };
    let o_isd = StrBuf { bytes: [0u8; 65536], len: 0 };
    let o_isf = StrBuf { bytes: [0u8; 65536], len: 0 };
    let o_close = StrBuf { bytes: [0u8; 65536], len: 0 };
    let o_tail = StrBuf { bytes: [0u8; 65536], len: 0 };
    if nested {
        sb_assign(&o_open, STR_PTR("\n    {\n      \"name\": \""), STR_LEN("\n    {\n      \"name\": \""));
        sb_assign(&o_path, STR_PTR("\",\n      \"path\": \""), STR_LEN("\",\n      \"path\": \""));
        sb_assign(&o_isd, STR_PTR("\",\n      \"isDirectory\": "), STR_LEN("\",\n      \"isDirectory\": "));
        sb_assign(&o_isf, STR_PTR(",\n      \"isFile\": "), STR_LEN(",\n      \"isFile\": "));
        sb_assign(&o_close, STR_PTR("\n    }"), STR_LEN("\n    }"));
        sb_assign(&o_tail, STR_PTR("\n  "), STR_LEN("\n  "));
    } else {
        sb_assign(&o_open, STR_PTR("\n  {\n    \"name\": \""), STR_LEN("\n  {\n    \"name\": \""));
        sb_assign(&o_path, STR_PTR("\",\n    \"path\": \""), STR_LEN("\",\n    \"path\": \""));
        sb_assign(&o_isd, STR_PTR("\",\n    \"isDirectory\": "), STR_LEN("\",\n    \"isDirectory\": "));
        sb_assign(&o_isf, STR_PTR(",\n    \"isFile\": "), STR_LEN(",\n    \"isFile\": "));
        sb_assign(&o_close, STR_PTR("\n  }"), STR_LEN("\n  }"));
        sb_assign(&o_tail, STR_PTR("\n"), STR_LEN("\n"));
    };
    jb_append(ob, STR_PTR("["), STR_LEN("["));
    let nm = StrBuf { bytes: [0u8; 65536], len: 0 };
    let pt = StrBuf { bytes: [0u8; 65536], len: 0 };
    let i: u64 = 0;
    while i < count {
        let ix: u64 = order.items[i];
        let g1: bool = lb_at(&ctx.names, ix, &nm);
        let g2: bool = lb_at(&ctx.paths, ix, &pt);
        if i > 0 { jb_append(ob, STR_PTR(","), STR_LEN(",")); };
        jb_append(ob, sb_ptr(&o_open), o_open.len);
        jescape_into(&nm, ob);
        jb_append(ob, sb_ptr(&o_path), o_path.len);
        jescape_into(&pt, ob);
        jb_append(ob, sb_ptr(&o_isd), o_isd.len);
        if ctx.is_dir_flags.items[ix] == 1 { jb_append(ob, STR_PTR("true"), STR_LEN("true")); } else { jb_append(ob, STR_PTR("false"), STR_LEN("false")); };
        jb_append(ob, sb_ptr(&o_isf), o_isf.len);
        if ctx.is_file_flags.items[ix] == 1 { jb_append(ob, STR_PTR("true"), STR_LEN("true")); } else { jb_append(ob, STR_PTR("false"), STR_LEN("false")); };
        jb_append(ob, sb_ptr(&o_close), o_close.len);
        i = i + 1;
    }
    if count > 0 { jb_append(ob, sb_ptr(&o_tail), o_tail.len); };
    jb_append(ob, STR_PTR("]"), STR_LEN("]"));
}

fn nativeListDir(dir_path: &StrBuf, max_entries: f64, policy_doc: u64, cwd: &StrBuf, started_at: f64, timeout_opts: &JsonBuf, extra_opts: &JsonBuf, out: &SaVmRunResult) -> i32 {
