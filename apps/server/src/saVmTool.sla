    };
    let max_count: f64 = 10.0;
    let mc: f64 = 0.0;
    let mc_has: bool = false;
    if odoc != 0 { read_opt_num(odoc, STR_PTR("max_count"), STR_LEN("max_count"), STR_PTR(""), 0, &mc, &mc_has); };
    if mc_has {
        max_count = (mc as i64) as f64;
        if max_count < 1.0 { max_count = 1.0; };
        if max_count > 100.0 { max_count = 100.0; };
    };
    let max_bytes: f64 = resolveGitMaxBytes(odoc, 65536.0);
    let timeout_ms: f64 = resolveTimeoutMs(options, 15000.0);
    let argv = ByteList { items: [0u8; 4096], len: 0 };
    bl_push(&argv, STR_PTR("log"), STR_LEN("log"));
    let mc_arg = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_assign(&mc_arg, STR_PTR("--max-count="), STR_LEN("--max-count="));
    sb_append_f64(max_count, &mc_arg);
    bl_push_sb(&argv, &mc_arg);
    bl_push(&argv, STR_PTR("--pretty=format:%H%x01%h%x01%an%x01%ad%x01%s%x01%b%x1e"), STR_LEN("--pretty=format:%H%x01%h%x01%an%x01%ad%x01%s%x01%b%x1e"));
    bl_push(&argv, STR_PTR("--date=iso"), STR_LEN("--date=iso"));
    bl_push(&argv, STR_PTR("--no-color"), STR_LEN("--no-color"));
    if has_rev { bl_push_sb(&argv, &raw_rev); };
    let r = GitSpawnResult { status: 0, has_status: false, stdout: GitBigBuf { bytes: [0u8; 524288], len: 0 }, stderr: StrBuf { bytes: [0u8; 65536], len: 0 }, unavailable: false, timedOut: false };
    execGitSync(&repo_root, &argv, timeout_ms, &r);
    if git_propagate(out, &r, STR_PTR("git log failed"), STR_LEN("git log failed"), started_at) {
        if odoc != 0 { sa_json_free(odoc); };
        return 0;
    };
    let commits: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    let commit_count: u64 = 0;
    let base: ptr = gb_ptr(&r.stdout);
    let pos: u64 = 0;
    while pos <= r.stdout.len {
        let eol: u64 = pos;
        while eol < r.stdout.len && byte_at(base, eol) != 30 { eol = eol + 1; }
        let rec = StrBuf { bytes: [0u8; 65536], len: 0 };
        if eol > pos { let pb_rec_0: ptr = PTR_NULL(); PTR_BYTE_ADD(pb_rec_0, base, pos); sb_append(&rec, pb_rec_0, eol - pos); };
        let rec_t = StrBuf { bytes: [0u8; 65536], len: 0 };
        tool_sb_trim(&rec, &rec_t);
        pos = eol + 1;
        if rec_t.len == 0 {
            if eol >= r.stdout.len { break; };
            continue;
        };
        // split by \x01 into up to 6 parts
        let parts = [StrBuf { bytes: [0u8; 65536], len: 0 }; 6];
        let pcount: u64 = 0;
        let rp: ptr = sb_ptr(&rec_t);
        let seg_start: u64 = 0;
        let si: u64 = 0;
        while si <= rec_t.len && pcount < 6 {
            if si == rec_t.len || byte_at(rp, si) == 1 {
                if si > seg_start { let pb_seg_0: ptr = PTR_NULL(); PTR_BYTE_ADD(pb_seg_0, rp, seg_start); sb_append(&parts[pcount], pb_seg_0, si - seg_start); };
                pcount = pcount + 1;
                seg_start = si + 1;
            };
            si = si + 1;
        }
        if pcount >= 5 && commits != 0 {
            let co: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
            if co != 0 {
                let fields = ListBuf { bytes: [0u8; 131072], len: 0 };
                lb_append(&fields, STR_PTR("hash"), STR_LEN("hash"));
                lb_append(&fields, STR_PTR("short"), STR_LEN("short"));
                lb_append(&fields, STR_PTR("author"), STR_LEN("author"));
                lb_append(&fields, STR_PTR("date"), STR_LEN("date"));
                lb_append(&fields, STR_PTR("subject"), STR_LEN("subject"));
                lb_append(&fields, STR_PTR("body"), STR_LEN("body"));
                let fk = StrBuf { bytes: [0u8; 65536], len: 0 };
                let fi: u64 = 0;
                while fi < 6 {
                    let g0: bool = lb_at(&fields, fi, &fk);
                    let pvv = StrBuf { bytes: [0u8; 65536], len: 0 };
                    tool_sb_trim(&parts[fi], &pvv);
                    jset_str(co, sb_ptr(&fk), fk.len, sb_ptr(&pvv), pvv.len);
                    fi = fi + 1;
                }
                let rp2: i32 = sa_json_array_push_node(commits, co);
                commit_count = commit_count + 1;
            };
        };
        if commit_count >= (max_count as u64) { break; };
        if eol >= r.stdout.len { break; };
    }
    let payload: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    if payload != 0 && commits != 0 {
        jset_str(payload, STR_PTR("status"), STR_LEN("status"), STR_PTR("ok"), STR_LEN("ok"));
        jset_str(payload, STR_PTR("action"), STR_LEN("action"), STR_PTR("git_log"), STR_LEN("git_log"));
        jset_str(payload, STR_PTR("repo"), STR_LEN("repo"), sb_ptr(&repo_root), repo_root.len);
        if has_rev { jset_str(payload, STR_PTR("revision"), STR_LEN("revision"), sb_ptr(&raw_rev), raw_rev.len); };
        jset_f64(payload, STR_PTR("count"), STR_LEN("count"), commit_count as f64);
        jset_node(payload, STR_PTR("commits"), STR_LEN("commits"), commits);
        jset_bool(payload, STR_PTR("truncated"), STR_LEN("truncated"), false);
        let cjb = JsonBuf { bytes: [0u8; 262144], len: 0 };
        jdoc_to_jb(payload, &cjb);
        let pretty = JsonBuf { bytes: [0u8; 262144], len: 0 };
        json_pretty_into(jb_ptr(&cjb), cjb.len, &pretty);
        res_success(out, started_at);
        if pretty.len > (max_bytes as u64) {
            let final = JsonBuf { bytes: [0u8; 262144], len: 0 };
            jb_append(&final, jb_ptr(&pretty), max_bytes as u64);
            jb_append(&final, STR_PTR("\n[truncated: showing partial git_log output]"), STR_LEN("\n[truncated: showing partial git_log output]"));
            res_set_stdout(out, jb_ptr(&final), final.len);
        } else {
            res_set_stdout(out, jb_ptr(&pretty), pretty.len);
        };
        if tool_sb_contains(&r.stderr, STR_PTR("truncated to buffer size"), STR_LEN("truncated to buffer size")) {
            res_set_stderr(out, sb_ptr(&r.stderr), r.stderr.len);
        };
        sa_json_free(payload);
    };
    if odoc != 0 { sa_json_free(odoc); };
    return 0;
}

// ---- batch 19a: http_fetch, host exec machinery, sessions, git safety ----

fn http_status_phrase(code: u64, out: &StrBuf) -> void {
    out.len = 0;
    if code == 400 { sb_append(out, STR_PTR("Bad Request"), STR_LEN("Bad Request")); return; };
    if code == 401 { sb_append(out, STR_PTR("Unauthorized"), STR_LEN("Unauthorized")); return; };
    if code == 403 { sb_append(out, STR_PTR("Forbidden"), STR_LEN("Forbidden")); return; };
    if code == 404 { sb_append(out, STR_PTR("Not Found"), STR_LEN("Not Found")); return; };
    if code == 405 { sb_append(out, STR_PTR("Method Not Allowed"), STR_LEN("Method Not Allowed")); return; };
    if code == 409 { sb_append(out, STR_PTR("Conflict"), STR_LEN("Conflict")); return; };
    if code == 422 { sb_append(out, STR_PTR("Unprocessable Entity"), STR_LEN("Unprocessable Entity")); return; };
    if code == 429 { sb_append(out, STR_PTR("Too Many Requests"), STR_LEN("Too Many Requests")); return; };
    if code == 500 { sb_append(out, STR_PTR("Internal Server Error"), STR_LEN("Internal Server Error")); return; };
    if code == 502 { sb_append(out, STR_PTR("Bad Gateway"), STR_LEN("Bad Gateway")); return; };
    if code == 503 { sb_append(out, STR_PTR("Service Unavailable"), STR_LEN("Service Unavailable")); return; };
    if code == 504 { sb_append(out, STR_PTR("Gateway Timeout"), STR_LEN("Gateway Timeout")); return; };
}

fn nativeHttpFetch(url: &StrBuf, method: &StrBuf, headers_doc: u64, body: &StrBuf, has_body: bool, policy_doc: u64, cwd: &StrBuf, started_at: f64, timeout_opts: &JsonBuf, out: &SaVmRunResult) -> i32 {
    let norm = NormalizedSaVmPolicy { engine: 0, fs: NormalizedFs { entries: FsEntryList { items: [SaVmFsEntry { path: [0u8; 1024], path_len: 0, access: 0 }; 128], len: 0 }, read: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, write: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, transfer: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, delete: 0, backupDir: [0u8; 1024], backupDir_len: 0, backupDir_has: false }, http_allow: HttpRuleList { items: [SaVmHttpAllowRule { host: [0u8; 512], host_len: 0, methods: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_methods: false, paths: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_paths: false }; 128], len: 0 }, env_allow: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, process: NormalizedProcess { spawn: false, exec: ExecRuleList { items: [SaVmProcessExecRule { path: [0u8; 4096], path_len: 0, args: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_args: false }; 128], len: 0 }, bunProfiles: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_bunProfiles: false, bun_enabled: false, bun_allowedSubcommands: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_bun: false }, execution_javascript: false, execution_python: false, tools: NormalizedTools { replaceRead: false, replaceWrite: false, replaceApplyPatch: false, replaceExec: false, readFiles: false, editFiles: false, applyPatch: false, fastSearch: false, clearToolHistory: false, findReferences: false, renameSymbol: false, fileOutline: false, moveWithImports: false, findDefinition: false, extractToFile: false, addImport: false, getDiagnostics: false, organizeImports: false, analyzeScope: false, codeGraph: false }, contextSavings: SaVmContextSavingsConfig { locateBeforeRead: false, maxReadFileBytes: 0, maxReadFileBytes_has: false, grepCircuitBreaker: false, grepMaxResults: 0, grepMaxResults_has: false, grepMaxTokens: 0, grepMaxTokens_has: false, slimRunnerOutput: false, parallelBudget: false, parallelMaxTotalBytes: 0, parallelMaxTotalBytes_has: false, parallelMaxReadFiles: 0, parallelMaxReadFiles_has: false, parallelDeduplication: false, tieredSkillInjection: false, foldWaterfallEvents: false, foldHistoryReadSummaries: false, historyReadFoldTurns: 0, historyReadFoldTurns_has: false }, contextSavings_has: false };
    normalize_policy(policy_doc, cwd, &norm);
    let dec = SaVmPolicyDecision { allowed: false, reason: [0u8; 2048], reason_len: 0, path: [0u8; 1024], path_len: 0, path_has: false };
    checkSaVmHttp(&norm, sb_ptr(url), url.len, sb_ptr(method), method.len, &dec);
    if !dec.allowed {
        let rsn = StrBuf { bytes: [0u8; 65536], len: 0 };
        let rp: ptr = PTR_NULL();
        PTR_BYTE_ADD(rp, &dec.reason, 0);
        sb_append(&rsn, rp, dec.reason_len);
        res_capability(out, &rsn, started_at);
        return 0;
    };
    let timeout_ms: f64 = resolveTimeoutMs(timeout_opts, 15000.0);
    let mtag: u8 = 0;
    if sb_eq(method, STR_PTR("GET"), STR_LEN("GET")) { mtag = 1; };
    if sb_eq(method, STR_PTR("POST"), STR_LEN("POST")) { mtag = 2; };
    if sb_eq(method, STR_PTR("PUT"), STR_LEN("PUT")) { mtag = 3; };
    if sb_eq(method, STR_PTR("DELETE"), STR_LEN("DELETE")) { mtag = 4; };
    if mtag == 0 {
        res_sa_error(out, STR_PTR("fetch failed"), STR_LEN("fetch failed"), started_at);
        return 0;
    };
    let use_tls: u8 = 0;
    if sb_starts(url, STR_PTR("https:"), STR_LEN("https:")) { use_tls = 1; };
    let client: ptr = PTR_NULL();
    let cst: u32 = sa_http_client_new_v2(use_tls, PTR_NULL(), 0, &client);
    if cst != 0 || client == PTR_NULL() {
        res_sa_error(out, STR_PTR("fetch failed"), STR_LEN("fetch failed"), started_at);
        return 0;
    };
    let req: ptr = PTR_NULL();
    let rst: u32 = sa_http_client_req_new_v2(client, mtag, sb_ptr(url), url.len, &req);
    if rst != 0 || req == PTR_NULL() {
        let cf: u32 = sa_http_client_free(client);
        res_sa_error(out, STR_PTR("fetch failed"), STR_LEN("fetch failed"), started_at);
        return 0;
    };
    if headers_doc != 0 {
        if sa_json_node_kind(headers_doc) == JK_OBJECT {
            let cnt: u64 = jcount(headers_doc);
            let hi: u64 = 0;
            while hi < cnt {
                let kp: ptr = PTR_NULL();
                let kn: u64 = 0;
                let vst: i32 = sa_json_object_key_at(headers_doc, hi, &kp, &kn);
                if vst == 0 {
                    let vnode: u64 = jget_node(headers_doc, kp, kn);
                    if vnode != 0 {
                        let vs = StrBuf { bytes: [0u8; 65536], len: 0 };
                        if sa_json_node_kind(vnode) == JK_STRING {
                            let vp: ptr = PTR_NULL();
                            let vn: u64 = 0;
                            let gst: i32 = sa_json_node_string(vnode, &vp, &vn);
                            sb_append(&vs, vp, vn);
                        } else {
                            js_string_coerce(vnode, &vs);
                        };
                        let hst: u32 = sa_http_client_req_add_header_v2(req, kp, kn, sb_ptr(&vs), vs.len);
                    };
                };
                hi = hi + 1;
            }
        };
    };
    if has_body {
        if mtag == 2 || mtag == 3 {
            let bst: u32 = sa_http_client_req_set_body_v2(req, sb_ptr(body), body.len);
        };
    };
    let tst: u32 = sa_http_client_req_set_timeout_v2(req, timeout_ms as u32);
    let resp: ptr = PTR_NULL();
    let sst: u32 = sa_http_client_req_send_v2(req, &resp);
    if sst == 3 {
        let rf: u32 = sa_http_client_req_free(req);
        let cf2: u32 = sa_http_client_free(client);
        let em = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_append(&em, STR_PTR("http_fetch request timed out after "), STR_LEN("http_fetch request timed out after "));
        sb_append_f64(timeout_ms, &em);
        sb_append(&em, STR_PTR("ms"), STR_LEN("ms"));
        res_err(out, STR_PTR("timeout"), STR_LEN("timeout"), sb_ptr(&em), em.len, started_at);
        out.has_exitCode = true;
        out.exitCode = 124;
        return 0;
    };
    if sst != 0 || resp == PTR_NULL() {
        let rf2: u32 = sa_http_client_req_free(req);
        let cf3: u32 = sa_http_client_free(client);
        res_sa_error(out, STR_PTR("fetch failed"), STR_LEN("fetch failed"), started_at);
        return 0;
    };
    let status: u64 = sa_http_client_resp_status(resp) as u64;
    let bp: ptr = sa_http_client_resp_body_ptr(resp);
    let bn: u64 = sa_http_client_resp_body_len(resp);
    let bodyb = StrBuf { bytes: [0u8; 65536], len: 0 };
    if bp != PTR_NULL() { sb_append(&bodyb, bp, bn); };
    let rf3: u32 = sa_http_client_resp_free(resp);
    let rf4: u32 = sa_http_client_req_free(req);
    let cf4: u32 = sa_http_client_free(client);
    let ok: bool = status >= 200 && status < 300;
    res_init(out);
    out.ok = ok;
    if ok {
        res_set_kind(out, STR_PTR("success"), STR_LEN("success"));
        out.has_exitCode = true;
        out.exitCode = 0;
    } else {
        res_set_kind(out, STR_PTR("sa_error"), STR_LEN("sa_error"));
        out.has_exitCode = true;
        out.exitCode = 1;
        let em2 = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_append(&em2, STR_PTR("HTTP "), STR_LEN("HTTP "));
        tool_sb_append_u64(status, &em2);
        sb_append(&em2, STR_PTR(": "), STR_LEN(": "));
        let ph = StrBuf { bytes: [0u8; 65536], len: 0 };
        http_status_phrase(status, &ph);
        sb_append(&em2, sb_ptr(&ph), ph.len);
        res_set_stderr(out, sb_ptr(&em2), em2.len);
    };
    res_set_stdout(out, sb_ptr(&bodyb), bodyb.len);
    out.durationMs = dur_since(started_at);
    return 0;
}

// ---- run_host constant sets (as predicates over lowercased names) ----
fn host_name_is_allowlist(s: &StrBuf) -> bool {
    if sb_eq(s, STR_PTR("bun"), STR_LEN("bun")) { return true; };
    if sb_eq(s, STR_PTR("bun.exe"), STR_LEN("bun.exe")) { return true; };
    if sb_eq(s, STR_PTR("node"), STR_LEN("node")) { return true; };
    if sb_eq(s, STR_PTR("node.exe"), STR_LEN("node.exe")) { return true; };
    if sb_eq(s, STR_PTR("python"), STR_LEN("python")) { return true; };
    if sb_eq(s, STR_PTR("python.exe"), STR_LEN("python.exe")) { return true; };
    if sb_eq(s, STR_PTR("python3"), STR_LEN("python3")) { return true; };
    if sb_eq(s, STR_PTR("zig"), STR_LEN("zig")) { return true; };
    if sb_eq(s, STR_PTR("zig.exe"), STR_LEN("zig.exe")) { return true; };
    if sb_eq(s, STR_PTR("cargo"), STR_LEN("cargo")) { return true; };
    if sb_eq(s, STR_PTR("cargo.exe"), STR_LEN("cargo.exe")) { return true; };
    if sb_eq(s, STR_PTR("rustc"), STR_LEN("rustc")) { return true; };
    if sb_eq(s, STR_PTR("rustc.exe"), STR_LEN("rustc.exe")) { return true; };
    if sb_eq(s, STR_PTR("go"), STR_LEN("go")) { return true; };
    if sb_eq(s, STR_PTR("go.exe"), STR_LEN("go.exe")) { return true; };
    if sb_eq(s, STR_PTR("git"), STR_LEN("git")) { return true; };
    if sb_eq(s, STR_PTR("git.exe"), STR_LEN("git.exe")) { return true; };
    return false;
}

