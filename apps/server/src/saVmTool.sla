                        ci = ci + 1;
                    }
                    jset_node(fdoc, STR_PTR("tag"), STR_LEN("tag"), ta);
                };
            };
        };
    };
    let filter = RegressionCaseFilter { json: [0u8; 8192], json_len: 0, has_filter: true };
    if fdoc != 0 {
        let fjb = JsonBuf { bytes: [0u8; 262144], len: 0 };
        jdoc_to_jb(fdoc, &fjb);
        let take: u64 = fjb.len;
        if take > 8192 { take = 8192; };
        let i: u64 = 0;
        while i < take {
            let c: u8 = 0;
            PTR_BYTE_AT(c, jb_ptr(&fjb), i);
            filter.json[i] = c;
            i = i + 1;
        }
        filter.json_len = take;
        sa_json_free(fdoc);
    };
    let report = RegressionSuiteReport { ok: false, total_cases: 0, passed_cases: 0, failed_cases: 0, regressed_cases: 0, duration_ms: 0, results: [0u8; 4194304], result_lens: [0u64; 512], results_len: 0, summary: [0u8; 4096], summary_len: 0, err: [0u8; 1024], err_len: 0 };
    let rcr: i32 = runRegressionSuite(&filter, true, sb_ptr(cwd), cwd.len, &report);
    // build report JSON doc
    let rdoc: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    let pretty = JsonBuf { bytes: [0u8; 262144], len: 0 };
    if rdoc != 0 {
        if report.ok { jset_bool(rdoc, STR_PTR("ok"), STR_LEN("ok"), true); } else { jset_bool(rdoc, STR_PTR("ok"), STR_LEN("ok"), false); };
        jset_f64(rdoc, STR_PTR("totalCases"), STR_LEN("totalCases"), report.total_cases as f64);
        jset_f64(rdoc, STR_PTR("passedCases"), STR_LEN("passedCases"), report.passed_cases as f64);
        jset_f64(rdoc, STR_PTR("failedCases"), STR_LEN("failedCases"), report.failed_cases as f64);
        jset_f64(rdoc, STR_PTR("regressedCases"), STR_LEN("regressedCases"), report.regressed_cases as f64);
        jset_f64(rdoc, STR_PTR("durationMs"), STR_LEN("durationMs"), report.duration_ms as f64);
        let rarr: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
        if rarr != 0 {
            let off: u64 = 0;
            let ri: u64 = 0;
            while ri < report.results_len && ri < 512 {
                let clen: u64 = report.result_lens[ri];
                let cp: ptr = PTR_NULL();
                PTR_BYTE_ADD(cp, &report.results, off);
                let chunk = JsonBuf { bytes: [0u8; 262144], len: 0 };
                jb_append(&chunk, cp, clen);
                let cdoc: u64 = jdoc_of_jb(&chunk);
                if cdoc != 0 {
                    let rp: i32 = sa_json_array_push_node(rarr, cdoc);
                };
                off = off + clen;
                ri = ri + 1;
            }
            jset_node(rdoc, STR_PTR("results"), STR_LEN("results"), rarr);
        };
        let sum = StrBuf { bytes: [0u8; 65536], len: 0 };
        let fp8: ptr = PTR_NULL(); PTR_BYTE_ADD(fp8, &report.summary, 0); sb_append(&sum, fp8, report.summary_len);
        jset_str(rdoc, STR_PTR("summary"), STR_LEN("summary"), sb_ptr(&sum), sum.len);
        if report.err_len > 0 {
            let ev2 = StrBuf { bytes: [0u8; 65536], len: 0 };
            let fp9: ptr = PTR_NULL(); PTR_BYTE_ADD(fp9, &report.err, 0); sb_append(&ev2, fp9, report.err_len);
            jset_str(rdoc, STR_PTR("error"), STR_LEN("error"), sb_ptr(&ev2), ev2.len);
        };
        let cjb = JsonBuf { bytes: [0u8; 262144], len: 0 };
        jdoc_to_jb(rdoc, &cjb);
        json_pretty_into(jb_ptr(&cjb), cjb.len, &pretty);
        sa_json_free(rdoc);
    };
    let summary = StrBuf { bytes: [0u8; 65536], len: 0 };
    let fp10: ptr = PTR_NULL(); PTR_BYTE_ADD(fp10, &report.summary, 0); sb_append(&summary, fp10, report.summary_len);
    if report.regressed_cases > 0 {
        out.ok = false;
        out.has_exitCode = true;
        out.exitCode = 1;
        out.kind_len = 0;
        let kk = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_assign(&kk, STR_PTR("sa_error"), STR_LEN("sa_error"));
        let ki: u64 = 0;
        while ki < kk.len && ki < 32 { out.kind[ki] = kk.bytes[ki]; ki = ki + 1; }
        out.kind_len = kk.len;
        out.durationMs = dur_since(started_at) as u64;
        res_set_stdout(out, jb_ptr(&pretty), pretty.len);
        let em = StrBuf { bytes: [0u8; 65536], len: 0 };
        // rocket emoji U+1F6A8 as raw UTF-8 bytes
        sb_push_byte(&em, 240);
        sb_push_byte(&em, 159);
        sb_push_byte(&em, 154);
        sb_push_byte(&em, 168);
        sb_append(&em, STR_PTR(" REGRESSION DETECTED: "), STR_LEN(" REGRESSION DETECTED: "));
        tool_sb_append_u64(report.regressed_cases, &em);
        sb_append(&em, STR_PTR(" historical bug(s) have regressed!\n"), STR_LEN(" historical bug(s) have regressed!\n"));
        sb_append(&em, sb_ptr(&summary), summary.len);
        res_set_stderr(out, sb_ptr(&em), em.len);
        let ev3: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
        let eo: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
        if ev3 != 0 && eo != 0 {
            jset_str(eo, STR_PTR("event"), STR_LEN("event"), STR_PTR("violation"), STR_LEN("violation"));
            jset_str(eo, STR_PTR("kind"), STR_LEN("kind"), STR_PTR("historical_regression"), STR_LEN("historical_regression"));
            jset_str(eo, STR_PTR("reason"), STR_LEN("reason"), sb_ptr(&summary), summary.len);
            let rp: i32 = sa_json_array_push_node(ev3, eo);
            let ejb = JsonBuf { bytes: [0u8; 262144], len: 0 };
            jdoc_to_jb(ev3, &ejb);
            res_set_events(out, jb_ptr(&ejb), ejb.len);
            let bfix10159: i32 = sa_json_free(ev3);
        } else {
            if ev3 != 0 { sa_json_free(ev3); };
        };
        let vr = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_assign(&vr, STR_PTR("Historical regression detected: "), STR_LEN("Historical regression detected: "));
        tool_sb_append_u64(report.regressed_cases, &vr);
        sb_append(&vr, STR_PTR(" case(s) failed"), STR_LEN(" case(s) failed"));
        res_set_violation(out, sb_ptr(&vr), vr.len);
        if idoc != 0 { sa_json_free(idoc); };
        return 0;
    };
    if report.ok {
        res_success(out, started_at);
    } else {
        res_sa_error(out, sb_ptr(&summary), summary.len, started_at);
        // res_sa_error set stderr to summary already only if summary is the
        // message; stdout must be the pretty report
    };
    res_set_stdout(out, jb_ptr(&pretty), pretty.len);
    if !report.ok {
        res_set_stderr(out, sb_ptr(&summary), summary.len);
    };
    out.durationMs = dur_since(started_at) as u64;
    if idoc != 0 { sa_json_free(idoc); };
    return 0;
}

fn nativeRecordCase(raw_input: &JsonBuf, cwd: &StrBuf, started_at: f64, out: &SaVmRunResult) -> i32 {
    let idoc: u64 = jdoc_of_jb(raw_input);
    let case_def = RegressionCase { id: [0u8; 256], id_len: 0, title: [0u8; 512], title_len: 0, component: [0u8; 256], component_len: 0, tags: [0u8; 4096], tag_lens: [0u64; 32], tags_len: 0, category: [0u8; 128], category_len: 0, description: [0u8; 2048], description_len: 0, input_json: [0u8; 65536], input_json_len: 0, simulation_json: [0u8; 65536], simulation_json_len: 0, negative_matcher_json: [0u8; 16384], negative_matcher_json_len: 0, positive_invariants_json: [0u8; 16384], positive_invariants_json_len: 0, has_runner: false, runner: [0u8; 128], runner_len: 0 };
    if idoc != 0 {
        let v = StrBuf { bytes: [0u8; 65536], len: 0 };
        let has_v: bool = false;
        if jget_str(idoc, STR_PTR("id"), STR_LEN("id"), &v) { has_v = true; };
        if !has_v && jget_str(idoc, STR_PTR("case_id"), STR_LEN("case_id"), &v) { has_v = true; };
        if has_v {
            let i: u64 = 0;
            while i < v.len && case_def.id_len < 256 { case_def.id[case_def.id_len] = v.bytes[i]; case_def.id_len = case_def.id_len + 1; i = i + 1; }
        };
        if jget_str(idoc, STR_PTR("title"), STR_LEN("title"), &v) {
            let i: u64 = 0;
            while i < v.len && case_def.title_len < 512 { case_def.title[case_def.title_len] = v.bytes[i]; case_def.title_len = case_def.title_len + 1; i = i + 1; }
        };
        has_v = false;
        if jget_str(idoc, STR_PTR("component"), STR_LEN("component"), &v) { has_v = true; };
        if !has_v && jget_str(idoc, STR_PTR("target"), STR_LEN("target"), &v) { has_v = true; };
        if has_v {
            let i: u64 = 0;
            while i < v.len && case_def.component_len < 256 { case_def.component[case_def.component_len] = v.bytes[i]; case_def.component_len = case_def.component_len + 1; i = i + 1; }
        };
        let tn: u64 = node_nonnull(idoc, STR_PTR("tags"), STR_LEN("tags"));
        if tn != 0 && sa_json_kind(tn) == 6 {
            let cc: u64 = jcount(tn);
            let ci: u64 = 0;
            let off: u64 = 0;
            let tv = StrBuf { bytes: [0u8; 65536], len: 0 };
            while ci < cc && case_def.tags_len < 32 {
                let en: u64 = jarr_at(tn, ci);
                if en != 0 && sa_json_kind(en) == 5 {
                    tv.len = 0;
                    sb_append(&tv, jstr_ptr(en), sa_json_string_len(en));
                    let tl: u64 = tv.len;
                    if off + tl > 4096 { tl = 4096 - off; };
                    let j: u64 = 0;
                    while j < tl { case_def.tags[off + j] = tv.bytes[j]; j = j + 1; }
                    case_def.tag_lens[case_def.tags_len] = tl;
                    case_def.tags_len = case_def.tags_len + 1;
                    off = off + tl;
                };
                ci = ci + 1;
            }
        };
        if jget_str(idoc, STR_PTR("category"), STR_LEN("category"), &v) {
            let i: u64 = 0;
            while i < v.len && case_def.category_len < 128 { case_def.category[case_def.category_len] = v.bytes[i]; case_def.category_len = case_def.category_len + 1; i = i + 1; }
        };
        if jget_str(idoc, STR_PTR("description"), STR_LEN("description"), &v) {
            let i: u64 = 0;
            while i < v.len && case_def.description_len < 2048 { case_def.description[case_def.description_len] = v.bytes[i]; case_def.description_len = case_def.description_len + 1; i = i + 1; }
        };
        let in_node: u64 = node_nonnull(idoc, STR_PTR("input"), STR_LEN("input"));
        if in_node != 0 && sa_json_kind(in_node) == 7 {
            let hold: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
            if hold != 0 {
                let rp: i32 = sa_json_array_push_node(hold, in_node);
                let hjb = JsonBuf { bytes: [0u8; 262144], len: 0 };
                jdoc_to_jb(hold, &hjb);
                // hjb is [node]; strip the brackets
                if hjb.len >= 2 {
                    let i: u64 = 0;
                    while i + 2 <= hjb.len && case_def.input_json_len < 65536 {
                        let c: u8 = 0;
                        PTR_BYTE_AT(c, jb_ptr(&hjb), i + 1);
                        case_def.input_json[case_def.input_json_len] = c;
                        case_def.input_json_len = case_def.input_json_len + 1;
                        i = i + 1;
                    }
                };
                sa_json_free(hold);
            };
        };
        let sim_node: u64 = node_nonnull(idoc, STR_PTR("simulation"), STR_LEN("simulation"));
        if sim_node != 0 && sa_json_kind(sim_node) == 7 {
            let hold: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
            if hold != 0 {
                let rp: i32 = sa_json_array_push_node(hold, sim_node);
                let hjb = JsonBuf { bytes: [0u8; 262144], len: 0 };
                jdoc_to_jb(hold, &hjb);
                if hjb.len >= 2 {
                    let i: u64 = 0;
                    while i + 2 <= hjb.len && case_def.simulation_json_len < 65536 {
                        let c: u8 = 0;
                        PTR_BYTE_AT(c, jb_ptr(&hjb), i + 1);
                        case_def.simulation_json[case_def.simulation_json_len] = c;
                        case_def.simulation_json_len = case_def.simulation_json_len + 1;
                        i = i + 1;
                    }
                };
                sa_json_free(hold);
            };
        };
        let nm_node: u64 = node_nonnull(idoc, STR_PTR("negativeMatcher"), STR_LEN("negativeMatcher"));
        if nm_node == 0 || sa_json_kind(nm_node) != 7 { nm_node = node_nonnull(idoc, STR_PTR("negative_matcher"), STR_LEN("negative_matcher")); };
        if nm_node != 0 && sa_json_kind(nm_node) == 7 {
            let hold: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
            if hold != 0 {
                let rp: i32 = sa_json_array_push_node(hold, nm_node);
                let hjb = JsonBuf { bytes: [0u8; 262144], len: 0 };
                jdoc_to_jb(hold, &hjb);
                if hjb.len >= 2 {
                    let i: u64 = 0;
                    while i + 2 <= hjb.len && case_def.negative_matcher_json_len < 16384 {
                        let c: u8 = 0;
                        PTR_BYTE_AT(c, jb_ptr(&hjb), i + 1);
                        case_def.negative_matcher_json[case_def.negative_matcher_json_len] = c;
                        case_def.negative_matcher_json_len = case_def.negative_matcher_json_len + 1;
                        i = i + 1;
                    }
                };
                sa_json_free(hold);
            };
        };
        let pi_node: u64 = node_nonnull(idoc, STR_PTR("positiveInvariants"), STR_LEN("positiveInvariants"));
        if pi_node == 0 || sa_json_kind(pi_node) != 7 { pi_node = node_nonnull(idoc, STR_PTR("positive_invariants"), STR_LEN("positive_invariants")); };
        if pi_node != 0 && sa_json_kind(pi_node) == 7 {
            let hold: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
            if hold != 0 {
                let rp: i32 = sa_json_array_push_node(hold, pi_node);
                let hjb = JsonBuf { bytes: [0u8; 262144], len: 0 };
                jdoc_to_jb(hold, &hjb);
                if hjb.len >= 2 {
                    let i: u64 = 0;
                    while i + 2 <= hjb.len && case_def.positive_invariants_json_len < 16384 {
                        let c: u8 = 0;
                        PTR_BYTE_AT(c, jb_ptr(&hjb), i + 1);
                        case_def.positive_invariants_json[case_def.positive_invariants_json_len] = c;
                        case_def.positive_invariants_json_len = case_def.positive_invariants_json_len + 1;
                        i = i + 1;
                    }
                };
                sa_json_free(hold);
            };
        };
        if jget_str(idoc, STR_PTR("runner"), STR_LEN("runner"), &v) {
            case_def.has_runner = true;
            let i: u64 = 0;
            while i < v.len && case_def.runner_len < 128 { case_def.runner[case_def.runner_len] = v.bytes[i]; case_def.runner_len = case_def.runner_len + 1; i = i + 1; }
        };
    };
    let rec = RecordRegressionCaseResult { ok: false, path: [0u8; 2048], path_len: 0, case_json: [0u8; 131072], case_json_len: 0, has_error: false, error: [0u8; 1024], error_len: 0 };
    let rcr: i32 = recordRegressionCase(&case_def, true, sb_ptr(cwd), cwd.len, &rec);
    if !rec.ok {
        let em = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_assign(&em, STR_PTR("Failed to record regression case: "), STR_LEN("Failed to record regression case: "));
        let fp11: ptr = PTR_NULL(); PTR_BYTE_ADD(fp11, &rec.error, 0); sb_append(&em, fp11, rec.error_len);
        res_sa_error(out, sb_ptr(&em), em.len, started_at);
        out.durationMs = dur_since(started_at) as u64;
        if idoc != 0 { sa_json_free(idoc); };
        return 0;
    };
    let odoc2: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    let pretty = JsonBuf { bytes: [0u8; 262144], len: 0 };
    if odoc2 != 0 {
        jset_str(odoc2, STR_PTR("action"), STR_LEN("action"), STR_PTR("record_case"), STR_LEN("record_case"));
        let fp101: ptr = PTR_NULL(); PTR_BYTE_ADD(fp101, &rec.path, 0);
        jset_str(odoc2, STR_PTR("path"), STR_LEN("path"), fp101, rec.path_len);
        let case_jb = JsonBuf { bytes: [0u8; 262144], len: 0 };
        let fp12: ptr = PTR_NULL(); PTR_BYTE_ADD(fp12, &rec.case_json, 0); jb_append(&case_jb, fp12, rec.case_json_len);
        let cdoc: u64 = jdoc_of_jb(&case_jb);
        let case_id = StrBuf { bytes: [0u8; 65536], len: 0 };
        if cdoc != 0 {
            if jget_str(cdoc, STR_PTR("id"), STR_LEN("id"), &case_id) { };
            jset_node(odoc2, STR_PTR("case"), STR_LEN("case"), cdoc);
        };
        let msg = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_assign(&msg, STR_PTR("Regression case recorded successfully: "), STR_LEN("Regression case recorded successfully: "));
        sb_append(&msg, sb_ptr(&case_id), case_id.len);
        jset_str(odoc2, STR_PTR("message"), STR_LEN("message"), sb_ptr(&msg), msg.len);
        let cjb = JsonBuf { bytes: [0u8; 262144], len: 0 };
        jdoc_to_jb(odoc2, &cjb);
        json_pretty_into(jb_ptr(&cjb), cjb.len, &pretty);
        sa_json_free(odoc2);
    };
    res_success(out, started_at);
    res_set_stdout(out, jb_ptr(&pretty), pretty.len);
    out.durationMs = dur_since(started_at) as u64;
    if idoc != 0 { sa_json_free(idoc); };
    return 0;
}

// ---- workspace notes / memory ----
fn note_level_weight(level: &StrBuf) -> f64 {
    if tool_bytes_eq(sb_ptr(level), level.len, STR_PTR("low"), STR_LEN("low")) { return 1.0; };
    if tool_bytes_eq(sb_ptr(level), level.len, STR_PTR("important"), STR_LEN("important")) { return 3.0; };
    if tool_bytes_eq(sb_ptr(level), level.len, STR_PTR("critical"), STR_LEN("critical")) { return 4.0; };
    return 2.0;
}

fn normalizeNoteLevel(raw: &StrBuf, has_raw: bool, out: &StrBuf) -> void {
    out.len = 0;
    if !has_raw {
        sb_assign(out, STR_PTR("normal"), STR_LEN("normal"));
        return;
    };
    let tr = StrBuf { bytes: [0u8; 65536], len: 0 };
    tool_sb_trim(raw, &tr);
    let low = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_to_lower(&tr, &low);
    if tool_bytes_eq(sb_ptr(&low), low.len, STR_PTR("critical"), STR_LEN("critical")) || tool_bytes_eq(sb_ptr(&low), low.len, STR_PTR("urgent"), STR_LEN("urgent")) || tool_bytes_eq(sb_ptr(&low), low.len, STR_PTR("highest"), STR_LEN("highest")) || sb_eq_utf8(&low, STR_PTR("非常重要"), STR_LEN("非常重要")) {
        sb_assign(out, STR_PTR("critical"), STR_LEN("critical"));
        return;
    };
    if tool_bytes_eq(sb_ptr(&low), low.len, STR_PTR("important"), STR_LEN("important")) || tool_bytes_eq(sb_ptr(&low), low.len, STR_PTR("high"), STR_LEN("high")) || sb_eq_utf8(&low, STR_PTR("重要"), STR_LEN("重要")) {
        sb_assign(out, STR_PTR("important"), STR_LEN("important"));
        return;
    };
    if tool_bytes_eq(sb_ptr(&low), low.len, STR_PTR("low"), STR_LEN("low")) || tool_bytes_eq(sb_ptr(&low), low.len, STR_PTR("minor"), STR_LEN("minor")) || sb_eq_utf8(&low, STR_PTR("低级"), STR_LEN("低级")) {
        sb_assign(out, STR_PTR("low"), STR_LEN("low"));
        return;
    };
    sb_assign(out, STR_PTR("normal"), STR_LEN("normal"));
}

fn sb_eq_utf8(a: &StrBuf, p: ptr, n: u64) -> bool {
    return tool_bytes_eq(sb_ptr(a), a.len, p, n);
}

fn resolveMemoryFile(cwd: &StrBuf, scope: u64, file_out: &StrBuf, label_out: &StrBuf) -> void {
    file_out.len = 0;
    label_out.len = 0;
    let pb = PathBuf { bytes: [0u8; 4096], len: 0 };
    if scope == 1 {
        let rc: i32 = resolveGlobalMemoryFilePath(&pb);
        let pbp: ptr = PTR_NULL(); PTR_BYTE_ADD(pbp, &pb.bytes, 0);
        sb_append(file_out, pbp, pb.len);
        sb_assign(label_out, STR_PTR("global"), STR_LEN("global"));
        return;
    };
    let rc: i32 = resolveWorkspaceMemoryFilePath(sb_ptr(cwd), cwd.len, &pb);
    let pbp2: ptr = PTR_NULL(); PTR_BYTE_ADD(pbp2, &pb.bytes, 0);
    sb_append(file_out, pbp2, pb.len);
    path_normalize(cwd, label_out);
}

fn js_string_coerce(node: u64, out: &StrBuf) -> void {
    out.len = 0;
    if node == 0 { return; };
    let k: u64 = sa_json_kind(node);
    if k == 5 {
        sb_append(out, jstr_ptr(node), sa_json_string_len(node));
    } else if k == 2 || k == 3 {
        fmt_f64_sb(sa_json_node_as_f64(node), out);
    } else if k == 1 {
        if sa_json_node_as_bool(node) { sb_assign(out, STR_PTR("true"), STR_LEN("true")); } else { sb_assign(out, STR_PTR("false"), STR_LEN("false")); };
    };
}

fn notes_extract(doc: u64, keys: &ListBuf, contents: &ListBuf, levels: &ListBuf, upds: &F64List) -> void {
    keys.len = 0;
    contents.len = 0;
    levels.len = 0;
    upds.len = 0;
    if doc == 0 { return; };
    let arr: u64 = node_nonnull(doc, STR_PTR("notes"), STR_LEN("notes"));
    if arr == 0 || sa_json_kind(arr) != 6 { return; };
    let cnt: u64 = jcount(arr);
    let i: u64 = 0;
    let v = StrBuf { bytes: [0u8; 65536], len: 0 };
    while i < cnt {
        let en: u64 = jarr_at(arr, i);
        js_string_coerce(node_nonnull(en, STR_PTR("key"), STR_LEN("key")), &v);
        lb_append(keys, sb_ptr(&v), v.len);
        js_string_coerce(node_nonnull(en, STR_PTR("content"), STR_LEN("content")), &v);
        lb_append(contents, sb_ptr(&v), v.len);
        let lv_node: u64 = node_nonnull(en, STR_PTR("level"), STR_LEN("level"));
        let lv = StrBuf { bytes: [0u8; 65536], len: 0 };
        let has_lv: bool = false;
        if lv_node != 0 && sa_json_kind(lv_node) == 5 {
            sb_append(&lv, jstr_ptr(lv_node), sa_json_string_len(lv_node));
            has_lv = true;
        };
        let nlv = StrBuf { bytes: [0u8; 65536], len: 0 };
        normalizeNoteLevel(&lv, has_lv, &nlv);
        lb_append(levels, sb_ptr(&nlv), nlv.len);
        let un: u64 = node_nonnull(en, STR_PTR("updated_at"), STR_LEN("updated_at"));
        let uv: f64 = sa_time_unix_ms() as f64;
        if un != 0 && (sa_json_kind(un) == 2 || sa_json_kind(un) == 3) { uv = sa_json_node_as_f64(un); };
        if upds.len < 4096 { upds.items[upds.len] = uv; upds.len = upds.len + 1; };
        i = i + 1;
    }
}

fn notes_rebuild(doc: u64, keys: &ListBuf, contents: &ListBuf, levels: &ListBuf, upds: &F64List) -> void {
    let arr: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    if arr == 0 { return; };
    let cnt: u64 = lb_count(keys);
    let i: u64 = 0;
    let v = StrBuf { bytes: [0u8; 65536], len: 0 };
    while i < cnt {
        let no: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
        if no != 0 {
            let g1: bool = lb_at(keys, i, &v);
            jset_str(no, STR_PTR("key"), STR_LEN("key"), sb_ptr(&v), v.len);
            let g2: bool = lb_at(contents, i, &v);
            jset_str(no, STR_PTR("content"), STR_LEN("content"), sb_ptr(&v), v.len);
            let g3: bool = lb_at(levels, i, &v);
            jset_str(no, STR_PTR("level"), STR_LEN("level"), sb_ptr(&v), v.len);
            jset_f64(no, STR_PTR("updated_at"), STR_LEN("updated_at"), upds.items[i]);
            let rp: i32 = sa_json_array_push_node(arr, no);
        };
        i = i + 1;
    }
    jset_node(doc, STR_PTR("notes"), STR_LEN("notes"), arr);
}

fn loadWorkspaceNotes(file_path: &StrBuf, workspace_label: &StrBuf, cwd: &StrBuf, is_global: bool, doc_out: &u64) -> void {
    *doc_out = 0;
    let buf: u64 = 0;
    let st: i32 = sa_std_fs_read_file(sb_ptr(file_path), file_path.len, 1048576, &buf);
    if st == 0 && buf != 0 {
        let dp: ptr = sa_fs_read_buffer_data(buf);
        let dl: u64 = sa_fs_read_buffer_len(buf);
        let doc: u64 = sa_json_parse(dp, dl);
        let fr: i32 = sa_fs_read_buffer_free(buf);
        if doc != 0 && sa_json_kind(doc) == 7 {
            let arr: u64 = node_nonnull(doc, STR_PTR("notes"), STR_LEN("notes"));
            if arr != 0 && sa_json_kind(arr) == 6 {
                // normalize note entries in place via tables
                let keys = ListBuf { bytes: [0u8; 131072], len: 0 };
                let contents = ListBuf { bytes: [0u8; 131072], len: 0 };
                let levels = ListBuf { bytes: [0u8; 131072], len: 0 };
                let upds = F64List { items: [0.0; 4096], len: 0 };
                notes_extract(doc, &keys, &contents, &levels, &upds);
                notes_rebuild(doc, &keys, &contents, &levels, &upds);
                *doc_out = doc;
                return;
            };
        };
        if doc != 0 { sa_json_free(doc); };
    } else {
        if buf != 0 { let fr: i32 = sa_fs_read_buffer_free(buf); };
    };
    let doc: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    if doc == 0 { return; };
    let ws = StrBuf { bytes: [0u8; 65536], len: 0 };
    if is_global {
        let g = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_assign(&g, STR_PTR("global"), STR_LEN("global"));
        path_resolve(cwd, &g, &ws);
    } else {
        sb_copy(&ws, workspace_label);
    };
    jset_str(doc, STR_PTR("workspace"), STR_LEN("workspace"), sb_ptr(&ws), ws.len);
    jset_i64(doc, STR_PTR("updated_at"), STR_LEN("updated_at"), sa_time_unix_ms());
    let arr: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    if arr != 0 { jset_node(doc, STR_PTR("notes"), STR_LEN("notes"), arr); };
    *doc_out = doc;
}

fn atomicSaveWorkspaceNotes(file_path: &StrBuf, doc: u64) -> void {
    let dir = StrBuf { bytes: [0u8; 65536], len: 0 };
    tool_path_dirname(file_path, &dir);
    let rc1: i32 = sa_fs_mkdir_p(sb_ptr(&dir), dir.len);
    let cjb = JsonBuf { bytes: [0u8; 262144], len: 0 };
    jdoc_to_jb(doc, &cjb);
    let pretty = JsonBuf { bytes: [0u8; 262144], len: 0 };
    json_pretty_into(jb_ptr(&cjb), cjb.len, &pretty);
    let base = StrBuf { bytes: [0u8; 65536], len: 0 };
    path_basename(file_path, &base);
    // randomUUID is unavailable in sa_std (CAPABILITY_MAP); the tmp name
    // only needs uniqueness until the rename lands.
    let seq: u64 = 0;
    let st: i32 = sa_global_u64_add(STR_PTR("savmtool.notes.tmpseq"), STR_LEN("savmtool.notes.tmpseq"), 1, &seq);
    let tmp = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_copy(&tmp, &base);
    sb_append(&tmp, STR_PTR("."), STR_LEN("."));
    tool_sb_append_u64(sa_time_unix_ms() as u64, &tmp);
    sb_append(&tmp, STR_PTR("-"), STR_LEN("-"));
    tool_sb_append_u64(seq, &tmp);
    sb_append(&tmp, STR_PTR(".tmp"), STR_LEN(".tmp"));
    let tmp_full = StrBuf { bytes: [0u8; 65536], len: 0 };
    path_join(&dir, &tmp, &tmp_full);
    let wrc: i32 = fs_write_all(&tmp_full, jb_ptr(&pretty), pretty.len);
    let rrc: i32 = sa_fs_rename(sb_ptr(&tmp_full), tmp_full.len, sb_ptr(file_path), file_path.len);
}

fn truncate_chars(src: &StrBuf, max_chars: u64, out: &StrBuf, was: &bool) -> void {
    *was = false;
    out.len = 0;
    let count: u64 = 0;
    let i: u64 = 0;
    let cut: u64 = src.len;
    while i < src.len {
        let b: u8 = src.bytes[i];
        let step: u64 = 1;
        if b >= 240 { step = 4; } else if b >= 224 { step = 3; } else if b >= 192 { step = 2; };
        count = count + 1;
        if count == max_chars + 1 {
            cut = i;
            *was = true;
            break;
        };
        i = i + step;
    }
    sb_append(out, sb_ptr(src), cut);
    if !*was && count > max_chars { *was = true; };
}

fn effective_return_action(ea: &StrBuf, a1: &StrBuf, a2: &StrBuf, a3: &StrBuf, a4: &StrBuf, a5: &StrBuf, fallback: &StrBuf, out: &StrBuf) -> void {
    out.len = 0;
    if tool_bytes_eq(sb_ptr(ea), ea.len, sb_ptr(a1), a1.len) || tool_bytes_eq(sb_ptr(ea), ea.len, sb_ptr(a2), a2.len) || tool_bytes_eq(sb_ptr(ea), ea.len, sb_ptr(a3), a3.len) || tool_bytes_eq(sb_ptr(ea), ea.len, sb_ptr(a4), a4.len) || tool_bytes_eq(sb_ptr(ea), ea.len, sb_ptr(a5), a5.len) {
        sb_copy(out, ea);
        return;
    };
    if ea.len > 0 {
        sb_copy(out, ea);
        return;
    };
    sb_copy(out, fallback);
}

fn save_note_core(key_in: &StrBuf, has_key: bool, content_in: &StrBuf, has_content: bool, level_in: &StrBuf, has_level: bool, policy_doc: u64, has_policy: bool, cwd: &StrBuf, started_at: f64, scope_text: &StrBuf, has_scope: bool, effective_action: &StrBuf, out: &SaVmRunResult) -> void {
    let is_memory: bool = tool_sb_contains(effective_action, STR_PTR("memory"), STR_LEN("memory"));
    let ra = StrBuf { bytes: [0u8; 65536], len: 0 };
    let a1 = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_assign(&a1, STR_PTR("save_note"), STR_LEN("save_note"));
    let a2 = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_assign(&a2, STR_PTR("add_note"), STR_LEN("add_note"));
    let a3 = StrBuf { bytes: [0u8; 65536], len: 0 };
    let a4 = StrBuf { bytes: [0u8; 65536], len: 0 };
    let a5 = StrBuf { bytes: [0u8; 65536], len: 0 };
    let fb = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_assign(&fb, STR_PTR("add_memory"), STR_LEN("add_memory"));
    if tool_bytes_eq(sb_ptr(effective_action), effective_action.len, sb_ptr(&a1), a1.len) || tool_bytes_eq(sb_ptr(effective_action), effective_action.len, sb_ptr(&a2), a2.len) {
        sb_copy(&ra, effective_action);
    } else if effective_action.len > 0 {
        sb_copy(&ra, effective_action);
    } else {
        sb_copy(&ra, &fb);
    };
    let noun = StrBuf { bytes: [0u8; 65536], len: 0 };
    if is_memory { sb_assign(&noun, STR_PTR("memory"), STR_LEN("memory")); } else { sb_assign(&noun, STR_PTR("note"), STR_LEN("note")); };
    let norm = NormalizedSaVmPolicy { engine: 0, fs: NormalizedFs { entries: FsEntryList { items: [SaVmFsEntry { path: [0u8; 1024], path_len: 0, access: 0 }; 128], len: 0 }, read: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, write: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, transfer: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, delete: 0, backupDir: [0u8; 1024], backupDir_len: 0, backupDir_has: false }, http_allow: HttpRuleList { items: [SaVmHttpAllowRule { host: [0u8; 512], host_len: 0, methods: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_methods: false, paths: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_paths: false }; 128], len: 0 }, env_allow: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, process: NormalizedProcess { spawn: false, exec: ExecRuleList { items: [SaVmProcessExecRule { path: [0u8; 4096], path_len: 0, args: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_args: false }; 128], len: 0 }, bunProfiles: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_bunProfiles: false, bun_enabled: false, bun_allowedSubcommands: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_bun: false }, execution_javascript: false, execution_python: false, tools: NormalizedTools { replaceRead: false, replaceWrite: false, replaceApplyPatch: false, replaceExec: false, readFiles: false, editFiles: false, applyPatch: false, fastSearch: false, clearToolHistory: false, findReferences: false, renameSymbol: false, fileOutline: false, moveWithImports: false, findDefinition: false, extractToFile: false, addImport: false, getDiagnostics: false, organizeImports: false, analyzeScope: false, codeGraph: false }, contextSavings: SaVmContextSavingsConfig { locateBeforeRead: false, maxReadFileBytes: 0, maxReadFileBytes_has: false, grepCircuitBreaker: false, grepMaxResults: 0, grepMaxResults_has: false, grepMaxTokens: 0, grepMaxTokens_has: false, slimRunnerOutput: false, parallelBudget: false, parallelMaxTotalBytes: 0, parallelMaxTotalBytes_has: false, parallelMaxReadFiles: 0, parallelMaxReadFiles_has: false, parallelDeduplication: false, tieredSkillInjection: false, foldWaterfallEvents: false, foldHistoryReadSummaries: false, historyReadFoldTurns: 0, historyReadFoldTurns_has: false }, contextSavings_has: false };
    normalize_policy(policy_doc, cwd, &norm);
    let allow: bool = !has_policy || norm.tools.editFiles || norm.tools.replaceWrite;
    if !allow {
        let em = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_assign(&em, STR_PTR("action '"), STR_LEN("action '"));
        sb_append(&em, sb_ptr(&ra), ra.len);
        sb_append(&em, STR_PTR("' is disabled in current VM policy; enable editFiles or replaceWrite in VM settings to save "), STR_LEN("' is disabled in current VM policy; enable editFiles or replaceWrite in VM settings to save "));
        sb_append(&em, sb_ptr(&noun), noun.len);
        sb_append(&em, STR_PTR("s"), STR_LEN("s"));
        let rsn = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_assign(&rsn, STR_PTR("editFiles disabled"), STR_LEN("editFiles disabled"));
        res_capability2(out, &em, &rsn, started_at);
        return;
    };
    let key = StrBuf { bytes: [0u8; 65536], len: 0 };
    if has_key { tool_sb_trim(key_in, &key); };
    let raw_content = StrBuf { bytes: [0u8; 65536], len: 0 };
    if has_content { tool_sb_trim(content_in, &raw_content); };
    if key.len == 0 {
        let em = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_assign(&em, STR_PTR("parameter 'key' is required for action '"), STR_LEN("parameter 'key' is required for action '"));
        sb_append(&em, sb_ptr(&ra), ra.len);
        sb_append(&em, STR_PTR("'"), STR_LEN("'"));
        res_sa_error(out, sb_ptr(&em), em.len, started_at);
        return;
    };
    if raw_content.len == 0 {
        let em = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_assign(&em, STR_PTR("parameter 'content' (or 'memory') is required for action '"), STR_LEN("parameter 'content' (or 'memory') is required for action '"));
        sb_append(&em, sb_ptr(&ra), ra.len);
        sb_append(&em, STR_PTR("'"), STR_LEN("'"));
        res_sa_error(out, sb_ptr(&em), em.len, started_at);
        return;
    };
    let content = StrBuf { bytes: [0u8; 65536], len: 0 };
    let was_trunc: bool = false;
    truncate_chars(&raw_content, 1000, &content, &was_trunc);
    let scope: u64 = 0;
    if has_scope { scope = normalizeMemoryScope(sb_ptr(scope_text), scope_text.len); };
    let mem_file = StrBuf { bytes: [0u8; 65536], len: 0 };
    let label = StrBuf { bytes: [0u8; 65536], len: 0 };
    resolveMemoryFile(cwd, scope, &mem_file, &label);
    let doc: u64 = 0;
    loadWorkspaceNotes(&mem_file, &label, cwd, scope == 1, &doc);
    if doc == 0 { return; };
    let level = StrBuf { bytes: [0u8; 65536], len: 0 };
    normalizeNoteLevel(level_in, has_level, &level);
    let now: i64 = sa_time_unix_ms();
    let keys = ListBuf { bytes: [0u8; 131072], len: 0 };
    let contents = ListBuf { bytes: [0u8; 131072], len: 0 };
    let levels = ListBuf { bytes: [0u8; 131072], len: 0 };
    let upds = F64List { items: [0.0; 4096], len: 0 };
    notes_extract(doc, &keys, &contents, &levels, &upds);
    let existing: i64 = -1;
    let kv = StrBuf { bytes: [0u8; 65536], len: 0 };
    let ki: u64 = 0;
    while ki < lb_count(&keys) {
        let g1: bool = lb_at(&keys, ki, &kv);
        if tool_bytes_eq(sb_ptr(&kv), kv.len, sb_ptr(&key), key.len) { existing = ki as i64; break; };
        ki = ki + 1;
    }
    let nkeys = ListBuf { bytes: [0u8; 131072], len: 0 };
    let ncontents = ListBuf { bytes: [0u8; 131072], len: 0 };
    let nlevels = ListBuf { bytes: [0u8; 131072], len: 0 };
    let nupds = F64List { items: [0.0; 4096], len: 0 };
    if existing >= 0 {
        let ii: u64 = 0;
        while ii < lb_count(&keys) {
            if ii == existing as u64 {
                lb_append(&nkeys, sb_ptr(&key), key.len);
                lb_append(&ncontents, sb_ptr(&content), content.len);
                lb_append(&nlevels, sb_ptr(&level), level.len);
                if nupds.len < 4096 { nupds.items[nupds.len] = now as f64; nupds.len = nupds.len + 1; };
            } else {
                let g1: bool = lb_at(&keys, ii, &kv);
                lb_append(&nkeys, sb_ptr(&kv), kv.len);
                let g2: bool = lb_at(&contents, ii, &kv);
                lb_append(&ncontents, sb_ptr(&kv), kv.len);
                let g3: bool = lb_at(&levels, ii, &kv);
                lb_append(&nlevels, sb_ptr(&kv), kv.len);
                if nupds.len < 4096 { nupds.items[nupds.len] = upds.items[ii]; nupds.len = nupds.len + 1; };
            };
            ii = ii + 1;
        }
    } else {
        // copy, evicting the (weight, updated_at)-smallest when at cap
        let order = U64List { items: [0u64; 4096], len: 0 };
        let oi: u64 = 0;
        while oi < lb_count(&keys) && order.len < 4096 {
            order.items[order.len] = oi;
            order.len = order.len + 1;
            oi = oi + 1;
        }
        if lb_count(&keys) >= 100 {
            // stable insertion sort by (weight asc, updated asc)
            let ka = StrBuf { bytes: [0u8; 65536], len: 0 };
            let kb = StrBuf { bytes: [0u8; 65536], len: 0 };
            let x: u64 = 1;
            while x < order.len {
                let key_idx: u64 = order.items[x];
                let gk: bool = lb_at(&levels, key_idx, &ka);
                let wa: f64 = note_level_weight(&ka);
                let ua: f64 = upds.items[key_idx];
                let y: u64 = x;
                while y > 0 {
                    let g2: bool = lb_at(&levels, order.items[y - 1], &kb);
                    let wb: f64 = note_level_weight(&kb);
                    let ub: f64 = upds.items[order.items[y - 1]];
                    if wb < wa { break; };
                    if wb == wa && ub <= ua { break; };
                    order.items[y] = order.items[y - 1];
                    y = y - 1;
                }
                order.items[y] = key_idx;
                x = x + 1;
            }
        };
        let start: u64 = 0;
        if lb_count(&keys) >= 100 { start = 1; };
        let ii: u64 = start;
        while ii < order.len {
            let src: u64 = order.items[ii];
            let g1: bool = lb_at(&keys, src, &kv);
            lb_append(&nkeys, sb_ptr(&kv), kv.len);
            let g2: bool = lb_at(&contents, src, &kv);
            lb_append(&ncontents, sb_ptr(&kv), kv.len);
            let g3: bool = lb_at(&levels, src, &kv);
            lb_append(&nlevels, sb_ptr(&kv), kv.len);
            if nupds.len < 4096 { nupds.items[nupds.len] = upds.items[src]; nupds.len = nupds.len + 1; };
            ii = ii + 1;
        }
        lb_append(&nkeys, sb_ptr(&key), key.len);
        lb_append(&ncontents, sb_ptr(&content), content.len);
        lb_append(&nlevels, sb_ptr(&level), level.len);
        if nupds.len < 4096 { nupds.items[nupds.len] = now as f64; nupds.len = nupds.len + 1; };
    };
    notes_rebuild(doc, &nkeys, &ncontents, &nlevels, &nupds);
    jset_i64(doc, STR_PTR("updated_at"), STR_LEN("updated_at"), now);
    atomicSaveWorkspaceNotes(&mem_file, doc);
    let total: u64 = lb_count(&nkeys);
    let payload: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    if payload != 0 {
        jset_str(payload, STR_PTR("action"), STR_LEN("action"), sb_ptr(&ra), ra.len);
        jset_str(payload, STR_PTR("key"), STR_LEN("key"), sb_ptr(&key), key.len);
        jset_str(payload, STR_PTR("level"), STR_LEN("level"), sb_ptr(&level), level.len);
        if was_trunc { jset_bool(payload, STR_PTR("truncated"), STR_LEN("truncated"), true); } else { jset_bool(payload, STR_PTR("truncated"), STR_LEN("truncated"), false); };
        jset_f64(payload, STR_PTR("total_notes"), STR_LEN("total_notes"), total as f64);
        jset_f64(payload, STR_PTR("total_memories"), STR_LEN("total_memories"), total as f64);
        let msg = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_assign(&msg, STR_PTR("Saved "), STR_LEN("Saved "));
        sb_append(&msg, sb_ptr(&noun), noun.len);
        sb_append(&msg, STR_PTR(" for key '"), STR_LEN(" for key '"));
        sb_append(&msg, sb_ptr(&key), key.len);
        sb_append(&msg, STR_PTR("' ["), STR_LEN("' ["));
        sb_append(&msg, sb_ptr(&level), level.len);
        sb_append(&msg, STR_PTR("] in workspace memory."), STR_LEN("] in workspace memory."));
        jset_str(payload, STR_PTR("message"), STR_LEN("message"), sb_ptr(&msg), msg.len);
        let cjb = JsonBuf { bytes: [0u8; 262144], len: 0 };
        jdoc_to_jb(payload, &cjb);
        let pretty = JsonBuf { bytes: [0u8; 262144], len: 0 };
        json_pretty_into(jb_ptr(&cjb), cjb.len, &pretty);
        res_success(out, started_at);
        res_set_stdout(out, jb_ptr(&pretty), pretty.len);
        sa_json_free(payload);
    };
    if was_trunc {
        let em = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_append(&em, STR_PTR("["), STR_LEN("["));
        sb_append(&em, sb_ptr(&ra), ra.len);
        sb_append(&em, STR_PTR("] content truncated to 1000 characters."), STR_LEN("] content truncated to 1000 characters."));
        res_set_stderr(out, sb_ptr(&em), em.len);
    };
    let ev: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    let eo: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    if ev != 0 && eo != 0 {
        jset_i64(eo, STR_PTR("timestamp"), STR_LEN("timestamp"), now);
        if is_memory { jset_str(eo, STR_PTR("type"), STR_LEN("type"), STR_PTR("memory_saved"), STR_LEN("memory_saved")); } else { jset_str(eo, STR_PTR("type"), STR_LEN("type"), STR_PTR("note_saved"), STR_LEN("note_saved")); };
        jset_str(eo, STR_PTR("key"), STR_LEN("key"), sb_ptr(&key), key.len);
        jset_f64(eo, STR_PTR("total_notes"), STR_LEN("total_notes"), total as f64);
        jset_f64(eo, STR_PTR("total_memories"), STR_LEN("total_memories"), total as f64);
        let rp: i32 = sa_json_array_push_node(ev, eo);
        let ejb = JsonBuf { bytes: [0u8; 262144], len: 0 };
        jdoc_to_jb(ev, &ejb);
        res_set_events(out, jb_ptr(&ejb), ejb.len);
        let bfix10804: i32 = sa_json_free(ev);
    } else {
        if ev != 0 { sa_json_free(ev); };
    };
    sa_json_free(doc);
}

fn nativeSaveNote(key_in: &StrBuf, has_key: bool, content_in: &StrBuf, has_content: bool, level_in: &StrBuf, has_level: bool, policy_doc: u64, has_policy: bool, cwd: &StrBuf, started_at: f64, scope_text: &StrBuf, has_scope: bool, effective_action: &StrBuf, out: &SaVmRunResult) -> i32 {
    save_note_core(key_in, has_key, content_in, has_content, level_in, has_level, policy_doc, has_policy, cwd, started_at, scope_text, has_scope, effective_action, out);
    return 0;
}

fn read_notes_core(key_in: &StrBuf, has_key: bool, max_tokens_in: f64, has_max_tokens: bool, remaining_in: f64, has_remaining: bool, policy_doc: u64, has_policy: bool, cwd: &StrBuf, started_at: f64, pg_doc: u64, scope_text: &StrBuf, has_scope: bool, effective_action: &StrBuf, out: &SaVmRunResult) -> void {
    let is_memory: bool = tool_sb_contains(effective_action, STR_PTR("memory"), STR_LEN("memory"));
    let ra = StrBuf { bytes: [0u8; 65536], len: 0 };
    if tool_bytes_eq(sb_ptr(effective_action), effective_action.len, STR_PTR("read_notes"), STR_LEN("read_notes")) || tool_bytes_eq(sb_ptr(effective_action), effective_action.len, STR_PTR("read_note"), STR_LEN("read_note")) || tool_bytes_eq(sb_ptr(effective_action), effective_action.len, STR_PTR("list_notes"), STR_LEN("list_notes")) || tool_bytes_eq(sb_ptr(effective_action), effective_action.len, STR_PTR("search_notes"), STR_LEN("search_notes")) || tool_bytes_eq(sb_ptr(effective_action), effective_action.len, STR_PTR("search_note"), STR_LEN("search_note")) {
        sb_copy(&ra, effective_action);
    } else if effective_action.len > 0 {
        sb_copy(&ra, effective_action);
    } else {
        sb_assign(&ra, STR_PTR("read_memory"), STR_LEN("read_memory"));
    };
    let noun = StrBuf { bytes: [0u8; 65536], len: 0 };
    if is_memory { sb_assign(&noun, STR_PTR("memory"), STR_LEN("memory")); } else { sb_assign(&noun, STR_PTR("note"), STR_LEN("note")); };
    let norm = NormalizedSaVmPolicy { engine: 0, fs: NormalizedFs { entries: FsEntryList { items: [SaVmFsEntry { path: [0u8; 1024], path_len: 0, access: 0 }; 128], len: 0 }, read: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, write: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, transfer: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, delete: 0, backupDir: [0u8; 1024], backupDir_len: 0, backupDir_has: false }, http_allow: HttpRuleList { items: [SaVmHttpAllowRule { host: [0u8; 512], host_len: 0, methods: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_methods: false, paths: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_paths: false }; 128], len: 0 }, env_allow: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, process: NormalizedProcess { spawn: false, exec: ExecRuleList { items: [SaVmProcessExecRule { path: [0u8; 4096], path_len: 0, args: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_args: false }; 128], len: 0 }, bunProfiles: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_bunProfiles: false, bun_enabled: false, bun_allowedSubcommands: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_bun: false }, execution_javascript: false, execution_python: false, tools: NormalizedTools { replaceRead: false, replaceWrite: false, replaceApplyPatch: false, replaceExec: false, readFiles: false, editFiles: false, applyPatch: false, fastSearch: false, clearToolHistory: false, findReferences: false, renameSymbol: false, fileOutline: false, moveWithImports: false, findDefinition: false, extractToFile: false, addImport: false, getDiagnostics: false, organizeImports: false, analyzeScope: false, codeGraph: false }, contextSavings: SaVmContextSavingsConfig { locateBeforeRead: false, maxReadFileBytes: 0, maxReadFileBytes_has: false, grepCircuitBreaker: false, grepMaxResults: 0, grepMaxResults_has: false, grepMaxTokens: 0, grepMaxTokens_has: false, slimRunnerOutput: false, parallelBudget: false, parallelMaxTotalBytes: 0, parallelMaxTotalBytes_has: false, parallelMaxReadFiles: 0, parallelMaxReadFiles_has: false, parallelDeduplication: false, tieredSkillInjection: false, foldWaterfallEvents: false, foldHistoryReadSummaries: false, historyReadFoldTurns: 0, historyReadFoldTurns_has: false }, contextSavings_has: false };
    normalize_policy(policy_doc, cwd, &norm);
    let allow: bool = !has_policy || norm.tools.readFiles || norm.tools.replaceRead;
    if !allow {
        let em = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_assign(&em, STR_PTR("action '"), STR_LEN("action '"));
        sb_append(&em, sb_ptr(&ra), ra.len);
        sb_append(&em, STR_PTR("' is disabled in current VM policy; enable readFiles or replaceRead in VM settings to read "), STR_LEN("' is disabled in current VM policy; enable readFiles or replaceRead in VM settings to read "));
        sb_append(&em, sb_ptr(&noun), noun.len);
        sb_append(&em, STR_PTR("s"), STR_LEN("s"));
        let rsn = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_assign(&rsn, STR_PTR("readFiles disabled"), STR_LEN("readFiles disabled"));
        res_capability2(out, &em, &rsn, started_at);
        return;
    };
    let scope: u64 = 0;
    if has_scope { scope = normalizeMemoryScope(sb_ptr(scope_text), scope_text.len); };
    let mem_file = StrBuf { bytes: [0u8; 65536], len: 0 };
    let label = StrBuf { bytes: [0u8; 65536], len: 0 };
    resolveMemoryFile(cwd, scope, &mem_file, &label);
    let doc: u64 = 0;
    loadWorkspaceNotes(&mem_file, &label, cwd, scope == 1, &doc);
    if doc == 0 { return; };
    let keys = ListBuf { bytes: [0u8; 131072], len: 0 };
    let contents = ListBuf { bytes: [0u8; 131072], len: 0 };
    let levels = ListBuf { bytes: [0u8; 131072], len: 0 };
    let upds = F64List { items: [0.0; 4096], len: 0 };
    notes_extract(doc, &keys, &contents, &levels, &upds);
    let query = StrBuf { bytes: [0u8; 65536], len: 0 };
    if has_key { tool_sb_trim(key_in, &query); };
    if query.len > 0 {
        let found_idx: i64 = -1;
        let kv = StrBuf { bytes: [0u8; 65536], len: 0 };
        let ki: u64 = 0;
        while ki < lb_count(&keys) {
            let g1: bool = lb_at(&keys, ki, &kv);
            if tool_bytes_eq(sb_ptr(&kv), kv.len, sb_ptr(&query), query.len) { found_idx = ki as i64; break; };
            ki = ki + 1;
        }
        let payload: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
        if payload != 0 {
            jset_str(payload, STR_PTR("action"), STR_LEN("action"), sb_ptr(&ra), ra.len);
            jset_str(payload, STR_PTR("key"), STR_LEN("key"), sb_ptr(&query), query.len);
            if found_idx >= 0 {
                jset_bool(payload, STR_PTR("found"), STR_LEN("found"), true);
                let fi: u64 = found_idx as u64;
                let no: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
                if no != 0 {
                    let g1: bool = lb_at(&keys, fi, &kv);
                    jset_str(no, STR_PTR("key"), STR_LEN("key"), sb_ptr(&kv), kv.len);
                    let g2: bool = lb_at(&contents, fi, &kv);
                    jset_str(no, STR_PTR("content"), STR_LEN("content"), sb_ptr(&kv), kv.len);
                    let g3: bool = lb_at(&levels, fi, &kv);
                    jset_str(no, STR_PTR("level"), STR_LEN("level"), sb_ptr(&kv), kv.len);
                    jset_f64(no, STR_PTR("updated_at"), STR_LEN("updated_at"), upds.items[fi]);
                    // note and memory carry the same object: serialize once,
                    // parse twice
                    let hold: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
                    if hold != 0 {
                        let rp: i32 = sa_json_array_push_node(hold, no);
                        let hjb = JsonBuf { bytes: [0u8; 262144], len: 0 };
                        jdoc_to_jb(hold, &hjb);
                        let inner = JsonBuf { bytes: [0u8; 262144], len: 0 };
                        let po10896_0: ptr = PTR_NULL();
                        PTR_BYTE_ADD(po10896_0, jb_ptr(&hjb), 1);
                        if hjb.len >= 2 { jb_append(&inner, po10896_0, hjb.len - 2); };
                        let n1: u64 = jdoc_of_jb(&inner);
                        let n2: u64 = jdoc_of_jb(&inner);
                        if n1 != 0 { jset_node(payload, STR_PTR("note"), STR_LEN("note"), n1); };
                        if n2 != 0 { jset_node(payload, STR_PTR("memory"), STR_LEN("memory"), n2); };
                        sa_json_free(hold);
                    };
                };
            } else {
                let needle = StrBuf { bytes: [0u8; 65536], len: 0 };
                sb_to_lower(&query, &needle);
                let marr: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
                let mcount: u64 = 0;
                if marr != 0 {
                    let mi: u64 = 0;
                    while mi < lb_count(&keys) {
                        let g1: bool = lb_at(&keys, mi, &kv);
                        let kl = StrBuf { bytes: [0u8; 65536], len: 0 };
                        sb_to_lower(&kv, &kl);
                        let hit: bool = tool_sb_contains(&kl, sb_ptr(&needle), needle.len);
                        if !hit {
                            let g2: bool = lb_at(&contents, mi, &kv);
                            let cl = StrBuf { bytes: [0u8; 65536], len: 0 };
                            sb_to_lower(&kv, &cl);
                            hit = tool_sb_contains(&cl, sb_ptr(&needle), needle.len);
                        };
                        if hit {
                            let no: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
                            if no != 0 {
                                let g3: bool = lb_at(&keys, mi, &kv);
                                jset_str(no, STR_PTR("key"), STR_LEN("key"), sb_ptr(&kv), kv.len);
                                let g4: bool = lb_at(&contents, mi, &kv);
                                jset_str(no, STR_PTR("content"), STR_LEN("content"), sb_ptr(&kv), kv.len);
                                let g5: bool = lb_at(&levels, mi, &kv);
                                jset_str(no, STR_PTR("level"), STR_LEN("level"), sb_ptr(&kv), kv.len);
                                jset_f64(no, STR_PTR("updated_at"), STR_LEN("updated_at"), upds.items[mi]);
                                let rp: i32 = sa_json_array_push_node(marr, no);
                                mcount = mcount + 1;
                            };
                        };
                        mi = mi + 1;
                    }
                };
                if mcount > 0 { jset_bool(payload, STR_PTR("found"), STR_LEN("found"), true); } else { jset_bool(payload, STR_PTR("found"), STR_LEN("found"), false); };
                jset_null(payload, STR_PTR("note"), STR_LEN("note"));
                jset_null(payload, STR_PTR("memory"), STR_LEN("memory"));
                if marr != 0 { jset_node(payload, STR_PTR("matches"), STR_LEN("matches"), marr); };
                jset_f64(payload, STR_PTR("match_count"), STR_LEN("match_count"), mcount as f64);
                if mcount == 0 {
                    let hint = StrBuf { bytes: [0u8; 65536], len: 0 };
                    sb_assign(&hint, STR_PTR("No "), STR_LEN("No "));
                    sb_append(&hint, sb_ptr(&noun), noun.len);
                    sb_append(&hint, STR_PTR(" matches; try "), STR_LEN(" matches; try "));
                    sb_append(&hint, sb_ptr(&ra), ra.len);
                    sb_append(&hint, STR_PTR(" without key to list all."), STR_LEN(" without key to list all."));
                    jset_str(payload, STR_PTR("hint"), STR_LEN("hint"), sb_ptr(&hint), hint.len);
                };
            };
            let cjb = JsonBuf { bytes: [0u8; 262144], len: 0 };
            jdoc_to_jb(payload, &cjb);
            let pretty = JsonBuf { bytes: [0u8; 262144], len: 0 };
            json_pretty_into(jb_ptr(&cjb), cjb.len, &pretty);
            res_success(out, started_at);
            res_set_stdout(out, jb_ptr(&pretty), pretty.len);
            sa_json_free(payload);
        };
        sa_json_free(doc);
        return;
    };
    // list mode
    let budget: f64 = 2000.0;
    if has_max_tokens && max_tokens_in > 0.0 {
        budget = max_tokens_in;
        let bi: i64 = budget as i64;
        budget = bi as f64;
        if budget > 8000.0 { budget = 8000.0; };
    };
    if has_remaining && remaining_in > 0.0 {
        let safe: f64 = remaining_in - 1000.0;
        let si: i64 = safe as i64;
        safe = si as f64;
        if safe < 200.0 { safe = 200.0; };
        if safe < budget { budget = safe; };
    };
    // sort: weight desc, updated desc (stable)
    let order = U64List { items: [0u64; 4096], len: 0 };
    let oi: u64 = 0;
    while oi < lb_count(&keys) && order.len < 4096 {
        order.items[order.len] = oi;
        order.len = order.len + 1;
        oi = oi + 1;
    }
    let ka = StrBuf { bytes: [0u8; 65536], len: 0 };
    let kb = StrBuf { bytes: [0u8; 65536], len: 0 };
    let x: u64 = 1;
    while x < order.len {
        let key_idx: u64 = order.items[x];
        let gk: bool = lb_at(&levels, key_idx, &ka);
        let wa: f64 = note_level_weight(&ka);
        let ua: f64 = upds.items[key_idx];
        let y: u64 = x;
        while y > 0 {
            let g2: bool = lb_at(&levels, order.items[y - 1], &kb);
            let wb: f64 = note_level_weight(&kb);
            let ub: f64 = upds.items[order.items[y - 1]];
            if wb > wa { break; };
            if wb == wa && ub >= ua { break; };
            order.items[y] = order.items[y - 1];
            y = y - 1;
        }
        order.items[y] = key_idx;
        x = x + 1;
    }
    let total_sorted: u64 = order.len;
    let popts = PaginationOpts { default_size: total_sorted as f64, max_size: 30.0, legacy_limit: total_sorted as f64, has_legacy_limit: true };
    let pg = ResolvedPagination { page: 0.0, page_size: 0.0, offset: 0.0, paginated: false, exact_total: false, count_cap: 0.0 };
    resolvePagination(pg_doc, &popts, &pg);
    let view = U64List { items: [0u64; 4096], len: 0 };
    let tpages: u64 = 0;
    if pg.paginated {
        let ps: u64 = pg.page_size as u64;
        if ps == 0 { ps = 1; };
        if pg.exact_total {
            if total_sorted > 0 { tpages = (total_sorted + ps - 1) / ps; };
        } else if total_sorted >= pg.count_cap as u64 {
            tpages = pg.page as u64;
            if (pg.offset as u64) + ps < total_sorted { tpages = tpages + 1; };
        } else if total_sorted > 0 {
            tpages = (total_sorted + ps - 1) / ps;
        };
        let off: u64 = pg.offset as u64;
        let end: u64 = off + ps;
        if end > total_sorted { end = total_sorted; };
        let vi: u64 = off;
        while vi < end && view.len < 4096 {
            view.items[view.len] = order.items[vi];
            view.len = view.len + 1;
            vi = vi + 1;
        }
    } else {
        let vi: u64 = 0;
        while vi < total_sorted && view.len < 4096 {
            view.items[view.len] = order.items[vi];
            view.len = view.len + 1;
            vi = vi + 1;
        }
    };
    // payload with token truncation over the view
    let view_count: u64 = view.len;
    let truncated: bool = false;
    let payload: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    if payload == 0 { sa_json_free(doc); return; };
    let ws = StrBuf { bytes: [0u8; 65536], len: 0 };
    if !jget_str(doc, STR_PTR("workspace"), STR_LEN("workspace"), &ws) { ws.len = 0; };
    let have_ws: bool = node_nonnull(doc, STR_PTR("workspace"), STR_LEN("workspace")) != 0;
    let assembled: bool = false;
    while !assembled {
        // rebuild payload fields that change under truncation
        jset_str(payload, STR_PTR("action"), STR_LEN("action"), sb_ptr(&ra), ra.len);
        if have_ws {
            jset_str(payload, STR_PTR("workspace"), STR_LEN("workspace"), sb_ptr(&ws), ws.len);
        } else {
            jset_null(payload, STR_PTR("workspace"), STR_LEN("workspace"));
        };
        jset_f64(payload, STR_PTR("total_notes"), STR_LEN("total_notes"), total_sorted as f64);
        jset_f64(payload, STR_PTR("total_memories"), STR_LEN("total_memories"), total_sorted as f64);
        jset_f64(payload, STR_PTR("total"), STR_LEN("total"), total_sorted as f64);
        if pg.paginated {
            jset_f64(payload, STR_PTR("page"), STR_LEN("page"), pg.page);
            jset_f64(payload, STR_PTR("page_size"), STR_LEN("page_size"), pg.page_size);
            jset_f64(payload, STR_PTR("total_pages"), STR_LEN("total_pages"), tpages as f64);
            let hn: bool = (pg.offset as u64) + (pg.page_size as u64) < total_sorted;
            if hn { jset_bool(payload, STR_PTR("has_next"), STR_LEN("has_next"), true); } else { jset_bool(payload, STR_PTR("has_next"), STR_LEN("has_next"), false); };
            if pg.offset > 0.0 { jset_bool(payload, STR_PTR("has_prev"), STR_LEN("has_prev"), true); } else { jset_bool(payload, STR_PTR("has_prev"), STR_LEN("has_prev"), false); };
            jset_f64(payload, STR_PTR("returned"), STR_LEN("returned"), view_count as f64);
        };
        let arr: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
        let kv = StrBuf { bytes: [0u8; 65536], len: 0 };
        if arr != 0 {
            let vi: u64 = 0;
            while vi < view_count {
                let src: u64 = view.items[vi];
                let no: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
                if no != 0 {
                    let g1: bool = lb_at(&keys, src, &kv);
                    jset_str(no, STR_PTR("key"), STR_LEN("key"), sb_ptr(&kv), kv.len);
                    let g2: bool = lb_at(&contents, src, &kv);
                    jset_str(no, STR_PTR("content"), STR_LEN("content"), sb_ptr(&kv), kv.len);
                    let g3: bool = lb_at(&levels, src, &kv);
                    jset_str(no, STR_PTR("level"), STR_LEN("level"), sb_ptr(&kv), kv.len);
                    jset_f64(no, STR_PTR("updated_at"), STR_LEN("updated_at"), upds.items[src]);
                    let rp: i32 = sa_json_array_push_node(arr, no);
                };
                vi = vi + 1;
            }
            // notes and memories share the same array value: serialize once,
            // parse twice
            let hold: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
            if hold != 0 {
                let rp: i32 = sa_json_array_push_node(hold, arr);
                let hjb = JsonBuf { bytes: [0u8; 262144], len: 0 };
                jdoc_to_jb(hold, &hjb);
                let inner = JsonBuf { bytes: [0u8; 262144], len: 0 };
                let po11099_0: ptr = PTR_NULL();
                PTR_BYTE_ADD(po11099_0, jb_ptr(&hjb), 1);
                if hjb.len >= 2 { jb_append(&inner, po11099_0, hjb.len - 2); };
                let n1: u64 = jdoc_of_jb(&inner);
                let n2: u64 = jdoc_of_jb(&inner);
                if n1 != 0 { jset_node(payload, STR_PTR("notes"), STR_LEN("notes"), n1); };
                if n2 != 0 { jset_node(payload, STR_PTR("memories"), STR_LEN("memories"), n2); };
                sa_json_free(hold);
            };
        };
        if truncated {
            if !pg.paginated {
                jset_f64(payload, STR_PTR("returned"), STR_LEN("returned"), view_count as f64);
            };
            jset_bool(payload, STR_PTR("truncated"), STR_LEN("truncated"), true);
        };
        let cjb = JsonBuf { bytes: [0u8; 262144], len: 0 };
        jdoc_to_jb(payload, &cjb);
        let pretty = JsonBuf { bytes: [0u8; 262144], len: 0 };
        json_pretty_into(jb_ptr(&cjb), cjb.len, &pretty);
        let est_buf = StrBuf { bytes: [0u8; 65536], len: 0 };
        let take: u64 = pretty.len;
        if take > 65536 { take = 65536; };
        sb_append(&est_buf, jb_ptr(&pretty), take);
        if estimateTokenCount(&est_buf) > budget && view_count > 1 {
            view_count = view_count - 1;
            truncated = true;
            continue;
        };
        res_success(out, started_at);
        res_set_stdout(out, jb_ptr(&pretty), pretty.len);
        assembled = true;
    }
    if truncated {
        let em = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_append(&em, STR_PTR("["), STR_LEN("["));
        sb_append(&em, sb_ptr(&ra), ra.len);
        sb_append(&em, STR_PTR("] output truncated to max_tokens="), STR_LEN("] output truncated to max_tokens="));
        sb_append_f64(budget, &em);
        sb_append(&em, STR_PTR("."), STR_LEN("."));
        res_set_stderr(out, sb_ptr(&em), em.len);
    };
    sa_json_free(payload);
    sa_json_free(doc);
}

fn nativeReadNotes(key_in: &StrBuf, has_key: bool, max_tokens_in: f64, has_max_tokens: bool, remaining_in: f64, has_remaining: bool, policy_doc: u64, has_policy: bool, cwd: &StrBuf, started_at: f64, pg_doc: u64, scope_text: &StrBuf, has_scope: bool, effective_action: &StrBuf, out: &SaVmRunResult) -> i32 {
    read_notes_core(key_in, has_key, max_tokens_in, has_max_tokens, remaining_in, has_remaining, policy_doc, has_policy, cwd, started_at, pg_doc, scope_text, has_scope, effective_action, out);
    return 0;
}

fn delete_note_core(key_in: &StrBuf, has_key: bool, all: bool, policy_doc: u64, has_policy: bool, cwd: &StrBuf, started_at: f64, scope_text: &StrBuf, has_scope: bool, effective_action: &StrBuf, out: &SaVmRunResult) -> void {
    let is_memory: bool = tool_sb_contains(effective_action, STR_PTR("memory"), STR_LEN("memory"));
    let ra = StrBuf { bytes: [0u8; 65536], len: 0 };
    if tool_bytes_eq(sb_ptr(effective_action), effective_action.len, STR_PTR("delete_note"), STR_LEN("delete_note")) || tool_bytes_eq(sb_ptr(effective_action), effective_action.len, STR_PTR("remove_note"), STR_LEN("remove_note")) || tool_bytes_eq(sb_ptr(effective_action), effective_action.len, STR_PTR("clear_notes"), STR_LEN("clear_notes")) {
        sb_copy(&ra, effective_action);
    } else if effective_action.len > 0 {
        sb_copy(&ra, effective_action);
    } else {
        sb_assign(&ra, STR_PTR("delete_memory"), STR_LEN("delete_memory"));
    };
    let noun_plural = StrBuf { bytes: [0u8; 65536], len: 0 };
    let noun_single = StrBuf { bytes: [0u8; 65536], len: 0 };
    if is_memory {
        sb_assign(&noun_plural, STR_PTR("memories"), STR_LEN("memories"));
        sb_assign(&noun_single, STR_PTR("Memory"), STR_LEN("Memory"));
    } else {
        sb_assign(&noun_plural, STR_PTR("notes"), STR_LEN("notes"));
        sb_assign(&noun_single, STR_PTR("Note"), STR_LEN("Note"));
    };
    let norm = NormalizedSaVmPolicy { engine: 0, fs: NormalizedFs { entries: FsEntryList { items: [SaVmFsEntry { path: [0u8; 1024], path_len: 0, access: 0 }; 128], len: 0 }, read: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, write: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, transfer: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, delete: 0, backupDir: [0u8; 1024], backupDir_len: 0, backupDir_has: false }, http_allow: HttpRuleList { items: [SaVmHttpAllowRule { host: [0u8; 512], host_len: 0, methods: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_methods: false, paths: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_paths: false }; 128], len: 0 }, env_allow: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, process: NormalizedProcess { spawn: false, exec: ExecRuleList { items: [SaVmProcessExecRule { path: [0u8; 4096], path_len: 0, args: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_args: false }; 128], len: 0 }, bunProfiles: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_bunProfiles: false, bun_enabled: false, bun_allowedSubcommands: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_bun: false }, execution_javascript: false, execution_python: false, tools: NormalizedTools { replaceRead: false, replaceWrite: false, replaceApplyPatch: false, replaceExec: false, readFiles: false, editFiles: false, applyPatch: false, fastSearch: false, clearToolHistory: false, findReferences: false, renameSymbol: false, fileOutline: false, moveWithImports: false, findDefinition: false, extractToFile: false, addImport: false, getDiagnostics: false, organizeImports: false, analyzeScope: false, codeGraph: false }, contextSavings: SaVmContextSavingsConfig { locateBeforeRead: false, maxReadFileBytes: 0, maxReadFileBytes_has: false, gre