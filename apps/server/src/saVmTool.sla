            tool_sb_append_u64(total_results, &em2);
            sb_append(&em2, STR_PTR(" files"), STR_LEN(" files"));
        };
        if ctx.truncated {
            if em2.len > 0 { sb_append(&em2, STR_PTR(" "), STR_LEN(" ")); };
            sb_append(&em2, STR_PTR("[find_files] results capped at count_cap="), STR_LEN("[find_files] results capped at count_cap="));
            tool_sb_append_u64(scan_cap, &em2);
            sb_append(&em2, STR_PTR("; narrow pattern/dir or raise count_cap for exact total_pages"), STR_LEN("; narrow pattern/dir or raise count_cap for exact total_pages"));
        };
        res_success(out, started_at);
        res_set_stdout(out, jb_ptr(&ob), ob.len);
        if em2.len > 0 { res_set_stderr(out, sb_ptr(&em2), em2.len); };
        return 0;
    };
    let ob2 = StrBuf { bytes: [0u8; 65536], len: 0 };
    let e2 = StrBuf { bytes: [0u8; 65536], len: 0 };
    let li: u64 = 0;
    while li < total_results {
        let got: bool = lb_at(&ctx.results, li, &e2);
        if got {
            if li > 0 { sb_push_byte(&ob2, 10); };
            sb_append(&ob2, sb_ptr(&e2), e2.len);
        };
        li = li + 1;
    }
    res_success(out, started_at);
    res_set_stdout(out, sb_ptr(&ob2), ob2.len);
    if ctx.timed_out {
        let em3 = StrBuf { bytes: [0u8; 65536], len: 0 };
