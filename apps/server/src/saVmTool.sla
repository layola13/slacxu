        jdoc_to_jb(ev, &ejb);
        res_set_events(out, jb_ptr(&ejb), ejb.len);
        let bfix14870: i32 = sa_json_free(ev);
    } else {
        if ev != 0 { sa_json_free(ev); };
    };
    return 0;
}

// ---- git_status / git_diff / git_log (read-only, argv allowlist, no shell) ----
fn resolveGitMaxBytes(odoc: u64, default_bytes: f64) -> f64 {
    let mb: f64 = 0.0;
    let mb_has: bool = false;
    if odoc != 0 { read_opt_num(odoc, STR_PTR("max_bytes"), STR_LEN("max_bytes"), STR_PTR(""), 0, &mb, &mb_has); };
    if mb_has && mb > 0.0 {
        let r: f64 = mb;
        if r < 512.0 { r = 512.0; };
        if r > 524288.0 { r = 524288.0; };
        return (r as i64) as f64;
    };
    let mt: f64 = 0.0;
    let mt_has: bool = false;
    if odoc != 0 {
        read_opt_num(odoc, STR_PTR("max_tokens"), STR_LEN("max_tokens"), STR_PTR(""), 0, &mt, &mt_has);
        if !mt_has || mt <= 0.0 { read_opt_num(odoc, STR_PTR("max_token"), STR_LEN("max_token"), STR_PTR(""), 0, &mt, &mt_has); };
        if !mt_has || mt <= 0.0 { read_opt_num(odoc, STR_PTR("maxtoken"), STR_LEN("maxtoken"), STR_PTR(""), 0, &mt, &mt_has); };
        if mt_has && mt <= 0.0 { mt_has = false; };
    };
    let rt: f64 = 0.0;
    let rt_has: bool = false;
    if odoc != 0 {
        read_opt_num(odoc, STR_PTR("remaining_tokens"), STR_LEN("remaining_tokens"), STR_PTR(""), 0, &rt, &rt_has);
        if !rt_has || rt <= 0.0 { read_opt_num(odoc, STR_PTR("tokens_remaining"), STR_LEN("tokens_remaining"), STR_PTR(""), 0, &rt, &rt_has); };
        if !rt_has || rt <= 0.0 { read_opt_num(odoc, STR_PTR("tokens_left"), STR_LEN("tokens_left"), STR_PTR(""), 0, &rt, &rt_has); };
        if rt_has && rt <= 0.0 { rt_has = false; };
    };
    let budget: f64 = default_bytes;
    if mt_has { budget = mt * 4.0; };
    if rt_has {
        let alt: f64 = (rt - 3000.0) * 4.0;
        if alt < 512.0 { alt = 512.0; };
        if alt < budget { budget = alt; };
    };
    if budget <= 0.0 { budget = default_bytes; };
    let r2: f64 = budget;
    if r2 < 512.0 { r2 = 512.0; };
    if r2 > 524288.0 { r2 = 524288.0; };
    return (r2 as i64) as f64;
}

fn findGitRepoRoot(start_abs: &StrBuf, workspace_root: &StrBuf, out: &StrBuf) -> bool {
    let cur = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_copy(&cur, start_abs);
    let md: u64 = sa_fs_metadata(sb_ptr(&cur), cur.len);
    if md != 0 {
        if sa_fs_metadata_is_file(md) == 1 {
            let d = StrBuf { bytes: [0u8; 65536], len: 0 };
            tool_path_dirname(&cur, &d);
            sb_copy(&cur, &d);
        };
        let frc: i32 = sa_std_fs_metadata_free(md);
    };
    let bound = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_to_lower(workspace_root, &bound);
    let bound_slash = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_copy(&bound_slash, &bound);
    sb_append(&bound_slash, STR_PTR("/"), STR_LEN("/"));
    let iter: u64 = 0;
    while iter < 64 {
        iter = iter + 1;
        let dotgit = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_copy(&dotgit, &cur);
        if dotgit.len > 0 && dotgit.bytes[dotgit.len - 1] == 47 {
            sb_append(&dotgit, STR_PTR(".git"), STR_LEN(".git"));
        } else {
            sb_append(&dotgit, STR_PTR("/.git"), STR_LEN("/.git"));
        };
        if fs_exists_sb(&dotgit) {
            sb_copy(out, &cur);
            return true;
        };
        let norm_cur = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_to_lower(&cur, &norm_cur);
        let parent = StrBuf { bytes: [0u8; 65536], len: 0 };
        tool_path_dirname(&cur, &parent);
        if tool_bytes_eq(sb_ptr(&parent), parent.len, sb_ptr(&cur), cur.len) { return false; };
        let norm_parent = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_to_lower(&parent, &norm_parent);
        let cur_inside: bool = tool_bytes_eq(sb_ptr(&norm_cur), norm_cur.len, sb_ptr(&bound), bound.len) || sb_starts(&norm_cur, sb_ptr(&bound_slash), bound_slash.len);
        let parent_inside: bool = tool_bytes_eq(sb_ptr(&norm_parent), norm_parent.len, sb_ptr(&bound), bound.len) || sb_starts(&norm_parent, sb_ptr(&bound_slash), bound_slash.len);
        if cur_inside && !parent_inside { return false; };
        if tool_bytes_eq(sb_ptr(&norm_cur), norm_cur.len, sb_ptr(&bound), bound.len) { return false; };
        sb_copy(&cur, &parent);
    }
    return false;
}

struct GitBigBuf {
    bytes: [u8; 524288],
    len: u64,
}

fn gb_ptr(g: &GitBigBuf) -> ptr { let p: ptr = PTR_NULL(); PTR_BYTE_ADD(p, &g.bytes, 0); return p; }

fn gb_append(g: &GitBigBuf, p: ptr, n: u64) -> void {
    let i: u64 = 0;
    while i < n {
        if g.len >= 524288 { break; };
        g.bytes[g.len] = byte_at(p, i);
        g.len = g.len + 1;
        i = i + 1;
    }
}

struct GitSpawnResult {
    status: u64,
    has_status: bool,
    stdout: GitBigBuf,
    stderr: StrBuf,
    unavailable: bool,
    timedOut: bool,
}

struct GitArgvArr {
    slots: [u64; 40],
}

// No git_argv_set helper: PROCESS_ARGV_SET_PTR must expand in the function
// that owns the GitArgvArr local. Expanded inside a helper whose array
// arrives via a parameter, the macro's slot stores segfault under the
// current SAB codegen (compiler-shape defect D3; see
// _defects/FIX_TOOL_D1D2.md and _defects/probes/d3_argv_set_via_ref.sla).
// git_argv_ptr below is unaffected: its PTR_BYTE_ADD address computation
// through a reference parameter produces the correct base (proven).

fn git_argv_ptr(a: &GitArgvArr) -> ptr { let p: ptr = PTR_NULL(); PTR_BYTE_ADD(p, &a.slots, 0); return p; }

// TS execGitSync: spawnSync("git", argv, { cwd, timeout, maxBuffer: 32 MiB }).
// Landed on sa_std capture processes: run_cwd + try_wait poll (for the
// timeout kill) + post-exit drain. The runtime drains the capture pipes at
// process exit; outputs above the OS pipe capacity on a still-running child
// are the std exec_capture model's own constraint (registered in FIX).
fn execGitSync(repo_root: &StrBuf, argv: &ByteList, timeout_ms: f64, out: &GitSpawnResult) -> void {
    out.status = 0;
    out.has_status = false;
    out.stdout.len = 0;
    out.stderr.len = 0;
    out.unavailable = false;
    out.timedOut = false;
    let a = GitArgvArr { slots: [0u64; 40] };
    PROCESS_ARGV_SET_PTR(&a.slots, 0, STR_PTR("git"), STR_LEN("git"));
    let base: ptr = bl_ptr(argv);
    let argc: u64 = bl_count(argv);
    let pos: u64 = 0;
    let idx: u64 = 0;
    while idx < argc && idx < 19 {
        let end: u64 = pos;
        while end < argv.len && byte_at(base, end) != 10 { end = end + 1; }
        let pb15076: ptr = PTR_NULL();
        PTR_BYTE_ADD(pb15076, base, pos);
        PROCESS_ARGV_SET_PTR(&a.slots, idx + 1, pb15076, end - pos);
        pos = end + 1;
        idx = idx + 1;
    }
    let proc: u64 = 0;
    let rc: i32 = sa_std_process_run_cwd(git_argv_ptr(&a), idx + 1, sb_ptr(repo_root), repo_root.len, &proc);
    if rc != 0 || proc == 0 {
        out.unavailable = true;
        sb_assign(&out.stderr, STR_PTR("git binary not found; install git to use git_status/git_diff/git_log"), STR_LEN("git binary not found; install git to use git_status/git_diff/git_log"));
        return;
    };
    let started: f64 = now_ms();
    let ready: u64 = 0;
    let code: u64 = 0;
    let timed_out: bool = false;
    while true {
        let trc: i32 = sa_std_process_try_wait(proc, &ready, &code);
        if trc != 0 {
            let wrc: i32 = sa_std_process_wait(proc, &code);
            break;
        };
        if ready == 1 { break; };
        if now_ms() - started > timeout_ms { timed_out = true; break; };
        let src: i32 = sa_time_sleep_ms(5);
    }
    if timed_out {
        let krc: i32 = sa_std_process_kill(proc);
        let wrc: i32 = sa_std_process_wait(proc, &code);
        let crc: i32 = sa_std_process_close(proc);
        out.timedOut = true;
        let tv = StrBuf { bytes: [0u8; 65536], len: 0 };
        fmt_f64_sb(timeout_ms, &tv);
        sb_assign(&out.stderr, STR_PTR("git command timed out after "), STR_LEN("git command timed out after "));
        sb_append(&out.stderr, sb_ptr(&tv), tv.len);
        sb_append(&out.stderr, STR_PTR("ms"), STR_LEN("ms"));
        return;
    };
    let chunk = [0u8; 8192];
    let cp: ptr = PTR_NULL();
    PTR_BYTE_ADD(cp, &chunk, 0);
    let total_out: u64 = 0;
    while true {
        let n: u64 = 0;
        let rrc: i32 = sa_std_process_read_stdout(proc, cp, 8192, &n);
        if n == 0 { break; };
        total_out = total_out + n;
        gb_append(&out.stdout, cp, n);
    }
    let total_err: u64 = 0;
    while true {
        let n: u64 = 0;
        let rrc: i32 = sa_std_process_read_stderr(proc, cp, 8192, &n);
        if n == 0 { break; };
        total_err = total_err + n;
        if out.stderr.len < 65536 {
            let take: u64 = n;
            if out.stderr.len + take > 65536 { take = 65536 - out.stderr.len; };
            sb_append(&out.stderr, cp, take);
        };
    }
    let crc: i32 = sa_std_process_close(proc);
    if total_out > out.stdout.len || total_err > 65536 {
        out.has_status = true;
        out.status = 0;
        sb_assign(&out.stderr, STR_PTR("warning: git output exceeded 32MB buffer; output truncated to buffer size"), STR_LEN("warning: git output exceeded 32MB buffer; output truncated to buffer size"));
        return;
    };
    out.has_status = true;
    out.status = code;
}

fn git_propagate(out: &SaVmRunResult, r: &GitSpawnResult, fallback_p: ptr, fallback_n: u64, started_at: f64) -> bool {
    if r.unavailable {
        res_init(out);
        out.ok = false;
        res_set_kind(out, STR_PTR("unavailable"), STR_LEN("unavailable"));
        out.has_exitCode = true;
        out.exitCode = 1;
        res_set_stderr(out, sb_ptr(&r.stderr), r.stderr.len);
        out.durationMs = dur_since(started_at);
        return true;
    };
    if r.timedOut {
        res_init(out);
        out.ok = false;
        res_set_kind(out, STR_PTR("timeout"), STR_LEN("timeout"));
        out.has_exitCode = true;
        out.exitCode = 124;
        res_set_stderr(out, sb_ptr(&r.stderr), r.stderr.len);
        out.durationMs = dur_since(started_at);
        return true;
    };
    if !r.has_status || r.status != 0 {
        if r.stderr.len > 0 {
            res_sa_error(out, sb_ptr(&r.stderr), r.stderr.len, started_at);
        } else {
            res_sa_error(out, fallback_p, fallback_n, started_at);
        };
        if r.has_status { out.exitCode = r.status as i64; };
        return true;
    };
    return false;
}

fn parseGitBranchHeader(header: &StrBuf, branch: &StrBuf, upstream: &StrBuf, has_upstream: &bool, ahead: &u64, behind: &u64) -> void {
    branch.len = 0;
    upstream.len = 0;
    *has_upstream = false;
    *ahead = 0;
    *behind = 0;
    let dd: i64 = sb_index_of(header, STR_PTR("..."), STR_LEN("..."));
    if dd >= 0 {
        let left = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_append(&left, sb_ptr(header), dd as u64);
        let left_t = StrBuf { bytes: [0u8; 65536], len: 0 };
        tool_sb_trim(&left, &left_t);
        if left_t.len > 0 { sb_copy(branch, &left_t); } else { sb_copy(branch, header); };
        let rest = StrBuf { bytes: [0u8; 65536], len: 0 };
        let rstart: u64 = (dd as u64) + 3;
        let pr15199_0: ptr = PTR_NULL();
        PTR_BYTE_ADD(pr15199_0, sb_ptr(header), rstart);
        if header.len > rstart { sb_append(&rest, pr15199_0, header.len - rstart); };
        let lb: i64 = sb_last_index_of(&rest, STR_PTR(" ["), STR_LEN(" ["));
        let flags = StrBuf { bytes: [0u8; 65536], len: 0 };
        let has_flags: bool = false;
        if lb >= 0 && rest.len > 0 && rest.bytes[rest.len - 1] == 93 {
            let up_part = StrBuf { bytes: [0u8; 65536], len: 0 };
            sb_append(&up_part, sb_ptr(&rest), lb as u64);
            let up_t = StrBuf { bytes: [0u8; 65536], len: 0 };
            tool_sb_trim(&up_part, &up_t);
            if up_t.len > 0 { sb_copy(upstream, &up_t); *has_upstream = true; };
            let fstart: u64 = (lb as u64) + 2;
            let po15157_0: ptr = PTR_NULL();
            PTR_BYTE_ADD(po15157_0, sb_ptr(&rest), fstart);
            if rest.len - 1 > fstart { sb_append(&flags, po15157_0, rest.len - 1 - fstart); };
            has_flags = true;
        } else {
            let rest_t = StrBuf { bytes: [0u8; 65536], len: 0 };
            tool_sb_trim(&rest, &rest_t);
            if rest_t.len > 0 { sb_copy(upstream, &rest_t); *has_upstream = true; };
        };
        if has_flags {
            let ap: i64 = sb_index_of(&flags, STR_PTR("ahead "), STR_LEN("ahead "));
            if ap >= 0 {
                let ok: bool = false;
                let pq15192_0: ptr = PTR_NULL();
                PTR_BYTE_ADD(pq15192_0, sb_ptr(&flags), (ap as u64) + 6);
                let adig: u64 = 0;
                while (ap as u64) + 6 + adig < flags.len {
                    let adb: u8 = flags.bytes[(ap as u64) + 6 + adig];
                    if adb < 48 || adb > 57 { break; };
                    adig = adig + 1;
                }
                let v: i64 = parse_i64_bytes(pq15192_0, adig, &ok);
                if ok && v > 0 { *ahead = v as u64; };
            };
            let bp: i64 = sb_index_of(&flags, STR_PTR("behind "), STR_LEN("behind "));
            if bp >= 0 {
                let ok: bool = false;
                let pq15198_0: ptr = PTR_NULL();
                PTR_BYTE_ADD(pq15198_0, sb_ptr(&flags), (bp as u64) + 7);
                let bdig: u64 = 0;
                while (bp as u64) + 7 + bdig < flags.len {
                    let bdb: u8 = flags.bytes[(bp as u64) + 7 + bdig];
                    if bdb < 48 || bdb > 57 { break; };
                    bdig = bdig + 1;
                }
                let v: i64 = parse_i64_bytes(pq15198_0, bdig, &ok);
                if ok && v > 0 { *behind = v as u64; };
            };
        };
        return;
    };
    if sb_starts(header, STR_PTR("No commits yet on "), STR_LEN("No commits yet on ")) {
        let rest = StrBuf { bytes: [0u8; 65536], len: 0 };
        let pr15241_0: ptr = PTR_NULL();
        PTR_BYTE_ADD(pr15241_0, sb_ptr(header), 18);
        sb_append(&rest, pr15241_0, header.len - 18);
        let rest_t = StrBuf { bytes: [0u8; 65536], len: 0 };
        tool_sb_trim(&rest, &rest_t);
        if rest_t.len > 0 { sb_copy(branch, &rest_t); } else { sb_copy(branch, header); };
        return;
    };
    sb_copy(branch, header);
}

fn stripGitQuotes(p: &StrBuf, out: &StrBuf) -> void {
    let t = StrBuf { bytes: [0u8; 65536], len: 0 };
    tool_sb_trim(p, &t);
    if t.len >= 2 && t.bytes[0] == 34 && t.bytes[t.len - 1] == 34 {
        let inner = StrBuf { bytes: [0u8; 65536], len: 0 };
        let po15196_0: ptr = PTR_NULL();
        PTR_BYTE_ADD(po15196_0, sb_ptr(&t), 1);
        sb_append(&inner, po15196_0, t.len - 2);
        let step = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_replace_all(&inner, STR_PTR("\\\""), STR_LEN("\\\""), STR_PTR("\""), STR_LEN("\""), &step);
        sb_replace_all(&step, STR_PTR("\\\\"), STR_LEN("\\\\"), STR_PTR("\\"), STR_LEN("\\"), out);
        return;
    };
    sb_copy(out, &t);
}

fn lb_pop(l: &ListBuf) -> void {
    if l.len == 0 { return; };
    let pos: u64 = l.len;
    while pos > 0 && l.bytes[pos - 1] != 10 { pos = pos - 1; }
    if pos == 0 { l.len = 0; } else { l.len = pos - 1; };
}

fn git_status_build(branch: &StrBuf, upstream: &StrBuf, has_upstream: bool, ahead: u64, behind: u64, repo: &StrBuf, st_paths: &ListBuf, st_xs: &ListBuf, st_ys: &ListBuf, st_origs: &ListBuf, st_hasorig: &U64List, us_paths: &ListBuf, us_xs: &ListBuf, us_ys: &ListBuf, us_origs: &ListBuf, us_hasorig: &U64List, ut_paths: &ListBuf, truncated: bool, ob: &JsonBuf) -> void {
    let payload: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    if payload == 0 { ob.len = 0; return; };
    jset_str(payload, STR_PTR("status"), STR_LEN("status"), STR_PTR("ok"), STR_LEN("ok"));
    jset_str(payload, STR_PTR("action"), STR_LEN("action"), STR_PTR("git_status"), STR_LEN("git_status"));
    jset_str(payload, STR_PTR("repo"), STR_LEN("repo"), sb_ptr(repo), repo.len);
    jset_str(payload, STR_PTR("branch"), STR_LEN("branch"), sb_ptr(branch), branch.len);
    if has_upstream { jset_str(payload, STR_PTR("upstream"), STR_LEN("upstream"), sb_ptr(upstream), upstream.len); } else { jset_null(payload, STR_PTR("upstream"), STR_LEN("upstream")); };
    jset_f64(payload, STR_PTR("ahead"), STR_LEN("ahead"), ahead as f64);
    jset_f64(payload, STR_PTR("behind"), STR_LEN("behind"), behind as f64);
    let cats: u64 = 0;
    while cats < 3 {
        let paths: &ListBuf = st_paths;
        let xs: &ListBuf = st_xs;
        let ys: &ListBuf = st_ys;
        let origs: &ListBuf = st_origs;
        let hasorig: &U64List = st_hasorig;
        let key_p: ptr = STR_PTR("staged");
        let key_n: u64 = STR_LEN("staged");
        if cats == 1 {
            paths = us_paths;
            xs = us_xs;
            ys = us_ys;
            origs = us_origs;
            hasorig = us_hasorig;
            key_p = STR_PTR("unstaged");
            key_n = STR_LEN("unstaged");
        };
        if cats == 2 {
            paths = ut_paths;
            key_p = STR_PTR("untracked");
            key_n = STR_LEN("untracked");
        };
        let arr: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
        if arr != 0 {
            let pv = StrBuf { bytes: [0u8; 65536], len: 0 };
            let xv = StrBuf { bytes: [0u8; 65536], len: 0 };
            let yv = StrBuf { bytes: [0u8; 65536], len: 0 };
            let ov = StrBuf { bytes: [0u8; 65536], len: 0 };
            let i: u64 = 0;
            while i < lb_count(paths) {
                let g0: bool = lb_at(paths, i, &pv);
                let eo: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
                if eo != 0 {
                    jset_str(eo, STR_PTR("path"), STR_LEN("path"), sb_ptr(&pv), pv.len);
                    if cats < 2 {
                        let g1: bool = lb_at(xs, i, &xv);
                        jset_str(eo, STR_PTR("x"), STR_LEN("x"), sb_ptr(&xv), xv.len);
                        let g2: bool = lb_at(ys, i, &yv);
                        jset_str(eo, STR_PTR("y"), STR_LEN("y"), sb_ptr(&yv), yv.len);
                        if hasorig.items[i] == 1 {
                            let g3: bool = lb_at(origs, i, &ov);
                            jset_str(eo, STR_PTR("orig"), STR_LEN("orig"), sb_ptr(&ov), ov.len);
                        };
                    };
                    let rp: i32 = sa_json_array_push_node(arr, eo);
                };
                i = i + 1;
            }
            jset_node(payload, key_p, key_n, arr);
        };
        cats = cats + 1;
    }
    let counts: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    if counts != 0 {
        jset_f64(counts, STR_PTR("staged"), STR_LEN("staged"), lb_count(st_paths) as f64);
        jset_f64(counts, STR_PTR("unstaged"), STR_LEN("unstaged"), lb_count(us_paths) as f64);
        jset_f64(counts, STR_PTR("untracked"), STR_LEN("untracked"), lb_count(ut_paths) as f64);
        jset_node(payload, STR_PTR("counts"), STR_LEN("counts"), counts);
    };
    if truncated { jset_bool(payload, STR_PTR("truncated"), STR_LEN("truncated"), true); } else { jset_bool(payload, STR_PTR("truncated"), STR_LEN("truncated"), false); };
    let cjb = JsonBuf { bytes: [0u8; 262144], len: 0 };
    jdoc_to_jb(payload, &cjb);
    json_pretty_into(jb_ptr(&cjb), cjb.len, ob);
    sa_json_free(payload);
}

fn nativeGitStatus(start_path: &StrBuf, options: &JsonBuf, policy_doc: u64, cwd: &StrBuf, started_at: f64, out: &SaVmRunResult) -> i32 {
