    } else {
        sb_append(&out_sb, STR_PTR("APPLIED"), STR_LEN("APPLIED"));
    };
    if huge { sb_append(&out_sb, STR_PTR(" (syntax+target-semantic gate: source >250KB)"), STR_LEN(" (syntax+target-semantic gate: source >250KB)")); };
    sb_append(&out_sb, STR_PTR(": "), STR_LEN(": "));
