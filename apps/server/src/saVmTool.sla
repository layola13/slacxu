        sb_push_byte(&xsb, x);
        let ysb = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_push_byte(&ysb, y);
        if x != 32 && x != 63 && x != 33 {
            lb_append(&st_paths, sb_ptr(&p), p.len);
            lb_append(&st_xs, sb_ptr(&xsb), xsb.len);
            lb_append(&st_ys, sb_ptr(&ysb), ysb.len);
            lb_append(&st_origs, sb_ptr(&orig), orig.len);
            if st_hasorig.len < 4096 {
                if has_orig { st_hasorig.items[st_hasorig.len] = 1; } else { st_hasorig.items[st_hasorig.len] = 0; };
                st_hasorig.len = st_hasorig.len + 1;
            };
        };
        if y != 32 && y != 63 && y != 33 {
            lb_append(&us_paths, sb_ptr(&p), p.len);
            lb_append(&us_xs, sb_ptr(&xsb), xsb.len);
            lb_append(&us_ys, sb_ptr(&ysb), ysb.len);
            lb_append(&us_origs, sb_ptr(&orig), orig.len);
            if us_hasorig.len < 4096 {
                if has_orig { us_hasorig.items[us_hasorig.len] = 1; } else { us_hasorig.items[us_hasorig.len] = 0; };
                us_hasorig.len = us_hasorig.len + 1;
            };
        };
    }
    let truncated: bool = false;
    while (lb_count(&st_paths) + lb_count(&us_paths) + lb_count(&ut_paths)) as f64 > max_entries {
