    if sres.ok && is_hov {
        let cdoc2: u64 = runhost_cache_load();
        let eo2: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
        if eo2 != 0 {
            let so_sb = StrBuf { bytes: [0u8; 65536], len: 0 };
            let gp2: ptr = gb_ptr(&sres.stdout);
            sb_append(&so_sb, gp2, sres.stdout.len);
            jset_str(eo2, STR_PTR("stdout"), STR_LEN("stdout"), sb_ptr(&so_sb), so_sb.len);
            jset_str(eo2, STR_PTR("stderr"), STR_LEN("stderr"), sb_ptr(&sres.stderr), sres.stderr.len);
            jset_f64(eo2, STR_PTR("exitCode"), STR_LEN("exitCode"), sres.exit_code as f64);
            jset_f64(eo2, STR_PTR("mtimeMs"), STR_LEN("mtimeMs"), exe_mtime as f64);
            jset_node(cdoc2, sb_ptr(&cache_key), cache_key.len, eo2);
            runhost_cache_save(cdoc2);
        };
        sa_json_free(cdoc2);
    };
    res_init(out);
    out.ok = sres.ok;
    res_set_kind(out, sb_ptr(&sres.kind), sres.kind.len);
    out.has_exitCode = sres.has_exit;
    out.exitCode = sres.exit_code;
    res_set_stdout(out, sb_ptr(&sliced2), sliced2.len);
    res_set_stderr(out, sb_ptr(&sres.stderr), sres.stderr.len);
    host_execution_event(out, &exe, &args, &tcwd, sres.has_exit, sres.exit_code, sres.duration_ms, false, &sres.session_id, false);
    out.durationMs = sres.duration_ms as u64;
    return 0;
}

fn sb_trim_ip(s: &StrBuf) -> void {
    let t = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_append(&t, sb_ptr(s), s.len);
    tool_sb_trim(&t, s);
}

fn re_ci_test(pat: ptr, patn: u64, text: &StrBuf) -> bool {
    let h: u64 = sa_regex_compile(pat, patn, 3);
    if h == 0 { return false; };
    let r: bool = re_handle_test(h, sb_ptr(text), text.len);
    sa_regex_free(h);
    return r;
}

fn session_id_from_input(input: &SaVmRunInput, out: &StrBuf) -> void {
    out.len = 0;
    if in_str(input, STR_PTR("session_id"), STR_LEN("session_id"), out) { sb_trim_ip(out); return; };
    if in_str(input, STR_PTR("session"), STR_LEN("session"), out) { sb_trim_ip(out); return; };
    if in_str(input, STR_PTR("sessionId"), STR_LEN("sessionId"), out) { sb_trim_ip(out); return; };
}

fn nativeWriteStdin(input: &SaVmRunInput, cwd: &StrBuf, started_at: f64, out: &SaVmRunResult) -> i32 {
    let sid = StrBuf { bytes: [0u8; 65536], len: 0 };
    session_id_from_input(input, &sid);
    if sid.len == 0 {
        res_input_error(out, STR_PTR("action 'write_stdin' requires a 'session_id' parameter"), STR_LEN("action 'write_stdin' requires a 'session_id' parameter"), started_at);
        return 0;
    };
    let doc: u64 = sessions_load();
    let idx: i64 = session_find(doc, &sid);
    if idx < 0 {
        let em = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_append(&em, STR_PTR("Session '"), STR_LEN("Session '"));
        sb_append(&em, sb_ptr(&sid), sid.len);
        sb_append(&em, STR_PTR("' not found or already terminated"), STR_LEN("' not found or already terminated"));
        res_sa_error(out, sb_ptr(&em), em.len, started_at);
        sa_json_free(doc);
        return 0;
    };
    session_refresh(doc, idx as u64);
    let node: u64 = jarr_at(doc, idx as u64);
    let status = StrBuf { bytes: [0u8; 65536], len: 0 };
    session_get_str(node, STR_PTR("status"), STR_LEN("status"), &status);
    if !sb_eq(&status, STR_PTR("running"), STR_LEN("running")) {
        let em2 = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_append(&em2, STR_PTR("Session '"), STR_LEN("Session '"));
        sb_append(&em2, sb_ptr(&sid), sid.len);
        sb_append(&em2, STR_PTR("' is not running (status: "), STR_LEN("' is not running (status: "));
        sb_append(&em2, sb_ptr(&status), status.len);
        sb_append(&em2, STR_PTR(")"), STR_LEN(")"));
        res_init(out);
        out.ok = false;
        res_set_kind(out, STR_PTR("sa_error"), STR_LEN("sa_error"));
        out.has_exitCode = true;
        if session_get_bool(node, STR_PTR("has_exit"), STR_LEN("has_exit")) {
            out.exitCode = session_get_num(node, STR_PTR("exit_code"), STR_LEN("exit_code"), 1.0) as i64;
        } else {
            out.exitCode = 1;
        };
        res_set_stderr(out, sb_ptr(&em2), em2.len);
        out.durationMs = dur_since(started_at);
        sa_json_free(doc);
        return 0;
    };
    let text = StrBuf { bytes: [0u8; 65536], len: 0 };
    if !in_str(input, STR_PTR("input"), STR_LEN("input"), &text) {
        if !in_str(input, STR_PTR("content"), STR_LEN("content"), &text) {
            in_str(input, STR_PTR("text"), STR_LEN("text"), &text);
        };
    };
    let close_stdin: bool = jnode_truthy(jget_node(input.node, STR_PTR("close_stdin"), STR_LEN("close_stdin"))) || jnode_truthy(jget_node(input.node, STR_PTR("eof"), STR_LEN("eof"))) || jnode_truthy(jget_node(input.node, STR_PTR("close"), STR_LEN("close")));
    let hin: u64 = session_get_num(node, STR_PTR("stdin_h"), STR_LEN("stdin_h"), 0.0) as u64;
    let stdin_closed: bool = session_get_bool(node, STR_PTR("stdin_closed"), STR_LEN("stdin_closed"));
    if hin == 0 || stdin_closed {
        let em3 = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_append(&em3, STR_PTR("Session '"), STR_LEN("Session '"));
        sb_append(&em3, sb_ptr(&sid), sid.len);
        sb_append(&em3, STR_PTR("' stdin is not writable or already closed"), STR_LEN("' stdin is not writable or already closed"));
        res_sa_error(out, sb_ptr(&em3), em3.len, started_at);
        sa_json_free(doc);
        return 0;
    };
    if text.len > 0 {
        let wst: i32 = sa_io_write_all(hin, sb_ptr(&text), text.len);
        if wst != 0 {
            let em4 = StrBuf { bytes: [0u8; 65536], len: 0 };
            sb_append(&em4, STR_PTR("Failed to write stdin: write failed"), STR_LEN("Failed to write stdin: write failed"));
            res_err(out, STR_PTR("crashed"), STR_LEN("crashed"), sb_ptr(&em4), em4.len, started_at);
            out.has_exitCode = true;
            out.exitCode = 1;
            sa_json_free(doc);
            return 0;
        };
    };
    if close_stdin { jset_bool(node, STR_PTR("stdin_closed"), STR_LEN("stdin_closed"), true); };
    sessions_save(doc);
    sa_json_free(doc);
    res_init(out);
    out.ok = true;
    res_set_kind(out, STR_PTR("success"), STR_LEN("success"));
    res_set_session_id(out, &sid);
    let mm = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_append(&mm, STR_PTR("Wrote "), STR_LEN("Wrote "));
    tool_sb_append_u64(text.len, &mm);
    sb_append(&mm, STR_PTR(" bytes to stdin of session '"), STR_LEN(" bytes to stdin of session '"));
    sb_append(&mm, sb_ptr(&sid), sid.len);
    sb_append(&mm, STR_PTR("'"), STR_LEN("'"));
    if close_stdin { sb_append(&mm, STR_PTR(" (stdin closed)"), STR_LEN(" (stdin closed)")); };
    res_set_message(out, &mm);
    let arr: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    let eo: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    if arr != 0 && eo != 0 {
        jset_str(eo, STR_PTR("event"), STR_LEN("event"), STR_PTR("stdin_write"), STR_LEN("stdin_write"));
        jset_str(eo, STR_PTR("sessionId"), STR_LEN("sessionId"), sb_ptr(&sid), sid.len);
        jset_f64(eo, STR_PTR("bytes"), STR_LEN("bytes"), text.len as f64);
        jset_bool(eo, STR_PTR("closed"), STR_LEN("closed"), close_stdin);
        let pst: i32 = sa_json_array_push_node(arr, eo);
        let ejb = JsonBuf { bytes: [0u8; 262144], len: 0 };
        jdoc_to_jb(arr, &ejb);
        res_set_events(out, jb_ptr(&ejb), ejb.len);
        sa_json_free(arr);
    };
    out.durationMs = dur_since(started_at);
    return 0;
}

fn nativeSessionStatus(input: &SaVmRunInput, cwd: &StrBuf, started_at: f64, out: &SaVmRunResult) -> i32 {
    let sid = StrBuf { bytes: [0u8; 65536], len: 0 };
    session_id_from_input(input, &sid);
    if sid.len == 0 {
        res_input_error(out, STR_PTR("action 'session_status' requires a 'session_id' parameter"), STR_LEN("action 'session_status' requires a 'session_id' parameter"), started_at);
        return 0;
    };
    let doc: u64 = sessions_load();
    let idx: i64 = session_find(doc, &sid);
    if idx < 0 {
        let em = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_append(&em, STR_PTR("Session '"), STR_LEN("Session '"));
        sb_append(&em, sb_ptr(&sid), sid.len);
        sb_append(&em, STR_PTR("' not found"), STR_LEN("' not found"));
        res_sa_error(out, sb_ptr(&em), em.len, started_at);
        sa_json_free(doc);
        return 0;
    };
    session_refresh(doc, idx as u64);
    let node: u64 = jarr_at(doc, idx as u64);
    let raw_out = StrBuf { bytes: [0u8; 65536], len: 0 };
    let raw_err = StrBuf { bytes: [0u8; 65536], len: 0 };
    session_get_str(node, STR_PTR("stdout"), STR_LEN("stdout"), &raw_out);
    session_get_str(node, STR_PTR("stderr"), STR_LEN("stderr"), &raw_err);
    let status = StrBuf { bytes: [0u8; 65536], len: 0 };
    session_get_str(node, STR_PTR("status"), STR_LEN("status"), &status);
    let has_exit: bool = session_get_bool(node, STR_PTR("has_exit"), STR_LEN("has_exit"));
    let exit_code: i64 = session_get_num(node, STR_PTR("exit_code"), STR_LEN("exit_code"), 0.0) as i64;
    let pid: u64 = session_get_num(node, STR_PTR("pid"), STR_LEN("pid"), 0.0) as u64;
    let drain: bool = jnode_truthy(jget_node(input.node, STR_PTR("drain"), STR_LEN("drain"))) || jnode_truthy(jget_node(input.node, STR_PTR("clear"), STR_LEN("clear")));
    if drain {
        jset_str(node, STR_PTR("stdout"), STR_LEN("stdout"), STR_PTR(""), STR_LEN(""));
        jset_str(node, STR_PTR("stderr"), STR_LEN("stderr"), STR_PTR(""), STR_LEN(""));
    };
    sessions_save(doc);
    sa_json_free(doc);
    let sliced = StrBuf { bytes: [0u8; 65536], len: 0 };
    slice_filter_output(sb_ptr(&raw_out), raw_out.len, input.node, &sliced);
    res_init(out);
    let is_crashed: bool = sb_eq(&status, STR_PTR("crashed"), STR_LEN("crashed"));
    let is_timed: bool = sb_eq(&status, STR_PTR("timed_out"), STR_LEN("timed_out"));
    out.ok = !is_crashed && !is_timed;
    if sb_eq(&status, STR_PTR("running"), STR_LEN("running")) {
        res_set_kind(out, STR_PTR("running"), STR_LEN("running"));
    } else if sb_eq(&status, STR_PTR("exited"), STR_LEN("exited")) && has_exit && exit_code == 0 {
        res_set_kind(out, STR_PTR("success"), STR_LEN("success"));
    } else {
        res_set_kind(out, STR_PTR("crashed"), STR_LEN("crashed"));
    };
    out.has_exitCode = has_exit;
    out.exitCode = exit_code;
    res_set_stdout(out, sb_ptr(&sliced), sliced.len);
    res_set_stderr(out, sb_ptr(&raw_err), raw_err.len);
    res_set_session_id(out, &sid);
    res_set_status_field(out, &status);
    if pid > 0 { out.has_pid = true; out.pid = pid; };
    let mm = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_append(&mm, STR_PTR("Session '"), STR_LEN("Session '"));
    sb_append(&mm, sb_ptr(&sid), sid.len);
    sb_append(&mm, STR_PTR("' is "), STR_LEN("' is "));
    sb_append(&mm, sb_ptr(&status), status.len);
    if has_exit {
        sb_append(&mm, STR_PTR(" (exit code: "), STR_LEN(" (exit code: "));
        fmt_i64_sb(exit_code, &mm);
        sb_append(&mm, STR_PTR(")"), STR_LEN(")"));
    };
    res_set_message(out, &mm);
    let arr: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    let eo: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    if arr != 0 && eo != 0 {
        jset_str(eo, STR_PTR("event"), STR_LEN("event"), STR_PTR("session_status"), STR_LEN("session_status"));
        jset_str(eo, STR_PTR("sessionId"), STR_LEN("sessionId"), sb_ptr(&sid), sid.len);
        jset_str(eo, STR_PTR("status"), STR_LEN("status"), sb_ptr(&status), status.len);
        if has_exit { jset_i64(eo, STR_PTR("exitCode"), STR_LEN("exitCode"), exit_code); } else { jset_null(eo, STR_PTR("exitCode"), STR_LEN("exitCode")); };
        let pst: i32 = sa_json_array_push_node(arr, eo);
        let ejb = JsonBuf { bytes: [0u8; 262144], len: 0 };
        jdoc_to_jb(arr, &ejb);
        res_set_events(out, jb_ptr(&ejb), ejb.len);
        sa_json_free(arr);
    };
    out.durationMs = dur_since(started_at);
    return 0;
}

fn nativeKillSession(input: &SaVmRunInput, cwd: &StrBuf, started_at: f64, out: &SaVmRunResult) -> i32 {
    let sid = StrBuf { bytes: [0u8; 65536], len: 0 };
    session_id_from_input(input, &sid);
    if sid.len == 0 {
        res_input_error(out, STR_PTR("action 'kill_session' requires a 'session_id' parameter"), STR_LEN("action 'kill_session' requires a 'session_id' parameter"), started_at);
        return 0;
    };
    let doc: u64 = sessions_load();
    let idx: i64 = session_find(doc, &sid);
    if idx < 0 {
        let em = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_append(&em, STR_PTR("Session '"), STR_LEN("Session '"));
        sb_append(&em, sb_ptr(&sid), sid.len);
        sb_append(&em, STR_PTR("' not found"), STR_LEN("' not found"));
        res_sa_error(out, sb_ptr(&em), em.len, started_at);
        sa_json_free(doc);
        return 0;
    };
    session_refresh(doc, idx as u64);
    let node: u64 = jarr_at(doc, idx as u64);
    let status = StrBuf { bytes: [0u8; 65536], len: 0 };
    session_get_str(node, STR_PTR("status"), STR_LEN("status"), &status);
    let pid: u64 = session_get_num(node, STR_PTR("pid"), STR_LEN("pid"), 0.0) as u64;
    if sb_eq(&status, STR_PTR("running"), STR_LEN("running")) {
        let proc: u64 = session_get_num(node, STR_PTR("proc"), STR_LEN("proc"), 0.0) as u64;
        if proc != 0 {
            let k1: i32 = sa_std_process_kill(proc);
            let k2: i32 = sa_std_process_kill_process_group(proc);
            let wcode: u64 = 0;
            let wst: i32 = sa_std_process_wait(proc, &wcode);
            let cst: i32 = sa_std_process_close(proc);
        };
        jset_str(node, STR_PTR("status"), STR_LEN("status"), STR_PTR("killed"), STR_LEN("killed"));
        jset_bool(node, STR_PTR("closed"), STR_LEN("closed"), true);
        jset_bool(node, STR_PTR("has_exit"), STR_LEN("has_exit"), true);
        jset_f64(node, STR_PTR("exit_code"), STR_LEN("exit_code"), 137.0);
        status.len = 0;
        sb_append(&status, STR_PTR("killed"), STR_LEN("killed"));
    };
    let has_exit: bool = session_get_bool(node, STR_PTR("has_exit"), STR_LEN("has_exit"));
    let exit_code: i64 = session_get_num(node, STR_PTR("exit_code"), STR_LEN("exit_code"), 0.0) as i64;
    sessions_save(doc);
    sa_json_free(doc);
    res_init(out);
    out.ok = true;
    res_set_kind(out, STR_PTR("success"), STR_LEN("success"));
    out.has_exitCode = has_exit;
    out.exitCode = exit_code;
    res_set_session_id(out, &sid);
    res_set_status_field(out, &status);
    if pid > 0 { out.has_pid = true; out.pid = pid; };
    let mm = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_append(&mm, STR_PTR("Session '"), STR_LEN("Session '"));
    sb_append(&mm, sb_ptr(&sid), sid.len);
    sb_append(&mm, STR_PTR("' terminated."), STR_LEN("' terminated."));
    res_set_message(out, &mm);
    let arr: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    let eo: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    if arr != 0 && eo != 0 {
        jset_str(eo, STR_PTR("event"), STR_LEN("event"), STR_PTR("session_killed"), STR_LEN("session_killed"));
        jset_str(eo, STR_PTR("sessionId"), STR_LEN("sessionId"), sb_ptr(&sid), sid.len);
        jset_f64(eo, STR_PTR("pid"), STR_LEN("pid"), pid as f64);
        let pst: i32 = sa_json_array_push_node(arr, eo);
        let ejb = JsonBuf { bytes: [0u8; 262144], len: 0 };
        jdoc_to_jb(arr, &ejb);
        res_set_events(out, jb_ptr(&ejb), ejb.len);
        sa_json_free(arr);
    };
    out.durationMs = dur_since(started_at);
    return 0;
}

fn nativeListSessions(started_at: f64, out: &SaVmRunResult) -> i32 {
    let doc: u64 = sessions_load();
    let cnt: u64 = jcount(doc);
    let i: u64 = 0;
    while i < cnt {
        session_refresh(doc, i);
        i = i + 1;
    }
    sessions_save(doc);
    let now: f64 = sa_time_unix_ms() as f64;
    let payload: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    let sarr: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    let j: u64 = 0;
    while j < cnt {
        let node: u64 = jarr_at(doc, j);
        if node != 0 && sarr != 0 {
            let eo: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
            if eo != 0 {
                let id = StrBuf { bytes: [0u8; 65536], len: 0 };
                let exe = StrBuf { bytes: [0u8; 65536], len: 0 };
                let status = StrBuf { bytes: [0u8; 65536], len: 0 };
                session_get_str(node, STR_PTR("id"), STR_LEN("id"), &id);
                session_get_str(node, STR_PTR("exe"), STR_LEN("exe"), &exe);
                session_get_str(node, STR_PTR("status"), STR_LEN("status"), &status);
                jset_str(eo, STR_PTR("id"), STR_LEN("id"), sb_ptr(&id), id.len);
                jset_f64(eo, STR_PTR("pid"), STR_LEN("pid"), session_get_num(node, STR_PTR("pid"), STR_LEN("pid"), 0.0));
                jset_str(eo, STR_PTR("exe"), STR_LEN("exe"), sb_ptr(&exe), exe.len);
                jset_str(eo, STR_PTR("status"), STR_LEN("status"), sb_ptr(&status), status.len);
                if session_get_bool(node, STR_PTR("has_exit"), STR_LEN("has_exit")) {
                    jset_f64(eo, STR_PTR("exitCode"), STR_LEN("exitCode"), session_get_num(node, STR_PTR("exit_code"), STR_LEN("exit_code"), 0.0));
                } else {
                    jset_null(eo, STR_PTR("exitCode"), STR_LEN("exitCode"));
                };
                let sat: f64 = session_get_num(node, STR_PTR("started_at"), STR_LEN("started_at"), 0.0);
                jset_f64(eo, STR_PTR("startedAt"), STR_LEN("startedAt"), sat);
                jset_f64(eo, STR_PTR("durationMs"), STR_LEN("durationMs"), now - sat);
                let pst: i32 = sa_json_array_push_node(sarr, eo);
            };
        };
        j = j + 1;
    }
    if payload != 0 && sarr != 0 { jset_node(payload, STR_PTR("sessions"), STR_LEN("sessions"), sarr); };
    let jb = JsonBuf { bytes: [0u8; 262144], len: 0 };
    if payload != 0 { json_pretty_doc(payload, &jb); };
    res_success(out, started_at);
    res_set_stdout(out, jb_ptr(&jb), jb.len);
    let arr: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    let eo2: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    if arr != 0 && eo2 != 0 {
        jset_str(eo2, STR_PTR("event"), STR_LEN("event"), STR_PTR("list_sessions"), STR_LEN("list_sessions"));
        jset_f64(eo2, STR_PTR("count"), STR_LEN("count"), cnt as f64);
        let pst2: i32 = sa_json_array_push_node(arr, eo2);
        let ejb = JsonBuf { bytes: [0u8; 262144], len: 0 };
        jdoc_to_jb(arr, &ejb);
        res_set_events(out, jb_ptr(&ejb), ejb.len);
        sa_json_free(arr);
    };
    out.durationMs = dur_since(started_at);
    if payload != 0 { sa_json_free(payload); };
    sa_json_free(doc);
    return 0;
}

fn checkpoint_event(out: &SaVmRunResult, created: bool, has_created: bool, commit: &StrBuf, message: &StrBuf, has_message: bool) -> void {
    let arr: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    let eo: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    if arr == 0 || eo == 0 { return; };
    jset_str(eo, STR_PTR("event"), STR_LEN("event"), STR_PTR("local_checkpoint"), STR_LEN("local_checkpoint"));
    jset_bool(eo, STR_PTR("created"), STR_LEN("created"), created);
    jset_str(eo, STR_PTR("commit"), STR_LEN("commit"), sb_ptr(commit), commit.len);
    if has_message { jset_str(eo, STR_PTR("message"), STR_LEN("message"), sb_ptr(message), message.len); };
    let pst: i32 = sa_json_array_push_node(arr, eo);
    let ejb = JsonBuf { bytes: [0u8; 262144], len: 0 };
    jdoc_to_jb(arr, &ejb);
    res_set_events(out, jb_ptr(&ejb), ejb.len);
    sa_json_free(arr);
}

fn git_args2(a: &StrBuf, b: &StrBuf, out: &ByteList) -> void {
    out.len = 0;
    bl_push(out, sb_ptr(a), a.len);
    bl_push(out, sb_ptr(b), b.len);
}

fn nativeLocalCheckpoint(input: &SaVmRunInput, cwd: &StrBuf, started_at: f64, out: &SaVmRunResult) -> i32 {
    let raw_cwd = StrBuf { bytes: [0u8; 65536], len: 0 };
    let target = StrBuf { bytes: [0u8; 65536], len: 0 };
    if in_str(input, STR_PTR("cwd"), STR_LEN("cwd"), &raw_cwd) {
        let t = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_append(&t, sb_ptr(&raw_cwd), raw_cwd.len);
        sb_trim_ip(&t);
        if t.len > 0 { path_resolve(cwd, &t, &target); } else { sb_append(&target, sb_ptr(cwd), cwd.len); };
    } else {
        sb_append(&target, sb_ptr(cwd), cwd.len);
    };
    let root = StrBuf { bytes: [0u8; 65536], len: 0 };
    if !findGitRepoRoot(&target, cwd, &root) {
        res_sa_error(out, STR_PTR("Cannot create local checkpoint: no git repository found in workspace."), STR_LEN("Cannot create local checkpoint: no git repository found in workspace."), started_at);
        return 0;
    };
    let ijb = JsonBuf { bytes: [0u8; 262144], len: 0 };
    input_to_jb(input, &ijb);
    let timeout_ms: f64 = resolveTimeoutMs(&ijb, 30000.0);
    let a1 = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_append(&a1, STR_PTR("status"), STR_LEN("status"));
    let a2 = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_append(&a2, STR_PTR("--porcelain=v1"), STR_LEN("--porcelain=v1"));
    let args = ByteList { items: [0u8; 4096], len: 0 };
    git_args2(&a1, &a2, &args);
    let r = GitSpawnResult { status: 0, has_status: false, stdout: GitBigBuf { bytes: [0u8; 524288], len: 0 }, stderr: StrBuf { bytes: [0u8; 65536], len: 0 }, unavailable: false, timedOut: false };
    execGitSync(&root, &args, timeout_ms, &r);
    if !r.has_status || r.status != 0 {
        res_init(out);
        out.ok = false;
        res_set_kind(out, STR_PTR("sa_error"), STR_LEN("sa_error"));
        out.has_exitCode = r.has_status;
        out.exitCode = r.status as i64;
        let gp: ptr = gb_ptr(&r.stdout);
        res_set_stdout(out, gp, r.stdout.len);
        if r.stderr.len > 0 { res_set_stderr(out, sb_ptr(&r.stderr), r.stderr.len); } else { res_set_stderr(out, STR_PTR("git status failed"), STR_LEN("git status failed")); };
        out.durationMs = dur_since(started_at);
        return 0;
    };
    let clean: bool = r.stdout.len == 0;
    let b1 = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_append(&b1, STR_PTR("rev-parse"), STR_LEN("rev-parse"));
    let b2 = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_append(&b2, STR_PTR("HEAD"), STR_LEN("HEAD"));
    if clean {
        let args2 = ByteList { items: [0u8; 4096], len: 0 };
        git_args2(&b1, &b2, &args2);
        let r2 = GitSpawnResult { status: 0, has_status: false, stdout: GitBigBuf { bytes: [0u8; 524288], len: 0 }, stderr: StrBuf { bytes: [0u8; 65536], len: 0 }, unavailable: false, timedOut: false };
        execGitSync(&root, &args2, 5000.0, &r2);
        let sha = StrBuf { bytes: [0u8; 65536], len: 0 };
        let gp2: ptr = gb_ptr(&r2.stdout);
        sb_append(&sha, gp2, r2.stdout.len);
        sb_trim_ip(&sha);
        let payload: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
        if payload != 0 {
            jset_str(payload, STR_PTR("action"), STR_LEN("action"), STR_PTR("local_checkpoint"), STR_LEN("local_checkpoint"));
            jset_bool(payload, STR_PTR("created"), STR_LEN("created"), false);
            jset_str(payload, STR_PTR("commit"), STR_LEN("commit"), sb_ptr(&sha), sha.len);
            jset_str(payload, STR_PTR("message"), STR_LEN("message"), STR_PTR("Working tree is clean; nothing to checkpoint."), STR_LEN("Working tree is clean; nothing to checkpoint."));
        };
        let jb = JsonBuf { bytes: [0u8; 262144], len: 0 };
        if payload != 0 { json_pretty_doc(payload, &jb); };
        res_success(out, started_at);
        res_set_stdout(out, jb_ptr(&jb), jb.len);
        res_set_commit_field(out, &sha);
        out.has_created = true;
        out.created = false;
        let nomsg = StrBuf { bytes: [0u8; 65536], len: 0 };
        checkpoint_event(out, false, true, &sha, &nomsg, false);
        out.durationMs = dur_since(started_at);
        if payload != 0 { sa_json_free(payload); };
        return 0;
    };
    // dirty: add -A
    let c1 = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_append(&c1, STR_PTR("add"), STR_LEN("add"));
    let c2 = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_append(&c2, STR_PTR("-A"), STR_LEN("-A"));
    let args3 = ByteList { items: [0u8; 4096], len: 0 };
    git_args2(&c1, &c2, &args3);
    let r3 = GitSpawnResult { status: 0, has_status: false, stdout: GitBigBuf { bytes: [0u8; 524288], len: 0 }, stderr: StrBuf { bytes: [0u8; 65536], len: 0 }, unavailable: false, timedOut: false };
    execGitSync(&root, &args3, timeout_ms, &r3);
    if !r3.has_status || r3.status != 0 {
        res_init(out);
        out.ok = false;
        res_set_kind(out, STR_PTR("sa_error"), STR_LEN("sa_error"));
        out.has_exitCode = r3.has_status;
        out.exitCode = r3.status as i64;
        let gp3: ptr = gb_ptr(&r3.stdout);
        res_set_stdout(out, gp3, r3.stdout.len);
        if r3.stderr.len > 0 { res_set_stderr(out, sb_ptr(&r3.stderr), r3.stderr.len); } else { res_set_stderr(out, STR_PTR("git add failed"), STR_LEN("git add failed")); };
        out.durationMs = dur_since(started_at);
        return 0;
    };
    let user_msg = StrBuf { bytes: [0u8; 65536], len: 0 };
    if in_str(input, STR_PTR("message"), STR_LEN("message"), &user_msg) { sb_trim_ip(&user_msg); };
    if user_msg.len == 0 {
        if in_str(input, STR_PTR("content"), STR_LEN("content"), &user_msg) { sb_trim_ip(&user_msg); };
    };
    if user_msg.len == 0 { sb_append(&user_msg, STR_PTR("local checkpoint"), STR_LEN("local checkpoint")); };
    let commit_msg = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_append(&commit_msg, STR_PTR("[sa_vm checkpoint] "), STR_LEN("[sa_vm checkpoint] "));
    sb_append(&commit_msg, sb_ptr(&user_msg), user_msg.len);
    let args4 = ByteList { items: [0u8; 4096], len: 0 };
    args4.len = 0;
    let d1 = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_append(&d1, STR_PTR("commit"), STR_LEN("commit"));
    bl_push(&args4, sb_ptr(&d1), d1.len);
    let d2 = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_append(&d2, STR_PTR("-m"), STR_LEN("-m"));
    bl_push(&args4, sb_ptr(&d2), d2.len);
    bl_push(&args4, sb_ptr(&commit_msg), commit_msg.len);
    let d4 = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_append(&d4, STR_PTR("--no-verify"), STR_LEN("--no-verify"));
    bl_push(&args4, sb_ptr(&d4), d4.len);
    let d5 = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_append(&d5, STR_PTR("--no-gpg-sign"), STR_LEN("--no-gpg-sign"));
    bl_push(&args4, sb_ptr(&d5), d5.len);
    let r4 = GitSpawnResult { status: 0, has_status: false, stdout: GitBigBuf { bytes: [0u8; 524288], len: 0 }, stderr: StrBuf { bytes: [0u8; 65536], len: 0 }, unavailable: false, timedOut: false };
    execGitSync(&root, &args4, timeout_ms, &r4);
    if !r4.has_status || r4.status != 0 {
        res_init(out);
        out.ok = false;
        res_set_kind(out, STR_PTR("sa_error"), STR_LEN("sa_error"));
        out.has_exitCode = r4.has_status;
        out.exitCode = r4.status as i64;
        let gp4: ptr = gb_ptr(&r4.stdout);
        res_set_stdout(out, gp4, r4.stdout.len);
        if r4.stderr.len > 0 { res_set_stderr(out, sb_ptr(&r4.stderr), r4.stderr.len); } else { res_set_stderr(out, STR_PTR("git commit failed"), STR_LEN("git commit failed")); };
        out.durationMs = dur_since(started_at);
        return 0;
    };
    let args5 = ByteList { items: [0u8; 4096], len: 0 };
    git_args2(&b1, &b2, &args5);
    let r5 = GitSpawnResult { status: 0, has_status: false, stdout: GitBigBuf { bytes: [0u8; 524288], len: 0 }, stderr: StrBuf { bytes: [0u8; 65536], len: 0 }, unavailable: false, timedOut: false };
    execGitSync(&root, &args5, 5000.0, &r5);
    let sha2 = StrBuf { bytes: [0u8; 65536], len: 0 };
    let gp5: ptr = gb_ptr(&r5.stdout);
    sb_append(&sha2, gp5, r5.stdout.len);
    sb_trim_ip(&sha2);
    let payload2: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    if payload2 != 0 {
        jset_str(payload2, STR_PTR("action"), STR_LEN("action"), STR_PTR("local_checkpoint"), STR_LEN("local_checkpoint"));
        jset_bool(payload2, STR_PTR("created"), STR_LEN("created"), true);
        jset_str(payload2, STR_PTR("commit"), STR_LEN("commit"), sb_ptr(&sha2), sha2.len);
        jset_str(payload2, STR_PTR("message"), STR_LEN("message"), sb_ptr(&commit_msg), commit_msg.len);
    };
    let jb2 = JsonBuf { bytes: [0u8; 262144], len: 0 };
    if payload2 != 0 { json_pretty_doc(payload2, &jb2); };
    res_success(out, started_at);
    res_set_stdout(out, jb_ptr(&jb2), jb2.len);
    res_set_commit_field(out, &sha2);
    out.has_created = true;
    out.created = true;
    checkpoint_event(out, true, true, &sha2, &commit_msg, true);
    out.durationMs = dur_since(started_at);
    if payload2 != 0 { sa_json_free(payload2); };
    return 0;
}

fn nativeRestoreCheckpoint(input: &SaVmRunInput, cwd: &StrBuf, started_at: f64, out: &SaVmRunResult) -> i32 {
    let raw_cwd = StrBuf { bytes: [0u8; 65536], len: 0 };
    let target = StrBuf { bytes: [0u8; 65536], len: 0 };
    if in_str(input, STR_PTR("cwd"), STR_LEN("cwd"), &raw_cwd) {
        let t = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_append(&t, sb_ptr(&raw_cwd), raw_cwd.len);
        sb_trim_ip(&t);
        if t.len > 0 { path_resolve(cwd, &t, &target); } else { sb_append(&target, sb_ptr(cwd), cwd.len); };
    } else {
        sb_append(&target, sb_ptr(cwd), cwd.len);
    };
    let root = StrBuf { bytes: [0u8; 65536], len: 0 };
    if !findGitRepoRoot(&target, cwd, &root) {
        res_sa_error(out, STR_PTR("Cannot restore checkpoint: no git repository found in workspace."), STR_LEN("Cannot restore checkpoint: no git repository found in workspace."), started_at);
        return 0;
    };
    let commit = StrBuf { bytes: [0u8; 65536], len: 0 };
    if !in_str(input, STR_PTR("commit"), STR_LEN("commit"), &commit) {
        if !in_str(input, STR_PTR("sha"), STR_LEN("sha"), &commit) {
            in_str(input, STR_PTR("target"), STR_LEN("target"), &commit);
        };
    };
    sb_trim_ip(&commit);
    if commit.len == 0 {
        res_input_error(out, STR_PTR("action 'restore_checkpoint' requires a 'commit' (SHA) parameter"), STR_LEN("action 'restore_checkpoint' requires a 'commit' (SHA) parameter"), started_at);
        return 0;
    };
    let valid: bool = commit.len > 0 && byte_at(sb_ptr(&commit), 0) != 45;
    if valid {
        let cp: ptr = sb_ptr(&commit);
        let i: u64 = 0;
        while i < commit.len {
            let b: u8 = byte_at(cp, i);
            let okc: bool = (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || (b >= 48 && b <= 57) || b == 95 || b == 45 || b == 46 || b == 47 || b == 126 || b == 94;
            if !okc { valid = false; };
            i = i + 1;
        }
    };
    if !valid {
        let em = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_append(&em, STR_PTR("Invalid commit identifier format: '"), STR_LEN("Invalid commit identifier format: '"));
        sb_append(&em, sb_ptr(&commit), commit.len);
        sb_append(&em, STR_PTR("'"), STR_LEN("'"));
        let rsn = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_append(&rsn, STR_PTR("Invalid commit identifier"), STR_LEN("Invalid commit identifier"));
        let rl = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_append(&rl, STR_PTR("git.checkpoint.invalid_commit"), STR_LEN("git.checkpoint.invalid_commit"));
        res_denied_rule(out, &rl, &em, &rsn, started_at);
        return 0;
    };
    let v1 = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_append(&v1, STR_PTR("rev-parse"), STR_LEN("rev-parse"));
    let v2 = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_append(&v2, STR_PTR("--verify"), STR_LEN("--verify"));
    let v3 = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_append(&v3, sb_ptr(&commit), commit.len);
    sb_append(&v3, STR_PTR("^{commit}"), STR_LEN("^{commit}"));
    let args = ByteList { items: [0u8; 4096], len: 0 };
    args.len = 0;
    bl_push(&args, sb_ptr(&v1), v1.len);
    bl_push(&args, sb_ptr(&v2), v2.len);
    bl_push(&args, sb_ptr(&v3), v3.len);
    let r = GitSpawnResult { status: 0, has_status: false, stdout: GitBigBuf { bytes: [0u8; 524288], len: 0 }, stderr: StrBuf { bytes: [0u8; 65536], len: 0 }, unavailable: false, timedOut: false };
    execGitSync(&root, &args, 5000.0, &r);
    if !r.has_status || r.status != 0 {
        let em2 = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_append(&em2, STR_PTR("Checkpoint commit '"), STR_LEN("Checkpoint commit '"));
        sb_append(&em2, sb_ptr(&commit), commit.len);
        sb_append(&em2, STR_PTR("' was not found in local git history."), STR_LEN("' was not found in local git history."));
        res_sa_error(out, sb_ptr(&em2), em2.len, started_at);
        return 0;
    };
    let sha = StrBuf { bytes: [0u8; 65536], len: 0 };
    let gp: ptr = gb_ptr(&r.stdout);
    sb_append(&sha, gp, r.stdout.len);
    sb_trim_ip(&sha);
    let ijb = JsonBuf { bytes: [0u8; 262144], len: 0 };
    input_to_jb(input, &ijb);
    let timeout_ms: f64 = resolveTimeoutMs(&ijb, 30000.0);
    let w1 = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_append(&w1, STR_PTR("reset"), STR_LEN("reset"));
    let w2 = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_append(&w2, STR_PTR("--hard"), STR_LEN("--hard"));
    let args2 = ByteList { items: [0u8; 4096], len: 0 };
    args2.len = 0;
    bl_push(&args2, sb_ptr(&w1), w1.len);
    bl_push(&args2, sb_ptr(&w2), w2.len);
    bl_push(&args2, sb_ptr(&sha), sha.len);
    let r2 = GitSpawnResult { status: 0, has_status: false, stdout: GitBigBuf { bytes: [0u8; 524288], len: 0 }, stderr: StrBuf { bytes: [0u8; 65536], len: 0 }, unavailable: false, timedOut: false };
    execGitSync(&root, &args2, timeout_ms, &r2);
    if !r2.has_status || r2.status != 0 {
        res_init(out);
        out.ok = false;
        res_set_kind(out, STR_PTR("sa_error"), STR_LEN("sa_error"));
        out.has_exitCode = r2.has_status;
        out.exitCode = r2.status as i64;
        let gp2: ptr = gb_ptr(&r2.stdout);
        res_set_stdout(out, gp2, r2.stdout.len);
        if r2.stderr.len > 0 { res_set_stderr(out, sb_ptr(&r2.stderr), r2.stderr.len); } else { res_set_stderr(out, STR_PTR("git reset --hard failed"), STR_LEN("git reset --hard failed")); };
        out.durationMs = dur_since(started_at);
        return 0;
    };
    let msg = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_append(&msg, STR_PTR("Successfully restored local git checkpoint "), STR_LEN("Successfully restored local git checkpoint "));
    let short = StrBuf { bytes: [0u8; 65536], len: 0 };
    if sha.len > 8 { sb_append(&short, sb_ptr(&sha), 8); } else { sb_append(&short, sb_ptr(&sha), sha.len); };
    sb_append(&msg, sb_ptr(&short), short.len);
    sb_append(&msg, STR_PTR("."), STR_LEN("."));
    let payload: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    if payload != 0 {
        jset_str(payload, STR_PTR("action"), STR_LEN("action"), STR_PTR("restore_checkpoint"), STR_LEN("restore_checkpoint"));
        jset_str(payload, STR_PTR("commit"), STR_LEN("commit"), sb_ptr(&sha), sha.len);
        jset_str(payload, STR_PTR("message"), STR_LEN("message"), sb_ptr(&msg), msg.len);
    };
    let jb = JsonBuf { bytes: [0u8; 262144], len: 0 };
    if payload != 0 { json_pretty_doc(payload, &jb); };
    res_success(out, started_at);
    res_set_stdout(out, jb_ptr(&jb), jb.len);
    res_set_commit_field(out, &sha);
    let arr: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    let eo: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    if arr != 0 && eo != 0 {
        jset_str(eo, STR_PTR("event"), STR_LEN("event"), STR_PTR("restore_checkpoint"), STR_LEN("restore_checkpoint"));
        jset_str(eo, STR_PTR("commit"), STR_LEN("commit"), sb_ptr(&sha), sha.len);
        let pst: i32 = sa_json_array_push_node(arr, eo);
        let ejb = JsonBuf { bytes: [0u8; 262144], len: 0 };
        jdoc_to_jb(arr, &ejb);
        res_set_events(out, jb_ptr(&ejb), ejb.len);
        sa_json_free(arr);
    };
    out.durationMs = dur_since(started_at);
    if payload != 0 { sa_json_free(payload); };
    return 0;
}
// ---- batch 19c-1: batch dependency analysis, legacy templates, dispatcher helpers ----

fn task_str(task: u64, key: ptr, klen: u64, out: &StrBuf) -> bool {
    out.len = 0;
    let node: u64 = jget_node(task, key, klen);
    if node != 0 && sa_json_node_kind(node) == JK_STRING {
        let p: ptr = PTR_NULL();
        let n: u64 = 0;
        let gst: i32 = sa_json_node_string(node, &p, &n);
        sb_append(out, p, n);
        return true;
    };
    return false;
}

fn task_str2(task: u64, k1: ptr, n1: u64, k2: ptr, n2: u64, out: &StrBuf) -> bool {
    if task_str(task, k1, n1, out) { return true; };
    return task_str(task, k2, n2, out);
}

fn task_deps_normalize(p: &StrBuf, cwd: &StrBuf, out: &StrBuf) -> void {
    let r = StrBuf { bytes: [0u8; 65536], len: 0 };
    path_resolve(cwd, p, &r);
    out.len = 0;
    sb_append(out, sb_ptr(&r), r.len);
    sb_lower_ip(out);
}

fn task_deps_push(list: &ListBuf, raw: &StrBuf, cwd: &StrBuf) -> void {
    if raw.len == 0 { return; };
    let nrm = StrBuf { bytes: [0u8; 65536], len: 0 };
    task_deps_normalize(raw, cwd, &nrm);
    lb_append(list, sb_ptr(&nrm), nrm.len);
}

fn extractTaskDependencies(task: u64, cwd: &StrBuf, written: &ListBuf, read: &ListBuf) -> void {
    written.len = 0;
    read.len = 0;
    if task == 0 || sa_json_node_kind(task) != JK_OBJECT { return; };
    let raw_action = StrBuf { bytes: [0u8; 65536], len: 0 };
    task_str(task, STR_PTR("action"), STR_LEN("action"), &raw_action);
    sb_trim_ip(&raw_action);
    sb_lower_ip(&raw_action);
    let target = StrBuf { bytes: [0u8; 65536], len: 0 };
    if !task_str(task, STR_PTR("path"), STR_LEN("path"), &target) {
        if !task_str(task, STR_PTR("file"), STR_LEN("file"), &target) {
            task_str(task, STR_PTR("target"), STR_LEN("target"), &target);
        };
    };
    sb_trim_ip(&target);
    let action = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_append(&action, sb_ptr(&raw_action), raw_action.len);
    if raw_action.len == 0 {
        let src_node: u64 = jget_node(task, STR_PTR("source"), STR_LEN("source"));
        let has_source: bool = src_node != 0 && sa_json_node_kind(src_node) != JK_NULL && jnode_truthy(src_node);
        if !has_source && target.len > 0 {
            let probe = StrBuf { bytes: [0u8; 65536], len: 0 };
            let sniffed: bool = false;
            if task_str(task, STR_PTR("old_text"), STR_LEN("old_text"), &probe) || task_str(task, STR_PTR("oldText"), STR_LEN("oldText"), &probe) || task_str(task, STR_PTR("old_string"), STR_LEN("old_string"), &probe) || task_str(task, STR_PTR("oldString"), STR_LEN("oldString"), &probe) || task_str(task, STR_PTR("old"), STR_LEN("old"), &probe) {
                sb_append(&action, STR_PTR("edit_file"), STR_LEN("edit_file"));
                sniffed = true;
            };
            if !sniffed {
                if task_str(task, STR_PTR("patch"), STR_LEN("patch"), &probe) || task_str(task, STR_PTR("diff"), STR_LEN("diff"), &probe) {
                    sb_append(&action, STR_PTR("apply_patch"), STR_LEN("apply_patch"));
                    sniffed = true;
                };
            };
            if !sniffed {
                let has_body: bool = false;
                if jget_node(task, STR_PTR("content"), STR_LEN("content")) != 0 { has_body = true; };
                if jget_node(task, STR_PTR("contents"), STR_LEN("contents")) != 0 { has_body = true; };
                if jget_node(task, STR_PTR("text"), STR_LEN("text")) != 0 { has_body = true; };
                if jget_node(task, STR_PTR("body"), STR_LEN("body")) != 0 { has_body = true; };
                if jget_node(task, STR_PTR("data"), STR_LEN("data")) != 0 { has_body = true; };
                if has_body {
                    sb_append(&action, STR_PTR("write_file"), STR_LEN("write_file"));
                } else {
                    sb_append(&action, STR_PTR("read_file"), STR_LEN("read_file"));
                };
            };
        };
    };
    let tmp = StrBuf { bytes: [0u8; 65536], len: 0 };
    let tmp2 = StrBuf { bytes: [0u8; 65536], len: 0 };
    // ---- write-action chain ----
    if sb_eq(&action, STR_PTR("write_file"), STR_LEN("write_file")) || sb_eq(&action, STR_PTR("write"), STR_LEN("write")) || sb_eq(&action, STR_PTR("edit_file"), STR_LEN("edit_file")) || sb_eq(&action, STR_PTR("edit"), STR_LEN("edit")) || sb_eq(&action, STR_PTR("delete_file"), STR_LEN("delete_file")) || sb_eq(&action, STR_PTR("delete"), STR_LEN("delete")) || sb_eq(&action, STR_PTR("safe_delete"), STR_LEN("safe_delete")) || sb_eq(&action, STR_PTR("remove_file"), STR_LEN("remove_file")) {
        task_deps_push(written, &target, cwd);
    } else if sb_eq(&action, STR_PTR("copy_file"), STR_LEN("copy_file")) || sb_eq(&action, STR_PTR("copy"), STR_LEN("copy")) || sb_eq(&action, STR_PTR("move_file"), STR_LEN("move_file")) || sb_eq(&action, STR_PTR("move"), STR_LEN("move")) || sb_eq(&action, STR_PTR("rename"), STR_LEN("rename")) || sb_eq(&action, STR_PTR("rename_file"), STR_LEN("rename_file")) {
        if task_str2(task, STR_PTR("to"), STR_LEN("to"), STR_PTR("dest"), STR_LEN("dest"), &tmp) { sb_trim_ip(&tmp); task_deps_push(written, &tmp, cwd); };
        if task_str2(task, STR_PTR("from"), STR_LEN("from"), STR_PTR("source"), STR_LEN("source"), &tmp) { sb_trim_ip(&tmp); task_deps_push(read, &tmp, cwd); };
    } else if sb_eq(&action, STR_PTR("extract_to_file"), STR_LEN("extract_to_file")) || sb_eq(&action, STR_PTR("extract_file"), STR_LEN("extract_file")) || sb_eq(&action, STR_PTR("extract_module"), STR_LEN("extract_module")) || sb_eq(&action, STR_PTR("extract_component"), STR_LEN("extract_component")) || sb_eq(&action, STR_PTR("extract_hook"), STR_LEN("extract_hook")) {
        if task_str2(task, STR_PTR("source"), STR_LEN("source"), STR_PTR("from"), STR_LEN("from"), &tmp) {
            sb_trim_ip(&tmp);
            task_deps_push(written, &tmp, cwd);
            task_deps_push(read, &tmp, cwd);
        };
        if task_str2(task, STR_PTR("target"), STR_LEN("target"), STR_PTR("to"), STR_LEN("to"), &tmp) { sb_trim_ip(&tmp); task_deps_push(written, &tmp, cwd); };
    } else if sb_eq(&action, STR_PTR("add_import"), STR_LEN("add_import")) || sb_eq(&action, STR_PTR("insert_import"), STR_LEN("insert_import")) || sb_eq(&action, STR_PTR("organize_imports"), STR_LEN("organize_imports")) || sb_eq(&action, STR_PTR("clean_unused_imports"), STR_LEN("clean_unused_imports")) || sb_eq(&action, STR_PTR("sort_imports"), STR_LEN("sort_imports")) || sb_eq(&action, STR_PTR("auto_fix_missing_imports"), STR_LEN("auto_fix_missing_imports")) || sb_eq(&action, STR_PTR("fix_missing_imports"), STR_LEN("fix_missing_imports")) {
        task_deps_push(written, &target, cwd);
    } else if sb_eq(&action, STR_PTR("rename_symbol"), STR_LEN("rename_symbol")) || sb_eq(&action, STR_PTR("symbol_rename"), STR_LEN("symbol_rename")) {
        task_deps_push(written, &target, cwd);
        if task_str(task, STR_PTR("dir"), STR_LEN("dir"), &tmp) { sb_trim_ip(&tmp); task_deps_push(written, &tmp, cwd); };
        let farr: u64 = jget_node(task, STR_PTR("files"), STR_LEN("files"));
        if farr != 0 && sa_json_node_kind(farr) == JK_ARRAY {
            let fc: u64 = jcount(farr);
            let fi: u64 = 0;
            while fi < fc {
                let el: u64 = jarr_at(farr, fi);
                if el != 0 && sa_json_node_kind(el) == JK_STRING {
                    tmp.len = 0;
                    let p: ptr = PTR_NULL();
                    let n: u64 = 0;
                    let gst: i32 = sa_json_node_string(el, &p, &n);
                    sb_append(&tmp, p, n);
                    sb_trim_ip(&tmp);
                    task_deps_push(written, &tmp, cwd);
                };
                fi = fi + 1;
            }
        };
        let carr: u64 = jget_node(task, STR_PTR("candidate_files"), STR_LEN("candidate_files"));
        if carr != 0 && sa_json_node_kind(carr) == JK_ARRAY {
            let cc: u64 = jcount(carr);
            let ci2: u64 = 0;
            while ci2 < cc {
                let el2: u64 = jarr_at(carr, ci2);
                if el2 != 0 && sa_json_node_kind(el2) == JK_STRING {
                    tmp.len = 0;
                    let p2: ptr = PTR_NULL();
                    let n2: u64 = 0;
                    let gst2: i32 = sa_json_node_string(el2, &p2, &n2);
                    sb_append(&tmp, p2, n2);
                    sb_trim_ip(&tmp);
                    task_deps_push(written, &tmp, cwd);
                };
                ci2 = ci2 + 1;
            }
        };
    } else if sb_eq(&action, STR_PTR("move_file_with_imports"), STR_LEN("move_file_with_imports")) || sb_eq(&action, STR_PTR("move_with_imports"), STR_LEN("move_with_imports")) {
        if task_str(task, STR_PTR("from"), STR_LEN("from"), &tmp) || task_str(task, STR_PTR("source"), STR_LEN("source"), &tmp) || task_str(task, STR_PTR("path"), STR_LEN("path"), &tmp) {
            sb_trim_ip(&tmp);
            task_deps_push(written, &tmp, cwd);
            task_deps_push(read, &tmp, cwd);
        };
        if task_str2(task, STR_PTR("to"), STR_LEN("to"), STR_PTR("dest"), STR_LEN("dest"), &tmp) { sb_trim_ip(&tmp); task_deps_push(written, &tmp, cwd); };
    } else if sb_eq(&action, STR_PTR("ensure_dir"), STR_LEN("ensure_dir")) || sb_eq(&action, STR_PTR("mkdir"), STR_LEN("mkdir")) {
        if task_str(task, STR_PTR("dir"), STR_LEN("dir"), &tmp) { sb_trim_ip(&tmp); task_deps_push(written, &tmp, cwd); } else { task_deps_push(written, &target, cwd); };
    } else if sb_eq(&action, STR_PTR("apply_patch"), STR_LEN("apply_patch")) || sb_eq(&action, STR_PTR("patch"), STR_LEN("patch")) {
        if task_str(task, STR_PTR("patch"), STR_LEN("patch"), &tmp) {
            let re: u64 = sa_regex_compile(STR_PTR("^\\*\\*\\*[[:space:]]*(Add File|Update File|Delete File):[[:space:]]*(.+)"), STR_LEN("^\\*\\*\\*[[:space:]]*(Add File|Update File|Delete File):[[:space:]]*(.+)"), 1);
            if re != 0 {
                let pp: ptr = sb_ptr(&tmp);
                let start: u64 = 0;
                let li: u64 = 0;
                while li <= tmp.len {
                    let at_end: bool = li == tmp.len;
                    let is_nl: bool = false;
                    if !at_end { if byte_at(pp, li) == 10 { is_nl = true; }; };
                    if at_end || is_nl {
                        let lp: ptr = PTR_NULL();
                        PTR_BYTE_ADD(lp, pp, start);
                        let grp = StrBuf { bytes: [0u8; 65536], len: 0 };
                        if re_first_group(re, lp, li - start, 2, &grp) {
                            sb_trim_ip(&grp);
                            task_deps_push(written, &grp, cwd);
                        };
                        start = li + 1;
                    };
                    li = li + 1;
                }
                sa_regex_free(re);
            };
        };
    } else if sb_eq(&action, STR_PTR("split_plan"), STR_LEN("split_plan")) {
        task_deps_push(read, &target, cwd);
    } else if sb_eq(&action, STR_PTR("split_stage"), STR_LEN("split_stage")) || sb_eq(&action, STR_PTR("split_refine"), STR_LEN("split_refine")) || sb_eq(&action, STR_PTR("split_repair"), STR_LEN("split_repair")) {
        let ops: u64 = jget_node(task, STR_PTR("ops"), STR_LEN("ops"));
        if ops == 0 || sa_json_node_kind(ops) != JK_ARRAY { ops = jget_node(task, STR_PTR("tasks"), STR_LEN("tasks")); };
        if ops != 0 && sa_json_node_kind(ops) == JK_ARRAY {
            let oc: u64 = jcount(ops);
            let oi: u64 = 0;
            while oi < oc {
                let op: u64 = jarr_at(ops, oi);
                if op != 0 && sa_json_node_kind(op) == JK_OBJECT {
                    if task_str(op, STR_PTR("path"), STR_LEN("path"), &tmp) { sb_trim_ip(&tmp); task_deps_push(written, &tmp, cwd); };
                };
                oi = oi + 1;
            }
        };
        task_deps_push(written, &target, cwd);
    } else if sb_eq(&action, STR_PTR("split_status"), STR_LEN("split_status")) {
        // no dependencies
    } else if sb_eq(&action, STR_PTR("run_host"), STR_LEN("run_host")) || sb_eq(&action, STR_PTR("exec_host"), STR_LEN("exec_host")) || sb_eq(&action, STR_PTR("host"), STR_LEN("host")) {
        if task_str2(task, STR_PTR("output"), STR_LEN("output"), STR_PTR("output_file"), STR_LEN("output_file"), &tmp) { sb_trim_ip(&tmp); task_deps_push(written, &tmp, cwd); };
        let arr_node: u64 = jget_node(task, STR_PTR("args"), STR_LEN("args"));
        if arr_node != 0 && sa_json_node_kind(arr_node) == JK_ARRAY {
            let ac: u64 = jcount(arr_node);
            let strs = ByteList { items: [0u8; 4096], len: 0 };
            let ai: u64 = 0;
            while ai < ac {
                let el: u64 = jarr_at(arr_node, ai);
                tmp.len = 0;
                if el != 0 && sa_json_node_kind(el) == JK_STRING {
                    let p: ptr = PTR_NULL();
                    let n: u64 = 0;
                    let gst: i32 = sa_json_node_string(el, &p, &n);
                    sb_append(&tmp, p, n);
                };
                bl_push(&strs, sb_ptr(&tmp), tmp.len);
                ai = ai + 1;
            }
            let sc: u64 = bl_count(&strs);
            let has_build: bool = false;
            let bi: u64 = 0;
            while bi < sc {
                if bl_at(&strs, bi, &tmp) {
                    let lw = StrBuf { bytes: [0u8; 65536], len: 0 };
                    sb_append(&lw, sb_ptr(&tmp), tmp.len);
                    sb_lower_ip(&lw);
                    if sb_eq(&lw, STR_PTR("build"), STR_LEN("build")) || sb_eq(&lw, STR_PTR("compile"), STR_LEN("compile")) || sb_eq(&lw, STR_PTR("build-exe"), STR_LEN("build-exe")) || sb_eq(&lw, STR_PTR("build-obj"), STR_LEN("build-obj")) || sb_eq(&lw, STR_PTR("build-lib"), STR_LEN("build-lib")) { has_build = true; };
                    if sb_eq(&tmp, STR_PTR("-o"), STR_LEN("-o")) || sb_eq(&tmp, STR_PTR("--output"), STR_LEN("--output")) {
                        if bi + 1 < sc {
                            if bl_at(&strs, bi + 1, &tmp2) {
                                if !sb_starts(&tmp2, STR_PTR("-"), STR_LEN("-")) { task_deps_push(written, &tmp2, cwd); };
                            };
                        };
                    };
                    let pi2: u64 = 0;
                    while pi2 < 5 {
                        let pre = StrBuf { bytes: [0u8; 65536], len: 0 };
                        if pi2 == 0 { sb_append(&pre, STR_PTR("-o="), STR_LEN("-o=")); };
                        if pi2 == 1 { sb_append(&pre, STR_PTR("--output="), STR_LEN("--output=")); };
                        if pi2 == 2 { sb_append(&pre, STR_PTR("-femit-bin="), STR_LEN("-femit-bin=")); };
                        if pi2 == 3 { sb_append(&pre, STR_PTR("-femit-implib="), STR_LEN("-femit-implib=")); };
                        if pi2 == 4 { sb_append(&pre, STR_PTR("--out-dir="), STR_LEN("--out-dir=")); };
                        if sb_starts(&tmp, sb_ptr(&pre), pre.len) {
                            let val = StrBuf { bytes: [0u8; 65536], len: 0 };
                            let vp: ptr = PTR_NULL();
                            PTR_BYTE_ADD(vp, sb_ptr(&tmp), pre.len);
                            sb_append(&val, vp, tmp.len - pre.len);
                            task_deps_push(written, &val, cwd);
                        };
                        pi2 = pi2 + 1;
                    }
                };
                bi = bi + 1;
            }
            if has_build {
                let bi2: u64 = 0;
                while bi2 < sc {
                    if bl_at(&strs, bi2, &tmp) {
                        let is_bin: bool = re_ci_test(STR_PTR("\\.(exe|bin|out|wasm|obj|o)$"), STR_LEN("\\.(exe|bin|out|wasm|obj|o)$"), &tmp);
                        let is_src: bool = re_ci_test(STR_PTR("\\.(sa|sla|zig|c|cpp|rs|ts|js)$"), STR_LEN("\\.(sa|sla|zig|c|cpp|rs|ts|js)$"), &tmp);
                        if is_bin && !is_src { task_deps_push(written, &tmp, cwd); };
                    };
                    bi2 = bi2 + 1;
                }
            };
        };
    };
    // ---- read-action set (separate if; grep family as else-if) ----
    let is_read_action: bool = false;
    if sb_eq(&action, STR_PTR("read_file"), STR_LEN("read_file")) || sb_eq(&action, STR_PTR("read"), STR_LEN("read")) || sb_eq(&action, STR_PTR("read_lines"), STR_LEN("read_lines")) || sb_eq(&action, STR_PTR("read_many"), STR_LEN("read_many")) || sb_eq(&action, STR_PTR("read_file_tail"), STR_LEN("read_file_tail")) || sb_eq(&action, STR_PTR("tail_file"), STR_LEN("tail_file")) || sb_eq(&action, STR_PTR("tail"), STR_LEN("tail")) || sb_eq(&action, STR_PTR("count_lines"), STR_LEN("count_lines")) || sb_eq(&action, STR_PTR("line_count"), STR_LEN("line_count")) || sb_eq(&action, STR_PTR("file_info"), STR_LEN("file_info")) || sb_eq(&action, STR_PTR("test_path"), STR_LEN("test_path")) || sb_eq(&action, STR_PTR("file_exists"), STR_LEN("file_exists")) || sb_eq(&action, STR_PTR("exists"), STR_LEN("exists")) || sb_eq(&action, STR_PTR("stat"), STR_LEN("stat")) || sb_eq(&action, STR_PTR("get_diagnostics"), STR_LEN("get_diagnostics")) || sb_eq(&action, STR_PTR("diagnostics"), STR_LEN("diagnostics")) || sb_eq(&action, STR_PTR("check_syntax"), STR_LEN("check_syntax")) || sb_eq(&action, STR_PTR("workspace_diagnostics"), STR_LEN("workspace_diagnostics")) || sb_eq(&action, STR_PTR("file_outline"), STR_LEN("file_outline")) || sb_eq(&action, STR_PTR("outline"), STR_LEN("outline")) || sb_eq(&action, STR_PTR("workspace_outline"), STR_LEN("workspace_outline")) || sb_eq(&action, STR_PTR("repo_map"), STR_LEN("repo_map")) || sb_eq(&action, STR_PTR("find_files"), STR_LEN("find_files")) || sb_eq(&action, STR_PTR("find"), STR_LEN("find")) || sb_eq(&action, STR_PTR("list_files"), STR_LEN("list_files")) || sb_eq(&action, STR_PTR("list_dir"), STR_LEN("list_dir")) || sb_eq(&action, STR_PTR("find_references"), STR_LEN("find_references")) || sb_eq(&action, STR_PTR("find_all_references"), STR_LEN("find_all_references")) || sb_eq(&action, STR_PTR("find_implementations"), STR_LEN("find_implementations")) || sb_eq(&action, STR_PTR("find_impl"), STR_LEN("find_impl")) || sb_eq(&action, STR_PTR("find_definition"), STR_LEN("find_definition")) || sb_eq(&action, STR_PTR("goto_definition"), STR_LEN("goto_definition")) || sb_eq(&action, STR_PTR("def"), STR_LEN("def")) || sb_eq(&action, STR_PTR("analyze_scope"), STR_LEN("analyze_scope")) || sb_eq(&action, STR_PTR("scope_analysis"), STR_LEN("scope_analysis")) || sb_eq(&action, STR_PTR("code_graph"), STR_LEN("code_graph")) || sb_eq(&action, STR_PTR("relation_graph"), STR_LEN("relation_graph")) || sb_eq(&action, STR_PTR("symbol_graph"), STR_LEN("symbol_graph")) { is_read_action = true; };
    if is_read_action {
        task_deps_push(read, &target, cwd);
        if task_str(task, STR_PTR("dir"), STR_LEN("dir"), &tmp) { sb_trim_ip(&tmp); task_deps_push(read, &tmp, cwd); };
        let farr2: u64 = jget_node(task, STR_PTR("files"), STR_LEN("files"));
        if farr2 != 0 && sa_json_node_kind(farr2) == JK_ARRAY {
            let fc2: u64 = jcount(farr2);
            let fi3: u64 = 0;
            while fi3 < fc2 {
                let el3: u64 = jarr_at(farr2, fi3);
                if el3 != 0 && sa_json_node_kind(el3) == JK_STRING {
                    tmp.len = 0;
                    let p3: ptr = PTR_NULL();
                    let n3: u64 = 0;
                    let gst3: i32 = sa_json_node_string(el3, &p3, &n3);
                    sb_append(&tmp, p3, n3);
                    sb_trim_ip(&tmp);
                    task_deps_push(read, &tmp, cwd);
                };
                fi3 = fi3 + 1;
            }
        };
    } else if sb_eq(&action, STR_PTR("grep_search"), STR_LEN("grep_search")) || sb_eq(&action, STR_PTR("grep"), STR_LEN("grep")) || sb_eq(&action, STR_PTR("grep_search_async"), STR_LEN("grep_search_async")) || sb_eq(&action, STR_PTR("grep_async"), STR_LEN("grep_async")) || sb_eq(&action, STR_PTR("async_grep"), STR_LEN("async_grep")) {
        task_deps_push(read, &target, cwd);
        if task_str(task, STR_PTR("dir"), STR_LEN("dir"), &tmp) { sb_trim_ip(&tmp); task_deps_push(read, &tmp, cwd); };
    };
}

fn detectBatchDependencyViolation(tasks: u64, cwd: &StrBuf, kind_out: &StrBuf, conflicted_out: &StrBuf, widx: &u64, ridx: &u64) -> bool {
    kind_out.len = 0;
    conflicted_out.len = 0;
    *widx = 0;
    *ridx = 0;
    if tasks == 0 || sa_json_node_kind(tasks) != JK_ARRAY { return false; };
    let tcount: u64 = jcount(tasks);
    let map_keys = ListBuf { bytes: [0u8; 131072], len: 0 };
    let map_idx = U64List { items: [0u64; 4096], len: 0 };
    let wlist = ListBuf { bytes: [0u8; 131072], len: 0 };
    let rlist = ListBuf { bytes: [0u8; 131072], len: 0 };
    let p = StrBuf { bytes: [0u8; 65536], len: 0 };
    let ti: u64 = 0;
    while ti < tcount {
        let task: u64 = jarr_at(tasks, ti);
        wlist.len = 0;
        rlist.len = 0;
        extractTaskDependencies(task, cwd, &wlist, &rlist);
        let wc: u64 = lb_count(&wlist);
        let wi: u64 = 0;
        while wi < wc {
            if lb_at(&wlist, wi, &p) {
                let found_at: i64 = -1;
                let mc: u64 = lb_count(&map_keys);
                let mi: u64 = 0;
                let kp = StrBuf { bytes: [0u8; 65536], len: 0 };
                while mi < mc {
                    if lb_at(&map_keys, mi, &kp) {
                        if sb_eq(&kp, sb_ptr(&p), p.len) { found_at = mi as i64; break; };
                    };
                    mi = mi + 1;
                }
                if found_at >= 0 {
                    let prev_idx: u64 = map_idx.items[found_at as u64];
                    if prev_idx != ti {
                        sb_append(kind_out, STR_PTR("write-write"), STR_LEN("write-write"));
                        sb_append(conflicted_out, sb_ptr(&p), p.len);
                        *widx = prev_idx;
                        *ridx = ti;
                        return true;
                    };
                } else {
                    lb_append(&map_keys, sb_ptr(&p), p.len);
                    map_idx.items[map_idx.len] = ti;
                    map_idx.len = map_idx.len + 1;
                };
            };
            wi = wi + 1;
        }
        ti = ti + 1;
    }
    if map_idx.len == 0 { return false; };
    let ti2: u64 = 0;
    while ti2 < tcount {
        let task2: u64 = jarr_at(tasks, ti2);
        wlist.len = 0;
        rlist.len = 0;
        extractTaskDependencies(task2, cwd, &wlist, &rlist);
        let rc: u64 = lb_count(&rlist);
        let ri: u64 = 0;
        while ri < rc {
            if lb_at(&rlist, ri, &p) {
                let mc2: u64 = lb_count(&map_keys);
                let mi2: u64 = 0;
                let kp2 = StrBuf { bytes: [0u8; 65536], len: 0 };
                while mi2 < mc2 {
                    if lb_at(&map_keys, mi2, &kp2) {
                        if sb_eq(&kp2, sb_ptr(&p), p.len) {
                            let widx2: u64 = map_idx.items[mi2];
                            if widx2 != ti2 {
                                sb_append(kind_out, STR_PTR("read-after-write"), STR_LEN("read-after-write"));
                                let rawp = StrBuf { bytes: [0u8; 65536], len: 0 };
                                if !task_str(task2, STR_PTR("path"), STR_LEN("path"), &rawp) {
                                    if !task_str(task2, STR_PTR("file"), STR_LEN("file"), &rawp) {
                                        if !task_str(task2, STR_PTR("target"), STR_LEN("target"), &rawp) {
                                            sb_append(&rawp, sb_ptr(&p), p.len);
                                        };
                                    };
                                };
                                sb_append(conflicted_out, sb_ptr(&rawp), rawp.len);
                                *widx = widx2;
                                *ridx = ti2;
                                return true;
                            };
                        };
                    };
                    mi2 = mi2 + 1;
                }
            };
            ri = ri + 1;
        }
        ti2 = ti2 + 1;
    }
    return false;
}

fn legacy_capture(source: &StrBuf, pat: ptr, patn: u64, group: u64, out: &StrBuf) -> bool {
    out.len = 0;
    let re: u64 = sa_regex_compile(pat, patn, 1);
    if re == 0 { return false; };
    let r: bool = re_first_group(re, sb_ptr(source), source.len, group, out);
    sa_regex_free(re);
    return r;
}

fn tryHandleLegacyTemplateSourceNatively(source: &StrBuf, policy_doc: u64, cwd: &StrBuf, started_at: f64, out: &SaVmRunResult) -> bool {
    if source.len == 0 { return false; };
    let empty1 = JsonBuf { bytes: [0u8; 262144], len: 0 };
    let empty2 = JsonBuf { bytes: [0u8; 262144], len: 0 };
    let cap = StrBuf { bytes: [0u8; 65536], len: 0 };
    if tool_sb_contains(source, STR_PTR("sa_fs_find_files_to_stdout"), STR_LEN("sa_fs_find_files_to_stdout")) {
        let dir = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_append(&dir, STR_PTR("."), STR_LEN("."));
        if legacy_capture(source, STR_PTR("let[[:space:]]+dir[[:space:]]*=[[:space:]]*\"([^\"]*)\";"), STR_LEN("let[[:space:]]+dir[[:space:]]*=[[:space:]]*\"([^\"]*)\";"), 1, &cap) {
            dir.len = 0;
            sb_append(&dir, sb_ptr(&cap), cap.len);
        };
        let pattern = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_append(&pattern, STR_PTR("*"), STR_LEN("*"));
        if legacy_capture(source, STR_PTR("let[[:space:]]+pattern[[:space:]]*=[[:space:]]*\"([^\"]*)\";"), STR_LEN("let[[:space:]]+pattern[[:space:]]*=[[:space:]]*\"([^\"]*)\";"), 1, &cap) {
            pattern.len = 0;
            sb_append(&pattern, sb_ptr(&cap), cap.len);
        };
        nativeFindFiles(&dir, &pattern, 100.0, 5.0, policy_doc, cwd, started_at, &empty1, &empty2, out);
        return true;
    };
    if tool_sb_contains(source, STR_PTR("sa_fs_read_lines_to_stdout"), STR_LEN("sa_fs_read_lines_to_stdout")) {
        if !legacy_capture(source, STR_PTR("let[[:space:]]+(p|path)[[:space:]]*=[[:space:]]*\"([^\"]*)\";"), STR_LEN("let[[:space:]]+(p|path)[[:space:]]*=[[:space:]]*\"([^\"]*)\";"), 2, &cap) { return false; };
        let pth = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_append(&pth, sb_ptr(&cap), cap.len);
        let start_line: f64 = 1.0;
        let end_line: f64 = 101.0;
        let g1 = StrBuf { bytes: [0u8; 65536], len: 0 };
        let g2 = StrBuf { bytes: [0u8; 65536], len: 0 };
        let re2: u64 = sa_regex_compile(STR_PTR("sa_fs_read_lines_to_stdout\\([^,]+,[[:space:]]*[^,]+,[[:space:]]*([0-9]+),[[:space:]]*([0-9]+)"), STR_LEN("sa_fs_read_lines_to_stdout\\([^,]+,[[:space:]]*[^,]+,[[:space:]]*([0-9]+),[[:space:]]*([0-9]+)"), 1);
        if re2 != 0 {
            if re_first_group(re2, sb_ptr(source), source.len, 1, &g1) {
                let okp: bool = false;
                let v1: i64 = parse_i64_bytes(sb_ptr(&g1), g1.len, &okp);
                if okp { start_line = v1 as f64; end_line = start_line + 100.0; };
                if re_first_group(re2, sb_ptr(source), source.len, 2, &g2) {
                    let okp2: bool = false;
                    let v2: i64 = parse_i64_bytes(sb_ptr(&g2), g2.len, &okp2);
                    if okp2 { end_line = v2 as f64; };
                };
            };
            sa_regex_free(re2);
        };
        let opts = JsonBuf { bytes: [0u8; 262144], len: 0 };
        jb_append(&opts, STR_PTR("65536"), STR_LEN("65536"));
        nativeReadLines(&pth, start_line, end_line, &opts, policy_doc, cwd, started_at, out);
        return true;
    };
    if tool_sb_contains(source, STR_PTR("sa_fs_read_to_stdout"), STR_LEN("sa_fs_read_to_stdout")) {
        if !legacy_capture(source, STR_PTR("let[[:space:]]+(p|path)[[:space:]]*=[[:space:]]*\"([^\"]*)\";"), STR_LEN("let[[:space:]]+(p|path)[[:space:]]*=[[:space:]]*\"([^\"]*)\";"), 2, &cap) { return false; };
        let pth2 = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_append(&pth2, sb_ptr(&cap), cap.len);
        let opts2 = JsonBuf { bytes: [0u8; 262144], len: 0 };
        jb_append(&opts2, STR_PTR("65536"), STR_LEN("65536"));
        nativeReadFile(&pth2, &opts2, policy_doc, cwd, started_at, out);
        return true;
    };
    if tool_sb_contains(source, STR_PTR("sa_fs_write_file"), STR_LEN("sa_fs_write_file")) {
        if !legacy_capture(source, STR_PTR("let[[:space:]]+(p|path)[[:space:]]*=[[:space:]]*\"([^\"]*)\";"), STR_LEN("let[[:space:]]+(p|path)[[:space:]]*=[[:space:]]*\"([^\"]*)\";"), 2, &cap) { return false; };
        let pth3 = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_append(&pth3, sb_ptr(&cap), cap.len);
        let content = StrBuf { bytes: [0u8; 65536], len: 0 };
        if legacy_capture(source, STR_PTR("let[[:space:]]+(c|content)[[:space:]]*=[[:space:]]*\"([^\"]*)\";"), STR_LEN("let[[:space:]]+(c|content)[[:space:]]*=[[:space:]]*\"([^\"]*)\";"), 2, &cap) {
            sb_append(&content, sb_ptr(&cap), cap.len);
        };
        nativeWriteFile(&pth3, &content, policy_doc, cwd, started_at, &empty1, out);
        return true;
    };
    if tool_sb_contains(source, STR_PTR("sa_fs_edit_file"), STR_LEN("sa_fs_edit_file")) {
        if !legacy_capture(source, STR_PTR("let[[:space:]]+(p|path)[[:space:]]*=[[:space:]]*\"([^\"]*)\";"), STR_LEN("let[[:space:]]+(p|path)[[:space:]]*=[[:space:]]*\"([^\"]*)\";"), 2, &cap) { return false; };
        let pth4 = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_append(&pth4, sb_ptr(&cap), cap.len);
        if !legacy_capture(source, STR_PTR("let[[:space:]]+(ot|old_text|old)[[:space:]]*=[[:space:]]*\"([^\"]*)\";"), STR_LEN("let[[:space:]]+(ot|old_text|old)[[:space:]]*=[[:space:]]*\"([^\"]*)\";"), 2, &cap) { return false; };
        let ot = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_append(&ot, sb_ptr(&cap), cap.len);
        if !legacy_capture(source, STR_PTR("let[[:space:]]+(nt|new_text|new)[[:space:]]*=[[:space:]]*\"([^\"]*)\";"), STR_LEN("let[[:space:]]+(nt|new_text|new)[[:space:]]*=[[:space:]]*\"([^\"]*)\";"), 2, &cap) { return false; };
        let nt = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_append(&nt, sb_ptr(&cap), cap.len);
        nativeEditFile(&pth4, &ot, &nt, policy_doc, cwd, started_at, &empty1, out);
        return true;
    };
    return false;
}

fn parseReadLineBound(node: u64, out: &f64) -> bool {
    *out = 0.0;
    if node == 0 { return false; };
    let k: u64 = sa_json_node_kind(node);
    if k == JK_INT || k == JK_FLOAT {
        let v: f64 = sa_json_node_as_f64(node);
        *out = (v as i64) as f64;
        return true;
    };
    if k == JK_STRING {
        let s = StrBuf { bytes: [0u8; 65536], len: 0 };
        let p: ptr = PTR_NULL();
        let n: u64 = 0;
        let gst: i32 = sa_json_node_string(node, &p, &n);
        sb_append(&s, p, n);
        sb_trim_ip(&s);
        if s.len == 0 { return false; };
        let sp: ptr = sb_ptr(&s);
        let i: u64 = 0;
        if byte_at(sp, 0) == 45 { i = 1; };
        let digits_start: u64 = i;
        while i < s.len && byte_at(sp, i) >= 48 && byte_at(sp, i) <= 57 { i = i + 1; }
        if i == digits_start { return false; };
        if i < s.len && byte_at(sp, i) == 46 {
            i = i + 1;
            let frac_start: u64 = i;
            while i < s.len && byte_at(sp, i) >= 48 && byte_at(sp, i) <= 57 { i = i + 1; }
            if i == frac_start { return false; };
        };
        if i != s.len { return false; };
        let okf1: bool = false;
        let v2: f64 = parse_f64_bytes(sp, s.len, &okf1);
        *out = (v2 as i64) as f64;
        return true;
    };
    return false;
}

fn pickLineBound(doc: u64, keys: &ByteList, out: &f64) -> bool {
    *out = 0.0;
    if doc == 0 { return false; };
    let cnt: u64 = bl_count(keys);
    let i: u64 = 0;
    let key = StrBuf { bytes: [0u8; 65536], len: 0 };
    while i < cnt {
        if bl_at(keys, i, &key) {
            let node: u64 = jget_node(doc, sb_ptr(&key), key.len);
            if node != 0 {
                if parseReadLineBound(node, out) { return true; };
            };
        };
        i = i + 1;
    }
    return false;
}

fn hex_val(b: u8) -> i64 {
    if b >= 48 && b <= 57 { return (b - 48) as i64; };
    if b >= 65 && b <= 70 { return (b - 55) as i64; };
    if b >= 97 && b <= 102 { return (b - 87) as i64; };
    return -1;
}

fn percent_decode(src: &StrBuf, out: &StrBuf) -> void {
    out.len = 0;
    let sp: ptr = sb_ptr(src);
    let i: u64 = 0;
    while i < src.len {
        let b: u8 = byte_at(sp, i);
        if b == 37 && i + 2 < src.len {
            let h1: i64 = hex_val(byte_at(sp, i + 1));
            let h2: i64 = hex_val(byte_at(sp, i + 2));
            if h1 >= 0 && h2 >= 0 {
                sb_push_byte(out, ((h1 * 16 + h2) as u64) as u8);
                i = i + 3;
                continue;
            };
        };
        sb_push_byte(out, b);
        i = i + 1;
    }
}

fn extractRawFilePath(doc: u64, out: &StrBuf) -> void {
    out.len = 0;
    if doc == 0 { return; };
    let ki: u64 = 0;
    let found_node: u64 = 0;
    while ki < 12 {
        let key = StrBuf { bytes: [0u8; 65536], len: 0 };
        if ki == 0 { sb_append(&key, STR_PTR("path"), STR_LEN("path")); };
        if ki == 1 { sb_append(&key, STR_PTR("file"), STR_LEN("file")); };
        if ki == 2 { sb_append(&key, STR_PTR("target"), STR_LEN("target")); };
        if ki == 3 { sb_append(&key, STR_PTR("filePath"), STR_LEN("filePath")); };
        if ki == 4 { sb_append(&key, STR_PTR("file_path"), STR_LEN("file_path")); };
        if ki == 5 { sb_append(&key, STR_PTR("targetFile"), STR_LEN("targetFile")); };
        if ki == 6 { sb_append(&key, STR_PTR("target_file"), STR_LEN("target_file")); };
        if ki == 7 { sb_append(&key, STR_PTR("filename"), STR_LEN("filename")); };
        if ki == 8 { sb_append(&key, STR_PTR("fileName"), STR_LEN("fileName")); };
        if ki == 9 { sb_append(&key, STR_PTR("AbsolutePath"), STR_LEN("AbsolutePath")); };
        if ki == 10 { sb_append(&key, STR_PTR("absolute_path"), STR_LEN("absolute_path")); };
        if ki == 11 { sb_append(&key, STR_PTR("uri"), STR_LEN("uri")); };
        let node: u64 = jget_node(doc, sb_ptr(&key), key.len);
        if node != 0 && sa_json_node_kind(node) != JK_NULL {
            found_node = node;
            break;
        };
        ki = ki + 1;
    }
    if found_node == 0 { return; };
    if sa_json_node_kind(found_node) != JK_STRING { return; };
    let p: ptr = PTR_NULL();
    let n: u64 = 0;
    let gst: i32 = sa_json_node_string(found_node, &p, &n);
    sb_append(out, p, n);
    sb_trim_ip(out);
    if sb_starts(out, STR_PTR("file://"), STR_LEN("file://")) {
        let off: u64 = 7;
        if out.len > 9 {
            let op: ptr = sb_ptr(out);
            let is_drive: bool = byte_at(op, 7) == 47 && ((byte_at(op, 8) >= 65 && byte_at(op, 8) <= 90) || (byte_at(op, 8) >= 97 && byte_at(op, 8) <= 122)) && byte_at(op, 9) == 58;
            if is_drive { off = 8; };
        };
        let rest = StrBuf { bytes: [0u8; 65536], len: 0 };
        let rp: ptr = PTR_NULL();
        PTR_BYTE_ADD(rp, sb_ptr(out), off);
        sb_append(&rest, rp, out.len - off);
        percent_decode(&rest, out);
    };
}

fn denyJevActiveTool(policy_doc: u64, action: &StrBuf, flag: &StrBuf, started_at: f64, out: &SaVmRunResult) -> bool {
    if policy_doc == 0 { return false; };
    let tools: u64 = jget_node(policy_doc, STR_PTR("tools"), STR_LEN("tools"));
    if tools == 0 || sa_json_node_kind(tools) != JK_OBJECT { return false; };
    let fnode: u64 = jget_node(tools, sb_ptr(flag), flag.len);
    if fnode == 0 || sa_json_node_kind(fnode) != JK_BOOL { return false; };
    if sa_json_node_as_bool(fnode) { return false; };
    let em = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_append(&em, STR_PTR("action '"), STR_LEN("action '"));
    sb_append(&em, sb_ptr(action), action.len);
    sb_append(&em, STR_PTR("' is disabled in current VM policy; enable "), STR_LEN("' is disabled in current VM policy; enable "));
    sb_append(&em, sb_ptr(flag), flag.len);
    sb_append(&em, STR_PTR(" in enhancement tools to allow autonomous JEV calls"), STR_LEN(" in enhancement tools to allow autonomous JEV calls"));
    let rsn = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_append(&rsn, sb_ptr(flag), flag.len);
    sb_append(&rsn, STR_PTR(" disabled"), STR_LEN(" disabled"));
    res_capability2(out, &em, &rsn, started_at);
    return true;
}
// ---- batch 19c-2: runSaVmTool dispatcher ----

fn bopt(input: &SaVmRunInput) -> u64 {
    let jb = JsonBuf { bytes: [0u8; 262144], len: 0 };
    jdoc_to_jb(input.node, &jb);
    return jdoc_of_jb(&jb);
}

fn bopt_jb(doc: u64, out: &JsonBuf) -> void {
    out.len = 0;
    if doc != 0 {
        jdoc_to_jb(doc, out);
        sa_json_free(doc);
    };
}

fn doc_num(doc: u64, key: ptr, klen: u64, out: &f64) -> bool {
    *out = 0.0;
    let node: u64 = jget_node(doc, key, klen);
    if node != 0 && (sa_json_node_kind(node) == JK_INT || sa_json_node_kind(node) == JK_FLOAT) {
        *out = sa_json_node_as_f64(node);
        return true;
    };
    return false;
}

fn doc_str(doc: u64, key: ptr, klen: u64, out: &StrBuf) -> bool {
    out.len = 0;
    let node: u64 = jget_node(doc, key, klen);
    if node != 0 && sa_json_node_kind(node) == JK_STRING {
        let p: ptr = PTR_NULL();
        let n: u64 = 0;
        let gst: i32 = sa_json_node_string(node, &p, &n);
        sb_append(out, p, n);
        return true;
    };
    return false;
}

fn doc_str_trimmed(doc: u64, key: ptr, klen: u64, out: &StrBuf) -> bool {
    if doc_str(doc, key, klen, out) {
        sb_trim_ip(out);
        return out.len > 0;
    };
    return false;
}

// ?? chain: first present non-null node wins, transplanted to canonical key.
fn alias_resolve(doc: u64, canon: ptr, cn: u64, keys: &ByteList) -> void {
    let cnt: u64 = bl_count(keys);
    let i: u64 = 0;
    let key = StrBuf { bytes: [0u8; 65536], len: 0 };
    while i < cnt {
        if bl_at(keys, i, &key) {
            let node: u64 = jget_node(doc, sb_ptr(&key), key.len);
            if node != 0 && sa_json_node_kind(node) != JK_NULL {
                if !sb_eq(&key, canon, cn) {
                    jset_node(doc, canon, cn, node);
                };
                return;
            };
        };
        i = i + 1;
    }
}

fn alias_pg(doc: u64) -> void {
    let ch = ByteList { items: [0u8; 4096], len: 0 };
    ch.len = 0;
    bl_push(&ch, STR_PTR("page"), STR_LEN("page"));
    bl_push(&ch, STR_PTR("page_num"), STR_LEN("page_num"));
    bl_push(&ch, STR_PTR("pageNum"), STR_LEN("pageNum"));
    bl_push(&ch, STR_PTR("p"), STR_LEN("p"));
    alias_resolve(doc, STR_PTR("page"), STR_LEN("page"), &ch);
    ch.len = 0;
    bl_push(&ch, STR_PTR("page_size"), STR_LEN("page_size"));
    bl_push(&ch, STR_PTR("pageSize"), STR_LEN("pageSize"));
    bl_push(&ch, STR_PTR("per_page"), STR_LEN("per_page"));
    bl_push(&ch, STR_PTR("perPage"), STR_LEN("perPage"));
    alias_resolve(doc, STR_PTR("page_size"), STR_LEN("page_size"), &ch);
    ch.len = 0;
    bl_push(&ch, STR_PTR("count_cap"), STR_LEN("count_cap"));
    bl_push(&ch, STR_PTR("countCap"), STR_LEN("countCap"));
    bl_push(&ch, STR_PTR("max_total"), STR_LEN("max_total"));
    alias_resolve(doc, STR_PTR("count_cap"), STR_LEN("count_cap"), &ch);
    ch.len = 0;
    bl_push(&ch, STR_PTR("exact_total"), STR_LEN("exact_total"));
    bl_push(&ch, STR_PTR("exactTotal"), STR_LEN("exactTotal"));
    alias_resolve(doc, STR_PTR("exact_total"), STR_LEN("exact_total"), &ch);
    ch.len = 0;
    bl_push(&ch, STR_PTR("is_regex"), STR_LEN("is_regex"));
    bl_push(&ch, STR_PTR("regex"), STR_LEN("regex"));
    alias_resolve(doc, STR_PTR("is_regex"), STR_LEN("is_regex"), &ch);
}

fn keys2(a: ptr, an: u64, b: ptr, bn: u64, out: &ByteList) -> void {
    out.len = 0;
    bl_push(out, a, an);
    bl_push(out, b, bn);
}

fn first_num3(doc: u64, k1: ptr, n1: u64, k2: ptr, n2: u64, k3: ptr, n3: u64, out: &f64) -> bool {
    if doc_num(doc, k1, n1, out) { return true; };
    if doc_num(doc, k2, n2, out) { return true; };
    return doc_num(doc, k3, n3, out);
}

fn proc_cwd_sb(out: &StrBuf) -> void {
    out.len = 0;
    let h: u64 = sa_env_current_dir();
    if h != 0 {
        let dp: ptr = sa_env_buffer_data(h);
        let dn: u64 = sa_env_buffer_len(h);
        sb_append(out, dp, dn);
        sa_env_buffer_free(h);
    };
}

struct NormalizedRunInput { source: GitBigBuf, is_py: bool, args: ByteList, cwd: StrBuf, deadline_ms: f64 }

fn runSaVmTool(input: &SaVmRunInput, override_doc: u64, has_override: bool, cwd_override: &StrBuf, has_cwd_override: bool, out: &SaVmRunResult) -> i32 {
    let started_at: f64 = now_ms();
    let doc: u64 = input.node;
    // ---- policy / cwd resolution ----
    let policy_doc: u64 = 0;
    let cwd = StrBuf { bytes: [0u8; 65536], len: 0 };
    let tmp = StrBuf { bytes: [0u8; 65536], len: 0 };
    let opts_form: bool = false;
    if has_override && override_doc != 0 && sa_json_node_kind(override_doc) == JK_OBJECT {
        if jget_node(override_doc, STR_PTR("cwd"), STR_LEN("cwd")) != 0 { opts_form = true; };
        if jget_node(override_doc, STR_PTR("policy"), STR_LEN("policy")) != 0 && jget_node(override_doc, STR_PTR("tools"), STR_LEN("tools")) == 0 { opts_form = true; };
    };
    if opts_form {
        if doc_str_trimmed(override_doc, STR_PTR("cwd"), STR_LEN("cwd"), &cwd) {
            // cwd from options
        } else if has_cwd_override {
            sb_append(&cwd, sb_ptr(cwd_override), cwd_override.len);
        } else if doc_str_trimmed(doc, STR_PTR("cwd"), STR_LEN("cwd"), &cwd) {
            // cwd from input
        } else {
            proc_cwd_sb(&cwd);
        };
        policy_doc = jget_node(override_doc, STR_PTR("policy"), STR_LEN("policy"));
        if policy_doc == 0 { policy_doc = jget_node(doc, STR_PTR("policy"), STR_LEN("policy")); };
    } else {
        if has_override { policy_doc = override_doc; };
        if policy_doc == 0 { policy_doc = jget_node(doc, STR_PTR("policy"), STR_LEN("policy")); };
        if has_cwd_override {
            sb_append(&cwd, sb_ptr(cwd_override), cwd_override.len);
        } else if doc_str_trimmed(doc, STR_PTR("cwd"), STR_LEN("cwd"), &cwd) {
            // cwd from input
        } else {
            proc_cwd_sb(&cwd);
        };
    };
    let has_policy: bool = policy_doc != 0;
    // ---- action + target backfill + sniffing ----
    let action = StrBuf { bytes: [0u8; 65536], len: 0 };
    doc_str(doc, STR_PTR("action"), STR_LEN("action"), &action);
    sb_trim_ip(&action);
    sb_lower_ip(&action);
    let tfp = StrBuf { bytes: [0u8; 65536], len: 0 };
    extractRawFilePath(doc, &tfp);
    if tfp.len > 0 {
        if jget_node(doc, STR_PTR("path"), STR_LEN("path")) == 0 { jset_str(doc, STR_PTR("path"), STR_LEN("path"), sb_ptr(&tfp), tfp.len); };
        if jget_node(doc, STR_PTR("file"), STR_LEN("file")) == 0 { jset_str(doc, STR_PTR("file"), STR_LEN("file"), sb_ptr(&tfp), tfp.len); };
        if jget_node(doc, STR_PTR("target"), STR_LEN("target")) == 0 { jset_str(doc, STR_PTR("target"), STR_LEN("target"), sb_ptr(&tfp), tfp.len); };
        input_resync(input);
    };
    let eff = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_append(&eff, sb_ptr(&action), action.len);
    if action.len == 0 {
        let src_node: u64 = jget_node(doc, STR_PTR("source"), STR_LEN("source"));
        let has_source: bool = src_node != 0 && jnode_truthy(src_node);
        if !has_source && tfp.len > 0 {
            let probe = StrBuf { bytes: [0u8; 65536], len: 0 };
            let is_old: bool = doc_str(doc, STR_PTR("old_text"), STR_LEN("old_text"), &probe) || doc_str(doc, STR_PTR("oldText"), STR_LEN("oldText"), &probe) || doc_str(doc, STR_PTR("old_string"), STR_LEN("old_string"), &probe) || doc_str(doc, STR_PTR("oldString"), STR_LEN("oldString"), &probe) || doc_str(doc, STR_PTR("old"), STR_LEN("old"), &probe);
            if is_old {
                sb_append(&eff, STR_PTR("edit_file"), STR_LEN("edit_file"));
            } else if doc_str(doc, STR_PTR("patch"), STR_LEN("patch"), &probe) || doc_str(doc, STR_PTR("diff"), STR_LEN("diff"), &probe) {
                sb_append(&eff, STR_PTR("apply_patch"), STR_LEN("apply_patch"));
            } else if jget_node(doc, STR_PTR("content"), STR_LEN("content")) != 0 || jget_node(doc, STR_PTR("contents"), STR_LEN("contents")) != 0 || jget_node(doc, STR_PTR("text"), STR_LEN("text")) != 0 || jget_node(doc, STR_PTR("body"), STR_LEN("body")) != 0 || jget_node(doc, STR_PTR("data"), STR_LEN("data")) != 0 {
                sb_append(&eff, STR_PTR("write_file"), STR_LEN("write_file"));
            } else {
                sb_append(&eff, STR_PTR("read_file"), STR_LEN("read_file"));
            };
        };
    };
    let ojb = JsonBuf { bytes: [0u8; 262144], len: 0 };
    let s1 = StrBuf { bytes: [0u8; 65536], len: 0 };
    let s2 = StrBuf { bytes: [0u8; 65536], len: 0 };
    let nv: f64 = 0.0;
    // ---- read / read_file ----
    if sb_eq(&eff, STR_PTR("read"), STR_LEN("read")) || sb_eq(&eff, STR_PTR("read_file"), STR_LEN("read_file")) || sb_eq(&eff, STR_PTR("vm-read"), STR_LEN("vm-read")) || sb_eq(&eff, STR_PTR("vm_read"), STR_LEN("vm_read")) || sb_eq(&eff, STR_PTR("read_lines"), STR_LEN("read_lines")) {
        if tfp.len == 0 {
            res_input_error(out, STR_PTR("action 'read_file' requires a 'path' parameter"), STR_LEN("action 'read_file' requires a 'path' parameter"), started_at);
            return 0;
        };
        let is_lines: bool = sb_eq(&eff, STR_PTR("read_lines"), STR_LEN("read_lines"));
        let tail_flag: bool = false;
        let tn: u64 = jget_node(doc, STR_PTR("tail"), STR_LEN("tail"));
        if tn != 0 && sa_json_node_kind(tn) == JK_BOOL && sa_json_node_as_bool(tn) { tail_flag = true; };
        let lines_neg: bool = false;
        let lines_v: f64 = 0.0;
        if doc_num(doc, STR_PTR("lines"), STR_LEN("lines"), &lines_v) { if lines_v < 0.0 { lines_neg = true; }; };
        if tail_flag || lines_neg {
            let od: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
            let lv: f64 = 100.0;
            if doc_num(doc, STR_PTR("lines"), STR_LEN("lines"), &nv) { lv = ((nv as i64) as f64); if lv < 0.0 { lv = 0.0 - lv; }; };
            jset_f64(od, STR_PTR("lines"), STR_LEN("lines"), lv);
            if first_num3(doc, STR_PTR("max_tokens"), STR_LEN("max_tokens"), STR_PTR("max_token"), STR_LEN("max_token"), STR_PTR("maxtoken"), STR_LEN("maxtoken"), &nv) { jset_f64(od, STR_PTR("maxTokens"), STR_LEN("maxTokens"), nv); };
            if first_num3(doc, STR_PTR("remaining_tokens"), STR_LEN("remaining_tokens"), STR_PTR("tokens_remaining"), STR_LEN("tokens_remaining"), STR_PTR("tokens_left"), STR_LEN("tokens_left"), &nv) { jset_f64(od, STR_PTR("remainingTokens"), STR_LEN("remainingTokens"), nv); };
            if doc_num(doc, STR_PTR("max_bytes"), STR_LEN("max_bytes"), &nv) { jset_f64(od, STR_PTR("maxBytes"), STR_LEN("maxBytes"), nv); };
            if doc_num(doc, STR_PTR("max_line_length"), STR_LEN("max_line_length"), &nv) { jset_f64(od, STR_PTR("maxLineLength"), STR_LEN("maxLineLength"), nv); };
            let numbered: bool = true;
            let nn: u64 = jget_node(doc, STR_PTR("numbered"), STR_LEN("numbered"));
            if nn != 0 && sa_json_node_kind(nn) == JK_BOOL && !sa_json_node_as_bool(nn) { numbered = false; };
            jset_bool(od, STR_PTR("numbered"), STR_LEN("numbered"), numbered);
            bopt_jb(od, &ojb);
            nativeReadFileTail(&tfp, &ojb, policy_doc, &cwd, started_at, out);
            return 0;
        };
        let od2: u64 = bopt(input);
        let kk = ByteList { items: [0u8; 4096], len: 0 };
        let bv: f64 = 0.0;
        if is_lines {
            let start_line: f64 = 1.0;
            keys2(STR_PTR("start_line"), STR_LEN("start_line"), STR_PTR("startLine"), STR_LEN("startLine"), &kk);
            if pickLineBound(doc, &kk, &bv) && bv > 0.0 { start_line = bv; };
            let end_line: f64 = start_line + 250.0;
            keys2(STR_PTR("end_line"), STR_LEN("end_line"), STR_PTR("endLine"), STR_LEN("endLine"), &kk);
            if pickLineBound(doc, &kk, &bv) && bv >= start_line { end_line = bv; };
