        sort_listbuf(&ctx.results);
        let paged = ListBuf { bytes: [0u8; 131072], len: 0 };
        let tpages: u64 = 0;
        let returned: u64 = 0;
        let hn: bool = false;
        let hp: bool = false;
        paginate_items(&ctx.results, &pg, &paged, &tpages, &returned, &hn, &hp);
        let truncated: bool = ctx.timed_out || ctx.truncated || total_results >= scan_cap;
        let ob = JsonBuf { bytes: [0u8; 262144], len: 0 };
        jb_append(&ob, STR_PTR("{\n  \"dir\": \""), STR_LEN("{\n  \"dir\": \""));
        jescape_into(dir, &ob);
        jb_append(&ob, STR_PTR("\",\n  \"pattern\": \""), STR_LEN("\",\n  \"pattern\": \""));
        jescape_into(pattern, &ob);
        jb_append(&ob, STR_PTR("\",\n  \"page\": "), STR_LEN("\",\n  \"page\": "));
        let t = StrBuf { bytes: [0u8; 65536], len: 0 };
        fmt_f64_sb(pg.page, &t);
        jb_append(&ob, sb_ptr(&t), t.len);
        jb_append(&ob, STR_PTR(",\n  \"page_size\": "), STR_LEN(",\n  \"page_size\": "));
        fmt_f64_sb(pg.page_size, &t);
        jb_append(&ob, sb_ptr(&t), t.len);
        jb_append(&ob, STR_PTR(",\n  \"total\": "), STR_LEN(",\n  \"total\": "));
        fmt_u64_sb(total_results, &t);
        jb_append(&ob, sb_ptr(&t), t.len);
        jb_append(&ob, STR_PTR(",\n  \"total_pages\": "), STR_LEN(",\n  \"total_pages\": "));
        fmt_u64_sb(tpages, &t);
        jb_append(&ob, sb_ptr(&t), t.len);
        jb_append(&ob, STR_PTR(",\n  \"returned\": "), STR_LEN(",\n  \"returned\": "));
        fmt_u64_sb(returned, &t);
        jb_append(&ob, sb_ptr(&t), t.len);
        jb_append(&ob, STR_PTR(",\n  \"has_next\": "), STR_LEN(",\n  \"has_next\": "));
        let show_next: bool = hn;
        if truncated { show_next = true; };
        if show_next { jb_append(&ob, STR_PTR("true"), STR_LEN("true")); } else { jb_append(&ob, STR_PTR("false"), STR_LEN("false")); };
        jb_append(&ob, STR_PTR(",\n  \"has_prev\": "), STR_LEN(",\n  \"has_prev\": "));
        if hp { jb_append(&ob, STR_PTR("true"), STR_LEN("true")); } else { jb_append(&ob, STR_PTR("false"), STR_LEN("false")); };
        jb_append(&ob, STR_PTR(",\n  \"truncated\": "), STR_LEN(",\n  \"truncated\": "));
        if truncated { jb_append(&ob, STR_PTR("true"), STR_LEN("true")); } else { jb_append(&ob, STR_PTR("false"), STR_LEN("false")); };
        if ctx.timed_out {
            jb_append(&ob, STR_PTR(",\n  \"timed_out\": true"), STR_LEN(",\n  \"timed_out\": true"));
        };
        jb_append(&ob, STR_PTR(",\n  \"files\": ["), STR_LEN(",\n  \"files\": ["));
        let e = StrBuf { bytes: [0u8; 65536], len: 0 };
        let fi: u64 = 0;
        let pc: u64 = lb_count(&paged);
        while fi < pc {
            let got: bool = lb_at(&paged, fi, &e);
            if got {
                if fi > 0 { jb_append(&ob, STR_PTR(","), STR_LEN(",")); };
                jb_append(&ob, STR_PTR("\n    \""), STR_LEN("\n    \""));
                jescape_into(&e, &ob);
                jb_append(&ob, STR_PTR("\""), STR_LEN("\""));
