        res_init(out);
        out.ok = false;
        res_set_kind(out, STR_PTR("timeout"), STR_LEN("timeout"));
        out.has_exitCode = true;
        out.exitCode = 124;
        res_set_stdout(out, STR_PTR("[]"), STR_LEN("[]"));
        let em = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_assign(&em, STR_PTR("find_files timed out after "), STR_LEN("find_files timed out after "));
        sb_append_f64(timeout_ms, &em);
        sb_append(&em, STR_PTR("ms"), STR_LEN("ms"));
