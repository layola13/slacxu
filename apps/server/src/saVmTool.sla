    let pretty = JsonBuf { bytes: [0u8; 262144], len: 0 };
    git_status_build(&branch, &upstream, has_upstream, ahead, behind, &repo_root, &st_paths, &st_xs, &st_ys, &st_origs, &st_hasorig, &us_paths, &us_xs, &us_ys, &us_origs, &us_hasorig, &ut_paths, truncated, &pretty);
    while pretty.len > (max_bytes as u64) && (lb_count(&st_paths) + lb_count(&us_paths) + lb_count(&ut_paths)) > 0 {
        if lb_count(&ut_paths) > 0 {
            lb_pop(&ut_paths);
        } else if lb_count(&us_paths) > 0 {
            lb_pop(&us_paths);
            lb_pop(&us_xs);
            lb_pop(&us_ys);
            lb_pop(&us_origs);
            if us_hasorig.len > 0 { us_hasorig.len = us_hasorig.len - 1; };
        } else if lb_count(&st_paths) > 0 {
            lb_pop(&st_paths);
            lb_pop(&st_xs);
            lb_pop(&st_ys);
            lb_pop(&st_origs);
