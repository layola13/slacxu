struct GrepCtx {
    cwd: StrBuf,
    pattern: StrBuf,
    path_pattern: StrBuf,
    has_path_pattern: bool,
    is_regex: i32,
    max_bytes: f64,
    respect_gi: bool,
    exclude_dirs: ByteList,
    limit: u64,
    timeout_ms: f64,
    started_at: f64,
    matches: GrepMatches,
    timed_out: bool,
    skipped_filtered: u64,
    skipped_large: u64,
    skipped_binary: u64,
}

fn grep_scan_text(ctx: &GrepCtx, matcher: &SearchMatcher, text: &StrBuf, rel: &StrBuf) -> void {
    if !matcher_test(matcher, text) { return; };
    let total: u64 = 0;
    let maxlen: u64 = 0;
    text_line_stats(sb_ptr(text), text.len, &total, &maxlen);
    let line = StrBuf { bytes: [0u8; 65536], len: 0 };
    let idx: u64 = 1;
    while idx <= total {
        if grep_matches_count(&ctx.matches) >= ctx.limit || ctx.timed_out { break; };
        if now_ms() - ctx.started_at > ctx.timeout_ms {
            ctx.timed_out = true;
            break;
        };
        let ls: u64 = 0;
        let ll: u64 = 0;
        let found: bool = text_line_span(sb_ptr(text), text.len, idx, &ls, &ll);
        if found {
            line.len = 0;
            let lp: ptr = PTR_NULL();
            PTR_BYTE_ADD(lp, sb_ptr(text), ls);
            sb_append(&line, lp, ll);
            if matcher_test(matcher, &line) {
                let trimmed = StrBuf { bytes: [0u8; 65536], len: 0 };
                tool_sb_trim(&line, &trimmed);
                grep_push(&ctx.matches, rel, idx, &trimmed);
            };
        };
        idx = idx + 1;
    }
}

fn grepSearch_walk(dir: &StrBuf, depth: u64, gi: &GitIgnoreRules, matcher: &SearchMatcher, ctx: &GrepCtx) -> void {
    if depth > 6 || grep_matches_count(&ctx.matches) >= ctx.limit || ctx.timed_out { return; };
    if now_ms() - ctx.started_at > ctx.timeout_ms {
        ctx.timed_out = true;
        return;
    };
    let names = ListBuf { bytes: [0u8; 131072], len: 0 };
