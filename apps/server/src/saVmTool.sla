    let branch = StrBuf { bytes: [0u8; 65536], len: 0 };
    let upstream = StrBuf { bytes: [0u8; 65536], len: 0 };
    let has_upstream: bool = false;
    let ahead: u64 = 0;
    let behind: u64 = 0;
    let st_paths = ListBuf { bytes: [0u8; 131072], len: 0 };
    let st_xs = ListBuf { bytes: [0u8; 131072], len: 0 };
    let st_ys = ListBuf { bytes: [0u8; 131072], len: 0 };
    let st_origs = ListBuf { bytes: [0u8; 131072], len: 0 };
    let st_hasorig = U64List { items: [0u64; 4096], len: 0 };
    let us_paths = ListBuf { bytes: [0u8; 131072], len: 0 };
    let us_xs = ListBuf { bytes: [0u8; 131072], len: 0 };
    let us_ys = ListBuf { bytes: [0u8; 131072], len: 0 };
    let us_origs = ListBuf { bytes: [0u8; 131072], len: 0 };
    let us_hasorig = U64List { items: [0u64; 4096], len: 0 };
    let ut_paths = ListBuf { bytes: [0u8; 131072], len: 0 };
    let base: ptr = gb_ptr(&r.stdout);
    let pos: u64 = 0;
    while pos < r.stdout.len {
        let eol: u64 = pos;
        while eol < r.stdout.len && byte_at(base, eol) != 10 { eol = eol + 1; }
        let line_end: u64 = eol;
        if line_end > pos && byte_at(base, line_end - 1) == 13 { line_end = line_end - 1; };
        let line = StrBuf { bytes: [0u8; 65536], len: 0 };
        let pb15463: ptr = PTR_NULL();
        PTR_BYTE_ADD(pb15463, base, pos);
        if line_end > pos { sb_append(&line, pb15463, line_end - pos); };
        pos = eol + 1;
        if line.len == 0 { continue; };
        if sb_starts(&line, STR_PTR("## "), STR_LEN("## ")) {
            let hdr = StrBuf { bytes: [0u8; 65536], len: 0 };
            let po15409_0: ptr = PTR_NULL();
            PTR_BYTE_ADD(po15409_0, sb_ptr(&line), 3);
            sb_append(&hdr, po15409_0, line.len - 3);
            parseGitBranchHeader(&hdr, &branch, &upstream, &has_upstream, &ahead, &behind);
            continue;
        };
        if line.len < 4 { continue; };
        let x: u8 = line.bytes[0];
        let y: u8 = line.bytes[1];
        let rest = StrBuf { bytes: [0u8; 65536], len: 0 };
        let po15417_0: ptr = PTR_NULL();
        PTR_BYTE_ADD(po15417_0, sb_ptr(&line), 3);
        sb_append(&rest, po15417_0, line.len - 3);
        if x == 63 && y == 63 {
            let pq = StrBuf { bytes: [0u8; 65536], len: 0 };
            stripGitQuotes(&rest, &pq);
            lb_append(&ut_paths, sb_ptr(&pq), pq.len);
            continue;
        };
        if x == 33 && y == 33 { continue; };
        let p = StrBuf { bytes: [0u8; 65536], len: 0 };
        let orig = StrBuf { bytes: [0u8; 65536], len: 0 };
        let has_orig: bool = false;
        let arrow: i64 = sb_index_of(&rest, STR_PTR(" -> "), STR_LEN(" -> "));
        if arrow >= 0 {
            let o_part = StrBuf { bytes: [0u8; 65536], len: 0 };
            sb_append(&o_part, sb_ptr(&rest), arrow as u64);
            stripGitQuotes(&o_part, &orig);
            has_orig = true;
            let p_part = StrBuf { bytes: [0u8; 65536], len: 0 };
            let pstart: u64 = (arrow as u64) + 4;
            let po15436_0: ptr = PTR_NULL();
            PTR_BYTE_ADD(po15436_0, sb_ptr(&rest), pstart);
            sb_append(&p_part, po15436_0, rest.len - pstart);
