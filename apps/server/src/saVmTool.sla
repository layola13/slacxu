    getSemanticDiagnosticsForContent(&target, &final_target, cwd, true, &sem_tgt_raw);
    let sem_tgt = SemanticIssueList { items: [SemanticIssue { line: 0, column: 0, message: [0u8; 1024], message_len: 0, preview: [0u8; 1024], preview_len: 0, code: [0u8; 64], code_len: 0, has_code: false }; 256], len: 0 };
