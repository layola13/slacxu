    };
    let ra: bool = false;
    let mo: bool = false;
    opts_wr_parse(options, &ra, &mo);
    let gate = gate_new();
    let grc: i32 = checkAccountabilityWriteGate(sb_ptr(&resolved), resolved.len, sb_ptr(content), content.len, mo, &gate);
    if gate_denied_result(&gate, out, started_at) { return 0; };
    let existing = StrBuf { bytes: [0u8; 65536], len: 0 };
    if fs_read_sb(&resolved, 65536, &existing) == 0 {
