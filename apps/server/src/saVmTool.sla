        if sem_is_blocking(&it) && blocking.len < 256 { blocking.items[blocking.len] = it; blocking.len = blocking.len + 1; };
        bi = bi + 1;
    }
    let hard = SemanticIssueList { items: [SemanticIssue { line: 0, column: 0, message: [0u8; 1024], message_len: 0, preview: [0u8; 1024], preview_len: 0, code: [0u8; 64], code_len: 0, has_code: false }; 256], len: 0 };
    let warnings = SemanticIssueList { items: [SemanticIssue { line: 0, column: 0, message: [0u8; 1024], message_len: 0, preview: [0u8; 1024], preview_len: 0, code: [0u8; 64], code_len: 0, has_code: false }; 256], len: 0 };
    splitEnvironmentalErrors(&st, &source, &content, &blocking, &hard, &warnings);
