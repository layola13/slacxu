    if sb_eq(s, STR_PTR("bench"), STR_LEN("bench")) { return true; };
    if sb_eq(s, STR_PTR("--version"), STR_LEN("--version")) { return true; };
    if sb_eq(s, STR_PTR("-v"), STR_LEN("-v")) { return true; };
    if sb_eq(s, STR_PTR("-V"), STR_LEN("-V")) { return true; };
    if sb_eq(s, STR_PTR("--help"), STR_LEN("--help")) { return true; };
