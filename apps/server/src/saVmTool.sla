    if path_is_abs(from_path) {
        path_normalize(from_path, &resolved_from);
    } else {
        path_resolve(cwd, from_path, &resolved_from);
    };
    let resolved_to = StrBuf { bytes: [0u8; 65536], len: 0 };
    if path_is_abs(to_path) {
        path_normalize(to_path, &resolved_to);
    } else {
        path_resolve(cwd, to_path, &resolved_to);
    };
    let reason = StrBuf { bytes: [0u8; 65536], len: 0 };
    if !toolCheckPath(&norm, 2, from_path, cwd, &reason) {
        let em = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_assign(&em, STR_PTR("transfer "), STR_LEN("transfer "));
        sb_append(&em, sb_ptr(from_path), from_path.len);
        sb_append(&em, STR_PTR(": "), STR_LEN(": "));
        sb_append(&em, sb_ptr(&reason), reason.len);
        res_capability2(out, &em, &reason, started_at);
