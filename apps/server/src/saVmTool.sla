    normalize_policy(policy_doc, cwd, &norm);
    let start = StrBuf { bytes: [0u8; 65536], len: 0 };
    let st_trim = StrBuf { bytes: [0u8; 65536], len: 0 };
    tool_sb_trim(start_path, &st_trim);
    if st_trim.len > 0 { sb_copy(&start, &st_trim); } else { sb_copy(&start, cwd); };
    let rsn = StrBuf { bytes: [0u8; 65536], len: 0 };
    if !toolCheckPath(&norm, 0, &start, cwd, &rsn) {
