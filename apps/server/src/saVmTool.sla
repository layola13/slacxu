}

struct WorkspaceOutlineCtx {
    candidates: ListBuf,
    skipped_filtered: u64,
    timed_out: bool,
}

fn workspaceOutline_walk(ctx: &WorkspaceOutlineCtx, cur: &StrBuf, depth: u64, gi: &GitIgnoreRules, exclude_dirs: &ByteList, file_pattern: &StrBuf, path_pattern: &StrBuf, has_path_pattern: bool, is_regex: i32, cwd: &StrBuf, cap: u64, started_at: f64, timeout_ms: f64) -> void {
    if depth > 6 || lb_count(&ctx.candidates) >= cap || ctx.timed_out { return; };
    if now_ms() - started_at > timeout_ms {
        ctx.timed_out = true;
        return;
    };
    let names = ListBuf { bytes: [0u8; 131072], len: 0 };
    let kinds = U64List { items: [0u64; 4096], len: 0 };
    if !list_dir_names(cur, &names, &kinds) { return; };
    let cnt: u64 = lb_count(&names);
    let name = StrBuf { bytes: [0u8; 65536], len: 0 };
    let ii: u64 = 0;
    while ii < cnt {
        if lb_count(&ctx.candidates) >= cap || ctx.timed_out { break; };
        if now_ms() - started_at > timeout_ms {
            ctx.timed_out = true;
            break;
        };
        let got: bool = lb_at(&names, ii, &name);
        if got {
            let kind: u64 = kinds.items[ii];
            let is_dir: bool = kind == 2;
            let full = StrBuf { bytes: [0u8; 65536], len: 0 };
            path_join(cur, &name, &full);
            let rel = StrBuf { bytes: [0u8; 65536], len: 0 };
            tool_path_relative(cwd, &full, &rel);
            if isGitIgnored(&name, is_dir, gi, &rel, true) {
                ctx.skipped_filtered = ctx.skipped_filtered + 1;
            } else if isExcludedRelPath(&rel, exclude_dirs) {
                ctx.skipped_filtered = ctx.skipped_filtered + 1;
            } else if is_dir {
                workspaceOutline_walk(ctx, &full, depth + 1, gi, exclude_dirs, file_pattern, path_pattern, has_path_pattern, is_regex, cwd, cap, started_at, timeout_ms);
            } else if kind == 1 {
                let pp = StrBuf { bytes: [0u8; 65536], len: 0 };
                let has_pp: bool = false;
                if has_path_pattern { sb_copy(&pp, path_pattern); has_pp = true; };
                if matchesFilePattern(&name, &rel, file_pattern, &pp, has_pp, is_regex) {
                    lb_append(&ctx.candidates, sb_ptr(&full), full.len);
                };
            };
        };
        ii = ii + 1;
    }
}

