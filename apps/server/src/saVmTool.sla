            first_part = false;
        };
        if ctx.skipped_large > 0 {
            if !first_part { sb_append(&skipped_note, STR_PTR("; "), STR_LEN("; ")); };
            sb_append(&skipped_note, STR_PTR("skipped "), STR_LEN("skipped "));
            tool_sb_append_u64(ctx.skipped_large, &skipped_note);
            sb_append(&skipped_note, STR_PTR(" files exceeding max_file_bytes="), STR_LEN(" files exceeding max_file_bytes="));
            sb_append_f64(max_bytes, &skipped_note);
            first_part = false;
        };
        if ctx.skipped_binary > 0 {
            if !first_part { sb_append(&skipped_note, STR_PTR("; "), STR_LEN("; ")); };
            sb_append(&skipped_note, STR_PTR("skipped "), STR_LEN("skipped "));
            tool_sb_append_u64(ctx.skipped_binary, &skipped_note);
            sb_append(&skipped_note, STR_PTR(" binary files"), STR_LEN(" binary files"));
        };
        sb_append(&skipped_note, STR_PTR("."), STR_LEN("."));
    };
    let joined_note = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_append(&joined_note, sb_ptr(&timeout_note), timeout_note.len);
    if timeout_note.len > 0 && skipped_note.len > 0 { sb_append(&joined_note, STR_PTR(" "), STR_LEN(" ")); };
    sb_append(&joined_note, sb_ptr(&skipped_note), skipped_note.len);
    if pg.paginated {
        grep_sort_matches(&matches);
        let truncated: bool = ctx.timed_out || grep_matches_count(&matches) > grep_cap;
        let sliced = GrepMatches { files: ListBuf { bytes: [0u8; 131072], len: 0 }, lines: U64List { items: [0u64; 4096], len: 0 }, contents: ListBuf { bytes: [0u8; 131072], len: 0 }, queries: ListBuf { bytes: [0u8; 131072], len: 0 } };
        grep_slice(&matches, grep_cap, &sliced);
        let rc: i32 = grep_paginated_result(&sliced, &pg, query, search_dir, pattern, truncated, &joined_note, ctx.timed_out, grep_cap, out, started_at);
        return rc;
    };
    let rc: i32 = applyGrepCircuitBreaker(&matches, &norm, &joined_note, started_at, out);
    return rc;
}

// ---- nativeGrepSearchAsync (source L2497) ----
// Worker pool lands sequentially in queue order (FIX S4); matchers
// are kept as parallel arrays (mode/handle/lower per query).
struct GrepAsyncScanCtx {
    cwd: StrBuf,
    pattern: StrBuf,
    path_pattern: StrBuf,
    has_path_pattern: bool,
    is_regex: i32,
    respect_gi: bool,
    exclude_dirs: ByteList,
    queue: ListBuf,
    skipped_filtered: u64,
    timeout_ms: f64,
    started_at: f64,
    timed_out: bool,
}

fn grepAsync_scanDir(dir: &StrBuf, depth: u64, gi: &GitIgnoreRules, ctx: &GrepAsyncScanCtx) -> void {
    if depth > 6 || ctx.timed_out { return; };
    if now_ms() - ctx.started_at > ctx.timeout_ms {
        ctx.timed_out = true;
        return;
    };
    let names = ListBuf { bytes: [0u8; 131072], len: 0 };
    let kinds = U64List { items: [0u64; 4096], len: 0 };
    if !list_dir_names(dir, &names, &kinds) { return; };
    let cnt: u64 = lb_count(&names);
    let idx = U64List { items: [0u64; 4096], len: 0 };
    let i0: u64 = 0;
    while i0 < cnt && idx.len < 4096 {
        idx.items[idx.len] = i0;
        idx.len = idx.len + 1;
        i0 = i0 + 1;
    }
    let ea = StrBuf { bytes: [0u8; 65536], len: 0 };
    let eb = StrBuf { bytes: [0u8; 65536], len: 0 };
    let x: u64 = 1;
    while x < idx.len {
        let key: u64 = idx.items[x];
        let gk: bool = lb_at(&names, key, &ea);
        let y: u64 = x;
        while y > 0 {
            let g2: bool = lb_at(&names, idx.items[y - 1], &eb);
            if bytes_cmp(&eb, &ea) <= 0 { break; };
            idx.items[y] = idx.items[y - 1];
            y = y - 1;
        }
        idx.items[y] = key;
        x = x + 1;
    }
    let subs = ListBuf { bytes: [0u8; 131072], len: 0 };
    let name = StrBuf { bytes: [0u8; 65536], len: 0 };
    let ii: u64 = 0;
    while ii < cnt {
        let got: bool = lb_at(&names, idx.items[ii], &name);
        if got {
            let kind: u64 = kinds.items[idx.items[ii]];
            let is_dir: bool = kind == 2;
            let is_file: bool = kind == 1;
            let full = StrBuf { bytes: [0u8; 65536], len: 0 };
            path_join(dir, &name, &full);
            let rel = StrBuf { bytes: [0u8; 65536], len: 0 };
            tool_path_relative(&ctx.cwd, &full, &rel);
            if ctx.respect_gi && isGitIgnored(&name, is_dir, gi, &rel, true) {
                ctx.skipped_filtered = ctx.skipped_filtered + 1;
            } else if is_dir && isExcludedRelPath(&rel, &ctx.exclude_dirs) {
                ctx.skipped_filtered = ctx.skipped_filtered + 1;
            } else if is_dir {
                if depth < 6 { lb_append(&subs, sb_ptr(&full), full.len); };
            } else if is_file {
                if matchesFilePattern(&name, &rel, &ctx.pattern, &ctx.path_pattern, ctx.has_path_pattern, ctx.is_regex) {
                    lb_append(&ctx.queue, sb_ptr(&full), full.len);
                };
            };
        };
        ii = ii + 1;
    }
    let sub = StrBuf { bytes: [0u8; 65536], len: 0 };
    let si: u64 = 0;
    let sc: u64 = lb_count(&subs);
    while si < sc {
        let got: bool = lb_at(&subs, si, &sub);
        if got { grepAsync_scanDir(&sub, depth + 1, gi, ctx); };
        si = si + 1;
    }
}

fn grepAsync_paginated_result(items: &GrepMatches, pg: &ResolvedPagination, queries: &ListBuf, dir: &StrBuf, pattern: &StrBuf, truncated: bool, timed_out: bool, note: &StrBuf, grep_cap: u64, with_query: bool, out: &SaVmRunResult, started_at: f64) -> i32 {
    let total: u64 = grep_matches_count(items);
    let ps: u64 = pg.page_size as u64;
    if ps == 0 { ps = 1; };
    let tpages: u64 = 0;
    if total > 0 { tpages = (total + ps - 1) / ps; };
    let off: u64 = pg.offset as u64;
    let end: u64 = off + ps;
    if end > total { end = total; };
    let has_next: bool = off + ps < total;
    let has_prev: bool = off > 0;
    let page_items = GrepMatches { files: ListBuf { bytes: [0u8; 131072], len: 0 }, lines: U64List { items: [0u64; 4096], len: 0 }, contents: ListBuf { bytes: [0u8; 131072], len: 0 }, queries: ListBuf { bytes: [0u8; 131072], len: 0 } };
    let f = StrBuf { bytes: [0u8; 65536], len: 0 };
    let c = StrBuf { bytes: [0u8; 65536], len: 0 };
    let q = StrBuf { bytes: [0u8; 65536], len: 0 };
    let i: u64 = off;
    while i < end {
        let g1: bool = lb_at(&items.files, i, &f);
        let g2: bool = lb_at(&items.contents, i, &c);
        if with_query {
            let g3: bool = lb_at(&items.queries, i, &q);
            grep_push_q(&page_items, &f, items.lines.items[i], &c, &q);
        } else {
            grep_push(&page_items, &f, items.lines.items[i], &c);
        };
        i = i + 1;
    }
    let returned: u64 = grep_matches_count(&page_items);
    let ob = JsonBuf { bytes: [0u8; 262144], len: 0 };
    jb_append(&ob, STR_PTR("{\n  \"queries\": ["), STR_LEN("{\n  \"queries\": ["));
    let qq = StrBuf { bytes: [0u8; 65536], len: 0 };
    let qi: u64 = 0;
    let qc: u64 = lb_count(queries);
    while qi < qc {
        let got: bool = lb_at(queries, qi, &qq);
        if got {
            if qi > 0 { jb_append(&ob, STR_PTR(","), STR_LEN(",")); };
            jb_append(&ob, STR_PTR("\n    \""), STR_LEN("\n    \""));
            jescape_into(&qq, &ob);
            jb_append(&ob, STR_PTR("\""), STR_LEN("\""));
        };
        qi = qi + 1;
    }
    if qc > 0 { jb_append(&ob, STR_PTR("\n  "), STR_LEN("\n  ")); };
    jb_append(&ob, STR_PTR("],\n  \"dir\": \""), STR_LEN("],\n  \"dir\": \""));
    jescape_into(dir, &ob);
    jb_append(&ob, STR_PTR("\",\n  \"pattern\": \""), STR_LEN("\",\n  \"pattern\": \""));
    jescape_into(pattern, &ob);
    let t = StrBuf { bytes: [0u8; 65536], len: 0 };
    jb_append(&ob, STR_PTR("\",\n  \"page\": "), STR_LEN("\",\n  \"page\": "));
    fmt_f64_sb(pg.page, &t);
    jb_append(&ob, sb_ptr(&t), t.len);
    jb_append(&ob, STR_PTR(",\n  \"page_size\": "), STR_LEN(",\n  \"page_size\": "));
    fmt_f64_sb(pg.page_size, &t);
    jb_append(&ob, sb_ptr(&t), t.len);
    jb_append(&ob, STR_PTR(",\n  \"total\": "), STR_LEN(",\n  \"total\": "));
    fmt_u64_sb(total, &t);
    jb_append(&ob, sb_ptr(&t), t.len);
    jb_append(&ob, STR_PTR(",\n  \"total_pages\": "), STR_LEN(",\n  \"total_pages\": "));
    fmt_u64_sb(tpages, &t);
    jb_append(&ob, sb_ptr(&t), t.len);
    jb_append(&ob, STR_PTR(",\n  \"returned\": "), STR_LEN(",\n  \"returned\": "));
    fmt_u64_sb(returned, &t);
    jb_append(&ob, sb_ptr(&t), t.len);
    jb_append(&ob, STR_PTR(",\n  \"has_next\": "), STR_LEN(",\n  \"has_next\": "));
    if truncated || has_next { jb_append(&ob, STR_PTR("true"), STR_LEN("true")); } else { jb_append(&ob, STR_PTR("false"), STR_LEN("false")); };
    jb_append(&ob, STR_PTR(",\n  \"has_prev\": "), STR_LEN(",\n  \"has_prev\": "));
    if has_prev { jb_append(&ob, STR_PTR("true"), STR_LEN("true")); } else { jb_append(&ob, STR_PTR("false"), STR_LEN("false")); };
    jb_append(&ob, STR_PTR(",\n  \"truncated\": "), STR_LEN(",\n  \"truncated\": "));
    if truncated { jb_append(&ob, STR_PTR("true"), STR_LEN("true")); } else { jb_append(&ob, STR_PTR("false"), STR_LEN("false")); };
    if timed_out {
        jb_append(&ob, STR_PTR(",\n  \"timed_out\": true"), STR_LEN(",\n  \"timed_out\": true"));
    };
    jb_append(&ob, STR_PTR(",\n  \"matches\": "), STR_LEN(",\n  \"matches\": "));
    let inner = JsonBuf { bytes: [0u8; 262144], len: 0 };
    grep_matches_json(&page_items, false, with_query, &inner);
    let ii2: u64 = 0;
    while ii2 < inner.len {
        let b: u8 = inner.bytes[ii2];
        jb_push_byte(&ob, b);
        if b == 10 && ii2 + 1 < inner.len {
            jb_append(&ob, STR_PTR("  "), STR_LEN("  "));
        };
        ii2 = ii2 + 1;
    }
    jb_append(&ob, STR_PTR("\n}"), STR_LEN("\n}"));
    let se = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_append(&se, sb_ptr(note), note.len);
    if truncated && !timed_out {
        if se.len > 0 { sb_append(&se, STR_PTR(" "), STR_LEN(" ")); };
        sb_append(&se, STR_PTR("[grep_search_async] results capped at count_cap="), STR_LEN("[grep_search_async] results capped at count_cap="));
        tool_sb_append_u64(grep_cap, &se);
    };
    res_success(out, started_at);
    res_set_stdout(out, jb_ptr(&ob), ob.len);
    if se.len > 0 { res_set_stderr(out, sb_ptr(&se), se.len); };
    return 0;
}

fn nativeGrepSearchAsync(queries_in: &ListBuf, search_dir: &StrBuf, pattern: &StrBuf, max_matches: f64, concurrency: f64, policy_doc: u64, cwd: &StrBuf, started_at: f64, timeout_opts: &JsonBuf, extra_opts: &JsonBuf, out: &SaVmRunResult) -> i32 {
    // normalize query list: trim, drop empties
    let queries = ListBuf { bytes: [0u8; 131072], len: 0 };
    let qraw = StrBuf { bytes: [0u8; 65536], len: 0 };
    let qtrim = StrBuf { bytes: [0u8; 65536], len: 0 };
    let qi0: u64 = 0;
    let qc0: u64 = lb_count(queries_in);
    while qi0 < qc0 {
        let got: bool = lb_at(queries_in, qi0, &qraw);
        if got {
            tool_sb_trim(&qraw, &qtrim);
            if qtrim.len > 0 { lb_append(&queries, sb_ptr(&qtrim), qtrim.len); };
        };
        qi0 = qi0 + 1;
    }
    let edoc: u64 = jdoc_of_jb(extra_opts);
    let def_size: f64 = 50.0;
    if max_matches > 0.0 { def_size = max_matches; };
    let popts = PaginationOpts { default_size: def_size, max_size: 500.0, legacy_limit: max_matches, has_legacy_limit: true };
    let pg = ResolvedPagination { page: 0.0, page_size: 0.0, offset: 0.0, paginated: false, exact_total: false, count_cap: 0.0 };
    resolvePagination(edoc, &popts, &pg);
    let grep_cap: u64 = 50;
    if max_matches > 0.0 { grep_cap = (max_matches as i64) as u64; };
    if pg.paginated { grep_cap = pg.count_cap as u64; };
    let norm = NormalizedSaVmPolicy { engine: 0, fs: NormalizedFs { entries: FsEntryList { items: [SaVmFsEntry { path: [0u8; 1024], path_len: 0, access: 0 }; 128], len: 0 }, read: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, write: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, transfer: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, delete: 0, backupDir: [0u8; 1024], backupDir_len: 0, backupDir_has: false }, http_allow: HttpRuleList { items: [SaVmHttpAllowRule { host: [0u8; 512], host_len: 0, methods: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_methods: false, paths: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_paths: false }; 128], len: 0 }, env_allow: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, process: NormalizedProcess { spawn: false, exec: ExecRuleList { items: [SaVmProcessExecRule { path: [0u8; 4096], path_len: 0, args: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_args: false }; 128], len: 0 }, bunProfiles: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_bunProfiles: false, bun_enabled: false, bun_allowedSubcommands: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_bun: false }, execution_javascript: false, execution_python: false, tools: NormalizedTools { replaceRead: false, replaceWrite: false, replaceApplyPatch: false, replaceExec: false, readFiles: false, editFiles: false, applyPatch: false, fastSearch: false, clearToolHistory: false, findReferences: false, renameSymbol: false, fileOutline: false, moveWithImports: false, findDefinition: false, extractToFile: false, addImport: false, getDiagnostics: false, organizeImports: false, analyzeScope: false, codeGraph: false }, contextSavings: SaVmContextSavingsConfig { locateBeforeRead: false, maxReadFileBytes: 0, maxReadFileBytes_has: false, grepCircuitBreaker: false, grepMaxResults: 0, grepMaxResults_has: false, grepMaxTokens: 0, grepMaxTokens_has: false, slimRunnerOutput: false, parallelBudget: false, parallelMaxTotalBytes: 0, parallelMaxTotalBytes_has: false, parallelMaxReadFiles: 0, parallelMaxReadFiles_has: false, parallelDeduplication: false, tieredSkillInjection: false, foldWaterfallEvents: false, foldHistoryReadSummaries: false, historyReadFoldTurns: 0, historyReadFoldTurns_has: false }, contextSavings_has: false };
    normalize_policy(policy_doc, cwd, &norm);
    let resolved_dir = StrBuf { bytes: [0u8; 65536], len: 0 };
    if path_is_abs(search_dir) {
        path_normalize(search_dir, &resolved_dir);
    } else {
        path_resolve(cwd, search_dir, &resolved_dir);
    };
    let reason = StrBuf { bytes: [0u8; 65536], len: 0 };
    if !toolCheckPath(&norm, 0, search_dir, cwd, &reason) {
        if edoc != 0 { sa_json_free(edoc); };
        res_capability(out, &reason, started_at);
        return 0;
    };
    if lb_count(&queries) == 0 {
        if edoc != 0 { sa_json_free(edoc); };
        res_sa_error(out, STR_PTR("query or queries parameter is required for grep_search_async"), STR_LEN("query or queries parameter is required for grep_search_async"), started_at);
        return 0;
    };
    let limit: u64 = grep_cap;
    if !pg.paginated { limit = 50; if max_matches > 0.0 { limit = (max_matches as i64) as u64; }; };
    if pg.paginated { limit = grep_cap + 1; };
    let timeout_ms: f64 = resolveTimeoutMs(timeout_opts, 15000.0);
    let is_re: i32 = 0 - 1;
    let case_sens: bool = false;
    let path_pattern = StrBuf { bytes: [0u8; 65536], len: 0 };
    let has_pp: bool = false;
    let respect_gi: bool = true;
    let exclude_dirs = ByteList { items: [0u8; 4096], len: 0 };
    let explicit_max_node: u64 = 0;
    if edoc != 0 && sa_json_kind(edoc) == 7 {
        let ire: u64 = jget_node(edoc, STR_PTR("is_regex"), STR_LEN("is_regex"));
        if ire != 0 && sa_json_kind(ire) == 1 {
            if sa_json_node_as_bool(ire) { is_re = 1; } else { is_re = 0; };
        } else {
            let ire2: u64 = jget_node(edoc, STR_PTR("regex"), STR_LEN("regex"));
            if ire2 != 0 && sa_json_kind(ire2) == 1 {
                if sa_json_node_as_bool(ire2) { is_re = 1; } else { is_re = 0; };
            };
        };
        let csn: u64 = jget_node(edoc, STR_PTR("case_sensitive"), STR_LEN("case_sensitive"));
        if csn != 0 && sa_json_kind(csn) == 1 && sa_json_node_as_bool(csn) { case_sens = true; };
        if jget_str(edoc, STR_PTR("path_pattern"), STR_LEN("path_pattern"), &path_pattern) { has_pp = true; };
        let rgn: u64 = jget_node(edoc, STR_PTR("respect_gitignore"), STR_LEN("respect_gitignore"));
        if rgn != 0 && sa_json_kind(rgn) == 1 && !sa_json_node_as_bool(rgn) { respect_gi = false; };
        let exn: u64 = jget_node(edoc, STR_PTR("exclude_dirs"), STR_LEN("exclude_dirs"));
        if exn != 0 && sa_json_kind(exn) == 6 {
            let ec: u64 = jcount(exn);
            let ei: u64 = 0;
            let ev2 = StrBuf { bytes: [0u8; 65536], len: 0 };
            while ei < ec {
                let en: u64 = jarr_at(exn, ei);
                if en != 0 && sa_json_kind(en) == 5 {
                    ev2.len = 0;
                    sb_append(&ev2, jstr_ptr(en), sa_json_string_len(en));
                    bl_push(&exclude_dirs, sb_ptr(&ev2), ev2.len);
                };
                ei = ei + 1;
            }
        };
        explicit_max_node = node_nonnull(edoc, STR_PTR("max_file_bytes"), STR_LEN("max_file_bytes"));
        if explicit_max_node == 0 { explicit_max_node = node_nonnull(edoc, STR_PTR("maxFileBytes"), STR_LEN("maxFileBytes")); };
        if explicit_max_node == 0 { explicit_max_node = node_nonnull(edoc, STR_PTR("max_bytes"), STR_LEN("max_bytes")); };
    };
    // compile matchers into parallel arrays
    let m_modes = U64List { items: [0u64; 4096], len: 0 };
    let m_res = U64List { items: [0u64; 4096], len: 0 };
    let m_lowers = ListBuf { bytes: [0u8; 131072], len: 0 };
    let m_queries = ListBuf { bytes: [0u8; 131072], len: 0 };
    let qcount: u64 = lb_count(&queries);
    let mtmp = SearchMatcher { mode: 0, query: StrBuf { bytes: [0u8; 65536], len: 0 }, lower: StrBuf { bytes: [0u8; 65536], len: 0 }, re: 0 };
    let ci: u64 = 0;
    let one_q = StrBuf { bytes: [0u8; 65536], len: 0 };
    while ci < qcount && ci < 64 {
        let got: bool = lb_at(&queries, ci, &one_q);
        if got {
            compile_search_matcher(&one_q, is_re, case_sens, &mtmp);
            if m_modes.len < 4096 {
                m_modes.items[m_modes.len] = mtmp.mode;
                m_modes.len = m_modes.len + 1;
                m_res.items[m_res.len] = mtmp.re;
                m_res.len = m_res.len + 1;
            };
            lb_append(&m_lowers, sb_ptr(&mtmp.lower), mtmp.lower.len);
            lb_append(&m_queries, sb_ptr(&mtmp.query), mtmp.query.len);
            mtmp.re = 0;
        };
        ci = ci + 1;
    }
    let md: u64 = sa_fs_metadata(sb_ptr(&resolved_dir), resolved_dir.len);
    let is_file_target: bool = false;
    if md != 0 {
        is_file_target = sa_fs_metadata_is_file(md) == 1;
        let rcf: i32 = sa_std_fs_metadata_free(md);
    };
    let max_bytes: f64 = 0.0;
    if is_file_target {
        max_bytes = resolveMaxFileBytes(explicit_max_node, DEFAULT_SINGLE_FILE_SEARCH_MAX_BYTES as f64);
    } else {
        max_bytes = resolveMaxFileBytes(explicit_max_node, DEFAULT_SEARCH_MAX_FILE_BYTES as f64);
    };
    let sctx = GrepAsyncScanCtx { cwd: StrBuf { bytes: [0u8; 65536], len: 0 }, pattern: StrBuf { bytes: [0u8; 65536], len: 0 }, path_pattern: StrBuf { bytes: [0u8; 65536], len: 0 }, has_path_pattern: has_pp, is_regex: is_re, respect_gi: respect_gi, exclude_dirs: ByteList { items: [0u8; 4096], len: 0 }, queue: ListBuf { bytes: [0u8; 131072], len: 0 }, skipped_filtered: 0, timeout_ms: timeout_ms, started_at: started_at, timed_out: false };
    sb_copy(&sctx.cwd, cwd);
    sb_copy(&sctx.pattern, pattern);
    sb_copy(&sctx.path_pattern, &path_pattern);
    sctx.exclude_dirs = exclude_dirs;
    if is_file_target {
        lb_append(&sctx.queue, sb_ptr(&resolved_dir), resolved_dir.len);
    } else {
        let gi = GitIgnoreRules { pats: ListBuf { bytes: [0u8; 131072], len: 0 }, items: [GitRuleCore { negated: false, dir_only: false, has_slash: false, anchored: false, pat_line: 0 }; 512], len: 0 };
        if respect_gi { loadMergedGitIgnoreRules(cwd, search_dir, &gi); };
        grepAsync_scanDir(&resolved_dir, 0, &gi, &sctx);
    };
    if pg.paginated { sort_listbuf(&sctx.queue); };
    // sequential worker over the queue
    let matches = GrepMatches { files: ListBuf { bytes: [0u8; 131072], len: 0 }, lines: U64List { items: [0u64; 4096], len: 0 }, contents: ListBuf { bytes: [0u8; 131072], len: 0 }, queries: ListBuf { bytes: [0u8; 131072], len: 0 } };
    let timed_out: bool = sctx.timed_out;
    let terminated: bool = false;
    let skipped_large: u64 = 0;
    let skipped_binary: u64 = 0;
    let file = StrBuf { bytes: [0u8; 65536], len: 0 };
    let fi: u64 = 0;
    let fcount: u64 = lb_count(&sctx.queue);
    let multi: bool = qcount > 1;
    while fi < fcount {
        if terminated || grep_matches_count(&matches) >= limit { break; };
        if now_ms() - started_at > timeout_ms {
            terminated = true;
            timed_out = true;
            break;
        };
