    if pg.paginated { scan_cap = pg.count_cap as u64; };
    let ctx = FindCtx { cwd: StrBuf { bytes: [0u8; 65536], len: 0 }, resolved_dir: StrBuf { bytes: [0u8; 65536], len: 0 }, dir_orig: StrBuf { bytes: [0u8; 65536], len: 0 }, pattern: StrBuf { bytes: [0u8; 65536], len: 0 }, path_pattern: StrBuf { bytes: [0u8; 65536], len: 0 }, has_path_pattern: has_pp, is_regex: is_re, scan_cap: scan_cap, depth_limit: depth_limit, timeout_ms: timeout_ms, started_at: started_at, results: ListBuf { bytes: [0u8; 131072], len: 0 }, timed_out: false, truncated: false };
    sb_copy(&ctx.cwd, cwd);
