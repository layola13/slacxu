            let first = blocking.items[0];
            let prob = StrBuf { bytes: [0u8; 65536], len: 0 };
            sb_copy(&prob, &p);
            sb_append(&prob, STR_PTR(": "), STR_LEN(": "));
            tool_sb_append_u64(blocking.len, &prob);
            sb_append(&prob, STR_PTR(" semantic error(s): L"), STR_LEN(" semantic error(s): L"));
            tool_sb_append_u64(first.line, &prob);
            sb_append(&prob, STR_PTR(" "), STR_LEN(" "));
            let fp35: ptr = PTR_NULL(); PTR_BYTE_ADD(fp35, &first.code, 0); sb_append(&prob, fp35, first.code_len);
            sb_append(&prob, STR_PTR(" "), STR_LEN(" "));
            let fp36: ptr = PTR_NULL(); PTR_BYTE_ADD(fp36, &first.message, 0); sb_append(&prob, fp36, first.message_len);
            lb_append(&problems, sb_ptr(&prob), prob.len);
        };
    }
    if lb_count(&problems) > 0 {
        let em = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_assign(&em, STR_PTR("atomic_refactor blocked (0-write):"), STR_LEN("atomic_refactor blocked (0-write):"));
        let pv = StrBuf { bytes: [0u8; 65536], len: 0 };
        let pi: u64 = 0;
        while pi < lb_count(&problems) {
            let g1: bool = lb_at(&problems, pi, &pv);
            sb_append(&em, STR_PTR("\n- "), STR_LEN("\n- "));
            sb_append(&em, sb_ptr(&pv), pv.len);
            pi = pi + 1;
        }
        res_sa_error(out, sb_ptr(&em), em.len, started_at);
        out.has_exitCode = true;
        out.exitCode = 2;
        if odoc != 0 { sa_json_free(odoc); };
        return 0;
    };
    if dry_run {
        let out_sb = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_assign(&out_sb, STR_PTR("[atomic_refactor] DRY-RUN: "), STR_LEN("[atomic_refactor] DRY-RUN: "));
        tool_sb_append_u64(ops_count, &out_sb);
        sb_append(&out_sb, STR_PTR(" file(s) passed gates, 0 writes"), STR_LEN(" file(s) passed gates, 0 writes"));
        res_success(out, started_at);
        res_set_stdout(out, sb_ptr(&out_sb), out_sb.len);
        if odoc != 0 { sa_json_free(odoc); };
        return 0;
    };
    let oi2: u64 = 0;
    let ar_violated: bool = false;
    while oi2 < ops_count {
        let op: u64 = jarr_at(ops_doc, oi2);
        oi2 = oi2 + 1;
        if op == 0 || sa_json_kind(op) != 7 { continue; };
        let p = StrBuf { bytes: [0u8; 65536], len: 0 };
        let praw = StrBuf { bytes: [0u8; 65536], len: 0 };
        if !jget_str(op, STR_PTR("path"), STR_LEN("path"), &praw) { continue; };
        tool_sb_trim(&praw, &p);
        if p.len == 0 { continue; };
        let cn: u64 = node_nonnull(op, STR_PTR("content"), STR_LEN("content"));
        if cn == 0 || sa_json_kind(cn) != 5 { continue; };
        let content = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_append(&content, jstr_ptr(cn), sa_json_string_len(cn));
        let rsn = StrBuf { bytes: [0u8; 65536], len: 0 };
        if !toolCheckPath(&norm, 1, &p, cwd, &rsn) {
            let em = StrBuf { bytes: [0u8; 65536], len: 0 };
            sb_assign(&em, STR_PTR("Policy violation: "), STR_LEN("Policy violation: "));
            sb_append(&em, sb_ptr(&rsn), rsn.len);
            res_capability2(out, &em, &rsn, started_at);
            ar_violated = true;
            break;
        };
        let full = StrBuf { bytes: [0u8; 65536], len: 0 };
        path_resolve(cwd, &p, &full);
        let fd = StrBuf { bytes: [0u8; 65536], len: 0 };
        tool_path_dirname(&full, &fd);
        let rc1: i32 = sa_fs_mkdir_p(sb_ptr(&fd), fd.len);
        let wrc: i32 = fs_write_all(&full, sb_ptr(&content), content.len);
    }
    if ar_violated {
        if odoc != 0 { let frcv: i32 = sa_json_free(odoc); };
        return 0;
    };
    let out_sb = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_assign(&out_sb, STR_PTR("[atomic_refactor] APPLIED: "), STR_LEN("[atomic_refactor] APPLIED: "));
    tool_sb_append_u64(ops_count, &out_sb);
    sb_append(&out_sb, STR_PTR(" file(s)"), STR_LEN(" file(s)"));
    res_success(out, started_at);
    res_set_stdout(out, sb_ptr(&out_sb), out_sb.len);
    let ev: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    let eo: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    if ev != 0 && eo != 0 {
        jset_i64(eo, STR_PTR("timestamp"), STR_LEN("timestamp"), sa_time_unix_ms());
        jset_str(eo, STR_PTR("type"), STR_LEN("type"), STR_PTR("atomic_refactor"), STR_LEN("atomic_refactor"));
        jset_f64(eo, STR_PTR("count"), STR_LEN("count"), ops_count as f64);
        let rp: i32 = sa_json_array_push_node(ev, eo);
        let ejb = JsonBuf { bytes: [0u8; 262144], len: 0 };
        jdoc_to_jb(ev, &ejb);
        res_set_events(out, jb_ptr(&ejb), ejb.len);
        let bfix14539: i32 = sa_json_free(ev);
    } else {
        if ev != 0 { sa_json_free(ev); };
    };
    if odoc != 0 { sa_json_free(odoc); };
    return 0;
}

// ---- apply_patch / copy / file info / count lines ----
// Patch op kind tags (u8) for SaVmPatchOperation. The provider unit
// (saVmApplyPatch.sla) declares kind as u8 but its bulk-converted body does
// not yet assign values; this mapping is the Tool-side contract and is
// registered in FIX_SAVMTOOL.md for the provider unit to adopt:
// 1 = write (a = contents), 2 = edit (a = oldContents, b = newContents),
// 3 = delete, 4 = rename (a = from, b = to).
const PATCH_OP_WRITE: u64 = 1;
const PATCH_OP_EDIT: u64 = 2;
const PATCH_OP_DELETE: u64 = 3;
const PATCH_OP_RENAME: u64 = 4;

fn nativeApplyPatch(patch_text: &StrBuf, policy_doc: u64, cwd: &StrBuf, additional_roots: u64, started_at: f64, out: &SaVmRunResult) -> i32 {
    let zero_op = SaVmPatchOperation { kind: 0, path: [0u8; 2048], path_len: 0, a: [0u8; 65536], a_len: 0, b: [0u8; 65536], b_len: 0, backupPath: [0u8; 2048], backupPath_len: 0, has_backupPath: false };
    let checked = SaVmPatchResult { ok: false, operations: [SaVmPatchOperation { kind: 0, path: [0u8; 2048], path_len: 0, a: [0u8; 65536], a_len: 0, b: [0u8; 65536], b_len: 0, backupPath: [0u8; 2048], backupPath_len: 0, has_backupPath: false }; 256], operations_len: 0, reason: [0u8; 4096], reason_len: 0, policyDenied: false, has_policyDenied: false };
    parseAndCheckSaVmPatch(sb_ptr(patch_text), patch_text.len, sb_ptr(cwd), cwd.len, policy_doc, policy_doc != 0, additional_roots, &checked);
    if !checked.ok {
        // Format errors are the CALLER's mistake (sa_error); only genuine
        // policy denials are capability_denied.
        let denied: bool = checked.has_policyDenied && checked.policyDenied;
        let reason_sb = StrBuf { bytes: [0u8; 65536], len: 0 };
        let fp37: ptr = PTR_NULL(); PTR_BYTE_ADD(fp37, &checked.reason, 0); sb_append(&reason_sb, fp37, checked.reason_len);
        if denied {
            let em = StrBuf { bytes: [0u8; 65536], len: 0 };
            sb_assign(&em, STR_PTR("apply_patch denied: "), STR_LEN("apply_patch denied: "));
            sb_append(&em, sb_ptr(&reason_sb), reason_sb.len);
            res_capability2(out, &em, &reason_sb, started_at);
        } else {
            let em = StrBuf { bytes: [0u8; 65536], len: 0 };
            sb_assign(&em, STR_PTR("apply_patch error: "), STR_LEN("apply_patch error: "));
            sb_append(&em, sb_ptr(&reason_sb), reason_sb.len);
            res_sa_error(out, sb_ptr(&em), em.len, started_at);
        };
        return 0;
    };
    let empty_opts = JsonBuf { bytes: [0u8; 262144], len: 0 };
    let applied: u64 = 0;
    let oi: u64 = 0;
    while oi < checked.operations_len {
        let op = checked.operations[oi];
        oi = oi + 1;
        let path_sb = StrBuf { bytes: [0u8; 65536], len: 0 };
        let fp38: ptr = PTR_NULL(); PTR_BYTE_ADD(fp38, &op.path, 0); sb_append(&path_sb, fp38, op.path_len);
        let a_sb = StrBuf { bytes: [0u8; 65536], len: 0 };
        let fp39: ptr = PTR_NULL(); PTR_BYTE_ADD(fp39, &op.a, 0); sb_append(&a_sb, fp39, op.a_len);
        let b_sb = StrBuf { bytes: [0u8; 65536], len: 0 };
        let fp40: ptr = PTR_NULL(); PTR_BYTE_ADD(fp40, &op.b, 0); sb_append(&b_sb, fp40, op.b_len);
        let sub = run_result_new();
        let handled: bool = true;
        if (op.kind as u64) == PATCH_OP_WRITE {
            let rc: i32 = nativeWriteFile(&path_sb, &a_sb, policy_doc, cwd, started_at, &empty_opts, &sub);
        } else if (op.kind as u64) == PATCH_OP_EDIT {
            let rc: i32 = nativeEditFile(&path_sb, &a_sb, &b_sb, policy_doc, cwd, started_at, &empty_opts, &sub);
        } else if (op.kind as u64) == PATCH_OP_DELETE {
            let rc: i32 = nativeDeleteFile(&path_sb, policy_doc, cwd, started_at, &sub);
        } else if (op.kind as u64) == PATCH_OP_RENAME {
            let rc: i32 = nativeMoveFile(&a_sb, &b_sb, policy_doc, cwd, started_at, &sub);
        } else {
            handled = false;
        };
        if handled {
            if !sub.ok {
                *out = sub;
                return 0;
            };
            applied = applied + 1;
        };
    }
    let out_sb = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_assign(&out_sb, STR_PTR("Successfully applied "), STR_LEN("Successfully applied "));
    tool_sb_append_u64(applied, &out_sb);
    sb_append(&out_sb, STR_PTR(" patch operations."), STR_LEN(" patch operations."));
    res_success(out, started_at);
    res_set_stdout(out, sb_ptr(&out_sb), out_sb.len);
    return 0;
}

fn nativeCopyFile(from_path: &StrBuf, to_path: &StrBuf, policy_doc: u64, cwd: &StrBuf, started_at: f64, out: &SaVmRunResult) -> i32 {
    let norm = NormalizedSaVmPolicy { engine: 0, fs: NormalizedFs { entries: FsEntryList { items: [SaVmFsEntry { path: [0u8; 1024], path_len: 0, access: 0 }; 128], len: 0 }, read: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, write: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, transfer: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, delete: 0, backupDir: [0u8; 1024], backupDir_len: 0, backupDir_has: false }, http_allow: HttpRuleList { items: [SaVmHttpAllowRule { host: [0u8; 512], host_len: 0, methods: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_methods: false, paths: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_paths: false }; 128], len: 0 }, env_allow: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, process: NormalizedProcess { spawn: false, exec: ExecRuleList { items: [SaVmProcessExecRule { path: [0u8; 4096], path_len: 0, args: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_args: false }; 128], len: 0 }, bunProfiles: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_bunProfiles: false, bun_enabled: false, bun_allowedSubcommands: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_bun: false }, execution_javascript: false, execution_python: false, tools: NormalizedTools { replaceRead: false, replaceWrite: false, replaceApplyPatch: false, replaceExec: false, readFiles: false, editFiles: false, applyPatch: false, fastSearch: false, clearToolHistory: false, findReferences: false, renameSymbol: false, fileOutline: false, moveWithImports: false, findDefinition: false, extractToFile: false, addImport: false, getDiagnostics: false, organizeImports: false, analyzeScope: false, codeGraph: false }, contextSavings: SaVmContextSavingsConfig { locateBeforeRead: false, maxReadFileBytes: 0, maxReadFileBytes_has: false, grepCircuitBreaker: false, grepMaxResults: 0, grepMaxResults_has: false, grepMaxTokens: 0, grepMaxTokens_has: false, slimRunnerOutput: false, parallelBudget: false, parallelMaxTotalBytes: 0, parallelMaxTotalBytes_has: false, parallelMaxReadFiles: 0, parallelMaxReadFiles_has: false, parallelDeduplication: false, tieredSkillInjection: false, foldWaterfallEvents: false, foldHistoryReadSummaries: false, historyReadFoldTurns: 0, historyReadFoldTurns_has: false }, contextSavings_has: false };
    normalize_policy(policy_doc, cwd, &norm);
    let resolved_from = StrBuf { bytes: [0u8; 65536], len: 0 };
    path_resolve(cwd, from_path, &resolved_from);
    let resolved_to = StrBuf { bytes: [0u8; 65536], len: 0 };
    path_resolve(cwd, to_path, &resolved_to);
    let rsn = StrBuf { bytes: [0u8; 65536], len: 0 };
    if !toolCheckPath(&norm, 0, from_path, cwd, &rsn) {
        let em = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_assign(&em, STR_PTR("read "), STR_LEN("read "));
        sb_append(&em, sb_ptr(from_path), from_path.len);
        sb_append(&em, STR_PTR(": "), STR_LEN(": "));
        sb_append(&em, sb_ptr(&rsn), rsn.len);
        res_capability2(out, &em, &rsn, started_at);
        return 0;
    };
    if !toolCheckPath(&norm, 1, to_path, cwd, &rsn) {
        let em = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_assign(&em, STR_PTR("write "), STR_LEN("write "));
        sb_append(&em, sb_ptr(to_path), to_path.len);
        sb_append(&em, STR_PTR(": "), STR_LEN(": "));
        sb_append(&em, sb_ptr(&rsn), rsn.len);
        res_capability2(out, &em, &rsn, started_at);
        return 0;
    };
    let td = StrBuf { bytes: [0u8; 65536], len: 0 };
    tool_path_dirname(&resolved_to, &td);
    let rc1: i32 = sa_fs_mkdir_p(sb_ptr(&td), td.len);
    let crc: i32 = sa_fs_copy_file(sb_ptr(&resolved_from), resolved_from.len, sb_ptr(&resolved_to), resolved_to.len);
    if crc != 0 {
        let em = StrBuf { bytes: [0u8; 65536], len: 0 };
        if !fs_exists_sb(&resolved_from) {
            sb_assign(&em, STR_PTR("ENOENT: no such file or directory, copyfile '"), STR_LEN("ENOENT: no such file or directory, copyfile '"));
            sb_append(&em, sb_ptr(&resolved_from), resolved_from.len);
            sb_append(&em, STR_PTR("' -> '"), STR_LEN("' -> '"));
            sb_append(&em, sb_ptr(&resolved_to), resolved_to.len);
            sb_append(&em, STR_PTR("'"), STR_LEN("'"));
        } else {
            sb_assign(&em, STR_PTR("copyFile failed: '"), STR_LEN("copyFile failed: '"));
            sb_append(&em, sb_ptr(&resolved_from), resolved_from.len);
            sb_append(&em, STR_PTR("' -> '"), STR_LEN("' -> '"));
            sb_append(&em, sb_ptr(&resolved_to), resolved_to.len);
            sb_append(&em, STR_PTR("'"), STR_LEN("'"));
        };
        res_sa_error(out, sb_ptr(&em), em.len, started_at);
        return 0;
    };
    let out_sb = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_assign(&out_sb, STR_PTR("File copied from "), STR_LEN("File copied from "));
    sb_append(&out_sb, sb_ptr(from_path), from_path.len);
    sb_append(&out_sb, STR_PTR(" to "), STR_LEN(" to "));
    sb_append(&out_sb, sb_ptr(to_path), to_path.len);
    sb_append(&out_sb, STR_PTR(" successfully"), STR_LEN(" successfully"));
    res_success(out, started_at);
    res_set_stdout(out, sb_ptr(&out_sb), out_sb.len);
    return 0;
}

// TS countFileLines: returns null (ok_out = false) when the file cannot be
// read or exceeds 50 MiB; binary detection = NUL within the first 1024 bytes.
fn countFileLines(resolved: &StrBuf, size: f64, total_out: &u64, binary_out: &bool) -> bool {
    *total_out = 0;
    *binary_out = false;
    if size == 0.0 { return true; };
    if size > 52428800.0 { return false; };
    let buf: u64 = 0;
    let rc: i32 = sa_std_fs_read_file(sb_ptr(resolved), resolved.len, size as u64, &buf);
    if rc != 0 || buf == 0 { return false; };
    let dp: ptr = sa_fs_read_buffer_data(buf);
    let dl: u64 = sa_fs_read_buffer_len(buf);
    let check_len: u64 = dl;
    if check_len > 1024 { check_len = 1024; };
    let i: u64 = 0;
    let is_binary: bool = false;
    while i < check_len {
        if byte_at(dp, i) == 0 { is_binary = true; break; };
        i = i + 1;
    }
    if is_binary {
        *binary_out = true;
        let frc: i32 = sa_fs_read_buffer_free(buf);
        return true;
    };
    let total: u64 = 0;
    i = 0;
    while i < dl {
        if byte_at(dp, i) == 10 { total = total + 1; };
        i = i + 1;
    }
    if dl > 0 && byte_at(dp, dl - 1) != 10 { total = total + 1; };
    *total_out = total;
    let frc: i32 = sa_fs_read_buffer_free(buf);
    return true;
}

fn fmt_data(h: u64) -> ptr { let p: ptr = sa_fmt_buffer_data(h); return p; }

fn iso_from_ms(ms: i64, out: &StrBuf) -> void {
    out.len = 0;
    let h: u64 = sa_time_iso_from_unix_ms(ms);
    if h != 0 {
        sb_append(out, fmt_data(h), sa_fmt_buffer_len(h));
        let frc: i32 = sa_fmt_buffer_free(h);
    };
}

fn nativeFileInfo(file_path: &StrBuf, policy_doc: u64, cwd: &StrBuf, started_at: f64, out: &SaVmRunResult) -> i32 {
    let norm = NormalizedSaVmPolicy { engine: 0, fs: NormalizedFs { entries: FsEntryList { items: [SaVmFsEntry { path: [0u8; 1024], path_len: 0, access: 0 }; 128], len: 0 }, read: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, write: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, transfer: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, delete: 0, backupDir: [0u8; 1024], backupDir_len: 0, backupDir_has: false }, http_allow: HttpRuleList { items: [SaVmHttpAllowRule { host: [0u8; 512], host_len: 0, methods: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_methods: false, paths: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_paths: false }; 128], len: 0 }, env_allow: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, process: NormalizedProcess { spawn: false, exec: ExecRuleList { items: [SaVmProcessExecRule { path: [0u8; 4096], path_len: 0, args: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_args: false }; 128], len: 0 }, bunProfiles: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_bunProfiles: false, bun_enabled: false, bun_allowedSubcommands: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_bun: false }, execution_javascript: false, execution_python: false, tools: NormalizedTools { replaceRead: false, replaceWrite: false, replaceApplyPatch: false, replaceExec: false, readFiles: false, editFiles: false, applyPatch: false, fastSearch: false, clearToolHistory: false, findReferences: false, renameSymbol: false, fileOutline: false, moveWithImports: false, findDefinition: false, extractToFile: false, addImport: false, getDiagnostics: false, organizeImports: false, analyzeScope: false, codeGraph: false }, contextSavings: SaVmContextSavingsConfig { locateBeforeRead: false, maxReadFileBytes: 0, maxReadFileBytes_has: false, grepCircuitBreaker: false, grepMaxResults: 0, grepMaxResults_has: false, grepMaxTokens: 0, grepMaxTokens_has: false, slimRunnerOutput: false, parallelBudget: false, parallelMaxTotalBytes: 0, parallelMaxTotalBytes_has: false, parallelMaxReadFiles: 0, parallelMaxReadFiles_has: false, parallelDeduplication: false, tieredSkillInjection: false, foldWaterfallEvents: false, foldHistoryReadSummaries: false, historyReadFoldTurns: 0, historyReadFoldTurns_has: false }, contextSavings_has: false };
    normalize_policy(policy_doc, cwd, &norm);
    let resolved = StrBuf { bytes: [0u8; 65536], len: 0 };
    path_resolve(cwd, file_path, &resolved);
    let rsn = StrBuf { bytes: [0u8; 65536], len: 0 };
    if !toolCheckPath(&norm, 0, file_path, cwd, &rsn) {
        res_capability(out, &rsn, started_at);
        return 0;
    };
    let rel = StrBuf { bytes: [0u8; 65536], len: 0 };
    tool_path_relative(cwd, &resolved, &rel);
    let md: u64 = sa_fs_metadata(sb_ptr(&resolved), resolved.len);
    if md == 0 {
        let payload: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
        if payload != 0 {
            jset_str(payload, STR_PTR("path"), STR_LEN("path"), sb_ptr(&rel), rel.len);
            jset_bool(payload, STR_PTR("exists"), STR_LEN("exists"), false);
            jset_bool(payload, STR_PTR("isFile"), STR_LEN("isFile"), false);
            jset_bool(payload, STR_PTR("isDirectory"), STR_LEN("isDirectory"), false);
            let cjb = JsonBuf { bytes: [0u8; 262144], len: 0 };
            jdoc_to_jb(payload, &cjb);
            let pretty = JsonBuf { bytes: [0u8; 262144], len: 0 };
            json_pretty_into(jb_ptr(&cjb), cjb.len, &pretty);
            res_success(out, started_at);
            res_set_stdout(out, jb_ptr(&pretty), pretty.len);
            sa_json_free(payload);
        };
        return 0;
    };
    let is_file: bool = sa_fs_metadata_is_file(md) == 1;
    let is_dir: bool = sa_fs_metadata_is_directory(md) == 1;
    let size: u64 = sa_fs_metadata_len(md);
    let mtime_ms: i64 = sa_fs_metadata_modified_ms(md);
    let ctime_ms: i64 = sa_fs_metadata_st_ctime(md) * 1000;
    let has_lines: bool = false;
    let total_lines: u64 = 0;
    if is_file {
        let bin: bool = false;
        if countFileLines(&resolved, size as f64, &total_lines, &bin) && !bin { has_lines = true; };
    };
    let frc: i32 = sa_std_fs_metadata_free(md);
    let payload: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    if payload != 0 {
        jset_str(payload, STR_PTR("path"), STR_LEN("path"), sb_ptr(&rel), rel.len);
        jset_bool(payload, STR_PTR("exists"), STR_LEN("exists"), true);
        jset_f64(payload, STR_PTR("size"), STR_LEN("size"), size as f64);
        if is_file { jset_bool(payload, STR_PTR("isFile"), STR_LEN("isFile"), true); } else { jset_bool(payload, STR_PTR("isFile"), STR_LEN("isFile"), false); };
        if is_dir { jset_bool(payload, STR_PTR("isDirectory"), STR_LEN("isDirectory"), true); } else { jset_bool(payload, STR_PTR("isDirectory"), STR_LEN("isDirectory"), false); };
        let iso = StrBuf { bytes: [0u8; 65536], len: 0 };
        iso_from_ms(mtime_ms, &iso);
        jset_str(payload, STR_PTR("mtime"), STR_LEN("mtime"), sb_ptr(&iso), iso.len);
        iso_from_ms(ctime_ms, &iso);
        jset_str(payload, STR_PTR("ctime"), STR_LEN("ctime"), sb_ptr(&iso), iso.len);
        if has_lines {
            jset_f64(payload, STR_PTR("total_lines"), STR_LEN("total_lines"), total_lines as f64);
            jset_f64(payload, STR_PTR("line_count"), STR_LEN("line_count"), total_lines as f64);
        };
        let cjb = JsonBuf { bytes: [0u8; 262144], len: 0 };
        jdoc_to_jb(payload, &cjb);
        let pretty = JsonBuf { bytes: [0u8; 262144], len: 0 };
        json_pretty_into(jb_ptr(&cjb), cjb.len, &pretty);
        res_success(out, started_at);
        res_set_stdout(out, jb_ptr(&pretty), pretty.len);
        sa_json_free(payload);
    };
    return 0;
}

