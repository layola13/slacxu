            let ep: f64 = session_get_num(e, STR_PTR("pid"), STR_LEN("pid"), 0.0);
            if ep > 0.0 && (ep as u64) == pid {
                let h: f64 = session_get_num(e, STR_PTR("handle"), STR_LEN("handle"), 0.0);
                if h > 0.0 {
                    let hu: u64 = h as u64;
                    let k1: i32 = sa_std_process_kill(hu);
                    let k2: i32 = sa_std_process_kill_process_group(hu);
                };
                jset_str(e, STR_PTR("status"), STR_LEN("status"), STR_PTR("killed"), STR_LEN("killed"));
                jset_bool(e, STR_PTR("has_exit"), STR_LEN("has_exit"), true);
                jset_i64(e, STR_PTR("exit_code"), STR_LEN("exit_code"), 137);
                changed = true;
            };
        };
        i = i + 1;
    }
    if changed { sessions_save(arr); };
    sa_json_free(arr);
}

fn resolvePythonBinary(out: &StrBuf) -> void {
    out.len = 0;
    let key = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_append(&key, STR_PTR("PYTHON"), STR_LEN("PYTHON"));
    if env_get_sb(&key, out) && out.len > 0 { return; };
    out.len = 0;
    sb_append(out, STR_PTR("python3"), STR_LEN("python3"));
}

fn resolveBunBinary(out: &StrBuf, err: &StrBuf) -> bool {
    out.len = 0;
    err.len = 0;
    let key = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_append(&key, STR_PTR("CODEX_UI_BUN_BIN"), STR_LEN("CODEX_UI_BUN_BIN"));
    let cfg = StrBuf { bytes: [0u8; 65536], len: 0 };
    let has_cfg: bool = env_get_sb(&key, &cfg);
    if !has_cfg || cfg.len == 0 {
        key.len = 0;
        sb_append(&key, STR_PTR("BUN_BIN"), STR_LEN("BUN_BIN"));
        cfg.len = 0;
        has_cfg = env_get_sb(&key, &cfg);
    };
    if has_cfg {
        sb_trim_ip(&cfg);
    };
    if has_cfg && cfg.len > 0 {
        if !path_is_abs(&cfg) {
            sb_append(err, STR_PTR("CODEX_UI_BUN_BIN must be an absolute path"), STR_LEN("CODEX_UI_BUN_BIN must be an absolute path"));
            return false;
        };
        if !fs_exists_sb(&cfg) {
            sb_append(err, STR_PTR("Configured Bun binary does not exist: "), STR_LEN("Configured Bun binary does not exist: "));
            sb_append(err, sb_ptr(&cfg), cfg.len);
            return false;
        };
        sb_append(out, sb_ptr(&cfg), cfg.len);
        return true;
    };
    let home = StrBuf { bytes: [0u8; 65536], len: 0 };
    key.len = 0;
    sb_append(&key, STR_PTR("HOME"), STR_LEN("HOME"));
    if env_get_sb(&key, &home) && home.len > 0 {
        let rel = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_append(&rel, STR_PTR(".bun/bin/bun"), STR_LEN(".bun/bin/bun"));
        path_join(&home, &rel, out);
        if fs_exists_sb(out) { return true; };
        out.len = 0;
    };
    sb_append(err, STR_PTR("Bun runner is unavailable; configure CODEX_UI_BUN_BIN to an absolute Bun path"), STR_LEN("Bun runner is unavailable; configure CODEX_UI_BUN_BIN to an absolute Bun path"));
    return false;
}

fn validateTestFilePath(profile: &StrBuf, cand: &StrBuf, cwd: &StrBuf, rel_out: &StrBuf, reason: &StrBuf) -> bool {
    rel_out.len = 0;
    reason.len = 0;
    let norm = StrBuf { bytes: [0u8; 65536], len: 0 };
    let i: u64 = 0;
    while i < cand.len {
        let b: u8 = cand.bytes[i];
        if b == 92 { sb_append(&norm, STR_PTR("/"), STR_LEN("/")); } else {
            let one = StrBuf { bytes: [0u8; 65536], len: 0 };
            one.bytes[0] = b;
            one.len = 1;
            sb_append(&norm, sb_ptr(&one), 1);
        };
        i = i + 1;
    }
    sb_trim_ip(&norm);
    if norm.len == 0 {
        sb_append(reason, STR_PTR("test_file parameter is required for test-file profiles"), STR_LEN("test_file parameter is required for test-file profiles"));
        return false;
    };
    let bad: bool = tool_sb_contains(&norm, STR_PTR(".."), STR_LEN(".."));
    let j: u64 = 0;
    while j < norm.len {
        let b: u8 = norm.bytes[j];
        if b <= 32 || b == 59 || b == 96 || b == 36 || b == 40 || b == 41 || b == 38 || b == 124 || b == 60 || b == 62 || b == 58 || b == 34 || b == 42 || b == 63 { bad = true; };
        j = j + 1;
    }
    if bad {
        sb_append(reason, STR_PTR("invalid characters or path traversal in test_file"), STR_LEN("invalid characters or path traversal in test_file"));
        return false;
    };
    let prefix = StrBuf { bytes: [0u8; 65536], len: 0 };
    if sb_eq(profile, STR_PTR("server-test-file"), STR_LEN("server-test-file")) { sb_append(&prefix, STR_PTR("tests/server/"), STR_LEN("tests/server/")); } else if sb_eq(profile, STR_PTR("web-test-file"), STR_LEN("web-test-file")) { sb_append(&prefix, STR_PTR("tests/web/"), STR_LEN("tests/web/")); } else { sb_append(&prefix, STR_PTR("tests/shared/"), STR_LEN("tests/shared/")); };
    if !sb_starts(&norm, sb_ptr(&prefix), prefix.len) {
        sb_append(reason, STR_PTR("test_file for "), STR_LEN("test_file for "));
        sb_append(reason, sb_ptr(profile), profile.len);
        sb_append(reason, STR_PTR(" must start with '"), STR_LEN(" must start with '"));
        sb_append(reason, sb_ptr(&prefix), prefix.len);
        sb_append(reason, STR_PTR("'"), STR_LEN("'"));
        return false;
    };
    if !sb_ends(&norm, STR_PTR(".test.ts"), STR_LEN(".test.ts")) && !sb_ends(&norm, STR_PTR(".test.tsx"), STR_LEN(".test.tsx")) && !sb_ends(&norm, STR_PTR(".test.js"), STR_LEN(".test.js")) {
        sb_append(reason, STR_PTR("test_file must end with .test.ts, .test.tsx, or .test.js"), STR_LEN("test_file must end with .test.ts, .test.tsx, or .test.js"));
        return false;
    };
    let resolved = StrBuf { bytes: [0u8; 65536], len: 0 };
    path_resolve(cwd, &norm, &resolved);
    if !pathWithin(sb_ptr(cwd), cwd.len, sb_ptr(&resolved), resolved.len) {
        sb_append(reason, STR_PTR("test_file is outside workspace directory"), STR_LEN("test_file is outside workspace directory"));
        return false;
    };
    if !fs_exists_sb(&resolved) {
        sb_append(reason, STR_PTR("test file does not exist: "), STR_LEN("test file does not exist: "));
        sb_append(reason, sb_ptr(&norm), norm.len);
        return false;
    };
    sb_append(rel_out, sb_ptr(&norm), norm.len);
    return true;
}

// read_pkg status: 0 ok (doc_out set), 1 missing, 2 invalid.
fn read_pkg(cwd: &StrBuf, sub: &StrBuf, doc_out: &u64) -> i32 {
    *doc_out = 0;
    let p = StrBuf { bytes: [0u8; 65536], len: 0 };
    if sub.len > 0 { path_join(cwd, sub, &p); } else { sb_append(&p, sb_ptr(cwd), cwd.len); };
    let fn2 = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_append(&fn2, STR_PTR("package.json"), STR_LEN("package.json"));
    let full = StrBuf { bytes: [0u8; 65536], len: 0 };
    path_join(&p, &fn2, &full);
    if !fs_exists_sb(&full) { return 1; };
    let content = StrBuf { bytes: [0u8; 65536], len: 0 };
    let rst: i32 = fs_read_sb(&full, 65536, &content);
    if rst != 0 { return 2; };
    let d: u64 = sa_json_parse(sb_ptr(&content), content.len);
    if d == 0 { return 2; };
    *doc_out = d;
    return 0;
}

fn pkg_name_is(doc: u64, expect: &StrBuf) -> bool {
    let nm = StrBuf { bytes: [0u8; 65536], len: 0 };
    if !doc_str(doc, STR_PTR("name"), STR_LEN("name"), &nm) { return false; };
    return sb_eq(&nm, sb_ptr(expect), expect.len);
}

fn pkg_script(doc: u64, key_ptr: ptr, key_len: u64, out: &StrBuf) -> bool {
    out.len = 0;
    let scripts: u64 = jget_node(doc, STR_PTR("scripts"), STR_LEN("scripts"));
    if scripts == 0 { return false; };
    return doc_str(scripts, key_ptr, key_len, out);
}

fn verify_tc_target(cwd: &StrBuf, sub: &StrBuf, pkg_name: &StrBuf, expected: &StrBuf, reason: &StrBuf) -> bool {
    let d: u64 = 0;
    let st: i32 = read_pkg(cwd, sub, &d);
    if st == 1 {
        sb_append(reason, STR_PTR("workspace package for "), STR_LEN("workspace package for "));
        sb_append(reason, sb_ptr(pkg_name), pkg_name.len);
        sb_append(reason, STR_PTR(" is missing"), STR_LEN(" is missing"));
        return false;
    };
    if st != 0 {
        sb_append(reason, STR_PTR("workspace package.json for "), STR_LEN("workspace package.json for "));
        sb_append(reason, sb_ptr(pkg_name), pkg_name.len);
        sb_append(reason, STR_PTR(" is invalid"), STR_LEN(" is invalid"));
        return false;
    };
    if !pkg_name_is(d, pkg_name) {
        sb_append(reason, STR_PTR("workspace package identity mismatch for "), STR_LEN("workspace package identity mismatch for "));
        sb_append(reason, sb_ptr(pkg_name), pkg_name.len);
        sa_json_free(d);
        return false;
    };
    let sc = StrBuf { bytes: [0u8; 65536], len: 0 };
    let has_sc: bool = pkg_script(d, STR_PTR("typecheck"), STR_LEN("typecheck"), &sc);
    sa_json_free(d);
    if !has_sc || !sb_eq(&sc, sb_ptr(expected), expected.len) {
        sb_append(reason, STR_PTR("typecheck script changed; refusing to execute "), STR_LEN("typecheck script changed; refusing to execute "));
        sb_append(reason, sb_ptr(pkg_name), pkg_name.len);
        return false;
    };
    return true;
}

fn verifyBunProfileIntegrity(profile: &StrBuf, cwd: &StrBuf, reason: &StrBuf) -> bool {
    reason.len = 0;
    let empty_sub = StrBuf { bytes: [0u8; 65536], len: 0 };
    let root_doc: u64 = 0;
    let rst: i32 = read_pkg(cwd, &empty_sub, &root_doc);
    if rst == 1 {
        sb_append(reason, STR_PTR("Bun profiles require a repository root containing package.json"), STR_LEN("Bun profiles require a repository root containing package.json"));
        return false;
    };
    if rst != 0 {
        sb_append(reason, STR_PTR("repository package.json is invalid"), STR_LEN("repository package.json is invalid"));
        return false;
    };
    if bun_profile_is_test_file(profile) {
        sa_json_free(root_doc);
        return true;
    };
    let std_tc = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_append(&std_tc, STR_PTR("tsc -p tsconfig.json --noEmit --noUnusedLocals --noUnusedParameters --noFallthroughCasesInSwitch --noImplicitReturns --noImplicitOverride"), STR_LEN("tsc -p tsconfig.json --noEmit --noUnusedLocals --noUnusedParameters --noFallthroughCasesInSwitch --noImplicitReturns --noImplicitOverride"));
    let web_tc = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_append(&web_tc, STR_PTR("tsc -p tsconfig.json --noEmit --noFallthroughCasesInSwitch --noImplicitReturns --noImplicitOverride"), STR_LEN("tsc -p tsconfig.json --noEmit --noFallthroughCasesInSwitch --noImplicitReturns --noImplicitOverride"));
    if sb_eq(profile, STR_PTR("shared-build"), STR_LEN("shared-build")) {
        let sub = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_append(&sub, STR_PTR("packages/shared"), STR_LEN("packages/shared"));
        let d: u64 = 0;
        let st: i32 = read_pkg(cwd, &sub, &d);
        if st == 1 { sb_append(reason, STR_PTR("packages/shared/package.json is missing"), STR_LEN("packages/shared/package.json is missing")); sa_json_free(root_doc); return false; };
        if st != 0 { sb_append(reason, STR_PTR("packages/shared/package.json is invalid"), STR_LEN("packages/shared/package.json is invalid")); sa_json_free(root_doc); return false; };
        let nm = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_append(&nm, STR_PTR("@codex-ui/shared"), STR_LEN("@codex-ui/shared"));
        if !pkg_name_is(d, &nm) { sb_append(reason, STR_PTR("packages/shared identity mismatch"), STR_LEN("packages/shared identity mismatch")); sa_json_free(d); sa_json_free(root_doc); return false; };
        let sc = StrBuf { bytes: [0u8; 65536], len: 0 };
        let has_sc: bool = pkg_script(d, STR_PTR("build"), STR_LEN("build"), &sc);
        sa_json_free(d);
        sa_json_free(root_doc);
        if !has_sc || !sb_eq(&sc, STR_PTR("tsc -p tsconfig.json"), STR_LEN("tsc -p tsconfig.json")) {
            sb_append(reason, STR_PTR("shared build script changed"), STR_LEN("shared build script changed"));
            return false;
        };
        return true;
    };
    if sb_eq(profile, STR_PTR("web-build"), STR_LEN("web-build")) {
        let sub = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_append(&sub, STR_PTR("apps/web"), STR_LEN("apps/web"));
        let d: u64 = 0;
        let st: i32 = read_pkg(cwd, &sub, &d);
        if st == 1 { sb_append(reason, STR_PTR("apps/web/package.json is missing"), STR_LEN("apps/web/package.json is missing")); sa_json_free(root_doc); return false; };
        if st != 0 { sb_append(reason, STR_PTR("apps/web/package.json is invalid"), STR_LEN("apps/web/package.json is invalid")); sa_json_free(root_doc); return false; };
        let nm = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_append(&nm, STR_PTR("@codex-ui/web"), STR_LEN("@codex-ui/web"));
        if !pkg_name_is(d, &nm) { sb_append(reason, STR_PTR("apps/web identity mismatch"), STR_LEN("apps/web identity mismatch")); sa_json_free(d); sa_json_free(root_doc); return false; };
        let sc = StrBuf { bytes: [0u8; 65536], len: 0 };
        let has_sc: bool = pkg_script(d, STR_PTR("build"), STR_LEN("build"), &sc);
        sa_json_free(d);
        sa_json_free(root_doc);
        if !has_sc || (!tool_sb_contains(&sc, STR_PTR("build.ts"), STR_LEN("build.ts")) && !tool_sb_contains(&sc, STR_PTR("Bun.build"), STR_LEN("Bun.build"))) {
            sb_append(reason, STR_PTR("web build script changed"), STR_LEN("web build script changed"));
            return false;
        };
        return true;
    };
    // typecheck profiles
    let is_root: bool = sb_eq(profile, STR_PTR("root-typecheck"), STR_LEN("root-typecheck"));
    let subs = ByteList { items: [0u8; 4096], len: 0 };
    let names = ByteList { items: [0u8; 4096], len: 0 };
    let webs = ByteList { items: [0u8; 4096], len: 0 };
    if is_root || sb_eq(profile, STR_PTR("shared-typecheck"), STR_LEN("shared-typecheck")) { bl_push(&subs, STR_PTR("packages/shared"), STR_LEN("packages/shared")); bl_push(&names, STR_PTR("@codex-ui/shared"), STR_LEN("@codex-ui/shared")); bl_push(&webs, STR_PTR("std"), STR_LEN("std")); };
    if is_root || sb_eq(profile, STR_PTR("protocol-typecheck"), STR_LEN("protocol-typecheck")) { bl_push(&subs, STR_PTR("packages/codex-protocol"), STR_LEN("packages/codex-protocol")); bl_push(&names, STR_PTR("@codex-ui/codex-protocol"), STR_LEN("@codex-ui/codex-protocol")); bl_push(&webs, STR_PTR("std"), STR_LEN("std")); };
    if is_root || sb_eq(profile, STR_PTR("server-typecheck"), STR_LEN("server-typecheck")) { bl_push(&subs, STR_PTR("apps/server"), STR_LEN("apps/server")); bl_push(&names, STR_PTR("@codex-ui/server"), STR_LEN("@codex-ui/server")); bl_push(&webs, STR_PTR("std"), STR_LEN("std")); };
    if is_root || sb_eq(profile, STR_PTR("web-typecheck"), STR_LEN("web-typecheck")) { bl_push(&subs, STR_PTR("apps/web"), STR_LEN("apps/web")); bl_push(&names, STR_PTR("@codex-ui/web"), STR_LEN("@codex-ui/web")); bl_push(&webs, STR_PTR("web"), STR_LEN("web")); };
    if is_root || sb_eq(profile, STR_PTR("free-key-typecheck"), STR_LEN("free-key-typecheck")) { bl_push(&subs, STR_PTR("apps/free-key-server"), STR_LEN("apps/free-key-server")); bl_push(&names, STR_PTR("@codex-ui/free-key-server"), STR_LEN("@codex-ui/free-key-server")); bl_push(&webs, STR_PTR("std"), STR_LEN("std")); };
    let tc: u64 = bl_count(&subs);
    let ti: u64 = 0;
    let s1 = StrBuf { bytes: [0u8; 65536], len: 0 };
    let s2 = StrBuf { bytes: [0u8; 65536], len: 0 };
    let s3 = StrBuf { bytes: [0u8; 65536], len: 0 };
    let tc_fail: bool = false;
    while ti < tc {
        bl_at(&subs, ti, &s1);
        bl_at(&names, ti, &s2);
        bl_at(&webs, ti, &s3);
        let exp = StrBuf { bytes: [0u8; 65536], len: 0 };
        if sb_eq(&s3, STR_PTR("web"), STR_LEN("web")) { sb_append(&exp, sb_ptr(&web_tc), web_tc.len); } else { sb_append(&exp, sb_ptr(&std_tc), std_tc.len); };
        if !verify_tc_target(cwd, &s1, &s2, &exp, reason) {
            tc_fail = true;
            break;
        };
        ti = ti + 1;
    }
    if tc_fail {
        let frc9: i32 = sa_json_free(root_doc);
        return false;
    };
    let rsc = StrBuf { bytes: [0u8; 65536], len: 0 };
    let has_rsc: bool = pkg_script(root_doc, STR_PTR("typecheck"), STR_LEN("typecheck"), &rsc);
    sa_json_free(root_doc);
    if has_rsc && tool_sb_contains(&rsc, STR_PTR("run"), STR_LEN("run")) {
        sb_append(reason, STR_PTR("repository scripts appear modified; refusing Bun profile execution"), STR_LEN("repository scripts appear modified; refusing Bun profile execution"));
        return false;
    };
    return true;
}

fn minimalRunnerEnv() -> u64 {
    let doc: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    let keys = ByteList { items: [0u8; 4096], len: 0 };
    bl_push(&keys, STR_PTR("SystemRoot"), STR_LEN("SystemRoot"));
    bl_push(&keys, STR_PTR("PATH"), STR_LEN("PATH"));
    bl_push(&keys, STR_PTR("HOME"), STR_LEN("HOME"));
    bl_push(&keys, STR_PTR("USERPROFILE"), STR_LEN("USERPROFILE"));
    bl_push(&keys, STR_PTR("TEMP"), STR_LEN("TEMP"));
    bl_push(&keys, STR_PTR("TMP"), STR_LEN("TMP"));
    let kc: u64 = bl_count(&keys);
    let ki: u64 = 0;
    let k = StrBuf { bytes: [0u8; 65536], len: 0 };
    let v = StrBuf { bytes: [0u8; 65536], len: 0 };
    let has_temp: bool = false;
    while ki < kc {
        if bl_at(&keys, ki, &k) {
            v.len = 0;
            if env_get_sb(&k, &v) {
                jset_str(doc, sb_ptr(&k), k.len, sb_ptr(&v), v.len);
                if sb_eq(&k, STR_PTR("TEMP"), STR_LEN("TEMP")) { has_temp = true; };
            };
        };
        ki = ki + 1;
    }
    if !has_temp {
        let th: u64 = sa_env_temp_dir();
        if th != 0 {
            let tp: ptr = sa_env_buffer_data(th);
            let tn: u64 = sa_env_buffer_len(th);
            jset_str(doc, STR_PTR("TEMP"), STR_LEN("TEMP"), tp, tn);
            sa_env_buffer_free(th);
        };
    };
    jset_str(doc, STR_PTR("NODE_ENV"), STR_LEN("NODE_ENV"), STR_PTR("test"), STR_LEN("test"));
    return doc;
}

fn slim_output(raw: &GitBigBuf, total_hint: u64, out: &StrBuf) -> void {
    out.len = 0;
    let rp: ptr = gb_ptr(raw);
    let total: u64 = 0;
    let matches = ListBuf { bytes: [0u8; 131072], len: 0 };
    let match_count: u64 = 0;
    let start: u64 = 0;
    let i: u64 = 0;
    while i <= raw.len {
        let at_end: bool = i == raw.len;
        let is_nl: bool = false;
        if !at_end { let b: u8 = 0; PTR_BYTE_AT(b, rp, i); if b == 10 { is_nl = true; }; };
        if at_end || is_nl {
            if i > start || !at_end {
                total = total + 1;
                let line = StrBuf { bytes: [0u8; 65536], len: 0 };
                let lp: ptr = PTR_NULL();
                PTR_BYTE_ADD(lp, rp, start);
                let ln: u64 = i - start;
                if ln > 65536 { ln = 65536; };
                sb_append(&line, lp, ln);
                if re_ci_test(STR_PTR("pass|fail|error|warning|✓|✗|ok\\b"), STR_LEN("pass|fail|error|warning|✓|✗|ok\\b"), &line) {
                    match_count = match_count + 1;
                    lb_append(&matches, sb_ptr(&line), line.len);
                };
            };
            start = i + 1;
        };
        i = i + 1;
    }
    if match_count > 0 {
        sb_append(out, STR_PTR("[slim] "), STR_LEN("[slim] "));
        let mc: u64 = lb_count(&matches);
        let from: u64 = 0;
        if mc > 3 { from = mc - 3; };
        let j: u64 = from;
        let part = StrBuf { bytes: [0u8; 65536], len: 0 };
        while j < mc {
            if j > from { sb_append(out, STR_PTR(" | "), STR_LEN(" | ")); };
            if lb_at(&matches, j, &part) { sb_append(out, sb_ptr(&part), part.len); };
            j = j + 1;
        }
        sb_append(out, STR_PTR("\n[OPT-3] Full output suppressed by slimRunnerOutput ("), STR_LEN("\n[OPT-3] Full output suppressed by slimRunnerOutput ("));
        tool_sb_append_u64(total, out);
        sb_append(out, STR_PTR(" lines)."), STR_LEN(" lines)."));
        return;
    };
    if total > 10 {
        sb_append(out, STR_PTR("[slim] Exit 0. "), STR_LEN("[slim] Exit 0. "));
        tool_sb_append_u64(total, out);
        sb_append(out, STR_PTR(" lines of output.\n[OPT-3] Full output suppressed by slimRunnerOutput."), STR_LEN(" lines of output.\n[OPT-3] Full output suppressed by slimRunnerOutput."));
        return;
    };
    sb_append(out, rp, raw.len);
}

fn spawnScriptRunner(bin: &StrBuf, args: &ByteList, cwd: &StrBuf, deadline_ms: f64, started_at: f64, is_py: bool, slim: bool, out: &SaVmRunResult) -> void {
    let a = GitArgvArr { slots: [0u64; 40] };
    PROCESS_ARGV_SET_PTR(&a.slots, 0, sb_ptr(bin), bin.len);
    let ac: u64 = bl_count(args);
    let ai: u64 = 0;
    let item = StrBuf { bytes: [0u8; 65536], len: 0 };
    while ai < ac && ai < 19 {
        if bl_at(args, ai, &item) { PROCESS_ARGV_SET_PTR(&a.slots, ai + 1, sb_ptr(&item), item.len); };
        ai = ai + 1;
    }
    let argc: u64 = ai + 1;
    let proc: u64 = 0;
    let src: i32 = sa_std_process_run_cwd(git_argv_ptr(&a), argc, sb_ptr(cwd), cwd.len, &proc);
    if src != 0 || proc == 0 {
        res_init(out);
        out.ok = false;
        res_set_kind(out, STR_PTR("crashed"), STR_LEN("crashed"));
        out.has_exitCode = false;
        let em = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_append(&em, STR_PTR("spawn "), STR_LEN("spawn "));
        sb_append(&em, sb_ptr(bin), bin.len);
        sb_append(&em, STR_PTR(" ENOENT"), STR_LEN(" ENOENT"));
        res_set_stderr(out, sb_ptr(&em), em.len);
        res_set_events(out, STR_PTR("[]"), STR_LEN("[]"));
        out.durationMs = dur_since(started_at);
        return;
    };
    let t0: f64 = now_ms();
    let obuf = GitBigBuf { bytes: [0u8; 524288], len: 0 };
    let ebuf = GitBigBuf { bytes: [0u8; 524288], len: 0 };
    let done: bool = false;
    let timed_out: bool = false;
    let code: i64 = 0;
    while !done {
        let ready: bool = false;
        let twst: i32 = sa_std_process_try_wait(proc, &ready, &code);
        if ready {
            done = true;
        } else {
            if now_ms() - t0 > deadline_ms {
                timed_out = true;
                let k1: i32 = sa_std_process_kill(proc);
                let k2: i32 = sa_std_process_kill_process_group(proc);
                let wc: i64 = 0;
                let wst: i32 = sa_std_process_wait(proc, &wc);
                done = true;
            } else {
                let bfix22373: i32 = sa_time_sleep_ms(5);
            };
        };
    }
    let more: bool = true;
    while more {
        let n: u64 = 0;
        let cp: ptr = PTR_NULL();
        PTR_BYTE_ADD(cp, gb_ptr(&obuf), obuf.len);
        let rrc: i32 = sa_std_process_read_stdout(proc, cp, 524288 - obuf.len, &n);
        if n == 0 { more = false; } else {
            obuf.len = obuf.len + n;
            if obuf.len >= 524288 { more = false; };
        };
    }
    let more2: bool = true;
    while more2 {
        let n2: u64 = 0;
        let cp2: ptr = PTR_NULL();
        PTR_BYTE_ADD(cp2, gb_ptr(&ebuf), ebuf.len);
        let rrc2: i32 = sa_std_process_read_stderr(proc, cp2, 524288 - ebuf.len, &n2);
        if n2 == 0 { more2 = false; } else {
            ebuf.len = ebuf.len + n2;
            if ebuf.len >= 524288 { more2 = false; };
        };
    }
    let cst: i32 = sa_std_process_close(proc);
    res_init(out);
    res_set_events(out, STR_PTR("[]"), STR_LEN("[]"));
    if timed_out {
        out.ok = false;
        res_set_kind(out, STR_PTR("timeout"), STR_LEN("timeout"));
        out.has_exitCode = false;
        res_set_stdout(out, gb_ptr(&obuf), obuf.len);
        let em2 = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_append(&em2, gb_ptr(&ebuf), ebuf.len);
        sb_append(&em2, STR_PTR("\n[timeout] script execution exceeded deadline"), STR_LEN("\n[timeout] script execution exceeded deadline"));
        sb_trim_ip(&em2);
        res_set_stderr(out, sb_ptr(&em2), em2.len);
        out.durationMs = dur_since(started_at);
        return;
    };
    out.ok = code == 0;
    if code == 0 { res_set_kind(out, STR_PTR("success"), STR_LEN("success")); } else { res_set_kind(out, STR_PTR("crashed"), STR_LEN("crashed")); };
    out.has_exitCode = true;
    out.exitCode = code;
    if code == 0 && slim {
        let so = StrBuf { bytes: [0u8; 65536], len: 0 };
        slim_output(&obuf, 0, &so);
        res_set_stdout(out, sb_ptr(&so), so.len);
    } else {
        res_set_stdout(out, gb_ptr(&obuf), obuf.len);
    };
    res_set_stderr(out, gb_ptr(&ebuf), ebuf.len);
    out.durationMs = dur_since(started_at);
}

fn clampLimit(node: u64, fallback: f64, ceiling: f64) -> f64 {
    let v: f64 = fallback;
    if node != 0 && (sa_json_node_kind(node) == JK_INT || sa_json_node_kind(node) == JK_FLOAT) {
        v = (sa_json_node_as_f64(node) as i64) as f64;
    };
    if v < 0.0 { v = 0.0; };
    if v > ceiling { v = ceiling; };
    return v;
}

fn strlist_contains(l: &StrList, s: &StrBuf) -> bool {
    let i: u64 = 0;
    while i < l.len && i < 128 {
        if l.items[i].len == s.len {
            let ip: ptr = PTR_NULL();
            PTR_BYTE_ADD(ip, &l.items[i].bytes, 0);
            if tool_bytes_eq(ip, l.items[i].len, sb_ptr(s), s.len) { return true; };
        };
        i = i + 1;
    }
    return false;
}

fn normalizeFsCaps(value: u64, cwd: &StrBuf, norm: &NormalizedSaVmPolicy, err: &StrBuf, kind: &u64) -> i32 {
    err.len = 0;
    if value == 0 || sa_json_node_kind(value) != JK_ARRAY { return 0; };
    let c: u64 = jcount(value);
    let i: u64 = 0;
    while i < c {
        let e: u64 = jarr_at(value, i);
        i = i + 1;
        if e == 0 { continue; };
        let op_s = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_append(&op_s, STR_PTR("read"), STR_LEN("read"));
        let path_s = StrBuf { bytes: [0u8; 65536], len: 0 };
        let ek: u64 = sa_json_node_kind(e);
        if ek == JK_STRING {
            let p: ptr = PTR_NULL();
            let n: u64 = 0;
            let gst: i32 = sa_json_node_string(e, &p, &n);
            sb_append(&path_s, p, n);
        } else if ek == JK_OBJECT {
            doc_coerce_str(e, STR_PTR("op"), STR_LEN("op"), &op_s);
            let pn: u64 = jget_node(e, STR_PTR("path"), STR_LEN("path"));
            if pn == 0 || sa_json_node_kind(pn) != JK_STRING { continue; };
            let p: ptr = PTR_NULL();
            let n: u64 = 0;
            let gst: i32 = sa_json_node_string(pn, &p, &n);
            sb_append(&path_s, p, n);
        } else {
            continue;
        };
        if path_s.len == 0 { continue; };
        let op_ok: bool = sb_eq(&op_s, STR_PTR("read"), STR_LEN("read")) || sb_eq(&op_s, STR_PTR("write"), STR_LEN("write")) || sb_eq(&op_s, STR_PTR("append"), STR_LEN("append")) || sb_eq(&op_s, STR_PTR("edit"), STR_LEN("edit")) || sb_eq(&op_s, STR_PTR("create"), STR_LEN("create")) || sb_eq(&op_s, STR_PTR("delete"), STR_LEN("delete")) || sb_eq(&op_s, STR_PTR("rename"), STR_LEN("rename")) || sb_eq(&op_s, STR_PTR("metadata"), STR_LEN("metadata"));
        if !op_ok { continue; };
        let rsn = StrBuf { bytes: [0u8; 65536], len: 0 };
        let allowed: bool = false;
        let del_deny: bool = false;
        if sb_eq(&op_s, STR_PTR("delete"), STR_LEN("delete")) && norm.fs.delete == 0 {
            del_deny = true;
            let dec = SaVmPolicyDecision { allowed: false, reason: [0u8; 2048], reason_len: 0, path: [0u8; 1024], path_len: 0, path_has: false };
            checkSaVmDelete(norm, sb_ptr(&path_s), path_s.len, sb_ptr(cwd), cwd.len, &dec);
            allowed = dec.allowed;
            if !allowed {
                let rp: ptr = PTR_NULL();
                PTR_BYTE_ADD(rp, &dec.reason, 0);
                sb_append(&rsn, rp, dec.reason_len);
            };
        } else {
            let tag: u64 = 1;
            if sb_eq(&op_s, STR_PTR("read"), STR_LEN("read")) || sb_eq(&op_s, STR_PTR("metadata"), STR_LEN("metadata")) { tag = 0; } else if sb_eq(&op_s, STR_PTR("rename"), STR_LEN("rename")) || sb_eq(&op_s, STR_PTR("delete"), STR_LEN("delete")) { tag = 2; };
            allowed = toolCheckPath(norm, tag, &path_s, cwd, &rsn);
        };
        if !allowed {
            if del_deny { sb_append(err, STR_PTR("filesystem delete denied by VM policy: "), STR_LEN("filesystem delete denied by VM policy: ")); } else { sb_append(err, STR_PTR("filesystem capability denied by VM policy: "), STR_LEN("filesystem capability denied by VM policy: ")); };
            sb_append(err, sb_ptr(&path_s), path_s.len);
            sb_append(err, STR_PTR(" ("), STR_LEN(" ("));
            sb_append(err, sb_ptr(&rsn), rsn.len);
            sb_append(err, STR_PTR(")"), STR_LEN(")"));
            *kind = 1;
            return 1;
        };
    }
    return 0;
}

fn normalizeNetCaps(value: u64, norm: &NormalizedSaVmPolicy, err: &StrBuf, kind: &u64) -> i32 {
    err.len = 0;
    if value == 0 || sa_json_node_kind(value) != JK_ARRAY { return 0; };
    let c: u64 = jcount(value);
    let i: u64 = 0;
    while i < c {
        let e: u64 = jarr_at(value, i);
        i = i + 1;
        if e == 0 || sa_json_node_kind(e) != JK_OBJECT { continue; };
        let url = StrBuf { bytes: [0u8; 65536], len: 0 };
        if !doc_coerce_str(e, STR_PTR("url"), STR_LEN("url"), &url) { continue; };
        let proto_err: bool = false;
        let sep: i64 = sb_index_of(&url, STR_PTR("://"), STR_LEN("://"));
        if sep < 0 { proto_err = true; };
        if !proto_err {
            let proto = StrBuf { bytes: [0u8; 65536], len: 0 };
            sb_append(&proto, sb_ptr(&url), sep as u64);
            sb_append(&proto, STR_PTR(":"), STR_LEN(":"));
            if !sb_eq(&proto, STR_PTR("https:"), STR_LEN("https:")) { proto_err = true; };
        };
        if !proto_err {
            let host = StrBuf { bytes: [0u8; 65536], len: 0 };
            let hs: u64 = (sep as u64) + 3;
            let he: u64 = hs;
            while he < url.len {
                let b: u8 = url.bytes[he];
                if b == 47 || b == 63 || b == 35 { break; };
                he = he + 1;
            }
            let hp: ptr = PTR_NULL();
            PTR_BYTE_ADD(hp, sb_ptr(&url), hs);
            sb_append(&host, hp, he - hs);
            if host.len == 0 || tool_sb_contains(&host, STR_PTR("@"), STR_LEN("@")) { proto_err = true; };
        };
        if proto_err {
            sb_append(err, STR_PTR("only HTTPS URLs without credentials are allowed: "), STR_LEN("only HTTPS URLs without credentials are allowed: "));
            sb_append(err, sb_ptr(&url), url.len);
            *kind = 1;
            return 1;
        };
        let methods = ByteList { items: [0u8; 4096], len: 0 };
        let mn: u64 = jget_node(e, STR_PTR("methods"), STR_LEN("methods"));
        if mn != 0 && sa_json_node_kind(mn) == JK_ARRAY {
            let mc: u64 = jcount(mn);
            let mi: u64 = 0;
            let mm = StrBuf { bytes: [0u8; 65536], len: 0 };
            while mi < mc && mi < 16 {
                let mel: u64 = jarr_at(mn, mi);
                if mel != 0 && sa_json_node_kind(mel) == JK_STRING {
                    mm.len = 0;
                    let p: ptr = PTR_NULL();
                    let n: u64 = 0;
                    let gst: i32 = sa_json_node_string(mel, &p, &n);
                    sb_append(&mm, p, n);
                    sb_upper_ip(&mm);
                    bl_push(&methods, sb_ptr(&mm), mm.len);
                };
                mi = mi + 1;
            }
        };
        if bl_count(&methods) == 0 { bl_push(&methods, STR_PTR("GET"), STR_LEN("GET")); };
        let mc2: u64 = bl_count(&methods);
        let mi2: u64 = 0;
        let m2 = StrBuf { bytes: [0u8; 65536], len: 0 };
        while mi2 < mc2 {
            bl_at(&methods, mi2, &m2);
            let dec = SaVmPolicyDecision { allowed: false, reason: [0u8; 2048], reason_len: 0, path: [0u8; 1024], path_len: 0, path_has: false };
            checkSaVmHttp(norm, sb_ptr(&url), url.len, sb_ptr(&m2), m2.len, &dec);
            if !dec.allowed {
                sb_append(err, STR_PTR("HTTP capability denied by VM policy: "), STR_LEN("HTTP capability denied by VM policy: "));
                let rp: ptr = PTR_NULL();
                PTR_BYTE_ADD(rp, &dec.reason, 0);
                sb_append(err, rp, dec.reason_len);
                *kind = 1;
                return 1;
            };
            mi2 = mi2 + 1;
        }
    }
    return 0;
}
// ==== batch 19c3c: normalizeSaVmRunInput / resultKind / parallel ====

fn normalizeSaVmRunInput(expanded: &SaVmRunInput, out: &NormalizedRunInput, err: &StrBuf, err_kind: &u64) -> i32 {
    err.len = 0;
    *err_kind = 1;
    let doc: u64 = expanded.node;
    let src_node: u64 = jget_node(doc, STR_PTR("source"), STR_LEN("source"));
    if src_node == 0 || sa_json_node_kind(src_node) != JK_STRING {
        sb_append(err, STR_PTR("source must be a string"), STR_LEN("source must be a string"));
        return 1;
    };
    let sp: ptr = PTR_NULL();
    let sn: u64 = 0;
    let gst: i32 = sa_json_node_string(src_node, &sp, &sn);
    if sn > 524288 {
        sb_append(err, STR_PTR("source exceeds 512 KiB"), STR_LEN("source exceeds 512 KiB"));
        return 1;
    };
    out.source.len = 0;
    gb_append(&out.source, sp, sn);
    let cwd_in = StrBuf { bytes: [0u8; 65536], len: 0 };
    let pc = StrBuf { bytes: [0u8; 65536], len: 0 };
    proc_cwd_sb(&pc);
    if doc_str(doc, STR_PTR("cwd"), STR_LEN("cwd"), &cwd_in) {
        path_resolve(&pc, &cwd_in, &out.cwd);
    } else {
        out.cwd.len = 0;
        sb_append(&out.cwd, sb_ptr(&pc), pc.len);
    };
    let norm = NormalizedSaVmPolicy { engine: 0, fs: NormalizedFs { entries: FsEntryList { items: [SaVmFsEntry { path: [0u8; 1024], path_len: 0, access: 0 }; 128], len: 0 }, read: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, write: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, transfer: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, delete: 0, backupDir: [0u8; 1024], backupDir_len: 0, backupDir_has: false }, http_allow: HttpRuleList { items: [SaVmHttpAllowRule { host: [0u8; 512], host_len: 0, methods: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_methods: false, paths: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_paths: false }; 128], len: 0 }, env_allow: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, process: NormalizedProcess { spawn: false, exec: ExecRuleList { items: [SaVmProcessExecRule { path: [0u8; 4096], path_len: 0, args: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_args: false }; 128], len: 0 }, bunProfiles: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_bunProfiles: false, bun_enabled: false, bun_allowedSubcommands: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_bun: false }, execution_javascript: false, execution_python: false, tools: NormalizedTools { replaceRead: false, replaceWrite: false, replaceApplyPatch: false, replaceExec: false, readFiles: false, editFiles: false, applyPatch: false, fastSearch: false, clearToolHistory: false, findReferences: false, renameSymbol: false, fileOutline: false, moveWithImports: false, findDefinition: false, extractToFile: false, addImport: false, getDiagnostics: false, organizeImports: false, analyzeScope: false, codeGraph: false }, contextSavings: SaVmContextSavingsConfig { locateBeforeRead: false, maxReadFileBytes: 0, maxReadFileBytes_has: false, grepCircuitBreaker: false, grepMaxResults: 0, grepMaxResults_has: false, grepMaxTokens: 0, grepMaxTokens_has: false, slimRunnerOutput: false, parallelBudget: false, parallelMaxTotalBytes: 0, parallelMaxTotalBytes_has: false, parallelMaxReadFiles: 0, parallelMaxReadFiles_has: false, parallelDeduplication: false, tieredSkillInjection: false, foldWaterfallEvents: false, foldHistoryReadSummaries: false, historyReadFoldTurns: 0, historyReadFoldTurns_has: false }, contextSavings_has: false };
    normalize_policy(jget_node(doc, STR_PTR("policy"), STR_LEN("policy")), &out.cwd, &norm);
    let lang_orig = StrBuf { bytes: [0u8; 65536], len: 0 };
    doc_str(doc, STR_PTR("language"), STR_LEN("language"), &lang_orig);
    let lang = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_append(&lang, sb_ptr(&lang_orig), lang_orig.len);
    sb_trim_ip(&lang);
    sb_lower_ip(&lang);
    if sb_eq(&lang, STR_PTR("sa"), STR_LEN("sa")) || sb_eq(&lang, STR_PTR("sla"), STR_LEN("sla")) {
        sb_append(err, STR_PTR("sa/sla runtime was removed in the bun branch; resubmit as js/ts via bun (action \"run_js\" or \"run_bun\")."), STR_LEN("sa/sla runtime was removed in the bun branch; resubmit as js/ts via bun (action \"run_js\" or \"run_bun\")."));
        return 1;
    };
    if sb_eq(&lang, STR_PTR("py"), STR_LEN("py")) || sb_eq(&lang, STR_PTR("python"), STR_LEN("python")) {
        out.is_py = true;
        if !norm.execution_python {
            *err_kind = 2;
            sb_append(err, STR_PTR("Python execution is disabled in VM settings and cannot bypass the VM sandbox. Enable '允许 Python 脚本执行' in VM settings or use packaged native tools."), STR_LEN("Python execution is disabled in VM settings and cannot bypass the VM sandbox. Enable '允许 Python 脚本执行' in VM settings or use packaged native tools."));
            return 1;
        };
    } else if lang.len == 0 || sb_eq(&lang, STR_PTR("js"), STR_LEN("js")) || sb_eq(&lang, STR_PTR("javascript"), STR_LEN("javascript")) || sb_eq(&lang, STR_PTR("node"), STR_LEN("node")) || sb_eq(&lang, STR_PTR("bun"), STR_LEN("bun")) || sb_eq(&lang, STR_PTR("ts"), STR_LEN("ts")) || sb_eq(&lang, STR_PTR("typescript"), STR_LEN("typescript")) {
        out.is_py = false;
        if !norm.execution_javascript {
            *err_kind = 2;
            sb_append(err, STR_PTR("JavaScript execution is disabled in VM settings and cannot bypass the VM sandbox. Please enable '允许 JavaScript / Node 脚本执行' in VM settings to run JS."), STR_LEN("JavaScript execution is disabled in VM settings and cannot bypass the VM sandbox. Please enable '允许 JavaScript / Node 脚本执行' in VM settings to run JS."));
            return 1;
        };
    } else {
        sb_append(err, STR_PTR("unsupported language '"), STR_LEN("unsupported language '"));
        sb_append(err, sb_ptr(&lang_orig), lang_orig.len);
        sb_append(err, STR_PTR("'; bun branch supports js/ts (via bun) and py only."), STR_LEN("'; bun branch supports js/ts (via bun) and py only."));
        return 1;
    };
    out.args.len = 0;
    let args_node: u64 = jget_node(doc, STR_PTR("args"), STR_LEN("args"));
    if args_node != 0 && sa_json_node_kind(args_node) == JK_ARRAY {
        let ac: u64 = jcount(args_node);
        let ai: u64 = 0;
        while ai < ac && ai < 128 {
            let el: u64 = jarr_at(args_node, ai);
            if el != 0 && sa_json_node_kind(el) == JK_STRING {
                let ep: ptr = PTR_NULL();
                let en: u64 = 0;
                let gst2: i32 = sa_json_node_string(el, &ep, &en);
                if en > 4096 {
                    err.len = 0;
                    sb_append(err, STR_PTR("argument exceeds 4096 characters"), STR_LEN("argument exceeds 4096 characters"));
                    return 1;
                };
                bl_push(&out.args, ep, en);
            };
            ai = ai + 1;
        }
    };
    let caps: u64 = jget_node(doc, STR_PTR("capabilities"), STR_LEN("capabilities"));
    if caps != 0 && sa_json_node_kind(caps) == JK_OBJECT {
        let fsn: u64 = jget_node(caps, STR_PTR("fs"), STR_LEN("fs"));
        if fsn != 0 {
            if normalizeFsCaps(fsn, &out.cwd, &norm, err, err_kind) != 0 { return 1; };
        };
        let netn: u64 = jget_node(caps, STR_PTR("net"), STR_LEN("net"));
        if netn != 0 {
            if normalizeNetCaps(netn, &norm, err, err_kind) != 0 { return 1; };
        };
        let envn: u64 = jget_node(caps, STR_PTR("env"), STR_LEN("env"));
        if envn != 0 && sa_json_node_kind(envn) == JK_ARRAY {
            let ec: u64 = jcount(envn);
            let ei: u64 = 0;
            let kept: u64 = 0;
            while ei < ec && kept < 16 {
                let el: u64 = jarr_at(envn, ei);
                ei = ei + 1;
                if el == 0 || sa_json_node_kind(el) != JK_STRING { continue; };
                let nm = StrBuf { bytes: [0u8; 65536], len: 0 };
                let ep: ptr = PTR_NULL();
                let en: u64 = 0;
                let gst3: i32 = sa_json_node_string(el, &ep, &en);
                sb_append(&nm, ep, en);
                if nm.len == 0 { continue; };
                let b0: u8 = nm.bytes[0];
                let ok0: bool = (b0 >= 65 && b0 <= 90) || (b0 >= 97 && b0 <= 122) || b0 == 95;
                if !ok0 { continue; };
                let okall: bool = true;
                let bi: u64 = 1;
                while bi < nm.len {
                    let b: u8 = nm.bytes[bi];
                    if !((b >= 65 && b <= 90) || (b >= 97 && b <= 122) || (b >= 48 && b <= 57) || b == 95) { okall = false; };
                    bi = bi + 1;
                }
                if !okall { continue; };
                kept = kept + 1;
                if !strlist_contains(&norm.env_allow, &nm) {
                    err.len = 0;
                    sb_append(err, STR_PTR("environment capability denied by VM policy: "), STR_LEN("environment capability denied by VM policy: "));
                    sb_append(err, sb_ptr(&nm), nm.len);
                    *err_kind = 1;
                    return 1;
                };
            }
        };
    };
    let base: f64 = 15000.0;
    let tmn: u64 = jget_node(doc, STR_PTR("timeout_ms"), STR_LEN("timeout_ms"));
    let tn2: u64 = jget_node(doc, STR_PTR("timeout"), STR_LEN("timeout"));
    if tmn != 0 && (sa_json_node_kind(tmn) == JK_INT || sa_json_node_kind(tmn) == JK_FLOAT) && sa_json_node_as_f64(tmn) > 0.0 {
        base = sa_json_node_as_f64(tmn);
    } else if tn2 != 0 && (sa_json_node_kind(tn2) == JK_INT || sa_json_node_kind(tn2) == JK_FLOAT) && sa_json_node_as_f64(tn2) > 0.0 {
        let tv: f64 = sa_json_node_as_f64(tn2);
        if tv < 1000.0 { base = tv * 1000.0; } else { base = tv; };
    };
    let limits_node: u64 = jget_node(doc, STR_PTR("limits"), STR_LEN("limits"));
    let dl_node: u64 = 0;
    if limits_node != 0 { dl_node = jget_node(limits_node, STR_PTR("deadline_ms"), STR_LEN("deadline_ms")); };
    out.deadline_ms = clampLimit(dl_node, base, 600000.0);
    return 0;
}

fn resultKind(has_exit: bool, exit_code: i64, stderr: &StrBuf, out: &StrBuf) -> void {
    out.len = 0;
    if has_exit {
        if exit_code == 228 { sb_append(out, STR_PTR("capability_denied"), STR_LEN("capability_denied")); return; };
        if exit_code == 229 { sb_append(out, STR_PTR("fuel_exhausted"), STR_LEN("fuel_exhausted")); return; };
        if exit_code == 230 { sb_append(out, STR_PTR("timeout"), STR_LEN("timeout")); return; };
        if exit_code == 231 { sb_append(out, STR_PTR("mem_quota"), STR_LEN("mem_quota")); return; };
        if exit_code == 233 { sb_append(out, STR_PTR("policy_invalid"), STR_LEN("policy_invalid")); return; };
        if exit_code == 235 { sb_append(out, STR_PTR("stack_overflow"), STR_LEN("stack_overflow")); return; };
        if exit_code == 1 {
            let t = StrBuf { bytes: [0u8; 65536], len: 0 };
            sb_append(&t, sb_ptr(stderr), stderr.len);
            sb_trim_ip(&t);
            if t.len > 0 { sb_append(out, STR_PTR("sa_error"), STR_LEN("sa_error")); return; };
        };
        if exit_code < 128 { sb_append(out, STR_PTR("success"), STR_LEN("success")); return; };
    };
    sb_append(out, STR_PTR("crashed"), STR_LEN("crashed"));
}

fn blocked_segment(seg: &StrBuf) -> bool {
    if sb_eq(seg, STR_PTR("bash"), STR_LEN("bash")) { return true; };
    if sb_eq(seg, STR_PTR("shell"), STR_LEN("shell")) { return true; };
    if sb_eq(seg, STR_PTR("exec"), STR_LEN("exec")) { return true; };
    if sb_eq(seg, STR_PTR("py"), STR_LEN("py")) { return true; };
    if sb_eq(seg, STR_PTR("node"), STR_LEN("node")) { return true; };
    if sb_eq(seg, STR_PTR("nodejs"), STR_LEN("nodejs")) { return true; };
    if sb_eq(seg, STR_PTR("bun"), STR_LEN("bun")) { return true; };
    if sb_eq(seg, STR_PTR("bunx"), STR_LEN("bunx")) { return true; };
    if sb_eq(seg, STR_PTR("deno"), STR_LEN("deno")) { return true; };
    if sb_eq(seg, STR_PTR("tsx"), STR_LEN("tsx")) { return true; };
    if sb_eq(seg, STR_PTR("npx"), STR_LEN("npx")) { return true; };
    if sb_eq(seg, STR_PTR("javascript"), STR_LEN("javascript")) { return true; };
    if sb_eq(seg, STR_PTR("typescript"), STR_LEN("typescript")) { return true; };
    if sb_eq(seg, STR_PTR("js"), STR_LEN("js")) { return true; };
    if sb_eq(seg, STR_PTR("powershell"), STR_LEN("powershell")) { return true; };
    if sb_eq(seg, STR_PTR("pwsh"), STR_LEN("pwsh")) { return true; };
    if sb_eq(seg, STR_PTR("cmd"), STR_LEN("cmd")) { return true; };
    if sb_eq(seg, STR_PTR("apply_patch"), STR_LEN("apply_patch")) { return true; };
    if sb_eq(seg, STR_PTR("write_file"), STR_LEN("write_file")) { return true; };
    if sb_eq(seg, STR_PTR("edit_file"), STR_LEN("edit_file")) { return true; };
    if sb_starts(seg, STR_PTR("python"), STR_LEN("python")) {
        let rest_ok: bool = true;
        let i: u64 = 6;
        while i < seg.len {
            let b: u8 = seg.bytes[i];
            if b < 48 || b > 57 { rest_ok = false; };
            i = i + 1;
        }
        if rest_ok { return true; };
    };
    return false;
}

fn blocked_sep_byte(b: u8) -> bool {
    return b == 46 || b == 58 || b == 47 || b == 45 || b == 95;
}

fn blocked_us_word(value: &StrBuf, wp: ptr, wl: u64) -> bool {
    if value.len < wl { return false; };
    let last: u64 = value.len - wl;
    let s: u64 = 0;
    while s <= last {
        let ok: bool = true;
        let i: u64 = 0;
        while i < wl {
            let b: u8 = value.bytes[s + i];
            if b >= 65 && b <= 90 { b = b + 32; };
            if b != byte_at(wp, i) { ok = false; };
            i = i + 1;
        }
        if ok {
            let bidx: u64 = 0;
            if s > 0 { bidx = s - 1; };
            let before_ok: bool = s == 0 || blocked_sep_byte(value.bytes[bidx]);
            let after: u64 = s + wl;
            let aidx: u64 = after;
            if aidx >= value.len { aidx = 0; };
            let after_ok: bool = after == value.len || blocked_sep_byte(value.bytes[aidx]);
            if before_ok && after_ok { return true; };
        };
        s = s + 1;
    }
    return false;
}

fn isSaVmBlockedToolName(value: &StrBuf) -> bool {
    if blocked_us_word(value, STR_PTR("apply_patch"), STR_LEN("apply_patch")) { return true; };
    if blocked_us_word(value, STR_PTR("write_file"), STR_LEN("write_file")) { return true; };
    if blocked_us_word(value, STR_PTR("edit_file"), STR_LEN("edit_file")) { return true; };
    let seg = StrBuf { bytes: [0u8; 65536], len: 0 };
    let i: u64 = 0;
    while i <= value.len {
        let at_end: bool = i == value.len;
        let is_sep: bool = false;
        if !at_end {
            let b: u8 = value.bytes[i];
            if b == 46 || b == 58 || b == 47 || b == 45 || b == 95 { is_sep = true; };
        };
        if at_end || is_sep {
            if seg.len > 0 {
                sb_lower_ip(&seg);
                if blocked_segment(&seg) { return true; };
                seg.len = 0;
            };
        } else {
            let b2: u8 = value.bytes[i];
            if seg.len < 65535 { seg.bytes[seg.len] = b2; seg.len = seg.len + 1; };
        };
        i = i + 1;
    }
    return false;
}

fn runParallelSaVmTool(input: &SaVmRunInput, out: &SaVmRunResult) -> void {
    let started_at: f64 = now_ms();
    let pkey = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_append(&pkey, STR_PTR("SA_VM_ENABLE_PARALLEL"), STR_LEN("SA_VM_ENABLE_PARALLEL"));
    let penv = StrBuf { bytes: [0u8; 65536], len: 0 };
    let penv_has: bool = env_get_sb(&pkey, &penv);
    if !penv_has || !sb_eq(&penv, STR_PTR("true"), STR_LEN("true")) {
        res_init(out);
        out.ok = false;
        res_set_kind(out, STR_PTR("capability_denied"), STR_LEN("capability_denied"));
        out.has_exitCode = true;
        out.exitCode = 228;
        res_set_stderr(out, STR_PTR("parallel is temporarily disabled: send independent work as multiple sa_vm calls in ONE round (native parallel, read-only calls run concurrently). Batch writes: send sequential edit_file/write_file calls or one apply_patch. Re-enable with SA_VM_ENABLE_PARALLEL=true."), STR_LEN("parallel is temporarily disabled: send independent work as multiple sa_vm calls in ONE round (native parallel, read-only calls run concurrently). Batch writes: send sequential edit_file/write_file calls or one apply_patch. Re-enable with SA_VM_ENABLE_PARALLEL=true."));
        res_set_events(out, STR_PTR("[]"), STR_LEN("[]"));
        let vd: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
        jset_str(vd, STR_PTR("rule"), STR_LEN("rule"), STR_PTR("parallel.temporarily_disabled"), STR_LEN("parallel.temporarily_disabled"));
        jset_bool(vd, STR_PTR("blocked"), STR_LEN("blocked"), true);
        let vjb = JsonBuf { bytes: [0u8; 262144], len: 0 };
        jdoc_to_jb(vd, &vjb);
        res_set_violation(out, jb_ptr(&vjb), vjb.len);
        out.has_saVmViolation = true;
        sa_json_free(vd);
        out.durationMs = dur_since(started_at);
        return;
    };
    let doc: u64 = input.node;
    let tasks: u64 = jget_node(doc, STR_PTR("parallel"), STR_LEN("parallel"));
    let count: u64 = 0;
    if tasks != 0 && sa_json_node_kind(tasks) == JK_ARRAY { count = jcount(tasks); };
    if count == 0 || count > 32 {
        res_init(out);
        out.ok = false;
        res_set_kind(out, STR_PTR("sa_error"), STR_LEN("sa_error"));
        out.has_exitCode = false;
        res_set_stderr(out, STR_PTR("parallel task count must be 1-32"), STR_LEN("parallel task count must be 1-32"));
        res_set_events(out, STR_PTR("[]"), STR_LEN("[]"));
        out.durationMs = 0;
        return;
    };
    let cwd_s = StrBuf { bytes: [0u8; 65536], len: 0 };
    if !doc_str(doc, STR_PTR("cwd"), STR_LEN("cwd"), &cwd_s) { proc_cwd_sb(&cwd_s); };
    let policy_node: u64 = jget_node(doc, STR_PTR("policy"), STR_LEN("policy"));
    let norm = NormalizedSaVmPolicy { engine: 0, fs: NormalizedFs { entries: FsEntryList { items: [SaVmFsEntry { path: [0u8; 1024], path_len: 0, access: 0 }; 128], len: 0 }, read: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, write: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, transfer: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, delete: 0, backupDir: [0u8; 1024], backupDir_len: 0, backupDir_has: false }, http_allow: HttpRuleList { items: [SaVmHttpAllowRule { host: [0u8; 512], host_len: 0, methods: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_methods: false, paths: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_paths: false }; 128], len: 0 }, env_allow: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, process: NormalizedProcess { spawn: false, exec: ExecRuleList { items: [SaVmProcessExecRule { path: [0u8; 4096], path_len: 0, args: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_args: false }; 128], len: 0 }, bunProfiles: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_bunProfiles: false, bun_enabled: false, bun_allowedSubcommands: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_bun: false }, execution_javascript: false, execution_python: false, tools: NormalizedTools { replaceRead: false, replaceWrite: false, replaceApplyPatch: false, replaceExec: false, readFiles: false, editFiles: false, applyPatch: false, fastSearch: false, clearToolHistory: false, findReferences: false, renameSymbol: false, fileOutline: false, moveWithImports: false, findDefinition: false, extractToFile: false, addImport: false, getDiagnostics: false, organizeImports: false, analyzeScope: false, codeGraph: false }, contextSavings: SaVmContextSavingsConfig { locateBeforeRead: false, maxReadFileBytes: 0, maxReadFileBytes_has: false, grepCircuitBreaker: false, grepMaxResults: 0, grepMaxResults_has: false, grepMaxTokens: 0, grepMaxTokens_has: false, slimRunnerOutput: false, parallelBudget: false, parallelMaxTotalBytes: 0, parallelMaxTotalBytes_has: false, parallelMaxReadFiles: 0, parallelMaxReadFiles_has: false, parallelDeduplication: false, tieredSkillInjection: false, foldWaterfallEvents: false, foldHistoryReadSummaries: false, historyReadFoldTurns: 0, historyReadFoldTurns_has: false }, contextSavings_has: false };
    normalize_policy(policy_node, &cwd_s, &norm);
    let budget: bool = norm.contextSavings.parallelBudget;
    if budget {
        let limit: u64 = 4;
        if norm.contextSavings.parallelMaxReadFiles_has { limit = norm.contextSavings.parallelMaxReadFiles; };
        let rf: u64 = 0;
        let ti: u64 = 0;
        while ti < count {
            let t: u64 = jarr_at(tasks, ti);
            ti = ti + 1;
            if t == 0 { continue; };
            let tp: ptr = PTR_NULL();
            let tn: u64 = 0;
            sa_json_node_json_text(t, &tp, &tn);
            let tin = SaVmRunInput { json: [0u8; 262144], json_len: 0, node: 0 };
            input_new(tp, tn, &tin);
            let exp = SaVmRunInput { json: [0u8; 262144], json_len: 0, node: 0 };
            let ee = StrBuf { bytes: [0u8; 65536], len: 0 };
            if expandSaVmActionInput(&tin, &exp, &ee) == 0 {
                let act = StrBuf { bytes: [0u8; 65536], len: 0 };
                if doc_str(exp.node, STR_PTR("action"), STR_LEN("action"), &act) && sb_eq(&act, STR_PTR("read_file"), STR_LEN("read_file")) { rf = rf + 1; };
            };
        }
        if rf > limit {
            res_init(out);
            out.ok = false;
            res_set_kind(out, STR_PTR("capability_denied"), STR_LEN("capability_denied"));
            out.has_exitCode = true;
            out.exitCode = 228;
            let em = StrBuf { bytes: [0u8; 65536], len: 0 };
            sb_append(&em, STR_PTR("[OPT-4] parallel batch rejected: "), STR_LEN("[OPT-4] parallel batch rejected: "));
            tool_sb_append_u64(rf, &em);
            sb_append(&em, STR_PTR(" full read_file task(s) exceed the limit of "), STR_LEN(" full read_file task(s) exceed the limit of "));
            tool_sb_append_u64(limit, &em);
            sb_append(&em, STR_PTR(". Scout with list_dir / find_references first, then read_lines for targeted ranges."), STR_LEN(". Scout with list_dir / find_references first, then read_lines for targeted ranges."));
            res_set_stderr(out, sb_ptr(&em), em.len);
            res_set_events(out, STR_PTR("[]"), STR_LEN("[]"));
            let vd: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
            jset_str(vd, STR_PTR("rule"), STR_LEN("rule"), STR_PTR("contextSavings.parallelBudget"), STR_LEN("contextSavings.parallelBudget"));
            jset_bool(vd, STR_PTR("blocked"), STR_LEN("blocked"), false);
            let vjb = JsonBuf { bytes: [0u8; 262144], len: 0 };
            jdoc_to_jb(vd, &vjb);
            res_set_violation(out, jb_ptr(&vjb), vjb.len);
            out.has_saVmViolation = true;
            sa_json_free(vd);
            out.durationMs = dur_since(started_at);
            return;
        };
    };
    if policy_node != 0 {
        let dkind = StrBuf { bytes: [0u8; 65536], len: 0 };
        let dpath = StrBuf { bytes: [0u8; 65536], len: 0 };
        let widx: u64 = 0;
        let ridx: u64 = 0;
        if detectBatchDependencyViolation(tasks, &cwd_s, &dkind, &dpath, &widx, &ridx) {
            res_init(out);
            out.ok = false;
            res_set_kind(out, STR_PTR("capability_denied"), STR_LEN("capability_denied"));
            out.has_exitCode = true;
            out.exitCode = 1;
            let is_ww: bool = sb_eq(&dkind, STR_PTR("write-write"), STR_LEN("write-write"));
            let em = StrBuf { bytes: [0u8; 65536], len: 0 };
            let ereason = StrBuf { bytes: [0u8; 65536], len: 0 };
            if is_ww {
                sb_append(&em, STR_PTR("Dependency violation: intra-batch concurrent writes to '"), STR_LEN("Dependency violation: intra-batch concurrent writes to '"));
                sb_append(&em, sb_ptr(&dpath), dpath.len);
                sb_append(&em, STR_PTR("' race (lost update). Split into two sequential batches."), STR_LEN("' race (lost update). Split into two sequential batches."));
                sb_append(&ereason, STR_PTR("intra-batch concurrent writes race"), STR_LEN("intra-batch concurrent writes race"));
            } else {
                sb_append(&em, STR_PTR("Dependency violation: intra-batch read of write/build output for '"), STR_LEN("Dependency violation: intra-batch read of write/build output for '"));
                sb_append(&em, sb_ptr(&dpath), dpath.len);
                sb_append(&em, STR_PTR("' is forbidden. Split into two sequential batches."), STR_LEN("' is forbidden. Split into two sequential batches."));
                sb_append(&ereason, STR_PTR("intra-batch read of write/build output is forbidden"), STR_LEN("intra-batch read of write/build output is forbidden"));
            };
            res_set_stderr(out, sb_ptr(&em), em.len);
            let ev: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
            let eo: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
            jset_str(eo, STR_PTR("event"), STR_LEN("event"), STR_PTR("violation"), STR_LEN("violation"));
            jset_str(eo, STR_PTR("kind"), STR_LEN("kind"), STR_PTR("dependency_violation"), STR_LEN("dependency_violation"));
            jset_str(eo, STR_PTR("path"), STR_LEN("path"), sb_ptr(&dpath), dpath.len);
            jset_str(eo, STR_PTR("reason"), STR_LEN("reason"), sb_ptr(&ereason), ereason.len);
            let pst: i32 = sa_json_array_push_node(ev, eo);
            let ejb = JsonBuf { bytes: [0u8; 262144], len: 0 };
            jdoc_to_jb(ev, &ejb);
            res_set_events(out, jb_ptr(&ejb), ejb.len);
            sa_json_free(ev);
            let vd: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
            jset_str(vd, STR_PTR("rule"), STR_LEN("rule"), STR_PTR("parallel.dependency_violation"), STR_LEN("parallel.dependency_violation"));
            jset_bool(vd, STR_PTR("blocked"), STR_LEN("blocked"), true);
            jset_str(vd, STR_PTR("path"), STR_LEN("path"), sb_ptr(&dpath), dpath.len);
            let vjb = JsonBuf { bytes: [0u8; 262144], len: 0 };
            jdoc_to_jb(vd, &vjb);
            res_set_violation(out, jb_ptr(&vjb), vjb.len);
            out.has_saVmViolation = true;
            sa_json_free(vd);
            out.durationMs = dur_since(started_at);
            return;
        };
    };
    // dedup keys + canonical map
    let dedup: bool = norm.contextSavings.parallelDeduplication;
    let keys_doc: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    let canon: [u64; 32] = [0u64; 32];
    let uniq: [u64; 32] = [0u64; 32];
    let uniq_count: u64 = 0;
    let parent_cwd = StrBuf { bytes: [0u8; 65536], len: 0 };
    let has_parent_cwd: bool = doc_str(doc, STR_PTR("cwd"), STR_LEN("cwd"), &parent_cwd);
    let ti2: u64 = 0;
    while ti2 < count {
        let t: u64 = jarr_at(tasks, ti2);
        let key = StrBuf { bytes: [0u8; 65536], len: 0 };
        if t != 0 {
            let f = StrBuf { bytes: [0u8; 65536], len: 0 };
            if doc_coerce_str(t, STR_PTR("cwd"), STR_LEN("cwd"), &f) { sb_append(&key, sb_ptr(&f), f.len); } else if has_parent_cwd { sb_append(&key, sb_ptr(&parent_cwd), parent_cwd.len); };
            sb_append(&key, STR_PTR("|"), STR_LEN("|"));
            f.len = 0;
            if doc_coerce_str(t, STR_PTR("action"), STR_LEN("action"), &f) { sb_append(&key, sb_ptr(&f), f.len); };
            sb_append(&key, STR_PTR("|"), STR_LEN("|"));
            f.len = 0;
            if doc_coerce_str(t, STR_PTR("path"), STR_LEN("path"), &f) { sb_append(&key, sb_ptr(&f), f.len); };
            sb_append(&key, STR_PTR("|"), STR_LEN("|"));
            f.len = 0;
            if doc_coerce_str(t, STR_PTR("source"), STR_LEN("source"), &f) { sb_append(&key, sb_ptr(&f), f.len); };
            sb_append(&key, STR_PTR("|"), STR_LEN("|"));
            let an: u64 = jget_node(t, STR_PTR("args"), STR_LEN("args"));
            if an != 0 {
                let ap: ptr = PTR_NULL();
                let an2: u64 = 0;
                sa_json_node_json_text(an, &ap, &an2);
                sb_append(&key, ap, an2);
            } else {
                sb_append(&key, STR_PTR("[]"), STR_LEN("[]"));
            };
        };
        let found: u64 = 4294967295;
        if dedup {
            let kc: u64 = jcount(keys_doc);
            let ki: u64 = 0;
            while ki < kc {
                let kn: u64 = jarr_at(keys_doc, ki);
                if kn != 0 && sa_json_node_kind(kn) == JK_STRING {
                    let kp: ptr = PTR_NULL();
                    let kn2: u64 = 0;
                    let gst: i32 = sa_json_node_string(kn, &kp, &kn2);
                    if kn2 == key.len && tool_bytes_eq(kp, kn2, sb_ptr(&key), key.len) { found = ki; break; };
                };
                ki = ki + 1;
            }
        };
        if found == 4294967295 {
            let pst: i32 = sa_json_array_push_string(keys_doc, sb_ptr(&key), key.len);
            canon[ti2] = uniq_count;
            uniq[uniq_count] = ti2;
            uniq_count = uniq_count + 1;
        } else {
            canon[ti2] = found;
        };
        ti2 = ti2 + 1;
    }
    // run canonical tasks sequentially, caching results as docs
    let cache: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    let pol_text = StrBuf { bytes: [0u8; 65536], len: 0 };
    let has_pol_text: bool = false;
    if policy_node != 0 {
        let pp: ptr = PTR_NULL();
        let pn: u64 = 0;
        sa_json_node_json_text(policy_node, &pp, &pn);
        sb_append(&pol_text, pp, pn);
        has_pol_text = pol_text.len > 0;
    };
    let empty_sb = StrBuf { bytes: [0u8; 65536], len: 0 };
    let ui: u64 = 0;
    while ui < uniq_count {
        let tidx: u64 = uniq[ui];
        let t: u64 = jarr_at(tasks, tidx);
        let tp: ptr = PTR_NULL();
        let tn: u64 = 0;
        sa_json_node_json_text(t, &tp, &tn);
        let tdoc: u64 = sa_json_parse(tp, tn);
        let rmst: i32 = sa_json_object_remove(tdoc, STR_PTR("parallel"), STR_LEN("parallel"));
        if jget_node(tdoc, STR_PTR("cwd"), STR_LEN("cwd")) == 0 && has_parent_cwd {
            jset_str(tdoc, STR_PTR("cwd"), STR_LEN("cwd"), sb_ptr(&parent_cwd), parent_cwd.len);
        };
        if jget_node(tdoc, STR_PTR("policy"), STR_LEN("policy")) == 0 && has_pol_text {
            let pdoc: u64 = sa_json_parse(sb_ptr(&pol_text), pol_text.len);
            if pdoc != 0 { jset_node(tdoc, STR_PTR("policy"), STR_LEN("policy"), pdoc); };
        };
        if jget_node(tdoc, STR_PTR("additionalRoots"), STR_LEN("additionalRoots")) == 0 {
            let arn: u64 = jget_node(doc, STR_PTR("additionalRoots"), STR_LEN("additionalRoots"));
            if arn != 0 {
                let ap: ptr = PTR_NULL();
                let an3: u64 = 0;
                sa_json_node_json_text(arn, &ap, &an3);
                let adoc: u64 = sa_json_parse(ap, an3);
                if adoc != 0 { jset_node(tdoc, STR_PTR("additionalRoots"), STR_LEN("additionalRoots"), adoc); };
            };
        };
        let tin = SaVmRunInput { json: [0u8; 262144], json_len: 0, node: 0 };
        let tjb = JsonBuf { bytes: [0u8; 262144], len: 0 };
        jdoc_to_jb(tdoc, &tjb);
        input_new(jb_ptr(&tjb), tjb.len, &tin);
        let sub = run_result_new();
        runSaVmTool(&tin, 0, false, &empty_sb, false, &sub);
        let cd: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
        jset_bool(cd, STR_PTR("ok"), STR_LEN("ok"), sub.ok);
        let kp2: ptr = PTR_NULL();
        PTR_BYTE_ADD(kp2, &sub.kind, 0);
        jset_str(cd, STR_PTR("kind"), STR_LEN("kind"), kp2, sub.kind_len);
        jset_bool(cd, STR_PTR("has_exit"), STR_LEN("has_exit"), sub.has_exitCode);
        jset_i64(cd, STR_PTR("exit"), STR_LEN("exit"), sub.exitCode);
        let op3: ptr = PTR_NULL();
        PTR_BYTE_ADD(op3, &sub.stdout, 0);
        jset_str(cd, STR_PTR("stdout"), STR_LEN("stdout"), op3, sub.stdout_len);
        let ep3: ptr = PTR_NULL();
        PTR_BYTE_ADD(ep3, &sub.stderr, 0);
        jset_str(cd, STR_PTR("stderr"), STR_LEN("stderr"), ep3, sub.stderr_len);
        let evp3: ptr = PTR_NULL();
        PTR_BYTE_ADD(evp3, &sub.saVmEvents_json, 0);
        jset_str(cd, STR_PTR("events"), STR_LEN("events"), evp3, sub.saVmEvents_json_len);
        jset_bool(cd, STR_PTR("has_violation"), STR_LEN("has_violation"), sub.has_saVmViolation);
        if sub.has_saVmViolation {
            let vp3: ptr = PTR_NULL();
            PTR_BYTE_ADD(vp3, &sub.saVmViolation_json, 0);
            jset_str(cd, STR_PTR("violation"), STR_LEN("violation"), vp3, sub.saVmViolation_json_len);
        };
        let pst2: i32 = sa_json_array_push_node(cache, cd);
        sa_json_free(tdoc);
        ui = ui + 1;
    }
    // combine in original index order
    let all_ok: bool = true;
    let first_bad_kind = StrBuf { bytes: [0u8; 65536], len: 0 };
    let first_bad_exit: i64 = 1;
    let have_bad: bool = false;
    let acc = JsonBuf { bytes: [0u8; 262144], len: 0 };
    let acc_err = StrBuf { bytes: [0u8; 65536], len: 0 };
    let ev_all: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    let viol_text = StrBuf { bytes: [0u8; 65536], len: 0 };
    let have_viol: bool = false;
    let oi: u64 = 0;
    while oi < count {
        let cd2: u64 = jarr_at(cache, canon[oi]);
        oi = oi + 1;
        if cd2 == 0 { continue; };
        let rok: bool = false;
        let bn: u64 = jget_node(cd2, STR_PTR("ok"), STR_LEN("ok"));
        if bn != 0 { rok = sa_json_node_as_bool(bn); };
        let body = StrBuf { bytes: [0u8; 65536], len: 0 };
        doc_str(cd2, STR_PTR("stdout"), STR_LEN("stdout"), &body);
        let trunc: bool = false;
        if budget && body.len > 20480 {
            trunc = true;
            let nb = StrBuf { bytes: [0u8; 65536], len: 0 };
            sb_append(&nb, sb_ptr(&body), 20480);
            body.len = 0;
            sb_append(&body, sb_ptr(&nb), nb.len);
        };
        jb_append(&acc, STR_PTR("[parallel:"), STR_LEN("[parallel:"));
        let nbuf = StrBuf { bytes: [0u8; 65536], len: 0 };
        fmt_u64_sb(oi - 1, &nbuf);
        jb_append_sb(&acc, &nbuf);
        jb_append(&acc, STR_PTR("]"), STR_LEN("]"));
        if trunc { jb_append(&acc, STR_PTR(" [OPT-4 single truncated]"), STR_LEN(" [OPT-4 single truncated]")); };
        jb_append(&acc, STR_PTR("\n"), STR_LEN("\n"));
        jb_append(&acc, sb_ptr(&body), body.len);
        let ebody = StrBuf { bytes: [0u8; 65536], len: 0 };
        doc_str(cd2, STR_PTR("stderr"), STR_LEN("stderr"), &ebody);
        if ebody.len > 0 {
            sb_append(&acc_err, STR_PTR("[parallel:"), STR_LEN("[parallel:"));
            tool_sb_append_u64(oi - 1, &acc_err);
            sb_append(&acc_err, STR_PTR("]\n"), STR_LEN("]\n"));
            sb_append(&acc_err, sb_ptr(&ebody), ebody.len);
        };
        if !rok {
            all_ok = false;
            if !have_bad {
                have_bad = true;
                doc_str(cd2, STR_PTR("kind"), STR_LEN("kind"), &first_bad_kind);
                let hn: u64 = jget_node(cd2, STR_PTR("has_exit"), STR_LEN("has_exit"));
                let xn: u64 = jget_node(cd2, STR_PTR("exit"), STR_LEN("exit"));
                if hn != 0 && sa_json_node_as_bool(hn) && xn != 0 { first_bad_exit = sa_json_node_as_f64(xn) as i64; } else { first_bad_exit = 1; };
            };
        };
        let ev_text = StrBuf { bytes: [0u8; 65536], len: 0 };
        doc_str(cd2, STR_PTR("events"), STR_LEN("events"), &ev_text);
        if ev_text.len > 0 {
            let ev_doc: u64 = sa_json_parse(sb_ptr(&ev_text), ev_text.len);
            if ev_doc != 0 && sa_json_node_kind(ev_doc) == JK_ARRAY {
                let ec: u64 = jcount(ev_doc);
                let ei: u64 = 0;
                while ei < ec {
                    let item: u64 = jarr_at(ev_doc, ei);
                    if item != 0 {
                        jset_i64(item, STR_PTR("parallelIndex"), STR_LEN("parallelIndex"), (oi - 1) as i64);
                        let pst3: i32 = sa_json_array_push_node(ev_all, item);
                    };
                    ei = ei + 1;
                }
            };
            if ev_doc != 0 { sa_json_free(ev_doc); };
        };
        if !have_viol {
            let hn2: u64 = jget_node(cd2, STR_PTR("has_violation"), STR_LEN("has_violation"));
            if hn2 != 0 && sa_json_node_as_bool(hn2) {
                if doc_str(cd2, STR_PTR("violation"), STR_LEN("violation"), &viol_text) { have_viol = viol_text.len > 0; };
            };
        };
    }
    if dedup && uniq_count < count {
        jb_append(&acc, STR_PTR("\n[OPT-9] "), STR_LEN("\n[OPT-9] "));
        let nbuf2 = StrBuf { bytes: [0u8; 65536], len: 0 };
        fmt_u64_sb(count - uniq_count, &nbuf2);
        jb_append_sb(&acc, &nbuf2);
        jb_append(&acc, STR_PTR(" duplicate task(s) deduplicated."), STR_LEN(" duplicate task(s) deduplicated."));
    };
    if budget {
        let max_total: u64 = 204800;
        if norm.contextSavings.parallelMaxTotalBytes_has { max_total = norm.contextSavings.parallelMaxTotalBytes; };
        if acc.len > max_total {
            acc.len = max_total;
            jb_append(&acc, STR_PTR("\n[OPT-4] parallel total output truncated to "), STR_LEN("\n[OPT-4] parallel total output truncated to "));
            let nbuf3 = StrBuf { bytes: [0u8; 65536], len: 0 };
            fmt_u64_sb(max_total, &nbuf3);
            jb_append_sb(&acc, &nbuf3);
            jb_append(&acc, STR_PTR(" bytes; split the batch or narrow read ranges."), STR_LEN(" bytes; split the batch or narrow read ranges."));
        };
    };
    res_init(out);
    out.ok = all_ok;
    if all_ok { res_set_kind(out, STR_PTR("success"), STR_LEN("success")); } else { res_set_kind(out, sb_ptr(&first_bad_kind), first_bad_kind.len); };
    out.has_exitCode = true;
    if all_ok { out.exitCode = 0; } else { out.exitCode = first_bad_exit; };
    res_set_stdout(out, jb_ptr(&acc), acc.len);
    res_set_stderr(out, sb_ptr(&acc_err), acc_err.len);
    let ejb2 = JsonBuf { bytes: [0u8; 262144], len: 0 };
    jdoc_to_jb(ev_all, &ejb2);
    res_set_events(out, jb_ptr(&ejb2), ejb2.len);
    sa_json_free(ev_all);
    if have_viol {
        res_set_violation(out, sb_ptr(&viol_text), viol_text.len);
        out.has_saVmViolation = true;
    };
    out.durationMs = dur_since(started_at);
    sa_json_free(keys_doc);
    sa_json_free(cache);
}
