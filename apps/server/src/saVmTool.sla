        } else if total_candidates >= cap {
            tpages = pg.page as u64;
            if (pg.offset as u64) + ps < total_candidates { tpages = tpages + 1; };
        } else if total_candidates > 0 {
            tpages = (total_candidates + ps - 1) / ps;
        };
    } else {
        let tv = StrBuf { bytes: [0u8; 65536], len: 0 };
        let tii: u64 = 0;
        while tii < total_candidates {
            let g1: bool = lb_at(&ctx.candidates, tii, &tv);
            lb_append(&targets, sb_ptr(&tv), tv.len);
            tii = tii + 1;
        }
    };
    let blocks = ListBuf { bytes: [0u8; 131072], len: 0 };
    let used_tokens: f64 = 0.0;
    let outlined: u64 = 0;
    let files_truncated: u64 = 0;
    let skipped_large: u64 = 0;
    let skipped_binary: u64 = 0;
    let full = StrBuf { bytes: [0u8; 65536], len: 0 };
    let tii: u64 = 0;
    let tcount: u64 = lb_count(&targets);
    while tii < tcount {
        if now_ms() - started_at > timeout_ms {
            ctx.timed_out = true;
            break;
        };
        let got: bool = lb_at(&targets, tii, &full);
        if got {
            let rel = StrBuf { bytes: [0u8; 65536], len: 0 };
            tool_path_relative(cwd, &full, &rel);
            let text = StrBuf { bytes: [0u8; 65536], len: 0 };
            let state: u64 = 0;
            readSearchableText(&full, max_bytes, &text, &state);
            if state == 1 {
                skipped_large = skipped_large + 1;
            } else if state == 2 {
                skipped_binary = skipped_binary + 1;
            } else if state == 0 {
                let st = TreeSitterState { parserInitDone: false, parserInstance: 0, languageCache_names: [0u8; 4096], languageCache_names_len: 0, languageCache_vals: [0u64; 128], languageCache_len: 0, sfCache_paths: [0u8; 8192], sfCache_paths_len: 0, sfCache_contents_first: 0, sfCache_len: 0 };
                let pool = OutlineSymbolList { items: [OutlineSymbol { name: [0u8; 256], name_len: 0, kind: 0, startLine: 0, endLine: 0, signature: [0u8; 512], signature_len: 0, has_signature: false, children_first: 0, children_len: 0 }; 1024], len: 0 };
                let ores = FileOutlineResult { filePath: [0u8; 1024], filePath_len: 0, language: [0u8; 64], language_len: 0, has_language: false, totalLines: 0, symbols_first: 0, symbols_len: 0, formatted: [0u8; 65536], formatted_len: 0 };
                extractFileOutline(&st, &pool, &rel, &text, detail, &ores);
                let nlines: u64 = 1;
                let nbi: u64 = 0;
                while nbi < text.len {
                    if text.bytes[nbi] == 10 { nlines = nlines + 1; };
                    nbi = nbi + 1;
                }
                let sym_count: u64 = ores.symbols_len;
                if sym_count > (max_syms as u64) { sym_count = max_syms as u64; };
                let block = StrBuf { bytes: [0u8; 65536], len: 0 };
                formatOutlineAsTree(&rel, nlines, &pool, ores.symbols_first, sym_count, &block);
                let cost: f64 = estimateTokenCount(&block);
                if used_tokens + cost > max_tokens && lb_count(&blocks) > 0 {
                    files_truncated = files_truncated + 1;
                } else {
                    lb_append(&blocks, sb_ptr(&block), block.len);
                    used_tokens = used_tokens + cost;
                    outlined = outlined + 1;
                };
            };
        };
        tii = tii + 1;
    }
    // header + notes
    let out_sb = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_assign(&out_sb, STR_PTR("[workspace_outline] "), STR_LEN("[workspace_outline] "));
    sb_append(&out_sb, sb_ptr(&dir), dir.len);
    if pg.paginated {
        sb_append(&out_sb, STR_PTR(" (page "), STR_LEN(" (page "));
        sb_append_f64(pg.page, &out_sb);
        sb_append(&out_sb, STR_PTR("/"), STR_LEN("/"));
        tool_sb_append_u64(tpages, &out_sb);
        sb_append(&out_sb, STR_PTR(", "), STR_LEN(", "));
        tool_sb_append_u64(outlined, &out_sb);
        sb_append(&out_sb, STR_PTR("/"), STR_LEN("/"));
        tool_sb_append_u64(tcount, &out_sb);
        sb_append(&out_sb, STR_PTR(" outlined, total "), STR_LEN(" outlined, total "));
        tool_sb_append_u64(total_candidates, &out_sb);
        sb_append(&out_sb, STR_PTR(" files)"), STR_LEN(" files)"));
        sb_append(&out_sb, STR_PTR("\n[page "), STR_LEN("\n[page "));
        sb_append_f64(pg.page, &out_sb);
        sb_append(&out_sb, STR_PTR(" of "), STR_LEN(" of "));
        tool_sb_append_u64(tpages, &out_sb);
        sb_append(&out_sb, STR_PTR(" | page_size "), STR_LEN(" | page_size "));
        sb_append_f64(pg.page_size, &out_sb);
        sb_append(&out_sb, STR_PTR(" | total "), STR_LEN(" | total "));
        tool_sb_append_u64(total_candidates, &out_sb);
        sb_append(&out_sb, STR_PTR(" | has_next "), STR_LEN(" | has_next "));
        let hn: bool = false;
        if total_candidates >= cap || ctx.timed_out {
            hn = true;
        } else {
            hn = (pg.offset as u64) + (pg.page_size as u64) < total_candidates;
        };
        if hn { sb_append(&out_sb, STR_PTR("true"), STR_LEN("true")); } else { sb_append(&out_sb, STR_PTR("false"), STR_LEN("false")); };
        sb_append(&out_sb, STR_PTR(" | has_prev "), STR_LEN(" | has_prev "));
        if pg.offset > 0.0 { sb_append(&out_sb, STR_PTR("true"), STR_LEN("true")); } else { sb_append(&out_sb, STR_PTR("false"), STR_LEN("false")); };
        sb_append(&out_sb, STR_PTR("]"), STR_LEN("]"));
    } else {
        sb_append(&out_sb, STR_PTR(" ("), STR_LEN(" ("));
        tool_sb_append_u64(outlined, &out_sb);
        sb_append(&out_sb, STR_PTR("/"), STR_LEN("/"));
        tool_sb_append_u64(total_candidates, &out_sb);
        sb_append(&out_sb, STR_PTR(" files outlined)"), STR_LEN(" files outlined)"));
    };
    let notes = StrBuf { bytes: [0u8; 65536], len: 0 };
    let note_parts = ListBuf { bytes: [0u8; 131072], len: 0 };
    let np = StrBuf { bytes: [0u8; 65536], len: 0 };
    if ctx.skipped_filtered > 0 {
        np.len = 0;
        sb_assign(&np, STR_PTR("skipped "), STR_LEN("skipped "));
        tool_sb_append_u64(ctx.skipped_filtered, &np);
        sb_append(&np, STR_PTR(" ignored/excluded paths"), STR_LEN(" ignored/excluded paths"));
        lb_append(&note_parts, sb_ptr(&np), np.len);
    };
    if skipped_large > 0 {
        np.len = 0;
        sb_assign(&np, STR_PTR("skipped "), STR_LEN("skipped "));
        tool_sb_append_u64(skipped_large, &np);
        sb_append(&np, STR_PTR(" files exceeding max_file_bytes="), STR_LEN(" files exceeding max_file_bytes="));
        sb_append_f64(max_bytes, &np);
        lb_append(&note_parts, sb_ptr(&np), np.len);
    };
    if skipped_binary > 0 {
        np.len = 0;
        sb_assign(&np, STR_PTR("skipped "), STR_LEN("skipped "));
        tool_sb_append_u64(skipped_binary, &np);
        sb_append(&np, STR_PTR(" binary files"), STR_LEN(" binary files"));
        lb_append(&note_parts, sb_ptr(&np), np.len);
    };
    if files_truncated > 0 {
        np.len = 0;
        sb_assign(&np, STR_PTR(""), 0);
        tool_sb_append_u64(files_truncated, &np);
        sb_append(&np, STR_PTR(" files omitted over max_tokens="), STR_LEN(" files omitted over max_tokens="));
        sb_append_f64(max_tokens, &np);
        sb_append(&np, STR_PTR("; narrow dir/pattern or raise max_tokens"), STR_LEN("; narrow dir/pattern or raise max_tokens"));
        lb_append(&note_parts, sb_ptr(&np), np.len);
    };
    if ctx.timed_out {
        np.len = 0;
        sb_assign(&np, STR_PTR("timeout after "), STR_LEN("timeout after "));
        sb_append_f64(timeout_ms, &np);
        sb_append(&np, STR_PTR("ms; showing partial results"), STR_LEN("ms; showing partial results"));
        lb_append(&note_parts, sb_ptr(&np), np.len);
    };
    if pg.paginated && total_candidates >= cap {
        np.len = 0;
        sb_assign(&np, STR_PTR("results capped at count_cap="), STR_LEN("results capped at count_cap="));
        sb_append_f64(pg.count_cap, &np);
        sb_append(&np, STR_PTR("; narrow dir/pattern or raise count_cap"), STR_LEN("; narrow dir/pattern or raise count_cap"));
        lb_append(&note_parts, sb_ptr(&np), np.len);
    };
    if lb_count(&note_parts) > 0 {
        sb_append(&out_sb, STR_PTR("\n["), STR_LEN("\n["));
        let nv = StrBuf { bytes: [0u8; 65536], len: 0 };
        let ni: u64 = 0;
        while ni < lb_count(&note_parts) {
            let g1: bool = lb_at(&note_parts, ni, &nv);
            if ni > 0 { sb_append(&out_sb, STR_PTR("; "), STR_LEN("; ")); };
            sb_append(&out_sb, sb_ptr(&nv), nv.len);
            ni = ni + 1;
        }
        sb_append(&out_sb, STR_PTR("]"), STR_LEN("]"));
    };
    sb_append(&out_sb, STR_PTR("\n\n"), STR_LEN("\n\n"));
    let bv = StrBuf { bytes: [0u8; 65536], len: 0 };
    let bii: u64 = 0;
    while bii < lb_count(&blocks) {
        let g1: bool = lb_at(&blocks, bii, &bv);
        if bii > 0 { sb_append(&out_sb, STR_PTR("\n\n"), STR_LEN("\n\n")); };
        sb_append(&out_sb, sb_ptr(&bv), bv.len);
        bii = bii + 1;
    }
    res_success(out, started_at);
    res_set_stdout(out, sb_ptr(&out_sb), out_sb.len);
    let ev: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    let eo: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    if ev != 0 && eo != 0 {
        jset_i64(eo, STR_PTR("timestamp"), STR_LEN("timestamp"), sa_time_unix_ms());
        jset_str(eo, STR_PTR("type"), STR_LEN("type"), STR_PTR("workspace_outline"), STR_LEN("workspace_outline"));
        jset_str(eo, STR_PTR("dir"), STR_LEN("dir"), sb_ptr(&dir), dir.len);
        jset_f64(eo, STR_PTR("files"), STR_LEN("files"), outlined as f64);
        if pg.paginated {
            jset_f64(eo, STR_PTR("page"), STR_LEN("page"), pg.page);
            jset_f64(eo, STR_PTR("page_size"), STR_LEN("page_size"), pg.page_size);
            jset_f64(eo, STR_PTR("total"), STR_LEN("total"), total_candidates as f64);
            jset_f64(eo, STR_PTR("total_pages"), STR_LEN("total_pages"), tpages as f64);
        };
        let rcp: i32 = sa_json_array_push_node(ev, eo);
        let ejb = JsonBuf { bytes: [0u8; 262144], len: 0 };
        jdoc_to_jb(ev, &ejb);
        res_set_events(out, jb_ptr(&ejb), ejb.len);
        let bfix8650: i32 = sa_json_free(ev);
    } else {
        if ev != 0 { sa_json_free(ev); };
    };
    if odoc != 0 { sa_json_free(odoc); };
    return 0;
}

fn re_first_group(re: u64, p: ptr, n: u64, group: u64, out: &StrBuf) -> bool {
    out.len = 0;
    if re == 0 { return false; };
    let m: u64 = sa_regex_match(re, p, n);
    if m == 0 { return false; };
    let s: u64 = sa_regex_group_start(m, group as u32);
    let l: u64 = sa_regex_group_len(m, group as u32);
    let gp: ptr = PTR_NULL();
    PTR_BYTE_ADD(gp, p, s);
    sb_append(out, gp, l);
    let rcf: i32 = sa_regex_match_free(m);
    return l > 0 || s > 0;
}

fn collectImports_push(imports: &ListBuf, value: &StrBuf) -> void {
    let tr = StrBuf { bytes: [0u8; 65536], len: 0 };
    tool_sb_trim(value, &tr);
    // strip leading/trailing runs of ' and "
    let start: u64 = 0;
    while start < tr.len && (tr.bytes[start] == 39 || tr.bytes[start] == 34) { start = start + 1; }
    let end: u64 = tr.len;
    while end > start && (tr.bytes[end - 1] == 39 || tr.bytes[end - 1] == 34) { end = end - 1; }
    let cleaned = StrBuf { bytes: [0u8; 65536], len: 0 };
    if end > start {
        let sp: ptr = PTR_NULL();
        PTR_BYTE_ADD(sp, sb_ptr(&tr), start);
        sb_append(&cleaned, sp, end - start);
    };
    if cleaned.len > 0 && cleaned.len < 256 && !lb_contains(imports, sb_ptr(&cleaned), cleaned.len) {
        lb_append(imports, sb_ptr(&cleaned), cleaned.len);
    };
}

fn collectFileImports(file_path: &StrBuf, content: &StrBuf, out: &ListBuf) -> void {
    out.len = 0;
    // ext = segment after the last "." (whole path when no dot), lowercased
    let ext = StrBuf { bytes: [0u8; 65536], len: 0 };
    let dot: i64 = sb_last_index_of(file_path, STR_PTR("."), STR_LEN("."));
    if dot >= 0 {
        let pr8715_0: ptr = PTR_NULL();
        PTR_BYTE_ADD(pr8715_0, sb_ptr(file_path), (dot as u64) + 1);
        sb_append(&ext, pr8715_0, file_path.len - (dot as u64) - 1);
    } else {
        sb_copy(&ext, file_path);
    };
    let ext_l = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_to_lower(&ext, &ext_l);
    let is_tsjs: bool = tool_bytes_eq(sb_ptr(&ext_l), ext_l.len, STR_PTR("ts"), 2) || tool_bytes_eq(sb_ptr(&ext_l), ext_l.len, STR_PTR("tsx"), 3) || tool_bytes_eq(sb_ptr(&ext_l), ext_l.len, STR_PTR("js"), 2) || tool_bytes_eq(sb_ptr(&ext_l), ext_l.len, STR_PTR("jsx"), 3) || tool_bytes_eq(sb_ptr(&ext_l), ext_l.len, STR_PTR("mjs"), 3) || tool_bytes_eq(sb_ptr(&ext_l), ext_l.len, STR_PTR("cjs"), 3) || tool_bytes_eq(sb_ptr(&ext_l), ext_l.len, STR_PTR("mts"), 3) || tool_bytes_eq(sb_ptr(&ext_l), ext_l.len, STR_PTR("cts"), 3);
    let is_py: bool = tool_bytes_eq(sb_ptr(&ext_l), ext_l.len, STR_PTR("py"), 2);
    let is_go: bool = tool_bytes_eq(sb_ptr(&ext_l), ext_l.len, STR_PTR("go"), 2);
    let is_rs: bool = tool_bytes_eq(sb_ptr(&ext_l), ext_l.len, STR_PTR("rs"), 2);
    let is_zig: bool = tool_bytes_eq(sb_ptr(&ext_l), ext_l.len, STR_PTR("zig"), 3);
    if !is_tsjs && !is_py && !is_go && !is_rs && !is_zig { return; };
    let re_ts1: u64 = sa_regex_compile(STR_PTR("^(import[[:space:]]+([^'\"]*[[:space:]]+from[[:space:]]+)?|export[[:space:]]+.*[[:space:]]+from[[:space:]]+)['\"]([^'\"]+)['\"]"), STR_LEN("^(import[[:space:]]+([^'\"]*[[:space:]]+from[[:space:]]+)?|export[[:space:]]+.*[[:space:]]+from[[:space:]]+)['\"]([^'\"]+)['\"]"), 1);
    let re_ts2: u64 = sa_regex_compile(STR_PTR("(import[[:space:]]*\\([[:space:]]*|require[[:space:]]*\\([[:space:]]*)['\"]([^'\"]+)['\"]"), STR_LEN("(import[[:space:]]*\\([[:space:]]*|require[[:space:]]*\\([[:space:]]*)['\"]([^'\"]+)['\"]"), 1);
    let re_py1: u64 = sa_regex_compile(STR_PTR("^from[[:space:]]+([a-zA-Z0-9_.]+)[[:space:]]+import[[:space:]]+"), STR_LEN("^from[[:space:]]+([a-zA-Z0-9_.]+)[[:space:]]+import[[:space:]]+"), 1);
    let re_py2: u64 = sa_regex_compile(STR_PTR("^import[[:space:]]+(.+)$"), STR_LEN("^import[[:space:]]+(.+)$"), 1);
    let re_go_block: u64 = sa_regex_compile(STR_PTR("^import[[:space:]]*\\("), STR_LEN("^import[[:space:]]*\\("), 1);
    let re_go_line: u64 = sa_regex_compile(STR_PTR("^\"?([a-zA-Z0-9_./~+-]+)\"?$"), STR_LEN("^\"?([a-zA-Z0-9_./~+-]+)\"?$"), 1);
    let re_go_single: u64 = sa_regex_compile(STR_PTR("^import[[:space:]]+([a-zA-Z0-9_]*[[:space:]]+)?\"([^\"]+)\""), STR_LEN("^import[[:space:]]+([a-zA-Z0-9_]*[[:space:]]+)?\"([^\"]+)\""), 1);
    let re_rs1: u64 = sa_regex_compile(STR_PTR("^use[[:space:]]+([^;]+);"), STR_LEN("^use[[:space:]]+([^;]+);"), 1);
    let re_rs2: u64 = sa_regex_compile(STR_PTR("^mod[[:space:]]+([a-zA-Z0-9_]+)[[:space:]]*;"), STR_LEN("^mod[[:space:]]+([a-zA-Z0-9_]+)[[:space:]]*;"), 1);
    let re_zig1: u64 = sa_regex_compile(STR_PTR("@import[[:space:]]*\\([[:space:]]*\"([^\"]+)\"[[:space:]]*\\)"), STR_LEN("@import[[:space:]]*\\([[:space:]]*\"([^\"]+)\"[[:space:]]*\\)"), 1);
    let in_go_block: bool = false;
    let total_lines: u64 = 0;
    let mx: u64 = 0;
    text_line_stats(sb_ptr(content), content.len, &total_lines, &mx);
    let limit: u64 = total_lines;
    if limit > 400 { limit = 400; };
    let raw = StrBuf { bytes: [0u8; 65536], len: 0 };
    let idx: u64 = 1;
    while idx <= limit {
        let ls: u64 = 0;
        let ll: u64 = 0;
        if text_line_span(sb_ptr(content), content.len, idx, &ls, &ll) {
            raw.len = 0;
            let lp: ptr = PTR_NULL();
            PTR_BYTE_ADD(lp, sb_ptr(content), ls);
            sb_append(&raw, lp, ll);
            let line = StrBuf { bytes: [0u8; 65536], len: 0 };
            tool_sb_trim(&raw, &line);
            if line.len > 0 {
                let grp = StrBuf { bytes: [0u8; 65536], len: 0 };
                if is_tsjs {
                    if !sb_starts(&line, STR_PTR("//"), STR_LEN("//")) && !sb_starts(&line, STR_PTR("*"), STR_LEN("*")) {
                        if re_first_group(re_ts1, sb_ptr(&line), line.len, 3, &grp) {
                            collectImports_push(out, &grp);
                        } else if re_first_group(re_ts2, sb_ptr(&line), line.len, 2, &grp) {
                            collectImports_push(out, &grp);
                        };
                    };
                } else if is_py {
                    if !sb_starts(&line, STR_PTR("#"), STR_LEN("#")) {
                        if re_first_group(re_py1, sb_ptr(&line), line.len, 1, &grp) {
                            collectImports_push(out, &grp);
                        } else if re_first_group(re_py2, sb_ptr(&line), line.len, 1, &grp) {
                            // split on commas, strip " as alias"
                            let part = StrBuf { bytes: [0u8; 65536], len: 0 };
                            let start: u64 = 0;
                            let pos: u64 = 0;
                            while pos <= grp.len {
                                if pos == grp.len || grp.bytes[pos] == 44 {
                                    part.len = 0;
                                    if pos > start {
                                        let pp: ptr = PTR_NULL();
                                        PTR_BYTE_ADD(pp, sb_ptr(&grp), start);
                                        sb_append(&part, pp, pos - start);
                                    };
                                    let aspos: i64 = sb_index_of(&part, STR_PTR(" as "), STR_LEN(" as "));
                                    let head_part = StrBuf { bytes: [0u8; 65536], len: 0 };
                                    if aspos >= 0 {
                                        sb_append(&head_part, sb_ptr(&part), aspos as u64);
                                    } else {
                                        sb_copy(&head_part, &part);
                                    };
                                    let ht = StrBuf { bytes: [0u8; 65536], len: 0 };
                                    tool_sb_trim(&head_part, &ht);
                                    if ht.len > 0 { collectImports_push(out, &ht); };
                                    start = pos + 1;
                                };
                                pos = pos + 1;
                            }
                        };
                    };
                } else if is_go {
                    if re_handle_test(re_go_block, sb_ptr(&line), line.len) {
                        in_go_block = true;
                    } else if in_go_block && tool_bytes_eq(sb_ptr(&line), line.len, STR_PTR(")"), 1) {
                        in_go_block = false;
                    } else if in_go_block && re_first_group(re_go_line, sb_ptr(&line), line.len, 1, &grp) {
                        collectImports_push(out, &grp);
                    } else if re_first_group(re_go_single, sb_ptr(&line), line.len, 2, &grp) {
                        collectImports_push(out, &grp);
                    };
                } else if is_rs {
                    if re_first_group(re_rs1, sb_ptr(&line), line.len, 1, &grp) {
                        let cut: i64 = sb_index_of(&grp, STR_PTR("::{"), STR_LEN("::{"));
                        let head_part = StrBuf { bytes: [0u8; 65536], len: 0 };
                        if cut >= 0 {
                            sb_append(&head_part, sb_ptr(&grp), cut as u64);
                        } else {
                            sb_copy(&head_part, &grp);
                        };
                        let aspos: i64 = sb_index_of(&head_part, STR_PTR(" as "), STR_LEN(" as "));
                        let head2 = StrBuf { bytes: [0u8; 65536], len: 0 };
                        if aspos >= 0 {
                            sb_append(&head2, sb_ptr(&head_part), aspos as u64);
                        } else {
                            sb_copy(&head2, &head_part);
                        };
                        collectImports_push(out, &head2);
                    } else if re_first_group(re_rs2, sb_ptr(&line), line.len, 1, &grp) {
                        collectImports_push(out, &grp);
                    };
                } else if is_zig {
                    if re_first_group(re_zig1, sb_ptr(&line), line.len, 1, &grp) {
                        collectImports_push(out, &grp);
                    };
                };
            };
        };
        if lb_count(out) >= 20 { break; };
        idx = idx + 1;
    }
    let handles = U64List { items: [0u64; 4096], len: 0 };
    handles.items[0] = re_ts1;
    handles.items[1] = re_ts2;
    handles.items[2] = re_py1;
    handles.items[3] = re_py2;
    handles.items[4] = re_go_block;
    handles.items[5] = re_go_line;
    handles.items[6] = re_go_single;
    handles.items[7] = re_rs1;
    handles.items[8] = re_rs2;
    handles.items[9] = re_zig1;
    handles.len = 10;
    let hi: u64 = 0;
    while hi < handles.len {
        if handles.items[hi] != 0 { let rcf: i32 = sa_regex_free(handles.items[hi]); };
        hi = hi + 1;
    }
}

// ---- repo map / verify / regression adapters ----
fn json_pretty_doc(doc: u64, out: &JsonBuf) -> void {
    let p: ptr = PTR_NULL();
    let n: u64 = 0;
    sa_json_node_json_text(doc, &p, &n);
    json_pretty_into(p, n, out);
}

fn json_pretty_into(p: ptr, n: u64, out: &JsonBuf) -> void {
    // JSON.stringify(v, null, 2) formatting over compact JSON text.
    out.len = 0;
    let indent: u64 = 0;
    let in_str: bool = false;
    let esc: bool = false;
    let i: u64 = 0;
    let prev_sig: u8 = 0;
    while i < n {
        let c: u8 = 0;
        PTR_BYTE_AT(c, p, i);
        if in_str {
            jb_push_byte(out, c);
            if esc { esc = false; } else if c == 92 { esc = true; } else if c == 34 { in_str = false; prev_sig = 34; };
            i = i + 1;
            continue;
        };
        if c == 32 || c == 9 || c == 10 || c == 13 {
            i = i + 1;
            continue;
        };
        if c == 34 {
            in_str = true;
            jb_push_byte(out, c);
            i = i + 1;
            continue;
        };
        if c == 123 || c == 91 {
            // empty pair {} or [] stays inline
            let j: u64 = i + 1;
            let nc: u8 = 0;
            while j < n {
                PTR_BYTE_AT(nc, p, j);
                if nc != 32 && nc != 9 && nc != 10 && nc != 13 { break; };
                j = j + 1;
            }
            let closer: u8 = 125;
            if c == 91 { closer = 93; };
            if j < n && nc == closer {
                jb_push_byte(out, c);
                jb_push_byte(out, closer);
                i = j + 1;
                prev_sig = closer;
                continue;
            };
            jb_push_byte(out, c);
            indent = indent + 1;
            jb_push_byte(out, 10);
            let k: u64 = 0;
            while k < indent * 2 { jb_push_byte(out, 32); k = k + 1; }
            prev_sig = c;
            i = i + 1;
            continue;
        };
        if c == 125 || c == 93 {
            indent = indent - 1;
            jb_push_byte(out, 10);
            let k: u64 = 0;
            while k < indent * 2 { jb_push_byte(out, 32); k = k + 1; }
            jb_push_byte(out, c);
            prev_sig = c;
            i = i + 1;
            continue;
        };
        if c == 44 {
            jb_push_byte(out, c);
            jb_push_byte(out, 10);
            let k: u64 = 0;
            while k < indent * 2 { jb_push_byte(out, 32); k = k + 1; }
            prev_sig = c;
            i = i + 1;
            continue;
        };
        if c == 58 {
            jb_push_byte(out, c);
            jb_push_byte(out, 32);
            prev_sig = c;
            i = i + 1;
            continue;
        };
        jb_push_byte(out, c);
        prev_sig = c;
        i = i + 1;
    }
}

struct RepoSymbolRow {
    name: [u8; 512], name_len: u64,
    kind: [u8; 64], kind_len: u64,
    line: u64,
}

// RepoMapCacheEntry: the TS Map<string, RepoMapCacheEntry> memo is kept
// as a JSON array in a global bytes cell (path -> entry), capacity 128.
struct RepoMapEntry {
    file: [u8; 1024], file_len: u64,
    module: [u8; 1024], module_len: u64, has_module: bool,
    language: [u8; 64], language_len: u64, has_language: bool,
    sym_first: u64, sym_len: u64,
    dep_first: u64, dep_len: u64,
}

fn repomap_cache_load(out: &JsonBuf) -> u64 {
    out.len = 0;
    let got_len: u64 = 0;
    let st: i32 = sa_global_bytes_get(STR_PTR("savmtool.repomap.cache.v1"), STR_LEN("savmtool.repomap.cache.v1"), jb_ptr(out), 262144, &got_len);
    if st != 0 { return 0; };
    out.len = got_len;
    if out.len == 0 { return 0; };
    return jdoc_of_jb(out);
}

fn repomap_cache_store(doc: u64) -> void {
    let jb = JsonBuf { bytes: [0u8; 262144], len: 0 };
    jdoc_to_jb(doc, &jb);
    let st: i32 = sa_global_bytes_set(STR_PTR("savmtool.repomap.cache.v1"), STR_LEN("savmtool.repomap.cache.v1"), jb_ptr(&jb), jb.len);
}

fn repomap_cache_find(doc: u64, path: &StrBuf, mtime: f64, size: f64, entry: &RepoMapEntry, syms: &ListBuf, kinds: &ListBuf, lines: &U64List, deps: &ListBuf) -> bool {
    if doc == 0 || sa_json_kind(doc) != 6 { return false; };
    let cnt: u64 = jcount(doc);
    let i: u64 = 0;
    let probe = StrBuf { bytes: [0u8; 65536], len: 0 };
    while i < cnt {
        let en: u64 = jarr_at(doc, i);
        if en != 0 && sa_json_kind(en) == 7 {
            if jget_str(en, STR_PTR("p"), STR_LEN("p"), &probe) && tool_bytes_eq(sb_ptr(&probe), probe.len, sb_ptr(path), path.len) {
                let mv: f64 = 0.0;
                let mh: bool = false;
                read_opt_num(en, STR_PTR("m"), STR_LEN("m"), STR_PTR(""), 0, &mv, &mh);
                let sv: f64 = 0.0;
                let sh: bool = false;
                read_opt_num(en, STR_PTR("s"), STR_LEN("s"), STR_PTR(""), 0, &sv, &sh);
                if mh && sh && mv == mtime && sv == size {
                    // materialize the entry into the shared symbol tables
                    entry.file_len = 0;
                    entry.has_module = false;
                    entry.module_len = 0;
                    entry.has_language = false;
                    entry.language_len = 0;
                    let mn: u64 = node_nonnull(en, STR_PTR("mod"), STR_LEN("mod"));
                    if mn != 0 && sa_json_kind(mn) == 5 {
                        entry.module_len = 0;
                        let mp: ptr = jstr_ptr(mn);
                        let ml: u64 = sa_json_string_len(mn);
                        let ci: u64 = 0;
                        while ci < ml && entry.module_len < 1024 {
                            let cc: u8 = 0;
                            PTR_BYTE_AT(cc, mp, ci);
                            entry.module[entry.module_len] = cc;
                            entry.module_len = entry.module_len + 1;
                            ci = ci + 1;
                        }
                        entry.has_module = true;
                    };
                    let ln: u64 = node_nonnull(en, STR_PTR("lang"), STR_LEN("lang"));
                    if ln != 0 && sa_json_kind(ln) == 5 {
                        let lp: ptr = jstr_ptr(ln);
                        let ll: u64 = sa_json_string_len(ln);
                        let ci: u64 = 0;
                        while ci < ll && entry.language_len < 64 {
                            let cc: u8 = 0;
                            PTR_BYTE_AT(cc, lp, ci);
                            entry.language[entry.language_len] = cc;
                            entry.language_len = entry.language_len + 1;
                            ci = ci + 1;
                        }
                        entry.has_language = true;
                    };
                    entry.sym_first = lb_count(syms);
                    let sn: u64 = node_nonnull(en, STR_PTR("sym"), STR_LEN("sym"));
                    if sn != 0 && sa_json_kind(sn) == 6 {
                        let sc: u64 = jcount(sn);
                        let si: u64 = 0;
                        let nm = StrBuf { bytes: [0u8; 65536], len: 0 };
                        let kd = StrBuf { bytes: [0u8; 65536], len: 0 };
                        while si < sc {
                            let row: u64 = jarr_at(sn, si);
                            if row != 0 && sa_json_kind(row) == 6 && jcount(row) >= 3 {
                                let n0: u64 = jarr_at(row, 0);
                                nm.len = 0;
                                if n0 != 0 && sa_json_kind(n0) == 5 { sb_append(&nm, jstr_ptr(n0), sa_json_string_len(n0)); };
                                let n1: u64 = jarr_at(row, 1);
                                kd.len = 0;
                                if n1 != 0 && sa_json_kind(n1) == 5 { sb_append(&kd, jstr_ptr(n1), sa_json_string_len(n1)); };
                                let n2: u64 = jarr_at(row, 2);
                                let lv: f64 = 0.0;
                                if n2 != 0 { lv = sa_json_node_as_f64(n2); };
                                lb_append(syms, sb_ptr(&nm), nm.len);
                                lb_append(kinds, sb_ptr(&kd), kd.len);
                                if lines.len < 4096 { lines.items[lines.len] = lv as u64; lines.len = lines.len + 1; };
                            };
                            si = si + 1;
                        }
                    };
                    entry.sym_len = lb_count(syms) - entry.sym_first;
                    entry.dep_first = lb_count(deps);
                    let dn: u64 = node_nonnull(en, STR_PTR("dep"), STR_LEN("dep"));
                    if dn != 0 && sa_json_kind(dn) == 6 {
                        let dc: u64 = jcount(dn);
                        let di: u64 = 0;
                        let dv = StrBuf { bytes: [0u8; 65536], len: 0 };
                        while di < dc {
                            let d0: u64 = jarr_at(dn, di);
                            dv.len = 0;
                            if d0 != 0 && sa_json_kind(d0) == 5 { sb_append(&dv, jstr_ptr(d0), sa_json_string_len(d0)); };
                            lb_append(deps, sb_ptr(&dv), dv.len);
                            di = di + 1;
                        }
                    };
                    entry.dep_len = lb_count(deps) - entry.dep_first;
                    return true;
                };
            };
        };
        i = i + 1;
    }
    return false;
}

fn repomap_cache_put(path: &StrBuf, mtime: f64, size: f64, syms: &ListBuf, kinds: &ListBuf, lines: &U64List, sym_first: u64, sym_len: u64, deps: &ListBuf, dep_first: u64, dep_len: u64, lang: &StrBuf, has_lang: bool, module: &StrBuf, has_module: bool) -> void {
    let cjb = JsonBuf { bytes: [0u8; 262144], len: 0 };
    let doc: u64 = repomap_cache_load(&cjb);
    if doc == 0 {
        doc = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
        if doc == 0 { return; };
    };
    // replace same-path entry: rebuild without it
    let nd: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    if nd == 0 { sa_json_free(doc); return; };
    let cnt: u64 = jcount(doc);
    let i: u64 = 0;
    let probe = StrBuf { bytes: [0u8; 65536], len: 0 };
    while i < cnt {
        let en: u64 = jarr_at(doc, i);
        let keep: bool = true;
        if en != 0 && sa_json_kind(en) == 7 && jget_str(en, STR_PTR("p"), STR_LEN("p"), &probe) && tool_bytes_eq(sb_ptr(&probe), probe.len, sb_ptr(path), path.len) {
            keep = false;
        };
        if keep && en != 0 {
            let rp2: i32 = sa_json_array_push_node(nd, en);
        };
        i = i + 1;
    }
    sa_json_free(doc);
    // cap: keep the newest 127 entries (single rebuild pass; swap first, free old after)
    let nd_cnt: u64 = jcount(nd);
    let old_nd: u64 = 0;
    if nd_cnt >= 128 {
        let nd2: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
        if nd2 != 0 {
            let drop: u64 = nd_cnt - 127;
            let j: u64 = drop;
            while j < nd_cnt {
                let en: u64 = jarr_at(nd, j);
                if en != 0 { let rp: i32 = sa_json_array_push_node(nd2, en); };
                j = j + 1;
            }
            old_nd = nd;
            nd = nd2;
        };
    };
    if old_nd != 0 { let frc8: i32 = sa_json_free(old_nd); };
    let eo: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    if eo == 0 { sa_json_free(nd); return; };
    jset_str(eo, STR_PTR("p"), STR_LEN("p"), sb_ptr(path), path.len);
    jset_f64(eo, STR_PTR("m"), STR_LEN("m"), mtime);
    jset_f64(eo, STR_PTR("s"), STR_LEN("s"), size);
    let sym_arr: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    if sym_arr != 0 {
        let nm = StrBuf { bytes: [0u8; 65536], len: 0 };
        let kd = StrBuf { bytes: [0u8; 65536], len: 0 };
        let si: u64 = 0;
        while si < sym_len {
            let row: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
            if row != 0 {
                let g1: bool = lb_at(syms, sym_first + si, &nm);
                let g2: bool = lb_at(kinds, sym_first + si, &kd);
                let r1: i32 = sa_json_array_push_string(row, sb_ptr(&nm), nm.len);
                let r2: i32 = sa_json_array_push_string(row, sb_ptr(&kd), kd.len);
                let r3: i32 = sa_json_array_push_f64(row, lines.items[sym_first + si] as f64);
                let r4: i32 = sa_json_array_push_node(sym_arr, row);
            };
            si = si + 1;
        }
        jset_node(eo, STR_PTR("sym"), STR_LEN("sym"), sym_arr);
    };
    let dep_arr: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    if dep_arr != 0 {
        let dv = StrBuf { bytes: [0u8; 65536], len: 0 };
        let di: u64 = 0;
        while di < dep_len {
            let g1: bool = lb_at(deps, dep_first + di, &dv);
            let r1: i32 = sa_json_array_push_string(dep_arr, sb_ptr(&dv), dv.len);
            di = di + 1;
        }
        jset_node(eo, STR_PTR("dep"), STR_LEN("dep"), dep_arr);
    };
    if has_lang {
        jset_str(eo, STR_PTR("lang"), STR_LEN("lang"), sb_ptr(lang), lang.len);
    } else {
        jset_null(eo, STR_PTR("lang"), STR_LEN("lang"));
    };
    if has_module {
        jset_str(eo, STR_PTR("mod"), STR_LEN("mod"), sb_ptr(module), module.len);
    } else {
        jset_null(eo, STR_PTR("mod"), STR_LEN("mod"));
    };
    let rp3: i32 = sa_json_array_push_node(nd, eo);
    repomap_cache_store(nd);
    sa_json_free(nd);
}

fn repomap_entry_json(file: &StrBuf, module: &StrBuf, has_module: bool, lang: &StrBuf, has_lang: bool, syms: &ListBuf, kinds: &ListBuf, lines: &U64List, sym_first: u64, sym_len: u64, deps: &ListBuf, dep_first: u64, dep_len: u64, out: &JsonBuf) -> void {
    jb_append(out, STR_PTR("{\"file\":\""), STR_LEN("{\"file\":\""));
    jescape_into(file, out);
    jb_append(out, STR_PTR("\",\"module\":"), STR_LEN("\",\"module\":"));
    if has_module {
        jb_append(out, STR_PTR("\""), STR_LEN("\""));
        jescape_into(module, out);
        jb_append(out, STR_PTR("\""), STR_LEN("\""));
    } else {
        jb_append(out, STR_PTR("null"), STR_LEN("null"));
    };
    jb_append(out, STR_PTR(",\"language\":"), STR_LEN(",\"language\":"));
    if has_lang {
        jb_append(out, STR_PTR("\""), STR_LEN("\""));
        jescape_into(lang, out);
        jb_append(out, STR_PTR("\""), STR_LEN("\""));
    } else {
        jb_append(out, STR_PTR("null"), STR_LEN("null"));
    };
    jb_append(out, STR_PTR(",\"symbols\":["), STR_LEN(",\"symbols\":["));
    let nm = StrBuf { bytes: [0u8; 65536], len: 0 };
    let kd = StrBuf { bytes: [0u8; 65536], len: 0 };
    let t = StrBuf { bytes: [0u8; 65536], len: 0 };
    let si: u64 = 0;
    while si < sym_len {
        let g1: bool = lb_at(syms, sym_first + si, &nm);
        let g2: bool = lb_at(kinds, sym_first + si, &kd);
        if si > 0 { jb_append(out, STR_PTR(","), STR_LEN(",")); };
        jb_append(out, STR_PTR("{\"name\":\""), STR_LEN("{\"name\":\""));
        jescape_into(&nm, out);
        jb_append(out, STR_PTR("\",\"kind\":\""), STR_LEN("\",\"kind\":\""));
        jescape_into(&kd, out);
        jb_append(out, STR_PTR("\",\"line\":"), STR_LEN("\",\"line\":"));
        fmt_u64_sb(lines.items[sym_first + si], &t);
        jb_append(out, sb_ptr(&t), t.len);
        jb_append(out, STR_PTR("}"), STR_LEN("}"));
        si = si + 1;
    }
    jb_append(out, STR_PTR("],\"depends_on\":["), STR_LEN("],\"depends_on\":["));
    let dv = StrBuf { bytes: [0u8; 65536], len: 0 };
    let di: u64 = 0;
    while di < dep_len {
        let g1: bool = lb_at(deps, dep_first + di, &dv);
        if di > 0 { jb_append(out, STR_PTR(","), STR_LEN(",")); };
        jb_append(out, STR_PTR("\""), STR_LEN("\""));
        jescape_into(&dv, out);
        jb_append(out, STR_PTR("\""), STR_LEN("\""));
        di = di + 1;
    }
    jb_append(out, STR_PTR("]}"), STR_LEN("]}"));
}

fn nativeRepoMap(raw_dir: &StrBuf, options: &JsonBuf, policy_doc: u64, cwd: &StrBuf, started_at: f64, out: &SaVmRunResult) -> i32 {
    let dir = StrBuf { bytes: [0u8; 65536], len: 0 };
    tool_sb_trim(raw_dir, &dir);
    if dir.len == 0 { sb_assign(&dir, STR_PTR("."), 1); };
    let norm = NormalizedSaVmPolicy { engine: 0, fs: NormalizedFs { entries: FsEntryList { items: [SaVmFsEntry { path: [0u8; 1024], path_len: 0, access: 0 }; 128], len: 0 }, read: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, write: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, transfer: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, delete: 0, backupDir: [0u8; 1024], backupDir_len: 0, backupDir_has: false }, http_allow: HttpRuleList { items: [SaVmHttpAllowRule { host: [0u8; 512], host_len: 0, methods: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_methods: false, paths: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_paths: false }; 128], len: 0 }, env_allow: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, process: NormalizedProcess { spawn: false, exec: ExecRuleList { items: [SaVmProcessExecRule { path: [0u8; 4096], path_len: 0, args: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_args: false }; 128], len: 0 }, bunProfiles: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_bunProfiles: false, bun_enabled: false, bun_allowedSubcommands: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_bun: false }, execution_javascript: false, execution_python: false, tools: NormalizedTools { replaceRead: false, replaceWrite: false, replaceApplyPatch: false, replaceExec: false, readFiles: false, editFiles: false, applyPatch: false, fastSearch: false, clearToolHistory: false, findReferences: false, renameSymbol: false, fileOutline: false, moveWithImports: false, findDefinition: false, extractToFile: false, addImport: false, getDiagnostics: false, organizeImports: false, analyzeScope: false, codeGraph: false }, contextSavings: SaVmContextSavingsConfig { locateBeforeRead: false, maxReadFileBytes: 0, maxReadFileBytes_has: false, grepCircuitBreaker: false, grepMaxResults: 0, grepMaxResults_has: false, grepMaxTokens: 0, grepMaxTokens_has: false, slimRunnerOutput: false, parallelBudget: false, parallelMaxTotalBytes: 0, parallelMaxTotalBytes_has: false, parallelMaxReadFiles: 0, parallelMaxReadFiles_has: false, parallelDeduplication: false, tieredSkillInjection: false, foldWaterfallEvents: false, foldHistoryReadSummaries: false, historyReadFoldTurns: 0, historyReadFoldTurns_has: false }, contextSavings_has: false };
    normalize_policy(policy_doc, cwd, &norm);
    if !norm.tools.fileOutline {
        let em = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_assign(&em, STR_PTR("action 'repo_map' is disabled in current VM policy; enable fileOutline in VM settings to use repo mapping"), STR_LEN("action 'repo_map' is disabled in current VM policy; enable fileOutline in VM settings to use repo mapping"));
        let rsn = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_assign(&rsn, STR_PTR("fileOutline disabled"), STR_LEN("fileOutline disabled"));
        res_capability2(out, &em, &rsn, started_at);
        return 0;
    };
    let rsn = StrBuf { bytes: [0u8; 65536], len: 0 };
    if !toolCheckPath(&norm, 0, &dir, cwd, &rsn) {
        let em = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_assign(&em, STR_PTR("Policy violation: "), STR_LEN("Policy violation: "));
        if rsn.len > 0 { sb_append(&em, sb_ptr(&rsn), rsn.len); } else { sb_append(&em, STR_PTR("read not allowed"), STR_LEN("read not allowed")); };
        res_capability2(out, &em, &rsn, started_at);
        return 0;
    };
    let resolved = StrBuf { bytes: [0u8; 65536], len: 0 };
    path_resolve(cwd, &dir, &resolved);
    let odoc: u64 = jdoc_of_jb(options);
    let timeout_ms: f64 = resolveTimeoutMs(options, 30000.0);
    let max_files: f64 = clampIntKey(odoc, STR_PTR("max_files"), STR_LEN("max_files"), 200.0, 1.0, 500.0);
    let mfv: f64 = 0.0;
    let mf_has: bool = false;
    if odoc != 0 { read_opt_num(odoc, STR_PTR("max_files"), STR_LEN("max_files"), STR_PTR(""), 0, &mfv, &mf_has); };
    let popts = PaginationOpts { default_size: max_files, max_size: 500.0, legacy_limit: mfv, has_legacy_limit: mf_has };
    let pg = ResolvedPagination { page: 0.0, page_size: 0.0, offset: 0.0, paginated: false, exact_total: false, count_cap: 0.0 };
    resolvePagination(odoc, &popts, &pg);
    let cap: u64 = max_files as u64;
    if pg.paginated { cap = pg.count_cap as u64; };
    let max_syms: u64 = clampIntKey(odoc, STR_PTR("max_symbols_per_file"), STR_LEN("max_symbols_per_file"), 30.0, 1.0, 200.0) as u64;
    let max_tokens: f64 = 8000.0;
    let mt: f64 = 0.0;
    let mt_has: bool = false;
    if odoc != 0 { read_opt_num(odoc, STR_PTR("max_tokens"), STR_LEN("max_tokens"), STR_PTR(""), 0, &mt, &mt_has); };
    if mt_has && mt > 0.0 {
        max_tokens = mt;
        let mti: i64 = max_tokens as i64;
        max_tokens = mti as f64;
        if max_tokens > 32000.0 { max_tokens = 32000.0; };
    };
    let mfb_node: u64 = 0;
    if odoc != 0 { mfb_node = node_nonnull(odoc, STR_PTR("max_file_bytes"), STR_LEN("max_file_bytes")); };
    let max_bytes: f64 = resolveMaxFileBytes(mfb_node, 1048576.0);
    let include_used_by: bool = false;
    if odoc != 0 {
        let ub: u64 = node_nonnull(odoc, STR_PTR("include_used_by"), STR_LEN("include_used_by"));
        if ub != 0 && sa_json_kind(ub) == 1 && sa_json_node_as_bool(ub) { include_used_by = true; };
    };
    let started_files = ListBuf { bytes: [0u8; 131072], len: 0 };
    collectWorkspaceSourceFiles(&resolved, cap as f64, timeout_ms, started_at, &started_files);
    // shared entry tables
    let e_files = ListBuf { bytes: [0u8; 131072], len: 0 };
    let e_modules = ListBuf { bytes: [0u8; 131072], len: 0 };
    let e_has_module = U64List { items: [0u64; 4096], len: 0 };
    let e_langs = ListBuf { bytes: [0u8; 131072], len: 0 };
    let e_has_lang = U64List { items: [0u64; 4096], len: 0 };
    let e_sym_first = U64List { items: [0u64; 4096], len: 0 };
    let e_sym_len = U64List { items: [0u64; 4096], len: 0 };
    let e_dep_first = U64List { items: [0u64; 4096], len: 0 };
    let e_dep_len = U64List { items: [0u64; 4096], len: 0 };
    let sym_names = ListBuf { bytes: [0u8; 131072], len: 0 };
    let sym_kinds = ListBuf { bytes: [0u8; 131072], len: 0 };
    let sym_lines = U64List { items: [0u64; 4096], len: 0 };
    let dep_names = ListBuf { bytes: [0u8; 131072], len: 0 };
    // contents store for used_by: raw bytes + per-file lens + rel names
    let c_rels = ListBuf { bytes: [0u8; 131072], len: 0 };
    let c_lens = U64List { items: [0u64; 4096], len: 0 };
