    return false;
}

fn arg_has_shell_meta(s: &StrBuf) -> bool {
    let i: u64 = 0;
    while i < s.len {
        let b: u8 = s.bytes[i];
        if b == 59 || b == 38 || b == 124 || b == 96 || b == 36 || b == 40 || b == 41 || b == 60 || b == 62 { return true; };
        i = i + 1;
    }
    return false;
}

fn bytelist_to_strlist(l: &ByteList, out: &StrList) -> void {
    out.len = 0;
    let c: u64 = bl_count(l);
    let i: u64 = 0;
    let item = StrBuf { bytes: [0u8; 65536], len: 0 };
    while i < c && out.len < 128 {
        if bl_at(l, i, &item) {
            let n: u64 = item.len;
            if n > 1024 { n = 1024; };
            let k: u64 = 0;
            while k < n {
                out.items[out.len].bytes[k] = item.bytes[k];
                k = k + 1;
            }
            out.items[out.len].len = n;
            out.len = out.len + 1;
        };
        i = i + 1;
    }
}

fn bun_profile_known(p: &StrBuf) -> bool {
    if sb_eq(p, STR_PTR("shared-typecheck"), STR_LEN("shared-typecheck")) { return true; };
    if sb_eq(p, STR_PTR("protocol-typecheck"), STR_LEN("protocol-typecheck")) { return true; };
    if sb_eq(p, STR_PTR("server-typecheck"), STR_LEN("server-typecheck")) { return true; };
    if sb_eq(p, STR_PTR("web-typecheck"), STR_LEN("web-typecheck")) { return true; };
    if sb_eq(p, STR_PTR("free-key-typecheck"), STR_LEN("free-key-typecheck")) { return true; };
    if sb_eq(p, STR_PTR("root-typecheck"), STR_LEN("root-typecheck")) { return true; };
    if sb_eq(p, STR_PTR("shared-build"), STR_LEN("shared-build")) { return true; };
    if sb_eq(p, STR_PTR("web-build"), STR_LEN("web-build")) { return true; };
    if sb_eq(p, STR_PTR("server-test-file"), STR_LEN("server-test-file")) { return true; };
    if sb_eq(p, STR_PTR("web-test-file"), STR_LEN("web-test-file")) { return true; };
    if sb_eq(p, STR_PTR("shared-test-file"), STR_LEN("shared-test-file")) { return true; };
    return false;
}

fn bun_profile_is_test_file(p: &StrBuf) -> bool {
    if sb_eq(p, STR_PTR("server-test-file"), STR_LEN("server-test-file")) { return true; };
    if sb_eq(p, STR_PTR("web-test-file"), STR_LEN("web-test-file")) { return true; };
    if sb_eq(p, STR_PTR("shared-test-file"), STR_LEN("shared-test-file")) { return true; };
    return false;
}

fn bun_profile_args(p: &StrBuf, out: &ByteList) -> void {
    if sb_eq(p, STR_PTR("root-typecheck"), STR_LEN("root-typecheck")) {
        bl_push(out, STR_PTR("--filter"), STR_LEN("--filter"));
        bl_push(out, STR_PTR("@codex-ui/shared"), STR_LEN("@codex-ui/shared"));
        bl_push(out, STR_PTR("--filter"), STR_LEN("--filter"));
        bl_push(out, STR_PTR("@codex-ui/codex-protocol"), STR_LEN("@codex-ui/codex-protocol"));
        bl_push(out, STR_PTR("--filter"), STR_LEN("--filter"));
        bl_push(out, STR_PTR("@codex-ui/server"), STR_LEN("@codex-ui/server"));
        bl_push(out, STR_PTR("--filter"), STR_LEN("--filter"));
        bl_push(out, STR_PTR("@codex-ui/web"), STR_LEN("@codex-ui/web"));
        bl_push(out, STR_PTR("--filter"), STR_LEN("--filter"));
        bl_push(out, STR_PTR("@codex-ui/free-key-server"), STR_LEN("@codex-ui/free-key-server"));
        bl_push(out, STR_PTR("--parallel"), STR_LEN("--parallel"));
        bl_push(out, STR_PTR("typecheck"), STR_LEN("typecheck"));
        return;
    };
    let pkg = StrBuf { bytes: [0u8; 65536], len: 0 };
    let script = StrBuf { bytes: [0u8; 65536], len: 0 };
    if sb_eq(p, STR_PTR("shared-typecheck"), STR_LEN("shared-typecheck")) { sb_append(&pkg, STR_PTR("@codex-ui/shared"), STR_LEN("@codex-ui/shared")); sb_append(&script, STR_PTR("typecheck"), STR_LEN("typecheck")); };
    if sb_eq(p, STR_PTR("protocol-typecheck"), STR_LEN("protocol-typecheck")) { sb_append(&pkg, STR_PTR("@codex-ui/codex-protocol"), STR_LEN("@codex-ui/codex-protocol")); sb_append(&script, STR_PTR("typecheck"), STR_LEN("typecheck")); };
    if sb_eq(p, STR_PTR("server-typecheck"), STR_LEN("server-typecheck")) { sb_append(&pkg, STR_PTR("@codex-ui/server"), STR_LEN("@codex-ui/server")); sb_append(&script, STR_PTR("typecheck"), STR_LEN("typecheck")); };
    if sb_eq(p, STR_PTR("web-typecheck"), STR_LEN("web-typecheck")) { sb_append(&pkg, STR_PTR("@codex-ui/web"), STR_LEN("@codex-ui/web")); sb_append(&script, STR_PTR("typecheck"), STR_LEN("typecheck")); };
    if sb_eq(p, STR_PTR("free-key-typecheck"), STR_LEN("free-key-typecheck")) { sb_append(&pkg, STR_PTR("@codex-ui/free-key-server"), STR_LEN("@codex-ui/free-key-server")); sb_append(&script, STR_PTR("typecheck"), STR_LEN("typecheck")); };
    if sb_eq(p, STR_PTR("shared-build"), STR_LEN("shared-build")) { sb_append(&pkg, STR_PTR("@codex-ui/shared"), STR_LEN("@codex-ui/shared")); sb_append(&script, STR_PTR("build"), STR_LEN("build")); };
    if sb_eq(p, STR_PTR("web-build"), STR_LEN("web-build")) { sb_append(&pkg, STR_PTR("@codex-ui/web"), STR_LEN("@codex-ui/web")); sb_append(&script, STR_PTR("build"), STR_LEN("build")); };
    bl_push(out, STR_PTR("--filter"), STR_LEN("--filter"));
    bl_push(out, sb_ptr(&pkg), pkg.len);
    bl_push(out, sb_ptr(&script), script.len);
}

// ---- accountability ledger bridges ----

fn penalty_zero() -> PenaltyRecord {
    return PenaltyRecord { id_ptr: PTR_NULL(), id_len: 0, type_ptr: PTR_NULL(), type_len: 0, level: 0, targetFile_ptr: PTR_NULL(), targetFile_len: 0, errorSignature_ptr: PTR_NULL(), errorSignature_len: 0, scoreDelta: 0, details_ptr: PTR_NULL(), details_len: 0, has_details: false, timestamp: 0, status: 0, redeemedBy_ptr: PTR_NULL(), redeemedBy_len: 0, has_redeemedBy: false };
}

fn reward_zero() -> RewardRecord {
    return RewardRecord { id_ptr: PTR_NULL(), id_len: 0, type_ptr: PTR_NULL(), type_len: 0, linkedPenaltyId_ptr: PTR_NULL(), linkedPenaltyId_len: 0, scoreDelta: 0, verificationEvidence_ptr: PTR_NULL(), verificationEvidence_len: 0, lessonLearned_ptr: PTR_NULL(), lessonLearned_len: 0, antibodyRule_ptr: PTR_NULL(), antibodyRule_len: 0, timestamp: 0 };
}

fn reputation_zero() -> ReputationStatus {
    return ReputationStatus { score: 0, tier: 0, activePenalties: [PenaltyRecord { id_ptr: PTR_NULL(), id_len: 0, type_ptr: PTR_NULL(), type_len: 0, level: 0, targetFile_ptr: PTR_NULL(), targetFile_len: 0, errorSignature_ptr: PTR_NULL(), errorSignature_len: 0, scoreDelta: 0, details_ptr: PTR_NULL(), details_len: 0, has_details: false, timestamp: 0, status: 0, redeemedBy_ptr: PTR_NULL(), redeemedBy_len: 0, has_redeemedBy: false }; 128], activePenalties_len: 0, redeemedPenalties: [PenaltyRecord { id_ptr: PTR_NULL(), id_len: 0, type_ptr: PTR_NULL(), type_len: 0, level: 0, targetFile_ptr: PTR_NULL(), targetFile_len: 0, errorSignature_ptr: PTR_NULL(), errorSignature_len: 0, scoreDelta: 0, details_ptr: PTR_NULL(), details_len: 0, has_details: false, timestamp: 0, status: 0, redeemedBy_ptr: PTR_NULL(), redeemedBy_len: 0, has_redeemedBy: false }; 128], redeemedPenalties_len: 0, antibodies: [Antibody { targetFile_ptr: PTR_NULL(), targetFile_len: 0, rule_ptr: PTR_NULL(), rule_len: 0, lesson_ptr: PTR_NULL(), lesson_len: 0, penaltyId_ptr: PTR_NULL(), penaltyId_len: 0, rewardId_ptr: PTR_NULL(), rewardId_len: 0, timestamp: 0 }; 128], antibodies_len: 0, totalPenaltiesCount: 0, totalRewardsCount: 0, ledgerPath_ptr: PTR_NULL(), ledgerPath_len: 0 };
}

fn penalty_level_name(level: u64, out: &StrBuf) -> void {
    out.len = 0;
    if level == 0 { sb_append(out, STR_PTR("L1_SYNTAX"), STR_LEN("L1_SYNTAX")); return; };
    if level == 1 { sb_append(out, STR_PTR("L2_REGRESSION"), STR_LEN("L2_REGRESSION")); return; };
    if level == 2 { sb_append(out, STR_PTR("L3_THRASH"), STR_LEN("L3_THRASH")); return; };
    sb_append(out, STR_PTR("CUSTOM"), STR_LEN("CUSTOM"));
}

fn tier_name(tier: u64, out: &StrBuf) -> void {
    out.len = 0;
    if tier == 0 { sb_append(out, STR_PTR("GREEN"), STR_LEN("GREEN")); return; };
    if tier == 1 { sb_append(out, STR_PTR("YELLOW"), STR_LEN("YELLOW")); return; };
    sb_append(out, STR_PTR("RED"), STR_LEN("RED"));
}

fn penalty_into(doc: u64, pen: &PenaltyRecord) -> void {
    jset_str(doc, STR_PTR("id"), STR_LEN("id"), pen.id_ptr, pen.id_len);
    jset_str(doc, STR_PTR("type"), STR_LEN("type"), pen.type_ptr, pen.type_len);
    jset_str(doc, STR_PTR("targetFile"), STR_LEN("targetFile"), pen.targetFile_ptr, pen.targetFile_len);
    jset_str(doc, STR_PTR("errorSignature"), STR_LEN("errorSignature"), pen.errorSignature_ptr, pen.errorSignature_len);
    let lname = StrBuf { bytes: [0u8; 65536], len: 0 };
    penalty_level_name(pen.level, &lname);
    jset_str(doc, STR_PTR("level"), STR_LEN("level"), sb_ptr(&lname), lname.len);
    jset_i64(doc, STR_PTR("scoreDelta"), STR_LEN("scoreDelta"), pen.scoreDelta as i64);
    if pen.has_details { jset_str(doc, STR_PTR("details"), STR_LEN("details"), pen.details_ptr, pen.details_len); };
    jset_i64(doc, STR_PTR("timestamp"), STR_LEN("timestamp"), pen.timestamp as i64);
    if pen.status == 0 { jset_str(doc, STR_PTR("status"), STR_LEN("status"), STR_PTR("active"), STR_LEN("active")); } else { jset_str(doc, STR_PTR("status"), STR_LEN("status"), STR_PTR("redeemed"), STR_LEN("redeemed")); };
    if pen.has_redeemedBy { jset_str(doc, STR_PTR("redeemedBy"), STR_LEN("redeemedBy"), pen.redeemedBy_ptr, pen.redeemedBy_len); };
}

fn reward_into(doc: u64, rew: &RewardRecord) -> void {
    jset_str(doc, STR_PTR("id"), STR_LEN("id"), rew.id_ptr, rew.id_len);
    jset_str(doc, STR_PTR("type"), STR_LEN("type"), rew.type_ptr, rew.type_len);
    jset_str(doc, STR_PTR("linkedPenaltyId"), STR_LEN("linkedPenaltyId"), rew.linkedPenaltyId_ptr, rew.linkedPenaltyId_len);
    jset_i64(doc, STR_PTR("scoreDelta"), STR_LEN("scoreDelta"), rew.scoreDelta as i64);
    jset_str(doc, STR_PTR("verificationEvidence"), STR_LEN("verificationEvidence"), rew.verificationEvidence_ptr, rew.verificationEvidence_len);
    jset_str(doc, STR_PTR("lessonLearned"), STR_LEN("lessonLearned"), rew.lessonLearned_ptr, rew.lessonLearned_len);
    jset_str(doc, STR_PTR("antibodyRule"), STR_LEN("antibodyRule"), rew.antibodyRule_ptr, rew.antibodyRule_len);
    jset_i64(doc, STR_PTR("timestamp"), STR_LEN("timestamp"), rew.timestamp as i64);
}

fn antibody_into(doc: u64, ab: &Antibody) -> void {
    jset_str(doc, STR_PTR("targetFile"), STR_LEN("targetFile"), ab.targetFile_ptr, ab.targetFile_len);
    jset_str(doc, STR_PTR("rule"), STR_LEN("rule"), ab.rule_ptr, ab.rule_len);
    jset_str(doc, STR_PTR("lesson"), STR_LEN("lesson"), ab.lesson_ptr, ab.lesson_len);
    jset_str(doc, STR_PTR("penaltyId"), STR_LEN("penaltyId"), ab.penaltyId_ptr, ab.penaltyId_len);
    jset_str(doc, STR_PTR("rewardId"), STR_LEN("rewardId"), ab.rewardId_ptr, ab.rewardId_len);
    jset_i64(doc, STR_PTR("timestamp"), STR_LEN("timestamp"), ab.timestamp as i64);
}

fn ledger_status_into(doc: u64, status: &ReputationStatus) -> void {
    jset_i64(doc, STR_PTR("score"), STR_LEN("score"), status.score as i64);
    let tn = StrBuf { bytes: [0u8; 65536], len: 0 };
    tier_name(status.tier, &tn);
    jset_str(doc, STR_PTR("tier"), STR_LEN("tier"), sb_ptr(&tn), tn.len);
    let aarr: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    let i: u64 = 0;
    while i < status.activePenalties_len && i < 128 {
        let pd: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
        let pen = status.activePenalties[i];
        penalty_into(pd, &pen);
        let pst: i32 = sa_json_array_push_node(aarr, pd);
        i = i + 1;
    }
    jset_node(doc, STR_PTR("activePenalties"), STR_LEN("activePenalties"), aarr);
    let rarr: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    let j: u64 = 0;
    while j < status.redeemedPenalties_len && j < 128 {
        let pd2: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
        let pen2 = status.redeemedPenalties[j];
        penalty_into(pd2, &pen2);
        let pst2: i32 = sa_json_array_push_node(rarr, pd2);
        j = j + 1;
    }
    jset_node(doc, STR_PTR("redeemedPenalties"), STR_LEN("redeemedPenalties"), rarr);
    let barr: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    let k: u64 = 0;
    while k < status.antibodies_len && k < 128 {
        let ad: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
        let ab = status.antibodies[k];
        antibody_into(ad, &ab);
        let ast: i32 = sa_json_array_push_node(barr, ad);
        k = k + 1;
    }
    jset_node(doc, STR_PTR("antibodies"), STR_LEN("antibodies"), barr);
    jset_i64(doc, STR_PTR("totalPenaltiesCount"), STR_LEN("totalPenaltiesCount"), status.totalPenaltiesCount as i64);
    jset_i64(doc, STR_PTR("totalRewardsCount"), STR_LEN("totalRewardsCount"), status.totalRewardsCount as i64);
    jset_str(doc, STR_PTR("ledgerPath"), STR_LEN("ledgerPath"), status.ledgerPath_ptr, status.ledgerPath_len);
}

fn ledger_summary(status: &ReputationStatus, out: &StrBuf) -> void {
    out.len = 0;
    let tn = StrBuf { bytes: [0u8; 65536], len: 0 };
    tier_name(status.tier, &tn);
    sb_append(out, STR_PTR("\n• 信誉分值："), STR_LEN("\n• 信誉分值："));
    fmt_i64_sb(status.score as i64, out);
    sb_append(out, STR_PTR("/100\n• 管控梯队：["), STR_LEN("/100\n• 管控梯队：["));
    sb_append(out, sb_ptr(&tn), tn.len);
    sb_append(out, STR_PTR("] ("), STR_LEN("] ("));
    if status.tier == 0 { sb_append(out, STR_PTR("正常自治"), STR_LEN("正常自治")); } else if status.tier == 1 { sb_append(out, STR_PTR("中度审慎"), STR_LEN("中度审慎")); } else { sb_append(out, STR_PTR("高危管控"), STR_LEN("高危管控")); };
    sb_append(out, STR_PTR(" · JEV 全自动督导)\n• 历史惩罚项："), STR_LEN(" · JEV 全自动督导)\n• 历史惩罚项："));
    tool_sb_append_u64(status.totalPenaltiesCount, out);
    sb_append(out, STR_PTR(" 条（未赎回："), STR_LEN(" 条（未赎回："));
    tool_sb_append_u64(status.activePenalties_len, out);
    sb_append(out, STR_PTR(" 条，已赎回："), STR_LEN(" 条，已赎回："));
    tool_sb_append_u64(status.redeemedPenalties_len, out);
    sb_append(out, STR_PTR(" 条）\n• 活性抗体规则："), STR_LEN(" 条）\n• 活性抗体规则："));
    tool_sb_append_u64(status.antibodies_len, out);
    sb_append(out, STR_PTR(" 条\n• 账本路径："), STR_LEN(" 条\n• 账本路径："));
    sb_append(out, status.ledgerPath_ptr, status.ledgerPath_len);
    if status.activePenalties_len > 0 {
        sb_append(out, STR_PTR("\n• 未赎回惩罚："), STR_LEN("\n• 未赎回惩罚："));
        let i: u64 = 0;
        while i < status.activePenalties_len && i < 128 {
            let pen = status.activePenalties[i];
            sb_append(out, STR_PTR("\n - ["), STR_LEN("\n - ["));
            sb_append(out, pen.id_ptr, pen.id_len);
            sb_append(out, STR_PTR("] "), STR_LEN("] "));
            let lname = StrBuf { bytes: [0u8; 65536], len: 0 };
            penalty_level_name(pen.level, &lname);
            sb_append(out, sb_ptr(&lname), lname.len);
            sb_append(out, STR_PTR(" ("), STR_LEN(" ("));
            fmt_i64_sb(pen.scoreDelta as i64, out);
            sb_append(out, STR_PTR(" pts): "), STR_LEN(" pts): "));
            sb_append(out, pen.targetFile_ptr, pen.targetFile_len);
            sb_append(out, STR_PTR(" -> "), STR_LEN(" -> "));
            sb_append(out, pen.errorSignature_ptr, pen.errorSignature_len);
            i = i + 1;
        }
    };
    if status.antibodies_len > 0 {
        sb_append(out, STR_PTR("\n• 已固化抗体规则 (永久免疫)："), STR_LEN("\n• 已固化抗体规则 (永久免疫)："));
        let j: u64 = 0;
        while j < status.antibodies_len && j < 128 {
            let ab = status.antibodies[j];
            sb_append(out, STR_PTR("\n - ["), STR_LEN("\n - ["));
            sb_append(out, ab.targetFile_ptr, ab.targetFile_len);
            sb_append(out, STR_PTR("] 规则: \""), STR_LEN("] 规则: \""));
            sb_append(out, ab.rule_ptr, ab.rule_len);
            sb_append(out, STR_PTR("\" (经验: "), STR_LEN("\" (经验: "));
            sb_append(out, ab.lesson_ptr, ab.lesson_len);
            sb_append(out, STR_PTR(")"), STR_LEN(")"));
            j = j + 1;
        }
    };
}

// ---- JEV bridge ----

fn jev_kind_of(jk: u64) -> u64 {
    if jk == JK_STRING { return 1; };
    if jk == JK_ARRAY { return 2; };
    if jk == JK_OBJECT { return 3; };
    if jk == JK_INT || jk == JK_FLOAT { return 4; };
    if jk == JK_BOOL { return 5; };
    return 0;
}

fn jev_fill_field(ji: &JevRunInput, which: u64, node: u64) -> void {
    if node == 0 { return; };
    let jk: u64 = sa_json_node_kind(node);
    if jk == JK_NULL { return; };
    let p: ptr = PTR_NULL();
    let n: u64 = 0;
    sa_json_node_json_text(node, &p, &n);
    if which == 0 {
        ji.has_question = true;
        ji.question_len = 0;
        let k: u64 = 0;
