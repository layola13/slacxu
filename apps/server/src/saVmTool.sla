            let mt2 = StrBuf { bytes: [0u8; 65536], len: 0 };
            tool_sb_trim(&mv, &mt2);
            let ml = StrBuf { bytes: [0u8; 65536], len: 0 };
            sb_to_lower(&mt2, &ml);
            if tool_bytes_eq(sb_ptr(&ml), ml.len, STR_PTR("no"), STR_LEN("no")) || tool_bytes_eq(sb_ptr(&ml), ml.len, STR_PTR("all"), STR_LEN("all")) {
