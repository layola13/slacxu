    };
    let tp: ptr = sa_fs_read_buffer_data(buf);
    let tl: u64 = sa_fs_read_buffer_len(buf);
    // Simulate the backward chunk walk.
    let max_bytes_u: u64 = max_bytes as u64;
    let cur_pos: u64 = tl;
    let total_read: u64 = 0;
    let newlines: u64 = 0;
    let reached_start: bool = false;
    while cur_pos > 0 && total_read < max_bytes_u && newlines < target_lines + 1 {
        let to_read: u64 = 65536;
        if to_read > cur_pos { to_read = cur_pos; };
        let remain: u64 = max_bytes_u - total_read;
        if to_read > remain { to_read = remain; };
        if to_read == 0 { break; };
        let read_off: u64 = cur_pos - to_read;
        let ci: u64 = 0;
        while ci < to_read {
            if byte_at(tp, read_off + ci) == 10 { newlines = newlines + 1; };
            ci = ci + 1;
        }
        total_read = total_read + to_read;
        cur_pos = read_off;
        if read_off == 0 {
            reached_start = true;
            break;
        };
    }
    let tail_start: u64 = cur_pos;
    let tail_len: u64 = tl - tail_start;
    let tail_p: ptr = PTR_NULL();
    PTR_BYTE_ADD(tail_p, tp, tail_start);
    let chk: u64 = tail_len;
    if chk > 4096 { chk = 4096; };
    if ptr_has_nul(tail_p, chk) {
        let sz = StrBuf { bytes: [0u8; 65536], len: 0 };
        formatBytes(file_size as f64, &sz);
        let m = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_assign(&m, STR_PTR("[Binary file detected: "), STR_LEN("[Binary file detected: "));
        sb_append(&m, sb_ptr(path), path.len);
        sb_append(&m, STR_PTR(" ("), STR_LEN(" ("));
        sb_append(&m, sb_ptr(&sz), sz.len);
        sb_append(&m, STR_PTR("). Text viewing is disabled to prevent context corruption.]"), STR_LEN("). Text viewing is disabled to prevent context corruption.]"));
        res_success(out, started_at);
        res_set_stdout(out, sb_ptr(&m), m.len);
        let rcb: i32 = sa_fs_read_buffer_free(buf);
        return 0;
    };
    let total_t: u64 = 0;
    let maxlen_t: u64 = 0;
    text_line_stats(tail_p, tail_len, &total_t, &maxlen_t);
    let drop_first: bool = !reached_start && total_t > 1;
    let all_count: u64 = total_t;
    if tail_len == 0 || byte_at(tp, tl - 1) == 10 {
        if all_count > 0 { all_count = all_count - 1; };
    };
    if drop_first {
        if all_count > 0 { all_count = all_count - 1; };
    };
    // selected = last target_lines of the adjusted lines; slice line
    // index (1-based in tail text) = adjusted index + (drop_first?1:0)
    let sel_count: u64 = all_count;
    if sel_count > target_lines { sel_count = target_lines; };
    let sel_first_adj: u64 = all_count - sel_count + 1;
    let keep_starts = U64List { items: [0u64; 4096], len: 0 };
    let keep_lens = U64List { items: [0u64; 4096], len: 0 };
    let acc_tokens: f64 = 0.0;
    let acc_bytes: f64 = 0.0;
    let token_capped: bool = false;
    let rev_starts = U64List { items: [0u64; 4096], len: 0 };
    let rev_lens = U64List { items: [0u64; 4096], len: 0 };
    let ai: u64 = all_count;
    while ai >= sel_first_adj && ai >= 1 {
        let slice_idx: u64 = ai;
        if drop_first { slice_idx = ai + 1; };
        let ls: u64 = 0;
        let ll: u64 = 0;
        let found: bool = text_line_span(tail_p, tail_len, slice_idx, &ls, &ll);
        if found {
            let disp_len: u64 = ll;
            let truncated: bool = false;
            if (ll as f64) > max_line_length {
                disp_len = max_line_length as u64;
                truncated = true;
            };
            // token/byte cost over the DISPLAYED line (truncated text
            // plus the truncation suffix when truncated)
            let cost_len: u64 = disp_len;
            if truncated {
                let sfx = StrBuf { bytes: [0u8; 65536], len: 0 };
                sb_assign(&sfx, STR_PTR(" ... [Line truncated: showing first "), STR_LEN(" ... [Line truncated: showing first "));
                tool_sb_append_u64(disp_len, &sfx);
                sb_append(&sfx, STR_PTR(" chars]"), STR_LEN(" chars]"));
                cost_len = disp_len + sfx.len;
            };
            let lp: ptr = PTR_NULL();
            PTR_BYTE_ADD(lp, tail_p, ls);
            let lt: f64 = 0.0;
            if truncated {
                let tmp = StrBuf { bytes: [0u8; 65536], len: 0 };
                sb_append(&tmp, lp, disp_len);
                sb_append(&tmp, STR_PTR(" ... [Line truncated: showing first "), STR_LEN(" ... [Line truncated: showing first "));
                tool_sb_append_u64(disp_len, &tmp);
                sb_append(&tmp, STR_PTR(" chars]"), STR_LEN(" chars]"));
                lt = estimate_tokens_bytes(sb_ptr(&tmp), tmp.len);
                cost_len = tmp.len;
            } else {
                lt = estimate_tokens_bytes(lp, ll);
            };
            let lb: f64 = (cost_len + 1) as f64;
            if acc_tokens + lt > max_tokens || acc_bytes + lb > max_bytes {
                token_capped = true;
                break;
            };
            acc_tokens = acc_tokens + lt;
            acc_bytes = acc_bytes + lb;
            if rev_starts.len < 4096 {
                rev_starts.items[rev_starts.len] = ls;
                rev_lens.items[rev_starts.len] = disp_len;
                rev_starts.len = rev_starts.len + 1;
                rev_lens.len = rev_lens.len + 1;
            };
        };
        if ai == 1 { break; };
        ai = ai - 1;
    }
    // reverse rev_* into keep_* and note truncation per line by length
    let keep_count: u64 = rev_starts.len;
    let ri: u64 = 0;
    while ri < keep_count {
        keep_starts.items[ri] = rev_starts.items[keep_count - 1 - ri];
        keep_lens.items[ri] = rev_lens.items[keep_count - 1 - ri];
        ri = ri + 1;
    }
    keep_starts.len = keep_count;
    keep_lens.len = keep_count;
    let kc_str = StrBuf { bytes: [0u8; 65536], len: 0 };
    fmt_u64_sb(keep_count, &kc_str);
    let pad_width: u64 = kc_str.len;
    if pad_width < 3 { pad_width = 3; };
    let ob = JsonBuf { bytes: [0u8; 262144], len: 0 };
    if token_capped {
        jb_append(&ob, STR_PTR("[Notice: Output truncated by max_tokens="), STR_LEN("[Notice: Output truncated by max_tokens="));
        let mt = StrBuf { bytes: [0u8; 65536], len: 0 };
        fmt_f64_sb(max_tokens, &mt);
        jb_append(&ob, sb_ptr(&mt), mt.len);
        jb_append(&ob, STR_PTR("]\n"), STR_LEN("]\n"));
    };
    let sz = StrBuf { bytes: [0u8; 65536], len: 0 };
    formatBytes(file_size as f64, &sz);
    let h = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_assign(&h, STR_PTR("[File: "), STR_LEN("[File: "));
    sb_append(&h, sb_ptr(path), path.len);
    sb_append(&h, STR_PTR(" | Size: "), STR_LEN(" | Size: "));
    sb_append(&h, sb_ptr(&sz), sz.len);
    sb_append(&h, STR_PTR(" | Mode: Tail reading]\n"), STR_LEN(" | Mode: Tail reading]\n"));
    if reached_start {
        sb_append(&h, STR_PTR("[Showing lines "), STR_LEN("[Showing lines "));
        tool_sb_append_u64(all_count - keep_count + 1, &h);
        sb_append(&h, STR_PTR(" to "), STR_LEN(" to "));
        tool_sb_append_u64(all_count, &h);
        sb_append(&h, STR_PTR(" of "), STR_LEN(" of "));
        tool_sb_append_u64(all_count, &h);
        sb_append(&h, STR_PTR(" (last "), STR_LEN(" (last "));
        tool_sb_append_u64(keep_count, &h);
        sb_append(&h, STR_PTR(" lines, approx "), STR_LEN(" lines, approx "));
        sb_append_f64(acc_tokens, &h);
        sb_append(&h, STR_PTR(" tokens)]\n\n"), STR_LEN(" tokens)]\n\n"));
    } else {
        sb_append(&h, STR_PTR("[Showing trailing "), STR_LEN("[Showing trailing "));
        tool_sb_append_u64(keep_count, &h);
        sb_append(&h, STR_PTR(" lines from end of file (approx "), STR_LEN(" lines from end of file (approx "));
        sb_append_f64(acc_tokens, &h);
        sb_append(&h, STR_PTR(" tokens)]\n[Tip: Use read_lines with specific line ranges for earlier sections]\n\n"), STR_LEN(" tokens)]\n[Tip: Use read_lines with specific line ranges for earlier sections]\n\n"));
    };
    jb_append(&ob, sb_ptr(&h), h.len);
    let fi: u64 = 0;
    while fi < keep_count {
        if fi > 0 { jb_push_byte(&ob, 10); };
        let ls2: u64 = keep_starts.items[fi];
        let ll2: u64 = keep_lens.items[fi];
        let lp2: ptr = PTR_NULL();
        PTR_BYTE_ADD(lp2, tail_p, ls2);
        // truncation suffix applies when the original line was longer
        let slice_idx2: u64 = sel_first_adj + fi;
        if drop_first { slice_idx2 = slice_idx2 + 1; };
        let ols: u64 = 0;
        let oll: u64 = 0;
        let f2: bool = text_line_span(tail_p, tail_len, slice_idx2, &ols, &oll);
        if o_numbered {
            let label = StrBuf { bytes: [0u8; 65536], len: 0 };
            if reached_start {
                fmt_u64_sb(all_count - keep_count + 1 + fi, &label);
            } else {
                sb_append(&label, STR_PTR("-"), STR_LEN("-"));
                let d = StrBuf { bytes: [0u8; 65536], len: 0 };
                fmt_u64_sb(keep_count - fi, &d);
                sb_append(&label, sb_ptr(&d), d.len);
            };
            let pad: u64 = 0;
            if pad_width > label.len { pad = pad_width - label.len; };
            let pi: u64 = 0;
            while pi < pad {
                jb_push_byte(&ob, 32);
                pi = pi + 1;
            }
            jb_append(&ob, sb_ptr(&label), label.len);
            jb_append(&ob, STR_PTR(": "), STR_LEN(": "));
        };
        jb_append(&ob, lp2, ll2);
        if f2 && (oll as f64) > max_line_length {
            let sfx = StrBuf { bytes: [0u8; 65536], len: 0 };
            sb_assign(&sfx, STR_PTR(" ... [Line truncated: showing first "), STR_LEN(" ... [Line truncated: showing first "));
            tool_sb_append_u64(ll2, &sfx);
            sb_append(&sfx, STR_PTR(" chars]"), STR_LEN(" chars]"));
            jb_append(&ob, sb_ptr(&sfx), sfx.len);
        };
        fi = fi + 1;
    }
    res_success(out, started_at);
    res_set_stdout(out, jb_ptr(&ob), ob.len);
    let rcb2: i32 = sa_fs_read_buffer_free(buf);
    return 0;
}

// ---- Search matcher (source L1229 compileSearchMatcher) ----
// mode: 0 never, 1 literal case-insensitive, 2 literal case-sensitive,
// 3 POSIX ERE (JS regex translated: \d -> [[:digit:]]; glibc ERE
// natively carries \b \w \s as GNU extensions). Multiline semantics
// via REG_NEWLINE (flags "m"/"im" in TS).
struct SearchMatcher {
    mode: u64,
    query: StrBuf,
    lower: StrBuf,
    re: u64,
}

fn translate_js_regex(pat: &StrBuf, out: &StrBuf) -> void {
    out.len = 0;
    let i: u64 = 0;
    while i < pat.len {
        if pat.bytes[i] == 92 && i + 1 < pat.len && pat.bytes[i + 1] == 100 {
            sb_append(out, STR_PTR("[[:digit:]]"), STR_LEN("[[:digit:]]"));
            i = i + 2;
        } else {
            out.bytes[out.len] = pat.bytes[i];
            out.len = out.len + 1;
            i = i + 1;
        }
    }
}

fn has_regex_token(q: &StrBuf) -> bool {
    if tool_sb_contains(q, STR_PTR("|"), STR_LEN("|")) { return true; };
    if tool_sb_contains(q, STR_PTR("\\b"), STR_LEN("\\b")) { return true; };
    if tool_sb_contains(q, STR_PTR(".*"), STR_LEN(".*")) { return true; };
    if tool_sb_contains(q, STR_PTR(".+"), STR_LEN(".+")) { return true; };
    if tool_sb_contains(q, STR_PTR("^"), STR_LEN("^")) { return true; };
    if tool_sb_contains(q, STR_PTR("$"), STR_LEN("$")) { return true; };
    let open_b: i64 = sb_index_of(q, STR_PTR("["), STR_LEN("["));
    if open_b >= 0 && tool_sb_contains(q, STR_PTR("]"), STR_LEN("]")) { return true; };
    let open_p: i64 = sb_index_of(q, STR_PTR("("), STR_LEN("("));
    if open_p >= 0 && tool_sb_contains(q, STR_PTR(")"), STR_LEN(")")) { return true; };
    return false;
}

// is_regex: -1 undefined, 0 false, 1 true.
fn compile_search_matcher(q: &StrBuf, is_regex: i32, case_sensitive: bool, out: &SearchMatcher) -> void {
    out.mode = 0;
    out.query = StrBuf { bytes: [0u8; 65536], len: 0 };
    out.lower = StrBuf { bytes: [0u8; 65536], len: 0 };
    out.re = 0;
    if q.len == 0 { return; };
    let token: bool = has_regex_token(q);
    let use_re: bool = is_regex == 1 || (is_regex != 0 && token);
    if use_re {
        let tp = StrBuf { bytes: [0u8; 65536], len: 0 };
        translate_js_regex(q, &tp);
        let cf: i32 = 5;
        if !case_sensitive { cf = 7; };
        let h: u64 = sa_regex_compile(sb_ptr(&tp), tp.len, cf);
        if h != 0 {
            out.mode = 3;
            sb_copy(&out.query, &tp);
            out.re = h;
            return;
        };
    };
    if case_sensitive {
        out.mode = 2;
    } else {
        out.mode = 1;
    };
    sb_copy(&out.query, q);
    sb_to_lower(q, &out.lower);
}

fn matcher_free(m: &SearchMatcher) -> void {
    if m.re != 0 {
        let rc: i32 = sa_regex_free(m.re);
        m.re = 0;
    };
}

fn matcher_test(m: &SearchMatcher, content: &StrBuf) -> bool {
    if m.mode == 0 { return false; };
    if m.mode == 2 { return tool_sb_contains(content, sb_ptr(&m.query), m.query.len); };
    if m.mode == 1 {
        let lc = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_to_lower(content, &lc);
        return tool_sb_contains(&lc, sb_ptr(&m.lower), m.lower.len);
    };
    if m.mode == 3 {
        let mm: u64 = sa_regex_match(m.re, sb_ptr(content), content.len);
        if mm == 0 { return false; };
        let rc: i32 = sa_regex_match_free(mm);
        return true;
    };
    return false;
}

// source L1253: matchesFilePattern.
fn matchesFilePattern(file_name: &StrBuf, rel_path: &StrBuf, pattern: &StrBuf, path_pattern: &StrBuf, has_path_pattern: bool, is_regex: i32) -> bool {
    if has_path_pattern {
        let trimmed = StrBuf { bytes: [0u8; 65536], len: 0 };
        tool_sb_trim(path_pattern, &trimmed);
        if trimmed.len > 0 {
            let m = SearchMatcher { mode: 0, query: StrBuf { bytes: [0u8; 65536], len: 0 }, lower: StrBuf { bytes: [0u8; 65536], len: 0 }, re: 0 };
            compile_search_matcher(&trimmed, is_regex, false, &m);
            let ok: bool = matcher_test(&m, rel_path) || matcher_test(&m, file_name);
            matcher_free(&m);
            if !ok { return false; };
        };
    };
    if pattern.len == 0 { return true; };
    if pattern.len == 1 && pattern.bytes[0] == 42 { return true; };
    let ere = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_append(&ere, STR_PTR("^"), STR_LEN("^"));
    let i: u64 = 0;
    while i < pattern.len {
        let b: u8 = pattern.bytes[i];
        if b == 42 {
            sb_append(&ere, STR_PTR(".*"), STR_LEN(".*"));
        } else if b == 63 {
            sb_append(&ere, STR_PTR("."), STR_LEN("."));
        } else if b == 46 || b == 43 || b == 94 || b == 36 || b == 123 || b == 125 || b == 40 || b == 41 || b == 124 || b == 91 || b == 93 || b == 92 {
            sb_push_byte(&ere, 92);
            sb_push_byte(&ere, b);
        } else {
            sb_push_byte(&ere, b);
        };
        i = i + 1;
    }
    sb_append(&ere, STR_PTR("$"), STR_LEN("$"));
    let h: u64 = sa_regex_compile(sb_ptr(&ere), ere.len, 3);
    if h != 0 {
        let m1: u64 = sa_regex_match(h, sb_ptr(file_name), file_name.len);
        if m1 != 0 {
            let r1: i32 = sa_regex_match_free(m1);
            let r2: i32 = sa_regex_free(h);
            return true;
        };
        let m2: u64 = sa_regex_match(h, sb_ptr(rel_path), rel_path.len);
        if m2 != 0 {
            let r3: i32 = sa_regex_match_free(m2);
            let r4: i32 = sa_regex_free(h);
            return true;
        };
        let r5: i32 = sa_regex_free(h);
    };
    let clean = StrBuf { bytes: [0u8; 65536], len: 0 };
    let j: u64 = 0;
    while j < pattern.len {
        if pattern.bytes[j] != 42 { sb_push_byte(&clean, pattern.bytes[j]); };
        j = j + 1;
    }
    return tool_sb_contains(file_name, sb_ptr(&clean), clean.len) || tool_sb_contains(rel_path, sb_ptr(&clean), clean.len);
}

// paginateItems (source L420) over packed string lists.
fn paginate_items(items: &ListBuf, pg: &ResolvedPagination, out: &ListBuf, total_pages_out: &u64, returned_out: &u64, has_next_out: &bool, has_prev_out: &bool) -> void {
    let total: u64 = lb_count(items);
    let ps: u64 = pg.page_size as u64;
    if ps == 0 { ps = 1; };
    let tp: u64 = 0;
    if total > 0 { tp = (total + ps - 1) / ps; };
    *total_pages_out = tp;
    lb_clear(out);
    let off: u64 = pg.offset as u64;
    let end: u64 = off + ps;
    if end > total { end = total; };
    let e = StrBuf { bytes: [0u8; 65536], len: 0 };
    let i: u64 = off;
    while i < end {
        let got: bool = lb_at(items, i, &e);
        if got { lb_append(out, sb_ptr(&e), e.len); };
        i = i + 1;
    }
    *returned_out = lb_count(out);
    *has_next_out = off + ps < total;
    *has_prev_out = off > 0;
}

fn bytes_cmp(a: &StrBuf, b: &StrBuf) -> i32 {
    let n: u64 = a.len;
    if b.len < n { n = b.len; };
    let i: u64 = 0;
    while i < n {
        if a.bytes[i] != b.bytes[i] {
            if a.bytes[i] < b.bytes[i] { return 0 - 1; };
            return 1;
        };
        i = i + 1;
    }
    if a.len < b.len { return 0 - 1; };
    if a.len > b.len { return 1; };
    return 0;
}

fn sort_listbuf(l: &ListBuf) -> void {
    let n: u64 = lb_count(l);
    if n < 2 { return; };
    let idx = U64List { items: [0u64; 4096], len: 0 };
    let i: u64 = 0;
    while i < n && idx.len < 4096 {
        idx.items[idx.len] = i;
        idx.len = idx.len + 1;
        i = i + 1;
    }
    let a = StrBuf { bytes: [0u8; 65536], len: 0 };
    let b = StrBuf { bytes: [0u8; 65536], len: 0 };
    let x: u64 = 1;
    while x < idx.len {
        let key: u64 = idx.items[x];
        let gk: bool = lb_at(l, key, &a);
        let y: u64 = x;
        while y > 0 {
            let g2: bool = lb_at(l, idx.items[y - 1], &b);
            if bytes_cmp(&b, &a) <= 0 { break; };
            idx.items[y] = idx.items[y - 1];
            y = y - 1;
        }
        idx.items[y] = key;
        x = x + 1;
    }
    let rebuilt = ListBuf { bytes: [0u8; 131072], len: 0 };
    let k: u64 = 0;
    while k < idx.len {
        let got: bool = lb_at(l, idx.items[k], &a);
        if got { lb_append(&rebuilt, sb_ptr(&a), a.len); };
        k = k + 1;
    }
    *l = rebuilt;
}

// ---- nativeFindFiles (source L1279) ----
struct FindCtx {
    cwd: StrBuf,
    resolved_dir: StrBuf,
    dir_orig: StrBuf,
    pattern: StrBuf,
    path_pattern: StrBuf,
    has_path_pattern: bool,
    is_regex: i32,
    scan_cap: u64,
    depth_limit: u64,
    timeout_ms: f64,
    started_at: f64,
    results: ListBuf,
    timed_out: bool,
    truncated: bool,
}

fn findFiles_walk(cur: &StrBuf, depth: u64, norm: &NormalizedSaVmPolicy, gi: &GitIgnoreRules, ctx: &FindCtx) -> void {
    if depth > ctx.depth_limit || lb_count(&ctx.results) >= ctx.scan_cap || ctx.timed_out { return; };
    if now_ms() - ctx.started_at > ctx.timeout_ms {
        ctx.timed_out = true;
        return;
    };
    let names = ListBuf { bytes: [0u8; 131072], len: 0 };
    let kinds = U64List { items: [0u64; 4096], len: 0 };
    if !list_dir_names(cur, &names, &kinds) { return; };
    let cnt: u64 = lb_count(&names);
    let name = StrBuf { bytes: [0u8; 65536], len: 0 };
    let i: u64 = 0;
    while i < cnt {
        if lb_count(&ctx.results) >= ctx.scan_cap {
            ctx.truncated = true;
            break;
        };
        if ctx.timed_out { break; };
        if now_ms() - ctx.started_at > ctx.timeout_ms {
            ctx.timed_out = true;
            break;
        };
        let got: bool = lb_at(&names, i, &name);
        if got {
            let kind: u64 = kinds.items[i];
            let is_dir: bool = kind == 2;
            let full = StrBuf { bytes: [0u8; 65536], len: 0 };
            path_join(cur, &name, &full);
            let rel_cwd = StrBuf { bytes: [0u8; 65536], len: 0 };
            tool_path_relative(&ctx.cwd, &full, &rel_cwd);
            if !isGitIgnored(&name, is_dir, gi, &rel_cwd, true) {
                if is_dir {
                    findFiles_walk(&full, depth + 1, norm, gi, ctx);
                } else {
                    let rel = StrBuf { bytes: [0u8; 65536], len: 0 };
                    tool_path_relative(&ctx.resolved_dir, &full, &rel);
                    if matchesFilePattern(&name, &rel, &ctx.pattern, &ctx.path_pattern, ctx.has_path_pattern, ctx.is_regex) {
                        let rsn = StrBuf { bytes: [0u8; 65536], len: 0 };
                        if toolCheckPath(norm, 0, &full, &ctx.cwd, &rsn) {
                            let display = StrBuf { bytes: [0u8; 65536], len: 0 };
                            if ctx.dir_orig.len == 0 || (ctx.dir_orig.len == 1 && ctx.dir_orig.bytes[0] == 46) {
                                sb_copy(&display, &rel);
                            } else {
                                path_join(&ctx.dir_orig, &rel, &display);
                            };
                            lb_append(&ctx.results, sb_ptr(&display), display.len);
                        };
                    };
                };
            };
        };
        i = i + 1;
    }
}

fn nativeFindFiles(dir: &StrBuf, pattern: &StrBuf, max_entries: f64, max_depth: f64, policy_doc: u64, cwd: &StrBuf, started_at: f64, timeout_opts: &JsonBuf, extra_opts: &JsonBuf, out: &SaVmRunResult) -> i32 {
    let resolved_dir = StrBuf { bytes: [0u8; 65536], len: 0 };
