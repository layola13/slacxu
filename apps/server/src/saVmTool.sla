fn sem_filter(list: &SemanticIssueList, out: &SemanticIssueList) -> void {
    out.len = 0;
    let i: u64 = 0;
    while i < list.len {
        let it = list.items[i];
        if it.has_code {
            let code = StrBuf { bytes: [0u8; 65536], len: 0 };
            let fp26: ptr = PTR_NULL(); PTR_BYTE_ADD(fp26, &it.code, 0); sb_append(&code, fp26, it.code_len);
            if !sb_starts(&code, STR_PTR("TS6133"), STR_LEN("TS6133")) {
                if out.len < 256 { out.items[out.len] = it; out.len = out.len + 1; };
            };
        };
        i = i + 1;
    }
}

fn sem_is_env_code(code: &StrBuf) -> bool {
    return tool_bytes_eq(sb_ptr(code), code.len, STR_PTR("TS2307"), STR_LEN("TS2307")) || tool_bytes_eq(sb_ptr(code), code.len, STR_PTR("TS2792"), STR_LEN("TS2792")) || tool_bytes_eq(sb_ptr(code), code.len, STR_PTR("TS2688"), STR_LEN("TS2688"));
}

fn sem_is_blocking(it: &SemanticIssue) -> bool {
    if !it.has_code { return false; };
    let code = StrBuf { bytes: [0u8; 65536], len: 0 };
    let fp27: ptr = PTR_NULL(); PTR_BYTE_ADD(fp27, &it.code, 0); sb_append(&code, fp27, it.code_len);
    if sem_is_env_code(&code) { return false; };
    return tool_sb_contains(&code, STR_PTR("TS23"), STR_LEN("TS23")) || tool_sb_contains(&code, STR_PTR("TS10"), STR_LEN("TS10")) || tool_sb_contains(&code, STR_PTR("TS11"), STR_LEN("TS11")) || tool_sb_contains(&code, STR_PTR("TS27"), STR_LEN("TS27")) || tool_sb_contains(&code, STR_PTR("TS25"), STR_LEN("TS25"));
}

fn nativeExtractComponent(raw_source: &StrBuf, raw_target: &StrBuf, start_line: f64, has_start: bool, end_line: f64, has_end: bool, options: &JsonBuf, policy_doc: u64, cwd: &StrBuf, started_at: f64, out: &SaVmRunResult) -> i32 {
