    }
    res_success(out, started_at);
    res_set_stdout(out, jb_ptr(&pretty), pretty.len);
    if odoc != 0 { sa_json_free(odoc); };
    return 0;
}

fn isSafeGitRevision(rev: &StrBuf) -> bool {
    let t = StrBuf { bytes: [0u8; 65536], len: 0 };
    tool_sb_trim(rev, &t);
    if t.len == 0 || t.len > 128 { return false; };
    if t.bytes[0] == 45 { return false; };
    let i: u64 = 0;
    while i < t.len {
        let b: u8 = t.bytes[i];
        let ok: bool = (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || (b >= 48 && b <= 57) || b == 95 || b == 46 || b == 47 || b == 126 || b == 94 || b == 58 || b == 43 || b == 45;
        if !ok { return false; };
        i = i + 1;
    }
    return true;
}

fn git_diff_argv(effective_staged: bool, extra: &StrBuf, raw_rev: &StrBuf, has_rev: bool, pathspec: &StrBuf, has_pathspec: bool, argv_out: &ByteList) -> void {
    argv_out.len = 0;
    bl_push(argv_out, STR_PTR("diff"), STR_LEN("diff"));
    bl_push(argv_out, STR_PTR("--no-color"), STR_LEN("--no-color"));
    bl_push(argv_out, STR_PTR("--no-ext-diff"), STR_LEN("--no-ext-diff"));
    if effective_staged { bl_push(argv_out, STR_PTR("--cached"), STR_LEN("--cached")); };
    bl_push_sb(argv_out, extra);
    if has_rev { bl_push_sb(argv_out, raw_rev); };
    if has_pathspec {
        bl_push(argv_out, STR_PTR("--"), STR_LEN("--"));
        bl_push_sb(argv_out, pathspec);
    };
}

