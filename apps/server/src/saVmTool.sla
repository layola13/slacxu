    let idx = U64List { items: [0u64; 4096], len: 0 };
    let i0: u64 = 0;
    while i0 < cnt && idx.len < 4096 {
        idx.items[idx.len] = i0;
        idx.len = idx.len + 1;
        i0 = i0 + 1;
    }
