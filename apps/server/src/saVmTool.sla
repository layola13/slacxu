    };
    let dir = StrBuf { bytes: [0u8; 65536], len: 0 };
    tool_path_dirname(&resolved, &dir);
    if sa_fs_mkdir_p(sb_ptr(&dir), dir.len) != 0 {
        let m = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_assign(&m, STR_PTR("failed to create directory for '"), STR_LEN("failed to create directory for '"));
        sb_append(&m, sb_ptr(path), path.len);
