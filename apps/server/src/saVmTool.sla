    if me_has && me > 0.0 {
        max_entries = me;
        if max_entries > 2000.0 { max_entries = 2000.0; };
        max_entries = (max_entries as i64) as f64;
    };
    let max_bytes: f64 = resolveGitMaxBytes(odoc, 32768.0);
    let timeout_ms: f64 = resolveTimeoutMs(options, 15000.0);
    let argv = ByteList { items: [0u8; 4096], len: 0 };
    bl_push(&argv, STR_PTR("status"), STR_LEN("status"));
    if short {
        bl_push(&argv, STR_PTR("--porcelain=v1"), STR_LEN("--porcelain=v1"));
        bl_push(&argv, STR_PTR("-b"), STR_LEN("-b"));
    };
    let uarg = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_assign(&uarg, STR_PTR("--untracked-files="), STR_LEN("--untracked-files="));
    sb_append(&uarg, sb_ptr(&mode), mode.len);
    bl_push_sb(&argv, &uarg);
    let r = GitSpawnResult { status: 0, has_status: false, stdout: GitBigBuf { bytes: [0u8; 524288], len: 0 }, stderr: StrBuf { bytes: [0u8; 65536], len: 0 }, unavailable: false, timedOut: false };
    execGitSync(&repo_root, &argv, timeout_ms, &r);
    if git_propagate(out, &r, STR_PTR("git status failed"), STR_LEN("git status failed"), started_at) {
        if odoc != 0 { sa_json_free(odoc); };
        return 0;
    };
    if !short {
        let truncated: bool = r.stdout.len > (max_bytes as u64);
        let text_len: u64 = r.stdout.len;
        if truncated { text_len = max_bytes as u64; };
