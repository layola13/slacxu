    }
    let out_returned: u64 = returned_count;
    let tpages: u64 = 0;
    let list_order = U64List { items: [0u64; 4096], len: 0 };
    let list_n: u64 = 0;
    if detailed_mode { list_n = lb_count(&det_files); } else { list_n = lb_count(&compact_list); };
    let li0: u64 = 0;
    while li0 < list_n && list_order.len < 4096 {
        list_order.items[list_order.len] = li0;
        list_order.len = list_order.len + 1;
        li0 = li0 + 1;
    }
    if pg.paginated {
        // sort flat by file (stable)
        let fa = StrBuf { bytes: [0u8; 65536], len: 0 };
        let fb = StrBuf { bytes: [0u8; 65536], len: 0 };
        let x: u64 = 1;
        while x < order.len {
            let key: u64 = order.items[x];
            let gk: bool = lb_at(&flat_files, key, &fa);
            let y: u64 = x;
            while y > 0 {
                let g2: bool = lb_at(&flat_files, order.items[y - 1], &fb);
                if bytes_cmp(&fb, &fa) <= 0 { break; };
                order.items[y] = order.items[y - 1];
                y = y - 1;
            }
            order.items[y] = key;
            x = x + 1;
        }
        let ps: u64 = pg.page_size as u64;
        if ps == 0 { ps = 1; };
        if flat_n > 0 { tpages = (flat_n + ps - 1) / ps; };
        let off: u64 = pg.offset as u64;
        let end: u64 = off + ps;
        if end > flat_n { end = flat_n; };
        let sliced_order = U64List { items: [0u64; 4096], len: 0 };
        let si2: u64 = off;
        while si2 < end && sliced_order.len < 4096 {
            sliced_order.items[sliced_order.len] = order.items[si2];
            sliced_order.len = sliced_order.len + 1;
            si2 = si2 + 1;
        }
        order = sliced_order;
        out_returned = order.len;
        // sort the impl list: detailed by (file,line); compact by string
        if detailed_mode {
            let da = StrBuf { bytes: [0u8; 65536], len: 0 };
            let db = StrBuf { bytes: [0u8; 65536], len: 0 };
            let x2: u64 = 1;
            while x2 < list_order.len {
                let key: u64 = list_order.items[x2];
                let gk: bool = lb_at(&det_files, key, &da);
                let y2: u64 = x2;
                while y2 > 0 {
                    let g2: bool = lb_at(&det_files, list_order.items[y2 - 1], &db);
                    let cmp: i32 = bytes_cmp(&db, &da);
                    if cmp < 0 { break; };
                    if cmp == 0 && det_lines.items[list_order.items[y2 - 1]] <= det_lines.items[key] { break; };
                    list_order.items[y2] = list_order.items[y2 - 1];
                    y2 = y2 - 1;
                }
                list_order.items[y2] = key;
                x2 = x2 + 1;
            }
        } else {
            sort_listbuf(&compact_list);
            list_order.len = 0;
            let li1: u64 = 0;
            while li1 < lb_count(&compact_list) && list_order.len < 4096 {
                list_order.items[list_order.len] = li1;
                list_order.len = list_order.len + 1;
                li1 = li1 + 1;
            }
        };
        // paginate the impl list with the same pg
        let ps3: u64 = pg.page_size as u64;
        if ps3 == 0 { ps3 = 1; };
        let off3: u64 = pg.offset as u64;
        let end3: u64 = off3 + ps3;
        if end3 > list_order.len { end3 = list_order.len; };
        let lo2 = U64List { items: [0u64; 4096], len: 0 };
        let si3: u64 = off3;
        while si3 < end3 && lo2.len < 4096 {
            lo2.items[lo2.len] = list_order.items[si3];
            lo2.len = lo2.len + 1;
            si3 = si3 + 1;
        }
        list_order = lo2;
    };
    // output
    let ob = JsonBuf { bytes: [0u8; 262144], len: 0 };
    jb_append(&ob, STR_PTR("{\n  \"symbol\": \""), STR_LEN("{\n  \"symbol\": \""));
    jescape_into(&symbol, &ob);
    let t = StrBuf { bytes: [0u8; 65536], len: 0 };
    jb_append(&ob, STR_PTR("\",\n  \"total\": "), STR_LEN("\",\n  \"total\": "));
    fmt_u64_sb(total_found, &t);
    jb_append(&ob, sb_ptr(&t), t.len);
    jb_append(&ob, STR_PTR(",\n  \"returned\": "), STR_LEN(",\n  \"returned\": "));
    fmt_u64_sb(out_returned, &t);
    jb_append(&ob, sb_ptr(&t), t.len);
    jb_append(&ob, STR_PTR(",\n  \"truncated\": "), STR_LEN(",\n  \"truncated\": "));
    if total_found > out_returned || timed_out { jb_append(&ob, STR_PTR("true"), STR_LEN("true")); } else { jb_append(&ob, STR_PTR("false"), STR_LEN("false")); };
    if timed_out {
        jb_append(&ob, STR_PTR(",\n  \"timed_out\": true,\n  \"timeout_ms\": "), STR_LEN(",\n  \"timed_out\": true,\n  \"timeout_ms\": "));
        fmt_f64_sb(timeout_ms, &t);
        jb_append(&ob, sb_ptr(&t), t.len);
    };
    if pg.paginated {
        jb_append(&ob, STR_PTR(",\n  \"page\": "), STR_LEN(",\n  \"page\": "));
        fmt_f64_sb(pg.page, &t);
        jb_append(&ob, sb_ptr(&t), t.len);
        jb_append(&ob, STR_PTR(",\n  \"page_size\": "), STR_LEN(",\n  \"page_size\": "));
        fmt_f64_sb(pg.page_size, &t);
        jb_append(&ob, sb_ptr(&t), t.len);
        jb_append(&ob, STR_PTR(",\n  \"total_pages\": "), STR_LEN(",\n  \"total_pages\": "));
        fmt_u64_sb(tpages, &t);
        jb_append(&ob, sb_ptr(&t), t.len);
        jb_append(&ob, STR_PTR(",\n  \"has_next\": "), STR_LEN(",\n  \"has_next\": "));
        let hn: bool = false;
        if total_found >= (pg.count_cap as u64) || timed_out {
            hn = true;
        } else {
            let ps2: u64 = pg.page_size as u64;
            hn = (pg.offset as u64) + ps2 < flat_n;
        };
        if hn { jb_append(&ob, STR_PTR("true"), STR_LEN("true")); } else { jb_append(&ob, STR_PTR("false"), STR_LEN("false")); };
        jb_append(&ob, STR_PTR(",\n  \"has_prev\": "), STR_LEN(",\n  \"has_prev\": "));
        if pg.offset > 0.0 { jb_append(&ob, STR_PTR("true"), STR_LEN("true")); } else { jb_append(&ob, STR_PTR("false"), STR_LEN("false")); };
    };
    jb_append(&ob, STR_PTR(",\n  \"types\": {\n    \"e3\": \"impl\"\n  },\n  \"files\": "), STR_LEN(",\n  \"types\": {\n    \"e3\": \"impl\"\n  },\n  \"files\": "));
    if order.len == 0 {
        jb_append(&ob, STR_PTR("{}"), STR_LEN("{}"));
    } else {
        jb_append(&ob, STR_PTR("{"), STR_LEN("{"));
        let cur_file = StrBuf { bytes: [0u8; 65536], len: 0 };
        let ef = StrBuf { bytes: [0u8; 65536], len: 0 };
        let ee = StrBuf { bytes: [0u8; 65536], len: 0 };
        let first_group: bool = true;
        let first_entry: bool = true;
        let ki: u64 = 0;
        while ki < order.len {
            let ix: u64 = order.items[ki];
            let g1: bool = lb_at(&flat_files, ix, &ef);
            let g2: bool = lb_at(&flat_entries, ix, &ee);
            if first_group || !tool_bytes_eq(sb_ptr(&ef), ef.len, sb_ptr(&cur_file), cur_file.len) {
                if !first_group {
                    jb_append(&ob, STR_PTR("\n    ],"), STR_LEN("\n    ],"));
                };
                jb_append(&ob, STR_PTR("\n    \""), STR_LEN("\n    \""));
                jescape_into(&ef, &ob);
                jb_append(&ob, STR_PTR("\": ["), STR_LEN("\": ["));
                sb_copy(&cur_file, &ef);
                first_group = false;
                first_entry = true;
            };
            if !first_entry { jb_append(&ob, STR_PTR(","), STR_LEN(",")); };
            jb_append(&ob, STR_PTR("\n      \""), STR_LEN("\n      \""));
            jescape_into(&ee, &ob);
            jb_append(&ob, STR_PTR("\""), STR_LEN("\""));
            first_entry = false;
            ki = ki + 1;
        }
        jb_append(&ob, STR_PTR("\n    ]\n  }"), STR_LEN("\n    ]\n  }"));
    };
    jb_append(&ob, STR_PTR(",\n  \"implementations\": ["), STR_LEN(",\n  \"implementations\": ["));
    if detailed_mode {
        let df = StrBuf { bytes: [0u8; 65536], len: 0 };
        let ds = StrBuf { bytes: [0u8; 65536], len: 0 };
        let dbo = StrBuf { bytes: [0u8; 65536], len: 0 };
        let di: u64 = 0;
        while di < list_order.len {
            let ix: u64 = list_order.items[di];
            let g1: bool = lb_at(&det_files, ix, &df);
            let g2: bool = lb_at(&det_sigs, ix, &ds);
            let g3: bool = lb_at(&det_bodies, ix, &dbo);
            if di > 0 { jb_append(&ob, STR_PTR(","), STR_LEN(",")); };
            jb_append(&ob, STR_PTR("\n    {\n      \"file\": \""), STR_LEN("\n    {\n      \"file\": \""));
            jescape_into(&df, &ob);
            jb_append(&ob, STR_PTR("\",\n      \"line\": "), STR_LEN("\",\n      \"line\": "));
            fmt_u64_sb(det_lines.items[ix], &t);
            jb_append(&ob, sb_ptr(&t), t.len);
            jb_append(&ob, STR_PTR(",\n      \"type\": \"e3\",\n      \"signature\": \""), STR_LEN(",\n      \"type\": \"e3\",\n      \"signature\": \""));
            jescape_into(&ds, &ob);
            jb_append(&ob, STR_PTR("\""), STR_LEN("\""));
            if det_has_body.items[ix] == 1 {
                jb_append(&ob, STR_PTR(",\n      \"body\": \""), STR_LEN(",\n      \"body\": \""));
                jescape_into(&dbo, &ob);
                jb_append(&ob, STR_PTR("\""), STR_LEN("\""));
            };
            jb_append(&ob, STR_PTR("\n    }"), STR_LEN("\n    }"));
            di = di + 1;
        }
        if list_order.len > 0 { jb_append(&ob, STR_PTR("\n  "), STR_LEN("\n  ")); };
    } else {
        let ce = StrBuf { bytes: [0u8; 65536], len: 0 };
        let di: u64 = 0;
        while di < list_order.len {
            let ix: u64 = list_order.items[di];
            let g1: bool = lb_at(&compact_list, ix, &ce);
            if di > 0 { jb_append(&ob, STR_PTR(","), STR_LEN(",")); };
            jb_append(&ob, STR_PTR("\n    \""), STR_LEN("\n    \""));
            jescape_into(&ce, &ob);
            jb_append(&ob, STR_PTR("\""), STR_LEN("\""));
            di = di + 1;
        }
        if list_order.len > 0 { jb_append(&ob, STR_PTR("\n  "), STR_LEN("\n  ")); };
    };
    jb_append(&ob, STR_PTR("]\n}"), STR_LEN("]\n}"));
    let ev: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    let eo: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    if ev != 0 && eo != 0 {
        jset_i64(eo, STR_PTR("timestamp"), STR_LEN("timestamp"), sa_time_unix_ms());
        jset_str(eo, STR_PTR("type"), STR_LEN("type"), STR_PTR("find_implementations_completed"), STR_LEN("find_implementations_completed"));
        jset_str(eo, STR_PTR("symbol"), STR_LEN("symbol"), sb_ptr(&symbol), symbol.len);
        jset_f64(eo, STR_PTR("total"), STR_LEN("total"), total_found as f64);
        jset_f64(eo, STR_PTR("returned"), STR_LEN("returned"), returned_count as f64);
        jset_f64(eo, STR_PTR("durationMs"), STR_LEN("durationMs"), dur_since(started_at) as f64);
        let rcp: i32 = sa_json_array_push_node(ev, eo);
        let ejb = JsonBuf { bytes: [0u8; 262144], len: 0 };
        jdoc_to_jb(ev, &ejb);
        res_success(out, started_at);
        res_set_stdout(out, jb_ptr(&ob), ob.len);
        res_set_events(out, jb_ptr(&ejb), ejb.len);
        let bfix7919: i32 = sa_json_free(ev);
    } else {
        res_success(out, started_at);
        res_set_stdout(out, jb_ptr(&ob), ob.len);
        if ev != 0 { sa_json_free(ev); };
    };
    if timed_out {
        let em = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_assign(&em, STR_PTR("[timeout] find_implementations reached timeout limit of "), STR_LEN("[timeout] find_implementations reached timeout limit of "));
        sb_append_f64(timeout_ms, &em);
        sb_append(&em, STR_PTR("ms; scanned "), STR_LEN("ms; scanned "));
        tool_sb_append_u64(tcount, &em);
        sb_append(&em, STR_PTR(" files"), STR_LEN(" files"));
        res_set_stderr(out, sb_ptr(&em), em.len);
    };
    if odoc != 0 { sa_json_free(odoc); };
    return 0;
}

// ---- module boundary / workspace collection / outlines / imports ----
fn detectModuleBoundary(file_path: &StrBuf, root_dir: &StrBuf, out: &StrBuf, has: &bool) -> void {
    *has = false;
    out.len = 0;
    let resolved = StrBuf { bytes: [0u8; 65536], len: 0 };
    path_normalize(file_path, &resolved);
    let current_dir = StrBuf { bytes: [0u8; 65536], len: 0 };
    tool_path_dirname(&resolved, &current_dir);
    let root = StrBuf { bytes: [0u8; 65536], len: 0 };
    path_normalize(root_dir, &root);
    let bf_names = ListBuf { bytes: [0u8; 131072], len: 0 };
    lb_append(&bf_names, STR_PTR("package.json"), STR_LEN("package.json"));
    lb_append(&bf_names, STR_PTR("Cargo.toml"), STR_LEN("Cargo.toml"));
    lb_append(&bf_names, STR_PTR("go.mod"), STR_LEN("go.mod"));
    lb_append(&bf_names, STR_PTR("build.zig"), STR_LEN("build.zig"));
    lb_append(&bf_names, STR_PTR("pyproject.toml"), STR_LEN("pyproject.toml"));
    while current_dir.len >= root.len {
        let bi: u64 = 0;
        let bf = StrBuf { bytes: [0u8; 65536], len: 0 };
        while bi < 5 {
            let got: bool = lb_at(&bf_names, bi, &bf);
            if got {
                let candidate = StrBuf { bytes: [0u8; 65536], len: 0 };
                path_join(&current_dir, &bf, &candidate);
                if fs_exists_sb(&candidate) {
                    let mod_name = StrBuf { bytes: [0u8; 65536], len: 0 };
                    tool_path_relative(&root, &current_dir, &mod_name);
                    if mod_name.len == 0 { sb_assign(&mod_name, STR_PTR("."), 1); };
                    let raw = StrBuf { bytes: [0u8; 65536], len: 0 };
                    if tool_bytes_eq(sb_ptr(&bf), bf.len, STR_PTR("package.json"), STR_LEN("package.json")) {
                        if fs_read_sb(&candidate, 65536, &raw) == 0 {
                            let doc: u64 = jdoc_of_sb(&raw);
                            if doc != 0 {
                                let nv = StrBuf { bytes: [0u8; 65536], len: 0 };
                                if jget_str(doc, STR_PTR("name"), STR_LEN("name"), &nv) && nv.len > 0 {
                                    sb_copy(&mod_name, &nv);
                                };
                                sa_json_free(doc);
                            };
                        };
                    } else if tool_bytes_eq(sb_ptr(&bf), bf.len, STR_PTR("go.mod"), STR_LEN("go.mod")) {
                        if fs_read_sb(&candidate, 65536, &raw) == 0 {
                            let tl: u64 = 0;
                            let mx: u64 = 0;
                            text_line_stats(sb_ptr(&raw), raw.len, &tl, &mx);
                            let line = StrBuf { bytes: [0u8; 65536], len: 0 };
                            let idx: u64 = 1;
                            while idx <= tl {
                                let ls: u64 = 0;
                                let ll: u64 = 0;
                                if text_line_span(sb_ptr(&raw), raw.len, idx, &ls, &ll) {
                                    line.len = 0;
                                    let lp: ptr = PTR_NULL();
                                    PTR_BYTE_ADD(lp, sb_ptr(&raw), ls);
                                    sb_append(&line, lp, ll);
                                    let tr = StrBuf { bytes: [0u8; 65536], len: 0 };
                                    tool_sb_trim(&line, &tr);
                                    if sb_starts(&tr, STR_PTR("module "), STR_LEN("module ")) {
                                        let rest = StrBuf { bytes: [0u8; 65536], len: 0 };
                                        let po8002_0: ptr = PTR_NULL();
                                        PTR_BYTE_ADD(po8002_0, sb_ptr(&tr), 7);
                                        sb_append(&rest, po8002_0, tr.len - 7);
                                        let rt = StrBuf { bytes: [0u8; 65536], len: 0 };
                                        tool_sb_trim(&rest, &rt);
                                        sb_copy(&mod_name, &rt);
                                        break;
                                    };
                                };
                                idx = idx + 1;
                            }
                        };
                    } else if tool_bytes_eq(sb_ptr(&bf), bf.len, STR_PTR("Cargo.toml"), STR_LEN("Cargo.toml")) {
                        if fs_read_sb(&candidate, 65536, &raw) == 0 {
                            let tl: u64 = 0;
                            let mx: u64 = 0;
                            text_line_stats(sb_ptr(&raw), raw.len, &tl, &mx);
                            let line = StrBuf { bytes: [0u8; 65536], len: 0 };
                            let idx: u64 = 1;
                            while idx <= tl {
                                let ls: u64 = 0;
                                let ll: u64 = 0;
                                if text_line_span(sb_ptr(&raw), raw.len, idx, &ls, &ll) {
                                    line.len = 0;
                                    let lp: ptr = PTR_NULL();
                                    PTR_BYTE_ADD(lp, sb_ptr(&raw), ls);
                                    sb_append(&line, lp, ll);
                                    let tr = StrBuf { bytes: [0u8; 65536], len: 0 };
                                    tool_sb_trim(&line, &tr);
                                    if sb_starts(&tr, STR_PTR("name"), STR_LEN("name")) {
                                        let eq: i64 = sb_index_of(&tr, STR_PTR("="), STR_LEN("="));
                                        if eq > 0 {
                                            let lhs = StrBuf { bytes: [0u8; 65536], len: 0 };
                                            sb_append(&lhs, sb_ptr(&tr), eq as u64);
                                            let lt = StrBuf { bytes: [0u8; 65536], len: 0 };
                                            tool_sb_trim(&lhs, &lt);
                                            if tool_bytes_eq(sb_ptr(&lt), lt.len, STR_PTR("name"), STR_LEN("name")) {
                                                let rhs = StrBuf { bytes: [0u8; 65536], len: 0 };
                                                let pq8040_0: ptr = PTR_NULL();
                                                PTR_BYTE_ADD(pq8040_0, sb_ptr(&tr), (eq as u64) + 1);
                                                sb_append(&rhs, pq8040_0, tr.len - (eq as u64) - 1);
                                                let noq = StrBuf { bytes: [0u8; 65536], len: 0 };
                                                sb_replace_all(&rhs, STR_PTR("\""), STR_LEN("\""), STR_PTR(""), 0, &noq);
                                                let nt = StrBuf { bytes: [0u8; 65536], len: 0 };
                                                tool_sb_trim(&noq, &nt);
                                                if nt.len > 0 { sb_copy(&mod_name, &nt); };
                                                break;
                                            };
                                        };
                                    };
                                };
                                idx = idx + 1;
                            }
                        };
                    };
                    sb_copy(out, &mod_name);
                    *has = true;
                    return;
                };
            };
            bi = bi + 1;
        }
        let parent = StrBuf { bytes: [0u8; 65536], len: 0 };
        tool_path_dirname(&current_dir, &parent);
        if tool_bytes_eq(sb_ptr(&parent), parent.len, sb_ptr(&current_dir), current_dir.len) { break; };
        sb_copy(&current_dir, &parent);
    }
}

fn collectWorkspaceSourceFiles(base_dir: &StrBuf, max_files: f64, timeout_ms: f64, started_at: f64, out: &ListBuf) -> void {
    // Bun.Glob fast path does not exist in the native runtime (no
    // globalThis.Bun), so the TS readdir-queue fallback is the behavior.
    out.len = 0;
    let gi = GitIgnoreRules { pats: ListBuf { bytes: [0u8; 131072], len: 0 }, items: [GitRuleCore { negated: false, dir_only: false, has_slash: false, anchored: false, pat_line: 0 }; 512], len: 0 };
    loadGitIgnoreRules(base_dir, &gi);
    let queue = ListBuf { bytes: [0u8; 131072], len: 0 };
    lb_append(&queue, sb_ptr(base_dir), base_dir.len);
    let head: u64 = 0;
    let cur = StrBuf { bytes: [0u8; 65536], len: 0 };
    let exts = ListBuf { bytes: [0u8; 131072], len: 0 };
    lb_append(&exts, STR_PTR(".ts"), STR_LEN(".ts"));
    lb_append(&exts, STR_PTR(".tsx"), STR_LEN(".tsx"));
    lb_append(&exts, STR_PTR(".js"), STR_LEN(".js"));
    lb_append(&exts, STR_PTR(".jsx"), STR_LEN(".jsx"));
    lb_append(&exts, STR_PTR(".mjs"), STR_LEN(".mjs"));
    lb_append(&exts, STR_PTR(".cjs"), STR_LEN(".cjs"));
    lb_append(&exts, STR_PTR(".rs"), STR_LEN(".rs"));
    lb_append(&exts, STR_PTR(".py"), STR_LEN(".py"));
    lb_append(&exts, STR_PTR(".go"), STR_LEN(".go"));
    lb_append(&exts, STR_PTR(".zig"), STR_LEN(".zig"));
    lb_append(&exts, STR_PTR(".java"), STR_LEN(".java"));
    lb_append(&exts, STR_PTR(".c"), STR_LEN(".c"));
    lb_append(&exts, STR_PTR(".cpp"), STR_LEN(".cpp"));
    lb_append(&exts, STR_PTR(".h"), STR_LEN(".h"));
    lb_append(&exts, STR_PTR(".vue"), STR_LEN(".vue"));
    lb_append(&exts, STR_PTR(".svelte"), STR_LEN(".svelte"));
    lb_append(&exts, STR_PTR(".json"), STR_LEN(".json"));
    lb_append(&exts, STR_PTR(".toml"), STR_LEN(".toml"));
    while head < lb_count(&queue) && (lb_count(out) as f64) < max_files {
        if now_ms() - started_at > timeout_ms { break; };
        let got: bool = lb_at(&queue, head, &cur);
        head = head + 1;
        if got {
            let names = ListBuf { bytes: [0u8; 131072], len: 0 };
            let kinds = U64List { items: [0u64; 4096], len: 0 };
            if list_dir_names(&cur, &names, &kinds) {
                let cnt: u64 = lb_count(&names);
                let name = StrBuf { bytes: [0u8; 65536], len: 0 };
                let ii: u64 = 0;
                while ii < cnt {
                    let g2: bool = lb_at(&names, ii, &name);
                    if g2 {
                        let kind: u64 = kinds.items[ii];
                        let full = StrBuf { bytes: [0u8; 65536], len: 0 };
                        path_join(&cur, &name, &full);
                        if kind == 2 {
                            if !isGitIgnored(&name, true, &gi, &name, false) {
                                lb_append(&queue, sb_ptr(&full), full.len);
                            };
                        } else if kind == 1 {
                            if !isGitIgnored(&name, false, &gi, &name, false) {
                                let lower = StrBuf { bytes: [0u8; 65536], len: 0 };
                                sb_to_lower(&name, &lower);
                                let ei: u64 = 0;
                                let ev = StrBuf { bytes: [0u8; 65536], len: 0 };
                                let ok: bool = false;
                                while ei < lb_count(&exts) {
                                    let g3: bool = lb_at(&exts, ei, &ev);
                                    if g3 && sb_ends(&lower, sb_ptr(&ev), ev.len) { ok = true; break; };
                                    ei = ei + 1;
                                }
                                if ok { lb_append(out, sb_ptr(&full), full.len); };
                            };
                        };
                    };
                    ii = ii + 1;
                }
            };
        };
    }
}

fn prefilterFilesInWorkers(files: &ListBuf, symbol: &StrBuf, timeout_ms: f64, out: &ListBuf, ok: &bool) -> void {
    // The native runtime has no Worker constructor, so the TS guard
    // (typeof Worker === "undefined") throws "workers unavailable" and
    // every caller falls back to its sequential loop. Same contract.
    *ok = false;
    out.len = 0;
}

