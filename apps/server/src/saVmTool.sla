// matchAll: collect capture group `group` of every ERE match.
fn re_all_group(pat: &StrBuf, cflags: i32, text: &StrBuf, group: u64, out: &ListBuf) -> void {
    let re: u64 = sa_regex_compile(sb_ptr(pat), pat.len, cflags);
    if re == 0 { return; };
    let pos: u64 = 0;
    let guard: u64 = 0;
    while pos <= text.len {
        let sp: ptr = PTR_NULL();
        PTR_BYTE_ADD(sp, sb_ptr(text), pos);
        let m: u64 = sa_regex_match(re, sp, text.len - pos);
        if m == 0 { break; };
        let gs: u64 = sa_regex_group_start(m, group);
        let gl: u64 = sa_regex_group_len(m, group);
        let seg = StrBuf { bytes: [0u8; 65536], len: 0 };
        let gp: ptr = PTR_NULL();
        PTR_BYTE_ADD(gp, sp, gs);
        sb_append(&seg, gp, gl);
        lb_append(out, sb_ptr(&seg), seg.len);
        let w0: u64 = sa_regex_group_start(m, 0);
        let w1: u64 = sa_regex_group_len(m, 0);
        let rcf: i32 = sa_regex_match_free(m);
        let adv: u64 = w0 + w1;
        if adv == 0 { adv = 1; };
        pos = pos + adv;
        guard = guard + 1;
        if guard > 10000 { break; };
    }
    let rc: i32 = sa_regex_free(re);
}

fn sym_push_unique(list: &ByteList, s: &StrBuf) -> void {
    if s.len == 0 { return; };
    if bl_contains(list, sb_ptr(s), s.len) { return; };
    bl_push(list, sb_ptr(s), s.len);
}

