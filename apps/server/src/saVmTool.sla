        };
        let ev: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
        let eo: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
        if ev != 0 && eo != 0 {
            jset_i64(eo, STR_PTR("timestamp"), STR_LEN("timestamp"), now);
            if is_memory { jset_str(eo, STR_PTR("type"), STR_LEN("type"), STR_PTR("memories_cleared"), STR_LEN("memories_cleared")); } else { jset_str(eo, STR_PTR("type"), STR_LEN("type"), STR_PTR("notes_cleared"), STR_LEN("notes_cleared")); };
            let rp: i32 = sa_json_array_push_node(ev, eo);
            let ejb = JsonBuf { bytes: [0u8; 262144], len: 0 };
            jdoc_to_jb(ev, &ejb);
