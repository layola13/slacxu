                        ctx.skipped_large = ctx.skipped_large + 1;
                    } else if state == 2 {
                        ctx.skipped_binary = ctx.skipped_binary + 1;
                    } else if state == 0 {
                        grep_scan_text(ctx, matcher, &text, &rel);
                    };
                };
            };
        };
        ii = ii + 1;
    }
}

fn grep_sort_matches(m: &GrepMatches) -> void {
    let n: u64 = grep_matches_count(m);
    if n < 2 { return; };
    let idx = U64List { items: [0u64; 4096], len: 0 };
    let i: u64 = 0;
    while i < n && idx.len < 4096 {
        idx.items[idx.len] = i;
        idx.len = idx.len + 1;
        i = i + 1;
    }
    let fa = StrBuf { bytes: [0u8; 65536], len: 0 };
    let fb = StrBuf { bytes: [0u8; 65536], len: 0 };
    let x: u64 = 1;
    while x < idx.len {
        let key: u64 = idx.items[x];
        let gk: bool = lb_at(&m.files, key, &fa);
        let y: u64 = x;
        while y > 0 {
            let g2: bool = lb_at(&m.files, idx.items[y - 1], &fb);
            let cmp: i32 = bytes_cmp(&fb, &fa);
            if cmp < 0 { break; };
            if cmp == 0 && m.lines.items[idx.items[y - 1]] <= m.lines.items[key] { break; };
            idx.items[y] = idx.items[y - 1];
            y = y - 1;
        }
        idx.items[y] = key;
        x = x + 1;
    }
    let rebuilt = GrepMatches { files: ListBuf { bytes: [0u8; 131072], len: 0 }, lines: U64List { items: [0u64; 4096], len: 0 }, contents: ListBuf { bytes: [0u8; 131072], len: 0 }, queries: ListBuf { bytes: [0u8; 131072], len: 0 } };
    let fc = StrBuf { bytes: [0u8; 65536], len: 0 };
    let cc = StrBuf { bytes: [0u8; 65536], len: 0 };
    let qc = StrBuf { bytes: [0u8; 65536], len: 0 };
    let k: u64 = 0;
    while k < idx.len {
        let ix: u64 = idx.items[k];
        let g1: bool = lb_at(&m.files, ix, &fc);
        let g2: bool = lb_at(&m.contents, ix, &cc);
        grep_push(&rebuilt, &fc, m.lines.items[ix], &cc);
        if lb_count(&m.queries) > ix {
            let g3: bool = lb_at(&m.queries, ix, &qc);
            lb_append(&rebuilt.queries, sb_ptr(&qc), qc.len);
        };
        k = k + 1;
    }
    *m = rebuilt;
}

