// sa_vm: the mini-agent native tool executor. Mirrors CXU's
// saVmTool.ts: one multiplexed tool whose calls are structured
// ({action, ...}), never a command string. Actions:
//   list_dir  {path}            directory listing as JSON
//   read_file {path}            text file contents
//   find_files {path, pattern}  recursive name search (depth 8)
//   run_host  {exe, args[]}     structured exec, no shell
// Plus read_skill, a separate CXU tool dispatched by name in the
// bridge: read_skill {name} reads <skill root>/<name>/SKILL.md
// from .claude/skills, .agents/skills, ~/.agents/skills,
// ~/.claude/skills (first hit wins).
// Results are plain text in `out` (capped; truncation stated).
@import "sa_std/fs.sai"
@import "sa_std/env.sai"
@import "sa_std/process.sai"
@import "sa_std/io.sai"
@import "sa_std/encoding/json.sai"
@import "sa_std/string.sa"
@import "sa_std/ptr.sa"
@import "helpers.sla"
@import "sa_std/mem.sa"
@import "sa_std/process.sa"

struct SmallBuf {
    bytes: [u8; 4096],
    len: u64,
}

struct PathBuf {
    bytes: [u8; 512],
    len: u64,
}

fn action_is(a_ptr: ptr, a_len: u64, lit_ptr: ptr, lit_len: u64) -> bool {
    let slot = [0u64; 1];
    BYTES_EQ(&slot, a_ptr, a_len, lit_ptr, lit_len);
    return slot[0] == 1;
}

fn out_append_path(out: &ByteBuf, dir: &PathBuf) -> void {
    let i: u64 = 0;
    while i < dir.len {
        if out.len < 40960 {
            out.bytes[out.len] = dir.bytes[i];
            out.len = out.len + 1;
        };
        i = i + 1;
    }
}

fn path_set(pb: &PathBuf, src_ptr: ptr, src_len: u64) -> void {
    pb.len = 0;
    let byte: u8 = 0;
    for i in 0..src_len {
        PTR_BYTE_AT(byte, src_ptr, i);
        if pb.len < 512 {
            pb.bytes[pb.len] = byte;
            pb.len = pb.len + 1;
        };
    }
}

fn path_ensure_slash(pb: &PathBuf) -> void {
    if pb.len > 0 && pb.bytes[pb.len - 1] != 47 {
        if pb.len < 512 {
            pb.bytes[pb.len] = 47;
            pb.len = pb.len + 1;
        };
    };
}

fn path_push_name(pb: &PathBuf, name_ptr: ptr, name_len: u64) -> void {
    if pb.len < 512 {
        pb.bytes[pb.len] = 47;
        pb.len = pb.len + 1;
    };
    let byte: u8 = 0;
    for i in 0..name_len {
        PTR_BYTE_AT(byte, name_ptr, i);
        if pb.len < 512 {
            pb.bytes[pb.len] = byte;
            pb.len = pb.len + 1;
        };
    }
}

// Reads a whole text file (first 4000 bytes) into out.
// Returns true when the file could be opened.
fn read_file_into(path_ptr: ptr, path_len: u64, out: &ByteBuf) -> bool {
    let total: u64 = 0;
    if sa_std_fs_len(path_ptr, path_len, &total) != 0 { return false; };
    let fh: u64 = 0;
    if sa_std_fs_open_read(path_ptr, path_len, &fh) != 0 { return false; };
    let chunk = SmallBuf { bytes: [0u8; 4096], len: 0 };
    let read_n: u64 = 0;
    let rst = sa_std_fs_file_read(fh, &chunk.bytes, 4000, &read_n);
    sa_fs_file_close(fh);
    if rst != 0 { return false; };
    for ci in 0..read_n {
        if out.len < 40960 {
            out.bytes[out.len] = chunk.bytes[ci];
            out.len = out.len + 1;
        };
    }
    if total > read_n {
        buf_append_lit(out, STR_PTR("\n[truncated]"), STR_LEN("\n[truncated]"));
    };
    return true;
}

// PathBuf variant: a struct field address may only be passed to
// externs, never to a plain ptr parameter, so skill-path reads
// go through this wrapper.
fn read_pathbuf_into(pb: &PathBuf, out: &ByteBuf) -> bool {
    let total: u64 = 0;
    if sa_std_fs_len(&pb.bytes, pb.len, &total) != 0 { return false; };
    let fh: u64 = 0;
    if sa_std_fs_open_read(&pb.bytes, pb.len, &fh) != 0 { return false; };
    let chunk = SmallBuf { bytes: [0u8; 4096], len: 0 };
    let read_n: u64 = 0;
    let rst = sa_std_fs_file_read(fh, &chunk.bytes, 4000, &read_n);
    sa_fs_file_close(fh);
    if rst != 0 { return false; };
    for ci in 0..read_n {
        if out.len < 40960 {
            out.bytes[out.len] = chunk.bytes[ci];
            out.len = out.len + 1;
        };
    }
    if total > read_n {
        buf_append_lit(out, STR_PTR("\n[truncated]"), STR_LEN("\n[truncated]"));
    };
    return true;
}

fn walk(dir: &PathBuf, pat_ptr: ptr, pat_len: u64, out: &ByteBuf, depth: u64) -> void {
    let h: u64 = 0;
    if sa_std_fs_read_dir_json(&dir.bytes, dir.len, 200, &h) != 0 { return; };
    let dp: ptr = sa_fs_dir_buffer_data(h);
    let dl = sa_fs_dir_buffer_len(h);
    let doc = sa_json_parse(dp, dl);
    sa_fs_dir_buffer_free(h);
    if doc == 0 { return; };
    let entries: u64 = 0;
    if sa_json_object_get(doc, STR_PTR("entries"), STR_LEN("entries"), &entries) != 0 { return; };
    let idx: u64 = 0;
    while 1 == 1 {
        let el: u64 = 0;
        if sa_json_array_get(entries, idx, &el) != 0 { break; };
        let nm_ptr: ptr = PTR_NULL();
        let nm_len: u64 = 0;
        sa_json_object_get_string(el, STR_PTR("name"), STR_LEN("name"), &nm_ptr, &nm_len);
        let isdir: u64 = 0;
        sa_json_object_get_bool(el, STR_PTR("isDirectory"), STR_LEN("isDirectory"), &isdir);
        if nm_len > 0 {
            let first_byte: u8 = 0;
            PTR_BYTE_AT(first_byte, nm_ptr, 0);
            if first_byte != 46 {
                if bytes_contains(nm_ptr, nm_len, pat_ptr, pat_len) {
                    if out.len < 3900 {
                        out_append_path(out, dir);
                        buf_append_lit(out, STR_PTR("/"), STR_LEN("/"));
                        buf_append_lit(out, nm_ptr, nm_len);
                        buf_append_lit(out, STR_PTR("\n"), STR_LEN("\n"));
                    };
                };
                if isdir != 0 && depth < 8 {
                    let child = PathBuf { bytes: [0u8; 512], len: 0 };
                    for ci in 0..dir.len {
                        child.bytes[ci] = dir.bytes[ci];
                    }
                    child.len = dir.len;
                    path_push_name(&child, nm_ptr, nm_len);
                    walk(&child, pat_ptr, pat_len, out, depth + 1);
                };
            };
        };
        idx = idx + 1;
    }
}

fn run_host(exe_ptr: ptr, exe_len: u64, args_ptr: ptr, args_len: u64, out: &ByteBuf) -> void {
    let argv = [0u64; 14];
    PROCESS_ARGV_SET_PTR(&argv, 0, exe_ptr, exe_len);
    let count: u64 = 1;
    let adoc = sa_json_parse(args_ptr, args_len);
    if adoc != 0 {
        for idx in 0..6 {
            let el: u64 = 0;
            if sa_json_array_get(adoc, idx, &el) != 0 { break; };
            let sp: ptr = sa_json_string_ptr(el);
            let sl = sa_json_string_len(el);
            if idx == 0 { PROCESS_ARGV_SET_PTR(&argv, 1, sp, sl); };
            if idx == 1 { PROCESS_ARGV_SET_PTR(&argv, 2, sp, sl); };
            if idx == 2 { PROCESS_ARGV_SET_PTR(&argv, 3, sp, sl); };
            if idx == 3 { PROCESS_ARGV_SET_PTR(&argv, 4, sp, sl); };
            if idx == 4 { PROCESS_ARGV_SET_PTR(&argv, 5, sp, sl); };
            if idx == 5 { PROCESS_ARGV_SET_PTR(&argv, 6, sp, sl); };
            count = count + 1;
        }
    };
    let proc: ptr = PTR_NULL();
    let hin: ptr = PTR_NULL();
    let hout: ptr = PTR_NULL();
    let herr: ptr = PTR_NULL();
    if sa_std_process_spawn_bidi(&argv, count, &proc, &hin, &hout, &herr) != 0 {
        buf_append_lit(out, STR_PTR("error: spawn failed: "), STR_LEN("error: spawn failed: "));
        buf_append_lit(out, exe_ptr, exe_len);
        return;
    };
    sa_std_close(hin);
    let cap = SmallBuf { bytes: [0u8; 4096], len: 0 };
    let stage = SmallBuf { bytes: [0u8; 4096], len: 0 };
    let guard: u64 = 0;
    while guard < 64 {
        let n: u64 = 0;
        if sa_io_read(hout, &stage.bytes, 2048, &n) != 0 { break; };
        if n == 0 { break; };
        for ci in 0..n {
            if cap.len < 4000 {
                cap.bytes[cap.len] = stage.bytes[ci];
                cap.len = cap.len + 1;
            };
        }
        guard = guard + 1;
    }
    sa_std_close(hout);
    sa_std_close(herr);
    let code: u64 = 0;
    sa_std_process_wait(proc, &code);
    buf_append_lit(out, STR_PTR("exit "), STR_LEN("exit "));
    buf_append_u64(out, code);
    buf_append_lit(out, STR_PTR("\n"), STR_LEN("\n"));
    for oi in 0..cap.len {
        if out.len < 40960 {
            out.bytes[out.len] = cap.bytes[oi];
            out.len = out.len + 1;
        };
    }
}

fn sa_vm_execute(action_ptr: ptr, action_len: u64, path_ptr: ptr, path_len: u64, extra_ptr: ptr, extra_len: u64, out: &ByteBuf) -> void {
    buf_reset(out);
    if action_is(action_ptr, action_len, STR_PTR("list_dir"), STR_LEN("list_dir")) || action_is(action_ptr, action_len, STR_PTR("list"), STR_LEN("list")) {
        let h: u64 = 0;
        if sa_std_fs_read_dir_json(path_ptr, path_len, 200, &h) != 0 {
            buf_append_lit(out, STR_PTR("error: cannot list directory "), STR_LEN("error: cannot list directory "));
            buf_append_lit(out, path_ptr, path_len);
            return;
        };
        let dp: ptr = sa_fs_dir_buffer_data(h);
        let dl = sa_fs_dir_buffer_len(h);
        let take = dl;
        if take > 4000 { take = 4000; };
        buf_append_lit(out, dp, take);
        if dl > 4000 {
            buf_append_lit(out, STR_PTR("\n[truncated]"), STR_LEN("\n[truncated]"));
        };
        sa_fs_dir_buffer_free(h);
        return;
    };
    if action_is(action_ptr, action_len, STR_PTR("read_file"), STR_LEN("read_file")) || action_is(action_ptr, action_len, STR_PTR("read"), STR_LEN("read")) {
        if !read_file_into(path_ptr, path_len, out) {
            buf_reset(out);
            buf_append_lit(out, STR_PTR("error: cannot read: "), STR_LEN("error: cannot read: "));
            buf_append_lit(out, path_ptr, path_len);
        };
        return;
    };
    if action_is(action_ptr, action_len, STR_PTR("find_files"), STR_LEN("find_files")) || action_is(action_ptr, action_len, STR_PTR("find"), STR_LEN("find")) {
        let dir = PathBuf { bytes: [0u8; 512], len: 0 };
        path_set(&dir, path_ptr, path_len);
        // Models often send glob-style patterns ("*bridge*"); the
        // matcher is a substring search, so surrounding '*' are
        // stripped before matching.
        let pat_ptr = extra_ptr;
        let pat_len = extra_len;
        let lead: u64 = 0;
        while lead < pat_len {
            let b0: u8 = 0;
            PTR_BYTE_AT(b0, pat_ptr, lead);
            if b0 != 42 { break; };
            lead = lead + 1;
        }
        if lead > 0 {
            PTR_BYTE_ADD(pat_ptr, pat_ptr, lead);
            pat_len = pat_len - lead;
        };
        while pat_len > 0 {
            let b1: u8 = 0;
            let last_off = pat_len - 1;
            PTR_BYTE_AT(b1, pat_ptr, last_off);
            if b1 != 42 { break; };
            pat_len = pat_len - 1;
        }
        walk(&dir, pat_ptr, pat_len, out, 0);
        if out.len == 0 {
            buf_append_lit(out, STR_PTR("no matches for "), STR_LEN("no matches for "));
            buf_append_lit(out, extra_ptr, extra_len);
            buf_append_lit(out, STR_PTR(" under "), STR_LEN(" under "));
            buf_append_lit(out, path_ptr, path_len);
        };
        return;
    };
    if action_is(action_ptr, action_len, STR_PTR("run_host"), STR_LEN("run_host")) {
        run_host(path_ptr, path_len, extra_ptr, extra_len, out);
        return;
    };
    buf_append_lit(out, STR_PTR("error: unknown action (supported: list_dir, read_file, find_files, run_host)"), STR_LEN("error: unknown action (supported: list_dir, read_file, find_files, run_host)"));
}

// read_skill {name}: first hit wins across the CXU skill roots.
fn read_skill_execute(name_ptr: ptr, name_len: u64, out: &ByteBuf) -> void {
    buf_reset(out);
    if bytes_contains(name_ptr, name_len, STR_PTR("/"), STR_LEN("/")) || bytes_contains(name_ptr, name_len, STR_PTR(".."), STR_LEN("..")) {
        buf_append_lit(out, STR_PTR("error: skill name must be a single segment"), STR_LEN("error: skill name must be a single segment"));
        return;
    };
    // suffix = <name>/SKILL.md; each root prepends its prefix.
    let cand = PathBuf { bytes: [0u8; 512], len: 0 };
    let suffix = PathBuf { bytes: [0u8; 512], len: 0 };
    path_set(&suffix, name_ptr, name_len);
    path_push_name(&suffix, STR_PTR("SKILL.md"), STR_LEN("SKILL.md"));
    // root 1: .claude/skills/<name>/SKILL.md
    path_set(&cand, STR_PTR(".claude/skills/"), STR_LEN(".claude/skills/"));
    path_ensure_slash(&cand);
    for ci in 0..suffix.len {
        if cand.len < 512 {
            cand.bytes[cand.len] = suffix.bytes[ci];
            cand.len = cand.len + 1;
        };
    }
    if read_pathbuf_into(&cand, out) { return; };
    // root 2: .agents/skills/<name>/SKILL.md
    path_set(&cand, STR_PTR(".agents/skills/"), STR_LEN(".agents/skills/"));
    path_ensure_slash(&cand);
    for ci in 0..suffix.len {
        if cand.len < 512 {
            cand.bytes[cand.len] = suffix.bytes[ci];
            cand.len = cand.len + 1;
        };
    }
    if read_pathbuf_into(&cand, out) { return; };
    // HOME roots: ~/.agents/skills then ~/.claude/skills
    let hh = sa_env_get(STR_PTR("HOME"), STR_LEN("HOME"));
    if hh != 0 {
        let hp: ptr = sa_env_buffer_data(hh);
        let hl = sa_env_buffer_len(hh);
        if hl > 0 {
            path_set(&cand, hp, hl);
            path_push_name(&cand, STR_PTR(".agents/skills"), STR_LEN(".agents/skills"));
            path_ensure_slash(&cand);
            for ci in 0..suffix.len {
                if cand.len < 512 {
                    cand.bytes[cand.len] = suffix.bytes[ci];
                    cand.len = cand.len + 1;
                };
            }
            if read_pathbuf_into(&cand, out) { return; };
            path_set(&cand, hp, hl);
            path_push_name(&cand, STR_PTR(".claude/skills"), STR_LEN(".claude/skills"));
            path_ensure_slash(&cand);
            for ci in 0..suffix.len {
                if cand.len < 512 {
                    cand.bytes[cand.len] = suffix.bytes[ci];
                    cand.len = cand.len + 1;
                };
            }
            if read_pathbuf_into(&cand, out) { return; };
        };
    };
    buf_reset(out);
    buf_append_lit(out, STR_PTR("error: skill not found: "), STR_LEN("error: skill not found: "));
    buf_append_lit(out, name_ptr, name_len);
    buf_append_lit(out, STR_PTR(" (searched .claude/skills, .agents/skills, ~/.agents/skills, ~/.claude/skills)"), STR_LEN(" (searched .claude/skills, .agents/skills, ~/.agents/skills, ~/.claude/skills)"));
}
