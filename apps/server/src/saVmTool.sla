// ==== batch 19c3a: dispatcher-support helpers + provider bridges ====

// sb_to_lower is two-arg in the TreeSitter helper layer; in-place form.
fn sb_lower_ip(s: &StrBuf) -> void {
    let t = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_to_lower(s, &t);
    s.len = 0;
    sb_append(s, sb_ptr(&t), t.len);
}

// No sb_to_upper in the helper layer; manual ASCII fold.
fn sb_upper_ip(s: &StrBuf) -> void {
    let i: u64 = 0;
    while i < s.len {
        let b: u8 = s.bytes[i];
        if b >= 97 && b <= 122 { s.bytes[i] = b - 32; };
        i = i + 1;
    }
}

// String(input[key]) when the key is present and non-null.
fn doc_coerce_str(doc: u64, key_ptr: ptr, key_len: u64, out: &StrBuf) -> bool {
    out.len = 0;
    let node: u64 = jget_node(doc, key_ptr, key_len);
    if node == 0 { return false; };
    if sa_json_node_kind(node) == JK_NULL { return false; };
    js_string_coerce(node, out);
    return true;
}

// numOrUndef: finite number, or an integer string.
fn num_or_undef(node: u64, out: &f64) -> bool {
    if node == 0 { return false; };
    let k: u64 = sa_json_node_kind(node);
    if k == JK_INT || k == JK_FLOAT { *out = sa_json_node_as_f64(node); return true; };
    if k == JK_STRING {
        let s = StrBuf { bytes: [0u8; 65536], len: 0 };
        let p: ptr = PTR_NULL();
        let n: u64 = 0;
        let gst: i32 = sa_json_node_string(node, &p, &n);
        sb_append(&s, p, n);
        sb_trim_ip(&s);
        if s.len == 0 { return false; };
        let i: u64 = 0;
        if s.bytes[0] == 45 { i = 1; };
        if i >= s.len { return false; };
        let digits: bool = true;
        while i < s.len {
            let b: u8 = s.bytes[i];
            if b < 48 || b > 57 { digits = false; };
            i = i + 1;
        }
        if !digits { return false; };
        let ok: bool = false;
        let v: i64 = parse_i64_bytes(sb_ptr(&s), s.len, &ok);
        if !ok { return false; };
        *out = v as f64;
        return true;
    };
    return false;
}

// JS Number() coercion over a JSON node (subset): number, string
// (empty -> 0), bool, null -> 0.
fn js_number_coerce(node: u64, out: &f64) -> bool {
    if node == 0 { return false; };
    let k: u64 = sa_json_node_kind(node);
    if k == JK_INT || k == JK_FLOAT { *out = sa_json_node_as_f64(node); return true; };
    if k == JK_BOOL { if sa_json_node_as_bool(node) { *out = 1.0; } else { *out = 0.0; }; return true; };
    if k == JK_NULL { *out = 0.0; return true; };
    if k == JK_STRING {
        let s = StrBuf { bytes: [0u8; 65536], len: 0 };
        let p: ptr = PTR_NULL();
        let n: u64 = 0;
        let gst: i32 = sa_json_node_string(node, &p, &n);
        sb_append(&s, p, n);
        sb_trim_ip(&s);
        if s.len == 0 { *out = 0.0; return true; };
        if !numstr_is_number(&s) { return false; };
        let okf3: bool = false;
        *out = parse_f64_bytes(sb_ptr(&s), s.len, &okf3);
        return true;
    };
    return false;
}

// JS Number(text) acceptance scan (decimal subset with exponent).
fn numstr_is_number(s: &StrBuf) -> bool {
    let i: u64 = 0;
    let n: u64 = s.len;
    if n == 0 { return false; };
    if s.bytes[0] == 43 || s.bytes[0] == 45 { i = 1; };
    let digits: u64 = 0;
    while i < n && s.bytes[i] >= 48 && s.bytes[i] <= 57 { i = i + 1; digits = digits + 1; }
    if i < n && s.bytes[i] == 46 {
        i = i + 1;
        while i < n && s.bytes[i] >= 48 && s.bytes[i] <= 57 { i = i + 1; digits = digits + 1; }
    };
    if digits == 0 { return false; };
    if i < n && (s.bytes[i] == 101 || s.bytes[i] == 69) {
        i = i + 1;
        if i < n && (s.bytes[i] == 43 || s.bytes[i] == 45) { i = i + 1; };
        let ed: u64 = 0;
        while i < n && s.bytes[i] >= 48 && s.bytes[i] <= 57 { i = i + 1; ed = ed + 1; }
        if ed == 0 { return false; };
    };
    return i == n;
}

// Looks-like-a-git-revision heuristics from the dispatcher.
fn git_rev_look(s: &StrBuf) -> bool {
    return re_ci_test(STR_PTR("^(HEAD([~^][0-9]+)?([.]{2,3}.+)?|[0-9a-f]{7,40}([.]{2,3}[0-9a-f]{7,40})?|[A-Za-z0-9_.-]+[.]{2,3}.+)$"), STR_LEN("^(HEAD([~^][0-9]+)?([.]{2,3}.+)?|[0-9a-f]{7,40}([.]{2,3}[0-9a-f]{7,40})?|[A-Za-z0-9_.-]+[.]{2,3}.+)$"), s);
}

fn git_rev_look_narrow(s: &StrBuf) -> bool {
    return re_ci_test(STR_PTR("^(HEAD([~^][0-9]+)?([.]{2,3}.+)?|[0-9a-f]{7,40}([.]{2,3}[0-9a-f]{7,40})?)$"), STR_LEN("^(HEAD([~^][0-9]+)?([.]{2,3}.+)?|[0-9a-f]{7,40}([.]{2,3}[0-9a-f]{7,40})?)$"), s);
}

// Copy input's exclude_dirs (parseExcludeDirs) into an opts doc.
fn set_exclude_dirs(doc: u64, input: &SaVmRunInput) -> void {
    let ex = ByteList { items: [0u8; 4096], len: 0 };
    parseExcludeDirs(input, &ex);
    let arr: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    let ec: u64 = bl_count(&ex);
    let ei: u64 = 0;
    let item = StrBuf { bytes: [0u8; 65536], len: 0 };
    while ei < ec {
        if bl_at(&ex, ei, &item) {
            let ps: i32 = sa_json_array_push_string(arr, sb_ptr(&item), item.len);
        };
        ei = ei + 1;
    }
    jset_node(doc, STR_PTR("exclude_dirs"), STR_LEN("exclude_dirs"), arr);
}

// ---- bun dispatcher helpers ----

fn bun_denied(out: &SaVmRunResult, rule: &StrBuf, reason: &StrBuf, started_at: f64) -> void {
    let full = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_append(&full, STR_PTR("Bun execution denied: "), STR_LEN("Bun execution denied: "));
    sb_append(&full, sb_ptr(reason), reason.len);
    res_denied_rule(out, rule, &full, reason, started_at);
}

fn bun_subcommand_denied(s: &StrBuf) -> bool {
    if sb_eq(s, STR_PTR("install"), STR_LEN("install")) { return true; };
    if sb_eq(s, STR_PTR("i"), STR_LEN("i")) { return true; };
    if sb_eq(s, STR_PTR("add"), STR_LEN("add")) { return true; };
    if sb_eq(s, STR_PTR("a"), STR_LEN("a")) { return true; };
    if sb_eq(s, STR_PTR("remove"), STR_LEN("remove")) { return true; };
    if sb_eq(s, STR_PTR("rm"), STR_LEN("rm")) { return true; };
    if sb_eq(s, STR_PTR("update"), STR_LEN("update")) { return true; };
    if sb_eq(s, STR_PTR("upgrade"), STR_LEN("upgrade")) { return true; };
    if sb_eq(s, STR_PTR("outdated"), STR_LEN("outdated")) { return true; };
    if sb_eq(s, STR_PTR("bunx"), STR_LEN("bunx")) { return true; };
    if sb_eq(s, STR_PTR("x"), STR_LEN("x")) { return true; };
    if sb_eq(s, STR_PTR("init"), STR_LEN("init")) { return true; };
    if sb_eq(s, STR_PTR("create"), STR_LEN("create")) { return true; };
    if sb_eq(s, STR_PTR("deploy"), STR_LEN("deploy")) { return true; };
    if sb_eq(s, STR_PTR("publish"), STR_LEN("publish")) { return true; };
    if sb_eq(s, STR_PTR("login"), STR_LEN("login")) { return true; };
    if sb_eq(s, STR_PTR("logout"), STR_LEN("logout")) { return true; };
    if sb_eq(s, STR_PTR("whoami"), STR_LEN("whoami")) { return true; };
    if sb_eq(s, STR_PTR("link"), STR_LEN("link")) { return true; };
    if sb_eq(s, STR_PTR("unlink"), STR_LEN("unlink")) { return true; };
    if sb_eq(s, STR_PTR("pm"), STR_LEN("pm")) { return true; };
    if sb_eq(s, STR_PTR("patch"), STR_LEN("patch")) { return true; };
    if sb_eq(s, STR_PTR("completions"), STR_LEN("completions")) { return true; };
    if sb_eq(s, STR_PTR("shell"), STR_LEN("shell")) { return true; };
    return false;
}

fn bun_subcommand_allowed(s: &StrBuf) -> bool {
    if sb_eq(s, STR_PTR("test"), STR_LEN("test")) { return true; };
    if sb_eq(s, STR_PTR("run"), STR_LEN("run")) { return true; };
    if sb_eq(s, STR_PTR("build"), STR_LEN("build")) { return true; };
    if sb_eq(s, STR_PTR("--filter"), STR_LEN("--filter")) { return true; };
    if sb_eq(s, STR_PTR("filter"), STR_LEN("filter")) { return true; };
    return false;
}

fn bun_filter_script_allowed(s: &StrBuf) -> bool {
    if sb_eq(s, STR_PTR("typecheck"), STR_LEN("typecheck")) { return true; };
    if sb_eq(s, STR_PTR("build"), STR_LEN("build")) { return true; };
    if sb_eq(s, STR_PTR("test"), STR_LEN("test")) { return true; };
    if sb_eq(s, STR_PTR("lint"), STR_LEN("lint")) { return true; };
