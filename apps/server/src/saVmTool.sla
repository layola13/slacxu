            let w2: i32 = fs_write_all(&full_source, sb_ptr(&new_source), new_source.len);
        };
    };
    let out_sb = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_assign(&out_sb, STR_PTR("[extract_component] "), STR_LEN("[extract_component] "));
