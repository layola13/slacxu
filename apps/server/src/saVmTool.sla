fn ref_escape(s: &StrBuf, out: &StrBuf) -> void {
    out.len = 0;
    let i: u64 = 0;
    while i < s.len {
        let b: u8 = s.bytes[i];
        if b == 46 || b == 42 || b == 43 || b == 63 || b == 94 || b == 36 || b == 123 || b == 125 || b == 40 || b == 41 || b == 124 || b == 91 || b == 93 || b == 92 {
            sb_push_byte(out, 92);
        };
        sb_push_byte(out, b);
        i = i + 1;
    }
}

fn re_handle_test(re: u64, p: ptr, n: u64) -> bool {
    if re == 0 { return false; };
    let m: u64 = sa_regex_match(re, p, n);
    if m == 0 { return false; };
    let rc: i32 = sa_regex_match_free(m);
    return true;
}

