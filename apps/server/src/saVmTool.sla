}

fn bun_build_value_flag(s: &StrBuf) -> bool {
    if sb_eq(s, STR_PTR("--outdir"), STR_LEN("--outdir")) { return true; };
    if sb_eq(s, STR_PTR("--outfile"), STR_LEN("--outfile")) { return true; };
    if sb_eq(s, STR_PTR("--target"), STR_LEN("--target")) { return true; };
    if sb_eq(s, STR_PTR("--format"), STR_LEN("--format")) { return true; };
    if sb_eq(s, STR_PTR("--root"), STR_LEN("--root")) { return true; };
    if sb_eq(s, STR_PTR("--public-path"), STR_LEN("--public-path")) { return true; };
    if sb_eq(s, STR_PTR("--loader"), STR_LEN("--loader")) { return true; };
    if sb_eq(s, STR_PTR("--entry-naming"), STR_LEN("--entry-naming")) { return true; };
    if sb_eq(s, STR_PTR("--chunk-naming"), STR_LEN("--chunk-naming")) { return true; };
    if sb_eq(s, STR_PTR("--asset-naming"), STR_LEN("--asset-naming")) { return true; };
    if sb_eq(s, STR_PTR("--banner"), STR_LEN("--banner")) { return true; };
    if sb_eq(s, STR_PTR("--footer"), STR_LEN("--footer")) { return true; };
