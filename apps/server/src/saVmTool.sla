// apps/server/src/saVmTool.sla — full retranslation of saVmTool.ts.
// Model: _defects/FIX_SAVMTOOL.md (JsonBuf / sa_json path-addressed model).
// Dynamic records are JSON text (JsonBuf) or sa_json doc handles (u64);
// raw policy config is a doc handle (0 = undefined), normalized on demand
// via saVmPolicy.normalizeSaVmPolicy. No block comments (parser rejects).

@import "sa_std/io/print.sai"
@import "sa_std/fs.sai"
@import "sa_std/string.sa"
@import "sa_std/ptr.sa"
@import "sa_std/encoding/json.sai"
@import "sa_std/encoding/base64.sai"
@import "sa_std/text/regex.sai"
@import "sa_std/env.sai"
@import "sa_std/time.sai"
@import "sa_std/fmt.sai"
@import "sa_std/globals.sai"
@import "sa_std/process.sai"
@import "sa_std/process.sa"
@import "sa_std/io.sai"
@import "sa_std/http_client.sai"
@import "../../../sdk-backend/src/saVmTypes.sla"
@import "../../../sdk-backend/src/memoryFilePaths.sla"
@import "../../../backends/vmtool-security/src/security/saVmPolicy.sla"
@import "./saVmTreeSitter.sla"
@import "./saVmCodeGraph.sla"
@import "../../../backends/jev/src/jev/saVmJev.sla"
@import "./saVmRequest.sla"
@import "./saVmApplyPatch.sla"
@import "./saVmSplitWorkflow.sla"
@import "./regressionRunner.sla"
@import "./saVmAccountabilityLedger.sla"

struct JsonBuf { bytes: [u8; 262144], len: u64 }
struct ByteList { items: [u8; 4096], len: u64 }
struct F64List { items: [f64; 4096], len: u64 }
struct ListBuf { bytes: [u8; 131072], len: u64 }
struct RegexHandle { pattern: StrBuf, flags: u64 }
struct PolicyCfg { handle: u64, has_value: bool }

// sa_json_kind codes (empirical probe, _defects/FIX_SAVMTOOL.md S10).
const JK_NULL: u64 = 0;
const JK_BOOL: u64 = 1;
const JK_INT: u64 = 2;
const JK_FLOAT: u64 = 3;
const JK_STRING: u64 = 5;
const JK_ARRAY: u64 = 6;
const JK_OBJECT: u64 = 7;

// RegexHandle.flags bits.
const RE_FLAG_ICASE: u64 = 1;
const RE_FLAG_GLOBAL: u64 = 2;

// ---- buffer base pointers ----
fn sb_ptr(s: &StrBuf) -> ptr { let p: ptr = PTR_NULL(); PTR_BYTE_ADD(p, &s.bytes, 0); return p; }
fn jb_ptr(j: &JsonBuf) -> ptr { let p: ptr = PTR_NULL(); PTR_BYTE_ADD(p, &j.bytes, 0); return p; }
fn lb_ptr(l: &ListBuf) -> ptr { let p: ptr = PTR_NULL(); PTR_BYTE_ADD(p, &l.bytes, 0); return p; }
fn bl_ptr(l: &ByteList) -> ptr { let p: ptr = PTR_NULL(); PTR_BYTE_ADD(p, &l.items, 0); return p; }

fn jb_clear(j: &JsonBuf) -> void { j.len = 0; }
fn lb_clear(l: &ListBuf) -> void { l.len = 0; }

fn jb_append(j: &JsonBuf, src: ptr, n: u64) -> void {
    let i: u64 = 0;
    while i < n {
        if j.len >= 262144 { break; };
        let b: u8 = 0;
        PTR_BYTE_AT(b, src, i);
        j.bytes[j.len] = b;
        j.len = j.len + 1;
        i = i + 1;
    }
}

fn jb_append_sb(j: &JsonBuf, s: &StrBuf) -> void { jb_append(j, sb_ptr(s), s.len); }

fn lb_append(l: &ListBuf, src: ptr, n: u64) -> void {
    let i: u64 = 0;
    while i < n {
        if l.len >= 131072 { break; };
        let b: u8 = 0;
        PTR_BYTE_AT(b, src, i);
        l.bytes[l.len] = b;
        l.len = l.len + 1;
        i = i + 1;
    }
}

fn sb_assign(s: &StrBuf, src: ptr, n: u64) -> void {
    s.len = 0;
    sb_append(s, src, n);
}

fn sb_copy(dst: &StrBuf, src: &StrBuf) -> void { sb_assign(dst, sb_ptr(src), src.len); }

fn jb_assign_sb(j: &JsonBuf, s: &StrBuf) -> void { j.len = 0; jb_append_sb(j, s); }

// ---- sa_json node-access wrappers over the real extern surface ----
// (json.sai has no sa_json_node_* names; these adapt the status-form
// externs to the value-form used across this file.)
fn jstr_ptr(node: u64) -> ptr { let p: ptr = sa_json_string_ptr(node); return p; }
fn sa_json_node_kind(node: u64) -> u64 { return sa_json_kind(node) as u64; }
fn sa_json_node_string(node: u64, out_p: &ptr, out_n: &u64) -> i32 {
    if sa_json_kind(node) != 5 { *out_n = 0; return 1; };
    *out_p = jstr_ptr(node);
    *out_n = sa_json_string_len(node);
    return 0;
}
fn sa_json_node_as_f64(node: u64) -> f64 { let v: f64 = 0.0; let st: i32 = sa_json_as_f64(node, &v); return v; }
fn sa_json_node_as_bool(node: u64) -> bool { let v: bool = false; let st: i32 = sa_json_as_bool(node, &v); return v; }
fn sa_json_node_as_i64(node: u64) -> i64 { let v: i64 = 0; let st: i32 = sa_json_as_i64(node, &v); return v; }
fn sa_json_node_json_text(node: u64, out_p: &ptr, out_n: &u64) -> i32 {
    let h: u64 = 0;
    let st: i32 = sa_json_stringify(node, &h);
    if st != 0 || h == 0 { *out_n = 0; return 1; };
    *out_p = sa_json_buffer_data(h);
    *out_n = sa_json_buffer_len(h);
    return 0;
}

fn sb_push_byte(s: &StrBuf, b: u8) -> void { if s.len < 65536 { s.bytes[s.len] = b; s.len = s.len + 1; }; }
fn jb_push_byte(j: &JsonBuf, b: u8) -> void { if j.len < 262144 { j.bytes[j.len] = b; j.len = j.len + 1; }; }
fn lb_contains(l: &ListBuf, p: ptr, n: u64) -> bool {
    let c: u64 = lb_count(l);
    let i: u64 = 0;
    let item = StrBuf { bytes: [0u8; 65536], len: 0 };
    while i < c {
        if lb_at(l, i, &item) && item.len == n && tool_bytes_eq(sb_ptr(&item), item.len, p, n) { return true; };
        i = i + 1;
    }
    return false;
}
fn jkey_copy(doc: u64, idx: u64, out: &StrBuf) -> bool {
    out.len = 0;
    let kp: ptr = PTR_NULL();
    let kn: u64 = 0;
    let st: i32 = sa_json_object_key_at(doc, idx, &kp, &kn);
    if st != 0 { return false; };
    sb_append(out, kp, kn);
    return true;
}
fn jdoc_of_sb(s: &StrBuf) -> u64 { return sa_json_parse(sb_ptr(s), s.len); }

fn tool_bytes_eq(a: ptr, alen: u64, b: ptr, blen: u64) -> bool {
    if alen != blen { return false; };
    let i: u64 = 0;
    while i < alen {
        let x: u8 = 0;
        let y: u8 = 0;
        PTR_BYTE_AT(x, a, i);
        PTR_BYTE_AT(y, b, i);
        if x != y { return false; };
        i = i + 1;
    }
    return true;
}

fn sb_eq(s: &StrBuf, p: ptr, n: u64) -> bool { return tool_bytes_eq(sb_ptr(s), s.len, p, n); }

fn byte_at(p: ptr, i: u64) -> u8 { let b: u8 = 0; PTR_BYTE_AT(b, p, i); return b; }

fn tool_is_ws_byte(b: u8) -> bool {
    return b == 32 || b == 9 || b == 10 || b == 11 || b == 12 || b == 13;
}

fn sb_starts(s: &StrBuf, p: ptr, n: u64) -> bool {
    if s.len < n { return false; };
    let i: u64 = 0;
    while i < n {
        let x: u8 = 0;
        let y: u8 = 0;
        PTR_BYTE_AT(x, sb_ptr(s), i);
        PTR_BYTE_AT(y, p, i);
        if x != y { return false; };
        i = i + 1;
    }
    return true;
}

fn sb_ends(s: &StrBuf, p: ptr, n: u64) -> bool {
    if s.len < n { return false; };
    let off: u64 = s.len - n;
    let i: u64 = 0;
    while i < n {
        let x: u8 = 0;
        let y: u8 = 0;
        PTR_BYTE_AT(x, sb_ptr(s), off + i);
        PTR_BYTE_AT(y, p, i);
        if x != y { return false; };
        i = i + 1;
    }
    return true;
}

fn bytes_index_of(hay: ptr, hlen: u64, needle: ptr, nlen: u64, from: u64) -> i64 {
    if nlen == 0 { return from as i64; };
    if hlen < nlen { return -1; };
    let last: u64 = hlen - nlen;
    let i: u64 = from;
    while i <= last {
        let ok: bool = true;
        let j: u64 = 0;
        while j < nlen {
            let x: u8 = 0;
            let y: u8 = 0;
            PTR_BYTE_AT(x, hay, i + j);
            PTR_BYTE_AT(y, needle, j);
            if x != y { ok = false; break; };
            j = j + 1;
        }
        if ok { return i as i64; };
        i = i + 1;
    }
    return -1;
}

fn sb_index_of(s: &StrBuf, p: ptr, n: u64) -> i64 {
    return bytes_index_of(sb_ptr(s), s.len, p, n, 0);
}

fn tool_sb_contains(s: &StrBuf, p: ptr, n: u64) -> bool { return sb_index_of(s, p, n) >= 0; }

fn tool_sb_trim(src: &StrBuf, out: &StrBuf) -> void {
    let lo: u64 = 0;
    let hi: u64 = src.len;
    while lo < hi {
        let b: u8 = byte_at(sb_ptr(src), lo);
        if !tool_is_ws_byte(b) { break; };
        lo = lo + 1;
    }
    while hi > lo {
        let b: u8 = byte_at(sb_ptr(src), hi - 1);
        if !tool_is_ws_byte(b) { break; };
        hi = hi - 1;
    }
    out.len = 0;
    let i: u64 = lo;
    while i < hi {
        let b: u8 = byte_at(sb_ptr(src), i);
        out.bytes[out.len] = b;
        out.len = out.len + 1;
        i = i + 1;
    }
}

fn sb_to_lower(src: &StrBuf, out: &StrBuf) -> void {
    out.len = 0;
    let i: u64 = 0;
    while i < src.len {
        let b: u8 = byte_at(sb_ptr(src), i);
        if b >= 65 && b <= 90 { b = b + 32; };
        out.bytes[out.len] = b;
        out.len = out.len + 1;
        i = i + 1;
    }
}

fn sb_eq_ci(s: &StrBuf, p: ptr, n: u64) -> bool {
    if s.len != n { return false; };
    let i: u64 = 0;
    while i < n {
        let x: u8 = byte_at(sb_ptr(s), i);
        let y: u8 = byte_at(p, i);
        if x >= 65 && x <= 90 { x = x + 32; };
        if y >= 65 && y <= 90 { y = y + 32; };
        if x != y { return false; };
        i = i + 1;
    }
    return true;
}

fn sb_replace_all(src: &StrBuf, pat: ptr, plen: u64, rep: ptr, rlen: u64, out: &StrBuf) -> void {
    out.len = 0;
    if plen == 0 { sb_copy(out, src); return; };
    let pos: u64 = 0;
    let sp: ptr = sb_ptr(src);
    while pos < src.len {
        let hit: i64 = bytes_index_of(sp, src.len, pat, plen, pos);
        if hit < 0 {
            let i: u64 = pos;
            while i < src.len {
                out.bytes[out.len] = byte_at(sp, i);
                out.len = out.len + 1;
                i = i + 1;
            }
            pos = src.len;
        } else {
            let h: u64 = hit as u64;
            let i: u64 = pos;
            while i < h {
                out.bytes[out.len] = byte_at(sp, i);
                out.len = out.len + 1;
                i = i + 1;
            }
            let j: u64 = 0;
            while j < rlen {
                out.bytes[out.len] = byte_at(rep, j);
                out.len = out.len + 1;
                j = j + 1;
            }
            pos = h + plen;
        }
    }
}

// ---- numbers ----
fn parse_i64_bytes(p: ptr, n: u64, ok: &bool) -> i64 {
    *ok = false;
    let i: u64 = 0;
    let neg: bool = false;
    if n > 0 && byte_at(p, 0) == 45 { neg = true; i = 1; };
    if i >= n { return 0; };
    let v: i64 = 0;
    while i < n {
        let b: u8 = byte_at(p, i);
        if b < 48 || b > 57 { return 0; };
        v = v * 10 + (b as i64 - 48);
        i = i + 1;
    }
    *ok = true;
    if neg { return 0 - v; };
    return v;
}

fn parse_f64_bytes(p: ptr, n: u64, ok: &bool) -> f64 {
    *ok = false;
    let i: u64 = 0;
    let neg: bool = false;
    if n > 0 && byte_at(p, 0) == 45 { neg = true; i = 1; };
    let v: f64 = 0.0;
    let digits: u64 = 0;
    while i < n {
        let b: u8 = byte_at(p, i);
        if b < 48 || b > 57 { break; };
        v = v * 10.0 + (b as f64 - 48.0);
        digits = digits + 1;
        i = i + 1;
    }
    if i < n && byte_at(p, i) == 46 {
        i = i + 1;
        let scale: f64 = 0.1;
        while i < n {
            let b: u8 = byte_at(p, i);
            if b < 48 || b > 57 { break; };
            v = v + (b as f64 - 48.0) * scale;
            scale = scale * 0.1;
            digits = digits + 1;
            i = i + 1;
        }
    };
    if i < n && (byte_at(p, i) == 101 || byte_at(p, i) == 69) {
        i = i + 1;
        let eneg: bool = false;
        if i < n && byte_at(p, i) == 45 { eneg = true; i = i + 1; };
        if i < n && byte_at(p, i) == 43 { i = i + 1; };
        let e: i64 = 0;
        let edig: u64 = 0;
        while i < n {
            let b: u8 = byte_at(p, i);
            if b < 48 || b > 57 { break; };
            e = e * 10 + (b as i64 - 48);
            edig = edig + 1;
            i = i + 1;
        }
        if edig == 0 { return 0.0; };
        let mult: f64 = 1.0;
        let k: i64 = 0;
        let ae: i64 = e;
        if eneg { ae = 0 - e; };
        if ae > 0 {
            while k < ae { mult = mult * 10.0; k = k + 1; }
            v = v * mult;
        } else {
            while k > ae { mult = mult * 10.0; k = k - 1; }
            v = v / mult;
        }
    };
    if i != n || digits == 0 { return 0.0; };
    *ok = true;
    if neg { return 0.0 - v; };
    return v;
}

fn fmt_i64_sb(v: i64, out: &StrBuf) -> void {
    let n: u64 = 0;
    let rc: i32 = sa_fmt_i64_into(v, 10, sb_ptr(out), 65536, &n);
    out.len = n;
}

fn fmt_u64_sb(v: u64, out: &StrBuf) -> void {
    let n: u64 = 0;
    let rc: i32 = sa_fmt_u64_into(v, 10, sb_ptr(out), 65536, &n);
    out.len = n;
}

// JS-style number formatting: integral values print bare, fractions
// trimmed of trailing zeros (String(number) semantics for the ranges
// this module formats: counts, durations, sizes).
fn fmt_f64_sb(v: f64, out: &StrBuf) -> void {
    let iv: i64 = v as i64;
    if (iv as f64) == v {
        fmt_i64_sb(iv, out);
        return;
    };
    let n: u64 = 0;
    let rc: i32 = sa_fmt_f64_into(v, 6, sb_ptr(out), 65536, &n);
    out.len = n;
    while out.len > 0 {
        let b: u8 = out.bytes[out.len - 1];
        if b == 48 { out.len = out.len - 1; } else {
            if b == 46 { out.len = out.len - 1; };
            break;
        }
    }
}

// ---- sa_json typed access (doc handles; 0 = absent) ----
fn jkind(node: u64) -> u64 { return sa_json_kind(node) as u64; }

fn jdoc_of(ptr_: ptr, n: u64) -> u64 {
    if n == 0 { return 0; };
    return sa_json_parse(ptr_, n);
}

fn jdoc_of_jb(j: &JsonBuf) -> u64 { return jdoc_of(jb_ptr(j), j.len); }

fn jget_node(doc: u64, key: ptr, klen: u64) -> u64 {
    if doc == 0 { return 0; };
    let out: u64 = 0;
    let rc: i32 = sa_json_object_get(doc, key, klen, &out);
    if rc != 0 { return 0; };
    return out;
}

fn jnode_str(node: u64, out: &StrBuf) -> bool {
    if node == 0 { return false; };
    if jkind(node) != JK_STRING { return false; };
    let p: ptr = jstr_ptr(node);
    let n: u64 = sa_json_string_len(node);
    sb_assign(out, p, n);
    return true;
}

fn jget_str(doc: u64, key: ptr, klen: u64, out: &StrBuf) -> bool {
    let node: u64 = jget_node(doc, key, klen);
    if node == 0 { return false; };
    return jnode_str(node, out);
}

fn jget_i64(doc: u64, key: ptr, klen: u64, out: &i64) -> bool {
    if doc == 0 { return false; };
    let rc: i32 = sa_json_object_get_i64(doc, key, klen, out);
    return rc == 0;
}

fn jget_f64(doc: u64, key: ptr, klen: u64, out: &f64) -> bool {
    if doc == 0 { return false; };
    let rc: i32 = sa_json_object_get_f64(doc, key, klen, out);
    if rc == 0 { return true; };
    let iv: i64 = 0;
    rc = sa_json_object_get_i64(doc, key, klen, &iv);
    if rc == 0 { *out = iv as f64; return true; };
    return false;
}

fn jget_bool(doc: u64, key: ptr, klen: u64, out: &bool) -> bool {
    if doc == 0 { return false; };
    let rc: i32 = sa_json_object_get_bool(doc, key, klen, out);
    return rc == 0;
}

fn jnode_i64(node: u64, out: &i64) -> bool {
    if node == 0 { return false; };
    let rc: i32 = sa_json_as_i64(node, out);
    if rc == 0 { return true; };
    let fv: f64 = 0.0;
    rc = sa_json_as_f64(node, &fv);
    if rc == 0 { *out = fv as i64; return true; };
    return false;
}

fn jnode_f64(node: u64, out: &f64) -> bool {
    if node == 0 { return false; };
    return sa_json_as_f64(node, out) == 0;
}

fn jnode_bool(node: u64, out: &bool) -> bool {
    if node == 0 { return false; };
    return sa_json_as_bool(node, out) == 0;
}

fn jset_str(doc: u64, key: ptr, klen: u64, val: ptr, vlen: u64) -> void {
    if doc == 0 { return; };
    let rc: i32 = sa_json_object_set_string(doc, key, klen, val, vlen);
}

fn jset_i64(doc: u64, key: ptr, klen: u64, val: i64) -> void {
    if doc == 0 { return; };
    let rc: i32 = sa_json_object_set_i64(doc, key, klen, val);
}

fn jset_f64(doc: u64, key: ptr, klen: u64, val: f64) -> void {
    if doc == 0 { return; };
    let rc: i32 = sa_json_object_set_f64(doc, key, klen, val);
}

fn jset_bool(doc: u64, key: ptr, klen: u64, val: bool) -> void {
    if doc == 0 { return; };
    let b: u8 = 0;
    if val { b = 1; };
    let rc: i32 = sa_json_object_set_bool(doc, key, klen, b);
}

fn jset_node(doc: u64, key: ptr, klen: u64, child: u64) -> void {
    if doc == 0 { return; };
    let rc: i32 = sa_json_object_set_node(doc, key, klen, child);
}

fn jset_null(doc: u64, key: ptr, klen: u64) -> void {
    if doc == 0 { return; };
    let rc: i32 = sa_json_object_set_null(doc, key, klen);
}

fn jdel(doc: u64, key: ptr, klen: u64) -> void {
    if doc == 0 { return; };
    let rc: i32 = sa_json_object_remove(doc, key, klen);
}

fn jcount(node: u64) -> u64 {
    if node == 0 { return 0; };
    let c: u64 = 0;
    let rc: i32 = sa_json_value_count(node, &c);
    if rc != 0 { return 0; };
    return c;
}

fn jarr_at(node: u64, idx: u64) -> u64 {
    if node == 0 { return 0; };
    let out: u64 = 0;
    let rc: i32 = sa_json_array_get(node, idx, &out);
    if rc != 0 { return 0; };
    return out;
}

fn jdoc_to_jb(doc: u64, out: &JsonBuf) -> void {
    out.len = 0;
    if doc == 0 { return; };
    let buf: u64 = 0;
    let rc: i32 = sa_json_stringify(doc, &buf);
    if rc != 0 || buf == 0 { return; };
    let p: ptr = sa_json_buffer_data(buf);
    let n: u64 = sa_json_buffer_len(buf);
    jb_append(out, p, n);
    let rc2: i32 = sa_json_buffer_free(buf);
}

// ---- SaVmRunInput field access (node = parsed doc of json) ----
fn in_node(input: &SaVmRunInput, key: ptr, klen: u64) -> u64 {
    return jget_node(input.node, key, klen);
}

fn in_str(input: &SaVmRunInput, key: ptr, klen: u64, out: &StrBuf) -> bool {
    let node: u64 = in_node(input, key, klen);
    if node == 0 { return false; };
    return jnode_str(node, out);
}

fn in_kind(input: &SaVmRunInput, key: ptr, klen: u64) -> u64 {
    let node: u64 = in_node(input, key, klen);
    if node == 0 { return 99; };
    return jkind(node);
}

fn in_has(input: &SaVmRunInput, key: ptr, klen: u64) -> bool {
    return in_node(input, key, klen) != 0;
}

fn input_new(json_ptr: ptr, json_len: u64, out: &SaVmRunInput) -> void {
    let i: u64 = 0;
    out.json_len = 0;
    while i < json_len {
        if out.json_len >= 262144 { break; };
        out.json[i] = byte_at(json_ptr, i);
        out.json_len = out.json_len + 1;
        i = i + 1;
    }
    let jp: ptr = PTR_NULL();
    PTR_BYTE_ADD(jp, &out.json, 0);
    out.node = sa_json_parse(jp, out.json_len);
}

fn input_from_jb(j: &JsonBuf, out: &SaVmRunInput) -> void {
    input_new(jb_ptr(j), j.len, out);
}

fn input_resync(input: &SaVmRunInput) -> void {
    let jb = JsonBuf { bytes: [0u8; 262144], len: 0 };
    jdoc_to_jb(input.node, &jb);
    input_new(jb_ptr(&jb), jb.len, input);
}

fn in_set_str(input: &SaVmRunInput, key: ptr, klen: u64, val: ptr, vlen: u64) -> void {
    jset_str(input.node, key, klen, val, vlen);
    input_resync(input);
}

fn in_set_node(input: &SaVmRunInput, key: ptr, klen: u64, child: u64) -> void {
    jset_node(input.node, key, klen, child);
    input_resync(input);
}

// ---- ByteList packing (entries joined by byte 10 in items[]) ----
fn bl_push(l: &ByteList, p: ptr, n: u64) -> void {
    if l.len > 0 {
        if l.len >= 4096 { return; };
        l.items[l.len] = 10;
        l.len = l.len + 1;
    };
    let i: u64 = 0;
    while i < n {
        if l.len >= 4096 { break; };
        l.items[l.len] = byte_at(p, i);
        l.len = l.len + 1;
        i = i + 1;
    }
}

fn bl_push_sb(l: &ByteList, s: &StrBuf) -> void { bl_push(l, sb_ptr(s), s.len); }

fn bl_count(l: &ByteList) -> u64 {
    if l.len == 0 { return 0; };
    let c: u64 = 1;
    let i: u64 = 0;
    while i < l.len {
        if l.items[i] == 10 { c = c + 1; };
        i = i + 1;
    }
    return c;
}

fn bl_at(l: &ByteList, idx: u64, out: &StrBuf) -> bool {
    out.len = 0;
    let cur: u64 = 0;
    let i: u64 = 0;
    let start: u64 = 0;
    while i <= l.len {
        let at_end: bool = i == l.len;
        let is_sep: bool = false;
        if !at_end && l.items[i] == 10 { is_sep = true; };
        if at_end || is_sep {
            if cur == idx {
                let j: u64 = start;
                while j < i {
                    out.bytes[out.len] = l.items[j];
                    out.len = out.len + 1;
                    j = j + 1;
                }
                return true;
            };
            cur = cur + 1;
            start = i + 1;
        };
        i = i + 1;
    }
    return false;
}

fn bl_contains(l: &ByteList, p: ptr, n: u64) -> bool {
    let cnt: u64 = bl_count(l);
    let entry = StrBuf { bytes: [0u8; 65536], len: 0 };
    let i: u64 = 0;
    while i < cnt {
        let got: bool = bl_at(l, i, &entry);
        if got && entry.len == n && tool_bytes_eq(sb_ptr(&entry), entry.len, p, n) { return true; };
        i = i + 1;
    }
    return false;
}

// ---- ListBuf line access (same packing as ByteList) ----
fn lb_count(l: &ListBuf) -> u64 {
    if l.len == 0 { return 0; };
    let c: u64 = 1;
    let i: u64 = 0;
    while i < l.len {
        if l.bytes[i] == 10 { c = c + 1; };
        i = i + 1;
    }
    return c;
}

fn lb_at(l: &ListBuf, idx: u64, out: &StrBuf) -> bool {
    out.len = 0;
    let cur: u64 = 0;
    let i: u64 = 0;
    let start: u64 = 0;
    while i <= l.len {
        let at_end: bool = i == l.len;
        let is_sep: bool = false;
        if !at_end && l.bytes[i] == 10 { is_sep = true; };
        if at_end || is_sep {
            if cur == idx {
                let j: u64 = start;
                while j < i {
                    out.bytes[out.len] = l.bytes[j];
                    out.len = out.len + 1;
                    j = j + 1;
                }
                return true;
            };
            cur = cur + 1;
            start = i + 1;
        };
        i = i + 1;
    }
    return false;
}

// ---- time / result builders ----
fn now_ms() -> f64 { return sa_time_unix_ms() as f64; }

fn dur_since(started_at: f64) -> u64 {
    let d: f64 = now_ms() - started_at;
    if d < 0.0 { return 0; };
    return d as u64;
}

fn res_init(out: &SaVmRunResult) -> void {
    out.ok = false;
    out.kind_len = 0;
    out.has_exitCode = false;
    out.exitCode = 0;
    out.stdout_len = 0;
    out.stderr_len = 0;
    out.saVmEvents_json_len = 0;
    out.has_saVmViolation = false;
    out.saVmViolation_json_len = 0;
    out.durationMs = 0;
    out.has_session_id = false;
    out.session_id_len = 0;
    out.has_sessionId = false;
    out.sessionId_len = 0;
    out.has_pid = false;
    out.pid = 0;
    out.has_status = false;
    out.status_len = 0;
    out.has_message = false;
    out.message_len = 0;
    out.has_commit = false;
    out.commit_len = 0;
    out.has_created = false;
    out.created = false;
}

fn res_set_kind(out: &SaVmRunResult, p: ptr, n: u64) -> void {
    out.kind_len = 0;
    let i: u64 = 0;
    while i < n {
        if out.kind_len >= 32 { break; };
        out.kind[out.kind_len] = byte_at(p, i);
        out.kind_len = out.kind_len + 1;
        i = i + 1;
    }
}

fn res_set_stdout(out: &SaVmRunResult, p: ptr, n: u64) -> void {
    out.stdout_len = 0;
    let i: u64 = 0;
    while i < n {
        if out.stdout_len >= 65536 { break; };
        out.stdout[out.stdout_len] = byte_at(p, i);
        out.stdout_len = out.stdout_len + 1;
        i = i + 1;
    }
}

fn res_set_stderr(out: &SaVmRunResult, p: ptr, n: u64) -> void {
    out.stderr_len = 0;
    let i: u64 = 0;
    while i < n {
        if out.stderr_len >= 65536 { break; };
        out.stderr[out.stderr_len] = byte_at(p, i);
        out.stderr_len = out.stderr_len + 1;
        i = i + 1;
    }
}

fn res_set_events(out: &SaVmRunResult, p: ptr, n: u64) -> void {
    out.saVmEvents_json_len = 0;
    let i: u64 = 0;
    while i < n {
        if out.saVmEvents_json_len >= 65536 { break; };
        out.saVmEvents_json[out.saVmEvents_json_len] = byte_at(p, i);
        out.saVmEvents_json_len = out.saVmEvents_json_len + 1;
        i = i + 1;
    }
}

fn res_err(out: &SaVmRunResult, kind_p: ptr, kind_n: u64, msg_p: ptr, msg_n: u64, started_at: f64) -> void {
    res_init(out);
    out.ok = false;
    res_set_kind(out, kind_p, kind_n);
    res_set_stderr(out, msg_p, msg_n);
    out.durationMs = dur_since(started_at);
}

// InputError result per runSaVmTool top-level catch semantics:
// kind "sa_error", stderr = message.
fn res_input_error(out: &SaVmRunResult, msg_p: ptr, msg_n: u64, started_at: f64) -> void {
    res_err(out, STR_PTR("sa_error"), STR_LEN("sa_error"), msg_p, msg_n, started_at);
}

// ---- POSIX path helpers (path.posix semantics) ----
fn path_is_abs(s: &StrBuf) -> bool {
    return s.len > 0 && s.bytes[0] == 47;
}

fn path_normalize(src: &StrBuf, out: &StrBuf) -> void {
    let abs_: bool = path_is_abs(src);
    let segs = ListBuf { bytes: [0u8; 131072], len: 0 };
    let cur = StrBuf { bytes: [0u8; 65536], len: 0 };
    let i: u64 = 0;
    let sp: ptr = sb_ptr(src);
    while i <= src.len {
        let at_end: bool = i == src.len;
        let is_sep: bool = false;
        if !at_end && byte_at(sp, i) == 47 { is_sep = true; };
        if at_end || is_sep {
            if cur.len == 0 || sb_eq(&cur, STR_PTR("."), STR_LEN(".")) {
                // skip
            } else if sb_eq(&cur, STR_PTR(".."), STR_LEN("..")) {
                let cnt: u64 = lb_count(&segs);
                let popped: bool = false;
                if cnt > 0 {
                    let last = StrBuf { bytes: [0u8; 65536], len: 0 };
                    let got: bool = lb_at(&segs, cnt - 1, &last);
                    if got && !sb_eq(&last, STR_PTR(".."), STR_LEN("..")) {
                        // rebuild segs without last
                        let keep = ListBuf { bytes: [0u8; 131072], len: 0 };
                        let k: u64 = 0;
                        let e = StrBuf { bytes: [0u8; 65536], len: 0 };
                        while k + 1 < cnt {
                            let g2: bool = lb_at(&segs, k, &e);
                            if g2 {
                                if keep.len > 0 { keep.bytes[keep.len] = 10; keep.len = keep.len + 1; };
                                lb_append(&keep, sb_ptr(&e), e.len);
                            };
                            k = k + 1;
                        }
                        segs = keep;
                        popped = true;
                    }
                };
                if !popped && !abs_ {
                    if segs.len > 0 { segs.bytes[segs.len] = 10; segs.len = segs.len + 1; };
                    lb_append(&segs, STR_PTR(".."), STR_LEN(".."));
                }
            } else {
                if segs.len > 0 { segs.bytes[segs.len] = 10; segs.len = segs.len + 1; };
                lb_append(&segs, sb_ptr(&cur), cur.len);
            };
            cur.len = 0;
        } else {
            cur.bytes[cur.len] = byte_at(sp, i);
            cur.len = cur.len + 1;
        };
        i = i + 1;
    }
    out.len = 0;
    if abs_ { out.bytes[out.len] = 47; out.len = out.len + 1; };
    let cnt: u64 = lb_count(&segs);
    let e = StrBuf { bytes: [0u8; 65536], len: 0 };
    let k: u64 = 0;
    while k < cnt {
        let g: bool = lb_at(&segs, k, &e);
        if g {
            if k > 0 { out.bytes[out.len] = 47; out.len = out.len + 1; };
            sb_append(out, sb_ptr(&e), e.len);
        };
        k = k + 1;
    }
    if out.len == 0 {
        if abs_ { out.bytes[0] = 47; out.len = 1; } else { out.bytes[0] = 46; out.len = 1; };
    }
}

fn path_join(a: &StrBuf, b: &StrBuf, out: &StrBuf) -> void {
    if path_is_abs(b) { path_normalize(b, out); return; };
    if a.len == 0 { path_normalize(b, out); return; };
    let joined = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_copy(&joined, a);
    if joined.len == 0 || joined.bytes[joined.len - 1] != 47 {
        joined.bytes[joined.len] = 47;
        joined.len = joined.len + 1;
    };
    sb_append(&joined, sb_ptr(b), b.len);
    path_normalize(&joined, out);
}

fn tool_path_dirname(src: &StrBuf, out: &StrBuf) -> void {
    let t = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_copy(&t, src);
    while t.len > 1 && t.bytes[t.len - 1] == 47 { t.len = t.len - 1; }
    let last: i64 = -1;
    let i: u64 = 0;
    while i < t.len {
        if t.bytes[i] == 47 { last = i as i64; };
        i = i + 1;
    }
    if last < 0 { sb_assign(out, STR_PTR("."), STR_LEN(".")); return; };
    if last == 0 { sb_assign(out, STR_PTR("/"), STR_LEN("/")); return; };
    out.len = 0;
    sb_append(out, sb_ptr(&t), last as u64);
}

fn path_basename(src: &StrBuf, out: &StrBuf) -> void {
    let t = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_copy(&t, src);
    while t.len > 1 && t.bytes[t.len - 1] == 47 { t.len = t.len - 1; }
    let last: i64 = -1;
    let i: u64 = 0;
    while i < t.len {
        if t.bytes[i] == 47 { last = i as i64; };
        i = i + 1;
    }
    out.len = 0;
    let from: u64 = 0;
    if last >= 0 { from = (last as u64) + 1; };
    let j: u64 = from;
    while j < t.len {
        out.bytes[out.len] = t.bytes[j];
        out.len = out.len + 1;
        j = j + 1;
    }
}

fn tool_path_extname(src: &StrBuf, out: &StrBuf) -> bool {
    let base = StrBuf { bytes: [0u8; 65536], len: 0 };
    path_basename(src, &base);
    out.len = 0;
    let last: i64 = -1;
    let i: u64 = 0;
    while i < base.len {
        if base.bytes[i] == 46 { last = i as i64; };
        i = i + 1;
    }
    if last <= 0 { return false; };
    let j: u64 = last as u64;
    while j < base.len {
        out.bytes[out.len] = base.bytes[j];
        out.len = out.len + 1;
        j = j + 1;
    }
    return true;
}

fn path_resolve(cwd: &StrBuf, p: &StrBuf, out: &StrBuf) -> void {
    if path_is_abs(p) { path_normalize(p, out); return; };
    path_join(cwd, p, out);
}

// ---- POSIX ERE regex helpers over text/regex.sai ----
fn re_cflags(flags: u64) -> i32 {
    let f: i32 = 1;
    if (flags & RE_FLAG_ICASE) != 0 { f = f + 2; };
    return f;
}

fn re_find_from(pat: ptr, plen: u64, flags: u64, text: ptr, tlen: u64, from: u64, mstart: &u64, mlen: &u64) -> bool {
    *mstart = 0;
    *mlen = 0;
    if from > tlen { return false; };
    let re: u64 = sa_regex_compile(pat, plen, re_cflags(flags));
    if re == 0 { return false; };
    let tp: ptr = PTR_NULL();
    PTR_BYTE_ADD(tp, text, from);
    let m: u64 = sa_regex_match(re, tp, tlen - from);
    if m == 0 {
        let rc: i32 = sa_regex_free(re);
        return false;
    };
    let s: u64 = sa_regex_group_start(m, 0);
    let l: u64 = sa_regex_group_len(m, 0);
    *mstart = from + s;
    *mlen = l;
    let rc1: i32 = sa_regex_match_free(m);
    let rc2: i32 = sa_regex_free(re);
    return true;
}

fn re_test(pat: ptr, plen: u64, flags: u64, text: ptr, tlen: u64) -> bool {
    let s: u64 = 0;
    let l: u64 = 0;
    return re_find_from(pat, plen, flags, text, tlen, 0, &s, &l);
}

fn re_replace_all(src: &StrBuf, pat: ptr, plen: u64, flags: u64, rep: ptr, rlen: u64, out: &StrBuf) -> void {
    out.len = 0;
    let sp: ptr = sb_ptr(src);
    let pos: u64 = 0;
    let ms: u64 = 0;
    let ml: u64 = 0;
    let guard: u64 = 0;
    while pos <= src.len {
        let hit: bool = re_find_from(pat, plen, flags, sp, src.len, pos, &ms, &ml);
        if !hit { break; };
        let i: u64 = pos;
        while i < ms {
            out.bytes[out.len] = byte_at(sp, i);
            out.len = out.len + 1;
            i = i + 1;
        }
        let j: u64 = 0;
        while j < rlen {
            out.bytes[out.len] = byte_at(rep, j);
            out.len = out.len + 1;
            j = j + 1;
        }
        pos = ms + ml;
        if ml == 0 { pos = pos + 1; };
        guard = guard + 1;
        if guard > 100000 { break; };
        if (flags & RE_FLAG_GLOBAL) == 0 { break; };
    }
    let i: u64 = pos;
    while i < src.len {
        out.bytes[out.len] = byte_at(sp, i);
        out.len = out.len + 1;
        i = i + 1;
    }
}

// ---- module constants (source L245-L262 region, TS top-level lets) ----
const MAX_SOURCE_BYTES: u64 = 524288;
const MAX_STDOUT_BYTES: u64 = 524288;
const MAX_STDERR_BYTES: u64 = 131072;
const DL_FUEL: u64 = 1000000;
const DL_DEADLINE_MS: u64 = 15000;
const DL_MEM_CAP_BYTES: u64 = 134217728;
const DL_MAX_CALL_DEPTH: u64 = 50000;
const LC_FUEL: u64 = 100000000;
const LC_DEADLINE_MS: u64 = 600000;
const LC_MEM_CAP_BYTES: u64 = 1073741824;
const LC_MAX_CALL_DEPTH: u64 = 1000000;
const MAX_ACTIVE_SA_VM_PROCESSES: u64 = 2;

// Build a fresh JSON array node from packed lines (parse "[]" is the
// only array source; no node constructors exist in sa_json).
fn arr_from_lines(lines: &ListBuf) -> u64 {
    let doc: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    if doc == 0 { return 0; };
    let cnt: u64 = lb_count(lines);
    let e = StrBuf { bytes: [0u8; 65536], len: 0 };
    let i: u64 = 0;
    while i < cnt {
        let got: bool = lb_at(lines, i, &e);
        if got {
            let rc: i32 = sa_json_array_push_string(doc, sb_ptr(&e), e.len);
        };
        i = i + 1;
    }
    return doc;
}

fn lines_from_arr_node(node: u64, out: &ListBuf) -> void {
    out.len = 0;
    if node == 0 { return; };
    let cnt: u64 = jcount(node);
    let s = StrBuf { bytes: [0u8; 65536], len: 0 };
    let i: u64 = 0;
    while i < cnt {
        let el: u64 = jarr_at(node, i);
        if el != 0 && jkind(el) == JK_STRING {
            let got: bool = jnode_str(el, &s);
            if got {
                if out.len > 0 { out.bytes[out.len] = 10; out.len = out.len + 1; };
                lb_append(out, sb_ptr(&s), s.len);
            }
        };
        i = i + 1;
    }
}

// TS truthiness for the string fields expand inspects: a value is
// "set" when the node exists, is a string, and is non-empty after no
// transform (raw length). Returns the string when set.
fn in_str_nonempty(input: &SaVmRunInput, key: ptr, klen: u64, out: &StrBuf) -> bool {
    out.len = 0;
    let got: bool = in_str(input, key, klen, out);
    if !got { return false; };
    return out.len > 0;
}

// source L38: expandSaVmActionInput. Returns 0 on success; 1 when the
// TS body throws SaVmInputError (message in err). out starts as a fresh
// reparse of input's JSON (spread semantics: caller's value untouched).
fn expandSaVmActionInput(input: &SaVmRunInput, out: &SaVmRunInput, err: &StrBuf) -> i32 {
    err.len = 0;
    input_new(sb_ptr_from_input(input), input.json_len, out);
    if out.node == 0 { return 0; };
    // parallel coercion: a non-array parallel value goes through
    // normalizeSaVmParallelTasks; failure throws SaVmInputError.
    let pnode: u64 = in_node(out, STR_PTR("parallel"), STR_LEN("parallel"));
    if pnode != 0 && jkind(pnode) != JK_NULL && jkind(pnode) != JK_ARRAY {
        let norm = SaVmParallelNormalization { ok: false, tasks: 0, has_tasks: false, error: [0u8; 1024], error_len: 0 };
        normalizeSaVmParallelTasks(pnode, true, &norm);
        if !norm.ok {
            let ep: ptr = PTR_NULL();
            PTR_BYTE_ADD(ep, &norm.error, 0);
            sb_assign(err, ep, norm.error_len);
            return 1;
        };
        in_set_node(out, STR_PTR("parallel"), STR_LEN("parallel"), norm.tasks);
    };
    // action sniffing
    let action = StrBuf { bytes: [0u8; 65536], len: 0 };
    let raw_action = StrBuf { bytes: [0u8; 65536], len: 0 };
    if in_str(out, STR_PTR("action"), STR_LEN("action"), &raw_action) {
        let trimmed = StrBuf { bytes: [0u8; 65536], len: 0 };
        tool_sb_trim(&raw_action, &trimmed);
        sb_to_lower(&trimmed, &action);
    };
    let has_old: bool = false;
    if in_kind(out, STR_PTR("old_text"), STR_LEN("old_text")) == JK_STRING { has_old = true; };
    if in_kind(out, STR_PTR("oldText"), STR_LEN("oldText")) == JK_STRING { has_old = true; };
    if in_kind(out, STR_PTR("old_string"), STR_LEN("old_string")) == JK_STRING { has_old = true; };
    if in_kind(out, STR_PTR("oldString"), STR_LEN("oldString")) == JK_STRING { has_old = true; };
    if in_kind(out, STR_PTR("old"), STR_LEN("old")) == JK_STRING { has_old = true; };
    let has_body: bool = in_has(out, STR_PTR("content"), STR_LEN("content"))
        || in_has(out, STR_PTR("contents"), STR_LEN("contents"))
        || in_has(out, STR_PTR("text"), STR_LEN("text"))
        || in_has(out, STR_PTR("body"), STR_LEN("body"))
        || in_has(out, STR_PTR("data"), STR_LEN("data"));
    let has_patch: bool = in_kind(out, STR_PTR("patch"), STR_LEN("patch")) == JK_STRING
        || in_kind(out, STR_PTR("diff"), STR_LEN("diff")) == JK_STRING;
    let src_set: bool = in_str_nonempty(out, STR_PTR("source"), STR_LEN("source"), &raw_action);
    let path_s = StrBuf { bytes: [0u8; 65536], len: 0 };
    let path_set: bool = in_str(out, STR_PTR("path"), STR_LEN("path"), &path_s);
    let path_trim = StrBuf { bytes: [0u8; 65536], len: 0 };
    tool_sb_trim(&path_s, &path_trim);
    let has_path: bool = !src_set && path_set && path_trim.len > 0;
    let sniffed = StrBuf { bytes: [0u8; 65536], len: 0 };
    if has_path {
        if has_old { sb_assign(&sniffed, STR_PTR("edit_file"), STR_LEN("edit_file")); }
        else if has_patch { sb_assign(&sniffed, STR_PTR("apply_patch"), STR_LEN("apply_patch")); }
        else if has_body { sb_assign(&sniffed, STR_PTR("write_file"), STR_LEN("write_file")); }
        else { sb_assign(&sniffed, STR_PTR("read_file"), STR_LEN("read_file")); };
    };
    let effective = StrBuf { bytes: [0u8; 65536], len: 0 };
    if action.len > 0 { sb_copy(&effective, &action); } else { sb_copy(&effective, &sniffed); };
    if action.len == 0 && sniffed.len > 0 {
        in_set_str(out, STR_PTR("action"), STR_LEN("action"), sb_ptr(&sniffed), sniffed.len);
    };
    if effective.len == 0 {
        let parr: u64 = in_node(out, STR_PTR("parallel"), STR_LEN("parallel"));
        if parr != 0 && jkind(parr) == JK_ARRAY {
            let cnt: u64 = jcount(parr);
            let new_arr: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
            let i: u64 = 0;
            while i < cnt {
                let el: u64 = jarr_at(parr, i);
                if el != 0 && jkind(el) == JK_OBJECT {
                    let ejb = JsonBuf { bytes: [0u8; 262144], len: 0 };
                    jdoc_to_jb(el, &ejb);
                    let sub_in = SaVmRunInput { json: [0u8; 262144], json_len: 0, node: 0 };
                    input_from_jb(&ejb, &sub_in);
                    let sub_out = SaVmRunInput { json: [0u8; 262144], json_len: 0, node: 0 };
                    let sub_err = StrBuf { bytes: [0u8; 65536], len: 0 };
                    let rc: i32 = expandSaVmActionInput(&sub_in, &sub_out, &sub_err);
                    if rc != 0 { sb_copy(err, &sub_err); return 1; };
                    let sub_node: u64 = sa_json_parse(sb_ptr_from_input(&sub_out), sub_out.json_len);
                    let rc2: i32 = sa_json_array_push_node(new_arr, sub_node);
                } else {
                    let rc3: i32 = sa_json_array_push_node(new_arr, el);
                };
                i = i + 1;
            }
            in_set_node(out, STR_PTR("parallel"), STR_LEN("parallel"), new_arr);
        };
        return 0;
    };
    // alias block: ea recomputed from the (possibly canonicalized) action
    let ea = StrBuf { bytes: [0u8; 65536], len: 0 };
    if in_str(out, STR_PTR("action"), STR_LEN("action"), &raw_action) {
        let trimmed = StrBuf { bytes: [0u8; 65536], len: 0 };
        tool_sb_trim(&raw_action, &trimmed);
        sb_to_lower(&trimmed, &ea);
    };
    if sb_eq(&ea, STR_PTR("read_many"), STR_LEN("read_many")) || sb_eq(&ea, STR_PTR("read_files"), STR_LEN("read_files")) {
        let rc: i32 = expand_alias_read_many(out);
        if rc != 0 { return rc; };
    };
    if sb_eq(&ea, STR_PTR("split_stage"), STR_LEN("split_stage")) || sb_eq(&ea, STR_PTR("split_refine"), STR_LEN("split_refine")) || sb_eq(&ea, STR_PTR("split_repair"), STR_LEN("split_repair")) || sb_eq(&ea, STR_PTR("split_status"), STR_LEN("split_status")) || sb_eq(&ea, STR_PTR("split_plan"), STR_LEN("split_plan")) {
        expand_alias_split(out);
    };
    // packaged native actions: returned untouched
    if sb_eq(&effective, STR_PTR("read_lines"), STR_LEN("read_lines")) { return 0; };
    if sb_eq(&effective, STR_PTR("read_file_tail"), STR_LEN("read_file_tail")) || sb_eq(&effective, STR_PTR("tail_file"), STR_LEN("tail_file")) || sb_eq(&effective, STR_PTR("tail"), STR_LEN("tail")) { return 0; };
    if sb_eq(&effective, STR_PTR("find"), STR_LEN("find")) || sb_eq(&effective, STR_PTR("find_files"), STR_LEN("find_files")) || sb_eq(&effective, STR_PTR("list_files"), STR_LEN("list_files")) { return 0; };
    if sb_eq(&effective, STR_PTR("write"), STR_LEN("write")) || sb_eq(&effective, STR_PTR("write_file"), STR_LEN("write_file")) { return 0; };
    if sb_eq(&effective, STR_PTR("edit"), STR_LEN("edit")) || sb_eq(&effective, STR_PTR("edit_file"), STR_LEN("edit_file")) { return 0; };
    // run_bun normalization
    let is_bun_word: bool = sb_eq(&effective, STR_PTR("bun"), STR_LEN("bun")) || sb_eq(&effective, STR_PTR("exec_bun"), STR_LEN("exec_bun"));
    let bun_ctx: bool = in_kind(out, STR_PTR("subcommand"), STR_LEN("subcommand")) == JK_STRING
        || in_kind(out, STR_PTR("args"), STR_LEN("args")) == JK_ARRAY
        || in_kind(out, STR_PTR("test_file"), STR_LEN("test_file")) == JK_STRING
        || in_kind(out, STR_PTR("filter"), STR_LEN("filter")) == JK_STRING;
    if sb_eq(&effective, STR_PTR("run_bun"), STR_LEN("run_bun")) || (is_bun_word && bun_ctx) {
        return expand_bun(out, err);
    };
    // run_js family
    if sb_eq(&effective, STR_PTR("run_js"), STR_LEN("run_js")) || sb_eq(&effective, STR_PTR("exec_js"), STR_LEN("exec_js")) || sb_eq(&effective, STR_PTR("js"), STR_LEN("js")) || sb_eq(&effective, STR_PTR("javascript"), STR_LEN("javascript")) || sb_eq(&effective, STR_PTR("node"), STR_LEN("node")) || sb_eq(&effective, STR_PTR("bun"), STR_LEN("bun")) || sb_eq(&effective, STR_PTR("run_node"), STR_LEN("run_node")) || sb_eq(&effective, STR_PTR("exec_node"), STR_LEN("exec_node")) || sb_eq(&effective, STR_PTR("exec_bun"), STR_LEN("exec_bun")) || sb_eq(&effective, STR_PTR("eval_js"), STR_LEN("eval_js")) {
        return expand_script_lang(out, &effective, STR_PTR("js"), STR_LEN("js"), err);
    };
    // run_py family
    if sb_eq(&effective, STR_PTR("run_py"), STR_LEN("run_py")) || sb_eq(&effective, STR_PTR("run_python"), STR_LEN("run_python")) || sb_eq(&effective, STR_PTR("exec_py"), STR_LEN("exec_py")) || sb_eq(&effective, STR_PTR("py"), STR_LEN("py")) || sb_eq(&effective, STR_PTR("python"), STR_LEN("python")) {
        return expand_script_lang(out, &effective, STR_PTR("py"), STR_LEN("py"), err);
    };
    if sb_eq(&effective, STR_PTR("run_project_check"), STR_LEN("run_project_check")) || sb_eq(&effective, STR_PTR("project_check"), STR_LEN("project_check")) || sb_eq(&effective, STR_PTR("run_bun_profile"), STR_LEN("run_bun_profile")) {
        in_set_str(out, STR_PTR("action"), STR_LEN("action"), STR_PTR("run_project_check"), STR_LEN("run_project_check"));
        let s = StrBuf { bytes: [0u8; 65536], len: 0 };
        if !in_str_nonempty(out, STR_PTR("source"), STR_LEN("source"), &s) {
            in_set_str(out, STR_PTR("source"), STR_LEN("source"), STR_PTR("// run_project_check"), STR_LEN("// run_project_check"));
        } else {
            in_set_str(out, STR_PTR("source"), STR_LEN("source"), sb_ptr(&s), s.len);
        };
        return 0;
    };
    if sb_eq(&effective, STR_PTR("run_host"), STR_LEN("run_host")) || sb_eq(&effective, STR_PTR("exec_host"), STR_LEN("exec_host")) || sb_eq(&effective, STR_PTR("host"), STR_LEN("host")) {
        in_set_str(out, STR_PTR("action"), STR_LEN("action"), STR_PTR("run_host"), STR_LEN("run_host"));
        return 0;
    };
    return 0;
}

// ptr to an input's raw JSON bytes.
fn sb_ptr_from_input(input: &SaVmRunInput) -> ptr {
    let p: ptr = PTR_NULL();
    PTR_BYTE_ADD(p, &input.json, 0);
    return p;
}

// read_many / read_files files-alias normalization (source L100-125).
fn expand_alias_read_many(out: &SaVmRunInput) -> i32 {
    let files_node: u64 = in_node(out, STR_PTR("files"), STR_LEN("files"));
    if files_node == 0 {
        let cand: u64 = 0;
        let keys = [STR_PTR("paths"), STR_PTR("filenames"), STR_PTR("file_list"), STR_PTR("fileList")];
        let klens = [STR_LEN("paths"), STR_LEN("filenames"), STR_LEN("file_list"), STR_LEN("fileList")];
        let ki: u64 = 0;
        while ki < 4 {
            let n: u64 = in_node(out, keys[ki], klens[ki]);
            if n != 0 && jkind(n) != JK_NULL { cand = n; break; };
            ki = ki + 1;
        }
        if cand != 0 && jkind(cand) == JK_ARRAY {
            in_set_node(out, STR_PTR("files"), STR_LEN("files"), cand);
        } else if cand != 0 && jkind(cand) == JK_STRING {
            let s = StrBuf { bytes: [0u8; 65536], len: 0 };
            let got: bool = jnode_str(cand, &s);
            let t = StrBuf { bytes: [0u8; 65536], len: 0 };
            tool_sb_trim(&s, &t);
            if t.len > 0 {
                let lines = ListBuf { bytes: [0u8; 131072], len: 0 };
                lb_append(&lines, sb_ptr(&t), t.len);
                let arr: u64 = arr_from_lines(&lines);
                in_set_node(out, STR_PTR("files"), STR_LEN("files"), arr);
            }
        } else {
            let s = StrBuf { bytes: [0u8; 65536], len: 0 };
            let t = StrBuf { bytes: [0u8; 65536], len: 0 };
            if in_str(out, STR_PTR("path"), STR_LEN("path"), &s) {
                tool_sb_trim(&s, &t);
                if t.len > 0 {
                    let lines = ListBuf { bytes: [0u8; 131072], len: 0 };
                    lb_append(&lines, sb_ptr(&t), t.len);
                    let arr: u64 = arr_from_lines(&lines);
                    in_set_node(out, STR_PTR("files"), STR_LEN("files"), arr);
                    return 0;
                }
            };
            if in_str(out, STR_PTR("file"), STR_LEN("file"), &s) {
                tool_sb_trim(&s, &t);
                if t.len > 0 {
                    let lines = ListBuf { bytes: [0u8; 131072], len: 0 };
                    lb_append(&lines, sb_ptr(&t), t.len);
                    let arr: u64 = arr_from_lines(&lines);
                    in_set_node(out, STR_PTR("files"), STR_LEN("files"), arr);
                }
            }
        };
        return 0;
    };
    if jkind(files_node) == JK_STRING {
        let s = StrBuf { bytes: [0u8; 65536], len: 0 };
        let got: bool = jnode_str(files_node, &s);
        let t = StrBuf { bytes: [0u8; 65536], len: 0 };
        tool_sb_trim(&s, &t);
        if t.len == 0 {
            let arr: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
            in_set_node(out, STR_PTR("files"), STR_LEN("files"), arr);
            return 0;
        };
        if t.bytes[0] == 91 {
            let parsed: u64 = sa_json_parse(sb_ptr(&t), t.len);
            if parsed != 0 && jkind(parsed) == JK_ARRAY {
                in_set_node(out, STR_PTR("files"), STR_LEN("files"), parsed);
            } else {
                let lines = ListBuf { bytes: [0u8; 131072], len: 0 };
                lb_append(&lines, sb_ptr(&t), t.len);
                let arr: u64 = arr_from_lines(&lines);
                in_set_node(out, STR_PTR("files"), STR_LEN("files"), arr);
            };
            return 0;
        };
        if tool_sb_contains(&t, STR_PTR(","), STR_LEN(",")) {
            let lines = ListBuf { bytes: [0u8; 131072], len: 0 };
            let pos: u64 = 0;
            let tp: ptr = sb_ptr(&t);
            while pos <= t.len {
                let hit: i64 = bytes_index_of(tp, t.len, STR_PTR(","), STR_LEN(","), pos);
                let end: u64 = t.len;
                if hit >= 0 { end = hit as u64; };
                let piece = StrBuf { bytes: [0u8; 65536], len: 0 };
                let i: u64 = pos;
                while i < end {
                    piece.bytes[piece.len] = byte_at(tp, i);
                    piece.len = piece.len + 1;
                    i = i + 1;
                }
                let pt = StrBuf { bytes: [0u8; 65536], len: 0 };
                tool_sb_trim(&piece, &pt);
                if pt.len > 0 {
                    if lines.len > 0 { lines.bytes[lines.len] = 10; lines.len = lines.len + 1; };
                    lb_append(&lines, sb_ptr(&pt), pt.len);
                };
                if hit < 0 { break; };
                pos = (hit as u64) + 1;
            }
            let arr: u64 = arr_from_lines(&lines);
            in_set_node(out, STR_PTR("files"), STR_LEN("files"), arr);
            return 0;
        };
        let lines = ListBuf { bytes: [0u8; 131072], len: 0 };
        lb_append(&lines, sb_ptr(&t), t.len);
        let arr: u64 = arr_from_lines(&lines);
        in_set_node(out, STR_PTR("files"), STR_LEN("files"), arr);
    };
    return 0;
}

// split_* session alias normalization (source L127-135).
fn expand_alias_split(out: &SaVmRunInput) -> void {
    if !in_has(out, STR_PTR("session_id"), STR_LEN("session_id")) {
        let v = StrBuf { bytes: [0u8; 65536], len: 0 };
        if in_str(out, STR_PTR("sessionId"), STR_LEN("sessionId"), &v) {
            in_set_str(out, STR_PTR("session_id"), STR_LEN("session_id"), sb_ptr(&v), v.len);
        }
    };
    if !in_has(out, STR_PTR("module_name"), STR_LEN("module_name")) {
        let v = StrBuf { bytes: [0u8; 65536], len: 0 };
        if in_str(out, STR_PTR("moduleName"), STR_LEN("moduleName"), &v) {
            in_set_str(out, STR_PTR("module_name"), STR_LEN("module_name"), sb_ptr(&v), v.len);
        }
    };
    if !in_has(out, STR_PTR("ops"), STR_LEN("ops")) {
        let tasks: u64 = in_node(out, STR_PTR("tasks"), STR_LEN("tasks"));
        if tasks != 0 && jkind(tasks) == JK_ARRAY {
            in_set_node(out, STR_PTR("ops"), STR_LEN("ops"), tasks);
        }
    };
    if !in_has(out, STR_PTR("path"), STR_LEN("path")) {
        let v = StrBuf { bytes: [0u8; 65536], len: 0 };
        if in_str(out, STR_PTR("file"), STR_LEN("file"), &v) {
            in_set_str(out, STR_PTR("path"), STR_LEN("path"), sb_ptr(&v), v.len);
        }
    }
}

// run_bun subcommand/args normalization (source L170-200).
fn expand_bun(out: &SaVmRunInput, err: &StrBuf) -> i32 {
    let sub = StrBuf { bytes: [0u8; 65536], len: 0 };
    if in_str(out, STR_PTR("subcommand"), STR_LEN("subcommand"), &sub) {
        let t = StrBuf { bytes: [0u8; 65536], len: 0 };
        tool_sb_trim(&sub, &t);
        sb_to_lower(&t, &sub);
    };
    let args = ListBuf { bytes: [0u8; 131072], len: 0 };
    let args_node: u64 = in_node(out, STR_PTR("args"), STR_LEN("args"));
    if args_node != 0 && jkind(args_node) == JK_ARRAY {
        lines_from_arr_node(args_node, &args);
    };
    let filter_s = StrBuf { bytes: [0u8; 65536], len: 0 };
    let has_filter: bool = in_str(out, STR_PTR("filter"), STR_LEN("filter"), &filter_s);
    let filter_t = StrBuf { bytes: [0u8; 65536], len: 0 };
    tool_sb_trim(&filter_s, &filter_t);
    if has_filter && filter_t.len > 0 {
        let named: bool = sub.len > 0 && !sb_eq(&sub, STR_PTR("--filter"), STR_LEN("--filter")) && !sb_eq(&sub, STR_PTR("filter"), STR_LEN("filter"));
        let target = StrBuf { bytes: [0u8; 65536], len: 0 };
        let rest = ListBuf { bytes: [0u8; 131072], len: 0 };
        if named {
            sb_copy(&target, &sub);
            rest.len = 0; lb_append(&rest, lb_ptr(&args), args.len);
        } else {
            let first = StrBuf { bytes: [0u8; 65536], len: 0 };
            if lb_at(&args, 0, &first) { sb_copy(&target, &first); } else { sb_assign(&target, STR_PTR("typecheck"), STR_LEN("typecheck")); };
            let cnt: u64 = lb_count(&args);
            let e = StrBuf { bytes: [0u8; 65536], len: 0 };
            let i: u64 = 1;
            while i < cnt {
                let got: bool = lb_at(&args, i, &e);
                if got {
                    if rest.len > 0 { rest.bytes[rest.len] = 10; rest.len = rest.len + 1; };
                    lb_append(&rest, sb_ptr(&e), e.len);
                };
                i = i + 1;
            }
        };
        sb_assign(&sub, STR_PTR("--filter"), STR_LEN("--filter"));
        args.len = 0;
        lb_append(&args, sb_ptr(&filter_t), filter_t.len);
        args.bytes[args.len] = 10; args.len = args.len + 1;
        lb_append(&args, sb_ptr(&target), target.len);
        let cnt: u64 = lb_count(&rest);
        let e = StrBuf { bytes: [0u8; 65536], len: 0 };
        let i: u64 = 0;
        while i < cnt {
            let got: bool = lb_at(&rest, i, &e);
            if got {
                args.bytes[args.len] = 10; args.len = args.len + 1;
                lb_append(&args, sb_ptr(&e), e.len);
            };
            i = i + 1;
        }
    } else if sub.len == 0 && lb_count(&args) > 0 {
        let first = StrBuf { bytes: [0u8; 65536], len: 0 };
        let got: bool = lb_at(&args, 0, &first);
        sb_to_lower(&first, &sub);
        let rest = ListBuf { bytes: [0u8; 131072], len: 0 };
        let cnt: u64 = lb_count(&args);
        let e = StrBuf { bytes: [0u8; 65536], len: 0 };
        let i: u64 = 1;
        while i < cnt {
            let g2: bool = lb_at(&args, i, &e);
            if g2 {
                if rest.len > 0 { rest.bytes[rest.len] = 10; rest.len = rest.len + 1; };
                lb_append(&rest, sb_ptr(&e), e.len);
            };
            i = i + 1;
        }
        args.len = 0; lb_append(&args, lb_ptr(&rest), rest.len);
    };
    if lb_count(&args) == 0 {
        let cand = StrBuf { bytes: [0u8; 65536], len: 0 };
        let have: bool = in_str(out, STR_PTR("test_file"), STR_LEN("test_file"), &cand);
        let ct = StrBuf { bytes: [0u8; 65536], len: 0 };
        if have { tool_sb_trim(&cand, &ct); };
        if ct.len == 0 {
            let have2: bool = in_str(out, STR_PTR("path"), STR_LEN("path"), &cand);
            ct.len = 0;
            if have2 { tool_sb_trim(&cand, &ct); };
        };
        if ct.len > 0 { lb_append(&args, sb_ptr(&ct), ct.len); };
    };
    in_set_str(out, STR_PTR("action"), STR_LEN("action"), STR_PTR("run_bun"), STR_LEN("run_bun"));
    in_set_str(out, STR_PTR("subcommand"), STR_LEN("subcommand"), sb_ptr(&sub), sub.len);
    let arr: u64 = arr_from_lines(&args);
    in_set_node(out, STR_PTR("args"), STR_LEN("args"), arr);
    return 0;
}

// run_js / run_py shared body (source L203-232): source required.
fn expand_script_lang(out: &SaVmRunInput, effective: &StrBuf, lang_p: ptr, lang_n: u64, err: &StrBuf) -> i32 {
    let source = StrBuf { bytes: [0u8; 65536], len: 0 };
    let have: bool = in_str_nonempty(out, STR_PTR("source"), STR_LEN("source"), &source);
    if !have {
        let have2: bool = in_str_nonempty(out, STR_PTR("content"), STR_LEN("content"), &source);
        if !have2 { source.len = 0; };
    };
    if source.len == 0 {
        err.len = 0;
        sb_append(err, STR_PTR("action '"), STR_LEN("action '"));
        sb_append(err, sb_ptr(effective), effective.len);
        sb_append(err, STR_PTR("' requires 'source' or 'content' code"), STR_LEN("' requires 'source' or 'content' code"));
        return 1;
    };
    in_set_str(out, STR_PTR("language"), STR_LEN("language"), lang_p, lang_n);
    in_set_str(out, STR_PTR("source"), STR_LEN("source"), sb_ptr(&source), source.len);
    return 0;
}

// ---- fs convenience helpers (status codes; 0 = ok) ----
fn fs_read_sb(path: &StrBuf, max_bytes: u64, out: &StrBuf) -> i32 {
    out.len = 0;
    let buf: u64 = 0;
    let rc: i32 = sa_std_fs_read_file(sb_ptr(path), path.len, max_bytes, &buf);
    if rc != 0 { return rc; };
    let p: ptr = sa_fs_read_buffer_data(buf);
    let n: u64 = sa_fs_read_buffer_len(buf);
    sb_append(out, p, n);
    let rc2: i32 = sa_fs_read_buffer_free(buf);
    return 0;
}

fn fs_read_jb(path: &StrBuf, max_bytes: u64, out: &JsonBuf) -> i32 {
    out.len = 0;
    let buf: u64 = 0;
    let rc: i32 = sa_std_fs_read_file(sb_ptr(path), path.len, max_bytes, &buf);
    if rc != 0 { return rc; };
    let p: ptr = sa_fs_read_buffer_data(buf);
    let n: u64 = sa_fs_read_buffer_len(buf);
    jb_append(out, p, n);
    let rc2: i32 = sa_fs_read_buffer_free(buf);
    return 0;
}

fn fs_write_all(path: &StrBuf, data: ptr, n: u64) -> i32 {
    let fh: u64 = 0;
    let rc: i32 = sa_std_fs_open_write(sb_ptr(path), path.len, 1, &fh);
    if rc != 0 { return rc; };
    let written: u64 = 0;
    let rc2: i32 = sa_std_fs_file_write(fh, data, n, &written);
    let rc3: i32 = sa_fs_file_close(fh);
    if rc2 != 0 { return rc2; };
    if written != n { return 1; };
    return 0;
}

fn fs_exists_sb(path: &StrBuf) -> bool {
    return sa_std_fs_exists(sb_ptr(path), path.len) == 0;
}

fn fs_is_dir(path: &StrBuf) -> bool {
    // sa_std_fs_len succeeds for files; directories report via read_dir.
    let entries: u64 = 0;
    let rc: i32 = sa_std_fs_read_dir_entries(sb_ptr(path), path.len, 1, &entries);
    if rc != 0 { return false; };
    let rc2: i32 = sa_fs_dir_entries_free(entries);
    return true;
}

// source L245: resolveTimeoutMs(input, defaultMs = 15000).
fn resolveTimeoutMs(input: &JsonBuf, default_ms: f64) -> f64 {
    if input.len == 0 { return default_ms; };
    let doc: u64 = jdoc_of_jb(input);
    if doc == 0 { return default_ms; };
    let val: f64 = 0.0;
    let have: bool = false;
    let v: f64 = 0.0;
    if jget_f64(doc, STR_PTR("timeout_ms"), STR_LEN("timeout_ms"), &v) {
        if v > 0.0 { val = v; have = true; };
    };
    if !have && jget_f64(doc, STR_PTR("timeout"), STR_LEN("timeout"), &v) {
        if v > 0.0 {
            if v <= 300.0 { val = v * 1000.0; } else { val = v; };
            have = true;
        }
    };
    if !have { return default_ms; };
    let r: f64 = (val + 0.5) as i64 as f64;
    if r < 50.0 { r = 50.0; };
    if r > 300000.0 { r = 300000.0; };
    return r;
}

// ---------------------------------------------------------------------------
// .gitignore-aware exclusion
// ---------------------------------------------------------------------------

// ALWAYS_EXCLUDED_DIRS (source L264): data table as accessor (shared
// precedent: const tables land as hand-written accessors).
fn always_excluded_dir(name: &StrBuf) -> bool {
    if sb_eq(name, STR_PTR("node_modules"), STR_LEN("node_modules")) { return true; };
    if sb_eq(name, STR_PTR(".git"), STR_LEN(".git")) { return true; };
    if sb_eq(name, STR_PTR("dist"), STR_LEN("dist")) { return true; };
    if sb_eq(name, STR_PTR(".turbo"), STR_LEN(".turbo")) { return true; };
    if sb_eq(name, STR_PTR(".vite"), STR_LEN(".vite")) { return true; };
    if sb_eq(name, STR_PTR(".next"), STR_LEN(".next")) { return true; };
    if sb_eq(name, STR_PTR(".nuxt"), STR_LEN(".nuxt")) { return true; };
    if sb_eq(name, STR_PTR("coverage"), STR_LEN("coverage")) { return true; };
    if sb_eq(name, STR_PTR("build"), STR_LEN("build")) { return true; };
    if sb_eq(name, STR_PTR("out"), STR_LEN("out")) { return true; };
    if sb_eq(name, STR_PTR(".cache"), STR_LEN(".cache")) { return true; };
    if sb_eq(name, STR_PTR("__pycache__"), STR_LEN("__pycache__")) { return true; };
    if sb_eq(name, STR_PTR(".tox"), STR_LEN(".tox")) { return true; };
    if sb_eq(name, STR_PTR("target"), STR_LEN("target")) { return true; };
    if sb_eq(name, STR_PTR("release"), STR_LEN("release")) { return true; };
    if sb_eq(name, STR_PTR(".codex"), STR_LEN(".codex")) { return true; };
    if sb_eq(name, STR_PTR(".codex-ultra"), STR_LEN(".codex-ultra")) { return true; };
    return false;
}

// GitIgnoreRule (source L270) compact landing: pattern text packed into
// the owning list's ListBuf (line index = pat_line); the ERE pattern is
// what gitignoreGlobToRegex produces (RegexHandle semantics, flags 0).
struct GitRuleCore {
    negated: bool,
    dir_only: bool,
    has_slash: bool,
    anchored: bool,
    pat_line: u64,
}

struct GitIgnoreRules {
    pats: ListBuf,
    items: [GitRuleCore; 512],
    len: u64,
}

// source L278: gitignoreGlobToRegex — single-scan ERE translation,
// byte-equivalent to the TS replace chain (see FIX_SAVMTOOL S5).
fn gitignoreGlobToRegex(glob: &StrBuf, out: &RegexHandle) -> void {
    out.flags = 0;
    let p: &StrBuf = &out.pattern;
    p.len = 0;
    sb_append(p, STR_PTR("^"), STR_LEN("^"));
    let gp: ptr = sb_ptr(glob);
    let i: u64 = 0;
    while i < glob.len {
        let b: u8 = byte_at(gp, i);
        if b == 42 {
            if i + 1 < glob.len && byte_at(gp, i + 1) == 42 {
                if i + 2 < glob.len && byte_at(gp, i + 2) == 47 {
                    sb_append(p, STR_PTR("(/|/.*/)"), STR_LEN("(/|/.*/)"));
                    i = i + 3;
                } else {
                    sb_append(p, STR_PTR(".*"), STR_LEN(".*"));
                    i = i + 2;
                }
            } else {
                sb_append(p, STR_PTR("[^/]*"), STR_LEN("[^/]*"));
                i = i + 1;
            }
        } else if b == 63 {
            sb_append(p, STR_PTR("[^/]"), STR_LEN("[^/]"));
            i = i + 1;
        } else if b == 46 || b == 43 || b == 94 || b == 36 || b == 123 || b == 125 || b == 40 || b == 41 || b == 124 || b == 91 || b == 93 || b == 92 {
            p.bytes[p.len] = 92;
            p.len = p.len + 1;
            p.bytes[p.len] = b;
            p.len = p.len + 1;
            i = i + 1;
        } else {
            p.bytes[p.len] = b;
            p.len = p.len + 1;
            i = i + 1;
        }
    }
    sb_append(p, STR_PTR("$"), STR_LEN("$"));
}

// source L290: parseGitIgnore.
fn parseGitIgnore(content: &StrBuf, out: &GitIgnoreRules) -> void {
    out.pats.len = 0;
    out.len = 0;
    let cp: ptr = sb_ptr(content);
    let line = StrBuf { bytes: [0u8; 65536], len: 0 };
    let pos: u64 = 0;
    while pos <= content.len {
        let hit: i64 = bytes_index_of(cp, content.len, STR_PTR("\n"), STR_LEN("\n"), pos);
        let end: u64 = content.len;
        if hit >= 0 { end = hit as u64; };
        line.len = 0;
        let i: u64 = pos;
        while i < end {
            line.bytes[line.len] = byte_at(cp, i);
            line.len = line.len + 1;
            i = i + 1;
        }
        parse_gitignore_line(&line, out);
        if hit < 0 { break; };
        pos = (hit as u64) + 1;
    }
}

fn parse_gitignore_line(raw: &StrBuf, out: &GitIgnoreRules) -> void {
    let line = StrBuf { bytes: [0u8; 65536], len: 0 };
    tool_sb_trim(raw, &line);
    if line.len == 0 { return; };
    if line.bytes[0] == 35 { return; };
    let negated: bool = false;
    if line.bytes[0] == 33 {
        negated = true;
        let rest = StrBuf { bytes: [0u8; 65536], len: 0 };
        let i: u64 = 1;
        while i < line.len {
            rest.bytes[rest.len] = line.bytes[i];
            rest.len = rest.len + 1;
            i = i + 1;
        }
        tool_sb_trim(&rest, &line);
        if line.len == 0 { return; };
    };
    let dir_only: bool = false;
    if line.bytes[line.len - 1] == 47 {
        dir_only = true;
        line.len = line.len - 1;
    };
    let has_slash: bool = tool_sb_contains(&line, STR_PTR("/"), STR_LEN("/"));
    let anchored: bool = line.len > 0 && line.bytes[0] == 47;
    if anchored {
        let rest = StrBuf { bytes: [0u8; 65536], len: 0 };
        let i: u64 = 1;
        while i < line.len {
            rest.bytes[rest.len] = line.bytes[i];
            rest.len = rest.len + 1;
            i = i + 1;
        }
        sb_copy(&line, &rest);
    };
    if out.len >= 512 { return; };
    let handle = RegexHandle { pattern: StrBuf { bytes: [0u8; 65536], len: 0 }, flags: 0 };
    gitignoreGlobToRegex(&line, &handle);
    let pat_idx: u64 = lb_count(&out.pats);
    if out.pats.len > 0 { out.pats.bytes[out.pats.len] = 10; out.pats.len = out.pats.len + 1; };
    lb_append(&out.pats, sb_ptr(&handle.pattern), handle.pattern.len);
    out.items[out.len] = GitRuleCore { negated: negated, dir_only: dir_only, has_slash: has_slash, anchored: anchored, pat_line: pat_idx };
    out.len = out.len + 1;
}


fn blob_put_u64(blob: &JsonBuf, v: u64) -> void {
    let tmp = [0u8; 8];
    let x: u64 = v;
    let k: u64 = 8;
    while k > 0 {
        k = k - 1;
        tmp[k] = (x % 256) as u8;
        x = x / 256;
    }
    let i: u64 = 0;
    while i < 8 {
        blob.bytes[blob.len] = tmp[i];
        blob.len = blob.len + 1;
        i = i + 1;
    }
}

fn blob_get_u64(p: ptr, off: u64) -> u64 {
    let v: u64 = 0;
    let i: u64 = 0;
    while i < 8 {
        v = v * 256 + (byte_at(p, off + i) as u64);
        i = i + 1;
    }
    return v;
}

// gitIgnoreCache (source L314): Map<string, GitIgnoreRule[]> lands as a
// single-entry memo in global cells (dir key + serialized rules). The
// memo is behavior-invisible except for staleness under alternating
// dirs, where results stay correct (parse is pure in file content).
fn gitcache_key(dir: &StrBuf, out: &StrBuf) -> void {
    out.len = 0;
    sb_append(out, STR_PTR("savmtool.gitignore."), STR_LEN("savmtool.gitignore."));
    sb_append(out, sb_ptr(dir), dir.len);
}

fn gitcache_load(dir: &StrBuf, out: &GitIgnoreRules) -> bool {
    let key = StrBuf { bytes: [0u8; 65536], len: 0 };
    gitcache_key(dir, &key);
    let blob = JsonBuf { bytes: [0u8; 262144], len: 0 };
    let olen: u64 = 0;
    let rc: i32 = sa_global_bytes_get(sb_ptr(&key), key.len, jb_ptr(&blob), 262144, &olen);
    if rc != 0 || olen == 0 { return false; };
    blob.len = olen;
    // blob layout: [u64 n_rules][n * (u64 flags, u64 pat_line)] then pats bytes
    let bp: ptr = jb_ptr(&blob);
    if olen < 8 { return false; };
    let n: u64 = blob_get_u64(bp, 0);
    if n > 512 { return false; };
    let hdr: u64 = 8 + n * 16;
    if olen < hdr { return false; };
    out.pats.len = 0;
    out.len = 0;
    let i: u64 = 0;
    while i < n {
        let off: u64 = 8 + i * 16;
        let flags: u64 = blob_get_u64(bp, off);
        let pl: u64 = blob_get_u64(bp, off + 8);
        out.items[out.len] = GitRuleCore { negated: (flags & 1) != 0, dir_only: (flags & 2) != 0, has_slash: (flags & 4) != 0, anchored: (flags & 8) != 0, pat_line: pl };
        out.len = out.len + 1;
        i = i + 1;
    }
    out.pats.len = 0;
    let j: u64 = hdr;
    while j < olen {
        out.pats.bytes[out.pats.len] = byte_at(bp, j);
        out.pats.len = out.pats.len + 1;
        j = j + 1;
    }
    return true;
}

fn gitcache_store(dir: &StrBuf, rules: &GitIgnoreRules) -> void {
    let key = StrBuf { bytes: [0u8; 65536], len: 0 };
    gitcache_key(dir, &key);
    let blob = JsonBuf { bytes: [0u8; 262144], len: 0 };
    blob_put_u64(&blob, rules.len);
    let i: u64 = 0;
    while i < rules.len {
        let core: GitRuleCore = rules.items[i];
        let flags: u64 = 0;
        if core.negated { flags = flags + 1; };
        if core.dir_only { flags = flags + 2; };
        if core.has_slash { flags = flags + 4; };
        if core.anchored { flags = flags + 8; };
        blob_put_u64(&blob, flags);
        blob_put_u64(&blob, core.pat_line);
        i = i + 1;
    }
    jb_append(&blob, lb_ptr(&rules.pats), rules.pats.len);
    let rc: i32 = sa_global_bytes_set(sb_ptr(&key), key.len, jb_ptr(&blob), blob.len);
}

// source L316: loadGitIgnoreRules.
fn loadGitIgnoreRules(dir: &StrBuf, out: &GitIgnoreRules) -> void {
    if gitcache_load(dir, out) { return; };
    out.pats.len = 0;
    out.len = 0;
    let path = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_copy(&path, dir);
    if path.len == 0 || path.bytes[path.len - 1] != 47 {
        path.bytes[path.len] = 47;
        path.len = path.len + 1;
    };
    sb_append(&path, STR_PTR(".gitignore"), STR_LEN(".gitignore"));
    let content = StrBuf { bytes: [0u8; 65536], len: 0 };
    let rc: i32 = fs_read_sb(&path, 1048576, &content);
    if rc == 0 {
        parseGitIgnore(&content, out);
    };
    gitcache_store(dir, out);
}

// source L330: isGitIgnored.
fn isGitIgnored(name: &StrBuf, is_dir: bool, rules: &GitIgnoreRules, rel: &StrBuf, has_rel: bool) -> bool {
    if is_dir && always_excluded_dir(name) { return true; };
    let rel_s = StrBuf { bytes: [0u8; 65536], len: 0 };
    if has_rel {
        sb_replace_all(rel, STR_PTR("\\"), STR_LEN("\\"), STR_PTR("/"), STR_LEN("/"), &rel_s);
    } else {
        sb_copy(&rel_s, name);
    };
    let ignored: bool = false;
    let pat = StrBuf { bytes: [0u8; 65536], len: 0 };
    let i: u64 = 0;
    while i < rules.len {
        let core: GitRuleCore = rules.items[i];
        if core.dir_only && !is_dir {
            i = i + 1;
            continue;
        };
        let got: bool = lb_at(&rules.pats, core.pat_line, &pat);
        if got {
            let hit: bool = false;
            if core.has_slash || core.anchored {
                hit = re_test(sb_ptr(&pat), pat.len, 0, sb_ptr(&rel_s), rel_s.len);
            } else {
                hit = re_test(sb_ptr(&pat), pat.len, 0, sb_ptr(name), name.len);
            };
            if hit { ignored = !core.negated; };
        };
        i = i + 1;
    }
    return ignored;
}

// ---------------------------------------------------------------------------
// Large-repo guards shared by list_dir / find_files / grep_search / outline.
// ---------------------------------------------------------------------------

const DEFAULT_SEARCH_MAX_FILE_BYTES: u64 = 524288;
const DEFAULT_SINGLE_FILE_SEARCH_MAX_BYTES: u64 = 4194304;
const DEFAULT_OUTLINE_MAX_FILE_BYTES: u64 = 1048576;
const MAX_SEARCH_MAX_FILE_BYTES: u64 = 20971520;

// source L359: clampInt(value, fallback, min, max); value is a JSON node
// (0 = not a number / absent).
fn clampInt(node: u64, fallback: f64, min: f64, max: f64) -> f64 {
    let num: f64 = fallback;
    if node != 0 && (jkind(node) == JK_INT || jkind(node) == JK_FLOAT) {
        let v: f64 = 0.0;
        if jnode_f64(node, &v) { num = (v as i64) as f64; };
    };
    let r: f64 = num;
    if r < min { r = min; };
    if r > max { r = max; };
    return r;
}

fn clampIntKey(doc: u64, key: ptr, klen: u64, fallback: f64, min: f64, max: f64) -> f64 {
    let node: u64 = jget_node(doc, key, klen);
    return clampInt(node, fallback, min, max);
}


// Tool-side policy adapter over saVmPolicy.checkSaVmPath
// (operation: 0 read, 1 write, 2 delete — saVmPolicy tags).
fn toolCheckPath(policy: &NormalizedSaVmPolicy, op: u32, path: &StrBuf, cwd: &StrBuf, reason: &StrBuf) -> bool {
    let dec = SaVmPolicyDecision { allowed: false, reason: [0u8; 2048], reason_len: 0, path: [0u8; 1024], path_len: 0, path_has: false };
    checkSaVmPath(policy, op, sb_ptr(path), path.len, sb_ptr(cwd), cwd.len, &dec);
    reason.len = 0;
    if dec.reason_len > 0 {
        let rp: ptr = PTR_NULL();
        PTR_BYTE_ADD(rp, &dec.reason, 0);
        sb_append(reason, rp, dec.reason_len);
    };
    return dec.allowed;
}

struct U64List { items: [u64; 4096], len: u64 }

// Directory listing: newline-joined names + parallel kind tags
// (1 regular, 2 directory, 3 symlink, 255 other — sa_std tags).
fn list_dir_names(path: &StrBuf, names: &ListBuf, kinds: &U64List) -> bool {
    names.len = 0;
    kinds.len = 0;
    let entries: u64 = 0;
    if sa_std_fs_read_dir_entries(sb_ptr(path), path.len, 8192, &entries) != 0 { return false; };
    let total: u64 = sa_fs_dir_entries_len(entries);
    let i: u64 = 0;
    while i < total {
        let e: u64 = 0;
        if sa_std_fs_dir_entries_get(entries, i, &e) == 0 {
            let np: ptr = sa_fs_dir_entry_name_ptr(e);
            let nl: u64 = sa_fs_dir_entry_name_len(e);
            if names.len > 0 { names.bytes[names.len] = 10; names.len = names.len + 1; };
            lb_append(names, np, nl);
            if kinds.len < 4096 {
                kinds.items[kinds.len] = sa_fs_dir_entry_kind(e) as u64;
                kinds.len = kinds.len + 1;
            };
            let rcf: i32 = sa_fs_dir_entry_free(e);
        };
        i = i + 1;
    }
    let rc2: i32 = sa_fs_dir_entries_free(entries);
    return true;
}

// path.relative for absolute posix paths (TS path.posix.relative).
fn tool_path_relative(from: &StrBuf, to: &StrBuf, out: &StrBuf) -> void {
    let f = StrBuf { bytes: [0u8; 65536], len: 0 };
    let t = StrBuf { bytes: [0u8; 65536], len: 0 };
    path_normalize(from, &f);
    path_normalize(to, &t);
    if sb_eq(&f, sb_ptr(&t), t.len) { out.len = 0; return; };
    // segment lists
    let fs = ListBuf { bytes: [0u8; 131072], len: 0 };
    let ts = ListBuf { bytes: [0u8; 131072], len: 0 };
    split_sb(&f, 47, &fs);
    split_sb(&t, 47, &ts);
    // drop leading empty segment (root) from both
    let fi: u64 = 0;
    let ti: u64 = 0;
    let fe = StrBuf { bytes: [0u8; 65536], len: 0 };
    let te = StrBuf { bytes: [0u8; 65536], len: 0 };
    if lb_at(&fs, 0, &fe) && fe.len == 0 { fi = 1; };
    if lb_at(&ts, 0, &te) && te.len == 0 { ti = 1; };
    let fc: u64 = lb_count(&fs);
    let tc: u64 = lb_count(&ts);
    while fi < fc && ti < tc {
        let g1: bool = lb_at(&fs, fi, &fe);
        let g2: bool = lb_at(&ts, ti, &te);
        if !g1 || !g2 || !sb_eq(&fe, sb_ptr(&te), te.len) { break; };
        fi = fi + 1;
        ti = ti + 1;
    }
    out.len = 0;
    let k: u64 = fi;
    while k < fc {
        if out.len > 0 { out.bytes[out.len] = 47; out.len = out.len + 1; };
        sb_append(out, STR_PTR(".."), STR_LEN(".."));
        k = k + 1;
    }
    k = ti;
    while k < tc {
        let g: bool = lb_at(&ts, k, &te);
        if g && te.len > 0 {
            if out.len > 0 { out.bytes[out.len] = 47; out.len = out.len + 1; };
            sb_append(out, sb_ptr(&te), te.len);
        };
        k = k + 1;
    }
}

// split bytes on a separator byte into packed lines (empties kept,
// separator becomes the pack newline).
fn split_sb(src: &StrBuf, sep: u8, out: &ListBuf) -> void {
    out.len = 0;
    let i: u64 = 0;
    while i < src.len {
        let b: u8 = src.bytes[i];
        if b == sep { b = 10; };
        out.bytes[out.len] = b;
        out.len = out.len + 1;
        i = i + 1;
    }
}

// ---- pagination (source L372-L434) ----
struct PaginationOpts {
    default_size: f64,
    max_size: f64,
    legacy_limit: f64,
    has_legacy_limit: bool,
}

struct ResolvedPagination {
    page: f64,
    page_size: f64,
    offset: f64,
    paginated: bool,
    exact_total: bool,
    count_cap: f64,
}

struct PaginateMeta {
    total: f64,
    total_pages: f64,
    returned: f64,
    has_next: bool,
    has_prev: bool,
}

fn node_present(doc: u64, key: ptr, klen: u64) -> bool {
    return jget_node(doc, key, klen) != 0;
}

fn node_nonnull(doc: u64, key: ptr, klen: u64) -> u64 {
    let n: u64 = jget_node(doc, key, klen);
    if n == 0 { return 0; };
    if jkind(n) == JK_NULL { return 0; };
    return n;
}

fn node_is_true(doc: u64, key: ptr, klen: u64) -> bool {
    let b: bool = false;
    if jget_bool(doc, key, klen, &b) { return b; };
    return false;
}

fn clamp_f64_val(v: f64, min: f64, max: f64) -> f64 {
    let r: f64 = (v as i64) as f64;
    if r < min { r = min; };
    if r > max { r = max; };
    return r;
}

// source L398: resolvePagination(raw doc, opts).
fn resolvePagination(raw: u64, opts: &PaginationOpts, out: &ResolvedPagination) -> void {
    let has_page: bool = node_present(raw, STR_PTR("page"), STR_LEN("page"))
        || node_present(raw, STR_PTR("page_num"), STR_LEN("page_num"))
        || node_present(raw, STR_PTR("pageNum"), STR_LEN("pageNum"))
        || node_present(raw, STR_PTR("p"), STR_LEN("p"));
    let has_size: bool = node_present(raw, STR_PTR("page_size"), STR_LEN("page_size"))
        || node_present(raw, STR_PTR("pageSize"), STR_LEN("pageSize"))
        || node_present(raw, STR_PTR("per_page"), STR_LEN("per_page"))
        || node_present(raw, STR_PTR("perPage"), STR_LEN("perPage"));
    let off_node: u64 = jget_node(raw, STR_PTR("offset"), STR_LEN("offset"));
    let off_val: f64 = 0.0;
    let has_offset: bool = off_node != 0 && (jkind(off_node) == JK_INT || jkind(off_node) == JK_FLOAT)
        && jnode_f64(off_node, &off_val) && off_val >= 0.0;
    let paginated: bool = has_page || has_size || has_offset;
    let legacy_num: f64 = opts.default_size;
    if opts.has_legacy_limit && opts.legacy_limit > 0.0 {
        legacy_num = (opts.legacy_limit as i64) as f64;
    };
    let size_node: u64 = node_nonnull(raw, STR_PTR("page_size"), STR_LEN("page_size"));
    if size_node == 0 { size_node = node_nonnull(raw, STR_PTR("pageSize"), STR_LEN("pageSize")); };
    if size_node == 0 { size_node = node_nonnull(raw, STR_PTR("per_page"), STR_LEN("per_page")); };
    if size_node == 0 { size_node = node_nonnull(raw, STR_PTR("perPage"), STR_LEN("perPage")); };
    let page_size: f64 = 0.0;
    if size_node != 0 { page_size = clampInt(size_node, opts.default_size, 1.0, opts.max_size); }
    else { page_size = clamp_f64_val(legacy_num, 1.0, opts.max_size); };
    let page_node: u64 = node_nonnull(raw, STR_PTR("page"), STR_LEN("page"));
    if page_node == 0 { page_node = node_nonnull(raw, STR_PTR("page_num"), STR_LEN("page_num")); };
    if page_node == 0 { page_node = node_nonnull(raw, STR_PTR("pageNum"), STR_LEN("pageNum")); };
    if page_node == 0 { page_node = node_nonnull(raw, STR_PTR("p"), STR_LEN("p")); };
    let page: f64 = 1.0;
    if page_node != 0 { page = clampInt(page_node, 1.0, 1.0, 100000.0); };
    let offset: f64 = 0.0;
    if has_offset { offset = (off_val as i64) as f64; }
    else { offset = (page - 1.0) * page_size; };
    let exact_total: bool = node_is_true(raw, STR_PTR("exact_total"), STR_LEN("exact_total"))
        || node_is_true(raw, STR_PTR("exactTotal"), STR_LEN("exactTotal")) || paginated;
    let cap_node: u64 = node_nonnull(raw, STR_PTR("count_cap"), STR_LEN("count_cap"));
    if cap_node == 0 { cap_node = node_nonnull(raw, STR_PTR("countCap"), STR_LEN("countCap")); };
    if cap_node == 0 { cap_node = node_nonnull(raw, STR_PTR("max_total"), STR_LEN("max_total")); };
    let count_cap: f64 = 2000.0;
    if cap_node != 0 { count_cap = clampInt(cap_node, 2000.0, page_size, 10000.0); }
    else { count_cap = clamp_f64_val(2000.0, page_size, 10000.0); };
    out.page = page;
    out.page_size = page_size;
    out.offset = offset;
    out.paginated = paginated;
    out.exact_total = exact_total;
    out.count_cap = count_cap;
}

// source L420: paginateItems for packed line lists.
fn paginateLines(items: &ListBuf, pg: &ResolvedPagination, out: &ListBuf, meta: &PaginateMeta) -> void {
    let total: u64 = lb_count(items);
    meta.total = total as f64;
    if total == 0 { meta.total_pages = 0.0; } else {
        let tp: f64 = (total as f64) / pg.page_size;
        let tpi: i64 = tp as i64;
        if (tpi as f64) < tp { tpi = tpi + 1; };
        meta.total_pages = tpi as f64;
    };
    out.len = 0;
    let start: u64 = pg.offset as u64;
    let end: u64 = start + (pg.page_size as u64);
    let e = StrBuf { bytes: [0u8; 65536], len: 0 };
    let i: u64 = start;
    let returned: u64 = 0;
    while i < end && i < total {
        let got: bool = lb_at(items, i, &e);
        if got {
            if out.len > 0 { out.bytes[out.len] = 10; out.len = out.len + 1; };
            lb_append(out, sb_ptr(&e), e.len);
            returned = returned + 1;
        };
        i = i + 1;
    }
    meta.returned = returned as f64;
    meta.has_next = (pg.offset + pg.page_size) < (total as f64);
    meta.has_prev = pg.offset > 0.0;
}

// source L436: resolveMaxFileBytes(value node, defaultBytes).
fn resolveMaxFileBytes(node: u64, default_bytes: f64) -> f64 {
    if node != 0 && (jkind(node) == JK_INT || jkind(node) == JK_FLOAT) {
        let v: f64 = 0.0;
        if jnode_f64(node, &v) && v > 0.0 {
            let r: f64 = (v as i64) as f64;
            if r < 1024.0 { r = 1024.0; };
            if r > (MAX_SEARCH_MAX_FILE_BYTES as f64) { r = MAX_SEARCH_MAX_FILE_BYTES as f64; };
            return r;
        }
    };
    return default_bytes;
}

// source L443: parseExcludeDirs.
fn parseExcludeDirs(input: &SaVmRunInput, out: &ByteList) -> void {
    parseExcludeDirsDoc(input.node, out);
}

fn parseExcludeDirsDoc(doc: u64, out: &ByteList) -> void {
    out.len = 0;
    let raw: u64 = node_nonnull(doc, STR_PTR("exclude_dirs"), STR_LEN("exclude_dirs"));
    if raw == 0 { raw = node_nonnull(doc, STR_PTR("excludeDirs"), STR_LEN("excludeDirs")); };
    if raw == 0 { raw = node_nonnull(doc, STR_PTR("exclude"), STR_LEN("exclude")); };
    if raw == 0 { return; };
    let list = ListBuf { bytes: [0u8; 131072], len: 0 };
    if jkind(raw) == JK_ARRAY {
        let cnt: u64 = jcount(raw);
        let s = StrBuf { bytes: [0u8; 65536], len: 0 };
        let i: u64 = 0;
        while i < cnt {
            let el: u64 = jarr_at(raw, i);
            if el != 0 {
                if jkind(el) == JK_STRING {
                    let got: bool = jnode_str(el, &s);
                    if got {
                        if list.len > 0 { list.bytes[list.len] = 10; list.len = list.len + 1; };
                        lb_append(&list, sb_ptr(&s), s.len);
                    }
                } else if jkind(el) == JK_INT || jkind(el) == JK_FLOAT {
                    let v: f64 = 0.0;
                    if jnode_f64(el, &v) {
                        fmt_f64_sb(v, &s);
                        if list.len > 0 { list.bytes[list.len] = 10; list.len = list.len + 1; };
                        lb_append(&list, sb_ptr(&s), s.len);
                    }
                } else if jkind(el) == JK_BOOL {
                    let b: bool = false;
                    if jnode_bool(el, &b) {
                        if b { sb_assign(&s, STR_PTR("true"), STR_LEN("true")); } else { sb_assign(&s, STR_PTR("false"), STR_LEN("false")); };
                        if list.len > 0 { list.bytes[list.len] = 10; list.len = list.len + 1; };
                        lb_append(&list, sb_ptr(&s), s.len);
                    }
                }
            };
            i = i + 1;
        }
    } else if jkind(raw) == JK_STRING {
        let s = StrBuf { bytes: [0u8; 65536], len: 0 };
        let got: bool = jnode_str(raw, &s);
        if got { split_sb(&s, 44, &list); };
    } else {
        return;
    };
    // map: trim, backslash -> /, strip leading/trailing slashes; keep non-empty
    let cnt: u64 = lb_count(&list);
    let e = StrBuf { bytes: [0u8; 65536], len: 0 };
    let t = StrBuf { bytes: [0u8; 65536], len: 0 };
    let i: u64 = 0;
    while i < cnt {
        let got: bool = lb_at(&list, i, &e);
        if got {
            tool_sb_trim(&e, &t);
            let bs = StrBuf { bytes: [0u8; 65536], len: 0 };
            sb_replace_all(&t, STR_PTR("\\"), STR_LEN("\\"), STR_PTR("/"), STR_LEN("/"), &bs);
            let lo: u64 = 0;
            let hi: u64 = bs.len;
            while lo < hi && bs.bytes[lo] == 47 { lo = lo + 1; }
            while hi > lo && bs.bytes[hi - 1] == 47 { hi = hi - 1; }
            if hi > lo {
                let fin = StrBuf { bytes: [0u8; 65536], len: 0 };
                let j: u64 = lo;
                while j < hi {
                    fin.bytes[fin.len] = bs.bytes[j];
                    fin.len = fin.len + 1;
                    j = j + 1;
                }
                bl_push(out, sb_ptr(&fin), fin.len);
            }
        };
        i = i + 1;
    }
}

// source L452: isExcludedRelPath.
fn isExcludedRelPath(rel_path: &StrBuf, exclude_dirs: &ByteList) -> bool {
    if exclude_dirs.len == 0 { return false; };
    let rel = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_replace_all(rel_path, STR_PTR("\\"), STR_LEN("\\"), STR_PTR("/"), STR_LEN("/"), &rel);
    let segs = ListBuf { bytes: [0u8; 131072], len: 0 };
    split_sb(&rel, 47, &segs);
    let cnt: u64 = bl_count(exclude_dirs);
    let ex = StrBuf { bytes: [0u8; 65536], len: 0 };
    let i: u64 = 0;
    while i < cnt {
        let got: bool = bl_at(exclude_dirs, i, &ex);
        if got && ex.len > 0 {
            if !tool_sb_contains(&ex, STR_PTR("/"), STR_LEN("/")) {
                let sc: u64 = lb_count(&segs);
                let seg = StrBuf { bytes: [0u8; 65536], len: 0 };
                let j: u64 = 0;
                let found: bool = false;
                while j < sc {
                    let g2: bool = lb_at(&segs, j, &seg);
                    if g2 && sb_eq(&seg, sb_ptr(&ex), ex.len) { found = true; break; };
                    j = j + 1;
                }
                if found { return true; };
            } else {
                if sb_eq(&rel, sb_ptr(&ex), ex.len) { return true; };
                let pref = StrBuf { bytes: [0u8; 65536], len: 0 };
                sb_copy(&pref, &ex);
                pref.bytes[pref.len] = 47;
                pref.len = pref.len + 1;
                if sb_starts(&rel, sb_ptr(&pref), pref.len) { return true; };
            }
        };
        i = i + 1;
    }
    return false;
}

// source L463: loadMergedGitIgnoreRules.
fn loadMergedGitIgnoreRules(cwd: &StrBuf, target_dir: &StrBuf, out: &GitIgnoreRules) -> void {
    loadGitIgnoreRules(cwd, out);
    let resolved_target = StrBuf { bytes: [0u8; 65536], len: 0 };
    if path_is_abs(target_dir) {
        path_normalize(target_dir, &resolved_target);
    } else {
        path_resolve(cwd, target_dir, &resolved_target);
    };
    let resolved_cwd = StrBuf { bytes: [0u8; 65536], len: 0 };
    path_normalize(cwd, &resolved_cwd);
    if sb_eq(&resolved_cwd, sb_ptr(&resolved_target), resolved_target.len) { return; };
    let extra = GitIgnoreRules { pats: ListBuf { bytes: [0u8; 131072], len: 0 }, items: [GitRuleCore { negated: false, dir_only: false, has_slash: false, anchored: false, pat_line: 0 }; 512], len: 0 };
    loadGitIgnoreRules(&resolved_target, &extra);
    if extra.len == 0 { return; };
    let line_base: u64 = lb_count(&out.pats);
    let pat = StrBuf { bytes: [0u8; 65536], len: 0 };
    let i: u64 = 0;
    while i < extra.len {
        if out.len >= 512 { break; };
        let core: GitRuleCore = extra.items[i];
        let new_line: u64 = line_base + core.pat_line;
        out.items[out.len] = GitRuleCore { negated: core.negated, dir_only: core.dir_only, has_slash: core.has_slash, anchored: core.anchored, pat_line: new_line };
        out.len = out.len + 1;
        i = i + 1;
    }
    // append extra pattern lines to out.pats in order
    let pc: u64 = lb_count(&extra.pats);
    let j: u64 = 0;
    while j < pc {
        let got: bool = lb_at(&extra.pats, j, &pat);
        if got {
            if out.pats.len > 0 { out.pats.bytes[out.pats.len] = 10; out.pats.len = out.pats.len + 1; };
            lb_append(&out.pats, sb_ptr(&pat), pat.len);
        };
        j = j + 1;
    }
}

// source L472: containsNulByte.
fn containsNulByte(text: &StrBuf) -> bool {
    let scan: u64 = text.len;
    if scan > 4096 { scan = 4096; };
    let i: u64 = 0;
    while i < scan {
        if text.bytes[i] == 0 { return true; };
        i = i + 1;
    }
    return false;
}

// source L480: readSearchableText. state: 0 = text, 1 = too_large,
// 2 = binary, 3 = empty result (stat/read failure).
fn readSearchableText(full_path: &StrBuf, max_bytes: f64, out: &StrBuf, state: &u64) -> void {
    out.len = 0;
    *state = 3;
    let size: u64 = 0;
    let rc: i32 = sa_std_fs_len(sb_ptr(full_path), full_path.len, &size);
    if rc != 0 { return; };
    if (size as f64) > max_bytes { *state = 1; return; };
    let rc2: i32 = fs_read_sb(full_path, 67108864, out);
    if rc2 != 0 { out.len = 0; return; };
    if containsNulByte(out) { *state = 2; out.len = 0; return; };
    *state = 0;
}

// source L500: hasGlobMagic — /[*?[]/.
fn hasGlobMagic(value: &StrBuf) -> bool {
    let i: u64 = 0;
    while i < value.len {
        let b: u8 = value.bytes[i];
        if b == 42 || b == 63 || b == 91 { return true; };
        i = i + 1;
    }
    return false;
}

// source L504: resolveGlobRoot.
fn resolveGlobRoot(pattern: &StrBuf, cwd: &StrBuf, out: &StrBuf) -> void {
    let normalized = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_replace_all(pattern, STR_PTR("\\"), STR_LEN("\\"), STR_PTR("/"), STR_LEN("/"), &normalized);
    let segs = ListBuf { bytes: [0u8; 131072], len: 0 };
    split_sb(&normalized, 47, &segs);
    let cnt: u64 = lb_count(&segs);
    let seg = StrBuf { bytes: [0u8; 65536], len: 0 };
    let first_magic: i64 = -1;
    let i: u64 = 0;
    while i < cnt {
        let got: bool = lb_at(&segs, i, &seg);
        if got && hasGlobMagic(&seg) { first_magic = i as i64; break; };
        i = i + 1;
    }
    if first_magic < 0 {
        path_resolve(cwd, pattern, out);
        return;
    };
    let prefix = StrBuf { bytes: [0u8; 65536], len: 0 };
    let j: u64 = 0;
    while j < (first_magic as u64) {
        let got: bool = lb_at(&segs, j, &seg);
        if got {
            if j > 0 { prefix.bytes[prefix.len] = 47; prefix.len = prefix.len + 1; };
            sb_append(&prefix, sb_ptr(&seg), seg.len);
        };
        j = j + 1;
    }
    if path_is_abs(pattern) {
        let root = StrBuf { bytes: [0u8; 65536], len: 0 };
        if prefix.len > 0 {
            sb_copy(&root, &prefix);
        } else {
            let k: u64 = 0;
            while k < cnt && k < 3 {
                let got: bool = lb_at(&segs, k, &seg);
                if got {
                    if k > 0 { root.bytes[root.len] = 47; root.len = root.len + 1; };
                    sb_append(&root, sb_ptr(&seg), seg.len);
                };
                k = k + 1;
            }
        };
        if root.len == 0 {
            path_normalize(cwd, out);
        } else {
            path_normalize(&root, out);
        };
        return;
    };
    if prefix.len == 0 {
        path_normalize(cwd, out);
    } else {
        path_resolve(cwd, &prefix, out);
    }
}

// source L517: expandCandidateFileGlob — BFS over root collecting files
// whose path matches the glob regex and passes the read policy check.
fn expandCandidateFileGlob(pattern: &StrBuf, cwd: &StrBuf, policy: &NormalizedSaVmPolicy, started_at: f64, timeout_ms: f64, out: &ByteList) -> void {
    out.len = 0;
    let normalized = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_replace_all(pattern, STR_PTR("\\"), STR_LEN("\\"), STR_PTR("/"), STR_LEN("/"), &normalized);
    let absolute_pattern: bool = path_is_abs(pattern);
    let glob_src = StrBuf { bytes: [0u8; 65536], len: 0 };
    if absolute_pattern {
        sb_copy(&glob_src, &normalized);
    } else {
        // strip leading "./"
        if sb_starts(&normalized, STR_PTR("./"), STR_LEN("./")) {
            let i: u64 = 2;
            while i < normalized.len {
                glob_src.bytes[glob_src.len] = normalized.bytes[i];
                glob_src.len = glob_src.len + 1;
                i = i + 1;
            }
        } else {
            sb_copy(&glob_src, &normalized);
        }
    };
    let handle = RegexHandle { pattern: StrBuf { bytes: [0u8; 65536], len: 0 }, flags: 0 };
    gitignoreGlobToRegex(&glob_src, &handle);
    let root = StrBuf { bytes: [0u8; 65536], len: 0 };
    resolveGlobRoot(pattern, cwd, &root);
    let reason = StrBuf { bytes: [0u8; 65536], len: 0 };
    if !toolCheckPath(policy, 0, &root, cwd, &reason) { return; };
    let rules = GitIgnoreRules { pats: ListBuf { bytes: [0u8; 131072], len: 0 }, items: [GitRuleCore { negated: false, dir_only: false, has_slash: false, anchored: false, pat_line: 0 }; 512], len: 0 };
    loadGitIgnoreRules(cwd, &rules);
    // BFS queue of directory paths, packed lines.
    let queue = ListBuf { bytes: [0u8; 131072], len: 0 };
    lb_append(&queue, sb_ptr(&root), root.len);
    let qhead: u64 = 0;
    let current = StrBuf { bytes: [0u8; 65536], len: 0 };
    let names = ListBuf { bytes: [0u8; 131072], len: 0 };
    let kinds = U64List { items: [0u64; 4096], len: 0 };
    while qhead < lb_count(&queue) {
        if bl_count(out) >= 2000 { break; };
        if now_ms() - started_at > timeout_ms { break; };
        let got_q: bool = lb_at(&queue, qhead, &current);
        qhead = qhead + 1;
        if !got_q { continue; };
        if !list_dir_names(&current, &names, &kinds) { continue; };
        let cnt: u64 = lb_count(&names);
        let name = StrBuf { bytes: [0u8; 65536], len: 0 };
        let i: u64 = 0;
        while i < cnt {
            if bl_count(out) >= 2000 { break; };
            if now_ms() - started_at > timeout_ms { break; };
            let got: bool = lb_at(&names, i, &name);
            if got {
                let full = StrBuf { bytes: [0u8; 65536], len: 0 };
                path_join(&current, &name, &full);
                let rel = StrBuf { bytes: [0u8; 65536], len: 0 };
                tool_path_relative(cwd, &full, &rel);
                let kind: u64 = kinds.items[i];
                let is_dir: bool = kind == 2;
                if !isGitIgnored(&name, is_dir, &rules, &rel, true) {
                    if is_dir {
                        if queue.len > 0 { queue.bytes[queue.len] = 10; queue.len = queue.len + 1; };
                        lb_append(&queue, sb_ptr(&full), full.len);
                    } else if kind == 1 {
                        let target = StrBuf { bytes: [0u8; 65536], len: 0 };
                        if absolute_pattern {
                            sb_replace_all(&full, STR_PTR("\\"), STR_LEN("\\"), STR_PTR("/"), STR_LEN("/"), &target);
                        } else {
                            sb_copy(&target, &rel);
                        };
                        if re_test(sb_ptr(&handle.pattern), handle.pattern.len, handle.flags, sb_ptr(&target), target.len) {
                            let r2 = StrBuf { bytes: [0u8; 65536], len: 0 };
                            if toolCheckPath(policy, 0, &full, cwd, &r2) {
                                bl_push(out, sb_ptr(&full), full.len);
                            }
                        }
                    }
                }
            };
            i = i + 1;
        }
    }
}

const MAX_WAITING_SA_VM_TASKS: u64 = 64;
const SA_VM_STALE_TEMP_MS: u64 = 3600000;

fn norm_policy_zero(out: &NormalizedSaVmPolicy) -> void {
    *out = NormalizedSaVmPolicy { engine: 0, fs: NormalizedFs { entries: FsEntryList { items: [SaVmFsEntry { path: [0u8; 1024], path_len: 0, access: 0 }; 128], len: 0 }, read: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, write: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, transfer: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, delete: 0, backupDir: [0u8; 1024], backupDir_len: 0, backupDir_has: false }, http_allow: HttpRuleList { items: [SaVmHttpAllowRule { host: [0u8; 512], host_len: 0, methods: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_methods: false, paths: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_paths: false }; 128], len: 0 }, env_allow: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, process: NormalizedProcess { spawn: false, exec: ExecRuleList { items: [SaVmProcessExecRule { path: [0u8; 4096], path_len: 0, args: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_args: false }; 128], len: 0 }, bunProfiles: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_bunProfiles: false, bun_enabled: false, bun_allowedSubcommands: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_bun: false }, execution_javascript: false, execution_python: false, tools: NormalizedTools { replaceRead: false, replaceWrite: false, replaceApplyPatch: false, replaceExec: false, readFiles: false, editFiles: false, applyPatch: false, fastSearch: false, clearToolHistory: false, findReferences: false, renameSymbol: false, fileOutline: false, moveWithImports: false, findDefinition: false, extractToFile: false, addImport: false, getDiagnostics: false, organizeImports: false, analyzeScope: false, codeGraph: false }, contextSavings: SaVmContextSavingsConfig { locateBeforeRead: false, maxReadFileBytes: 0, maxReadFileBytes_has: false, grepCircuitBreaker: false, grepMaxResults: 0, grepMaxResults_has: false, grepMaxTokens: 0, grepMaxTokens_has: false, slimRunnerOutput: false, parallelBudget: false, parallelMaxTotalBytes: 0, parallelMaxTotalBytes_has: false, parallelMaxReadFiles: 0, parallelMaxReadFiles_has: false, parallelDeduplication: false, tieredSkillInjection: false, foldWaterfallEvents: false, foldHistoryReadSummaries: false, historyReadFoldTurns: 0, historyReadFoldTurns_has: false }, contextSavings_has: false };
}
// ---- AsyncSemaphore (source L568) ----
// TS: class with active count + promise waiter queue, single global
// instance saVmProcessSemaphore. Landing: state in global cells;
// acquire blocks (sleep-poll) like the TS promise wait; release hands
// the slot to a waiter when one is queued (active unchanged), else
// decrements active. Busy error at MAX_WAITING_SA_VM_TASKS waiters.
fn sem_cell_get(name_p: ptr, name_n: u64) -> u64 {
    let v: u64 = 0;
    let rc: i32 = sa_global_u64_get(name_p, name_n, &v);
    if rc != 0 { return 0; };
    return v;
}

fn sem_cell_add(name_p: ptr, name_n: u64, delta: i64) -> u64 {
    let v: u64 = 0;
    let rc: i32 = sa_global_u64_add(name_p, name_n, delta, &v);
    return v;
}

fn sem_acquire(err: &StrBuf) -> i32 {
    err.len = 0;
    let waited: bool = false;
    while true {
        let handoffs: u64 = sem_cell_get(STR_PTR("savmtool.sem.handoffs"), STR_LEN("savmtool.sem.handoffs"));
        if waited && handoffs > 0 {
            sem_cell_add(STR_PTR("savmtool.sem.handoffs"), STR_LEN("savmtool.sem.handoffs"), 0 - 1);
            sem_cell_add(STR_PTR("savmtool.sem.waiters"), STR_LEN("savmtool.sem.waiters"), 0 - 1);
            return 0;
        };
        let active: u64 = sem_cell_get(STR_PTR("savmtool.sem.active"), STR_LEN("savmtool.sem.active"));
        if active < MAX_ACTIVE_SA_VM_PROCESSES {
            if waited {
                sem_cell_add(STR_PTR("savmtool.sem.waiters"), STR_LEN("savmtool.sem.waiters"), 0 - 1);
            };
            sem_cell_add(STR_PTR("savmtool.sem.active"), STR_LEN("savmtool.sem.active"), 1);
            return 0;
        };
        if !waited {
            let w: u64 = sem_cell_get(STR_PTR("savmtool.sem.waiters"), STR_LEN("savmtool.sem.waiters"));
            if w >= MAX_WAITING_SA_VM_TASKS {
                sb_assign(err, STR_PTR("SA-VM is busy; wait for an active VM task to finish"), STR_LEN("SA-VM is busy; wait for an active VM task to finish"));
                return 1;
            };
            sem_cell_add(STR_PTR("savmtool.sem.waiters"), STR_LEN("savmtool.sem.waiters"), 1);
            waited = true;
        };
        let rc: i32 = sa_time_sleep_ms(5);
    }
    return 0;
}

fn sem_release() -> void {
    let w: u64 = sem_cell_get(STR_PTR("savmtool.sem.waiters"), STR_LEN("savmtool.sem.waiters"));
    if w > 0 {
        let r1: u64 = sem_cell_add(STR_PTR("savmtool.sem.handoffs"), STR_LEN("savmtool.sem.handoffs"), 1);
    } else {
        let a: u64 = sem_cell_get(STR_PTR("savmtool.sem.active"), STR_LEN("savmtool.sem.active"));
        if a > 0 {
            let r2: u64 = sem_cell_add(STR_PTR("savmtool.sem.active"), STR_LEN("savmtool.sem.active"), 0 - 1);
        };
        let done2: bool = true;
    }
}

// source L595: cleanupStaleSaVmTempRoots — remove codex-ultra-sa-vm-*
// dirs under tmpdir older than SA_VM_STALE_TEMP_MS. Promise dedup in
// TS lands as at/done cells (skip only while a run is in flight < 5m).
fn cleanupStaleSaVmTempRoots() -> void {
    let now: i64 = sa_time_unix_ms();
    let at: u64 = sem_cell_get(STR_PTR("savmtool.stale.at"), STR_LEN("savmtool.stale.at"));
    let done: u64 = sem_cell_get(STR_PTR("savmtool.stale.done"), STR_LEN("savmtool.stale.done"));
    if at != 0 && done == 0 && (now as u64) >= at && (now as u64) - at < 300000 { return; };
    let rc1: i32 = sa_global_u64_set(STR_PTR("savmtool.stale.at"), STR_LEN("savmtool.stale.at"), now as u64);
    let rc2: i32 = sa_global_u64_set(STR_PTR("savmtool.stale.done"), STR_LEN("savmtool.stale.done"), 0);
    let tmpdir = StrBuf { bytes: [0u8; 65536], len: 0 };
    let td_h: u64 = sa_env_temp_dir();
    if td_h != 0 {
        let vp: ptr = sa_env_buffer_data(td_h);
        let vn: u64 = sa_env_buffer_len(td_h);
        if vn > 0 { sb_append(&tmpdir, vp, vn); };
        let rcf: i32 = sa_env_buffer_free(td_h);
    };
    if tmpdir.len == 0 { sb_assign(&tmpdir, STR_PTR("/tmp"), STR_LEN("/tmp")); };
    let cutoff: i64 = now - (SA_VM_STALE_TEMP_MS as i64);
    let names = ListBuf { bytes: [0u8; 131072], len: 0 };
    let kinds = U64List { items: [0u64; 4096], len: 0 };
    if list_dir_names(&tmpdir, &names, &kinds) {
        let cnt: u64 = lb_count(&names);
        let name = StrBuf { bytes: [0u8; 65536], len: 0 };
        let i: u64 = 0;
        while i < cnt {
            let got: bool = lb_at(&names, i, &name);
            if got && kinds.items[i] == 2 && sb_starts(&name, STR_PTR("codex-ultra-sa-vm-"), STR_LEN("codex-ultra-sa-vm-")) {
                let root = StrBuf { bytes: [0u8; 65536], len: 0 };
                path_join(&tmpdir, &name, &root);
                let md: u64 = sa_fs_metadata(sb_ptr(&root), root.len);
                if md != 0 {
                    let mtime: i64 = sa_fs_metadata_modified_ms(md);
                    let rcf: i32 = sa_std_fs_metadata_free(md);
                    if mtime < cutoff {
                        let rcr: i32 = sa_fs_remove_dir_all(sb_ptr(&root), root.len);
                    }
                }
            };
            i = i + 1;
        }
    };
    let rc3: i32 = sa_global_u64_set(STR_PTR("savmtool.stale.done"), STR_LEN("savmtool.stale.done"), 1);
}

// source L622: backupExistingFileBeforeWrite.
fn backupExistingFileBeforeWrite(resolved_path: &StrBuf, existing_content: &StrBuf, policy: &NormalizedSaVmPolicy, cwd: &StrBuf) -> void {
    if !policy.fs.backupDir_has || policy.fs.backupDir_len == 0 { return; };
    let bd = StrBuf { bytes: [0u8; 65536], len: 0 };
    let bp: ptr = PTR_NULL();
    PTR_BYTE_ADD(bp, &policy.fs.backupDir, 0);
    sb_append(&bd, bp, policy.fs.backupDir_len);
    // strip trailing "/**"
    if bd.len >= 3 && bd.bytes[bd.len - 3] == 47 && bd.bytes[bd.len - 2] == 42 && bd.bytes[bd.len - 1] == 42 {
        bd.len = bd.len - 3;
    };
    let backup_root = StrBuf { bytes: [0u8; 65536], len: 0 };
    if path_is_abs(&bd) {
        path_normalize(&bd, &backup_root);
    } else {
        path_resolve(cwd, &bd, &backup_root);
    };
    let rel = StrBuf { bytes: [0u8; 65536], len: 0 };
    tool_path_relative(cwd, resolved_path, &rel);
    let lo: u64 = 0;
    while lo < rel.len && (rel.bytes[lo] == 47 || rel.bytes[lo] == 92) { lo = lo + 1; } 
    let rel2 = StrBuf { bytes: [0u8; 65536], len: 0 };
    let i: u64 = lo;
    while i < rel.len {
        rel2.bytes[rel2.len] = rel.bytes[i];
        rel2.len = rel2.len + 1;
        i = i + 1;
    }
    let leaf = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_copy(&leaf, &rel2);
    sb_append(&leaf, STR_PTR("."), STR_LEN("."));
    let now_s = StrBuf { bytes: [0u8; 65536], len: 0 };
    fmt_i64_sb(sa_time_unix_ms(), &now_s);
    sb_append(&leaf, sb_ptr(&now_s), now_s.len);
    sb_append(&leaf, STR_PTR(".bak"), STR_LEN(".bak"));
    let backup_path = StrBuf { bytes: [0u8; 65536], len: 0 };
    path_resolve(&backup_root, &leaf, &backup_path);
    let dir = StrBuf { bytes: [0u8; 65536], len: 0 };
    tool_path_dirname(&backup_path, &dir);
    let rcm: i32 = sa_fs_mkdir_p(sb_ptr(&dir), dir.len);
    let rcw: i32 = fs_write_all(&backup_path, sb_ptr(existing_content), existing_content.len);
}

// source L637: estimateTokenCount — UTF-16 unit walk over UTF-8 bytes:
// CJK range units weigh 0.8, others 1/3.5; ceil of the sum.
fn estimate_tokens_bytes(p: ptr, n: u64) -> f64 {
    let cjk: u64 = 0;
    let units: u64 = 0;
    let i: u64 = 0;
    while i < n {
        let b0: u8 = byte_at(p, i);
        if b0 < 128 {
            units = units + 1;
            i = i + 1;
        } else if b0 < 224 {
            units = units + 1;
            i = i + 2;
            if i > n { i = n; };
        } else if b0 < 240 {
            let cp: u64 = 0;
            if i + 2 < n {
                let b1: u8 = byte_at(p, i + 1);
                let b2: u8 = byte_at(p, i + 2);
                cp = (b0 % 16) as u64 * 4096 + (b1 % 64) as u64 * 64 + (b2 % 64) as u64;
            };
            if cp >= 19968 && cp <= 40959 { cjk = cjk + 1; } else { units = units + 1; };
            i = i + 3;
            if i > n { i = n; };
        } else {
            units = units + 2;
            i = i + 4;
            if i > n { i = n; };
        }
    }
    let total: f64 = (cjk as f64) * 0.8 + (units as f64) / 3.5;
    let iv: i64 = total as i64;
    if (iv as f64) < total { iv = iv + 1; };
    return iv as f64;
}

fn estimateTokenCount(text: &StrBuf) -> f64 {
    if text.len == 0 { return 0.0; };
    return estimate_tokens_bytes(sb_ptr(text), text.len);
}

// source L652: formatBytes with toFixed semantics (1 / 2 decimals).
fn fmt_f64_prec(v: f64, prec: u32, out: &StrBuf) -> void {
    let n: u64 = 0;
    let rc: i32 = sa_fmt_f64_into(v, prec, sb_ptr(out), 65536, &n);
    out.len = n;
}

fn formatBytes(bytes: f64, out: &StrBuf) -> void {
    out.len = 0;
    if bytes < 1024.0 {
        let num = StrBuf { bytes: [0u8; 65536], len: 0 };
        fmt_f64_sb(bytes, &num);
        sb_append(out, sb_ptr(&num), num.len);
        sb_append(out, STR_PTR(" B"), STR_LEN(" B"));
        return;
    };
    if bytes < 1048576.0 {
        fmt_f64_prec(bytes / 1024.0, 1, out);
        sb_append(out, STR_PTR(" KB"), STR_LEN(" KB"));
        return;
    };
    fmt_f64_prec(bytes / 1048576.0, 2, out);
    sb_append(out, STR_PTR(" MB"), STR_LEN(" MB"));
}

// Policy normalization wrapper: zeroed NormalizedSaVmPolicy + empty
// additional roots, filled by saVmPolicy.normalizeSaVmPolicy.
// (norm_policy_zero is generated from the CG zero literal.)
fn normalize_policy(policy_doc: u64, cwd: &StrBuf, out: &NormalizedSaVmPolicy) -> void {
    norm_policy_zero(out);
    let roots = StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 };
    normalizeSaVmPolicy(policy_doc, sb_ptr(cwd), cwd.len, &roots, out);
}

// Result helpers for the read family.
fn res_set_violation(out: &SaVmRunResult, p: ptr, n: u64) -> void {
    out.has_saVmViolation = true;
    out.saVmViolation_json_len = 0;
    let i: u64 = 0;
    while i < n {
        if out.saVmViolation_json_len >= 16384 { break; };
        out.saVmViolation_json[out.saVmViolation_json_len] = byte_at(p, i);
        out.saVmViolation_json_len = out.saVmViolation_json_len + 1;
        i = i + 1;
    }
}

fn res_success(out: &SaVmRunResult, started_at: f64) -> void {
    res_init(out);
    out.ok = true;
    res_set_kind(out, STR_PTR("success"), STR_LEN("success"));
    out.has_exitCode = true;
    out.exitCode = 0;
    out.durationMs = dur_since(started_at);
}

fn res_capability(out: &SaVmRunResult, reason: &StrBuf, started_at: f64) -> void {
    res_init(out);
    out.ok = false;
    res_set_kind(out, STR_PTR("capability_denied"), STR_LEN("capability_denied"));
    out.has_exitCode = true;
    out.exitCode = 228;
    res_set_stderr(out, sb_ptr(reason), reason.len);
    if reason.len > 0 {
        let doc: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
        if doc != 0 {
            jset_str(doc, STR_PTR("reason"), STR_LEN("reason"), sb_ptr(reason), reason.len);
            let jb = JsonBuf { bytes: [0u8; 262144], len: 0 };
            jdoc_to_jb(doc, &jb);
            res_set_violation(out, jb_ptr(&jb), jb.len);
        }
    };
    out.durationMs = dur_since(started_at);
}

fn res_sa_error(out: &SaVmRunResult, msg_p: ptr, msg_n: u64, started_at: f64) -> void {
    res_init(out);
    out.ok = false;
    res_set_kind(out, STR_PTR("sa_error"), STR_LEN("sa_error"));
    out.has_exitCode = true;
    out.exitCode = 1;
    res_set_stderr(out, msg_p, msg_n);
    out.durationMs = dur_since(started_at);
}

// source L658: NativeReadFileOptions (presence via has_ flags).
struct NativeReadFileOptions {
    start_line: f64,
    has_start_line: bool,
    end_line: f64,
    has_end_line: bool,
    offset: f64,
    has_offset: bool,
    max_tokens: f64,
    has_max_tokens: bool,
    remaining_tokens: f64,
    has_remaining_tokens: bool,
    max_bytes: f64,
    has_max_bytes: bool,
    max_lines: f64,
    has_max_lines: bool,
    max_line_length: f64,
    has_max_line_length: bool,
    numbered: bool,
    has_numbered: bool,
}

fn read_opt_num(doc: u64, p1: ptr, n1: u64, p2: ptr, n2: u64, dst: &f64, has_dst: &bool) -> void {
    let node: u64 = jget_node(doc, p1, n1);
    if node == 0 && n2 > 0 { node = jget_node(doc, p2, n2); };
    if node != 0 {
        let k: u32 = sa_json_kind(node);
        if k == 2 || k == 3 {
            *dst = sa_json_node_as_f64(node);
            *has_dst = true;
        };
    };
}

fn read_opts_parse(jb: &JsonBuf, out: &NativeReadFileOptions) -> void {
    out.start_line = 0.0;
    out.has_start_line = false;
    out.end_line = 0.0;
    out.has_end_line = false;
    out.offset = 0.0;
    out.has_offset = false;
    out.max_tokens = 0.0;
    out.has_max_tokens = false;
    out.remaining_tokens = 0.0;
    out.has_remaining_tokens = false;
    out.max_bytes = 0.0;
    out.has_max_bytes = false;
    out.max_lines = 0.0;
    out.has_max_lines = false;
    out.max_line_length = 0.0;
    out.has_max_line_length = false;
    out.numbered = false;
    out.has_numbered = false;
    let doc: u64 = jdoc_of_jb(jb);
    if doc == 0 { return; };
    let k: u32 = sa_json_kind(doc);
    if k == 2 || k == 3 {
        out.max_bytes = sa_json_node_as_f64(doc);
        out.has_max_bytes = true;
        sa_json_free(doc);
        return;
    };
    if k != 7 {
        sa_json_free(doc);
        return;
    };
    read_opt_num(doc, STR_PTR("startLine"), STR_LEN("startLine"), STR_PTR("start_line"), STR_LEN("start_line"), &out.start_line, &out.has_start_line);
    read_opt_num(doc, STR_PTR("endLine"), STR_LEN("endLine"), STR_PTR("end_line"), STR_LEN("end_line"), &out.end_line, &out.has_end_line);
    read_opt_num(doc, STR_PTR("offset"), STR_LEN("offset"), STR_PTR(""), 0, &out.offset, &out.has_offset);
    read_opt_num(doc, STR_PTR("maxTokens"), STR_LEN("maxTokens"), STR_PTR("max_tokens"), STR_LEN("max_tokens"), &out.max_tokens, &out.has_max_tokens);
    read_opt_num(doc, STR_PTR("remainingTokens"), STR_LEN("remainingTokens"), STR_PTR("remaining_tokens"), STR_LEN("remaining_tokens"), &out.remaining_tokens, &out.has_remaining_tokens);
    read_opt_num(doc, STR_PTR("maxBytes"), STR_LEN("maxBytes"), STR_PTR("max_bytes"), STR_LEN("max_bytes"), &out.max_bytes, &out.has_max_bytes);
    read_opt_num(doc, STR_PTR("maxLines"), STR_LEN("maxLines"), STR_PTR("max_lines"), STR_LEN("max_lines"), &out.max_lines, &out.has_max_lines);
    read_opt_num(doc, STR_PTR("maxLineLength"), STR_LEN("maxLineLength"), STR_PTR("max_line_length"), STR_LEN("max_line_length"), &out.max_line_length, &out.has_max_line_length);
    let nb: u64 = jget_node(doc, STR_PTR("numbered"), STR_LEN("numbered"));
    if nb != 0 && sa_json_kind(nb) == 1 {
        out.numbered = sa_json_node_as_bool(nb);
        out.has_numbered = true;
    };
    sa_json_free(doc);
}

// Raw text helpers over (ptr, len): line = segment between \n bytes,
// trailing \r excluded (TS split(/\r?\n/)).
fn text_line_stats(p: ptr, n: u64, total_out: &u64, maxlen_out: &u64) -> void {
    let total: u64 = 1;
    let maxlen: u64 = 0;
    let cur: u64 = 0;
    let last_cr: bool = false;
    let i: u64 = 0;
    while i < n {
        let b: u8 = byte_at(p, i);
        if b == 10 {
            let eff: u64 = cur;
            if last_cr && eff > 0 { eff = eff - 1; };
            if eff > maxlen { maxlen = eff; };
            total = total + 1;
            cur = 0;
            last_cr = false;
        } else {
            cur = cur + 1;
            last_cr = b == 13;
        };
        i = i + 1;
    }
    let eff2: u64 = cur;
    if last_cr && eff2 > 0 { eff2 = eff2 - 1; };
    if eff2 > maxlen { maxlen = eff2; };
    if n == 0 { total = 1; };
    *total_out = total;
    *maxlen_out = maxlen;
}

fn text_line_span(p: ptr, n: u64, idx1: u64, s_out: &u64, l_out: &u64) -> bool {
    let cur_idx: u64 = 1;
    let start: u64 = 0;
    let i: u64 = 0;
    while i < n {
        if byte_at(p, i) == 10 {
            if cur_idx == idx1 {
                let e: u64 = i;
                if e > start && byte_at(p, e - 1) == 13 { e = e - 1; };
                *s_out = start;
                *l_out = e - start;
                return true;
            };
            cur_idx = cur_idx + 1;
            start = i + 1;
        };
        i = i + 1;
    }
    if cur_idx == idx1 {
        let e2: u64 = n;
        if e2 > start && byte_at(p, e2 - 1) == 13 { e2 = e2 - 1; };
        *s_out = start;
        *l_out = e2 - start;
        return true;
    };
    return false;
}

fn ptr_has_nul(p: ptr, n: u64) -> bool {
    let i: u64 = 0;
    while i < n {
        if byte_at(p, i) == 0 { return true; };
        i = i + 1;
    }
    return false;
}

fn sb_append_f64(v: f64, out: &StrBuf) -> void {
    let t = StrBuf { bytes: [0u8; 65536], len: 0 };
    fmt_f64_sb(v, &t);
    sb_append(out, sb_ptr(&t), t.len);
}

fn tool_sb_append_u64(v: u64, out: &StrBuf) -> void {
    let t = StrBuf { bytes: [0u8; 65536], len: 0 };
    fmt_u64_sb(v, &t);
    sb_append(out, sb_ptr(&t), t.len);
}

fn sb_append_pad_u64(v: u64, width: u64, out: &StrBuf) -> void {
    let t = StrBuf { bytes: [0u8; 65536], len: 0 };
    fmt_u64_sb(v, &t);
    let pad: u64 = 0;
    if width > t.len { pad = width - t.len; };
    let i: u64 = 0;
    while i < pad {
        sb_push_byte(out, 32);
        i = i + 1;
    }
    sb_append(out, sb_ptr(&t), t.len);
}

fn path_has_image_ext(path: &StrBuf) -> bool {
    let lp = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_to_lower(path, &lp);
    if sb_ends(&lp, STR_PTR(".png"), STR_LEN(".png")) { return true; };
    if sb_ends(&lp, STR_PTR(".jpg"), STR_LEN(".jpg")) { return true; };
    if sb_ends(&lp, STR_PTR(".jpeg"), STR_LEN(".jpeg")) { return true; };
    if sb_ends(&lp, STR_PTR(".webp"), STR_LEN(".webp")) { return true; };
    if sb_ends(&lp, STR_PTR(".gif"), STR_LEN(".gif")) { return true; };
    if sb_ends(&lp, STR_PTR(".bmp"), STR_LEN(".bmp")) { return true; };
    if sb_ends(&lp, STR_PTR(".avif"), STR_LEN(".avif")) { return true; };
    if sb_ends(&lp, STR_PTR(".svg"), STR_LEN(".svg")) { return true; };
    if sb_ends(&lp, STR_PTR(".ico"), STR_LEN(".ico")) { return true; };
    return false;
}

fn jescape_into(text: &StrBuf, ob: &JsonBuf) -> void {
    let hexsb = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_assign(&hexsb, STR_PTR("0123456789abcdef"), STR_LEN("0123456789abcdef"));
    let hp: ptr = sb_ptr(&hexsb);
    let i: u64 = 0;
    while i < text.len {
        let b: u8 = text.bytes[i];
        if b == 34 {
            jb_append(ob, STR_PTR("\\\""), STR_LEN("\\\""));
        } else if b == 92 {
            jb_append(ob, STR_PTR("\\\\"), STR_LEN("\\\\"));
        } else if b == 10 {
            jb_append(ob, STR_PTR("\\n"), STR_LEN("\\n"));
        } else if b == 13 {
            jb_append(ob, STR_PTR("\\r"), STR_LEN("\\r"));
        } else if b == 9 {
            jb_append(ob, STR_PTR("\\t"), STR_LEN("\\t"));
        } else if b < 32 {
            jb_append(ob, STR_PTR("\\u00"), STR_LEN("\\u00"));
            jb_push_byte(ob, byte_at(hp, (b / 16) as u64));
            jb_push_byte(ob, byte_at(hp, (b % 16) as u64));
        } else {
            jb_push_byte(ob, b);
        };
        i = i + 1;
    }
}

// ENOENT landing (and generic read/stat failure) shared by the read
// family: missing file -> success with the exists:false JSON document;
// otherwise an sa_error. TS distinguishes via err.code/message; the
// generic message text is an approximation (registered).
fn fill_read_catch(out: &SaVmRunResult, path: &StrBuf, cwd: &StrBuf, resolved: &StrBuf, started_at: f64) -> void {
    if !fs_exists_sb(resolved) {
        let rel = StrBuf { bytes: [0u8; 65536], len: 0 };
        tool_path_relative(cwd, resolved, &rel);
        let shown = StrBuf { bytes: [0u8; 65536], len: 0 };
        if rel.len > 0 { sb_copy(&shown, &rel); } else { sb_copy(&shown, path); };
        let ob = JsonBuf { bytes: [0u8; 262144], len: 0 };
        jb_append(&ob, STR_PTR("{\n  \"path\": \""), STR_LEN("{\n  \"path\": \""));
        jescape_into(&shown, &ob);
        jb_append(&ob, STR_PTR("\",\n  \"exists\": false,\n  \"lines\": [],\n  \"total_lines\": 0\n}"), STR_LEN("\",\n  \"exists\": false,\n  \"lines\": [],\n  \"total_lines\": 0\n}"));
        res_success(out, started_at);
        res_set_stdout(out, jb_ptr(&ob), ob.len);
        return;
    };
    let msg = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_assign(&msg, STR_PTR("failed to read '"), STR_LEN("failed to read '"));
    sb_append(&msg, sb_ptr(path), path.len);
    sb_append(&msg, STR_PTR("'"), STR_LEN("'"));
    res_sa_error(out, sb_ptr(&msg), msg.len, started_at);
}

// source L670: nativeReadFile.
fn nativeReadFile(path: &StrBuf, options: &JsonBuf, policy_doc: u64, cwd: &StrBuf, started_at: f64, out: &SaVmRunResult) -> i32 {
    let opts = NativeReadFileOptions { start_line: 0.0, has_start_line: false, end_line: 0.0, has_end_line: false, offset: 0.0, has_offset: false, max_tokens: 0.0, has_max_tokens: false, remaining_tokens: 0.0, has_remaining_tokens: false, max_bytes: 0.0, has_max_bytes: false, max_lines: 0.0, has_max_lines: false, max_line_length: 0.0, has_max_line_length: false, numbered: false, has_numbered: false };
    read_opts_parse(options, &opts);
    let resolved = StrBuf { bytes: [0u8; 65536], len: 0 };
    if path_is_abs(path) {
        path_normalize(path, &resolved);
    } else {
        path_resolve(cwd, path, &resolved);
    };
    let norm = NormalizedSaVmPolicy { engine: 0, fs: NormalizedFs { entries: FsEntryList { items: [SaVmFsEntry { path: [0u8; 1024], path_len: 0, access: 0 }; 128], len: 0 }, read: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, write: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, transfer: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, delete: 0, backupDir: [0u8; 1024], backupDir_len: 0, backupDir_has: false }, http_allow: HttpRuleList { items: [SaVmHttpAllowRule { host: [0u8; 512], host_len: 0, methods: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_methods: false, paths: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_paths: false }; 128], len: 0 }, env_allow: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, process: NormalizedProcess { spawn: false, exec: ExecRuleList { items: [SaVmProcessExecRule { path: [0u8; 4096], path_len: 0, args: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_args: false }; 128], len: 0 }, bunProfiles: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_bunProfiles: false, bun_enabled: false, bun_allowedSubcommands: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_bun: false }, execution_javascript: false, execution_python: false, tools: NormalizedTools { replaceRead: false, replaceWrite: false, replaceApplyPatch: false, replaceExec: false, readFiles: false, editFiles: false, applyPatch: false, fastSearch: false, clearToolHistory: false, findReferences: false, renameSymbol: false, fileOutline: false, moveWithImports: false, findDefinition: false, extractToFile: false, addImport: false, getDiagnostics: false, organizeImports: false, analyzeScope: false, codeGraph: false }, contextSavings: SaVmContextSavingsConfig { locateBeforeRead: false, maxReadFileBytes: 0, maxReadFileBytes_has: false, grepCircuitBreaker: false, grepMaxResults: 0, grepMaxResults_has: false, grepMaxTokens: 0, grepMaxTokens_has: false, slimRunnerOutput: false, parallelBudget: false, parallelMaxTotalBytes: 0, parallelMaxTotalBytes_has: false, parallelMaxReadFiles: 0, parallelMaxReadFiles_has: false, parallelDeduplication: false, tieredSkillInjection: false, foldWaterfallEvents: false, foldHistoryReadSummaries: false, historyReadFoldTurns: 0, historyReadFoldTurns_has: false }, contextSavings_has: false };
    normalize_policy(policy_doc, cwd, &norm);
    let reason = StrBuf { bytes: [0u8; 65536], len: 0 };
    let allowed: bool = toolCheckPath(&norm, 0, &resolved, cwd, &reason);
    if !allowed {
        res_capability(out, &reason, started_at);
        return 0;
    };
    let md: u64 = sa_fs_metadata(sb_ptr(&resolved), resolved.len);
    if md == 0 {
        fill_read_catch(out, path, cwd, &resolved, started_at);
        return 0;
    };
    let is_dir: bool = sa_fs_metadata_is_directory(md) == 1;
    let file_size: u64 = sa_fs_metadata_len(md);
    let rcf: i32 = sa_std_fs_metadata_free(md);
    if is_dir {
        let msg = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_assign(&msg, STR_PTR("EISDIR: illegal operation on a directory, read '"), STR_LEN("EISDIR: illegal operation on a directory, read '"));
        sb_append(&msg, sb_ptr(path), path.len);
        sb_append(&msg, STR_PTR("'. Use list_dir to browse it instead."), STR_LEN("'. Use list_dir to browse it instead."));
        res_sa_error(out, sb_ptr(&msg), msg.len, started_at);
        return 0;
    };
    if file_size == 0 {
        let m = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_assign(&m, STR_PTR("[File: "), STR_LEN("[File: "));
        sb_append(&m, sb_ptr(path), path.len);
        sb_append(&m, STR_PTR(" is empty (0 bytes)]"), STR_LEN(" is empty (0 bytes)]"));
        res_success(out, started_at);
        res_set_stdout(out, sb_ptr(&m), m.len);
        return 0;
    };
    let targeted: bool = opts.has_start_line || opts.has_end_line || opts.has_offset || opts.has_max_lines;
    if norm.contextSavings_has && norm.contextSavings.locateBeforeRead && !targeted {
        let max_b: u64 = 51200;
        if norm.contextSavings.maxReadFileBytes_has { max_b = norm.contextSavings.maxReadFileBytes; };
        if file_size > max_b {
            let sz = StrBuf { bytes: [0u8; 65536], len: 0 };
            formatBytes(file_size as f64, &sz);
            let lim = StrBuf { bytes: [0u8; 65536], len: 0 };
            formatBytes(max_b as f64, &lim);
            let msg = StrBuf { bytes: [0u8; 65536], len: 0 };
            sb_assign(&msg, STR_PTR("[OPT-1] read_file rejected: "), STR_LEN("[OPT-1] read_file rejected: "));
            sb_append(&msg, sb_ptr(path), path.len);
            sb_append(&msg, STR_PTR(" is "), STR_LEN(" is "));
            sb_append(&msg, sb_ptr(&sz), sz.len);
            sb_append(&msg, STR_PTR(" which exceeds the "), STR_LEN(" which exceeds the "));
            sb_append(&msg, sb_ptr(&lim), lim.len);
            sb_append(&msg, STR_PTR(" limit. Use read_lines with start_line/end_line for targeted reading, or find_references to locate symbols first."), STR_LEN(" limit. Use read_lines with start_line/end_line for targeted reading, or find_references to locate symbols first."));
            res_init(out);
            out.ok = false;
            res_set_kind(out, STR_PTR("capability_denied"), STR_LEN("capability_denied"));
            out.has_exitCode = true;
            out.exitCode = 228;
            res_set_stderr(out, sb_ptr(&msg), msg.len);
            let vdoc: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
            if vdoc != 0 {
                jset_str(vdoc, STR_PTR("rule"), STR_LEN("rule"), STR_PTR("contextSavings.locateBeforeRead"), STR_LEN("contextSavings.locateBeforeRead"));
                jset_bool(vdoc, STR_PTR("blocked"), STR_LEN("blocked"), false);
                let vjb = JsonBuf { bytes: [0u8; 262144], len: 0 };
