                                    PTR_BYTE_ADD(po12155_0, sb_ptr(&head), 6);
                                    sb_append(&after, po12155_0, head.len - 6);
                                    let a2 = StrBuf { bytes: [0u8; 65536], len: 0 };
                                    tool_sb_trim(&after, &a2);
                                    if sb_starts(&a2, STR_PTR("type "), STR_LEN("type ")) {
                                        let a3 = StrBuf { bytes: [0u8; 65536], len: 0 };
                                        let po12160_0: ptr = PTR_NULL();
                                        PTR_BYTE_ADD(po12160_0, sb_ptr(&a2), 5);
                                        sb_append(&a3, po12160_0, a2.len - 5);
                                        sb_copy(&a2, &a3);
                                        let a4 = StrBuf { bytes: [0u8; 65536], len: 0 };
                                        tool_sb_trim(&a2, &a4);
                                        sb_copy(&a2, &a4);
                                    };
                                    let wend: u64 = 0;
                                    while wend < a2.len && ((a2.bytes[wend] >= 65 && a2.bytes[wend] <= 90) || (a2.bytes[wend] >= 97 && a2.bytes[wend] <= 122) || (a2.bytes[wend] >= 48 && a2.bytes[wend] <= 57) || a2.bytes[wend] == 95 || a2.bytes[wend] == 36) { wend = wend + 1; }
                                    sb_append(&imported, sb_ptr(&a2), wend);
                                };
                                if imported.len > 0 && tool_bytes_eq(sb_ptr(&imported), imported.len, sb_ptr(&symbol), symbol.len) && modspec.len > 0 {
                                    name_hit = true;
                                };
                            };
                            if name_hit {
                                let target_dir = StrBuf { bytes: [0u8; 65536], len: 0 };
                                tool_path_dirname(&full, &target_dir);
                                let suffixes = ListBuf { bytes: [0u8; 131072], len: 0 };
                                lb_append(&suffixes, STR_PTR(""), 0);
                                lb_append(&suffixes, STR_PTR(".ts"), STR_LEN(".ts"));
                                lb_append(&suffixes, STR_PTR(".tsx"), STR_LEN(".tsx"));
                                lb_append(&suffixes, STR_PTR(".js"), STR_LEN(".js"));
                                lb_append(&suffixes, STR_PTR(".jsx"), STR_LEN(".jsx"));
                                lb_append(&suffixes, STR_PTR("/index.ts"), STR_LEN("/index.ts"));
                                lb_append(&suffixes, STR_PTR("/index.tsx"), STR_LEN("/index.tsx"));
                                lb_append(&suffixes, STR_PTR("/index.js"), STR_LEN("/index.js"));
                                let base = StrBuf { bytes: [0u8; 65536], len: 0 };
                                path_resolve(&target_dir, &modspec, &base);
                                let suf = StrBuf { bytes: [0u8; 65536], len: 0 };
                                let si: u64 = 0;
                                while si < lb_count(&suffixes) && !followed {
                                    let g1: bool = lb_at(&suffixes, si, &suf);
                                    let cand = StrBuf { bytes: [0u8; 65536], len: 0 };
                                    sb_copy(&cand, &base);
                                    sb_append(&cand, sb_ptr(&suf), suf.len);
                                    if fs_exists_sb(&cand) {
                                        let rel_cand = StrBuf { bytes: [0u8; 65536], len: 0 };
                                        tool_path_relative(cwd, &cand, &rel_cand);
                                        let rsn2 = StrBuf { bytes: [0u8; 65536], len: 0 };
                                        if toolCheckPath(&norm, 0, &rel_cand, cwd, &rsn2) {
                                            let ccontent = StrBuf { bytes: [0u8; 65536], len: 0 };
                                            if fs_read_sb(&cand, 65536, &ccontent) == 0 {
                                                let cmatch = DefinitionMatch { filePath: [0u8; 1024], filePath_len: 0, symbol: [0u8; 256], symbol_len: 0, kind: 0, startLine: 0, endLine: 0, signature: [0u8; 512], signature_len: 0, bodySnippet: [0u8; 16384], bodySnippet_len: 0, found: false };
                                                findDefinitionInContent(&st, &rel_cand, &ccontent, &symbol, eff_max, true, &cmatch);
                                                if cmatch.found {
                                                    find_definition_emit(out, started_at, &symbol, &cmatch, &modspec, true);
                                                    followed = true;
                                                };
                                            };
                                        };
                                    };
                                    si = si + 1;
                                }
                            };
                        };
                    };
                    idx = idx + 1;
                }
                if followed {
                    if odoc != 0 { sa_json_free(odoc); };
                    return 0;
                };
            };
        };
    };
    // workspace scan (prefilter always unavailable in the native runtime,
    // matching the TS fallback to the sequential loop)
    let targets = ListBuf { bytes: [0u8; 131072], len: 0 };
    let cwd_norm = StrBuf { bytes: [0u8; 65536], len: 0 };
    path_normalize(cwd, &cwd_norm);
    collectWorkspaceSourceFiles(&cwd_norm, 1000.0, 10000.0, started_at, &targets);
    let f = StrBuf { bytes: [0u8; 65536], len: 0 };
    let ti: u64 = 0;
    let ws_found: bool = false;
    while ti < lb_count(&targets) {
        let got: bool = lb_at(&targets, ti, &f);
        ti = ti + 1;
        if !got { continue; };
        let content = StrBuf { bytes: [0u8; 65536], len: 0 };
        if fs_read_sb(&f, 65536, &content) != 0 { continue; };
        if !tool_sb_contains(&content, sb_ptr(&symbol), symbol.len) { continue; };
        let rel = StrBuf { bytes: [0u8; 65536], len: 0 };
        tool_path_relative(cwd, &f, &rel);
        let dm = DefinitionMatch { filePath: [0u8; 1024], filePath_len: 0, symbol: [0u8; 256], symbol_len: 0, kind: 0, startLine: 0, endLine: 0, signature: [0u8; 512], signature_len: 0, bodySnippet: [0u8; 16384], bodySnippet_len: 0, found: false };
        findDefinitionInContent(&st, &rel, &content, &symbol, eff_max, true, &dm);
        if dm.found {
            let nf = StrBuf { bytes: [0u8; 65536], len: 0 };
            find_definition_emit(out, started_at, &symbol, &dm, &nf, false);
            ws_found = true;
            break;
        };
    }
    if ws_found {
        if odoc != 0 { let frcw: i32 = sa_json_free(odoc); };
        return 0;
    };
    let em = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_assign(&em, STR_PTR("[find_definition] No definition found for symbol '"), STR_LEN("[find_definition] No definition found for symbol '"));
    sb_append(&em, sb_ptr(&symbol), symbol.len);
    sb_append(&em, STR_PTR("'."), STR_LEN("'."));
    res_success(out, started_at);
    res_set_stdout(out, sb_ptr(&em), em.len);
    if odoc != 0 { sa_json_free(odoc); };
    return 0;
}

// ---- tree-sitter backed natives (part 2) ----
fn split_line_count(content: &StrBuf) -> u64 {
    // content.split(/\r?\n/).length == count of \n + 1
    let n: u64 = 1;
    let i: u64 = 0;
    while i < content.len {
        if content.bytes[i] == 10 { n = n + 1; };
        i = i + 1;
    }
    return n;
}

fn line_text(content: &StrBuf, idx: u64, out: &StrBuf) -> void {
    // idx is 1-based; mirrors split(/\r?\n/) (a trailing \r is stripped)
    out.len = 0;
    let ls: u64 = 0;
    let ll: u64 = 0;
    if text_line_span(sb_ptr(content), content.len, idx, &ls, &ll) {
        if ll > 0 {
            let last: u8 = 0;
            PTR_BYTE_AT(last, sb_ptr(content), ls + ll - 1);
            if last == 13 { ll = ll - 1; };
        };
        let lp: ptr = PTR_NULL();
        PTR_BYTE_ADD(lp, sb_ptr(content), ls);
        sb_append(out, lp, ll);
    };
}

fn join_lines_range(content: &StrBuf, from_line: u64, to_line: u64, eol: &StrBuf, out: &StrBuf) -> void {
    // join lines[from_line..to_line] (1-based inclusive) with eol
    out.len = 0;
    let line = StrBuf { bytes: [0u8; 65536], len: 0 };
    let i: u64 = from_line;
    while i <= to_line {
        if i > from_line { sb_append(out, sb_ptr(eol), eol.len); };
        line_text(content, i, &line);
        sb_append(out, sb_ptr(&line), line.len);
        i = i + 1;
    }
}

fn count_substr(hay: &StrBuf, needle: &StrBuf) -> u64 {
    // JS split(needle).length - 1 == non-overlapping occurrence count
    if needle.len == 0 || hay.len < needle.len { return 0; };
    let count: u64 = 0;
    let i: u64 = 0;
    while i + needle.len <= hay.len {
        let pr12348_0: ptr = PTR_NULL();
        PTR_BYTE_ADD(pr12348_0, sb_ptr(hay), i);
        let hit: bool = tool_bytes_eq(pr12348_0, needle.len, sb_ptr(needle), needle.len);
        if hit {
            count = count + 1;
            i = i + needle.len;
        } else {
            i = i + 1;
        };
    }
    return count;
}

fn tool_decl_scan_line(line: &StrBuf, name_out: &StrBuf, indent_out: &u64, matched: &bool) -> void {
    // ^(\s*)(?:export\s+)?(?:const|let|var|function|class|interface|type|enum)\s+([A-Za-z0-9_$]+)
    *matched = false;
    name_out.len = 0;
    *indent_out = 0;
    let i: u64 = 0;
    // leading whitespace; indent counts \t as 2 spaces
    let indent: u64 = 0;
    while i < line.len && (line.bytes[i] == 32 || line.bytes[i] == 9) {
        if line.bytes[i] == 9 { indent = indent + 2; } else { indent = indent + 1; };
        i = i + 1;
    }
    *indent_out = indent;
    let rest = StrBuf { bytes: [0u8; 65536], len: 0 };
    let pr12373_0: ptr = PTR_NULL();
    PTR_BYTE_ADD(pr12373_0, sb_ptr(line), i);
    sb_append(&rest, pr12373_0, line.len - i);
    if sb_starts(&rest, STR_PTR("export "), STR_LEN("export ")) || sb_starts(&rest, STR_PTR("export\t"), STR_LEN("export\t")) {
        let r2 = StrBuf { bytes: [0u8; 65536], len: 0 };
        let po12337_0: ptr = PTR_NULL();
        PTR_BYTE_ADD(po12337_0, sb_ptr(&rest), 7);
        sb_append(&r2, po12337_0, rest.len - 7);
        sb_copy(&rest, &r2);
    };
    let kws = ListBuf { bytes: [0u8; 131072], len: 0 };
    lb_append(&kws, STR_PTR("const"), STR_LEN("const"));
    lb_append(&kws, STR_PTR("let"), STR_LEN("let"));
    lb_append(&kws, STR_PTR("var"), STR_LEN("var"));
    lb_append(&kws, STR_PTR("function"), STR_LEN("function"));
    lb_append(&kws, STR_PTR("class"), STR_LEN("class"));
    lb_append(&kws, STR_PTR("interface"), STR_LEN("interface"));
    lb_append(&kws, STR_PTR("type"), STR_LEN("type"));
    lb_append(&kws, STR_PTR("enum"), STR_LEN("enum"));
    let kw = StrBuf { bytes: [0u8; 65536], len: 0 };
    let ki: u64 = 0;
    let kw_hit: bool = false;
    while ki < lb_count(&kws) {
        let g1: bool = lb_at(&kws, ki, &kw);
        if sb_starts(&rest, sb_ptr(&kw), kw.len) {
            let after: u64 = kw.len;
            if after < rest.len && (rest.bytes[after] == 32 || rest.bytes[after] == 9) {
                kw_hit = true;
                let j: u64 = after;
                while j < rest.len && (rest.bytes[j] == 32 || rest.bytes[j] == 9) { j = j + 1; }
                let ns: u64 = j;
                while j < rest.len && ((rest.bytes[j] >= 65 && rest.bytes[j] <= 90) || (rest.bytes[j] >= 97 && rest.bytes[j] <= 122) || (rest.bytes[j] >= 48 && rest.bytes[j] <= 57) || rest.bytes[j] == 95 || rest.bytes[j] == 36) { j = j + 1; }
                if j > ns {
                    let po12363_0: ptr = PTR_NULL();
                    PTR_BYTE_ADD(po12363_0, sb_ptr(&rest), ns);
                    sb_append(name_out, po12363_0, j - ns);
                    *matched = true;
                };
            };
        };
        ki = ki + 1;
    }
}

fn decl_rewrite_line(line: &StrBuf, sym: &StrBuf, out: &StrBuf) -> void {
    // ^(\s*)(const|let|var|function|class|interface|type|enum)\s+(<sym>\b)
    //   -> "$1export $2 $3..." (rest of line preserved)
    sb_copy(out, line);
    let i: u64 = 0;
    while i < line.len && (line.bytes[i] == 32 || line.bytes[i] == 9) { i = i + 1; }
    let rest = StrBuf { bytes: [0u8; 65536], len: 0 };
    let pr12422_0: ptr = PTR_NULL();
    PTR_BYTE_ADD(pr12422_0, sb_ptr(line), i);
    sb_append(&rest, pr12422_0, line.len - i);
    let kws = ListBuf { bytes: [0u8; 131072], len: 0 };
    lb_append(&kws, STR_PTR("const"), STR_LEN("const"));
    lb_append(&kws, STR_PTR("let"), STR_LEN("let"));
    lb_append(&kws, STR_PTR("var"), STR_LEN("var"));
    lb_append(&kws, STR_PTR("function"), STR_LEN("function"));
    lb_append(&kws, STR_PTR("class"), STR_LEN("class"));
    lb_append(&kws, STR_PTR("interface"), STR_LEN("interface"));
    lb_append(&kws, STR_PTR("type"), STR_LEN("type"));
    lb_append(&kws, STR_PTR("enum"), STR_LEN("enum"));
    let kw = StrBuf { bytes: [0u8; 65536], len: 0 };
    let ki: u64 = 0;
    while ki < lb_count(&kws) {
        let g1: bool = lb_at(&kws, ki, &kw);
        if sb_starts(&rest, sb_ptr(&kw), kw.len) {
            let after: u64 = kw.len;
            if after < rest.len && (rest.bytes[after] == 32 || rest.bytes[after] == 9) {
                let j: u64 = after;
                while j < rest.len && (rest.bytes[j] == 32 || rest.bytes[j] == 9) { j = j + 1; }
                let po12398_0: ptr = PTR_NULL();
                PTR_BYTE_ADD(po12398_0, sb_ptr(&rest), j);
                if j + sym.len <= rest.len && tool_bytes_eq(po12398_0, sym.len, sb_ptr(sym), sym.len) {
                    let after_sym: u64 = j + sym.len;
                    let boundary: bool = false;
                    if after_sym >= rest.len { boundary = true; } else {
                        let b: u8 = rest.bytes[after_sym];
                        if !((b >= 65 && b <= 90) || (b >= 97 && b <= 122) || (b >= 48 && b <= 57) || b == 95 || b == 36) { boundary = true; };
                    };
                    if boundary {
                        out.len = 0;
                        sb_append(out, sb_ptr(line), i);
                        sb_append(out, STR_PTR("export "), STR_LEN("export "));
                        sb_append(out, sb_ptr(&kw), kw.len);
                        sb_append(out, STR_PTR(" "), STR_LEN(" "));
                        let po12411_0: ptr = PTR_NULL();
                        PTR_BYTE_ADD(po12411_0, sb_ptr(&rest), j);
                        sb_append(out, po12411_0, rest.len - j);
                        return;
                    };
                };
            };
        };
        ki = ki + 1;
    }
}

fn nativeExtractToFile(raw_source: &StrBuf, raw_target: &StrBuf, start_line: f64, has_start: bool, end_line: f64, has_end: bool, options: &JsonBuf, policy_doc: u64, cwd: &StrBuf, started_at: f64, out: &SaVmRunResult) -> i32 {
    let source = StrBuf { bytes: [0u8; 65536], len: 0 };
    let source_t = StrBuf { bytes: [0u8; 65536], len: 0 };
    tool_sb_trim(raw_source, &source_t);
    sb_replace_all(&source_t, STR_PTR("\\"), STR_LEN("\\"), STR_PTR("/"), STR_LEN("/"), &source);
    let target = StrBuf { bytes: [0u8; 65536], len: 0 };
    let target_t = StrBuf { bytes: [0u8; 65536], len: 0 };
    tool_sb_trim(raw_target, &target_t);
    sb_replace_all(&target_t, STR_PTR("\\"), STR_LEN("\\"), STR_PTR("/"), STR_LEN("/"), &target);
    if source.len == 0 || target.len == 0 {
        res_sa_error(out, STR_PTR("source and target parameters are required for extract_to_file"), STR_LEN("source and target parameters are required for extract_to_file"), started_at);
        return 0;
    };
    let norm = NormalizedSaVmPolicy { engine: 0, fs: NormalizedFs { entries: FsEntryList { items: [SaVmFsEntry { path: [0u8; 1024], path_len: 0, access: 0 }; 128], len: 0 }, read: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, write: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, transfer: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, delete: 0, backupDir: [0u8; 1024], backupDir_len: 0, backupDir_has: false }, http_allow: HttpRuleList { items: [SaVmHttpAllowRule { host: [0u8; 512], host_len: 0, methods: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_methods: false, paths: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_paths: false }; 128], len: 0 }, env_allow: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, process: NormalizedProcess { spawn: false, exec: ExecRuleList { items: [SaVmProcessExecRule { path: [0u8; 4096], path_len: 0, args: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_args: false }; 128], len: 0 }, bunProfiles: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_bunProfiles: false, bun_enabled: false, bun_allowedSubcommands: StrList { items: [StrItem { bytes: [0u8; 1024], len: 0 }; 128], len: 0 }, has_bun: false }, execution_javascript: false, execution_python: false, tools: NormalizedTools { replaceRead: false, replaceWrite: false, replaceApplyPatch: false, replaceExec: false, readFiles: false, editFiles: false, applyPatch: false, fastSearch: false, clearToolHistory: false, findReferences: false, renameSymbol: false, fileOutline: false, moveWithImports: false, findDefinition: false, extractToFile: false, addImport: false, getDiagnostics: false, organizeImports: false, analyzeScope: false, codeGraph: false }, contextSavings: SaVmContextSavingsConfig { locateBeforeRead: false, maxReadFileBytes: 0, maxReadFileBytes_has: false, grepCircuitBreaker: false, grepMaxResults: 0, grepMaxResults_has: false, grepMaxTokens: 0, grepMaxTokens_has: false, slimRunnerOutput: false, parallelBudget: false, parallelMaxTotalBytes: 0, parallelMaxTotalBytes_has: false, parallelMaxReadFiles: 0, parallelMaxReadFiles_has: false, parallelDeduplication: false, tieredSkillInjection: false, foldWaterfallEvents: false, foldHistoryReadSummaries: false, historyReadFoldTurns: 0, historyReadFoldTurns_has: false }, contextSavings_has: false };
    normalize_policy(policy_doc, cwd, &norm);
    if !norm.tools.extractToFile {
        let em = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_assign(&em, STR_PTR("action 'extract_to_file' is disabled in current VM policy; enable extractToFile in VM settings"), STR_LEN("action 'extract_to_file' is disabled in current VM policy; enable extractToFile in VM settings"));
        let rsn = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_assign(&rsn, STR_PTR("extractToFile disabled"), STR_LEN("extractToFile disabled"));
        res_capability2(out, &em, &rsn, started_at);
        return 0;
    };
    let rsn = StrBuf { bytes: [0u8; 65536], len: 0 };
    if !toolCheckPath(&norm, 1, &source, cwd, &rsn) {
        let em = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_assign(&em, STR_PTR("Policy violation on source: "), STR_LEN("Policy violation on source: "));
        if rsn.len > 0 { sb_append(&em, sb_ptr(&rsn), rsn.len); } else { sb_append(&em, STR_PTR("write not allowed"), STR_LEN("write not allowed")); };
        res_capability2(out, &em, &rsn, started_at);
        return 0;
    };
    if !toolCheckPath(&norm, 1, &target, cwd, &rsn) {
        let em = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_assign(&em, STR_PTR("Policy violation on target: "), STR_LEN("Policy violation on target: "));
        if rsn.len > 0 { sb_append(&em, sb_ptr(&rsn), rsn.len); } else { sb_append(&em, STR_PTR("write not allowed"), STR_LEN("write not allowed")); };
        res_capability2(out, &em, &rsn, started_at);
        return 0;
    };
    let full_source = StrBuf { bytes: [0u8; 65536], len: 0 };
    path_resolve(cwd, &source, &full_source);
    let full_target = StrBuf { bytes: [0u8; 65536], len: 0 };
    path_resolve(cwd, &target, &full_target);
    if !fs_exists_sb(&full_source) {
        let em = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_assign(&em, STR_PTR("Source file does not exist: "), STR_LEN("Source file does not exist: "));
        sb_append(&em, sb_ptr(&source), source.len);
        res_sa_error(out, sb_ptr(&em), em.len, started_at);
        return 0;
    };
    let content = StrBuf { bytes: [0u8; 65536], len: 0 };
    if fs_read_sb(&full_source, 65536, &content) != 0 {
        res_sa_error(out, STR_PTR("failed to read source file"), STR_LEN("failed to read source file"), started_at);
        return 0;
    };
    let total_lines: u64 = split_line_count(&content);
    let s_line: u64 = 1;
    if has_start {
        s_line = start_line as u64;
        if s_line < 1 { s_line = 1; };
    };
    let e_line: u64 = total_lines;
    if has_end {
        e_line = end_line as u64;
        if e_line > total_lines { e_line = total_lines; };
    };
    if s_line > e_line || s_line > total_lines {
        let em = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_assign(&em, STR_PTR("Invalid line range [L"), STR_LEN("Invalid line range [L"));
        tool_sb_append_u64(s_line, &em);
        sb_append(&em, STR_PTR("-L"), STR_LEN("-L"));
        tool_sb_append_u64(e_line, &em);
        sb_append(&em, STR_PTR("] for file with "), STR_LEN("] for file with "));
        tool_sb_append_u64(total_lines, &em);
        sb_append(&em, STR_PTR(" lines"), STR_LEN(" lines"));
        res_sa_error(out, sb_ptr(&em), em.len, started_at);
        return 0;
    };
    let odoc: u64 = jdoc_of_jb(options);
    let raw_mode: bool = false;
    let dry_run: bool = false;
    let keep_source: bool = false;
    let component_name = StrBuf { bytes: [0u8; 65536], len: 0 };
    let has_component_name: bool = false;
    let symbols = ListBuf { bytes: [0u8; 131072], len: 0 };
    let has_symbols_opt: bool = false;
    if odoc != 0 && sa_json_kind(odoc) == 7 {
        let rn: u64 = node_nonnull(odoc, STR_PTR("raw"), STR_LEN("raw"));
        if rn != 0 && sa_json_kind(rn) == 1 && sa_json_node_as_bool(rn) { raw_mode = true; };
        let mv = StrBuf { bytes: [0u8; 65536], len: 0 };
        if jget_str(odoc, STR_PTR("mode"), STR_LEN("mode"), &mv) && tool_bytes_eq(sb_ptr(&mv), mv.len, STR_PTR("raw"), STR_LEN("raw")) { raw_mode = true; };
        let dn: u64 = node_nonnull(odoc, STR_PTR("dry_run"), STR_LEN("dry_run"));
        if dn != 0 && sa_json_kind(dn) == 1 && sa_json_node_as_bool(dn) { dry_run = true; };
        let kn: u64 = node_nonnull(odoc, STR_PTR("keep_source"), STR_LEN("keep_source"));
        if kn != 0 && sa_json_kind(kn) == 1 && sa_json_node_as_bool(kn) { keep_source = true; };
        if jget_str(odoc, STR_PTR("component_name"), STR_LEN("component_name"), &component_name) { has_component_name = true; };
        let sn: u64 = node_nonnull(odoc, STR_PTR("symbols"), STR_LEN("symbols"));
        if sn != 0 {
            if sa_json_kind(sn) == 6 {
                has_symbols_opt = true;
                let cc: u64 = jcount(sn);
                let ci: u64 = 0;
                let cv = StrBuf { bytes: [0u8; 65536], len: 0 };
                while ci < cc {
                    let en: u64 = jarr_at(sn, ci);
                    if en != 0 && sa_json_kind(en) == 5 {
                        cv.len = 0;
