fn impl_pat_build(idx: u64, esc: &StrBuf, out: &StrBuf) -> void {
    out.len = 0;
    if idx == 0 {
        sb_append(out, STR_PTR("\\bclass[[:space:]]+[A-Za-z0-9_$]+(<[^>]*>)?([[:space:]]+extends[[:space:]]+[^{]+)?[[:space:]]+implements[[:space:]]+[^{]*\\b"), STR_LEN("\\bclass[[:space:]]+[A-Za-z0-9_$]+(<[^>]*>)?([[:space:]]+extends[[:space:]]+[^{]+)?[[:space:]]+implements[[:space:]]+[^{]*\\b"));
        sb_append(out, sb_ptr(esc), esc.len);
        sb_append(out, STR_PTR("\\b"), STR_LEN("\\b"));
    } else if idx == 1 {
        sb_append(out, STR_PTR("\\bimplements[[:space:]]+[^{]*\\b"), STR_LEN("\\bimplements[[:space:]]+[^{]*\\b"));
        sb_append(out, sb_ptr(esc), esc.len);
        sb_append(out, STR_PTR("\\b"), STR_LEN("\\b"));
    } else if idx == 2 {
        sb_append(out, STR_PTR("\\bclass[[:space:]]+[A-Za-z0-9_$]+(<[^>]*>)?[[:space:]]+extends[[:space:]]+[^{]*\\b"), STR_LEN("\\bclass[[:space:]]+[A-Za-z0-9_$]+(<[^>]*>)?[[:space:]]+extends[[:space:]]+[^{]*\\b"));
        sb_append(out, sb_ptr(esc), esc.len);
        sb_append(out, STR_PTR("\\b"), STR_LEN("\\b"));
    } else if idx == 3 {
        sb_append(out, STR_PTR("\\binterface[[:space:]]+[A-Za-z0-9_$]+(<[^>]*>)?[[:space:]]+extends[[:space:]]+[^{]*\\b"), STR_LEN("\\binterface[[:space:]]+[A-Za-z0-9_$]+(<[^>]*>)?[[:space:]]+extends[[:space:]]+[^{]*\\b"));
        sb_append(out, sb_ptr(esc), esc.len);
        sb_append(out, STR_PTR("\\b"), STR_LEN("\\b"));
    } else if idx == 4 {
        sb_append(out, STR_PTR("\\bimpl(<[^>]*>)?[[:space:]]+"), STR_LEN("\\bimpl(<[^>]*>)?[[:space:]]+"));
        sb_append(out, sb_ptr(esc), esc.len);
        sb_append(out, STR_PTR("(<[^>]*>)?[[:space:]]+for[[:space:]]+"), STR_LEN("(<[^>]*>)?[[:space:]]+for[[:space:]]+"));
    } else if idx == 5 {
        sb_append(out, STR_PTR("\\bclass[[:space:]]+[A-Za-z0-9_]+[[:space:]]*\\([^)]*\\b"), STR_LEN("\\bclass[[:space:]]+[A-Za-z0-9_]+[[:space:]]*\\([^)]*\\b"));
        sb_append(out, sb_ptr(esc), esc.len);
        sb_append(out, STR_PTR("\\b[^)]*\\):"), STR_LEN("\\b[^)]*\\):"));
    } else if idx == 6 {
        sb_append(out, STR_PTR("(const|let|var)[[:space:]]+[A-Za-z0-9_$]+[[:space:]]*:[[:space:]]*([A-Za-z0-9_$]+<[^>]*>|\\b"), STR_LEN("(const|let|var)[[:space:]]+[A-Za-z0-9_$]+[[:space:]]*:[[:space:]]*([A-Za-z0-9_$]+<[^>]*>|\\b"));
        sb_append(out, sb_ptr(esc), esc.len);
        sb_append(out, STR_PTR("\\b)[[:space:]]*=[[:space:]]*\\{"), STR_LEN("\\b)[[:space:]]*=[[:space:]]*\\{"));
    } else if idx == 7 {
        sb_append(out, STR_PTR(":[[:space:]]*\\b"), STR_LEN(":[[:space:]]*\\b"));
        sb_append(out, sb_ptr(esc), esc.len);
        sb_append(out, STR_PTR("\\b[[:space:]]*=[[:space:]]*\\{"), STR_LEN("\\b[[:space:]]*=[[:space:]]*\\{"));
    } else if idx == 8 {
        sb_append(out, STR_PTR("\\b(as|satisfies)[[:space:]]+"), STR_LEN("\\b(as|satisfies)[[:space:]]+"));
        sb_append(out, sb_ptr(esc), esc.len);
        sb_append(out, STR_PTR("\\b"), STR_LEN("\\b"));
    } else if idx == 9 {
        sb_append(out, STR_PTR("(const|let|var)[[:space:]]+[A-Za-z0-9_$]+[[:space:]]*:[[:space:]]*\\b"), STR_LEN("(const|let|var)[[:space:]]+[A-Za-z0-9_$]+[[:space:]]*:[[:space:]]*\\b"));
        sb_append(out, sb_ptr(esc), esc.len);
        sb_append(out, STR_PTR("\\b[[:space:]]*=[[:space:]]*(async[[:space:]]*)?(\\(|function)"), STR_LEN("\\b[[:space:]]*=[[:space:]]*(async[[:space:]]*)?(\\(|function)"));
    } else if idx == 10 {
        sb_append(out, STR_PTR("\\bfunction[[:space:]]+[A-Za-z0-9_$]+(<[^>]*>)?[[:space:]]*\\([^)]*\\)[[:space:]]*:[[:space:]]*\\b"), STR_LEN("\\bfunction[[:space:]]+[A-Za-z0-9_$]+(<[^>]*>)?[[:space:]]*\\([^)]*\\)[[:space:]]*:[[:space:]]*\\b"));
        sb_append(out, sb_ptr(esc), esc.len);
        sb_append(out, STR_PTR("\\b"), STR_LEN("\\b"));
    } else {
        sb_append(out, STR_PTR("\\)[[:space:]]*:[[:space:]]*\\b"), STR_LEN("\\)[[:space:]]*:[[:space:]]*\\b"));
        sb_append(out, sb_ptr(esc), esc.len);
        sb_append(out, STR_PTR("\\b[[:space:]]*=>"), STR_LEN("\\b[[:space:]]*=>"));
    };
}

fn nativeFindImplementations(raw_symbol: &StrBuf, has_raw: bool, options: &JsonBuf, policy_doc: u64, cwd: &StrBuf, started_at: f64, out: &SaVmRunResult) -> i32 {
    let odoc: u64 = jdoc_of_jb(options);
    let symbol = StrBuf { bytes: [0u8; 65536], len: 0 };
    if has_raw {
        tool_sb_trim(raw_symbol, &symbol);
    };
    if symbol.len == 0 && odoc != 0 {
        let cand_keys = ListBuf { bytes: [0u8; 131072], len: 0 };
        lb_append(&cand_keys, STR_PTR("symbol"), STR_LEN("symbol"));
        lb_append(&cand_keys, STR_PTR("target"), STR_LEN("target"));
        lb_append(&cand_keys, STR_PTR("name"), STR_LEN("name"));
        lb_append(&cand_keys, STR_PTR("query"), STR_LEN("query"));
        lb_append(&cand_keys, STR_PTR("content"), STR_LEN("content"));
        let kv = StrBuf { bytes: [0u8; 65536], len: 0 };
        let ki: u64 = 0;
        while ki < 5 && symbol.len == 0 {
            let got: bool = lb_at(&cand_keys, ki, &kv);
            let vv = StrBuf { bytes: [0u8; 65536], len: 0 };
            if got && jget_str(odoc, sb_ptr(&kv), kv.len, &vv) {
                tool_sb_trim(&vv, &symbol);
            };
            ki = ki + 1;
        }
    };
    if symbol.len == 0 {
        if odoc != 0 { sa_json_free(odoc); };
        res_sa_error(out, STR_PTR("symbol parameter is required for find_implementations"), STR_LEN("symbol parameter is required for find_implementations"), started_at);
        return 0;
    };
