        } else if k == 7 {
            let cnt: u64 = jcount(doc);
            let key = StrBuf { bytes: [0u8; 65536], len: 0 };
            let i: u64 = 0;
            while i < cnt {
                let got: bool = jkey_copy(doc, i, &key);
                if got {
                    let child: u64 = jget_node(doc, sb_ptr(&key), key.len);
                    if child != 0 { jset_node(merged, sb_ptr(&key), key.len, child); };
                };
                i = i + 1;
            }
        };
    };
    if merged != 0 {
        jset_f64(merged, STR_PTR("startLine"), STR_LEN("startLine"), start_line);
        jset_f64(merged, STR_PTR("endLine"), STR_LEN("endLine"), end_line);
        let mjb = JsonBuf { bytes: [0u8; 262144], len: 0 };
        jdoc_to_jb(merged, &mjb);
        sa_json_free(merged);
        if doc != 0 { sa_json_free(doc); };
        let rc: i32 = nativeReadFile(path, &mjb, policy_doc, cwd, started_at, out);
        return rc;
    };
    return 1;
}

