                                    let lower = StrBuf { bytes: [0u8; 65536], len: 0 };
                                    sb_to_lower(&name, &lower);
                                    if sb_ends(&lower, STR_PTR(".ts"), STR_LEN(".ts")) || sb_ends(&lower, STR_PTR(".tsx"), STR_LEN(".tsx")) || sb_ends(&lower, STR_PTR(".js"), STR_LEN(".js")) || sb_ends(&lower, STR_PTR(".jsx"), STR_LEN(".jsx")) || sb_ends(&lower, STR_PTR(".mjs"), STR_LEN(".mjs")) || sb_ends(&lower, STR_PTR(".cjs"), STR_LEN(".cjs")) || sb_ends(&lower, STR_PTR(".rs"), STR_LEN(".rs")) || sb_ends(&lower, STR_PTR(".py"), STR_LEN(".py")) || sb_ends(&lower, STR_PTR(".go"), STR_LEN(".go")) || sb_ends(&lower, STR_PTR(".zig"), STR_LEN(".zig")) || sb_ends(&lower, STR_PTR(".java"), STR_LEN(".java")) || sb_ends(&lower, STR_PTR(".c"), STR_LEN(".c")) || sb_ends(&lower, STR_PTR(".cpp"), STR_LEN(".cpp")) || sb_ends(&lower, STR_PTR(".h"), STR_LEN(".h")) || sb_ends(&lower, STR_PTR(".vue"), STR_LEN(".vue")) || sb_ends(&lower, STR_PTR(".svelte"), STR_LEN(".svelte")) || sb_ends(&lower, STR_PTR(".json"), STR_LEN(".json")) || sb_ends(&lower, STR_PTR(".toml"), STR_LEN(".toml")) {
                                        lb_append(&targets, sb_ptr(&full), full.len);
                                    };
                                };
                            };
                        };
                        ii = ii + 1;
                    }
                };
            };
        }
    };
    // scan
    let flat_files = ListBuf { bytes: [0u8; 131072], len: 0 };
    let flat_entries = ListBuf { bytes: [0u8; 131072], len: 0 };
    let total_found: u64 = 0;
    let returned_count: u64 = 0;
    let est_tokens: f64 = 100.0;
    let file = StrBuf { bytes: [0u8; 65536], len: 0 };
    let ti: u64 = 0;
    let tcount: u64 = lb_count(&targets);
    while ti < tcount {
        if now_ms() - started_at > timeout_ms {
            timed_out = true;
            break;
        };
        let got: bool = lb_at(&targets, ti, &file);
        if got {
            let content = StrBuf { bytes: [0u8; 65536], len: 0 };
            if fs_read_sb(&file, 65536, &content) == 0 && re_handle_test(word_re, sb_ptr(&content), content.len) {
                let rel = StrBuf { bytes: [0u8; 65536], len: 0 };
                tool_path_relative(cwd, &file, &rel);
                let total_lines: u64 = 0;
                let maxlen: u64 = 0;
                text_line_stats(sb_ptr(&content), content.len, &total_lines, &maxlen);
                let line = StrBuf { bytes: [0u8; 65536], len: 0 };
                let idx: u64 = 1;
                while idx <= total_lines {
                    if now_ms() - started_at > timeout_ms {
                        timed_out = true;
                        break;
                    };
                    let ls: u64 = 0;
                    let ll: u64 = 0;
                    let found: bool = text_line_span(sb_ptr(&content), content.len, idx, &ls, &ll);
                    if found {
                        line.len = 0;
                        let lp: ptr = PTR_NULL();
                        PTR_BYTE_ADD(lp, sb_ptr(&content), ls);
                        sb_append(&line, lp, ll);
                        if re_handle_test(word_re, sb_ptr(&line), line.len) {
                            let trimmed = StrBuf { bytes: [0u8; 65536], len: 0 };
                            tool_sb_trim(&line, &trimmed);
                            let skip: bool = false;
                            if exclude_comments {
                                if sb_starts(&trimmed, STR_PTR("//"), STR_LEN("//")) || sb_starts(&trimmed, STR_PTR("#"), STR_LEN("#")) || sb_starts(&trimmed, STR_PTR("/*"), STR_LEN("/*")) || sb_starts(&trimmed, STR_PTR("*"), STR_LEN("*")) || sb_starts(&trimmed, STR_PTR("<!--"), STR_LEN("<!--")) || sb_starts(&trimmed, STR_PTR(";"), STR_LEN(";")) {
                                    skip = true;
                                };
                            };
                            if !skip {
                                let code = StrBuf { bytes: [0u8; 65536], len: 0 };
                                if re_handle_test(def_re, sb_ptr(&trimmed), trimmed.len) {
                                    sb_assign(&code, STR_PTR("e0"), STR_LEN("e0"));
                                } else if re_handle_test(imp_re, sb_ptr(&trimmed), trimmed.len) {
                                    sb_assign(&code, STR_PTR("e1"), STR_LEN("e1"));
                                } else {
                                    sb_assign(&code, STR_PTR("e2"), STR_LEN("e2"));
                                };
                                if !(code.len == 2 && code.bytes[0] == 101 && code.bytes[1] == 48) || include_decl {
                                    total_found = total_found + 1;
                                    if returned_count < max_results && est_tokens < max_tokens {
                                        let entry = StrBuf { bytes: [0u8; 65536], len: 0 };
                                        sb_append(&entry, STR_PTR("L"), STR_LEN("L"));
                                        tool_sb_append_u64(idx, &entry);
                                        sb_append(&entry, STR_PTR(":"), STR_LEN(":"));
                                        sb_append(&entry, sb_ptr(&code), code.len);
                                        if detail {
                                            sb_append(&entry, STR_PTR(":"), STR_LEN(":"));
                                            let take: u64 = trimmed.len;
                                            if take > 200 { take = 200; };
                                            sb_append(&entry, sb_ptr(&trimmed), take);
                                        };
                                        lb_append(&flat_files, sb_ptr(&rel), rel.len);
                                        lb_append(&flat_entries, sb_ptr(&entry), entry.len);
                                        returned_count = returned_count + 1;
                                        let et: f64 = (entry.len as f64) / 3.5;
                                        let eti: i64 = et as i64;
                                        if (eti as f64) < et { eti = eti + 1; };
                                        est_tokens = est_tokens + (eti as f64) + 3.0;
                                    };
                                };
                            };
                        };
                    };
                    idx = idx + 1;
                }
            };
        };
        ti = ti + 1;
    }
    if word_re != 0 { let rc1: i32 = sa_regex_free(word_re); };
    if def_re != 0 { let rc2: i32 = sa_regex_free(def_re); };
    if imp_re != 0 { let rc3: i32 = sa_regex_free(imp_re); };
    if timed_out && total_found == 0 {
        if odoc != 0 { sa_json_free(odoc); };
        let ob = JsonBuf { bytes: [0u8; 262144], len: 0 };
        jb_append(&ob, STR_PTR("{\n  \"symbol\": \""), STR_LEN("{\n  \"symbol\": \""));
        jescape_into(&symbol, &ob);
        jb_append(&ob, STR_PTR("\",\n  \"total\": 0,\n  \"returned\": 0,\n  \"truncated\": true,\n  \"timed_out\": true,\n  \"timeout_ms\": "), STR_LEN("\",\n  \"total\": 0,\n  \"returned\": 0,\n  \"truncated\": true,\n  \"timed_out\": true,\n  \"timeout_ms\": "));
        let t = StrBuf { bytes: [0u8; 65536], len: 0 };
        fmt_f64_sb(timeout_ms, &t);
        jb_append(&ob, sb_ptr(&t), t.len);
        jb_append(&ob, STR_PTR(",\n  \"types\": {\n    \"e0\": \"def\",\n    \"e1\": \"imp\",\n    \"e2\": \"use\"\n  },\n  \"files\": {}\n}"), STR_LEN(",\n  \"types\": {\n    \"e0\": \"def\",\n    \"e1\": \"imp\",\n    \"e2\": \"use\"\n  },\n  \"files\": {}\n}"));
        res_init(out);
        out.ok = false;
        res_set_kind(out, STR_PTR("timeout"), STR_LEN("timeout"));
        out.has_exitCode = true;
        out.exitCode = 124;
        res_set_stdout(out, jb_ptr(&ob), ob.len);
        let em = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_assign(&em, STR_PTR("find_references timed out after "), STR_LEN("find_references timed out after "));
        sb_append_f64(timeout_ms, &em);
        sb_append(&em, STR_PTR("ms (scanned "), STR_LEN("ms (scanned "));
        tool_sb_append_u64(tcount, &em);
        sb_append(&em, STR_PTR(" files without matches)"), STR_LEN(" files without matches)"));
        res_set_stderr(out, sb_ptr(&em), em.len);
        out.durationMs = dur_since(started_at);
        return 0;
    };
    // output ordering: insertion order, or file-sorted when paginated
    let order = U64List { items: [0u64; 4096], len: 0 };
    let flat_n: u64 = lb_count(&flat_files);
    let oi: u64 = 0;
    while oi < flat_n && order.len < 4096 {
        order.items[order.len] = oi;
        order.len = order.len + 1;
        oi = oi + 1;
    }
    let out_returned: u64 = returned_count;
    let tpages: u64 = 0;
    if pg.paginated {
        // stable sort order by file name
        let fa = StrBuf { bytes: [0u8; 65536], len: 0 };
        let fb = StrBuf { bytes: [0u8; 65536], len: 0 };
        let x: u64 = 1;
        while x < order.len {
            let key: u64 = order.items[x];
            let gk: bool = lb_at(&flat_files, key, &fa);
            let y: u64 = x;
            while y > 0 {
                let g2: bool = lb_at(&flat_files, order.items[y - 1], &fb);
                if bytes_cmp(&fb, &fa) <= 0 { break; };
                order.items[y] = order.items[y - 1];
                y = y - 1;
            }
            order.items[y] = key;
            x = x + 1;
        }
        let ps: u64 = pg.page_size as u64;
        if ps == 0 { ps = 1; };
        if flat_n > 0 { tpages = (flat_n + ps - 1) / ps; };
        let off: u64 = pg.offset as u64;
        let end: u64 = off + ps;
        if end > flat_n { end = flat_n; };
        let sliced_order = U64List { items: [0u64; 4096], len: 0 };
        let si2: u64 = off;
        while si2 < end && sliced_order.len < 4096 {
            sliced_order.items[sliced_order.len] = order.items[si2];
            sliced_order.len = sliced_order.len + 1;
            si2 = si2 + 1;
        }
        order = sliced_order;
        out_returned = order.len;
    };
    let ob = JsonBuf { bytes: [0u8; 262144], len: 0 };
    jb_append(&ob, STR_PTR("{\n  \"symbol\": \""), STR_LEN("{\n  \"symbol\": \""));
    jescape_into(&symbol, &ob);
    let t = StrBuf { bytes: [0u8; 65536], len: 0 };
    jb_append(&ob, STR_PTR("\",\n  \"total\": "), STR_LEN("\",\n  \"total\": "));
    fmt_u64_sb(total_found, &t);
    jb_append(&ob, sb_ptr(&t), t.len);
    jb_append(&ob, STR_PTR(",\n  \"returned\": "), STR_LEN(",\n  \"returned\": "));
    fmt_u64_sb(out_returned, &t);
    jb_append(&ob, sb_ptr(&t), t.len);
    jb_append(&ob, STR_PTR(",\n  \"truncated\": "), STR_LEN(",\n  \"truncated\": "));
    if total_found > out_returned || timed_out { jb_append(&ob, STR_PTR("true"), STR_LEN("true")); } else { jb_append(&ob, STR_PTR("false"), STR_LEN("false")); };
    if timed_out {
        jb_append(&ob, STR_PTR(",\n  \"timed_out\": true,\n  \"timeout_ms\": "), STR_LEN(",\n  \"timed_out\": true,\n  \"timeout_ms\": "));
        fmt_f64_sb(timeout_ms, &t);
        jb_append(&ob, sb_ptr(&t), t.len);
    };
    if pg.paginated {
        jb_append(&ob, STR_PTR(",\n  \"page\": "), STR_LEN(",\n  \"page\": "));
        fmt_f64_sb(pg.page, &t);
        jb_append(&ob, sb_ptr(&t), t.len);
        jb_append(&ob, STR_PTR(",\n  \"page_size\": "), STR_LEN(",\n  \"page_size\": "));
        fmt_f64_sb(pg.page_size, &t);
        jb_append(&ob, sb_ptr(&t), t.len);
        jb_append(&ob, STR_PTR(",\n  \"total_pages\": "), STR_LEN(",\n  \"total_pages\": "));
        fmt_u64_sb(tpages, &t);
        jb_append(&ob, sb_ptr(&t), t.len);
        jb_append(&ob, STR_PTR(",\n  \"has_next\": "), STR_LEN(",\n  \"has_next\": "));
        let hn: bool = false;
        if total_found >= (pg.count_cap as u64) || timed_out {
            hn = true;
        } else {
            let ps2: u64 = pg.page_size as u64;
            hn = (pg.offset as u64) + ps2 < flat_n;
        };
        if hn { jb_append(&ob, STR_PTR("true"), STR_LEN("true")); } else { jb_append(&ob, STR_PTR("false"), STR_LEN("false")); };
        jb_append(&ob, STR_PTR(",\n  \"has_prev\": "), STR_LEN(",\n  \"has_prev\": "));
        if pg.offset > 0.0 { jb_append(&ob, STR_PTR("true"), STR_LEN("true")); } else { jb_append(&ob, STR_PTR("false"), STR_LEN("false")); };
    };
    jb_append(&ob, STR_PTR(",\n  \"types\": {\n    \"e0\": \"def\",\n    \"e1\": \"imp\",\n    \"e2\": \"use\"\n  },\n  \"files\": "), STR_LEN(",\n  \"types\": {\n    \"e0\": \"def\",\n    \"e1\": \"imp\",\n    \"e2\": \"use\"\n  },\n  \"files\": "));
    if order.len == 0 {
        jb_append(&ob, STR_PTR("{}"), STR_LEN("{}"));
    } else {
        jb_append(&ob, STR_PTR("{"), STR_LEN("{"));
        let cur_file = StrBuf { bytes: [0u8; 65536], len: 0 };
        let ef = StrBuf { bytes: [0u8; 65536], len: 0 };
        let ee = StrBuf { bytes: [0u8; 65536], len: 0 };
        let first_group: bool = true;
        let first_entry: bool = true;
        let ki: u64 = 0;
        while ki < order.len {
            let ix: u64 = order.items[ki];
            let g1: bool = lb_at(&flat_files, ix, &ef);
            let g2: bool = lb_at(&flat_entries, ix, &ee);
            if first_group || !tool_bytes_eq(sb_ptr(&ef), ef.len, sb_ptr(&cur_file), cur_file.len) {
                if !first_group {
                    jb_append(&ob, STR_PTR("\n    ],"), STR_LEN("\n    ],"));
                };
                jb_append(&ob, STR_PTR("\n    \""), STR_LEN("\n    \""));
                jescape_into(&ef, &ob);
                jb_append(&ob, STR_PTR("\": ["), STR_LEN("\": ["));
                sb_copy(&cur_file, &ef);
                first_group = false;
                first_entry = true;
            };
            if !first_entry { jb_append(&ob, STR_PTR(","), STR_LEN(",")); };
            jb_append(&ob, STR_PTR("\n      \""), STR_LEN("\n      \""));
            jescape_into(&ee, &ob);
            jb_append(&ob, STR_PTR("\""), STR_LEN("\""));
            first_entry = false;
            ki = ki + 1;
        }
        jb_append(&ob, STR_PTR("\n    ]\n  }"), STR_LEN("\n    ]\n  }"));
    };
    jb_append(&ob, STR_PTR("\n}"), STR_LEN("\n}"));
    // events
    let ev: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    let eo: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    if ev != 0 && eo != 0 {
        jset_i64(eo, STR_PTR("timestamp"), STR_LEN("timestamp"), sa_time_unix_ms());
        jset_str(eo, STR_PTR("type"), STR_LEN("type"), STR_PTR("references_found"), STR_LEN("references_found"));
        jset_str(eo, STR_PTR("symbol"), STR_LEN("symbol"), sb_ptr(&symbol), symbol.len);
        jset_f64(eo, STR_PTR("total"), STR_LEN("total"), total_found as f64);
        jset_f64(eo, STR_PTR("returned"), STR_LEN("returned"), returned_count as f64);
        let rcp: i32 = sa_json_array_push_node(ev, eo);
        let ejb = JsonBuf { bytes: [0u8; 262144], len: 0 };
        jdoc_to_jb(ev, &ejb);
        res_success(out, started_at);
        res_set_stdout(out, jb_ptr(&ob), ob.len);
        res_set_events(out, jb_ptr(&ejb), ejb.len);
        let bfix7182: i32 = sa_json_free(ev);
    } else {
        res_success(out, started_at);
        res_set_stdout(out, jb_ptr(&ob), ob.len);
        if ev != 0 { sa_json_free(ev); };
    };
    if timed_out {
        let em = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_assign(&em, STR_PTR("[timeout] find_references reached timeout limit of "), STR_LEN("[timeout] find_references reached timeout limit of "));
        sb_append_f64(timeout_ms, &em);
        sb_append(&em, STR_PTR("ms; returning "), STR_LEN("ms; returning "));
        tool_sb_append_u64(total_found, &em);
        sb_append(&em, STR_PTR(" partial matches"), STR_LEN(" partial matches"));
        res_set_stderr(out, sb_ptr(&em), em.len);
    };
    if odoc != 0 { sa_json_free(odoc); };
    return 0;
}

