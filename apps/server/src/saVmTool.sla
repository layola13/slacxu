    let ncontents = ListBuf { bytes: [0u8; 131072], len: 0 };
    let nlevels = ListBuf { bytes: [0u8; 131072], len: 0 };
    let nupds = F64List { items: [0.0; 4096], len: 0 };
    let kv = StrBuf { bytes: [0u8; 65536], len: 0 };
    let ii: u64 = 0;
    while ii < initial {
        let g1: bool = lb_at(&keys, ii, &kv);
        if !tool_bytes_eq(sb_ptr(&kv), kv.len, sb_ptr(&key), key.len) {
            lb_append(&nkeys, sb_ptr(&kv), kv.len);
            let g2: bool = lb_at(&contents, ii, &kv);
            lb_append(&ncontents, sb_ptr(&kv), kv.len);
            let g3: bool = lb_at(&levels, ii, &kv);
            lb_append(&nlevels, sb_ptr(&kv), kv.len);
            if nupds.len < 4096 { nupds.items[nupds.len] = upds.items[ii]; nupds.len = nupds.len + 1; };
        };
        ii = ii + 1;
    }
    let remaining: u64 = lb_count(&nkeys);
    let deleted: bool = remaining < initial;
    let now: i64 = sa_time_unix_ms();
    if deleted {
        notes_rebuild(doc, &nkeys, &ncontents, &nlevels, &nupds);
        jset_i64(doc, STR_PTR("updated_at"), STR_LEN("updated_at"), now);
        atomicSaveWorkspaceNotes(&mem_file, doc);
    };
    let payload: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    if payload != 0 {
        jset_str(payload, STR_PTR("action"), STR_LEN("action"), sb_ptr(&ra), ra.len);
        jset_str(payload, STR_PTR("key"), STR_LEN("key"), sb_ptr(&key), key.len);
        if deleted { jset_bool(payload, STR_PTR("deleted"), STR_LEN("deleted"), true); } else { jset_bool(payload, STR_PTR("deleted"), STR_LEN("deleted"), false); };
        jset_f64(payload, STR_PTR("remaining_notes"), STR_LEN("remaining_notes"), remaining as f64);
        jset_f64(payload, STR_PTR("remaining_memories"), STR_LEN("remaining_memories"), remaining as f64);
