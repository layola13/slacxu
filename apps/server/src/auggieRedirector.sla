// DEFECT: async — readJson uses for-await over http.IncomingMessage stream in TS.
fn readJson(headersContentLength: u64, raw_ptr: ptr, raw_len: u64, out: &JsonBuf) -> void {
    // 源 L1221-L1240: content-length <=0/invalid -> {}; concat chunks up to length; JSON.parse utf-8;
    // parse failure -> {_raw: rawText} degraded fallback (mirrors main.py)
    // DEFECT: Buffer.concat / Buffer utf-8 decode approximated by caller-supplied raw buffer.
    out.len = raw_len;
}

fn sendJson(status: u64, value_ptr: ptr, value_len: u64, outStatus: &u64, outBody: &JsonBuf) -> void {
    // 源 L1242-L1252 (+ file end): JSON.stringify -> Buffer utf-8; writeHead(status, Content-Type json, Content-Length, Cache-Control no-cache); res.end(data)
    // DEFECT: http.ServerResponse writeHead/end has no counterpart; (status, body) pair returned to handleRequest dispatcher.
    *outStatus = status;
    outBody.len = value_len;
}
