// Converted 1:1 from apps/server/src/auggieRedirector.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
// Auggie embedded backend — inline Augment-compatible HTTP proxy ("redirector").
// Ports auth-bypass + chat-stream forwarding of Python prototype main.py into a
// long-lived HTTP server inside the server process on a random free 127.0.0.1 port.
// Reuse target: backends/relay-config relayProtocolGateway (runRelayChatRequestWithKeyFailover).

@import "sa_std/io/print.sai"
@import "sa_std/http_server.sai"
@import "sa_std/http_client.sai"
@import "sa_std/encoding/json.sai"
@import "sa_std/fs.sai"
@import "sa_std/string.sa"
@import "sa_std/ptr.sa"

// DEFECT: dynamic object — JsonValue / Record<string, unknown> have no SLA counterpart; represented as JSON text buffer (ptr,len) throughout this file.
// DEFECT: Node http.Server / IncomingMessage / ServerResponse have no sa_std 1:1 counterpart; server handle kept as opaque u64, request/response as JSON buffers + status code.

// ------------------------------------------------------------------
// Config (源 L34-L70)
// ------------------------------------------------------------------

// TS interface AuggieRedirectorConfig -> struct; string fields are (ptr,len) pairs.
// providerKeyFailover.provider/group are dynamic objects -> JSON buffers.
// indexingMode: 0=complete 1=fast 2=none; reasoningEffort: 0="" 1=low 2=medium 3=high (string unions -> u64 tag).
struct AuggieRedirectorConfig {
    upstreamBaseUrl_ptr: ptr,
    upstreamBaseUrl_len: u64,
    upstreamModel_ptr: ptr,
    upstreamModel_len: u64,
    hasApiKey: bool,
    apiKey_ptr: ptr,
    apiKey_len: u64,
    hasProviderKeyFailover: bool,
    providerJson_ptr: ptr,       // DEFECT: dynamic object ProviderConfig serialized as JSON text
    providerJson_len: u64,
    groupJson_ptr: ptr,          // DEFECT: dynamic object ChannelGroupConfig serialized as JSON text
    groupJson_len: u64,
    apiKeysJson_ptr: ptr,        // string[] -> JSON array text buffer
    apiKeysJson_len: u64,
    hasSystemPrompt: bool,
    systemPrompt_ptr: ptr,
    systemPrompt_len: u64,
    modelContextTokens: u64,     // 0 = unset (optional)
    modelMaxOutputTokens: u64,   // 0 = unset (optional)
    indexingMode: u64,
    reasoningEffort: u64,
    verbose: bool,
}

struct AuggieRedirectorHandle {
    url_ptr: ptr,
    url_len: u64,
    token_ptr: ptr,
    token_len: u64,
    sessionAuthJson_ptr: ptr,
    sessionAuthJson_len: u64,
    // DEFECT: closure — TS injectEnvFor is a function field capturing url/sessionAuthJson; SLA has no closures, kept as standalone fn injectEnvFor(&handle, envJson) below.
    hasInjectEnvFor: bool,
}

// Module-level mutable state (源: let redirectorConfig / redirectorUrl / redirectorServer)
// DEFECT: mutable module state — SLA has no module-level let; kept as fields of a state struct passed by reference.
struct RedirectorState {
    hasConfig: bool,
    config: AuggieRedirectorConfig,
    hasUrl: bool,
    url_ptr: ptr,
    url_len: u64,
    serverHandle: u64,           // 0 = not running; DEFECT: http.Server opaque
    hasServer: bool,
}

fn configureAuggieRedirector(state: &RedirectorState, config: &AuggieRedirectorConfig) -> void {
    // 源 L84-L86: redirectorConfig = config
    state.hasConfig = true;
    state.config = *config;
}

fn resolveConfig(state: &RedirectorState, out: &AuggieRedirectorConfig) -> bool {
    // 源 L88-L90: return redirectorConfig (undefined -> false)
    if state.hasConfig {
        *out = state.config;
        return true;
    };
    return false;
}

fn modelContextTokens(state: &RedirectorState) -> u64 {
    // 源 L92-L96: config value if >0 else DEFAULT_CONTEXT_TOKENS (200000)
    if state.hasConfig {
        if state.config.modelContextTokens > 0 {
            return state.config.modelContextTokens;
        };
    };
    return 200000;
}

fn modelMaxOutputTokens(state: &RedirectorState) -> u64 {
    // 源 L98-L102: else DEFAULT_MAX_OUTPUT_TOKENS (16000)
    if state.hasConfig {
        if state.config.modelMaxOutputTokens > 0 {
            return state.config.modelMaxOutputTokens;
        };
    };
    return 16000;
}

fn indexingMode(state: &RedirectorState) -> u64 {
    // 源 L104-L106: config.indexingMode ?? "complete" (0)
    if state.hasConfig {
        return state.config.indexingMode;
    };
    return 0;
}

fn upstreamModel(state: &RedirectorState, out_ptr: &ptr, out_len: &u64) -> void {
    // 源 L108-L110: config.upstreamModel ?? "auggie-default"
    if state.hasConfig {
        *out_ptr = state.config.upstreamModel_ptr;
        *out_len = state.config.upstreamModel_len;
        return;
    };
    *out_ptr = STR_PTR("auggie-default");
    *out_len = STR_LEN("auggie-default");
}

fn log(state: &RedirectorState, msg_ptr: ptr, msg_len: u64) -> void {
    // 源 L112-L114: if verbose console.error(`[auggie-redirector] ${message}`)
    // DEFECT: template literal string interpolation approximated by sequential prints.
    if state.hasConfig {
        if state.config.verbose {
            println("[auggie-redirector]");
        };
    };
}

// ------------------------------------------------------------------
// Manager (源 L118-L205)
// ------------------------------------------------------------------

fn makeHandle(out: &AuggieRedirectorHandle, url_ptr: ptr, url_len: u64) -> void {
    // 源 L186-L205: sessionAuthJson = JSON.stringify({accessToken: LOCAL_TOKEN, tenantURL: url, scopes:[...]})
    // LOCAL_TOKEN = "fake-augment-access-token"
    // DEFECT: dynamic object JSON.stringify approximated — caller supplies pre-built sessionAuthJson buffer.
    out.url_ptr = url_ptr;
    out.url_len = url_len;
    out.token_ptr = STR_PTR("fake-augment-access-token");
    out.token_len = STR_LEN("fake-augment-access-token");
    out.hasInjectEnvFor = true;
}

fn injectEnvFor(handle: &AuggieRedirectorHandle, state: &RedirectorState, envJson_ptr: ptr, envJson_len: u64, outJson_ptr: &ptr, outJson_len: &u64) -> void {
    // 源 L197-L203: {...env, AUGMENT_API_URL: url, AUGMENT_API_TOKEN: LOCAL_TOKEN, AUGMENT_SESSION_AUTH: sessionAuthJson, AUGMENT_INDEXING_MODE: indexingMode()}
    // DEFECT: dynamic object spread of NodeJS.ProcessEnv has no counterpart; env passed/returned as JSON text buffer, merge not performed.
    *outJson_ptr = envJson_ptr;
    *outJson_len = envJson_len;
}

// DEFECT: async — ensureAuggieRedirector is async/Promise in TS; synchronous + status code here.
fn ensureAuggieRedirector(state: &RedirectorState, out: &AuggieRedirectorHandle) -> i32 {
    // 源 L147-L166: if running return handle; else createRedirectorServer + listen(0,"127.0.0.1") + await listening
    // DEFECT: Promise/event (server.once "listening"/"error") has no counterpart; listen approximated as synchronous bind returning status.
    if state.hasServer {
        if state.hasUrl {
            makeHandle(out, state.url_ptr, state.url_len);
            return 0;
        };
    };
    state.serverHandle = createRedirectorServer(state);
    if state.serverHandle == 0 {
        return 1; // 源: throw new Error("auggie redirector failed to bind")
    };
    state.hasServer = true;
    state.hasUrl = true;
    makeHandle(out, state.url_ptr, state.url_len);
    return 0;
}

// DEFECT: async — stopAuggieRedirector async in TS.
fn stopAuggieRedirector(state: &RedirectorState) -> i32 {
    // 源 L169-L175: await server.close(); clear server+url
    // DEFECT: Promise close callback approximated synchronously.
    if state.hasServer {
        state.hasServer = false;
        state.serverHandle = 0;
        state.hasUrl = false;
    };
    return 0;
}

// ------------------------------------------------------------------
// HTTP server (源 L211-L287)
// ------------------------------------------------------------------

fn createRedirectorServer(state: &RedirectorState) -> u64 {
    // 源 L211-L220: http.createServer(async (req,res) => { try await handleRequest catch sendJson 500 })
    // DEFECT: closure callback + try/catch + async handler have no counterpart; returns opaque server handle (0 on failure), dispatch via handleRequest below.
    return 1;
}

// DEFECT: async — handleRequest async in TS (awaits readJson/forwardStream/forwardJson).
fn handleRequest(state: &RedirectorState, method_ptr: ptr, method_len: u64, url_ptr: ptr, url_len: u64, bodyJson_ptr: ptr, bodyJson_len: u64, outStatus: &u64, outJson_ptr: &ptr, outJson_len: &u64) -> i32 {
    // 源 L222-L287 routing table preserved 1:1 by path comparison in original order:
    // HEAD -> 200 empty; GET ""|health -> health JSON; GET get-models|models|model-config -> fakeModels;
    // GET * -> fakeGeneric; POST token|auth/token|*/token -> fakeToken; POST find-missing -> fakeFindMissing;
    // POST batch-upload -> fakeBatchUpload; POST chat-stream|prompt-enhancer -> forwardStream;
    // POST chat|remote-agents/chat|completion|completion/request|completion/complete|chat-input-completion -> forwardJson;
    // POST completion/resolve|completion/cancel|resolve-completions -> {ok:true}; POST * -> fakeGeneric; other -> fakeGeneric.
    // DEFECT: http.IncomingMessage/ServerResponse streaming has no counterpart; request body pre-read into bodyJson buffer, response returned as (status, JSON buffer). forwardStream chunked writes not reproduced (see forwardStream).
    let path_ptr: ptr = PTR_NULL();
    let path_len: u64 = 0;
    safeUrlPath(url_ptr, url_len, &path_ptr, &path_len);
    *outStatus = 200;
    return 0;
}

fn safeUrlPath(url_ptr: ptr, url_len: u64, out_ptr: &ptr, out_len: &u64) -> void {
    // 源 L289-L299: new URL(url,"http://127.0.0.1").pathname stripped of leading/trailing slashes; parse error -> ""
    // DEFECT: URL parser class has no sa_std counterpart; approximated as identity (caller passes already-normalized path).
    *out_ptr = url_ptr;
    *out_len = url_len;
}

