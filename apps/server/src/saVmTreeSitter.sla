// Converted 1:1 from apps/server/src/saVmTreeSitter.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
// NOTE: single-file sequential conversion of the 2,699-line tree-sitter /
// TypeScript-compiler helper module. web-tree-sitter (WASM) and the
// `typescript` compiler package have no sa_std counterpart; tree-sitter
// Node objects are represented as u64 handles into a host-side node table
// and the assumed ts_node_* / ts_parser_* extern surface is listed below
// (NOT in sa_std — see defect log). TS-compiler-AST functions
// (organizeImports / analyzeBlockScope / LanguageService family) are
// converted structurally with DEFECT markers where `any`-typed AST
// semantics cannot be expressed.

@import "sa_std/io/print.sai"
@import "sa_std/ptr.sa"
@import "sa_std/string.sa"
@import "sa_std/tree_sitter.sai"
@import "sa_std/globals.sai"
