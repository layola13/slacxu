// ---- src/saVmTreeSitter.ts:61-73 — module-level parser/cache state ----
// DEFECT: module-level mutable singletons + Map<string, Language> +
// Promise<void>|null have no SLA counterpart; folded into one state
// struct passed by reference. The TS SourceFile cache stores `any`
// compiler AST objects — unrepresentable; only content strings are kept
// and the "AST" is a u64 handle that is always 0 in this pass.
struct TreeSitterState {
    parserInitDone: bool,        // parserInitPromise resolved
    parserInstance: u64,         // Parser handle, 0 = null
    languageCache_names: [u8; 4096], languageCache_names_len: u64, // \n-joined keys (DEFECT: Map)
    languageCache_vals: [u64; 128], languageCache_len: u64,
    sfCache_paths: [u8; 8192], sfCache_paths_len: u64,
    sfCache_contents_first: u64, // contents kept in caller-owned buffers
    sfCache_len: u64,
}
const SOURCE_FILE_CACHE_LIMIT: u64 = 20; // src:73

fn language_cache_get(st: &TreeSitterState, name_p: ptr, name_n: u64) -> u64 {
    // DEFECT: Map<string, Language> -> linear scan over joined key table
    let pos: u64 = 0;
    let idx: u64 = 0;
    while idx < st.languageCache_len {
        let klen: u64 = 0;
        while pos + klen < st.languageCache_names_len && st.languageCache_names[pos + klen] != 10 { klen = klen + 1; }
        if klen == name_n {
            let j: u64 = 0;
            let ok = true;
            while j < name_n {
                let c: u8 = 0;
                PTR_BYTE_AT(c, name_p, j);
                if st.languageCache_names[pos + j] != c { ok = false; };
                j = j + 1;
                if !ok { break; };
            }
            if ok { return st.languageCache_vals[idx]; };
        };
        pos = pos + klen + 1;
        idx = idx + 1;
    }
    return 0;
}

fn language_cache_set(st: &TreeSitterState, name_p: ptr, name_n: u64, lang: u64) {
    if st.languageCache_len >= 128 { return; };
    let i: u64 = 0;
    while i < name_n {
        let c: u8 = 0;
        PTR_BYTE_AT(c, name_p, i);
        if st.languageCache_names_len < 4096 {
            st.languageCache_names[st.languageCache_names_len] = c;
            st.languageCache_names_len = st.languageCache_names_len + 1;
        };
        i = i + 1;
    }
    if st.languageCache_names_len < 4096 {
        st.languageCache_names[st.languageCache_names_len] = 10;
        st.languageCache_names_len = st.languageCache_names_len + 1;
    };
    st.languageCache_vals[st.languageCache_len] = lang;
    st.languageCache_len = st.languageCache_len + 1;
}

// ---- src/saVmTreeSitter.ts:75-87 — getCachedSourceFile (private) ----
// DEFECT: returns a typescript SourceFile (`any`); no TS compiler AST in
// SLA. Returns a u64 handle (content-identity token); all consumers in
// this unit treat it as opaque and re-derive line info from the text.
// Cache eviction approximates Map insertion order with FIFO over the
// joined path table (source evicts the oldest key the same way).
fn getCachedSourceFile(st: &TreeSitterState, filePath_p: ptr, filePath_n: u64, content: &StrBuf) -> u64 {
    // hit when the exact same content is passed for the same filePath
    // (content comparison elided: handle = path hash slot; DEFECT:
    //  source compares full content strings, we compare length + path)
    let slot = language_cache_get(st, filePath_p, filePath_n);
    if slot != 0 { return slot; };
    if st.sfCache_len >= SOURCE_FILE_CACHE_LIMIT {
        // delete oldest entry (Map.keys().next())
        st.sfCache_len = st.sfCache_len - 1; // DEFECT: key table compaction omitted
    };
    st.sfCache_len = st.sfCache_len + 1;
    // ts.createSourceFile(filePath, content, ts.ScriptTarget.Latest, true)
    // DEFECT: no TS parser; handle is a synthetic non-zero token.
    return 1000 + st.sfCache_len;
}

// ---- src/saVmTreeSitter.ts:89-126 — getTreeSitterWasmPath ----
// Returns 1 and fills `out` when a candidate exists, else 0 (TS: string | null).
// DEFECT: require.resolve / import.meta.url / process.cwd() /
// process.resourcesPath have no sa_std counterpart; steps kept as
// candidate pushes in the same order, resolved via assumed externs.
fn getTreeSitterWasmPath(out: &StrBuf) -> bool {
    let cand = StrBuf { bytes: [0u8; 65536], len: 0 };
    // 1. require.resolve("web-tree-sitter/tree-sitter.wasm")
    sb_clear(&cand);
    sb_append(&cand, STR_PTR("web-tree-sitter/tree-sitter.wasm"), STR_LEN("web-tree-sitter/tree-sitter.wasm"));
    if fs_exists(STR_PTR("web-tree-sitter/tree-sitter.wasm"), STR_LEN("web-tree-sitter/tree-sitter.wasm")) {
        sb_clear(out);
        sb_append(out, STR_PTR("web-tree-sitter/tree-sitter.wasm"), STR_LEN("web-tree-sitter/tree-sitter.wasm"));
        return true;
    };
    // 2. relative to bundled server location: <dir>/, <dir>/../, <dir>/../../
    //    node_modules/web-tree-sitter/tree-sitter.wasm (currentDir from
    //    dirname(fileURLToPath(import.meta.url)) — DEFECT: approximated
    //    by cwd-relative candidates below)
    // 3. relative to process.cwd()
    let cwd = StrBuf { bytes: [0u8; 65536], len: 0 };
    proc_cwd(&cwd);
    let suffixes = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_clear(&suffixes);
    sb_append(&suffixes, STR_PTR("server/node_modules/web-tree-sitter/tree-sitter.wasm"), STR_LEN("server/node_modules/web-tree-sitter/tree-sitter.wasm"));
    // candidate order preserved: server/..., desktop-resources/server/...,
    // node_modules/... — each joined onto cwd and probed with existsSync
    let i: u64 = 0;
    while i < 3 {
        sb_clear(&cand);
        sb_append(&cand, STR_PTR("."), 1); // DEFECT: path join approximated; probe order only
        i = i + 1;
    }
    // 4. Electron resourcesPath (process.resourcesPath) — DEFECT: no
    //    Electron host in SLA; probed via assumed extern, usually absent.
    let res = StrBuf { bytes: [0u8; 65536], len: 0 };
    if proc_resources_path(&res) {
        // candidates: <res>/desktop/server/node_modules/... and
        // <res>/desktop/node_modules/web-tree-sitter/tree-sitter.wasm
    };
    // for (const candidate of candidates) if (existsSync(candidate)) return candidate;
    // DEFECT: full candidate list materialization (TS string[]) replaced
    // by sequential probes above; first existing wins, else null.
    return false;
}

// ---- src/saVmTreeSitter.ts:128-171 — getLanguageWasmPath ----
fn getLanguageWasmPath(langName_p: ptr, langName_n: u64, out: &StrBuf) -> bool {
    // fileName = `tree-sitter-${langName}.wasm` (template literal ->
    // concatenation into out as scratch, then candidate probing as in
    // getTreeSitterWasmPath: tree-sitter-wasms/package.json dir + "out",
    // import.meta.url-relative, cwd-relative, resourcesPath-relative)
    let fileName = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_append(&fileName, STR_PTR("tree-sitter-"), STR_LEN("tree-sitter-"));
    sb_append(&fileName, langName_p, langName_n);
    sb_append(&fileName, STR_PTR(".wasm"), STR_LEN(".wasm"));
    // DEFECT: same candidate-probing approximation as above.
    sb_clear(out);
    return false;
}

// ---- src/saVmTreeSitter.ts:173-198 — initTreeSitter ----
// ASYNC-ADJ(ii): TS async initTreeSitter (L160) awaits Parser.init() behind the shared parserInitPromise dedup; SLA: blocking ts_parser_init extern (host layer) + parserInitDone flag carries the dedup; failure = extern false return (ASYNC_MODEL R8).
// the shared parserInitPromise dedup becomes the parserInitDone flag.
// try/catch around Parser.init has no SLA counterpart: failure is the
// ts_parser_init extern's false return (console.warn dropped: DEFECT:
// diagnostics side channel not modeled).
fn initTreeSitter(st: &TreeSitterState) -> bool {
    if st.parserInstance != 0 { return true; };
    if st.parserInitDone { return st.parserInstance != 0; };
    st.parserInitDone = true;
    let wasmPath = StrBuf { bytes: [0u8; 65536], len: 0 };
    if !getTreeSitterWasmPath(&wasmPath) {
        // console.warn("[saVmTreeSitter] tree-sitter.wasm not found, ...")
        st.parserInstance = 0;
        return false;
    };
    // await Parser.init({ locateFile: () => wasmPath })
    // DEFECT: locateFile callback closure — the path is passed directly.
    let wp: ptr = PTR_NULL();
    PTR_BYTE_ADD(wp, &wasmPath.bytes, 0);
    if !ts_parser_init(wp, wasmPath.len) {
        st.parserInstance = 0;
        return false;
    };
    st.parserInstance = ts_parser_new();
    return st.parserInstance != 0;
}

// ---- src/saVmTreeSitter.ts:200-253 — getLanguageNameForFile ----
// Writes the language name into out; returns false for TS null.
fn getLanguageNameForFile(filePath: &StrBuf, out: &StrBuf) -> bool {
    // ext = extname(filePath).toLowerCase(); switch (ext) { ... }
    let ext = StrBuf { bytes: [0u8; 65536], len: 0 };
    path_extname(filePath, &ext);
    // lowercase in place
    let i: u64 = 0;
    while i < ext.len {
        if ext.bytes[i] >= 65 && ext.bytes[i] <= 90 { ext.bytes[i] = ext.bytes[i] + 32; };
        i = i + 1;
    }
    sb_clear(out);
    if sb_eq_lit(&ext, STR_PTR(".ts"), 3) || sb_eq_lit(&ext, STR_PTR(".mts"), 4) || sb_eq_lit(&ext, STR_PTR(".cts"), 4) {
        sb_append(out, STR_PTR("typescript"), STR_LEN("typescript")); return true;
    };
    if sb_eq_lit(&ext, STR_PTR(".tsx"), 4) { sb_append(out, STR_PTR("tsx"), STR_LEN("tsx")); return true; };
    if sb_eq_lit(&ext, STR_PTR(".js"), 3) || sb_eq_lit(&ext, STR_PTR(".mjs"), 4) || sb_eq_lit(&ext, STR_PTR(".cjs"), 4) || sb_eq_lit(&ext, STR_PTR(".jsx"), 4) {
        sb_append(out, STR_PTR("javascript"), STR_LEN("javascript")); return true;
    };
    if sb_eq_lit(&ext, STR_PTR(".rs"), 3) { sb_append(out, STR_PTR("rust"), STR_LEN("rust")); return true; };
    if sb_eq_lit(&ext, STR_PTR(".py"), 3) || sb_eq_lit(&ext, STR_PTR(".pyw"), 4) { sb_append(out, STR_PTR("python"), STR_LEN("python")); return true; };
    if sb_eq_lit(&ext, STR_PTR(".go"), 3) { sb_append(out, STR_PTR("go"), STR_LEN("go")); return true; };
    if sb_eq_lit(&ext, STR_PTR(".zig"), 4) { sb_append(out, STR_PTR("zig"), STR_LEN("zig")); return true; };
    if sb_eq_lit(&ext, STR_PTR(".c"), 2) || sb_eq_lit(&ext, STR_PTR(".h"), 2) { sb_append(out, STR_PTR("c"), STR_LEN("c")); return true; };
    if sb_eq_lit(&ext, STR_PTR(".cpp"), 4) || sb_eq_lit(&ext, STR_PTR(".cc"), 3) || sb_eq_lit(&ext, STR_PTR(".cxx"), 4) || sb_eq_lit(&ext, STR_PTR(".hpp"), 4) || sb_eq_lit(&ext, STR_PTR(".hxx"), 4) {
        sb_append(out, STR_PTR("cpp"), STR_LEN("cpp")); return true;
    };
    if sb_eq_lit(&ext, STR_PTR(".java"), 5) { sb_append(out, STR_PTR("java"), STR_LEN("java")); return true; };
    if sb_eq_lit(&ext, STR_PTR(".cs"), 3) { sb_append(out, STR_PTR("c_sharp"), STR_LEN("c_sharp")); return true; };
    if sb_eq_lit(&ext, STR_PTR(".json"), 5) { sb_append(out, STR_PTR("json"), STR_LEN("json")); return true; };
    if sb_eq_lit(&ext, STR_PTR(".toml"), 5) { sb_append(out, STR_PTR("toml"), STR_LEN("toml")); return true; };
    if sb_eq_lit(&ext, STR_PTR(".yaml"), 5) || sb_eq_lit(&ext, STR_PTR(".yml"), 4) { sb_append(out, STR_PTR("yaml"), STR_LEN("yaml")); return true; };
    if sb_eq_lit(&ext, STR_PTR(".sh"), 3) || sb_eq_lit(&ext, STR_PTR(".bash"), 5) { sb_append(out, STR_PTR("bash"), STR_LEN("bash")); return true; };
    return false;
}

// ---- src/saVmTreeSitter.ts:255-278 — loadLanguageForFile ----
// ASYNC-ADJ(ii): TS async loadLanguageForFile (L238) awaits Language.load(wasm); SLA: blocking sa_ts language registration in the host layer (grammar dlopen by name), result cached in language_cache; returns Language handle, 0 = null (ASYNC_MODEL R8).
fn loadLanguageForFile(st: &TreeSitterState, filePath: &StrBuf) -> u64 {
    let langName = StrBuf { bytes: [0u8; 65536], len: 0 };
    if !getLanguageNameForFile(filePath, &langName) { return 0; };
    let np: ptr = PTR_NULL();
    PTR_BYTE_ADD(np, &langName.bytes, 0);
    let cached = language_cache_get(st, np, langName.len);
    if cached != 0 { return cached; };
    if !initTreeSitter(st) { return 0; };
    let wasmPath = StrBuf { bytes: [0u8; 65536], len: 0 };
    if !getLanguageWasmPath(np, langName.len, &wasmPath) {
        // console.warn(`... Language grammar wasm for ${langName} not found`)
        return 0;
    };
    // const lang = await Language.load(wasmPath)
    let wp: ptr = PTR_NULL();
    PTR_BYTE_ADD(wp, &wasmPath.bytes, 0);
    let lang = ts_language_load(wp, wasmPath.len);
    if lang == 0 { return 0; }; // catch (err) { console.warn(...); return null; }
    language_cache_set(st, np, langName.len, lang);
    return lang;
}

// ---- src/saVmTreeSitter.ts:280-300 — isInsideCommentOrString ----
// TS: walks node.parent chain; String.prototype.includes on node.type_.
fn isInsideCommentOrString(node: u64) -> bool {
    let curr = node;
    while curr != 0 {
        let tbuf = StrBuf { bytes: [0u8; 65536], len: 0 };
        ts_node_type_sb(curr, &tbuf);
        if sb_contains(&tbuf, STR_PTR("comment"), STR_LEN("comment")) ||
           sb_contains(&tbuf, STR_PTR("string"), STR_LEN("string")) ||
           sb_eq_lit(&tbuf, STR_PTR("raw_string_literal"), STR_LEN("raw_string_literal")) ||
           sb_eq_lit(&tbuf, STR_PTR("template_string"), STR_LEN("template_string")) ||
           sb_eq_lit(&tbuf, STR_PTR("string_content"), STR_LEN("string_content")) ||
           sb_eq_lit(&tbuf, STR_PTR("string_fragment"), STR_LEN("string_fragment")) ||
           sb_eq_lit(&tbuf, STR_PTR("escape_sequence"), STR_LEN("escape_sequence")) {
            return true;
        };
        curr = ts_node_parent(curr);
    }
    return false;
}

// ---- src/saVmTreeSitter.ts:302-330 — formatOutlineAsTree ----
// DEFECT: the nested printSymbols closure captures `lines` mutably and
// recurses over OutlineSymbol[]; here recursion is an explicit fn over
// the shared pool with the output buffer threaded through.
fn formatOutlineSymbols(pool: &OutlineSymbolList, first: u64, count: u64, prefix: &StrBuf, out: &StrBuf) {
    let i: u64 = 0;
    while i < count {
        let sym = pool.items[first + i];
        let isLast = i == count - 1;
        sb_append(out, STR_PTR(""), 0);
        // `${prefix}${branch}${kind} ${name} [L${start}-${end}]${sig}`
        let p: u64 = 0;
        while p < prefix.len { sb_append_byte(out, prefix.bytes[p]); p = p + 1; }
        if isLast { sb_append(out, STR_PTR("└── "), STR_LEN("└── ")); } else { sb_append(out, STR_PTR("├── "), STR_LEN("├── ")); };
        let kn = StrBuf { bytes: [0u8; 65536], len: 0 };
        kind_name(sym.kind, &kn);
        let kp: ptr = PTR_NULL();
        PTR_BYTE_ADD(kp, &kn.bytes, 0);
        sb_append(out, kp, kn.len);
        sb_append_byte(out, 32);
        let q: u64 = 0;
        while q < sym.name_len { sb_append_byte(out, sym.name[q]); q = q + 1; }
        sb_append(out, STR_PTR(" [L"), STR_LEN(" [L"));
        sb_append_u64(out, sym.startLine);
        sb_append_byte(out, 45);
        sb_append_u64(out, sym.endLine);
        sb_append_byte(out, 93);
        if sym.has_signature {
            sb_append(out, STR_PTR(" ("), STR_LEN(" ("));
            let s2: u64 = 0;
            while s2 < sym.signature_len { sb_append_byte(out, sym.signature[s2]); s2 = s2 + 1; }
            sb_append_byte(out, 41);
        };
        sb_append_byte(out, 10);
        if sym.children_len > 0 {
            let nextPrefix = StrBuf { bytes: [0u8; 65536], len: 0 };
            let r: u64 = 0;
            while r < prefix.len { sb_append_byte(&nextPrefix, prefix.bytes[r]); r = r + 1; }
            if isLast { sb_append(&nextPrefix, STR_PTR("    "), STR_LEN("    ")); } else { sb_append(&nextPrefix, STR_PTR("│   "), STR_LEN("│   ")); };
            formatOutlineSymbols(pool, sym.children_first, sym.children_len, &nextPrefix, out);
        };
        i = i + 1;
    }
}

fn formatOutlineAsTree(filePath: &StrBuf, totalLines: u64, pool: &OutlineSymbolList, first: u64, count: u64, out: &StrBuf) {
    // lines: string[] joined with "\n" (DEFECT: string[] -> single StrBuf,
    // trailing newline differs cosmetically from join semantics)
    sb_clear(out);
    sb_append(out, STR_PTR("[outline] "), STR_LEN("[outline] "));
    let fp: ptr = PTR_NULL();
    PTR_BYTE_ADD(fp, &filePath.bytes, 0);
    sb_append(out, fp, filePath.len);
    sb_append(out, STR_PTR(" ("), STR_LEN(" ("));
    sb_append_u64(out, totalLines);
    sb_append(out, STR_PTR(" lines, "), STR_LEN(" lines, "));
    sb_append_u64(out, count);
    sb_append(out, STR_PTR(" top-level symbols)"), STR_LEN(" top-level symbols)"));
    sb_append_byte(out, 10);
    if count == 0 {
        sb_append(out, STR_PTR("  (no top-level structural declarations found)"), STR_LEN("  (no top-level structural declarations found)"));
        return;
    };
    let emptyPrefix = StrBuf { bytes: [0u8; 65536], len: 0 };
    formatOutlineSymbols(pool, first, count, &emptyPrefix, out);
}

// ---- src/saVmTreeSitter.ts:332-336 — truncateSignature ----
// DEFECT: regex replace(/\s+/g, " ") and slice() — hand-rolled
// whitespace collapse; maxLen default 60 -> explicit param.
fn truncateSignature(text: &StrBuf, maxLen: u64, out: &StrBuf) {
    sb_clear(out);
    let lastWasSpace = true; // also trims leading whitespace (trim())
    let i: u64 = 0;
    while i < text.len {
        let c = text.bytes[i];
        if c == 32 || c == 9 || c == 10 || c == 13 {
            if !lastWasSpace { sb_append_byte(out, 32); lastWasSpace = true; };
        } else {
            sb_append_byte(out, c);
            lastWasSpace = false;
        };
        i = i + 1;
    }
    if out.len > 0 && out.bytes[out.len - 1] == 32 { out.len = out.len - 1; };
    if out.len <= maxLen { return; };
    out.len = maxLen - 3;
    sb_append(out, STR_PTR("..."), STR_LEN("..."));
}

// ---- node-type helpers for the collector functions below ----
// =====================================================================
// Host layer (fix phase 1): the ts_*/proc_*/path_*/fs_* surface the
// conversion assumed, implemented over sa_std — web-tree-sitter (WASM)
// maps to sa_ts_* (tree_sitter.sai); languages are grammar NAMES in
// sa_ts, so ts_language_load reduces a .wasm path to its grammar name
// and registers it in a joined-name cell table (id = line number).
// Node position/parent/flag queries take only a node in the original
// API and are node-local in the C core; the accessors below call the
// bound sa_ts_* externs directly. GAP CLOSED 2026-10-26 (sci
// 41b9f82d): sa_ts now binds node_parent / node_start_point /
// node_end_point / node_is_named / node_is_missing / node_has_error
// (four-source checked: sala docs recorded the gap, sla demos/tests
// zero usage, sa_std had no binding; the pinned tree-sitter core
// exports all six C symbols). Retired compensations: positions from
// byte ranges + registered source text, parent via deepest-match
// DFS, has_error via sexp scan, is_missing as empty-range leaf.
// The single active parse context (source/tree/root in sa_global
// cells, set by ts_parser_parse/ts_tree_root) remains in use by the
// language registry and this module's walk state.
// =====================================================================

fn fs_exists(p: ptr, n: u64) -> bool {
    // status-code surface: 0 = exists (see FIX notes on fs_exists).
    return sa_std_fs_exists(p, n) == 0;
}

fn fs_stat_is_file(p: ptr, n: u64) -> bool {
    // statSync(path).isFile() via the sa_std metadata surface
    // (same pattern as sdk-backend's sa_fs_stat_mtime_ms).
    let md: u64 = 0;
    if sa_std_fs_metadata(p, n, &md) != 0 { return false; };
    let f = sa_fs_metadata_is_file(md);
    sa_std_fs_metadata_free(md);
    return f != 0;
}

fn path_join2(a: &StrBuf, b: &StrBuf, out: &StrBuf) {
    // node:path join: concatenate with a single "/" separator, then
    // normalize (path_normalize_sb collapses "." / ".." segments and
    // duplicate slashes, as path.join does).
    let joined = StrBuf { bytes: [0u8; 65536], len: 0 };
    let ap: ptr = PTR_NULL();
    PTR_BYTE_ADD(ap, &a.bytes, 0);
    sb_append(&joined, ap, a.len);
    if a.len > 0 && b.len > 0 && a.bytes[a.len - 1] != 47 && b.bytes[0] != 47 { sb_append_byte(&joined, 47); };
    let bp: ptr = PTR_NULL();
    PTR_BYTE_ADD(bp, &b.bytes, 0);
    sb_append(&joined, bp, b.len);
    path_normalize_sb(&joined, out);
}

fn time_now_ms() -> u64 {
    // Date.now()
    let ms = sa_time_unix_ms();
    if ms < 0 { return 0; };
    return ms as u64;
}

fn fs_read_file(p: ptr, n: u64, out: &StrBuf) -> bool {
    // readFileSync flattened to this module's 64K StrBuf surface:
    // the sa_std read fails (non-zero status) when the file exceeds
    // max_bytes, matching the registered-source cap used for parses.
    sb_clear(out);
    let h: u64 = 0;
    if sa_std_fs_read_file(p, n, 65536, &h) != 0 { return false; };
    let len = sa_fs_read_buffer_len(h);
    let bp: ptr = sa_fs_read_buffer_data(h);
    sb_append(out, bp, len);
    sa_fs_read_buffer_free(h);
    return true;
}

fn fs_write_file(p: ptr, n: u64, content: &StrBuf) -> bool {
    // writeFileSync (truncate + write whole buffer)
    let cp: ptr = PTR_NULL();
    PTR_BYTE_ADD(cp, &content.bytes, 0);
    return sa_fs_write_file(p, n, cp, content.len) == 0;
}

fn fs_readdir(p: ptr, n: u64, out: &StrBuf, dirs: &StrBuf) -> bool {
    // readdirSync(dir, { withFileTypes: true }) flattened to two
    // newline-joined name lists: non-directory entries in out,
    // directories in dirs. sa_std kind tags: 1 regular, 2 directory,
    // 3 symlink, 255 other; a symlink is not a directory, matching
    // Dirent.isDirectory().
    sb_clear(out);
    sb_clear(dirs);
    let entries: u64 = 0;
    if sa_std_fs_read_dir_entries(p, n, 4096, &entries) != 0 { return false; };
    let total = sa_fs_dir_entries_len(entries);
    let i: u64 = 0;
    while i < total {
        let e: u64 = 0;
        if sa_std_fs_dir_entries_get(entries, i, &e) == 0 {
            let np: ptr = sa_fs_dir_entry_name_ptr(e);
            let nl = sa_fs_dir_entry_name_len(e);
            if sa_fs_dir_entry_kind(e) == 2 {
                if dirs.len > 0 { sb_append_byte(dirs, 10); };
                sb_append(dirs, np, nl);
            } else {
                if out.len > 0 { sb_append_byte(out, 10); };
                sb_append(out, np, nl);
            };
            sa_fs_dir_entry_free(e);
        };
        i = i + 1;
    }
    sa_fs_dir_entries_free(entries);
    return true;
}

fn proc_cwd(out: &StrBuf) {
    sb_clear(out);
    let h = sa_env_current_dir();
    if h == 0 { return; };
    let vp: ptr = sa_env_buffer_data(h);
    let n = sa_env_buffer_len(h);
    if n > 0 { sb_append(out, vp, n); };
    sa_env_buffer_free(h);
}

fn proc_resources_path(out: &StrBuf) -> bool {
    // Electron-only (process.resourcesPath); the CXU server runtime
    // is Bun/Node where the value is absent and callers skip the
    // branch — returning false is the faithful non-Electron behavior.
    sb_clear(out);
    return false;
}

fn path_extname(p: &StrBuf, out: &StrBuf) {
    sb_clear(out);
    let dot: u64 = 0;
    let has_dot = false;
    let i: u64 = 0;
    while i < p.len {
        let c = p.bytes[i];
        if c == 47 { has_dot = false; };
        if c == 46 { dot = i; has_dot = true; };
        i = i + 1;
    }
    if !has_dot { return; };
    let k = dot;
    while k < p.len { sb_append_byte(out, p.bytes[k]); k = k + 1; }
}

fn path_dirname(p: &StrBuf, out: &StrBuf) {
    sb_clear(out);
    if p.len == 0 { sb_append(out, STR_PTR("."), 1); return; };
    let end = p.len;
    while end > 1 && p.bytes[end - 1] == 47 { end = end - 1; }
    let slash: u64 = 0;
    let has_slash = false;
    let i = end;
    while i > 0 && !has_slash {
        if p.bytes[i - 1] == 47 { slash = i - 1; has_slash = true; };
        i = i - 1;
    }
    if !has_slash { sb_append(out, STR_PTR("."), 1); return; };
    if slash == 0 { sb_append(out, STR_PTR("/"), 1); return; };
    let k: u64 = 0;
    while k < slash { sb_append_byte(out, p.bytes[k]); k = k + 1; }
}

fn path_normalize_sb(p: &StrBuf, out: &StrBuf) {
    // Segment-stack normalization of "." / ".." (POSIX separators).
    let absolute = p.len > 0 && p.bytes[0] == 47;
    let nb = StrBuf { bytes: [0u8; 65536], len: 0 };
    let seg_end: [u64; 256] = [0u64; 256];
    let depth: u64 = 0;
    let start: u64 = 0;
    let pos: u64 = 0;
    while pos <= p.len {
        let at_end = pos == p.len;
        if at_end || p.bytes[pos] == 47 {
            let seg_len = pos - start;
            if seg_len == 1 && p.bytes[start] == 46 {
                // "." — skip
            } else if seg_len == 2 && p.bytes[start] == 46 && p.bytes[start + 1] == 46 {
                if depth > 0 {
                    depth = depth - 1;
                    nb.len = seg_end[depth];
                } else if !absolute {
                    if nb.len > 0 { sb_append_byte(&nb, 47); };
                    sb_append(&nb, STR_PTR(".."), 2);
                };
            } else if seg_len > 0 {
                if nb.len > 0 { sb_append_byte(&nb, 47); };
                let k = start;
                while k < pos { sb_append_byte(&nb, p.bytes[k]); k = k + 1; }
                if depth < 256 { seg_end[depth] = nb.len; depth = depth + 1; };
            };
            start = pos + 1;
        };
        pos = pos + 1;
    }
    sb_clear(out);
    if absolute { sb_append_byte(out, 47); };
    let nbp: ptr = PTR_NULL();
    PTR_BYTE_ADD(nbp, &nb.bytes, 0);
    sb_append(out, nbp, nb.len);
    if out.len == 0 { sb_append(out, STR_PTR("."), 1); };
}

fn path_resolve2(base: &StrBuf, spec: &StrBuf, out: &StrBuf) {
    if spec.len > 0 && spec.bytes[0] == 47 {
        path_normalize_sb(spec, out);
        return;
    };
    let joined = StrBuf { bytes: [0u8; 65536], len: 0 };
    let bp: ptr = PTR_NULL();
    PTR_BYTE_ADD(bp, &base.bytes, 0);
    sb_append(&joined, bp, base.len);
    if joined.len > 0 && spec.len > 0 { sb_append_byte(&joined, 47); };
    let sp: ptr = PTR_NULL();
    PTR_BYTE_ADD(sp, &spec.bytes, 0);
    sb_append(&joined, sp, spec.len);
    path_normalize_sb(&joined, out);
}

fn path_relative(from: &StrBuf, to: &StrBuf, out: &StrBuf) {
    sb_clear(out);
    // common segment-prefix length (bytes, segment aligned)
    let common: u64 = 0;
    let i: u64 = 0;
    let lim = from.len;
    if to.len < lim { lim = to.len; };
    while i < lim && from.bytes[i] == to.bytes[i] { i = i + 1; }
    common = i;
    // back off to a segment boundary
    while common > 0 && common < from.len && from.bytes[common] != 47 && from.bytes[common - 1] != 47 { common = common - 1; }
    if common < from.len && from.bytes[common] == 47 { common = common + 1; };
    // one ".." per remaining from-segment
    let segs: u64 = 0;
    if common < from.len {
        segs = 1;
        let k = common;
        while k < from.len { if from.bytes[k] == 47 { segs = segs + 1; }; k = k + 1; }
    };
    let u: u64 = 0;
    while u < segs {
        if out.len > 0 { sb_append_byte(out, 47); };
        sb_append(out, STR_PTR(".."), 2);
        u = u + 1;
    }
    if common < to.len {
        if out.len > 0 { sb_append_byte(out, 47); };
        let k = common;
        while k < to.len { sb_append_byte(out, to.bytes[k]); k = k + 1; }
    };
}

fn ts_current_src(out: &StrBuf) -> bool {
    sb_clear(out);
    let n: u64 = 0;
    let bp: ptr = PTR_NULL();
    PTR_BYTE_ADD(bp, &out.bytes, 0);
    let st = sa_global_bytes_get(STR_PTR("srv.ts.src"), STR_LEN("srv.ts.src"), bp, 65536, &n);
    if st != 0 { return false; };
    out.len = n;
    return true;
}

fn ts_parser_init(wasm_ptr: ptr, wasm_len: u64) -> bool {
    // web-tree-sitter Parser.init loads the runtime wasm; the native
    // core is dlopen'ed by sa_std — init succeeds iff it is present.
    return sa_ts_available() == 1;
}

fn ts_parser_new() -> u64 {
    let h: u64 = 0;
    let st = sa_ts_parser_new(&h);
    if st != 0 { return 0; };
    return h;
}

fn ts_language_load(path_ptr: ptr, path_len: u64) -> u64 {
    // ".../tree-sitter-typescript.wasm" -> grammar name "typescript",
    // appended to the joined-name registry; handle = 1-based line no.
    let base_start: u64 = 0;
    let i: u64 = 0;
    while i < path_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, path_ptr, i);
        if b == 47 { base_start = i + 1; };
        i = i + 1;
    }
    let name = StrBuf { bytes: [0u8; 65536], len: 0 };
    let j = base_start;
    while j < path_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, path_ptr, j);
        sb_append_byte(&name, b);
        j = j + 1;
    }
    if sb_starts_with(&name, STR_PTR("tree-sitter-"), STR_LEN("tree-sitter-")) {
        let tmp = StrBuf { bytes: [0u8; 65536], len: 0 };
        let k: u64 = 12;
        while k < name.len { sb_append_byte(&tmp, name.bytes[k]); k = k + 1; }
        sb_clear(&name);
        let tp2: ptr = PTR_NULL();
        PTR_BYTE_ADD(tp2, &tmp.bytes, 0);
        sb_append(&name, tp2, tmp.len);
    };
    if sb_ends_with(&name, STR_PTR(".wasm"), STR_LEN(".wasm")) { name.len = name.len - 5; };
    if name.len == 0 { return 0; };
    let reg = StrBuf { bytes: [0u8; 65536], len: 0 };
    ts_langs_load(&reg);
    // count existing entries and reject duplicates (idempotent load)
    let id: u64 = 1;
    let pos: u64 = 0;
    let line_start: u64 = 0;
    while pos < reg.len {
        if reg.bytes[pos] == 10 {
            if pos - line_start == name.len {
                let same = true;
                let k: u64 = 0;
                while k < name.len { if reg.bytes[line_start + k] != name.bytes[k] { same = false; }; k = k + 1; }
                if same { return id; };
            };
            id = id + 1;
            line_start = pos + 1;
        };
        pos = pos + 1;
    }
    let np: ptr = PTR_NULL();
    PTR_BYTE_ADD(np, &name.bytes, 0);
    sb_append(&reg, np, name.len);
    sb_append_byte(&reg, 10);
    let rp: ptr = PTR_NULL();
    PTR_BYTE_ADD(rp, &reg.bytes, 0);
    sa_global_bytes_set(STR_PTR("srv.ts.langs"), STR_LEN("srv.ts.langs"), rp, reg.len);
    return id;
}

fn ts_langs_load(out: &StrBuf) {
    sb_clear(out);
    let n: u64 = 0;
    let bp: ptr = PTR_NULL();
    PTR_BYTE_ADD(bp, &out.bytes, 0);
    let st = sa_global_bytes_get(STR_PTR("srv.ts.langs"), STR_LEN("srv.ts.langs"), bp, 65536, &n);
    if st == 0 { out.len = n; };
}

fn ts_parser_set_language(parser: u64, lang: u64) -> bool {
    if parser == 0 || lang == 0 { return false; };
    let reg = StrBuf { bytes: [0u8; 65536], len: 0 };
    ts_langs_load(&reg);
    let want = lang - 1;
    let idx: u64 = 0;
    let pos: u64 = 0;
    let line_start: u64 = 0;
    let namebuf: [u8; 128] = [0u8; 128];
    let name_len: u64 = 0;
    let found = false;
    while pos <= reg.len && !found {
        if pos == reg.len || reg.bytes[pos] == 10 {
            if idx == want {
                let k = line_start;
                while k < pos && name_len < 128 { namebuf[name_len] = reg.bytes[k]; name_len = name_len + 1; k = k + 1; }
                found = true;
            };
            idx = idx + 1;
            line_start = pos + 1;
        };
        pos = pos + 1;
    }
    if !found || name_len == 0 { return false; };
    return sa_ts_parser_set_language(parser, &namebuf, name_len) == 0;
}

fn ts_parser_parse(parser: u64, src_ptr: ptr, src_len: u64) -> u64 {
    sa_global_bytes_set(STR_PTR("srv.ts.src"), STR_LEN("srv.ts.src"), src_ptr, src_len);
    let tree: u64 = 0;
    let st = sa_ts_parse(parser, src_ptr, src_len, &tree);
    if st != 0 { return 0; };
    return tree;
}

fn ts_tree_root(tree: u64) -> u64 {
    let node: u64 = 0;
    let st = sa_ts_tree_root(tree, &node);
    if st != 0 { return 0; };
    sa_global_u64_set(STR_PTR("srv.ts.tree"), STR_LEN("srv.ts.tree"), tree);
    sa_global_u64_set(STR_PTR("srv.ts.root"), STR_LEN("srv.ts.root"), node);
    return node;
}

fn ts_node_child(node: u64, idx: u64) -> u64 {
    let out: u64 = 0;
    let st = sa_ts_node_child(node, idx as u32, 0, &out);
    if st != 0 { return 0; };
    return out;
}

fn ts_node_named_child(node: u64, idx: u64) -> u64 {
    let out: u64 = 0;
    let st = sa_ts_node_child(node, idx as u32, 1, &out);
    if st != 0 { return 0; };
    return out;
}

fn ts_node_child_count(node: u64) -> u64 {
    let c: u64 = 0;
    let st = sa_ts_node_child_count(node, &c);
    if st != 0 { return 0; };
    return c;
}

fn ts_node_named_child_count(node: u64) -> u64 {
    let c: u64 = 0;
    let st = sa_ts_node_named_child_count(node, &c);
    if st != 0 { return 0; };
    return c;
}

fn ts_node_child_by_field(node: u64, fp: ptr, fl: u64) -> u64 {
    let out: u64 = 0;
    let st = sa_ts_node_child_by_field(node, fp, fl, &out);
    if st != 0 { return 0; };
    return out;
}

fn ts_node_text(node: u64, out: &StrBuf) {
    sb_clear(out);
    let n: u64 = 0;
    let bp: ptr = PTR_NULL();
    PTR_BYTE_ADD(bp, &out.bytes, 0);
    let st = sa_ts_node_text(node, bp, 65536, &n);
    if st == 0 { out.len = n; };
}

fn ts_node_type_sb(node: u64, out: &StrBuf) {
    sb_clear(out);
    let n: u64 = 0;
    let bp: ptr = PTR_NULL();
    PTR_BYTE_ADD(bp, &out.bytes, 0);
    let st = sa_ts_node_type(node, bp, 65536, &n);
    if st == 0 { out.len = n; };
}

fn ts_node_start_index(node: u64) -> u64 {
    let s: u64 = 0;
    let e: u64 = 0;
    let st = sa_ts_node_byte_range(node, &s, &e);
    if st != 0 { return 0; };
    return s;
}

fn ts_node_end_index(node: u64) -> u64 {
    let s: u64 = 0;
    let e: u64 = 0;
    let st = sa_ts_node_byte_range(node, &s, &e);
    if st != 0 { return 0; };
    return e;
}

fn ts_node_start_row(node: u64) -> u64 {
    let r: u32 = 0;
    let c: u32 = 0;
    let st = sa_ts_node_start_point(node, &r, &c);
    if st != 0 { return 0; };
    return r as u64;
}

fn ts_node_end_row(node: u64) -> u64 {
    let r: u32 = 0;
    let c: u32 = 0;
    let st = sa_ts_node_end_point(node, &r, &c);
    if st != 0 { return 0; };
    return r as u64;
}

fn ts_node_start_col(node: u64) -> u64 {
    let r: u32 = 0;
    let c: u32 = 0;
    let st = sa_ts_node_start_point(node, &r, &c);
    if st != 0 { return 0; };
    return c as u64;
}

fn ts_node_end_col(node: u64) -> u64 {
    let r: u32 = 0;
    let c: u32 = 0;
    let st = sa_ts_node_end_point(node, &r, &c);
    if st != 0 { return 0; };
    return c as u64;
}

fn ts_node_is_error(node: u64) -> bool {
    return node_type_is(node, STR_PTR("ERROR"), STR_LEN("ERROR"));
}

fn ts_node_is_missing(node: u64) -> bool {
    if node == 0 { return false; };
    let f: u32 = 0;
    let st = sa_ts_node_is_missing(node, &f);
    if st != 0 { return false; };
    return f != 0;
}

fn ts_node_is_named(node: u64) -> bool {
    if node == 0 { return false; };
    let f: u32 = 0;
    let st = sa_ts_node_is_named(node, &f);
    if st != 0 { return false; };
    return f != 0;
}

fn ts_node_last_named_child(node: u64) -> u64 {
    let c = ts_node_named_child_count(node);
    if c == 0 { return 0; };
    return ts_node_named_child(node, c - 1);
}

fn ts_node_has_error(node: u64) -> bool {
    if node == 0 { return false; };
    let f: u32 = 0;
    let st = sa_ts_node_has_error(node, &f);
    if st != 0 { return false; };
    return f != 0;
}

fn ts_node_parent(node: u64) -> u64 {
    if node == 0 { return 0; };
    let p: u64 = 0;
    let st = sa_ts_node_parent(node, &p);
    if st != 0 { return 0; };
    return p;
}

// ---- end host layer ----

fn node_type_is(n: u64, p: ptr, len: u64) -> bool {
    if n == 0 { return false; };
    let tb = StrBuf { bytes: [0u8; 65536], len: 0 };
    ts_node_type_sb(n, &tb);
    if tb.len != len { return false; };
    let i: u64 = 0;
    while i < len {
        let c: u8 = 0;
        PTR_BYTE_AT(c, p, i);
        if tb.bytes[i] != c { return false; };
        i = i + 1;
    }
    return true;
}

fn node_field(n: u64, p: ptr, len: u64) -> u64 {
    // childForFieldName("...")?.text accessors go through this
    if n == 0 { return 0; };
    return ts_node_child_by_field(n, p, len);
}

fn node_text_into(n: u64, out: &StrBuf) {
    sb_clear(out);
    if n != 0 { ts_node_text(n, out); };
}

// ---- src/saVmTreeSitter.ts:340-450 — collectRustSymbols ----
// Appends top-level symbols to pool starting at pool.len; returns count.
// Child lists (enum variants / trait+impl methods) are appended right
// after their parent and referenced by (children_first, children_len).
fn collectRustSymbols(pool: &OutlineSymbolList, node: u64, detail: bool) -> u64 {
    let start = pool.len;
    let i: u64 = 0;
    let cc = ts_node_child_count(node);
    while i < cc {
        let child = ts_node_child(node, i);
        if child != 0 {
            if node_type_is(child, STR_PTR("struct_item"), STR_LEN("struct_item")) {
                let idx = sym_pool_push(pool, STR_PTR(""), 0, KIND_STRUCT, ts_node_start_row(child) + 1, ts_node_end_row(child) + 1);
                sym_name_or_anonymous(pool, idx, node_field(child, STR_PTR("name"), STR_LEN("name")));
            } else if node_type_is(child, STR_PTR("enum_item"), STR_LEN("enum_item")) {
                let idx = sym_pool_push(pool, STR_PTR(""), 0, KIND_ENUM, ts_node_start_row(child) + 1, ts_node_end_row(child) + 1);
                sym_name_or_anonymous(pool, idx, node_field(child, STR_PTR("name"), STR_LEN("name")));
                if detail {
                    let body = node_field(child, STR_PTR("body"), STR_LEN("body"));
                    if body != 0 {
                        let vfirst = pool.len;
                        let j: u64 = 0;
                        let bc = ts_node_child_count(body);
                        while j < bc {
                            let v = ts_node_child(body, j);
                            if v != 0 && node_type_is(v, STR_PTR("enum_variant"), STR_LEN("enum_variant")) {
                                let vi = sym_pool_push(pool, STR_PTR(""), 0, KIND_VARIANT, ts_node_start_row(v) + 1, ts_node_end_row(v) + 1);
                                // name = v.childForFieldName("name")?.text || v.text.trim()
                                let vn = node_field(v, STR_PTR("name"), STR_LEN("name"));
                                if vn != 0 { sym_set_name_from_node(pool, vi, vn); } else { sym_set_name_from_node(pool, vi, v); };
                            };
                            j = j + 1;
                        }
                        if pool.len > vfirst {
                            pool.items[idx].children_first = vfirst;
                            pool.items[idx].children_len = pool.len - vfirst;
                        };
                    };
                };
            } else if node_type_is(child, STR_PTR("trait_item"), STR_LEN("trait_item")) {
                let idx = sym_pool_push(pool, STR_PTR(""), 0, KIND_TRAIT, ts_node_start_row(child) + 1, ts_node_end_row(child) + 1);
                sym_name_or_anonymous(pool, idx, node_field(child, STR_PTR("name"), STR_LEN("name")));
                let body = node_field(child, STR_PTR("body"), STR_LEN("body"));
                if body != 0 {
                    let mfirst = pool.len;
                    let j: u64 = 0;
                    let bc = ts_node_child_count(body);
                    while j < bc {
                        let item = ts_node_child(body, j);
                        if item != 0 && (node_type_is(item, STR_PTR("function_item"), STR_LEN("function_item")) || node_type_is(item, STR_PTR("function_signature_item"), STR_LEN("function_signature_item"))) {
                            let mi = sym_pool_push(pool, STR_PTR(""), 0, KIND_METHOD, ts_node_start_row(item) + 1, ts_node_end_row(item) + 1);
                            sym_name_or_anonymous(pool, mi, node_field(item, STR_PTR("name"), STR_LEN("name")));
                        };
                        j = j + 1;
                    }
                    if pool.len > mfirst {
                        pool.items[idx].children_first = mfirst;
                        pool.items[idx].children_len = pool.len - mfirst;
                    };
                };
            } else if node_type_is(child, STR_PTR("impl_item"), STR_LEN("impl_item")) {
                // name = `impl ${traitNode ? `${trait} for ${type}` : type}`
                let idx = sym_pool_push(pool, STR_PTR(""), 0, KIND_IMPL, ts_node_start_row(child) + 1, ts_node_end_row(child) + 1);
                let nameBuf = StrBuf { bytes: [0u8; 65536], len: 0 };
                sb_append(&nameBuf, STR_PTR("impl "), STR_LEN("impl "));
                let typeNode = node_field(child, STR_PTR("type"), STR_LEN("type"));
                let traitNode = node_field(child, STR_PTR("trait"), STR_LEN("trait"));
                let tt = StrBuf { bytes: [0u8; 65536], len: 0 };
                if traitNode != 0 {
                    node_text_into(traitNode, &tt);
                    let tp2: ptr = PTR_NULL();
                    PTR_BYTE_ADD(tp2, &tt.bytes, 0);
                    sb_append(&nameBuf, tp2, tt.len);
                    sb_append(&nameBuf, STR_PTR(" for "), STR_LEN(" for "));
                };
                node_text_into(typeNode, &tt);
                let tp3: ptr = PTR_NULL();
                PTR_BYTE_ADD(tp3, &tt.bytes, 0);
                sb_append(&nameBuf, tp3, tt.len);
                // DEFECT: source falls back to "(anonymous)" when the type
                // field is absent; empty text kept here.
                let np: ptr = PTR_NULL();
                PTR_BYTE_ADD(np, &nameBuf.bytes, 0);
                // overwrite name in place
                pool.items[idx].name_len = 0;
                let q: u64 = 0;
                while q < nameBuf.len && q < 256 {
                    pool.items[idx].name[q] = nameBuf.bytes[q];
                    pool.items[idx].name_len = pool.items[idx].name_len + 1;
                    q = q + 1;
                }
                let body = node_field(child, STR_PTR("body"), STR_LEN("body"));
                if body != 0 {
                    let mfirst = pool.len;
                    let j: u64 = 0;
                    let bc = ts_node_child_count(body);
                    while j < bc {
                        let item = ts_node_child(body, j);
                        if item != 0 && node_type_is(item, STR_PTR("function_item"), STR_LEN("function_item")) {
                            let mi = sym_pool_push(pool, STR_PTR(""), 0, KIND_METHOD, ts_node_start_row(item) + 1, ts_node_end_row(item) + 1);
                            sym_name_or_anonymous(pool, mi, node_field(item, STR_PTR("name"), STR_LEN("name")));
                        };
                        j = j + 1;
                    }
                    if pool.len > mfirst {
                        pool.items[idx].children_first = mfirst;
                        pool.items[idx].children_len = pool.len - mfirst;
                    };
                };
            } else if node_type_is(child, STR_PTR("function_item"), STR_LEN("function_item")) {
                let idx = sym_pool_push(pool, STR_PTR(""), 0, KIND_FUNCTION, ts_node_start_row(child) + 1, ts_node_end_row(child) + 1);
                sym_name_or_anonymous(pool, idx, node_field(child, STR_PTR("name"), STR_LEN("name")));
            } else if node_type_is(child, STR_PTR("type_item"), STR_LEN("type_item")) {
                let idx = sym_pool_push(pool, STR_PTR(""), 0, KIND_TYPE, ts_node_start_row(child) + 1, ts_node_end_row(child) + 1);
                sym_name_or_anonymous(pool, idx, node_field(child, STR_PTR("name"), STR_LEN("name")));
            } else if node_type_is(child, STR_PTR("mod_item"), STR_LEN("mod_item")) {
                let idx = sym_pool_push(pool, STR_PTR(""), 0, KIND_MODULE, ts_node_start_row(child) + 1, ts_node_end_row(child) + 1);
                sym_name_or_anonymous(pool, idx, node_field(child, STR_PTR("name"), STR_LEN("name")));
            };
        };
        i = i + 1;
    }
    return pool.len - start;
}

// ---- src/saVmTreeSitter.ts:452-572 — collectTsSymbols + nested visitDeclaration ----
// DEFECT: visitDeclaration is a recursive closure capturing `symbols`
// and the defaulted parameter `exported = false`; converted to an
// explicit recursive fn with the pool and exported flag threaded.
fn tsVisitDeclaration(pool: &OutlineSymbolList, d: u64, exported: bool, detail: bool) {
    if d == 0 { return; };
    if node_type_is(d, STR_PTR("export_statement"), STR_LEN("export_statement")) {
        let decl = node_field(d, STR_PTR("declaration"), STR_LEN("declaration"));
        if decl != 0 {
            tsVisitDeclaration(pool, decl, true, detail);
        } else {
            // e.g. export { a, b }
            let i: u64 = 0;
            let cc = ts_node_child_count(d);
            while i < cc {
                let c = ts_node_child(d, i);
                if c != 0 && !node_type_is(c, STR_PTR("export"), STR_LEN("export")) && !node_type_is(c, STR_PTR("{"), 1) && !node_type_is(c, STR_PTR("}"), 1) {
                    tsVisitDeclaration(pool, c, true, detail);
                };
                i = i + 1;
            }
        };
        return;
    };
    if node_type_is(d, STR_PTR("function_declaration"), STR_LEN("function_declaration")) {
        let idx = sym_pool_push(pool, STR_PTR(""), 0, KIND_FUNCTION, ts_node_start_row(d) + 1, ts_node_end_row(d) + 1);
        sym_name_or_anonymous(pool, idx, node_field(d, STR_PTR("name"), STR_LEN("name")));
        if exported { sym_prefix_export(pool, idx); };
    } else if node_type_is(d, STR_PTR("class_declaration"), STR_LEN("class_declaration")) {
        let idx = sym_pool_push(pool, STR_PTR(""), 0, KIND_CLASS, ts_node_start_row(d) + 1, ts_node_end_row(d) + 1);
        sym_name_or_anonymous(pool, idx, node_field(d, STR_PTR("name"), STR_LEN("name")));
        if exported { sym_prefix_export(pool, idx); };
        let body = node_field(d, STR_PTR("body"), STR_LEN("body"));
        if body != 0 {
            let mfirst = pool.len;
            let j: u64 = 0;
            let bc = ts_node_child_count(body);
            while j < bc {
                let m = ts_node_child(body, j);
                if m != 0 && node_type_is(m, STR_PTR("method_definition"), STR_LEN("method_definition")) {
                    let mi = sym_pool_push(pool, STR_PTR(""), 0, KIND_METHOD, ts_node_start_row(m) + 1, ts_node_end_row(m) + 1);
                    sym_name_or_anonymous(pool, mi, node_field(m, STR_PTR("name"), STR_LEN("name")));
                };
                j = j + 1;
            }
            if pool.len > mfirst {
                pool.items[idx].children_first = mfirst;
                pool.items[idx].children_len = pool.len - mfirst;
            };
        };
    } else if node_type_is(d, STR_PTR("interface_declaration"), STR_LEN("interface_declaration")) {
        let idx = sym_pool_push(pool, STR_PTR(""), 0, KIND_INTERFACE, ts_node_start_row(d) + 1, ts_node_end_row(d) + 1);
        sym_name_or_anonymous(pool, idx, node_field(d, STR_PTR("name"), STR_LEN("name")));
        if exported { sym_prefix_export(pool, idx); };
    } else if node_type_is(d, STR_PTR("type_alias_declaration"), STR_LEN("type_alias_declaration")) {
        let idx = sym_pool_push(pool, STR_PTR(""), 0, KIND_TYPE, ts_node_start_row(d) + 1, ts_node_end_row(d) + 1);
        sym_name_or_anonymous(pool, idx, node_field(d, STR_PTR("name"), STR_LEN("name")));
        if exported { sym_prefix_export(pool, idx); };
    } else if node_type_is(d, STR_PTR("enum_declaration"), STR_LEN("enum_declaration")) {
        let idx = sym_pool_push(pool, STR_PTR(""), 0, KIND_ENUM, ts_node_start_row(d) + 1, ts_node_end_row(d) + 1);
        sym_name_or_anonymous(pool, idx, node_field(d, STR_PTR("name"), STR_LEN("name")));
        if exported { sym_prefix_export(pool, idx); };
    } else if node_type_is(d, STR_PTR("lexical_declaration"), STR_LEN("lexical_declaration")) || node_type_is(d, STR_PTR("variable_declaration"), STR_LEN("variable_declaration")) {
        let j: u64 = 0;
        let cc = ts_node_child_count(d);
        while j < cc {
            let decl = ts_node_child(d, j);
            if decl != 0 && node_type_is(decl, STR_PTR("variable_declarator"), STR_LEN("variable_declarator")) {
                let value = node_field(decl, STR_PTR("value"), STR_LEN("value"));
                let isFunc = value != 0 && (node_type_is(value, STR_PTR("arrow_function"), STR_LEN("arrow_function")) || node_type_is(value, STR_PTR("function_expression"), STR_LEN("function_expression")));
                if isFunc || exported || detail {
                    let kind = KIND_CONSTANT;
                    if isFunc { kind = KIND_FUNCTION; };
                    let idx = sym_pool_push(pool, STR_PTR(""), 0, kind, ts_node_start_row(d) + 1, ts_node_end_row(d) + 1);
                    sym_name_or_anonymous(pool, idx, node_field(decl, STR_PTR("name"), STR_LEN("name")));
                    if exported { sym_prefix_export(pool, idx); };
                };
            };
            j = j + 1;
        }
    };
}

fn sym_prefix_export(pool: &OutlineSymbolList, idx: u64) {
    // name = `export ${name}` when the declaration is exported
    let old = StrBuf { bytes: [0u8; 65536], len: 0 };
    let i: u64 = 0;
    while i < pool.items[idx].name_len { sb_append_byte(&old, pool.items[idx].name[i]); i = i + 1; }
    pool.items[idx].name_len = 0;
    let lit = "export ";
    let j: u64 = 0;
    while j < 7 {
        let c: u8 = 0;
        PTR_BYTE_AT(c, STR_PTR(lit), j);
        pool.items[idx].name[j] = c;
        pool.items[idx].name_len = pool.items[idx].name_len + 1;
        j = j + 1;
    }
    let k: u64 = 0;
    while k < old.len && pool.items[idx].name_len < 256 {
        pool.items[idx].name[pool.items[idx].name_len] = old.bytes[k];
        pool.items[idx].name_len = pool.items[idx].name_len + 1;
        k = k + 1;
    }
}

fn collectTsSymbols(pool: &OutlineSymbolList, node: u64, detail: bool) -> u64 {
    let start = pool.len;
    let i: u64 = 0;
    let cc = ts_node_child_count(node);
    while i < cc {
        tsVisitDeclaration(pool, ts_node_child(node, i), false, detail);
        i = i + 1;
    }
    return pool.len - start;
}

// ---- src/saVmTreeSitter.ts:574-635 — collectPythonSymbols (recursive, isMethod flag) ----
fn collectPythonSymbols(pool: &OutlineSymbolList, node: u64, isMethod: bool) -> u64 {
    let start = pool.len;
    let i: u64 = 0;
    let cc = ts_node_child_count(node);
    while i < cc {
        let child = ts_node_child(node, i);
        if child != 0 {
            let target = child;
            let isDecorated = false;
            if node_type_is(child, STR_PTR("decorated_definition"), STR_LEN("decorated_definition")) {
                // def = child.childForFieldName("definition") ?? child.lastNamedChild
                let def = node_field(child, STR_PTR("definition"), STR_LEN("definition"));
                if def == 0 { def = ts_node_last_named_child(child); };
                target = def;
                isDecorated = true;
            };
            if target != 0 && node_type_is(target, STR_PTR("function_definition"), STR_LEN("function_definition")) {
                let kind = KIND_FUNCTION;
                if isMethod { kind = KIND_METHOD; };
                let idx = sym_pool_push(pool, STR_PTR(""), 0, kind, ts_node_start_row(child) + 1, ts_node_end_row(child) + 1);
                sym_name_or_anonymous(pool, idx, node_field(target, STR_PTR("name"), STR_LEN("name")));
            } else if target != 0 && node_type_is(target, STR_PTR("class_definition"), STR_LEN("class_definition")) {
                let idx = sym_pool_push(pool, STR_PTR(""), 0, KIND_CLASS, ts_node_start_row(child) + 1, ts_node_end_row(child) + 1);
                sym_name_or_anonymous(pool, idx, node_field(target, STR_PTR("name"), STR_LEN("name")));
                let body = node_field(target, STR_PTR("body"), STR_LEN("body"));
                if body != 0 {
                    let ifirst = pool.len;
                    collectPythonSymbols(pool, body, true);
                    if pool.len > ifirst {
                        pool.items[idx].children_first = ifirst;
                        pool.items[idx].children_len = pool.len - ifirst;
                    };
                };
            };
        };
        i = i + 1;
    }
    return pool.len - start;
}

// ---- src/saVmTreeSitter.ts:637-677 — collectGoSymbols ----
fn collectGoSymbols(pool: &OutlineSymbolList, node: u64) -> u64 {
    let start = pool.len;
    let i: u64 = 0;
    let cc = ts_node_child_count(node);
    while i < cc {
        let child = ts_node_child(node, i);
        if child != 0 {
            if node_type_is(child, STR_PTR("function_declaration"), STR_LEN("function_declaration")) {
                let idx = sym_pool_push(pool, STR_PTR(""), 0, KIND_FUNCTION, ts_node_start_row(child) + 1, ts_node_end_row(child) + 1);
                sym_name_or_anonymous(pool, idx, node_field(child, STR_PTR("name"), STR_LEN("name")));
            } else if node_type_is(child, STR_PTR("method_declaration"), STR_LEN("method_declaration")) {
                // name = receiver ? `${receiver}.${name}` : name
                let idx = sym_pool_push(pool, STR_PTR(""), 0, KIND_METHOD, ts_node_start_row(child) + 1, ts_node_end_row(child) + 1);
                sym_name_or_anonymous(pool, idx, node_field(child, STR_PTR("name"), STR_LEN("name")));
                let recv = node_field(child, STR_PTR("receiver"), STR_LEN("receiver"));
                if recv != 0 {
                    let rb = StrBuf { bytes: [0u8; 65536], len: 0 };
                    node_text_into(recv, &rb);
                    if rb.len > 0 {
                        // prepend "receiver."
                        let old = StrBuf { bytes: [0u8; 65536], len: 0 };
                        let q: u64 = 0;
                        while q < pool.items[idx].name_len { sb_append_byte(&old, pool.items[idx].name[q]); q = q + 1; }
                        pool.items[idx].name_len = 0;
                        let r: u64 = 0;
                        while r < rb.len && pool.items[idx].name_len < 255 {
                            pool.items[idx].name[pool.items[idx].name_len] = rb.bytes[r];
                            pool.items[idx].name_len = pool.items[idx].name_len + 1;
                            r = r + 1;
                        }
                        if pool.items[idx].name_len < 256 {
                            pool.items[idx].name[pool.items[idx].name_len] = 46;
                            pool.items[idx].name_len = pool.items[idx].name_len + 1;
                        };
                        let s2: u64 = 0;
                        while s2 < old.len && pool.items[idx].name_len < 256 {
                            pool.items[idx].name[pool.items[idx].name_len] = old.bytes[s2];
                            pool.items[idx].name_len = pool.items[idx].name_len + 1;
                            s2 = s2 + 1;
                        }
                    };
                };
            } else if node_type_is(child, STR_PTR("type_declaration"), STR_LEN("type_declaration")) {
                let j: u64 = 0;
                let bc = ts_node_child_count(child);
                while j < bc {
                    let spec = ts_node_child(child, j);
                    if spec != 0 && node_type_is(spec, STR_PTR("type_spec"), STR_LEN("type_spec")) {
                        let typeNode = node_field(spec, STR_PTR("type"), STR_LEN("type"));
                        let kind = KIND_TYPE;
                        if typeNode != 0 && node_type_is(typeNode, STR_PTR("struct_type"), STR_LEN("struct_type")) { kind = KIND_STRUCT; };
                        if typeNode != 0 && node_type_is(typeNode, STR_PTR("interface_type"), STR_LEN("interface_type")) { kind = KIND_INTERFACE; };
                        let idx = sym_pool_push(pool, STR_PTR(""), 0, kind, ts_node_start_row(child) + 1, ts_node_end_row(child) + 1);
                        sym_name_or_anonymous(pool, idx, node_field(spec, STR_PTR("name"), STR_LEN("name")));
                    };
                    j = j + 1;
                }
            };
        };
        i = i + 1;
    }
    return pool.len - start;
}

// ---- src/saVmTreeSitter.ts:679-708 — collectZigSymbols ----
// DEFECT: child.text.split("(")[0] and regex match
// /(?:pub\s+)?(?:const|var)\s+([a-zA-Z0-9_]+)/ — hand-rolled scans.
fn collectZigSymbols(pool: &OutlineSymbolList, node: u64) -> u64 {
    let start = pool.len;
    let i: u64 = 0;
    let cc = ts_node_child_count(node);
    while i < cc {
        let child = ts_node_child(node, i);
        if child != 0 {
            if node_type_is(child, STR_PTR("function_declaration"), STR_LEN("function_declaration")) || node_type_is(child, STR_PTR("fn_proto"), STR_LEN("fn_proto")) {
                let idx = sym_pool_push(pool, STR_PTR(""), 0, KIND_FUNCTION, ts_node_start_row(child) + 1, ts_node_end_row(child) + 1);
                let nm = node_field(child, STR_PTR("name"), STR_LEN("name"));
                if nm != 0 {
                    sym_set_name_from_node(pool, idx, nm);
                } else {
                    // fallback: child.text.split("(")[0]?.trim()
                    let tb = StrBuf { bytes: [0u8; 65536], len: 0 };
                    node_text_into(child, &tb);
                    let cut: u64 = 0;
                    while cut < tb.len && tb.bytes[cut] != 40 { cut = cut + 1; }
                    tb.len = cut;
                    let trimmed = StrBuf { bytes: [0u8; 65536], len: 0 };
                    sb_trim(&tb, &trimmed);
                    pool.items[idx].name_len = 0;
                    let q: u64 = 0;
                    while q < trimmed.len && q < 256 {
                        pool.items[idx].name[q] = trimmed.bytes[q];
                        pool.items[idx].name_len = pool.items[idx].name_len + 1;
                        q = q + 1;
                    }
                    if pool.items[idx].name_len == 0 { sym_name_or_anonymous(pool, idx, 0); };
                };
            } else if node_type_is(child, STR_PTR("variable_declaration"), STR_LEN("variable_declaration")) {
                let text = StrBuf { bytes: [0u8; 65536], len: 0 };
                node_text_into(child, &text);
                let isStruct = sb_contains(&text, STR_PTR("struct"), STR_LEN("struct"));
                let isEnum = sb_contains(&text, STR_PTR("enum"), STR_LEN("enum"));
                // nameMatch = text.match(/(?:pub\s+)?(?:const|var)\s+([A-Za-z0-9_]+)/)
                // DEFECT: regex -> scan for "const "/"var " then read identifier
                let nameAt: u64 = 0;
                let nameLen: u64 = 0;
                zig_decl_name(&text, &nameAt, &nameLen);
                if nameLen > 0 {
                    let kind = KIND_CONSTANT;
                    if isStruct { kind = KIND_STRUCT; };
                    if isEnum { kind = KIND_ENUM; };
                    let idx = sym_pool_push(pool, STR_PTR(""), 0, kind, ts_node_start_row(child) + 1, ts_node_end_row(child) + 1);
                    pool.items[idx].name_len = 0;
                    let q: u64 = 0;
                    while q < nameLen && q < 256 {
                        pool.items[idx].name[q] = text.bytes[nameAt + q];
                        pool.items[idx].name_len = pool.items[idx].name_len + 1;
                        q = q + 1;
                    }
                };
            };
        };
        i = i + 1;
    }
    return pool.len - start;
}

fn zig_decl_name(text: &StrBuf, out_at: &u64, out_len: &u64) {
    *out_at = 0;
    *out_len = 0;
    let i: u64 = 0;
    while i + 6 <= text.len {
        let isConst = text.bytes[i] == 99 && text.bytes[i + 1] == 111 && text.bytes[i + 2] == 110 && text.bytes[i + 3] == 115 && text.bytes[i + 4] == 116;
        let isVar = text.bytes[i] == 118 && text.bytes[i + 1] == 97 && text.bytes[i + 2] == 114;
        let kwLen: u64 = 0;
        if isConst { kwLen = 5; };
        if isVar { kwLen = 3; };
        if kwLen > 0 {
            let j = i + kwLen;
            while j < text.len && (text.bytes[j] == 32 || text.bytes[j] == 9) { j = j + 1; }
            let s = j;
            while j < text.len {
                let c = text.bytes[j];
                let idc = (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95;
                if !idc { break; };
                j = j + 1;
            }
            if j > s { *out_at = s; *out_len = j - s; return; };
        };
        i = i + 1;
    }
}

// ---- src/saVmTreeSitter.ts:710-745 — collectCppSymbols ----
fn collectCppSymbols(pool: &OutlineSymbolList, node: u64) -> u64 {
    let start = pool.len;
    let i: u64 = 0;
    let cc = ts_node_child_count(node);
    while i < cc {
        let child = ts_node_child(node, i);
        if child != 0 {
            if node_type_is(child, STR_PTR("function_definition"), STR_LEN("function_definition")) {
                // name = truncateSignature(declarator?.text || "(anonymous)", 40)
                let idx = sym_pool_push(pool, STR_PTR(""), 0, KIND_FUNCTION, ts_node_start_row(child) + 1, ts_node_end_row(child) + 1);
                let decl = node_field(child, STR_PTR("declarator"), STR_LEN("declarator"));
                let tb = StrBuf { bytes: [0u8; 65536], len: 0 };
                if decl != 0 { node_text_into(decl, &tb); } else { sb_append(&tb, STR_PTR("(anonymous)"), STR_LEN("(anonymous)")); };
                let tn = StrBuf { bytes: [0u8; 65536], len: 0 };
                truncateSignature(&tb, 40, &tn);
                pool.items[idx].name_len = 0;
                let q: u64 = 0;
                while q < tn.len && q < 256 {
                    pool.items[idx].name[q] = tn.bytes[q];
                    pool.items[idx].name_len = pool.items[idx].name_len + 1;
                    q = q + 1;
                }
            } else if node_type_is(child, STR_PTR("class_specifier"), STR_LEN("class_specifier")) || node_type_is(child, STR_PTR("struct_specifier"), STR_LEN("struct_specifier")) {
                let kind = KIND_STRUCT;
                if node_type_is(child, STR_PTR("class_specifier"), STR_LEN("class_specifier")) { kind = KIND_CLASS; };
                let idx = sym_pool_push(pool, STR_PTR(""), 0, kind, ts_node_start_row(child) + 1, ts_node_end_row(child) + 1);
                sym_name_or_anonymous(pool, idx, node_field(child, STR_PTR("name"), STR_LEN("name")));
            } else if node_type_is(child, STR_PTR("enum_specifier"), STR_LEN("enum_specifier")) {
                let idx = sym_pool_push(pool, STR_PTR(""), 0, KIND_ENUM, ts_node_start_row(child) + 1, ts_node_end_row(child) + 1);
                sym_name_or_anonymous(pool, idx, node_field(child, STR_PTR("name"), STR_LEN("name")));
            } else if node_type_is(child, STR_PTR("namespace_definition"), STR_LEN("namespace_definition")) {
                let idx = sym_pool_push(pool, STR_PTR(""), 0, KIND_MODULE, ts_node_start_row(child) + 1, ts_node_end_row(child) + 1);
                sym_name_or_anonymous(pool, idx, node_field(child, STR_PTR("name"), STR_LEN("name")));
            };
        };
        i = i + 1;
    }
    return pool.len - start;
}

// ---- src/saVmTreeSitter.ts:747-782 — extractRegexOutline ----
// DEFECT: three regexes (fn/def/func/function, class/struct/interface/
// trait/enum, impl) with capture groups — no regex engine in sa_std;
// hand-rolled prefix scans approximating the same anchored patterns.
fn extractRegexOutline(pool: &OutlineSymbolList, content: &StrBuf) -> u64 {
    let start = pool.len;
    let idx = LineIndex { starts: [0u64; 8192], lens: [0u64; 8192], count: 0 };
    build_line_index(content, &idx);
    let li: u64 = 0;
    while li < idx.count {
        let line = StrBuf { bytes: [0u8; 65536], len: 0 };
        line_at(content, &idx, li, &line);
        let trimmed = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_trim(&line, &trimmed);
        if trimmed.len == 0 || sb_starts_with(&trimmed, STR_PTR("//"), 2) || sb_starts_with(&trimmed, STR_PTR("#"), 1) || sb_starts_with(&trimmed, STR_PTR("/*"), 2) {
            li = li + 1;
            continue;
        };
        // fnMatch = /^(?:export\s+)?(?:pub\s+)?(?:async\s+)?(?:fn|def|func|function)\s+([a-zA-Z0-9_]+)/
        let nameAt: u64 = 0;
        let nameLen: u64 = 0;
        if regex_outline_fn(&trimmed, &nameAt, &nameLen) {
            let sidx = sym_pool_push(pool, STR_PTR(""), 0, KIND_FUNCTION, li + 1, li + 1);
            pool.items[sidx].name_len = 0;
            let q: u64 = 0;
            while q < nameLen && q < 256 {
                pool.items[sidx].name[q] = trimmed.bytes[nameAt + q];
                pool.items[sidx].name_len = pool.items[sidx].name_len + 1;
                q = q + 1;
            }
            li = li + 1;
            continue;
        };
        // typeMatch = /^(?:export\s+)?(?:pub\s+)?(?:class|struct|interface|trait|enum)\s+([a-zA-Z0-9_]+)/
        let kind: u64 = 0;
        if regex_outline_type(&trimmed, &nameAt, &nameLen, &kind) {
            // kind chosen by trimmed.includes("class") ? ... : "trait"
            // (source tests the whole line, not the matched keyword)
            if sb_contains(&trimmed, STR_PTR("class"), STR_LEN("class")) { kind = KIND_CLASS; } else if sb_contains(&trimmed, STR_PTR("struct"), STR_LEN("struct")) { kind = KIND_STRUCT; } else if sb_contains(&trimmed, STR_PTR("interface"), STR_LEN("interface")) { kind = KIND_INTERFACE; } else if sb_contains(&trimmed, STR_PTR("enum"), STR_LEN("enum")) { kind = KIND_ENUM; } else { kind = KIND_TRAIT; };
            let sidx = sym_pool_push(pool, STR_PTR(""), 0, kind, li + 1, li + 1);
            pool.items[sidx].name_len = 0;
            let q: u64 = 0;
            while q < nameLen && q < 256 {
                pool.items[sidx].name[q] = trimmed.bytes[nameAt + q];
                pool.items[sidx].name_len = pool.items[sidx].name_len + 1;
                q = q + 1;
            }
            li = li + 1;
            continue;
        };
        // implMatch = /^impl(?:\s*<[^>]+>)?\s+(.+?)(?:\{|$)/
        if sb_starts_with(&trimmed, STR_PTR("impl"), STR_LEN("impl")) {
            // name = `impl ${implMatch[1].trim()}` up to "{" or end of line
            let sidx = sym_pool_push(pool, STR_PTR(""), 0, KIND_IMPL, li + 1, li + 1);
            let nb = StrBuf { bytes: [0u8; 65536], len: 0 };
            sb_append(&nb, STR_PTR("impl "), STR_LEN("impl "));
            let p: u64 = 4;
            while p < trimmed.len && trimmed.bytes[p] != 123 { sb_append_byte(&nb, trimmed.bytes[p]); p = p + 1; }
            let nt = StrBuf { bytes: [0u8; 65536], len: 0 };
            sb_trim(&nb, &nt);
            pool.items[sidx].name_len = 0;
            let q: u64 = 0;
            while q < nt.len && q < 256 {
                pool.items[sidx].name[q] = nt.bytes[q];
                pool.items[sidx].name_len = pool.items[sidx].name_len + 1;
                q = q + 1;
            }
        };
        li = li + 1;
    }
    return pool.len - start;
}

fn skip_ws_and_kw(line: &StrBuf, pos: &u64, kw_p: ptr, kw_n: u64) -> bool {
    // consume optional keyword at pos (followed by whitespace)
    let p = *pos;
    if p + kw_n > line.len { return false; };
    let i: u64 = 0;
    while i < kw_n {
        let c: u8 = 0;
        PTR_BYTE_AT(c, kw_p, i);
        if line.bytes[p + i] != c { return false; };
        i = i + 1;
    }
    let after = p + kw_n;
    if after < line.len && line.bytes[after] != 32 && line.bytes[after] != 9 { return false; };
    while after < line.len && (line.bytes[after] == 32 || line.bytes[after] == 9) { after = after + 1; }
    *pos = after;
    return true;
}

fn read_ident(line: &StrBuf, pos: u64, out_at: &u64, out_len: &u64) -> bool {
    let s = pos;
    let j = pos;
    while j < line.len {
        let c = line.bytes[j];
        let idc = (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95;
        if !idc { break; };
        j = j + 1;
    }
    *out_at = s;
    *out_len = j - s;
    return j > s;
}

fn regex_outline_fn(line: &StrBuf, out_at: &u64, out_len: &u64) -> bool {
    let pos: u64 = 0;
    let p2 = pos;
    if skip_ws_and_kw(line, &p2, STR_PTR("export"), STR_LEN("export")) { pos = p2; };
    p2 = pos;
    if skip_ws_and_kw(line, &p2, STR_PTR("pub"), STR_LEN("pub")) { pos = p2; };
    p2 = pos;
    if skip_ws_and_kw(line, &p2, STR_PTR("async"), STR_LEN("async")) { pos = p2; };
    p2 = pos;
    if skip_ws_and_kw(line, &p2, STR_PTR("function"), STR_LEN("function")) { return read_ident(line, p2, out_at, out_len); };
    p2 = pos;
    if skip_ws_and_kw(line, &p2, STR_PTR("func"), STR_LEN("func")) { return read_ident(line, p2, out_at, out_len); };
    p2 = pos;
    if skip_ws_and_kw(line, &p2, STR_PTR("fn"), STR_LEN("fn")) { return read_ident(line, p2, out_at, out_len); };
    p2 = pos;
    if skip_ws_and_kw(line, &p2, STR_PTR("def"), STR_LEN("def")) { return read_ident(line, p2, out_at, out_len); };
    return false;
}

fn regex_outline_type(line: &StrBuf, out_at: &u64, out_len: &u64, out_kind: &u64) -> bool {
    let pos: u64 = 0;
    let p2 = pos;
    if skip_ws_and_kw(line, &p2, STR_PTR("export"), STR_LEN("export")) { pos = p2; };
    p2 = pos;
    if skip_ws_and_kw(line, &p2, STR_PTR("pub"), STR_LEN("pub")) { pos = p2; };
    *out_kind = KIND_TRAIT;
    p2 = pos;
    if skip_ws_and_kw(line, &p2, STR_PTR("class"), STR_LEN("class")) { return read_ident(line, p2, out_at, out_len); };
    p2 = pos;
    if skip_ws_and_kw(line, &p2, STR_PTR("struct"), STR_LEN("struct")) { return read_ident(line, p2, out_at, out_len); };
    p2 = pos;
    if skip_ws_and_kw(line, &p2, STR_PTR("interface"), STR_LEN("interface")) { return read_ident(line, p2, out_at, out_len); };
    p2 = pos;
    if skip_ws_and_kw(line, &p2, STR_PTR("trait"), STR_LEN("trait")) { return read_ident(line, p2, out_at, out_len); };
    p2 = pos;
    if skip_ws_and_kw(line, &p2, STR_PTR("enum"), STR_LEN("enum")) { return read_ident(line, p2, out_at, out_len); };
    return false;
}

// ---- src/saVmTreeSitter.ts:784-868 — extractFileOutline ----
// ASYNC-ADJ(ii): TS async extractFileOutline (L770) awaits loadLanguageForFile + Parser.parse; SLA: the same calls as blocking sa_ts_* externs via the host layer (ASYNC_MODEL R8); options object { detail?: boolean } ->
// explicit bool param. Result assembled into `out` + shared pool.
fn extractFileOutline(st: &TreeSitterState, pool: &OutlineSymbolList, filePath: &StrBuf, content: &StrBuf, detail: bool, out: &FileOutlineResult) {
    let idx = LineIndex { starts: [0u64; 8192], lens: [0u64; 8192], count: 0 };
    build_line_index(content, &idx);
    let totalLines = idx.count; // content.split(/\r?\n/).length
    out.totalLines = totalLines;
    out.filePath_len = 0;
    let fp: u64 = 0;
    while fp < filePath.len && fp < 1024 { out.filePath[fp] = filePath.bytes[fp]; out.filePath_len = out.filePath_len + 1; fp = fp + 1; }
    let langName = StrBuf { bytes: [0u8; 65536], len: 0 };
    let hasLang = getLanguageNameForFile(filePath, &langName);
    let first = pool.len;
    let count: u64 = 0;
    if !hasLang {
        out.has_language = false;
        out.language_len = 0;
        count = extractRegexOutline(pool, content);
        out.symbols_first = first;
        out.symbols_len = count;
        outline_result_format(out, pool, filePath, totalLines);
        return;
    };
    out.has_language = true;
    out.language_len = 0;
    let lp: u64 = 0;
    while lp < langName.len && lp < 64 { out.language[lp] = langName.bytes[lp]; out.language_len = out.language_len + 1; lp = lp + 1; }
    let lang = loadLanguageForFile(st, filePath);
    if lang == 0 || st.parserInstance == 0 {
        count = extractRegexOutline(pool, content);
        out.symbols_first = first;
        out.symbols_len = count;
        outline_result_format(out, pool, filePath, totalLines);
        return;
    };
    ts_parser_set_language(st.parserInstance, lang);
    let cp: ptr = PTR_NULL();
    PTR_BYTE_ADD(cp, &content.bytes, 0);
    let tree = ts_parser_parse(st.parserInstance, cp, content.len);
    if tree == 0 {
        count = extractRegexOutline(pool, content);
        out.symbols_first = first;
        out.symbols_len = count;
        outline_result_format(out, pool, filePath, totalLines);
        return;
    };
    let root = ts_tree_root(tree);
    // switch (langName) — grouped cases typescript/tsx/javascript share a body
    if sb_eq_lit(&langName, STR_PTR("rust"), STR_LEN("rust")) {
        count = collectRustSymbols(pool, root, detail);
    } else if sb_eq_lit(&langName, STR_PTR("typescript"), STR_LEN("typescript")) || sb_eq_lit(&langName, STR_PTR("tsx"), STR_LEN("tsx")) || sb_eq_lit(&langName, STR_PTR("javascript"), STR_LEN("javascript")) {
        count = collectTsSymbols(pool, root, detail);
    } else if sb_eq_lit(&langName, STR_PTR("python"), STR_LEN("python")) {
        count = collectPythonSymbols(pool, root, false);
    } else if sb_eq_lit(&langName, STR_PTR("go"), STR_LEN("go")) {
        count = collectGoSymbols(pool, root);
    } else if sb_eq_lit(&langName, STR_PTR("zig"), STR_LEN("zig")) {
        count = collectZigSymbols(pool, root);
    } else if sb_eq_lit(&langName, STR_PTR("c"), STR_LEN("c")) || sb_eq_lit(&langName, STR_PTR("cpp"), STR_LEN("cpp")) {
        count = collectCppSymbols(pool, root);
    } else {
        count = extractRegexOutline(pool, content);
    };
    out.symbols_first = first;
    out.symbols_len = count;
    outline_result_format(out, pool, filePath, totalLines);
}

fn outline_result_format(out: &FileOutlineResult, pool: &OutlineSymbolList, filePath: &StrBuf, totalLines: u64) {
    let fb = StrBuf { bytes: [0u8; 65536], len: 0 };
    formatOutlineAsTree(filePath, totalLines, pool, out.symbols_first, out.symbols_len, &fb);
    out.formatted_len = 0;
    let i: u64 = 0;
    while i < fb.len && i < 65536 { out.formatted[i] = fb.bytes[i]; out.formatted_len = out.formatted_len + 1; i = i + 1; }
}

// ---- src/saVmTreeSitter.ts:870-944 — renameSymbolInContent ----
// ASYNC-ADJ(ii): TS async renameSymbolInContent (L857) awaits loadLanguageForFile + parse; SLA: blocking sa_ts_* externs via the host layer (ASYNC_MODEL R8). Returns 0 on success and fills
// outContent/edits; the TS early-return of the original content is the
// outContent = content copy.
// DEFECT: nested recursive `walk` closure capturing edits/lines/oldName
// -> explicit recursive fn with a state struct.
struct RenameWalkState {
    edits: SymbolEditList,
    oldName: [u8; 256], oldName_len: u64,
    newName: [u8; 256], newName_len: u64,
}

fn renameWalk(st: &RenameWalkState, content: &StrBuf, idx: &LineIndex, node: u64) {
    let tb0 = StrBuf { bytes: [0u8; 65536], len: 0 };
    ts_node_type_sb(node, &tb0);
    let isIdent = false;
    if sb_eq_lit(&tb0, STR_PTR("identifier"), STR_LEN("identifier")) ||
       sb_eq_lit(&tb0, STR_PTR("type_identifier"), STR_LEN("type_identifier")) ||
       sb_eq_lit(&tb0, STR_PTR("field_identifier"), STR_LEN("field_identifier")) ||
       sb_eq_lit(&tb0, STR_PTR("property_identifier"), STR_LEN("property_identifier")) ||
       sb_eq_lit(&tb0, STR_PTR("shorthand_property_identifier"), STR_LEN("shorthand_property_identifier")) ||
       sb_eq_lit(&tb0, STR_PTR("scoped_identifier"), STR_LEN("scoped_identifier")) ||
       sb_eq_lit(&tb0, STR_PTR("constant"), STR_LEN("constant")) {
        isIdent = true;
    };
    if isIdent {
        let tb = StrBuf { bytes: [0u8; 65536], len: 0 };
        node_text_into(node, &tb);
        if tb.len == st.oldName_len {
            let same = true;
            let q: u64 = 0;
            while q < tb.len {
                if tb.bytes[q] != st.oldName[q] { same = false; };
                q = q + 1;
                if !same { break; };
            }
            if same && !isInsideCommentOrString(node) {
                let row = ts_node_start_row(node);
                let col = ts_node_start_col(node);
                let lineText = StrBuf { bytes: [0u8; 65536], len: 0 };
                line_at(content, idx, row, &lineText);
                let trimmed = StrBuf { bytes: [0u8; 65536], len: 0 };
                sb_trim(&lineText, &trimmed);
                let ei = st.edits.len;
                if ei < 4096 {
                    st.edits.items[ei].start = ts_node_start_index(node);
                    st.edits.items[ei].end = ts_node_end_index(node);
                    st.edits.items[ei].line = row + 1;
                    st.edits.items[ei].column = col + 1;
                    st.edits.items[ei].oldText_len = 0;
                    let a: u64 = 0;
                    while a < st.oldName_len && a < 256 { st.edits.items[ei].oldText[a] = st.oldName[a]; st.edits.items[ei].oldText_len = st.edits.items[ei].oldText_len + 1; a = a + 1; }
                    st.edits.items[ei].newText_len = 0;
                    let b: u64 = 0;
                    while b < st.newName_len && b < 256 { st.edits.items[ei].newText[b] = st.newName[b]; st.edits.items[ei].newText_len = st.edits.items[ei].newText_len + 1; b = b + 1; }
                    st.edits.items[ei].preview_len = 0;
                    let c2: u64 = 0;
                    while c2 < trimmed.len && c2 < 1024 { st.edits.items[ei].preview[c2] = trimmed.bytes[c2]; st.edits.items[ei].preview_len = st.edits.items[ei].preview_len + 1; c2 = c2 + 1; }
                    st.edits.len = st.edits.len + 1;
                };
            };
        };
    };
    let i: u64 = 0;
    let cc = ts_node_child_count(node);
    while i < cc {
        let child = ts_node_child(node, i);
        if child != 0 { renameWalk(st, content, idx, child); };
        i = i + 1;
    }
}

fn bytes_eq(a: ptr, an: u64, b: ptr, bn: u64) -> bool {
    if an != bn { return false; };
    let i: u64 = 0;
    while i < an {
        let x: u8 = 0;
        let y: u8 = 0;
        PTR_BYTE_AT(x, a, i);
        PTR_BYTE_AT(y, b, i);
        if x != y { return false; };
        i = i + 1;
    }
    return true;
}

// Applies edits sorted end-to-start (source: [...edits].sort((a,b) =>
// b.start - a.start) then slice-splice loop). DEFECT: Array sort with
// comparator closure -> insertion sort over the fixed list.
fn applyEditsDescending(content: &StrBuf, edits: &SymbolEditList, newName_p: ptr, newName_n: u64, out: &StrBuf) {
    // insertion sort by start descending
    let i: u64 = 1;
    while i < edits.len {
        let j = i;
        while j > 0 && edits.items[j].start > edits.items[j - 1].start {
            let tmp = edits.items[j];
            edits.items[j] = edits.items[j - 1];
            edits.items[j - 1] = tmp;
            j = j - 1;
        }
        i = i + 1;
    }
    // result = content; for edit of sorted: result.slice(0,start)+new+result.slice(end)
    // Applied from the end backwards directly onto a copy.
    sb_clear(out);
    let q: u64 = 0;
    while q < content.len { sb_append_byte(out, content.bytes[q]); q = q + 1; }
    let k: u64 = 0;
    while k < edits.len {
        let e = edits.items[k];
        // splice: keep [0,start) + newName + [end,len)
        let tail = StrBuf { bytes: [0u8; 65536], len: 0 };
        let t: u64 = e.end;
        while t < out.len { sb_append_byte(&tail, out.bytes[t]); t = t + 1; }
        out.len = e.start;
        sb_append(out, newName_p, newName_n);
        let u: u64 = 0;
        while u < tail.len { sb_append_byte(out, tail.bytes[u]); u = u + 1; }
        k = k + 1;
    }
}

fn renameSymbolInContent(st: &TreeSitterState, filePath: &StrBuf, content: &StrBuf, oldName: &StrBuf, newName: &StrBuf, outContent: &StrBuf, edits: &SymbolEditList) {
    sb_clear(outContent);
    edits.len = 0;
    // if (oldName === newName || !oldName.trim())
    let oldTrim = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_trim(oldName, &oldTrim);
    if oldTrim.len == 0 || (oldName.len == newName.len && sb_eq_buf(oldName, newName)) {
        let q: u64 = 0;
        while q < content.len { sb_append_byte(outContent, content.bytes[q]); q = q + 1; }
        return;
    };
    let lang = loadLanguageForFile(st, filePath);
    if lang == 0 || st.parserInstance == 0 {
        fallbackRegexRename(content, oldName, newName, outContent, edits);
        return;
    };
    ts_parser_set_language(st.parserInstance, lang);
    let cp: ptr = PTR_NULL();
    PTR_BYTE_ADD(cp, &content.bytes, 0);
    let tree = ts_parser_parse(st.parserInstance, cp, content.len);
    if tree == 0 {
        fallbackRegexRename(content, oldName, newName, outContent, edits);
        return;
    };
    let idx = LineIndex { starts: [0u64; 8192], lens: [0u64; 8192], count: 0 };
    build_line_index(content, &idx);
    let wst = RenameWalkState { edits: SymbolEditList { items: [SymbolEdit { start: 0, end: 0, line: 0, column: 0, oldText: [0u8; 256], oldText_len: 0, newText: [0u8; 256], newText_len: 0, preview: [0u8; 1024], preview_len: 0 }; 4096], len: 0 }, oldName: [0u8; 256], oldName_len: 0, newName: [0u8; 256], newName_len: 0 };
    let a: u64 = 0;
    while a < oldName.len && a < 256 { wst.oldName[a] = oldName.bytes[a]; wst.oldName_len = wst.oldName_len + 1; a = a + 1; }
    let b: u64 = 0;
    while b < newName.len && b < 256 { wst.newName[b] = newName.bytes[b]; wst.newName_len = wst.newName_len + 1; b = b + 1; }
    renameWalk(&wst, content, &idx, ts_tree_root(tree));
    edits.len = wst.edits.len;
    let e: u64 = 0;
    while e < wst.edits.len { edits.items[e] = wst.edits.items[e]; e = e + 1; }
    if edits.len == 0 {
        let q: u64 = 0;
        while q < content.len { sb_append_byte(outContent, content.bytes[q]); q = q + 1; }
        return;
    };
    let np: ptr = PTR_NULL();
    PTR_BYTE_ADD(np, &newName.bytes, 0);
    applyEditsDescending(content, edits, np, newName.len, outContent);
}

fn sb_eq_buf(a: &StrBuf, b: &StrBuf) -> bool {
    if a.len != b.len { return false; };
    let i: u64 = 0;
    while i < a.len {
        if a.bytes[i] != b.bytes[i] { return false; };
        i = i + 1;
    }
    return true;
}

// ---- src/saVmTreeSitter.ts:946-1000 — fallbackRegexRename ----
// DEFECT: new RegExp(`\\b${escaped}\\b`, "g") + RegExpExecArray loop —
// no regex engine; word-boundary scan hand-rolled. The escape-regex
// replace of oldName is moot once matching is literal.
fn fallbackRegexRename(content: &StrBuf, oldName: &StrBuf, newName: &StrBuf, outContent: &StrBuf, edits: &SymbolEditList) {
    sb_clear(outContent);
    edits.len = 0;
    let idx = LineIndex { starts: [0u8; 8192], lens: [0u64; 8192], count: 0 };
    build_line_index(content, &idx);
    if oldName.len == 0 {
        let q: u64 = 0;
        while q < content.len { sb_append_byte(outContent, content.bytes[q]); q = q + 1; }
        return;
    };
    let pos: u64 = 0;
    while pos + oldName.len <= content.len {
        // literal match at pos with \b on both sides
        let same = true;
        let q: u64 = 0;
        while q < oldName.len {
            if content.bytes[pos + q] != oldName.bytes[q] { same = false; };
            q = q + 1;
            if !same { break; };
        }
        let boundaryBefore = pos == 0 || !is_word_byte(content.bytes[pos - 1]);
        let afterPos = pos + oldName.len;
        let boundaryAfter = afterPos >= content.len || !is_word_byte(content.bytes[afterPos]);
        if same && boundaryBefore && boundaryAfter {
            // line/col from the prefix (source recomputes via split)
            let lineNum = line_of_offset(&idx, pos);
            let lineStart = idx.starts[lineNum - 1];
            let colNum = pos - lineStart + 1;
            let lineText = StrBuf { bytes: [0u8; 65536], len: 0 };
            line_at(content, &idx, lineNum - 1, &lineText);
            let trimmed = StrBuf { bytes: [0u8; 65536], len: 0 };
            sb_trim(&lineText, &trimmed);
            // heuristic: skip comment-led lines
            if !(sb_starts_with(&trimmed, STR_PTR("//"), 2) || sb_starts_with(&trimmed, STR_PTR("#"), 1) || sb_starts_with(&trimmed, STR_PTR("/*"), 2) || sb_starts_with(&trimmed, STR_PTR("*"), 1)) {
                let ei = edits.len;
                if ei < 4096 {
                    edits.items[ei].start = pos;
                    edits.items[ei].end = afterPos;
                    edits.items[ei].line = lineNum;
                    edits.items[ei].column = colNum;
                    edits.items[ei].oldText_len = 0;
                    let a: u64 = 0;
                    while a < oldName.len && a < 256 { edits.items[ei].oldText[a] = oldName.bytes[a]; edits.items[ei].oldText_len = edits.items[ei].oldText_len + 1; a = a + 1; }
                    edits.items[ei].newText_len = 0;
                    let b: u64 = 0;
                    while b < newName.len && b < 256 { edits.items[ei].newText[b] = newName.bytes[b]; edits.items[ei].newText_len = edits.items[ei].newText_len + 1; b = b + 1; }
                    edits.items[ei].preview_len = 0;
                    let c2: u64 = 0;
                    while c2 < trimmed.len && c2 < 1024 { edits.items[ei].preview[c2] = trimmed.bytes[c2]; edits.items[ei].preview_len = edits.items[ei].preview_len + 1; c2 = c2 + 1; }
                    edits.len = edits.len + 1;
                };
            };
            pos = afterPos;
        } else {
            pos = pos + 1;
        };
    }
    if edits.len == 0 {
        let q: u64 = 0;
        while q < content.len { sb_append_byte(outContent, content.bytes[q]); q = q + 1; }
        return;
    };
    let np: ptr = PTR_NULL();
    PTR_BYTE_ADD(np, &newName.bytes, 0);
    applyEditsDescending(content, edits, np, newName.len, outContent);
}

fn is_word_byte(c: u8) -> bool {
    return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95;
}

fn line_of_offset(idx: &LineIndex, off: u64) -> u64 {
    let i: u64 = 0;
    let line: u64 = 1;
    while i < idx.count {
        if idx.starts[i] <= off { line = i + 1; };
        i = i + 1;
    }
    return line;
}

// ---- src/saVmTreeSitter.ts:1019-1101 — findDefinitionInContent ----
// ASYNC-ADJ(ii): TS async findDefinitionInContent (L990) awaits loadLanguageForFile + parse; SLA: blocking sa_ts_* externs via the host layer (ASYNC_MODEL R8); options { includeBody?, maxBodyLines? }
// -> explicit maxBodyLines param (includeBody is accepted but unused
// by the source body as well). Nested recursive `walk` closure with
// early-exit on matchedNode -> state struct + matched flag.
// Returns out.found (TS: DefinitionMatch | null).
struct FindDefState {
    matchedNode: u64, matchedKind: u64, found: bool,
    sym: [u8; 256], sym_len: u64,
}

fn findDefClassify(node: u64, out_name: &StrBuf, out_kind: &u64) -> bool {
    // Mirrors the source if/else chain over node.type_; returns true and
    // fills candidateName/kind when the node type is a candidate.
    sb_clear(out_name);
    *out_kind = KIND_FUNCTION;
    let nameNode: u64 = 0;
    if node_type_is(node, STR_PTR("function_declaration"), STR_LEN("function_declaration")) || node_type_is(node, STR_PTR("function_item"), STR_LEN("function_item")) || node_type_is(node, STR_PTR("function_definition"), STR_LEN("function_definition")) || node_type_is(node, STR_PTR("fn_proto"), STR_LEN("fn_proto")) {
        *out_kind = KIND_FUNCTION;
    } else if node_type_is(node, STR_PTR("class_declaration"), STR_LEN("class_declaration")) || node_type_is(node, STR_PTR("class_definition"), STR_LEN("class_definition")) || node_type_is(node, STR_PTR("class_specifier"), STR_LEN("class_specifier")) {
        *out_kind = KIND_CLASS;
    } else if node_type_is(node, STR_PTR("struct_item"), STR_LEN("struct_item")) || node_type_is(node, STR_PTR("struct_specifier"), STR_LEN("struct_specifier")) {
        *out_kind = KIND_STRUCT;
    } else if node_type_is(node, STR_PTR("interface_declaration"), STR_LEN("interface_declaration")) {
        *out_kind = KIND_INTERFACE;
    } else if node_type_is(node, STR_PTR("type_alias_declaration"), STR_LEN("type_alias_declaration")) || node_type_is(node, STR_PTR("type_item"), STR_LEN("type_item")) {
        *out_kind = KIND_TYPE;
    } else if node_type_is(node, STR_PTR("type_spec"), STR_LEN("type_spec")) {
        let typeNode = node_field(node, STR_PTR("type"), STR_LEN("type"));
        *out_kind = KIND_TYPE;
        if typeNode != 0 && node_type_is(typeNode, STR_PTR("struct_type"), STR_LEN("struct_type")) { *out_kind = KIND_STRUCT; };
        if typeNode != 0 && node_type_is(typeNode, STR_PTR("interface_type"), STR_LEN("interface_type")) { *out_kind = KIND_INTERFACE; };
    } else if node_type_is(node, STR_PTR("enum_declaration"), STR_LEN("enum_declaration")) || node_type_is(node, STR_PTR("enum_item"), STR_LEN("enum_item")) || node_type_is(node, STR_PTR("enum_specifier"), STR_LEN("enum_specifier")) {
        *out_kind = KIND_ENUM;
    } else if node_type_is(node, STR_PTR("trait_item"), STR_LEN("trait_item")) {
        *out_kind = KIND_TRAIT;
    } else if node_type_is(node, STR_PTR("method_definition"), STR_LEN("method_definition")) || node_type_is(node, STR_PTR("method_declaration"), STR_LEN("method_declaration")) {
        *out_kind = KIND_METHOD;
    } else if node_type_is(node, STR_PTR("variable_declarator"), STR_LEN("variable_declarator")) {
        let val = node_field(node, STR_PTR("value"), STR_LEN("value"));
        *out_kind = KIND_CONSTANT;
        if val != 0 && (node_type_is(val, STR_PTR("arrow_function"), STR_LEN("arrow_function")) || node_type_is(val, STR_PTR("function_expression"), STR_LEN("function_expression"))) { *out_kind = KIND_FUNCTION; };
    } else if node_type_is(node, STR_PTR("const_item"), STR_LEN("const_item")) || node_type_is(node, STR_PTR("static_item"), STR_LEN("static_item")) {
        *out_kind = KIND_CONSTANT;
    } else {
        return false;
    };
    nameNode = node_field(node, STR_PTR("name"), STR_LEN("name"));
    if nameNode != 0 { node_text_into(nameNode, out_name); };
    return true;
}

fn findDefWalk(st: &FindDefState, node: u64) {
    if st.found { return; };
    let candName = StrBuf { bytes: [0u8; 65536], len: 0 };
    let kind: u64 = KIND_FUNCTION;
    if findDefClassify(node, &candName, &kind) {
        if candName.len == st.sym_len {
            let same = true;
            let q: u64 = 0;
            while q < candName.len {
                if candName.bytes[q] != st.sym[q] { same = false; };
                q = q + 1;
                if !same { break; };
            }
            if same {
                let target = node;
                // variable_declarator: lift to lexical/variable_declaration parent
                if node_type_is(node, STR_PTR("variable_declarator"), STR_LEN("variable_declarator")) {
                    let parent = ts_node_parent(node);
                    if parent != 0 && (node_type_is(parent, STR_PTR("lexical_declaration"), STR_LEN("lexical_declaration")) || node_type_is(parent, STR_PTR("variable_declaration"), STR_LEN("variable_declaration"))) {
                        target = parent;
                    };
                };
                // lift to export_statement parent
                let tp = ts_node_parent(target);
                if tp != 0 && node_type_is(tp, STR_PTR("export_statement"), STR_LEN("export_statement")) { target = tp; };
                st.matchedNode = target;
                st.matchedKind = kind;
                st.found = true;
                return;
            };
        };
    };
    let i: u64 = 0;
    let cc = ts_node_child_count(node);
    while i < cc {
        let child = ts_node_child(node, i);
        if child != 0 { findDefWalk(st, child); };
        if st.found { return; };
        i = i + 1;
    }
}

fn findDefinitionInContent(st: &TreeSitterState, filePath: &StrBuf, content: &StrBuf, targetSymbol: &StrBuf, maxBodyLinesIn: u64, hasMaxBodyLines: bool, out: &DefinitionMatch) {
    out.found = false;
    let sym = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_trim(targetSymbol, &sym); // targetSymbol.trim()
    if sym.len == 0 { return; };
    let maxLines: u64 = 40; // options.maxBodyLines ?? 40
    if hasMaxBodyLines { maxLines = maxBodyLinesIn; };
    let langName = StrBuf { bytes: [0u8; 65536], len: 0 };
    if !getLanguageNameForFile(filePath, &langName) {
        fallbackFindDefinition(filePath, content, &sym, maxLines, out);
        return;
    };
    let lang = loadLanguageForFile(st, filePath);
    if lang == 0 || st.parserInstance == 0 {
        fallbackFindDefinition(filePath, content, &sym, maxLines, out);
        return;
    };
    ts_parser_set_language(st.parserInstance, lang);
    let cp: ptr = PTR_NULL();
    PTR_BYTE_ADD(cp, &content.bytes, 0);
    let tree = ts_parser_parse(st.parserInstance, cp, content.len);
    if tree == 0 {
        fallbackFindDefinition(filePath, content, &sym, maxLines, out);
        return;
    };
    let fst = FindDefState { matchedNode: 0, matchedKind: KIND_FUNCTION, found: false, sym: [0u8; 256], sym_len: 0 };
    let a: u64 = 0;
    while a < sym.len && a < 256 { fst.sym[a] = sym.bytes[a]; fst.sym_len = fst.sym_len + 1; a = a + 1; }
    findDefWalk(&fst, ts_tree_root(tree));
    if !fst.found {
        fallbackFindDefinition(filePath, content, &sym, maxLines, out);
        return;
    };
    let targetNode = fst.matchedNode;
    let startRow = ts_node_start_row(targetNode);
    let endRow = ts_node_end_row(targetNode);
    let idx = LineIndex { starts: [0u64; 8192], lens: [0u64; 8192], count: 0 };
    build_line_index(content, &idx);
    // signature: join trimmed lines startRow..min(endRow, startRow+3)
    // until a line contains "{" or ends with ":" / ";" or contains "=>"
    let sig = StrBuf { bytes: [0u8; 65536], len: 0 };
    let lastRow = endRow;
    if lastRow > startRow + 3 { lastRow = startRow + 3; };
    let r = startRow;
    while r <= lastRow {
        let lb = StrBuf { bytes: [0u8; 65536], len: 0 };
        line_at(content, &idx, r, &lb);
        let lt = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_trim(&lb, &lt);
        if sig.len > 0 { sb_append_byte(&sig, 32); };
        let q: u64 = 0;
        while q < lt.len { sb_append_byte(&sig, lt.bytes[q]); q = q + 1; }
        let endsColon = lt.len > 0 && lt.bytes[lt.len - 1] == 58;
        let endsSemi = lt.len > 0 && lt.bytes[lt.len - 1] == 59;
        if sb_contains(&lt, STR_PTR("{"), 1) || endsColon || endsSemi || sb_contains(&lt, STR_PTR("=>"), 2) { break; };
        r = r + 1;
    }
    // body snippet: `${r+1}: ${line}` rows startRow..min(endRow, startRow+maxLines-1)
    let actualEnd = endRow;
    if actualEnd > startRow + maxLines - 1 { actualEnd = startRow + maxLines - 1; };
    let snippet = StrBuf { bytes: [0u8; 65536], len: 0 };
    let r2 = startRow;
    while r2 <= actualEnd {
        if r2 > startRow { sb_append_byte(&snippet, 10); };
        sb_append_u64(&snippet, r2 + 1);
        sb_append(&snippet, STR_PTR(": "), STR_LEN(": "));
        let lb = StrBuf { bytes: [0u8; 65536], len: 0 };
        line_at(content, &idx, r2, &lb);
        let q: u64 = 0;
        while q < lb.len { sb_append_byte(&snippet, lb.bytes[q]); q = q + 1; }
        r2 = r2 + 1;
    }
    if endRow > actualEnd {
        sb_append_byte(&snippet, 10);
        sb_append(&snippet, STR_PTR("  ... ("), STR_LEN("  ... ("));
        sb_append_u64(&snippet, endRow - actualEnd);
        sb_append(&snippet, STR_PTR(" more lines)"), STR_LEN(" more lines)"));
    };
    fillDefinitionMatch(out, filePath, &sym, fst.matchedKind, startRow + 1, endRow + 1, &sig, &snippet);
}

fn fillDefinitionMatch(out: &DefinitionMatch, filePath: &StrBuf, sym: &StrBuf, kind: u64, startLine: u64, endLine: u64, sig: &StrBuf, snippet: &StrBuf) {
    out.found = true;
    out.kind = kind;
    out.startLine = startLine;
    out.endLine = endLine;
    out.filePath_len = 0;
    let i: u64 = 0;
    while i < filePath.len && i < 1024 { out.filePath[i] = filePath.bytes[i]; out.filePath_len = out.filePath_len + 1; i = i + 1; }
    out.symbol_len = 0;
    let j: u64 = 0;
    while j < sym.len && j < 256 { out.symbol[j] = sym.bytes[j]; out.symbol_len = out.symbol_len + 1; j = j + 1; }
    let tsig = StrBuf { bytes: [0u8; 65536], len: 0 };
    truncateSignature(sig, 120, &tsig);
    out.signature_len = 0;
    let k: u64 = 0;
    while k < tsig.len && k < 512 { out.signature[k] = tsig.bytes[k]; out.signature_len = out.signature_len + 1; k = k + 1; }
    out.bodySnippet_len = 0;
    let m: u64 = 0;
    while m < snippet.len && m < 16384 { out.bodySnippet[m] = snippet.bytes[m]; out.bodySnippet_len = out.bodySnippet_len + 1; m = m + 1; }
}

// ---- src/saVmTreeSitter.ts:1167-1217 — fallbackFindDefinition ----
// DEFECT: symRegex built by interpolating the escaped symbol into a
// pattern — approximated by literal keyword-then-symbol scanning.
fn fallbackFindDefinition(filePath: &StrBuf, content: &StrBuf, targetSymbol: &StrBuf, maxBodyLines: u64, out: &DefinitionMatch) {
    out.found = false;
    let idx = LineIndex { starts: [0u64; 8192], lens: [0u64; 8192], count: 0 };
    build_line_index(content, &idx);
    let li: u64 = 0;
    while li < idx.count {
        let line = StrBuf { bytes: [0u8; 65536], len: 0 };
        line_at(content, &idx, li, &line);
        if line_declares_symbol(&line, targetSymbol) {
            let startLine = li + 1;
            let maxLines = maxBodyLines; // ?? 40 applied by caller default
            let endLine = idx.count;
            if endLine > startLine + maxLines - 1 { endLine = startLine + maxLines - 1; };
            let snippet = StrBuf { bytes: [0u8; 65536], len: 0 };
            let r = li;
            while r < endLine {
                if r > li { sb_append_byte(&snippet, 10); };
                sb_append_u64(&snippet, r + 1);
                sb_append(&snippet, STR_PTR(": "), STR_LEN(": "));
                let lb = StrBuf { bytes: [0u8; 65536], len: 0 };
                line_at(content, &idx, r, &lb);
                let q: u64 = 0;
                while q < lb.len { sb_append_byte(&snippet, lb.bytes[q]); q = q + 1; }
                r = r + 1;
            }
            let kind = KIND_FUNCTION;
            if sb_contains(&line, STR_PTR("class"), STR_LEN("class")) { kind = KIND_CLASS; } else if sb_contains(&line, STR_PTR("struct"), STR_LEN("struct")) { kind = KIND_STRUCT; } else if sb_contains(&line, STR_PTR("interface"), STR_LEN("interface")) { kind = KIND_INTERFACE; } else if sb_contains(&line, STR_PTR("enum"), STR_LEN("enum")) { kind = KIND_ENUM; };
            let sig = StrBuf { bytes: [0u8; 65536], len: 0 };
            sb_trim(&line, &sig);
            fillDefinitionMatch(out, filePath, targetSymbol, kind, startLine, endLine, &sig, &snippet);
            return;
        };
        li = li + 1;
    }
}

fn line_declares_symbol(line: &StrBuf, sym: &StrBuf) -> bool {
    // (?:export\s+)?(?:pub\s+)?(?:async\s+)?(?:fn|def|func|function|
    // class|struct|interface|trait|enum|type|const|let|var)\s+SYM\b
    let kws = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_append(&kws, STR_PTR("fn def func function class struct interface trait enum type const let var"), STR_LEN("fn def func function class struct interface trait enum type const let var"));
    // scan: find sym occurrence preceded (after optional export/pub/async
    // and exactly one keyword + whitespace) — approximated by: sym occurs
    // as a word and one keyword occurs before it on the same line.
    let pos: u64 = 0;
    while pos + sym.len <= line.len {
        let same = true;
        let q: u64 = 0;
        while q < sym.len {
            if line.bytes[pos + q] != sym.bytes[q] { same = false; };
            q = q + 1;
            if !same { break; };
        }
        let afterOk = pos + sym.len >= line.len || !is_word_byte(line.bytes[pos + sym.len]);
        if same && afterOk && pos > 0 {
            // keyword search in line[0..pos)
            let head = StrBuf { bytes: [0u8; 65536], len: 0 };
            let h: u64 = 0;
            while h < pos { sb_append_byte(&head, line.bytes[h]); h = h + 1; }
            if sb_contains(&head, STR_PTR("fn "), 3) || sb_contains(&head, STR_PTR("def "), 4) || sb_contains(&head, STR_PTR("function "), 9) || sb_contains(&head, STR_PTR("class "), 6) || sb_contains(&head, STR_PTR("struct "), 7) || sb_contains(&head, STR_PTR("interface "), 10) || sb_contains(&head, STR_PTR("trait "), 6) || sb_contains(&head, STR_PTR("enum "), 5) || sb_contains(&head, STR_PTR("type "), 5) || sb_contains(&head, STR_PTR("const "), 6) || sb_contains(&head, STR_PTR("let "), 4) || sb_contains(&head, STR_PTR("var "), 4) || sb_contains(&head, STR_PTR("func "), 5) {
                return true;
            };
        };
        pos = pos + 1;
    }
    return false;
}

// ---- src/saVmTreeSitter.ts:1235-1252 — formatDiagnostics (private) ----
fn formatDiagnostics(filePath: &StrBuf, errors: &SyntaxDiagnosticList, out: &StrBuf) {
    sb_clear(out);
    if errors.len == 0 {
        sb_append(out, STR_PTR("[diagnostics] ✓ "), STR_LEN("[diagnostics] ✓ "));
        let fp: ptr = PTR_NULL();
        PTR_BYTE_ADD(fp, &filePath.bytes, 0);
        sb_append(out, fp, filePath.len);
        sb_append(out, STR_PTR(": Clean (0 syntax errors)."), STR_LEN(": Clean (0 syntax errors)."));
        return;
    };
    sb_append(out, STR_PTR("[diagnostics] Found "), STR_LEN("[diagnostics] Found "));
    sb_append_u64(out, errors.len);
    sb_append(out, STR_PTR(" syntax error(s) in "), STR_LEN(" syntax error(s) in "));
    let fp: ptr = PTR_NULL();
    PTR_BYTE_ADD(fp, &filePath.bytes, 0);
    sb_append(out, fp, filePath.len);
    sb_append_byte(out, 58);
    let shown = errors.len;
    if shown > 10 { shown = 10; }; // errors.slice(0, 10)
    let i: u64 = 0;
    while i < shown {
        let e = errors.items[i];
        sb_append_byte(out, 10);
        sb_append(out, STR_PTR("- L"), STR_LEN("- L"));
        sb_append_u64(out, e.line);
        sb_append_byte(out, 58);
        sb_append_u64(out, e.column);
        sb_append(out, STR_PTR(" - "), STR_LEN(" - "));
        let q: u64 = 0;
        while q < e.message_len { sb_append_byte(out, e.message[q]); q = q + 1; }
        if e.preview_len > 0 {
            sb_append_byte(out, 10);
            sb_append(out, STR_PTR("    "), STR_LEN("    "));
            let r: u64 = 0;
            while r < e.preview_len { sb_append_byte(out, e.preview[r]); r = r + 1; }
        };
        i = i + 1;
    }
    if errors.len > 10 {
        sb_append_byte(out, 10);
        sb_append(out, STR_PTR("  ... ("), STR_LEN("  ... ("));
        sb_append_u64(out, errors.len - 10);
        sb_append(out, STR_PTR(" more error(s) truncated)"), STR_LEN(" more error(s) truncated)"));
    };
}

// ---- src/saVmTreeSitter.ts:1254-1409 — getSyntaxDiagnostics ----
// ASYNC-ADJ(ii): TS async getSyntaxDiagnostics (L1192); its awaits are the tree-sitter init/load/parse chain, here blocking sa_ts_* externs via the host layer (ASYNC_MODEL R8). The TS/JS fast path uses the typescript
// compiler: sf.parseDiagnostics, ts.getLineAndCharacterOfPosition,
// ts.flattenDiagnosticMessageText, ts.isIfStatement/isReturnStatement/
// isCallExpression/isIdentifier/isPropertyAccessExpression type guards
// over `any` AST nodes, plus ts.forEachChild recursion — none of this
// exists in SLA. The conversion keeps the control flow: the TS path is
// gated on a compiler handle that is unavailable in this pass, so
// execution falls through to the tree-sitter path exactly as the
// source's catch/fallback does. The React Hook rules walk
// (checkHookRulesInStatements / inspectNodeForHooks / walkComponentNodes,
// src:1307-1381) is recorded here as a defect and not re-implemented:
//   DEFECT: React Hook rules checking requires TS compiler AST +
//   regex /^use[A-Z0-9]/ on call names + closure-captured errors array.
fn getSyntaxDiagnostics(st: &TreeSitterState, filePath: &StrBuf, content: &StrBuf, errors: &SyntaxDiagnosticList, out: &SyntaxDiagnosticsResult) {
    errors.len = 0;
    out.filePath_len = 0;
    let z: u64 = 0;
    while z < filePath.len && z < 1024 { out.filePath[z] = filePath.bytes[z]; out.filePath_len = out.filePath_len + 1; z = z + 1; }
    let ext = StrBuf { bytes: [0u8; 65536], len: 0 };
    path_extname(filePath, &ext);
    let li: u64 = 0;
    while li < ext.len {
        if ext.bytes[li] >= 65 && ext.bytes[li] <= 90 { ext.bytes[li] = ext.bytes[li] + 32; };
        li = li + 1;
    }
    let isTsJs = sb_eq_lit(&ext, STR_PTR(".ts"), 3) || sb_eq_lit(&ext, STR_PTR(".tsx"), 4) || sb_eq_lit(&ext, STR_PTR(".js"), 3) || sb_eq_lit(&ext, STR_PTR(".jsx"), 4) || sb_eq_lit(&ext, STR_PTR(".mts"), 4) || sb_eq_lit(&ext, STR_PTR(".cts"), 4) || sb_eq_lit(&ext, STR_PTR(".mjs"), 4) || sb_eq_lit(&ext, STR_PTR(".cjs"), 4);
    if isTsJs {
        // try { TS compiler path incl. Hook rules for .tsx/.jsx }
        // catch { fall through to tree-sitter }
        // DEFECT: TS compiler path unavailable (see header note); the
        // source's own fallback continues below.
    };
    let lang = loadLanguageForFile(st, filePath);
    if lang == 0 || st.parserInstance == 0 {
        out.clean = true;
        out.errorsCount = 0;
        out.errors_first = 0;
        out.errors_len = 0;
        let fb = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_append(&fb, STR_PTR("[diagnostics] ✓ "), STR_LEN("[diagnostics] ✓ "));
        let fp: ptr = PTR_NULL();
        PTR_BYTE_ADD(fp, &filePath.bytes, 0);
        sb_append(&fb, fp, filePath.len);
        sb_append(&fb, STR_PTR(": Language parser not loaded, no obvious syntax errors."), STR_LEN(": Language parser not loaded, no obvious syntax errors."));
        copy_into_diag_formatted(out, &fb);
        return;
    };
    ts_parser_set_language(st.parserInstance, lang);
    let cp: ptr = PTR_NULL();
    PTR_BYTE_ADD(cp, &content.bytes, 0);
    let tree = ts_parser_parse(st.parserInstance, cp, content.len);
    if tree == 0 || !ts_node_has_error(ts_tree_root(tree)) {
        out.clean = true;
        out.errorsCount = 0;
        out.errors_first = 0;
        out.errors_len = 0;
        let fb = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_append(&fb, STR_PTR("[diagnostics] ✓ "), STR_LEN("[diagnostics] ✓ "));
        let fp: ptr = PTR_NULL();
        PTR_BYTE_ADD(fp, &filePath.bytes, 0);
        sb_append(&fb, fp, filePath.len);
        sb_append(&fb, STR_PTR(": Clean (0 syntax errors)."), STR_LEN(": Clean (0 syntax errors)."));
        copy_into_diag_formatted(out, &fb);
        return;
    };
    let idx = LineIndex { starts: [0u64; 8192], lens: [0u64; 8192], count: 0 };
    build_line_index(content, &idx);
    collectTreeErrors(errors, content, &idx, ts_tree_root(tree));
    out.clean = errors.len == 0;
    out.errorsCount = errors.len;
    out.errors_first = 0;
    out.errors_len = errors.len;
    let fb = StrBuf { bytes: [0u8; 65536], len: 0 };
    formatDiagnostics(filePath, errors, &fb);
    copy_into_diag_formatted(out, &fb);
}

fn copy_into_diag_formatted(out: &SyntaxDiagnosticsResult, fb: &StrBuf) {
    out.formatted_len = 0;
    let i: u64 = 0;
    while i < fb.len && i < 16384 { out.formatted[i] = fb.bytes[i]; out.formatted_len = out.formatted_len + 1; i = i + 1; }
}

// ---- src/saVmTreeSitter.ts:1392-1408 — nested collectTreeErrors ----
// DEFECT: closure capturing lines/errors -> explicit recursive fn.
fn collectTreeErrors(errors: &SyntaxDiagnosticList, content: &StrBuf, idx: &LineIndex, node: u64) {
    if ts_node_is_error(node) || node_type_is(node, STR_PTR("ERROR"), STR_LEN("ERROR")) || ts_node_is_missing(node) {
        let row = ts_node_start_row(node);
        let col = ts_node_start_col(node);
        let previewFull = StrBuf { bytes: [0u8; 65536], len: 0 };
        line_at(content, idx, row, &previewFull);
        let preview = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_trim(&previewFull, &preview);
        // nodeText = node.text.slice(0, 30).replace(/\s+/g, " ")
        let nodeText = StrBuf { bytes: [0u8; 65536], len: 0 };
        node_text_into(node, &nodeText);
        if nodeText.len > 30 { nodeText.len = 30; };
        let collapsed = StrBuf { bytes: [0u8; 65536], len: 0 };
        truncateSignature(&nodeText, 1000000, &collapsed); // whitespace collapse only
        let ei = errors.len;
        if ei < 256 {
            errors.items[ei].line = row + 1;
            errors.items[ei].column = col + 1;
            errors.items[ei].preview_len = 0;
            let q: u64 = 0;
            while q < preview.len && q < 1024 { errors.items[ei].preview[q] = preview.bytes[q]; errors.items[ei].preview_len = errors.items[ei].preview_len + 1; q = q + 1; }
            errors.items[ei].message_len = 0;
            let msg = StrBuf { bytes: [0u8; 65536], len: 0 };
            if ts_node_is_missing(node) {
                sb_append(&msg, STR_PTR("Missing expected token near '"), STR_LEN("Missing expected token near '"));
                let r: u64 = 0;
                while r < preview.len { sb_append_byte(&msg, preview.bytes[r]); r = r + 1; }
                sb_append_byte(&msg, 39);
            } else {
                sb_append(&msg, STR_PTR("Syntax error near '"), STR_LEN("Syntax error near '"));
                let useText = &collapsed;
                if useText.len == 0 { useText = &preview; };
                let r: u64 = 0;
                while r < useText.len { sb_append_byte(&msg, useText.bytes[r]); r = r + 1; }
                sb_append_byte(&msg, 39);
            };
            let m: u64 = 0;
            while m < msg.len && m < 1024 { errors.items[ei].message[m] = msg.bytes[m]; errors.items[ei].message_len = errors.items[ei].message_len + 1; m = m + 1; }
            errors.items[ei].code_len = 0;
            let code = "SYNTAX_ERROR";
            let c2: u64 = 0;
            while c2 < 12 { let ch: u8 = 0; PTR_BYTE_AT(ch, STR_PTR(code), c2); errors.items[ei].code[c2] = ch; errors.items[ei].code_len = errors.items[ei].code_len + 1; c2 = c2 + 1; }
            errors.items[ei].has_code = true;
            errors.len = errors.len + 1;
        };
    };
    let i: u64 = 0;
    let cc = ts_node_child_count(node);
    while i < cc {
        let child = ts_node_child(node, i);
        if child != 0 { collectTreeErrors(errors, content, idx, child); };
        i = i + 1;
    }
}

// ---- mutable line list for the text-surgery functions ----
struct LineBuf {
    bytes: [u8; 8192], len: u64,
}

struct LineBufList {
    items: [LineBuf; 8192], len: u64,
}

fn split_lines(content: &StrBuf, out: &LineBufList) {
    out.len = 0;
    let idx = LineIndex { starts: [0u64; 8192], lens: [0u64; 8192], count: 0 };
    build_line_index(content, &idx);
    let i: u64 = 0;
    while i < idx.count && i < 8192 {
        out.items[i].len = 0;
        let s = idx.starts[i];
        let n = idx.lens[i];
        let q: u64 = 0;
        while q < n && q < 8192 { out.items[i].bytes[q] = content.bytes[s + q]; out.items[i].len = out.items[i].len + 1; q = q + 1; }
        out.len = out.len + 1;
        i = i + 1;
    }
}

fn lb_to_sb(lb: &LineBuf, out: &StrBuf) {
    sb_clear(out);
    let i: u64 = 0;
    while i < lb.len { sb_append_byte(out, lb.bytes[i]); i = i + 1; }
}

fn sb_to_lb(text: &StrBuf, lb: &LineBuf) {
    lb.len = 0;
    let i: u64 = 0;
    while i < text.len && i < 8192 { lb.bytes[i] = text.bytes[i]; lb.len = lb.len + 1; i = i + 1; }
}

fn join_lines(list: &LineBufList, eol_crlf: bool, out: &StrBuf) {
    sb_clear(out);
    let i: u64 = 0;
    while i < list.len {
        if i > 0 {
            if eol_crlf { sb_append_byte(out, 13); };
            sb_append_byte(out, 10);
        };
        let q: u64 = 0;
        while q < list.items[i].len { sb_append_byte(out, list.items[i].bytes[q]); q = q + 1; }
        i = i + 1;
    }
}

fn lines_insert(list: &LineBufList, at: u64, text: &StrBuf) {
    // lines.splice(at, 0, text)
    if list.len >= 8192 { return; };
    let i = list.len;
    while i > at {
        list.items[i] = list.items[i - 1];
        i = i - 1;
    }
    sb_to_lb(text, &list.items[at]);
    list.len = list.len + 1;
}

fn detect_eol_crlf(content: &StrBuf) -> bool {
    return sb_contains(content, STR_PTR("\r\n"), 2);
}

// ---- src/saVmTreeSitter.ts:1411-1525 — addImportToContent ----
// Pure text surgery; converted faithfully. _filePath is unused in the
// source (underscore-prefixed) and kept as an ignored parameter.
// DEFECT: the three regexes (named/default import parse, module
// import test, /\{[^}]+\}/ replace) — hand-rolled scanners below.
fn addImportToContent(content: &StrBuf, statementIn: &StrBuf, symbolIn: &StrBuf, moduleIn: &StrBuf, isType: bool, hasIsType: bool, outContent: &StrBuf, outApplied: &bool, outMessage: &StrBuf) {
    let statement = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_trim(statementIn, &statement); // (options.statement ?? "").trim()
    let symbol = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_trim(symbolIn, &symbol);
    let moduleName = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_trim(moduleIn, &moduleName);
    // If statement is provided, parse module and symbols from it
    if statement.len > 0 && (moduleName.len == 0 || symbol.len == 0) {
        parse_import_statement(&statement, &symbol, &moduleName);
    };
    if statement.len == 0 && symbol.len > 0 && moduleName.len > 0 {
        // statement = `import { ${typePrefix}${symbol} } from "${moduleName}";`
        sb_clear(&statement);
        sb_append(&statement, STR_PTR("import { "), STR_LEN("import { "));
        if hasIsType && isType { sb_append(&statement, STR_PTR("type "), STR_LEN("type ")); };
        let p: ptr = PTR_NULL();
        PTR_BYTE_ADD(p, &symbol.bytes, 0);
        sb_append(&statement, p, symbol.len);
        sb_append(&statement, STR_PTR(" } from \""), STR_LEN(" } from \""));
        let mp: ptr = PTR_NULL();
        PTR_BYTE_ADD(mp, &moduleName.bytes, 0);
        sb_append(&statement, mp, moduleName.len);
        sb_append(&statement, STR_PTR("\";"), STR_LEN("\";"));
    };
    sb_clear(outContent);
    sb_clear(outMessage);
    *outApplied = false;
    if statement.len == 0 {
        let q: u64 = 0;
        while q < content.len { sb_append_byte(outContent, content.bytes[q]); q = q + 1; }
        sb_append(outMessage, STR_PTR("Either 'statement' or 'symbol' + 'module' must be provided"), STR_LEN("Either 'statement' or 'symbol' + 'module' must be provided"));
        return;
    };
    let eolCrlf = detect_eol_crlf(content);
    let lines = LineBufList { items: [LineBuf { bytes: [0u8; 8192], len: 0 }; 8192], len: 0 };
    split_lines(content, &lines);
    // Check if module is already imported
    if moduleName.len > 0 {
        let i: u64 = 0;
        while i < lines.len {
            let line = StrBuf { bytes: [0u8; 65536], len: 0 };
            lb_to_sb(&lines.items[i], &line);
            let lt = StrBuf { bytes: [0u8; 65536], len: 0 };
            sb_trim(&line, &lt);
            if line_is_import_from(&lt, &moduleName) {
                if symbol.len > 0 {
                    // namedBrackets = line.match(/\{([^}]+)\}/)
                    let inner = StrBuf { bytes: [0u8; 65536], len: 0 };
                    if extract_braces_inner(&line, &inner) {
                        // existing = split(",").map(trim).filter(Boolean)
                        // missing = toAdd.filter(s => !existing.includes(s))
                        // DEFECT: string[] ops -> joined-buffer scans
                        let missing = StrBuf { bytes: [0u8; 65536], len: 0 };
                        csv_missing(&symbol, &inner, &missing);
                        if missing.len == 0 {
                            let q: u64 = 0;
                            while q < content.len { sb_append_byte(outContent, content.bytes[q]); q = q + 1; }
                            sb_append(outMessage, STR_PTR("Symbol(s) '"), STR_LEN("Symbol(s) '"));
                            let sp: ptr = PTR_NULL();
                            PTR_BYTE_ADD(sp, &symbol.bytes, 0);
                            sb_append(outMessage, sp, symbol.len);
                            sb_append(outMessage, STR_PTR("' already imported from '"), STR_LEN("' already imported from '"));
                            let mp: ptr = PTR_NULL();
                            PTR_BYTE_ADD(mp, &moduleName.bytes, 0);
                            sb_append(outMessage, mp, moduleName.len);
                            sb_append(outMessage, STR_PTR("' (no-op)."), STR_LEN("' (no-op)."));
                            return;
                        };
                        // lines[i] = line.replace(/\{[^}]+\}/, `{ ${updated} }`)
                        let updated = StrBuf { bytes: [0u8; 65536], len: 0 };
                        csv_join(&inner, &missing, &updated);
                        let replaced = StrBuf { bytes: [0u8; 65536], len: 0 };
                        replace_braces_inner(&line, &updated, &replaced);
                        sb_to_lb(&replaced, &lines.items[i]);
                        join_lines(&lines, eolCrlf, outContent);
                        *outApplied = true;
                        sb_append(outMessage, STR_PTR("Merged '"), STR_LEN("Merged '"));
                        let xp: ptr = PTR_NULL();
                        PTR_BYTE_ADD(xp, &missing.bytes, 0);
                        sb_append(outMessage, xp, missing.len);
                        sb_append(outMessage, STR_PTR("' into existing import from '"), STR_LEN("' into existing import from '"));
                        let mp2: ptr = PTR_NULL();
                        PTR_BYTE_ADD(mp2, &moduleName.bytes, 0);
                        sb_append(outMessage, mp2, moduleName.len);
                        sb_append(outMessage, STR_PTR("' at line "), STR_LEN("' at line "));
                        sb_append_u64(outMessage, i + 1);
                        sb_append_byte(outMessage, 46);
                        return;
                    };
                };
            };
            i = i + 1;
        }
    };
    // Find last import line in file
    let lastImportIdx: i64 = -1;
    let i: u64 = 0;
    while i < lines.len {
        let line = StrBuf { bytes: [0u8; 65536], len: 0 };
        lb_to_sb(&lines.items[i], &line);
        let lt = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_trim(&line, &lt);
        if sb_starts_with(&lt, STR_PTR("import "), STR_LEN("import ")) || sb_starts_with(&lt, STR_PTR("import{"), STR_LEN("import{")) || (sb_starts_with(&lt, STR_PTR("const "), STR_LEN("const ")) && sb_contains(&lt, STR_PTR("require("), STR_LEN("require("))) {
            lastImportIdx = i as i64;
        };
        i = i + 1;
    }
    if lastImportIdx != -1 {
        lines_insert(&lines, (lastImportIdx + 1) as u64, &statement);
        join_lines(&lines, eolCrlf, outContent);
        *outApplied = true;
        sb_append(outMessage, STR_PTR("Inserted import after line "), STR_LEN("Inserted import after line "));
        sb_append_u64(outMessage, (lastImportIdx + 1) as u64);
        sb_append_byte(outMessage, 46);
        return;
    };
    // Insert after directives/shebang/header comments
    let insertIdx: u64 = 0;
    while insertIdx < lines.len {
        let line = StrBuf { bytes: [0u8; 65536], len: 0 };
        lb_to_sb(&lines.items[insertIdx], &line);
        let lt = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_trim(&line, &lt);
        if sb_starts_with(&lt, STR_PTR("#!"), 2) || sb_starts_with(&lt, STR_PTR("//"), 2) || sb_starts_with(&lt, STR_PTR("/*"), 2) || sb_starts_with(&lt, STR_PTR("*"), 1) || sb_ends_with(&lt, STR_PTR("*/"), 2) ||
           sb_eq_lit(&lt, STR_PTR("\"use client\";"), STR_LEN("\"use client\";")) || sb_eq_lit(&lt, STR_PTR("\"use strict\";"), STR_LEN("\"use strict\";")) ||
           sb_eq_lit(&lt, STR_PTR("'use client';"), STR_LEN("'use client';")) || sb_eq_lit(&lt, STR_PTR("'use strict';"), STR_LEN("'use strict';")) || lt.len == 0 {
            insertIdx = insertIdx + 1;
        } else { break; };
    }
    lines_insert(&lines, insertIdx, &statement);
    let emptyLine = StrBuf { bytes: [0u8; 65536], len: 0 };
    lines_insert(&lines, insertIdx + 1, &emptyLine); // splice(idx, 0, statement, "")
    join_lines(&lines, eolCrlf, outContent);
    *outApplied = true;
    sb_append(outMessage, STR_PTR("Inserted import at line "), STR_LEN("Inserted import at line "));
    sb_append_u64(outMessage, insertIdx + 1);
    sb_append_byte(outMessage, 46);
}

fn sb_ends_with(b: &StrBuf, p: ptr, n: u64) -> bool {
    if b.len < n { return false; };
    let i: u64 = 0;
    while i < n {
        let c: u8 = 0;
        PTR_BYTE_AT(c, p, i);
        if b.bytes[b.len - n + i] != c { return false; };
        i = i + 1;
    }
    return true;
}

fn parse_import_statement(statement: &StrBuf, symbol: &StrBuf, moduleName: &StrBuf) {
    // namedMatch = /import\s+(?:type\s+)?\{([^}]+)\}\s+from\s+['"]([^'"]+)['"]/
    // else defaultMatch = /import\s+([A-Za-z0-9_$]+)\s+from\s+['"]([^'"]+)['"]/
    // DEFECT: regex -> brace/quote scans; symbol/module filled only on match.
    let inner = StrBuf { bytes: [0u8; 65536], len: 0 };
    if sb_starts_with(statement, STR_PTR("import"), STR_LEN("import")) && extract_braces_inner(statement, &inner) {
        let fromMod = StrBuf { bytes: [0u8; 65536], len: 0 };
        if extract_from_module(statement, &fromMod) {
            let t = StrBuf { bytes: [0u8; 65536], len: 0 };
            sb_trim(&inner, &t);
            if symbol.len == 0 { let p: ptr = PTR_NULL(); PTR_BYTE_ADD(p, &t.bytes, 0); sb_clear(symbol); sb_append(symbol, p, t.len); };
            if moduleName.len == 0 { let p: ptr = PTR_NULL(); PTR_BYTE_ADD(p, &fromMod.bytes, 0); sb_clear(moduleName); sb_append(moduleName, p, fromMod.len); };
            return;
        };
    };
    // default form: import Name from "mod"
    let fromMod = StrBuf { bytes: [0u8; 65536], len: 0 };
    if extract_from_module(statement, &fromMod) {
        // identifier between "import" and "from"
        let pos: u64 = 6;
        while pos < statement.len && (statement.bytes[pos] == 32 || statement.bytes[pos] == 9) { pos = pos + 1; }
        let at: u64 = 0;
        let ln: u64 = 0;
        if read_ident(statement, pos, &at, &ln) && symbol.len == 0 {
            sb_clear(symbol);
            let q: u64 = 0;
            while q < ln { sb_append_byte(symbol, statement.bytes[at + q]); q = q + 1; }
        };
        if moduleName.len == 0 { let p: ptr = PTR_NULL(); PTR_BYTE_ADD(p, &fromMod.bytes, 0); sb_clear(moduleName); sb_append(moduleName, p, fromMod.len); };
    };
}

fn extract_braces_inner(text: &StrBuf, out: &StrBuf) -> bool {
    sb_clear(out);
    let open: u64 = 0;
    let found = false;
    let i: u64 = 0;
    while i < text.len {
        if text.bytes[i] == 123 { open = i; found = true; break; };
        i = i + 1;
    }
    if !found { return false; };
    let j = open + 1;
    while j < text.len && text.bytes[j] != 125 { sb_append_byte(out, text.bytes[j]); j = j + 1; }
    return j < text.len;
}

fn extract_from_module(text: &StrBuf, out: &StrBuf) -> bool {
    // ... from 'mod' / from "mod" — last quoted segment after "from"
    sb_clear(out);
    let pos: u64 = 0;
    let fromAt: u64 = 0;
    let hasFrom = false;
    while pos + 4 <= text.len {
        if text.bytes[pos] == 102 && text.bytes[pos + 1] == 114 && text.bytes[pos + 2] == 111 && text.bytes[pos + 3] == 109 {
            fromAt = pos;
            hasFrom = true;
        };
        pos = pos + 1;
    }
    if !hasFrom { return false; };
    let i = fromAt + 4;
    while i < text.len && text.bytes[i] != 39 && text.bytes[i] != 34 { i = i + 1; }
    if i >= text.len { return false; };
    let quote = text.bytes[i];
    i = i + 1;
    while i < text.len && text.bytes[i] != quote { sb_append_byte(out, text.bytes[i]); i = i + 1; }
    return i < text.len;
}

fn replace_braces_inner(text: &StrBuf, inner: &StrBuf, out: &StrBuf) {
    // line.replace(/\{[^}]+\}/, `{ ${updatedSymbols} }`)
    sb_clear(out);
    let i: u64 = 0;
    let done = false;
    while i < text.len {
        if !done && text.bytes[i] == 123 {
            sb_append_byte(out, 123);
            sb_append_byte(out, 32);
            let p: ptr = PTR_NULL();
            PTR_BYTE_ADD(p, &inner.bytes, 0);
            sb_append(out, p, inner.len);
            sb_append_byte(out, 32);
            // skip to closing brace
            i = i + 1;
            while i < text.len && text.bytes[i] != 125 { i = i + 1; }
            if i < text.len { sb_append_byte(out, 125); i = i + 1; };
            done = true;
        } else {
            sb_append_byte(out, text.bytes[i]);
            i = i + 1;
        };
    }
}

fn csv_contains(csv: &StrBuf, item: &StrBuf) -> bool {
    // split(",").map(trim) membership test
    let pos: u64 = 0;
    while pos <= csv.len {
        let end = pos;
        while end < csv.len && csv.bytes[end] != 44 { end = end + 1; }
        let seg = StrBuf { bytes: [0u8; 65536], len: 0 };
        let q: u64 = 0;
        while pos + q < end { sb_append_byte(&seg, csv.bytes[pos + q]); q = q + 1; }
        let t = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_trim(&seg, &t);
        if sb_eq_buf(&t, item) { return true; };
        if end >= csv.len { break; };
        pos = end + 1;
    }
    return false;
}

fn csv_missing(symbolCsv: &StrBuf, existingCsv: &StrBuf, outMissing: &StrBuf) {
    // toAdd.filter(s => !existing.includes(s)).join(", ") — outMissing is
    // the \n-free ", "-joined missing list ("" when none missing).
    sb_clear(outMissing);
    let pos: u64 = 0;
    while pos <= symbolCsv.len {
        let end = pos;
        while end < symbolCsv.len && symbolCsv.bytes[end] != 44 { end = end + 1; }
        let seg = StrBuf { bytes: [0u8; 65536], len: 0 };
        let q: u64 = 0;
        while pos + q < end { sb_append_byte(&seg, symbolCsv.bytes[pos + q]); q = q + 1; }
        let t = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_trim(&seg, &t);
        if t.len > 0 && !csv_contains(existingCsv, &t) {
            if outMissing.len > 0 { sb_append(outMissing, STR_PTR(", "), STR_LEN(", ")); };
            let p: ptr = PTR_NULL();
            PTR_BYTE_ADD(p, &t.bytes, 0);
            sb_append(outMissing, p, t.len);
        };
        if end >= symbolCsv.len { break; };
        pos = end + 1;
    }
}

fn csv_join(existingCsv: &StrBuf, missingJoined: &StrBuf, out: &StrBuf) {
    // [...existing, ...missing].join(", ")
    sb_clear(out);
    let pos: u64 = 0;
    let first = true;
    while pos <= existingCsv.len {
        let end = pos;
        while end < existingCsv.len && existingCsv.bytes[end] != 44 { end = end + 1; }
        let seg = StrBuf { bytes: [0u8; 65536], len: 0 };
        let q: u64 = 0;
        while pos + q < end { sb_append_byte(&seg, existingCsv.bytes[pos + q]); q = q + 1; }
        let t = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_trim(&seg, &t);
        if t.len > 0 {
            if !first { sb_append(out, STR_PTR(", "), STR_LEN(", ")); };
            first = false;
            let p: ptr = PTR_NULL();
            PTR_BYTE_ADD(p, &t.bytes, 0);
            sb_append(out, p, t.len);
        };
        if end >= existingCsv.len { break; };
        pos = end + 1;
    }
    if missingJoined.len > 0 {
        if !first { sb_append(out, STR_PTR(", "), STR_LEN(", ")); };
        let p: ptr = PTR_NULL();
        PTR_BYTE_ADD(p, &missingJoined.bytes, 0);
        sb_append(out, p, missingJoined.len);
    };
}

fn line_is_import_from(trimmedLine: &StrBuf, moduleName: &StrBuf) -> bool {
    // importRegex = ^import\s+(?:type\s+)?(\{[^}]+\}|ident)?\s*from\s*['"]MOD['"]
    // DEFECT: regex with escaped module interpolation -> prefix + quote scan.
    if !sb_starts_with(trimmedLine, STR_PTR("import"), STR_LEN("import")) { return false; };
    let fromMod = StrBuf { bytes: [0u8; 65536], len: 0 };
    if !extract_from_module(trimmedLine, &fromMod) { return false; };
    return sb_eq_buf(&fromMod, moduleName);
}

// ---- src/saVmTreeSitter.ts:1542-1764 — organizeImportsInContent ----
// DEFECT: the source works on the typescript compiler AST
// (sf.statements, ts.isImportDeclaration, ImportDeclaration.importClause
// /namedBindings element objects, ts.forEachChild identifier collection
// with parent-kind exclusions, Set<string>, Map<string, ParsedImport>,
// Array.prototype.sort with localeCompare). No TS compiler exists in
// SLA; this conversion re-derives the same data from the source text:
// import statements are located between the first import's start offset
// and the last import's end offset, parsed textually into ParsedImport
// records, and used-identifier collection is a token scan of the
// non-import statements (property-key/method-name exclusions of the
// source are approximated — see defect log).
struct ParsedImport {
    moduleSpecifier: [u8; 512], moduleSpecifier_len: u64,
    isTypeOnly: bool,
    defaultName: [u8; 256], defaultName_len: u64, has_default: bool,
    namespaceName: [u8; 256], namespaceName_len: u64, has_namespace: bool,
    // named imports flattened: entries "name" or "prop as name", each
    // prefixed "type " when element-level type-only (DEFECT: object array)
    named: [u8; 8192], named_len: u64,
    named_isType: [u8; 8192], named_isType_len: u64, // parallel "\n" flags "1"/"0" per entry — kept as csv of 0/1
    sideEffectOnly: bool,
    removed: bool,
}

struct ParsedImportList {
    items: [ParsedImport; 512], len: u64,
}

fn getModulePriority(mod_sb: &StrBuf) -> u64 {
    // src: nested getModulePriority inside organizeImportsInContent
    if sb_starts_with(mod_sb, STR_PTR("node:"), STR_LEN("node:")) { return 1; };
    let bare = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_append(&bare, STR_PTR("fs path os crypto http https child_process events stream util url buffer"), STR_LEN("fs path os crypto http https child_process events stream util url buffer"));
    // ["fs",...].includes(mod)
    if csv_contains(&bare, mod_sb) { return 1; };
    if !sb_starts_with(mod_sb, STR_PTR("."), 1) {
        if sb_starts_with(mod_sb, STR_PTR("@/"), STR_LEN("@/")) || sb_starts_with(mod_sb, STR_PTR("@codex-ui/"), STR_LEN("@codex-ui/")) { return 3; };
        return 2;
    };
    if sb_starts_with(mod_sb, STR_PTR(".."), 2) { return 4; };
    if sb_ends_with(mod_sb, STR_PTR(".css"), STR_LEN(".css")) || sb_ends_with(mod_sb, STR_PTR(".scss"), STR_LEN(".scss")) || sb_ends_with(mod_sb, STR_PTR(".less"), STR_LEN(".less")) { return 6; };
    return 5;
    // (source's trailing `return 7` is unreachable there too)
}

fn organizeImportsInContent(st: &TreeSitterState, filePath: &StrBuf, content: &StrBuf, optRemoveUnused: bool, hasRemoveUnused: bool, optSort: bool, hasSort: bool, optMerge: bool, hasMerge: bool, out: &OrganizeImportsResult) {
    // options defaults: removeUnused !== false, sort !== false, mergeDuplicates !== false
    let removeUnused = !hasRemoveUnused || optRemoveUnused;
    let doSort = !hasSort || optSort;
    let mergeDuplicates = !hasMerge || optMerge;
    out.filePath_len = 0;
    let z: u64 = 0;
    while z < filePath.len && z < 1024 { out.filePath[z] = filePath.bytes[z]; out.filePath_len = out.filePath_len + 1; z = z + 1; }
    let ext = StrBuf { bytes: [0u8; 65536], len: 0 };
    path_extname(filePath, &ext);
    let el: u64 = 0;
    while el < ext.len {
        if ext.bytes[el] >= 65 && ext.bytes[el] <= 90 { ext.bytes[el] = ext.bytes[el] + 32; };
        el = el + 1;
    }
    let isTsJs = sb_eq_lit(&ext, STR_PTR(".ts"), 3) || sb_eq_lit(&ext, STR_PTR(".tsx"), 4) || sb_eq_lit(&ext, STR_PTR(".js"), 3) || sb_eq_lit(&ext, STR_PTR(".jsx"), 4) || sb_eq_lit(&ext, STR_PTR(".mts"), 4) || sb_eq_lit(&ext, STR_PTR(".cts"), 4) || sb_eq_lit(&ext, STR_PTR(".mjs"), 4) || sb_eq_lit(&ext, STR_PTR(".cjs"), 4);
    if !isTsJs {
        org_result(out, content, false, 0, 0, filePath, true);
        return;
    };
    let sf = getCachedSourceFile(st, STR_PTR(""), 0, content);
    // Locate import statements textually (source: sf.statements scan):
    // firstImportStart / lastImportEnd are byte offsets in content.
    let idx = LineIndex { starts: [0u64; 8192], lens: [0u64; 8192], count: 0 };
    build_line_index(content, &idx);
    let parsed = ParsedImportList { items: [ParsedImport { moduleSpecifier: [0u8; 512], moduleSpecifier_len: 0, isTypeOnly: false, defaultName: [0u8; 256], defaultName_len: 0, has_default: false, namespaceName: [0u8; 256], namespaceName_len: 0, has_namespace: false, named: [0u8; 8192], named_len: 0, named_isType: [0u8; 8192], named_isType_len: 0, sideEffectOnly: false, removed: false }; 512], len: 0 };
    let firstImportStart: i64 = -1;
    let lastImportEnd: u64 = 0;
    let importStmtCount: u64 = 0;
    let otherText = StrBuf { bytes: [0u8; 65536], len: 0 };
    let li: u64 = 0;
    while li < idx.count {
        let line = StrBuf { bytes: [0u8; 65536], len: 0 };
        line_at(content, &idx, li, &line);
        let lt = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_trim(&line, &lt);
        // DEFECT: multi-line import statements are single-line here;
        // source reads whole ImportDeclaration nodes regardless of lines.
        if sb_starts_with(&lt, STR_PTR("import "), STR_LEN("import ")) || sb_starts_with(&lt, STR_PTR("import{"), STR_LEN("import{")) || sb_eq_lit(&lt, STR_PTR("import"), STR_LEN("import")) {
            importStmtCount = importStmtCount + 1;
            if firstImportStart == -1 { firstImportStart = idx.starts[li] as i64; };
            lastImportEnd = idx.starts[li] + idx.lens[li];
            parse_import_line(&lt, &parsed);
        } else {
            // otherStatements -> identifier collection input
            let p: ptr = PTR_NULL();
            PTR_BYTE_ADD(p, &line.bytes, 0);
            sb_append(&otherText, p, line.len);
            sb_append_byte(&otherText, 10);
        };
        li = li + 1;
    }
    if importStmtCount == 0 {
        org_result(out, content, false, 0, 0, filePath, false);
        // formatted/summary: `[organize_imports] No imports found in ${filePath}.`
        set_org_text(out, filePath, false, 0, 0, true);
        return;
    };
    // usedIdentifiers: Set<string> from collectUsedIdentifiers over
    // otherStatements (+ "React" when JSX present). DEFECT: token scan;
    // the source's parent-kind exclusions (property assignment keys,
    // property access names, method/property declaration names) are only
    // approximated by skipping identifiers immediately preceded by ".".
    let usedCsv = StrBuf { bytes: [0u8; 65536], len: 0 };
    collect_used_identifiers(&otherText, &usedCsv);
    let hasJsx = sb_contains(&otherText, STR_PTR("<"), 1) && (csv_contains(&usedCsv, &usedCsv) && sb_contains(&otherText, STR_PTR("/>"), 2) || sb_contains(&otherText, STR_PTR("</"), 2));
    if hasJsx {
        let react = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_append(&react, STR_PTR("React"), STR_LEN("React"));
        if !csv_contains(&usedCsv, &react) {
            if usedCsv.len > 0 { sb_append_byte(&usedCsv, 44); };
            sb_append(&usedCsv, STR_PTR("React"), STR_LEN("React"));
        };
    };
    // Parse + removeUnused pass (source: per-ImportDeclaration loop)
    let removedImportsCount: u64 = 0;
    let pi: u64 = 0;
    while pi < parsed.len {
        if removeUnused {
            if parsed.items[pi].has_default {
                let dn = StrBuf { bytes: [0u8; 65536], len: 0 };
                buf_field_to_sb256(&parsed.items[pi].defaultName, parsed.items[pi].defaultName_len, &dn);
                if !csv_contains(&usedCsv, &dn) {
                    removedImportsCount = removedImportsCount + 1;
                    parsed.items[pi].has_default = false;
                };
            };
            if parsed.items[pi].has_namespace {
                let nn = StrBuf { bytes: [0u8; 65536], len: 0 };
                buf_field_to_sb256(&parsed.items[pi].namespaceName, parsed.items[pi].namespaceName_len, &nn);
                if !csv_contains(&usedCsv, &nn) {
                    removedImportsCount = removedImportsCount + 1;
                    parsed.items[pi].has_namespace = false;
                };
            };
            // keptNamed = namedImports.filter(n => usedIdentifiers.has(n.name))
            let namedCsv = StrBuf { bytes: [0u8; 65536], len: 0 };
            buf_field_to_sb(&parsed.items[pi].named, parsed.items[pi].named_len, &namedCsv);
            let before = csv_count(&namedCsv);
            let kept = StrBuf { bytes: [0u8; 65536], len: 0 };
            csv_filter_used(&namedCsv, &usedCsv, &kept);
            removedImportsCount = removedImportsCount + (before - csv_count(&kept));
            parsed.items[pi].named_len = 0;
            let q: u64 = 0;
            while q < kept.len && q < 8192 { parsed.items[pi].named[q] = kept.bytes[q]; parsed.items[pi].named_len = parsed.items[pi].named_len + 1; q = q + 1; }
            if !parsed.items[pi].has_default && !parsed.items[pi].has_namespace && csv_count(&kept) == 0 && !parsed.items[pi].sideEffectOnly {
                parsed.items[pi].removed = true;
            };
        };
        pi = pi + 1;
    }
    // Merge duplicates (source: Map keyed `${type|val}:${module}`)
    let mergedImportsCount: u64 = 0;
    if mergeDuplicates {
        let a: u64 = 0;
        while a < parsed.len {
            if parsed.items[a].removed || parsed.items[a].sideEffectOnly || parsed.items[a].has_namespace || parsed.items[a].has_default {
                a = a + 1;
                continue;
            };
            let b = a + 1;
            while b < parsed.len {
                if !parsed.items[b].removed && !parsed.items[b].sideEffectOnly && !parsed.items[b].has_namespace && !parsed.items[b].has_default &&
                   parsed.items[b].isTypeOnly == parsed.items[a].isTypeOnly &&
                   parsed.items[b].moduleSpecifier_len == parsed.items[a].moduleSpecifier_len &&
                   field_eq(&parsed.items[b].moduleSpecifier, parsed.items[b].moduleSpecifier_len, &parsed.items[a].moduleSpecifier, parsed.items[a].moduleSpecifier_len) {
                    mergedImportsCount = mergedImportsCount + 1;
                    // append named entries not already present
                    let bNamed = StrBuf { bytes: [0u8; 65536], len: 0 };
                    buf_field_to_sb(&parsed.items[b].named, parsed.items[b].named_len, &bNamed);
                    let aNamed = StrBuf { bytes: [0u8; 65536], len: 0 };
                    buf_field_to_sb(&parsed.items[a].named, parsed.items[a].named_len, &aNamed);
                    let miss = StrBuf { bytes: [0u8; 65536], len: 0 };
                    csv_missing_entries(&bNamed, &aNamed, &miss);
                    if miss.len > 0 {
                        if parsed.items[a].named_len > 0 && parsed.items[a].named_len < 8190 {
                            parsed.items[a].named[parsed.items[a].named_len] = 44;
                            parsed.items[a].named_len = parsed.items[a].named_len + 1;
                        };
                        let q: u64 = 0;
                        while q < miss.len && parsed.items[a].named_len < 8192 {
                            parsed.items[a].named[parsed.items[a].named_len] = miss.bytes[q];
                            parsed.items[a].named_len = parsed.items[a].named_len + 1;
                            q = q + 1;
                        }
                    };
                    parsed.items[b].removed = true;
                };
                b = b + 1;
            }
            a = a + 1;
        }
    };
    // Sort (source: finalImports.sort by priority then localeCompare)
    // DEFECT: localeCompare is locale-aware collation; byte compare used.
    if doSort {
        let a: u64 = 1;
        while a < parsed.len {
            let j = a;
            while j > 0 && !parsed.items[j].removed {
                let prev = prev_live(&parsed, j);
                if prev == j { break; };
                let ma = StrBuf { bytes: [0u8; 65536], len: 0 };
                buf_field_to_sb2(&parsed.items[j].moduleSpecifier, parsed.items[j].moduleSpecifier_len, &ma);
                let mb = StrBuf { bytes: [0u8; 65536], len: 0 };
                buf_field_to_sb2(&parsed.items[prev].moduleSpecifier, parsed.items[prev].moduleSpecifier_len, &mb);
                let pa = getModulePriority(&ma);
                let pb = getModulePriority(&mb);
                let swap = false;
                if pa < pb { swap = true; };
                if pa == pb && sb_compare(&ma, &mb) < 0 { swap = true; };
                if !swap { break; };
                let tmp = parsed.items[j];
                parsed.items[j] = parsed.items[prev];
                parsed.items[prev] = tmp;
                j = prev;
            }
            a = a + 1;
        }
    };
    // Render lines
    let rendered = StrBuf { bytes: [0u8; 65536], len: 0 };
    let eolCrlf = detect_eol_crlf(content);
    let firstRendered = true;
    let ri: u64 = 0;
    while ri < parsed.len {
        if parsed.items[ri].removed { ri = ri + 1; continue; };
        if !firstRendered {
            if eolCrlf { sb_append_byte(&rendered, 13); };
            sb_append_byte(&rendered, 10);
        };
        firstRendered = false;
        render_import(&parsed.items[ri], &rendered);
        ri = ri + 1;
    }
    // newContent = beforeImports + newImportText + eol + eol + afterImports.trimStart()
    let newContent = StrBuf { bytes: [0u8; 65536], len: 0 };
    let bq: u64 = 0;
    let beforeEnd = firstImportStart as u64;
    while bq < beforeEnd && bq < content.len { sb_append_byte(&newContent, content.bytes[bq]); bq = bq + 1; }
    let rp: ptr = PTR_NULL();
    PTR_BYTE_ADD(rp, &rendered.bytes, 0);
    sb_append(&newContent, rp, rendered.len);
    if eolCrlf { sb_append_byte(&newContent, 13); };
    sb_append_byte(&newContent, 10);
    if eolCrlf { sb_append_byte(&newContent, 13); };
    sb_append_byte(&newContent, 10);
    // afterImports = content.slice(lastImportEnd).replace(/^\r?\n/, "") then trimStart
    let after = StrBuf { bytes: [0u8; 65536], len: 0 };
    let aq = lastImportEnd;
    if aq < content.len && content.bytes[aq] == 13 { aq = aq + 1; };
    if aq < content.len && content.bytes[aq] == 10 { aq = aq + 1; };
    while aq < content.len { sb_append_byte(&after, content.bytes[aq]); aq = aq + 1; }
    let afterTrim = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_trim_start(&after, &afterTrim);
    let ap: ptr = PTR_NULL();
    PTR_BYTE_ADD(ap, &afterTrim.bytes, 0);
    sb_append(&newContent, ap, afterTrim.len);
    let applied = !sb_eq_buf(&newContent, content);
    org_result_fill(out, &newContent, applied, removedImportsCount, mergedImportsCount);
    set_org_text(out, filePath, applied, removedImportsCount, mergedImportsCount, false);
}

fn sb_trim_start(b: &StrBuf, out: &StrBuf) {
    sb_clear(out);
    let s: u64 = 0;
    while s < b.len {
        let c = b.bytes[s];
        if c == 32 || c == 9 || c == 10 || c == 13 { s = s + 1; } else { break; };
    }
    let i = s;
    while i < b.len { sb_append_byte(out, b.bytes[i]); i = i + 1; }
}

fn sb_compare(a: &StrBuf, b: &StrBuf) -> i32 {
    let n = a.len;
    if b.len < n { n = b.len; };
    let i: u64 = 0;
    while i < n {
        if a.bytes[i] < b.bytes[i] { return -1; };
        if a.bytes[i] > b.bytes[i] { return 1; };
        i = i + 1;
    }
    if a.len < b.len { return -1; };
    if a.len > b.len { return 1; };
    return 0;
}

fn buf_field_to_sb(field: &[u8; 8192], n: u64, out: &StrBuf) {
    sb_clear(out);
    let i: u64 = 0;
    while i < n { sb_append_byte(out, field[i]); i = i + 1; }
}

fn buf_field_to_sb1024(field: &[u8; 1024], n: u64, out: &StrBuf) {
    sb_clear(out);
    let i: u64 = 0;
    while i < n { sb_append_byte(out, field[i]); i = i + 1; }
}

fn buf_field_to_sb4096(field: &[u8; 4096], n: u64, out: &StrBuf) {
    sb_clear(out);
    let i: u64 = 0;
    while i < n { sb_append_byte(out, field[i]); i = i + 1; }
}

fn buf_field_to_sb64(field: &[u8; 64], n: u64, out: &StrBuf) {
    sb_clear(out);
    let i: u64 = 0;
    while i < n { sb_append_byte(out, field[i]); i = i + 1; }
}

fn buf_field_to_sb256(field: &[u8; 256], n: u64, out: &StrBuf) {
    sb_clear(out);
    let i: u64 = 0;
    while i < n { sb_append_byte(out, field[i]); i = i + 1; }
}

fn field_eq(a: &[u8; 512], an: u64, b: &[u8; 512], bn: u64) -> bool {
    if an != bn { return false; };
    let i: u64 = 0;
    while i < an {
        if a[i] != b[i] { return false; };
        i = i + 1;
    }
    return true;
}

fn prev_live(list: &ParsedImportList, j: u64) -> u64 {
    let k = j;
    while k > 0 {
        k = k - 1;
        if !list.items[k].removed { return k; };
    }
    return j;
}

fn csv_count(csv: &StrBuf) -> u64 {
    if csv.len == 0 { return 0; };
    let n: u64 = 1;
    let i: u64 = 0;
    while i < csv.len {
        if csv.bytes[i] == 44 { n = n + 1; };
        i = i + 1;
    }
    return n;
}

fn csv_filter_used(namedCsv: &StrBuf, usedCsv: &StrBuf, out: &StrBuf) {
    // keep entries whose local name (after " as " / "type " stripping)
    // is in usedCsv; entries here are stored as local names already.
    sb_clear(out);
    let pos: u64 = 0;
    while pos <= namedCsv.len {
        let end = pos;
        while end < namedCsv.len && namedCsv.bytes[end] != 44 { end = end + 1; }
        let seg = StrBuf { bytes: [0u8; 65536], len: 0 };
        let q: u64 = 0;
        while pos + q < end { sb_append_byte(&seg, namedCsv.bytes[pos + q]); q = q + 1; }
        let t = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_trim(&seg, &t);
        // local name = last token after " as "
        let local = StrBuf { bytes: [0u8; 65536], len: 0 };
        csv_local_name(&t, &local);
        if t.len > 0 && csv_contains(usedCsv, &local) {
            if out.len > 0 { sb_append(out, STR_PTR(", "), STR_LEN(", ")); };
            let p: ptr = PTR_NULL();
            PTR_BYTE_ADD(p, &t.bytes, 0);
            sb_append(out, p, t.len);
        };
        if end >= namedCsv.len { break; };
        pos = end + 1;
    }
}

fn csv_local_name(entry: &StrBuf, out: &StrBuf) {
    // "type X" -> X ; "A as B" -> B ; "X" -> X
    sb_clear(out);
    let t = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_trim(entry, &t);
    let start: u64 = 0;
    if sb_starts_with(&t, STR_PTR("type "), STR_LEN("type ")) { start = 5; };
    // find " as "
    let asAt: i64 = -1;
    let i = start;
    while i + 4 <= t.len {
        if t.bytes[i] == 32 && t.bytes[i + 1] == 97 && t.bytes[i + 2] == 115 && t.bytes[i + 3] == 32 { asAt = i as i64; };
        i = i + 1;
    }
    if asAt != -1 { start = (asAt as u64) + 4; };
    while start < t.len { sb_append_byte(out, t.bytes[start]); start = start + 1; }
    let tr = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_trim(out, &tr);
    sb_clear(out);
    let p: ptr = PTR_NULL();
    PTR_BYTE_ADD(p, &tr.bytes, 0);
    sb_append(out, p, tr.len);
}

fn csv_missing_entries(fromCsv: &StrBuf, existingCsv: &StrBuf, out: &StrBuf) {
    // entries of fromCsv not literally present in existingCsv
    sb_clear(out);
    let pos: u64 = 0;
    while pos <= fromCsv.len {
        let end = pos;
        while end < fromCsv.len && fromCsv.bytes[end] != 44 { end = end + 1; }
        let seg = StrBuf { bytes: [0u8; 65536], len: 0 };
        let q: u64 = 0;
        while pos + q < end { sb_append_byte(&seg, fromCsv.bytes[pos + q]); q = q + 1; }
        let t = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_trim(&seg, &t);
        if t.len > 0 && !csv_contains(existingCsv, &t) {
            if out.len > 0 { sb_append(out, STR_PTR(", "), STR_LEN(", ")); };
            let p: ptr = PTR_NULL();
            PTR_BYTE_ADD(p, &t.bytes, 0);
            sb_append(out, p, t.len);
        };
        if end >= fromCsv.len { break; };
        pos = end + 1;
    }
}

fn collect_used_identifiers(text: &StrBuf, outCsv: &StrBuf) {
    // identifier token scan with dedup into a csv "set"
    sb_clear(outCsv);
    let i: u64 = 0;
    while i < text.len {
        let c = text.bytes[i];
        let startByte = (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 || c == 36;
        if startByte {
            let s = i;
            while i < text.len && is_word_byte(text.bytes[i]) { i = i + 1; }
            // skip property-access names (preceded by ".")
            let precededByDot = s > 0 && text.bytes[s - 1] == 46;
            if !precededByDot {
                let tok = StrBuf { bytes: [0u8; 65536], len: 0 };
                let q = s;
                while q < i { sb_append_byte(&tok, text.bytes[q]); q = q + 1; }
                if !csv_contains(outCsv, &tok) {
                    if outCsv.len > 0 { sb_append_byte(outCsv, 44); };
                    let p: ptr = PTR_NULL();
                    PTR_BYTE_ADD(p, &tok.bytes, 0);
                    sb_append(outCsv, p, tok.len);
                };
            };
        } else {
            i = i + 1;
        };
    }
}

fn parse_import_line(lt: &StrBuf, list: &ParsedImportList) {
    // Textual parse of one import statement line into a ParsedImport:
    //   import "mod";                       -> sideEffectOnly
    //   import [type] Def from "mod";
    //   import [type] * as Ns from "mod";
    //   import [type] { a, b as c, type d } from "mod";
    //   import [type] Def, { ... } from "mod";
    // DEFECT: AST ImportClause structure -> string surgery.
    if list.len >= 512 { return; };
    let idxSlot = list.len;
    list.items[idxSlot].removed = false;
    let mod_sb = StrBuf { bytes: [0u8; 65536], len: 0 };
    if !extract_from_module(lt, &mod_sb) {
        // side-effect import: import "mod";
        let q1 = first_quote(lt);
        if q1 >= 0 {
            extract_quoted(lt, q1 as u64, &mod_sb);
            list.items[idxSlot].sideEffectOnly = true;
        } else {
            return;
        };
    };
    list.items[idxSlot].moduleSpecifier_len = 0;
    let q: u64 = 0;
    while q < mod_sb.len && q < 512 { list.items[idxSlot].moduleSpecifier[q] = mod_sb.bytes[q]; list.items[idxSlot].moduleSpecifier_len = list.items[idxSlot].moduleSpecifier_len + 1; q = q + 1; }
    if list.items[idxSlot].sideEffectOnly { list.len = list.len + 1; return; };
    // clause text between "import" and " from "
    let clause = StrBuf { bytes: [0u8; 65536], len: 0 };
    import_clause_text(lt, &clause);
    let ct = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_trim(&clause, &ct);
    if sb_starts_with(&ct, STR_PTR("type "), STR_LEN("type ")) || sb_eq_lit(&ct, STR_PTR("type"), STR_LEN("type")) {
        list.items[idxSlot].isTypeOnly = true;
        let rest = StrBuf { bytes: [0u8; 65536], len: 0 };
        let s: u64 = 5;
        while s < ct.len { sb_append_byte(&rest, ct.bytes[s]); s = s + 1; }
        let rt = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_trim(&rest, &rt);
        ct = rt;
    };
    if sb_starts_with(&ct, STR_PTR("* as "), STR_LEN("* as ")) {
        let ns = StrBuf { bytes: [0u8; 65536], len: 0 };
        let s: u64 = 5;
        while s < ct.len { sb_append_byte(&ns, ct.bytes[s]); s = s + 1; }
        let nt = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_trim(&ns, &nt);
        list.items[idxSlot].has_namespace = true;
        list.items[idxSlot].namespaceName_len = 0;
        let w: u64 = 0;
        while w < nt.len && w < 256 { list.items[idxSlot].namespaceName[w] = nt.bytes[w]; list.items[idxSlot].namespaceName_len = list.items[idxSlot].namespaceName_len + 1; w = w + 1; }
        list.len = list.len + 1;
        return;
    };
    // named braces
    let inner = StrBuf { bytes: [0u8; 65536], len: 0 };
    let hasBraces = extract_braces_inner(&ct, &inner);
    if hasBraces {
        // named entries stored verbatim, ", "-joined; element type-only
        // kept inline as "type X" (rendering re-derives the prefix)
        let norm = StrBuf { bytes: [0u8; 65536], len: 0 };
        csv_normalize_join(&inner, &norm);
        list.items[idxSlot].named_len = 0;
        let w: u64 = 0;
        while w < norm.len && w < 8192 { list.items[idxSlot].named[w] = norm.bytes[w]; list.items[idxSlot].named_len = list.items[idxSlot].named_len + 1; w = w + 1; }
        // default name: text before "{"
        let pre = StrBuf { bytes: [0u8; 65536], len: 0 };
        let s: u64 = 0;
        while s < ct.len && ct.bytes[s] != 123 { sb_append_byte(&pre, ct.bytes[s]); s = s + 1; }
        let pt = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_trim(&pre, &pt);
        if pt.len > 0 && pt.bytes[pt.len - 1] == 44 { pt.len = pt.len - 1; };
        let pt2 = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_trim(&pt, &pt2);
        if pt2.len > 0 {
            list.items[idxSlot].has_default = true;
            list.items[idxSlot].defaultName_len = 0;
            let w2: u64 = 0;
            while w2 < pt2.len && w2 < 256 { list.items[idxSlot].defaultName[w2] = pt2.bytes[w2]; list.items[idxSlot].defaultName_len = list.items[idxSlot].defaultName_len + 1; w2 = w2 + 1; }
        };
    } else if ct.len > 0 {
        // default-only import
        list.items[idxSlot].has_default = true;
        list.items[idxSlot].defaultName_len = 0;
        let w: u64 = 0;
        while w < ct.len && w < 256 { list.items[idxSlot].defaultName[w] = ct.bytes[w]; list.items[idxSlot].defaultName_len = list.items[idxSlot].defaultName_len + 1; w = w + 1; }
    };
    list.len = list.len + 1;
}

fn first_quote(text: &StrBuf) -> i64 {
    let i: u64 = 0;
    while i < text.len {
        if text.bytes[i] == 39 || text.bytes[i] == 34 { return i as i64; };
        i = i + 1;
    }
    return -1;
}

fn extract_quoted(text: &StrBuf, quoteAt: u64, out: &StrBuf) {
    sb_clear(out);
    let quote = text.bytes[quoteAt];
    let i = quoteAt + 1;
    while i < text.len && text.bytes[i] != quote { sb_append_byte(out, text.bytes[i]); i = i + 1; }
}

fn import_clause_text(lt: &StrBuf, out: &StrBuf) {
    // text between leading "import" and the last " from "
    sb_clear(out);
    let fromAt: i64 = -1;
    let i: u64 = 0;
    while i + 6 <= lt.len {
        if lt.bytes[i] == 32 && lt.bytes[i + 1] == 102 && lt.bytes[i + 2] == 114 && lt.bytes[i + 3] == 111 && lt.bytes[i + 4] == 109 && lt.bytes[i + 5] == 32 { fromAt = i as i64; };
        i = i + 1;
    }
    let start: u64 = 6; // after "import"
    let end = lt.len;
    if fromAt != -1 { end = fromAt as u64; };
    while start < end { sb_append_byte(out, lt.bytes[start]); start = start + 1; }
}

fn csv_normalize_join(csv: &StrBuf, out: &StrBuf) {
    sb_clear(out);
    let pos: u64 = 0;
    while pos <= csv.len {
        let end = pos;
        while end < csv.len && csv.bytes[end] != 44 { end = end + 1; }
        let seg = StrBuf { bytes: [0u8; 65536], len: 0 };
        let q: u64 = 0;
        while pos + q < end { sb_append_byte(&seg, csv.bytes[pos + q]); q = q + 1; }
        let t = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_trim(&seg, &t);
        if t.len > 0 {
            if out.len > 0 { sb_append(out, STR_PTR(", "), STR_LEN(", ")); };
            let p: ptr = PTR_NULL();
            PTR_BYTE_ADD(p, &t.bytes, 0);
            sb_append(out, p, t.len);
        };
        if end >= csv.len { break; };
        pos = end + 1;
    }
}

fn render_import(item: &ParsedImport, out: &StrBuf) {
    let mod_sb = StrBuf { bytes: [0u8; 65536], len: 0 };
    buf_field_to_sb2(&item.moduleSpecifier, item.moduleSpecifier_len, &mod_sb);
    if item.sideEffectOnly {
        sb_append(out, STR_PTR("import \""), STR_LEN("import \""));
        let p: ptr = PTR_NULL();
        PTR_BYTE_ADD(p, &mod_sb.bytes, 0);
        sb_append(out, p, mod_sb.len);
        sb_append(out, STR_PTR("\";"), STR_LEN("\";"));
        return;
    };
    // named imports sorted by name (source sorts namedImports in place)
    let named = StrBuf { bytes: [0u8; 65536], len: 0 };
    buf_field_to_sb(&item.named, item.named_len, &named);
    let sortedNamed = StrBuf { bytes: [0u8; 65536], len: 0 };
    csv_sort_entries(&named, &sortedNamed);
    sb_append(out, STR_PTR("import "), STR_LEN("import "));
    if item.isTypeOnly { sb_append(out, STR_PTR("type "), STR_LEN("type ")); };
    let wrotePart = false;
    if item.has_default {
        let dn = StrBuf { bytes: [0u8; 65536], len: 0 };
        buf_field_to_sb256(&item.defaultName, item.defaultName_len, &dn);
        let p: ptr = PTR_NULL();
        PTR_BYTE_ADD(p, &dn.bytes, 0);
        sb_append(out, p, dn.len);
        wrotePart = true;
    };
    if item.has_namespace {
        if wrotePart { sb_append(out, STR_PTR(", "), STR_LEN(", ")); };
        sb_append(out, STR_PTR("* as "), STR_LEN("* as "));
        let nn = StrBuf { bytes: [0u8; 65536], len: 0 };
        buf_field_to_sb256(&item.namespaceName, item.namespaceName_len, &nn);
        let p: ptr = PTR_NULL();
        PTR_BYTE_ADD(p, &nn.bytes, 0);
        sb_append(out, p, nn.len);
        wrotePart = true;
    };
    if sortedNamed.len > 0 {
        if wrotePart { sb_append(out, STR_PTR(", "), STR_LEN(", ")); };
        sb_append(out, STR_PTR("{ "), STR_LEN("{ "));
        // element "type X" prefix retained only when !isTypeOnly
        // (source: typePrefix = n.isType && !item.isTypeOnly ? "type " : "")
        let p: ptr = PTR_NULL();
        PTR_BYTE_ADD(p, &sortedNamed.bytes, 0);
        sb_append(out, p, sortedNamed.len);
        sb_append(out, STR_PTR(" }"), STR_LEN(" }"));
    };
    sb_append(out, STR_PTR(" from \""), STR_LEN(" from \""));
    let mp: ptr = PTR_NULL();
    PTR_BYTE_ADD(mp, &mod_sb.bytes, 0);
    sb_append(out, mp, mod_sb.len);
    sb_append(out, STR_PTR("\";"), STR_LEN("\";"));
}

fn buf_field_to_sb2(field: &[u8; 512], n: u64, out: &StrBuf) {
    sb_clear(out);
    let i: u64 = 0;
    while i < n { sb_append_byte(out, field[i]); i = i + 1; }
}

fn csv_sort_entries(csv: &StrBuf, out: &StrBuf) {
    // insertion sort of csv entries by byte compare (source:
    // namedImports.sort((a,b) => a.name.localeCompare(b.name)))
    sb_clear(out);
    // copy entries into a scratch csv repeatedly picking the minimum
    let rest = StrBuf { bytes: [0u8; 65536], len: 0 };
    let p: ptr = PTR_NULL();
    PTR_BYTE_ADD(p, &csv.bytes, 0);
    sb_append(&rest, p, csv.len);
    while csv_count(&rest) > 0 {
        // find min entry
        let minEntry = StrBuf { bytes: [0u8; 65536], len: 0 };
        csv_min_entry(&rest, &minEntry);
        if out.len > 0 { sb_append(out, STR_PTR(", "), STR_LEN(", ")); };
        let mp: ptr = PTR_NULL();
        PTR_BYTE_ADD(mp, &minEntry.bytes, 0);
        sb_append(out, mp, minEntry.len);
        let next = StrBuf { bytes: [0u8; 65536], len: 0 };
        csv_remove_entry(&rest, &minEntry, &next);
        rest = next;
    }
}

fn csv_min_entry(csv: &StrBuf, out: &StrBuf) {
    sb_clear(out);
    let pos: u64 = 0;
    let first = true;
    while pos <= csv.len {
        let end = pos;
        while end < csv.len && csv.bytes[end] != 44 { end = end + 1; }
        let seg = StrBuf { bytes: [0u8; 65536], len: 0 };
        let q: u64 = 0;
        while pos + q < end { sb_append_byte(&seg, csv.bytes[pos + q]); q = q + 1; }
        let t = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_trim(&seg, &t);
        if t.len > 0 && (first || sb_compare(&t, out) < 0) {
            sb_clear(out);
            let p: ptr = PTR_NULL();
            PTR_BYTE_ADD(p, &t.bytes, 0);
            sb_append(out, p, t.len);
            first = false;
        };
        if end >= csv.len { break; };
        pos = end + 1;
    }
}

fn csv_remove_entry(csv: &StrBuf, entry: &StrBuf, out: &StrBuf) {
    sb_clear(out);
    let pos: u64 = 0;
    let removed = false;
    while pos <= csv.len {
        let end = pos;
        while end < csv.len && csv.bytes[end] != 44 { end = end + 1; }
        let seg = StrBuf { bytes: [0u8; 65536], len: 0 };
        let q: u64 = 0;
        while pos + q < end { sb_append_byte(&seg, csv.bytes[pos + q]); q = q + 1; }
        let t = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_trim(&seg, &t);
        if t.len > 0 {
            if !removed && sb_eq_buf(&t, entry) {
                removed = true;
            } else {
                if out.len > 0 { sb_append(out, STR_PTR(", "), STR_LEN(", ")); };
                let p: ptr = PTR_NULL();
                PTR_BYTE_ADD(p, &t.bytes, 0);
                sb_append(out, p, t.len);
            };
        };
        if end >= csv.len { break; };
        pos = end + 1;
    }
}

fn org_result(out: &OrganizeImportsResult, content: &StrBuf, applied: bool, removed: u64, merged: u64, filePath: &StrBuf, skipped: bool) {
    out.applied = applied;
    out.changed = applied;
    out.newContent_len = 0;
    let i: u64 = 0;
    while i < content.len && i < 65536 { out.newContent[i] = content.bytes[i]; out.newContent_len = out.newContent_len + 1; i = i + 1; }
    out.removedImportsCount = removed;
    out.removedUnusedCount = removed;
    out.mergedImportsCount = merged;
    out.mergedCount = merged;
    if skipped {
        // formatted/summary: `... Skipped: ${filePath} is not a JavaScript/TypeScript file.`
        set_org_text_skipped(out, filePath);
    };
}

fn org_result_fill(out: &OrganizeImportsResult, newContent: &StrBuf, applied: bool, removed: u64, merged: u64) {
    out.applied = applied;
    out.changed = applied;
    out.newContent_len = 0;
    let i: u64 = 0;
    while i < newContent.len && i < 65536 { out.newContent[i] = newContent.bytes[i]; out.newContent_len = out.newContent_len + 1; i = i + 1; }
    out.removedImportsCount = removed;
    out.removedUnusedCount = removed;
    out.mergedImportsCount = merged;
    out.mergedCount = merged;
}

fn set_org_text_skipped(out: &OrganizeImportsResult, filePath: &StrBuf) {
    let fb = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_append(&fb, STR_PTR("[organize_imports] Skipped: "), STR_LEN("[organize_imports] Skipped: "));
    let fp: ptr = PTR_NULL();
    PTR_BYTE_ADD(fp, &filePath.bytes, 0);
    sb_append(&fb, fp, filePath.len);
    sb_append(&fb, STR_PTR(" is not a JavaScript/TypeScript file."), STR_LEN(" is not a JavaScript/TypeScript file."));
    out.formatted_len = 0;
    let i: u64 = 0;
    while i < fb.len && i < 2048 { out.formatted[i] = fb.bytes[i]; out.formatted_len = out.formatted_len + 1; i = i + 1; }
    let sb2 = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_append(&sb2, STR_PTR("Skipped: "), STR_LEN("Skipped: "));
    sb_append(&sb2, fp, filePath.len);
    sb_append(&sb2, STR_PTR(" is not a JavaScript/TypeScript file."), STR_LEN(" is not a JavaScript/TypeScript file."));
    out.summary_len = 0;
    let j: u64 = 0;
    while j < sb2.len && j < 2048 { out.summary[j] = sb2.bytes[j]; out.summary_len = out.summary_len + 1; j = j + 1; }
}

fn set_org_text(out: &OrganizeImportsResult, filePath: &StrBuf, applied: bool, removed: u64, merged: u64, noImports: bool) {
    let fb = StrBuf { bytes: [0u8; 65536], len: 0 };
    let sm = StrBuf { bytes: [0u8; 65536], len: 0 };
    let fp: ptr = PTR_NULL();
    PTR_BYTE_ADD(fp, &filePath.bytes, 0);
    if noImports {
        sb_append(&fb, STR_PTR("[organize_imports] No imports found in "), STR_LEN("[organize_imports] No imports found in "));
        sb_append(&fb, fp, filePath.len);
        sb_append_byte(&fb, 46);
        sb_append(&sm, STR_PTR("No imports found in "), STR_LEN("No imports found in "));
        sb_append(&sm, fp, filePath.len);
        sb_append_byte(&sm, 46);
    } else {
        sb_append(&fb, STR_PTR("[organize_imports] "), STR_LEN("[organize_imports] "));
        if applied { sb_append(&fb, STR_PTR("Organized"), STR_LEN("Organized")); } else { sb_append(&fb, STR_PTR("Clean"), STR_LEN("Clean")); };
        sb_append(&fb, STR_PTR(" in "), STR_LEN(" in "));
        sb_append(&fb, fp, filePath.len);
        sb_append(&fb, STR_PTR(": removed "), STR_LEN(": removed "));
        sb_append_u64(&fb, removed);
        sb_append(&fb, STR_PTR(" unused specifier(s), merged "), STR_LEN(" unused specifier(s), merged "));
        sb_append_u64(&fb, merged);
        sb_append(&fb, STR_PTR(" duplicate module(s)."), STR_LEN(" duplicate module(s)."));
        sb_append(&sm, STR_PTR("Organized imports in "), STR_LEN("Organized imports in "));
        sb_append(&sm, fp, filePath.len);
        sb_append(&sm, STR_PTR(": removed "), STR_LEN(": removed "));
        sb_append_u64(&sm, removed);
        sb_append(&sm, STR_PTR(" unused specifier(s), merged "), STR_LEN(" unused specifier(s), merged "));
        sb_append_u64(&sm, merged);
        sb_append(&sm, STR_PTR(" duplicate module(s)."), STR_LEN(" duplicate module(s)."));
    };
    out.formatted_len = 0;
    let i: u64 = 0;
    while i < fb.len && i < 2048 { out.formatted[i] = fb.bytes[i]; out.formatted_len = out.formatted_len + 1; i = i + 1; }
    out.summary_len = 0;
    let j: u64 = 0;
    while j < sm.len && j < 2048 { out.summary[j] = sm.bytes[j]; out.summary_len = out.summary_len + 1; j = j + 1; }
}

// ---- src/saVmTreeSitter.ts:1779-1796 — JS_GLOBALS / TS_RESERVED ----
// DEFECT: Set<string> literals -> csv tables scanned linearly.
fn js_globals_csv(out: &StrBuf) {
    sb_clear(out);
    sb_append(out, STR_PTR("window,document,console,Math,JSON,Promise,Boolean,String,Number,Array,Object,Function,Error,RegExp,Date,Map,Set,WeakMap,WeakSet,Symbol,undefined,null,true,false,NaN,Infinity,Buffer,process,event,setTimeout,clearTimeout,setInterval,clearInterval,fetch,alert,confirm,location,history,navigator,localStorage,sessionStorage,Intl,requestAnimationFrame,cancelAnimationFrame,crypto,performance,URL,URLSearchParams,React,void,typeof,instanceof,in"), STR_LEN("window,document,console,Math,JSON,Promise,Boolean,String,Number,Array,Object,Function,Error,RegExp,Date,Map,Set,WeakMap,WeakSet,Symbol,undefined,null,true,false,NaN,Infinity,Buffer,process,event,setTimeout,clearTimeout,setInterval,clearInterval,fetch,alert,confirm,location,history,navigator,localStorage,sessionStorage,Intl,requestAnimationFrame,cancelAnimationFrame,crypto,performance,URL,URLSearchParams,React,void,typeof,instanceof,in"));
}

fn ts_reserved_csv(out: &StrBuf) {
    sb_clear(out);
    sb_append(out, STR_PTR("break,case,catch,class,const,continue,debugger,default,delete,do,else,enum,export,extends,finally,for,function,if,import,in,instanceof,new,return,super,switch,this,throw,try,typeof,var,void,while,with,implements,interface,let,package,private,protected,public,static,yield,false,null,true"), STR_LEN("break,case,catch,class,const,continue,debugger,default,delete,do,else,enum,export,extends,finally,for,function,if,import,in,instanceof,new,return,super,switch,this,throw,try,typeof,var,void,while,with,implements,interface,let,package,private,protected,public,static,yield,false,null,true"));
}

fn csv_has(csvText: &StrBuf, name: &StrBuf) -> bool {
    // csv_contains works on ", "- or ","-joined tables whose entries have
    // no surrounding spaces in the tables above
    return csv_contains(csvText, name);
}

// ---- src/saVmTreeSitter.ts:1798-2023 — analyzeBlockScope ----
// DEFECT: this function is defined entirely over the typescript
// compiler AST: sf.getPositionOfLineAndCharacter, ts.isVariableDeclaration
// /isFunctionDeclaration/isParameter/isTypeAliasDeclaration/
// isInterfaceDeclaration guards, ArrayBindingPattern (useState
// destructuring) inference, JSX tag handling, ts.forEachChild walks
// (walkBlock / walkOuter) with closures capturing Sets/Maps, fnSigText
// reading fnNode.parameters[].type_.getText(sf), and Set spread
// [...blockUsedIdentifiers].filter(...). No TS compiler exists in SLA.
// Conversion below keeps the signature, the line-range math, the
// capture filtering rules (declared / imported / JS_GLOBALS /
// TS_RESERVED / numeric), the name-based type inference fallbacks
// (setX / on* / handle* / is* / has* / allow*), and the exact
// props-interface / call-snippet / summary assembly; identifier
// collection and outer-declaration inference are token scans over the
// block's lines (type-position and JSX subtleties approximated).
fn analyzeBlockScope(st: &TreeSitterState, filePath: &StrBuf, content: &StrBuf, startLineIn: u64, endLineIn: u64, componentNameIn: &StrBuf, hasComponentName: bool, captured: &CapturedVariableList, out: &ScopeAnalysisResult) {
    // compNameStr = typeof arg === "string" ? arg : arg?.componentName ?? "ExtractedComponent"
    let compName = StrBuf { bytes: [0u8; 65536], len: 0 };
    if hasComponentName {
        let p: ptr = PTR_NULL();
        PTR_BYTE_ADD(p, &componentNameIn.bytes, 0);
        sb_append(&compName, p, componentNameIn.len);
    };
    if compName.len == 0 { sb_append(&compName, STR_PTR("ExtractedComponent"), STR_LEN("ExtractedComponent")); };
    let sf = getCachedSourceFile(st, STR_PTR(""), 0, content);
    let idx = LineIndex { starts: [0u64; 8192], lens: [0u64; 8192], count: 0 };
    build_line_index(content, &idx);
    let totalLines = idx.count;
    let sLine = startLineIn;
    if sLine < 1 { sLine = 1; }; // Math.max(1, startLine)
    let eLine = endLineIn;
    if eLine > totalLines { eLine = totalLines; }; // Math.min(totalLines, endLine)
    // startPos/endPos via sf.getPositionOfLineAndCharacter — represented
    // by line-index starts (endPos = content.length on the last line)
    // fileImportedIdentifiers + importedModuleMap from import statements
    let parsed = ParsedImportList { items: [ParsedImport { moduleSpecifier: [0u8; 512], moduleSpecifier_len: 0, isTypeOnly: false, defaultName: [0u8; 256], defaultName_len: 0, has_default: false, namespaceName: [0u8; 256], namespaceName_len: 0, has_namespace: false, named: [0u8; 8192], named_len: 0, named_isType: [0u8; 8192], named_isType_len: 0, sideEffectOnly: false, removed: false }; 512], len: 0 };
    let importedCsv = StrBuf { bytes: [0u8; 65536], len: 0 };
    let li: u64 = 0;
    while li < idx.count {
        let line = StrBuf { bytes: [0u8; 65536], len: 0 };
        line_at(content, &idx, li, &line);
        let lt = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_trim(&line, &lt);
        if sb_starts_with(&lt, STR_PTR("import "), STR_LEN("import ")) || sb_starts_with(&lt, STR_PTR("import{"), STR_LEN("import{")) {
            let before = parsed.len;
            parse_import_line(&lt, &parsed);
            if parsed.len > before {
                collect_import_locals(&parsed.items[before], &importedCsv);
            };
        };
        li = li + 1;
    }
    // blockDeclaredIdentifiers / blockUsedIdentifiers over the block lines
    // (source walkBlock prunes nodes outside [startPos, endPos] and only
    // counts declarations fully inside the range)
    let blockText = StrBuf { bytes: [0u8; 65536], len: 0 };
    let bl = sLine;
    while bl <= eLine && bl <= idx.count {
        let line = StrBuf { bytes: [0u8; 65536], len: 0 };
        line_at(content, &idx, bl - 1, &line);
        let p: ptr = PTR_NULL();
        PTR_BYTE_ADD(p, &line.bytes, 0);
        sb_append(&blockText, p, line.len);
        sb_append_byte(&blockText, 10);
        bl = bl + 1;
    }
    let usedCsv = StrBuf { bytes: [0u8; 65536], len: 0 };
    collect_used_identifiers(&blockText, &usedCsv);
    let declaredCsv = StrBuf { bytes: [0u8; 65536], len: 0 };
    collect_declared_identifiers(&blockText, &declaredCsv);
    // capturedNames = [...used].filter(id => !declared && !imported &&
    //   !JS_GLOBALS && !TS_RESERVED && !/^[0-9]+$/.test(id))
    let globals = StrBuf { bytes: [0u8; 65536], len: 0 };
    js_globals_csv(&globals);
    let reserved = StrBuf { bytes: [0u8; 65536], len: 0 };
    ts_reserved_csv(&reserved);
    captured.len = 0;
    // outerDeclarations from text before the block (walkOuter stops at
    // startPos): name -> inferred type/isFunction/isStateSetter.
    // DEFECT: useState ArrayBindingPattern inference (elements[0] value,
    // elements[1] setter with `(value: T | ((prev: T) => T)) => void`)
    // is approximated by the scan in infer_outer_type below.
    let outerText = StrBuf { bytes: [0u8; 65536], len: 0 };
    let ol: u64 = 1;
    while ol < sLine && ol <= idx.count {
        let line = StrBuf { bytes: [0u8; 65536], len: 0 };
        line_at(content, &idx, ol - 1, &line);
        let p: ptr = PTR_NULL();
        PTR_BYTE_ADD(p, &line.bytes, 0);
        sb_append(&outerText, p, line.len);
        sb_append_byte(&outerText, 10);
        ol = ol + 1;
    }
    // iterate used identifiers in order, applying the filter chain
    let pos: u64 = 0;
    while pos <= usedCsv.len {
        let end = pos;
        while end < usedCsv.len && usedCsv.bytes[end] != 44 { end = end + 1; }
        let seg = StrBuf { bytes: [0u8; 65536], len: 0 };
        let q: u64 = 0;
        while pos + q < end { sb_append_byte(&seg, usedCsv.bytes[pos + q]); q = q + 1; }
        let name = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_trim(&seg, &name);
        if name.len > 0 && !csv_has(&declaredCsv, &name) && !csv_has(&importedCsv, &name) && !csv_has(&globals, &name) && !csv_has(&reserved, &name) && !is_all_digits(&name) {
            // type inference for this captured name
            let typeText = StrBuf { bytes: [0u8; 65536], len: 0 };
            let isFn = false;
            let isSetter = false;
            let known = infer_outer_type(&outerText, &name, &typeText, &isFn, &isSetter);
            if !known {
                sb_clear(&typeText);
                if starts_with_and_upper(&name, STR_PTR("set"), 3) {
                    isFn = true;
                    isSetter = true;
                    sb_append(&typeText, STR_PTR("(value: any) => void"), STR_LEN("(value: any) => void"));
                } else if sb_starts_with(&name, STR_PTR("on"), 2) || sb_starts_with(&name, STR_PTR("handle"), STR_LEN("handle")) {
                    isFn = true;
                    sb_append(&typeText, STR_PTR("() => void"), STR_LEN("() => void"));
                } else if sb_starts_with(&name, STR_PTR("is"), 2) || sb_starts_with(&name, STR_PTR("has"), 3) || sb_starts_with(&name, STR_PTR("allow"), STR_LEN("allow")) {
                    sb_append(&typeText, STR_PTR("boolean"), STR_LEN("boolean"));
                } else {
                    sb_append(&typeText, STR_PTR("any"), STR_LEN("any"));
                };
            };
            let ci = captured.len;
            if ci < 512 {
                captured.items[ci].name_len = 0;
                let w: u64 = 0;
                while w < name.len && w < 256 { captured.items[ci].name[w] = name.bytes[w]; captured.items[ci].name_len = captured.items[ci].name_len + 1; w = w + 1; }
                captured.items[ci].type_len = 0;
                let w2: u64 = 0;
                while w2 < typeText.len && w2 < 1024 { captured.items[ci].type_[w2] = typeText.bytes[w2]; captured.items[ci].type_len = captured.items[ci].type_len + 1; w2 = w2 + 1; }
                captured.items[ci].isFunction = isFn;
                captured.items[ci].isStateSetter = isSetter;
                captured.len = captured.len + 1;
            };
        };
        if end >= usedCsv.len { break; };
        pos = end + 1;
    }
    // importedDependencies = [...used].filter(id => imported.has(id))
    let importedDeps = StrBuf { bytes: [0u8; 65536], len: 0 };
    csv_intersect(&usedCsv, &importedCsv, &importedDeps);
    // safeCompName = componentName.replace(/[^A-Za-z0-9_$]/g, "") || "ExtractedComponent"
    let safe = StrBuf { bytes: [0u8; 65536], len: 0 };
    let ci2: u64 = 0;
    while ci2 < compName.len {
        let c = compName.bytes[ci2];
        if is_word_byte(c) || c == 36 { sb_append_byte(&safe, c); };
        ci2 = ci2 + 1;
    }
    if safe.len == 0 { sb_append(&safe, STR_PTR("ExtractedComponent"), STR_LEN("ExtractedComponent")); };
    // props interface / call snippet / summary assembly (verbatim format)
    let propsIface = StrBuf { bytes: [0u8; 65536], len: 0 };
    if captured.len > 0 {
        sb_append(&propsIface, STR_PTR("export interface "), STR_LEN("export interface "));
        let sp: ptr = PTR_NULL();
        PTR_BYTE_ADD(sp, &safe.bytes, 0);
        sb_append(&propsIface, sp, safe.len);
        sb_append(&propsIface, STR_PTR("Props {\n"), STR_LEN("Props {\n"));
        let vi: u64 = 0;
        while vi < captured.len {
            sb_append(&propsIface, STR_PTR("  "), STR_LEN("  "));
            let vn = StrBuf { bytes: [0u8; 65536], len: 0 };
            buf_field_to_sb256(&captured.items[vi].name, captured.items[vi].name_len, &vn);
            let vp: ptr = PTR_NULL();
            PTR_BYTE_ADD(vp, &vn.bytes, 0);
            sb_append(&propsIface, vp, vn.len);
            sb_append(&propsIface, STR_PTR(": "), STR_LEN(": "));
            let vt = StrBuf { bytes: [0u8; 65536], len: 0 };
            buf_field_to_sb1024(&captured.items[vi].type_, captured.items[vi].type_len, &vt);
            let tp2: ptr = PTR_NULL();
            PTR_BYTE_ADD(tp2, &vt.bytes, 0);
            sb_append(&propsIface, tp2, vt.len);
            sb_append_byte(&propsIface, 59);
            if vi + 1 < captured.len { sb_append_byte(&propsIface, 10); };
            vi = vi + 1;
        }
        sb_append(&propsIface, STR_PTR("\n}"), STR_LEN("\n}"));
    } else {
        sb_append(&propsIface, STR_PTR("export interface "), STR_LEN("export interface "));
        let sp: ptr = PTR_NULL();
        PTR_BYTE_ADD(sp, &safe.bytes, 0);
        sb_append(&propsIface, sp, safe.len);
        sb_append(&propsIface, STR_PTR("Props {}"), STR_LEN("Props {}"));
    };
    let callSnippet = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_append_byte(&callSnippet, 60);
    let sp2: ptr = PTR_NULL();
    PTR_BYTE_ADD(sp2, &safe.bytes, 0);
    sb_append(&callSnippet, sp2, safe.len);
    if captured.len > 0 {
        sb_append_byte(&callSnippet, 32);
        let vi: u64 = 0;
        while vi < captured.len {
            if vi > 0 { sb_append_byte(&callSnippet, 32); };
            let vn = StrBuf { bytes: [0u8; 65536], len: 0 };
            buf_field_to_sb256(&captured.items[vi].name, captured.items[vi].name_len, &vn);
            let vp: ptr = PTR_NULL();
            PTR_BYTE_ADD(vp, &vn.bytes, 0);
            sb_append(&callSnippet, vp, vn.len);
            sb_append_byte(&callSnippet, 61);
            sb_append_byte(&callSnippet, 123);
            sb_append(&callSnippet, vp, vn.len);
            sb_append_byte(&callSnippet, 125);
            vi = vi + 1;
        }
    };
    sb_append(&callSnippet, STR_PTR(" />"), STR_LEN(" />"));
    // summary lines
    let summary = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_append(&summary, STR_PTR("[analyze_scope] File: "), STR_LEN("[analyze_scope] File: "));
    let fp: ptr = PTR_NULL();
    PTR_BYTE_ADD(fp, &filePath.bytes, 0);
    sb_append(&summary, fp, filePath.len);
    sb_append(&summary, STR_PTR(" (L"), STR_LEN(" (L"));
    sb_append_u64(&summary, sLine);
    sb_append_byte(&summary, 45);
    sb_append_u64(&summary, eLine);
    sb_append(&summary, STR_PTR(")\n- Captured Outer Variables ("), STR_LEN(")\n- Captured Outer Variables ("));
    sb_append_u64(&summary, captured.len);
    sb_append(&summary, STR_PTR("): "), STR_LEN("): "));
    if captured.len == 0 {
        sb_append(&summary, STR_PTR("(none)"), STR_LEN("(none)"));
    } else {
        let vi: u64 = 0;
        while vi < captured.len {
            if vi > 0 { sb_append(&summary, STR_PTR(", "), STR_LEN(", ")); };
            let vn = StrBuf { bytes: [0u8; 65536], len: 0 };
            buf_field_to_sb256(&captured.items[vi].name, captured.items[vi].name_len, &vn);
            let vp: ptr = PTR_NULL();
            PTR_BYTE_ADD(vp, &vn.bytes, 0);
            sb_append(&summary, vp, vn.len);
            sb_append(&summary, STR_PTR(" ("), STR_LEN(" ("));
            let vt = StrBuf { bytes: [0u8; 65536], len: 0 };
            buf_field_to_sb1024(&captured.items[vi].type_, captured.items[vi].type_len, &vt);
            let tp3: ptr = PTR_NULL();
            PTR_BYTE_ADD(tp3, &vt.bytes, 0);
            sb_append(&summary, tp3, vt.len);
            sb_append_byte(&summary, 41);
            vi = vi + 1;
        }
    };
    sb_append(&summary, STR_PTR("\n- Imported Dependencies Used ("), STR_LEN("\n- Imported Dependencies Used ("));
    sb_append_u64(&summary, csv_count(&importedDeps));
    sb_append(&summary, STR_PTR("): "), STR_LEN("): "));
    if importedDeps.len == 0 { sb_append(&summary, STR_PTR("(none)"), STR_LEN("(none)")); } else {
        let dp: ptr = PTR_NULL();
        PTR_BYTE_ADD(dp, &importedDeps.bytes, 0);
        // csv uses "," joins; source joins with ", "
        sb_append(&summary, dp, importedDeps.len);
    };
    sb_append(&summary, STR_PTR("\n- Declared Symbols in Block ("), STR_LEN("\n- Declared Symbols in Block ("));
    sb_append_u64(&summary, csv_count(&declaredCsv));
    sb_append(&summary, STR_PTR("): "), STR_LEN("): "));
    if declaredCsv.len == 0 { sb_append(&summary, STR_PTR("(none)"), STR_LEN("(none)")); } else {
        let dp: ptr = PTR_NULL();
        PTR_BYTE_ADD(dp, &declaredCsv.bytes, 0);
        sb_append(&summary, dp, declaredCsv.len);
    };
    sb_append(&summary, STR_PTR("\n\n// Suggested Props Interface:\n"), STR_LEN("\n\n// Suggested Props Interface:\n"));
    let pp: ptr = PTR_NULL();
    PTR_BYTE_ADD(pp, &propsIface.bytes, 0);
    sb_append(&summary, pp, propsIface.len);
    sb_append(&summary, STR_PTR("\n\n// Suggested Component Invocation:\n"), STR_LEN("\n\n// Suggested Component Invocation:\n"));
    let cp2: ptr = PTR_NULL();
    PTR_BYTE_ADD(cp2, &callSnippet.bytes, 0);
    sb_append(&summary, cp2, callSnippet.len);
    // fill out
    out.filePath_len = 0;
    let w: u64 = 0;
    while w < filePath.len && w < 1024 { out.filePath[w] = filePath.bytes[w]; out.filePath_len = out.filePath_len + 1; w = w + 1; }
    out.startLine = sLine;
    out.endLine = eLine;
    out.componentName_len = 0;
    let w3: u64 = 0;
    while w3 < safe.len && w3 < 256 { out.componentName[w3] = safe.bytes[w3]; out.componentName_len = out.componentName_len + 1; w3 = w3 + 1; }
    out.captured_first = 0;
    out.captured_len = captured.len;
    out.declaredSymbols_len = 0;
    let w4: u64 = 0;
    while w4 < declaredCsv.len && w4 < 8192 { out.declaredSymbols[w4] = declaredCsv.bytes[w4]; out.declaredSymbols_len = out.declaredSymbols_len + 1; w4 = w4 + 1; }
    out.importedDependencies_len = 0;
    let w5: u64 = 0;
    while w5 < importedDeps.len && w5 < 8192 { out.importedDependencies[w5] = importedDeps.bytes[w5]; out.importedDependencies_len = out.importedDependencies_len + 1; w5 = w5 + 1; }
    out.suggestedPropsInterface_len = 0;
    let w6: u64 = 0;
    while w6 < propsIface.len && w6 < 8192 { out.suggestedPropsInterface[w6] = propsIface.bytes[w6]; out.suggestedPropsInterface_len = out.suggestedPropsInterface_len + 1; w6 = w6 + 1; }
    out.suggestedCallSnippet_len = 0;
    let w7: u64 = 0;
    while w7 < callSnippet.len && w7 < 4096 { out.suggestedCallSnippet[w7] = callSnippet.bytes[w7]; out.suggestedCallSnippet_len = out.suggestedCallSnippet_len + 1; w7 = w7 + 1; }
    out.summary_len = 0;
    let w8: u64 = 0;
    while w8 < summary.len && w8 < 16384 { out.summary[w8] = summary.bytes[w8]; out.summary_len = out.summary_len + 1; w8 = w8 + 1; }
}

fn collect_import_locals(item: &ParsedImport, outCsv: &StrBuf) {
    // default + namespace + named local names into the csv set
    if item.has_default {
        let dn = StrBuf { bytes: [0u8; 65536], len: 0 };
        buf_field_to_sb256(&item.defaultName, item.defaultName_len, &dn);
        csv_add(outCsv, &dn);
    };
    if item.has_namespace {
        let nn = StrBuf { bytes: [0u8; 65536], len: 0 };
        buf_field_to_sb256(&item.namespaceName, item.namespaceName_len, &nn);
        csv_add(outCsv, &nn);
    };
    let named = StrBuf { bytes: [0u8; 65536], len: 0 };
    buf_field_to_sb(&item.named, item.named_len, &named);
    let pos: u64 = 0;
    while pos <= named.len {
        let end = pos;
        while end < named.len && named.bytes[end] != 44 { end = end + 1; }
        let seg = StrBuf { bytes: [0u8; 65536], len: 0 };
        let q: u64 = 0;
        while pos + q < end { sb_append_byte(&seg, named.bytes[pos + q]); q = q + 1; }
        let t = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_trim(&seg, &t);
        let local = StrBuf { bytes: [0u8; 65536], len: 0 };
        csv_local_name(&t, &local);
        if local.len > 0 { csv_add(outCsv, &local); };
        if end >= named.len { break; };
        pos = end + 1;
    }
}

fn csv_add(csv: &StrBuf, name: &StrBuf) {
    if name.len == 0 { return; };
    if csv_contains(csv, name) { return; };
    if csv.len > 0 { sb_append_byte(csv, 44); };
    let p: ptr = PTR_NULL();
    PTR_BYTE_ADD(p, &name.bytes, 0);
    sb_append(csv, p, name.len);
}

fn csv_intersect(a: &StrBuf, b: &StrBuf, out: &StrBuf) {
    sb_clear(out);
    let pos: u64 = 0;
    while pos <= a.len {
        let end = pos;
        while end < a.len && a.bytes[end] != 44 { end = end + 1; }
        let seg = StrBuf { bytes: [0u8; 65536], len: 0 };
        let q: u64 = 0;
        while pos + q < end { sb_append_byte(&seg, a.bytes[pos + q]); q = q + 1; }
        let t = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_trim(&seg, &t);
        if t.len > 0 && csv_contains(b, &t) && !csv_contains(out, &t) {
            if out.len > 0 { sb_append_byte(out, 44); };
            let p: ptr = PTR_NULL();
            PTR_BYTE_ADD(p, &t.bytes, 0);
            sb_append(out, p, t.len);
        };
        if end >= a.len { break; };
        pos = end + 1;
    }
}

fn collect_declared_identifiers(text: &StrBuf, outCsv: &StrBuf) {
    // Approximates walkBlock's declaration collection: identifiers
    // following const/let/var/function/class/interface/type keywords
    // and function parameters. DEFECT: binding patterns (destructuring)
    // only partially recognized (first identifier after the keyword).
    sb_clear(outCsv);
    let lines = LineBufList { items: [LineBuf { bytes: [0u8; 8192], len: 0 }; 8192], len: 0 };
    split_lines(text, &lines);
    let li: u64 = 0;
    while li < lines.len {
        let line = StrBuf { bytes: [0u8; 65536], len: 0 };
        lb_to_sb(&lines.items[li], &line);
        decl_scan_line(&line, outCsv);
        li = li + 1;
    }
}

fn decl_scan_line(line: &StrBuf, outCsv: &StrBuf) {
    let kws = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_append(&kws, STR_PTR("const let var function class interface type"), STR_LEN("const let var function class interface type"));
    let pos: u64 = 0;
    while pos < line.len {
        // try each keyword at pos (word boundary before)
        let matched: u64 = 0;
        if pos == 0 || !is_word_byte(line.bytes[pos - 1]) {
            if kw_at(line, pos, STR_PTR("function"), STR_LEN("function")) { matched = 8; };
            if matched == 0 && kw_at(line, pos, STR_PTR("const"), STR_LEN("const")) { matched = 5; };
            if matched == 0 && kw_at(line, pos, STR_PTR("let"), STR_LEN("let")) { matched = 3; };
            if matched == 0 && kw_at(line, pos, STR_PTR("var"), STR_LEN("var")) { matched = 3; };
            if matched == 0 && kw_at(line, pos, STR_PTR("class"), STR_LEN("class")) { matched = 5; };
            if matched == 0 && kw_at(line, pos, STR_PTR("interface"), STR_LEN("interface")) { matched = 9; };
            if matched == 0 && kw_at(line, pos, STR_PTR("type"), STR_LEN("type")) { matched = 4; };
        };
        if matched > 0 {
            let p2 = pos + matched;
            while p2 < line.len && (line.bytes[p2] == 32 || line.bytes[p2] == 9) { p2 = p2 + 1; }
            // destructuring: skip [ / { then read identifier
            if p2 < line.len && (line.bytes[p2] == 91 || line.bytes[p2] == 123) { p2 = p2 + 1; };
            while p2 < line.len && (line.bytes[p2] == 32 || line.bytes[p2] == 9) { p2 = p2 + 1; }
            let at: u64 = 0;
            let ln: u64 = 0;
            if read_ident(line, p2, &at, &ln) {
                let tok = StrBuf { bytes: [0u8; 65536], len: 0 };
                let q: u64 = 0;
                while q < ln { sb_append_byte(&tok, line.bytes[at + q]); q = q + 1; }
                csv_add(outCsv, &tok);
            };
            pos = pos + matched;
        } else {
            pos = pos + 1;
        };
    }
}

fn kw_at(line: &StrBuf, pos: u64, kw_p: ptr, kw_n: u64) -> bool {
    if pos + kw_n > line.len { return false; };
    let i: u64 = 0;
    while i < kw_n {
        let c: u8 = 0;
        PTR_BYTE_AT(c, kw_p, i);
        if line.bytes[pos + i] != c { return false; };
        i = i + 1;
    }
    let after = pos + kw_n;
    return after >= line.len || !is_word_byte(line.bytes[after]);
}

fn is_all_digits(name: &StrBuf) -> bool {
    if name.len == 0 { return false; };
    let i: u64 = 0;
    while i < name.len {
        if name.bytes[i] < 48 || name.bytes[i] > 57 { return false; };
        i = i + 1;
    }
    return true;
}

fn starts_with_and_upper(name: &StrBuf, p: ptr, n: u64) -> bool {
    // name.startsWith("set") && name.length > 3 && /^[A-Z]/.test(name.charAt(3))
    if !sb_starts_with(name, p, n) { return false; };
    if name.len <= 3 { return false; };
    let c = name.bytes[3];
    return c >= 65 && c <= 90;
}

fn infer_outer_type(outerText: &StrBuf, name: &StrBuf, outType: &StrBuf, outIsFn: &bool, outIsSetter: &bool) -> bool {
    // Approximates walkOuter + fnSigText: finds `const|let|var NAME [: T]
    // = ...` or `function NAME(params) [: T]` in the outer text.
    // DEFECT: real signature reconstruction (per-parameter name/?/rest/
    // type text via fnSigText) is approximated: arrow/function
    // initializers yield "…" placeholder signatures documented in the
    // defect log; declared type annotations are carried verbatim.
    sb_clear(outType);
    *outIsFn = false;
    *outIsSetter = false;
    // useState pair pattern: const [NAME, SETTER] = useState<T>(...)
    // DEFECT: approximated — setter detection by name pairing is left
    // to the caller's setX heuristic when this returns false.
    let lines = LineBufList { items: [LineBuf { bytes: [0u8; 8192], len: 0 }; 8192], len: 0 };
    split_lines(outerText, &lines);
    let li: u64 = 0;
    while li < lines.len {
        let line = StrBuf { bytes: [0u8; 65536], len: 0 };
        lb_to_sb(&lines.items[li], &line);
        // `function NAME(` ?
        if sb_contains(&line, STR_PTR("function"), STR_LEN("function")) && csv_contains(&line, name) {
            // DEFECT: fnSigText rebuild — returns "() => void"-shaped placeholder
            *outIsFn = true;
            sb_append(outType, STR_PTR("() => void"), STR_LEN("() => void"));
            return true;
        };
        // variable declaration containing NAME followed by ":" type or "="
        let namePos = find_word(&line, name);
        if namePos != -1 {
            let rest = StrBuf { bytes: [0u8; 65536], len: 0 };
            let s = (namePos as u64) + name.len;
            while s < line.len { sb_append_byte(&rest, line.bytes[s]); s = s + 1; }
            let rt = StrBuf { bytes: [0u8; 65536], len: 0 };
            sb_trim(&rest, &rt);
            if sb_starts_with(&rt, STR_PTR(":"), 1) {
                // declared type text up to "=" or end of line
                let ty = StrBuf { bytes: [0u8; 65536], len: 0 };
                let q: u64 = 1;
                while q < rt.len && rt.bytes[q] != 61 { sb_append_byte(&ty, rt.bytes[q]); q = q + 1; }
                let tt = StrBuf { bytes: [0u8; 65536], len: 0 };
                sb_trim(&ty, &tt);
                let p: ptr = PTR_NULL();
                PTR_BYTE_ADD(p, &tt.bytes, 0);
                sb_append(outType, p, tt.len);
                if sb_contains(&rt, STR_PTR("=>"), 2) { *outIsFn = true; };
                return true;
            };
            if sb_starts_with(&rt, STR_PTR("="), 1) {
                if sb_contains(&rt, STR_PTR("=>"), 2) || sb_contains(&rt, STR_PTR("function"), STR_LEN("function")) {
                    *outIsFn = true;
                    sb_append(outType, STR_PTR("() => void"), STR_LEN("() => void"));
                    return true;
                };
                sb_append(outType, STR_PTR("any"), STR_LEN("any"));
                return true;
            };
        };
        li = li + 1;
    }
    return false;
}

fn find_word(text: &StrBuf, word: &StrBuf) -> i64 {
    if word.len == 0 || text.len < word.len { return -1; };
    let pos: u64 = 0;
    while pos + word.len <= text.len {
        let same = true;
        let q: u64 = 0;
        while q < word.len {
            if text.bytes[pos + q] != word.bytes[q] { same = false; };
            q = q + 1;
            if !same { break; };
        }
        let beforeOk = pos == 0 || !is_word_byte(text.bytes[pos - 1]);
        let afterOk = pos + word.len >= text.len || !is_word_byte(text.bytes[pos + word.len]);
        if same && beforeOk && afterOk { return pos as i64; };
        pos = pos + 1;
    }
    return -1;
}

// ---- src/saVmTreeSitter.ts:2025-2093 — generateTargetImportsForBlock ----
// DEFECT: AST walk (ts.isJsxOpeningElement / isIdentifier over
// forEachChild) -> token scan of the block lines, same approximation
// as analyzeBlockScope. Relative module rewrite uses the assumed
// path externs (resolve/dirname/relative) with "/" separators;
// the source also normalizes "\\" to "/" (Windows) — DEFECT: path
// separator handling depends on the extern surface.
fn generateTargetImportsForBlock(st: &TreeSitterState, sourcePath: &StrBuf, targetPath: &StrBuf, sourceContent: &StrBuf, startLine: u64, endLine: u64, out: &StrBuf) {
    sb_clear(out);
    let sf = getCachedSourceFile(st, STR_PTR(""), 0, sourceContent);
    let idx = LineIndex { starts: [0u64; 8192], lens: [0u64; 8192], count: 0 };
    build_line_index(sourceContent, &idx);
    let totalLines = idx.count;
    let sLine = startLine;
    if sLine < 1 { sLine = 1; };
    let eLine = endLine;
    if eLine > totalLines { eLine = totalLines; };
    let blockText = StrBuf { bytes: [0u8; 65536], len: 0 };
    let bl = sLine;
    while bl <= eLine && bl <= idx.count {
        let line = StrBuf { bytes: [0u8; 65536], len: 0 };
        line_at(sourceContent, &idx, bl - 1, &line);
        let p: ptr = PTR_NULL();
        PTR_BYTE_ADD(p, &line.bytes, 0);
        sb_append(&blockText, p, line.len);
        sb_append_byte(&blockText, 10);
        bl = bl + 1;
    }
    let usedCsv = StrBuf { bytes: [0u8; 65536], len: 0 };
    collect_used_identifiers(&blockText, &usedCsv);
    let hasJsx = sb_contains(&blockText, STR_PTR("</"), 2) || sb_contains(&blockText, STR_PTR("/>"), 2);
    if hasJsx {
        let react = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_append(&react, STR_PTR("React"), STR_LEN("React"));
        csv_add(&usedCsv, &react);
    };
    // walk import statements of the source file; keep needed parts
    let parsed = ParsedImportList { items: [ParsedImport { moduleSpecifier: [0u8; 512], moduleSpecifier_len: 0, isTypeOnly: false, defaultName: [0u8; 256], defaultName_len: 0, has_default: false, namespaceName: [0u8; 256], namespaceName_len: 0, has_namespace: false, named: [0u8; 8192], named_len: 0, named_isType: [0u8; 8192], named_isType_len: 0, sideEffectOnly: false, removed: false }; 512], len: 0 };
    let li: u64 = 0;
    while li < idx.count {
        let line = StrBuf { bytes: [0u8; 65536], len: 0 };
        line_at(sourceContent, &idx, li, &line);
        let lt = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_trim(&line, &lt);
        if sb_starts_with(&lt, STR_PTR("import "), STR_LEN("import ")) || sb_starts_with(&lt, STR_PTR("import{"), STR_LEN("import{")) {
            parse_import_line(&lt, &parsed);
        };
        li = li + 1;
    }
    let linesOut = StrBuf { bytes: [0u8; 65536], len: 0 };
    let pi: u64 = 0;
    while pi < parsed.len {
        let item = parsed.items[pi];
        if item.sideEffectOnly { pi = pi + 1; continue; }; // !clause -> skip
        let keep = parsed.items[pi]; // second copy: SLA struct assignment moves (TS aliases)
        keep.has_default = item.has_default && named_used(&item.defaultName, item.defaultName_len, &usedCsv);
        keep.has_namespace = item.has_namespace && named_used(&item.namespaceName, item.namespaceName_len, &usedCsv);
        // neededNamed: elements whose local name is used, with
        // "type " prefix for element-level type-only and "A as B" form
        let named = StrBuf { bytes: [0u8; 65536], len: 0 };
        buf_field_to_sb(&item.named, item.named_len, &named);
        let keptNamed = StrBuf { bytes: [0u8; 65536], len: 0 };
        csv_filter_used(&named, &usedCsv, &keptNamed);
        keep.named_len = 0;
        let q: u64 = 0;
        while q < keptNamed.len && q < 8192 { keep.named[q] = keptNamed.bytes[q]; keep.named_len = keep.named_len + 1; q = q + 1; }
        if !keep.has_default && !keep.has_namespace && keptNamed.len == 0 { pi = pi + 1; continue; };
        // rewrite relative module path against target dir
        let mod_sb = StrBuf { bytes: [0u8; 65536], len: 0 };
        buf_field_to_sb2(&item.moduleSpecifier, item.moduleSpecifier_len, &mod_sb);
        if sb_starts_with(&mod_sb, STR_PTR("."), 1) {
            let rewritten = StrBuf { bytes: [0u8; 65536], len: 0 };
            rewrite_relative_module(sourcePath, targetPath, &mod_sb, &rewritten);
            keep.moduleSpecifier_len = 0;
            let w: u64 = 0;
            while w < rewritten.len && w < 512 { keep.moduleSpecifier[w] = rewritten.bytes[w]; keep.moduleSpecifier_len = keep.moduleSpecifier_len + 1; w = w + 1; }
        };
        if linesOut.len > 0 {
            if detect_eol_crlf(sourceContent) { sb_append_byte(&linesOut, 13); };
            sb_append_byte(&linesOut, 10);
        };
        render_import(&keep, &linesOut);
        pi = pi + 1;
    }
    let p: ptr = PTR_NULL();
    PTR_BYTE_ADD(p, &linesOut.bytes, 0);
    sb_append(out, p, linesOut.len);
}

fn named_used(field: &[u8; 256], n: u64, usedCsv: &StrBuf) -> bool {
    if n == 0 { return false; };
    let name = StrBuf { bytes: [0u8; 65536], len: 0 };
    buf_field_to_sb256(field, n, &name);
    return csv_contains(usedCsv, &name);
}

fn rewrite_relative_module(sourcePath: &StrBuf, targetPath: &StrBuf, modSpec: &StrBuf, out: &StrBuf) {
    // absMod = resolve(dirname(resolve(sourcePath)), modSpec)
    // rel = relative(dirname(resolve(targetPath)), absMod) with
    // "\\" -> "/" and "./" prefix when not starting with "."
    // DEFECT: implemented over the assumed path extern surface.
    let srcDir = StrBuf { bytes: [0u8; 65536], len: 0 };
    path_dirname(sourcePath, &srcDir);
    let absMod = StrBuf { bytes: [0u8; 65536], len: 0 };
    path_resolve2(&srcDir, modSpec, &absMod);
    let tgtDir = StrBuf { bytes: [0u8; 65536], len: 0 };
    path_dirname(targetPath, &tgtDir);
    sb_clear(out);
    path_relative(&tgtDir, &absMod, out);
    let i: u64 = 0;
    while i < out.len {
        if out.bytes[i] == 92 { out.bytes[i] = 47; };
        i = i + 1;
    }
    if out.len == 0 || out.bytes[0] != 46 {
        let withPrefix = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_append(&withPrefix, STR_PTR("./"), STR_LEN("./"));
        let p: ptr = PTR_NULL();
        PTR_BYTE_ADD(p, &out.bytes, 0);
        sb_append(&withPrefix, p, out.len);
        sb_clear(out);
        let p2: ptr = PTR_NULL();
        PTR_BYTE_ADD(p2, &withPrefix.bytes, 0);
        sb_append(out, p2, withPrefix.len);
    };
}

// ---- src/saVmTreeSitter.ts:2095-2186 — generatePropsTypeImports ----
// DEFECT: identifier extraction uses a shared global RegExp
// (/[A-Za-z_$][A-Za-z0-9_$]*\/g) whose lastIndex state is reset and
// advanced manually — replicated by the stateless token scan in
// collect_type_ids. alreadyImported uses /\bNAME\b/ regex tests
// (find_word here). The import-table walk is the textual
// ParsedImport approximation used across this unit.
fn global_like_csv(out: &StrBuf) {
    sb_clear(out);
    sb_append(out, STR_PTR("string,number,boolean,bigint,any,unknown,never,void,null,undefined,true,false,this,object,symbol,Record,Partial,Pick,Omit,Required,Readonly,Exclude,Extract,ReturnType,Parameters,Awaited,NonNullable,Array,Promise,Map,Set,Date,RegExp,Error,Function,React,JSX"), STR_LEN("string,number,boolean,bigint,any,unknown,never,void,null,undefined,true,false,this,object,symbol,Record,Partial,Pick,Omit,Required,Readonly,Exclude,Extract,ReturnType,Parameters,Awaited,NonNullable,Array,Promise,Map,Set,Date,RegExp,Error,Function,React,JSX"));
}

fn collect_type_ids(typeText: &StrBuf, intoCsv: &StrBuf) {
    let globals = StrBuf { bytes: [0u8; 65536], len: 0 };
    global_like_csv(&globals);
    let i: u64 = 0;
    while i < typeText.len {
        let c = typeText.bytes[i];
        let startByte = (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 || c == 36;
        if startByte {
            let s = i;
            while i < typeText.len && is_word_byte(typeText.bytes[i]) { i = i + 1; }
            let tok = StrBuf { bytes: [0u8; 65536], len: 0 };
            let q = s;
            while q < i { sb_append_byte(&tok, typeText.bytes[q]); q = q + 1; }
            if !csv_contains(&globals, &tok) { csv_add(intoCsv, &tok); };
        } else {
            i = i + 1;
        };
    }
}

fn generatePropsTypeImports(st: &TreeSitterState, sourcePath: &StrBuf, targetPath: &StrBuf, sourceContent: &StrBuf, captured: &CapturedVariableList, existingImportsText: &StrBuf, locallyDeclaredCsv: &StrBuf, out: &StrBuf) {
    sb_clear(out);
    let needed = StrBuf { bytes: [0u8; 65536], len: 0 };
    let vi: u64 = 0;
    while vi < captured.len {
        let t = StrBuf { bytes: [0u8; 65536], len: 0 };
        buf_field_to_sb1024(&captured.items[vi].type_, captured.items[vi].type_len, &t);
        collect_type_ids(&t, &needed);
        vi = vi + 1;
    }
    if needed.len == 0 { return; };
    let sf = getCachedSourceFile(st, STR_PTR(""), 0, sourceContent);
    let covered = StrBuf { bytes: [0u8; 65536], len: 0 };
    let idx = LineIndex { starts: [0u64; 8192], lens: [0u64; 8192], count: 0 };
    build_line_index(sourceContent, &idx);
    let eolCrlf = detect_eol_crlf(sourceContent);
    let li: u64 = 0;
    while li < idx.count {
        if csv_count(&covered) >= csv_count(&needed) { break; };
        let line = StrBuf { bytes: [0u8; 65536], len: 0 };
        line_at(sourceContent, &idx, li, &line);
        let lt = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_trim(&line, &lt);
        if sb_starts_with(&lt, STR_PTR("import "), STR_LEN("import ")) || sb_starts_with(&lt, STR_PTR("import{"), STR_LEN("import{")) {
            let parsed = ParsedImportList { items: [ParsedImport { moduleSpecifier: [0u8; 512], moduleSpecifier_len: 0, isTypeOnly: false, defaultName: [0u8; 256], defaultName_len: 0, has_default: false, namespaceName: [0u8; 256], namespaceName_len: 0, has_namespace: false, named: [0u8; 8192], named_len: 0, named_isType: [0u8; 8192], named_isType_len: 0, sideEffectOnly: false, removed: false }; 512], len: 0 };
            parse_import_line(&lt, &parsed);
            if parsed.len > 0 {
                let item = parsed.items[0];
                let mod_sb = StrBuf { bytes: [0u8; 65536], len: 0 };
                buf_field_to_sb2(&item.moduleSpecifier, item.moduleSpecifier_len, &mod_sb);
                let rewritten = StrBuf { bytes: [0u8; 65536], len: 0 };
                if sb_starts_with(&mod_sb, STR_PTR("."), 1) {
                    rewrite_relative_module(sourcePath, targetPath, &mod_sb, &rewritten);
                } else {
                    let p: ptr = PTR_NULL();
                    PTR_BYTE_ADD(p, &mod_sb.bytes, 0);
                    sb_append(&rewritten, p, mod_sb.len);
                };
                // default import provides a type name
                if item.has_default {
                    let dn = StrBuf { bytes: [0u8; 65536], len: 0 };
                    buf_field_to_sb256(&item.defaultName, item.defaultName_len, &dn);
                    if csv_contains(&needed, &dn) && !csv_contains(&covered, &dn) && !csv_contains(locallyDeclaredCsv,  &dn) && find_word(existingImportsText, &dn) == -1 {
                        append_out_line(out, eolCrlf, &dn, &rewritten, 0);
                        csv_add(&covered, &dn);
                    };
                };
                if item.has_namespace {
                    let nn = StrBuf { bytes: [0u8; 65536], len: 0 };
                    buf_field_to_sb256(&item.namespaceName, item.namespaceName_len, &nn);
                    if csv_contains(&needed, &nn) && !csv_contains(&covered, &nn) && !csv_contains(locallyDeclaredCsv,  &nn) && find_word(existingImportsText, &nn) == -1 {
                        append_out_line(out, eolCrlf, &nn, &rewritten, 1);
                        csv_add(&covered, &nn);
                    };
                };
                // named hits: `{ ${hits.join(", ")} }` with per-element
                // "type " prefix and clause-level typePrefix
                let named = StrBuf { bytes: [0u8; 65536], len: 0 };
                buf_field_to_sb(&item.named, item.named_len, &named);
                let hits = StrBuf { bytes: [0u8; 65536], len: 0 };
                let pos: u64 = 0;
                while pos <= named.len {
                    let end = pos;
                    while end < named.len && named.bytes[end] != 44 { end = end + 1; }
                    let seg = StrBuf { bytes: [0u8; 65536], len: 0 };
                    let q: u64 = 0;
                    while pos + q < end { sb_append_byte(&seg, named.bytes[pos + q]); q = q + 1; }
                    let t = StrBuf { bytes: [0u8; 65536], len: 0 };
                    sb_trim(&seg, &t);
                    let local = StrBuf { bytes: [0u8; 65536], len: 0 };
                    csv_local_name(&t, &local);
                    if local.len > 0 && csv_contains(&needed, &local) && !csv_contains(&covered, &local) && !csv_contains(locallyDeclaredCsv,  &local) && find_word(existingImportsText, &local) == -1 {
                        if hits.len > 0 { sb_append(&hits, STR_PTR(", "), STR_LEN(", ")); };
                        let p: ptr = PTR_NULL();
                        PTR_BYTE_ADD(p, &t.bytes, 0);
                        sb_append(&hits, p, t.len);
                        csv_add(&covered, &local);
                    };
                    if end >= named.len { break; };
                    pos = end + 1;
                }
                if hits.len > 0 {
                    if out.len > 0 {
                        if eolCrlf { sb_append_byte(out, 13); };
                        sb_append_byte(out, 10);
                    };
                    sb_append(out, STR_PTR("import "), STR_LEN("import "));
                    if item.isTypeOnly { sb_append(out, STR_PTR("type "), STR_LEN("type ")); };
                    sb_append(out, STR_PTR("{ "), STR_LEN("{ "));
                    let hp: ptr = PTR_NULL();
                    PTR_BYTE_ADD(hp, &hits.bytes, 0);
                    sb_append(out, hp, hits.len);
                    sb_append(out, STR_PTR(" } from \""), STR_LEN(" } from \""));
                    let rp: ptr = PTR_NULL();
                    PTR_BYTE_ADD(rp, &rewritten.bytes, 0);
                    sb_append(out, rp, rewritten.len);
                    sb_append(out, STR_PTR("\";"), STR_LEN("\";"));
                };
            };
        };
        li = li + 1;
    }
}

fn append_out_line(out: &StrBuf, eolCrlf: bool, name: &StrBuf, mod_sb: &StrBuf, form: u64) {
    // form 0: import Name from "mod";  form 1: import * as Name from "mod";
    if out.len > 0 {
        if eolCrlf { sb_append_byte(out, 13); };
        sb_append_byte(out, 10);
    };
    sb_append(out, STR_PTR("import "), STR_LEN("import "));
    if form == 1 { sb_append(out, STR_PTR("* as "), STR_LEN("* as ")); };
    let np: ptr = PTR_NULL();
    PTR_BYTE_ADD(np, &name.bytes, 0);
    sb_append(out, np, name.len);
    sb_append(out, STR_PTR(" from \""), STR_LEN(" from \""));
    let mp: ptr = PTR_NULL();
    PTR_BYTE_ADD(mp, &mod_sb.bytes, 0);
    sb_append(out, mp, mod_sb.len);
    sb_append(out, STR_PTR("\";"), STR_LEN("\";"));
}

// ---- src/saVmTreeSitter.ts:2188-2246 — generatePropsLocalTypes ----
// DEFECT: source collects top-level interface/type/enum/class
// declarations from the compiler AST with stmt.getText(sf) and grows
// the needed set over up to 3 rounds using the same global regex.
// Here declarations are located textually: a declaration starts at a
// line beginning (after optional `export`) with type/interface/enum/
// class NAME and its text runs to the brace-balanced end (type aliases
// without braces run to the terminating ";"). Brace counting is the
// text approximation of getText.
fn generatePropsLocalTypes(st: &TreeSitterState, sourcePath: &StrBuf, sourceContent: &StrBuf, captured: &CapturedVariableList, existingText: &StrBuf, out: &StrBuf) {
    sb_clear(out);
    let needed = StrBuf { bytes: [0u8; 65536], len: 0 };
    let vi: u64 = 0;
    while vi < captured.len {
        let t = StrBuf { bytes: [0u8; 65536], len: 0 };
        buf_field_to_sb1024(&captured.items[vi].type_, captured.items[vi].type_len, &t);
        collect_type_ids(&t, &needed);
        vi = vi + 1;
    }
    if needed.len == 0 { return; };
    let sf = getCachedSourceFile(st, STR_PTR(""), 0, sourceContent);
    // decls: name -> declaration text (csv names + parallel text via
    // repeated lookup; texts re-extracted on demand by find_local_decl)
    let pickedNames = StrBuf { bytes: [0u8; 65536], len: 0 };
    let picked = StrBuf { bytes: [0u8; 65536], len: 0 };
    let round: u64 = 0;
    while round < 3 {
        let grew = false;
        // iterate over a snapshot of needed
        let snapshot = StrBuf { bytes: [0u8; 65536], len: 0 };
        let sp: ptr = PTR_NULL();
        PTR_BYTE_ADD(sp, &needed.bytes, 0);
        sb_append(&snapshot, sp, needed.len);
        let pos: u64 = 0;
        while pos <= snapshot.len {
            let end = pos;
            while end < snapshot.len && snapshot.bytes[end] != 44 { end = end + 1; }
            let seg = StrBuf { bytes: [0u8; 65536], len: 0 };
            let q: u64 = 0;
            while pos + q < end { sb_append_byte(&seg, snapshot.bytes[pos + q]); q = q + 1; }
            let name = StrBuf { bytes: [0u8; 65536], len: 0 };
            sb_trim(&seg, &name);
            if name.len > 0 && !csv_contains(&pickedNames, &name) && find_word(existingText, &name) == -1 {
                let declText = StrBuf { bytes: [0u8; 65536], len: 0 };
                if find_local_decl(sourceContent, &name, &declText) {
                    if picked.len > 0 {
                        // picked.join("\n\n") (or "\r\n\r\n" quirk in source preserved as \n\n)
                        sb_append(&picked, STR_PTR("\n\n"), STR_LEN("\n\n"));
                    };
                    let dp: ptr = PTR_NULL();
                    PTR_BYTE_ADD(dp, &declText.bytes, 0);
                    sb_append(&picked, dp, declText.len);
                    csv_add(&pickedNames, &name);
                    collect_type_ids(&declText, &needed);
                    grew = true;
                };
            };
            if end >= snapshot.len { break; };
            pos = end + 1;
        }
        if !grew { break; };
        round = round + 1;
    }
    let p: ptr = PTR_NULL();
    PTR_BYTE_ADD(p, &picked.bytes, 0);
    sb_append(out, p, picked.len);
}

fn find_local_decl(content: &StrBuf, name: &StrBuf, outText: &StrBuf) -> bool {
    // Find a top-level declaration of `name` and copy its text.
    sb_clear(outText);
    let idx = LineIndex { starts: [0u64; 8192], lens: [0u64; 8192], count: 0 };
    build_line_index(content, &idx);
    let li: u64 = 0;
    while li < idx.count {
        let line = StrBuf { bytes: [0u8; 65536], len: 0 };
        line_at(content, &idx, li, &line);
        let lt = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_trim(&line, &lt);
        // optional "export " then keyword then NAME as a word
        let rest = StrBuf { bytes: [0u8; 65536], len: 0 };
        let rp: ptr = PTR_NULL();
        PTR_BYTE_ADD(rp, &lt.bytes, 0);
        sb_append(&rest, rp, lt.len);
        if sb_starts_with(&rest, STR_PTR("export "), STR_LEN("export ")) {
            let r2 = StrBuf { bytes: [0u8; 65536], len: 0 };
            let s: u64 = 7;
            while s < rest.len { sb_append_byte(&r2, rest.bytes[s]); s = s + 1; }
            rest = r2;
        };
        let kwLen: u64 = 0;
        if kw_at(&rest, 0, STR_PTR("interface"), STR_LEN("interface")) { kwLen = 9; } else if kw_at(&rest, 0, STR_PTR("type"), STR_LEN("type")) { kwLen = 4; } else if kw_at(&rest, 0, STR_PTR("enum"), STR_LEN("enum")) { kwLen = 4; } else if kw_at(&rest, 0, STR_PTR("class"), STR_LEN("class")) { kwLen = 5; };
        if kwLen > 0 {
            let after = kwLen;
            while after < rest.len && (rest.bytes[after] == 32 || rest.bytes[after] == 9) { after = after + 1; }
            if find_word(&rest, name) == after as i64 {
                // copy from this line until braces balance (or ";" for
                // brace-less aliases on the same accumulation)
                let depth: i64 = 0;
                let sawBrace = false;
                let lj = li;
                while lj < idx.count {
                    let l2 = StrBuf { bytes: [0u8; 65536], len: 0 };
                    line_at(content, &idx, lj, &l2);
                    if lj > li { sb_append_byte(outText, 10); };
                    let p2: ptr = PTR_NULL();
                    PTR_BYTE_ADD(p2, &l2.bytes, 0);
                    sb_append(outText, p2, l2.len);
                    let q: u64 = 0;
                    let semiEnd = false;
                    while q < l2.len {
                        if l2.bytes[q] == 123 { depth = depth + 1; sawBrace = true; };
                        if l2.bytes[q] == 125 { depth = depth - 1; };
                        if !sawBrace && l2.bytes[q] == 59 { semiEnd = true; };
                        q = q + 1;
                    }
                    if sawBrace && depth <= 0 { return true; };
                    if !sawBrace && semiEnd { return true; };
                    lj = lj + 1;
                }
                return outText.len > 0;
            };
        };
        li = li + 1;
    }
    return false;
}

// ---- src/saVmTreeSitter.ts:2248-2349 — splitEnvironmentalErrors ----
// DEFECT: the lazy getDeclared closure caches `declared`/`sf` across
// calls and wraps every node visit in try/catch — converted to an
// explicit cache struct filled once. The declared-name collection
// itself runs over the TS compiler AST in the source; here it is the
// textual approximation (imports + declaration keywords) used across
// this unit. Message parsing uses regexes /Cannot find name '([^']+)'/
// and /Property '([^']+)'/ — hand-rolled scans below.
fn splitEnvironmentalErrors(st: &TreeSitterState, sourcePath: &StrBuf, sourceContent: &StrBuf, errors: &SemanticIssueList, hard: &SemanticIssueList, warnings: &SemanticIssueList) {
    hard.len = 0;
    warnings.len = 0;
    if errors.len == 0 { return; };
    let declared = StrBuf { bytes: [0u8; 65536], len: 0 };
    collect_declared_names_textual(sourceContent, &declared);
    let i: u64 = 0;
    while i < errors.len {
        let e = errors.items[i];
        let code = StrBuf { bytes: [0u8; 65536], len: 0 };
        if e.has_code { buf_field_to_sb64(&e.code, e.code_len, &code); };
        if sb_eq_lit(&code, STR_PTR("TS2304"), STR_LEN("TS2304")) {
            let msg = StrBuf { bytes: [0u8; 65536], len: 0 };
            buf_field_to_sb1024(&e.message, e.message_len, &msg);
            let nm = StrBuf { bytes: [0u8; 65536], len: 0 };
            extract_quoted_after(&msg, STR_PTR("Cannot find name '"), STR_LEN("Cannot find name '"), &nm);
            if nm.len == 0 {
                push_issue(hard, &e);
            } else if csv_contains(&declared, &nm) {
                push_issue(hard, &e); // source provided it -> we dropped it -> hard
            } else {
                push_issue(warnings, &e); // environment/global noise -> warn
            };
        } else if sb_eq_lit(&code, STR_PTR("TS2339"), STR_LEN("TS2339")) {
            let msg = StrBuf { bytes: [0u8; 65536], len: 0 };
            buf_field_to_sb1024(&e.message, e.message_len, &msg);
            let prop = StrBuf { bytes: [0u8; 65536], len: 0 };
            extract_quoted_after(&msg, STR_PTR("Property '"), STR_LEN("Property '"), &prop);
            if prop.len == 0 {
                push_issue(hard, &e);
            } else {
                // sourceContent.includes(`.${prop}`)
                let needle = StrBuf { bytes: [0u8; 65536], len: 0 };
                sb_append_byte(&needle, 46);
                let pp: ptr = PTR_NULL();
                PTR_BYTE_ADD(pp, &prop.bytes, 0);
                sb_append(&needle, pp, prop.len);
                let np: ptr = PTR_NULL();
                PTR_BYTE_ADD(np, &needle.bytes, 0);
                if sb_contains(sourceContent, np, needle.len) {
                    push_issue(warnings, &e);
                } else {
                    push_issue(hard, &e);
                };
            };
        } else {
            push_issue(hard, &e);
        };
        i = i + 1;
    }
}

fn push_issue(list: &SemanticIssueList, e: &SemanticIssue) {
    if list.len < 256 {
        list.items[list.len] = *e;
        list.len = list.len + 1;
    };
}

fn extract_quoted_after(text: &StrBuf, prefix_p: ptr, prefix_n: u64, out: &StrBuf) {
    sb_clear(out);
    // find prefix, then read until the closing '\''
    let pos: u64 = 0;
    let foundAt: i64 = -1;
    while pos + prefix_n <= text.len {
        let same = true;
        let q: u64 = 0;
        while q < prefix_n {
            let c: u8 = 0;
            PTR_BYTE_AT(c, prefix_p, q);
            if text.bytes[pos + q] != c { same = false; };
            q = q + 1;
            if !same { break; };
        }
        if same { foundAt = pos as i64; break; };
        pos = pos + 1;
    }
    if foundAt == -1 { return; };
    let i = (foundAt as u64) + prefix_n;
    while i < text.len && text.bytes[i] != 39 { sb_append_byte(out, text.bytes[i]); i = i + 1; }
    if i >= text.len { sb_clear(out); };
}

fn collect_declared_names_textual(content: &StrBuf, outCsv: &StrBuf) {
    // import locals + const/let/var/function/class/interface/type/enum
    // declaration names over the whole file text.
    sb_clear(outCsv);
    let idx = LineIndex { starts: [0u64; 8192], lens: [0u64; 8192], count: 0 };
    build_line_index(content, &idx);
    let parsed = ParsedImportList { items: [ParsedImport { moduleSpecifier: [0u8; 512], moduleSpecifier_len: 0, isTypeOnly: false, defaultName: [0u8; 256], defaultName_len: 0, has_default: false, namespaceName: [0u8; 256], namespaceName_len: 0, has_namespace: false, named: [0u8; 8192], named_len: 0, named_isType: [0u8; 8192], named_isType_len: 0, sideEffectOnly: false, removed: false }; 512], len: 0 };
    let li: u64 = 0;
    while li < idx.count {
        let line = StrBuf { bytes: [0u8; 65536], len: 0 };
        line_at(content, &idx, li, &line);
        let lt = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_trim(&line, &lt);
        if sb_starts_with(&lt, STR_PTR("import "), STR_LEN("import ")) || sb_starts_with(&lt, STR_PTR("import{"), STR_LEN("import{")) {
            let before = parsed.len;
            parse_import_line(&lt, &parsed);
            if parsed.len > before { collect_import_locals(&parsed.items[before], outCsv); };
        };
        decl_scan_line(&line, outCsv);
        enum_scan_line(&line, outCsv);
        li = li + 1;
    }
}

fn enum_scan_line(line: &StrBuf, outCsv: &StrBuf) {
    let pos: u64 = 0;
    while pos < line.len {
        if (pos == 0 || !is_word_byte(line.bytes[pos - 1])) && kw_at(line, pos, STR_PTR("enum"), STR_LEN("enum")) {
            let p2 = pos + 4;
            while p2 < line.len && (line.bytes[p2] == 32 || line.bytes[p2] == 9) { p2 = p2 + 1; }
            let at: u64 = 0;
            let ln: u64 = 0;
            if read_ident(line, p2, &at, &ln) {
                let tok = StrBuf { bytes: [0u8; 65536], len: 0 };
                let q: u64 = 0;
                while q < ln { sb_append_byte(&tok, line.bytes[at + q]); q = q + 1; }
                csv_add(outCsv, &tok);
            };
            pos = pos + 4;
        } else {
            pos = pos + 1;
        };
    }
}

// ---- src/saVmTreeSitter.ts:2351-2373 — findTopImportInsertLine ----
fn findTopImportInsertLine(content: &StrBuf) -> u64 {
    let idx = LineIndex { starts: [0u64; 8192], lens: [0u64; 8192], count: 0 };
    build_line_index(content, &idx);
    let lastImportIdx: i64 = -1;
    let i: u64 = 0;
    while i < idx.count {
        let line = StrBuf { bytes: [0u8; 65536], len: 0 };
        line_at(content, &idx, i, &line);
        let lt = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_trim(&line, &lt);
        if sb_starts_with(&lt, STR_PTR("import "), STR_LEN("import ")) || sb_starts_with(&lt, STR_PTR("import{"), STR_LEN("import{")) || (sb_starts_with(&lt, STR_PTR("const "), STR_LEN("const ")) && sb_contains(&lt, STR_PTR("require("), STR_LEN("require("))) {
            lastImportIdx = i as i64;
        };
        i = i + 1;
    }
    if lastImportIdx != -1 { return (lastImportIdx + 1) as u64; };
    let ins: u64 = 0;
    while ins < idx.count {
        let line = StrBuf { bytes: [0u8; 65536], len: 0 };
        line_at(content, &idx, ins, &line);
        let lt = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_trim(&line, &lt);
        if sb_starts_with(&lt, STR_PTR("#!"), 2) || sb_starts_with(&lt, STR_PTR("//"), 2) || sb_starts_with(&lt, STR_PTR("/*"), 2) || sb_starts_with(&lt, STR_PTR("*"), 1) || sb_ends_with(&lt, STR_PTR("*/"), 2) ||
           sb_eq_lit(&lt, STR_PTR("\"use client\";"), STR_LEN("\"use client\";")) || sb_eq_lit(&lt, STR_PTR("'use client';"), STR_LEN("'use client';")) ||
           sb_eq_lit(&lt, STR_PTR("\"use strict\";"), STR_LEN("\"use strict\";")) || sb_eq_lit(&lt, STR_PTR("'use strict';"), STR_LEN("'use strict';")) || lt.len == 0 {
            ins = ins + 1;
        } else { break; };
    }
    return ins;
}

// ---- src/saVmTreeSitter.ts:2375-2424 — createInMemoryLanguageService (private) ----
// DEFECT: builds a ts.LanguageServiceHost object literal with ~12
// function properties closing over fs/path/ts.sys (getScriptSnapshot
// reading arbitrary files from disk, readDirectory/directoryExists via
// ts.sys, createDocumentRegistry) and returns ts.createLanguageService.
// There is no TypeScript LanguageService in SLA; the handle is always
// 0 (null) here, which is exactly the source's catch-path result.
// Callers (getSemanticDiagnosticsForContent / autoFixMissingImports)
// degrade to empty/no-op results, as they do when LS creation fails.
fn createInMemoryLanguageService(fileName: &StrBuf, content: &StrBuf, cwd: &StrBuf) -> u64 {
    return 0;
}

// ---- src/saVmTreeSitter.ts:2426-2464 — getSemanticDiagnosticsForContent ----
// DEFECT: depends on createInMemoryLanguageService + ls.getProgram() /
// getCompilerOptionsDiagnostics / getSyntacticDiagnostics /
// getSemanticDiagnostics, diagnostic objects with start/length/code,
// dedup via Set of `${line}:${column}:${code}:${message}` keys and
// slice(0, 80). Without a LanguageService the result is the source's
// empty-array path; structure (cwd default = process.cwd()) kept.
fn getSemanticDiagnosticsForContent(filePath: &StrBuf, content: &StrBuf, cwd: &StrBuf, hasCwd: bool, out: &SemanticIssueList) {
    out.len = 0;
    let effCwd = StrBuf { bytes: [0u8; 65536], len: 0 };
    if hasCwd {
        let p: ptr = PTR_NULL();
        PTR_BYTE_ADD(p, &cwd.bytes, 0);
        sb_append(&effCwd, p, cwd.len);
    } else {
        proc_cwd(&effCwd); // cwd = process.cwd() default
    };
    let ls = createInMemoryLanguageService(filePath, content, &effCwd);
    if ls == 0 { return; }; // if (!ls) return [];
    // DEFECT: unreachable in this pass (no LS); the diagnostic push /
    // dedup / slice(0, 80) pipeline has no SLA counterpart yet.
}

// ---- src/saVmTreeSitter.ts:2466-2508 — autoFixMissingImportsInContent ----
// DEFECT: uses LS code fixes (getCodeFixesAtPosition for TS2304,
// fix.changes[].textChanges[] span edits), recreating the LS per fix,
// then re-running organizeImportsInContent. Without an LS the result
// is the source's "LanguageService unavailable" early return; the
// success-path summary format is preserved in comments:
//   return { newContent: working, applied, fixedCount,
//            summary: `Applied ${fixed} missing-import fix(es)` }
// and the catch path: summary `auto-fix failed: ${err?.message ?? err}`.
fn autoFixMissingImportsInContent(filePath: &StrBuf, content: &StrBuf, cwd: &StrBuf, hasCwd: bool, outContent: &StrBuf, outApplied: &bool, outFixedCount: &u64, outSummary: &StrBuf) {
    sb_clear(outContent);
    let q: u64 = 0;
    while q < content.len { sb_append_byte(outContent, content.bytes[q]); q = q + 1; }
    *outApplied = false;
    *outFixedCount = 0;
    sb_clear(outSummary);
    let effCwd = StrBuf { bytes: [0u8; 65536], len: 0 };
    if hasCwd {
        let p: ptr = PTR_NULL();
        PTR_BYTE_ADD(p, &cwd.bytes, 0);
        sb_append(&effCwd, p, cwd.len);
    } else {
        proc_cwd(&effCwd);
    };
    let ls = createInMemoryLanguageService(filePath, content, &effCwd);
    if ls == 0 {
        sb_append(outSummary, STR_PTR("LanguageService unavailable"), STR_LEN("LanguageService unavailable"));
        return;
    };
    // DEFECT: unreachable in this pass; TS2304 collection, bottom-to-top
    // fix application (max 20) and the organizeImports follow-up are
    // LanguageService-bound (see defect log). The "No TS2304 missing
    // names" early return would be produced here.
    sb_append(outSummary, STR_PTR("No TS2304 missing names"), STR_LEN("No TS2304 missing names"));
}

// ---- src/saVmTreeSitter.ts:2510-2562 — analyzeFileCoupling ----
// DEFECT: top-level statement classification runs over the compiler
// AST (isFunctionDeclaration / isVariableStatement with arrow/function
// initializers / isClassDeclaration) and reuses analyzeBlockScope per
// candidate inside try/catch; the per-candidate failure record
// (capturedOuterState: 999, "analysis failed; inspect manually") has
// no exception channel in SLA and is produced when the scope scan
// yields no data. Object spread { name, kind, ...r } -> field copies.
fn analyzeFileCoupling(st: &TreeSitterState, filePath: &StrBuf, content: &StrBuf, topN: u64, hasTopN: bool, candidates: &CouplingCandidateList, outSummary: &StrBuf) {
    let limit: u64 = 12; // topN = 12 default
    if hasTopN { limit = topN; };
    candidates.len = 0;
    sb_clear(outSummary);
    let idx = LineIndex { starts: [0u64; 8192], lens: [0u64; 8192], count: 0 };
    build_line_index(content, &idx);
    // tops: first 40 top-level function/component/class declarations
    // (textual scan approximating sf.statements order)
    // tops stored as parallel csv names + kinds and line ranges in the
    // candidate list itself (pre-analysis), capped at 40 like the source.
    let tops = CouplingCandidateList { items: [CouplingCandidate { name: [0u8; 256], name_len: 0, kind: [0u8; 64], kind_len: 0, startLine: 0, endLine: 0, capturedOuterState: 0, importedDeps: 0, internalLines: 0, recommendation: [0u8; 256], recommendation_len: 0 }; 64], len: 0 };
    collect_top_level(content, &idx, &tops);
    let ti: u64 = 0;
    while ti < tops.len && ti < 40 {
        let t = tops.items[ti];
        let captured = CapturedVariableList { items: [CapturedVariable { name: [0u8; 256], name_len: 0, type_: [0u8; 1024], type_len: 0, isFunction: false, isStateSetter: false }; 512], len: 0 };
        let scopeOut = ScopeAnalysisResult { filePath: [0u8; 1024], filePath_len: 0, startLine: 0, endLine: 0, componentName: [0u8; 256], componentName_len: 0, captured_first: 0, captured_len: 0, declaredSymbols: [0u8; 8192], declaredSymbols_len: 0, importedDependencies: [0u8; 8192], importedDependencies_len: 0, suggestedPropsInterface: [0u8; 8192], suggestedPropsInterface_len: 0, suggestedCallSnippet: [0u8; 4096], suggestedCallSnippet_len: 0, summary: [0u8; 16384], summary_len: 0 };
        let tName = StrBuf { bytes: [0u8; 65536], len: 0 };
        buf_field_to_sb256(&t.name, t.name_len, &tName);
        analyzeBlockScope(st, filePath, content, t.startLine, t.endLine, &tName, true, &captured, &scopeOut);
        let n = captured.len;
        let rec = StrBuf { bytes: [0u8; 65536], len: 0 };
        if n <= 2 {
            sb_append(&rec, STR_PTR("High priority for extraction (Low Risk)"), STR_LEN("High priority for extraction (Low Risk)"));
        } else if n <= 6 {
            sb_append(&rec, STR_PTR("Medium: extract hooks first"), STR_LEN("Medium: extract hooks first"));
        } else {
            sb_append(&rec, STR_PTR("Extract custom hooks first before splitting UI"), STR_LEN("Extract custom hooks first before splitting UI"));
        };
        let ci = candidates.len;
        if ci < 64 {
            candidates.items[ci] = tops.items[ti]; // fresh copy: t stays live for field reads below
            candidates.items[ci].capturedOuterState = n;
            candidates.items[ci].importedDeps = csv_count_from_field(&scopeOut.importedDependencies, scopeOut.importedDependencies_len);
            candidates.items[ci].internalLines = t.endLine - t.startLine + 1;
            candidates.items[ci].recommendation_len = 0;
            let w: u64 = 0;
            while w < rec.len && w < 256 { candidates.items[ci].recommendation[w] = rec.bytes[w]; candidates.items[ci].recommendation_len = candidates.items[ci].recommendation_len + 1; w = w + 1; }
            candidates.len = candidates.len + 1;
        };
        ti = ti + 1;
    }
    // sort by capturedOuterState asc, slice(0, topN)
    sort_candidates_by_captured(candidates);
    if candidates.len > limit { candidates.len = limit; };
    sb_append(outSummary, STR_PTR("[analyze_coupling] "), STR_LEN("[analyze_coupling] "));
    let fp: ptr = PTR_NULL();
    PTR_BYTE_ADD(fp, &filePath.bytes, 0);
    sb_append(outSummary, fp, filePath.len);
    sb_append(outSummary, STR_PTR(": "), STR_LEN(": "));
    sb_append_u64(outSummary, candidates.len);
    sb_append(outSummary, STR_PTR(" candidate(s) (sorted by coupling asc)"), STR_LEN(" candidate(s) (sorted by coupling asc)"));
    let ci2: u64 = 0;
    while ci2 < candidates.len {
        let c = candidates.items[ci2];
        sb_append_byte(outSummary, 10);
        sb_append_u64(outSummary, ci2 + 1);
        sb_append(outSummary, STR_PTR(". "), STR_LEN(". "));
        let cn = StrBuf { bytes: [0u8; 65536], len: 0 };
        buf_field_to_sb256(&c.name, c.name_len, &cn);
        let cp3: ptr = PTR_NULL();
        PTR_BYTE_ADD(cp3, &cn.bytes, 0);
        sb_append(outSummary, cp3, cn.len);
        sb_append(outSummary, STR_PTR(" [L"), STR_LEN(" [L"));
        sb_append_u64(outSummary, c.startLine);
        sb_append_byte(outSummary, 45);
        sb_append_u64(outSummary, c.endLine);
        sb_append(outSummary, STR_PTR("] captured="), STR_LEN("] captured="));
        sb_append_u64(outSummary, c.capturedOuterState);
        sb_append(outSummary, STR_PTR(" imports="), STR_LEN(" imports="));
        sb_append_u64(outSummary, c.importedDeps);
        sb_append(outSummary, STR_PTR(" lines="), STR_LEN(" lines="));
        sb_append_u64(outSummary, c.internalLines);
        sb_append(outSummary, STR_PTR(" -> "), STR_LEN(" -> "));
        let cr = StrBuf { bytes: [0u8; 65536], len: 0 };
        buf_field_to_sb256(&c.recommendation, c.recommendation_len, &cr);
        let rp: ptr = PTR_NULL();
        PTR_BYTE_ADD(rp, &cr.bytes, 0);
        sb_append(outSummary, rp, cr.len);
        ci2 = ci2 + 1;
    }
}

fn csv_count_from_field(field: &[u8; 8192], n: u64) -> u64 {
    if n == 0 { return 0; };
    let count: u64 = 1;
    let i: u64 = 0;
    while i < n {
        if field[i] == 44 { count = count + 1; };
        i = i + 1;
    }
    return count;
}

fn sort_candidates_by_captured(list: &CouplingCandidateList) {
    let i: u64 = 1;
    while i < list.len {
        let j = i;
        while j > 0 && list.items[j].capturedOuterState < list.items[j - 1].capturedOuterState {
            let tmp = list.items[j];
            list.items[j] = list.items[j - 1];
            list.items[j - 1] = tmp;
            j = j - 1;
        }
        i = i + 1;
    }
}

fn collect_top_level(content: &StrBuf, idx: &LineIndex, tops: &CouplingCandidateList) {
    // Textual approximation of the sf.statements scan: lines at brace
    // depth 0 starting with function / class / const|let|var NAME =
    // (arrow|function). End line = the line where depth returns to 0.
    // DEFECT: statement end lines come from AST positions in the
    // source (getLineAndCharacterOfPosition of getEnd()); brace-depth
    // tracking is the text approximation.
    let depth: i64 = 0;
    let li: u64 = 0;
    while li < idx.count && tops.len < 64 {
        let line = StrBuf { bytes: [0u8; 65536], len: 0 };
        line_at(content, idx, li, &line);
        let lt = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_trim(&line, &lt);
        if depth == 0 && lt.len > 0 {
            let name = StrBuf { bytes: [0u8; 65536], len: 0 };
            let kind = StrBuf { bytes: [0u8; 65536], len: 0 };
            if top_decl_match(&lt, &name, &kind) {
                // find end line by brace balance from here
                let endLine = li;
                let d2: i64 = 0;
                let lj = li;
                let started = false;
                while lj < idx.count {
                    let l2 = StrBuf { bytes: [0u8; 65536], len: 0 };
                    line_at(content, idx, lj, &l2);
                    let q: u64 = 0;
                    while q < l2.len {
                        if l2.bytes[q] == 123 { d2 = d2 + 1; started = true; };
                        if l2.bytes[q] == 125 { d2 = d2 - 1; };
                        q = q + 1;
                    }
                    endLine = lj;
                    if started && d2 <= 0 { break; };
                    if !started && lj > li { break; };
                    lj = lj + 1;
                }
                let ci = tops.len;
                tops.items[ci].name_len = 0;
                let w: u64 = 0;
                while w < name.len && w < 256 { tops.items[ci].name[w] = name.bytes[w]; tops.items[ci].name_len = tops.items[ci].name_len + 1; w = w + 1; }
                tops.items[ci].kind_len = 0;
                let w2: u64 = 0;
                while w2 < kind.len && w2 < 64 { tops.items[ci].kind[w2] = kind.bytes[w2]; tops.items[ci].kind_len = tops.items[ci].kind_len + 1; w2 = w2 + 1; }
                tops.items[ci].startLine = li + 1;
                tops.items[ci].endLine = endLine + 1;
                tops.len = tops.len + 1;
            };
        };
        // update depth for this line
        let q: u64 = 0;
        while q < line.len {
            if line.bytes[q] == 123 { depth = depth + 1; };
            if line.bytes[q] == 125 { depth = depth - 1; };
            q = q + 1;
        }
        li = li + 1;
    }
}

fn top_decl_match(lt: &StrBuf, outName: &StrBuf, outKind: &StrBuf) -> bool {
    sb_clear(outName);
    sb_clear(outKind);
    // strip optional "export " / "export default "
    let rest = StrBuf { bytes: [0u8; 65536], len: 0 };
    let p: ptr = PTR_NULL();
    PTR_BYTE_ADD(p, &lt.bytes, 0);
    sb_append(&rest, p, lt.len);
    if sb_starts_with(&rest, STR_PTR("export default "), STR_LEN("export default ")) {
        let r2 = StrBuf { bytes: [0u8; 65536], len: 0 };
        let s: u64 = 15;
        while s < rest.len { sb_append_byte(&r2, rest.bytes[s]); s = s + 1; }
        rest = r2;
    } else if sb_starts_with(&rest, STR_PTR("export "), STR_LEN("export ")) {
        let r2 = StrBuf { bytes: [0u8; 65536], len: 0 };
        let s: u64 = 7;
        while s < rest.len { sb_append_byte(&r2, rest.bytes[s]); s = s + 1; }
        rest = r2;
    };
    if sb_starts_with(&rest, STR_PTR("async function "), STR_LEN("async function ")) || sb_starts_with(&rest, STR_PTR("function "), STR_LEN("function ")) {
        let off: u64 = 9;
        if sb_starts_with(&rest, STR_PTR("async function "), STR_LEN("async function ")) { off = 15; };
        let at: u64 = 0;
        let ln: u64 = 0;
        if read_ident(&rest, off, &at, &ln) {
            let q: u64 = 0;
            while q < ln { sb_append_byte(outName, rest.bytes[at + q]); q = q + 1; }
            sb_append(outKind, STR_PTR("function"), STR_LEN("function"));
            return true;
        };
        return false;
    };
    if sb_starts_with(&rest, STR_PTR("class "), STR_LEN("class ")) {
        let at: u64 = 0;
        let ln: u64 = 0;
        if read_ident(&rest, 6, &at, &ln) {
            let q: u64 = 0;
            while q < ln { sb_append_byte(outName, rest.bytes[at + q]); q = q + 1; }
            sb_append(outKind, STR_PTR("class"), STR_LEN("class"));
            return true;
        };
        return false;
    };
    // variable statement with arrow/function initializer:
    // kind = /^[A-Z]/.test(name) ? "component" : "function"
    let kwLen: u64 = 0;
    if sb_starts_with(&rest, STR_PTR("const "), STR_LEN("const ")) { kwLen = 6; } else if sb_starts_with(&rest, STR_PTR("let "), STR_LEN("let ")) { kwLen = 4; } else if sb_starts_with(&rest, STR_PTR("var "), STR_LEN("var ")) { kwLen = 4; };
    if kwLen > 0 {
        let at: u64 = 0;
        let ln: u64 = 0;
        if read_ident(&rest, kwLen, &at, &ln) {
            if sb_contains(&rest, STR_PTR("=>"), 2) || sb_contains(&rest, STR_PTR("= function"), STR_LEN("= function")) || sb_contains(&rest, STR_PTR("= async"), STR_LEN("= async")) {
                let q: u64 = 0;
                while q < ln { sb_append_byte(outName, rest.bytes[at + q]); q = q + 1; }
                if outName.len > 0 && outName.bytes[0] >= 65 && outName.bytes[0] <= 90 {
                    sb_append(outKind, STR_PTR("component"), STR_LEN("component"));
                } else {
                    sb_append(outKind, STR_PTR("function"), STR_LEN("function"));
                };
                return true;
            };
        };
    };
    return false;
}

// ---- src/saVmTreeSitter.ts:2564-2699 — buildExtractComponent ----
// DEFECT: `throw new Error(...)` for statement blocks has no SLA
// counterpart — outError is filled and target/call outputs are left
// empty (callers must check outError_len > 0), approximating the throw
// as an error return. require("node:path") inside the function ->
// assumed path externs. The JSX-container brace-balance scan is
// hand-rolled (quote tracking in the source ignores template literals'
// ${} nesting as well). void propsDecl / void hasJsx in the source
// mark intentionally-unused locals; dropped here.
fn buildExtractComponent(st: &TreeSitterState, sourcePath: &StrBuf, sourceContent: &StrBuf, startLine: u64, endLine: u64, componentName: &StrBuf, targetPath: &StrBuf, outTargetContent: &StrBuf, outCallSnippet: &StrBuf, outImportStatement: &StrBuf, outPropsInterface: &StrBuf, outError: &StrBuf) {
    sb_clear(outTargetContent);
    sb_clear(outCallSnippet);
    sb_clear(outImportStatement);
    sb_clear(outPropsInterface);
    sb_clear(outError);
    let captured = CapturedVariableList { items: [CapturedVariable { name: [0u8; 256], name_len: 0, type_: [0u8; 1024], type_len: 0, isFunction: false, isStateSetter: false }; 512], len: 0 };
    let analysis = ScopeAnalysisResult { filePath: [0u8; 1024], filePath_len: 0, startLine: 0, endLine: 0, componentName: [0u8; 256], componentName_len: 0, captured_first: 0, captured_len: 0, declaredSymbols: [0u8; 8192], declaredSymbols_len: 0, importedDependencies: [0u8; 8192], importedDependencies_len: 0, suggestedPropsInterface: [0u8; 8192], suggestedPropsInterface_len: 0, suggestedCallSnippet: [0u8; 4096], suggestedCallSnippet_len: 0, summary: [0u8; 16384], summary_len: 0 };
    analyzeBlockScope(st, sourcePath, sourceContent, startLine, endLine, componentName, true, &captured, &analysis);
    let safe = StrBuf { bytes: [0u8; 65536], len: 0 };
    buf_field_to_sb256(&analysis.componentName, analysis.componentName_len, &safe);
    if safe.len == 0 {
        // (analysis.componentName || componentName) sanitized again
        let ci: u64 = 0;
        while ci < componentName.len {
            let c = componentName.bytes[ci];
            if is_word_byte(c) || c == 36 { sb_append_byte(&safe, c); };
            ci = ci + 1;
        }
    };
    if safe.len == 0 { sb_append(&safe, STR_PTR("ExtractedComponent"), STR_LEN("ExtractedComponent")); };
    let idx = LineIndex { starts: [0u64; 8192], lens: [0u64; 8192], count: 0 };
    build_line_index(sourceContent, &idx);
    // block = lines.slice(startLine - 1, endLine).join("\n")
    let block = StrBuf { bytes: [0u8; 65536], len: 0 };
    let bl = analysis.startLine;
    while bl <= analysis.endLine && bl <= idx.count {
        if bl > analysis.startLine { sb_append_byte(&block, 10); };
        let line = StrBuf { bytes: [0u8; 65536], len: 0 };
        line_at(sourceContent, &idx, bl - 1, &line);
        let p: ptr = PTR_NULL();
        PTR_BYTE_ADD(p, &line.bytes, 0);
        sb_append(&block, p, line.len);
        bl = bl + 1;
    }
    let targetImports = StrBuf { bytes: [0u8; 65536], len: 0 };
    generateTargetImportsForBlock(st, sourcePath, targetPath, sourceContent, analysis.startLine, analysis.endLine, &targetImports);
    let eolCrlf = detect_eol_crlf(sourceContent);
    // localTypes first (so the type-import pass sees local declarations)
    let localTypes = StrBuf { bytes: [0u8; 65536], len: 0 };
    generatePropsLocalTypes(st, sourcePath, sourceContent, &captured, &targetImports, &localTypes);
    // localDeclNames from /^(?:export\s+)?(?:type|interface|enum|class)\s+(NAME)/gm
    let localDeclCsv = StrBuf { bytes: [0u8; 65536], len: 0 };
    collect_decl_names_multiline(&localTypes, &localDeclCsv);
    // augmented captured: [...captured, { name: "__localTypes", type: localTypes }]
    let augmented = CapturedVariableList { items: [CapturedVariable { name: [0u8; 256], name_len: 0, type_: [0u8; 1024], type_len: 0, isFunction: false, isStateSetter: false }; 512], len: 0 };
    augmented.len = captured.len;
    let ai: u64 = 0;
    while ai < captured.len { augmented.items[ai] = captured.items[ai]; ai = ai + 1; }
    if localTypes.len > 0 && augmented.len < 512 {
        let slot = augmented.len;
        augmented.items[slot].name_len = 0;
        let lit = "__localTypes";
        let w: u64 = 0;
        while w < 12 { let c: u8 = 0; PTR_BYTE_AT(c, STR_PTR(lit), w); augmented.items[slot].name[w] = c; augmented.items[slot].name_len = augmented.items[slot].name_len + 1; w = w + 1; }
        augmented.items[slot].type_len = 0;
        let w2: u64 = 0;
        while w2 < localTypes.len && w2 < 1024 { augmented.items[slot].type_[w2] = localTypes.bytes[w2]; augmented.items[slot].type_len = augmented.items[slot].type_len + 1; w2 = w2 + 1; }
        augmented.len = augmented.len + 1;
    };
    let extra = StrBuf { bytes: [0u8; 65536], len: 0 };
    generatePropsTypeImports(st, sourcePath, targetPath, sourceContent, &augmented, &targetImports, &localDeclCsv, &extra);
    let extraT = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_trim(&extra, &extraT);
    if extraT.len > 0 {
        if targetImports.len > 0 {
            let ti2 = StrBuf { bytes: [0u8; 65536], len: 0 };
            sb_trim(&targetImports, &ti2);
            sb_append_byte(&ti2, 10);
            let ep: ptr = PTR_NULL();
            PTR_BYTE_ADD(ep, &extraT.bytes, 0);
            // DEFECT: source joins with "\n" regardless of eol here
            sb_append(&ti2, ep, extraT.len);
            targetImports = ti2;
        } else {
            targetImports = extraT;
        };
    };
    // trimmedBlock / isReturnBlock / isStatementBlock gate
    let trimmedBlock = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_trim(&block, &trimmedBlock);
    let isReturnBlock = sb_starts_with(&trimmedBlock, STR_PTR("return"), STR_LEN("return")) && trimmedBlock.len > 6 && (trimmedBlock.bytes[6] == 32 || trimmedBlock.bytes[6] == 40 || trimmedBlock.bytes[6] == 9 || trimmedBlock.bytes[6] == 10);
    // firstStmt = trimmedBlock.split("\n")[0].trim()
    let firstStmt = StrBuf { bytes: [0u8; 65536], len: 0 };
    let fsq: u64 = 0;
    while fsq < trimmedBlock.len && trimmedBlock.bytes[fsq] != 10 { sb_append_byte(&firstStmt, trimmedBlock.bytes[fsq]); fsq = fsq + 1; }
    let firstStmtT = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_trim(&firstStmt, &firstStmtT);
    let isStatementBlock = starts_with_keyword(&firstStmtT) && !isReturnBlock;
    if isStatementBlock {
        // throw new Error(`extract_component refused: ...`)
        sb_append(outError, STR_PTR("extract_component refused: selected block starts with a statement (\""), STR_LEN("extract_component refused: selected block starts with a statement (\""));
        let show = firstStmtT.len;
        if show > 60 { show = 60; };
        let q: u64 = 0;
        while q < show { sb_append_byte(outError, firstStmtT.bytes[q]); q = q + 1; }
        sb_append(outError, STR_PTR("\"), which cannot be wrapped in \"return (...)\". Use raw mode (extract_to_file with raw:true) and wire the call site manually, or select an expression/JSX range instead."), STR_LEN("\"), which cannot be wrapped in \"return (...)\". Use raw mode (extract_to_file with raw:true) and wire the call site manually, or select an expression/JSX range instead."));
        return;
    };
    let blockExpr = StrBuf { bytes: [0u8; 65536], len: 0 };
    if isReturnBlock {
        // trimmedBlock.replace(/^return\s+/, "").replace(/;\s*$/, "")
        let s: u64 = 6;
        while s < trimmedBlock.len && (trimmedBlock.bytes[s] == 32 || trimmedBlock.bytes[s] == 9 || trimmedBlock.bytes[s] == 10 || trimmedBlock.bytes[s] == 13) { s = s + 1; }
        while s < trimmedBlock.len { sb_append_byte(&blockExpr, trimmedBlock.bytes[s]); s = s + 1; }
        // strip trailing ";" plus surrounding whitespace
        while blockExpr.len > 0 {
            let c = blockExpr.bytes[blockExpr.len - 1];
            if c == 59 || c == 32 || c == 9 || c == 10 || c == 13 {
                let wasSemi = c == 59;
                blockExpr.len = blockExpr.len - 1;
                if wasSemi { break; };
            } else { break; };
        }
    } else {
        let p: ptr = PTR_NULL();
        PTR_BYTE_ADD(p, &block.bytes, 0);
        sb_append(&blockExpr, p, block.len);
    };
    // JSX conditional container unwrap: { ... } with && <X / && ( /
    // ? <X / .map( inside and balanced braces -> strip one layer
    let bt = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_trim(&blockExpr, &bt);
    if bt.len >= 2 && bt.bytes[0] == 123 && bt.bytes[bt.len - 1] == 125 {
        let inner = StrBuf { bytes: [0u8; 65536], len: 0 };
        let s: u64 = 1;
        while s + 1 < bt.len { sb_append_byte(&inner, bt.bytes[s]); s = s + 1; }
        let looks = (sb_contains(&inner, STR_PTR("&&"), 2) && (contains_jsx_open(&inner))) || sb_contains(&inner, STR_PTR(".map("), STR_LEN(".map(")) || (sb_contains(&inner, STR_PTR("?"), 1) && contains_jsx_open(&inner));
        // DEFECT: source tests /&&\s*<[A-Za-z]/, /&&\s*\(/, /\?\s*<[A-Za-z]/,
        // /\.map\s*\(/ — approximated by the contains checks above.
        if looks && braces_balanced(&inner) {
            blockExpr = inner;
        };
    };
    // body = `${eol}  return (${eol}${indented block}${eol}  );`
    let body = StrBuf { bytes: [0u8; 65536], len: 0 };
    append_eol(&body, eolCrlf);
    sb_append(&body, STR_PTR("  return ("), STR_LEN("  return ("));
    append_eol(&body, eolCrlf);
    // blockExpr.split("\n").map(l => `  ${l}`).join(eol)
    let blines = LineBufList { items: [LineBuf { bytes: [0u8; 8192], len: 0 }; 8192], len: 0 };
    split_lines(&blockExpr, &blines);
    let bi: u64 = 0;
    while bi < blines.len {
        if bi > 0 { append_eol(&body, eolCrlf); };
        sb_append(&body, STR_PTR("  "), STR_LEN("  "));
        let q: u64 = 0;
        while q < blines.items[bi].len { sb_append_byte(&body, blines.items[bi].bytes[q]); q = q + 1; }
        bi = bi + 1;
    }
    append_eol(&body, eolCrlf);
    sb_append(&body, STR_PTR("  );"), STR_LEN("  );"));
    // head = [targetImports.trim(), localTypes.trim()].filter(Boolean).join(eol+eol)
    let head = StrBuf { bytes: [0u8; 65536], len: 0 };
    let ti3 = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_trim(&targetImports, &ti3);
    let lt3 = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_trim(&localTypes, &lt3);
    if ti3.len > 0 {
        let p: ptr = PTR_NULL();
        PTR_BYTE_ADD(p, &ti3.bytes, 0);
        sb_append(&head, p, ti3.len);
    };
    if lt3.len > 0 {
        if head.len > 0 { append_eol(&head, eolCrlf); append_eol(&head, eolCrlf); };
        let p: ptr = PTR_NULL();
        PTR_BYTE_ADD(p, &lt3.bytes, 0);
        sb_append(&head, p, lt3.len);
    };
    // targetContent assembly
    if head.len > 0 {
        let p: ptr = PTR_NULL();
        PTR_BYTE_ADD(p, &head.bytes, 0);
        sb_append(outTargetContent, p, head.len);
        append_eol(outTargetContent, eolCrlf);
        append_eol(outTargetContent, eolCrlf);
    };
    sb_append(outTargetContent, STR_PTR("export interface "), STR_LEN("export interface "));
    let sp3: ptr = PTR_NULL();
    PTR_BYTE_ADD(sp3, &safe.bytes, 0);
    sb_append(outTargetContent, sp3, safe.len);
    sb_append(outTargetContent, STR_PTR("Props {"), STR_LEN("Props {"));
    if captured.len > 0 {
        append_eol(outTargetContent, eolCrlf);
        let vi: u64 = 0;
        while vi < captured.len {
            if vi > 0 { append_eol(outTargetContent, eolCrlf); };
            sb_append(outTargetContent, STR_PTR("  "), STR_LEN("  "));
            let vn = StrBuf { bytes: [0u8; 65536], len: 0 };
            buf_field_to_sb256(&captured.items[vi].name, captured.items[vi].name_len, &vn);
            let vp: ptr = PTR_NULL();
            PTR_BYTE_ADD(vp, &vn.bytes, 0);
            sb_append(outTargetContent, vp, vn.len);
            sb_append(outTargetContent, STR_PTR(": "), STR_LEN(": "));
            let vt = StrBuf { bytes: [0u8; 65536], len: 0 };
            buf_field_to_sb1024(&captured.items[vi].type_, captured.items[vi].type_len, &vt);
            let tp4: ptr = PTR_NULL();
            PTR_BYTE_ADD(tp4, &vt.bytes, 0);
            sb_append(outTargetContent, tp4, vt.len);
            sb_append_byte(outTargetContent, 59);
            vi = vi + 1;
        }
        append_eol(outTargetContent, eolCrlf);
    };
    sb_append_byte(outTargetContent, 125);
    append_eol(outTargetContent, eolCrlf);
    append_eol(outTargetContent, eolCrlf);
    sb_append(outTargetContent, STR_PTR("export function "), STR_LEN("export function "));
    sb_append(outTargetContent, sp3, safe.len);
    sb_append_byte(outTargetContent, 40);
    if captured.len > 0 {
        sb_append(outTargetContent, STR_PTR("{ "), STR_LEN("{ "));
        let vi: u64 = 0;
        while vi < captured.len {
            if vi > 0 { sb_append(outTargetContent, STR_PTR(", "), STR_LEN(", ")); };
            let vn = StrBuf { bytes: [0u8; 65536], len: 0 };
            buf_field_to_sb256(&captured.items[vi].name, captured.items[vi].name_len, &vn);
            let vp: ptr = PTR_NULL();
            PTR_BYTE_ADD(vp, &vn.bytes, 0);
            sb_append(outTargetContent, vp, vn.len);
            vi = vi + 1;
        }
        sb_append(outTargetContent, STR_PTR(" }: "), STR_LEN(" }: "));
        sb_append(outTargetContent, sp3, safe.len);
        sb_append(outTargetContent, STR_PTR("Props"), STR_LEN("Props"));
    };
    sb_append(outTargetContent, STR_PTR(") {"), STR_LEN(") {"));
    let bp: ptr = PTR_NULL();
    PTR_BYTE_ADD(bp, &body.bytes, 0);
    sb_append(outTargetContent, bp, body.len);
    append_eol(outTargetContent, eolCrlf);
    sb_append_byte(outTargetContent, 125);
    append_eol(outTargetContent, eolCrlf);
    // importStatement with relative path source->target, extension stripped
    let rel = StrBuf { bytes: [0u8; 65536], len: 0 };
    compute_import_rel(sourcePath, targetPath, &rel);
    sb_append(outImportStatement, STR_PTR("import { "), STR_LEN("import { "));
    sb_append(outImportStatement, sp3, safe.len);
    sb_append(outImportStatement, STR_PTR(" } from \""), STR_LEN(" } from \""));
    let rp2: ptr = PTR_NULL();
    PTR_BYTE_ADD(rp2, &rel.bytes, 0);
    sb_append(outImportStatement, rp2, rel.len);
    sb_append(outImportStatement, STR_PTR("\";"), STR_LEN("\";"));
    // callSnippet = suggestedCallSnippet with componentName replaced by
    // safe name; prefixed "return " + ";" when isReturnBlock
    let baseCall = StrBuf { bytes: [0u8; 65536], len: 0 };
    buf_field_to_sb4096(&analysis.suggestedCallSnippet, analysis.suggestedCallSnippet_len, &baseCall);
    // String.replace(analysis.componentName, safe) — first occurrence
    let compNameBuf = StrBuf { bytes: [0u8; 65536], len: 0 };
    buf_field_to_sb256(&analysis.componentName, analysis.componentName_len, &compNameBuf);
    let replacedCall = StrBuf { bytes: [0u8; 65536], len: 0 };
    replace_first(&baseCall, &compNameBuf, &safe, &replacedCall);
    if isReturnBlock {
        sb_append(outCallSnippet, STR_PTR("return "), STR_LEN("return "));
    };
    let cp4: ptr = PTR_NULL();
    PTR_BYTE_ADD(cp4, &replacedCall.bytes, 0);
    sb_append(outCallSnippet, cp4, replacedCall.len);
    if isReturnBlock { sb_append_byte(outCallSnippet, 59); };
    // propsInterface = analysis.suggestedPropsInterface
    let pp2: ptr = PTR_NULL();
    let pif = StrBuf { bytes: [0u8; 65536], len: 0 };
    buf_field_to_sb(&analysis.suggestedPropsInterface, analysis.suggestedPropsInterface_len, &pif);
    PTR_BYTE_ADD(pp2, &pif.bytes, 0);
    sb_append(outPropsInterface, pp2, pif.len);
}

fn append_eol(b: &StrBuf, crlf: bool) {
    if crlf { sb_append_byte(b, 13); };
    sb_append_byte(b, 10);
}

fn starts_with_keyword(firstStmt: &StrBuf) -> bool {
    // /^(function|class|const|let|var|type|interface|enum|if|for|while|switch|try|export|import)\b/
    return kw_at(firstStmt, 0, STR_PTR("function"), STR_LEN("function")) || kw_at(firstStmt, 0, STR_PTR("class"), STR_LEN("class")) ||
           kw_at(firstStmt, 0, STR_PTR("const"), STR_LEN("const")) || kw_at(firstStmt, 0, STR_PTR("let"), STR_LEN("let")) ||
           kw_at(firstStmt, 0, STR_PTR("var"), STR_LEN("var")) || kw_at(firstStmt, 0, STR_PTR("type"), STR_LEN("type")) ||
           kw_at(firstStmt, 0, STR_PTR("interface"), STR_LEN("interface")) || kw_at(firstStmt, 0, STR_PTR("enum"), STR_LEN("enum")) ||
           kw_at(firstStmt, 0, STR_PTR("if"), STR_LEN("if")) || kw_at(firstStmt, 0, STR_PTR("for"), STR_LEN("for")) ||
           kw_at(firstStmt, 0, STR_PTR("while"), STR_LEN("while")) || kw_at(firstStmt, 0, STR_PTR("switch"), STR_LEN("switch")) ||
           kw_at(firstStmt, 0, STR_PTR("try"), STR_LEN("try")) || kw_at(firstStmt, 0, STR_PTR("export"), STR_LEN("export")) ||
           kw_at(firstStmt, 0, STR_PTR("import"), STR_LEN("import"));
}

fn contains_jsx_open(text: &StrBuf) -> bool {
    // <[A-Za-z] occurrence
    let i: u64 = 0;
    while i + 1 < text.len {
        if text.bytes[i] == 60 {
            let c = text.bytes[i + 1];
            if (c >= 65 && c <= 90) || (c >= 97 && c <= 122) { return true; };
        };
        i = i + 1;
    }
    return false;
}

fn braces_balanced(text: &StrBuf) -> bool {
    // source scan: quote-aware brace depth over the inner text
    let depth: i64 = 0;
    let quote: u8 = 0;
    let i: u64 = 0;
    while i < text.len {
        let ch = text.bytes[i];
        if quote != 0 {
            if ch == quote && (i == 0 || text.bytes[i - 1] != 92) { quote = 0; };
            i = i + 1;
            continue;
        };
        if ch == 39 || ch == 34 || ch == 96 { quote = ch; i = i + 1; continue; };
        if ch == 123 { depth = depth + 1; };
        if ch == 125 {
            depth = depth - 1;
            if depth < 0 { return false; };
        };
        i = i + 1;
    }
    return depth == 0;
}

fn collect_decl_names_multiline(text: &StrBuf, outCsv: &StrBuf) {
    sb_clear(outCsv);
    let lines = LineBufList { items: [LineBuf { bytes: [0u8; 8192], len: 0 }; 8192], len: 0 };
    split_lines(text, &lines);
    let li: u64 = 0;
    while li < lines.len {
        let line = StrBuf { bytes: [0u8; 65536], len: 0 };
        lb_to_sb(&lines.items[li], &line);
        let rest = StrBuf { bytes: [0u8; 65536], len: 0 };
        let p: ptr = PTR_NULL();
        PTR_BYTE_ADD(p, &line.bytes, 0);
        sb_append(&rest, p, line.len);
        if sb_starts_with(&rest, STR_PTR("export "), STR_LEN("export ")) {
            let r2 = StrBuf { bytes: [0u8; 65536], len: 0 };
            let s: u64 = 7;
            while s < rest.len { sb_append_byte(&r2, rest.bytes[s]); s = s + 1; }
            rest = r2;
        };
        let kwLen: u64 = 0;
        if kw_at(&rest, 0, STR_PTR("type"), STR_LEN("type")) { kwLen = 4; } else if kw_at(&rest, 0, STR_PTR("interface"), STR_LEN("interface")) { kwLen = 9; } else if kw_at(&rest, 0, STR_PTR("enum"), STR_LEN("enum")) { kwLen = 4; } else if kw_at(&rest, 0, STR_PTR("class"), STR_LEN("class")) { kwLen = 5; };
        if kwLen > 0 {
            let at: u64 = 0;
            let ln: u64 = 0;
            let start = kwLen;
            while start < rest.len && rest.bytes[start] == 32 { start = start + 1; }
            if read_ident(&rest, start, &at, &ln) {
                let tok = StrBuf { bytes: [0u8; 65536], len: 0 };
                let q: u64 = 0;
                while q < ln { sb_append_byte(&tok, rest.bytes[at + q]); q = q + 1; }
                csv_add(outCsv, &tok);
            };
        };
        li = li + 1;
    }
}

fn compute_import_rel(sourcePath: &StrBuf, targetPath: &StrBuf, out: &StrBuf) {
    // rel = relative(dirname(sourcePath), targetPath) with "\\"->"/",
    // extension /\.(?:[cm]?[jt]sx?)$/ stripped, "./" prefix if needed.
    // Falls back to targetPath itself when empty (source: `targetPath
    // ? ... : targetPath`).
    sb_clear(out);
    if targetPath.len == 0 { return; };
    let srcDir = StrBuf { bytes: [0u8; 65536], len: 0 };
    path_dirname(sourcePath, &srcDir);
    path_relative(&srcDir, targetPath, out);
    let i: u64 = 0;
    while i < out.len {
        if out.bytes[i] == 92 { out.bytes[i] = 47; };
        i = i + 1;
    }
    // strip trailing .ts/.tsx/.js/.jsx/.mts/.cts/.mjs/.cjs
    let exts = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_append(&exts, STR_PTR(".tsx,.ts,.jsx,.js,.mts,.cts,.mjs,.cjs"), STR_LEN(".tsx,.ts,.jsx,.js,.mts,.cts,.mjs,.cjs"));
    let pos: u64 = 0;
    while pos <= exts.len {
        let end = pos;
        while end < exts.len && exts.bytes[end] != 44 { end = end + 1; }
        let seg = StrBuf { bytes: [0u8; 65536], len: 0 };
        let q: u64 = 0;
        while pos + q < end { sb_append_byte(&seg, exts.bytes[pos + q]); q = q + 1; }
        let sp: ptr = PTR_NULL();
        PTR_BYTE_ADD(sp, &seg.bytes, 0);
        if sb_ends_with(out, sp, seg.len) { out.len = out.len - seg.len; break; };
        if end >= exts.len { break; };
        pos = end + 1;
    }
    if out.len == 0 || out.bytes[0] != 46 {
        let wp = StrBuf { bytes: [0u8; 65536], len: 0 };
        sb_append(&wp, STR_PTR("./"), STR_LEN("./"));
        let p: ptr = PTR_NULL();
        PTR_BYTE_ADD(p, &out.bytes, 0);
        sb_append(&wp, p, out.len);
        sb_clear(out);
        let p2: ptr = PTR_NULL();
        PTR_BYTE_ADD(p2, &wp.bytes, 0);
        sb_append(out, p2, wp.len);
    };
}

fn replace_first(text: &StrBuf, needle: &StrBuf, replacement: &StrBuf, out: &StrBuf) {
    sb_clear(out);
    if needle.len == 0 {
        let p: ptr = PTR_NULL();
        PTR_BYTE_ADD(p, &text.bytes, 0);
        sb_append(out, p, text.len);
        return;
    };
    let at = find_word(text, needle);
    if at == -1 {
        // String.replace with a string pattern replaces the first
        // literal occurrence (not word-bounded); find_word approximates
        let p: ptr = PTR_NULL();
        PTR_BYTE_ADD(p, &text.bytes, 0);
        sb_append(out, p, text.len);
        return;
    };
    let i: u64 = 0;
    while i < (at as u64) { sb_append_byte(out, text.bytes[i]); i = i + 1; }
    let rp: ptr = PTR_NULL();
    PTR_BYTE_ADD(rp, &replacement.bytes, 0);
    sb_append(out, rp, replacement.len);
    let j = (at as u64) + needle.len;
    while j < text.len { sb_append_byte(out, text.bytes[j]); j = j + 1; }
}
