// DEFECT: node:fs existsSync, node:module createRequire, node:path
// (dirname/extname/join/resolve/relative), node:url fileURLToPath,
// web-tree-sitter (Parser/Language/Node/Tree), typescript package —
// none exist in sa_std. Path/fs externs assumed as sa_std_fs_* style.
//
// Assumed extern surface (not in sa_std):
//   ts_parser_init(wasm_ptr: ptr, wasm_len: u64) -> bool
//   ts_parser_new() -> u64                                  // Parser handle, 0 = none
//   ts_parser_set_language(parser: u64, lang: u64) -> bool
//   ts_parser_parse(parser: u64, src_ptr: ptr, src_len: u64) -> u64  // Tree handle
//   ts_tree_root(tree: u64) -> u64                          // Node handle
//   ts_language_load(path_ptr: ptr, path_len: u64) -> u64   // Language handle
//   ts_node_type_ptr(n: u64) -> ptr;  ts_node_type_len(n: u64) -> u64
//   ts_node_child_count(n: u64) -> u64;  ts_node_child(n: u64, i: u64) -> u64
//   ts_node_named_child_count(n: u64) -> u64;  ts_node_named_child(n: u64, i: u64) -> u64
//   ts_node_child_by_field(n: u64, f_ptr: ptr, f_len: u64) -> u64
//   ts_node_parent(n: u64) -> u64
//   ts_node_text(n: u64, out: &StrBuf)
//   ts_node_start_row(n: u64) -> u64;  ts_node_end_row(n: u64) -> u64
//   ts_node_start_col(n: u64) -> u64
//   ts_node_start_index(n: u64) -> u64;  ts_node_end_index(n: u64) -> u64
//   ts_node_is_error(n: u64) -> bool;  ts_node_is_missing(n: u64) -> bool
//   ts_node_has_error(n: u64) -> bool;  ts_node_last_named_child(n: u64) -> u64
//   fs_exists(path_ptr: ptr, path_len: u64) -> bool
//   path_join2 / path_dirname / path_extname / path_resolve2 / path_relative
//     -> write result into &StrBuf (Windows separator handling lost: DEFECT)
//   proc_cwd(out: &StrBuf);  proc_resources_path(out: &StrBuf) -> bool

// ---- src/saVmTreeSitter.ts:13-27 — type OutlineSymbolKind (string union -> u64 tag) ----
// DEFECT: string union type has no SLA counterpart; u64 tag + name table.
const KIND_FUNCTION: u64 = 0;
const KIND_METHOD: u64 = 1;
const KIND_CLASS: u64 = 2;
const KIND_STRUCT: u64 = 3;
const KIND_INTERFACE: u64 = 4;
const KIND_ENUM: u64 = 5;
const KIND_VARIANT: u64 = 6;
const KIND_TRAIT: u64 = 7;
const KIND_IMPL: u64 = 8;
const KIND_TYPE: u64 = 9;
const KIND_MODULE: u64 = 10;
const KIND_CONSTANT: u64 = 11;
const KIND_VARIABLE: u64 = 12;

fn kind_name(kind: u64, out: &StrBuf) {
    // returns "function"|"method"|"class"|"struct"|"interface"|"enum"|
    // "variant"|"trait"|"impl"|"type"|"module"|"constant"|"variable"
    sb_clear(out);
    if kind == KIND_FUNCTION { sb_append(out, STR_PTR("function"), STR_LEN("function")); return; };
    if kind == KIND_METHOD { sb_append(out, STR_PTR("method"), STR_LEN("method")); return; };
    if kind == KIND_CLASS { sb_append(out, STR_PTR("class"), STR_LEN("class")); return; };
    if kind == KIND_STRUCT { sb_append(out, STR_PTR("struct"), STR_LEN("struct")); return; };
    if kind == KIND_INTERFACE { sb_append(out, STR_PTR("interface"), STR_LEN("interface")); return; };
    if kind == KIND_ENUM { sb_append(out, STR_PTR("enum"), STR_LEN("enum")); return; };
    if kind == KIND_VARIANT { sb_append(out, STR_PTR("variant"), STR_LEN("variant")); return; };
    if kind == KIND_TRAIT { sb_append(out, STR_PTR("trait"), STR_LEN("trait")); return; };
    if kind == KIND_IMPL { sb_append(out, STR_PTR("impl"), STR_LEN("impl")); return; };
    if kind == KIND_TYPE { sb_append(out, STR_PTR("type"), STR_LEN("type")); return; };
    if kind == KIND_MODULE { sb_append(out, STR_PTR("module"), STR_LEN("module")); return; };
    if kind == KIND_CONSTANT { sb_append(out, STR_PTR("constant"), STR_LEN("constant")); return; };
    sb_append(out, STR_PTR("variable"), STR_LEN("variable"));
}

// ---- shared text buffer (string approximation for this unit) ----
struct StrBuf {
    bytes: [u8; 65536], len: u64,
}

fn sb_clear(b: &StrBuf) { b.len = 0; }

fn sb_append(b: &StrBuf, p: ptr, n: u64) {
    let i: u64 = 0;
    while i < n {
        if b.len >= 65536 { break; };
        let c: u8 = 0;
        PTR_BYTE_AT(c, p, i);
        b.bytes[b.len] = c;
        b.len = b.len + 1;
        i = i + 1;
    }
}

fn sb_append_byte(b: &StrBuf, c: u8) {
    if b.len < 65536 { b.bytes[b.len] = c; b.len = b.len + 1; };
}

fn sb_append_u64(b: &StrBuf, v: u64) {
    // decimal rendering (TS template interpolation `${n}`)
    if v >= 10 { sb_append_u64(b, v / 10); };
    sb_append_byte(b, 48 + (v % 10) as u8);
}

fn sb_eq_lit(b: &StrBuf, p: ptr, n: u64) -> bool {
    if b.len != n { return false; };
    let i: u64 = 0;
    while i < n {
        let c: u8 = 0;
        PTR_BYTE_AT(c, p, i);
        if b.bytes[i] != c { return false; };
        i = i + 1;
    }
    return true;
}

fn sb_starts_with(b: &StrBuf, p: ptr, n: u64) -> bool {
    if b.len < n { return false; };
    let i: u64 = 0;
    while i < n {
        let c: u8 = 0;
        PTR_BYTE_AT(c, p, i);
        if b.bytes[i] != c { return false; };
        i = i + 1;
    }
    return true;
}

fn sb_contains(b: &StrBuf, p: ptr, n: u64) -> bool {
    if n == 0 { return true; };
    if b.len < n { return false; };
    let i: u64 = 0;
    while i + n <= b.len {
        let j: u64 = 0;
        let ok = true;
        while j < n {
            let c: u8 = 0;
            PTR_BYTE_AT(c, p, j);
            if b.bytes[i + j] != c { ok = false; };
            j = j + 1;
            if !ok { break; };
        }
        if ok { return true; };
        i = i + 1;
    }
    return false;
}

fn sb_trim(b: &StrBuf, out: &StrBuf) {
    let s: u64 = 0;
    let e: u64 = b.len;
    while s < e {
        let c = b.bytes[s];
        if c == 32 || c == 9 || c == 10 || c == 13 { s = s + 1; } else { break; };
    }
    while e > s {
        let c = b.bytes[e - 1];
        if c == 32 || c == 9 || c == 10 || c == 13 { e = e - 1; } else { break; };
    }
    sb_clear(out);
    let bp: ptr = PTR_NULL();
    PTR_BYTE_ADD(bp, &b.bytes, 0);
    sb_append(out, bp, 0); // placeholder no-op; slice copy below
    out.len = 0;
    let i: u64 = s;
    while i < e { sb_append_byte(out, b.bytes[i]); i = i + 1; }
}

// Line index over a content buffer: content.split(/\r?\n/) equivalent.
// DEFECT: regex split /\r?\n/ — hand-rolled scan; a trailing "\r" is
// stripped per line, lone-\r line endings are not split (same as source).
struct LineIndex {
    starts: [u64; 8192], lens: [u64; 8192], count: u64,
}

fn build_line_index(content: &StrBuf, out: &LineIndex) {
    out.count = 0;
    let start: u64 = 0;
    let i: u64 = 0;
    while i <= content.len {
        if i == content.len || content.bytes[i] == 10 {
            if out.count < 8192 {
                let ln = i - start;
                if ln > 0 && content.bytes[start + ln - 1] == 13 { ln = ln - 1; };
                out.starts[out.count] = start;
                out.lens[out.count] = ln;
                out.count = out.count + 1;
            };
            start = i + 1;
        };
        i = i + 1;
    }
}

fn line_at(content: &StrBuf, idx: &LineIndex, row: u64, out: &StrBuf) {
    sb_clear(out);
    if row >= idx.count { return; };
    let s = idx.starts[row];
    let n = idx.lens[row];
    let i: u64 = 0;
    while i < n { sb_append_byte(out, content.bytes[s + i]); i = i + 1; }
}

// ---- src/saVmTreeSitter.ts:29-36 — type OutlineSymbol ----
// DEFECT: recursive optional `children?: OutlineSymbol[]` and optional
// `signature?: string` cannot be expressed; children are indices into a
// shared OutlineSymbolList pool, signature is a fixed buffer + flag.
struct OutlineSymbol {
    name: [u8; 256], name_len: u64,
    kind: u64,                       // OutlineSymbolKind tag
    startLine: u64, endLine: u64,    // number
    signature: [u8; 512], signature_len: u64, has_signature: bool,
    children_first: u64, children_len: u64,  // range in the shared pool
}

struct OutlineSymbolList {
    items: [OutlineSymbol; 1024], len: u64,
}

fn sym_pool_push(pool: &OutlineSymbolList, name_p: ptr, name_n: u64, kind: u64, sl: u64, el: u64) -> u64 {
    let idx = pool.len;
    if idx >= 1024 { return idx; };
    pool.items[idx].name_len = 0;
    let i: u64 = 0;
    while i < name_n && i < 256 {
        let c: u8 = 0;
        PTR_BYTE_AT(c, name_p, i);
        pool.items[idx].name[i] = c;
        pool.items[idx].name_len = pool.items[idx].name_len + 1;
        i = i + 1;
    }
    pool.items[idx].kind = kind;
    pool.items[idx].startLine = sl;
    pool.items[idx].endLine = el;
    pool.items[idx].signature_len = 0;
    pool.items[idx].has_signature = false;
    pool.items[idx].children_first = 0;
    pool.items[idx].children_len = 0;
    pool.len = pool.len + 1;
    return idx;
}

fn sym_set_name_from_node(pool: &OutlineSymbolList, idx: u64, node: u64) {
    // node.text into the symbol name buffer
    let tmp = StrBuf { bytes: [0u8; 65536], len: 0 };
    ts_node_text(node, &tmp);
    pool.items[idx].name_len = 0;
    let i: u64 = 0;
    while i < tmp.len && i < 256 {
        pool.items[idx].name[i] = tmp.bytes[i];
        pool.items[idx].name_len = pool.items[idx].name_len + 1;
        i = i + 1;
    }
}

fn sym_name_or_anonymous(pool: &OutlineSymbolList, idx: u64, field_node: u64) {
    if field_node == 0 {
        // "(anonymous)"
        let lit = "(anonymous)";
        pool.items[idx].name_len = 0;
        let i: u64 = 0;
        while i < 11 {
            let c: u8 = 0;
            PTR_BYTE_AT(c, STR_PTR(lit), i);
            pool.items[idx].name[i] = c;
            pool.items[idx].name_len = pool.items[idx].name_len + 1;
            i = i + 1;
        }
        return;
    };
    sym_set_name_from_node(pool, idx, field_node);
}

