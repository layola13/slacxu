    //  5 empty model -> AGENTS_MODEL_EMPTY
    //  6 catalog null -> AGENTS_MODEL_CATALOG_MISSING; entries empty -> AGENTS_MODEL_CATALOG_EMPTY
    //     (entries = catalog.models filtered to objects; entryFor = find slug === name)
    //  7 model not in catalog -> AGENTS_MODEL_NOT_SYNCED; entry.multi_agent_version !== "v2" -> AGENTS_MODEL_NOT_V2_COMPATIBLE
    //  8 requested effort not in entry.supported_reasoning_levels[].effort -> AGENTS_REASONING_UNSUPPORTED
    //  9 concurrency: configured = v2.max_concurrent_threads_per_session ?? agents...;
    //     effective = childCount == null ? configured : (valid childCount ? childCount + 1 : childCount)
    //     invalid -> AGENTS_CONCURRENCY_INVALID (both branches); threadRunning -> AGENTS_THREAD_RUNNING
    // 10 enabledRoles (enabled !== false): count > childCount -> AGENTS_CONCURRENCY_EXCEEDED;
    //     per role: model fallback to chat model; not synced -> AGENTS_ROLE_MODEL_NOT_SYNCED;
    //     not v2 -> AGENTS_ROLE_MODEL_NOT_V2_COMPATIBLE
    // 11 no enabled roles -> warning AGENTS_READY (根 Agent 仍可直接调用 spawn_agent)
    // ready = issues empty; code = ready ? AGENTS_READY : issues[0].code ?? AGENTS_CONFIG_NOT_LOADED
