    enabled: bool, has_enabled: bool,
    name: [u8; 256], name_len: u64, has_name: bool,
    model: [u8; 512], model_len: u64, has_model: bool,
    reasoningEffort: [u8; 128], reasoningEffort_len: u64, has_reasoningEffort: bool,
}

struct AgentReadinessInput {
    agentMode: u8, has_agentMode: bool, // 0=inherit 1=enabled 2=disabled
    config: u64, has_config: bool, // unknown
    configError: [u8; 1024], configError_len: u64, has_configError: bool, // string | null
    appServerReady: bool, has_appServerReady: bool,
    model: [u8; 512], model_len: u64, has_model: bool,
    reasoningEffort: [u8; 128], reasoningEffort_len: u64, has_reasoningEffort: bool,
    childCount: i64, has_childCount: bool, // number | null
    roles: [AgentReadinessRole; 64], roles_len: u64,
    threadRunning: bool, has_threadRunning: bool,
    catalog: u64, has_catalog: bool, // unknown
}

struct AgentReadinessIssue {
    code: u8, // AgentReadinessCode tag
    message: [u8; 1024], message_len: u64,
    details: u64, has_details: bool, // Record<string, unknown>
}

