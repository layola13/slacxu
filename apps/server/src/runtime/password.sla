// Converted 1:1 from apps/server/src/runtime/password.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
// FIX (2026-10-27, stores batch): bodies retranslated from the TS truth.
// isBunRuntime is a compile-time false in the SLA build (sdk-backend
// runtimeDetect.sla: `const isBunRuntime: bool = false;`), so the TS
// bcryptjs branch is the landed path: bcrypt cost 10 over the sa_std
// surface (crypto.sai: sa_bcrypt_hash / sa_bcrypt_verify, $2b$ 60-char
// form via libxcrypt — four-source checked; the earlier header claim
// that no sa_std counterpart exists was stale and is removed).
// Handle convention (resolves the AB class-E gap): hashPassword's
// out_hash is a sa_json document handle of shape {"hash": "<60 chars>"}
// (FIX_SAVMTOOL path-addressed JSON norm); callers read the hash with
// sa_json_object_get_string(out_hash, "hash", ...) and own the handle.
// Blocking sync+status form: the TS functions are async over a
// synchronous native bcrypt call, so the await degenerates 1:1
// (ASYNC_MODEL contract-layer blocking form); status 0 = ok, any
// nonzero status is the std bcrypt status (8 = backing library absent).
@import "sa_std/io/print.sai"
@import "sa_std/crypto.sai"
@import "sa_std/encoding/json.sai"
@import "sa_std/string.sa"
// @import "./index.sla"  // isBunRuntime (compile-time false const in sdk-backend runtimeDetect.sla; no runtime branch in the SLA build)

struct PwHashBuf {
    bytes: [u8; 128],
}

// ---- runtime/password.ts:5-12 ----
fn hashPassword(password_ptr: ptr, password_len: u64, out_hash: &u64) -> i32 {
    // bcrypt.hash(password, 10) (bcryptjs branch; Bun branch unreachable
    // in the SLA build, see header).
    let buf = PwHashBuf { bytes: [0u8; 128] };
    let bp: ptr = PTR_NULL();
    PTR_BYTE_ADD(bp, &buf.bytes, 0);
    let hlen: u64 = 0;
    let st: i32 = sa_bcrypt_hash(password_ptr, password_len, 10, bp, 128, &hlen);
    if st != 0 {
        *out_hash = 0;
        return st;
    };
    let doc: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    if doc == 0 {
        *out_hash = 0;
        return 1;
    };
    let sst: i32 = sa_json_object_set_string(doc, STR_PTR("hash"), STR_LEN("hash"), bp, hlen);
    if sst != 0 {
        *out_hash = 0;
        return sst;
    };
    *out_hash = doc;
    return 0;
}

// ---- runtime/password.ts:14-19 ----
fn verifyPassword(password_ptr: ptr, password_len: u64, hash_ptr: ptr, hash_len: u64, out_ok: &bool) -> i32 {
    // bcrypt.compare(password, hash) (bcryptjs branch).
    let matched: u64 = 0;
    let st: i32 = sa_bcrypt_verify(password_ptr, password_len, hash_ptr, hash_len, &matched);
    if st != 0 {
        *out_ok = false;
        return st;
    };
    *out_ok = matched != 0;
    return 0;
}
