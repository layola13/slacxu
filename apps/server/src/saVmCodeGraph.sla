// 2 module, 3 function, 4 unknown). Optional file?/line? -> flags.
struct CodeGraphNode {
    id: [u8; 1024], id_len: u64,
    label: [u8; 1024], label_len: u64,
    kind: u64,
    file: [u8; 1024], file_len: u64, has_file: bool,
    line: u64, has_line: bool,
}

struct CodeGraphNodeList {
    items: [CodeGraphNode; 256], len: u64,
}

// ---- src/saVmCodeGraph.ts:21-26 — interface CodeGraphEdge ----
struct CodeGraphEdge {
    source: [u8; 1024], source_len: u64,
    target: [u8; 1024], target_len: u64,
    kind: u64,
    label: [u8; 256], label_len: u64, has_label: bool,
}

struct CodeGraphEdgeList {
    items: [CodeGraphEdge; 1024], len: u64,
}

// ---- src/saVmCodeGraph.ts:28-35 — interface ExtractedClassInfo ----
