struct ExtractedField {
    name: [u8; 256], name_len: u64,
    type_: [u8; 512], type_len: u64, has_type: bool,
}

struct ExtractedMethod {
    name: [u8; 256], name_len: u64,
    calls: [u8; 4096], calls_len: u64,   // string[] as ", "-joined
}

struct ExtractedClassInfo {
    name: [u8; 256], name_len: u64,
    bases: [u8; 2048], bases_len: u64,         // string[] joined
    interfaces: [u8; 2048], interfaces_len: u64,
    fields: [ExtractedField; 128], fields_len: u64,
    methods: [ExtractedMethod; 128], methods_len: u64,
    line: u64,
}

struct ExtractedClassList {
    items: [ExtractedClassInfo; 256], len: u64,
}

