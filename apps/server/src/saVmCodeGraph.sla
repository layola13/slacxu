// DEFECT: node:fs (existsSync/readdirSync/statSync via require),
// node:fs/promises (readFile/writeFile), node:path — no sa_std
// counterpart; assumed externs: fs_exists, fs_stat_is_file,
// fs_read_file(path, out &StrBuf) -> bool, fs_write_file(path, content) -> bool,
// fs_readdir(dir, out &StrBuf /* \n-joined names */, dirs &StrBuf) -> bool,
// path_dirname/path_extname/path_join2/path_resolve2/path_relative/is_absolute.

// ---- cross-unit types (referenced, owned by other units) ----
// DEFECT: SaVmPolicyConfig is a dynamic options object from
// @codex-ui/shared; NormalizedSaVmPolicy is the vmtool-security unit's
// normalized form. Both are opaque handles here.
struct SaVmPolicyConfig { handle: u64, has_value: bool }
struct NormalizedSaVmPolicy { handle: u64 }

// checkSaVmPath(policy, action "read"|"write", absPath, cwd) ->
// { allowed, reason? } from the vmtool-security unit.
fn checkSaVmPath(policy: &NormalizedSaVmPolicy, action_p: ptr, action_n: u64, absPath: &StrBuf, cwd: &StrBuf, reasonOut: &StrBuf) -> bool {
    // DEFECT: foreign-unit function — declared here as the assumed
    // extern signature; implementation lives in saVmPolicy.sla.
    return cg_policy_check_extern(policy.handle, action_p, action_n, absPath, cwd, reasonOut);
}

fn normalizeSaVmPolicy(policy: &SaVmPolicyConfig, cwd: &StrBuf, out: &NormalizedSaVmPolicy) {
    // DEFECT: foreign-unit function (saVmPolicy.sla).
    out.handle = cg_policy_normalize_extern(policy.handle, cwd);
}

// SaVmRunResult (saVmResultKind unit): events/violation are dynamic
// objects in TS; flattened here. DEFECT: dynamic object.
struct SaVmRunResult {
    ok: bool,
    kind: [u8; 64], kind_len: u64,               // "success" | "sa_error" | "capability_denied" | ...
    exitCode: i32,
    stdout: [u8; 65536], stdout_len: u64,
    stderr: [u8; 8192], stderr_len: u64,
    events_json: [u8; 8192], events_json_len: u64, // saVmEvents: Array<Record> as JSON text (DEFECT)
    violation_reason: [u8; 1024], violation_reason_len: u64, has_violation: bool, // saVmViolation | null
    durationMs: u64,
}

// ---- src/saVmCodeGraph.ts:11 — type CodeGraphEdgeKind (string union -> u64 tag) ----
const EDGE_EXTENDS: u64 = 0;
const EDGE_IMPLEMENTS: u64 = 1;
const EDGE_OWNS: u64 = 2;
const EDGE_IMPORTS: u64 = 3;
const EDGE_CALLS: u64 = 4;

fn edge_kind_name(kind: u64, out: &StrBuf) {
    sb_clear(out);
    if kind == EDGE_EXTENDS { sb_append(out, STR_PTR("extends"), STR_LEN("extends")); return; };
    if kind == EDGE_IMPLEMENTS { sb_append(out, STR_PTR("implements"), STR_LEN("implements")); return; };
    if kind == EDGE_OWNS { sb_append(out, STR_PTR("owns"), STR_LEN("owns")); return; };
    if kind == EDGE_IMPORTS { sb_append(out, STR_PTR("imports"), STR_LEN("imports")); return; };
    sb_append(out, STR_PTR("calls"), STR_LEN("calls"));
}

// ---- src/saVmCodeGraph.ts:13-19 — interface CodeGraphNode ----
