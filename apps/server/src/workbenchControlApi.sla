// Cross-module imports from @codex-ui/shared (源 L2): agentRuntimeThreadConfig, createDefaultSaVmPolicyConfig,
// parseAgentRuntimeOverride, permissionToTurnOverrides + types AgentRuntimeOverride / CliBackend / JsonValue /
// PermissionPresetId / SaVmPolicyConfig — kept as extern-style declarations at fix stage.
// DEFECT: dynamic object — JsonValue / Record<string, unknown> / SaVmPolicyConfig represented as JSON text buffers throughout.
// DEFECT: generic/dynamic policy field access (policy?.tools?.x, policy?.execution, policy?.http.allow, policy?.process.bunProfiles)
// has no typed counterpart; all policy reads go through JSON buffer key lookups.

// WORKBENCH_CONTROL_NOTIFICATION = "workbench/control/updated" (源 L4)
// WORKBENCH_LAYOUT_PRESETS (源 L5): "columns","rows","left-one-right-two","left-two-right-one","grid-2x2","grid-2x3" — preset tag 0..5 in this order.
// WorkbenchLayoutPreset = typeof WORKBENCH_LAYOUT_PRESETS[number] -> u64 tag.
fn workbenchLayoutPresetCount() -> u64 { return 6; }

struct JsonBuf {
    bytes: [u8; 131072], // capacity estimated: largest tool-spec JSON in source
    len: u64,
}

struct StrBuf {
    bytes: [u8; 65536], // capacity estimated: developer-instructions text
    len: u64,
}

// CliBackend string union -> (ptr,len) kept verbatim ("claude"|"agy"|"grok"|"pi"|"opencode"|"opencode-v2"|"muse"|"mini"|"auggie"|...).
// PermissionPresetId -> (ptr,len): "readonlyAsk"|"workspaceAsk"|"fullAsk"|"dangerBypass".
struct WorkbenchRuntime {
    threadId_ptr: ptr, threadId_len: u64,
    hasProviderId: bool, isProviderIdNull: bool, providerId_ptr: ptr, providerId_len: u64, // string | null
    hasGroupId: bool, isGroupIdNull: bool, groupId_ptr: ptr, groupId_len: u64,             // string | null
    model_ptr: ptr, model_len: u64,
    reasoningEffort_ptr: ptr, reasoningEffort_len: u64,
    permission_ptr: ptr, permission_len: u64, // PermissionPresetId
    agents_ptr: ptr, agents_len: u64,         // DEFECT: dynamic object AgentRuntimeOverride as JSON buffer
    cliBackend_ptr: ptr, cliBackend_len: u64, // CliBackend
    vmEnabled: bool,
    hasVmPolicy: bool, vmPolicy_ptr: ptr, vmPolicy_len: u64, // DEFECT: dynamic object SaVmPolicyConfig as JSON buffer
}

fn saVmDeveloperInstructions(policy_ptr: ptr, policy_len: u64, hasPolicy: bool, cwd_ptr: ptr, cwd_len: u64, skillPath_ptr: ptr, skillPath_len: u64, hasSkillPath: bool, backend_ptr: ptr, backend_len: u64, hasBackend: bool, out: &StrBuf) -> void {
    // 源 L21-L199: relSkill selected by cliBackend chain (claude->.claude, agy->.gemini, grok->.grok, pi->.pi,
    // opencode|opencode-v2->.opencode, muse->.muse, else .codex) joined under "skills/sa-vm/SKILL.md";
    // localSkill = threadSkillPath ?? join(cwd, relSkill); backslashes normalized to "/".
    // readGuide/patchGuide/execGuide each switch on policy.tools.replaceRead/replaceApplyPatch/replaceExec (exact source strings preserved in TS).
    // optionalGuides numbered from 14, appended in source order when policy gates pass:
    // findReferences(!==false), fileOutline(!==false), renameSymbol(===true), moveWithImports(===true), findDefinition(!==false),
    // extractToFile(===true), addImport(===true), getDiagnostics(===true), organizeImports(===true), analyzeScope(===true),
    // codeGraph(!==false, incl. IRON RULE text), execution.javascript, execution.python, http.allow non-empty, process.bunProfiles[0].
    // Backend banners: agyGuide (agy|grok), opencodeGuide (opencode|opencode-v2), claudeGuide (claude) — exact banner texts in source.
    // Final template: banners + "Packaged function tools are active..." + exec/read/patch guides + numbered action list 1..14 (源 L173-L198 verbatim) + optionalGuideBlock.
    // DEFECT: template literal multi-part string interpolation approximated as sequential buffer appends at fix stage.
    // DEFECT: closure — template-literal `${nextIdx++}` counter mutation inside push calls approximated with explicit counter variable.
    // DEFECT: path join (node:path) platform separators approximated; source normalizes "\\" -> "/" after join.
    out.len = 0;
}

fn saVmDynamicToolSpec(policy_ptr: ptr, policy_len: u64, hasPolicy: bool, out: &JsonBuf) -> void {
    // 源 L201-L395: gate booleans from policy (allowJs/allowPy execution, allowHttp = policy undefined ? true : http.allow non-empty,
    // ~30 tools.* gates with ===true / !==false polarities exactly as source) -> actions[] built in source order:
    // base 28 actions (apply_patch, edit_file, write_file, read_file, read_lines, read_many, read_file_tail, count_lines,
    // find_files, list_dir, grep_search, grep_search_async, delete_file, safe_delete, move_file, copy_file, file_info, stat,
    // test_path, file_exists, exists, vm-read, vm_read, ensure_dir, mkdir, git_status, git_diff, git_log)
    // + gated pushes in source order (clear_tool_history; find_references+find_implementations; file_outline+workspace_outline+repo_map;
    // rename_symbol; move_file_with_imports; find_definition; extract family x9; add_import; diagnostics family x6;
    // auto_fix_missing_imports; organize_imports; analyze_scope+analyze_coupling; code_graph family x3; jev_* x17 individually gated;
    // run_js; run_py; http_fetch; run_project_check if bunProfiles; run_bun if process.bun enabled) + unconditional run_host last.
    // Returns JsonValue {type:"function", name:"sa_vm_run", description: actions joined, inputSchema:{...}} —
    // inputSchema properties (~90 entries: action enum + per-action params with exact source descriptions) preserved as JSON template at fix stage.
    // DEFECT: dynamic object literal with computed enum array — whole spec emitted as JSON text; per-property descriptions not re-typed.
    // DEFECT: `(policy.process.bun as any).enabled` type cast (any) has no counterpart; JSON key lookup approximated.
    out.len = 0;
}

