// Converted 1:1 from apps/server/src/cliSelectionState.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
// Shared in-memory state for CLI binary selection. Dependency-free so both
// codexCommand.ts (resolution) and cliVersions.ts (enumeration) can import it without cycles.
@import "sa_std/io/print.sai"

// CliSelectionKind = "codex"|"claude"|"agy"|"auggie"|"cline"|"command-code"|"grok"|"pi"|"opencode"|"opencode-v2"|"muse"
// -> u8 tag: 0=codex 1=claude 2=agy 3=auggie 4=cline 5=command-code 6=grok 7=pi 8=opencode 9=opencode-v2 10=muse.
struct CliInstallationEntry {
    path: [u8; 1024], path_len: u64,
    version: [u8; 128], version_len: u64, has_version: bool,
    source: [u8; 256], source_len: u64,
}

struct CliLatestCache {
    installations: [CliInstallationEntry; 64], installations_len: u64,
    latestPath: [u8; 1024], latestPath_len: u64, has_latestPath: bool, // string | undefined
    refreshedAt: u64,
}

// REFRESH_TTL_MS = 5 * 60 * 1000
