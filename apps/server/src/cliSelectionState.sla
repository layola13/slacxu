    preferredPaths: [u8; 1024], // placeholder layout note: per-kind (ptr,len)+flag arrays in fix pass
    has_preferred: [bool; 11],
    caches: [CliLatestCache; 11], has_cache: [bool; 11],
    inflight: [u64; 11], // Promise<void> handles — DEFECT: Promise
}

