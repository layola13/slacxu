fn normalizeAsyncImageTask(body_ptr: ptr, body_len: u64, out_ptr: ptr) -> u64 {
    let body: u64 = ip_parse(body_ptr, body_len);
    let data_arr: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    if body != 0 { ip_extract_into(body, data_arr, 0); };
    // ...extractUrlValue(stringValue(record.url))
    let up: ptr = PTR_NULL();
    let ul: u64 = 0;
    if ip_field_str(body, STR_PTR("url"), STR_LEN("url"), &up, &ul) {
        ip_extract_url_into(up, ul, data_arr);
    };
    let uniq: u64 = ip_unique_data(data_arr);
    let f1: i32 = sa_json_free(data_arr);
    // raw = {submitted: ctx.submitted, completed: body}
    let raw: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    let ctx: u64 = ip_ctx_get();
    let submitted: u64 = ip_jget(ctx, STR_PTR("submitted"), STR_LEN("submitted"));
    if submitted != 0 {
        let stext = IpText { bytes: [0u8; 262144], len: 0 };
        ip_doc_text(submitted, &stext);
        let sclone: u64 = ip_parse(ip_text_ptr(&stext), stext.len);
        if sclone != 0 {
            let ss: i32 = sa_json_object_set_node(raw, STR_PTR("submitted"), STR_LEN("submitted"), sclone);
        };
    };
    if body != 0 {
        let btext = IpText { bytes: [0u8; 262144], len: 0 };
        ip_doc_text(body, &btext);
        let bclone: u64 = ip_parse(ip_text_ptr(&btext), btext.len);
        if bclone != 0 {
            let bs: i32 = sa_json_object_set_node(raw, STR_PTR("completed"), STR_LEN("completed"), bclone);
        };
    };
    let created: f64 = 0.0;
    let has_created: bool = ip_field_num(body, STR_PTR("created_at"), STR_LEN("created_at"), &created);
    if !has_created { has_created = ip_field_num(body, STR_PTR("created"), STR_LEN("created"), &created); };
    let doc: u64 = ip_normalized_result(raw, uniq, created, has_created);
    if uniq != 0 { let f2: i32 = sa_json_free(uniq); };
    if raw != 0 { let f3: i32 = sa_json_free(raw); };
    if body != 0 { let f4: i32 = sa_json_free(body); };
    if doc == 0 { PTR_COPY_BYTES(out_ptr, STR_PTR("{}"), 2); return 2; };
    let n: u64 = ip_write_out(doc, out_ptr);
    let f5: i32 = sa_json_free(doc);
    return n;
}

fn hydrateNormalizedImageResult(body_ptr: ptr, body_len: u64, out_ptr: ptr) -> u64 {
    // TS: async identity
    PTR_COPY_BYTES(out_ptr, body_ptr, body_len);
    return body_len;
}

// ---- HTTP (v2 client; TS fetch here carries no explicit timeout —
// only the caller's AbortSignal, landed as the input.aborted flag
// checked between poll slices) ----
fn ip_http(method_tag: u64, url_p: ptr, url_l: u64, headers_text: &IpText, body_p: ptr, body_l: u64, has_body: bool, out_status: &i64, out_body: &IpText, out_failed: &bool) -> void {
    *out_status = 0;
    out_body.len = 0;
    *out_failed = false;
    let use_tls: u8 = 0;
    if ip_starts_ci(url_p, url_l, STR_PTR("https:"), STR_LEN("https:")) { use_tls = 1; };
    let client: ptr = PTR_NULL();
    let cst: u32 = sa_http_client_new_v2(use_tls, PTR_NULL(), 0, &client);
    if cst != 0 || client == PTR_NULL() { *out_failed = true; return; };
    let req: ptr = PTR_NULL();
    let rst: u32 = sa_http_client_req_new_v2(client, method_tag, url_p, url_l, &req);
    if rst != 0 || req == PTR_NULL() {
        let cf: u32 = sa_http_client_free(client);
        *out_failed = true;
        return;
    };
    let hdoc: u64 = ip_parse(ip_text_ptr(headers_text), headers_text.len);
    if hdoc != 0 {
        let cnt: u64 = 0;
        let cst2: i32 = sa_json_value_count(hdoc, &cnt);
        let hi: u64 = 0;
        while hi < cnt {
            let kp: ptr = PTR_NULL();
            let kn: u64 = 0;
            let kst: i32 = sa_json_object_key_at(hdoc, hi, &kp, &kn);
            if kst == 0 {
                let vp: ptr = PTR_NULL();
                let vl: u64 = 0;
                let vnode: u64 = ip_jget(hdoc, kp, kn);
                if ip_jstr(vnode, &vp, &vl) {
                    let hst: u32 = sa_http_client_req_add_header_v2(req, kp, kn, vp, vl);
                };
            };
            hi = hi + 1;
        }
        let hf: i32 = sa_json_free(hdoc);
    };
    if has_body {
        let bst: u32 = sa_http_client_req_set_body_v2(req, body_p, body_l);
    };
    let resp: ptr = PTR_NULL();
    let sst: u32 = sa_http_client_req_send_v2(req, &resp);
    if sst != 0 || resp == PTR_NULL() {
        let rf: u32 = sa_http_client_req_free(req);
        let cf2: u32 = sa_http_client_free(client);
        *out_failed = true;
        return;
    };
    *out_status = sa_http_client_resp_status(resp) as i64;
    let bp: ptr = sa_http_client_resp_body_ptr(resp);
    let bn: u64 = sa_http_client_resp_body_len(resp);
    if bp != PTR_NULL() { ip_append(out_body, bp, bn); };
    let rf3: u32 = sa_http_client_resp_free(resp);
    let rf4: u32 = sa_http_client_req_free(req);
    let cf4: u32 = sa_http_client_free(client);
}

fn ip_headers_bearer(key_p: ptr, key_l: u64, extra_google: bool) -> IpText {
    let doc: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    let bearer = IpText { bytes: [0u8; 262144], len: 0 };
    ip_append(&bearer, STR_PTR("Bearer "), STR_LEN("Bearer "));
    ip_append(&bearer, key_p, key_l);
    let s1: i32 = sa_json_object_set_string(doc, STR_PTR("Authorization"), STR_LEN("Authorization"), ip_text_ptr(&bearer), bearer.len);
    if extra_google {
        let s2: i32 = sa_json_object_set_string(doc, STR_PTR("X-Goog-Api-Key"), STR_LEN("X-Goog-Api-Key"), key_p, key_l);
    };
    let s3: i32 = sa_json_object_set_string(doc, STR_PTR("Content-Type"), STR_LEN("Content-Type"), STR_PTR("application/json"), STR_LEN("application/json"));
    let text = IpText { bytes: [0u8; 262144], len: 0 };
    ip_doc_text(doc, &text);
    let f: i32 = sa_json_free(doc);
    return text;
}

fn ip_uri_encode(p: ptr, len: u64, out: &IpText) -> void {
    let hex: ptr = STR_PTR("0123456789ABCDEF");
    let i: u64 = 0;
    while i < len {
        let c: u8 = ip_byte(p, i);
        let ok: bool = (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 45 || c == 95 || c == 46 || c == 33 || c == 126 || c == 42 || c == 39 || c == 40 || c == 41;
        if ok {
            let one: [u8; 1] = [c; 1];
            let op: ptr = PTR_NULL();
            PTR_BYTE_ADD(op, &one, 0);
            ip_append(out, op, 1);
        } else {
            ip_append(out, STR_PTR("%"), STR_LEN("%"));
            let h1: [u8; 1] = [ip_byte(hex, (c / 16) as u64); 1];
            let hp1: ptr = PTR_NULL();
            PTR_BYTE_ADD(hp1, &h1, 0);
            ip_append(out, hp1, 1);
            let h2: [u8; 1] = [ip_byte(hex, (c % 16) as u64); 1];
            let hp2: ptr = PTR_NULL();
            PTR_BYTE_ADD(hp2, &h2, 0);
            ip_append(out, hp2, 1);
        };
        i = i + 1;
    }
}

fn sleep_ms(ms: u64, aborted: bool) -> i32 {
    // TS sleep rejects when the signal is (or becomes) aborted; the
    // landed flag is a snapshot — an already-aborted signal rejects
    // immediately (return 1); later aborts are not observable
    // (registered).
    if aborted { return 1; };
    let remaining: u64 = ms;
    while remaining > 0 {
        let slice: u64 = remaining;
        if slice > 100 { slice = 100; };
        let st: i32 = sa_time_sleep_ms(slice);
        remaining = remaining - slice;
    }
    return 0;
}

// ---- async video poll ----
// Internal form: 0 = completed (doc in out_doc), 1 = TS throw
// (message in err). Landed pollAsyncImageTask wraps it.
fn ip_poll_last_get() -> u64 {
    let doc: u64 = 0;
    let st: i32 = sa_global_u64_get(STR_PTR("ip.lastdoc"), STR_LEN("ip.lastdoc"), &doc);
    if st != 0 { return 0; };
    return doc;
}

fn ip_poll_last_set(doc: u64) -> void {
    let old: u64 = ip_poll_last_get();
    if old != 0 && old != doc {
        let f: i32 = sa_json_free(old);
    };
    let sst: i32 = sa_global_u64_set(STR_PTR("ip.lastdoc"), STR_LEN("ip.lastdoc"), doc);
}

fn ip_poll_task(base_p: ptr, base_l: u64, key_p: ptr, key_l: u64, task_id_p: ptr, task_id_l: u64, aborted: bool, out_doc: &u64, err: &IpText) -> i32 {
    *out_doc = 0;
    err.len = 0;
    let deadline: i64 = sa_time_unix_ms() + 300000;
    // the last polled body rides the "ip.lastdoc" cell: loop-carried
    // rebinding of a doc handle local is rejected by the checker
    ip_poll_last_set(sa_json_parse(STR_PTR("{}"), STR_LEN("{}")));
    while sa_time_unix_ms() < deadline {
        let sst: i32 = sleep_ms(2000, aborted);
        if sst != 0 {
            ip_append(err, STR_PTR("The operation was aborted"), STR_LEN("The operation was aborted"));
            ip_poll_last_set(0);
            return 1;
        };
        let enc = IpText { bytes: [0u8; 262144], len: 0 };
        ip_uri_encode(task_id_p, task_id_l, &enc);
        let url = IpText { bytes: [0u8; 262144], len: 0 };
        ip_append(&url, base_p, base_l);
        ip_append(&url, STR_PTR("/videos/"), STR_LEN("/videos/"));
        ip_append(&url, ip_text_ptr(&enc), enc.len);
        let headers = IpText { bytes: [0u8; 262144], len: 0 };
        let hdoc: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
        let bearer = IpText { bytes: [0u8; 262144], len: 0 };
        ip_append(&bearer, STR_PTR("Bearer "), STR_LEN("Bearer "));
        ip_append(&bearer, key_p, key_l);
        let hs: i32 = sa_json_object_set_string(hdoc, STR_PTR("Authorization"), STR_LEN("Authorization"), ip_text_ptr(&bearer), bearer.len);
        ip_doc_text(hdoc, &headers);
        let hf: i32 = sa_json_free(hdoc);
        let status: i64 = 0;
        let rbody = IpText { bytes: [0u8; 262144], len: 0 };
        let failed: bool = false;
        ip_http(1, ip_text_ptr(&url), url.len, &headers, PTR_NULL(), 0, false, &status, &rbody, &failed);
        if failed {
            ip_append(err, STR_PTR("fetch failed"), STR_LEN("fetch failed"));
            ip_poll_last_set(0);
            return 1;
        };
        let ok: bool = status >= 200 && status < 300;
        let doc: u64 = ip_read_json(status as i32, ip_text_ptr(&rbody), rbody.len);
        ip_poll_last_set(doc);
        if !ok {
            ip_error_text(ip_poll_last_get(), err);
            if err.len == 0 {
                ip_append(err, STR_PTR("Async image task query failed ("), STR_LEN("Async image task query failed ("));
                ip_append_i64(err, status);
                ip_append(err, STR_PTR(")"), STR_LEN(")"));
            };
            ip_poll_last_set(0);
            return 1;
        };
        let stp: ptr = PTR_NULL();
        let stl: u64 = 0;
        let has_status: bool = ip_field_str(ip_poll_last_get(), STR_PTR("status"), STR_LEN("status"), &stp, &stl);
        let lowered = IpSmall { bytes: [0u8; 8192], len: 0 };
        if has_status {
            let li: u64 = 0;
            while li < stl {
                let one: [u8; 1] = [ip_lower(ip_byte(stp, li)); 1];
                let op: ptr = PTR_NULL();
                PTR_BYTE_ADD(op, &one, 0);
                ip_append_small(&lowered, op, 1);
                li = li + 1;
            }
        };
        let lp: ptr = ip_small_ptr(&lowered);
        if ip_eq(lp, lowered.len, STR_PTR("completed"), STR_LEN("completed")) || ip_eq(lp, lowered.len, STR_PTR("succeeded"), STR_LEN("succeeded")) || ip_eq(lp, lowered.len, STR_PTR("success"), STR_LEN("success")) {
            *out_doc = ip_poll_last_get();
            let sst2: i32 = sa_global_u64_set(STR_PTR("ip.lastdoc"), STR_LEN("ip.lastdoc"), 0);
            return 0;
        };
        if ip_eq(lp, lowered.len, STR_PTR("failed"), STR_LEN("failed")) || ip_eq(lp, lowered.len, STR_PTR("error"), STR_LEN("error")) || ip_eq(lp, lowered.len, STR_PTR("cancelled"), STR_LEN("cancelled")) || ip_eq(lp, lowered.len, STR_PTR("canceled"), STR_LEN("canceled")) {
            ip_error_text(ip_poll_last_get(), err);
            if err.len == 0 {
                ip_append(err, STR_PTR("Async image task failed: "), STR_LEN("Async image task failed: "));
                ip_append(err, lp, lowered.len);
            };
            ip_poll_last_set(0);
            return 1;
        };
    }
    ip_error_text(ip_poll_last_get(), err);
    if err.len == 0 {
        ip_append(err, STR_PTR("Async image task timed out"), STR_LEN("Async image task timed out"));
    };
    ip_poll_last_set(0);
    return 1;
}

fn pollAsyncImageTask(provider_json_ptr: ptr, provider_json_len: u64, apiKey_ptr: ptr, apiKey_len: u64, taskId_ptr: ptr, taskId_len: u64) -> i32 {
    let provider: u64 = ip_parse(provider_json_ptr, provider_json_len);
    let base = IpSmall { bytes: [0u8; 8192], len: 0 };
    let has_base: bool = ip_provider_base(provider, &base);
    if provider != 0 { let f: i32 = sa_json_free(provider); };
    if !has_base { return 1; };
    let completed: u64 = 0;
    let err = IpText { bytes: [0u8; 262144], len: 0 };
    let st: i32 = ip_poll_task(ip_small_ptr(&base), base.len, apiKey_ptr, apiKey_len, taskId_ptr, taskId_len, false, &completed, &err);
    if completed != 0 {
        // completed body is kept in the "ip.polldoc" cell for the
        // caller (the landed signature has no body channel)
        let old: u64 = 0;
        let gst: i32 = sa_global_u64_get(STR_PTR("ip.polldoc"), STR_LEN("ip.polldoc"), &old);
        if gst == 0 && old != 0 { let f2: i32 = sa_json_free(old); };
        let sst: i32 = sa_global_u64_set(STR_PTR("ip.polldoc"), STR_LEN("ip.polldoc"), completed);
    };
    return st;
}

// ---- flows ----
fn ip_input_provider(input: &ImageGenInput) -> u64 {
    return ip_parse(input.provider_json_ptr, input.provider_json_len);
}

// Shared flow tail: readJson + normalize + hydrate(identity) +
// result. normalize_kind: 0 api, 1 gemini chat, 2 gemini GC.
fn ip_flow_finish(status_code: i64, rbody: &IpText, normalize_kind: u64, out: &ImageGenResult) -> void {
    let ok: bool = status_code >= 200 && status_code < 300;
    let parsed: u64 = ip_read_json(status_code as i32, ip_text_ptr(rbody), rbody.len);
    let ptext = IpText { bytes: [0u8; 262144], len: 0 };
    ip_doc_text(parsed, &ptext);
    if parsed != 0 { let f: i32 = sa_json_free(parsed); };
    let stage = IpText { bytes: [0u8; 262144], len: 0 };
    let stage_p: ptr = PTR_NULL();
    PTR_BYTE_ADD(stage_p, &stage.bytes, 0);
    let pp: ptr = ip_text_ptr(&ptext);
    if normalize_kind == 0 { stage.len = normalizeImageApiResponse(status_code as i32, ok, pp, ptext.len, stage_p); };
    if normalize_kind == 1 { stage.len = normalizeGeminiChatResponse(status_code as i32, ok, pp, ptext.len, stage_p); };
    if normalize_kind == 2 { stage.len = normalizeGeminiGenerateContentResponse(status_code as i32, ok, pp, ptext.len, stage_p); };
    // hydrate = identity
    let doc: u64 = ip_parse(stage_p, stage.len);
    ip_result_set(doc, out);
    if doc != 0 { let f2: i32 = sa_json_free(doc); };
    out.status = status_code as i32;
    if ok { out.status = 200; };
}

fn runOpenAiImageGeneration(input: &ImageGenInput, out: &ImageGenResult) -> i32 {
    let provider: u64 = ip_input_provider(input);
    let base = IpSmall { bytes: [0u8; 8192], len: 0 };
    if !ip_provider_base(provider, &base) {
        if provider != 0 { let f: i32 = sa_json_free(provider); };
        ip_result_error(out, STR_PTR("Provider is missing baseUrl"), STR_LEN("Provider is missing baseUrl"), 0);
        return 0;
    };
    // payload {model, prompt, ...jsonOptions(options)}
    let payload: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    let s1: i32 = sa_json_object_set_string(payload, STR_PTR("model"), STR_LEN("model"), input.model_ptr, input.model_len);
    let s2: i32 = sa_json_object_set_string(payload, STR_PTR("prompt"), STR_LEN("prompt"), input.prompt_ptr, input.prompt_len);
    let options: u64 = ip_parse(input.options_json_ptr, input.options_json_len);
    if options != 0 && sa_json_kind(options) == 7 {
        let cnt: u64 = 0;
        let cst: i32 = sa_json_value_count(options, &cnt);
        let i: u64 = 0;
        while i < cnt {
            let kp: ptr = PTR_NULL();
            let kn: u64 = 0;
            let kst: i32 = sa_json_object_key_at(options, i, &kp, &kn);
            if kst == 0 {
                let child: u64 = ip_jget(options, kp, kn);
                if child != 0 {
                    let ctext = IpText { bytes: [0u8; 262144], len: 0 };
                    ip_doc_text(child, &ctext);
                    let clone: u64 = ip_parse(ip_text_ptr(&ctext), ctext.len);
                    if clone != 0 {
                        let sst: i32 = sa_json_object_set_node(payload, kp, kn, clone);
                    };
                };
            };
            i = i + 1;
        }
    };
    if options != 0 { let f2: i32 = sa_json_free(options); };
    let body = IpText { bytes: [0u8; 262144], len: 0 };
    ip_doc_text(payload, &body);
    let f3: i32 = sa_json_free(payload);
    let url = IpText { bytes: [0u8; 262144], len: 0 };
    ip_append(&url, ip_small_ptr(&base), base.len);
    ip_append(&url, STR_PTR("/images/generations"), STR_LEN("/images/generations"));
    let headers = ip_headers_bearer(input.apiKey_ptr, input.apiKey_len, false);
    let status: i64 = 0;
    let rbody = IpText { bytes: [0u8; 262144], len: 0 };
    let failed: bool = false;
    ip_http(2, ip_text_ptr(&url), url.len, &headers, ip_text_ptr(&body), body.len, true, &status, &rbody, &failed);
    if failed {
        if provider != 0 { let f4: i32 = sa_json_free(provider); };
        ip_result_error(out, STR_PTR("fetch failed"), STR_LEN("fetch failed"), 0);
        return 0;
    };
    ip_ctx_set(provider, input.model_ptr, input.model_len, input.prompt_ptr, input.prompt_len, STR_PTR("images/generations"), STR_LEN("images/generations"), 0);
    if provider != 0 { let f5: i32 = sa_json_free(provider); };
    ip_flow_finish(status, &rbody, 0, out);
    return 0;
}

fn runGeminiChatCompletions(input: &ImageGenInput, out: &ImageGenResult) -> i32 {
    let provider: u64 = ip_input_provider(input);
    let base = IpSmall { bytes: [0u8; 8192], len: 0 };
    if !ip_provider_base(provider, &base) {
        if provider != 0 { let f: i32 = sa_json_free(provider); };
        ip_result_error(out, STR_PTR("Provider is missing baseUrl"), STR_LEN("Provider is missing baseUrl"), 0);
        return 0;
    };
    let content_part: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    let c1: i32 = sa_json_object_set_string(content_part, STR_PTR("type"), STR_LEN("type"), STR_PTR("text"), STR_LEN("text"));
    let c2: i32 = sa_json_object_set_string(content_part, STR_PTR("text"), STR_LEN("text"), input.prompt_ptr, input.prompt_len);
    let content_arr: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    let c3: i32 = sa_json_array_push_node(content_arr, content_part);
    let message: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    let c4: i32 = sa_json_object_set_string(message, STR_PTR("role"), STR_LEN("role"), STR_PTR("user"), STR_LEN("user"));
    let c5: i32 = sa_json_object_set_node(message, STR_PTR("content"), STR_LEN("content"), content_arr);
    let messages: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    let c6: i32 = sa_json_array_push_node(messages, message);
    let modalities: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    let c7: i32 = sa_json_array_push_string(modalities, STR_PTR("text"), STR_LEN("text"));
    let c8: i32 = sa_json_array_push_string(modalities, STR_PTR("image"), STR_LEN("image"));
    let payload: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    let c9: i32 = sa_json_object_set_string(payload, STR_PTR("model"), STR_LEN("model"), input.model_ptr, input.model_len);
    let c10: i32 = sa_json_object_set_node(payload, STR_PTR("messages"), STR_LEN("messages"), messages);
    let c11: i32 = sa_json_object_set_node(payload, STR_PTR("modalities"), STR_LEN("modalities"), modalities);
    let body = IpText { bytes: [0u8; 262144], len: 0 };
    ip_doc_text(payload, &body);
    let f1: i32 = sa_json_free(payload);
    let url = IpText { bytes: [0u8; 262144], len: 0 };
    ip_append(&url, ip_small_ptr(&base), base.len);
    ip_append(&url, STR_PTR("/chat/completions"), STR_LEN("/chat/completions"));
    let headers = ip_headers_bearer(input.apiKey_ptr, input.apiKey_len, false);
    let status: i64 = 0;
    let rbody = IpText { bytes: [0u8; 262144], len: 0 };
    let failed: bool = false;
    ip_http(2, ip_text_ptr(&url), url.len, &headers, ip_text_ptr(&body), body.len, true, &status, &rbody, &failed);
    if failed {
        if provider != 0 { let f2: i32 = sa_json_free(provider); };
        ip_result_error(out, STR_PTR("fetch failed"), STR_LEN("fetch failed"), 0);
        return 0;
    };
    ip_ctx_set(provider, input.model_ptr, input.model_len, input.prompt_ptr, input.prompt_len, STR_PTR("chat/completions"), STR_LEN("chat/completions"), 0);
    if provider != 0 { let f3: i32 = sa_json_free(provider); };
    ip_flow_finish(status, &rbody, 1, out);
    return 0;
}

fn runGeminiGenerateContent(input: &ImageGenInput, out: &ImageGenResult) -> i32 {
    let provider: u64 = ip_input_provider(input);
    // geminiNativeBaseUrl(provider) — recomputed on the parsed doc
    let base = IpSmall { bytes: [0u8; 8192], len: 0 };
    if !ip_provider_base(provider, &base) {
        if provider != 0 { let f: i32 = sa_json_free(provider); };
        ip_result_error(out, STR_PTR("Provider is missing baseUrl"), STR_LEN("Provider is missing baseUrl"), 0);
        return 0;
    };
    let bp: ptr = ip_small_ptr(&base);
    if ip_ends_ci(bp, base.len, STR_PTR("/models/"), STR_LEN("/models/")) { base.len = base.len - 8; };
    bp = ip_small_ptr(&base);
    if ip_ends_ci(bp, base.len, STR_PTR("/models"), STR_LEN("/models")) { base.len = base.len - 7; };
    bp = ip_small_ptr(&base);
    if ip_ends_ci(bp, base.len, STR_PTR("/openai/"), STR_LEN("/openai")) { base.len = base.len - 8; };
    bp = ip_small_ptr(&base);
    if ip_ends_ci(bp, base.len, STR_PTR("/openai"), STR_LEN("/openai")) { base.len = base.len - 7; };
    bp = ip_small_ptr(&base);
    let native = IpText { bytes: [0u8; 262144], len: 0 };
    if ip_ends_ci(bp, base.len, STR_PTR("/v1beta"), STR_LEN("/v1beta")) {
        ip_append(&native, bp, base.len);
    } else {
        if ip_ends_ci(bp, base.len, STR_PTR("/v1"), STR_LEN("/v1")) {
            ip_append(&native, bp, base.len - 3);
            ip_append(&native, STR_PTR("/v1beta"), STR_LEN("/v1beta"));
        } else {
            ip_append(&native, bp, base.len);
            ip_append(&native, STR_PTR("/v1beta"), STR_LEN("/v1beta"));
        };
    };
    let enc = IpText { bytes: [0u8; 262144], len: 0 };
    ip_uri_encode(input.model_ptr, input.model_len, &enc);
    let url = IpText { bytes: [0u8; 262144], len: 0 };
    ip_append(&url, ip_text_ptr(&native), native.len);
    ip_append(&url, STR_PTR("/models/"), STR_LEN("/models/"));
    ip_append(&url, ip_text_ptr(&enc), enc.len);
    ip_append(&url, STR_PTR(":generateContent"), STR_LEN(":generateContent"));
    let part: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    let g1: i32 = sa_json_object_set_string(part, STR_PTR("text"), STR_LEN("text"), input.prompt_ptr, input.prompt_len);
    let parts: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    let g2: i32 = sa_json_array_push_node(parts, part);
    let content_obj: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    let g3: i32 = sa_json_object_set_node(content_obj, STR_PTR("parts"), STR_LEN("parts"), parts);
    let contents: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    let g4: i32 = sa_json_array_push_node(contents, content_obj);
    let modalities: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    let g5: i32 = sa_json_array_push_string(modalities, STR_PTR("TEXT"), STR_LEN("TEXT"));
    let g6: i32 = sa_json_array_push_string(modalities, STR_PTR("IMAGE"), STR_LEN("IMAGE"));
    let gen_cfg: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    let g7: i32 = sa_json_object_set_node(gen_cfg, STR_PTR("responseModalities"), STR_LEN("responseModalities"), modalities);
    let payload: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    let g8: i32 = sa_json_object_set_node(payload, STR_PTR("contents"), STR_LEN("contents"), contents);
    let g9: i32 = sa_json_object_set_node(payload, STR_PTR("generationConfig"), STR_LEN("generationConfig"), gen_cfg);
    let body = IpText { bytes: [0u8; 262144], len: 0 };
    ip_doc_text(payload, &body);
    let f1: i32 = sa_json_free(payload);
    let headers = ip_headers_bearer(input.apiKey_ptr, input.apiKey_len, true);
    let status: i64 = 0;
    let rbody = IpText { bytes: [0u8; 262144], len: 0 };
    let failed: bool = false;
    ip_http(2, ip_text_ptr(&url), url.len, &headers, ip_text_ptr(&body), body.len, true, &status, &rbody, &failed);
    if failed {
        if provider != 0 { let f2: i32 = sa_json_free(provider); };
        ip_result_error(out, STR_PTR("fetch failed"), STR_LEN("fetch failed"), 0);
        return 0;
    };
    ip_ctx_set(provider, input.model_ptr, input.model_len, input.prompt_ptr, input.prompt_len, STR_PTR("generateContent"), STR_LEN("generateContent"), 0);
    if provider != 0 { let f3: i32 = sa_json_free(provider); };
    ip_flow_finish(status, &rbody, 2, out);
    return 0;
}

fn runAsyncVideoImageGeneration(input: &ImageGenInput, out: &ImageGenResult) -> i32 {
    let provider: u64 = ip_input_provider(input);
    let base = IpSmall { bytes: [0u8; 8192], len: 0 };
    if !ip_provider_base(provider, &base) {
        if provider != 0 { let f: i32 = sa_json_free(provider); };
        ip_result_error(out, STR_PTR("Provider is missing baseUrl"), STR_LEN("Provider is missing baseUrl"), 0);
        return 0;
    };
    let options: u64 = ip_parse(input.options_json_ptr, input.options_json_len);
    let payload: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    let s1: i32 = sa_json_object_set_string(payload, STR_PTR("model"), STR_LEN("model"), input.model_ptr, input.model_len);
    let s2: i32 = sa_json_object_set_string(payload, STR_PTR("prompt"), STR_LEN("prompt"), input.prompt_ptr, input.prompt_len);
    // size: stringOption(options.size) ?? "1024x1024"
    let zp: ptr = PTR_NULL();
    let zl: u64 = 0;
    let has_size: bool = false;
    if ip_field_str(options, STR_PTR("size"), STR_LEN("size"), &zp, &zl) {
        let lo: u64 = 0;
        let hi: u64 = 0;
        ip_trim_range(zp, zl, &lo, &hi);
        if hi > lo { has_size = true; };
    };
    if has_size {
        let s3: i32 = sa_json_object_set_string(payload, STR_PTR("size"), STR_LEN("size"), zp, zl);
    } else {
        let s3b: i32 = sa_json_object_set_string(payload, STR_PTR("size"), STR_LEN("size"), STR_PTR("1024x1024"), STR_LEN("1024x1024"));
    };
    let nv: f64 = 0.0;
    if ip_field_num(options, STR_PTR("n"), STR_LEN("n"), &nv) {
        let s4: i32 = sa_json_object_set_f64(payload, STR_PTR("n"), STR_LEN("n"), nv);
    } else {
        let s4b: i32 = sa_json_object_set_i64(payload, STR_PTR("n"), STR_LEN("n"), 1);
    };
    let fp: ptr = PTR_NULL();
    let fl: u64 = 0;
    let has_fmt: bool = false;
    if ip_field_str(options, STR_PTR("response_format"), STR_LEN("response_format"), &fp, &fl) {
        let lo2: u64 = 0;
        let hi2: u64 = 0;
        ip_trim_range(fp, fl, &lo2, &hi2);
        if hi2 > lo2 { has_fmt = true; };
    };
    if has_fmt {
        let s5: i32 = sa_json_object_set_string(payload, STR_PTR("response_format"), STR_LEN("response_format"), fp, fl);
    } else {
        let s5b: i32 = sa_json_object_set_string(payload, STR_PTR("response_format"), STR_LEN("response_format"), STR_PTR("url"), STR_LEN("url"));
    };
    if options != 0 { let f1: i32 = sa_json_free(options); };
    let body = IpText { bytes: [0u8; 262144], len: 0 };
    ip_doc_text(payload, &body);
    let f2: i32 = sa_json_free(payload);
    let url = IpText { bytes: [0u8; 262144], len: 0 };
    ip_append(&url, ip_small_ptr(&base), base.len);
    ip_append(&url, STR_PTR("/videos"), STR_LEN("/videos"));
    let headers = ip_headers_bearer(input.apiKey_ptr, input.apiKey_len, false);
    let status: i64 = 0;
    let rbody = IpText { bytes: [0u8; 262144], len: 0 };
    let failed: bool = false;
    ip_http(2, ip_text_ptr(&url), url.len, &headers, ip_text_ptr(&body), body.len, true, &status, &rbody, &failed);
    if failed {
        if provider != 0 { let f3: i32 = sa_json_free(provider); };
        ip_result_error(out, STR_PTR("fetch failed"), STR_LEN("fetch failed"), 0);
        return 0;
    };
    let ok: bool = status >= 200 && status < 300;
    let submitted: u64 = ip_read_json(status as i32, ip_text_ptr(&rbody), rbody.len);
    ip_ctx_set(provider, input.model_ptr, input.model_len, input.prompt_ptr, input.prompt_len, STR_PTR("videos"), STR_LEN("videos"), submitted);
    if !ok {
        let doc: u64 = ip_error_response_doc(submitted, status as i32, STR_PTR("videos"), STR_LEN("videos"));
        ip_result_set(doc, out);
        if doc != 0 { let f4: i32 = sa_json_free(doc); };
        out.status = status as i32;
        if provider != 0 { let f5: i32 = sa_json_free(provider); };
        return 0;
    };
    let tp: ptr = PTR_NULL();
    let tl: u64 = 0;
    let has_task: bool = false;
    if ip_field_str(submitted, STR_PTR("task_id"), STR_LEN("task_id"), &tp, &tl) { has_task = true; };
    if !has_task && ip_field_str(submitted, STR_PTR("id"), STR_LEN("id"), &tp, &tl) { has_task = true; };
    if !has_task {
        let doc2: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
        let e1: i32 = sa_json_object_set_string(doc2, STR_PTR("error"), STR_LEN("error"), STR_PTR("Async image API returned no task id"), STR_LEN("Async image API returned no task id"));
        let e2: i32 = sa_json_object_set_i64(doc2, STR_PTR("statusCode"), STR_LEN("statusCode"), status);
        let e3: i32 = sa_json_object_set_string(doc2, STR_PTR("endpoint"), STR_LEN("endpoint"), STR_PTR("videos"), STR_LEN("videos"));
        let stext = IpText { bytes: [0u8; 262144], len: 0 };
        ip_doc_text(submitted, &stext);
        let sclone: u64 = ip_parse(ip_text_ptr(&stext), stext.len);
        if sclone != 0 {
            let e4: i32 = sa_json_object_set_node(doc2, STR_PTR("raw"), STR_LEN("raw"), sclone);
        };
        ip_result_set(doc2, out);
        let f6: i32 = sa_json_free(doc2);
        out.status = 502;
        if provider != 0 { let f7: i32 = sa_json_free(provider); };
        return 0;
    };
    // copy the task id before the ctx registry's submitted doc is
    // freed by the next registry write
    let task_id = IpSmall { bytes: [0u8; 8192], len: 0 };
    ip_append_small(&task_id, tp, tl);
    let completed: u64 = 0;
    let err = IpText { bytes: [0u8; 262144], len: 0 };
    let pst2: i32 = ip_poll_task(ip_small_ptr(&base), base.len, input.apiKey_ptr, input.apiKey_len, ip_small_ptr(&task_id), task_id.len, input.aborted, &completed, &err);
    if pst2 != 0 {
        // TS throws out of runAsyncVideoImageGeneration; landed as
        // status 0 + error body (the message rides the internal form)
        ip_result_error(out, ip_text_ptr(&err), err.len, 0);
        if provider != 0 { let f8: i32 = sa_json_free(provider); };
        return 0;
    };
    let ctext = IpText { bytes: [0u8; 262144], len: 0 };
    ip_doc_text(completed, &ctext);
    if completed != 0 { let f9: i32 = sa_json_free(completed); };
    let stage = IpText { bytes: [0u8; 262144], len: 0 };
    let stage_p: ptr = PTR_NULL();
    PTR_BYTE_ADD(stage_p, &stage.bytes, 0);
    stage.len = normalizeAsyncImageTask(ip_text_ptr(&ctext), ctext.len, stage_p);
    let doc3: u64 = ip_parse(stage_p, stage.len);
    ip_result_set(doc3, out);
    if doc3 != 0 { let f10: i32 = sa_json_free(doc3); };
    out.status = 200;
    if provider != 0 { let f11: i32 = sa_json_free(provider); };
    return 0;
}

fn runImageGeneration(input: &ImageGenInput, out: &ImageGenResult) -> i32 {
    let code: u64 = selectImageGenerationProtocol(input.provider_json_ptr, input.provider_json_len, input.model_ptr, input.model_len, input.protocol, input.has_protocol);
    if code == 4 { return runAsyncVideoImageGeneration(input, out); };
    if code == 3 { return runGeminiGenerateContent(input, out); };
    if code == 2 { return runGeminiChatCompletions(input, out); };
    return runOpenAiImageGeneration(input, out);
}
