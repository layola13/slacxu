    };
    let n: u64 = ip_write_out(doc, out_ptr);
    let f2: i32 = sa_json_free(doc);
    return n;
}

fn normalizedImageResult(data_ptr: ptr, data_len: u64, out_ptr: ptr) -> u64 {
    // landed form carries only the data array; the rest of the
    // context comes from the registry (see header note), raw is
    // absent, created absent.
    let parsed: u64 = ip_parse(data_ptr, data_len);
    if parsed != 0 && sa_json_kind(parsed) == 6 {
        let doc: u64 = ip_normalized_result(0, parsed, 0.0, false);
        let f: i32 = sa_json_free(parsed);
        if doc == 0 {
            PTR_COPY_BYTES(out_ptr, STR_PTR("{}"), 2);
            return 2;
        };
        let n: u64 = ip_write_out(doc, out_ptr);
        let f3: i32 = sa_json_free(doc);
        return n;
    };
    if parsed != 0 { let f9: i32 = sa_json_free(parsed); };
    let empty: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    let doc2: u64 = ip_normalized_result(0, empty, 0.0, false);
    if empty != 0 { let f8: i32 = sa_json_free(empty); };
    if doc2 == 0 {
        PTR_COPY_BYTES(out_ptr, STR_PTR("{}"), 2);
        return 2;
    };
    let n2: u64 = ip_write_out(doc2, out_ptr);
    let f7: i32 = sa_json_free(doc2);
    return n2;
}

fn normalizeImageApiResponse(status: i32, ok: bool, body_ptr: ptr, body_len: u64, out_ptr: ptr) -> u64 {
    let body: u64 = ip_parse(body_ptr, body_len);
    let ctx: u64 = ip_ctx_get();
    let ep: ptr = PTR_NULL();
    let el: u64 = 0;
    let has_ep: bool = ip_field_str(ctx, STR_PTR("endpoint"), STR_LEN("endpoint"), &ep, &el);
    if !ok {
        let doc: u64 = ip_error_response_doc(body, status, ep, el);
        if body != 0 { let f: i32 = sa_json_free(body); };
        if doc == 0 { PTR_COPY_BYTES(out_ptr, STR_PTR("{}"), 2); return 2; };
        let n: u64 = ip_write_out(doc, out_ptr);
        let f2: i32 = sa_json_free(doc);
        return n;
    };
    let data_arr: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    let raw_data: u64 = ip_jget(body, STR_PTR("data"), STR_LEN("data"));
    if raw_data != 0 && sa_json_kind(raw_data) == 6 {
        let cnt: u64 = 0;
        let st: i32 = sa_json_value_count(raw_data, &cnt);
        let i: u64 = 0;
        while i < cnt {
            let el2: u64 = 0;
            let gst: i32 = sa_json_array_get(raw_data, i, &el2);
            if gst == 0 && el2 != 0 {
                // asRecord(entry): non-object -> {} -> null result
                let nd: u64 = ip_normalize_data(el2);
                if nd != 0 {
                    let pst: i32 = sa_json_array_push_node(data_arr, nd);
                };
            };
            i = i + 1;
        }
    };
    let created: f64 = 0.0;
    let has_created: bool = ip_field_num(body, STR_PTR("created"), STR_LEN("created"), &created);
    let doc2: u64 = ip_normalized_result(body, data_arr, created, has_created);
    let f3: i32 = sa_json_free(data_arr);
    if body != 0 { let f4: i32 = sa_json_free(body); };
    if doc2 == 0 { PTR_COPY_BYTES(out_ptr, STR_PTR("{}"), 2); return 2; };
    let n2: u64 = ip_write_out(doc2, out_ptr);
    let f5: i32 = sa_json_free(doc2);
    return n2;
}

fn normalizeGeminiChatResponse(status: i32, ok: bool, body_ptr: ptr, body_len: u64, out_ptr: ptr) -> u64 {
