// Converted 1:1 from apps/server/src/imageProtocols.ts (CXU plugins @ f2cb649d).
// FIX (stores batch): full body retranslation. The skeleton header's
// claim that fetch has no sa_std counterpart is stale (http_client
// v2, AB class (ii) blocking landing); the awaits are sequential
// fetches plus the async-video poll loop (deadline + sleep slices,
// the landed sleep_ms). Landed-signature notes (registered in
// _defects/FIX_SERVER_STORES.md):
// - The normalize* landed forms dropped the TS context parameter
//   {provider, model, prompt, endpoint, submitted}; the run* flows
//   stage it in the module context registry (cell "ip.ctxdoc")
//   before calling, the same lifetime model as the ledger registry.
// - ImageGenResult.body_json_ptr points at a stringify buffer held
//   in the "ip.resultbuf" cell — valid until the next
//   runImageGeneration call.
// - providerBaseUrl's TS throw ("Provider is missing baseUrl")
//   lands as length 0 from providerBaseUrl and, in the flows, as
//   status 0 + an {"error": ...} body. pollAsyncImageTask's TS
//   throws land in its internal form's error text (kept on the
//   flow path) — the landed i32-only form returns nonzero.
// - extractImagesFromUnknown recursion is depth-capped at 32
//   (TS is unbounded; provider payloads are shallow).
// - stringValue here is the TS file's own variant: typeof string,
//   NO trim (differs from auditLogStore's — each file keeps its own
//   TS semantics).
@import "sa_std/io/print.sai"
@import "sa_std/string.sa"
@import "sa_std/ptr.sa"
@import "sa_std/encoding/json.sai"
@import "sa_std/http_client.sai"
@import "sa_std/time.sai"
@import "sa_std/globals.sai"

struct ImageGenInput { provider_json_ptr: ptr, provider_json_len: u64, apiKey_ptr: ptr, apiKey_len: u64, prompt_ptr: ptr, prompt_len: u64, model_ptr: ptr, model_len: u64, options_json_ptr: ptr, options_json_len: u64, protocol: u64, has_protocol: bool, aborted: bool }
struct ImageGenResult { body_json_ptr: ptr, body_json_len: u64, status: i32 }

// Protocol codes (landed u64 form of ImageGenerationProtocol):
// 0 openaiImages, 1 openaiImageEdits, 2 geminiChatCompletions,
// 3 geminiGenerateContent, 4 deepkeyAsyncVideos, 99 = absent.
fn ip_pc_openai() -> u64 { return 0; }
fn ip_pc_edits() -> u64 { return 1; }
fn ip_pc_gemini_chat() -> u64 { return 2; }
fn ip_pc_gemini_gc() -> u64 { return 3; }
fn ip_pc_deepkey() -> u64 { return 4; }
fn ip_pc_none() -> u64 { return 99; }

struct IpText { bytes: [u8; 262144], len: u64 }
struct IpSmall { bytes: [u8; 8192], len: u64 }

fn ip_text_ptr(t: &IpText) -> ptr {
    let p: ptr = PTR_NULL();
    PTR_BYTE_ADD(p, &t.bytes, 0);
    return p;
}

fn ip_small_ptr(t: &IpSmall) -> ptr {
    let p: ptr = PTR_NULL();
    PTR_BYTE_ADD(p, &t.bytes, 0);
    return p;
}

fn ip_append(dst: &IpText, p: ptr, len: u64) -> void {
    let i: u64 = 0;
    while i < len {
        if dst.len < 262144 {
            let b: u8 = 0;
            PTR_BYTE_AT(b, p, i);
            dst.bytes[dst.len] = b;
            dst.len = dst.len + 1;
        };
        i = i + 1;
    }
}

fn ip_append_small(dst: &IpSmall, p: ptr, len: u64) -> void {
    let i: u64 = 0;
    while i < len {
        if dst.len < 8192 {
            let b: u8 = 0;
            PTR_BYTE_AT(b, p, i);
            dst.bytes[dst.len] = b;
            dst.len = dst.len + 1;
        };
        i = i + 1;
    }
}

fn ip_byte(p: ptr, i: u64) -> u8 {
    let b: u8 = 0;
    PTR_BYTE_AT(b, p, i);
    return b;
}

fn ip_lower(c: u8) -> u8 {
    if c >= 65 && c <= 90 { return c + 32; };
    return c;
}

fn ip_eq(p: ptr, len: u64, q: ptr, qlen: u64) -> bool {
    if len != qlen { return false; };
    let i: u64 = 0;
    while i < len {
        if ip_byte(p, i) != ip_byte(q, i) { return false; };
        i = i + 1;
    }
    return true;
}

fn ip_starts_ci(p: ptr, len: u64, pre: ptr, pre_len: u64) -> bool {
    if pre_len > len { return false; };
    let j: u64 = 0;
    while j < pre_len {
        if ip_lower(ip_byte(p, j)) != ip_lower(ip_byte(pre, j)) { return false; };
        j = j + 1;
    }
    return true;
}

fn ip_ends_ci(p: ptr, len: u64, suf: ptr, suf_len: u64) -> bool {
    if suf_len > len { return false; };
    let off: u64 = len - suf_len;
    let j: u64 = 0;
    while j < suf_len {
        if ip_lower(ip_byte(p, off + j)) != ip_lower(ip_byte(suf, j)) { return false; };
        j = j + 1;
    }
    return true;
}

fn ip_contains_ci(p: ptr, len: u64, needle: ptr, nlen: u64) -> bool {
    if nlen == 0 { return true; };
    if nlen > len { return false; };
    let i: u64 = 0;
    while i + nlen <= len {
        let ok: bool = true;
        let j: u64 = 0;
        while j < nlen {
            if ip_lower(ip_byte(p, i + j)) != ip_lower(ip_byte(needle, j)) { ok = false; };
            j = j + 1;
        }
        if ok { return true; };
        i = i + 1;
    }
    return false;
}

fn ip_trim_range(p: ptr, len: u64, lo: &u64, hi: &u64) -> void {
    let a: u64 = 0;
    let b: u64 = len;
    while a < b {
        let c: u8 = ip_byte(p, a);
        if c == 32 || c == 9 || c == 10 || c == 13 || c == 11 || c == 12 { a = a + 1; } else { break; };
    }
    while b > a {
        let c2: u8 = ip_byte(p, b - 1);
        if c2 == 32 || c2 == 9 || c2 == 10 || c2 == 13 || c2 == 11 || c2 == 12 { b = b - 1; } else { break; };
    }
    *lo = a;
    *hi = b;
}

fn ip_append_i64(dst: &IpText, v: i64) -> void {
    if v < 0 {
        ip_append(dst, STR_PTR("-"), STR_LEN("-"));
        let x: u64 = (0 - v) as u64;
        ip_append_u64(dst, x);
        return;
    };
    ip_append_u64(dst, v as u64);
}

fn ip_append_u64(dst: &IpText, v: u64) -> void {
    if v == 0 {
        ip_append(dst, STR_PTR("0"), STR_LEN("0"));
        return;
    };
    let rev: [u8; 24] = [0u8; 24];
    let n: u64 = 0;
    let x: u64 = v;
    while x > 0 {
        rev[n] = 48 + (x % 10) as u8;
        n = n + 1;
        x = x / 10;
    }
    let i: u64 = n;
    while i > 0 {
        i = i - 1;
        let one: [u8; 1] = [rev[i]; 1];
        let op: ptr = PTR_NULL();
        PTR_BYTE_ADD(op, &one, 0);
        ip_append(dst, op, 1);
    }
}

// ---- JSON helpers ----
fn ip_parse(p: ptr, len: u64) -> u64 {
    if len == 0 { return 0; };
    return sa_json_parse(p, len);
}

fn ip_jget(node: u64, key_p: ptr, key_l: u64) -> u64 {
    if node == 0 { return 0; };
    let out: u64 = 0;
    let st: i32 = sa_json_object_get(node, key_p, key_l, &out);
    if st != 0 { return 0; };
    return out;
}

// this file's stringValue: typeof string ? value : undefined (no trim)
fn ip_jstr(node: u64, out_p: &ptr, out_l: &u64) -> bool {
    *out_p = PTR_NULL();
    *out_l = 0;
    if node == 0 || sa_json_kind(node) != 5 { return false; };
    *out_p = sa_json_string_ptr(node);
    *out_l = sa_json_string_len(node);
    return true;
}

fn ip_field_str(node: u64, key_p: ptr, key_l: u64, out_p: &ptr, out_l: &u64) -> bool {
    return ip_jstr(ip_jget(node, key_p, key_l), out_p, out_l);
}

// numberValue: typeof number && isFinite (JSON numbers are finite)
fn ip_field_num(node: u64, key_p: ptr, key_l: u64, out_v: &f64) -> bool {
    let v: u64 = ip_jget(node, key_p, key_l);
    if v == 0 { return false; };
    let k: u32 = sa_json_kind(v);
    if k != 2 && k != 3 { return false; };
    let st: i32 = sa_json_as_f64(v, out_v);
    return st == 0;
}

fn ip_doc_text(doc: u64, out: &IpText) -> void {
    out.len = 0;
    if doc == 0 { return; };
    let buf: u64 = 0;
    let st: i32 = sa_json_stringify(doc, &buf);
    if st != 0 || buf == 0 { return; };
    let bp: ptr = sa_json_buffer_data(buf);
    let bl: u64 = sa_json_buffer_len(buf);
    ip_append(out, bp, bl);
    let bf: i32 = sa_json_buffer_free(buf);
}

fn ip_write_out(doc: u64, out_ptr: ptr) -> u64 {
    let text = IpText { bytes: [0u8; 262144], len: 0 };
    ip_doc_text(doc, &text);
    let tp: ptr = ip_text_ptr(&text);
    PTR_COPY_BYTES(out_ptr, tp, text.len);
    return text.len;
}

// ---- context + result registries ----
fn ip_ctx_set(provider: u64, model_p: ptr, model_l: u64, prompt_p: ptr, prompt_l: u64, endpoint_p: ptr, endpoint_l: u64, submitted: u64) -> void {
    let doc: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    if doc == 0 { return; };
    let idp: ptr = PTR_NULL();
    let idl: u64 = 0;
    if ip_field_str(provider, STR_PTR("id"), STR_LEN("id"), &idp, &idl) {
        let s1: i32 = sa_json_object_set_string(doc, STR_PTR("providerId"), STR_LEN("providerId"), idp, idl);
    };
    let nmp: ptr = PTR_NULL();
    let nml: u64 = 0;
    if ip_field_str(provider, STR_PTR("name"), STR_LEN("name"), &nmp, &nml) {
        let s2: i32 = sa_json_object_set_string(doc, STR_PTR("providerName"), STR_LEN("providerName"), nmp, nml);
    };
    let s3: i32 = sa_json_object_set_string(doc, STR_PTR("model"), STR_LEN("model"), model_p, model_l);
    let s4: i32 = sa_json_object_set_string(doc, STR_PTR("prompt"), STR_LEN("prompt"), prompt_p, prompt_l);
    let s5: i32 = sa_json_object_set_string(doc, STR_PTR("endpoint"), STR_LEN("endpoint"), endpoint_p, endpoint_l);
    if submitted != 0 {
        let s6: i32 = sa_json_object_set_node(doc, STR_PTR("submitted"), STR_LEN("submitted"), submitted);
    };
    let old: u64 = 0;
    let gst: i32 = sa_global_u64_get(STR_PTR("ip.ctxdoc"), STR_LEN("ip.ctxdoc"), &old);
    if gst == 0 && old != 0 {
        let f: i32 = sa_json_free(old);
    };
    let sst: i32 = sa_global_u64_set(STR_PTR("ip.ctxdoc"), STR_LEN("ip.ctxdoc"), doc);
}

fn ip_ctx_get() -> u64 {
    let doc: u64 = 0;
    let st: i32 = sa_global_u64_get(STR_PTR("ip.ctxdoc"), STR_LEN("ip.ctxdoc"), &doc);
    if st != 0 { return 0; };
    return doc;
}

fn ip_result_set(doc: u64, out: &ImageGenResult) -> void {
    let buf: u64 = 0;
    let st: i32 = sa_json_stringify(doc, &buf);
    if st != 0 || buf == 0 {
        out.body_json_ptr = PTR_NULL();
        out.body_json_len = 0;
        return;
    };
    let old: u64 = 0;
    let gst: i32 = sa_global_u64_get(STR_PTR("ip.resultbuf"), STR_LEN("ip.resultbuf"), &old);
    if gst == 0 && old != 0 {
        let f: i32 = sa_json_buffer_free(old);
    };
    let sst: i32 = sa_global_u64_set(STR_PTR("ip.resultbuf"), STR_LEN("ip.resultbuf"), buf);
    out.body_json_ptr = sa_json_buffer_data(buf);
    out.body_json_len = sa_json_buffer_len(buf);
}

fn ip_result_error(out: &ImageGenResult, msg_p: ptr, msg_l: u64, status: i32) -> void {
    let doc: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    let s1: i32 = sa_json_object_set_string(doc, STR_PTR("error"), STR_LEN("error"), msg_p, msg_l);
    ip_result_set(doc, out);
    let f: i32 = sa_json_free(doc);
    out.status = status;
}

// ---- provider helpers ----
fn ip_provider_base(provider: u64, out: &IpSmall) -> bool {
    out.len = 0;
    let bp: ptr = PTR_NULL();
    let bl: u64 = 0;
    if !ip_field_str(provider, STR_PTR("baseUrl"), STR_LEN("baseUrl"), &bp, &bl) { return false; };
    let lo: u64 = 0;
    let hi: u64 = 0;
    ip_trim_range(bp, bl, &lo, &hi);
    if hi <= lo { return false; };
    let tp: ptr = PTR_NULL();
    PTR_BYTE_ADD(tp, bp, lo);
    ip_append_small(out, tp, hi - lo);
    // strip trailing "/" run
    while out.len > 0 {
        let op: ptr = ip_small_ptr(out);
        if ip_byte(op, out.len - 1) == 47 { out.len = out.len - 1; } else { break; };
    }
    return out.len > 0;
}

fn providerBaseUrl(provider_json_ptr: ptr, provider_json_len: u64, out_ptr: ptr) -> u64 {
    let doc: u64 = ip_parse(provider_json_ptr, provider_json_len);
    let base = IpSmall { bytes: [0u8; 8192], len: 0 };
    let ok: bool = ip_provider_base(doc, &base);
    if doc != 0 { let f: i32 = sa_json_free(doc); };
    if !ok { return 0; };
    PTR_COPY_BYTES(out_ptr, ip_small_ptr(&base), base.len);
    return base.len;
}

fn shouldUseGeminiGenerateContent(baseUrl_ptr: ptr, baseUrl_len: u64) -> bool {
    if !ip_contains_ci(baseUrl_ptr, baseUrl_len, STR_PTR("generativelanguage.googleapis.com"), STR_LEN("generativelanguage.googleapis.com")) { return false; };
    if ip_ends_ci(baseUrl_ptr, baseUrl_len, STR_PTR("/openai"), STR_LEN("/openai")) { return false; };
    return true;
}

fn geminiNativeBaseUrl(provider_json_ptr: ptr, provider_json_len: u64, out_ptr: ptr) -> u64 {
    let doc: u64 = ip_parse(provider_json_ptr, provider_json_len);
    let base = IpSmall { bytes: [0u8; 8192], len: 0 };
    let ok: bool = ip_provider_base(doc, &base);
    if doc != 0 { let f: i32 = sa_json_free(doc); };
    if !ok { return 0; };
    let bp: ptr = ip_small_ptr(&base);
    // replace(/\/models\/?$/i, "") then replace(/\/openai\/?$/i, "")
    if ip_ends_ci(bp, base.len, STR_PTR("/models/"), STR_LEN("/models/")) { base.len = base.len - 8; };
    bp = ip_small_ptr(&base);
    if ip_ends_ci(bp, base.len, STR_PTR("/models"), STR_LEN("/models")) { base.len = base.len - 7; };
    bp = ip_small_ptr(&base);
    if ip_ends_ci(bp, base.len, STR_PTR("/openai/"), STR_LEN("/openai")) { base.len = base.len - 8; };
    bp = ip_small_ptr(&base);
    if ip_ends_ci(bp, base.len, STR_PTR("/openai"), STR_LEN("/openai")) { base.len = base.len - 7; };
    bp = ip_small_ptr(&base);
    let out = IpText { bytes: [0u8; 262144], len: 0 };
    if ip_ends_ci(bp, base.len, STR_PTR("/v1beta"), STR_LEN("/v1beta")) {
        ip_append(&out, bp, base.len);
    } else {
        if ip_ends_ci(bp, base.len, STR_PTR("/v1"), STR_LEN("/v1")) {
            ip_append(&out, bp, base.len - 3);
            ip_append(&out, STR_PTR("/v1beta"), STR_LEN("/v1beta"));
        } else {
            ip_append(&out, bp, base.len);
            ip_append(&out, STR_PTR("/v1beta"), STR_LEN("/v1beta"));
        };
    };
    let tp: ptr = ip_text_ptr(&out);
    PTR_COPY_BYTES(out_ptr, tp, out.len);
    return out.len;
}

// protocol name <-> code
fn ip_protocol_code(name_p: ptr, name_l: u64) -> u64 {
    if ip_eq(name_p, name_l, STR_PTR("openaiImages"), STR_LEN("openaiImages")) { return 0; };
    if ip_eq(name_p, name_l, STR_PTR("openaiImageEdits"), STR_LEN("openaiImageEdits")) { return 1; };
    if ip_eq(name_p, name_l, STR_PTR("geminiChatCompletions"), STR_LEN("geminiChatCompletions")) { return 2; };
    if ip_eq(name_p, name_l, STR_PTR("geminiGenerateContent"), STR_LEN("geminiGenerateContent")) { return 3; };
    if ip_eq(name_p, name_l, STR_PTR("deepkeyAsyncVideos"), STR_LEN("deepkeyAsyncVideos")) { return 4; };
    return 99;
}

fn ip_protocol_name(code: u64, out: &IpSmall) -> bool {
    out.len = 0;
    if code == 0 { ip_append_small(out, STR_PTR("openaiImages"), STR_LEN("openaiImages")); return true; };
    if code == 1 { ip_append_small(out, STR_PTR("openaiImageEdits"), STR_LEN("openaiImageEdits")); return true; };
    if code == 2 { ip_append_small(out, STR_PTR("geminiChatCompletions"), STR_LEN("geminiChatCompletions")); return true; };
    if code == 3 { ip_append_small(out, STR_PTR("geminiGenerateContent"), STR_LEN("geminiGenerateContent")); return true; };
    if code == 4 { ip_append_small(out, STR_PTR("deepkeyAsyncVideos"), STR_LEN("deepkeyAsyncVideos")); return true; };
    return false;
}

// generationProtocols: provider.image.protocols minus
// openaiImageEdits, as codes in order (cap 16).
struct IpCodeList { items: [u64; 16], len: u64 }

fn ip_generation_codes(provider: u64, out: &IpCodeList) -> void {
    out.len = 0;
    let image: u64 = ip_jget(provider, STR_PTR("image"), STR_LEN("image"));
    if image == 0 || sa_json_kind(image) != 7 { return; };
    let protos: u64 = ip_jget(image, STR_PTR("protocols"), STR_LEN("protocols"));
    if protos == 0 || sa_json_kind(protos) != 6 { return; };
    let cnt: u64 = 0;
    let st: i32 = sa_json_value_count(protos, &cnt);
    let i: u64 = 0;
    while i < cnt {
        let el: u64 = 0;
        let gst: i32 = sa_json_array_get(protos, i, &el);
        if gst == 0 && el != 0 && sa_json_kind(el) == 5 {
            let np: ptr = sa_json_string_ptr(el);
            let nl: u64 = sa_json_string_len(el);
            let code: u64 = ip_protocol_code(np, nl);
            if code != 1 && code != 99 && out.len < 16 {
                out.items[out.len] = code;
                out.len = out.len + 1;
            };
        };
        i = i + 1;
    }
}

fn generationProtocols(json_ptr: ptr, json_len: u64, out_ptr: ptr) -> u64 {
    let doc: u64 = ip_parse(json_ptr, json_len);
    let codes = IpCodeList { items: [0u64; 16], len: 0 };
    ip_generation_codes(doc, &codes);
    let arr: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    let i: u64 = 0;
    while i < codes.len {
        let name = IpSmall { bytes: [0u8; 8192], len: 0 };
        if ip_protocol_name(codes.items[i], &name) {
            let pst: i32 = sa_json_array_push_string(arr, ip_small_ptr(&name), name.len);
        };
        i = i + 1;
    }
    let n: u64 = ip_write_out(arr, out_ptr);
    let f1: i32 = sa_json_free(arr);
    if doc != 0 { let f2: i32 = sa_json_free(doc); };
    return n;
}

// ---- model matchers (regexes hand-scanned) ----
fn ip_is_word_or_dash(c: u8) -> bool {
    return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95 || c == 45;
}

fn isAsyncGeminiImageModel(model_ptr: ptr, model_len: u64) -> bool {
    // /^nano_banana(?:_[\w-]+)?(?:-\dK)?$/i
    if !ip_starts_ci(model_ptr, model_len, STR_PTR("nano_banana"), STR_LEN("nano_banana")) { return false; };
    let pos: u64 = 11;
    if pos < model_len && ip_byte(model_ptr, pos) == 95 {
        pos = pos + 1;
        let start: u64 = pos;
        while pos < model_len && ip_is_word_or_dash(ip_byte(model_ptr, pos)) { pos = pos + 1; }
        if pos == start { return false; };
    };
    if pos == model_len { return true; };
    // (?:-\dK)?
    if pos + 3 == model_len && ip_byte(model_ptr, pos) == 45 {
        let d: u8 = ip_byte(model_ptr, pos + 1);
        let k: u8 = ip_lower(ip_byte(model_ptr, pos + 2));
        if d >= 48 && d <= 57 && k == 107 { return true; };
    };
    return false;
}

fn isGeminiImagePreviewModel(model_ptr: ptr, model_len: u64) -> bool {
    // /^gemini-[\w.-]+-image-preview$/i
    if !ip_starts_ci(model_ptr, model_len, STR_PTR("gemini-"), STR_LEN("gemini-")) { return false; };
    if !ip_ends_ci(model_ptr, model_len, STR_PTR("-image-preview"), STR_LEN("-image-preview")) { return false; };
    let mid_start: u64 = 7;
    let mid_end: u64 = model_len - 14;
    if mid_end <= mid_start { return false; };
    let i: u64 = mid_start;
    while i < mid_end {
        let c: u8 = ip_byte(model_ptr, i);
        if !ip_is_word_or_dash(c) && c != 46 { return false; };
        i = i + 1;
    }
    return true;
}

fn ip_allowed(code: u64, configured: &IpCodeList) -> bool {
    if code == 99 || code == 1 { return false; };
    if configured.len == 0 { return true; };
    let i: u64 = 0;
    while i < configured.len {
        if configured.items[i] == code { return true; };
        i = i + 1;
    }
    return false;
}

fn selectImageGenerationProtocol(provider_json_ptr: ptr, provider_json_len: u64, model_ptr: ptr, model_len: u64, requested: u64, has_req: bool) -> u64 {
    let provider: u64 = ip_parse(provider_json_ptr, provider_json_len);
    let configured = IpCodeList { items: [0u64; 16], len: 0 };
    ip_generation_codes(provider, &configured);
    let result: u64 = 99;
    let req_code: u64 = 99;
    if has_req { req_code = requested; };
    if ip_allowed(req_code, &configured) {
        result = req_code;
    } else {
        let image: u64 = ip_jget(provider, STR_PTR("image"), STR_LEN("image"));
        let def_code: u64 = 99;
        let dp: ptr = PTR_NULL();
        let dl: u64 = 0;
        if ip_field_str(image, STR_PTR("defaultProtocol"), STR_LEN("defaultProtocol"), &dp, &dl) { def_code = ip_protocol_code(dp, dl); };
        if ip_allowed(def_code, &configured) {
            result = def_code;
        } else {
            if isAsyncGeminiImageModel(model_ptr, model_len) && ip_allowed(4, &configured) {
                result = 4;
            } else {
                if isGeminiImagePreviewModel(model_ptr, model_len) {
                    let base = IpSmall { bytes: [0u8; 8192], len: 0 };
                    let has_base: bool = ip_provider_base(provider, &base);
                    let use_gc: bool = false;
                    if has_base { use_gc = shouldUseGeminiGenerateContent(ip_small_ptr(&base), base.len); };
                    if use_gc && ip_allowed(3, &configured) {
                        result = 3;
                    } else {
                        if ip_allowed(2, &configured) {
                            result = 2;
                        } else {
                            if ip_allowed(3, &configured) { result = 3; };
                        };
                    };
                };
                if result == 99 {
                    if ip_allowed(0, &configured) {
                        result = 0;
                    } else {
                        if configured.len > 0 {
                            result = configured.items[0];
                        } else {
                            if isAsyncGeminiImageModel(model_ptr, model_len) {
                                result = 4;
                            } else {
                                if isGeminiImagePreviewModel(model_ptr, model_len) {
                                    let base2 = IpSmall { bytes: [0u8; 8192], len: 0 };
                                    let hb2: bool = ip_provider_base(provider, &base2);
                                    if hb2 && shouldUseGeminiGenerateContent(ip_small_ptr(&base2), base2.len) { result = 3; } else { result = 2; };
                                } else {
                                    result = 0;
                                };
                            };
                        };
                    };
                };
            };
        };
    };
    if provider != 0 { let f: i32 = sa_json_free(provider); };
    return result;
}

// ---- readJson / errorText / text wrappers ----
fn ip_read_json(status: i32, text_p: ptr, text_l: u64) -> u64 {
    if text_l == 0 { return sa_json_parse(STR_PTR("{}"), STR_LEN("{}")); };
    let doc: u64 = ip_parse(text_p, text_l);
    if doc != 0 { return doc; };
    let err: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    let s1: i32 = sa_json_object_set_string(err, STR_PTR("error"), STR_LEN("error"), text_p, text_l);
    return err;
}

fn readJson(status: i32, text_ptr: ptr, text_len: u64, out_ptr: ptr) -> u64 {
    let doc: u64 = ip_read_json(status, text_ptr, text_len);
    if doc == 0 {
        // text non-empty but unparseable and the error doc failed:
        // upstream message form
        if text_len > 0 {
            PTR_COPY_BYTES(out_ptr, text_ptr, text_len);
            return text_len;
        };
        let msg = IpText { bytes: [0u8; 262144], len: 0 };
        ip_append(&msg, STR_PTR("{\"error\":\"Upstream returned "), STR_LEN("{\"error\":\"Upstream returned "));
        ip_append_i64(&msg, status as i64);
        ip_append(&msg, STR_PTR("\"}"), STR_LEN("\"}"));
        let tp: ptr = ip_text_ptr(&msg);
        PTR_COPY_BYTES(out_ptr, tp, msg.len);
        return msg.len;
    };
    let n: u64 = ip_write_out(doc, out_ptr);
    let f: i32 = sa_json_free(doc);
    return n;
}

fn ip_error_text(doc: u64, out: &IpText) -> void {
    out.len = 0;
    if doc == 0 || (sa_json_kind(doc) != 7 && sa_json_kind(doc) != 6) { return; };
    let err: u64 = ip_jget(doc, STR_PTR("error"), STR_LEN("error"));
    let mp: ptr = PTR_NULL();
    let ml: u64 = 0;
    if ip_field_str(err, STR_PTR("message"), STR_LEN("message"), &mp, &ml) {
        ip_append(out, mp, ml);
        return;
    };
    if ip_jstr(err, &mp, &ml) {
        ip_append(out, mp, ml);
        return;
    };
    if ip_field_str(doc, STR_PTR("message"), STR_LEN("message"), &mp, &ml) {
        ip_append(out, mp, ml);
        return;
    };
}

fn errorText(value_ptr: ptr, value_len: u64, out_ptr: ptr) -> u64 {
    let doc: u64 = ip_parse(value_ptr, value_len);
    let text = IpText { bytes: [0u8; 262144], len: 0 };
    ip_error_text(doc, &text);
    if doc != 0 { let f: i32 = sa_json_free(doc); };
    let tp: ptr = ip_text_ptr(&text);
    PTR_COPY_BYTES(out_ptr, tp, text.len);
    return text.len;
}

fn asRecord(value_ptr: ptr, value_len: u64, out_ptr: ptr) -> u64 {
    let doc: u64 = ip_parse(value_ptr, value_len);
    if doc == 0 || (sa_json_kind(doc) != 7 && sa_json_kind(doc) != 6) {
        if doc != 0 { let f: i32 = sa_json_free(doc); };
        PTR_COPY_BYTES(out_ptr, STR_PTR("{}"), 2);
        return 2;
    };
    let n: u64 = ip_write_out(doc, out_ptr);
    let f2: i32 = sa_json_free(doc);
    return n;
}

fn asArray(value_ptr: ptr, value_len: u64, out_ptr: ptr) -> u64 {
    let doc: u64 = ip_parse(value_ptr, value_len);
    if doc == 0 || sa_json_kind(doc) != 6 {
        if doc != 0 { let f: i32 = sa_json_free(doc); };
        PTR_COPY_BYTES(out_ptr, STR_PTR("[]"), 2);
        return 2;
    };
    let n: u64 = ip_write_out(doc, out_ptr);
    let f2: i32 = sa_json_free(doc);
    return n;
}

fn stringValue(value_ptr: ptr, value_len: u64) -> bool {
    let doc: u64 = ip_parse(value_ptr, value_len);
    if doc == 0 { return false; };
    let ok: bool = sa_json_kind(doc) == 5;
    let f: i32 = sa_json_free(doc);
    return ok;
}

fn numberValue(value: f64, is_num: bool) -> bool { return is_num; }
fn numberOption(value: f64, is_num: bool) -> bool { return is_num; }
fn stringOption(value_ptr: ptr, value_len: u64) -> bool {
    // landed existence form of the internal node check
    let doc: u64 = ip_parse(value_ptr, value_len);
    if doc == 0 { return false; };
    let ok: bool = false;
    if sa_json_kind(doc) == 5 {
        let sp: ptr = sa_json_string_ptr(doc);
        let sl: u64 = sa_json_string_len(doc);
        let lo: u64 = 0;
        let hi: u64 = 0;
        ip_trim_range(sp, sl, &lo, &hi);
        ok = hi > lo;
    };
    let f: i32 = sa_json_free(doc);
    return ok;
}

fn jsonOptions(options_ptr: ptr, options_len: u64, out_ptr: ptr) -> u64 {
    let doc: u64 = ip_parse(options_ptr, options_len);
    if doc == 0 || sa_json_kind(doc) != 7 {
        if doc != 0 { let f: i32 = sa_json_free(doc); };
        PTR_COPY_BYTES(out_ptr, STR_PTR("{}"), 2);
        return 2;
    };
    let n: u64 = ip_write_out(doc, out_ptr);
    let f2: i32 = sa_json_free(doc);
    return n;
}

// ---- image data normalization ----
fn ip_normalize_data(entry: u64) -> u64 {
    if entry == 0 { return 0; };
    let bp: ptr = PTR_NULL();
    let bl: u64 = 0;
    let has_b64: bool = false;
    if ip_field_str(entry, STR_PTR("b64_json"), STR_LEN("b64_json"), &bp, &bl) { has_b64 = true; };
    if !has_b64 && ip_field_str(entry, STR_PTR("b64Json"), STR_LEN("b64Json"), &bp, &bl) { has_b64 = true; };
    if !has_b64 && ip_field_str(entry, STR_PTR("data"), STR_LEN("data"), &bp, &bl) { has_b64 = true; };
    let up: ptr = PTR_NULL();
    let ul: u64 = 0;
    let has_raw_url: bool = false;
    if ip_field_str(entry, STR_PTR("url"), STR_LEN("url"), &up, &ul) { has_raw_url = true; };
    if !has_raw_url && ip_field_str(entry, STR_PTR("image_url"), STR_LEN("image_url"), &up, &ul) { has_raw_url = true; };
    let has_url: bool = false;
    if has_raw_url && !ip_starts_ci(up, ul, STR_PTR("data:"), STR_LEN("data:")) { has_url = true; };
    let b64_truthy: bool = has_b64 && bl > 0;
    if !has_url && !b64_truthy { return 0; };
    let doc: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    if doc == 0 { return 0; };
    if has_url {
        let s1: i32 = sa_json_object_set_string(doc, STR_PTR("url"), STR_LEN("url"), up, ul);
    };
    if b64_truthy {
        let s2: i32 = sa_json_object_set_string(doc, STR_PTR("b64Json"), STR_LEN("b64Json"), bp, bl);
    };
    let rp: ptr = PTR_NULL();
    let rl: u64 = 0;
    let has_rev: bool = false;
    if ip_field_str(entry, STR_PTR("revised_prompt"), STR_LEN("revised_prompt"), &rp, &rl) { has_rev = true; };
    if !has_rev && ip_field_str(entry, STR_PTR("revisedPrompt"), STR_LEN("revisedPrompt"), &rp, &rl) { has_rev = true; };
    if has_rev && rl > 0 {
        let s3: i32 = sa_json_object_set_string(doc, STR_PTR("revisedPrompt"), STR_LEN("revisedPrompt"), rp, rl);
    };
    return doc;
}

fn normalizeImageData(entry_json_ptr: ptr, entry_json_len: u64, out_ptr: ptr) -> u64 {
    let doc: u64 = ip_parse(entry_json_ptr, entry_json_len);
    let nd: u64 = ip_normalize_data(doc);
    if doc != 0 { let f: i32 = sa_json_free(doc); };
    if nd == 0 { return 0; };
    let n: u64 = ip_write_out(nd, out_ptr);
    let f2: i32 = sa_json_free(nd);
    return n;
}

fn ip_unique_data(arr: u64) -> u64 {
    let out: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    if arr == 0 || sa_json_kind(arr) != 6 || out == 0 { return out; };
    let cnt: u64 = 0;
    let st: i32 = sa_json_value_count(arr, &cnt);
    let seen = IpText { bytes: [0u8; 262144], len: 0 };
    let i: u64 = 0;
    while i < cnt {
        let el: u64 = 0;
        let gst: i32 = sa_json_array_get(arr, i, &el);
        if gst == 0 && el != 0 {
            let kp: ptr = PTR_NULL();
            let kl: u64 = 0;
            let has_key: bool = false;
            if ip_field_str(el, STR_PTR("url"), STR_LEN("url"), &kp, &kl) { has_key = true; };
            if !has_key && ip_field_str(el, STR_PTR("b64Json"), STR_LEN("b64Json"), &kp, &kl) { has_key = true; };
            if has_key && kl > 0 {
                // seen check: scan the seen text lines
                let sp: ptr = ip_text_ptr(&seen);
                let dup: bool = false;
                let seg: u64 = 0;
                let j: u64 = 0;
                while j <= seen.len {
                    if j == seen.len || ip_byte(sp, j) == 10 {
                        if j - seg == kl {
                            let segp: ptr = PTR_NULL();
                            PTR_BYTE_ADD(segp, sp, seg);
                            if ip_eq(kp, kl, segp, kl) { dup = true; };
                        };
                        seg = j + 1;
                    };
                    j = j + 1;
                }
                if !dup {
                    ip_append(&seen, kp, kl);
                    ip_append(&seen, STR_PTR("\n"), STR_LEN("\n"));
                    // clone el via stringify+parse (push_node would
                    // adopt it out of the caller's array)
                    let text = IpText { bytes: [0u8; 262144], len: 0 };
                    ip_doc_text(el, &text);
                    let clone: u64 = ip_parse(ip_text_ptr(&text), text.len);
                    if clone != 0 {
                        let pst: i32 = sa_json_array_push_node(out, clone);
                    };
                };
            };
        };
        i = i + 1;
    }
    return out;
}

fn uniqueImageData(data_ptr: ptr, data_len: u64, out_ptr: ptr) -> u64 {
    let doc: u64 = ip_parse(data_ptr, data_len);
    let uniq: u64 = ip_unique_data(doc);
    if doc != 0 { let f: i32 = sa_json_free(doc); };
    if uniq == 0 {
        PTR_COPY_BYTES(out_ptr, STR_PTR("[]"), 2);
        return 2;
    };
    let n: u64 = ip_write_out(uniq, out_ptr);
    let f2: i32 = sa_json_free(uniq);
    return n;
}

// ---- URL extraction ----
fn ip_is_url_delim(c: u8) -> bool {
    return c == 32 || c == 9 || c == 10 || c == 13 || c == 11 || c == 12 || c == 39 || c == 34 || c == 60 || c == 62 || c == 41;
}

fn ip_push_url(out_arr: u64, p: ptr, len: u64) -> void {
    let obj: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    if obj == 0 { return; };
    let s1: i32 = sa_json_object_set_string(obj, STR_PTR("url"), STR_LEN("url"), p, len);
    let pst: i32 = sa_json_array_push_node(out_arr, obj);
}

fn ip_extract_url_into(p: ptr, len: u64, out_arr: u64) -> void {
    let lo: u64 = 0;
    let hi: u64 = 0;
    ip_trim_range(p, len, &lo, &hi);
    if hi <= lo { return; };
    let tp: ptr = PTR_NULL();
    PTR_BYTE_ADD(tp, p, lo);
    let tl: u64 = hi - lo;
    if ip_starts_ci(tp, tl, STR_PTR("data:image/"), STR_LEN("data:image/")) || ip_starts_ci(tp, tl, STR_PTR("http://"), STR_LEN("http://")) || ip_starts_ci(tp, tl, STR_PTR("https://"), STR_LEN("https://")) {
        ip_push_url(out_arr, tp, tl);
        return;
    };
    // matchAll scan
    let i: u64 = 0;
    while i < tl {
        if ip_starts_ci(tp, tl, STR_PTR("http://"), STR_LEN("http://")) || ip_starts_ci(tp, tl, STR_PTR("https://"), STR_LEN("https://")) {
            // note: starts_ci checks at 0 — per-position check below
        };
        let is_http: bool = false;
        if i + 7 <= tl {
            let sub: ptr = PTR_NULL();
            PTR_BYTE_ADD(sub, tp, i);
            if ip_starts_ci(sub, tl - i, STR_PTR("http://"), STR_LEN("http://")) || ip_starts_ci(sub, tl - i, STR_PTR("https://"), STR_LEN("https://")) { is_http = true; };
        };
        if is_http {
            let j: u64 = i;
            while j < tl && !ip_is_url_delim(ip_byte(tp, j)) { j = j + 1; }
            let mp: ptr = PTR_NULL();
            PTR_BYTE_ADD(mp, tp, i);
            ip_push_url(out_arr, mp, j - i);
            i = j;
        } else {
            let is_data: bool = false;
            let data_end: u64 = 0;
            if i + 11 <= tl {
                let sub2: ptr = PTR_NULL();
                PTR_BYTE_ADD(sub2, tp, i);
                if ip_starts_ci(sub2, tl - i, STR_PTR("data:image/"), STR_LEN("data:image/")) {
                    let k: u64 = i + 11;
                    let mstart: u64 = k;
                    while k < tl {
                        let c: u8 = ip_lower(ip_byte(tp, k));
                        if (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 46 || c == 43 || c == 45 { k = k + 1; } else { break; };
                    }
                    if k > mstart && k + 8 <= tl {
                        let sep: ptr = PTR_NULL();
                        PTR_BYTE_ADD(sep, tp, k);
                        if ip_starts_ci(sep, tl - k, STR_PTR(";base64,"), STR_LEN(";base64,")) {
                            let q: u64 = k + 8;
                            let pstart: u64 = q;
                            while q < tl {
                                let c2: u8 = ip_byte(tp, q);
                                if (c2 >= 65 && c2 <= 90) || (c2 >= 97 && c2 <= 122) || (c2 >= 48 && c2 <= 57) || c2 == 43 || c2 == 47 || c2 == 61 { q = q + 1; } else { break; };
                            }
                            if q > pstart {
                                is_data = true;
                                data_end = q;
                            };
                        };
                    };
                };
            };
            if is_data {
                let mp2: ptr = PTR_NULL();
                PTR_BYTE_ADD(mp2, tp, i);
                ip_push_url(out_arr, mp2, data_end - i);
                i = data_end;
            } else {
                i = i + 1;
            };
        };
    }
}

fn extractUrlValue(value_ptr: ptr, value_len: u64, out_ptr: ptr) -> u64 {
    let arr: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    if arr == 0 {
        PTR_COPY_BYTES(out_ptr, STR_PTR("[]"), 2);
        return 2;
    };
    ip_extract_url_into(value_ptr, value_len, arr);
    let n: u64 = ip_write_out(arr, out_ptr);
    let f: i32 = sa_json_free(arr);
    return n;
}

// ---- recursive extraction (depth cap 32, registered) ----
fn ip_extract_into(node: u64, out_arr: u64, depth: u64) -> void {
    if depth > 32 || node == 0 { return; };
    let kind: u32 = sa_json_kind(node);
    if kind == 5 {
        let sp: ptr = sa_json_string_ptr(node);
        let sl: u64 = sa_json_string_len(node);
        ip_extract_url_into(sp, sl, out_arr);
        return;
    };
    if kind == 6 {
        let cnt: u64 = 0;
        let st: i32 = sa_json_value_count(node, &cnt);
        let i: u64 = 0;
        while i < cnt {
            let el: u64 = 0;
            let gst: i32 = sa_json_array_get(node, i, &el);
            if gst == 0 && el != 0 { ip_extract_into(el, out_arr, depth + 1); };
            i = i + 1;
        }
        return;
    };
    if kind != 7 { return; };
    let keys_count: u64 = 0;
    let kst: i32 = sa_json_value_count(node, &keys_count);
    if keys_count == 0 { return; };
    let nd: u64 = ip_normalize_data(node);
    if nd != 0 {
        let pst: i32 = sa_json_array_push_node(out_arr, nd);
    };
    // image_url
    let iu: u64 = ip_jget(node, STR_PTR("image_url"), STR_LEN("image_url"));
    if iu != 0 && sa_json_kind(iu) == 5 {
        let iup: ptr = sa_json_string_ptr(iu);
        ip_extract_url_into(iup, sa_json_string_len(iu), out_arr);
    } else {
        let np: ptr = PTR_NULL();
        let nl: u64 = 0;
        if ip_field_str(iu, STR_PTR("url"), STR_LEN("url"), &np, &nl) {
            ip_extract_url_into(np, nl, out_arr);
        };
    };
    // inlineData ?? inline_data
    let inl: u64 = ip_jget(node, STR_PTR("inlineData"), STR_LEN("inlineData"));
    if inl == 0 || sa_json_kind(inl) == 0 { inl = ip_jget(node, STR_PTR("inline_data"), STR_LEN("inline_data")); };
    let dvp: ptr = PTR_NULL();
    let dvl: u64 = 0;
    if ip_field_str(inl, STR_PTR("data"), STR_LEN("data"), &dvp, &dvl) {
        let obj: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
        if obj != 0 {
            let m1: i32 = sa_json_object_set_string(obj, STR_PTR("b64Json"), STR_LEN("b64Json"), dvp, dvl);
            let mtp: ptr = PTR_NULL();
            let mtl: u64 = 0;
            let has_mt: bool = false;
            if ip_field_str(inl, STR_PTR("mimeType"), STR_LEN("mimeType"), &mtp, &mtl) { has_mt = true; };
            if !has_mt && ip_field_str(inl, STR_PTR("mime_type"), STR_LEN("mime_type"), &mtp, &mtl) { has_mt = true; };
            if has_mt {
                let m2: i32 = sa_json_object_set_string(obj, STR_PTR("mediaType"), STR_LEN("mediaType"), mtp, mtl);
            } else {
                let m3: i32 = sa_json_object_set_string(obj, STR_PTR("mediaType"), STR_LEN("mediaType"), STR_PTR("image/png"), STR_LEN("image/png"));
            };
            let pst2: i32 = sa_json_array_push_node(out_arr, obj);
        };
    };
    // fileData ?? file_data -> fileUri ?? file_uri
    let fd: u64 = ip_jget(node, STR_PTR("fileData"), STR_LEN("fileData"));
    if fd == 0 || sa_json_kind(fd) == 0 { fd = ip_jget(node, STR_PTR("file_data"), STR_LEN("file_data")); };
    let fup: ptr = PTR_NULL();
    let ful: u64 = 0;
    let has_fu: bool = false;
    if ip_field_str(fd, STR_PTR("fileUri"), STR_LEN("fileUri"), &fup, &ful) { has_fu = true; };
    if !has_fu && ip_field_str(fd, STR_PTR("file_uri"), STR_LEN("file_uri"), &fup, &ful) { has_fu = true; };
    if has_fu {
        let obj2: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
        if obj2 != 0 {
            let u1: i32 = sa_json_object_set_string(obj2, STR_PTR("url"), STR_LEN("url"), fup, ful);
            let pst3: i32 = sa_json_array_push_node(out_arr, obj2);
        };
    };
    // descent keys
    let keys: [ptr; 7] = [STR_PTR("content"), STR_PTR("parts"), STR_PTR("candidates"), STR_PTR("message"), STR_PTR("images"), STR_PTR("output"), STR_PTR("result")];
    let klens: [u64; 7] = [STR_LEN("content"), STR_LEN("parts"), STR_LEN("candidates"), STR_LEN("message"), STR_LEN("images"), STR_LEN("output"), STR_LEN("result")];
    let k: u64 = 0;
    while k < 7 {
        let child: u64 = ip_jget(node, keys[k], klens[k]);
        if child != 0 { ip_extract_into(child, out_arr, depth + 1); };
        k = k + 1;
    }
}

fn extractImagesFromUnknown(value_ptr: ptr, value_len: u64, out_ptr: ptr) -> u64 {
    let doc: u64 = ip_parse(value_ptr, value_len);
    let arr: u64 = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    if arr == 0 {
        if doc != 0 { let f0: i32 = sa_json_free(doc); };
        PTR_COPY_BYTES(out_ptr, STR_PTR("[]"), 2);
        return 2;
    };
    if doc != 0 { ip_extract_into(doc, arr, 0); };
    let n: u64 = ip_write_out(arr, out_ptr);
    let f1: i32 = sa_json_free(arr);
    if doc != 0 { let f2: i32 = sa_json_free(doc); };
    return n;
}

// ---- normalized result assembly (context from the registry) ----
fn ip_normalized_result(raw: u64, data_arr: u64, created: f64, has_created: bool) -> u64 {
    let ctx: u64 = ip_ctx_get();
    let doc: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    if doc == 0 { return 0; };
    // data first (TS field order)
    let data_clone: u64 = 0;
    if data_arr != 0 {
        let text = IpText { bytes: [0u8; 262144], len: 0 };
        ip_doc_text(data_arr, &text);
        data_clone = ip_parse(ip_text_ptr(&text), text.len);
    };
    if data_clone != 0 {
        let s0: i32 = sa_json_object_set_node(doc, STR_PTR("data"), STR_LEN("data"), data_clone);
    };
    let vp: ptr = PTR_NULL();
    let vl: u64 = 0;
    if ip_field_str(ctx, STR_PTR("providerId"), STR_LEN("providerId"), &vp, &vl) {
        let s1: i32 = sa_json_object_set_string(doc, STR_PTR("providerId"), STR_LEN("providerId"), vp, vl);
    };
    if ip_field_str(ctx, STR_PTR("providerName"), STR_LEN("providerName"), &vp, &vl) {
        let s2: i32 = sa_json_object_set_string(doc, STR_PTR("providerName"), STR_LEN("providerName"), vp, vl);
    };
    if ip_field_str(ctx, STR_PTR("model"), STR_LEN("model"), &vp, &vl) {
        let s3: i32 = sa_json_object_set_string(doc, STR_PTR("model"), STR_LEN("model"), vp, vl);
    };
    if ip_field_str(ctx, STR_PTR("prompt"), STR_LEN("prompt"), &vp, &vl) {
        let s4: i32 = sa_json_object_set_string(doc, STR_PTR("prompt"), STR_LEN("prompt"), vp, vl);
    };
    if ip_field_str(ctx, STR_PTR("endpoint"), STR_LEN("endpoint"), &vp, &vl) {
        let s5: i32 = sa_json_object_set_string(doc, STR_PTR("endpoint"), STR_LEN("endpoint"), vp, vl);
    };
    if raw != 0 {
        let rtext = IpText { bytes: [0u8; 262144], len: 0 };
        ip_doc_text(raw, &rtext);
        let raw_clone: u64 = ip_parse(ip_text_ptr(&rtext), rtext.len);
        if raw_clone != 0 {
            let s6: i32 = sa_json_object_set_node(doc, STR_PTR("raw"), STR_LEN("raw"), raw_clone);
        };
    };
    if has_created {
        let s7: i32 = sa_json_object_set_f64(doc, STR_PTR("created"), STR_LEN("created"), created);
    };
    return doc;
}

fn ip_error_response_doc(body: u64, status: i32, endpoint_p: ptr, endpoint_l: u64) -> u64 {
    let doc: u64 = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    if doc == 0 { return 0; };
    let et = IpText { bytes: [0u8; 262144], len: 0 };
    ip_error_text(body, &et);
    if et.len > 0 {
        let s1: i32 = sa_json_object_set_string(doc, STR_PTR("error"), STR_LEN("error"), ip_text_ptr(&et), et.len);
    } else {
        let msg = IpText { bytes: [0u8; 262144], len: 0 };
        ip_append(&msg, STR_PTR("Image API failed ("), STR_LEN("Image API failed ("));
        ip_append_i64(&msg, status as i64);
        ip_append(&msg, STR_PTR(")"), STR_LEN(")"));
        let s2: i32 = sa_json_object_set_string(doc, STR_PTR("error"), STR_LEN("error"), ip_text_ptr(&msg), msg.len);
    };
    let s3: i32 = sa_json_object_set_i64(doc, STR_PTR("statusCode"), STR_LEN("statusCode"), status as i64);
    let s4: i32 = sa_json_object_set_string(doc, STR_PTR("endpoint"), STR_LEN("endpoint"), endpoint_p, endpoint_l);
    if body != 0 {
        let btext = IpText { bytes: [0u8; 262144], len: 0 };
        ip_doc_text(body, &btext);
        let clone: u64 = ip_parse(ip_text_ptr(&btext), btext.len);
        if clone != 0 {
            let s5: i32 = sa_json_object_set_node(doc, STR_PTR("raw"), STR_LEN("raw"), clone);
        };
    };
    return doc;
}

fn imageErrorResponse(body_ptr: ptr, body_len: u64, status: i32, endpoint_ptr: ptr, endpoint_len: u64, out_ptr: ptr) -> u64 {
    let body: u64 = ip_parse(body_ptr, body_len);
    let doc: u64 = ip_error_response_doc(body, status, endpoint_ptr, endpoint_len);
