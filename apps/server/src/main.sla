// mini-agent server v2: HTTP surface for the SLA Mini Agent.
// Mirrors the CXU server's role: it owns the bridge instance and
// exposes the thread/turn/item surface to the web page.
//   GET  /         -> www/index.html (the waterfall page)
//   POST /api/chat -> {"prompt": "...", "threadId": optional}
//                     streams bridge item events as SSE lines.
// One thread lives in server memory (v2); file-per-thread
// persistence is the next slice (CXU 0.1.18 shape).
// Only the module files are imported here: the shared sa_std
// declarations come in transitively through mini_bridge.sla and
// sa_vm.sla.
@import "byteseq.sa"
@import "mini_bridge.sla"
@import "agent_runtime/thread_store.sla"

struct PageBuf {
    bytes: [u8; 8192],
    len: u64,
}

fn bytes_is(p_ptr: ptr, p_len: u64, lit_ptr: ptr, lit_len: u64) -> bool {
    let slot = [0u64; 1];
    BYTES_EQ(&slot, p_ptr, p_len, lit_ptr, lit_len);
    return slot[0] == 1;
}

fn thread_id_is(th: &Thread, id_ptr: ptr, id_len: u64) -> bool {
    if th.id_len != id_len { return false; };
    let i: u64 = 0;
    let byte: u8 = 0;
    while i < id_len {
        BYTE_AT_OUT(byte, id_ptr, i);
        if th.id[i] != byte { return false; };
        i = i + 1;
    }
    return true;
}

fn send_json(req: ptr, status: u64, body_ptr: ptr, body_len: u64) -> i32 {
    let resp: ptr = PTR_NULL();
    if sa_http_server_resp_new_v2(req, status, &resp) != 0 { return 6; };
    sa_http_server_resp_add_header_v2(resp, STR_PTR("content-type"), STR_LEN("content-type"), STR_PTR("application/json"), STR_LEN("application/json"));
    let st = sa_http_server_resp_send_v2(resp, body_ptr, body_len, 5000);
    sa_http_server_resp_free_v2(resp);
    if st != 0 { return 7; };
    return 0;
}

fn serve_page(req: ptr) -> i32 {
    let path = "../web/index.html";
    let total: u64 = 0;
    if sa_std_fs_len(STR_PTR(path), STR_LEN(path), &total) != 0 { return 20; };
    if total > 8192 { return 21; };
    let fh: u64 = 0;
    if sa_std_fs_open_read(STR_PTR(path), STR_LEN(path), &fh) != 0 { return 22; };
    let page = PageBuf { bytes: [0u8; 8192], len: 0 };
    let read_n: u64 = 0;
    let rst = sa_std_fs_file_read(fh, &page.bytes, 8192, &read_n);
    sa_fs_file_close(fh);
    if rst != 0 { return 23; };
    page.len = read_n;
    let resp: ptr = PTR_NULL();
    if sa_http_server_resp_new_v2(req, 200, &resp) != 0 { return 6; };
    sa_http_server_resp_add_header_v2(resp, STR_PTR("content-type"), STR_LEN("content-type"), STR_PTR("text/html; charset=utf-8"), STR_LEN("text/html; charset=utf-8"));
    sa_http_server_resp_add_header_v2(resp, STR_PTR("cache-control"), STR_LEN("cache-control"), STR_PTR("no-cache"), STR_LEN("no-cache"));
    let st = sa_http_server_resp_send_v2(resp, &page.bytes, page.len, 5000);
    sa_http_server_resp_free_v2(resp);
    if st != 0 { return 7; };
    return 0;
}

fn handle_chat(req: ptr, th: &Thread, ev: &ByteBuf, scratch: &ByteBuf, body: &ByteBuf, res: &ByteBuf, fb: &FileBuf, child_th: &Thread, c_ev: &ByteBuf, c_scratch: &ByteBuf, c_body: &ByteBuf, c_res: &ByteBuf) -> i32 {
    let b_ptr: ptr = PTR_NULL();
    let b_len: u64 = 0;
    if sa_http_server_req_get_body(req, &b_ptr, &b_len) != 0 { return 30; };
    let doc = sa_json_parse(b_ptr, b_len);
    if doc == 0 {
        let e = "{\"error\":\"bad json\"}";
        return send_json(req, 400, STR_PTR(e), STR_LEN(e));
    };
    let p_ptr: ptr = PTR_NULL();
    let p_len: u64 = 0;
    if sa_json_object_get_string(doc, STR_PTR("prompt"), STR_LEN("prompt"), &p_ptr, &p_len) != 0 {
        let e = "{\"error\":\"missing prompt\"}";
        return send_json(req, 400, STR_PTR(e), STR_LEN(e));
    };
    let tid_ptr: ptr = PTR_NULL();
    let tid_len: u64 = 0;
    if sa_json_object_get_string(doc, STR_PTR("threadId"), STR_LEN("threadId"), &tid_ptr, &tid_len) == 0 {
        if !thread_id_is(th, tid_ptr, tid_len) {
            thread_reset(th, tid_ptr, tid_len);
            thread_load(th, fb, scratch);
        };
    };
    if th.id_len == 0 {
        thread_reset(th, STR_PTR("mini-1"), STR_LEN("mini-1"));
        thread_load(th, fb, scratch);
    };
    let sresp: ptr = PTR_NULL();
    if sa_http_server_resp_stream_new_v2(req, 200, &sresp) != 0 { return 31; };
    sa_http_server_resp_stream_add_header_v2(sresp, STR_PTR("content-type"), STR_LEN("content-type"), STR_PTR("text/event-stream"), STR_LEN("text/event-stream"));
    sa_http_server_resp_stream_add_header_v2(sresp, STR_PTR("cache-control"), STR_LEN("cache-control"), STR_PTR("no-cache"), STR_LEN("no-cache"));
    bridge_run_turn(sresp, th, ev, scratch, body, res, child_th, c_ev, c_scratch, c_body, c_res, 0, p_ptr, p_len);
    if thread_save(th, fb, scratch) != 0 {
        ev_thread_prefix(ev, th, STR_PTR("thread/saveFailed"), STR_LEN("thread/saveFailed"));
        buf_append_lit(ev, STR_PTR(",\"error\":\"persist failed\"}}"), STR_LEN(",\"error\":\"persist failed\"}}"));
        emit_ev(sresp, ev);
    };
    sa_http_server_resp_stream_end_v2(sresp, 5000);
    sa_http_server_resp_stream_free_v2(sresp);
    return 0;
}

fn main() -> i32 {
    let srv: ptr = PTR_NULL();
    if sa_http_server_new_v2(&srv) != 0 { return 2; };
    if sa_http_server_start_v2(srv, STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"), 18086) != 0 { return 3; };
    let th = Thread { msgs: [0u8; 40960], msgs_len: 0, id: [0u8; 64], id_len: 0, turn_seq: 0 };
    let ev = ByteBuf { bytes: [0u8; 40960], len: 0 };
    let scratch = ByteBuf { bytes: [0u8; 40960], len: 0 };
    let body = ByteBuf { bytes: [0u8; 40960], len: 0 };
    let res = ByteBuf { bytes: [0u8; 40960], len: 0 };
    let fb = FileBuf { bytes: [0u8; 163840], len: 0 };
    let child_th = Thread { msgs: [0u8; 40960], msgs_len: 0, id: [0u8; 64], id_len: 0, turn_seq: 0 };
    let c_ev = ByteBuf { bytes: [0u8; 40960], len: 0 };
    let c_scratch = ByteBuf { bytes: [0u8; 40960], len: 0 };
    let c_body = ByteBuf { bytes: [0u8; 40960], len: 0 };
    let c_res = ByteBuf { bytes: [0u8; 40960], len: 0 };
    hist_dir(&scratch);
    sa_fs_create_dir(&scratch.bytes, scratch.len);
    let failures: u64 = 0;
    while failures < 1000 {
        let req: ptr = PTR_NULL();
        if sa_http_server_accept_v2(srv, 30000, &req) != 0 {
            failures = failures + 1;
            continue;
        };
        failures = 0;
        let p_ptr: ptr = PTR_NULL();
        let p_len: u64 = 0;
        sa_http_server_req_get_path(req, &p_ptr, &p_len);
        let m_ptr: ptr = PTR_NULL();
        let m_len: u64 = 0;
        sa_http_server_req_get_method(req, &m_ptr, &m_len);
        if bytes_is(p_ptr, p_len, STR_PTR("/api/chat"), STR_LEN("/api/chat")) && bytes_is(m_ptr, m_len, STR_PTR("POST"), STR_LEN("POST")) {
            handle_chat(req, &th, &ev, &scratch, &body, &res, &fb, &child_th, &c_ev, &c_scratch, &c_body, &c_res);
        } else if bytes_is(p_ptr, p_len, STR_PTR("/"), STR_LEN("/")) || bytes_is(p_ptr, p_len, STR_PTR("/index.html"), STR_LEN("/index.html")) {
            serve_page(req);
        } else {
            let e = "{\"error\":\"not found\"}";
            send_json(req, 404, STR_PTR(e), STR_LEN(e));
        };
        sa_http_server_req_free_v2(req);
    }
    return 4;
}
