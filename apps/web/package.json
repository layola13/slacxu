{
  "name": "@codex-ui/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/build.ts && bun scripts/preview.ts",
    "build": "tsc -p tsconfig.json --noFallthroughCasesInSwitch --noImplicitReturns --noImplicitOverride && bun scripts/build.ts && node ../../scripts/compress-web-assets.mjs dist",
    "build:node": "tsc -p tsconfig.json --noFallthroughCasesInSwitch --noImplicitReturns --noImplicitOverride && node scripts/build-node.mjs && node ../../scripts/compress-web-assets.mjs dist",
    "typecheck": "tsc -p tsconfig.json --noEmit --noFallthroughCasesInSwitch --noImplicitReturns --noImplicitOverride",
    "lint": "tsc -p tsconfig.json --noEmit --noFallthroughCasesInSwitch --noImplicitReturns --noImplicitOverride",
    "preview": "bun scripts/preview.ts"
  },
  "dependencies": {
    "@codex-ui/shared": "file:../../packages/shared",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@git-diff-view/file": "^0.1.7",
    "@git-diff-view/react": "^0.1.7",
    "@monaco-editor/react": "^4.7.0",
    "@mui/icons-material": "^7.3.5",
    "@mui/material": "^7.3.5",
    "@tanstack/react-virtual": "^3.14.6",
    "@types/three": "^0.185.1",
    "driver.js": "^1.8.0",
    "marked": "^18.0.6",
    "monaco-editor": "^0.55.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-resizable-panels": "^4.12.2",
    "three": "^0.185.1",
    "xterm": "^5.3.0",
    "@xterm/addon-fit": "^0.11.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3"
  }
}
