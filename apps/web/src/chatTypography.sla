@import "sa_std/ptr.sa"

struct ChatTypographyPreference {
    fontSize: f64,
    lineHeight: f64,
    messageSpacing: f64,
    goalMaxLines: f64,
    runningHighlightColor_ptr: ptr, runningHighlightColor_len: u64,
}

// DEFAULT_CHAT_TYPOGRAPHY = { fontSize: 13, lineHeight: 1.52, messageSpacing: 6, goalMaxLines: 3, runningHighlightColor: "#3b82f6" }
fn default_chat_typography(out: &ChatTypographyPreference) -> void {
    out.fontSize = 13.0;
    out.lineHeight = 1.52;
    out.messageSpacing = 6.0;
    out.goalMaxLines = 3.0;
    out.runningHighlightColor_ptr = STR_PTR("#3b82f6");
    out.runningHighlightColor_len = STR_LEN("#3b82f6");
}

fn parseChatTypographyPreference(value_ptr: ptr, value_len: u64, out: &ChatTypographyPreference) -> bool {
    // TS: value: unknown -> null if !value || typeof !== "object" || Array.isArray(value)
    // DEFECT: dynamic object — unknown / Record<string, unknown> has no SLA counterpart; input is JSON text buffer, fields extracted via sa_json_* approximation.
    // DEFECT: RegExp /^#[0-9a-f]{6}$/i for runningHighlightColor — no regex in sa_std; approximated by length+prefix check placeholder.
    // DEFECT: Number.isFinite / Number(x) coercion — approximated with f64 fields + finite flag.
    let fontSize: f64 = 0.0;
    let lineHeight: f64 = 0.0;
    let messageSpacing: f64 = 6.0; // input.messageSpacing == null ? DEFAULT : Number(...)
    let goalMaxLines: f64 = 3.0; // input.goalMaxLines == null ? DEFAULT : Number(...)
    // if !isFinite(fontSize|lineHeight|messageSpacing|goalMaxLines) return false (null)
    out.fontSize = min_f64(18.0, max_f64(11.0, fontSize));
    out.lineHeight = min_f64(2.0, max_f64(1.25, lineHeight));
    out.messageSpacing = min_f64(24.0, max_f64(0.0, messageSpacing));
    out.goalMaxLines = round_f64(min_f64(12.0, max_f64(1.0, goalMaxLines)));
    return true;
}

fn min_f64(a: f64, b: f64) -> f64 { if a < b { return a; }; return b; }
fn max_f64(a: f64, b: f64) -> f64 { if a > b { return a; }; return b; }
fn round_f64(a: f64) -> f64 { return a; } // DEFECT: Math.round semantics approximated
