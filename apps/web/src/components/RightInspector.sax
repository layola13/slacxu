            borderColor: "#1D4ED8",
            position: "relative",
            boxShadow: "0 18px 34px rgba(37,99,235,0.32)",
            "&:before": {
              content: '""',
              position: "absolute",
              left: 20,
              right: 20,
              top: 26,
              height: 34,
              borderRadius: 2,
              bgcolor: "#0F172A"
            },
            "&:after": {
