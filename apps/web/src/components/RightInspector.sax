}

</Component>

<Component name="AuditPanel">
  <state>
    busy: bool
  </state>
  // DEFECT: SAX: no behavior counterpart — hooks/handlers/derived values below preserved verbatim as comments (source order).
  // events,
  // onReload
  // }: {
  // events: DangerousPermissionAuditEvent[];
  // onReload: () => Promise<void>;
  // }) {
  // const [busy, setBusy] = useState(false);
  // DEFECT: SAX: no behavior counterpart — conditional/list rendering and {expr} below kept verbatim, annotated with bind comments.
    <Paper variant="outlined" sx={{ p: 1.5 }}>
      <Stack direction="row" alignItems="center" spacing={1} sx={{ mb: 1 }}>
      <!-- bind: 1 -->
        <SecurityIcon fontSize="small" color={events.length ? "warning" : "inherit"} />
        <!-- bind: events.length ? "warning" : "inherit" -->
        <Typography variant="subtitle2" sx={{ fontWeight: 750, flex: 1 }}>
          Dangerous permission audit
        </Typography>
        <Chip size="small" label={events.length} color={events.length ? "warning" : "default"} />
        <!-- bind: events.length -->
        <!-- bind: events.length ? "warning" : "default" -->
        <Button
          size="small"
          startIcon={<RefreshIcon />}
          <!-- bind: <RefreshIcon /> -->
          disabled={busy}
          <!-- bind: busy -->
          onClick={async () => {
            setBusy(true);
            try {
              await onReload();
            } finally {
              setBusy(false);
            }
          }}
        >
          Refresh
        </Button>
      </Stack>
      {events.length === 0 && <Typography color="text.secondary">No dangerous permission sessions recorded.</Typography>}
      <!-- bind: events.length === 0 && <Typography color="text.secondary">No dangerous permissio -->
      <Stack spacing={1}>
      <!-- bind: 1 -->
        {events.slice(0, 5).map((event) => (
        <!-- bind: events.slice(0, 5).map((event) => ( -->
          <Box key={event.id} sx={{ borderTop: "1px solid", borderColor: "divider", pt: 1 }}>
          <!-- bind: event.id -->
            <Stack direction="row" spacing={1} alignItems="center">
            <!-- bind: 1 -->
              <Chip size="small" color={event.severity === "critical" ? "error" : "warning"} label={event.severity} />
              <!-- bind: event.severity === "critical" ? "error" : "warning" -->
              <!-- bind: event.severity -->
              <Typography variant="caption" sx={{ flex: 1, overflowWrap: "anywhere" }}>
                {event.method} {event.model ? `- ${event.model}` : ""}
                <!-- bind: event.method} {event.model ? `- ${event.model}` : "" -->
              </Typography>
            </Stack>
            <Typography variant="caption" color="text.secondary" sx={{ display: "block", mt: 0.5, overflowWrap: "anywhere" }}>
              {formatAuditTime(event.createdAt)} {event.cwd ? `- ${event.cwd}` : ""} {event.threadId ? `- ${event.threadId}` : ""}
              <!-- bind: formatAuditTime(event.createdAt)} {event.cwd ? `- ${event.cwd}` : ""} {event.thr -->
            </Typography>
            <Typography variant="caption" color="text.secondary" sx={{ display: "block", overflowWrap: "anywhere" }}>
              {event.reasons.join(", ")}
              <!-- bind: event.reasons.join(", ") -->
              {event.inputSummary ? ` - input ${event.inputSummary.items} items (${event.inputSummary.textItems} text, ${event.inputSummary.imageItems} images, ${event.inputSummary.mentionItems} mentions)` : ""}
              <!-- bind: event.inputSummary ? ` - input ${event.inputSummary.items} items (${event.inputS -->
            </Typography>
          </Box>
        ))}
      </Stack>
    </Paper>
  );
}

</Component>

