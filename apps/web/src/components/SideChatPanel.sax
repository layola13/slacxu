              </Tooltip>
              <Box sx={{ flex: 1, minWidth: 8 }} /> <!-- bind: flex: 1, minWidth: 8 -->
              {sideModels.length > 0 ? ( <!-- DEFECT: SAX: no behavior counterpart | conditional rendering -->
                <Select
                  size="small"
                  variant="standard"
                  data-testid="sidechat-model-select"
                  aria-label="Side chat model"
                  value={sideModels.some((entry) => entry.value === tabModel) ? tabModel : ""} <!-- bind: sideModels.some((entry) => entry.value === tabModel) ? tabModel : "" -->
                  displayEmpty
                  disabled={!connected} <!-- bind: !connected -->
                  onChange={(event) => { <!-- bind: onChange handler (multi-line) --> <!-- DEFECT: SAX: no behavior counterpart | event handler -->
                    if (activeTab) onModelChange(activeTab.id, String(event.target.value ?? ""));
                  }}
                  sx={{ maxWidth: { xs: 116, sm: 210 }, fontSize: 12 }} <!-- bind: xs: 116, sm: 210 -->
                >
                  {sideModels.map((entry) => ( <!-- DEFECT: SAX: no behavior counterpart | list rendering (.map) -->
                    <MenuItem key={entry.value} value={entry.value}> <!-- bind: entry.value --> <!-- bind: entry.value -->
                      {entry.label} <!-- bind: entry.label -->
                    </MenuItem>
                  ))}
                </Select>
              ) : (
                <Typography variant="caption" color="text.secondary" noWrap sx={{ maxWidth: { xs: 116, sm: 210 } }}> <!-- bind: xs: 116, sm: 210 -->
                  {modelLabel || "Model"} <!-- bind: modelLabel || "Model" -->
                </Typography>
              )}
              <Typography variant="caption" color="text.secondary" noWrap>
                {reasoningLabel}
              </Typography>
              <Tooltip title="Send side chat message">
                <span>
                  <IconButton
                    color="primary"
                    aria-label="Send side chat message"
                    disabled={!canSend} <!-- bind: !canSend -->
                    onClick={^onSend} <!-- bind: onClick={() => onSend(activeTab.id, activeTab.draft)} -->
                    sx={{
                      bgcolor: "action.selected",
                      "&:hover": { bgcolor: "action.hover" } <!-- bind: bgcolor: "action.hover" -->
                    }}
                  >
                    <SendIcon fontSize="small" />
                  </IconButton>
                </span>
              </Tooltip>
            </Stack>
          </Paper>
        </Box>
      )}
    </Box>
  );
  // DEFECT: SAX: no behavior counterpart | }

</Component>

