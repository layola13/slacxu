// ---- module-level const/data: TERMINAL_ESC (source lines 180-184) ----
// const TERMINAL_ESC = String.fromCharCode(27);
//
// // 显示侧 ANSI 清洗：远端输出难免夹带颜色/光标/OSC 序列，<pre> 不解释它们，
// // 直接渲染就是 `[?2004h` / `[01;34m` 乱码。这里只做展示清洗，不改原始 output。
// // 常驻 PTY 页签走 xterm.js 真渲染，不需要清洗。

fn stripTerminalAnsi() {  // source signature: export function stripTerminalAnsi(text: string): string {
  // DEFECT: SAX: no behavior counterpart | export function stripTerminalAnsi(text: string): string {
  // DEFECT: SAX: no behavior counterpart | const oscSequence = new RegExp(`${TERMINAL_ESC}\\][^\\x07${TERMINAL_ESC}]*(?:\\x07|${TERMINAL_ESC}\\\\)`, "g");
  // DEFECT: SAX: no behavior counterpart | const csiSequence = new RegExp(`${TERMINAL_ESC}\\[[0-9;?]*[ -/]*[@-~]`, "g");
  // DEFECT: SAX: no behavior counterpart | const residueControls = new RegExp(`${TERMINAL_ESC}|[\\x00-\\x08\\x0B\\x0C\\x0E-\\x1F\\x7F]`, "g");
  // DEFECT: SAX: no behavior counterpart | return text.replace(oscSequence, "").replace(csiSequence, "").replace(residueControls, "");
  // DEFECT: SAX: no behavior counterpart | }
}

