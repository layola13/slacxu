// Converted 1:1 from apps/web/src/components/chatgpt-shell/chatgpt-mui-theme.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "sa_std/string.sa"

// Source doc comment preserved: chatgptMuiTheme is a scoped MUI Theme override used only inside
// <ChatGptShell>. The base theme does not know the "chatgpt" ThemeId, so protected
// <ChatWaterfall>/<ChatRow> components resolving theme.palette.* would leak the default divider
// rgba(227,227,227,0.24) instead of the official ChatGPT token border (oklab 12% of #0d0d0d).
// This unit only overlays palette fields via createTheme(base, overrides); values reverse-engineered
// from the official Codex desktop bundle and chatgpt-tokens.css (--color-token-*):
//   foreground #0d0d0d -> text.primary; text-secondary 65% -> #676767 (declared constant below is
//   #616161 per source); bg-primary #ffffff -> background.paper/.default; border-heavy 12% oklab
//   -> palette.divider; list-hover 4% black -> action.hover.

// DEFECT: MUI createTheme/Theme object (dynamic nested object) has no SLA counterpart ->
// theme represented as JSON text buffer fields in the struct below.
struct ChatgptMuiTheme {
    json_ptr: ptr, json_len: u64,
}

const CHATGPT_FOREGROUND_PTR: ptr = STR_PTR("#0D0D0D");
const CHATGPT_FOREGROUND_LEN: u64 = 7;
const CHATGPT_TEXT_SECONDARY_PTR: ptr = STR_PTR("#616161");
const CHATGPT_TEXT_SECONDARY_LEN: u64 = 7;
const CHATGPT_BORDER_HEAVY_BASE_PTR: ptr = STR_PTR("#0D0D0D");
const CHATGPT_BORDER_HEAVY_BASE_LEN: u64 = 7;
const CHATGPT_LIST_HOVER_BASE_PTR: ptr = STR_PTR("#000000");
const CHATGPT_LIST_HOVER_BASE_LEN: u64 = 7;

// DEFECT: MUI alpha(color, opacity) color computation -> precomputed rgba literal in repair phase.
fn alpha_stub(color_ptr: ptr, color_len: u64, opacity_milli: u64, out_ptr: ptr, out_cap: u64) -> u64 {
    return 0;
}

// chatgptMuiTheme palette (source order): mode "light";
// primary {main #0D0D0D, light #3D3D3D, dark #000000, contrastText #FFFFFF};
// secondary {main #676767, light #9A9A9A, dark #3E3E3E, contrastText #FFFFFF};
// info #00B8D9; success #22C55E; warning #FFAB00; error #FF5630;
// background {default #FFFFFF, paper #FFFFFF};
// text {primary CHATGPT_FOREGROUND, secondary CHATGPT_TEXT_SECONDARY};
// divider alpha(#0D0D0D, 0.12); action {hover alpha(#000000,0.04), selected alpha(#000000,0.08),
//   disabled alpha(#0D0D0D,0.38), disabledBackground alpha(#0D0D0D,0.12)};
// shape {borderRadius 10};
// typography fontFamily "Plus Jakarta Sans","Manrope","JetBrains Mono",Inter,"DM Sans",ui-sans-serif,...
fn chatgptMuiTheme_build(out: &ChatgptMuiTheme) -> void {
    // DEFECT: dynamic object -> JSON text buffer assembly in repair phase.
    out.json_len = 0;
}

// chatgptDividerColor = alpha(CHATGPT_BORDER_HEAVY_BASE, 0.12)
const CHATGPT_DIVIDER_COLOR_ALPHA_MILLI: u64 = 120;
