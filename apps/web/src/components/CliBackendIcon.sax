// Converted 1:1 from apps/web/src/components/CliBackendIcon.tsx (CXU plugins @ f2cb649d).
// RE-CONVERTED to the react composition dialect by Agent BK (phase-2 batch, 2026-10-28):
// compiles via `sa react build --include mui/material.sax --include mui/icons_material.sax`.
// TSX structure: CliBackendIcon derives plugin = cliPlugin(cliPluginId(normalizeThreadCliBackend(cliBackend)))
// (registry lookup — logic layer, no SAX counterpart; the derived values arrive as state slots below),
// then branches on plugin.icon:
//   branch A (src:26-38): !plugin.icon -> monogram <Box component="span"> with text plugin.label.slice(0,1).toUpperCase()
//   branch B (src:39-49): plugin.icon  -> <Box component="img" src={plugin.icon} alt={`${plugin.label} CLI`} />
//   both branches: return label ? <Tooltip title={label}>{branch}</Tooltip> : branch  (src:38,49)
// DEFECT (bridge item, FIX_FRONTEND_PHASE2 §3.5.2): the react dialect has no element-level conditional
// mount form, so the branch selection itself cannot be expressed. Both branch subtrees are converted
// below as sibling components (CliBackendIconMonogram / CliBackendIconImage); the main component mounts
// branch B wrapped in Tooltip (the label-present form). The monogram text derivation
// (label.slice(0,1).toUpperCase()) and the img alt template (`${plugin.label} CLI`) are value
// derivations with no dialect form — they arrive precomputed in the monogram / plugin_label slots.
// DEFECT: sx objects (width/height/flex/display/... on both Box branches) have no slot in
// material.sax (bridge item §3.5.3, sx degradation) — dropped here, sizes carried by the size slot only.
// DEFECT: aria-hidden={label ? undefined : true} — conditional attribute omission has no form; registered.

<Component name="CliBackendIconMonogram">
  <state>
    monogram = alloc 8
    monogram_len = 0
    size = 16
  </state>

  <Box component="span">
    {monogram}
  </Box>

  !monogram !monogram_len !size
</Component>

<Component name="CliBackendIconImage">
  <state>
    icon = alloc 256
    icon_len = 0
    plugin_label = alloc 64
    plugin_label_len = 0
    size = 16
  </state>

  <Box component="img" src={icon} alt={plugin_label} />

  !icon !icon_len !plugin_label !plugin_label_len !size
</Component>

<Component name="CliBackendIcon">
  <state>
    cli_backend = alloc 64
    cli_backend_len = 0
    label = alloc 128
    label_len = 0
    size = 16
    icon = alloc 256
    icon_len = 0
    plugin_label = alloc 64
    plugin_label_len = 0
  </state>

  <Tooltip title={label}>
    <CliBackendIconImage icon={icon} plugin_label={plugin_label} size={size} />
  </Tooltip>

  !cli_backend !cli_backend_len !label !label_len !size !icon !icon_len !plugin_label !plugin_label_len
</Component>
