                    {skillPreviewByKey[previewKey]}
                    <!-- bind: skillPreviewByKey[previewKey] -->
                  </Typography>
                )}
              </Box>
            );
          })}
        </Stack>
      )}
    </Box>
  );
}

</Component>

<Component name="McpSettings">
  <state>
    toolArgs: string // DEFECT: dynamic object state -> JSON buffer
    toolResults: string // DEFECT: dynamic object state -> JSON buffer
    toolErrors: string // DEFECT: dynamic object state -> JSON buffer
    callingTool: string // DEFECT: string | null state -> JSON buffer
