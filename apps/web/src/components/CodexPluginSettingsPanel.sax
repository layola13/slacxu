  // setToolResults((current) => ({ ...current, [key]: prettyJson(result) }));
  // } catch (error) {
  // setToolErrors((current) => ({ ...current, [key]: error instanceof Error ? error.message : String(error) }));
  // } finally {
  // setCallingTool(null);
  // }
