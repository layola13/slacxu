                <!-- bind: marketplace -->
                plugin={plugin}
                <!-- bind: plugin -->
                featured={tooling.featuredPluginIds.includes(plugin.id)}
                <!-- bind: tooling.featuredPluginIds.includes(plugin.id) -->
