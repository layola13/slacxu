        <!-- bind: app.id -->
          <AppSummaryRow app={app} t={t} />
          <!-- bind: app -->
          <!-- bind: t -->
        </Paper>
      ))}
    </Stack>
  );
}

</Component>

<Component name="MarketplaceHeader">
  // DEFECT: SAX: no behavior counterpart — conditional/list rendering and {expr} below kept verbatim, annotated with bind comments.
    <Stack direction={{ xs: "column", sm: "row" }} spacing={1} alignItems={{ xs: "stretch", sm: "center" }}>
    <!-- bind: 1 -->
      <Box sx={{ flex: 1, minWidth: 0 }}>
        <Typography variant="subtitle2" sx={{ fontWeight: 800, overflowWrap: "anywhere" }}>
          {marketplace.displayName ?? marketplace.name}
          <!-- bind: marketplace.displayName ?? marketplace.name -->
        </Typography>
        {marketplace.path && (
        <!-- bind: marketplace.path && ( -->
          <Typography variant="caption" color="text.secondary" sx={{ overflowWrap: "anywhere" }}>
            {marketplace.path}
            <!-- bind: marketplace.path -->
          </Typography>
        )}
      </Box>
      <Chip size="small" label={t("settings.plugins.count.plugins", { count: marketplace.plugins.length })} />
    </Stack>
  );
}

</Component>

