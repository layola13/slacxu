// Converted 1:1 from apps/web/src/components/AuthScreens.tsx (CXU plugins @ f2cb649d).
// RE-CONVERTED to the react composition dialect by Agent BK (phase-2 batch, 2026-10-28):
// compiles via `sa react build --include mui/material.sax --include mui/icons_material.sax`.
// Source declarations in order: AuthLoadingScreen (src:9), LoginScreen (src:23).
// LoginScreen behavior registrations (hooks/logic have no SAX behavior counterpart):
// - useI18n t() calls (src:47 et al.): i18n lookup is a function call, not a state value —
//   every t("auth.*") string is carried by a dedicated *_label / *_title state slot below and
//   the key is noted in comments; the mode-dependent key ternaries (src:190, 281-283) select
//   among those slots at the logic layer, not in the element tree.
// - useState fields (src:48-63) map to the state slots of LoginScreen; the authConfig object
//   (src:59-63) is decomposed into registration_enabled / captcha_enabled / totp_enabled i1
//   slots with the TSX initial values (false / true / true). The initial email value
//   "admin@example.com" (src:49) has no string-slot initializer form in the dialect — registered.
// - refreshCaptcha (src:65) and the mount useEffect (src:83) are async host fetches
//   (fetchCaptcha / fetchPublicAuthConfig from state/codexClient) — no counterpart; the
//   refresh_captcha handler is structure-only.
// - The form onSubmit body (src:145-178) is async prop-callback logic (onSubmit / onRegister /
//   onLogin2fa, 2FA pending-token flow, error mapping) — no counterpart; submit_form only
//   prevents the native submit. captchaPayload derivation (src:96) is logic-layer.
// DEFECT (bridge item, FIX_FRONTEND_PHASE2 §3.5.2 — no element-level conditional form):
// - mode === "2fa" ? <2FA branch> : <login/register branch> (src:196-286): the main component
//   mounts the login/register branch (the TSX initial mode, src:48); the 2FA branch subtree is
//   converted in full as the sibling component LoginTwoFaBranch below, not mounted.
// - (error || localError) && <Alert> (src:192): Alert is mounted; its text is the local_error
//   slot (the `localError || error` fallback expression is logic-layer, registered).
// - mode === "register" username field (src:228): converted as sibling LoginRegisterField.
// - authConfig.captchaEnabled ? <captcha block> : null (src:234): captchaEnabled initial is
//   true (src:61), so the block is mounted in the main component; inside it, the three-way
//   conditional (captchaSvg innerHTML / captchaPrompt text / fallback caption, src:259-279)
//   cannot be expressed — dangerouslySetInnerHTML has no counterpart at all; the mounted
//   content is the fallback caption branch, the other two are registered here.
// - authConfig.registrationEnabled ? <mode toggle> : null (src:288): initial is false
//   (src:60); converted as sibling LoginModeToggle, not mounted.
// DEFECT (bridge item §3.5.3): all sx objects (layout grids, theme-function backgrounds,
// backdrop filters, nested "& svg" selectors) have no slot in material.sax — dropped,
// registered here. inputProps objects (src:214, 232) likewise have no slot — dropped.

<Component name="AuthLoadingScreen">
  <Box>
    <Stack spacing={2} alignItems="center">
      <CircularProgress size={30} />
      <Typography variant="body2" color="text.secondary">
        Checking session
      </Typography>
    </Stack>
  </Box>
</Component>

<Component name="LoginScreen">
  <state>
    mode = alloc 16
    mode_len = 0
    email = alloc 128
    email_len = 0
    password = alloc 128
    password_len = 0
    captcha_id = alloc 64
    captcha_id_len = 0
    captcha_answer = alloc 64
    captcha_answer_len = 0
    local_error = alloc 512
    local_error_len = 0
    error = alloc 512
    error_len = 0
    submitting = 0 as i1
    registration_enabled = 0 as i1
    captcha_enabled = 1 as i1
    totp_enabled = 1 as i1
    auth_title = alloc 128
    auth_title_len = 0
    email_label = alloc 128
    email_label_len = 0
    password_label = alloc 128
    password_label_len = 0
    captcha_label = alloc 128
    captcha_label_len = 0
    captcha_placeholder = alloc 128
    captcha_placeholder_len = 0
    refresh_captcha_label = alloc 128
    refresh_captcha_label_len = 0
    submit_label = alloc 128
    submit_label_len = 0
  </state>

  <Box>
    <Box component="form" onSubmit={submit_form}>
      <Stack spacing={2}>
        <Box>
          <Typography variant="h4">
            codex-ultra
          </Typography>
          <Typography color="text.secondary">
            {auth_title}
          </Typography>
        </Box>

        <Alert severity="error" variant="outlined">
          {local_error}
        </Alert>

        <TextField id="login-email" size="small" label={email_label} value={email} onChange={sync_email} autoComplete="username" required />
        <TextField id="login-password" size="small" type="password" label={password_label} value={password} onChange={sync_password} autoComplete="current-password" required />

        <Stack spacing={1}>
          <Stack direction="row" spacing={1} alignItems="center">
            <Box role="img" onClick={refresh_captcha}>
              <Typography variant="caption">
                {refresh_captcha_label}
              </Typography>
            </Box>
            <Button size="small" variant="outlined" onClick={refresh_captcha}>
              {refresh_captcha_label}
            </Button>
          </Stack>
          <TextField id="login-captcha" size="small" label={captcha_label} value={captcha_answer} onChange={sync_captcha_answer} placeholder={captcha_placeholder} required />
        </Stack>

        <Button type="submit" variant="contained" disabled={submitting}>
          {submit_label}
        </Button>
      </Stack>
    </Box>
  </Box>

  @submit_form:
  L_ENTRY:
    call @sax_event_prevent_default()
    ret

  @sync_email:
  L_ENTRY:
    email = load state+LoginScreen_email as ptr
    len = call @sax_event_target_value(*email, 128)
    store state+LoginScreen_email_len, len as i64
    call @render()
    ret

  @sync_password:
  L_ENTRY:
    password = load state+LoginScreen_password as ptr
    len = call @sax_event_target_value(*password, 128)
    store state+LoginScreen_password_len, len as i64
    call @render()
    ret

  @sync_captcha_answer:
  L_ENTRY:
    captcha_answer = load state+LoginScreen_captcha_answer as ptr
    len = call @sax_event_target_value(*captcha_answer, 64)
    store state+LoginScreen_captcha_answer_len, len as i64
    call @render()
    ret

  @refresh_captcha:
  L_ENTRY:
    ret

  !mode !mode_len !email !email_len !password !password_len !captcha_id !captcha_id_len !captcha_answer !captcha_answer_len !local_error !local_error_len !error !error_len !submitting !registration_enabled !captcha_enabled !totp_enabled !auth_title !auth_title_len !email_label !email_label_len !password_label !password_label_len !captcha_label !captcha_label_len !captcha_placeholder !captcha_placeholder_len !refresh_captcha_label !refresh_captcha_label_len !submit_label !submit_label_len
</Component>

<Component name="LoginTwoFaBranch">
  <state>
    totp_code = alloc 16
    totp_code_len = 0
    submitting = 0 as i1
    totp_hint = alloc 256
    totp_hint_len = 0
    totp_code_label = alloc 128
    totp_code_label_len = 0
    verify_label = alloc 128
    verify_label_len = 0
    back_label = alloc 128
    back_label_len = 0
  </state>

  <Typography variant="body2" color="text.secondary">
    {totp_hint}
  </Typography>
  <TextField id="login-totp" size="small" label={totp_code_label} value={totp_code} onChange={sync_totp} />
  <Button type="submit" variant="contained" disabled={submitting}>
    {verify_label}
  </Button>
  <Button size="small" onClick={back_to_login}>
    {back_label}
  </Button>

  @sync_totp:
  L_ENTRY:
    totp_code = load state+LoginTwoFaBranch_totp_code as ptr
    len = call @sax_event_target_value(*totp_code, 16)
    store state+LoginTwoFaBranch_totp_code_len, len as i64
    call @render()
    ret

  @back_to_login:
  L_ENTRY:
    ret

  !totp_code !totp_code_len !submitting !totp_hint !totp_hint_len !totp_code_label !totp_code_label_len !verify_label !verify_label_len !back_label !back_label_len
</Component>

<Component name="LoginRegisterField">
  <state>
    username = alloc 128
    username_len = 0
    username_label = alloc 128
    username_label_len = 0
  </state>

  <TextField id="login-username" size="small" label={username_label} value={username} onChange={sync_username} />

  @sync_username:
  L_ENTRY:
    username = load state+LoginRegisterField_username as ptr
    len = call @sax_event_target_value(*username, 128)
    store state+LoginRegisterField_username_len, len as i64
    call @render()
    ret

  !username !username_len !username_label !username_label_len
</Component>

<Component name="LoginModeToggle">
  <state>
    toggle_label = alloc 128
    toggle_label_len = 0
  </state>

  <Button size="small" onClick={toggle_mode}>
    {toggle_label}
  </Button>

  @toggle_mode:
  L_ENTRY:
    ret

  !toggle_label !toggle_label_len
</Component>
