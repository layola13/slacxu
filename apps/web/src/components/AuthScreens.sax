<Component name="AuthLoadingScreen">
  <state>
    mode: string
    email: string
    password: string
    username: string
    captchaId: string
    captchaSvg: string
    captchaPrompt: string
    captchaAnswer: string
    totpCode: string
    pendingToken: string
    authConfig: string
    localError: string
  </state>

      <Box
        sx={{
          minHeight: "100dvh",
          display: "grid",
          placeItems: "center",
          bgcolor: "background.default",
          color: "text.primary"
        }}
      >
        <Stack spacing=<!-- bind: 2 --> alignItems="center">
          <CircularProgress size=<!-- bind: 30 --> />
          <Typography variant="body2" color="text.secondary">
            Checking session
          </Typography>
        </Stack>
      </Box>
      <Box
        sx={{
          minHeight: "100vh",
          display: "grid",
          placeItems: "center",
          px: 2,
          background: (theme: Theme) =>
            theme.palette.mode === "dark"
              ? "radial-gradient(circle at top, rgba(56,189,248,0.12), transparent 40%), #0b1220"
              : "radial-gradient(circle at top, rgba(14,165,233,0.12), transparent 40%), #f4f7fb"
        }}
      >
        <Box
          component="form"
          onSubmit={(event: ReactFormEvent<HTMLFormElement>) => {
            event.preventDefault();
            void (async () => {
              setLocalError(null);
              try {
                if (mode === "2fa") {
                  await onLogin2fa?.(pendingToken, totpCode.trim());
                  return;
                }
                if (mode === "register") {
                  await onRegister?.({
                    email: email.trim(),
                    password,
                    username: username.trim() || undefined,
                    captchaId: captchaPayload?.captchaId,
                    captchaAnswer: captchaPayload?.captchaAnswer
                  });
                  setMode("login");
                  await refreshCaptcha();
                  return;
                }
                const result = await onSubmit(email.trim(), password, captchaPayload);
                if (result?.requires_2fa && result.pendingToken) {
                  setPendingToken(result.pendingToken);
                  setMode("2fa");
                  setTotpCode("");
                  return;
                }
              } catch (err) {
                setLocalError(err instanceof Error ? err.message : String(err));
                setCaptchaAnswer("");
                void refreshCaptcha().catch(() => <!-- bind:  -->);
              }
            })();
          }}
          sx={{
            width: "100%",
            maxWidth: 440,
            p: 3,
            borderRadius: 3,
            border: "1px solid",
            borderColor: "divider",
            bgcolor: (theme: Theme) => (theme.palette.mode === "dark" ? "rgba(15,23,42,0.88)" : "rgba(255,255,255,0.92)"),
            backdropFilter: "blur(16px)",
            boxShadow: 8
          }}
        >
          <Stack spacing=<!-- bind: 2 -->>
            <Box>
              <Typography variant="h4" sx=<!-- bind: { fontWeight: 900, letterSpacing: 0 } -->>
                codex-ultra
              </Typography>
              <Typography color="text.secondary">
                <!-- bind: mode === "register" ? t("auth.registerTitle") : mode === "2fa" ? t("auth.totpTitle") : t("auth.loginTitle") -->
              </Typography>
            </Box>
            {(error || localError) && (
              <Alert severity="error" variant="outlined">
                <!-- bind: localError || error -->
              </Alert>
            )}
            {mode === "2fa" ? (
              <fragment>
                <Typography variant="body2" color="text.secondary">
                  <!-- bind: t("auth.totpHint") -->
                </Typography>
                <TextField
                  id="login-totp"
                  size="small"
                  label=<!-- bind: t("auth.totpCode") -->
                  value=<!-- bind: totpCode -->
                  onChange="<!-- bind: onChange handler: (r: ReactChangeEvent<HTMLInputElement | HTMLTextAreaElement>) => setTotpCode(r.target.value) -->"
                  inputProps=<!-- bind: { inputMode: "numeric", maxLength: 6, autoComplete: "one-time-code" } -->
                  autoFocus
                />
                <Button type="submit" variant="contained" disabled=<!-- bind: submitting || totpCode.trim().length < 6 --> sx=<!-- bind: { borderRadius: 999, py: 1.1, fontWeight: 800 } -->>
                  <!-- bind: submitting ? t("auth.verifying") : t("auth.verify") -->
                </Button>
                <Button
                  size="small"
                  onClick={() => {
                    setMode("login");
                    setPendingToken("");
                    setTotpCode("");
                    void refreshCaptcha();
                  }}
                >
                  <!-- bind: t("auth.backToLogin") -->
                </Button>
              </fragment>
            ) : (
              <fragment>
                <TextField id="login-email" size="small" label=<!-- bind: t("auth.email") --> value=<!-- bind: email --> onChange="<!-- bind: onChange handler: (r: ReactChangeEvent<HTMLInputElement | HTMLTextAreaElement>) => setEmail(r.target.value) -->" autoComplete="username" required />
                <TextField
                  id="login-password"
                  size="small"
                  type="password"
                  label=<!-- bind: t("auth.password") -->
                  value=<!-- bind: password -->
                  onChange="<!-- bind: onChange handler: (r: ReactChangeEvent<HTMLInputElement | HTMLTextAreaElement>) => setPassword(r.target.value) -->"
                  autoComplete=<!-- bind: mode === "register" ? "new-password" : "current-password" -->
                  required
                />
                {mode === "register" ? (
                  <TextField id="login-username" size="small" label=<!-- bind: t("auth.username") --> value=<!-- bind: username --> onChange="<!-- bind: onChange handler: (r: ReactChangeEvent<HTMLInputElement | HTMLTextAreaElement>) => setUsername(r.target.value) -->" />
                ) : null}
                {authConfig.captchaEnabled ? (
                  <Stack spacing=<!-- bind: 1 -->>
                    <Stack direction="row" spacing=<!-- bind: 1 --> alignItems="center">
                      <Box
                        role="img"
                        aria-label=<!-- bind: captchaPrompt ? t("auth.captchaAria", { prompt: captchaPrompt }) : t("auth.captcha") -->
                        onClick="<!-- bind: onClick handler: () => void refreshCaptcha() -->"
                        title=<!-- bind: t("auth.refreshCaptcha") -->
                        sx={{
                          flex: 1,
                          height: 72,
                          minWidth: 220,
                          borderRadius: 2,
                          overflow: "hidden",
                          border: "1px solid",
                          borderColor: "divider",
                          bgcolor: "#0f172a",
                          cursor: "pointer",
                          display: "grid",
                          placeItems: "center",
                          position: "relative",
                          "& svg": {
                            display: "block",
                            width: "100%",
                            height: "100%",
                            maxWidth: 220,
                            maxHeight: 72
                          }
                        }}
                      >
                        {captchaSvg ? (
                          <Box sx=<!-- bind: { width: "100%", height: "100%" } --> dangerouslySetInnerHTML=<!-- bind: { __html: captchaSvg } --> />
                        ) : null}
                        {!captchaSvg && captchaPrompt ? (
                          <Typography
                            variant="body2"
                            sx={{
                              position: "absolute",
                              inset: 0,
                              display: "grid",
                              placeItems: "center",
                              color: "#f8fafc",
                              fontWeight: 900,
                              fontFamily: "ui-monospace, SFMono-Regular, Menlo, monospace",
                              letterSpacing: 1
                            }}
                          >
                            <!-- bind: captchaPrompt -->
                          </Typography>
                        ) : null}
                        {!captchaSvg && !captchaPrompt ? (
                          <Typography variant="caption" color="rgba(226,232,240,0.72)" sx=<!-- bind: { fontWeight: 800 } -->>
                            <!-- bind: t("auth.refreshCaptcha") -->
                          </Typography>
                        ) : null}
                      </Box>
                      <Button size="small" variant="outlined" onClick="<!-- bind: onClick handler: () => void refreshCaptcha() -->" sx=<!-- bind: { borderRadius: 999, minWidth: 72 } -->>
                        <!-- bind: t("auth.refreshCaptcha") -->
                      </Button>
                    </Stack>
                    <TextField
                      id="login-captcha"
                      size="small"
                      label=<!-- bind: t("auth.captcha") -->
                      value=<!-- bind: captchaAnswer -->
                      onChange="<!-- bind: onChange handler: (r: ReactChangeEvent<HTMLInputElement | HTMLTextAreaElement>) => setCaptchaAnswer(r.target.value) -->"
                      required
                      placeholder=<!-- bind: t("auth.captchaPlaceholder") -->
                    />
                  </Stack>
                ) : null}
                <Button type="submit" variant="contained" disabled=<!-- bind: submitting --> sx=<!-- bind: { borderRadius: 999, py: 1.1, fontWeight: 800 } -->>
                  <!-- bind: submitting ? t("auth.submitting") : mode === "register" ? t("auth.register") : t("auth.login") -->
                </Button>
                {authConfig.registrationEnabled ? (
                  <Button
                    size="small"
                    onClick={() => {
                      setMode((current: "login" | "register" | "2fa") => (current === "register" ? "login" : "register"));
                      setLocalError(null);
                      void refreshCaptcha();
                    }}
                  >
                    <!-- bind: mode === "register" ? t("auth.haveAccount") : t("auth.needAccount") -->
                  </Button>
                ) : null}
              </fragment>
            )}
          </Stack>
        </Box>
      </Box>

</Component>

