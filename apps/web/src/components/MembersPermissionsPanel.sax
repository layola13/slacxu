        {(error || formError) && ( <!-- DEFECT: SAX: no behavior counterpart | conditional rendering -->
          <Alert severity="error" variant="outlined" onClose={^setFormError}> <!-- bind: onClose={() => setFormError(null)} -->
            {formError || error} <!-- bind: formError || error -->
          </Alert>
        )}

        {/* Filters row */} <!-- bind: /* Filters row */ -->
        <Stack direction={{ xs: "column", md: "row" }} spacing={1.25} alignItems={{ xs: "stretch", md: "center" }}> <!-- bind: xs: "column", md: "row" --> <!-- bind: 1.25 --> <!-- bind: xs: "stretch", md: "center" -->
          <TextField
            size="small"
            placeholder={t("settings.permissions.searchPlaceholder")} <!-- bind: t("settings.permissions.searchPlaceholder") -->
            value={search}
            onChange={^setSearch} <!-- bind: onChange={(event) => setSearch(event.target.value)} -->
            InputProps={{
              startAdornment: (
                <InputAdornment position="start">
                  <SearchIcon fontSize="small" sx={{ color: "text.secondary" }} /> <!-- bind: color: "text.secondary" -->
                </InputAdornment>
              )
            }}
            sx={{
              flex: 1,
              maxWidth: { md: 420 }, <!-- bind: md: 420 -->
              "& .MuiOutlinedInput-root": { borderRadius: 999, bgcolor: "background.paper" } <!-- bind: borderRadius: 999, bgcolor: "background.paper" -->
            }}
          />
          <FormControl size="small" sx={{ minWidth: 140 }}> <!-- bind: minWidth: 140 -->
            <InputLabel>{t("settings.members.role")}</InputLabel> <!-- bind: t("settings.members.role") -->
            <Select label={t("settings.members.role")} value={roleFilter} onChange={^setRoleFilter}> <!-- bind: t("settings.members.role") -->
              <MenuItem value="">{t("settings.permissions.allRoles")}</MenuItem> <!-- bind: t("settings.permissions.allRoles") -->
              <MenuItem value="admin">{t("settings.permissions.roleAdmin")}</MenuItem> <!-- bind: t("settings.permissions.roleAdmin") -->
              <MenuItem value="user">{t("settings.permissions.roleUser")}</MenuItem> <!-- bind: t("settings.permissions.roleUser") -->
            </Select>
          </FormControl>
          <FormControl size="small" sx={{ minWidth: 140 }}> <!-- bind: minWidth: 140 -->
            <InputLabel>{t("settings.members.status")}</InputLabel> <!-- bind: t("settings.members.status") -->
            <Select label={t("settings.members.status")} value={statusFilter} onChange={^setStatusFilter}> <!-- bind: t("settings.members.status") -->
              <MenuItem value="">{t("settings.permissions.allStatus")}</MenuItem> <!-- bind: t("settings.permissions.allStatus") -->
              <MenuItem value="active">{t("settings.permissions.statusActive")}</MenuItem> <!-- bind: t("settings.permissions.statusActive") -->
              <MenuItem value="disabled">{t("settings.permissions.statusDisabled")}</MenuItem> <!-- bind: t("settings.permissions.statusDisabled") -->
            </Select>
          </FormControl>
        </Stack>

        {/* Users table */} <!-- bind: /* Users table */ -->
        <TableContainer
          component={Paper}
          variant="outlined"
          sx={{
            borderRadius: 2,
            bgcolor: (theme) => (theme.palette.mode === "dark" ? "rgba(17, 24, 39, 0.72)" : "rgba(255, 255, 255, 0.72)"),
            backdropFilter: "blur(18px)",
            overflowX: "auto"
          }}
        >
          <Table size="small" stickyHeader sx={{ minWidth: 1100 }}> <!-- bind: minWidth: 1100 -->
            <TableHead>
              <TableRow
                sx={{
                  "& th": {
                    bgcolor: (theme) => (theme.palette.mode === "dark" ? "rgba(31, 41, 55, 0.92)" : "rgba(231, 233, 228, 0.92)"),
                    fontWeight: 850,
                    color: "text.secondary",
                    borderColor: "divider",
                    py: 1.35
                  }
                }}
              >
                <TableCell>{t("settings.permissions.colUser")}</TableCell> <!-- bind: t("settings.permissions.colUser") -->
                <TableCell>{t("settings.members.role")}</TableCell> <!-- bind: t("settings.members.role") -->
                <TableCell>{t("settings.members.status")}</TableCell> <!-- bind: t("settings.members.status") -->
                <TableCell align="right">{t("settings.members.balance")}</TableCell> <!-- bind: t("settings.members.balance") -->
                <TableCell align="center">{t("settings.permissions.concurrency")}</TableCell> <!-- bind: t("settings.permissions.concurrency") -->
                <TableCell>{t("settings.members.maxPermission")}</TableCell> <!-- bind: t("settings.members.maxPermission") -->
                <TableCell align="center">{t("settings.permissions.write")}</TableCell> <!-- bind: t("settings.permissions.write") -->
                <TableCell align="center">{t("settings.permissions.network")}</TableCell> <!-- bind: t("settings.permissions.network") -->
                <TableCell align="center">{t("settings.permissions.danger")}</TableCell> <!-- bind: t("settings.permissions.danger") -->
                <TableCell align="center">{t("settings.permissions.relays")}</TableCell> <!-- bind: t("settings.permissions.relays") -->
                <TableCell>{t("settings.permissions.workspace")}</TableCell> <!-- bind: t("settings.permissions.workspace") -->
                <TableCell align="right">{t("settings.members.actions")}</TableCell> <!-- bind: t("settings.members.actions") -->
              </TableRow>
            </TableHead>
            <TableBody>
              {loading && members.length === 0 ? ( <!-- DEFECT: SAX: no behavior counterpart | conditional rendering -->
                <TableRow>
                  <TableCell colSpan={12}> <!-- bind: 12 -->
                    <Stack direction="row" spacing={1} alignItems="center" sx={{ py: 2 }}> <!-- bind: 1 --> <!-- bind: py: 2 -->
                      <CircularProgress size={18} /> <!-- bind: 18 -->
                      <Typography color="text.secondary">{t("settings.members.loading")}</Typography> <!-- bind: t("settings.members.loading") -->
                    </Stack>
                  </TableCell>
                </TableRow>
              ) : filtered.length === 0 ? ( <!-- DEFECT: SAX: no behavior counterpart | conditional rendering -->
                <TableRow>
                  <TableCell colSpan={12}> <!-- bind: 12 -->
                    <Typography color="text.secondary" sx={{ py: 2 }}> <!-- bind: py: 2 -->
                      {t("settings.permissions.empty")} <!-- bind: t("settings.permissions.empty") -->
                    </Typography>
                  </TableCell>
                </TableRow>
              ) : (
                filtered.map((member) => { <!-- DEFECT: SAX: no behavior counterpart | list rendering (.map) -->
                  const busy = busyId === member.id;
                  return (
                    <TableRow key={member.id} hover sx={{ opacity: busy ? 0.7 : 1 }}> <!-- bind: member.id --> <!-- bind: opacity: busy ? 0.7 : 1 -->
                      <TableCell>
                        <Stack spacing={0.15}> <!-- bind: 0.15 -->
                          <Typography variant="body2" sx={{ fontWeight: 750 }}> <!-- bind: fontWeight: 750 -->
                            {member.email} <!-- bind: member.email -->
                          </Typography>
                          <Typography variant="caption" color="text.secondary">
                            {member.username || "—"} · {member.id.slice(0, 8)} <!-- bind: member.username || "—" --> <!-- bind: member.id.slice(0, 8) -->
                          </Typography>
                        </Stack>
                      </TableCell>
                      <TableCell>
                        <Chip
                          size="small"
                          label={member.role === "admin" ? t("settings.permissions.roleAdmin") : t("settings.permissions.roleUser")} <!-- bind: member.role === "admin" ? t("settings.permissions.roleAdmin") : t("settings.permissions.roleUser") -->
                          color={member.role === "admin" ? "warning" : "default"} <!-- bind: member.role === "admin" ? "warning" : "default" -->
                          variant={member.role === "admin" ? "filled" : "outlined"} <!-- bind: member.role === "admin" ? "filled" : "outlined" -->
                          sx={{ fontWeight: 700 }} <!-- bind: fontWeight: 700 -->
                        />
                      </TableCell>
                      <TableCell>
                        <Switch
                          size="small"
                          checked={member.status === "active"} <!-- bind: member.status === "active" -->
                          disabled={busy || member.role === "admin"} <!-- bind: busy || member.role === "admin" -->
                          onChange={^quickToggle} <!-- bind: onChange={(event) => void quickToggle(member, { status: event.target.checked ? "active" : "disabled" })} -->
                        />
                      </TableCell>
                      <TableCell align="right">
                        <Typography variant="body2" sx={{ fontFamily: "JetBrains Mono, monospace", fontWeight: 700 }}> <!-- bind: fontFamily: "JetBrains Mono, monospace", fontWeight: 700 -->
                          {Number(member.balance).toFixed(2)} <!-- bind: Number(member.balance).toFixed(2) -->
                        </Typography>
                      </TableCell>
                      <TableCell align="center">
                        <Typography variant="body2" sx={{ fontFamily: "JetBrains Mono, monospace" }}> <!-- bind: fontFamily: "JetBrains Mono, monospace" -->
                          {member.concurrency} <!-- bind: member.concurrency -->
                        </Typography>
                      </TableCell>
                      <TableCell>
                        <Chip size="small" label={presetLabel(member.maxPermission)} variant="outlined" /> <!-- bind: presetLabel(member.maxPermission) -->
                      </TableCell>
                      <TableCell align="center">
                        <Checkbox
                          size="small"
                          checked={member.allowWrite} <!-- bind: member.allowWrite -->
                          disabled={busy || member.role === "admin"} <!-- bind: busy || member.role === "admin" -->
                          onChange={^quickToggle} <!-- bind: onChange={(event) => void quickToggle(member, { allowWrite: event.target.checked })} -->
                        />
                      </TableCell>
                      <TableCell align="center">
                        <Checkbox
                          size="small"
                          checked={member.allowNetwork} <!-- bind: member.allowNetwork -->
                          disabled={busy || member.role === "admin"} <!-- bind: busy || member.role === "admin" -->
                          onChange={^quickToggle} <!-- bind: onChange={(event) => void quickToggle(member, { allowNetwork: event.target.checked })} -->
                        />
                      </TableCell>
                      <TableCell align="center">
                        <Checkbox
                          size="small"
                          checked={member.allowDangerBypass} <!-- bind: member.allowDangerBypass -->
                          disabled={busy || member.role === "admin"} <!-- bind: busy || member.role === "admin" -->
                          onChange={^quickToggle} <!-- bind: onChange={(event) => void quickToggle(member, { allowDangerBypass: event.target.checked })} -->
                          color="warning"
                        />
                      </TableCell>
                      <TableCell align="center">
                        <Chip
                          size="small"
                          label={
                            member.role === "admin"
                              ? t("settings.permissions.allRelays")
                              : String((member.allowedProviderIds ?? []).length)
                          }
                          variant="outlined"
                        />
                      </TableCell>
                      <TableCell sx={{ maxWidth: 220 }}> <!-- bind: maxWidth: 220 -->
                        <Tooltip title={member.workspaceRoot || ""}> <!-- bind: member.workspaceRoot || "" -->
                          <Typography variant="caption" color="text.secondary" noWrap sx={{ display: "block", fontFamily: "JetBrains Mono, monospace" }}> <!-- bind: display: "block", fontFamily: "JetBrains Mono, monospace" -->
                            {member.workspaceRoot || "—"} <!-- bind: member.workspaceRoot || "—" -->
                          </Typography>
                        </Tooltip>
                      </TableCell>
                      <TableCell align="right">
                        <Stack direction="row" spacing={0.5} justifyContent="flex-end"> <!-- bind: 0.5 -->
                          <Tooltip title={t("settings.members.allocate")}> <!-- bind: t("settings.members.allocate") -->
                            <span>
                              <IconButton
                                size="small"
                                disabled={busy}
                                onClick={() => { <!-- bind: onClick handler (multi-line) --> <!-- DEFECT: SAX: no behavior counterpart | event handler -->
                                  setFormError(null);
                                  setBalanceUser(member);
                                  setBalanceOp("add");
                                  setBalanceAmount("10");
                                  setBalanceNotes("");
                                }}
                              >
                                <AccountBalanceWalletIcon fontSize="small" />
                              </IconButton>
                            </span>
                          </Tooltip>
                          <Tooltip title={t("settings.permissions.edit")}> <!-- bind: t("settings.permissions.edit") -->
                            <span>
                              <IconButton size="small" disabled={busy} onClick={^openEdit}> <!-- bind: onClick={() => openEdit(member)} -->
                                <EditIcon fontSize="small" />
                              </IconButton>
                            </span>
                          </Tooltip>
                          <Tooltip title={t("settings.members.delete")}> <!-- bind: t("settings.members.delete") -->
                            <span>
                              <IconButton size="small" color="error" disabled={busy || member.role === "admin"} onClick={^handleDelete}> <!-- bind: busy || member.role === "admin" -->
                                {busy ? <CircularProgress size={14} /> : <DeleteOutlineIcon fontSize="small" />} <!-- bind: 14 --> <!-- DEFECT: SAX: no behavior counterpart | conditional rendering -->
                              </IconButton>
                            </span>
                          </Tooltip>
                        </Stack>
                      </TableCell>
                    </TableRow>
                  );
                })
              )}
            </TableBody>
          </Table>
        </TableContainer>

        <Typography variant="body2" color="text.secondary">
          {t("settings.permissions.showing", { count: filtered.length, total: members.length })} <!-- bind: count: filtered.length, total: members.length -->
        </Typography>

        <Alert severity="info" variant="outlined">
          {t("settings.members.securityNote")} <!-- bind: t("settings.members.securityNote") -->
        </Alert>
      </Stack>

      {/* Create dialog */} <!-- bind: /* Create dialog */ -->
      <Dialog open={createOpen} onClose={^setCreateOpen} fullWidth maxWidth="md"> <!-- bind: onClose={() => !creating && setCreateOpen(false)} -->
        <DialogTitle sx={{ fontWeight: 850 }}>{t("settings.permissions.createUser")}</DialogTitle> <!-- bind: fontWeight: 850 --> <!-- bind: t("settings.permissions.createUser") -->
        <DialogContent dividers>
          <Stack spacing={1.5} sx={{ pt: 0.5 }}> <!-- bind: 1.5 --> <!-- bind: pt: 0.5 -->
            <TextField size="small" required label={t("settings.members.email")} value={createForm.email} onChange={^setCreateForm} /> <!-- bind: t("settings.members.email") --> <!-- bind: createForm.email -->
            <TextField size="small" required type="password" label={t("settings.members.password")} value={createForm.password} onChange={^setCreateForm} /> <!-- bind: t("settings.members.password") --> <!-- bind: createForm.password -->
            <TextField size="small" label={t("settings.members.username")} value={createForm.username} onChange={^setCreateForm} /> <!-- bind: t("settings.members.username") --> <!-- bind: createForm.username -->
            <Stack direction={{ xs: "column", sm: "row" }} spacing={1.25}> <!-- bind: xs: "column", sm: "row" --> <!-- bind: 1.25 -->
              <FormControl size="small" fullWidth>
                <InputLabel>{t("settings.members.role")}</InputLabel> <!-- bind: t("settings.members.role") -->
                <Select label={t("settings.members.role")} value={createForm.role} onChange={^setCreateForm}> <!-- bind: t("settings.members.role") --> <!-- bind: createForm.role -->
                  <MenuItem value="user">{t("settings.permissions.roleUser")}</MenuItem> <!-- bind: t("settings.permissions.roleUser") -->
                  <MenuItem value="admin">{t("settings.permissions.roleAdmin")}</MenuItem> <!-- bind: t("settings.permissions.roleAdmin") -->
                </Select>
              </FormControl>
              <FormControl size="small" fullWidth>
                <InputLabel>{t("settings.members.maxPermission")}</InputLabel> <!-- bind: t("settings.members.maxPermission") -->
                <Select
                  label={t("settings.members.maxPermission")} <!-- bind: t("settings.members.maxPermission") -->
                  value={createForm.maxPermission} <!-- bind: createForm.maxPermission -->
                  onChange={^setCreateForm} <!-- bind: onChange={(e) => setCreateForm((c) => ({ ...c, maxPermission: e.target.value as PermissionPresetId }))} -->
                >
                  {permissionPresets.map((preset) => ( <!-- DEFECT: SAX: no behavior counterpart | list rendering (.map) -->
                    <MenuItem key={preset.id} value={preset.id}> <!-- bind: preset.id --> <!-- bind: preset.id -->
                      {preset.label} <!-- bind: preset.label -->
                    </MenuItem>
                  ))}
                </Select>
              </FormControl>
            </Stack>
            <Stack direction={{ xs: "column", sm: "row" }} spacing={1.25}> <!-- bind: xs: "column", sm: "row" --> <!-- bind: 1.25 -->
              <TextField size="small" type="number" label={t("settings.members.balance")} value={createForm.balance} onChange={^setCreateForm} fullWidth /> <!-- bind: t("settings.members.balance") --> <!-- bind: createForm.balance -->
              <TextField size="small" type="number" label={t("settings.permissions.concurrency")} value={createForm.concurrency} onChange={^setCreateForm} fullWidth /> <!-- bind: t("settings.permissions.concurrency") --> <!-- bind: createForm.concurrency -->
            </Stack>
            <Stack direction="row" spacing={1} flexWrap="wrap" useFlexGap> <!-- bind: 1 -->
              <FormControlLabel control={<Checkbox checked={createForm.allowWrite} onChange={^setCreateForm} />} label={t("settings.permissions.write")} /> <!-- bind: createForm.allowWrite --> <!-- bind: t("settings.permissions.write") -->
              <FormControlLabel control={<Checkbox checked={createForm.allowNetwork} onChange={^setCreateForm} />} label={t("settings.permissions.network")} /> <!-- bind: createForm.allowNetwork --> <!-- bind: t("settings.permissions.network") -->
              <FormControlLabel control={<Checkbox checked={createForm.allowDangerBypass} onChange={^setCreateForm} />} label={t("settings.permissions.danger")} /> <!-- bind: createForm.allowDangerBypass --> <!-- bind: t("settings.permissions.danger") -->
            </Stack>
            {createForm.role === "admin" ? ( <!-- DEFECT: SAX: no behavior counterpart | conditional rendering -->
              <Alert severity="info" variant="outlined">
                {t("settings.permissions.adminAllRelays")} <!-- bind: t("settings.permissions.adminAllRelays") -->
              </Alert>
            ) : (
              <RelayAccessPicker
                providers={providers}
                selected={createForm.allowedProviders} <!-- bind: createForm.allowedProviders -->
                onChange={^setCreateForm} <!-- bind: onChange={(ids) => setCreateForm((c) => ({ ...c, allowedProviders: ids }))} -->
                t={t}
                disabled={creating}
              />
            )}
            <TextField size="small" multiline minRows={2} label={t("settings.permissions.notes")} value={createForm.notes} onChange={^setCreateForm} /> <!-- bind: 2 --> <!-- bind: t("settings.permissions.notes") --> <!-- bind: createForm.notes -->
            {formError ? <Alert severity="error">{formError}</Alert> : null} <!-- DEFECT: SAX: no behavior counterpart | conditional rendering -->
          </Stack>
        </DialogContent>
        <DialogActions sx={{ px: 3, py: 1.5 }}> <!-- bind: px: 3, py: 1.5 -->
          <Button onClick={^setCreateOpen} disabled={creating}> <!-- bind: onClick={() => setCreateOpen(false)} -->
            {t("settings.permissions.cancel")} <!-- bind: t("settings.permissions.cancel") -->
          </Button>
          <Button variant="contained" onClick={^submitCreate} disabled={creating || !createForm.email || !createForm.password}> <!-- bind: creating || !createForm.email || !createForm.password -->
            {creating ? t("settings.members.creating") : t("settings.permissions.create")} <!-- bind: creating ? t("settings.members.creating") : t("settings.permissions.create") -->
          </Button>
        </DialogActions>
      </Dialog>

      {/* Edit permissions dialog */} <!-- bind: /* Edit permissions dialog */ -->
      <Dialog open={Boolean(editUser && editForm)} onClose={^setEditUser} fullWidth maxWidth="md"> <!-- bind: Boolean(editUser && editForm) -->
        <DialogTitle sx={{ fontWeight: 850 }}>{t("settings.permissions.editUser")}</DialogTitle> <!-- bind: fontWeight: 850 --> <!-- bind: t("settings.permissions.editUser") -->
        <DialogContent dividers>
          {editForm ? ( <!-- DEFECT: SAX: no behavior counterpart | conditional rendering -->
            <Stack spacing={1.5} sx={{ pt: 0.5 }}> <!-- bind: 1.5 --> <!-- bind: pt: 0.5 -->
              <TextField size="small" label={t("settings.members.email")} value={editForm.email} onChange={^setEditForm} /> <!-- bind: t("settings.members.email") --> <!-- bind: editForm.email -->
              <TextField size="small" type="password" label={t("settings.permissions.newPassword")} placeholder={t("settings.permissions.passwordOptional")} value={editForm.password} onChange={^setEditForm} /> <!-- bind: t("settings.permissions.newPassword") --> <!-- bind: t("settings.permissions.passwordOptional") --> <!-- bind: editForm.password -->
              <TextField size="small" label={t("settings.members.username")} value={editForm.username} onChange={^setEditForm} /> <!-- bind: t("settings.members.username") --> <!-- bind: editForm.username -->
              <Stack direction={{ xs: "column", sm: "row" }} spacing={1.25}> <!-- bind: xs: "column", sm: "row" --> <!-- bind: 1.25 -->
                <FormControl size="small" fullWidth>
                  <InputLabel>{t("settings.members.role")}</InputLabel> <!-- bind: t("settings.members.role") -->
                  <Select label={t("settings.members.role")} value={editForm.role} onChange={^setEditForm}> <!-- bind: t("settings.members.role") --> <!-- bind: editForm.role -->
                    <MenuItem value="user">{t("settings.permissions.roleUser")}</MenuItem> <!-- bind: t("settings.permissions.roleUser") -->
                    <MenuItem value="admin">{t("settings.permissions.roleAdmin")}</MenuItem> <!-- bind: t("settings.permissions.roleAdmin") -->
                  </Select>
                </FormControl>
                <FormControl size="small" fullWidth>
                  <InputLabel>{t("settings.members.status")}</InputLabel> <!-- bind: t("settings.members.status") -->
                  <Select label={t("settings.members.status")} value={editForm.status} onChange={^setEditForm}> <!-- bind: t("settings.members.status") --> <!-- bind: editForm.status -->
                    <MenuItem value="active">{t("settings.permissions.statusActive")}</MenuItem> <!-- bind: t("settings.permissions.statusActive") -->
                    <MenuItem value="disabled">{t("settings.permissions.statusDisabled")}</MenuItem> <!-- bind: t("settings.permissions.statusDisabled") -->
                  </Select>
                </FormControl>
              </Stack>
              <FormControl size="small" fullWidth>
                <InputLabel>{t("settings.members.maxPermission")}</InputLabel> <!-- bind: t("settings.members.maxPermission") -->
                <Select
                  label={t("settings.members.maxPermission")} <!-- bind: t("settings.members.maxPermission") -->
                  value={editForm.maxPermission} <!-- bind: editForm.maxPermission -->
                  onChange={^setEditForm} <!-- bind: onChange={(e) => setEditForm((c) => (c ? { ...c, maxPermission: e.target.value as PermissionPresetId } : c))} -->
                >
                  {permissionPresets.map((preset) => ( <!-- DEFECT: SAX: no behavior counterpart | list rendering (.map) -->
                    <MenuItem key={preset.id} value={preset.id}> <!-- bind: preset.id --> <!-- bind: preset.id -->
                      {preset.label} <!-- bind: preset.label -->
                    </MenuItem>
                  ))}
                </Select>
              </FormControl>
              <TextField size="small" type="number" label={t("settings.permissions.concurrency")} value={editForm.concurrency} onChange={^setEditForm} /> <!-- bind: t("settings.permissions.concurrency") --> <!-- bind: editForm.concurrency -->
              <Divider />
              <Typography variant="subtitle2" sx={{ fontWeight: 800 }}> <!-- bind: fontWeight: 800 -->
                {t("settings.permissions.capabilitySwitches")} <!-- bind: t("settings.permissions.capabilitySwitches") -->
              </Typography>
              <Stack direction="row" spacing={1} flexWrap="wrap" useFlexGap> <!-- bind: 1 -->
                <FormControlLabel control={<Checkbox checked={editForm.allowWrite} onChange={^setEditForm} />} label={t("settings.permissions.write")} /> <!-- bind: editForm.allowWrite --> <!-- bind: t("settings.permissions.write") -->
                <FormControlLabel control={<Checkbox checked={editForm.allowNetwork} onChange={^setEditForm} />} label={t("settings.permissions.network")} /> <!-- bind: editForm.allowNetwork --> <!-- bind: t("settings.permissions.network") -->
                <FormControlLabel control={<Checkbox checked={editForm.allowDangerBypass} onChange={^setEditForm} />} label={t("settings.permissions.danger")} /> <!-- bind: editForm.allowDangerBypass --> <!-- bind: t("settings.permissions.danger") -->
              </Stack>
              {editForm.role === "admin" ? ( <!-- DEFECT: SAX: no behavior counterpart | conditional rendering -->
                <Alert severity="info" variant="outlined">
                  {t("settings.permissions.adminAllRelays")} <!-- bind: t("settings.permissions.adminAllRelays") -->
                </Alert>
              ) : (
                <RelayAccessPicker
                  providers={providers}
                  selected={editForm.allowedProviders} <!-- bind: editForm.allowedProviders -->
                  onChange={^setEditForm} <!-- bind: onChange={(ids) => setEditForm((c) => (c ? { ...c, allowedProviders: ids } : c))} -->
                  t={t}
                  disabled={saving}
                />
              )}
              <TextField size="small" multiline minRows={2} label={t("settings.permissions.notes")} value={editForm.notes} onChange={^setEditForm} /> <!-- bind: 2 --> <!-- bind: t("settings.permissions.notes") --> <!-- bind: editForm.notes -->
              {editUser ? ( <!-- DEFECT: SAX: no behavior counterpart | conditional rendering -->
                <Alert severity="info" variant="outlined">
                  {t("settings.permissions.workspaceFixed")}: {editUser.workspaceRoot} <!-- bind: t("settings.permissions.workspaceFixed") --> <!-- bind: editUser.workspaceRoot -->
                </Alert>
              ) : null}
              {formError ? <Alert severity="error">{formError}</Alert> : null} <!-- DEFECT: SAX: no behavior counterpart | conditional rendering -->
            </Stack>
          ) : null}
        </DialogContent>
        <DialogActions sx={{ px: 3, py: 1.5 }}> <!-- bind: px: 3, py: 1.5 -->
          <Button onClick={^setEditUser} disabled={saving}> <!-- bind: onClick={() => setEditUser(null)} -->
            {t("settings.permissions.cancel")} <!-- bind: t("settings.permissions.cancel") -->
          </Button>
          <Button variant="contained" onClick={^submitEdit} disabled={saving}> <!-- bind: onClick={() => void submitEdit()} -->
            {saving ? t("settings.permissions.saving") : t("settings.permissions.save")} <!-- bind: saving ? t("settings.permissions.saving") : t("settings.permissions.save") -->
          </Button>
        </DialogActions>
      </Dialog>

      {/* Balance allocate dialog (Sub2API set/add/subtract) */} <!-- bind: /* Balance allocate dialog (Sub2API set/add/subtract) */ -->
      <Dialog open={Boolean(balanceUser)} onClose={^setBalanceUser} fullWidth maxWidth="xs"> <!-- bind: Boolean(balanceUser) -->
        <DialogTitle sx={{ fontWeight: 850 }}>{t("settings.members.allocateTitle")}</DialogTitle> <!-- bind: fontWeight: 850 --> <!-- bind: t("settings.members.allocateTitle") -->
        <DialogContent dividers>
          <Stack spacing={1.5} sx={{ pt: 0.5 }}> <!-- bind: 1.5 --> <!-- bind: pt: 0.5 -->
