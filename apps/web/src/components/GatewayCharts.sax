          return <text key=<!-- bind: i --> x=<!-- bind: margin.left - 6 --> y=<!-- bind: yy + 4 --> textAnchor="end" fontSize=<!-- bind: 10 --> fill="currentColor" opacity=<!-- bind: 0.6 -->><!-- bind: formatCount(v) --></text>;
        })}
      </svg>

