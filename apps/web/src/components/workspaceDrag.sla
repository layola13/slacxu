struct WorkspaceEntry {
    isFile: bool,
    name_ptr: ptr, name_len: u64,
    path_ptr: ptr, path_len: u64,
}

// Returns 1 + fills out, 0 = null.
fn buildWorkspaceDragPayload(entry: &WorkspaceEntry, out: &WorkspaceDragPayload) -> i32 {
    if !entry.isFile { return 0; };
    out.name_ptr = entry.name_ptr;
    out.name_len = entry.name_len;
    out.path_ptr = entry.path_ptr;
    out.path_len = entry.path_len;
    out.kind = 0;
    if isImagePath(entry.path_ptr, entry.path_len) { out.kind = 1; };
    return 1;
}

