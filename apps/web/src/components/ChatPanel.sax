  <!-- bind: t, windowsDesktop, onPromptSelect, onOpenSection, onOpenOfficialLogin (src:1877); local steps=onboardingSteps -->
  <Paper variant="outlined" data-testid="codex-onboarding-guide" sx="">
    <Stack spacing="0.75">
      <Stack direction="" spacing="1" justifyContent="space-between" alignItems="" sx="">
        <Box sx="">
          <Typography variant="subtitle2" sx=""><!-- bind: t("onboarding.codex.title") --></Typography>
          <Typography variant="caption" color="text.secondary" sx=""><!-- bind: t("onboarding.codex.subtitle") --></Typography>
        </Box>
        <Chip size="small" color="primary" label="" sx="" /> <!-- bind: t("onboarding.codex.priority") -->
      </Stack>
      <Box sx="">
        <!-- DEFECT: list steps.map((item) => Button) + onClick branching isOfficial/prompt/section (src:1920) — SAX: no behavior counterpart -->
        <Button key="" variant="outlined" color="inherit" onclick={^stepOnClick} sx="">
          <!-- bind: item.id -->
          <Stack spacing="0.35" sx="">
            <Stack direction="row" spacing="0.75" alignItems="center">
              <Avatar sx=""><!-- bind: item.step --></Avatar>
              <Box sx=""><!-- bind: item.icon --></Box>
            </Stack>
            <Typography sx=""><!-- bind: item.title --></Typography>
            <Typography variant="caption" color="text.secondary" sx=""><!-- bind: item.detail --></Typography>
            <Chip size="small" label="" variant="outlined" sx="" /> <!-- bind: item.action -->
          </Stack>
        </Button>
      </Box>
    </Stack>
  </Paper>
</Component>

<Component name="PendingServerRequestsPanel">
  <!-- bind: pendingRequests, onAnswerServerRequest (src:1963) -->
  <Paper data-testid="pending-server-requests" variant="outlined" sx="">
    <Stack spacing="1">
      <Stack direction="row" spacing="1" alignItems="center">
        <Typography id="pending-server-requests-title" variant="subtitle2" sx="">Codex needs your input</Typography>
        <Chip size="small" color="warning" label="" /> <!-- bind: pendingRequests.length -->
      </Stack>
      <!-- DEFECT: list pendingRequests.map + branches isUserInputServerRequest/isApprovalServerRequest/unsupported (src:1979) — SAX: no behavior counterpart -->
      <RequestUserInputCard key="" request="" questions="" onAnswer="" /> <!-- bind: requestKey, request, questions, onAnswerServerRequest -->
      <Box key="" sx="">
        <Typography variant="body2" sx=""><!-- bind: requestTitle(request) --></Typography>
        <Typography variant="caption" color="text.secondary" sx=""><!-- bind: requestSummary(request, params) --></Typography>
        <Stack direction="row" spacing="0.75" flexWrap="wrap" useFlexGap="true" sx="">
          <Button size="small" variant="contained" onclick={^answerAccept}>Allow</Button>
          <Button size="small" variant="outlined" onclick={^answerAcceptForSession}>Allow session</Button>
          <Button size="small" color="warning" onclick={^answerDecline}>Decline</Button>
          <Button size="small" color="error" onclick={^answerCancel}>Cancel</Button>
          <!-- bind: onAnswerServerRequest(request.id, buildServerRequestDecisionResponse(method,params,accept/acceptForSession/decline/cancel)) -->
        </Stack>
      </Box>
      <Box key="" sx="">
        <Typography variant="body2" sx="">Unsupported Codex request</Typography>
        <Typography variant="caption" color="text.secondary" sx=""><!-- bind: request.method --></Typography>
        <Button size="small" color="error" sx="" onclick={^answerCancel}>Cancel</Button>
      </Box>
    </Stack>
  </Paper>
</Component>

<Component name="RequestUserInputCard">
  <state>
    selectedOptions: string = ""
    notes: string = ""
    submitting: bool = false
  </state>
  <!-- bind: request, questions, onAnswer (src:2041) -->
  <!-- DEFECT: useState x3, ready computed, toggleMulti closure (src:2048-2098) — SAX: no behavior counterpart -->
  <Box data-testid="" sx=""><!-- bind: request-user-input-{sanitizeTestId(String(request.id))} -->
    <Typography variant="body2" sx=""><!-- bind: requestTitle(request) --></Typography>
    <Stack spacing="1.25" sx="">
      <!-- DEFECT: list questions.map((question,index) => ...) (src:2081) — SAX: no behavior counterpart -->
      <Box key=""><!-- bind: question.id -->
        <Typography variant="caption" sx=""><!-- bind: (index+1). + question.header || question.question --></Typography>
        <Typography variant="caption" color="text.secondary" sx=""><!-- bind: question.question; DEFECT: conditional question.header && — SAX: no behavior counterpart --></Typography>
        <!-- DEFECT: conditional question.options.length > 0 (src:2109) — SAX: no behavior counterpart -->
        <Stack spacing="0.55" sx="">
          <!-- DEFECT: list question.options.map((option) => Button) (src:2110) — SAX: no behavior counterpart -->
          <Button key="" size="small" disabled="" variant="" onclick={^selectOption} sx="">
            <!-- bind: option.label, submitting, active ? contained : outlined, multi/single select -->
            <Box sx="">
              <Typography component="span" variant="body2" sx=""><!-- bind: multi ? ☑/☐ + option.label : option.label --></Typography>
              <Typography component="span" variant="caption" sx=""><!-- bind: option.description; DEFECT: conditional — SAX: no behavior counterpart --></Typography>
            </Box>
          </Button>
          <Button size="small" disabled="" variant="" onclick={^selectOther} sx="">Other</Button>
          <!-- DEFECT: conditional question.isOther && — SAX: no behavior counterpart; bind: hasOther -->
        </Stack>
        <!-- DEFECT: conditional showFreeform && ternary TextField : textarea Box (src:2152) — SAX: no behavior counterpart -->
        <TextField fullWidth="true" size="small" disabled="" type="" label="" value="" onChange="" autoComplete="off" slotProps="" sx="" />
        <!-- bind: question.isSecret ? password : text, Other answer/Your answer, notes[question.id], setNotes -->
        <Box component="textarea" aria-label="Your answer" rows="3" disabled="" value="" onChange="" sx="" />
        <!-- bind: submitting, notes[question.id], setNotes -->
      </Box>
    </Stack>
    <Stack direction="row" spacing="0.75" sx="">
      <Button size="small" variant="contained" disabled="" onclick={^submitAnswer}><!-- bind: !ready||submitting, submitting ? Submitting... : Submit --></Button>
      <Button size="small" color="error" disabled="" onclick={^cancelAnswer}>Cancel</Button>
      <!-- bind: onAnswer(request.id, buildUserInputResponse(...)) / onAnswer(request.id, {answers:{}}) -->
    </Stack>
  </Box>
  fn toggleMulti() { /* src:2089 — DEFECT: SAX: no behavior counterpart */ }
</Component>

