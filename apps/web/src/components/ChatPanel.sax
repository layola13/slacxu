<Component name="RequestMonitorTable">
  <!-- bind: entries: RequestMonitorEntry[], t (src:2323) -->
  <Paper data-testid="homepage-request-monitor" variant="outlined" sx="">
    <Stack direction="row" alignItems="center" spacing="1" sx="">
      <AssessmentIcon fontSize="small" color="primary" />
      <Box sx="">
        <Typography variant="subtitle2" sx=""><!-- bind: t("chat.requests") --></Typography>
        <Typography variant="caption" color="text.secondary"><!-- bind: t("chat.requestsSubtitle") --></Typography>
      </Box>
      <Chip size="small" label="" /> <!-- bind: t("chat.requestsTracked", {count: entries.length}) -->
    </Stack>
    <!-- DEFECT: ternary entries.length===0 ? empty Box : table Box (src:2348) — SAX: no behavior counterpart -->
    <Box sx=""><Typography variant="body2" color="text.secondary"><!-- bind: t("chat.requestsEmpty") --></Typography></Box>
    <Box sx="">
      <Box component="table" sx="">
        <thead><tr>
          <th><!-- bind: t("chat.request") --></th><th><!-- bind: t("chat.source") --></th><th><!-- bind: t("chat.status") --></th>
          <th><!-- bind: t("chat.requestModel") --></th><th><!-- bind: t("chat.lastTokens") --></th><th><!-- bind: t("chat.totalTokens") --></th>
        </tr></thead>
        <tbody>
          <!-- DEFECT: list entries.map((entry) => tr) (src:2395) — SAX: no behavior counterpart -->
          <tr key=""><!-- bind: entry.id -->
            <td>
              <Typography variant="body2" sx=""><!-- bind: entry.title --></Typography>
              <Typography variant="caption" color="text.secondary" sx=""><!-- bind: entry.id --></Typography>
            </td>
            <td><Chip size="small" label="" variant="outlined" /></td> <!-- bind: entry.source -->
            <td><VisibleStatusChip status="" color="" /></td> <!-- bind: entry.status, failed?error:inProgress?warning:default -->
            <td>
              <Typography variant="body2" sx=""><!-- bind: entry.model || t("chat.engineDefault") --></Typography>
              <Typography variant="caption" color="text.secondary" sx=""><!-- bind: entry.provider || t("chat.default") --></Typography>
            </td>
            <td><!-- bind: formatUsageCell(entry.lastTokens, t) --></td>
            <td><!-- bind: formatUsageCell(entry.totalTokens, t) --></td>
          </tr>
        </tbody>
      </Box>
    </Box>
  </Paper>
</Component>

