  // DEFECT: SAX: no behavior counterpart | const softwareRendering = !gpuFeatures || gpuFeatures.gpu_compositing === "disabled_software" || gpuFeatures.rasterization === "disabled_software";
  // DEFECT: SAX: no behavior counterpart | const renderMode = gpuInfo ? (softwareRendering ? "CPU" : "GPU") : "GPU?";
