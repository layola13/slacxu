                    </Typography>
                    <Typography variant="caption" color="text.secondary">
                      可用 {formatBytes(metrics.memory.freeBytes)} <!-- bind: formatBytes(metrics.memory.freeBytes) -->
                    </Typography>
                  </Stack>

                  {Boolean(metrics.memory.swapTotalBytes) && ( <!-- DEFECT: SAX: no behavior counterpart | conditional rendering -->
                    <Stack direction="row" justifyContent="space-between" mt={0.5}> <!-- bind: 0.5 -->
                      <Typography variant="caption" color="text.disabled">
