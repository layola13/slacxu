            boxShadow: "0 0 8px rgba(76, 175, 80, 0.8)",
            animation: "pulse 2s infinite",
            "@keyframes pulse": {
              "0%": { opacity: 1 }, <!-- bind: opacity: 1 -->
              "50%": { opacity: 0.35 }, <!-- bind: opacity: 0.35 -->
