                      内存 {formatBytes(metrics.application.memoryBytes)} · {metrics.application.processCount} 个进程 <!-- bind: formatBytes(metrics.application.memoryBytes) --> <!-- bind: metrics.application.processCount -->
                    </Typography>
                    <Typography variant="caption" color={metrics.application.includesCodexCli ? "success.main" : "text.secondary"}> <!-- bind: metrics.application.includesCodexCli ? "success.main" : "text.secondary" -->
