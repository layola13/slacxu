            : `APP ${metrics.application.cpuUsagePercent}% · ${formatBytes(metrics.application.memoryBytes)} · ${fps} FPS`} <!-- bind: metrics.application.cpuUsagePercent --> <!-- bind: formatBytes(metrics.application.memoryBytes) -->
          sx={{ height: 22, fontSize: 11.5, fontWeight: 750, border: 0 }} <!-- bind: height: 22, fontSize: 11.5, fontWeight: 750, border: 0 -->
        />

