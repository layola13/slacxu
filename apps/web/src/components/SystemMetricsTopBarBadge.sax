            <SpeedIcon sx={{ fontSize: 18 }} /> <!-- bind: fontSize: 18 -->
          </IconButton>
        ) : (
          <>
        {/* Pulsing online indicator */} <!-- bind: /* Pulsing online indicator */ -->
        <Box
          sx={{
            width: 7,
            height: 7,
            borderRadius: "50%",
