  return <Dialog open={open} onClose={^onClose} fullWidth maxWidth="xl" data-testid="project-group-chat-dialog"> <!-- bind: onClose={onClose} -->
      <DialogTitle sx={{ display: "flex", alignItems: "center", gap: 1 }}><GroupsIcon color="primary" />{isZh ? "公司 Project 群聊" : "Company project room"}</DialogTitle> <!-- bind: display: "flex", alignItems: "center", gap: 1 --> <!-- bind: isZh ? "公司 Project 群聊" : "Company project room" -->
      <DialogContent dividers>
