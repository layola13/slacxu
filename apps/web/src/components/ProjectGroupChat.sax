            <Chip label={statusLabel(project.status)} color={project.status === "active" ? "success" : project.status === "paused" ? "warning" : "default"} /> <!-- bind: statusLabel(project.status) --> <!-- bind: project.status === "active" ? "success" : project.status === "paused" ? "warning" : "default" -->
            <Button size="small" variant="outlined" startIcon={<AltRouteIcon />} onClick={^applyCurrentRouteToAll} disabled={!routeReady || loading}>{isZh ? "全部使用当前路线" : "Use current route for all"}</Button> <!-- bind: <AltRouteIcon /> --> <!-- bind: !routeReady || loading --> <!-- bind: isZh ? "全部使用当前路线" : "Use current route for all" -->
            {project.status === "active" ? <Button size="small" color="warning" startIcon={<PauseCircleOutlineIcon />} onClick={^pause} disabled={loading}>{isZh ? "暂停" : "Pause"}</Button> : <Button size="small" variant="contained" startIcon={<PlayCircleOutlineIcon />} onClick={^start} disabled={loading || project.status === "archived" || !membersReady}>{isZh ? "启动成员" : "Start agents"}</Button>} <!-- bind: <PauseCircleOutlineIcon /> --> <!-- bind: isZh ? "暂停" : "Pause" --> <!-- bind: <PlayCircleOutlineIcon /> --> <!-- bind: loading || project.status === "archived" || !membersReady --> <!-- bind: isZh ? "启动成员" : "Start agents" --> <!-- DEFECT: SAX: no behavior counterpart | conditional rendering -->
          </Stack>
          {!routeReady && <Alert severity="warning">{isZh ? "请先在主输入框选择可用的中转站、分组和模型，再同步到 Project 成员。" : "Select an available relay, group, and model in the main composer, then sync the Project members."}</Alert>} <!-- bind: isZh ? "请先在主输入框选择可用的中转站、分组和模型，再同步到 Project 成员。" : "Select an available relay, group, and model in th --> <!-- DEFECT: SAX: no behavior counterpart | conditional rendering -->
          {!membersReady && <Alert severity="warning">{isZh ? "所有成员都需要选择当前可用的中转站、文本分组和模型后才能启动。" : "Every member needs a currently available relay, text group, and model before the Project can start."}</Alert>} <!-- bind: isZh ? "所有成员都需要选择当前可用的中转站、文本分组和模型后才能启动。" : "Every member needs a currently available relay, text gro --> <!-- DEFECT: SAX: no behavior counterpart | conditional rendering -->
          <Stack direction={{ xs: "column", sm: "row" }} spacing={1} alignItems="stretch"><TextField size="small" fullWidth label={isZh ? "添加工作目录" : "Add workspace"} value={workspacePath} onChange={^setWorkspacePath} placeholder="E:\\projects\\my-app or /workspace/app" /><Button size="small" onClick={^addWorkspace} disabled={!workspacePath.trim()}>{isZh ? "添加" : "Add"}</Button></Stack> <!-- bind: xs: "column", sm: "row" --> <!-- bind: 1 --> <!-- bind: isZh ? "添加工作目录" : "Add workspace" --> <!-- bind: !workspacePath.trim() --> <!-- bind: isZh ? "添加" : "Add" -->
          {project.workspaces.length > 0 && <Stack direction="row" spacing={.75} flexWrap="wrap" useFlexGap>{project.workspaces.map((workspace) => <Chip key={workspace.id} label={workspace.path} variant="outlined" />)}</Stack>} <!-- bind: .75 --> <!-- bind: workspace.id --> <!-- bind: workspace.path --> <!-- DEFECT: SAX: no behavior counterpart | list rendering (.map) --> <!-- DEFECT: SAX: no behavior counterpart | conditional rendering -->
          <Paper variant="outlined" sx={{ p: 1.25 }}> <!-- bind: p: 1.25 -->
            <Stack spacing={1.25}>{memberDrafts.map((member) => { <!-- bind: 1.25 --> <!-- DEFECT: SAX: no behavior counterpart | list rendering (.map) -->
              const provider = relayDirectory.find((entry) => entry.providerId === member.providerId);
              const groups = relayGroups(member.providerId).filter((group) => group.kind === "text" && group.enabled);
              // Resolve the group this member actually runs through: keep the
              // member's explicit group when it is an enabled text group,
              // otherwise locate the group hosting its current model, otherwise
              // fall back to the relay's first usable text group. This is also
              // how the main composer resolves a model back to a group, so a
              // Project member and the active conversation express the same
              // "relay + group + model" triplet instead of a bare model list.
              const effectiveGroupId = provider ? resolvedGroupId(provider, member.groupId, member.model) : null;
              const effectiveGroup = groups.find((group) => group.groupId === effectiveGroupId);
              const models = provider && effectiveGroupId ? selectableModels(provider, effectiveGroupId) : [];
              const groupUsesRelayDefault = Boolean(effectiveGroup) && effectiveGroup!.models.length === 0 && models.length > 0;
              const modelIsStale = Boolean(member.model) && !models.includes(member.model);
              const selectedModelValue = models.includes(member.model) ? member.model : (member.model || models[0] || "");
              return <Stack key={member.id} spacing={.75}> <!-- bind: member.id --> <!-- bind: .75 -->
                <Stack direction={{ xs: "column", md: "row" }} spacing={1} alignItems={{ md: "center" }}> <!-- bind: xs: "column", md: "row" --> <!-- bind: 1 --> <!-- bind: md: "center" -->
                  <Stack direction="row" spacing={.75} alignItems="center" sx={{ minWidth: 180 }}><Typography sx={{ fontWeight: 750 }}>{member.name}</Typography><Chip size="small" label={statusLabel(member.status)} color={member.status === "active" ? "success" : member.status === "failed" ? "error" : "default"} /></Stack> <!-- bind: .75 --> <!-- bind: minWidth: 180 --> <!-- bind: fontWeight: 750 --> <!-- bind: member.name --> <!-- bind: statusLabel(member.status) --> <!-- bind: member.status === "active" ? "success" : member.status === "failed" ? "error" : "default" -->
                  <TextField size="small" label={isZh ? "职责" : "Responsibility"} value={member.responsibility} onChange={^updateMemberLocal} sx={{ flex: 2 }} /> <!-- bind: isZh ? "职责" : "Responsibility" --> <!-- bind: member.responsibility --> <!-- bind: flex: 2 -->
                  <FormControl size="small" sx={{ minWidth: 160, flex: 1 }}><InputLabel>{isZh ? "中转站" : "Relay"}</InputLabel><Select label={isZh ? "中转站" : "Relay"} value={member.providerId ?? ""} onChange={(event) => { <!-- bind: onChange handler (multi-line) --> <!-- DEFECT: SAX: no behavior counterpart | event handler --> <!-- bind: minWidth: 160, flex: 1 --> <!-- bind: isZh ? "中转站" : "Relay" --> <!-- bind: isZh ? "中转站" : "Relay" --> <!-- bind: member.providerId ?? "" -->
                    // Anchor to the new relay while preserving group context:
                    // prefer the member's own group if it still exists there,
                    // then the current conversation's group, then let the route
                    // resolver pick the new relay's first usable text group. We
                    // never drop the model silently into a bare native list.
                    const nextProviderId = event.target.value || null;
                    const nextProvider = relayDirectory.find((entry) => entry.providerId === nextProviderId);
                    const ownGroupForNewRelay = nextProvider && member.groupId ? resolvedGroupId(nextProvider, member.groupId, member.model) : null;
                    const convGroupForNewRelay = nextProvider && defaultRoute.groupId ? resolvedGroupId(nextProvider, defaultRoute.groupId, member.model) : null;
                    const inheritGroupId = ownGroupForNewRelay ?? convGroupForNewRelay;
                    updateMemberLocal(member.id, resolveProjectRoute(relayDirectory, { providerId: nextProviderId, groupId: inheritGroupId, model: member.model })); <!-- bind: providerId: nextProviderId, groupId: inheritGroupId, model: member.model -->
                  }}><MenuItem value="" disabled>{isZh ? "请选择中转站" : "Select a relay"}</MenuItem>{relayDirectory.filter(providerHasProjectRoute).map((entry) => <MenuItem key={entry.providerId} value={entry.providerId}>{entry.providerName}</MenuItem>)}</Select></FormControl> <!-- bind: isZh ? "请选择中转站" : "Select a relay" --> <!-- bind: entry.providerId --> <!-- bind: entry.providerId --> <!-- bind: entry.providerName --> <!-- DEFECT: SAX: no behavior counterpart | list rendering (.map) -->
                  <FormControl size="small" sx={{ minWidth: 145, flex: 1 }}><InputLabel>{isZh ? "分组" : "Group"}</InputLabel><Select label={isZh ? "分组" : "Group"} value={member.groupId ?? ""} disabled={!provider} renderValue={(value) => groups.find((group) => group.groupId === (value as string))?.groupName ?? ((value as string) || (isZh ? "请选择分组" : "Select a group"))} onChange={(event) => { const groupId = event.target.value || null; updateMemberLocal(member.id, { groupId, model: selectableModels(provider, groupId)[0] ?? "" }); }}><MenuItem value="" disabled>{isZh ? "请选择分组" : "Select a group"}</MenuItem>{groups.map((group) => <MenuItem key={group.groupId} value={group.groupId}>{group.groupName} · x{group.groupRatio}</MenuItem>)}</Select></FormControl> <!-- bind: onChange handler (multi-line) --> <!-- DEFECT: SAX: no behavior counterpart | event handler --> <!-- bind: minWidth: 145, flex: 1 --> <!-- bind: isZh ? "分组" : "Group" --> <!-- bind: isZh ? "分组" : "Group" --> <!-- bind: member.groupId ?? "" --> <!-- bind: !provider --> <!-- bind: (value) => groups.find((group) => group.groupId === (value as string))?.groupName ?? ((value as stri --> <!-- bind: groupId, model: selectableModels(provider, groupId)[0] ?? "" --> <!-- bind: isZh ? "请选择分组" : "Select a group" --> <!-- bind: group.groupId --> <!-- bind: group.groupId --> <!-- bind: group.groupName --> <!-- bind: group.groupRatio --> <!-- DEFECT: SAX: no behavior counterpart | list rendering (.map) --> <!-- DEFECT: SAX: no behavior counterpart | conditional rendering -->
                  <FormControl size="small" sx={{ minWidth: 150, flex: 1.3 }}><InputLabel>{isZh ? "模型" : "Model"}</InputLabel><Select label={isZh ? "模型" : "Model"} value={selectedModelValue} disabled={!provider || !effectiveGroupId || models.length === 0} renderValue={(value) => { <!-- bind: minWidth: 150, flex: 1.3 --> <!-- bind: isZh ? "模型" : "Model" --> <!-- bind: isZh ? "模型" : "Model" --> <!-- bind: !provider || !effectiveGroupId || models.length === 0 -->
                    const shown = (value as string) || models[0] || "";
                    if (!shown) return isZh ? "无可用模型" : "No models";
                    if (groupUsesRelayDefault) return `${shown}${isZh ? " · 中转站默认" : " · relay default"}`; <!-- bind: isZh ? " · 中转站默认" : " · relay default" -->
                    return effectiveGroup ? `${shown} · ${effectiveGroup.groupName}` : shown; <!-- bind: effectiveGroup.groupName -->
                  }} onChange={^updateMemberLocal}> <!-- bind: onChange={(event) => updateMemberLocal(member.id, { model: event.target.value })} -->
                    <ListSubheader>{effectiveGroup ? `${isZh ? "当前分组" : "Group"} · ${effectiveGroup.groupName}` : (isZh ? "请选择分组" : "Select a group")}{groupUsesRelayDefault ? (isZh ? "（中转站默认模型）" : " (relay default models)") : ""}</ListSubheader> <!-- bind: isZh ? "当前分组" : "Group" --> <!-- bind: effectiveGroup.groupName --> <!-- bind: groupUsesRelayDefault ? (isZh ? "（中转站默认模型）" : " (relay default models)") : "" --> <!-- DEFECT: SAX: no behavior counterpart | conditional rendering -->
                    {models.map((model) => <MenuItem key={model} value={model}>{model}</MenuItem>)} <!-- DEFECT: SAX: no behavior counterpart | list rendering (.map) -->
                    {models.length === 0 && <MenuItem value="" disabled>{isZh ? "该分组未配置模型" : "No models configured for this group"}</MenuItem>} <!-- bind: isZh ? "该分组未配置模型" : "No models configured for this group" --> <!-- DEFECT: SAX: no behavior counterpart | conditional rendering -->
                    {modelIsStale && member.model && <MenuItem value={member.model} disabled>{`${member.model}${isZh ? "（已不在当前分组）" : " (not in this group)"}`}</MenuItem>} <!-- bind: member.model --> <!-- bind: member.model --> <!-- bind: isZh ? "（已不在当前分组）" : " (not in this group)" --> <!-- DEFECT: SAX: no behavior counterpart | conditional rendering -->
                  </Select></FormControl>
                  <TextField size="small" label={isZh ? "思考强度" : "Reasoning"} value={member.reasoningEffort} onChange={^updateMemberLocal} placeholder="medium" sx={{ minWidth: 110, flex: .8 }} /> <!-- bind: isZh ? "思考强度" : "Reasoning" --> <!-- bind: member.reasoningEffort --> <!-- bind: minWidth: 110, flex: .8 -->
                </Stack>
                <Stack direction={{ xs: "column", md: "row" }} spacing={1} alignItems={{ md: "center" }}> <!-- bind: xs: "column", md: "row" --> <!-- bind: 1 --> <!-- bind: md: "center" -->
                  <FormControl size="small" sx={{ minWidth: 260, flex: 1 }}><InputLabel>{isZh ? "工作目录" : "Workspaces"}</InputLabel><Select multiple label={isZh ? "工作目录" : "Workspaces"} value={member.workspaceIds} onChange={^updateMemberLocal} renderValue={(selected) => (selected as string[]).map((id) => project.workspaces.find((workspace) => workspace.id === id)?.label ?? id).join(", ")}><MenuItem value="">{isZh ? "未分配" : "Unassigned"}</MenuItem>{project.workspaces.map((workspace) => <MenuItem key={workspace.id} value={workspace.id}>{workspace.label}</MenuItem>)}</Select></FormControl> <!-- bind: minWidth: 260, flex: 1 --> <!-- bind: isZh ? "工作目录" : "Workspaces" --> <!-- bind: isZh ? "工作目录" : "Workspaces" --> <!-- bind: member.workspaceIds --> <!-- bind: (selected) => (selected as string[]).map((id) => project.workspaces.find((workspace) => workspace.id --> <!-- bind: isZh ? "未分配" : "Unassigned" --> <!-- bind: workspace.id --> <!-- bind: workspace.id --> <!-- bind: workspace.label --> <!-- DEFECT: SAX: no behavior counterpart | list rendering (.map) -->
                  <TextField size="small" fullWidth label={isZh ? "角色指令（可选）" : "Role instructions (optional)"} value={member.instructions} onChange={^updateMemberLocal} sx={{ flex: 2 }} /> <!-- bind: isZh ? "角色指令（可选）" : "Role instructions (optional)" --> <!-- bind: member.instructions --> <!-- bind: flex: 2 -->
                </Stack>
              </Stack>;
            })}</Stack>
            {savingMembers && <Typography variant="caption" color="text.secondary">{isZh ? "正在保存成员配置…" : "Saving member settings…"}</Typography>} <!-- bind: isZh ? "正在保存成员配置…" : "Saving member settings…" --> <!-- DEFECT: SAX: no behavior counterpart | conditional rendering -->
          </Paper>
          <Divider />
          <Box sx={{ flex: 1, minHeight: 180, maxHeight: 420, overflowY: "auto", p: 1.25, bgcolor: "action.hover", borderRadius: 1 }}> <!-- bind: flex: 1, minHeight: 180, maxHeight: 420, overflowY: "auto", p: 1.25, bgcolor: "action.hover", border -->
            {messages.length === 0 ? <Typography color="text.secondary">{isZh ? "群聊尚无消息。人类拥有一票否决权，涉及代码、部署、账单和客户承诺的议题应先投票。" : "No room messages yet. Human veto applies to code, deployment, billing, and customer commitments."}</Typography> : messages.map((message) => { <!-- bind: isZh ? "群聊尚无消息。人类拥有一票否决权，涉及代码、部署、账单和客户承诺的议题应先投票。" : "No room messages yet. Human veto applies to cod --> <!-- DEFECT: SAX: no behavior counterpart | list rendering (.map) --> <!-- DEFECT: SAX: no behavior counterpart | conditional rendering -->
              const member = members.find((candidate) => candidate.id === message.agentId);
              const phase = message.phase ? (isZh ? phaseLabels[message.phase][0] : phaseLabels[message.phase][1]) : null; <!-- DEFECT: SAX: no behavior counterpart | conditional rendering -->
              const route = message.providerId || message.groupId || message.model
                ? `${message.providerId ?? "inherit"}/${message.groupId ?? "default"}/${message.model ?? "default"}` <!-- bind: message.providerId ?? "inherit" --> <!-- bind: message.groupId ?? "default" --> <!-- bind: message.model ?? "default" -->
                : null;
              return <Paper key={message.id} variant="outlined" sx={{ mb: 1, p: 1, borderLeft: "3px solid", borderLeftColor: message.kind === "human" ? "primary.main" : message.kind === "system" ? "warning.main" : "success.main" }}><Stack direction="row" spacing={.75} alignItems="center" flexWrap="wrap" useFlexGap><Typography variant="caption" sx={{ fontWeight: 800 }}>{message.kind === "human" ? (isZh ? "你（老板）" : "You (boss)") : member?.name ?? (isZh ? "系统" : "System")}</Typography>{phase && <Chip size="small" color="info" variant="outlined" label={phase} />}{route && <Chip size="small" variant="outlined" label={route} />}{member && <Chip size="small" variant="outlined" label={statusLabel(member.status)} />}</Stack><Typography variant="caption" color="text.secondary">#{message.sequence} · {new Date(message.createdAt).toLocaleTimeString()}</Typography><Typography sx={{ whiteSpace: "pre-wrap", mt: .35 }}>{message.text}</Typography></Paper>; <!-- bind: message.id --> <!-- bind: mb: 1, p: 1, borderLeft: "3px solid", borderLeftColor: message.kind === "human" ? "primary.main" : m --> <!-- bind: .75 --> <!-- bind: fontWeight: 800 --> <!-- bind: message.kind === "human" ? (isZh ? "你（老板）" : "You (boss)") : member?.name ?? (isZh ? "系统" : "System" --> <!-- bind: statusLabel(member.status) --> <!-- bind: message.sequence --> <!-- bind: new Date(message.createdAt).toLocaleTimeString() --> <!-- bind: whiteSpace: "pre-wrap", mt: .35 --> <!-- bind: message.text --> <!-- DEFECT: SAX: no behavior counterpart | conditional rendering -->
            })}
          </Box>
          <Stack direction={{ xs: "column", sm: "row" }} spacing={1}><TextField fullWidth multiline maxRows={4} size="small" disabled={project.status !== "active"} placeholder={project.status === "active" ? (isZh ? "向公司团队发消息…" : "Message the company team…") : (isZh ? "请先启动成员" : "Start agents before messaging")} value={draft} onChange={^setDraft} onKeyDown={(event) => { if (event.key === "Enter" && !event.shiftKey) { event.preventDefault(); void send(); } }} /><Button variant="contained" onClick={^send} disabled={project.status !== "active" || !draft.trim() || loading}>{loading ? <CircularProgress size={18} color="inherit" /> : isZh ? "发送" : "Send"}</Button></Stack> <!-- bind: xs: "column", sm: "row" --> <!-- bind: 1 --> <!-- bind: 4 --> <!-- bind: project.status !== "active" --> <!-- bind: project.status === "active" ? (isZh ? "向公司团队发消息…" : "Message the company team…") : (isZh ? "请先启动成员"  --> <!-- bind: event.preventDefault(); void send(); --> <!-- bind: project.status !== "active" || !draft.trim() || loading --> <!-- bind: 18 --> <!-- DEFECT: SAX: no behavior counterpart | conditional rendering -->
          <Stack direction="row" spacing={1}><Button size="small" startIcon={<ThumbUpAltIcon />} onClick={^vote}>{isZh ? "批准当前议题" : "Approve proposal"}</Button><Button size="small" color="error" startIcon={<ThumbDownAltIcon />} onClick={^vote}>{isZh ? "人类一票否决" : "Human veto"}</Button></Stack> <!-- bind: 1 --> <!-- bind: <ThumbUpAltIcon /> --> <!-- bind: isZh ? "批准当前议题" : "Approve proposal" --> <!-- bind: <ThumbDownAltIcon /> --> <!-- bind: isZh ? "人类一票否决" : "Human veto" -->
        </Stack>}
      </DialogContent>
      <DialogActions><Button onClick={^setProjectAndDraft}>{isZh ? "新建/切换 Project" : "New / switch project"}</Button><Button onClick={^onClose}>{isZh ? "关闭" : "Close"}</Button></DialogActions> <!-- bind: isZh ? "新建/切换 Project" : "New / switch project" --> <!-- bind: isZh ? "关闭" : "Close" -->
    </Dialog>;
