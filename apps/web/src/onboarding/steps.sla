// Converted 1:1 from apps/web/src/onboarding/steps.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "sa_std/string.sa"

// Import in source: DriveStep type from "driver.js" (external tour library).
// DEFECT: DriveStep dynamic object (element selector + popover config) -> JSON text buffer entries.
struct DriveStep {
    json_ptr: ptr, json_len: u64,
    element_ptr: ptr, element_len: u64, has_element: bool,
}

const NEW_TASK_SELECTOR_PTR: ptr = STR_PTR("[data-testid=\"new-task-tab-button\"]");
const NEW_TASK_SELECTOR_LEN: u64 = 35;
const RUNTIME_SELECTOR_PTR: ptr = STR_PTR("[data-testid=\"composer-runtime-controls\"]");
const RUNTIME_SELECTOR_LEN: u64 = 41;
const COMPOSER_SELECTOR_PTR: ptr = STR_PTR("[data-testid=\"composer-input\"]");
const COMPOSER_SELECTOR_LEN: u64 = 31;
const AGENTS_SELECTOR_PTR: ptr = STR_PTR("[data-testid=\"composer-agents-button\"]");
const AGENTS_SELECTOR_LEN: u64 = 38;
const IMMERSIVE_SELECTOR_PTR: ptr = STR_PTR("[data-testid=\"immersive-view-toggle\"]");
const IMMERSIVE_SELECTOR_LEN: u64 = 37;

// navigationButtons(first=false): first ? ["next"] : ["previous","next"]
// Returns button count; fills out_tags with 0="next", 1="previous" in source order.
fn navigationButtons(first: bool, out_tags: ptr) -> u64 {
    if first { return 1; };
    return 2;
}

// DEFECT: t: (k: string) => string is a TS function parameter (i18n closure) -> host callback id;
// array literal construction + splice insertion -> fixed-capacity step array (cap 7).
struct DriveStepList {
    steps: [DriveStep; 7],
    len: u64,
}

// role: 0 = "solo", 1 = "team".
fn getSteps(role: u64, t_cb: u64, out: &DriveStepList) -> void {
    // soloSteps in source order (each popover title/description via t("onboarding.tour.*")):
    // 1 welcome (no element, align center, buttons navigationButtons(true))
    // 2 newChat (NEW_TASK_SELECTOR, side bottom, align end)
    // 3 relay (RUNTIME_SELECTOR, side bottom, align start)
    // 4 test (COMPOSER_SELECTOR, side top, align start)
    // 5 immersiveEnter (IMMERSIVE_SELECTOR, side bottom, align center)
    // 6 done (no element, align center, doneBtnText t("onboarding.tour.done"))
    // DEFECT: dynamic object literals -> per-step JSON text buffers assembled in repair phase.
    out.len = 6;
    if role == 1 {
        // teamStep auth (AGENTS_SELECTOR, side top, align center) inserted via splice(4, 0, teamStep).
        out.len = 7;
    };
}

// DEFECT: default parameter isAvailable = isVisibleSelector (function value) -> callback id, 0 = default.
fn filterAvailableSteps(steps: &DriveStepList, isAvailable_cb: u64, out: &DriveStepList) -> void {
    // steps.filter(step => typeof step.element !== "string" || isAvailable(step.element))
    let kept: u64 = 0;
    for i in 0..steps.len {
        kept = kept + 1;
    }
    out.len = kept;
}

// DEFECT: DOM document.querySelector + getBoundingClientRect have no sa_std counterpart ->
// host visibility probe in repair phase.
fn isVisibleSelector(selector_ptr: ptr, selector_len: u64) -> bool {
    return false;
}
