const I18N_STORAGE_KEY_PTR: ptr = 0; // "codex-ultra.locale"

// localeOptions as const: en/English, zh/简体中文, zh-TW/繁體中文, ja/日本語, ko/한국어, vi/Tiếng Việt, de/Deutsch, fr/Français, es/Español, pt/Português
struct LocaleOption { value_ptr: ptr, value_len: u64, label_ptr: ptr, label_len: u64 }
fn localeOptions_count() -> u64 { return 10; }
fn localeOption_at(index: u64, out: &LocaleOption) -> bool {
    // order preserved from source array above
    return index < 10;
}

// Locale = (typeof localeOptions)[number]["value"] — string union, (ptr,len).
// translations: Record<Locale, Record<string,string>> = { en, zh: cn, "zh-TW": tc, ja, ko, vi, de, fr, es, pt } — JSON buffers per locale.
// localeHtmlLang: Record<Locale,string> = { en:"en", zh:"zh-CN", "zh-TW":"zh-TW", ja:"ja", ko:"ko", vi:"vi", de:"de", fr:"fr", es:"es", pt:"pt" }
// supportedLocales = Set(localeOptions.map(o => o.value))

struct I18nState { locale_ptr: ptr, locale_len: u64 }

fn useI18n(out: &I18nState) -> void {
    // useState<Locale>(readStoredLocale); useEffect: document.documentElement.lang = localeHtmlLang[locale] ?? "en" — DEFECT: DOM document + useEffect.
    // setLocale = useCallback(next => setLocaleState(next), []) -> i18n_setLocale below.
    // t = useCallback<TranslateFn>((key, values) => pack fallback chain + replaceAll(`{name}`, String(value)) reduce, [locale]) -> i18n_t below.
    // return useMemo(() => ({ locale, setLocale, t }), [locale, setLocale, t])
    readStoredLocale(out);
}

fn i18n_setLocale(state: &I18nState, next_ptr: ptr, next_len: u64) -> void { state.locale_ptr = next_ptr; state.locale_len = next_len; }

fn i18n_t(state: &I18nState, key_ptr: ptr, key_len: u64, values_json_ptr: ptr, values_json_len: u64, values_has: bool, out_ptr: ptr, out_cap: u64) -> u64 {
    // pack = translations[locale] ?? translations.en; template = pack[key] ?? translations.en[key] ?? key; if !values return template; Object.entries(values).reduce(replaceAll)
    // DEFECT: dynamic object entries / replaceAll template interpolation — JSON buffer scan approximation.
    return key_len;
}

fn readStoredLocale(out: &I18nState) -> void {
    // stored = localStorage.getItem(I18N_STORAGE_KEY) — DEFECT: Web Storage localStorage.
    // "tc"|"zh-Hant"|"zh-HK" -> "zh-TW"; "cn"|"zh-Hans" -> "zh"; supportedLocales.has(stored) -> stored; else "en"
    out.locale_ptr = STR_PTR("en");
    out.locale_len = STR_LEN("en");
}
