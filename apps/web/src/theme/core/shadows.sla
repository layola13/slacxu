// Converted 1:1 from apps/web/src/theme/core/shadows.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "sa_std/ptr.sa"
@import "sa_std/string.sa"

// TS: import type { Shadows } from "@mui/material/styles";
// DEFECT: MUI Shadows tuple type (25 CSS shadow strings) has no SLA counterpart; approximated as indexed accessor.
// TS: const baseShadows: Shadows = [ "none", ...24 entries... ] (source lines 3-28, values preserved verbatim below)
fn base_shadow_count() -> u64 { return 25; }
fn base_shadow_at(idx: u64, out_len: &u64) -> ptr {
    if idx == 0 { *out_len = STR_LEN("none"); return STR_PTR("none"); };
    if idx == 1 { *out_len = STR_LEN("0px 2px 1px -1px rgba(145, 158, 171, 0.2), 0px 1px 1px 0px rgba(145, 158, 171, 0.14), 0px 1px 3px 0px rgba(145, 158, 171, 0.12)"); return STR_PTR("0px 2px 1px -1px rgba(145, 158, 171, 0.2), 0px 1px 1px 0px rgba(145, 158, 171, 0.14), 0px 1px 3px 0px rgba(145, 158, 171, 0.12)"); };
    if idx == 2 { *out_len = STR_LEN("0px 3px 1px -2px rgba(145, 158, 171, 0.2), 0px 2px 2px 0px rgba(145, 158, 171, 0.14), 0px 1px 5px 0px rgba(145, 158, 171, 0.12)"); return STR_PTR("0px 3px 1px -2px rgba(145, 158, 171, 0.2), 0px 2px 2px 0px rgba(145, 158, 171, 0.14), 0px 1px 5px 0px rgba(145, 158, 171, 0.12)"); };
    if idx == 3 { *out_len = STR_LEN("0px 3px 3px -2px rgba(145, 158, 171, 0.2), 0px 3px 4px 0px rgba(145, 158, 171, 0.14), 0px 1px 8px 0px rgba(145, 158, 171, 0.12)"); return STR_PTR("0px 3px 3px -2px rgba(145, 158, 171, 0.2), 0px 3px 4px 0px rgba(145, 158, 171, 0.14), 0px 1px 8px 0px rgba(145, 158, 171, 0.12)"); };
    if idx == 4 { *out_len = STR_LEN("0px 2px 4px -1px rgba(145, 158, 171, 0.2), 0px 4px 5px 0px rgba(145, 158, 171, 0.14), 0px 1px 10px 0px rgba(145, 158, 171, 0.12)"); return STR_PTR("0px 2px 4px -1px rgba(145, 158, 171, 0.2), 0px 4px 5px 0px rgba(145, 158, 171, 0.14), 0px 1px 10px 0px rgba(145, 158, 171, 0.12)"); };
    if idx == 5 { *out_len = STR_LEN("0px 3px 5px -1px rgba(145, 158, 171, 0.2), 0px 5px 8px 0px rgba(145, 158, 171, 0.14), 0px 1px 14px 0px rgba(145, 158, 171, 0.12)"); return STR_PTR("0px 3px 5px -1px rgba(145, 158, 171, 0.2), 0px 5px 8px 0px rgba(145, 158, 171, 0.14), 0px 1px 14px 0px rgba(145, 158, 171, 0.12)"); };
    if idx == 6 { *out_len = STR_LEN("0px 3px 5px -1px rgba(145, 158, 171, 0.2), 0px 6px 10px 0px rgba(145, 158, 171, 0.14), 0px 1px 18px 0px rgba(145, 158, 171, 0.12)"); return STR_PTR("0px 3px 5px -1px rgba(145, 158, 171, 0.2), 0px 6px 10px 0px rgba(145, 158, 171, 0.14), 0px 1px 18px 0px rgba(145, 158, 171, 0.12)"); };
    if idx == 7 { *out_len = STR_LEN("0px 4px 5px -2px rgba(145, 158, 171, 0.2), 0px 7px 10px 1px rgba(145, 158, 171, 0.14), 0px 2px 16px 1px rgba(145, 158, 171, 0.12)"); return STR_PTR("0px 4px 5px -2px rgba(145, 158, 171, 0.2), 0px 7px 10px 1px rgba(145, 158, 171, 0.14), 0px 2px 16px 1px rgba(145, 158, 171, 0.12)"); };
    if idx == 8 { *out_len = STR_LEN("0px 5px 5px -3px rgba(145, 158, 171, 0.2), 0px 8px 10px 1px rgba(145, 158, 171, 0.14), 0px 3px 14px 2px rgba(145, 158, 171, 0.12)"); return STR_PTR("0px 5px 5px -3px rgba(145, 158, 171, 0.2), 0px 8px 10px 1px rgba(145, 158, 171, 0.14), 0px 3px 14px 2px rgba(145, 158, 171, 0.12)"); };
    if idx == 9 { *out_len = STR_LEN("0px 5px 6px -3px rgba(145, 158, 171, 0.2), 0px 9px 12px 1px rgba(145, 158, 171, 0.14), 0px 3px 16px 2px rgba(145, 158, 171, 0.12)"); return STR_PTR("0px 5px 6px -3px rgba(145, 158, 171, 0.2), 0px 9px 12px 1px rgba(145, 158, 171, 0.14), 0px 3px 16px 2px rgba(145, 158, 171, 0.12)"); };
    if idx == 10 { *out_len = STR_LEN("0px 6px 6px -3px rgba(145, 158, 171, 0.2), 0px 10px 14px 1px rgba(145, 158, 171, 0.14), 0px 4px 18px 3px rgba(145, 158, 171, 0.12)"); return STR_PTR("0px 6px 6px -3px rgba(145, 158, 171, 0.2), 0px 10px 14px 1px rgba(145, 158, 171, 0.14), 0px 4px 18px 3px rgba(145, 158, 171, 0.12)"); };
    if idx == 11 { *out_len = STR_LEN("0px 6px 7px -4px rgba(145, 158, 171, 0.2), 0px 11px 15px 1px rgba(145, 158, 171, 0.14), 0px 4px 20px 3px rgba(145, 158, 171, 0.12)"); return STR_PTR("0px 6px 7px -4px rgba(145, 158, 171, 0.2), 0px 11px 15px 1px rgba(145, 158, 171, 0.14), 0px 4px 20px 3px rgba(145, 158, 171, 0.12)"); };
    if idx == 12 { *out_len = STR_LEN("0px 7px 8px -4px rgba(145, 158, 171, 0.2), 0px 12px 17px 2px rgba(145, 158, 171, 0.14), 0px 5px 22px 4px rgba(145, 158, 171, 0.12)"); return STR_PTR("0px 7px 8px -4px rgba(145, 158, 171, 0.2), 0px 12px 17px 2px rgba(145, 158, 171, 0.14), 0px 5px 22px 4px rgba(145, 158, 171, 0.12)"); };
    if idx == 13 { *out_len = STR_LEN("0px 7px 8px -4px rgba(145, 158, 171, 0.2), 0px 13px 19px 2px rgba(145, 158, 171, 0.14), 0px 5px 24px 4px rgba(145, 158, 171, 0.12)"); return STR_PTR("0px 7px 8px -4px rgba(145, 158, 171, 0.2), 0px 13px 19px 2px rgba(145, 158, 171, 0.14), 0px 5px 24px 4px rgba(145, 158, 171, 0.12)"); };
    if idx == 14 { *out_len = STR_LEN("0px 7px 9px -4px rgba(145, 158, 171, 0.2), 0px 14px 21px 2px rgba(145, 158, 171, 0.14), 0px 5px 26px 4px rgba(145, 158, 171, 0.12)"); return STR_PTR("0px 7px 9px -4px rgba(145, 158, 171, 0.2), 0px 14px 21px 2px rgba(145, 158, 171, 0.14), 0px 5px 26px 4px rgba(145, 158, 171, 0.12)"); };
    if idx == 15 { *out_len = STR_LEN("0px 8px 9px -5px rgba(145, 158, 171, 0.2), 0px 15px 22px 2px rgba(145, 158, 171, 0.14), 0px 6px 28px 5px rgba(145, 158, 171, 0.12)"); return STR_PTR("0px 8px 9px -5px rgba(145, 158, 171, 0.2), 0px 15px 22px 2px rgba(145, 158, 171, 0.14), 0px 6px 28px 5px rgba(145, 158, 171, 0.12)"); };
    if idx == 16 { *out_len = STR_LEN("0px 8px 10px -5px rgba(145, 158, 171, 0.2), 0px 16px 24px 2px rgba(145, 158, 171, 0.14), 0px 6px 30px 5px rgba(145, 158, 171, 0.12)"); return STR_PTR("0px 8px 10px -5px rgba(145, 158, 171, 0.2), 0px 16px 24px 2px rgba(145, 158, 171, 0.14), 0px 6px 30px 5px rgba(145, 158, 171, 0.12)"); };
    if idx == 17 { *out_len = STR_LEN("0px 8px 11px -5px rgba(145, 158, 171, 0.2), 0px 17px 26px 2px rgba(145, 158, 171, 0.14), 0px 6px 32px 5px rgba(145, 158, 171, 0.12)"); return STR_PTR("0px 8px 11px -5px rgba(145, 158, 171, 0.2), 0px 17px 26px 2px rgba(145, 158, 171, 0.14), 0px 6px 32px 5px rgba(145, 158, 171, 0.12)"); };
    if idx == 18 { *out_len = STR_LEN("0px 9px 11px -5px rgba(145, 158, 171, 0.2), 0px 18px 28px 2px rgba(145, 158, 171, 0.14), 0px 7px 34px 6px rgba(145, 158, 171, 0.12)"); return STR_PTR("0px 9px 11px -5px rgba(145, 158, 171, 0.2), 0px 18px 28px 2px rgba(145, 158, 171, 0.14), 0px 7px 34px 6px rgba(145, 158, 171, 0.12)"); };
    if idx == 19 { *out_len = STR_LEN("0px 9px 12px -6px rgba(145, 158, 171, 0.2), 0px 19px 29px 2px rgba(145, 158, 171, 0.14), 0px 7px 36px 6px rgba(145, 158, 171, 0.12)"); return STR_PTR("0px 9px 12px -6px rgba(145, 158, 171, 0.2), 0px 19px 29px 2px rgba(145, 158, 171, 0.14), 0px 7px 36px 6px rgba(145, 158, 171, 0.12)"); };
    if idx == 20 { *out_len = STR_LEN("0px 10px 13px -6px rgba(145, 158, 171, 0.2), 0px 20px 31px 3px rgba(145, 158, 171, 0.14), 0px 8px 38px 7px rgba(145, 158, 171, 0.12)"); return STR_PTR("0px 10px 13px -6px rgba(145, 158, 171, 0.2), 0px 20px 31px 3px rgba(145, 158, 171, 0.14), 0px 8px 38px 7px rgba(145, 158, 171, 0.12)"); };
    if idx == 21 { *out_len = STR_LEN("0px 10px 13px -6px rgba(145, 158, 171, 0.2), 0px 21px 33px 3px rgba(145, 158, 171, 0.14), 0px 8px 40px 7px rgba(145, 158, 171, 0.12)"); return STR_PTR("0px 10px 13px -6px rgba(145, 158, 171, 0.2), 0px 21px 33px 3px rgba(145, 158, 171, 0.14), 0px 8px 40px 7px rgba(145, 158, 171, 0.12)"); };
    if idx == 22 { *out_len = STR_LEN("0px 10px 14px -6px rgba(145, 158, 171, 0.2), 0px 22px 35px 3px rgba(145, 158, 171, 0.14), 0px 8px 42px 7px rgba(145, 158, 171, 0.12)"); return STR_PTR("0px 10px 14px -6px rgba(145, 158, 171, 0.2), 0px 22px 35px 3px rgba(145, 158, 171, 0.14), 0px 8px 42px 7px rgba(145, 158, 171, 0.12)"); };
    if idx == 23 { *out_len = STR_LEN("0px 11px 14px -7px rgba(145, 158, 171, 0.2), 0px 23px 36px 3px rgba(145, 158, 171, 0.14), 0px 9px 44px 8px rgba(145, 158, 171, 0.12)"); return STR_PTR("0px 11px 14px -7px rgba(145, 158, 171, 0.2), 0px 23px 36px 3px rgba(145, 158, 171, 0.14), 0px 9px 44px 8px rgba(145, 158, 171, 0.12)"); };
    *out_len = STR_LEN("0px 11px 15px -7px rgba(145, 158, 171, 0.2), 0px 24px 38px 3px rgba(145, 158, 171, 0.14), 0px 9px 46px 8px rgba(145, 158, 171, 0.12)");
    return STR_PTR("0px 11px 15px -7px rgba(145, 158, 171, 0.2), 0px 24px 38px 3px rgba(145, 158, 171, 0.14), 0px 9px 46px 8px rgba(145, 158, 171, 0.12)");
}

// TS: export const shadows = { light: baseShadows, dark: baseShadows };
// Both modes alias the same array in TS; SLA keeps two accessors delegating to base_shadow_at.
fn shadows_light_at(idx: u64, out_len: &u64) -> ptr { return base_shadow_at(idx, out_len); }
fn shadows_dark_at(idx: u64, out_len: &u64) -> ptr { return base_shadow_at(idx, out_len); }
