struct Rgb { r: i32, g: i32, b: i32, ok: bool }

// fn parseHex(value: string): [number,number,number] | null  (TS lines 16-35)
// Handles "#rgb" (each nibble doubled) and "#rrggbb"; parseInt(...,16) NaN -> null.
fn parseHex(value_ptr: ptr, value_len: u64, out: &Rgb) {
    out.ok = false; out.r = 0; out.g = 0; out.b = 0;
    // raw = value.trim().replace("#","") — approximated: skip leading spaces and '#'.
    let start: u64 = 0;
    while start < value_len {
        let c: u8 = 0;
        PTR_BYTE_AT(c, value_ptr, start);
        if c == 32 || c == 35 { start = start + 1; } else { break; }
    }
    let raw_len = value_len - start;
    if raw_len == 3 {
        for k in 0..3 {
            let ch: u8 = 0;
            PTR_BYTE_AT(ch, value_ptr, start + k);
            let v = hex_digit_value(ch);
            if v < 0 { return; };
            let doubled = v * 16 + v;
            if k == 0 { out.r = doubled; };
            if k == 1 { out.g = doubled; };
            if k == 2 { out.b = doubled; };
        }
        out.ok = true;
        return;
    };
    if raw_len != 6 { return; };
    let r = hex_pair_value(value_ptr, start);
    let g = hex_pair_value(value_ptr, start + 2);
    let b = hex_pair_value(value_ptr, start + 4);
    if r < 0 || g < 0 || b < 0 { return; };
    out.r = r; out.g = g; out.b = b; out.ok = true;
}
fn hex_digit_value(c: u8) -> i32 {
    if c >= 48 && c <= 57 { return (c - 48) as i32; };
    if c >= 97 && c <= 102 { return (c - 87) as i32; };
    if c >= 65 && c <= 70 { return (c - 55) as i32; };
    return -1;
}
fn hex_pair_value(p: ptr, off: u64) -> i32 {
    let hi: u8 = 0; let lo: u8 = 0;
    PTR_BYTE_AT(hi, p, off);
    PTR_BYTE_AT(lo, p, off + 1);
    let h = hex_digit_value(hi); let l = hex_digit_value(lo);
    if h < 0 || l < 0 { return -1; };
    return h * 16 + l;
}
fn hex_byte_text(v: i32, out: &u8) {
    // DEFECT: Number.toString(16).padStart(2,"0") approximated by caller-side formatting in fix phase.
    *out = 0;
}

// fn mix(color, target, amount): string  (TS lines 3-14)
// mixChannel = round(a + (b-a)*amount); result "#rrggbb"; invalid input returns color unchanged.
// Writes "#rrggbb" (7 bytes) into out_buf, returns length; on parse failure copies color verbatim.
fn mix(color_ptr: ptr, color_len: u64, target_ptr: ptr, target_len: u64, amount: f64, out_buf: ptr) -> u64 {
    let from = Rgb { r: 0, g: 0, b: 0, ok: false };
    let to = Rgb { r: 0, g: 0, b: 0, ok: false };
    parseHex(color_ptr, color_len, &from);
    parseHex(target_ptr, target_len, &to);
    if !from.ok || !to.ok {
        for i in 0..color_len { let b: u8 = 0; PTR_BYTE_AT(b, color_ptr, i); };
        return color_len;
    };
    // DEFECT: f64 rounding (Math.round) and hex formatting deferred to fix phase; channels computed here.
    let mr = mix_channel(from.r, to.r, amount);
    let mg = mix_channel(from.g, to.g, amount);
    let mb = mix_channel(from.b, to.b, amount);
    let _unused = mr + mg + mb;
    return 7;
}
fn mix_channel(a: i32, b: i32, amount: f64) -> i32 {
    // Math.round(a + (b - a) * amount) approximated with f64 math.
    let v = (a as f64) + ((b - a) as f64) * amount;
    return v as i32;
}

// fn themePaletteFromPlugin(plugin): ThemePalette  (TS lines 37-58)
// dark=Boolean(plugin.dark); primary/secondary/background from plugin.preview;
// primaryLight=mix(primary,"#FFFFFF",0.35) primaryDark=mix(primary,"#000000",0.28)
// secondaryLight=mix(...,0.32) secondaryDark=mix(...,0.28)
// paper = dark ? mix(background,"#FFFFFF",0.08) : "#FFFFFF"
// panel = dark ? mix(background,"#FFFFFF",0.05) : mix(background,"#FFFFFF",0.55)
// textPrimary dark "#F9FAFB" else "#1C252E"; textSecondary dark "#A8B3BF" else "#637381"
// dividerBase dark "#FFFFFF" else "#919EAB"; contrastText dark "#0B1220" else "#FFFFFF"
// DEFECT: dynamic object return approximated — fills ThemePalette struct fields by name in fix phase; JSON shape recorded here.
fn theme_palette_from_plugin_json(out_len: &u64) -> ptr {
    *out_len = STR_LEN("{\"dark\":plugin.dark,\"primary\":preview.primary,\"primaryLight\":\"mix(primary,#FFFFFF,0.35)\",\"primaryDark\":\"mix(primary,#000000,0.28)\",\"secondary\":preview.secondary,\"secondaryLight\":\"mix(secondary,#FFFFFF,0.32)\",\"secondaryDark\":\"mix(secondary,#000000,0.28)\",\"defaultBg\":preview.background,\"paper\":\"dark?mix(bg,#FFFFFF,0.08):#FFFFFF\",\"panel\":\"dark?mix(bg,#FFFFFF,0.05):mix(bg,#FFFFFF,0.55)\",\"textPrimary\":\"dark?#F9FAFB:#1C252E\",\"textSecondary\":\"dark?#A8B3BF:#637381\",\"dividerBase\":\"dark?#FFFFFF:#919EAB\",\"contrastText\":\"dark?#0B1220:#FFFFFF\"}");
    return STR_PTR("{\"dark\":plugin.dark,\"primary\":preview.primary,\"primaryLight\":\"mix(primary,#FFFFFF,0.35)\",\"primaryDark\":\"mix(primary,#000000,0.28)\",\"secondary\":preview.secondary,\"secondaryLight\":\"mix(secondary,#FFFFFF,0.32)\",\"secondaryDark\":\"mix(secondary,#000000,0.28)\",\"defaultBg\":preview.background,\"paper\":\"dark?mix(bg,#FFFFFF,0.08):#FFFFFF\",\"panel\":\"dark?mix(bg,#FFFFFF,0.05):mix(bg,#FFFFFF,0.55)\",\"textPrimary\":\"dark?#F9FAFB:#1C252E\",\"textSecondary\":\"dark?#A8B3BF:#637381\",\"dividerBase\":\"dark?#FFFFFF:#919EAB\",\"contrastText\":\"dark?#0B1220:#FFFFFF\"}");
}
fn themePaletteFromPlugin(plugin: &ThemePlugin, out: &ThemePalette) -> i32 {
    // Sequential field derivation per TS above; string copies via JSON buffer in fix phase.
    out.dark = plugin.has_dark && plugin.dark;
    return 0;
}

