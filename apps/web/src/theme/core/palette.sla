    if mode_len == STR_LEN("violet-night") { *out_len = STR_LEN("{\"dark\":true,\"primary\":\"#8B5CF6\",\"primaryLight\":\"#C4B5FD\",\"primaryDark\":\"#6D28D9\",\"secondary\":\"#C4B5FD\",\"secondaryLight\":\"#DDD6FE\",\"secondaryDark\":\"#8B5CF6\",\"defaultBg\":\"#121215\",\"paper\":\"#1A1A20\",\"panel\":\"#22222A\",\"textPrimary\":\"#F2F2F7\",\"textSecondary\":\"#B9B9CD\",\"dividerBase\":\"#4A4A58\",\"contrastText\":\"#FFFFFF\"}"); return STR_PTR("{\"dark\":true,\"primary\":\"#8B5CF6\",\"primaryLight\":\"#C4B5FD\",\"primaryDark\":\"#6D28D9\",\"secondary\":\"#C4B5FD\",\"secondaryLight\":\"#DDD6FE\",\"secondaryDark\":\"#8B5CF6\",\"defaultBg\":\"#121215\",\"paper\":\"#1A1A20\",\"panel\":\"#22222A\",\"textPrimary\":\"#F2F2F7\",\"textSecondary\":\"#B9B9CD\",\"dividerBase\":\"#4A4A58\",\"contrastText\":\"#FFFFFF\"}"); };
