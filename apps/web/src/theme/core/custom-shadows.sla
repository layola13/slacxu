@import "sa_std/ptr.sa"
@import "sa_std/string.sa"

// TS: export interface CustomShadows { z1?, z4?, z8?, z12?, z16?, z20?, z24?, primary?, secondary?, card?, dialog?, dropdown? } (all optional strings)
struct CustomShadows {
    has_z1: bool, z1: [u8; 128], z1_len: u64,
    has_z4: bool, z4: [u8; 128], z4_len: u64,
    has_z8: bool, z8: [u8; 128], z8_len: u64,
    has_z12: bool, z12: [u8; 128], z12_len: u64,
    has_z16: bool, z16: [u8; 128], z16_len: u64,
    has_z20: bool, z20: [u8; 128], z20_len: u64,
    has_z24: bool, z24: [u8; 128], z24_len: u64,
    has_primary: bool, primary: [u8; 128], primary_len: u64,
    has_secondary: bool, secondary: [u8; 128], secondary_len: u64,
    has_card: bool, card: [u8; 192], card_len: u64,
    has_dialog: bool, dialog: [u8; 128], dialog_len: u64,
    has_dropdown: bool, dropdown: [u8; 192], dropdown_len: u64,
}

// TS: export const customShadows = { light: {...}, dark: {...} }
// DEFECT: dynamic object literal has no SLA counterpart; values preserved as JSON text buffers + per-key accessors.
fn custom_shadows_light_json(out_len: &u64) -> ptr {
    *out_len = STR_LEN("{\"z1\":\"0 1px 2px 0 rgba(145, 158, 171, 0.16)\",\"z4\":\"0 4px 8px 0 rgba(145, 158, 171, 0.16)\",\"z8\":\"0 8px 16px 0 rgba(145, 158, 171, 0.16)\",\"z12\":\"0 12px 24px -4px rgba(145, 158, 171, 0.16)\",\"z16\":\"0 16px 32px -4px rgba(145, 158, 171, 0.16)\",\"z20\":\"0 20px 40px -4px rgba(145, 158, 171, 0.16)\",\"z24\":\"0 24px 48px 0 rgba(145, 158, 171, 0.16)\",\"dialog\":\"-40px 40px 80px -8px rgba(0, 0, 0, 0.24)\",\"card\":\"0 0 2px 0 rgba(145, 158, 171, 0.2), 0 12px 24px -4px rgba(145, 158, 171, 0.12)\",\"dropdown\":\"0 0 2px 0 rgba(145, 158, 171, 0.24), -20px 20px 40px -4px rgba(145, 158, 171, 0.24)\",\"primary\":\"0 8px 16px 0 rgba(24, 119, 242, 0.24)\",\"secondary\":\"0 8px 16px 0 rgba(142, 51, 255, 0.24)\"}");
    return STR_PTR("{\"z1\":\"0 1px 2px 0 rgba(145, 158, 171, 0.16)\",\"z4\":\"0 4px 8px 0 rgba(145, 158, 171, 0.16)\",\"z8\":\"0 8px 16px 0 rgba(145, 158, 171, 0.16)\",\"z12\":\"0 12px 24px -4px rgba(145, 158, 171, 0.16)\",\"z16\":\"0 16px 32px -4px rgba(145, 158, 171, 0.16)\",\"z20\":\"0 20px 40px -4px rgba(145, 158, 171, 0.16)\",\"z24\":\"0 24px 48px 0 rgba(145, 158, 171, 0.16)\",\"dialog\":\"-40px 40px 80px -8px rgba(0, 0, 0, 0.24)\",\"card\":\"0 0 2px 0 rgba(145, 158, 171, 0.2), 0 12px 24px -4px rgba(145, 158, 171, 0.12)\",\"dropdown\":\"0 0 2px 0 rgba(145, 158, 171, 0.24), -20px 20px 40px -4px rgba(145, 158, 171, 0.24)\",\"primary\":\"0 8px 16px 0 rgba(24, 119, 242, 0.24)\",\"secondary\":\"0 8px 16px 0 rgba(142, 51, 255, 0.24)\"}");
}
fn custom_shadows_dark_json(out_len: &u64) -> ptr {
    *out_len = STR_LEN("{\"z1\":\"0 1px 2px 0 rgba(0, 0, 0, 0.16)\",\"z4\":\"0 4px 8px 0 rgba(0, 0, 0, 0.16)\",\"z8\":\"0 8px 16px 0 rgba(0, 0, 0, 0.16)\",\"z12\":\"0 12px 24px -4px rgba(0, 0, 0, 0.16)\",\"z16\":\"0 16px 32px -4px rgba(0, 0, 0, 0.16)\",\"z20\":\"0 20px 40px -4px rgba(0, 0, 0, 0.16)\",\"z24\":\"0 24px 48px 0 rgba(0, 0, 0, 0.16)\",\"dialog\":\"-40px 40px 80px -8px rgba(0, 0, 0, 0.48)\",\"card\":\"0 0 2px 0 rgba(0, 0, 0, 0.4), 0 12px 24px -4px rgba(0, 0, 0, 0.24)\",\"dropdown\":\"0 0 2px 0 rgba(0, 0, 0, 0.48), -20px 20px 40px -4px rgba(0, 0, 0, 0.48)\",\"primary\":\"0 8px 16px 0 rgba(97, 243, 243, 0.24)\",\"secondary\":\"0 8px 16px 0 rgba(255, 171, 0, 0.24)\"}");
    return STR_PTR("{\"z1\":\"0 1px 2px 0 rgba(0, 0, 0, 0.16)\",\"z4\":\"0 4px 8px 0 rgba(0, 0, 0, 0.16)\",\"z8\":\"0 8px 16px 0 rgba(0, 0, 0, 0.16)\",\"z12\":\"0 12px 24px -4px rgba(0, 0, 0, 0.16)\",\"z16\":\"0 16px 32px -4px rgba(0, 0, 0, 0.16)\",\"z20\":\"0 20px 40px -4px rgba(0, 0, 0, 0.16)\",\"z24\":\"0 24px 48px 0 rgba(0, 0, 0, 0.16)\",\"dialog\":\"-40px 40px 80px -8px rgba(0, 0, 0, 0.48)\",\"card\":\"0 0 2px 0 rgba(0, 0, 0, 0.4), 0 12px 24px -4px rgba(0, 0, 0, 0.24)\",\"dropdown\":\"0 0 2px 0 rgba(0, 0, 0, 0.48), -20px 20px 40px -4px rgba(0, 0, 0, 0.48)\",\"primary\":\"0 8px 16px 0 rgba(97, 243, 243, 0.24)\",\"secondary\":\"0 8px 16px 0 rgba(255, 171, 0, 0.24)\"}");
}
// Key order in TS light/dark literals: z1,z4,z8,z12,z16,z20,z24,dialog,card,dropdown,primary,secondary.
fn custom_shadows_key_at(idx: u64, out_len: &u64) -> ptr {
    if idx == 0 { *out_len = STR_LEN("z1"); return STR_PTR("z1"); };
    if idx == 1 { *out_len = STR_LEN("z4"); return STR_PTR("z4"); };
    if idx == 2 { *out_len = STR_LEN("z8"); return STR_PTR("z8"); };
    if idx == 3 { *out_len = STR_LEN("z12"); return STR_PTR("z12"); };
    if idx == 4 { *out_len = STR_LEN("z16"); return STR_PTR("z16"); };
    if idx == 5 { *out_len = STR_LEN("z20"); return STR_PTR("z20"); };
    if idx == 6 { *out_len = STR_LEN("z24"); return STR_PTR("z24"); };
    if idx == 7 { *out_len = STR_LEN("dialog"); return STR_PTR("dialog"); };
    if idx == 8 { *out_len = STR_LEN("card"); return STR_PTR("card"); };
    if idx == 9 { *out_len = STR_LEN("dropdown"); return STR_PTR("dropdown"); };
    if idx == 10 { *out_len = STR_LEN("primary"); return STR_PTR("primary"); };
    *out_len = STR_LEN("secondary");
    return STR_PTR("secondary");
}
