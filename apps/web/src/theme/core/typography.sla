// Converted 1:1 from apps/web/src/theme/core/typography.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "sa_std/ptr.sa"
@import "sa_std/string.sa"

// TS: export const typography = { fontFamily, h1..h6, body1, body2, caption, overline, button }
// DEFECT: dynamic object / MUI TypographyVariants has no SLA counterpart; approximated as JSON text buffer + per-variant accessors.
// Variant fields preserved 1:1 from source:
//  fontFamily: "\"Plus Jakarta Sans\", \"Manrope\", \"JetBrains Mono\", Inter, \"DM Sans\", ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif"
//  h1: Jakarta, weight 800, letterSpacing "-0.02em", lineHeight 1.2
//  h2: Jakarta, 700, 1.3 | h3: Jakarta, 700, 1.3 | h4: Jakarta, 700, 1.4 | h5: Jakarta, 600, 1.4 | h6: Jakarta, 600, 1.4
//  body1: Manrope, "1rem", 1.5 | body2: Manrope, "0.875rem", 1.5 | caption: Manrope, "0.75rem", 1.5
//  overline: JetBrains Mono monospace, "0.75rem", 600, "0.1em", textTransform "uppercase" (as const)
//  button: Jakarta, textTransform "none" (as const), 700
// DEFECT: `as const` literal types have no SLA counterpart.
struct TypographyVariant {
    font_family: [u8; 256], font_family_len: u64,
    has_font_weight: bool, font_weight: i32,
    has_font_size: bool, font_size: [u8; 16], font_size_len: u64,
    has_letter_spacing: bool, letter_spacing: [u8; 16], letter_spacing_len: u64,
    has_line_height: bool, line_height: f64,
    has_text_transform: bool, text_transform: [u8; 16], text_transform_len: u64,
}

fn typography_json(out_len: &u64) -> ptr {
    *out_len = STR_LEN("typography: see variant accessors typography_variant_at (fontFamily,h1,h2,h3,h4,h5,h6,body1,body2,caption,overline,button)");
    return STR_PTR("typography: see variant accessors typography_variant_at (fontFamily,h1,h2,h3,h4,h5,h6,body1,body2,caption,overline,button)");
}
fn typography_variant_count() -> u64 { return 11; }
fn typography_variant_name_at(idx: u64, out_len: &u64) -> ptr {
    if idx == 0 { *out_len = STR_LEN("h1"); return STR_PTR("h1"); };
    if idx == 1 { *out_len = STR_LEN("h2"); return STR_PTR("h2"); };
    if idx == 2 { *out_len = STR_LEN("h3"); return STR_PTR("h3"); };
    if idx == 3 { *out_len = STR_LEN("h4"); return STR_PTR("h4"); };
    if idx == 4 { *out_len = STR_LEN("h5"); return STR_PTR("h5"); };
    if idx == 5 { *out_len = STR_LEN("h6"); return STR_PTR("h6"); };
    if idx == 6 { *out_len = STR_LEN("body1"); return STR_PTR("body1"); };
    if idx == 7 { *out_len = STR_LEN("body2"); return STR_PTR("body2"); };
    if idx == 8 { *out_len = STR_LEN("caption"); return STR_PTR("caption"); };
    if idx == 9 { *out_len = STR_LEN("overline"); return STR_PTR("overline"); };
    *out_len = STR_LEN("button");
    return STR_PTR("button");
}
fn typography_font_family(out_len: &u64) -> ptr {
    *out_len = STR_LEN("\"Plus Jakarta Sans\", \"Manrope\", \"JetBrains Mono\", Inter, \"DM Sans\", ui-sans-serif, system-ui, sans-serif");
    return STR_PTR("\"Plus Jakarta Sans\", \"Manrope\", \"JetBrains Mono\", Inter, \"DM Sans\", ui-sans-serif, system-ui, sans-serif");
}
// Per-variant numeric facts (fontWeight, lineHeight) in source order h1..button; -1 / 0 means absent in TS.
fn typography_variant_font_weight(idx: u64) -> i32 {
    if idx == 0 { return 800; };
    if idx == 1 { return 700; };
    if idx == 2 { return 700; };
    if idx == 3 { return 700; };
    if idx == 4 { return 600; };
    if idx == 5 { return 600; };
    if idx == 9 { return 600; };
    if idx == 10 { return 700; };
    return -1;
}
fn typography_variant_line_height_x100(idx: u64) -> i32 {
    if idx == 0 { return 120; };
    if idx == 1 { return 130; };
    if idx == 2 { return 130; };
    if idx == 3 { return 140; };
    if idx == 4 { return 140; };
    if idx == 5 { return 140; };
    if idx == 6 { return 150; };
    if idx == 7 { return 150; };
    if idx == 8 { return 150; };
    return 0;
}
