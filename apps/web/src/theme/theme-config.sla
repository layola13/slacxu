    if idx == 16 { *out_len = STR_LEN("studio-black-gold"); return STR_PTR("studio-black-gold"); };
    if idx == 17 { *out_len = STR_LEN("glass-blue"); return STR_PTR("glass-blue"); };
    *out_len = STR_LEN("chatgpt");
    return STR_PTR("chatgpt");
