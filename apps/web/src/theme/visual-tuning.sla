// TS: export type ThemeVisualTuning = { backgroundLayerOpacity, backgroundOverlayOpacity, effectsLayerOpacity, workspaceSurfaceOpacity, heroOverlayOpacity, panelSurfaceOpacity, blurStrength, toneColor: string, toneOpacity } (numbers except toneColor)
struct ThemeVisualTuning {
    background_layer_opacity: f64,
    background_overlay_opacity: f64,
    effects_layer_opacity: f64,
    workspace_surface_opacity: f64,
    hero_overlay_opacity: f64,
    panel_surface_opacity: f64,
    blur_strength: f64,
    tone_color: [u8; 32], tone_color_len: u64,
    tone_opacity: f64,
}

// TS: export const REFERENCE_BACKGROUND_TUNING = { 1, 0, 0, 0.16, 0.22, 0.78, blur 10, "#D94F75", 0 }
fn reference_background_tuning(out: &ThemeVisualTuning) {
    out.background_layer_opacity = 1.0; out.background_overlay_opacity = 0.0; out.effects_layer_opacity = 0.0;
    out.workspace_surface_opacity = 0.16; out.hero_overlay_opacity = 0.22; out.panel_surface_opacity = 0.78;
    out.blur_strength = 10.0; out.tone_color_len = STR_LEN("#D94F75"); out.tone_opacity = 0.0;
}
// TS: const STANDARD_SURFACE_TUNING = { 1, 0.45, 0, 0.72, 0.64, 0.82, blur 22, "#1877F2", 0.08 } (not exported)
fn standard_surface_tuning(out: &ThemeVisualTuning) {
    out.background_layer_opacity = 1.0; out.background_overlay_opacity = 0.45; out.effects_layer_opacity = 0.0;
    out.workspace_surface_opacity = 0.72; out.hero_overlay_opacity = 0.64; out.panel_surface_opacity = 0.82;
    out.blur_strength = 22.0; out.tone_color_len = STR_LEN("#1877F2"); out.tone_opacity = 0.08;
}

// fn clampRange(value: unknown, fallback, min, max): number  (TS lines 86-94; defined last, used throughout)
// DEFECT: unknown/Number(value) coercion + Number.isFinite approximated: caller passes (has_number, f64); non-finite -> fallback; else min(max, max(min, v)).
fn clampRange(has_number: bool, number_value: f64, is_finite: bool, fallback: f64, min_v: f64, max_v: f64) -> f64 {
    if !has_number || !is_finite { return fallback; };
    if number_value < min_v { return min_v; };
    if number_value > max_v { return max_v; };
    return number_value;
}
fn clampUnit(has_number: bool, number_value: f64, is_finite: bool, fallback: f64) -> f64 {
    return clampRange(has_number, number_value, is_finite, fallback, 0.0, 1.0);
}

// TS: export function isHexColor(value: unknown): value is string — typeof string && /^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$/.test(value.trim())
// DEFECT: RegExp has no SLA counterpart; approximated with manual scan (trim, '#', len 4 or 7, hex digits).
fn isHexColor(is_string: bool, value_ptr: ptr, value_len: u64) -> bool {
    if !is_string { return false; };
    let start: u64 = 0;
    let end = value_len;
    while start < end { let c: u8 = 0; PTR_BYTE_AT(c, value_ptr, start); if c == 32 { start = start + 1; } else { break; } }
    while end > start { let c: u8 = 0; PTR_BYTE_AT(c, value_ptr, end - 1); if c == 32 { end = end - 1; } else { break; } }
    let n = end - start;
    if n != 4 && n != 7 { return false; };
    let hash: u8 = 0; PTR_BYTE_AT(hash, value_ptr, start);
    if hash != 35 { return false; };
    for i in 1..n {
        let c: u8 = 0; PTR_BYTE_AT(c, value_ptr, start + i);
        let ok = (c >= 48 && c <= 57) || (c >= 97 && c <= 102) || (c >= 65 && c <= 70);
        if !ok { return false; };
    }
    return true;
}

// TS: export function themeVisualTuning(plugin?: ThemePlugin | null): ThemeVisualTuning (TS lines 36-61)
// hasUserMedia = Boolean(assets.appBackgroundImage || appBackgroundVideo || composerBackgroundImage || welcomeBackgroundImage || historyBackgroundImage || heroImage)
// defaults = hasUserMedia ? REFERENCE : STANDARD; layout = plugin?.layout ?? {}
// previewTone = plugin?.preview && isHexColor(preview.primary) ? preview.primary : defaults.toneColor
// each opacity = clampUnit(layout.X, defaults.X); blur = clampRange(layout.blurStrength, defaults.blur, 0, 40)
// toneColor = isHexColor(layout.toneColor) ? layout.toneColor : previewTone
// DEFECT: optional chaining / nullish coalescing approximated with has_* flags on ThemePlugin (types.sla).
fn themeVisualTuning(has_plugin: bool, plugin: &ThemePlugin, out: &ThemeVisualTuning) -> i32 {
    let defaults = ThemeVisualTuning { background_layer_opacity: 0.0, background_overlay_opacity: 0.0, effects_layer_opacity: 0.0, workspace_surface_opacity: 0.0, hero_overlay_opacity: 0.0, panel_surface_opacity: 0.0, blur_strength: 0.0, tone_color: [0u8; 32], tone_color_len: 0, tone_opacity: 0.0 };
    let has_media = false;
    if has_plugin && plugin.has_assets {
        if plugin.assets.has_app_background_image || plugin.assets.has_app_background_video || plugin.assets.has_composer_background_image || plugin.assets.has_welcome_background_image || plugin.assets.has_history_background_image || plugin.assets.has_hero_image { has_media = true; };
    };
    if has_media { reference_background_tuning(&defaults); } else { standard_surface_tuning(&defaults); };
    // Layout overrides: each field uses its has_* flag as the "is number" witness (fix phase wires f64 values).
    if has_plugin && plugin.has_layout {
        out.background_layer_opacity = clampUnit(plugin.layout.has_background_layer_opacity, plugin.layout.background_layer_opacity, true, defaults.background_layer_opacity);
        out.background_overlay_opacity = clampUnit(plugin.layout.has_background_overlay_opacity, plugin.layout.background_overlay_opacity, true, defaults.background_overlay_opacity);
        out.effects_layer_opacity = clampUnit(plugin.layout.has_effects_layer_opacity, plugin.layout.effects_layer_opacity, true, defaults.effects_layer_opacity);
        out.workspace_surface_opacity = clampUnit(plugin.layout.has_workspace_surface_opacity, plugin.layout.workspace_surface_opacity, true, defaults.workspace_surface_opacity);
        out.hero_overlay_opacity = clampUnit(plugin.layout.has_hero_overlay_opacity, plugin.layout.hero_overlay_opacity, true, defaults.hero_overlay_opacity);
        out.panel_surface_opacity = clampUnit(plugin.layout.has_panel_surface_opacity, plugin.layout.panel_surface_opacity, true, defaults.panel_surface_opacity);
        out.blur_strength = clampRange(plugin.layout.has_blur_strength, plugin.layout.blur_strength, true, defaults.blur_strength, 0.0, 40.0);
        out.tone_opacity = clampUnit(plugin.layout.has_tone_opacity, plugin.layout.tone_opacity, true, defaults.tone_opacity);
    } else {
        out.background_layer_opacity = defaults.background_layer_opacity;
        out.background_overlay_opacity = defaults.background_overlay_opacity;
        out.effects_layer_opacity = defaults.effects_layer_opacity;
        out.workspace_surface_opacity = defaults.workspace_surface_opacity;
        out.hero_overlay_opacity = defaults.hero_overlay_opacity;
        out.panel_surface_opacity = defaults.panel_surface_opacity;
        out.blur_strength = defaults.blur_strength;
        out.tone_opacity = defaults.tone_opacity;
    };
    out.tone_color_len = defaults.tone_color_len;
    return 0;
}

fn percentToUnit(value: f64) -> f64 { return clampRange(true, value, true, 0.0, 0.0, 100.0) / 100.0; }
fn unitToPercent(value: f64) -> f64 {
    // Math.round(clampRange(value, 0, 0, 1) * 100) — DEFECT: Math.round approximated by +0.5 truncation in fix phase.
    return clampRange(true, value, true, 0.0, 0.0, 1.0) * 100.0;
}
fn clampThemePercent(value: f64, fallback: f64) -> f64 { return clampRange(true, value, true, fallback, 0.0, 100.0); }
fn clampThemeBlur(value: f64, fallback: f64) -> f64 { return clampRange(true, value, true, fallback, 0.0, 40.0); }
// TS default arg: clampThemeBlur(value, fallback = REFERENCE_BACKGROUND_TUNING.blurStrength = 10)
fn clampThemeBlurDefault(value: f64) -> f64 { return clampThemeBlur(value, 10.0); }
