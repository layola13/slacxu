@import "sa_std/ptr.sa"
@import "sa_std/string.sa"

// TS: export type BuiltinThemeId = "official-light" | "codex" | ... (19 literals)
// DEFECT: string-literal union type has no SLA counterpart; approximated as (ptr,len) id + index constants.
fn builtin_theme_id_count() -> u64 { return 19; }
fn builtin_theme_id_at(idx: u64, out_len: &u64) -> ptr {
    if idx == 0 { *out_len = STR_LEN("official-light"); return STR_PTR("official-light"); };
    if idx == 1 { *out_len = STR_LEN("codex"); return STR_PTR("codex"); };
    if idx == 2 { *out_len = STR_LEN("codex-light"); return STR_PTR("codex-light"); };
    if idx == 3 { *out_len = STR_LEN("codex-dark"); return STR_PTR("codex-dark"); };
    if idx == 4 { *out_len = STR_LEN("claude-warm"); return STR_PTR("claude-warm"); };
    if idx == 5 { *out_len = STR_LEN("cursor-minimal"); return STR_PTR("cursor-minimal"); };
    if idx == 6 { *out_len = STR_LEN("official-black"); return STR_PTR("official-black"); };
    if idx == 7 { *out_len = STR_LEN("dream-rose"); return STR_PTR("dream-rose"); };
    if idx == 8 { *out_len = STR_LEN("studio-black-gold"); return STR_PTR("studio-black-gold"); };
    if idx == 9 { *out_len = STR_LEN("glass-blue"); return STR_PTR("glass-blue"); };
    if idx == 10 { *out_len = STR_LEN("atmospheric-codex"); return STR_PTR("atmospheric-codex"); };
    if idx == 11 { *out_len = STR_LEN("dollar-green"); return STR_PTR("dollar-green"); };
    if idx == 12 { *out_len = STR_LEN("sakura-pink"); return STR_PTR("sakura-pink"); };
    if idx == 13 { *out_len = STR_LEN("developer-leaf"); return STR_PTR("developer-leaf"); };
    if idx == 14 { *out_len = STR_LEN("violet-night"); return STR_PTR("violet-night"); };
    if idx == 15 { *out_len = STR_LEN("midnight-cyan"); return STR_PTR("midnight-cyan"); };
    if idx == 16 { *out_len = STR_LEN("neon-terminal"); return STR_PTR("neon-terminal"); };
    if idx == 17 { *out_len = STR_LEN("clean-dawn"); return STR_PTR("clean-dawn"); };
    *out_len = STR_LEN("chatgpt");
    return STR_PTR("chatgpt");
}

// TS: export type ThemeId = BuiltinThemeId | (string & {});  ThemeMode = ThemeId | "system"
