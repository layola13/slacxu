// TS: export function installedThemePluginDefaults(): ThemeId[] {
//   return themePlugins.filter(p => p.installedByDefault).map(p => p.id); }
// DEFECT: Array.filter/map with closures approximated as sequential loop over theme_plugin_* accessors; result written as JSON array text (ids in source order).
fn installedThemePluginDefaults(out_len: &u64) -> ptr {
    let count: u64 = 0;
    for i in 0..19 {
        if theme_plugin_installed_by_default(i) { count = count + 1; };
    }
    // 16 defaults: all except dream-rose(15), studio-black-gold(16), glass-blue(17) -> count == 16
    *out_len = STR_LEN("[\"official-light\",\"codex\",\"codex-light\",\"codex-dark\",\"official-black\",\"claude-warm\",\"cursor-minimal\",\"atmospheric-codex\",\"dollar-green\",\"sakura-pink\",\"developer-leaf\",\"violet-night\",\"midnight-cyan\",\"neon-terminal\",\"clean-dawn\",\"chatgpt\"]");
    return STR_PTR("[\"official-light\",\"codex\",\"codex-light\",\"codex-dark\",\"official-black\",\"claude-warm\",\"cursor-minimal\",\"atmospheric-codex\",\"dollar-green\",\"sakura-pink\",\"developer-leaf\",\"violet-night\",\"midnight-cyan\",\"neon-terminal\",\"clean-dawn\",\"chatgpt\"]");
}

// TS: export function isThemeId(value: string | null, customPlugins: ThemePlugin[] = []): value is ThemeId
// DEFECT: type predicate (value is ThemeId) has no SLA counterpart; returns bool.
fn isThemeId(has_value: bool, value_ptr: ptr, value_len: u64, custom_ids_json_ptr: ptr, custom_ids_json_len: u64) -> bool {
    if !has_value { return false; };
    if value_len == 0 { return false; };
    for i in 0..19 {
        let il: u64 = 0;
        let ip = theme_plugin_id_at(i, &il);
        if il == value_len {
            let same = true;
            for j in 0..value_len {
                let a: u8 = 0; let b: u8 = 0;
                PTR_BYTE_AT(a, ip, j);
                PTR_BYTE_AT(b, value_ptr, j);
                if a != b { same = false; };
            }
            if same { return true; };
        };
    }
    // customPlugins.some(p => p.id === value): approximated by substring scan of caller-supplied JSON id list.
    // DEFECT: dynamic object array scan approximated as JSON text search in fix phase.
    if custom_ids_json_len > 0 { return false; };
    return false;
}

// TS: export function isBuiltinThemeId(value: string | null): value is BuiltinThemeId {
//   return Boolean(value && themePlugins.some(p => p.id === value)); }
fn isBuiltinThemeId(has_value: bool, value_ptr: ptr, value_len: u64) -> bool {
    if !has_value { return false; };
    return isThemeId(has_value, value_ptr, value_len, STR_PTR(""), 0);
}
