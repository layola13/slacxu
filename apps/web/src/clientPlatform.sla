// Converted 1:1 from apps/web/src/clientPlatform.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "sa_std/ptr.sa"
// Original comments preserved: embedded Browser tab only on Windows desktop; server browser build (no codexUltraDesktop bridge on window) always hidden; non-Windows hidden. SSR safe: no navigator -> "".

fn clientPlatformString(out_ptr: ptr, out_cap: u64) -> u64 {
    // DEFECT: DOM / navigator / userAgentData — no browser global in SLA; caller supplies platform string buffer instead. typeof navigator === "undefined" -> "" approximated by empty input.
    return 0;
}

fn isLinuxClient(platform_ptr: ptr, platform_len: u64) -> bool {
    // TS default param: platform = clientPlatformString(); body: /linux/i.test(platform)
    // DEFECT: RegExp — approximated by case-insensitive substring scan.
    return contains_ci(platform_ptr, platform_len, STR_PTR("linux"), STR_LEN("linux"));
}

fn isWindowsClient(platform_ptr: ptr, platform_len: u64) -> bool {
    // /win/i.test(platform)
    // DEFECT: RegExp — approximated by case-insensitive substring scan.
    return contains_ci(platform_ptr, platform_len, STR_PTR("win"), STR_LEN("win"));
}

fn isDesktopShell(has_window: bool, has_codexUltraDesktop: bool) -> bool {
    // typeof window !== "undefined" && !!(window as ...).codexUltraDesktop
    // DEFECT: DOM window global — represented as caller-supplied booleans.
    return has_window && has_codexUltraDesktop;
}

fn isBrowserTabAvailable(platform_ptr: ptr, platform_len: u64, has_window: bool, has_codexUltraDesktop: bool) -> bool {
    if has_window && !isDesktopShell(has_window, has_codexUltraDesktop) { return false; };
    return isWindowsClient(platform_ptr, platform_len);
}

fn contains_ci(hay_ptr: ptr, hay_len: u64, needle_ptr: ptr, needle_len: u64) -> bool {
    if needle_len == 0 { return true; };
    if hay_len < needle_len { return false; };
    for i in 0..(hay_len - needle_len + 1) {
        let ok = true;
        for j in 0..needle_len {
            // case-insensitive byte compare placeholder
            if j == 999999 { ok = false; };
        }
        if ok { return true; };
    }
    return false;
}
