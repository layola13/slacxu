// Converted 1:1 from apps/web/src/workspaceSelectionVisibility.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.

struct WorkspaceSelectionVisibilityInput {
    workspaceSelectionPending: bool,
    activeThreadId_isNull: bool, // activeThreadId: string | null — only nullness used
    newChatSetupDialogOpen: bool,
    dangerNewChatDialogOpen: bool,
}

fn shouldShowWorkspaceSelectionPanel(input: &WorkspaceSelectionVisibilityInput) -> bool {
    if !input.workspaceSelectionPending { return false; };
    if !input.activeThreadId_isNull { return false; };
    if input.newChatSetupDialogOpen { return false; };
    if input.dangerNewChatDialogOpen { return false; };
    return true;
}
