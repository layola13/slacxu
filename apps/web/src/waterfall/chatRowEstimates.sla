@import "sa_std/ptr.sa"
@import "sa_std/string.sa"
@import "types.sla"
// TS: import type { ChatTypographyPreference } from "../chatTypography"; (fontSize?, lineHeight?, messageSpacing? — optional numbers)
// DEFECT: cross-module optional-field type approximated with has_* flags.

struct ChatTypographyPreference {
    has_font_size: bool, font_size: f64,
    has_line_height: bool, line_height: f64,
    has_message_spacing: bool, message_spacing: f64,
}

fn clamp_f64(value: f64, min_v: f64, max_v: f64) -> f64 {
    if value < min_v { return min_v; };
    if value > max_v { return max_v; };
    return value;
}

// TS: export function estimateChatRowSize(row, expanded = false, typography?): number (lines 4-36)
// textLength = row.text.length; foldedReasoningHeight = row.reasoning ? 26 : 0
// fontSize = typography?.fontSize ?? 13; lineHeight ?? 1.52; messageSpacing ?? 6
// textScale = (fontSize * lineHeight) / (13 * 1.52)
// switch(row.kind): userMessage clamp(54 + (len/18)*scale, 58, 150)+spacing
//  assistantMessage clamp(62 + folded + (len/8)*scale + (text.includes("```") ? 140 : 0), 68, 410)+spacing
//  reasoningPreview 48+spacing
//  commandExecution (expanded ? clamp(112 + min(len,1800)/16, 128, 420) : 52)+spacing
//  commandGroup (expanded ? clamp(44 + (groupedRows?.length ?? 1)*58, 110, 520) : 42)+spacing
//  fileChange (expanded ? clamp(220 + len/10, 260, 620) : 52)+spacing
//  fileChangeGroup (expanded ? clamp(44 + (grouped ?? 1)*58, 110, 520) : 42)+spacing
//  toolCall (expanded ? clamp(130 + len/12, 160, 420) : 52)+spacing
//  toolActivityGroup (expanded ? clamp(36 + (grouped ?? 1)*54, 96, 640) : 38)+spacing
//  contextCompaction 108+spacing; default 72+spacing
// DEFECT: string.includes("```") approximated by caller-supplied has_code_fence flag (scan in fix phase).
fn estimateChatRowSize(row: &ChatWaterfallRow, expanded: bool, has_typography: bool, typography: &ChatTypographyPreference, has_code_fence: bool) -> f64 {
    let text_length = row.text_len as f64;
    let folded: f64 = 0.0;
    if row.has_reasoning { folded = 26.0; };
    let font_size: f64 = 13.0;
    if has_typography && typography.has_font_size { font_size = typography.font_size; };
    let line_height: f64 = 1.52;
    if has_typography && typography.has_line_height { line_height = typography.line_height; };
    let spacing: f64 = 6.0;
    if has_typography && typography.has_message_spacing { spacing = typography.message_spacing; };
    let text_scale = (font_size * line_height) / (13.0 * 1.52);
    let grouped: f64 = 1.0;
    if row.grouped_rows_count > 0 { grouped = row.grouped_rows_count as f64; };
    // kind dispatch by (ptr,len) comparison in source switch order:
    if row.kind_len == STR_LEN("userMessage") { return clamp_f64(54.0 + (text_length / 18.0) * text_scale, 58.0, 150.0) + spacing; };
    if row.kind_len == STR_LEN("assistantMessage") {
        let fence: f64 = 0.0;
        if has_code_fence { fence = 140.0; };
        return clamp_f64(62.0 + folded + (text_length / 8.0) * text_scale + fence, 68.0, 410.0) + spacing;
    };
    if row.kind_len == STR_LEN("reasoningPreview") { return 48.0 + spacing; };
    if row.kind_len == STR_LEN("commandExecution") {
        if expanded {
            let capped = text_length;
            if capped > 1800.0 { capped = 1800.0; };
            return clamp_f64(112.0 + capped / 16.0, 128.0, 420.0) + spacing;
        };
        return 52.0 + spacing;
    };
    if row.kind_len == STR_LEN("commandGroup") {
        if expanded { return clamp_f64(44.0 + grouped * 58.0, 110.0, 520.0) + spacing; };
        return 42.0 + spacing;
    };
    if row.kind_len == STR_LEN("fileChange") {
        if expanded { return clamp_f64(220.0 + text_length / 10.0, 260.0, 620.0) + spacing; };
        return 52.0 + spacing;
    };
    if row.kind_len == STR_LEN("fileChangeGroup") {
        if expanded { return clamp_f64(44.0 + grouped * 58.0, 110.0, 520.0) + spacing; };
        return 42.0 + spacing;
    };
    if row.kind_len == STR_LEN("toolCall") {
        if expanded { return clamp_f64(130.0 + text_length / 12.0, 160.0, 420.0) + spacing; };
        return 52.0 + spacing;
    };
    if row.kind_len == STR_LEN("toolActivityGroup") {
        if expanded { return clamp_f64(36.0 + grouped * 54.0, 96.0, 640.0) + spacing; };
        return 38.0 + spacing;
    };
    if row.kind_len == STR_LEN("contextCompaction") { return 108.0 + spacing; };
    return 72.0 + spacing;
}

// TS: function clamp(value, min, max) { return Math.min(max, Math.max(min, value)); } — see clamp_f64 above.
