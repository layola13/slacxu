    has_floor: bool, floor: ChatRowFloor,
    has_turn_started_at: bool, turn_started_at: f64,
    has_started_at: bool, started_at: f64,
    has_completed_at: bool, completed_at: f64,
    has_first_token_at: bool, first_token_at: f64,
    has_updated_at: bool, updated_at: f64,
    has_preview_url: bool, preview_url: [u8; 1024], preview_url_len: u64,
    has_token_usage: bool, token_usage: ChatTokenUsage,
    request_usage_json: [u8; 2048], request_usage_json_len: u64, request_usage_count: u64,
    grouped_rows_json: [u8; 16384], grouped_rows_json_len: u64, grouped_rows_count: u64, // DEFECT: recursive row array -> JSON buffer
