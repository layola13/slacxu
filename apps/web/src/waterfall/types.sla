fn chat_row_kind_count() -> u64 { return 20; }
// ChatRowRole: "user" | "assistant" | "tool" | "system". ChatRowWidth: "prose" | "wide" | "full".

struct ChatTokenUsage {
    // DEFECT: dynamic object — token counters kept as JSON text buffer.
    json: [u8; 256], json_len: u64,
}
struct ChatRequestUsage {
    request_id: [u8; 128], request_id_len: u64,
    usage: ChatTokenUsage,
}
struct CompactionSourceDetail {
    source: [u8; 64], source_len: u64, // e.g. "native"
    has_provider_id: bool, provider_id: [u8; 128], provider_id_len: u64,
    has_model: bool, model: [u8; 128], model_len: u64,
}
struct ChatRowFloor { index: u64, label: [u8; 256], label_len: u64 }

// WorkbenchItem (from ../state/codexClient, consumed here): id, type, title?, text, status?,
// payload (dynamic), agentId?, agentThreadId?, agentName?, agentRole?, agentStatus?,
// startedAt?, completedAt?, firstTokenAt?, updatedAt?
struct WorkbenchItem {
    id: [u8; 128], id_len: u64,
    type_: [u8; 64], type_len: u64,
    has_title: bool, title: [u8; 256], title_len: u64,
    text: [u8; 8192], text_len: u64,
    has_status: bool, status: [u8; 64], status_len: u64,
    payload_json: [u8; 8192], payload_json_len: u64, // DEFECT: dynamic object -> JSON text buffer
    has_agent_id: bool, agent_id: [u8; 128], agent_id_len: u64,
    has_agent_thread_id: bool, agent_thread_id: [u8; 128], agent_thread_id_len: u64,
    has_agent_name: bool, agent_name: [u8; 256], agent_name_len: u64,
    has_agent_role: bool, agent_role: [u8; 128], agent_role_len: u64,
    has_agent_status: bool, agent_status: [u8; 64], agent_status_len: u64,
    has_started_at: bool, started_at: f64,
    has_completed_at: bool, completed_at: f64,
    has_first_token_at: bool, first_token_at: f64,
    has_updated_at: bool, updated_at: f64,
}
// WorkbenchTurn: id, threadId, status, items: WorkbenchItem[], startedAt?, completedAt?
struct WorkbenchTurn {
    id: [u8; 128], id_len: u64,
    thread_id: [u8; 128], thread_id_len: u64,
    status: [u8; 64], status_len: u64,
    items_json: [u8; 16384], items_json_len: u64, // DEFECT: dynamic array -> JSON text buffer
    items_count: u64,
    has_started_at: bool, started_at: f64,
    has_completed_at: bool, completed_at: f64,
}

// ChatWaterfallRow (SDK contract, fields in construction order used by chatRows/pendingRows/agentPages):
struct ChatWaterfallRow {
    key: [u8; 512], key_len: u64,
    turn_id: [u8; 128], turn_id_len: u64,
