// DEFECT: RegExp replace + toLowerCase approximated by caller-supplied normalized (ptr,len).
fn normalizeTaskPlanStatus(normalized_ptr: ptr, normalized_len: u64, out_len: &u64) -> ptr {
    if normalized_len == STR_LEN("completed") { *out_len = STR_LEN("completed"); return STR_PTR("completed"); };
    if normalized_len == STR_LEN("complete") { *out_len = STR_LEN("completed"); return STR_PTR("completed"); };
    if normalized_len == STR_LEN("done") { *out_len = STR_LEN("completed"); return STR_PTR("completed"); };
    if normalized_len == STR_LEN("inprogress") { *out_len = STR_LEN("inProgress"); return STR_PTR("inProgress"); };
    if normalized_len == STR_LEN("running") { *out_len = STR_LEN("inProgress"); return STR_PTR("inProgress"); };
    if normalized_len == STR_LEN("started") { *out_len = STR_LEN("inProgress"); return STR_PTR("inProgress"); };
