//   return previous && rowsEqual(previous, candidate) ? previous : candidate;
// DEFECT: object spread { ...next } approximated — returns 1 when previous is reused, 0 for candidate.
fn shareRow(has_previous: bool, equal: bool) -> u64 { if has_previous && equal { return 1; }; return 0; }
// TS: function shareNestedRows(previous | undefined, next): ChatWaterfallRow[] —
//   if (!previous) return next; build Map by key; shared = next.map(r => shareRow(prevByKey.get(r.key), r));
//   return sameReferences(previous, shared) ? previous : shared;
fn shareNestedRows(has_previous: bool, all_shared_identical: bool) -> bool {
    if !has_previous { return false; }; // returns next
    return all_shared_identical; // true -> return previous array
}

// TS: export function stableChatRows(nextRows, cache): ChatWaterfallRow[] (lines 15-24)
//   previousByKey = new Map(cache.rows.map(r => [r.key, r])); shared = nextRows.map(n => shareRow(prevByKey.get(n.key), n));
//   if (sameReferences(cache.rows, shared)) return cache.rows; cache.rows = shared; return shared;
// DEFECT: Map construction + map closure approximated over JSON buffers.
fn stableChatRows(next_count: u64, cache: &StableChatRowsCache, all_shared_identical_to_cache: bool) -> u64 {
    if sameReferences(cache.rows_count, next_count, all_shared_identical_to_cache) && cache.rows_count == next_count {
        return cache.rows_gen; // return cache.rows unchanged
    };
    cache.rows_count = next_count;
    cache.rows_gen = cache.rows_gen + 1;
    return cache.rows_gen;
}
