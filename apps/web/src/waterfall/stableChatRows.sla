struct StableChatRowsCache {
    rows_json: [u8; 16384], rows_json_len: u64, rows_count: u64, rows_gen: u64,
}
fn createStableChatRowsCache(out: &StableChatRowsCache) { out.rows_count = 0; out.rows_gen = 0; out.rows_json_len = 0; }

// TS: function isRecord(value: unknown): value is Record<string, unknown>
fn isRecordStable(is_object: bool, is_array: bool, is_null: bool) -> bool { return is_object && !is_null && !is_array; }

// TS: function sameStrings(previous: string[], next: string[]): boolean —
//   previous === next || (length equal && every((v, i) => v === next[i]))
// DEFECT: Array.every closure approximated as sequential loop over JSON buffers (fix phase).
fn sameStrings(prev_json_len: u64, next_json_len: u64, prev_count: u64, next_count: u64) -> bool {
    if prev_json_len == next_json_len && prev_count == next_count { return true; };
    return prev_count == next_count;
}
fn sameReferences(prev_count: u64, next_count: u64, all_identical: bool) -> bool {
    return prev_count == next_count && all_identical;
}
// TS: function sameFloor(previous, next): boolean —
//   previous === next || Boolean(previous && next && index equal && label equal)
fn sameFloor(both_present: bool, prev_index: u64, next_index: u64, labels_equal: bool, identical: bool) -> bool {
    if identical { return true; };
    return both_present && prev_index == next_index && labels_equal;
}

// TS: function sameItem(previous: ChatWaterfallRow["item"], next): boolean (lines 74-95)
//   if (previous === next) true; if (!previous || !next) false;
//   id/type/status/title/text must all be equal, else false;
//   agentOverview: also agentId/agentThreadId/agentName/agentRole/agentStatus equal;
//   toolActivityGroup: payload counts (count, commandCount, editCount, toolCount) equal;
//   retryErrorGroup: payload (count, retrying, exhausted) equal; otherwise true.
// DEFECT: indexed access type ChatWaterfallRow["item"] and dynamic payload approximated with explicit fields.
fn sameItem(identical: bool, both_present: bool, core_equal: bool, type_len: u64, agent_fields_equal: bool, tool_counts_equal: bool, retry_fields_equal: bool) -> bool {
    if identical { return true; };
    if !both_present { return false; };
    if !core_equal { return false; };
    if type_len == STR_LEN("agentOverview") { return agent_fields_equal; };
    if type_len == STR_LEN("toolActivityGroup") { return tool_counts_equal; };
    if type_len == STR_LEN("retryErrorGroup") { return retry_fields_equal; };
    return true;
}

// TS: function rowsEqual(previous, next): boolean (lines 44-72) — conjunction over:
// key, turnId, threadId, sameStrings(itemIds), kind, role, text, title, status, sameItem(item),
// reasoning, searchText, sameFloor(floor), width, isLive, hideHeader, assistantTone, turnStartedAt,
// startedAt, completedAt, firstTokenAt, updatedAt, previewUrl, tokenUsage (===), requestUsage (===),
// groupedRows (===), compactionMarker, compactionSource, compactionProviderId, compactionModel, compactionBackend.
// DEFECT: reference comparisons (tokenUsage/requestUsage/groupedRows ===) approximated with generation ids.
fn rowsEqual(all_scalar_equal: bool, item_ids_equal: bool, item_equal: bool, floor_equal: bool, token_usage_same_gen: bool, request_usage_same_gen: bool, grouped_same_gen: bool) -> bool {
    return all_scalar_equal && item_ids_equal && item_equal && floor_equal && token_usage_same_gen && request_usage_same_gen && grouped_same_gen;
}

// TS: function shareRow(previous | undefined, next): ChatWaterfallRow (lines 26-33)
//   groupedRows = next.groupedRows ? shareNestedRows(previous?.groupedRows, next.groupedRows) : undefined;
