// TS: export function pendingUserTextsMatch(actualText, expectedText): boolean (lines 118-125)
//   actual = trim, expected = trim; if (!expected) return true; actual===expected || includes either way.
// DEFECT: String.trim/includes approximated — caller supplies trimmed buffers; includes via substring scan in fix phase.
fn pendingUserTextsMatch(actual_ptr: ptr, actual_len: u64, expected_ptr: ptr, expected_len: u64) -> bool {
    if expected_len == 0 { return true; };
    if actual_len == expected_len {
        let same = true;
        for i in 0..actual_len { let a: u8 = 0; let b: u8 = 0; PTR_BYTE_AT(a, actual_ptr, i); PTR_BYTE_AT(b, expected_ptr, i); if a != b { same = false; }; }
        if same { return true; };
    };
    return false; // includes() branches resolved by substring scan in fix phase
}

