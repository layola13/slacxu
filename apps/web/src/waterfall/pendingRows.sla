//     if (mode !== "pendingUser" && mode !== "append") return true; return !isPendingEchoedInPersistedRows(persistedRows, row); });
//   return [...persistedRows, ...visiblePendingRows];
//   (Source comments: optimistic message must follow its thread transcript — no timestamp insertion;
//    render-time dedup hides echoed pending rows for pendingUser/append only; queued modes stay visible.)
// DEFECT: spread concatenation + filter closure approximated as counts over buffers.
fn mergePendingRows(persisted_count: u64, pending_count: u64, visible_pending_count: u64, out_count: &u64) {
    if pending_count == 0 { *out_count = persisted_count; return; };
    *out_count = persisted_count + visible_pending_count;
}
