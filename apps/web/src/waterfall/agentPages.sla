struct AgentPageSession {
    id: [u8; 128], id_len: u64,
    has_thread_id: bool, thread_id: [u8; 128], thread_id_len: u64,
    name: [u8; 256], name_len: u64,
    has_role: bool, role: [u8; 128], role_len: u64,
    has_status: bool, status: [u8; 64], status_len: u64,
}
// TS: export type AgentVirtualPage = { kind: "main" } | { kind: "all" } | { kind: "agent"; agentId: string }
// DEFECT: discriminated union approximated as kind tag + agent_id fields.
struct AgentVirtualPage {
    kind: [u8; 16], kind_len: u64, // "main" | "all" | "agent"
    agent_id: [u8; 128], agent_id_len: u64,
}
struct AgentTranscriptOverview {
    has_status: bool, status: [u8; 64], status_len: u64,
    text: [u8; 4096], text_len: u64,
    has_turn_id: bool, turn_id: [u8; 128], turn_id_len: u64,
    has_updated_at: bool, updated_at: f64,
}

// TS: function safeId(value: string): string — value.replace(/[^A-Za-z0-9_-]+/g, "-")
// DEFECT: RegExp replace approximated with per-byte scan writing into out buffer (runs of invalid bytes -> single '-').
fn safeId(value_ptr: ptr, value_len: u64, out_buf: ptr) -> u64 {
    let out_len: u64 = 0;
    let in_bad_run = false;
    for i in 0..value_len {
        let c: u8 = 0; PTR_BYTE_AT(c, value_ptr, i);
        let ok = (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95 || c == 45;
        if ok { in_bad_run = false; out_len = out_len + 1; } else {
            if !in_bad_run { out_len = out_len + 1; in_bad_run = true; };
        };
    }
    return out_len;
}
// TS: function isLiveAgentStatus(status: string): boolean — normalized in
// [active, running, inprogress, started, interacted, pendinginit, working]
// DEFECT: replace(/[_-]+/g,"").toLowerCase() normalization supplied by caller (normalized ptr/len).
fn isLiveAgentStatus(normalized_ptr: ptr, normalized_len: u64) -> bool {
    if normalized_len == STR_LEN("active") { return true; };
    if normalized_len == STR_LEN("running") { return true; };
    if normalized_len == STR_LEN("inprogress") { return true; };
    if normalized_len == STR_LEN("started") { return true; };
    if normalized_len == STR_LEN("interacted") { return true; };
    if normalized_len == STR_LEN("pendinginit") { return true; };
    if normalized_len == STR_LEN("working") { return true; };
    return false;
}

// TS: export function summarizeAgentStatuses(agents): { completed, failed } (lines 19-29)
//   status normalized; completed if in [completed, shutdown, done, success]; failed if in [failed, errored, notfound].
fn summarizeAgentStatuses(agents_json_ptr: ptr, agents_json_len: u64, agents_count: u64, completed_out: &u64, failed_out: &u64) {
    // DEFECT: readonly array of dynamic sessions traversed via JSON buffer in fix phase; counting rules above preserved.
    *completed_out = 0; *failed_out = 0;
}
fn summarize_status_is_completed(normalized_len: u64) -> bool {
    return normalized_len == STR_LEN("completed") || normalized_len == STR_LEN("shutdown") || normalized_len == STR_LEN("done") || normalized_len == STR_LEN("success");
}
fn summarize_status_is_failed(normalized_len: u64) -> bool {
    return normalized_len == STR_LEN("failed") || normalized_len == STR_LEN("errored") || normalized_len == STR_LEN("notfound");
}

// TS: export const MAIN_AGENT_PAGE = { kind: "main" }; ALL_AGENTS_PAGE = { kind: "all" }; MAX_AGENT_RAIL_ITEMS = 16;
fn main_agent_page(out: &AgentVirtualPage) { out.kind_len = STR_LEN("main"); }
fn all_agents_page(out: &AgentVirtualPage) { out.kind_len = STR_LEN("all"); }
fn max_agent_rail_items() -> u64 { return 16; }

// TS: export function agentVirtualPageKey(threadId: string | null, page): string
//   topic = threadId ?? "new"; agent -> `${topic}:agent:${page.agentId}`; else `${topic}:${page.kind}`
// DEFECT: template string approximated — writes key into out buffer in fix phase; length computed here for simple case.
fn agentVirtualPageKey(has_thread_id: bool, thread_id_len: u64, page: &AgentVirtualPage, out_len: &u64) -> i32 {
    let topic_len = thread_id_len;
    if !has_thread_id { topic_len = STR_LEN("new"); };
    if page.kind_len == STR_LEN("agent") { *out_len = topic_len + STR_LEN(":agent:") + page.agent_id_len; } else { *out_len = topic_len + 1 + page.kind_len; };
    return 0;
}

// TS: export function selectAgentRailSessions<T extends AgentPageSession>(activeAgents, selectedAgent, limit = 16): T[] (lines 40-52)
//   if (limit <= 0) return []; selectedInActive = selectedAgent && activeAgents.some(a => a.id === selectedAgent.id);
//   visible = activeAgents.slice(0, limit); if (!selectedAgent || selectedInActive) return visible;
//   if (visible.length < limit) return [...visible, selectedAgent];
//   return [...visible.slice(0, max(0, limit-1)), selectedAgent];
// DEFECT: generics <T extends ...> and spread/slice array construction have no SLA counterpart; index arithmetic preserved.
fn selectAgentRailSessions(active_count: u64, has_selected: bool, selected_in_active: bool, limit: i32, out_count: &u64, out_includes_selected_appended: &bool) {
    if limit <= 0 { *out_count = 0; *out_includes_selected_appended = false; return; };
    let lim = limit as u64;
    let visible = active_count;
    if visible > lim { visible = lim; };
    if !has_selected || selected_in_active { *out_count = visible; *out_includes_selected_appended = false; return; };
    if visible < lim { *out_count = visible + 1; *out_includes_selected_appended = true; return; };
    *out_count = lim; *out_includes_selected_appended = true; // last slot replaced by selectedAgent
}

