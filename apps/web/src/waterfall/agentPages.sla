//     isLive: isLiveAgentStatus(status), startedAt: overview?.updatedAt ?? latestTurn?.startedAt, completedAt: latestTurn?.completedAt }
// DEFECT: Map.get / Array.at(-1) / template strings / dynamic objects approximated over JSON buffers.
fn buildAllAgentOverviewRows(agents_count: u64, has_parent_thread_id: bool, out_rows_count: &u64) -> i32 {
    *out_rows_count = agents_count; // one status row per agent, in source order
    return 0;
}
