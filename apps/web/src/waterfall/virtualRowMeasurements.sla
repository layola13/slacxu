@import "sa_std/string.sa"

// TS: export type VirtualRowResizer = (index: number, size: number) => void;
// DEFECT: function type / callback has no SLA counterpart; resizer passed as opaque id, invoked by host in fix phase.
// TS: export type VirtualRowAnchor = { index: number; offsetTop: number };
struct VirtualRowAnchor { index: i32, offset_top: f64 }
struct VirtualRowResizer { id: u64 }
// TS: export const MIN_STABLE_VIRTUAL_ROW_WIDTH = 240;
fn min_stable_virtual_row_width() -> f64 { return 240.0; }

// DEFECT: DOM Element/ParentNode/HTMLElement, querySelectorAll, dataset, getBoundingClientRect,
// offsetWidth/offsetHeight, isConnected, scrollTop have no sa_std counterpart; all functions below
// keep signatures + control flow with DOM reads abstracted as host-supplied values (fix phase: SAX host bridge).

// TS: export function measureVirtualRowHeight(element): number
//   if ("offsetHeight" in element && typeof element.offsetHeight === "number") return element.offsetHeight;
//   return Math.round(element.getBoundingClientRect().height);
fn measureVirtualRowHeight(has_offset_height: bool, offset_height: f64, rect_height: f64) -> f64 {
    if has_offset_height { return offset_height; };
    return rect_height; // DEFECT: Math.round deferred to fix phase.
}

// TS: export function remeasureMountedVirtualRows(container, resizeItem): number (lines 19-44)
//   elements = container.querySelectorAll("[data-chat-virtual-row='true'][data-index]"); measured = 0;
//   forEach: index = Number(dataset.index); skip if !isInteger || <0 || !isConnected;
//   width = offsetWidth>0 ? offsetWidth : getBoundingClientRect().width (NaN fallback);
//   skip if finite width < MIN_STABLE_VIRTUAL_ROW_WIDTH; height = measureVirtualRowHeight; skip if <=0;
//   resizeItem(index, height); measured += 1. Return measured.
// DEFECT: NodeList.forEach closure approximated as sequential loop over host-supplied element descriptors.
struct VirtualRowElementDesc {
    index: i32, is_integer_index: bool, is_connected: bool,
    has_offset_width: bool, offset_width: f64, rect_width: f64, width_is_nan: bool,
    has_offset_height: bool, offset_height: f64, rect_height: f64,
}
fn remeasureMountedVirtualRows(elements: &VirtualRowElementDesc, count: u64, resizer: &VirtualRowResizer) -> u64 {
    // DEFECT: dynamic array of descriptors — single-descriptor signature stands in for the buffer; loop shape preserved.
    let measured: u64 = 0;
    for i in 0..count {
        let el = elements;
        if !el.is_integer_index || el.index < 0 || !el.is_connected {
            // return inside forEach == continue here
        } else {
            let width = el.rect_width;
            if el.has_offset_width && el.offset_width > 0.0 { width = el.offset_width; };
            if el.width_is_nan { width = el.rect_width; };
            let skip = false;
            if !el.width_is_nan && width < 240.0 { skip = true; };
            if !skip {
                let height = measureVirtualRowHeight(el.has_offset_height, el.offset_height, el.rect_height);
                if height > 0.0 {
                    // resizeItem(index, height) — host call in fix phase.
                    measured = measured + 1;
                };
            };
        };
    }
    return measured;
}

// TS: export function captureVisibleVirtualRowAnchor(container): VirtualRowAnchor | null (lines 46-60)
//   Picks connected row with smallest rect.top whose rect overlaps container rect; offsetTop = rowTop - containerTop.
fn captureVisibleVirtualRowAnchor(found: bool, index: i32, offset_top: f64, out: &VirtualRowAnchor) -> bool {
    if !found { return false; };
    out.index = index; out.offset_top = offset_top;
    return true;
}

// TS: export function restoreVirtualRowAnchor(container, anchor): boolean (lines 62-66)
//   if (!anchor) false; element = querySelector(`[data-chat-virtual-row='true'][data-index='${anchor.index}']`);
//   if (!element?.isConnected) false; container.scrollTop += elementTop - containerTop - anchor.offsetTop; true.
// DEFECT: template-string selector construction has no SLA counterpart; selector built by host in fix phase.
fn restoreVirtualRowAnchor(has_anchor: bool, anchor: &VirtualRowAnchor, element_connected: bool, element_top: f64, container_top: f64, scroll_top_io: &f64) -> bool {
    if !has_anchor { return false; };
    if !element_connected { return false; };
    let offset_top = element_top - container_top;
    *scroll_top_io = *scroll_top_io + offset_top - anchor.offset_top;
    return true;
}
