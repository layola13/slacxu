fn createIncrementalChatRowsCache(out: &IncrementalChatRowsCache) {
    out.cache_key_len = 0; out.finalized_rows_count = 0; out.turns_count = 0;
}

// TS: export function buildChatRows(turns, filterItem = () => true, tokenUsageByTurnId = {}, compactionSourceByTurnId = {},
//   requestUsageByTurnId = {}, threadBackend?): ChatWaterfallRow[]
