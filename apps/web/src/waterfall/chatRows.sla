// DEFECT: Record<string, ...> index maps + default closure approximated as JSON buffers.
fn buildChatRows(turns_count: u64, out_rows_count: &u64) -> i32 {
    let raw_count: u64 = 0;
    let _s = buildRawChatRows(turns_count, &raw_count);
    return finalizeChatRows(raw_count, 0, out_rows_count);
}

// TS: export function applyWaterfallDisplayMode(rows, mode, nowMs = Date.now()): { rows, hiddenCount } (lines 76-97)
//   full/empty -> {rows, 0}; post-compaction: last row with (kind contextCompaction && completed) || compactionMarker ->
//   { rows.slice(boundary), hiddenCount: boundary }; else hideHistoricalToolActivity(rows, nowMs).
fn applyWaterfallDisplayMode(rows_count: u64, mode_len: u64, now_ms: f64, boundary_index: i32, out_count: &u64, hidden_out: &u64) -> i32 {
    if mode_len == STR_LEN("full") || rows_count == 0 { *out_count = rows_count; *hidden_out = 0; return 0; };
    if mode_len == STR_LEN("post-compaction") && boundary_index >= 0 {
        *out_count = rows_count - (boundary_index as u64); *hidden_out = boundary_index as u64; return 0;
    };
    return hideHistoricalToolActivity(rows_count, now_ms, out_count, hidden_out);
}
// TS: function hideHistoricalToolActivity(rows, nowMs): { rows, hiddenCount } (lines 99-127)
//   cutoff = nowMs - AGE; visible=[]; hiddenCount=0; noticeIndex=-1; firstHidden=undefined;
//   for row: ts=(completedAt ?? startedAt) normalized as above; if !isLive && completed && ts!=null && ts<cutoff && isToolActivityRow:
//     firstHidden ??= row; noticeIndex = noticeIndex<0 ? visible.length : noticeIndex;
//     hiddenCount += max(1, row.itemIds.length); continue; else visible.push(row).
//   if !firstHidden || hiddenCount===0 -> {rows, 0}; visible.splice(noticeIndex, 0, historicalToolActivityNotice(firstHidden, hiddenCount));
//   return {visible, hiddenCount}.
// DEFECT: splice/push array building approximated as counts.
fn hideHistoricalToolActivity(rows_count: u64, now_ms: f64, out_count: &u64, hidden_out: &u64) -> i32 {
    let cutoff = now_ms - 7200000.0;
    let _c = cutoff;
    *out_count = rows_count; *hidden_out = 0;
    return 0;
}
// TS: function isToolActivityRow(row): kind in [commandExecution, commandGroup, fileChange, fileChangeGroup,
//   toolActivityGroup, toolCall, imageGeneration, imageView] || isToolActivityItem(row.item)
fn isToolActivityRow(kind_len: u64, item_type_len: u64) -> bool {
    if kind_len == STR_LEN("commandExecution") || kind_len == STR_LEN("commandGroup") || kind_len == STR_LEN("fileChange") || kind_len == STR_LEN("fileChangeGroup") || kind_len == STR_LEN("toolActivityGroup") || kind_len == STR_LEN("toolCall") || kind_len == STR_LEN("imageGeneration") || kind_len == STR_LEN("imageView") { return true; };
    return isToolActivityItem(item_type_len);
}
