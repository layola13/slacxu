// TS: function rowRole(kind): userMessage->user; assistantMessage|plan|reasoningPreview->assistant;
//   toolCall|toolActivityGroup|toolResult|fileChange|fileChangeGroup|commandExecution|commandGroup|imageGeneration|imageView->tool; default system.
fn rowRole(kind_len: u64, out_len: &u64) -> ptr {
    if kind_len == STR_LEN("userMessage") { *out_len = STR_LEN("user"); return STR_PTR("user"); };
    if kind_len == STR_LEN("assistantMessage") || kind_len == STR_LEN("plan") || kind_len == STR_LEN("reasoningPreview") { *out_len = STR_LEN("assistant"); return STR_PTR("assistant"); };
    if kind_len == STR_LEN("toolCall") || kind_len == STR_LEN("toolActivityGroup") || kind_len == STR_LEN("toolResult") || kind_len == STR_LEN("fileChange") || kind_len == STR_LEN("fileChangeGroup") || kind_len == STR_LEN("commandExecution") || kind_len == STR_LEN("commandGroup") || kind_len == STR_LEN("imageGeneration") || kind_len == STR_LEN("imageView") { *out_len = STR_LEN("tool"); return STR_PTR("tool"); };
    *out_len = STR_LEN("system");
    return STR_PTR("system");
}
// TS: function rowWidth(kind, text): wide if kind in [commandExecution, commandGroup, fileChange, fileChangeGroup, toolCall,
//   toolActivityGroup, imageGeneration, imageView] || text.includes("```"); full if kind in [status, notice, checkpoint, contextCompaction, reviewMode]; else prose.
fn rowWidth(kind_len: u64, text_has_fence: bool, out_len: &u64) -> ptr {
    if kind_len == STR_LEN("commandExecution") || kind_len == STR_LEN("commandGroup") || kind_len == STR_LEN("fileChange") || kind_len == STR_LEN("fileChangeGroup") || kind_len == STR_LEN("toolCall") || kind_len == STR_LEN("toolActivityGroup") || kind_len == STR_LEN("imageGeneration") || kind_len == STR_LEN("imageView") || text_has_fence { *out_len = STR_LEN("wide"); return STR_PTR("wide"); };
    if kind_len == STR_LEN("status") || kind_len == STR_LEN("notice") || kind_len == STR_LEN("checkpoint") || kind_len == STR_LEN("contextCompaction") || kind_len == STR_LEN("reviewMode") { *out_len = STR_LEN("full"); return STR_PTR("full"); };
    *out_len = STR_LEN("prose");
    return STR_PTR("prose");
}
// TS: function primaryText(item, reasoning?): reasoning -> reasoningText(item) || reasoning || "";
//   userMessage -> displayPromptText(item.text); else item.text.
fn primaryText(type_len: u64, has_reasoning_text: bool, has_reasoning_arg: bool, out_source: &u64) -> i32 {
    if type_len == STR_LEN("reasoning") { if has_reasoning_text { *out_source = 1; } else if has_reasoning_arg { *out_source = 2; } else { *out_source = 0; }; return 0; };
    if type_len == STR_LEN("userMessage") { *out_source = 3; return 0; }; // displayPromptText path
    *out_source = 4;
    return 0;
}
// TS: export function reasoningText(item): string (lines ~735-754)
//   if item.text.trim() -> normalizeReasoningMarkdown(item.text); payload.summary: string -> normalize;
//   array -> normalize(map entries: string ? entry : summarizeReasoningEntry(entry), filter Boolean, join "\n");
//   record -> normalize(summarizeReasoningEntry(summary)); else "".
fn reasoningText(has_text: bool, summary_kind: u64, out_kind: &u64) -> i32 { *out_kind = summary_kind; return 0; }
// TS: function compactConsecutiveRetryErrorRows(rows) / retryErrorGroupRow(rows):
//   only rows kind error with payload.retryError===true group (flush on threadId change);
//   group: retrying = any status==="running"; exhausted = any payload.exhausted===true;
//   status = retrying ? "running" : exhausted ? "failed" : last.status ?? "failed";
//   progress = retrying && attempt/max numbers ? ` · retrying ${attempt}/${max}` : "";
//   title = `${n} retry event(s)${progress}`; searchText = rows searchText join "\n"; isLive = retrying.
fn compactConsecutiveRetryErrorRows(rows_count: u64, out_count: &u64) -> i32 { *out_count = rows_count; return 0; }
fn retryErrorGroupStatus(retrying: bool, exhausted: bool, has_last_status: bool, out_len: &u64) -> ptr {
    if retrying { *out_len = STR_LEN("running"); return STR_PTR("running"); };
    if exhausted { *out_len = STR_LEN("failed"); return STR_PTR("failed"); };
    if has_last_status { *out_len = 0; return STR_PTR(""); }; // last.status verbatim in fix phase
    *out_len = STR_LEN("failed");
    return STR_PTR("failed");
}
// TS: export function normalizeReasoningMarkdown(value): value.trim().replace(/\*{4}(?=[^\s*])/g, "**\n\n**")
// DEFECT: RegExp with lookahead has no SLA counterpart; scan-based approximation in fix phase.
fn normalizeReasoningMarkdown(in_len: u64, star4_boundaries: u64, out_len: &u64) -> i32 {
    *out_len = in_len + star4_boundaries * 2; // each "****" (4) -> "**\n\n**" (6)
    return 0;
}
// TS: function summarizeReasoningEntry(value): string -> value; record -> first non-empty string among
//   [text, summary, content, message], else safeJson(value); else "".
fn summarizeReasoningEntry(is_string: bool, is_record_v: bool, found_key_index: i32, out_kind: &u64) -> i32 {
    if is_string { *out_kind = 1; return 0; };
    if is_record_v && found_key_index >= 0 { *out_kind = 2; return 0; };
    if is_record_v { *out_kind = 3; return 0; }; // safeJson fallback
    *out_kind = 0;
    return 0;
}
// TS: function fallbackTitle(kind): userMessage "You", assistantMessage "Codex", plan "Plan", reasoningPreview "Thinking",
//   commandExecution "Command", commandGroup "Commands", fileChange "File change", fileChangeGroup "Edited files",
//   imageView "Image view", imageGeneration "Image generation", toolCall "Tool", toolActivityGroup "Tool calls",
//   contextCompaction "Context compaction", default "Status".
fn fallbackTitle(kind_len: u64, out_len: &u64) -> ptr {
    if kind_len == STR_LEN("userMessage") { *out_len = STR_LEN("You"); return STR_PTR("You"); };
    if kind_len == STR_LEN("assistantMessage") { *out_len = STR_LEN("Codex"); return STR_PTR("Codex"); };
    if kind_len == STR_LEN("plan") { *out_len = STR_LEN("Plan"); return STR_PTR("Plan"); };
    if kind_len == STR_LEN("reasoningPreview") { *out_len = STR_LEN("Thinking"); return STR_PTR("Thinking"); };
    if kind_len == STR_LEN("commandExecution") { *out_len = STR_LEN("Command"); return STR_PTR("Command"); };
    if kind_len == STR_LEN("commandGroup") { *out_len = STR_LEN("Commands"); return STR_PTR("Commands"); };
    if kind_len == STR_LEN("fileChange") { *out_len = STR_LEN("File change"); return STR_PTR("File change"); };
    if kind_len == STR_LEN("fileChangeGroup") { *out_len = STR_LEN("Edited files"); return STR_PTR("Edited files"); };
    if kind_len == STR_LEN("imageView") { *out_len = STR_LEN("Image view"); return STR_PTR("Image view"); };
    if kind_len == STR_LEN("imageGeneration") { *out_len = STR_LEN("Image generation"); return STR_PTR("Image generation"); };
    if kind_len == STR_LEN("toolCall") { *out_len = STR_LEN("Tool"); return STR_PTR("Tool"); };
    if kind_len == STR_LEN("toolActivityGroup") { *out_len = STR_LEN("Tool calls"); return STR_PTR("Tool calls"); };
    if kind_len == STR_LEN("contextCompaction") { *out_len = STR_LEN("Context compaction"); return STR_PTR("Context compaction"); };
    *out_len = STR_LEN("Status");
    return STR_PTR("Status");
}
// TS: function compactLine(value): oneLine = value.replace(/\s+/g, " ").trim(); length>80 ? slice(0,77)+"..." : oneLine
// DEFECT: RegExp \s+ collapse approximated in fix phase; length rule preserved.
fn compactLine(one_line_len: u64, out_len: &u64) -> i32 {
    if one_line_len > 80 { *out_len = 80; } else { *out_len = one_line_len; };
    return 0;
}
// TS: function safeJson(value): string -> value; try JSON.stringify(value, null, 2) ?? "" catch String(value)
// DEFECT: JSON.stringify of dynamic value approximated by sa_json_* in fix phase.
fn safeJson(is_string: bool, stringify_ok: bool, out_kind: &u64) -> i32 {
    if is_string { *out_kind = 1; } else if stringify_ok { *out_kind = 2; } else { *out_kind = 3; };
    return 0;
}
// TS: export function cleanPreviewUrl(raw): string | undefined (lines ~925-968)
//   trim; empty -> undefined; strip leading [`'"<(\[{]+ and trailing [`'">)\]}]+; strip trailing punctuation
//   [.,;:!?，。；：！？、…]+ then [`'"]+; prepend "http://" unless /^https?:\/\//i;
//   try new URL(text): hostname must be localhost|127.0.0.1|0.0.0.0|[::1]; protocol http:/https:;
//   pathname: strip trailing [`'"], cut at first char outside \x20-\x7E, strip trailing punctuation class, empty -> "/";
//   username/password cleared; return url.toString(); catch -> undefined.
// DEFECT: URL API + RegExp classes (incl. CJK punctuation) have no sa_std counterpart; staged string surgery in fix phase.
fn cleanPreviewUrl(raw_len: u64, has_protocol: bool, is_local_host: bool, protocol_ok: bool, url_parse_ok: bool) -> bool {
    if raw_len == 0 { return false; };
    if !url_parse_ok { return false; };
    if !is_local_host { return false; };
    return protocol_ok;
}
// TS: export function detectLocalPreviewUrl(value): string | undefined (lines ~970-1002)
//   explicit matches = [...value.matchAll(/https?:\/\/(?:localhost|127\.0\.0\.1|\[::1\]|0\.0\.0\.0)(?::\d{1,5})?(?:\/[A-Za-z0-9\-._~:/?#[\]@!$&'()*+,;=]*)?/gi)];
//   scan matches last-to-first, first cleanPreviewUrl hit wins; then same for implicit /\b(?:localhost|...)/gi matches; else undefined.
// DEFECT: matchAll global RegExp + iterator spread have no SLA counterpart; regex engine needed in fix phase.
fn detectLocalPreviewUrl(value_len: u64, explicit_hits: u64, implicit_hits: u64, out_found: &bool) -> i32 {
    *out_found = explicit_hits > 0 || implicit_hits > 0; // subject to cleanPreviewUrl acceptance per candidate
    return 0;
}
