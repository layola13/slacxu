// TS: function groupedActivityStatus(rows): "failed" if any row status.toLowerCase() in [failed, error, cancelled, canceled, interrupted] else "completed".
fn groupedActivityStatus(any_failed: bool, out_len: &u64) -> ptr {
    if any_failed { *out_len = STR_LEN("failed"); return STR_PTR("failed"); };
    *out_len = STR_LEN("completed");
    return STR_PTR("completed");
