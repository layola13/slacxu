// --- status normalizers (defined mid-file in TS, hoisted here only as helpers; order of exports preserved below) ---
// TS function isCompletedActivityStatus(status?): normalized in [completed, complete, succeeded, success]
// DEFECT: replace(/[_-]+/g,"").toLowerCase() normalization supplied pre-normalized by JSON layer.
fn isCompletedActivityStatus(normalized_len: u64) -> bool {
    return normalized_len == STR_LEN("completed") || normalized_len == STR_LEN("complete") || normalized_len == STR_LEN("succeeded") || normalized_len == STR_LEN("success");
}
// TS export function isTurnLiveStatus(status: string): normalized in [inprogress, running, started] (TS lines ~913-916)
fn isTurnLiveStatus(normalized_len: u64) -> bool {
    return normalized_len == STR_LEN("inprogress") || normalized_len == STR_LEN("running") || normalized_len == STR_LEN("started");
}
// TS function isSettledActivityRow(row): normalized status in [completed, complete, succeeded, success, failed, error, cancelled, canceled, interrupted]
fn isSettledActivityStatus(normalized_len: u64) -> bool {
    if isCompletedActivityStatus(normalized_len) { return true; };
    return normalized_len == STR_LEN("failed") || normalized_len == STR_LEN("error") || normalized_len == STR_LEN("cancelled") || normalized_len == STR_LEN("canceled") || normalized_len == STR_LEN("interrupted");
}
// TS function isRecord(value: unknown): value is Record<string, unknown> (file end)
fn isRecordChat(is_object: bool, is_array: bool, is_null: bool) -> bool { return is_object && !is_null && !is_array; }

// TS: export function selectTurnsForWaterfallMode(turns, mode, nowMs = Date.now()): WorkbenchTurn[] (lines 10-40)
//   if mode==="full" || empty -> turns.
//   if "post-compaction": scan turns/items backwards; first completed contextCompaction/compaction item ->
//     boundaryTurn = itemIndex===0 ? turn : {...turn, items: turn.items.slice(itemIndex)};
//     return [boundaryTurn, ...turns.slice(turnIndex+1)].
//   else ("recent-tools"): cutoff = nowMs - AGE; map turns: timestamp = completedAt ?? startedAt;
//     timestampMs = ts==null ? null : ts > 1e12 ? ts : ts*1000; live/null/recent turns unchanged;
//     else filter items keeping !isToolActivityItem(item) || (!turnCompleted && !isCompletedActivityStatus(item.status));
//     changed ? selected : turns.
// DEFECT: Date.now default, spread/slice/filter/map approximated over JSON buffers; decision rules preserved verbatim above.
fn selectTurnsForWaterfallMode(turns_count: u64, mode_len: u64, now_ms: f64, found_compaction_boundary: bool, boundary_turn_index: u64, out_count: &u64) -> i32 {
    if mode_len == STR_LEN("full") || turns_count == 0 { *out_count = turns_count; return 0; };
    if mode_len == STR_LEN("post-compaction") && found_compaction_boundary {
        *out_count = turns_count - boundary_turn_index;
        return 1;
    };
    *out_count = turns_count; // recent-tools filtering applied per-turn in fix phase
    return 2;
}
fn select_turn_timestamp_ms(has_ts: bool, ts: f64) -> f64 {
    if !has_ts { return -1.0; }; // null sentinel
    if ts > 1000000000000.0 { return ts; };
    return ts * 1000.0;
}
// TS: function isToolActivityItem(item): type in [commandExecution, fileChange, mcpToolCall, dynamicToolCall, toolCall, collabAgentToolCall, subAgentActivity, imageGeneration, imageView]
fn isToolActivityItem(type_len: u64) -> bool {
    return type_len == STR_LEN("commandExecution") || type_len == STR_LEN("fileChange") || type_len == STR_LEN("mcpToolCall") || type_len == STR_LEN("dynamicToolCall") || type_len == STR_LEN("toolCall") || type_len == STR_LEN("collabAgentToolCall") || type_len == STR_LEN("subAgentActivity") || type_len == STR_LEN("imageGeneration") || type_len == STR_LEN("imageView");
}

