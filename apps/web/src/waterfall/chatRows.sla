// TS: function assistantHeaderKey(row): [role, item.agentId, item.agentThreadId, item.agentName, title].filter(Boolean).join(":")
// TS: function itemKind(item, activeThinking?): ChatRowKind (lines 560-576) — sequential type checks:
//   userMessage->userMessage; agentMessage->assistantMessage; plan->plan; reasoning&&activeThinking->reasoningPreview;
//   commandExecution; imageGeneration; imageView; contextCompaction|compaction->contextCompaction;
//   enteredReviewMode|exitedReviewMode->reviewMode; fileChange; mcpToolCall|dynamicToolCall|toolCall|toolUse|tool_use|collabAgentToolCall->toolCall;
//   type.toLowerCase().includes("error")->error; else "status".
// DEFECT: String.includes/toLowerCase approximated — caller supplies contains_error flag.
fn itemKind(type_len: u64, active_thinking: bool, type_contains_error: bool, out_len: &u64) -> ptr {
    if type_len == STR_LEN("userMessage") { *out_len = STR_LEN("userMessage"); return STR_PTR("userMessage"); };
    if type_len == STR_LEN("agentMessage") { *out_len = STR_LEN("assistantMessage"); return STR_PTR("assistantMessage"); };
    if type_len == STR_LEN("plan") { *out_len = STR_LEN("plan"); return STR_PTR("plan"); };
    if type_len == STR_LEN("reasoning") && active_thinking { *out_len = STR_LEN("reasoningPreview"); return STR_PTR("reasoningPreview"); };
    if type_len == STR_LEN("commandExecution") { *out_len = STR_LEN("commandExecution"); return STR_PTR("commandExecution"); };
    if type_len == STR_LEN("imageGeneration") { *out_len = STR_LEN("imageGeneration"); return STR_PTR("imageGeneration"); };
    if type_len == STR_LEN("imageView") { *out_len = STR_LEN("imageView"); return STR_PTR("imageView"); };
    if type_len == STR_LEN("contextCompaction") || type_len == STR_LEN("compaction") { *out_len = STR_LEN("contextCompaction"); return STR_PTR("contextCompaction"); };
    if type_len == STR_LEN("enteredReviewMode") || type_len == STR_LEN("exitedReviewMode") { *out_len = STR_LEN("reviewMode"); return STR_PTR("reviewMode"); };
    if type_len == STR_LEN("fileChange") { *out_len = STR_LEN("fileChange"); return STR_PTR("fileChange"); };
    if type_len == STR_LEN("mcpToolCall") || type_len == STR_LEN("dynamicToolCall") || type_len == STR_LEN("toolCall") || type_len == STR_LEN("toolUse") || type_len == STR_LEN("tool_use") || type_len == STR_LEN("collabAgentToolCall") { *out_len = STR_LEN("toolCall"); return STR_PTR("toolCall"); };
    if type_contains_error { *out_len = STR_LEN("error"); return STR_PTR("error"); };
    *out_len = STR_LEN("status");
    return STR_PTR("status");
}
