}
// TS: beginFlush(): rows | null — null if inFlight || !pending || pending === applied; else take pending, inFlight=true.
fn WaterfallRowRefreshQueue_beginFlush(q: &WaterfallRowRefreshQueue, out_gen: &u64) -> bool {
    if q.in_flight { return false; };
    if !q.has_pending { return false; };
    if q.pending_gen == q.applied_gen { return false; };
    *out_gen = q.pending_gen;
    q.has_pending = false;
