// TS: enqueue(nextRows): boolean — false if nextRows === appliedRows || === pendingRows; else pending=nextRows, true.
fn WaterfallRowRefreshQueue_enqueue(q: &WaterfallRowRefreshQueue, next_gen: u64) -> bool {
    if next_gen == q.applied_gen { return false; };
    if q.has_pending && next_gen == q.pending_gen { return false; };
    q.pending_gen = next_gen; q.has_pending = true;
