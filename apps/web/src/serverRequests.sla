fn legacyReviewDecision(decision: u64, out_ptr: ptr) -> u64 {
    // accept -> "approved"; acceptForSession -> "approved_for_session"; decline -> "denied"; cancel -> "abort"
    if decision == 0 { return STR_LEN("approved"); };
    if decision == 1 { return STR_LEN("approved_for_session"); };
    if decision == 2 { return STR_LEN("denied"); };
    return STR_LEN("abort");
}

fn asRecord(value_ptr: ptr, value_len: u64, value_isObject: bool, out_ptr: ptr) -> u64 {
    // value != null && typeof === "object" && !Array.isArray ? value : {}
