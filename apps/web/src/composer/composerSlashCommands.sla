// Returns 1 = command produced (out filled), 0 = null (source: ComposerSlashCommand | null).
fn parseComposerSlashCommand(input: &SlashParseInput, out: &ComposerSlashCommand) -> i32 {
    // Source flow preserved in order:
    //   trimmed = text.trim(); reject if !startsWith("/") or startsWith("//").
    // DEFECT: RegExp /^\/([a-zA-Z][\w-]*)(?:\s+([\s\S]*))?$/ has no SLA regex engine -> hand scan in repair phase.
    //   name = match[1].toLowerCase(); rest = match[2].trim()
    //   hasImageAttachments = images.some(image => (image.kind ?? "image") === "image")
    // DEFECT: Array.some with closure -> loop over images_json entries in repair phase.
    //   mentions guard: mentions.length > 0 && name not in {image,edit-image,image-edit,img-edit,plan} -> null
    //   empty() = images.length === 0 && mentions.length === 0
    //   switch (name): image/img -> {type:"image", mode: hasImageAttachments?"edit":"generate", ...parseImageCommandOptions(rest)}
    //     edit-image/image-edit/img-edit -> mode:"edit"; fast -> empty? {type:"fast",enabled:parseOptionalBoolean(rest)} : null
    //     stats -> scope:"stats"; status -> scope:"status"; recap -> assistantTurn with fixed recap prompt literal
    //     plan -> toggle/on/off/send by rest; goal -> show/set/clear/pause/resume/complete/edit via lookup table
    //     rename/review/diff/compact -> empty-gated literals; resume -> resumeThread(threadId: rest||undefined)
    //     new/clear -> newConversation(permission: parseNewChatPermission(rest))
    //     usage/model/permissions/skills/plugins/mcp/hooks/apps/app/agents/subagents/pets/pet/experimental/memories/debug-config
    //       -> openSettings with section/pluginTab per source; side/btw -> openWorkspace sidechat;
    //     mention -> openWorkspace explorer; ps -> openWorkspace terminal;
    //     default -> WEB_TUI_ONLY_SLASH_COMMANDS.has(name) && empty() ? {type:"unsupported",name} : null
    // DEFECT: object spread {...parseImageCommandOptions(rest)} and string-union returns -> out-struct field fills.
    return 0;
}

