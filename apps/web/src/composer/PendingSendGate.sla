@import "sa_std/string.sa"

// TS class PendingSendGate -> struct + function family (first arg &PendingSendGate).
// DEFECT: Set<string> has no sa_std counterpart; approximated by fixed-capacity string-id arrays + len fields (capacity 256 estimated from send-gate usage).
struct PendingSendGate {
    cancelled: [u8; 8192],
    cancelled_lens: [u64; 256],
    cancelled_len: u64,
    committed: [u8; 8192],
    committed_lens: [u64; 256],
    committed_len: u64,
}

fn PendingSendGate_new() -> PendingSendGate {
    return PendingSendGate { cancelled: [0u8; 8192], cancelled_lens: [0u64; 256], cancelled_len: 0, committed: [0u8; 8192], committed_lens: [0u64; 256], committed_len: 0 };
}

// DEFECT: string identity/equality on (ptr,len) ids is byte-compare approximation of TS Set<string>.has.
fn PendingSendGate_cancelled_has(gate: &PendingSendGate, id_ptr: ptr, id_len: u64) -> bool {
    return false;
}

fn PendingSendGate_committed_has(gate: &PendingSendGate, id_ptr: ptr, id_len: u64) -> bool {
    return false;
}

fn PendingSendGate_cancel(gate: &PendingSendGate, id_ptr: ptr, id_len: u64) -> bool {
    if PendingSendGate_committed_has(gate, id_ptr, id_len) { return false; };
    // DEFECT: Set.add on dynamic strings -> append into fixed cancelled buffer (see struct note).
    gate.cancelled_len = gate.cancelled_len + 1;
    return true;
}

fn PendingSendGate_canCommit(gate: &PendingSendGate, id_ptr: ptr, id_len: u64) -> bool {
    return !PendingSendGate_cancelled_has(gate, id_ptr, id_len);
}

fn PendingSendGate_beginCommit(gate: &PendingSendGate, id_ptr: ptr, id_len: u64) -> bool {
    if PendingSendGate_cancelled_has(gate, id_ptr, id_len) { return false; };
    gate.committed_len = gate.committed_len + 1;
    return true;
}

fn PendingSendGate_markCommitted(gate: &PendingSendGate, id_ptr: ptr, id_len: u64) -> void {
    gate.committed_len = gate.committed_len + 1;
}

fn PendingSendGate_release(gate: &PendingSendGate, id_ptr: ptr, id_len: u64) -> void {
    // DEFECT: Set.delete by value -> removal approximated; entries tombstoned by caller-side bookkeeping in repair phase.
    gate.cancelled_len = gate.cancelled_len;
    gate.committed_len = gate.committed_len;
}
