  <!-- bind: Boolean(freeModelNotice) -->
          autoHideDuration={6000}
  <!-- bind: 6000 -->
          onClose={() => setFreeModelNotice(null)}
  <!-- bind: () => setFreeModelNotice(null) -->
  <!-- DEFECT: SAX: no behavior counterpart — event handling not in SAX dialect beyond onclick={^handler} -->
          anchorOrigin={{ vertical: "bottom", horizontal: "center" }}
  <!-- bind: vertical: "bottom", horizontal: "center" -->
        >
          <Alert severity="success" variant="filled" onClose={() => setFreeModelNotice(null)}>{freeModelNotice}</Alert>
  <!-- bind: () => setFreeModelNotice(null) -->
  <!-- bind: freeModelNotice -->
  <!-- DEFECT: SAX: no behavior counterpart — event handling not in SAX dialect beyond onclick={^handler} -->
        </Snackbar>
        </Box>
        </>
      </OnboardingTour>
    );
  }
</Component>

