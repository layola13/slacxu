  <!-- bind: bgcolor: "action.hover" -->
                        }}
                      >
                        <Box component="img" src={sectionIcon} alt="" sx={{ width: 20, height: 20, objectFit: "contain" }} />
  <!-- bind: sectionIcon -->
  <!-- bind: width: 20, height: 20, objectFit: "contain" -->
  <!-- DEFECT: SAX has no style-object binding -->
                        {!status ? (
  <!-- DEFECT: SAX: no behavior counterpart — conditional rendering -->
