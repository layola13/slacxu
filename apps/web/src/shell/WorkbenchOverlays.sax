                setTopBarOpen((open: boolean) => !open);
              } else {
                openTopBar();
              }
            }}
            onFocus={openTopBar}
  <!-- bind: openTopBar -->
  <!-- DEFECT: SAX: no behavior counterpart — event handling not in SAX dialect beyond onclick={^handler} -->
            onKeyDown={(event: ReactKeyboardEvent<HTMLDivElement>) => {
  <!-- DEFECT: SAX: no behavior counterpart — event handling not in SAX dialect beyond onclick={^handler} -->
