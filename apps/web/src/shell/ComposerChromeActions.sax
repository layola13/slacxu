        <Box component="span" sx={{ display: "inline-flex" }}>
  <!-- bind: display: "inline-flex" -->
  <!-- DEFECT: SAX has no style-object binding -->
          <IconButton
            size="small"
            color={isClaudeBackend ? "secondary" : "default"}
  <!-- bind: isClaudeBackend ? "secondary" : "default" -->
            aria-label={`${t("newChat.cliBackend")}: ${isClaudeBackend ? t("newChat.cliBackendClaude") : t("newChat.cliBackendCodex")}`}
  <!-- bind: t("newChat.cliBackend") -->
  <!-- bind: isClaudeBackend ? t("newChat.cliBackendClaude") : t("newChat.cliBackendCodex") -->
