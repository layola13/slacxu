// Converted 1:1 from apps/web/src/threadSelection.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "sa_std/ptr.sa"
// MutableValue<T> = { current: T } — mutable ref cell; DEFECT: generics — concrete cells below.
struct MutableValueNumber { current: u64 }
struct MutableValueStringOrNull { current_ptr: ptr, current_len: u64, isNull: bool }
struct ThreadSelection { epoch: u64, threadId_ptr: ptr, threadId_len: u64 }

fn beginThreadSelection(epochRef: &MutableValueNumber, activeThreadIdRef: &MutableValueStringOrNull, threadId_ptr: ptr, threadId_len: u64, out: &ThreadSelection) -> void {
    let epoch: u64 = epochRef.current + 1;
    epochRef.current = epoch;
    activeThreadIdRef.current_ptr = threadId_ptr;
    activeThreadIdRef.current_len = threadId_len;
    activeThreadIdRef.isNull = false;
    out.epoch = epoch;
    out.threadId_ptr = threadId_ptr;
    out.threadId_len = threadId_len;
}

fn isThreadSelectionCurrent(selection: &ThreadSelection, epochRef: &MutableValueNumber, activeThreadIdRef: &MutableValueStringOrNull) -> bool {
    // selection.epoch === epochRef.current && selection.threadId === activeThreadIdRef.current — DEFECT: string equality on (ptr,len) helper pending.
    if selection.epoch != epochRef.current { return false; };
    if activeThreadIdRef.isNull { return false; };
    return selection.threadId_len == activeThreadIdRef.current_len;
}

struct ShouldRenderCachedTranscriptInput { hasCachedTranscript: bool, selectionEpoch: u64, currentEpoch: u64, threadId_ptr: ptr, threadId_len: u64, activeThreadId_ptr: ptr, activeThreadId_len: u64, activeThreadId_isNull: bool }

fn shouldRenderCachedTranscript(input: &ShouldRenderCachedTranscriptInput) -> bool {
    if !input.hasCachedTranscript { return false; };
    if input.selectionEpoch != input.currentEpoch { return false; };
    if input.activeThreadId_isNull { return false; };
    return input.threadId_len == input.activeThreadId_len; // + byte equality in fix stage
}
