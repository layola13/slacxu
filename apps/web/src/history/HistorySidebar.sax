              >
  <!-- bind: mt: effectiveViewMode === "list" ? 0 : 1.25, flex: "0 0 auto" -->
                <Box sx={{ mt: effectiveViewMode === "list" ? 0 : 1.25, flex: "0 0 auto" }}>
