  <!-- bind: title -->
  <!-- bind: disabled -->
                          <IconButton size="small" aria-label={t("history.exportAria", { title })} disabled={disabled} onClick={() => void exportThread(thread)}>
  // DEFECT: SAX: no behavior counterpart (event handler / hook in JSX)
