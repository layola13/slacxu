  <!-- bind: t("history.saveRename") -->
                    <Tooltip title={t("history.saveRename")}>
                      <span>
  <!-- bind: t("history.saveRename") -->
  <!-- bind: !renameDraft.trim() || disabled -->
                        <IconButton size="small" aria-label={t("history.saveRename")} disabled={!renameDraft.trim() || disabled} onClick={() => void saveRename(thread.id)}>
  // DEFECT: SAX: no behavior counterpart (event handler / hook in JSX)
                          <CheckIcon fontSize="small" />
                        </IconButton>
                      </span>
                    </Tooltip>
  <!-- bind: t("history.cancelRename") -->
                    <Tooltip title={t("history.cancelRename")}>
                      <IconButton
                        size="small"
  <!-- bind: t("history.cancelRename") -->
                        aria-label={t("history.cancelRename")}
  <!-- bind: disabled -->
                        disabled={disabled}
                        onClick={() => {
  // DEFECT: SAX: no behavior counterpart (event handler / hook in JSX)
                          setEditingThreadId(null);
                          setRenameDraft("");
                        }}
                      >
                        <CloseIcon fontSize="small" />
                      </IconButton>
                    </Tooltip>
                  </Stack>
                ) : (
                  <>
                    <ListItemText
  <!-- bind: title -->
                      primary={title}
  <!-- bind: thread -->
  <!-- bind: usage -->
                      secondary={<HistoryThreadMetadata thread={thread} usage={usage} mode={effectiveViewMode} t={t} />}
  <!-- bind: noWrap: true, fontWeight: activeThreadId === thread.id ? 700 : 500 -->
                      primaryTypographyProps={{ noWrap: true, fontWeight: activeThreadId === thread.id ? 700 : 500 }}
  <!-- bind: minWidth: 0, flex: 1 -->
                      sx={{ minWidth: 0, flex: 1 }}
                    />
                    <Stack
                      className="history-actions"
                      direction="row"
  <!-- bind: 0.25 -->
