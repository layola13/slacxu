  <!-- bind: activeThreadId === thread.id -->
                    active={activeThreadId === thread.id}
  <!-- bind: running -->
                    running={running}
  <!-- bind: t("composer.running") -->
                    runningLabel={t("composer.running")}
  <!-- bind: thread.id -->
                    threadId={thread.id}
                  />
                </Box>
                {isSshThread(thread) ? (
  <!-- bind: sshThreadTooltip(thread) ?? "SSH" -->
                  <Tooltip title={sshThreadTooltip(thread) ?? "SSH"}>
                    <TerminalIcon
                      data-testid="ssh-thread-indicator"
  <!-- bind: sshThreadTooltip(thread) ?? "SSH" -->
                      aria-label={sshThreadTooltip(thread) ?? "SSH"}
                      color="primary"
  <!-- bind: mt: effectiveViewMode === "list" ? 0 : 0.85, fontSize: 17, flex: "0 0 auto" -->
                      sx={{ mt: effectiveViewMode === "list" ? 0 : 0.85, fontSize: 17, flex: "0 0 auto" }}
                    />
                  </Tooltip>
                ) : null}
                {isEditing ? (
                  <Stack
                    direction="row"
  <!-- bind: 0.5 -->
                    spacing={0.5}
                    alignItems="center"
  <!-- bind: minWidth: 0, flex: 1 -->
                    sx={{ minWidth: 0, flex: 1 }}
  <!-- bind: (event) => event.stopPropagation() -->
                    onClick={(event) => event.stopPropagation()}
  // DEFECT: SAX: no behavior counterpart (event handler / hook in JSX)
                    onKeyDown={(event) => {
  // DEFECT: SAX: no behavior counterpart (event handler / hook in JSX)
                      if (event.key === "Enter") {
                        event.preventDefault();
                        void saveRename(thread.id);
                      }
                      if (event.key === "Escape") {
                        event.preventDefault();
                        setEditingThreadId(null);
                        setRenameDraft("");
                      }
                    }}
                  >
                    <TextField
                      size="small"
  <!-- bind: renameDraft -->
                      value={renameDraft}
  <!-- bind: (event) => setRenameDraft(event.target.value) -->
                      onChange={(event) => setRenameDraft(event.target.value)}
  // DEFECT: SAX: no behavior counterpart (event handler / hook in JSX)
  <!-- bind: "aria-label": t("history.renameLabel") -->
                      inputProps={{ "aria-label": t("history.renameLabel") }}
                      autoFocus
