const LOW_FPS_THRESHOLD: u64 = 10;
const LOW_FPS_REQUIRED_SAMPLES: u64 = 3;
const LOW_FPS_RECOVERY_THRESHOLD: u64 = 24;
const LOW_FPS_RECOVERY_REQUIRED_SAMPLES: u64 = 5;
const LOW_FPS_REPORT_COOLDOWN_MS: u64 = 60000;

struct LowFpsState {
    consecutiveLowSamples: u64,
    consecutiveRecoverySamples: u64,
    pressured: bool,
    lastReportedAt: f64,
    has_lastReportedAt: bool, // source: number | null
}

struct LongTaskStats {
    count: u64,
    totalDurationMs: f64,
    maxDurationMs: f64,
    lastDurationMs: f64,
}

fn createLowFpsState(out: &LowFpsState) -> void {
    out.consecutiveLowSamples = 0;
    out.consecutiveRecoverySamples = 0;
    out.pressured = false;
    out.has_lastReportedAt = false;
}

struct LowFpsSample {
    fps: f64,
    now: f64,
    visible: bool,
}

struct LowFpsEvalResult {
    state: LowFpsState,
    shouldReport: bool,
}

fn evaluateLowFpsSample(state: &LowFpsState, sample: &LowFpsSample, out: &LowFpsEvalResult) -> void {
    out.shouldReport = false;
    // DEFECT: Number.isFinite check on f64 fps -> host math helper in repair phase; NaN semantics differ.
    if !sample.visible {
        out.state.consecutiveLowSamples = 0;
        out.state.consecutiveRecoverySamples = 0;
        out.state.pressured = state.pressured;
        out.state.has_lastReportedAt = state.has_lastReportedAt;
        return;
    };
    if state.pressured {
        // consecutiveRecoverySamples = fps >= 24 ? min(5, prev + 1) : 0
        // pressured = consecutiveRecoverySamples < 5
        // cooldownElapsed = lastReportedAt === null || now - lastReportedAt >= 60_000
        // shouldReport = fps < 10 && cooldownElapsed
        // state.consecutiveLowSamples = pressured ? 3 : 0 (source semantics preserved in repair phase)
        return;
    };
    if sample.fps >= 10.0 {
        out.state.consecutiveLowSamples = 0;
        out.state.consecutiveRecoverySamples = 0;
        out.state.pressured = false;
        out.state.has_lastReportedAt = state.has_lastReportedAt;
        return;
    };
    // consecutiveLowSamples = min(3, prev + 1); pressured = >= 3; shouldReport = pressured && cooldownElapsed
}

