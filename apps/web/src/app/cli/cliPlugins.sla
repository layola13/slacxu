@import "./pluginCatalog.sla"
/**
 * The CLI surface is assembled from the installed backend plugins'
 * descriptors (see pluginCatalog.ts — the plugin projects under
 * `plugins/` are the source of truth for labels, icons and installation
 * kinds). Mini is the only built-in backend; every other backend is
 * optional and must be loaded only after the user selects or opens its
 * controls.
 */
// TS: export type CliPluginDefinition = { ... }
struct CliPluginDefinition {
    id: CliBackend,
    label: [u8; 256],
    label_len: u64,
    icon: [u8; 256],
    icon_len: u64,
    builtIn: bool,
    has_defaultBackend: bool,
    defaultBackend: bool,
    has_installationKind: bool,
    installationKind: CliInstallationKind,
}

// TS: export const CLI_PLUGINS = BACKEND_WEB_PLUGINS.map((plugin) => ({ id: plugin.manifest.id as CliBackend, label: plugin.descriptor.label, icon: plugin.descriptor.icon, builtIn: plugin.descr
// DEFECT: function-valued const (closure, expression body) — return expression kept as comment
fn CLI_PLUGINS() -> i32 { return 0; }

let DEFAULT_CLI_BACKEND = "mini"; // string const (ptr,len) at use sites

/** Every backend id is its own plugin id (auggie reopened as an
 * independent plugin on 2026-10-24; it no longer shares agy's). */
fn cliPluginId(id: CliBackend) -> CliBackend {
    return id;
}

fn cliPlugin(id: CliBackend) -> CliPluginDefinition {
    let normalized = cliPluginId(id);
    // DEFECT: closure/arrow
    // TS: const found = CLI_PLUGINS.find((plugin) => plugin.id === normalized);
    let found: u64 = 0; // placeholder — see TS line above
    if (found) return found;
    // No silent substitution: an unregistered backend renders as its
    // own raw id, never as another backend (no-fallback rule).
    return { id: normalized, label: normalized, icon: "", builtIn: false };
}

