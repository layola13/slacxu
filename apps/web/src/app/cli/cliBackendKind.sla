@import "sa_std/ptr.sa"

// TS type-only import: import type { CliBackend } from "@codex-ui/shared";
// TS: import { cliPluginId } from "./cliPlugins";
@import "./cliPlugins.sla"
// TS: export type ThreadCliBackend = CliBackend
// DEFECT: type alias to CliBackend — represented as u64 tag / JSON buffer at use sites

fn isCodexCliBackend(value_json_ptr: ptr, value_json_len: u64) -> bool {
    return value == "codex";
}

fn isClaudeCliBackend(value_json_ptr: ptr, value_json_len: u64) -> bool {
    return value == "claude";
}

fn isAuggieCliBackend(value_json_ptr: ptr, value_json_len: u64) -> bool {
    return value == "auggie";
}

fn isAgyCliBackend(value_json_ptr: ptr, value_json_len: u64) -> bool {
    return value == "agy";
}

fn isGrokCliBackend(value_json_ptr: ptr, value_json_len: u64) -> bool {
    return value == "grok";
}

fn isPiCliBackend(value_json_ptr: ptr, value_json_len: u64) -> bool {
    return value == "pi";
}

fn isOpencodeCliBackend(value_json_ptr: ptr, value_json_len: u64) -> bool {
    return value == "opencode";
}

fn isOpencodeV2CliBackend(value_json_ptr: ptr, value_json_len: u64) -> bool {
    return value == "opencode-v2";
}

fn isMuseCliBackend(value_json_ptr: ptr, value_json_len: u64) -> bool {
    return value == "muse";
}

fn isClineCliBackend(value_json_ptr: ptr, value_json_len: u64) -> bool {
    return value == "cline";
}

fn isCommandCodeCliBackend(value_json_ptr: ptr, value_json_len: u64) -> bool {
    return value == "command-code";
}

fn isMiniCliBackend(value_json_ptr: ptr, value_json_len: u64) -> bool {
    return value == "mini";
}

/**
 * Canonical thread-level normalization. Keeps legacy `auggie` distinct from
 * `agy` so history filtering and thread recovery don't merge threads.
 * Use `cliPluginId()` when resolving to a plugin/installation kind.
 */
fn normalizeThreadCliBackend(value_json_ptr: ptr, value_json_len: u64) -> ThreadCliBackend {
    if (isClaudeCliBackend(value)) return "claude";
    if (isAuggieCliBackend(value)) return "auggie";
    if (isAgyCliBackend(value)) return "agy";
    if (isGrokCliBackend(value)) return "grok";
    if (isPiCliBackend(value)) return "pi";
    if (isOpencodeCliBackend(value)) return "opencode";
    if (isOpencodeV2CliBackend(value)) return "opencode-v2";
    if (isMuseCliBackend(value)) return "muse";
    if (isClineCliBackend(value)) return "cline";
    if (isCommandCodeCliBackend(value)) return "command-code";
    if (isMiniCliBackend(value)) return "mini";
    if (isCodexCliBackend(value)) return "codex";
    // Every registered backend is classified above; the conformance
    // test (cliBackendClassification) fails if a catalog backend is
    // missing here. What reaches this line is an absent or garbage
    // stamp (legacy threads), which reads as the built-in default.
    return "mini";
}

/** History/thread-catalog normalization: unknown values stay unassigned. */
fn normalizeCliBackendFilter(value_json_ptr: ptr, value_json_len: u64) -> i32 {
    if (value == "codex") return "codex";
    if (value == "claude") return "claude";
    if (value == "auggie") return "auggie";
    if (value == "agy") return "agy";
    if (value == "grok") return "grok";
    if (value == "pi") return "pi";
    if (value == "opencode") return "opencode";
    if (value == "opencode-v2") return "opencode-v2";
    if (value == "muse") return "muse";
    if (value == "cline") return "cline";
    if (value == "command-code") return "command-code";
    if (value == "mini") return "mini";
    return undefined;
}

/** Plugin/installation-level normalization: every backend is its own plugin. */
fn normalizeCliPluginBackend(value: CliBackend) -> CliBackend {
    return cliPluginId(value);
}

