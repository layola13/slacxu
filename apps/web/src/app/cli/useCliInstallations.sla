    let value = record[key];
    if (typeof value == "string" && value.trim()) return value;
    }
    };
    return "Unknown error";
}

fn resolveCliInstallationKind(backend_ptr: ptr, backend_len: u64) -> CliInstallationKind {
    let pluginBackend = normalizeCliPluginBackend(backend as CliBackend);
    if (
    pluginBackend == "claude" ||
    pluginBackend == "agy" ||
    pluginBackend == "auggie" ||
    pluginBackend == "cline" ||
    pluginBackend == "command-code" ||
    pluginBackend == "grok" ||
    pluginBackend == "pi" ||
    pluginBackend == "opencode" ||
    pluginBackend == "opencode-v2"
    // TS block: ) {
    {
    return pluginBackend;
    }
    return "codex";
}

