fn formatCliErrorText(error_json_ptr: ptr, error_json_len: u64) -> i32 {
    if (error instanceof Error) return error.message;
    if (typeof error == "string") return error;
    if error && typeof error == "object" {
    let record = error as Record<string, unknown>;
    // DEFECT: for-of over dynamic collection — index loop over ["message", "error", "detail", "reason"] buffer
