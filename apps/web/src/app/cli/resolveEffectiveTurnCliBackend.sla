// Converted 1:1 from apps/web/src/app/cli/resolveEffectiveTurnCliBackend.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "sa_std/ptr.sa"

// TS type-only import: import type { CliBackend } from "@codex-ui/shared";
// TS: export interface EffectiveTurnCliBackendInput
struct EffectiveTurnCliBackendInput {
    // TS field (unconverted shape): /** Current new-conversation backend (`runtimeSelection.cliBackend`). */
    // DEFECT: dynamic object — field currentBackend: CliBackend | string | null | undefined kept as JSON text buffer
    currentBackend_json: [u8; 4096],
    currentBackend_json_len: u64,
    // TS field (unconverted shape): /** Persisted per-thread backend for the turn being started. */
    // DEFECT: dynamic object — field threadBackend: CliBackend | string | null | undefined kept as JSON text buffer
    threadBackend_json: [u8; 4096],
    threadBackend_json_len: u64,
    // TS field (unconverted shape): /** Provider resolved for the turn (`resolveProviderSelectionId` result). */
    // DEFECT: dynamic object — field resolvedProviderId: string | null | undefined kept as JSON text buffer
    resolvedProviderId_json: [u8; 4096],
    resolvedProviderId_json_len: u64,
    // TS field (unconverted shape): /**
    // TS field (unconverted shape): * Fallback when no backend matches. Callers pass their original fallback
    // TS field (unconverted shape): * expression so behavior stays identical per call site.
    // TS field (unconverted shape): */
    fallback: CliBackend,
    // TS field (unconverted shape): /**
    // TS field (unconverted shape): * The main composer checks the current/thread mini backend explicitly
    // TS field (unconverted shape): * the sidechat path never did and falls through to its fallback instead.
    // TS field (unconverted shape): * Defaults to true.
    // TS field (unconverted shape): */
    has_includeMini: bool,
    includeMini: bool,
}

/**
 * Pure priority order for the backend a turn actually runs on: a sticky
 * current/thread selection or an official-relay provider wins, otherwise the
 * caller-supplied fallback applies. Extracted verbatim from the two
 * previously inline ternaries in App.tsx (main composer + sidechat).
 */
fn resolveEffectiveTurnCliBackend(input: EffectiveTurnCliBackendInput) -> CliBackend {
    let { currentBackend, threadBackend, resolvedProviderId, fallback } = input;
    // DEFECT: nullish coalescing
    // TS: const includeMini = input.includeMini ?? true;
    let includeMini: u64 = 0; // placeholder — see TS line above
    if currentBackend == "agy" || threadBackend == "agy" || resolvedProviderId == "agy-official" {
    return "agy";
    };
    if currentBackend == "grok" || threadBackend == "grok" || resolvedProviderId == "grok-official" {
    return "grok";
    };
    if currentBackend == "claude" || threadBackend == "claude" {
    return "claude";
    };
    if currentBackend == "pi" || threadBackend == "pi" || resolvedProviderId == "pi-relay" {
    return "pi";
    };
    if currentBackend == "opencode-v2" || threadBackend == "opencode-v2" {
    return "opencode-v2";
    };
    if currentBackend == "opencode" || threadBackend == "opencode" || resolvedProviderId == "opencode-local" {
    return "opencode";
    };
    if currentBackend == "codex" || threadBackend == "codex" {
    return "codex";
    };
    if includeMini && (currentBackend == "mini" || threadBackend == "mini") {
    return "mini";
    };
    return fallback;
}

