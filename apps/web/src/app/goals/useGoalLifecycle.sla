fn record(value_json_ptr: ptr, value_json_len: u64) -> i32 {
    return value && typeof value == "object" && !Array.isArray(value) ? value as Record<string, unknown> : {};
}

fn text(value_json_ptr: ptr, value_json_len: u64) -> i32 {
    return typeof value == "string" && value.length > 0 ? value : null;
}

fn errorText(error_json_ptr: ptr, error_json_len: u64) -> i32 {
    if (error instanceof Error) return error.message;
    if (typeof error == "string") return error;
    // DEFECT: try/catch has no SLA counterpart — status-code branches approximate: try { return JSON.stringify(error); } catch { return String(error); }
}

