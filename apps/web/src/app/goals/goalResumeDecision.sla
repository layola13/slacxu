// Converted 1:1 from apps/web/src/app/goals/goalResumeDecision.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "sa_std/ptr.sa"

fn shouldPromptGoalResume(handledThreadIds_json_ptr: ptr, handledThreadIds_json_len: u64, threadId_ptr: ptr, threadId_len: u64) -> bool {
    return !handledThreadIds.has(threadId);
}

fn markGoalResumeHandled(handledThreadIds_json_ptr: ptr, handledThreadIds_json_len: u64, threadId_ptr: ptr, threadId_len: u64) -> i32 {
    handledThreadIds.add(threadId);
}

fn resetGoalResumeDecision(handledThreadIds_json_ptr: ptr, handledThreadIds_json_len: u64, threadId_ptr: ptr, threadId_len: u64) -> i32 {
    handledThreadIds.delete(threadId);
}

