    return { objective, tokenBudget: num };
}

fn parseGoalBudgetToken(token_ptr: ptr, token_len: u64) -> i32 {
    let m = /^(\d+(?:\.\d+)?)\s*([kKmM]?)$/.exec(token.trim());
    if (!m) return undefined;
