// Converted 1:1 from apps/web/src/app/conversationStatus.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "sa_std/ptr.sa"

// TS type-only import: import type { WorkbenchTurn } from "../state/codexClient";
// TS: export type ConversationStatus = "connecting" | "working" | "idle" | "disconnect" | "retrying" | "engine-error"
let ConversationStatus_CONNECTING: u64 = 0; // union member "connecting"
let ConversationStatus_WORKING: u64 = 1; // union member "working"
let ConversationStatus_IDLE: u64 = 2; // union member "idle"
let ConversationStatus_DISCONNECT: u64 = 3; // union member "disconnect"
let ConversationStatus_RETRYING: u64 = 4; // union member "retrying"
let ConversationStatus_ENGINE_ERROR: u64 = 5; // union member "engine-error"

fn hasConversationWork(activeThreadId_json_ptr: ptr, activeThreadId_json_len: u64, activeRunningTurn_json_ptr: ptr, activeRunningTurn_json_len: u64, pendingAcceptedThreads_json_ptr: ptr, pendingAcceptedThreads_json_len: u64) -> bool {
    return creatingNewConversation
    || Boolean(activeRunningTurn)
    || Boolean(activeThreadId && pendingAcceptedThreads.has(activeThreadId));
}

fn getConversationStatus(connected: bool, enginePhase_ptr: ptr, enginePhase_len: u64, hasConversationWork: bool) -> ConversationStatus {
    if (!connected) return "disconnect";
    if (enginePhase == "starting" || enginePhase == "idle") return "retrying";
    if (enginePhase != "ready") return enginePhase == "error" ? "engine-error" : "retrying";
    if (turnRetrying) return "retrying";
    if (conversationStarting) return "connecting";
    return hasConversationWork ? "working" : "idle";
}

