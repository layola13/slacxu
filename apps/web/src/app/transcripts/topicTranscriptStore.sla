fn TopicTranscriptStore_applyBackgroundNotifications(self: &TopicTranscriptStore, threadId_ptr: ptr, threadId_len: u64, notifications_len: u64) -> i32 {
    this.loadedSnapshotThreadIds.delete(threadId);
    // DEFECT: nullish coalescing
    // TS: const previousSummary = this.summaryTurnsByThreadId.get(threadId) ?? EMPTY_TURNS;
    let previousSummary: u64 = 0; // placeholder — see TS line above
    let nextSummary = reduceBackgroundTurnLifecycle(threadId, previousSummary, notifications);
    if (nextSummary != previousSummary) this.assignBackgroundSummary(threadId, previousSummary, nextSummary);
    let previousOverview = this.agentOverviewByThreadId.get(threadId);
    let nextOverview = reduceAgentOverview(threadId, notifications, previousOverview);
    let overviewChanged = nextOverview != previousOverview;
    if (nextOverview) this.agentOverviewByThreadId.set(threadId, nextOverview);
    return { lifecycleChanged: nextSummary != previousSummary, overviewChanged };
}

fn TopicTranscriptStore_mergeTurn(self: &TopicTranscriptStore, turn: WorkbenchTurn) -> i32 {
    // Inline /review and other non-authoritative turns must merge into the
    // live waterfall instead of filtering the same-id turn and replacing it,
    // so streamed items that arrived before the RPC response are preserved.
    this.mergeTurns([turn]);
}

fn TopicTranscriptStore_replaceThreadTurn(self: &TopicTranscriptStore, turn: WorkbenchTurn) -> i32 {
    if !this.shouldRetainFullTranscript(turn.threadId) {
    this.loadedSnapshotThreadIds.delete(turn.threadId);
    this.mergeTurns([turn]);
    return;
