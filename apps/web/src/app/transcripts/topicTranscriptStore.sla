fn isTurnLifecycleNotification(notification: JsonRpcNotification) -> bool {
    return notification.method == "turn/started"
    || notification.method == "turn/completed"
    || notification.method == "turn/failed"
    || notification.method == "turn/interrupted";
}

fn isTurnActivityNotification(notification: JsonRpcNotification) -> bool {
    return notification.method == "item/started"
    || (notification.method == "error" && record(notification.params).willRetry == true);
}

fn terminalTurnStatus(method_ptr: ptr, method_len: u64) -> i32 {
    if (method == "turn/completed") return "completed";
    if (method == "turn/interrupted") return "interrupted";
    return "failed";
}

fn isInterruptedTurnStatus(status_ptr: ptr, status_len: u64) -> bool {
    // DEFECT: nullish coalescing
    // TS: return ["interrupted", "cancelled", "canceled"].includes((status ?? "").toLowerCase());
    return 0; // placeholder — see TS line above
}

fn isTerminalAgentOverviewStatus(status_json_ptr: ptr, status_json_len: u64) -> bool {
    return status == "completed" || status == "failed" || status == "interrupted";
}

