    // DEFECT: array higher-order method, closure/arrow
    // TS: const next = mergeWorkbenchTurns(current.filter((entry) => entry.id !== turn.id), [turn]);
    let next: u64 = 0; // placeholder — see TS line above
    this.replaceThreadTurns(turn.threadId, next);
}

