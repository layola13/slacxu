    // DEFECT: optional chaining in condition — approximated
    if !this.threadsById.get(turn.threadId)?.parentThreadId {
    this.loadedSnapshotThreadIds.add(turn.threadId);
    };
    // DEFECT: nullish coalescing
    // TS: const current = this.turnsByThreadId.get(turn.threadId) ?? EMPTY_TURNS;
