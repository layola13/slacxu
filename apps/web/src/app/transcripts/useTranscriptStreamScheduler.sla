    return this.queue.length;
}

fn TranscriptStreamBuffer_hasPending(self: &TranscriptStreamBuffer) -> bool {
    return this.queue.length > 0;
}

fn TranscriptStreamBuffer_coalesceQueue(self: &TranscriptStreamBuffer) -> i32 {
    if (this.queue.length <= 1) return;
    this.queue = coalesceStreamingWorkbenchNotifications(this.queue);
    if this.queue.length > MAX_TRANSCRIPT_QUEUE_CAP {
    this.queue = this.queue.slice(this.queue.length - MAX_TRANSCRIPT_QUEUE_CAP);
    };
}

fn TranscriptStreamBuffer_flushNextBatch(self: &TranscriptStreamBuffer) -> i32 {
    if (this.queue.length == 0) return null;
    if this.queue.length > this.maxBatchSize {
    this.coalesceQueue();
    };
    let queued = this.queue.splice(0, this.maxBatchSize);
    return coalesceStreamingWorkbenchNotifications(queued);
}

fn TranscriptStreamBuffer_clear(self: &TranscriptStreamBuffer) -> i32 {
    this.queue = [];
}

