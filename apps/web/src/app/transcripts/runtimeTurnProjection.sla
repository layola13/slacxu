fn isTurnActivityNotification(notification: JsonRpcNotification) -> bool {
    return notification.method == "item/started"
    || notification.method == "item/agentMessage/delta"
    || notification.method == "item/reasoning/summaryPartAdded"
    || notification.method == "item/reasoning/summaryTextDelta"
    || notification.method == "item/reasoning/textDelta"
    || notification.method == "item/plan/delta"
    || notification.method == "item/commandExecution/outputDelta";
}

fn isRuntimeStructuralItemNotification(notification: JsonRpcNotification) -> bool {
    let item = record(record(notification.params).item);
    let type = runtimeItemType(item);
    return type == "userMessage" || type == "plan"
    || type == "enteredReviewMode" || type == "exitedReviewMode";
}

