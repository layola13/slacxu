fn isReviewModeActive(turn_json_ptr: ptr, turn_json_len: u64) -> bool {
    if (!turn) return false;
    let active = false;
    // DEFECT: for-of over dynamic collection — index loop over turn.items buffer
    for item_idx in 0..turn_items_len {
    if (item.type == "enteredReviewMode") active = true;
    if (item.type == "exitedReviewMode") active = false;
    }
    return active;
}

fn isCannotSteerReviewTurnError(error_json_ptr: ptr, error_json_len: u64) -> bool {
    return /cannot steer (?:a )?review turn/i.test(errorText(error));
}

