fn filterThreadsByDateRange(threads: ThreadCatalog, dateRange: ThreadDateRange) -> ThreadCatalog {
    let from = normalizedDateInput(dateRange.from);
    let to = normalizedDateInput(dateRange.to);
    if (!from && !to) return threads;
    let lower = from && to && from > to ? to : from;
    let upper = from && to && from > to ? from : to;
    // TS block: return threads.filter((thread) => {
    {
    let day = threadDateKey(thread);
    return Boolean(day && (!lower || day >= lower) && (!upper || day <= upper));
    }
    );
}

