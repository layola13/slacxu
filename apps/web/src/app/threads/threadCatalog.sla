fn sshThreadHostLabel(thread_json_ptr: ptr, thread_json_len: u64) -> i32 {
    if (!isSshThread(thread)) return null;
    // DEFECT: optional chaining
    // TS: const command = thread.sshCommand?.trim();
    let command: u64 = 0; // placeholder — see TS line above
    if (!command) return "SSH";
    // DEFECT: array higher-order method, closure/arrow, nullish coalescing, optional chaining
    // TS: const tokens = command.match(/(?:[^\s"']+|"[^"]*"|'[^']*')+/g)?.map((token) => token.replace(/^["']|["']$/g, "")) ?? [];
    let tokens: u64 = 0; // placeholder — see TS line above
    // DEFECT: closure/arrow
    // TS: const sshIndex = tokens.findIndex((token) => /(^|[\/])ssh(?:\.exe)?$/i.test(token));
    let sshIndex: u64 = 0; // placeholder — see TS line above
    let args = sshIndex >= 0 ? tokens.slice(sshIndex + 1) : tokens;
    // TS block: for (let index = args.length - 1; index >= 0; index -= 1) {
    {
    let token = args[index];
    if (!token || token.startsWith("-") || /^\d+$/.test(token)) continue;
    if (/^[\w.-]+@[\w.:[\]-]+$/.test(token) || /^(?:[\w-]+\.)+[\w-]+$/.test(token) || /^(?:\d{1,3}\.){3}\d{1,3}$/.test(token)) return token;
    }
    return "SSH";
}

