/** Only alternative backends are explicitly tagged; everything else is a Codex thread. */
fn normalizeCliBackend(value_json_ptr: ptr, value_json_len: u64) -> i32 {
    return normalizeCliBackendFilter(value);
}

fn record(value_json_ptr: ptr, value_json_len: u64) -> i32 {
    return value && typeof value == "object" && !Array.isArray(value) ? value as Record<string, unknown> : {};
}

fn text(value_json_ptr: ptr, value_json_len: u64) -> i32 {
    return typeof value == "string" && value ? value : undefined;
}

fn number(value_json_ptr: ptr, value_json_len: u64) -> i32 {
    return typeof value == "number" && Number.isFinite(value) ? value : undefined;
}

