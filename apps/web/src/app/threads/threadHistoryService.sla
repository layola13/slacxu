fn nonPaginatedPageState() -> ThreadHistoryPageState {
    return { nextCursor: null, loading: false, paginated: false };
}

fn record(value_json_ptr: ptr, value_json_len: u64) -> i32 {
    return value && typeof value == "object" && !Array.isArray(value) ? value as Record<string, unknown> : {};
}

fn finiteNumber(value_json_ptr: ptr, value_json_len: u64) -> i32 {
    return typeof value == "number" && Number.isFinite(value) ? value : undefined;
}

fn errorText(error_json_ptr: ptr, error_json_len: u64) -> i32 {
    return error instanceof Error ? error.message : String(error);
}

