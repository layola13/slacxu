// DEFECT: withTimeout / try/catch layering has no SLA counterpart; timeouts kept as millisecond constants, failures as status codes.

struct AuthSession {
    json_ptr: ptr, json_len: u64,
    authenticated: bool, loginRequired: bool,
    token_ptr: ptr, token_len: u64, token_is_null: bool,
    websocket_handshakeTimeoutMs: u64, websocket_is_null: bool,
    user_id_ptr: ptr, user_id_len: u64, user_is_null: bool,
}

struct UseSessionBootstrapInput {
    state_json_ptr: ptr, state_json_len: u64,
    providers_json_ptr: ptr, providers_json_len: u64,
    dispatch_handle: u64, client_handle: u64, t_handle: u64,
    authStatus_ptr: ptr, authStatus_len: u64,
    authSession: AuthSession, authSession_is_null: bool,
    cliPrerequisitesBlocked: bool,
    clientRef_is_null: bool,
    mounted: bool,
    sessionVerifiedForWorkbench: bool,
}

