fn verifySessionAfterDisconnect(input: &UseSessionBootstrapInput) -> bool {
    // await recoverOrExpireSession();
    return recoverOrExpireSession();
}

fn handleSessionExpired(input: &UseSessionBootstrapInput) -> i32 { return 0; } // supplied via input in TS

// useEffect(() => { ...bootstrap IIFE...; return () => { mounted = false; }; }, [applyLoadedCodexConfig, cliPrerequisitesBlocked, client, loadBasics, refreshProviders])
fn useSessionBootstrap_effect(input: &UseSessionBootstrapInput) -> i32 {
    if input.cliPrerequisitesBlocked { return 0; };
    input.mounted = true;
    input.sessionVerifiedForWorkbench = false;
    let stored_ptr: ptr = STR_PTR(""); let stored_len: u64 = 0;
    let has_stored = localStorage_getItem(STR_PTR("AUTH_TOKEN_STORAGE_KEY"), STR_LEN("AUTH_TOKEN_STORAGE_KEY"), stored_ptr, &stored_len);
    let session = AuthSession { json_ptr: STR_PTR(""), json_len: 0, authenticated: false, loginRequired: false, token_ptr: STR_PTR(""), token_len: 0, token_is_null: true, websocket_handshakeTimeoutMs: 8000, websocket_is_null: true, user_id_ptr: STR_PTR(""), user_id_len: 0, user_is_null: true };
    // const session = await withTimeout(fetchSessionToken(storedToken), 8_000, "Session check timeout");
    let rc = fetchSessionToken(stored_ptr, stored_len, 8000, &session);
    if rc != 0 {
        // outer catch: if (!mounted) return; currentToken checks; LoginRequiredError -> remove + loginRequired;
        // else if (currentToken) recheck = await withTimeout(fetchSessionToken(currentToken), 8_000, "Session recheck timeout").catch(() => null);
        //   recheck.authenticated === false -> remove + loginRequired; recheck?.token -> setAuthSession, legal -> disconnect + legalRequired, else dispatch token + sessionVerifiedForWorkbench = true
        // dispatch({ type: "error", message: formatErrorText(error) });
        // if (localStorage token && sessionVerifiedForWorkbench) setAuthStatus("authenticated") else setAuthStatus("loginRequired")
        // DEFECT: nested catch/recheck flow flattened; the recheck sequence must run in this order in the host implementation.
        if !input.mounted { return rc; };
        if rc == 1 { localStorage_removeItem(STR_PTR("AUTH_TOKEN_STORAGE_KEY"), STR_LEN("AUTH_TOKEN_STORAGE_KEY")); setAuthStatus(input, STR_PTR("loginRequired"), STR_LEN("loginRequired")); return 0; };
        dispatch_action(input, STR_PTR("{\"type\":\"error\"}"), STR_LEN("{\"type\":\"error\"}"));
        if has_stored && input.sessionVerifiedForWorkbench { setAuthStatus(input, STR_PTR("authenticated"), STR_LEN("authenticated")); } else { setAuthStatus(input, STR_PTR("loginRequired"), STR_LEN("loginRequired")); };
        return 0;
    };
    // if (!mounted || localStorage.getItem(KEY) !== storedToken) return;
    if !input.mounted { return 0; };
    if session.authenticated == false || session.loginRequired || session.token_is_null {
        localStorage_removeItem(STR_PTR("AUTH_TOKEN_STORAGE_KEY"), STR_LEN("AUTH_TOKEN_STORAGE_KEY"));
        setAuthStatus(input, STR_PTR("loginRequired"), STR_LEN("loginRequired"));
        return 0;
    };
    localStorage_setItem(STR_PTR("AUTH_TOKEN_STORAGE_KEY"), STR_LEN("AUTH_TOKEN_STORAGE_KEY"), session.token_ptr, session.token_len);
    // setAuthSession(session);
    if legalReviewRequired(&session) { setAuthStatus(input, STR_PTR("legalRequired"), STR_LEN("legalRequired")); return 0; };
    input.sessionVerifiedForWorkbench = true;
    setAuthStatus(input, STR_PTR("authenticated"), STR_LEN("authenticated"));
    dispatch_action(input, STR_PTR("{\"type\":\"token\"}"), STR_LEN("{\"type\":\"token\"}"));
    // try { await startCodexEngine(session.token); checkCodexCliUpdate(session.token); } catch { console.warn("[engine] startup failed; ...") }
    let rc_engine = startCodexEngine(session.token_ptr, session.token_len);
    if rc_engine == 0 { checkCodexCliUpdate(session.token_ptr, session.token_len); };
    // await withTimeout(client.connect(session.token, session.websocket), (session.websocket?.handshakeTimeoutMs ?? 8_000) + 1_000, "WebSocket connect timeout");
    let ws_timeout: u64 = session.websocket_handshakeTimeoutMs + 1000;
    let rc_ws = client_connect(session.token_ptr, session.token_len, ws_timeout);
    if rc_ws != 0 { return rc_ws; };
    // providers = await withTimeout(refreshProviders(session.token), 8_000, "Provider refresh timeout") — LoginRequiredError rethrown, others only warn and keep current list
    let providers_ptr: ptr = STR_PTR(""); let providers_len: u64 = 0;
    let rc_prov = refreshProviders(session.token_ptr, session.token_len, 8000, providers_ptr, &providers_len);
    if rc_prov == 1 { return rc_prov; };
    if !input.mounted { return 0; };
    // try { configResult = await withTimeout(client.rpc("config/read", { includeLayers: false }), 8_000, "Config read timeout"); if (mounted/token unchanged) applyLoadedCodexConfig(parseConfigReadResponse(configResult), providers); } catch { /* workbench can still load with engine defaults */ }
    let cfg_ptr: ptr = STR_PTR(""); let cfg_len: u64 = 0;
    let rc_cfg = client_rpc_configRead(8000, cfg_ptr, &cfg_len);
    if rc_cfg == 0 { applyLoadedCodexConfig(input, cfg_ptr, cfg_len); };
    // await loadBasics();
    return loadBasics();
}

fn useSessionBootstrap_cleanup(input: &UseSessionBootstrapInput) -> i32 { input.mounted = false; return 0; }

// DEFECT: async — completeLoginSession(session) in TS; inner best-effort IIFE flattened after the synchronous prologue.
fn completeLoginSession(input: &UseSessionBootstrapInput, session: &AuthSession) -> i32 {
    localStorage_setItem(STR_PTR("AUTH_TOKEN_STORAGE_KEY"), STR_LEN("AUTH_TOKEN_STORAGE_KEY"), session.token_ptr, session.token_len);
    // setAuthSession(session);
    if legalReviewRequired(session) {
        client_disconnect(input);
        dispatch_action(input, STR_PTR("{\"type\":\"connected\",\"connected\":false}"), STR_LEN("{\"type\":\"connected\",\"connected\":false}"));
        dispatch_action(input, STR_PTR("{\"type\":\"token\",\"token\":null}"), STR_LEN("{\"type\":\"token\",\"token\":null}"));
        setAuthStatus(input, STR_PTR("legalRequired"), STR_LEN("legalRequired"));
        return 0;
    };
    dispatch_action(input, STR_PTR("{\"type\":\"token\"}"), STR_LEN("{\"type\":\"token\"}"));
    // Mark authenticated immediately so UI enters the workbench even if the WebSocket or subsequent RPCs are slow/failing.
    setAuthStatus(input, STR_PTR("authenticated"), STR_LEN("authenticated"));
    // Best-effort post-login setup: never block the workbench.
    let rc_engine = startCodexEngine(session.token_ptr, session.token_len);
    if rc_engine == 0 { checkCodexCliUpdate(session.token_ptr, session.token_len); };
    let ws_timeout: u64 = session.websocket_handshakeTimeoutMs + 1000;
    let rc_ws = client_connect(session.token_ptr, session.token_len, ws_timeout); // failure only warns
    let providers_ptr: ptr = STR_PTR(""); let providers_len: u64 = 0;
    let rc_prov = refreshProviders(session.token_ptr, session.token_len, 8000, providers_ptr, &providers_len); // failure keeps state.providers
    let cfg_ptr: ptr = STR_PTR(""); let cfg_len: u64 = 0;
    let rc_cfg = client_rpc_configRead(8000, cfg_ptr, &cfg_len);
    if rc_cfg == 0 { applyLoadedCodexConfig(input, cfg_ptr, cfg_len); };
    return 0;
}

// DEFECT: async — acceptCurrentLegalPolicy(policy) in TS.
fn acceptCurrentLegalPolicy(input: &UseSessionBootstrapInput, policy_version_ptr: ptr, policy_version_len: u64, policy_language_ptr: ptr, policy_language_len: u64) -> i32 {
    if input.authSession_is_null || input.authSession.token_is_null || input.authSession.user_is_null {
        return handleSessionExpired(input);
    };
    // const legalConsent = await acceptLegalPolicy(session.token, policy.version, policy.language);
    // const nextSession = { ...session, legalConsent }; localStorage.setItem(`${LEGAL_ACCEPTANCE_STORAGE_PREFIX}.${session.user.id}`, JSON.stringify({ version, acceptedAt ?? Date.now(), language }))
    // DEFECT: object spread / template literal key / JSON.stringify approximated as JSON buffer operations by the host.
    // await completeLoginSession(nextSession);
    return completeLoginSession(input, &input.authSession);
}

fn leaveLegalReview(input: &UseSessionBootstrapInput) -> i32 {
