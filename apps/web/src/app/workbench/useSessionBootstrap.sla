fn refreshProviders(token_ptr: ptr, token_len: u64, timeout_ms: u64, out_json_ptr: ptr, out_json_len: &u64) -> i32 { return 0; }
fn recoverOrExpireSession() -> bool { return true; }
fn legalReviewRequired(session: &AuthSession) -> bool { return false; }
fn checkCodexCliUpdate(token_ptr: ptr, token_len: u64) -> i32 { return 0; }
