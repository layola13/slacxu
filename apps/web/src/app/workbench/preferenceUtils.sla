fn str_eq(a_ptr: ptr, a_len: u64, b_ptr: ptr, b_len: u64) -> bool {
    // REBOUND (2026-10-26, sa_std ts sweep): hand byte-scan replaced by
    // sa_std/ts_string.sa @ts_str_equals; original signature preserved 1:1.
    return @ts_str_equals(a_ptr, a_len, b_ptr, b_len);
}

fn buf_set(out: &StrBuf, lit_ptr: ptr, lit_len: u64) -> i32 {
    for i in 0..lit_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, lit_ptr, i);
        out.bytes[i] = b;
    }
    out.len = lit_len;
    return 0;
}

// Lowercase-copy of a (ptr,len) string into out (for .trim().toLowerCase()
// chains; trim approximated by caller passing the trimmed range — here the
// whole buffer is lowercased and surrounding spaces stripped).
fn lower_trimmed(value_ptr: ptr, value_len: u64, out: &StrBuf) -> i32 {
    let start: u64 = 0;
    let end = value_len;
    while start < end {
        let b: u8 = 0;
        PTR_BYTE_AT(b, value_ptr, start);
        if b == 32 || b == 9 || b == 10 || b == 13 {
            start = start + 1;
        } else {
            start = end;
        };
    }
    while end > start {
        let b2: u8 = 0;
        PTR_BYTE_AT(b2, value_ptr, end - 1);
        if b2 == 32 || b2 == 9 || b2 == 10 || b2 == 13 {
            end = end - 1;
        } else {
            end = start;
        };
    }
    let n = end - start;
    for i in 0..n {
        let b3: u8 = 0;
        PTR_BYTE_AT(b3, value_ptr, start + i);
        if b3 >= 65 && b3 <= 90 {
            b3 = b3 + 32;
        };
        out.bytes[i] = b3;
    }
    out.len = n;
    return 0;
}

// ---- preferenceUtils.ts:13-31 — parseNewChatPermission ----
// Status 0 = preset written to out; 1 = undefined.
fn parseNewChatPermission(value_ptr: ptr, value_len: u64, out: &StrBuf) -> i32 {
    let normalized = StrBuf { bytes: [0u8; 1024], len: 0 };
    lower_trimmed(value_ptr, value_len, &normalized);
    if normalized.len == 0 {
        return 1;
    };
    // ["read","readonly","read-only","safe"] -> "readonlyAsk"
    if str_eq(&normalized.bytes, normalized.len, STR_PTR("read"), STR_LEN("read")) || str_eq(&normalized.bytes, normalized.len, STR_PTR("readonly"), STR_LEN("readonly")) || str_eq(&normalized.bytes, normalized.len, STR_PTR("read-only"), STR_LEN("read-only")) || str_eq(&normalized.bytes, normalized.len, STR_PTR("safe"), STR_LEN("safe")) {
        buf_set(out, STR_PTR("readonlyAsk"), STR_LEN("readonlyAsk"));
        return 0;
    };
    // ["workspace","default","ask"] -> "workspaceAsk"
    if str_eq(&normalized.bytes, normalized.len, STR_PTR("workspace"), STR_LEN("workspace")) || str_eq(&normalized.bytes, normalized.len, STR_PTR("default"), STR_LEN("default")) || str_eq(&normalized.bytes, normalized.len, STR_PTR("ask"), STR_LEN("ask")) {
        buf_set(out, STR_PTR("workspaceAsk"), STR_LEN("workspaceAsk"));
        return 0;
    };
    // ["full","full-access","fullask"] -> "fullAsk"
    if str_eq(&normalized.bytes, normalized.len, STR_PTR("full"), STR_LEN("full")) || str_eq(&normalized.bytes, normalized.len, STR_PTR("full-access"), STR_LEN("full-access")) || str_eq(&normalized.bytes, normalized.len, STR_PTR("fullask"), STR_LEN("fullask")) {
        buf_set(out, STR_PTR("fullAsk"), STR_LEN("fullAsk"));
        return 0;
    };
    // ["danger","bypass","full-auto","danger-bypass"] -> "dangerBypass"
    if str_eq(&normalized.bytes, normalized.len, STR_PTR("danger"), STR_LEN("danger")) || str_eq(&normalized.bytes, normalized.len, STR_PTR("bypass"), STR_LEN("bypass")) || str_eq(&normalized.bytes, normalized.len, STR_PTR("full-auto"), STR_LEN("full-auto")) || str_eq(&normalized.bytes, normalized.len, STR_PTR("danger-bypass"), STR_LEN("danger-bypass")) {
        buf_set(out, STR_PTR("dangerBypass"), STR_LEN("dangerBypass"));
        return 0;
    };
    return 1;
}

// ---- preferenceUtils.ts:33-48 — readHistoryDateRange / parseHistoryDateRange ----
struct HistoryDateRangeFilter {
    from: [u8; 16], from_len: u64,              // string "YYYY-MM-DD" or ""
    to: [u8; 16], to_len: u64,
}

// /^\d{4}-\d{2}-\d{2}$/ — DEFECT: regex approximated by digit/dash checks.
fn is_date_str(p: ptr, n: u64) -> bool {
    if n != 10 {
        return false;
    };
    for i in 0..10 {
        let b: u8 = 0;
        PTR_BYTE_AT(b, p, i);
        if i == 4 || i == 7 {
            if b != 45 {
                return false;
            };
        } else {
            if b < 48 || b > 57 {
                return false;
            };
        };
    }
    return true;
}

// preferenceRecord(value) is defined below (source order at lines 137-139);
