    if str_eq(&value.bytes, value.len, STR_PTR("full"), STR_LEN("full")) || str_eq(&value.bytes, value.len, STR_PTR("post-compaction"), STR_LEN("post-compaction")) || str_eq(&value.bytes, value.len, STR_PTR("recent-tools"), STR_LEN("recent-tools")) {
        *out = value;
        return 0;
    };
    buf_set(out, STR_PTR("recent-tools"), STR_LEN("recent-tools"));
    return 0;
}

