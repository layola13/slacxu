    sa_local_storage_remove_item(STR_PTR("codex-ultra.custom-theme-plugins"), STR_LEN("codex-ultra.custom-theme-plugins"));
    sa_local_storage_remove_item(STR_PTR("codex-ultra.locale"), STR_LEN("codex-ultra.locale"));
    sa_local_storage_remove_item(STR_PTR("codex-ultra.history-view"), STR_LEN("codex-ultra.history-view"));
    // for (key of [...currentKeys, ...currentKeys.map(k => k.replace(/^codex-ultra\./, "codex-react-ui."))]) localStorage.removeItem(key);
    // DEFECT: regex replace + spread iteration deferred.
    // Backward scan removing providers-cache keys:
    // for (let index = localStorage.length - 1; index >= 0; index -= 1) { key = localStorage.key(index); if prefix match removeItem }
    let total = sa_local_storage_length();
    let index = total;
    while index > 0 {
        index = index - 1;
        let key = StrBuf { bytes: [0u8; 1024], len: 0 };
        sa_local_storage_key(index, &key);
        // key?.startsWith("codex-ultra.providers-cache.") || startsWith("codex-react-ui.providers-cache.")
        // DEFECT: prefix check deferred (key extraction is a placeholder).
    }
    return 0;
}

