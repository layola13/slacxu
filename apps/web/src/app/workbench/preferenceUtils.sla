// ---- preferenceUtils.ts:137-139 — preferenceRecord ----
// value && typeof value === "object" && !Array.isArray(value) -> the record
// itself (as JSON text), else null (status 1). DEFECT: JSON kind check
// approximated by first non-space byte === '{'.
fn preferenceRecord(value_json_ptr: ptr, value_json_len: u64, out_json: &JsonBuf) -> i32 {
    let i: u64 = 0;
    while i < value_json_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, value_json_ptr, i);
        if b == 32 || b == 9 || b == 10 || b == 13 {
            i = i + 1;
        } else {
            if b == 123 {
                for j in 0..value_json_len {
                    let c: u8 = 0;
                    PTR_BYTE_AT(c, value_json_ptr, j);
                    out_json.bytes[j] = c;
                }
                out_json.len = value_json_len;
                return 0;
            };
            return 1;
        };
    }
    return 1;
}

