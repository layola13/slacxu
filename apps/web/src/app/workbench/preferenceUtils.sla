    // const record = preferenceRecord(value); if (!record) return null;
    // from/to: string matching the date regex kept, else "".
    // DEFECT: JSON field extraction deferred; returns the empty range shape.
    out.from_len = 0;
    out.to_len = 0;
    return 0; // 0 = filter returned, 1 = null (record check deferred)
}

fn readHistoryDateRange(out: &HistoryDateRangeFilter) -> i32 {
    // try { return parseHistoryDateRange(JSON.parse(localStorage.getItem(UI_STORAGE_KEYS.historyDateRange) ?? "{}")) ?? { from: "", to: "" }; }
    // catch { return { from: "", to: "" }; }
    // DEFECT: try/catch approximated by status branches.
    let raw = StrBuf { bytes: [0u8; 1024], len: 0 };
    let found = sa_local_storage_get(STR_PTR("codex-ultra.history-date-range"), STR_LEN("codex-ultra.history-date-range"), &raw);
    if found == 0 {
        buf_set(&StrBuf { bytes: raw.bytes, len: 0 }, STR_PTR("{}"), STR_LEN("{}"));
    };
    let st = parseHistoryDateRange(&raw.bytes, raw.len, out);
    if st != 0 {
        out.from_len = 0;
        out.to_len = 0;
    };
    return 0;
}

// ---- preferenceUtils.ts:50-60 — readStoredBoolean ----
fn readStoredBoolean(key_ptr: ptr, key_len: u64, fallback: bool) -> bool {
    let raw = StrBuf { bytes: [0u8; 1024], len: 0 };
    let found = sa_local_storage_get(key_ptr, key_len, &raw);
    if found == 0 {
        return fallback; // raw == null
    };
    // try { return Boolean(JSON.parse(raw)); } catch { return fallback; }
    // DEFECT: JSON.parse + Boolean() coercion approximated: literal "true" /
    // nonzero number text counts as true.
    if raw.len == 4 && str_eq(&raw.bytes, raw.len, STR_PTR("true"), STR_LEN("true")) {
        return true;
    };
    if raw.len == 5 && str_eq(&raw.bytes, raw.len, STR_PTR("false"), STR_LEN("false")) {
        return false;
    };
    return fallback;
}

