struct UseMembersAdminInput {
    token_ptr: ptr, token_len: u64, token_is_null: bool,
    authSession_json_ptr: ptr, authSession_json_len: u64, authSession_is_null: bool,
    authSession_user_role_ptr: ptr, authSession_user_role_len: u64,
    authSession_user_id_ptr: ptr, authSession_user_id_len: u64,
}

struct UseMembersAdmin {
    members_json_ptr: ptr, members_json_len: u64,
    membersLoading: bool,
    membersError_ptr: ptr, membersError_len: u64, membersError_is_null: bool,
}

struct CreateMemberInput {
    email_ptr: ptr, email_len: u64,
    password_ptr: ptr, password_len: u64,
    username_ptr: ptr, username_len: u64, username_is_null: bool,
    role_ptr: ptr, role_len: u64, role_is_null: bool,
    maxPermission_ptr: ptr, maxPermission_len: u64, maxPermission_is_null: bool,
    allowWrite: bool, allowNetwork: bool, allowDangerBypass: bool,
    balance: f64, balance_is_null: bool,
    concurrency: u64, concurrency_is_null: bool,
    notes_ptr: ptr, notes_len: u64, notes_is_null: bool,
    allowedProviderIds_json_ptr: ptr, allowedProviderIds_json_len: u64,
}

// codexClient API stubs (defined in codexClient.sla) — DEFECT: async/Promise in TS.
fn listMembers(token_ptr: ptr, token_len: u64, out_json_ptr: ptr, out_json_len: &u64) -> i32 { return 0; }
fn createMember(token_ptr: ptr, token_len: u64, input: &CreateMemberInput) -> i32 { return 0; }
fn updateMember(token_ptr: ptr, token_len: u64, id_ptr: ptr, id_len: u64, input_json_ptr: ptr, input_json_len: u64) -> i32 { return 0; }
fn deleteMember(token_ptr: ptr, token_len: u64, id_ptr: ptr, id_len: u64) -> i32 { return 0; }
fn allocateMemberBalance(token_ptr: ptr, token_len: u64, id_ptr: ptr, id_len: u64, amount: f64, operation_ptr: ptr, operation_len: u64, notes_ptr: ptr, notes_len: u64) -> i32 { return 0; }
fn fetchSessionToken(token_ptr: ptr, token_len: u64, out_json_ptr: ptr, out_json_len: &u64) -> i32 { return 0; }
fn formatErrorText(rc: i32, out_ptr: ptr, out_len: &u64) -> i32 { return 0; }

// DEFECT: async — reloadMembers(): Promise<void> in TS.
fn reloadMembers(input: &UseMembersAdminInput, s: &UseMembersAdmin) -> i32 {
    if input.token_is_null || !(input.authSession_user_role_len == 5) { // role !== "admin" (length approximation)
        s.members_json_ptr = STR_PTR("[]"); s.members_json_len = 2;
        return 0;
    };
    s.membersLoading = true;
    s.membersError_is_null = true;
    let rc = listMembers(input.token_ptr, input.token_len, s.members_json_ptr, &s.members_json_len);
    if rc != 0 {
        formatErrorText(rc, s.membersError_ptr, &s.membersError_len);
        s.membersError_is_null = false;
    };
    s.membersLoading = false; // finally
    return rc;
}

// DEFECT: async — handleCreateMember throws Error("Not authenticated") in TS; status code 1 used.
fn handleCreateMember(input: &UseMembersAdminInput, s: &UseMembersAdmin, member: &CreateMemberInput) -> i32 {
    if input.token_is_null { return 1; };
    let rc = createMember(input.token_ptr, input.token_len, member);
    if rc != 0 { return rc; };
    return reloadMembers(input, s);
}

// DEFECT: async
fn handleUpdateMember(input: &UseMembersAdminInput, s: &UseMembersAdmin, id_ptr: ptr, id_len: u64, input_json_ptr: ptr, input_json_len: u64) -> i32 {
    if input.token_is_null { return 1; };
    let rc = updateMember(input.token_ptr, input.token_len, id_ptr, id_len, input_json_ptr, input_json_len);
    if rc != 0 { return rc; };
    return reloadMembers(input, s);
}

// DEFECT: async
fn handleDeleteMember(input: &UseMembersAdminInput, s: &UseMembersAdmin, id_ptr: ptr, id_len: u64) -> i32 {
    if input.token_is_null { return 1; };
    let rc = deleteMember(input.token_ptr, input.token_len, id_ptr, id_len);
    if rc != 0 { return rc; };
    return reloadMembers(input, s);
}

// DEFECT: async — operation default "add" preserved as caller-supplied value.
fn handleAllocateMemberBalance(input: &UseMembersAdminInput, s: &UseMembersAdmin, id_ptr: ptr, id_len: u64, amount: f64, operation_ptr: ptr, operation_len: u64, notes_ptr: ptr, notes_len: u64) -> i32 {
    if input.token_is_null { return 1; };
    let rc = allocateMemberBalance(input.token_ptr, input.token_len, id_ptr, id_len, amount, operation_ptr, operation_len, notes_ptr, notes_len);
    if rc != 0 { return rc; };
    rc = reloadMembers(input, s);
    // refresh self session balance if admin topped up themselves
    if input.authSession_user_id_len == id_len {
        let out_ptr: ptr = STR_PTR(""); let out_len: u64 = 0;
        let rc2 = fetchSessionToken(input.token_ptr, input.token_len, out_ptr, &out_len);
        if rc2 == 0 { /* setAuthSession(me) — errors ignored in TS (catch { /* ignore */ }) */ };
    };
    return rc;
}

fn useMembersAdmin(input: &UseMembersAdminInput) -> UseMembersAdmin {
    let s = UseMembersAdmin { members_json_ptr: STR_PTR("[]"), members_json_len: 2, membersLoading: false, membersError_ptr: STR_PTR(""), membersError_len: 0, membersError_is_null: true };
    return s; // returns also reloadMembers / handle* family above
}
