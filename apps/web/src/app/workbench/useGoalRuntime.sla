// ---- useGoalRuntime.ts:50-63 — hook input ----
// DEFECT: ReturnType<typeof useAccessRuntime> etc. (inferred return types of
// sibling hooks) — the four runtime bundles are opaque handles here; the
// fields destructured from them in the source (lines 66-292) are enumerated
// in the defect log and accessed through the sibling units' state structs.
struct UseGoalRuntimeInput {
    state: u64,                                 // ClientState — opaque handle (activeThreadId, threads, providers, models, token read via it)
    dispatch: u64,                              // Dispatch<appReducer action> — handler handle
    themeMode: [u8; 32], themeMode_len: u64,
    customThemePlugins_json: JsonBuf,
    onThemeModeChange: u64,
    onCustomThemePluginsChange: u64,
    detachedThreadId: [u8; 128], detachedThreadId_len: u64, has_detachedThreadId: bool, // string | null
    access: u64,                                // ReturnType<typeof useAccessRuntime> — opaque handle
    taskTabs: u64,                              // ReturnType<typeof useTaskTabsRuntime> — opaque handle
    threadWorkspace: u64,                       // ReturnType<typeof useThreadWorkspaceRuntime> — opaque handle
    selection: u64,                             // ReturnType<typeof useSelectionRuntime> — opaque handle
}

