fn applyWorkspaceVmPolicyForCwd(input: &UseNewSessionFlowInput, targetPath_ptr: ptr, targetPath_len: u64) -> i32 {
    if targetPath_len == 0 { return 0; };
    if input.workspaceMode_len == 3 { return 0; }; // workspaceMode === "ssh"
    let saved_ptr: ptr = STR_PTR(""); let saved_len: u64 = 0;
    if loadWorkspaceVmPolicy(targetPath_ptr, targetPath_len, saved_ptr, &saved_len) {
        // updateNewConversationRuntimeSelection({ vmEnabled: saved.vmEnabled, vmPolicy: saved.vmPolicy }); updateRuntimeSelection(same)
        updateNewConversationRuntimeSelection(input, saved_ptr, saved_len);
        updateRuntimeSelection(input, saved_ptr, saved_len);
        return 0;
    };
    if !input.token_is_null {
        // void fetchWorkspaceSaVmStatus(state.token, targetPath).then(status => { if (status.hasSkill) { const policy = createSaVmPolicyWithIdeTools(); saveWorkspaceVmPolicy(...); update...(vmEnabled: true) } }).catch(() => {});
        // DEFECT: Promise .then/.catch chain flattened to a sequential call; errors ignored as in source catch.
        let hasSkill = false;
        let rc = fetchWorkspaceSaVmStatus(input.token_ptr, input.token_len, targetPath_ptr, targetPath_len, &hasSkill);
        if rc == 0 && hasSkill {
            let policy_ptr: ptr = STR_PTR(""); let policy_len: u64 = 0;
            createSaVmPolicyWithIdeTools(policy_ptr, &policy_len);
            saveWorkspaceVmPolicy(targetPath_ptr, targetPath_len, true, policy_ptr, policy_len);
            updateNewConversationRuntimeSelection(input, policy_ptr, policy_len);
            updateRuntimeSelection(input, policy_ptr, policy_len);
        };
    };
    return 0;
}

fn handleSelectRecentWorkspace(input: &UseNewSessionFlowInput, item_mode_ptr: ptr, item_mode_len: u64, item_path_ptr: ptr, item_path_len: u64, item_ssh_ptr: ptr, item_ssh_len: u64) -> i32 {
    if item_mode_len == 3 { // item.mode === "ssh"
        // setWorkspaceMode("ssh"); setSshCwd(item.path); setWorkspacePickerPath(item.path); if (item.sshCommand) setSshCommand(item.sshCommand);
        return 0;
    };
    // Stored memories may predate the absolute-path default; resolveTildeWorkspacePath(item.path, localWorkspaceInfo?.home, workspaceHostPlatform)
    // DEFECT: optional chaining ?. has no SLA counterpart; explicit null check used.
    // setWorkspaceMode("local"); setCwd(resolved); setWorkspacePickerPath(resolved);
    return applyWorkspaceVmPolicyForCwd(input, item_path_ptr, item_path_len);
}

