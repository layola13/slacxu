@import "sa_std/io/print.sai"

// DEFECT: React hooks (useCallback) have no SLA counterpart; callbacks modelled as plain functions taking an explicit input struct (ComposerCoreInput & extras flattened into JSON buffers + named fields).
// DEFECT: async functions converted to synchronous functions returning a status code / bool.
// DEFECT: dynamic objects / runtime-selection patches approximated as JSON text buffers.
// DEFECT: closures capturing hook state (beginNewSession/requestNewSession share the opencode/backend-init computation twice in the source; preserved twice here, not deduplicated — 1:1).
// DEFECT: string union literals for cliBackend ("grok"|"agy"|"claude"|"pi"|"opencode"|"opencode-v2"|"codex"|"mini") approximated as (ptr,len).
// DEFECT: fetch() / Response.json() (browser fetch API) has no sa_std counterpart; modelled as an extern stub.

struct UseNewSessionFlowInput {
    state_json_ptr: ptr, state_json_len: u64,
    token_ptr: ptr, token_len: u64, token_is_null: bool,
    providers_json_ptr: ptr, providers_json_len: u64,
    dispatch_handle: u64, client_handle: u64, t_handle: u64,
    workspaceMode_ptr: ptr, workspaceMode_len: u64,
    cwd_ptr: ptr, cwd_len: u64,
    sshCommand_ptr: ptr, sshCommand_len: u64,
    sshCwd_ptr: ptr, sshCwd_len: u64,
    additionalRoots_json_ptr: ptr, additionalRoots_json_len: u64,
    workspaceFilePath_ptr: ptr, workspaceFilePath_len: u64, workspaceFilePath_is_null: bool,
    runtimeSelection_json_ptr: ptr, runtimeSelection_json_len: u64,
    runtime_cliBackend_ptr: ptr, runtime_cliBackend_len: u64,
    runtime_providerId_ptr: ptr, runtime_providerId_len: u64, runtime_providerId_is_null: bool,
    runtime_groupId_ptr: ptr, runtime_groupId_len: u64, runtime_groupId_is_null: bool,
    runtime_model_ptr: ptr, runtime_model_len: u64,
    historyBackendFilter_ptr: ptr, historyBackendFilter_len: u64,
    historyBackendFilterUserTouchedRef: bool,
    dangerBypassPermissionConfirmed: bool,
    dangerDialogIntent_source_ptr: ptr, dangerDialogIntent_source_len: u64, dangerDialogIntent_is_null: bool,
    dangerDialogIntent_nextPermission_ptr: ptr, dangerDialogIntent_nextPermission_len: u64,
    newChatBudgetLimit_ptr: ptr, newChatBudgetLimit_len: u64,
    localWorkspaceInfo_home_ptr: ptr, localWorkspaceInfo_home_len: u64, localWorkspaceInfo_is_null: bool,
    workspaceHostPlatform_ptr: ptr, workspaceHostPlatform_len: u64,
    selectedModelRef_ptr: ptr, selectedModelRef_len: u64,
    activeThreadIdRef_ptr: ptr, activeThreadIdRef_len: u64, activeThreadIdRef_is_null: bool,
    freebuffSession_json_ptr: ptr, freebuffSession_json_len: u64, freebuffSession_is_null: bool,
}

