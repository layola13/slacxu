// Shared backend-init computation used verbatim by both beginNewSession and requestNewSession in the source.
// DEFECT: nested ternary chain + object literal with optional fields approximated as JSON text buffer output.
fn backendInitForNewSession(input: &UseNewSessionFlowInput, out_json_ptr: ptr, out_json_len: &u64) -> i32 {
    // targetBackend = (historyBackendFilterUserTouchedRef.current && historyBackendFilter !== "mini") ? historyBackendFilter : (runtimeSelection.cliBackend ?? DEFAULT_CLI_BACKEND)
    // opencodeProvider = state.providers.find(p => p.id === "opencode-local"); opencodeDefaultModel / opencodeGroupModel(groupId) derived from its groups' models (first model !== "default", fallback "opencode/big-pickle")
    // DEFECT: Array.find with closure predicates over dynamic ProviderConfig JSON has no SLA counterpart; host resolves these strings.
    // isAgyRelay = currentProviderId set, not one of agy-official/grok-official/pi-relay/opencode-local, and present in state.providers
    // backendInit = grok -> { cliBackend: "grok", providerId: "grok-official", groupId: null, model: "grok-4.6" }
    //   agy -> relay ? { cliBackend: "agy", providerId: currentProviderId, groupId: currentGroupId ?? null, model: currentModel || "gemini-3.8-flash-high" } : { ... providerId: "agy-official", groupId: null, model: "gemini-3.8-flash-high" }
    //   claude -> { cliBackend: "claude" }; pi -> { cliBackend: "pi" }
    //   opencode -> { cliBackend: "opencode", providerId: "opencode-local", groupId: "v1", model: opencodeGroupModel("v1") }
    //   opencode-v2 -> { cliBackend: "opencode-v2", providerId: "opencode-local", groupId: "v2", model: opencodeGroupModel("v2") }
    //   codex -> { cliBackend: "codex" }
    //   else -> { cliBackend: "mini", providerId: currentProviderId ?? null, groupId: currentGroupId ?? null, model: currentModel || "" }
    return 0;
}

fn beginNewSession(input: &UseNewSessionFlowInput, nextPermission_ptr: ptr, nextPermission_len: u64, epochs_inout: &u64) -> i32 {
    *epochs_inout = *epochs_inout + 2; // threadSelectionEpochRef.current += 1; splitMutationEpochRef.current += 1;
    // setWorkspaceLayout(null); setSplitView(null); activeThreadIdRef.current = null;
    // const targetCwd = workspaceMode === "ssh" ? sshCwd : cwd; const savedVm = workspaceMode === "local" && targetCwd ? loadWorkspaceVmPolicy(targetCwd) : null;
    let saved_ptr: ptr = STR_PTR(""); let saved_len: u64 = 0;
    let has_saved = false;
    if input.workspaceMode_len == 5 { has_saved = loadWorkspaceVmPolicy(input.cwd_ptr, input.cwd_len, saved_ptr, &saved_len); };
    let init_ptr: ptr = STR_PTR(""); let init_len: u64 = 0;
    backendInitForNewSession(input, init_ptr, &init_len);
    // updateNewConversationRuntimeSelection({ permission: nextPermission, dangerBypassConfirmed: nextPermission === "dangerBypass", vmEnabled: savedVm ? ... : false, vmPolicy: ..., ...backendInit });
    // setDangerBypassConfirmed(nextPermission === "dangerBypass"); setWorkspaceFilePath(null); setWorkspacePickerPath(...); setWorkspaceSelectionPending(true); setNewChatSetupOpen(true); setNewChatBudgetLimit(""); newChatDefaultsAppliedRef.current = false; setWelcomeDismissed(false); dispatch({ type: "newConversation" });
    dispatch_action(input, STR_PTR("{\"type\":\"newConversation\"}"), STR_LEN("{\"type\":\"newConversation\"}"));
    if !has_saved && input.workspaceMode_len == 5 {
        return applyWorkspaceVmPolicyForCwd(input, input.cwd_ptr, input.cwd_len);
    };
    return 0;
}

fn requestNewSession(input: &UseNewSessionFlowInput, nextPermission_ptr: ptr, nextPermission_len: u64, epochs_inout: &u64) -> i32 {
    if nextPermission_len == 12 { // "dangerBypass"
        *epochs_inout = *epochs_inout + 2;
        // setWorkspaceLayout(null); setSplitView(null); activeThreadIdRef.current = null; setWorkspaceFilePath(null); setWorkspacePickerPath(...); setWorkspaceSelectionPending(true); setNewChatSetupOpen(true); setNewChatBudgetLimit(""); newChatDefaultsAppliedRef.current = false;
        // (targetCwd / savedVm / backendInit computation duplicated verbatim in the source — see backendInitForNewSession)
        let init_ptr: ptr = STR_PTR(""); let init_len: u64 = 0;
        backendInitForNewSession(input, init_ptr, &init_len);
        // updateNewConversationRuntimeSelection({ permission: nextPermission, dangerBypassConfirmed: false, vmEnabled..., vmPolicy..., ...backendInit });
        // setWelcomeDismissed(false); dispatch({ type: "newConversation" }); setDangerDialogIntent({ source: "new-chat", nextPermission }); setDangerDialogAcknowledged(false);
        dispatch_action(input, STR_PTR("{\"type\":\"newConversation\"}"), STR_LEN("{\"type\":\"newConversation\"}"));
        // if (!savedVm && workspaceMode === "local" && targetCwd) applyWorkspaceVmPolicyForCwd(targetCwd);
        return 0;
    };
    return beginNewSession(input, nextPermission_ptr, nextPermission_len, epochs_inout);
}

fn persistWorkspaceForActiveThread(input: &UseNewSessionFlowInput, nextCwd_ptr: ptr, nextCwd_len: u64, nextRoots_json_ptr: ptr, nextRoots_json_len: u64, nextFilePath_ptr: ptr, nextFilePath_len: u64, nextFilePath_given: bool) -> i32 {
    // const normalizedRoots = normalizeWorkspaceRoots(nextCwd, nextRoots);
    // const requestedFilePath = nextWorkspaceFilePath === undefined ? workspaceFilePath : nextWorkspaceFilePath;
    // DEFECT: undefined-vs-null distinction has no SLA counterpart; nextFilePath_given flag used.
    // const filePath = workspaceMode === "local" || requestedFilePath ? requestedFilePath || joinWorkspacePath(nextCwd, "cxu.code-workspace") : null; setWorkspaceFilePath(filePath);
    // if (filePath && state.token) void writeCodeWorkspaceFile(...).catch(error => dispatch error "Workspace file save");
    // const threadId = activeThreadIdRef.current; if (!threadId || !state.token) return;
    // void updateThreadWorkspaceMetadata(state.token, { threadId, cwd: nextCwd, additionalRoots: normalizedRoots, workspaceFilePath: filePath ?? "" }).catch(... "Workspace save");
    if input.activeThreadIdRef_is_null || input.token_is_null { return 0; };
    return updateThreadWorkspaceMetadata(input.token_ptr, input.token_len, nextCwd_ptr, nextCwd_len);
}

fn requestPermissionChange(input: &UseNewSessionFlowInput, nextPermission_ptr: ptr, nextPermission_len: u64) -> i32 {
    if nextPermission_len == 12 && !input.dangerBypassPermissionConfirmed { // "dangerBypass"
        // const source = activeThreadIdRef.current ? "permission" : "new-chat";
        // if new-chat: setWorkspacePickerPath(...); setWorkspaceSelectionPending(true); setNewChatSetupOpen(false); updateNewConversationRuntimeSelection({ permission: nextPermission, dangerBypassConfirmed: false });
        // setDangerDialogIntent({ source, nextPermission }); setDangerDialogAcknowledged(false); return;
        return 0;
    };
    setRuntimePermission(input, nextPermission_ptr, nextPermission_len, nextPermission_len == 12);
    persistPermissionForActiveThread(input, nextPermission_ptr, nextPermission_len);
    if input.activeThreadIdRef_is_null {
        // setWorkspacePickerPath(...); setWorkspaceSelectionPending(true); setNewChatSetupOpen(true);
    };
    // if (nextPermission !== "dangerBypass") setDangerBypassConfirmed(false);
    return 0;
}

// DEFECT: async — ensureWorkspaceAgents(modeOverride?): Promise<boolean> in TS; fetch() based.
fn ensureWorkspaceAgents(input: &UseNewSessionFlowInput, mode_ptr: ptr, mode_len: u64, mode_given: bool) -> bool {
    if input.token_is_null {
        dispatch_action(input, STR_PTR("{\"type\":\"error\",\"message\":\"Missing session token\"}"), STR_LEN("{\"type\":\"error\",\"message\":\"Missing session token\"}"));
        return false;
    };
    // setWorkspaceAgentsBusy(true); try { response = await fetch(ssh ? "/api/ssh/ensure-agents" : "/api/workspace/ensure-agents", { method: "POST", headers: {..., "x-codex-ui-token": state.token}, body: JSON.stringify(...) }); body = await response.json().catch(() => ({})); if (!response.ok) throw new Error(stringValue(asRecord(body).error) ?? `AGENTS.md update failed: ${response.status}`); return true; } catch { dispatch error; return false; } finally { setWorkspaceAgentsBusy(false); }
    let status: u64 = 0; let body_ptr: ptr = STR_PTR(""); let body_len: u64 = 0;
    let is_ssh = mode_given && mode_len == 3;
    let url_ptr: ptr = STR_PTR("/api/workspace/ensure-agents"); let url_len: u64 = STR_LEN("/api/workspace/ensure-agents");
    if is_ssh { url_ptr = STR_PTR("/api/ssh/ensure-agents"); url_len = STR_LEN("/api/ssh/ensure-agents"); };
    let rc = fetch_http(STR_PTR("POST"), STR_LEN("POST"), url_ptr, url_len, input.token_ptr, input.token_len, input.cwd_ptr, input.cwd_len, &status, body_ptr, &body_len);
    if rc != 0 || status < 200 || status >= 300 {
        dispatch_action(input, STR_PTR("{\"type\":\"error\"}"), STR_LEN("{\"type\":\"error\"}"));
        return false;
    };
    return true;
}

// DEFECT: async — applyWorkspaceSelectionFromDialog(modeOverride?): Promise<boolean> in TS.
fn applyWorkspaceSelectionFromDialog(input: &UseNewSessionFlowInput, mode_ptr: ptr, mode_len: u64, mode_given: bool) -> bool {
    // const trimmedBudget = newChatBudgetLimit.trim(); if (trimmedBudget && (!(Number(trimmedBudget) >= 0) || !Number.isFinite(Number(trimmedBudget)))) { dispatch({ type: "error", message: t("newChat.invalidBudget") }); return false; }
    // DEFECT: Number()/Number.isFinite string parsing approximated by host helper; budget validation branch preserved as a guard call.
    let is_ssh = mode_given && mode_len == 3 || (!mode_given && input.workspaceMode_len == 3);
    if is_ssh {
        // const normalizedRemoteCwd = normalizeSshWorkspaceCwd(sshCwd); if (!normalizedRemoteCwd || !isSshWorkspaceCommand(sshCommand)) { dispatch t("workspace.required"); return false; }
        // setSshCommand(sshCommand.trim()); setSshCwd(normalizedRemoteCwd); setWorkspaceMode("ssh"); recordRecentWorkspace(normalizedRemoteCwd, "ssh", sshCommand);
        recordRecentWorkspace(input.sshCwd_ptr, input.sshCwd_len, STR_PTR("ssh"), STR_LEN("ssh"), input.sshCommand_ptr, input.sshCommand_len);
        if !ensureWorkspaceAgents(input, mode_ptr, mode_len, mode_given) { return false; };
        // setWorkspaceSelectionPending(false); setNewChatSetupOpen(false);
        return true;
    };
    // const normalized = resolveTildeWorkspacePath(normalizeWorkspaceCwd(cwd), localWorkspaceInfo?.home, workspaceHostPlatform); if (!normalized) { dispatch t("workspace.required"); return false; }
    if input.cwd_len == 0 { dispatch_action(input, STR_PTR("{\"type\":\"error\"}"), STR_LEN("{\"type\":\"error\"}")); return false; };
    // setCwd(normalized); setWorkspaceMode("local"); recordRecentWorkspace(normalized, "local"); applyWorkspaceVmPolicyForCwd(normalized);
    recordRecentWorkspace(input.cwd_ptr, input.cwd_len, STR_PTR("local"), STR_LEN("local"), STR_PTR(""), 0);
    applyWorkspaceVmPolicyForCwd(input, input.cwd_ptr, input.cwd_len);
    // if (effectiveWorkspaceMode === "local") { nextWorkspaceFilePath = workspaceFilePath || joinWorkspacePath(normalized, "cxu.code-workspace"); setWorkspaceFilePath(...); if (state.token) { try { await writeCodeWorkspaceFile(...) } catch { dispatch errorMessage(t("workspace.openFile")); return false; } } }
    if !input.token_is_null {
        let rc = writeCodeWorkspaceFile(input.token_ptr, input.token_len, input.cwd_ptr, input.cwd_len);
        if rc != 0 { dispatch_action(input, STR_PTR("{\"type\":\"error\"}"), STR_LEN("{\"type\":\"error\"}")); return false; };
    };
    if !ensureWorkspaceAgents(input, mode_ptr, mode_len, mode_given) { return false; };
    // setWorkspaceSelectionPending(false); setNewChatSetupOpen(false);
    return true;
}

// DEFECT: async
fn confirmWorkspaceSelection(input: &UseNewSessionFlowInput, mode_ptr: ptr, mode_len: u64, mode_given: bool) -> bool {
    if !verifySshWorkspaceBeforeCreate(input, mode_ptr, mode_len) { return false; };
    return applyWorkspaceSelectionFromDialog(input, mode_ptr, mode_len, mode_given);
}

fn closeDangerDialog(input: &UseNewSessionFlowInput) -> i32 {
    // if (dangerDialogIntent?.source === "new-chat") setNewChatSetupOpen(false);
    // setDangerDialogIntent(null); setDangerDialogAcknowledged(false);
    return 0;
}

// DEFECT: async
fn confirmDangerDialog(input: &UseNewSessionFlowInput, epochs_inout: &u64) -> i32 {
    if input.dangerDialogIntent_is_null { return 0; };
    let is_new_chat = input.dangerDialogIntent_source_len == 8; // "new-chat"
    if is_new_chat && !verifySshWorkspaceBeforeCreate(input, STR_PTR(""), 0) { return 0; };
    if is_new_chat {
        if !applyWorkspaceSelectionFromDialog(input, STR_PTR(""), 0, false) { return 0; };
        updateNewConversationRuntimeSelection(input, input.dangerDialogIntent_nextPermission_ptr, input.dangerDialogIntent_nextPermission_len);
    } else {
        setRuntimePermission(input, input.dangerDialogIntent_nextPermission_ptr, input.dangerDialogIntent_nextPermission_len, true);
        persistPermissionForActiveThread(input, input.dangerDialogIntent_nextPermission_ptr, input.dangerDialogIntent_nextPermission_len);
    };
    // setDangerBypassConfirmed(true); if new-chat setWelcomeDismissed(false);
    return closeDangerDialog(input);
}

fn useSaferModeFromDangerDialog(input: &UseNewSessionFlowInput, epochs_inout: &u64) -> i32 {
    if !input.dangerDialogIntent_is_null && input.dangerDialogIntent_source_len == 8 {
        beginNewSession(input, STR_PTR("workspaceAsk"), STR_LEN("workspaceAsk"), epochs_inout);
    } else {
        setRuntimePermission(input, STR_PTR("workspaceAsk"), STR_LEN("workspaceAsk"), false);
        // setDangerBypassConfirmed(false);
    };
    return closeDangerDialog(input);
}

// DEFECT: async — selectProviderForCurrentThread(providerId, groupId?) returns Promise<void> in TS (Promise.resolve()/reject flattened to status codes).
fn selectProviderForCurrentThread(input: &UseNewSessionFlowInput, providerId_ptr: ptr, providerId_len: u64, groupId_ptr: ptr, groupId_len: u64, groupId_given: bool) -> i32 {
    // agy-official -> patch { cliBackend: "agy", providerId: "agy-official", groupId: null, model: "gemini-3.8-flash-high" }
    // agy-launch   -> patch { cliBackend: "agy", providerId: "agy-launch", groupId: "default", model: "gemini-3.8-flash-high" }
    // grok-official-> patch { cliBackend: "grok", providerId: "grok-official", groupId: null, model: "grok-4.6" }
    // each: if (activeThreadIdRef.current) updateRuntimeSelectionAndPersist(patch); else updateNewConversationRuntimeSelection(patch); return Promise.resolve();
    if providerId_len == 12 || providerId_len == 10 || providerId_len == 13 {
        if !input.activeThreadIdRef_is_null { return updateRuntimeSelectionAndPersist(input, providerId_ptr, providerId_len); };
        return updateNewConversationRuntimeSelection(input, providerId_ptr, providerId_len);
    };
    // const provider = state.providers.find(entry => entry.id === providerId); if (!provider) return Promise.reject(new Error(`Provider not found: ${providerId}`));
    // DEFECT: Promise.reject has no SLA counterpart; status code 5 used. Provider lookup over dynamic JSON done by host.
    // hasProviderCredential = hasConfiguredProviderCredential(provider); selectableGroups = provider.groups?.filter(entry => isAvailableRelayGroup(entry, hasProviderCredential)) ?? [];
    // group = requested available group ?? first non-image selectable ?? requested ?? first non-image ?? groups[0]
    // models = group ? relayGroupSelectableModels(provider, group) : provider.nativeModels;
    // selectedModel = models contains (modelSelectionMatches) selectedModelRef.current ? it : models[0] ?? "";
    // freebuff override: if (group?.id === "freebuff" && freebuffSession?.active && freebuffSession.model && models contains it) selectedModel = freebuffSession.model;
    // effectiveCliBackend = currentSelection.cliBackend ?? runtimeSelection.cliBackend ?? DEFAULT_CLI_BACKEND; patch = { cliBackend: effectiveCliBackend, providerId, groupId: group?.id ?? null, model: selectedModel };
    if !input.activeThreadIdRef_is_null { return updateRuntimeSelectionAndPersist(input, providerId_ptr, providerId_len); };
    return updateNewConversationRuntimeSelection(input, providerId_ptr, providerId_len);
}

fn useNewSessionFlow(input: &UseNewSessionFlowInput) -> i32 {
    return 0; // returns the 15-function family above, in source order
}
