// Converted 1:1 from apps/web/src/app/workbench/useOfficialLogin.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "sa_std/io/print.sai"

// DEFECT: React hooks (useState/useRef/useCallback) have no SLA counterpart; state modelled as a plain struct + functions.
// DEFECT: async functions / Promise executor converted to synchronous functions returning a status code; the returned completion Promise has no SLA counterpart.
// DEFECT: EventTarget add/removeEventListener + CustomEvent have no SLA counterpart; server-message delivery modelled as an explicit onMessage function the host must call.
// DEFECT: Map<string, callback> has no SLA counterpart; approximated as fixed arrays (capacity 16) + JSON buffer.
// DEFECT: dynamic objects (ProviderConfig literal, rpc params) approximated as JSON text buffers.
// DEFECT: window.setTimeout/clearTimeout have no sa_std counterpart; timeout kept as a deadline field.

struct UseOfficialLoginInput {
    state_json_ptr: ptr, state_json_len: u64,
    state_providers_json_ptr: ptr, state_providers_json_len: u64,
    dispatch_handle: u64,
    client_handle: u64,
    t_handle: u64,
}

struct UseOfficialLogin {
    officialLoginOpen: bool,
    officialLoginNotice_ptr: ptr, officialLoginNotice_len: u64, officialLoginNotice_is_null: bool,
    // officialOAuthSessionsRef: Map<string, (reason?: Error) => void>
    session_ids_ptr: [ptr; 16], session_ids_len: [u64; 16], session_count: u64,
    // in-flight login state lifted from closure locals in startOfficialOpenAiOAuth
    loginId_ptr: ptr, loginId_len: u64,
    settled: bool,
    timer_deadline_ms: u64,
    completion_status: i32, // 0 pending, 1 resolved, 2 rejected
}

fn client_rpc(input: &UseOfficialLoginInput, method_ptr: ptr, method_len: u64, params_json_ptr: ptr, params_json_len: u64, out_json_ptr: ptr, out_json_len: &u64) -> i32 { return 0; }
fn client_saveProvider(input: &UseOfficialLoginInput, provider_json_ptr: ptr, provider_json_len: u64, out_json_ptr: ptr, out_json_len: &u64) -> i32 { return 0; }
// DEFECT: async — activateProvider(providerId, model?, groupId?): Promise<void> in TS.
fn activateProvider(id_ptr: ptr, id_len: u64, model_ptr: ptr, model_len: u64, group_ptr: ptr, group_len: u64) -> i32 { return 0; }
fn dispatch_action(input: &UseOfficialLoginInput, action_json_ptr: ptr, action_json_len: u64) -> i32 { return 0; }

fn finish(s: &UseOfficialLogin) -> i32 {
    if s.settled { return 0; };
    s.settled = true;
    s.timer_deadline_ms = 0; // window.clearTimeout(timer)
    // client.removeEventListener("server-message", onMessage); — DEFECT: no SLA counterpart.
    if s.loginId_len > 0 {
        // officialOAuthSessionsRef.current.delete(loginId) — approximated by clearing matching slot
        for i in 0..s.session_count {
            if s.session_ids_len[i] == s.loginId_len { s.session_ids_len[i] = 0; };
        }
    };
    return 0;
}

// DEFECT: async — finalizeLogin() nested async function in TS; closure over login state, modelled with explicit struct fields.
fn finalizeLogin(input: &UseOfficialLoginInput, s: &UseOfficialLogin) -> i32 {
    let account_ptr: ptr = STR_PTR(""); let account_len: u64 = 0;
    let models_ptr: ptr = STR_PTR(""); let models_len: u64 = 0;
    // const [account, modelResult] = await Promise.all([client.rpc("account/read", { refreshToken: true }), client.rpc("model/list", {})]);
    // DEFECT: Promise.all concurrency has no SLA counterpart; sequential calls used.
    let rc = client_rpc(input, STR_PTR("account/read"), STR_LEN("account/read"), STR_PTR("{\"refreshToken\":true}"), STR_LEN("{\"refreshToken\":true}"), account_ptr, &account_len);
    if rc != 0 { finish(s); s.completion_status = 2; return rc; };
    rc = client_rpc(input, STR_PTR("model/list"), STR_LEN("model/list"), STR_PTR("{}"), STR_LEN("{}"), models_ptr, &models_len);
    if rc != 0 { finish(s); s.completion_status = 2; return rc; };
    // modelsValue = asRecord(modelResult).data ?? asRecord(modelResult).models; modelIds = [...new Set(models.map(...stringValue(model.model) ?? stringValue(model.id) ?? "").filter(Boolean))]
    // DEFECT: Set / map / filter over dynamic JSON has no SLA counterpart; model ids kept as JSON text buffer.
    // if (modelIds.length === 0) throw new Error("OpenAI OAuth succeeded, but no official models were returned");
    if models_len == 0 { finish(s); s.completion_status = 2; return 3; };
    // existing = state.providers.find(p => p.id === "official-openai" || p.kind === "chatgpt"); saved = await client.saveProvider({ ...existing, id, kind: "chatgpt", name: "OpenAI 官方", serviceProvider, apiKeyStorage: "none", defaultModel: modelIds[0], nativeModels: modelIds, modelAliases, stationType: "official", channelMode: "fast", groups: [{ id: "default", ... }], createdAt, updatedAt: Date.now() })
    // DEFECT: object spread / nested group literal approximated as a single JSON text buffer built by the host.
    let saved_ptr: ptr = STR_PTR(""); let saved_len: u64 = 0;
    rc = client_saveProvider(input, models_ptr, models_len, saved_ptr, &saved_len);
    if rc != 0 { finish(s); s.completion_status = 2; return rc; };
    dispatch_action(input, STR_PTR("{\"type\":\"account\"}"), STR_LEN("{\"type\":\"account\"}"));
    dispatch_action(input, STR_PTR("{\"type\":\"models\"}"), STR_LEN("{\"type\":\"models\"}"));
    dispatch_action(input, STR_PTR("{\"type\":\"providers\"}"), STR_LEN("{\"type\":\"providers\"}"));
    rc = activateProvider(saved_ptr, saved_len, models_ptr, models_len, STR_PTR("default"), STR_LEN("default"));
    if rc != 0 { finish(s); s.completion_status = 2; return rc; };
    finish(s);
    s.completion_status = 1; // resolveCompletion?.()
    return 0;
}

fn onMessage(input: &UseOfficialLoginInput, s: &UseOfficialLogin, detail_type_ptr: ptr, detail_type_len: u64, method_ptr: ptr, method_len: u64, params_json_ptr: ptr, params_json_len: u64, params_success: bool, params_loginId_ptr: ptr, params_loginId_len: u64) -> i32 {
    // if (detail.type !== "codex.notification" || detail.message.method !== "account/login/completed") return;
    if !(detail_type_len == STR_LEN("codex.notification")) { return 0; };
    if !(method_len == STR_LEN("account/login/completed")) { return 0; };
    if s.loginId_len == 0 || !(params_loginId_len == s.loginId_len) { return 0; };
    if params_success { return finalizeLogin(input, s); };
    finish(s);
    s.completion_status = 2; // rejectCompletion(new Error(stringValue(params.error) ?? "OpenAI OAuth login failed"))
    return 0;
}

// DEFECT: async — startOfficialOpenAiOAuth returns { loginId, authUrl, completion } in TS; completion Promise dropped, status field used.
fn startOfficialOpenAiOAuth(input: &UseOfficialLoginInput, s: &UseOfficialLogin, out_authUrl_ptr: ptr, out_authUrl_len: &u64) -> i32 {
    s.loginId_ptr = STR_PTR(""); s.loginId_len = 0;
    s.settled = false;
    s.completion_status = 0;
    // client.addEventListener("server-message", onMessage); — DEFECT: no SLA counterpart; host must forward events to onMessage above.
    s.timer_deadline_ms = 600000; // window.setTimeout(..., 10 * 60_000) -> reject "OpenAI OAuth login timed out"
    let ignored_ptr: ptr = STR_PTR(""); let ignored_len: u64 = 0;
    // await client.rpc("account/logout", {}).catch(() => undefined);
    let rc_logout = client_rpc(input, STR_PTR("account/logout"), STR_LEN("account/logout"), STR_PTR("{}"), STR_LEN("{}"), ignored_ptr, &ignored_len);
    // (logout failure deliberately ignored in TS)
    let result_ptr: ptr = STR_PTR(""); let result_len: u64 = 0;
    let rc = client_rpc(input, STR_PTR("account/login/start"), STR_LEN("account/login/start"), STR_PTR("{\"type\":\"chatgpt\",\"codexStreamlinedLogin\":true,\"useHostedLoginSuccessPage\":true,\"appBrand\":\"codex\"}"), STR_LEN("{\"type\":\"chatgpt\",\"codexStreamlinedLogin\":true,\"useHostedLoginSuccessPage\":true,\"appBrand\":\"codex\"}"), result_ptr, &result_len);
    if rc != 0 { finish(s); return rc; };
    // loginId = stringValue(result.loginId) ?? ""; authUrl = stringValue(result.authUrl) ?? "";
    // DEFECT: dynamic JSON field extraction approximated; host fills loginId / authUrl buffers.
    if s.loginId_len == 0 || out_authUrl_len == 0 { finish(s); return 4; }; // throw new Error("OpenAI OAuth did not return a login URL")
    // officialOAuthSessionsRef.current.set(loginId, (reason) => { finish(); rejectCompletion(...); });
    // DEFECT: closure stored in Map has no SLA counterpart; cancellation routed through cancelOfficialOpenAiOAuth by id match.
    if s.session_count < 16 {
        s.session_ids_ptr[s.session_count] = s.loginId_ptr;
        s.session_ids_len[s.session_count] = s.loginId_len;
        s.session_count = s.session_count + 1;
    };
    return 0;
}

// DEFECT: async
fn cancelOfficialOpenAiOAuth(input: &UseOfficialLoginInput, s: &UseOfficialLogin, loginId_ptr: ptr, loginId_len: u64) -> i32 {
    // officialOAuthSessionsRef.current.get(loginId)?.(new Error("OpenAI OAuth login was cancelled"));
    for i in 0..s.session_count {
        if s.session_ids_len[i] == loginId_len { finish(s); s.completion_status = 2; };
    }
    let out_ptr: ptr = STR_PTR(""); let out_len: u64 = 0;
    return client_rpc(input, STR_PTR("account/login/cancel"), STR_LEN("account/login/cancel"), loginId_ptr, loginId_len, out_ptr, &out_len);
}

fn useOfficialLogin(input: &UseOfficialLoginInput) -> UseOfficialLogin {
    let s = UseOfficialLogin {
        officialLoginOpen: false,
        officialLoginNotice_ptr: STR_PTR(""), officialLoginNotice_len: 0, officialLoginNotice_is_null: true,
        session_ids_ptr: [STR_PTR(""); 16], session_ids_len: [0u64; 16], session_count: 0,
        loginId_ptr: STR_PTR(""), loginId_len: 0, settled: false, timer_deadline_ms: 0, completion_status: 0,
    };
    return s;
}
