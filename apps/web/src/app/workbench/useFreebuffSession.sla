// DEFECT: the imported fetch*/release* functions are async HTTP calls;
// approximated by synchronous placeholders returning status codes.

struct StrBuf {
    bytes: [u8; 8192], len: u64,
}

struct JsonBuf {
    bytes: [u8; 32768], len: u64,  // DEFECT: dynamic object
}

// FreebuffSessionStatus approximated as JSON + the fields read here.
struct FreebuffSessionStatus {
    json: JsonBuf,
    active: bool,
    model: [u8; 256], model_len: u64, has_model: bool, // string?
}

// ---- useFreebuffSession.ts:18-23 — hook input ----
struct UseFreebuffSessionInput {
    state_token: [u8; 512], state_token_len: u64, has_state_token: bool, // ClientState.token (state itself opaque)
    dispatch: u64,                              // Dispatch<appReducer action> — handler handle
    activeThreadIdRef_current: [u8; 128], activeThreadIdRef_current_len: u64, has_activeThreadIdRef_current: bool, // MutableRefObject<string | null>
    setSlashNotice: u64,                        // Dispatch<SetStateAction<SlashCommandNotice | null>> — handler handle
    updateNewConversationRuntimeSelection: u64, // Pick<ThreadRuntimeSelectionsDomain>
    setSelectedModel: u64,                      // Pick<ThreadRuntimeSelectionsDomain>
}

// ---- useFreebuffSession.ts:25-36,102-123 — hook state + return shape ----
struct UseFreebuffSessionState {
    freebuffSession: FreebuffSessionStatus, has_freebuffSession: bool, // useState<FreebuffSessionStatus | null>(null)
    freebuffSwitchDialogOpen: bool,             // useState(false)
    freebuffSwitchTargetModel: [u8; 256], freebuffSwitchTargetModel_len: u64, // useState("")
    freebuffSwitchBusy: bool,                   // useState(false)
    clineBalance_json: JsonBuf, has_clineBalance: bool, // useState<ClineBalanceInfo | null>(null)
    freebuffAutoFailover: bool,                 // useState(() => readStoredBoolean("codex_freebuff_auto_failover", true))
    freebuffFallbackSuggestion_currentModel: [u8; 256], freebuffFallbackSuggestion_currentModel_len: u64, // useState<{ currentModel, suggestedModel: { id, name, price }, reason } | null>(null)
    freebuffFallbackSuggestion_suggestedId: [u8; 128], freebuffFallbackSuggestion_suggestedId_len: u64,
    freebuffFallbackSuggestion_suggestedName: [u8; 256], freebuffFallbackSuggestion_suggestedName_len: u64,
    freebuffFallbackSuggestion_suggestedPrice: f64,
    freebuffFallbackSuggestion_reason: [u8; 1024], freebuffFallbackSuggestion_reason_len: u64,
    has_freebuffFallbackSuggestion: bool,
    // returned callbacks: refreshFreebuffSession, refreshClineBalance,
    // handleReleaseFreebuffSlotFromChip, handleConfirmFreebuffSwitch,
    // handleKeepCurrentFreebuffModel (functions below)
}

fn useFreebuffSession_init(st: &UseFreebuffSessionState) -> i32 {
    st.has_freebuffSession = false;
    st.freebuffSwitchDialogOpen = false;
    st.freebuffSwitchTargetModel_len = 0;
    st.freebuffSwitchBusy = false;
    st.has_clineBalance = false;
    // lazy initializer: readStoredBoolean("codex_freebuff_auto_failover", true)
    // DEFECT: readStoredBoolean is a placeholder (localStorage); default true.
    st.freebuffAutoFailover = true;
    st.has_freebuffFallbackSuggestion = false;
    return 0;
}

