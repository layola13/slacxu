// Imported async API placeholders (codexClient unit). DEFECT: async.
fn fetchFreebuffSessionStatus(token_ptr: ptr, token_len: u64, out: &FreebuffSessionStatus) -> i32 {
    out.active = false;
    out.has_model = false;
    out.json.len = 0;
    return 1; // DEFECT: placeholder
}

fn fetchClineBalance(token_ptr: ptr, token_len: u64, forceRefresh: bool, out_json: &JsonBuf) -> i32 {
    out_json.len = 0;
    return 1; // DEFECT: placeholder
}

fn releaseFreebuffSessionSlot(token_ptr: ptr, token_len: u64) -> i32 {
    return 1; // DEFECT: placeholder
}

// ---- useFreebuffSession.ts:42-51 — refreshFreebuffSession (useCallback, async) ----
// DEFECT: async — synchronous + status code (0 = status returned, 1 = null).
fn useFreebuffSession_refreshFreebuffSession(input: &UseFreebuffSessionInput, st: &UseFreebuffSessionState, token_ptr: ptr, token_len: u64, has_token_arg: bool, out_status: &FreebuffSessionStatus) -> i32 {
    // default parameter: token = state.token
    let eff_ptr = token_ptr;
    let eff_len = token_len;
    let eff_has = has_token_arg;
    if !has_token_arg {
        eff_ptr = &input.state_token;
        eff_len = input.state_token_len;
        eff_has = input.has_state_token;
    };
    if !eff_has || eff_len == 0 {
        return 1; // if (!token) return null
    };
    // try { status = await fetchFreebuffSessionStatus(token); setFreebuffSession(status); return status } catch { return null }
    let rc = fetchFreebuffSessionStatus(eff_ptr, eff_len, out_status);
    if rc != 0 {
        return 1;
    };
    st.freebuffSession = *out_status;
    st.has_freebuffSession = true;
    return 0;
}

// ---- useFreebuffSession.ts:53-62 — refreshClineBalance (useCallback, async) ----
// DEFECT: async — synchronous + status code (0 = info returned, 1 = null).
fn useFreebuffSession_refreshClineBalance(input: &UseFreebuffSessionInput, st: &UseFreebuffSessionState, token_ptr: ptr, token_len: u64, has_token_arg: bool, forceRefresh: bool, out_json: &JsonBuf) -> i32 {
    let eff_ptr = token_ptr;
    let eff_len = token_len;
    let eff_has = has_token_arg;
    if !has_token_arg {
        eff_ptr = &input.state_token;
        eff_len = input.state_token_len;
        eff_has = input.has_state_token;
    };
    if !eff_has || eff_len == 0 {
        return 1;
    };
    let rc = fetchClineBalance(eff_ptr, eff_len, forceRefresh, out_json);
    if rc != 0 {
        return 1;
    };
    st.clineBalance_json = *out_json;
    st.has_clineBalance = true;
    return 0;
}

// ---- useFreebuffSession.ts:64-79 — handleReleaseFreebuffSlotFromChip (useCallback, async) ----
// DEFECT: async — synchronous + status code. Date.now() in the notice id has
// no SLA counterpart yet (placeholder 0).
fn useFreebuffSession_handleReleaseFreebuffSlotFromChip(input: &UseFreebuffSessionInput, st: &UseFreebuffSessionState) -> i32 {
    if !input.has_state_token || input.state_token_len == 0 {
        return 0; // if (!state.token) return
    };
    let rc = releaseFreebuffSessionSlot(&input.state_token, input.state_token_len);
    if rc == 0 {
        let status = FreebuffSessionStatus { json: JsonBuf { bytes: [0u8; 32768], len: 0 }, active: false, model: [0u8; 256], model_len: 0, has_model: false };
        useFreebuffSession_refreshFreebuffSession(input, st, STR_PTR(""), 0, false, &status);
        // setSlashNotice({ id: `freebuff-slot-released-${Date.now()}`, title: "Freebuff 插槽已释放",
        //   message: "当前模型插槽已成功释放", severity: "info" }) — via handler handle
        // DEFECT: notice construction + setter invocation deferred.
        return 0;
    };
    // catch: dispatch({ type: "error", message: `释放 Freebuff 插槽失败: ${formatErrorText(error)}` })
    // DEFECT: dispatch invocation deferred.
    return rc;
}

// ---- useFreebuffSession.ts:81-96 — handleConfirmFreebuffSwitch (useCallback, async) ----
// DEFECT: async — synchronous + status code.
fn useFreebuffSession_handleConfirmFreebuffSwitch(input: &UseFreebuffSessionInput, st: &UseFreebuffSessionState) -> i32 {
    if !input.has_state_token || input.state_token_len == 0 || st.freebuffSwitchTargetModel_len == 0 {
        return 0; // if (!state.token || !freebuffSwitchTargetModel) return
    };
    st.freebuffSwitchBusy = true;               // setFreebuffSwitchBusy(true)
    let rc = releaseFreebuffSessionSlot(&input.state_token, input.state_token_len);
    if rc == 0 {
        // if (activeThreadIdRef.current) setSelectedModel(freebuffSwitchTargetModel)
        // else updateNewConversationRuntimeSelection({ model: freebuffSwitchTargetModel })
        // DEFECT: handler invocation deferred.
        st.freebuffSwitchDialogOpen = false;    // setFreebuffSwitchDialogOpen(false)
        let status = FreebuffSessionStatus { json: JsonBuf { bytes: [0u8; 32768], len: 0 }, active: false, model: [0u8; 256], model_len: 0, has_model: false };
        useFreebuffSession_refreshFreebuffSession(input, st, STR_PTR(""), 0, false, &status);
    } else {
        // catch: dispatch({ type: "error", message: `释放 Freebuff 插槽失败: ${formatErrorText(error)}` })
    };
    st.freebuffSwitchBusy = false;              // finally
    return rc;
}

// ---- useFreebuffSession.ts:98-105 — handleKeepCurrentFreebuffModel (useCallback) ----
fn useFreebuffSession_handleKeepCurrentFreebuffModel(input: &UseFreebuffSessionInput, st: &UseFreebuffSessionState) -> i32 {
    if st.has_freebuffSession && st.freebuffSession.active && st.freebuffSession.has_model {
        // if (activeThreadIdRef.current) setSelectedModel(freebuffSession.model)
        // else updateNewConversationRuntimeSelection({ model: freebuffSession.model })
        // DEFECT: handler invocation deferred.
    };
    st.freebuffSwitchDialogOpen = false;        // setFreebuffSwitchDialogOpen(false)
    return 0;
}
