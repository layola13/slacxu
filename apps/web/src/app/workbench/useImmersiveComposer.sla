// Converted 1:1 from apps/web/src/app/workbench/useImmersiveComposer.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "sa_std/io/print.sai"

// DEFECT: React hooks (useState/useRef/useCallback) have no SLA counterpart; hook state modelled as a plain struct + functions.
// DEFECT: DOM APIs (HTMLDivElement, style.setProperty, dataset, getBoundingClientRect, pointer capture, PointerEvent, window.innerWidth/innerHeight) have no sa_std counterpart; geometry kept as numeric fields, DOM side effects as stubs.

struct ImmersiveOffset { x: i32, y: i32 }

struct ImmersiveDrag {
    is_null: bool,
    pointerId: i32,
    startX: i32, startY: i32,
    baseX: i32, baseY: i32,
    minX: i32, maxX: i32, minY: i32, maxY: i32,
    latestX: i32, latestY: i32,
}

struct PointerEventLike {
    pointerId: i32,
    button: i32,
    isPrimary: bool,
    clientX: i32, clientY: i32,
    target_is_interactive: bool,
    dock_left: i32, dock_top: i32, dock_right: i32, dock_bottom: i32,
    bounds_has_parent: bool,
    bounds_left: i32, bounds_top: i32, bounds_right: i32, bounds_bottom: i32,
    window_innerWidth: i32, window_innerHeight: i32,
}

struct UseImmersiveComposer {
    immersiveView: bool,
    immersiveTaskTabsOpen: bool,
    immersiveComposerCompact: bool,
    immersiveHintSequence: u64,
    immersiveExitHintOpen: bool,
    immersiveComposerHintOpen: bool,
    immersiveComposerOffsetRef: ImmersiveOffset,
    // DEFECT: immersiveComposerDockRef (HTMLDivElement | null) has no SLA counterpart; represented by a presence flag + last applied offset.
    immersiveComposerDockRef_present: bool,
    dock_offset_x: i32, dock_offset_y: i32, dock_dragging: bool,
    immersiveComposerDragRef: ImmersiveDrag,
}

fn applyImmersiveComposerOffset(s: &UseImmersiveComposer, x: i32, y: i32) -> i32 {
    // const dock = immersiveComposerDockRef.current; if (!dock) return;
    if !s.immersiveComposerDockRef_present { return 0; };
    // dock.style.setProperty("--immersive-composer-offset-x", `${x}px`); ...-y likewise
    // DEFECT: template literal / CSS custom property write has no SLA counterpart; values recorded only.
    s.dock_offset_x = x; s.dock_offset_y = y;
    return 0;
}

fn resetImmersiveComposerOffset(s: &UseImmersiveComposer) -> i32 {
    let drag = s.immersiveComposerDragRef;
    s.immersiveComposerDragRef.is_null = true;
    s.immersiveComposerOffsetRef.x = 0; s.immersiveComposerOffsetRef.y = 0;
    if s.immersiveComposerDockRef_present {
        s.dock_dragging = false;
        // if (drag && dock.hasPointerCapture(drag.pointerId)) dock.releasePointerCapture(drag.pointerId);
        // DEFECT: pointer capture APIs have no SLA counterpart; no-op.
    };
    applyImmersiveComposerOffset(s, 0, 0);
    return 0;
}

fn beginImmersiveComposerDrag(s: &UseImmersiveComposer, event: &PointerEventLike) -> i32 {
    if !s.immersiveView || !s.immersiveComposerCompact || event.button != 0 || !event.isPrimary { return 0; };
    // if (target.closest("input, textarea, button, a, [role='button'], [role='combobox'], [role='menuitem']")) return;
    // DEFECT: Element.closest selector matching has no SLA counterpart; caller supplies target_is_interactive.
    if event.target_is_interactive { return 0; };
    let bounds_left = event.bounds_left; let bounds_top = event.bounds_top;
    let bounds_right = event.bounds_right; let bounds_bottom = event.bounds_bottom;
    if !event.bounds_has_parent {
        bounds_left = 0; bounds_top = 0; bounds_right = event.window_innerWidth; bounds_bottom = event.window_innerHeight;
    };
    let margin: i32 = 8;
    let base = s.immersiveComposerOffsetRef;
    s.immersiveComposerDragRef = ImmersiveDrag {
        is_null: false,
        pointerId: event.pointerId, startX: event.clientX, startY: event.clientY,
        baseX: base.x, baseY: base.y,
        minX: base.x + bounds_left + margin - event.dock_left,
        maxX: base.x + bounds_right - margin - event.dock_right,
        minY: base.y + bounds_top + margin - event.dock_top,
        maxY: base.y + bounds_bottom - margin - event.dock_bottom,
        latestX: base.x, latestY: base.y,
    };
    s.dock_dragging = true;
    // dock.setPointerCapture(event.pointerId); event.preventDefault();
    return 0;
}

fn moveImmersiveComposer(s: &UseImmersiveComposer, event: &PointerEventLike) -> i32 {
    let drag = s.immersiveComposerDragRef;
    if drag.is_null || drag.pointerId != event.pointerId { return 0; };
    let rawX = drag.baseX + event.clientX - drag.startX;
    let rawY = drag.baseY + event.clientY - drag.startY;
    let nextX = rawX; if nextX > drag.maxX { nextX = drag.maxX; }; if nextX < drag.minX { nextX = drag.minX; };
    let nextY = rawY; if nextY > drag.maxY { nextY = drag.maxY; }; if nextY < drag.minY { nextY = drag.minY; };
    s.immersiveComposerDragRef.latestX = nextX;
    s.immersiveComposerDragRef.latestY = nextY;
    applyImmersiveComposerOffset(s, nextX, nextY);
    // event.preventDefault();
    return 0;
}

fn endImmersiveComposerDrag(s: &UseImmersiveComposer, event: &PointerEventLike) -> i32 {
    let drag = s.immersiveComposerDragRef;
    if drag.is_null || drag.pointerId != event.pointerId { return 0; };
    s.immersiveComposerDragRef.is_null = true;
    s.immersiveComposerOffsetRef.x = drag.latestX;
    s.immersiveComposerOffsetRef.y = drag.latestY;
    s.dock_dragging = false;
    // if (event.currentTarget.hasPointerCapture(...)) releasePointerCapture — DEFECT: no SLA counterpart.
    return 0;
}

fn enterImmersiveView(s: &UseImmersiveComposer) -> i32 {
    resetImmersiveComposerOffset(s);
    s.immersiveComposerCompact = true;
    s.immersiveView = true;
    s.immersiveHintSequence = s.immersiveHintSequence + 1; // setImmersiveHintSequence((current) => current + 1)
    s.immersiveExitHintOpen = true;
    s.immersiveComposerHintOpen = true;
    return 0;
}

fn exitImmersiveView(s: &UseImmersiveComposer) -> i32 {
    s.immersiveView = false;
    s.immersiveComposerCompact = false;
    s.immersiveExitHintOpen = false;
    s.immersiveComposerHintOpen = false;
    return 0;
}

fn useImmersiveComposer() -> UseImmersiveComposer {
    // immersiveView / immersiveComposerCompact initialised via readStoredBoolean(UI_STORAGE_KEYS.immersiveView, false)
    // DEFECT: lazy useState initializer closure has no SLA counterpart; read eagerly.
    let s = UseImmersiveComposer {
        immersiveView: false, immersiveTaskTabsOpen: false, immersiveComposerCompact: false,
        immersiveHintSequence: 0, immersiveExitHintOpen: false, immersiveComposerHintOpen: false,
        immersiveComposerOffsetRef: ImmersiveOffset { x: 0, y: 0 },
        immersiveComposerDockRef_present: false, dock_offset_x: 0, dock_offset_y: 0, dock_dragging: false,
        immersiveComposerDragRef: ImmersiveDrag { is_null: true, pointerId: 0, startX: 0, startY: 0, baseX: 0, baseY: 0, minX: 0, maxX: 0, minY: 0, maxY: 0, latestX: 0, latestY: 0 },
    };
    return s;
}
