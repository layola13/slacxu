struct StrBuf {
    bytes: [u8; 8192], len: u64,
}

struct JsonBuf {
    bytes: [u8; 32768], len: u64,  // DEFECT: dynamic object
}

// ---- useComposerRuntime.ts:47-61 — hook input ----
// DEFECT: ReturnType<typeof ...> bundles are opaque handles (six runtimes:
// access, taskTabs, threadWorkspace, selection, goals, settings). The fields
// destructured from each in the source (lines 64-275) are enumerated in the
// defect log.
struct UseComposerRuntimeInput {
    state: u64,                                 // ClientState — opaque handle
    dispatch: u64,
    themeMode: [u8; 32], themeMode_len: u64,
    customThemePlugins_json: JsonBuf,
    onThemeModeChange: u64,
    onCustomThemePluginsChange: u64,
    detachedThreadId: [u8; 128], detachedThreadId_len: u64, has_detachedThreadId: bool,
    access: u64,
    taskTabs: u64,
    threadWorkspace: u64,
    selection: u64,
    goals: u64,
    settings: u64,
}

// ---- useComposerRuntime.ts:537-610 — return shape ----
struct UseComposerRuntimeState {
    composerCore_json: JsonBuf,                 // the assembled ComposerCoreInput bundle (line 276)
    // useComposerThreadStart(composerCore)
    ensureActiveThread: u64,
    recordInterruptRetry: u64,
    interruptTurn: u64,
    // useComposerPipeline({ ...composerCore, ensureActiveThread, interruptTurn })
    startCodexTurn: u64,
    // useProviderTest({ state, dispatch, client, t, activateProvider, ... })
    pendingCodexProviderTest_json: JsonBuf, has_pendingCodexProviderTest: bool,
    testProviderWithCodex: u64,
    // useComposerAssists({ ...composerCore, startCodexTurn, ... }) (lines 292-303)
    schedulePlanContinuation: u64,
    stayInPlanMode: u64,
    implementApprovedPlan: u64,
    setGoalForActiveThread: u64,
    renameActiveThread: u64,
    startReview: u64,
    showDiffToRemote: u64,
    compactActiveThread: u64,
    resumeThreadFromSlash: u64,
    runImageCommand: u64,
    answerRequest: u64,
    respondToServerRequest: u64,
    // useComposerSend({ ...composerCore, startCodexTurn, ensureActiveThread, ... })
    handleComposerSlashCommand: u64,
    sendPrompt: u64,
    steerPrompt: u64,
    sendSideChatPrompt: u64,
    // configured context derivations (lines 358-368)
    configuredContextModel: [u8; 256], configuredContextModel_len: u64,
    configuredContextProvider_json: JsonBuf, has_configuredContextProvider: bool,
    configuredContextGroupId: [u8; 128], configuredContextGroupId_len: u64, has_configuredContextGroupId: bool,
    configuredContextGroup_json: JsonBuf, has_configuredContextGroup: bool,
    configuredContextWindow: f64, has_configuredContextWindow: bool, // number | null
    // active/displayed context derivations (lines 369-398)
    activeConversationThread_json: JsonBuf, has_activeConversationThread: bool,
    displayedContextProviderId: [u8; 128], displayedContextProviderId_len: u64, has_displayedContextProviderId: bool,
    displayedContextModel: [u8; 256], displayedContextModel_len: u64,
    displayedContextProvider_json: JsonBuf, has_displayedContextProvider: bool,
    displayedContextGroupId: [u8; 128], displayedContextGroupId_len: u64, has_displayedContextGroupId: bool,
    displayedContextGroup_json: JsonBuf, has_displayedContextGroup: bool,
    displayedThreadContextWindow: f64, has_displayedThreadContextWindow: bool,
    activeComposerThreadUsage_json: JsonBuf, has_activeComposerThreadUsage: bool, // usageStore.snapshot(activeThreadId).threadUsage ?? null
    // useFreeCompaction({ ...composerCore, ...refs, configuredContextWindow, providersRef, threadTokenUsage })
    refreshFreeCompactionModels: u64,
    notifyFreeModelSyncSuccess: u64,
    syncOmniRouteFree: u64,
    runFreeCompactionBeforeSend: u64,
    runJevCompressDirective: u64,
    // own callbacks (below)
    exportHistoryThread: u64,                   // placeholder id; real fn below
    // useWorkspaceGitFiles({ ... })
    composerGitBranch: [u8; 256], composerGitBranch_len: u64,
    composerGitDirtyCount: u64,
    readActiveWorkspaceDirectory: u64,
    workspaceGitRpc: u64,
    readActiveWorkspaceFile: u64,
    saveActiveWorkspaceFile: u64,
    // useWorkbenchOps({ ... })
    createWorkspaceFolder: u64,
    undoWaterfallFileChanges: u64,
    workspaceFileMutations_json: JsonBuf,
    closeRightWorkspace: u64,
    startRemoteBackgroundConversation: u64,
    // theme derivations (lines 478-494)
    allThemePlugins_json: JsonBuf,              // useMemo [...themePlugins, ...custom not in builtin]
    windowsDesktop: bool,                       // authSession?.desktopRuntime?.platform === "win32"
    activeThemePlugin_json: JsonBuf, has_activeThemePlugin: bool,
    shellBackgroundImage: [u8; 1024], shellBackgroundImage_len: u64, has_shellBackgroundImage: bool, // safeThemeAssetUrl(...)
    composerBackgroundImage: [u8; 1024], composerBackgroundImage_len: u64, has_composerBackgroundImage: bool,
    welcomeBackgroundImage: [u8; 1024], welcomeBackgroundImage_len: u64, has_welcomeBackgroundImage: bool,
    historyBackgroundImage: [u8; 1024], historyBackgroundImage_len: u64, has_historyBackgroundImage: bool,
    shellBackgroundVideo: [u8; 1024], shellBackgroundVideo_len: u64, has_shellBackgroundVideo: bool, // undefined on windowsDesktop
    backgroundScene_json: JsonBuf, has_backgroundScene: bool,
    effectiveBackgroundScene_json: JsonBuf, has_effectiveBackgroundScene: bool, // undefined on windowsDesktop
    themeTuning_json: JsonBuf,                  // themeVisualTuning(activeThemePlugin)
    petImage: [u8; 1024], petImage_len: u64, has_petImage: bool,
    showThemePet: bool,                         // Boolean(petImage && layout?.petEnabled !== false)
    activeRunningTurn_json: JsonBuf, has_activeRunningTurn: bool, // latestActionableRunningTurn(state.turns, activeThreadId)
    // useTurnOps({ state, dispatch, client, t, activeRunningTurn, ... })
    stopActiveTurn: u64,
    editLastUserMessage: u64,
    runningThreadIds_json: JsonBuf,             // useMemo Set<string> as JSON — DEFECT: Set
}

