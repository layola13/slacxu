@import "sa_std/io/print.sai"
@import "sa_std/string.sa"

// @import "../../state/codexConfigSettings.sla" // applyConfigWriteToView, buildConfigValueWrite, buildDynamicConfigValueWrite, parseConfigReadResponse, CodexConfigFieldKey, CodexUserConfigView
// @import "./modelSelectionUtils.sla" // resolveConfiguredProviderId
// @import "./appUtils.sla"            // errorMessage
// DEFECT: client.rpc(...) is async (Promise) in TS; approximated by the
// synchronous placeholder sa_client_rpc returning a status code + JSON body.
// try/catch/finally becomes status branches; `finally` setter writes are
// emitted on every path.

struct StrBuf {
    bytes: [u8; 8192], len: u64,
}

struct JsonBuf {
    bytes: [u8; 32768], len: u64,  // DEFECT: dynamic object
}

// CodexUserConfigView approximated as JSON text + the two fields read here.
struct CodexUserConfigView {
    json: JsonBuf,
    model: [u8; 256], model_len: u64, has_model: bool,          // string?
    modelProvider: [u8; 128], modelProvider_len: u64, has_modelProvider: bool, // string?
}

// ---- useCodexConfig.ts:19-24 — hook input ----
struct UseCodexConfigInput {
    state: u64,                                 // ClientState — opaque handle (state.providers read via placeholder)
    dispatch: u64,                              // Dispatch<appReducer action> — handler handle
    client: u64,                                // CodexSocketClient — opaque handle
    t: u64,                                     // TranslateFn — handler handle
    authSession_json: JsonBuf, has_authSession: bool, // AuthSession | null; user.role read from it
    activeThreadIdRef_current: [u8; 128], activeThreadIdRef_current_len: u64, has_activeThreadIdRef_current: bool, // MutableRefObject<string | null>
    selectionForThread: u64,                    // Pick<ThreadRuntimeSelectionsDomain>
    updateNewConversationRuntimeSelection: u64, // Pick<ThreadRuntimeSelectionsDomain>
}

// ---- useCodexConfig.ts:26-29,130-147 — hook state + return shape ----
struct UseCodexConfigState {
    codexConfig: CodexUserConfigView, has_codexConfig: bool,    // useState<CodexUserConfigView | null>(null)
    codexConfigLoading: bool,                   // useState(false)
    codexConfigSaving: bool,                    // useState(false)
    codexConfigError: [u8; 1024], codexConfigError_len: u64, has_codexConfigError: bool, // useState<string | null>(null)
    // returned callbacks: applyLoadedCodexConfig, loadCodexConfig,
    // writeCodexConfigField, writeCodexConfigValue (functions below);
    // returned setters map to direct field writes (DEFECT: hooks).
}

// Placeholder for client.rpc(method, params): 0 = ok, body JSON in out.
fn sa_client_rpc(client: u64, method_ptr: ptr, method_len: u64, params_json_ptr: ptr, params_json_len: u64, out_json: &JsonBuf) -> i32 {
    out_json.len = 0;
    return 1; // DEFECT: placeholder — no socket client in this pass
}

// parseConfigReadResponse(result) — imported; fills the view. DEFECT: deferred.
fn parseConfigReadResponse(result_json_ptr: ptr, result_json_len: u64, out: &CodexUserConfigView) -> i32 {
    out.has_model = false;
    out.has_modelProvider = false;
    out.json.len = 0;
    return 0;
}

// ---- useCodexConfig.ts:31-41 — applyLoadedCodexConfig (useCallback) ----
fn useCodexConfig_applyLoadedCodexConfig(input: &UseCodexConfigInput, st: &UseCodexConfigState, view: &CodexUserConfigView, providers_json_ptr: ptr, providers_json_len: u64) -> i32 {
    // setCodexConfig(view)
    st.codexConfig = *view;
    st.has_codexConfig = true;
    // if (activeThreadIdRef.current) return;
    if input.has_activeThreadIdRef_current {
        return 0;
    };
    // const newConversationSelection = selectionForThread(null);
    // const configuredProviderId = resolveConfiguredProviderId(providers, view.modelProvider);
    // if (configuredProviderId && !newConversationSelection.providerId)
    //   updateNewConversationRuntimeSelection({ providerId: configuredProviderId });
    // if (view.model && !newConversationSelection.model)
    //   updateNewConversationRuntimeSelection({ model: view.model });
    // DEFECT: selection record + handler invocation deferred.
    return 0;
}

// ---- useCodexConfig.ts:43-56 — loadCodexConfig (useCallback, async) ----
// DEFECT: async — synchronous + status code.
fn useCodexConfig_loadCodexConfig(input: &UseCodexConfigInput, st: &UseCodexConfigState) -> i32 {
    st.codexConfigLoading = true;               // setCodexConfigLoading(true)
    st.has_codexConfigError = false;            // setCodexConfigError(null)
    // try { result = await client.rpc("config/read", { includeLayers: false });
    //       view = parseConfigReadResponse(result);
    //       applyLoadedCodexConfig(view, state.providers); }
    let result = JsonBuf { bytes: [0u8; 32768], len: 0 };
    let rc = sa_client_rpc(input.client, STR_PTR("config/read"), STR_LEN("config/read"), STR_PTR("{\"includeLayers\":false}"), STR_LEN("{\"includeLayers\":false}"), &result);
    if rc == 0 {
        let view = CodexUserConfigView { json: JsonBuf { bytes: [0u8; 32768], len: 0 }, model: [0u8; 256], model_len: 0, has_model: false, modelProvider: [0u8; 128], modelProvider_len: 0, has_modelProvider: false };
        parseConfigReadResponse(&result.bytes, result.len, &view);
        useCodexConfig_applyLoadedCodexConfig(input, st, &view, STR_PTR(""), 0); // state.providers placeholder
    } else {
        // catch: setCodexConfigError(errorMessage("Codex config read", error))
        st.codexConfigError_len = 0;
        st.has_codexConfigError = true;         // DEFECT: errorMessage text deferred
    };
    st.codexConfigLoading = false;              // finally
    return rc;
}

