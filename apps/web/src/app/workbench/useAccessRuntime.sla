fn resolveTurnRetryState(current_json_ptr: ptr, current_json_len: u64, has_current: bool, next_json_ptr: ptr, next_json_len: u64, has_next: bool, out_json: &JsonBuf) -> i32 {
    out_json.len = 0;
    return 0; // DEFECT: placeholder
