// ---- useAccessRuntime.ts:48 — the hook itself (init) ----
fn useAccessRuntime_init(input: &UseAccessRuntimeInput, st: &UseAccessRuntimeState) -> i32 {
    // const { ... } = useSessionState(); — sub-hook call (placeholder values)
    st.authStatus = 0;
    st.has_authSession = false;
    st.has_loginError = false;
    st.loginSubmitting = false;
    // useState<SocketConnectionStatus>(INITIAL_SOCKET_CONNECTION_STATUS)
    st.connectionStatus_json.len = 0;           // DEFECT: struct init value deferred to appConstants unit
    st.connectionEpoch = 0;
    // useCliPrerequisites() / useMembersAdmin(...) / useWorkspacePicker() /
    // useSshWorkspace(...) / useHistoryState() — sub-hook calls; their fields
    // default to zero values here. DEFECT: sub-hook init deferred.
    st.dangerBypassConfirmed = false;
    st.has_dangerDialogIntent = false;
    st.dangerDialogAcknowledged = false;
    // lazy initializers readStoredString(UI_STORAGE_KEYS.settingAssistantProviderId, "")
    // and (…settingAssistantModel, "") — preferenceUtils placeholders.
    st.settingAssistantProviderId_len = 0;
    st.settingAssistantModel_len = 0;
    st.workspaceMode = 0;                       // "local"
    st.workspaceAgentsBusy = false;
    // cwd = useState(DEFAULT_NEW_CHAT_CWD)  ("~/")
    st.cwd[0] = 126;
    st.cwd[1] = 47;
    st.cwd_len = 2;
    st.additionalRoots_json.len = 2;            // []
    st.has_workspaceFilePath = false;
    st.newChatAdditionalRootsExpanded = false;
    st.workspaceSelectionPending = true;
    st.workspaceNewFolderName_len = 0;
    st.workspaceCreateBusy = false;
    st.has_localWorkspaceInfo = false;
    st.newChatSetupOpen = false;
    st.newChatBudgetLimit_len = 0;
    st.has_planImplementationPrompt = false;
    st.handledPlanImplementationIdsRef_json.len = 0;
    st.has_statsPanelScope = false;
    st.has_slashNotice = false;
    st.has_codexCliUpdateStatus = false;
    st.codexCliUpdateDialogOpen = false;
    st.codexCliUpdateBusy = false;
    st.has_codexCliUpdateError = false;
    st.has_freeModelNotice = false;
    st.pendingAppends_json.len = 2;
    st.pendingAcceptedThreads_json.len = 0;
    st.pendingNewConversationCount = 0;
    st.pendingSendGateRef_current = 0;           // new PendingSendGate()
    st.interruptTurnGateRef_current = 0;        // new InterruptTurnGate()
    st.composerWatchReactivationRef_current = 0;
    st.has_turnRetryState = false;
    st.modelCapacityRetryRef_json.len = 0;
    st.lastCodexActivityAtRef_current = 0;      // Date.now() — DEFECT: clock placeholder
    st.threadTokenUsage_json.len = 2;           // {}
    st.has_threadUsagePublishTimerRef_current = false;
    st.threadUsagePublishBusyRef_current = false;
    st.has_threadUsagePublishPendingRef = false;
    // if (!usageStoreRef.current) usageStoreRef.current = new TopicUsageStore();
    st.usageStoreRef_current = 1;               // DEFECT: construction placeholder handle
    st.usageStore = st.usageStoreRef_current;
    return 0;
}

// ---- useAccessRuntime.ts:131-138 — applyTurnRetryState (useCallback) ----
// setTurnRetryState(current => { const resolved = resolveTurnRetryState(current, next);
//   turnRetryStateRef.current = resolved; return resolved; })
fn useAccessRuntime_applyTurnRetryState(st: &UseAccessRuntimeState, next_json_ptr: ptr, next_json_len: u64, has_next: bool, next_is_updater: bool, next_updater: u64) -> i32 {
    resolveTurnRetryState(&st.turnRetryState_json.bytes, st.turnRetryState_json.len, st.has_turnRetryState, next_json_ptr, next_json_len, has_next, &st.turnRetryState_json);
    st.has_turnRetryState = has_next;
    // turnRetryStateRef.current = resolved
    st.turnRetryStateRef_json = st.turnRetryState_json;
    st.has_turnRetryStateRef = st.has_turnRetryState;
    return 0;
}

// ---- useAccessRuntime.ts:152-161 — flushThreadTokenUsage (useCallback) ----
fn useAccessRuntime_flushThreadTokenUsage(st: &UseAccessRuntimeState) -> i32 {
    if st.threadUsagePublishBusyRef_current {
        return 0;
    };
    if !st.has_threadUsagePublishPendingRef {
        return 0;
    };
    // next = pending; pending = null; busy = true;
    // startTransition(() => setThreadTokenUsage({ ...next }))
    // DEFECT: startTransition + spread copy — approximated by direct move.
    st.threadTokenUsage_json = st.threadUsagePublishPendingRef_json;
    st.has_threadUsagePublishPendingRef = false;
    st.threadUsagePublishBusyRef_current = true;
    return 0;
}

// ---- useAccessRuntime.ts:162-173 — useLayoutEffect (publish settle) ----
// If busy: clear busy; if a pending snapshot exists and no timer is armed,
// arm window.setTimeout(0) to flush. DEFECT: effect timing + window timers.
fn useAccessRuntime_threadUsageLayoutEffect(st: &UseAccessRuntimeState) -> i32 {
    if !st.threadUsagePublishBusyRef_current {
        return 0;
    };
    st.threadUsagePublishBusyRef_current = false;
    if st.has_threadUsagePublishPendingRef && !st.has_threadUsagePublishTimerRef_current {
        st.has_threadUsagePublishTimerRef_current = true; // timer id placeholder
        // timer body: timer = null; flushThreadTokenUsage();
    };
    return 0;
}

// ---- useAccessRuntime.ts:174-181 — useEffect cleanup (clear timer) ----
fn useAccessRuntime_threadUsageCleanupEffect(st: &UseAccessRuntimeState) -> i32 {
    if st.has_threadUsagePublishTimerRef_current {
        // window.clearTimeout(timer)
        st.has_threadUsagePublishTimerRef_current = false;
        st.threadUsagePublishTimerRef_current = 0;
    };
    return 0;
}
