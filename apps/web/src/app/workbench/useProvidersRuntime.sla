    isClaudeBackend: bool, isAgyBackend: bool, isGrokBackend: bool,
    activatedProviderSelectionRef_ptr: ptr, activatedProviderSelectionRef_len: u64, activatedProviderSelectionRef_is_null: bool,
    // providerRefreshRef / providerRefreshCacheRef
    refresh_inflight_token_ptr: ptr, refresh_inflight_token_len: u64, refresh_inflight: bool,
    cache_token_ptr: ptr, cache_token_len: u64, cache_refreshedAt: u64, cache_providers_json_ptr: ptr, cache_providers_json_len: u64,
}

