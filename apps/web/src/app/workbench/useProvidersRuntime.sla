    // const controller = new AbortController(); const timeout = window.setTimeout(() => controller.abort(), 15_000);
    s.relayShareExportBusy = true; s.relayShareExportError_is_null = true; s.relayShareExportText_len = 0;
    let provider_ptr: ptr = STR_PTR(""); let provider_len: u64 = 0;
    let rc = fetchRelaySettings(input.token_ptr, input.token_len, s.relayShareExportProvider_json_ptr, s.relayShareExportProvider_json_len, false, provider_ptr, &provider_len);
    if rc == 0 {
        // setRelayShareExportText(await encryptRelayShare(provider, relayShareExportPassword.trim())); setRelayShareExportError(null);
    } else {
        // AbortError -> "生成分享内容超时，请检查服务连接或中转站配置大小后重试" else `生成分享内容失败：${formatErrorText(error)}`
        s.relayShareExportError_is_null = false;
    };
    s.relayShareExportBusy = false; // finally: window.clearTimeout(timeout)
    return 0;
}

