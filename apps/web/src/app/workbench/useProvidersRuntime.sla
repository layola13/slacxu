    // try { const result = await importCapabilityCatalog(state.token, providerId, catalog, mode); const providers = await fetchProviders(state.token); dispatch providers; return result; } catch { dispatch error; throw; }
    let rc = fetchProviders(input.token_ptr, input.token_len, out_json_ptr, out_json_len);
    if rc == 0 { dispatch_action(input, STR_PTR("{\"type\":\"providers\"}"), STR_LEN("{\"type\":\"providers\"}")); };
    return rc;
}

fn useProvidersRuntime(input: &UseProvidersRuntimeInput) -> UseProvidersRuntime {
    let s = UseProvidersRuntime {
        relayShareImportText_ptr: STR_PTR(""), relayShareImportText_len: 0,
        relayShareImportPassword_ptr: STR_PTR(""), relayShareImportPassword_len: 0,
        relayShareImportOpen: false, relayShareImportBusy: false,
        relayShareImportError_ptr: STR_PTR(""), relayShareImportError_len: 0, relayShareImportError_is_null: true,
        relayShareExportError_ptr: STR_PTR(""), relayShareExportError_len: 0, relayShareExportError_is_null: true,
        relayShareExportBusy: false,
        relayShareExportProvider_json_ptr: STR_PTR(""), relayShareExportProvider_json_len: 0, relayShareExportProvider_is_null: true,
        relayShareExportPassword_ptr: STR_PTR(""), relayShareExportPassword_len: 0,
        relayShareExportConfirm_ptr: STR_PTR(""), relayShareExportConfirm_len: 0,
        relayShareExportText_ptr: STR_PTR(""), relayShareExportText_len: 0,
        relayShareExportOpen: false,
    };
    return s; // returns the state fields + the 22-function family above, in source order
}
