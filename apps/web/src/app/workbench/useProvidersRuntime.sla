// DEFECT: async — uploadCapabilityCatalog(providerId, catalog: JsonValue, mode: "merge" | "replace"): Promise<RelayCatalogImportResult>.
fn uploadCapabilityCatalog(input: &UseProvidersRuntimeInput, providerId_ptr: ptr, providerId_len: u64, catalog_json_ptr: ptr, catalog_json_len: u64, mode_ptr: ptr, mode_len: u64, out_json_ptr: ptr, out_json_len: &u64) -> i32 {
