// DEFECT: async — injectClaudeDesktop with for(;;) prompt-retry loop.
fn injectClaudeDesktop(input: &UseProvidersRuntimeInput, providerId_ptr: ptr, providerId_len: u64, groupId_ptr: ptr, groupId_len: u64, models_json_ptr: ptr, models_json_len: u64, mappings_json_ptr: ptr, mappings_json_len: u64) -> i32 {
    if input.token_is_null { return 1; }; // throw new Error("Authentication required")
    let configLibraryDir_ptr: ptr = STR_PTR(""); let configLibraryDir_len: u64 = 0; let has_dir = false;
    while true {
        // await injectRelayToClaudeDesktop(state.token, { providerId, groupId, models, modelMappings, configLibraryDir }); return;
        let rc = 0; // host call; rc == ClaudeDesktopConfigNotFoundError code continues the loop
        if rc == 0 { return 0; };
        if rc != 2 { return rc; }; // if (!(error instanceof ClaudeDesktopConfigNotFoundError)) throw error; — DEFECT: instanceof approximated by status code.
        let entered_ptr: ptr = STR_PTR(""); let entered_len: u64 = 0;
        let ok = window_prompt(STR_PTR("未能自动找到 Claude Desktop 配置目录（configLibrary），请手动输入其完整路径："), STR_LEN("未能自动找到 Claude Desktop 配置目录（configLibrary），请手动输入其完整路径："), configLibraryDir_ptr, configLibraryDir_len, entered_ptr, &entered_len);
        if !ok || entered_len == 0 { return 2; };
        configLibraryDir_ptr = entered_ptr; configLibraryDir_len = entered_len; has_dir = true;
    }
    return 0;
}

// DEFECT: async — injectCursorDesktop with for(;;) prompt-retry loop (default-path error carries searchedPath, stripped of trailing Cursor.exe via regex in TS).
fn injectCursorDesktop(input: &UseProvidersRuntimeInput, providerId_ptr: ptr, providerId_len: u64, groupId_ptr: ptr, groupId_len: u64) -> i32 {
    if input.token_is_null { return 1; };
    let installDir_ptr: ptr = STR_PTR(""); let installDir_len: u64 = 0;
    while true {
        let rc = 0; // await injectRelayToCursorDesktop(state.token, { providerId, groupId, installDir })
        if rc == 0 { return 0; };
        if rc != 2 { return rc; }; // CursorInstallDirNotFoundError only
        // const entered = window.prompt("未在默认位置找到 Cursor（Cursor.exe），请手动输入 Cursor 安装目录的完整路径：", error.searchedPath?.replace(/[\\/]Cursor\.exe$/i, "") ?? installDir ?? "");
        // DEFECT: regex replace has no SLA counterpart; host supplies the stripped default.
        let entered_ptr: ptr = STR_PTR(""); let entered_len: u64 = 0;
        let ok = window_prompt(STR_PTR("未在默认位置找到 Cursor（Cursor.exe），请手动输入 Cursor 安装目录的完整路径："), STR_LEN("未在默认位置找到 Cursor（Cursor.exe），请手动输入 Cursor 安装目录的完整路径："), installDir_ptr, installDir_len, entered_ptr, &entered_len);
        if !ok || entered_len == 0 { return 2; };
        installDir_ptr = entered_ptr; installDir_len = entered_len;
    }
    return 0;
}

