// DEFECT: async — refreshProviders(token, options): Promise<ProviderConfig[]> in TS; cache / in-flight Promise sharing modelled with the ref fields above.
fn refreshProviders(input: &UseProvidersRuntimeInput, s: &UseProvidersRuntime, token_ptr: ptr, token_len: u64, force: bool, now_ms: u64, out_json_ptr: ptr, out_json_len: &u64) -> i32 {
    if !force && input.cache_token_len == token_len && now_ms - input.cache_refreshedAt < 1500 {
        // return Promise.resolve(cached.providers);
        out_json_ptr = input.cache_providers_json_ptr; *out_json_len = input.cache_providers_json_len;
        return 0;
    };
    if input.refresh_inflight && input.refresh_inflight_token_len == token_len { return 0; }; // return inFlight.promise — DEFECT: shared Promise has no SLA counterpart.
    let rc = fetchProviders(token_ptr, token_len, out_json_ptr, out_json_len);
    if rc == 0 {
        dispatch_action(input, STR_PTR("{\"type\":\"providers\"}"), STR_LEN("{\"type\":\"providers\"}"));
        input.cache_token_ptr = token_ptr; input.cache_token_len = token_len; input.cache_refreshedAt = now_ms;
        input.cache_providers_json_ptr = out_json_ptr; input.cache_providers_json_len = *out_json_len;
    };
    input.refresh_inflight = false; // tracked.finally(...)
    return rc;
}

