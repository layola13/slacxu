fn fetchProviders(token_ptr: ptr, token_len: u64, out_json_ptr: ptr, out_json_len: &u64) -> i32 { return 0; }
fn fetchRelaySettings(token_ptr: ptr, token_len: u64, id_ptr: ptr, id_len: u64, aborted: bool, out_json_ptr: ptr, out_json_len: &u64) -> i32 { return 0; }
fn dispatch_action(input: &UseProvidersRuntimeInput, action_json_ptr: ptr, action_json_len: u64) -> i32 { return 0; }
fn downloadJsonFile(json_ptr: ptr, json_len: u64, filename_ptr: ptr, filename_len: u64) -> i32 { return 0; }
