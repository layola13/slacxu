struct PendingCodexProviderTest {
    is_null: bool,
    providerId_ptr: ptr, providerId_len: u64,
    prompt_ptr: ptr, prompt_len: u64,
}

struct UseProviderTestInput {
    state_json_ptr: ptr, state_json_len: u64,
    state_activeThreadId_is_null: bool,
    state_connected: bool,
    state_engine_phase_ptr: ptr, state_engine_phase_len: u64,
    dispatch_handle: u64,
    client_handle: u64,
    t_handle: u64,
    settingsOpen: bool,
    workspaceSelectionPending: bool,
    activeProviderId_ptr: ptr, activeProviderId_len: u64, activeProviderId_is_null: bool,
    reasoningEffort_ptr: ptr, reasoningEffort_len: u64,
    reasoningOptions_json_ptr: ptr, reasoningOptions_json_len: u64,
    splitMutationEpochRef: u64,
}

struct UseProviderTest {
    pendingCodexProviderTest: PendingCodexProviderTest,
}

// host callback stubs (supplied via input in TS)
// DEFECT: async — activateProvider(providerId, model?, groupId?): Promise<void> in TS.
fn activateProvider(providerId_ptr: ptr, providerId_len: u64, model_ptr: ptr, model_len: u64) -> i32 { return 0; }
fn startCodexTurn(text_ptr: ptr, text_len: u64, options_json_ptr: ptr, options_json_len: u64, out_ptr: ptr, out_len: &u64) -> i32 { return 0; }
fn fastReasoningEffort(options_json_ptr: ptr, options_json_len: u64, effort_ptr: ptr, effort_len: u64, out_ptr: ptr, out_len: &u64) -> i32 { return 0; }

// DEFECT: async — testProviderWithCodex(providerId, model?) in TS.
fn testProviderWithCodex(input: &UseProviderTestInput, s: &UseProviderTest, providerId_ptr: ptr, providerId_len: u64, model_ptr: ptr, model_len: u64) -> i32 {
    let rc = activateProvider(providerId_ptr, providerId_len, model_ptr, model_len);
    if rc != 0 { return rc; };
    // setSettingsOpen(false);
    input.settingsOpen = false;
    // setRuntimePermission("readonlyAsk"); setDangerBypassConfirmed(false);
    // updateNewConversationRuntimeSelection({ fastModeEnabled: true });
    // DEFECT: dynamic object patch { fastModeEnabled: true } approximated as JSON text buffer call.
    // setWorkspaceMode("local"); setWorkspaceSelectionPending(false); setWelcomeDismissed(true);
    input.splitMutationEpochRef = input.splitMutationEpochRef + 1;
    // setWorkspaceLayout(null); setSplitView(null);
    // dispatch({ type: "newConversation" });
    s.pendingCodexProviderTest = PendingCodexProviderTest {
        is_null: false,
        providerId_ptr: providerId_ptr, providerId_len: providerId_len,
        prompt_ptr: STR_PTR("CODEX_PROVIDER_TEST_PROMPT"), prompt_len: STR_LEN("CODEX_PROVIDER_TEST_PROMPT"),
    };
    return 0;
}

// useEffect(() => { ... }, [activeProviderId, pendingCodexProviderTest, reasoningEffort, reasoningOptions, settingsOpen, startCodexTurn, state.activeThreadId, state.connected, state.engine.phase, workspaceSelectionPending])
// DEFECT: useEffect dependency-array re-run semantics have no SLA counterpart; caller must invoke this check on every relevant change.
fn useProviderTest_effect(input: &UseProviderTestInput, s: &UseProviderTest) -> i32 {
    if s.pendingCodexProviderTest.is_null || input.settingsOpen || input.workspaceSelectionPending || !input.state_activeThreadId_is_null || input.activeProviderId_is_null || !(input.activeProviderId_len == s.pendingCodexProviderTest.providerId_len) || !input.state_connected || !(input.state_engine_phase_len == 5) {
        return 0;
    };
    let prompt_ptr = s.pendingCodexProviderTest.prompt_ptr;
    let prompt_len = s.pendingCodexProviderTest.prompt_len;
    s.pendingCodexProviderTest.is_null = true; // setPendingCodexProviderTest(null)
    // void startCodexTurn(prompt, [], [], { forceEffort: fastReasoningEffort(reasoningOptions, reasoningEffort) });
    let effort_ptr: ptr = STR_PTR(""); let effort_len: u64 = 0;
    fastReasoningEffort(input.reasoningOptions_json_ptr, input.reasoningOptions_json_len, input.reasoningEffort_ptr, input.reasoningEffort_len, effort_ptr, &effort_len);
    let out_ptr: ptr = STR_PTR(""); let out_len: u64 = 0;
    return startCodexTurn(prompt_ptr, prompt_len, effort_ptr, effort_len, out_ptr, &out_len);
}

fn useProviderTest(input: &UseProviderTestInput) -> UseProviderTest {
    let s = UseProviderTest { pendingCodexProviderTest: PendingCodexProviderTest { is_null: true, providerId_ptr: STR_PTR(""), providerId_len: 0, prompt_ptr: STR_PTR(""), prompt_len: 0 } };
    return s; // returns { pendingCodexProviderTest, setPendingCodexProviderTest, testProviderWithCodex }
}
