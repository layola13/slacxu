        // DEFECT: error class discrimination (instanceof) has no SLA counterpart; status/kind codes used.
        if rc == 2 { dispatch_action(input, STR_PTR("{\"type\":\"error\",\"message\":\"workspace.roots\"}"), STR_LEN("{\"type\":\"error\",\"message\":\"workspace.roots\"}")); return rc; };
        dispatch_action(input, STR_PTR("{\"type\":\"error\",\"message\":\"Workspace roots: \"}"), STR_LEN("{\"type\":\"error\",\"message\":\"Workspace roots: \"}"));
        return rc;
    };
    if input.cancelled { return 0; };
    // setLocalWorkspaceInfo(info); if (!workspaceSelectionPending) return;
    // nextDefault = defaultLocalWorkspacePath(info.platform, info.home, info.cwd, info.roots.map(root => root.path))
    // setCwd(current => current === DEFAULT_NEW_CHAT_CWD ? nextDefault : current); setWorkspacePickerPath(current => current === DEFAULT_LOCAL_WORKSPACE_PICKER_PATH ? nextDefault : current)
