// useEffect #1: setup guide timer
// DEFECT: useEffect + setTimeout has no SLA counterpart; host calls this when authStatus/preferencesReady change.
fn usePreferencesSync_effect_setupGuide(input: &UsePreferencesSyncInput) -> i32 {
    if !(input.authStatus_len == 13) || !input.preferencesReady || hasCompletedSetupGuide() { return 0; }; // authStatus !== "authenticated"
    input.setupGuideTimer_deadline_ms = 500; // window.setTimeout(() => setSetupGuideOpen(true), 500); cleanup clears it
    return 0;
}

// useEffect #2: load preferences once per token
