    if input.token_is_null || !input.preferencesReady { return 0; };
    input.cancelled = false;
    let info_ptr: ptr = STR_PTR(""); let info_len: u64 = 0;
    let rc = fetchWorkspaceRoots(input.token_ptr, input.token_len, info_ptr, &info_len);
