// Converted 1:1 from apps/web/src/app/workbench/useSessionRecovery.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "sa_std/io/print.sai"

// DEFECT: React hooks (useCallback/useEffect) have no SLA counterpart; effects modelled as explicit register/cleanup functions, dependency-array re-run semantics not reproduced.
// DEFECT: async function converted to synchronous function returning a status code.
// DEFECT: window.localStorage / document / window.setInterval have no sa_std counterpart; approximated as extern calls / state fields.
// DEFECT: dynamic object AuthSession approximated as JSON text buffer.

struct AuthSession {
    json_ptr: ptr,
    json_len: u64,
    authenticated: bool,
    loginRequired: bool,
    token_ptr: ptr,
    token_len: u64,
    token_is_null: bool,
}

struct UseSessionRecoveryInput {
    state_json_ptr: ptr,
    state_json_len: u64,
    // DEFECT: Dispatch<Parameters<typeof appReducer>[1]> function type has no SLA counterpart; dispatch modelled as an opaque handle + action JSON buffer.
    dispatch_handle: u64,
    t_handle: u64,
    authStatus_ptr: ptr,
    authStatus_len: u64,
    clientRef_is_null: bool,
    lastCheckedAt: u64,
    timer_id: u64,
}

fn dispatch_action(in: &UseSessionRecoveryInput, action_json_ptr: ptr, action_json_len: u64) -> i32 {
    // DEFECT: reducer dispatch is a caller-supplied closure in TS; here a no-op stub preserving call order.
    return 0;
}
fn client_disconnect(in: &UseSessionRecoveryInput) -> i32 { return 0; }
fn client_updateToken(in: &UseSessionRecoveryInput, token_ptr: ptr, token_len: u64) -> i32 { return 0; }
fn localStorage_getItem(key_ptr: ptr, key_len: u64, out_ptr: ptr, out_len: &u64) -> bool { return false; }
fn localStorage_setItem(key_ptr: ptr, key_len: u64, v_ptr: ptr, v_len: u64) -> i32 { return 0; }
fn localStorage_removeItem(key_ptr: ptr, key_len: u64) -> i32 { return 0; }
// DEFECT: async — fetchSessionToken(token) in TS returns Promise<AuthSession>; here synchronous + status code.
fn fetchSessionToken(token_ptr: ptr, token_len: u64, out: &AuthSession) -> i32 { return 0; }
fn legalReviewRequired(session: &AuthSession) -> bool { return false; }

fn handleSessionExpired(in: &UseSessionRecoveryInput, setAuthSession_null: bool, setAuthStatus_loginRequired: bool) -> i32 {
    // window.localStorage.removeItem(AUTH_TOKEN_STORAGE_KEY);
    localStorage_removeItem(STR_PTR("AUTH_TOKEN_STORAGE_KEY"), STR_LEN("AUTH_TOKEN_STORAGE_KEY"));
    // clientRef.current?.disconnect();
    // DEFECT: optional chaining ?. has no SLA counterpart; explicit null check used.
    if !in.clientRef_is_null { client_disconnect(in); };
    dispatch_action(in, STR_PTR("{\"type\":\"connected\",\"connected\":false}"), STR_LEN("{\"type\":\"connected\",\"connected\":false}"));
    dispatch_action(in, STR_PTR("{\"type\":\"token\",\"token\":null}"), STR_LEN("{\"type\":\"token\",\"token\":null}"));
    // setAuthSession(null); setAuthStatus("loginRequired");
    return 0;
}

// DEFECT: async — recoverOrExpireSession(): Promise<boolean> in TS; bool result returned directly, status via return value only.
fn recoverOrExpireSession(in: &UseSessionRecoveryInput, out_session: &AuthSession) -> bool {
    let token_ptr: ptr = STR_PTR("");
    let token_len: u64 = 0;
    let has_token = localStorage_getItem(STR_PTR("AUTH_TOKEN_STORAGE_KEY"), STR_LEN("AUTH_TOKEN_STORAGE_KEY"), token_ptr, &token_len);
    if !has_token {
        handleSessionExpired(in, true, true);
        return false;
    };
    let rc = fetchSessionToken(token_ptr, token_len, out_session);
    if rc != 0 {
        // catch (error): if (error instanceof LoginRequiredError) { handleSessionExpired(); return false; }
        // DEFECT: instanceof / exception class discrimination has no SLA counterpart; status code used instead.
        if rc == 1 { handleSessionExpired(in, true, true); return false; };
        // Network or proxy failure proves nothing about the session; keep it.
        return true;
    };
    if out_session.authenticated == false || out_session.loginRequired || out_session.token_is_null {
        handleSessionExpired(in, true, true);
        return false;
    };
    // setAuthSession(session);
    if out_session.token_len != token_len {
        localStorage_setItem(STR_PTR("AUTH_TOKEN_STORAGE_KEY"), STR_LEN("AUTH_TOKEN_STORAGE_KEY"), out_session.token_ptr, out_session.token_len);
        dispatch_action(in, STR_PTR("{\"type\":\"token\"}"), STR_LEN("{\"type\":\"token\"}"));
        if !in.clientRef_is_null { client_updateToken(in, out_session.token_ptr, out_session.token_len); };
    };
    if legalReviewRequired(out_session) {
        if !in.clientRef_is_null { client_disconnect(in); };
        dispatch_action(in, STR_PTR("{\"type\":\"connected\",\"connected\":false}"), STR_LEN("{\"type\":\"connected\",\"connected\":false}"));
        dispatch_action(in, STR_PTR("{\"type\":\"token\",\"token\":null}"), STR_LEN("{\"type\":\"token\",\"token\":null}"));
        // setAuthStatus("legalRequired");
        return false;
    };
    return true;
}

// useEffect(() => { ... }, [authStatus, recoverOrExpireSession]) converted as explicit registration.
// DEFECT: setInterval / visibilitychange listener / Date.now have no SLA counterpart; polling must be driven by the host.
fn useSessionRecovery_effect(in: &UseSessionRecoveryInput, now_ms: u64) -> i32 {
    if !(in.authStatus_len == 13) { return 0; }; // authStatus !== "authenticated" (length check approximation)
    // let lastCheckedAt = Date.now();
    in.lastCheckedAt = now_ms;
    // const timer = window.setInterval(refresh, SESSION_KEEPALIVE_INTERVAL_MS);
    // document.addEventListener("visibilitychange", refresh);
    return 0;
}

fn useSessionRecovery_refresh(in: &UseSessionRecoveryInput, now_ms: u64, document_hidden: bool, out_session: &AuthSession) -> bool {
    if document_hidden { return false; };
    // Alt-tabbing must not turn into a burst of session calls.
    // if (Date.now() - lastCheckedAt < SESSION_KEEPALIVE_MIN_INTERVAL_MS) return;
    if now_ms - in.lastCheckedAt < 60000 { return false; };
    in.lastCheckedAt = now_ms;
    // void recoverOrExpireSession();
    return recoverOrExpireSession(in, out_session);
}

fn useSessionRecovery_cleanup(in: &UseSessionRecoveryInput) -> i32 {
    // window.clearInterval(timer); document.removeEventListener("visibilitychange", refresh);
    return 0;
}

fn useSessionRecovery(in: &UseSessionRecoveryInput, out_session: &AuthSession) -> i32 {
    return 0; // returns { handleSessionExpired, recoverOrExpireSession } — function family above.
}
