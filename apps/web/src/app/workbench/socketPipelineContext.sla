    errorTurnIds_json: [u8; 8192], errorTurnIds_json_len: u64, // Set<string> as JSON; DEFECT: Set
}

// ---- socketPipelineContext.ts:37-46 — type FreeCompactionWaiter ----
// DEFECT: Promise resolve/reject/cancel callback triple; approximated as
// handler handles plus a settlement status field.
struct FreeCompactionWaiter {
    resolve: u64,                               // () => void — handler handle
    reject: u64,                                // (error: Error) => void — handler handle
    cancel: u64,                                // () => void — handler handle
    turnId: [u8; 128], turnId_len: u64, has_turnId: bool, // string?
    providerId: [u8; 128], providerId_len: u64, // string
    model: [u8; 256], model_len: u64,           // string
    contextWindow: u64, has_contextWindow: bool, // number | null
}

// ---- socketPipelineContext.ts:48-52 — type CompactionSource ----
struct CompactionSource {
    source: [u8; 16], source_len: u64,          // "free" | "native"
    providerId: [u8; 128], providerId_len: u64, // string
    model: [u8; 256], model_len: u64,           // string
}

