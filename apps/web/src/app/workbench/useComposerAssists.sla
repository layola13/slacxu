struct StrBuf {
    bytes: [u8; 8192], len: u64,
}

struct JsonBuf {
    bytes: [u8; 32768], len: u64,  // DEFECT: dynamic object
}

// ---- useComposerAssists.ts:60-96 — extended hook input ----
// DEFECT: GoalLifecycle[...] indexed picks, Extract<...> (in runImageCommand),
// Map<string, AbortController> and Set refs — handler handles / JSON buffers.
struct UseComposerAssistsInputExtra {
    startCodexTurn: u64,                        // (text, images, mentions, options?) => Promise<string | null>; DEFECT: async
    disablePlanAutoContinuation: u64,           // (threadId?: string) => void
    planModeEnabled: bool,
    planModeEnabledRef_current: bool,           // MutableRefObject<boolean>
    planImplementationPrompt_json: JsonBuf, has_planImplementationPrompt: bool, // PlanImplementationPrompt | null
    setPlanImplementationPrompt: u64,
    autoContinuePlanThreadsRef_json: JsonBuf,   // MutableRefObject<Set<string>> — DEFECT: Set
    handledPlanTurnIdsRef_json: JsonBuf,        // MutableRefObject<Set<string>>
    handledPlanImplementationIdsRef_json: JsonBuf, // MutableRefObject<Set<string>>
    planContinuationInFlightRef_json: JsonBuf,  // MutableRefObject<Set<string>>
    transcriptRuntime: u64,                     // ReturnType<typeof useTopicTranscriptRuntime> (mergeTurn/mergeSnapshot/replaceTurn used)
    connectedRef_current: bool,
    pendingRequestsRef_json: JsonBuf,           // MutableRefObject<ClientState["pendingRequests"]>
    threadGoals_json: JsonBuf,                  // Record<string, GoalBannerState>
    setThreadGoal: u64,                         // GoalLifecycle["setGoal"]; DEFECT: async
    clearActiveGoal: u64,                       // GoalLifecycle["clearActiveGoal"]
    setActiveGoalStatus: u64,                   // GoalLifecycle["setGoalStatus"]
    loadThread: u64,                            // (threadId, selectionEpoch?) => Promise<boolean>
    ensureActiveThread: u64,                    // () => Promise<string>
    isMiniBackend: bool,
    loadThreadIntoCache: u64,                   // (threadId) => Promise<void>
    openSettings: u64,
    requestNewSession: u64,                     // (permission: PermissionPresetId) => void
    setHistorySearchTerm: u64,
    setLeftPanelVisible: u64,
    setStatsPanelScope: u64,
    setWelcomeDismissed: u64,
    startCodexTurnRef: u64, has_startCodexTurnRef: bool, // MutableRefObject<startCodexTurn fn>
    imageJobsRef_json: JsonBuf,                 // MutableRefObject<Map<string, AbortController>> — DEFECT: Map + AbortController
    renameCliBackendFor: u64,                   // (threadId) => CliBackend | undefined
    providersRef_json: JsonBuf,                 // MutableRefObject<ProviderConfig[]>
    // Also destructured from ComposerCoreInput (lines 113-114): authSession,
    // imageRuntimeSelection, historySelectionForThread, updateRuntimeSelection,
    // updateImageRuntimeSelection, setThreadRuntimePersistencePaused,
    // awaitThreadRuntimePersistence.
}

