// Converted 1:1 from apps/web/src/app/workbench/useComposerAssists.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
// Hook returning 12 assist callbacks (plan continuation, goal, rename,
// review, diff, compact, resume, image command, server-request answers).
// DEFECT: React hooks semantics — plain functions over the input bundle.
// DEFECT: async — synchronous + status codes; errors dispatch via the
// dispatch handle / err buffer. Timers (window.setTimeout/clearTimeout),
// Set refs, AbortController map, crypto.randomUUID and Date.now are
// placeholders; dynamic JSON params are JSON text buffers.

@import "sa_std/io/print.sai"
@import "sa_std/string.sa"

