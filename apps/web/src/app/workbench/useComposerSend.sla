struct StrBuf {
    bytes: [u8; 8192], len: u64,
}

struct JsonBuf {
    bytes: [u8; 32768], len: u64,  // DEFECT: dynamic object
}

// ---- useComposerSend.ts:61-98 — extended hook input ----
// ComposerCoreInput & { ... }: extra fields beyond the core bundle.
// DEFECT: ReturnType<typeof useComposerAssists>[...] picks and
// GoalLifecycle[...] indexed types — handler handles.
struct UseComposerSendInputExtra {
    startCodexTurn: u64,                        // (text, images, mentions, options?) => Promise<string | null>; DEFECT: async
    ensureActiveThread: u64,                    // () => Promise<string>; DEFECT: async
    planModeEnabled: bool,
    isMiniBackend: bool,
    resumeThreadFromSlash: u64,                 // useComposerAssists picks — handler handles
    compactActiveThread: u64,
    startReview: u64,
    runImageCommand: u64,
    renameActiveThread: u64,
    setGoalForActiveThread: u64,
    showDiffToRemote: u64,
    sideChatTabs_json: JsonBuf,                 // SideChatTab[]
    setSideChatTabs: u64,                       // Dispatch<SetStateAction<SideChatTab[]>>
    setSideChatError: u64,                      // Dispatch<SetStateAction<string | null>>
    sideChatInFlightRef_json: JsonBuf,          // MutableRefObject<Set<string>> — DEFECT: Set
    setRightWorkspaceTab: u64,
    setRightWorkspaceVisible: u64,
    threadTokenUsage_json: JsonBuf,             // Record<string, ThreadTokenUsageState>
    transcriptRuntime: u64,                     // ReturnType<typeof useTopicTranscriptRuntime>
    setActiveGoalStatus: u64,                   // GoalLifecycle["setGoalStatus"]; DEFECT: async calls
    disablePlanAutoContinuation: u64,           // (threadId?: string) => void
    threadGoals_json: JsonBuf,                  // Record<string, GoalBannerState>
    setWelcomeDismissed: u64,
    setStatsPanelScope: u64,                    // Dispatch<SetStateAction<"status" | "stats" | null>>
    requestNewSession: u64,                     // (permission: PermissionPresetId) => void
    openSettings: u64,                          // (section?, pluginTab?, relayTarget?) => void
    clearActiveGoal: u64,                       // GoalLifecycle["clearActiveGoal"]
    providersRef_json: JsonBuf,                 // MutableRefObject<ProviderConfig[]>
    freeCompactBarrierRef: u64, has_freeCompactBarrierRef: bool, // MutableRefObject<(() => Promise<void>) | null>
    jevCompressDirectiveRef: u64, has_jevCompressDirectiveRef: bool, // MutableRefObject<((options?) => Promise<string | void>) | null>
    // Also destructured from ComposerCoreInput in this file (lines 122-123):
    // authSession, imageRuntimeSelection, historySelectionForThread,
    // updateRuntimeSelection, updateImageRuntimeSelection,
    // setThreadRuntimePersistencePaused, awaitThreadRuntimePersistence.
}

// ComposerSlashCommand approximated as JSON + its `type` tag.
struct ComposerSlashCommand {
    json: JsonBuf,
    type_tag: [u8; 32], type_len: u64,          // "image" | "fast" | "stats" | "assistantTurn" | "plan" | "goal" | "rename" | "review" | "diff" | "compact" | "resumeThread" | "newConversation" | "openSettings" | "openWorkspace" | "unsupported"
}

fn str_eq(a_ptr: ptr, a_len: u64, b_ptr: ptr, b_len: u64) -> bool {
    // REBOUND (2026-10-26, sa_std ts sweep): hand byte-scan replaced by
    // sa_std/ts_string.sa @ts_str_equals; original signature preserved 1:1.
    return @ts_str_equals(a_ptr, a_len, b_ptr, b_len);
}

// ---- useComposerSend.ts:137-253 — handleComposerSlashCommand ----
// Switch over command.type; every case returns after its action.
// Field reads per case (from the command JSON): image -> runImageCommand(
// command, images); fast -> updateRuntimeSelection({ fastModeEnabled:
// command.enabled ?? !fastModeEnabled }); stats -> setStatsPanelScope(
// command.scope); assistantTurn -> startCodexTurn(command.prompt, ...);
// plan -> toggle: (planModeEnabled ? disablePlanAutoContinuation() : noop) +
// updateRuntimeSelection({ planModeEnabled: !planModeEnabled }); on/off
// analogues; default plan-with-prompt: updateRuntimeSelection({ planModeEnabled:
// true }) + startCodexTurn(prompt, ..., { collaborationMode: "plan",
// enablePlanAutoContinuation: true });
// goal -> set: setGoalForActiveThread(command.objective); clear:
// clearActiveGoal(); pause/resume/complete: setActiveGoalStatus("paused" /
// "active" / "complete"); edit: existing = threadGoals[state.activeThreadId],
// setComposerSuggestion({ id: `goal-edit-${Date.now()}`, text: existing ?
// `/goal ${existing.objective}` : "/goal " }); fallthrough: setStatsPanelScope("status");
// rename -> renameActiveThread(command.name); review -> parseReviewCommand(
// command.value) then startReview(review.target, review.delivery);
// diff -> showDiffToRemote(); compact -> compactActiveThread();
// resumeThread -> resumeThreadFromSlash(command.threadId);
// newConversation -> requestNewSession(command.permission ?? permission);
// openSettings -> openSettings(command.section, command.pluginTab);
// openWorkspace -> setRightWorkspaceTab(command.tab) + setRightWorkspaceVisible(true);
// unsupported -> claude/agy/grok/pi/opencode/opencode-v2 backends forward
// startCodexTurn(`/${command.name}`, ...) (CLI-native handling, source
// comment), otherwise setSlashNotice({ id: `unsupported-slash-${Date.now()}`,
// title: `/${command.name} is not available in Web`, message: "This Codex
// command requires a TUI-only workflow or a Web equivalent that is not
// implemented yet.", severity: "warning" }).
// DEFECT: async — status code; handler invocations deferred (handles above).
fn useComposerSend_handleComposerSlashCommand(core_json_ptr: ptr, core_json_len: u64, extra: &UseComposerSendInputExtra, command: &ComposerSlashCommand, images_json_ptr: ptr, images_json_len: u64, mentions_json_ptr: ptr, mentions_json_len: u64) -> i32 {
    // dispatch on command.type_tag — branch skeleton (bodies via handles):
    if str_eq(&command.type_tag, command.type_len, STR_PTR("image"), STR_LEN("image")) {
        return 0; // await runImageCommand(command, images)
    };
    if str_eq(&command.type_tag, command.type_len, STR_PTR("fast"), STR_LEN("fast")) {
        return 0; // updateRuntimeSelection({ fastModeEnabled: ... })
    };
    if str_eq(&command.type_tag, command.type_len, STR_PTR("stats"), STR_LEN("stats")) {
        return 0; // setStatsPanelScope(command.scope)
    };
    if str_eq(&command.type_tag, command.type_len, STR_PTR("assistantTurn"), STR_LEN("assistantTurn")) {
        return 0; // await startCodexTurn(command.prompt, images, mentions)
    };
    if str_eq(&command.type_tag, command.type_len, STR_PTR("plan"), STR_LEN("plan")) {
        return 0; // toggle/on/off/prompt branches (see header)
    };
    if str_eq(&command.type_tag, command.type_len, STR_PTR("goal"), STR_LEN("goal")) {
        return 0; // set/clear/pause/resume/complete/edit branches (see header)
    };
    if str_eq(&command.type_tag, command.type_len, STR_PTR("rename"), STR_LEN("rename")) {
        return 0; // await renameActiveThread(command.name)
    };
    if str_eq(&command.type_tag, command.type_len, STR_PTR("review"), STR_LEN("review")) {
        return 0; // parseReviewCommand + await startReview(target, delivery)
    };
    if str_eq(&command.type_tag, command.type_len, STR_PTR("diff"), STR_LEN("diff")) {
        return 0; // await showDiffToRemote()
    };
    if str_eq(&command.type_tag, command.type_len, STR_PTR("compact"), STR_LEN("compact")) {
        return 0; // await compactActiveThread()
    };
    if str_eq(&command.type_tag, command.type_len, STR_PTR("resumeThread"), STR_LEN("resumeThread")) {
        return 0; // await resumeThreadFromSlash(command.threadId)
    };
    if str_eq(&command.type_tag, command.type_len, STR_PTR("newConversation"), STR_LEN("newConversation")) {
        return 0; // requestNewSession(command.permission ?? permission)
    };
    if str_eq(&command.type_tag, command.type_len, STR_PTR("openSettings"), STR_LEN("openSettings")) {
        return 0; // openSettings(command.section, command.pluginTab)
    };
    if str_eq(&command.type_tag, command.type_len, STR_PTR("openWorkspace"), STR_LEN("openWorkspace")) {
        return 0; // setRightWorkspaceTab(command.tab); setRightWorkspaceVisible(true)
    };
    // "unsupported"
    return 0; // backend forward or slash notice (see header)
}

