@import "sa_std/io/print.sai"

// DEFECT: React hooks (useCallback/useEffect/useLayoutEffect/useMemo/useRef/useState) have no SLA counterpart; this composition hook modelled as one init function + explicit effect functions the host must call in source order.
// DEFECT: nested hook composition (useThreadRuntimeSelections / useFreeCompactionSelection / useFreebuffSession / useCliInstallations / useSessionRecovery / useI18n / useIsMobile / MUI useMediaQuery) has no SLA counterpart; each sub-hook represented by its own converted unit and flattened field sets here.
// DEFECT: dynamic objects / sub-hook return objects approximated as JSON text buffers + named scalar fields.
// DEFECT: async sub-hook functions converted to synchronous functions returning a status code (see their own units).

struct UseSelectionRuntimeInput {
    state_json_ptr: ptr, state_json_len: u64,
    token_ptr: ptr, token_len: u64, token_is_null: bool,
    activeThreadId_ptr: ptr, activeThreadId_len: u64, activeThreadId_is_null: bool,
    providers_json_ptr: ptr, providers_json_len: u64,
    engine_codexVersion_ptr: ptr, engine_codexVersion_len: u64,
    dispatch_handle: u64,
    themeMode_handle: u64, customThemePlugins_handle: u64,
    detachedThreadId_ptr: ptr, detachedThreadId_len: u64, detachedThreadId_is_null: bool,
    // access domain (ReturnType<typeof useAccessRuntime>) — flattened
    authStatus_ptr: ptr, authStatus_len: u64,
    authSession_json_ptr: ptr, authSession_json_len: u64, authSession_is_null: bool,
    authSession_user_json_ptr: ptr, authSession_user_json_len: u64, authSession_user_is_null: bool,
    authSession_user_role_is_admin: bool,
    authSession_user_allowDangerBypass: bool,
    authSession_user_allowWrite: bool,
    authSession_user_maxPermission_ptr: ptr, authSession_user_maxPermission_len: u64,
    authSession_user_workspaceRoot_ptr: ptr, authSession_user_workspaceRoot_len: u64, authSession_user_workspaceRoot_is_null: bool,
    dangerBypassConfirmed: bool,
    workspaceMode_ptr: ptr, workspaceMode_len: u64,
    cwd_ptr: ptr, cwd_len: u64,
    workspaceSelectionPending: bool,
    // taskTabs domain (ReturnType<typeof useTaskTabsRuntime>) — flattened flags
    codexCliEnabled: bool, claudeCliEnabled: bool, agyCliEnabled: bool, auggieCliEnabled: bool,
    clineCliEnabled: bool, commandCodeCliEnabled: bool, grokCliEnabled: bool, museCliEnabled: bool,
    piCliEnabled: bool, opencodeCliEnabled: bool, opencodeV2CliEnabled: bool,
    // threadWorkspace domain (ReturnType<typeof useThreadWorkspaceRuntime>) — flattened refs
    activeThreadIdRef_ptr: ptr, activeThreadIdRef_len: u64, activeThreadIdRef_is_null: bool,
    clientRef_is_null: bool,
    imageJobs_count: u64,
    modelCapacityRetry_count: u64,
}

struct UseSelectionRuntime {
    // useThreadRuntimeSelections domain — fields kept in the sub-unit's struct; summary scalars mirrored here
    runtime_cliBackend_ptr: ptr, runtime_cliBackend_len: u64,
    runtime_providerId_ptr: ptr, runtime_providerId_len: u64, runtime_providerId_is_null: bool,
    runtime_groupId_ptr: ptr, runtime_groupId_len: u64, runtime_groupId_is_null: bool,
    selectedModel_ptr: ptr, selectedModel_len: u64,
    reasoningEffort_ptr: ptr, reasoningEffort_len: u64,
    fastModeEnabled: bool,
    planModeEnabled: bool,
    planModeEnabledRef: bool,
    permission_ptr: ptr, permission_len: u64,
    vmEnabled: bool,
    compactTools_json_ptr: ptr, compactTools_json_len: u64, compactTools_is_null: bool,
    isClaudeBackend: bool, isAgyBackend: bool, isGrokBackend: bool, isMuseBackend: bool,
    isPiBackend: bool, isOpencodeBackend: bool, isOpencodeV2Backend: bool, isCodexBackend: bool, isMiniBackend: bool,
    dangerBypassPermissionConfirmed: bool,
    newChatDefaultsAppliedRef: bool,
    desktopLayout: bool,
    isMobile: bool,
    allowedPermissions_json_ptr: ptr, allowedPermissions_json_len: u64,
}

// Sub-hook entry points (defined in their own converted units):
// useThreadRuntimeSelections({ token, activeThreadId }) -> ThreadRuntimeSelectionsDomain (23 fields/fns)
// useFreeCompactionSelection({ state, dispatch, runtimeSelection, selectedModel, setSlashNotice, freeAutoCompactBusyRef, workspaceMode, setFreeModelAccessOpen, selectionForThread, updateRuntimeSelectionForKey }) -> 20 fields
// useFreebuffSession({ state, dispatch, activeThreadIdRef, setSlashNotice, updateNewConversationRuntimeSelection, setSelectedModel }) -> 19 fields
// useCliInstallations({ token, cliBackend, codexVersion, t }) -> 15 fields
// useSessionRecovery({ state, dispatch, t, authStatus, setAuthStatus, setAuthSession, clientRef }) -> { handleSessionExpired, recoverOrExpireSession } (see useSessionRecovery.sla)
// useI18n() -> { locale, setLocale, t }; useIsMobile(); useMediaQuery("(min-width:900px)")

fn isClaudeCliBackend(v_ptr: ptr, v_len: u64) -> bool { return v_len == 6; }
fn isCodexCliBackend(v_ptr: ptr, v_len: u64) -> bool { return v_len == 5; }
fn permissionRank(perm_ptr: ptr, perm_len: u64) -> u64 {
    if perm_len == 11 { return 0; }; // readonlyAsk
    if perm_len == 12 { return 1; }; // workspaceAsk (also dangerBypass length — host disambiguates by content)
    if perm_len == 7 { return 2; };  // fullAsk
    return 3; // dangerBypass
}

fn useSelectionRuntime(input: &UseSelectionRuntimeInput) -> UseSelectionRuntime {
    let s = UseSelectionRuntime {
        runtime_cliBackend_ptr: STR_PTR("mini"), runtime_cliBackend_len: 4,
        runtime_providerId_ptr: STR_PTR(""), runtime_providerId_len: 0, runtime_providerId_is_null: true,
        runtime_groupId_ptr: STR_PTR(""), runtime_groupId_len: 0, runtime_groupId_is_null: true,
        selectedModel_ptr: STR_PTR(""), selectedModel_len: 0,
        reasoningEffort_ptr: STR_PTR(""), reasoningEffort_len: 0,
        fastModeEnabled: false, planModeEnabled: false, planModeEnabledRef: false,
        permission_ptr: STR_PTR(""), permission_len: 0,
        vmEnabled: false,
        compactTools_json_ptr: STR_PTR(""), compactTools_json_len: 0, compactTools_is_null: true,
        isClaudeBackend: false, isAgyBackend: false, isGrokBackend: false, isMuseBackend: false,
        isPiBackend: false, isOpencodeBackend: false, isOpencodeV2Backend: false, isCodexBackend: false, isMiniBackend: true,
        dangerBypassPermissionConfirmed: false,
        newChatDefaultsAppliedRef: false,
        desktopLayout: false, isMobile: false,
        allowedPermissions_json_ptr: STR_PTR("[]"), allowedPermissions_json_len: 2,
    };
    // L0 capability gating comment from source: compactTools = runtimeSelection.vmPolicy?.tools; vmEnabled = runtimeSelection.vmEnabled; selectedModel = runtimeSelection.model;
    // DEFECT: optional chaining ?. has no SLA counterpart.
    // Backend flags: isXBackend = isXCliBackend(runtimeSelection.cliBackend) && xCliEnabled, for claude/agy/grok/muse/pi/opencode/opencode-v2/codex
    s.isClaudeBackend = isClaudeCliBackend(s.runtime_cliBackend_ptr, s.runtime_cliBackend_len) && input.claudeCliEnabled;
    s.isCodexBackend = isCodexCliBackend(s.runtime_cliBackend_ptr, s.runtime_cliBackend_len) && input.codexCliEnabled;
    // isMiniBackend = isMiniCliBackend(...) || (!isCodex && !isClaude && !isAgy && !isGrok && !isMuse && !isPi && !isOpencode && !isOpencodeV2)
    s.isMiniBackend = !s.isCodexBackend && !s.isClaudeBackend && !s.isAgyBackend && !s.isGrokBackend && !s.isMuseBackend && !s.isPiBackend && !s.isOpencodeBackend && !s.isOpencodeV2Backend;
    // reasoningEffort / fastModeEnabled / planModeEnabled read from runtimeSelection; planModeEnabledRef.current = planModeEnabled (assignment during render in TS — DEFECT: render-phase ref mutation has no SLA counterpart)
    s.planModeEnabledRef = s.planModeEnabled;
    // dangerBypassPermissionConfirmed = permission === "dangerBypass" && (runtimeSelection.dangerBypassConfirmed || dangerBypassConfirmed)
    s.dangerBypassPermissionConfirmed = s.permission_len == 12 && (s.dangerBypassPermissionConfirmed || input.dangerBypassConfirmed);
    // desktopLayout = useMediaQuery("(min-width:900px)"); isMobile = useIsMobile(); { locale, setLocale, t } = useI18n(); translateRef.current = t;
    return s;
}

fn handleNewConversationCliBackend(s: &UseSelectionRuntime, input: &UseSelectionRuntimeInput, value_ptr: ptr, value_len: u64) -> i32 {
    // updateRuntimeSelection(resolveCliBackendSelection({ value, currentProviderId: runtimeSelection.providerId, currentGroupId: runtimeSelection.groupId, currentModel: runtimeSelection.model, providers: state.providers }))
