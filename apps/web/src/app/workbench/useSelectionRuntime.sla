// useEffect: if (!codexCliEnabled && runtimeSelection.cliBackend === "codex") updateRuntimeSelection({ cliBackend: "mini" });
fn useSelectionRuntime_effect_codexDisabled(s: &UseSelectionRuntime, input: &UseSelectionRuntimeInput) -> i32 {
    if !input.codexCliEnabled && s.runtime_cliBackend_len == 5 { s.runtime_cliBackend_ptr = STR_PTR("mini"); s.runtime_cliBackend_len = 4; };
    return 0;
}

