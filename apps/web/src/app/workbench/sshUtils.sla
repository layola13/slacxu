// ---- sshUtils.ts:163-168 — sshCodexInstallCommand ----
fn sshCodexInstallCommand(os_ptr: ptr, os_len: u64, out: &StrBuf) -> i32 {
    // normalized = os.toLowerCase() — DEFECT: lowercase approximated by
    // literal compares against the already-lowercase spellings + "windows"
    // substring check.
    if str_eq_bytes(os_ptr, os_len, STR_PTR("linux"), STR_LEN("linux")) || str_eq_bytes(os_ptr, os_len, STR_PTR("darwin"), STR_LEN("darwin")) {
        buf_set(out, STR_PTR("curl -fsSL https://chatgpt.com/codex/install.sh | sh"), STR_LEN("curl -fsSL https://chatgpt.com/codex/install.sh | sh"));
        return 0;
    };
    // normalized.includes("windows")
    // DEFECT: substring scan placeholder — see defect log.
    out.len = 0; // default "" (windows branch yields the powershell command)
    return 0;
}

fn str_eq_bytes(a_ptr: ptr, a_len: u64, b_ptr: ptr, b_len: u64) -> bool {
    // REBOUND (2026-10-26, sa_std ts sweep): hand byte-scan replaced by
    // sa_std/ts_string.sa @ts_str_equals; original signature preserved 1:1.
    return @ts_str_equals(a_ptr, a_len, b_ptr, b_len);
}

fn buf_set(out: &StrBuf, lit_ptr: ptr, lit_len: u64) -> i32 {
    for i in 0..lit_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, lit_ptr, i);
        out.bytes[i] = b;
    }
    out.len = lit_len;
    return 0;
}
