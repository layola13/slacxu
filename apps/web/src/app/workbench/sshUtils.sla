struct StrBuf {
    bytes: [u8; 512], len: u64,
}

struct JsonBuf {
    bytes: [u8; 16384], len: u64,   // DEFECT: dynamic object — JsonValue as JSON text buffer
}

// Placeholder for fetch(url, init) + response.json(): fills out_status
// (HTTP status) and out_body (JSON text). Returns 0 on transport success.
fn sa_http_fetch_json(method_ptr: ptr, method_len: u64, url_ptr: ptr, url_len: u64, token_ptr: ptr, token_len: u64, body_ptr: ptr, body_len: u64, out_status: &u64, out_body: &JsonBuf) -> i32 {
    *out_status = 0;
    out_body.len = 0;
    return 1; // DEFECT: no fetch implementation in this pass
}

// ---- sshUtils.ts:6-12 — normalizeSshWorkspaceCwd ----
// trim; strip trailing '/' run; empty result -> "/" (unless input was empty).
fn normalizeSshWorkspaceCwd(value_ptr: ptr, value_len: u64, out: &StrBuf) -> i32 {
    // trimmed range [start, end)
    let start: u64 = 0;
    let end = value_len;
    while start < end {
        let b: u8 = 0;
        PTR_BYTE_AT(b, value_ptr, start);
        if b == 32 || b == 9 || b == 10 || b == 13 {
            start = start + 1;
        } else {
            start = end;
        };
    }
    while end > start {
        let b2: u8 = 0;
        PTR_BYTE_AT(b2, value_ptr, end - 1);
        if b2 == 32 || b2 == 9 || b2 == 10 || b2 == 13 {
            end = end - 1;
        } else {
            end = start;
        };
    }
    if start >= end {
        out.len = 0;
        return 0;
    };
    // trimmed.replace(/\/+$/, "")
    while end > start {
        let b3: u8 = 0;
        PTR_BYTE_AT(b3, value_ptr, end - 1);
        if b3 == 47 {
            end = end - 1;
        } else {
            end = start - 1;
        };
    }
    if end <= start {
        // || "/"
        out.bytes[0] = 47;
        out.len = 1;
        return 0;
    };
    let n = end - start;
    for i in 0..n {
        let b4: u8 = 0;
        PTR_BYTE_AT(b4, value_ptr, start + i);
        out.bytes[i] = b4;
    }
    out.len = n;
    return 0;
}

// ---- sshUtils.ts:14-16 — isSshWorkspaceCommand ----
fn isSshWorkspaceCommand(value_ptr: ptr, value_len: u64) -> bool {
    // value.trim().startsWith("ssh ") || value.trim() === "ssh"
    let trimmed = StrBuf { bytes: [0u8; 512], len: 0 };
    // reuse trim logic via normalize-free local copy: leading/trailing spaces
    let start: u64 = 0;
    let end = value_len;
    while start < end {
        let b: u8 = 0;
        PTR_BYTE_AT(b, value_ptr, start);
        if b == 32 || b == 9 || b == 10 || b == 13 {
            start = start + 1;
        } else {
            start = end;
        };
    }
    while end > start {
        let b2: u8 = 0;
        PTR_BYTE_AT(b2, value_ptr, end - 1);
        if b2 == 32 || b2 == 9 || b2 == 10 || b2 == 13 {
            end = end - 1;
        } else {
            end = start;
        };
    }
    let n = end - start;
    if n == 3 {
        let a: u8 = 0;
        PTR_BYTE_AT(a, value_ptr, start);
        let b3: u8 = 0;
        PTR_BYTE_AT(b3, value_ptr, start + 1);
        let c: u8 = 0;
        PTR_BYTE_AT(c, value_ptr, start + 2);
        return a == 115 && b3 == 115 && c == 104; // "ssh"
    };
    if n > 4 {
        let a2: u8 = 0;
        PTR_BYTE_AT(a2, value_ptr, start);
        let b4: u8 = 0;
        PTR_BYTE_AT(b4, value_ptr, start + 1);
        let c2: u8 = 0;
        PTR_BYTE_AT(c2, value_ptr, start + 2);
        let d: u8 = 0;
        PTR_BYTE_AT(d, value_ptr, start + 3);
        return a2 == 115 && b4 == 115 && c2 == 104 && d == 32; // "ssh "
    };
    return false;
}

