// DEFECT: async — synchronous + status code. Returns 0 ok; error message in
// err (TS: throw new Error(stringValue(asRecord(body).error) ?? `SSH directory read failed: ${status}`)).
fn fetchSshDirectory(token_ptr: ptr, token_len: u64, command_ptr: ptr, command_len: u64, path_ptr: ptr, path_len: u64, out_body: &JsonBuf, err: &StrBuf) -> i32 {
    let status: u64 = 0;
    // POST /api/ssh/list-directory, headers Content-Type: application/json + x-codex-ui-token,
    // body JSON.stringify({ command, path }); body = await response.json().catch(() => ({}))
    sa_http_fetch_json(STR_PTR("POST"), STR_LEN("POST"), STR_PTR("/api/ssh/list-directory"), STR_LEN("/api/ssh/list-directory"), token_ptr, token_len, command_ptr, command_len, &status, out_body);
    // if (!response.ok) throw ...
    if status < 200 || status >= 300 {
        err.len = 0; // DEFECT: error text extraction via asRecord/stringValue deferred
        return 1;
    };
    return 0;
}

