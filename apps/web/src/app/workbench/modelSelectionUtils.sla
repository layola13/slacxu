    let overrides = PermissionTurnOverrides { sandbox: [0u8; 128], sandbox_len: 0, approvalPolicy: [0u8; 128], approvalPolicy_len: 0, sandboxPolicy_json: [0u8; 1024], sandboxPolicy_json_len: 0 };
    permissionToTurnOverrides(&input.permission, input.permission_len, &input.cwd, input.cwd_len, &input.additionalRoots_json, input.additionalRoots_json_len, &overrides);
    // threadStart = { cwd, sandbox, approvalPolicy, sessionStartSource: "startup", historyMode: "legacy" }
    // turnStart   = { cwd, sandboxPolicy, approvalPolicy, effort }
    // DEFECT: JSON assembled as text; key insertion order follows the source.
    out_json.len = 0;
    // (serialization body deferred to the shared JSON writer; structure kept:)
    // if (input.model) { threadStart.model = model; turnStart.model = model; }
    // if (input.modelProvider) { threadStart.modelProvider = modelProvider; }
    // budget = Number(input.budgetLimit); if finite && > 0 { threadStart.uiBudgetLimit = budget; }
    // if (workspaceMode === "ssh") { workspace = { type: "ssh", command: sshCommand.trim(), cwd }; both get .workspace }
    // return { "thread/start": threadStart, "turn/start": turnStart }
    return 0;
}

// ---- modelSelectionUtils.ts:59-74 — resolveSelectedModel ----
// Result written to out_model. groupId default null in TS (default parameter).
fn resolveSelectedModel(providers: &ProviderConfig, providers_len: u64, activeProviderId_ptr: ptr, activeProviderId_len: u64, has_activeProviderId: bool, selectedModel_ptr: ptr, selectedModel_len: u64, activeGroupId_ptr: ptr, activeGroupId_len: u64, has_activeGroupId: bool, out_model: &StrBuf) -> i32 {
    if has_activeProviderId && str_eq(activeProviderId_ptr, activeProviderId_len, STR_PTR("agy-official"), STR_LEN("agy-official")) {
        if selectedModel_len > 0 {
            buf_set_lit(out_model, selectedModel_ptr, selectedModel_len);
        } else {
            buf_set_lit(out_model, STR_PTR("gemini-3.8-flash-high"), STR_LEN("gemini-3.8-flash-high"));
        };
        return 0;
    };
    if has_activeProviderId && str_eq(activeProviderId_ptr, activeProviderId_len, STR_PTR("grok-official"), STR_LEN("grok-official")) {
        if selectedModel_len > 0 {
            buf_set_lit(out_model, selectedModel_ptr, selectedModel_len);
        } else {
            buf_set_lit(out_model, STR_PTR("grok-4.6"), STR_LEN("grok-4.6"));
        };
        return 0;
    };
    if has_activeProviderId && str_eq(activeProviderId_ptr, activeProviderId_len, STR_PTR("pi-relay"), STR_LEN("pi-relay")) {
        if selectedModel_len > 0 {
            buf_set_lit(out_model, selectedModel_ptr, selectedModel_len);
        } else {
            buf_set_lit(out_model, STR_PTR("pi-relay/default"), STR_LEN("pi-relay/default"));
        };
        return 0;
    };
    // const provider = providers.find(entry => entry.id === activeProviderId)
    for i in 0..providers_len {
        // DEFECT: providers passed as base pointer + count stands in for ProviderConfig[]
        let p = &providers;
        if has_activeProviderId && str_eq(&p.id, p.id_len, activeProviderId_ptr, activeProviderId_len) {
            let sel = RelayTextRuntimeSelection { model: StrBuf { bytes: [0u8; 512], len: 0 }, groupId: StrBuf { bytes: [0u8; 512], len: 0 }, has_groupId: false };
            resolveRelayTextRuntimeSelection(p, activeGroupId_ptr, activeGroupId_len, has_activeGroupId, selectedModel_ptr, selectedModel_len, &sel);
            *out_model = sel.model;
            return 0;
        };
    }
    // if (!provider) return selectedModel;
    buf_set_lit(out_model, selectedModel_ptr, selectedModel_len);
    return 0;
}

// ---- modelSelectionUtils.ts:76-79 — modelSelectionMatches ----
fn modelSelectionMatches(candidate_ptr: ptr, candidate_len: u64, selectedModel_ptr: ptr, selectedModel_len: u64) -> bool {
    if str_eq(candidate_ptr, candidate_len, selectedModel_ptr, selectedModel_len) {
        return true;
    };
    let a = StrBuf { bytes: [0u8; 512], len: 0 };
    let b = StrBuf { bytes: [0u8; 512], len: 0 };
    stripModelContextVariant_baseModel(candidate_ptr, candidate_len, &a);
    stripModelContextVariant_baseModel(selectedModel_ptr, selectedModel_len, &b);
    return str_eq(&a.bytes, a.len, &b.bytes, b.len);
}

// ---- modelSelectionUtils.ts:81-85 — resolveTextRuntimeGroupId ----
// Status 0 = groupId present (out_groupId filled), 1 = null.
fn resolveTextRuntimeGroupId(providers: &ProviderConfig, providers_len: u64, activeProviderId_ptr: ptr, activeProviderId_len: u64, has_activeProviderId: bool, activeGroupId_ptr: ptr, activeGroupId_len: u64, has_activeGroupId: bool, selectedModel_ptr: ptr, selectedModel_len: u64, out_groupId: &StrBuf) -> i32 {
    for i in 0..providers_len {
        let p = &providers;
        if has_activeProviderId && str_eq(&p.id, p.id_len, activeProviderId_ptr, activeProviderId_len) {
            let sel = RelayTextRuntimeSelection { model: StrBuf { bytes: [0u8; 512], len: 0 }, groupId: StrBuf { bytes: [0u8; 512], len: 0 }, has_groupId: false };
            resolveRelayTextRuntimeSelection(p, activeGroupId_ptr, activeGroupId_len, has_activeGroupId, selectedModel_ptr, selectedModel_len, &sel);
            if sel.has_groupId {
                *out_groupId = sel.groupId;
                return 0;
            };
            return 1;
        };
    }
    // if (!provider) return activeGroupId;
    if has_activeGroupId {
        buf_set_lit(out_groupId, activeGroupId_ptr, activeGroupId_len);
        return 0;
    };
    return 1;
}

// ---- modelSelectionUtils.ts:87-94 — isLikelyImageModelId ----
// DEFECT: RegExp /(^|[-_/])(image|img|nano[_-]?banana|flux|...)([-_/]|$)/i has
// no SLA regex engine; approximated by case-insensitive substring scan for the
// same token set (word-boundary semantics lost).
fn isLikelyImageModelId(model_ptr: ptr, model_len: u64) -> bool {
    // normalized = model.trim().toLowerCase(); trim/lowercase applied by caller-side scan below
    if model_len == 0 {
        return false;
    };
    let hay = StrBuf { bytes: [0u8; 512], len: 0 };
    for i in 0..model_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, model_ptr, i);
        if b >= 65 && b <= 90 {
            b = b + 32;
        };
        hay.bytes[i] = b;
    }
    hay.len = model_len;
    if buf_contains(&hay, STR_PTR("image"), STR_LEN("image")) { return true; };
    if buf_contains(&hay, STR_PTR("img"), STR_LEN("img")) { return true; };
    if buf_contains(&hay, STR_PTR("banana"), STR_LEN("banana")) { return true; };
    if buf_contains(&hay, STR_PTR("flux"), STR_LEN("flux")) { return true; };
    if buf_contains(&hay, STR_PTR("midjourney"), STR_LEN("midjourney")) { return true; };
    if buf_contains(&hay, STR_PTR("dall"), STR_LEN("dall")) { return true; };
    if buf_contains(&hay, STR_PTR("diffusion"), STR_LEN("diffusion")) { return true; };
    if buf_contains(&hay, STR_PTR("sdxl"), STR_LEN("sdxl")) { return true; };
    if buf_contains(&hay, STR_PTR("hidream"), STR_LEN("hidream")) { return true; };
    if buf_contains(&hay, STR_PTR("ideogram"), STR_LEN("ideogram")) { return true; };
    if buf_contains(&hay, STR_PTR("recraft"), STR_LEN("recraft")) { return true; };
    if buf_contains(&hay, STR_PTR("imagen"), STR_LEN("imagen")) { return true; };
    if buf_contains(&hay, STR_PTR("seedream"), STR_LEN("seedream")) { return true; };
    if buf_contains(&hay, STR_PTR("kolors"), STR_LEN("kolors")) { return true; };
    if buf_contains(&hay, STR_PTR("wan2"), STR_LEN("wan2")) { return true; };
    if buf_contains(&hay, STR_PTR("kling"), STR_LEN("kling")) { return true; };
    if buf_contains(&hay, STR_PTR("jimeng"), STR_LEN("jimeng")) { return true; };
    if buf_contains(&hay, STR_PTR("gpt-image"), STR_LEN("gpt-image")) { return true; };
    return false;
}

// ---- modelSelectionUtils.ts:96-122 — resolveProviderSelectionId ----
// Status 0 = id present, 1 = null.
fn resolveProviderSelectionId(providers: &ProviderConfig, providers_len: u64, activeProviderId_ptr: ptr, activeProviderId_len: u64, has_activeProviderId: bool, configuredModelProvider_ptr: ptr, configuredModelProvider_len: u64, has_configuredModelProvider: bool, out_id: &StrBuf) -> i32 {
    if has_activeProviderId && str_eq(activeProviderId_ptr, activeProviderId_len, STR_PTR("agy-official"), STR_LEN("agy-official")) {
        buf_set_lit(out_id, STR_PTR("agy-official"), STR_LEN("agy-official"));
        return 0;
    };
    if has_activeProviderId && str_eq(activeProviderId_ptr, activeProviderId_len, STR_PTR("grok-official"), STR_LEN("grok-official")) {
        buf_set_lit(out_id, STR_PTR("grok-official"), STR_LEN("grok-official"));
        return 0;
    };
    if has_activeProviderId && str_eq(activeProviderId_ptr, activeProviderId_len, STR_PTR("pi-relay"), STR_LEN("pi-relay")) {
        buf_set_lit(out_id, STR_PTR("pi-relay"), STR_LEN("pi-relay"));
        return 0;
    };
    if has_activeProviderId {
        for i in 0..providers_len {
            let p = &providers;
            if str_eq(&p.id, p.id_len, activeProviderId_ptr, activeProviderId_len) {
                buf_set_lit(out_id, activeProviderId_ptr, activeProviderId_len);
                return 0;
            };
        }
    };
    // activeProviderId?.trim().toLowerCase() === "openai" -> first chatgpt provider
    // DEFECT: trim/lowercase comparison approximated by literal compare.
    if has_activeProviderId && str_eq(activeProviderId_ptr, activeProviderId_len, STR_PTR("openai"), STR_LEN("openai")) {
        for i in 0..providers_len {
            let p = &providers;
            if buf_eq_lit(&StrBuf { bytes: p.kind, len: p.kind_len }, STR_PTR("chatgpt"), STR_LEN("chatgpt")) {
                buf_set_lit(out_id, &p.id, p.id_len);
                return 0;
            };
        }
    };
    let configured = resolveConfiguredProviderId(providers, providers_len, configuredModelProvider_ptr, configuredModelProvider_len, has_configuredModelProvider, out_id);
    if configured == 0 {
        return 0;
    };
    if has_activeProviderId {
        buf_set_lit(out_id, activeProviderId_ptr, activeProviderId_len);
        return 0;
    };
    return 1;
}

// ---- modelSelectionUtils.ts:124-138 — resolveConfiguredProviderId ----
fn resolveConfiguredProviderId(providers: &ProviderConfig, providers_len: u64, configuredModelProvider_ptr: ptr, configuredModelProvider_len: u64, has_configuredModelProvider: bool, out_id: &StrBuf) -> i32 {
    // const normalized = configuredModelProvider?.trim()
    if !has_configuredModelProvider || configuredModelProvider_len == 0 {
        return 1;
    };
    for i in 0..providers_len {
        let p = &providers;
        if str_eq(&p.id, p.id_len, configuredModelProvider_ptr, configuredModelProvider_len) {
            buf_set_lit(out_id, &p.id, p.id_len);
            return 0;
        };
    }
    if str_eq(configuredModelProvider_ptr, configuredModelProvider_len, STR_PTR("openai"), STR_LEN("openai")) {
        for i in 0..providers_len {
            let p = &providers;
            if buf_eq_lit(&StrBuf { bytes: p.kind, len: p.kind_len }, STR_PTR("chatgpt"), STR_LEN("chatgpt")) {
                buf_set_lit(out_id, &p.id, p.id_len);
                return 0;
            };
        }
        return 1;
    };
    return 1;
}

// ---- modelSelectionUtils.ts:140-156 — resolveSelectedModelProvider ----
// Status 0 = provider string present, 1 = undefined.
fn resolveSelectedModelProvider(providers: &ProviderConfig, providers_len: u64, activeProviderId_ptr: ptr, activeProviderId_len: u64, has_activeProviderId: bool, configuredModelProvider_ptr: ptr, configuredModelProvider_len: u64, has_configuredModelProvider: bool, out_provider: &StrBuf) -> i32 {
    if has_activeProviderId && str_eq(activeProviderId_ptr, activeProviderId_len, STR_PTR("agy-official"), STR_LEN("agy-official")) {
        buf_set_lit(out_provider, STR_PTR("agy-official"), STR_LEN("agy-official"));
        return 0;
    };
    if has_activeProviderId && str_eq(activeProviderId_ptr, activeProviderId_len, STR_PTR("grok-official"), STR_LEN("grok-official")) {
        buf_set_lit(out_provider, STR_PTR("grok-official"), STR_LEN("grok-official"));
        return 0;
    };
    if has_activeProviderId && str_eq(activeProviderId_ptr, activeProviderId_len, STR_PTR("pi-relay"), STR_LEN("pi-relay")) {
        buf_set_lit(out_provider, STR_PTR("pi-relay"), STR_LEN("pi-relay"));
        return 0;
    };
    for i in 0..providers_len {
        let p = &providers;
        if has_activeProviderId && str_eq(&p.id, p.id_len, activeProviderId_ptr, activeProviderId_len) {
            if buf_eq_lit(&StrBuf { bytes: p.kind, len: p.kind_len }, STR_PTR("chatgpt"), STR_LEN("chatgpt")) {
                buf_set_lit(out_provider, STR_PTR("openai"), STR_LEN("openai"));
            } else {
                buf_set_lit(out_provider, &p.id, p.id_len);
            };
            return 0;
        };
    }
    // return configuredModelProvider?.trim() || activeProviderId || undefined;
    if has_configuredModelProvider && configuredModelProvider_len > 0 {
        buf_set_lit(out_provider, configuredModelProvider_ptr, configuredModelProvider_len);
        return 0;
    };
    if has_activeProviderId {
        buf_set_lit(out_provider, activeProviderId_ptr, activeProviderId_len);
        return 0;
    };
    return 1;
}
