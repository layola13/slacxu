    modelProvider: [u8; 128], modelProvider_len: u64, has_modelProvider: bool, // string?
    permission: [u8; 64], permission_len: u64,  // PermissionPresetId
    reasoningEffort: [u8; 64], reasoningEffort_len: u64,
