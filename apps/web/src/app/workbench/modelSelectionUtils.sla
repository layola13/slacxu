// ---- shared string helpers (TS string ops approximated on (ptr,len)) ----
struct StrBuf {
    bytes: [u8; 512], len: u64,
}

fn str_eq(a_ptr: ptr, a_len: u64, b_ptr: ptr, b_len: u64) -> bool {
    // REBOUND (2026-10-26, sa_std ts sweep): hand byte-scan replaced by
    // sa_std/ts_string.sa @ts_str_equals; original signature preserved 1:1.
    return @ts_str_equals(a_ptr, a_len, b_ptr, b_len);
}

fn buf_set_lit(out: &StrBuf, lit: ptr, lit_len: u64) -> i32 {
    for i in 0..lit_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, lit, i);
        out.bytes[i] = b;
    }
    out.len = lit_len;
    return 0;
}

fn buf_eq_lit(buf: &StrBuf, lit: ptr, lit_len: u64) -> bool {
    return str_eq(&buf.bytes, buf.len, lit, lit_len);
}

// DEFECT: substring search stands in for Array.includes on the models list
// (models kept as JSON text buffer) and for the RegExp in isLikelyImageModelId.
fn buf_contains(hay: &StrBuf, needle_ptr: ptr, needle_len: u64) -> bool {
    if needle_len == 0 {
        return true;
    };
    if needle_len > hay.len {
        return false;
    };
    let last = hay.len - needle_len + 1;
    for i in 0..last {
        let ok = true;
        for j in 0..needle_len {
            let n: u8 = 0;
            PTR_BYTE_AT(n, needle_ptr, j);
            if hay.bytes[i + j] != n {
                ok = false;
            };
        }
        if ok {
            return true;
        };
    }
    return false;
}

// ---- modelSelectionUtils.ts:3-4 — imported types (approximations) ----
struct RelayGroup {
    id: [u8; 128], id_len: u64,                 // string
    kind: [u8; 32], kind_len: u64, has_kind: bool, // string? ("image" | text kinds)
    models_json: [u8; 4096], models_json_len: u64, // string[] as JSON text buffer; DEFECT: dynamic array
    available: bool,                            // stands in for isAvailableRelayGroup(group, credential)
}

struct ProviderConfig {
    id: [u8; 128], id_len: u64,                 // string
    kind: [u8; 64], kind_len: u64,              // string (e.g. "chatgpt")
    hasCredential: bool,                        // stands in for hasConfiguredProviderCredential(provider)
    groups: [RelayGroup; 32], groups_len: u64, has_groups: bool, // groups?: RelayGroup[] — fixed cap 32
}

// stripModelContextVariant(model).baseModel — imported from @codex-ui/shared.
// DEFECT: variant-suffix parsing not reproduced; approximation returns the
// input unchanged (no context variant stripped).
fn stripModelContextVariant_baseModel(model_ptr: ptr, model_len: u64, out: &StrBuf) -> i32 {
    for i in 0..model_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, model_ptr, i);
        out.bytes[i] = b;
    }
    out.len = model_len;
    return 0;
}

// hasConfiguredProviderCredential(provider) — imported approximation.
fn hasConfiguredProviderCredential(provider: &ProviderConfig) -> bool {
    return provider.hasCredential;
}

// isAvailableRelayGroup(group, hasProviderCredential) — imported approximation.
fn isAvailableRelayGroup(group: &RelayGroup, hasProviderCredential: bool) -> bool {
    return group.available;
}

// resolveRelayTextRuntimeSelection(provider, groupId, selectedModel) —
// imported from ../../groupCollection. DEFECT: full relay selection semantics
// live in that unit; here .model echoes selectedModel and .groupId echoes the
// requested groupId.
struct RelayTextRuntimeSelection {
    model: StrBuf,
    groupId: StrBuf, has_groupId: bool,
}

fn resolveRelayTextRuntimeSelection(provider: &ProviderConfig, groupId_ptr: ptr, groupId_len: u64, has_groupId: bool, selectedModel_ptr: ptr, selectedModel_len: u64, out: &RelayTextRuntimeSelection) -> i32 {
    buf_set_lit(&out.model, selectedModel_ptr, selectedModel_len);
    if has_groupId {
        buf_set_lit(&out.groupId, groupId_ptr, groupId_len);
        out.has_groupId = true;
    } else {
        out.groupId.len = 0;
        out.has_groupId = false;
    };
    return 0;
}

// ---- modelSelectionUtils.ts:6-16 — resolveComposerTextGroup ----
// Returns the chosen group via out_group; status 0 = found, 1 = no group
// (TS: undefined). Fallback chain preserved 1:1.
fn resolveComposerTextGroup(provider: &ProviderConfig, groupId_ptr: ptr, groupId_len: u64, has_groupId: bool, model_ptr: ptr, model_len: u64, out_group: &RelayGroup) -> i32 {
    let baseModel = StrBuf { bytes: [0u8; 512], len: 0 };
    stripModelContextVariant_baseModel(model_ptr, model_len, &baseModel);
    let hasProviderCredential = hasConfiguredProviderCredential(provider);
    // availableTextGroups = provider.groups?.filter(g => g.kind !== "image" && isAvailableRelayGroup(g, hasProviderCredential)) ?? []
    // DEFECT: filter() builds a new array in TS; here passes scan provider.groups
    // repeatedly with the same predicate (order preserved).
    // 1) available group with id === groupId
    if has_groupId {
        for i in 0..provider.groups_len {
            let g = &provider.groups[i];
            if g.kind_len != 5 || !buf_eq_lit(&StrBuf { bytes: g.kind, len: g.kind_len }, STR_PTR("image"), STR_LEN("image")) {
            };
            if isAvailableRelayGroup(g, hasProviderCredential) && !(g.has_kind && buf_eq_lit(&StrBuf { bytes: g.kind, len: g.kind_len }, STR_PTR("image"), STR_LEN("image"))) && str_eq(&g.id, g.id_len, groupId_ptr, groupId_len) {
                *out_group = *g;
                return 0;
            };
        }
    };
    // 2) available group whose models include model or baseModel
    for i in 0..provider.groups_len {
        let g = &provider.groups[i];
        if isAvailableRelayGroup(g, hasProviderCredential) && !(g.has_kind && buf_eq_lit(&StrBuf { bytes: g.kind, len: g.kind_len }, STR_PTR("image"), STR_LEN("image"))) {
            let models = StrBuf { bytes: g.models_json, len: g.models_json_len };
            if buf_contains(&models, model_ptr, model_len) || buf_contains(&models, &baseModel.bytes, baseModel.len) {
                *out_group = *g;
                return 0;
            };
        };
    }
    // 3) first available text group
    for i in 0..provider.groups_len {
        let g = &provider.groups[i];
        if isAvailableRelayGroup(g, hasProviderCredential) && !(g.has_kind && buf_eq_lit(&StrBuf { bytes: g.kind, len: g.kind_len }, STR_PTR("image"), STR_LEN("image"))) {
            *out_group = *g;
            return 0;
        };
    }
    // 4) provider.groups?.find(g => g.id === groupId && g.kind !== "image")
    if has_groupId {
        for i in 0..provider.groups_len {
            let g = &provider.groups[i];
            if str_eq(&g.id, g.id_len, groupId_ptr, groupId_len) && !(g.has_kind && buf_eq_lit(&StrBuf { bytes: g.kind, len: g.kind_len }, STR_PTR("image"), STR_LEN("image"))) {
                *out_group = *g;
                return 0;
            };
        }
    };
    // 5) provider.groups?.find(g => g.kind !== "image" && models include model/baseModel)
    for i in 0..provider.groups_len {
        let g = &provider.groups[i];
        if !(g.has_kind && buf_eq_lit(&StrBuf { bytes: g.kind, len: g.kind_len }, STR_PTR("image"), STR_LEN("image"))) {
            let models = StrBuf { bytes: g.models_json, len: g.models_json_len };
            if buf_contains(&models, model_ptr, model_len) || buf_contains(&models, &baseModel.bytes, baseModel.len) {
                *out_group = *g;
                return 0;
            };
        };
    }
    // 6) provider.groups?.find(g => g.kind !== "image")
    for i in 0..provider.groups_len {
        let g = &provider.groups[i];
        if !(g.has_kind && buf_eq_lit(&StrBuf { bytes: g.kind, len: g.kind_len }, STR_PTR("image"), STR_LEN("image"))) {
            *out_group = *g;
            return 0;
        };
    }
    // 7) provider.groups?.[0]
    if provider.groups_len > 0 {
        *out_group = provider.groups[0];
        return 0;
    };
    return 1;
}

// ---- modelSelectionUtils.ts:18-57 — buildNewChatBackendPreview ----
// DEFECT: dynamic object / Record<string, JsonValue> return; approximated by
// serializing the same shape into a JSON text buffer (out_json).
