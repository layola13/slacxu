// ---- appUtils.ts:115-127 — reviewTargetLabel ----
fn reviewTargetLabel(target_json_ptr: ptr, target_json_len: u64, out: &StrBuf) -> i32 {
    let typ = StrBuf { bytes: [0u8; 8192], len: 0 };
    sa_json_get_string(target_json_ptr, target_json_len, STR_PTR("type"), STR_LEN("type"), &typ);
    out.len = 0;
    if str_eq(&typ.bytes, typ.len, STR_PTR("baseBranch"), STR_LEN("baseBranch")) {
        // `Review against ${stringValue(record.branch) ?? "base branch"}`
        let branch = StrBuf { bytes: [0u8; 8192], len: 0 };
        buf_append(out, STR_PTR("Review against "), STR_LEN("Review against "));
        if sa_json_get_string(target_json_ptr, target_json_len, STR_PTR("branch"), STR_LEN("branch"), &branch) != 0 && branch.len > 0 {
            buf_append(out, &branch.bytes, branch.len);
        } else {
            buf_append(out, STR_PTR("base branch"), STR_LEN("base branch"));
        };
        return 0;
    };
    if str_eq(&typ.bytes, typ.len, STR_PTR("commit"), STR_LEN("commit")) {
        // `Review commit ${stringValue(record.sha) ?? ""}`.trim()
        let sha = StrBuf { bytes: [0u8; 8192], len: 0 };
        buf_append(out, STR_PTR("Review commit "), STR_LEN("Review commit "));
        if sa_json_get_string(target_json_ptr, target_json_len, STR_PTR("sha"), STR_LEN("sha"), &sha) != 0 {
            buf_append(out, &sha.bytes, sha.len);
        };
        return 0;
    };
    if str_eq(&typ.bytes, typ.len, STR_PTR("custom"), STR_LEN("custom")) {
        if sa_json_get_string(target_json_ptr, target_json_len, STR_PTR("instructions"), STR_LEN("instructions"), out) != 0 && out.len > 0 {
            return 0;
        };
        buf_append(out, STR_PTR("Custom review"), STR_LEN("Custom review"));
        return 0;
    };
    buf_append(out, STR_PTR("Review uncommitted changes"), STR_LEN("Review uncommitted changes"));
    return 0;
}

// ---- appUtils.ts:129-142 — formatDiffNotice ----
fn formatDiffNotice(sha_ptr: ptr, sha_len: u64, has_sha: bool, diff_ptr: ptr, diff_len: u64, out: &StrBuf) -> i32 {
    out.len = 0;
    if has_sha {
        buf_append(out, STR_PTR("Remote base: "), STR_LEN("Remote base: "));
        buf_append(out, sha_ptr, sha_len);
    } else {
        buf_append(out, STR_PTR("Remote base unavailable"), STR_LEN("Remote base unavailable"));
    };
    buf_append(out, STR_PTR("\n"), STR_LEN("\n"));
    let s: u64 = 0;
    let e: u64 = 0;
    trim_range(diff_ptr, diff_len, &s, &e);
    if s >= e {
        buf_append(out, STR_PTR("No diff returned."), STR_LEN("No diff returned."));
        return 0;
    };
    let trimmed_len = e - s;
    let maxLength: u64 = 1800;
    if trimmed_len > maxLength {
        buf_append(out, diff_ptr + s, maxLength);
        buf_append(out, STR_PTR("\n...diff truncated in UI..."), STR_LEN("\n...diff truncated in UI..."));
    } else {
        buf_append(out, diff_ptr + s, trimmed_len);
    };
    return 0;
}

