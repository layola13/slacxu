fn sa_json_get_string(json_ptr: ptr, json_len: u64, key_ptr: ptr, key_len: u64, out: &StrBuf) -> i32 {
    out.len = 0;
    return 0; // DEFECT: placeholder
}

fn sa_json_get_number(json_ptr: ptr, json_len: u64, key_ptr: ptr, key_len: u64, out: &f64) -> i32 {
    *out = 0.0;
    return 0; // DEFECT: placeholder
}

fn sa_json_get_object(json_ptr: ptr, json_len: u64, key_ptr: ptr, key_len: u64, out: &JsonBuf) -> i32 {
    out.len = 0;
    return 0; // DEFECT: placeholder
}

fn str_eq(a_ptr: ptr, a_len: u64, b_ptr: ptr, b_len: u64) -> bool {
    // REBOUND (2026-10-26, sa_std ts sweep): hand byte-scan replaced by
    // sa_std/ts_string.sa @ts_str_equals; original signature preserved 1:1.
    return @ts_str_equals(a_ptr, a_len, b_ptr, b_len);
}

fn buf_append(out: &StrBuf, p: ptr, n: u64) -> i32 {
    for i in 0..n {
        let b: u8 = 0;
        PTR_BYTE_AT(b, p, i);
        out.bytes[out.len + i] = b;
    }
    out.len = out.len + n;
    return 0;
}

fn buf_contains(hay_ptr: ptr, hay_len: u64, needle_ptr: ptr, needle_len: u64) -> bool {
    if needle_len == 0 {
        return true;
    };
    if needle_len > hay_len {
        return false;
    };
    let last = hay_len - needle_len + 1;
    for i in 0..last {
        let ok = true;
        for j in 0..needle_len {
            let a: u8 = 0;
            PTR_BYTE_AT(a, hay_ptr, i + j);
            let b: u8 = 0;
            PTR_BYTE_AT(b, needle_ptr, j);
            if a != b {
                ok = false;
            };
        }
        if ok {
            return true;
        };
    }
    return false;
}

// trimmed range helper: writes [start, end) of the space-trimmed input.
fn trim_range(p: ptr, n: u64, out_start: &u64, out_end: &u64) -> i32 {
    let start: u64 = 0;
    let end = n;
    while start < end {
        let b: u8 = 0;
        PTR_BYTE_AT(b, p, start);
        if b == 32 || b == 9 || b == 10 || b == 13 {
            start = start + 1;
        } else {
            start = end;
        };
    }
    while end > start {
        let b2: u8 = 0;
        PTR_BYTE_AT(b2, p, end - 1);
        if b2 == 32 || b2 == 9 || b2 == 10 || b2 == 13 {
            end = end - 1;
        } else {
            end = start;
        };
    }
    *out_start = start;
    *out_end = end;
    return 0;
}

