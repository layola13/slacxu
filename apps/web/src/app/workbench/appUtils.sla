// ---- appUtils.ts:85-93 — userMessageTextsMatch ----
fn userMessageTextsMatch(actualText_ptr: ptr, actualText_len: u64, expectedText_ptr: ptr, expectedText_len: u64) -> bool {
    let a_start: u64 = 0;
    let a_end: u64 = 0;
    trim_range(actualText_ptr, actualText_len, &a_start, &a_end);
    let e_start: u64 = 0;
    let e_end: u64 = 0;
    trim_range(expectedText_ptr, expectedText_len, &e_start, &e_end);
    let e_len = e_end - e_start;
    if e_len == 0 {
        return true; // if (!expected) return true
    };
    let a_len = a_end - a_start;
    // actual === expected || actual.includes(expected) || expected.includes(actual)
    if a_len == e_len && buf_contains(actualText_ptr + a_start, a_len, expectedText_ptr + e_start, e_len) {
        return true;
    };
    if buf_contains(actualText_ptr + a_start, a_len, expectedText_ptr + e_start, e_len) {
        return true;
    };
    if buf_contains(expectedText_ptr + e_start, e_len, actualText_ptr + a_start, a_len) {
        return true;
    };
    return false;
}

