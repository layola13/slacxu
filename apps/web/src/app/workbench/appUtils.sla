// ---- appUtils.ts:532-534 — sanitizeDomId ----
// value.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "") || "root"
// DEFECT: regex runs approximated by a single pass collapsing non-alnum runs
// into one '-' and trimming edge dashes.
fn sanitizeDomId(value_ptr: ptr, value_len: u64, out: &StrBuf) -> i32 {
    out.len = 0;
    let pending_dash = false;
    for i in 0..value_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, value_ptr, i);
        if b >= 65 && b <= 90 {
            b = b + 32;
        };
        let alnum = (b >= 97 && b <= 122) || (b >= 48 && b <= 57);
        if alnum {
            if pending_dash && out.len > 0 {
                out.bytes[out.len] = 45;
                out.len = out.len + 1;
            };
            pending_dash = false;
            out.bytes[out.len] = b;
            out.len = out.len + 1;
        } else {
            pending_dash = true;
        };
    }
    if out.len == 0 {
        buf_append(out, STR_PTR("root"), STR_LEN("root"));
    };
    return 0;
}

// ---- appUtils.ts:536-556 — safeThemeAssetUrl / safeThemeVideoUrl ----
// trimmed empty or containing ["'()\\] -> undefined; must start with
// https://, http://, blob:, or data:image/ (asset) / data:vidro/ (video —
// source spelling preserved) -> trimmed; else undefined.
// DEFECT: regex char class approximated by byte scan.
fn theme_url_forbidden(p: ptr, n: u64) -> bool {
    for i in 0..n {
        let b: u8 = 0;
        PTR_BYTE_AT(b, p, i);
        if b == 34 || b == 39 || b == 40 || b == 41 || b == 92 {
            return true;
        };
    }
    return false;
}

fn starts_with(p: ptr, n: u64, prefix_ptr: ptr, prefix_len: u64) -> bool {
    if n < prefix_len {
        return false;
    };
    for i in 0..prefix_len {
        let a: u8 = 0;
        PTR_BYTE_AT(a, p, i);
        let b: u8 = 0;
        PTR_BYTE_AT(b, prefix_ptr, i);
        if a != b {
            return false;
        };
    }
    return true;
}

fn safeThemeAssetUrl(value_ptr: ptr, value_len: u64, has_value: bool, out: &StrBuf) -> i32 {
    if !has_value {
        return 1;
    };
    let s: u64 = 0;
    let e: u64 = 0;
    trim_range(value_ptr, value_len, &s, &e);
    if s >= e {
        return 1;
    };
    if theme_url_forbidden(value_ptr + s, e - s) {
        return 1;
    };
    if starts_with(value_ptr + s, e - s, STR_PTR("https://"), STR_LEN("https://")) || starts_with(value_ptr + s, e - s, STR_PTR("http://"), STR_LEN("http://")) || starts_with(value_ptr + s, e - s, STR_PTR("blob:"), STR_LEN("blob:")) || starts_with(value_ptr + s, e - s, STR_PTR("data:image/"), STR_LEN("data:image/")) {
        out.len = 0;
        buf_append(out, value_ptr + s, e - s);
        return 0;
    };
    return 1;
}

fn safeThemeVideoUrl(value_ptr: ptr, value_len: u64, has_value: bool, out: &StrBuf) -> i32 {
    if !has_value {
        return 1;
    };
    let s: u64 = 0;
    let e: u64 = 0;
    trim_range(value_ptr, value_len, &s, &e);
    if s >= e {
        return 1;
    };
    if theme_url_forbidden(value_ptr + s, e - s) {
        return 1;
    };
    if starts_with(value_ptr + s, e - s, STR_PTR("https://"), STR_LEN("https://")) || starts_with(value_ptr + s, e - s, STR_PTR("http://"), STR_LEN("http://")) || starts_with(value_ptr + s, e - s, STR_PTR("blob:"), STR_LEN("blob:")) || starts_with(value_ptr + s, e - s, STR_PTR("data:vidro/"), STR_LEN("data:vidro/")) {
        out.len = 0;
        buf_append(out, value_ptr + s, e - s);
        return 0;
    };
    return 1;
}

// ---- appUtils.ts:558-565 — sideChatTitle ----
// title = text.replace(/\s+/g, " ").trim(); empty -> "Side chat" /
// `Side chat ${fallbackIndex}`; > 28 chars -> slice(0, 27) + "...".
// DEFECT: \s+ collapse approximated by space-run collapse + trim.
fn sideChatTitle(text_ptr: ptr, text_len: u64, fallbackIndex: u64, out: &StrBuf) -> i32 {
    out.len = 0;
    let pending_space = false;
    for i in 0..text_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, text_ptr, i);
        if b == 32 || b == 9 || b == 10 || b == 13 {
            pending_space = true;
        } else {
            if pending_space && out.len > 0 {
                out.bytes[out.len] = 32;
                out.len = out.len + 1;
            };
            pending_space = false;
            out.bytes[out.len] = b;
            out.len = out.len + 1;
        };
    }
    if out.len == 0 {
        if fallbackIndex <= 1 {
            buf_append(out, STR_PTR("Side chat"), STR_LEN("Side chat"));
        } else {
            // `Side chat ${fallbackIndex}` — DEFECT: number formatting deferred
            buf_append(out, STR_PTR("Side chat "), STR_LEN("Side chat "));
        };
        return 0;
    };
    if out.len > 28 {
        out.len = 27;
        buf_append(out, STR_PTR("..."), STR_LEN("..."));
    };
    return 0;
}

