// ---- appUtils.ts:194-202 — appendBoundedTerminalOutput ----
// Note: source marker is the literal "[output truncated]\\n" (backslash-n as
// two characters in the TS string); preserved as-is.
fn appendBoundedTerminalOutput(current_ptr: ptr, current_len: u64, appended_ptr: ptr, appended_len: u64, out: &StrBuf) -> i32 {
    let next_len = current_len + appended_len;
    out.len = 0;
    if next_len <= 160000 {
        buf_append(out, current_ptr, current_len);
        buf_append(out, appended_ptr, appended_len);
        return 0;
    };
    // trimmed = next.slice(-MAX_TERMINAL_OUTPUT_CHARS) — tail of the concat:
    // approximated by taking the tail of `appended` plus as much of the tail
    // of `current` as fits. DEFECT: concat buffer is the 8KB StrBuf here, far
    // below the 160000 cap; exact slicing deferred to fix pass.
    buf_append(out, STR_PTR("[output truncated]\\n"), STR_LEN("[output truncated]\\n"));
    return 0;
}

// ---- appUtils.ts:206-212 — asRecord / stringValue ----
// asRecord: non-null non-array object -> itself as JSON text, else {}.
fn asRecord(value_json_ptr: ptr, value_json_len: u64, out: &JsonBuf) -> i32 {
    let i: u64 = 0;
    while i < value_json_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, value_json_ptr, i);
        if b == 32 || b == 9 || b == 10 || b == 13 {
            i = i + 1;
        } else {
            if b == 123 {
                for j in 0..value_json_len {
                    let c: u8 = 0;
                    PTR_BYTE_AT(c, value_json_ptr, j);
                    out.bytes[j] = c;
                }
                out.len = value_json_len;
                return 0;
            };
            out.bytes[0] = 123;
            out.bytes[1] = 125;
            out.len = 2;
            return 0;
        };
    }
    out.bytes[0] = 123;
    out.bytes[1] = 125;
    out.len = 2;
    return 0;
}

// stringValue: typeof string && length > 0 -> the string, else undefined (1).
fn stringValue(value_json_ptr: ptr, value_json_len: u64, out: &StrBuf) -> i32 {
    // DEFECT: JSON string decoding (quotes/escapes) deferred; the raw buffer
    // is treated as the string body when non-empty and not an object/array.
    if value_json_len == 0 {
        return 1;
    };
    let b: u8 = 0;
    PTR_BYTE_AT(b, value_json_ptr, 0);
    if b == 123 || b == 91 {
        return 1;
    };
    out.len = 0;
    buf_append(out, value_json_ptr, value_json_len);
    if out.len == 0 {
        return 1;
    };
    return 0;
}

// ---- appUtils.ts:214-216 — normalizeGitPath ----
// (path ?? "").replace(/\\/g, "/").replace(/^\.\/+/, "").replace(/\/+/g, "/").toLowerCase()
fn normalizeGitPath(path_ptr: ptr, path_len: u64, has_path: bool, out: &StrBuf) -> i32 {
    out.len = 0;
    if !has_path {
        return 0;
    };
    let i: u64 = 0;
    // strip leading "./" run (^\.\/+)
    if path_len >= 2 {
        let b0: u8 = 0;
        PTR_BYTE_AT(b0, path_ptr, 0);
        let b1: u8 = 0;
        PTR_BYTE_AT(b1, path_ptr, 1);
        if b0 == 46 && b1 == 47 {
            i = 1;
            while i < path_len {
                let c: u8 = 0;
                PTR_BYTE_AT(c, path_ptr, i);
                if c == 47 {
                    i = i + 1;
                } else {
                    i = path_len;
                };
            }
            // note: the '.' itself is consumed by starting after it via loop above
            i = 2;
            while i < path_len {
                let c2: u8 = 0;
                PTR_BYTE_AT(c2, path_ptr, i);
                if c2 == 47 {
                    i = i + 1;
                } else {
                    i = path_len + 1;
                };
            }
            if i > path_len {
                i = i - 1;
            };
        };
    }
    let prev_slash = false;
    while i < path_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, path_ptr, i);
        if b == 92 {
            b = 47; // backslash -> slash
        };
        if b >= 65 && b <= 90 {
            b = b + 32; // lowercase
        };
        if b == 47 {
            if !prev_slash {
                out.bytes[out.len] = b;
                out.len = out.len + 1;
            };
            prev_slash = true;
        } else {
            out.bytes[out.len] = b;
            out.len = out.len + 1;
            prev_slash = false;
        };
        i = i + 1;
    }
    return 0;
}

