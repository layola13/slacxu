// ---- appUtils.ts:384-389 — normalizeTimestampMilliseconds ----
// !value || !isFinite -> null (status 1); value > 1e12 -> value; else value*1000.
fn normalizeTimestampMilliseconds(value: f64, has_value: bool, out: &f64) -> i32 {
    if !has_value || value == 0.0 {
        return 1;
    };
    if value > 1000000000000.0 {
        *out = value;
    } else {
        *out = value * 1000.0;
    };
    return 0;
}

// ---- appUtils.ts:391-427 — status label / notice ----
// TranslateFn placeholder: t(key) / t(key, params) -> localized string.
fn translate(t_handle: u64, key_ptr: ptr, key_len: u64, out: &StrBuf) -> i32 {
    out.len = 0;
    buf_append(out, key_ptr, key_len); // DEFECT: i18n lookup deferred; key echoed
    return 0;
}

fn conversationStatusLabelFor(status_ptr: ptr, status_len: u64, connectionStatus: &SocketConnectionStatus, t_handle: u64, out: &StrBuf) -> i32 {
    if str_eq(&connectionStatus.phase, connectionStatus.phase_len, STR_PTR("connecting"), STR_LEN("connecting")) {
        return translate(t_handle, STR_PTR("connection.connecting"), STR_LEN("connection.connecting"), out);
    };
    if str_eq(&connectionStatus.phase, connectionStatus.phase_len, STR_PTR("reconnecting"), STR_LEN("reconnecting")) {
        return translate(t_handle, STR_PTR("connection.reconnecting"), STR_LEN("connection.reconnecting"), out);
    };
    if str_eq(status_ptr, status_len, STR_PTR("disconnect"), STR_LEN("disconnect")) {
        return translate(t_handle, STR_PTR("connection.disconnected"), STR_LEN("connection.disconnected"), out);
    };
    if str_eq(status_ptr, status_len, STR_PTR("connecting"), STR_LEN("connecting")) {
        return translate(t_handle, STR_PTR("connection.connecting"), STR_LEN("connection.connecting"), out);
    };
    if str_eq(status_ptr, status_len, STR_PTR("working"), STR_LEN("working")) {
        return translate(t_handle, STR_PTR("composer.running"), STR_LEN("composer.running"), out);
    };
    if str_eq(status_ptr, status_len, STR_PTR("idle"), STR_LEN("idle")) {
        return translate(t_handle, STR_PTR("composer.ready"), STR_LEN("composer.ready"), out);
    };
    if str_eq(status_ptr, status_len, STR_PTR("retrying"), STR_LEN("retrying")) {
        return translate(t_handle, STR_PTR("connection.engineStarting"), STR_LEN("connection.engineStarting"), out);
    };
    // "engine-error" (switch fallthrough end)
    return translate(t_handle, STR_PTR("connection.engineError"), STR_LEN("connection.engineError"), out);
}

fn connectionNoticeFor(status: &SocketConnectionStatus, t_handle: u64, out: &StrBuf) -> i32 {
    if str_eq(&status.phase, status.phase_len, STR_PTR("reconnecting"), STR_LEN("reconnecting")) {
        // t("connection.noticeReconnecting", { seconds: max(1, ceil((delayMs ?? 0)/1000)), reason: reason ?? t("connection.disconnected") })
        // DEFECT: interpolation params deferred.
        return translate(t_handle, STR_PTR("connection.noticeReconnecting"), STR_LEN("connection.noticeReconnecting"), out);
    };
    if str_eq(&status.phase, status.phase_len, STR_PTR("connecting"), STR_LEN("connecting")) {
        return translate(t_handle, STR_PTR("connection.noticeConnecting"), STR_LEN("connection.noticeConnecting"), out);
    };
    if status.has_reason {
        // t("connection.noticeDisconnectedWithReason", { reason })
        return translate(t_handle, STR_PTR("connection.noticeDisconnectedWithReason"), STR_LEN("connection.noticeDisconnectedWithReason"), out);
    };
    return translate(t_handle, STR_PTR("connection.noticeDisconnected"), STR_LEN("connection.noticeDisconnected"), out);
}

// ---- appUtils.ts:429-442 — conversationStatusColorFor ----
fn conversationStatusColorFor(status_ptr: ptr, status_len: u64, out: &StrBuf) -> i32 {
    out.len = 0;
    if str_eq(status_ptr, status_len, STR_PTR("connecting"), STR_LEN("connecting")) || str_eq(status_ptr, status_len, STR_PTR("working"), STR_LEN("working")) {
        buf_append(out, STR_PTR("primary"), STR_LEN("primary"));
    } else {
        if str_eq(status_ptr, status_len, STR_PTR("idle"), STR_LEN("idle")) {
            buf_append(out, STR_PTR("success"), STR_LEN("success"));
        } else {
            if str_eq(status_ptr, status_len, STR_PTR("disconnect"), STR_LEN("disconnect")) || str_eq(status_ptr, status_len, STR_PTR("engine-error"), STR_LEN("engine-error")) {
                buf_append(out, STR_PTR("error"), STR_LEN("error"));
            } else {
                buf_append(out, STR_PTR("warning"), STR_LEN("warning")); // "retrying"
            };
        };
    };
    return 0;
}

// ---- appUtils.ts:444-482 — error helpers ----
fn formatErrorText(error_json_ptr: ptr, error_json_len: u64, out: &StrBuf) -> i32 {
    // Error instance -> .message; string -> itself; object -> first non-empty
    // string among message/error/detail/reason (recursing into object values,
    // skipping "[object Object]"), else JSON.stringify(record); other ->
    // String(error). DEFECT: recursion + instanceof deferred; raw text echoed.
    out.len = 0;
    buf_append(out, error_json_ptr, error_json_len);
    return 0;
}

fn errorMessage(scope_ptr: ptr, scope_len: u64, error_json_ptr: ptr, error_json_len: u64, out: &StrBuf) -> i32 {
    out.len = 0;
    buf_append(out, scope_ptr, scope_len);
    buf_append(out, STR_PTR(": "), STR_LEN(": "));
    let text = StrBuf { bytes: [0u8; 8192], len: 0 };
    formatErrorText(error_json_ptr, error_json_len, &text);
    buf_append(out, &text.bytes, text.len);
    return 0;
}

fn isThreadNotFoundError(error_json_ptr: ptr, error_json_len: u64) -> bool {
    let text = StrBuf { bytes: [0u8; 8192], len: 0 };
    formatErrorText(error_json_ptr, error_json_len, &text);
    // message.includes("thread not found") on the lowercased text
    // DEFECT: lowercase deferred; lowercase needle check only.
    return buf_contains(&text.bytes, text.len, STR_PTR("thread not found"), STR_LEN("thread not found"));
}

