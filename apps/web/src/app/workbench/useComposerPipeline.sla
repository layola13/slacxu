struct StrBuf {
    bytes: [u8; 8192], len: u64,
}

struct JsonBuf {
    bytes: [u8; 32768], len: u64,  // DEFECT: dynamic object
}

// ---- useComposerPipeline.ts:72-75 — extended input ----
struct UseComposerPipelineInputExtra {
    ensureActiveThread: u64,                    // () => Promise<string>; DEFECT: async
    interruptTurn: u64,                         // (threadId, turnId) => Promise<void>; DEFECT: async
}

// Frame for the nested closures of startCodexTurn (shared captured locals).
struct StartCodexTurnFrame {
    dedupeKey: [u8; 4096], dedupeKey_len: u64,
    pendingAppendId: [u8; 128], pendingAppendId_len: u64,
    threadId: [u8; 128], threadId_len: u64, has_threadId: bool,
    turnCommitted: bool,
    turnParams_json: JsonBuf,
    pendingContextWindow: f64, has_pendingContextWindow: bool, // number | null
    staleRunningTurns_json: JsonBuf,           // WorkbenchTurn[]
}

