// ---- appConstants.ts:151-155 — INITIAL_SOCKET_CONNECTION_STATUS ----
fn initial_socket_connection_status(out: &SocketConnectionStatus) -> i32 {
    // phase: "disconnected", at: 0, reason: "Not connected"
    out.phase_len = 12;
    out.at = 0;
    out.reason_len = 13;
    return 0;
}

