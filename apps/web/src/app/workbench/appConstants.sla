    collaborationMode: [u8; 16], collaborationMode_len: u64, has_collaborationMode: bool, // "plan" | "default"
    displayText: [u8; 4096], displayText_len: u64, has_displayText: bool, // string?
    forceNewTurn: bool, has_forceNewTurn: bool,
    automaticPlanContinuation: bool, has_automaticPlanContinuation: bool,
    enablePlanAutoContinuation: bool, has_enablePlanAutoContinuation: bool,
    suppressUserMessage: bool, has_suppressUserMessage: bool,
    awaitTurnStarted: bool, has_awaitTurnStarted: bool,
    onTurnStarted: u64, has_onTurnStarted: bool,        // (threadId, turnId) => void — handler handle
    steerOnly: bool, has_steerOnly: bool,
}

