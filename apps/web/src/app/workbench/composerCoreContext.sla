// ---- composerCoreContext.ts:24-28 — type FreebuffFallbackSuggestion ----
struct FreebuffFallbackSuggestionModel {
    id: [u8; 128], id_len: u64,                 // string
    name: [u8; 256], name_len: u64,             // string
    price: f64,                                 // number
}

struct FreebuffFallbackSuggestion {
    present: bool,                              // the `| null` arm
    currentModel: [u8; 128], currentModel_len: u64, // string
    suggestedModel: FreebuffFallbackSuggestionModel,
    reason: [u8; 1024], reason_len: u64,        // string
}

// ---- composerCoreContext.ts:30-119 — type ComposerCoreInput ----
