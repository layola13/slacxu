// DEFECT: SetStateAction<T> (value | updater function) has no SLA counterpart; updater-function form not reproduced.
fn setAuthStatus(s: &UseSessionState, v_ptr: ptr, v_len: u64) -> i32 { s.authStatus_ptr = v_ptr; s.authStatus_len = v_len; return 0; }
fn setAuthSession(s: &UseSessionState, v: &AuthSession, is_null: bool) -> i32 { s.authSession = v; s.authSession_is_null = is_null; s.authSessionRef = v; s.authSessionRef_is_null = is_null; return 0; }
fn setLoginError(s: &UseSessionState, v_ptr: ptr, v_len: u64, is_null: bool) -> i32 { s.loginError_ptr = v_ptr; s.loginError_len = v_len; s.loginError_is_null = is_null; return 0; }
fn setLoginSubmitting(s: &UseSessionState, v: bool) -> i32 { s.loginSubmitting = v; return 0; }
