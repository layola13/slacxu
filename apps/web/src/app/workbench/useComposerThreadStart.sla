struct StrBuf {
    bytes: [u8; 8192], len: u64,
}

struct JsonBuf {
    bytes: [u8; 32768], len: u64,  // DEFECT: dynamic object
}

// ComposerCoreInput is declared in composerCoreContext.sla; the fields used
// here: state (handle), dispatch, client, t, runtimeSelection (JSON),
// workspaceMode, cwd, sshCommand, additionalRoots (JSON),
// workspaceSelectionPending, activeProviderId, activeGroupId, selectedModel,
// reasoningEffort, permission, isClaudeBackend / isAgyBackend / isGrokBackend /
// isPiBackend / isOpencodeBackend, dangerBypassPermissionConfirmed,
// codexConfig (JSON), refreshProviders, applyHistoryThreads,
// activeThreadIdRef_current, activatedProviderSelectionRef_current,
// optimisticThreadIdsRef (JSON set), splitMutationEpochRef_current,
// topicTranscriptStore, and the setter / selection handler handles.

// selectionForThread(null) result (ThreadRuntimeSelection projection):
struct CreationSelection {
    providerId: [u8; 128], providerId_len: u64, has_providerId: bool, // string | null | undefined
    groupId: [u8; 128], groupId_len: u64, has_groupId: bool,
    model: [u8; 256], model_len: u64,           // string ("" when unset)
    cliBackend: [u8; 64], cliBackend_len: u64, has_cliBackend: bool, // string?
}

// Placeholder externs (fix pass wires the real units):
fn sa_state_token(state: u64, out: &StrBuf) -> i32 { out.len = 0; return 0; } // DEFECT
fn sa_state_providers_json(state: u64, out: &JsonBuf) -> i32 { out.len = 0; return 0; } // DEFECT
fn sa_client_rpc(client: u64, method_ptr: ptr, method_len: u64, params_json_ptr: ptr, params_json_len: u64, out_json: &JsonBuf) -> i32 { out_json.len = 0; return 1; } // DEFECT: async placeholder
fn sa_client_activateProvider(client: u64, providerId_ptr: ptr, providerId_len: u64, model_ptr: ptr, model_len: u64, has_model: bool, groupId_ptr: ptr, groupId_len: u64, has_groupId: bool) -> i32 { return 1; } // DEFECT: async placeholder

fn str_eq(a_ptr: ptr, a_len: u64, b_ptr: ptr, b_len: u64) -> bool {
    // REBOUND (2026-10-26, sa_std ts sweep): hand byte-scan replaced by
    // sa_std/ts_string.sa @ts_str_equals; original signature preserved 1:1.
    return @ts_str_equals(a_ptr, a_len, b_ptr, b_len);
}

