// Setter family standing in for the SetStateAction dispatchers returned by the hook.
// DEFECT: SetStateAction<T> (value | updater function) has no SLA counterpart; updater-function form not reproduced.
fn setHistorySearchTerm(s: &UseHistoryState, v_ptr: ptr, v_len: u64) -> i32 { s.historySearchTerm_ptr = v_ptr; s.historySearchTerm_len = v_len; s.historySearchTermRef_ptr = v_ptr; s.historySearchTermRef_len = v_len; return 0; }
fn setHistoryLoading(s: &UseHistoryState, v: bool) -> i32 { s.historyLoading = v; return 0; }
fn setHistoryLoadProgress(s: &UseHistoryState, v: &HistoryLoadProgress, is_null: bool) -> i32 { s.historyLoadProgress = v; s.historyLoadProgress_is_null = is_null; return 0; }
fn setHistoryDateRange(s: &UseHistoryState, v_ptr: ptr, v_len: u64) -> i32 { s.historyDateRange_ptr = v_ptr; s.historyDateRange_len = v_len; return 0; }
fn setHistoryViewMode(s: &UseHistoryState, v_ptr: ptr, v_len: u64) -> i32 { s.historyViewMode_ptr = v_ptr; s.historyViewMode_len = v_len; return 0; }
fn setHistoryBackendFilter(s: &UseHistoryState, v_ptr: ptr, v_len: u64) -> i32 { s.historyBackendFilter_ptr = v_ptr; s.historyBackendFilter_len = v_len; return 0; }
fn setThreadHistoryPages(s: &UseHistoryState, json_ptr: ptr, json_len: u64) -> i32 { s.threadHistoryPages_json_ptr = json_ptr; s.threadHistoryPages_json_len = json_len; return 0; }
fn setThreadLoadProgress(s: &UseHistoryState, v: &ThreadLoadProgress, is_null: bool) -> i32 { s.threadLoadProgress = v; s.threadLoadProgress_is_null = is_null; return 0; }
