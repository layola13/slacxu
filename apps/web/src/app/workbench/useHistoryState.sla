@import "sa_std/io/print.sai"

// DEFECT: React hooks (useState/useRef) have no SLA counterpart; hook state modelled as a plain struct + setter functions, reactivity / re-render not reproduced.
// DEFECT: dynamic object Record<string, ThreadHistoryPageState> approximated as JSON text buffer.
// DEFECT: generic useState<T> / lazy initializer closures have no SLA counterpart.

struct ThreadHistoryPageState {
    json_ptr: ptr,
    json_len: u64,
}

struct HistoryLoadProgress {
    value: u64,
    label_ptr: ptr,
    label_len: u64,
}

struct ThreadLoadProgress {
    json_ptr: ptr,
    json_len: u64,
}

struct UseHistoryState {
    historySearchTerm_ptr: ptr,
    historySearchTerm_len: u64,
    historyLoading: bool,
    historyLoadProgress: HistoryLoadProgress,
    historyLoadProgress_is_null: bool,
    // HistoryDateRangeFilter / HistoryViewMode / HistoryBackendFilter: string unions approximated as (ptr,len)
    historyDateRange_ptr: ptr,
    historyDateRange_len: u64,
    historyViewMode_ptr: ptr,
    historyViewMode_len: u64,
    historyBackendFilter_ptr: ptr,
    historyBackendFilter_len: u64,
    historyBackendFilterUserTouchedRef: bool,
    threadHistoryPages_json_ptr: ptr,
    threadHistoryPages_json_len: u64,
    // ClientState["threads"] array approximated as JSON text buffer
    allHistoryThreadsRef_json_ptr: ptr,
    allHistoryThreadsRef_json_len: u64,
    historySearchTermRef_ptr: ptr,
    historySearchTermRef_len: u64,
    historyLoadRequestRef: u64,
    historyFullyLoadedRef: bool,
    initialHistoryListStartedRef: bool,
    threadHistoryPagesRef_json_ptr: ptr,
    threadHistoryPagesRef_json_len: u64,
    threadLoadProgress: ThreadLoadProgress,
    threadLoadProgress_is_null: bool,
}

