fn normalizeSkillPath(value_ptr: ptr, value_len: u64) -> i32 {
    return value.trim().replace(/\\/g, "/").replace(/\/+/g, "/").replace(/^(\.\/)+/, "");
}

fn isWindowsPath(value_ptr: ptr, value_len: u64) -> bool {
    return /^[A-Za-z]:\//.test(value) || value.startsWith("//");
}

