// Converted 1:1 from apps/web/src/app/claude/claudeStartupStage.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "sa_std/ptr.sa"

/**
 * Claude CLI 启动分阶段状态（composer 状态栏展示）。
 *
 * Cold start on Windows takes 10s+ (cmd shim + JS bundle + MCP attach), so
 * the first `turn/start` can hit the 20s RPC timeout while the child is
 * still handshaking. These stages make the invisible visible:
 * `spawning`（正在启动 Claude）→ `handshake`（等待 CLI init 握手）
 * → `ready` / `failed`.
 */
// TS: export type ClaudeStartupStage = "spawning" | "handshake" | "ready" | "failed"
let ClaudeStartupStage_SPAWNING: u64 = 0; // union member "spawning"
let ClaudeStartupStage_HANDSHAKE: u64 = 1; // union member "handshake"
let ClaudeStartupStage_READY: u64 = 2; // union member "ready"
let ClaudeStartupStage_FAILED: u64 = 3; // union member "failed"

// TS: export type ClaudeStartupStatus = { ... }
struct ClaudeStartupStatus {
    stage: ClaudeStartupStage,
    at: f64,
    error: [u8; 256],
    error_len: u64,
}

// TS: export const STAGES = const STAGES: ClaudeStartupStage[] = ["spawning", "handshake", "ready", "failed"];
// DEFECT: dynamic object/array literal — kept as JSON text buffer
let STAGES_json_len: u64 = 0; // JSON buffer filled in fix phase

fn isClaudeStartupStage(value_json_ptr: ptr, value_json_len: u64) -> value_is_ClaudeStartupStage {
    return typeof value == "string" && (STAGES as string[]).includes(value);
}

fn parseClaudeStartupStatus(value_json_ptr: ptr, value_json_len: u64) -> i32 {
    if (!value || typeof value != "object" || Array.isArray(value)) return null;
    let record = value as Record<string, unknown>;
    let threadId = typeof record.threadId == "string" ? record.threadId.trim()
    : typeof record.thread_id == "string" ? record.thread_id.trim() : "";
    let stage = record.stage;
    if (!threadId || !isClaudeStartupStage(stage)) return null;
    let at = typeof record.at == "number" && Number.isFinite(record.at) ? record.at : Date.now();
    let error = typeof record.error == "string" && record.error.trim() ? record.error.trim() : undefined;
    // DEFECT: spread
    // TS: return { threadId, status: { stage, at, ...(error ? { error } : {}) } };
    return 0; // placeholder — see TS line above
}

fn claudeStartupStageLocaleKey(stage: ClaudeStartupStage) -> i32 {
    // DEFECT: template literal
    // TS: return `composer.claudeStartup.${stage}`;
    return 0; // placeholder — see TS line above
}

