// Converted 1:1 from apps/web/src/contextUsage.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.

const CONTEXT_USAGE_BASELINE_TOKENS: u64 = 12000;
const DEFAULT_CONTEXT_WINDOW_TOKENS: u64 = 272000; // Product default context window (mirrors engine catalog fallback).

struct ContextUsageInput { usedTokens: u64, contextWindow: u64, contextWindow_isNull: bool }
struct ContextUsageMetrics { usedTokens: u64, contextWindow: u64, contextWindow_isNull: bool, ratio: f64, percentage: u64, percentage_isNull: bool }

fn resolveDisplayedContextWindow(threadCW: u64, threadCW_has: bool, configuredCW: u64, configuredCW_has: bool, groupCW: u64, groupCW_has: bool, modelVariantCW: u64, modelVariantCW_has: bool, out_has: &bool) -> u64 {
    // modelVariant >0 authoritative, then group >0, then thread ?? configured ?? null. Math.round on variant/group.
    if modelVariantCW_has && modelVariantCW > 0 { *out_has = true; return modelVariantCW; };
    if groupCW_has && groupCW > 0 { *out_has = true; return groupCW; };
    if threadCW_has { *out_has = true; return threadCW; };
    if configuredCW_has { *out_has = true; return configuredCW; };
    *out_has = false;
    return 0;
}

fn resolveReportedContextWindow(cliBackend_ptr: ptr, cliBackend_len: u64, reportedCW: u64, reportedCW_has: bool, configuredCW: u64, configuredCW_has: bool, groupCW: u64, groupCW_has: bool, modelVariantCW: u64, modelVariantCW_has: bool, out_has: &bool) -> u64 {
    if modelVariantCW_has && modelVariantCW > 0 { *out_has = true; return modelVariantCW; };
    if groupCW_has && groupCW > 0 { *out_has = true; return groupCW; };
    // if cliBackend === "claude" && configured > 0 return configured (unrounded)
    // DEFECT: string equality on (ptr,len) — helper str_eq required in fix stage.
    if configuredCW_has && configuredCW > 0 { *out_has = true; return configuredCW; };
    if reportedCW_has { *out_has = true; return reportedCW; };
    if configuredCW_has { *out_has = true; return configuredCW; };
    *out_has = false;
    return 0;
}

fn resolveContextWindowOverrideUpdate(runtimeModel_ptr: ptr, runtimeModel_len: u64, configuredCW: u64, configuredCW_has: bool, out_isUndefined: &bool) -> u64 {
    // runtimeModel.trim() ? configuredContextWindow : undefined
    *out_isUndefined = runtimeModel_len == 0;
    return configuredCW;
}

fn contextUsageMetrics(usage_has: bool, used_in: u64, cw_in: u64, cw_has: bool, out: &ContextUsageMetrics) -> void {
    out.usedTokens = used_in; // Math.max(0, usage?.usedTokens ?? 0)
    if !usage_has || !cw_has || cw_in == 0 {
        out.contextWindow_isNull = true; out.ratio = 0.0; out.percentage_isNull = true;
        return;
    };
    out.contextWindow = cw_in;
    out.contextWindow_isNull = false;
    let effectiveWindow: u64 = cw_in - CONTEXT_USAGE_BASELINE_TOKENS; // Math.max(1, ...)
    if effectiveWindow < 1 { effectiveWindow = 1; };
    let effectiveUsed: u64 = 0;
    if used_in > CONTEXT_USAGE_BASELINE_TOKENS { effectiveUsed = used_in - CONTEXT_USAGE_BASELINE_TOKENS; };
    let ratio: f64 = (effectiveUsed as f64) / (effectiveWindow as f64); // Math.min(1, ...)
    if ratio > 1.0 { ratio = 1.0; };
    out.ratio = ratio;
    out.percentage_isNull = false;
    out.percentage = 0; // Math.round(ratio * 100) — DEFECT: f64->u64 rounding helper pending
}
