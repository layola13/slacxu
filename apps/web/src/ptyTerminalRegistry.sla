struct BufferSearchState { cursor: i64, lastQuery_ptr: ptr, lastQuery_len: u64, lastCaseSensitive: bool }
struct BufferSearchHit { row: u64, col: u64, length: u64 }

fn createBufferSearch(terminal_fns_ptr: ptr, state: &BufferSearchState) -> void {
    // closure state: cursor=-1, lastQuery="", lastCaseSensitive=false; returns { findNext, findPrevious } object — DEFECT: returned closure object -> state struct + bufferSearch_findNext/findPrevious functions below.
    state.cursor = -1;
    state.lastCaseSensitive = false;
}

fn bufferSearch_collectHits(state: &BufferSearchState, terminal_fns_ptr: ptr, query_ptr: ptr, query_len: u64, caseSensitive: bool, out_hits_ptr: ptr) -> u64 {
    // if !query return []; needle = caseSensitive ? query : query.toLowerCase(); for row in 0..buffer.length: line = getLine(row); if !line continue; text = translateToString(true); haystack case-folded; inner while indexOf(needle, from) >= 0: push {row,col,length: query.length}; from = col + max(1, needle.length); if hits.length > 500 break
    let hits: u64 = 0;
    // DEFECT: xterm line access via callback — row loop skeleton:
    for row in 0..0 { hits = hits + 1; }
    return hits;
}

fn bufferSearch_jump(state: &BufferSearchState, terminal_fns_ptr: ptr, query_ptr: ptr, query_len: u64, caseSensitive: bool, direction: i32) -> bool {
    // if query/case changed: cursor=-1, remember; hits = collectHits; if empty { terminal.clearSelection(); return false; } cursor = direction 1 ? (cursor+1)%len : (cursor-1+len)%len; hit = hits[cursor]; terminal.select(hit.col, hit.row, hit.length); terminal.scrollToLine(hit.row); return true
    return false;
}

fn bufferSearch_findNext(state: &BufferSearchState, terminal_fns_ptr: ptr, query_ptr: ptr, query_len: u64, caseSensitive: bool) -> bool { return bufferSearch_jump(state, terminal_fns_ptr, query_ptr, query_len, caseSensitive, 1); }
fn bufferSearch_findPrevious(state: &BufferSearchState, terminal_fns_ptr: ptr, query_ptr: ptr, query_len: u64, caseSensitive: bool) -> bool { return bufferSearch_jump(state, terminal_fns_ptr, query_ptr, query_len, caseSensitive, -1); }
