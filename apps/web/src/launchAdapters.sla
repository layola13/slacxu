// Converted 1:1 from apps/web/src/launchAdapters.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "sa_std/ptr.sa"
// Catalog of layola13 *-launch adapters. Codex UI uses the Responses API; many OpenAI-compatible relays only speak Chat Completions — users need code-launch (or a sibling launcher) as a bridge.

// LaunchAdapterId union: "code-launch"|"agy-launch"|"claude-launch"|"gemini-launch"|"crush-launch"|"auggie-launch"|"agent-launch"|"coderabbit-launch"|"freebuff-launch"|"grok-launch"|"pi-launch"|"opencode-launch" — (ptr,len) values.
struct LaunchAdapter {
    id_ptr: ptr, id_len: u64,
    name_ptr: ptr, name_len: u64,
    product_ptr: ptr, product_len: u64,
    repo_ptr: ptr, repo_len: u64,
    githubUrl_ptr: ptr, githubUrl_len: u64,
    requiredForCodexUi: bool,
    summaryEn_ptr: ptr, summaryEn_len: u64,
    summaryCn_ptr: ptr, summaryCn_len: u64,
    installHintEn_ptr: ptr, installHintEn_len: u64,
    installHintCn_ptr: ptr, installHintCn_len: u64,
    envPrefix_ptr: ptr, envPrefix_len: u64,
}

const GITHUB_ORG_PTR: ptr = 0; // "https://github.com/layola13"

// LAUNCH_ADAPTERS: 12 entries in source order (id / product / repo / requiredForCodexUi / envPrefix):
// 1 code-launch / Codex CLI / Codex React UI / code-launch / true / CODE_LAUNCH_ — summaryEn: "Translates Codex Responses API ↔ OpenAI Chat Completions. Required when a relay only supports /v1/chat/completions (e.g. many third-party keys)." summaryCn: "将 Codex Responses API 与 OpenAI Chat Completions 互转。当中转站只支持 /v1/chat/completions（多数第三方 key）时必须安装，否则本 UI 无法直接调用。" install: "git clone https://github.com/layola13/code-launch.git && cd code-launch && ./install.sh"
// 2 agy-launch / Antigravity (agy) CLI / agy-launch / false / AGY_LAUNCH_ — "Routes agy model traffic through a local proxy to OpenAI-compatible Chat Completions." / "将 agy 模型流量经本地代理转发到 OpenAI 兼容 Chat Completions。"
// 3 claude-launch / Claude Code CLI / claude-launch / false / CLAUDE_LAUNCH_ — "Translates Anthropic Messages API ↔ OpenAI Chat Completions for Claude Code." / "将 Claude Code 的 Anthropic Messages API 与 Chat Completions 互转。"
// 4 gemini-launch / Gemini CLI / gemini-launch / false / GEMINI_LAUNCH_ — "Routes Gemini CLI traffic to OpenAI-compatible Chat Completions." / "将 Gemini CLI 流量转发到 OpenAI 兼容 Chat Completions。"
// 5 crush-launch / Charm Crush / crush-launch / false / CRUSH_LAUNCH_ — "Env/.env wrapper that generates crush.json for OpenAI-compatible providers." / "用 env/.env 生成 crush.json，对接 OpenAI 兼容服务商。"
// 6 auggie-launch / Augment Code (auggie) / auggie-launch / false / AUGGIE_LAUNCH_ — "Local Augment-compatible proxy → OpenAI Chat Completions." / "本地 Augment 兼容代理 → OpenAI Chat Completions。"
// 7 agent-launch / Agent CLI family / agent-launch / false / AGENT_LAUNCH_ — "Generic launcher pattern for agent CLIs (see repo README)." / "通用 agent CLI 启动器（详见仓库 README）。"
// 8 coderabbit-launch / CodeRabbit CLI / coderabbit-launch / false / CODERABBIT_LAUNCH_ — "MITM proxy rewrite for CodeRabbit local chat-completions traffic." / "对 CodeRabbit 本地 chat-completions 流量做 MITM 重写。"
// 9 freebuff-launch / Freebuff CLI / freebuff-launch / false / FREEBUFF_LAUNCH_ — "HTTPS MITM proxy rewrite for Freebuff model traffic." / "对 Freebuff 模型流量做 HTTPS MITM 重写。"
// 10 grok-launch / Grok / xAI style CLI / grok-launch / false / GROK_LAUNCH_ — "Launcher for Grok-oriented CLI setups (repo: grok-launch)." / "面向 Grok 类 CLI 的启动器（仓库 grok-launch）。"
// 11 pi-launch / Pi coding agent / pi (githubUrl https://github.com/earendil-works/pi) / false / PI_LAUNCH_ — "Runs Pi coding agent in RPC mode with pi-relay extension for custom relays." / "以 RPC 模式运行 Pi coding agent，并通过 pi-relay 扩展接入自定义中转。" install: "npm install -g @earendil-works/pi-coding-agent (or run from E:/projects/pi with Bun)"
// 12 opencode-launch / OpenCode AI coding agent / opencode (githubUrl https://github.com/layola13/opencode) / false / OPENCODE_LAUNCH_ — "Runs OpenCode in serve mode with REST and SSE streaming for full agent workflows." / "以 serve 模式运行 OpenCode，通过 REST 与 SSE 流式输出接入完整智能体工作流。" install: "npm install -g opencode (or run from E:/projects/opencode with Bun)"
// Entries 1-10 githubUrl = `${GITHUB_ORG}/<repo>`; installHintEn/Cn identical clone commands for 1-10.
// DEFECT: template literal githubUrl construction + const array of string records — table stored as parallel literal rows in fix stage; count/accessor preserved here.
fn launch_adapters_count() -> u64 { return 12; }
fn launch_adapter_at(index: u64, out: &LaunchAdapter) -> bool { return index < 12; }

// CODE_LAUNCH = LAUNCH_ADAPTERS.find(a => a.id === "code-launch")!
fn code_launch(out: &LaunchAdapter) -> void { launch_adapter_at(0, out); }

// LAUNCH_REPO_PATTERN = "https://github.com/layola13/xxxxx-launch"; LAUNCH_ORG_URL = GITHUB_ORG
fn launch_repo_pattern() -> u64 { return STR_LEN("https://github.com/layola13/xxxxx-launch"); }

fn relayLikelyNeedsCodeLaunch(kind_ptr: ptr, kind_len: u64, baseUrl_ptr: ptr, baseUrl_len: u64, id_ptr: ptr, id_len: u64, name_ptr: ptr, name_len: u64) -> bool {
    // kind === "openai" -> true
    // chatOnlyHostHints = ["shuaiapi.com","api.deepseek.com","open.bigmodel.cn","api.moonshot.cn","api.minimax.chat","dashscope.aliyuncs.com","api.groq.com","api.together.xyz","openrouter.ai"]; base (lowercased) includes any -> true
    // id includes "shuaiapi" || name includes "shuaiapi" || name includes "grok" -> true
    // base includes "api.openai.com" || "chatgpt.com" -> false
    // kind === "responsesRelay" && base && !base.includes("api.openai.com") -> true
    // else false
    // DEFECT: string includes / toLowerCase on (ptr,len) — substring helper approximation.
    return false;
}

fn codeLaunchCloneCommand(out_ptr: ptr) -> u64 { return STR_LEN("git clone https://github.com/layola13/code-launch.git && cd code-launch && ./install.sh"); }
