// DEFECT: dynamic provider/channel objects -> JSON text buffers.
struct CompactionChannelOption {
    json_ptr: ptr, json_len: u64,
    providerId_ptr: ptr, providerId_len: u64,
    groupId_ptr: ptr, groupId_len: u64,
    providerName_ptr: ptr, providerName_len: u64,
    models: [u8; 4096], models_len: u64,
}

struct FreeCompactionReadiness {
    ok: bool,
    reason_ptr: ptr, reason_len: u64, has_reason: bool,
    detail_ptr: ptr, detail_len: u64, has_detail: bool,
    providerId_ptr: ptr, providerId_len: u64,
    model_ptr: ptr, model_len: u64,
}

// DEFECT: ThreadRuntimeSelection is a large dynamic object -> JSON text buffer + accessor fields.
struct ThreadRuntimeSelection {
    json_ptr: ptr, json_len: u64,
    freeAutoCompactEnabled: bool,
    freeAutoCompactThreshold: u64,
    freeAutoCompactModel_ptr: ptr, freeAutoCompactModel_len: u64, has_freeAutoCompactModel: bool,
    freeAutoCompactProviderId_ptr: ptr, freeAutoCompactProviderId_len: u64, has_freeAutoCompactProviderId: bool,
    freeAutoCompactGroupId_ptr: ptr, freeAutoCompactGroupId_len: u64, has_freeAutoCompactGroupId: bool,
    compactMode: u64, // CompactMode tag: 0="off", 1="cheap", 2="jev-sub", 3="jev-token"
    jevCompressThreshold: u64,
    vmPolicy_json_ptr: ptr, vmPolicy_json_len: u64, has_vmPolicy: bool,
    vmTools_jevCompress: bool, vmTools_clearToolHistory: bool, vmTools_jevThinking: bool, vmTools_jevChecklist: bool, has_vmTools: bool,
}

// Hook input: { state, dispatch, runtimeSelection, selectedModel, setSlashNotice,
// freeAutoCompactBusyRef, workspaceMode, setFreeModelAccessOpen } & Pick<domain,
// "selectionForThread" | "updateRuntimeSelectionForKey">
// DEFECT: React hook + Dispatch/SetStateAction/MutableRefObject closures -> plain struct of
// host callback ids + state snapshots; hooks semantics (re-render on state change) not preserved.
struct UseFreeCompactionSelectionInput {
    state_json_ptr: ptr, state_json_len: u64,
    activeThreadId_ptr: ptr, activeThreadId_len: u64, has_activeThreadId: bool,
    providers_json_ptr: ptr, providers_json_len: u64,
    dispatch_cb: u64,
    runtimeSelection: ThreadRuntimeSelection,
    selectedModel_ptr: ptr, selectedModel_len: u64,
    setSlashNotice_cb: u64,
    freeAutoCompactBusy: bool, // MutableRefObject<boolean>.current snapshot
    workspaceMode: u64, // 0 = "local", 1 = other (WorkspaceMode string union)
    setFreeModelAccessOpen_cb: u64,
    selectionForThread_cb: u64,
    updateRuntimeSelectionForKey_cb: u64,
}

struct UseFreeCompactionSelectionResult {
    freeAutoCompactEnabled: bool,
    freeAutoCompactThreshold: u64,
    freeAutoCompactModel_ptr: ptr, freeAutoCompactModel_len: u64, has_freeAutoCompactModel: bool,
    freeAutoCompactProviderId_ptr: ptr, freeAutoCompactProviderId_len: u64, has_freeAutoCompactProviderId: bool,
    freeAutoCompactGroupId_ptr: ptr, freeAutoCompactGroupId_len: u64, has_freeAutoCompactGroupId: bool,
    compactMode: u64,
    jevCompressThreshold: u64,
    channelOptions: [CompactionChannelOption; 64], channelOptions_len: u64,
    has_selectedChannel: bool, selectedChannel: CompactionChannelOption,
    providerOptions_json_ptr: ptr, providerOptions_json_len: u64,
    groupOptions: [CompactionChannelOption; 64], groupOptions_len: u64,
    models_ptr: ptr, models_len: u64,
    freeCompactionReadiness: FreeCompactionReadiness,
    compactCapabilityWarning_ptr: ptr, compactCapabilityWarning_len: u64, has_compactCapabilityWarning: bool,
}

