}

// TS: export type CodexConfigFieldKey = keyof CodexConfigQuickView;
// (a field-key string: "model" | "reviewModel" | ... — passed as (ptr,len))

// TS: export type CodexConfigEdit = { keyPath: string; value: JsonValue; mergeStrategy: "replace" }
struct CodexConfigEdit {
    keyPath: StrBuf,
    value: JsonBufSmall,
    mergeStrategy: StrBuf,
}

// TS: type JsonSchemaLike = JsonSchema | boolean;
// TS: type JsonSchema = { $ref?, allOf?, anyOf?, oneOf?, type?, enum?,
//   const?, default?, description?, title?, properties?,
//   additionalProperties?, items? }
// DEFECT: dynamic JSON schema object — represented by its JSON text buffer
// (JsonBuf); field access goes through the sa_json_* helpers.

// TS: export type DynamicCodexConfigField = { keyPath, label, description,
//   kind, group, options?, defaultValue?, readOnly?, source }
struct FieldOption {
    value: StrBuf,
    label: StrBuf,
}

struct DynamicCodexConfigField {
    keyPath: StrBuf,
    label: StrBuf,
    description: StrBuf,
    kind: u64,
    group: StrBuf,
    options: [FieldOption; 16],
    options_len: u64,
    has_defaultValue: bool,
    defaultValue: JsonBufSmall,
    has_readOnly: bool,
    readOnly: bool,
    source: u64,
}

struct DynamicFieldList {
    fields: [DynamicCodexConfigField; 128],
    len: u64,
}

// TS: const schemaRoot = codexConfigSchema as unknown as JsonSchema & { definitions?: ... }
// DEFECT: compile-time JSON import has no SLA counterpart; the schema text
// is supplied at runtime into a schemaRoot buffer by the host (fix phase:
// embed the bundled codexConfigSchema.json). All schema functions below take
// schemaRoot as an explicit first parameter where TS closes over it.
struct SchemaRoot {
    json: JsonBuf,
}

// TS: export const CODEX_CONFIG_KEY_PATHS: Record<CodexConfigFieldKey, string>
fn codexConfigKeyPath(fieldKey_ptr: ptr, fieldKey_len: u64, out: &StrBuf) -> bool {
    if strBufEqBytes(fieldKey_ptr, fieldKey_len, STR_PTR("model"), STR_LEN("model")) { strBufSet(out, STR_PTR("model"), STR_LEN("model")); return true; };
    if strBufEqBytes(fieldKey_ptr, fieldKey_len, STR_PTR("reviewModel"), STR_LEN("reviewModel")) { strBufSet(out, STR_PTR("review_model"), STR_LEN("review_model")); return true; };
    if strBufEqBytes(fieldKey_ptr, fieldKey_len, STR_PTR("modelProvider"), STR_LEN("modelProvider")) { strBufSet(out, STR_PTR("model_provider"), STR_LEN("model_provider")); return true; };
    if strBufEqBytes(fieldKey_ptr, fieldKey_len, STR_PTR("modelReasoningEffort"), STR_LEN("modelReasoningEffort")) { strBufSet(out, STR_PTR("model_reasoning_effort"), STR_LEN("model_reasoning_effort")); return true; };
    if strBufEqBytes(fieldKey_ptr, fieldKey_len, STR_PTR("modelReasoningSummary"), STR_LEN("modelReasoningSummary")) { strBufSet(out, STR_PTR("model_reasoning_summary"), STR_LEN("model_reasoning_summary")); return true; };
    if strBufEqBytes(fieldKey_ptr, fieldKey_len, STR_PTR("modelVerbosity"), STR_LEN("modelVerbosity")) { strBufSet(out, STR_PTR("model_verbosity"), STR_LEN("model_verbosity")); return true; };
    if strBufEqBytes(fieldKey_ptr, fieldKey_len, STR_PTR("approvalPolicy"), STR_LEN("approvalPolicy")) { strBufSet(out, STR_PTR("approval_policy"), STR_LEN("approval_policy")); return true; };
    if strBufEqBytes(fieldKey_ptr, fieldKey_len, STR_PTR("sandboxMode"), STR_LEN("sandboxMode")) { strBufSet(out, STR_PTR("sandbox_mode"), STR_LEN("sandbox_mode")); return true; };
    if strBufEqBytes(fieldKey_ptr, fieldKey_len, STR_PTR("webSearch"), STR_LEN("webSearch")) { strBufSet(out, STR_PTR("web_search"), STR_LEN("web_search")); return true; };
    if strBufEqBytes(fieldKey_ptr, fieldKey_len, STR_PTR("serviceTier"), STR_LEN("serviceTier")) { strBufSet(out, STR_PTR("service_tier"), STR_LEN("service_tier")); return true; };
    if strBufEqBytes(fieldKey_ptr, fieldKey_len, STR_PTR("instructions"), STR_LEN("instructions")) { strBufSet(out, STR_PTR("instructions"), STR_LEN("instructions")); return true; };
    if strBufEqBytes(fieldKey_ptr, fieldKey_len, STR_PTR("developerInstructions"), STR_LEN("developerInstructions")) { strBufSet(out, STR_PTR("developer_instructions"), STR_LEN("developer_instructions")); return true; };
    return false;
}

fn strBufEqBytes(a_ptr: ptr, a_len: u64, b_ptr: ptr, b_len: u64) -> bool {
    if a_len != b_len { return false; };
    for j in 0..a_len {
        let x: u8 = 0;
        let y: u8 = 0;
        PTR_BYTE_AT(x, a_ptr, j);
        PTR_BYTE_AT(y, b_ptr, j);
        if x != y { return false; };
    }
    return true;
}

// TS: export const CODEX_CONFIG_FIELD_META: Array<{ key, keyPath, label,
//   description, kind: "text"|"select"|"textarea", options?, readOnly? }>
// (12 entries, source order preserved by codexConfigFieldMetaAt)
struct CodexConfigFieldMeta {
    key: StrBuf,
    keyPath: StrBuf,
    label: StrBuf,
    description: StrBuf,
    kind: u64,
    options: [FieldOption; 8],
    options_len: u64,
    has_readOnly: bool,
    readOnly: bool,
}

fn metaAddOption(meta: &CodexConfigFieldMeta, value_ptr: ptr, value_len: u64, label_ptr: ptr, label_len: u64) -> void {
    if meta.options_len >= 8 { return; };
    strBufSet(&meta.options[meta.options_len].value, value_ptr, value_len);
    strBufSet(&meta.options[meta.options_len].label, label_ptr, label_len);
    meta.options_len = meta.options_len + 1;
}

fn codexConfigFieldMetaCount() -> u64 { return 12; }

fn codexConfigFieldMetaAt(index: u64, out: &CodexConfigFieldMeta) -> bool {
    out.options_len = 0;
    out.has_readOnly = false;
    out.readOnly = false;
    if index == 0 {
        strBufSet(&out.key, STR_PTR("model"), STR_LEN("model"));
        strBufSet(&out.keyPath, STR_PTR("model"), STR_LEN("model"));
        strBufSet(&out.label, STR_PTR("Default model"), STR_LEN("Default model"));
        strBufSet(&out.description, STR_PTR("Codex user config model default (provider activation may override for the active session)."), STR_LEN("Codex user config model default (provider activation may override for the active session)."));
        out.kind = KIND_TEXT();
        return true;
    };
    if index == 1 {
        strBufSet(&out.key, STR_PTR("reviewModel"), STR_LEN("reviewModel"));
        strBufSet(&out.keyPath, STR_PTR("review_model"), STR_LEN("review_model"));
        strBufSet(&out.label, STR_PTR("Review model"), STR_LEN("Review model"));
        strBufSet(&out.description, STR_PTR("Optional review_model used for review sessions."), STR_LEN("Optional review_model used for review sessions."));
        out.kind = KIND_TEXT();
        return true;
    };
    if index == 2 {
        strBufSet(&out.key, STR_PTR("modelProvider"), STR_LEN("modelProvider"));
        strBufSet(&out.keyPath, STR_PTR("model_provider"), STR_LEN("model_provider"));
        strBufSet(&out.label, STR_PTR("Model provider"), STR_LEN("Model provider"));
        strBufSet(&out.description, STR_PTR("Engine model_provider key. Third-party relays are activated from the Config inspector, not rewritten as API keys here."), STR_LEN("Engine model_provider key. Third-party relays are activated from the Config inspector, not rewritten as API keys here."));
        out.kind = KIND_TEXT();
        out.has_readOnly = true;
        out.readOnly = true;
        return true;
    };
    if index == 3 {
        strBufSet(&out.key, STR_PTR("modelReasoningEffort"), STR_LEN("modelReasoningEffort"));
        strBufSet(&out.keyPath, STR_PTR("model_reasoning_effort"), STR_LEN("model_reasoning_effort"));
        strBufSet(&out.label, STR_PTR("Default reasoning effort"), STR_LEN("Default reasoning effort"));
        strBufSet(&out.description, STR_PTR("Persisted model_reasoning_effort in user config.toml."), STR_LEN("Persisted model_reasoning_effort in user config.toml."));
        out.kind = KIND_SELECT();
        metaAddOption(out, STR_PTR("low"), STR_LEN("low"), STR_PTR("Low"), STR_LEN("Low"));
        metaAddOption(out, STR_PTR("medium"), STR_LEN("medium"), STR_PTR("Medium"), STR_LEN("Medium"));
        metaAddOption(out, STR_PTR("high"), STR_LEN("high"), STR_PTR("High"), STR_LEN("High"));
        metaAddOption(out, STR_PTR("xhigh"), STR_LEN("xhigh"), STR_PTR("Extra high"), STR_LEN("Extra high"));
        return true;
    };
    if index == 4 {
        strBufSet(&out.key, STR_PTR("modelReasoningSummary"), STR_LEN("modelReasoningSummary"));
        strBufSet(&out.keyPath, STR_PTR("model_reasoning_summary"), STR_LEN("model_reasoning_summary"));
        strBufSet(&out.label, STR_PTR("Reasoning summary"), STR_LEN("Reasoning summary"));
        strBufSet(&out.description, STR_PTR("Persisted model_reasoning_summary."), STR_LEN("Persisted model_reasoning_summary."));
        out.kind = KIND_SELECT();
        metaAddOption(out, STR_PTR("auto"), STR_LEN("auto"), STR_PTR("Auto"), STR_LEN("Auto"));
        metaAddOption(out, STR_PTR("concise"), STR_LEN("concise"), STR_PTR("Concise"), STR_LEN("Concise"));
        metaAddOption(out, STR_PTR("detailed"), STR_LEN("detailed"), STR_PTR("Detailed"), STR_LEN("Detailed"));
        metaAddOption(out, STR_PTR("none"), STR_LEN("none"), STR_PTR("None"), STR_LEN("None"));
        return true;
    };
    if index == 5 {
        strBufSet(&out.key, STR_PTR("modelVerbosity"), STR_LEN("modelVerbosity"));
        strBufSet(&out.keyPath, STR_PTR("model_verbosity"), STR_LEN("model_verbosity"));
        strBufSet(&out.label, STR_PTR("Model verbosity"), STR_LEN("Model verbosity"));
        strBufSet(&out.description, STR_PTR("Persisted model_verbosity for Responses models."), STR_LEN("Persisted model_verbosity for Responses models."));
        out.kind = KIND_SELECT();
        metaAddOption(out, STR_PTR("low"), STR_LEN("low"), STR_PTR("Low"), STR_LEN("Low"));
        metaAddOption(out, STR_PTR("medium"), STR_LEN("medium"), STR_PTR("Medium"), STR_LEN("Medium"));
        metaAddOption(out, STR_PTR("high"), STR_LEN("high"), STR_PTR("High"), STR_LEN("High"));
        return true;
    };
    if index == 6 {
        strBufSet(&out.key, STR_PTR("serviceTier"), STR_LEN("serviceTier"));
        strBufSet(&out.keyPath, STR_PTR("service_tier"), STR_LEN("service_tier"));
        strBufSet(&out.label, STR_PTR("Service tier"), STR_LEN("Service tier"));
        strBufSet(&out.description, STR_PTR("Optional service_tier for model requests."), STR_LEN("Optional service_tier for model requests."));
        out.kind = KIND_TEXT();
        return true;
    };
    if index == 7 {
        strBufSet(&out.key, STR_PTR("approvalPolicy"), STR_LEN("approvalPolicy"));
        strBufSet(&out.keyPath, STR_PTR("approval_policy"), STR_LEN("approval_policy"));
        strBufSet(&out.label, STR_PTR("Approval policy"), STR_LEN("Approval policy"));
        strBufSet(&out.description, STR_PTR("Default approval_policy for new threads (string forms only)."), STR_LEN("Default approval_policy for new threads (string forms only)."));
        out.kind = KIND_SELECT();
        metaAddOption(out, STR_PTR("untrusted"), STR_LEN("untrusted"), STR_PTR("Untrusted"), STR_LEN("Untrusted"));
        metaAddOption(out, STR_PTR("on-request"), STR_LEN("on-request"), STR_PTR("On request"), STR_LEN("On request"));
        metaAddOption(out, STR_PTR("never"), STR_LEN("never"), STR_PTR("Never"), STR_LEN("Never"));
        return true;
    };
    if index == 8 {
        strBufSet(&out.key, STR_PTR("sandboxMode"), STR_LEN("sandboxMode"));
        strBufSet(&out.keyPath, STR_PTR("sandbox_mode"), STR_LEN("sandbox_mode"));
        strBufSet(&out.label, STR_PTR("Sandbox mode"), STR_LEN("Sandbox mode"));
        strBufSet(&out.description, STR_PTR("Default sandbox_mode for command execution."), STR_LEN("Default sandbox_mode for command execution."));
        out.kind = KIND_SELECT();
        metaAddOption(out, STR_PTR("read-only"), STR_LEN("read-only"), STR_PTR("Read only"), STR_LEN("Read only"));
        metaAddOption(out, STR_PTR("workspace-write"), STR_LEN("workspace-write"), STR_PTR("Workspace write"), STR_LEN("Workspace write"));
        metaAddOption(out, STR_PTR("danger-full-access"), STR_LEN("danger-full-access"), STR_PTR("Danger full access"), STR_LEN("Danger full access"));
        return true;
    };
    if index == 9 {
        strBufSet(&out.key, STR_PTR("webSearch"), STR_LEN("webSearch"));
        strBufSet(&out.keyPath, STR_PTR("web_search"), STR_LEN("web_search"));
        strBufSet(&out.label, STR_PTR("Web search"), STR_LEN("Web search"));
        strBufSet(&out.description, STR_PTR("Default web_search mode."), STR_LEN("Default web_search mode."));
        out.kind = KIND_SELECT();
        metaAddOption(out, STR_PTR("disabled"), STR_LEN("disabled"), STR_PTR("Disabled"), STR_LEN("Disabled"));
        metaAddOption(out, STR_PTR("cached"), STR_LEN("cached"), STR_PTR("Cached"), STR_LEN("Cached"));
        metaAddOption(out, STR_PTR("indexed"), STR_LEN("indexed"), STR_PTR("Indexed"), STR_LEN("Indexed"));
        metaAddOption(out, STR_PTR("live"), STR_LEN("live"), STR_PTR("Live"), STR_LEN("Live"));
        return true;
    };
    if index == 10 {
        strBufSet(&out.key, STR_PTR("instructions"), STR_LEN("instructions"));
        strBufSet(&out.keyPath, STR_PTR("instructions"), STR_LEN("instructions"));
        strBufSet(&out.label, STR_PTR("User instructions"), STR_LEN("User instructions"));
        strBufSet(&out.description, STR_PTR("Persisted instructions prepended for Codex sessions."), STR_LEN("Persisted instructions prepended for Codex sessions."));
        out.kind = KIND_TEXTAREA();
        return true;
    };
    if index == 11 {
        strBufSet(&out.key, STR_PTR("developerInstructions"), STR_LEN("developerInstructions"));
        strBufSet(&out.keyPath, STR_PTR("developer_instructions"), STR_LEN("developer_instructions"));
        strBufSet(&out.label, STR_PTR("Developer instructions"), STR_LEN("Developer instructions"));
        strBufSet(&out.description, STR_PTR("Persisted developer_instructions for engine-level guidance."), STR_LEN("Persisted developer_instructions for engine-level guidance."));
        out.kind = KIND_TEXTAREA();
        return true;
    };
    return false;
}

fn findFieldMeta(fieldKey_ptr: ptr, fieldKey_len: u64, out: &CodexConfigFieldMeta) -> bool {
    for i in 0..codexConfigFieldMetaCount() {
        if codexConfigFieldMetaAt(i, out) {
            let kp: ptr = PTR_NULL();
            PTR_BYTE_ADD(kp, &out.key.bytes, 0);
            if strBufEqBytes(fieldKey_ptr, fieldKey_len, kp, out.key.len) { return true; };
        };
    }
    return false;
}

// TS: export const EMPTY_CODEX_USER_CONFIG: CodexUserConfigView = { ...all null, rawConfig: {} }
fn emptyCodexUserConfig(out: &CodexUserConfigView) -> void {
    out.model.has = false; out.model.len = 0;
    out.reviewModel.has = false; out.reviewModel.len = 0;
    out.modelProvider.has = false; out.modelProvider.len = 0;
    out.modelReasoningEffort.has = false; out.modelReasoningEffort.len = 0;
    out.modelReasoningSummary.has = false; out.modelReasoningSummary.len = 0;
    out.modelVerbosity.has = false; out.modelVerbosity.len = 0;
    out.approvalPolicy.has = false; out.approvalPolicy.len = 0;
    out.sandboxMode.has = false; out.sandboxMode.len = 0;
    out.webSearch.has = false; out.webSearch.len = 0;
    out.serviceTier.has = false; out.serviceTier.len = 0;
    out.instructions.has = false; out.instructions.len = 0;
    out.developerInstructions.has = false; out.developerInstructions.len = 0;
    jsonBufSet(&out.rawConfig, STR_PTR("{}"), STR_LEN("{}"));
}

// ---- helpers for the functions below ----

struct BigStr {
    bytes: [u8; 8192],
    len: u64,
}

fn jsonBufIsObject(value: &JsonBuf) -> bool {
    for j in 0..value.len {
        let b = value.bytes[j];
        if b == 32 || b == 9 || b == 10 || b == 13 { continue; };
        return b == 123;
    }
    return false;
}

// DEFECT: assumed sa_json_object_get_value_text extern — raw JSON text of an
// object field (fix phase to wire).
fn jsonObjectGetValueText(obj_ptr: ptr, obj_len: u64, key_ptr: ptr, key_len: u64, out: &JsonBuf) -> bool {
    let vp: ptr = PTR_NULL();
    let vl: u64 = 0;
    if sa_json_object_get_value_text(obj_ptr, obj_len, key_ptr, key_len, &vp, &vl) != 0 { return false; };
    jsonBufSet(out, vp, vl);
    return true;
}

// DEFECT: assumed sa_json_parse_scalar extern — classify a standalone JSON
// value text (fix phase).
fn jsonValueToScalar(value: &JsonBuf, out: &JsonScalar) -> void {
    let vp: ptr = PTR_NULL();
    PTR_BYTE_ADD(vp, &value.bytes, 0);
    let kind: u64 = 0;
    let tp: ptr = PTR_NULL();
    let tl: u64 = 0;
    let num: f64 = 0.0;
    let boolean = false;
    sa_json_parse_scalar(vp, value.len, &kind, &tp, &tl, &num, &boolean);
    out.kind = kind;
    strBufSet(&out.text, tp, tl);
    out.num = num;
    out.boolean = boolean;
}

fn splitKeyPath(keyPath_ptr: ptr, keyPath_len: u64, out: &StrList) -> void {
    out.len = 0;
    let segStart: u64 = 0;
    let i: u64 = 0;
    while i <= keyPath_len {
        let atEnd = i == keyPath_len;
        let isDot = false;
        if !atEnd {
            let b: u8 = 0;
            PTR_BYTE_AT(b, keyPath_ptr, i);
            isDot = b == 46;
        };
        if atEnd || isDot {
            // push segment [segStart, i) — empty segments are pushed too;
            // callers replicate TS .split(".") / .filter(Boolean) as needed.
            if out.len < 64 {
                let n = i - segStart;
                if n > 256 { n = 256; };
                for j in 0..n {
                    let b: u8 = 0;
                    PTR_BYTE_AT(b, keyPath_ptr, segStart + j);
                    out.items[out.len][j] = b;
                }
                out.lens[out.len] = n;
                out.len = out.len + 1;
            };
            segStart = i + 1;
        };
        i = i + 1;
    }
}

fn joinStrList(list: &StrList, sep_ptr: ptr, sep_len: u64, out: &StrBuf) -> void {
    out.len = 0;
    for i in 0..list.len {
        if i > 0 {
            for j in 0..sep_len {
                let b: u8 = 0;
                PTR_BYTE_AT(b, sep_ptr, j);
                if out.len < 1024 { out.bytes[out.len] = b; out.len = out.len + 1; };
            }
        };
        for j in 0..list.lens[i] {
            if out.len < 1024 { out.bytes[out.len] = list.items[i][j]; out.len = out.len + 1; };
        }
    }
}

fn getViewFieldByKey(view: &CodexUserConfigView, key_ptr: ptr, key_len: u64, out: &TextField) -> bool {
    if strBufEqBytes(key_ptr, key_len, STR_PTR("model"), STR_LEN("model")) { *out = view.model; return true; };
    if strBufEqBytes(key_ptr, key_len, STR_PTR("reviewModel"), STR_LEN("reviewModel")) { *out = view.reviewModel; return true; };
    if strBufEqBytes(key_ptr, key_len, STR_PTR("modelProvider"), STR_LEN("modelProvider")) { *out = view.modelProvider; return true; };
    if strBufEqBytes(key_ptr, key_len, STR_PTR("modelReasoningEffort"), STR_LEN("modelReasoningEffort")) { *out = view.modelReasoningEffort; return true; };
    if strBufEqBytes(key_ptr, key_len, STR_PTR("modelReasoningSummary"), STR_LEN("modelReasoningSummary")) { *out = view.modelReasoningSummary; return true; };
    if strBufEqBytes(key_ptr, key_len, STR_PTR("modelVerbosity"), STR_LEN("modelVerbosity")) { *out = view.modelVerbosity; return true; };
    if strBufEqBytes(key_ptr, key_len, STR_PTR("approvalPolicy"), STR_LEN("approvalPolicy")) { *out = view.approvalPolicy; return true; };
    if strBufEqBytes(key_ptr, key_len, STR_PTR("sandboxMode"), STR_LEN("sandboxMode")) { *out = view.sandboxMode; return true; };
    if strBufEqBytes(key_ptr, key_len, STR_PTR("webSearch"), STR_LEN("webSearch")) { *out = view.webSearch; return true; };
    if strBufEqBytes(key_ptr, key_len, STR_PTR("serviceTier"), STR_LEN("serviceTier")) { *out = view.serviceTier; return true; };
    if strBufEqBytes(key_ptr, key_len, STR_PTR("instructions"), STR_LEN("instructions")) { *out = view.instructions; return true; };
    if strBufEqBytes(key_ptr, key_len, STR_PTR("developerInstructions"), STR_LEN("developerInstructions")) { *out = view.developerInstructions; return true; };
    return false;
}

fn setViewFieldByKey(view: &CodexUserConfigView, key_ptr: ptr, key_len: u64, value: &TextField) -> bool {
    if strBufEqBytes(key_ptr, key_len, STR_PTR("model"), STR_LEN("model")) { view.model = *value; return true; };
    if strBufEqBytes(key_ptr, key_len, STR_PTR("reviewModel"), STR_LEN("reviewModel")) { view.reviewModel = *value; return true; };
    if strBufEqBytes(key_ptr, key_len, STR_PTR("modelProvider"), STR_LEN("modelProvider")) { view.modelProvider = *value; return true; };
    if strBufEqBytes(key_ptr, key_len, STR_PTR("modelReasoningEffort"), STR_LEN("modelReasoningEffort")) { view.modelReasoningEffort = *value; return true; };
    if strBufEqBytes(key_ptr, key_len, STR_PTR("modelReasoningSummary"), STR_LEN("modelReasoningSummary")) { view.modelReasoningSummary = *value; return true; };
    if strBufEqBytes(key_ptr, key_len, STR_PTR("modelVerbosity"), STR_LEN("modelVerbosity")) { view.modelVerbosity = *value; return true; };
    if strBufEqBytes(key_ptr, key_len, STR_PTR("approvalPolicy"), STR_LEN("approvalPolicy")) { view.approvalPolicy = *value; return true; };
    if strBufEqBytes(key_ptr, key_len, STR_PTR("sandboxMode"), STR_LEN("sandboxMode")) { view.sandboxMode = *value; return true; };
    if strBufEqBytes(key_ptr, key_len, STR_PTR("webSearch"), STR_LEN("webSearch")) { view.webSearch = *value; return true; };
    if strBufEqBytes(key_ptr, key_len, STR_PTR("serviceTier"), STR_LEN("serviceTier")) { view.serviceTier = *value; return true; };
    if strBufEqBytes(key_ptr, key_len, STR_PTR("instructions"), STR_LEN("instructions")) { view.instructions = *value; return true; };
    if strBufEqBytes(key_ptr, key_len, STR_PTR("developerInstructions"), STR_LEN("developerInstructions")) { view.developerInstructions = *value; return true; };
    return false;
}

fn textFieldEq(a: &TextField, b: &TextField) -> bool {
    if a.has != b.has { return false; };
    if !a.has { return true; };
    if a.len != b.len { return false; };
    for j in 0..a.len { if a.bytes[j] != b.bytes[j] { return false; }; }
    return true;
}

// TS: export function asRecord(value: unknown): Record<string, unknown>
//   return value && typeof value === "object" && !Array.isArray(value) ? value : {};
fn asRecord(value: &JsonBuf, out: &JsonBuf) -> void {
    if jsonBufIsObject(value) { jsonBufCopy(out, value); return; };
    jsonBufSet(out, STR_PTR("{}"), STR_LEN("{}"));
}

// TS: function asNullableString(value: unknown): string | null
fn asNullableString(scalar: &JsonScalar, out: &TextField) -> void {
    if scalar.kind == 0 { out.has = false; out.len = 0; return; };
    if scalar.kind == 1 || scalar.kind == 2 || scalar.kind == 3 {
        out.has = true;
        out.len = 0;
        let n = scalar.text.len;
        if n > 4096 { n = 4096; };
        for j in 0..n { out.bytes[j] = scalar.text.bytes[j]; }
        out.len = n;
        return;
    };
    out.has = false;
    out.len = 0;
}

fn configFieldFromRecord(record: &JsonBuf, key_ptr: ptr, key_len: u64, out: &TextField) -> void {
    let rp: ptr = PTR_NULL();
    PTR_BYTE_ADD(rp, &record.bytes, 0);
    let scalar = JsonScalar { kind: 0, text: StrBuf { bytes: [0u8; 1024], len: 0 }, num: 0.0, boolean: false };
    if jsonObjectGetScalar(rp, record.len, key_ptr, key_len, &scalar) {
        asNullableString(&scalar, out);
        return;
    };
    out.has = false;
    out.len = 0;
}

// TS: export function configToUserView(config: unknown): CodexUserConfigView
fn configToUserView(config: &JsonBuf, out: &CodexUserConfigView) -> void {
    let record = JsonBuf { bytes: [0u8; 16384], len: 0 };
    asRecord(config, &record);
    configFieldFromRecord(&record, STR_PTR("model"), STR_LEN("model"), &out.model);
    configFieldFromRecord(&record, STR_PTR("review_model"), STR_LEN("review_model"), &out.reviewModel);
    configFieldFromRecord(&record, STR_PTR("model_provider"), STR_LEN("model_provider"), &out.modelProvider);
    configFieldFromRecord(&record, STR_PTR("model_reasoning_effort"), STR_LEN("model_reasoning_effort"), &out.modelReasoningEffort);
    configFieldFromRecord(&record, STR_PTR("model_reasoning_summary"), STR_LEN("model_reasoning_summary"), &out.modelReasoningSummary);
    configFieldFromRecord(&record, STR_PTR("model_verbosity"), STR_LEN("model_verbosity"), &out.modelVerbosity);
    // approvalPolicy: typeof approval === "string" ? approval : null
    let rp: ptr = PTR_NULL();
    PTR_BYTE_ADD(rp, &record.bytes, 0);
    let approval = JsonScalar { kind: 0, text: StrBuf { bytes: [0u8; 1024], len: 0 }, num: 0.0, boolean: false };
    if jsonObjectGetScalar(rp, record.len, STR_PTR("approval_policy"), STR_LEN("approval_policy"), &approval) && approval.kind == 1 {
        asNullableString(&approval, &out.approvalPolicy);
    } else {
        out.approvalPolicy.has = false;
        out.approvalPolicy.len = 0;
    };
    configFieldFromRecord(&record, STR_PTR("sandbox_mode"), STR_LEN("sandbox_mode"), &out.sandboxMode);
    configFieldFromRecord(&record, STR_PTR("web_search"), STR_LEN("web_search"), &out.webSearch);
    configFieldFromRecord(&record, STR_PTR("service_tier"), STR_LEN("service_tier"), &out.serviceTier);
    configFieldFromRecord(&record, STR_PTR("instructions"), STR_LEN("instructions"), &out.instructions);
    configFieldFromRecord(&record, STR_PTR("developer_instructions"), STR_LEN("developer_instructions"), &out.developerInstructions);
    jsonBufCopy(&out.rawConfig, &record);
}

// TS: export function parseConfigReadResponse(result: unknown): CodexUserConfigView
//   const root = asRecord(result); const config = root.config ?? result;
fn parseConfigReadResponse(result: &JsonBuf, out: &CodexUserConfigView) -> void {
    let root = JsonBuf { bytes: [0u8; 16384], len: 0 };
    asRecord(result, &root);
    let rp: ptr = PTR_NULL();
    PTR_BYTE_ADD(rp, &root.bytes, 0);
    let config = JsonBuf { bytes: [0u8; 16384], len: 0 };
    if jsonObjectGetValueText(rp, root.len, STR_PTR("config"), STR_LEN("config"), &config) {
        configToUserView(&config, out);
        return;
    };
    configToUserView(result, out);
}

// TS: export function buildConfigValueWrite(field, value): {...} | null
fn buildConfigValueWrite(fieldKey_ptr: ptr, fieldKey_len: u64, value: &TextField, out: &CodexConfigEdit) -> bool {
    let meta = CodexConfigFieldMeta { key: StrBuf { bytes: [0u8; 1024], len: 0 }, keyPath: StrBuf { bytes: [0u8; 1024], len: 0 }, label: StrBuf { bytes: [0u8; 1024], len: 0 }, description: StrBuf { bytes: [0u8; 1024], len: 0 }, kind: 0, options: [FieldOption { value: StrBuf { bytes: [0u8; 1024], len: 0 }, label: StrBuf { bytes: [0u8; 1024], len: 0 } }; 8], options_len: 0, has_readOnly: false, readOnly: false };
    if !findFieldMeta(fieldKey_ptr, fieldKey_len, &meta) { return false; };
    if meta.has_readOnly && meta.readOnly { return false; };
    if !value.has { return false; };
    // Allow empty string only for free-text instruction fields.
    if value.len == 0 && meta.kind != KIND_TEXTAREA() { return false; };
    if !codexConfigKeyPath(fieldKey_ptr, fieldKey_len, &out.keyPath) { return false; };
    // value: JsonValue (the string itself) — stored as JSON string text.
    // DEFECT: JSON string escaping approximated: raw bytes wrapped in quotes.
    out.value.len = 0;
    out.value.bytes[out.value.len] = 34;
    out.value.len = out.value.len + 1;
    let n = value.len;
    if n > 1000 { n = 1000; };
    for j in 0..n { out.value.bytes[out.value.len] = value.bytes[j]; out.value.len = out.value.len + 1; }
    out.value.bytes[out.value.len] = 34;
    out.value.len = out.value.len + 1;
    strBufSet(&out.mergeStrategy, STR_PTR("replace"), STR_LEN("replace"));
    return true;
}

// TS: export function buildDynamicConfigValueWrite(keyPath, value): {...} | null
fn buildDynamicConfigValueWrite(keyPath: &StrBuf, value: &JsonBufSmall, out: &CodexConfigEdit) -> bool {
    // if (!keyPath.trim()) return null;
    let hasNonSpace = false;
    for j in 0..keyPath.len {
        let b = keyPath.bytes[j];
        if b != 32 && b != 9 && b != 10 && b != 13 { hasNonSpace = true; };
    }
    if !hasNonSpace { return false; };
    out.keyPath = *keyPath;
    out.value = *value;
    strBufSet(&out.mergeStrategy, STR_PTR("replace"), STR_LEN("replace"));
    return true;
}

struct FieldEditInput {
    key: StrBuf,
    value: TextField,
}

struct FieldEditInputList {
    edits: [FieldEditInput; 32],
    len: u64,
}

struct ConfigBatchWrite {
    edits: [CodexConfigEdit; 32],
    len: u64,
    reloadUserConfig: bool,
}

// TS: export function buildConfigBatchWrite(edits): { edits, reloadUserConfig: true } | null
fn buildConfigBatchWrite(edits: &FieldEditInputList, out: &ConfigBatchWrite) -> bool {
    out.len = 0;
    out.reloadUserConfig = true;
    for i in 0..edits.len {
        let kp: ptr = PTR_NULL();
        PTR_BYTE_ADD(kp, &edits.edits[i].key.bytes, 0);
        let write = CodexConfigEdit { keyPath: StrBuf { bytes: [0u8; 1024], len: 0 }, value: JsonBufSmall { bytes: [0u8; 1024], len: 0 }, mergeStrategy: StrBuf { bytes: [0u8; 1024], len: 0 } };
        if buildConfigValueWrite(kp, edits.edits[i].key.len, &edits.edits[i].value, &write) {
            if out.len < 32 { out.edits[out.len] = write; out.len = out.len + 1; };
        };
    }
    return out.len > 0;
}

// TS: export function diffConfigViews(previous, next): Array<{ field, value }>
fn diffConfigViews(previous: &CodexUserConfigView, next: &CodexUserConfigView, out: &FieldEditInputList) -> void {
    out.len = 0;
    for i in 0..codexConfigFieldMetaCount() {
        let meta = CodexConfigFieldMeta { key: StrBuf { bytes: [0u8; 1024], len: 0 }, keyPath: StrBuf { bytes: [0u8; 1024], len: 0 }, label: StrBuf { bytes: [0u8; 1024], len: 0 }, description: StrBuf { bytes: [0u8; 1024], len: 0 }, kind: 0, options: [FieldOption { value: StrBuf { bytes: [0u8; 1024], len: 0 }, label: StrBuf { bytes: [0u8; 1024], len: 0 } }; 8], options_len: 0, has_readOnly: false, readOnly: false };
        if !codexConfigFieldMetaAt(i, &meta) { continue; };
        if meta.has_readOnly && meta.readOnly { continue; };
        let kp: ptr = PTR_NULL();
        PTR_BYTE_ADD(kp, &meta.key.bytes, 0);
        let prevField = TextField { bytes: [0u8; 4096], len: 0, has: false };
        let nextField = TextField { bytes: [0u8; 4096], len: 0, has: false };
        getViewFieldByKey(previous, kp, meta.key.len, &prevField);
        getViewFieldByKey(next, kp, meta.key.len, &nextField);
        if !textFieldEq(&prevField, &nextField) {
            if out.len < 32 {
                out.edits[out.len].key = meta.key;
                out.edits[out.len].value = nextField;
                out.len = out.len + 1;
            };
        };
    }
}

// TS: export function applyConfigWriteToView(current, keyPath, value): CodexUserConfigView
fn applyConfigWriteToView(current: &CodexUserConfigView, keyPath_ptr: ptr, keyPath_len: u64, value: &JsonBuf, out: &CodexUserConfigView) -> void {
    *out = *current;
    // const field = Object.entries(CODEX_CONFIG_KEY_PATHS).find(([, path]) => path === keyPath)?.[0];
    let foundKey = StrBuf { bytes: [0u8; 1024], len: 0 };
    let hasField = false;
    for i in 0..codexConfigFieldMetaCount() {
        let meta = CodexConfigFieldMeta { key: StrBuf { bytes: [0u8; 1024], len: 0 }, keyPath: StrBuf { bytes: [0u8; 1024], len: 0 }, label: StrBuf { bytes: [0u8; 1024], len: 0 }, description: StrBuf { bytes: [0u8; 1024], len: 0 }, kind: 0, options: [FieldOption { value: StrBuf { bytes: [0u8; 1024], len: 0 }, label: StrBuf { bytes: [0u8; 1024], len: 0 } }; 8], options_len: 0, has_readOnly: false, readOnly: false };
        if !codexConfigFieldMetaAt(i, &meta) { continue; };
        let kp: ptr = PTR_NULL();
        PTR_BYTE_ADD(kp, &meta.keyPath.bytes, 0);
        if strBufEqBytes(keyPath_ptr, keyPath_len, kp, meta.keyPath.len) { foundKey = meta.key; hasField = true; break; };
    }
    if hasField {
        let scalar = JsonScalar { kind: 0, text: StrBuf { bytes: [0u8; 1024], len: 0 }, num: 0.0, boolean: false };
        jsonValueToScalar(value, &scalar);
        let fieldValue = TextField { bytes: [0u8; 4096], len: 0, has: false };
        asNullableString(&scalar, &fieldValue);
        let fk: ptr = PTR_NULL();
        PTR_BYTE_ADD(fk, &foundKey.bytes, 0);
        setViewFieldByKey(out, fk, foundKey.len, &fieldValue);
    };
    // rawConfig: setConfigValueAtPath(current.rawConfig, keyPath, value)
    setConfigValueAtPath(&current.rawConfig, keyPath_ptr, keyPath_len, value, &out.rawConfig);
}

// TS: export function getConfigValueAtPath(config, keyPath): unknown
fn getConfigValueAtPath(config: &JsonBuf, keyPath_ptr: ptr, keyPath_len: u64, out: &JsonBuf) -> bool {
    let segments = StrList { items: [[0u8; 256]; 64], lens: [0u64; 64], len: 0 };
    splitKeyPath(keyPath_ptr, keyPath_len, &segments);
    let current = JsonBuf { bytes: [0u8; 16384], len: 0 };
    jsonBufCopy(&current, config);
    for s in 0..segments.len {
        if segments.lens[s] == 0 { return false; };
        if !jsonBufIsObject(&current) { return false; };
        let cp: ptr = PTR_NULL();
        PTR_BYTE_ADD(cp, &current.bytes, 0);
        let sp: ptr = PTR_NULL();
        PTR_BYTE_ADD(sp, &segments.items[s], 0);
        let next = JsonBuf { bytes: [0u8; 16384], len: 0 };
        if !jsonObjectGetValueText(cp, current.len, sp, segments.lens[s], &next) { return false; };
        jsonBufCopy(&current, &next);
    }
    jsonBufCopy(out, &current);
    return true;
}

// TS: export function setConfigValueAtPath(config, keyPath, value): Record<string, unknown>
// DEFECT: dynamic object — TS builds a shallow-copied object chain with
// intermediate {} objects; approximated by the assumed extern
// sa_json_object_set_path_copy, which must clone along the path and create
// intermediate objects the same way (fix phase).
fn setConfigValueAtPath(config: &JsonBuf, keyPath_ptr: ptr, keyPath_len: u64, value: &JsonBuf, out: &JsonBuf) -> void {
    let segments = StrList { items: [[0u8; 256]; 64], lens: [0u64; 64], len: 0 };
    splitKeyPath(keyPath_ptr, keyPath_len, &segments);
    // segments = segments.filter(Boolean)
    let filtered = StrList { items: [[0u8; 256]; 64], lens: [0u64; 64], len: 0 };
    for s in 0..segments.len {
        if segments.lens[s] > 0 {
            let sp: ptr = PTR_NULL();
            PTR_BYTE_ADD(sp, &segments.items[s], 0);
            strListPush(&filtered, sp, segments.lens[s]);
        };
    }
    if filtered.len == 0 { jsonBufCopy(out, config); return; };
    let joined = StrBuf { bytes: [0u8; 1024], len: 0 };
    joinStrList(&filtered, STR_PTR("."), STR_LEN("."), &joined);
    let cp: ptr = PTR_NULL();
    PTR_BYTE_ADD(cp, &config.bytes, 0);
    let vp: ptr = PTR_NULL();
    PTR_BYTE_ADD(vp, &value.bytes, 0);
    let jp: ptr = PTR_NULL();
    PTR_BYTE_ADD(jp, &joined.bytes, 0);
    let op: ptr = PTR_NULL();
    let ol: u64 = 0;
    if sa_json_object_set_path_copy(cp, config.len, jp, joined.len, vp, value.len, &op, &ol) == 0 {
        jsonBufSet(out, op, ol);
        return;
    };
    jsonBufCopy(out, config);
}

// ---- schema accessors (assumed sa_json_* externs, fix phase) ----
// DEFECT: sa_json_object_key_at / sa_json_array_len /
// sa_json_array_at_value_text / sa_json_object_remove_key_copy /
// sa_json_object_merge_schema_copy / sa_json_validate are the assumed
// dynamic-JSON surface for this module.

fn schemaObjectKeys(obj: &JsonBuf, out: &StrList) -> void {
    out.len = 0;
    let op: ptr = PTR_NULL();
    PTR_BYTE_ADD(op, &obj.bytes, 0);
    let count = sa_json_object_key_count(op, obj.len);
    for i in 0..count {
        let kp: ptr = PTR_NULL();
        let kl: u64 = 0;
        if sa_json_object_key_at(op, obj.len, i, &kp, &kl) == 0 { strListPush(out, kp, kl); };
    }
}

fn schemaArrayLen(arr: &JsonBuf) -> u64 {
    let ap: ptr = PTR_NULL();
    PTR_BYTE_ADD(ap, &arr.bytes, 0);
    return sa_json_array_len(ap, arr.len);
}

fn schemaArrayAt(arr: &JsonBuf, index: u64, out: &JsonBuf) -> bool {
    let ap: ptr = PTR_NULL();
    PTR_BYTE_ADD(ap, &arr.bytes, 0);
    let vp: ptr = PTR_NULL();
    let vl: u64 = 0;
    if sa_json_array_at_value_text(ap, arr.len, index, &vp, &vl) != 0 { return false; };
    jsonBufSet(out, vp, vl);
    return true;
}

// Byte-order sort.
// DEFECT: TS sorts with localeCompare (locale-aware collation); approximated
// by bytewise lexicographic order.
fn sortStrList(list: &StrList) -> void {
    let n = list.len;
    for i in 0..n {
        for j in 0..n {
            if j + 1 < n - i {
                if strListGreaterAt(list, j, j + 1) {
                    for k in 0..256 {
                        let tmp = list.items[j][k];
                        list.items[j][k] = list.items[j + 1][k];
                        list.items[j + 1][k] = tmp;
                    }
                    let tmpLen = list.lens[j];
                    list.lens[j] = list.lens[j + 1];
                    list.lens[j + 1] = tmpLen;
                };
            };
        }
    }
}

fn strListGreaterAt(list: &StrList, a: u64, b: u64) -> bool {
    let n = list.lens[a];
    if list.lens[b] < n { n = list.lens[b]; };
    for j in 0..n {
        if list.items[a][j] != list.items[b][j] { return list.items[a][j] > list.items[b][j]; };
    }
    return list.lens[a] > list.lens[b];
}

fn schemaFieldValue(schema: &JsonBuf, key_ptr: ptr, key_len: u64, out: &JsonBuf) -> bool {
    let sp: ptr = PTR_NULL();
    PTR_BYTE_ADD(sp, &schema.bytes, 0);
    return jsonObjectGetValueText(sp, schema.len, key_ptr, key_len, out);
}

// TS: export function getDynamicCodexConfigFields(config?): DynamicCodexConfigField[]
fn getDynamicCodexConfigFields(schemaRoot: &SchemaRoot, hasConfig: bool, config: &JsonBuf, out: &DynamicFieldList) -> void {
    out.len = 0;
    let properties = JsonBuf { bytes: [0u8; 16384], len: 0 };
    let rp: ptr = PTR_NULL();
    PTR_BYTE_ADD(rp, &schemaRoot.json.bytes, 0);
    if !jsonObjectGetValueText(rp, schemaRoot.json.len, STR_PTR("properties"), STR_LEN("properties"), &properties) {
        jsonBufSet(&properties, STR_PTR("{}"), STR_LEN("{}"));
    };
    let parentPath = StrList { items: [[0u8; 256]; 64], lens: [0u64; 64], len: 0 };
    flattenSchemaProperties(schemaRoot, &properties, &parentPath, out);
    // runtimeFields: Object.keys(config ?? {}) not in schema, sorted
    let knownTopLevel = StrList { items: [[0u8; 256]; 64], lens: [0u64; 64], len: 0 };
    schemaObjectKeys(&properties, &knownTopLevel);
    if hasConfig {
        let configKeys = StrList { items: [[0u8; 256]; 64], lens: [0u64; 64], len: 0 };
        schemaObjectKeys(config, &configKeys);
        let runtimeKeys = StrList { items: [[0u8; 256]; 64], lens: [0u64; 64], len: 0 };
        for i in 0..configKeys.len {
            let kp: ptr = PTR_NULL();
            PTR_BYTE_ADD(kp, &configKeys.items[i], 0);
            if !strListContains(&knownTopLevel, kp, configKeys.lens[i]) { strListPush(&runtimeKeys, kp, configKeys.lens[i]); };
        }
        sortStrList(&runtimeKeys);
        for i in 0..runtimeKeys.len {
            if out.len >= 128 { break; };
            let kp: ptr = PTR_NULL();
            PTR_BYTE_ADD(kp, &runtimeKeys.items[i], 0);
            let field = &out.fields[out.len];
            field.keyPath.len = 0;
            for j in 0..runtimeKeys.lens[i] { field.keyPath.bytes[j] = runtimeKeys.items[i][j]; }
            field.keyPath.len = runtimeKeys.lens[i];
            labelFromPath(kp, runtimeKeys.lens[i], &field.label);
            strBufSet(&field.description, STR_PTR("Runtime config key returned by config/read but not present in the bundled Codex schema."), STR_LEN("Runtime config key returned by config/read but not present in the bundled Codex schema."));
            let valueText = JsonBuf { bytes: [0u8; 16384], len: 0 };
            let scalar = JsonScalar { kind: 0, text: StrBuf { bytes: [0u8; 1024], len: 0 }, num: 0.0, boolean: false };
            let cp: ptr = PTR_NULL();
            PTR_BYTE_ADD(cp, &config.bytes, 0);
            if jsonObjectGetValueText(cp, config.len, kp, runtimeKeys.lens[i], &valueText) { jsonValueToScalar(&valueText, &scalar); };
            field.kind = inferRuntimeKind(scalar.kind);
            strBufSet(&field.group, STR_PTR("runtime"), STR_LEN("runtime"));
            field.options_len = 0;
            field.has_defaultValue = false;
            field.has_readOnly = false;
            field.readOnly = false;
            field.source = SOURCE_RUNTIME();
            out.len = out.len + 1;
        }
    };
}

// TS: export function formatConfigValueForField(field, value): string
fn formatConfigValueForField(field: &DynamicCodexConfigField, hasValue: bool, value: &JsonBuf, out: &BigStr) -> void {
    out.len = 0;
    if !hasValue { return; };
    let scalar = JsonScalar { kind: 0, text: StrBuf { bytes: [0u8; 1024], len: 0 }, num: 0.0, boolean: false };
    jsonValueToScalar(value, &scalar);
    if scalar.kind == 0 { return; };
    if field.kind == KIND_JSON() {
        // DEFECT: JSON.stringify(value, null, 2) pretty-printing approximated
        // by the raw JSON text.
        let n = value.len;
        if n > 8192 { n = 8192; };
        for j in 0..n { out.bytes[j] = value.bytes[j]; }
        out.len = n;
        return;
    };
    if scalar.kind == 1 || scalar.kind == 2 || scalar.kind == 3 {
        let n = scalar.text.len;
        if n > 8192 { n = 8192; };
        for j in 0..n { out.bytes[j] = scalar.text.bytes[j]; }
        out.len = n;
        return;
    };
    // return JSON.stringify(value, null, 2);
    let n = value.len;
    if n > 8192 { n = 8192; };
    for j in 0..n { out.bytes[j] = value.bytes[j]; }
    out.len = n;
}

struct ParseDynamicResult {
    isError: bool,
    value: JsonBufSmall,
    error: StrBuf,
}

fn trimStrBuf(src: &StrBuf, out: &StrBuf) -> void {
    let start: u64 = 0;
    let end = src.len;
    while start < end {
        let b = src.bytes[start];
        if b == 32 || b == 9 || b == 10 || b == 13 { start = start + 1; } else { break; };
    }
    while end > start {
        let b = src.bytes[end - 1];
        if b == 32 || b == 9 || b == 10 || b == 13 { end = end - 1; } else { break; };
    }
    out.len = 0;
    let i = start;
    while i < end {
        out.bytes[out.len] = src.bytes[i];
        out.len = out.len + 1;
        i = i + 1;
    }
}

// Decimal parser for Number(trimmed).
// DEFECT: JS Number() also accepts hex/binary/octal/exponent edge forms and
// "Infinity"; exponents are handled, the rest are rejected as invalid.
fn parseNumberText(text: &StrBuf, out: &f64) -> bool {
    let i: u64 = 0;
    let negative = false;
    if i < text.len && text.bytes[i] == 45 { negative = true; i = i + 1; };
    if i < text.len && text.bytes[i] == 43 { i = i + 1; };
    let result: f64 = 0.0;
    let scale: f64 = 1.0;
    let seenDigit = false;
    let seenDot = false;
    while i < text.len {
        let b = text.bytes[i];
        if b >= 48 && b <= 57 {
            seenDigit = true;
            let d = (b - 48) as f64;
            if seenDot { scale = scale / 10.0; result = result + d * scale; } else { result = result * 10.0 + d; };
            i = i + 1;
            continue;
        };
        if b == 46 && !seenDot { seenDot = true; i = i + 1; continue; };
        if b == 101 || b == 69 {
            // exponent: apply powers of ten
            i = i + 1;
            let expNegative = false;
            if i < text.len && text.bytes[i] == 45 { expNegative = true; i = i + 1; };
            if i < text.len && text.bytes[i] == 43 { i = i + 1; };
            let exp: u64 = 0;
            let expDigits = false;
            while i < text.len && text.bytes[i] >= 48 && text.bytes[i] <= 57 {
                expDigits = true;
                exp = exp * 10 + (text.bytes[i] - 48) as u64;
                i = i + 1;
            }
            if !expDigits { return false; };
            for k in 0..exp {
                if expNegative { result = result / 10.0; } else { result = result * 10.0; };
            }
            continue;
        };
        return false;
    }
    if !seenDigit { return false; };
    if negative { result = 0.0 - result; };
    *out = result;
    return true;
}

// TS: export function parseDynamicConfigFieldValue(field, value): { value } | { error }
fn parseDynamicConfigFieldValue(field: &DynamicCodexConfigField, isBoolInput: bool, boolValue: bool, text: &StrBuf, out: &ParseDynamicResult) -> void {
    out.isError = false;
    out.value.len = 0;
    out.error.len = 0;
    if field.kind == KIND_BOOLEAN() {
        // return { value: Boolean(value) } — Boolean("false") is true,
        // Boolean("") is false; preserved.
        let b = boolValue;
        if !isBoolInput { b = text.len > 0; };
        if b { out.value.len = 4; out.value.bytes[0] = 116; out.value.bytes[1] = 114; out.value.bytes[2] = 117; out.value.bytes[3] = 101; } else { out.value.len = 5; out.value.bytes[0] = 102; out.value.bytes[1] = 97; out.value.bytes[2] = 108; out.value.bytes[3] = 115; out.value.bytes[4] = 101; };
        return;
    };
    if isBoolInput {
        out.isError = true;
        strBufSet(&out.error, STR_PTR("Expected a text value."), STR_LEN("Expected a text value."));
        return;
    };
    if field.kind == KIND_NUMBER() {
        let trimmed = StrBuf { bytes: [0u8; 1024], len: 0 };
        trimStrBuf(text, &trimmed);
        if trimmed.len == 0 {
            out.isError = true;
            strBufSet(&out.error, STR_PTR("Number fields cannot be empty."), STR_LEN("Number fields cannot be empty."));
            return;
        };
        let parsed: f64 = 0.0;
        if !parseNumberText(&trimmed, &parsed) {
            out.isError = true;
            strBufSet(&out.error, STR_PTR("Enter a valid number."), STR_LEN("Enter a valid number."));
            return;
        };
        // { value: parsed } — stored as the trimmed source text (JSON number).
        out.value.len = 0;
        for j in 0..trimmed.len { out.value.bytes[out.value.len] = trimmed.bytes[j]; out.value.len = out.value.len + 1; }
        return;
    };
    if field.kind == KIND_JSON() {
        let trimmed = StrBuf { bytes: [0u8; 1024], len: 0 };
        trimStrBuf(text, &trimmed);
        if trimmed.len == 0 {
            out.isError = true;
            strBufSet(&out.error, STR_PTR("JSON fields cannot be empty."), STR_LEN("JSON fields cannot be empty."));
            return;
        };
        // try { return { value: JSON.parse(trimmed) } } catch { error }
        let tp: ptr = PTR_NULL();
        PTR_BYTE_ADD(tp, &trimmed.bytes, 0);
        if sa_json_validate(tp, trimmed.len) != 0 {
            out.isError = true;
            strBufSet(&out.error, STR_PTR("Enter valid JSON."), STR_LEN("Enter valid JSON."));
            return;
        };
        out.value.len = 0;
        let n = trimmed.len;
        if n > 1024 { n = 1024; };
        for j in 0..n { out.value.bytes[out.value.len] = trimmed.bytes[j]; out.value.len = out.value.len + 1; }
        return;
    };
    // return { value }; (text/select/textarea: the string itself, as JSON)
    out.value.len = 0;
    out.value.bytes[out.value.len] = 34;
    out.value.len = out.value.len + 1;
    let n = text.len;
    if n > 1000 { n = 1000; };
    for j in 0..n { out.value.bytes[out.value.len] = text.bytes[j]; out.value.len = out.value.len + 1; }
    out.value.bytes[out.value.len] = 34;
    out.value.len = out.value.len + 1;
}

// TS: function flattenSchemaProperties(properties, parentPath): DynamicCodexConfigField[]
// DEFECT: recursion — TS recurses over nested schema properties; the SLA
// version recurses identically (fix phase to confirm recursion support).
fn flattenSchemaProperties(schemaRoot: &SchemaRoot, properties: &JsonBuf, parentPath: &StrList, out: &DynamicFieldList) -> void {
    let keys = StrList { items: [[0u8; 256]; 64], lens: [0u64; 64], len: 0 };
    schemaObjectKeys(properties, &keys);
    sortStrList(&keys);
    for i in 0..keys.len {
        let kp: ptr = PTR_NULL();
        PTR_BYTE_ADD(kp, &keys.items[i], 0);
        let keyPath = StrList { items: [[0u8; 256]; 64], lens: [0u64; 64], len: 0 };
        for p in 0..parentPath.len {
            let pp: ptr = PTR_NULL();
            PTR_BYTE_ADD(pp, &parentPath.items[p], 0);
            strListPush(&keyPath, pp, parentPath.lens[p]);
        }
        strListPush(&keyPath, kp, keys.lens[i]);
        let rawSchema = JsonBuf { bytes: [0u8; 16384], len: 0 };
        let pp2: ptr = PTR_NULL();
        PTR_BYTE_ADD(pp2, &properties.bytes, 0);
        jsonObjectGetValueText(pp2, properties.len, kp, keys.lens[i], &rawSchema);
        let seen = StrList { items: [[0u8; 256]; 64], lens: [0u64; 64], len: 0 };
        let schema = JsonBuf { bytes: [0u8; 16384], len: 0 };
        resolveSchema(schemaRoot, &rawSchema, &seen, &schema);
        if out.len < 128 {
            fieldFromSchema(&keyPath, &schema, &out.fields[out.len]);
            out.len = out.len + 1;
        };
        // recurse into schema.properties ?? {}
        let childProperties = JsonBuf { bytes: [0u8; 16384], len: 0 };
        if schemaFieldValue(&schema, STR_PTR("properties"), STR_LEN("properties"), &childProperties) {
            flattenSchemaProperties(schemaRoot, &childProperties, &keyPath, out);
        };
    }
}

// TS: function resolveSchema(schema, seen = new Set()): JsonSchema
fn resolveSchema(schemaRoot: &SchemaRoot, schema: &JsonBuf, seen: &StrList, out: &JsonBuf) -> void {
    if schema.len == 0 || !jsonBufIsObject(schema) {
        // !schema or boolean schema -> {}
        jsonBufSet(out, STR_PTR("{}"), STR_LEN("{}"));
        return;
    };
    let resolved = JsonBuf { bytes: [0u8; 16384], len: 0 };
    jsonBufCopy(&resolved, schema);
    // $ref handling
    let refScalar = JsonScalar { kind: 0, text: StrBuf { bytes: [0u8; 1024], len: 0 }, num: 0.0, boolean: false };
    let sp: ptr = PTR_NULL();
    PTR_BYTE_ADD(sp, &schema.bytes, 0);
    if jsonObjectGetScalar(sp, schema.len, STR_PTR("$ref"), STR_LEN("$ref"), &refScalar) && refScalar.kind == 1 {
        let prefix = STR_PTR("#/definitions/");
        let prefix_len = STR_LEN("#/definitions/");
        let isDefRef = refScalar.text.len > prefix_len;
        if isDefRef {
            for j in 0..prefix_len {
                let b: u8 = 0;
                PTR_BYTE_AT(b, prefix, j);
                if refScalar.text.bytes[j] != b { isDefRef = false; };
            }
        };
        if isDefRef {
            // name = $ref.slice("#/definitions/".length)
            let name = StrBuf { bytes: [0u8; 1024], len: 0 };
            let ni: u64 = 0;
            let idx = prefix_len;
            while idx < refScalar.text.len {
                name.bytes[ni] = refScalar.text.bytes[idx];
                ni = ni + 1;
                idx = idx + 1;
            }
            name.len = ni;
            let np: ptr = PTR_NULL();
            PTR_BYTE_ADD(np, &name.bytes, 0);
            if !strListContains(seen, np, name.len) {
                strListPush(seen, np, name.len);
                // definitions[name]
                let definitions = JsonBuf { bytes: [0u8; 16384], len: 0 };
                let defSchema = JsonBuf { bytes: [0u8; 16384], len: 0 };
                let rp: ptr = PTR_NULL();
                PTR_BYTE_ADD(rp, &schemaRoot.json.bytes, 0);
                if jsonObjectGetValueText(rp, schemaRoot.json.len, STR_PTR("definitions"), STR_LEN("definitions"), &definitions) {
                    let dp: ptr = PTR_NULL();
                    PTR_BYTE_ADD(dp, &definitions.bytes, 0);
                    jsonObjectGetValueText(dp, definitions.len, np, name.len, &defSchema);
                };
                let resolvedDef = JsonBuf { bytes: [0u8; 16384], len: 0 };
                resolveSchema(schemaRoot, &defSchema, seen, &resolvedDef);
                let rest = JsonBuf { bytes: [0u8; 16384], len: 0 };
                withoutRef(schema, &rest);
                mergeSchema(&resolvedDef, &rest, &resolved);
            };
        };
    };
    // allOf reduction
    let allOf = JsonBuf { bytes: [0u8; 16384], len: 0 };
    if schemaFieldValue(&resolved, STR_PTR("allOf"), STR_LEN("allOf")) {
        let count = schemaArrayLen(&allOf);
        if count > 0 {
            let acc = JsonBuf { bytes: [0u8; 16384], len: 0 };
            withoutAllOf(&resolved, &acc);
            for i in 0..count {
                let entry = JsonBuf { bytes: [0u8; 16384], len: 0 };
                schemaArrayAt(&allOf, i, &entry);
                let entrySeen = StrList { items: [[0u8; 256]; 64], lens: [0u64; 64], len: 0 };
                for s in 0..seen.len {
                    let sp2: ptr = PTR_NULL();
                    PTR_BYTE_ADD(sp2, &seen.items[s], 0);
                    strListPush(&entrySeen, sp2, seen.lens[s]);
                }
                let resolvedEntry = JsonBuf { bytes: [0u8; 16384], len: 0 };
                resolveSchema(schemaRoot, &entry, &entrySeen, &resolvedEntry);
                let merged = JsonBuf { bytes: [0u8; 16384], len: 0 };
                mergeSchema(&acc, &resolvedEntry, &merged);
                jsonBufCopy(&acc, &merged);
            }
            jsonBufCopy(out, &acc);
            return;
        };
    };
    // anyOf / oneOf object-branch reduction
    let union = JsonBuf { bytes: [0u8; 16384], len: 0 };
    let hasUnion = schemaFieldValue(&resolved, STR_PTR("anyOf"), STR_LEN("anyOf"));
    if !hasUnion { hasUnion = schemaFieldValue(&resolved, STR_PTR("oneOf"), STR_LEN("oneOf")); };
    if hasUnion {
        let count = schemaArrayLen(&union);
        if count > 0 {
            let acc = JsonBuf { bytes: [0u8; 16384], len: 0 };
            withoutUnion(&resolved, &acc);
            let branchCount: u64 = 0;
            for i in 0..count {
                let entry = JsonBuf { bytes: [0u8; 16384], len: 0 };
                schemaArrayAt(&union, i, &entry);
                let branchSeen = StrList { items: [[0u8; 256]; 64], lens: [0u64; 64], len: 0 };
                for s in 0..seen.len {
                    let sp3: ptr = PTR_NULL();
                    PTR_BYTE_ADD(sp3, &seen.items[s], 0);
                    strListPush(&branchSeen, sp3, seen.lens[s]);
                }
                let resolvedEntry = JsonBuf { bytes: [0u8; 16384], len: 0 };
                resolveSchema(schemaRoot, &entry, &branchSeen, &resolvedEntry);
                // filter: entry.type === "object" || Boolean(entry.properties)
                let typeScalar = JsonScalar { kind: 0, text: StrBuf { bytes: [0u8; 1024], len: 0 }, num: 0.0, boolean: false };
                let ep: ptr = PTR_NULL();
                PTR_BYTE_ADD(ep, &resolvedEntry.bytes, 0);
                jsonObjectGetScalar(ep, resolvedEntry.len, STR_PTR("type"), STR_LEN("type"), &typeScalar);
                let props = JsonBuf { bytes: [0u8; 16384], len: 0 };
                let hasProps = schemaFieldValue(&resolvedEntry, STR_PTR("properties"), STR_LEN("properties"));
                let isObjectBranch = (typeScalar.kind == 1 && typeScalar.text.len == 6 && typeScalar.text.bytes[0] == 111) || hasProps;
                if isObjectBranch {
                    branchCount = branchCount + 1;
                    let merged = JsonBuf { bytes: [0u8; 16384], len: 0 };
                    mergeSchema(&acc, &resolvedEntry, &merged);
                    jsonBufCopy(&acc, &merged);
                };
            }
            if branchCount > 0 { jsonBufCopy(out, &acc); return; };
        };
    };
    jsonBufCopy(out, &resolved);
}

// TS: function withoutRef(schema) / withoutAllOf / withoutUnion
// (destructuring removal of keys)
// DEFECT: assumed sa_json_object_remove_key_copy extern (fix phase).
fn withoutRef(schema: &JsonBuf, out: &JsonBuf) -> void {
    let sp: ptr = PTR_NULL();
    PTR_BYTE_ADD(sp, &schema.bytes, 0);
    let op: ptr = PTR_NULL();
    let ol: u64 = 0;
    if sa_json_object_remove_key_copy(sp, schema.len, STR_PTR("$ref"), STR_LEN("$ref"), &op, &ol) == 0 { jsonBufSet(out, op, ol); return; };
    jsonBufCopy(out, schema);
}

fn withoutAllOf(schema: &JsonBuf, out: &JsonBuf) -> void {
    let sp: ptr = PTR_NULL();
    PTR_BYTE_ADD(sp, &schema.bytes, 0);
    let op: ptr = PTR_NULL();
    let ol: u64 = 0;
    if sa_json_object_remove_key_copy(sp, schema.len, STR_PTR("allOf"), STR_LEN("allOf"), &op, &ol) == 0 { jsonBufSet(out, op, ol); return; };
    jsonBufCopy(out, schema);
}

fn withoutUnion(schema: &JsonBuf, out: &JsonBuf) -> void {
    let tmp = JsonBuf { bytes: [0u8; 16384], len: 0 };
    let sp: ptr = PTR_NULL();
    PTR_BYTE_ADD(sp, &schema.bytes, 0);
    let op: ptr = PTR_NULL();
    let ol: u64 = 0;
    if sa_json_object_remove_key_copy(sp, schema.len, STR_PTR("anyOf"), STR_LEN("anyOf"), &op, &ol) == 0 { jsonBufSet(&tmp, op, ol); } else { jsonBufCopy(&tmp, schema); };
    let tp: ptr = PTR_NULL();
    PTR_BYTE_ADD(tp, &tmp.bytes, 0);
    let op2: ptr = PTR_NULL();
    let ol2: u64 = 0;
    if sa_json_object_remove_key_copy(tp, tmp.len, STR_PTR("oneOf"), STR_LEN("oneOf"), &op2, &ol2) == 0 { jsonBufSet(out, op2, ol2); return; };
    jsonBufCopy(out, &tmp);
}

// TS: function mergeSchema(base, override): JsonSchema
//   { ...base, ...override, properties: { ...base.properties, ...override.properties } }
// DEFECT: assumed sa_json_object_merge_schema_copy extern implementing
// exactly that two-level merge (fix phase).
fn mergeSchema(base: &JsonBuf, override_: &JsonBuf, out: &JsonBuf) -> void {
    let bp: ptr = PTR_NULL();
    PTR_BYTE_ADD(bp, &base.bytes, 0);
    let op_: ptr = PTR_NULL();
    PTR_BYTE_ADD(op_, &override_.bytes, 0);
    let rp: ptr = PTR_NULL();
    let rl: u64 = 0;
    if sa_json_object_merge_schema_copy(bp, base.len, op_, override_.len, &rp, &rl) == 0 { jsonBufSet(out, rp, rl); return; };
    jsonBufCopy(out, override_);
}

// TS: function fieldFromSchema(path: string[], schema): DynamicCodexConfigField
fn fieldFromSchema(path: &StrList, schema: &JsonBuf, out: &DynamicCodexConfigField) -> void {
    joinStrList(path, STR_PTR("."), STR_LEN("."), &out.keyPath);
    labelFromPathBytes(&out.keyPath, out);
    // (label computed from keyPath by labelFromPathInto below)
    labelFromPathInto(&out.keyPath, &out.label);
    dynamicFieldDescription(&out.keyPath, schema, &out.description);
    let enumValues = StrList { items: [[0u8; 256]; 64], lens: [0u64; 64], len: 0 };
    let hasEnum = extractEnum(schema, &enumValues);
    out.kind = inferSchemaKind(schema, hasEnum, enumValues.len);
    if path.len > 0 {
        out.group.len = 0;
        for j in 0..path.lens[0] { out.group.bytes[j] = path.items[0][j]; }
        out.group.len = path.lens[0];
    } else {
        strBufSet(&out.group, STR_PTR("config"), STR_LEN("config"));
    };
    out.options_len = 0;
    if hasEnum {
        for i in 0..enumValues.len {
            if out.options_len >= 16 { break; };
            let ep: ptr = PTR_NULL();
            PTR_BYTE_ADD(ep, &enumValues.items[i], 0);
            out.options[out.options_len].value.len = 0;
            for j in 0..enumValues.lens[i] { out.options[out.options_len].value.bytes[j] = enumValues.items[i][j]; }
            out.options[out.options_len].value.len = enumValues.lens[i];
            labelFromValue(ep, enumValues.lens[i], &out.options[out.options_len].label);
            out.options_len = out.options_len + 1;
        }
    };
    // defaultValue: schema.default
    let defaultText = JsonBuf { bytes: [0u8; 16384], len: 0 };
    out.has_defaultValue = schemaFieldValue(schema, STR_PTR("default"), STR_LEN("default"), &defaultText);
    out.defaultValue.len = 0;
    if out.has_defaultValue {
        let n = defaultText.len;
        if n > 1024 { n = 1024; };
        for j in 0..n { out.defaultValue.bytes[j] = defaultText.bytes[j]; }
        out.defaultValue.len = n;
    };
    out.has_readOnly = true;
    out.readOnly = false;
    out.source = SOURCE_SCHEMA();
}

fn labelFromPathBytes(keyPath: &StrBuf, out: &DynamicCodexConfigField) -> void {
    // (label is filled by labelFromPathInto; this stub keeps the TS order of
    // operations visible: keyPath -> label -> description -> kind)
}

// TS: function dynamicFieldDescription(keyPath, schema): string
fn dynamicFieldDescription(keyPath: &StrBuf, schema: &JsonBuf, out: &StrBuf) -> void {
    if strBufEq(keyPath, STR_PTR("features.multi_agent_v2.tool_namespace"), STR_LEN("features.multi_agent_v2.tool_namespace")) {
        strBufSet(out, STR_PTR("Optional advanced namespace for multi-agent tools. Leave empty for ordinary function tools; third-party relays must preserve Responses API namespace and function names."), STR_LEN("Optional advanced namespace for multi-agent tools. Leave empty for ordinary function tools; third-party relays must preserve Responses API namespace and function names."));
        return;
    };
    let desc = JsonScalar { kind: 0, text: StrBuf { bytes: [0u8; 1024], len: 0 }, num: 0.0, boolean: false };
    let sp: ptr = PTR_NULL();
    PTR_BYTE_ADD(sp, &schema.bytes, 0);
    if jsonObjectGetScalar(sp, schema.len, STR_PTR("description"), STR_LEN("description"), &desc) && desc.kind == 1 && desc.text.len > 0 {
        *out = desc.text;
        return;
    };
    // `Codex config setting: ${keyPath}`
    strBufSet(out, STR_PTR("Codex config setting: "), STR_LEN("Codex config setting: "));
    for j in 0..keyPath.len {
        if out.len < 1024 { out.bytes[out.len] = keyPath.bytes[j]; out.len = out.len + 1; };
    }
}

// TS: function inferSchemaKind(schema, enumValues?): DynamicCodexConfigField["kind"]
fn inferSchemaKind(schema: &JsonBuf, hasEnum: bool, enumCount: u64) -> u64 {
    if hasEnum && enumCount > 0 { return KIND_SELECT(); };
    // const type = Array.isArray(schema.type) ? schema.type.find(e => e !== "null") : schema.type;
    let typeName = StrBuf { bytes: [0u8; 1024], len: 0 };
    let hasType = false;
    let typeValue = JsonBuf { bytes: [0u8; 16384], len: 0 };
    if schemaFieldValue(schema, STR_PTR("type"), STR_LEN("type"), &typeValue) {
        let scalar = JsonScalar { kind: 0, text: StrBuf { bytes: [0u8; 1024], len: 0 }, num: 0.0, boolean: false };
        jsonValueToScalar(&typeValue, &scalar);
        if scalar.kind == 1 { typeName = scalar.text; hasType = true; } else {
            // array form: first entry !== "null"
            let count = schemaArrayLen(&typeValue);
            for i in 0..count {
                let entry = JsonBuf { bytes: [0u8; 16384], len: 0 };
                if schemaArrayAt(&typeValue, i, &entry) {
                    let es = JsonScalar { kind: 0, text: StrBuf { bytes: [0u8; 1024], len: 0 }, num: 0.0, boolean: false };
                    jsonValueToScalar(&entry, &es);
                    if es.kind == 1 && !strBufEq(&es.text, STR_PTR("null"), STR_LEN("null")) { typeName = es.text; hasType = true; break; };
                };
            }
        };
    };
    if hasType {
        if strBufEq(&typeName, STR_PTR("boolean"), STR_LEN("boolean")) { return KIND_BOOLEAN(); };
        if strBufEq(&typeName, STR_PTR("number"), STR_LEN("number")) { return KIND_NUMBER(); };
        if strBufEq(&typeName, STR_PTR("integer"), STR_LEN("integer")) { return KIND_NUMBER(); };
        if strBufEq(&typeName, STR_PTR("string"), STR_LEN("string")) {
            if isLongTextField(schema) { return KIND_TEXTAREA(); };
            return KIND_TEXT();
        };
        if strBufEq(&typeName, STR_PTR("object"), STR_LEN("object")) { return KIND_JSON(); };
        if strBufEq(&typeName, STR_PTR("array"), STR_LEN("array")) { return KIND_JSON(); };
    };
    // if (type === "object" || type === "array" || schema.properties ||
    //     schema.additionalProperties || schema.items) return "json";
    let probe = JsonBuf { bytes: [0u8; 16384], len: 0 };
    if schemaFieldValue(schema, STR_PTR("properties"), STR_LEN("properties"), &probe) { return KIND_JSON(); };
    if schemaFieldValue(schema, STR_PTR("additionalProperties"), STR_LEN("additionalProperties"), &probe) { return KIND_JSON(); };
    if schemaFieldValue(schema, STR_PTR("items"), STR_LEN("items"), &probe) { return KIND_JSON(); };
    return KIND_JSON();
}

// TS: function inferRuntimeKind(value: unknown): kind
// (value passed as its JsonScalar kind: 1=string, 2=number, 3=boolean)
fn inferRuntimeKind(scalarKind: u64) -> u64 {
    if scalarKind == 3 { return KIND_BOOLEAN(); };
    if scalarKind == 2 { return KIND_NUMBER(); };
    if scalarKind == 1 { return KIND_TEXT(); };
    return KIND_JSON();
}

// TS: function extractEnum(schema): string[] | undefined
fn extractEnum(schema: &JsonBuf, out: &StrList) -> bool {
    out.len = 0;
    let enumValue = JsonBuf { bytes: [0u8; 16384], len: 0 };
    if !schemaFieldValue(schema, STR_PTR("enum"), STR_LEN("enum"), &enumValue) { return false; };
    let count = schemaArrayLen(&enumValue);
    if count == 0 { return false; };
    for i in 0..count {
        let entry = JsonBuf { bytes: [0u8; 16384], len: 0 };
        if !schemaArrayAt(&enumValue, i, &entry) { return false; };
        let scalar = JsonScalar { kind: 0, text: StrBuf { bytes: [0u8; 1024], len: 0 }, num: 0.0, boolean: false };
        jsonValueToScalar(&entry, &scalar);
        if scalar.kind != 1 { return false; };
        let tp: ptr = PTR_NULL();
        PTR_BYTE_ADD(tp, &scalar.text.bytes, 0);
        strListPush(out, tp, scalar.text.len);
    }
    return out.len == count;
}

// TS: function isLongTextField(schema): boolean
fn isLongTextField(schema: &JsonBuf) -> bool {
    let desc = JsonScalar { kind: 0, text: StrBuf { bytes: [0u8; 1024], len: 0 }, num: 0.0, boolean: false };
    let sp: ptr = PTR_NULL();
    PTR_BYTE_ADD(sp, &schema.bytes, 0);
    if !jsonObjectGetScalar(sp, schema.len, STR_PTR("description"), STR_LEN("description"), &desc) || desc.kind != 1 { return false; };
    let lower = StrBuf { bytes: [0u8; 1024], len: 0 };
    lower.len = desc.text.len;
    for j in 0..desc.text.len {
        let b = desc.text.bytes[j];
        if b >= 65 && b <= 90 { b = b + 32; };
        lower.bytes[j] = b;
    }
    let lp: ptr = PTR_NULL();
    PTR_BYTE_ADD(lp, &lower.bytes, 0);
    if bufContains(lp, lower.len, STR_PTR("instructions"), STR_LEN("instructions")) { return true; };
    if bufContains(lp, lower.len, STR_PTR("prompt"), STR_LEN("prompt")) { return true; };
    return bufContains(lp, lower.len, STR_PTR("template"), STR_LEN("template"));
}

// TS: function labelFromPath(keyPath: string): string
//   keyPath.split(".").map(segment => labelFromValue(segment)).join(" / ")
fn labelFromPath(keyPath_ptr: ptr, keyPath_len: u64, out: &StrBuf) -> void {
    let segments = StrList { items: [[0u8; 256]; 64], lens: [0u64; 64], len: 0 };
    splitKeyPath(keyPath_ptr, keyPath_len, &segments);
    out.len = 0;
    for i in 0..segments.len {
        if i > 0 {
            let sep = STR_PTR(" / ");
            for j in 0..STR_LEN(" / ") {
                let b: u8 = 0;
                PTR_BYTE_AT(b, sep, j);
                if out.len < 1024 { out.bytes[out.len] = b; out.len = out.len + 1; };
            }
        };
        let segLabel = StrBuf { bytes: [0u8; 1024], len: 0 };
        let sp: ptr = PTR_NULL();
        PTR_BYTE_ADD(sp, &segments.items[i], 0);
        labelFromValue(sp, segments.lens[i], &segLabel);
        for j in 0..segLabel.len {
            if out.len < 1024 { out.bytes[out.len] = segLabel.bytes[j]; out.len = out.len + 1; };
        }
    }
}

fn labelFromPathInto(keyPath: &StrBuf, out: &StrBuf) -> void {
    let kp: ptr = PTR_NULL();
    PTR_BYTE_ADD(kp, &keyPath.bytes, 0);
    labelFromPath(kp, keyPath.len, out);
}

// TS: function labelFromValue(value: string): string
//   value.replace(/_/g, " ").replace(/-/g, " ")
//        .replace(/\b\w/g, (letter) => letter.toUpperCase())
// DEFECT: \b word-boundary semantics approximated on the original bytes:
// a word char [A-Za-z0-9_] at the start or after a non-word char is
// uppercased (digits unaffected).
fn labelFromValue(value_ptr: ptr, value_len: u64, out: &StrBuf) -> void {
    out.len = 0;
    for i in 0..value_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, value_ptr, i);
        if b == 95 || b == 45 {
            if out.len < 1024 { out.bytes[out.len] = 32; out.len = out.len + 1; };
            continue;
        };
        let isWord = (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || (b >= 48 && b <= 57) || b == 95;
        let atBoundary = i == 0;
        if i > 0 {
            let prev: u8 = 0;
            PTR_BYTE_AT(prev, value_ptr, i - 1);
            let prevIsWord = (prev >= 65 && prev <= 90) || (prev >= 97 && prev <= 122) || (prev >= 48 && prev <= 57) || prev == 95;
            atBoundary = !prevIsWord;
        };
        if isWord && atBoundary && b >= 97 && b <= 122 { b = b - 32; };
        if out.len < 1024 { out.bytes[out.len] = b; out.len = out.len + 1; };
    }
}
