struct CodexConfigQuickView {
    model: TextField,
    reviewModel: TextField,
    modelProvider: TextField,
    modelReasoningEffort: TextField,
    modelReasoningSummary: TextField,
    modelVerbosity: TextField,
    approvalPolicy: TextField,
    sandboxMode: TextField,
    webSearch: TextField,
    serviceTier: TextField,
    instructions: TextField,
    developerInstructions: TextField,
}

// TS: export type CodexUserConfigView = CodexConfigQuickView & { rawConfig: Record<string, unknown> }
struct CodexUserConfigView {
    model: TextField,
    reviewModel: TextField,
    modelProvider: TextField,
    modelReasoningEffort: TextField,
    modelReasoningSummary: TextField,
    modelVerbosity: TextField,
    approvalPolicy: TextField,
