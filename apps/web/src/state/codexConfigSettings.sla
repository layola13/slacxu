// Converted 1:1 from apps/web/src/state/codexConfigSettings.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "sa_std/ptr.sa"
@import "sa_std/string.sa"
@import "sa_std/ts_string.sa"
@import "sa_std/ts_array.sa"
@import "sa_std/ts_math.sa"
// Per SA_TS_INVENTORY.md: JS String/Array/Math semantics in this module bind
// to the sa_std ts_* surface in the fix phase (see _defects/web-ts-state.md,
// entries marked 已绑 sa_std ts 面).

// Curated Codex user-config surface for the Settings page.
// Theme plugins and provider API keys stay out of this module by design.
//
// TS: import type { JsonValue } from "@codex-ui/shared";
// TS: import codexConfigSchema from "./codexConfigSchema.json";
// DEFECT: dynamic JSON — JsonValue / Record<string, unknown> / the imported
// schema JSON have no SLA value type; they are JSON text buffers (JsonBuf)
// and every object read/write below goes through assumed sa_json_* externs
// (fix phase to wire the exact sa_std JSON surface).
// DEFECT: string | null fields use an explicit has flag (TextField).
// DEFECT: DynamicCodexConfigField["kind"] string union is an enum code:
// KIND_BOOLEAN=0, KIND_NUMBER=1, KIND_TEXT=2, KIND_SELECT=3,
// KIND_TEXTAREA=4, KIND_JSON=5. source: "schema"=0, "runtime"=1.

struct StrBuf {
    bytes: [u8; 1024],
    len: u64,
}

struct TextField {
    bytes: [u8; 4096],
    len: u64,
    has: bool,
}

struct JsonBuf {
    bytes: [u8; 16384],
    len: u64,
}

struct JsonBufSmall {
    bytes: [u8; 1024],
    len: u64,
}

struct StrList {
    items: [[u8; 256]; 64],
    lens: [u64; 64],
    len: u64,
}

fn KIND_BOOLEAN() -> u64 { return 0; }
fn KIND_NUMBER() -> u64 { return 1; }
fn KIND_TEXT() -> u64 { return 2; }
fn KIND_SELECT() -> u64 { return 3; }
fn KIND_TEXTAREA() -> u64 { return 4; }
fn KIND_JSON() -> u64 { return 5; }
fn SOURCE_SCHEMA() -> u64 { return 0; }
fn SOURCE_RUNTIME() -> u64 { return 1; }

fn strBufSet(dst: &StrBuf, src_ptr: ptr, src_len: u64) -> void {
    dst.len = 0;
    let n = src_len;
    if n > 1024 { n = 1024; };
    for j in 0..n {
        let b: u8 = 0;
        PTR_BYTE_AT(b, src_ptr, j);
        dst.bytes[dst.len] = b;
        dst.len = dst.len + 1;
    }
}

fn strBufEq(a: &StrBuf, b_ptr: ptr, b_len: u64) -> bool {
    if a.len != b_len { return false; };
    for j in 0..a.len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, b_ptr, j);
        if a.bytes[j] != b { return false; };
    }
    return true;
}

fn strListPush(list: &StrList, src_ptr: ptr, src_len: u64) -> void {
    if list.len >= 64 { return; };
    let n = src_len;
    if n > 256 { n = 256; };
    for j in 0..n {
        let b: u8 = 0;
        PTR_BYTE_AT(b, src_ptr, j);
        list.items[list.len][j] = b;
    }
    list.lens[list.len] = n;
    list.len = list.len + 1;
}

fn strListContains(list: &StrList, src_ptr: ptr, src_len: u64) -> bool {
    for i in 0..list.len {
        if list.lens[i] == src_len {
            let same = true;
            for j in 0..src_len {
                let b: u8 = 0;
                PTR_BYTE_AT(b, src_ptr, j);
                if list.items[i][j] != b { same = false; };
            }
            if same { return true; };
        };
    }
    return false;
}

fn jsonBufSet(dst: &JsonBuf, src_ptr: ptr, src_len: u64) -> void {
    dst.len = 0;
    let n = src_len;
    if n > 16384 { n = 16384; };
    for j in 0..n {
        let b: u8 = 0;
        PTR_BYTE_AT(b, src_ptr, j);
        dst.bytes[dst.len] = b;
        dst.len = dst.len + 1;
    }
}

fn jsonBufCopy(dst: &JsonBuf, src: &JsonBuf) -> void {
    dst.len = src.len;
    for j in 0..src.len { dst.bytes[j] = src.bytes[j]; }
}

fn bufContains(hay_ptr: ptr, hay_len: u64, needle_ptr: ptr, needle_len: u64) -> bool {
    if needle_len == 0 { return true; };
    if hay_len < needle_len { return false; };
    let i: u64 = 0;
    while i + needle_len <= hay_len {
        let same = true;
        for j in 0..needle_len {
            let a: u8 = 0;
            let b: u8 = 0;
            PTR_BYTE_AT(a, hay_ptr, i + j);
            PTR_BYTE_AT(b, needle_ptr, j);
            if a != b { same = false; };
        }
        if same { return true; };
        i = i + 1;
    }
    return false;
}

// A JSON scalar extracted from a buffer: kind 0=null/undefined, 1=string,
// 2=number, 3=boolean, 4=other (object/array). text holds the string value
// (kind 1) or the rendered form (kinds 2/3, for String(value)).
// DEFECT: JS String(number) rendering (exponent forms, -0, NaN) is the
// caller's rendering; this pass stores the JSON source text for numbers.
struct JsonScalar {
    kind: u64,
    text: StrBuf,
    num: f64,
    boolean: bool,
}

// Reads one object field of a JSON text buffer into a scalar.
// DEFECT: assumed sa_json_object_get_scalar extern (fix phase).
fn jsonObjectGetScalar(obj_ptr: ptr, obj_len: u64, key_ptr: ptr, key_len: u64, out: &JsonScalar) -> bool {
    let kind: u64 = 0;
    let tp: ptr = PTR_NULL();
    let tl: u64 = 0;
    let num: f64 = 0.0;
    let boolean = false;
    let rc = sa_json_object_get_scalar(obj_ptr, obj_len, key_ptr, key_len, &kind, &tp, &tl, &num, &boolean);
    if rc != 0 { return false; };
    out.kind = kind;
    strBufSet(&out.text, tp, tl);
    out.num = num;
    out.boolean = boolean;
    return true;
}

// TS: export type CodexConfigQuickView = { model: string | null; ... }
