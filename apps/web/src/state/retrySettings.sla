// Converted 1:1 from apps/web/src/state/retrySettings.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "sa_std/ptr.sa"
@import "sa_std/string.sa"
@import "sa_std/ts_math.sa"
// Per SA_TS_INVENTORY.md: Math.round/min/max semantics bind to the sa_std
// ts_math surface (@ts_math_rounding / @ts_math_minmax) — 已绑 sa_std ts 面
// (call sites finalized in the fix phase; see _defects/web-ts-state.md).

// TS: export const CODEX_STREAM_RETRY_MIN = 5;
fn CODEX_STREAM_RETRY_MIN() -> i32 { return 5; }
// TS: export const CODEX_STREAM_RETRY_MAX = 100;
fn CODEX_STREAM_RETRY_MAX() -> i32 { return 100; }
// TS: export const CODEX_STREAM_RETRY_DEFAULT = 5;
fn CODEX_STREAM_RETRY_DEFAULT() -> i32 { return 5; }

// TS: export function clampRetryCount(value: unknown): number
//   const parsed = typeof value === "number" ? value : Number(value);
//   return Number.isFinite(parsed)
//     ? Math.min(CODEX_STREAM_RETRY_MAX, Math.max(CODEX_STREAM_RETRY_MIN, Math.round(parsed)))
//     : CODEX_STREAM_RETRY_DEFAULT;
// DEFECT: unknown + Number(value) coercion of arbitrary JS values (strings,
// objects, null) has no SLA equivalent; the caller supplies the already-coerced
// numeric value plus its finiteness, so string/object coercion is lost.
// DEFECT: Math.round (round-half-up toward +Infinity for .5) approximated by
// (value + 0.5) truncation for the clamp-relevant range; negative halves differ.
fn clampRetryCount(value: f64, valueIsFinite: bool) -> i32 {
    if !valueIsFinite { return CODEX_STREAM_RETRY_DEFAULT(); };
    let rounded: i32 = (value + 0.5) as i32;
    if value < 0.0 && value + 0.5 < 0.0 { rounded = (value - 0.5) as i32; };
    let clamped = rounded;
    if clamped < CODEX_STREAM_RETRY_MIN() { clamped = CODEX_STREAM_RETRY_MIN(); };
    if clamped > CODEX_STREAM_RETRY_MAX() { clamped = CODEX_STREAM_RETRY_MAX(); };
    return clamped;
}
