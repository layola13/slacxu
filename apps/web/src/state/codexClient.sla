}

// TS: private armResumeProbe(socket, sentAt): void
fn codexSocketClientArmResumeProbe(client: &CodexSocketClient, handle: u64, sentAt: f64) -> void {
    if client.has_resumeProbeTimer { return; };
    client.has_resumeProbeTimer = true;
    client.resumeProbeSocket = handle;
    client.resumeProbeSentAt = sentAt;
    client.resumeProbeDueMs = sentAt + RESUME_PROBE_TIMEOUT_MS() as f64;
