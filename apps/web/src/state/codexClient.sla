// reactivateTurnForActivity (defined with the status helpers in TS at line
// ~3990; the in-place form is used by the branches here)
fn reactivateTurnInPlace(turn: &WorkbenchTurn, active: bool) -> void {
    if !active { return; };
    if !turn.has_status { return; };
    let st = SStr { bytes: [0u8; 512], len: 0, has: true };
    st.len = turn.status_len;
    for j in 0..turn.status_len { st.bytes[j] = turn.status_bytes[j]; }
    if isTerminalWorkbenchStatus(sstrPtrC(&st), st.len) && !isInterruptedWorkbenchStatus(sstrPtrC(&st), st.len) {
        turnSetStatus(turn, true, STR_PTR("inProgress"), STR_LEN("inProgress"));
        turn.has_completedAt = false;
        turn.completedAt = 0.0;
    };
}

// TS branch: method === "item/started" || method === "item/completed"
fn applyNotifItemStartedOrCompleted(state: &ClientState, params_ptr: ptr, params_len: u64, completed: bool, jev: &JevDispatchList, now_ms: f64, out: &ClientState) -> void {
    *out = *state;
    let now_s = now_ms / 1000.0;
    let itemVal = JsonBufC { bytes: [0u8; 16384], len: 0 };
    if !recVal(params_ptr, params_len, STR_PTR("item"), STR_LEN("item"), &itemVal) { return; };
    let item = JsonBufC { bytes: [0u8; 16384], len: 0 };
    asRecordC(jsonPtrC(&itemVal), itemVal.len, &item);
    let ip: ptr = jsonPtrC(&item);
    let itemId = SStr { bytes: [0u8; 512], len: 0, has: false };
    if !recStr(ip, item.len, STR_PTR("id"), STR_LEN("id"), &itemId) { return; };
    let turnId = SStr { bytes: [0u8; 512], len: 0, has: false };
    if !recStrAlt(params_ptr, params_len, STR_PTR("turnId"), STR_LEN("turnId"), STR_PTR("turn_id"), STR_LEN("turn_id"), &turnId) { return; };
    let rawType = SStr { bytes: [0u8; 512], len: 0, has: false };
    let hasRawType = recStr(ip, item.len, STR_PTR("type"), STR_LEN("type"), &rawType);
    if !hasRawType { inferItemType(ip, item.len, &rawType); };
    let normalizedType = SStr { bytes: [0u8; 512], len: 0, has: false };
    normalizeWorkbenchItemType(sstrPtrC(&rawType), rawType.len, ip, item.len, &normalizedType);
    let isCompaction = sstrEqLitC(&normalizedType, STR_PTR("contextCompaction"), STR_LEN("contextCompaction"));
    let notifThreadId = SStr { bytes: [0u8; 512], len: 0, has: false };
    let hasNotifThread = recStrAlt(params_ptr, params_len, STR_PTR("threadId"), STR_LEN("threadId"), STR_PTR("thread_id"), STR_LEN("thread_id"), &notifThreadId);
    // activeCompaction search (reversed turns, reversed items)
    let effTurnId = turnId;
    let hasCompactionItem = false;
    let compactionTurnIdx: u64 = 0;
    let compactionItemIdx: u64 = 0;
    if isCompaction && completed {
        let ti = out.turns_len;
        while ti > 0 {
            ti = ti - 1;
            let turn = &out.turns_items[ti];
            if hasNotifThread {
                let same = turn.threadId_len == notifThreadId.len;
                if same { for j in 0..notifThreadId.len { if turn.threadId_bytes[j] != notifThreadId.bytes[j] { same = false; }; }; };
                if !same { continue; };
            };
            let ii = turn.items_len;
            while ii > 0 {
                ii = ii - 1;
                let cand = &turn.items_items[ii];
                let typeEq = cand.type_len == 17;
                if typeEq { for j in 0..17 { let b: u8 = 0; PTR_BYTE_AT(b, STR_PTR("contextCompaction"), j); if cand.type_bytes[j] != b { typeEq = false; }; }; };
                if typeEq {
                    let terminal = false;
                    if cand.has_status {
                        let st = SStr { bytes: [0u8; 512], len: 0, has: true };
                        st.len = cand.status_len;
                        for j in 0..cand.status_len { st.bytes[j] = cand.status_bytes[j]; }
                        terminal = isTerminalWorkbenchStatus(sstrPtrC(&st), st.len);
                    };
                    if !terminal { hasCompactionItem = true; compactionTurnIdx = ti; compactionItemIdx = ii; effTurnId.len = 0; effTurnId.has = true; for j in 0..turn.id_len { effTurnId.bytes[j] = turn.id_bytes[j]; }; effTurnId.len = turn.id_len; break; };
                };
            }
            if hasCompactionItem { break; };
        }
    };
    let effTurnIdx: u64 = 0;
    let hasEffTurn = stateFindTurn(out, sstrPtrC(&effTurnId), effTurnId.len, &effTurnIdx);
    if isCompaction && !hasCompactionItem && hasEffTurn {
        let turn = &out.turns_items[effTurnIdx];
        let ii = turn.items_len;
        while ii > 0 {
            ii = ii - 1;
            let cand = &turn.items_items[ii];
            let typeEq = cand.type_len == 17;
            if typeEq { for j in 0..17 { let b: u8 = 0; PTR_BYTE_AT(b, STR_PTR("contextCompaction"), j); if cand.type_bytes[j] != b { typeEq = false; }; }; };
            if typeEq {
                let terminal = false;
                if cand.has_status {
                    let st = SStr { bytes: [0u8; 512], len: 0, has: true };
                    st.len = cand.status_len;
                    for j in 0..cand.status_len { st.bytes[j] = cand.status_bytes[j]; }
                    terminal = isTerminalWorkbenchStatus(sstrPtrC(&st), st.len);
                };
                if !terminal { hasCompactionItem = true; compactionTurnIdx = effTurnIdx; compactionItemIdx = ii; break; };
            };
        }
    };
    let effItemId = itemId;
    let hasExisting = false;
    let existingIdx: u64 = 0;
    if completed && hasCompactionItem {
        let ct = &out.turns_items[compactionTurnIdx];
        let ci = &ct.items_items[compactionItemIdx];
        effItemId.len = 0;
        effItemId.has = true;
        for j in 0..ci.id_len { effItemId.bytes[j] = ci.id_bytes[j]; };
        effItemId.len = ci.id_len;
        hasExisting = true;
        existingIdx = compactionItemIdx;
        effTurnIdx = compactionTurnIdx;
        hasEffTurn = true;
    } else if hasEffTurn {
        hasExisting = turnFindItem(&out.turns_items[effTurnIdx], sstrPtrC(&effItemId), effItemId.len, &existingIdx);
    };
    let existing = blankWorkbenchItem();
    if hasExisting { existing = out.turns_items[effTurnIdx].items_items[existingIdx]; };
    let rawText = BigStrC { bytes: [0u8; 8192], len: 0 };
    itemText(ip, item.len, &rawText);
    let completedText = BigStrC { bytes: [0u8; 8192], len: 0 };
    sanitizeRelayErrorText(bigPtrC(&rawText), rawText.len, &completedText);
    // reasoning + empty completion text: keep accumulated text (trim check
    // binds @ts_str_trim from sa_std/ts_string.sa)
    let useExistingText = false;
    if sstrEqLitC(&normalizedType, STR_PTR("reasoning"), STR_LEN("reasoning")) {
        let tp2: ptr = PTR_NULL();
        let tl2: u64 = 0;
        @ts_str_trim(bigPtrC(&completedText), completedText.len, &tp2, &tl2);
        if tl2 == 0 { useExistingText = true; };
    };
    if (sstrEqLitC(&normalizedType, STR_PTR("userMessage"), STR_LEN("userMessage")) || sstrEqLitC(&normalizedType, STR_PTR("goalContinuation"), STR_LEN("goalContinuation"))) && isInternalContinuationPrompt(bigPtrC(&completedText), completedText.len) { return; };
    let nextItem = blankWorkbenchItem();
    itemSetId(&nextItem, sstrPtrC(&effItemId), effItemId.len);
    itemSetType(&nextItem, sstrPtrC(&normalizedType), normalizedType.len);
    let title = SStr { bytes: [0u8; 512], len: 0, has: false };
    itemTitle(ip, item.len, &title);
    itemSetTitle(&nextItem, sstrPtrC(&title), title.len);
    if useExistingText { itemSetText(&nextItem, bigPtrExistingText(&existing), existing.text_len); } else { itemSetText(&nextItem, bigPtrC(&completedText), completedText.len); };
    itemImagesInto(ip, item.len, &nextItem);
    itemFilesInto(ip, item.len, &nextItem);
    let itemStatus = SStr { bytes: [0u8; 512], len: 0, has: false };
    if recStr(ip, item.len, STR_PTR("status"), STR_LEN("status"), &itemStatus) {
        itemSetStatus(&nextItem, true, sstrPtrC(&itemStatus), itemStatus.len);
    } else if completed {
        itemSetStatus(&nextItem, true, STR_PTR("completed"), STR_LEN("completed"));
    } else if isCompaction {
        itemSetStatus(&nextItem, true, STR_PTR("inProgress"), STR_LEN("inProgress"));
    };
    if hasExisting && existing.has_startedAt { nextItem.has_startedAt = true; nextItem.startedAt = existing.startedAt; } else {
        let v: f64 = 0.0;
        if recNumAlt(ip, item.len, STR_PTR("startedAt"), STR_LEN("startedAt"), STR_PTR("started_at"), STR_LEN("started_at"), &v) { nextItem.has_startedAt = true; nextItem.startedAt = v; } else if !completed { nextItem.has_startedAt = true; nextItem.startedAt = now_s; };
    };
    if hasExisting && existing.has_firstTokenAt { nextItem.has_firstTokenAt = true; nextItem.firstTokenAt = existing.firstTokenAt; } else {
        let v: f64 = 0.0;
        if recNumAlt(ip, item.len, STR_PTR("firstTokenAt"), STR_LEN("firstTokenAt"), STR_PTR("first_token_at"), STR_LEN("first_token_at"), &v) { nextItem.has_firstTokenAt = true; nextItem.firstTokenAt = v; };
    };
    let upd: f64 = 0.0;
    if recNumAlt(ip, item.len, STR_PTR("updatedAt"), STR_LEN("updatedAt"), STR_PTR("updated_at"), STR_LEN("updated_at"), &upd) { nextItem.has_updatedAt = true; nextItem.updatedAt = upd; } else if completed { nextItem.has_updatedAt = true; nextItem.updatedAt = now_s; } else if hasExisting && existing.has_updatedAt { nextItem.has_updatedAt = true; nextItem.updatedAt = existing.updatedAt; };
    agentItemMetadataInto(ip, item.len, params_ptr, params_len, completed, &nextItem);
    // payload: { ...existingPayload, ...item }
    {
        let ep: ptr = PTR_NULL();
        PTR_BYTE_ADD(ep, &existing.payload_bytes, 0);
        let baseLen = existing.payload_len;
        if !hasExisting || !existing.has_payload { ep = STR_PTR("{}"); baseLen = 2; };
        let rp: ptr = PTR_NULL();
        let rl: u64 = 0;
        if sa_json_object_merge_copy(ep, baseLen, ip, item.len, &rp, &rl) == 0 {
            nextItem.has_payload = true;
            let n = rl;
            if n > 4096 { n = 4096; };
            for j in 0..n { let b: u8 = 0; PTR_BYTE_AT(b, rp, j); nextItem.payload_bytes[j] = b; }
            nextItem.payload_len = n;
        };
    };
    // itemThreadId: notification ?? owner turn's threadId ?? turnId placeholder
    let itemThreadId = SStr { bytes: [0u8; 512], len: 0, has: false };
    if hasNotifThread { itemThreadId = notifThreadId; } else if hasEffTurn {
        let t = &out.turns_items[effTurnIdx];
        itemThreadId.has = true;
        itemThreadId.len = t.threadId_len;
        for j in 0..t.threadId_len { itemThreadId.bytes[j] = t.threadId_bytes[j]; }
    } else { itemThreadId = effTurnId; };
    // JEV: toolCall spawn_agent / wait_agent audit
    if completed && (sstrEqLitC(&normalizedType, STR_PTR("toolCall"), STR_LEN("toolCall")) || sstrEqLitC(&normalizedType, STR_PTR("toolUse"), STR_LEN("toolUse")) || sstrEqLitC(&normalizedType, STR_PTR("tool_use"), STR_LEN("tool_use"))) {
        let toolName = SStr { bytes: [0u8; 512], len: 0, has: false };
        recStr(ip, item.len, STR_PTR("name"), STR_LEN("name"), &toolName);
        if sstrEqLitC(&toolName, STR_PTR("spawn_agent"), STR_LEN("spawn_agent")) {
            let argsText = SStr { bytes: [0u8; 512], len: 0, has: false };
            if !recStr(ip, item.len, STR_PTR("arguments"), STR_LEN("arguments"), &argsText) { recStr(ip, item.len, STR_PTR("args"), STR_LEN("args"), &argsText); };
            let args = JsonBufC { bytes: [0u8; 16384], len: 0 };
            asRecordC(sstrPtrC(&argsText), argsText.len, &args);
            let ap: ptr = jsonPtrC(&args);
            let brief = SStr { bytes: [0u8; 512], len: 0, has: false };
            let briefBig = BigStrC { bytes: [0u8; 8192], len: 0 };
            // DEFECT: brief is a full string in TS; SStr caps at 512 here, so
            // read it as a raw JSON string value into the big buffer instead.
            let bvp: ptr = PTR_NULL();
            let bvl: u64 = 0;
            if sa_json_object_get_string(ap, args.len, STR_PTR("message"), STR_LEN("message"), &bvp, &bvl) != 0 {
                if sa_json_object_get_string(ap, args.len, STR_PTR("text"), STR_LEN("text"), &bvp, &bvl) != 0 { sa_json_object_get_string(ap, args.len, STR_PTR("prompt"), STR_LEN("prompt"), &bvp, &bvl); };
            };
            bigStrAppend(&briefBig, bvp, bvl);
            let taskName = SStr { bytes: [0u8; 512], len: 0, has: false };
            if !recStr(ap, args.len, STR_PTR("task_name"), STR_LEN("task_name"), &taskName) { recStr(ap, args.len, STR_PTR("taskName"), STR_LEN("taskName"), &taskName); };
            let outText = SStr { bytes: [0u8; 512], len: 0, has: false };
            recStr(ip, item.len, STR_PTR("output"), STR_LEN("output"), &outText);
            let outRec = JsonBufC { bytes: [0u8; 16384], len: 0 };
            asRecordC(sstrPtrC(&outText), outText.len, &outRec);
            let agentId = SStr { bytes: [0u8; 512], len: 0, has: false };
            recStr(jsonPtrC(&outRec), outRec.len, STR_PTR("agent_id"), STR_LEN("agent_id"), &agentId);
            let briefNonEmpty = false;
            let tp3: ptr = PTR_NULL();
            let tl3: u64 = 0;
            @ts_str_trim(bigPtrC(&briefBig), briefBig.len, &tp3, &tl3);
            if tl3 > 0 { briefNonEmpty = true; };
            if agentId.has && briefNonEmpty {
                let bl = briefBig.len;
                if bl > 4000 { bl = 4000; };
                dispatchJevSubagent(jev, STR_PTR("brief"), STR_LEN("brief"), &itemThreadId, &effTurnId, &agentId, &taskName, false, &taskName, bigPtrC(&briefBig), bl, &out.token);
            };
        } else if sstrEqLitC(&toolName, STR_PTR("wait_agent"), STR_LEN("wait_agent")) {
            let outText = SStr { bytes: [0u8; 512], len: 0, has: false };
            recStr(ip, item.len, STR_PTR("output"), STR_LEN("output"), &outText);
            let outRec = JsonBufC { bytes: [0u8; 16384], len: 0 };
            asRecordC(sstrPtrC(&outText), outText.len, &outRec);
            let agentsVal = JsonBufC { bytes: [0u8; 16384], len: 0 };
            if recVal(jsonPtrC(&outRec), outRec.len, STR_PTR("agents"), STR_LEN("agents"), &agentsVal) {
                let count = sa_json_array_len(jsonPtrC(&agentsVal), agentsVal.len);
                for k in 0..count {
                    let evp: ptr = PTR_NULL();
                    let evl: u64 = 0;
                    if sa_json_array_at_value_text(jsonPtrC(&agentsVal), agentsVal.len, k, &evp, &evl) != 0 { continue; };
                    let agent = JsonBufC { bytes: [0u8; 16384], len: 0 };
                    asRecordC(evp, evl, &agent);
                    let agp: ptr = jsonPtrC(&agent);
                    let status = SStr { bytes: [0u8; 512], len: 0, has: false };
                    recStr(agp, agent.len, STR_PTR("status"), STR_LEN("status"), &status);
                    let agentId = SStr { bytes: [0u8; 512], len: 0, has: false };
                    recStr(agp, agent.len, STR_PTR("agent_id"), STR_LEN("agent_id"), &agentId);
                    let rvp: ptr = PTR_NULL();
                    let rvl: u64 = 0;
                    sa_json_object_get_string(agp, agent.len, STR_PTR("report"), STR_LEN("report"), &rvp, &rvl);
                    let reportNonEmpty = false;
                    let tp4: ptr = PTR_NULL();
                    let tl4: u64 = 0;
                    @ts_str_trim(rvp, rvl, &tp4, &tl4);
                    if tl4 > 0 { reportNonEmpty = true; };
                    let statusOk = sstrEqLitC(&status, STR_PTR("completed"), STR_LEN("completed")) || sstrEqLitC(&status, STR_PTR("failed"), STR_LEN("failed")) || sstrEqLitC(&status, STR_PTR("interrupted"), STR_LEN("interrupted"));
                    if agentId.has && reportNonEmpty && statusOk {
                        let rl2 = rvl;
                        if rl2 > 6000 { rl2 = 6000; };
                        let emptyName = SStr { bytes: [0u8; 512], len: 0, has: false };
                        dispatchJevSubagent(jev, STR_PTR("report"), STR_LEN("report"), &itemThreadId, &effTurnId, &agentId, &emptyName, true, &status, rvp, rl2, &out.token);
                    };
                }
            };
        };
    };
    // JEV: collabAgentToolCall briefs/reports + plan audit
    if sstrEqLitC(&rawType, STR_PTR("collabAgentToolCall"), STR_LEN("collabAgentToolCall")) {
        let ext = JevExtract { agentId: SStr { bytes: [0u8; 512], len: 0, has: false }, taskName: SStr { bytes: [0u8; 512], len: 0, has: false }, has_status: false, status: SStr { bytes: [0u8; 512], len: 0, has: false }, text: BigStrC { bytes: [0u8; 8192], len: 0 } };
        if completed {
            if extractJevCollabReport(ip, item.len, &ext) {
                dispatchJevSubagent(jev, STR_PTR("report"), STR_LEN("report"), &itemThreadId, &effTurnId, &ext.agentId, &ext.taskName, ext.has_status, &ext.status, bigPtrC(&ext.text), ext.text.len, &out.token);
            } else if extractJevCollabBrief(ip, item.len, &ext) {
                dispatchJevSubagent(jev, STR_PTR("brief"), STR_LEN("brief"), &itemThreadId, &effTurnId, &ext.agentId, &ext.taskName, false, &ext.status, bigPtrC(&ext.text), ext.text.len, &out.token);
            };
        } else if extractJevCollabBrief(ip, item.len, &ext) {
            dispatchJevSubagent(jev, STR_PTR("brief"), STR_LEN("brief"), &itemThreadId, &effTurnId, &ext.agentId, &ext.taskName, false, &ext.status, bigPtrC(&ext.text), ext.text.len, &out.token);
        };
    } else if completed && sstrEqLitC(&normalizedType, STR_PTR("plan"), STR_LEN("plan")) {
        let tp5: ptr = PTR_NULL();
        let tl5: u64 = 0;
        @ts_str_trim(bigPtrC(&completedText), completedText.len, &tp5, &tl5);
        if tl5 > 0 {
            let userPrompt = BigStrC { bytes: [0u8; 8192], len: 0 };
            if hasEffTurn {
                let owner = &out.turns_items[effTurnIdx];
                for ii in 0..owner.items_len {
                    let cand = &owner.items_items[ii];
                    let isUser = cand.type_len == 11;
                    if isUser { for j in 0..11 { let b: u8 = 0; PTR_BYTE_AT(b, STR_PTR("userMessage"), j); if cand.type_bytes[j] != b { isUser = false; }; }; };
                    if isUser && cand.text_len > 0 {
                        if userPrompt.len > 0 { bigStrAppend(&userPrompt, STR_PTR("\n---\n"), STR_LEN("\n---\n")); };
                        let cp: ptr = PTR_NULL();
                        PTR_BYTE_ADD(cp, &cand.text_bytes, 0);
                        bigStrAppend(&userPrompt, cp, cand.text_len);
                    };
                }
            };
            if userPrompt.len > 2000 { userPrompt.len = 2000; };
            let pl = completedText.len;
            if pl > 6000 { pl = 6000; };
            dispatchJevPlanCreated(jev, &itemThreadId, &effTurnId, bigPtrC(&completedText), pl, bigPtrC(&userPrompt), userPrompt.len, &out.token);
        };
    };
    // upsert into the turn (or create the turn)
    if hasEffTurn {
        reactivateTurnInPlace(&out.turns_items[effTurnIdx], !completed);
        turnUpsertItem(&out.turns_items[effTurnIdx], &nextItem);
    } else {
        let stub = blankWorkbenchTurn();
        turnSetId(&stub, sstrPtrC(&effTurnId), effTurnId.len);
        turnSetThreadId(&stub, sstrPtrC(&itemThreadId), itemThreadId.len);
        turnSetStatus(&stub, true, STR_PTR("inProgress"), STR_LEN("inProgress"));
        stub.has_startedAt = true;
        if nextItem.has_startedAt { stub.startedAt = nextItem.startedAt; } else { stub.startedAt = @ts_math_rounding(now_s, 0); };
        if stub.items_len < 128 { stub.items_items[stub.items_len] = nextItem; stub.items_len = stub.items_len + 1; };
        stateUpsertTurn(out, &stub);
    };
}

// ---- updateTurnItem-based branches ----
// DEFECT: TS updateTurnItem takes an updater closure; each call site is
// inlined here with the closure body transcribed.

fn findTurnAndItem(state: &ClientState, turnId: &SStr, itemId: &SStr, out_turnIdx: &u64, out_itemIdx: &u64, out_hasItem: &bool) -> bool {
    let ti: u64 = 0;
    if !stateFindTurn(state, sstrPtrC(turnId), turnId.len, &ti) { return false; };
    *out_turnIdx = ti;
    let ii: u64 = 0;
    let has = turnFindItem(&state.turns_items[ti], sstrPtrC(itemId), itemId.len, &ii);
    *out_itemIdx = ii;
    *out_hasItem = has;
    return true;
}

// TS branch: "item/commandExecution/outputDelta" (kind 0),
// "item/fileChange/patchUpdated" (kind 1),
// "item/commandExecution/terminalInteraction" (kind 2)
fn applyNotifItemPatch(state: &ClientState, params_ptr: ptr, params_len: u64, kind: u64, now_ms: f64, out: &ClientState) -> void {
    *out = *state;
    let now_s = now_ms / 1000.0;
    let itemId = SStr { bytes: [0u8; 512], len: 0, has: false };
    let turnId = SStr { bytes: [0u8; 512], len: 0, has: false };
    if !recStrAlt(params_ptr, params_len, STR_PTR("itemId"), STR_LEN("itemId"), STR_PTR("item_id"), STR_LEN("item_id"), &itemId) { return; };
    if !recStrAlt(params_ptr, params_len, STR_PTR("turnId"), STR_LEN("turnId"), STR_PTR("turn_id"), STR_LEN("turn_id"), &turnId) { return; };
    let ti: u64 = 0;
    let ii: u64 = 0;
    let hasItem = false;
    if !findTurnAndItem(out, &turnId, &itemId, &ti, &ii, &hasItem) {
        // TS updateTurnItem creates the turn when missing:
        // { id: turnId, threadId: state.activeThreadId ?? turnId,
        //   status: "inProgress", startedAt: floor(Date.now()/1000),
        //   items: [update(undefined)] }
        let stub = blankWorkbenchTurn();
        turnSetId(&stub, sstrPtrC(&turnId), turnId.len);
        if out.activeThreadId.has { turnSetThreadId(&stub, sstrPtrC(&out.activeThreadId), out.activeThreadId.len); } else { turnSetThreadId(&stub, sstrPtrC(&turnId), turnId.len); };
        turnSetStatus(&stub, true, STR_PTR("inProgress"), STR_LEN("inProgress"));
        stub.has_startedAt = true;
        stub.startedAt = @ts_math_rounding(now_s, 0);
        stateUpsertTurn(out, &stub);
        if !findTurnAndItem(out, &turnId, &itemId, &ti, &ii, &hasItem) { return; };
    } else {
        // TS updateTurnItem reactivates the turn for activity
        reactivateTurnInPlace(&out.turns_items[ti], true);
    };
    let item = blankWorkbenchItem();
    if hasItem { item = out.turns_items[ti].items_items[ii]; } else {
        itemSetId(&item, sstrPtrC(&itemId), itemId.len);
        itemSetText(&item, STR_PTR(""), 0);
        itemSetStatus(&item, true, STR_PTR("inProgress"), STR_LEN("inProgress"));
        if kind == 1 { itemSetType(&item, STR_PTR("fileChange"), STR_LEN("fileChange")); itemSetTitle(&item, STR_PTR("File change"), STR_LEN("File change")); } else { itemSetType(&item, STR_PTR("commandExecution"), STR_LEN("commandExecution")); itemSetTitle(&item, STR_PTR("Command"), STR_LEN("Command")); };
    };
    if kind == 0 {
        itemSetType(&item, STR_PTR("commandExecution"), STR_LEN("commandExecution"));
        if item.title_len == 0 { itemSetTitle(&item, STR_PTR("Command"), STR_LEN("Command")); };
        let delta = SStr { bytes: [0u8; 512], len: 0, has: false };
        recStr(params_ptr, params_len, STR_PTR("delta"), STR_LEN("delta"), &delta);
        // delta is a full string in TS; the 512-byte SStr read truncates very
        // long deltas (DEFECT: fixed capacity).
        itemAppendText(&item, sstrPtrC(&delta), delta.len);
        if !item.has_status { itemSetStatus(&item, true, STR_PTR("inProgress"), STR_LEN("inProgress")); };
        if !item.has_firstTokenAt { item.has_firstTokenAt = true; item.firstTokenAt = now_s; };
    } else if kind == 1 {
        itemSetType(&item, STR_PTR("fileChange"), STR_LEN("fileChange"));
        if item.title_len == 0 { itemSetTitle(&item, STR_PTR("File change"), STR_LEN("File change")); };
        if !item.has_status { itemSetStatus(&item, true, STR_PTR("inProgress"), STR_LEN("inProgress")); };
        if !item.has_firstTokenAt { item.has_firstTokenAt = true; item.firstTokenAt = now_s; };
        let changes = JsonBufC { bytes: [0u8; 16384], len: 0 };
        jsonBufSetC(&changes, STR_PTR("[]"), STR_LEN("[]"));
        let cv = JsonBufC { bytes: [0u8; 16384], len: 0 };
        if recVal(params_ptr, params_len, STR_PTR("changes"), STR_LEN("changes"), &cv) { changes = cv; };
        let ep: ptr = PTR_NULL();
        PTR_BYTE_ADD(ep, &item.payload_bytes, 0);
        let baseLen = item.payload_len;
        if !item.has_payload { ep = STR_PTR("{}"); baseLen = 2; };
        let rp: ptr = PTR_NULL();
        let rl: u64 = 0;
        if sa_json_object_set_value_text(ep, baseLen, STR_PTR("changes"), STR_LEN("changes"), jsonPtrC(&changes), changes.len, &rp, &rl) == 0 {
            item.has_payload = true;
            let n = rl;
            if n > 4096 { n = 4096; };
            for j in 0..n { let b: u8 = 0; PTR_BYTE_AT(b, rp, j); item.payload_bytes[j] = b; }
            item.payload_len = n;
        };
    } else {
        itemSetType(&item, STR_PTR("commandExecution"), STR_LEN("commandExecution"));
        if item.title_len == 0 { itemSetTitle(&item, STR_PTR("Command"), STR_LEN("Command")); };
        if !item.has_firstTokenAt { item.has_firstTokenAt = true; item.firstTokenAt = now_s; };
        let ep: ptr = PTR_NULL();
        PTR_BYTE_ADD(ep, &item.payload_bytes, 0);
        let baseLen = item.payload_len;
        if !item.has_payload { ep = STR_PTR("{}"); baseLen = 2; };
        let rp: ptr = PTR_NULL();
        let rl: u64 = 0;
        // terminalInteraction: params (the whole params record as JsonValue)
        if sa_json_object_set_value_text(ep, baseLen, STR_PTR("terminalInteraction"), STR_LEN("terminalInteraction"), params_ptr, params_len, &rp, &rl) == 0 {
            item.has_payload = true;
            let n = rl;
            if n > 4096 { n = 4096; };
            for j in 0..n { let b: u8 = 0; PTR_BYTE_AT(b, rp, j); item.payload_bytes[j] = b; }
            item.payload_len = n;
        };
    };
    turnUpsertItem(&out.turns_items[ti], &item);
}

// TS branch: method === "item/agentMessage/delta"
fn applyNotifAgentMessageDelta(state: &ClientState, params_ptr: ptr, params_len: u64, now_ms: f64, out: &ClientState) -> void {
    *out = *state;
    let now_s = now_ms / 1000.0;
    let itemId = SStr { bytes: [0u8; 512], len: 0, has: false };
    let turnId = SStr { bytes: [0u8; 512], len: 0, has: false };
    if !recStrAlt(params_ptr, params_len, STR_PTR("itemId"), STR_LEN("itemId"), STR_PTR("item_id"), STR_LEN("item_id"), &itemId) { return; };
    if !recStrAlt(params_ptr, params_len, STR_PTR("turnId"), STR_LEN("turnId"), STR_PTR("turn_id"), STR_LEN("turn_id"), &turnId) { return; };
    let deltaVal = JsonBufC { bytes: [0u8; 16384], len: 0 };
    let delta = BigStrC { bytes: [0u8; 8192], len: 0 };
    if recVal(params_ptr, params_len, STR_PTR("delta"), STR_LEN("delta"), &deltaVal) {
        let dvp: ptr = PTR_NULL();
        let dvl: u64 = 0;
        if sa_json_value_string(jsonPtrC(&deltaVal), deltaVal.len, &dvp, &dvl) == 0 { bigStrAppend(&delta, dvp, dvl); };
    };
    let ti: u64 = 0;
    if !stateFindTurn(out, sstrPtrC(&turnId), turnId.len, &ti) {
        let threadId = SStr { bytes: [0u8; 512], len: 0, has: false };
        let hasThread = recStrAlt(params_ptr, params_len, STR_PTR("threadId"), STR_LEN("threadId"), STR_PTR("thread_id"), STR_LEN("thread_id"), &threadId);
        if !hasThread && out.activeThreadId.has { threadId = out.activeThreadId; hasThread = true; };
        if !hasThread { threadId = turnId; };
        let stub = blankWorkbenchTurn();
        turnSetId(&stub, sstrPtrC(&turnId), turnId.len);
        turnSetThreadId(&stub, sstrPtrC(&threadId), threadId.len);
        turnSetStatus(&stub, true, STR_PTR("inProgress"), STR_LEN("inProgress"));
        stub.has_startedAt = true;
        stub.startedAt = now_s;
        stateUpsertTurn(out, &stub);
        if !stateFindTurn(out, sstrPtrC(&turnId), turnId.len, &ti) { return; };
    };
    reactivateTurnInPlace(&out.turns_items[ti], true);
    let ii: u64 = 0;
    let hasItem = turnFindItem(&out.turns_items[ti], sstrPtrC(&itemId), itemId.len, &ii);
    let item = blankWorkbenchItem();
    if hasItem { item = out.turns_items[ti].items_items[ii]; } else {
        itemSetId(&item, sstrPtrC(&itemId), itemId.len);
        itemSetType(&item, STR_PTR("agentMessage"), STR_LEN("agentMessage"));
        itemSetTitle(&item, STR_PTR("Codex"), STR_LEN("Codex"));
        itemSetText(&item, STR_PTR(""), 0);
    };
    agentItemMetadataFromParams(params_ptr, params_len, &item);
    if !item.has_startedAt {
        let v: f64 = 0.0;
        if recNumAlt(params_ptr, params_len, STR_PTR("startedAt"), STR_LEN("startedAt"), STR_PTR("started_at"), STR_LEN("started_at"), &v) { item.has_startedAt = true; item.startedAt = v; };
    };
    if !item.has_firstTokenAt {
        let v: f64 = 0.0;
        if recNumAlt(params_ptr, params_len, STR_PTR("firstTokenAt"), STR_LEN("firstTokenAt"), STR_PTR("first_token_at"), STR_LEN("first_token_at"), &v) { item.has_firstTokenAt = true; item.firstTokenAt = v; } else { item.has_firstTokenAt = true; item.firstTokenAt = now_s; };
    };
    let upd: f64 = 0.0;
    if recNumAlt(params_ptr, params_len, STR_PTR("updatedAt"), STR_LEN("updatedAt"), STR_PTR("updated_at"), STR_LEN("updated_at"), &upd) { item.has_updatedAt = true; item.updatedAt = upd; } else { item.has_updatedAt = true; item.updatedAt = now_s; };
    itemAppendText(&item, bigPtrC(&delta), delta.len);
    turnUpsertItem(&out.turns_items[ti], &item);
}

// TS branch: "item/reasoning/summaryPartAdded" | "summaryTextDelta" | "textDelta"
fn applyNotifReasoningDelta(state: &ClientState, params_ptr: ptr, params_len: u64, now_ms: f64, out: &ClientState) -> void {
    *out = *state;
    let now_s = now_ms / 1000.0;
    let itemId = SStr { bytes: [0u8; 512], len: 0, has: false };
    let turnId = SStr { bytes: [0u8; 512], len: 0, has: false };
    if !recStrAlt(params_ptr, params_len, STR_PTR("itemId"), STR_LEN("itemId"), STR_PTR("item_id"), STR_LEN("item_id"), &itemId) { return; };
    if !recStrAlt(params_ptr, params_len, STR_PTR("turnId"), STR_LEN("turnId"), STR_PTR("turn_id"), STR_LEN("turn_id"), &turnId) { return; };
    let delta = SStr { bytes: [0u8; 512], len: 0, has: false };
    recStr(params_ptr, params_len, STR_PTR("delta"), STR_LEN("delta"), &delta);
    let ti: u64 = 0;
    let ii: u64 = 0;
    let hasItem = false;
    if !findTurnAndItem(out, &turnId, &itemId, &ti, &ii, &hasItem) {
        // TS updateTurnItem stub-turn creation (see applyNotifItemPatch)
        let stub = blankWorkbenchTurn();
        turnSetId(&stub, sstrPtrC(&turnId), turnId.len);
        if out.activeThreadId.has { turnSetThreadId(&stub, sstrPtrC(&out.activeThreadId), out.activeThreadId.len); } else { turnSetThreadId(&stub, sstrPtrC(&turnId), turnId.len); };
        turnSetStatus(&stub, true, STR_PTR("inProgress"), STR_LEN("inProgress"));
        stub.has_startedAt = true;
        stub.startedAt = @ts_math_rounding(now_s, 0);
        stateUpsertTurn(out, &stub);
        if !findTurnAndItem(out, &turnId, &itemId, &ti, &ii, &hasItem) { return; };
    } else {
        reactivateTurnInPlace(&out.turns_items[ti], true);
    };
    let item = blankWorkbenchItem();
    if hasItem { item = out.turns_items[ti].items_items[ii]; } else {
        itemSetId(&item, sstrPtrC(&itemId), itemId.len);
        itemSetTitle(&item, STR_PTR("Reasoning"), STR_LEN("Reasoning"));
        itemSetText(&item, STR_PTR(""), 0);
        itemSetStatus(&item, true, STR_PTR("inProgress"), STR_LEN("inProgress"));
    };
    itemSetType(&item, STR_PTR("reasoning"), STR_LEN("reasoning"));
    if item.title_len == 0 { itemSetTitle(&item, STR_PTR("Reasoning"), STR_LEN("Reasoning")); };
    itemAppendText(&item, sstrPtrC(&delta), delta.len);
    if !item.has_status { itemSetStatus(&item, true, STR_PTR("inProgress"), STR_LEN("inProgress")); };
    if !item.has_firstTokenAt { item.has_firstTokenAt = true; item.firstTokenAt = now_s; };
    turnUpsertItem(&out.turns_items[ti], &item);
}

// TS branch: method === "item/plan/delta"
fn applyNotifPlanDelta(state: &ClientState, params_ptr: ptr, params_len: u64, now_ms: f64, out: &ClientState) -> void {
    *out = *state;
    let now_s = now_ms / 1000.0;
    let itemId = SStr { bytes: [0u8; 512], len: 0, has: false };
    let turnId = SStr { bytes: [0u8; 512], len: 0, has: false };
    if !recStrAlt(params_ptr, params_len, STR_PTR("itemId"), STR_LEN("itemId"), STR_PTR("item_id"), STR_LEN("item_id"), &itemId) { return; };
    if !recStrAlt(params_ptr, params_len, STR_PTR("turnId"), STR_LEN("turnId"), STR_PTR("turn_id"), STR_LEN("turn_id"), &turnId) { return; };
    let delta = SStr { bytes: [0u8; 512], len: 0, has: false };
    recStr(params_ptr, params_len, STR_PTR("delta"), STR_LEN("delta"), &delta);
    let ti: u64 = 0;
    if !stateFindTurn(out, sstrPtrC(&turnId), turnId.len, &ti) {
        let threadId = SStr { bytes: [0u8; 512], len: 0, has: false };
        let hasThread = recStrAlt(params_ptr, params_len, STR_PTR("threadId"), STR_LEN("threadId"), STR_PTR("thread_id"), STR_LEN("thread_id"), &threadId);
        if !hasThread && out.activeThreadId.has { threadId = out.activeThreadId; hasThread = true; };
        if !hasThread { threadId = turnId; };
        let stub = blankWorkbenchTurn();
        turnSetId(&stub, sstrPtrC(&turnId), turnId.len);
        turnSetThreadId(&stub, sstrPtrC(&threadId), threadId.len);
        turnSetStatus(&stub, true, STR_PTR("inProgress"), STR_LEN("inProgress"));
        stub.has_startedAt = true;
        stub.startedAt = now_s;
        stateUpsertTurn(out, &stub);
        if !stateFindTurn(out, sstrPtrC(&turnId), turnId.len, &ti) { return; };
    };
    // consolidated snapshot id: `turn-plan-${turnId}`
    let consolidated = BigStrC { bytes: [0u8; 8192], len: 0 };
    bigStrAppend(&consolidated, STR_PTR("turn-plan-"), STR_LEN("turn-plan-"));
    bigStrAppend(&consolidated, sstrPtrC(&turnId), turnId.len);
    let itemIsConsolidated = itemId.len == consolidated.len;
    if itemIsConsolidated { for j in 0..itemId.len { if itemId.bytes[j] != consolidated.bytes[j] { itemIsConsolidated = false; }; }; };
    let turn = &out.turns_items[ti];
    if !itemIsConsolidated {
        let w: u64 = 0;
        for ii in 0..turn.items_len {
            let cand = &turn.items_items[ii];
            let isCons = cand.id_len == consolidated.len;
            if isCons { for j in 0..consolidated.len { let b: u8 = 0; PTR_BYTE_AT(b, bigPtrC(&consolidated), j); if cand.id_bytes[j] != b { isCons = false; }; }; };
            if !isCons { turn.items_items[w] = turn.items_items[ii]; w = w + 1; };
        }
        turn.items_len = w;
    };
    reactivateTurnInPlace(turn, true);
    let ii: u64 = 0;
    let hasItem = turnFindItem(turn, sstrPtrC(&itemId), itemId.len, &ii);
    let item = blankWorkbenchItem();
    if hasItem { item = turn.items_items[ii]; } else {
        itemSetId(&item, sstrPtrC(&itemId), itemId.len);
        itemSetTitle(&item, STR_PTR("Plan"), STR_LEN("Plan"));
        itemSetText(&item, STR_PTR(""), 0);
        itemSetStatus(&item, true, STR_PTR("inProgress"), STR_LEN("inProgress"));
    };
    itemSetType(&item, STR_PTR("plan"), STR_LEN("plan"));
    if item.title_len == 0 { itemSetTitle(&item, STR_PTR("Plan"), STR_LEN("Plan")); };
    if !item.has_status { itemSetStatus(&item, true, STR_PTR("inProgress"), STR_LEN("inProgress")); };
    if !item.has_firstTokenAt { item.has_firstTokenAt = true; item.firstTokenAt = now_s; };
    itemAppendText(&item, sstrPtrC(&delta), delta.len);
    turnUpsertItem(turn, &item);
}

// TS branch: method === "turn/plan/updated"
fn applyNotifTurnPlanUpdated(state: &ClientState, params_ptr: ptr, params_len: u64, jev: &JevDispatchList, now_ms: f64, out: &ClientState) -> void {
    *out = *state;
    let now_s = now_ms / 1000.0;
    let turnId = SStr { bytes: [0u8; 512], len: 0, has: false };
    if !recStrAlt(params_ptr, params_len, STR_PTR("turnId"), STR_LEN("turnId"), STR_PTR("turn_id"), STR_LEN("turn_id"), &turnId) { return; };
    let threadId = SStr { bytes: [0u8; 512], len: 0, has: false };
    let hasThread = recStrAlt(params_ptr, params_len, STR_PTR("threadId"), STR_LEN("threadId"), STR_PTR("thread_id"), STR_LEN("thread_id"), &threadId);
    let ti: u64 = 0;
    let hasTurn = stateFindTurn(out, sstrPtrC(&turnId), turnId.len, &ti);
    if !hasThread && hasTurn {
        let t = &out.turns_items[ti];
        threadId.has = true;
        threadId.len = t.threadId_len;
        for j in 0..t.threadId_len { threadId.bytes[j] = t.threadId_bytes[j]; }
        hasThread = true;
    };
    if !hasThread && out.activeThreadId.has { threadId = out.activeThreadId; hasThread = true; };
    if !hasThread { return; };
    let planText = BigStrC { bytes: [0u8; 8192], len: 0 };
    formatPlanUpdateText(params_ptr, params_len, &planText);
    let planStatus = SStr { bytes: [0u8; 512], len: 0, has: false };
    planUpdateStatus(params_ptr, params_len, &planStatus);
    let planItemId = BigStrC { bytes: [0u8; 8192], len: 0 };
    bigStrAppend(&planItemId, STR_PTR("turn-plan-"), STR_LEN("turn-plan-"));
    bigStrAppend(&planItemId, sstrPtrC(&turnId), turnId.len);
    let planItem = blankWorkbenchItem();
    itemSetId(&planItem, bigPtrC(&planItemId), planItemId.len);
    itemSetType(&planItem, STR_PTR("plan"), STR_LEN("plan"));
    itemSetTitle(&planItem, STR_PTR("Updated Plan"), STR_LEN("Updated Plan"));
    itemSetText(&planItem, bigPtrC(&planText), planText.len);
    itemSetStatus(&planItem, true, sstrPtrC(&planStatus), planStatus.len);
    {
        let rp: ptr = PTR_NULL();
        let rl: u64 = 0;
        // payload: params as JsonValue (stored raw; truncated to 4096)
        planItem.has_payload = true;
        let n = params_len;
        if n > 4096 { n = 4096; };
        for j in 0..n { let b: u8 = 0; PTR_BYTE_AT(b, params_ptr, j); planItem.payload_bytes[j] = b; }
        planItem.payload_len = n;
    };
    if hasTurn {
        let turn = &out.turns_items[ti];
        let existingFirst: f64 = 0.0;
        let hasExistingFirst = false;
        let w: u64 = 0;
        for ii in 0..turn.items_len {
            let cand = &turn.items_items[ii];
            let isPlanItem = cand.id_len == planItemId.len;
            if isPlanItem { for j in 0..planItemId.len { let b: u8 = 0; PTR_BYTE_AT(b, bigPtrC(&planItemId), j); if cand.id_bytes[j] != b { isPlanItem = false; }; }; };
            let isPlanType = cand.type_len == 4;
            if isPlanType { for j in 0..4 { let b: u8 = 0; PTR_BYTE_AT(b, STR_PTR("plan"), j); if cand.type_bytes[j] != b { isPlanType = false; }; }; };
            if isPlanItem { if cand.has_firstTokenAt { hasExistingFirst = true; existingFirst = cand.firstTokenAt; }; };
            if isPlanItem || !isPlanType { turn.items_items[w] = turn.items_items[ii]; w = w + 1; };
        }
        turn.items_len = w;
        planItem.has_firstTokenAt = true;
        if hasExistingFirst { planItem.firstTokenAt = existingFirst; } else { planItem.firstTokenAt = now_s; };
        reactivateTurnInPlace(turn, true);
        turnUpsertItem(turn, &planItem);
    } else {
        planItem.has_firstTokenAt = true;
        planItem.firstTokenAt = now_s;
        let stub = blankWorkbenchTurn();
        turnSetId(&stub, sstrPtrC(&turnId), turnId.len);
        turnSetThreadId(&stub, sstrPtrC(&threadId), threadId.len);
        turnSetStatus(&stub, true, STR_PTR("inProgress"), STR_LEN("inProgress"));
        stub.has_startedAt = true;
        stub.startedAt = now_s;
        if stub.items_len < 128 { stub.items_items[stub.items_len] = planItem; stub.items_len = stub.items_len + 1; };
        stateUpsertTurn(out, &stub);
    };
    // JEV plan audit (never breaks rendering)
    {
        let tp: ptr = PTR_NULL();
        let tl: u64 = 0;
        @ts_str_trim(bigPtrC(&planText), planText.len, &tp, &tl);
        if tl > 0 {
            let ownerIdx: u64 = 0;
            let hasOwner = stateFindTurn(out, sstrPtrC(&turnId), turnId.len, &ownerIdx);
            let userPrompt = BigStrC { bytes: [0u8; 8192], len: 0 };
            if hasOwner {
                let owner = &out.turns_items[ownerIdx];
                for ii in 0..owner.items_len {
                    let cand = &owner.items_items[ii];
                    let isUser = cand.type_len == 11;
                    if isUser { for j in 0..11 { let b: u8 = 0; PTR_BYTE_AT(b, STR_PTR("userMessage"), j); if cand.type_bytes[j] != b { isUser = false; }; }; };
                    if isUser && cand.text_len > 0 {
                        if userPrompt.len > 0 { bigStrAppend(&userPrompt, STR_PTR("\n---\n"), STR_LEN("\n---\n")); };
                        let cp: ptr = PTR_NULL();
                        PTR_BYTE_ADD(cp, &cand.text_bytes, 0);
                        bigStrAppend(&userPrompt, cp, cand.text_len);
                    };
                }
            };
            if userPrompt.len > 2000 { userPrompt.len = 2000; };
            let jevThreadId = SStr { bytes: [0u8; 512], len: 0, has: false };
            let hasJevThread = recStrAlt(params_ptr, params_len, STR_PTR("threadId"), STR_LEN("threadId"), STR_PTR("thread_id"), STR_LEN("thread_id"), &jevThreadId);
            if !hasJevThread && hasOwner {
                let t = &out.turns_items[ownerIdx];
                jevThreadId.has = true;
                jevThreadId.len = t.threadId_len;
                for j in 0..t.threadId_len { jevThreadId.bytes[j] = t.threadId_bytes[j]; }
                hasJevThread = true;
            };
            if !hasJevThread { jevThreadId = turnId; };
            let pl = planText.len;
            if pl > 6000 { pl = 6000; };
            dispatchJevPlanCreated(jev, &jevThreadId, &turnId, bigPtrC(&planText), pl, bigPtrC(&userPrompt), userPrompt.len, &out.token);
        };
    };
    out.activeThreadId = threadId;
}

// TS branch: "turn/completed" | "turn/failed" | "turn/interrupted"
// (fallbackStatus: 0=completed 1=failed 2=interrupted literal in statusOut)
fn applyNotifTurnTerminal(state: &ClientState, params_ptr: ptr, params_len: u64, fallback_ptr: ptr, fallback_len: u64, prov: &ServerStartedTurnIds, now_ms: f64, out: &ClientState) -> void {
    *out = *state;
    let turnVal = JsonBufC { bytes: [0u8; 16384], len: 0 };
    let hasTurnVal = recVal(params_ptr, params_len, STR_PTR("turn"), STR_LEN("turn"), &turnVal);
    let turn = JsonBufC { bytes: [0u8; 16384], len: 0 };
    if hasTurnVal { asRecordC(jsonPtrC(&turnVal), turnVal.len, &turn); } else { jsonBufSetC(&turn, STR_PTR("{}"), STR_LEN("{}")); };
    let tp: ptr = jsonPtrC(&turn);
    let id = SStr { bytes: [0u8; 512], len: 0, has: false };
    let hasId = recStr(tp, turn.len, STR_PTR("id"), STR_LEN("id"), &id);
    if !hasId { hasId = recStrAlt(params_ptr, params_len, STR_PTR("turnId"), STR_LEN("turnId"), STR_PTR("turn_id"), STR_LEN("turn_id"), &id); };
    if !hasId { return; };
    let payloadStatus = SStr { bytes: [0u8; 512], len: 0, has: false };
    let hasPayloadStatus = recStr(tp, turn.len, STR_PTR("status"), STR_LEN("status"), &payloadStatus);
    let terminalStatus = SStr { bytes: [0u8; 512], len: 0, has: false };
    if hasPayloadStatus && isTerminalWorkbenchStatus(sstrPtrC(&payloadStatus), payloadStatus.len) { terminalStatus = payloadStatus; } else { sstrSet(&terminalStatus, fallback_ptr, fallback_len); };
    let completedThreadId = SStr { bytes: [0u8; 512], len: 0, has: false };
    let hasCT = recStrAlt(params_ptr, params_len, STR_PTR("threadId"), STR_LEN("threadId"), STR_PTR("thread_id"), STR_LEN("thread_id"), &completedThreadId);
    if !hasCT { hasCT = recStrAlt(tp, turn.len, STR_PTR("threadId"), STR_LEN("threadId"), STR_PTR("thread_id"), STR_LEN("thread_id"), &completedThreadId); };
    let ti: u64 = 0;
    let hasTurn = stateFindTurn(out, sstrPtrC(&id), id.len, &ti);
    if !hasCT && hasTurn {
        let t = &out.turns_items[ti];
        completedThreadId.has = true;
        completedThreadId.len = t.threadId_len;
        for j in 0..t.threadId_len { completedThreadId.bytes[j] = t.threadId_bytes[j]; }
        hasCT = true;
    };
    let completedAt: f64 = 0.0;
    let hasCompletedAt = recNumAlt(tp, turn.len, STR_PTR("completedAt"), STR_LEN("completedAt"), STR_PTR("completed_at"), STR_LEN("completed_at"), &completedAt);
    if !hasTurn {
        let stub = blankWorkbenchTurn();
        turnSetId(&stub, sstrPtrC(&id), id.len);
        if hasCT { turnSetThreadId(&stub, sstrPtrC(&completedThreadId), completedThreadId.len); } else if out.activeThreadId.has { turnSetThreadId(&stub, sstrPtrC(&out.activeThreadId), out.activeThreadId.len); } else { turnSetThreadId(&stub, sstrPtrC(&id), id.len); };
        turnSetStatus(&stub, true, fallback_ptr, fallback_len);
        stub.has_completedAt = true;
        if hasCompletedAt { stub.completedAt = completedAt; } else { stub.completedAt = @ts_math_rounding(now_ms / 1000.0, 0); };
        stateUpsertTurn(out, &stub);
        return;
    };
    let existing = out.turns_items[ti];
    // staleness guard (server-clock turns only)
    if hasCompletedAt && existing.has_startedAt && serverStartedContains(prov, sstrPtrC(&id), id.len) && completedAt < existing.startedAt {
        let term = false;
        if existing.has_status {
            let st = SStr { bytes: [0u8; 512], len: 0, has: true };
            st.len = existing.status_len;
            for j in 0..existing.status_len { st.bytes[j] = existing.status_bytes[j]; }
            term = isTerminalWorkbenchStatus(sstrPtrC(&st), st.len);
        };
        if !term { return; };
    };
    serverStartedRemove(prov, sstrPtrC(&id), id.len);
    if !hasCompletedAt {
        let term = false;
        if existing.has_status {
            let st = SStr { bytes: [0u8; 512], len: 0, has: true };
            st.len = existing.status_len;
            for j in 0..existing.status_len { st.bytes[j] = existing.status_bytes[j]; }
            term = isTerminalWorkbenchStatus(sstrPtrC(&st), st.len);
        };
        if !term {
            let anyRunning = false;
            for ii in 0..existing.items_len {
                let cand = &existing.items_items[ii];
                if cand.has_status {
                    let st = SStr { bytes: [0u8; 512], len: 0, has: true };
                    st.len = cand.status_len;
                    for j in 0..cand.status_len { st.bytes[j] = cand.status_bytes[j]; }
                    let isComp = cand.type_len == 17;
                    if isComp { for j in 0..17 { let b: u8 = 0; PTR_BYTE_AT(b, STR_PTR("contextCompaction"), j); if cand.type_bytes[j] != b { isComp = false; }; }; };
                    if isRunningWorkbenchStatus(sstrPtrC(&st), st.len) && !isComp { anyRunning = true; };
                };
            }
            if anyRunning { return; };
        };
    };
    for k in 0..out.turns_len {
        let entry = &out.turns_items[k];
        let isTarget = turnIdEq(entry, sstrPtrC(&id), id.len);
        let sameThread = hasCT && entry.threadId_len == completedThreadId.len;
        if sameThread { for j in 0..completedThreadId.len { if entry.threadId_bytes[j] != completedThreadId.bytes[j] { sameThread = false; }; }; };
        if isTarget {
            turnSetStatus(entry, true, sstrPtrC(&terminalStatus), terminalStatus.len);
            entry.has_completedAt = true;
            if hasCompletedAt { entry.completedAt = completedAt; } else { entry.completedAt = @ts_math_rounding(now_ms / 1000.0, 0); };
            completeActiveCompactionsInPlace(entry, fallback_ptr, fallback_len);
        } else if sameThread {
            completeActiveCompactionsInPlace(entry, fallback_ptr, fallback_len);
        };
    }
}

// DEFECT: the TS retry regex
// /(selected model is at capacity|rate-?limiting requests|stream connection
// failed|responses_retry|error sending request|didn't complete gracefully|
// waiting to retry)/i is approximated with case-insensitive substring
// checks (containsCi); "rate-?limiting" needs both spellings listed.
fn retryErrorTextMatches(text_ptr: ptr, text_len: u64) -> bool {
    if containsCi(text_ptr, text_len, STR_PTR("selected model is at capacity"), STR_LEN("selected model is at capacity")) { return true; };
    if containsCi(text_ptr, text_len, STR_PTR("rate-limiting requests"), STR_LEN("rate-limiting requests")) { return true; };
    if containsCi(text_ptr, text_len, STR_PTR("rate limiting requests"), STR_LEN("rate limiting requests")) { return true; };
    if containsCi(text_ptr, text_len, STR_PTR("stream connection failed"), STR_LEN("stream connection failed")) { return true; };
    if containsCi(text_ptr, text_len, STR_PTR("responses_retry"), STR_LEN("responses_retry")) { return true; };
    if containsCi(text_ptr, text_len, STR_PTR("error sending request"), STR_LEN("error sending request")) { return true; };
    if containsCi(text_ptr, text_len, STR_PTR("didn't complete gracefully"), STR_LEN("didn't complete gracefully")) { return true; };
    if containsCi(text_ptr, text_len, STR_PTR("waiting to retry"), STR_LEN("waiting to retry")) { return true; };
    return false;
}

fn isCodexRetryItem(item: &WorkbenchItem, stableId_ptr: ptr, stableId_len: u64) -> bool {
    if itemIdEq(item, stableId_ptr, stableId_len) { return true; };
    if !item.has_payload { return false; };
    let pp: ptr = PTR_NULL();
    PTR_BYTE_ADD(pp, &item.payload_bytes, 0);
    let flag = false;
    if !recBool(pp, item.payload_len, STR_PTR("retryError"), STR_LEN("retryError"), &flag) || !flag { return false; };
    let source = SStr { bytes: [0u8; 512], len: 0, has: false };
    if recStr(pp, item.payload_len, STR_PTR("retrySource"), STR_LEN("retrySource"), &source) && sstrEqLitC(&source, STR_PTR("app"), STR_LEN("app")) { return false; };
    return true;
}

// TS branch: method === "error"
fn applyNotifError(state: &ClientState, params_ptr: ptr, params_len: u64, now_ms: f64, out: &ClientState) -> void {
    *out = *state;
    let now_s = now_ms / 1000.0;
    let errVal = JsonBufC { bytes: [0u8; 16384], len: 0 };
    let hasErrVal = recVal(params_ptr, params_len, STR_PTR("error"), STR_LEN("error"), &errVal);
    let errRec = JsonBufC { bytes: [0u8; 16384], len: 0 };
    if hasErrVal { asRecordC(jsonPtrC(&errVal), errVal.len, &errRec); } else { jsonBufSetC(&errRec, STR_PTR("{}"), STR_LEN("{}")); };
    let ep: ptr = jsonPtrC(&errRec);
    let message = SStr { bytes: [0u8; 512], len: 0, has: false };
    let hasMessage = recStr(ep, errRec.len, STR_PTR("message"), STR_LEN("message"), &message);
    if !hasMessage { hasMessage = recStr(params_ptr, params_len, STR_PTR("message"), STR_LEN("message"), &message); };
    if !hasMessage && hasErrVal { hasMessage = jsonValueStr(jsonPtrC(&errVal), errVal.len, &message); };
    let willRetry = false;
    recBool(params_ptr, params_len, STR_PTR("willRetry"), STR_LEN("willRetry"), &willRetry);
    let retryError = willRetry || (hasMessage && retryErrorTextMatches(sstrPtrC(&message), message.len));
    if !retryError {
        // errors: [message ?? "Codex error", ...state.errors].slice(0, 8)
        let idx = out.errors_len;
        if idx > 7 { idx = 7; };
        while idx > 0 {
            out.errors[idx] = out.errors[idx - 1];
            idx = idx - 1;
        }
        if hasMessage { out.errors[0] = message; } else { sstrSetLit(&out.errors[0], STR_PTR("Codex error"), STR_LEN("Codex error")); };
        if out.errors_len < 8 { out.errors_len = out.errors_len + 1; };
        return;
    };
    let turnId = SStr { bytes: [0u8; 512], len: 0, has: false };
    if !recStrAlt(params_ptr, params_len, STR_PTR("turnId"), STR_LEN("turnId"), STR_PTR("turn_id"), STR_LEN("turn_id"), &turnId) { return; };
    let ti: u64 = 0;
    let hasTurn = stateFindTurn(out, sstrPtrC(&turnId), turnId.len, &ti);
    let threadId = SStr { bytes: [0u8; 512], len: 0, has: false };
    let hasThread = recStrAlt(params_ptr, params_len, STR_PTR("threadId"), STR_LEN("threadId"), STR_PTR("thread_id"), STR_LEN("thread_id"), &threadId);
    if !hasThread && hasTurn {
        let t = &out.turns_items[ti];
        threadId.has = true;
        threadId.len = t.threadId_len;
        for j in 0..t.threadId_len { threadId.bytes[j] = t.threadId_bytes[j]; }
        hasThread = true;
    };
    if !hasThread && out.activeThreadId.has { threadId = out.activeThreadId; hasThread = true; };
    if !hasThread { return; };
    let stableId = BigStrC { bytes: [0u8; 8192], len: 0 };
    bigStrAppend(&stableId, STR_PTR("retry-error-"), STR_LEN("retry-error-"));
    bigStrAppend(&stableId, sstrPtrC(&turnId), turnId.len);
    // find the existing codex retry item (payload base for the merge)
    let existingItem = blankWorkbenchItem();
    let hasExistingItem = false;
    if hasTurn {
        let t = &out.turns_items[ti];
        for ii in 0..t.items_len {
            if isCodexRetryItem(&t.items_items[ii], bigPtrC(&stableId), stableId.len) { existingItem = t.items_items[ii]; hasExistingItem = true; break; };
        }
    };
    let retryItem = blankWorkbenchItem();
    itemSetId(&retryItem, bigPtrC(&stableId), stableId.len);
    itemSetType(&retryItem, STR_PTR("retryError"), STR_LEN("retryError"));
    if willRetry { itemSetTitle(&retryItem, STR_PTR("Retrying request"), STR_LEN("Retrying request")); } else { itemSetTitle(&retryItem, STR_PTR("Retry stopped"), STR_LEN("Retry stopped")); };
    if hasMessage { itemSetText(&retryItem, sstrPtrC(&message), message.len); } else { itemSetText(&retryItem, STR_PTR("Codex retry error"), STR_LEN("Codex retry error")); };
    if willRetry { itemSetStatus(&retryItem, true, STR_PTR("running"), STR_LEN("running")); } else { itemSetStatus(&retryItem, true, STR_PTR("failed"), STR_LEN("failed")); };
    if hasExistingItem && existingItem.has_startedAt { retryItem.has_startedAt = true; retryItem.startedAt = existingItem.startedAt; } else { retryItem.has_startedAt = true; retryItem.startedAt = now_s; };
    retryItem.has_updatedAt = true;
    retryItem.updatedAt = now_s;
    // payload assembly: {...existingPayload, retryError: true, retrySource,
    // willRetry, additionalDetails?, status?, attempt?, stalled?,
    // elapsedMs?, actionHint?, exhausted?} — conditional spreads copy the
    // raw JSON value text of the source field.
    {
        let payload = JsonBufC { bytes: [0u8; 16384], len: 0 };
        if hasExistingItem && existingItem.has_payload {
            let pp: ptr = PTR_NULL();
            PTR_BYTE_ADD(pp, &existingItem.payload_bytes, 0);
            jsonBufSetC(&payload, pp, existingItem.payload_len);
        } else { jsonBufSetC(&payload, STR_PTR("{}"), STR_LEN("{}")); };
        let cur = JsonBufC { bytes: [0u8; 16384], len: 0 };
        let rp: ptr = PTR_NULL();
        let rl: u64 = 0;
        jsonBufCopyC(&cur, &payload);
        if sa_json_object_set_value_text(jsonPtrC(&cur), cur.len, STR_PTR("retryError"), STR_LEN("retryError"), STR_PTR("true"), STR_LEN("true"), &rp, &rl) == 0 { jsonBufSetC(&payload, rp, rl); };
        let retrySource = SStr { bytes: [0u8; 512], len: 0, has: false };
        if !recStr(params_ptr, params_len, STR_PTR("retrySource"), STR_LEN("retrySource"), &retrySource) { if willRetry { sstrSetLit(&retrySource, STR_PTR("codex"), STR_LEN("codex")); } else { sstrSetLit(&retrySource, STR_PTR("terminal"), STR_LEN("terminal")); }; };
        let srcJson = BigStrC { bytes: [0u8; 8192], len: 0 };
        bigStrAppend(&srcJson, STR_PTR("\""), STR_LEN("\""));
        bigStrAppend(&srcJson, sstrPtrC(&retrySource), retrySource.len);
        bigStrAppend(&srcJson, STR_PTR("\""), STR_LEN("\""));
        jsonBufCopyC(&cur, &payload);
        if sa_json_object_set_value_text(jsonPtrC(&cur), cur.len, STR_PTR("retrySource"), STR_LEN("retrySource"), bigPtrC(&srcJson), srcJson.len, &rp, &rl) == 0 { jsonBufSetC(&payload, rp, rl); };
        jsonBufCopyC(&cur, &payload);
        if willRetry {
            if sa_json_object_set_value_text(jsonPtrC(&cur), cur.len, STR_PTR("willRetry"), STR_LEN("willRetry"), STR_PTR("true"), STR_LEN("true"), &rp, &rl) == 0 { jsonBufSetC(&payload, rp, rl); };
        } else {
            if sa_json_object_set_value_text(jsonPtrC(&cur), cur.len, STR_PTR("willRetry"), STR_LEN("willRetry"), STR_PTR("false"), STR_LEN("false"), &rp, &rl) == 0 { jsonBufSetC(&payload, rp, rl); };
        };
        let details = SStr { bytes: [0u8; 512], len: 0, has: false };
        let hasDetails = recStrAlt(ep, errRec.len, STR_PTR("additionalDetails"), STR_LEN("additionalDetails"), STR_PTR("additional_details"), STR_LEN("additional_details"), &details);
        if hasDetails {
            let dJson = BigStrC { bytes: [0u8; 8192], len: 0 };
            bigStrAppend(&dJson, STR_PTR("\""), STR_LEN("\""));
            bigStrAppend(&dJson, sstrPtrC(&details), details.len);
            bigStrAppend(&dJson, STR_PTR("\""), STR_LEN("\""));
            jsonBufCopyC(&cur, &payload);
            if sa_json_object_set_value_text(jsonPtrC(&cur), cur.len, STR_PTR("additionalDetails"), STR_LEN("additionalDetails"), bigPtrC(&dJson), dJson.len, &rp, &rl) == 0 { jsonBufSetC(&payload, rp, rl); };
        };
        let statusVal = JsonBufC { bytes: [0u8; 16384], len: 0 };
        let hasStatusVal = recVal(ep, errRec.len, STR_PTR("status"), STR_LEN("status"), &statusVal);
        if !hasStatusVal { hasStatusVal = recVal(params_ptr, params_len, STR_PTR("status"), STR_LEN("status"), &statusVal); };
        if hasStatusVal {
            // TS checks numberValue(...) != null; the raw copy keeps the
            // number text (non-number values are a DEFECT-level divergence)
            jsonBufCopyC(&cur, &payload);
            if sa_json_object_set_value_text(jsonPtrC(&cur), cur.len, STR_PTR("status"), STR_LEN("status"), jsonPtrC(&statusVal), statusVal.len, &rp, &rl) == 0 { jsonBufSetC(&payload, rp, rl); };
        };
        // attempt / stalled / elapsedMs / actionHint / exhausted: typeof
        // checks in TS; copied raw when the key is present (DEFECT: the
        // typeof guard is approximated by presence)
        let extraKeys: u64 = 5;
        for kx in 0..extraKeys {
            let keyPtr: ptr = PTR_NULL();
            let keyLen: u64 = 0;
            if kx == 0 { keyPtr = STR_PTR("attempt"); keyLen = STR_LEN("attempt"); };
            if kx == 1 { keyPtr = STR_PTR("stalled"); keyLen = STR_LEN("stalled"); };
            if kx == 2 { keyPtr = STR_PTR("elapsedMs"); keyLen = STR_LEN("elapsedMs"); };
            if kx == 3 { keyPtr = STR_PTR("actionHint"); keyLen = STR_LEN("actionHint"); };
            if kx == 4 { keyPtr = STR_PTR("exhausted"); keyLen = STR_LEN("exhausted"); };
            let vv = JsonBufC { bytes: [0u8; 16384], len: 0 };
            if recVal(params_ptr, params_len, keyPtr, keyLen, &vv) {
                jsonBufCopyC(&cur, &payload);
                if sa_json_object_set_value_text(jsonPtrC(&cur), cur.len, keyPtr, keyLen, jsonPtrC(&vv), vv.len, &rp, &rl) == 0 { jsonBufSetC(&payload, rp, rl); };
            };
        }
        retryItem.has_payload = true;
        let n = payload.len;
        if n > 4096 { n = 4096; };
        for j in 0..n { retryItem.payload_bytes[j] = payload.bytes[j]; }
        retryItem.payload_len = n;
    };
    if hasTurn {
        let turn = &out.turns_items[ti];
        reactivateTurnInPlace(turn, willRetry);
        // consolidateItems: first codex retry item is replaced, others drop
        let w: u64 = 0;
        let placed = false;
        for ii in 0..turn.items_len {
            if isCodexRetryItem(&turn.items_items[ii], bigPtrC(&stableId), stableId.len) {
                if !placed { turn.items_items[w] = retryItem; w = w + 1; placed = true; };
            } else { turn.items_items[w] = turn.items_items[ii]; w = w + 1; };
        }
        if !placed && w < 128 { turn.items_items[w] = retryItem; w = w + 1; };
        turn.items_len = w;
    } else {
        let stub = blankWorkbenchTurn();
        turnSetId(&stub, sstrPtrC(&turnId), turnId.len);
        turnSetThreadId(&stub, sstrPtrC(&threadId), threadId.len);
        if willRetry { turnSetStatus(&stub, true, STR_PTR("inProgress"), STR_LEN("inProgress")); } else { turnSetStatus(&stub, true, STR_PTR("failed"), STR_LEN("failed")); };
        stub.has_startedAt = true;
        stub.startedAt = now_s;
        if stub.items_len < 128 { stub.items_items[stub.items_len] = retryItem; stub.items_len = stub.items_len + 1; };
        stateUpsertTurn(out, &stub);
    };
}

// TS (line 3196): export function applyNotification(state, notification)
fn applyNotification(state: &ClientState, notification: &JsonRpcNotification, prov: &ServerStartedTurnIds, jev: &JevDispatchList, now_ms: f64, out: &ClientState) -> void {
    *out = *state;
    let pp: ptr = PTR_NULL();
    let pl: u64 = 0;
    if notification.has_params { pp = jsonPtrC(&notification.params_json); pl = notification.params_json.len; } else { pp = STR_PTR("{}"); pl = 2; };
    let m = &notification.method;
    if sstrEqLitC(m, STR_PTR("thread/started"), STR_LEN("thread/started")) { applyNotifThreadStarted(state, pp, pl, out); return; };
    if sstrEqLitC(m, STR_PTR("thread/name/updated"), STR_LEN("thread/name/updated")) { applyNotifThreadNameUpdated(state, pp, pl, out); return; };
    if sstrEqLitC(m, STR_PTR("thread/archived"), STR_LEN("thread/archived")) { applyNotifThreadArchivedOrDeleted(state, pp, pl, false, out); return; };
    if sstrEqLitC(m, STR_PTR("thread/deleted"), STR_LEN("thread/deleted")) { applyNotifThreadArchivedOrDeleted(state, pp, pl, true, out); return; };
    if sstrEqLitC(m, STR_PTR("thread/unarchived"), STR_LEN("thread/unarchived")) { return; };
    if sstrEqLitC(m, STR_PTR("mini/item/rollback"), STR_LEN("mini/item/rollback")) { applyNotifMiniRollback(state, pp, pl, out); return; };
    if sstrEqLitC(m, STR_PTR("thread/claude/startup"), STR_LEN("thread/claude/startup")) { applyNotifClaudeStartup(state, pp, pl, now_ms, out); return; };
    if sstrEqLitC(m, STR_PTR("turn/started"), STR_LEN("turn/started")) { applyNotifTurnStarted(state, pp, pl, prov, now_ms, out); return; };
    if sstrEqLitC(m, STR_PTR("item/started"), STR_LEN("item/started")) { applyNotifItemStartedOrCompleted(state, pp, pl, false, jev, now_ms, out); return; };
    if sstrEqLitC(m, STR_PTR("item/completed"), STR_LEN("item/completed")) { applyNotifItemStartedOrCompleted(state, pp, pl, true, jev, now_ms, out); return; };
    if sstrEqLitC(m, STR_PTR("item/commandExecution/outputDelta"), STR_LEN("item/commandExecution/outputDelta")) { applyNotifItemPatch(state, pp, pl, 0, now_ms, out); return; };
    if sstrEqLitC(m, STR_PTR("item/fileChange/patchUpdated"), STR_LEN("item/fileChange/patchUpdated")) { applyNotifItemPatch(state, pp, pl, 1, now_ms, out); return; };
    if sstrEqLitC(m, STR_PTR("item/commandExecution/terminalInteraction"), STR_LEN("item/commandExecution/terminalInteraction")) { applyNotifItemPatch(state, pp, pl, 2, now_ms, out); return; };
    if sstrEqLitC(m, STR_PTR("item/agentMessage/delta"), STR_LEN("item/agentMessage/delta")) { applyNotifAgentMessageDelta(state, pp, pl, now_ms, out); return; };
    if sstrEqLitC(m, STR_PTR("item/reasoning/summaryPartAdded"), STR_LEN("item/reasoning/summaryPartAdded")) || sstrEqLitC(m, STR_PTR("item/reasoning/summaryTextDelta"), STR_LEN("item/reasoning/summaryTextDelta")) || sstrEqLitC(m, STR_PTR("item/reasoning/textDelta"), STR_LEN("item/reasoning/textDelta")) { applyNotifReasoningDelta(state, pp, pl, now_ms, out); return; };
    if sstrEqLitC(m, STR_PTR("item/plan/delta"), STR_LEN("item/plan/delta")) { applyNotifPlanDelta(state, pp, pl, now_ms, out); return; };
    if sstrEqLitC(m, STR_PTR("turn/plan/updated"), STR_LEN("turn/plan/updated")) { applyNotifTurnPlanUpdated(state, pp, pl, jev, now_ms, out); return; };
    if sstrEqLitC(m, STR_PTR("turn/completed"), STR_LEN("turn/completed")) { applyNotifTurnTerminal(state, pp, pl, STR_PTR("completed"), STR_LEN("completed"), prov, now_ms, out); return; };
    if sstrEqLitC(m, STR_PTR("turn/failed"), STR_LEN("turn/failed")) { applyNotifTurnTerminal(state, pp, pl, STR_PTR("failed"), STR_LEN("failed"), prov, now_ms, out); return; };
    if sstrEqLitC(m, STR_PTR("turn/interrupted"), STR_LEN("turn/interrupted")) { applyNotifTurnTerminal(state, pp, pl, STR_PTR("interrupted"), STR_LEN("interrupted"), prov, now_ms, out); return; };
    if sstrEqLitC(m, STR_PTR("error"), STR_LEN("error")) { applyNotifError(state, pp, pl, now_ms, out); return; };
}

// ---- status helpers + small functions (TS lines 3976-4350) ----
// DEFECT: string case folding is ASCII-only here (JS toLowerCase is
// Unicode-aware); status vocabularies are ASCII in practice.

fn lowerInto(src_ptr: ptr, src_len: u64, out: &SStr, dashToUnderscore: bool) -> void {
    out.has = true;
    let n = src_len;
    if n > 512 { n = 512; };
    for j in 0..n {
        let b: u8 = 0;
        PTR_BYTE_AT(b, src_ptr, j);
        if b >= 65 && b <= 90 { b = b + 32; };
        if dashToUnderscore && b == 45 { b = 95; };
        out.bytes[j] = b;
    }
    out.len = n;
}

fn litEqBuf(buf_ptr: ptr, buf_len: u64, lit_ptr: ptr, lit_len: u64) -> bool {
    if buf_len != lit_len { return false; };
    for j in 0..lit_len { let a: u8 = 0; PTR_BYTE_AT(a, buf_ptr, j); let b: u8 = 0; PTR_BYTE_AT(b, lit_ptr, j); if a != b { return false; }; }
    return true;
}

// TS (line 3980): function imageApiError(message, status): Error & { status }
struct ImageApiError { message: SStr, status: f64 }
fn imageApiErrorInit(message_ptr: ptr, message_len: u64, status: f64, out: &ImageApiError) -> void {
    sstrSet(&out.message, message_ptr, message_len);
    out.status = status;
}

// TS: function isTerminalWorkbenchStatus(status?)
fn isTerminalWorkbenchStatus(status_ptr: ptr, status_len: u64) -> bool {
    let low = SStr { bytes: [0u8; 512], len: 0, has: false };
    lowerInto(status_ptr, status_len, &low, false);
    let lp: ptr = sstrPtrC(&low);
    if litEqBuf(lp, low.len, STR_PTR("completed"), STR_LEN("completed")) { return true; };
    if litEqBuf(lp, low.len, STR_PTR("complete"), STR_LEN("complete")) { return true; };
    if litEqBuf(lp, low.len, STR_PTR("failed"), STR_LEN("failed")) { return true; };
    if litEqBuf(lp, low.len, STR_PTR("cancelled"), STR_LEN("cancelled")) { return true; };
    if litEqBuf(lp, low.len, STR_PTR("canceled"), STR_LEN("canceled")) { return true; };
    if litEqBuf(lp, low.len, STR_PTR("interrupted"), STR_LEN("interrupted")) { return true; };
    return false;
}

// TS: function isRunningWorkbenchStatus(status?)
fn isRunningWorkbenchStatus(status_ptr: ptr, status_len: u64) -> bool {
    let low = SStr { bytes: [0u8; 512], len: 0, has: false };
    lowerInto(status_ptr, status_len, &low, true);
    let lp: ptr = sstrPtrC(&low);
    if litEqBuf(lp, low.len, STR_PTR("inprogress"), STR_LEN("inprogress")) { return true; };
    if litEqBuf(lp, low.len, STR_PTR("pending"), STR_LEN("pending")) { return true; };
    if litEqBuf(lp, low.len, STR_PTR("pending_init"), STR_LEN("pending_init")) { return true; };
    if litEqBuf(lp, low.len, STR_PTR("running"), STR_LEN("running")) { return true; };
    if litEqBuf(lp, low.len, STR_PTR("started"), STR_LEN("started")) { return true; };
    if litEqBuf(lp, low.len, STR_PTR("active"), STR_LEN("active")) { return true; };
    return false;
}

// TS: function isInterruptedWorkbenchStatus(status?)
fn isInterruptedWorkbenchStatus(status_ptr: ptr, status_len: u64) -> bool {
    let low = SStr { bytes: [0u8; 512], len: 0, has: false };
    lowerInto(status_ptr, status_len, &low, false);
    let lp: ptr = sstrPtrC(&low);
    if litEqBuf(lp, low.len, STR_PTR("interrupted"), STR_LEN("interrupted")) { return true; };
    if litEqBuf(lp, low.len, STR_PTR("cancelled"), STR_LEN("cancelled")) { return true; };
    if litEqBuf(lp, low.len, STR_PTR("canceled"), STR_LEN("canceled")) { return true; };
    return false;
}

// TS: function completeActiveCompactions(items, status) — in-place form
fn completeActiveCompactionsInPlace(turn: &WorkbenchTurn, status_ptr: ptr, status_len: u64) -> void {
    for ii in 0..turn.items_len {
        let item = &turn.items_items[ii];
        let isComp = item.type_len == 17;
        if isComp { for j in 0..17 { let b: u8 = 0; PTR_BYTE_AT(b, STR_PTR("contextCompaction"), j); if item.type_bytes[j] != b { isComp = false; }; }; };
        if !isComp { continue; };
        let terminal = false;
        if item.has_status {
            let st = SStr { bytes: [0u8; 512], len: 0, has: true };
            st.len = item.status_len;
            for j in 0..item.status_len { st.bytes[j] = item.status_bytes[j]; }
            terminal = isTerminalWorkbenchStatus(sstrPtrC(&st), st.len);
        };
        if !terminal { itemSetStatus(item, true, status_ptr, status_len); };
    }
}

// TS (line 4005): applyNotificationPreservingActiveThread
fn applyNotificationPreservingActiveThread(state: &ClientState, notification: &JsonRpcNotification, prov: &ServerStartedTurnIds, jev: &JevDispatchList, now_ms: f64, out: &ClientState) -> void {
    applyNotification(state, notification, prov, jev, now_ms, out);
    out.activeThreadId = state.activeThreadId;
}

// Notification list type for the batch functions
struct NotificationList { items: [JsonRpcNotification; 256], len: u64 }

// TS: function isStreamingWorkbenchNotification(notification)
fn isStreamingWorkbenchNotification(notification: &JsonRpcNotification) -> bool {
    let m = &notification.method;
    if sstrEqLitC(m, STR_PTR("item/agentMessage/delta"), STR_LEN("item/agentMessage/delta")) { return true; };
    if sstrEqLitC(m, STR_PTR("item/reasoning/summaryPartAdded"), STR_LEN("item/reasoning/summaryPartAdded")) { return true; };
    if sstrEqLitC(m, STR_PTR("item/reasoning/summaryTextDelta"), STR_LEN("item/reasoning/summaryTextDelta")) { return true; };
    if sstrEqLitC(m, STR_PTR("item/reasoning/textDelta"), STR_LEN("item/reasoning/textDelta")) { return true; };
    if sstrEqLitC(m, STR_PTR("item/plan/delta"), STR_LEN("item/plan/delta")) { return true; };
    if sstrEqLitC(m, STR_PTR("item/commandExecution/outputDelta"), STR_LEN("item/commandExecution/outputDelta")) { return true; };
    if sstrEqLitC(m, STR_PTR("item/completed"), STR_LEN("item/completed")) { return true; };
    return false;
}

// TS: function isTurnLocalStreamingNotification(notification)
fn isTurnLocalStreamingNotification(notification: &JsonRpcNotification) -> bool {
    if !isStreamingWorkbenchNotification(notification) { return false; };
    if !notification.has_params { return false; };
    let pp: ptr = jsonPtrC(&notification.params_json);
    let tid = SStr { bytes: [0u8; 512], len: 0, has: false };
    if !recStrAlt(pp, notification.params_json.len, STR_PTR("turnId"), STR_LEN("turnId"), STR_PTR("turn_id"), STR_LEN("turn_id"), &tid) { return false; };
    if !sstrEqLitC(&notification.method, STR_PTR("item/completed"), STR_LEN("item/completed")) { return true; };
    let itemVal = JsonBufC { bytes: [0u8; 16384], len: 0 };
    if !recVal(pp, notification.params_json.len, STR_PTR("item"), STR_LEN("item"), &itemVal) { return true; };
    let item = JsonBufC { bytes: [0u8; 16384], len: 0 };
    asRecordC(jsonPtrC(&itemVal), itemVal.len, &item);
    let rawType = SStr { bytes: [0u8; 512], len: 0, has: false };
    if !recStr(jsonPtrC(&item), item.len, STR_PTR("type"), STR_LEN("type"), &rawType) { inferItemType(jsonPtrC(&item), item.len, &rawType); };
    let normalized = SStr { bytes: [0u8; 512], len: 0, has: false };
    normalizeWorkbenchItemType(sstrPtrC(&rawType), rawType.len, jsonPtrC(&item), item.len, &normalized);
    return !sstrEqLitC(&normalized, STR_PTR("contextCompaction"), STR_LEN("contextCompaction"));
}

// TS: function applyTurnLocalStreamingNotifications(state, notifications)
// DEFECT: the TS Map-based turn indexing is a linear-scan grouping here;
// per-turn scoped application reuses applyNotificationPreservingActiveThread
// on a single-turn view of the state, as in the source.
fn applyTurnLocalStreamingNotifications(state: &ClientState, notifications: &NotificationList, prov: &ServerStartedTurnIds, jev: &JevDispatchList, now_ms: f64, out: &ClientState) -> void {
    *out = *state;
    // collect distinct turnIds in wire order
    let turnIds: [SStr; 128] = [SStr { bytes: [0u8; 512], len: 0, has: false }; 128];
    let turnIds_len: u64 = 0;
    for ni in 0..notifications.len {
        let n = &notifications.items[ni];
        if !n.has_params { continue; };
        let pp: ptr = jsonPtrC(&n.params_json);
        let tid = SStr { bytes: [0u8; 512], len: 0, has: false };
        let found = recStrAlt(pp, n.params_json.len, STR_PTR("turnId"), STR_LEN("turnId"), STR_PTR("turn_id"), STR_LEN("turn_id"), &tid);
        if !found {
            let itemVal = JsonBufC { bytes: [0u8; 16384], len: 0 };
            if recVal(pp, n.params_json.len, STR_PTR("item"), STR_LEN("item"), &itemVal) {
                let item = JsonBufC { bytes: [0u8; 16384], len: 0 };
                asRecordC(jsonPtrC(&itemVal), itemVal.len, &item);
                found = recStrAlt(jsonPtrC(&item), item.len, STR_PTR("turnId"), STR_LEN("turnId"), STR_PTR("turn_id"), STR_LEN("turn_id"), &tid);
            };
        };
        if !found { continue; };
        let known = false;
        for k in 0..turnIds_len { if sstrEqC(&turnIds[k], &tid) { known = true; }; };
        if !known && turnIds_len < 128 { turnIds[turnIds_len] = tid; turnIds_len = turnIds_len + 1; };
    }
    // seed stub turns for unknown turnIds
    for k in 0..turnIds_len {
        let tid = turnIds[k];
        let existsIdx: u64 = 0;
        if stateFindTurn(out, sstrPtrC(&tid), tid.len, &existsIdx) { continue; };
        // seed params = first notification for this turn
        let seedThreadId = SStr { bytes: [0u8; 512], len: 0, has: false };
        let hasSeed = false;
        for ni in 0..notifications.len {
            let n = &notifications.items[ni];
            if !n.has_params { continue; };
            let pp: ptr = jsonPtrC(&n.params_json);
            let nt = SStr { bytes: [0u8; 512], len: 0, has: false };
            let isThis = recStrAlt(pp, n.params_json.len, STR_PTR("turnId"), STR_LEN("turnId"), STR_PTR("turn_id"), STR_LEN("turn_id"), &nt) && sstrEqC(&nt, &tid);
            if !isThis {
                let itemVal = JsonBufC { bytes: [0u8; 16384], len: 0 };
                if recVal(pp, n.params_json.len, STR_PTR("item"), STR_LEN("item"), &itemVal) {
                    let item = JsonBufC { bytes: [0u8; 16384], len: 0 };
                    asRecordC(jsonPtrC(&itemVal), itemVal.len, &item);
                    isThis = recStrAlt(jsonPtrC(&item), item.len, STR_PTR("turnId"), STR_LEN("turnId"), STR_PTR("turn_id"), STR_LEN("turn_id"), &nt) && sstrEqC(&nt, &tid);
                };
            };
            if isThis {
                hasSeed = recStrAlt(pp, n.params_json.len, STR_PTR("threadId"), STR_LEN("threadId"), STR_PTR("thread_id"), STR_LEN("thread_id"), &seedThreadId);
                if !hasSeed {
                    let itemVal = JsonBufC { bytes: [0u8; 16384], len: 0 };
                    if recVal(pp, n.params_json.len, STR_PTR("item"), STR_LEN("item"), &itemVal) {
                        let item = JsonBufC { bytes: [0u8; 16384], len: 0 };
                        asRecordC(jsonPtrC(&itemVal), itemVal.len, &item);
                        hasSeed = recStrAlt(jsonPtrC(&item), item.len, STR_PTR("threadId"), STR_LEN("threadId"), STR_PTR("thread_id"), STR_LEN("thread_id"), &seedThreadId);
                    };
                };
                break;
            };
        }
        if !hasSeed && out.activeThreadId.has { seedThreadId = out.activeThreadId; hasSeed = true; };
        if !hasSeed { seedThreadId = tid; };
        let stub = blankWorkbenchTurn();
        turnSetId(&stub, sstrPtrC(&tid), tid.len);
        turnSetThreadId(&stub, sstrPtrC(&seedThreadId), seedThreadId.len);
        turnSetStatus(&stub, true, STR_PTR("inProgress"), STR_LEN("inProgress"));
        stub.has_startedAt = true;
        stub.startedAt = now_ms / 1000.0;
        stateUpsertTurn(out, &stub);
    }
    // apply each turn's notifications against a single-turn scoped state
    for k in 0..turnIds_len {
        let tid = turnIds[k];
        let ti: u64 = 0;
        if !stateFindTurn(out, sstrPtrC(&tid), tid.len, &ti) { continue; };
        let scoped = *out;
        let originalTurn = out.turns_items[ti];
        scoped.turns_items[0] = originalTurn;
        scoped.turns_len = 1;
        for ni in 0..notifications.len {
            let n = &notifications.items[ni];
            if !n.has_params { continue; };
            let pp: ptr = jsonPtrC(&n.params_json);
            let nt = SStr { bytes: [0u8; 512], len: 0, has: false };
            let belongs = recStrAlt(pp, n.params_json.len, STR_PTR("turnId"), STR_LEN("turnId"), STR_PTR("turn_id"), STR_LEN("turn_id"), &nt) && sstrEqC(&nt, &tid);
            if !belongs {
                let itemVal = JsonBufC { bytes: [0u8; 16384], len: 0 };
                if recVal(pp, n.params_json.len, STR_PTR("item"), STR_LEN("item"), &itemVal) {
                    let item = JsonBufC { bytes: [0u8; 16384], len: 0 };
                    asRecordC(jsonPtrC(&itemVal), itemVal.len, &item);
                    belongs = recStrAlt(jsonPtrC(&item), item.len, STR_PTR("turnId"), STR_LEN("turnId"), STR_PTR("turn_id"), STR_LEN("turn_id"), &nt) && sstrEqC(&nt, &tid);
                };
            };
            if belongs {
                let next = scoped;
                applyNotificationPreservingActiveThread(&scoped, n, prov, jev, now_ms, &next);
                scoped = next;
            };
        }
        if scoped.turns_len > 0 { out.turns_items[ti] = scoped.turns_items[0]; };
    }
}

// TS (line 4024): applyNotificationsPreservingActiveThread
fn applyNotificationsPreservingActiveThread(state: &ClientState, notifications: &NotificationList, prov: &ServerStartedTurnIds, jev: &JevDispatchList, now_ms: f64, out: &ClientState) -> void {
    *out = *state;
    if notifications.len == 0 { return; };
    let allStreaming = true;
    for ni in 0..notifications.len { if !isTurnLocalStreamingNotification(&notifications.items[ni]) { allStreaming = false; }; };
    if allStreaming { applyTurnLocalStreamingNotifications(state, notifications, prov, jev, now_ms, out); return; };
    let cur = *state;
    let segment = NotificationList { items: [JsonRpcNotification { method: SStr { bytes: [0u8; 512], len: 0, has: false }, has_params: false, params_json: JsonBufC { bytes: [0u8; 16384], len: 0 } }; 256], len: 0 };
    for ni in 0..notifications.len {
        let n = notifications.items[ni];
        if isTurnLocalStreamingNotification(&n) {
            if segment.len < 256 { segment.items[segment.len] = n; segment.len = segment.len + 1; };
        } else {
            if segment.len > 0 {
                let next = cur;
                applyTurnLocalStreamingNotifications(&cur, &segment, prov, jev, now_ms, &next);
                cur = next;
                segment.len = 0;
            };
            let next2 = cur;
            applyNotificationPreservingActiveThread(&cur, &n, prov, jev, now_ms, &next2);
            cur = next2;
        };
    }
    if segment.len > 0 {
        let next = cur;
        applyTurnLocalStreamingNotifications(&cur, &segment, prov, jev, now_ms, &next);
        cur = next;
    };
    *out = cur;
}

// TS: function streamingNotificationTargetKey(notification): string | null
// (has=false in out means null)
fn streamingNotificationTargetKey(notification: &JsonRpcNotification, out: &BigStrC) -> bool {
    out.len = 0;
    if sstrEqLitC(&notification.method, STR_PTR("item/completed"), STR_LEN("item/completed")) { return false; };
    if !isStreamingWorkbenchNotification(notification) { return false; };
    if !notification.has_params { return false; };
    let pp: ptr = jsonPtrC(&notification.params_json);
    bigStrAppend(out, sstrPtrC(&notification.method), notification.method.len);
    bigStrAppend(out, STR_PTR("|"), STR_LEN("|"));
    let v = SStr { bytes: [0u8; 512], len: 0, has: false };
    if recStrAlt(pp, notification.params_json.len, STR_PTR("threadId"), STR_LEN("threadId"), STR_PTR("thread_id"), STR_LEN("thread_id"), &v) { bigStrAppend(out, sstrPtrC(&v), v.len); };
    bigStrAppend(out, STR_PTR("|"), STR_LEN("|"));
    if recStrAlt(pp, notification.params_json.len, STR_PTR("turnId"), STR_LEN("turnId"), STR_PTR("turn_id"), STR_LEN("turn_id"), &v) { bigStrAppend(out, sstrPtrC(&v), v.len); };
    bigStrAppend(out, STR_PTR("|"), STR_LEN("|"));
    if recStrAlt(pp, notification.params_json.len, STR_PTR("itemId"), STR_LEN("itemId"), STR_PTR("item_id"), STR_LEN("item_id"), &v) { bigStrAppend(out, sstrPtrC(&v), v.len); };
    return true;
}

// TS: function sameStreamingNotificationTarget(previous, next)
fn sameStreamingNotificationTarget(previous: &JsonRpcNotification, next: &JsonRpcNotification) -> bool {
    if sstrEqLitC(&previous.method, STR_PTR("item/completed"), STR_LEN("item/completed")) { return false; };
    if !sstrEqC(&previous.method, &next.method) { return false; };
    if !isStreamingWorkbenchNotification(previous) { return false; };
    if !previous.has_params || !next.has_params { return false; };
    let a = SStr { bytes: [0u8; 512], len: 0, has: false };
    let b = SStr { bytes: [0u8; 512], len: 0, has: false };
    let pa: ptr = jsonPtrC(&previous.params_json);
    let pb: ptr = jsonPtrC(&next.params_json);
    let ha = recStrAlt(pa, previous.params_json.len, STR_PTR("threadId"), STR_LEN("threadId"), STR_PTR("thread_id"), STR_LEN("thread_id"), &a);
    let hb = recStrAlt(pb, next.params_json.len, STR_PTR("threadId"), STR_LEN("threadId"), STR_PTR("thread_id"), STR_LEN("thread_id"), &b);
    if ha != hb { return false; };
    if ha && !sstrEqC(&a, &b) { return false; };
    ha = recStrAlt(pa, previous.params_json.len, STR_PTR("turnId"), STR_LEN("turnId"), STR_PTR("turn_id"), STR_LEN("turn_id"), &a);
    hb = recStrAlt(pb, next.params_json.len, STR_PTR("turnId"), STR_LEN("turnId"), STR_PTR("turn_id"), STR_LEN("turn_id"), &b);
    if ha != hb { return false; };
    if ha && !sstrEqC(&a, &b) { return false; };
    ha = recStrAlt(pa, previous.params_json.len, STR_PTR("itemId"), STR_LEN("itemId"), STR_PTR("item_id"), STR_LEN("item_id"), &a);
    hb = recStrAlt(pb, next.params_json.len, STR_PTR("itemId"), STR_LEN("itemId"), STR_PTR("item_id"), STR_LEN("item_id"), &b);
    if ha != hb { return false; };
    if ha && !sstrEqC(&a, &b) { return false; };
    return true;
}

// TS (line 4162): export function coalesceStreamingWorkbenchNotifications
// DEFECT: the TS Map<string, number> of delta targets is a parallel key
// list here (fix phase: btree_map.sa). Key invalidation on rollback /
// terminal / item start-complete events follows the source.
fn coalesceStreamingWorkbenchNotifications(notifications: &NotificationList, out: &NotificationList) -> void {
    out.len = 0;
    let keys: [BigStrC; 256] = [BigStrC { bytes: [0u8; 8192], len: 0 }; 256];
    let keyIdx: [u64; 256] = [0u64; 256];
    let keys_len: u64 = 0;
    for ni in 0..notifications.len {
        let notification = notifications.items[ni];
        // invalidation passes
        let invalidate = false;
        let invThread = SStr { bytes: [0u8; 512], len: 0, has: false };
        let invTurn = SStr { bytes: [0u8; 512], len: 0, has: false };
        let invItem = SStr { bytes: [0u8; 512], len: 0, has: false };
        let invHasItem = false;
        let invItemIds = JsonBufC { bytes: [0u8; 16384], len: 0 };
        let invIsRollback = false;
        if notification.has_params {
            let pp: ptr = jsonPtrC(&notification.params_json);
            if sstrEqLitC(&notification.method, STR_PTR("mini/item/rollback"), STR_LEN("mini/item/rollback")) {
                invalidate = true;
                invIsRollback = true;
                recStrAlt(pp, notification.params_json.len, STR_PTR("threadId"), STR_LEN("threadId"), STR_PTR("thread_id"), STR_LEN("thread_id"), &invThread);
                recStrAlt(pp, notification.params_json.len, STR_PTR("turnId"), STR_LEN("turnId"), STR_PTR("turn_id"), STR_LEN("turn_id"), &invTurn);
                if !recVal(pp, notification.params_json.len, STR_PTR("itemIds"), STR_LEN("itemIds"), &invItemIds) { recVal(pp, notification.params_json.len, STR_PTR("item_ids"), STR_LEN("item_ids"), &invItemIds); };
            } else if sstrEqLitC(&notification.method, STR_PTR("turn/completed"), STR_LEN("turn/completed")) || sstrEqLitC(&notification.method, STR_PTR("turn/failed"), STR_LEN("turn/failed")) || sstrEqLitC(&notification.method, STR_PTR("turn/interrupted"), STR_LEN("turn/interrupted")) {
                invalidate = true;
                recStrAlt(pp, notification.params_json.len, STR_PTR("threadId"), STR_LEN("threadId"), STR_PTR("thread_id"), STR_LEN("thread_id"), &invThread);
                let turnVal = JsonBufC { bytes: [0u8; 16384], len: 0 };
                if recVal(pp, notification.params_json.len, STR_PTR("turn"), STR_LEN("turn"), &turnVal) {
                    let turn = JsonBufC { bytes: [0u8; 16384], len: 0 };
                    asRecordC(jsonPtrC(&turnVal), turnVal.len, &turn);
                    if !invThread.has { recStrAlt(jsonPtrC(&turn), turn.len, STR_PTR("threadId"), STR_LEN("threadId"), STR_PTR("thread_id"), STR_LEN("thread_id"), &invThread); };
                    recStr(jsonPtrC(&turn), turn.len, STR_PTR("id"), STR_LEN("id"), &invTurn);
                };
                if !invTurn.has { recStrAlt(pp, notification.params_json.len, STR_PTR("turnId"), STR_LEN("turnId"), STR_PTR("turn_id"), STR_LEN("turn_id"), &invTurn); };
                if !invTurn.has { invalidate = false; };
            } else if sstrEqLitC(&notification.method, STR_PTR("item/started"), STR_LEN("item/started")) || sstrEqLitC(&notification.method, STR_PTR("item/completed"), STR_LEN("item/completed")) {
                let itemVal = JsonBufC { bytes: [0u8; 16384], len: 0 };
                if recVal(pp, notification.params_json.len, STR_PTR("item"), STR_LEN("item"), &itemVal) {
                    let item = JsonBufC { bytes: [0u8; 16384], len: 0 };
                    asRecordC(jsonPtrC(&itemVal), itemVal.len, &item);
                    recStrAlt(pp, notification.params_json.len, STR_PTR("threadId"), STR_LEN("threadId"), STR_PTR("thread_id"), STR_LEN("thread_id"), &invThread);
                    recStrAlt(pp, notification.params_json.len, STR_PTR("turnId"), STR_LEN("turnId"), STR_PTR("turn_id"), STR_LEN("turn_id"), &invTurn);
                    invHasItem = recStr(jsonPtrC(&item), item.len, STR_PTR("id"), STR_LEN("id"), &invItem);
                    invalidate = invTurn.has && invHasItem;
                };
            };
        };
        if invalidate {
            let w: u64 = 0;
            for k in 0..keys_len {
                // key parts: method|threadId|turnId|itemId (split on '|')
                let key = &keys[k];
                let parts: [SStr; 4] = [SStr { bytes: [0u8; 512], len: 0, has: false }; 4];
                let partCount: u64 = 0;
                let start: u64 = 0;
                for j in 0..key.len + 1 {
                    if j == key.len || key.bytes[j] == 124 {
                        if partCount < 4 {
                            let plen = j - start;
                            if plen > 512 { plen = 512; };
                            parts[partCount].len = plen;
                            parts[partCount].has = true;
                            for q in 0..plen { parts[partCount].bytes[q] = key.bytes[start + q]; }
                            partCount = partCount + 1;
                        };
                        start = j + 1;
                    };
                }
                let drop = false;
                if partCount >= 3 && sstrEqC(&parts[2], &invTurn) && (!invThread.has || sstrEqC(&parts[1], &invThread)) {
                    if invIsRollback {
                        if partCount >= 4 {
                            // itemIds membership in the rollback id set
                            let count = sa_json_array_len(jsonPtrC(&invItemIds), invItemIds.len);
                            for q in 0..count {
                                let evp: ptr = PTR_NULL();
                                let evl: u64 = 0;
                                if sa_json_array_at_value_text(jsonPtrC(&invItemIds), invItemIds.len, q, &evp, &evl) == 0 {
                                    let es = SStr { bytes: [0u8; 512], len: 0, has: false };
                                    if jsonValueStr(evp, evl, &es) && sstrEqC(&es, &parts[3]) { drop = true; };
                                };
                            }
                        };
                    } else if invHasItem {
                        if partCount >= 4 && sstrEqC(&parts[3], &invItem) { drop = true; };
                    } else { drop = true; };
                };
                if !drop { keys[w] = keys[k]; keyIdx[w] = keyIdx[k]; w = w + 1; };
            }
            keys_len = w;
        };
        // coalesce or push
        let key = BigStrC { bytes: [0u8; 8192], len: 0 };
        let hasKey = streamingNotificationTargetKey(&notification, &key);
        let prevIdx: u64 = 0;
        let hasPrev = false;
        if hasKey {
            for k in 0..keys_len {
                if keys[k].len == key.len {
                    let same = true;
                    for j in 0..key.len { if keys[k].bytes[j] != key.bytes[j] { same = false; }; };
                    if same { prevIdx = keyIdx[k]; hasPrev = true; };
                };
            }
        };
        if !hasPrev || prevIdx >= out.len || !sameStreamingNotificationTarget(&out.items[prevIdx], &notification) {
            if hasKey && out.len < 256 {
                let foundK = false;
                for k in 0..keys_len { if keys[k].len == key.len { let same = true; for j in 0..key.len { if keys[k].bytes[j] != key.bytes[j] { same = false; }; }; if same { keyIdx[k] = out.len; foundK = true; }; }; };
                if !foundK && keys_len < 256 { keys[keys_len] = key; keyIdx[keys_len] = out.len; keys_len = keys_len + 1; };
            };
            if out.len < 256 { out.items[out.len] = notification; out.len = out.len + 1; };
            continue;
        };
        // merge: params = {...prevParams, ...nextParams, delta: prev+next}
        let prev = out.items[prevIdx];
        let merged = notification;
        if prev.has_params && notification.has_params {
            let mp: ptr = PTR_NULL();
            let ml: u64 = 0;
            if sa_json_object_merge_copy(jsonPtrC(&prev.params_json), prev.params_json.len, jsonPtrC(&notification.params_json), notification.params_json.len, &mp, &ml) == 0 {
                jsonBufSetC(&merged.params_json, mp, ml);
                merged.has_params = true;
                let dPrev = SStr { bytes: [0u8; 512], len: 0, has: false };
                let dNext = SStr { bytes: [0u8; 512], len: 0, has: false };
                recStr(jsonPtrC(&prev.params_json), prev.params_json.len, STR_PTR("delta"), STR_LEN("delta"), &dPrev);
                recStr(jsonPtrC(&notification.params_json), notification.params_json.len, STR_PTR("delta"), STR_LEN("delta"), &dNext);
                let combined = BigStrC { bytes: [0u8; 8192], len: 0 };
                bigStrAppend(&combined, STR_PTR("\""), STR_LEN("\""));
                bigStrAppend(&combined, sstrPtrC(&dPrev), dPrev.len);
                bigStrAppend(&combined, sstrPtrC(&dNext), dNext.len);
                bigStrAppend(&combined, STR_PTR("\""), STR_LEN("\""));
                // DEFECT: the combined delta is written back as a JSON string
                // without escaping (deltas with quotes/backslashes diverge)
                let cur = JsonBufC { bytes: [0u8; 16384], len: 0 };
                jsonBufCopyC(&cur, &merged.params_json);
                let rp: ptr = PTR_NULL();
                let rl: u64 = 0;
                if sa_json_object_set_value_text(jsonPtrC(&cur), cur.len, STR_PTR("delta"), STR_LEN("delta"), bigPtrC(&combined), combined.len, &rp, &rl) == 0 { jsonBufSetC(&merged.params_json, rp, rl); };
            };
        };
        out.items[prevIdx] = merged;
    }
}

// TS: function formatPlanUpdateText(params)
fn formatPlanUpdateText(params_ptr: ptr, params_len: u64, out: &BigStrC) -> void {
    out.len = 0;
    let explanation = SStr { bytes: [0u8; 512], len: 0, has: false };
    let hasExplanation = recStr(params_ptr, params_len, STR_PTR("explanation"), STR_LEN("explanation"), &explanation);
    let lines = BigStrC { bytes: [0u8; 8192], len: 0 };
    let planVal = JsonBufC { bytes: [0u8; 16384], len: 0 };
    if recVal(params_ptr, params_len, STR_PTR("plan"), STR_LEN("plan"), &planVal) {
        let count = sa_json_array_len(jsonPtrC(&planVal), planVal.len);
        for k in 0..count {
            let evp: ptr = PTR_NULL();
            let evl: u64 = 0;
            if sa_json_array_at_value_text(jsonPtrC(&planVal), planVal.len, k, &evp, &evl) != 0 { continue; };
            let entry = JsonBufC { bytes: [0u8; 16384], len: 0 };
            asRecordC(evp, evl, &entry);
            let ep: ptr = jsonPtrC(&entry);
            let step = SStr { bytes: [0u8; 512], len: 0, has: false };
            if !recStr(ep, entry.len, STR_PTR("step"), STR_LEN("step"), &step) { if !recStr(ep, entry.len, STR_PTR("text"), STR_LEN("text"), &step) { continue; }; };
            let status = SStr { bytes: [0u8; 512], len: 0, has: false };
            recStr(ep, entry.len, STR_PTR("status"), STR_LEN("status"), &status);
            if lines.len > 0 { bigStrAppend(&lines, STR_PTR("\n"), STR_LEN("\n")); };
            if sstrEqLitC(&status, STR_PTR("completed"), STR_LEN("completed")) {
                bigStrAppend(&lines, STR_PTR("- [x] "), STR_LEN("- [x] "));
            } else if sstrEqLitC(&status, STR_PTR("inProgress"), STR_LEN("inProgress")) || sstrEqLitC(&status, STR_PTR("in_progress"), STR_LEN("in_progress")) {
                bigStrAppend(&lines, STR_PTR("- [ ] "), STR_LEN("- [ ] "));
                bigStrAppend(&lines, sstrPtrC(&step), step.len);
                bigStrAppend(&lines, STR_PTR(" _(in progress)_"), STR_LEN(" _(in progress)_"));
                continue;
            } else {
                bigStrAppend(&lines, STR_PTR("- [ ] "), STR_LEN("- [ ] "));
            };
            bigStrAppend(&lines, sstrPtrC(&step), step.len);
        }
    };
    if hasExplanation { bigStrAppend(out, sstrPtrC(&explanation), explanation.len); };
    if hasExplanation && lines.len > 0 { bigStrAppend(out, STR_PTR("\n\n"), STR_LEN("\n\n")); };
    bigStrAppend(out, bigPtrC(&lines), lines.len);
}

// TS: function planUpdateStatus(params)
fn planUpdateStatus(params_ptr: ptr, params_len: u64, out: &SStr) -> void {
    let planVal = JsonBufC { bytes: [0u8; 16384], len: 0 };
    let count: u64 = 0;
    if recVal(params_ptr, params_len, STR_PTR("plan"), STR_LEN("plan"), &planVal) { count = sa_json_array_len(jsonPtrC(&planVal), planVal.len); };
    let anyInProgress = false;
    let allCompleted = count > 0;
    for k in 0..count {
        let evp: ptr = PTR_NULL();
        let evl: u64 = 0;
        if sa_json_array_at_value_text(jsonPtrC(&planVal), planVal.len, k, &evp, &evl) != 0 { allCompleted = false; continue; };
        let entry = JsonBufC { bytes: [0u8; 16384], len: 0 };
        asRecordC(evp, evl, &entry);
        let status = SStr { bytes: [0u8; 512], len: 0, has: false };
        recStr(jsonPtrC(&entry), entry.len, STR_PTR("status"), STR_LEN("status"), &status);
        if sstrEqLitC(&status, STR_PTR("inProgress"), STR_LEN("inProgress")) || sstrEqLitC(&status, STR_PTR("in_progress"), STR_LEN("in_progress")) { anyInProgress = true; };
        if !sstrEqLitC(&status, STR_PTR("completed"), STR_LEN("completed")) { allCompleted = false; };
    }
    if anyInProgress { sstrSetLit(out, STR_PTR("inProgress"), STR_LEN("inProgress")); return; };
    if allCompleted { sstrSetLit(out, STR_PTR("completed"), STR_LEN("completed")); return; };
    sstrSetLit(out, STR_PTR("pending"), STR_LEN("pending"));
}

