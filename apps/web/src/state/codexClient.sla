struct FsDirectoryList { items: [FsDirectoryEntry; 256], len: u64 }
struct StrListC { items: [SStr; 64], len: u64 }

// iterate a JSON array's elements as records: helper returns element count
fn arrCount(arr_ptr: ptr, arr_len: u64) -> u64 { return sa_json_array_len(arr_ptr, arr_len); }
fn arrElemRec(arr_ptr: ptr, arr_len: u64, idx: u64, out: &JsonBufC) -> bool {
    let evp: ptr = PTR_NULL();
    let evl: u64 = 0;
    if sa_json_array_at_value_text(arr_ptr, arr_len, idx, &evp, &evl) != 0 { return false; };
    asRecordC(evp, evl, out);
    return true;
}

// TS (line 4351): export function parseMcpServers(value)
fn parseMcpServers(value_ptr: ptr, value_len: u64, out: &McpServerList) -> void {
    out.len = 0;
    let root = JsonBufC { bytes: [0u8; 16384], len: 0 };
    asRecordC(value_ptr, value_len, &root);
    let data = JsonBufC { bytes: [0u8; 16384], len: 0 };
    if !recVal(jsonPtrC(&root), root.len, STR_PTR("data"), STR_LEN("data"), &data) { return; };
    let count = arrCount(jsonPtrC(&data), data.len);
    for k in 0..count {
        if out.len >= 32 { break; };
        let server = JsonBufC { bytes: [0u8; 16384], len: 0 };
        if !arrElemRec(jsonPtrC(&data), data.len, k, &server) { continue; };
        let sp: ptr = jsonPtrC(&server);
        let entry = &out.items[out.len];
        entry.name.has = false; entry.name.len = 0;
        entry.authStatus.has = false; entry.authStatus.len = 0;
        entry.serverInfo.has = false; entry.serverInfo.len = 0;
        entry.tools_len = 0;
        entry.resources_len = 0;
        entry.resourceTemplates_len = 0;
        if !recStrNE(sp, server.len, STR_PTR("name"), STR_LEN("name"), &entry.name) { sstrSetLit(&entry.name, STR_PTR("Unnamed MCP server"), STR_LEN("Unnamed MCP server")); };
        if !recStrNE(sp, server.len, STR_PTR("authStatus"), STR_LEN("authStatus"), &entry.authStatus) { sstrSetLit(&entry.authStatus, STR_PTR("unknown"), STR_LEN("unknown")); };
        let infoVal = JsonBufC { bytes: [0u8; 16384], len: 0 };
        if recVal(sp, server.len, STR_PTR("serverInfo"), STR_LEN("serverInfo"), &infoVal) { serverInfoLabel(jsonPtrC(&infoVal), infoVal.len, &entry.serverInfo); };
        // tools: Object.values(server.tools) — object values in key order
        let toolsVal = JsonBufC { bytes: [0u8; 16384], len: 0 };
        if recVal(sp, server.len, STR_PTR("tools"), STR_LEN("tools"), &toolsVal) {
            let tools = JsonBufC { bytes: [0u8; 16384], len: 0 };
            asRecordC(jsonPtrC(&toolsVal), toolsVal.len, &tools);
            let keyCount = sa_json_object_key_count(jsonPtrC(&tools), tools.len);
            for q in 0..keyCount {
                if entry.tools_len >= 64 { break; };
                let kp: ptr = PTR_NULL();
                let kl: u64 = 0;
                if sa_json_object_key_at(jsonPtrC(&tools), tools.len, q, &kp, &kl) != 0 { continue; };
                let tv = JsonBufC { bytes: [0u8; 16384], len: 0 };
                if !recVal(jsonPtrC(&tools), tools.len, kp, kl, &tv) { continue; };
                let trec = JsonBufC { bytes: [0u8; 16384], len: 0 };
                asRecordC(jsonPtrC(&tv), tv.len, &trec);
                mcpToolToEntry(jsonPtrC(&trec), trec.len, &entry.tools[entry.tools_len]);
                entry.tools_len = entry.tools_len + 1;
            }
        };
        let arr = JsonBufC { bytes: [0u8; 16384], len: 0 };
        if recVal(sp, server.len, STR_PTR("resources"), STR_LEN("resources"), &arr) {
            let c2 = arrCount(jsonPtrC(&arr), arr.len);
            for q in 0..c2 {
                if entry.resources_len >= 64 { break; };
                let rec = JsonBufC { bytes: [0u8; 16384], len: 0 };
                if arrElemRec(jsonPtrC(&arr), arr.len, q, &rec) { mcpResourceToEntry(jsonPtrC(&rec), rec.len, &entry.resources[entry.resources_len]); entry.resources_len = entry.resources_len + 1; };
            }
        };
        if recVal(sp, server.len, STR_PTR("resourceTemplates"), STR_LEN("resourceTemplates"), &arr) {
            let c2 = arrCount(jsonPtrC(&arr), arr.len);
            for q in 0..c2 {
                if entry.resourceTemplates_len >= 64 { break; };
                let rec = JsonBufC { bytes: [0u8; 16384], len: 0 };
                if arrElemRec(jsonPtrC(&arr), arr.len, q, &rec) { mcpResourceToEntry(jsonPtrC(&rec), rec.len, &entry.resourceTemplates[entry.resourceTemplates_len]); entry.resourceTemplates_len = entry.resourceTemplates_len + 1; };
            }
        };
        out.len = out.len + 1;
    }
}

