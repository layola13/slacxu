// ---- list types for the parse functions ----
struct McpServerList { items: [McpServerEntry; 32], len: u64 }
struct SkillGroupList { items: [SkillGroup; 32], len: u64 }
struct HookGroupList { items: [HookGroup; 32], len: u64 }
