// TS: public restoreProvider(providerId): Promise<ProviderConfig>
fn codexSocketClientRestoreProvider(client: &CodexSocketClient, providerId_ptr: ptr, providerId_len: u64, now_ms: f64, out_id: &SStr) -> void {
