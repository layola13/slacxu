fn catalogRequest(token_ptr: ptr, token_len: u64, path_ptr: ptr, path_len: u64, body_json: &JsonBufC, fallback_ptr: ptr, fallback_len: u64, out: &JsonBufC, err: &SStr) -> i32 {
    let bp: ptr = PTR_NULL();
    PTR_BYTE_ADD(bp, &body_json.bytes, 0);
    let resp = HttpResponse { status: 0, body: JsonBufC { bytes: [0u8; 16384], len: 0 } };
    if httpFetchJson(STR_PTR("POST"), STR_LEN("POST"), path_ptr, path_len, token_ptr, token_len, true, bp, body_json.len, &resp) != 0 { return 1; };
    if !responseOk(&resp) {
        // body.error || `${fallback} (${status})`
        let rp: ptr = PTR_NULL();
        PTR_BYTE_ADD(rp, &resp.body.bytes, 0);
        let ep: ptr = PTR_NULL();
        let el: u64 = 0;
        if sa_json_object_get_string(rp, resp.body.len, STR_PTR("error"), STR_LEN("error"), &ep, &el) == 0 && el > 0 { sstrSet(err, ep, el); return 1; };
        let msg = BigStrC { bytes: [0u8; 8192], len: 0 };
        bigStrAppend(&msg, fallback_ptr, fallback_len);
        bigStrAppend(&msg, STR_PTR(" ("), STR_LEN(" ("));
        bigStrAppendU64(&msg, resp.status);
        bigStrAppend(&msg, STR_PTR(")"), STR_LEN(")"));
        let mp: ptr = PTR_NULL();
        PTR_BYTE_ADD(mp, &msg.bytes, 0);
        sstrSet(err, mp, msg.len);
        return 1;
    };
    jsonBufCopyC(out, &resp.body);
    return 0;
}

