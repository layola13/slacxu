// TS: function threadToEntry(thread)
fn threadToEntry(thread_ptr: ptr, thread_len: u64, out: &ThreadEntry) -> void {
    threadEntryClear(out);
    // id: String(thread.id ?? "")
    let idVal = JsonBufC { bytes: [0u8; 16384], len: 0 };
    out.id.has = true;
    if recVal(thread_ptr, thread_len, STR_PTR("id"), STR_LEN("id"), &idVal) {
        let s = SStr { bytes: [0u8; 512], len: 0, has: false };
        if jsonValueStr(jsonPtrC(&idVal), idVal.len, &s) { out.id = s; out.id.has = true; } else { sstrSet(&out.id, jsonPtrC(&idVal), idVal.len); out.id.has = true; };
    };
    let backend = SStr { bytes: [0u8; 512], len: 0, has: false };
    recStrAlt(thread_ptr, thread_len, STR_PTR("cliBackend"), STR_LEN("cliBackend"), STR_PTR("cli_backend"), STR_LEN("cli_backend"), &backend);
    if backend.has && (sstrEqLitC(&backend, STR_PTR("claude"), STR_LEN("claude")) || sstrEqLitC(&backend, STR_PTR("auggie"), STR_LEN("auggie")) || sstrEqLitC(&backend, STR_PTR("agy"), STR_LEN("agy")) || sstrEqLitC(&backend, STR_PTR("grok"), STR_LEN("grok")) || sstrEqLitC(&backend, STR_PTR("muse"), STR_LEN("muse")) || sstrEqLitC(&backend, STR_PTR("pi"), STR_LEN("pi")) || sstrEqLitC(&backend, STR_PTR("opencode"), STR_LEN("opencode")) || sstrEqLitC(&backend, STR_PTR("opencode-v2"), STR_LEN("opencode-v2")) || sstrEqLitC(&backend, STR_PTR("mini"), STR_LEN("mini")) || sstrEqLitC(&backend, STR_PTR("codex"), STR_LEN("codex"))) { out.cliBackend = backend; };
    recStrAlt(thread_ptr, thread_len, STR_PTR("sessionId"), STR_LEN("sessionId"), STR_PTR("session_id"), STR_LEN("session_id"), &out.sessionId);
    let name = SStr { bytes: [0u8; 512], len: 0, has: false };
    if !recStrNE(thread_ptr, thread_len, STR_PTR("name"), STR_LEN("name"), &name) {
        if !recStrNE(thread_ptr, thread_len, STR_PTR("threadName"), STR_LEN("threadName"), &name) { recStrNE(thread_ptr, thread_len, STR_PTR("thread_name"), STR_LEN("thread_name"), &name); };
    };
    out.name = name;
    if name.has { out.title = name; } else {
        if !recStrNE(thread_ptr, thread_len, STR_PTR("title"), STR_LEN("title"), &out.title) { recStrNE(thread_ptr, thread_len, STR_PTR("thread_name"), STR_LEN("thread_name"), &out.title); };
    };
    let preview = SStr { bytes: [0u8; 512], len: 0, has: false };
    if !recStrNE(thread_ptr, thread_len, STR_PTR("preview"), STR_LEN("preview"), &preview) { preview = name; };
    if preview.has { displayPromptText(sstrPtrC(&preview), preview.len, &out.preview); };
    recStrNE(thread_ptr, thread_len, STR_PTR("model"), STR_LEN("model"), &out.model);
    recStrNEAlt(thread_ptr, thread_len, STR_PTR("modelProvider"), STR_LEN("modelProvider"), STR_PTR("model_provider"), STR_LEN("model_provider"), &out.modelProvider);
    recStrNEAlt(thread_ptr, thread_len, STR_PTR("parentThreadId"), STR_LEN("parentThreadId"), STR_PTR("parent_thread_id"), STR_LEN("parent_thread_id"), &out.parentThreadId);
    recStrNEAlt(thread_ptr, thread_len, STR_PTR("forkedFromId"), STR_LEN("forkedFromId"), STR_PTR("forked_from_id"), STR_LEN("forked_from_id"), &out.forkedFromId);
    recStrNEAlt(thread_ptr, thread_len, STR_PTR("agentNickname"), STR_LEN("agentNickname"), STR_PTR("agent_nickname"), STR_LEN("agent_nickname"), &out.agentNickname);
    recStrNEAlt(thread_ptr, thread_len, STR_PTR("agentRole"), STR_LEN("agentRole"), STR_PTR("agent_role"), STR_LEN("agent_role"), &out.agentRole);
    out.has_createdAt = recNumAlt(thread_ptr, thread_len, STR_PTR("createdAt"), STR_LEN("createdAt"), STR_PTR("created_at"), STR_LEN("created_at"), &out.createdAt);
    out.has_updatedAt = recNumAlt(thread_ptr, thread_len, STR_PTR("updatedAt"), STR_LEN("updatedAt"), STR_PTR("updated_at"), STR_LEN("updated_at"), &out.updatedAt);
    out.has_recencyAt = recNumAlt(thread_ptr, thread_len, STR_PTR("recencyAt"), STR_LEN("recencyAt"), STR_PTR("recency_at"), STR_LEN("recency_at"), &out.recencyAt);
    let statusVal = JsonBufC { bytes: [0u8; 16384], len: 0 };
    if recVal(thread_ptr, thread_len, STR_PTR("status"), STR_LEN("status"), &statusVal) { threadStatusValue(jsonPtrC(&statusVal), statusVal.len, &out.status); };
    // historyMode
    let hm = SStr { bytes: [0u8; 512], len: 0, has: false };
    recStrNE(thread_ptr, thread_len, STR_PTR("historyMode"), STR_LEN("historyMode"), &hm);
    let paginated = sstrEqLitC(&hm, STR_PTR("paginated"), STR_LEN("paginated"))
        || sstrEqLitC(&backend, STR_PTR("opencode"), STR_LEN("opencode")) || sstrEqLitC(&backend, STR_PTR("mini"), STR_LEN("mini")) || sstrEqLitC(&backend, STR_PTR("grok"), STR_LEN("grok")) || sstrEqLitC(&backend, STR_PTR("muse"), STR_LEN("muse")) || sstrEqLitC(&backend, STR_PTR("pi"), STR_LEN("pi")) || sstrEqLitC(&backend, STR_PTR("claude"), STR_LEN("claude")) || sstrEqLitC(&backend, STR_PTR("agy"), STR_LEN("agy"));
    if paginated { sstrSetLit(&out.historyMode, STR_PTR("paginated"), STR_LEN("paginated")); } else { sstrSetLit(&out.historyMode, STR_PTR("legacy"), STR_LEN("legacy")); };
    recStrNE(thread_ptr, thread_len, STR_PTR("cwd"), STR_LEN("cwd"), &out.cwd);
    let rootsVal = JsonBufC { bytes: [0u8; 16384], len: 0 };
    if recVal(thread_ptr, thread_len, STR_PTR("additionalRoots"), STR_LEN("additionalRoots"), &rootsVal) || recVal(thread_ptr, thread_len, STR_PTR("additional_roots"), STR_LEN("additional_roots"), &rootsVal) {
        stringArrayValueInto(jsonPtrC(&rootsVal), rootsVal.len, &out.additionalRoots, &out.additionalRoots_len);
    };
    let wm = SStr { bytes: [0u8; 512], len: 0, has: false };
    recStrAlt(thread_ptr, thread_len, STR_PTR("workspaceMode"), STR_LEN("workspaceMode"), STR_PTR("workspace_mode"), STR_LEN("workspace_mode"), &wm);
    if sstrEqLitC(&wm, STR_PTR("ssh"), STR_LEN("ssh")) { sstrSetLit(&out.workspaceMode, STR_PTR("ssh"), STR_LEN("ssh")); };
    recStrAlt(thread_ptr, thread_len, STR_PTR("sshCommand"), STR_LEN("sshCommand"), STR_PTR("ssh_command"), STR_LEN("ssh_command"), &out.sshCommand);
    recStrAlt(thread_ptr, thread_len, STR_PTR("sshCwd"), STR_LEN("sshCwd"), STR_PTR("ssh_cwd"), STR_LEN("ssh_cwd"), &out.sshCwd);
    let rem = SStr { bytes: [0u8; 512], len: 0, has: false };
    recStrAlt(thread_ptr, thread_len, STR_PTR("remoteExecutionMode"), STR_LEN("remoteExecutionMode"), STR_PTR("remote_execution_mode"), STR_LEN("remote_execution_mode"), &rem);
    if sstrEqLitC(&rem, STR_PTR("autonomous"), STR_LEN("autonomous")) { sstrSetLit(&out.remoteExecutionMode, STR_PTR("autonomous"), STR_LEN("autonomous")); };
    let rlm = SStr { bytes: [0u8; 512], len: 0, has: false };
    recStrAlt(thread_ptr, thread_len, STR_PTR("remoteLifecycleMode"), STR_LEN("remoteLifecycleMode"), STR_PTR("remote_lifecycle_mode"), STR_LEN("remote_lifecycle_mode"), &rlm);
    if sstrEqLitC(&rlm, STR_PTR("foreground"), STR_LEN("foreground")) { sstrSetLit(&out.remoteLifecycleMode, STR_PTR("foreground"), STR_LEN("foreground")); } else if sstrEqLitC(&rlm, STR_PTR("background"), STR_LEN("background")) { sstrSetLit(&out.remoteLifecycleMode, STR_PTR("background"), STR_LEN("background")); };
    let srcVal = JsonBufC { bytes: [0u8; 16384], len: 0 };
    if recVal(thread_ptr, thread_len, STR_PTR("source"), STR_LEN("source"), &srcVal) || recVal(thread_ptr, thread_len, STR_PTR("thread_source"), STR_LEN("thread_source"), &srcVal) { sourceLabel(jsonPtrC(&srcVal), srcVal.len, &out.source); };
    let tsVal = JsonBufC { bytes: [0u8; 16384], len: 0 };
    if recVal(thread_ptr, thread_len, STR_PTR("threadSource"), STR_LEN("threadSource"), &tsVal) || recVal(thread_ptr, thread_len, STR_PTR("thread_source"), STR_LEN("thread_source"), &tsVal) { sourceLabel(jsonPtrC(&tsVal), tsVal.len, &out.threadSource); };
    if !recStrNE(thread_ptr, thread_len, STR_PTR("path"), STR_LEN("path"), &out.path) { recStrNE(thread_ptr, thread_len, STR_PTR("file_path"), STR_LEN("file_path"), &out.path); };
}

// TS: function threadItemToWorkbenchItem(item): WorkbenchItem | null
fn threadItemToWorkbenchItem(item_ptr: ptr, item_len: u64, out: &WorkbenchItem) -> bool {
    let id = SStr { bytes: [0u8; 512], len: 0, has: false };
    if !recStrNE(item_ptr, item_len, STR_PTR("id"), STR_LEN("id"), &id) { return false; };
    let rawType = SStr { bytes: [0u8; 512], len: 0, has: false };
    if !recStrNE(item_ptr, item_len, STR_PTR("type"), STR_LEN("type"), &rawType) { inferItemType(item_ptr, item_len, &rawType); };
    let ty = SStr { bytes: [0u8; 512], len: 0, has: false };
    normalizeWorkbenchItemType(sstrPtrC(&rawType), rawType.len, item_ptr, item_len, &ty);
    let rawText = BigStrC { bytes: [0u8; 8192], len: 0 };
    itemText(item_ptr, item_len, &rawText);
    let text = BigStrC { bytes: [0u8; 8192], len: 0 };
    sanitizeRelayErrorText(bigPtrC(&rawText), rawText.len, &text);
    if (sstrEqLitC(&ty, STR_PTR("userMessage"), STR_LEN("userMessage")) || sstrEqLitC(&ty, STR_PTR("goalContinuation"), STR_LEN("goalContinuation"))) && isInternalContinuationPrompt(bigPtrC(&text), text.len) { return false; };
    *out = blankWorkbenchItem();
    itemSetId(out, sstrPtrC(&id), id.len);
    itemSetType(out, sstrPtrC(&ty), ty.len);
    let title = SStr { bytes: [0u8; 512], len: 0, has: false };
    itemTitle(item_ptr, item_len, &title);
    itemSetTitle(out, sstrPtrC(&title), title.len);
    itemSetText(out, bigPtrC(&text), text.len);
    itemImagesInto(item_ptr, item_len, out);
    itemFilesInto(item_ptr, item_len, out);
    let status = SStr { bytes: [0u8; 512], len: 0, has: false };
    if recStrNE(item_ptr, item_len, STR_PTR("status"), STR_LEN("status"), &status) { itemSetStatus(out, true, sstrPtrC(&status), status.len); };
    let v: f64 = 0.0;
    if recNumAlt(item_ptr, item_len, STR_PTR("startedAt"), STR_LEN("startedAt"), STR_PTR("started_at"), STR_LEN("started_at"), &v) { out.has_startedAt = true; out.startedAt = v; };
    if recNumAlt(item_ptr, item_len, STR_PTR("firstTokenAt"), STR_LEN("firstTokenAt"), STR_PTR("first_token_at"), STR_LEN("first_token_at"), &v) { out.has_firstTokenAt = true; out.firstTokenAt = v; };
    if recNumAlt(item_ptr, item_len, STR_PTR("updatedAt"), STR_LEN("updatedAt"), STR_PTR("updated_at"), STR_LEN("updated_at"), &v) { out.has_updatedAt = true; out.updatedAt = v; };
    agentItemMetadataInto(item_ptr, item_len, PTR_NULL(), 0, false, out);
    out.has_payload = true;
    let n = item_len;
    if n > 4096 { n = 4096; };
    for j in 0..n { let b: u8 = 0; PTR_BYTE_AT(b, item_ptr, j); out.payload_bytes[j] = b; };
    out.payload_len = n;
    return true;
}

// TS (line 4846): export function turnToWorkbenchTurn(threadId, turn)
fn turnToWorkbenchTurn(threadId: &SStr, turn_ptr: ptr, turn_len: u64, out: &WorkbenchTurn) -> bool {
    let id = SStr { bytes: [0u8; 512], len: 0, has: false };
    if !recStrNE(turn_ptr, turn_len, STR_PTR("id"), STR_LEN("id"), &id) { return false; };
    *out = blankWorkbenchTurn();
    turnSetId(out, sstrPtrC(&id), id.len);
    turnSetThreadId(out, sstrPtrC(threadId), threadId.len);
    let status = SStr { bytes: [0u8; 512], len: 0, has: false };
    if recStrNE(turn_ptr, turn_len, STR_PTR("status"), STR_LEN("status"), &status) { turnSetStatus(out, true, sstrPtrC(&status), status.len); } else { turnSetStatus(out, true, STR_PTR("completed"), STR_LEN("completed")); };
    let v: f64 = 0.0;
    if recNum(turn_ptr, turn_len, STR_PTR("startedAt"), STR_LEN("startedAt"), &v) { out.has_startedAt = true; out.startedAt = v; };
    if recNumAlt(turn_ptr, turn_len, STR_PTR("completedAt"), STR_LEN("completedAt"), STR_PTR("completed_at"), STR_LEN("completed_at"), &v) { out.has_completedAt = true; out.completedAt = v; };
    let itemsVal = JsonBufC { bytes: [0u8; 16384], len: 0 };
    if recVal(turn_ptr, turn_len, STR_PTR("items"), STR_LEN("items"), &itemsVal) {
        let count = arrCount(jsonPtrC(&itemsVal), itemsVal.len);
        for k in 0..count {
            if out.items_len >= 128 { break; };
            let rec = JsonBufC { bytes: [0u8; 16384], len: 0 };
            if !arrElemRec(jsonPtrC(&itemsVal), itemsVal.len, k, &rec) { continue; };
            let item = blankWorkbenchItem();
            if threadItemToWorkbenchItem(jsonPtrC(&rec), rec.len, &item) { out.items_items[out.items_len] = item; out.items_len = out.items_len + 1; };
        }
    };
    return true;
}

// TS (line 4872): export function reviewStartTurnToWorkbenchTurn(reviewThreadId, turn)
fn reviewStartTurnToWorkbenchTurn(reviewThreadId: &SStr, turn_ptr: ptr, turn_len: u64, out: &WorkbenchTurn) -> bool {
    let record = JsonBufC { bytes: [0u8; 16384], len: 0 };
    asRecordC(turn_ptr, turn_len, &record);
    let rp: ptr = jsonPtrC(&record);
    let id = SStr { bytes: [0u8; 512], len: 0, has: false };
    if !recStrNE(rp, record.len, STR_PTR("id"), STR_LEN("id"), &id) { return false; };
    let threadId = SStr { bytes: [0u8; 512], len: 0, has: false };
    if !recStrNE(rp, record.len, STR_PTR("threadId"), STR_LEN("threadId"), &threadId) { threadId = *reviewThreadId; };
    if turnToWorkbenchTurn(&threadId, rp, record.len, out) {
        let status = SStr { bytes: [0u8; 512], len: 0, has: false };
        if !recStrNE(rp, record.len, STR_PTR("status"), STR_LEN("status"), &status) { turnSetStatus(out, true, STR_PTR("inProgress"), STR_LEN("inProgress")); };
        return true;
    };
    // defensive stub (unreachable in TS today, kept as the safety net)
    *out = blankWorkbenchTurn();
    turnSetId(out, sstrPtrC(&id), id.len);
    turnSetThreadId(out, sstrPtrC(&threadId), threadId.len);
    let status = SStr { bytes: [0u8; 512], len: 0, has: false };
    if recStrNE(rp, record.len, STR_PTR("status"), STR_LEN("status"), &status) { turnSetStatus(out, true, sstrPtrC(&status), status.len); } else { turnSetStatus(out, true, STR_PTR("inProgress"), STR_LEN("inProgress")); };
    let v: f64 = 0.0;
    if recNum(rp, record.len, STR_PTR("startedAt"), STR_LEN("startedAt"), &v) { out.has_startedAt = true; out.startedAt = v; };
    return true;
}

// TS (line 4778): export function threadResponseIncludesTranscript(value)
fn threadResponseIncludesTranscript(value_ptr: ptr, value_len: u64) -> bool {
    let root = JsonBufC { bytes: [0u8; 16384], len: 0 };
    asRecordC(value_ptr, value_len, &root);
    let threadVal = JsonBufC { bytes: [0u8; 16384], len: 0 };
    if !recVal(jsonPtrC(&root), root.len, STR_PTR("thread"), STR_LEN("thread"), &threadVal) { return false; };
    let thread = JsonBufC { bytes: [0u8; 16384], len: 0 };
    asRecordC(jsonPtrC(&threadVal), threadVal.len, &thread);
    let turnsVal = JsonBufC { bytes: [0u8; 16384], len: 0 };
    if !recVal(jsonPtrC(&thread), thread.len, STR_PTR("turns"), STR_LEN("turns"), &turnsVal) { return false; };
    return arrCount(jsonPtrC(&turnsVal), turnsVal.len) > 0;
}

// TS (line 4783): export function threadTurnsPageToTurns(threadId, value, sortDirection = "desc")
fn threadTurnsPageToTurns(threadId: &SStr, value_ptr: ptr, value_len: u64, sortDesc: bool, out_turns: &WorkbenchTurnList, out_cursor: &SStr) -> void {
    out_turns.len = 0;
    out_cursor.has = false;
    out_cursor.len = 0;
    let root = JsonBufC { bytes: [0u8; 16384], len: 0 };
    asRecordC(value_ptr, value_len, &root);
    recStrNE(jsonPtrC(&root), root.len, STR_PTR("nextCursor"), STR_LEN("nextCursor"), out_cursor);
    let data = JsonBufC { bytes: [0u8; 16384], len: 0 };
    if !recVal(jsonPtrC(&root), root.len, STR_PTR("data"), STR_LEN("data"), &data) { return; };
    let count = arrCount(jsonPtrC(&data), data.len);
    for idx in 0..count {
        if out_turns.len >= 128 { break; };
        let k = idx;
        if sortDesc { k = count - 1 - idx; };
        let rec = JsonBufC { bytes: [0u8; 16384], len: 0 };
        if !arrElemRec(jsonPtrC(&data), data.len, k, &rec) { continue; };
        let turn = blankWorkbenchTurn();
        if turnToWorkbenchTurn(threadId, jsonPtrC(&rec), rec.len, &turn) { out_turns.turns[out_turns.len] = turn; out_turns.len = out_turns.len + 1; };
    }
}

// TS (line 4351 area): export function threadReadToTurns(value)
fn threadReadToTurns(value_ptr: ptr, value_len: u64, out_thread: &ThreadEntry, out_hasThread: &bool, out_turns: &WorkbenchTurnList) -> void {
    *out_hasThread = false;
    out_turns.len = 0;
    threadEntryClear(out_thread);
    let root = JsonBufC { bytes: [0u8; 16384], len: 0 };
    asRecordC(value_ptr, value_len, &root);
    let threadVal = JsonBufC { bytes: [0u8; 16384], len: 0 };
    if !recVal(jsonPtrC(&root), root.len, STR_PTR("thread"), STR_LEN("thread"), &threadVal) { return; };
    let thread = JsonBufC { bytes: [0u8; 16384], len: 0 };
    asRecordC(jsonPtrC(&threadVal), threadVal.len, &thread);
    let tp: ptr = jsonPtrC(&thread);
    let threadId = SStr { bytes: [0u8; 512], len: 0, has: false };
    if !recStrNE(tp, thread.len, STR_PTR("id"), STR_LEN("id"), &threadId) { return; };
    let turnsVal = JsonBufC { bytes: [0u8; 16384], len: 0 };
    if recVal(tp, thread.len, STR_PTR("turns"), STR_LEN("turns"), &turnsVal) {
        let count = arrCount(jsonPtrC(&turnsVal), turnsVal.len);
        for k in 0..count {
            if out_turns.len >= 128 { break; };
            let rec = JsonBufC { bytes: [0u8; 16384], len: 0 };
            if !arrElemRec(jsonPtrC(&turnsVal), turnsVal.len, k, &rec) { continue; };
            let turn = blankWorkbenchTurn();
            if turnToWorkbenchTurn(&threadId, jsonPtrC(&rec), rec.len, &turn) { out_turns.turns[out_turns.len] = turn; out_turns.len = out_turns.len + 1; };
        }
    };
    threadToEntry(tp, thread.len, out_thread);
    *out_hasThread = true;
}

// ---- composerInputToUserInput (TS line 4303) ----
struct ComposerImageList { items: [ComposerImageAttachment; 32], len: u64 }
struct ComposerMentionList { items: [ComposerMention; 32], len: u64 }

// DEFECT: the returned JsonValue[] is a JSON array text; string values are
// inserted without escaping.
fn composerInputToUserInput(text_ptr: ptr, text_len: u64, images: &ComposerImageList, mentions: &ComposerMentionList, preserveText: bool, out: &JsonBufC) -> void {
    let buf = BigStrC { bytes: [0u8; 8192], len: 0 };
    bigStrAppend(&buf, STR_PTR("["), STR_LEN("["));
    let emitted: u64 = 0;
    let trimmedP: ptr = PTR_NULL();
    let trimmedL: u64 = 0;
    @ts_str_trim(text_ptr, text_len, &trimmedP, &trimmedL);
    // attached file paths: kind == "file" && path, deduped, not in trimmed
    let paths: [SStr; 32] = [SStr { bytes: [0u8; 512], len: 0, has: false }; 32];
    let paths_len: u64 = 0;
    for i in 0..images.len {
        let att = &images.items[i];
        if !att.kind.has || !sstrEqLitC(&att.kind, STR_PTR("file"), STR_LEN("file")) { continue; };
        if !att.path.has || att.path.len == 0 { continue; };
        if bytesContains(trimmedP, trimmedL, sstrPtrC(&att.path), att.path.len) { continue; };
        let dup = false;
        for q in 0..paths_len { if sstrEqC(&paths[q], &att.path) { dup = true; }; };
        if !dup && paths_len < 32 { paths[paths_len] = att.path; paths_len = paths_len + 1; };
    }
    // textValue = [baseText, ...paths].filter(Boolean).join(baseText ? "\n" : "")
    let textValue = BigStrC { bytes: [0u8; 8192], len: 0 };
    if preserveText { bigStrAppend(&textValue, text_ptr, text_len); } else { bigStrAppend(&textValue, trimmedP, trimmedL); };
    let baseNonEmpty = textValue.len > 0;
    for q in 0..paths_len {
        if textValue.len > 0 || baseNonEmpty { bigStrAppend(&textValue, STR_PTR("\n"), STR_LEN("\n")); };
        bigStrAppend(&textValue, sstrPtrC(&paths[q]), paths[q].len);
    }
    if textValue.len > 0 {
        if emitted > 0 { bigStrAppend(&buf, STR_PTR(","), STR_LEN(",")); };
        bigStrAppend(&buf, STR_PTR("{\"type\":\"text\",\"text\":\""), STR_LEN("{\"type\":\"text\",\"text\":\""));
        bigStrAppend(&buf, bigPtrC(&textValue), textValue.len);
        bigStrAppend(&buf, STR_PTR("\",\"text_elements\":[]}"), STR_LEN("\",\"text_elements\":[]}"));
        emitted = emitted + 1;
    };
    for i in 0..mentions.len {
        let mention = &mentions.items[i];
        if !bytesContains(trimmedP, trimmedL, sstrPtrC(&mention.token), mention.token.len) { continue; };
        if emitted > 0 { bigStrAppend(&buf, STR_PTR(","), STR_LEN(",")); };
        if mention.kind.has && sstrEqLitC(&mention.kind, STR_PTR("skill"), STR_LEN("skill")) {
            bigStrAppend(&buf, STR_PTR("{\"type\":\"skill\",\"name\":\""), STR_LEN("{\"type\":\"skill\",\"name\":\""));
        } else {
            bigStrAppend(&buf, STR_PTR("{\"type\":\"mention\",\"name\":\""), STR_LEN("{\"type\":\"mention\",\"name\":\""));
        };
        bigStrAppend(&buf, sstrPtrC(&mention.name), mention.name.len);
        bigStrAppend(&buf, STR_PTR("\",\"path\":\""), STR_LEN("\",\"path\":\""));
        bigStrAppend(&buf, sstrPtrC(&mention.path), mention.path.len);
        bigStrAppend(&buf, STR_PTR("\"}"), STR_LEN("\"}"));
        emitted = emitted + 1;
    }
    for i in 0..images.len {
        let image = &images.items[i];
        let isImageKind = !image.kind.has || sstrEqLitC(&image.kind, STR_PTR("image"), STR_LEN("image"));
        if isImageKind {
            let dp: ptr = PTR_NULL();
            let dl: u64 = 0;
            @ts_str_trim(sstrPtrC(&image.path), image.path.len, &dp, &dl);
            let isData = false;
            if dl >= 5 {
                // /^\s*data:/i on the (already trimmed) path + ";base64,"
                let lower = SStr { bytes: [0u8; 512], len: 0, has: false };
                lowerInto(dp, 5, &lower, false);
                if litEqBuf(sstrPtrC(&lower), 5, STR_PTR("data:"), STR_LEN("data:")) { isData = true; };
            };
            let hasB64 = bytesContains(dp, dl, STR_PTR(";base64,"), STR_LEN(";base64,"));
            if emitted > 0 { bigStrAppend(&buf, STR_PTR(","), STR_LEN(",")); };
            if dl > 0 && !isData && !hasB64 {
                bigStrAppend(&buf, STR_PTR("{\"type\":\"localImage\",\"path\":\""), STR_LEN("{\"type\":\"localImage\",\"path\":\""));
                bigStrAppend(&buf, dp, dl);
                bigStrAppend(&buf, STR_PTR("\",\"detail\":\"auto\"}"), STR_LEN("\",\"detail\":\"auto\"}"));
            } else {
                bigStrAppend(&buf, STR_PTR("{\"type\":\"text\",\"text\":\"[Attached image \\\""), STR_LEN("{\"type\":\"text\",\"text\":\"[Attached image \\\""));
                bigStrAppend(&buf, sstrPtrC(&image.name), image.name.len);
                bigStrAppend(&buf, STR_PTR("\\\" was omitted: upload it first so only a disk path is sent]\",\"text_elements\":[]}"), STR_LEN("\\\" was omitted: upload it first so only a disk path is sent]\",\"text_elements\":[]}"));
            };
            emitted = emitted + 1;
            continue;
        };
        if image.path.has && image.path.len > 0 {
            if emitted > 0 { bigStrAppend(&buf, STR_PTR(","), STR_LEN(",")); };
            bigStrAppend(&buf, STR_PTR("{\"type\":\"mention\",\"name\":\""), STR_LEN("{\"type\":\"mention\",\"name\":\""));
            bigStrAppend(&buf, sstrPtrC(&image.name), image.name.len);
            bigStrAppend(&buf, STR_PTR("\",\"path\":\""), STR_LEN("\",\"path\":\""));
            bigStrAppend(&buf, sstrPtrC(&image.path), image.path.len);
            bigStrAppend(&buf, STR_PTR("\"}"), STR_LEN("\"}"));
            emitted = emitted + 1;
            continue;
        };
        if emitted > 0 { bigStrAppend(&buf, STR_PTR(","), STR_LEN(",")); };
        bigStrAppend(&buf, STR_PTR("{\"type\":\"text\",\"text\":\"[Attached file: "), STR_LEN("{\"type\":\"text\",\"text\":\"[Attached file: "));
        bigStrAppend(&buf, sstrPtrC(&image.name), image.name.len);
        bigStrAppend(&buf, STR_PTR(" ("), STR_LEN(" ("));
        if image.mediaType.has && image.mediaType.len > 0 { bigStrAppend(&buf, sstrPtrC(&image.mediaType), image.mediaType.len); } else { bigStrAppend(&buf, STR_PTR("application/octet-stream"), STR_LEN("application/octet-stream")); };
        bigStrAppend(&buf, STR_PTR(", "), STR_LEN(", "));
        bigStrAppendU64(&buf, image.size as u64);
        // DEFECT: size is a JS number; fractional sizes are truncated here
        bigStrAppend(&buf, STR_PTR(" bytes)]\",\"text_elements\":[]}"), STR_LEN(" bytes)]\",\"text_elements\":[]}"));
        emitted = emitted + 1;
    }
    bigStrAppend(&buf, STR_PTR("]"), STR_LEN("]"));
    jsonBufSetC(out, bigPtrC(&buf), buf.len);
}

// ---- usage / gateway / analytics / launch adapters (TS lines 5354-5880) ----
// AuthUser and UsageSummary are imported types from @codex-ui/shared in TS;
// they are carried as raw JSON here (see the header DEFECT).
struct AuthUser { raw_json: JsonBufC }
struct UsageSummary { raw_json: JsonBufC }

// TS: function gatewayParams(options): string
// Iterates the options record in key order; skips undefined and "" values;
// each value is String(value) then URL-encoded (URLSearchParams semantics
// approximated by urlEncodeComponent).
fn gatewayParams(options_ptr: ptr, options_len: u64, out: &BigStrC) -> void {
    out.len = 0;
    let count = sa_json_object_key_count(options_ptr, options_len);
    let first = true;
    for k in 0..count {
        let kp: ptr = PTR_NULL();
        let kl: u64 = 0;
        if sa_json_object_key_at(options_ptr, options_len, k, &kp, &kl) != 0 { continue; };
        let vv = JsonBufC { bytes: [0u8; 16384], len: 0 };
        if !recVal(options_ptr, options_len, kp, kl, &vv) { continue; };
        // skip null (undefined) and empty string
        if vv.len == 4 && litEqBuf(jsonPtrC(&vv), 4, STR_PTR("null"), STR_LEN("null")) { continue; };
        let vs = SStr { bytes: [0u8; 512], len: 0, has: false };
        let valueText = BigStrC { bytes: [0u8; 8192], len: 0 };
        if jsonValueStr(jsonPtrC(&vv), vv.len, &vs) {
            if vs.len == 0 { continue; };
            bigStrAppend(&valueText, sstrPtrC(&vs), vs.len);
        } else { bigStrAppend(&valueText, jsonPtrC(&vv), vv.len); };
        if first { bigStrAppend(out, STR_PTR("?"), STR_LEN("?")); first = false; } else { bigStrAppend(out, STR_PTR("&"), STR_LEN("&")); };
        let enc = BigStrC { bytes: [0u8; 8192], len: 0 };
        urlEncodeComponent(kp, kl, &enc);
        bigStrAppend(out, bigPtrC(&enc), enc.len);
        bigStrAppend(out, STR_PTR("="), STR_LEN("="));
        enc.len = 0;
        urlEncodeComponent(bigPtrC(&valueText), valueText.len, &enc);
        bigStrAppend(out, bigPtrC(&enc), enc.len);
    }
}

// options record assembly helper for the gateway fetches: numeric field
fn optNumField(buf: &BigStrC, first: &bool, key_ptr: ptr, key_len: u64, present: bool, value: f64) -> void {
    if !present { return; };
    if !*first { bigStrAppend(buf, STR_PTR(","), STR_LEN(",")); };
    *first = false;
    bigStrAppend(buf, STR_PTR("\""), STR_LEN("\""));
    bigStrAppend(buf, key_ptr, key_len);
    bigStrAppend(buf, STR_PTR("\":"), STR_LEN("\":"));
    // DEFECT: number formatting via integer cast (option values are counts)
    if value < 0.0 { bigStrAppend(buf, STR_PTR("-"), STR_LEN("-")); bigStrAppendU64(buf, (0.0 - value) as u64); } else { bigStrAppendU64(buf, value as u64); };
}
fn optStrField(buf: &BigStrC, first: &bool, key_ptr: ptr, key_len: u64, value: &SStr) -> void {
    if !value.has { return; };
    if !*first { bigStrAppend(buf, STR_PTR(","), STR_LEN(",")); };
    *first = false;
    bigStrAppend(buf, STR_PTR("\""), STR_LEN("\""));
    bigStrAppend(buf, key_ptr, key_len);
    bigStrAppend(buf, STR_PTR("\":\""), STR_LEN("\":\""));
    bigStrAppend(buf, sstrPtrC(value), value.len);
    bigStrAppend(buf, STR_PTR("\""), STR_LEN("\""));
}

// shared GET helper for this section: fetch, !ok -> err message, else the
// body.data payload (or [] / fallback per call site flags)
// DEFECT: async (see header note)
fn gatewayGet(token: &SStr, url: &BigStrC, errPrefix_ptr: ptr, errPrefix_len: u64, out: &JsonBufC, err: &SStr) -> i32 {
    let resp = HttpResponse { status: 0, body: JsonBufC { bytes: [0u8; 16384], len: 0 } };
    let rc = httpFetchJson(STR_PTR("GET"), STR_LEN("GET"), bigPtrC(url), url.len, sstrPtrC(token), token.len, false, PTR_NULL(), 0, &resp);
    if rc != 0 { sstrSet(err, errPrefix_ptr, errPrefix_len); return 1; };
    if resp.status < 200 || resp.status >= 300 {
        // `Failed to load ...: ${status}`
        let msg = BigStrC { bytes: [0u8; 8192], len: 0 };
        bigStrAppend(&msg, errPrefix_ptr, errPrefix_len);
        bigStrAppend(&msg, STR_PTR(": "), STR_LEN(": "));
        bigStrAppendU64(&msg, resp.status);
        sstrSet(err, bigPtrC(&msg), msg.len);
        return 1;
    };
    let bp: ptr = jsonPtrC(&resp.body);
    if !recVal(bp, resp.body.len, STR_PTR("data"), STR_LEN("data"), out) { jsonBufSetC(out, STR_PTR("null"), STR_LEN("null")); };
    return 0;
}

// TS (line 5354): export async function fetchUsageSummary(token, options?)
fn fetchUsageSummary(token: &SStr, hasDays: bool, days: f64, userId: &SStr, out: &UsageSummary, err: &SStr) -> i32 {
    let options = BigStrC { bytes: [0u8; 8192], len: 0 };
    bigStrAppend(&options, STR_PTR("{"), STR_LEN("{"));
    let first = true;
    optNumField(&options, &first, STR_PTR("days"), STR_LEN("days"), hasDays, days);
    optStrField(&options, &first, STR_PTR("userId"), STR_LEN("userId"), userId);
    bigStrAppend(&options, STR_PTR("}"), STR_LEN("}"));
    let qs = BigStrC { bytes: [0u8; 8192], len: 0 };
    gatewayParams(bigPtrC(&options), options.len, &qs);
    let url = BigStrC { bytes: [0u8; 8192], len: 0 };
    bigStrAppend(&url, STR_PTR("/api/usage/summary"), STR_LEN("/api/usage/summary"));
    bigStrAppend(&url, bigPtrC(&qs), qs.len);
    return gatewayGet(token, &url, STR_PTR("Failed to load usage summary"), STR_LEN("Failed to load usage summary"), &out.raw_json, err);
}

