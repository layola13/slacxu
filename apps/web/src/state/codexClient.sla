// Returns 0="healthy", 1="probe", 2="close".
fn evaluateHeartbeatState(now: f64, lastServerActivityAt: f64, hasProbeStartedAt: bool, probeStartedAt: f64, runtime: &WebSocketRuntimeConfig, visible: bool) -> u64 {
    if now - lastServerActivityAt <= runtime.heartbeatTimeoutMs { return 0; };
    if !hasProbeStartedAt { return 1; };
    let baseGraceMs = runtime.heartbeatIntervalMs * 2.0;
    if baseGraceMs < 5000.0 { baseGraceMs = 5000.0; };
    let busyVisibleGraceMs = baseGraceMs;
