    bigStrAppend(&b, STR_PTR("{\"command\":\""), STR_LEN("{\"command\":\""));
    bigStrAppend(&b, command_ptr, command_len);
    bigStrAppend(&b, STR_PTR("\",\""), STR_LEN("\",\""));
    bigStrAppend(&b, key2_ptr, key2_len);
    bigStrAppend(&b, STR_PTR("\":\""), STR_LEN("\":\""));
    bigStrAppend(&b, value2_ptr, value2_len);
    bigStrAppend(&b, STR_PTR("\""), STR_LEN("\""));
    if hasThird {
        bigStrAppend(&b, STR_PTR(",\""), STR_LEN(",\""));
        bigStrAppend(&b, key3_ptr, key3_len);
        bigStrAppend(&b, STR_PTR("\":\""), STR_LEN("\":\""));
        bigStrAppend(&b, value3_ptr, value3_len);
        bigStrAppend(&b, STR_PTR("\""), STR_LEN("\""));
    };
    bigStrAppend(&b, STR_PTR("}"), STR_LEN("}"));
    let bp: ptr = PTR_NULL();
    PTR_BYTE_ADD(bp, &b.bytes, 0);
    jsonBufSetC(out, bp, b.len);
}

