// TS (line 1728): export async function fetchCliInstallations(token, kinds?)
// DEFECT: async; kinds array arrives pre-joined with "," (TS kinds.join(",")).
fn fetchCliInstallations(token_ptr: ptr, token_len: u64, hasKinds: bool, kindsJoined_ptr: ptr, kindsJoined_len: u64, out: &CliInstallationsStatus, err: &SStr) -> i32 {
    let url = BigStrC { bytes: [0u8; 8192], len: 0 };
    bigStrAppend(&url, STR_PTR("/api/cli/installations"), STR_LEN("/api/cli/installations"));
    if hasKinds && kindsJoined_len > 0 {
        bigStrAppend(&url, STR_PTR("?kinds="), STR_LEN("?kinds="));
        let enc = BigStrC { bytes: [0u8; 8192], len: 0 };
        urlEncodeComponent(kindsJoined_ptr, kindsJoined_len, &enc);
        let ep: ptr = PTR_NULL();
        PTR_BYTE_ADD(ep, &enc.bytes, 0);
        bigStrAppend(&url, ep, enc.len);
    };
    let up: ptr = PTR_NULL();
    PTR_BYTE_ADD(up, &url.bytes, 0);
    let resp = HttpResponse { status: 0, body: JsonBufC { bytes: [0u8; 16384], len: 0 } };
    let rc = fetchWithClientTimeout(STR_PTR("GET"), STR_LEN("GET"), up, url.len, true, token_ptr, token_len, false, STR_PTR(""), 0, 30000.0, STR_PTR("Timed out detecting CLI installations"), STR_LEN("Timed out detecting CLI installations"), &resp, err);
    if rc != 0 { return 1; };
    let data = JsonBufC { bytes: [0u8; 16384], len: 0 };
    if !fetchDataField(&resp, err, STR_PTR("Failed to detect CLI installations"), STR_LEN("Failed to detect CLI installations"), &data) { return 1; };
    jsonBufCopyC(&out.raw_json, &data);
    return 0;
}

