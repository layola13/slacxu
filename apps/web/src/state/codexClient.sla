fn sshMutationBody(command_ptr: ptr, command_len: u64, key2_ptr: ptr, key2_len: u64, value2_ptr: ptr, value2_len: u64, hasThird: bool, key3_ptr: ptr, key3_len: u64, value3_ptr: ptr, value3_len: u64, out: &JsonBufC) -> void {
