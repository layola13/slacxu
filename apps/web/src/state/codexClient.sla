fn fetchGatewayAnalyticsDaily(token: &SStr, options_json_ptr: ptr, options_json_len: u64, out: &JsonBufC, err: &SStr) -> i32 {
    return fetchGatewayAnalytics(token, options_json_ptr, options_json_len, out, err);
}
fn fetchGatewayAnalyticsDimension(token: &SStr, options_json_ptr: ptr, options_json_len: u64, out: &JsonBufC, err: &SStr) -> i32 {
    return fetchGatewayAnalytics(token, options_json_ptr, options_json_len, out, err);
}

// TS: export type GatewayPerformanceRow (confidence union kept as text)
struct GatewayPerformanceRow { name: SStr, providerId: SStr, requestCount: f64, avgLatencyMs: f64, avgTtftMs: f64, totalLatencyMs: f64, has_p50LatencyMs: bool, p50LatencyMs: f64, has_p95LatencyMs: bool, p95LatencyMs: f64, tokensTotal: f64, throughput: f64, confidence: SStr }

// TS: export async function fetchGatewayPerformance(token, options)
fn fetchGatewayPerformance(token: &SStr, dimension: &SStr, hasDays: bool, days: f64, hasLimit: bool, limit: f64, userId: &SStr, out: &JsonBufC, err: &SStr) -> i32 {
    let options = BigStrC { bytes: [0u8; 8192], len: 0 };
    bigStrAppend(&options, STR_PTR("{"), STR_LEN("{"));
    let first = true;
    optStrField(&options, &first, STR_PTR("dimension"), STR_LEN("dimension"), dimension);
    optNumField(&options, &first, STR_PTR("days"), STR_LEN("days"), hasDays, days);
    optNumField(&options, &first, STR_PTR("limit"), STR_LEN("limit"), hasLimit, limit);
    optStrField(&options, &first, STR_PTR("userId"), STR_LEN("userId"), userId);
    bigStrAppend(&options, STR_PTR("}"), STR_LEN("}"));
    let qs = BigStrC { bytes: [0u8; 8192], len: 0 };
    gatewayParams(bigPtrC(&options), options.len, &qs);
    let url = BigStrC { bytes: [0u8; 8192], len: 0 };
    bigStrAppend(&url, STR_PTR("/api/gateway/performance"), STR_LEN("/api/gateway/performance"));
    bigStrAppend(&url, bigPtrC(&qs), qs.len);
    let rc = gatewayGet(token, &url, STR_PTR("Failed to load gateway performance"), STR_LEN("Failed to load gateway performance"), out, err);
    if rc == 0 && out.len == 4 && litEqBuf(jsonPtrC(out), 4, STR_PTR("null"), STR_LEN("null")) { jsonBufSetC(out, STR_PTR("[]"), STR_LEN("[]")); };
    return rc;
}

// TS: export async function changeOwnPassword(token, input)
fn changeOwnPassword(token: &SStr, input_json_ptr: ptr, input_json_len: u64, out: &AuthUser, err: &SStr) -> i32 {
    let resp = HttpResponse { status: 0, body: JsonBufC { bytes: [0u8; 16384], len: 0 } };
    let rc = httpFetchJson(STR_PTR("POST"), STR_LEN("POST"), STR_PTR("/api/me/password"), STR_LEN("/api/me/password"), sstrPtrC(token), token.len, true, input_json_ptr, input_json_len, &resp);
    if rc != 0 { sstrSetLit(err, STR_PTR("Password change failed"), STR_LEN("Password change failed")); return 1; };
    let bp: ptr = jsonPtrC(&resp.body);
    if resp.status < 200 || resp.status >= 300 {
        let bodyErr = SStr { bytes: [0u8; 512], len: 0, has: false };
        if recStrNE(bp, resp.body.len, STR_PTR("error"), STR_LEN("error"), &bodyErr) { *err = bodyErr; } else {
            let msg = BigStrC { bytes: [0u8; 8192], len: 0 };
            bigStrAppend(&msg, STR_PTR("Password change failed ("), STR_LEN("Password change failed ("));
            bigStrAppendU64(&msg, resp.status);
            bigStrAppend(&msg, STR_PTR(")"), STR_LEN(")"));
            sstrSet(err, bigPtrC(&msg), msg.len);
        };
        return 1;
    };
    if !recVal(bp, resp.body.len, STR_PTR("data"), STR_LEN("data"), &out.raw_json) { sstrSetLit(err, STR_PTR("Password change failed"), STR_LEN("Password change failed")); return 1; };
    return 0;
}

// TS: export type LaunchEnvValues / LaunchAdapterStatus /
// LaunchAdaptersDetectResponse / InstallLaunchResultItem
struct LaunchEnvValues { baseUrl: SStr, model: SStr, apiKey: SStr }
struct LaunchEnvPreview { baseUrl: SStr, model: SStr, hasApiKey: bool }
struct LaunchAdapterStatus {
    id: SStr,
    repo: SStr,
    cloneUrl: SStr,
    cloneable: bool,
    installed: bool,
    wrapperPath: SStr,
    productCliPath: SStr,
    productCliPresent: bool,
    sourceDir: SStr,
    sourcePresent: bool,
    envPath: SStr,
    envPresent: bool,
    envConfigured: bool,
    envPreview: LaunchEnvPreview,
    needsInstall: bool,
    has_needsSetup: bool,
    needsSetup: bool,
}
struct LaunchAdaptersDetectResponse { raw_json: JsonBufC }
struct InstallLaunchResultItem { raw_json: JsonBufC }

// TS: export async function fetchLaunchAdapters(token)
// (the response body IS the payload here, not body.data)
fn fetchLaunchAdapters(token: &SStr, out: &LaunchAdaptersDetectResponse, err: &SStr) -> i32 {
    let resp = HttpResponse { status: 0, body: JsonBufC { bytes: [0u8; 16384], len: 0 } };
    let rc = httpFetchJson(STR_PTR("GET"), STR_LEN("GET"), STR_PTR("/api/launch-adapters"), STR_LEN("/api/launch-adapters"), sstrPtrC(token), token.len, false, PTR_NULL(), 0, &resp);
    if rc != 0 { sstrSetLit(err, STR_PTR("Failed to detect launch adapters"), STR_LEN("Failed to detect launch adapters")); return 1; };
    if resp.status < 200 || resp.status >= 300 {
        let bodyErr = SStr { bytes: [0u8; 512], len: 0, has: false };
        let bp: ptr = jsonPtrC(&resp.body);
        if recStrNE(bp, resp.body.len, STR_PTR("error"), STR_LEN("error"), &bodyErr) { *err = bodyErr; } else {
            let msg = BigStrC { bytes: [0u8; 8192], len: 0 };
            bigStrAppend(&msg, STR_PTR("Failed to detect launch adapters: "), STR_LEN("Failed to detect launch adapters: "));
            bigStrAppendU64(&msg, resp.status);
            sstrSet(err, bigPtrC(&msg), msg.len);
        };
        return 1;
    };
    jsonBufCopyC(&out.raw_json, &resp.body);
    return 0;
}

// TS: export async function installLaunchAdapters(token, input, onProgress?)
// DEFECT: async job polling — the TS while loop sleeps 350 ms between
// job-status polls with a 10-minute wall-clock budget. Here the poll loop
// is bounded by accumulated waited milliseconds via the assumed
// sa_sleep_ms extern, and onProgress callbacks are recorded into
// out_lastLogs instead of being invoked.
fn installLaunchAdapters(token: &SStr, input_json_ptr: ptr, input_json_len: u64, out_results: &JsonBufC, out_adapters: &JsonBufC, out_lastLogs: &JsonBufC, err: &SStr) -> i32 {
    let resp = HttpResponse { status: 0, body: JsonBufC { bytes: [0u8; 16384], len: 0 } };
    let rc = httpFetchJson(STR_PTR("POST"), STR_LEN("POST"), STR_PTR("/api/launch-adapters/install"), STR_LEN("/api/launch-adapters/install"), sstrPtrC(token), token.len, true, input_json_ptr, input_json_len, &resp);
    if rc != 0 { sstrSetLit(err, STR_PTR("Install failed"), STR_LEN("Install failed")); return 1; };
    let bp: ptr = jsonPtrC(&resp.body);
    if resp.status < 200 || resp.status >= 300 {
        let bodyErr = SStr { bytes: [0u8; 512], len: 0, has: false };
        if recStrNE(bp, resp.body.len, STR_PTR("error"), STR_LEN("error"), &bodyErr) { *err = bodyErr; } else {
            let msg = BigStrC { bytes: [0u8; 8192], len: 0 };
            bigStrAppend(&msg, STR_PTR("Install failed: "), STR_LEN("Install failed: "));
            bigStrAppendU64(&msg, resp.status);
            sstrSet(err, bigPtrC(&msg), msg.len);
        };
        return 1;
    };
    jsonBufSetC(out_results, STR_PTR("[]"), STR_LEN("[]"));
    jsonBufSetC(out_adapters, STR_PTR("[]"), STR_LEN("[]"));
    out_lastLogs.len = 0;
    let results = JsonBufC { bytes: [0u8; 16384], len: 0 };
    if recVal(bp, resp.body.len, STR_PTR("results"), STR_LEN("results"), &results) {
        jsonBufCopyC(out_results, &results);
        let adapters = JsonBufC { bytes: [0u8; 16384], len: 0 };
        if recVal(bp, resp.body.len, STR_PTR("adapters"), STR_LEN("adapters"), &adapters) { jsonBufCopyC(out_adapters, &adapters); };
        return 0;
    };
    let jobId = SStr { bytes: [0u8; 512], len: 0, has: false };
    if !recStrNE(bp, resp.body.len, STR_PTR("jobId"), STR_LEN("jobId"), &jobId) {
        sstrSetLit(err, STR_PTR("Server did not return a valid installation job ID."), STR_LEN("Server did not return a valid installation job ID."));
        return 1;
    };
    let waitedMs: u64 = 0;
    while waitedMs < 600000 {
        sa_sleep_ms(350);
        waitedMs = waitedMs + 350;
        let url = BigStrC { bytes: [0u8; 8192], len: 0 };
        bigStrAppend(&url, STR_PTR("/api/launch-adapters/job-status?jobId="), STR_LEN("/api/launch-adapters/job-status?jobId="));
        let enc = BigStrC { bytes: [0u8; 8192], len: 0 };
        urlEncodeComponent(sstrPtrC(&jobId), jobId.len, &enc);
        bigStrAppend(&url, bigPtrC(&enc), enc.len);
        let statusResp = HttpResponse { status: 0, body: JsonBufC { bytes: [0u8; 16384], len: 0 } };
        let rc2 = httpFetchJson(STR_PTR("GET"), STR_LEN("GET"), bigPtrC(&url), url.len, sstrPtrC(token), token.len, false, PTR_NULL(), 0, &statusResp);
        if rc2 != 0 { continue; };
        if statusResp.status < 200 || statusResp.status >= 300 { continue; };
        let sp: ptr = jsonPtrC(&statusResp.body);
        let logs = JsonBufC { bytes: [0u8; 16384], len: 0 };
        if recVal(sp, statusResp.body.len, STR_PTR("logs"), STR_LEN("logs"), &logs) {
            if arrCount(jsonPtrC(&logs), logs.len) > 0 { jsonBufCopyC(out_lastLogs, &logs); };
        };
        let status = SStr { bytes: [0u8; 512], len: 0, has: false };
        recStrNE(sp, statusResp.body.len, STR_PTR("status"), STR_LEN("status"), &status);
        if sstrEqLitC(&status, STR_PTR("completed"), STR_LEN("completed")) {
            let r2 = JsonBufC { bytes: [0u8; 16384], len: 0 };
            if recVal(sp, statusResp.body.len, STR_PTR("results"), STR_LEN("results"), &r2) { jsonBufCopyC(out_results, &r2); };
            let a2 = JsonBufC { bytes: [0u8; 16384], len: 0 };
            if recVal(sp, statusResp.body.len, STR_PTR("adapters"), STR_LEN("adapters"), &a2) { jsonBufCopyC(out_adapters, &a2); };
            return 0;
        };
        if sstrEqLitC(&status, STR_PTR("failed"), STR_LEN("failed")) {
            let bodyErr = SStr { bytes: [0u8; 512], len: 0, has: false };
            if recStrNE(sp, statusResp.body.len, STR_PTR("error"), STR_LEN("error"), &bodyErr) { *err = bodyErr; } else { sstrSetLit(err, STR_PTR("Installation job failed on server."), STR_LEN("Installation job failed on server.")); };
            return 1;
        };
    }
    sstrSetLit(err, STR_PTR("Installation job timed out after 10 minutes."), STR_LEN("Installation job timed out after 10 minutes."));
    return 1;
}

// TS: export async function writeLaunchAdapterEnvs(token, input)
fn writeLaunchAdapterEnvs(token: &SStr, input_json_ptr: ptr, input_json_len: u64, out_results: &JsonBufC, out_adapters: &JsonBufC, err: &SStr) -> i32 {
    let resp = HttpResponse { status: 0, body: JsonBufC { bytes: [0u8; 16384], len: 0 } };
    let rc = httpFetchJson(STR_PTR("POST"), STR_LEN("POST"), STR_PTR("/api/launch-adapters/env"), STR_LEN("/api/launch-adapters/env"), sstrPtrC(token), token.len, true, input_json_ptr, input_json_len, &resp);
    if rc != 0 { sstrSetLit(err, STR_PTR("Write env failed"), STR_LEN("Write env failed")); return 1; };
    let bp: ptr = jsonPtrC(&resp.body);
    if resp.status < 200 || resp.status >= 300 {
        let bodyErr = SStr { bytes: [0u8; 512], len: 0, has: false };
        if recStrNE(bp, resp.body.len, STR_PTR("error"), STR_LEN("error"), &bodyErr) { *err = bodyErr; } else {
            let msg = BigStrC { bytes: [0u8; 8192], len: 0 };
            bigStrAppend(&msg, STR_PTR("Write env failed: "), STR_LEN("Write env failed: "));
            bigStrAppendU64(&msg, resp.status);
            sstrSet(err, bigPtrC(&msg), msg.len);
        };
        return 1;
    };
    jsonBufSetC(out_results, STR_PTR("[]"), STR_LEN("[]"));
    jsonBufSetC(out_adapters, STR_PTR("[]"), STR_LEN("[]"));
    let r2 = JsonBufC { bytes: [0u8; 16384], len: 0 };
    if recVal(bp, resp.body.len, STR_PTR("results"), STR_LEN("results"), &r2) { jsonBufCopyC(out_results, &r2); };
    let a2 = JsonBufC { bytes: [0u8; 16384], len: 0 };
    if recVal(bp, resp.body.len, STR_PTR("adapters"), STR_LEN("adapters"), &a2) { jsonBufCopyC(out_adapters, &a2); };
    return 0;
}

// TS: export async function testLaunchAdapterModel(token, env)
// (never throws on HTTP errors; a transport failure is reported as
// ok=false with an "HTTP 0" message — DEFECT: TS would reject instead)
struct TestLaunchAdapterModelResult { ok: bool, has_step1Ok: bool, step1Ok: bool, has_step2Ok: bool, step2Ok: bool, message: SStr, has_statusCode: bool, statusCode: f64 }
fn testLaunchAdapterModel(token: &SStr, env_json_ptr: ptr, env_json_len: u64, out: &TestLaunchAdapterModelResult) -> void {
    out.ok = false;
    out.has_step1Ok = false; out.step1Ok = false;
    out.has_step2Ok = false; out.step2Ok = false;
    out.message.has = false; out.message.len = 0;
    out.has_statusCode = false; out.statusCode = 0.0;
    let resp = HttpResponse { status: 0, body: JsonBufC { bytes: [0u8; 16384], len: 0 } };
    let rc = httpFetchJson(STR_PTR("POST"), STR_LEN("POST"), STR_PTR("/api/launch-adapters/test-model"), STR_LEN("/api/launch-adapters/test-model"), sstrPtrC(token), token.len, true, env_json_ptr, env_json_len, &resp);
    if rc != 0 {
        out.ok = false;
        sstrSetLit(&out.message, STR_PTR("HTTP 0"), STR_LEN("HTTP 0"));
        out.has_statusCode = true;
        out.statusCode = 0.0;
        return;
    };
    let bp: ptr = jsonPtrC(&resp.body);
    let okBody = false;
    let hasOk = recBool(bp, resp.body.len, STR_PTR("ok"), STR_LEN("ok"), &okBody);
    if hasOk { out.ok = okBody; } else { out.ok = resp.status >= 200 && resp.status < 300; };
    let b = false;
    if recBool(bp, resp.body.len, STR_PTR("step1Ok"), STR_LEN("step1Ok"), &b) { out.has_step1Ok = true; out.step1Ok = b; };
    if recBool(bp, resp.body.len, STR_PTR("step2Ok"), STR_LEN("step2Ok"), &b) { out.has_step2Ok = true; out.step2Ok = b; };
    let message = SStr { bytes: [0u8; 512], len: 0, has: false };
    if recStr(bp, resp.body.len, STR_PTR("message"), STR_LEN("message"), &message) && message.len > 0 { out.message = message; } else {
        if resp.status >= 200 && resp.status < 300 { sstrSetLit(&out.message, STR_PTR("Test succeeded"), STR_LEN("Test succeeded")); } else {
            let msg = BigStrC { bytes: [0u8; 8192], len: 0 };
            bigStrAppend(&msg, STR_PTR("HTTP "), STR_LEN("HTTP "));
            bigStrAppendU64(&msg, resp.status);
            sstrSet(&out.message, bigPtrC(&msg), msg.len);
        };
    };
    let code: f64 = 0.0;
    if recNum(bp, resp.body.len, STR_PTR("statusCode"), STR_LEN("statusCode"), &code) { out.has_statusCode = true; out.statusCode = code; } else { out.has_statusCode = true; out.statusCode = resp.status as f64; };
}
