// TS: export function dangerousConfirmationMatches(value)
fn dangerousConfirmationMatches(value_ptr: ptr, value_len: u64) -> bool {
    let tp: ptr = PTR_NULL();
    let tl: u64 = 0;
    @ts_str_trim(value_ptr, value_len, &tp, &tl);
    let target = SStr { bytes: [0u8; 512], len: 0, has: false };
    dangerConfirmationText(&target);
    return litEqBuf(tp, tl, sstrPtrC(&target), target.len);
}

// ---- value helpers + converters + parsers (TS lines 4351-5353) ----
struct JsonRef { p: ptr, l: u64 }

// stringValue on a record field: string AND non-empty (TS stringValue)
fn recStrNE(obj_ptr: ptr, obj_len: u64, key_ptr: ptr, key_len: u64, out: &SStr) -> bool {
    if !recStr(obj_ptr, obj_len, key_ptr, key_len, out) { return false; };
    if out.len == 0 { out.has = false; return false; };
    return true;
}

fn recStrNEAlt(obj_ptr: ptr, obj_len: u64, k1_ptr: ptr, k1_len: u64, k2_ptr: ptr, k2_len: u64, out: &SStr) -> bool {
    if recStrNE(obj_ptr, obj_len, k1_ptr, k1_len, out) { return true; };
    return recStrNE(obj_ptr, obj_len, k2_ptr, k2_len, out);
}

// numberValue / boolValue on an arbitrary JSON value text
fn numberValueText(value_ptr: ptr, value_len: u64, out: &f64) -> bool {
    let kind: u64 = 0;
    let tp: ptr = PTR_NULL();
    let tl: u64 = 0;
    let num: f64 = 0.0;
    let boolean = false;
    sa_json_parse_scalar(value_ptr, value_len, &kind, &tp, &tl, &num, &boolean);
    if kind != 2 { return false; };
    *out = num;
    return true;
}

fn boolValueText(value_ptr: ptr, value_len: u64, out: &bool) -> bool {
    let kind: u64 = 0;
    let tp: ptr = PTR_NULL();
    let tl: u64 = 0;
    let num: f64 = 0.0;
    let boolean = false;
    sa_json_parse_scalar(value_ptr, value_len, &kind, &tp, &tl, &num, &boolean);
    if kind != 3 { return false; };
    *out = boolean;
    return true;
}

// TS: function stringValue(value) — non-empty strings only
fn stringValueText(value_ptr: ptr, value_len: u64, out: &SStr) -> bool {
    if !jsonValueStr(value_ptr, value_len, out) { return false; };
    if out.len == 0 { out.has = false; return false; };
    return true;
}

// TS: function threadStatusValue(value)
fn threadStatusValue(value_ptr: ptr, value_len: u64, out: &SStr) -> void {
    if stringValueText(value_ptr, value_len, out) { return; };
    let rec = JsonBufC { bytes: [0u8; 16384], len: 0 };
    asRecordC(value_ptr, value_len, &rec);
    if recStrNE(jsonPtrC(&rec), rec.len, STR_PTR("type"), STR_LEN("type"), out) { return; };
    out.has = false;
    out.len = 0;
}

// TS: function sourceLabel(value)
fn sourceLabel(value_ptr: ptr, value_len: u64, out: &SStr) -> void {
    if stringValueText(value_ptr, value_len, out) { return; };
    let rec = JsonBufC { bytes: [0u8; 16384], len: 0 };
    asRecordC(value_ptr, value_len, &rec);
    let rp: ptr = jsonPtrC(&rec);
    let ty = SStr { bytes: [0u8; 512], len: 0, has: false };
    recStrNE(rp, rec.len, STR_PTR("type"), STR_LEN("type"), &ty);
    if sstrEqLitC(&ty, STR_PTR("local"), STR_LEN("local")) {
        if recStrNE(rp, rec.len, STR_PTR("path"), STR_LEN("path"), out) { return; };
        sstrSetLit(out, STR_PTR("local"), STR_LEN("local"));
        return;
    };
    if sstrEqLitC(&ty, STR_PTR("git"), STR_LEN("git")) {
        if recStrNE(rp, rec.len, STR_PTR("url"), STR_LEN("url"), out) { return; };
        sstrSetLit(out, STR_PTR("git"), STR_LEN("git"));
        return;
    };
    if sstrEqLitC(&ty, STR_PTR("npm"), STR_LEN("npm")) {
        if recStrNE(rp, rec.len, STR_PTR("package"), STR_LEN("package"), out) { return; };
        sstrSetLit(out, STR_PTR("npm"), STR_LEN("npm"));
        return;
    };
    if sstrEqLitC(&ty, STR_PTR("remote"), STR_LEN("remote")) { sstrSetLit(out, STR_PTR("remote"), STR_LEN("remote")); return; };
    sstrSetLit(out, STR_PTR("unknown"), STR_LEN("unknown"));
}

// TS: function serverInfoLabel(value)
fn serverInfoLabel(value_ptr: ptr, value_len: u64, out: &SStr) -> void {
    let rec = JsonBufC { bytes: [0u8; 16384], len: 0 };
    asRecordC(value_ptr, value_len, &rec);
    let rp: ptr = jsonPtrC(&rec);
    let name = SStr { bytes: [0u8; 512], len: 0, has: false };
    let title = SStr { bytes: [0u8; 512], len: 0, has: false };
    let version = SStr { bytes: [0u8; 512], len: 0, has: false };
    recStrNE(rp, rec.len, STR_PTR("name"), STR_LEN("name"), &name);
    recStrNE(rp, rec.len, STR_PTR("title"), STR_LEN("title"), &title);
    recStrNE(rp, rec.len, STR_PTR("version"), STR_LEN("version"), &version);
    let head = title;
    if !title.has { head = name; };
    if !head.has && !version.has { out.has = false; out.len = 0; return; };
    out.has = true;
    out.len = 0;
    if head.has { for j in 0..head.len { if out.len < 512 { out.bytes[out.len] = head.bytes[j]; out.len = out.len + 1; }; }; };
    if head.has && version.has && out.len < 512 { out.bytes[out.len] = 32; out.len = out.len + 1; };
    if version.has { for j in 0..version.len { if out.len < 512 { out.bytes[out.len] = version.bytes[j]; out.len = out.len + 1; }; }; };
}

// TS: function formatErrorText(error) (+ the value-text adapter used by the
// socket client's server-request error path)
fn formatErrorTextValue(value_ptr: ptr, value_len: u64, out: &BigStrC) -> void {
    out.len = 0;
    let s = SStr { bytes: [0u8; 512], len: 0, has: false };
    if jsonValueStr(value_ptr, value_len, &s) { bigStrAppend(out, sstrPtrC(&s), s.len); return; };
    let rec = JsonBufC { bytes: [0u8; 16384], len: 0 };
    asRecordC(value_ptr, value_len, &rec);
    let rp: ptr = jsonPtrC(&rec);
    // first of message/error/detail/reason whose trimmed text is non-empty
    let keys: [JsonRef; 4] = [JsonRef { p: STR_PTR("message"), l: STR_LEN("message") }, JsonRef { p: STR_PTR("error"), l: STR_LEN("error") }, JsonRef { p: STR_PTR("detail"), l: STR_LEN("detail") }, JsonRef { p: STR_PTR("reason"), l: STR_LEN("reason") }];
    for k in 0..4 {
        let v = SStr { bytes: [0u8; 512], len: 0, has: false };
        if recStr(rp, rec.len, keys[k].p, keys[k].l, &v) {
            let tp: ptr = PTR_NULL();
            let tl: u64 = 0;
            @ts_str_trim(sstrPtrC(&v), v.len, &tp, &tl);
            if tl > 0 { bigStrAppend(out, sstrPtrC(&v), v.len); return; };
        };
    }
    // JSON.stringify(record) / String(error) fallback: the raw value text
    bigStrAppend(out, value_ptr, value_len);
}
fn formatErrorText(value_ptr: ptr, value_len: u64, out: &BigStrC) -> void { formatErrorTextValue(value_ptr, value_len, out); }

// TS: function summarizeJsonValue(value)
// DEFECT: JSON.stringify(value, null, 2) pretty-printing is approximated by
// the raw JSON text.
fn summarizeJsonValue(value_ptr: ptr, value_len: u64, out: &BigStrC) -> void {
    out.len = 0;
    if value_len == 0 { return; };
    let kind: u64 = 0;
    let tp: ptr = PTR_NULL();
    let tl: u64 = 0;
    let num: f64 = 0.0;
    let boolean = false;
    sa_json_parse_scalar(value_ptr, value_len, &kind, &tp, &tl, &num, &boolean);
    if kind == 0 { return; };
    if kind == 1 { bigStrAppend(out, tp, tl); return; };
    bigStrAppend(out, value_ptr, value_len);
}

