// TS (line 4505): export function parseFsDirectory(value, parentPath)
// Sort: directories first, then name order — binds @ts_str_compare from
// sa_std/ts_string.sa for the name comparison (localeCompare approximated).
fn parseFsDirectory(value_ptr: ptr, value_len: u64, parent_ptr: ptr, parent_len: u64, out: &FsDirectoryList) -> void {
    out.len = 0;
    let root = JsonBufC { bytes: [0u8; 16384], len: 0 };
    asRecordC(value_ptr, value_len, &root);
    let data = JsonBufC { bytes: [0u8; 16384], len: 0 };
    if !recVal(jsonPtrC(&root), root.len, STR_PTR("entries"), STR_LEN("entries"), &data) { return; };
    let count = arrCount(jsonPtrC(&data), data.len);
    for k in 0..count {
        if out.len >= 256 { break; };
        let raw = JsonBufC { bytes: [0u8; 16384], len: 0 };
        if !arrElemRec(jsonPtrC(&data), data.len, k, &raw) { continue; };
        let name = SStr { bytes: [0u8; 512], len: 0, has: false };
        if !recStrNE(jsonPtrC(&raw), raw.len, STR_PTR("fileName"), STR_LEN("fileName"), &name) { continue; };
        let entry = &out.items[out.len];
        entry.name = name;
        joinPath(parent_ptr, parent_len, sstrPtrC(&name), name.len, &entry.path);
        entry.isDirectory = false;
        entry.isFile = false;
        let b = false;
        if recBool(jsonPtrC(&raw), raw.len, STR_PTR("isDirectory"), STR_LEN("isDirectory"), &b) { entry.isDirectory = b; };
        if recBool(jsonPtrC(&raw), raw.len, STR_PTR("isFile"), STR_LEN("isFile"), &b) { entry.isFile = b; };
        out.len = out.len + 1;
    }
    // insertion sort (stable), directories first
    for i in 1..out.len {
        let key = out.items[i];
        let j = i;
        while j > 0 {
            let prev = out.items[j - 1];
            let swap = false;
            if prev.isDirectory != key.isDirectory { swap = key.isDirectory; } else {
                let cmp = @ts_str_compare(sstrPtrC(&prev.name), prev.name.len, sstrPtrC(&key.name), key.name.len);
                if cmp > 0 { swap = true; };
            };
            if !swap { break; };
            out.items[j] = prev;
            j = j - 1;
        }
        out.items[j] = key;
    }
}

// ---- item projection helpers (TS lines 4904-5330) ----

fn bytesContains(hay_ptr: ptr, hay_len: u64, needle_ptr: ptr, needle_len: u64) -> bool {
    if needle_len == 0 { return true; };
    if hay_len < needle_len { return false; };
    let limit = hay_len - needle_len;
    for i in 0..limit + 1 {
        let same = true;
        for j in 0..needle_len { let a: u8 = 0; PTR_BYTE_AT(a, hay_ptr, i + j); let b: u8 = 0; PTR_BYTE_AT(b, needle_ptr, j); if a != b { same = false; }; };
        if same { return true; };
    }
    return false;
}

fn recHasKey(obj_ptr: ptr, obj_len: u64, key_ptr: ptr, key_len: u64) -> bool {
    let v = JsonBufC { bytes: [0u8; 16384], len: 0 };
    return recVal(obj_ptr, obj_len, key_ptr, key_len, &v);
}

// TS: function inferItemType(item)
fn inferItemType(item_ptr: ptr, item_len: u64, out: &SStr) -> void {
    if recHasKey(item_ptr, item_len, STR_PTR("result"), STR_LEN("result")) && (recHasKey(item_ptr, item_len, STR_PTR("revised_prompt"), STR_LEN("revised_prompt")) || recHasKey(item_ptr, item_len, STR_PTR("revisedPrompt"), STR_LEN("revisedPrompt"))) { sstrSetLit(out, STR_PTR("imageGeneration"), STR_LEN("imageGeneration")); return; };
    if recHasKey(item_ptr, item_len, STR_PTR("text"), STR_LEN("text")) { sstrSetLit(out, STR_PTR("agentMessage"), STR_LEN("agentMessage")); return; };
    if recHasKey(item_ptr, item_len, STR_PTR("command"), STR_LEN("command")) { sstrSetLit(out, STR_PTR("commandExecution"), STR_LEN("commandExecution")); return; };
    if recHasKey(item_ptr, item_len, STR_PTR("changes"), STR_LEN("changes")) { sstrSetLit(out, STR_PTR("fileChange"), STR_LEN("fileChange")); return; };
    if recHasKey(item_ptr, item_len, STR_PTR("summary"), STR_LEN("summary")) { sstrSetLit(out, STR_PTR("reasoning"), STR_LEN("reasoning")); return; };
    sstrSetLit(out, STR_PTR("item"), STR_LEN("item"));
}

// TS: function normalizeWorkbenchItemType(type, item)
fn normalizeWorkbenchItemType(type_ptr: ptr, type_len: u64, item_ptr: ptr, item_len: u64, out: &SStr) -> void {
    let ty = SStr { bytes: [0u8; 512], len: 0, has: true };
    sstrSet(&ty, type_ptr, type_len);
    if sstrEqLitC(&ty, STR_PTR("message"), STR_LEN("message")) {
        let role = SStr { bytes: [0u8; 512], len: 0, has: false };
        recStrNE(item_ptr, item_len, STR_PTR("role"), STR_LEN("role"), &role);
        if sstrEqLitC(&role, STR_PTR("user"), STR_LEN("user")) { sstrSetLit(out, STR_PTR("userMessage"), STR_LEN("userMessage")); return; };
        if sstrEqLitC(&role, STR_PTR("assistant"), STR_LEN("assistant")) { sstrSetLit(out, STR_PTR("agentMessage"), STR_LEN("agentMessage")); return; };
    };
    if sstrEqLitC(&ty, STR_PTR("image_generation_call"), STR_LEN("image_generation_call")) { sstrSetLit(out, STR_PTR("imageGeneration"), STR_LEN("imageGeneration")); return; };
    if sstrEqLitC(&ty, STR_PTR("plan"), STR_LEN("plan")) { sstrSetLit(out, STR_PTR("plan"), STR_LEN("plan")); return; };
    if sstrEqLitC(&ty, STR_PTR("toolUse"), STR_LEN("toolUse")) || sstrEqLitC(&ty, STR_PTR("tool_use"), STR_LEN("tool_use")) { sstrSetLit(out, STR_PTR("toolCall"), STR_LEN("toolCall")); return; };
    if sstrEqLitC(&ty, STR_PTR("compaction"), STR_LEN("compaction")) || sstrEqLitC(&ty, STR_PTR("context_compaction"), STR_LEN("context_compaction")) { sstrSetLit(out, STR_PTR("contextCompaction"), STR_LEN("contextCompaction")); return; };
    *out = ty;
}

