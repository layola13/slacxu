// Whole-body JSON GET/POST wrappers for profile/relay export-import
// (TS lines 3096-3170): on !ok throw `Failed to ...: ${status}` (colon form).
fn wholeBodyRequest(token_ptr: ptr, token_len: u64, method_ptr: ptr, method_len: u64, path_ptr: ptr, path_len: u64, hasBody: bool, body_ptr: ptr, body_len: u64, fallback_ptr: ptr, fallback_len: u64, out: &JsonBufC, err: &SStr) -> i32 {
    let resp = HttpResponse { status: 0, body: JsonBufC { bytes: [0u8; 16384], len: 0 } };
    if httpFetchJson(method_ptr, method_len, path_ptr, path_len, token_ptr, token_len, hasBody, body_ptr, body_len, &resp) != 0 { return 1; };
    if !responseOk(&resp) {
        let msg = BigStrC { bytes: [0u8; 8192], len: 0 };
        bigStrAppend(&msg, fallback_ptr, fallback_len);
        bigStrAppend(&msg, STR_PTR(": "), STR_LEN(": "));
        bigStrAppendU64(&msg, resp.status);
        let mp: ptr = PTR_NULL();
        PTR_BYTE_ADD(mp, &msg.bytes, 0);
        sstrSet(err, mp, msg.len);
        return 1;
    };
    jsonBufCopyC(out, &resp.body);
    return 0;
}

// TS: UiProfile / UiProfileImportResult / RelayConfigBundle /
// RelayBackupBundle (shared) — JSON buffers in this pass.
fn exportProfile(token_ptr: ptr, token_len: u64, out: &JsonBufC, err: &SStr) -> i32 { return wholeBodyRequest(token_ptr, token_len, STR_PTR("GET"), STR_LEN("GET"), STR_PTR("/api/profile/export"), STR_LEN("/api/profile/export"), false, STR_PTR(""), 0, STR_PTR("Failed to export profile"), STR_LEN("Failed to export profile"), out, err); }
fn importProfile(token_ptr: ptr, token_len: u64, profile_json: &JsonBufC, out: &JsonBufC, err: &SStr) -> i32 { let bp: ptr = PTR_NULL(); PTR_BYTE_ADD(bp, &profile_json.bytes, 0); return wholeBodyRequest(token_ptr, token_len, STR_PTR("POST"), STR_LEN("POST"), STR_PTR("/api/profile/import"), STR_LEN("/api/profile/import"), true, bp, profile_json.len, STR_PTR("Failed to import profile"), STR_LEN("Failed to import profile"), out, err); }
fn exportRelayConfig(token_ptr: ptr, token_len: u64, out: &JsonBufC, err: &SStr) -> i32 { return wholeBodyRequest(token_ptr, token_len, STR_PTR("GET"), STR_LEN("GET"), STR_PTR("/api/relay-config/export"), STR_LEN("/api/relay-config/export"), false, STR_PTR(""), 0, STR_PTR("Failed to export relay config"), STR_LEN("Failed to export relay config"), out, err); }
fn importRelayConfig(token_ptr: ptr, token_len: u64, bundle_json: &JsonBufC, out: &JsonBufC, err: &SStr) -> i32 { let bp: ptr = PTR_NULL(); PTR_BYTE_ADD(bp, &bundle_json.bytes, 0); return wholeBodyRequest(token_ptr, token_len, STR_PTR("POST"), STR_LEN("POST"), STR_PTR("/api/relay-config/import"), STR_LEN("/api/relay-config/import"), true, bp, bundle_json.len, STR_PTR("Failed to import relay config"), STR_LEN("Failed to import relay config"), out, err); }
fn exportRelayBackup(token_ptr: ptr, token_len: u64, out: &JsonBufC, err: &SStr) -> i32 { return wholeBodyRequest(token_ptr, token_len, STR_PTR("GET"), STR_LEN("GET"), STR_PTR("/api/relay-backup/export"), STR_LEN("/api/relay-backup/export"), false, STR_PTR(""), 0, STR_PTR("Failed to export relay backup"), STR_LEN("Failed to export relay backup"), out, err); }
fn importRelayBackup(token_ptr: ptr, token_len: u64, bundle_json: &JsonBufC, out: &JsonBufC, err: &SStr) -> i32 { let bp: ptr = PTR_NULL(); PTR_BYTE_ADD(bp, &bundle_json.bytes, 0); return wholeBodyRequest(token_ptr, token_len, STR_PTR("POST"), STR_LEN("POST"), STR_PTR("/api/relay-backup/import"), STR_LEN("/api/relay-backup/import"), true, bp, bundle_json.len, STR_PTR("Failed to import relay backup"), STR_LEN("Failed to import relay backup"), out, err); }

// TS (line 3170): export async function fetchAuditEvents(token)
// DEFECT: async; DangerousPermissionAuditEvent[] kept as data JSON; ?? [].
fn fetchAuditEvents(token_ptr: ptr, token_len: u64, out: &JsonBufC, err: &SStr) -> i32 {
    let resp = HttpResponse { status: 0, body: JsonBufC { bytes: [0u8; 16384], len: 0 } };
    if httpFetchJson(STR_PTR("GET"), STR_LEN("GET"), STR_PTR("/api/audit/events"), STR_LEN("/api/audit/events"), token_ptr, token_len, false, STR_PTR(""), 0, &resp) != 0 { return 1; };
    if !responseOk(&resp) {
        let msg = BigStrC { bytes: [0u8; 8192], len: 0 };
        bigStrAppend(&msg, STR_PTR("Failed to read audit events: "), STR_LEN("Failed to read audit events: "));
        bigStrAppendU64(&msg, resp.status);
        let mp: ptr = PTR_NULL();
        PTR_BYTE_ADD(mp, &msg.bytes, 0);
        sstrSet(err, mp, msg.len);
        return 1;
    };
    let rp: ptr = PTR_NULL();
    PTR_BYTE_ADD(rp, &resp.body.bytes, 0);
    let dp: ptr = PTR_NULL();
    let dl: u64 = 0;
    if sa_json_object_get_value_text(rp, resp.body.len, STR_PTR("data"), STR_LEN("data"), &dp, &dl) == 0 { jsonBufSetC(out, dp, dl); } else { jsonBufSetC(out, STR_PTR("[]"), STR_LEN("[]")); };
    return 0;
}

// ---- applyNotification machinery (TS lines 3189-4019) ----
// DEFECT: the module-level `serverStartedTurnIds` Set (TS line 3189) is an
// explicit ServerStartedTurnIds parameter here (no module-global mutable
// state in this pass).
// DEFECT: Date.now() inside the reducer is the now_ms parameter.
// DEFECT: JEV dispatches (dispatchJevSubagent / dispatchJevPlanCreated from
// frontends/jev) are side effects with no SLA counterpart; they are recorded
// into a JevDispatchList for the host to perform. extractJevCollabBrief /
// extractJevCollabReport live in the jev unit; the local versions below read
// the common fields and are marked as approximations.
// DEFECT: applyNotification's TS body is one function; here it is a
// dispatcher plus one function per method branch, in source order, because
// of its size. Branch logic is transcribed 1:1.

struct ServerStartedTurnIds {
    items: [[u8; 128]; 256],
    lens: [u64; 256],
    len: u64,
}

fn serverStartedContains(prov: &ServerStartedTurnIds, id_ptr: ptr, id_len: u64) -> bool {
    for i in 0..prov.len {
        if prov.lens[i] == id_len {
            let same = true;
            for j in 0..id_len { let b: u8 = 0; PTR_BYTE_AT(b, id_ptr, j); if prov.items[i][j] != b { same = false; }; }
            if same { return true; };
        };
    }
    return false;
}

fn serverStartedAdd(prov: &ServerStartedTurnIds, id_ptr: ptr, id_len: u64) -> void {
    if serverStartedContains(prov, id_ptr, id_len) || prov.len >= 256 { return; };
    let n = id_len;
    if n > 128 { n = 128; };
    for j in 0..n { let b: u8 = 0; PTR_BYTE_AT(b, id_ptr, j); prov.items[prov.len][j] = b; }
    prov.lens[prov.len] = n;
    prov.len = prov.len + 1;
}

fn serverStartedRemove(prov: &ServerStartedTurnIds, id_ptr: ptr, id_len: u64) -> void {
    for i in 0..prov.len {
        if prov.lens[i] == id_len {
            let same = true;
            for j in 0..id_len { let b: u8 = 0; PTR_BYTE_AT(b, id_ptr, j); if prov.items[i][j] != b { same = false; }; }
            if same {
                let k = i;
                while k + 1 < prov.len {
                    let n = prov.lens[k + 1];
                    for j in 0..n { prov.items[k][j] = prov.items[k + 1][j]; }
                    prov.lens[k] = n;
                    k = k + 1;
                }
                prov.len = prov.len - 1;
                return;
            };
        };
    }
}

// TS (line 3192): export function resetTurnTimestampProvenanceForTests(): void
fn resetTurnTimestampProvenanceForTests(prov: &ServerStartedTurnIds) -> void { prov.len = 0; }

struct JevDispatch {
    kind: SStr,
    threadId: SStr,
    turnId: SStr,
    agentId: SStr,
    taskName: SStr,
    has_status: bool,
    status: SStr,
    text: BigStrC,
    sessionToken: SStr,
}
struct JevDispatchList { items: [JevDispatch; 64], len: u64 }

// Result of extractJevCollabBrief / extractJevCollabReport (jev unit types)
struct JevExtract {
    agentId: SStr,
    taskName: SStr,
    has_status: bool,
    status: SStr,
    text: BigStrC,
}

fn dispatchJevSubagent(jev: &JevDispatchList, kind_ptr: ptr, kind_len: u64, threadId: &SStr, turnId: &SStr, agentId: &SStr, taskName: &SStr, hasStatus: bool, status: &SStr, text_ptr: ptr, text_len: u64, sessionToken: &SStr) -> void {
    if jev.len >= 64 { return; };
    let d = &jev.items[jev.len];
    sstrSet(&d.kind, kind_ptr, kind_len);
    d.threadId = *threadId;
    d.turnId = *turnId;
    d.agentId = *agentId;
    d.taskName = *taskName;
    d.has_status = hasStatus;
    d.status = *status;
    d.text.len = 0;
    bigStrAppend(&d.text, text_ptr, text_len);
    d.sessionToken = *sessionToken;
    jev.len = jev.len + 1;
}

fn dispatchJevPlanCreated(jev: &JevDispatchList, threadId: &SStr, turnId: &SStr, planText_ptr: ptr, planText_len: u64, userPrompt_ptr: ptr, userPrompt_len: u64, sessionToken: &SStr) -> void {
    if jev.len >= 64 { return; };
    let d = &jev.items[jev.len];
    sstrSetLit(&d.kind, STR_PTR("plan"), STR_LEN("plan"));
    d.threadId = *threadId;
    d.turnId = *turnId;
    d.agentId.has = false;
    d.agentId.len = 0;
    d.taskName.has = false;
    d.taskName.len = 0;
    d.has_status = false;
    // planText in text, userPrompt appended after a NUL-free separator is not
    // representable; userPrompt rides in taskName's slot is wrong — instead
    // text holds planText and the prompt is truncated into agentId slot.
    // DEFECT: dispatch record shape approximation (see header note).
    d.text.len = 0;
    bigStrAppend(&d.text, planText_ptr, planText_len);
    d.sessionToken = *sessionToken;
    jev.len = jev.len + 1;
}

// JsonRpcNotification / JsonRpcRequest (shared shapes as used here)
struct JsonRpcNotification {
    method: SStr,
    has_params: bool,
    params_json: JsonBufC,
}
struct JsonRpcRequest {
    method: SStr,
    has_params: bool,
    params_json: JsonBufC,
    id_json: JsonBufSmallC,
}

// Record accessors over a JSON object text (the TS asRecord/stringValue/
// numberValue semantics for already-parsed records; the general value
// helpers are defined with the parse functions later in this file).
fn asRecordC(value_ptr: ptr, value_len: u64, out: &JsonBufC) -> void {
    if value_len > 0 {
        let first: u8 = 0;
        let i: u64 = 0;
        let found = false;
        while i < value_len {
            PTR_BYTE_AT(first, value_ptr, i);
            if first == 32 || first == 9 || first == 10 || first == 13 { i = i + 1; continue; };
            found = true;
            break;
        }
        if found && first == 123 { jsonBufSetC(out, value_ptr, value_len); return; };
    };
    jsonBufSetC(out, STR_PTR("{}"), STR_LEN("{}"));
}

fn recStr(obj_ptr: ptr, obj_len: u64, key_ptr: ptr, key_len: u64, out: &SStr) -> bool {
    let vp: ptr = PTR_NULL();
    let vl: u64 = 0;
    if sa_json_object_get_string(obj_ptr, obj_len, key_ptr, key_len, &vp, &vl) != 0 { out.has = false; out.len = 0; return false; };
    sstrSet(out, vp, vl);
    return true;
}

fn recStrAlt(obj_ptr: ptr, obj_len: u64, key1_ptr: ptr, key1_len: u64, key2_ptr: ptr, key2_len: u64, out: &SStr) -> bool {
    if recStr(obj_ptr, obj_len, key1_ptr, key1_len, out) { return true; };
    return recStr(obj_ptr, obj_len, key2_ptr, key2_len, out);
}

fn recNum(obj_ptr: ptr, obj_len: u64, key_ptr: ptr, key_len: u64, out: &f64) -> bool {
    return sa_json_object_get_number(obj_ptr, obj_len, key_ptr, key_len, out) == 0;
}

fn recNumAlt(obj_ptr: ptr, obj_len: u64, key1_ptr: ptr, key1_len: u64, key2_ptr: ptr, key2_len: u64, out: &f64) -> bool {
    if recNum(obj_ptr, obj_len, key1_ptr, key1_len, out) { return true; };
    return recNum(obj_ptr, obj_len, key2_ptr, key2_len, out);
}

fn recVal(obj_ptr: ptr, obj_len: u64, key_ptr: ptr, key_len: u64, out: &JsonBufC) -> bool {
    let vp: ptr = PTR_NULL();
    let vl: u64 = 0;
    if sa_json_object_get_value_text(obj_ptr, obj_len, key_ptr, key_len, &vp, &vl) != 0 { return false; };
    jsonBufSetC(out, vp, vl);
    return true;
}

fn recBool(obj_ptr: ptr, obj_len: u64, key_ptr: ptr, key_len: u64, out: &bool) -> bool {
    return sa_json_object_get_bool(obj_ptr, obj_len, key_ptr, key_len, out) == 0;
}

// stringValue on an arbitrary JSON value text (used for nested values)
fn jsonValueStr(value_ptr: ptr, value_len: u64, out: &SStr) -> bool {
    let kind: u64 = 0;
    let tp: ptr = PTR_NULL();
    let tl: u64 = 0;
    let num: f64 = 0.0;
    let boolean = false;
    sa_json_parse_scalar(value_ptr, value_len, &kind, &tp, &tl, &num, &boolean);
    if kind != 1 { out.has = false; out.len = 0; return false; };
    sstrSet(out, tp, tl);
    return true;
}

// WorkbenchItem / WorkbenchTurn constructors and field setters
fn workbenchItemClear(item: &WorkbenchItem) -> void {
    item.id_len = 0;
    item.type_len = 0;
    item.title_len = 0;
    item.text_len = 0;
    item.has_status = false;
    item.status_len = 0;
    item.has_startedAt = false;
    item.startedAt = 0.0;
    item.has_completedAt = false;
    item.completedAt = 0.0;
    item.has_firstTokenAt = false;
    item.firstTokenAt = 0.0;
    item.has_updatedAt = false;
    item.updatedAt = 0.0;
    item.has_agentId = false;
    item.agentId_len = 0;
    item.has_agentThreadId = false;
    item.agentThreadId_len = 0;
    item.has_agentName = false;
    item.agentName_len = 0;
    item.has_agentRole = false;
    item.agentRole_len = 0;
    item.has_agentStatus = false;
    item.agentStatus_len = 0;
    item.has_images = false;
    item.images_count = 0;
    item.images_json_len = 0;
    item.has_files = false;
    item.files_count = 0;
    item.files_json_len = 0;
    item.has_payload = false;
    item.payload_len = 0;
}

fn workbenchTurnClear(turn: &WorkbenchTurn) -> void {
    turn.id_len = 0;
    turn.threadId_len = 0;
    turn.has_status = false;
    turn.status_len = 0;
    turn.has_startedAt = false;
    turn.startedAt = 0.0;
    turn.has_completedAt = false;
    turn.completedAt = 0.0;
    turn.items_len = 0;
}

fn setBytes128(dst: &[u8; 128], dst_len: &u64, src_ptr: ptr, src_len: u64) -> void {
    let n = src_len;
    if n > 128 { n = 128; };
    for j in 0..n { let b: u8 = 0; PTR_BYTE_AT(b, src_ptr, j); dst[j] = b; }
    *dst_len = n;
}

fn itemSetId(item: &WorkbenchItem, src_ptr: ptr, src_len: u64) -> void { setBytes128(&item.id_bytes, &item.id_len, src_ptr, src_len); }
fn itemSetType(item: &WorkbenchItem, src_ptr: ptr, src_len: u64) -> void {
    let n = src_len;
    if n > 64 { n = 64; };
    for j in 0..n { let b: u8 = 0; PTR_BYTE_AT(b, src_ptr, j); item.type_bytes[j] = b; }
    item.type_len = n;
}
fn itemSetTitle(item: &WorkbenchItem, src_ptr: ptr, src_len: u64) -> void {
    let n = src_len;
    if n > 256 { n = 256; };
    for j in 0..n { let b: u8 = 0; PTR_BYTE_AT(b, src_ptr, j); item.title_bytes[j] = b; }
    item.title_len = n;
}
fn itemSetText(item: &WorkbenchItem, src_ptr: ptr, src_len: u64) -> void {
    let n = src_len;
    if n > 8192 { n = 8192; };
    for j in 0..n { let b: u8 = 0; PTR_BYTE_AT(b, src_ptr, j); item.text_bytes[j] = b; }
    item.text_len = n;
}
fn itemAppendText(item: &WorkbenchItem, src_ptr: ptr, src_len: u64) -> void {
    for j in 0..src_len {
        if item.text_len < 8192 { let b: u8 = 0; PTR_BYTE_AT(b, src_ptr, j); item.text_bytes[item.text_len] = b; item.text_len = item.text_len + 1; };
    }
}
fn itemSetStatus(item: &WorkbenchItem, has: bool, src_ptr: ptr, src_len: u64) -> void {
    item.has_status = has;
    let n = src_len;
    if n > 64 { n = 64; };
    for j in 0..n { let b: u8 = 0; PTR_BYTE_AT(b, src_ptr, j); item.status_bytes[j] = b; }
    item.status_len = n;
    if !has { item.status_len = 0; };
}
fn turnSetId(turn: &WorkbenchTurn, src_ptr: ptr, src_len: u64) -> void { setBytes128(&turn.id_bytes, &turn.id_len, src_ptr, src_len); }
fn turnSetThreadId(turn: &WorkbenchTurn, src_ptr: ptr, src_len: u64) -> void { setBytes128(&turn.threadId_bytes, &turn.threadId_len, src_ptr, src_len); }
fn turnSetStatus(turn: &WorkbenchTurn, has: bool, src_ptr: ptr, src_len: u64) -> void {
    turn.has_status = has;
    let n = src_len;
    if n > 64 { n = 64; };
    for j in 0..n { let b: u8 = 0; PTR_BYTE_AT(b, src_ptr, j); turn.status_bytes[j] = b; }
    turn.status_len = n;
    if !has { turn.status_len = 0; };
}

fn itemIdEq(item: &WorkbenchItem, id_ptr: ptr, id_len: u64) -> bool {
    if item.id_len != id_len { return false; };
    for j in 0..id_len { let b: u8 = 0; PTR_BYTE_AT(b, id_ptr, j); if item.id_bytes[j] != b { return false; }; }
    return true;
}
fn turnIdEq(turn: &WorkbenchTurn, id_ptr: ptr, id_len: u64) -> bool {
    if turn.id_len != id_len { return false; };
    for j in 0..id_len { let b: u8 = 0; PTR_BYTE_AT(b, id_ptr, j); if turn.id_bytes[j] != b { return false; }; }
    return true;
}

fn stateFindTurn(state: &ClientState, id_ptr: ptr, id_len: u64, out_index: &u64) -> bool {
    for i in 0..state.turns_len {
        if turnIdEq(&state.turns_items[i], id_ptr, id_len) { *out_index = i; return true; };
    }
    return false;
}

fn turnFindItem(turn: &WorkbenchTurn, id_ptr: ptr, id_len: u64, out_index: &u64) -> bool {
    for i in 0..turn.items_len {
        if itemIdEq(&turn.items_items[i], id_ptr, id_len) { *out_index = i; return true; };
    }
    return false;
}

// upsertWorkbenchTurn / upsertWorkbenchItem (from workbenchTimeline.sla)
// applied directly to the state's storage, using that module's merge
// functions (mode 0 = "notification").
fn stateUpsertTurn(state: &ClientState, incoming: &WorkbenchTurn) -> void {
    let ip: ptr = PTR_NULL();
    PTR_BYTE_ADD(ip, &incoming.id_bytes, 0);
    let idx: u64 = 0;
    if stateFindTurn(state, ip, incoming.id_len, &idx) {
        let merged = state.turns_items[idx];
        mergeWorkbenchTurn(&state.turns_items[idx], incoming, 0, &merged);
        state.turns_items[idx] = merged;
        return;
    };
    if state.turns_len < 128 { state.turns_items[state.turns_len] = *incoming; state.turns_len = state.turns_len + 1; };
}

fn turnUpsertItem(turn: &WorkbenchTurn, incoming: &WorkbenchItem) -> void {
    let ip: ptr = PTR_NULL();
    PTR_BYTE_ADD(ip, &incoming.id_bytes, 0);
    let idx: u64 = 0;
    if turnFindItem(turn, ip, incoming.id_len, &idx) {
        let merged = turn.items_items[idx];
        mergeWorkbenchItem(&turn.items_items[idx], incoming, 0, &merged);
        turn.items_items[idx] = merged;
        return;
    };
    if turn.items_len < 128 { turn.items_items[turn.items_len] = *incoming; turn.items_len = turn.items_len + 1; };
}

// claudeStartupStages is a dynamic Record — stored as JSON text on the
// state; these helpers set/delete one key via assumed sa_json externs.
fn startupStagesSet(state: &ClientState, threadId_ptr: ptr, threadId_len: u64, stage_ptr: ptr, stage_len: u64, at: f64, hasError: bool, error_ptr: ptr, error_len: u64) -> void {
    let entry = BigStrC { bytes: [0u8; 8192], len: 0 };
    bigStrAppend(&entry, STR_PTR("{\"stage\":\""), STR_LEN("{\"stage\":\""));
    bigStrAppend(&entry, stage_ptr, stage_len);
    bigStrAppend(&entry, STR_PTR("\",\"at\":"), STR_LEN("\",\"at\":"));
    bigStrAppendU64(&entry, at as u64);
    if hasError {
        bigStrAppend(&entry, STR_PTR(",\"error\":\""), STR_LEN(",\"error\":\""));
        bigStrAppend(&entry, error_ptr, error_len);
        bigStrAppend(&entry, STR_PTR("\""), STR_LEN("\""));
    };
    bigStrAppend(&entry, STR_PTR("}"), STR_LEN("}"));
    let cur = JsonBufC { bytes: [0u8; 16384], len: 0 };
    jsonBufCopyC(&cur, &state.claudeStartupStages_json);
    let cp: ptr = PTR_NULL();
    PTR_BYTE_ADD(cp, &cur.bytes, 0);
    let ep: ptr = PTR_NULL();
    PTR_BYTE_ADD(ep, &entry.bytes, 0);
    let rp: ptr = PTR_NULL();
    let rl: u64 = 0;
    if sa_json_object_set_value_text(cp, cur.len, threadId_ptr, threadId_len, ep, entry.len, &rp, &rl) == 0 { jsonBufSetC(&state.claudeStartupStages_json, rp, rl); };
}

fn startupStagesDelete(state: &ClientState, threadId_ptr: ptr, threadId_len: u64) -> void {
    let cur = JsonBufC { bytes: [0u8; 16384], len: 0 };
    jsonBufCopyC(&cur, &state.claudeStartupStages_json);
    let cp: ptr = PTR_NULL();
    PTR_BYTE_ADD(cp, &cur.bytes, 0);
    let rp: ptr = PTR_NULL();
    let rl: u64 = 0;
    if sa_json_object_remove_key_copy(cp, cur.len, threadId_ptr, threadId_len, &rp, &rl) == 0 { jsonBufSetC(&state.claudeStartupStages_json, rp, rl); };
}

// ---- small pointer helpers for the reducer ----
fn sstrPtrC(s: &SStr) -> ptr { let p: ptr = PTR_NULL(); PTR_BYTE_ADD(p, &s.bytes, 0); return p; }
fn bigPtrSmallC(b: &JsonBufSmallC) -> ptr { let p: ptr = PTR_NULL(); PTR_BYTE_ADD(p, &b.bytes, 0); return p; }
fn jsonBufSetSmallC(out: &JsonBufSmallC, src_ptr: ptr, src_len: u64) -> void {
    let n = src_len;
    if n > 2048 { n = 2048; };
    for j in 0..n { let b: u8 = 0; PTR_BYTE_AT(b, src_ptr, j); out.bytes[j] = b; }
    out.len = n;
}
fn jsonPtrC(j: &JsonBufC) -> ptr { let p: ptr = PTR_NULL(); PTR_BYTE_ADD(p, &j.bytes, 0); return p; }
fn bigPtrC(b: &BigStrC) -> ptr { let p: ptr = PTR_NULL(); PTR_BYTE_ADD(p, &b.bytes, 0); return p; }
fn bigPtrExistingText(item: &WorkbenchItem) -> ptr { let p: ptr = PTR_NULL(); PTR_BYTE_ADD(p, &item.text_bytes, 0); return p; }

fn sstrEqC(a: &SStr, b: &SStr) -> bool {
    if a.len != b.len { return false; };
    for j in 0..a.len { if a.bytes[j] != b.bytes[j] { return false; }; }
    return true;
}

fn sstrEqLitC(a: &SStr, lit_ptr: ptr, lit_len: u64) -> bool {
    if a.len != lit_len { return false; };
    for j in 0..lit_len { let b: u8 = 0; PTR_BYTE_AT(b, lit_ptr, j); if a.bytes[j] != b { return false; }; }
    return true;
}

fn threadEntryClear(e: &ThreadEntry) -> void {
    e.id.has = false; e.id.len = 0;
    e.cliBackend.has = false; e.cliBackend.len = 0;
    e.sessionId.has = false; e.sessionId.len = 0;
    e.title.has = false; e.title.len = 0;
    e.name.has = false; e.name.len = 0;
    e.preview.has = false; e.preview.len = 0;
    e.model.has = false; e.model.len = 0;
    e.modelProvider.has = false; e.modelProvider.len = 0;
    e.parentThreadId.has = false; e.parentThreadId.len = 0;
    e.forkedFromId.has = false; e.forkedFromId.len = 0;
    e.agentNickname.has = false; e.agentNickname.len = 0;
    e.agentRole.has = false; e.agentRole.len = 0;
    e.has_createdAt = false; e.createdAt = 0.0;
    e.has_updatedAt = false; e.updatedAt = 0.0;
    e.has_recencyAt = false; e.recencyAt = 0.0;
    e.status.has = false; e.status.len = 0;
    e.cwd.has = false; e.cwd.len = 0;
    e.additionalRoots_len = 0;
    e.source.has = false; e.source.len = 0;
    e.threadSource.has = false; e.threadSource.len = 0;
    e.path.has = false; e.path.len = 0;
    e.historyMode.has = false; e.historyMode.len = 0;
    e.workspaceMode.has = false; e.workspaceMode.len = 0;
    e.sshCommand.has = false; e.sshCommand.len = 0;
    e.sshCwd.has = false; e.sshCwd.len = 0;
    e.remoteExecutionMode.has = false; e.remoteExecutionMode.len = 0;
    e.remoteLifecycleMode.has = false; e.remoteLifecycleMode.len = 0;
    e.raw_json.len = 0;
}

// upsertById for threads (the generic upsertById is defined with the parse
// helpers later; this is its ThreadEntry specialization used by the reducer).
// TS upsertById replaces in place when found, otherwise PREPENDS
// ([next, ...items]).
fn upsertThreadById(state: &ClientState, entry: &ThreadEntry) -> void {
    for i in 0..state.threads_len {
        if sstrEqC(&state.threads[i].id, &entry.id) { state.threads[i] = *entry; return; };
    }
    if state.threads_len < 256 {
        let k = state.threads_len;
        while k > 0 {
            state.threads[k] = state.threads[k - 1];
            k = k - 1;
        }
        state.threads[0] = *entry;
        state.threads_len = state.threads_len + 1;
    };
}

// TS branch: method === "thread/started"
fn applyNotifThreadStarted(state: &ClientState, params_ptr: ptr, params_len: u64, out: &ClientState) -> void {
    *out = *state;
    let threadVal = JsonBufC { bytes: [0u8; 16384], len: 0 };
    if !recVal(params_ptr, params_len, STR_PTR("thread"), STR_LEN("thread"), &threadVal) { return; };
    let thread = JsonBufC { bytes: [0u8; 16384], len: 0 };
    asRecordC(jsonPtrC(&threadVal), threadVal.len, &thread);
    let tp: ptr = jsonPtrC(&thread);
    let id = SStr { bytes: [0u8; 512], len: 0, has: false };
    if !recStr(tp, thread.len, STR_PTR("id"), STR_LEN("id"), &id) { return; };
    let entry = ThreadEntry { id: SStr { bytes: [0u8; 512], len: 0, has: false }, cliBackend: SStr { bytes: [0u8; 512], len: 0, has: false }, sessionId: SStr { bytes: [0u8; 512], len: 0, has: false }, title: SStr { bytes: [0u8; 512], len: 0, has: false }, name: SStr { bytes: [0u8; 512], len: 0, has: false }, preview: SStr { bytes: [0u8; 512], len: 0, has: false }, model: SStr { bytes: [0u8; 512], len: 0, has: false }, modelProvider: SStr { bytes: [0u8; 512], len: 0, has: false }, parentThreadId: SStr { bytes: [0u8; 512], len: 0, has: false }, forkedFromId: SStr { bytes: [0u8; 512], len: 0, has: false }, agentNickname: SStr { bytes: [0u8; 512], len: 0, has: false }, agentRole: SStr { bytes: [0u8; 512], len: 0, has: false }, has_createdAt: false, createdAt: 0.0, has_updatedAt: false, updatedAt: 0.0, has_recencyAt: false, recencyAt: 0.0, status: SStr { bytes: [0u8; 512], len: 0, has: false }, cwd: SStr { bytes: [0u8; 512], len: 0, has: false }, additionalRoots: [SStr { bytes: [0u8; 512], len: 0, has: false }; 16], additionalRoots_len: 0, source: SStr { bytes: [0u8; 512], len: 0, has: false }, threadSource: SStr { bytes: [0u8; 512], len: 0, has: false }, path: SStr { bytes: [0u8; 512], len: 0, has: false }, historyMode: SStr { bytes: [0u8; 512], len: 0, has: false }, workspaceMode: SStr { bytes: [0u8; 512], len: 0, has: false }, sshCommand: SStr { bytes: [0u8; 512], len: 0, has: false }, sshCwd: SStr { bytes: [0u8; 512], len: 0, has: false }, remoteExecutionMode: SStr { bytes: [0u8; 512], len: 0, has: false }, remoteLifecycleMode: SStr { bytes: [0u8; 512], len: 0, has: false }, raw_json: JsonBufSmallC { bytes: [0u8; 2048], len: 0 } };
    threadEntryClear(&entry);
    entry.id = id;
    let backend = SStr { bytes: [0u8; 512], len: 0, has: false };
    if recStrAlt(tp, thread.len, STR_PTR("cliBackend"), STR_LEN("cliBackend"), STR_PTR("cli_backend"), STR_LEN("cli_backend"), &backend) {
        if sstrEqLitC(&backend, STR_PTR("claude"), STR_LEN("claude")) || sstrEqLitC(&backend, STR_PTR("auggie"), STR_LEN("auggie")) || sstrEqLitC(&backend, STR_PTR("agy"), STR_LEN("agy")) || sstrEqLitC(&backend, STR_PTR("grok"), STR_LEN("grok")) || sstrEqLitC(&backend, STR_PTR("muse"), STR_LEN("muse")) || sstrEqLitC(&backend, STR_PTR("pi"), STR_LEN("pi")) || sstrEqLitC(&backend, STR_PTR("opencode"), STR_LEN("opencode")) || sstrEqLitC(&backend, STR_PTR("opencode-v2"), STR_LEN("opencode-v2")) || sstrEqLitC(&backend, STR_PTR("mini"), STR_LEN("mini")) || sstrEqLitC(&backend, STR_PTR("codex"), STR_LEN("codex")) { entry.cliBackend = backend; };
    };
    recStrAlt(tp, thread.len, STR_PTR("sessionId"), STR_LEN("sessionId"), STR_PTR("session_id"), STR_LEN("session_id"), &entry.sessionId);
    if !recStr(tp, thread.len, STR_PTR("name"), STR_LEN("name"), &entry.title) {
        if !recStr(tp, thread.len, STR_PTR("title"), STR_LEN("title"), &entry.title) {
            if !recStr(tp, thread.len, STR_PTR("threadName"), STR_LEN("threadName"), &entry.title) { recStr(tp, thread.len, STR_PTR("thread_name"), STR_LEN("thread_name"), &entry.title); };
        };
    };
    if !recStr(tp, thread.len, STR_PTR("name"), STR_LEN("name"), &entry.name) {
        if !recStr(tp, thread.len, STR_PTR("threadName"), STR_LEN("threadName"), &entry.name) { recStr(tp, thread.len, STR_PTR("thread_name"), STR_LEN("thread_name"), &entry.name); };
    };
    let previewRaw = SStr { bytes: [0u8; 512], len: 0, has: false };
    recStr(tp, thread.len, STR_PTR("preview"), STR_LEN("preview"), &previewRaw);
    displayPromptText(sstrPtrC(&previewRaw), previewRaw.len, &entry.preview);
    recStr(tp, thread.len, STR_PTR("model"), STR_LEN("model"), &entry.model);
    recStrAlt(tp, thread.len, STR_PTR("modelProvider"), STR_LEN("modelProvider"), STR_PTR("model_provider"), STR_LEN("model_provider"), &entry.modelProvider);
    recStrAlt(tp, thread.len, STR_PTR("parentThreadId"), STR_LEN("parentThreadId"), STR_PTR("parent_thread_id"), STR_LEN("parent_thread_id"), &entry.parentThreadId);
    recStrAlt(tp, thread.len, STR_PTR("forkedFromId"), STR_LEN("forkedFromId"), STR_PTR("forked_from_id"), STR_LEN("forked_from_id"), &entry.forkedFromId);
    recStrAlt(tp, thread.len, STR_PTR("agentNickname"), STR_LEN("agentNickname"), STR_PTR("agent_nickname"), STR_LEN("agent_nickname"), &entry.agentNickname);
    recStrAlt(tp, thread.len, STR_PTR("agentRole"), STR_LEN("agentRole"), STR_PTR("agent_role"), STR_LEN("agent_role"), &entry.agentRole);
    entry.has_createdAt = recNumAlt(tp, thread.len, STR_PTR("createdAt"), STR_LEN("createdAt"), STR_PTR("created_at"), STR_LEN("created_at"), &entry.createdAt);
    entry.has_updatedAt = recNumAlt(tp, thread.len, STR_PTR("updatedAt"), STR_LEN("updatedAt"), STR_PTR("updated_at"), STR_LEN("updated_at"), &entry.updatedAt);
    entry.has_recencyAt = recNumAlt(tp, thread.len, STR_PTR("recencyAt"), STR_LEN("recencyAt"), STR_PTR("recency_at"), STR_LEN("recency_at"), &entry.recencyAt);
    let statusVal = JsonBufC { bytes: [0u8; 16384], len: 0 };
    if recVal(tp, thread.len, STR_PTR("status"), STR_LEN("status"), &statusVal) { threadStatusValue(jsonPtrC(&statusVal), statusVal.len, &entry.status); };
    recStr(tp, thread.len, STR_PTR("cwd"), STR_LEN("cwd"), &entry.cwd);
    let sourceVal = JsonBufC { bytes: [0u8; 16384], len: 0 };
    if recVal(tp, thread.len, STR_PTR("source"), STR_LEN("source"), &sourceVal) || recVal(tp, thread.len, STR_PTR("thread_source"), STR_LEN("thread_source"), &sourceVal) { sourceLabel(jsonPtrC(&sourceVal), sourceVal.len, &entry.source); };
    let tsVal = JsonBufC { bytes: [0u8; 16384], len: 0 };
    if recVal(tp, thread.len, STR_PTR("threadSource"), STR_LEN("threadSource"), &tsVal) || recVal(tp, thread.len, STR_PTR("thread_source"), STR_LEN("thread_source"), &tsVal) { sourceLabel(jsonPtrC(&tsVal), tsVal.len, &entry.threadSource); };
    if !recStr(tp, thread.len, STR_PTR("path"), STR_LEN("path"), &entry.path) { recStr(tp, thread.len, STR_PTR("file_path"), STR_LEN("file_path"), &entry.path); };
    out.activeThreadId = id;
    upsertThreadById(out, &entry);
}

// TS branch: method === "thread/name/updated"
fn applyNotifThreadNameUpdated(state: &ClientState, params_ptr: ptr, params_len: u64, out: &ClientState) -> void {
    *out = *state;
    let threadId = SStr { bytes: [0u8; 512], len: 0, has: false };
    let name = SStr { bytes: [0u8; 512], len: 0, has: false };
    if !recStrAlt(params_ptr, params_len, STR_PTR("threadId"), STR_LEN("threadId"), STR_PTR("thread_id"), STR_LEN("thread_id"), &threadId) { return; };
    if !recStr(params_ptr, params_len, STR_PTR("name"), STR_LEN("name"), &name) { return; };
    for i in 0..out.threads_len {
        if sstrEqC(&out.threads[i].id, &threadId) { out.threads[i].title = name; out.threads[i].name = name; out.threads[i].preview = name; };
    }
}

// TS branch: method === "thread/archived" || method === "thread/deleted"
fn applyNotifThreadArchivedOrDeleted(state: &ClientState, params_ptr: ptr, params_len: u64, isDeleted: bool, out: &ClientState) -> void {
    *out = *state;
    let threadId = SStr { bytes: [0u8; 512], len: 0, has: false };
    if !recStrAlt(params_ptr, params_len, STR_PTR("threadId"), STR_LEN("threadId"), STR_PTR("thread_id"), STR_LEN("thread_id"), &threadId) { return; };
    startupStagesDelete(out, sstrPtrC(&threadId), threadId.len);
    if out.activeThreadId.has && sstrEqC(&out.activeThreadId, &threadId) { out.activeThreadId.has = false; out.activeThreadId.len = 0; };
    let w: u64 = 0;
    for i in 0..out.threads_len {
        if !sstrEqC(&out.threads[i].id, &threadId) { out.threads[w] = out.threads[i]; w = w + 1; };
    }
    out.threads_len = w;
    if isDeleted {
        let tw: u64 = 0;
        for i in 0..out.turns_len {
            let t = &out.turns_items[i];
            let same = t.threadId_len == threadId.len;
            if same { for j in 0..threadId.len { if t.threadId_bytes[j] != threadId.bytes[j] { same = false; }; }; };
            if !same { out.turns_items[tw] = out.turns_items[i]; tw = tw + 1; };
        }
        out.turns_len = tw;
    };
}

// TS branch: method === "mini/item/rollback"
fn applyNotifMiniRollback(state: &ClientState, params_ptr: ptr, params_len: u64, out: &ClientState) -> void {
    *out = *state;
    let threadId = SStr { bytes: [0u8; 512], len: 0, has: false };
    let hasThread = recStrAlt(params_ptr, params_len, STR_PTR("threadId"), STR_LEN("threadId"), STR_PTR("thread_id"), STR_LEN("thread_id"), &threadId);
    let turnId = SStr { bytes: [0u8; 512], len: 0, has: false };
    if !recStrAlt(params_ptr, params_len, STR_PTR("turnId"), STR_LEN("turnId"), STR_PTR("turn_id"), STR_LEN("turn_id"), &turnId) { return; };
    // DEFECT: Set<string> of itemIds -> the raw JSON array text; membership
    // is tested per item id against the array's string elements (fix phase:
    // btree_set.sa).
    let idsVal = JsonBufC { bytes: [0u8; 16384], len: 0 };
    if !recVal(params_ptr, params_len, STR_PTR("itemIds"), STR_LEN("itemIds"), &idsVal) {
        if !recVal(params_ptr, params_len, STR_PTR("item_ids"), STR_LEN("item_ids"), &idsVal) { return; };
    };
    let count = sa_json_array_len(jsonPtrC(&idsVal), idsVal.len);
    if count == 0 { return; };
    for ti in 0..out.turns_len {
        let turn = &out.turns_items[ti];
        if !turnIdEq(turn, sstrPtrC(&turnId), turnId.len) { continue; };
        if hasThread {
            let same = turn.threadId_len == threadId.len;
            if same { for j in 0..threadId.len { if turn.threadId_bytes[j] != threadId.bytes[j] { same = false; }; }; };
            if !same { continue; };
        };
        let w: u64 = 0;
        for ii in 0..turn.items_len {
            let item = &turn.items_items[ii];
            let ip: ptr = PTR_NULL();
            PTR_BYTE_ADD(ip, &item.id_bytes, 0);
            let drop = false;
            for k in 0..count {
                let ev = JsonBufSmallC { bytes: [0u8; 2048], len: 0 };
                let ep: ptr = PTR_NULL();
                let el: u64 = 0;
                if sa_json_array_at_value_text(jsonPtrC(&idsVal), idsVal.len, k, &ep, &el) == 0 {
                    jsonBufSetSmallC(&ev, ep, el);
                    let es = SStr { bytes: [0u8; 512], len: 0, has: false };
                    if jsonValueStr(bigPtrSmallC(&ev), ev.len, &es) && es.len == item.id_len {
                        let same = true;
                        for j in 0..es.len { if es.bytes[j] != item.id_bytes[j] { same = false; }; };
                        if same { drop = true; };
                    };
                };
            }
            if !drop { turn.items_items[w] = turn.items_items[ii]; w = w + 1; };
        }
        turn.items_len = w;
    }
}

// TS branch: method === "thread/claude/startup"
fn applyNotifClaudeStartup(state: &ClientState, params_ptr: ptr, params_len: u64, now_ms: f64, out: &ClientState) -> void {
    *out = *state;
    let threadId = SStr { bytes: [0u8; 512], len: 0, has: false };
    let stage = SStr { bytes: [0u8; 512], len: 0, has: false };
    if !recStrAlt(params_ptr, params_len, STR_PTR("threadId"), STR_LEN("threadId"), STR_PTR("thread_id"), STR_LEN("thread_id"), &threadId) { return; };
    if !recStr(params_ptr, params_len, STR_PTR("stage"), STR_LEN("stage"), &stage) { return; };
    if !sstrEqLitC(&stage, STR_PTR("spawning"), STR_LEN("spawning")) && !sstrEqLitC(&stage, STR_PTR("handshake"), STR_LEN("handshake")) && !sstrEqLitC(&stage, STR_PTR("ready"), STR_LEN("ready")) && !sstrEqLitC(&stage, STR_PTR("failed"), STR_LEN("failed")) { return; };
    let at = now_ms;
    recNum(params_ptr, params_len, STR_PTR("at"), STR_LEN("at"), &at);
    let error = SStr { bytes: [0u8; 512], len: 0, has: false };
    let hasError = recStr(params_ptr, params_len, STR_PTR("error"), STR_LEN("error"), &error);
    startupStagesSet(out, sstrPtrC(&threadId), threadId.len, sstrPtrC(&stage), stage.len, at, hasError, sstrPtrC(&error), error.len);
}

// TS branch: method === "turn/started"
fn applyNotifTurnStarted(state: &ClientState, params_ptr: ptr, params_len: u64, prov: &ServerStartedTurnIds, now_ms: f64, out: &ClientState) -> void {
    *out = *state;
    let turnVal = JsonBufC { bytes: [0u8; 16384], len: 0 };
    if !recVal(params_ptr, params_len, STR_PTR("turn"), STR_LEN("turn"), &turnVal) { return; };
    let turn = JsonBufC { bytes: [0u8; 16384], len: 0 };
    asRecordC(jsonPtrC(&turnVal), turnVal.len, &turn);
    let tp: ptr = jsonPtrC(&turn);
    let id = SStr { bytes: [0u8; 512], len: 0, has: false };
    if !recStr(tp, turn.len, STR_PTR("id"), STR_LEN("id"), &id) { return; };
    let threadId = SStr { bytes: [0u8; 512], len: 0, has: false };
    let hasThread = recStrAlt(params_ptr, params_len, STR_PTR("threadId"), STR_LEN("threadId"), STR_PTR("thread_id"), STR_LEN("thread_id"), &threadId);
    if !hasThread { hasThread = recStr(tp, turn.len, STR_PTR("threadId"), STR_LEN("threadId"), &threadId); };
    if !hasThread && out.activeThreadId.has { threadId = out.activeThreadId; hasThread = true; };
    if !hasThread { return; };
    let existingIdx: u64 = 0;
    if stateFindTurn(out, sstrPtrC(&id), id.len, &existingIdx) {
        let ex = &out.turns_items[existingIdx];
        if ex.has_status {
            let st = SStr { bytes: [0u8; 512], len: 0, has: false };
            st.len = ex.status_len;
            st.has = true;
            for j in 0..ex.status_len { st.bytes[j] = ex.status_bytes[j]; }
            if isInterruptedWorkbenchStatus(sstrPtrC(&st), st.len) { return; };
        };
    };
    startupStagesDelete(out, sstrPtrC(&threadId), threadId.len);
    let startedAt: f64 = 0.0;
    if recNum(tp, turn.len, STR_PTR("startedAt"), STR_LEN("startedAt"), &startedAt) {
        serverStartedAdd(prov, sstrPtrC(&id), id.len);
    } else {
        serverStartedRemove(prov, sstrPtrC(&id), id.len);
        startedAt = @ts_math_rounding(now_ms / 1000.0, 0);
    };
    out.activeThreadId = threadId;
    let incoming = WorkbenchTurn { id_bytes: [0u8; 128], id_len: 0, threadId_bytes: [0u8; 128], threadId_len: 0, has_status: false, status_bytes: [0u8; 64], status_len: 0, has_startedAt: false, startedAt: 0.0, has_completedAt: false, completedAt: 0.0, items_items: [WorkbenchItem { id_bytes: [0u8; 128], id_len: 0, type_bytes: [0u8; 64], type_len: 0, title_bytes: [0u8; 256], title_len: 0, text_bytes: [0u8; 8192], text_len: 0, has_status: false, status_bytes: [0u8; 64], status_len: 0, has_startedAt: false, startedAt: 0.0, has_completedAt: false, completedAt: 0.0, has_firstTokenAt: false, firstTokenAt: 0.0, has_updatedAt: false, updatedAt: 0.0, has_agentId: false, agentId_bytes: [0u8; 128], agentId_len: 0, has_agentThreadId: false, agentThreadId_bytes: [0u8; 128], agentThreadId_len: 0, has_agentName: false, agentName_bytes: [0u8; 256], agentName_len: 0, has_agentRole: false, agentRole_bytes: [0u8; 128], agentRole_len: 0, has_agentStatus: false, agentStatus_bytes: [0u8; 64], agentStatus_len: 0, has_images: false, images_count: 0, images_json_bytes: [0u8; 4096], images_json_len: 0, has_files: false, files_count: 0, files_json_bytes: [0u8; 4096], files_json_len: 0, has_payload: false, payload_bytes: [0u8; 4096], payload_len: 0 }; 128], items_len: 0 };
    workbenchTurnClear(&incoming);
    turnSetId(&incoming, sstrPtrC(&id), id.len);
    turnSetThreadId(&incoming, sstrPtrC(&threadId), threadId.len);
    turnSetStatus(&incoming, true, STR_PTR("inProgress"), STR_LEN("inProgress"));
    incoming.has_startedAt = true;
    incoming.startedAt = startedAt;
    stateUpsertTurn(out, &incoming);
}

