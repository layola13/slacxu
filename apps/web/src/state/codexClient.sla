// TS (line 2030): export function saveThreadAgentRoster(token, threadId, roles, options)
// Body: JSON.stringify({ roles, startImmediate: options.startImmediate ?? true })
// DEFECT: dynamic JSON body assembly via assumed sa_json_object_set_value_text.
fn saveThreadAgentRoster(token_ptr: ptr, token_len: u64, threadId_ptr: ptr, threadId_len: u64, roles_json: &JsonBufC, hasStartImmediate: bool, startImmediate: bool, out: &JsonBufC, err: &ProjectApiError) -> i32 {
    let body = JsonBufC { bytes: [0u8; 16384], len: 0 };
    jsonBufSetC(&body, STR_PTR("{}"), STR_LEN("{}"));
    let rp: ptr = PTR_NULL();
    PTR_BYTE_ADD(rp, &roles_json.bytes, 0);
    let bp: ptr = PTR_NULL();
    let bl: u64 = 0;
    let cur = JsonBufC { bytes: [0u8; 16384], len: 0 };
    jsonBufCopyC(&cur, &body);
    let cp: ptr = PTR_NULL();
    PTR_BYTE_ADD(cp, &cur.bytes, 0);
    if sa_json_object_set_value_text(cp, cur.len, STR_PTR("roles"), STR_LEN("roles"), rp, roles_json.len, &bp, &bl) == 0 { jsonBufSetC(&cur, bp, bl); };
    let si_ptr = STR_PTR("true");
    let si_len = STR_LEN("true");
    if hasStartImmediate && !startImmediate { si_ptr = STR_PTR("false"); si_len = STR_LEN("false"); };
    let cp2: ptr = PTR_NULL();
    PTR_BYTE_ADD(cp2, &cur.bytes, 0);
    if sa_json_object_set_value_text(cp2, cur.len, STR_PTR("startImmediate"), STR_LEN("startImmediate"), si_ptr, si_len, &bp, &bl) == 0 { jsonBufSetC(&cur, bp, bl); };
    let path = BigStrC { bytes: [0u8; 8192], len: 0 };
    threadAgentRosterPath(threadId_ptr, threadId_len, &path);
    let pp: ptr = PTR_NULL();
    PTR_BYTE_ADD(pp, &path.bytes, 0);
    let bbp: ptr = PTR_NULL();
    PTR_BYTE_ADD(bbp, &cur.bytes, 0);
    return projectRequest(token_ptr, token_len, pp, path.len, STR_PTR("PUT"), STR_LEN("PUT"), true, bbp, cur.len, out, err);
}

