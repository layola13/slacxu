// Maps one flat settings record to a RelaySettingsListEntry — the TS
// body.data.map(...) body of fetchRelaySettingsListFromPath, field by field.
fn relaySettingsListEntryFromRecord(item_ptr: ptr, item_len: u64, out: &RelaySettingsListEntry) -> void {
    let vp: ptr = PTR_NULL();
    let vl: u64 = 0;
    let num: f64 = 0.0;
    let flag = false;
    // firstGroupId / firstGroupName / firstGroupRatio
    out.relayList.firstGroupId.has = sa_json_object_get_string(item_ptr, item_len, STR_PTR("firstGroupId"), STR_LEN("firstGroupId"), &vp, &vl) == 0;
    if out.relayList.firstGroupId.has { sstrSet(&out.relayList.firstGroupId, vp, vl); } else { out.relayList.firstGroupId.len = 0; };
    out.relayList.firstGroupName.has = sa_json_object_get_string(item_ptr, item_len, STR_PTR("firstGroupName"), STR_LEN("firstGroupName"), &vp, &vl) == 0;
    if out.relayList.firstGroupName.has { sstrSet(&out.relayList.firstGroupName, vp, vl); } else { out.relayList.firstGroupName.len = 0; };
    out.relayList.firstGroupRatio = 1.0;
    if sa_json_object_get_number(item_ptr, item_len, STR_PTR("firstGroupRatio"), STR_LEN("firstGroupRatio"), &num) == 0 { out.relayList.firstGroupRatio = num; };
    // id: String(item.providerId ?? "")
    if sa_json_object_get_string(item_ptr, item_len, STR_PTR("providerId"), STR_LEN("providerId"), &vp, &vl) == 0 { sstrSet(&out.id, vp, vl); } else { out.id.has = true; out.id.len = 0; };
    // name: String(item.providerName ?? item.providerId ?? "")
    if sa_json_object_get_string(item_ptr, item_len, STR_PTR("providerName"), STR_LEN("providerName"), &vp, &vl) == 0 { sstrSet(&out.name, vp, vl); } else { out.name = out.id; };
    // kind: item.kind as ProviderConfig["kind"] (unchecked cast — raw string)
    if sa_json_object_get_string(item_ptr, item_len, STR_PTR("kind"), STR_LEN("kind"), &vp, &vl) == 0 { sstrSet(&out.kind, vp, vl); } else { out.kind.has = false; out.kind.len = 0; };
    out.baseUrl.has = sa_json_object_get_string(item_ptr, item_len, STR_PTR("baseUrl"), STR_LEN("baseUrl"), &vp, &vl) == 0;
    if out.baseUrl.has { sstrSet(&out.baseUrl, vp, vl); };
    // apiKeyPreview: item.apiKeyConfigured === true ? "configured" : undefined
    let keyConfigured = false;
    sa_json_object_get_bool(item_ptr, item_len, STR_PTR("apiKeyConfigured"), STR_LEN("apiKeyConfigured"), &keyConfigured);
    if keyConfigured { sstrSetLit(&out.apiKeyPreview, STR_PTR("configured"), STR_LEN("configured")); } else { out.apiKeyPreview.has = false; out.apiKeyPreview.len = 0; };
    out.defaultModel.has = sa_json_object_get_string(item_ptr, item_len, STR_PTR("defaultModel"), STR_LEN("defaultModel"), &vp, &vl) == 0;
    if out.defaultModel.has { sstrSet(&out.defaultModel, vp, vl); };
    // groups: firstGroupId ? [ { ... } ] : []  (nativeModels/modelAliases/keys/models are all [] in TS)
    out.groups_len = 0;
    if out.relayList.firstGroupId.has && out.relayList.firstGroupId.len > 0 {
        let g = &out.groups[0];
        g.id = out.relayList.firstGroupId;
        if out.relayList.firstGroupName.has { g.name = out.relayList.firstGroupName; } else { g.name = out.relayList.firstGroupId; };
        sstrSetLit(&g.kind, STR_PTR("text"), STR_LEN("text"));
        let enabledFlag = true;
        if sa_json_object_get_bool(item_ptr, item_len, STR_PTR("enabled"), STR_LEN("enabled"), &flag) == 0 { enabledFlag = flag; };
        if enabledFlag { sstrSetLit(&g.status, STR_PTR("enabled"), STR_LEN("enabled")); } else { sstrSetLit(&g.status, STR_PTR("disabled"), STR_LEN("disabled")); };
