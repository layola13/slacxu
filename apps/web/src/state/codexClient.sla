fn normalizeWebSocketRuntime(hasRuntime: bool, runtime: &WebSocketRuntimeConfig, out: &WebSocketRuntimeConfig) -> void {
    if !hasRuntime { defaultWebSocketRuntime(out); return; };
    let defaults = WebSocketRuntimeConfig { profile: SStr { bytes: [0u8; 512], len: 0, has: false }, platform: SStr { bytes: [0u8; 512], len: 0, has: false }, path: SStr { bytes: [0u8; 512], len: 0, has: false }, heartbeatIntervalMs: 0.0, heartbeatTimeoutMs: 0.0, handshakeTimeoutMs: 0.0, reconnectBaseDelayMs: 0.0, reconnectMaxDelayMs: 0.0 };
    defaultWebSocketRuntime(&defaults);
    let heartbeatIntervalMs = positiveRuntimeNumber(runtime.heartbeatIntervalMs, true, defaults.heartbeatIntervalMs);
    let reconnectBaseDelayMs = positiveRuntimeNumber(runtime.reconnectBaseDelayMs, true, defaults.reconnectBaseDelayMs);
    out.profile = runtime.profile;
    out.platform = runtime.platform;
    if runtime.path.has && runtime.path.len > 0 { out.path = runtime.path; } else { out.path = defaults.path; };
    out.heartbeatIntervalMs = heartbeatIntervalMs;
    let ht = positiveRuntimeNumber(runtime.heartbeatTimeoutMs, true, defaults.heartbeatTimeoutMs);
    if heartbeatIntervalMs * 2.0 > ht { ht = heartbeatIntervalMs * 2.0; };
    out.heartbeatTimeoutMs = ht;
    out.handshakeTimeoutMs = positiveRuntimeNumber(runtime.handshakeTimeoutMs, true, defaults.handshakeTimeoutMs);
    out.reconnectBaseDelayMs = reconnectBaseDelayMs;
    let rm = positiveRuntimeNumber(runtime.reconnectMaxDelayMs, true, defaults.reconnectMaxDelayMs);
