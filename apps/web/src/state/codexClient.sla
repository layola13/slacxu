// Routes one dispatched server message to pending provider ops (the TS
// per-call "server-message" listeners).
fn codexSocketClientOnServerMessage(client: &CodexSocketClient, msg_ptr: ptr, msg_len: u64) -> void {
    let typeStr = SStr { bytes: [0u8; 512], len: 0, has: false };
    let tp: ptr = PTR_NULL();
    let tl: u64 = 0;
    if sa_json_object_get_string(msg_ptr, msg_len, STR_PTR("type"), STR_LEN("type"), &tp, &tl) != 0 { return; };
    sstrSet(&typeStr, tp, tl);
    let idStr = SStr { bytes: [0u8; 512], len: 0, has: false };
    let ip: ptr = PTR_NULL();
    let il: u64 = 0;
    let hasId = sa_json_object_get_string(msg_ptr, msg_len, STR_PTR("id"), STR_LEN("id"), &ip, &il) == 0;
    if hasId { sstrSet(&idStr, ip, il); };
    let isError = sstrEq(&typeStr, STR_PTR("server.error"), STR_LEN("server.error"));
    let successKind: u64 = 99;
    let resultKey_ptr = STR_PTR("");
    let resultKey_len: u64 = 0;
    if sstrEq(&typeStr, STR_PTR("provider.saved"), STR_LEN("provider.saved")) { successKind = 0; resultKey_ptr = STR_PTR("provider"); resultKey_len = STR_LEN("provider"); };
    if sstrEq(&typeStr, STR_PTR("provider.activated"), STR_LEN("provider.activated")) { successKind = 1; resultKey_ptr = STR_PTR("activation"); resultKey_len = STR_LEN("activation"); };
    if sstrEq(&typeStr, STR_PTR("provider.deleted"), STR_LEN("provider.deleted")) { successKind = 2; resultKey_ptr = STR_PTR("providerId"); resultKey_len = STR_LEN("providerId"); };
    if sstrEq(&typeStr, STR_PTR("provider.trashed"), STR_LEN("provider.trashed")) { successKind = 3; resultKey_ptr = STR_PTR("providerId"); resultKey_len = STR_LEN("providerId"); };
    if sstrEq(&typeStr, STR_PTR("provider.restored"), STR_LEN("provider.restored")) { successKind = 4; resultKey_ptr = STR_PTR("provider"); resultKey_len = STR_LEN("provider"); };
    if !isError && successKind == 99 { return; };
    if !hasId { return; };
    for i in 0..client.providerOps_len {
        let op = &client.providerOps[i];
        let opIdPtr: ptr = PTR_NULL();
        PTR_BYTE_ADD(opIdPtr, &op.id.bytes, 0);
        if !bytesEq(opIdPtr, op.id.len, ip, il) { continue; };
        if isError {
            // reject(new Error(formatErrorText(detail.message)))
            let mp: ptr = PTR_NULL();
            let ml: u64 = 0;
            let errText = BigStrC { bytes: [0u8; 8192], len: 0 };
            if sa_json_object_get_value_text(msg_ptr, msg_len, STR_PTR("message"), STR_LEN("message"), &mp, &ml) == 0 {
                formatErrorTextValue(mp, ml, &errText);
            };
            let ep: ptr = PTR_NULL();
            PTR_BYTE_ADD(ep, &errText.bytes, 0);
            codexSocketClientQueueProviderOutcome(client, opIdPtr, op.id.len, op.kind, true, false, STR_PTR(""), 0, ep, errText.len);
            codexSocketClientRemoveProviderOp(client, i);
            return;
        };
        if op.kind != successKind { continue; };
        let rp: ptr = PTR_NULL();
        let rl: u64 = 0;
        if sa_json_object_get_value_text(msg_ptr, msg_len, resultKey_ptr, resultKey_len, &rp, &rl) != 0 { rp = STR_PTR(""); rl = 0; };
        // For deleted/trashed the resolved value is the providerId string;
        // its JSON text is stored (string contents) — callers read result_json.
        codexSocketClientQueueProviderOutcome(client, opIdPtr, op.id.len, op.kind, false, false, rp, rl, STR_PTR(""), 0);
        codexSocketClientRemoveProviderOp(client, i);
        return;
    }
}

// TS: private handleMessage(raw: string): void
fn codexSocketClientHandleMessage(client: &CodexSocketClient, raw_ptr: ptr, raw_len: u64, now_ms: f64) -> void {
    client.lastServerActivityAt = now_ms;
    client.has_heartbeatProbeStartedAt = false;
    codexSocketClientClearResumeProbeTimer(client);
    // const message = JSON.parse(raw) as ServerToClientMessage;
    let typeStr = SStr { bytes: [0u8; 512], len: 0, has: false };
    let tp: ptr = PTR_NULL();
    let tl: u64 = 0;
    if sa_json_object_get_string(raw_ptr, raw_len, STR_PTR("type"), STR_LEN("type"), &tp, &tl) == 0 { sstrSet(&typeStr, tp, tl); };
    if sstrEq(&typeStr, STR_PTR("heartbeat.ping"), STR_LEN("heartbeat.ping")) {
        let idPtr: ptr = PTR_NULL();
        let idLen: u64 = 0;
        sa_json_object_get_string(raw_ptr, raw_len, STR_PTR("id"), STR_LEN("id"), &idPtr, &idLen);
        let sentAt: f64 = 0.0;
        sa_json_object_get_number(raw_ptr, raw_len, STR_PTR("sentAt"), STR_LEN("sentAt"), &sentAt);
        codexSocketClientSendHeartbeatPong(client, idPtr, idLen, sentAt, now_ms);
        return;
    };
    if sstrEq(&typeStr, STR_PTR("heartbeat.pong"), STR_LEN("heartbeat.pong")) { return; };
    codexSocketClientDispatch(client, STR_PTR("server-message"), STR_LEN("server-message"), raw_ptr, raw_len);
    codexSocketClientOnServerMessage(client, raw_ptr, raw_len);
    if sstrEq(&typeStr, STR_PTR("rpc.result"), STR_LEN("rpc.result")) {
        let idPtr: ptr = PTR_NULL();
        let idLen: u64 = 0;
        if sa_json_object_get_string(raw_ptr, raw_len, STR_PTR("id"), STR_LEN("id"), &idPtr, &idLen) == 0 {
            let rp: ptr = PTR_NULL();
            let rl: u64 = 0;
            if sa_json_object_get_value_text(raw_ptr, raw_len, STR_PTR("result"), STR_LEN("result"), &rp, &rl) != 0 { rp = STR_PTR("null"); rl = STR_LEN("null"); };
            // pending?.resolve(message.result) — queued even when no pending
            // entry exists in TS the resolve is a no-op; queueing is guarded:
            let wasPending = codexSocketClientRemovePending(client, idPtr, idLen);
            if wasPending { codexSocketClientQueueRpcOutcome(client, idPtr, idLen, false, rp, rl, STR_PTR(""), 0); };
        };
        return;
    };
    if sstrEq(&typeStr, STR_PTR("rpc.error"), STR_LEN("rpc.error")) {
        let idPtr: ptr = PTR_NULL();
        let idLen: u64 = 0;
        if sa_json_object_get_string(raw_ptr, raw_len, STR_PTR("id"), STR_LEN("id"), &idPtr, &idLen) == 0 {
            let ep: ptr = PTR_NULL();
            let el: u64 = 0;
            if sa_json_object_get_value_text(raw_ptr, raw_len, STR_PTR("error"), STR_LEN("error"), &ep, &el) != 0 { ep = STR_PTR("null"); el = STR_LEN("null"); };
            let wasPending = codexSocketClientRemovePending(client, idPtr, idLen);
            if wasPending { codexSocketClientQueueRpcOutcome(client, idPtr, idLen, true, STR_PTR(""), 0, ep, el); };
        };
        return;
    };
}

// TS: private scheduleReconnect(): void
fn codexSocketClientScheduleReconnect(client: &CodexSocketClient, now_ms: f64) -> void {
    if !client.token.has || client.has_reconnectTimer { return; };
    if !client.navigatorOnline {
        codexSocketClientDispatchConnectionStatus(client, STR_PTR("disconnected"), STR_LEN("disconnected"), false, 0.0, false, 0.0, STR_PTR("Browser is offline"), STR_LEN("Browser is offline"), now_ms);
        client.has_reconnectTimer = true;
        client.reconnectTimerIsOfflineWait = true;
        client.reconnectTimerDueMs = now_ms + client.websocketRuntime.reconnectMaxDelayMs;
        return;
    };
    let delay = computeReconnectDelay(client.reconnectAttempt as f64, client.websocketRuntime.reconnectBaseDelayMs, client.websocketRuntime.reconnectMaxDelayMs);
    client.reconnectAttempt = client.reconnectAttempt + 1;
    codexSocketClientDispatchConnectionStatus(client, STR_PTR("reconnecting"), STR_LEN("reconnecting"), true, client.reconnectAttempt as f64, true, delay, STR_PTR("WebSocket disconnected"), STR_LEN("WebSocket disconnected"), now_ms);
    let ev = BigStrC { bytes: [0u8; 8192], len: 0 };
    bigStrAppend(&ev, STR_PTR("{\"attempt\":"), STR_LEN("{\"attempt\":"));
    bigStrAppendU64(&ev, client.reconnectAttempt);
    bigStrAppend(&ev, STR_PTR(",\"delayMs\":"), STR_LEN(",\"delayMs\":"));
    bigStrAppendU64(&ev, delay as u64);
    bigStrAppend(&ev, STR_PTR("}"), STR_LEN("}"));
    let ep: ptr = PTR_NULL();
    PTR_BYTE_ADD(ep, &ev.bytes, 0);
    codexSocketClientDispatch(client, STR_PTR("reconnecting"), STR_LEN("reconnecting"), ep, ev.len);
    client.has_reconnectTimer = true;
    client.reconnectTimerIsOfflineWait = false;
    client.reconnectTimerDueMs = now_ms + delay;
}

// TS: private clearReconnectTimer(): void
fn codexSocketClientClearReconnectTimer(client: &CodexSocketClient) -> void {
    client.has_reconnectTimer = false;
}

// TS: private startHeartbeat(socket): void
fn codexSocketClientStartHeartbeat(client: &CodexSocketClient, handle: u64, now_ms: f64) -> void {
    codexSocketClientStopHeartbeat(client, false, 0);
    client.lastServerActivityAt = now_ms;
    client.has_heartbeatProbeStartedAt = false;
    client.has_heartbeatTimer = true;
    client.heartbeatNextMs = now_ms + client.websocketRuntime.heartbeatIntervalMs;
}

// TS: private stopHeartbeat(socket?): void
fn codexSocketClientStopHeartbeat(client: &CodexSocketClient, hasSocketArg: bool, handle: u64) -> void {
    if hasSocketArg && (!client.has_socket || client.socket_handle != handle) { return; };
    client.has_heartbeatProbeStartedAt = false;
    client.has_heartbeatTimer = false;
}

// One heartbeat interval firing (from tick) — TS setInterval body.
fn codexSocketClientHeartbeatTick(client: &CodexSocketClient, handle: u64, now_ms: f64) -> void {
    if !client.has_socket || client.socket_handle != handle || socketReadyState(client) != 1 {
        codexSocketClientStopHeartbeat(client, true, handle);
        return;
    };
    let probeStarted: f64 = 0.0;
    let hasProbe = client.has_heartbeatProbeStartedAt;
    if hasProbe { probeStarted = client.heartbeatProbeStartedAt; };
    let state = evaluateHeartbeatState(now_ms, client.lastServerActivityAt, hasProbe, probeStarted, &client.websocketRuntime, client.documentVisible);
    if state == 2 {
        // DEFECT: console.warn dropped (no console in this pass).
        codexSocketClientDispatchConnectionStatus(client, STR_PTR("disconnected"), STR_LEN("disconnected"), false, 0.0, false, 0.0, STR_PTR("Heartbeat probe timed out"), STR_LEN("Heartbeat probe timed out"), now_ms);
        dispatchBoolEvent(client, STR_PTR("connected"), STR_LEN("connected"), false);
        codexSocketClientRejectPending(client, STR_PTR("WebSocket disconnected: heartbeat probe timed out"), STR_LEN("WebSocket disconnected: heartbeat probe timed out"));
        sa_ws_close(handle, 4000, STR_PTR("Heartbeat probe timed out"), STR_LEN("Heartbeat probe timed out"));
        return;
    };
    if state == 1 && !client.has_heartbeatProbeStartedAt {
        client.has_heartbeatProbeStartedAt = true;
        client.heartbeatProbeStartedAt = now_ms;
    };
    // Only send one client probe right when the probe starts.
    if state != 1 || !client.has_heartbeatProbeStartedAt || client.heartbeatProbeStartedAt != now_ms { return; };
    if codexSocketClientSendHeartbeatPing(client, handle, now_ms) != 0 {
        codexSocketClientDispatchConnectionStatus(client, STR_PTR("disconnected"), STR_LEN("disconnected"), false, 0.0, false, 0.0, STR_PTR("Heartbeat send failed"), STR_LEN("Heartbeat send failed"), now_ms);
        dispatchBoolEvent(client, STR_PTR("connected"), STR_LEN("connected"), false);
        codexSocketClientRejectPending(client, STR_PTR("WebSocket disconnected: heartbeat send failed"), STR_LEN("WebSocket disconnected: heartbeat send failed"));
        sa_ws_close(handle, 4000, STR_PTR("Heartbeat send failed"), STR_LEN("Heartbeat send failed"));
        return;
    };
    codexSocketClientArmResumeProbe(client, handle, now_ms);
}

// TS: private sendHeartbeatPong(id, sentAt): void
fn codexSocketClientSendHeartbeatPong(client: &CodexSocketClient, id_ptr: ptr, id_len: u64, sentAt: f64, now_ms: f64) -> void {
    if !client.has_socket || socketReadyState(client) != 1 { return; };
    let b = BigStrC { bytes: [0u8; 8192], len: 0 };
    bigStrAppend(&b, STR_PTR("{\"type\":\"heartbeat.pong\",\"id\":\""), STR_LEN("{\"type\":\"heartbeat.pong\",\"id\":\""));
    bigStrAppend(&b, id_ptr, id_len);
    bigStrAppend(&b, STR_PTR("\",\"sentAt\":"), STR_LEN("\",\"sentAt\":"));
    bigStrAppendU64(&b, sentAt as u64);
    bigStrAppend(&b, STR_PTR(",\"receivedAt\":"), STR_LEN(",\"receivedAt\":"));
    bigStrAppendU64(&b, now_ms as u64);
    bigStrAppend(&b, STR_PTR("}"), STR_LEN("}"));
    let bp: ptr = PTR_NULL();
    PTR_BYTE_ADD(bp, &b.bytes, 0);
    if codexSocketClientSend(client, bp, b.len) != 0 {
        codexSocketClientDispatchConnectionStatus(client, STR_PTR("disconnected"), STR_LEN("disconnected"), false, 0.0, false, 0.0, STR_PTR("Heartbeat pong failed"), STR_LEN("Heartbeat pong failed"), now_ms);
        dispatchBoolEvent(client, STR_PTR("connected"), STR_LEN("connected"), false);
        codexSocketClientRejectPending(client, STR_PTR("WebSocket disconnected: heartbeat pong failed"), STR_LEN("WebSocket disconnected: heartbeat pong failed"));
        sa_ws_close(client.socket_handle, 4000, STR_PTR("Heartbeat pong failed"), STR_LEN("Heartbeat pong failed"));
    };
}

// TS: private sendHeartbeatPing(socket, sentAt = Date.now()): void
// (TS lets socket.send throw; the rc surfaces that failure to callers.)
fn codexSocketClientSendHeartbeatPing(client: &CodexSocketClient, handle: u64, sentAt: f64) -> i32 {
    let b = BigStrC { bytes: [0u8; 8192], len: 0 };
    bigStrAppend(&b, STR_PTR("{\"type\":\"heartbeat.ping\",\"id\":\"client-"), STR_LEN("{\"type\":\"heartbeat.ping\",\"id\":\"client-"));
    bigStrAppendU64(&b, sentAt as u64);
    bigStrAppend(&b, STR_PTR("-"), STR_LEN("-"));
    bigStrAppendU64(&b, client.heartbeatSequence);
    client.heartbeatSequence = client.heartbeatSequence + 1;
    bigStrAppend(&b, STR_PTR("\",\"sentAt\":"), STR_LEN("\",\"sentAt\":"));
    bigStrAppendU64(&b, sentAt as u64);
    bigStrAppend(&b, STR_PTR("}"), STR_LEN("}"));
    let bp: ptr = PTR_NULL();
    PTR_BYTE_ADD(bp, &b.bytes, 0);
    if !client.has_socket || client.socket_handle != handle { return 1; };
    return sa_ws_send(handle, bp, b.len);
}

// TS: private rejectPending(message: string): void
fn codexSocketClientRejectPending(client: &CodexSocketClient, message_ptr: ptr, message_len: u64) -> void {
    if client.pending_len == 0 { return; };
    // const error = { code: -32000, message };
    let eb = BigStrC { bytes: [0u8; 8192], len: 0 };
    bigStrAppend(&eb, STR_PTR("{\"code\":-32000,\"message\":\""), STR_LEN("{\"code\":-32000,\"message\":\""));
    bigStrAppend(&eb, message_ptr, message_len);
    bigStrAppend(&eb, STR_PTR("\"}"), STR_LEN("\"}"));
    let ep: ptr = PTR_NULL();
    PTR_BYTE_ADD(ep, &eb.bytes, 0);
    for i in 0..client.pending_len {
        let idPtr: ptr = PTR_NULL();
        PTR_BYTE_ADD(idPtr, &client.pending[i].id.bytes, 0);
        codexSocketClientQueueRpcOutcome(client, idPtr, client.pending[i].id.len, true, STR_PTR(""), 0, ep, eb.len);
    }
    client.pending_len = 0;
}

// TS: private attachRecoveryListeners / detachRecoveryListeners
// DEFECT: window/document event listeners — the host registers them and
// calls handleBrowserOnline/Offline/VisibilityChange; the attached flag is
// kept here exactly as in TS.
fn codexSocketClientAttachRecoveryListeners(client: &CodexSocketClient) -> void {
    if client.recoveryListenersAttached { return; };
    client.recoveryListenersAttached = true;
}

fn codexSocketClientDetachRecoveryListeners(client: &CodexSocketClient) -> void {
    if !client.recoveryListenersAttached { return; };
    client.recoveryListenersAttached = false;
}

// TS: private handleBrowserOnline = () => { this.reconnectNow("Network connection restored"); }
fn codexSocketClientHandleBrowserOnline(client: &CodexSocketClient, now_ms: f64) -> void {
    client.navigatorOnline = true;
    codexSocketClientReconnectNow(client, STR_PTR("Network connection restored"), STR_LEN("Network connection restored"), now_ms);
}

// TS: private handleBrowserOffline = () => { ... }
fn codexSocketClientHandleBrowserOffline(client: &CodexSocketClient, now_ms: f64) -> void {
    client.navigatorOnline = false;
    codexSocketClientClearReconnectTimer(client);
    codexSocketClientDispatchConnectionStatus(client, STR_PTR("disconnected"), STR_LEN("disconnected"), false, 0.0, false, 0.0, STR_PTR("Browser is offline"), STR_LEN("Browser is offline"), now_ms);
    if client.has_socket {
        let state = socketReadyState(client);
        if state != 3 && state != 2 { sa_ws_close(client.socket_handle, 4000, STR_PTR("Browser is offline"), STR_LEN("Browser is offline")); };
    };
}

// TS: private handleVisibilityChange = () => { ... }
// (document.visibilityState arrives as client.documentVisible, set by host.)
fn codexSocketClientHandleVisibilityChange(client: &CodexSocketClient, now_ms: f64) -> void {
    if !client.documentVisible || client.closedByClient || !client.token.has { return; };
    if client.has_socket && socketReadyState(client) == 1 {
        if now_ms - client.lastServerActivityAt <= client.websocketRuntime.heartbeatTimeoutMs { return; };
        if !client.has_heartbeatProbeStartedAt {
            client.has_heartbeatProbeStartedAt = true;
            client.heartbeatProbeStartedAt = now_ms;
        };
        if codexSocketClientSendHeartbeatPing(client, client.socket_handle, now_ms) != 0 {
            sa_ws_close(client.socket_handle, 4000, STR_PTR("Heartbeat probe failed after resume"), STR_LEN("Heartbeat probe failed after resume"));
            return;
        };
        codexSocketClientArmResumeProbe(client, client.socket_handle, now_ms);
        return;
    };
    if !client.has_socket || socketReadyState(client) == 3 {
        codexSocketClientReconnectNow(client, STR_PTR("Window resumed"), STR_LEN("Window resumed"), now_ms);
        return;
    };
    let openStarted: f64 = 0.0;
    let hasOpenStarted = client.has_openStartedAt;
    if hasOpenStarted { openStarted = client.openStartedAt; };
    if isStaleHandshake(hasOpenStarted, openStarted, now_ms, client.websocketRuntime.handshakeTimeoutMs, true, 1000.0) {
        if client.has_socket { sa_ws_close(client.socket_handle, 4000, STR_PTR("Stale handshake after resume"), STR_LEN("Stale handshake after resume")); };
        client.has_socket = false;
        client.socket_handle = 0;
        client.has_connectPromise = false;
        client.has_openStartedAt = false;
        codexSocketClientScheduleReconnect(client, now_ms);
    };
}

// TS: private reconnectNow(reason: string): void
fn codexSocketClientReconnectNow(client: &CodexSocketClient, reason_ptr: ptr, reason_len: u64, now_ms: f64) -> void {
    if !client.token.has || client.closedByClient || client.has_connectPromise { return; };
    if client.has_socket && socketReadyState(client) == 1 { return; };
    if !client.navigatorOnline { return; };
    codexSocketClientClearReconnectTimer(client);
    codexSocketClientDispatchConnectionStatus(client, STR_PTR("reconnecting"), STR_LEN("reconnecting"), true, (client.reconnectAttempt + 1) as f64, true, 0.0, reason_ptr, reason_len, now_ms);
    // this.connectPromise = this.openSocket(this.token).catch(...)
    let tp: ptr = PTR_NULL();
    PTR_BYTE_ADD(tp, &client.token.bytes, 0);
    let tl = client.token.len;
