// TS (line 135): export async function fetchFreebuffSessionStatus(token)
// DEFECT: async. Result delivered as raw_json plus the scalar fields the
// fallback logic reads (model/freebucks/prices/rateLimits are re-read from
// raw_json by findBestFreebuffFallback through the sa_json helpers).
fn fetchFreebuffSessionStatus(token_ptr: ptr, token_len: u64, out: &FreebuffSessionStatus, err: &SStr) -> i32 {
    let resp = HttpResponse { status: 0, body: JsonBufC { bytes: [0u8; 16384], len: 0 } };
    if httpFetchJson(STR_PTR("GET"), STR_LEN("GET"), STR_PTR("/api/codex/freebuff/session"), STR_LEN("/api/codex/freebuff/session"), token_ptr, token_len, false, STR_PTR(""), 0, &resp) != 0 { sstrSetLit(err, STR_PTR("Failed to fetch Freebuff session"), STR_LEN("Failed to fetch Freebuff session")); return 1; };
    let data = JsonBufC { bytes: [0u8; 16384], len: 0 };
    if !fetchDataField(&resp, err, STR_PTR("Failed to fetch Freebuff session"), STR_LEN("Failed to fetch Freebuff session"), &data) { return 1; };
    jsonBufCopyC(&out.raw_json, &data);
    return 0;
}

// TS (line 147): export async function releaseFreebuffSessionSlot(token):
//   Promise<{ released: boolean; message?: string }>
// DEFECT: async.
fn releaseFreebuffSessionSlot(token_ptr: ptr, token_len: u64, out_released: &bool, out_message: &SStr, err: &SStr) -> i32 {
    let resp = HttpResponse { status: 0, body: JsonBufC { bytes: [0u8; 16384], len: 0 } };
    if httpFetchJson(STR_PTR("POST"), STR_LEN("POST"), STR_PTR("/api/codex/freebuff/session/release"), STR_LEN("/api/codex/freebuff/session/release"), token_ptr, token_len, true, STR_PTR("{}"), STR_LEN("{}"), &resp) != 0 { sstrSetLit(err, STR_PTR("Failed to release Freebuff session"), STR_LEN("Failed to release Freebuff session")); return 1; };
    let data = JsonBufC { bytes: [0u8; 16384], len: 0 };
    if !fetchDataField(&resp, err, STR_PTR("Failed to release Freebuff session"), STR_LEN("Failed to release Freebuff session"), &data) { return 1; };
    let dp: ptr = PTR_NULL();
    PTR_BYTE_ADD(dp, &data.bytes, 0);
    let released = false;
    sa_json_object_get_bool(dp, data.len, STR_PTR("released"), STR_LEN("released"), &released);
    *out_released = released;
    let mp: ptr = PTR_NULL();
    let ml: u64 = 0;
    out_message.has = sa_json_object_get_string(dp, data.len, STR_PTR("message"), STR_LEN("message"), &mp, &ml) == 0;
    if out_message.has { sstrSet(out_message, mp, ml); };
    return 0;
}

// TS (line 160): export async function fetchClineBalance(token, forceRefresh = false)
// DEFECT: async.
fn fetchClineBalance(token_ptr: ptr, token_len: u64, forceRefresh: bool, out: &ClineBalanceInfo, err: &SStr) -> i32 {
    let url_ptr = STR_PTR("/api/codex/cline/balance");
    let url_len = STR_LEN("/api/codex/cline/balance");
    if forceRefresh { url_ptr = STR_PTR("/api/codex/cline/balance?refresh=1"); url_len = STR_LEN("/api/codex/cline/balance?refresh=1"); };
    let resp = HttpResponse { status: 0, body: JsonBufC { bytes: [0u8; 16384], len: 0 } };
    if httpFetchJson(STR_PTR("GET"), STR_LEN("GET"), url_ptr, url_len, token_ptr, token_len, false, STR_PTR(""), 0, &resp) != 0 { sstrSetLit(err, STR_PTR("Failed to fetch Cline balance"), STR_LEN("Failed to fetch Cline balance")); return 1; };
    let data = JsonBufC { bytes: [0u8; 16384], len: 0 };
    if !fetchDataField(&resp, err, STR_PTR("Failed to fetch Cline balance"), STR_LEN("Failed to fetch Cline balance"), &data) { return 1; };
    jsonBufCopyC(&out.raw_json, &data);
    return 0;
}

// TS (line 173): export function findBestFreebuffFallback(currentModel, status)
//   : { id: string; name: string; price: number } | null
struct FreebuffFallback {
    id: SStr,
    name: SStr,
    price: f64,
}

// Default price table (TS object literal before the status spread).
fn freebuffDefaultPrice(model_ptr: ptr, model_len: u64, out: &f64) -> bool {
    if bytesEq(model_ptr, model_len, STR_PTR("upstage/solar-pro4"), STR_LEN("upstage/solar-pro4")) { *out = 0.0; return true; };
    if bytesEq(model_ptr, model_len, STR_PTR("upstage/solar-pro-4"), STR_LEN("upstage/solar-pro-4")) { *out = 0.0; return true; };
    if bytesEq(model_ptr, model_len, STR_PTR("z-ai/glm-5.3-flash"), STR_LEN("z-ai/glm-5.3-flash")) { *out = 5.0; return true; };
    if bytesEq(model_ptr, model_len, STR_PTR("mimo/mimo-v2.5"), STR_LEN("mimo/mimo-v2.5")) { *out = 10.0; return true; };
    if bytesEq(model_ptr, model_len, STR_PTR("minimax/minimax-m3"), STR_LEN("minimax/minimax-m3")) { *out = 10.0; return true; };
    if bytesEq(model_ptr, model_len, STR_PTR("openai/gpt-5.6-luna"), STR_LEN("openai/gpt-5.6-luna")) { *out = 20.0; return true; };
    if bytesEq(model_ptr, model_len, STR_PTR("openai/gpt-5.6-luna-es"), STR_LEN("openai/gpt-5.6-luna-es")) { *out = 20.0; return true; };
    if bytesEq(model_ptr, model_len, STR_PTR("deepseek/deepseek-v4-flash"), STR_LEN("deepseek/deepseek-v4-flash")) { *out = 25.0; return true; };
    return false;
}

// prices[model]: status.freebucks.prices overrides defaults (spread order).
fn freebuffPrice(status: &FreebuffSessionStatus, model_ptr: ptr, model_len: u64, out: &f64) -> bool {
    if status.has_freebucks && status.freebucks_prices_json.len > 0 {
        let pp: ptr = PTR_NULL();
        PTR_BYTE_ADD(pp, &status.freebucks_prices_json.bytes, 0);
        if sa_json_object_get_number(pp, status.freebucks_prices_json.len, model_ptr, model_len, out) == 0 { return true; };
    };
    return freebuffDefaultPrice(model_ptr, model_len, out);
}

fn freebuffCandidateAt(index: u64, id_out: &SStr, name_out: &SStr) -> bool {
    if index == 0 { sstrSetLit(id_out, STR_PTR("openai/gpt-5.6-luna"), STR_LEN("openai/gpt-5.6-luna")); sstrSetLit(name_out, STR_PTR("GPT-5.6 Luna"), STR_LEN("GPT-5.6 Luna")); return true; };
    if index == 1 { sstrSetLit(id_out, STR_PTR("mimo/mimo-v2.5"), STR_LEN("mimo/mimo-v2.5")); sstrSetLit(name_out, STR_PTR("Mimo 2.5"), STR_LEN("Mimo 2.5")); return true; };
    if index == 2 { sstrSetLit(id_out, STR_PTR("minimax/minimax-m3"), STR_LEN("minimax/minimax-m3")); sstrSetLit(name_out, STR_PTR("MiniMax M3"), STR_LEN("MiniMax M3")); return true; };
    if index == 3 { sstrSetLit(id_out, STR_PTR("z-ai/glm-5.3-flash"), STR_LEN("z-ai/glm-5.3-flash")); sstrSetLit(name_out, STR_PTR("GLM-5.3 Flash"), STR_LEN("GLM-5.3 Flash")); return true; };
    if index == 4 { sstrSetLit(id_out, STR_PTR("upstage/solar-pro-4"), STR_LEN("upstage/solar-pro-4")); sstrSetLit(name_out, STR_PTR("Solar Pro 4"), STR_LEN("Solar Pro 4")); return true; };
    return false;
}

fn findBestFreebuffFallback(currentModel_ptr: ptr, currentModel_len: u64, hasStatus: bool, status: &FreebuffSessionStatus, out: &FreebuffFallback) -> bool {
    if !hasStatus { return false; };
    // DEFECT: status fields are re-read from status.raw_json here because
    // fetchFreebuffSessionStatus stores the payload as JSON text; the
    // freebucks/rateLimits extraction mirrors the TS property reads.
    let pricesJson = JsonBufSmallC { bytes: [0u8; 2048], len: 0 };
    let balance: f64 = 0.0;
    let rateLimitsJson = JsonBufSmallC { bytes: [0u8; 2048], len: 0 };
    let rp: ptr = PTR_NULL();
    PTR_BYTE_ADD(rp, &status.raw_json.bytes, 0);
    let fbPtr: ptr = PTR_NULL();
    let fbLen: u64 = 0;
    if sa_json_object_get_value_text(rp, status.raw_json.len, STR_PTR("freebucks"), STR_LEN("freebucks"), &fbPtr, &fbLen) == 0 {
        sa_json_object_get_number(fbPtr, fbLen, STR_PTR("balance"), STR_LEN("balance"), &balance);
        let prPtr: ptr = PTR_NULL();
        let prLen: u64 = 0;
        if sa_json_object_get_value_text(fbPtr, fbLen, STR_PTR("prices"), STR_LEN("prices"), &prPtr, &prLen) == 0 {
            let n = prLen;
            if n > 2048 { n = 2048; };
            for j in 0..n { let b: u8 = 0; PTR_BYTE_AT(b, prPtr, j); pricesJson.bytes[j] = b; }
            pricesJson.len = n;
        };
    };
    let rlPtr: ptr = PTR_NULL();
    let rlLen: u64 = 0;
    if sa_json_object_get_value_text(rp, status.raw_json.len, STR_PTR("rateLimitsByModel"), STR_LEN("rateLimitsByModel"), &rlPtr, &rlLen) == 0 {
        let n = rlLen;
        if n > 2048 { n = 2048; };
        for j in 0..n { let b: u8 = 0; PTR_BYTE_AT(b, rlPtr, j); rateLimitsJson.bytes[j] = b; }
        rateLimitsJson.len = n;
    };
    // A status view carrying the extracted JSON slots, for freebuffPrice.
    let view = FreebuffSessionStatus { configured: status.configured, active: status.active, model: status.model, instanceId: status.instanceId, has_expiresAt: status.has_expiresAt, expiresAt: status.expiresAt, has_remainingSeconds: status.has_remainingSeconds, remainingSeconds: status.remainingSeconds, has_isOwned: status.has_isOwned, isOwned: status.isOwned, has_freebucks: true, freebucks_balance: balance, has_freebucks_daily: false, freebucks_daily_limit: 0.0, freebucks_daily_spent: 0.0, freebucks_daily_remaining: 0.0, freebucks_daily_resetAt: status.freebucks_daily_resetAt, has_freebucks_monthly: false, freebucks_monthly_limitUsd: 0.0, freebucks_monthly_spentUsd: 0.0, freebucks_monthly_remainingUsd: 0.0, freebucks_monthly_resetAt: status.freebucks_monthly_resetAt, freebucks_prices_json: pricesJson, freebucks_priceNotices_json: status.freebucks_priceNotices_json, rateLimitsByModel_json: rateLimitsJson, raw_json: status.raw_json };
    let currentPrice: f64 = 25.0;
    let cpFound: f64 = 0.0;
    if freebuffPrice(&view, currentModel_ptr, currentModel_len, &cpFound) { currentPrice = cpFound; };
    for ci in 0..5 {
        let cid = SStr { bytes: [0u8; 512], len: 0, has: false };
        let cname = SStr { bytes: [0u8; 512], len: 0, has: false };
        freebuffCandidateAt(ci, &cid, &cname);
        let cidPtr: ptr = PTR_NULL();
        PTR_BYTE_ADD(cidPtr, &cid.bytes, 0);
        if bytesEq(cidPtr, cid.len, currentModel_ptr, currentModel_len) { continue; };
        let price: f64 = 999.0;
        let pf: f64 = 0.0;
        if freebuffPrice(&view, cidPtr, cid.len, &pf) { price = pf; };
        if price > currentPrice { continue; };
        if price > balance { continue; };
        // const rl = status.rateLimitsByModel?.[c.id];
        if rateLimitsJson.len > 0 {
            let rlp: ptr = PTR_NULL();
            PTR_BYTE_ADD(rlp, &rateLimitsJson.bytes, 0);
            let entryPtr: ptr = PTR_NULL();
            let entryLen: u64 = 0;
            if sa_json_object_get_value_text(rlp, rateLimitsJson.len, cidPtr, cid.len, &entryPtr, &entryLen) == 0 {
                let limit: f64 = 0.0;
                let recent: f64 = 0.0;
                let hasRecent = sa_json_object_get_number(entryPtr, entryLen, STR_PTR("recentCount"), STR_LEN("recentCount"), &recent) == 0;
                sa_json_object_get_number(entryPtr, entryLen, STR_PTR("limit"), STR_LEN("limit"), &limit);
                if limit > 0.0 && hasRecent && recent >= limit { continue; };
            };
        };
        out.id = cid;
        out.name = cname;
        out.price = price;
        return true;
    }
    // const solarPrice = prices["upstage/solar-pro-4"] ?? prices["upstage/solar-pro4"] ?? 0;
    let solarPrice: f64 = 0.0;
    let sp: f64 = 0.0;
    if freebuffPrice(&view, STR_PTR("upstage/solar-pro-4"), STR_LEN("upstage/solar-pro-4"), &sp) { solarPrice = sp; } else {
        if freebuffPrice(&view, STR_PTR("upstage/solar-pro4"), STR_LEN("upstage/solar-pro4"), &sp) { solarPrice = sp; };
    };
    let isSolar4 = bytesEq(currentModel_ptr, currentModel_len, STR_PTR("upstage/solar-pro-4"), STR_LEN("upstage/solar-pro-4"));
    let isSolar = bytesEq(currentModel_ptr, currentModel_len, STR_PTR("upstage/solar-pro4"), STR_LEN("upstage/solar-pro4"));
    if solarPrice <= balance && !isSolar4 && !isSolar {
        sstrSetLit(&out.id, STR_PTR("upstage/solar-pro-4"), STR_LEN("upstage/solar-pro-4"));
        sstrSetLit(&out.name, STR_PTR("Solar Pro 4"), STR_LEN("Solar Pro 4"));
        out.price = solarPrice;
        return true;
    };
    return false;
}

