// from ../goalContinuation and ../planContinuation (their own units); the
// predicates are approximated as false here.
fn isGoalContinuationPrompt(value_ptr: ptr, value_len: u64) -> bool { return false; }
fn isPlanContinuationPrompt(value_ptr: ptr, value_len: u64) -> bool { return false; }
fn isInternalContinuationPrompt(value_ptr: ptr, value_len: u64) -> bool {
    return isGoalContinuationPrompt(value_ptr, value_len) || isPlanContinuationPrompt(value_ptr, value_len);
}

// DEFECT: joinWorkspacePath is imported from ../workspacePaths (its own
// unit); approximated as parent + "/" + name with a trailing-slash check.
fn joinWorkspacePath(parent_ptr: ptr, parent_len: u64, name_ptr: ptr, name_len: u64, out: &SStr) -> void {
    out.has = true;
    out.len = 0;
    for j in 0..parent_len { let b: u8 = 0; PTR_BYTE_AT(b, parent_ptr, j); if out.len < 512 { out.bytes[out.len] = b; out.len = out.len + 1; }; };
    let needSlash = parent_len > 0;
    if parent_len > 0 { let last: u8 = 0; PTR_BYTE_AT(last, parent_ptr, parent_len - 1); if last == 47 { needSlash = false; }; };
    if needSlash && out.len < 512 { out.bytes[out.len] = 47; out.len = out.len + 1; };
    for j in 0..name_len { let b: u8 = 0; PTR_BYTE_AT(b, name_ptr, j); if out.len < 512 { out.bytes[out.len] = b; out.len = out.len + 1; }; };
}
fn joinPath(parent_ptr: ptr, parent_len: u64, name_ptr: ptr, name_len: u64, out: &SStr) -> void { joinWorkspacePath(parent_ptr, parent_len, name_ptr, name_len, out); }

// TS: function firstString(records, keys)
fn firstStringRefs(refs: &[JsonRef; 8], refs_len: u64, keys: &[JsonRef; 6], keys_len: u64, out: &SStr) -> bool {
    for r in 0..refs_len {
        for k in 0..keys_len {
            if recStrNE(refs[r].p, refs[r].l, keys[k].p, keys[k].l, out) { return true; };
        }
    }
    out.has = false;
    out.len = 0;
    return false;
}

// TS: function normalizeAgentItemStatus(value)
fn normalizeAgentItemStatus(value: &SStr, out: &SStr) -> void {
    if sstrEqLitC(value, STR_PTR("started"), STR_LEN("started")) || sstrEqLitC(value, STR_PTR("interacted"), STR_LEN("interacted")) || sstrEqLitC(value, STR_PTR("inProgress"), STR_LEN("inProgress")) || sstrEqLitC(value, STR_PTR("pendingInit"), STR_LEN("pendingInit")) { sstrSetLit(out, STR_PTR("running"), STR_LEN("running")); return; };
    if sstrEqLitC(value, STR_PTR("errored"), STR_LEN("errored")) { sstrSetLit(out, STR_PTR("failed"), STR_LEN("failed")); return; };
    *out = *value;
}

// TS: function stringArrayValue(value) — filter strings, trim, dedupe
// (trim binds @ts_str_trim)
fn stringArrayValueInto(value_ptr: ptr, value_len: u64, out_items: &[SStr; 16], out_len: &u64) -> bool {
    *out_len = 0;
    let count = sa_json_array_len(value_ptr, value_len);
    if value_len == 0 || count == 0 && value_len < 2 { return false; };
    for k in 0..count {
        let evp: ptr = PTR_NULL();
        let evl: u64 = 0;
        if sa_json_array_at_value_text(value_ptr, value_len, k, &evp, &evl) != 0 { continue; };
        let s = SStr { bytes: [0u8; 512], len: 0, has: false };
        if !jsonValueStr(evp, evl, &s) { continue; };
        let tp: ptr = PTR_NULL();
        let tl: u64 = 0;
        @ts_str_trim(sstrPtrC(&s), s.len, &tp, &tl);
        if tl == 0 { continue; };
        let trimmed = SStr { bytes: [0u8; 512], len: 0, has: true };
        trimmed.len = tl;
        for j in 0..tl { let b: u8 = 0; PTR_BYTE_AT(b, tp, j); trimmed.bytes[j] = b; }
        let dup = false;
        for q in 0..*out_len { if sstrEqC(&out_items[q], &trimmed) { dup = true; }; };
        if !dup && *out_len < 16 { out_items[*out_len] = trimmed; *out_len = *out_len + 1; };
    }
    return true;
}

// ---- entry converters ----

fn mcpToolToEntry(tool_ptr: ptr, tool_len: u64, out: &McpToolEntry) -> void {
    out.name.has = false; out.name.len = 0;
    out.title.has = false; out.title.len = 0;
    out.description.has = false; out.description.len = 0;
    out.inputSchema_json.len = 0;
    out.has_outputSchema = false;
    out.outputSchema_json.len = 0;
    out.has_annotations = false;
    out.annotations_json.len = 0;
    if !recStrNE(tool_ptr, tool_len, STR_PTR("name"), STR_LEN("name"), &out.name) { sstrSetLit(&out.name, STR_PTR("unnamed-tool"), STR_LEN("unnamed-tool")); };
    recStrNE(tool_ptr, tool_len, STR_PTR("title"), STR_LEN("title"), &out.title);
    recStrNE(tool_ptr, tool_len, STR_PTR("description"), STR_LEN("description"), &out.description);
    let v = JsonBufC { bytes: [0u8; 16384], len: 0 };
    if recVal(tool_ptr, tool_len, STR_PTR("inputSchema"), STR_LEN("inputSchema"), &v) {
        let n = v.len;
        if n > 2048 { n = 2048; };
        for j in 0..n { out.inputSchema_json.bytes[j] = v.bytes[j]; };
        out.inputSchema_json.len = n;
    } else { jsonBufSetSmallC(&out.inputSchema_json, STR_PTR("{}"), STR_LEN("{}")); };
    if recVal(tool_ptr, tool_len, STR_PTR("outputSchema"), STR_LEN("outputSchema"), &v) {
        out.has_outputSchema = true;
        let n = v.len;
        if n > 2048 { n = 2048; };
        for j in 0..n { out.outputSchema_json.bytes[j] = v.bytes[j]; };
        out.outputSchema_json.len = n;
    };
    if recVal(tool_ptr, tool_len, STR_PTR("annotations"), STR_LEN("annotations"), &v) {
        out.has_annotations = true;
        let n = v.len;
        if n > 2048 { n = 2048; };
        for j in 0..n { out.annotations_json.bytes[j] = v.bytes[j]; };
        out.annotations_json.len = n;
    };
}

fn mcpResourceToEntry(res_ptr: ptr, res_len: u64, out: &McpResourceEntry) -> void {
    out.name.has = false; out.name.len = 0;
    out.title.has = false; out.title.len = 0;
    out.uri.has = false; out.uri.len = 0;
    out.description.has = false; out.description.len = 0;
    if !recStrNE(res_ptr, res_len, STR_PTR("name"), STR_LEN("name"), &out.name) {
        if !recStrNE(res_ptr, res_len, STR_PTR("uri"), STR_LEN("uri"), &out.name) {
            if !recStrNE(res_ptr, res_len, STR_PTR("uriTemplate"), STR_LEN("uriTemplate"), &out.name) { sstrSetLit(&out.name, STR_PTR("resource"), STR_LEN("resource")); };
        };
    };
    recStrNE(res_ptr, res_len, STR_PTR("title"), STR_LEN("title"), &out.title);
    if !recStrNE(res_ptr, res_len, STR_PTR("uri"), STR_LEN("uri"), &out.uri) { recStrNE(res_ptr, res_len, STR_PTR("uriTemplate"), STR_LEN("uriTemplate"), &out.uri); };
    recStrNE(res_ptr, res_len, STR_PTR("description"), STR_LEN("description"), &out.description);
}

fn skillToEntry(skill_ptr: ptr, skill_len: u64, out: &SkillEntry) -> void {
    out.name.has = false; out.name.len = 0;
    out.displayName.has = false; out.displayName.len = 0;
    out.description.has = false; out.description.len = 0;
    out.shortDescription.has = false; out.shortDescription.len = 0;
    out.path.has = false; out.path.len = 0;
    out.scope.has = false; out.scope.len = 0;
    out.enabled = false;
    let ifaceVal = JsonBufC { bytes: [0u8; 16384], len: 0 };
    let iface = JsonBufC { bytes: [0u8; 16384], len: 0 };
    jsonBufSetC(&iface, STR_PTR("{}"), STR_LEN("{}"));
    if recVal(skill_ptr, skill_len, STR_PTR("interface"), STR_LEN("interface"), &ifaceVal) { asRecordC(jsonPtrC(&ifaceVal), ifaceVal.len, &iface); };
    let ip: ptr = jsonPtrC(&iface);
    if !recStrNE(ip, iface.len, STR_PTR("displayName"), STR_LEN("displayName"), &out.displayName) {
        if !recStrNE(skill_ptr, skill_len, STR_PTR("name"), STR_LEN("name"), &out.displayName) { sstrSetLit(&out.displayName, STR_PTR("Unnamed skill"), STR_LEN("Unnamed skill")); };
    };
    if !recStrNE(skill_ptr, skill_len, STR_PTR("name"), STR_LEN("name"), &out.name) { out.name = out.displayName; };
    if !recStrNE(skill_ptr, skill_len, STR_PTR("description"), STR_LEN("description"), &out.description) {
        if !recStrNE(ip, iface.len, STR_PTR("shortDescription"), STR_LEN("shortDescription"), &out.description) { sstrSetLit(&out.description, STR_PTR(""), 0); out.description.has = true; };
    };
    if !recStrNE(skill_ptr, skill_len, STR_PTR("shortDescription"), STR_LEN("shortDescription"), &out.shortDescription) { recStrNE(ip, iface.len, STR_PTR("shortDescription"), STR_LEN("shortDescription"), &out.shortDescription); };
    if !recStrNE(skill_ptr, skill_len, STR_PTR("path"), STR_LEN("path"), &out.path) { sstrSetLit(&out.path, STR_PTR(""), 0); out.path.has = true; };
    if !recStrNE(skill_ptr, skill_len, STR_PTR("scope"), STR_LEN("scope"), &out.scope) { sstrSetLit(&out.scope, STR_PTR("unknown"), STR_LEN("unknown")); };
    let b = false;
    let bv = JsonBufC { bytes: [0u8; 16384], len: 0 };
    if recVal(skill_ptr, skill_len, STR_PTR("enabled"), STR_LEN("enabled"), &bv) && boolValueText(jsonPtrC(&bv), bv.len, &b) { out.enabled = b; };
}

fn hookToEntry(hook_ptr: ptr, hook_len: u64, out: &HookEntry) -> void {
    out.key.has = false; out.key.len = 0;
    out.eventName.has = false; out.eventName.len = 0;
    out.handlerType.has = false; out.handlerType.len = 0;
    out.matcher.has = false; out.matcher.len = 0;
    out.command.has = false; out.command.len = 0;
    out.has_timeoutSec = false; out.timeoutSec = 0.0;
    out.statusMessage.has = false; out.statusMessage.len = 0;
    out.sourcePath.has = false; out.sourcePath.len = 0;
    out.source.has = false; out.source.len = 0;
    out.pluginId.has = false; out.pluginId.len = 0;
    out.has_displayOrder = false; out.displayOrder = 0.0;
    out.enabled = false;
    out.isManaged = false;
    out.currentHash.has = false; out.currentHash.len = 0;
    out.trustStatus.has = false; out.trustStatus.len = 0;
    if !recStrNE(hook_ptr, hook_len, STR_PTR("key"), STR_LEN("key"), &out.key) { sstrSetLit(&out.key, STR_PTR("hook"), STR_LEN("hook")); };
    if !recStrNE(hook_ptr, hook_len, STR_PTR("eventName"), STR_LEN("eventName"), &out.eventName) { sstrSetLit(&out.eventName, STR_PTR("hook"), STR_LEN("hook")); };
    if !recStrNE(hook_ptr, hook_len, STR_PTR("handlerType"), STR_LEN("handlerType"), &out.handlerType) { sstrSetLit(&out.handlerType, STR_PTR("command"), STR_LEN("command")); };
    recStrNE(hook_ptr, hook_len, STR_PTR("matcher"), STR_LEN("matcher"), &out.matcher);
    recStrNE(hook_ptr, hook_len, STR_PTR("command"), STR_LEN("command"), &out.command);
    out.has_timeoutSec = recNum(hook_ptr, hook_len, STR_PTR("timeoutSec"), STR_LEN("timeoutSec"), &out.timeoutSec);
    recStrNE(hook_ptr, hook_len, STR_PTR("statusMessage"), STR_LEN("statusMessage"), &out.statusMessage);
    if !recStrNE(hook_ptr, hook_len, STR_PTR("sourcePath"), STR_LEN("sourcePath"), &out.sourcePath) { sstrSetLit(&out.sourcePath, STR_PTR("unknown"), STR_LEN("unknown")); };
    if !recStrNE(hook_ptr, hook_len, STR_PTR("source"), STR_LEN("source"), &out.source) { sstrSetLit(&out.source, STR_PTR("unknown"), STR_LEN("unknown")); };
    recStrNE(hook_ptr, hook_len, STR_PTR("pluginId"), STR_LEN("pluginId"), &out.pluginId);
    out.has_displayOrder = recNum(hook_ptr, hook_len, STR_PTR("displayOrder"), STR_LEN("displayOrder"), &out.displayOrder);
    let b = false;
    if recBool(hook_ptr, hook_len, STR_PTR("enabled"), STR_LEN("enabled"), &b) { out.enabled = b; };
    if recBool(hook_ptr, hook_len, STR_PTR("isManaged"), STR_LEN("isManaged"), &b) { out.isManaged = b; };
    recStrNE(hook_ptr, hook_len, STR_PTR("currentHash"), STR_LEN("currentHash"), &out.currentHash);
    if !recStrNE(hook_ptr, hook_len, STR_PTR("trustStatus"), STR_LEN("trustStatus"), &out.trustStatus) { sstrSetLit(&out.trustStatus, STR_PTR("unknown"), STR_LEN("unknown")); };
}

// helper: fill an SStr list from a JSON array of values via String(value)
// (DEFECT: String() coercion of non-strings uses the raw JSON text)
fn strListFromArray(arr_ptr: ptr, arr_len: u64, out_items: &[SStr; 32], out_len: &u64, cap: u64) -> void {
    *out_len = 0;
    let count = sa_json_array_len(arr_ptr, arr_len);
    for k in 0..count {
        if *out_len >= cap { break; };
        let evp: ptr = PTR_NULL();
        let evl: u64 = 0;
        if sa_json_array_at_value_text(arr_ptr, arr_len, k, &evp, &evl) != 0 { continue; };
        let s = SStr { bytes: [0u8; 512], len: 0, has: false };
        if jsonValueStr(evp, evl, &s) { out_items[*out_len] = s; *out_len = *out_len + 1; } else {
            s.has = true;
            let n = evl;
            if n > 512 { n = 512; };
            for j in 0..n { let b: u8 = 0; PTR_BYTE_AT(b, evp, j); s.bytes[j] = b; }
            s.len = n;
            out_items[*out_len] = s;
            *out_len = *out_len + 1;
        };
    }
}

fn pluginToEntry(plugin_ptr: ptr, plugin_len: u64, out: &PluginEntry) -> void {
    out.id.has = false; out.id.len = 0;
    out.remotePluginId.has = false; out.remotePluginId.len = 0;
    out.name.has = false; out.name.len = 0;
    out.displayName.has = false; out.displayName.len = 0;
    out.description.has = false; out.description.len = 0;
    out.version.has = false; out.version.len = 0;
    out.localVersion.has = false; out.localVersion.len = 0;
    out.installed = false;
    out.enabled = false;
    out.source.has = false; out.source.len = 0;
    out.availability.has = false; out.availability.len = 0;
    out.authPolicy.has = false; out.authPolicy.len = 0;
    out.installPolicy.has = false; out.installPolicy.len = 0;
    out.installPolicySource.has = false; out.installPolicySource.len = 0;
    out.category.has = false; out.category.len = 0;
    out.developerName.has = false; out.developerName.len = 0;
    out.websiteUrl.has = false; out.websiteUrl.len = 0;
    out.privacyPolicyUrl.has = false; out.privacyPolicyUrl.len = 0;
    out.termsOfServiceUrl.has = false; out.termsOfServiceUrl.len = 0;
    out.defaultPrompt_len = 0;
    out.logoUrl.has = false; out.logoUrl.len = 0;
    out.screenshotUrls_len = 0;
    out.capabilities_len = 0;
    out.keywords_len = 0;
    let ifaceVal = JsonBufC { bytes: [0u8; 16384], len: 0 };
    let iface = JsonBufC { bytes: [0u8; 16384], len: 0 };
    jsonBufSetC(&iface, STR_PTR("{}"), STR_LEN("{}"));
    if recVal(plugin_ptr, plugin_len, STR_PTR("interface"), STR_LEN("interface"), &ifaceVal) { asRecordC(jsonPtrC(&ifaceVal), ifaceVal.len, &iface); };
    let ip: ptr = jsonPtrC(&iface);
    if !recStrNE(plugin_ptr, plugin_len, STR_PTR("id"), STR_LEN("id"), &out.id) {
        if !recStrNE(plugin_ptr, plugin_len, STR_PTR("name"), STR_LEN("name"), &out.id) { sstrSetLit(&out.id, STR_PTR("plugin"), STR_LEN("plugin")); };
    };
    recStrNE(plugin_ptr, plugin_len, STR_PTR("remotePluginId"), STR_LEN("remotePluginId"), &out.remotePluginId);
    if !recStrNE(plugin_ptr, plugin_len, STR_PTR("name"), STR_LEN("name"), &out.name) {
        if !recStrNE(plugin_ptr, plugin_len, STR_PTR("id"), STR_LEN("id"), &out.name) { sstrSetLit(&out.name, STR_PTR("plugin"), STR_LEN("plugin")); };
    };
    if !recStrNE(ip, iface.len, STR_PTR("displayName"), STR_LEN("displayName"), &out.displayName) {
        if !recStrNE(plugin_ptr, plugin_len, STR_PTR("name"), STR_LEN("name"), &out.displayName) { sstrSetLit(&out.displayName, STR_PTR("Plugin"), STR_LEN("Plugin")); };
    };
    if !recStrNE(ip, iface.len, STR_PTR("shortDescription"), STR_LEN("shortDescription"), &out.description) { recStrNE(ip, iface.len, STR_PTR("longDescription"), STR_LEN("longDescription"), &out.description); };
    recStrNE(plugin_ptr, plugin_len, STR_PTR("version"), STR_LEN("version"), &out.version);
    recStrNE(plugin_ptr, plugin_len, STR_PTR("localVersion"), STR_LEN("localVersion"), &out.localVersion);
    let b = false;
    if recBool(plugin_ptr, plugin_len, STR_PTR("installed"), STR_LEN("installed"), &b) { out.installed = b; };
    if recBool(plugin_ptr, plugin_len, STR_PTR("enabled"), STR_LEN("enabled"), &b) { out.enabled = b; };
    let srcVal = JsonBufC { bytes: [0u8; 16384], len: 0 };
    if recVal(plugin_ptr, plugin_len, STR_PTR("source"), STR_LEN("source"), &srcVal) { sourceLabel(jsonPtrC(&srcVal), srcVal.len, &out.source); };
    if !recStrNE(plugin_ptr, plugin_len, STR_PTR("availability"), STR_LEN("availability"), &out.availability) { sstrSetLit(&out.availability, STR_PTR("unknown"), STR_LEN("unknown")); };
    if !recStrNE(plugin_ptr, plugin_len, STR_PTR("authPolicy"), STR_LEN("authPolicy"), &out.authPolicy) { sstrSetLit(&out.authPolicy, STR_PTR("unknown"), STR_LEN("unknown")); };
    if !recStrNE(plugin_ptr, plugin_len, STR_PTR("installPolicy"), STR_LEN("installPolicy"), &out.installPolicy) { sstrSetLit(&out.installPolicy, STR_PTR("unknown"), STR_LEN("unknown")); };
    recStrNE(plugin_ptr, plugin_len, STR_PTR("installPolicySource"), STR_LEN("installPolicySource"), &out.installPolicySource);
    recStrNE(ip, iface.len, STR_PTR("category"), STR_LEN("category"), &out.category);
    recStrNE(ip, iface.len, STR_PTR("developerName"), STR_LEN("developerName"), &out.developerName);
    recStrNE(ip, iface.len, STR_PTR("websiteUrl"), STR_LEN("websiteUrl"), &out.websiteUrl);
    recStrNE(ip, iface.len, STR_PTR("privacyPolicyUrl"), STR_LEN("privacyPolicyUrl"), &out.privacyPolicyUrl);
    recStrNE(ip, iface.len, STR_PTR("termsOfServiceUrl"), STR_LEN("termsOfServiceUrl"), &out.termsOfServiceUrl);
    let arr = JsonBufC { bytes: [0u8; 16384], len: 0 };
    if recVal(ip, iface.len, STR_PTR("defaultPrompt"), STR_LEN("defaultPrompt"), &arr) {
        let items: [SStr; 32] = [SStr { bytes: [0u8; 512], len: 0, has: false }; 32];
        let n: u64 = 0;
        strListFromArray(jsonPtrC(&arr), arr.len, &items, &n, 16);
        for k in 0..n { out.defaultPrompt[k] = items[k]; };
        out.defaultPrompt_len = n;
    };
    if !recStrNE(ip, iface.len, STR_PTR("logoUrl"), STR_LEN("logoUrl"), &out.logoUrl) {
        if !recStrNE(ip, iface.len, STR_PTR("logoUrlDark"), STR_LEN("logoUrlDark"), &out.logoUrl) { recStrNE(ip, iface.len, STR_PTR("composerIconUrl"), STR_LEN("composerIconUrl"), &out.logoUrl); };
    };
    if recVal(ip, iface.len, STR_PTR("screenshotUrls"), STR_LEN("screenshotUrls"), &arr) {
        let items: [SStr; 32] = [SStr { bytes: [0u8; 512], len: 0, has: false }; 32];
        let n: u64 = 0;
        strListFromArray(jsonPtrC(&arr), arr.len, &items, &n, 16);
        for k in 0..n { out.screenshotUrls[k] = items[k]; };
        out.screenshotUrls_len = n;
    };
    if recVal(ip, iface.len, STR_PTR("capabilities"), STR_LEN("capabilities"), &arr) { strListFromArray(jsonPtrC(&arr), arr.len, &out.capabilities, &out.capabilities_len, 32); };
    if recVal(plugin_ptr, plugin_len, STR_PTR("keywords"), STR_LEN("keywords"), &arr) { strListFromArray(jsonPtrC(&arr), arr.len, &out.keywords, &out.keywords_len, 32); };
}

fn marketplaceToEntry(mp_ptr: ptr, mp_len: u64, out: &PluginMarketplace) -> void {
    out.name.has = false; out.name.len = 0;
    out.path.has = false; out.path.len = 0;
    out.displayName.has = false; out.displayName.len = 0;
    out.description.has = false; out.description.len = 0;
    out.plugins_len = 0;
    if !recStrNE(mp_ptr, mp_len, STR_PTR("name"), STR_LEN("name"), &out.name) { sstrSetLit(&out.name, STR_PTR("marketplace"), STR_LEN("marketplace")); };
    recStrNE(mp_ptr, mp_len, STR_PTR("path"), STR_LEN("path"), &out.path);
    let ifaceVal = JsonBufC { bytes: [0u8; 16384], len: 0 };
    if recVal(mp_ptr, mp_len, STR_PTR("interface"), STR_LEN("interface"), &ifaceVal) {
        let iface = JsonBufC { bytes: [0u8; 16384], len: 0 };
        asRecordC(jsonPtrC(&ifaceVal), ifaceVal.len, &iface);
        recStrNE(jsonPtrC(&iface), iface.len, STR_PTR("displayName"), STR_LEN("displayName"), &out.displayName);
    };
    let arr = JsonBufC { bytes: [0u8; 16384], len: 0 };
    if recVal(mp_ptr, mp_len, STR_PTR("plugins"), STR_LEN("plugins"), &arr) {
        let count = sa_json_array_len(jsonPtrC(&arr), arr.len);
        for k in 0..count {
            if out.plugins_len >= 64 { break; };
            let evp: ptr = PTR_NULL();
            let evl: u64 = 0;
            if sa_json_array_at_value_text(jsonPtrC(&arr), arr.len, k, &evp, &evl) != 0 { continue; };
            let rec = JsonBufC { bytes: [0u8; 16384], len: 0 };
            asRecordC(evp, evl, &rec);
            pluginToEntry(jsonPtrC(&rec), rec.len, &out.plugins[out.plugins_len]);
            out.plugins_len = out.plugins_len + 1;
        }
    };
}

