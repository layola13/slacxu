// Shared body of the settings fetch/update pairs:
//   fetch: GET path, body.data?.settings required, else
//          throw body.error || "<Label> CLI settings failed: " + status
//   update: PATCH path with {"enabled": enabled}, else
//          throw body.error || "<Label> CLI settings update failed: " + status
// DEFECT: the settings result is delivered as its `enabled` flag (the only
// field of the settings shape).
fn fetchCliSettings(token_ptr: ptr, token_len: u64, path_ptr: ptr, path_len: u64, label_ptr: ptr, label_len: u64, out_enabled: &bool, err: &SStr) -> i32 {
    let resp = HttpResponse { status: 0, body: JsonBufC { bytes: [0u8; 16384], len: 0 } };
    if httpFetchJson(STR_PTR("GET"), STR_LEN("GET"), path_ptr, path_len, token_ptr, token_len, false, STR_PTR(""), 0, &resp) != 0 { return 1; };
    let data = JsonBufC { bytes: [0u8; 16384], len: 0 };
    let fallback = BigStrC { bytes: [0u8; 8192], len: 0 };
    bigStrAppend(&fallback, label_ptr, label_len);
    bigStrAppend(&fallback, STR_PTR(" CLI settings failed: "), STR_LEN(" CLI settings failed: "));
    let fp: ptr = PTR_NULL();
    PTR_BYTE_ADD(fp, &fallback.bytes, 0);
    if !fetchDataField(&resp, err, fp, fallback.len, &data) { return 1; };
    let dp: ptr = PTR_NULL();
    PTR_BYTE_ADD(dp, &data.bytes, 0);
    let sp: ptr = PTR_NULL();
    let sl: u64 = 0;
    if sa_json_object_get_value_text(dp, data.len, STR_PTR("settings"), STR_LEN("settings"), &sp, &sl) != 0 {
        // body.data?.settings missing -> throw body.error || fallback+status
        let msg = BigStrC { bytes: [0u8; 8192], len: 0 };
        bigStrAppend(&msg, label_ptr, label_len);
        bigStrAppend(&msg, STR_PTR(" CLI settings failed: "), STR_LEN(" CLI settings failed: "));
        bigStrAppendU64(&msg, resp.status);
        let mp: ptr = PTR_NULL();
        PTR_BYTE_ADD(mp, &msg.bytes, 0);
        sstrSet(err, mp, msg.len);
        return 1;
    };
    let enabled = false;
    sa_json_object_get_bool(sp, sl, STR_PTR("enabled"), STR_LEN("enabled"), &enabled);
    *out_enabled = enabled;
    return 0;
}

fn updateCliSettings(token_ptr: ptr, token_len: u64, path_ptr: ptr, path_len: u64, label_ptr: ptr, label_len: u64, enabled: bool, out_enabled: &bool, err: &SStr) -> i32 {
    let body_ptr = STR_PTR("{\"enabled\":true}");
    let body_len = STR_LEN("{\"enabled\":true}");
    if !enabled { body_ptr = STR_PTR("{\"enabled\":false}"); body_len = STR_LEN("{\"enabled\":false}"); };
    let resp = HttpResponse { status: 0, body: JsonBufC { bytes: [0u8; 16384], len: 0 } };
    if httpFetchJson(STR_PTR("PATCH"), STR_LEN("PATCH"), path_ptr, path_len, token_ptr, token_len, true, body_ptr, body_len, &resp) != 0 { return 1; };
    let data = JsonBufC { bytes: [0u8; 16384], len: 0 };
    if !fetchDataField(&resp, err, STR_PTR("CLI settings update failed"), STR_LEN("CLI settings update failed"), &data) {
        // Rebuild the TS fallback message: body.error || label + " CLI settings update failed: " + status
        if err.len == 0 {
            let msg = BigStrC { bytes: [0u8; 8192], len: 0 };
            bigStrAppend(&msg, label_ptr, label_len);
            bigStrAppend(&msg, STR_PTR(" CLI settings update failed: "), STR_LEN(" CLI settings update failed: "));
            bigStrAppendU64(&msg, resp.status);
            let mp: ptr = PTR_NULL();
            PTR_BYTE_ADD(mp, &msg.bytes, 0);
            sstrSet(err, mp, msg.len);
        };
        return 1;
    };
    let dp: ptr = PTR_NULL();
    PTR_BYTE_ADD(dp, &data.bytes, 0);
    let sp: ptr = PTR_NULL();
    let sl: u64 = 0;
    if sa_json_object_get_value_text(dp, data.len, STR_PTR("settings"), STR_LEN("settings"), &sp, &sl) != 0 { return 1; };
    let en = false;
    sa_json_object_get_bool(sp, sl, STR_PTR("enabled"), STR_LEN("enabled"), &en);
    *out_enabled = en;
    return 0;
}

// TS (line 492/502): fetch/updateCodexCompatibleCliSettings — /api/codex/settings/codex-cli, label "Codex"
fn fetchCodexCompatibleCliSettings(token_ptr: ptr, token_len: u64, out: &CodexCompatibleCliSettings, err: &SStr) -> i32 { let e = false; let rc = fetchCliSettings(token_ptr, token_len, STR_PTR("/api/codex/settings/codex-cli"), STR_LEN("/api/codex/settings/codex-cli"), STR_PTR("Codex"), STR_LEN("Codex"), &e, err); out.enabled = e; return rc; }
