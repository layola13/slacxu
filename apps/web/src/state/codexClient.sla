// TS (line 1856): export async function login(email, password, captcha?): Promise<LoginResponse>
// DEFECT: async. The fetch-level catch maps to "登录网络连接失败: <message>";
// the underlying message is unavailable through the extern, so a fixed
// transport note is appended (logged as a defect).
fn login(email_ptr: ptr, email_len: u64, password_ptr: ptr, password_len: u64, hasCaptchaId: bool, captchaId_ptr: ptr, captchaId_len: u64, hasCaptchaAnswer: bool, captchaAnswer_ptr: ptr, captchaAnswer_len: u64, out: &LoginResponse, err: &SStr) -> i32 {
    let b = BigStrC { bytes: [0u8; 8192], len: 0 };
    bigStrAppend(&b, STR_PTR("{\"email\":\""), STR_LEN("{\"email\":\""));
    bigStrAppend(&b, email_ptr, email_len);
    bigStrAppend(&b, STR_PTR("\",\"password\":\""), STR_LEN("\",\"password\":\""));
    bigStrAppend(&b, password_ptr, password_len);
    bigStrAppend(&b, STR_PTR("\""), STR_LEN("\""));
    if hasCaptchaId { bigStrAppend(&b, STR_PTR(",\"captchaId\":\""), STR_LEN(",\"captchaId\":\"")); bigStrAppend(&b, captchaId_ptr, captchaId_len); bigStrAppend(&b, STR_PTR("\""), STR_LEN("\"")); };
    if hasCaptchaAnswer { bigStrAppend(&b, STR_PTR(",\"captchaAnswer\":\""), STR_LEN(",\"captchaAnswer\":\"")); bigStrAppend(&b, captchaAnswer_ptr, captchaAnswer_len); bigStrAppend(&b, STR_PTR("\""), STR_LEN("\"")); };
    bigStrAppend(&b, STR_PTR("}"), STR_LEN("}"));
    let bp: ptr = PTR_NULL();
    PTR_BYTE_ADD(bp, &b.bytes, 0);
    let resp = HttpResponse { status: 0, body: JsonBufC { bytes: [0u8; 16384], len: 0 } };
    if httpFetchJson(STR_PTR("POST"), STR_LEN("POST"), STR_PTR("/api/login"), STR_LEN("/api/login"), STR_PTR(""), 0, true, bp, b.len, &resp) != 0 {
        sstrSetLit(err, STR_PTR("登录网络连接失败: transport error"), STR_LEN("登录网络连接失败: transport error"));
        return 1;
    };
    if !responseOk(&resp) {
        let rp: ptr = PTR_NULL();
        PTR_BYTE_ADD(rp, &resp.body.bytes, 0);
        let ep: ptr = PTR_NULL();
        let el: u64 = 0;
        if sa_json_object_get_string(rp, resp.body.len, STR_PTR("error"), STR_LEN("error"), &ep, &el) == 0 && el > 0 { sstrSet(err, ep, el); return 1; };
        if resp.status == 401 { sstrSetLit(err, STR_PTR("邮箱、密码或验证码错误"), STR_LEN("邮箱、密码或验证码错误")); return 1; };
        if resp.status == 504 || resp.status == 502 || resp.status == 503 {
            let msg = BigStrC { bytes: [0u8; 8192], len: 0 };
            bigStrAppend(&msg, STR_PTR("登录服务网关超时/不可用 ("), STR_LEN("登录服务网关超时/不可用 ("));
            bigStrAppendU64(&msg, resp.status);
            bigStrAppend(&msg, STR_PTR(")，请检查网络或后端代理设置"), STR_LEN(")，请检查网络或后端代理设置"));
            let mp: ptr = PTR_NULL();
            PTR_BYTE_ADD(mp, &msg.bytes, 0);
            sstrSet(err, mp, msg.len);
            return 1;
        };
        let msg = BigStrC { bytes: [0u8; 8192], len: 0 };
        bigStrAppend(&msg, STR_PTR("登录失败 ("), STR_LEN("登录失败 ("));
        bigStrAppendU64(&msg, resp.status);
        bigStrAppend(&msg, STR_PTR(")"), STR_LEN(")"));
        let mp: ptr = PTR_NULL();
        PTR_BYTE_ADD(mp, &msg.bytes, 0);
        sstrSet(err, mp, msg.len);
        return 1;
    };
    jsonBufCopyC(&out.session_json, &resp.body);
    let rp: ptr = PTR_NULL();
    PTR_BYTE_ADD(rp, &resp.body.bytes, 0);
    let r2 = false;
    sa_json_object_get_bool(rp, resp.body.len, STR_PTR("requires_2fa"), STR_LEN("requires_2fa"), &r2);
    out.requires2fa = r2;
    let vp: ptr = PTR_NULL();
    let vl: u64 = 0;
    if sa_json_object_get_string(rp, resp.body.len, STR_PTR("pendingToken"), STR_LEN("pendingToken"), &vp, &vl) == 0 { sstrSet(&out.pendingToken, vp, vl); };
    sa_json_object_get_number(rp, resp.body.len, STR_PTR("expiresAt"), STR_LEN("expiresAt"), &out.expiresAt);
    return 0;
}

