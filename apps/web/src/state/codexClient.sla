// Shared projection of the forward-settings data object. Note the TS fetch
// variant does NOT project forwardRelay while update does — preserve via
// the includeForwardRelay flag.
fn forwardSettingsFromData(data_ptr: ptr, data_len: u64, includeForwardRelay: bool, out: &ForwardSettings) -> void {
    let enabled = false;
    sa_json_object_get_bool(data_ptr, data_len, STR_PTR("enabled"), STR_LEN("enabled"), &enabled);
    out.enabled = enabled;
    let vp: ptr = PTR_NULL();
    let vl: u64 = 0;
    if sa_json_object_get_string(data_ptr, data_len, STR_PTR("baseUrl"), STR_LEN("baseUrl"), &vp, &vl) == 0 { sstrSet(&out.baseUrl, vp, vl); } else { out.baseUrl.has = true; out.baseUrl.len = 0; };
    out.token.has = sa_json_object_get_string(data_ptr, data_len, STR_PTR("token"), STR_LEN("token"), &vp, &vl) == 0;
    if out.token.has { sstrSet(&out.token, vp, vl); } else { out.token.len = 0; };
    out.has_forwardRelay = false;
    if includeForwardRelay {
        let fp: ptr = PTR_NULL();
        let fl: u64 = 0;
        if sa_json_object_get_value_text(data_ptr, data_len, STR_PTR("forwardRelay"), STR_LEN("forwardRelay"), &fp, &fl) == 0 {
            // forwardRelay ?? null — a JSON null reads as absent here
            let isNull = fl == 4;
            if !isNull {
                out.has_forwardRelay = true;
                if sa_json_object_get_string(fp, fl, STR_PTR("providerId"), STR_LEN("providerId"), &vp, &vl) == 0 { sstrSet(&out.forwardRelay.providerId, vp, vl); };
                sa_json_object_get_number(fp, fl, STR_PTR("modelCount"), STR_LEN("modelCount"), &out.forwardRelay.modelCount);
            };
        };
    };
}

