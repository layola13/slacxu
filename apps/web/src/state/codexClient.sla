// Timer driver (no TS counterpart; replaces setTimeout/setInterval and the
// promise .catch chains): the host calls this with the current time.
fn codexSocketClientTick(client: &CodexSocketClient, now_ms: f64) -> void {
    // handshake timeout -> failHandshake("WebSocket connection timed out")
    if client.has_connectPromise && client.has_openStartedAt && now_ms >= client.handshakeDueMs {
        codexSocketClientFailHandshake(client, STR_PTR("WebSocket connection timed out"), STR_LEN("WebSocket connection timed out"), now_ms);
    };
    // rpc timeouts -> reject { code: -32001, message: `Request '<m>' timed out after <s>s` }
    let i: u64 = 0;
    while i < client.pending_len {
        if client.pending[i].has_timeout && now_ms >= client.pending[i].deadlineMs {
            let method = client.pending[i].method;
            let timeoutMs = client.pending[i].timeoutMs;
            let idPtr: ptr = PTR_NULL();
            PTR_BYTE_ADD(idPtr, &client.pending[i].id.bytes, 0);
            let idLen = client.pending[i].id.len;
            let eb = BigStrC { bytes: [0u8; 8192], len: 0 };
            bigStrAppend(&eb, STR_PTR("{\"code\":-32001,\"message\":\"Request '"), STR_LEN("{\"code\":-32001,\"message\":\"Request '"));
            let mp: ptr = PTR_NULL();
            PTR_BYTE_ADD(mp, &method.bytes, 0);
            bigStrAppend(&eb, mp, method.len);
            bigStrAppend(&eb, STR_PTR("' timed out after "), STR_LEN("' timed out after "));
            bigStrAppendU64(&eb, (timeoutMs / 1000.0) as u64);
            bigStrAppend(&eb, STR_PTR("s\"}"), STR_LEN("s\"}"));
            let ep: ptr = PTR_NULL();
            PTR_BYTE_ADD(ep, &eb.bytes, 0);
            codexSocketClientQueueRpcOutcome(client, idPtr, idLen, true, STR_PTR(""), 0, ep, eb.len);
            codexSocketClientRemovePending(client, idPtr, idLen);
            continue;
        };
        i = i + 1;
    }
    // provider op timeouts
    let k: u64 = 0;
    while k < client.providerOps_len {
        if now_ms >= client.providerOps[k].deadlineMs {
            let msg = BigStrC { bytes: [0u8; 8192], len: 0 };
            providerOpTimeoutMessage(client.providerOps[k].kind, client.providerOps[k].timeoutMs, &msg);
            let idPtr: ptr = PTR_NULL();
            PTR_BYTE_ADD(idPtr, &client.providerOps[k].id.bytes, 0);
            let mp: ptr = PTR_NULL();
            PTR_BYTE_ADD(mp, &msg.bytes, 0);
            codexSocketClientQueueProviderOutcome(client, idPtr, client.providerOps[k].id.len, client.providerOps[k].kind, true, true, STR_PTR(""), 0, mp, msg.len);
            codexSocketClientRemoveProviderOp(client, k);
            continue;
        };
        k = k + 1;
    }
    // reconnect timer
    if client.has_reconnectTimer && now_ms >= client.reconnectTimerDueMs {
        client.has_reconnectTimer = false;
        if client.reconnectTimerIsOfflineWait {
            if !client.closedByClient && client.token.has { codexSocketClientScheduleReconnect(client, now_ms); };
        } else {
            if client.token.has && !client.closedByClient && !(client.has_socket && socketReadyState(client) == 1) {
                if client.has_connectPromise || (client.has_socket && (socketReadyState(client) == 0 || socketReadyState(client) == 2)) {
                    codexSocketClientScheduleReconnect(client, now_ms);
                } else {
                    let tp: ptr = PTR_NULL();
                    PTR_BYTE_ADD(tp, &client.token.bytes, 0);
                    let tl = client.token.len;
                    codexSocketClientOpenSocket(client, tp, tl, now_ms);
                };
            };
        };
    };
    // heartbeat interval
    if client.has_heartbeatTimer && client.has_socket && now_ms >= client.heartbeatNextMs {
        client.heartbeatNextMs = now_ms + client.websocketRuntime.heartbeatIntervalMs;
        codexSocketClientHeartbeatTick(client, client.socket_handle, now_ms);
    };
    // resume probe timer
    if client.has_resumeProbeTimer && now_ms >= client.resumeProbeDueMs {
        client.has_resumeProbeTimer = false;
        let handle = client.resumeProbeSocket;
        let sentAt = client.resumeProbeSentAt;
        if client.has_socket && client.socket_handle == handle && socketReadyState(client) == 1 && client.lastServerActivityAt <= sentAt {
            codexSocketClientDispatchConnectionStatus(client, STR_PTR("disconnected"), STR_LEN("disconnected"), false, 0.0, false, 0.0, STR_PTR("Window resume probe timed out"), STR_LEN("Window resume probe timed out"), now_ms);
            dispatchBoolEvent(client, STR_PTR("connected"), STR_LEN("connected"), false);
            codexSocketClientRejectPending(client, STR_PTR("WebSocket disconnected: window resume probe timed out"), STR_LEN("WebSocket disconnected: window resume probe timed out"));
            sa_ws_close(handle, 4000, STR_PTR("Window resume probe timed out"), STR_LEN("Window resume probe timed out"));
        };
    };
}

// TS (line 1490): function rpcTimeoutMs(method: string): number
// DEFECT: the two regex tests (/install|reload|compact|review|shellCommand/i
// and /git|filesystem|directory|file|terminal|command|exec/i) are
// case-insensitive substring searches — implemented by containsCi below.
fn containsCi(hay_ptr: ptr, hay_len: u64, needle_ptr: ptr, needle_len: u64) -> bool {
    if needle_len == 0 { return true; };
    if hay_len < needle_len { return false; };
    let i: u64 = 0;
    while i + needle_len <= hay_len {
        let same = true;
        for j in 0..needle_len {
            let a: u8 = 0;
            let b: u8 = 0;
            PTR_BYTE_AT(a, hay_ptr, i + j);
            PTR_BYTE_AT(b, needle_ptr, j);
            if a >= 65 && a <= 90 { a = a + 32; };
            if b >= 65 && b <= 90 { b = b + 32; };
            if a != b { same = false; };
        }
        if same { return true; };
        i = i + 1;
    }
    return false;
}

fn rpcTimeoutMs(method_ptr: ptr, method_len: u64) -> f64 {
    if bytesEq(method_ptr, method_len, STR_PTR("turn/steer"), STR_LEN("turn/steer")) { return 20000.0; };
    if bytesEq(method_ptr, method_len, STR_PTR("turn/interrupt"), STR_LEN("turn/interrupt")) { return 20000.0; };
    if bytesEq(method_ptr, method_len, STR_PTR("turn/start"), STR_LEN("turn/start")) { return 120000.0; };
    if bytesEq(method_ptr, method_len, STR_PTR("thread/read"), STR_LEN("thread/read")) { return 310000.0; };
    if bytesEq(method_ptr, method_len, STR_PTR("thread/resume"), STR_LEN("thread/resume")) { return 310000.0; };
    if bytesEq(method_ptr, method_len, STR_PTR("thread/turns/list"), STR_LEN("thread/turns/list")) { return 310000.0; };
    if bytesEq(method_ptr, method_len, STR_PTR("thread/items/list"), STR_LEN("thread/items/list")) { return 310000.0; };
    if bytesEq(method_ptr, method_len, STR_PTR("thread/list"), STR_LEN("thread/list")) { return 120000.0; };
    if bytesEq(method_ptr, method_len, STR_PTR("thread/start"), STR_LEN("thread/start")) { return 30000.0; };
    if bytesEq(method_ptr, method_len, STR_PTR("config/batchWrite"), STR_LEN("config/batchWrite")) { return 150000.0; };
    if bytesEq(method_ptr, method_len, STR_PTR("config/value/write"), STR_LEN("config/value/write")) { return 150000.0; };
    if bytesEq(method_ptr, method_len, STR_PTR("plugin/install"), STR_LEN("plugin/install")) { return 610000.0; };
    if bytesEq(method_ptr, method_len, STR_PTR("plugin/uninstall"), STR_LEN("plugin/uninstall")) { return 610000.0; };
    if containsCi(method_ptr, method_len, STR_PTR("install"), STR_LEN("install")) { return 120000.0; };
    if containsCi(method_ptr, method_len, STR_PTR("reload"), STR_LEN("reload")) { return 120000.0; };
    if containsCi(method_ptr, method_len, STR_PTR("compact"), STR_LEN("compact")) { return 120000.0; };
    if containsCi(method_ptr, method_len, STR_PTR("review"), STR_LEN("review")) { return 120000.0; };
    if containsCi(method_ptr, method_len, STR_PTR("shellCommand"), STR_LEN("shellCommand")) { return 120000.0; };
    if containsCi(method_ptr, method_len, STR_PTR("git"), STR_LEN("git")) { return 60000.0; };
    if containsCi(method_ptr, method_len, STR_PTR("filesystem"), STR_LEN("filesystem")) { return 60000.0; };
    if containsCi(method_ptr, method_len, STR_PTR("directory"), STR_LEN("directory")) { return 60000.0; };
    if containsCi(method_ptr, method_len, STR_PTR("file"), STR_LEN("file")) { return 60000.0; };
    if containsCi(method_ptr, method_len, STR_PTR("terminal"), STR_LEN("terminal")) { return 60000.0; };
    if containsCi(method_ptr, method_len, STR_PTR("command"), STR_LEN("command")) { return 60000.0; };
    if containsCi(method_ptr, method_len, STR_PTR("exec"), STR_LEN("exec")) { return 60000.0; };
    return 45000.0;
}

