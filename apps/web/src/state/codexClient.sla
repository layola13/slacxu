    if sstrEqLitC(&ty, STR_PTR("agentMessage"), STR_LEN("agentMessage")) { sstrSetLit(out, STR_PTR("Codex"), STR_LEN("Codex")); return; };
    if sstrEqLitC(&ty, STR_PTR("userMessage"), STR_LEN("userMessage")) { sstrSetLit(out, STR_PTR("User"), STR_LEN("User")); return; };
    if sstrEqLitC(&ty, STR_PTR("commandExecution"), STR_LEN("commandExecution")) { sstrSetLit(out, STR_PTR("Command"), STR_LEN("Command")); return; };
    if sstrEqLitC(&ty, STR_PTR("fileChange"), STR_LEN("fileChange")) { sstrSetLit(out, STR_PTR("File change"), STR_LEN("File change")); return; };
    if sstrEqLitC(&ty, STR_PTR("reasoning"), STR_LEN("reasoning")) { sstrSetLit(out, STR_PTR("Reasoning"), STR_LEN("Reasoning")); return; };
    if sstrEqLitC(&ty, STR_PTR("toolCall"), STR_LEN("toolCall")) || sstrEqLitC(&ty, STR_PTR("toolUse"), STR_LEN("toolUse")) || sstrEqLitC(&ty, STR_PTR("tool_use"), STR_LEN("tool_use")) {
        if !recStrNE(item_ptr, item_len, STR_PTR("toolName"), STR_LEN("toolName"), out) {
            if !recStrNE(item_ptr, item_len, STR_PTR("name"), STR_LEN("name"), out) { sstrSetLit(out, STR_PTR("Tool"), STR_LEN("Tool")); };
        };
        return;
    };
    if sstrEqLitC(&ty, STR_PTR("plan"), STR_LEN("plan")) { sstrSetLit(out, STR_PTR("Plan"), STR_LEN("Plan")); return; };
    if sstrEqLitC(&ty, STR_PTR("contextCompaction"), STR_LEN("contextCompaction")) { sstrSetLit(out, STR_PTR("Context compaction"), STR_LEN("Context compaction")); return; };
    if sstrEqLitC(&ty, STR_PTR("enteredReviewMode"), STR_LEN("enteredReviewMode")) { sstrSetLit(out, STR_PTR("Entered review mode"), STR_LEN("Entered review mode")); return; };
    if sstrEqLitC(&ty, STR_PTR("exitedReviewMode"), STR_LEN("exitedReviewMode")) { sstrSetLit(out, STR_PTR("Exited review mode"), STR_LEN("Exited review mode")); return; };
    if sstrEqLitC(&ty, STR_PTR("mcpToolCall"), STR_LEN("mcpToolCall")) {
        // ["MCP", server, tool].filter(Boolean).join(" / ")
        out.has = true;
        out.len = 0;
        let parts: [SStr; 3] = [SStr { bytes: [0u8; 512], len: 0, has: false }; 3];
        sstrSetLit(&parts[0], STR_PTR("MCP"), STR_LEN("MCP"));
        recStrNE(item_ptr, item_len, STR_PTR("server"), STR_LEN("server"), &parts[1]);
        recStrNE(item_ptr, item_len, STR_PTR("tool"), STR_LEN("tool"), &parts[2]);
        let first = true;
        for k in 0..3 {
            if !parts[k].has { continue; };
            if !first { let sep = STR_PTR(" / "); for j in 0..3 { let b: u8 = 0; PTR_BYTE_AT(b, sep, j); if out.len < 512 { out.bytes[out.len] = b; out.len = out.len + 1; }; }; };
            first = false;
            for j in 0..parts[k].len { if out.len < 512 { out.bytes[out.len] = parts[k].bytes[j]; out.len = out.len + 1; }; };
        }
        return;
    };
    if sstrEqLitC(&ty, STR_PTR("dynamicToolCall"), STR_LEN("dynamicToolCall")) {
        out.has = true;
        out.len = 0;
        let parts: [SStr; 3] = [SStr { bytes: [0u8; 512], len: 0, has: false }; 3];
        sstrSetLit(&parts[0], STR_PTR("Tool"), STR_LEN("Tool"));
        recStrNE(item_ptr, item_len, STR_PTR("namespace"), STR_LEN("namespace"), &parts[1]);
        recStrNE(item_ptr, item_len, STR_PTR("tool"), STR_LEN("tool"), &parts[2]);
        let first = true;
        for k in 0..3 {
            if !parts[k].has { continue; };
            if !first { let sep = STR_PTR(" / "); for j in 0..3 { let b: u8 = 0; PTR_BYTE_AT(b, sep, j); if out.len < 512 { out.bytes[out.len] = b; out.len = out.len + 1; }; }; };
            first = false;
            for j in 0..parts[k].len { if out.len < 512 { out.bytes[out.len] = parts[k].bytes[j]; out.len = out.len + 1; }; };
        }
        return;
    };
    if sstrEqLitC(&ty, STR_PTR("collabAgentToolCall"), STR_LEN("collabAgentToolCall")) { sstrSetLit(out, STR_PTR("Parallel agent"), STR_LEN("Parallel agent")); return; };
    if sstrEqLitC(&ty, STR_PTR("subAgentActivity"), STR_LEN("subAgentActivity")) { sstrSetLit(out, STR_PTR("Agent activity"), STR_LEN("Agent activity")); return; };
    if sstrEqLitC(&ty, STR_PTR("image_generation_call"), STR_LEN("image_generation_call")) || sstrEqLitC(&ty, STR_PTR("imageGeneration"), STR_LEN("imageGeneration")) { sstrSetLit(out, STR_PTR("Image generation"), STR_LEN("Image generation")); return; };
    if sstrEqLitC(&ty, STR_PTR("imageView"), STR_LEN("imageView")) { sstrSetLit(out, STR_PTR("Image view"), STR_LEN("Image view")); return; };
    *out = ty;
}

// TS: function itemText(item)
fn itemText(item_ptr: ptr, item_len: u64, out: &BigStrC) -> void {
    out.len = 0;
    let ty = SStr { bytes: [0u8; 512], len: 0, has: false };
    recStrNE(item_ptr, item_len, STR_PTR("type"), STR_LEN("type"), &ty);
    if sstrEqLitC(&ty, STR_PTR("enteredReviewMode"), STR_LEN("enteredReviewMode")) || sstrEqLitC(&ty, STR_PTR("exitedReviewMode"), STR_LEN("exitedReviewMode")) {
        let v = SStr { bytes: [0u8; 512], len: 0, has: false };
        recStr(item_ptr, item_len, STR_PTR("review"), STR_LEN("review"), &v);
        bigStrAppend(out, sstrPtrC(&v), v.len);
        return;
    };
    if sstrEqLitC(&ty, STR_PTR("image_generation_call"), STR_LEN("image_generation_call")) || sstrEqLitC(&ty, STR_PTR("imageGeneration"), STR_LEN("imageGeneration")) {
        let v = SStr { bytes: [0u8; 512], len: 0, has: false };
        if !recStr(item_ptr, item_len, STR_PTR("revised_prompt"), STR_LEN("revised_prompt"), &v) { recStr(item_ptr, item_len, STR_PTR("revisedPrompt"), STR_LEN("revisedPrompt"), &v); };
        // DEFECT: revised_prompt can exceed the 512-byte SStr cap
        bigStrAppend(out, sstrPtrC(&v), v.len);
        return;
    };
    if sstrEqLitC(&ty, STR_PTR("mcpToolCall"), STR_LEN("mcpToolCall")) {
        let resultVal = JsonBufC { bytes: [0u8; 16384], len: 0 };
        let payload = JsonBufC { bytes: [0u8; 16384], len: 0 };
        jsonBufSetC(&payload, STR_PTR("{}"), STR_LEN("{}"));
        if recVal(item_ptr, item_len, STR_PTR("result"), STR_LEN("result"), &resultVal) { asRecordC(jsonPtrC(&resultVal), resultVal.len, &payload); };
        let errVal = JsonBufC { bytes: [0u8; 16384], len: 0 };
        let errRec = JsonBufC { bytes: [0u8; 16384], len: 0 };
        jsonBufSetC(&errRec, STR_PTR("{}"), STR_LEN("{}"));
        if recVal(item_ptr, item_len, STR_PTR("error"), STR_LEN("error"), &errVal) { asRecordC(jsonPtrC(&errVal), errVal.len, &errRec); };
        let errorMessage = SStr { bytes: [0u8; 512], len: 0, has: false };
        if recStrNE(jsonPtrC(&errRec), errRec.len, STR_PTR("message"), STR_LEN("message"), &errorMessage) { bigStrAppend(out, sstrPtrC(&errorMessage), errorMessage.len); return; };
        let contentVal = JsonBufC { bytes: [0u8; 16384], len: 0 };
        if recVal(jsonPtrC(&payload), payload.len, STR_PTR("content"), STR_LEN("content"), &contentVal) {
            let count = arrCount(jsonPtrC(&contentVal), contentVal.len);
            if count > 0 {
                for k in 0..count {
                    let evp: ptr = PTR_NULL();
                    let evl: u64 = 0;
                    if sa_json_array_at_value_text(jsonPtrC(&contentVal), contentVal.len, k, &evp, &evl) != 0 { continue; };
                    let piece = BigStrC { bytes: [0u8; 8192], len: 0 };
                    summarizeJsonValue(evp, evl, &piece);
                    if piece.len == 0 { continue; };
                    if out.len > 0 { bigStrAppend(out, STR_PTR("\n"), STR_LEN("\n")); };
                    bigStrAppend(out, bigPtrC(&piece), piece.len);
                }
                return;
            };
        };
        let scVal = JsonBufC { bytes: [0u8; 16384], len: 0 };
        if recVal(jsonPtrC(&payload), payload.len, STR_PTR("structuredContent"), STR_LEN("structuredContent"), &scVal) {
            summarizeJsonValue(jsonPtrC(&scVal), scVal.len, out);
            return;
        };
        let argsVal = JsonBufC { bytes: [0u8; 16384], len: 0 };
        if recVal(item_ptr, item_len, STR_PTR("arguments"), STR_LEN("arguments"), &argsVal) {
            summarizeJsonValue(jsonPtrC(&argsVal), argsVal.len, out);
            return;
        };
        return;
    };
    // content: string | content blocks
    let contentVal = JsonBufC { bytes: [0u8; 16384], len: 0 };
    if recVal(item_ptr, item_len, STR_PTR("content"), STR_LEN("content"), &contentVal) {
        let cs = SStr { bytes: [0u8; 512], len: 0, has: false };
        if jsonValueStr(jsonPtrC(&contentVal), contentVal.len, &cs) {
            // DEFECT: string content longer than 512 bytes is truncated here
            bigStrAppend(out, sstrPtrC(&cs), cs.len);
            return;
        };
        let count = arrCount(jsonPtrC(&contentVal), contentVal.len);
        if count > 0 {
            for k in 0..count {
                let block = JsonBufC { bytes: [0u8; 16384], len: 0 };
                if !arrElemRec(jsonPtrC(&contentVal), contentVal.len, k, &block) { continue; };
                let bp: ptr = jsonPtrC(&block);
                let blockType = SStr { bytes: [0u8; 512], len: 0, has: false };
                recStrNE(bp, block.len, STR_PTR("type"), STR_LEN("type"), &blockType);
                if sstrEqLitC(&blockType, STR_PTR("reasoning"), STR_LEN("reasoning")) || sstrEqLitC(&blockType, STR_PTR("reasoning_text"), STR_LEN("reasoning_text")) || sstrEqLitC(&blockType, STR_PTR("thinking"), STR_LEN("thinking")) { continue; };
                let piece = BigStrC { bytes: [0u8; 8192], len: 0 };
                if sstrEqLitC(&blockType, STR_PTR("text"), STR_LEN("text")) || sstrEqLitC(&blockType, STR_PTR("input_text"), STR_LEN("input_text")) || sstrEqLitC(&blockType, STR_PTR("output_text"), STR_LEN("output_text")) || sstrEqLitC(&blockType, STR_PTR("inputText"), STR_LEN("inputText")) || sstrEqLitC(&blockType, STR_PTR("outputText"), STR_LEN("outputText")) {
                    let tv = SStr { bytes: [0u8; 512], len: 0, has: false };
                    recStr(bp, block.len, STR_PTR("text"), STR_LEN("text"), &tv);
                    bigStrAppend(&piece, sstrPtrC(&tv), tv.len);
                } else if sstrEqLitC(&blockType, STR_PTR("localImage"), STR_LEN("localImage")) || sstrEqLitC(&blockType, STR_PTR("image"), STR_LEN("image")) || sstrEqLitC(&blockType, STR_PTR("input_image"), STR_LEN("input_image")) || sstrEqLitC(&blockType, STR_PTR("inputImage"), STR_LEN("inputImage")) {
                    bigStrAppend(&piece, STR_PTR("[image]"), STR_LEN("[image]"));
                } else if sstrEqLitC(&blockType, STR_PTR("skill"), STR_LEN("skill")) || sstrEqLitC(&blockType, STR_PTR("mention"), STR_LEN("mention")) {
                    let nv = SStr { bytes: [0u8; 512], len: 0, has: false };
                    if !recStrNE(bp, block.len, STR_PTR("name"), STR_LEN("name"), &nv) { sstrSetLit(&nv, STR_PTR("mention"), STR_LEN("mention")); };
                    bigStrAppend(&piece, STR_PTR("@"), STR_LEN("@"));
                    bigStrAppend(&piece, sstrPtrC(&nv), nv.len);
                } else {
                    let tv = SStr { bytes: [0u8; 512], len: 0, has: false };
                    recStr(bp, block.len, STR_PTR("text"), STR_LEN("text"), &tv);
                    bigStrAppend(&piece, sstrPtrC(&tv), tv.len);
                };
                if piece.len == 0 { continue; };
                if out.len > 0 { bigStrAppend(out, STR_PTR("\n"), STR_LEN("\n")); };
                bigStrAppend(out, bigPtrC(&piece), piece.len);
            }
            if out.len > 0 { return; };
        };
    };
    let textVal = JsonBufC { bytes: [0u8; 16384], len: 0 };
    if recVal(item_ptr, item_len, STR_PTR("text"), STR_LEN("text"), &textVal) {
        let vp: ptr = PTR_NULL();
        let vl: u64 = 0;
        if sa_json_value_string(jsonPtrC(&textVal), textVal.len, &vp, &vl) == 0 { bigStrAppend(out, vp, vl); return; };
    };
    if sstrEqLitC(&ty, STR_PTR("collabAgentToolCall"), STR_LEN("collabAgentToolCall")) {
        let tool = SStr { bytes: [0u8; 512], len: 0, has: false };
        let prompt = SStr { bytes: [0u8; 512], len: 0, has: false };
        recStrNE(item_ptr, item_len, STR_PTR("tool"), STR_LEN("tool"), &tool);
        recStr(item_ptr, item_len, STR_PTR("prompt"), STR_LEN("prompt"), &prompt);
        if tool.has { bigStrAppend(out, STR_PTR("Tool: "), STR_LEN("Tool: ")); bigStrAppend(out, sstrPtrC(&tool), tool.len); };
        if prompt.has { if out.len > 0 { bigStrAppend(out, STR_PTR("\n"), STR_LEN("\n")); }; bigStrAppend(out, STR_PTR("Prompt: "), STR_LEN("Prompt: ")); bigStrAppend(out, sstrPtrC(&prompt), prompt.len); };
        let recvVal = JsonBufC { bytes: [0u8; 16384], len: 0 };
        if recVal(item_ptr, item_len, STR_PTR("receiverThreadIds"), STR_LEN("receiverThreadIds"), &recvVal) {
            let items: [SStr; 32] = [SStr { bytes: [0u8; 512], len: 0, has: false }; 32];
            let n: u64 = 0;
            strListFromArray(jsonPtrC(&recvVal), recvVal.len, &items, &n, 32);
            let kept: u64 = 0;
            for q in 0..n { if items[q].len > 0 { items[kept] = items[q]; kept = kept + 1; }; };
            if kept > 0 {
                if out.len > 0 { bigStrAppend(out, STR_PTR("\n"), STR_LEN("\n")); };
                bigStrAppend(out, STR_PTR("Agents: "), STR_LEN("Agents: "));
                for q in 0..kept { if q > 0 { bigStrAppend(out, STR_PTR(", "), STR_LEN(", ")); }; bigStrAppend(out, sstrPtrC(&items[q]), items[q].len); };
            };
        };
        return;
    };
    if sstrEqLitC(&ty, STR_PTR("subAgentActivity"), STR_LEN("subAgentActivity")) {
        let kind = SStr { bytes: [0u8; 512], len: 0, has: false };
        let agentPath = SStr { bytes: [0u8; 512], len: 0, has: false };
        recStrNE(item_ptr, item_len, STR_PTR("kind"), STR_LEN("kind"), &kind);
        recStrNE(item_ptr, item_len, STR_PTR("agentPath"), STR_LEN("agentPath"), &agentPath);
        if kind.has { bigStrAppend(out, STR_PTR("Status: "), STR_LEN("Status: ")); bigStrAppend(out, sstrPtrC(&kind), kind.len); };
        if agentPath.has { if out.len > 0 { bigStrAppend(out, STR_PTR("\n"), STR_LEN("\n")); }; bigStrAppend(out, STR_PTR("Agent: "), STR_LEN("Agent: ")); bigStrAppend(out, sstrPtrC(&agentPath), agentPath.len); };
        return;
    };
    let cmdVal = JsonBufC { bytes: [0u8; 16384], len: 0 };
    if recVal(item_ptr, item_len, STR_PTR("command"), STR_LEN("command"), &cmdVal) {
        let items: [SStr; 32] = [SStr { bytes: [0u8; 512], len: 0, has: false }; 32];
        let n: u64 = 0;
        strListFromArray(jsonPtrC(&cmdVal), cmdVal.len, &items, &n, 32);
        if n > 0 {
            for q in 0..n { if q > 0 { bigStrAppend(out, STR_PTR(" "), STR_LEN(" ")); }; bigStrAppend(out, sstrPtrC(&items[q]), items[q].len); };
            return;
        };
    };
    let agg = SStr { bytes: [0u8; 512], len: 0, has: false };
    if recStr(item_ptr, item_len, STR_PTR("aggregatedOutput"), STR_LEN("aggregatedOutput"), &agg) { bigStrAppend(out, sstrPtrC(&agg), agg.len); return; };
}

// JSON object field appenders for the images/files serialization below.
// DEFECT: string values are inserted raw (no JSON escaping).
fn jsonObjStrField(buf: &BigStrC, first: &bool, key_ptr: ptr, key_len: u64, value_ptr: ptr, value_len: u64) -> void {
    if !*first { bigStrAppend(buf, STR_PTR(","), STR_LEN(",")); };
    *first = false;
    bigStrAppend(buf, STR_PTR("\""), STR_LEN("\""));
    bigStrAppend(buf, key_ptr, key_len);
    bigStrAppend(buf, STR_PTR("\":\""), STR_LEN("\":\""));
    bigStrAppend(buf, value_ptr, value_len);
    bigStrAppend(buf, STR_PTR("\""), STR_LEN("\""));
}
fn jsonObjRawField(buf: &BigStrC, first: &bool, key_ptr: ptr, key_len: u64, value_ptr: ptr, value_len: u64) -> void {
    if !*first { bigStrAppend(buf, STR_PTR(","), STR_LEN(",")); };
    *first = false;
    bigStrAppend(buf, STR_PTR("\""), STR_LEN("\""));
    bigStrAppend(buf, key_ptr, key_len);
    bigStrAppend(buf, STR_PTR("\":"), STR_LEN("\":"));
    bigStrAppend(buf, value_ptr, value_len);
}

// TS: function itemImages(item) — serialized into the item's images JSON
fn itemImagesInto(item_ptr: ptr, item_len: u64, item: &WorkbenchItem) -> void {
    item.has_images = false;
    item.images_count = 0;
    item.images_json_len = 0;
    let ty = SStr { bytes: [0u8; 512], len: 0, has: false };
    recStrNE(item_ptr, item_len, STR_PTR("type"), STR_LEN("type"), &ty);
    let buf = BigStrC { bytes: [0u8; 8192], len: 0 };
    if sstrEqLitC(&ty, STR_PTR("imageView"), STR_LEN("imageView")) {
        let path = SStr { bytes: [0u8; 512], len: 0, has: false };
        if !recStrNE(item_ptr, item_len, STR_PTR("path"), STR_LEN("path"), &path) { return; };
        bigStrAppend(&buf, STR_PTR("[{"), STR_LEN("[{"));
        let first = true;
        jsonObjStrField(&buf, &first, STR_PTR("url"), STR_LEN("url"), sstrPtrC(&path), path.len);
        jsonObjStrField(&buf, &first, STR_PTR("name"), STR_LEN("name"), sstrPtrC(&path), path.len);
        bigStrAppend(&buf, STR_PTR("}]"), STR_LEN("}]"));
        item.has_images = true;
        item.images_count = 1;
    } else if sstrEqLitC(&ty, STR_PTR("image_generation_call"), STR_LEN("image_generation_call")) || sstrEqLitC(&ty, STR_PTR("imageGeneration"), STR_LEN("imageGeneration")) {
        let savedPath = SStr { bytes: [0u8; 512], len: 0, has: false };
        if !recStrNE(item_ptr, item_len, STR_PTR("savedPath"), STR_LEN("savedPath"), &savedPath) { recStrNE(item_ptr, item_len, STR_PTR("saved_path"), STR_LEN("saved_path"), &savedPath); };
        let b64 = SStr { bytes: [0u8; 512], len: 0, has: false };
        // DEFECT: b64 result longer than 512 bytes is not visible through
        // this read; the TS length window is (0, 4096) on the trimmed text.
        recStr(item_ptr, item_len, STR_PTR("result"), STR_LEN("result"), &b64);
        let url = BigStrC { bytes: [0u8; 8192], len: 0 };
        let hasUrl = false;
        if savedPath.has { bigStrAppend(&url, sstrPtrC(&savedPath), savedPath.len); hasUrl = true; } else if b64.has {
            let tp: ptr = PTR_NULL();
            let tl: u64 = 0;
            @ts_str_trim(sstrPtrC(&b64), b64.len, &tp, &tl);
            if tl > 0 && tl < 4096 { bigStrAppend(&url, STR_PTR("data:image/png;base64,"), STR_LEN("data:image/png;base64,")); bigStrAppend(&url, tp, tl); hasUrl = true; };
        };
        if !hasUrl { return; };
        bigStrAppend(&buf, STR_PTR("[{"), STR_LEN("[{"));
        let first = true;
        jsonObjStrField(&buf, &first, STR_PTR("url"), STR_LEN("url"), bigPtrC(&url), url.len);
        jsonObjStrField(&buf, &first, STR_PTR("name"), STR_LEN("name"), STR_PTR("generated-image.png"), STR_LEN("generated-image.png"));
        let v = SStr { bytes: [0u8; 512], len: 0, has: false };
        if recStrNE(item_ptr, item_len, STR_PTR("revised_prompt"), STR_LEN("revised_prompt"), &v) || recStrNE(item_ptr, item_len, STR_PTR("revisedPrompt"), STR_LEN("revisedPrompt"), &v) { jsonObjStrField(&buf, &first, STR_PTR("revisedPrompt"), STR_LEN("revisedPrompt"), sstrPtrC(&v), v.len); };
        if recStrNE(item_ptr, item_len, STR_PTR("model"), STR_LEN("model"), &v) { jsonObjStrField(&buf, &first, STR_PTR("model"), STR_LEN("model"), sstrPtrC(&v), v.len); };
        if recStrNE(item_ptr, item_len, STR_PTR("provider_name"), STR_LEN("provider_name"), &v) || recStrNE(item_ptr, item_len, STR_PTR("providerName"), STR_LEN("providerName"), &v) { jsonObjStrField(&buf, &first, STR_PTR("providerName"), STR_LEN("providerName"), sstrPtrC(&v), v.len); };
        let raw = JsonBufC { bytes: [0u8; 16384], len: 0 };
        if recVal(item_ptr, item_len, STR_PTR("estimated_cost_usd"), STR_LEN("estimated_cost_usd"), &raw) || recVal(item_ptr, item_len, STR_PTR("estimatedCostUsd"), STR_LEN("estimatedCostUsd"), &raw) { jsonObjRawField(&buf, &first, STR_PTR("estimatedCostUsd"), STR_LEN("estimatedCostUsd"), jsonPtrC(&raw), raw.len); };
        if recVal(item_ptr, item_len, STR_PTR("image_unit_price_usd"), STR_LEN("image_unit_price_usd"), &raw) || recVal(item_ptr, item_len, STR_PTR("imageUnitPriceUsd"), STR_LEN("imageUnitPriceUsd"), &raw) { jsonObjRawField(&buf, &first, STR_PTR("unitPriceUsd"), STR_LEN("unitPriceUsd"), jsonPtrC(&raw), raw.len); };
        bigStrAppend(&buf, STR_PTR("}]"), STR_LEN("}]"));
        item.has_images = true;
        item.images_count = 1;
    } else {
        let contentVal = JsonBufC { bytes: [0u8; 16384], len: 0 };
        if !recVal(item_ptr, item_len, STR_PTR("content"), STR_LEN("content"), &contentVal) { return; };
        let count = arrCount(jsonPtrC(&contentVal), contentVal.len);
        bigStrAppend(&buf, STR_PTR("["), STR_LEN("["));
        let emitted: u64 = 0;
        for k in 0..count {
            let block = JsonBufC { bytes: [0u8; 16384], len: 0 };
            if !arrElemRec(jsonPtrC(&contentVal), contentVal.len, k, &block) { continue; };
            let bp: ptr = jsonPtrC(&block);
            let blockType = SStr { bytes: [0u8; 512], len: 0, has: false };
            recStrNE(bp, block.len, STR_PTR("type"), STR_LEN("type"), &blockType);
            let url = SStr { bytes: [0u8; 512], len: 0, has: false };
            let name = SStr { bytes: [0u8; 512], len: 0, has: false };
            let detail = SStr { bytes: [0u8; 512], len: 0, has: false };
            let ok = false;
            if sstrEqLitC(&blockType, STR_PTR("image"), STR_LEN("image")) {
                ok = recStrNE(bp, block.len, STR_PTR("url"), STR_LEN("url"), &url);
                recStrNE(bp, block.len, STR_PTR("detail"), STR_LEN("detail"), &detail);
            } else if sstrEqLitC(&blockType, STR_PTR("input_image"), STR_LEN("input_image")) || sstrEqLitC(&blockType, STR_PTR("inputImage"), STR_LEN("inputImage")) {
                if !recStrNE(bp, block.len, STR_PTR("image_url"), STR_LEN("image_url"), &url) {
                    if !recStrNE(bp, block.len, STR_PTR("imageUrl"), STR_LEN("imageUrl"), &url) { recStrNE(bp, block.len, STR_PTR("url"), STR_LEN("url"), &url); };
                };
                ok = url.has;
                recStrNE(bp, block.len, STR_PTR("detail"), STR_LEN("detail"), &detail);
            } else if sstrEqLitC(&blockType, STR_PTR("localImage"), STR_LEN("localImage")) {
                ok = recStrNE(bp, block.len, STR_PTR("path"), STR_LEN("path"), &url);
                name = url;
                recStrNE(bp, block.len, STR_PTR("detail"), STR_LEN("detail"), &detail);
            };
            if !ok { continue; };
            if emitted > 0 { bigStrAppend(&buf, STR_PTR(","), STR_LEN(",")); };
            bigStrAppend(&buf, STR_PTR("{"), STR_LEN("{"));
            let first = true;
            jsonObjStrField(&buf, &first, STR_PTR("url"), STR_LEN("url"), sstrPtrC(&url), url.len);
            if name.has { jsonObjStrField(&buf, &first, STR_PTR("name"), STR_LEN("name"), sstrPtrC(&name), name.len); };
            if detail.has { jsonObjStrField(&buf, &first, STR_PTR("detail"), STR_LEN("detail"), sstrPtrC(&detail), detail.len); };
            bigStrAppend(&buf, STR_PTR("}"), STR_LEN("}"));
            emitted = emitted + 1;
        }
        bigStrAppend(&buf, STR_PTR("]"), STR_LEN("]"));
        if emitted == 0 { return; };
        item.has_images = true;
        item.images_count = emitted;
    };
    let n = buf.len;
    if n > 4096 { n = 4096; };
    for j in 0..n { item.images_json_bytes[j] = buf.bytes[j]; };
    item.images_json_len = n;
}

// TS: function itemFiles(item) — serialized into the item's files JSON
fn itemFilesInto(item_ptr: ptr, item_len: u64, item: &WorkbenchItem) -> void {
    item.has_files = false;
    item.files_count = 0;
    item.files_json_len = 0;
    let contentVal = JsonBufC { bytes: [0u8; 16384], len: 0 };
    if !recVal(item_ptr, item_len, STR_PTR("content"), STR_LEN("content"), &contentVal) { return; };
    let count = arrCount(jsonPtrC(&contentVal), contentVal.len);
    let buf = BigStrC { bytes: [0u8; 8192], len: 0 };
    bigStrAppend(&buf, STR_PTR("["), STR_LEN("["));
    let emitted: u64 = 0;
    for k in 0..count {
        let block = JsonBufC { bytes: [0u8; 16384], len: 0 };
        if !arrElemRec(jsonPtrC(&contentVal), contentVal.len, k, &block) { continue; };
        let bp: ptr = jsonPtrC(&block);
        let blockType = SStr { bytes: [0u8; 512], len: 0, has: false };
        recStrNE(bp, block.len, STR_PTR("type"), STR_LEN("type"), &blockType);
        let name = SStr { bytes: [0u8; 512], len: 0, has: false };
        let path = SStr { bytes: [0u8; 512], len: 0, has: false };
        let url = SStr { bytes: [0u8; 512], len: 0, has: false };
        let mediaType = SStr { bytes: [0u8; 512], len: 0, has: false };
        let sizeRaw = JsonBufC { bytes: [0u8; 16384], len: 0 };
        let hasSize = false;
        let ok = false;
        if sstrEqLitC(&blockType, STR_PTR("mention"), STR_LEN("mention")) {
            recStrNE(bp, block.len, STR_PTR("path"), STR_LEN("path"), &path);
            if !recStrNE(bp, block.len, STR_PTR("name"), STR_LEN("name"), &name) { name = path; };
            ok = name.has;
            if emitted > 0 { bigStrAppend(&buf, STR_PTR(","), STR_LEN(",")); };
            bigStrAppend(&buf, STR_PTR("{"), STR_LEN("{"));
            let first = true;
            jsonObjStrField(&buf, &first, STR_PTR("name"), STR_LEN("name"), sstrPtrC(&name), name.len);
            if path.has { jsonObjStrField(&buf, &first, STR_PTR("path"), STR_LEN("path"), sstrPtrC(&path), path.len); };
            bigStrAppend(&buf, STR_PTR("}"), STR_LEN("}"));
            emitted = emitted + 1;
            continue;
        };
        if sstrEqLitC(&blockType, STR_PTR("file"), STR_LEN("file")) || sstrEqLitC(&blockType, STR_PTR("document"), STR_LEN("document")) {
            recStrNE(bp, block.len, STR_PTR("path"), STR_LEN("path"), &path);
            recStrNE(bp, block.len, STR_PTR("url"), STR_LEN("url"), &url);
            if !recStrNE(bp, block.len, STR_PTR("name"), STR_LEN("name"), &name) { if path.has { name = path; } else { name = url; }; };
            ok = name.has;
            if !recStrNE(bp, block.len, STR_PTR("mediaType"), STR_LEN("mediaType"), &mediaType) { recStrNE(bp, block.len, STR_PTR("mimeType"), STR_LEN("mimeType"), &mediaType); };
            hasSize = recVal(bp, block.len, STR_PTR("size"), STR_LEN("size"), &sizeRaw);
            if !ok { continue; };
            if emitted > 0 { bigStrAppend(&buf, STR_PTR(","), STR_LEN(",")); };
            bigStrAppend(&buf, STR_PTR("{"), STR_LEN("{"));
            let first = true;
            jsonObjStrField(&buf, &first, STR_PTR("name"), STR_LEN("name"), sstrPtrC(&name), name.len);
            if path.has { jsonObjStrField(&buf, &first, STR_PTR("path"), STR_LEN("path"), sstrPtrC(&path), path.len); };
            if url.has { jsonObjStrField(&buf, &first, STR_PTR("url"), STR_LEN("url"), sstrPtrC(&url), url.len); };
            if mediaType.has { jsonObjStrField(&buf, &first, STR_PTR("mediaType"), STR_LEN("mediaType"), sstrPtrC(&mediaType), mediaType.len); };
            if hasSize { jsonObjRawField(&buf, &first, STR_PTR("size"), STR_LEN("size"), jsonPtrC(&sizeRaw), sizeRaw.len); };
            bigStrAppend(&buf, STR_PTR("}"), STR_LEN("}"));
            emitted = emitted + 1;
        };
    }
    bigStrAppend(&buf, STR_PTR("]"), STR_LEN("]"));
    if emitted == 0 { return; };
    item.has_files = true;
    item.files_count = emitted;
    let n = buf.len;
    if n > 4096 { n = 4096; };
    for j in 0..n { item.files_json_bytes[j] = buf.bytes[j]; };
    item.files_json_len = n;
}

// TS: function agentItemMetadata(...recordsOrFlags) applied into an item.
// The completed-flag variant is agentItemMetadataInto; the params-only
// variant (agentMessage/delta) is agentItemMetadataFromParams.
fn agentItemMetadataApply(records: &[JsonRef; 2], records_len: u64, markCompleted: bool, item: &WorkbenchItem) -> void {
    // nested records: agent/subagent/subAgent of each source record
    let refs: [JsonRef; 8] = [JsonRef { p: PTR_NULL(), l: 0 }; 8];
    let refs_len: u64 = 0;
    let nested: [JsonRef; 8] = [JsonRef { p: PTR_NULL(), l: 0 }; 8];
    let nested_len: u64 = 0;
    let nestedBufs: [JsonBufC; 6] = [JsonBufC { bytes: [0u8; 16384], len: 0 }; 6];
    let nb: u64 = 0;
    for r in 0..records_len {
        refs[refs_len] = records[r];
        refs_len = refs_len + 1;
        let subKeys: [JsonRef; 3] = [JsonRef { p: STR_PTR("agent"), l: STR_LEN("agent") }, JsonRef { p: STR_PTR("subagent"), l: STR_LEN("subagent") }, JsonRef { p: STR_PTR("subAgent"), l: STR_LEN("subAgent") }];
        for q in 0..3 {
            let v = JsonBufC { bytes: [0u8; 16384], len: 0 };
            if nb < 6 && recVal(records[r].p, records[r].l, subKeys[q].p, subKeys[q].l, &v) {
                asRecordC(jsonPtrC(&v), v.len, &nestedBufs[nb]);
                nested[nested_len] = JsonRef { p: jsonPtrC(&nestedBufs[nb]), l: nestedBufs[nb].len };
                nested_len = nested_len + 1;
                nb = nb + 1;
            };
        }
    }
    // sources = [...records, ...nestedRecords]
    let sources: [JsonRef; 8] = [JsonRef { p: PTR_NULL(), l: 0 }; 8];
    let sources_len: u64 = 0;
    for r in 0..refs_len { if sources_len < 8 { sources[sources_len] = refs[r]; sources_len = sources_len + 1; }; };
    for r in 0..nested_len { if sources_len < 8 { sources[sources_len] = nested[r]; sources_len = sources_len + 1; }; };
    let agentThreadId = SStr { bytes: [0u8; 512], len: 0, has: false };
    let keys1: [JsonRef; 6] = [JsonRef { p: STR_PTR("agentThreadId"), l: STR_LEN("agentThreadId") }, JsonRef { p: STR_PTR("subagentThreadId"), l: STR_LEN("subagentThreadId") }, JsonRef { p: STR_PTR("subAgentThreadId"), l: STR_LEN("subAgentThreadId") }, JsonRef { p: STR_PTR("receiverThreadId"), l: STR_LEN("receiverThreadId") }, JsonRef { p: PTR_NULL(), l: 0 }, JsonRef { p: PTR_NULL(), l: 0 }];
    let hasThreadId = firstStringRefs(&sources, sources_len, &keys1, 4, &agentThreadId);
    if !hasThreadId {
        let keysT: [JsonRef; 6] = [JsonRef { p: STR_PTR("threadId"), l: STR_LEN("threadId") }, JsonRef { p: PTR_NULL(), l: 0 }, JsonRef { p: PTR_NULL(), l: 0 }, JsonRef { p: PTR_NULL(), l: 0 }, JsonRef { p: PTR_NULL(), l: 0 }, JsonRef { p: PTR_NULL(), l: 0 }];
        hasThreadId = firstStringRefs(&nested, nested_len, &keysT, 1, &agentThreadId);
    };
    let agentId = SStr { bytes: [0u8; 512], len: 0, has: false };
    let keys2: [JsonRef; 6] = [JsonRef { p: STR_PTR("agentId"), l: STR_LEN("agentId") }, JsonRef { p: STR_PTR("subagentId"), l: STR_LEN("subagentId") }, JsonRef { p: STR_PTR("subAgentId"), l: STR_LEN("subAgentId") }, JsonRef { p: STR_PTR("agentPath"), l: STR_LEN("agentPath") }, JsonRef { p: PTR_NULL(), l: 0 }, JsonRef { p: PTR_NULL(), l: 0 }];
    let hasAgentId = firstStringRefs(&sources, sources_len, &keys2, 4, &agentId);
    if !hasAgentId {
        let keysI: [JsonRef; 6] = [JsonRef { p: STR_PTR("id"), l: STR_LEN("id") }, JsonRef { p: PTR_NULL(), l: 0 }, JsonRef { p: PTR_NULL(), l: 0 }, JsonRef { p: PTR_NULL(), l: 0 }, JsonRef { p: PTR_NULL(), l: 0 }, JsonRef { p: PTR_NULL(), l: 0 }];
        hasAgentId = firstStringRefs(&nested, nested_len, &keysI, 1, &agentId);
    };
    if !hasAgentId && hasThreadId { agentId = agentThreadId; hasAgentId = true; };
    let agentName = SStr { bytes: [0u8; 512], len: 0, has: false };
    let keys3: [JsonRef; 6] = [JsonRef { p: STR_PTR("agentName"), l: STR_LEN("agentName") }, JsonRef { p: STR_PTR("agentNickname"), l: STR_LEN("agentNickname") }, JsonRef { p: STR_PTR("subagentName"), l: STR_LEN("subagentName") }, JsonRef { p: STR_PTR("subAgentName"), l: STR_LEN("subAgentName") }, JsonRef { p: STR_PTR("name"), l: STR_LEN("name") }, JsonRef { p: STR_PTR("displayName"), l: STR_LEN("displayName") }];
    let hasName = firstStringRefs(&sources, sources_len, &keys3, 6, &agentName);
    if !hasName {
        let keysP: [JsonRef; 6] = [JsonRef { p: STR_PTR("agentPath"), l: STR_LEN("agentPath") }, JsonRef { p: PTR_NULL(), l: 0 }, JsonRef { p: PTR_NULL(), l: 0 }, JsonRef { p: PTR_NULL(), l: 0 }, JsonRef { p: PTR_NULL(), l: 0 }, JsonRef { p: PTR_NULL(), l: 0 }];
        hasName = firstStringRefs(&sources, sources_len, &keysP, 1, &agentName);
    };
    let agentRole = SStr { bytes: [0u8; 512], len: 0, has: false };
    let keys4: [JsonRef; 6] = [JsonRef { p: STR_PTR("agentRole"), l: STR_LEN("agentRole") }, JsonRef { p: STR_PTR("role"), l: STR_LEN("role") }, JsonRef { p: PTR_NULL(), l: 0 }, JsonRef { p: PTR_NULL(), l: 0 }, JsonRef { p: PTR_NULL(), l: 0 }, JsonRef { p: PTR_NULL(), l: 0 }];
    let hasRole = firstStringRefs(&sources, sources_len, &keys4, 2, &agentRole);
    let rawStatus = SStr { bytes: [0u8; 512], len: 0, has: false };
    let keys5: [JsonRef; 6] = [JsonRef { p: STR_PTR("agentStatus"), l: STR_LEN("agentStatus") }, JsonRef { p: STR_PTR("subagentStatus"), l: STR_LEN("subagentStatus") }, JsonRef { p: STR_PTR("subAgentStatus"), l: STR_LEN("subAgentStatus") }, JsonRef { p: STR_PTR("status"), l: STR_LEN("status") }, JsonRef { p: STR_PTR("kind"), l: STR_LEN("kind") }, JsonRef { p: PTR_NULL(), l: 0 }];
    let hasRawStatus = firstStringRefs(&sources, sources_len, &keys5, 5, &rawStatus);
    if hasAgentId {
        item.has_agentId = true;
        setBytes128(&item.agentId_bytes, &item.agentId_len, sstrPtrC(&agentId), agentId.len);
    };
    if hasThreadId {
        item.has_agentThreadId = true;
        setBytes128(&item.agentThreadId_bytes, &item.agentThreadId_len, sstrPtrC(&agentThreadId), agentThreadId.len);
    };
    if hasName {
        item.has_agentName = true;
        let n = agentName.len;
        if n > 256 { n = 256; };
        for j in 0..n { item.agentName_bytes[j] = agentName.bytes[j]; };
        item.agentName_len = n;
    };
    if hasRole {
        item.has_agentRole = true;
        setBytes128(&item.agentRole_bytes, &item.agentRole_len, sstrPtrC(&agentRole), agentRole.len);
    };
    if markCompleted && hasAgentId {
        item.has_agentStatus = true;
        let lit = STR_PTR("completed");
        let n = STR_LEN("completed");
        for j in 0..n { let b: u8 = 0; PTR_BYTE_AT(b, lit, j); item.agentStatus_bytes[j] = b; };
        item.agentStatus_len = n;
    } else if hasRawStatus {
        let normalized = SStr { bytes: [0u8; 512], len: 0, has: false };
        normalizeAgentItemStatus(&rawStatus, &normalized);
        item.has_agentStatus = true;
        let n = normalized.len;
        if n > 64 { n = 64; };
        for j in 0..n { item.agentStatus_bytes[j] = normalized.bytes[j]; };
        item.agentStatus_len = n;
    };
}

fn agentItemMetadataInto(item_ptr: ptr, item_len: u64, params_ptr: ptr, params_len: u64, markCompleted: bool, item: &WorkbenchItem) -> void {
    let records: [JsonRef; 2] = [JsonRef { p: item_ptr, l: item_len }, JsonRef { p: params_ptr, l: params_len }];
    let n: u64 = 1;
    if params_len > 0 { n = 2; };
    agentItemMetadataApply(&records, n, markCompleted, item);
}

fn agentItemMetadataFromParams(params_ptr: ptr, params_len: u64, item: &WorkbenchItem) -> void {
    let records: [JsonRef; 2] = [JsonRef { p: params_ptr, l: params_len }, JsonRef { p: PTR_NULL(), l: 0 }];
    agentItemMetadataApply(&records, 1, false, item);
}

// ---- relay error sanitizing (TS lines 4951-5003) ----

// TS: function flattenRelayErrorMessage(raw, depth = 0)
fn flattenRelayErrorMessage(raw_ptr: ptr, raw_len: u64, depth: u64, out: &BigStrC) -> void {
    out.len = 0;
    // clean = raw.replace(/\s+/g, " ").trim()
    let clean = BigStrC { bytes: [0u8; 8192], len: 0 };
    let lastWasSpace = true;
    for j in 0..raw_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, raw_ptr, j);
        let isWs = b == 32 || b == 9 || b == 10 || b == 13 || b == 11 || b == 12;
        if isWs { if !lastWasSpace { bigStrAppend(&clean, STR_PTR(" "), STR_LEN(" ")); lastWasSpace = true; }; } else { bigStrAppend(&clean, raw_ptr + j, 1); lastWasSpace = false; };
    }
    if clean.len > 0 && clean.bytes[clean.len - 1] == 32 { clean.len = clean.len - 1; };
    if clean.len == 0 || depth > 2 { return; };
    if clean.bytes[0] != 123 {
        let n = clean.len;
        if n > 200 { n = 200; };
        bigStrAppend(out, bigPtrC(&clean), n);
        return;
    };
    let rec = JsonBufC { bytes: [0u8; 16384], len: 0 };
    asRecordC(bigPtrC(&clean), clean.len, &rec);
    // a non-object parse leaves "{}" — treat as failure (TS try/catch)
    if rec.len <= 2 { return; };
    let inner = SStr { bytes: [0u8; 512], len: 0, has: false };
    // DEFECT: inner message longer than 512 bytes is truncated by this read
    if recStr(jsonPtrC(&rec), rec.len, STR_PTR("message"), STR_LEN("message"), &inner) {
        let same = inner.len == clean.len;
        if same { for j in 0..inner.len { if inner.bytes[j] != clean.bytes[j] { same = false; }; }; };
        if !same { flattenRelayErrorMessage(sstrPtrC(&inner), inner.len, depth + 1, out); return; };
    };
}

// TS: function extractRelayErrorDetail(text)
fn extractRelayErrorDetail(text_ptr: ptr, text_len: u64, out: &BigStrC) -> void {
    out.len = 0;
    let start: u64 = 0;
    let found = false;
    for j in 0..text_len { let b: u8 = 0; PTR_BYTE_AT(b, text_ptr, j); if b == 123 { start = j; found = true; break; }; };
    if !found { return; };
    let body = JsonBufC { bytes: [0u8; 16384], len: 0 };
    asRecordC(text_ptr + start, text_len - start, &body);
    if body.len <= 2 { return; };
    let errVal = JsonBufC { bytes: [0u8; 16384], len: 0 };
    let errRec = JsonBufC { bytes: [0u8; 16384], len: 0 };
    jsonBufSetC(&errRec, STR_PTR("{}"), STR_LEN("{}"));
    if recVal(jsonPtrC(&body), body.len, STR_PTR("error"), STR_LEN("error"), &errVal) { asRecordC(jsonPtrC(&errVal), errVal.len, &errRec); };
    let raw = SStr { bytes: [0u8; 512], len: 0, has: false };
    let hasRaw = recStr(jsonPtrC(&errRec), errRec.len, STR_PTR("message"), STR_LEN("message"), &raw);
    if !hasRaw { hasRaw = recStr(jsonPtrC(&body), body.len, STR_PTR("message"), STR_LEN("message"), &raw); };
    if !hasRaw { return; };
    flattenRelayErrorMessage(sstrPtrC(&raw), raw.len, 0, out);
}

// find "chat NNN" or "\"status\": NNN" status code in relay error text;
// out_code receives the 3 digits (empty when no match)
fn relayStatusCode(text_ptr: ptr, text_len: u64, out_code: &SStr) -> void {
    out_code.has = false;
    out_code.len = 0;
    // /\bchat (\d{3})\b/
    for i in 0..text_len {
        if i + 8 <= text_len {
            let ok = true;
            let pat = STR_PTR("chat ");
            for j in 0..5 { let a: u8 = 0; PTR_BYTE_AT(a, text_ptr, i + j); let b: u8 = 0; PTR_BYTE_AT(b, pat, j); if a != b { ok = false; }; };
            if ok {
                let d0: u8 = 0; PTR_BYTE_AT(d0, text_ptr, i + 5);
                let d1: u8 = 0; PTR_BYTE_AT(d1, text_ptr, i + 6);
                let d2: u8 = 0; PTR_BYTE_AT(d2, text_ptr, i + 7);
                if d0 >= 48 && d0 <= 57 && d1 >= 48 && d1 <= 57 && d2 >= 48 && d2 <= 57 {
                    out_code.has = true;
                    out_code.bytes[0] = d0;
                    out_code.bytes[1] = d1;
                    out_code.bytes[2] = d2;
                    out_code.len = 3;
                    return;
                };
            };
        };
    }
    // /"status":\s*(\d{3})/
    for i in 0..text_len {
        if i + 9 <= text_len {
            let ok = true;
            let pat = STR_PTR("\"status\":");
            for j in 0..9 { let a: u8 = 0; PTR_BYTE_AT(a, text_ptr, i + j); let b: u8 = 0; PTR_BYTE_AT(b, pat, j); if a != b { ok = false; }; };
            if ok {
                let k = i + 9;
                while k < text_len { let b: u8 = 0; PTR_BYTE_AT(b, text_ptr, k); if b == 32 || b == 9 { k = k + 1; } else { break; }; }
                if k + 3 <= text_len {
                    let d0: u8 = 0; PTR_BYTE_AT(d0, text_ptr, k);
                    let d1: u8 = 0; PTR_BYTE_AT(d1, text_ptr, k + 1);
                    let d2: u8 = 0; PTR_BYTE_AT(d2, text_ptr, k + 2);
                    if d0 >= 48 && d0 <= 57 && d1 >= 48 && d1 <= 57 && d2 >= 48 && d2 <= 57 {
                        out_code.has = true;
                        out_code.bytes[0] = d0;
                        out_code.bytes[1] = d1;
                        out_code.bytes[2] = d2;
                        out_code.len = 3;
                        return;
                    };
                };
            };
        };
    }
}

// TS (line 4951): export function sanitizeRelayErrorText(text)
fn sanitizeRelayErrorText(text_ptr: ptr, text_len: u64, out: &BigStrC) -> void {
    out.len = 0;
    if text_len == 0 || !bytesContains(text_ptr, text_len, STR_PTR("relay_protocol_error"), STR_LEN("relay_protocol_error")) {
        bigStrAppend(out, text_ptr, text_len);
        return;
    };
    let detail = BigStrC { bytes: [0u8; 8192], len: 0 };
    extractRelayErrorDetail(text_ptr, text_len, &detail);
    let status = SStr { bytes: [0u8; 512], len: 0, has: false };
    relayStatusCode(text_ptr, text_len, &status);
    if bytesContains(text_ptr, text_len, STR_PTR("ERR_BAD_REQUEST"), STR_LEN("ERR_BAD_REQUEST")) || sstrEqLitC(&status, STR_PTR("400"), STR_LEN("400")) {
        bigStrAppend(out, STR_PTR("上游服务拒绝了本次请求（relay 400）"), STR_LEN("上游服务拒绝了本次请求（relay 400）"));
        if detail.len > 0 {
            bigStrAppend(out, STR_PTR("："), STR_LEN("："));
            bigStrAppend(out, bigPtrC(&detail), detail.len);
            bigStrAppend(out, STR_PTR("，可重试或切换模型/分组。"), STR_LEN("，可重试或切换模型/分组。"));
        } else { bigStrAppend(out, STR_PTR("，请重试一次。"), STR_LEN("，请重试一次。")); };
        return;
    };
    if sstrEqLitC(&status, STR_PTR("429"), STR_LEN("429")) {
        bigStrAppend(out, STR_PTR("上游限流（relay 429）"), STR_LEN("上游限流（relay 429）"));
        if detail.len > 0 {
            bigStrAppend(out, STR_PTR("："), STR_LEN("："));
            bigStrAppend(out, bigPtrC(&detail), detail.len);
            bigStrAppend(out, STR_PTR("，稍后再试。"), STR_LEN("，稍后再试。"));
        } else { bigStrAppend(out, STR_PTR("，稍后重试。"), STR_LEN("，稍后重试。")); };
        return;
    };
    if sstrEqLitC(&status, STR_PTR("502"), STR_LEN("502")) || sstrEqLitC(&status, STR_PTR("503"), STR_LEN("503")) {
        bigStrAppend(out, STR_PTR("上游服务暂时不可用（relay "), STR_LEN("上游服务暂时不可用（relay "));
        bigStrAppend(out, sstrPtrC(&status), status.len);
        bigStrAppend(out, STR_PTR("）"), STR_LEN("）"));
        if detail.len > 0 {
            bigStrAppend(out, STR_PTR("："), STR_LEN("："));
            bigStrAppend(out, bigPtrC(&detail), detail.len);
            bigStrAppend(out, STR_PTR("，稍后再试。"), STR_LEN("，稍后再试。"));
        } else { bigStrAppend(out, STR_PTR("，稍后重试。"), STR_LEN("，稍后重试。")); };
        return;
    };
    bigStrAppend(out, STR_PTR("上游请求失败，请重试一次。"), STR_LEN("上游请求失败，请重试一次。"));
}

// ---- JEV collab extractors ----
// DEFECT: extractJevCollabBrief / extractJevCollabReport are imported from
// the frontends/jev unit (its own conversion); the field reads below are
// approximations over the common collabAgentToolCall fields.
fn extractJevCollabBrief(item_ptr: ptr, item_len: u64, out: &JevExtract) -> bool {
    out.agentId.has = false; out.agentId.len = 0;
    out.taskName.has = false; out.taskName.len = 0;
    out.has_status = false;
    out.status.has = false; out.status.len = 0;
    out.text.len = 0;
    if !recStrNEAlt(item_ptr, item_len, STR_PTR("agentId"), STR_LEN("agentId"), STR_PTR("agent_id"), STR_LEN("agent_id"), &out.agentId) {
        if !recStrNEAlt(item_ptr, item_len, STR_PTR("subagentId"), STR_LEN("subagentId"), STR_PTR("agentThreadId"), STR_LEN("agentThreadId"), &out.agentId) { recStrNE(item_ptr, item_len, STR_PTR("id"), STR_LEN("id"), &out.agentId); };
    };
    if !recStrNEAlt(item_ptr, item_len, STR_PTR("taskName"), STR_LEN("taskName"), STR_PTR("task_name"), STR_LEN("task_name"), &out.taskName) {
        if !recStrNE(item_ptr, item_len, STR_PTR("name"), STR_LEN("name"), &out.taskName) { recStrNE(item_ptr, item_len, STR_PTR("tool"), STR_LEN("tool"), &out.taskName); };
    };
    let briefVal = JsonBufC { bytes: [0u8; 16384], len: 0 };
    let hasBrief = false;
    if recVal(item_ptr, item_len, STR_PTR("prompt"), STR_LEN("prompt"), &briefVal) { hasBrief = true; } else if recVal(item_ptr, item_len, STR_PTR("brief"), STR_LEN("brief"), &briefVal) { hasBrief = true; } else if recVal(item_ptr, item_len, STR_PTR("message"), STR_LEN("message"), &briefVal) { hasBrief = true; };
    if hasBrief {
        let vp: ptr = PTR_NULL();
        let vl: u64 = 0;
        if sa_json_value_string(jsonPtrC(&briefVal), briefVal.len, &vp, &vl) == 0 { bigStrAppend(&out.text, vp, vl); };
    };
    let tp: ptr = PTR_NULL();
    let tl: u64 = 0;
    @ts_str_trim(bigPtrC(&out.text), out.text.len, &tp, &tl);
    return out.agentId.has && tl > 0;
}

fn extractJevCollabReport(item_ptr: ptr, item_len: u64, out: &JevExtract) -> bool {
    out.agentId.has = false; out.agentId.len = 0;
    out.taskName.has = false; out.taskName.len = 0;
    out.has_status = false;
    out.status.has = false; out.status.len = 0;
    out.text.len = 0;
    if !recStrNEAlt(item_ptr, item_len, STR_PTR("agentId"), STR_LEN("agentId"), STR_PTR("agent_id"), STR_LEN("agent_id"), &out.agentId) {
        if !recStrNEAlt(item_ptr, item_len, STR_PTR("subagentId"), STR_LEN("subagentId"), STR_PTR("agentThreadId"), STR_LEN("agentThreadId"), &out.agentId) { recStrNE(item_ptr, item_len, STR_PTR("id"), STR_LEN("id"), &out.agentId); };
    };
    if !recStrNEAlt(item_ptr, item_len, STR_PTR("taskName"), STR_LEN("taskName"), STR_PTR("task_name"), STR_LEN("task_name"), &out.taskName) {
        if !recStrNE(item_ptr, item_len, STR_PTR("name"), STR_LEN("name"), &out.taskName) { recStrNE(item_ptr, item_len, STR_PTR("tool"), STR_LEN("tool"), &out.taskName); };
    };
    out.has_status = recStrNE(item_ptr, item_len, STR_PTR("status"), STR_LEN("status"), &out.status);
    let reportVal = JsonBufC { bytes: [0u8; 16384], len: 0 };
    let hasReport = false;
    if recVal(item_ptr, item_len, STR_PTR("report"), STR_LEN("report"), &reportVal) { hasReport = true; } else if recVal(item_ptr, item_len, STR_PTR("output"), STR_LEN("output"), &reportVal) { hasReport = true; } else if recVal(item_ptr, item_len, STR_PTR("result"), STR_LEN("result"), &reportVal) { hasReport = true; };
    if hasReport {
        let vp: ptr = PTR_NULL();
        let vl: u64 = 0;
        if sa_json_value_string(jsonPtrC(&reportVal), reportVal.len, &vp, &vl) == 0 { bigStrAppend(&out.text, vp, vl); } else { summarizeJsonValue(jsonPtrC(&reportVal), reportVal.len, &out.text); };
    };
    let tp: ptr = PTR_NULL();
    let tl: u64 = 0;
    @ts_str_trim(bigPtrC(&out.text), out.text.len, &tp, &tl);
    return out.agentId.has && tl > 0;
}

