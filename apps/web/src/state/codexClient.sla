// Builds {"threadId":"<id>"} as JSON text.
// DEFECT: JSON string escaping of threadId approximated raw.
fn jsonBodyThreadId(threadId_ptr: ptr, threadId_len: u64, out: &JsonBufC) -> void {
    let b = BigStrC { bytes: [0u8; 8192], len: 0 };
    bigStrAppend(&b, STR_PTR("{\"threadId\":\""), STR_LEN("{\"threadId\":\""));
    bigStrAppend(&b, threadId_ptr, threadId_len);
    bigStrAppend(&b, STR_PTR("\"}"), STR_LEN("\"}"));
    let bp: ptr = PTR_NULL();
    PTR_BYTE_ADD(bp, &b.bytes, 0);
    jsonBufSetC(out, bp, b.len);
}

struct RemoteThreadStateResult { threadId: SStr, state: SStr, raw_json: JsonBufC }

// TS (line 719): export async function setRemoteThreadForeground(token, threadId, foreground)
// DEFECT: async. URL is .../attach when foreground, .../detach otherwise;
// error fallback has no status suffix in TS — preserved via direct extract.
fn setRemoteThreadForeground(token_ptr: ptr, token_len: u64, threadId_ptr: ptr, threadId_len: u64, foreground: bool, out: &RemoteThreadStateResult, err: &SStr) -> i32 {
    let url_ptr = STR_PTR("/api/ssh/remote-thread-routes/detach");
    let url_len = STR_LEN("/api/ssh/remote-thread-routes/detach");
    if foreground { url_ptr = STR_PTR("/api/ssh/remote-thread-routes/attach"); url_len = STR_LEN("/api/ssh/remote-thread-routes/attach"); };
    let body = JsonBufC { bytes: [0u8; 16384], len: 0 };
    jsonBodyThreadId(threadId_ptr, threadId_len, &body);
    let bp: ptr = PTR_NULL();
    PTR_BYTE_ADD(bp, &body.bytes, 0);
    let resp = HttpResponse { status: 0, body: JsonBufC { bytes: [0u8; 16384], len: 0 } };
    if httpFetchJson(STR_PTR("POST"), STR_LEN("POST"), url_ptr, url_len, token_ptr, token_len, true, bp, body.len, &resp) != 0 { return 1; };
    let data = JsonBufC { bytes: [0u8; 16384], len: 0 };
    let fallback_ptr = STR_PTR("Failed to detach remote conversation");
    let fallback_len = STR_LEN("Failed to detach remote conversation");
    if foreground { fallback_ptr = STR_PTR("Failed to attach remote conversation"); fallback_len = STR_LEN("Failed to attach remote conversation"); };
    if !fetchDataField(&resp, err, fallback_ptr, fallback_len, &data) { return 1; };
    jsonBufCopyC(&out.raw_json, &data);
    let dp: ptr = PTR_NULL();
    PTR_BYTE_ADD(dp, &data.bytes, 0);
    let vp: ptr = PTR_NULL();
    let vl: u64 = 0;
    if sa_json_object_get_string(dp, data.len, STR_PTR("threadId"), STR_LEN("threadId"), &vp, &vl) == 0 { sstrSet(&out.threadId, vp, vl); };
    if sa_json_object_get_string(dp, data.len, STR_PTR("state"), STR_LEN("state"), &vp, &vl) == 0 { sstrSet(&out.state, vp, vl); };
    return 0;
}

// TS (line 734): export async function startRemoteBackgroundThread(token, input)
// DEFECT: async; input is a dynamic object (JSON text); TS spreads
// { ...input, confirm: true } — the confirm flag is set via the assumed
// sa_json_object_set_value_text extern.
fn startRemoteBackgroundThread(token_ptr: ptr, token_len: u64, input_json: &JsonBufC, out: &RemoteThreadStateResult, err: &SStr) -> i32 {
    let body = JsonBufC { bytes: [0u8; 16384], len: 0 };
    let ip: ptr = PTR_NULL();
    PTR_BYTE_ADD(ip, &input_json.bytes, 0);
    let bp: ptr = PTR_NULL();
    let bl: u64 = 0;
    if sa_json_object_set_value_text(ip, input_json.len, STR_PTR("confirm"), STR_LEN("confirm"), STR_PTR("true"), STR_LEN("true"), &bp, &bl) == 0 { jsonBufSetC(&body, bp, bl); } else { jsonBufCopyC(&body, input_json); };
    let bbp: ptr = PTR_NULL();
    PTR_BYTE_ADD(bbp, &body.bytes, 0);
    let resp = HttpResponse { status: 0, body: JsonBufC { bytes: [0u8; 16384], len: 0 } };
    if httpFetchJson(STR_PTR("POST"), STR_LEN("POST"), STR_PTR("/api/ssh/remote-thread/start"), STR_LEN("/api/ssh/remote-thread/start"), token_ptr, token_len, true, bbp, body.len, &resp) != 0 { return 1; };
    let data = JsonBufC { bytes: [0u8; 16384], len: 0 };
    if !fetchDataField(&resp, err, STR_PTR("Failed to start the remote background conversation"), STR_LEN("Failed to start the remote background conversation"), &data) { return 1; };
    // TS additionally requires payload.data?.threadId
    let dp: ptr = PTR_NULL();
    PTR_BYTE_ADD(dp, &data.bytes, 0);
    let vp: ptr = PTR_NULL();
    let vl: u64 = 0;
    if sa_json_object_get_string(dp, data.len, STR_PTR("threadId"), STR_LEN("threadId"), &vp, &vl) != 0 {
        sstrSetLit(err, STR_PTR("Failed to start the remote background conversation"), STR_LEN("Failed to start the remote background conversation"));
        return 1;
    };
    sstrSet(&out.threadId, vp, vl);
    jsonBufCopyC(&out.raw_json, &data);
    return 0;
}

