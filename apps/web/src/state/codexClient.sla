// marketplace load errors shared by both marketplace parsers:
// [path, message].filter(Boolean).join(": ") || fallback
fn parseMarketplaceErrors(record_ptr: ptr, record_len: u64, fallback_ptr: ptr, fallback_len: u64, out: &StrListC) -> void {
    out.len = 0;
    let arr = JsonBufC { bytes: [0u8; 16384], len: 0 };
    if !recVal(record_ptr, record_len, STR_PTR("marketplaceLoadErrors"), STR_LEN("marketplaceLoadErrors"), &arr) { return; };
    let count = arrCount(jsonPtrC(&arr), arr.len);
    for k in 0..count {
        if out.len >= 64 { break; };
        let rec = JsonBufC { bytes: [0u8; 16384], len: 0 };
        if !arrElemRec(jsonPtrC(&arr), arr.len, k, &rec) { continue; };
        let rp: ptr = jsonPtrC(&rec);
        let path = SStr { bytes: [0u8; 512], len: 0, has: false };
        let message = SStr { bytes: [0u8; 512], len: 0, has: false };
        recStrNE(rp, rec.len, STR_PTR("marketplacePath"), STR_LEN("marketplacePath"), &path);
        recStrNE(rp, rec.len, STR_PTR("message"), STR_LEN("message"), &message);
        let joined = SStr { bytes: [0u8; 512], len: 0, has: true };
        joined.len = 0;
        if path.has { for j in 0..path.len { if joined.len < 512 { joined.bytes[joined.len] = path.bytes[j]; joined.len = joined.len + 1; }; }; };
        if path.has && message.has { if joined.len < 510 { joined.bytes[joined.len] = 58; joined.len = joined.len + 1; joined.bytes[joined.len] = 32; joined.len = joined.len + 1; }; };
        if message.has { for j in 0..message.len { if joined.len < 512 { joined.bytes[joined.len] = message.bytes[j]; joined.len = joined.len + 1; }; }; };
        if joined.len == 0 { sstrSet(&joined, fallback_ptr, fallback_len); };
        out.items[out.len] = joined;
        out.len = out.len + 1;
    }
}

