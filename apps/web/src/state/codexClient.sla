    if !fetchDataField(&resp, err, STR_PTR("Failed to open workspace file"), STR_LEN("Failed to open workspace file"), &data) { return 1; };
    jsonBufCopyC(&out.raw_json, &data);
    jsonBufCopyC(&whole, &data);
    return 0;
}

