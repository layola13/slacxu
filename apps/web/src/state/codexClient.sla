// TS (line 2888): export async function fetchWorkspaceRoots(token): Promise<LocalWorkspaceInfo>
// DEFECT: async; 10s AbortController timeout. Returns 0 ok, 1 with
// WorkspaceRootsError filled, 2 LoginRequiredError (401 + loginRequired).
fn fetchWorkspaceRoots(token_ptr: ptr, token_len: u64, out: &LocalWorkspaceInfo, err: &WorkspaceRootsError) -> i32 {
    let resp = HttpResponse { status: 0, body: JsonBufC { bytes: [0u8; 16384], len: 0 } };
    let ferr = SStr { bytes: [0u8; 512], len: 0, has: false };
    let rc = fetchWithClientTimeout(STR_PTR("GET"), STR_LEN("GET"), STR_PTR("/api/workspace/roots"), STR_LEN("/api/workspace/roots"), true, token_ptr, token_len, false, STR_PTR(""), 0, 10000.0, STR_PTR(""), 0, &resp, &ferr);
    if rc == 2 {
        workspaceRootsErrorInit(err, STR_PTR("network"), STR_LEN("network"), STR_PTR("CUX-NET-001"), STR_LEN("CUX-NET-001"), 0.0, STR_PTR("Workspace roots request timed out"), STR_LEN("Workspace roots request timed out"), true);
        return 1;
    };
    if rc != 0 {
        workspaceRootsErrorInit(err, STR_PTR("network"), STR_LEN("network"), STR_PTR("CUX-NET-002"), STR_LEN("CUX-NET-002"), 0.0, STR_PTR("Unable to reach the UI server"), STR_LEN("Unable to reach the UI server"), true);
        return 1;
    };
    if !responseOk(&resp) {
        let bp: ptr = PTR_NULL();
        PTR_BYTE_ADD(bp, &resp.body.bytes, 0);
        let loginRequired = false;
        sa_json_object_get_bool(bp, resp.body.len, STR_PTR("loginRequired"), STR_LEN("loginRequired"), &loginRequired);
        if resp.status == 401 && loginRequired { return 2; };
        // code selection (TS nested ternary, in order)
        let code = SStr { bytes: [0u8; 512], len: 0, has: false };
        let cp: ptr = PTR_NULL();
        let cl: u64 = 0;
        if sa_json_object_get_string(bp, resp.body.len, STR_PTR("code"), STR_LEN("code"), &cp, &cl) == 0 {
            sstrSet(&code, cp, cl);
        } else {
            if resp.status == 401 { sstrSetLit(&code, STR_PTR("CUX-PROXY-001"), STR_LEN("CUX-PROXY-001")); } else {
                if resp.status == 502 || resp.status == 503 { sstrSetLit(&code, STR_PTR("CUX-PROXY-002"), STR_LEN("CUX-PROXY-002")); } else {
                    if resp.status >= 500 { sstrSetLit(&code, STR_PTR("CUX-SERVER-001"), STR_LEN("CUX-SERVER-001")); } else {
                        if resp.status == 403 { sstrSetLit(&code, STR_PTR("CUX-AUTH-002"), STR_LEN("CUX-AUTH-002")); } else { sstrSetLit(&code, STR_PTR("CUX-WORKSPACE-002"), STR_LEN("CUX-WORKSPACE-002")); };
                    };
                };
            };
        };
        // kind selection
        let kind_ptr = STR_PTR("workspace");
        let kind_len = STR_LEN("workspace");
        if (resp.status == 401 && !loginRequired) || resp.status == 502 || resp.status == 503 { kind_ptr = STR_PTR("proxy"); kind_len = STR_LEN("proxy"); } else {
            if resp.status >= 500 { kind_ptr = STR_PTR("server"); kind_len = STR_LEN("server"); } else {
                if resp.status == 401 || resp.status == 403 { kind_ptr = STR_PTR("auth"); kind_len = STR_LEN("auth"); };
            };
        };
        let ep: ptr = PTR_NULL();
        let el: u64 = 0;
        let msg = BigStrC { bytes: [0u8; 8192], len: 0 };
        if sa_json_object_get_string(bp, resp.body.len, STR_PTR("error"), STR_LEN("error"), &ep, &el) == 0 && el > 0 {
            bigStrAppend(&msg, ep, el);
        } else {
            bigStrAppend(&msg, STR_PTR("Failed to list workspace roots ("), STR_LEN("Failed to list workspace roots ("));
            bigStrAppendU64(&msg, resp.status);
            bigStrAppend(&msg, STR_PTR(")"), STR_LEN(")"));
        };
        let mp: ptr = PTR_NULL();
        PTR_BYTE_ADD(mp, &msg.bytes, 0);
        let codePtr: ptr = PTR_NULL();
        PTR_BYTE_ADD(codePtr, &code.bytes, 0);
        workspaceRootsErrorInit(err, kind_ptr, kind_len, codePtr, code.len, resp.status as f64, mp, msg.len, resp.status >= 500);
        return 1;
    };
    jsonBufCopyC(&out.raw_json, &resp.body);
    return 0;
}

