fn computeReconnectDelay(attempt: f64, baseMs: f64, maxMs: f64) -> f64 {
    let safeBase = baseMs;
    if !(baseMs > 0.0) { safeBase = 250.0; };
    let safeMax = maxMs;
    if !(maxMs > 0.0) { safeMax = 5000.0; } else { if safeBase > safeMax { safeMax = safeBase; }; };
    let safeAttempt: u64 = 0;
    if attempt >= 0.0 { safeAttempt = attempt as u64; if safeAttempt > 6 { safeAttempt = 6; }; };
    let delay = safeBase;
    for i in 0..safeAttempt { delay = delay * 2.0; }
    if delay > safeMax { delay = safeMax; };
    return delay;
}

