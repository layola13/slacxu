    urlEncodeComponent(id_ptr, id_len, &enc);
    let ep: ptr = PTR_NULL();
    PTR_BYTE_ADD(ep, &enc.bytes, 0);
    bigStrAppend(out, ep, enc.len);
    bigStrAppend(out, suffix_ptr, suffix_len);
}

