    out.has_account = false;
    out.account_json.len = 0;
    out.models_len = 0;
    out.providers_json.len = 0;
    out.threads_len = 0;
    out.activeThreadId.has = false;
    out.activeThreadId.len = 0;
    out.turns_len = 0;
    out.pendingRequests_len = 0;
    out.tooling.mcpServers_len = 0;
    out.tooling.skillGroups_len = 0;
    out.tooling.hookGroups_len = 0;
    out.tooling.pluginMarketplaces_len = 0;
    out.tooling.installedPluginMarketplaces_len = 0;
    out.tooling.apps_len = 0;
    out.tooling.featuredPluginIds_len = 0;
    out.tooling.marketplaceErrors_len = 0;
    out.toolingLoading = false;
    out.errors_len = 0;
    jsonBufSetC(&out.claudeStartupStages_json, STR_PTR("{}"), STR_LEN("{}"));
}

