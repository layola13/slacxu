    let data = JsonBufC { bytes: [0u8; 16384], len: 0 };
    if !fetchDataField(&resp, err, STR_PTR("Agents readiness failed"), STR_LEN("Agents readiness failed"), &data) { return 1; };
    jsonBufCopyC(&out.raw_json, &data);
    return 0;
}

// TS (line 488): export interface ClaudeCompatibleCliSettings { enabled: boolean }
// The other *CompatibleCliSettings types come from "@codex-ui/shared" and
// share this { enabled } shape as used by the fetch/update pairs below.
