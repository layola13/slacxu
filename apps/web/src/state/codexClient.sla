fn selectCliInstallation(token_ptr: ptr, token_len: u64, backend_ptr: ptr, backend_len: u64, hasPath: bool, path_ptr: ptr, path_len: u64, err: &SStr) -> i32 {
    let b = BigStrC { bytes: [0u8; 8192], len: 0 };
    bigStrAppend(&b, STR_PTR("{\"backend\":\""), STR_LEN("{\"backend\":\""));
    bigStrAppend(&b, backend_ptr, backend_len);
    bigStrAppend(&b, STR_PTR("\",\"path\":"), STR_LEN("\",\"path\":"));
    if hasPath {
        bigStrAppend(&b, STR_PTR("\""), STR_LEN("\""));
        bigStrAppend(&b, path_ptr, path_len);
        bigStrAppend(&b, STR_PTR("\""), STR_LEN("\""));
    } else {
        bigStrAppend(&b, STR_PTR("null"), STR_LEN("null"));
    };
    bigStrAppend(&b, STR_PTR("}"), STR_LEN("}"));
    let bp: ptr = PTR_NULL();
    PTR_BYTE_ADD(bp, &b.bytes, 0);
    let resp = HttpResponse { status: 0, body: JsonBufC { bytes: [0u8; 16384], len: 0 } };
    let rc = fetchWithClientTimeout(STR_PTR("POST"), STR_LEN("POST"), STR_PTR("/api/cli/select"), STR_LEN("/api/cli/select"), true, token_ptr, token_len, true, bp, b.len, 10000.0, STR_PTR("Timed out selecting CLI version"), STR_LEN("Timed out selecting CLI version"), &resp, err);
    if rc != 0 { return 1; };
    if !responseOk(&resp) { errorFromBody(&resp, STR_PTR("Failed to switch CLI version"), STR_LEN("Failed to switch CLI version"), err); return 1; };
    return 0;
}

