// TS (line 2272): export async function fetchProviders(token): Promise<ProviderConfig[]>
// DEFECT: async; AbortController 8s timeout (timed extern).
// Returns 0 ok (out = data array JSON), 1 error, 2 LoginRequiredError.
fn fetchProviders(token_ptr: ptr, token_len: u64, out: &JsonBufC, err: &SStr) -> i32 {
    let resp = HttpResponse { status: 0, body: JsonBufC { bytes: [0u8; 16384], len: 0 } };
    let rc = fetchWithClientTimeout(STR_PTR("GET"), STR_LEN("GET"), STR_PTR("/api/providers"), STR_LEN("/api/providers"), true, token_ptr, token_len, false, STR_PTR(""), 0, 8000.0, STR_PTR("Timed out loading relay channels"), STR_LEN("Timed out loading relay channels"), &resp, err);
    if rc == 2 { return 1; };
    if rc != 0 { return 1; };
    if !responseOk(&resp) {
        let bp: ptr = PTR_NULL();
        PTR_BYTE_ADD(bp, &resp.body.bytes, 0);
        if resp.status == 401 {
            let loginRequired = false;
            sa_json_object_get_bool(bp, resp.body.len, STR_PTR("loginRequired"), STR_LEN("loginRequired"), &loginRequired);
            if loginRequired { return 2; };
        };
        let ep: ptr = PTR_NULL();
        let el: u64 = 0;
        if sa_json_object_get_string(bp, resp.body.len, STR_PTR("error"), STR_LEN("error"), &ep, &el) == 0 && el > 0 { sstrSet(err, ep, el); return 1; };
        let msg = BigStrC { bytes: [0u8; 8192], len: 0 };
        bigStrAppend(&msg, STR_PTR("Failed to load relay channels: "), STR_LEN("Failed to load relay channels: "));
        bigStrAppendU64(&msg, resp.status);
        let mp: ptr = PTR_NULL();
        PTR_BYTE_ADD(mp, &msg.bytes, 0);
        sstrSet(err, mp, msg.len);
        return 1;
    };
    let bp: ptr = PTR_NULL();
    PTR_BYTE_ADD(bp, &resp.body.bytes, 0);
    let dp: ptr = PTR_NULL();
    let dl: u64 = 0;
    // if (!Array.isArray(body.data)) throw "... malformed response"
    if sa_json_object_get_value_text(bp, resp.body.len, STR_PTR("data"), STR_LEN("data"), &dp, &dl) != 0 || dl == 0 {
        sstrSetLit(err, STR_PTR("Failed to load relay channels: malformed response"), STR_LEN("Failed to load relay channels: malformed response"));
        return 1;
    };
    let first: u8 = 0;
    PTR_BYTE_AT(first, dp, 0);
    if first != 91 {
        sstrSetLit(err, STR_PTR("Failed to load relay channels: malformed response"), STR_LEN("Failed to load relay channels: malformed response"));
        return 1;
    };
    jsonBufSetC(out, dp, dl);
    return 0;
}

