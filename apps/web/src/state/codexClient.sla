// ts_* surface above (@ts_str_*, @ts_arr_*, @ts_math_*); remaining hand
// approximations below are legacy from the first pass and are being rebound
// (see _defects/web-ts-state.md, entries marked 已绑 sa_std ts 面).
@import "sa_std/string.sa"
@import "sa_std/io/print.sai"

// TS imports (lines 1-59): types from "@codex-ui/shared", Workbench types
// from "@cxu/sdk-frontend", helpers from ../promptDisplay,
// ../goalContinuation, ../planContinuation, ../workspacePaths,
// frontends/jev jevAutoJudge/jevQuestions, and ./workbenchTimeline.
// DEFECT: module imports — the shared/sdk type shapes live in their own
// units; types only *used* here (AuthSession, ProviderConfig, JsonValue,
// JsonRpc*, EngineStatus, ...) are represented as JSON text buffers
// (JsonBufC) or the structs below. Workbench types are re-exported by this
// module (TS line 52) and are defined fully here because
// workbenchTimeline.sla imports them from this file.
// DEFECT: async — every async function below is synchronous and returns an
// i32 status (0 = ok, 1 = error); TS `throw new Error(...)` becomes status 1
// with the message written into the caller's `err` SStr.
// DEFECT: fetch() — browser fetch with headers/cache/AbortSignal has no
// sa_std counterpart; httpFetchJson is a blocking request through the
// assumed extern sa_http_client_fetch_json (fix phase to wire).
// DEFECT: dynamic JSON — request/response bodies are JSON text buffers;
// field reads go through assumed sa_json_* externs.
// DEFECT: string fields are SStr (512-byte slots, has flag for optionals);
// long text uses BigStrC (8192) or the field's own byte array.

struct SStr {
    bytes: [u8; 512],
    len: u64,
    has: bool,
}

struct BigStrC {
    bytes: [u8; 8192],
    len: u64,
}

struct JsonBufC {
    bytes: [u8; 16384],
    len: u64,
}

struct JsonBufSmallC {
    bytes: [u8; 2048],
    len: u64,
}

struct HttpResponse {
    status: u64,
    body: JsonBufC,
}

fn sstrSet(dst: &SStr, src_ptr: ptr, src_len: u64) -> void {
    dst.has = true;
    dst.len = 0;
    let n = src_len;
    if n > 512 { n = 512; };
    for j in 0..n {
        let b: u8 = 0;
        PTR_BYTE_AT(b, src_ptr, j);
        dst.bytes[dst.len] = b;
        dst.len = dst.len + 1;
    }
}

fn sstrSetLit(dst: &SStr, lit_ptr: ptr, lit_len: u64) -> void { sstrSet(dst, lit_ptr, lit_len); }

fn sstrEq(a: &SStr, b_ptr: ptr, b_len: u64) -> bool {
    if !a.has || a.len != b_len { return false; };
    for j in 0..a.len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, b_ptr, j);
        if a.bytes[j] != b { return false; };
    }
    return true;
}

fn bytesEq(a_ptr: ptr, a_len: u64, b_ptr: ptr, b_len: u64) -> bool {
    if a_len != b_len { return false; };
    for j in 0..a_len {
        let x: u8 = 0;
        let y: u8 = 0;
        PTR_BYTE_AT(x, a_ptr, j);
        PTR_BYTE_AT(y, b_ptr, j);
        if x != y { return false; };
    }
    return true;
}

fn bigStrAppend(dst: &BigStrC, src_ptr: ptr, src_len: u64) -> void {
    for j in 0..src_len {
        if dst.len < 8192 {
            let b: u8 = 0;
            PTR_BYTE_AT(b, src_ptr, j);
            dst.bytes[dst.len] = b;
            dst.len = dst.len + 1;
        };
    }
}

fn bigStrAppendU64(dst: &BigStrC, value: u64) -> void {
    let digits: [u8; 20] = [0u8; 20];
    let n: u64 = 0;
    let v = value;
    if v == 0 { digits[0] = 48; n = 1; };
    while v > 0 {
        digits[n] = 48 + (v % 10) as u8;
        n = n + 1;
        v = v / 10;
    }
    let i = n;
    while i > 0 {
        i = i - 1;
        if dst.len < 8192 { dst.bytes[dst.len] = digits[i]; dst.len = dst.len + 1; };
    }
}

fn jsonBufSetC(dst: &JsonBufC, src_ptr: ptr, src_len: u64) -> void {
    dst.len = 0;
    let n = src_len;
    if n > 16384 { n = 16384; };
    for j in 0..n {
        let b: u8 = 0;
        PTR_BYTE_AT(b, src_ptr, j);
        dst.bytes[dst.len] = b;
        dst.len = dst.len + 1;
    }
}

fn jsonBufCopyC(dst: &JsonBufC, src: &JsonBufC) -> void {
    dst.len = src.len;
    for j in 0..src.len { dst.bytes[j] = src.bytes[j]; }
}

// DEFECT: assumed extern sa_http_client_fetch_json(method, url,
// tokenHeaderValue, hasBody, body, &status, &bodyPtr, &bodyLen) — blocking
// JSON HTTP request with the x-codex-ui-token header convention of this
// module (fix phase to wire to sa_std http client).
fn httpFetchJson(method_ptr: ptr, method_len: u64, url_ptr: ptr, url_len: u64, token_ptr: ptr, token_len: u64, hasBody: bool, body_ptr: ptr, body_len: u64, out: &HttpResponse) -> i32 {
    let status: u64 = 0;
    let bp: ptr = PTR_NULL();
    let bl: u64 = 0;
    let rc = sa_http_client_fetch_json(method_ptr, method_len, url_ptr, url_len, token_ptr, token_len, hasBody, body_ptr, body_len, &status, &bp, &bl);
    if rc != 0 { out.status = 0; out.body.len = 0; return 1; };
    out.status = status;
    jsonBufSetC(&out.body, bp, bl);
    return 0;
}

// Extracts body.data like the TS pattern:
//   const body = await response.json().catch(() => ({}));
//   if (!response.ok || !body.data) throw new Error(body.error ?? fallback(status));
// On failure writes err = body.error ?? `${fallback} (${status})`.
fn fetchDataField(resp: &HttpResponse, err: &SStr, fallback_ptr: ptr, fallback_len: u64, out: &JsonBufC) -> bool {
    let bp: ptr = PTR_NULL();
    PTR_BYTE_ADD(bp, &resp.body.bytes, 0);
    let dp: ptr = PTR_NULL();
    let dl: u64 = 0;
    let hasData = sa_json_object_get_value_text(bp, resp.body.len, STR_PTR("data"), STR_LEN("data"), &dp, &dl) == 0;
    if resp.status >= 200 && resp.status < 300 && hasData {
        jsonBufSetC(out, dp, dl);
        return true;
    };
    // err = body.error ?? fallback
    let ep: ptr = PTR_NULL();
    let el: u64 = 0;
    if sa_json_object_get_string(bp, resp.body.len, STR_PTR("error"), STR_LEN("error"), &ep, &el) == 0 && el > 0 {
        sstrSet(err, ep, el);
        return false;
    };
    let msg = BigStrC { bytes: [0u8; 8192], len: 0 };
    bigStrAppend(&msg, fallback_ptr, fallback_len);
    bigStrAppend(&msg, STR_PTR(" ("), STR_LEN(" ("));
    bigStrAppendU64(&msg, resp.status);
    bigStrAppend(&msg, STR_PTR(")"), STR_LEN(")"));
    let mp: ptr = PTR_NULL();
    PTR_BYTE_ADD(mp, &msg.bytes, 0);
    sstrSet(err, mp, msg.len);
    return false;
}

// encodeURIComponent approximation: percent-encodes every byte outside
// [A-Za-z0-9-_.!~*'()] with uppercase hex, as JS does (UTF-8 bytes).
fn urlEncodeComponent(src_ptr: ptr, src_len: u64, out: &BigStrC) -> void {
    out.len = 0;
    for j in 0..src_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, src_ptr, j);
        let unreserved = (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || (b >= 48 && b <= 57) || b == 45 || b == 95 || b == 46 || b == 33 || b == 126 || b == 42 || b == 39 || b == 40 || b == 41;
        if unreserved {
            if out.len < 8192 { out.bytes[out.len] = b; out.len = out.len + 1; };
        } else {
            let hex: [u8; 16] = [48u8, 49u8, 50u8, 51u8, 52u8, 53u8, 54u8, 55u8, 56u8, 57u8, 65u8, 66u8, 67u8, 68u8, 69u8, 70u8];
            if out.len < 8192 { out.bytes[out.len] = 37; out.len = out.len + 1; };
            if out.len < 8192 { out.bytes[out.len] = hex[(b / 16) as u64]; out.len = out.len + 1; };
            if out.len < 8192 { out.bytes[out.len] = hex[(b % 16) as u64]; out.len = out.len + 1; };
        };
    }
}

