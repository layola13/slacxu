    if !recStrNE(t_ptr, t_len, STR_PTR("logoUrl"), STR_LEN("logoUrl"), &out.logoUrl) { recStrNE(t_ptr, t_len, STR_PTR("logoUrlDark"), STR_LEN("logoUrlDark"), &out.logoUrl); };
    let arr = JsonBufC { bytes: [0u8; 16384], len: 0 };
