// TS (line 84): export async function fetchThreadUsage(token, threadId):
//   Promise<ThreadRequestUsageRecord[]>
// DEFECT: async (see header). The TS filter keeps entries that are objects;
// entries are kept as JSON texts here.
fn fetchThreadUsage(token_ptr: ptr, token_len: u64, threadId_ptr: ptr, threadId_len: u64, out: &ThreadRequestUsageList, err: &SStr) -> i32 {
    let url = BigStrC { bytes: [0u8; 8192], len: 0 };
    bigStrAppend(&url, STR_PTR("/api/thread-usage?threadId="), STR_LEN("/api/thread-usage?threadId="));
    let enc = BigStrC { bytes: [0u8; 8192], len: 0 };
    urlEncodeComponent(threadId_ptr, threadId_len, &enc);
    let ep: ptr = PTR_NULL();
    PTR_BYTE_ADD(ep, &enc.bytes, 0);
    bigStrAppend(&url, ep, enc.len);
    let up: ptr = PTR_NULL();
    PTR_BYTE_ADD(up, &url.bytes, 0);
    let resp = HttpResponse { status: 0, body: JsonBufC { bytes: [0u8; 16384], len: 0 } };
    if httpFetchJson(STR_PTR("GET"), STR_LEN("GET"), up, url.len, token_ptr, token_len, false, STR_PTR(""), 0, &resp) != 0 { sstrSetLit(err, STR_PTR("Failed to load thread usage"), STR_LEN("Failed to load thread usage")); return 1; };
    let data = JsonBufC { bytes: [0u8; 16384], len: 0 };
    // TS also requires Array.isArray(body.data); fetchDataField covers
    // !ok/missing data, the array check happens in the entry split below.
    if !fetchDataField(&resp, err, STR_PTR("Failed to load thread usage"), STR_LEN("Failed to load thread usage"), &data) { return 1; };
    out.len = 0;
    let dp: ptr = PTR_NULL();
    PTR_BYTE_ADD(dp, &data.bytes, 0);
    let count = sa_json_array_len(dp, data.len);
    for i in 0..count {
        let ep2: ptr = PTR_NULL();
        let el2: u64 = 0;
        if sa_json_array_at_value_text(dp, data.len, i, &ep2, &el2) == 0 {
            // filter: Boolean(entry && typeof entry === "object")
            if el2 > 0 {
                let first: u8 = 0;
                PTR_BYTE_AT(first, ep2, 0);
                if first == 123 && out.len < 64 {
                    out.entries_json[out.len].len = 0;
                    let n = el2;
                    if n > 2048 { n = 2048; };
                    for j in 0..n {
                        let b: u8 = 0;
                        PTR_BYTE_AT(b, ep2, j);
                        out.entries_json[out.len].bytes[j] = b;
                    }
                    out.entries_json[out.len].len = n;
                    out.len = out.len + 1;
                };
            };
        };
    }
    return 0;
}

