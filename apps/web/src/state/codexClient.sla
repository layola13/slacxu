// Builds {"path": ..., optional "threadId", optional "cwd"} bodies.
// DEFECT: JSON string escaping approximated raw (as elsewhere in this file).
fn workspacePathBody(path_ptr: ptr, path_len: u64, hasThreadId: bool, threadId_ptr: ptr, threadId_len: u64, hasCwd: bool, cwd_ptr: ptr, cwd_len: u64, out: &JsonBufC) -> void {
    let b = BigStrC { bytes: [0u8; 8192], len: 0 };
    bigStrAppend(&b, STR_PTR("{\"path\":\""), STR_LEN("{\"path\":\""));
    bigStrAppend(&b, path_ptr, path_len);
    bigStrAppend(&b, STR_PTR("\""), STR_LEN("\""));
    if hasThreadId { bigStrAppend(&b, STR_PTR(",\"threadId\":\""), STR_LEN(",\"threadId\":\"")); bigStrAppend(&b, threadId_ptr, threadId_len); bigStrAppend(&b, STR_PTR("\""), STR_LEN("\"")); };
    if hasCwd { bigStrAppend(&b, STR_PTR(",\"cwd\":\""), STR_LEN(",\"cwd\":\"")); bigStrAppend(&b, cwd_ptr, cwd_len); bigStrAppend(&b, STR_PTR("\""), STR_LEN("\"")); };
    bigStrAppend(&b, STR_PTR("}"), STR_LEN("}"));
    let bp: ptr = PTR_NULL();
    PTR_BYTE_ADD(bp, &b.bytes, 0);
    jsonBufSetC(out, bp, b.len);
}

