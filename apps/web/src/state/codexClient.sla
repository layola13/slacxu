// TS (line 1996): listAgentProjectMessages(token, id, options { after?, limit? })
// DEFECT: URLSearchParams — the query is built manually in TS order
// (after, then limit), values via String(number).
fn listAgentProjectMessages(token_ptr: ptr, token_len: u64, id_ptr: ptr, id_len: u64, hasAfter: bool, after: f64, hasLimit: bool, limit: f64, out: &JsonBufC, err: &ProjectApiError) -> i32 {
    let path = BigStrC { bytes: [0u8; 8192], len: 0 };
    projectIdPath(id_ptr, id_len, STR_PTR("/messages"), STR_LEN("/messages"), &path);
    let query = BigStrC { bytes: [0u8; 8192], len: 0 };
    if hasAfter { bigStrAppend(&query, STR_PTR("after="), STR_LEN("after=")); bigStrAppendU64(&query, after as u64); };
    if hasLimit {
        if query.len > 0 { bigStrAppend(&query, STR_PTR("&"), STR_LEN("&")); };
        bigStrAppend(&query, STR_PTR("limit="), STR_LEN("limit="));
        bigStrAppendU64(&query, limit as u64);
    };
    if query.len > 0 {
        bigStrAppend(&path, STR_PTR("?"), STR_LEN("?"));
        let qp: ptr = PTR_NULL();
        PTR_BYTE_ADD(qp, &query.bytes, 0);
        bigStrAppend(&path, qp, query.len);
    };
    let pp: ptr = PTR_NULL();
    PTR_BYTE_ADD(pp, &path.bytes, 0);
    return projectRequest(token_ptr, token_len, pp, path.len, STR_PTR("GET"), STR_LEN("GET"), false, STR_PTR(""), 0, out, err);
}

