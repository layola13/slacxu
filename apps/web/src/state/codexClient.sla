// TS: WebSocketRuntimeConfig (from "@codex-ui/shared") as used by the default below
struct WebSocketRuntimeConfig {
    profile: SStr,
    platform: SStr,
    path: SStr,
    heartbeatIntervalMs: f64,
    heartbeatTimeoutMs: f64,
    handshakeTimeoutMs: f64,
    reconnectBaseDelayMs: f64,
    reconnectMaxDelayMs: f64,
}

fn defaultWebSocketRuntime(out: &WebSocketRuntimeConfig) -> void {
    sstrSetLit(&out.profile, STR_PTR("desktop"), STR_LEN("desktop"));
    sstrSetLit(&out.path, STR_PTR("/ws"), STR_LEN("/ws"));
    out.heartbeatIntervalMs = 2000.0;
    out.heartbeatTimeoutMs = 30000.0;
    out.handshakeTimeoutMs = 5000.0;
    out.reconnectBaseDelayMs = 250.0;
    out.reconnectMaxDelayMs = 5000.0;
}

// ---- TS (line 877): export class CodexSocketClient extends EventTarget ----
// DEFECT: class + EventTarget — SLA has neither; the client is a struct plus
// a function family (first parameter &CodexSocketClient). Dispatched events
// are recorded into client.events (drained by the host) instead of
// CustomEvent dispatch; addEventListener("server-message") consumers are
// served by codexSocketClientOnServerMessage below.
// DEFECT: WebSocket — browser WebSocket has no sa_std counterpart here; the
// socket is an opaque handle driven through assumed externs
// sa_ws_connect / sa_ws_send / sa_ws_close / sa_ws_ready_state, and the
// socket's open/error/close/message listeners become the
// codexSocketClientOn* functions the host calls.
// DEFECT: timers — window.setTimeout/setInterval become deadline fields
// evaluated by codexSocketClientTick(client, nowMs); Date.now() is injected
// as a now_ms parameter throughout this class.
// DEFECT: Promise — connect/rpc/provider calls register pending entries;
// resolutions land in client.rpcOutcomes / client.providerOutcomes queues.
// readyState codes: 0=CONNECTING, 1=OPEN, 2=CLOSING, 3=CLOSED, 4=no socket.

struct PendingRpc {
    id: SStr,
    has_timeout: bool,
    timeoutMs: f64,
    deadlineMs: f64,
    method: SStr,
}

struct RpcOutcome {
    id: SStr,
    isError: bool,
    result_json: JsonBufC,
    error_json: JsonBufSmallC,
}

struct PendingProviderOp {
    id: SStr,
    kind: u64, // 0=save, 1=activate, 2=delete, 3=trash, 4=restore
    deadlineMs: f64,
    timeoutMs: f64,
}

struct ProviderOutcome {
    id: SStr,
    kind: u64,
    isError: bool,
    isTimeout: bool,
    result_json: JsonBufC,
    error_text: SStr,
}

struct ClientEvent {
    type: SStr,
    detail_json: JsonBufSmallC,
}

struct CodexSocketClient {
    has_socket: bool,
    socket_handle: u64,
    token: [REDACTED],
    has_reconnectTimer: bool,
    reconnectTimerDueMs: f64,
    reconnectTimerIsOfflineWait: bool,
    has_heartbeatTimer: bool,
    heartbeatNextMs: f64,
    has_resumeProbeTimer: bool,
    resumeProbeDueMs: f64,
    resumeProbeSocket: u64,
    resumeProbeSentAt: f64,
    heartbeatSequence: u64,
    lastServerActivityAt: f64,
    has_heartbeatProbeStartedAt: bool,
    heartbeatProbeStartedAt: f64,
    reconnectAttempt: u64,
    has_connectPromise: bool,
    has_openStartedAt: bool,
    openStartedAt: f64,
    handshakeDueMs: f64,
    providerActivationQueue_len: u64,
    closedByClient: bool,
    websocketRuntime: WebSocketRuntimeConfig,
    recoveryListenersAttached: bool,
    nextClientId: u64,
    pending: [PendingRpc; 256],
    pending_len: u64,
    rpcOutcomes: [RpcOutcome; 256],
    rpcOutcomes_len: u64,
    providerOps: [PendingProviderOp; 64],
    providerOps_len: u64,
    providerOutcomes: [ProviderOutcome; 64],
    providerOutcomes_len: u64,
    events: [ClientEvent; 256],
    events_len: u64,
    navigatorOnline: bool,
    documentVisible: bool,
}

fn codexSocketClientInit(client: &CodexSocketClient) -> void {
    client.has_socket = false;
    client.socket_handle = 0;
    client.token.has = false;
    client.token.len = 0;
    client.has_reconnectTimer = false;
    client.has_heartbeatTimer = false;
    client.has_resumeProbeTimer = false;
    client.heartbeatSequence = 0;
    client.lastServerActivityAt = 0.0;
    client.has_heartbeatProbeStartedAt = false;
    client.reconnectAttempt = 0;
    client.has_connectPromise = false;
    client.has_openStartedAt = false;
    client.providerActivationQueue_len = 0;
    client.closedByClient = false;
    defaultWebSocketRuntime(&client.websocketRuntime);
    client.recoveryListenersAttached = false;
    client.nextClientId = 1;
    client.pending_len = 0;
    client.rpcOutcomes_len = 0;
    client.providerOps_len = 0;
    client.providerOutcomes_len = 0;
    client.events_len = 0;
    client.navigatorOnline = true;
    client.documentVisible = true;
}

fn socketReadyState(client: &CodexSocketClient) -> u64 {
    if !client.has_socket { return 4; };
    return sa_ws_ready_state(client.socket_handle);
}

// TS: private dispatch<T>(type: string, detail: T)
// DEFECT: CustomEvent — the event is appended to client.events with the
// detail as JSON text.
fn codexSocketClientDispatch(client: &CodexSocketClient, type_ptr: ptr, type_len: u64, detail_ptr: ptr, detail_len: u64) -> void {
    if client.events_len >= 256 { return; };
    sstrSet(&client.events[client.events_len].type, type_ptr, type_len);
    let slot = &client.events[client.events_len].detail_json;
    slot.len = 0;
    let n = detail_len;
    if n > 2048 { n = 2048; };
    for j in 0..n {
        let b: u8 = 0;
        PTR_BYTE_AT(b, detail_ptr, j);
        slot.bytes[j] = b;
    }
    slot.len = n;
    client.events_len = client.events_len + 1;
}

fn dispatchBoolEvent(client: &CodexSocketClient, type_ptr: ptr, type_len: u64, value: bool) -> void {
    if value { codexSocketClientDispatch(client, type_ptr, type_len, STR_PTR("true"), STR_LEN("true")); } else { codexSocketClientDispatch(client, type_ptr, type_len, STR_PTR("false"), STR_LEN("false")); };
}

// TS: private dispatchConnectionStatus(status: Omit<SocketConnectionStatus, "at">)
// (detail = { ...status, at: Date.now() } built as JSON text)
fn codexSocketClientDispatchConnectionStatus(client: &CodexSocketClient, phase_ptr: ptr, phase_len: u64, hasAttempt: bool, attempt: f64, hasDelay: bool, delayMs: f64, reason_ptr: ptr, reason_len: u64, now_ms: f64) -> void {
    let b = BigStrC { bytes: [0u8; 8192], len: 0 };
    bigStrAppend(&b, STR_PTR("{\"phase\":\""), STR_LEN("{\"phase\":\""));
    bigStrAppend(&b, phase_ptr, phase_len);
    bigStrAppend(&b, STR_PTR("\",\"at\":"), STR_LEN("\",\"at\":"));
    bigStrAppendU64(&b, now_ms as u64);
    if hasAttempt { bigStrAppend(&b, STR_PTR(",\"attempt\":"), STR_LEN(",\"attempt\":")); bigStrAppendU64(&b, attempt as u64); };
    if hasDelay { bigStrAppend(&b, STR_PTR(",\"delayMs\":"), STR_LEN(",\"delayMs\":")); bigStrAppendU64(&b, delayMs as u64); };
    if reason_len > 0 { bigStrAppend(&b, STR_PTR(",\"reason\":\""), STR_LEN(",\"reason\":\"")); bigStrAppend(&b, reason_ptr, reason_len); bigStrAppend(&b, STR_PTR("\""), STR_LEN("\"")); };
    bigStrAppend(&b, STR_PTR("}"), STR_LEN("}"));
    let bp: ptr = PTR_NULL();
    PTR_BYTE_ADD(bp, &b.bytes, 0);
    codexSocketClientDispatch(client, STR_PTR("connection-status"), STR_LEN("connection-status"), bp, b.len);
}

// TS: private send(value: object): void — throws when not OPEN.
// DEFECT: throw -> i32 status (0 sent, 1 not connected / send failed).
fn codexSocketClientSend(client: &CodexSocketClient, value_ptr: ptr, value_len: u64) -> i32 {
    if !client.has_socket || socketReadyState(client) != 1 { return 1; };
    if sa_ws_send(client.socket_handle, value_ptr, value_len) != 0 { return 1; };
    return 0;
}

fn codexSocketClientSendJson(client: &CodexSocketClient, json: &JsonBufC) -> i32 {
    let p: ptr = PTR_NULL();
    PTR_BYTE_ADD(p, &json.bytes, 0);
    return codexSocketClientSend(client, p, json.len);
}

// TS: public async connect(token, runtime?): Promise<void>
// DEFECT: async — returns 0 when already open or when the open was started
// (completion arrives via OnOpen/OnError/OnClose + tick handshake timeout).
fn codexSocketClientConnect(client: &CodexSocketClient, token_ptr: ptr, token_len: u64, hasRuntime: bool, runtime: &WebSocketRuntimeConfig, now_ms: f64) -> i32 {
    sstrSet(&client.token, token_ptr, token_len);
    normalizeWebSocketRuntime(hasRuntime, runtime, &client.websocketRuntime);
    client.closedByClient = false;
    codexSocketClientAttachRecoveryListeners(client);
    if client.has_socket && socketReadyState(client) == 1 {
        codexSocketClientDispatchConnectionStatus(client, STR_PTR("connected"), STR_LEN("connected"), false, 0.0, false, 0.0, STR_PTR(""), 0, now_ms);
        return 0;
    };
    if client.has_connectPromise { return 0; };
    codexSocketClientOpenSocket(client, token_ptr, token_len, now_ms);
    return 0;
}

// TS: public updateToken(token): void
fn codexSocketClientUpdateToken(client: &CodexSocketClient, token_ptr: ptr, token_len: u64, now_ms: f64) -> void {
    let changed = !sstrEq(&client.token, token_ptr, token_len);
    sstrSet(&client.token, token_ptr, token_len);
    if !changed || client.closedByClient { return; };
    if (client.has_socket && socketReadyState(client) == 1) || client.has_connectPromise { return; };
    codexSocketClientClearReconnectTimer(client);
    codexSocketClientScheduleReconnect(client, now_ms);
}

// TS: public disconnect(): void
fn codexSocketClientDisconnect(client: &CodexSocketClient, now_ms: f64) -> void {
    client.closedByClient = true;
    codexSocketClientDetachRecoveryListeners(client);
    codexSocketClientClearReconnectTimer(client);
    codexSocketClientStopHeartbeat(client, false, 0);
    codexSocketClientClearResumeProbeTimer(client);
    codexSocketClientRejectPending(client, STR_PTR("WebSocket disconnected"), STR_LEN("WebSocket disconnected"));
    if client.has_socket { sa_ws_close(client.socket_handle, 1000, STR_PTR(""), 0); };
    client.has_socket = false;
    client.has_connectPromise = false;
    client.has_openStartedAt = false;
    codexSocketClientDispatchConnectionStatus(client, STR_PTR("disconnected"), STR_LEN("disconnected"), false, 0.0, false, 0.0, STR_PTR("Client disconnected"), STR_LEN("Client disconnected"), now_ms);
    dispatchBoolEvent(client, STR_PTR("connected"), STR_LEN("connected"), false);
}

// TS: private openSocket(token): Promise<void>
// DEFECT: Promise + socket listeners — the socket is created now; the
// handshake deadline is armed for tick; open/error/close/message arrive via
// the On* functions below.
fn codexSocketClientOpenSocket(client: &CodexSocketClient, token_ptr: ptr, token_len: u64, now_ms: f64) -> void {
    let url = BigStrC { bytes: [0u8; 8192], len: 0 };
    let err = SStr { bytes: [0u8; 512], len: 0, has: false };
    // DEFECT: window.__CODEX_UI_WEBSOCKET_URL__ override and
    // window.location.href are browser state; the host supplies them in the
    // fix phase — this pass resolves from runtime.path with no override.
    if !resolveWebSocketUrl(token_ptr, token_len, &client.websocketRuntime, STR_PTR(""), 0, STR_PTR(""), 0, &url, &err) {
        // TS: new WebSocket(...) itself would throw synchronously inside the
        // promise executor in that case; recorded as a failed handshake.
        client.has_connectPromise = true;
        let ep: ptr = PTR_NULL();
        PTR_BYTE_ADD(ep, &err.bytes, 0);
        codexSocketClientFailHandshake(client, ep, err.len, now_ms);
        return;
    };
    let up: ptr = PTR_NULL();
    PTR_BYTE_ADD(up, &url.bytes, 0);
    client.socket_handle = sa_ws_connect(up, url.len);
    client.has_socket = client.socket_handle != 0;
    client.has_connectPromise = true;
    client.has_openStartedAt = true;
    client.openStartedAt = now_ms;
    client.handshakeDueMs = now_ms + client.websocketRuntime.handshakeTimeoutMs;
    codexSocketClientDispatchConnectionStatus(client, STR_PTR("connecting"), STR_LEN("connecting"), false, 0.0, false, 0.0, STR_PTR(""), 0, now_ms);
}

// failHandshake mirrors the TS closure inside openSocket.
fn codexSocketClientFailHandshake(client: &CodexSocketClient, message_ptr: ptr, message_len: u64, now_ms: f64) -> void {
    // if (opened || this.socket !== socket) return; — the SLA client tracks a
    // single current socket; `opened` is has_openStartedAt == false after OnOpen.
    if !client.has_connectPromise { return; };
    client.has_socket = false;
    client.has_connectPromise = false;
    client.has_openStartedAt = false;
    // rejectOnce(message): the connect outcome is surfaced as events.
    codexSocketClientDispatchConnectionStatus(client, STR_PTR("disconnected"), STR_LEN("disconnected"), false, 0.0, false, 0.0, message_ptr, message_len, now_ms);
    dispatchBoolEvent(client, STR_PTR("connected"), STR_LEN("connected"), false);
    if client.socket_handle != 0 { sa_ws_close(client.socket_handle, 1000, STR_PTR(""), 0); client.socket_handle = 0; };
    if !client.closedByClient { codexSocketClientScheduleReconnect(client, now_ms); };
}

// TS: socket "open" listener
fn codexSocketClientOnOpen(client: &CodexSocketClient, handle: u64, now_ms: f64) -> void {
    if !client.has_socket || client.socket_handle != handle {
        // superseded socket: reject + close it
        sa_ws_close(handle, 1000, STR_PTR(""), 0);
        return;
    };
    client.has_connectPromise = false;
    client.has_openStartedAt = false;
    client.reconnectAttempt = 0;
    codexSocketClientClearReconnectTimer(client);
    codexSocketClientStartHeartbeat(client, handle, now_ms);
    codexSocketClientDispatchConnectionStatus(client, STR_PTR("connected"), STR_LEN("connected"), false, 0.0, false, 0.0, STR_PTR(""), 0, now_ms);
    dispatchBoolEvent(client, STR_PTR("connected"), STR_LEN("connected"), true);
}

// TS: socket "error" listener ({ once: true }) -> failHandshake("WebSocket connection failed")
fn codexSocketClientOnError(client: &CodexSocketClient, handle: u64, now_ms: f64) -> void {
    if !client.has_socket || client.socket_handle != handle { return; };
    codexSocketClientFailHandshake(client, STR_PTR("WebSocket connection failed"), STR_LEN("WebSocket connection failed"), now_ms);
}

// TS: socket "close" listener
fn codexSocketClientOnClose(client: &CodexSocketClient, handle: u64, code: u64, reason_ptr: ptr, reason_len: u64, now_ms: f64) -> void {
    if !client.has_socket || client.socket_handle != handle { return; };
    let wasOpened = !client.has_openStartedAt && !client.has_connectPromise;
    codexSocketClientStopHeartbeat(client, true, handle);
    client.has_socket = false;
    client.socket_handle = 0;
    client.has_connectPromise = false;
    client.has_openStartedAt = false;
    // if (!opened) rejectOnce("WebSocket closed before connecting") — surfaced via events.
    let msg = BigStrC { bytes: [0u8; 8192], len: 0 };
    if reason_len > 0 {
        bigStrAppend(&msg, reason_ptr, reason_len);
    } else {
        bigStrAppend(&msg, STR_PTR("WebSocket closed ("), STR_LEN("WebSocket closed ("));
        bigStrAppendU64(&msg, code);
        bigStrAppend(&msg, STR_PTR(")"), STR_LEN(")"));
    };
    let mp: ptr = PTR_NULL();
    PTR_BYTE_ADD(mp, &msg.bytes, 0);
    codexSocketClientDispatchConnectionStatus(client, STR_PTR("disconnected"), STR_LEN("disconnected"), false, 0.0, false, 0.0, mp, msg.len, now_ms);
    dispatchBoolEvent(client, STR_PTR("connected"), STR_LEN("connected"), false);
    codexSocketClientRejectPending(client, STR_PTR("WebSocket disconnected"), STR_LEN("WebSocket disconnected"));
    if !client.closedByClient { codexSocketClientScheduleReconnect(client, now_ms); };
    if wasOpened { return; };
}

// TS: socket "message" listener -> handleMessage(event.data)
fn codexSocketClientOnMessage(client: &CodexSocketClient, handle: u64, raw_ptr: ptr, raw_len: u64, now_ms: f64) -> void {
    if !client.has_socket || client.socket_handle != handle { return; };
    codexSocketClientHandleMessage(client, raw_ptr, raw_len, now_ms);
}

// TS: public rpc(method, params?, options?): Promise<JsonValue>
// DEFECT: Promise — registers the pending entry and returns its id slot;
// the outcome is queued in client.rpcOutcomes by handleMessage/tick.
// Returns 0 on registration, 1 when send failed (TS rejects with
// { code: -32000, message } — queued as an immediate error outcome).
fn codexSocketClientRpc(client: &CodexSocketClient, method_ptr: ptr, method_len: u64, hasParams: bool, params_ptr: ptr, params_len: u64, hasTimeoutOption: bool, timeoutIsNull: bool, timeoutMs: f64, now_ms: f64, out_id: &SStr) -> i32 {
    // const id = `ui-${this.nextClientId++}`;
    let idBuf = BigStrC { bytes: [0u8; 8192], len: 0 };
    bigStrAppend(&idBuf, STR_PTR("ui-"), STR_LEN("ui-"));
    bigStrAppendU64(&idBuf, client.nextClientId);
    client.nextClientId = client.nextClientId + 1;
    let ip: ptr = PTR_NULL();
    PTR_BYTE_ADD(ip, &idBuf.bytes, 0);
    sstrSet(out_id, ip, idBuf.len);
    let effectiveTimeout = timeoutMs;
    let hasTimeout = true;
    if !hasTimeoutOption {
        effectiveTimeout = rpcTimeoutMs(method_ptr, method_len);
    } else {
        if timeoutIsNull { hasTimeout = false; };
    };
    if client.pending_len < 256 {
        sstrSet(&client.pending[client.pending_len].id, ip, idBuf.len);
        sstrSet(&client.pending[client.pending_len].method, method_ptr, method_len);
        client.pending[client.pending_len].has_timeout = hasTimeout;
        client.pending[client.pending_len].timeoutMs = effectiveTimeout;
        client.pending[client.pending_len].deadlineMs = now_ms + effectiveTimeout;
        client.pending_len = client.pending_len + 1;
    };
    // this.send({ type: "rpc", id, method, params })
    let msg = JsonBufC { bytes: [0u8; 16384], len: 0 };
    let b = BigStrC { bytes: [0u8; 8192], len: 0 };
    bigStrAppend(&b, STR_PTR("{\"type\":\"rpc\",\"id\":\""), STR_LEN("{\"type\":\"rpc\",\"id\":\""));
    bigStrAppend(&b, ip, idBuf.len);
    bigStrAppend(&b, STR_PTR("\",\"method\":\""), STR_LEN("\",\"method\":\""));
    bigStrAppend(&b, method_ptr, method_len);
    bigStrAppend(&b, STR_PTR("\""), STR_LEN("\""));
    if hasParams {
        bigStrAppend(&b, STR_PTR(",\"params\":"), STR_LEN(",\"params\":"));
        bigStrAppend(&b, params_ptr, params_len);
    };
    bigStrAppend(&b, STR_PTR("}"), STR_LEN("}"));
    let bp: ptr = PTR_NULL();
    PTR_BYTE_ADD(bp, &b.bytes, 0);
    jsonBufSetC(&msg, bp, b.len);
    if codexSocketClientSendJson(client, &msg) != 0 {
        // catch: clear timer, delete pending, reject { code: -32000, ... }
        codexSocketClientRemovePending(client, ip, idBuf.len);
        codexSocketClientQueueRpcOutcome(client, ip, idBuf.len, true, STR_PTR(""), 0, STR_PTR("{\"code\":-32000,\"message\":\"WebSocket is not connected\"}"), STR_LEN("{\"code\":-32000,\"message\":\"WebSocket is not connected\"}"));
        return 1;
    };
    return 0;
}

fn codexSocketClientRemovePending(client: &CodexSocketClient, id_ptr: ptr, id_len: u64) -> bool {
    for i in 0..client.pending_len {
        let ep: ptr = PTR_NULL();
        PTR_BYTE_ADD(ep, &client.pending[i].id.bytes, 0);
        if bytesEq(ep, client.pending[i].id.len, id_ptr, id_len) {
            let k = i;
            while k + 1 < client.pending_len {
                client.pending[k] = client.pending[k + 1];
                k = k + 1;
            }
            client.pending_len = client.pending_len - 1;
            return true;
        };
    }
    return false;
}

fn codexSocketClientQueueRpcOutcome(client: &CodexSocketClient, id_ptr: ptr, id_len: u64, isError: bool, result_ptr: ptr, result_len: u64, error_ptr: ptr, error_len: u64) -> void {
    if client.rpcOutcomes_len >= 256 { return; };
    let slot = &client.rpcOutcomes[client.rpcOutcomes_len];
    sstrSet(&slot.id, id_ptr, id_len);
    slot.isError = isError;
    jsonBufSetC(&slot.result_json, result_ptr, result_len);
    slot.error_json.len = 0;
    let n = error_len;
    if n > 2048 { n = 2048; };
    for j in 0..n {
        let b: u8 = 0;
        PTR_BYTE_AT(b, error_ptr, j);
        slot.error_json.bytes[j] = b;
    }
    slot.error_json.len = n;
    client.rpcOutcomes_len = client.rpcOutcomes_len + 1;
}

// TS: public respondToServerRequest(id, result?, error?): void
// DEFECT: id is string | number — passed as its JSON text.
fn codexSocketClientRespondToServerRequest(client: &CodexSocketClient, id_json_ptr: ptr, id_json_len: u64, hasResult: bool, result_ptr: ptr, result_len: u64, hasError: bool, error_ptr: ptr, error_len: u64) -> void {
    let b = BigStrC { bytes: [0u8; 8192], len: 0 };
    bigStrAppend(&b, STR_PTR("{\"type\":\"serverResponse\",\"requestId\":"), STR_LEN("{\"type\":\"serverResponse\",\"requestId\":"));
    bigStrAppend(&b, id_json_ptr, id_json_len);
    if hasResult { bigStrAppend(&b, STR_PTR(",\"result\":"), STR_LEN(",\"result\":")); bigStrAppend(&b, result_ptr, result_len); };
    if hasError { bigStrAppend(&b, STR_PTR(",\"error\":"), STR_LEN(",\"error\":")); bigStrAppend(&b, error_ptr, error_len); };
    bigStrAppend(&b, STR_PTR("}"), STR_LEN("}"));
    let bp: ptr = PTR_NULL();
    PTR_BYTE_ADD(bp, &b.bytes, 0);
    codexSocketClientSend(client, bp, b.len);
}

// TS: public watchThread(threadId) / unwatchThread(threadId)
fn codexSocketClientWatchThread(client: &CodexSocketClient, threadId_ptr: ptr, threadId_len: u64) -> void {
    let b = BigStrC { bytes: [0u8; 8192], len: 0 };
    bigStrAppend(&b, STR_PTR("{\"type\":\"thread.watch\",\"threadId\":\""), STR_LEN("{\"type\":\"thread.watch\",\"threadId\":\""));
    bigStrAppend(&b, threadId_ptr, threadId_len);
    bigStrAppend(&b, STR_PTR("\"}"), STR_LEN("\"}"));
    let bp: ptr = PTR_NULL();
    PTR_BYTE_ADD(bp, &b.bytes, 0);
    codexSocketClientSend(client, bp, b.len);
}

fn codexSocketClientUnwatchThread(client: &CodexSocketClient, threadId_ptr: ptr, threadId_len: u64) -> void {
    let b = BigStrC { bytes: [0u8; 8192], len: 0 };
    bigStrAppend(&b, STR_PTR("{\"type\":\"thread.unwatch\",\"threadId\":\""), STR_LEN("{\"type\":\"thread.unwatch\",\"threadId\":\""));
    bigStrAppend(&b, threadId_ptr, threadId_len);
    bigStrAppend(&b, STR_PTR("\"}"), STR_LEN("\"}"));
    let bp: ptr = PTR_NULL();
    PTR_BYTE_ADD(bp, &b.bytes, 0);
    codexSocketClientSend(client, bp, b.len);
}

// ---- provider operations (TS lines 1056-1186) ----
// DEFECT: Promise + addEventListener("server-message") per call — each op
// registers a PendingProviderOp; matching server messages are routed by
// codexSocketClientOnServerMessage, timeouts by tick, and results land in
// client.providerOutcomes. formatErrorText is defined later in this file.

fn providerOpTimeoutMessage(kind: u64, timeoutMs: f64, out: &BigStrC) -> void {
    out.len = 0;
    if kind == 0 { bigStrAppend(out, STR_PTR("Provider save timed out after "), STR_LEN("Provider save timed out after ")); };
    if kind == 1 { bigStrAppend(out, STR_PTR("Provider activation timed out after "), STR_LEN("Provider activation timed out after ")); };
    if kind == 2 { bigStrAppend(out, STR_PTR("Provider delete timed out after "), STR_LEN("Provider delete timed out after ")); };
    if kind == 3 { bigStrAppend(out, STR_PTR("Provider trash timed out after "), STR_LEN("Provider trash timed out after ")); };
    if kind == 4 { bigStrAppend(out, STR_PTR("Provider restore timed out after "), STR_LEN("Provider restore timed out after ")); };
    bigStrAppendU64(out, (timeoutMs / 1000.0) as u64);
    bigStrAppend(out, STR_PTR("s"), STR_LEN("s"));
}

fn codexSocketClientQueueProviderOutcome(client: &CodexSocketClient, id_ptr: ptr, id_len: u64, kind: u64, isError: bool, isTimeout: bool, result_ptr: ptr, result_len: u64, error_ptr: ptr, error_len: u64) -> void {
    if client.providerOutcomes_len >= 64 { return; };
    let slot = &client.providerOutcomes[client.providerOutcomes_len];
    sstrSet(&slot.id, id_ptr, id_len);
    slot.kind = kind;
    slot.isError = isError;
    slot.isTimeout = isTimeout;
    jsonBufSetC(&slot.result_json, result_ptr, result_len);
    sstrSet(&slot.error_text, error_ptr, error_len);
    if !isError { slot.error_text.has = false; slot.error_text.len = 0; };
    client.providerOutcomes_len = client.providerOutcomes_len + 1;
}

fn codexSocketClientRegisterProviderOp(client: &CodexSocketClient, kind: u64, id_ptr: ptr, id_len: u64, timeoutMs: f64, now_ms: f64) -> void {
    if client.providerOps_len >= 64 { return; };
    sstrSet(&client.providerOps[client.providerOps_len].id, id_ptr, id_len);
    client.providerOps[client.providerOps_len].kind = kind;
    client.providerOps[client.providerOps_len].timeoutMs = timeoutMs;
    client.providerOps[client.providerOps_len].deadlineMs = now_ms + timeoutMs;
    client.providerOps_len = client.providerOps_len + 1;
}

fn codexSocketClientRemoveProviderOp(client: &CodexSocketClient, index: u64) -> void {
    let k = index;
    while k + 1 < client.providerOps_len {
        client.providerOps[k] = client.providerOps[k + 1];
        k = k + 1;
    }
    if client.providerOps_len > 0 { client.providerOps_len = client.providerOps_len - 1; };
}

// Builds an op id `<prefix>${nextClientId++}` (TS template ids).
fn providerOpId(client: &CodexSocketClient, prefix_ptr: ptr, prefix_len: u64, out: &SStr) -> void {
    let b = BigStrC { bytes: [0u8; 8192], len: 0 };
    bigStrAppend(&b, prefix_ptr, prefix_len);
    bigStrAppendU64(&b, client.nextClientId);
    client.nextClientId = client.nextClientId + 1;
    let bp: ptr = PTR_NULL();
    PTR_BYTE_ADD(bp, &b.bytes, 0);
    sstrSet(out, bp, b.len);
}

// TS: public saveProvider(provider, apiKey?, mergeIntoProviderId?): Promise<ProviderConfig>
fn codexSocketClientSaveProvider(client: &CodexSocketClient, provider_json_ptr: ptr, provider_json_len: u64, hasApiKey: bool, apiKey_ptr: ptr, apiKey_len: u64, hasMerge: bool, mergeId_ptr: ptr, mergeId_len: u64, now_ms: f64, out_id: &SStr) -> void {
    providerOpId(client, STR_PTR("provider-"), STR_LEN("provider-"), out_id);
    let ip: ptr = PTR_NULL();
    PTR_BYTE_ADD(ip, &out_id.bytes, 0);
    let b = BigStrC { bytes: [0u8; 8192], len: 0 };
    bigStrAppend(&b, STR_PTR("{\"type\":\"provider.save\",\"id\":\""), STR_LEN("{\"type\":\"provider.save\",\"id\":\""));
    bigStrAppend(&b, ip, out_id.len);
    bigStrAppend(&b, STR_PTR("\",\"provider\":"), STR_LEN("\",\"provider\":"));
    bigStrAppend(&b, provider_json_ptr, provider_json_len);
    if hasApiKey { bigStrAppend(&b, STR_PTR(",\"apiKey\":\""), STR_LEN(",\"apiKey\":\"")); bigStrAppend(&b, apiKey_ptr, apiKey_len); bigStrAppend(&b, STR_PTR("\""), STR_LEN("\"")); };
    if hasMerge { bigStrAppend(&b, STR_PTR(",\"mergeIntoProviderId\":\""), STR_LEN(",\"mergeIntoProviderId\":\"")); bigStrAppend(&b, mergeId_ptr, mergeId_len); bigStrAppend(&b, STR_PTR("\""), STR_LEN("\"")); };
    bigStrAppend(&b, STR_PTR("}"), STR_LEN("}"));
    let bp: ptr = PTR_NULL();
    PTR_BYTE_ADD(bp, &b.bytes, 0);
    codexSocketClientSend(client, bp, b.len);
    codexSocketClientRegisterProviderOp(client, 0, ip, out_id.len, PROVIDER_MUTATION_TIMEOUT_MS() as f64, now_ms);
}

// TS: public activateProvider(providerId, model?, groupId?): Promise<ProviderActivation>
//   const task = this.providerActivationQueue.catch(() => undefined)
//     .then(() => this.activateProviderNow(...)); queue = task; return task;
// DEFECT: promise queue — ops run sequentially in TS; here activateProvider
// counts the queue length and starts immediately when no activation is in
// flight, otherwise the op stays queued (providerActivationQueue_len > 0)
// for the host to start via activateProviderNow as outcomes drain.
fn codexSocketClientActivateProvider(client: &CodexSocketClient, providerId_ptr: ptr, providerId_len: u64, hasModel: bool, model_ptr: ptr, model_len: u64, hasGroup: bool, groupId_ptr: ptr, groupId_len: u64, now_ms: f64, out_id: &SStr) -> void {
    let inFlight = false;
    for i in 0..client.providerOps_len { if client.providerOps[i].kind == 1 { inFlight = true; }; }
    if inFlight {
        client.providerActivationQueue_len = client.providerActivationQueue_len + 1;
        out_id.has = false;
        out_id.len = 0;
        return;
    };
    codexSocketClientActivateProviderNow(client, providerId_ptr, providerId_len, hasModel, model_ptr, model_len, hasGroup, groupId_ptr, groupId_len, now_ms, out_id);
}

// TS: private activateProviderNow(providerId, model?, groupId?)
fn codexSocketClientActivateProviderNow(client: &CodexSocketClient, providerId_ptr: ptr, providerId_len: u64, hasModel: bool, model_ptr: ptr, model_len: u64, hasGroup: bool, groupId_ptr: ptr, groupId_len: u64, now_ms: f64, out_id: &SStr) -> void {
    providerOpId(client, STR_PTR("provider-activate-"), STR_LEN("provider-activate-"), out_id);
    let ip: ptr = PTR_NULL();
    PTR_BYTE_ADD(ip, &out_id.bytes, 0);
    let b = BigStrC { bytes: [0u8; 8192], len: 0 };
    bigStrAppend(&b, STR_PTR("{\"type\":\"provider.activate\",\"id\":\""), STR_LEN("{\"type\":\"provider.activate\",\"id\":\""));
    bigStrAppend(&b, ip, out_id.len);
    bigStrAppend(&b, STR_PTR("\",\"providerId\":\""), STR_LEN("\",\"providerId\":\""));
    bigStrAppend(&b, providerId_ptr, providerId_len);
    bigStrAppend(&b, STR_PTR("\""), STR_LEN("\""));
    if hasModel { bigStrAppend(&b, STR_PTR(",\"model\":\""), STR_LEN(",\"model\":\"")); bigStrAppend(&b, model_ptr, model_len); bigStrAppend(&b, STR_PTR("\""), STR_LEN("\"")); };
    if hasGroup { bigStrAppend(&b, STR_PTR(",\"groupId\":\""), STR_LEN(",\"groupId\":\"")); bigStrAppend(&b, groupId_ptr, groupId_len); bigStrAppend(&b, STR_PTR("\""), STR_LEN("\"")); };
    bigStrAppend(&b, STR_PTR("}"), STR_LEN("}"));
    let bp: ptr = PTR_NULL();
    PTR_BYTE_ADD(bp, &b.bytes, 0);
    codexSocketClientSend(client, bp, b.len);
    codexSocketClientRegisterProviderOp(client, 1, ip, out_id.len, PROVIDER_ACTIVATION_TIMEOUT_MS() as f64, now_ms);
}

