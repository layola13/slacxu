// Shared member-write pattern: on !ok throw body.error ?? `${fallback}: ${status}` (create/update/delete variants differ only in fallback).
fn memberWrite(token_ptr: ptr, token_len: u64, method_ptr: ptr, method_len: u64, url_ptr: ptr, url_len: u64, hasBody: bool, body_ptr: ptr, body_len: u64, fallback_ptr: ptr, fallback_len: u64, out: &JsonBufC, err: &SStr) -> i32 {
    let resp = HttpResponse { status: 0, body: JsonBufC { bytes: [0u8; 16384], len: 0 } };
    if httpFetchJson(method_ptr, method_len, url_ptr, url_len, token_ptr, token_len, hasBody, body_ptr, body_len, &resp) != 0 { return 1; };
    if !responseOk(&resp) {
        let rp: ptr = PTR_NULL();
        PTR_BYTE_ADD(rp, &resp.body.bytes, 0);
        let ep: ptr = PTR_NULL();
        let el: u64 = 0;
        if sa_json_object_get_string(rp, resp.body.len, STR_PTR("error"), STR_LEN("error"), &ep, &el) == 0 { sstrSet(err, ep, el); return 1; };
        let msg = BigStrC { bytes: [0u8; 8192], len: 0 };
        bigStrAppend(&msg, fallback_ptr, fallback_len);
        bigStrAppend(&msg, STR_PTR(": "), STR_LEN(": "));
        bigStrAppendU64(&msg, resp.status);
        let mp: ptr = PTR_NULL();
        PTR_BYTE_ADD(mp, &msg.bytes, 0);
        sstrSet(err, mp, msg.len);
        return 1;
    };
    let rp: ptr = PTR_NULL();
    PTR_BYTE_ADD(rp, &resp.body.bytes, 0);
    let dp: ptr = PTR_NULL();
    let dl: u64 = 0;
    if sa_json_object_get_value_text(rp, resp.body.len, STR_PTR("data"), STR_LEN("data"), &dp, &dl) == 0 { jsonBufSetC(out, dp, dl); } else { out.len = 0; };
    return 0;
}

fn memberUrl(id_ptr: ptr, id_len: u64, suffix_ptr: ptr, suffix_len: u64, out: &BigStrC) -> void {
    out.len = 0;
