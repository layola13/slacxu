// DEFECT: async.
fn updateUserPreferences(token_ptr: ptr, token_len: u64, patch_json: &JsonBufC, out: &JsonBufC, err: &SStr) -> i32 {
    let bp: ptr = PTR_NULL();
    PTR_BYTE_ADD(bp, &patch_json.bytes, 0);
    let resp = HttpResponse { status: 0, body: JsonBufC { bytes: [0u8; 16384], len: 0 } };
    if httpFetchJson(STR_PTR("PATCH"), STR_LEN("PATCH"), STR_PTR("/api/preferences"), STR_LEN("/api/preferences"), token_ptr, token_len, true, bp, patch_json.len, &resp) != 0 { return 1; };
    if !responseOk(&resp) {
        let rp: ptr = PTR_NULL();
        PTR_BYTE_ADD(rp, &resp.body.bytes, 0);
        let ep: ptr = PTR_NULL();
        let el: u64 = 0;
        if sa_json_object_get_string(rp, resp.body.len, STR_PTR("error"), STR_LEN("error"), &ep, &el) == 0 && el > 0 { sstrSet(err, ep, el); return 1; };
        let msg = BigStrC { bytes: [0u8; 8192], len: 0 };
        bigStrAppend(&msg, STR_PTR("Failed to save preferences: "), STR_LEN("Failed to save preferences: "));
        bigStrAppendU64(&msg, resp.status);
        let mp: ptr = PTR_NULL();
        PTR_BYTE_ADD(mp, &msg.bytes, 0);
        sstrSet(err, mp, msg.len);
        return 1;
    };
    let rp: ptr = PTR_NULL();
    PTR_BYTE_ADD(rp, &resp.body.bytes, 0);
    let dp: ptr = PTR_NULL();
    let dl: u64 = 0;
    if sa_json_object_get_value_text(rp, resp.body.len, STR_PTR("data"), STR_LEN("data"), &dp, &dl) == 0 { jsonBufSetC(out, dp, dl); } else { jsonBufSetC(out, STR_PTR("{}"), STR_LEN("{}")); };
    return 0;
}

// TS (line 1965): export class ProjectApiError extends Error
// DEFECT: class extends Error — a struct with the TS public fields; thrown
// instances are returned through projectRequest's err parameter.
struct ProjectApiError {
    name: SStr,
    code: SStr,
    message: SStr,
    status: f64,
}

fn projectApiErrorInit(err: &ProjectApiError, code_ptr: ptr, code_len: u64, message_ptr: ptr, message_len: u64, status: f64) -> void {
    sstrSetLit(&err.name, STR_PTR("ProjectApiError"), STR_LEN("ProjectApiError"));
    sstrSet(&err.code, code_ptr, code_len);
    sstrSet(&err.message, message_ptr, message_len);
    err.status = status;
}

// TS (line 1958): async function projectRequest<T>(token, path, init?): Promise<T>
// DEFECT: async + generics — T is the response `data` JSON text.
// DEFECT: RequestInit (method/body/headers) is flattened to method + body
// parameters; the Content-Type/token headers are applied by httpFetchJson.
fn projectRequest(token_ptr: ptr, token_len: u64, path_ptr: ptr, path_len: u64, method_ptr: ptr, method_len: u64, hasBody: bool, body_ptr: ptr, body_len: u64, out: &JsonBufC, err: &ProjectApiError) -> i32 {
    let resp = HttpResponse { status: 0, body: JsonBufC { bytes: [0u8; 16384], len: 0 } };
    if httpFetchJson(method_ptr, method_len, path_ptr, path_len, token_ptr, token_len, hasBody, body_ptr, body_len, &resp) != 0 { return 1; };
    if !responseOk(&resp) {
        // throw new ProjectApiError(body.code ?? "CUX-PROJECT-API-001",
        //   body.error || `Project request failed: ${status}`, status)
        let rp: ptr = PTR_NULL();
        PTR_BYTE_ADD(rp, &resp.body.bytes, 0);
        let cp: ptr = PTR_NULL();
        let cl: u64 = 0;
        let hasCode = sa_json_object_get_string(rp, resp.body.len, STR_PTR("code"), STR_LEN("code"), &cp, &cl) == 0;
        let ep: ptr = PTR_NULL();
        let el: u64 = 0;
        let hasErrText = sa_json_object_get_string(rp, resp.body.len, STR_PTR("error"), STR_LEN("error"), &ep, &el) == 0 && el > 0;
        let msg = BigStrC { bytes: [0u8; 8192], len: 0 };
        if hasErrText {
            bigStrAppend(&msg, ep, el);
        } else {
            bigStrAppend(&msg, STR_PTR("Project request failed: "), STR_LEN("Project request failed: "));
            bigStrAppendU64(&msg, resp.status);
        };
        let mp: ptr = PTR_NULL();
        PTR_BYTE_ADD(mp, &msg.bytes, 0);
        if hasCode { projectApiErrorInit(err, cp, cl, mp, msg.len, resp.status as f64); } else { projectApiErrorInit(err, STR_PTR("CUX-PROJECT-API-001"), STR_LEN("CUX-PROJECT-API-001"), mp, msg.len, resp.status as f64); };
        return 1;
    };
    let rp: ptr = PTR_NULL();
    PTR_BYTE_ADD(rp, &resp.body.bytes, 0);
    let dp: ptr = PTR_NULL();
    let dl: u64 = 0;
    if sa_json_object_get_value_text(rp, resp.body.len, STR_PTR("data"), STR_LEN("data"), &dp, &dl) == 0 { jsonBufSetC(out, dp, dl); } else { out.len = 0; };
    return 0;
}

