// TS (line 2069): export async function fetchThreadRuntimeMetadata(token, threadId)
//   : Promise<ThreadRuntimeMetadata | null>
// DEFECT: async; ThreadRuntimeMetadata (shared) kept as JSON; body.data ?? null.
fn fetchThreadRuntimeMetadata(token_ptr: ptr, token_len: u64, threadId_ptr: ptr, threadId_len: u64, out: &JsonBufC, hasOut: &bool, err: &SStr) -> i32 {
    let url = BigStrC { bytes: [0u8; 8192], len: 0 };
    bigStrAppend(&url, STR_PTR("/api/thread-runtime?threadId="), STR_LEN("/api/thread-runtime?threadId="));
    let enc = BigStrC { bytes: [0u8; 8192], len: 0 };
    urlEncodeComponent(threadId_ptr, threadId_len, &enc);
    let ep: ptr = PTR_NULL();
    PTR_BYTE_ADD(ep, &enc.bytes, 0);
    bigStrAppend(&url, ep, enc.len);
    let up: ptr = PTR_NULL();
    PTR_BYTE_ADD(up, &url.bytes, 0);
    let resp = HttpResponse { status: 0, body: JsonBufC { bytes: [0u8; 16384], len: 0 } };
    if httpFetchJson(STR_PTR("GET"), STR_LEN("GET"), up, url.len, token_ptr, token_len, false, STR_PTR(""), 0, &resp) != 0 { return 1; };
    if !responseOk(&resp) {
        // body.error || `Failed to load conversation runtime metadata: ${status}` — colon form
        let rp: ptr = PTR_NULL();
        PTR_BYTE_ADD(rp, &resp.body.bytes, 0);
        let ep2: ptr = PTR_NULL();
        let el2: u64 = 0;
        if sa_json_object_get_string(rp, resp.body.len, STR_PTR("error"), STR_LEN("error"), &ep2, &el2) == 0 && el2 > 0 { sstrSet(err, ep2, el2); return 1; };
        let msg = BigStrC { bytes: [0u8; 8192], len: 0 };
        bigStrAppend(&msg, STR_PTR("Failed to load conversation runtime metadata: "), STR_LEN("Failed to load conversation runtime metadata: "));
        bigStrAppendU64(&msg, resp.status);
        let mp: ptr = PTR_NULL();
        PTR_BYTE_ADD(mp, &msg.bytes, 0);
        sstrSet(err, mp, msg.len);
        return 1;
    };
    let rp: ptr = PTR_NULL();
    PTR_BYTE_ADD(rp, &resp.body.bytes, 0);
    let dp: ptr = PTR_NULL();
    let dl: u64 = 0;
    *hasOut = sa_json_object_get_value_text(rp, resp.body.len, STR_PTR("data"), STR_LEN("data"), &dp, &dl) == 0;
    if *hasOut { jsonBufSetC(out, dp, dl); } else { out.len = 0; };
    return 0;
}

// Shared error pattern for the runtime-metadata/admin writes:
//   if (!ok) throw body.error || `${fallback}: ${status}`;
//   if (!body.data) throw fallback;
fn dataOrErrorColon(resp: &HttpResponse, fallback_ptr: ptr, fallback_len: u64, out: &JsonBufC, err: &SStr) -> i32 {
    if !responseOk(resp) {
        let rp: ptr = PTR_NULL();
        PTR_BYTE_ADD(rp, &resp.body.bytes, 0);
        let ep: ptr = PTR_NULL();
        let el: u64 = 0;
        if sa_json_object_get_string(rp, resp.body.len, STR_PTR("error"), STR_LEN("error"), &ep, &el) == 0 && el > 0 { sstrSet(err, ep, el); return 1; };
        let msg = BigStrC { bytes: [0u8; 8192], len: 0 };
        bigStrAppend(&msg, fallback_ptr, fallback_len);
        bigStrAppend(&msg, STR_PTR(": "), STR_LEN(": "));
        bigStrAppendU64(&msg, resp.status);
        let mp: ptr = PTR_NULL();
        PTR_BYTE_ADD(mp, &msg.bytes, 0);
        sstrSet(err, mp, msg.len);
        return 1;
    };
    let rp: ptr = PTR_NULL();
    PTR_BYTE_ADD(rp, &resp.body.bytes, 0);
    let dp: ptr = PTR_NULL();
    let dl: u64 = 0;
    if sa_json_object_get_value_text(rp, resp.body.len, STR_PTR("data"), STR_LEN("data"), &dp, &dl) != 0 { sstrSet(err, fallback_ptr, fallback_len); return 1; };
    jsonBufSetC(out, dp, dl);
    return 0;
}

