                    if !recStrNE(jsonPtrC(&rec), rec.len, STR_PTR("message"), STR_LEN("message"), &e.message) { sstrSetLit(&e.message, STR_PTR("Unable to load skill"), STR_LEN("Unable to load skill")); };
