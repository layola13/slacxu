// (this file uses DOM tags only; the includes are the batch-standard set).
// Source declarations in order: StartupErrorBoundary (class, src:15-31), isIgnorableRuntimeError (src:33),
// installGlobalErrorDiagnostics (src:38), showMountFailure (src:55), StartupFailureScreen (src:59),
// createFailureDetails (src:83), normalizeError (src:102), hashFingerprint (src:115),
// showFailureOverlay (src:124), createOverlayButton (src:148), copyDiagnostic (src:156),
// style constants (src:165-177).
// DEFECT: StartupErrorBoundary is a React error boundary (static getDerivedStateFromError +
// componentDidCatch, src:19-28) — the dialect has no error-boundary construct and no class
// components. The component below is the pass-through shell (children via Slot); its render
// switch `if (this.state.failure) return <StartupFailureScreen/>; return children` (src:27-30)
// is an element-level conditional with no dialect form (bridge item, FIX_FRONTEND_PHASE2 §3.5.2).
// StartupFailureScreen itself is fully converted as a sibling component.
// DEFECT: installGlobalErrorDiagnostics / showMountFailure / showFailureOverlay /
// createOverlayButton are imperative DOM code (window.addEventListener, document.createElement,
// overlay.style.cssText, append/remove) and createFailureDetails / normalizeError /
// hashFingerprint / isIgnorableRuntimeError are pure logic over host APIs (document.querySelector,
// window.location, Date) — no JSX, no SAX behavior counterpart; names and src lines registered here.
// DEFECT: copyDiagnostic uses navigator.clipboard / window.prompt — no airlock bridge; the
// copy_diagnostic handler below is structure-only. window.location.reload likewise has no
// bridge; the reload handler is structure-only.
// Style note: TSX style objects (src:165-177) are inlined as style={{...}} on the elements;
// numeric CSS values are written in px string form (React appends px at runtime).

<Component name="StartupFailureScreen">
  <state>
    failure_code = alloc 64
    failure_code_len = 0
    failure_message = alloc 512
    failure_message_len = 0
    failure_diagnostic = alloc 2048
    failure_diagnostic_len = 0
  </state>

  <main role="alert" data-testid="startup-error-screen" style={{ minHeight: "100vh", display: "grid", placeItems: "center", boxSizing: "border-box", padding: "24px", background: "#f7f9fc", color: "#111827", fontFamily: "system-ui, sans-serif" }}>
    <section style={{ width: "min(680px, 100%)", boxSizing: "border-box", padding: "24px", border: "1px solid #fecaca", borderRadius: "8px", background: "#fff", boxShadow: "0 18px 55px rgba(15, 23, 42, 0.14)" }}>
      <div style={{ color: "#b91c1c", fontFamily: "ui-monospace, monospace", fontSize: "13px", fontWeight: "800" }}>{failure_code}</div>
      <h1 style={{ margin: "8px 0", fontSize: "24px", letterSpacing: "0" }}>Codex Ultra could not start</h1>
      <p style={{ margin: "0 0 18px", color: "#475569", overflowWrap: "anywhere" }}>{failure_message}</p>
      <div style={{ display: "flex", gap: "8px", flexWrap: "wrap" }}>
        <button type="button" style={{ padding: "9px 13px", border: "1px solid #b91c1c", borderRadius: "6px", background: "#b91c1c", color: "#fff", cursor: "pointer", fontWeight: "700" }} onClick={reload}>Reload</button>
        <button type="button" style={{ padding: "9px 13px", border: "1px solid #cbd5e1", borderRadius: "6px", background: "#fff", color: "#111827", cursor: "pointer", fontWeight: "700" }} onClick={copy_diagnostic}>Copy diagnostic</button>
      </div>
      <details style={{ marginTop: "18px", color: "#475569" }}>
        <summary>Technical details</summary>
        <pre style={{ maxHeight: "38vh", overflow: "auto", whiteSpace: "pre-wrap", overflowWrap: "anywhere", padding: "12px", borderRadius: "6px", background: "#0f172a", color: "#e2e8f0", fontSize: "12px" }}>{failure_diagnostic}</pre>
      </details>
    </section>
  </main>

  @reload:
  L_ENTRY:
    ret

  @copy_diagnostic:
  L_ENTRY:
    ret

  !failure_code !failure_code_len !failure_message !failure_message_len !failure_diagnostic !failure_diagnostic_len
</Component>

<Component name="StartupErrorBoundary">
  <section class="startup-error-boundary">
    <Slot />
  </section>
</Component>
