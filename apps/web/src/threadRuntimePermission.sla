@import "sa_std/ptr.sa"
// Import (type-only): PermissionPresetId from "@codex-ui/shared" — encoding: 0 readonlyAsk, 1 workspaceAsk, 2 fullAsk, 3 dangerBypass, 255 undefined.

const THREAD_RUNTIME_PERMISSION_SCHEMA_VERSION: u64 = 1;

struct RestoreThreadRuntimePermissionInput { isNewConversation: bool, permission_tag: u64, permission_has: bool, permissionSchemaVersion: u64, permissionSchemaVersion_has: bool, dangerBypassConfirmed: bool, dangerBypassConfirmed_isBool: bool } // DEFECT: unknown-typed fields — tag/has flags approximate typeof checks
struct RestoreThreadRuntimePermissionResult { permission: u64, permissionSchemaVersion: u64, dangerBypassConfirmed: bool }

fn restoreThreadRuntimePermission(input: &RestoreThreadRuntimePermissionInput, out: &RestoreThreadRuntimePermissionResult) -> void {
    let hasCurrentSchema = input.permissionSchemaVersion_has && input.permissionSchemaVersion == THREAD_RUNTIME_PERMISSION_SCHEMA_VERSION;
    let stored_has = false;
    let stored: u64 = 255;
    if hasCurrentSchema { stored = permissionPresetId(input.permission_tag, input.permission_has, &stored_has); };
    let permission: u64 = stored;
    if !stored_has {
        if input.isNewConversation { permission = 1; } else { permission = 3; }; // "workspaceAsk" : "dangerBypass"
    };
    out.permission = permission;
    out.permissionSchemaVersion = THREAD_RUNTIME_PERMISSION_SCHEMA_VERSION;
    if hasCurrentSchema && input.dangerBypassConfirmed_isBool { out.dangerBypassConfirmed = input.dangerBypassConfirmed; } else { out.dangerBypassConfirmed = permission == 3; };
}

fn permissionPresetId(value_tag: u64, value_has: bool, out_has: &bool) -> u64 {
    // value === "readonlyAsk"|"workspaceAsk"|"fullAsk"|"dangerBypass" ? value : undefined — value_tag already uses the encoding above when source string matched.
    *out_has = value_has && value_tag <= 3;
    if *out_has { return value_tag; };
    return 255;
}
