// Converted 1:1 from apps/web/src/mobile/useIsMobile.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.

// Import in source: useMediaQuery from "@mui/material" (React hook bound to CSS media queries).
// Source comments (breakpoints, CSS px, portrait): iPhone SE/12 mini 375, iPhone 12-15 390,
// 15 Pro 393, Pro Max 414/430, Android compact 360, Pixel 6/7 412 — portrait phones all <= 768;
// landscape phones 740-932 wide + coarse pointer covered by second query; portrait tablets 768+ stay desktop.

const MOBILE_MAX_WIDTH_PX: u64 = 768;

// DEFECT: React hook useIsMobile/useMediaQuery — hooks semantics (reactive re-render on media
// change) have no SLA counterpart; converted to a plain snapshot function reading host-supplied flags.
fn useIsMobile(viewportWidthPx: u64, pointerCoarse: bool, landscape: bool) -> bool {
    let narrow: bool = viewportWidthPx <= MOBILE_MAX_WIDTH_PX - 1;
    let landscapePhone: bool = viewportWidthPx <= 932 && pointerCoarse && landscape;
    return narrow || landscapePhone;
}
