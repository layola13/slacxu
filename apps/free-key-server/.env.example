FREE_KEY_HOST=127.0.0.1
FREE_KEY_PORT=43210
FREE_KEY_DATABASE=./data/free-keys.sqlite3
FREE_KEY_HASH_PEPPER=replace-with-a-long-random-secret
FREE_KEY_CLIENT_SECRET=
FREE_KEY_ADMIN_SECRET=replace-with-an-admin-secret
FREE_KEY_DEFAULT_VALIDITY_DAYS=1
FREE_KEY_REFRESH_INTERVAL_HOURS=5
FREE_KEY_REQUIRED_TTL_MINUTES=15
FREE_KEY_DISCORD_INVITE_URL=https://discord.gg/QCNUx8FaV
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
