FREE_KEY_ADMIN_USERNAME=admin
# Format: scrypt:<salt>:<derived-key-hex>; generate with the command in docs/free-model-key-flow.md
FREE_KEY_ADMIN_PASSWORD_HASH=
FREE_KEY_ADMIN_SESSION_SECRET=
