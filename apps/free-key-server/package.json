{
  "name": "@codex-ui/free-key-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit --noUnusedLocals --noUnusedParameters --noFallthroughCasesInSwitch --noImplicitReturns --noImplicitOverride",
    "lint": "tsc -p tsconfig.json --noEmit --noUnusedLocals --noUnusedParameters --noFallthroughCasesInSwitch --noImplicitReturns --noImplicitOverride",
    "start": "node dist/index.js",
    "dev": "npm run build && node --watch dist/index.js",
    "register-discord-command": "node scripts/register-discord-command.mjs",
    "reset-admin-totp": "node dist/resetAdminTotp.js",
    "test": "npm run build && node --test dist/*.test.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.9.3"
  }
}
