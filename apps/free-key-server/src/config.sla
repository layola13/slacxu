// Converted 1:1 from apps/free-key-server/src/config.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "sa_std/env.sai"
@import "sa_std/ptr.sa"
@import "sa_std/string.sa"

// TS: import { resolve } from "node:path";
// DEFECT: node:path resolve() (cwd-joined absolute path) has no sa_std
// counterpart here; databasePath is kept as the raw env value in this pass.
// DEFECT: TS throw new Error(...) -> load_config returns an i32 status and
// writes the message into err (0 = ok, 1 = validation failure).
// DEFECT: process.env / NodeJS.ProcessEnv parameter — env is read through
// sa_env_get directly; the injectable env parameter is dropped.
// DEFECT: string | null fields use an explicit has_* flag; strings are
// fixed-capacity fields (512 bytes) holding the trimmed env value.

struct StrField {
    bytes: [u8; 512],
    len: u64,
}

fn str_field_set(f: &StrField, src_ptr: ptr, src_len: u64) -> void {
    f.len = 0;
    for i in 0..src_len {
        if f.len < 512 {
            let b: u8 = 0;
            PTR_BYTE_AT(b, src_ptr, i);
            f.bytes[f.len] = b;
            f.len = f.len + 1;
        };
    }
}

// Reads env key into scratch (trimmed). Returns false when unset/empty.
// JS .trim() approximated: strips ASCII space/tab/CR/LF at both ends.
fn env_trimmed(key_ptr: ptr, key_len: u64, scratch: &ByteBuf) -> bool {
    buf_reset(scratch);
    let h = sa_env_get(key_ptr, key_len);
    if h == 0 { return false; };
    let vp: ptr = sa_env_buffer_data(h);
    let vl = sa_env_buffer_len(h);
    let start: u64 = 0;
    let end = vl;
    while start < end {
        let b: u8 = 0;
        PTR_BYTE_AT(b, vp, start);
        if b == 32 || b == 9 || b == 13 || b == 10 { start = start + 1; } else { break; };
    }
    while end > start {
        let b: u8 = 0;
        PTR_BYTE_AT(b, vp, end - 1);
        if b == 32 || b == 9 || b == 13 || b == 10 { end = end - 1; } else { break; };
    }
    if end <= start { return false; };
    for i in start..end {
        let b: u8 = 0;
        PTR_BYTE_AT(b, vp, i);
        buf_append_byte(scratch, b);
    }
    return scratch.len > 0;
}

// TS: function positiveNumber(value: string | undefined, fallback: number): number
// DEFECT: Number() full JS semantics (exponents, hex, Infinity) approximated
// by a decimal parser; NaN/unparseable or <= 0 -> fallback.
fn positive_number(has_value: bool, vp: ptr, vl: u64, fallback: f64) -> f64 {
    if !has_value { return fallback; };
    let result: f64 = 0.0;
    let frac_scale: f64 = 0.0;
    let seen_digit = false;
    let seen_dot = false;
    for i in 0..vl {
        let b: u8 = 0;
        PTR_BYTE_AT(b, vp, i);
        if b >= 48 && b <= 57 {
            seen_digit = true;
            let d = (b - 48) as f64;
            if seen_dot {
                frac_scale = frac_scale / 10.0;
                result = result + d * frac_scale;
            } else {
                result = result * 10.0 + d;
            };
        } else if b == 46 && !seen_dot {
            seen_dot = true;
            frac_scale = 1.0;
        } else {
            return fallback;
        };
    }
    if !seen_digit { return fallback; };
    if result > 0.0 { return result; };
    return fallback;
}

// TS: export type FreeKeyServerConfig = { ... } (field order preserved).
struct FreeKeyServerConfig {
    host: StrField,
    port: u64,
    database_path: StrField,
    hash_pepper: StrField,
    has_client_secret: bool,
    client_secret: StrField,
    admin_secret: StrField,
    has_admin_username: bool,
    admin_username: StrField,
    has_admin_password_hash: bool,
    admin_password_hash: StrField,
    has_admin_session_secret: bool,
    admin_session_secret: StrField,
    default_validity_days: f64,
    refresh_interval_hours: f64,
    required_ttl_minutes: f64,
    discord_invite_url: StrField,
    has_discord_public_key: bool,
    discord_public_key: StrField,
    has_discord_channel_id: bool,
    discord_channel_id: StrField,
}

// TS: export function loadConfig(env = process.env): FreeKeyServerConfig
fn load_config(cfg: &FreeKeyServerConfig, err: &ByteBuf) -> i32 {
    let scratch = ByteBuf { bytes: [0u8; 40960], len: 0 };
    buf_reset(err);
    // hashPepper / adminSecret are required with minimum lengths.
    if !env_trimmed(STR_PTR("FREE_KEY_HASH_PEPPER"), STR_LEN("FREE_KEY_HASH_PEPPER"), &scratch) || scratch.len < 24 {
        buf_append_lit(err, STR_PTR("FREE_KEY_HASH_PEPPER must contain at least 24 characters"), STR_LEN("FREE_KEY_HASH_PEPPER must contain at least 24 characters"));
        return 1;
    };
    str_field_set(&cfg.hash_pepper, &scratch.bytes, scratch.len);
    if !env_trimmed(STR_PTR("FREE_KEY_ADMIN_SECRET"), STR_LEN("FREE_KEY_ADMIN_SECRET"), &scratch) || scratch.len < 16 {
        buf_append_lit(err, STR_PTR("FREE_KEY_ADMIN_SECRET must contain at least 16 characters"), STR_LEN("FREE_KEY_ADMIN_SECRET must contain at least 16 characters"));
        return 1;
    };
    str_field_set(&cfg.admin_secret, &scratch.bytes, scratch.len);
    cfg.has_admin_username = env_trimmed(STR_PTR("FREE_KEY_ADMIN_USERNAME"), STR_LEN("FREE_KEY_ADMIN_USERNAME"), &scratch);
    if cfg.has_admin_username { str_field_set(&cfg.admin_username, &scratch.bytes, scratch.len); };
    cfg.has_admin_password_hash = env_trimmed(STR_PTR("FREE_KEY_ADMIN_PASSWORD_HASH"), STR_LEN("FREE_KEY_ADMIN_PASSWORD_HASH"), &scratch);
    if cfg.has_admin_password_hash { str_field_set(&cfg.admin_password_hash, &scratch.bytes, scratch.len); };
    cfg.has_admin_session_secret = env_trimmed(STR_PTR("FREE_KEY_ADMIN_SESSION_SECRET"), STR_LEN("FREE_KEY_ADMIN_SESSION_SECRET"), &scratch);
    if cfg.has_admin_session_secret { str_field_set(&cfg.admin_session_secret, &scratch.bytes, scratch.len); };
    // The three web-admin values must appear together.
    let any_admin = cfg.has_admin_username || cfg.has_admin_password_hash || cfg.has_admin_session_secret;
    let all_admin = cfg.has_admin_username && cfg.has_admin_password_hash && cfg.has_admin_session_secret;
    if any_admin && !all_admin {
        buf_append_lit(err, STR_PTR("Web admin requires FREE_KEY_ADMIN_USERNAME, FREE_KEY_ADMIN_PASSWORD_HASH and FREE_KEY_ADMIN_SESSION_SECRET together"), STR_LEN("Web admin requires FREE_KEY_ADMIN_USERNAME, FREE_KEY_ADMIN_PASSWORD_HASH and FREE_KEY_ADMIN_SESSION_SECRET together"));
        return 1;
    };
    if cfg.has_admin_session_secret && cfg.admin_session_secret.len < 24 {
        buf_append_lit(err, STR_PTR("FREE_KEY_ADMIN_SESSION_SECRET must contain at least 24 characters"), STR_LEN("FREE_KEY_ADMIN_SESSION_SECRET must contain at least 24 characters"));
        return 1;
    };
    // host / port / databasePath.
    if env_trimmed(STR_PTR("FREE_KEY_HOST"), STR_LEN("FREE_KEY_HOST"), &scratch) {
        str_field_set(&cfg.host, &scratch.bytes, scratch.len);
    } else {
        str_field_set(&cfg.host, STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"));
    };
    let has_port = env_trimmed(STR_PTR("FREE_KEY_PORT"), STR_LEN("FREE_KEY_PORT"), &scratch);
    let port_f = positive_number(has_port, &scratch.bytes, scratch.len, 43210.0);
    cfg.port = port_f as u64; // Math.floor for positive values
    if env_trimmed(STR_PTR("FREE_KEY_DATABASE"), STR_LEN("FREE_KEY_DATABASE"), &scratch) {
        str_field_set(&cfg.database_path, &scratch.bytes, scratch.len);
    } else {
        str_field_set(&cfg.database_path, STR_PTR("./data/free-keys.sqlite3"), STR_LEN("./data/free-keys.sqlite3"));
    };
    cfg.has_client_secret = env_trimmed(STR_PTR("FREE_KEY_CLIENT_SECRET"), STR_LEN("FREE_KEY_CLIENT_SECRET"), &scratch);
    if cfg.has_client_secret { str_field_set(&cfg.client_secret, &scratch.bytes, scratch.len); };
    let has_dvd = env_trimmed(STR_PTR("FREE_KEY_DEFAULT_VALIDITY_DAYS"), STR_LEN("FREE_KEY_DEFAULT_VALIDITY_DAYS"), &scratch);
    cfg.default_validity_days = positive_number(has_dvd, &scratch.bytes, scratch.len, 1.0);
    let has_rih = env_trimmed(STR_PTR("FREE_KEY_REFRESH_INTERVAL_HOURS"), STR_LEN("FREE_KEY_REFRESH_INTERVAL_HOURS"), &scratch);
    cfg.refresh_interval_hours = positive_number(has_rih, &scratch.bytes, scratch.len, 5.0);
    let has_rtm = env_trimmed(STR_PTR("FREE_KEY_REQUIRED_TTL_MINUTES"), STR_LEN("FREE_KEY_REQUIRED_TTL_MINUTES"), &scratch);
    cfg.required_ttl_minutes = positive_number(has_rtm, &scratch.bytes, scratch.len, 15.0);
    if env_trimmed(STR_PTR("FREE_KEY_DISCORD_INVITE_URL"), STR_LEN("FREE_KEY_DISCORD_INVITE_URL"), &scratch) {
        str_field_set(&cfg.discord_invite_url, &scratch.bytes, scratch.len);
    } else {
        str_field_set(&cfg.discord_invite_url, STR_PTR("https://discord.gg/QCNUx8FaV"), STR_LEN("https://discord.gg/QCNUx8FaV"));
    };
    cfg.has_discord_public_key = env_trimmed(STR_PTR("DISCORD_PUBLIC_KEY"), STR_LEN("DISCORD_PUBLIC_KEY"), &scratch);
    if cfg.has_discord_public_key { str_field_set(&cfg.discord_public_key, &scratch.bytes, scratch.len); };
    cfg.has_discord_channel_id = env_trimmed(STR_PTR("DISCORD_FREE_KEY_CHANNEL_ID"), STR_LEN("DISCORD_FREE_KEY_CHANNEL_ID"), &scratch);
    if cfg.has_discord_channel_id { str_field_set(&cfg.discord_channel_id, &scratch.bytes, scratch.len); };
    return 0;
}
