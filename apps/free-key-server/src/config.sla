// Converted 1:1 from apps/free-key-server/src/config.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "sa_std/env.sai"
@import "sa_std/ptr.sa"
@import "sa_std/string.sa"
@import "sa_std/encoding/json.sai"
@import "sa_std/math.sai"
@import "sa_std/fmt.sai"

// Shared conversion prelude (fix phase): ByteBuf + buf_* helper family.
// The bulk conversion emitted calls to this family in every file of the
// tree but never materialized the definitions; they live here once.
struct ByteBuf {
    bytes: [u8; 40960],
    len: u64,
}

fn buf_reset(b: &ByteBuf) -> void {
    b.len = 0;
}

fn buf_append_lit(b: &ByteBuf, src: ptr, src_len: u64) -> void {
    for i in 0..src_len {
        if b.len < 40960 {
            let v: u8 = 0;
            PTR_BYTE_AT(v, src, i);
            b.bytes[b.len] = v;
            b.len = b.len + 1;
        };
    }
}

fn buf_append_buf(b: &ByteBuf, src: &ByteBuf) -> void {
    for i in 0..src.len {
        if b.len < 40960 {
            b.bytes[b.len] = src.bytes[i];
            b.len = b.len + 1;
        };
    }
}

fn buf_append_byte(b: &ByteBuf, v: u8) -> void {
    if b.len < 40960 {
        b.bytes[b.len] = v;
        b.len = b.len + 1;
    };
}

fn buf_append_escaped(b: &ByteBuf, src: ptr, src_len: u64) -> void {
    for i in 0..src_len {
        let v: u8 = 0;
        PTR_BYTE_AT(v, src, i);
        if v == 34 {
            buf_append_lit(b, STR_PTR("\\\""), STR_LEN("\\\""));
        } else if v == 92 {
            buf_append_lit(b, STR_PTR("\\\\"), STR_LEN("\\\\"));
        } else if v == 10 {
            buf_append_lit(b, STR_PTR("\\n"), STR_LEN("\\n"));
        } else if v == 13 {
            buf_append_lit(b, STR_PTR("\\r"), STR_LEN("\\r"));
        } else if v == 9 {
            buf_append_lit(b, STR_PTR("\\t"), STR_LEN("\\t"));
        } else if v == 8 {
            buf_append_lit(b, STR_PTR("\\b"), STR_LEN("\\b"));
        } else if v == 12 {
            buf_append_lit(b, STR_PTR("\\f"), STR_LEN("\\f"));
        } else if v < 32 {
            buf_append_lit(b, STR_PTR("\\u00"), STR_LEN("\\u00"));
            let hi = (v >> 4) & 15;
            let lo = v & 15;
            let hc: u8 = 0;
            if hi < 10 {
                hc = 48 + hi;
            } else {
                hc = 87 + hi;
            };
            let lc: u8 = 0;
            if lo < 10 {
                lc = 48 + lo;
            } else {
                lc = 87 + lo;
            };
            buf_append_byte(b, hc);
            buf_append_byte(b, lc);
        } else {
            buf_append_byte(b, v);
        };
    }
}

fn buf_append_u64(b: &ByteBuf, v: u64) -> void {
    if v == 0 {
        buf_append_byte(b, 48);
        return;
    };
    let digits: [u8; 20] = [0; 20];
    let n: u64 = 0;
    let x = v;
    while x > 0 {
        digits[n] = (48 + (x % 10)) as u8;
        n = n + 1;
        x = x / 10;
    }
    let i = n;
    while i > 0 {
        i = i - 1;
        buf_append_byte(b, digits[i]);
    }
}

fn buf_append_hex_u64(b: &ByteBuf, v: u64) -> void {
    if v == 0 {
        buf_append_byte(b, 48);
        return;
    };
    let digits: [u8; 16] = [0; 16];
    let n: u64 = 0;
    let x = v;
    while x > 0 {
        let d = (x & 15) as u8;
        if d < 10 {
            digits[n] = 48 + d;
        } else {
            digits[n] = 87 + d;
        };
        n = n + 1;
        x = x >> 4;
    }
    let i = n;
    while i > 0 {
        i = i - 1;
        buf_append_byte(b, digits[i]);
    }
}

fn buf_append_f64(b: &ByteBuf, v: f64) -> void {
    // sa_fmt_f64 fixed-precision handle, then strip trailing zeros/dot
    // (JS Number#toString has no fixed trailing zeros; approximation is
    // recorded in the fix log).
    let h = sa_fmt_f64(v, 6);
    let p: ptr = sa_fmt_buffer_data(h);
    let n = sa_fmt_buffer_len(h);
    let end = n;
    let dot = false;
    for i in 0..n {
        let c: u8 = 0;
        PTR_BYTE_AT(c, p, i);
        if c == 46 { dot = true; };
    }
    if dot {
        while end > 0 {
            let c: u8 = 0;
            PTR_BYTE_AT(c, p, end - 1);
            if c == 48 {
                end = end - 1;
            } else {
                if c == 46 { end = end - 1; };
                break;
            };
        }
    };
    buf_append_lit(b, p, end);
    let fr = sa_fmt_buffer_free(h);
}

fn buf_to_lower(b: &ByteBuf) -> void {
    for i in 0..b.len {
        let c = b.bytes[i];
        if c >= 65 && c <= 90 {
            b.bytes[i] = c + 32;
        };
    }
}

fn buf_to_upper(b: &ByteBuf) -> void {
    for i in 0..b.len {
        let c = b.bytes[i];
        if c >= 97 && c <= 122 {
            b.bytes[i] = c - 32;
        };
    }
}

fn buf_is_ws(c: u8) -> bool {
    return c == 32 || c == 9 || c == 13 || c == 10;
}

fn buf_trim(b: &ByteBuf) -> void {
    let start: u64 = 0;
    while start < b.len && buf_is_ws(b.bytes[start]) {
        start = start + 1;
    }
    let end = b.len;
    while end > start && buf_is_ws(b.bytes[end - 1]) {
        end = end - 1;
    }
    if start > 0 {
        let w: u64 = 0;
        let r = start;
        while r < end {
            b.bytes[w] = b.bytes[r];
            w = w + 1;
            r = r + 1;
        }
    };
    b.len = end - start;
}

fn buf_drop_front(b: &ByteBuf, n: u64) -> void {
    if n >= b.len {
        b.len = 0;
        return;
    };
    let w: u64 = 0;
    let r = n;
    while r < b.len {
        b.bytes[w] = b.bytes[r];
        w = w + 1;
        r = r + 1;
    }
    b.len = b.len - n;
}

fn bytes_eq(p1: ptr, l1: u64, p2: ptr, l2: u64) -> bool {
    if l1 != l2 { return false; };
    for i in 0..l1 {
        let a: u8 = 0;
        PTR_BYTE_AT(a, p1, i);
        let c: u8 = 0;
        PTR_BYTE_AT(c, p2, i);
        if a != c { return false; };
    }
    return true;
}

fn bytes_eq_str(p: ptr, l: u64, lit: ptr, lit_len: u64) -> bool {
    return bytes_eq(p, l, lit, lit_len);
}

fn find_byte(p: ptr, l: u64, v: u8) -> u64 {
    for i in 0..l {
        let c: u8 = 0;
        PTR_BYTE_AT(c, p, i);
        if c == v { return i; };
    }
    return l;
}

fn find_sub_buf(p: ptr, l: u64, np: ptr, nl: u64) -> u64 {
    if nl == 0 { return 0; };
    if nl > l { return l; };
    let last = l - nl;
    let i: u64 = 0;
    while i <= last {
        let ok = true;
        for j in 0..nl {
            let a: u8 = 0;
            PTR_BYTE_AT(a, p, i + j);
            let c: u8 = 0;
            PTR_BYTE_AT(c, np, j);
            if a != c { ok = false; };
        }
        if ok { return i; };
        i = i + 1;
    }
    return l;
}

fn starts_with(p: ptr, l: u64, pp: ptr, pl: u64) -> bool {
    if pl > l { return false; };
    for i in 0..pl {
        let a: u8 = 0;
        PTR_BYTE_AT(a, p, i);
        let c: u8 = 0;
        PTR_BYTE_AT(c, pp, i);
        if a != c { return false; };
    }
    return true;
}

// ts/fmt handle layout: { data ptr @ +0, len u64 @ +8 } (16-byte cell).
fn sa_handle_data(h: ptr) -> ptr {
    let out: ptr = h;
    PTR_READ(out, h);
    return out;
}

fn sa_handle_len(h: ptr) -> u64 {
    let p8: ptr = h;
    PTR_BYTE_ADD(p8, h, 8);
    let v: u64 = 0;
    PTR_READ_U64(v, p8);
    return v;
}

// --- ts_* local SLA implementations -------------------------------------
// @ts_str_*/@ts_math_* in sa_std are SA-layer functions (tsgosa surface);
// they are NOT callable from SLA source (verified by probe: Undefined
// call). The helpers below reproduce the exact semantics used by this
// tree's call sites under the same names.
fn ts_str_equals(ap: ptr, al: u64, bp: ptr, bl: u64) -> i32 {
    if bytes_eq(ap, al, bp, bl) { return 1; };
    return 0;
}

fn ts_math_minmax(a: i32, b: i32, ismax: i32) -> i32 {
    if ismax == 1 {
        if a > b { return a; };
        return b;
    };
    if a < b { return a; };
    return b;
}

fn ts_math_rounding(x: f64, op: i32) -> i32 {
    if op == 0 {
        let f = sa_math_floor(x);
        return f as i32;
    };
    if op == 1 {
        let c = sa_math_ceil(x);
        return c as i32;
    };
    if op == 2 {
        let r = sa_math_floor(x + 0.5);
        return r as i32;
    };
    return x as i32;
}

// --- sa_json_* intent-name adapters (real surface: encoding/json.sai) --
fn sa_json_object_has(node: u64, kp: ptr, kl: u64) -> bool {
    let h: u64 = 0;
    let st = sa_json_object_get(node, kp, kl, &h);
    return st == 0;
}

fn sa_json_number_value(node: u64) -> f64 {
    let v: f64 = 0.0;
    let st = sa_json_as_f64(node, &v);
    return v;
}

fn sa_json_bool_value(node: u64) -> bool {
    let v: bool = false;
    let st = sa_json_as_bool(node, &v);
    return v;
}

fn sa_json_object_len(node: u64) -> u64 {
    let c: u64 = 0;
    let st = sa_json_value_count(node, &c);
    return c;
}

fn sa_json_object_get_number(node: u64, kp: ptr, kl: u64) -> f64 {
    let v: f64 = 0.0;
    let st = sa_json_object_get_f64(node, kp, kl, &v);
    return v;
}

// TS: import { resolve } from "node:path";
// DEFECT: node:path resolve() (cwd-joined absolute path) has no sa_std
// counterpart here; databasePath is kept as the raw env value in this pass.
// DEFECT: TS throw new Error(...) -> load_config returns an i32 status and
// writes the message into err (0 = ok, 1 = validation failure).
// DEFECT: process.env / NodeJS.ProcessEnv parameter — env is read through
// sa_env_get directly; the injectable env parameter is dropped.
// DEFECT: string | null fields use an explicit has_* flag; strings are
// fixed-capacity fields (512 bytes) holding the trimmed env value.

struct StrField {
    bytes: [u8; 512],
    len: u64,
}

fn str_field_set(f: &StrField, src_ptr: ptr, src_len: u64) -> void {
    f.len = 0;
    for i in 0..src_len {
        if f.len < 512 {
            let b: u8 = 0;
            PTR_BYTE_AT(b, src_ptr, i);
            f.bytes[f.len] = b;
            f.len = f.len + 1;
        };
    }
}

// Reads env key into scratch (trimmed). Returns false when unset/empty.
// JS .trim() approximated: strips ASCII space/tab/CR/LF at both ends.
fn env_trimmed(key_ptr: ptr, key_len: u64, scratch: &ByteBuf) -> bool {
    buf_reset(scratch);
    let h = sa_env_get(key_ptr, key_len);
    if h == 0 { return false; };
    let vp: ptr = sa_env_buffer_data(h);
    let vl = sa_env_buffer_len(h);
    let start: u64 = 0;
    let end = vl;
    while start < end {
        let b: u8 = 0;
        PTR_BYTE_AT(b, vp, start);
        if b == 32 || b == 9 || b == 13 || b == 10 { start = start + 1; } else { break; };
    }
    while end > start {
        let b: u8 = 0;
        PTR_BYTE_AT(b, vp, end - 1);
        if b == 32 || b == 9 || b == 13 || b == 10 { end = end - 1; } else { break; };
    }
    if end <= start { return false; };
    for i in start..end {
        let b: u8 = 0;
        PTR_BYTE_AT(b, vp, i);
        buf_append_byte(scratch, b);
    }
    return scratch.len > 0;
}

// TS: function positiveNumber(value: string | undefined, fallback: number): number
// DEFECT: Number() full JS semantics (exponents, hex, Infinity) approximated
// by a decimal parser; NaN/unparseable or <= 0 -> fallback.
fn positive_number(has_value: bool, vp: ptr, vl: u64, fallback: f64) -> f64 {
    if !has_value { return fallback; };
    let result: f64 = 0.0;
    let frac_scale: f64 = 0.0;
    let seen_digit = false;
    let seen_dot = false;
    for i in 0..vl {
        let b: u8 = 0;
        PTR_BYTE_AT(b, vp, i);
        if b >= 48 && b <= 57 {
            seen_digit = true;
            let d = (b - 48) as f64;
            if seen_dot {
                frac_scale = frac_scale / 10.0;
                result = result + d * frac_scale;
            } else {
                result = result * 10.0 + d;
            };
        } else if b == 46 && !seen_dot {
            seen_dot = true;
            frac_scale = 1.0;
        } else {
            return fallback;
        };
    }
    if !seen_digit { return fallback; };
    if result > 0.0 { return result; };
    return fallback;
}

// TS: export type FreeKeyServerConfig = { ... } (field order preserved).
struct FreeKeyServerConfig {
    host: StrField,
    port: u64,
    database_path: StrField,
    hash_pepper: StrField,
    has_client_secret: bool,
    client_secret: StrField,
    admin_secret: StrField,
    has_admin_username: bool,
    admin_username: StrField,
    has_admin_password_hash: bool,
    admin_password_hash: StrField,
    has_admin_session_secret: bool,
    admin_session_secret: StrField,
    default_validity_days: f64,
    refresh_interval_hours: f64,
    required_ttl_minutes: f64,
    discord_invite_url: StrField,
    has_discord_public_key: bool,
    discord_public_key: StrField,
    has_discord_channel_id: bool,
    discord_channel_id: StrField,
}

// TS: export function loadConfig(env = process.env): FreeKeyServerConfig
fn load_config(cfg: &FreeKeyServerConfig, err: &ByteBuf) -> i32 {
    let scratch = ByteBuf { bytes: [0u8; 40960], len: 0 };
    buf_reset(err);
    // hashPepper / adminSecret are required with minimum lengths.
    if !env_trimmed(STR_PTR("FREE_KEY_HASH_PEPPER"), STR_LEN("FREE_KEY_HASH_PEPPER"), &scratch) || scratch.len < 24 {
        buf_append_lit(err, STR_PTR("FREE_KEY_HASH_PEPPER must contain at least 24 characters"), STR_LEN("FREE_KEY_HASH_PEPPER must contain at least 24 characters"));
        return 1;
    };
    let __ap_scr1: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap_scr1, scratch.bytes, 0);
    str_field_set(&cfg.hash_pepper, __ap_scr1, scratch.len);
    if !env_trimmed(STR_PTR("FREE_KEY_ADMIN_SECRET"), STR_LEN("FREE_KEY_ADMIN_SECRET"), &scratch) || scratch.len < 16 {
        buf_append_lit(err, STR_PTR("FREE_KEY_ADMIN_SECRET must contain at least 16 characters"), STR_LEN("FREE_KEY_ADMIN_SECRET must contain at least 16 characters"));
        return 1;
    };
    let __ap_scr2: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap_scr2, scratch.bytes, 0);
    str_field_set(&cfg.admin_secret, __ap_scr2, scratch.len);
    cfg.has_admin_username = env_trimmed(STR_PTR("FREE_KEY_ADMIN_USERNAME"), STR_LEN("FREE_KEY_ADMIN_USERNAME"), &scratch);
    let __ap_scr3: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap_scr3, scratch.bytes, 0);
    if cfg.has_admin_username { str_field_set(&cfg.admin_username, __ap_scr3, scratch.len); };
    cfg.has_admin_password_hash = env_trimmed(STR_PTR("FREE_KEY_ADMIN_PASSWORD_HASH"), STR_LEN("FREE_KEY_ADMIN_PASSWORD_HASH"), &scratch);
    let __ap_scr4: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap_scr4, scratch.bytes, 0);
    if cfg.has_admin_password_hash { str_field_set(&cfg.admin_password_hash, __ap_scr4, scratch.len); };
    cfg.has_admin_session_secret = env_trimmed(STR_PTR("FREE_KEY_ADMIN_SESSION_SECRET"), STR_LEN("FREE_KEY_ADMIN_SESSION_SECRET"), &scratch);
    let __ap_scr5: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap_scr5, scratch.bytes, 0);
    if cfg.has_admin_session_secret { str_field_set(&cfg.admin_session_secret, __ap_scr5, scratch.len); };
    // The three web-admin values must appear together.
    let any_admin = cfg.has_admin_username || cfg.has_admin_password_hash || cfg.has_admin_session_secret;
    let all_admin = cfg.has_admin_username && cfg.has_admin_password_hash && cfg.has_admin_session_secret;
    if any_admin && !all_admin {
        buf_append_lit(err, STR_PTR("Web admin requires FREE_KEY_ADMIN_USERNAME, FREE_KEY_ADMIN_PASSWORD_HASH and FREE_KEY_ADMIN_SESSION_SECRET together"), STR_LEN("Web admin requires FREE_KEY_ADMIN_USERNAME, FREE_KEY_ADMIN_PASSWORD_HASH and FREE_KEY_ADMIN_SESSION_SECRET together"));
        return 1;
    };
    if cfg.has_admin_session_secret && cfg.admin_session_secret.len < 24 {
        buf_append_lit(err, STR_PTR("FREE_KEY_ADMIN_SESSION_SECRET must contain at least 24 characters"), STR_LEN("FREE_KEY_ADMIN_SESSION_SECRET must contain at least 24 characters"));
        return 1;
    };
    // host / port / databasePath.
    if env_trimmed(STR_PTR("FREE_KEY_HOST"), STR_LEN("FREE_KEY_HOST"), &scratch) {
        let __ap_scr6: ptr = PTR_NULL();
        PTR_BYTE_ADD(__ap_scr6, scratch.bytes, 0);
        str_field_set(&cfg.host, __ap_scr6, scratch.len);
    } else {
        str_field_set(&cfg.host, STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"));
    };
    let has_port = env_trimmed(STR_PTR("FREE_KEY_PORT"), STR_LEN("FREE_KEY_PORT"), &scratch);
    let __ap_scr12: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap_scr12, scratch.bytes, 0);
    let port_f = positive_number(has_port, __ap_scr12, scratch.len, 43210.0);
    cfg.port = port_f as u64; // Math.floor for positive values
    if env_trimmed(STR_PTR("FREE_KEY_DATABASE"), STR_LEN("FREE_KEY_DATABASE"), &scratch) {
        let __ap_scr7: ptr = PTR_NULL();
        PTR_BYTE_ADD(__ap_scr7, scratch.bytes, 0);
        str_field_set(&cfg.database_path, __ap_scr7, scratch.len);
    } else {
        str_field_set(&cfg.database_path, STR_PTR("./data/free-keys.sqlite3"), STR_LEN("./data/free-keys.sqlite3"));
    };
    cfg.has_client_secret = env_trimmed(STR_PTR("FREE_KEY_CLIENT_SECRET"), STR_LEN("FREE_KEY_CLIENT_SECRET"), &scratch);
    let __ap_scr8: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap_scr8, scratch.bytes, 0);
    if cfg.has_client_secret { str_field_set(&cfg.client_secret, __ap_scr8, scratch.len); };
    let has_dvd = env_trimmed(STR_PTR("FREE_KEY_DEFAULT_VALIDITY_DAYS"), STR_LEN("FREE_KEY_DEFAULT_VALIDITY_DAYS"), &scratch);
    let __ap_scr13: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap_scr13, scratch.bytes, 0);
    cfg.default_validity_days = positive_number(has_dvd, __ap_scr13, scratch.len, 1.0);
    let has_rih = env_trimmed(STR_PTR("FREE_KEY_REFRESH_INTERVAL_HOURS"), STR_LEN("FREE_KEY_REFRESH_INTERVAL_HOURS"), &scratch);
    let __ap_scr14: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap_scr14, scratch.bytes, 0);
    cfg.refresh_interval_hours = positive_number(has_rih, __ap_scr14, scratch.len, 5.0);
    let has_rtm = env_trimmed(STR_PTR("FREE_KEY_REQUIRED_TTL_MINUTES"), STR_LEN("FREE_KEY_REQUIRED_TTL_MINUTES"), &scratch);
    let __ap_scr15: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap_scr15, scratch.bytes, 0);
    cfg.required_ttl_minutes = positive_number(has_rtm, __ap_scr15, scratch.len, 15.0);
    if env_trimmed(STR_PTR("FREE_KEY_DISCORD_INVITE_URL"), STR_LEN("FREE_KEY_DISCORD_INVITE_URL"), &scratch) {
        let __ap_scr9: ptr = PTR_NULL();
        PTR_BYTE_ADD(__ap_scr9, scratch.bytes, 0);
        str_field_set(&cfg.discord_invite_url, __ap_scr9, scratch.len);
    } else {
        str_field_set(&cfg.discord_invite_url, STR_PTR("https://discord.gg/QCNUx8FaV"), STR_LEN("https://discord.gg/QCNUx8FaV"));
    };
    cfg.has_discord_public_key = env_trimmed(STR_PTR("DISCORD_PUBLIC_KEY"), STR_LEN("DISCORD_PUBLIC_KEY"), &scratch);
    let __ap_scr10: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap_scr10, scratch.bytes, 0);
    if cfg.has_discord_public_key { str_field_set(&cfg.discord_public_key, __ap_scr10, scratch.len); };
    cfg.has_discord_channel_id = env_trimmed(STR_PTR("DISCORD_FREE_KEY_CHANNEL_ID"), STR_LEN("DISCORD_FREE_KEY_CHANNEL_ID"), &scratch);
    let __ap_scr11: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap_scr11, scratch.bytes, 0);
    if cfg.has_discord_channel_id { str_field_set(&cfg.discord_channel_id, __ap_scr11, scratch.len); };
    return 0;
}

fn bytes_eq3(a: ptr, b: ptr, l: u64) -> bool {
    return bytes_eq(a, l, b, l);
}
