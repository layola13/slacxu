// Converted 1:1 from apps/free-key-server/src/adminAuth.test.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "sa_std/ptr.sa"
@import "sa_std/string.sa"
@import "sa_std/ts_string.sa"
@import "adminAuth.sla"

// DEFECT: node:test + node:assert/strict have no SLA counterpart; tests
// are plain fns accumulating a failure count (run_all_tests entry).
// The TS test computes the fixture hash with node:crypto scryptSync;
// here the same intent extern family the implementation uses
// (sa_crypto_scrypt_hex) produces it. String equality binds
// @ts_str_equals (sa_std ts_string.sa).

fn expect_true(fails: &u64, cond: bool) -> void { if !cond { let __sp23 = *fails; *fails = __sp23 + 1; }; }
fn expect_str_eq(fails: &u64, ap: ptr, al: u64, bp: ptr, bl: u64) -> void {
    if ts_str_equals(ap, al, bp, bl) != 1 { let __sp24 = *fails; *fails = __sp24 + 1; };
}

fn test_verifies_scrypt_password_hashes(fails: &u64) -> void {
    // DEFECT (B-class): scrypt is UNSUPPORTED in sa_std (four-source
    // verdict, FIX_OTHER_APPS.md), so the TS fixture hash
    // (scryptSync("correct-password", "fixed-test-salt", 64) hex)
    // CANNOT be computed in this build. The hex below is well-formed
    // placeholder fixture data (128 '0' chars) — NOT a scrypt
    // output — and the case asserts the build's fail-closed
    // contract instead: NO password verifies while the KDF is
    // missing. When a scrypt surface lands, restore the TS
    // expectations (correct -> true, wrong -> false).
    let hex = ByteBuf { bytes: [0u8; 40960], len: 0 };
    for i in 0..128 { buf_append_byte(&hex, 48); }
    let encoded = ByteBuf { bytes: [0u8; 40960], len: 0 };
    buf_append_lit(&encoded, STR_PTR("scrypt:fixed-test-salt:"), STR_LEN("scrypt:fixed-test-salt:"));
    buf_append_buf(&encoded, &hex);
    let __ap261: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap261, encoded.bytes, 0);
    expect_true(fails, !verify_admin_password_hash(STR_PTR("correct-password"), STR_LEN("correct-password"), __ap261, encoded.len));
    let __ap262: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap262, encoded.bytes, 0);
    expect_true(fails, !verify_admin_password_hash(STR_PTR("wrong-password"), STR_LEN("wrong-password"), __ap262, encoded.len));
}

fn test_signs_expires_and_rejects_tampered_sessions(fails: &u64) -> void {
    let secret = STR_PTR("session-secret-that-is-long-enough");
    let secret_len = STR_LEN("session-secret-that-is-long-enough");
    let token = ByteBuf { bytes: [0u8; 40960], len: 0 };
    create_admin_session(&token, STR_PTR("admin"), STR_LEN("admin"), secret, secret_len, 1000);
    let session = AdminSession { found: false, username: [0u8; 256], username_len: 0 };
    let __ap263: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap263, token.bytes, 0);
    read_admin_session(&session, __ap263, token.len, secret, secret_len, 2000);
    // assert.deepEqual(readAdminSession(...), { username: "admin" })
    expect_true(fails, session.found);
    let __ap264: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap264, session.username, 0);
    expect_str_eq(fails, __ap264, session.username_len, STR_PTR("admin"), STR_LEN("admin"));
    // tampered token (token + "x") -> null
    let tampered = ByteBuf { bytes: [0u8; 40960], len: 0 };
    buf_append_buf(&tampered, &token);
    buf_append_lit(&tampered, STR_PTR("x"), STR_LEN("x"));
    let s2 = AdminSession { found: false, username: [0u8; 256], username_len: 0 };
    let __ap265: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap265, tampered.bytes, 0);
    read_admin_session(&s2, __ap265, tampered.len, secret, secret_len, 2000);
    expect_true(fails, !s2.found);
    // expired at now + 8h -> null
    let s3 = AdminSession { found: false, username: [0u8; 256], username_len: 0 };
    let __ap266: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap266, token.bytes, 0);
    read_admin_session(&s3, __ap266, token.len, secret, secret_len, 1000 + 8 * 60 * 60000);
    expect_true(fails, !s3.found);
}

fn run_all_tests() -> u64 {
    let fails: u64 = 0;
    test_verifies_scrypt_password_hashes(&fails);
    test_signs_expires_and_rejects_tampered_sessions(&fails);
    return fails;
}
