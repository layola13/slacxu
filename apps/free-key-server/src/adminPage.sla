// Converted 1:1 from apps/free-key-server/src/adminPage.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
// TS: export function adminPageHtml(): string — returns one big template
// literal (the admin console page). The HTML is reproduced verbatim
// below, one buf_append_lit per source line.

fn admin_page_html(out: &ByteBuf) -> void {
    buf_reset(out);
    buf_append_lit(out, STR_PTR("<!doctype html>\n"), STR_LEN("<!doctype html>\n"));
    buf_append_lit(out, STR_PTR("<html lang=\"zh-CN\">\n"), STR_LEN("<html lang=\"zh-CN\">\n"));
    buf_append_lit(out, STR_PTR("<head>\n"), STR_LEN("<head>\n"));
    buf_append_lit(out, STR_PTR("  <meta charset=\"utf-8\">\n"), STR_LEN("  <meta charset=\"utf-8\">\n"));
    buf_append_lit(out, STR_PTR("  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n"), STR_LEN("  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n"));
    buf_append_lit(out, STR_PTR("  <title>Codex Ultra 密钥管理</title>\n"), STR_LEN("  <title>Codex Ultra 密钥管理</title>\n"));
    buf_append_lit(out, STR_PTR("  <style>\n"), STR_LEN("  <style>\n"));
    buf_append_lit(out, STR_PTR("    body{font-family:system-ui,sans-serif;max-width:1160px;margin:30px auto;padding:0 16px;color:#172033;background:#f7f9fc}\n"), STR_LEN("    body{font-family:system-ui,sans-serif;max-width:1160px;margin:30px auto;padding:0 16px;color:#172033;background:#f7f9fc}\n"));
    buf_append_lit(out, STR_PTR("    h1{font-size:25px}h2{font-size:18px}.panel{background:#fff;border:1px solid #dbe1ea;padding:16px;margin:14px 0;border-radius:8px}\n"), STR_LEN("    h1{font-size:25px}h2{font-size:18px}.panel{background:#fff;border:1px solid #dbe1ea;padding:16px;margin:14px 0;border-radius:8px}\n"));
    buf_append_lit(out, STR_PTR("    .row{display:flex;gap:8px;flex-wrap:wrap;align-items:center}.field{display:flex;flex-direction:column;gap:4px;margin:5px 0}\n"), STR_LEN("    .row{display:flex;gap:8px;flex-wrap:wrap;align-items:center}.field{display:flex;flex-direction:column;gap:4px;margin:5px 0}\n"));
    buf_append_lit(out, STR_PTR("    input,button,textarea{padding:9px;border:1px solid #bbc4d4;border-radius:6px;font:inherit}input{min-width:170px}textarea{width:min(100%,720px);min-height:72px}\n"), STR_LEN("    input,button,textarea{padding:9px;border:1px solid #bbc4d4;border-radius:6px;font:inherit}input{min-width:170px}textarea{width:min(100%,720px);min-height:72px}\n"));
    buf_append_lit(out, STR_PTR("    button{cursor:pointer;background:#165dff;color:#fff;border:0}.secondary{background:#606b7d}.danger{background:#b42318}.hidden{display:none}.error{color:#b42318}\n"), STR_LEN("    button{cursor:pointer;background:#165dff;color:#fff;border:0}.secondary{background:#606b7d}.danger{background:#b42318}.hidden{display:none}.error{color:#b42318}\n"));
    buf_append_lit(out, STR_PTR("    .captcha{display:flex;gap:8px;align-items:center;margin-top:10px}.captcha img{width:210px;height:58px;border:1px solid #bbc4d4;border-radius:6px;background:#eef2f7;cursor:pointer}\n"), STR_LEN("    .captcha{display:flex;gap:8px;align-items:center;margin-top:10px}.captcha img{width:210px;height:58px;border:1px solid #bbc4d4;border-radius:6px;background:#eef2f7;cursor:pointer}\n"));
    buf_append_lit(out, STR_PTR("    table{width:100%;border-collapse:collapse;margin-top:10px}td,th{padding:8px;border-bottom:1px solid #e4e8ef;text-align:left;font-size:13px}.hash{font-family:ui-monospace,monospace}\n"), STR_LEN("    table{width:100%;border-collapse:collapse;margin-top:10px}td,th{padding:8px;border-bottom:1px solid #e4e8ef;text-align:left;font-size:13px}.hash{font-family:ui-monospace,monospace}\n"));
    buf_append_lit(out, STR_PTR("    @media(max-width:700px){table{display:block;overflow:auto}.row>*{flex:1 1 100%}}\n"), STR_LEN("    @media(max-width:700px){table{display:block;overflow:auto}.row>*{flex:1 1 100%}}\n"));
    buf_append_lit(out, STR_PTR("  </style>\n"), STR_LEN("  </style>\n"));
    buf_append_lit(out, STR_PTR("</head>\n"), STR_LEN("</head>\n"));
    buf_append_lit(out, STR_PTR("<body>\n"), STR_LEN("<body>\n"));
    buf_append_lit(out, STR_PTR("  <h1>Codex Ultra 密钥管理</h1>\n"), STR_LEN("  <h1>Codex Ultra 密钥管理</h1>\n"));
    buf_append_lit(out, STR_PTR("  <section id=\"login\" class=\"panel\">\n"), STR_LEN("  <section id=\"login\" class=\"panel\">\n"));
    buf_append_lit(out, STR_PTR("    <h2>管理员登录</h2>\n"), STR_LEN("    <h2>管理员登录</h2>\n"));
    buf_append_lit(out, STR_PTR("    <div class=\"row\"><input id=\"user\" autocomplete=\"username\" placeholder=\"用户名\"><input id=\"pass\" type=\"password\" autocomplete=\"current-password\" placeholder=\"密码\"><input id=\"totp\" inputmode=\"numeric\" autocomplete=\"one-time-code\" maxlength=\"6\" placeholder=\"Google 动态码（首次留空）\"></div>\n"), STR_LEN("    <div class=\"row\"><input id=\"user\" autocomplete=\"username\" placeholder=\"用户名\"><input id=\"pass\" type=\"password\" autocomplete=\"current-password\" placeholder=\"密码\"><input id=\"totp\" inputmode=\"numeric\" autocomplete=\"one-time-code\" maxlength=\"6\" placeholder=\"Google 动态码（首次留空）\"></div>\n"));
    buf_append_lit(out, STR_PTR("    <div class=\"captcha\"><img id=\"captchaImage\" alt=\"验证码，点击刷新\" title=\"点击刷新\"><input id=\"captchaAnswer\" autocomplete=\"off\" maxlength=\"5\" placeholder=\"输入图中 5 位字符\"><button id=\"loginButton\">登录</button></div>\n"), STR_LEN("    <div class=\"captcha\"><img id=\"captchaImage\" alt=\"验证码，点击刷新\" title=\"点击刷新\"><input id=\"captchaAnswer\" autocomplete=\"off\" maxlength=\"5\" placeholder=\"输入图中 5 位字符\"><button id=\"loginButton\">登录</button></div>\n"));
    buf_append_lit(out, STR_PTR("    <p id=\"loginError\" class=\"error\"></p>\n"), STR_LEN("    <p id=\"loginError\" class=\"error\"></p>\n"));
    buf_append_lit(out, STR_PTR("  </section>\n"), STR_LEN("  </section>\n"));
    buf_append_lit(out, STR_PTR("  <section id=\"totpSetup\" class=\"panel hidden\">\n"), STR_LEN("  <section id=\"totpSetup\" class=\"panel hidden\">\n"));
    buf_append_lit(out, STR_PTR("    <h2>首次绑定 Google Authenticator</h2>\n"), STR_LEN("    <h2>首次绑定 Google Authenticator</h2>\n"));
    buf_append_lit(out, STR_PTR("    <p>使用 Google Authenticator、Microsoft Authenticator 或其他 TOTP 应用扫描二维码。扫描后输入当前 6 位动态码完成绑定。</p>\n"), STR_LEN("    <p>使用 Google Authenticator、Microsoft Authenticator 或其他 TOTP 应用扫描二维码。扫描后输入当前 6 位动态码完成绑定。</p>\n"));
    buf_append_lit(out, STR_PTR("    <img id=\"totpQr\" width=\"240\" height=\"240\" alt=\"Google Authenticator 二维码\">\n"), STR_LEN("    <img id=\"totpQr\" width=\"240\" height=\"240\" alt=\"Google Authenticator 二维码\">\n"));
    buf_append_lit(out, STR_PTR("    <p>无法扫码时手工输入密钥：<code id=\"totpSecret\"></code></p>\n"), STR_LEN("    <p>无法扫码时手工输入密钥：<code id=\"totpSecret\"></code></p>\n"));
    buf_append_lit(out, STR_PTR("    <div class=\"row\"><input id=\"totpConfirm\" inputmode=\"numeric\" autocomplete=\"one-time-code\" maxlength=\"6\" placeholder=\"6 位动态码\"><button id=\"totpConfirmButton\">确认绑定并登录</button><button id=\"totpCancelButton\" class=\"secondary\">返回</button></div>\n"), STR_LEN("    <div class=\"row\"><input id=\"totpConfirm\" inputmode=\"numeric\" autocomplete=\"one-time-code\" maxlength=\"6\" placeholder=\"6 位动态码\"><button id=\"totpConfirmButton\">确认绑定并登录</button><button id=\"totpCancelButton\" class=\"secondary\">返回</button></div>\n"));
    buf_append_lit(out, STR_PTR("    <p id=\"totpError\" class=\"error\"></p>\n"), STR_LEN("    <p id=\"totpError\" class=\"error\"></p>\n"));
    buf_append_lit(out, STR_PTR("  </section>\n"), STR_LEN("  </section>\n"));
    buf_append_lit(out, STR_PTR("  <main id=\"app\" class=\"hidden\">\n"), STR_LEN("  <main id=\"app\" class=\"hidden\">\n"));
    buf_append_lit(out, STR_PTR("    <button id=\"logoutButton\" class=\"secondary\">退出</button>\n"), STR_LEN("    <button id=\"logoutButton\" class=\"secondary\">退出</button>\n"));
    buf_append_lit(out, STR_PTR("    <section class=\"panel\">\n"), STR_LEN("    <section class=\"panel\">\n"));
    buf_append_lit(out, STR_PTR("      <h2>系统设置与广告</h2>\n"), STR_LEN("      <h2>系统设置与广告</h2>\n"));
    buf_append_lit(out, STR_PTR("      <div class=\"row\">\n"), STR_LEN("      <div class=\"row\">\n"));
    buf_append_lit(out, STR_PTR("        <label class=\"field\">默认有效天数<input id=\"days\" type=\"number\" min=\"0.01\" step=\"0.01\"></label>\n"), STR_LEN("        <label class=\"field\">默认有效天数<input id=\"days\" type=\"number\" min=\"0.01\" step=\"0.01\"></label>\n"));
    buf_append_lit(out, STR_PTR("        <label class=\"field\">强制刷新周期（小时）<input id=\"hours\" type=\"number\" min=\"0.1\" step=\"0.1\"></label>\n"), STR_LEN("        <label class=\"field\">强制刷新周期（小时）<input id=\"hours\" type=\"number\" min=\"0.1\" step=\"0.1\"></label>\n"));
    buf_append_lit(out, STR_PTR("        <label class=\"field\">required 有效分钟<input id=\"ttl\" type=\"number\" min=\"1\"></label>\n"), STR_LEN("        <label class=\"field\">required 有效分钟<input id=\"ttl\" type=\"number\" min=\"1\"></label>\n"));
    buf_append_lit(out, STR_PTR("      </div>\n"), STR_LEN("      </div>\n"));
    buf_append_lit(out, STR_PTR("      <label class=\"field\">Discord 邀请 URL<input id=\"invite\" type=\"url\"></label>\n"), STR_LEN("      <label class=\"field\">Discord 邀请 URL<input id=\"invite\" type=\"url\"></label>\n"));
    buf_append_lit(out, STR_PTR("      <div class=\"row\"><input id=\"campaignTitle\" placeholder=\"广告标题\"><input id=\"campaignUrl\" type=\"url\" placeholder=\"广告跳转 URL\"><input id=\"campaignImage\" type=\"url\" placeholder=\"广告图片 URL\"></div>\n"), STR_LEN("      <div class=\"row\"><input id=\"campaignTitle\" placeholder=\"广告标题\"><input id=\"campaignUrl\" type=\"url\" placeholder=\"广告跳转 URL\"><input id=\"campaignImage\" type=\"url\" placeholder=\"广告图片 URL\"></div>\n"));
    buf_append_lit(out, STR_PTR("      <label class=\"field\">广告内容<textarea id=\"campaignMessage\"></textarea></label>\n"), STR_LEN("      <label class=\"field\">广告内容<textarea id=\"campaignMessage\"></textarea></label>\n"));
    buf_append_lit(out, STR_PTR("      <div class=\"row\"><button id=\"saveSettingsButton\">保存设置</button><button id=\"clearCampaignButton\" class=\"secondary\">关闭广告</button></div>\n"), STR_LEN("      <div class=\"row\"><button id=\"saveSettingsButton\">保存设置</button><button id=\"clearCampaignButton\" class=\"secondary\">关闭广告</button></div>\n"));
    buf_append_lit(out, STR_PTR("    </section>\n"), STR_LEN("    </section>\n"));
    buf_append_lit(out, STR_PTR("    <section class=\"panel\">\n"), STR_LEN("    <section class=\"panel\">\n"));
    buf_append_lit(out, STR_PTR("      <h2>手工签发</h2>\n"), STR_LEN("      <h2>手工签发</h2>\n"));
    buf_append_lit(out, STR_PTR("      <div class=\"row\"><input id=\"machine\" size=\"68\" placeholder=\"64 位机器哈希\"><input id=\"discord\" placeholder=\"Discord 用户 ID\"><input id=\"validity\" type=\"number\" min=\"0.01\" step=\"0.01\" value=\"1\"><button id=\"issueButton\">签发密钥</button></div>\n"), STR_LEN("      <div class=\"row\"><input id=\"machine\" size=\"68\" placeholder=\"64 位机器哈希\"><input id=\"discord\" placeholder=\"Discord 用户 ID\"><input id=\"validity\" type=\"number\" min=\"0.01\" step=\"0.01\" value=\"1\"><button id=\"issueButton\">签发密钥</button></div>\n"));
    buf_append_lit(out, STR_PTR("      <pre id=\"issued\"></pre>\n"), STR_LEN("      <pre id=\"issued\"></pre>\n"));
    buf_append_lit(out, STR_PTR("    </section>\n"), STR_LEN("    </section>\n"));
    buf_append_lit(out, STR_PTR("    <section class=\"panel\">\n"), STR_LEN("    <section class=\"panel\">\n"));
    buf_append_lit(out, STR_PTR("      <h2>密钥列表</h2>\n"), STR_LEN("      <h2>密钥列表</h2>\n"));
    buf_append_lit(out, STR_PTR("      <div class=\"row\"><input id=\"query\" placeholder=\"机器码、Discord 用户或 key preview\"><button id=\"searchButton\">查询</button></div>\n"), STR_LEN("      <div class=\"row\"><input id=\"query\" placeholder=\"机器码、Discord 用户或 key preview\"><button id=\"searchButton\">查询</button></div>\n"));
    buf_append_lit(out, STR_PTR("      <div id=\"rows\"></div>\n"), STR_LEN("      <div id=\"rows\"></div>\n"));
    buf_append_lit(out, STR_PTR("    </section>\n"), STR_LEN("    </section>\n"));
    buf_append_lit(out, STR_PTR("  </main>\n"), STR_LEN("  </main>\n"));
    buf_append_lit(out, STR_PTR("  <script>\n"), STR_LEN("  <script>\n"));
    buf_append_lit(out, STR_PTR("    const byId = (id) => document.getElementById(id);\n"), STR_LEN("    const byId = (id) => document.getElementById(id);\n"));
    buf_append_lit(out, STR_PTR("    let captchaId = '';\n"), STR_LEN("    let captchaId = '';\n"));
    buf_append_lit(out, STR_PTR("    let enrollmentId = '';\n"), STR_LEN("    let enrollmentId = '';\n"));
    buf_append_lit(out, STR_PTR("    const escapeHtml = (value) => String(value ?? '').replace(/[&<>\"']/g, (character) => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[character]));\n"), STR_LEN("    const escapeHtml = (value) => String(value ?? '').replace(/[&<>\"']/g, (character) => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[character]));\n"));
    buf_append_lit(out, STR_PTR("    async function api(path, options = {}) {\n"), STR_LEN("    async function api(path, options = {}) {\n"));
    buf_append_lit(out, STR_PTR("      const response = await fetch(path, {...options, headers: {'Content-Type':'application/json', ...(options.headers || {})}});\n"), STR_LEN("      const response = await fetch(path, {...options, headers: {'Content-Type':'application/json', ...(options.headers || {})}});\n"));
    buf_append_lit(out, STR_PTR("      const body = await response.json();\n"), STR_LEN("      const body = await response.json();\n"));
    buf_append_lit(out, STR_PTR("      if (!response.ok) throw new Error(body.error || String(response.status));\n"), STR_LEN("      if (!response.ok) throw new Error(body.error || String(response.status));\n"));
    buf_append_lit(out, STR_PTR("      return body.data;\n"), STR_LEN("      return body.data;\n"));
    buf_append_lit(out, STR_PTR("    }\n"), STR_LEN("    }\n"));
    buf_append_lit(out, STR_PTR("    async function login() {\n"), STR_LEN("    async function login() {\n"));
    buf_append_lit(out, STR_PTR("      try {\n"), STR_LEN("      try {\n"));
    buf_append_lit(out, STR_PTR("        const result = await api('/v1/admin/login', {method:'POST', body:JSON.stringify({username:byId('user').value, password:byId('pass').value, totp:byId('totp').value, captchaId, captchaAnswer:byId('captchaAnswer').value})});\n"), STR_LEN("        const result = await api('/v1/admin/login', {method:'POST', body:JSON.stringify({username:byId('user').value, password:byId('pass').value, totp:byId('totp').value, captchaId, captchaAnswer:byId('captchaAnswer').value})});\n"));
    buf_append_lit(out, STR_PTR("        if (result.requiresTotpSetup) {\n"), STR_LEN("        if (result.requiresTotpSetup) {\n"));
    buf_append_lit(out, STR_PTR("          enrollmentId = result.enrollmentId; byId('totpQr').src = result.qrDataUrl; byId('totpSecret').textContent = result.secret;\n"), STR_LEN("          enrollmentId = result.enrollmentId; byId('totpQr').src = result.qrDataUrl; byId('totpSecret').textContent = result.secret;\n"));
    buf_append_lit(out, STR_PTR("          byId('login').classList.add('hidden'); byId('totpSetup').classList.remove('hidden'); byId('totpConfirm').focus(); return;\n"), STR_LEN("          byId('login').classList.add('hidden'); byId('totpSetup').classList.remove('hidden'); byId('totpConfirm').focus(); return;\n"));
    buf_append_lit(out, STR_PTR("        }\n"), STR_LEN("        }\n"));
    buf_append_lit(out, STR_PTR("        byId('login').classList.add('hidden'); byId('app').classList.remove('hidden'); await load();\n"), STR_LEN("        byId('login').classList.add('hidden'); byId('app').classList.remove('hidden'); await load();\n"));
    buf_append_lit(out, STR_PTR("      } catch (error) { byId('loginError').textContent = error.message; await loadCaptcha(); }\n"), STR_LEN("      } catch (error) { byId('loginError').textContent = error.message; await loadCaptcha(); }\n"));
    buf_append_lit(out, STR_PTR("    }\n"), STR_LEN("    }\n"));
    buf_append_lit(out, STR_PTR("    async function loadCaptcha() {\n"), STR_LEN("    async function loadCaptcha() {\n"));
    buf_append_lit(out, STR_PTR("      try {\n"), STR_LEN("      try {\n"));
    buf_append_lit(out, STR_PTR("        const challenge = await api('/v1/admin/captcha'); captchaId = challenge.captchaId;\n"), STR_LEN("        const challenge = await api('/v1/admin/captcha'); captchaId = challenge.captchaId;\n"));
    buf_append_lit(out, STR_PTR("        byId('captchaImage').src = challenge.imageDataUrl;\n"), STR_LEN("        byId('captchaImage').src = challenge.imageDataUrl;\n"));
    buf_append_lit(out, STR_PTR("        byId('captchaAnswer').value = ''; byId('captchaAnswer').focus();\n"), STR_LEN("        byId('captchaAnswer').value = ''; byId('captchaAnswer').focus();\n"));
    buf_append_lit(out, STR_PTR("      } catch (error) { byId('loginError').textContent = '验证码加载失败：' + error.message; }\n"), STR_LEN("      } catch (error) { byId('loginError').textContent = '验证码加载失败：' + error.message; }\n"));
    buf_append_lit(out, STR_PTR("    }\n"), STR_LEN("    }\n"));
    buf_append_lit(out, STR_PTR("    async function confirmTotpSetup() {\n"), STR_LEN("    async function confirmTotpSetup() {\n"));
    buf_append_lit(out, STR_PTR("      try {\n"), STR_LEN("      try {\n"));
    buf_append_lit(out, STR_PTR("        await api('/v1/admin/totp/confirm', {method:'POST', body:JSON.stringify({enrollmentId, totp:byId('totpConfirm').value})});\n"), STR_LEN("        await api('/v1/admin/totp/confirm', {method:'POST', body:JSON.stringify({enrollmentId, totp:byId('totpConfirm').value})});\n"));
    buf_append_lit(out, STR_PTR("        byId('totpSetup').classList.add('hidden'); byId('app').classList.remove('hidden'); await load();\n"), STR_LEN("        byId('totpSetup').classList.add('hidden'); byId('app').classList.remove('hidden'); await load();\n"));
    buf_append_lit(out, STR_PTR("      } catch (error) { byId('totpError').textContent = error.message; }\n"), STR_LEN("      } catch (error) { byId('totpError').textContent = error.message; }\n"));
    buf_append_lit(out, STR_PTR("    }\n"), STR_LEN("    }\n"));
    buf_append_lit(out, STR_PTR("    async function load() {\n"), STR_LEN("    async function load() {\n"));
    buf_append_lit(out, STR_PTR("      try {\n"), STR_LEN("      try {\n"));
    buf_append_lit(out, STR_PTR("        const data = await api('/v1/admin/console?q=' + encodeURIComponent(byId('query').value));\n"), STR_LEN("        const data = await api('/v1/admin/console?q=' + encodeURIComponent(byId('query').value));\n"));
    buf_append_lit(out, STR_PTR("        byId('days').value = data.settings.defaultValidityDays; byId('hours').value = data.settings.refreshIntervalHours;\n"), STR_LEN("        byId('days').value = data.settings.defaultValidityDays; byId('hours').value = data.settings.refreshIntervalHours;\n"));
    buf_append_lit(out, STR_PTR("        byId('ttl').value = data.settings.requiredTtlMinutes; byId('invite').value = data.settings.discordInviteUrl;\n"), STR_LEN("        byId('ttl').value = data.settings.requiredTtlMinutes; byId('invite').value = data.settings.discordInviteUrl;\n"));
    buf_append_lit(out, STR_PTR("        const campaign = data.settings.campaign || {};\n"), STR_LEN("        const campaign = data.settings.campaign || {};\n"));
    buf_append_lit(out, STR_PTR("        byId('campaignTitle').value = campaign.title || ''; byId('campaignMessage').value = campaign.message || '';\n"), STR_LEN("        byId('campaignTitle').value = campaign.title || ''; byId('campaignMessage').value = campaign.message || '';\n"));
    buf_append_lit(out, STR_PTR("        byId('campaignUrl').value = campaign.targetUrl || ''; byId('campaignImage').value = campaign.imageUrl || '';\n"), STR_LEN("        byId('campaignUrl').value = campaign.targetUrl || ''; byId('campaignImage').value = campaign.imageUrl || '';\n"));
    buf_append_lit(out, STR_PTR("        byId('rows').innerHTML = '<table><tr><th>机器码</th><th>Discord</th><th>密钥</th><th>签发 / 到期</th><th>最后刷新</th><th>状态</th><th></th></tr>' + data.licenses.map((license) =>\n"), STR_LEN("        byId('rows').innerHTML = '<table><tr><th>机器码</th><th>Discord</th><th>密钥</th><th>签发 / 到期</th><th>最后刷新</th><th>状态</th><th></th></tr>' + data.licenses.map((license) =>\n"));
    buf_append_lit(out, STR_PTR("          '<tr><td class=\"hash\" title=\"' + escapeHtml(license.machineHash) + '\">' + escapeHtml(license.machineHash.slice(0, 12)) + '…</td><td>' + escapeHtml(license.discordUserId) + '</td><td>' + escapeHtml(license.keyPreview) + '</td><td>' + escapeHtml(new Date(license.issuedAt).toLocaleString()) + '<br>' + escapeHtml(new Date(license.expiresAt).toLocaleString()) + '</td><td>' + escapeHtml(license.refreshAt ? new Date(license.refreshAt).toLocaleString() : '未刷新') + '</td><td>' + escapeHtml(license.status) + '</td><td>' + (license.status === 'active' ? '<button class=\"danger revoke\" data-id=\"' + escapeHtml(license.id) + '\">撤销</button>' : '') + '</td></tr>').join('') + '</table>';\n"), STR_LEN("          '<tr><td class=\"hash\" title=\"' + escapeHtml(license.machineHash) + '\">' + escapeHtml(license.machineHash.slice(0, 12)) + '…</td><td>' + escapeHtml(license.discordUserId) + '</td><td>' + escapeHtml(license.keyPreview) + '</td><td>' + escapeHtml(new Date(license.issuedAt).toLocaleString()) + '<br>' + escapeHtml(new Date(license.expiresAt).toLocaleString()) + '</td><td>' + escapeHtml(license.refreshAt ? new Date(license.refreshAt).toLocaleString() : '未刷新') + '</td><td>' + escapeHtml(license.status) + '</td><td>' + (license.status === 'active' ? '<button class=\"danger revoke\" data-id=\"' + escapeHtml(license.id) + '\">撤销</button>' : '') + '</td></tr>').join('') + '</table>';\n"));
    buf_append_lit(out, STR_PTR("        document.querySelectorAll('.revoke').forEach((button) => button.addEventListener('click', () => revoke(button.dataset.id)));\n"), STR_LEN("        document.querySelectorAll('.revoke').forEach((button) => button.addEventListener('click', () => revoke(button.dataset.id)));\n"));
    buf_append_lit(out, STR_PTR("      } catch (error) { if (error.message === 'Unauthorized') location.reload(); else alert(error.message); }\n"), STR_LEN("      } catch (error) { if (error.message === 'Unauthorized') location.reload(); else alert(error.message); }\n"));
    buf_append_lit(out, STR_PTR("    }\n"), STR_LEN("    }\n"));
    buf_append_lit(out, STR_PTR("    async function saveSettings() {\n"), STR_LEN("    async function saveSettings() {\n"));
    buf_append_lit(out, STR_PTR("      const title = byId('campaignTitle').value.trim(), message = byId('campaignMessage').value.trim();\n"), STR_LEN("      const title = byId('campaignTitle').value.trim(), message = byId('campaignMessage').value.trim();\n"));
    buf_append_lit(out, STR_PTR("      const campaign = title && message ? {id:'admin-' + Date.now(), title, message, targetUrl:byId('campaignUrl').value, imageUrl:byId('campaignImage').value} : null;\n"), STR_LEN("      const campaign = title && message ? {id:'admin-' + Date.now(), title, message, targetUrl:byId('campaignUrl').value, imageUrl:byId('campaignImage').value} : null;\n"));
    buf_append_lit(out, STR_PTR("      await api('/v1/admin/console/settings', {method:'PUT', body:JSON.stringify({defaultValidityDays:Number(byId('days').value), refreshIntervalHours:Number(byId('hours').value), requiredTtlMinutes:Number(byId('ttl').value), discordInviteUrl:byId('invite').value, campaign})});\n"), STR_LEN("      await api('/v1/admin/console/settings', {method:'PUT', body:JSON.stringify({defaultValidityDays:Number(byId('days').value), refreshIntervalHours:Number(byId('hours').value), requiredTtlMinutes:Number(byId('ttl').value), discordInviteUrl:byId('invite').value, campaign})});\n"));
    buf_append_lit(out, STR_PTR("      await load(); alert('设置已保存');\n"), STR_LEN("      await load(); alert('设置已保存');\n"));
    buf_append_lit(out, STR_PTR("    }\n"), STR_LEN("    }\n"));
    buf_append_lit(out, STR_PTR("    async function issue() {\n"), STR_LEN("    async function issue() {\n"));
    buf_append_lit(out, STR_PTR("      try {\n"), STR_LEN("      try {\n"));
    buf_append_lit(out, STR_PTR("        const data = await api('/v1/admin/console/issue', {method:'POST', body:JSON.stringify({machineHash:byId('machine').value, discordUserId:byId('discord').value, validityDays:Number(byId('validity').value)})});\n"), STR_LEN("        const data = await api('/v1/admin/console/issue', {method:'POST', body:JSON.stringify({machineHash:byId('machine').value, discordUserId:byId('discord').value, validityDays:Number(byId('validity').value)})});\n"));
    buf_append_lit(out, STR_PTR("        byId('issued').textContent = '密钥：' + data.key + '\\n到期：' + new Date(data.expiresAt).toLocaleString(); await load();\n"), STR_LEN("        byId('issued').textContent = '密钥：' + data.key + '\\n到期：' + new Date(data.expiresAt).toLocaleString(); await load();\n"));
    buf_append_lit(out, STR_PTR("      } catch (error) { alert(error.message); }\n"), STR_LEN("      } catch (error) { alert(error.message); }\n"));
    buf_append_lit(out, STR_PTR("    }\n"), STR_LEN("    }\n"));
    buf_append_lit(out, STR_PTR("    async function revoke(id) { if (confirm('确认撤销这个密钥？')) { await api('/v1/admin/console/revoke', {method:'POST', body:JSON.stringify({id})}); await load(); } }\n"), STR_LEN("    async function revoke(id) { if (confirm('确认撤销这个密钥？')) { await api('/v1/admin/console/revoke', {method:'POST', body:JSON.stringify({id})}); await load(); } }\n"));
    buf_append_lit(out, STR_PTR("    byId('loginButton').addEventListener('click', login); byId('captchaImage').addEventListener('click', loadCaptcha); byId('captchaAnswer').addEventListener('keydown', (event) => { if (event.key === 'Enter') login(); });\n"), STR_LEN("    byId('loginButton').addEventListener('click', login); byId('captchaImage').addEventListener('click', loadCaptcha); byId('captchaAnswer').addEventListener('keydown', (event) => { if (event.key === 'Enter') login(); });\n"));
    buf_append_lit(out, STR_PTR("    byId('totpConfirmButton').addEventListener('click', confirmTotpSetup); byId('totpConfirm').addEventListener('keydown', (event) => { if (event.key === 'Enter') confirmTotpSetup(); });\n"), STR_LEN("    byId('totpConfirmButton').addEventListener('click', confirmTotpSetup); byId('totpConfirm').addEventListener('keydown', (event) => { if (event.key === 'Enter') confirmTotpSetup(); });\n"));
    buf_append_lit(out, STR_PTR("    byId('totpCancelButton').addEventListener('click', () => { enrollmentId = ''; byId('totpSetup').classList.add('hidden'); byId('login').classList.remove('hidden'); loadCaptcha(); });\n"), STR_LEN("    byId('totpCancelButton').addEventListener('click', () => { enrollmentId = ''; byId('totpSetup').classList.add('hidden'); byId('login').classList.remove('hidden'); loadCaptcha(); });\n"));
    buf_append_lit(out, STR_PTR("    byId('logoutButton').addEventListener('click', async () => { await api('/v1/admin/logout', {method:'POST'}); location.reload(); });\n"), STR_LEN("    byId('logoutButton').addEventListener('click', async () => { await api('/v1/admin/logout', {method:'POST'}); location.reload(); });\n"));
    buf_append_lit(out, STR_PTR("    byId('searchButton').addEventListener('click', load); byId('saveSettingsButton').addEventListener('click', saveSettings); byId('issueButton').addEventListener('click', issue);\n"), STR_LEN("    byId('searchButton').addEventListener('click', load); byId('saveSettingsButton').addEventListener('click', saveSettings); byId('issueButton').addEventListener('click', issue);\n"));
    buf_append_lit(out, STR_PTR("    byId('clearCampaignButton').addEventListener('click', async () => { await api('/v1/admin/console/settings', {method:'PUT', body:JSON.stringify({campaign:null})}); await load(); });\n"), STR_LEN("    byId('clearCampaignButton').addEventListener('click', async () => { await api('/v1/admin/console/settings', {method:'PUT', body:JSON.stringify({campaign:null})}); await load(); });\n"));
    buf_append_lit(out, STR_PTR("    api('/v1/admin/console').then(() => { byId('login').classList.add('hidden'); byId('app').classList.remove('hidden'); load(); }).catch(loadCaptcha);\n"), STR_LEN("    api('/v1/admin/console').then(() => { byId('login').classList.add('hidden'); byId('app').classList.remove('hidden'); load(); }).catch(loadCaptcha);\n"));
    buf_append_lit(out, STR_PTR("  </script>\n"), STR_LEN("  </script>\n"));
    buf_append_lit(out, STR_PTR("</body>\n"), STR_LEN("</body>\n"));
    buf_append_lit(out, STR_PTR("</html>"), STR_LEN("</html>"));
}
