// DEFECT: node:test + node:assert/strict have no SLA counterpart (see
// adminAuth.test.sla header). mkdtempSync/rmSync map to intent test
// externs (sa_test_mkdtemp / sa_test_rm_rf). String bindings from the
// sa_std ts face: machineHash.slice(0, 12) -> @ts_str_slice
// (ts_string.sa, returns a 16-byte {ptr,len} handle), reason/key string
// equality -> @ts_str_equals. String.repeat and the key-format regex
// have NO entry in the ts inventory — repeat is a fill loop and the
// regex is a manual scan (logged).

fn expect_true(fails: &u64, cond: bool) -> void { if !cond { let __sp28 = *fails; *fails = __sp28 + 1; }; }
fn expect_u64_eq(fails: &u64, a: u64, b: u64) -> void { if a != b { let __sp29 = *fails; *fails = __sp29 + 1; }; }
fn expect_str_eq(fails: &u64, ap: ptr, al: u64, bp: ptr, bl: u64) -> void {
    if ts_str_equals(ap, al, bp, bl) != 1 { let __sp30 = *fails; *fails = __sp30 + 1; };
}
fn expect_reason_eq(fails: &u64, st: &LicenseStatus, lit_ptr: ptr, lit_len: u64) -> void {
    let __ap470: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap470, st.reason, 0);
    if ts_str_equals(__ap470, st.reason_len, lit_ptr, lit_len) != 1 { let __sp31 = *fails; *fails = __sp31 + 1; };
}

// "x".repeat(64) — no @ts_str repeat in the inventory; fill loop.
fn repeated_hash(out: &ByteBuf, ch: u8) -> void {
    buf_reset(out);
    for i in 0..64 { buf_append_byte(out, ch); }
}

// function createStore(): LicenseStore (temp dir per test; afterEach
// cleanup is sa_test_rm_rf at the end of each test + store close)
fn create_store(fails: &u64, dir_out: &ByteBuf) -> LicenseStore {
    sa_test_mkdtemp(dir_out, STR_PTR("codex-free-key-test-"), STR_LEN("codex-free-key-test-"));
    let db_path = ByteBuf { bytes: [0u8; 40960], len: 0 };
    buf_append_buf(&db_path, dir_out);
    buf_append_lit(&db_path, STR_PTR("/free-keys.sqlite3"), STR_LEN("/free-keys.sqlite3"));
    let cfg = FreeKeyServerConfig { host: StrField { bytes: [0u8; 512], len: 0 }, port: 43210, database_path: StrField { bytes: [0u8; 512], len: 0 }, hash_pepper: StrField { bytes: [0u8; 512], len: 0 }, has_client_secret: false, client_secret: StrField { bytes: [0u8; 512], len: 0 }, admin_secret: StrField { bytes: [0u8; 512], len: 0 }, has_admin_username: false, admin_username: StrField { bytes: [0u8; 512], len: 0 }, has_admin_password_hash: false, admin_password_hash: StrField { bytes: [0u8; 512], len: 0 }, has_admin_session_secret: false, admin_session_secret: StrField { bytes: [0u8; 512], len: 0 }, default_validity_days: 1.0, refresh_interval_hours: 5.0, required_ttl_minutes: 15.0, discord_invite_url: StrField { bytes: [0u8; 512], len: 0 }, has_discord_public_key: false, discord_public_key: StrField { bytes: [0u8; 512], len: 0 }, has_discord_channel_id: false, discord_channel_id: StrField { bytes: [0u8; 512], len: 0 } };
    str_field_set(&cfg.host, STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"));
    let __ap471: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap471, db_path.bytes, 0);
    str_field_set(&cfg.database_path, __ap471, db_path.len);
    str_field_set(&cfg.hash_pepper, STR_PTR("test-pepper-that-is-long-enough-123456"), STR_LEN("test-pepper-that-is-long-enough-123456"));
    str_field_set(&cfg.admin_secret, STR_PTR("test-admin-secret-123456"), STR_LEN("test-admin-secret-123456"));
    str_field_set(&cfg.discord_invite_url, STR_PTR("https://discord.example/invite"), STR_LEN("https://discord.example/invite"));
    let store = LicenseStore { db: 0, closed: false, cfg_default_validity_days: 0.0, cfg_refresh_interval_hours: 0.0, cfg_required_ttl_minutes: 0.0, cfg_hash_pepper: StrField { bytes: [0u8; 512], len: 0 }, cfg_discord_invite_url: StrField { bytes: [0u8; 512], len: 0 }, cfg_database_path: StrField { bytes: [0u8; 512], len: 0 } };
    expect_true(fails, license_store_new(&store, &cfg) == 0);
    return store;
}

fn blank_license() -> License {
    return License { key: StrField { bytes: [0u8; 512], len: 0 }, user_id: StrField { bytes: [0u8; 512], len: 0 }, machine_hash: StrField { bytes: [0u8; 512], len: 0 }, issued_at: 0, expires_at: 0, revoked: false };
}

fn blank_access() -> AccessStatus {
    return AccessStatus { license: LicenseStatus { valid: false, reason: [0u8; 20], reason_len: 0, has_key_preview: false, key_preview: StrField { bytes: [0u8; 512], len: 0 }, has_issued_at: false, issued_at: 0, has_expires_at: false, expires_at: 0, has_discord_user_id: false, discord_user_id: StrField { bytes: [0u8; 512], len: 0 } }, refresh_interval_hours: 0.0, has_last_refreshed_at: false, last_refreshed_at: 0, has_next_required_refresh_at: false, next_required_refresh_at: 0, refresh_required: false, discord_invite_url: StrField { bytes: [0u8; 512], len: 0 }, has_campaign: false, campaign: Campaign { id: StrField { bytes: [0u8; 512], len: 0 }, title: StrField { bytes: [0u8; 512], len: 0 }, message: StrField { bytes: [0u8; 512], len: 0 }, has_image_url: false, image_url: StrField { bytes: [0u8; 512], len: 0 }, has_target_url: false, target_url: StrField { bytes: [0u8; 512], len: 0 }, has_starts_at: false, starts_at: 0, has_ends_at: false, ends_at: 0 } };
}

fn status_of(fails: &u64, store: &LicenseStore, mh_ptr: ptr, mh_len: u64, key_ptr: ptr, key_len: u64, now: u64) -> AccessStatus {
    let access = blank_access();
    let err = ByteBuf { bytes: [0u8; 40960], len: 0 };
    license_store_status(store, &access, &err, mh_ptr, mh_len, true, key_ptr, key_len, now);
    return access;
}

fn issue_via_requirement(fails: &u64, store: &LicenseStore, mh_ptr: ptr, mh_len: u64, uid_ptr: ptr, uid_len: u64, req_now: u64, issue_now: u64) -> License {
    let requirement = Requirement { required_code: StrField { bytes: [0u8; 512], len: 0 }, expires_at: 0 };
    let err = ByteBuf { bytes: [0u8; 40960], len: 0 };
    expect_true(fails, license_store_create_requirement(store, &requirement, &err, mh_ptr, mh_len, req_now) == 0);
    let license = blank_license();
    let __ap472: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap472, requirement.required_code.bytes, 0);
    expect_true(fails, license_store_issue_license(store, &license, &err, __ap472, requirement.required_code.len, uid_ptr, uid_len, issue_now) == 0);
    return license;
}

// assert.match(key, /^cxu-[A-Za-z0-9]{48}$/) — manual scan (no regex
// surface in the ts inventory); length checked separately in TS too.
fn key_format_ok(key: &StrField) -> bool {
    if key.len != 52 { return false; };
    let __ap473: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap473, key.bytes, 0);
    if !starts_with(__ap473, key.len, STR_PTR("cxu-"), STR_LEN("cxu-")) { return false; };
    for i in 4..52 {
        let b = key.bytes[i];
        let ok = (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122);
        if !ok { return false; };
    }
    return true;
}

fn test_issues_machine_bound_keys(fails: &u64) -> void {
    let dir = ByteBuf { bytes: [0u8; 40960], len: 0 };
    let store = create_store(fails, &dir);
    let now: u64 = 1000000;
    let mh = ByteBuf { bytes: [0u8; 40960], len: 0 };
    repeated_hash(&mh, 97);
    let __ap474: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap474, mh.bytes, 0);
    let license = issue_via_requirement(fails, &store, __ap474, mh.len, STR_PTR("discord-user-1"), STR_LEN("discord-user-1"), now, now + 1000);
    expect_true(fails, key_format_ok(&license.key));
    expect_u64_eq(fails, license.key.len, 52);
    expect_u64_eq(fails, license.expires_at - license.issued_at, 24 * 60 * 60000);
    let __ap476: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap476, mh.bytes, 0);
    let __ap475: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap475, license.key.bytes, 0);
    let ok_status = status_of(fails, &store, __ap476, mh.len, __ap475, license.key.len, now + 2000);
    expect_true(fails, ok_status.license.valid);
    let other = ByteBuf { bytes: [0u8; 40960], len: 0 };
    repeated_hash(&other, 98);
    let __ap478: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap478, other.bytes, 0);
    let __ap477: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap477, license.key.bytes, 0);
    let mismatch = status_of(fails, &store, __ap478, other.len, __ap477, license.key.len, now + 2000);
    expect_reason_eq(fails, &mismatch.license, STR_PTR("machine_mismatch"), STR_LEN("machine_mismatch"));
    let __ap480: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap480, mh.bytes, 0);
    let __ap479: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap479, license.key.bytes, 0);
    let expired = status_of(fails, &store, __ap480, mh.len, __ap479, license.key.len, license.expires_at);
    expect_reason_eq(fails, &expired.license, STR_PTR("expired"), STR_LEN("expired"));
    license_store_close(&store);
    sa_test_rm_rf(&dir.bytes, dir.len);
}

fn test_refresh_cadence(fails: &u64) -> void {
    let dir = ByteBuf { bytes: [0u8; 40960], len: 0 };
    let store = create_store(fails, &dir);
    let now: u64 = 2000000;
    let mh = ByteBuf { bytes: [0u8; 40960], len: 0 };
    repeated_hash(&mh, 99);
    let __ap481: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap481, mh.bytes, 0);
    let license = issue_via_requirement(fails, &store, __ap481, mh.len, STR_PTR("discord-user-2"), STR_LEN("discord-user-2"), now, now + 1);
    let err = ByteBuf { bytes: [0u8; 40960], len: 0 };
    let first = PrepareRefreshResult { status: blank_access(), allowed: false, has_authorization_id: false, authorization_id: StrField { bytes: [0u8; 512], len: 0 }, has_authorization_expires_at: false, authorization_expires_at: 0, has_requirement: false, requirement: Requirement { required_code: StrField { bytes: [0u8; 512], len: 0 }, expires_at: 0 } };
    let __ap483: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap483, mh.bytes, 0);
    let __ap482: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap482, license.key.bytes, 0);
    license_store_prepare_refresh(&store, &first, &err, __ap483, mh.len, true, __ap482, license.key.len, now + 2);
    expect_true(fails, first.allowed);
    // TS: first.refreshRequired — carried on the result's status in the SLA shape
    expect_true(fails, first.status.refresh_required);
    expect_true(fails, first.has_authorization_id);
    let __ap485: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap485, mh.bytes, 0);
    let __ap484: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap484, first.authorization_id.bytes, 0);
    license_store_complete_refresh(&store, &err, __ap485, mh.len, __ap484, first.authorization_id.len, true, 6, now + 3);
    let __ap487: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap487, mh.bytes, 0);
    let __ap486: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap486, license.key.bytes, 0);
    let after = status_of(fails, &store, __ap487, mh.len, __ap486, license.key.len, now + 4);
    expect_true(fails, !after.refresh_required);
    let __ap489: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap489, mh.bytes, 0);
    let __ap488: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap488, license.key.bytes, 0);
    let later = status_of(fails, &store, __ap489, mh.len, __ap488, license.key.len, now + 3 + 5 * 60 * 60000);
    expect_true(fails, later.refresh_required);
    // a second refresh is allowed too (no refresh-count limit)
    let second = PrepareRefreshResult { status: blank_access(), allowed: false, has_authorization_id: false, authorization_id: StrField { bytes: [0u8; 512], len: 0 }, has_authorization_expires_at: false, authorization_expires_at: 0, has_requirement: false, requirement: Requirement { required_code: StrField { bytes: [0u8; 512], len: 0 }, expires_at: 0 } };
    let __ap491: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap491, mh.bytes, 0);
    let __ap490: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap490, license.key.bytes, 0);
    license_store_prepare_refresh(&store, &second, &err, __ap491, mh.len, true, __ap490, license.key.len, now + 4);
    expect_true(fails, second.allowed);
    let __ap493: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap493, mh.bytes, 0);
    let __ap492: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap492, second.authorization_id.bytes, 0);
    license_store_complete_refresh(&store, &err, __ap493, mh.len, __ap492, second.authorization_id.len, true, 7, now + 5);
    let __ap495: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap495, mh.bytes, 0);
    let __ap494: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap494, license.key.bytes, 0);
    let after2 = status_of(fails, &store, __ap495, mh.len, __ap494, license.key.len, now + 6);
    expect_true(fails, !after2.refresh_required);
    license_store_close(&store);
    sa_test_rm_rf(&dir.bytes, dir.len);
}

fn test_admin_settings_change_validity_and_campaign(fails: &u64) -> void {
    let dir = ByteBuf { bytes: [0u8; 40960], len: 0 };
    let store = create_store(fails, &dir);
    // store.updateSettings({ defaultValidityDays: 3, campaign: {...} })
    let input_json = STR_PTR("{\"defaultValidityDays\":3,\"campaign\":{\"id\":\"ad-1\",\"title\":\"公告\",\"message\":\"刷新提示内容\",\"targetUrl\":\"https://example.com\"}}");
    let input: u64 = 0;
    expect_true(fails, sa_json_parse(input_json, STR_LEN("{\"defaultValidityDays\":3,\"campaign\":{\"id\":\"ad-1\",\"title\":\"公告\",\"message\":\"刷新提示内容\",\"targetUrl\":\"https://example.com\"}}"), &input) == 0 && input != 0);
    let out = ByteBuf { bytes: [0u8; 40960], len: 0 };
    let err = ByteBuf { bytes: [0u8; 40960], len: 0 };
    expect_true(fails, license_store_update_settings(&store, &out, &err, input) == 0);
    let now: u64 = 3000000;
    let mh = ByteBuf { bytes: [0u8; 40960], len: 0 };
    repeated_hash(&mh, 100);
    let __ap496: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap496, mh.bytes, 0);
    let license = issue_via_requirement(fails, &store, __ap496, mh.len, STR_PTR("discord-admin-test"), STR_LEN("discord-admin-test"), now, now + 1);
    expect_u64_eq(fails, license.expires_at - license.issued_at, 3 * 24 * 60 * 60000);
    let __ap498: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap498, mh.bytes, 0);
    let __ap497: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap497, license.key.bytes, 0);
    let status = status_of(fails, &store, __ap498, mh.len, __ap497, license.key.len, now + 2);
    // assert.deepEqual(status.campaign, { id, title, message, targetUrl: "https://example.com/" })
    expect_true(fails, status.has_campaign);
    let __ap499: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap499, status.campaign.id.bytes, 0);
    expect_str_eq(fails, __ap499, status.campaign.id.len, STR_PTR("ad-1"), STR_LEN("ad-1"));
    let __ap500: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap500, status.campaign.title.bytes, 0);
    expect_str_eq(fails, __ap500, status.campaign.title.len, STR_PTR("公告"), STR_LEN("公告"));
    let __ap501: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap501, status.campaign.message.bytes, 0);
    expect_str_eq(fails, __ap501, status.campaign.message.len, STR_PTR("刷新提示内容"), STR_LEN("刷新提示内容"));
    expect_true(fails, status.campaign.has_target_url);
    let __ap502: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap502, status.campaign.target_url.bytes, 0);
    expect_str_eq(fails, __ap502, status.campaign.target_url.len, STR_PTR("https://example.com/"), STR_LEN("https://example.com/"));
    license_store_close(&store);
    sa_test_rm_rf(&dir.bytes, dir.len);
}

fn test_admin_search_issue_revoke(fails: &u64) -> void {
    let dir = ByteBuf { bytes: [0u8; 40960], len: 0 };
    let store = create_store(fails, &dir);
    let mh = ByteBuf { bytes: [0u8; 40960], len: 0 };
    repeated_hash(&mh, 101);
    let err = ByteBuf { bytes: [0u8; 40960], len: 0 };
    let issued = blank_license();
    let __ap503: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap503, mh.bytes, 0);
    expect_true(fails, license_store_issue_admin_license(&store, &issued, &err, __ap503, mh.len, STR_PTR("discord-user-admin"), STR_LEN("discord-user-admin"), 2.0, 4000000) == 0);
    // store.listLicenses(machineHash.slice(0, 12)) — @ts_str_slice bound
    let query_handle = ts_str_slice(&mh.bytes, mh.len, 0, 12, 0);
    let rows: [AdminLicenseRow; 200] = [AdminLicenseRow { id: StrField { bytes: [0u8; 512], len: 0 }, key_preview: StrField { bytes: [0u8; 512], len: 0 }, machine_hash: StrField { bytes: [0u8; 512], len: 0 }, discord_user_id: StrField { bytes: [0u8; 512], len: 0 }, issued_at: 0, expires_at: 0, status: StrField { bytes: [0u8; 512], len: 0 }, has_revoked_at: false, revoked_at: 0, has_refresh_at: false, refresh_at: 0 }; 200];
    let count = license_store_list_licenses(&store, &rows, sa_handle_data(query_handle), sa_handle_len(query_handle), 50);
    expect_u64_eq(fails, count, 1);
    let __ap506: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap506, rows[0].machine_hash.bytes, 0);
    let __ap505: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap505, mh.bytes, 0);
    expect_str_eq(fails, __ap506, rows[0].machine_hash.len, __ap505, mh.len);
    expect_u64_eq(fails, issued.expires_at - issued.issued_at, 2 * 24 * 60 * 60000);
    let __ap508: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap508, mh.bytes, 0);
    let __ap507: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap507, issued.key.bytes, 0);
    let valid = status_of(fails, &store, __ap508, mh.len, __ap507, issued.key.len, 4000001);
    expect_true(fails, valid.license.valid);
    let __ap509: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap509, rows[0].id.bytes, 0);
    expect_true(fails, license_store_revoke_license(&store, __ap509, rows[0].id.len, STR_PTR("test-admin"), STR_LEN("test-admin"), 4000002));
    let __ap511: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap511, mh.bytes, 0);
    let __ap510: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap510, issued.key.bytes, 0);
    let revoked = status_of(fails, &store, __ap511, mh.len, __ap510, issued.key.len, 4000003);
    expect_reason_eq(fails, &revoked.license, STR_PTR("revoked"), STR_LEN("revoked"));
    license_store_close(&store);
    sa_test_rm_rf(&dir.bytes, dir.len);
}

fn run_all_tests() -> u64 {
    let fails: u64 = 0;
    test_issues_machine_bound_keys(&fails);
    test_refresh_cadence(&fails);
    test_admin_settings_change_validity_and_campaign(&fails);
    test_admin_search_issue_revoke(&fails);
    return fails;
}
