// Converted 1:1 from apps/free-key-server/src/adminTotp.test.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "sa_std/ptr.sa"
@import "sa_std/string.sai"
@import "sa_std/string.sa"
@import "sa_std/ts_string.sa"
@import "adminTotp.sla"

// DEFECT: node:test + node:assert/strict have no SLA counterpart (see
// adminAuth.test.sla header). assert.match(/^\d{6}$/) becomes a manual
// digit scan — the ts_string inventory has no regex surface (logged).
// assert.match on the otpauth URI prefix binds to sa_string_index_of
// == 0 (sa_std string.sai). assert.throws maps to the i32 error return
// of decrypt_totp_secret.

fn expect_true(fails: &u64, cond: bool) -> void { if !cond { let __sp26 = *fails; *fails = __sp26 + 1; }; }
fn expect_str_eq(fails: &u64, ap: ptr, al: u64, bp: ptr, bl: u64) -> void {
    if ts_str_equals(ap, al, bp, bl) != 1 { let __sp27 = *fails; *fails = __sp27 + 1; };
}

fn all_digits(p: ptr, l: u64) -> bool {
    for i in 0..l {
        let b = PTR_BYTE_AT(p, i);
        if b < 48 || b > 57 { return false; };
    }
    return l > 0;
}

fn test_generates_and_verifies_totp(fails: &u64) -> void {
    let secret = ByteBuf { bytes: [0u8; 40960], len: 0 };
    generate_totp_secret(&secret, 20);
    let now: u64 = 1786173222000;
    let code = ByteBuf { bytes: [0u8; 40960], len: 0 };
    let __ap282: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap282, secret.bytes, 0);
    totp_code(&code, __ap282, secret.len, now);
    // assert.match(code, /^\d{6}$/)
    let __ap283: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap283, code.bytes, 0);
    expect_true(fails, code.len == 6 && all_digits(__ap283, code.len));
    let __ap285: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap285, secret.bytes, 0);
    let __ap284: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap284, code.bytes, 0);
    expect_true(fails, verify_totp(__ap285, secret.len, __ap284, code.len, now));
    let __ap287: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap287, secret.bytes, 0);
    let __ap286: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap286, code.bytes, 0);
    expect_true(fails, !verify_totp(__ap287, secret.len, __ap286, code.len, now + 60000));
    // assert.match(totpUri(secret, "admin"), /^otpauth:\/\/totp\//)
    let uri = ByteBuf { bytes: [0u8; 40960], len: 0 };
    let __ap288: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap288, secret.bytes, 0);
    totp_uri(&uri, __ap288, secret.len, STR_PTR("admin"), STR_LEN("admin"), STR_PTR("Codex Ultra"), STR_LEN("Codex Ultra"));
    let __ap_uri: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap_uri, uri.bytes, 0);
    expect_true(fails, sa_string_index_of(__ap_uri, uri.len, STR_PTR("otpauth://totp/"), STR_LEN("otpauth://totp/"), 0) == 0);
}

fn test_encrypts_totp_secret_at_rest(fails: &u64) -> void {
    let secret = ByteBuf { bytes: [0u8; 40960], len: 0 };
    generate_totp_secret(&secret, 20);
    let enc_secret = STR_PTR("session-secret-that-is-long-enough");
    let enc_len = STR_LEN("session-secret-that-is-long-enough");
    let encrypted = ByteBuf { bytes: [0u8; 40960], len: 0 };
    let __ap289: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap289, secret.bytes, 0);
    encrypt_totp_secret(&encrypted, __ap289, secret.len, enc_secret, enc_len);
    // assert.notEqual(encrypted.includes(secret), true) — String.includes
    // bound to sa_string_index_of (sa_std string.sai).
    let __ap_enc: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap_enc, encrypted.bytes, 0);
    let __ap_sec: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap_sec, secret.bytes, 0);
    expect_true(fails, sa_string_index_of(__ap_enc, encrypted.len, __ap_sec, secret.len, 0) < 0);
    let decrypted = ByteBuf { bytes: [0u8; 40960], len: 0 };
    let __ap290: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap290, encrypted.bytes, 0);
    expect_true(fails, decrypt_totp_secret(&decrypted, __ap290, encrypted.len, enc_secret, enc_len) == 0);
    let __ap292: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap292, decrypted.bytes, 0);
    let __ap291: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap291, secret.bytes, 0);
    expect_str_eq(fails, __ap292, decrypted.len, __ap291, secret.len);
    // assert.throws(() => decryptTotpSecret(encrypted + "x", ...))
    let tampered = ByteBuf { bytes: [0u8; 40960], len: 0 };
    buf_append_buf(&tampered, &encrypted);
    buf_append_lit(&tampered, STR_PTR("x"), STR_LEN("x"));
    let out2 = ByteBuf { bytes: [0u8; 40960], len: 0 };
    let __ap293: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap293, tampered.bytes, 0);
    expect_true(fails, decrypt_totp_secret(&out2, __ap293, tampered.len, enc_secret, enc_len) != 0);
}

fn run_all_tests() -> u64 {
    let fails: u64 = 0;
    test_generates_and_verifies_totp(&fails);
    test_encrypts_totp_secret_at_rest(&fails);
    return fails;
}
