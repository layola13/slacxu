// Converted 1:1 from apps/free-key-server/src/discord.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "sa_std/ptr.sa"
@import "sa_std/encoding/json.sai"
@import "sa_std/time.sai"
@import "sa_std/fmt.sai"
@import "sa_std/string.sa"
@import "config.sla"
@import "licenseStore.sla"

// TS: import { createPublicKey, timingSafeEqual, verify } from "node:crypto";
// DEFECT: Ed25519 verification via an SPKI-DER-wrapped raw key
// (createPublicKey({ format: "der", type: "spki" }) + verify(null, ...))
// has no sa_std counterpart; intent extern sa_crypto_ed25519_verify_raw
// takes the raw 32-byte key, signature, and message directly.
// DEFECT: Record<string, unknown> inputs/outputs are dynamic JSON — the
// interaction is a sa_json node handle and the response is built as JSON
// text, per the brief's dynamic-object rule.

// Buffer.from(x, "hex") with an exact output length; i32 0 ok, 1 bad input.
// timingSafeEqual — local constant-time compare (0 = equal).
fn discord_timing_safe_equal(a: ptr, b: ptr, len: u64) -> i32 {
    let diff: u64 = 0;
    for i in 0..len {
        let x: u8 = 0;
        PTR_BYTE_AT(x, a, i);
        let y: u8 = 0;
        PTR_BYTE_AT(y, b, i);
        diff = diff | ((x ^ y) as u64);
    }
    if diff == 0 { return 0; };
    return 1;
}

fn hex_decode_into(src_ptr: ptr, src_len: u64, dst: ptr, want_len: u64) -> i32 {
    if src_len != want_len * 2 { return 1; };
    for i in 0..want_len {
        let hi: u8 = 0;
        let lo: u8 = 0;
        PTR_BYTE_AT(hi, src_ptr, i * 2);
        PTR_BYTE_AT(lo, src_ptr, i * 2 + 1);
        let hv: u64 = 0;
        let lv: u64 = 0;
        if hi >= 48 && hi <= 57 { hv = (hi - 48) as u64; } else if hi >= 97 && hi <= 102 { hv = (hi - 87) as u64; } else if hi >= 65 && hi <= 70 { hv = (hi - 55) as u64; } else { return 1; };
        if lo >= 48 && lo <= 57 { lv = (lo - 48) as u64; } else if lo >= 97 && lo <= 102 { lv = (lo - 87) as u64; } else if lo >= 65 && lo <= 70 { lv = (lo - 55) as u64; } else { return 1; };
        let __bs6: ptr = PTR_NULL(); PTR_BYTE_ADD(__bs6, dst, i); PTR_WRITE_U8(__bs6, ((hv << 4) | lv) as u8);
    }
    return 0;
}

// TS: const DISCORD_PUBLIC_KEY_PREFIX = Buffer.from("302a300506032b6570032100", "hex");
// (12-byte SPKI prefix for Ed25519; kept for parity — the intent extern
// consumes the raw key, so the prefix is documentary in this pass.)

// TS: export function verifyDiscordRequest(publicKeyHex, signatureHex, timestamp, body: Buffer): boolean
fn verify_discord_request(pk_ptr: ptr, pk_len: u64, sig_ptr: ptr, sig_len: u64, ts_ptr: ptr, ts_len: u64, body_ptr: ptr, body_len: u64) -> bool {
    // Buffer.from(hex) decodings; bad lengths -> false (TS try/catch).
    let raw_key = [0u8; 32];
    let __ap294: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap294, raw_key, 0);
    if hex_decode_into(pk_ptr, pk_len, __ap294, 32) != 0 { return false; };
    let signature = [0u8; 64];
    let __ap295: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap295, signature, 0);
    if hex_decode_into(sig_ptr, sig_len, __ap295, 64) != 0 { return false; };
    // Message = Buffer.concat([Buffer.from(timestamp), body]).
    let msg = ByteBuf { bytes: [0u8; 40960], len: 0 };
    buf_append_lit(&msg, ts_ptr, ts_len);
    buf_append_lit(&msg, body_ptr, body_len);
    // DEFECT (B-class, four-source verdict): Ed25519 signature
    // verification has NO counterpart in sala docs, SLA demos/tests,
    // the sa_plugin_sla corpus, or the sa_std inventory — Discord
    // request verification is UNSUPPORTED in this build and fails
    // closed (false) at the verify step; the hex decoding and
    // message assembly above are genuine. Registered in
    // FIX_OTHER_APPS.md.
    return false;
}

// TS: export function constantTimeSecretMatches(expected: string, actual: string | undefined): boolean
fn constant_time_secret_matches(exp_ptr: ptr, exp_len: u64, has_actual: bool, act_ptr: ptr, act_len: u64) -> bool {
    if !has_actual { return false; };
    if exp_len != act_len { return false; };
    return discord_timing_safe_equal(exp_ptr, act_ptr, exp_len) == 0;
}

// TS: function objectValue(value: unknown): Record<string, unknown>
// Returns the node itself when it is a non-array object, else an empty
// object node (0 handle convention in this pass).
fn object_value(node: u64) -> u64 {
    // DEFECT: runtime type test on `unknown` — approximated via JSON kind.
    if node != 0 && sa_json_kind(node) == 7 { return node; };
    return 0;
}

// TS: function ephemeral(content: string): Record<string, unknown>
// { type: 4, data: { content, flags: 64 } } as JSON text in out.
fn ephemeral(out: &ByteBuf, content_ptr: ptr, content_len: u64) -> void {
    buf_reset(out);
    buf_append_lit(out, STR_PTR("{\"type\":4,\"data\":{\"content\":\""), STR_LEN("{\"type\":4,\"data\":{\"content\":\""));
    buf_append_escaped(out, content_ptr, content_len);
    buf_append_lit(out, STR_PTR("\",\"flags\":64}}"), STR_LEN("\",\"flags\":64}}"));
}

// TS: export function handleDiscordInteraction(input, store, config): Record<string, unknown>
// Response JSON text lands in out.
fn handle_discord_interaction(out: &ByteBuf, input: u64, store: &LicenseStore, cfg: &FreeKeyServerConfig) -> void {
    buf_reset(out);
    let itype: u64 = 0;
    sa_json_object_get_i64(input, STR_PTR("type"), STR_LEN("type"), &itype);
    if itype == 1 {
        buf_append_lit(out, STR_PTR("{\"type\":1}"), STR_LEN("{\"type\":1}"));
        return;
    };
    if itype != 2 {
        ephemeral(out, STR_PTR("Unsupported Discord interaction"), STR_LEN("Unsupported Discord interaction"));
        return;
    };
    let ch_ptr: ptr = PTR_NULL();
    let ch_len: u64 = 0;
    sa_json_object_get_string(input, STR_PTR("channel_id"), STR_LEN("channel_id"), &ch_ptr, &ch_len);
    if cfg.has_discord_channel_id {
        let __ap296: ptr = PTR_NULL();
        PTR_BYTE_ADD(__ap296, cfg.discord_channel_id.bytes, 0);
        if ch_len != cfg.discord_channel_id.len || !bytes_eq3(__ap296, ch_ptr, ch_len) {
            ephemeral(out, STR_PTR("请在指定的 get-free-key 频道使用此命令。"), STR_LEN("请在指定的 get-free-key 频道使用此命令。"));
            return;
        };
    };
    let data: u64 = 0;
    sa_json_object_get(input, STR_PTR("data"), STR_LEN("data"), &data);
    data = object_value(data);
    let name_ptr: ptr = PTR_NULL();
    let name_len: u64 = 0;
    if data != 0 { sa_json_object_get_string(data, STR_PTR("name"), STR_LEN("name"), &name_ptr, &name_len); };
    if name_len != 8 || !bytes_eq_str(name_ptr, name_len, STR_PTR("free-key"), STR_LEN("free-key")) {
        ephemeral(out, STR_PTR("Unsupported command"), STR_LEN("Unsupported command"));
        return;
    };
    // options: array of objects; find name == "required", take .value.
    let req_ptr: ptr = PTR_NULL();
    let req_len: u64 = 0;
    let has_required = false;
    if data != 0 {
        let options: u64 = 0;
        if sa_json_object_get(data, STR_PTR("options"), STR_LEN("options"), &options) == 0 && options != 0 {
            let oi: u64 = 0;
            while 1 == 1 {
                let opt: u64 = 0;
                if sa_json_array_get(options, oi, &opt) != 0 { break; };
                opt = object_value(opt);
                if opt != 0 {
                    let on_ptr: ptr = PTR_NULL();
                    let on_len: u64 = 0;
                    sa_json_object_get_string(opt, STR_PTR("name"), STR_LEN("name"), &on_ptr, &on_len);
                    if on_len == 8 && bytes_eq_str(on_ptr, on_len, STR_PTR("required"), STR_LEN("required")) {
                        if sa_json_object_get_string(opt, STR_PTR("value"), STR_LEN("value"), &req_ptr, &req_len) == 0 { has_required = true; };
                    };
                };
                oi = oi + 1;
            }
        };
    };
    // member.user.id, falling back to user.id.
    let uid_ptr: ptr = PTR_NULL();
    let uid_len: u64 = 0;
    let member: u64 = 0;
    sa_json_object_get(input, STR_PTR("member"), STR_LEN("member"), &member);
    member = object_value(member);
    if member != 0 {
        let mu: u64 = 0;
        sa_json_object_get(member, STR_PTR("user"), STR_LEN("user"), &mu);
        mu = object_value(mu);
        if mu != 0 { sa_json_object_get_string(mu, STR_PTR("id"), STR_LEN("id"), &uid_ptr, &uid_len); };
    };
    if uid_len == 0 {
        let du: u64 = 0;
        sa_json_object_get(input, STR_PTR("user"), STR_LEN("user"), &du);
        du = object_value(du);
        if du != 0 { sa_json_object_get_string(du, STR_PTR("id"), STR_LEN("id"), &uid_ptr, &uid_len); };
    };
    if !has_required || uid_len == 0 {
        ephemeral(out, STR_PTR("required 码或 Discord 用户信息缺失。"), STR_LEN("required 码或 Discord 用户信息缺失。"));
        return;
    };
    // store.issueLicense(required, discordUserId) — TS try/catch -> ephemeral(error.message).
    let lic = License { key: StrField { bytes: [0u8; 512], len: 0 }, user_id: StrField { bytes: [0u8; 512], len: 0 }, machine_hash: StrField { bytes: [0u8; 512], len: 0 }, issued_at: 0, expires_at: 0, revoked: false };
    let err = ByteBuf { bytes: [0u8; 40960], len: 0 };
    if license_store_issue_license(store, &lic, &err, req_ptr, req_len, uid_ptr, uid_len, (sa_time_unix_ms() as u64)) != 0 {
        let __ap297: ptr = PTR_NULL();
        PTR_BYTE_ADD(__ap297, err.bytes, 0);
        ephemeral(out, __ap297, err.len);
        return;
    };
    // Response lines joined with "\n"; expiry via Date#toISOString.
    // toISOString (UTC ISO-8601) rebound to sa_time_iso_from_unix_ms
    // (time.sai), whose handle uses the fmt buffer accessors.
    let iso = ByteBuf { bytes: [0u8; 40960], len: 0 };
    let __iso_h = sa_time_iso_from_unix_ms(lic.expires_at as i64);
    if __iso_h != 0 {
        let __iso_p: ptr = sa_fmt_buffer_data(__iso_h);
        buf_append_lit(&iso, __iso_p, sa_fmt_buffer_len(__iso_h));
        sa_fmt_buffer_free(__iso_h);
    };
    let content = ByteBuf { bytes: [0u8; 40960], len: 0 };
    buf_append_lit(&content, STR_PTR("你的 Codex Ultra 免费模型密钥：\n`"), STR_LEN("你的 Codex Ultra 免费模型密钥：\n`"));
    let __ap298: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap298, lic.key.bytes, 0);
    buf_append_lit(&content, __ap298, lic.key.len);
    buf_append_lit(&content, STR_PTR("`\n有效期至："), STR_LEN("`\n有效期至："));
    buf_append_buf(&content, &iso);
    buf_append_lit(&content, STR_PTR("\n密钥仅绑定申请时的 Windows 机器，请勿公开分享。"), STR_LEN("\n密钥仅绑定申请时的 Windows 机器，请勿公开分享。"));
    let __ap299: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap299, content.bytes, 0);
    ephemeral(out, __ap299, content.len);
}
