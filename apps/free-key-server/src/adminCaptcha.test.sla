// Converted 1:1 from apps/free-key-server/src/adminCaptcha.test.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "sa_std/ptr.sa"
@import "sa_std/string.sa"
@import "sa_std/ts_string.sa"
@import "adminCaptcha.sla"

// DEFECT: node:test + node:assert/strict have no SLA counterpart (see
// adminAuth.test.sla header). assert.match on the data URL prefix binds
// to sa_string_index_of(...) == 0 (sa_std string.sai, String.startsWith).

fn expect_true(fails: &u64, cond: bool) -> void { if !cond { *fails = *fails + 1; }; }

fn blank_store() -> AdminCaptchaStore {
    return AdminCaptchaStore { records: [CaptchaRecord { id: [0u8; 64], id_len: 0, answer_hash: [0u8; 32], address: [0u8; 256], address_len: 0, expires_at: 0 }; 2000], len: 0 };
}

fn test_captcha_lifecycle(fails: &u64) -> void {
    let store = blank_store();
    let challenge = CaptchaChallenge { captcha_id: [0u8; 64], captcha_id_len: 0, expires_at: 0 };
    let image = ByteBuf { bytes: [0u8; 40960], len: 0 };
    admin_captcha_create(&store, &challenge, &image, STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"), 1000);
    // assert.match(challenge.imageDataUrl, /^data:image\/png;base64,/)
    expect_true(fails, sa_string_index_of(&image.bytes, image.len, STR_PTR("data:image/png;base64,"), STR_LEN("data:image/png;base64,")) == 0);
    // wrong answer twice -> false, false
    expect_true(fails, !admin_captcha_consume(&store, challenge.captcha_id, challenge.captcha_id_len, STR_PTR("WRONG"), STR_LEN("WRONG"), STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"), 2000));
    expect_true(fails, !admin_captcha_consume(&store, challenge.captcha_id, challenge.captcha_id_len, STR_PTR("WRONG"), STR_LEN("WRONG"), STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"), 2001));
    // a challenge bound to 127.0.0.1 cannot be consumed from 10.0.0.1
    let other = CaptchaChallenge { captcha_id: [0u8; 64], captcha_id_len: 0, expires_at: 0 };
    let image2 = ByteBuf { bytes: [0u8; 40960], len: 0 };
    admin_captcha_create(&store, &other, &image2, STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"), 3000);
    expect_true(fails, !admin_captcha_consume(&store, other.captcha_id, other.captcha_id_len, STR_PTR("WRONG"), STR_LEN("WRONG"), STR_PTR("10.0.0.1"), STR_LEN("10.0.0.1"), 3001));
    // expired challenge (created at 4000, consumed at +5min) -> false
    // DEFECT: the TS test only ever consumes with the WRONG answer, so
    // the success/consumed-once path is never exercised there either;
    // expiry is asserted through the same wrong-answer call shape.
    let expired = CaptchaChallenge { captcha_id: [0u8; 64], captcha_id_len: 0, expires_at: 0 };
    let image3 = ByteBuf { bytes: [0u8; 40960], len: 0 };
    admin_captcha_create(&store, &expired, &image3, STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"), 4000);
    expect_true(fails, !admin_captcha_consume(&store, expired.captcha_id, expired.captcha_id_len, STR_PTR("WRONG"), STR_LEN("WRONG"), STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"), 4000 + 5 * 60000));
}

fn run_all_tests() -> u64 {
    let fails: u64 = 0;
    test_captcha_lifecycle(&fails);
    return fails;
}
