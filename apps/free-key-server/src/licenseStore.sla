// TS: import Database from "better-sqlite3"; (see types.d.sla)
// DEFECT: better-sqlite3 synchronous API (prepare/bind/run/get/all, pragma,
// exec, transaction closures) has no sa_std surface; the calls below name
// intent externs sa_sqlite_open/close/exec/prepare/bind_text/bind_int/
// bind_null/step/column_text/column_int/column_is_null/finalize/changes/
// begin/commit/rollback. All SQL text is preserved verbatim from the TS.
// DEFECT: db.transaction(() => {...})() closures -> explicit
// begin/commit/rollback around the sequential body.
// DEFECT: class with `private readonly config` -> the store struct carries
// copies of the config values it reads (set by license_store_new).
// DEFECT: Record<string, unknown> returns (getSettings/updateSettings) are
// built as JSON text; unknown inputs arrive as sa_json node handles.
// DEFECT: throw new Error(...) -> i32 status + err ByteBuf (0 = ok).

fn alphanumeric() -> ptr { return STR_PTR("ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789"); }
fn alphanumeric_len() -> u64 { return 57; }

