// Converted 1:1 from apps/free-key-server/src/adminAuth.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "sa_std/ptr.sa"
@import "sa_std/string.sa"
@import "sa_std/crypto.sai"
@import "sa_std/encoding/json.sai"
@import "config.sla"

// TS: import { createHmac, scryptSync, timingSafeEqual } from "node:crypto";
// DEFECT: node:crypto has no direct sa_std surface for scrypt / HMAC-SHA256 /
// base64url / timingSafeEqual as used here; calls below name the intended
// std externs (sa_crypto_*) which do not exist yet — fix phase must add them
// to sa_std or a crypto plugin. JSON.stringify/parse approximated via
// sa_json_* on text buffers.
// DEFECT: variable-length hex/base64url strings are carried as (ptr,len)
// slices into caller-provided buffers; TS string return semantics are kept
// via out-buffer + out-len parameters.

// Shared hex helper (Buffer.from(x, "hex") equivalent): decodes src_len/2
// bytes into dst. Caller guarantees the input passed the hex-digit scan.
fn hex_decode(src_ptr: ptr, src_len: u64, dst: ptr) -> void {
    let n = src_len / 2;
    for i in 0..n {
        let hi: u8 = 0;
        let lo: u8 = 0;
        PTR_BYTE_AT(hi, src_ptr, i * 2);
        PTR_BYTE_AT(lo, src_ptr, i * 2 + 1);
        let hv: u64 = 0;
        if hi >= 48 && hi <= 57 { hv = (hi - 48) as u64; } else if hi >= 97 && hi <= 102 { hv = (hi - 87) as u64; } else if hi >= 65 && hi <= 70 { hv = (hi - 55) as u64; };
        let lv: u64 = 0;
        if lo >= 48 && lo <= 57 { lv = (lo - 48) as u64; } else if lo >= 97 && lo <= 102 { lv = (lo - 87) as u64; } else if lo >= 65 && lo <= 70 { lv = (lo - 55) as u64; };
        let __bs4: ptr = PTR_NULL(); PTR_BYTE_ADD(__bs4, dst, i); PTR_WRITE_U8(__bs4, ((hv << 4) | lv) as u8);
    }
}

// Result bundle for read_admin_session (TS returns { username } | null).
struct AdminSession {
    found: bool,
    username: [u8; 256],
    username_len: u64,
}

// Hex nibble for the hex->raw digest decode below.
fn hex_nibble(c: u8) -> u64 {
    if c >= 97 && c <= 102 { return (c - 87) as u64; };
    if c >= 65 && c <= 70 { return (c - 55) as u64; };
    if c >= 48 && c <= 57 { return (c - 48) as u64; };
    return 0;
}

// createHmac("sha256", key).digest() — rebound to sa_hmac_sha256_hex
// (crypto.sai); the std surface returns hex, decoded back to the
// raw 32 bytes the session format signs with.
fn hmac_sha256_raw(key_ptr: ptr, key_len: u64, msg_ptr: ptr, msg_len: u64, out32: ptr) -> void {
    let hexbuf = [0u8; 64];
    let __ap_hx: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap_hx, hexbuf, 0);
    let hex_len: u64 = 0;
    sa_hmac_sha256_hex(key_ptr, key_len, msg_ptr, msg_len, __ap_hx, 64, &hex_len);
    for i in 0..32 {
        let c1: u8 = 0;
        PTR_BYTE_AT(c1, __ap_hx, i * 2);
        let c2: u8 = 0;
        PTR_BYTE_AT(c2, __ap_hx, i * 2 + 1);
        let b = ((hex_nibble(c1) << 4) | hex_nibble(c2)) as u8;
        let __wp: ptr = PTR_NULL();
        PTR_BYTE_ADD(__wp, out32, i);
        PTR_WRITE_U8(__wp, b);
    }
}

// timingSafeEqual — local constant-time compare (0 = equal).
fn timing_safe_equal(a: ptr, b: ptr, len: u64) -> i32 {
    let diff: u64 = 0;
    for i in 0..len {
        let x: u8 = 0;
        PTR_BYTE_AT(x, a, i);
        let y: u8 = 0;
        PTR_BYTE_AT(y, b, i);
        diff = diff | ((x ^ y) as u64);
    }
    if diff == 0 { return 0; };
    return 1;
}

// Buffer.toString("base64url") — local implementation (URL-safe
// alphabet, no padding), same as adminTotp.sla's copy.
fn base64url_encode(data: ptr, data_len: u64, out: &ByteBuf) -> void {
    buf_reset(out);
    let alpha = STR_PTR("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_");
    let i: u64 = 0;
    while i + 3 <= data_len {
        let b0: u8 = 0;
        PTR_BYTE_AT(b0, data, i);
        let b1: u8 = 0;
        PTR_BYTE_AT(b1, data, i + 1);
        let b2: u8 = 0;
        PTR_BYTE_AT(b2, data, i + 2);
        let n = ((b0 as u64) << 16) | ((b1 as u64) << 8) | (b2 as u64);
        for k in 0..4 {
            let ch: u8 = 0;
            PTR_BYTE_AT(ch, alpha, (n >> (18 - k * 6)) & 63);
            buf_append_byte(out, ch);
        }
        i = i + 3;
    }
    let rem = data_len - i;
    if rem == 1 {
        let b0: u8 = 0;
        PTR_BYTE_AT(b0, data, i);
        let n = (b0 as u64) << 16;
        for k in 0..2 {
            let ch: u8 = 0;
            PTR_BYTE_AT(ch, alpha, (n >> (18 - k * 6)) & 63);
            buf_append_byte(out, ch);
        }
    };
    if rem == 2 {
        let b0: u8 = 0;
        PTR_BYTE_AT(b0, data, i);
        let b1: u8 = 0;
        PTR_BYTE_AT(b1, data, i + 1);
        let n = ((b0 as u64) << 16) | ((b1 as u64) << 8);
        for k in 0..3 {
            let ch: u8 = 0;
            PTR_BYTE_AT(ch, alpha, (n >> (18 - k * 6)) & 63);
            buf_append_byte(out, ch);
        }
    };
}

// Buffer.from(s, "base64url") — local implementation; 1 on an
// invalid character (TS throws).
fn base64url_decode(data: ptr, data_len: u64, out: &ByteBuf) -> i32 {
    buf_reset(out);
    let value: u64 = 0;
    let bits: u64 = 0;
    for i in 0..data_len {
        let ch: u8 = 0;
        PTR_BYTE_AT(ch, data, i);
        if ch == 61 { break; };
        let idx: u64 = 4294967295;
        if ch >= 65 && ch <= 90 { idx = (ch - 65) as u64; };
        if ch >= 97 && ch <= 122 { idx = (ch - 71) as u64; };
        if ch >= 48 && ch <= 57 { idx = (ch + 4) as u64; };
        if ch == 45 { idx = 62; };
        if ch == 95 { idx = 63; };
        if idx == 4294967295 { return 1; };
        value = (value << 6) | idx;
        bits = bits + 6;
        if bits >= 8 {
            let b = (value >> (bits - 8)) & 255;
            buf_append_byte(out, b as u8);
            bits = bits - 8;
        };
    }
    return 0;
}

// TS: export function verifyAdminPasswordHash(password: string, encoded: string): boolean
// encoded format: "scrypt:<salt>:<hexHash>".
fn verify_admin_password_hash(pw_ptr: ptr, pw_len: u64, enc_ptr: ptr, enc_len: u64) -> bool {
    // split(":") — approximated by scanning for the two ':' separators.
    let c1: u64 = 4294967295;
    let c2: u64 = 4294967295;
    for i in 0..enc_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, enc_ptr, i);
        if b == 58 {
            if c1 == 4294967295 { c1 = i; } else if c2 == 4294967295 { c2 = i; };
        };
    }
    if c1 == 4294967295 || c2 == 4294967295 { return false; };
    // algorithm !== "scrypt" -> false
    if c1 != 6 { return false; };
    if !bytes_eq_str(enc_ptr, 6, STR_PTR("scrypt"), STR_LEN("scrypt")) { return false; };
    let salt_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(salt_ptr, enc_ptr, c1 + 1);
    let salt_len = c2 - c1 - 1;
    let hex_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(hex_ptr, enc_ptr, c2 + 1);
    let hex_len = enc_len - c2 - 1;
    if salt_len == 0 || hex_len == 0 { return false; };
    // /^[a-f0-9]+$/i.test(hexHash)
    // DEFECT: regex — approximated by a manual hex-digit scan.
    for j in 0..hex_len {
        let hb: u8 = 0;
        PTR_BYTE_AT(hb, hex_ptr, j);
        let is_hex = (hb >= 48 && hb <= 57) || (hb >= 97 && hb <= 102) || (hb >= 65 && hb <= 70);
        if !is_hex { return false; };
    }
    // DEFECT: Buffer.from(hexHash, "hex") + scryptSync + timingSafeEqual.
    let expected = [0u8; 128];
    let expected_len = hex_len / 2;
    if expected_len < 32 || expected_len > 128 { return false; };
    let __ap260: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap260, expected, 0);
    hex_decode(hex_ptr, hex_len, __ap260);
    // DEFECT (B-class, four-source verdict): scrypt has NO
    // counterpart in sala docs, SLA demos/tests, the sa_plugin_sla
    // corpus, or the sa_std inventory — password verification is
    // UNSUPPORTED in this build and fails closed (false) at the
    // derivation step; the format/hex validation above is genuine
    // and the timing-safe compare exists locally for the session
    // path. Registered in FIX_OTHER_APPS.md.
    return false;
}

// TS: export function createAdminSession(username: string, secret: string, now = Date.now()): string
// Returns "<base64url(JSON {username, exp})>.<base64url(HMAC-SHA256)>".
fn create_admin_session(out: &ByteBuf, un_ptr: ptr, un_len: u64, sec_ptr: ptr, sec_len: u64, now_ms: u64) {
    // DEFECT: Date.now() default parameter — caller passes now_ms explicitly.
    let exp = now_ms + 8 * 60 * 60000;
    // JSON.stringify({ username, exp }) approximated by manual assembly.
    let payload_json = ByteBuf { bytes: [0u8; 40960], len: 0 };
    buf_append_lit(&payload_json, STR_PTR("{\"username\":\""), STR_LEN("{\"username\":\""));
    buf_append_escaped(&payload_json, un_ptr, un_len);
    buf_append_lit(&payload_json, STR_PTR("\",\"exp\":"), STR_LEN("\",\"exp\":"));
    buf_append_u64(&payload_json, exp);
    buf_append_lit(&payload_json, STR_PTR("}"), STR_LEN("}"));
    // DEFECT: Buffer base64url encode + createHmac("sha256") — MISSING std
    // externs sa_crypto_base64url_encode / sa_crypto_hmac_sha256.
    let payload = ByteBuf { bytes: [0u8; 40960], len: 0 };
    let __ap_pj: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap_pj, payload_json.bytes, 0);
    base64url_encode(__ap_pj, payload_json.len, &payload);
    let sig_raw = [0u8; 32];
    let __ap_pl: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap_pl, payload.bytes, 0);
    let __ap_sr: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap_sr, sig_raw, 0);
    hmac_sha256_raw(sec_ptr, sec_len, __ap_pl, payload.len, __ap_sr);
    let sig_enc = ByteBuf { bytes: [0u8; 40960], len: 0 };
    base64url_encode(__ap_sr, 32, &sig_enc);
    buf_reset(out);
    buf_append_buf(out, &payload);
    buf_append_lit(out, STR_PTR("."), STR_LEN("."));
    buf_append_buf(out, &sig_enc);
}

// TS: export function readAdminSession(token: string, secret: string, now = Date.now()): { username: string } | null
fn read_admin_session(out: &AdminSession, tok_ptr: ptr, tok_len: u64, sec_ptr: ptr, sec_len: u64, now_ms: u64) -> void {
    out.found = false;
    out.username_len = 0;
    // token.split(".") — first '.' separates payload and signature.
    let dot: u64 = 4294967295;
    for i in 0..tok_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, tok_ptr, i);
        if b == 46 { dot = i; break; };
    }
    if dot == 4294967295 || dot == 0 || dot + 1 >= tok_len { return; };
    let sig_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(sig_ptr, tok_ptr, dot + 1);
    let sig_len = tok_len - dot - 1;
    // Recompute expected signature and compare in constant time.
    // DEFECT: same missing sa_crypto_hmac_sha256 / base64url externs.
    let sig_raw = [0u8; 32];
    let __ap_sr2: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap_sr2, sig_raw, 0);
    hmac_sha256_raw(sec_ptr, sec_len, tok_ptr, dot, __ap_sr2);
    let expected = ByteBuf { bytes: [0u8; 40960], len: 0 };
    base64url_encode(__ap_sr2, 32, &expected);
    if sig_len != expected.len { return; };
    let __ap_ex: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap_ex, expected.bytes, 0);
    if timing_safe_equal(sig_ptr, __ap_ex, sig_len) != 0 { return; };
    // Decode payload JSON and check username/exp.
    // DEFECT: Buffer.from(payload, "base64url").toString("utf8") + JSON.parse
    // with a typed cast — approximated with sa_crypto_base64url_decode +
    // sa_json_parse.
    let payload = ByteBuf { bytes: [0u8; 40960], len: 0 };
    if base64url_decode(tok_ptr, dot, &payload) != 0 { return; };
    let __ap_pay: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap_pay, payload.bytes, 0);
    let doc = sa_json_parse(__ap_pay, payload.len);
    if doc == 0 { return; };
    let un_ptr: ptr = PTR_NULL();
    let un_len: u64 = 0;
    let exp: u64 = 0;
    if sa_json_object_get_string(doc, STR_PTR("username"), STR_LEN("username"), &un_ptr, &un_len) != 0 { return; };
    if sa_json_object_get_i64(doc, STR_PTR("exp"), STR_LEN("exp"), &exp) != 0 { return; };
    if exp <= now_ms { return; };
    if un_len > 256 { return; };
    for k in 0..un_len {
        let ub: u8 = 0;
        PTR_BYTE_AT(ub, un_ptr, k);
        out.username[k] = ub;
    }
    out.username_len = un_len;
    out.found = true;
}
