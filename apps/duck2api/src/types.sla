// Converted 1:1 from apps/duck2api/src/types.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "sa_std/ptr.sa"
@import "sa_std/string.sa"
@import "sa_std/encoding/json.sai"
@import "sa_std/math.sai"
@import "sa_std/fmt.sai"

// Shared conversion prelude (fix phase): ByteBuf + buf_* helper family.
// The bulk conversion emitted calls to this family in every file of the
// tree but never materialized the definitions; they live here once.
struct ByteBuf {
    bytes: [u8; 40960],
    len: u64,
}

fn buf_reset(b: &ByteBuf) -> void {
    b.len = 0;
}

fn buf_append_lit(b: &ByteBuf, src: ptr, src_len: u64) -> void {
    for i in 0..src_len {
        if b.len < 40960 {
            let v: u8 = 0;
            PTR_BYTE_AT(v, src, i);
            b.bytes[b.len] = v;
            b.len = b.len + 1;
        };
    }
}

fn buf_append_buf(b: &ByteBuf, src: &ByteBuf) -> void {
    for i in 0..src.len {
        if b.len < 40960 {
            b.bytes[b.len] = src.bytes[i];
            b.len = b.len + 1;
        };
    }
}

fn buf_append_byte(b: &ByteBuf, v: u8) -> void {
    if b.len < 40960 {
        b.bytes[b.len] = v;
        b.len = b.len + 1;
    };
}

fn buf_append_escaped(b: &ByteBuf, src: ptr, src_len: u64) -> void {
    for i in 0..src_len {
        let v: u8 = 0;
        PTR_BYTE_AT(v, src, i);
        if v == 34 {
            buf_append_lit(b, STR_PTR("\\\""), STR_LEN("\\\""));
        } else if v == 92 {
            buf_append_lit(b, STR_PTR("\\\\"), STR_LEN("\\\\"));
        } else if v == 10 {
            buf_append_lit(b, STR_PTR("\\n"), STR_LEN("\\n"));
        } else if v == 13 {
            buf_append_lit(b, STR_PTR("\\r"), STR_LEN("\\r"));
        } else if v == 9 {
            buf_append_lit(b, STR_PTR("\\t"), STR_LEN("\\t"));
        } else if v == 8 {
            buf_append_lit(b, STR_PTR("\\b"), STR_LEN("\\b"));
        } else if v == 12 {
            buf_append_lit(b, STR_PTR("\\f"), STR_LEN("\\f"));
        } else if v < 32 {
            buf_append_lit(b, STR_PTR("\\u00"), STR_LEN("\\u00"));
            let hi = (v >> 4) & 15;
            let lo = v & 15;
            let hc: u8 = 0;
            if hi < 10 {
                hc = 48 + hi;
            } else {
                hc = 87 + hi;
            };
            let lc: u8 = 0;
            if lo < 10 {
                lc = 48 + lo;
            } else {
                lc = 87 + lo;
            };
            buf_append_byte(b, hc);
            buf_append_byte(b, lc);
        } else {
            buf_append_byte(b, v);
        };
    }
}

fn buf_append_u64(b: &ByteBuf, v: u64) -> void {
    if v == 0 {
        buf_append_byte(b, 48);
        return;
    };
    let digits: [u8; 20] = [0; 20];
    let n: u64 = 0;
    let x = v;
    while x > 0 {
        digits[n] = (48 + (x % 10)) as u8;
        n = n + 1;
        x = x / 10;
    }
    let i = n;
    while i > 0 {
        i = i - 1;
        buf_append_byte(b, digits[i]);
    }
}

fn buf_append_hex_u64(b: &ByteBuf, v: u64) -> void {
    if v == 0 {
        buf_append_byte(b, 48);
        return;
    };
    let digits: [u8; 16] = [0; 16];
    let n: u64 = 0;
    let x = v;
    while x > 0 {
        let d = (x & 15) as u8;
        if d < 10 {
            digits[n] = 48 + d;
        } else {
            digits[n] = 87 + d;
        };
        n = n + 1;
        x = x >> 4;
    }
    let i = n;
    while i > 0 {
        i = i - 1;
        buf_append_byte(b, digits[i]);
    }
}

fn buf_append_f64(b: &ByteBuf, v: f64) -> void {
    // sa_fmt_f64 fixed-precision handle, then strip trailing zeros/dot
    // (JS Number#toString has no fixed trailing zeros; approximation is
    // recorded in the fix log).
    let h = sa_fmt_f64(v, 6);
    let p: ptr = sa_fmt_buffer_data(h);
    let n = sa_fmt_buffer_len(h);
    let end = n;
    let dot = false;
    for i in 0..n {
        let c: u8 = 0;
        PTR_BYTE_AT(c, p, i);
        if c == 46 { dot = true; };
    }
    if dot {
        while end > 0 {
            let c: u8 = 0;
            PTR_BYTE_AT(c, p, end - 1);
            if c == 48 {
                end = end - 1;
            } else {
                if c == 46 { end = end - 1; };
                break;
            };
        }
    };
    buf_append_lit(b, p, end);
    let fr = sa_fmt_buffer_free(h);
}

fn buf_to_lower(b: &ByteBuf) -> void {
    for i in 0..b.len {
        let c = b.bytes[i];
        if c >= 65 && c <= 90 {
            b.bytes[i] = c + 32;
        };
    }
}

fn buf_to_upper(b: &ByteBuf) -> void {
    for i in 0..b.len {
        let c = b.bytes[i];
        if c >= 97 && c <= 122 {
            b.bytes[i] = c - 32;
        };
    }
}

fn buf_is_ws(c: u8) -> bool {
    return c == 32 || c == 9 || c == 13 || c == 10;
}

fn buf_trim(b: &ByteBuf) -> void {
    let start: u64 = 0;
    while start < b.len && buf_is_ws(b.bytes[start]) {
        start = start + 1;
    }
    let end = b.len;
    while end > start && buf_is_ws(b.bytes[end - 1]) {
        end = end - 1;
    }
    if start > 0 {
        let w: u64 = 0;
        let r = start;
        while r < end {
            b.bytes[w] = b.bytes[r];
            w = w + 1;
            r = r + 1;
        }
    };
    b.len = end - start;
}

fn buf_drop_front(b: &ByteBuf, n: u64) -> void {
    if n >= b.len {
        b.len = 0;
        return;
    };
    let w: u64 = 0;
    let r = n;
    while r < b.len {
        b.bytes[w] = b.bytes[r];
        w = w + 1;
        r = r + 1;
    }
    b.len = b.len - n;
}

fn bytes_eq(p1: ptr, l1: u64, p2: ptr, l2: u64) -> bool {
    if l1 != l2 { return false; };
    for i in 0..l1 {
        let a: u8 = 0;
        PTR_BYTE_AT(a, p1, i);
        let c: u8 = 0;
        PTR_BYTE_AT(c, p2, i);
        if a != c { return false; };
    }
    return true;
}

fn bytes_eq_str(p: ptr, l: u64, lit: ptr, lit_len: u64) -> bool {
    return bytes_eq(p, l, lit, lit_len);
}

fn find_byte(p: ptr, l: u64, v: u8) -> u64 {
    for i in 0..l {
        let c: u8 = 0;
        PTR_BYTE_AT(c, p, i);
        if c == v { return i; };
    }
    return l;
}

fn find_sub_buf(p: ptr, l: u64, np: ptr, nl: u64) -> u64 {
    if nl == 0 { return 0; };
    if nl > l { return l; };
    let last = l - nl;
    let i: u64 = 0;
    while i <= last {
        let ok = true;
        for j in 0..nl {
            let a: u8 = 0;
            PTR_BYTE_AT(a, p, i + j);
            let c: u8 = 0;
            PTR_BYTE_AT(c, np, j);
            if a != c { ok = false; };
        }
        if ok { return i; };
        i = i + 1;
    }
    return l;
}

fn starts_with(p: ptr, l: u64, pp: ptr, pl: u64) -> bool {
    if pl > l { return false; };
    for i in 0..pl {
        let a: u8 = 0;
        PTR_BYTE_AT(a, p, i);
        let c: u8 = 0;
        PTR_BYTE_AT(c, pp, i);
        if a != c { return false; };
    }
    return true;
}

// ts/fmt handle layout: { data ptr @ +0, len u64 @ +8 } (16-byte cell).
fn sa_handle_data(h: ptr) -> ptr {
    let out: ptr = h;
    PTR_READ(out, h);
    return out;
}

fn sa_handle_len(h: ptr) -> u64 {
    let p8: ptr = h;
    PTR_BYTE_ADD(p8, h, 8);
    let v: u64 = 0;
    PTR_READ_U64(v, p8);
    return v;
}


// StrField: fixed-capacity (512) string field, shared by the duck2api tree
// (same shape as free-key-server's config.sla definition).
struct StrField {
    bytes: [u8; 512],
    len: u64,
}

fn str_field_set(f: &StrField, src_ptr: ptr, src_len: u64) -> void {
    f.len = 0;
    for i in 0..src_len {
        if f.len < 512 {
            let b: u8 = 0;
            PTR_BYTE_AT(b, src_ptr, i);
            f.bytes[f.len] = b;
            f.len = f.len + 1;
        };
    }
}

// --- ts_* local SLA implementations -------------------------------------
// @ts_str_*/@ts_math_* in sa_std are SA-layer functions (tsgosa surface);
// they are NOT callable from SLA source (verified by probe: Undefined
// call). The helpers below reproduce the exact semantics used by this
// tree's call sites under the same names.
fn ts_str_equals(ap: ptr, al: u64, bp: ptr, bl: u64) -> i32 {
    if bytes_eq(ap, al, bp, bl) { return 1; };
    return 0;
}

fn ts_math_minmax(a: i32, b: i32, ismax: i32) -> i32 {
    if ismax == 1 {
        if a > b { return a; };
        return b;
    };
    if a < b { return a; };
    return b;
}

fn ts_math_rounding(x: f64, op: i32) -> i32 {
    if op == 0 {
        let f = sa_math_floor(x);
        return f as i32;
    };
    if op == 1 {
        let c = sa_math_ceil(x);
        return c as i32;
    };
    if op == 2 {
        let r = sa_math_floor(x + 0.5);
        return r as i32;
    };
    return x as i32;
}

// --- sa_json_* intent-name adapters (real surface: encoding/json.sai) --
fn sa_json_object_has(node: u64, kp: ptr, kl: u64) -> bool {
    let h: u64 = 0;
    let st = sa_json_object_get(node, kp, kl, &h);
    return st == 0;
}

fn sa_json_number_value(node: u64) -> f64 {
    let v: f64 = 0.0;
    let st = sa_json_as_f64(node, &v);
    return v;
}

fn sa_json_bool_value(node: u64) -> bool {
    let v: bool = false;
    let st = sa_json_as_bool(node, &v);
    return v;
}

fn sa_json_object_len(node: u64) -> u64 {
    let c: u64 = 0;
    let st = sa_json_value_count(node, &c);
    return c;
}

fn sa_json_object_get_number(node: u64, kp: ptr, kl: u64) -> f64 {
    let v: f64 = 0.0;
    let st = sa_json_object_get_f64(node, kp, kl, &v);
    return v;
}

// TS: import { z } from "zod";
// DEFECT: zod runtime schemas (z.object/.optional/.default/.union/.transform/
// .passthrough/.min) have no SLA counterpart. The schemas below are kept as
// struct shapes + field-name constants; validation/coercion semantics
// (content nullish -> "", defaults stream=false, reasoning_effort="") must
// be implemented by the JSON parse layer in the fix phase. Field names keep
// Go JSON tags (snake_case), as in the TS source.

// z.infer<typeof messageContentPartSchema>
struct MessageContentPart {
    type_len: u64,        // type: string
    has_text: bool,       // text?: string
    text_len: u64,
    has_image_url: bool,  // image_url?: { url: string }
    image_url_len: u64,
}

// z.infer<typeof apiMessageSchema>; content is string | part[] (nullish -> "")
struct ApiMessage {
    role_len: u64,
    content_is_parts: bool,
    content_text_len: u64,
    parts_len: u64,       // parts stored in a JSON text buffer (dynamic)
}

// z.infer<typeof apiRequestSchema>
struct ApiRequest {
    model_len: u64,
    messages_len: u64,    // array of ApiMessage (dynamic JSON buffer)
    stream: bool,         // default false
    reasoning_effort_len: u64, // default ""
    has_reasoning: bool,  // reasoning?: string | { effort?: string }
    has_web_search: bool,
    web_search: bool,
    file_ids_len: u64,    // file_ids?: string[]
}

// z.infer<typeof imageGenerationSchema>
struct ImageGenerationRequest {
    prompt_len: u64,      // default ""
    has_model: bool,
    has_n: bool,
    n: f64,
    has_size: bool,
    has_response_format: bool,
    has_quality: bool,
    has_style: bool,
    reasoning_effort_len: u64, // default ""
    has_reasoning: bool,
}

// TS: export interface ModelEntry { id: string; object: "model"; created: number; owned_by: string }
struct ModelEntry {
    id: [u8; 64],
    id_len: u64,
    created: u64,
    owned_by: [u8; 64],
    owned_by_len: u64,
}

// TS: export const MODEL_IDS = [...] as const (7 entries).
fn model_id_count() -> u64 { return 7; }

fn model_id_at(idx: u64, out_len: &u64) -> ptr {
    if idx == 0 { *out_len = STR_LEN("gpt-6-luna"); return STR_PTR("gpt-6-luna"); };
    if idx == 1 { *out_len = STR_LEN("gpt-5.4-mini"); return STR_PTR("gpt-5.4-mini"); };
    if idx == 2 { *out_len = STR_LEN("gpt-5.4-nano"); return STR_PTR("gpt-5.4-nano"); };
    if idx == 3 { *out_len = STR_LEN("tinfoil/gpt-oss-120b"); return STR_PTR("tinfoil/gpt-oss-120b"); };
    if idx == 4 { *out_len = STR_LEN("tinfoil/gemma4-31b"); return STR_PTR("tinfoil/gemma4-31b"); };
    if idx == 5 { *out_len = STR_LEN("claude-haiku-4-5"); return STR_PTR("claude-haiku-4-5"); };
    *out_len = STR_LEN("mistral-small-2603");
    return STR_PTR("mistral-small-2603");
}

// TS: export function listModels(): { object: "list"; data: ModelEntry[] }
// Builds the JSON text of the model list into out.
fn list_models(out: &ByteBuf) -> void {
    buf_reset(out);
    buf_append_lit(out, STR_PTR("{\"object\":\"list\",\"data\":["), STR_LEN("{\"object\":\"list\",\"data\":["));
    for i in 0..7 {
        if i > 0 { buf_append_lit(out, STR_PTR(","), STR_LEN(",")); };
        let id_len: u64 = 0;
        let id_ptr = model_id_at(i, &id_len);
        buf_append_lit(out, STR_PTR("{\"id\":\""), STR_LEN("{\"id\":\""));
        buf_append_lit(out, id_ptr, id_len);
        buf_append_lit(out, STR_PTR("\",\"object\":\"model\",\"created\":1685474247,\"owned_by\":\"duckduckgo\"}"), STR_LEN("\",\"object\":\"model\",\"created\":1685474247,\"owned_by\":\"duckduckgo\"}"));
    }
    buf_append_lit(out, STR_PTR("]}"), STR_LEN("]}"));
}

// TS: export function messageText(content: ApiMessage["content"]): string
// content is a JSON node handle: string node -> its text; array node ->
// concatenation of each part's "text" (p?.text ?? "").
fn message_text(out: &ByteBuf, content_node: u64) -> void {
    buf_reset(out);
    // DEFECT: TS typeof/Array.isArray dispatch on a dynamic value; SLA side
    // branches on the JSON node kind via sa_json_kind (fix phase to wire).
    let kind = sa_json_kind_of(content_node);
    if kind == 1 {
        let p: ptr = sa_json_string_ptr(content_node);
        let l: u64 = sa_json_string_len(content_node);
        buf_append_lit(out, p, l);
        return;
    };
    if kind != 2 { return; };
    let idx: u64 = 0;
    while 1 == 1 {
        let part: u64 = 0;
        if sa_json_array_get(content_node, idx, &part) != 0 { break; };
        let tp: ptr = PTR_NULL();
        let tl: u64 = 0;
        if part != 0 {
            sa_json_object_get_string(part, STR_PTR("text"), STR_LEN("text"), &tp, &tl);
        };
        if tl > 0 { buf_append_lit(out, tp, tl); };
        idx = idx + 1;
    }
}

// TS: export function parseReasoningEffort(raw: unknown): string
// string -> itself; object with string .effort -> effort; else "".
fn parse_reasoning_effort(out: &ByteBuf, raw_node: u64) -> void {
    buf_reset(out);
    // DEFECT: `unknown` + runtime type tests — approximated via JSON node kind.
    let kind = sa_json_kind_of(raw_node);
    if kind == 1 {
        let p: ptr = sa_json_string_ptr(raw_node);
        let l: u64 = sa_json_string_len(raw_node);
        buf_append_lit(out, p, l);
        return;
    };
    if kind == 3 {
        let ep: ptr = PTR_NULL();
        let el: u64 = 0;
        if sa_json_object_get_string(raw_node, STR_PTR("effort"), STR_LEN("effort"), &ep, &el) == 0 {
            buf_append_lit(out, ep, el);
        };
    };
}

// TS: export function apiError(message: string, type = "invalid_request_error", code?: string)
// { error: { message, type, param: null, code } } as JSON text.
fn api_error(out: &ByteBuf, msg_ptr: ptr, msg_len: u64, type_ptr: ptr, type_len: u64, has_code: bool, code_ptr: ptr, code_len: u64) -> void {
    buf_reset(out);
    buf_append_lit(out, STR_PTR("{\"error\":{\"message\":\""), STR_LEN("{\"error\":{\"message\":\""));
    buf_append_escaped(out, msg_ptr, msg_len);
    buf_append_lit(out, STR_PTR("\",\"type\":\""), STR_LEN("\",\"type\":\""));
    buf_append_escaped(out, type_ptr, type_len);
    buf_append_lit(out, STR_PTR("\",\"param\":null,\"code\":"), STR_LEN("\",\"param\":null,\"code\":"));
    if has_code {
        buf_append_lit(out, STR_PTR("\""), STR_LEN("\""));
        buf_append_escaped(out, code_ptr, code_len);
        buf_append_lit(out, STR_PTR("\""), STR_LEN("\""));
    } else {
        buf_append_lit(out, STR_PTR("null"), STR_LEN("null"));
    };
    buf_append_lit(out, STR_PTR("}}"), STR_LEN("}}"));
}

fn bytes_eq3(a: ptr, b: ptr, l: u64) -> bool {
    return bytes_eq(a, l, b, l);
}
