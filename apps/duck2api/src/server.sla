// Converted 1:1 from apps/duck2api/src/server.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "sa_std/ptr.sa"
@import "sa_std/string.sa"
@import "sa_std/ts_math.sa"
@import "types.sla"
@import "duckgo/convert.sla"
@import "duckgo/upstream.sla"
@import "duckgo/stream.sla"
@import "duckgo/response.sla"
@import "duckgo/tokens.sla"
@import "duckgo/image.sla"

// DEFECT: Hono + @hono/zod-validator have no SLA counterpart. Routing,
// middleware and validation become explicit dispatch in
// duck2api_handle_request below; zod validation maps to
// shape checks (api_request_shape_ok below; types.sla carries the zod
// schemas as structs only) plus the manual checks the TS handlers
// perform. Responses go through intent externs (sa_http_respond_text /
// sa_http_respond_json / sa_http_set_header / sa_http_begin_sse /
// sa_http_end_sse); the ReadableStream start() callbacks become direct
// calls feeding the SSE sink. Module-level PREFIX / API_KEYS (read from
// process.env at import time) live in DuckApp, built by duck_app_new.

// TS: const PREFIX = process.env["PREFIX"] ?? "";
// TS: const API_KEYS = new Set((process.env["API_KEYS"] ?? process.env["API_KEY"] ?? "").split(",").map(trim).filter(Boolean))
struct DuckApp {
    prefix: StrField,
    api_keys: [StrField; 64],
    api_keys_len: u64,
    upstream: UpstreamState,
    cache: CacheStore,
}

fn duck_app_new(app: &DuckApp) -> void {
    sa_env_get_str(&app.prefix, STR_PTR("PREFIX"), STR_LEN("PREFIX"));
    app.api_keys_len = 0;
    let raw = ByteBuf { bytes: [0u8; 40960], len: 0 };
    sa_env_get(&raw, STR_PTR("API_KEYS"), STR_LEN("API_KEYS"));
    if raw.len == 0 { sa_env_get(&raw, STR_PTR("API_KEY"), STR_LEN("API_KEY")); };
    let start: u64 = 0;
    while start <= raw.len {
        let end = start;
        while end < raw.len && PTR_BYTE_AT(raw.bytes, end) != 44 { end = end + 1; };
        let piece = ByteBuf { bytes: [0u8; 40960], len: 0 };
        if end > start {
            let p: ptr = PTR_NULL();
            PTR_BYTE_ADD(p, raw.bytes, start);
            buf_append_lit(&piece, p, end - start);
        };
        buf_trim(&piece);
        if piece.len > 0 && app.api_keys_len < 64 {
            str_field_set(&app.api_keys[app.api_keys_len], &piece.bytes, piece.len);
            app.api_keys_len = app.api_keys_len + 1;
        };
        if end >= raw.len { break; };
        start = end + 1;
    }
    app.upstream.fetch_ready = false;
    app.upstream.fetch_degraded = false;
    app.upstream.sessions.len = 0;
    app.upstream.last_conversation_end = 0;
    app.upstream.rate_limit_until = 0;
    app.upstream.rate_limit_fails = 0;
    app.cache.len = 0;
}

fn api_key_allowed(app: &DuckApp, token_ptr: ptr, token_len: u64) -> bool {
    for i in 0..app.api_keys_len {
        if app.api_keys[i].len == token_len && bytes_eq(app.api_keys[i].bytes, token_ptr, token_len) { return true; };
    }
    return false;
}

// One inbound HTTP request as the HTTP-server extern presents it.
struct DuckHttpRequest {
    method: StrField,
    path: StrField,
    body: ByteBuf,
    sink: u64,
}

fn req_header(req: &DuckHttpRequest, name_ptr: ptr, name_len: u64, out_ptr: &ptr, out_len: &u64) -> i32 {
    return sa_http_request_header(req.sink, name_ptr, name_len, out_ptr, out_len);
}

fn duck_request_init(req: &DuckApiRequest) -> void {
    req.model.len = 0;
    req.has_tool_choice = false;
    req.tool_choice_web_search = false;
    req.tool_choice_generate_image = false;
    req.messages_len = 0;
    req.can_use_tools = false;
    req.reasoning_effort.len = 0;
    req.has_can_use_approx_location = false;
    req.can_use_approx_location = false;
    req.has_can_delegate_image_generation = false;
    req.can_delegate_image_generation = false;
    req.can_show_greeting = false;
    req.durable_message_id.len = 0;
    req.durable_conversation_id.len = 0;
    req.durable_public_key_json.len = 0;
    req.has_tool_simulation = false;
    req.tool_simulation = false;
}

// messageText(DuckMessage content) — parts joined over text parts only
fn duck_message_text(out: &ByteBuf, msg: &DuckMessage) -> void {
    buf_reset(out);
    if !msg.content_is_parts {
        buf_append_lit(out, &msg.content_text.bytes, msg.content_text.len);
        return;
    };
    for pi in 0..msg.parts.len {
        let p = msg.parts.parts[pi];
        if p.typ.len == 4 && bytes_eq_str(&p.typ.bytes, p.typ.len, STR_PTR("text"), STR_LEN("text")) && p.has_text {
            buf_append_lit(out, &p.text.bytes, p.text.len);
        };
    }
}

// countMessagesTokens over the projected DuckMessage[] (same formula as
// tokens.sla: 3 + tokens(role) + tokens(content) per message)
fn count_duck_messages_tokens(req: &DuckApiRequest) -> u64 {
    let total: u64 = 0;
    for mi in 0..req.messages_len {
        total = total + 3;
        total = total + count_token(&req.messages[mi].role.bytes, req.messages[mi].role.len);
        let text = ByteBuf { bytes: [0u8; 40960], len: 0 };
        duck_message_text(&text, &req.messages[mi]);
        total = total + count_token(&text.bytes, text.len);
    }
    return total;
}

// hashPrompt(projectedInput.map((m) => `${messageText(m.content)}\n`).join(""))
fn duck_prompt_hash(out: &ByteBuf, req: &DuckApiRequest) -> void {
    let joined = ByteBuf { bytes: [0u8; 40960], len: 0 };
    for mi in 0..req.messages_len {
        let text = ByteBuf { bytes: [0u8; 40960], len: 0 };
        duck_message_text(&text, &req.messages[mi]);
        buf_append_buf(&joined, &text);
        buf_append_lit(&joined, STR_PTR("\n"), STR_LEN("\n"));
    }
    hash_prompt(out, &joined.bytes, joined.len);
}

fn set_cache_headers(app: &DuckApp, hash_ptr: ptr, hash_len: u64, cache: &CacheResult) -> void {
    let v = ByteBuf { bytes: [0u8; 40960], len: 0 };
    buf_append_u64(&v, cache.creation);
    sa_http_set_header(STR_PTR("X-Cache-Creation-Tokens"), STR_LEN("X-Cache-Creation-Tokens"), &v.bytes, v.len);
    buf_reset(&v);
    buf_append_u64(&v, cache.read);
    sa_http_set_header(STR_PTR("X-Cache-Read-Tokens"), STR_LEN("X-Cache-Read-Tokens"), &v.bytes, v.len);
    let ch = CacheHeaders { hit: false, age: 0 };
    cache_headers(&app.cache, hash_ptr, hash_len, &ch);
    if ch.hit {
        sa_http_set_header(STR_PTR("X-Cache"), STR_LEN("X-Cache"), STR_PTR("HIT"), STR_LEN("HIT"));
    } else {
        sa_http_set_header(STR_PTR("X-Cache"), STR_LEN("X-Cache"), STR_PTR("MISS"), STR_LEN("MISS"));
    };
    if ch.hit {
        buf_reset(&v);
        buf_append_u64(&v, ch.age);
        sa_http_set_header(STR_PTR("Age"), STR_LEN("Age"), &v.bytes, v.len);
    };
}

fn clamped_status(status: u64) -> u64 {
    if status >= 400 && status <= 599 { return status; };
    return 500;
}

fn respond_upstream_error(result: &ConversationResult, fallback_ptr: ptr, fallback_len: u64) -> void {
    if result.status == 503 && result.has_retry_after_sec {
        let v = ByteBuf { bytes: [0u8; 40960], len: 0 };
        buf_append_u64(&v, result.retry_after_sec);
        sa_http_set_header(STR_PTR("Retry-After"), STR_LEN("Retry-After"), &v.bytes, v.len);
    };
    let err = ByteBuf { bytes: [0u8; 40960], len: 0 };
    // apiError(message, "upstream_error", String(status)) — code is the
    // decimal status text.
    let code = ByteBuf { bytes: [0u8; 40960], len: 0 };
    buf_append_u64(&code, result.status);
    if result.has_error_body {
        api_error(&err, &result.error_body.bytes, result.error_body.len, STR_PTR("upstream_error"), STR_LEN("upstream_error"), true, &code.bytes, code.len);
    } else {
        api_error(&err, fallback_ptr, fallback_len, STR_PTR("upstream_error"), STR_LEN("upstream_error"), true, &code.bytes, code.len);
    };
    sa_http_respond_json(clamped_status(result.status), &err.bytes, err.len);
}

fn stats_for(opts: &ConsumeOptions, start: u64, input_tokens: u64, cache_read: u64, effort_ptr: ptr, effort_len: u64) -> void {
    opts.stats.start = start;
    opts.stats.prompt_tokens = input_tokens;
    opts.stats.cached_tokens = cache_read;
    str_field_set(&opts.stats.effort, effort_ptr, effort_len);
}

// DEFECT: zValidator("json", apiRequestSchema, hook) — types.sla holds
// the schema as structs only; this checks the load-bearing shape (object
// with string model + array messages). Full zod semantics (defaults,
// unknown-key stripping, nested part unions) are NOT reproduced.
fn api_request_shape_ok(body: u64) -> bool {
    if sa_json_kind_of(body) != 3 { return false; };
    let mp: ptr = PTR_NULL();
    let ml: u64 = 0;
    if sa_json_object_get_string(body, STR_PTR("model"), STR_LEN("model"), &mp, &ml) != 0 { return false; };
    let messages: u64 = 0;
    if sa_json_object_get(body, STR_PTR("messages"), STR_LEN("messages"), &messages) != 0 || messages == 0 { return false; };
    return sa_json_kind_of(messages) == 2;
}

fn effort_from_body(body: u64, out: &ByteBuf) -> void {
    buf_reset(out);
    let ep: ptr = PTR_NULL();
    let el: u64 = 0;
    sa_json_object_get_string(body, STR_PTR("reasoning_effort"), STR_LEN("reasoning_effort"), &ep, &el);
    if el > 0 { buf_append_lit(out, ep, el); };
    if out.len == 0 {
        let reasoning: u64 = 0;
        if sa_json_object_get(body, STR_PTR("reasoning"), STR_LEN("reasoning"), &reasoning) == 0 && reasoning != 0 {
            parse_reasoning_effort(out, reasoning);
        };
    };
    if out.len == 0 {
        sa_env_get(out, STR_PTR("CLAUDE_CODE_EFFORT_LEVEL"), STR_LEN("CLAUDE_CODE_EFFORT_LEVEL"));
    };
}

// ---------------------------------------------------------------------------
// POST /v1/chat/completions
// ---------------------------------------------------------------------------
fn handle_chat_completions(app: &DuckApp, req: &DuckHttpRequest) -> void {
    let body: u64 = 0;
    // zValidator("json", apiRequestSchema, hook): parse + schema failure
    // both surface as the same bad_json error in TS.
    if sa_json_parse(&req.body.bytes, req.body.len, &body) != 0 || body == 0 || !api_request_shape_ok(body) {
        let err = ByteBuf { bytes: [0u8; 40960], len: 0 };
        api_error(&err, STR_PTR("Request must be proper JSON"), STR_LEN("Request must be proper JSON"), STR_PTR("invalid_request_error"), STR_LEN("invalid_request_error"), true, STR_PTR("bad_json"), STR_LEN("bad_json"));
        sa_http_respond_json(400, &err.bytes, err.len);
        return;
    };
    let effort = ByteBuf { bytes: [0u8; 40960], len: 0 };
    effort_from_body(body, &effort);
    let web_search = sa_json_object_get_bool(body, STR_PTR("web_search"), STR_LEN("web_search")) == 1;
    let store = FileStore { entries: [FileEntry { id: StrField { bytes: [0u8; 512], len: 0 }, filename: StrField { bytes: [0u8; 512], len: 0 }, mime_type: StrField { bytes: [0u8; 512], len: 0 }, data: ByteBuf { bytes: [0u8; 40960], len: 0 } }; 64], len: 0 };
    let copts = ConvertOptions { has_reasoning_effort: true, reasoning_effort: StrField { bytes: [0u8; 512], len: 0 }, web_search: web_search, generate_image: false, has_file_store: false };
    str_field_set(&copts.reasoning_effort, &effort.bytes, effort.len);
    let translated = DuckApiRequest { model: StrField { bytes: [0u8; 512], len: 0 }, has_tool_choice: false, tool_choice_web_search: false, tool_choice_generate_image: false, messages: [DuckMessage { role: StrField { bytes: [0u8; 512], len: 0 }, content_is_parts: false, content_text: StrField { bytes: [0u8; 512], len: 0 }, parts: PartsList { parts: [DuckContentPart { typ: StrField { bytes: [0u8; 512], len: 0 }, has_text: false, text: StrField { bytes: [0u8; 512], len: 0 }, has_image: false, image: StrField { bytes: [0u8; 512], len: 0 }, has_mime_type: false, mime_type: StrField { bytes: [0u8; 512], len: 0 }, has_filename: false, filename: StrField { bytes: [0u8; 512], len: 0 } }; 64], len: 0 } }; 128], messages_len: 0, can_use_tools: false, reasoning_effort: StrField { bytes: [0u8; 512], len: 0 }, has_can_use_approx_location: false, can_use_approx_location: false, has_can_delegate_image_generation: false, can_delegate_image_generation: false, can_show_greeting: false, durable_message_id: StrField { bytes: [0u8; 512], len: 0 }, durable_conversation_id: StrField { bytes: [0u8; 512], len: 0 }, durable_public_key_json: ByteBuf { bytes: [0u8; 40960], len: 0 }, has_tool_simulation: false, tool_simulation: false };
    convert_api_request_with_options(&translated, body, &copts, &store);
    let input_tokens = count_duck_messages_tokens(&translated);
    let hash = ByteBuf { bytes: [0u8; 40960], len: 0 };
    duck_prompt_hash(&hash, &translated);
    let cache = CacheResult { creation: 0, read: 0 };
    record_cache(&app.cache, &hash.bytes, hash.len, input_tokens, &cache);
    let proxy = ByteBuf { bytes: [0u8; 40960], len: 0 };
    sa_env_get(&proxy, STR_PTR("PROXY_URL"), STR_LEN("PROXY_URL"));
    let upstream = ConversationResult { ok: false, status: 0, headers: HeaderList { names: [StrField { bytes: [0u8; 512], len: 0 }; 32], values: [StrField { bytes: [0u8; 512], len: 0 }; 32], len: 0 }, has_body: false, body: 0, has_error_body: false, error_body: ByteBuf { bytes: [0u8; 40960], len: 0 }, has_retry_after_sec: false, retry_after_sec: 0 };
    post_conversation(&app.upstream, &upstream, &translated, STR_PTR(""), 0, &proxy.bytes, proxy.len);
    if !upstream.ok {
        respond_upstream_error(&upstream, STR_PTR("upstream request failed"), STR_LEN("upstream request failed"));
        return;
    };
    let start = sa_time_now_ms();
    set_cache_headers(app, &hash.bytes, hash.len, &cache);
    let is_stream = sa_json_object_get_bool(body, STR_PTR("stream"), STR_LEN("stream")) == 1;
    if !is_stream {
        let opts = ConsumeOptions { has_body: upstream.has_body, body: upstream.body, request_model: StrField { bytes: [0u8; 512], len: 0 }, reasoning_effort: StrField { bytes: [0u8; 512], len: 0 }, tool_simulation: false, stream: false, stats: StreamStats { start: 0, prompt_tokens: 0, cached_tokens: 0, effort: StrField { bytes: [0u8; 512], len: 0 } }, sink: 0 };
        opts.request_model = translated.model;
        opts.reasoning_effort = translated.reasoning_effort;
        opts.tool_simulation = translated.has_tool_simulation && translated.tool_simulation;
        opts.sink = sa_sink_null();
        stats_for(&opts, start, input_tokens, cache.read, &effort.bytes, effort.len);
        let result = StreamResult { text: ByteBuf { bytes: [0u8; 40960], len: 0 }, output_tokens: 0, ttft_ms: 0, total_ms: 0, tool_calls: ToolCallList { calls: [ToolCall { has_id: false, id: StrField { bytes: [0u8; 512], len: 0 }, typ: StrField { bytes: [0u8; 512], len: 0 }, has_index: false, index: 0, function_name: StrField { bytes: [0u8; 512], len: 0 }, function_arguments: ByteBuf { bytes: [0u8; 40960], len: 0 } }; 64], len: 0 } };
        if consume_upstream(&opts, &result) != 0 {
            let err = ByteBuf { bytes: [0u8; 40960], len: 0 };
            api_error(&err, STR_PTR("Error"), STR_LEN("Error"), STR_PTR("upstream_error"), STR_LEN("upstream_error"), false, STR_PTR(""), 0);
            sa_http_respond_json(500, &err.bytes, err.len);
            return;
        };
        let v = ByteBuf { bytes: [0u8; 40960], len: 0 };
        buf_append_u64(&v, result.ttft_ms);
        sa_http_set_header(STR_PTR("X-TTFT-Ms"), STR_LEN("X-TTFT-Ms"), &v.bytes, v.len);
        buf_reset(&v);
        buf_append_u64(&v, result.total_ms);
        sa_http_set_header(STR_PTR("X-Total-Time-Ms"), STR_LEN("X-Total-Time-Ms"), &v.bytes, v.len);
        let json = ByteBuf { bytes: [0u8; 40960], len: 0 };
        new_chat_completion_full(&json, &result.text.bytes, result.text.len, &translated.model.bytes, translated.model.len, input_tokens, result.output_tokens, cache.read, result.ttft_ms, result.total_ms, &effort.bytes, effort.len, result.tool_calls.calls, result.tool_calls.len);
        sa_http_respond_json(200, &json.bytes, json.len);
        return;
    };
    // Stream path: SSE response, then consume, then data: [DONE]
    let sink = sa_http_begin_sse(STR_PTR("text/event-stream"), STR_LEN("text/event-stream"));
    let opts = ConsumeOptions { has_body: upstream.has_body, body: upstream.body, request_model: StrField { bytes: [0u8; 512], len: 0 }, reasoning_effort: StrField { bytes: [0u8; 512], len: 0 }, tool_simulation: false, stream: true, stats: StreamStats { start: 0, prompt_tokens: 0, cached_tokens: 0, effort: StrField { bytes: [0u8; 512], len: 0 } }, sink: sink };
    opts.request_model = translated.model;
    opts.reasoning_effort = translated.reasoning_effort;
    opts.tool_simulation = translated.has_tool_simulation && translated.tool_simulation;
    stats_for(&opts, start, input_tokens, cache.read, &effort.bytes, effort.len);
    let result = StreamResult { text: ByteBuf { bytes: [0u8; 40960], len: 0 }, output_tokens: 0, ttft_ms: 0, total_ms: 0, tool_calls: ToolCallList { calls: [ToolCall { has_id: false, id: StrField { bytes: [0u8; 512], len: 0 }, typ: StrField { bytes: [0u8; 512], len: 0 }, has_index: false, index: 0, function_name: StrField { bytes: [0u8; 512], len: 0 }, function_arguments: ByteBuf { bytes: [0u8; 40960], len: 0 } }; 64], len: 0 } };
    consume_upstream(&opts, &result);
    sa_sink_write_line(sink, STR_PTR("data: [DONE]\n\n"), STR_LEN("data: [DONE]\n\n"));
    sa_http_end_sse(sink);
}

// ---------------------------------------------------------------------------
// POST /v1/responses
// ---------------------------------------------------------------------------
fn handle_responses(app: &DuckApp, req: &DuckHttpRequest) -> void {
    let body: u64 = 0;
    if sa_json_parse(&req.body.bytes, req.body.len, &body) != 0 || body == 0 || sa_json_kind_of(body) != 3 {
        let err = ByteBuf { bytes: [0u8; 40960], len: 0 };
        api_error(&err, STR_PTR("Request must be proper JSON"), STR_LEN("Request must be proper JSON"), STR_PTR("invalid_request_error"), STR_LEN("invalid_request_error"), true, STR_PTR("bad_json"), STR_LEN("bad_json"));
        sa_http_respond_json(400, &err.bytes, err.len);
        return;
    };
    let model = ByteBuf { bytes: [0u8; 40960], len: 0 };
    let mp: ptr = PTR_NULL();
    let ml: u64 = 0;
    sa_json_object_get_string(body, STR_PTR("model"), STR_LEN("model"), &mp, &ml);
    if ml > 0 { buf_append_lit(&model, mp, ml); } else { buf_append_lit(&model, STR_PTR("gpt-5.4-mini"), STR_LEN("gpt-5.4-mini")); };
    // effort: reasoning_effort (trimmed) -> reasoning -> env -> include[] hint
    let effort = ByteBuf { bytes: [0u8; 40960], len: 0 };
    let ep: ptr = PTR_NULL();
    let el: u64 = 0;
    sa_json_object_get_string(body, STR_PTR("reasoning_effort"), STR_LEN("reasoning_effort"), &ep, &el);
    if el > 0 {
        buf_append_lit(&effort, ep, el);
        buf_trim(&effort);
    };
    if effort.len == 0 {
        let reasoning: u64 = 0;
        if sa_json_object_get(body, STR_PTR("reasoning"), STR_LEN("reasoning"), &reasoning) == 0 && reasoning != 0 {
            parse_reasoning_effort(&effort, reasoning);
        };
    };
    if effort.len == 0 { sa_env_get(&effort, STR_PTR("CLAUDE_CODE_EFFORT_LEVEL"), STR_LEN("CLAUDE_CODE_EFFORT_LEVEL")); };
    if effort.len == 0 {
        let include: u64 = 0;
        if sa_json_object_get(body, STR_PTR("include"), STR_LEN("include"), &include) == 0 && include != 0 && sa_json_kind_of(include) == 2 {
            let idx: u64 = 0;
            while 1 == 1 {
                let item: u64 = 0;
                if sa_json_array_get(include, idx, &item) != 0 { break; };
                idx = idx + 1;
                if item != 0 && sa_json_kind_of(item) == 1 {
                    let ip: ptr = PTR_NULL();
                    let il: u64 = 0;
                    sa_json_get_string(item, &ip, &il);
                    if find_sub_buf(ip, il, STR_PTR("reasoning"), STR_LEN("reasoning")) != 4294967295 {
                        buf_append_lit(&effort, STR_PTR("low"), STR_LEN("low"));
                        break;
                    };
                };
            }
        };
    };
    // Build the ApiMessage[] JSON (instructions intercepted; function_call /
    // function_call_output dropped), then a synthetic APIRequest node.
    let messages_json = ByteBuf { bytes: [0u8; 40960], len: 0 };
    buf_append_lit(&messages_json, STR_PTR("["), STR_LEN("["));
    let msg_count: u64 = 0;
    let input: u64 = 0;
    let has_input = sa_json_object_get(body, STR_PTR("input"), STR_LEN("input"), &input) == 0 && input != 0;
    if has_input && sa_json_kind_of(input) == 1 {
        let ip: ptr = PTR_NULL();
        let il: u64 = 0;
        sa_json_get_string(input, &ip, &il);
        let trimmed = ByteBuf { bytes: [0u8; 40960], len: 0 };
        buf_append_lit(&trimmed, ip, il);
        buf_trim(&trimmed);
        if trimmed.len > 0 {
            responses_push_message(&messages_json, &msg_count, STR_PTR("user"), STR_LEN("user"), ip, il, 0);
        };
    } else if has_input && sa_json_kind_of(input) == 2 {
        let idx: u64 = 0;
        while 1 == 1 {
            let item: u64 = 0;
            if sa_json_array_get(input, idx, &item) != 0 { break; };
            idx = idx + 1;
            if item == 0 { continue; };
            if sa_json_kind_of(item) == 1 {
                let ip: ptr = PTR_NULL();
                let il: u64 = 0;
                sa_json_get_string(item, &ip, &il);
                let trimmed = ByteBuf { bytes: [0u8; 40960], len: 0 };
                buf_append_lit(&trimmed, ip, il);
                buf_trim(&trimmed);
                if trimmed.len > 0 { responses_push_message(&messages_json, &msg_count, STR_PTR("user"), STR_LEN("user"), ip, il, 0); };
                continue;
            };
            if sa_json_kind_of(item) != 3 { continue; };
            let tp: ptr = PTR_NULL();
            let tl: u64 = 0;
            sa_json_object_get_string(item, STR_PTR("type"), STR_LEN("type"), &tp, &tl);
            let is_message = tl == 0 || (tl == 7 && bytes_eq_str(tp, tl, STR_PTR("message"), STR_LEN("message")));
            if !is_message { continue; };
            // function_call / function_call_output fall here only when
            // type is neither — TS checks them after the message branch;
            // non-message types are dropped (continue above covers them
            // because is_message is false for them).
            let rp: ptr = PTR_NULL();
            let rl: u64 = 0;
            sa_json_object_get_string(item, STR_PTR("role"), STR_LEN("role"), &rp, &rl);
            let role_ptr = STR_PTR("user");
            let role_len = STR_LEN("user");
            if rl == 9 && bytes_eq_str(rp, rl, STR_PTR("assistant"), STR_LEN("assistant")) { role_ptr = rp; role_len = rl; };
            if rl == 6 && bytes_eq_str(rp, rl, STR_PTR("system"), STR_LEN("system")) { role_ptr = rp; role_len = rl; };
            let content: u64 = 0;
            if sa_json_object_get(item, STR_PTR("content"), STR_LEN("content"), &content) != 0 || content == 0 { continue; };
            if sa_json_kind_of(content) == 1 {
                let cp: ptr = PTR_NULL();
                let cl: u64 = 0;
                sa_json_get_string(content, &cp, &cl);
                let trimmed = ByteBuf { bytes: [0u8; 40960], len: 0 };
                buf_append_lit(&trimmed, cp, cl);
                buf_trim(&trimmed);
                if trimmed.len > 0 { responses_push_message(&messages_json, &msg_count, role_ptr, role_len, cp, cl, 0); };
            } else if sa_json_kind_of(content) == 2 {
                responses_push_message(&messages_json, &msg_count, role_ptr, role_len, STR_PTR(""), 0, content);
            };
        }
    };
    buf_append_lit(&messages_json, STR_PTR("]"), STR_LEN("]"));
    let is_stream = sa_json_object_get_bool(body, STR_PTR("stream"), STR_LEN("stream")) == 1;
    let web_search = sa_json_object_get_bool(body, STR_PTR("web_search"), STR_LEN("web_search")) == 1;
    let api_json = ByteBuf { bytes: [0u8; 40960], len: 0 };
    buf_append_lit(&api_json, STR_PTR("{\"model\":\""), STR_LEN("{\"model\":\""));
    buf_append_escaped(&api_json, &model.bytes, model.len);
    buf_append_lit(&api_json, STR_PTR("\",\"messages\":"), STR_LEN("\",\"messages\":"));
    buf_append_buf(&api_json, &messages_json);
    buf_append_lit(&api_json, STR_PTR(",\"stream\":"), STR_LEN(",\"stream\":"));
    if is_stream { buf_append_lit(&api_json, STR_PTR("true"), STR_LEN("true")); } else { buf_append_lit(&api_json, STR_PTR("false"), STR_LEN("false")); };
    buf_append_lit(&api_json, STR_PTR(",\"reasoning_effort\":\""), STR_LEN(",\"reasoning_effort\":\""));
    buf_append_escaped(&api_json, &effort.bytes, effort.len);
    buf_append_lit(&api_json, STR_PTR("\"}"), STR_LEN("\"}"));
    let api: u64 = 0;
    sa_json_parse(&api_json.bytes, api_json.len, &api);
    let store = FileStore { entries: [FileEntry { id: StrField { bytes: [0u8; 512], len: 0 }, filename: StrField { bytes: [0u8; 512], len: 0 }, mime_type: StrField { bytes: [0u8; 512], len: 0 }, data: ByteBuf { bytes: [0u8; 40960], len: 0 } }; 64], len: 0 };
    let copts = ConvertOptions { has_reasoning_effort: true, reasoning_effort: StrField { bytes: [0u8; 512], len: 0 }, web_search: web_search, generate_image: false, has_file_store: false };
    str_field_set(&copts.reasoning_effort, &effort.bytes, effort.len);
    let translated = DuckApiRequest { model: StrField { bytes: [0u8; 512], len: 0 }, has_tool_choice: false, tool_choice_web_search: false, tool_choice_generate_image: false, messages: [DuckMessage { role: StrField { bytes: [0u8; 512], len: 0 }, content_is_parts: false, content_text: StrField { bytes: [0u8; 512], len: 0 }, parts: PartsList { parts: [DuckContentPart { typ: StrField { bytes: [0u8; 512], len: 0 }, has_text: false, text: StrField { bytes: [0u8; 512], len: 0 }, has_image: false, image: StrField { bytes: [0u8; 512], len: 0 }, has_mime_type: false, mime_type: StrField { bytes: [0u8; 512], len: 0 }, has_filename: false, filename: StrField { bytes: [0u8; 512], len: 0 } }; 64], len: 0 } }; 128], messages_len: 0, can_use_tools: false, reasoning_effort: StrField { bytes: [0u8; 512], len: 0 }, has_can_use_approx_location: false, can_use_approx_location: false, has_can_delegate_image_generation: false, can_delegate_image_generation: false, can_show_greeting: false, durable_message_id: StrField { bytes: [0u8; 512], len: 0 }, durable_conversation_id: StrField { bytes: [0u8; 512], len: 0 }, durable_public_key_json: ByteBuf { bytes: [0u8; 40960], len: 0 }, has_tool_simulation: false, tool_simulation: false };
    convert_api_request_with_options(&translated, api, &copts, &store);
    let input_tokens = count_duck_messages_tokens(&translated);
    let hash = ByteBuf { bytes: [0u8; 40960], len: 0 };
    duck_prompt_hash(&hash, &translated);
    let cache = CacheResult { creation: 0, read: 0 };
    record_cache(&app.cache, &hash.bytes, hash.len, input_tokens, &cache);
    let proxy = ByteBuf { bytes: [0u8; 40960], len: 0 };
    sa_env_get(&proxy, STR_PTR("PROXY_URL"), STR_LEN("PROXY_URL"));
    let upstream = ConversationResult { ok: false, status: 0, headers: HeaderList { names: [StrField { bytes: [0u8; 512], len: 0 }; 32], values: [StrField { bytes: [0u8; 512], len: 0 }; 32], len: 0 }, has_body: false, body: 0, has_error_body: false, error_body: ByteBuf { bytes: [0u8; 40960], len: 0 }, has_retry_after_sec: false, retry_after_sec: 0 };
    post_conversation(&app.upstream, &upstream, &translated, STR_PTR(""), 0, &proxy.bytes, proxy.len);
    if !upstream.ok {
        respond_upstream_error(&upstream, STR_PTR("upstream request failed"), STR_LEN("upstream request failed"));
        return;
    };
    let start = sa_time_now_ms();
    set_cache_headers(app, &hash.bytes, hash.len, &cache);
    if !is_stream {
        let opts = ConsumeOptions { has_body: upstream.has_body, body: upstream.body, request_model: StrField { bytes: [0u8; 512], len: 0 }, reasoning_effort: StrField { bytes: [0u8; 512], len: 0 }, tool_simulation: false, stream: false, stats: StreamStats { start: 0, prompt_tokens: 0, cached_tokens: 0, effort: StrField { bytes: [0u8; 512], len: 0 } }, sink: 0 };
        opts.request_model = translated.model;
        opts.reasoning_effort = translated.reasoning_effort;
        opts.tool_simulation = translated.has_tool_simulation && translated.tool_simulation;
        opts.sink = sa_sink_null();
        stats_for(&opts, start, input_tokens, cache.read, &effort.bytes, effort.len);
        let result = StreamResponsesResult { base: StreamResult { text: ByteBuf { bytes: [0u8; 40960], len: 0 }, output_tokens: 0, ttft_ms: 0, total_ms: 0, tool_calls: ToolCallList { calls: [ToolCall { has_id: false, id: StrField { bytes: [0u8; 512], len: 0 }, typ: StrField { bytes: [0u8; 512], len: 0 }, has_index: false, index: 0, function_name: StrField { bytes: [0u8; 512], len: 0 }, function_arguments: ByteBuf { bytes: [0u8; 40960], len: 0 } }; 64], len: 0 } }, response_json: ByteBuf { bytes: [0u8; 40960], len: 0 } };
        if consume_upstream_responses(&opts, &result) != 0 {
            let err = ByteBuf { bytes: [0u8; 40960], len: 0 };
            api_error(&err, STR_PTR("Error"), STR_LEN("Error"), STR_PTR("upstream_error"), STR_LEN("upstream_error"), false, STR_PTR(""), 0);
            sa_http_respond_json(500, &err.bytes, err.len);
            return;
        };
        let v = ByteBuf { bytes: [0u8; 40960], len: 0 };
        buf_append_u64(&v, result.base.ttft_ms);
        sa_http_set_header(STR_PTR("X-TTFT-Ms"), STR_LEN("X-TTFT-Ms"), &v.bytes, v.len);
        buf_reset(&v);
        buf_append_u64(&v, result.base.total_ms);
        sa_http_set_header(STR_PTR("X-Total-Time-Ms"), STR_LEN("X-Total-Time-Ms"), &v.bytes, v.len);
        sa_http_respond_json(200, &result.response_json.bytes, result.response_json.len);
        return;
    };
    let sink = sa_http_begin_sse(STR_PTR("text/event-stream; charset=utf-8"), STR_LEN("text/event-stream; charset=utf-8"));
    let opts = ConsumeOptions { has_body: upstream.has_body, body: upstream.body, request_model: StrField { bytes: [0u8; 512], len: 0 }, reasoning_effort: StrField { bytes: [0u8; 512], len: 0 }, tool_simulation: false, stream: true, stats: StreamStats { start: 0, prompt_tokens: 0, cached_tokens: 0, effort: StrField { bytes: [0u8; 512], len: 0 } }, sink: sink };
    opts.request_model = translated.model;
    opts.reasoning_effort = translated.reasoning_effort;
    opts.tool_simulation = translated.has_tool_simulation && translated.tool_simulation;
    stats_for(&opts, start, input_tokens, cache.read, &effort.bytes, effort.len);
    let result = StreamResponsesResult { base: StreamResult { text: ByteBuf { bytes: [0u8; 40960], len: 0 }, output_tokens: 0, ttft_ms: 0, total_ms: 0, tool_calls: ToolCallList { calls: [ToolCall { has_id: false, id: StrField { bytes: [0u8; 512], len: 0 }, typ: StrField { bytes: [0u8; 512], len: 0 }, has_index: false, index: 0, function_name: StrField { bytes: [0u8; 512], len: 0 }, function_arguments: ByteBuf { bytes: [0u8; 40960], len: 0 } }; 64], len: 0 } }, response_json: ByteBuf { bytes: [0u8; 40960], len: 0 } };
    consume_upstream_responses(&opts, &result);
    sa_http_end_sse(sink);
}

// appends {"role":"<role>","content":<string or raw array node>} to messages_json
fn responses_push_message(messages_json: &ByteBuf, count: &u64, role_ptr: ptr, role_len: u64, content_ptr: ptr, content_len: u64, content_node: u64) -> void {
    if *count > 0 { buf_append_lit(messages_json, STR_PTR(","), STR_LEN(",")); };
    *count = *count + 1;
    buf_append_lit(messages_json, STR_PTR("{\"role\":\""), STR_LEN("{\"role\":\""));
    buf_append_escaped(messages_json, role_ptr, role_len);
    buf_append_lit(messages_json, STR_PTR("\",\"content\":"), STR_LEN("\",\"content\":"));
    if content_node != 0 {
        sa_json_stringify(content_node, messages_json);
    } else {
        buf_append_lit(messages_json, STR_PTR("\""), STR_LEN("\""));
        buf_append_escaped(messages_json, content_ptr, content_len);
        buf_append_lit(messages_json, STR_PTR("\""), STR_LEN("\""));
    };
    buf_append_lit(messages_json, STR_PTR("}"), STR_LEN("}"));
}

// ---------------------------------------------------------------------------
// POST /v1/images/generations
// ---------------------------------------------------------------------------
fn handle_images_generations(app: &DuckApp, req: &DuckHttpRequest) -> void {
    let body: u64 = 0;
    let prompt = ByteBuf { bytes: [0u8; 40960], len: 0 };
    let valid = false;
    if sa_json_parse(&req.body.bytes, req.body.len, &body) == 0 && body != 0 && sa_json_kind_of(body) == 3 {
        let pp: ptr = PTR_NULL();
        let pl: u64 = 0;
        // imageGenerationSchema requires prompt: string (zod); a failed
        // schema surfaces as bad_json via the validator hook.
        if sa_json_object_get_string(body, STR_PTR("prompt"), STR_LEN("prompt"), &pp, &pl) == 0 {
            buf_append_lit(&prompt, pp, pl);
            valid = true;
        };
    };
    if !valid {
        let err = ByteBuf { bytes: [0u8; 40960], len: 0 };
        api_error(&err, STR_PTR("Request must be proper JSON"), STR_LEN("Request must be proper JSON"), STR_PTR("invalid_request_error"), STR_LEN("invalid_request_error"), true, STR_PTR("bad_json"), STR_LEN("bad_json"));
        sa_http_respond_json(400, &err.bytes, err.len);
        return;
    };
    let prompt_trimmed = ByteBuf { bytes: [0u8; 40960], len: 0 };
    buf_append_buf(&prompt_trimmed, &prompt);
    buf_trim(&prompt_trimmed);
    if prompt_trimmed.len == 0 {
        let err = ByteBuf { bytes: [0u8; 40960], len: 0 };
        api_error(&err, STR_PTR("prompt is required"), STR_LEN("prompt is required"), STR_PTR("invalid_request_error"), STR_LEN("invalid_request_error"), true, STR_PTR("missing_prompt"), STR_LEN("missing_prompt"));
        sa_http_respond_json(400, &err.bytes, err.len);
        return;
    };
    let model = ByteBuf { bytes: [0u8; 40960], len: 0 };
    let mp: ptr = PTR_NULL();
    let ml: u64 = 0;
    sa_json_object_get_string(body, STR_PTR("model"), STR_LEN("model"), &mp, &ml);
    if ml > 0 {
        buf_append_lit(&model, mp, ml);
        buf_trim(&model);
    };
    if model.len == 0 {
        buf_reset(&model);
        buf_append_lit(&model, STR_PTR("gpt-5.4-nano"), STR_LEN("gpt-5.4-nano"));
    };
    let effort = ByteBuf { bytes: [0u8; 40960], len: 0 };
    effort_from_body(body, &effort);
    // synthetic APIRequest { model, messages: [{role:"user", content: prompt}], stream: false, reasoning_effort: effort }
    let api_json = ByteBuf { bytes: [0u8; 40960], len: 0 };
    buf_append_lit(&api_json, STR_PTR("{\"model\":\""), STR_LEN("{\"model\":\""));
    buf_append_escaped(&api_json, &model.bytes, model.len);
    buf_append_lit(&api_json, STR_PTR("\",\"messages\":[{\"role\":\"user\",\"content\":\""), STR_LEN("\",\"messages\":[{\"role\":\"user\",\"content\":\""));
    buf_append_escaped(&api_json, &prompt.bytes, prompt.len);
    buf_append_lit(&api_json, STR_PTR("\"}],\"stream\":false,\"reasoning_effort\":\""), STR_LEN("\"}],\"stream\":false,\"reasoning_effort\":\""));
    buf_append_escaped(&api_json, &effort.bytes, effort.len);
    buf_append_lit(&api_json, STR_PTR("\"}"), STR_LEN("\"}"));
    let api: u64 = 0;
    sa_json_parse(&api_json.bytes, api_json.len, &api);
    let store = FileStore { entries: [FileEntry { id: StrField { bytes: [0u8; 512], len: 0 }, filename: StrField { bytes: [0u8; 512], len: 0 }, mime_type: StrField { bytes: [0u8; 512], len: 0 }, data: ByteBuf { bytes: [0u8; 40960], len: 0 } }; 64], len: 0 };
    let copts = ConvertOptions { has_reasoning_effort: true, reasoning_effort: StrField { bytes: [0u8; 512], len: 0 }, web_search: false, generate_image: true, has_file_store: false };
    str_field_set(&copts.reasoning_effort, &effort.bytes, effort.len);
    let translated = DuckApiRequest { model: StrField { bytes: [0u8; 512], len: 0 }, has_tool_choice: false, tool_choice_web_search: false, tool_choice_generate_image: false, messages: [DuckMessage { role: StrField { bytes: [0u8; 512], len: 0 }, content_is_parts: false, content_text: StrField { bytes: [0u8; 512], len: 0 }, parts: PartsList { parts: [DuckContentPart { typ: StrField { bytes: [0u8; 512], len: 0 }, has_text: false, text: StrField { bytes: [0u8; 512], len: 0 }, has_image: false, image: StrField { bytes: [0u8; 512], len: 0 }, has_mime_type: false, mime_type: StrField { bytes: [0u8; 512], len: 0 }, has_filename: false, filename: StrField { bytes: [0u8; 512], len: 0 } }; 64], len: 0 } }; 128], messages_len: 0, can_use_tools: false, reasoning_effort: StrField { bytes: [0u8; 512], len: 0 }, has_can_use_approx_location: false, can_use_approx_location: false, has_can_delegate_image_generation: false, can_delegate_image_generation: false, can_show_greeting: false, durable_message_id: StrField { bytes: [0u8; 512], len: 0 }, durable_conversation_id: StrField { bytes: [0u8; 512], len: 0 }, durable_public_key_json: ByteBuf { bytes: [0u8; 40960], len: 0 }, has_tool_simulation: false, tool_simulation: false };
    convert_api_request_with_options(&translated, api, &copts, &store);
    let proxy = ByteBuf { bytes: [0u8; 40960], len: 0 };
    sa_env_get(&proxy, STR_PTR("PROXY_URL"), STR_LEN("PROXY_URL"));
    let upstream = ConversationResult { ok: false, status: 0, headers: HeaderList { names: [StrField { bytes: [0u8; 512], len: 0 }; 32], values: [StrField { bytes: [0u8; 512], len: 0 }; 32], len: 0 }, has_body: false, body: 0, has_error_body: false, error_body: ByteBuf { bytes: [0u8; 40960], len: 0 }, has_retry_after_sec: false, retry_after_sec: 0 };
    post_conversation(&app.upstream, &upstream, &translated, STR_PTR(""), 0, &proxy.bytes, proxy.len);
    if !upstream.ok {
        respond_upstream_error(&upstream, STR_PTR("Failed to generate image"), STR_LEN("Failed to generate image"));
        return;
    };
    // Read the whole upstream SSE body to text (reader + TextDecoder loop).
    let sse_text = ByteBuf { bytes: [0u8; 40960], len: 0 };
    if upstream.has_body {
        let done_all = false;
        while !done_all {
            let chunk = ByteBuf { bytes: [0u8; 40960], len: 0 };
            let done = false;
            sa_body_read_chunk(upstream.body, &chunk, &done);
            if chunk.len > 0 { buf_append_buf(&sse_text, &chunk); };
            if done { done_all = true; };
        }
        sa_body_close(upstream.body, false);
    };
    let result = ImageStreamResult { text: ByteBuf { bytes: [0u8; 40960], len: 0 }, arena: ByteBuf { bytes: [0u8; 40960], len: 0 }, images: [ExtractedImage { b64_off: 0, b64_len: 0, has_format: false, format: [0u8; 32], format_len: 0, has_width: false, width: 0, has_height: false, height: 0 }; 32], images_len: 0 };
    read_image_response(&result, &sse_text.bytes, sse_text.len);
    let json = ByteBuf { bytes: [0u8; 40960], len: 0 };
    buf_append_lit(&json, STR_PTR("{\"created\":"), STR_LEN("{\"created\":"));
    // Math.floor(Date.now() / 1000) — @ts_math_rounding (op 0 = floor)
    buf_append_u64(&json, ts_math_rounding(sa_time_now_ms() / 1000.0, 0));
    buf_append_lit(&json, STR_PTR(",\"data\":["), STR_LEN(",\"data\":["));
    let emitted: u64 = 0;
    for ii in 0..result.images_len {
        if result.images[ii].b64_len == 0 { continue; };
        if emitted > 0 { buf_append_lit(&json, STR_PTR(","), STR_LEN(",")); };
        emitted = emitted + 1;
        buf_append_lit(&json, STR_PTR("{\"b64_json\":\""), STR_LEN("{\"b64_json\":\""));
        let b64p: ptr = PTR_NULL();
        PTR_BYTE_ADD(b64p, result.arena.bytes, result.images[ii].b64_off);
        buf_append_escaped(&json, b64p, result.images[ii].b64_len);
        buf_append_lit(&json, STR_PTR("\",\"revised_prompt\":\""), STR_LEN("\",\"revised_prompt\":\""));
        buf_append_escaped(&json, &result.text.bytes, result.text.len);
        buf_append_lit(&json, STR_PTR("\"}"), STR_LEN("\"}"));
    }
    buf_append_lit(&json, STR_PTR("]}"), STR_LEN("]}"));
    if emitted == 0 {
        let err = ByteBuf { bytes: [0u8; 40960], len: 0 };
        api_error(&err, STR_PTR("No images were generated"), STR_LEN("No images were generated"), STR_PTR("internal_server_error"), STR_LEN("internal_server_error"), true, STR_PTR("no_images"), STR_LEN("no_images"));
        sa_http_respond_json(500, &err.bytes, err.len);
        return;
    };
    sa_http_respond_json(200, &json.bytes, json.len);
}

// ---------------------------------------------------------------------------
// TS: export function createApp() — route table + v1 auth middleware
// ---------------------------------------------------------------------------
fn path_eq(path: &StrField, lit_ptr: ptr, lit_len: u64) -> bool {
    return path.len == lit_len && bytes_eq(path.bytes, lit_ptr, lit_len);
}

fn method_is(req: &DuckHttpRequest, lit_ptr: ptr, lit_len: u64) -> bool {
    return req.method.len == lit_len && bytes_eq(req.method.bytes, lit_ptr, lit_len);
}

// Joins base + route: base "/" means the route path itself; otherwise the
// request path must start with base and the remainder is matched.
fn route_match(req: &DuckHttpRequest, app: &DuckApp, route_ptr: ptr, route_len: u64) -> bool {
    // base = PREFIX === "" ? "/" : PREFIX.startsWith("/") ? PREFIX : `/${PREFIX}`
    let base = ByteBuf { bytes: [0u8; 40960], len: 0 };
    if app.prefix.len == 0 {
        buf_append_lit(&base, STR_PTR("/"), STR_LEN("/"));
    } else if app.prefix.bytes[0] == 47 {
        buf_append_lit(&base, &app.prefix.bytes, app.prefix.len);
    } else {
        buf_append_lit(&base, STR_PTR("/"), STR_LEN("/"));
        buf_append_lit(&base, &app.prefix.bytes, app.prefix.len);
    };
    if base.len == 1 {
        return req.path.len == route_len && bytes_eq(req.path.bytes, route_ptr, route_len);
    };
    if !starts_with(&req.path.bytes, req.path.len, &base.bytes, base.len) { return false; };
    let rest_len = req.path.len - base.len;
    let rest: ptr = PTR_NULL();
    PTR_BYTE_ADD(rest, req.path.bytes, base.len);
    // Hono route(base, v1) joins base + "/v1/..." — remainder starts at the
    // slash boundary; TS registers v1 paths as "/v1/...".
    return rest_len == route_len && bytes_eq(rest, route_ptr, route_len);
}

fn duck2api_handle_request(app: &DuckApp, req: &DuckHttpRequest) -> void {
    // app.get("/", ...) / app.get("/ping", ...) — outside the prefix mount
    if method_is(req, STR_PTR("GET"), STR_LEN("GET")) && path_eq(&req.path, STR_PTR("/"), STR_LEN("/")) {
        sa_http_respond_text(200, STR_PTR("duck2api-ts ok"), STR_LEN("duck2api-ts ok"));
        return;
    };
    if method_is(req, STR_PTR("GET"), STR_LEN("GET")) && path_eq(&req.path, STR_PTR("/ping"), STR_LEN("/ping")) {
        sa_http_respond_text(200, STR_PTR("pong"), STR_LEN("pong"));
        return;
    };
    let is_chat = route_match(req, app, STR_PTR("/v1/chat/completions"), STR_LEN("/v1/chat/completions"));
    let is_responses = route_match(req, app, STR_PTR("/v1/responses"), STR_LEN("/v1/responses"));
    let is_models = route_match(req, app, STR_PTR("/v1/models"), STR_LEN("/v1/models"));
    let is_images = route_match(req, app, STR_PTR("/v1/images/generations"), STR_LEN("/v1/images/generations"));
    if !is_chat && !is_responses && !is_models && !is_images {
        sa_http_respond_text(404, STR_PTR("404 Not Found"), STR_LEN("404 Not Found"));
        return;
    };
    // v1.use("*", Authorization): empty allow-list means open access.
    if app.api_keys_len > 0 {
        let hp: ptr = PTR_NULL();
        let hl: u64 = 0;
        req_header(req, STR_PTR("authorization"), STR_LEN("authorization"), &hp, &hl);
        let token_ptr = hp;
        let token_len = hl;
        if hl >= 7 && bytes_eq_str(hp, 7, STR_PTR("Bearer "), STR_LEN("Bearer ")) {
            PTR_BYTE_ADD(token_ptr, hp, 7);
            token_len = hl - 7;
        };
        if !api_key_allowed(app, token_ptr, token_len) {
            let err = ByteBuf { bytes: [0u8; 40960], len: 0 };
            api_error(&err, STR_PTR("Unauthorized"), STR_LEN("Unauthorized"), STR_PTR("authentication_error"), STR_LEN("authentication_error"), true, STR_PTR("unauthorized"), STR_LEN("unauthorized"));
            sa_http_respond_json(401, &err.bytes, err.len);
            return;
        };
    };
    if method_is(req, STR_PTR("OPTIONS"), STR_LEN("OPTIONS")) {
        sa_http_respond_empty(204);
        return;
    };
    if is_chat && method_is(req, STR_PTR("POST"), STR_LEN("POST")) {
        handle_chat_completions(app, req);
        return;
    };
    if is_responses && method_is(req, STR_PTR("POST"), STR_LEN("POST")) {
        handle_responses(app, req);
        return;
    };
    if is_models && method_is(req, STR_PTR("GET"), STR_LEN("GET")) {
        let json = ByteBuf { bytes: [0u8; 40960], len: 0 };
        list_models(&json);
        sa_http_respond_json(200, &json.bytes, json.len);
        return;
    };
    if is_images && method_is(req, STR_PTR("POST"), STR_LEN("POST")) {
        handle_images_generations(app, req);
        return;
    };
    sa_http_respond_text(404, STR_PTR("404 Not Found"), STR_LEN("404 Not Found"));
}
