    let result = ImageStreamResult { text: ByteBuf { bytes: [0u8; 40960], len: 0 }, arena: ByteBuf { bytes: [0u8; 40960], len: 0 }, images: [ExtractedImage { b64_off: 0, b64_len: 0, has_format: false, format: [0u8; 32], format_len: 0, has_width: false, width: 0, has_height: false, height: 0 }; 32], images_len: 0 };
    let __ap193: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap193, sse_text.bytes, 0);
    read_image_response(&result, __ap193, sse_text.len);
    let json = ByteBuf { bytes: [0u8; 40960], len: 0 };
    buf_append_lit(&json, STR_PTR("{\"created\":"), STR_LEN("{\"created\":"));
    // Math.floor(Date.now() / 1000) — @ts_math_rounding (op 0 = floor)
    buf_append_u64(&json, ts_math_rounding(((sa_time_unix_ms() as u64) as f64) / 1000.0, 0));
    buf_append_lit(&json, STR_PTR(",\"data\":["), STR_LEN(",\"data\":["));
    let emitted: u64 = 0;
    for ii in 0..result.images_len {
        if result.images[ii].b64_len == 0 { continue; };
        if emitted > 0 { buf_append_lit(&json, STR_PTR(","), STR_LEN(",")); };
        emitted = emitted + 1;
        buf_append_lit(&json, STR_PTR("{\"b64_json\":\""), STR_LEN("{\"b64_json\":\""));
        let b64p: ptr = PTR_NULL();
        PTR_BYTE_ADD(b64p, result.arena.bytes, result.images[ii].b64_off);
        buf_append_escaped(&json, b64p, result.images[ii].b64_len);
        buf_append_lit(&json, STR_PTR("\",\"revised_prompt\":\""), STR_LEN("\",\"revised_prompt\":\""));
        let __ap194: ptr = PTR_NULL();
        PTR_BYTE_ADD(__ap194, result.text.bytes, 0);
        buf_append_escaped(&json, __ap194, result.text.len);
        buf_append_lit(&json, STR_PTR("\"}"), STR_LEN("\"}"));
    }
    buf_append_lit(&json, STR_PTR("]}"), STR_LEN("]}"));
    if emitted == 0 {
        let err = ByteBuf { bytes: [0u8; 40960], len: 0 };
        api_error(&err, STR_PTR("No images were generated"), STR_LEN("No images were generated"), STR_PTR("internal_server_error"), STR_LEN("internal_server_error"), true, STR_PTR("no_images"), STR_LEN("no_images"));
        let __ap_rsp18: ptr = PTR_NULL();
        PTR_BYTE_ADD(__ap_rsp18, err.bytes, 0);
        sa_http_respond_json(500, __ap_rsp18, err.len);
        return;
    };
    let __ap_rsp19: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap_rsp19, json.bytes, 0);
    sa_http_respond_json(200, __ap_rsp19, json.len);
}

// ---------------------------------------------------------------------------
// TS: export function createApp() — route table + v1 auth middleware
// ---------------------------------------------------------------------------
fn path_eq(path: &StrField, lit_ptr: ptr, lit_len: u64) -> bool {
    let __ap195: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap195, path.bytes, 0);
    return path.len == lit_len && bytes_eq3(__ap195, lit_ptr, lit_len);
}

fn method_is(req: &DuckHttpRequest, lit_ptr: ptr, lit_len: u64) -> bool {
    let __ap196: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap196, req.method.bytes, 0);
    return req.method.len == lit_len && bytes_eq3(__ap196, lit_ptr, lit_len);
}

// Joins base + route: base "/" means the route path itself; otherwise the
// request path must start with base and the remainder is matched.
fn route_match(req: &DuckHttpRequest, app: &DuckApp, route_ptr: ptr, route_len: u64) -> bool {
    // base = PREFIX === "" ? "/" : PREFIX.startsWith("/") ? PREFIX : `/${PREFIX}`
    let base = ByteBuf { bytes: [0u8; 40960], len: 0 };
    if app.prefix.len == 0 {
        buf_append_lit(&base, STR_PTR("/"), STR_LEN("/"));
    } else if app.prefix.bytes[0] == 47 {
        let __ap197: ptr = PTR_NULL();
        PTR_BYTE_ADD(__ap197, app.prefix.bytes, 0);
        buf_append_lit(&base, __ap197, app.prefix.len);
    } else {
        buf_append_lit(&base, STR_PTR("/"), STR_LEN("/"));
        let __ap198: ptr = PTR_NULL();
        PTR_BYTE_ADD(__ap198, app.prefix.bytes, 0);
        buf_append_lit(&base, __ap198, app.prefix.len);
    };
    if base.len == 1 {
        let __ap199: ptr = PTR_NULL();
        PTR_BYTE_ADD(__ap199, req.path.bytes, 0);
        return req.path.len == route_len && bytes_eq3(__ap199, route_ptr, route_len);
    };
    let __ap201: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap201, req.path.bytes, 0);
    let __ap200: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap200, base.bytes, 0);
    if !starts_with(__ap201, req.path.len, __ap200, base.len) { return false; };
    let rest_len = req.path.len - base.len;
    let rest: ptr = PTR_NULL();
    PTR_BYTE_ADD(rest, req.path.bytes, base.len);
    // Hono route(base, v1) joins base + "/v1/..." — remainder starts at the
    // slash boundary; TS registers v1 paths as "/v1/...".
    return rest_len == route_len && bytes_eq3(rest, route_ptr, route_len);
}

fn duck2api_handle_request(app: &DuckApp, req: &DuckHttpRequest) -> void {
    // app.get("/", ...) / app.get("/ping", ...) — outside the prefix mount
    if method_is(req, STR_PTR("GET"), STR_LEN("GET")) && path_eq(&req.path, STR_PTR("/"), STR_LEN("/")) {
        sa_http_respond_text(200, STR_PTR("duck2api-ts ok"), STR_LEN("duck2api-ts ok"));
        return;
    };
    if method_is(req, STR_PTR("GET"), STR_LEN("GET")) && path_eq(&req.path, STR_PTR("/ping"), STR_LEN("/ping")) {
        sa_http_respond_text(200, STR_PTR("pong"), STR_LEN("pong"));
        return;
    };
    let is_chat = route_match(req, app, STR_PTR("/v1/chat/completions"), STR_LEN("/v1/chat/completions"));
    let is_responses = route_match(req, app, STR_PTR("/v1/responses"), STR_LEN("/v1/responses"));
    let is_models = route_match(req, app, STR_PTR("/v1/models"), STR_LEN("/v1/models"));
    let is_images = route_match(req, app, STR_PTR("/v1/images/generations"), STR_LEN("/v1/images/generations"));
    if !is_chat && !is_responses && !is_models && !is_images {
        sa_http_respond_text(404, STR_PTR("404 Not Found"), STR_LEN("404 Not Found"));
        return;
    };
    // v1.use("*", Authorization): empty allow-list means open access.
    if app.api_keys_len > 0 {
        let hp: ptr = PTR_NULL();
        let hl: u64 = 0;
        req_header(req, STR_PTR("authorization"), STR_LEN("authorization"), &hp, &hl);
        let token_ptr = hp;
        let token_len = hl;
        if hl >= 7 && bytes_eq_str(hp, 7, STR_PTR("Bearer "), STR_LEN("Bearer ")) {
            PTR_BYTE_ADD(token_ptr, hp, 7);
            token_len = hl - 7;
        };
        if !api_key_allowed(app, token_ptr, token_len) {
            let err = ByteBuf { bytes: [0u8; 40960], len: 0 };
            api_error(&err, STR_PTR("Unauthorized"), STR_LEN("Unauthorized"), STR_PTR("authentication_error"), STR_LEN("authentication_error"), true, STR_PTR("unauthorized"), STR_LEN("unauthorized"));
            let __ap_rsp20: ptr = PTR_NULL();
            PTR_BYTE_ADD(__ap_rsp20, err.bytes, 0);
            sa_http_respond_json(401, __ap_rsp20, err.len);
            return;
        };
    };
    if method_is(req, STR_PTR("OPTIONS"), STR_LEN("OPTIONS")) {
        sa_http_respond_empty(204);
        return;
    };
    if is_chat && method_is(req, STR_PTR("POST"), STR_LEN("POST")) {
        handle_chat_completions(app, req);
        return;
    };
    if is_responses && method_is(req, STR_PTR("POST"), STR_LEN("POST")) {
        handle_responses(app, req);
        return;
    };
    if is_models && method_is(req, STR_PTR("GET"), STR_LEN("GET")) {
        let json = ByteBuf { bytes: [0u8; 40960], len: 0 };
        list_models(&json);
        let __ap_rsp21: ptr = PTR_NULL();
        PTR_BYTE_ADD(__ap_rsp21, json.bytes, 0);
        sa_http_respond_json(200, __ap_rsp21, json.len);
        return;
    };
    if is_images && method_is(req, STR_PTR("POST"), STR_LEN("POST")) {
        handle_images_generations(app, req);
        return;
    };
    sa_http_respond_text(404, STR_PTR("404 Not Found"), STR_LEN("404 Not Found"));
}


// ---------------------------------------------------------------------------
// Ambient HTTP layer (was intent externs sa_http_respond_* /
// sa_http_set_header / sa_http_begin_sse / sa_http_end_sse /
// sa_http_request_header). The std http server (http_server.sai v2)
// is request-scoped, so the ambient "current request" is held in
// cells by serve_app: "duck.http.req" (u64, req ptr value),
// "duck.http.stream" (u64, open stream resp ptr value, 0 = none),
// "duck.http.hdrs" (bytes cell: pending response headers as
// length-prefixed records). Handlers set headers, then respond_*
// builds a v2 response for the current request, applies the pending
// headers, sends, and clears them — mirroring the TS fetch-handler
// Response construction. Timeouts: 30000 ms on send/stream ops.
// ---------------------------------------------------------------------------
fn srv_cell_fixed(out: &ByteBuf, name_ptr: ptr, name_len: u64) -> ptr {
    buf_reset(out);
    buf_append_lit(out, name_ptr, name_len);
    let p: ptr = PTR_NULL();
    PTR_BYTE_ADD(p, out.bytes, 0);
    return p;
}

fn srv_current_req() -> u64 {
    let nm = ByteBuf { bytes: [0u8; 40960], len: 0 };
    let cp = srv_cell_fixed(&nm, STR_PTR("duck.http.req"), STR_LEN("duck.http.req"));
    let v: u64 = 0;
    if sa_global_u64_get(cp, nm.len, &v) != 0 { return 0; };
    return v;
}

fn srv_set_current_req(v: u64) -> void {
    let nm = ByteBuf { bytes: [0u8; 40960], len: 0 };
    let cp = srv_cell_fixed(&nm, STR_PTR("duck.http.req"), STR_LEN("duck.http.req"));
    sa_global_u64_set(cp, nm.len, v);
}

fn srv_pending_reset() -> void {
    let nm = ByteBuf { bytes: [0u8; 40960], len: 0 };
    let cp = srv_cell_fixed(&nm, STR_PTR("duck.http.hdrs"), STR_LEN("duck.http.hdrs"));
    sa_global_bytes_set(cp, nm.len, PTR_NULL(), 0);
}

fn sa_http_set_header(name_ptr: ptr, name_len: u64, val_ptr: ptr, val_len: u64) -> void {
    let segs = ByteBuf { bytes: [0u8; 40960], len: 0 };
    let nm = ByteBuf { bytes: [0u8; 40960], len: 0 };
    let cp = srv_cell_fixed(&nm, STR_PTR("duck.http.hdrs"), STR_LEN("duck.http.hdrs"));
    let sp: ptr = PTR_NULL();
    PTR_BYTE_ADD(sp, segs.bytes, 0);
    let cur: u64 = 0;
    if sa_global_bytes_get(cp, nm.len, sp, 40960, &cur) == 0 { segs.len = cur; };
    for k in 0..8 {
        buf_append_byte(&segs, ((name_len >> (k * 8)) & 255) as u8);
    }
    buf_append_lit(&segs, name_ptr, name_len);
    for k in 0..8 {
        buf_append_byte(&segs, ((val_len >> (k * 8)) & 255) as u8);
    }
    buf_append_lit(&segs, val_ptr, val_len);
    let wp: ptr = PTR_NULL();
    PTR_BYTE_ADD(wp, segs.bytes, 0);
    let cp2 = srv_cell_fixed(&nm, STR_PTR("duck.http.hdrs"), STR_LEN("duck.http.hdrs"));
    sa_global_bytes_set(cp2, nm.len, wp, segs.len);
}

fn srv_apply_pending(resp: ptr, is_stream: bool) -> void {
    let segs = ByteBuf { bytes: [0u8; 40960], len: 0 };
    let nm = ByteBuf { bytes: [0u8; 40960], len: 0 };
    let cp = srv_cell_fixed(&nm, STR_PTR("duck.http.hdrs"), STR_LEN("duck.http.hdrs"));
    let sp: ptr = PTR_NULL();
    PTR_BYTE_ADD(sp, segs.bytes, 0);
    let total: u64 = 0;
    if sa_global_bytes_get(cp, nm.len, sp, 40960, &total) != 0 { return; };
    segs.len = total;
    let off: u64 = 0;
    while off + 8 <= segs.len {
        let nl: u64 = 0;
        for k in 0..8 {
            nl = nl | ((segs.bytes[off + k] as u64) << (k * 8));
        }
        let np: ptr = PTR_NULL();
        PTR_BYTE_ADD(np, segs.bytes, off + 8);
        let voff = off + 8 + nl;
        if voff + 8 > segs.len { break; };
        let vl: u64 = 0;
        for k in 0..8 {
            vl = vl | ((segs.bytes[voff + k] as u64) << (k * 8));
        }
        let vp: ptr = PTR_NULL();
        PTR_BYTE_ADD(vp, segs.bytes, voff + 8);
        if is_stream {
            sa_http_server_resp_stream_add_header_v2(resp, np, nl, vp, vl);
        } else {
            sa_http_server_resp_add_header_v2(resp, np, nl, vp, vl);
        };
        off = voff + 8 + vl;
    }
}

fn srv_respond(status: u64, ct_ptr: ptr, ct_len: u64, body_ptr: ptr, body_len: u64) -> void {
    let req_v = srv_current_req();
    if req_v == 0 { return; };
    let req: ptr = PTR_NULL();
    PTR_CAST(req, req_v);
    let resp: ptr = PTR_NULL();
    if sa_http_server_resp_new_v2(req, status as u16, &resp) != 0 || resp == PTR_NULL() { return; };
    srv_apply_pending(resp, false);
    if ct_len > 0 {
        sa_http_server_resp_add_header_v2(resp, STR_PTR("content-type"), STR_LEN("content-type"), ct_ptr, ct_len);
    };
    sa_http_server_resp_send_v2(resp, body_ptr, body_len, 30000);
    sa_http_server_resp_free_v2(resp);
    srv_pending_reset();
}

fn sa_http_respond_json(status: u64, body_ptr: ptr, body_len: u64) -> void {
    srv_respond(status, STR_PTR("application/json"), STR_LEN("application/json"), body_ptr, body_len);
}

fn sa_http_respond_text(status: u64, body_ptr: ptr, body_len: u64) -> void {
    srv_respond(status, STR_PTR("text/plain;charset=utf-8"), STR_LEN("text/plain;charset=utf-8"), body_ptr, body_len);
}

fn sa_http_respond_empty(status: u64) -> void {
    srv_respond(status, PTR_NULL(), 0, PTR_NULL(), 0);
}

fn sa_http_begin_sse(ct_ptr: ptr, ct_len: u64) -> u64 {
    let req_v = srv_current_req();
    if req_v == 0 { return 0; };
    let req: ptr = PTR_NULL();
    PTR_CAST(req, req_v);
    let resp: ptr = PTR_NULL();
    if sa_http_server_resp_stream_new_v2(req, 200, &resp) != 0 || resp == PTR_NULL() { return 0; };
    srv_apply_pending(resp, true);
    if ct_len > 0 {
        sa_http_server_resp_stream_add_header_v2(resp, STR_PTR("content-type"), STR_LEN("content-type"), ct_ptr, ct_len);
    };
    srv_pending_reset();
    let rv: u64 = 0;
    PTR_ADDR(rv, resp);
    let nm = ByteBuf { bytes: [0u8; 40960], len: 0 };
    let cp = srv_cell_fixed(&nm, STR_PTR("duck.http.stream"), STR_LEN("duck.http.stream"));
    sa_global_u64_set(cp, nm.len, rv);
    return sa_sink_register_raw(rv);
}

// Ends the SSE stream behind a sink id (the sink registry holds the
// stream resp ptr); serve_app's cleanup sees the cleared cell and
// does not end it twice.
fn sa_http_end_sse(sink: u64) -> void {
    let nm = ByteBuf { bytes: [0u8; 40960], len: 0 };
    let cp = srv_cell_fixed(&nm, STR_PTR("sink.raw."), STR_LEN("sink.raw."));
    // rebuild "sink.raw.<sink>" with the id appended
    buf_reset(&nm);
    buf_append_lit(&nm, STR_PTR("sink.raw."), STR_LEN("sink.raw."));
    buf_append_u64(&nm, sink);
    let np: ptr = PTR_NULL();
    PTR_BYTE_ADD(np, nm.bytes, 0);
    let rv: u64 = 0;
    if sa_global_u64_get(np, nm.len, &rv) != 0 || rv == 0 { return; };
    let resp: ptr = PTR_NULL();
    PTR_CAST(resp, rv);
    sa_http_server_resp_stream_end_v2(resp, 30000);
    sa_http_server_resp_stream_free_v2(resp);
    let cp2 = srv_cell_fixed(&nm, STR_PTR("duck.http.stream"), STR_LEN("duck.http.stream"));
    sa_global_u64_set(cp2, nm.len, 0);
}

fn sa_http_request_header(req_value: u64, name_ptr: ptr, name_len: u64, out_ptr: &ptr, out_len: &u64) -> i32 {
    *out_ptr = PTR_NULL();
    *out_len = 0;
    if req_value == 0 { return 1; };
    let req: ptr = PTR_NULL();
    PTR_CAST(req, req_value);
    if sa_http_server_req_get_header(req, name_ptr, name_len, out_ptr, out_len) != 0 {
        *out_ptr = PTR_NULL();
        *out_len = 0;
        return 1;
    };
    return 0;
}

// TS/Bun entrypoint: accept loop. Each request becomes a
// DuckHttpRequest (method/path/body copied out, sink = the raw
// request ptr value for req_header), the ambient cells are set, the
// route handler runs, and any SSE stream left open is ended.
fn serve_app(app: &DuckApp, port: u64) -> i32 {
    let server: ptr = PTR_NULL();
    if sa_http_server_new_v2(&server) != 0 { return 1; };
    if sa_http_server_start_v2(server, STR_PTR("0.0.0.0"), STR_LEN("0.0.0.0"), port as u16) != 0 { return 1; };
    while 1 == 1 {
        let req: ptr = PTR_NULL();
        if sa_http_server_accept_v2(server, 1000, &req) != 0 || req == PTR_NULL() { continue; };
        let dreq = DuckHttpRequest { method: StrField { bytes: [0u8; 512], len: 0 }, path: StrField { bytes: [0u8; 512], len: 0 }, body: ByteBuf { bytes: [0u8; 40960], len: 0 }, sink: 0 };
        let mp: ptr = PTR_NULL();
        let ml: u64 = 0;
        if sa_http_server_req_get_method(req, &mp, &ml) == 0 { str_field_set(&dreq.method, mp, ml); };
        let pp: ptr = PTR_NULL();
        let pl: u64 = 0;
        if sa_http_server_req_get_path(req, &pp, &pl) == 0 { str_field_set(&dreq.path, pp, pl); };
        let bp: ptr = PTR_NULL();
        let bl: u64 = 0;
        if sa_http_server_req_get_body(req, &bp, &bl) == 0 && bl > 0 { buf_append_lit(&dreq.body, bp, bl); };
        let req_v: u64 = 0;
        PTR_ADDR(req_v, req);
        dreq.sink = req_v;
        srv_set_current_req(req_v);
        srv_pending_reset();
        let nm = ByteBuf { bytes: [0u8; 40960], len: 0 };
        let scp = srv_cell_fixed(&nm, STR_PTR("duck.http.stream"), STR_LEN("duck.http.stream"));
        sa_global_u64_set(scp, nm.len, 0);
        duck2api_handle_request(app, &dreq);
        let sv: u64 = 0;
        let scp2 = srv_cell_fixed(&nm, STR_PTR("duck.http.stream"), STR_LEN("duck.http.stream"));
        if sa_global_u64_get(scp2, nm.len, &sv) == 0 && sv != 0 {
            let sresp: ptr = PTR_NULL();
            PTR_CAST(sresp, sv);
            sa_http_server_resp_stream_end_v2(sresp, 30000);
            sa_http_server_resp_stream_free_v2(sresp);
            let scp3 = srv_cell_fixed(&nm, STR_PTR("duck.http.stream"), STR_LEN("duck.http.stream"));
            sa_global_u64_set(scp3, nm.len, 0);
        };
        srv_set_current_req(0);
        sa_http_server_req_free_v2(req);
    }
    return 0;
}
