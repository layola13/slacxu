// Converted 1:1 from apps/duck2api/src/index.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "sa_std/io/print.sai"
@import "sa_std/env.sai"
@import "server.sla"

// TS source:
//   import { createApp } from "./server.js";
//   const port = Number(process.env["PORT"] ?? 44090);
//   const app = createApp();
//   export default { port, fetch: app.fetch };
//   console.log(`duck2api-ts listening on :${port}`);
// DEFECT: Bun entrypoint convention (export default { port, fetch }) has no
// SLA counterpart; approximated with main() that resolves the port, builds
// the app, logs, and hands the fetch handler to the std http server in
// server.sla (serve_app).

fn main() -> i32 {
    let port: u64 = 44090;
    let e_port = sa_env_get(STR_PTR("PORT"), STR_LEN("PORT"));
    if e_port != 0 {
        let pp: ptr = sa_env_buffer_data(e_port);
        let pl = sa_env_buffer_len(e_port);
        if pl > 0 && pl < 6 {
            let parsed: u64 = 0;
            let ok = true;
            for ci in 0..pl {
                let cb: u8 = 0;
                PTR_BYTE_AT(cb, pp, ci);
                if cb < 48 || cb > 57 { ok = false; } else { parsed = parsed * 10 + (cb - 48) as u64; };
            }
            if ok && parsed > 0 { port = parsed; };
        };
    };
    let app = App { state_len: 0 };
    create_app(&app);
    println("duck2api-ts listening on :");
    // DEFECT: template-string interpolation of the port in the log line is
    // approximated (number formatting helper pending).
    return serve_app(&app, port);
}
