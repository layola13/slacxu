// Port of E:\projects\duck2api\internal\duckgo\vqd.go.
// DEFECT: node:vm sandboxed JS execution (vm.createContext / runInContext,
// browser prelude, thenable awaiting, Promise.race timeouts, setTimeout)
// has NO sa_std counterpart. The whole challenge execution is one intent
// extern sa_vqd_execute_challenge(js, ua, origin, stack, &payload_out)
// that a future JS-engine plugin/std surface must provide; the host-side
// string plumbing (env defaults, base64, fallback format, UA stamping
// contract) is converted faithfully around it.
// DEFECT: async/await -> synchronous functions returning status codes.

fn default_vqd_user_agent() -> ptr { return STR_PTR("Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/146.0.0.0 Safari/537.36"); }
fn default_vqd_stack() -> ptr { return STR_PTR("Error\nat l (https://duck.ai/dist/duckai-dist/entry.duckai.c0a8c794abcbc8ee2d3c.js:2:1446307)\nat async https://duck.ai/dist/duckai-dist/entry.duckai.c0a8c794abcbc8ee2d3c.js:2:1294181"); }
fn default_vqd_origin() -> ptr { return STR_PTR("https://duck.ai"); }

fn vqd_env_or(key_ptr: ptr, key_len: u64, def_ptr: ptr, def_len: u64, out: &ByteBuf) -> void {
    buf_reset(out);
    let h = sa_env_get(key_ptr, key_len);
    if h != 0 {
        let vp: ptr = sa_env_buffer_data(h);
        let vl = sa_env_buffer_len(h);
        if vl > 0 {
            buf_append_lit(out, vp, vl);
            return;
        };
    };
    buf_append_lit(out, def_ptr, def_len);
}

// TS: function vqdUserAgent(): string  (process.env["X_USER_AGENT"] || DEFAULT)
fn vqd_user_agent(out: &ByteBuf) -> void {
    vqd_env_or(STR_PTR("X_USER_AGENT"), STR_LEN("X_USER_AGENT"), default_vqd_user_agent(), STR_LEN("Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/146.0.0.0 Safari/537.36"), out);
}

// TS: function vqdStack(): string
fn vqd_stack(out: &ByteBuf) -> void {
    vqd_env_or(STR_PTR("X_VQD_STACK"), STR_LEN("X_VQD_STACK"), default_vqd_stack(), STR_LEN("Error\nat l (https://duck.ai/dist/duckai-dist/entry.duckai.c0a8c794abcbc8ee2d3c.js:2:1446307)\nat async https://duck.ai/dist/duckai-dist/entry.duckai.c0a8c794abcbc8ee2d3c.js:2:1294181"), out);
}

// TS: function vqdOrigin(): string
fn vqd_origin(out: &ByteBuf) -> void {
    vqd_env_or(STR_PTR("X_VQD_ORIGIN"), STR_LEN("X_VQD_ORIGIN"), default_vqd_origin(), STR_LEN("https://duck.ai"), out);
}

// TS: export function goSha256Base64(value: string): string
// createHash("sha256").update(value, "utf8").digest("base64")
fn go_sha256_base64(out: &ByteBuf, val_ptr: ptr, val_len: u64) -> void {
    buf_reset(out);
    // DEFECT: sha256 + base64 — intent extern sa_crypto_sha256_base64.
    sa_crypto_sha256_base64(val_ptr, val_len, out);
}

// TS: function jsErrorString(err: unknown): string
// Error -> stack || message; object -> .stack || .message; else "<empty>".
// In the intent-extern model the engine reports its error text directly,
// so this is an identity passthrough kept for 1:1 structure.
fn js_error_string(out: &ByteBuf, err_ptr: ptr, err_len: u64) -> void {
    buf_reset(out);
    if err_len == 0 {
        buf_append_lit(out, STR_PTR("<empty>"), STR_LEN("<empty>"));
        return;
    };
    buf_append_lit(out, err_ptr, err_len);
}

// TS: async function executeVQDHashScript(jsCode: string): Promise<string>
// Runs prelude + challenge + UA stamp + mutation script inside the vm.
// DEFECT: the entire vm sequence is the single intent extern call below;
// its contract: 5000 ms timeouts per stage, sandbox globals __goUserAgent /
// __goOrigin / __goStack / __goSha256Base64 / __goBtoa / __goAtob,
// __vqd_result assignment, client_hashes[0] = UA stamp before mutation,
// __vqdDurationMs exposed as a string. Returns i32 0 ok / 1 error (err out).
fn execute_vqd_hash_script(out: &ByteBuf, err: &ByteBuf, js_ptr: ptr, js_len: u64) -> i32 {
    // DEFECT (B-class gap, four-source verified 2026-10-27): the TS
    // runs the decoded challenge script in node:vm behind a browser
    // prelude + result-mutation script (vqd-scripts.sla). sa_std has
    // no JS runtime surface — zero hits in sala docs, sa_plugin_sla
    // demos/tests, and the sa_std inventory — and the intent extern
    // sa_vqd_execute_challenge does not exist. Explicit unsupported:
    // err carries the reason, the return is the error status, and
    // generate_vqd_hash takes its TS error-fallback path. When std
    // grows a JS surface, this fn is the only seam to rebind.
    buf_reset(out);
    buf_reset(err);
    buf_append_lit(err, STR_PTR("vqd challenge execution unsupported: no JS runtime in sa_std"), STR_LEN("vqd challenge execution unsupported: no JS runtime in sa_std"));
    return 1;
}

// TS: export async function generateVQDHash(vqdHashRequest: string): Promise<string>
// Returns i32: 0 ok (base64 header value in out), 1 error (err out).
fn generate_vqd_hash(out: &ByteBuf, err: &ByteBuf, req_ptr: ptr, req_len: u64) -> i32 {
    buf_reset(out);
    buf_reset(err);
    if req_len == 0 {
        buf_append_lit(err, STR_PTR("empty vqd hash request"), STR_LEN("empty vqd hash request"));
        return 1;
    };
    // jsCode = Buffer.from(vqdHashRequest, "base64").toString("utf8")
    let js = ByteBuf { bytes: [0u8; 40960], len: 0 };
    if sa_base64_decode(&js, req_ptr, req_len) != 0 {
        buf_append_lit(err, STR_PTR("decode vqd hash request: invalid base64"), STR_LEN("decode vqd hash request: invalid base64"));
        return 1;
    };
    let payload = ByteBuf { bytes: [0u8; 40960], len: 0 };
    let exec_err = ByteBuf { bytes: [0u8; 40960], len: 0 };
    let __ap157: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap157, js.bytes, 0);
    if execute_vqd_hash_script(&payload, &exec_err, __ap157, js.len) == 0 {
        // return Buffer.from(payload, "utf8").toString("base64")
        let __ap_b64p: ptr = PTR_NULL();
        PTR_BYTE_ADD(__ap_b64p, payload.bytes, 0);
        sa_base64_encode(__ap_b64p, payload.len, out);
        return 0;
    };
    // Error fallback (Go/JS c() format): btoa(js + "::" + msg + "::" + stack + "::" + origin)
    let msg = ByteBuf { bytes: [0u8; 40960], len: 0 };
    let __ap158: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap158, exec_err.bytes, 0);
    js_error_string(&msg, __ap158, exec_err.len);
    let stack = ByteBuf { bytes: [0u8; 40960], len: 0 };
    vqd_stack(&stack);
    let origin = ByteBuf { bytes: [0u8; 40960], len: 0 };
    vqd_origin(&origin);
    let fallback = ByteBuf { bytes: [0u8; 40960], len: 0 };
    buf_append_buf(&fallback, &js);
    buf_append_lit(&fallback, STR_PTR("::"), STR_LEN("::"));
    buf_append_buf(&fallback, &msg);
    buf_append_lit(&fallback, STR_PTR("::"), STR_LEN("::"));
    buf_append_buf(&fallback, &stack);
    buf_append_lit(&fallback, STR_PTR("::"), STR_LEN("::"));
    buf_append_buf(&fallback, &origin);
    let __ap_b64f: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap_b64f, fallback.bytes, 0);
    sa_base64_encode(__ap_b64f, fallback.len, out);
    return 0;
}
