        if !chat_write_chunk(opts.sink, &json) { return 1; };
        let ujson = ByteBuf { bytes: [0u8; 40960], len: 0 };
        let __ap55: ptr = PTR_NULL();
        PTR_BYTE_ADD(__ap55, opts.request_model.bytes, 0);
        let __ap54: ptr = PTR_NULL();
        PTR_BYTE_ADD(__ap54, opts.stats.effort.bytes, 0);
        usage_chunk(&ujson, __ap55, opts.request_model.len, opts.stats.prompt_tokens, output_tokens, opts.stats.cached_tokens, st.ttft_ms, total_ms, __ap54, opts.stats.effort.len);
        if !chat_write_chunk(opts.sink, &ujson) { return 1; };
    };
    result.text = st.text;
    result.output_tokens = output_tokens;
    result.ttft_ms = st.ttft_ms;
    result.total_ms = total_ms;
