    buf_append_lit(&done_item, STR_PTR("{\"id\":\""), STR_LEN("{\"id\":\""));
    let __ap66: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap66, item_id.bytes, 0);
    buf_append_escaped(&done_item, __ap66, item_id.len);
    buf_append_lit(&done_item, STR_PTR("\",\"type\":\"function_call\",\"status\":\"completed\",\"call_id\":\""), STR_LEN("\",\"type\":\"function_call\",\"status\":\"completed\",\"call_id\":\""));
    let __ap67: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap67, call.id, 0);
    buf_append_escaped(&done_item, __ap67, call.id_len);
