    PTR_BYTE_ADD(__ap51, st.text.bytes, 0);
    let output_tokens = count_token(__ap51, st.text.len);
    let total_ms = (sa_time_unix_ms() as u64) - opts.stats.start;
    if opts.stream {
        let finish = ByteBuf { bytes: [0u8; 40960], len: 0 };
        if st.tool_calls.len > 0 {
