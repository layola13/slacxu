// Converted 1:1 from apps/duck2api/src/duckgo/image.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "sa_std/ptr.sa"
@import "sa_std/encoding/json.sai"
@import "sa_std/string.sa"
@import "response.sla"

// Port of E:\projects\duck2api\internal\duckgo\image.go (ReadImageResponse).
// DEFECT: ExtractedImage.b64 can be megabytes of base64; images are kept as
// (offset, len) spans into a shared arena buffer inside the result struct,
// and the per-result image count is capped at 32 (TS array is unbounded).

struct ExtractedImage {
    b64_off: u64,
    b64_len: u64,
    has_format: bool,
    format: [u8; 32],
    format_len: u64,
    has_width: bool,
    width: u64,
    has_height: bool,
    height: u64,
}

// TS: export interface ImageStreamResult { text: string; images: ExtractedImage[] }
struct ImageStreamResult {
    text: ByteBuf,
    arena: ByteBuf,
    images: [ExtractedImage; 32],
    images_len: u64,
}

fn image_result_reset(r: &ImageStreamResult) -> void {
    r.text.len = 0;
    r.arena.len = 0;
    r.images_len = 0;
}

// Reads an image-data JSON node (UpstreamImageData shape) into img.
// Returns true when a non-empty b64Image was present.
// arena_base is the arena length before this call (b64 copied by caller
// via image_arena_copy when this returns true — see parse_image_event).
fn image_data_of(r: &ImageStreamResult, data_node: u64, img: &ExtractedImage) -> bool {
    img.has_format = false;
    img.has_width = false;
    img.has_height = false;
    if data_node == 0 { return false; };
    let bp: ptr = PTR_NULL();
    let bl: u64 = 0;
    sa_json_object_get_string(data_node, STR_PTR("b64Image"), STR_LEN("b64Image"), &bp, &bl);
    if bl == 0 { return false; };
    img.b64_off = r.arena.len;
    img.b64_len = bl;
    buf_append_lit(&r.arena, bp, bl);
    let fp: ptr = PTR_NULL();
    let fl: u64 = 0;
    sa_json_object_get_string(data_node, STR_PTR("format"), STR_LEN("format"), &fp, &fl);
    if fl > 0 {
        img.has_format = true;
        img.format_len = 0;
        for i in 0..fl {
            if img.format_len < 32 {
                let b: u8 = 0;
                PTR_BYTE_AT(b, fp, i);
                img.format[img.format_len] = b;
                img.format_len = img.format_len + 1;
            };
        }
    };
    let w: u64 = 0;
    if sa_json_object_get_i64(data_node, STR_PTR("width"), STR_LEN("width"), &w) == 0 {
        img.has_width = true;
        img.width = w;
    };
    let h: u64 = 0;
    if sa_json_object_get_i64(data_node, STR_PTR("height"), STR_LEN("height"), &h) == 0 {
        img.has_height = true;
        img.height = h;
    };
    return true;
}

fn image_push(r: &ImageStreamResult, img: &ExtractedImage) -> void {
    if r.images_len < 32 {
        r.images[r.images_len] = *img;
        r.images_len = r.images_len + 1;
    };
}

// TS: export function parseImageEvent(line: string): { text: string; images: ExtractedImage[] }
// Appends the event's text into out_text and its images into r.
fn parse_image_event(r: &ImageStreamResult, out_text: &ByteBuf, line_ptr: ptr, line_len: u64) -> void {
    // payload = line.trim(); strip a leading "data:" then trim again.
    let p = ByteBuf { bytes: [0u8; 40960], len: 0 };
    buf_append_lit(&p, line_ptr, line_len);
    buf_trim(&p);
    let __ap30: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap30, p.bytes, 0);
    if p.len >= 5 && bytes_eq_str(__ap30, 5, STR_PTR("data:"), STR_LEN("data:")) {
        let rest = ByteBuf { bytes: [0u8; 40960], len: 0 };
        for i in 5..p.len { buf_append_byte(&rest, p.bytes[i]); }
        p = rest;
        buf_trim(&p);
    };
    if p.len == 0 { return; };
    let __ap31: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap31, p.bytes, 0);
    if starts_with(__ap31, p.len, STR_PTR("[DONE]"), STR_LEN("[DONE]")) { return; };
    let __ap32: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap32, p.bytes, 0);
    if starts_with(__ap32, p.len, STR_PTR("[PING]"), STR_LEN("[PING]")) { return; };
    let __ap33: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap33, p.bytes, 0);
    if starts_with(__ap33, p.len, STR_PTR("[CHAT_TITLE"), STR_LEN("[CHAT_TITLE")) { return; };
    let ev = sa_json_parse(&p.bytes, p.len);
    if ev == 0 { return; };
    let ap: ptr = PTR_NULL();
    let al: u64 = 0;
    sa_json_object_get_string(ev, STR_PTR("action"), STR_LEN("action"), &ap, &al);
    if al != 7 || !bytes_eq_str(ap, al, STR_PTR("success"), STR_LEN("success")) { return; };
    let mp: ptr = PTR_NULL();
    let ml: u64 = 0;
    sa_json_object_get_string(ev, STR_PTR("message"), STR_LEN("message"), &mp, &ml);
    if ml > 0 { buf_append_lit(out_text, mp, ml); };
    let parts: u64 = 0;
    if sa_json_object_get(ev, STR_PTR("parts"), STR_LEN("parts"), &parts) == 0 && parts != 0 {
        let idx: u64 = 0;
        while 1 == 1 {
            let part: u64 = 0;
            if sa_json_array_get(parts, idx, &part) != 0 { break; };
            idx = idx + 1;
            if part == 0 { continue; };
            let tp: ptr = PTR_NULL();
            let tl: u64 = 0;
            sa_json_object_get_string(part, STR_PTR("type"), STR_LEN("type"), &tp, &tl);
            let is_img = (tl == 15 && bytes_eq_str(tp, tl, STR_PTR("generated-image"), STR_LEN("generated-image"))) || (tl == 5 && bytes_eq_str(tp, tl, STR_PTR("image"), STR_LEN("image")));
            if !is_img { continue; };
            let rp: ptr = PTR_NULL();
            let rl: u64 = 0;
            sa_json_object_get_string(part, STR_PTR("result"), STR_LEN("result"), &rp, &rl);
            if rl != 0 {
                let img = ExtractedImage { b64_off: 0, b64_len: 0, has_format: false, format: [0u8; 32], format_len: 0, has_width: false, width: 0, has_height: false, height: 0 };
                img.b64_off = r.arena.len;
                img.b64_len = rl;
                buf_append_lit(&r.arena, rp, rl);
                let fp: ptr = PTR_NULL();
                let fl: u64 = 0;
                sa_json_object_get_string(part, STR_PTR("format"), STR_LEN("format"), &fp, &fl);
                if fl > 0 {
                    img.has_format = true;
                    for i in 0..fl {
                        if img.format_len < 32 {
                            let b: u8 = 0;
                            PTR_BYTE_AT(b, fp, i);
                            img.format[img.format_len] = b;
                            img.format_len = img.format_len + 1;
                        };
                    }
                };
                let w: u64 = 0;
                if sa_json_object_get_i64(part, STR_PTR("width"), STR_LEN("width"), &w) == 0 { img.has_width = true; img.width = w; };
                let h: u64 = 0;
                if sa_json_object_get_i64(part, STR_PTR("height"), STR_LEN("height"), &h) == 0 { img.has_height = true; img.height = h; };
                image_push(r, &img);
                continue;
            };
            let data_node: u64 = 0;
            sa_json_object_get(part, STR_PTR("data"), STR_LEN("data"), &data_node);
            let img2 = ExtractedImage { b64_off: 0, b64_len: 0, has_format: false, format: [0u8; 32], format_len: 0, has_width: false, width: 0, has_height: false, height: 0 };
            if image_data_of(r, data_node, &img2) { image_push(r, &img2); };
        }
    };
    let tn: ptr = PTR_NULL();
    let tnl: u64 = 0;
    sa_json_object_get_string(ev, STR_PTR("toolName"), STR_LEN("toolName"), &tn, &tnl);
    if tnl == 13 && bytes_eq_str(tn, tnl, STR_PTR("GenerateImage"), STR_LEN("GenerateImage")) {
        let data_node: u64 = 0;
        sa_json_object_get(ev, STR_PTR("data"), STR_LEN("data"), &data_node);
        let img3 = ExtractedImage { b64_off: 0, b64_len: 0, has_format: false, format: [0u8; 32], format_len: 0, has_width: false, width: 0, has_height: false, height: 0 };
        if image_data_of(r, data_node, &img3) { image_push(r, &img3); };
    };
}

// TS: export function readImageResponse(bodyText: string): ImageStreamResult
fn read_image_response(r: &ImageStreamResult, body_ptr: ptr, body_len: u64) -> void {
    image_result_reset(r);
    let text = ByteBuf { bytes: [0u8; 40960], len: 0 };
    // for (const rawLine of bodyText.split("\n")) — line iteration by offset.
    let start: u64 = 0;
    while start <= body_len {
        let end = start;
        while end < body_len {
            let b: u8 = 0;
            PTR_BYTE_AT(b, body_ptr, end);
            if b == 10 { break; };
            end = end + 1;
        }
        // line = rawLine.trim(); skip unless it starts with "data:"
        let ls = start;
        let le = end;
        while ls < le {
            let b: u8 = 0;
            PTR_BYTE_AT(b, body_ptr, ls);
            if b == 32 || b == 9 || b == 13 || b == 10 { ls = ls + 1; } else { break; };
        }
        while le > ls {
            let b: u8 = 0;
            PTR_BYTE_AT(b, body_ptr, le - 1);
            if b == 32 || b == 9 || b == 13 || b == 10 { le = le - 1; } else { break; };
        }
        if le > ls {
            let lp: ptr = PTR_NULL();
            PTR_BYTE_ADD(lp, body_ptr, ls);
            if starts_with(lp, le - ls, STR_PTR("data:"), STR_LEN("data:")) {
                parse_image_event(r, &text, lp, le - ls);
            };
        };
        if end >= body_len { break; };
        start = end + 1;
    }
    r.text = text;
}
