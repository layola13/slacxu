// Converted 1:1 from apps/duck2api/src/duckgo/response.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "sa_std/ptr.sa"
@import "sa_std/string.sa"
@import "../types.sla"

// Port of E:\projects\duck2api\typings\official\response.go (chat half).
// Fixed IDs and extra fields are byte-compatible with the Go output.
// DEFECT: ChatChunk / ChatCompletion are dynamic TS objects that the server
// JSON.stringifies; the builders below write the identical JSON text into
// an out buffer instead of returning an object.

fn chatcmpl_id() -> ptr { return STR_PTR("chatcmpl-QXlha2FBbmROaXhpZUFyZUF3ZXNvbWUK"); }

// TS: export interface ToolCallFunction { name: string; arguments: string }
// TS: export interface ToolCall { index?: number; id: string; type: string; function: ToolCallFunction }
struct ToolCall {
    has_index: bool,
    index: u64,
    id: [u8; 128],
    id_len: u64,
    typ: [u8; 32],
    typ_len: u64,
    fn_name: [u8; 128],
    fn_name_len: u64,
    fn_arguments: [u8; 4096],
    fn_arguments_len: u64,
}

fn tool_call_to_json(out: &ByteBuf, call: &ToolCall, fallback_index: u64) -> void {
    let idx = fallback_index;
    if call.has_index { idx = call.index; };
    buf_append_lit(out, STR_PTR("{\"index\":"), STR_LEN("{\"index\":"));
    buf_append_u64(out, idx);
    buf_append_lit(out, STR_PTR(",\"id\":\""), STR_LEN(",\"id\":\""));
    let __ap34: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap34, call.id, 0);
    buf_append_escaped(out, __ap34, call.id_len);
    buf_append_lit(out, STR_PTR("\",\"type\":\""), STR_LEN("\",\"type\":\""));
    let __ap35: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap35, call.typ, 0);
    buf_append_escaped(out, __ap35, call.typ_len);
    buf_append_lit(out, STR_PTR("\",\"function\":{\"name\":\""), STR_LEN("\",\"function\":{\"name\":\""));
    let __ap36: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap36, call.fn_name, 0);
    buf_append_escaped(out, __ap36, call.fn_name_len);
    buf_append_lit(out, STR_PTR("\",\"arguments\":\""), STR_LEN("\",\"arguments\":\""));
    let __ap37: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap37, call.fn_arguments, 0);
    buf_append_escaped(out, __ap37, call.fn_arguments_len);
    buf_append_lit(out, STR_PTR("\"}}"), STR_LEN("\"}}"));
}

// baseChunk prefix: {"id":..,"object":"chat.completion.chunk","created":0,"model":..,"choices":
fn base_chunk_prefix(out: &ByteBuf, id_ptr: ptr, id_len: u64, model_ptr: ptr, model_len: u64) -> void {
    buf_reset(out);
    buf_append_lit(out, STR_PTR("{\"id\":\""), STR_LEN("{\"id\":\""));
    buf_append_lit(out, id_ptr, id_len);
    buf_append_lit(out, STR_PTR("\",\"object\":\"chat.completion.chunk\",\"created\":0,\"model\":\""), STR_LEN("\",\"object\":\"chat.completion.chunk\",\"created\":0,\"model\":\""));
    buf_append_escaped(out, model_ptr, model_len);
    buf_append_lit(out, STR_PTR("\",\"choices\":"), STR_LEN("\",\"choices\":"));
}

// TS: export function textChunkWithModel(text: string, model: string): ChatChunk
fn text_chunk_with_model(out: &ByteBuf, text_ptr: ptr, text_len: u64, model_ptr: ptr, model_len: u64) -> void {
    base_chunk_prefix(out, chatcmpl_id(), STR_LEN("chatcmpl-QXlha2FBbmROaXhpZUFyZUF3ZXNvbWUK"), model_ptr, model_len);
    buf_append_lit(out, STR_PTR("[{\"index\":0,\"delta\":{\"content\":\""), STR_LEN("[{\"index\":0,\"delta\":{\"content\":\""));
    buf_append_escaped(out, text_ptr, text_len);
    buf_append_lit(out, STR_PTR("\"},\"finish_reason\":null}]}"), STR_LEN("\"},\"finish_reason\":null}]}"));
}

// TS: export function reasoningChunkWithModel(text: string, model: string): ChatChunk
fn reasoning_chunk_with_model(out: &ByteBuf, text_ptr: ptr, text_len: u64, model_ptr: ptr, model_len: u64) -> void {
    base_chunk_prefix(out, chatcmpl_id(), STR_LEN("chatcmpl-QXlha2FBbmROaXhpZUFyZUF3ZXNvbWUK"), model_ptr, model_len);
    buf_append_lit(out, STR_PTR("[{\"index\":0,\"delta\":{\"reasoning_content\":\""), STR_LEN("[{\"index\":0,\"delta\":{\"reasoning_content\":\""));
    buf_append_escaped(out, text_ptr, text_len);
    buf_append_lit(out, STR_PTR("\"},\"finish_reason\":null}]}"), STR_LEN("\"},\"finish_reason\":null}]}"));
}

// TS: export function toolCallChunkWithModel(call: ToolCall, model: string, index = 0): ChatChunk
fn tool_call_chunk_with_model(out: &ByteBuf, call: &ToolCall, model_ptr: ptr, model_len: u64, index: u64) -> void {
    base_chunk_prefix(out, STR_PTR("chatcmpl-playgame"), STR_LEN("chatcmpl-playgame"), model_ptr, model_len);
    buf_append_lit(out, STR_PTR("[{\"index\":0,\"delta\":{\"tool_calls\":["), STR_LEN("[{\"index\":0,\"delta\":{\"tool_calls\":["));
    tool_call_to_json(out, call, index);
    buf_append_lit(out, STR_PTR("]}}]}"), STR_LEN("]}}]}"));
}

// TS: export function stopChunkWithModel(reason: string, model: string): ChatChunk
fn stop_chunk_with_model(out: &ByteBuf, reason_ptr: ptr, reason_len: u64, model_ptr: ptr, model_len: u64) -> void {
    base_chunk_prefix(out, chatcmpl_id(), STR_LEN("chatcmpl-QXlha2FBbmROaXhpZUFyZUF3ZXNvbWUK"), model_ptr, model_len);
    buf_append_lit(out, STR_PTR("[{\"index\":0,\"finish_reason\":\""), STR_LEN("[{\"index\":0,\"finish_reason\":\""));
    buf_append_escaped(out, reason_ptr, reason_len);
    buf_append_lit(out, STR_PTR("\"}]}"), STR_LEN("\"}]}"));
}

// usage object shared by usageChunk / newChatCompletionFull.
fn usage_to_json(out: &ByteBuf, prompt_tokens: u64, completion_tokens: u64, cached_tokens: u64) -> void {
    buf_append_lit(out, STR_PTR("{\"prompt_tokens\":"), STR_LEN("{\"prompt_tokens\":"));
    buf_append_u64(out, prompt_tokens);
    buf_append_lit(out, STR_PTR(",\"completion_tokens\":"), STR_LEN(",\"completion_tokens\":"));
    buf_append_u64(out, completion_tokens);
    buf_append_lit(out, STR_PTR(",\"total_tokens\":"), STR_LEN(",\"total_tokens\":"));
    buf_append_u64(out, prompt_tokens + completion_tokens);
    if cached_tokens > 0 {
        buf_append_lit(out, STR_PTR(",\"prompt_tokens_details\":{\"cached_tokens\":"), STR_LEN(",\"prompt_tokens_details\":{\"cached_tokens\":"));
        buf_append_u64(out, cached_tokens);
        buf_append_lit(out, STR_PTR("}"), STR_LEN("}"));
    };
    buf_append_lit(out, STR_PTR("}"), STR_LEN("}"));
}

// TS: export function usageChunk(model, promptTokens, completionTokens, cachedTokens, ttftMs, totalMs, effort): ChatChunk
fn usage_chunk(out: &ByteBuf, model_ptr: ptr, model_len: u64, prompt_tokens: u64, completion_tokens: u64, cached_tokens: u64, ttft_ms: u64, total_ms: u64, effort_ptr: ptr, effort_len: u64) -> void {
    base_chunk_prefix(out, chatcmpl_id(), STR_LEN("chatcmpl-QXlha2FBbmROaXhpZUFyZUF3ZXNvbWUK"), model_ptr, model_len);
    buf_append_lit(out, STR_PTR("[],\"usage\":"), STR_LEN("[],\"usage\":"));
    usage_to_json(out, prompt_tokens, completion_tokens, cached_tokens);
    buf_append_lit(out, STR_PTR(",\"timing\":{\"ttft_ms\":"), STR_LEN(",\"timing\":{\"ttft_ms\":"));
    buf_append_u64(out, ttft_ms);
    buf_append_lit(out, STR_PTR(",\"total_ms\":"), STR_LEN(",\"total_ms\":"));
    buf_append_u64(out, total_ms);
    buf_append_lit(out, STR_PTR("},\"reasoning_effort\":\""), STR_LEN("},\"reasoning_effort\":\""));
    buf_append_escaped(out, effort_ptr, effort_len);
    buf_append_lit(out, STR_PTR("\"}"), STR_LEN("\"}"));
}

// TS: export function newChatCompletionFull(text, model, promptTokens, completionTokens,
//   cachedTokens, ttftMs, totalMs, effort, toolCalls = []): ChatCompletion
// tool_calls points at an array of ToolCall (cap 64 in this pass).
fn new_chat_completion_full(out: &ByteBuf, text_ptr: ptr, text_len: u64, model_ptr: ptr, model_len: u64, prompt_tokens: u64, completion_tokens: u64, cached_tokens: u64, ttft_ms: u64, total_ms: u64, effort_ptr: ptr, effort_len: u64, tool_calls: ptr, tool_calls_len: u64) -> void {
    buf_reset(out);
    buf_append_lit(out, STR_PTR("{\"id\":\""), STR_LEN("{\"id\":\""));
    buf_append_lit(out, chatcmpl_id(), STR_LEN("chatcmpl-QXlha2FBbmROaXhpZUFyZUF3ZXNvbWUK"));
    buf_append_lit(out, STR_PTR("\",\"object\":\"chat.completion\",\"created\":0,\"model\":\""), STR_LEN("\",\"object\":\"chat.completion\",\"created\":0,\"model\":\""));
    buf_append_escaped(out, model_ptr, model_len);
    buf_append_lit(out, STR_PTR("\",\"usage\":"), STR_LEN("\",\"usage\":"));
    usage_to_json(out, prompt_tokens, completion_tokens, cached_tokens);
    buf_append_lit(out, STR_PTR(",\"timing\":{\"ttft_ms\":"), STR_LEN(",\"timing\":{\"ttft_ms\":"));
    buf_append_u64(out, ttft_ms);
    buf_append_lit(out, STR_PTR(",\"total_ms\":"), STR_LEN(",\"total_ms\":"));
    buf_append_u64(out, total_ms);
    buf_append_lit(out, STR_PTR("},\"reasoning_effort\":\""), STR_LEN("},\"reasoning_effort\":\""));
    buf_append_escaped(out, effort_ptr, effort_len);
    buf_append_lit(out, STR_PTR("\",\"choices\":[{\"index\":0,\"message\":{\"role\":\"assistant\",\"content\":\""), STR_LEN("\",\"choices\":[{\"index\":0,\"message\":{\"role\":\"assistant\",\"content\":\""));
    buf_append_escaped(out, text_ptr, text_len);
    buf_append_lit(out, STR_PTR("\""), STR_LEN("\""));
    if tool_calls_len > 0 {
        buf_append_lit(out, STR_PTR(",\"tool_calls\":["), STR_LEN(",\"tool_calls\":["));
        for i in 0..tool_calls_len {
            if i > 0 { buf_append_lit(out, STR_PTR(","), STR_LEN(",")); };
            let call: ptr = tool_calls + i * 8192; // DEFECT: ToolCall stride placeholder — struct size must be fixed in the fix phase.
            tool_call_to_json(out, call, i);
        }
        buf_append_lit(out, STR_PTR("]"), STR_LEN("]"));
    };
    buf_append_lit(out, STR_PTR("}"), STR_LEN("}"));
    if tool_calls_len > 0 {
        buf_append_lit(out, STR_PTR(",\"finish_reason\":\"tool_calls\""), STR_LEN(",\"finish_reason\":\"tool_calls\""));
    };
    buf_append_lit(out, STR_PTR("}]}"), STR_LEN("}]}"));
}

// --- Upstream duck.ai SSE event shapes (interfaces; consumers read them
// --- through sa_json accessors on the parsed event node). ---

// TS: export interface UpstreamImageData { b64Image?; format?; width?; height?; status?; title?; type? }
struct UpstreamImageData {
    has_b64_image: bool,
    b64_image_len: u64,
    has_format: bool,
    format_len: u64,
    has_width: bool,
    width: u64,
    has_height: bool,
    height: u64,
    has_status: bool,
    has_title: bool,
    has_type: bool,
}

// TS: export interface UpstreamImagePart { type?; result?; format?; width?; height?; data?: UpstreamImageData | null }
struct UpstreamImagePart {
    has_type: bool,
    type_len: u64,
    has_result: bool,
    result_len: u64,
    has_format: bool,
    has_width: bool,
    width: u64,
    has_height: bool,
    height: u64,
    has_data: bool,
}

// TS: export interface UpstreamEvent { message?; action?; model?; role?; state?; text?; id?;
//   partIndex?; toolName?; toolCallId?; toolArguments?; result?; parts?; data?;
//   summaryText?: string[]; encryptedText? }
struct UpstreamEvent {
    has_message: bool,
    has_action: bool,
    action_len: u64,
    has_model: bool,
    has_role: bool,
    has_state: bool,
    has_text: bool,
    has_id: bool,
    has_part_index: bool,
    part_index: u64,
    has_tool_name: bool,
    tool_name_len: u64,
    has_tool_call_id: bool,
    has_tool_arguments: bool,
    has_result: bool,
    has_parts: bool,
    has_data: bool,
    has_summary_text: bool,
    has_encrypted_text: bool,
}
