fn is_json_structural(ch: u8) -> bool {
    return ch == 58 || ch == 44 || ch == 125 || ch == 93;
}

fn is_valid_json_escape(ch: u8) -> bool {
    return ch == 34 || ch == 92 || ch == 47 || ch == 98 || ch == 102 || ch == 110 || ch == 114 || ch == 116 || ch == 117;
}

// TS: function nextNonJSONWhitespace(value, start): number
fn next_non_json_whitespace(v: ptr, len: u64, start: u64) -> u64 {
    for i in start..len {
        if !is_json_whitespace_char(PTR_BYTE_AT(v, i)) { return i; };
