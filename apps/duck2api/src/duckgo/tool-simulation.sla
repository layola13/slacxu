}

// TS: function jsonValueEnd(value, start): number — end (exclusive) of the
// leading JSON value, mirroring Go json.Decoder.InputOffset.
fn json_value_end(v: ptr, len: u64, start: u64) -> u64 {
    let index = start;
    while index < len && is_json_whitespace_char(PTR_BYTE_AT(v, index)) { index = index + 1; }
    if index >= len { return 4294967295; };
    let first = PTR_BYTE_AT(v, index);
    if first == 34 {
        index = index + 1;
        let escaped = false;
        while index < len {
            let ch = PTR_BYTE_AT(v, index);
            if escaped { escaped = false; }
            else if ch == 92 { escaped = true; }
            else if ch == 34 { return index + 1; };
            index = index + 1;
        }
        return 4294967295;
    };
    if first == 123 || first == 91 {
        let stack: [u8; 64] = [0u8; 64];
        let depth: u64 = 0;
        stack[depth] = if first == 123 { 125 } else { 93 };
        depth = 1;
        let quoted = false;
        let escaped = false;
        index = index + 1;
        while index < len {
            let ch = PTR_BYTE_AT(v, index);
            if quoted {
                if escaped { escaped = false; }
                else if ch == 92 { escaped = true; }
                else if ch == 34 { quoted = false; };
                index = index + 1;
                continue;
            };
            if ch == 34 { quoted = true; index = index + 1; continue; };
            if ch == 123 || ch == 91 {
                if depth < 64 {
                    stack[depth] = if ch == 123 { 125 } else { 93 };
                    depth = depth + 1;
                };
            } else if depth > 0 && ch == stack[depth - 1] {
                depth = depth - 1;
                if depth == 0 { return index + 1; };
            } else if ch == 125 || ch == 93 {
                return 4294967295;
            };
            index = index + 1;
        }
        return 4294967295;
    };
    index = index + 1;
    while index < len {
        let ch = PTR_BYTE_AT(v, index);
        if is_json_whitespace_char(ch) || ch == 44 || ch == 125 || ch == 93 { break; };
        index = index + 1;
    }
    if index > start { return index; };
    return 4294967295;
}

// TS: function decodePlaygame(text, final): Decoded
fn decode_playgame(out: &PlaygameDecoded, text: ptr, len: u64, final: bool) -> void {
    out.status = 2;
    out.consumed = 0;
    out.has_call = false;
    let action = StrField { bytes: [0u8; 512], len: 0 };
    let args = ByteBuf { bytes: [0u8; 40960], len: 0 };
    let end = json_value_end(text, len, 0);
    if end != 4294967295 {
        if parse_envelope(text, end, &action, &args) {
            out.status = 0;
            out.consumed = end;
            out.has_call = true;
            playgame_to_call(&out.call, &action.bytes, action.len, &args);
            return;
        };
        // Valid JSON value but no action: a playgame envelope without an
        // action is invalid; anything else falls through to repair.
        let root: u64 = 0;
        if sa_json_parse(text, end, &root) == 0 && root != 0 && sa_json_object_has(root, STR_PTR("playgame"), STR_LEN("playgame")) {
            out.status = 2;
            return;
        };
    };
    let candidate = ByteBuf { bytes: [0u8; 40960], len: 0 };
    let consumed: u64 = 0;
    let complete = false;
    extract_playgame_candidate(text, len, &candidate, &consumed, &complete);
    if complete {
        let repaired = ByteBuf { bytes: [0u8; 40960], len: 0 };
        repair_playgame_json(&repaired, &candidate.bytes, candidate.len);
        if parse_envelope(&repaired.bytes, repaired.len, &action, &args) {
            out.status = 0;
            out.consumed = consumed;
            out.has_call = true;
            playgame_to_call(&out.call, &action.bytes, action.len, &args);
            return;
        };
    } else if final {
        let repaired = ByteBuf { bytes: [0u8; 40960], len: 0 };
        repair_playgame_json(&repaired, text, len);
        if parse_envelope(&repaired.bytes, repaired.len, &action, &args) {
            out.status = 0;
            out.consumed = len;
            out.has_call = true;
            playgame_to_call(&out.call, &action.bytes, action.len, &args);
            return;
        };
        out.status = 1;
        return;
    } else {
        out.status = 1;
        return;
    };
    out.status = 2;
}

fn parts_push_text(parts: &ToolSimParts, p: ptr, l: u64) -> void {
    if parts.len >= 64 { return; };
    let part = parts.parts[parts.len];
    part.has_text = true;
    buf_reset(&part.text);
    buf_append_lit(&part.text, p, l);
    part.has_tool_call = false;
    parts.parts[parts.len] = part;
    parts.len = parts.len + 1;
}

fn parts_push_call(parts: &ToolSimParts, call: &ToolCall) -> void {
    if parts.len >= 64 { return; };
    let part = parts.parts[parts.len];
    part.has_text = false;
    part.has_tool_call = true;
    part.call = *call;
    parts.parts[parts.len] = part;
    parts.len = parts.len + 1;
}

// TS: private drain(final): ToolSimulationPart[]
fn tool_sim_drain(stream: &ToolSimulationStream, parts: &ToolSimParts, final: bool) -> void {
    parts.len = 0;
    while stream.pending.len != 0 {
        let marker_index = find_playgame_marker(stream.pending.bytes, stream.pending.len);
        if marker_index == 4294967295 {
            if final {
                let tmp = ByteBuf { bytes: [0u8; 40960], len: 0 };
                pending_slice(&stream.pending, 0, stream.pending.len, &tmp);
                parts_push_text(parts, &tmp.bytes, tmp.len);
                stream.pending.len = 0;
                break;
            };
            let keep = suffix_playgame_prefix_length(stream.pending.bytes, stream.pending.len);
            if keep == stream.pending.len { break; };
            if keep > 0 {
                let emit_len = stream.pending.len - keep;
                let tmp = ByteBuf { bytes: [0u8; 40960], len: 0 };
                pending_slice(&stream.pending, 0, emit_len, &tmp);
                parts_push_text(parts, &tmp.bytes, tmp.len);
                pending_drop_front(&stream.pending, emit_len);
            } else {
                let tmp = ByteBuf { bytes: [0u8; 40960], len: 0 };
                pending_slice(&stream.pending, 0, stream.pending.len, &tmp);
                parts_push_text(parts, &tmp.bytes, tmp.len);
                stream.pending.len = 0;
            };
            break;
        };
        if marker_index > 0 {
            let tmp = ByteBuf { bytes: [0u8; 40960], len: 0 };
            pending_slice(&stream.pending, 0, marker_index, &tmp);
            parts_push_text(parts, &tmp.bytes, tmp.len);
            pending_drop_front(&stream.pending, marker_index);
            continue;
        };
        let decoded = PlaygameDecoded { status: 2, consumed: 0, has_call: false, call: ToolCall { has_index: false, index: 0, id: [0u8; 128], id_len: 0, typ: [0u8; 32], typ_len: 0, fn_name: [0u8; 128], fn_name_len: 0, fn_arguments: [0u8; 4096], fn_arguments_len: 0 } };
        decode_playgame(&decoded, stream.pending.bytes, stream.pending.len, final);
        if decoded.status == 1 {
            if stream.pending.len > 262144 {
                let tmp = ByteBuf { bytes: [0u8; 40960], len: 0 };
                pending_slice(&stream.pending, 0, stream.pending.len, &tmp);
                parts_push_text(parts, &tmp.bytes, tmp.len);
                stream.pending.len = 0;
            };
            return;
        };
        if decoded.status == 2 {
            let tmp = ByteBuf { bytes: [0u8; 40960], len: 0 };
            pending_slice(&stream.pending, 0, 1, &tmp);
            parts_push_text(parts, &tmp.bytes, tmp.len);
            pending_drop_front(&stream.pending, 1);
            continue;
        };
        stream.next_call = stream.next_call + 1;
        // call.id = `call_playgame_${nextCall}`
        let idb = ByteBuf { bytes: [0u8; 40960], len: 0 };
        buf_append_lit(&idb, STR_PTR("call_playgame_"), STR_LEN("call_playgame_"));
        buf_append_u64(&idb, stream.next_call);
        tc_copy(decoded.call.id, 128, &idb.bytes, idb.len, &decoded.call.id_len);
        parts_push_call(parts, &decoded.call);
        pending_drop_front(&stream.pending, decoded.consumed);
        let skipped = skip_playgame_separators(stream.pending.bytes, stream.pending.len);
        pending_drop_front(&stream.pending, skipped);
    }
}

// TS: push(text: string): ToolSimulationPart[]
fn tool_simulation_stream_push(stream: &ToolSimulationStream, parts: &ToolSimParts, text_ptr: ptr, text_len: u64) -> void {
    parts.len = 0;
    if text_len == 0 { return; };
    pending_append(&stream.pending, text_ptr, text_len);
    tool_sim_drain(stream, parts, false);
}

// TS: flush(): ToolSimulationPart[]
fn tool_simulation_stream_flush(stream: &ToolSimulationStream, parts: &ToolSimParts) -> void {
    tool_sim_drain(stream, parts, true);
    if stream.pending.len != 0 {
        let tmp = ByteBuf { bytes: [0u8; 40960], len: 0 };
        pending_slice(&stream.pending, 0, stream.pending.len, &tmp);
        parts_push_text(parts, &tmp.bytes, tmp.len);
        stream.pending.len = 0;
    };
}

// TS: export function nativeToolCall(event): ToolCall | null
fn native_tool_call(out: &ToolCall, has_name: bool, name_ptr: ptr, name_len: u64, has_id: bool, id_ptr: ptr, id_len: u64, has_args: bool, args_ptr: ptr, args_len: u64) -> bool {
    if !has_name || !has_args { return false; };
    let name = ByteBuf { bytes: [0u8; 40960], len: 0 };
    buf_append_lit(&name, name_ptr, name_len);
    buf_trim(&name);
    let lowered = ByteBuf { bytes: [0u8; 40960], len: 0 };
    buf_append_buf(&lowered, &name);
    buf_to_lower(&lowered);
    if bytes_eq_str(&lowered.bytes, lowered.len, STR_PTR("websearch"), STR_LEN("websearch")) || bytes_eq_str(&lowered.bytes, lowered.len, STR_PTR("web-search"), STR_LEN("web-search")) || bytes_eq_str(&lowered.bytes, lowered.len, STR_PTR("web_search"), STR_LEN("web_search")) {
        buf_reset(&name);
        buf_append_lit(&name, STR_PTR("web_search"), STR_LEN("web_search"));
    };
    tool_call_clear(out);
    tc_set_type_function(out);
    if has_id {
        tc_copy(out.id, 128, id_ptr, id_len, &out.id_len);
    };
    tc_copy(out.fn_name, 128, &name.bytes, name.len, &out.fn_name_len);
    tc_copy(out.fn_arguments, 4096, args_ptr, args_len, &out.fn_arguments_len);
    return true;
}

// TS: export function parseToolSimulations(text): { text: string; calls: ToolCall[] }
fn parse_tool_simulations(text_ptr: ptr, text_len: u64, out_text: &ByteBuf, out_calls: &ToolCallList) -> void {
    let stream = ToolSimulationStream { pending: ToolSimPending { bytes: [0u8; 262144], len: 0 }, next_call: 0 };
    let parts = ToolSimParts { parts: [ToolSimulationPart { has_text: false, text: ByteBuf { bytes: [0u8; 40960], len: 0 }, has_tool_call: false, call: ToolCall { has_index: false, index: 0, id: [0u8; 128], id_len: 0, typ: [0u8; 32], typ_len: 0, fn_name: [0u8; 128], fn_name_len: 0, fn_arguments: [0u8; 4096], fn_arguments_len: 0 } }; 64], len: 0 };
    out_calls.len = 0;
    buf_reset(out_text);
    tool_simulation_stream_push(&stream, &parts, text_ptr, text_len);
    collect_sim_parts(&parts, out_text, out_calls);
    tool_simulation_stream_flush(&stream, &parts);
    collect_sim_parts(&parts, out_text, out_calls);
    buf_trim(out_text);
}

fn collect_sim_parts(parts: &ToolSimParts, out_text: &ByteBuf, out_calls: &ToolCallList) -> void {
    for i in 0..parts.len {
        if parts.parts[i].has_tool_call {
            if out_calls.len < 64 {
                out_calls.calls[out_calls.len] = parts.parts[i].call;
                out_calls.len = out_calls.len + 1;
            };
        } else if parts.parts[i].has_text {
            buf_append_buf(out_text, &parts.parts[i].text);
        };
    }
}

// TS: export function parseToolSimulation(text): { text: string; call: ToolCall | null }
fn parse_tool_simulation(text_ptr: ptr, text_len: u64, out_text: &ByteBuf, out_call: &ToolCall) -> bool {
    let calls = ToolCallList { calls: [ToolCall { has_index: false, index: 0, id: [0u8; 128], id_len: 0, typ: [0u8; 32], typ_len: 0, fn_name: [0u8; 128], fn_name_len: 0, fn_arguments: [0u8; 4096], fn_arguments_len: 0 }; 64], len: 0 };
    parse_tool_simulations(text_ptr, text_len, out_text, &calls);
    if calls.len > 0 {
        *out_call = calls.calls[0];
        return true;
    };
    return false;
}
