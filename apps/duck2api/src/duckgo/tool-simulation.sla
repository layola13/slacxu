// TS: interface Decoded { status: "complete"|"incomplete"|"invalid"; consumed: number; call?: ToolCall }
struct PlaygameDecoded {
    status: u8, // 0 complete, 1 incomplete, 2 invalid
    consumed: u64,
    has_call: bool,
    call: ToolCall,
}

// TS: function toCall(action, argsRaw): ToolCall
fn playgame_to_call(call: &ToolCall, action_ptr: ptr, action_len: u64, args: &ByteBuf) -> void {
    tool_call_clear(call);
    tc_set_type_function(call);
    tc_copy(call.fn_name, 128, action_ptr, action_len, &call.fn_name_len);
    if args.len == 0 || (args.len == 4 && bytes_eq_str(&args.bytes, args.len, STR_PTR("null"), STR_LEN("null"))) {
        tc_copy(call.fn_arguments, 4096, STR_PTR("{}"), STR_LEN("{}"), &call.fn_arguments_len);
    } else {
        tc_copy(call.fn_arguments, 4096, &args.bytes, args.len, &call.fn_arguments_len);
    };
}

// TS: function parseEnvelope(text): { action; argsRaw } | null
fn parse_envelope(text: ptr, len: u64, out_action: &StrField, out_args: &ByteBuf) -> bool {
    let root: u64 = 0;
    if sa_json_parse(text, len, &root) != 0 || root == 0 { return false; };
    let pg: u64 = 0;
    if sa_json_object_get(root, STR_PTR("playgame"), STR_LEN("playgame"), &pg) != 0 || pg == 0 { return false; };
    let ap: ptr = PTR_NULL();
    let al: u64 = 0;
    sa_json_object_get_string(pg, STR_PTR("action"), STR_LEN("action"), &ap, &al);
    if al == 0 { return false; };
    str_field_set(out_action, ap, al);
    let args_node: u64 = 0;
    let has_args = sa_json_object_get(pg, STR_PTR("args"), STR_LEN("args"), &args_node) == 0 && args_node != 0 && sa_json_kind_of(args_node) != 0;
    buf_reset(out_args);
    if !has_args {
        buf_append_lit(out_args, STR_PTR("{}"), STR_LEN("{}"));
    } else if sa_json_kind_of(args_node) == 1 {
        let sp: ptr = PTR_NULL();
        let sl: u64 = 0;
