        if cursor >= len || PTR_BYTE_AT(v, cursor) != 58 {
            offset = abs_index + 1;
            continue;
        };
        return abs_index;
    }
    return 4294967295;
}

// TS: function suffixMarkerPrefixLength(value, marker): number
fn suffix_marker_prefix_length(v: ptr, len: u64, marker: ptr, marker_len: u64) -> u64 {
    let max = len;
    if max >= marker_len { max = marker_len - 1; };
    let l = max;
