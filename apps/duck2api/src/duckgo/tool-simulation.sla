// Port of E:/projects/duck2api/internal/duckgo/request.go:625-1019
// ToolSimulationStream incremental playgame parser. Byte-semantics follow Go:
// marker `{"playgame":` with whitespace-tolerant pretty-print matching,
// Windows-command JSON repair, `call_playgame_N` IDs, separator skipping.
// DEFECT: TS strings are UTF-16 code units; all scanning below is on UTF-8
// bytes (indices differ for non-ASCII text — byte-faithful only for ASCII).
// DEFECT: the pending buffer can reach MAX_PLAYGAME_PENDING (256 KiB) in
// TS; the fixed inline buffer caps it at 262144 bytes and push() truncates
// beyond that (logged, not fixed). JSON.parse / JSON.stringify map to the
// sa_json node API.

struct ToolSimulationPart {
    has_text: bool,
    text: ByteBuf,
    has_tool_call: bool,
    call: ToolCall,
}

struct ToolSimParts {
    parts: [ToolSimulationPart; 64],
    len: u64,
}

// ToolCall is response.sla's fixed-array struct; a call list is the
// (array, len) pair response.sla's builders take, wrapped for the parser.
struct ToolCallList {
    calls: [ToolCall; 64],
    len: u64,
}

fn tool_call_clear(call: &ToolCall) -> void {
    call.has_index = false;
    call.index = 0;
    call.id_len = 0;
    call.typ_len = 0;
    call.fn_name_len = 0;
    call.fn_arguments_len = 0;
}

fn tc_copy(dst: ptr, cap: u64, src: ptr, len: u64, out_len: &u64) -> void {
    let n = len;
    if n > cap { n = cap; };
    for i in 0..n { PTR_BYTE_SET(dst, i, PTR_BYTE_AT(src, i)); }
    *out_len = n;
}

fn tc_set_type_function(call: &ToolCall) -> void {
    tc_copy(call.typ, 32, STR_PTR("function"), STR_LEN("function"), &call.typ_len);
}

struct ToolSimPending {
    bytes: [u8; 262144],
    len: u64,
}

// TS: export class ToolSimulationStream { private pending = ""; private nextCall = 0; }
struct ToolSimulationStream {
    pending: ToolSimPending,
    next_call: u64,
}

fn pending_append(s: &ToolSimPending, p: ptr, l: u64) -> void {
    for i in 0..l {
        if s.len < 262144 {
            PTR_BYTE_SET(s.bytes, s.len, PTR_BYTE_AT(p, i));
            s.len = s.len + 1;
        };
    }
}

fn pending_drop_front(s: &ToolSimPending, n: u64) -> void {
    if n >= s.len {
        s.len = 0;
        return;
    };
    let rest = s.len - n;
    for i in 0..rest {
        PTR_BYTE_SET(s.bytes, i, PTR_BYTE_AT(s.bytes, n + i));
    }
    s.len = rest;
}

fn pending_slice(s: &ToolSimPending, start: u64, end: u64, out: &ByteBuf) -> void {
    buf_reset(out);
    if end > start {
        let p: ptr = PTR_NULL();
        PTR_BYTE_ADD(p, s.bytes, start);
        buf_append_lit(out, p, end - start);
    };
}

// TS: const PLAYGAME_MARKER = `{"playgame":`; MAX_PLAYGAME_PENDING = 256 * 1024
fn is_json_whitespace_char(ch: u8) -> bool {
    return ch == 32 || ch == 10 || ch == 13 || ch == 9;
}

// TS: function findPlaygameMarker(value: string): number  (-1 -> 4294967295)
fn find_playgame_marker(v: ptr, len: u64) -> u64 {
    let offset: u64 = 0;
