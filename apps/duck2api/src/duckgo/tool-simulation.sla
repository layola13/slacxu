    }
    buf_append_lit(out_candidate, text, len);
}

// TS: function repairPlaygameJSON(text: string): string
fn repair_playgame_json(out: &ByteBuf, text: ptr, len: u64) -> void {
    buf_reset(out);
    let in_string = false;
    let i: u64 = 0;
    while i < len {
        let ch = PTR_BYTE_AT(text, i);
        if !in_string {
            buf_append_byte(out, ch);
            if ch == 34 { in_string = true; };
            i = i + 1;
            continue;
        };
        if ch == 92 {
            if i + 1 < len {
                let next = PTR_BYTE_AT(text, i + 1);
                if is_valid_json_escape(next) {
                    buf_append_byte(out, ch);
                    buf_append_byte(out, next);
                    i = i + 2;
                    continue;
                };
            };
            buf_append_lit(out, STR_PTR("\\\\"), STR_LEN("\\\\"));
            i = i + 1;
            continue;
        };
        if ch == 34 {
            let next = next_non_json_whitespace(text, len, i + 1);
            if next == 4294967295 || is_json_structural(PTR_BYTE_AT(text, next)) {
                buf_append_byte(out, ch);
                in_string = false;
            } else {
                buf_append_lit(out, STR_PTR("\\\""), STR_LEN("\\\""));
            };
            i = i + 1;
            continue;
        };
        buf_append_byte(out, ch);
        i = i + 1;
    }
}

// TS: function skipPlaygameSeparators(value: string): string — returns chars skipped
fn skip_playgame_separators(v: ptr, len: u64) -> u64 {
    let i: u64 = 0;
