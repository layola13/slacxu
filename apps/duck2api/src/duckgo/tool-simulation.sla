        if ch == 34 {
            in_string = true;
            continue;
        };
        if ch == 123 { depth = depth + 1; }
        else if ch == 125 {
            depth = depth - 1;
            if depth == 0 {
                buf_append_lit(out_candidate, text, index + 1);
                *out_consumed = index + 1;
                *out_complete = true;
                return;
            };
