// TS: function suffixPlaygamePrefixLength(value: string): number
fn suffix_playgame_prefix_length(v: ptr, len: u64) -> u64 {
    let last_brace = 4294967295;
    let i = len;
    while i > 0 {
        i = i - 1;
        if PTR_BYTE_AT(v, i) == 123 { last_brace = i; break; };
    }
    if last_brace == 4294967295 { return 0; };
    let suffix_start = last_brace + 1;
