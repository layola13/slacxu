        let cursor = abs_index + 1;
        while cursor < len && is_json_whitespace_char(PTR_BYTE_AT(v, cursor)) { cursor = cursor + 1; }
        if cursor >= len { return 4294967295; };
        let cp: ptr = PTR_NULL();
        PTR_BYTE_ADD(cp, v, cursor);
        if !(cursor + 10 <= len && bytes_eq_str(cp, 10, STR_PTR("\"playgame\""), STR_LEN("\"playgame\""))) {
