// TS: function extractPlaygameCandidate(text): { candidate; consumed; complete }
fn extract_playgame_candidate(text: ptr, len: u64, out_candidate: &ByteBuf, out_consumed: &u64, out_complete: &bool) -> void {
    buf_reset(out_candidate);
    *out_consumed = 0;
    *out_complete = false;
    if len == 0 || PTR_BYTE_AT(text, 0) != 123 { return; };
    let depth: u64 = 0;
    let in_string = false;
    let escaped = false;
    for index in 0..len {
