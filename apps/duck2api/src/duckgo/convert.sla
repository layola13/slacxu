// Converted 1:1 from apps/duck2api/src/duckgo/convert.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "sa_std/ptr.sa"
@import "sa_std/encoding/json.sai"
@import "sa_std/crypto.sai"
@import "sa_std/fmt.sai"
@import "sa_std/string.sa"
@import "sa_std/ts_string.sa"
@import "../types.sla"

// Port of E:\projects\duck2api\conversion\requests\duckgo\convert.go and
// E:\projects\duck2api\typings\duckgo\request.go (JSON shapes use the Go tags).
// DEFECT: FileLookup is a TS function type (closure) — represented by an
// explicit FileStore table + lookup function. RSA keypair generation + JWK
// export (generateKeyPairSync("rsa") / publicKey.export({format:"jwk"}))
// is an intent extern sa_crypto_rsa2048_jwk. randomUUID is sa_crypto_random_uuid.
// DEFECT: APIRequest input arrives as a parsed JSON node (the zod-validated
// object in TS); message content is dispatched via node kind, matching the
// string | part[] union. Buffer base64 of file bytes is an intent extern.

struct DuckContentPart {
    typ: StrField, // "text" | "image" | "file"
    has_text: bool,
    text: StrField,
    has_image: bool,
    image: StrField,
    has_mime_type: bool,
    mime_type: StrField,
    has_filename: bool,
    filename: StrField,
}

struct PartsList {
    parts: [DuckContentPart; 64],
    len: u64,
}

// TS: export interface DuckMessage { role: string; content: string | DuckContentPart[] }
struct DuckMessage {
    role: StrField,
    content_is_parts: bool,
    content_text: StrField,
    parts: PartsList,
}

// TS: export interface DuckApiRequest { ... } (field order preserved)
struct DuckApiRequest {
    model: StrField,
    has_tool_choice: bool,
    tool_choice_web_search: bool,
    tool_choice_generate_image: bool,
    messages: [DuckMessage; 128],
    messages_len: u64,
    can_use_tools: bool,
    reasoning_effort: StrField,
    has_can_use_approx_location: bool,
    can_use_approx_location: bool,
    has_can_delegate_image_generation: bool,
    can_delegate_image_generation: bool,
    can_show_greeting: bool,
    durable_message_id: StrField,
    durable_conversation_id: StrField,
    durable_public_key_json: ByteBuf,
    has_tool_simulation: bool,
    tool_simulation: bool,
}

struct FileEntry {
    id: StrField,
    filename: StrField,
    mime_type: StrField,
    data: ByteBuf,
}

struct FileStore {
    entries: [FileEntry; 64],
    len: u64,
}

// TS: export type FileLookup — lookup by file id; returns entry index or -1 sentinel.
fn file_store_lookup(store: &FileStore, id_ptr: ptr, id_len: u64) -> u64 {
    for i in 0..store.len {
        let __ap1: ptr = PTR_NULL();
        PTR_BYTE_ADD(__ap1, store.entries[i].id.bytes, 0);
        if store.entries[i].id.len == id_len && bytes_eq3(__ap1, id_ptr, id_len) { return i; };
    }
    return 4294967295;
}

// TS: export function capReasoningEffort(effort: string): string
// switch (effort.toLowerCase().trim()): "" -> "low"; "none" -> "none";
// "low"/"medium"/"high" -> "low"; default -> "low".
fn cap_reasoning_effort(out: &StrField, in_ptr: ptr, in_len: u64) -> void {
    // String.trim: @ts_str_trim is an SA-layer function (ts_string.sa)
    // and is NOT callable from SLA (probe-verified Undefined), so the
    // trim is a (ptr, len) view here: skip leading/trailing ASCII
    // whitespace bytes (space, tab, LF, VT, FF, CR) without copying.
    // JS trim also strips Unicode whitespace; effort strings on this
    // path are ASCII tokens, and the byte view matches them exactly.
    // toLowerCase has NO entry in the ts_string inventory and stays
    // the manual fold below (see defect log).
    let tp: ptr = in_ptr;
    let tl: u64 = in_len;
    while tl > 0 {
        let c: u8 = 0;
        PTR_BYTE_AT(c, tp, 0);
        if c != 32 && c != 9 && c != 10 && c != 11 && c != 12 && c != 13 { break; };
        PTR_BYTE_ADD(tp, tp, 1);
        tl = tl - 1;
    }
    while tl > 0 {
        let c: u8 = 0;
        PTR_BYTE_AT(c, tp, tl - 1);
        if c != 32 && c != 9 && c != 10 && c != 11 && c != 12 && c != 13 { break; };
        tl = tl - 1;
    }
    let norm = ByteBuf { bytes: [0u8; 40960], len: 0 };
    buf_append_lit(&norm, tp, tl);
    buf_to_lower(&norm);
    let __ap2: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap2, norm.bytes, 0);
    if norm.len == 4 && bytes_eq_str(__ap2, norm.len, STR_PTR("none"), STR_LEN("none")) {
        str_field_set(out, STR_PTR("none"), STR_LEN("none"));
        return;
    };
    str_field_set(out, STR_PTR("low"), STR_LEN("low"));
}

// TS: function mapModel(inputModel: string): string
fn map_model(out: &StrField, in_ptr: ptr, in_len: u64) -> void {
    let lower = ByteBuf { bytes: [0u8; 40960], len: 0 };
    buf_append_lit(&lower, in_ptr, in_len);
    buf_to_lower(&lower);
    let __ap4: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap4, lower.bytes, 0);
    let __ap3: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap3, lower.bytes, 0);
    if bytes_eq_str(__ap4, lower.len, STR_PTR("gpt-5.6-luna"), STR_LEN("gpt-5.6-luna")) || bytes_eq_str(__ap3, lower.len, STR_PTR("gpt-5.6-luna-thinking"), STR_LEN("gpt-5.6-luna-thinking")) {
        str_field_set(out, STR_PTR("gpt-6-luna"), STR_LEN("gpt-6-luna"));
        return;
    };
    let __ap5: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap5, lower.bytes, 0);
    if starts_with(__ap5, lower.len, STR_PTR("gpt-3.5"), STR_LEN("gpt-3.5")) { str_field_set(out, STR_PTR("gpt-4o-mini"), STR_LEN("gpt-4o-mini")); return; };
    let __ap6: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap6, lower.bytes, 0);
    if starts_with(__ap6, lower.len, STR_PTR("claude-3-haiku"), STR_LEN("claude-3-haiku")) { str_field_set(out, STR_PTR("claude-3-haiku-20240307"), STR_LEN("claude-3-haiku-20240307")); return; };
    let __ap7: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap7, lower.bytes, 0);
    if starts_with(__ap7, lower.len, STR_PTR("llama-3.3-70b"), STR_LEN("llama-3.3-70b")) { str_field_set(out, STR_PTR("meta-llama/Llama-3.3-70B-Instruct-Turbo"), STR_LEN("meta-llama/Llama-3.3-70B-Instruct-Turbo")); return; };
    let __ap8: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap8, lower.bytes, 0);
    if starts_with(__ap8, lower.len, STR_PTR("mixtral-8x7b"), STR_LEN("mixtral-8x7b")) { str_field_set(out, STR_PTR("mistralai/Mixtral-8x7B-Instruct-v0.1"), STR_LEN("mistralai/Mixtral-8x7B-Instruct-v0.1")); return; };
    let __ap9: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap9, lower.bytes, 0);
    if starts_with(__ap9, lower.len, STR_PTR("llama-4-scout"), STR_LEN("llama-4-scout")) { str_field_set(out, STR_PTR("meta-llama/Llama-4-Scout-17B-16E-Instruct"), STR_LEN("meta-llama/Llama-4-Scout-17B-16E-Instruct")); return; };
    let __ap10: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap10, lower.bytes, 0);
    if bytes_eq_str(__ap10, lower.len, STR_PTR("mistral-small"), STR_LEN("mistral-small")) { str_field_set(out, STR_PTR("mistralai/Mistral-Small-24B-Instruct-2501"), STR_LEN("mistralai/Mistral-Small-24B-Instruct-2501")); return; };
    str_field_set(out, in_ptr, in_len);
}

// DEFECT (B-class gap, four-source verified 2026-10-27): RSA-2048
// keypair generation + JWK export has no sa_std surface — crypto.sai
// carries bcrypt/keyring/HMAC/CSPRNG only, and RSA appears in none of
// sala docs, sa_plugin_sla demos/tests, or the sa_std inventory. The
// converter's intent extern sa_crypto_rsa2048_jwk does not exist.
// Until std grows an RSA surface, e/n stay empty: the assembled JWK
// keeps its shape but carries NO key material (explicit absence, not
// a fabricated key); consumers fail loudly at key import.
fn rsa2048_jwk_unsupported(e: &ByteBuf, n: &ByteBuf) -> void {
    buf_reset(e);
    buf_reset(n);
}

// TS: export function newDurableStream(): DuckApiRequest["durableStream"]
fn new_durable_stream(req: &DuckApiRequest) -> void {
    // randomUUID(): the fabricated sa_crypto_random_uuid out-param form
    // does not exist; the real surface is sa_deno_random_uuid() ->
    // fmt-buffer handle (crypto.sai declaration restored in std wave 2).
    let uuid_h1 = sa_deno_random_uuid();
    let uuid_p1: ptr = sa_fmt_buffer_data(uuid_h1);
    str_field_set(&req.durable_message_id, uuid_p1, sa_fmt_buffer_len(uuid_h1));
    sa_fmt_buffer_free(uuid_h1);
    let uuid_h2 = sa_deno_random_uuid();
    let uuid_p2: ptr = sa_fmt_buffer_data(uuid_h2);
    str_field_set(&req.durable_conversation_id, uuid_p2, sa_fmt_buffer_len(uuid_h2));
    sa_fmt_buffer_free(uuid_h2);
    // DEFECT: RSA 2048 keypair + JWK export — intent extern fills e/n.
    let e = ByteBuf { bytes: [0u8; 40960], len: 0 };
    let n = ByteBuf { bytes: [0u8; 40960], len: 0 };
    rsa2048_jwk_unsupported(&e, &n);
    buf_reset(&req.durable_public_key_json);
    buf_append_lit(&req.durable_public_key_json, STR_PTR("{\"alg\":\"RSA-OAEP-256\",\"e\":\""), STR_LEN("{\"alg\":\"RSA-OAEP-256\",\"e\":\""));
    buf_append_buf(&req.durable_public_key_json, &e);
    buf_append_lit(&req.durable_public_key_json, STR_PTR("\",\"ext\":true,\"key_ops\":[\"encrypt\"],\"kty\":\"RSA\",\"n\":\""), STR_LEN("\",\"ext\":true,\"key_ops\":[\"encrypt\"],\"kty\":\"RSA\",\"n\":\""));
    buf_append_buf(&req.durable_public_key_json, &n);
    buf_append_lit(&req.durable_public_key_json, STR_PTR("\",\"use\":\"enc\"}"), STR_LEN("\",\"use\":\"enc\"}"));
}

fn part_new_text(list: &PartsList, text_ptr: ptr, text_len: u64) -> void {
    if list.len >= 64 { return; };
    let p = list.parts[list.len];
    str_field_set(&p.typ, STR_PTR("text"), STR_LEN("text"));
    p.has_text = true;
    str_field_set(&p.text, text_ptr, text_len);
    p.has_image = false;
    p.has_mime_type = false;
    p.has_filename = false;
    list.parts[list.len] = p;
    list.len = list.len + 1;
}

// TS: function extractContentParts(content, fileStore?): DuckContentPart[]
// content is the ApiMessage content JSON node (string | part[] | other).
fn extract_content_parts(list: &PartsList, content_node: u64, has_store: bool, store: &FileStore) -> void {
    list.len = 0;
    if content_node != 0 && sa_json_kind(content_node) == 5 {
        let p: ptr = sa_json_string_ptr(content_node);
        let l: u64 = sa_json_string_len(content_node);
        if l != 0 { part_new_text(list, p, l); };
        return;
    };
    if content_node == 0 || sa_json_kind(content_node) != 6 { return; };
    let idx: u64 = 0;
    while 1 == 1 {
        let el: u64 = 0;
        if sa_json_array_get(content_node, idx, &el) != 0 { break; };
        idx = idx + 1;
        if el == 0 { continue; };
        let tp: ptr = PTR_NULL();
        let tl: u64 = 0;
        sa_json_object_get_string(el, STR_PTR("type"), STR_LEN("type"), &tp, &tl);
        if tl == 4 && bytes_eq_str(tp, tl, STR_PTR("text"), STR_LEN("text")) {
            let xp: ptr = PTR_NULL();
            let xl: u64 = 0;
            sa_json_object_get_string(el, STR_PTR("text"), STR_LEN("text"), &xp, &xl);
            if xl != 0 { part_new_text(list, xp, xl); };
        } else if tl == 9 && bytes_eq_str(tp, tl, STR_PTR("image_url"), STR_LEN("image_url")) {
            let inner: u64 = 0;
            sa_json_object_get(el, STR_PTR("image_url"), STR_LEN("image_url"), &inner);
            let up: ptr = PTR_NULL();
            let ul: u64 = 0;
            if inner != 0 { sa_json_object_get_string(inner, STR_PTR("url"), STR_LEN("url"), &up, &ul); };
            if ul != 0 {
                // mimeType defaults to image/png; data: URLs carry their own.
                let mime = StrField { bytes: [0u8; 512], len: 0 };
                str_field_set(&mime, STR_PTR("image/png"), STR_LEN("image/png"));
                if starts_with(up, ul, STR_PTR("data:"), STR_LEN("data:")) {
                    let semi = find_byte(up, ul, 59);
                    if semi != 4294967295 && semi > 0 {
                        let mp: ptr = PTR_NULL();
                        PTR_BYTE_ADD(mp, up, 5);
                        str_field_set(&mime, mp, semi - 5);
                    };
                };
                if list.len < 64 {
                    let p = list.parts[list.len];
                    str_field_set(&p.typ, STR_PTR("image"), STR_LEN("image"));
                    p.has_image = true;
                    str_field_set(&p.image, up, ul);
                    p.has_mime_type = true;
                    p.mime_type = mime;
                    p.has_text = false;
                    p.has_filename = false;
                    list.parts[list.len] = p;
                    list.len = list.len + 1;
                };
            };
        } else if tl == 5 && bytes_eq_str(tp, tl, STR_PTR("image"), STR_LEN("image")) {
            let ip: ptr = PTR_NULL();
            let il: u64 = 0;
            sa_json_object_get_string(el, STR_PTR("image"), STR_LEN("image"), &ip, &il);
            if il != 0 {
                let mp: ptr = PTR_NULL();
                let ml: u64 = 0;
                sa_json_object_get_string(el, STR_PTR("mimeType"), STR_LEN("mimeType"), &mp, &ml);
                if list.len < 64 {
                    let p = list.parts[list.len];
                    str_field_set(&p.typ, STR_PTR("image"), STR_LEN("image"));
                    p.has_image = true;
                    str_field_set(&p.image, ip, il);
                    p.has_mime_type = true;
                    if ml != 0 { str_field_set(&p.mime_type, mp, ml); } else { str_field_set(&p.mime_type, STR_PTR("image/png"), STR_LEN("image/png")); };
                    p.has_text = false;
                    p.has_filename = false;
                    list.parts[list.len] = p;
                    list.len = list.len + 1;
                };
            };
        } else if tl == 10 && bytes_eq_str(tp, tl, STR_PTR("input_file"), STR_LEN("input_file")) {
            let fp: ptr = PTR_NULL();
            let fl: u64 = 0;
            sa_json_object_get_string(el, STR_PTR("file_id"), STR_LEN("file_id"), &fp, &fl);
            if fl != 0 {
                let found = 4294967295;
                if has_store { found = file_store_lookup(store, fp, fl); };
                if found != 4294967295 {
                    let entry = store.entries[found];
                    let __ap11: ptr = PTR_NULL();
                    PTR_BYTE_ADD(__ap11, entry.mime_type.bytes, 0);
                    if starts_with(__ap11, entry.mime_type.len, STR_PTR("image/"), STR_LEN("image/")) {
                        // data:<mime>;base64,<bytes> passthrough (no webp resize)
                        let img = ByteBuf { bytes: [0u8; 40960], len: 0 };
                        buf_append_lit(&img, STR_PTR("data:"), STR_LEN("data:"));
                        let __ap12: ptr = PTR_NULL();
                        PTR_BYTE_ADD(__ap12, entry.mime_type.bytes, 0);
                        buf_append_lit(&img, __ap12, entry.mime_type.len);
                        buf_append_lit(&img, STR_PTR(";base64,"), STR_LEN(";base64,"));
                        // DEFECT: Buffer.from(data).toString("base64") — intent extern.
                        let __ap_b64img: ptr = PTR_NULL();
                        PTR_BYTE_ADD(__ap_b64img, entry.data.bytes, 0);
                        sa_base64_encode(__ap_b64img, entry.data.len, &img);
                        if list.len < 64 {
                            let p = list.parts[list.len];
                            str_field_set(&p.typ, STR_PTR("image"), STR_LEN("image"));
                            p.has_image = true;
                            let __ap13: ptr = PTR_NULL();
                            PTR_BYTE_ADD(__ap13, img.bytes, 0);
                            str_field_set(&p.image, __ap13, img.len);
                            p.has_mime_type = true;
                            p.mime_type = entry.mime_type;
                            p.has_text = false;
                            p.has_filename = false;
                            list.parts[list.len] = p;
                            list.len = list.len + 1;
                        };
                    } else {
                        // text = utf8 with NUL stripped, capped at 50000 chars + marker
                        let text = ByteBuf { bytes: [0u8; 40960], len: 0 };
                        buf_append_lit(&text, STR_PTR("[File: "), STR_LEN("[File: "));
                        let __ap14: ptr = PTR_NULL();
                        PTR_BYTE_ADD(__ap14, entry.filename.bytes, 0);
                        buf_append_lit(&text, __ap14, entry.filename.len);
                        buf_append_lit(&text, STR_PTR("]\n"), STR_LEN("]\n"));
                        let body = ByteBuf { bytes: [0u8; 40960], len: 0 };
                        for bi in 0..entry.data.len {
                            let b = entry.data.bytes[bi];
                            if b != 0 { buf_append_byte(&body, b); };
                        }
                        if body.len > 50000 {
                            body.len = 50000;
                            buf_append_lit(&body, STR_PTR("\n...(truncated)"), STR_LEN("\n...(truncated)"));
                        };
                        buf_append_buf(&text, &body);
                        let __ap15: ptr = PTR_NULL();
                        PTR_BYTE_ADD(__ap15, text.bytes, 0);
                        part_new_text(list, __ap15, text.len);
                    };
                } else {
                    let text = ByteBuf { bytes: [0u8; 40960], len: 0 };
                    buf_append_lit(&text, STR_PTR("[file:"), STR_LEN("[file:"));
                    buf_append_lit(&text, fp, fl);
                    buf_append_lit(&text, STR_PTR("]"), STR_LEN("]"));
                    let __ap16: ptr = PTR_NULL();
                    PTR_BYTE_ADD(__ap16, text.bytes, 0);
                    part_new_text(list, __ap16, text.len);
                };
            };
        };
    }
}

// TS: export interface ConvertOptions { reasoningEffort?; webSearch?; generateImage?; fileStore? }
struct ConvertOptions {
    has_reasoning_effort: bool,
    reasoning_effort: StrField,
    web_search: bool,
    generate_image: bool,
    has_file_store: bool,
}

// TS: export function convertAPIRequestWithOptions(api: APIRequest, opts: ConvertOptions = {}): DuckApiRequest
// api is the validated request as a JSON node; req is filled in place.
// store is consulted when opts.has_file_store.
fn convert_api_request_with_options(req: &DuckApiRequest, api: u64, opts: &ConvertOptions, store: &FileStore) -> void {
    let model_ptr: ptr = PTR_NULL();
    let model_len: u64 = 0;
    sa_json_object_get_string(api, STR_PTR("model"), STR_LEN("model"), &model_ptr, &model_len);
    map_model(&req.model, model_ptr, model_len);
    req.has_tool_choice = false;
    req.tool_choice_web_search = false;
    req.tool_choice_generate_image = false;
    req.messages_len = 0;
    req.can_use_tools = true;
    if opts.has_reasoning_effort {
        let __ap17: ptr = PTR_NULL();
        PTR_BYTE_ADD(__ap17, opts.reasoning_effort.bytes, 0);
        cap_reasoning_effort(&req.reasoning_effort, __ap17, opts.reasoning_effort.len);
    } else {
        str_field_set(&req.reasoning_effort, STR_PTR("low"), STR_LEN("low"));
    };
    req.has_can_use_approx_location = false;
    req.can_use_approx_location = false;
    req.has_can_delegate_image_generation = false;
    req.can_delegate_image_generation = false;
    req.can_show_greeting = true;
    new_durable_stream(req);
    req.has_tool_simulation = false;
    req.tool_simulation = false;
    if opts.web_search { req.tool_choice_web_search = true; req.has_tool_choice = true; };
    if opts.generate_image { req.tool_choice_generate_image = true; req.has_tool_choice = true; };
    let messages: u64 = 0;
    if sa_json_object_get(api, STR_PTR("messages"), STR_LEN("messages"), &messages) != 0 || messages == 0 { return; };
    let idx: u64 = 0;
    while 1 == 1 {
        let msg: u64 = 0;
        if sa_json_array_get(messages, idx, &msg) != 0 { break; };
        idx = idx + 1;
        if msg == 0 { continue; };
        let rp: ptr = PTR_NULL();
        let rl: u64 = 0;
        sa_json_object_get_string(msg, STR_PTR("role"), STR_LEN("role"), &rp, &rl);
        // Pure-conversation channel: system/developer/tool dropped entirely;
        // anything that is not user/assistant is dropped too.
        let is_user = rl == 4 && bytes_eq_str(rp, rl, STR_PTR("user"), STR_LEN("user"));
        let is_assistant = rl == 9 && bytes_eq_str(rp, rl, STR_PTR("assistant"), STR_LEN("assistant"));
        if !is_user && !is_assistant { continue; };
        let content: u64 = 0;
        sa_json_object_get(msg, STR_PTR("content"), STR_LEN("content"), &content);
        let parts = PartsList { parts: [DuckContentPart { typ: StrField { bytes: [0u8; 512], len: 0 }, has_text: false, text: StrField { bytes: [0u8; 512], len: 0 }, has_image: false, image: StrField { bytes: [0u8; 512], len: 0 }, has_mime_type: false, mime_type: StrField { bytes: [0u8; 512], len: 0 }, has_filename: false, filename: StrField { bytes: [0u8; 512], len: 0 } }; 64], len: 0 };
        extract_content_parts(&parts, content, opts.has_file_store, store);
        if parts.len == 0 { continue; };
        if is_assistant {
            // Fold assistant content into the user stream with attribution.
            let done = false;
            for pi in 0..parts.len {
                if !done && parts.parts[pi].has_text && parts.parts[pi].text.len > 0 {
                    let merged = ByteBuf { bytes: [0u8; 40960], len: 0 };
                    buf_append_lit(&merged, STR_PTR("[assistant] "), STR_LEN("[assistant] "));
                    let __ap18: ptr = PTR_NULL();
                    PTR_BYTE_ADD(__ap18, parts.parts[pi].text.bytes, 0);
                    buf_append_lit(&merged, __ap18, parts.parts[pi].text.len);
                    let __ap19: ptr = PTR_NULL();
                    PTR_BYTE_ADD(__ap19, merged.bytes, 0);
                    str_field_set(&parts.parts[pi].text, __ap19, merged.len);
                    done = true;
                };
            }
            if !done {
                // unshift a "[assistant]" text part
                let j = parts.len;
                if j < 64 {
                    while j > 0 {
                        parts.parts[j] = parts.parts[j - 1];
                        j = j - 1;
                    }
                    part_clear(&parts.parts[0]);
                    str_field_set(&parts.parts[0].typ, STR_PTR("text"), STR_LEN("text"));
                    parts.parts[0].has_text = true;
                    str_field_set(&parts.parts[0].text, STR_PTR("[assistant]"), STR_LEN("[assistant]"));
                    parts.len = parts.len + 1;
                };
            };
        };
        if req.messages_len < 128 {
            let dm = req.messages[req.messages_len];
            if is_assistant {
                str_field_set(&dm.role, STR_PTR("user"), STR_LEN("user"));
            } else {
                str_field_set(&dm.role, rp, rl);
            };
            dm.content_is_parts = true;
            dm.parts = parts;
            req.messages[req.messages_len] = dm;
            req.messages_len = req.messages_len + 1;
        };
    }
    // canUseApproxLocation=false when image generation or any image part.
    let has_image = false;
    for mi in 0..req.messages_len {
        for pi in 0..req.messages[mi].parts.len {
            if req.messages[mi].parts.parts[pi].has_image { has_image = true; };
        }
    }
    if opts.generate_image || has_image {
        req.has_can_use_approx_location = true;
        req.can_use_approx_location = false;
    };
}

fn part_clear(p: &DuckContentPart) -> void {
    p.has_text = false;
    p.has_image = false;
    p.has_mime_type = false;
    p.has_filename = false;
}

// DuckApiRequest -> JSON text (Go request shape; used by upstream.sla).
fn duck_api_request_to_json(out: &ByteBuf, req: &DuckApiRequest) -> void {
    buf_reset(out);
    buf_append_lit(out, STR_PTR("{\"model\":\""), STR_LEN("{\"model\":\""));
    let __ap20: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap20, req.model.bytes, 0);
    buf_append_escaped(out, __ap20, req.model.len);
    buf_append_lit(out, STR_PTR("\",\"metadata\":"), STR_LEN("\",\"metadata\":"));
    if req.has_tool_choice {
        buf_append_lit(out, STR_PTR("{\"toolChoice\":{"), STR_LEN("{\"toolChoice\":{"));
        let first = true;
        if req.tool_choice_web_search {
            buf_append_lit(out, STR_PTR("\"WebSearch\":true"), STR_LEN("\"WebSearch\":true"));
            first = false;
        };
        if req.tool_choice_generate_image {
            if !first { buf_append_lit(out, STR_PTR(","), STR_LEN(",")); };
            buf_append_lit(out, STR_PTR("\"GenerateImage\":true"), STR_LEN("\"GenerateImage\":true"));
        };
        buf_append_lit(out, STR_PTR("}}"), STR_LEN("}}"));
    } else {
        buf_append_lit(out, STR_PTR("{}"), STR_LEN("{}"));
    };
    buf_append_lit(out, STR_PTR(",\"messages\":["), STR_LEN(",\"messages\":["));
    for mi in 0..req.messages_len {
        if mi > 0 { buf_append_lit(out, STR_PTR(","), STR_LEN(",")); };
        let m = req.messages[mi];
        buf_append_lit(out, STR_PTR("{\"role\":\""), STR_LEN("{\"role\":\""));
        let __ap21: ptr = PTR_NULL();
        PTR_BYTE_ADD(__ap21, m.role.bytes, 0);
        buf_append_escaped(out, __ap21, m.role.len);
        buf_append_lit(out, STR_PTR("\",\"content\":["), STR_LEN("\",\"content\":["));
        for pi in 0..m.parts.len {
            if pi > 0 { buf_append_lit(out, STR_PTR(","), STR_LEN(",")); };
            let p = m.parts.parts[pi];
            buf_append_lit(out, STR_PTR("{\"type\":\""), STR_LEN("{\"type\":\""));
            let __ap22: ptr = PTR_NULL();
            PTR_BYTE_ADD(__ap22, p.typ.bytes, 0);
            buf_append_escaped(out, __ap22, p.typ.len);
            buf_append_lit(out, STR_PTR("\""), STR_LEN("\""));
            if p.has_text {
                buf_append_lit(out, STR_PTR(",\"text\":\""), STR_LEN(",\"text\":\""));
                let __ap23: ptr = PTR_NULL();
                PTR_BYTE_ADD(__ap23, p.text.bytes, 0);
                buf_append_escaped(out, __ap23, p.text.len);
                buf_append_lit(out, STR_PTR("\""), STR_LEN("\""));
            };
            if p.has_image {
                buf_append_lit(out, STR_PTR(",\"image\":\""), STR_LEN(",\"image\":\""));
                let __ap24: ptr = PTR_NULL();
                PTR_BYTE_ADD(__ap24, p.image.bytes, 0);
                buf_append_escaped(out, __ap24, p.image.len);
                buf_append_lit(out, STR_PTR("\""), STR_LEN("\""));
            };
            if p.has_mime_type {
                buf_append_lit(out, STR_PTR(",\"mimeType\":\""), STR_LEN(",\"mimeType\":\""));
                let __ap25: ptr = PTR_NULL();
                PTR_BYTE_ADD(__ap25, p.mime_type.bytes, 0);
                buf_append_escaped(out, __ap25, p.mime_type.len);
                buf_append_lit(out, STR_PTR("\""), STR_LEN("\""));
            };
            if p.has_filename {
                buf_append_lit(out, STR_PTR(",\"filename\":\""), STR_LEN(",\"filename\":\""));
                let __ap26: ptr = PTR_NULL();
                PTR_BYTE_ADD(__ap26, p.filename.bytes, 0);
                buf_append_escaped(out, __ap26, p.filename.len);
                buf_append_lit(out, STR_PTR("\""), STR_LEN("\""));
            };
            buf_append_lit(out, STR_PTR("}"), STR_LEN("}"));
        }
        buf_append_lit(out, STR_PTR("]}"), STR_LEN("]}"));
    }
    buf_append_lit(out, STR_PTR("],\"canUseTools\":true,\"reasoningEffort\":\""), STR_LEN("],\"canUseTools\":true,\"reasoningEffort\":\""));
    let __ap27: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap27, req.reasoning_effort.bytes, 0);
    buf_append_escaped(out, __ap27, req.reasoning_effort.len);
    buf_append_lit(out, STR_PTR("\",\"canUseApproxLocation\":"), STR_LEN("\",\"canUseApproxLocation\":"));
    if req.has_can_use_approx_location {
        if req.can_use_approx_location { buf_append_lit(out, STR_PTR("true"), STR_LEN("true")); } else { buf_append_lit(out, STR_PTR("false"), STR_LEN("false")); };
    } else {
        buf_append_lit(out, STR_PTR("null"), STR_LEN("null"));
    };
    buf_append_lit(out, STR_PTR(",\"canDelegateImageGeneration\":null,\"canShowGreeting\":true,\"durableStream\":{\"messageId\":\""), STR_LEN(",\"canDelegateImageGeneration\":null,\"canShowGreeting\":true,\"durableStream\":{\"messageId\":\""));
    let __ap28: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap28, req.durable_message_id.bytes, 0);
    buf_append_escaped(out, __ap28, req.durable_message_id.len);
    buf_append_lit(out, STR_PTR("\",\"conversationId\":\""), STR_LEN("\",\"conversationId\":\""));
    let __ap29: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap29, req.durable_conversation_id.bytes, 0);
    buf_append_escaped(out, __ap29, req.durable_conversation_id.len);
    buf_append_lit(out, STR_PTR("\",\"publicKey\":"), STR_LEN("\",\"publicKey\":"));
    buf_append_buf(out, &req.durable_public_key_json);
    buf_append_lit(out, STR_PTR("}}"), STR_LEN("}}"));
}
