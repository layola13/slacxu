// Port of E:\projects\duck2api\util\util.go (token + cache-simulation half).
// TS: import { createHash } from "node:crypto";
// TS: import { encodingForModel } from "js-tiktoken";
// DEFECT: js-tiktoken BPE encoding (gpt-4o-mini) has no sa_std counterpart;
// sa_token_count_bpe is an intent extern that does not exist yet. TS catches
// encoder errors and returns 0; the approximation keeps that fallback shape.
// DEFECT: module-level mutable Map<string, CacheEntry> — SLA has no module
// globals; the store becomes an explicit CacheStore passed by reference,
// with a fixed capacity of 128 entries (TS Map is unbounded).

fn count_token(text_ptr: ptr, text_len: u64) -> u64 {
    // TS: enc.encode(input).length, catch -> 0.
    // DEFECT (B-class, four-source verdict): js-tiktoken BPE encoding
    // has NO counterpart in sala docs, SLA demos/tests, sa_plugin_sla
    // corpus, or the sa_std inventory (.sai/.sla/.sa + sa_std.h) —
    // token counting is UNSUPPORTED in this build. js-tiktoken is a
    // third-party library and belongs to the wrapper track (tsgosa
    // product + thin SLA wrapper), registered in FIX_OTHER_APPS.md;
    // the pilot is not started here. Returning 0 is exactly the TS
    // encoder-failure fallback (catch -> 0), so callers observe the
    // documented failure value, never an approximation.
    return 0;
}

// TS: export function countMessagesTokens(messages: ApiMessage[]): number
// messages arrive as a JSON array node; each message contributes
// messageText(content) + "\n" to the joined string.
fn count_messages_tokens(messages_node: u64) -> u64 {
    let joined = ByteBuf { bytes: [0u8; 40960], len: 0 };
    let text = ByteBuf { bytes: [0u8; 40960], len: 0 };
    let idx: u64 = 0;
    while 1 == 1 {
        let msg: u64 = 0;
        if sa_json_array_get(messages_node, idx, &msg) != 0 { break; };
        let content: u64 = 0;
        sa_json_object_get(msg, STR_PTR("content"), STR_LEN("content"), &content);
        message_text(&text, content);
        buf_append_buf(&joined, &text);
        buf_append_lit(&joined, STR_PTR("\n"), STR_LEN("\n"));
        idx = idx + 1;
    }
    let __ap97: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap97, joined.bytes, 0);
    return count_token(__ap97, joined.len);
}

// TS: export function hashPrompt(s: string): string
// createHash("sha256").update(s, "utf8").digest("hex") — 64 hex chars in out.
fn hash_prompt(out: &ByteBuf, s_ptr: ptr, s_len: u64) -> void {
    buf_reset(out);
    // Rebound: sa_std_net_sha256_hex (net.sai) — same binding as the
    // hub's sa_crypto_sha256_base64 in types.sla.
    let scratch = ByteBuf { bytes: [0u8; 40960], len: 0 };
    let op: ptr = PTR_NULL();
    PTR_BYTE_ADD(op, scratch.bytes, 0);
    let ol: u64 = 0;
    if sa_std_net_sha256_hex(s_ptr, s_len, op, 40960, &ol) == 0 {
        buf_append_lit(out, op, ol);
    };
}

struct CacheEntry {
    hash: [u8; 64],
    hash_len: u64,
    tokens: u64,
    created_at: u64,
    expires_at: u64,
}

struct CacheStore {
    entries: [CacheEntry; 128],
    len: u64,
}

fn cache_ttl_ms() -> u64 { return 5 * 60000; }

// TS: Date.now() — intent extern sa_time_now_ms (MISSING surface check).
// recordCache result pair.
struct CacheResult {
    creation: u64,
    read: u64,
}

// TS: export function recordCache(promptHash: string, tokens: number): { creation: number; read: number }
fn record_cache(store: &CacheStore, hash_ptr: ptr, hash_len: u64, tokens: u64, out: &CacheResult) -> void {
    out.creation = 0;
    out.read = 0;
    if hash_len == 0 || tokens == 0 { return; };
    let now = (sa_time_unix_ms() as u64);
    // Evict expired entries (TS iterates the Map and deletes).
    let i: u64 = 0;
    while i < store.len {
        if now > store.entries[i].expires_at {
            // delete: shift the tail down (Map deletion approximation).
            let j = i;
            while j + 1 < store.len {
                store.entries[j] = store.entries[j + 1];
                j = j + 1;
            }
            store.len = store.len - 1;
        } else {
            i = i + 1;
        };
    }
    for k in 0..store.len {
        let __ap98: ptr = PTR_NULL();
        PTR_BYTE_ADD(__ap98, store.entries[k].hash, 0);
        if store.entries[k].hash_len == hash_len && bytes_eq3(__ap98, hash_ptr, hash_len) {
            if now < store.entries[k].expires_at {
                out.read = store.entries[k].tokens;
                return;
            };
        };
    }
    if store.len < 128 {
        let e = store.entries[store.len];
        e.hash_len = 0;
        for m in 0..hash_len {
            if e.hash_len < 64 {
                let b: u8 = 0;
                PTR_BYTE_AT(b, hash_ptr, m);
                e.hash[e.hash_len] = b;
                e.hash_len = e.hash_len + 1;
            };
        }
        e.tokens = tokens;
        e.created_at = now;
        e.expires_at = now + cache_ttl_ms();
        store.entries[store.len] = e;
        store.len = store.len + 1;
    };
    out.creation = tokens;
}

// cacheHeaders result: xCache is "HIT" | "MISS".
struct CacheHeaders {
    hit: bool,
    age: u64,
}

// TS: export function cacheHeaders(promptHash: string): { xCache: "HIT" | "MISS"; age: number }
fn cache_headers(store: &CacheStore, hash_ptr: ptr, hash_len: u64, out: &CacheHeaders) -> void {
    out.hit = false;
    out.age = 0;
    if hash_len == 0 { return; };
    let now = (sa_time_unix_ms() as u64);
    for k in 0..store.len {
        let __ap99: ptr = PTR_NULL();
        PTR_BYTE_ADD(__ap99, store.entries[k].hash, 0);
        if store.entries[k].hash_len == hash_len && bytes_eq3(__ap99, hash_ptr, hash_len) {
            if now < store.entries[k].expires_at {
                out.hit = true;
                out.age = (now - store.entries[k].created_at) / 1000;
                return;
            };
        };
    }
}
