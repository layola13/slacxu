@import "sa_std/fmt.sai"
@import "convert.sla"
@import "vqd.sla"

// Port of E:\projects\duck2api\internal\duckgo\request.go (upstream half).
// Differences from Go (documented):
// - HTTP via fetch + manual cookie jar per proxy session; the Go build uses a
//   TLS-fingerprint client (bogdanfinn/tls-client). Fingerprint parity is a
//   known gap: expect more 418/429 until impersonation lands.
// - Proxy: honors HTTP(S)_PROXY env via fetch; explicit per-request proxyUrl
//   sessions keep separate cookie jars but share the process egress.
//
// DEFECT: upstream.ts is built on async fetch / Promises / dynamic
// import("fetch-impersonate") / setTimeout sleeps / a promise-chain mutex
// (waitSlot). SLA has no async runtime in this conversion: every step is a
// synchronous fn, sleeps and the serialized queue collapse into intent
// externs (sa_time_sleep_ms, sa_http_fetch_*), and the TLS-impersonation fetch
// (fetch-impersonate chrome146 preset) is an intent extern
// sa_http_fetch_impersonated — sa_std has no TLS-fingerprint client.
// DEFECT: module-level mutable state (fetchImpl, duckFetchDegraded,
// sessions Map, lastConversationEnd, rateLimitUntil, rateLimitFails,
// queue) is collected into one UpstreamState struct the caller owns.
// DEFECT: Response bodies are ReadableStream<Uint8Array> in TS; here a
// body is an opaque handle (u64, 0 = none) consumed by stream.sla.

// TS: export const DUCK_BASE_URL / DUCK_STATUS_URL / DUCK_CHAT_URL / DUCK_HOME_URL
fn duck_base_url() -> ptr { return STR_PTR("https://duck.ai"); }
fn duck_base_url_len() -> u64 { return STR_LEN("https://duck.ai"); }
fn duck_status_url() -> ptr { return STR_PTR("https://duck.ai/duckchat/v1/status"); }
fn duck_status_url_len() -> u64 { return STR_LEN("https://duck.ai/duckchat/v1/status"); }
fn duck_chat_url() -> ptr { return STR_PTR("https://duck.ai/duckchat/v1/chat"); }
fn duck_chat_url_len() -> u64 { return STR_LEN("https://duck.ai/duckchat/v1/chat"); }
fn duck_home_url() -> ptr { return STR_PTR("https://duck.ai/"); }
fn duck_home_url_len() -> u64 { return STR_LEN("https://duck.ai/"); }

// TS: export const DUCK_UA
fn duck_ua() -> ptr { return STR_PTR("Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/146.0.0.0 Safari/537.36"); }
fn duck_ua_len() -> u64 { return STR_LEN("Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/146.0.0.0 Safari/537.36"); }

// TS: const REQUEST_INTERVAL_MS = 10_000; CHALLENGE_RETRIES = 1;
//      RETRY_STEP_MS = 10_000; RETRY_MAX_MS = 120_000
fn request_interval_ms() -> u64 { return 10000; }
fn challenge_retries() -> u64 { return 1; }
fn retry_step_ms() -> u64 { return 10000; }
fn retry_max_ms() -> u64 { return 120000; }

// TS: function backoff(retryNumber: number): number
fn backoff_ms(retry_number: u64) -> u64 {
    // Math.max(1, retryNumber) / Math.min(n * STEP, MAX) bound to
    // @ts_math_minmax (sa_std ts_math.sa; values fit i32 by construction).
    let n = ts_math_minmax(retry_number, 1, 1);
    let ms = ts_math_minmax(n * retry_step_ms(), retry_max_ms(), 0);
    return ms;
}

// TS: export function randomHex(byteLength: number): string
// randomBytes failure falls back to Date.now().toString(16) in TS; the
// intent extern reports failure via its return code and the fallback is
// reproduced here.
fn random_hex(out: &ByteBuf, byte_length: u64) -> void {
    buf_reset(out);
    // TS source adjudication (upstream.ts:73-75): randomHex is
    // randomBytes(byteLength).toString("hex") from node:crypto — a
    // cryptographic use. The intent extern sa_crypto_random_hex does
    // not exist, but the OS CSPRNG does: sa_crypto_random_bytes
    // (crypto.sai, std wave 2). Failure (or an oversized request)
    // keeps the TS fallback: Date.now().toString(16).
    let tmp: [u8; 512] = [0u8; 512];
    if byte_length > 512 || sa_crypto_random_bytes(&tmp, byte_length) != 0 {
        buf_append_hex_u64(out, (sa_time_unix_ms() as u64));
        return;
    };
    let digits = STR_PTR("0123456789abcdef");
    for i in 0..byte_length {
        let b = tmp[i] as u64;
        buf_append_byte(out, PTR_BYTE_AT(digits, b >> 4));
        buf_append_byte(out, PTR_BYTE_AT(digits, b & 15));
    }
}

// TS: class Jar — minimal cookie jar: name=value pairs per proxy session.
// A Map<string,string> in TS; fixed table here (insertion order preserved
// for header(), matching Map iteration order).
struct CookieJar {
    names: [StrField; 64],
    values: [StrField; 64],
    len: u64,
}

fn jar_clear(jar: &CookieJar) -> void {
    jar.len = 0;
}

// TS: Jar.store(setCookie: string[] | undefined)
// lines arrive pre-split by collect_cookies (one Set-Cookie line each).
fn jar_store_line(jar: &CookieJar, line_ptr: ptr, line_len: u64) -> void {
    // pair = line.split(";", 1)[0] — everything before the first ';'
    let pair_len = line_len;
    let semi = find_byte(line_ptr, line_len, 59);
    if semi != 4294967295 { pair_len = semi; };
    if pair_len == 0 { return; };
    let eq = find_byte(line_ptr, pair_len, 61);
    if eq == 4294967295 || eq == 0 { return; };
    let name = ByteBuf { bytes: [0u8; 40960], len: 0 };
    buf_append_lit(&name, line_ptr, eq);
    buf_trim(&name);
    let vp: ptr = PTR_NULL();
    PTR_BYTE_ADD(vp, line_ptr, eq + 1);
    let value = ByteBuf { bytes: [0u8; 40960], len: 0 };
    buf_append_lit(&value, vp, pair_len - eq - 1);
    buf_trim(&value);
    for i in 0..jar.len {
        let __ap134: ptr = PTR_NULL();
        PTR_BYTE_ADD(__ap134, jar.names[i].bytes, 0);
        let __ap133: ptr = PTR_NULL();
        PTR_BYTE_ADD(__ap133, name.bytes, 0);
        if jar.names[i].len == name.len && bytes_eq3(__ap134, __ap133, name.len) {
            let __ap135: ptr = PTR_NULL();
            PTR_BYTE_ADD(__ap135, value.bytes, 0);
            str_field_set(&jar.values[i], __ap135, value.len);
            return;
        };
    }
    if jar.len < 64 {
        let __ap136: ptr = PTR_NULL();
        PTR_BYTE_ADD(__ap136, name.bytes, 0);
        str_field_set(&jar.names[jar.len], __ap136, name.len);
        let __ap137: ptr = PTR_NULL();
        PTR_BYTE_ADD(__ap137, value.bytes, 0);
        str_field_set(&jar.values[jar.len], __ap137, value.len);
        jar.len = jar.len + 1;
    };
}

// TS: Jar.header(): string — [...cookies].map(([k,v]) => `${k}=${v}`).join("; ")
fn jar_header(out: &ByteBuf, jar: &CookieJar) -> void {
    buf_reset(out);
    for i in 0..jar.len {
        if i > 0 { buf_append_lit(out, STR_PTR("; "), STR_LEN("; ")); };
        let __ap138: ptr = PTR_NULL();
        PTR_BYTE_ADD(__ap138, jar.names[i].bytes, 0);
        buf_append_lit(out, __ap138, jar.names[i].len);
        buf_append_lit(out, STR_PTR("="), STR_LEN("="));
        let __ap139: ptr = PTR_NULL();
        PTR_BYTE_ADD(__ap139, jar.values[i].bytes, 0);
        buf_append_lit(out, __ap139, jar.values[i].len);
    }
}

// TS: interface Session { jar: Jar; vqd: string; feVersion: string; feExpireAt: number }
struct DuckSession {
    jar: CookieJar,
    vqd: StrField,
    fe_version: StrField,
    fe_expire_at: u64,
}

// TS: const sessions = new Map<string, Session>() — keyed by proxyUrl.
struct SessionTable {
    keys: [StrField; 32],
    sessions: [DuckSession; 32],
    len: u64,
}

// Module state (TS module-level lets) gathered into one struct.
struct UpstreamState {
    fetch_ready: bool,
    fetch_degraded: bool,
    sessions: SessionTable,
    last_conversation_end: u64,
    rate_limit_until: u64,
    rate_limit_fails: u64,
}

// TS: export function isDuckFetchDegraded(): boolean
fn is_duck_fetch_degraded(state: &UpstreamState) -> bool {
    return state.fetch_degraded;
}

// Real env surface (env.sai): sa_env_get(key, klen) -> u64 handle
// (0 = unset) + sa_env_buffer_data/len/free. The converter's
// sa_env_get(&buf, key, klen) out-param form does not exist.
fn env_read_buf(out: &ByteBuf, kp: ptr, kl: u64) -> void {
    buf_reset(out);
    let h = sa_env_get(kp, kl);
    if h != 0 {
        let p: ptr = sa_env_buffer_data(h);
        buf_append_lit(out, p, sa_env_buffer_len(h));
        sa_env_buffer_free(h);
    };
}

// TS: async function getFetch(): Promise<FetchFn>
// Resolves the transport once: DUCK_FETCH != "native" tries the
// impersonating fetch (preset DUCK_IMPERSONATE_TARGET ?? "chrome146") and
// degrades to native on load failure. Here it only records readiness; the
// actual fetch goes through sa_http_fetch_impersonated / native externs.
fn get_fetch(state: &UpstreamState) -> void {
    if state.fetch_ready { return; };
    let mode = ByteBuf { bytes: [0u8; 40960], len: 0 };
    env_read_buf(&mode, STR_PTR("DUCK_FETCH"), STR_LEN("DUCK_FETCH"));
    if mode.len == 0 { buf_append_lit(&mode, STR_PTR("impersonate"), STR_LEN("impersonate")); };
    buf_to_lower(&mode);
    state.fetch_degraded = false;
    let __ap140: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap140, mode.bytes, 0);
    if !bytes_eq_str(__ap140, mode.len, STR_PTR("native"), STR_LEN("native")) {
        let preset = ByteBuf { bytes: [0u8; 40960], len: 0 };
        env_read_buf(&preset, STR_PTR("DUCK_IMPERSONATE_TARGET"), STR_LEN("DUCK_IMPERSONATE_TARGET"));
        if preset.len == 0 { buf_append_lit(&preset, STR_PTR("chrome146"), STR_LEN("chrome146")); };
        let __ap_avail: ptr = PTR_NULL();
        PTR_BYTE_ADD(__ap_avail, preset.bytes, 0);
        if sa_http_impersonate_available(__ap_avail, preset.len) != 0 {
            state.fetch_degraded = true;
            // DEFECT: console.warn(...) diagnostic has no SLA equivalent;
            // the degraded flag is the only observable (same as TS callers
            // see via isDuckFetchDegraded).
        };
    };
    state.fetch_ready = true;
}

// --- fetch family: local implementation over the std stateful HTTP
// client (http_client.sai). The converter's intent externs
// (sa_http_fetch_get/post, sa_http_response_*) do not exist; the res
// handle here is the std response pointer as u64 (PTR_ADDR), with the
// matching request/client pointers kept in u64 cells keyed by the
// handle ("up.req.<h>" / "up.client.<h>") so release frees all three.
//
// Impersonation: the TS resolves an impersonating fetch (TLS
// fingerprint preset, e.g. chrome146) and degrades to native when the
// module cannot load. sa_std has shaped-TLS primitives
// (sa_std_tls_shaped_*) but no preset fetch client is bound in this
// file, so the probe honestly reports unavailable: get_fetch marks
// fetch_degraded and every fetch below takes the native path — the
// same observable state as the TS module-load-failure path.
// DEFECT: response headers are readable only BY NAME through the std
// client; repeated Set-Cookie values cannot be enumerated, so
// collect_cookies sees at most the single by-name value (count 0/1).
fn sa_http_impersonate_available(preset_ptr: ptr, preset_len: u64) -> i32 {
    return 1;
}

fn http_fetch_send(method: u8, url_ptr: ptr, url_len: u64, h: &HeaderList, body_ptr: ptr, body_len: u64, has_body: bool, out_res: &u64) -> i32 {
    *out_res = 0;
    let use_tls: u8 = 0;
    if starts_with(url_ptr, url_len, STR_PTR("https://"), STR_LEN("https://")) { use_tls = 1; };
    let client: ptr = PTR_NULL();
    if sa_http_client_new(use_tls, &client) != 0 || client == PTR_NULL() { return 1; };
    let req: ptr = PTR_NULL();
    if sa_http_client_req_new(client, method, url_ptr, url_len, &req) != 0 || req == PTR_NULL() {
        sa_http_client_free(client);
        return 1;
    };
    for i in 0..h.len {
        let __apf1: ptr = PTR_NULL();
        PTR_BYTE_ADD(__apf1, h.names[i].bytes, 0);
        let __apf2: ptr = PTR_NULL();
        PTR_BYTE_ADD(__apf2, h.values[i].bytes, 0);
        sa_http_client_req_add_header(req, __apf1, h.names[i].len, __apf2, h.values[i].len);
    }
    if has_body { sa_http_client_req_set_body(req, body_ptr, body_len); };
    let resp: ptr = PTR_NULL();
    if sa_http_client_req_send(req, &resp) != 0 || resp == PTR_NULL() {
        sa_http_client_req_free(req);
        sa_http_client_free(client);
        return 1;
    };
    let handle: u64 = 0;
    PTR_ADDR(handle, resp);
    let req_v: u64 = 0;
    PTR_ADDR(req_v, req);
    let cli_v: u64 = 0;
    PTR_ADDR(cli_v, client);
    let nm = ByteBuf { bytes: [0u8; 40960], len: 0 };
    buf_append_lit(&nm, STR_PTR("up.req."), STR_LEN("up.req."));
    buf_append_u64(&nm, handle);
    let __apf3: ptr = PTR_NULL();
    PTR_BYTE_ADD(__apf3, nm.bytes, 0);
    sa_global_u64_set(__apf3, nm.len, req_v);
    buf_reset(&nm);
    buf_append_lit(&nm, STR_PTR("up.client."), STR_LEN("up.client."));
    buf_append_u64(&nm, handle);
    let __apf4: ptr = PTR_NULL();
    PTR_BYTE_ADD(__apf4, nm.bytes, 0);
    sa_global_u64_set(__apf4, nm.len, cli_v);
    *out_res = handle;
    return 0;
}

fn sa_http_fetch_get(state: &UpstreamState, url_ptr: ptr, url_len: u64, h: &HeaderList, out_res: &u64) -> i32 {
    return http_fetch_send(1, url_ptr, url_len, h, PTR_NULL(), 0, false, out_res);
}

fn sa_http_fetch_post(state: &UpstreamState, url_ptr: ptr, url_len: u64, h: &HeaderList, body_ptr: ptr, body_len: u64, out_res: &u64) -> i32 {
    return http_fetch_send(2, url_ptr, url_len, h, body_ptr, body_len, true, out_res);
}

fn sa_http_response_status(res: u64) -> u64 {
    if res == 0 { return 0; };
    let resp: ptr = PTR_NULL();
    PTR_CAST(resp, res);
    return sa_http_client_resp_status(resp) as u64;
}

fn sa_http_response_header(res: u64, name_ptr: ptr, name_len: u64, out_ptr: &ptr, out_len: &u64) -> i32 {
    *out_ptr = PTR_NULL();
    *out_len = 0;
    if res == 0 { return 1; };
    let resp: ptr = PTR_NULL();
    PTR_CAST(resp, res);
    if sa_http_client_resp_get_header(resp, name_ptr, name_len, out_ptr, out_len) != 0 {
        *out_ptr = PTR_NULL();
        *out_len = 0;
        return 1;
    };
    return 0;
}

fn sa_http_response_text(res: u64, out: &ByteBuf) -> void {
    buf_reset(out);
    if res == 0 { return; };
    let resp: ptr = PTR_NULL();
    PTR_CAST(resp, res);
    let bp = sa_http_client_resp_body_ptr(resp);
    let bl = sa_http_client_resp_body_len(resp);
    if bp != PTR_NULL() && bl > 0 { buf_append_lit(out, bp, bl); };
}

fn sa_http_response_set_cookie_count(res: u64) -> u64 {
    let vp: ptr = PTR_NULL();
    let vl: u64 = 0;
    if sa_http_response_header(res, STR_PTR("set-cookie"), STR_LEN("set-cookie"), &vp, &vl) != 0 || vl == 0 { return 0; };
    return 1;
}

fn sa_http_response_set_cookie(res: u64, idx: u64, out_ptr: &ptr, out_len: &u64) -> void {
    *out_ptr = PTR_NULL();
    *out_len = 0;
    if idx != 0 { return; };
    sa_http_response_header(res, STR_PTR("set-cookie"), STR_LEN("set-cookie"), out_ptr, out_len);
}

fn sa_http_response_release(res: u64) -> void {
    if res == 0 { return; };
    let resp: ptr = PTR_NULL();
    PTR_CAST(resp, res);
    sa_http_client_resp_free(resp);
    let nm = ByteBuf { bytes: [0u8; 40960], len: 0 };
    buf_append_lit(&nm, STR_PTR("up.req."), STR_LEN("up.req."));
    buf_append_u64(&nm, res);
    let __apf5: ptr = PTR_NULL();
    PTR_BYTE_ADD(__apf5, nm.bytes, 0);
    let v: u64 = 0;
    if sa_global_u64_get(__apf5, nm.len, &v) == 0 && v != 0 {
        let rp: ptr = PTR_NULL();
        PTR_CAST(rp, v);
        sa_http_client_req_free(rp);
        sa_global_u64_set(__apf5, nm.len, 0);
    };
    buf_reset(&nm);
    buf_append_lit(&nm, STR_PTR("up.client."), STR_LEN("up.client."));
    buf_append_u64(&nm, res);
    let __apf6: ptr = PTR_NULL();
    PTR_BYTE_ADD(__apf6, nm.bytes, 0);
    if sa_global_u64_get(__apf6, nm.len, &v) == 0 && v != 0 {
        let cp: ptr = PTR_NULL();
        PTR_CAST(cp, v);
        sa_http_client_free(cp);
        sa_global_u64_set(__apf6, nm.len, 0);
    };
}

// TS: Math.random()-based randBelow for FE signal jitter (upstream.ts
// randBelow). The converter bound it to a "crypto-random" intent
// extern; the TS source is Math.random, so the faithful surface is
// sa_math_random (math.sai).
fn math_random_below(n: u64) -> u64 {
    if n == 0 { return 0; };
    return (sa_math_random() * (n as f64)) as u64;
}

// TS: function sessionFor(proxyUrl: string): Session
fn session_for(state: &UpstreamState, proxy_ptr: ptr, proxy_len: u64) -> u64 {
    for i in 0..state.sessions.len {
        let __ap141: ptr = PTR_NULL();
        PTR_BYTE_ADD(__ap141, state.sessions.keys[i].bytes, 0);
        if state.sessions.keys[i].len == proxy_len && bytes_eq3(__ap141, proxy_ptr, proxy_len) { return i; };
    }
    if state.sessions.len >= 32 { return 0; };
    let idx = state.sessions.len;
    str_field_set(&state.sessions.keys[idx], proxy_ptr, proxy_len);
    jar_clear(&state.sessions.sessions[idx].jar);
    state.sessions.sessions[idx].vqd.len = 0;
    state.sessions.sessions[idx].fe_version.len = 0;
    state.sessions.sessions[idx].fe_expire_at = 0;
    state.sessions.len = state.sessions.len + 1;
    return idx;
}

// TS: export function resetSession(proxyUrl: string): void
fn reset_session(state: &UpstreamState, proxy_ptr: ptr, proxy_len: u64) -> void {
    for i in 0..state.sessions.len {
        let __ap142: ptr = PTR_NULL();
        PTR_BYTE_ADD(__ap142, state.sessions.keys[i].bytes, 0);
        if state.sessions.keys[i].len == proxy_len && bytes_eq3(__ap142, proxy_ptr, proxy_len) {
            jar_clear(&state.sessions.sessions[i].jar);
            state.sessions.sessions[i].vqd.len = 0;
            state.sessions.sessions[i].fe_version.len = 0;
            state.sessions.sessions[i].fe_expire_at = 0;
            return;
        };
    }
}

// Header list passed to the fetch externs: parallel name/value table.
struct HeaderList {
    names: [StrField; 32],
    values: [StrField; 32],
    len: u64,
}

fn headers_reset(h: &HeaderList) -> void {
    h.len = 0;
}

fn headers_set(h: &HeaderList, name_ptr: ptr, name_len: u64, value_ptr: ptr, value_len: u64) -> void {
    for i in 0..h.len {
        let __ap143: ptr = PTR_NULL();
        PTR_BYTE_ADD(__ap143, h.names[i].bytes, 0);
        if h.names[i].len == name_len && bytes_eq3(__ap143, name_ptr, name_len) {
            str_field_set(&h.values[i], value_ptr, value_len);
            return;
        };
    }
    if h.len < 32 {
        str_field_set(&h.names[h.len], name_ptr, name_len);
        str_field_set(&h.values[h.len], value_ptr, value_len);
        h.len = h.len + 1;
    };
}

// TS: function baseHeaders(extra?): Record<string, string>
// Record key order in TS follows insertion order with `extra` spread last;
// the table preserves that (base keys first, extras override in place).
fn base_headers(h: &HeaderList) -> void {
    headers_reset(h);
    headers_set(h, STR_PTR("accept-encoding"), STR_LEN("accept-encoding"), STR_PTR("gzip, deflate, br, zstd"), STR_LEN("gzip, deflate, br, zstd"));
    headers_set(h, STR_PTR("accept-language"), STR_LEN("accept-language"), STR_PTR("zh-CN,zh;q=0.9,en-US;q=0.8,en;q=0.7"), STR_LEN("zh-CN,zh;q=0.9,en-US;q=0.8,en;q=0.7"));
    headers_set(h, STR_PTR("cache-control"), STR_LEN("cache-control"), STR_PTR("no-cache"), STR_LEN("no-cache"));
    headers_set(h, STR_PTR("content-type"), STR_LEN("content-type"), STR_PTR("application/json"), STR_LEN("application/json"));
    headers_set(h, STR_PTR("origin"), STR_LEN("origin"), duck_base_url(), duck_base_url_len());
    headers_set(h, STR_PTR("pragma"), STR_LEN("pragma"), STR_PTR("no-cache"), STR_LEN("no-cache"));
    headers_set(h, STR_PTR("referer"), STR_LEN("referer"), duck_home_url(), duck_home_url_len());
    headers_set(h, STR_PTR("sec-ch-ua"), STR_LEN("sec-ch-ua"), STR_PTR("\"Google Chrome\";v=\"146\", \"Chromium\";v=\"146\", \"Not)A;Brand\";v=\"24\""), STR_LEN("\"Google Chrome\";v=\"146\", \"Chromium\";v=\"146\", \"Not)A;Brand\";v=\"24\""));
    headers_set(h, STR_PTR("sec-ch-ua-mobile"), STR_LEN("sec-ch-ua-mobile"), STR_PTR("?0"), STR_LEN("?0"));
    headers_set(h, STR_PTR("sec-ch-ua-platform"), STR_LEN("sec-ch-ua-platform"), STR_PTR("\"Windows\""), STR_LEN("\"Windows\""));
    headers_set(h, STR_PTR("sec-fetch-dest"), STR_LEN("sec-fetch-dest"), STR_PTR("empty"), STR_LEN("empty"));
    headers_set(h, STR_PTR("sec-fetch-mode"), STR_LEN("sec-fetch-mode"), STR_PTR("cors"), STR_LEN("cors"));
    headers_set(h, STR_PTR("sec-fetch-site"), STR_LEN("sec-fetch-site"), STR_PTR("same-origin"), STR_LEN("same-origin"));
    headers_set(h, STR_PTR("user-agent"), STR_LEN("user-agent"), duck_ua(), duck_ua_len());
}

// TS: function collectCookies(res, jar)
// DEFECT: res.headers.getSetCookie() (Bun/undici) has no sa_std surface;
// the fetch extern hands back each Set-Cookie line separately and this
// loops them into the jar (the single-header fallback in TS maps to a
// one-line call).
fn collect_cookies(state: &UpstreamState, session_idx: u64, response: u64) -> void {
    let count = sa_http_response_set_cookie_count(response);
    for i in 0..count {
        let lp: ptr = PTR_NULL();
        let ll: u64 = 0;
        sa_http_response_set_cookie(response, i, &lp, &ll);
        if ll > 0 { jar_store_line(&state.sessions.sessions[session_idx].jar, lp, ll); };
    }
}

// TS: export function createFESignals(nowMs = Date.now()): string
// Math.random() maps to the crypto-random intent extern (uniform u64).
fn create_fe_signals(out: &ByteBuf, now_ms: u64) -> void {
    let impression = 50 + math_random_below(100);
    let action = impression + 5000 + math_random_below(25000);
    let finish = action + 1000 + math_random_below(9000);
    let start_chat = finish + 10 + math_random_below(90);
    let end = start_chat + math_random_below(10);
    let payload = ByteBuf { bytes: [0u8; 40960], len: 0 };
    buf_append_lit(&payload, STR_PTR("{\"start\":"), STR_LEN("{\"start\":"));
    buf_append_u64(&payload, now_ms - end);
    buf_append_lit(&payload, STR_PTR(",\"events\":[{\"name\":\"onboarding_impression\",\"delta\":"), STR_LEN(",\"events\":[{\"name\":\"onboarding_impression\",\"delta\":"));
    buf_append_u64(&payload, impression);
    buf_append_lit(&payload, STR_PTR("},{\"name\":\"action\",\"delta\":"), STR_LEN("},{\"name\":\"action\",\"delta\":"));
    buf_append_u64(&payload, action);
    buf_append_lit(&payload, STR_PTR(",\"trusted\":true},{\"name\":\"onboarding_finish\",\"delta\":"), STR_LEN(",\"trusted\":true},{\"name\":\"onboarding_finish\",\"delta\":"));
    buf_append_u64(&payload, finish);
    buf_append_lit(&payload, STR_PTR("},{\"name\":\"startNewChat_free\",\"delta\":"), STR_LEN("},{\"name\":\"startNewChat_free\",\"delta\":"));
    buf_append_u64(&payload, start_chat);
    buf_append_lit(&payload, STR_PTR("}],\"end\":"), STR_LEN("}],\"end\":"));
    buf_append_u64(&payload, end);
    buf_append_lit(&payload, STR_PTR("}"), STR_LEN("}"));
    buf_reset(out);
    // DEFECT: Buffer.from(json, "utf8").toString("base64") — intent extern.
    let __ap_b64u: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap_b64u, payload.bytes, 0);
    sa_base64_encode(__ap_b64u, payload.len, out);
}

// TS: async function fetchFEVersion(session): Promise<string>
// Returns 0 on success (session.fe_version filled), nonzero when the
// version metadata is missing (TS throws Error).
// DEFECT: regex body.match(/data-version-tag="([^"]+)"/) is a manual scan.
fn fetch_fe_version(state: &UpstreamState, session_idx: u64, err: &ByteBuf) -> i32 {
    let session = state.sessions.sessions[session_idx];
    if session.fe_version.len != 0 && session.fe_expire_at > (sa_time_unix_ms() as u64) { return 0; };
    get_fetch(state);
    let h = HeaderList { names: [StrField { bytes: [0u8; 512], len: 0 }; 32], values: [StrField { bytes: [0u8; 512], len: 0 }; 32], len: 0 };
    base_headers(&h);
    headers_set(&h, STR_PTR("accept"), STR_LEN("accept"), STR_PTR("text/html"), STR_LEN("text/html"));
    let cookie = ByteBuf { bytes: [0u8; 40960], len: 0 };
    jar_header(&cookie, &state.sessions.sessions[session_idx].jar);
    let __ap144: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap144, cookie.bytes, 0);
    if cookie.len > 0 { headers_set(&h, STR_PTR("cookie"), STR_LEN("cookie"), __ap144, cookie.len); };
    let res: u64 = 0;
    if sa_http_fetch_get(state, duck_home_url(), duck_home_url_len(), &h, &res) != 0 {
        buf_reset(err);
        buf_append_lit(err, STR_PTR("duck.ai version metadata not found"), STR_LEN("duck.ai version metadata not found"));
        return 1;
    };
    collect_cookies(state, session_idx, res);
    let body = ByteBuf { bytes: [0u8; 40960], len: 0 };
    sa_http_response_text(res, &body);
    sa_http_response_release(res);
    let tag = ByteBuf { bytes: [0u8; 40960], len: 0 };
    let sha = ByteBuf { bytes: [0u8; 40960], len: 0 };
    extract_html_attr(&body, STR_PTR("data-version-tag=\""), STR_LEN("data-version-tag=\""), &tag);
    extract_html_attr(&body, STR_PTR("data-version-sha=\""), STR_LEN("data-version-sha=\""), &sha);
    if tag.len == 0 || sha.len == 0 {
        buf_reset(err);
        buf_append_lit(err, STR_PTR("duck.ai version metadata not found"), STR_LEN("duck.ai version metadata not found"));
        return 1;
    };
    let combined = ByteBuf { bytes: [0u8; 40960], len: 0 };
    buf_append_buf(&combined, &tag);
    buf_append_lit(&combined, STR_PTR("-"), STR_LEN("-"));
    buf_append_buf(&combined, &sha);
    let __ap145: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap145, combined.bytes, 0);
    str_field_set(&state.sessions.sessions[session_idx].fe_version, __ap145, combined.len);
    state.sessions.sessions[session_idx].fe_expire_at = (sa_time_unix_ms() as u64) + 30 * 60000;
    return 0;
}

// scan for attr="<value>" and copy <value> (up to the closing quote)
fn extract_html_attr(body: &ByteBuf, attr_ptr: ptr, attr_len: u64, out: &ByteBuf) -> void {
    buf_reset(out);
    let __ap146: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap146, body.bytes, 0);
    let at = find_sub_buf(__ap146, body.len, attr_ptr, attr_len);
    if at == 4294967295 { return; };
    let start = at + attr_len;
    let p: ptr = PTR_NULL();
    PTR_BYTE_ADD(p, body.bytes, start);
    let rest = body.len - start;
    let close = find_byte(p, rest, 34);
    if close == 4294967295 { return; };
    buf_append_lit(out, p, close);
}

// TS: async function fetchXVQD(session): Promise<{ token?: string; status?: number }>
// Returns 0 with out_token filled, or 1 with out_status set (non-2xx), or
// 2 when the x-vqd-hash-1 header is missing (TS throws).
fn fetch_xvqd(state: &UpstreamState, session_idx: u64, out_token: &ByteBuf, out_status: &u64) -> i32 {
    get_fetch(state);
    let h = HeaderList { names: [StrField { bytes: [0u8; 512], len: 0 }; 32], values: [StrField { bytes: [0u8; 512], len: 0 }; 32], len: 0 };
    base_headers(&h);
    headers_set(&h, STR_PTR("accept"), STR_LEN("accept"), STR_PTR("*/*"), STR_LEN("*/*"));
    headers_set(&h, STR_PTR("x-vqd-accept"), STR_LEN("x-vqd-accept"), STR_PTR("1"), STR_LEN("1"));
    let cookie = ByteBuf { bytes: [0u8; 40960], len: 0 };
    jar_header(&cookie, &state.sessions.sessions[session_idx].jar);
    let __ap147: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap147, cookie.bytes, 0);
    if cookie.len > 0 { headers_set(&h, STR_PTR("cookie"), STR_LEN("cookie"), __ap147, cookie.len); };
    let res: u64 = 0;
    sa_http_fetch_get(state, duck_status_url(), duck_status_url_len(), &h, &res);
    collect_cookies(state, session_idx, res);
    let status = sa_http_response_status(res);
    if status < 200 || status >= 300 {
        // Go parity: body closed unread (cancel) — release maps to it.
        sa_http_response_release(res);
        *out_status = status;
        return 1;
    };
    let hp: ptr = PTR_NULL();
    let hl: u64 = 0;
    sa_http_response_header(res, STR_PTR("x-vqd-hash-1"), STR_LEN("x-vqd-hash-1"), &hp, &hl);
    sa_http_response_release(res);
    if hl == 0 { return 2; };
    let hash = ByteBuf { bytes: [0u8; 40960], len: 0 };
    buf_append_lit(&hash, hp, hl);
    // TS: token = await generateVQDHash(hash) — a rejection
    // propagates as this fn's error. The converted call dropped the
    // err out-param AND the result; restored: failure returns 3 (the
    // fn's other failure codes are 1 = bad status, 2 = no hash).
    let herr = ByteBuf { bytes: [0u8; 40960], len: 0 };
    let __ap_hash: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap_hash, hash.bytes, 0);
    if generate_vqd_hash(out_token, &herr, __ap_hash, hash.len) != 0 { return 3; };
    return 0;
}

// TS: export interface ConversationResult { ok; status; headers; body?; errorBody?; retryAfterSec? }
struct ConversationResult {
    ok: bool,
    status: u64,
    headers: HeaderList,
    has_body: bool,
    body: u64,
    has_error_body: bool,
    error_body: ByteBuf,
    has_retry_after_sec: bool,
    retry_after_sec: u64,
}

fn conversation_result_clear(r: &ConversationResult) -> void {
    r.ok = false;
    r.status = 0;
    r.headers.len = 0;
    r.has_body = false;
    r.body = 0;
    r.has_error_body = false;
    r.error_body.len = 0;
    r.has_retry_after_sec = false;
    r.retry_after_sec = 0;
}

// TS: async function waitSlot(): Promise<void>
// DEFECT: the promise-chain mutex serializing conversations has no SLA
// counterpart; the pacing wait itself is a blocking sleep extern and the
// finally-block bookkeeping (lastConversationEnd = Date.now()) is inlined
// at the end of post_conversation.
fn wait_slot(state: &UpstreamState) -> void {
    let now = (sa_time_unix_ms() as u64);
    let wait: u64 = 0;
    if state.last_conversation_end > 0 {
        let until = state.last_conversation_end + request_interval_ms();
        if until > now { wait = until - now; };
    };
    if state.rate_limit_until > now {
        let w2 = state.rate_limit_until - now;
        if w2 > wait { wait = w2; };
    };
    if wait > 0 { sa_time_sleep_ms(wait); };
}

// TS: function cooldownResult(): ConversationResult
fn cooldown_result(out: &ConversationResult, state: &UpstreamState) -> void {
    conversation_result_clear(out);
    let remaining = state.rate_limit_until - (sa_time_unix_ms() as u64);
    // Math.ceil(delta / 1000) + 1, then Math.max(1, ...) — bound to
    // @ts_math_rounding (op 1 = ceil) / @ts_math_minmax (sa_std ts_math.sa).
    // DEFECT: the TS delta can be negative (Math.ceil of a negative);
    // the u64 delta here covers the reachable positive path only.
    let seconds = ts_math_minmax(ts_math_rounding((remaining as f64) / 1000.0, 1) + 1, 1, 1);
    out.ok = false;
    out.status = 503;
    headers_set(&out.headers, STR_PTR("content-type"), STR_LEN("content-type"), STR_PTR("application/json"), STR_LEN("application/json"));
    let sec = ByteBuf { bytes: [0u8; 40960], len: 0 };
    buf_append_u64(&sec, seconds);
    let __ap148: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap148, sec.bytes, 0);
    headers_set(&out.headers, STR_PTR("retry-after"), STR_LEN("retry-after"), __ap148, sec.len);
    headers_set(&out.headers, STR_PTR("x-upstream-status"), STR_LEN("x-upstream-status"), STR_PTR("429"), STR_LEN("429"));
    out.has_error_body = true;
    buf_reset(&out.error_body);
    buf_append_lit(&out.error_body, STR_PTR("{\"error\":\"Duck.ai conversation cooldown active\",\"retry_after\":"), STR_LEN("{\"error\":\"Duck.ai conversation cooldown active\",\"retry_after\":"));
    buf_append_u64(&out.error_body, seconds);
    buf_append_lit(&out.error_body, STR_PTR("}"), STR_LEN("}"));
    out.has_retry_after_sec = true;
    out.retry_after_sec = seconds;
}

// TS: async function postOnce(session, request, token): Promise<Response>
// Returns the response handle (0 on transport failure — TS would throw).
fn post_once(state: &UpstreamState, session_idx: u64, request: &DuckApiRequest, token_ptr: ptr, token_len: u64) -> u64 {
    get_fetch(state);
    let h = HeaderList { names: [StrField { bytes: [0u8; 512], len: 0 }; 32], values: [StrField { bytes: [0u8; 512], len: 0 }; 32], len: 0 };
    base_headers(&h);
    headers_set(&h, STR_PTR("accept"), STR_LEN("accept"), STR_PTR("text/event-stream"), STR_LEN("text/event-stream"));
    headers_set(&h, STR_PTR("priority"), STR_LEN("priority"), STR_PTR("u=1, i"), STR_LEN("u=1, i"));
    let journey = ByteBuf { bytes: [0u8; 40960], len: 0 };
    random_hex(&journey, 16);
    let __ap149: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap149, journey.bytes, 0);
    headers_set(&h, STR_PTR("x-ddg-journey-id"), STR_LEN("x-ddg-journey-id"), __ap149, journey.len);
    let signals = ByteBuf { bytes: [0u8; 40960], len: 0 };
    create_fe_signals(&signals, (sa_time_unix_ms() as u64));
    let __ap150: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap150, signals.bytes, 0);
    headers_set(&h, STR_PTR("x-fe-signals"), STR_LEN("x-fe-signals"), __ap150, signals.len);
    headers_set(&h, STR_PTR("x-vqd-hash-1"), STR_LEN("x-vqd-hash-1"), token_ptr, token_len);
    // FE version is best-effort (TS try/catch swallows the throw).
    let err = ByteBuf { bytes: [0u8; 40960], len: 0 };
    if fetch_fe_version(state, session_idx, &err) == 0 {
        let fe = state.sessions.sessions[session_idx].fe_version;
        let __ap151: ptr = PTR_NULL();
        PTR_BYTE_ADD(__ap151, fe.bytes, 0);
        if fe.len != 0 { headers_set(&h, STR_PTR("x-fe-version"), STR_LEN("x-fe-version"), __ap151, fe.len); };
    };
    let cookie = ByteBuf { bytes: [0u8; 40960], len: 0 };
    jar_header(&cookie, &state.sessions.sessions[session_idx].jar);
    let __ap152: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap152, cookie.bytes, 0);
    if cookie.len > 0 { headers_set(&h, STR_PTR("cookie"), STR_LEN("cookie"), __ap152, cookie.len); };
    // Strip local-only fields (json:"-") before sending: the wire JSON is
    // duck_api_request_to_json, which never emits toolSimulation.
    let wire = ByteBuf { bytes: [0u8; 40960], len: 0 };
    duck_api_request_to_json(&wire, request);
    let res: u64 = 0;
    let __ap_wire: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap_wire, wire.bytes, 0);
    sa_http_fetch_post(state, duck_chat_url(), duck_chat_url_len(), &h, __ap_wire, wire.len, &res);
    if res != 0 { collect_cookies(state, session_idx, res); };
    return res;
}

// TS: function rateLimited(proxyUrl, res?): ConversationResult
fn rate_limited(state: &UpstreamState, out: &ConversationResult, proxy_ptr: ptr, proxy_len: u64, res: u64) -> void {
    state.rate_limit_fails = state.rate_limit_fails + 1;
    let wait_ms = backoff_ms(state.rate_limit_fails);
    let until = (sa_time_unix_ms() as u64) + wait_ms;
    if until > state.rate_limit_until { state.rate_limit_until = until; };
    reset_session(state, proxy_ptr, proxy_len);
    // Go parity: drain the 429 body (cancel) so the connection is released.
    if res != 0 { sa_http_response_release(res); };
    // Math.max(1, Math.ceil(waitMs / 1000)) — @ts_math_rounding (ceil)
    // + @ts_math_minmax (sa_std ts_math.sa).
    let seconds = ts_math_minmax(ts_math_rounding((wait_ms as f64) / 1000.0, 1), 1, 1);
    conversation_result_clear(out);
    out.ok = false;
    out.status = 503;
    let sec = ByteBuf { bytes: [0u8; 40960], len: 0 };
    buf_append_u64(&sec, seconds);
    let __ap153: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap153, sec.bytes, 0);
    headers_set(&out.headers, STR_PTR("retry-after"), STR_LEN("retry-after"), __ap153, sec.len);
    headers_set(&out.headers, STR_PTR("x-upstream-status"), STR_LEN("x-upstream-status"), STR_PTR("429"), STR_LEN("429"));
    out.has_error_body = true;
    buf_reset(&out.error_body);
    buf_append_lit(&out.error_body, STR_PTR("{\"error\":\"upstream rate limited\",\"retry_after\":"), STR_LEN("{\"error\":\"upstream rate limited\",\"retry_after\":"));
    buf_append_u64(&out.error_body, seconds);
    buf_append_lit(&out.error_body, STR_PTR("}"), STR_LEN("}"));
    out.has_retry_after_sec = true;
    out.retry_after_sec = seconds;
}

fn status_check_failed(out: &ConversationResult, status: u64) -> void {
    conversation_result_clear(out);
    out.ok = false;
    out.status = status;
    headers_set(&out.headers, STR_PTR("content-type"), STR_LEN("content-type"), STR_PTR("application/json"), STR_LEN("application/json"));
    out.has_error_body = true;
    buf_reset(&out.error_body);
    buf_append_lit(&out.error_body, STR_PTR("{\"error\":\"Duck.ai status check failed\",\"status\":"), STR_LEN("{\"error\":\"Duck.ai status check failed\",\"status\":"));
    buf_append_u64(&out.error_body, status);
    buf_append_lit(&out.error_body, STR_PTR("}"), STR_LEN("}"));
}

fn ok_result(out: &ConversationResult, state: &UpstreamState, res: u64) -> void {
    state.rate_limit_fails = 0;
    state.rate_limit_until = 0;
    conversation_result_clear(out);
    out.ok = true;
    out.status = sa_http_response_status(res);
    out.has_body = true;
    out.body = res;
}

// TS: export async function postConversation(request, explicitToken, proxyUrl)
// request is mutated in place on retries (fresh durableStream UUIDs),
// mirroring the TS object mutation.
fn post_conversation(state: &UpstreamState, out: &ConversationResult, request: &DuckApiRequest, explicit_token_ptr: ptr, explicit_token_len: u64, proxy_ptr: ptr, proxy_len: u64) -> void {
    let session_idx = session_for(state, proxy_ptr, proxy_len);
    wait_slot(state);
    // try { ... } finally { lastConversationEnd = Date.now(); } — the
    // finally bookkeeping is applied at every return via finish().
    if explicit_token_len == 0 && state.rate_limit_until > (sa_time_unix_ms() as u64) {
        cooldown_result(out, state);
        state.last_conversation_end = (sa_time_unix_ms() as u64);
        return;
    };
    let token = ByteBuf { bytes: [0u8; 40960], len: 0 };
    buf_append_lit(&token, explicit_token_ptr, explicit_token_len);
    if token.len == 0 {
        let st: u64 = 0;
        let rc = fetch_xvqd(state, session_idx, &token, &st);
        if rc == 1 {
            if st == 429 {
                rate_limited(state, out, proxy_ptr, proxy_len, 0);
            } else {
                status_check_failed(out, st);
            };
            state.last_conversation_end = (sa_time_unix_ms() as u64);
            return;
        };
        if rc == 2 {
            // TS: throw new Error("no x-vqd-hash-1 token") — propagates to
            // the caller; represented as status 0 with the message body.
            conversation_result_clear(out);
            out.has_error_body = true;
            buf_append_lit(&out.error_body, STR_PTR("no x-vqd-hash-1 token"), STR_LEN("no x-vqd-hash-1 token"));
            state.last_conversation_end = (sa_time_unix_ms() as u64);
            return;
        };
    };
    let __ap154: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap154, token.bytes, 0);
    let res = post_once(state, session_idx, request, __ap154, token.len);
    if res != 0 && sa_http_response_status(res) == 429 {
        rate_limited(state, out, proxy_ptr, proxy_len, res);
        state.last_conversation_end = (sa_time_unix_ms() as u64);
        return;
    };
    if res != 0 && sa_http_response_status(res) >= 200 && sa_http_response_status(res) < 300 {
        ok_result(out, state, res);
        state.last_conversation_end = (sa_time_unix_ms() as u64);
        return;
    };
    if res != 0 && sa_http_response_status(res) == 400 {
        // Intermittent ERR_BAD_REQUEST: retry once with a fresh
        // session/VQD/UUIDs, no challenge backoff sleep.
        sa_http_response_release(res);
        res = 0;
        reset_session(state, proxy_ptr, proxy_len);
        let retry_idx = session_for(state, proxy_ptr, proxy_len);
        let uuid_ha = sa_deno_random_uuid();
        let uuid_pa: ptr = sa_fmt_buffer_data(uuid_ha);
        str_field_set(&request.durable_message_id, uuid_pa, sa_fmt_buffer_len(uuid_ha));
        sa_fmt_buffer_free(uuid_ha);
        let uuid_hb = sa_deno_random_uuid();
        let uuid_pb: ptr = sa_fmt_buffer_data(uuid_hb);
        str_field_set(&request.durable_conversation_id, uuid_pb, sa_fmt_buffer_len(uuid_hb));
        sa_fmt_buffer_free(uuid_hb);
        let retry_token = ByteBuf { bytes: [0u8; 40960], len: 0 };
        let rst: u64 = 0;
        let rrc = fetch_xvqd(state, retry_idx, &retry_token, &rst);
        if rrc == 1 {
            if rst == 429 {
                rate_limited(state, out, proxy_ptr, proxy_len, 0);
            } else {
                status_check_failed(out, rst);
            };
            state.last_conversation_end = (sa_time_unix_ms() as u64);
            return;
        };
        let __ap155: ptr = PTR_NULL();
        PTR_BYTE_ADD(__ap155, retry_token.bytes, 0);
        res = post_once(state, retry_idx, request, __ap155, retry_token.len);
        if res != 0 && sa_http_response_status(res) == 429 {
            rate_limited(state, out, proxy_ptr, proxy_len, res);
            state.last_conversation_end = (sa_time_unix_ms() as u64);
            return;
        };
        if res != 0 && sa_http_response_status(res) >= 200 && sa_http_response_status(res) < 300 {
            ok_result(out, state, res);
            state.last_conversation_end = (sa_time_unix_ms() as u64);
            return;
        };
    };
    if res == 0 || sa_http_response_status(res) != 418 {
        conversation_result_clear(out);
        out.ok = false;
        if res != 0 {
            out.status = sa_http_response_status(res);
            out.has_error_body = true;
            sa_http_response_text(res, &out.error_body);
            sa_http_response_release(res);
        };
        state.last_conversation_end = (sa_time_unix_ms() as u64);
        return;
    };
    // 418 challenge retries (bounded to CHALLENGE_RETRIES=1): fresh
    // session/VQD/UUIDs each round.
    let attempt: u64 = 0;
    while attempt < challenge_retries() {
        attempt = attempt + 1;
        // first body is read and discarded in TS (void firstBody)
        let sink = ByteBuf { bytes: [0u8; 40960], len: 0 };
        sa_http_response_text(res, &sink);
        sa_http_response_release(res);
        res = 0;
        sa_time_sleep_ms(backoff_ms(1));
        reset_session(state, proxy_ptr, proxy_len);
        let retry_idx = session_for(state, proxy_ptr, proxy_len);
        let uuid_ha = sa_deno_random_uuid();
        let uuid_pa: ptr = sa_fmt_buffer_data(uuid_ha);
        str_field_set(&request.durable_message_id, uuid_pa, sa_fmt_buffer_len(uuid_ha));
        sa_fmt_buffer_free(uuid_ha);
        let uuid_hb = sa_deno_random_uuid();
        let uuid_pb: ptr = sa_fmt_buffer_data(uuid_hb);
        str_field_set(&request.durable_conversation_id, uuid_pb, sa_fmt_buffer_len(uuid_hb));
        sa_fmt_buffer_free(uuid_hb);
        let fresh = ByteBuf { bytes: [0u8; 40960], len: 0 };
        let fst: u64 = 0;
        let frc = fetch_xvqd(state, retry_idx, &fresh, &fst);
        if frc == 1 {
            if fst == 429 {
                rate_limited(state, out, proxy_ptr, proxy_len, 0);
            } else {
                status_check_failed(out, fst);
            };
            state.last_conversation_end = (sa_time_unix_ms() as u64);
            return;
        };
        let __ap156: ptr = PTR_NULL();
        PTR_BYTE_ADD(__ap156, fresh.bytes, 0);
        res = post_once(state, retry_idx, request, __ap156, fresh.len);
        if res != 0 && sa_http_response_status(res) == 429 {
            rate_limited(state, out, proxy_ptr, proxy_len, res);
            state.last_conversation_end = (sa_time_unix_ms() as u64);
            return;
        };
        if res != 0 && sa_http_response_status(res) >= 200 && sa_http_response_status(res) < 300 {
            ok_result(out, state, res);
            state.last_conversation_end = (sa_time_unix_ms() as u64);
            return;
        };
        conversation_result_clear(out);
        out.ok = false;
        out.has_error_body = true;
        if res != 0 {
            if sa_http_response_status(res) == 418 {
                out.status = 502;
            } else {
                out.status = sa_http_response_status(res);
            };
            sa_http_response_text(res, &out.error_body);
            sa_http_response_release(res);
            res = 0;
        } else {
            out.status = 502;
        };
        state.last_conversation_end = (sa_time_unix_ms() as u64);
        return;
    }
    // Retry budget exhausted (unreachable with CHALLENGE_RETRIES=1 because
    // the loop body always returns; kept for the TS control-flow shape).
    conversation_result_clear(out);
    out.ok = false;
    out.status = 502;
    out.has_error_body = true;
    if res != 0 {
        sa_http_response_text(res, &out.error_body);
        sa_http_response_release(res);
    };
    state.last_conversation_end = (sa_time_unix_ms() as u64);
}
