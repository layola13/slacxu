{
  "name": "@codex-ui/duck2api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit --noUnusedLocals --noUnusedParameters --noFallthroughCasesInSwitch --noImplicitReturns && bun build src/index.ts --outdir dist --target bun",
    "typecheck": "tsc -p tsconfig.json --noEmit --noUnusedLocals --noUnusedParameters --noFallthroughCasesInSwitch --noImplicitReturns",
    "test": "bun test test/",
    "start": "bun dist/index.js"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "fetch-impersonate": "^0.1.0-alpha.2",
    "hono": "^4.7.0",
    "js-tiktoken": "^1.0.21",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  }
}
