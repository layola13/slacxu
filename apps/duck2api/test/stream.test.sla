// Converted 1:1 from apps/duck2api/test/stream.test.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "sa_std/ptr.sa"
@import "sa_std/string.sa"
@import "sa_std/ts_string.sa"
@import "../src/duckgo/stream.sla"

// DEFECT: bun:test has no SLA counterpart (see convert.test.sla header).
// The TS fakeUpstream ReadableStream and the write callback are test
// doubles: here the body is fabricated by the intent test extern
// sa_body_from_text and written lines are collected by the intent test
// sink (sa_test_sink_*). Neither exists in sa_std yet.
// DEFECT: the TS tests inject countTokens: (s) => s.length via
// ConsumeOptions; stream.sla collapsed that callback to the concrete
// count_token (BPE), so the two outputTokens === 11 expectations below
// encode the INJECTED counter's value and cannot pass until the fix
// phase re-parameterizes the counter. They are kept verbatim.

fn expect_true(fails: &u64, cond: bool) -> void { if !cond { *fails = *fails + 1; }; }
fn expect_u64_eq(fails: &u64, a: u64, b: u64) -> void { if a != b { *fails = *fails + 1; }; }
fn expect_str_eq(fails: &u64, ap: ptr, al: u64, bp: ptr, bl: u64) -> void {
    if ts_str_equals(ap, al, bp, bl) != 1 { *fails = *fails + 1; };
}

// fakeUpstream(events): body text = events.map(e => `data: ${e}\n\n`).join("")
fn fake_body(events: ptr, events_len: u64) -> u64 {
    // events arrives as one pre-joined payload text for simplicity of the
    // mirror: each caller passes the exact payload bytes.
    return sa_body_from_text(events, events_len);
}

fn payload_of(events: &ByteBuf, ev_ptr: ptr, ev_len: u64) -> void {
    buf_append_lit(events, STR_PTR("data: "), STR_LEN("data: "));
    buf_append_lit(events, ev_ptr, ev_len);
    buf_append_lit(events, STR_PTR("\n\n"), STR_LEN("\n\n"));
}

fn make_opts(body: u64, stream: bool, prompt_tokens: u64, sink: u64) -> ConsumeOptions {
    let opts = ConsumeOptions { has_body: true, body: body, request_model: StrField { bytes: [0u8; 512], len: 0 }, reasoning_effort: StrField { bytes: [0u8; 512], len: 0 }, tool_simulation: false, stream: stream, stats: StreamStats { start: 0, prompt_tokens: prompt_tokens, cached_tokens: 0, effort: StrField { bytes: [0u8; 512], len: 0 } }, sink: sink };
    str_field_set(&opts.request_model, STR_PTR("m"), STR_LEN("m"));
    str_field_set(&opts.reasoning_effort, STR_PTR("low"), STR_LEN("low"));
    opts.stats.start = sa_time_now_ms();
    str_field_set(&opts.stats.effort, STR_PTR("low"), STR_LEN("low"));
    return opts;
}

fn blank_result() -> StreamResult {
    return StreamResult { text: ByteBuf { bytes: [0u8; 40960], len: 0 }, output_tokens: 0, ttft_ms: 0, total_ms: 0, tool_calls: ToolCallList { calls: [ToolCall { has_index: false, index: 0, id: [0u8; 128], id_len: 0, typ: [0u8; 32], typ_len: 0, fn_name: [0u8; 128], fn_name_len: 0, fn_arguments: [0u8; 4096], fn_arguments_len: 0 }; 64], len: 0 } };
}

// parse one sink line ("data: <json>\n\n") into a JSON node
fn line_json(sink: u64, idx: u64) -> u64 {
    let lp: ptr = PTR_NULL();
    let ll: u64 = 0;
    sa_test_sink_line(sink, idx, &lp, &ll);
    if ll < 8 { return 0; };
    let jp: ptr = PTR_NULL();
    PTR_BYTE_ADD(jp, lp, 6);
    let node: u64 = 0;
    sa_json_parse(jp, ll - 8, &node);
    return node;
}

fn obj_str(node: u64, key_ptr: ptr, key_len: u64, out_ptr: &ptr, out_len: &u64) -> bool {
    return sa_json_object_get_string(node, key_ptr, key_len, out_ptr, out_len) == 0;
}

fn choice0(node: u64) -> u64 {
    let choices: u64 = 0;
    sa_json_object_get(node, STR_PTR("choices"), STR_LEN("choices"), &choices);
    let c0: u64 = 0;
    if choices != 0 { sa_json_array_get(choices, 0, &c0); };
    return c0;
}

fn delta_str(node: u64, key_ptr: ptr, key_len: u64, out_ptr: &ptr, out_len: &u64) -> bool {
    let c0 = choice0(node);
    if c0 == 0 { return false; };
    let delta: u64 = 0;
    sa_json_object_get(c0, STR_PTR("delta"), STR_LEN("delta"), &delta);
    if delta == 0 { return false; };
    return sa_json_object_get_string(delta, key_ptr, key_len, out_ptr, out_len) == 0;
}

fn ev1() -> ptr { return STR_PTR("{\"action\":\"success\",\"message\":\"Hello\",\"model\":\"gpt-4o-mini\"}"); }
fn ev1_len() -> u64 { return STR_LEN("{\"action\":\"success\",\"message\":\"Hello\",\"model\":\"gpt-4o-mini\"}"); }
fn ev2() -> ptr { return STR_PTR("{\"action\":\"success\",\"message\":\" world\",\"model\":\"gpt-4o-mini\"}"); }
fn ev2_len() -> u64 { return STR_LEN("{\"action\":\"success\",\"message\":\" world\",\"model\":\"gpt-4o-mini\"}"); }

// describe("consumeUpstream")

fn test_non_stream_accumulates(fails: &u64) -> void {
    let payload = ByteBuf { bytes: [0u8; 40960], len: 0 };
    payload_of(&payload, ev1(), ev1_len());
    payload_of(&payload, ev2(), ev2_len());
    let sink = sa_test_sink_new();
    let opts = make_opts(fake_body(&payload.bytes, payload.len), false, 10, sink);
    let r = blank_result();
    expect_u64_eq(fails, consume_upstream(&opts, &r), 0);
    expect_str_eq(fails, &r.text.bytes, r.text.len, STR_PTR("Hello world"), STR_LEN("Hello world"));
    expect_u64_eq(fails, sa_test_sink_line_count(sink), 0);
    // DEFECT: 11 is the injected length-counter value (see header).
    expect_u64_eq(fails, r.output_tokens, 11);
}

fn test_stream_emits_chunks(fails: &u64) -> void {
    let payload = ByteBuf { bytes: [0u8; 40960], len: 0 };
    payload_of(&payload, ev1(), ev1_len());
    payload_of(&payload, ev2(), ev2_len());
    let sink = sa_test_sink_new();
    let opts = make_opts(fake_body(&payload.bytes, payload.len), true, 10, sink);
    let r = blank_result();
    expect_u64_eq(fails, consume_upstream(&opts, &r), 0);
    expect_str_eq(fails, &r.text.bytes, r.text.len, STR_PTR("Hello world"), STR_LEN("Hello world"));
    expect_u64_eq(fails, sa_test_sink_line_count(sink), 4);
    let p: ptr = PTR_NULL();
    let l: u64 = 0;
    let n0 = line_json(sink, 0);
    expect_true(fails, delta_str(n0, STR_PTR("content"), STR_LEN("content"), &p, &l));
    expect_str_eq(fails, p, l, STR_PTR("Hello"), STR_LEN("Hello"));
    let n1 = line_json(sink, 1);
    expect_true(fails, delta_str(n1, STR_PTR("content"), STR_LEN("content"), &p, &l));
    expect_str_eq(fails, p, l, STR_PTR(" world"), STR_LEN(" world"));
    let n2 = line_json(sink, 2);
    let c2 = choice0(n2);
    expect_true(fails, obj_str(c2, STR_PTR("finish_reason"), STR_LEN("finish_reason"), &p, &l));
    expect_str_eq(fails, p, l, STR_PTR("stop"), STR_LEN("stop"));
    let n3 = line_json(sink, 3);
    let usage: u64 = 0;
    sa_json_object_get(n3, STR_PTR("usage"), STR_LEN("usage"), &usage);
    expect_true(fails, sa_json_object_get_number(usage, STR_PTR("prompt_tokens"), STR_LEN("prompt_tokens")) == 10.0);
    // DEFECT: completion_tokens 11 is the injected counter value (header).
    expect_true(fails, sa_json_object_get_number(usage, STR_PTR("completion_tokens"), STR_LEN("completion_tokens")) == 11.0);
    // every chunk id === CHATCMPL_ID
    for i in 0..4 {
        let n = line_json(sink, i);
        expect_true(fails, obj_str(n, STR_PTR("id"), STR_LEN("id"), &p, &l));
        expect_str_eq(fails, p, l, chatcmpl_id(), STR_LEN("chatcmpl-QXlha2FBbmROaXhpZUFyZUF3ZXNvbWUK"));
    }
}

fn test_reasoning_passthrough_skips(fails: &u64) -> void {
    let payload = ByteBuf { bytes: [0u8; 40960], len: 0 };
    payload_of(&payload, STR_PTR("{\"action\":\"success\",\"role\":\"reasoning\",\"text\":\"thinking\",\"model\":\"m\"}"), STR_LEN("{\"action\":\"success\",\"role\":\"reasoning\",\"text\":\"thinking\",\"model\":\"m\"}"));
    payload_of(&payload, STR_PTR("[DONE]"), STR_LEN("[DONE]"));
    payload_of(&payload, STR_PTR("x"), STR_LEN("x"));
    let sink = sa_test_sink_new();
    let opts = make_opts(fake_body(&payload.bytes, payload.len), true, 10, sink);
    let r = blank_result();
    expect_u64_eq(fails, consume_upstream(&opts, &r), 0);
    let n0 = line_json(sink, 0);
    let p: ptr = PTR_NULL();
    let l: u64 = 0;
    expect_true(fails, delta_str(n0, STR_PTR("reasoning_content"), STR_LEN("reasoning_content"), &p, &l));
    expect_str_eq(fails, p, l, STR_PTR("thinking"), STR_LEN("thinking"));
    expect_u64_eq(fails, r.text.len, 0);
}

fn test_non_success_aborts(fails: &u64) -> void {
    let payload = ByteBuf { bytes: [0u8; 40960], len: 0 };
    payload_of(&payload, STR_PTR("{\"action\":\"error\",\"message\":\"nope\"}"), STR_LEN("{\"action\":\"error\",\"message\":\"nope\"}"));
    let sink = sa_test_sink_new();
    let opts = make_opts(fake_body(&payload.bytes, payload.len), false, 10, sink);
    let r = blank_result();
    // TS: expect(r).toBeNull()
    expect_u64_eq(fails, consume_upstream(&opts, &r), 1);
}

fn search_events(payload: &ByteBuf, with_result: bool) -> void {
    buf_append_lit(payload, STR_PTR("data: {\"action\":\"success\",\"role\":\"tool-invocation\",\"state\":\"call\",\"toolName\":\"WebSearch\",\"toolCallId\":\"call-search-1\",\"toolArguments\":\"{\\\"query\\\":\\\"广州天气\\\"}\"}\n\n"), STR_LEN("data: {\"action\":\"success\",\"role\":\"tool-invocation\",\"state\":\"call\",\"toolName\":\"WebSearch\",\"toolCallId\":\"call-search-1\",\"toolArguments\":\"{\\\"query\\\":\\\"广州天气\\\"}\"}\n\n"));
    if with_result {
        buf_append_lit(payload, STR_PTR("data: {\"action\":\"success\",\"role\":\"tool-invocation\",\"state\":\"result\",\"toolCallId\":\"call-search-1\",\"result\":\"search complete\"}\n\n"), STR_LEN("data: {\"action\":\"success\",\"role\":\"tool-invocation\",\"state\":\"result\",\"toolCallId\":\"call-search-1\",\"result\":\"search complete\"}\n\n"));
    };
    buf_append_lit(payload, STR_PTR("data: {\"action\":\"success\",\"message\":\"广州今日晴\",\"model\":\"m\"}\n\n"), STR_LEN("data: {\"action\":\"success\",\"message\":\"广州今日晴\",\"model\":\"m\"}\n\n"));
}

fn test_search_waterfall_non_stream(fails: &u64) -> void {
    let payload = ByteBuf { bytes: [0u8; 40960], len: 0 };
    search_events(&payload, true);
    let sink = sa_test_sink_new();
    let opts = make_opts(fake_body(&payload.bytes, payload.len), false, 10, sink);
    let r = blank_result();
    expect_u64_eq(fails, consume_upstream(&opts, &r), 0);
    expect_str_eq(fails, &r.text.bytes, r.text.len, STR_PTR("广州今日晴"), STR_LEN("广州今日晴"));
    expect_u64_eq(fails, r.tool_calls.len, 1);
    expect_str_eq(fails, r.tool_calls.calls[0].fn_name, r.tool_calls.calls[0].fn_name_len, STR_PTR("web_search"), STR_LEN("web_search"));
    expect_str_eq(fails, r.tool_calls.calls[0].id, r.tool_calls.calls[0].id_len, STR_PTR("call-search-1"), STR_LEN("call-search-1"));
}

fn test_search_waterfall_stream(fails: &u64) -> void {
    let payload = ByteBuf { bytes: [0u8; 40960], len: 0 };
    search_events(&payload, false);
    let sink = sa_test_sink_new();
    let opts = make_opts(fake_body(&payload.bytes, payload.len), true, 10, sink);
    let r = blank_result();
    expect_u64_eq(fails, consume_upstream(&opts, &r), 0);
    expect_u64_eq(fails, r.tool_calls.len, 1);
    let count = sa_test_sink_line_count(sink);
    expect_true(fails, count >= 4);
    let p: ptr = PTR_NULL();
    let l: u64 = 0;
    // tool_call chunk (chatcmpl-playgame id) precedes the answer chunk
    let n0 = line_json(sink, 0);
    expect_true(fails, obj_str(n0, STR_PTR("id"), STR_LEN("id"), &p, &l));
    expect_str_eq(fails, p, l, STR_PTR("chatcmpl-playgame"), STR_LEN("chatcmpl-playgame"));
    let c0 = choice0(n0);
    let delta: u64 = 0;
    sa_json_object_get(c0, STR_PTR("delta"), STR_LEN("delta"), &delta);
    let tcs: u64 = 0;
    sa_json_object_get(delta, STR_PTR("tool_calls"), STR_LEN("tool_calls"), &tcs);
    let tc0: u64 = 0;
    sa_json_array_get(tcs, 0, &tc0);
    let fn_node: u64 = 0;
    sa_json_object_get(tc0, STR_PTR("function"), STR_LEN("function"), &fn_node);
    expect_true(fails, obj_str(fn_node, STR_PTR("name"), STR_LEN("name"), &p, &l));
    expect_str_eq(fails, p, l, STR_PTR("web_search"), STR_LEN("web_search"));
    let n1 = line_json(sink, 1);
    expect_true(fails, delta_str(n1, STR_PTR("content"), STR_LEN("content"), &p, &l));
    expect_str_eq(fails, p, l, STR_PTR("广州今日晴"), STR_LEN("广州今日晴"));
    // second-to-last chunk has finish_reason "tool_calls"
    let nlast = line_json(sink, count - 2);
    let clast = choice0(nlast);
    expect_true(fails, obj_str(clast, STR_PTR("finish_reason"), STR_LEN("finish_reason"), &p, &l));
    expect_str_eq(fails, p, l, STR_PTR("tool_calls"), STR_LEN("tool_calls"));
}

fn run_all_tests() -> u64 {
    let fails: u64 = 0;
    test_non_stream_accumulates(&fails);
    test_stream_emits_chunks(&fails);
    test_reasoning_passthrough_skips(&fails);
    test_non_success_aborts(&fails);
    test_search_waterfall_non_stream(&fails);
    test_search_waterfall_stream(&fails);
    return fails;
}
