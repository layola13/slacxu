// Converted 1:1 from apps/duck2api/test/upstream-retry.test.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "sa_std/ptr.sa"
@import "sa_std/string.sa"
@import "sa_std/ts_string.sa"
@import "../src/duckgo/upstream.sla"

// DEFECT: bun:test has no SLA counterpart (see convert.test.sla header).
// The TS test stubs globalThis.fetch (with process.env DUCK_FETCH=native
// set at module scope). sa_std has no fetch-stub surface: the stub is a
// family of intent test externs (sa_test_fetch_stub_*) installed at the
// sa_http_fetch_* layer — status endpoint always answers 200 with the
// CHALLENGE x-vqd-hash-1 header, the chat endpoint follows the installed
// script, every other URL returns a 200 HTML page, mirroring the TS stub
// branch-for-branch. TS afterEach restores globalThis.fetch; here each
// test installs a fresh stub + a fresh UpstreamState (module state in TS
// is process-global, which is also why the TS tests carry 60s timeouts
// for the 10s waitSlot pacing; the fresh state here starts unpaced —
// logged divergence, see defect log).

fn expect_true(fails: &u64, cond: bool) -> void { if !cond { let __sp17 = *fails; *fails = __sp17 + 1; }; }
fn expect_u64_eq(fails: &u64, a: u64, b: u64) -> void { if a != b { let __sp18 = *fails; *fails = __sp18 + 1; }; }
fn expect_str_eq(fails: &u64, ap: ptr, al: u64, bp: ptr, bl: u64) -> void {
    if ts_str_equals(ap, al, bp, bl) != 1 { let __sp19 = *fails; *fails = __sp19 + 1; };
}

// const CHALLENGE = base64('({"client_hashes":["test"]})')
fn challenge_b64(out: &ByteBuf) -> void {
    buf_reset(out);
    sa_base64_encode(STR_PTR("({\"client_hashes\":[\"test\"]})"), STR_LEN("({\"client_hashes\":[\"test\"]})"), out);
}

// function duckReq(): DuckApiRequest (literal from the TS test)
fn duck_req() -> DuckApiRequest {
    let req = DuckApiRequest { model: StrField { bytes: [0u8; 512], len: 0 }, has_tool_choice: false, tool_choice_web_search: false, tool_choice_generate_image: false, messages: [DuckMessage { role: StrField { bytes: [0u8; 512], len: 0 }, content_is_parts: false, content_text: StrField { bytes: [0u8; 512], len: 0 }, parts: PartsList { parts: [DuckContentPart { typ: StrField { bytes: [0u8; 512], len: 0 }, has_text: false, text: StrField { bytes: [0u8; 512], len: 0 }, has_image: false, image: StrField { bytes: [0u8; 512], len: 0 }, has_mime_type: false, mime_type: StrField { bytes: [0u8; 512], len: 0 }, has_filename: false, filename: StrField { bytes: [0u8; 512], len: 0 } }; 64], len: 0 } }; 128], messages_len: 0, can_use_tools: true, reasoning_effort: StrField { bytes: [0u8; 512], len: 0 }, has_can_use_approx_location: false, can_use_approx_location: false, has_can_delegate_image_generation: false, can_delegate_image_generation: false, can_show_greeting: true, durable_message_id: StrField { bytes: [0u8; 512], len: 0 }, durable_conversation_id: StrField { bytes: [0u8; 512], len: 0 }, durable_public_key_json: ByteBuf { bytes: [0u8; 40960], len: 0 }, has_tool_simulation: false, tool_simulation: false };
    str_field_set(&req.model, STR_PTR("gpt-6-luna"), STR_LEN("gpt-6-luna"));
    str_field_set(&req.reasoning_effort, STR_PTR("low"), STR_LEN("low"));
    req.messages_len = 1;
    str_field_set(&req.messages[0].role, STR_PTR("user"), STR_LEN("user"));
    req.messages[0].content_is_parts = true;
    req.messages[0].parts.len = 1;
    str_field_set(&req.messages[0].parts.parts[0].typ, STR_PTR("text"), STR_LEN("text"));
    req.messages[0].parts.parts[0].has_text = true;
    str_field_set(&req.messages[0].parts.parts[0].text, STR_PTR("hi"), STR_LEN("hi"));
    str_field_set(&req.durable_message_id, STR_PTR("m0"), STR_LEN("m0"));
    str_field_set(&req.durable_conversation_id, STR_PTR("c0"), STR_LEN("c0"));
    buf_append_lit(&req.durable_public_key_json, STR_PTR("{\"alg\":\"RSA-OAEP-256\",\"e\":\"AQAB\",\"ext\":true,\"key_ops\":[\"encrypt\"],\"kty\":\"RSA\",\"n\":\"test\",\"use\":\"enc\"}"), STR_LEN("{\"alg\":\"RSA-OAEP-256\",\"e\":\"AQAB\",\"ext\":true,\"key_ops\":[\"encrypt\"],\"kty\":\"RSA\",\"n\":\"test\",\"use\":\"enc\"}"));
    return req;
}

fn blank_state() -> UpstreamState {
    return UpstreamState { fetch_ready: false, fetch_degraded: false, sessions: SessionTable { keys: [StrField { bytes: [0u8; 512], len: 0 }; 32], sessions: [DuckSession { jar: CookieJar { names: [StrField { bytes: [0u8; 512], len: 0 }; 64], values: [StrField { bytes: [0u8; 512], len: 0 }; 64], len: 0 }, vqd: StrField { bytes: [0u8; 512], len: 0 }, fe_version: StrField { bytes: [0u8; 512], len: 0 }, fe_expire_at: 0 }; 32], len: 0 }, last_conversation_end: 0, rate_limit_until: 0, rate_limit_fails: 0 };
}

fn blank_result() -> ConversationResult {
    return ConversationResult { ok: false, status: 0, headers: HeaderList { names: [StrField { bytes: [0u8; 512], len: 0 }; 32], values: [StrField { bytes: [0u8; 512], len: 0 }; 32], len: 0 }, has_body: false, body: 0, has_error_body: false, error_body: ByteBuf { bytes: [0u8; 40960], len: 0 }, has_retry_after_sec: false, retry_after_sec: 0 };
}

// durableStream field of a captured chat body (JSON.parse(body).durableStream.<field>)
fn body_durable_field(body_idx: u64, key_ptr: ptr, key_len: u64, out: &ByteBuf) -> void {
    let bp: ptr = PTR_NULL();
    let bl: u64 = 0;
    sa_test_fetch_stub_chat_body(body_idx, &bp, &bl);
    let node: u64 = 0;
    buf_reset(out);
    if sa_json_parse(bp, bl, &node) != 0 || node == 0 { return; };
    let ds: u64 = 0;
    sa_json_object_get(node, STR_PTR("durableStream"), STR_LEN("durableStream"), &ds);
    let vp: ptr = PTR_NULL();
    let vl: u64 = 0;
    sa_json_object_get_string(ds, key_ptr, key_len, &vp, &vl);
    buf_append_lit(out, vp, vl);
}

// describe("postConversation transient-400 retry")

fn test_400_then_200_recovers(fails: &u64) -> void {
    // process.env["DUCK_FETCH"] = "native" (module scope in TS)
    sa_env_set(STR_PTR("DUCK_FETCH"), STR_LEN("DUCK_FETCH"), STR_PTR("native"), STR_LEN("native"));
    let challenge = ByteBuf { bytes: [0u8; 40960], len: 0 };
    challenge_b64(&challenge);
    // stub: call 1 -> 400 ERR_BAD_REQUEST, later calls -> 200 "data: done"
    sa_test_fetch_stub_install(&challenge.bytes, challenge.len, 1);
    let state = blank_state();
    reset_session(&state, STR_PTR("retry-ok"), STR_LEN("retry-ok"));
    let req = duck_req();
    let res = blank_result();
    post_conversation(&state, &res, &req, STR_PTR(""), 0, STR_PTR("retry-ok"), STR_LEN("retry-ok"));
    expect_true(fails, res.ok);
    expect_u64_eq(fails, res.status, 200);
    expect_u64_eq(fails, sa_test_fetch_stub_chat_count(), 2);
    // fresh UUIDs on the retry: both durable ids differ between bodies
    let first_conv = ByteBuf { bytes: [0u8; 40960], len: 0 };
    let second_conv = ByteBuf { bytes: [0u8; 40960], len: 0 };
    body_durable_field(0, STR_PTR("conversationId"), STR_LEN("conversationId"), &first_conv);
    body_durable_field(1, STR_PTR("conversationId"), STR_LEN("conversationId"), &second_conv);
    let __ap251: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap251, first_conv.bytes, 0);
    let __ap250: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap250, second_conv.bytes, 0);
    expect_true(fails, !(first_conv.len == second_conv.len && bytes_eq3(__ap251, __ap250, first_conv.len)));
    let first_msg = ByteBuf { bytes: [0u8; 40960], len: 0 };
    let second_msg = ByteBuf { bytes: [0u8; 40960], len: 0 };
    body_durable_field(0, STR_PTR("messageId"), STR_LEN("messageId"), &first_msg);
    body_durable_field(1, STR_PTR("messageId"), STR_LEN("messageId"), &second_msg);
    let __ap253: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap253, first_msg.bytes, 0);
    let __ap252: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap252, second_msg.bytes, 0);
    expect_true(fails, !(first_msg.len == second_msg.len && bytes_eq3(__ap253, __ap252, first_msg.len)));
    // await res.body?.cancel() — release the ok body
    if res.has_body { sa_http_response_release(res.body); };
}

fn test_persistent_400_surfaces(fails: &u64) -> void {
    sa_env_set(STR_PTR("DUCK_FETCH"), STR_LEN("DUCK_FETCH"), STR_PTR("native"), STR_LEN("native"));
    let challenge = ByteBuf { bytes: [0u8; 40960], len: 0 };
    challenge_b64(&challenge);
    // stub: every chat call -> 400 ERR_BAD_REQUEST (script mode 2)
    sa_test_fetch_stub_install(&challenge.bytes, challenge.len, 2);
    let state = blank_state();
    reset_session(&state, STR_PTR("retry-fail"), STR_LEN("retry-fail"));
    let req = duck_req();
    let res = blank_result();
    post_conversation(&state, &res, &req, STR_PTR(""), 0, STR_PTR("retry-fail"), STR_LEN("retry-fail"));
    expect_true(fails, !res.ok);
    expect_u64_eq(fails, res.status, 400);
    expect_u64_eq(fails, sa_test_fetch_stub_chat_count(), 2);
    // res.errorBody toContain "ERR_BAD_REQUEST" — String.includes bound
    // to sa_string_index_of (sa_std string.sai).
    expect_true(fails, res.has_error_body && sa_string_index_of(&res.error_body.bytes, res.error_body.len, STR_PTR("ERR_BAD_REQUEST"), STR_LEN("ERR_BAD_REQUEST")) >= 0);
}

fn run_all_tests() -> u64 {
    let fails: u64 = 0;
    test_400_then_200_recovers(&fails);
    test_persistent_400_surfaces(&fails);
    return fails;
}
