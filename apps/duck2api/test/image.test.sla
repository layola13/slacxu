// Converted 1:1 from apps/duck2api/test/image.test.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "sa_std/ptr.sa"
@import "sa_std/string.sa"
@import "sa_std/ts_string.sa"
@import "../src/duckgo/image.sla"

// DEFECT: bun:test has no SLA counterpart (see convert.test.sla header).
// ExtractedImage equality (toEqual on {b64, format, width?, height?}) is
// checked field-by-field; b64 lives in the result arena (b64_off/b64_len).

fn expect_true(fails: &u64, cond: bool) -> void { if !cond { let __sp7 = *fails; *fails = __sp7 + 1; }; }
fn expect_u64_eq(fails: &u64, a: u64, b: u64) -> void { if a != b { let __sp8 = *fails; *fails = __sp8 + 1; }; }
fn expect_str_eq(fails: &u64, ap: ptr, al: u64, bp: ptr, bl: u64) -> void {
    if ts_str_equals(ap, al, bp, bl) != 1 { let __sp9 = *fails; *fails = __sp9 + 1; };
}

fn blank_result() -> ImageStreamResult {
    return ImageStreamResult { text: ByteBuf { bytes: [0u8; 40960], len: 0 }, arena: ByteBuf { bytes: [0u8; 40960], len: 0 }, images: [ExtractedImage { b64_off: 0, b64_len: 0, has_format: false, format: [0u8; 32], format_len: 0, has_width: false, width: 0, has_height: false, height: 0 }; 32], images_len: 0 };
}

fn expect_image(fails: &u64, r: &ImageStreamResult, idx: u64, b64_ptr: ptr, b64_len: u64, fmt_ptr: ptr, fmt_len: u64, has_w: bool, w: u64, has_h: bool, h: u64) -> void {
    let img = r.images[idx];
    let bp: ptr = PTR_NULL();
    PTR_BYTE_ADD(bp, r.arena.bytes, img.b64_off);
    expect_str_eq(fails, bp, img.b64_len, b64_ptr, b64_len);
    expect_true(fails, img.has_format);
    let __ap210: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap210, img.format, 0);
    expect_str_eq(fails, __ap210, img.format_len, fmt_ptr, fmt_len);
    expect_true(fails, img.has_width == has_w);
    if has_w { expect_u64_eq(fails, img.width, w); };
    expect_true(fails, img.has_height == has_h);
    if has_h { expect_u64_eq(fails, img.height, h); };
}

fn ui_component() -> ptr { return STR_PTR("{\"action\":\"success\",\"toolName\":\"GenerateImage\",\"data\":{\"b64Image\":\"AAA\",\"format\":\"png\",\"width\":1024,\"height\":1024}}"); }
fn ui_component_len() -> u64 { return STR_LEN("{\"action\":\"success\",\"toolName\":\"GenerateImage\",\"data\":{\"b64Image\":\"AAA\",\"format\":\"png\",\"width\":1024,\"height\":1024}}"); }
fn legacy_part() -> ptr { return STR_PTR("{\"action\":\"success\",\"message\":\"here\",\"parts\":[{\"type\":\"generated-image\",\"result\":\"BBB\",\"format\":\"jpeg\"}]}"); }
fn legacy_part_len() -> u64 { return STR_LEN("{\"action\":\"success\",\"message\":\"here\",\"parts\":[{\"type\":\"generated-image\",\"result\":\"BBB\",\"format\":\"jpeg\"}]}"); }
fn tool_call_json() -> ptr { return STR_PTR("{\"action\":\"success\",\"role\":\"tool-invocation\",\"state\":\"call\",\"toolName\":\"WebSearch\"}"); }
fn tool_call_json_len() -> u64 { return STR_LEN("{\"action\":\"success\",\"role\":\"tool-invocation\",\"state\":\"call\",\"toolName\":\"WebSearch\"}"); }

// describe("readImageResponse (Go image.go parity)")

fn test_extracts_ui_and_legacy(fails: &u64) -> void {
    let sse = ByteBuf { bytes: [0u8; 40960], len: 0 };
    buf_append_lit(&sse, STR_PTR("data: "), STR_LEN("data: "));
    buf_append_lit(&sse, tool_call_json(), tool_call_json_len());
    buf_append_lit(&sse, STR_PTR("\ndata: "), STR_LEN("\ndata: "));
    buf_append_lit(&sse, legacy_part(), legacy_part_len());
    buf_append_lit(&sse, STR_PTR("\ndata: "), STR_LEN("\ndata: "));
    buf_append_lit(&sse, ui_component(), ui_component_len());
    buf_append_lit(&sse, STR_PTR("\ndata: [DONE]\ndata: [PING]\n"), STR_LEN("\ndata: [DONE]\ndata: [PING]\n"));
    let res = blank_result();
    let __ap211: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap211, sse.bytes, 0);
    read_image_response(&res, __ap211, sse.len);
    let __ap212: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap212, res.text.bytes, 0);
    expect_str_eq(fails, __ap212, res.text.len, STR_PTR("here"), STR_LEN("here"));
    expect_u64_eq(fails, res.images_len, 2);
    // images[0] = legacy part { b64: "BBB", format: "jpeg" } (no width/height)
    expect_image(fails, &res, 0, STR_PTR("BBB"), STR_LEN("BBB"), STR_PTR("jpeg"), STR_LEN("jpeg"), false, 0, false, 0);
    // images[1] = ui component { b64: "AAA", format: "png", width: 1024, height: 1024 }
    expect_image(fails, &res, 1, STR_PTR("AAA"), STR_LEN("AAA"), STR_PTR("png"), STR_LEN("png"), true, 1024, true, 1024);
}

fn test_generate_image_without_data(fails: &u64) -> void {
    let line = ByteBuf { bytes: [0u8; 40960], len: 0 };
    buf_append_lit(&line, STR_PTR("data: {\"action\":\"success\",\"toolName\":\"GenerateImage\"}\n"), STR_LEN("data: {\"action\":\"success\",\"toolName\":\"GenerateImage\"}\n"));
    let res = blank_result();
    let __ap213: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap213, line.bytes, 0);
    read_image_response(&res, __ap213, line.len);
    expect_u64_eq(fails, res.images_len, 0);
}

fn test_non_success_and_malformed_skipped(fails: &u64) -> void {
    let body = STR_PTR("data: {\"action\":\"error\"}\ndata: not-json\ndata: [CHAT_TITLE test]\n: comment");
    let res = blank_result();
    read_image_response(&res, body, STR_LEN("data: {\"action\":\"error\"}\ndata: not-json\ndata: [CHAT_TITLE test]\n: comment"));
    // res toEqual { text: "", images: [] }
    expect_u64_eq(fails, res.text.len, 0);
    expect_u64_eq(fails, res.images_len, 0);
}

fn test_parse_image_event_bare_json(fails: &u64) -> void {
    let res = blank_result();
    let out_text = ByteBuf { bytes: [0u8; 40960], len: 0 };
    parse_image_event(&res, &out_text, ui_component(), ui_component_len());
    expect_u64_eq(fails, res.images_len, 1);
    expect_image(fails, &res, 0, STR_PTR("AAA"), STR_LEN("AAA"), STR_PTR("png"), STR_LEN("png"), true, 1024, true, 1024);
}

fn run_all_tests() -> u64 {
    let fails: u64 = 0;
    test_extracts_ui_and_legacy(&fails);
    test_generate_image_without_data(&fails);
    test_non_success_and_malformed_skipped(&fails);
    test_parse_image_event_bare_json(&fails);
    return fails;
}
