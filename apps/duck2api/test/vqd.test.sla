// Converted 1:1 from apps/duck2api/test/vqd.test.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "sa_std/ptr.sa"
@import "sa_std/encoding/json.sai"
@import "sa_std/string.sai"
@import "sa_std/string.sa"
@import "sa_std/ts_string.sa"
@import "../src/duckgo/vqd.sla"

// DEFECT: bun:test has no SLA counterpart (see convert.test.sla header).
// The TS reference hashes come from node:crypto createHash("sha256");
// the SLA reference is the independent intent extern sa_sha256_base64
// (the function under test, go_sha256_base64, is vqd.sla's own Go-parity
// implementation, so the two are still independent code paths).
// Buffer base64 round-trips map to sa_base64_encode / sa_base64_decode.

fn expect_true(fails: &u64, cond: bool) -> void { if !cond { let __sp20 = *fails; *fails = __sp20 + 1; }; }
fn expect_u64_eq(fails: &u64, a: u64, b: u64) -> void { if a != b { let __sp21 = *fails; *fails = __sp21 + 1; }; }
fn expect_str_eq(fails: &u64, ap: ptr, al: u64, bp: ptr, bl: u64) -> void {
    if ts_str_equals(ap, al, bp, bl) != 1 { let __sp22 = *fails; *fails = __sp22 + 1; };
}
fn expect_buf_eq(fails: &u64, a: &ByteBuf, bp: ptr, bl: u64) -> void {
    let __ap254: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap254, a.bytes, 0);
    expect_str_eq(fails, __ap254, a.len, bp, bl);
}

// describe("generateVQDHash")

fn test_hashes_client_hashes_and_merges_meta(fails: &u64) -> void {
    // const challenge = `({client_hashes: ["abc", "def"], meta: {v: 1}})`
    // const out = await generateVQDHash(Buffer.from(challenge, "utf8").toString("base64"))
    let challenge_b64 = ByteBuf { bytes: [0u8; 40960], len: 0 };
    sa_base64_encode(STR_PTR("({client_hashes: [\"abc\", \"def\"], meta: {v: 1}})"), STR_LEN("({client_hashes: [\"abc\", \"def\"], meta: {v: 1}})"), &challenge_b64);
    let out = ByteBuf { bytes: [0u8; 40960], len: 0 };
    let err = ByteBuf { bytes: [0u8; 40960], len: 0 };
    let __ap255: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap255, challenge_b64.bytes, 0);
    expect_u64_eq(fails, generate_vqd_hash(&out, &err, __ap255, challenge_b64.len), 0);
    let payload_text = ByteBuf { bytes: [0u8; 40960], len: 0 };
    let __ap_ob: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap_ob, out.bytes, 0);
    sa_base64_decode(&payload_text, __ap_ob, out.len);
    let __ap_pt: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap_pt, payload_text.bytes, 0);
    let payload: u64 = sa_json_parse(__ap_pt, payload_text.len);
    expect_true(fails, payload != 0);
    // Object.keys(payload).sort() toEqual ["client_hashes", "meta"]
    expect_true(fails, sa_json_object_has(payload, STR_PTR("client_hashes"), STR_LEN("client_hashes")));
    expect_true(fails, sa_json_object_has(payload, STR_PTR("meta"), STR_LEN("meta")));
    expect_u64_eq(fails, sa_json_object_len(payload), 2);
    let hashes: u64 = 0;
    sa_json_object_get(payload, STR_PTR("client_hashes"), STR_LEN("client_hashes"), &hashes);
    // client_hashes[0] is the solver-stamped UA hash
    let ua = ByteBuf { bytes: [0u8; 40960], len: 0 };
    vqd_user_agent(&ua);
    let expected0 = ByteBuf { bytes: [0u8; 40960], len: 0 };
    sa_sha256_base64(&ua.bytes, ua.len, &expected0);
    let h0: u64 = 0;
    sa_json_array_get(hashes, 0, &h0);
    let h0p: ptr = PTR_NULL();
    let h0l: u64 = 0;
    h0p = sa_json_string_ptr(h0); h0l = sa_json_string_len(h0);
    let __ap256: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap256, expected0.bytes, 0);
    expect_str_eq(fails, h0p, h0l, __ap256, expected0.len);
    // client_hashes[1] === sha("def")
    let expected1 = ByteBuf { bytes: [0u8; 40960], len: 0 };
    sa_sha256_base64(STR_PTR("def"), STR_LEN("def"), &expected1);
    let h1: u64 = 0;
    sa_json_array_get(hashes, 1, &h1);
    let h1p: ptr = PTR_NULL();
    let h1l: u64 = 0;
    h1p = sa_json_string_ptr(h1); h1l = sa_json_string_len(h1);
    let __ap257: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap257, expected1.bytes, 0);
    expect_str_eq(fails, h1p, h1l, __ap257, expected1.len);
    let meta: u64 = 0;
    sa_json_object_get(payload, STR_PTR("meta"), STR_LEN("meta"), &meta);
    let op: ptr = PTR_NULL();
    let ol: u64 = 0;
    sa_json_object_get_string(meta, STR_PTR("origin"), STR_LEN("origin"), &op, &ol);
    expect_str_eq(fails, op, ol, STR_PTR("https://duck.ai"), STR_LEN("https://duck.ai"));
    // String(meta["stack"]).startsWith("Error")
    let sp: ptr = PTR_NULL();
    let sl: u64 = 0;
    sa_json_object_get_string(meta, STR_PTR("stack"), STR_LEN("stack"), &sp, &sl);
    // String.startsWith -> sa_string_index_of (sa_std string.sai) == 0
    expect_true(fails, sa_string_index_of(sp, sl, STR_PTR("Error"), STR_LEN("Error")) == 0);
    // meta["v"] === 1 (the challenge's own meta survives the merge)
    let v: u64 = 0;
    sa_json_object_get(meta, STR_PTR("v"), STR_LEN("v"), &v);
    expect_true(fails, sa_json_number_value(v) == 1.0);
}

fn test_broken_challenge_falls_back(fails: &u64) -> void {
    let bad_b64 = ByteBuf { bytes: [0u8; 40960], len: 0 };
    sa_base64_encode(STR_PTR("!!!not js!!!"), STR_LEN("!!!not js!!!"), &bad_b64);
    let out = ByteBuf { bytes: [0u8; 40960], len: 0 };
    let err = ByteBuf { bytes: [0u8; 40960], len: 0 };
    let __ap258: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap258, bad_b64.bytes, 0);
    generate_vqd_hash(&out, &err, __ap258, bad_b64.len);
    let text = ByteBuf { bytes: [0u8; 40960], len: 0 };
    let __ap_tx: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap_tx, out.bytes, 0);
    sa_base64_decode(&text, __ap_tx, out.len);
    let __ap_tx2: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap_tx2, text.bytes, 0);
    expect_true(fails, sa_string_index_of(__ap_tx2, text.len, STR_PTR("!!!not js!!!::"), STR_LEN("!!!not js!!!::"), 0) == 0);
    // text.endsWith("::https://duck.ai")
    let suffix = STR_PTR("::https://duck.ai");
    let suffix_len = STR_LEN("::https://duck.ai");
    expect_true(fails, text.len >= suffix_len && bytes_eq_at(__ap_tx2, text.len - suffix_len, suffix, suffix_len));
}

fn test_go_sha256_base64_matches(fails: &u64) -> void {
    let got = ByteBuf { bytes: [0u8; 40960], len: 0 };
    go_sha256_base64(&got, STR_PTR("x"), STR_LEN("x"));
    let expected = ByteBuf { bytes: [0u8; 40960], len: 0 };
    sa_sha256_base64(STR_PTR("x"), STR_LEN("x"), &expected);
    let __ap259: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap259, expected.bytes, 0);
    expect_buf_eq(fails, &got, __ap259, expected.len);
}

fn run_all_tests() -> u64 {
    let fails: u64 = 0;
    test_hashes_client_hashes_and_merges_meta(&fails);
    test_broken_challenge_falls_back(&fails);
    test_go_sha256_base64_matches(&fails);
    return fails;
}
