// Converted 1:1 from apps/duck2api/test/tool-stream.test.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "sa_std/ptr.sa"
@import "sa_std/encoding/json.sai"
@import "sa_std/time.sai"
@import "sa_std/string.sa"
@import "sa_std/string.sai"
@import "sa_std/ts_string.sa"
@import "sa_std/ts_array.sa"
@import "../src/duckgo/tool-simulation.sla"
@import "../src/duckgo/stream.sla"

// DEFECT: bun:test has no SLA counterpart (see convert.test.sla header).
// String assertions bind the sa_std ts face where the TS uses String
// methods: toContain -> sa_string_index_of (string.sai), string equality
// -> @ts_str_equals (ts_string.sa). Array spread-pushes
// (parts.push(...parser.push(x))) and the parts text join
// (parts.map(...).join("")) correspond to @ts_arr_append_slice /
// @ts_arr_join_strs (ts_array.sa) over string/word handles; the parts
// here are structs, so the harness keeps struct tables and the join runs
// over the parts' text fields — 已绑 sa_std ts 面，句柄适配见缺陷日志。
// Fake bodies / write sinks are the same intent test doubles as
// stream.test.sla (sa_body_from_text, sa_test_sink_*).

fn expect_true(fails: &u64, cond: bool) -> void { if !cond { let __sp13 = *fails; *fails = __sp13 + 1; }; }
fn expect_u64_eq(fails: &u64, a: u64, b: u64) -> void { if a != b { let __sp14 = *fails; *fails = __sp14 + 1; }; }
fn expect_str_eq(fails: &u64, ap: ptr, al: u64, bp: ptr, bl: u64) -> void {
    if ts_str_equals(ap, al, bp, bl) != 1 { let __sp15 = *fails; *fails = __sp15 + 1; };
}
fn expect_contains(fails: &u64, hp: ptr, hl: u64, np: ptr, nl: u64) -> void {
    if sa_string_index_of(hp, hl, np, nl, 0) < 0 { let __sp16 = *fails; *fails = __sp16 + 1; };
}

struct AllParts {
    parts: [ToolSimulationPart; 64],
    len: u64,
}

fn all_parts_extend(all: &AllParts, src: &ToolSimParts) -> void {
    for i in 0..src.len {
        if all.len < 64 {
            all.parts[all.len] = src.parts[i];
            all.len = all.len + 1;
        };
    }
}

fn blank_stream() -> ToolSimulationStream {
    return ToolSimulationStream { pending: ToolSimPending { bytes: [0u8; 262144], len: 0 }, next_call: 0 };
}

fn blank_parts() -> ToolSimParts {
    return ToolSimParts { parts: [ToolSimulationPart { has_text: false, text: ByteBuf { bytes: [0u8; 40960], len: 0 }, has_tool_call: false, call: ToolCall { has_index: false, index: 0, id: [0u8; 128], id_len: 0, typ: [0u8; 32], typ_len: 0, fn_name: [0u8; 128], fn_name_len: 0, fn_arguments: [0u8; 4096], fn_arguments_len: 0 } }; 64], len: 0 };
}

fn blank_all() -> AllParts {
    return AllParts { parts: [ToolSimulationPart { has_text: false, text: ByteBuf { bytes: [0u8; 40960], len: 0 }, has_tool_call: false, call: ToolCall { has_index: false, index: 0, id: [0u8; 128], id_len: 0, typ: [0u8; 32], typ_len: 0, fn_name: [0u8; 128], fn_name_len: 0, fn_arguments: [0u8; 4096], fn_arguments_len: 0 } }; 64], len: 0 };
}

fn push_collect(stream: &ToolSimulationStream, all: &AllParts, p: ptr, l: u64) -> void {
    let parts = blank_parts();
    tool_simulation_stream_push(stream, &parts, p, l);
    all_parts_extend(all, &parts);
}

fn flush_collect(stream: &ToolSimulationStream, all: &AllParts) -> void {
    let parts = blank_parts();
    tool_simulation_stream_flush(stream, &parts);
    all_parts_extend(all, &parts);
}

// JSON.parse(arguments) -> object field string
fn args_field(call: &ToolCall, key_ptr: ptr, key_len: u64, out_ptr: &ptr, out_len: &u64) -> bool {
    let __ap_args: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap_args, call.fn_arguments, 0);
    let node: u64 = sa_json_parse(__ap_args, call.fn_arguments_len);
    if node == 0 { return false; };
    return sa_json_object_get_string(node, key_ptr, key_len, out_ptr, out_len) == 0;
}

// describe("ToolSimulationStream")

fn test_text_before_complete_action(fails: &u64) -> void {
    let stream = blank_stream();
    let first = blank_parts();
    tool_simulation_stream_push(&stream, &first, STR_PTR("Hello "), STR_LEN("Hello "));
    // expect(first).toEqual([{ text: "Hello " }])
    expect_u64_eq(fails, first.len, 1);
    expect_true(fails, first.parts[0].has_text);
    let __ap225: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap225, first.parts[0].text.bytes, 0);
    expect_str_eq(fails, __ap225, first.parts[0].text.len, STR_PTR("Hello "), STR_LEN("Hello "));
    let all = blank_all();
    push_collect(&stream, &all, STR_PTR("{\"play"), STR_LEN("{\"play"));
    push_collect(&stream, &all, STR_PTR("game\":{\"action\":\"exec"), STR_LEN("game\":{\"action\":\"exec"));
    push_collect(&stream, &all, STR_PTR("_command\",\"args\":{\"cmd\":\"Get-ChildItem\"}}}"), STR_LEN("_command\",\"args\":{\"cmd\":\"Get-ChildItem\"}}}"));
    flush_collect(&stream, &all);
    expect_u64_eq(fails, all.len, 1);
    expect_true(fails, all.parts[0].has_tool_call);
    let call = all.parts[0].call;
    let __ap226: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap226, call.id, 0);
    expect_str_eq(fails, __ap226, call.id_len, STR_PTR("call_playgame_1"), STR_LEN("call_playgame_1"));
    let __ap227: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap227, call.fn_name, 0);
    expect_str_eq(fails, __ap227, call.fn_name_len, STR_PTR("exec_command"), STR_LEN("exec_command"));
    let __ap228: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap228, call.fn_arguments, 0);
    expect_str_eq(fails, __ap228, call.fn_arguments_len, STR_PTR("{\"cmd\":\"Get-ChildItem\"}"), STR_LEN("{\"cmd\":\"Get-ChildItem\"}"));
}

fn test_pretty_printed_envelope(fails: &u64) -> void {
    let stream = blank_stream();
    let all = blank_all();
    push_collect(&stream, &all, STR_PTR("prefix\n{\n  \"play"), STR_LEN("prefix\n{\n  \"play"));
    push_collect(&stream, &all, STR_PTR("game\" : {\n    \"action\" : \"exec_command\",\n    \"args\" : {\n      \"cmd\" : \"pwd\"\n    }\n  }\n}"), STR_LEN("game\" : {\n    \"action\" : \"exec_command\",\n    \"args\" : {\n      \"cmd\" : \"pwd\"\n    }\n  }\n}"));
    flush_collect(&stream, &all);
    expect_u64_eq(fails, all.len, 2);
    expect_true(fails, all.parts[0].has_text);
    let __ap229: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap229, all.parts[0].text.bytes, 0);
    expect_str_eq(fails, __ap229, all.parts[0].text.len, STR_PTR("prefix\n"), STR_LEN("prefix\n"));
    expect_true(fails, all.parts[1].has_tool_call);
    let __ap230: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap230, all.parts[1].call.fn_name, 0);
    expect_str_eq(fails, __ap230, all.parts[1].call.fn_name_len, STR_PTR("exec_command"), STR_LEN("exec_command"));
    let p: ptr = PTR_NULL();
    let l: u64 = 0;
    expect_true(fails, args_field(&all.parts[1].call, STR_PTR("cmd"), STR_LEN("cmd"), &p, &l));
    expect_str_eq(fails, p, l, STR_PTR("pwd"), STR_LEN("pwd"));
}

fn test_repairs_windows_command_json(fails: &u64) -> void {
    let stream = blank_stream();
    let all = blank_all();
    let message = STR_PTR("{\"playgame\":{\"action\":\"exec_command\",\"args\":{\"cmd\":\"Get-ChildItem -Path .\\sala -Recurse -File; Write-Output \"done\"\"}}}");
    let mlen = STR_LEN("{\"playgame\":{\"action\":\"exec_command\",\"args\":{\"cmd\":\"Get-ChildItem -Path .\\sala -Recurse -File; Write-Output \"done\"\"}}}");
    // pushed one char at a time (message.slice(i, i + 1))
    for i in 0..mlen {
        let cp: ptr = PTR_NULL();
        PTR_BYTE_ADD(cp, message, i);
        push_collect(&stream, &all, cp, 1);
    }
    flush_collect(&stream, &all);
    expect_u64_eq(fails, all.len, 1);
    let __ap231: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap231, all.parts[0].call.fn_name, 0);
    expect_str_eq(fails, __ap231, all.parts[0].call.fn_name_len, STR_PTR("exec_command"), STR_LEN("exec_command"));
    let args: ptr = PTR_NULL();
    PTR_BYTE_ADD(args, all.parts[0].call.fn_arguments, 0);
    let args_len = all.parts[0].call.fn_arguments_len;
    expect_contains(fails, args, args_len, STR_PTR("Get-ChildItem -Path .\\\\sala"), STR_LEN("Get-ChildItem -Path .\\\\sala"));
    expect_contains(fails, args, args_len, STR_PTR("Write-Output \\\"done\\\""), STR_LEN("Write-Output \\\"done\\\""));
}

fn test_preserves_invalid_marker_as_text(fails: &u64) -> void {
    let stream = blank_stream();
    let all = blank_all();
    push_collect(&stream, &all, STR_PTR("prefix {\"playgame\":{\"action\":}}"), STR_LEN("prefix {\"playgame\":{\"action\":}}"));
    flush_collect(&stream, &all);
    let any_call = false;
    // parts.map((p) => p.text ?? "").join("") — @ts_arr_join_strs 面
    let text = ByteBuf { bytes: [0u8; 40960], len: 0 };
    for i in 0..all.len {
        if all.parts[i].has_tool_call { any_call = true; };
        if all.parts[i].has_text { buf_append_buf(&text, &all.parts[i].text); };
    }
    expect_true(fails, !any_call);
    let __ap232: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap232, text.bytes, 0);
    expect_str_eq(fails, __ap232, text.len, STR_PTR("prefix {\"playgame\":{\"action\":}}"), STR_LEN("prefix {\"playgame\":{\"action\":}}"));
}

fn test_fragmented_windows_command(fails: &u64) -> void {
    let stream = blank_stream();
    let all = blank_all();
    push_collect(&stream, &all, STR_PTR("{\"playgame\":{\"action\":\"exec_command\",\"args\":{\"cmd\":\"dir "), STR_LEN("{\"playgame\":{\"action\":\"exec_command\",\"args\":{\"cmd\":\"dir "));
    push_collect(&stream, &all, STR_PTR("\\sala\",\"workdir\":\"E:"), STR_LEN("\\sala\",\"workdir\":\"E:"));
    push_collect(&stream, &all, STR_PTR("\\projects\",\"shell\":\"powershell\"}}}"), STR_LEN("\\projects\",\"shell\":\"powershell\"}}}"));
    flush_collect(&stream, &all);
    expect_u64_eq(fails, all.len, 1);
    let __ap233: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap233, all.parts[0].call.fn_name, 0);
    expect_str_eq(fails, __ap233, all.parts[0].call.fn_name_len, STR_PTR("exec_command"), STR_LEN("exec_command"));
    let p: ptr = PTR_NULL();
    let l: u64 = 0;
    expect_true(fails, args_field(&all.parts[0].call, STR_PTR("cmd"), STR_LEN("cmd"), &p, &l));
    expect_str_eq(fails, p, l, STR_PTR("dir \\sala"), STR_LEN("dir \\sala"));
}

fn test_multiple_sequential_calls(fails: &u64) -> void {
    let stream = blank_stream();
    let all = blank_all();
    push_collect(&stream, &all, STR_PTR("{\"playgame\":{\"action\":\"read_file\",\"args\":{\"path\":\"foo.txt\"}}}\n"), STR_LEN("{\"playgame\":{\"action\":\"read_file\",\"args\":{\"path\":\"foo.txt\"}}}\n"));
    push_collect(&stream, &all, STR_PTR("{\"playgame\":{\"action\":\"write_file\",\"args\":{\"path\":\"bar.txt\",\"content\":\"hello\"}}}"), STR_LEN("{\"playgame\":{\"action\":\"write_file\",\"args\":{\"path\":\"bar.txt\",\"content\":\"hello\"}}}"));
    flush_collect(&stream, &all);
    expect_u64_eq(fails, all.len, 2);
    let __ap234: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap234, all.parts[0].call.id, 0);
    expect_str_eq(fails, __ap234, all.parts[0].call.id_len, STR_PTR("call_playgame_1"), STR_LEN("call_playgame_1"));
    let __ap235: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap235, all.parts[0].call.fn_name, 0);
    expect_str_eq(fails, __ap235, all.parts[0].call.fn_name_len, STR_PTR("read_file"), STR_LEN("read_file"));
    let __ap236: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap236, all.parts[1].call.id, 0);
    expect_str_eq(fails, __ap236, all.parts[1].call.id_len, STR_PTR("call_playgame_2"), STR_LEN("call_playgame_2"));
    let __ap237: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap237, all.parts[1].call.fn_name, 0);
    expect_str_eq(fails, __ap237, all.parts[1].call.fn_name_len, STR_PTR("write_file"), STR_LEN("write_file"));
}

// describe("parseToolSimulations")

fn test_parse_single_from_text(fails: &u64) -> void {
    let raw = STR_PTR("Thinking here...\n{\"playgame\":{\"action\":\"get_weather\",\"args\":{\"city\":\"Beijing\"}}}\nDone!");
    let raw_len = STR_LEN("Thinking here...\n{\"playgame\":{\"action\":\"get_weather\",\"args\":{\"city\":\"Beijing\"}}}\nDone!");
    let text = ByteBuf { bytes: [0u8; 40960], len: 0 };
    let calls = ToolCallList { calls: [ToolCall { has_index: false, index: 0, id: [0u8; 128], id_len: 0, typ: [0u8; 32], typ_len: 0, fn_name: [0u8; 128], fn_name_len: 0, fn_arguments: [0u8; 4096], fn_arguments_len: 0 }; 64], len: 0 };
    parse_tool_simulations(raw, raw_len, &text, &calls);
    expect_u64_eq(fails, calls.len, 1);
    let __ap238: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap238, calls.calls[0].id, 0);
    expect_str_eq(fails, __ap238, calls.calls[0].id_len, STR_PTR("call_playgame_1"), STR_LEN("call_playgame_1"));
    let __ap239: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap239, calls.calls[0].fn_name, 0);
    expect_str_eq(fails, __ap239, calls.calls[0].fn_name_len, STR_PTR("get_weather"), STR_LEN("get_weather"));
    let p: ptr = PTR_NULL();
    let l: u64 = 0;
    expect_true(fails, args_field(&calls.calls[0], STR_PTR("city"), STR_LEN("city"), &p, &l));
    expect_str_eq(fails, p, l, STR_PTR("Beijing"), STR_LEN("Beijing"));
    let __ap240: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap240, text.bytes, 0);
    expect_contains(fails, __ap240, text.len, STR_PTR("Thinking here..."), STR_LEN("Thinking here..."));
    let __ap241: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap241, text.bytes, 0);
    expect_contains(fails, __ap241, text.len, STR_PTR("Done!"), STR_LEN("Done!"));
}

fn test_parse_multiple_and_single_helper(fails: &u64) -> void {
    let raw = STR_PTR("{\"playgame\":{\"action\":\"tool_a\",\"args\":{}}}\n{\"playgame\":{\"action\":\"tool_b\",\"args\":{\"x\":1}}}");
    let raw_len = STR_LEN("{\"playgame\":{\"action\":\"tool_a\",\"args\":{}}}\n{\"playgame\":{\"action\":\"tool_b\",\"args\":{\"x\":1}}}");
    let text = ByteBuf { bytes: [0u8; 40960], len: 0 };
    let calls = ToolCallList { calls: [ToolCall { has_index: false, index: 0, id: [0u8; 128], id_len: 0, typ: [0u8; 32], typ_len: 0, fn_name: [0u8; 128], fn_name_len: 0, fn_arguments: [0u8; 4096], fn_arguments_len: 0 }; 64], len: 0 };
    parse_tool_simulations(raw, raw_len, &text, &calls);
    expect_u64_eq(fails, calls.len, 2);
    let __ap242: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap242, calls.calls[0].fn_name, 0);
    expect_str_eq(fails, __ap242, calls.calls[0].fn_name_len, STR_PTR("tool_a"), STR_LEN("tool_a"));
    let __ap243: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap243, calls.calls[1].fn_name, 0);
    expect_str_eq(fails, __ap243, calls.calls[1].fn_name_len, STR_PTR("tool_b"), STR_LEN("tool_b"));
    let single_text = ByteBuf { bytes: [0u8; 40960], len: 0 };
    let single_call = ToolCall { has_index: false, index: 0, id: [0u8; 128], id_len: 0, typ: [0u8; 32], typ_len: 0, fn_name: [0u8; 128], fn_name_len: 0, fn_arguments: [0u8; 4096], fn_arguments_len: 0 };
    expect_true(fails, parse_tool_simulation(raw, raw_len, &single_text, &single_call));
    let __ap244: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap244, single_call.fn_name, 0);
    expect_str_eq(fails, __ap244, single_call.fn_name_len, STR_PTR("tool_a"), STR_LEN("tool_a"));
    let none_text = ByteBuf { bytes: [0u8; 40960], len: 0 };
    let none_call = ToolCall { has_index: false, index: 0, id: [0u8; 128], id_len: 0, typ: [0u8; 32], typ_len: 0, fn_name: [0u8; 128], fn_name_len: 0, fn_arguments: [0u8; 4096], fn_arguments_len: 0 };
    // parseToolSimulation("plain text only").call === null
    expect_true(fails, !parse_tool_simulation(STR_PTR("plain text only"), STR_LEN("plain text only"), &none_text, &none_call));
    let __ap245: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap245, none_text.bytes, 0);
    expect_str_eq(fails, __ap245, none_text.len, STR_PTR("plain text only"), STR_LEN("plain text only"));
}

// describe("consumeUpstream with toolSimulation") + Responses variant

fn make_tool_opts(body: u64, stream: bool, prompt_tokens: u64, sink: u64) -> ConsumeOptions {
    let opts = ConsumeOptions { has_body: true, body: body, request_model: StrField { bytes: [0u8; 512], len: 0 }, reasoning_effort: StrField { bytes: [0u8; 512], len: 0 }, tool_simulation: true, stream: stream, stats: StreamStats { start: 0, prompt_tokens: prompt_tokens, cached_tokens: 0, effort: StrField { bytes: [0u8; 512], len: 0 } }, sink: sink };
    str_field_set(&opts.request_model, STR_PTR("gpt-4o-mini"), STR_LEN("gpt-4o-mini"));
    str_field_set(&opts.reasoning_effort, STR_PTR("low"), STR_LEN("low"));
    opts.stats.start = (sa_time_unix_ms() as u64);
    str_field_set(&opts.stats.effort, STR_PTR("low"), STR_LEN("low"));
    return opts;
}

fn blank_stream_result() -> StreamResult {
    return StreamResult { text: ByteBuf { bytes: [0u8; 40960], len: 0 }, output_tokens: 0, ttft_ms: 0, total_ms: 0, tool_calls: ToolCallList { calls: [ToolCall { has_index: false, index: 0, id: [0u8; 128], id_len: 0, typ: [0u8; 32], typ_len: 0, fn_name: [0u8; 128], fn_name_len: 0, fn_arguments: [0u8; 4096], fn_arguments_len: 0 }; 64], len: 0 } };
}

// chat line: "data: <json>\n\n" -> node
fn chat_line_json(sink: u64, idx: u64) -> u64 {
    let lp: ptr = PTR_NULL();
    let ll: u64 = 0;
    sa_test_sink_line(sink, idx, &lp, &ll);
    if ll < 8 { return 0; };
    let jp: ptr = PTR_NULL();
    PTR_BYTE_ADD(jp, lp, 6);
    let node: u64 = sa_json_parse(jp, ll - 8);
    return node;
}

fn test_chat_streaming_tool_chunk(fails: &u64) -> void {
    let payload = ByteBuf { bytes: [0u8; 40960], len: 0 };
    buf_append_lit(&payload, STR_PTR("data: {\"action\":\"success\",\"message\":\"I will run the command:\\n{\\\"play\"}\n\n"), STR_LEN("data: {\"action\":\"success\",\"message\":\"I will run the command:\\n{\\\"play\"}\n\n"));
    buf_append_lit(&payload, STR_PTR("data: {\"action\":\"success\",\"message\":\"game\\\":{\\\"action\\\":\\\"bash\\\",\\\"args\\\":{\\\"command\\\":\\\"ls -la\\\"}}}\n\n"), STR_LEN("data: {\"action\":\"success\",\"message\":\"game\\\":{\\\"action\\\":\\\"bash\\\",\\\"args\\\":{\\\"command\\\":\\\"ls -la\\\"}}}\n\n"));
    // DEFECT: the two literals above are the JSON.stringify wire forms of
    // ev1/ev2; escaping is hand-checked against the TS strings.
    let sink = sa_test_sink_new();
    let __ap_body1: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap_body1, payload.bytes, 0);
    let opts = make_tool_opts(sa_body_from_text(__ap_body1, payload.len), true, 15, sink);
    let r = blank_stream_result();
    expect_u64_eq(fails, consume_upstream(&opts, &r), 0);
    expect_u64_eq(fails, r.tool_calls.len, 1);
    let __ap246: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap246, r.tool_calls.calls[0].fn_name, 0);
    expect_str_eq(fails, __ap246, r.tool_calls.calls[0].fn_name_len, STR_PTR("bash"), STR_LEN("bash"));
    let count = sa_test_sink_line_count(sink);
    let found_tool = false;
    let found_stop = false;
    for i in 0..count {
        let n = chat_line_json(sink, i);
        if n == 0 { continue; };
        let ip: ptr = PTR_NULL();
        let il: u64 = 0;
        sa_json_object_get_string(n, STR_PTR("id"), STR_LEN("id"), &ip, &il);
        if il == 17 && ts_str_equals(ip, il, STR_PTR("chatcmpl-playgame"), STR_LEN("chatcmpl-playgame")) == 1 {
            found_tool = true;
            let choices: u64 = 0;
            sa_json_object_get(n, STR_PTR("choices"), STR_LEN("choices"), &choices);
            let c0: u64 = 0;
            sa_json_array_get(choices, 0, &c0);
            let delta: u64 = 0;
            sa_json_object_get(c0, STR_PTR("delta"), STR_LEN("delta"), &delta);
            let tcs: u64 = 0;
            sa_json_object_get(delta, STR_PTR("tool_calls"), STR_LEN("tool_calls"), &tcs);
            let tc0: u64 = 0;
            sa_json_array_get(tcs, 0, &tc0);
            let fnn: u64 = 0;
            sa_json_object_get(tc0, STR_PTR("function"), STR_LEN("function"), &fnn);
            let np: ptr = PTR_NULL();
            let nl: u64 = 0;
            sa_json_object_get_string(fnn, STR_PTR("name"), STR_LEN("name"), &np, &nl);
            expect_str_eq(fails, np, nl, STR_PTR("bash"), STR_LEN("bash"));
            expect_true(fails, sa_json_object_get_number(tc0, STR_PTR("index"), STR_LEN("index")) == 0.0);
        };
        let choices2: u64 = 0;
        sa_json_object_get(n, STR_PTR("choices"), STR_LEN("choices"), &choices2);
        if choices2 != 0 {
            let c0: u64 = 0;
            sa_json_array_get(choices2, 0, &c0);
            let fp: ptr = PTR_NULL();
            let fl: u64 = 0;
            if sa_json_object_get_string(c0, STR_PTR("finish_reason"), STR_LEN("finish_reason"), &fp, &fl) == 0 && fl > 0 {
                if ts_str_equals(fp, fl, STR_PTR("tool_calls"), STR_LEN("tool_calls")) == 1 { found_stop = true; };
            };
        };
    }
    expect_true(fails, found_tool);
    expect_true(fails, found_stop);
}

fn test_chat_non_streaming_collects(fails: &u64) -> void {
    let payload = ByteBuf { bytes: [0u8; 40960], len: 0 };
    buf_append_lit(&payload, STR_PTR("data: {\"action\":\"success\",\"message\":\"{\\\"playgame\\\":{\\\"action\\\":\\\"exec\\\",\\\"args\\\":{\\\"cmd\\\":\\\"whoami\\\"}}}\n\n"), STR_LEN("data: {\"action\":\"success\",\"message\":\"{\\\"playgame\\\":{\\\"action\\\":\\\"exec\\\",\\\"args\\\":{\\\"cmd\\\":\\\"whoami\\\"}}}\n\n"));
    // DEFECT: hand-escaped wire form of the TS JSON.stringify event (the
    // message's closing braces ride the SSE line ending in the source
    // because the event object closes after the string).
    let sink = sa_test_sink_new();
    let __ap_body2: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap_body2, payload.bytes, 0);
    let opts = make_tool_opts(sa_body_from_text(__ap_body2, payload.len), false, 15, sink);
    let r = blank_stream_result();
    expect_u64_eq(fails, consume_upstream(&opts, &r), 0);
    expect_u64_eq(fails, sa_test_sink_line_count(sink), 0);
    expect_u64_eq(fails, r.tool_calls.len, 1);
    let __ap247: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap247, r.tool_calls.calls[0].fn_name, 0);
    expect_str_eq(fails, __ap247, r.tool_calls.calls[0].fn_name_len, STR_PTR("exec"), STR_LEN("exec"));
}

// responses sink line: "event: <t>\ndata: <json>\n\n" -> data node
fn responses_line_json(sink: u64, idx: u64) -> u64 {
    let lp: ptr = PTR_NULL();
    let ll: u64 = 0;
    sa_test_sink_line(sink, idx, &lp, &ll);
    let at32 = sa_string_index_of(lp, ll, STR_PTR("data: "), STR_LEN("data: "), 0);
    if at32 < 0 { return 0; };
    let at = at32 as u64;
    let jp: ptr = PTR_NULL();
    PTR_BYTE_ADD(jp, lp, at + 6);
    let node: u64 = sa_json_parse(jp, ll - (at + 6) - 2);
    return node;
}

fn blank_responses_result() -> StreamResponsesResult {
    return StreamResponsesResult { base: blank_stream_result(), response_json: ByteBuf { bytes: [0u8; 40960], len: 0 } };
}

fn test_responses_streaming_function_call(fails: &u64) -> void {
    let payload = ByteBuf { bytes: [0u8; 40960], len: 0 };
    buf_append_lit(&payload, STR_PTR("data: {\"action\":\"success\",\"message\":\"{\\\"playgame\\\":{\\\"action\\\":\\\"get_user\\\",\\\"args\\\":{\\\"user_id\\\":42}}}\n\n"), STR_LEN("data: {\"action\":\"success\",\"message\":\"{\\\"playgame\\\":{\\\"action\\\":\\\"get_user\\\",\\\"args\\\":{\\\"user_id\\\":42}}}\n\n"));
    let sink = sa_test_sink_new();
    let __ap_body3: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap_body3, payload.bytes, 0);
    let opts = make_tool_opts(sa_body_from_text(__ap_body3, payload.len), true, 20, sink);
    let r = blank_responses_result();
    expect_u64_eq(fails, consume_upstream_responses(&opts, &r), 0);
    expect_u64_eq(fails, r.base.tool_calls.len, 1);
    let __ap248: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap248, r.base.tool_calls.calls[0].fn_name, 0);
    expect_str_eq(fails, __ap248, r.base.tool_calls.calls[0].fn_name_len, STR_PTR("get_user"), STR_LEN("get_user"));
    let count = sa_test_sink_line_count(sink);
    let found_added = false;
    let found_delta = false;
    let found_completed = false;
    for i in 0..count {
        let n = responses_line_json(sink, i);
        if n == 0 { continue; };
        let tp: ptr = PTR_NULL();
        let tl: u64 = 0;
        sa_json_object_get_string(n, STR_PTR("type"), STR_LEN("type"), &tp, &tl);
        if ts_str_equals(tp, tl, STR_PTR("response.output_item.added"), STR_LEN("response.output_item.added")) == 1 {
            let item: u64 = 0;
            sa_json_object_get(n, STR_PTR("item"), STR_LEN("item"), &item);
            let itp: ptr = PTR_NULL();
            let itl: u64 = 0;
            sa_json_object_get_string(item, STR_PTR("type"), STR_LEN("type"), &itp, &itl);
            if ts_str_equals(itp, itl, STR_PTR("function_call"), STR_LEN("function_call")) == 1 {
                found_added = true;
                let np: ptr = PTR_NULL();
                let nl: u64 = 0;
                sa_json_object_get_string(item, STR_PTR("name"), STR_LEN("name"), &np, &nl);
                expect_str_eq(fails, np, nl, STR_PTR("get_user"), STR_LEN("get_user"));
            };
        };
        if ts_str_equals(tp, tl, STR_PTR("response.function_call_arguments.delta"), STR_LEN("response.function_call_arguments.delta")) == 1 {
            found_delta = true;
            let dp: ptr = PTR_NULL();
            let dl: u64 = 0;
            sa_json_object_get_string(n, STR_PTR("delta"), STR_LEN("delta"), &dp, &dl);
            let args: u64 = sa_json_parse(dp, dl);
            expect_true(fails, sa_json_object_get_number(args, STR_PTR("user_id"), STR_LEN("user_id")) == 42.0);
        };
        if ts_str_equals(tp, tl, STR_PTR("response.completed"), STR_LEN("response.completed")) == 1 {
            found_completed = true;
            let resp: u64 = 0;
            sa_json_object_get(n, STR_PTR("response"), STR_LEN("response"), &resp);
            let output: u64 = 0;
            sa_json_object_get(resp, STR_PTR("output"), STR_LEN("output"), &output);
            let any_fc = false;
            let oi: u64 = 0;
            while 1 == 1 {
                let item: u64 = 0;
                if sa_json_array_get(output, oi, &item) != 0 { break; };
                oi = oi + 1;
                let itp: ptr = PTR_NULL();
                let itl: u64 = 0;
                sa_json_object_get_string(item, STR_PTR("type"), STR_LEN("type"), &itp, &itl);
                if ts_str_equals(itp, itl, STR_PTR("function_call"), STR_LEN("function_call")) == 1 { any_fc = true; };
            }
            expect_true(fails, any_fc);
        };
    }
    expect_true(fails, found_added);
    expect_true(fails, found_delta);
    expect_true(fails, found_completed);
}

fn test_responses_non_streaming_output(fails: &u64) -> void {
    let payload = ByteBuf { bytes: [0u8; 40960], len: 0 };
    buf_append_lit(&payload, STR_PTR("data: {\"action\":\"success\",\"message\":\"{\\\"playgame\\\":{\\\"action\\\":\\\"calculate\\\",\\\"args\\\":{\\\"expr\\\":\\\"2+2\\\"}}}\n\n"), STR_LEN("data: {\"action\":\"success\",\"message\":\"{\\\"playgame\\\":{\\\"action\\\":\\\"calculate\\\",\\\"args\\\":{\\\"expr\\\":\\\"2+2\\\"}}}\n\n"));
    let sink = sa_test_sink_new();
    let __ap_body4: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap_body4, payload.bytes, 0);
    let opts = make_tool_opts(sa_body_from_text(__ap_body4, payload.len), false, 20, sink);
    let r = blank_responses_result();
    expect_u64_eq(fails, consume_upstream_responses(&opts, &r), 0);
    expect_u64_eq(fails, r.base.tool_calls.len, 1);
    let __ap249: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap249, r.base.tool_calls.calls[0].fn_name, 0);
    expect_str_eq(fails, __ap249, r.base.tool_calls.calls[0].fn_name_len, STR_PTR("calculate"), STR_LEN("calculate"));
    // result.response.output contains the function_call item
    let __ap_rj: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap_rj, r.response_json.bytes, 0);
    let resp: u64 = sa_json_parse(__ap_rj, r.response_json.len);
    expect_true(fails, resp != 0);
    let output: u64 = 0;
    sa_json_object_get(resp, STR_PTR("output"), STR_LEN("output"), &output);
    let found = false;
    let oi: u64 = 0;
    while 1 == 1 {
        let item: u64 = 0;
        if sa_json_array_get(output, oi, &item) != 0 { break; };
        oi = oi + 1;
        let itp: ptr = PTR_NULL();
        let itl: u64 = 0;
        sa_json_object_get_string(item, STR_PTR("type"), STR_LEN("type"), &itp, &itl);
        if ts_str_equals(itp, itl, STR_PTR("function_call"), STR_LEN("function_call")) == 1 {
            found = true;
            let np: ptr = PTR_NULL();
            let nl: u64 = 0;
            sa_json_object_get_string(item, STR_PTR("name"), STR_LEN("name"), &np, &nl);
            expect_str_eq(fails, np, nl, STR_PTR("calculate"), STR_LEN("calculate"));
            let ap: ptr = PTR_NULL();
            let al: u64 = 0;
            sa_json_object_get_string(item, STR_PTR("arguments"), STR_LEN("arguments"), &ap, &al);
            let args: u64 = sa_json_parse(ap, al);
            let ep: ptr = PTR_NULL();
            let el: u64 = 0;
            sa_json_object_get_string(args, STR_PTR("expr"), STR_LEN("expr"), &ep, &el);
            expect_str_eq(fails, ep, el, STR_PTR("2+2"), STR_LEN("2+2"));
        };
    }
    expect_true(fails, found);
}

fn run_all_tests() -> u64 {
    let fails: u64 = 0;
    test_text_before_complete_action(&fails);
    test_pretty_printed_envelope(&fails);
    test_repairs_windows_command_json(&fails);
    test_preserves_invalid_marker_as_text(&fails);
    test_fragmented_windows_command(&fails);
    test_multiple_sequential_calls(&fails);
    test_parse_single_from_text(&fails);
    test_parse_multiple_and_single_helper(&fails);
    test_chat_streaming_tool_chunk(&fails);
    test_chat_non_streaming_collects(&fails);
    test_responses_streaming_function_call(&fails);
    test_responses_non_streaming_output(&fails);
    return fails;
}
