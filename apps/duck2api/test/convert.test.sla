// Converted 1:1 from apps/duck2api/test/convert.test.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "sa_std/ptr.sa"
@import "sa_std/string.sa"
@import "sa_std/ts_string.sa"
@import "sa_std/encoding/json.sai"
@import "../src/duckgo/convert.sla"

// DEFECT: bun:test (describe/test/expect) has no SLA counterpart. Tests
// are plain fns accumulating a failure count; run_all_tests() is the
// entry a future harness would call. Object deep-equality (toEqual) is
// checked field-by-field; APIRequest inputs are built as JSON text and
// parsed to nodes, matching convert.sla's input surface.

fn expect_true(fails: &u64, cond: bool) -> void { if !cond { let __sp2 = *fails; *fails = __sp2 + 1; }; }
fn expect_u64_eq(fails: &u64, a: u64, b: u64) -> void { if a != b { let __sp3 = *fails; *fails = __sp3 + 1; }; }
fn expect_str_eq(fails: &u64, ap: ptr, al: u64, bp: ptr, bl: u64) -> void {
    if ts_str_equals(ap, al, bp, bl) != 1 { let __sp4 = *fails; *fails = __sp4 + 1; };
}
fn expect_field_eq(fails: &u64, f: &StrField, lit_ptr: ptr, lit_len: u64) -> void {
    let __ap202: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap202, f.bytes, 0);
    expect_str_eq(fails, __ap202, f.len, lit_ptr, lit_len);
}
fn expect_buf_contains(fails: &u64, b: &ByteBuf, needle_ptr: ptr, needle_len: u64) -> void {
    let __ap203: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap203, b.bytes, 0);
    if find_sub_buf(__ap203, b.len, needle_ptr, needle_len) == 4294967295 { let __sp5 = *fails; *fails = __sp5 + 1; };
}
fn expect_buf_not_contains(fails: &u64, b: &ByteBuf, needle_ptr: ptr, needle_len: u64) -> void {
    let __ap204: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap204, b.bytes, 0);
    if find_sub_buf(__ap204, b.len, needle_ptr, needle_len) != 4294967295 { let __sp6 = *fails; *fails = __sp6 + 1; };
}

fn blank_part() -> DuckContentPart {
    return DuckContentPart { typ: StrField { bytes: [0u8; 512], len: 0 }, has_text: false, text: StrField { bytes: [0u8; 512], len: 0 }, has_image: false, image: StrField { bytes: [0u8; 512], len: 0 }, has_mime_type: false, mime_type: StrField { bytes: [0u8; 512], len: 0 }, has_filename: false, filename: StrField { bytes: [0u8; 512], len: 0 } };
}

fn blank_message() -> DuckMessage {
    return DuckMessage { role: StrField { bytes: [0u8; 512], len: 0 }, content_is_parts: false, content_text: StrField { bytes: [0u8; 512], len: 0 }, parts: PartsList { parts: [DuckContentPart { typ: StrField { bytes: [0u8; 512], len: 0 }, has_text: false, text: StrField { bytes: [0u8; 512], len: 0 }, has_image: false, image: StrField { bytes: [0u8; 512], len: 0 }, has_mime_type: false, mime_type: StrField { bytes: [0u8; 512], len: 0 }, has_filename: false, filename: StrField { bytes: [0u8; 512], len: 0 } }; 64], len: 0 } };
}

fn blank_request() -> DuckApiRequest {
    return DuckApiRequest { model: StrField { bytes: [0u8; 512], len: 0 }, has_tool_choice: false, tool_choice_web_search: false, tool_choice_generate_image: false, messages: [DuckMessage { role: StrField { bytes: [0u8; 512], len: 0 }, content_is_parts: false, content_text: StrField { bytes: [0u8; 512], len: 0 }, parts: PartsList { parts: [DuckContentPart { typ: StrField { bytes: [0u8; 512], len: 0 }, has_text: false, text: StrField { bytes: [0u8; 512], len: 0 }, has_image: false, image: StrField { bytes: [0u8; 512], len: 0 }, has_mime_type: false, mime_type: StrField { bytes: [0u8; 512], len: 0 }, has_filename: false, filename: StrField { bytes: [0u8; 512], len: 0 } }; 64], len: 0 } }; 128], messages_len: 0, can_use_tools: false, reasoning_effort: StrField { bytes: [0u8; 512], len: 0 }, has_can_use_approx_location: false, can_use_approx_location: false, has_can_delegate_image_generation: false, can_delegate_image_generation: false, can_show_greeting: false, durable_message_id: StrField { bytes: [0u8; 512], len: 0 }, durable_conversation_id: StrField { bytes: [0u8; 512], len: 0 }, durable_public_key_json: ByteBuf { bytes: [0u8; 40960], len: 0 }, has_tool_simulation: false, tool_simulation: false };
}

fn blank_store() -> FileStore {
    return FileStore { entries: [FileEntry { id: StrField { bytes: [0u8; 512], len: 0 }, filename: StrField { bytes: [0u8; 512], len: 0 }, mime_type: StrField { bytes: [0u8; 512], len: 0 }, data: ByteBuf { bytes: [0u8; 40960], len: 0 } }; 64], len: 0 };
}

fn parse_api(json_ptr: ptr, json_len: u64) -> u64 {
    return sa_json_parse(json_ptr, json_len);
}

fn convert(fails: &u64, json_ptr: ptr, json_len: u64, has_effort: bool, effort_ptr: ptr, effort_len: u64, web_search: bool, generate_image: bool) -> DuckApiRequest {
    let req = blank_request();
    let store = blank_store();
    let opts = ConvertOptions { has_reasoning_effort: has_effort, reasoning_effort: StrField { bytes: [0u8; 512], len: 0 }, web_search: web_search, generate_image: generate_image, has_file_store: false };
    if has_effort { str_field_set(&opts.reasoning_effort, effort_ptr, effort_len); };
    let api = parse_api(json_ptr, json_len);
    expect_true(fails, api != 0);
    convert_api_request_with_options(&req, api, &opts, &store);
    return req;
}

// describe("convertAPIRequestWithOptions")

fn test_maps_legacy_models_and_caps_effort(fails: &u64) -> void {
    let json = STR_PTR("{\"model\":\"gpt-3.5-turbo\",\"messages\":[{\"role\":\"system\",\"content\":\"sys\"},{\"role\":\"user\",\"content\":\"hi\"}],\"stream\":false}");
    let req = convert(fails, json, STR_LEN("{\"model\":\"gpt-3.5-turbo\",\"messages\":[{\"role\":\"system\",\"content\":\"sys\"},{\"role\":\"user\",\"content\":\"hi\"}],\"stream\":false}"), true, STR_PTR("high"), STR_LEN("high"), true, false);
    expect_field_eq(fails, &req.model, STR_PTR("gpt-4o-mini"), STR_LEN("gpt-4o-mini"));
    expect_field_eq(fails, &req.reasoning_effort, STR_PTR("low"), STR_LEN("low"));
    // req.metadata.toolChoice?.["WebSearch"] === true
    expect_true(fails, req.has_tool_choice && req.tool_choice_web_search);
    // Pure-conversation channel: system intercepted; roles == ["user"]
    expect_u64_eq(fails, req.messages_len, 1);
    expect_field_eq(fails, &req.messages[0].role, STR_PTR("user"), STR_LEN("user"));
    // content is always an array of parts, even for a single text part
    expect_true(fails, req.messages[0].content_is_parts);
    expect_u64_eq(fails, req.messages[0].parts.len, 1);
    expect_field_eq(fails, &req.messages[0].parts.parts[0].typ, STR_PTR("text"), STR_LEN("text"));
    expect_field_eq(fails, &req.messages[0].parts.parts[0].text, STR_PTR("hi"), STR_LEN("hi"));
    expect_true(fails, req.can_show_greeting);
    expect_u64_eq(fails, req.durable_message_id.len, 36);
    // String(req.durableStream.publicKey["n"]).length > 100
    let __ap205: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap205, req.durable_public_key_json.bytes, 0);
    let nkey = find_sub_buf(__ap205, req.durable_public_key_json.len, STR_PTR("\"n\":\""), STR_LEN("\"n\":\""));
    expect_true(fails, nkey != 4294967295);
    if nkey != 4294967295 {
        let start = nkey + 5;
        let p: ptr = PTR_NULL();
        PTR_BYTE_ADD(p, req.durable_public_key_json.bytes, start);
        let close = find_byte(p, req.durable_public_key_json.len - start, 34);
        expect_true(fails, close != 4294967295 && close > 100);
    };
}

fn test_cap_reasoning_effort_defaults(fails: &u64) -> void {
    let out = StrField { bytes: [0u8; 512], len: 0 };
    cap_reasoning_effort(&out, STR_PTR("none"), STR_LEN("none"));
    expect_field_eq(fails, &out, STR_PTR("none"), STR_LEN("none"));
    cap_reasoning_effort(&out, STR_PTR(""), 0);
    expect_field_eq(fails, &out, STR_PTR("low"), STR_LEN("low"));
    cap_reasoning_effort(&out, STR_PTR("medium"), STR_LEN("medium"));
    expect_field_eq(fails, &out, STR_PTR("low"), STR_LEN("low"));
}

fn test_system_developer_intercepted(fails: &u64) -> void {
    let json = STR_PTR("{\"model\":\"gpt-6-luna\",\"messages\":[{\"role\":\"system\",\"content\":\"you are a tool agent\"},{\"role\":\"developer\",\"content\":\"skill instructions\"},{\"role\":\"user\",\"content\":\"hi\"}],\"stream\":false}");
    let req = convert(fails, json, STR_LEN("{\"model\":\"gpt-6-luna\",\"messages\":[{\"role\":\"system\",\"content\":\"you are a tool agent\"},{\"role\":\"developer\",\"content\":\"skill instructions\"},{\"role\":\"user\",\"content\":\"hi\"}],\"stream\":false}"), false, STR_PTR(""), 0, false, false);
    expect_u64_eq(fails, req.messages_len, 1);
    expect_field_eq(fails, &req.messages[0].role, STR_PTR("user"), STR_LEN("user"));
    expect_u64_eq(fails, req.messages[0].parts.len, 1);
    expect_field_eq(fails, &req.messages[0].parts.parts[0].text, STR_PTR("hi"), STR_LEN("hi"));
    // JSON.stringify(req) does not contain "tool agent"
    let wire = ByteBuf { bytes: [0u8; 40960], len: 0 };
    duck_api_request_to_json(&wire, &req);
    expect_buf_not_contains(fails, &wire, STR_PTR("tool agent"), STR_LEN("tool agent"));
}

fn test_tool_messages_dropped(fails: &u64) -> void {
    let json = STR_PTR("{\"model\":\"gpt-6-luna\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"},{\"role\":\"tool\",\"content\":\"tool output\"},{\"role\":\"assistant\",\"content\":\"hello\"}],\"stream\":false}");
    let req = convert(fails, json, STR_LEN("{\"model\":\"gpt-6-luna\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"},{\"role\":\"tool\",\"content\":\"tool output\"},{\"role\":\"assistant\",\"content\":\"hello\"}],\"stream\":false}"), false, STR_PTR(""), 0, false, false);
    expect_u64_eq(fails, req.messages_len, 2);
    expect_field_eq(fails, &req.messages[0].role, STR_PTR("user"), STR_LEN("user"));
    // DEFECT (source inconsistency, converted as written): the TS test
    // expects roles ["user", "assistant"], but convert.ts folds assistant
    // messages into role "user" with an "[assistant] " prefix — the TS
    // test as written contradicts its own source. Kept verbatim.
    expect_field_eq(fails, &req.messages[1].role, STR_PTR("assistant"), STR_LEN("assistant"));
    let wire = ByteBuf { bytes: [0u8; 40960], len: 0 };
    duck_api_request_to_json(&wire, &req);
    expect_buf_not_contains(fails, &wire, STR_PTR("playgame"), STR_LEN("playgame"));
    // req.toolSimulation === undefined
    expect_true(fails, !req.has_tool_simulation);
    expect_true(fails, req.can_use_tools);
}

fn test_client_tools_ignored(fails: &u64) -> void {
    // DEFECT: TS passes { tools: [...] } as ConvertOptions via an
    // `as never` cast; ConvertOptions has no tools field in either
    // language, so the SLA call simply has nowhere to put it — the
    // observable outcomes are asserted.
    let json = STR_PTR("{\"model\":\"gpt-6-luna\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}],\"stream\":false}");
    let req = convert(fails, json, STR_LEN("{\"model\":\"gpt-6-luna\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}],\"stream\":false}"), false, STR_PTR(""), 0, false, false);
    expect_u64_eq(fails, req.messages_len, 1);
    expect_field_eq(fails, &req.messages[0].parts.parts[0].text, STR_PTR("hi"), STR_LEN("hi"));
    expect_true(fails, !req.has_tool_simulation);
    expect_true(fails, req.can_use_tools);
}

fn test_durable_streams_unique(fails: &u64) -> void {
    let a = blank_request();
    let b = blank_request();
    new_durable_stream(&a);
    new_durable_stream(&b);
    let __ap207: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap207, a.durable_message_id.bytes, 0);
    let __ap206: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap206, b.durable_message_id.bytes, 0);
    expect_true(fails, !(a.durable_message_id.len == b.durable_message_id.len && bytes_eq3(__ap207, __ap206, a.durable_message_id.len)));
    let __ap209: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap209, a.durable_conversation_id.bytes, 0);
    let __ap208: ptr = PTR_NULL();
    PTR_BYTE_ADD(__ap208, b.durable_conversation_id.bytes, 0);
    expect_true(fails, !(a.durable_conversation_id.len == b.durable_conversation_id.len && bytes_eq3(__ap209, __ap208, a.durable_conversation_id.len)));
}

fn test_delisted_alias(fails: &u64) -> void {
    let json = STR_PTR("{\"model\":\"gpt-5.6-luna\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}],\"stream\":false}");
    let req = convert(fails, json, STR_LEN("{\"model\":\"gpt-5.6-luna\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}],\"stream\":false}"), false, STR_PTR(""), 0, false, false);
    expect_field_eq(fails, &req.model, STR_PTR("gpt-6-luna"), STR_LEN("gpt-6-luna"));
    expect_true(fails, req.can_show_greeting);
    expect_field_eq(fails, &req.messages[0].parts.parts[0].text, STR_PTR("hi"), STR_LEN("hi"));
}

fn test_generate_image_wire(fails: &u64) -> void {
    let json = STR_PTR("{\"model\":\"gpt-6-luna\",\"messages\":[{\"role\":\"user\",\"content\":\"生成2只在海里格斗的wwe勇士\"}],\"stream\":false}");
    let req = convert(fails, json, STR_LEN("{\"model\":\"gpt-6-luna\",\"messages\":[{\"role\":\"user\",\"content\":\"生成2只在海里格斗的wwe勇士\"}],\"stream\":false}"), false, STR_PTR(""), 0, false, true);
    expect_field_eq(fails, &req.model, STR_PTR("gpt-6-luna"), STR_LEN("gpt-6-luna"));
    // metadata toEqual { toolChoice: { GenerateImage: true } }
    expect_true(fails, req.has_tool_choice && req.tool_choice_generate_image && !req.tool_choice_web_search);
    expect_true(fails, req.can_use_tools);
    expect_true(fails, req.has_can_use_approx_location && !req.can_use_approx_location);
    // canDelegateImageGeneration === null
    expect_true(fails, !req.has_can_delegate_image_generation);
    expect_true(fails, req.can_show_greeting);
}

fn test_image_parts_flip_location(fails: &u64) -> void {
    let json = STR_PTR("{\"model\":\"gpt-6-luna\",\"messages\":[{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"你看到什么？\"},{\"type\":\"image\",\"image\":\"data:image/webp;base64,AAA\",\"mimeType\":\"image/webp\"}]}],\"stream\":false}");
    let req = convert(fails, json, STR_LEN("{\"model\":\"gpt-6-luna\",\"messages\":[{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"你看到什么？\"},{\"type\":\"image\",\"image\":\"data:image/webp;base64,AAA\",\"mimeType\":\"image/webp\"}]}],\"stream\":false}"), false, STR_PTR(""), 0, false, false);
    // metadata toEqual {}
    expect_true(fails, !req.has_tool_choice);
    expect_true(fails, req.has_can_use_approx_location && !req.can_use_approx_location);
    expect_u64_eq(fails, req.messages[0].parts.len, 2);
    expect_field_eq(fails, &req.messages[0].parts.parts[0].typ, STR_PTR("text"), STR_LEN("text"));
    expect_field_eq(fails, &req.messages[0].parts.parts[0].text, STR_PTR("你看到什么？"), STR_LEN("你看到什么？"));
    expect_field_eq(fails, &req.messages[0].parts.parts[1].typ, STR_PTR("image"), STR_LEN("image"));
    expect_field_eq(fails, &req.messages[0].parts.parts[1].image, STR_PTR("data:image/webp;base64,AAA"), STR_LEN("data:image/webp;base64,AAA"));
    expect_field_eq(fails, &req.messages[0].parts.parts[1].mime_type, STR_PTR("image/webp"), STR_LEN("image/webp"));
}

fn test_text_only_location_null(fails: &u64) -> void {
    let json = STR_PTR("{\"model\":\"gpt-6-luna\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}],\"stream\":false}");
    let req = convert(fails, json, STR_LEN("{\"model\":\"gpt-6-luna\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}],\"stream\":false}"), false, STR_PTR(""), 0, false, false);
    // canUseApproxLocation === null
    expect_true(fails, !req.has_can_use_approx_location);
}

fn test_default_metadata_empty(fails: &u64) -> void {
    let json = STR_PTR("{\"model\":\"gpt-6-luna\",\"messages\":[{\"role\":\"user\",\"content\":\"搜索广州天气\"}],\"stream\":false}");
    let req = convert(fails, json, STR_LEN("{\"model\":\"gpt-6-luna\",\"messages\":[{\"role\":\"user\",\"content\":\"搜索广州天气\"}],\"stream\":false}"), false, STR_PTR(""), 0, false, false);
    // metadata toEqual {} — "metadata":{} with no false flags
    expect_true(fails, !req.has_tool_choice);
    expect_true(fails, req.can_show_greeting);
    expect_field_eq(fails, &req.messages[0].parts.parts[0].text, STR_PTR("搜索广州天气"), STR_LEN("搜索广州天气"));
}

fn run_all_tests() -> u64 {
    let fails: u64 = 0;
    test_maps_legacy_models_and_caps_effort(&fails);
    test_cap_reasoning_effort_defaults(&fails);
    test_system_developer_intercepted(&fails);
    test_tool_messages_dropped(&fails);
    test_client_tools_ignored(&fails);
    test_durable_streams_unique(&fails);
    test_delisted_alias(&fails);
    test_generate_image_wire(&fails);
    test_image_parts_flip_location(&fails);
    test_text_only_location_null(&fails);
    test_default_metadata_empty(&fails);
    return fails;
}
