// Converted 1:1 from frontends/jev/src/web.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "./manifest.sla"
// TS re-exports:
//   export { JEV_MANIFEST } from "./manifest.js";  (above import)
//   export { JevSettingsDialog } from "./jev/JevSettingsDialog.js";
//   (converted in ./jev/JevSettingsDialog.sax alongside this file).

/**
 * JEV evaluation engine — web side (kind "service"). Owns the JEV
 * client stack (`src/jev/`: jevConfig, jevClient, jevQuestions,
 * jevAutoJudge, jevTurnSnapshotDispatch) and the settings dialog
 * (`src/jev/JevSettingsDialog.tsx`), all moved verbatim from the
 * host. The composer and the settings shell import them directly
 * during staging.
 */

// DEFECT: the WebFeaturePlugin type comes from @cxu/sdk-frontend,
// which has no SLA counterpart yet. The shape below mirrors the
// TS object 1:1; contribution entries are fixed arrays + len.
struct WebFeaturePlugin {
    manifest: PluginManifest,
    settings_panels: [SettingsPanelContribution; 4],
    settings_panels_len: u64,
}

struct SettingsPanelContribution {
    id_ptr: ptr,
    id_len: u64,
    title_key_ptr: ptr,
    title_key_len: u64,
    render_id: u64,
}

// TS: render: () => { throw new Error("jev settings render through
// the host's direct JevSettingsDialog import during staging"); }
// DEFECT: closures and throw have no SLA counterpart; the render
// callback is represented by render_id and this stub, which
// returns the staging error as a status code.
fn jev_panel_render() -> i32 {
    // error: "jev settings render through the host's direct JevSettingsDialog import during staging"
    return 90;
}

// TS: export const jevWebPlugin: WebFeaturePlugin = { ... };
// export default jevWebPlugin; (SLA has no default export;
// the builder function below is the export.)
fn build_jevWebPlugin(out: &WebFeaturePlugin) -> i32 {
    let mst = load_JEV_MANIFEST(&out.manifest);
    if mst != 0 { return mst; };
    out.settings_panels_len = 1;
    out.settings_panels[0].id_ptr = STR_PTR("jev");
    out.settings_panels[0].id_len = STR_LEN("jev");
    out.settings_panels[0].title_key_ptr = STR_PTR("jev.settings.title");
    out.settings_panels[0].title_key_len = STR_LEN("jev.settings.title");
    out.settings_panels[0].render_id = 1;
    return 0;
}
