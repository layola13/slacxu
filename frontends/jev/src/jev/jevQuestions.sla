// Converted 1:1 from frontends/jev/src/jev/jevQuestions.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "sa_std/json.sai"
@import "sa_std/ptr.sa"

// ---------- string helpers (local; TS string ops are methods) ----------

struct StrBuf {
    bytes: [u8; 65536],
    len: u64,
}

fn sb_append(buf: &StrBuf, src_ptr: ptr, src_len: u64) -> void {
    for i in 0..src_len {
        if buf.len < 65536 {
            let b: u8 = 0;
            PTR_BYTE_AT(b, src_ptr, i);
            buf.bytes[buf.len] = b;
            buf.len = buf.len + 1;
        };
    }
}

fn sb_append_lit(buf: &StrBuf, lit_ptr: ptr, lit_len: u64) -> void {
    sb_append(buf, lit_ptr, lit_len);
}

fn sb_append_u64(buf: &StrBuf, v: u64) -> void {
    if v == 0 {
        if buf.len < 65536 { buf.bytes[buf.len] = 48; buf.len = buf.len + 1; };
        return;
    };
    let digits = [0u8; 20];
    let n: u64 = 0;
    let x = v;
    while x > 0 {
        digits[n] = (48 + (x % 10)) as u8;
        n = n + 1;
        x = x / 10;
    }
    let i = n;
    while i > 0 {
        i = i - 1;
        if buf.len < 65536 { buf.bytes[buf.len] = digits[i]; buf.len = buf.len + 1; };
    }
}

// JS Number.prototype.toFixed(1), approximated (round half up on
// the scaled value; JS uses round-half-to-even on exact ties).
fn sb_append_f64_1dp(buf: &StrBuf, v: f64) -> void {
    let neg = v < 0.0;
    let a = v;
    if neg { a = 0.0 - v; };
    let scaled = (a * 10.0 + 0.5) as u64;
    if neg { sb_append_lit(buf, STR_PTR("-"), STR_LEN("-")); };
    sb_append_u64(buf, scaled / 10);
    sb_append_lit(buf, STR_PTR("."), STR_LEN("."));
    sb_append_u64(buf, scaled % 10);
}

// Math.round(x) for the non-negative values used here.
fn sb_append_pct(buf: &StrBuf, v: f64) -> void {
    let p = (v * 100.0 + 0.5) as u64;
    sb_append_u64(buf, p);
}

fn str_eq_lit(a_ptr: ptr, a_len: u64, lit_ptr: ptr, lit_len: u64) -> bool {
    if a_len != lit_len { return false; };
    for i in 0..a_len {
        let x: u8 = 0;
        let y: u8 = 0;
        PTR_BYTE_AT(x, a_ptr, i);
        PTR_BYTE_AT(y, lit_ptr, i);
        if x != y { return false; };
    }
    return true;
}

fn str_contains(hay_ptr: ptr, hay_len: u64, nd_ptr: ptr, nd_len: u64) -> bool {
    if nd_len == 0 { return true; };
    if hay_len < nd_len { return false; };
    let last = hay_len - nd_len;
    let i: u64 = 0;
    while i <= last {
        let ok = true;
        for j in 0..nd_len {
            let x: u8 = 0;
            let y: u8 = 0;
            PTR_BYTE_AT(x, hay_ptr, i + j);
            PTR_BYTE_AT(y, nd_ptr, j);
            if x != y { ok = false; break; };
        }
        if ok { return true; };
        i = i + 1;
    }
    return false;
}

// Writes an ASCII-lowercased copy of src into out (cap out_cap).
fn lower_into(src_ptr: ptr, src_len: u64, out: &StrBuf) -> void {
    out.len = 0;
    for i in 0..src_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, src_ptr, i);
        if b >= 65 && b <= 90 { b = b + 32; };
        if out.len < 65536 { out.bytes[out.len] = b; out.len = out.len + 1; };
    }
}

// trim (ASCII whitespace) into a view.
fn trim_into(src_ptr: ptr, src_len: u64, out_ptr: &ptr, out_len: &u64) -> void {
    let start: u64 = 0;
    let end = src_len;
    while start < end {
        let b: u8 = 0;
        PTR_BYTE_AT(b, src_ptr, start);
        if b == 32 || b == 9 || b == 10 || b == 13 { start = start + 1; } else { break; };
    }
    while end > start {
        let b2: u8 = 0;
        PTR_BYTE_AT(b2, src_ptr, end - 1);
        if b2 == 32 || b2 == 9 || b2 == 10 || b2 == 13 { end = end - 1; } else { break; };
    }
    let p: ptr = PTR_NULL();
    PTR_BYTE_ADD(p, src_ptr, start);
    *out_ptr = p;
    *out_len = end - start;
}

// DEFECT: TS String.slice counts UTF-16 code units; this slices
// bytes (identical for ASCII, may split a multi-byte character
// at the boundary otherwise).
fn slice_into(src_ptr: ptr, src_len: u64, max_len: u64, out: &StrBuf) -> void {
    out.len = 0;
    let n = src_len;
    if n > max_len { n = max_len; };
    sb_append(out, src_ptr, n);
}

// ---------- snapshot types ----------

// TS: export interface JevTurnSnapshotItem { type: string; title?: string; text?: string }
struct JevTurnSnapshotItem {
    type_ptr: ptr,
    type_len: u64,
    title_ptr: ptr,
    title_len: u64,
    title_has: bool,
    text_ptr: ptr,
    text_len: u64,
    text_has: bool,
}

// TS: export interface JevTurnSnapshot { threadId: string; turnId: string; items: JevTurnSnapshotItem[] }
// DEFECT: TS array — fixed capacity 256 items.
struct JevTurnSnapshot {
    thread_id_ptr: ptr,
    thread_id_len: u64,
    turn_id_ptr: ptr,
    turn_id_len: u64,
    items: [JevTurnSnapshotItem; 256],
    items_len: u64,
}

// TS: export function buildJevState(snapshot: JevTurnSnapshot): string
// DEFECT: the three text lists are kept as ring windows (first
// user entry + last 2 users, last 3 assistants, last 8 tools)
// instead of full arrays; the joins/slices of the source are
// reproduced over those windows.
fn buildJevState(snapshot: &JevTurnSnapshot, out: &StrBuf) -> void {
    let first_user = StrBuf { bytes: [0u8; 65536], len: 0 };
    let user_count: u64 = 0;
    let u_last0 = StrBuf { bytes: [0u8; 65536], len: 0 };
    let u_last1 = StrBuf { bytes: [0u8; 65536], len: 0 };
    let a_last0 = StrBuf { bytes: [0u8; 65536], len: 0 };
    let a_last1 = StrBuf { bytes: [0u8; 65536], len: 0 };
    let a_last2 = StrBuf { bytes: [0u8; 65536], len: 0 };
    let a_count: u64 = 0;
    // tool ring: 8 slots of 2048 bytes each in one flat buffer
    let tool_flat = StrBuf { bytes: [0u8; 65536], len: 0 };
    let tool_lens = [0u64; 8];
    let tool_count: u64 = 0;
    let entry = StrBuf { bytes: [0u8; 65536], len: 0 };
    let kind = StrBuf { bytes: [0u8; 65536], len: 0 };
    for ii in 0..snapshot.items_len {
        let item = &snapshot.items[ii];
        // const text = `${item.title ? `${item.title}\n` : ""}${item.text ?? ""}`.trim();
        entry.len = 0;
        if item.title_has {
            sb_append(&entry, item.title_ptr, item.title_len);
            sb_append_lit(&entry, STR_PTR("\n"), STR_LEN("\n"));
        };
        if item.text_has {
            sb_append(&entry, item.text_ptr, item.text_len);
        };
        let t_ptr: ptr = PTR_NULL();
        let t_len: u64 = 0;
        let e_ptr: ptr = PTR_NULL();
        PTR_BYTE_ADD(e_ptr, &entry.bytes, 0);
        trim_into(e_ptr, entry.len, &t_ptr, &t_len);
        if t_len == 0 { continue; };
        lower_into(item.type_ptr, item.type_len, &kind);
        let k_ptr: ptr = PTR_NULL();
        PTR_BYTE_ADD(k_ptr, &kind.bytes, 0);
        if str_contains(k_ptr, kind.len, STR_PTR("user"), STR_LEN("user")) {
            let capped = StrBuf { bytes: [0u8; 65536], len: 0 };
            slice_into(t_ptr, t_len, 4000, &capped);
            if user_count == 0 {
                first_user.len = 0;
                sb_append(&first_user, &capped.bytes, capped.len);
            };
            u_last0.len = 0;
            sb_append(&u_last0, &u_last1.bytes, u_last1.len);
            u_last1.len = 0;
            sb_append(&u_last1, &capped.bytes, capped.len);
            user_count = user_count + 1;
        } else if str_contains(k_ptr, kind.len, STR_PTR("agent"), STR_LEN("agent")) || str_contains(k_ptr, kind.len, STR_PTR("assistant"), STR_LEN("assistant")) || str_contains(k_ptr, kind.len, STR_PTR("message"), STR_LEN("message")) {
            let capped2 = StrBuf { bytes: [0u8; 65536], len: 0 };
            slice_into(t_ptr, t_len, 6000, &capped2);
            a_last0.len = 0;
            sb_append(&a_last0, &a_last1.bytes, a_last1.len);
            a_last1.len = 0;
            sb_append(&a_last1, &a_last2.bytes, a_last2.len);
            a_last2.len = 0;
            sb_append(&a_last2, &capped2.bytes, capped2.len);
            a_count = a_count + 1;
        } else {
            // toolTexts.push(`${item.type}: ${text}`.slice(0, 2000))
            let full = StrBuf { bytes: [0u8; 65536], len: 0 };
            sb_append(&full, item.type_ptr, item.type_len);
            sb_append_lit(&full, STR_PTR(": "), STR_LEN(": "));
            sb_append(&full, t_ptr, t_len);
            let capped3 = StrBuf { bytes: [0u8; 65536], len: 0 };
            slice_into(&full.bytes, full.len, 2000, &capped3);
            // ring insert at slot tool_count % 8: rebuild flat
            // DEFECT: ring rebuild copies the flat buffer per
            // insert (quadratic on tool-heavy turns); semantics
            // (last 8, in order) are preserved.
            let slot = tool_count % 8;
            if tool_count >= 8 {
                // drop the oldest slot (slot == tool_count % 8 is oldest)
                let keep = StrBuf { bytes: [0u8; 65536], len: 0 };
                let off: u64 = 0;
                for si in 0..8 {
                    if si != slot {
                        for bi in 0..tool_lens[si] {
                            if keep.len < 65536 { keep.bytes[keep.len] = tool_flat.bytes[off + bi]; keep.len = keep.len + 1; };
                        }
                    };
                    off = off + tool_lens[si];
                }
                tool_flat.len = 0;
                sb_append(&tool_flat, &keep.bytes, keep.len);
                // compact lens: shift lens after removing `slot`
                let nl = [0u64; 8];
                let ni: u64 = 0;
                for si2 in 0..8 {
                    if si2 != slot { nl[ni] = tool_lens[si2]; ni = ni + 1; };
                }
                for si3 in 0..8 { tool_lens[si3] = nl[si3]; };
                for bi2 in 0..capped3.len {
                    if tool_flat.len < 65536 { tool_flat.bytes[tool_flat.len] = capped3.bytes[bi2]; tool_flat.len = tool_flat.len + 1; };
                }
                tool_lens[7] = capped3.len;
            } else {
                for bi3 in 0..capped3.len {
                    if tool_flat.len < 65536 { tool_flat.bytes[tool_flat.len] = capped3.bytes[bi3]; tool_flat.len = tool_flat.len + 1; };
                }
                tool_lens[tool_count] = capped3.len;
            };
            tool_count = tool_count + 1;
        };
    }
    // const recentUsers = userTexts.slice(-2);
    // const original = userTexts.length > recentUsers.length ? userTexts[0] : "";
    out.len = 0;
    let recent_n = user_count;
    if recent_n > 2 { recent_n = 2; };
    if user_count > recent_n {
        // original && !recentUsers.includes(original)
        let f_ptr: ptr = PTR_NULL();
        PTR_BYTE_ADD(f_ptr, &first_user.bytes, 0);
        let in_recent = false;
        if recent_n >= 1 {
            let l1_ptr: ptr = PTR_NULL();
            PTR_BYTE_ADD(l1_ptr, &u_last1.bytes, 0);
            if u_last1.len == first_user.len && str_eq_lit(f_ptr, first_user.len, l1_ptr, u_last1.len) { in_recent = true; };
        };
        if recent_n >= 2 {
            let l0_ptr: ptr = PTR_NULL();
            PTR_BYTE_ADD(l0_ptr, &u_last0.bytes, 0);
            if u_last0.len == first_user.len && str_eq_lit(f_ptr, first_user.len, l0_ptr, u_last0.len) { in_recent = true; };
        };
        if first_user.len > 0 && !in_recent {
            sb_append_lit(out, STR_PTR("original_request:\n"), STR_LEN("original_request:\n"));
            let oc = StrBuf { bytes: [0u8; 65536], len: 0 };
            slice_into(f_ptr, first_user.len, 4000, &oc);
            sb_append(out, &oc.bytes, oc.len);
            sb_append_lit(out, STR_PTR("\n\n"), STR_LEN("\n\n"));
        };
    };
    // `user_prompt:\n${recentUsers.join("\n---\n").slice(0, 6000) || "(empty)"}`
    sb_append_lit(out, STR_PTR("user_prompt:\n"), STR_LEN("user_prompt:\n"));
    let uj = StrBuf { bytes: [0u8; 65536], len: 0 };
    if recent_n >= 2 {
        sb_append(&uj, &u_last0.bytes, u_last0.len);
        sb_append_lit(&uj, STR_PTR("\n---\n"), STR_LEN("\n---\n"));
    };
    if recent_n >= 1 {
        sb_append(&uj, &u_last1.bytes, u_last1.len);
    };
    let ujc = StrBuf { bytes: [0u8; 65536], len: 0 };
    slice_into(&uj.bytes, uj.len, 6000, &ujc);
    if ujc.len > 0 { sb_append(out, &ujc.bytes, ujc.len); } else { sb_append_lit(out, STR_PTR("(empty)"), STR_LEN("(empty)")); };
    // `assistant_response:\n${assistantTexts.slice(-3).join("\n---\n").slice(0, 8000) || "(empty)"}`
    sb_append_lit(out, STR_PTR("\n\nassistant_response:\n"), STR_LEN("\n\nassistant_response:\n"));
    let aj = StrBuf { bytes: [0u8; 65536], len: 0 };
    let a_recent = a_count;
    if a_recent > 3 { a_recent = 3; };
    if a_recent >= 3 {
        sb_append(&aj, &a_last0.bytes, a_last0.len);
        sb_append_lit(&aj, STR_PTR("\n---\n"), STR_LEN("\n---\n"));
    };
    if a_recent >= 2 {
        sb_append(&aj, &a_last1.bytes, a_last1.len);
        sb_append_lit(&aj, STR_PTR("\n---\n"), STR_LEN("\n---\n"));
    };
    if a_recent >= 1 {
        sb_append(&aj, &a_last2.bytes, a_last2.len);
    };
    let ajc = StrBuf { bytes: [0u8; 65536], len: 0 };
    slice_into(&aj.bytes, aj.len, 8000, &ajc);
    if ajc.len > 0 { sb_append(out, &ajc.bytes, ajc.len); } else { sb_append_lit(out, STR_PTR("(empty)"), STR_LEN("(empty)")); };
    // `tool_summary:\n${toolTexts.slice(-8).join("\n").slice(0, 4000) || "(none)"}`
    sb_append_lit(out, STR_PTR("\n\ntool_summary:\n"), STR_LEN("\n\ntool_summary:\n"));
    let tj = StrBuf { bytes: [0u8; 65536], len: 0 };
    let t_slots = tool_count;
    if t_slots > 8 { t_slots = 8; };
    let off2: u64 = 0;
    for si4 in 0..t_slots {
        if si4 > 0 { sb_append_lit(&tj, STR_PTR("\n"), STR_LEN("\n")); };
        for bi4 in 0..tool_lens[si4] {
            if tj.len < 65536 { tj.bytes[tj.len] = tool_flat.bytes[off2 + bi4]; tj.len = tj.len + 1; };
        }
        off2 = off2 + tool_lens[si4];
    }
    let tjc = StrBuf { bytes: [0u8; 65536], len: 0 };
    slice_into(&tj.bytes, tj.len, 4000, &tjc);
    if tjc.len > 0 { sb_append(out, &tjc.bytes, tjc.len); } else { sb_append_lit(out, STR_PTR("(none)"), STR_LEN("(none)")); };
}

// ---------- default question sets ----------
// TS returns fresh Record<string, unknown> literals; here each
// builder writes the identical JSON object text. DEFECT: dynamic
// object — JSON text instead of a typed structure.

fn defaultJevQuestions(out: &StrBuf) -> void {
    out.len = 0;
    sb_append_lit(out, STR_PTR("{\"task_completed\":{\"type\":\"choice\",\"instructions\":\"Has the user's task been fully completed in this turn?\",\"criteria\":{\"completed\":\"Task fully completed and self-checked\",\"partial\":\"Partially done, still needs code or verification\",\"failed\":\"Blocked or produced unresolved errors\",\"needs_user_confirmation\":\"Needs further user instruction or environment confirmation\"}},\"solution_quality\":{\"type\":\"score\",\"instructions\":\"Rate the quality of the assistant solution\",\"criteria\":[\"Poor or off-track\",\"Barely usable but rough\",\"Good and accurate\",\"Excellent and thorough\"]},\"risk_or_hallucination\":{\"type\":\"noul\",\"instructions\":\"Does the turn contain hallucinated code, dangerous operations, or logic defects?\"},\"failure_cause\":{\"type\":\"choice\",\"instructions\":\"If the task is not complete, what is the primary cause? If it looks done, choose none.\",\"criteria\":{\"incomplete_implementation\":\"Code unfinished, TODOs remain, or steps skipped\",\"test_failures\":\"Tests fail or execution errors remain unresolved\",\"wrong_approach\":\"Wrong direction or misunderstood requirement\",\"missing_verification\":\"Work described but never verified (no tests, no repro)\",\"blocked_environment\":\"Blocked by environment, permissions, or upstream issues\",\"needs_user_input\":\"Needs more information or confirmation from the user\",\"none\":\"No failure; the task looks complete\"}},\"suggested_action\":{\"type\":\"choice\",\"instructions\":\"What should happen next with this turn?\",\"criteria\":{\"continue_fix\":\"Keep fixing the blocking problem and verify\",\"run_tests\":\"Run tests or reproduce first to confirm the real status\",\"revise_approach\":\"Change the approach and redo the work\",\"ask_user\":\"Ask the user for information or confirmation\",\"done_no_action\":\"Done; no further action needed\"}}}"), STR_LEN("{\"task_completed\":{\"type\":\"choice\",\"instructions\":\"Has the user's task been fully completed in this turn?\",\"criteria\":{\"completed\":\"Task fully completed and self-checked\",\"partial\":\"Partially done, still needs code or verification\",\"failed\":\"Blocked or produced unresolved errors\",\"needs_user_confirmation\":\"Needs further user instruction or environment confirmation\"}},\"solution_quality\":{\"type\":\"score\",\"instructions\":\"Rate the quality of the assistant solution\",\"criteria\":[\"Poor or off-track\",\"Barely usable but rough\",\"Good and accurate\",\"Excellent and thorough\"]},\"risk_or_hallucination\":{\"type\":\"noul\",\"instructions\":\"Does the turn contain hallucinated code, dangerous operations, or logic defects?\"},\"failure_cause\":{\"type\":\"choice\",\"instructions\":\"If the task is not complete, what is the primary cause? If it looks done, choose none.\",\"criteria\":{\"incomplete_implementation\":\"Code unfinished, TODOs remain, or steps skipped\",\"test_failures\":\"Tests fail or execution errors remain unresolved\",\"wrong_approach\":\"Wrong direction or misunderstood requirement\",\"missing_verification\":\"Work described but never verified (no tests, no repro)\",\"blocked_environment\":\"Blocked by environment, permissions, or upstream issues\",\"needs_user_input\":\"Needs more information or confirmation from the user\",\"none\":\"No failure; the task looks complete\"}},\"suggested_action\":{\"type\":\"choice\",\"instructions\":\"What should happen next with this turn?\",\"criteria\":{\"continue_fix\":\"Keep fixing the blocking problem and verify\",\"run_tests\":\"Run tests or reproduce first to confirm the real status\",\"revise_approach\":\"Change the approach and redo the work\",\"ask_user\":\"Ask the user for information or confirmation\",\"done_no_action\":\"Done; no further action needed\"}}}"));
}

fn defaultJevPlanQuestions(out: &StrBuf) -> void {
    out.len = 0;
    sb_append_lit(out, STR_PTR("{\"plan_verdict\":{\"type\":\"choice\",\"instructions\":\"Is this task plan sound for the user request?\",\"criteria\":{\"sound\":\"Covers the request with sensible, ordered steps\",\"incomplete\":\"Misses important steps or is too vague\",\"wrong_direction\":\"Misunderstands the request or heads the wrong way\",\"needs_user_input\":\"Cannot plan well without more info or confirmation\"}},\"plan_completeness\":{\"type\":\"score\",\"instructions\":\"Rate the completeness of the task plan\",\"criteria\":[\"Missing or confused\",\"Rough but workable\",\"Solid and complete\",\"Excellent with verification steps\"]},\"plan_risk\":{\"type\":\"noul\",\"instructions\":\"Does the plan include risky, destructive, or unverified steps?\"}}"), STR_LEN("{\"plan_verdict\":{\"type\":\"choice\",\"instructions\":\"Is this task plan sound for the user request?\",\"criteria\":{\"sound\":\"Covers the request with sensible, ordered steps\",\"incomplete\":\"Misses important steps or is too vague\",\"wrong_direction\":\"Misunderstands the request or heads the wrong way\",\"needs_user_input\":\"Cannot plan well without more info or confirmation\"}},\"plan_completeness\":{\"type\":\"score\",\"instructions\":\"Rate the completeness of the task plan\",\"criteria\":[\"Missing or confused\",\"Rough but workable\",\"Solid and complete\",\"Excellent with verification steps\"]},\"plan_risk\":{\"type\":\"noul\",\"instructions\":\"Does the plan include risky, destructive, or unverified steps?\"}}"));
}

fn defaultJevBriefQuestions(out: &StrBuf) -> void {
    out.len = 0;
    sb_append_lit(out, STR_PTR("{\"brief_verdict\":{\"type\":\"choice\",\"instructions\":\"Is this subagent task brief clear and executable?\",\"criteria\":{\"clear\":\"Task, scope, and expected output are clear\",\"vague\":\"Vague scope or ambiguous expected output\",\"wrong_scope\":\"Wrong decomposition level (too big, too small, or overlapping)\",\"missing_done_criteria\":\"No way to tell when the subtask is done\"}},\"brief_completeness\":{\"type\":\"score\",\"instructions\":\"Rate the completeness of the task brief\",\"criteria\":[\"Unusable\",\"Rough but workable\",\"Clear and complete\",\"Excellent with examples and criteria\"]},\"brief_risk\":{\"type\":\"noul\",\"instructions\":\"Does the brief invite risky, destructive, or out-of-scope actions?\"}}"), STR_LEN("{\"brief_verdict\":{\"type\":\"choice\",\"instructions\":\"Is this subagent task brief clear and executable?\",\"criteria\":{\"clear\":\"Task, scope, and expected output are clear\",\"vague\":\"Vague scope or ambiguous expected output\",\"wrong_scope\":\"Wrong decomposition level (too big, too small, or overlapping)\",\"missing_done_criteria\":\"No way to tell when the subtask is done\"}},\"brief_completeness\":{\"type\":\"score\",\"instructions\":\"Rate the completeness of the task brief\",\"criteria\":[\"Unusable\",\"Rough but workable\",\"Clear and complete\",\"Excellent with examples and criteria\"]},\"brief_risk\":{\"type\":\"noul\",\"instructions\":\"Does the brief invite risky, destructive, or out-of-scope actions?\"}}"));
}

fn defaultJevReportQuestions(out: &StrBuf) -> void {
    out.len = 0;
    sb_append_lit(out, STR_PTR("{\"report_verdict\":{\"type\":\"choice\",\"instructions\":\"Does this subagent completion report show the subtask is done?\",\"criteria\":{\"complete\":\"Done with verifiable evidence\",\"partial\":\"Partially done, gaps remain\",\"failed\":\"Failed or blocked\",\"unverifiable\":\"Claims done but no evidence to check\"}},\"report_quality\":{\"type\":\"score\",\"instructions\":\"Rate the quality of the completion report\",\"criteria\":[\"Useless\",\"Rough but usable\",\"Clear with evidence\",\"Excellent and thorough\"]},\"report_usable\":{\"type\":\"noul\",\"instructions\":\"Can the parent task proceed based on this report?\"}}"), STR_LEN("{\"report_verdict\":{\"type\":\"choice\",\"instructions\":\"Does this subagent completion report show the subtask is done?\",\"criteria\":{\"complete\":\"Done with verifiable evidence\",\"partial\":\"Partially done, gaps remain\",\"failed\":\"Failed or blocked\",\"unverifiable\":\"Claims done but no evidence to check\"}},\"report_quality\":{\"type\":\"score\",\"instructions\":\"Rate the quality of the completion report\",\"criteria\":[\"Useless\",\"Rough but usable\",\"Clear with evidence\",\"Excellent and thorough\"]},\"report_usable\":{\"type\":\"noul\",\"instructions\":\"Can the parent task proceed based on this report?\"}}"));
}

// ---------- verdict types ----------
// TS: JevVerdict / JevPlanVerdict (extends) / JevSubVerdict
// (extends). DEFECT: SLA has no interface extension; one merged
// struct with a kind tag carries all three shapes. Optional
// fields are (ptr, len) + has flag, or f64 + has flag.
// `raw: unknown` is the payload JSON text.
struct JevVerdict {
    kind_ptr: ptr,
    kind_len: u64,
    kind_has: bool,
    thread_id_ptr: ptr,
    thread_id_len: u64,
    turn_id_ptr: ptr,
    turn_id_len: u64,
    agent_id_ptr: ptr,
    agent_id_len: u64,
    agent_id_has: bool,
    task_name_ptr: ptr,
    task_name_len: u64,
    task_name_has: bool,
    model_ptr: ptr,
    model_len: u64,
    model_has: bool,
    choice_ptr: ptr,
    choice_len: u64,
    choice_has: bool,
    choice_confidence: f64,
    choice_confidence_has: bool,
    quality: f64,
    quality_has: bool,
    quality_confidence: f64,
    quality_confidence_has: bool,
    risk: f64,
    risk_has: bool,
    cause_ptr: ptr,
    cause_len: u64,
    cause_has: bool,
    cause_confidence: f64,
    cause_confidence_has: bool,
    action_ptr: ptr,
    action_len: u64,
    action_has: bool,
    action_confidence: f64,
    action_confidence_has: bool,
    usage_input_tokens: f64,
    usage_input_tokens_has: bool,
    usage_output_tokens: f64,
    usage_output_tokens_has: bool,
    latency_ms: f64,
    latency_ms_has: bool,
    raw_json: [u8; 32768],
    raw_json_len: u64,
    // JevPlanVerdict additions
    plan_choice_ptr: ptr,
    plan_choice_len: u64,
    plan_choice_has: bool,
    plan_confidence: f64,
    plan_confidence_has: bool,
    completeness: f64,
    completeness_has: bool,
    plan_risk: f64,
    plan_risk_has: bool,
    // JevSubVerdict additions
    sub_choice_ptr: ptr,
    sub_choice_len: u64,
    sub_choice_has: bool,
    sub_confidence: f64,
    sub_confidence_has: bool,
    sub_score: f64,
    sub_score_has: bool,
    sub_usable: f64,
    sub_usable_has: bool,
}

fn verdict_reset(v: &JevVerdict) -> void {
    v.kind_has = false;
    v.agent_id_has = false;
    v.task_name_has = false;
    v.model_has = false;
    v.choice_has = false;
    v.choice_confidence_has = false;
    v.quality_has = false;
    v.quality_confidence_has = false;
    v.risk_has = false;
    v.cause_has = false;
    v.cause_confidence_has = false;
    v.action_has = false;
    v.action_confidence_has = false;
    v.usage_input_tokens_has = false;
    v.usage_output_tokens_has = false;
    v.latency_ms_has = false;
    v.raw_json_len = 0;
    v.plan_choice_has = false;
    v.plan_confidence_has = false;
    v.completeness_has = false;
    v.plan_risk_has = false;
    v.sub_choice_has = false;
    v.sub_confidence_has = false;
    v.sub_score_has = false;
    v.sub_usable_has = false;
}

// num(value): typeof value === "number" && Number.isFinite(value)
// DEFECT: sa_json_object_get_f64 is assumed in the sa_std JSON
// surface alongside get_i64/get_bool; finite check is implicit.
fn node_num(node: u64, key_ptr: ptr, key_len: u64, out: &f64) -> bool {
    if node == 0 { return false; };
    let v: f64 = 0.0;
    if sa_json_object_get_f64(node, key_ptr, key_len, &v) != 0 { return false; };
    *out = v;
    return true;
}

fn node_str(node: u64, key_ptr: ptr, key_len: u64, out_ptr: &ptr, out_len: &u64) -> bool {
    if node == 0 { return false; };
    let p: ptr = PTR_NULL();
    let l: u64 = 0;
    if sa_json_object_get_string(node, key_ptr, key_len, &p, &l) != 0 { return false; };
    *out_ptr = p;
    *out_len = l;
    return true;
}

fn node_obj(node: u64, key_ptr: ptr, key_len: u64) -> u64 {
    if node == 0 { return 0; };
    let child: u64 = 0;
    if sa_json_object_get(node, key_ptr, key_len, &child) != 0 { return 0; };
    return child;
}

// TS: function normalizeJevChoice(value: unknown): string | undefined
// (not exported). Writes the normalized choice into out; returns
// false for undefined (non-string or empty-after-normalize).
fn normalizeJevChoice(payload_node: u64, key_ptr: ptr, key_len: u64, out: &StrBuf) -> bool {
    let p: ptr = PTR_NULL();
    let l: u64 = 0;
    if !node_str(payload_node, key_ptr, key_len, &p, &l) { return false; };
    let t_ptr: ptr = PTR_NULL();
    let t_len: u64 = 0;
    trim_into(p, l, &t_ptr, &t_len);
    // trim().toLowerCase().replace(/-/g, "_")
    out.len = 0;
    for i in 0..t_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, t_ptr, i);
        if b >= 65 && b <= 90 { b = b + 32; };
        if b == 45 { b = 95; };
        if out.len < 65536 { out.bytes[out.len] = b; out.len = out.len + 1; };
    }
    if out.len == 0 { return false; };
    let o_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(o_ptr, &out.bytes, 0);
    if str_eq_lit(o_ptr, out.len, STR_PTR("completed"), STR_LEN("completed")) || str_eq_lit(o_ptr, out.len, STR_PTR("complete"), STR_LEN("complete")) || str_eq_lit(o_ptr, out.len, STR_PTR("done"), STR_LEN("done")) {
        out.len = 0;
        sb_append_lit(out, STR_PTR("completed"), STR_LEN("completed"));
    } else if str_eq_lit(o_ptr, out.len, STR_PTR("failed"), STR_LEN("failed")) || str_eq_lit(o_ptr, out.len, STR_PTR("fail"), STR_LEN("fail")) {
        out.len = 0;
        sb_append_lit(out, STR_PTR("failed"), STR_LEN("failed"));
    } else if str_eq_lit(o_ptr, out.len, STR_PTR("needs_user_confirmation"), STR_LEN("needs_user_confirmation")) || str_eq_lit(o_ptr, out.len, STR_PTR("need_user_confirmation"), STR_LEN("need_user_confirmation")) || str_eq_lit(o_ptr, out.len, STR_PTR("needs_confirmation"), STR_LEN("needs_confirmation")) {
        out.len = 0;
        sb_append_lit(out, STR_PTR("needs_user_confirmation"), STR_LEN("needs_user_confirmation"));
    };
    // "partial" and the default branch return the norm unchanged.
    return true;
}

// Shared payload head for the three parse fns: fills model,
// usage, latency, raw and returns the answers node (0 if none).
// DEFECT: payload is `unknown` in TS; here it is JSON text that
// is parsed with sa_json_parse (a non-JSON payload yields an
// all-empty verdict, matching the TS `?? {}` fallbacks).
fn parse_head(v: &JevVerdict, payload_ptr: ptr, payload_len: u64, latency_ms: f64, latency_has: bool) -> u64 {
    v.latency_ms = latency_ms;
    v.latency_ms_has = latency_has;
    v.raw_json_len = 0;
    for i in 0..payload_len {
        if v.raw_json_len < 32768 {
            let b: u8 = 0;
            PTR_BYTE_AT(b, payload_ptr, i);
            v.raw_json[v.raw_json_len] = b;
            v.raw_json_len = v.raw_json_len + 1;
        };
    }
    let doc = sa_json_parse(payload_ptr, payload_len);
    if doc == 0 { return 0; };
    let mp: ptr = PTR_NULL();
    let ml: u64 = 0;
    if node_str(doc, STR_PTR("model"), STR_LEN("model"), &mp, &ml) {
        v.model_ptr = mp;
        v.model_len = ml;
        v.model_has = true;
    };
    let usage = node_obj(doc, STR_PTR("usage"), STR_LEN("usage"));
    let n: f64 = 0.0;
    if node_num(usage, STR_PTR("input_tokens"), STR_LEN("input_tokens"), &n) {
        v.usage_input_tokens = n;
        v.usage_input_tokens_has = true;
    };
    if node_num(usage, STR_PTR("output_tokens"), STR_LEN("output_tokens"), &n) {
        v.usage_output_tokens = n;
        v.usage_output_tokens_has = true;
    };
    return node_obj(doc, STR_PTR("answers"), STR_LEN("answers"));
}

// TS: export function parseJevVerdict(threadId, turnId, payload, latencyMs?): JevVerdict
fn parseJevVerdict(v: &JevVerdict, thread_id_ptr: ptr, thread_id_len: u64, turn_id_ptr: ptr, turn_id_len: u64, payload_ptr: ptr, payload_len: u64, latency_ms: f64, latency_has: bool) -> void {
    verdict_reset(v);
    v.thread_id_ptr = thread_id_ptr;
    v.thread_id_len = thread_id_len;
    v.turn_id_ptr = turn_id_ptr;
    v.turn_id_len = turn_id_len;
    let answers = parse_head(v, payload_ptr, payload_len, latency_ms, latency_has);
    let task = node_obj(answers, STR_PTR("task_completed"), STR_LEN("task_completed"));
    let quality = node_obj(answers, STR_PTR("solution_quality"), STR_LEN("solution_quality"));
    let risk = node_obj(answers, STR_PTR("risk_or_hallucination"), STR_LEN("risk_or_hallucination"));
    let cause = node_obj(answers, STR_PTR("failure_cause"), STR_LEN("failure_cause"));
    let action = node_obj(answers, STR_PTR("suggested_action"), STR_LEN("suggested_action"));
    let norm = StrBuf { bytes: [0u8; 65536], len: 0 };
    // choice views point into `norm`, a local — DEFECT: the view
    // must be copied by callers that keep the verdict; the copy
    // is deferred to the fix phase (all other string fields view
    // the payload text, which outlives the call).
    if normalizeJevChoice(task, STR_PTR("choice"), STR_LEN("choice"), &norm) {
        let np: ptr = PTR_NULL();
        PTR_BYTE_ADD(np, &norm.bytes, 0);
        v.choice_ptr = np;
        v.choice_len = norm.len;
        v.choice_has = true;
    };
    let n: f64 = 0.0;
    if node_num(task, STR_PTR("confidence"), STR_LEN("confidence"), &n) { v.choice_confidence = n; v.choice_confidence_has = true; };
    if node_num(quality, STR_PTR("score"), STR_LEN("score"), &n) { v.quality = n; v.quality_has = true; };
    if node_num(quality, STR_PTR("confidence"), STR_LEN("confidence"), &n) { v.quality_confidence = n; v.quality_confidence_has = true; };
    if node_num(risk, STR_PTR("noul"), STR_LEN("noul"), &n) { v.risk = n; v.risk_has = true; };
    let sp: ptr = PTR_NULL();
    let sl: u64 = 0;
    if node_str(cause, STR_PTR("choice"), STR_LEN("choice"), &sp, &sl) { v.cause_ptr = sp; v.cause_len = sl; v.cause_has = true; };
    if node_num(cause, STR_PTR("confidence"), STR_LEN("confidence"), &n) { v.cause_confidence = n; v.cause_confidence_has = true; };
    if node_str(action, STR_PTR("choice"), STR_LEN("choice"), &sp, &sl) { v.action_ptr = sp; v.action_len = sl; v.action_has = true; };
    if node_num(action, STR_PTR("confidence"), STR_LEN("confidence"), &n) { v.action_confidence = n; v.action_confidence_has = true; };
}

// ---------- labels ----------
// TS: const JEV_CAUSE_LABELS / JEV_ACTION_LABELS / JEV_PLAN_LABELS /
// JEV_BRIEF_LABELS / JEV_REPORT_LABELS: Record<string, string>.
// DEFECT: dynamic object — if-chains over the same key sets.

fn cause_label(ptr_in: ptr, len_in: u64, out: &StrBuf) -> bool {
    out.len = 0;
    if str_eq_lit(ptr_in, len_in, STR_PTR("incomplete_implementation"), STR_LEN("incomplete_implementation")) { sb_append_lit(out, STR_PTR("实现不完整"), STR_LEN("实现不完整")); return true; };
    if str_eq_lit(ptr_in, len_in, STR_PTR("test_failures"), STR_LEN("test_failures")) { sb_append_lit(out, STR_PTR("测试失败"), STR_LEN("测试失败")); return true; };
    if str_eq_lit(ptr_in, len_in, STR_PTR("wrong_approach"), STR_LEN("wrong_approach")) { sb_append_lit(out, STR_PTR("方向跑偏"), STR_LEN("方向跑偏")); return true; };
    if str_eq_lit(ptr_in, len_in, STR_PTR("missing_verification"), STR_LEN("missing_verification")) { sb_append_lit(out, STR_PTR("缺少验证"), STR_LEN("缺少验证")); return true; };
    if str_eq_lit(ptr_in, len_in, STR_PTR("blocked_environment"), STR_LEN("blocked_environment")) { sb_append_lit(out, STR_PTR("环境阻塞"), STR_LEN("环境阻塞")); return true; };
    if str_eq_lit(ptr_in, len_in, STR_PTR("needs_user_input"), STR_LEN("needs_user_input")) { sb_append_lit(out, STR_PTR("需用户补充"), STR_LEN("需用户补充")); return true; };
    if str_eq_lit(ptr_in, len_in, STR_PTR("none"), STR_LEN("none")) { sb_append_lit(out, STR_PTR("无异常"), STR_LEN("无异常")); return true; };
    return false;
}

fn action_label(ptr_in: ptr, len_in: u64, out: &StrBuf) -> bool {
    out.len = 0;
    if str_eq_lit(ptr_in, len_in, STR_PTR("continue_fix"), STR_LEN("continue_fix")) { sb_append_lit(out, STR_PTR("继续修复并验证"), STR_LEN("继续修复并验证")); return true; };
    if str_eq_lit(ptr_in, len_in, STR_PTR("run_tests"), STR_LEN("run_tests")) { sb_append_lit(out, STR_PTR("先跑测试确认现状"), STR_LEN("先跑测试确认现状")); return true; };
    if str_eq_lit(ptr_in, len_in, STR_PTR("revise_approach"), STR_LEN("revise_approach")) { sb_append_lit(out, STR_PTR("换思路重做"), STR_LEN("换思路重做")); return true; };
    if str_eq_lit(ptr_in, len_in, STR_PTR("ask_user"), STR_LEN("ask_user")) { sb_append_lit(out, STR_PTR("向用户确认"), STR_LEN("向用户确认")); return true; };
    if str_eq_lit(ptr_in, len_in, STR_PTR("done_no_action"), STR_LEN("done_no_action")) { sb_append_lit(out, STR_PTR("无需动作"), STR_LEN("无需动作")); return true; };
    return false;
}

fn plan_label(ptr_in: ptr, len_in: u64, out: &StrBuf) -> bool {
    out.len = 0;
    if str_eq_lit(ptr_in, len_in, STR_PTR("sound"), STR_LEN("sound")) { sb_append_lit(out, STR_PTR("计划可行"), STR_LEN("计划可行")); return true; };
    if str_eq_lit(ptr_in, len_in, STR_PTR("incomplete"), STR_LEN("incomplete")) { sb_append_lit(out, STR_PTR("计划不完整"), STR_LEN("计划不完整")); return true; };
    if str_eq_lit(ptr_in, len_in, STR_PTR("wrong_direction"), STR_LEN("wrong_direction")) { sb_append_lit(out, STR_PTR("方向跑偏"), STR_LEN("方向跑偏")); return true; };
    if str_eq_lit(ptr_in, len_in, STR_PTR("needs_user_input"), STR_LEN("needs_user_input")) { sb_append_lit(out, STR_PTR("需用户补充"), STR_LEN("需用户补充")); return true; };
    return false;
}

fn brief_label(ptr_in: ptr, len_in: u64, out: &StrBuf) -> bool {
    out.len = 0;
    if str_eq_lit(ptr_in, len_in, STR_PTR("clear"), STR_LEN("clear")) { sb_append_lit(out, STR_PTR("分派清晰"), STR_LEN("分派清晰")); return true; };
    if str_eq_lit(ptr_in, len_in, STR_PTR("vague"), STR_LEN("vague")) { sb_append_lit(out, STR_PTR("分派含糊"), STR_LEN("分派含糊")); return true; };
    if str_eq_lit(ptr_in, len_in, STR_PTR("wrong_scope"), STR_LEN("wrong_scope")) { sb_append_lit(out, STR_PTR("切分不当"), STR_LEN("切分不当")); return true; };
    if str_eq_lit(ptr_in, len_in, STR_PTR("missing_done_criteria"), STR_LEN("missing_done_criteria")) { sb_append_lit(out, STR_PTR("缺完成标准"), STR_LEN("缺完成标准")); return true; };
    return false;
}

fn report_label(ptr_in: ptr, len_in: u64, out: &StrBuf) -> bool {
    out.len = 0;
    if str_eq_lit(ptr_in, len_in, STR_PTR("complete"), STR_LEN("complete")) { sb_append_lit(out, STR_PTR("汇报达标"), STR_LEN("汇报达标")); return true; };
    if str_eq_lit(ptr_in, len_in, STR_PTR("partial"), STR_LEN("partial")) { sb_append_lit(out, STR_PTR("汇报部分达标"), STR_LEN("汇报部分达标")); return true; };
    if str_eq_lit(ptr_in, len_in, STR_PTR("failed"), STR_LEN("failed")) { sb_append_lit(out, STR_PTR("汇报失败"), STR_LEN("汇报失败")); return true; };
    if str_eq_lit(ptr_in, len_in, STR_PTR("unverifiable"), STR_LEN("unverifiable")) { sb_append_lit(out, STR_PTR("无法验证"), STR_LEN("无法验证")); return true; };
    return false;
}

// TS: export function jevCauseLabel(cause?: string): string
//   return (cause && JEV_CAUSE_LABELS[cause]) || cause || "";
fn jevCauseLabel(cause_ptr: ptr, cause_len: u64, cause_has: bool, out: &StrBuf) -> void {
    out.len = 0;
    if cause_has {
        let lab = StrBuf { bytes: [0u8; 65536], len: 0 };
        if cause_label(cause_ptr, cause_len, &lab) {
            sb_append(out, &lab.bytes, lab.len);
            return;
        };
        sb_append(out, cause_ptr, cause_len);
    };
}

// TS: export function jevActionLabel(action?: string): string
fn jevActionLabel(action_ptr: ptr, action_len: u64, action_has: bool, out: &StrBuf) -> void {
    out.len = 0;
    if action_has {
        let lab = StrBuf { bytes: [0u8; 65536], len: 0 };
        if action_label(action_ptr, action_len, &lab) {
            sb_append(out, &lab.bytes, lab.len);
            return;
        };
        sb_append(out, action_ptr, action_len);
    };
}

// TS: export function formatJevCauseAction(verdict: JevVerdict): string
fn formatJevCauseAction(v: &JevVerdict, out: &StrBuf) -> void {
    out.len = 0;
    let wrote = false;
    if v.cause_has && !str_eq_lit(v.cause_ptr, v.cause_len, STR_PTR("none"), STR_LEN("none")) {
        sb_append_lit(out, STR_PTR("原因："), STR_LEN("原因："));
        let lab = StrBuf { bytes: [0u8; 65536], len: 0 };
        jevCauseLabel(v.cause_ptr, v.cause_len, true, &lab);
        sb_append(out, &lab.bytes, lab.len);
        if v.cause_confidence_has {
            sb_append_lit(out, STR_PTR("("), STR_LEN("("));
            sb_append_pct(out, v.cause_confidence);
            sb_append_lit(out, STR_PTR("%)"), STR_LEN("%)"));
        };
        wrote = true;
    };
    if v.action_has && !str_eq_lit(v.action_ptr, v.action_len, STR_PTR("done_no_action"), STR_LEN("done_no_action")) {
        if wrote { sb_append_lit(out, STR_PTR(" · "), STR_LEN(" · ")); };
        sb_append_lit(out, STR_PTR("建议："), STR_LEN("建议："));
        let lab2 = StrBuf { bytes: [0u8; 65536], len: 0 };
        jevActionLabel(v.action_ptr, v.action_len, true, &lab2);
        sb_append(out, &lab2.bytes, lab2.len);
    };
}

// TS: export function formatJevVerdictLabel(verdict: JevVerdict): string
fn formatJevVerdictLabel(v: &JevVerdict, out: &StrBuf) -> void {
    out.len = 0;
    if v.choice_has && str_eq_lit(v.choice_ptr, v.choice_len, STR_PTR("completed"), STR_LEN("completed")) {
        sb_append_lit(out, STR_PTR("✅ 任务已完成"), STR_LEN("✅ 任务已完成"));
    } else if v.choice_has && str_eq_lit(v.choice_ptr, v.choice_len, STR_PTR("partial"), STR_LEN("partial")) {
        sb_append_lit(out, STR_PTR("🟡 部分完成"), STR_LEN("🟡 部分完成"));
    } else if v.choice_has && str_eq_lit(v.choice_ptr, v.choice_len, STR_PTR("failed"), STR_LEN("failed")) {
        sb_append_lit(out, STR_PTR("❌ 受阻/失败"), STR_LEN("❌ 受阻/失败"));
    } else if v.choice_has && str_eq_lit(v.choice_ptr, v.choice_len, STR_PTR("needs_user_confirmation"), STR_LEN("needs_user_confirmation")) {
        sb_append_lit(out, STR_PTR("❓ 待用户确认"), STR_LEN("❓ 待用户确认"));
    } else {
        sb_append_lit(out, STR_PTR("🧠 已评判"), STR_LEN("🧠 已评判"));
    };
    if v.choice_confidence_has {
        sb_append_lit(out, STR_PTR(" (置信度 "), STR_LEN(" (置信度 "));
        sb_append_pct(out, v.choice_confidence);
        sb_append_lit(out, STR_PTR("%)"), STR_LEN("%)"));
    };
    if v.quality_has {
        sb_append_lit(out, STR_PTR(" · 质量 "), STR_LEN(" · 质量 "));
        sb_append_f64_1dp(out, v.quality);
        sb_append_lit(out, STR_PTR("/3.0"), STR_LEN("/3.0"));
    };
    if v.risk_has {
        if v.risk >= 0.7 {
            sb_append_lit(out, STR_PTR(" · ⚠️ 高风险"), STR_LEN(" · ⚠️ 高风险"));
        } else if v.risk >= 0.35 {
            sb_append_lit(out, STR_PTR(" · 低风险"), STR_LEN(" · 低风险"));
        } else {
            sb_append_lit(out, STR_PTR(" · 无异常风险"), STR_LEN(" · 无异常风险"));
        };
    };
}

// TS: export function jevChoiceLabel(choice?: string): string
fn jevChoiceLabel(choice_ptr: ptr, choice_len: u64, choice_has: bool, out: &StrBuf) -> void {
    out.len = 0;
    if choice_has && str_eq_lit(choice_ptr, choice_len, STR_PTR("completed"), STR_LEN("completed")) {
        sb_append_lit(out, STR_PTR("任务已完成"), STR_LEN("任务已完成"));
    } else if choice_has && str_eq_lit(choice_ptr, choice_len, STR_PTR("partial"), STR_LEN("partial")) {
        sb_append_lit(out, STR_PTR("部分完成"), STR_LEN("部分完成"));
    } else if choice_has && str_eq_lit(choice_ptr, choice_len, STR_PTR("failed"), STR_LEN("failed")) {
        sb_append_lit(out, STR_PTR("受阻/失败"), STR_LEN("受阻/失败"));
    } else if choice_has && str_eq_lit(choice_ptr, choice_len, STR_PTR("needs_user_confirmation"), STR_LEN("needs_user_confirmation")) {
        sb_append_lit(out, STR_PTR("待用户确认"), STR_LEN("待用户确认"));
    } else {
        sb_append_lit(out, STR_PTR("已评判"), STR_LEN("已评判"));
    };
}

// TS: export function buildJevNudgeText(verdict, attempt?, maxAttempts?): string
// DEFECT: attempt/maxAttempts are TS numbers interpolated as-is;
// here they are integer counts.
fn buildJevNudgeText(v: &JevVerdict, attempt: u64, attempt_has: bool, max_attempts: u64, max_attempts_has: bool, out: &StrBuf) -> void {
    out.len = 0;
    sb_append_lit(out, STR_PTR("[JEV 督促] 上一轮被判定为「"), STR_LEN("[JEV 督促] 上一轮被判定为「"));
    let lab = StrBuf { bytes: [0u8; 65536], len: 0 };
    jevChoiceLabel(v.choice_ptr, v.choice_len, v.choice_has, &lab);
    sb_append(out, &lab.bytes, lab.len);
    sb_append_lit(out, STR_PTR("」"), STR_LEN("」"));
    if v.choice_confidence_has {
        sb_append_lit(out, STR_PTR("(置信度"), STR_LEN("(置信度"));
        sb_append_pct(out, v.choice_confidence);
        sb_append_lit(out, STR_PTR("%)"), STR_LEN("%)"));
    };
    let reason = StrBuf { bytes: [0u8; 65536], len: 0 };
    formatJevCauseAction(v, &reason);
    if reason.len > 0 {
        sb_append_lit(out, STR_PTR("，"), STR_LEN("，"));
        sb_append(out, &reason.bytes, reason.len);
    };
    sb_append_lit(out, STR_PTR("。\n请基于用户原始需求继续工作：处理上述原因并实际验证（跑测试或复现步骤），不要只做解释。"), STR_LEN("。\n请基于用户原始需求继续工作：处理上述原因并实际验证（跑测试或复现步骤），不要只做解释。"));
    if attempt_has && max_attempts_has {
        sb_append_lit(out, STR_PTR("\n(第 "), STR_LEN("\n(第 "));
        sb_append_u64(out, attempt);
        sb_append_lit(out, STR_PTR(" 次自动督促，共最多 "), STR_LEN(" 次自动督促，共最多 "));
        sb_append_u64(out, max_attempts);
        sb_append_lit(out, STR_PTR(" 次；请直接调用工具推进未完成的工作并验证，切勿只做文字解释。)"), STR_LEN(" 次；请直接调用工具推进未完成的工作并验证，切勿只做文字解释。)"));
    };
}

// ---------- Plan review ----------

// TS: export function buildJevPlanState(planText: string, userPrompt?: string): string
fn buildJevPlanState(plan_ptr: ptr, plan_len: u64, user_ptr: ptr, user_len: u64, user_has: bool, out: &StrBuf) -> void {
    out.len = 0;
    sb_append_lit(out, STR_PTR("user_prompt:\n"), STR_LEN("user_prompt:\n"));
    let uc = StrBuf { bytes: [0u8; 65536], len: 0 };
    if user_has { slice_into(user_ptr, user_len, 4000, &uc); };
    if uc.len > 0 { sb_append(out, &uc.bytes, uc.len); } else { sb_append_lit(out, STR_PTR("(empty)"), STR_LEN("(empty)")); };
    sb_append_lit(out, STR_PTR("\n\ntask_plan:\n"), STR_LEN("\n\ntask_plan:\n"));
    let pc = StrBuf { bytes: [0u8; 65536], len: 0 };
    slice_into(plan_ptr, plan_len, 6000, &pc);
    if pc.len > 0 { sb_append(out, &pc.bytes, pc.len); } else { sb_append_lit(out, STR_PTR("(empty)"), STR_LEN("(empty)")); };
}

// TS: export function jevPlanLabel(choice?: string): string
fn jevPlanLabel(choice_ptr: ptr, choice_len: u64, choice_has: bool, out: &StrBuf) -> void {
    out.len = 0;
    if choice_has {
        let lab = StrBuf { bytes: [0u8; 65536], len: 0 };
        if plan_label(choice_ptr, choice_len, &lab) {
            sb_append(out, &lab.bytes, lab.len);
            return;
        };
        sb_append(out, choice_ptr, choice_len);
    };
}

// TS: export function parseJevPlanVerdict(threadId, turnId, payload, latencyMs?): JevPlanVerdict
fn parseJevPlanVerdict(v: &JevVerdict, thread_id_ptr: ptr, thread_id_len: u64, turn_id_ptr: ptr, turn_id_len: u64, payload_ptr: ptr, payload_len: u64, latency_ms: f64, latency_has: bool) -> void {
    verdict_reset(v);
    v.kind_ptr = STR_PTR("plan");
    v.kind_len = STR_LEN("plan");
    v.kind_has = true;
    v.thread_id_ptr = thread_id_ptr;
    v.thread_id_len = thread_id_len;
    v.turn_id_ptr = turn_id_ptr;
    v.turn_id_len = turn_id_len;
    let answers = parse_head(v, payload_ptr, payload_len, latency_ms, latency_has);
    let verdict = node_obj(answers, STR_PTR("plan_verdict"), STR_LEN("plan_verdict"));
    let completeness = node_obj(answers, STR_PTR("plan_completeness"), STR_LEN("plan_completeness"));
    let risk = node_obj(answers, STR_PTR("plan_risk"), STR_LEN("plan_risk"));
    let sp: ptr = PTR_NULL();
    let sl: u64 = 0;
    if node_str(verdict, STR_PTR("choice"), STR_LEN("choice"), &sp, &sl) {
        v.choice_ptr = sp;
        v.choice_len = sl;
        v.choice_has = true;
        v.plan_choice_ptr = sp;
        v.plan_choice_len = sl;
        v.plan_choice_has = true;
    };
    let n: f64 = 0.0;
    if node_num(verdict, STR_PTR("confidence"), STR_LEN("confidence"), &n) {
        v.choice_confidence = n;
        v.choice_confidence_has = true;
        v.plan_confidence = n;
        v.plan_confidence_has = true;
    };
    if node_num(completeness, STR_PTR("score"), STR_LEN("score"), &n) { v.completeness = n; v.completeness_has = true; };
    if node_num(risk, STR_PTR("noul"), STR_LEN("noul"), &n) { v.plan_risk = n; v.plan_risk_has = true; };
}

// TS: export function formatJevPlanLabel(verdict: JevPlanVerdict): string
fn formatJevPlanLabel(v: &JevVerdict, out: &StrBuf) -> void {
    out.len = 0;
    sb_append_lit(out, STR_PTR("📋 计划审核："), STR_LEN("📋 计划审核："));
    if v.plan_choice_has && str_eq_lit(v.plan_choice_ptr, v.plan_choice_len, STR_PTR("sound"), STR_LEN("sound")) {
        sb_append_lit(out, STR_PTR("✅ 计划可行"), STR_LEN("✅ 计划可行"));
    } else if v.plan_choice_has && str_eq_lit(v.plan_choice_ptr, v.plan_choice_len, STR_PTR("incomplete"), STR_LEN("incomplete")) {
        sb_append_lit(out, STR_PTR("🟡 计划不完整"), STR_LEN("🟡 计划不完整"));
    } else if v.plan_choice_has && str_eq_lit(v.plan_choice_ptr, v.plan_choice_len, STR_PTR("wrong_direction"), STR_LEN("wrong_direction")) {
        sb_append_lit(out, STR_PTR("❌ 方向跑偏"), STR_LEN("❌ 方向跑偏"));
    } else if v.plan_choice_has && str_eq_lit(v.plan_choice_ptr, v.plan_choice_len, STR_PTR("needs_user_input"), STR_LEN("needs_user_input")) {
        sb_append_lit(out, STR_PTR("❓ 需用户补充"), STR_LEN("❓ 需用户补充"));
    } else {
        sb_append_lit(out, STR_PTR("📋 计划已审"), STR_LEN("📋 计划已审"));
    };
    if v.plan_confidence_has {
        sb_append_lit(out, STR_PTR(" (置信度 "), STR_LEN(" (置信度 "));
        sb_append_pct(out, v.plan_confidence);
        sb_append_lit(out, STR_PTR("%)"), STR_LEN("%)"));
    };
    if v.completeness_has {
        sb_append_lit(out, STR_PTR(" · 完整度 "), STR_LEN(" · 完整度 "));
        sb_append_f64_1dp(out, v.completeness);
        sb_append_lit(out, STR_PTR("/3.0"), STR_LEN("/3.0"));
    };
    if v.plan_risk_has {
        if v.plan_risk >= 0.7 {
            sb_append_lit(out, STR_PTR(" · ⚠️ 高风险步骤"), STR_LEN(" · ⚠️ 高风险步骤"));
        } else if v.plan_risk >= 0.35 {
            sb_append_lit(out, STR_PTR(" · 有风险步骤"), STR_LEN(" · 有风险步骤"));
        } else {
            sb_append_lit(out, STR_PTR(" · 无风险步骤"), STR_LEN(" · 无风险步骤"));
        };
    };
}

// TS: export function buildJevPlanNudgeText(verdict: JevPlanVerdict): string
fn buildJevPlanNudgeText(v: &JevVerdict, out: &StrBuf) -> void {
    out.len = 0;
    sb_append_lit(out, STR_PTR("[JEV 计划审核] 你的任务计划被判定为「"), STR_LEN("[JEV 计划审核] 你的任务计划被判定为「"));
    let lab = StrBuf { bytes: [0u8; 65536], len: 0 };
    jevPlanLabel(v.plan_choice_ptr, v.plan_choice_len, v.plan_choice_has, &lab);
    sb_append(out, &lab.bytes, lab.len);
    sb_append_lit(out, STR_PTR("」"), STR_LEN("」"));
    if v.plan_confidence_has {
        sb_append_lit(out, STR_PTR("(置信度"), STR_LEN("(置信度"));
        sb_append_pct(out, v.plan_confidence);
        sb_append_lit(out, STR_PTR("%)"), STR_LEN("%)"));
    };
    if v.completeness_has {
        sb_append_lit(out, STR_PTR("，完整度 "), STR_LEN("，完整度 "));
        sb_append_f64_1dp(out, v.completeness);
        sb_append_lit(out, STR_PTR("/3.0"), STR_LEN("/3.0"));
    };
    sb_append_lit(out, STR_PTR("。\n请先修订计划（补齐缺失步骤、纠正方向，危险步骤给出验证方式），用 update_plan 更新后再动手。"), STR_LEN("。\n请先修订计划（补齐缺失步骤、纠正方向，危险步骤给出验证方式），用 update_plan 更新后再动手。"));
}

// ---------- Collab subagent hooks ----------
// TS items are Record<string, unknown>; here the item is its
// JSON text, parsed per call. String fields are read with
// collabString (typeof string ? value : "").

// TS: export interface JevCollabBrief { agentId: string; taskName: string; brief: string }
// brief is a sliced copy (4000), so it owns storage.
struct JevCollabBrief {
    agent_id_ptr: ptr,
    agent_id_len: u64,
    task_name_ptr: ptr,
    task_name_len: u64,
    brief_bytes: [u8; 8192],
    brief_len: u64,
}

// TS: export interface JevCollabReport { agentId: string; taskName: string; status: string; report: string }
struct JevCollabReport {
    agent_id_ptr: ptr,
    agent_id_len: u64,
    task_name_ptr: ptr,
    task_name_len: u64,
    status_ptr: ptr,
    status_len: u64,
    report_bytes: [u8; 8192],
    report_len: u64,
}

fn collab_string(node: u64, key_ptr: ptr, key_len: u64, out_ptr: &ptr, out_len: &u64) -> void {
    let p: ptr = PTR_NULL();
    let l: u64 = 0;
    if node_str(node, key_ptr, key_len, &p, &l) {
        *out_ptr = p;
        *out_len = l;
    } else {
        *out_ptr = PTR_NULL();
        *out_len = 0;
    };
}

fn collab_task_name(node: u64, out_ptr: &ptr, out_len: &u64) -> void {
    let p: ptr = PTR_NULL();
    let l: u64 = 0;
    let t: ptr = PTR_NULL();
    let tl: u64 = 0;
    collab_string(node, STR_PTR("agentName"), STR_LEN("agentName"), &p, &l);
    trim_into(p, l, &t, &tl);
    if tl > 0 { *out_ptr = t; *out_len = tl; return; };
    collab_string(node, STR_PTR("description"), STR_LEN("description"), &p, &l);
    trim_into(p, l, &t, &tl);
    if tl > 0 { *out_ptr = t; *out_len = tl; return; };
    collab_string(node, STR_PTR("agentRole"), STR_LEN("agentRole"), &p, &l);
    trim_into(p, l, &t, &tl);
    if tl > 0 { *out_ptr = t; *out_len = tl; return; };
    collab_string(node, STR_PTR("tool"), STR_LEN("tool"), &p, &l);
    trim_into(p, l, &t, &tl);
    *out_ptr = t;
    *out_len = tl;
}

fn collab_agent_id(node: u64, out_ptr: &ptr, out_len: &u64) -> void {
    let p: ptr = PTR_NULL();
    let l: u64 = 0;
    let t: ptr = PTR_NULL();
    let tl: u64 = 0;
    collab_string(node, STR_PTR("agentId"), STR_LEN("agentId"), &p, &l);
    trim_into(p, l, &t, &tl);
    if tl > 0 { *out_ptr = t; *out_len = tl; return; };
    collab_string(node, STR_PTR("id"), STR_LEN("id"), &p, &l);
    trim_into(p, l, &t, &tl);
    *out_ptr = t;
    *out_len = tl;
}

// TS: export function extractJevCollabBrief(item): JevCollabBrief | null
fn extractJevCollabBrief(item_ptr: ptr, item_len: u64, out: &JevCollabBrief) -> bool {
    let doc = sa_json_parse(item_ptr, item_len);
    if doc == 0 { return false; };
    let p: ptr = PTR_NULL();
    let l: u64 = 0;
    collab_string(doc, STR_PTR("type"), STR_LEN("type"), &p, &l);
    if !str_eq_lit(p, l, STR_PTR("collabAgentToolCall"), STR_LEN("collabAgentToolCall")) { return false; };
    collab_string(doc, STR_PTR("prompt"), STR_LEN("prompt"), &p, &l);
    let t: ptr = PTR_NULL();
    let tl: u64 = 0;
    trim_into(p, l, &t, &tl);
    if tl == 0 { return false; };
    let capped = StrBuf { bytes: [0u8; 65536], len: 0 };
    slice_into(t, tl, 4000, &capped);
    let aid: ptr = PTR_NULL();
    let aidl: u64 = 0;
    collab_agent_id(doc, &aid, &aidl);
    if aidl == 0 { return false; };
    out.agent_id_ptr = aid;
    out.agent_id_len = aidl;
    collab_task_name(doc, &out.task_name_ptr, &out.task_name_len);
    out.brief_len = 0;
    for i in 0..capped.len {
        if out.brief_len < 8192 { out.brief_bytes[out.brief_len] = capped.bytes[i]; out.brief_len = out.brief_len + 1; };
    }
    return true;
}

fn collab_terminal_status(node: u64, out_ptr: &ptr, out_len: &u64) -> bool {
    let p: ptr = PTR_NULL();
    let l: u64 = 0;
    let t: ptr = PTR_NULL();
    let tl: u64 = 0;
    collab_string(node, STR_PTR("agentStatus"), STR_LEN("agentStatus"), &p, &l);
    trim_into(p, l, &t, &tl);
    let low = StrBuf { bytes: [0u8; 65536], len: 0 };
    lower_into(t, tl, &low);
    if low.len == 0 {
        collab_string(node, STR_PTR("status"), STR_LEN("status"), &p, &l);
        trim_into(p, l, &t, &tl);
        lower_into(t, tl, &low);
    };
    let lp: ptr = PTR_NULL();
    PTR_BYTE_ADD(lp, &low.bytes, 0);
    if str_eq_lit(lp, low.len, STR_PTR("completed"), STR_LEN("completed")) || str_eq_lit(lp, low.len, STR_PTR("failed"), STR_LEN("failed")) || str_eq_lit(lp, low.len, STR_PTR("interrupted"), STR_LEN("interrupted")) {
        // TS returns the normalized raw value (lowercased).
        *out_ptr = lp;
        *out_len = low.len;
        return true;
    };
    return false;
}

// Approximates the source regex on one trimmed line:
// /^(.*\s)?(completed|running|failed|interrupted|in[\s_-]?progress)\.?$/i
// DEFECT: regex — hand-rolled equivalent for the status words.
fn line_is_status_only(line_ptr: ptr, line_len: u64) -> bool {
    let low = StrBuf { bytes: [0u8; 65536], len: 0 };
    lower_into(line_ptr, line_len, &low);
    let end = low.len;
    if end > 0 && low.bytes[end - 1] == 46 { end = end - 1; };
    let lp: ptr = PTR_NULL();
    PTR_BYTE_ADD(lp, &low.bytes, 0);
    if str_eq_lit(lp, end, STR_PTR("completed"), STR_LEN("completed")) { return true; };
    if str_eq_lit(lp, end, STR_PTR("running"), STR_LEN("running")) { return true; };
    if str_eq_lit(lp, end, STR_PTR("failed"), STR_LEN("failed")) { return true; };
    if str_eq_lit(lp, end, STR_PTR("interrupted"), STR_LEN("interrupted")) { return true; };
    if str_eq_lit(lp, end, STR_PTR("in progress"), STR_LEN("in progress")) { return true; };
    if str_eq_lit(lp, end, STR_PTR("in-progress"), STR_LEN("in-progress")) { return true; };
    if str_eq_lit(lp, end, STR_PTR("in_progress"), STR_LEN("in_progress")) { return true; };
    if str_eq_lit(lp, end, STR_PTR("inprogress"), STR_LEN("inprogress")) { return true; };
    // (.*\s)? prefix: "<anything> <status word>" also matches.
    let last_space: u64 = 0;
    let has_space = false;
    for i in 0..end {
        if low.bytes[i] == 32 { last_space = i; has_space = true; };
    }
    if has_space {
        let tail_ptr: ptr = PTR_NULL();
        PTR_BYTE_ADD(tail_ptr, lp, last_space + 1);
        let tail_len = end - last_space - 1;
        if str_eq_lit(tail_ptr, tail_len, STR_PTR("completed"), STR_LEN("completed")) { return true; };
        if str_eq_lit(tail_ptr, tail_len, STR_PTR("running"), STR_LEN("running")) { return true; };
        if str_eq_lit(tail_ptr, tail_len, STR_PTR("failed"), STR_LEN("failed")) { return true; };
        if str_eq_lit(tail_ptr, tail_len, STR_PTR("interrupted"), STR_LEN("interrupted")) { return true; };
        if str_eq_lit(tail_ptr, tail_len, STR_PTR("progress"), STR_LEN("progress")) {
            // "... in progress": the word before the tail is "in"
            if last_space >= 2 && low.bytes[last_space - 2] == 105 && low.bytes[last_space - 1] == 110 { return true; };
        };
    };
    return false;
}

/** Placeholder summaries ("Explore completed") are not reports — auditing
 * them would cry "unverifiable" on every turn. Only judge substance. */
// TS: function collabReportIsSubstantive(report: string): boolean
fn collabReportIsSubstantive(report_ptr: ptr, report_len: u64) -> bool {
    let any_line = false;
    let start: u64 = 0;
    let i: u64 = 0;
    while i <= report_len {
        if i == report_len || report_len == 0 || (i < report_len && byte_at(report_ptr, i) == 10) {
            let seg_ptr: ptr = PTR_NULL();
            PTR_BYTE_ADD(seg_ptr, report_ptr, start);
            let t: ptr = PTR_NULL();
            let tl: u64 = 0;
            trim_into(seg_ptr, i - start, &t, &tl);
            if tl > 0 {
                any_line = true;
                if tl > 60 { return true; };
                if !line_is_status_only(t, tl) { return true; };
            };
            start = i + 1;
        };
        i = i + 1;
        if report_len == 0 { break; };
    }
    if !any_line { return false; };
    return false;
}

fn byte_at(p: ptr, i: u64) -> u8 {
    let b: u8 = 0;
    PTR_BYTE_AT(b, p, i);
    return b;
}

// TS: export function extractJevCollabReport(item): JevCollabReport | null
fn extractJevCollabReport(item_ptr: ptr, item_len: u64, out: &JevCollabReport) -> bool {
    let doc = sa_json_parse(item_ptr, item_len);
    if doc == 0 { return false; };
    let p: ptr = PTR_NULL();
    let l: u64 = 0;
    collab_string(doc, STR_PTR("type"), STR_LEN("type"), &p, &l);
    if !str_eq_lit(p, l, STR_PTR("collabAgentToolCall"), STR_LEN("collabAgentToolCall")) { return false; };
    let st: ptr = PTR_NULL();
    let stl: u64 = 0;
    if !collab_terminal_status(doc, &st, &stl) { return false; };
    let aid: ptr = PTR_NULL();
    let aidl: u64 = 0;
    collab_agent_id(doc, &aid, &aidl);
    if aidl == 0 { return false; };
    collab_string(doc, STR_PTR("output"), STR_LEN("output"), &p, &l);
    let t: ptr = PTR_NULL();
    let tl: u64 = 0;
    trim_into(p, l, &t, &tl);
    if tl == 0 {
        // DEFECT: the agentsStates fallback (Object.values over a
        // dynamic object, joining each state's `message`) is not
        // reproduced: the sa_std JSON surface has no key
        // enumeration. Reports carried only in agentsStates are
        // missed until the fix phase adds enumeration.
        return false;
    };
    if !collabReportIsSubstantive(t, tl) { return false; };
    out.agent_id_ptr = aid;
    out.agent_id_len = aidl;
    collab_task_name(doc, &out.task_name_ptr, &out.task_name_len);
    out.status_ptr = st;
    out.status_len = stl;
    let capped = StrBuf { bytes: [0u8; 65536], len: 0 };
    slice_into(t, tl, 6000, &capped);
    out.report_len = 0;
    for i in 0..capped.len {
        if out.report_len < 8192 { out.report_bytes[out.report_len] = capped.bytes[i]; out.report_len = out.report_len + 1; };
    }
    return true;
}

// ---------- Subagent brief & report review ----------

// TS: export function buildJevBriefState(taskName: string, brief: string): string
fn buildJevBriefState(task_ptr: ptr, task_len: u64, brief_ptr: ptr, brief_len: u64, out: &StrBuf) -> void {
    out.len = 0;
    sb_append_lit(out, STR_PTR("task_name:\n"), STR_LEN("task_name:\n"));
    let tc = StrBuf { bytes: [0u8; 65536], len: 0 };
    slice_into(task_ptr, task_len, 200, &tc);
    if tc.len > 0 { sb_append(out, &tc.bytes, tc.len); } else { sb_append_lit(out, STR_PTR("(empty)"), STR_LEN("(empty)")); };
    sb_append_lit(out, STR_PTR("\n\ntask_brief:\n"), STR_LEN("\n\ntask_brief:\n"));
    let bc = StrBuf { bytes: [0u8; 65536], len: 0 };
    slice_into(brief_ptr, brief_len, 4000, &bc);
    if bc.len > 0 { sb_append(out, &bc.bytes, bc.len); } else { sb_append_lit(out, STR_PTR("(empty)"), STR_LEN("(empty)")); };
}

// TS: export function buildJevReportState(taskName: string, status: string, report: string): string
fn buildJevReportState(task_ptr: ptr, task_len: u64, status_ptr: ptr, status_len: u64, report_ptr: ptr, report_len: u64, out: &StrBuf) -> void {
    out.len = 0;
    sb_append_lit(out, STR_PTR("task_name:\n"), STR_LEN("task_name:\n"));
    let tc = StrBuf { bytes: [0u8; 65536], len: 0 };
    slice_into(task_ptr, task_len, 200, &tc);
    if tc.len > 0 { sb_append(out, &tc.bytes, tc.len); } else { sb_append_lit(out, STR_PTR("(empty)"), STR_LEN("(empty)")); };
    sb_append_lit(out, STR_PTR("\n\nagent_status:\n"), STR_LEN("\n\nagent_status:\n"));
    if status_len > 0 { sb_append(out, status_ptr, status_len); } else { sb_append_lit(out, STR_PTR("(unknown)"), STR_LEN("(unknown)")); };
    sb_append_lit(out, STR_PTR("\n\nfinal_report:\n"), STR_LEN("\n\nfinal_report:\n"));
    let rc = StrBuf { bytes: [0u8; 65536], len: 0 };
    slice_into(report_ptr, report_len, 6000, &rc);
    if rc.len > 0 { sb_append(out, &rc.bytes, rc.len); } else { sb_append_lit(out, STR_PTR("(empty)"), STR_LEN("(empty)")); };
}

// TS: function parseJevSubVerdict(kind, verdictKey, scoreKey, usableKey, ...)
// DEFECT: kind is the string literal union "brief" | "report";
// keys are (ptr, len) pairs.
fn parseJevSubVerdict(v: &JevVerdict, kind_ptr: ptr, kind_len: u64, verdict_key_ptr: ptr, verdict_key_len: u64, score_key_ptr: ptr, score_key_len: u64, usable_key_ptr: ptr, usable_key_len: u64, thread_id_ptr: ptr, thread_id_len: u64, turn_id_ptr: ptr, turn_id_len: u64, agent_id_ptr: ptr, agent_id_len: u64, task_name_ptr: ptr, task_name_len: u64, payload_ptr: ptr, payload_len: u64, latency_ms: f64, latency_has: bool) -> void {
    verdict_reset(v);
    v.kind_ptr = kind_ptr;
    v.kind_len = kind_len;
    v.kind_has = true;
    v.thread_id_ptr = thread_id_ptr;
    v.thread_id_len = thread_id_len;
    v.turn_id_ptr = turn_id_ptr;
    v.turn_id_len = turn_id_len;
    v.agent_id_ptr = agent_id_ptr;
    v.agent_id_len = agent_id_len;
    v.agent_id_has = true;
    v.task_name_ptr = task_name_ptr;
    v.task_name_len = task_name_len;
    v.task_name_has = true;
    let answers = parse_head(v, payload_ptr, payload_len, latency_ms, latency_has);
    let verdict = node_obj(answers, verdict_key_ptr, verdict_key_len);
    let score = node_obj(answers, score_key_ptr, score_key_len);
    let usable = node_obj(answers, usable_key_ptr, usable_key_len);
    let sp: ptr = PTR_NULL();
    let sl: u64 = 0;
    if node_str(verdict, STR_PTR("choice"), STR_LEN("choice"), &sp, &sl) { v.sub_choice_ptr = sp; v.sub_choice_len = sl; v.sub_choice_has = true; };
    let n: f64 = 0.0;
    if node_num(verdict, STR_PTR("confidence"), STR_LEN("confidence"), &n) { v.sub_confidence = n; v.sub_confidence_has = true; };
    // subScore: num(score.score ?? score.noul)
    if node_num(score, STR_PTR("score"), STR_LEN("score"), &n) { v.sub_score = n; v.sub_score_has = true; } else if node_num(score, STR_PTR("noul"), STR_LEN("noul"), &n) { v.sub_score = n; v.sub_score_has = true; };
    // subUsable: num(usable.noul ?? usable.score)
    if node_num(usable, STR_PTR("noul"), STR_LEN("noul"), &n) { v.sub_usable = n; v.sub_usable_has = true; } else if node_num(usable, STR_PTR("score"), STR_LEN("score"), &n) { v.sub_usable = n; v.sub_usable_has = true; };
}

// TS: export function parseJevBriefVerdict(...): JevSubVerdict
fn parseJevBriefVerdict(v: &JevVerdict, thread_id_ptr: ptr, thread_id_len: u64, turn_id_ptr: ptr, turn_id_len: u64, agent_id_ptr: ptr, agent_id_len: u64, task_name_ptr: ptr, task_name_len: u64, payload_ptr: ptr, payload_len: u64, latency_ms: f64, latency_has: bool) -> void {
    parseJevSubVerdict(v, STR_PTR("brief"), STR_LEN("brief"), STR_PTR("brief_verdict"), STR_LEN("brief_verdict"), STR_PTR("brief_completeness"), STR_LEN("brief_completeness"), STR_PTR("brief_risk"), STR_LEN("brief_risk"), thread_id_ptr, thread_id_len, turn_id_ptr, turn_id_len, agent_id_ptr, agent_id_len, task_name_ptr, task_name_len, payload_ptr, payload_len, latency_ms, latency_has);
}

// TS: export function parseJevReportVerdict(...): JevSubVerdict
fn parseJevReportVerdict(v: &JevVerdict, thread_id_ptr: ptr, thread_id_len: u64, turn_id_ptr: ptr, turn_id_len: u64, agent_id_ptr: ptr, agent_id_len: u64, task_name_ptr: ptr, task_name_len: u64, payload_ptr: ptr, payload_len: u64, latency_ms: f64, latency_has: bool) -> void {
    parseJevSubVerdict(v, STR_PTR("report"), STR_LEN("report"), STR_PTR("report_verdict"), STR_LEN("report_verdict"), STR_PTR("report_quality"), STR_LEN("report_quality"), STR_PTR("report_usable"), STR_LEN("report_usable"), thread_id_ptr, thread_id_len, turn_id_ptr, turn_id_len, agent_id_ptr, agent_id_len, task_name_ptr, task_name_len, payload_ptr, payload_len, latency_ms, latency_has);
}

// TS: export function formatJevSubLabel(verdict: JevSubVerdict): string
fn formatJevSubLabel(v: &JevVerdict, out: &StrBuf) -> void {
    out.len = 0;
    let is_brief = v.kind_has && str_eq_lit(v.kind_ptr, v.kind_len, STR_PTR("brief"), STR_LEN("brief"));
    let lab = StrBuf { bytes: [0u8; 65536], len: 0 };
    let found = false;
    if v.sub_choice_has {
        if is_brief { found = brief_label(v.sub_choice_ptr, v.sub_choice_len, &lab); } else { found = report_label(v.sub_choice_ptr, v.sub_choice_len, &lab); };
    };
    if is_brief { sb_append_lit(out, STR_PTR("📤 分派审核："), STR_LEN("📤 分派审核：")); } else { sb_append_lit(out, STR_PTR("📥 汇报审核："), STR_LEN("📥 汇报审核：")); };
    if found {
        sb_append(out, &lab.bytes, lab.len);
    } else {
        sb_append_lit(out, STR_PTR("已评"), STR_LEN("已评"));
    };
    if v.sub_confidence_has {
        sb_append_lit(out, STR_PTR(" (置信度 "), STR_LEN(" (置信度 "));
        sb_append_pct(out, v.sub_confidence);
        sb_append_lit(out, STR_PTR("%)"), STR_LEN("%)"));
    };
    if v.sub_score_has {
        sb_append_lit(out, STR_PTR(" · "), STR_LEN(" · "));
        sb_append_f64_1dp(out, v.sub_score);
        sb_append_lit(out, STR_PTR("/3.0"), STR_LEN("/3.0"));
    };
    if v.task_name_has && v.task_name_len > 0 {
        sb_append_lit(out, STR_PTR(" · "), STR_LEN(" · "));
        let nc = StrBuf { bytes: [0u8; 65536], len: 0 };
        slice_into(v.task_name_ptr, v.task_name_len, 24, &nc);
        sb_append(out, &nc.bytes, nc.len);
    };
}

// TS: export function buildJevSubNudgeText(verdict: JevSubVerdict): string
fn buildJevSubNudgeText(v: &JevVerdict, out: &StrBuf) -> void {
    out.len = 0;
    let is_brief = v.kind_has && str_eq_lit(v.kind_ptr, v.kind_len, STR_PTR("brief"), STR_LEN("brief"));
    let lab = StrBuf { bytes: [0u8; 65536], len: 0 };
    let found = false;
    if v.sub_choice_has {
        if is_brief { found = brief_label(v.sub_choice_ptr, v.sub_choice_len, &lab); } else { found = report_label(v.sub_choice_ptr, v.sub_choice_len, &lab); };
    };
    // name: verdict.taskName || verdict.agentId.slice(0, 8)
    let name = StrBuf { bytes: [0u8; 65536], len: 0 };
    if v.task_name_has && v.task_name_len > 0 {
        sb_append(&name, v.task_name_ptr, v.task_name_len);
    } else if v.agent_id_has {
        slice_into(v.agent_id_ptr, v.agent_id_len, 8, &name);
    };
    if is_brief {
        sb_append_lit(out, STR_PTR("[JEV 分派审核] 子任务「"), STR_LEN("[JEV 分派审核] 子任务「"));
        sb_append(out, &name.bytes, name.len);
        sb_append_lit(out, STR_PTR("」的 brief 被判定为「"), STR_LEN("」的 brief 被判定为「"));
        if found { sb_append(out, &lab.bytes, lab.len); } else { sb_append_lit(out, STR_PTR("不达标"), STR_LEN("不达标")); };
        sb_append_lit(out, STR_PTR("」。\n请用 send_message 向该子任务补充清晰的范围、输入输出与完成标准；若切分不当则 close 后重新分派。"), STR_LEN("」。\n请用 send_message 向该子任务补充清晰的范围、输入输出与完成标准；若切分不当则 close 后重新分派。"));
    } else {
        sb_append_lit(out, STR_PTR("[JEV 汇报审核] 子任务「"), STR_LEN("[JEV 汇报审核] 子任务「"));
        sb_append(out, &name.bytes, name.len);
        sb_append_lit(out, STR_PTR("」的汇报被判定为「"), STR_LEN("」的汇报被判定为「"));
        if found { sb_append(out, &lab.bytes, lab.len); } else { sb_append_lit(out, STR_PTR("不达标"), STR_LEN("不达标")); };
        sb_append_lit(out, STR_PTR("」。\n请用 send_message 追问缺失的证据与结果；若其已失败或阻塞，把剩余工作收回自己完成，不要直接总结。"), STR_LEN("」。\n请用 send_message 追问缺失的证据与结果；若其已失败或阻塞，把剩余工作收回自己完成，不要直接总结。"));
    };
}
