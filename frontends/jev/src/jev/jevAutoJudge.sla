// DEFECT: JevConfig is owned by @cxu/sdk-frontend (sdk-frontend
// unit's jevConfig). This view mirrors only the fields this
// module reads (enabled, apiKey, baseUrl, model, providerId,
// groupId, bridgeProtocol, reviewBrief, reviewReport, planReview).
struct JevConfigView {
    enabled: bool,
    api_key_ptr: ptr,
    api_key_len: u64,
    base_url_ptr: ptr,
    base_url_len: u64,
    model_ptr: ptr,
    model_len: u64,
    provider_id_ptr: ptr,
    provider_id_len: u64,
    provider_id_has: bool,
    group_id_ptr: ptr,
    group_id_len: u64,
    group_id_has: bool,
    bridge_protocol_ptr: ptr,
    bridge_protocol_len: u64,
    bridge_protocol_has: bool,
    review_brief: bool,
    review_report: bool,
    plan_review_ptr: ptr,
    plan_review_len: u64,
}

// Projects the SDK JevConfig (loaded by loadJevConfig) into the
// (ptr, len) view the handlers consume. String fields become
// views into cfg's JTxt buffers (cfg outlives the view at every
// call site); the two enum fields take their TS string forms
// (bridgeProtocol: 0="openai-chat", 1="openai-responses";
// planReview: 0="off", 1="created", 2="every" — the numbering
// of sdk-frontend jevConfig's normalize functions). provider /
// group has flags are true (the TS fields are non-optional
// strings); downstream trim+length gates reproduce the source's
// `|| undefined` drops.
fn jev_config_view(cfg: &JevConfig, view: &JevConfigView) -> void {
    view.enabled = cfg.enabled;
    let akp: ptr = PTR_NULL();
    PTR_BYTE_ADD(akp, &cfg.apiKey.bytes, 0);
    view.api_key_ptr = akp;
    view.api_key_len = cfg.apiKey.len;
    let bup: ptr = PTR_NULL();
    PTR_BYTE_ADD(bup, &cfg.baseUrl.bytes, 0);
    view.base_url_ptr = bup;
    view.base_url_len = cfg.baseUrl.len;
    let mop: ptr = PTR_NULL();
    PTR_BYTE_ADD(mop, &cfg.model.bytes, 0);
    view.model_ptr = mop;
    view.model_len = cfg.model.len;
    let pvp: ptr = PTR_NULL();
    PTR_BYTE_ADD(pvp, &cfg.providerId.bytes, 0);
    view.provider_id_ptr = pvp;
    view.provider_id_len = cfg.providerId.len;
    view.provider_id_has = true;
    let gpp: ptr = PTR_NULL();
    PTR_BYTE_ADD(gpp, &cfg.groupId.bytes, 0);
    view.group_id_ptr = gpp;
    view.group_id_len = cfg.groupId.len;
    view.group_id_has = true;
    if cfg.bridgeProtocol == 1 {
        view.bridge_protocol_ptr = STR_PTR("openai-responses");
        view.bridge_protocol_len = STR_LEN("openai-responses");
    } else {
        view.bridge_protocol_ptr = STR_PTR("openai-chat");
        view.bridge_protocol_len = STR_LEN("openai-chat");
    };
    view.bridge_protocol_has = true;
    view.review_brief = cfg.reviewBrief;
    view.review_report = cfg.reviewReport;
    if cfg.planReview == 1 {
        view.plan_review_ptr = STR_PTR("created");
        view.plan_review_len = STR_LEN("created");
    } else {
        if cfg.planReview == 2 {
            view.plan_review_ptr = STR_PTR("every");
            view.plan_review_len = STR_LEN("every");
        } else {
            view.plan_review_ptr = STR_PTR("off");
            view.plan_review_len = STR_LEN("off");
        };
    };
}

// DEFECT: window.dispatchEvent(new CustomEvent(...)) — there is
// no DOM event bus. Handlers record the event they would have
// dispatched in this out record instead: kind 0 = none,
// 1 = JEV_RESULT_EVENT (verdict), 2 = JEV_ERROR_EVENT (detail).
struct JevEmittedEvent {
    kind: u64,
    verdict: JevVerdict,
    err_thread_id_ptr: ptr,
    err_thread_id_len: u64,
    err_turn_id_ptr: ptr,
    err_turn_id_len: u64,
    err_message: [u8; 1024],
    err_message_len: u64,
}

fn emit_error(emitted: &JevEmittedEvent, thread_ptr: ptr, thread_len: u64, turn_ptr: ptr, turn_len: u64, msg_ptr: ptr, msg_len: u64) -> void {
    emitted.kind = 2;
    emitted.err_thread_id_ptr = thread_ptr;
    emitted.err_thread_id_len = thread_len;
    emitted.err_turn_id_ptr = turn_ptr;
    emitted.err_turn_id_len = turn_len;
    emitted.err_message_len = 0;
    for i in 0..msg_len {
        if emitted.err_message_len < 1024 {
            let b: u8 = 0;
            PTR_BYTE_AT(b, msg_ptr, i);
            emitted.err_message[emitted.err_message_len] = b;
            emitted.err_message_len = emitted.err_message_len + 1;
        };
    }
}

// TS: export interface JevAutoJudgeScope { getActiveThreadId?: () => string | null | undefined }
// DEFECT: a function-typed field — carried as an opaque getter
// id resolved through the declared host hook below.
struct JevAutoJudgeScope {
    getter_id: u64,
    getter_has: bool,
}

// DEFECT (host seam, registered): the scope's getActiveThreadId
// is a callback into web-host state; SLA has no host-callback
// registration surface yet, so no provider can be registered.
// Until host wiring lands this provider reports "no active
// thread" (is_null), and shouldAcceptJevVerdictForThread then
// applies its TS null rule (events carrying a threadId are out
// of scope). Explicit documented behavior, not a silent stub:
// the seam lights up when the host registers a real getter
// behind getter_id.
fn cxu_jev_scope_active_thread(getter_id: u64, out_ptr: &ptr, out_len: &u64, out_is_null: &bool) -> void {
    *out_ptr = PTR_NULL();
    *out_len = 0;
    *out_is_null = true;
}

// TS: function jevHasCredential(config): boolean
fn jevHasCredential(config: &JevConfigView) -> bool {
    let t: ptr = PTR_NULL();
    let tl: u64 = 0;
    trim_into(config.api_key_ptr, config.api_key_len, &t, &tl);
    if tl > 0 { return true; };
    if config.provider_id_has {
        trim_into(config.provider_id_ptr, config.provider_id_len, &t, &tl);
        if tl > 0 { return true; };
    };
    return false;
}

// Builds JevEvaluateParams the way all three handlers do in the
// source (identical evaluateJev argument blocks) and calls it.
// Returns evaluateJev's status (0 = ok).
fn call_evaluate(detail_token_ptr: ptr, detail_token_len: u64, detail_token_is_null: bool, config: &JevConfigView, state_text_ptr: ptr, state_text_len: u64, questions_json_ptr: ptr, questions_json_len: u64, result: &JevProxySuccess, err: &JsonBuf) -> i32 {
    let params = JevEvaluateParams {
        session_token_ptr: detail_token_ptr, session_token_len: detail_token_len, session_token_is_null: detail_token_is_null,
        base_url_ptr: config.base_url_ptr, base_url_len: config.base_url_len, base_url_has: true,
        api_key_ptr: PTR_NULL(), api_key_len: 0,
        model_ptr: config.model_ptr, model_len: config.model_len, model_has: true,
        provider_id_ptr: PTR_NULL(), provider_id_len: 0, provider_id_has: false,
        group_id_ptr: PTR_NULL(), group_id_len: 0, group_id_has: false,
        bridge_protocol_ptr: PTR_NULL(), bridge_protocol_len: 0, bridge_protocol_has: false,
        state_ptr: state_text_ptr, state_len: state_text_len,
        questions: JevQuestionMap { json_bytes: [0u8; 16384], json_len: 0 },
    };
    // apiKey: config.apiKey.trim()
    trim_into(config.api_key_ptr, config.api_key_len, &params.api_key_ptr, &params.api_key_len);
    // providerId: config.providerId?.trim() || undefined
    if config.provider_id_has {
        let t: ptr = PTR_NULL();
        let tl: u64 = 0;
        trim_into(config.provider_id_ptr, config.provider_id_len, &t, &tl);
        if tl > 0 { params.provider_id_ptr = t; params.provider_id_len = tl; params.provider_id_has = true; };
    };
    if config.group_id_has {
        let t2: ptr = PTR_NULL();
        let tl2: u64 = 0;
        trim_into(config.group_id_ptr, config.group_id_len, &t2, &tl2);
        if tl2 > 0 { params.group_id_ptr = t2; params.group_id_len = tl2; params.group_id_has = true; };
    };
    // bridgeProtocol: config.bridgeProtocol || undefined (no trim)
    if config.bridge_protocol_has && config.bridge_protocol_len > 0 {
        params.bridge_protocol_ptr = config.bridge_protocol_ptr;
        params.bridge_protocol_len = config.bridge_protocol_len;
        params.bridge_protocol_has = true;
    };
    for i in 0..questions_json_len {
        if params.questions.json_len < 16384 {
            let b: u8 = 0;
            PTR_BYTE_AT(b, questions_json_ptr, i);
            params.questions.json_bytes[params.questions.json_len] = b;
            params.questions.json_len = params.questions.json_len + 1;
        };
    }
    return evaluateJev(&params, result, err);
}

// TS: async function handleTurnEvent(event, scope?): Promise<void>
// DEFECT: async + DOM Event — synchronous, detail passed
// directly, the would-be dispatched event lands in `emitted`.
// console.warn skip lines are kept as comments (no console).
fn handleTurnEvent(state: &JevAutoJudgeState, detail: &JevTurnEventDetail, emitted: &JevEmittedEvent) -> void {
    emitted.kind = 0;
    // readDetail(event): detail fields are typed strings here, so
    // the typeof checks of the source always pass.
    let thread_ptr = detail.snapshot.thread_id_ptr;
    let thread_len = detail.snapshot.thread_id_len;
    let turn_ptr = detail.snapshot.turn_id_ptr;
    let turn_len = detail.snapshot.turn_id_len;
    // 触发侧也必须按当前 threadId 过滤（见源注释）。
    if state.scope_registered {
        let scope = JevAutoJudgeScope { getter_id: state.scope_getter_id, getter_has: true };
        if !isJevEventInScope(&scope, thread_ptr, thread_len, true) {
            // console.warn(`[jev] skip auto-judge: thread not active (thread=${...} turn=${...})`);
            return;
        };
    };
    let config = JevConfigView { enabled: false, api_key_ptr: PTR_NULL(), api_key_len: 0, base_url_ptr: PTR_NULL(), base_url_len: 0, model_ptr: PTR_NULL(), model_len: 0, provider_id_ptr: PTR_NULL(), provider_id_len: 0, provider_id_has: false, group_id_ptr: PTR_NULL(), group_id_len: 0, group_id_has: false, bridge_protocol_ptr: PTR_NULL(), bridge_protocol_len: 0, bridge_protocol_has: false, review_brief: false, review_report: false, plan_review_ptr: PTR_NULL(), plan_review_len: 0 };
    // DEFECT (host seam, registered): TS loadJevConfig() reads
    // localStorage; the stored JSON text has no registered
    // SLA provider yet, so the SDK loader runs with
    // has_raw=false (mirrors getItem -> null: defaults).
    let cfg = JevConfig { enabled: false, upstream: 0, baseUrl: JTxt { bytes: [0u8; 8192], len: 0 }, apiKey: JTxt { bytes: [0u8; 8192], len: 0 }, model: JTxt { bytes: [0u8; 8192], len: 0 }, providerId: JTxt { bytes: [0u8; 8192], len: 0 }, groupId: JTxt { bytes: [0u8; 8192], len: 0 }, bridgeProtocol: 0, autoNudge: false, maxNudges: 2, planReview: 0, reviewBrief: false, reviewReport: false, allowActiveTools: true };
    loadJevConfig(PTR_NULL(), 0, false, &cfg);
    jev_config_view(&cfg, &config);
    if !config.enabled {
        // console.warn(`[jev] skip auto-judge: disabled (...)`);
        return;
    };
    if !jevHasCredential(&config) {
        // console.warn(`[jev] skip auto-judge: no credential (...)`);
        return;
    };
    if set_has(&state.judged_turns, turn_ptr, turn_len) || set_has(&state.in_flight, turn_ptr, turn_len) {
        // console.warn(`[jev] skip auto-judge: turn already judged/in-flight (...)`);
        return;
    };
    set_add(&state.in_flight, turn_ptr, turn_len);
    let state_text = StrBuf { bytes: [0u8; 65536], len: 0 };
    buildJevState(&detail.snapshot, &state_text);
    let questions = StrBuf { bytes: [0u8; 65536], len: 0 };
    defaultJevQuestions(&questions);
    let result = JevProxySuccess { data_json_bytes: [0u8; 32768], data_json_len: 0, latency_ms: 0.0, latency_ms_has: false };
    let err = JsonBuf { bytes: [0u8; 32768], len: 0 };
    let st_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(st_ptr, &state_text.bytes, 0);
    let q_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(q_ptr, &questions.bytes, 0);
    let rc = call_evaluate(detail.session_token_ptr, detail.session_token_len, detail.session_token_is_null, &config, st_ptr, state_text.len, q_ptr, questions.len, &result, &err);
    if rc == 0 {
        let __hp2: ptr = PTR_NULL();
        PTR_BYTE_ADD(__hp2, &result.data_json_bytes, 0);
        parseJevVerdict(&emitted.verdict, thread_ptr, thread_len, turn_ptr, turn_len, __hp2, result.data_json_len, result.latency_ms, result.latency_ms_has);
        emitted.kind = 1;
        set_add(&state.judged_turns, turn_ptr, turn_len);
        if state.judged_turns.len > 500 {
            set_evict_oldest(&state.judged_turns);
        };
    } else {
        // catch: dispatch JEV_ERROR_EVENT { threadId, turnId,
        // message: error instanceof Error ? error.message : "JEV evaluate failed" }
        if err.len > 0 {
            let ep: ptr = PTR_NULL();
            PTR_BYTE_ADD(ep, &err.bytes, 0);
            emit_error(emitted, thread_ptr, thread_len, turn_ptr, turn_len, ep, err.len);
        } else {
            emit_error(emitted, thread_ptr, thread_len, turn_ptr, turn_len, STR_PTR("JEV evaluate failed"), STR_LEN("JEV evaluate failed"));
        };
    };
    // finally: inFlight.delete(detail.turnId)
    set_delete(&state.in_flight, turn_ptr, turn_len);
}

// TS: export function dispatchJevTurnCompleted(detail): void
// DEFECT: window.dispatchEvent — direct handler invocation
// (the try/catch around dispatch is a no-op here).
fn dispatchJevTurnCompleted(state: &JevAutoJudgeState, detail: &JevTurnEventDetail, emitted: &JevEmittedEvent) -> void {
    handleTurnEvent(state, detail, emitted);
}

// TS: async function handleSubEvent(event, scope?): Promise<void>
// DEFECT: async + DOM Event — see handleTurnEvent.
fn handleSubEvent(state: &JevAutoJudgeState, detail: &JevSubEventDetail, emitted: &JevEmittedEvent) -> void {
    emitted.kind = 0;
    let is_brief = str_eq_lit(detail.kind_ptr, detail.kind_len, STR_PTR("brief"), STR_LEN("brief"));
    let is_report = str_eq_lit(detail.kind_ptr, detail.kind_len, STR_PTR("report"), STR_LEN("report"));
    if !is_brief && !is_report { return; };
    if detail.agent_id_len == 0 || detail.thread_id_len == 0 || detail.turn_id_len == 0 { return; };
    if state.scope_registered {
        let scope = JevAutoJudgeScope { getter_id: state.scope_getter_id, getter_has: true };
        if !isJevEventInScope(&scope, detail.thread_id_ptr, detail.thread_id_len, true) { return; };
    };
    let config = JevConfigView { enabled: false, api_key_ptr: PTR_NULL(), api_key_len: 0, base_url_ptr: PTR_NULL(), base_url_len: 0, model_ptr: PTR_NULL(), model_len: 0, provider_id_ptr: PTR_NULL(), provider_id_len: 0, provider_id_has: false, group_id_ptr: PTR_NULL(), group_id_len: 0, group_id_has: false, bridge_protocol_ptr: PTR_NULL(), bridge_protocol_len: 0, bridge_protocol_has: false, review_brief: false, review_report: false, plan_review_ptr: PTR_NULL(), plan_review_len: 0 };
    // DEFECT (host seam, registered): TS loadJevConfig() reads
    // localStorage; the stored JSON text has no registered
    // SLA provider yet, so the SDK loader runs with
    // has_raw=false (mirrors getItem -> null: defaults).
    let cfg = JevConfig { enabled: false, upstream: 0, baseUrl: JTxt { bytes: [0u8; 8192], len: 0 }, apiKey: JTxt { bytes: [0u8; 8192], len: 0 }, model: JTxt { bytes: [0u8; 8192], len: 0 }, providerId: JTxt { bytes: [0u8; 8192], len: 0 }, groupId: JTxt { bytes: [0u8; 8192], len: 0 }, bridgeProtocol: 0, autoNudge: false, maxNudges: 2, planReview: 0, reviewBrief: false, reviewReport: false, allowActiveTools: true };
    loadJevConfig(PTR_NULL(), 0, false, &cfg);
    jev_config_view(&cfg, &config);
    if !config.enabled { return; };
    if !jevHasCredential(&config) { return; };
    if is_brief {
        if !config.review_brief { return; };
        let t: ptr = PTR_NULL();
        let tl: u64 = 0;
        if detail.brief_has { trim_into(detail.brief_ptr, detail.brief_len, &t, &tl); };
        if tl == 0 { return; };
        if set_has(&state.reviewed_briefs, detail.agent_id_ptr, detail.agent_id_len) { return; };
        set_add(&state.reviewed_briefs, detail.agent_id_ptr, detail.agent_id_len);
    } else {
        if !config.review_report { return; };
        let t2: ptr = PTR_NULL();
        let tl2: u64 = 0;
        if detail.report_has { trim_into(detail.report_ptr, detail.report_len, &t2, &tl2); };
        if tl2 == 0 { return; };
        if set_has(&state.reviewed_reports, detail.agent_id_ptr, detail.agent_id_len) { return; };
        set_add(&state.reviewed_reports, detail.agent_id_ptr, detail.agent_id_len);
    };
    let state_text = StrBuf { bytes: [0u8; 65536], len: 0 };
    let task_ptr = detail.task_name_ptr;
    let task_len = detail.task_name_len;
    if !detail.task_name_has { task_len = 0; };
    if is_brief {
        let bp = detail.brief_ptr;
        let bl = detail.brief_len;
        if !detail.brief_has { bl = 0; };
        buildJevBriefState(task_ptr, task_len, bp, bl, &state_text);
    } else {
        let sp = detail.status_ptr;
        let sl = detail.status_len;
        if !detail.status_has { sl = 0; };
        let rp = detail.report_ptr;
        let rl = detail.report_len;
        if !detail.report_has { rl = 0; };
        buildJevReportState(task_ptr, task_len, sp, sl, rp, rl, &state_text);
    };
    let questions = StrBuf { bytes: [0u8; 65536], len: 0 };
    if is_brief { defaultJevBriefQuestions(&questions); } else { defaultJevReportQuestions(&questions); };
    let result = JevProxySuccess { data_json_bytes: [0u8; 32768], data_json_len: 0, latency_ms: 0.0, latency_ms_has: false };
    let err = JsonBuf { bytes: [0u8; 32768], len: 0 };
    let st_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(st_ptr, &state_text.bytes, 0);
    let q_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(q_ptr, &questions.bytes, 0);
    let token_is_null = true;
    if detail.session_token_has && !detail.session_token_is_null { token_is_null = false; };
    let rc = call_evaluate(detail.session_token_ptr, detail.session_token_len, token_is_null, &config, st_ptr, state_text.len, q_ptr, questions.len, &result, &err);
    if rc == 0 {
        if is_brief {
            let __hp2: ptr = PTR_NULL();
            PTR_BYTE_ADD(__hp2, &result.data_json_bytes, 0);
            parseJevBriefVerdict(&emitted.verdict, detail.thread_id_ptr, detail.thread_id_len, detail.turn_id_ptr, detail.turn_id_len, detail.agent_id_ptr, detail.agent_id_len, task_ptr, task_len, __hp2, result.data_json_len, result.latency_ms, result.latency_ms_has);
        } else {
            let __hp2: ptr = PTR_NULL();
            PTR_BYTE_ADD(__hp2, &result.data_json_bytes, 0);
            parseJevReportVerdict(&emitted.verdict, detail.thread_id_ptr, detail.thread_id_len, detail.turn_id_ptr, detail.turn_id_len, detail.agent_id_ptr, detail.agent_id_len, task_ptr, task_len, __hp2, result.data_json_len, result.latency_ms, result.latency_ms_has);
        };
        emitted.kind = 1;
    } else {
        if is_brief { set_delete(&state.reviewed_briefs, detail.agent_id_ptr, detail.agent_id_len); } else { set_delete(&state.reviewed_reports, detail.agent_id_ptr, detail.agent_id_len); };
        if err.len > 0 {
            let ep: ptr = PTR_NULL();
            PTR_BYTE_ADD(ep, &err.bytes, 0);
            emit_error(emitted, detail.thread_id_ptr, detail.thread_id_len, detail.turn_id_ptr, detail.turn_id_len, ep, err.len);
        } else {
            emit_error(emitted, detail.thread_id_ptr, detail.thread_id_len, detail.turn_id_ptr, detail.turn_id_len, STR_PTR("JEV subagent review failed"), STR_LEN("JEV subagent review failed"));
        };
    };
}

// TS: export function dispatchJevSubagent(detail): void
// DEFECT: window.dispatchEvent — direct handler invocation.
fn dispatchJevSubagent(state: &JevAutoJudgeState, detail: &JevSubEventDetail, emitted: &JevEmittedEvent) -> void {
    handleSubEvent(state, detail, emitted);
}

// TS: async function handlePlanEvent(event, scope?): Promise<void>
// DEFECT: async + DOM Event — see handleTurnEvent.
fn handlePlanEvent(state: &JevAutoJudgeState, detail: &JevPlanEventDetail, emitted: &JevEmittedEvent) -> void {
    emitted.kind = 0;
    if state.scope_registered {
        let scope = JevAutoJudgeScope { getter_id: state.scope_getter_id, getter_has: true };
        if !isJevEventInScope(&scope, detail.thread_id_ptr, detail.thread_id_len, true) { return; };
    };
    // if (!detail.planText?.trim()) return;
    let pt: ptr = PTR_NULL();
    let ptl: u64 = 0;
    if detail.plan_text_has { trim_into(detail.plan_text_ptr, detail.plan_text_len, &pt, &ptl); };
    if ptl == 0 { return; };
    let config = JevConfigView { enabled: false, api_key_ptr: PTR_NULL(), api_key_len: 0, base_url_ptr: PTR_NULL(), base_url_len: 0, model_ptr: PTR_NULL(), model_len: 0, provider_id_ptr: PTR_NULL(), provider_id_len: 0, provider_id_has: false, group_id_ptr: PTR_NULL(), group_id_len: 0, group_id_has: false, bridge_protocol_ptr: PTR_NULL(), bridge_protocol_len: 0, bridge_protocol_has: false, review_brief: false, review_report: false, plan_review_ptr: PTR_NULL(), plan_review_len: 0 };
    // DEFECT (host seam, registered): TS loadJevConfig() reads
    // localStorage; the stored JSON text has no registered
    // SLA provider yet, so the SDK loader runs with
    // has_raw=false (mirrors getItem -> null: defaults).
    let cfg = JevConfig { enabled: false, upstream: 0, baseUrl: JTxt { bytes: [0u8; 8192], len: 0 }, apiKey: JTxt { bytes: [0u8; 8192], len: 0 }, model: JTxt { bytes: [0u8; 8192], len: 0 }, providerId: JTxt { bytes: [0u8; 8192], len: 0 }, groupId: JTxt { bytes: [0u8; 8192], len: 0 }, bridgeProtocol: 0, autoNudge: false, maxNudges: 2, planReview: 0, reviewBrief: false, reviewReport: false, allowActiveTools: true };
    loadJevConfig(PTR_NULL(), 0, false, &cfg);
    jev_config_view(&cfg, &config);
    if !config.enabled { return; };
    if str_eq_lit(config.plan_review_ptr, config.plan_review_len, STR_PTR("off"), STR_LEN("off")) { return; };
    if !jevHasCredential(&config) { return; };
    // const planText = detail.planText.trim().slice(0, 6000);
    let plan_text = StrBuf { bytes: [0u8; 65536], len: 0 };
    slice_into(pt, ptl, 6000, &plan_text);
    let pp: ptr = PTR_NULL();
    PTR_BYTE_ADD(pp, &plan_text.bytes, 0);
    if str_eq_lit(config.plan_review_ptr, config.plan_review_len, STR_PTR("created"), STR_LEN("created")) {
        // Audit once per thread.
        if set_has(&state.reviewed_plan_threads, detail.thread_id_ptr, detail.thread_id_len) { return; };
        set_add(&state.reviewed_plan_threads, detail.thread_id_ptr, detail.thread_id_len);
    } else {
        // "every": skip identical repeats.
        let prev: ptr = PTR_NULL();
        let prev_len: u64 = 0;
        if map_get(&state.reviewed_plan_content, detail.thread_id_ptr, detail.thread_id_len, &prev, &prev_len) {
            if prev_len == plan_text.len {
                let same = true;
                for i in 0..prev_len {
                    let b: u8 = 0;
                    PTR_BYTE_AT(b, prev, i);
                    if plan_text.bytes[i] != b { same = false; break; };
                }
                if same { return; };
            };
        };
        map_set(&state.reviewed_plan_content, detail.thread_id_ptr, detail.thread_id_len, pp, plan_text.len);
    };
    let state_text = StrBuf { bytes: [0u8; 65536], len: 0 };
    buildJevPlanState(pp, plan_text.len, detail.user_prompt_ptr, detail.user_prompt_len, detail.user_prompt_has, &state_text);
    let questions = StrBuf { bytes: [0u8; 65536], len: 0 };
    defaultJevPlanQuestions(&questions);
    let result = JevProxySuccess { data_json_bytes: [0u8; 32768], data_json_len: 0, latency_ms: 0.0, latency_ms_has: false };
    let err = JsonBuf { bytes: [0u8; 32768], len: 0 };
    let st_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(st_ptr, &state_text.bytes, 0);
    let q_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(q_ptr, &questions.bytes, 0);
    let token_is_null = true;
    if detail.session_token_has && !detail.session_token_is_null { token_is_null = false; };
    let rc = call_evaluate(detail.session_token_ptr, detail.session_token_len, token_is_null, &config, st_ptr, state_text.len, q_ptr, questions.len, &result, &err);
    if rc == 0 {
        let __hp2: ptr = PTR_NULL();
        PTR_BYTE_ADD(__hp2, &result.data_json_bytes, 0);
        parseJevPlanVerdict(&emitted.verdict, detail.thread_id_ptr, detail.thread_id_len, detail.turn_id_ptr, detail.turn_id_len, __hp2, result.data_json_len, result.latency_ms, result.latency_ms_has);
        emitted.kind = 1;
    } else {
        set_delete(&state.reviewed_plan_threads, detail.thread_id_ptr, detail.thread_id_len);
        map_delete(&state.reviewed_plan_content, detail.thread_id_ptr, detail.thread_id_len);
        if err.len > 0 {
            let ep: ptr = PTR_NULL();
            PTR_BYTE_ADD(ep, &err.bytes, 0);
            emit_error(emitted, detail.thread_id_ptr, detail.thread_id_len, detail.turn_id_ptr, detail.turn_id_len, ep, err.len);
        } else {
            emit_error(emitted, detail.thread_id_ptr, detail.thread_id_len, detail.turn_id_ptr, detail.turn_id_len, STR_PTR("JEV plan review failed"), STR_LEN("JEV plan review failed"));
        };
    };
}

// TS: export function dispatchJevPlanCreated(detail): void
// DEFECT: window.dispatchEvent — direct handler invocation.
fn dispatchJevPlanCreated(state: &JevAutoJudgeState, detail: &JevPlanEventDetail, emitted: &JevEmittedEvent) -> void {
    handlePlanEvent(state, detail, emitted);
}

// TS: export function startJevAutoJudgeListener(scope?): () => void
// DEFECT: window.addEventListener has no counterpart; the scope
// is registered on the state and handlers consult it directly.
// The returned id stands in for the unsubscribe closure; call
// stopJevAutoJudgeListener to remove.
fn startJevAutoJudgeListener(state: &JevAutoJudgeState, scope: &JevAutoJudgeScope, scope_has: bool) -> u64 {
    if scope_has && scope.getter_has {
        state.scope_getter_id = scope.getter_id;
        state.scope_registered = true;
    } else {
        state.scope_registered = false;
    };
    return 1;
}

fn stopJevAutoJudgeListener(state: &JevAutoJudgeState, registration_id: u64) -> void {
    if registration_id == 1 { state.scope_registered = false; };
}

// TS: export function resetJevAutoJudgeCache(): void
fn resetJevAutoJudgeCache(state: &JevAutoJudgeState) -> void {
    set_clear(&state.judged_turns);
    set_clear(&state.reviewed_plan_threads);
    map_clear(&state.reviewed_plan_content);
    set_clear(&state.reviewed_briefs);
    set_clear(&state.reviewed_reports);
    set_clear(&state.auto_nudged_turns);
    set_clear(&state.in_flight);
}

// TS: export function claimJevAutoNudgeTurn(turnId: string): boolean
fn claimJevAutoNudgeTurn(state: &JevAutoJudgeState, turn_ptr: ptr, turn_len: u64) -> bool {
    if turn_len == 0 { return false; };
    if set_has(&state.auto_nudged_turns, turn_ptr, turn_len) { return false; };
    set_add(&state.auto_nudged_turns, turn_ptr, turn_len);
    if state.auto_nudged_turns.len > 500 {
        set_evict_oldest(&state.auto_nudged_turns);
    };
    return true;
}

// TS: export function resetJevAutoNudgeDedup(): void
fn resetJevAutoNudgeDedup(state: &JevAutoJudgeState) -> void {
    set_clear(&state.auto_nudged_turns);
}

// TS: export interface JevNudgeDecision { ... }
struct JevNudgeDecision {
    choice_ptr: ptr,
    choice_len: u64,
    choice_has: bool,
    running: bool,
    auto_nudge: bool,
    consecutive_failures: u64,
    max_nudges: u64,
}

// TS: export function shouldAutoNudge(decision: JevNudgeDecision): boolean
fn shouldAutoNudge(decision: &JevNudgeDecision) -> bool {
    if !decision.auto_nudge || decision.running { return false; };
    let is_failed = decision.choice_has && str_eq_lit(decision.choice_ptr, decision.choice_len, STR_PTR("failed"), STR_LEN("failed"));
    let is_partial = decision.choice_has && str_eq_lit(decision.choice_ptr, decision.choice_len, STR_PTR("partial"), STR_LEN("partial"));
    if !is_failed && !is_partial { return false; };
    // consecutiveFailures < min(JEV_MAX_AUTO_NUDGES, max(1, maxNudges))
    let cap = JEV_MAX_AUTO_NUDGES;
    let mn = decision.max_nudges;
    if mn < 1 { mn = 1; };
    if mn < cap { cap = mn; };
    return decision.consecutive_failures < cap;
}

// TS: export function shouldAcceptJevVerdictForThread(
//   activeThreadId: string | null | undefined, verdictThreadId: unknown): boolean
// DEFECT: `unknown` target — (ptr, len) + is_string flag.
fn shouldAcceptJevVerdictForThread(active_ptr: ptr, active_len: u64, active_is_string: bool, target_ptr: ptr, target_len: u64, target_is_string: bool) -> bool {
    let cur_len: u64 = 0;
    if active_is_string { cur_len = active_len; };
    let tgt_len: u64 = 0;
    if target_is_string { tgt_len = target_len; };
    if cur_len > 0 && tgt_len > 0 {
        if cur_len != tgt_len { return false; };
        for i in 0..cur_len {
            let a: u8 = 0;
            let b: u8 = 0;
            PTR_BYTE_AT(a, active_ptr, i);
            PTR_BYTE_AT(b, target_ptr, i);
            if a != b { return false; };
        }
        return true;
    };
    if cur_len == 0 && tgt_len > 0 { return false; };
    return true;
}

// TS: export function isJevEventInScope(scope, threadId): boolean
// DEFECT: threadId is `unknown` in TS — (ptr, len) + is_string.
fn isJevEventInScope(scope: &JevAutoJudgeScope, thread_ptr: ptr, thread_len: u64, thread_is_string: bool) -> bool {
    // TS: scope === undefined -> true. A SLA &param is always a
    // real scope; the undefined case is gated by the callers
    // (state.scope_registered), so only the getter check remains.
    if !scope.getter_has { return true; };
    let ap: ptr = PTR_NULL();
    let al: u64 = 0;
    let a_null = true;
    cxu_jev_scope_active_thread(scope.getter_id, &ap, &al, &a_null);
    let a_is_string = !a_null;
    return shouldAcceptJevVerdictForThread(ap, al, a_is_string, thread_ptr, thread_len, thread_is_string);
}
