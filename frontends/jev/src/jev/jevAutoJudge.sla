// Converted 1:1 from frontends/jev/src/jev/jevAutoJudge.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "./jevClient.sla"
@import "./jevConfig.sla"
@import "./jevQuestions.sla"
@import "sa_std/ptr.sa"
@import "sa_std/string.sa"

// TS: export const JEV_TURN_EVENT = "jev:turn-completed"; etc.
// DEFECT: SLA has no module-level const exports; event names are
// accessor functions writing the literal into out params.
fn JEV_TURN_EVENT(out_ptr: &ptr, out_len: &u64) -> void { *out_ptr = STR_PTR("jev:turn-completed"); *out_len = STR_LEN("jev:turn-completed"); }
fn JEV_PLAN_EVENT(out_ptr: &ptr, out_len: &u64) -> void { *out_ptr = STR_PTR("jev:plan-created"); *out_len = STR_LEN("jev:plan-created"); }
fn JEV_SUB_EVENT(out_ptr: &ptr, out_len: &u64) -> void { *out_ptr = STR_PTR("jev:subagent-tool"); *out_len = STR_LEN("jev:subagent-tool"); }
fn JEV_RESULT_EVENT(out_ptr: &ptr, out_len: &u64) -> void { *out_ptr = STR_PTR("jev:result"); *out_len = STR_LEN("jev:result"); }
fn JEV_ERROR_EVENT(out_ptr: &ptr, out_len: &u64) -> void { *out_ptr = STR_PTR("jev:error"); *out_len = STR_LEN("jev:error"); }

// JEV_MAX_AUTO_NUDGES is a const defined by the SDK jevConfig
// (sdk-frontend/src/jevConfig.sla, value 1000), re-exported
// through ./jevConfig.sla and imported above; the bulk pass's
// placeholder accessor of the same name (which returned 0) is
// removed in the fix phase and call sites use the const.

// ---------- module state ----------
// TS module-level Set<string>/Map<string,string> singletons.
// DEFECT: SLA has no module-level mutable state; the sets live
// in an explicit state struct threaded through every function.
// Fixed capacities replace unbounded sets (overflow inserts are
// dropped); FIFO eviction exists only where the source evicts.

struct StringSet {
    entries: [[u8; 128]; 512],
    lens: [u64; 512],
    len: u64,
}

fn set_has(set: &StringSet, p: ptr, l: u64) -> bool {
    for i in 0..set.len {
        if set.lens[i] == l {
            let same = true;
            for j in 0..l {
                let a: u8 = 0;
                PTR_BYTE_AT(a, p, j);
                if set.entries[i][j] != a { same = false; break; };
            }
            if same { return true; };
        };
    }
    return false;
}

fn set_add(set: &StringSet, p: ptr, l: u64) -> void {
    if set_has(set, p, l) { return; };
    if set.len >= 512 { return; };
    let slot = set.len;
    let n = l;
    if n > 128 { n = 128; };
    for j in 0..n {
        let a: u8 = 0;
        PTR_BYTE_AT(a, p, j);
        set.entries[slot][j] = a;
    }
    set.lens[slot] = n;
    set.len = set.len + 1;
}

fn set_delete(set: &StringSet, p: ptr, l: u64) -> void {
    for i in 0..set.len {
        if set.lens[i] == l {
            let same = true;
            for j in 0..l {
                let a: u8 = 0;
                PTR_BYTE_AT(a, p, j);
                if set.entries[i][j] != a { same = false; break; };
            }
            if same {
                // shift down (insertion order = FIFO order)
                let k = i;
                while k + 1 < set.len {
                    for j2 in 0..128 { set.entries[k][j2] = set.entries[k + 1][j2]; }
                    set.lens[k] = set.lens[k + 1];
                    k = k + 1;
                }
                set.len = set.len - 1;
                return;
            };
        };
    }
}

fn set_clear(set: &StringSet) -> void { set.len = 0; }

// FIFO eviction used by judgedTurns / autoNudgedTurns (> 500).
fn set_evict_oldest(set: &StringSet) -> void {
    if set.len == 0 { return; };
    let k: u64 = 0;
    while k + 1 < set.len {
        for j in 0..128 { set.entries[k][j] = set.entries[k + 1][j]; }
        set.lens[k] = set.lens[k + 1];
        k = k + 1;
    }
    set.len = set.len - 1;
}

// reviewedPlanContent: Map<string, string> (values up to 6000).
struct PlanContentMap {
    keys: [[u8; 128]; 64],
    key_lens: [u64; 64],
    vals: [[u8; 6144]; 64],
    val_lens: [u64; 64],
    len: u64,
}

fn map_get(map: &PlanContentMap, kp: ptr, kl: u64, out_ptr: &ptr, out_len: &u64) -> bool {
    for i in 0..map.len {
        if map.key_lens[i] == kl {
            let same = true;
            for j in 0..kl {
                let a: u8 = 0;
                PTR_BYTE_AT(a, kp, j);
                if map.keys[i][j] != a { same = false; break; };
            }
            if same {
                let vp: ptr = PTR_NULL();
                PTR_BYTE_ADD(vp, &map.vals[i], 0);
                *out_ptr = vp;
                *out_len = map.val_lens[i];
                return true;
            };
        };
    }
    return false;
}

fn map_set(map: &PlanContentMap, kp: ptr, kl: u64, vp: ptr, vl: u64) -> void {
    for i in 0..map.len {
        if map.key_lens[i] == kl {
            let same = true;
            for j in 0..kl {
                let a: u8 = 0;
                PTR_BYTE_AT(a, kp, j);
                if map.keys[i][j] != a { same = false; break; };
            }
            if same {
                let n = vl;
                if n > 6144 { n = 6144; };
                for j2 in 0..n {
                    let b: u8 = 0;
                    PTR_BYTE_AT(b, vp, j2);
                    map.vals[i][j2] = b;
                }
                map.val_lens[i] = n;
                return;
            };
        };
    }
    if map.len >= 64 { return; };
    let slot = map.len;
    let kn = kl;
    if kn > 128 { kn = 128; };
    for j in 0..kn {
        let a: u8 = 0;
        PTR_BYTE_AT(a, kp, j);
        map.keys[slot][j] = a;
    }
    map.key_lens[slot] = kn;
    let vn = vl;
    if vn > 6144 { vn = 6144; };
    for j3 in 0..vn {
        let b2: u8 = 0;
        PTR_BYTE_AT(b2, vp, j3);
        map.vals[slot][j3] = b2;
    }
    map.val_lens[slot] = vn;
    map.len = map.len + 1;
}

fn map_delete(map: &PlanContentMap, kp: ptr, kl: u64) -> void {
    for i in 0..map.len {
        if map.key_lens[i] == kl {
            let same = true;
            for j in 0..kl {
                let a: u8 = 0;
                PTR_BYTE_AT(a, kp, j);
                if map.keys[i][j] != a { same = false; break; };
            }
            if same {
                let k = i;
                while k + 1 < map.len {
                    for j2 in 0..128 { map.keys[k][j2] = map.keys[k + 1][j2]; }
                    map.key_lens[k] = map.key_lens[k + 1];
                    for j3 in 0..6144 { map.vals[k][j3] = map.vals[k + 1][j3]; }
                    map.val_lens[k] = map.val_lens[k + 1];
                    k = k + 1;
                }
                map.len = map.len - 1;
                return;
            };
        };
    }
}

fn map_clear(map: &PlanContentMap) -> void { map.len = 0; }

struct JevAutoJudgeState {
    reviewed_briefs: StringSet,
    reviewed_reports: StringSet,
    reviewed_plan_threads: StringSet,
    reviewed_plan_content: PlanContentMap,
    judged_turns: StringSet,
    in_flight: StringSet,
    auto_nudged_turns: StringSet,
    // Registered listener scope (see startJevAutoJudgeListener).
    scope_getter_id: u64,
    scope_registered: bool,
}

