// Converted 1:1 from frontends/jev/src/jev/JevSettingsDialog.tsx (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
// SAX: no behavior counterpart — useState/useEffect hooks, the
// async relay-directory load, handleSave/handleTest and all
// setDraft handlers are structure + bind comments only. All
// visible strings come from the host TranslateFn t() — kept as
// bind comments with their keys. DEFECT: SAX: no behavior counterpart
// Imports in source: react (useEffect, useState), @mui/material
// (Alert, Box, Button, CircularProgress, Dialog, DialogActions,
// DialogContent, DialogTitle, FormControlLabel, IconButton,
// InputAdornment, MenuItem, Stack, Switch, TextField,
// Typography), @mui/icons-material (Close, Visibility,
// VisibilityOff), ./jevClient (testJevConnection — converted in
// jevClient.sla), ./jevConfig (constants + normalizers + JevConfig
// type — SDK unit via the jevConfig.sla shim),
// @cxu/sdk-frontend types (ProjectRelayProvider, TranslateFn).
// DEFECT: MUI components/icons have no SAX counterparts; tag
// names preserved verbatim.

<JevSettingsDialog open={boolean} sessionToken={string?} config={JevConfig} onChange={function} onClose={function} t={TranslateFn} listRelayDirectory={function}>
  <!-- state: draft: JevConfig = useState(config) -->
  <!-- state: showKey: boolean = useState(false) -->
  <!-- state: testing: boolean = useState(false) -->
  <!-- state: testResult: string = useState('') -->
  <!-- state: relayDirectory: ProjectRelayProvider[] = useState([]) -->
  <!-- state: relayLoading: boolean = useState(false) -->
  <!-- state: relayError: string = useState('') -->
  <!-- effect: useEffect(() => { if (open) { setDraft(config); setTestResult(''); setTesting(false); } }, [open, config]) -->
  <!-- effect: useEffect(() => { if (!open) return; if (!sessionToken) { setRelayDirectory([]); return; } let cancelled = false; setRelayLoading(true); setRelayError(''); void listRelayDirectory(sessionToken).then(...).catch(...).finally(...); return () => { cancelled = true; }; }, [open, sessionToken, t]) — DEFECT: async/Promise + cancellation flag -->
  <!-- bind: const activeProvider = relayDirectory.find((entry) => entry.providerId === draft.providerId) ?? null -->
  <!-- bind: const textGroups = (activeProvider?.groups ?? []).filter((group) => group.kind === 'text' && group.enabled) -->
  <!-- bind: const activeGroup = textGroups.find((group) => group.groupId === draft.groupId) ?? textGroups[0] ?? null -->
  <!-- bind: const groupModels = activeGroup && activeGroup.models.length > 0 ? activeGroup.models : (activeProvider?.models ?? []) -->
  <!-- bind: const modelOptions = Array.from(new Set([...(draft.model.trim() ? [draft.model.trim()] : []), ...groupModels, ...(activeProvider?.defaultModel ? [activeProvider.defaultModel] : [])])).slice(0, 100) -->
  <!-- bind: const normalizedUpstream = normalizeJevUpstreamProvider(draft.upstream, draft.baseUrl) -->
  <!-- bind: const baseUrlFallback = normalizedUpstream === 'cloudflare' ? CLOUDFLARE_JEV_DEFAULT_BASE_URL : JEV_DEFAULT_BASE_URL -->
  <!-- bind: const modelFallback = normalizedUpstream === 'cloudflare' ? CLOUDFLARE_JEV_DEFAULT_MODEL : JEV_DEFAULT_MODEL -->
  <!-- bind: const handleSave = () => { onChange({ enabled: draft.enabled, upstream: normalizedUpstream, baseUrl: draft.baseUrl.trim() || baseUrlFallback, apiKey: draft.apiKey.trim(), model: draft.model.trim() || modelFallback, providerId: draft.providerId.trim(), groupId: (draft.groupId.trim() || activeGroup?.groupId || '').trim(), bridgeProtocol: normalizeJevBridgeProtocol(draft.bridgeProtocol), autoNudge: draft.autoNudge, maxNudges: normalizeMaxJevNudges(draft.maxNudges), planReview: draft.planReview, reviewBrief: draft.reviewBrief, reviewReport: draft.reviewReport, allowActiveTools: draft.allowActiveTools }); onClose(); } -->
  <!-- bind: const handleTest = async () => { ... await testJevConnection({...}) ... setTestResult(`200 OK (${ms} ms)...`) } — DEFECT: async -->

  <Dialog open={open} onClose={onClose} fullWidth={true} maxWidth="sm" data-testid="jev-settings-dialog">
    <DialogTitle sx="{ display: 'flex', alignItems: 'center', gap: 1 }">
      <Box sx="{ flex: 1 }">
        <!-- bind: t('jev.settings.title') -->
      </Box>
      <IconButton size="small" aria-label={t('jev.settings.close')} onClick={onClose}>
        <CloseIcon fontSize="small" />
      </IconButton>
    </DialogTitle>
    <DialogContent dividers={true}>
      <Stack spacing={2}>
        <FormControlLabel label={t('jev.settings.enabledLabel')}>
          <!-- control -->
          <Switch checked={draft.enabled} onChange="{(event) => setDraft((current) => ({ ...current, enabled: event.target.checked }))}" data-testid="jev-enabled-switch" />
        </FormControlLabel>
        <TextField select={true} fullWidth={true} size="small" label={t('jev.settings.upstreamLabel')} value={normalizedUpstream} onChange="{(event) => { const next = normalizeJevUpstreamProvider(event.target.value, undefined, 'jev'); setDraft((current) => next === 'cloudflare' ? { ...current, upstream: next, baseUrl: isCloudflareJevBaseUrl(current.baseUrl) && current.baseUrl.trim() ? current.baseUrl : CLOUDFLARE_JEV_DEFAULT_BASE_URL, model: current.model.trim() && current.model.trim() !== JEV_DEFAULT_MODEL ? current.model : CLOUDFLARE_JEV_DEFAULT_MODEL } : { ...current, upstream: next, baseUrl: !isCloudflareJevBaseUrl(current.baseUrl) && current.baseUrl.trim() ? current.baseUrl : JEV_DEFAULT_BASE_URL, model: current.model.trim() && current.model.trim() !== CLOUDFLARE_JEV_DEFAULT_MODEL ? current.model : JEV_DEFAULT_MODEL }); }}" helperText={t('jev.settings.upstreamHelper')} data-testid="jev-upstream-select">
          <MenuItem value="jev">
            <!-- bind: t('jev.settings.upstreamJev') -->
          </MenuItem>
          <MenuItem value="cloudflare">
            <!-- bind: t('jev.settings.upstreamCloudflare') -->
          </MenuItem>
        </TextField>
        <TextField fullWidth={true} size="small" label="Base URL" value={draft.baseUrl} placeholder={baseUrlFallback} onChange="{(event) => setDraft((current) => ({ ...current, baseUrl: event.target.value }))}" helperText={t('jev.settings.baseUrlHelper')} data-testid="jev-baseurl-input" />
        <TextField fullWidth={true} size="small" label="API Key" type={showKey ? 'text' : 'password'} value={draft.apiKey} placeholder={normalizedUpstream === 'cloudflare' ? t('jev.settings.apiKeyPlaceholderCloudflare') : 'apikey_...'} onChange="{(event) => setDraft((current) => ({ ...current, apiKey: event.target.value }))}" data-testid="jev-apikey-input">
          <!-- slotProps.input.endAdornment -->
          <InputAdornment position="end">
            <IconButton size="small" aria-label={showKey ? t('jev.settings.hideKey') : t('jev.settings.showKey')} onClick="{() => setShowKey((v) => !v)}">
              <!-- bind: showKey ? <VisibilityOffIcon fontSize='small' /> : <VisibilityIcon fontSize='small' /> -->
            </IconButton>
          </InputAdornment>
          <!-- /slotProps -->
        </TextField>
        <TextField fullWidth={true} size="small" label="模型名称" value={draft.model} placeholder={modelFallback} onChange="{(event) => setDraft((current) => ({ ...current, model: event.target.value }))}" data-testid="jev-model-input" helperText={t('jev.settings.modelHelper')} />
        <Typography variant="subtitle2" sx="{ mt: 1 }">
          <!-- bind: t('jev.settings.bridgeTitle') -->
        </Typography>
        <Typography variant="caption" color="text.secondary">
          <!-- bind: t('jev.settings.bridgeDesc') -->
        </Typography>
        <TextField select={true} fullWidth={true} size="small" label={relayLoading ? t('jev.settings.relayLoadingLabel') : t('jev.settings.relayLabel')} value={draft.providerId} onChange="{(event) => { const nextProviderId = event.target.value; const nextProvider = relayDirectory.find((entry) => entry.providerId === nextProviderId) ?? null; const nextGroups = (nextProvider?.groups ?? []).filter((group) => group.kind === 'text' && group.enabled); const nextGroup = nextGroups[0] ?? null; const nextModel = nextGroup?.models[0] ?? nextProvider?.defaultModel ?? nextProvider?.models[0] ?? draft.model; setDraft((current) => ({ ...current, providerId: nextProviderId, groupId: nextGroup?.groupId ?? '', model: (nextModel ?? current.model).trim() || current.model })); }}" helperText={relayError || (sessionToken ? t('jev.settings.relayHelper') : t('jev.settings.relayNoToken'))} data-testid="jev-relay-select" error={Boolean(relayError)}>
          <MenuItem value="">
            <!-- bind: t('jev.settings.relayDirect') -->
          </MenuItem>
          <!-- bind: relayDirectory.map((entry) => ...) -->
          <MenuItem key={entry.providerId} value={entry.providerId}>
            <!-- bind: entry.providerName -->
          </MenuItem>
          <!-- /bind map -->
        </TextField>
        <TextField select={true} fullWidth={true} size="small" label={t('jev.settings.groupLabel')} value={draft.groupId || activeGroup?.groupId || ''} disabled={!activeProvider} onChange="{(event) => { const nextGroupId = event.target.value; const nextGroup = textGroups.find((group) => group.groupId === nextGroupId) ?? null; const nextModel = nextGroup?.models[0] ?? activeProvider?.defaultModel ?? draft.model; setDraft((current) => ({ ...current, groupId: nextGroupId, model: (nextModel ?? current.model).trim() || current.model })); }}" data-testid="jev-group-select">
          <MenuItem value="" disabled={true}>
            <!-- bind: t('jev.settings.groupPlaceholder') -->
          </MenuItem>
          <!-- bind: textGroups.map((group) => ...) -->
          <MenuItem key={group.groupId} value={group.groupId}>
            <!-- bind: group.groupName + ' · x' + group.groupRatio -->
          </MenuItem>
          <!-- /bind map -->
        </TextField>
        <TextField select={true} fullWidth={true} size="small" label={t('jev.settings.bridgeModelLabel')} value={modelOptions.includes(draft.model.trim()) ? draft.model.trim() : (modelOptions[0] ?? draft.model)} disabled={!activeProvider} onChange="{(event) => setDraft((current) => ({ ...current, model: event.target.value }))}" helperText={t('jev.settings.bridgeModelHelper')} data-testid="jev-bridge-model-select">
          <!-- bind: modelOptions.map((name) => ...) -->
          <MenuItem key={name} value={name}>
            <!-- bind: name -->
          </MenuItem>
          <!-- /bind map -->
        </TextField>
        <TextField select={true} fullWidth={true} size="small" label={t('jev.settings.bridgeProtocolLabel')} value={normalizeJevBridgeProtocol(draft.bridgeProtocol)} disabled={!activeProvider && !draft.providerId.trim()} onChange="{(event) => setDraft((current) => ({ ...current, bridgeProtocol: normalizeJevBridgeProtocol(event.target.value) }))}" helperText={t('jev.settings.bridgeProtocolHelper')} data-testid="jev-bridge-protocol-select">
          <MenuItem value="openai-chat">openai-chat（/v1/chat/completions）</MenuItem>
          <MenuItem value="openai-responses">openai-responses（/v1/responses）</MenuItem>
        </TextField>
        <!-- if: draft.providerId.trim() -->
        <Alert severity="success">
          <!-- bind: t('jev.settings.bridgeActive', { provider: activeProvider?.providerName ?? draft.providerId, group: activeGroup?.groupName ?? draft.groupId, model: draft.model, protocol: normalizeJevBridgeProtocol(draft.bridgeProtocol) }) -->
        </Alert>
        <!-- /if -->
        <FormControlLabel label={t('jev.settings.activeToolsLabel')}>
          <!-- control -->
          <Switch checked={draft.allowActiveTools} onChange="{(event) => setDraft((current) => ({ ...current, allowActiveTools: event.target.checked }))}" data-testid="jev-active-tools-switch" />
        </FormControlLabel>
        <Typography variant="caption" color="text.secondary" sx="{ mt: -1 }">
          <!-- bind: t('jev.settings.activeToolsDesc') -->
        </Typography>
        <Typography variant="caption" color="text.secondary" sx="{ mt: 1 }">
          <!-- bind: t('jev.settings.passiveTitle') -->
        </Typography>
        <FormControlLabel label={t('jev.settings.autoNudgeLabel')}>
          <!-- control -->
          <Switch checked={draft.autoNudge} onChange="{(event) => setDraft((current) => ({ ...current, autoNudge: event.target.checked }))}" data-testid="jev-autonudge-switch" />
        </FormControlLabel>
        <FormControlLabel label={t('jev.settings.planReviewLabel')}>
          <!-- control -->
          <Switch checked={draft.planReview !== 'off'} onChange="{(event) => setDraft((current) => ({ ...current, planReview: event.target.checked ? 'created' : 'off' }))}" data-testid="jev-planreview-switch" />
        </FormControlLabel>
        <FormControlLabel label={t('jev.settings.briefLabel')}>
          <!-- control -->
          <Switch checked={draft.reviewBrief} onChange="{(event) => setDraft((current) => ({ ...current, reviewBrief: event.target.checked }))}" data-testid="jev-brief-switch" />
        </FormControlLabel>
        <FormControlLabel label={t('jev.settings.reportLabel')}>
          <!-- control -->
          <Switch checked={draft.reviewReport} onChange="{(event) => setDraft((current) => ({ ...current, reviewReport: event.target.checked }))}" data-testid="jev-report-switch" />
        </FormControlLabel>
        <!-- if: draft.planReview !== 'off' -->
        <TextField select={true} size="small" label={t('jev.settings.planReviewTimingLabel')} value={draft.planReview} onChange="{(event) => setDraft((current) => ({ ...current, planReview: normalizePlanReviewMode(event.target.value, 'created') }))}" helperText={t('jev.settings.planReviewTimingHelper')} data-testid="jev-planreview-mode" sx="{ maxWidth: 260 }">
          <!-- bind: JEV_PLAN_REVIEW_OPTIONS.filter((option) => option.value !== 'off').map((option) => ...) -->
          <MenuItem key={option.value} value={option.value}>
            <!-- bind: t(`jev.planReview.${option.value}`) -->
          </MenuItem>
          <!-- /bind map -->
        </TextField>
        <!-- /if -->
        <!-- if: draft.autoNudge -->
        <TextField size="small" label={t('jev.settings.maxNudgesLabel')} type="number" value={draft.maxNudges} onChange="{(event) => setDraft((current) => ({ ...current, maxNudges: normalizeMaxJevNudges(Number(event.target.value)) }))}" helperText={t('jev.settings.maxNudgesHelper', { max: JEV_MAX_AUTO_NUDGES })} data-testid="jev-maxnudges-input" sx="{ maxWidth: 220 }" slotProps="{ input: { inputProps: { min: 1, max: JEV_MAX_AUTO_NUDGES } } }" />
        <!-- /if -->
        <Stack direction="row" spacing={1.5} alignItems="center">
          <Button variant="outlined" size="small" onClick="{() => void handleTest()}" disabled={testing} data-testid="jev-test-button">
            <!-- if: testing -->
            <CircularProgress size={16} sx="{ mr: 1 }" />
            <!-- /if -->
            <!-- bind: t('jev.settings.testButton') -->
          </Button>
          <!-- if: testResult -->
          <Typography variant="caption" color={testResult.startsWith('200 OK') ? 'success.main' : 'error.main'} data-testid="jev-test-result">
            <!-- bind: testResult -->
          </Typography>
          <!-- /if -->
        </Stack>
        <!-- if: !draft.enabled -->
        <Alert severity="info">
          <!-- bind: t('jev.settings.disabledInfo') -->
        </Alert>
        <!-- /if -->
      </Stack>
    </DialogContent>
    <DialogActions>
      <Button onClick={onClose}>
        <!-- bind: t('jev.settings.cancel') -->
      </Button>
      <Button variant="contained" onClick={handleSave} data-testid="jev-save-button">
        <!-- bind: t('jev.settings.save') -->
      </Button>
    </DialogActions>
  </Dialog>
</JevSettingsDialog>
