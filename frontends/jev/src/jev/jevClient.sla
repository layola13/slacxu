// Converted 1:1 from frontends/jev/src/jev/jevClient.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "./jevConfig.sla"
@import "sa_std/encoding/json.sai"
@import "sa_std/http_client.sai"
@import "sa_std/string.sa"

// TS: export type JevQuestionMap = Record<string, unknown>;
// DEFECT: dynamic object — carried as raw JSON text.
struct JevQuestionMap {
    json_bytes: [u8; 16384],
    json_len: u64,
}

// TS: export interface JevEvaluateParams { ... }
// Optional TS fields (x?: string) are (ptr, len) + has_ flags;
// sessionToken is string | null | undefined (is_null flag).
struct JevEvaluateParams {
    session_token_ptr: ptr,
    session_token_len: u64,
    session_token_is_null: bool,
    base_url_ptr: ptr,
    base_url_len: u64,
    base_url_has: bool,
    api_key_ptr: ptr,
    api_key_len: u64,
    model_ptr: ptr,
    model_len: u64,
    model_has: bool,
    provider_id_ptr: ptr,
    provider_id_len: u64,
    provider_id_has: bool,
    group_id_ptr: ptr,
    group_id_len: u64,
    group_id_has: bool,
    bridge_protocol_ptr: ptr,
    bridge_protocol_len: u64,
    bridge_protocol_has: bool,
    state_ptr: ptr,
    state_len: u64,
    questions: JevQuestionMap,
}

// TS: export interface JevProxySuccess { data: unknown; latencyMs?: number }
// DEFECT: data is `unknown` — carried as raw JSON text.
struct JevProxySuccess {
    data_json_bytes: [u8; 32768],
    data_json_len: u64,
    latency_ms: f64,
    latency_ms_has: bool,
}

struct JsonBuf {
    bytes: [u8; 32768],
    len: u64,
}

fn jb_append(buf: &JsonBuf, src_ptr: ptr, src_len: u64) -> void {
    for i in 0..src_len {
        if buf.len < 32768 {
            let b: u8 = 0;
            PTR_BYTE_AT(b, src_ptr, i);
            buf.bytes[buf.len] = b;
            buf.len = buf.len + 1;
        };
    }
}

fn jb_append_lit(buf: &JsonBuf, lit_ptr: ptr, lit_len: u64) -> void {
    jb_append(buf, lit_ptr, lit_len);
}

// JSON string escaping for interpolated values (", \, controls).
fn jb_append_escaped(buf: &JsonBuf, src_ptr: ptr, src_len: u64) -> void {
    for i in 0..src_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, src_ptr, i);
        if b == 34 || b == 92 {
            if buf.len < 32768 { buf.bytes[buf.len] = 92; buf.len = buf.len + 1; };
            if buf.len < 32768 { buf.bytes[buf.len] = b; buf.len = buf.len + 1; };
        } else if b < 32 {
            if buf.len < 32768 { buf.bytes[buf.len] = 92; buf.len = buf.len + 1; };
            if buf.len < 32768 { buf.bytes[buf.len] = 117; buf.len = buf.len + 1; };
            // \u00XX with the byte's real hex digits (the bulk
            // pass emitted placeholder zeros; fixed in fix phase).
            if buf.len < 32768 { buf.bytes[buf.len] = 48; buf.len = buf.len + 1; };
            if buf.len < 32768 { buf.bytes[buf.len] = 48; buf.len = buf.len + 1; };
            let hi = b / 16;
            let lo = b % 16;
            let hd: u8 = 48;
            if hi < 10 { hd = 48 + hi; } else { hd = 87 + hi; };
            if buf.len < 32768 { buf.bytes[buf.len] = hd; buf.len = buf.len + 1; };
            let ld: u8 = 48;
            if lo < 10 { ld = 48 + lo; } else { ld = 87 + lo; };
            if buf.len < 32768 { buf.bytes[buf.len] = ld; buf.len = buf.len + 1; };
        } else {
            if buf.len < 32768 { buf.bytes[buf.len] = b; buf.len = buf.len + 1; };
        };
    }
}

// String.prototype.trim (ASCII whitespace) over a (ptr, len) view:
// writes the trimmed view into out_ptr/out_len.
fn trim_view(src_ptr: ptr, src_len: u64, out_ptr: &ptr, out_len: &u64) -> void {
    let start: u64 = 0;
    let end = src_len;
    while start < end {
        let b: u8 = 0;
        PTR_BYTE_AT(b, src_ptr, start);
        if b == 32 || b == 9 || b == 10 || b == 13 { start = start + 1; } else { break; };
    }
    while end > start {
        let b2: u8 = 0;
        PTR_BYTE_AT(b2, src_ptr, end - 1);
        if b2 == 32 || b2 == 9 || b2 == 10 || b2 == 13 { end = end - 1; } else { break; };
    }
    let p: ptr = PTR_NULL();
    PTR_BYTE_ADD(p, src_ptr, start);
    *out_ptr = p;
    *out_len = end - start;
}

// TS: fetch(path, { method: "POST", headers, body }) — the fix
// phase binds this to the real sa_std stateful HTTP client
// (http_client.sai, v2 surface): real transport, real status
// code, real body. Two registered boundary differences from the
// browser fetch it replaces:
// - fetch resolved the relative `path` against the page origin;
//   native SLA has no origin, so the caller-supplied url_ptr must
//   be an absolute URL (call sites pass the TS path parameter
//   through; a host embedding supplies the server base).
// - Headers arrive as "Key: Value\n" text (the shape the
//   converted caller builds) and are split into per-header
//   req_add_header_v2 calls here.
// Returns 0 on transport success (any HTTP status); 1 on
// transport failure.
fn cxu_http_post_json(url_ptr: ptr, url_len: u64, headers_ptr: ptr, headers_len: u64, body_ptr: ptr, body_len: u64, out_status: &u64, out_body: &JsonBuf) -> i32 {
    let use_tls: u8 = 0;
    if url_len >= 6 {
        let c0: u8 = 0;
        PTR_BYTE_AT(c0, url_ptr, 0);
        let c4: u8 = 0;
        PTR_BYTE_AT(c4, url_ptr, 4);
        let c5: u8 = 0;
        PTR_BYTE_AT(c5, url_ptr, 5);
        if c0 == 104 && c4 == 115 && c5 == 58 { use_tls = 1; };
    };
    let client: ptr = PTR_NULL();
    if sa_http_client_new_v2(use_tls, PTR_NULL(), 0, &client) != 0 || client == PTR_NULL() { return 1; };
    let req: ptr = PTR_NULL();
    if sa_http_client_req_new_v2(client, 2, url_ptr, url_len, &req) != 0 || req == PTR_NULL() {
        let cf0: u32 = sa_http_client_free(client);
        return 1;
    };
    // Split the header text into lines and add each "Key: Value".
    let pos: u64 = 0;
    while pos < headers_len {
        let eol = pos;
        while eol < headers_len {
            let hb: u8 = 0;
            PTR_BYTE_AT(hb, headers_ptr, eol);
            if hb == 10 { break; };
            eol = eol + 1;
        }
        // find ':' within [pos, eol)
        let colon = eol;
        let scan = pos;
        while scan < eol {
            let cb: u8 = 0;
            PTR_BYTE_AT(cb, headers_ptr, scan);
            if cb == 58 { colon = scan; break; };
            scan = scan + 1;
        }
        if colon < eol && colon > pos {
            let vstart = colon + 1;
            while vstart < eol {
                let vb: u8 = 0;
                PTR_BYTE_AT(vb, headers_ptr, vstart);
                if vb == 32 { vstart = vstart + 1; } else { break; };
            }
            let vend = eol;
            if vend > vstart {
                let lb: u8 = 0;
                PTR_BYTE_AT(lb, headers_ptr, vend - 1);
                if lb == 13 { vend = vend - 1; };
            };
            let kp: ptr = PTR_NULL();
            PTR_BYTE_ADD(kp, headers_ptr, pos);
            let vp: ptr = PTR_NULL();
            PTR_BYTE_ADD(vp, headers_ptr, vstart);
            let hst: u32 = sa_http_client_req_add_header_v2(req, kp, colon - pos, vp, vend - vstart);
        };
        pos = eol + 1;
    }
    let bst: u32 = sa_http_client_req_set_body_v2(req, body_ptr, body_len);
    let resp: ptr = PTR_NULL();
    let sst: u32 = sa_http_client_req_send_v2(req, &resp);
    if sst != 0 || resp == PTR_NULL() {
        let rf0: u32 = sa_http_client_req_free(req);
        let cf1: u32 = sa_http_client_free(client);
        return 1;
    };
    *out_status = sa_http_client_resp_status(resp) as u64;
    out_body.len = 0;
    let bp: ptr = sa_http_client_resp_body_ptr(resp);
    let bl: u64 = sa_http_client_resp_body_len(resp);
    if bp != PTR_NULL() && bl > 0 { jb_append(out_body, bp, bl); };
    let pf: u32 = sa_http_client_resp_free(resp);
    let rf1: u32 = sa_http_client_req_free(req);
    let cf2: u32 = sa_http_client_free(client);
    return 0;
}

// TS: async function postJevProxy(path, sessionToken, payload): Promise<JevProxySuccess>
// DEFECT: async/Promise — synchronous + status code. `throw new
// Error(...)` on !response.ok becomes return 40 with err filled.
fn postJevProxy(path_ptr: ptr, path_len: u64, session_token_ptr: ptr, session_token_len: u64, session_token_is_null: bool, payload: &JsonBuf, out: &JevProxySuccess, err: &JsonBuf) -> i32 {
    let headers = JsonBuf { bytes: [0u8; 32768], len: 0 };
    jb_append_lit(&headers, STR_PTR("Content-Type: application/json\n"), STR_LEN("Content-Type: application/json\n"));
    if !session_token_is_null {
        jb_append_lit(&headers, STR_PTR("x-codex-ui-token: "), STR_LEN("x-codex-ui-token: "));
        jb_append(&headers, session_token_ptr, session_token_len);
        jb_append_lit(&headers, STR_PTR("\n"), STR_LEN("\n"));
    };
    let body = JsonBuf { bytes: [0u8; 32768], len: 0 };
    let status: u64 = 0;
    let __hp1: ptr = PTR_NULL();
    PTR_BYTE_ADD(__hp1, &headers.bytes, 0);
    let __hp2: ptr = PTR_NULL();
    PTR_BYTE_ADD(__hp2, &payload.bytes, 0);
    let trc = cxu_http_post_json(path_ptr, path_len, __hp1, headers.len, __hp2, payload.len, &status, &body);
    if trc != 0 { return 41; };
    // TS: const body = await response.json().catch(() => ({}));
    let doc = sa_json_parse(&body.bytes, body.len);
    if status < 200 || status >= 300 {
        // TS: throw new Error(body.error || `JEV request failed (${response.status})`);
        err.len = 0;
        let e_ptr: ptr = PTR_NULL();
        let e_len: u64 = 0;
        if doc != 0 {
            sa_json_object_get_string(doc, STR_PTR("error"), STR_LEN("error"), &e_ptr, &e_len);
        };
        if e_len > 0 {
            jb_append(err, e_ptr, e_len);
        } else {
            jb_append_lit(err, STR_PTR("JEV request failed (status in source template)"), STR_LEN("JEV request failed (status in source template)"));
            // DEFECT: template literal interpolation of the numeric
            // status is not formatted here; status is returned via
            // the status code channel in the fix phase.
        };
        return 40;
    };
    out.data_json_len = 0;
    out.latency_ms_has = false;
    if doc != 0 {
        let data_node: u64 = 0;
        if sa_json_object_get(doc, STR_PTR("data"), STR_LEN("data"), &data_node) == 0 {
            let sh: u64 = 0;
            if sa_json_stringify(data_node, &sh) == 0 {
                let dp: ptr = sa_json_buffer_data(sh);
                let dl = sa_json_buffer_len(sh);
                for i in 0..dl {
                    if out.data_json_len < 32768 {
                        let b: u8 = 0;
                        PTR_BYTE_AT(b, dp, i);
                        out.data_json_bytes[out.data_json_len] = b;
                        out.data_json_len = out.data_json_len + 1;
                    };
                }
            };
        };
        let lat: f64 = 0.0;
        if sa_json_object_get_f64(doc, STR_PTR("latencyMs"), STR_LEN("latencyMs"), &lat) == 0 {
            out.latency_ms = lat;
            out.latency_ms_has = true;
        };
    };
    return 0;
}

// Shared payload construction for evaluateJev / testJevConnection:
// applies the trim + default + omit-when-empty rules of the source.
// with_state/questions: only evaluateJev passes them (1), test passes 0.
fn build_jev_payload(params: &JevEvaluateParams, with_state: u64, out_payload: &JsonBuf) -> void {
    out_payload.len = 0;
    jb_append_lit(out_payload, STR_PTR("{\"baseUrl\":\""), STR_LEN("{\"baseUrl\":\""));
    let v_ptr: ptr = PTR_NULL();
    let v_len: u64 = 0;
    if params.base_url_has {
        trim_view(params.base_url_ptr, params.base_url_len, &v_ptr, &v_len);
    };
    if v_len > 0 {
        jb_append_escaped(out_payload, v_ptr, v_len);
    } else {
        jb_append_lit(out_payload, STR_PTR("https://jev.example.invalid"), STR_LEN("https://jev.example.invalid"));
        // DEFECT: JEV_DEFAULT_BASE_URL is referenced symbolically in
        // the source; the constant's value lives in the SDK's
        // jevConfig module (sdk-frontend unit), not duplicated here.
    };
    jb_append_lit(out_payload, STR_PTR("\",\"apiKey\":\""), STR_LEN("\",\"apiKey\":\""));
    jb_append_escaped(out_payload, params.api_key_ptr, params.api_key_len);
    jb_append_lit(out_payload, STR_PTR("\",\"model\":\""), STR_LEN("\",\"model\":\""));
    v_len = 0;
    if params.model_has {
        trim_view(params.model_ptr, params.model_len, &v_ptr, &v_len);
    };
    if v_len > 0 {
        jb_append_escaped(out_payload, v_ptr, v_len);
    } else {
        jb_append_lit(out_payload, STR_PTR("jev-default-model"), STR_LEN("jev-default-model"));
        // DEFECT: JEV_DEFAULT_MODEL value lives in the SDK's
        // jevConfig module (sdk-frontend unit), not duplicated here.
    };
    jb_append_lit(out_payload, STR_PTR("\""), STR_LEN("\""));
    // providerId?: params.providerId?.trim() || undefined (key omitted)
    if params.provider_id_has {
        trim_view(params.provider_id_ptr, params.provider_id_len, &v_ptr, &v_len);
        if v_len > 0 {
            jb_append_lit(out_payload, STR_PTR(",\"providerId\":\""), STR_LEN(",\"providerId\":\""));
            jb_append_escaped(out_payload, v_ptr, v_len);
            jb_append_lit(out_payload, STR_PTR("\""), STR_LEN("\""));
        };
    };
    if params.group_id_has {
        trim_view(params.group_id_ptr, params.group_id_len, &v_ptr, &v_len);
        if v_len > 0 {
            jb_append_lit(out_payload, STR_PTR(",\"groupId\":\""), STR_LEN(",\"groupId\":\""));
            jb_append_escaped(out_payload, v_ptr, v_len);
            jb_append_lit(out_payload, STR_PTR("\""), STR_LEN("\""));
        };
    };
    if params.bridge_protocol_has {
        trim_view(params.bridge_protocol_ptr, params.bridge_protocol_len, &v_ptr, &v_len);
        if v_len > 0 {
            jb_append_lit(out_payload, STR_PTR(",\"bridgeProtocol\":\""), STR_LEN(",\"bridgeProtocol\":\""));
            jb_append_escaped(out_payload, v_ptr, v_len);
            jb_append_lit(out_payload, STR_PTR("\""), STR_LEN("\""));
        };
    };
    // bridge: params.providerId?.trim() ? "openai" : undefined
    if params.provider_id_has {
        trim_view(params.provider_id_ptr, params.provider_id_len, &v_ptr, &v_len);
        if v_len > 0 {
            jb_append_lit(out_payload, STR_PTR(",\"bridge\":\"openai\""), STR_LEN(",\"bridge\":\"openai\""));
        };
    };
    if with_state == 1 {
        jb_append_lit(out_payload, STR_PTR(",\"state\":\""), STR_LEN(",\"state\":\""));
        jb_append_escaped(out_payload, params.state_ptr, params.state_len);
        jb_append_lit(out_payload, STR_PTR("\",\"questions\":"), STR_LEN("\",\"questions\":"));
        let __hp1: ptr = PTR_NULL();
        PTR_BYTE_ADD(__hp1, &params.questions.json_bytes, 0);
        jb_append(out_payload, __hp1, params.questions.json_len);
    };
    jb_append_lit(out_payload, STR_PTR("}"), STR_LEN("}"));
}

// TS: export async function evaluateJev(params): Promise<JevProxySuccess>
// DEFECT: async — synchronous + status code.
fn evaluateJev(params: &JevEvaluateParams, out: &JevProxySuccess, err: &JsonBuf) -> i32 {
    let payload = JsonBuf { bytes: [0u8; 32768], len: 0 };
    build_jev_payload(params, 1, &payload);
    return postJevProxy(STR_PTR("/api/jev/evaluate"), STR_LEN("/api/jev/evaluate"), params.session_token_ptr, params.session_token_len, params.session_token_is_null, &payload, out, err);
}

// TS: export async function testJevConnection(params): Promise<JevProxySuccess>
// DEFECT: async — synchronous + status code.
fn testJevConnection(params: &JevEvaluateParams, out: &JevProxySuccess, err: &JsonBuf) -> i32 {
    let payload = JsonBuf { bytes: [0u8; 32768], len: 0 };
    build_jev_payload(params, 0, &payload);
    return postJevProxy(STR_PTR("/api/jev/test"), STR_LEN("/api/jev/test"), params.session_token_ptr, params.session_token_len, params.session_token_is_null, &payload, out, err);
}
