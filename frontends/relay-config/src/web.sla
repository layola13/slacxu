// Converted 1:1 from frontends/relay-config/src/web.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "./manifest.sla"
@import "sa_std/string.sa"

//
// Relay-station configuration — web side: a settings panel contribution
// (kind "service"). Phase 1: declaration level.
//

// DEFECT: the WebFeaturePlugin type comes from @cxu/sdk-frontend,
// which has no SLA counterpart yet. The shape below mirrors the
// TS object 1:1; contribution entries are fixed arrays + len.
struct WebFeaturePlugin {
    manifest: PluginManifest,
    settings_panels: [SettingsPanelContribution; 4],
    settings_panels_len: u64,
}

struct SettingsPanelContribution {
    id_ptr: ptr,
    id_len: u64,
    title_key_ptr: ptr,
    title_key_len: u64,
    render_id: u64,
}

// TS: render: () => { throw new Error("relay-config panel is not
// wired to the host yet (phase 1 declaration)"); }
// DEFECT: closures and throw have no SLA counterpart; the render
// callback is represented by render_id and this stub, which
// returns the declaration-phase error as a status code.
fn relay_config_panel_render() -> i32 {
    // error: "relay-config panel is not wired to the host yet (phase 1 declaration)"
    return 90;
}

// TS: export const relayConfigWebPlugin: WebFeaturePlugin = { ... };
// export default relayConfigWebPlugin; (SLA has no default
// export; the builder function below is the export.)
fn build_relayConfigWebPlugin(out: &WebFeaturePlugin) -> i32 {
    let mst = load_RELAY_CONFIG_MANIFEST(&out.manifest);
    if mst != 0 { return mst; };
    out.settings_panels_len = 1;
    out.settings_panels[0].id_ptr = STR_PTR("relay-config");
    out.settings_panels[0].id_len = STR_LEN("relay-config");
    out.settings_panels[0].title_key_ptr = STR_PTR("settings.relayStations");
    out.settings_panels[0].title_key_len = STR_LEN("settings.relayStations");
    out.settings_panels[0].render_id = 1;
    return 0;
}
