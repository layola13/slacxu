// Converted 1:1 from frontends/free-mode/src/web.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "./manifest.sla"
// TS re-exports:
//   export { FREE_MODE_MANIFEST } from "./manifest.js";  (above import)
//   export { VmContextSavingsTab } from "./free/VmContextSavingsTab.js";
//   (converted in ./free/VmContextSavingsTab.sax alongside this file).

/**
 * Free (money-saving) mode — web side (kind "feature"). Owns the
 * free-mode UI and pure helpers (`src/free/`: freeCompactionReadiness,
 * freeAutoCompactPreferences, VmContextSavingsTab). The compaction
 * hooks (useFreeCompaction / useFreeCompactionSelection) turned out
 * to be the workbench turn-send pipeline itself, so R2 re-homed them
 * to apps/web/src/free as host core; they consume the readiness and
 * preference helpers from here during staging.
 */

// DEFECT: the WebFeaturePlugin type comes from @cxu/sdk-frontend,
// which has no SLA counterpart yet. The shape below mirrors the
// TS object 1:1; contribution entries are fixed arrays + len.
struct WebFeaturePlugin {
    manifest: PluginManifest,
    slots: [SlotContribution; 4],
    slots_len: u64,
}

struct SlotContribution {
    slot_ptr: ptr,
    slot_len: u64,
    // render: () => never (throws) in TS; see free_mode_slot_render.
    render_id: u64,
}

// TS: render: () => { throw new Error("free-mode renders through
// the host's direct hook imports during staging"); }
// DEFECT: closures and throw have no SLA counterpart; the render
// callback is represented by render_id and this stub, which
// returns the staging error as a status code.
fn free_mode_slot_render() -> i32 {
    // error: "free-mode renders through the host's direct hook imports during staging"
    return 90;
}

// TS: export const freeModeWebPlugin: WebFeaturePlugin = { ... };
// export default freeModeWebPlugin; (SLA has no default export;
// the builder function below is the export.)
fn build_freeModeWebPlugin(out: &WebFeaturePlugin) -> i32 {
    let mst = load_FREE_MODE_MANIFEST(&out.manifest);
    if mst != 0 { return mst; };
    out.slots_len = 1;
    out.slots[0].slot_ptr = STR_PTR("composer");
    out.slots[0].slot_len = STR_LEN("composer");
    out.slots[0].render_id = 1;
    return 0;
}
