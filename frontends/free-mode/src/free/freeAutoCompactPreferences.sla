// Converted 1:1 from frontends/free-mode/src/free/freeAutoCompactPreferences.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.

// TS: export const FREE_AUTOCOMPACT_DEFAULT_THRESHOLD = 80;
fn FREE_AUTOCOMPACT_DEFAULT_THRESHOLD() -> f64 { return 80.0; }
// TS: export const FREE_AUTOCOMPACT_MIN_THRESHOLD = 50;
fn FREE_AUTOCOMPACT_MIN_THRESHOLD() -> f64 { return 50.0; }
// TS: export const FREE_AUTOCOMPACT_MAX_THRESHOLD = 95;
fn FREE_AUTOCOMPACT_MAX_THRESHOLD() -> f64 { return 95.0; }

/** Cooldown between successive auto-compactions on the same thread, in ms. */
// TS: export const FREE_AUTOCOMPACT_COOLDOWN_MS = 60_000;
fn FREE_AUTOCOMPACT_COOLDOWN_MS() -> u64 { return 60000; }

// TS: export function clampFreeAutoCompactThreshold(threshold: number): number
//   return Math.min(MAX, Math.max(MIN, Math.round(threshold)));
// DEFECT: SLA has no module-level const exports; constants are
// accessor functions. Math.round (half up) is spelled out inline.
fn clampFreeAutoCompactThreshold(threshold: f64) -> f64 {
    let rounded = threshold + 0.5;
    // floor for the (always positive) threshold range
    let r = rounded as i64 as f64;
    let hi = FREE_AUTOCOMPACT_MAX_THRESHOLD();
    let lo = FREE_AUTOCOMPACT_MIN_THRESHOLD();
    let v = r;
    if v > hi { v = hi; };
    if v < lo { v = lo; };
    return v;
}
