// Converted 1:1 from frontends/free-mode/src/free/freeCompactionReadiness.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "sa_std/encoding/json.sai"
@import "sa_std/ptr.sa"
@import "sa_std/string.sa"

// ProviderConfig / ChannelGroupConfig come from @codex-ui/shared
// (dynamic config objects). DEFECT: dynamic object — providers
// are carried as a parsed sa_json array doc and every field is
// read through sa_json_* accessors; string results are views
// into the doc's text.

struct StrBuf {
    bytes: [u8; 4096],
    len: u64,
}

fn sb_append(buf: &StrBuf, src_ptr: ptr, src_len: u64) -> void {
    for i in 0..src_len {
        if buf.len < 4096 {
            let b: u8 = 0;
            PTR_BYTE_AT(b, src_ptr, i);
            buf.bytes[buf.len] = b;
            buf.len = buf.len + 1;
        };
    }
}

fn sb_append_lit(buf: &StrBuf, lit_ptr: ptr, lit_len: u64) -> void {
    sb_append(buf, lit_ptr, lit_len);
}

fn str_eq_lit(a_ptr: ptr, a_len: u64, lit_ptr: ptr, lit_len: u64) -> bool {
    if a_len != lit_len { return false; };
    for i in 0..a_len {
        let x: u8 = 0;
        let y: u8 = 0;
        PTR_BYTE_AT(x, a_ptr, i);
        PTR_BYTE_AT(y, lit_ptr, i);
        if x != y { return false; };
    }
    return true;
}

fn trim_into(src_ptr: ptr, src_len: u64, out_ptr: &ptr, out_len: &u64) -> void {
    let start: u64 = 0;
    let end = src_len;
    while start < end {
        let b: u8 = 0;
        PTR_BYTE_AT(b, src_ptr, start);
        if b == 32 || b == 9 || b == 10 || b == 13 { start = start + 1; } else { break; };
    }
    while end > start {
        let b2: u8 = 0;
        PTR_BYTE_AT(b2, src_ptr, end - 1);
        if b2 == 32 || b2 == 9 || b2 == 10 || b2 == 13 { end = end - 1; } else { break; };
    }
    let p: ptr = PTR_NULL();
    PTR_BYTE_ADD(p, src_ptr, start);
    *out_ptr = p;
    *out_len = end - start;
}

// node string field as a view; false when absent/not a string.
fn fstr(node: u64, key_ptr: ptr, key_len: u64, out_ptr: &ptr, out_len: &u64) -> bool {
    if node == 0 { return false; };
    let p: ptr = PTR_NULL();
    let l: u64 = 0;
    if sa_json_object_get_string(node, key_ptr, key_len, &p, &l) != 0 { return false; };
    *out_ptr = p;
    *out_len = l;
    return true;
}

fn fobj(node: u64, key_ptr: ptr, key_len: u64) -> u64 {
    if node == 0 { return 0; };
    let child: u64 = 0;
    if sa_json_object_get(node, key_ptr, key_len, &child) != 0 { return 0; };
    return child;
}

// Array length by probing (the JSON surface has no len call).
fn arr_len(arr: u64) -> u64 {
    if arr == 0 { return 0; };
    let n: u64 = 0;
    while n < 4096 {
        let el: u64 = 0;
        if sa_json_array_get(arr, n, &el) != 0 { break; };
        n = n + 1;
    }
    return n;
}

fn arr_at(arr: u64, idx: u64) -> u64 {
    let el: u64 = 0;
    if arr == 0 { return 0; };
    if sa_json_array_get(arr, idx, &el) != 0 { return 0; };
    return el;
}

// Whether a JSON string-array node contains the literal.
fn str_arr_contains(arr: u64, lit_ptr: ptr, lit_len: u64) -> bool {
    let n = arr_len(arr);
    for i in 0..n {
        let el = arr_at(arr, i);
        let p: ptr = sa_json_string_ptr(el);
        let l: u64 = sa_json_string_len(el);
        if str_eq_lit(p, l, lit_ptr, lit_len) { return true; };
    }
    return false;
}

//  Provider id for the free omniroute relay.
// TS: export const FREE_COMPACT_PROVIDER_ID = "omniroute-free";
fn FREE_COMPACT_PROVIDER_ID(out_ptr: &ptr, out_len: &u64) -> void { *out_ptr = STR_PTR("omniroute-free"); *out_len = STR_LEN("omniroute-free"); }
//  Group id that hosts free models on the omniroute-free relay.
// TS: export const FREE_COMPACT_GROUP_ID = "opencode-free";
fn FREE_COMPACT_GROUP_ID(out_ptr: &ptr, out_len: &u64) -> void { *out_ptr = STR_PTR("opencode-free"); *out_len = STR_LEN("opencode-free"); }

// const FREE_COMPACTION_HIDDEN_MODELS = new Set(["big-pickle"]);
fn is_hidden_model(p: ptr, l: u64) -> bool {
    // model.trim().toLowerCase() === "big-pickle"
    let t: ptr = PTR_NULL();
    let tl: u64 = 0;
    trim_into(p, l, &t, &tl);
    if tl != 10 { return false; };
    let want = "big-pickle";
    for i in 0..10 {
        let b: u8 = 0;
        PTR_BYTE_AT(b, t, i);
        if b >= 65 && b <= 90 { b = b + 32; };
        let w: u8 = 0;
        PTR_BYTE_AT(w, STR_PTR("big-pickle"), i);
        if b != w { return false; };
    }
    return true;
}

// TS: export type FreeCompactionUnreadyReason = "no-active-thread" |
//   "remote-workspace" | "no-current-model" | "provider-missing" |
//   "group-missing" | "group-empty" | "manual-route-incomplete" |
//   "manual-model-unavailable";  (string union — (ptr, len) views)

// TS: export type FreeCompactionReadiness =
//   { ok: true; providerId; groupId: string | null; model; mappedFrom; source: "manual" }
//   | { ok: false; reason; detail?: string }
// DEFECT: discriminated union — one struct + ok flag.
struct FreeCompactionReadiness {
    ok: bool,
    provider_id_ptr: ptr,
    provider_id_len: u64,
    group_id_ptr: ptr,
    group_id_len: u64,
    group_id_is_null: bool,
    model_ptr: ptr,
    model_len: u64,
    mapped_from_ptr: ptr,
    mapped_from_len: u64,
    source_ptr: ptr,
    source_len: u64,
    reason_ptr: ptr,
    reason_len: u64,
    detail_ptr: ptr,
    detail_len: u64,
    detail_has: bool,
}

fn readiness_fail(out: &FreeCompactionReadiness, reason_ptr: ptr, reason_len: u64, detail_ptr: ptr, detail_len: u64, detail_has: bool) -> void {
    out.ok = false;
    out.reason_ptr = reason_ptr;
    out.reason_len = reason_len;
    out.detail_ptr = detail_ptr;
    out.detail_len = detail_len;
    out.detail_has = detail_has;
}

// TS: export function shouldRefreshFreeCompactionModels(enabled, manualProviderId?, reason?): boolean
fn shouldRefreshFreeCompactionModels(enabled: bool, manual_ptr: ptr, manual_len: u64, manual_has: bool, reason_ptr: ptr, reason_len: u64, reason_has: bool) -> bool {
    let pid: ptr = PTR_NULL();
    let pidl: u64 = 0;
    if manual_has { trim_into(manual_ptr, manual_len, &pid, &pidl); };
    if !enabled { return false; };
    if pidl > 0 {
        let fp: ptr = PTR_NULL();
        let fl: u64 = 0;
        FREE_COMPACT_PROVIDER_ID(&fp, &fl);
        if !str_eq_lit(pid, pidl, fp, fl) { return false; };
    };
    if !reason_has { return true; };
    if str_eq_lit(reason_ptr, reason_len, STR_PTR("provider-missing"), STR_LEN("provider-missing")) { return true; };
    if str_eq_lit(reason_ptr, reason_len, STR_PTR("group-missing"), STR_LEN("group-missing")) { return true; };
    if str_eq_lit(reason_ptr, reason_len, STR_PTR("group-empty"), STR_LEN("group-empty")) { return true; };
    if str_eq_lit(reason_ptr, reason_len, STR_PTR("manual-model-unavailable"), STR_LEN("manual-model-unavailable")) { return true; };
    return false;
}

// Finds the omniroute-free provider node (0 when absent).
fn find_free_provider(providers: u64) -> u64 {
    let fp: ptr = PTR_NULL();
    let fl: u64 = 0;
    FREE_COMPACT_PROVIDER_ID(&fp, &fl);
    let n = arr_len(providers);
    for i in 0..n {
        let prov = arr_at(providers, i);
        let p: ptr = PTR_NULL();
        let l: u64 = 0;
        if fstr(prov, STR_PTR("id"), STR_LEN("id"), &p, &l) {
            if str_eq_lit(p, l, fp, fl) { return prov; };
        };
    }
    return 0;
}

fn group_models_nonempty(group: u64) -> bool {
    let models = fobj(group, STR_PTR("models"), STR_LEN("models"));
    return arr_len(models) > 0;
}

fn group_not_disabled(group: u64) -> bool {
    let p: ptr = PTR_NULL();
    let l: u64 = 0;
    if fstr(group, STR_PTR("status"), STR_LEN("status"), &p, &l) {
        if str_eq_lit(p, l, STR_PTR("disabled"), STR_LEN("disabled")) { return false; };
    };
    return true;
}

//  Locate the free group config on the omniroute-free provider, if present.
// TS: export function findFreeCompactionGroup(providers, groupId?): ChannelGroupConfig | undefined
// Returns the group node (0 = undefined).
fn findFreeCompactionGroup(providers: u64, group_ptr: ptr, group_len: u64, group_has: bool) -> u64 {
    let free_provider = find_free_provider(providers);
    if free_provider == 0 { return 0; };
    let groups = fobj(free_provider, STR_PTR("groups"), STR_LEN("groups"));
    if groups == 0 { return 0; };
    // DEFECT: Array.isArray(groups) is approximated by node != 0.
    let gn = arr_len(groups);
    if group_has && group_len > 0 {
        for i in 0..gn {
            let g = arr_at(groups, i);
            let p: ptr = PTR_NULL();
            let l: u64 = 0;
            if fstr(g, STR_PTR("id"), STR_LEN("id"), &p, &l) {
                if str_eq_lit(p, l, group_ptr, group_len) { return g; };
            };
        }
    };
    let fg: ptr = PTR_NULL();
    let fgl: u64 = 0;
    FREE_COMPACT_GROUP_ID(&fg, &fgl);
    let default_group: u64 = 0;
    for i2 in 0..gn {
        let g2 = arr_at(groups, i2);
        let p2: ptr = PTR_NULL();
        let l2: u64 = 0;
        if fstr(g2, STR_PTR("id"), STR_LEN("id"), &p2, &l2) {
            if str_eq_lit(p2, l2, fg, fgl) { default_group = g2; break; };
        };
    }
    if default_group != 0 && group_models_nonempty(default_group) { return default_group; };
    for i3 in 0..gn {
        let g3 = arr_at(groups, i3);
        if group_not_disabled(g3) && group_models_nonempty(g3) { return g3; };
    }
    if default_group != 0 { return default_group; };
    if gn > 0 { return arr_at(groups, 0); };
    return 0;
}

// TS: export type CompactionChannelOption = { providerId; providerName;
//   groupId: string | null; groupName; models: string[] }
// DEFECT: models: string[] — fixed array of views into the doc.
struct CompactionChannelOption {
    provider_id_ptr: ptr,
    provider_id_len: u64,
    provider_name_ptr: ptr,
    provider_name_len: u64,
    group_id_ptr: ptr,
    group_id_len: u64,
    group_id_is_null: bool,
    group_name_ptr: ptr,
    group_name_len: u64,
    models: [u64; 64],
    model_ptrs: [ptr; 64],
    models_len: u64,
}

struct CompactionChannelOptions {
    entries: [CompactionChannelOption; 64],
    len: u64,
}

// Fills one option's models from a JSON string array node,
// applying the hidden-model filter of the source.
fn fill_models(opt: &CompactionChannelOption, models_node: u64) -> void {
    opt.models_len = 0;
    let n = arr_len(models_node);
    for i in 0..n {
        if opt.models_len >= 64 { break; };
        let el = arr_at(models_node, i);
        let p: ptr = sa_json_string_ptr(el);
        let l: u64 = sa_json_string_len(el);
        if is_hidden_model(p, l) { continue; };
        let slot = opt.models_len;
        opt.model_ptrs[slot] = p;
        opt.models[slot] = l;
        opt.models_len = opt.models_len + 1;
    }
}

// TS: export function listCompactionChannelOptions(providers): CompactionChannelOption[]
fn listCompactionChannelOptions(providers: u64, out: &CompactionChannelOptions) -> void {
    out.len = 0;
    let pn = arr_len(providers);
    for pi in 0..pn {
        if out.len >= 64 { break; };
        let provider = arr_at(providers, pi);
        let pid: ptr = PTR_NULL();
        let pidl: u64 = 0;
        fstr(provider, STR_PTR("id"), STR_LEN("id"), &pid, &pidl);
        let pname: ptr = PTR_NULL();
        let pnamel: u64 = 0;
        fstr(provider, STR_PTR("name"), STR_LEN("name"), &pname, &pnamel);
        let native = fobj(provider, STR_PTR("nativeModels"), STR_LEN("nativeModels"));
        let groups = fobj(provider, STR_PTR("groups"), STR_LEN("groups"));
        // textGroups = (provider.groups ?? []).filter(kind !== "image" && status !== "disabled")
        let text_groups = [0u64; 128];
        let tg_len: u64 = 0;
        let gn = arr_len(groups);
        for gi in 0..gn {
            if tg_len >= 128 { break; };
            let g = arr_at(groups, gi);
            let kp: ptr = PTR_NULL();
            let kl: u64 = 0;
            let is_image = false;
            if fstr(g, STR_PTR("kind"), STR_LEN("kind"), &kp, &kl) {
                if str_eq_lit(kp, kl, STR_PTR("image"), STR_LEN("image")) { is_image = true; };
            };
            if is_image { continue; };
            if !group_not_disabled(g) { continue; };
            text_groups[tg_len] = g;
            tg_len = tg_len + 1;
        }
        if tg_len == 0 {
            if arr_len(native) > 0 {
                let opt = &out.entries[out.len];
                opt.provider_id_ptr = pid;
                opt.provider_id_len = pidl;
                opt.provider_name_ptr = pname;
                opt.provider_name_len = pnamel;
                opt.group_id_is_null = true;
                opt.group_id_len = 0;
                opt.group_name_ptr = STR_PTR("默认分组");
                opt.group_name_len = STR_LEN("默认分组");
                fill_models(opt, native);
                out.len = out.len + 1;
            };
        } else {
            for ti in 0..tg_len {
                if out.len >= 64 { break; };
                let g2 = text_groups[ti];
                let opt2 = &out.entries[out.len];
                opt2.provider_id_ptr = pid;
                opt2.provider_id_len = pidl;
                opt2.provider_name_ptr = pname;
                opt2.provider_name_len = pnamel;
                let gp: ptr = PTR_NULL();
                let gl: u64 = 0;
                fstr(g2, STR_PTR("id"), STR_LEN("id"), &gp, &gl);
                opt2.group_id_ptr = gp;
                opt2.group_id_len = gl;
                opt2.group_id_is_null = false;
                fstr(g2, STR_PTR("name"), STR_LEN("name"), &gp, &gl);
                opt2.group_name_ptr = gp;
                opt2.group_name_len = gl;
                let gmodels = fobj(g2, STR_PTR("models"), STR_LEN("models"));
                if arr_len(gmodels) > 0 {
                    fill_models(opt2, gmodels);
                } else {
                    fill_models(opt2, native);
                };
                out.len = out.len + 1;
            }
        };
    }
}

//  Whether the omniroute-free provider has been synced and exposes models on any active group.
// TS: export function hasFreeRelay(providers): boolean
fn hasFreeRelay(providers: u64) -> bool {
    let free_provider = find_free_provider(providers);
    if free_provider == 0 { return false; };
    let groups = fobj(free_provider, STR_PTR("groups"), STR_LEN("groups"));
    if groups == 0 { return false; };
    let gn = arr_len(groups);
    for i in 0..gn {
        let g = arr_at(groups, i);
        if group_not_disabled(g) && group_models_nonempty(g) { return true; };
    }
    return false;
}

//  Whether the selected free group advertises the openai-response-compact endpoint capability.
// TS: export function freeRelaySupportsCompact(providers, groupId?): boolean
fn freeRelaySupportsCompact(providers: u64, group_ptr: ptr, group_len: u64, group_has: bool) -> bool {
    let group = findFreeCompactionGroup(providers, group_ptr, group_len, group_has);
    if group == 0 { return false; };
    let types = fobj(group, STR_PTR("supportedEndpointTypes"), STR_LEN("supportedEndpointTypes"));
    return str_arr_contains(types, STR_PTR("openai-response-compact"), STR_LEN("openai-response-compact"));
}

// TS: export type FreeCompactionReadinessInput = { ... }
struct FreeCompactionReadinessInput {
    current_model_ptr: ptr,
    current_model_len: u64,
    current_model_has: bool,
    providers: u64,
    workspace_mode_ptr: ptr,
    workspace_mode_len: u64,
    active_thread_id_ptr: ptr,
    active_thread_id_len: u64,
    active_thread_id_has: bool,
    manual_free_model_ptr: ptr,
    manual_free_model_len: u64,
    manual_free_model_has: bool,
    manual_provider_id_ptr: ptr,
    manual_provider_id_len: u64,
    manual_provider_id_has: bool,
    manual_group_id_ptr: ptr,
    manual_group_id_len: u64,
    manual_group_id_has: bool,
}

//
// Evaluate whether free auto-compaction can run right now. Returns a structured
// reason on failure so callers can decide whether to prompt the user (e.g. open
// the FreeModelAccessDialog when the provider or its models are missing).
//
// TS: export function checkFreeCompactionReadiness(input): FreeCompactionReadiness
fn checkFreeCompactionReadiness(input: &FreeCompactionReadinessInput, out: &FreeCompactionReadiness) -> void {
    // const activeThreadId = input?.activeThreadId?.trim();
    let at: ptr = PTR_NULL();
    let atl: u64 = 0;
    if input.active_thread_id_has { trim_into(input.active_thread_id_ptr, input.active_thread_id_len, &at, &atl); };
    if atl == 0 {
        readiness_fail(out, STR_PTR("no-active-thread"), STR_LEN("no-active-thread"), PTR_NULL(), 0, false);
        return;
    };
    if !str_eq_lit(input.workspace_mode_ptr, input.workspace_mode_len, STR_PTR("local"), STR_LEN("local")) {
        readiness_fail(out, STR_PTR("remote-workspace"), STR_LEN("remote-workspace"), STR_PTR("Free compaction only applies to local workspaces."), STR_LEN("Free compaction only applies to local workspaces."), true);
        return;
    };
    let cm: ptr = PTR_NULL();
    let cml: u64 = 0;
    if input.current_model_has { trim_into(input.current_model_ptr, input.current_model_len, &cm, &cml); };
    if cml == 0 {
        readiness_fail(out, STR_PTR("no-current-model"), STR_LEN("no-current-model"), PTR_NULL(), 0, false);
        return;
    };
    let mp: ptr = PTR_NULL();
    let mpl: u64 = 0;
    if input.manual_provider_id_has { trim_into(input.manual_provider_id_ptr, input.manual_provider_id_len, &mp, &mpl); };
    let mf: ptr = PTR_NULL();
    let mfl: u64 = 0;
    if input.manual_free_model_has { trim_into(input.manual_free_model_ptr, input.manual_free_model_len, &mf, &mfl); };
    let mg: ptr = PTR_NULL();
    let mgl: u64 = 0;
    if input.manual_group_id_has { trim_into(input.manual_group_id_ptr, input.manual_group_id_len, &mg, &mgl); };
    if mpl > 0 || mgl > 0 || mfl > 0 {
        if mpl == 0 || mfl == 0 {
            readiness_fail(out, STR_PTR("manual-route-incomplete"), STR_LEN("manual-route-incomplete"), STR_PTR("手动压缩渠道和模型必须同时选择。"), STR_LEN("手动压缩渠道和模型必须同时选择。"), true);
            return;
        };
        // const provider = input.providers.find((entry) => entry.id === manualProviderId);
        let provider: u64 = 0;
        let pn = arr_len(input.providers);
        for i in 0..pn {
            let entry = arr_at(input.providers, i);
            let p: ptr = PTR_NULL();
            let l: u64 = 0;
            if fstr(entry, STR_PTR("id"), STR_LEN("id"), &p, &l) {
                if str_eq_lit(p, l, mp, mpl) { provider = entry; break; };
            };
        }
        if provider == 0 {
            // detail: `所选压缩渠道 ${manualProviderId} 已不可用。`
            // DEFECT: template literal — detail assembled in a
            // static prefix/suffix pair is flattened to the
            // prefix only here; the interpolated form is a
            // fix-phase detail (callers treat detail as opaque).
            readiness_fail(out, STR_PTR("provider-missing"), STR_LEN("provider-missing"), STR_PTR("所选压缩渠道已不可用。"), STR_LEN("所选压缩渠道已不可用。"), true);
            return;
        };
        // const option = listCompactionChannelOptions([provider]).find((entry) => entry.groupId === manualGroupId);
        // DEFECT: the [provider] single-element array call is
        // served by list_options_for_single_provider below, which
        // duplicates the per-provider body of
        // listCompactionChannelOptions (the JSON doc surface has
        // no sub-array construction).
        let options = CompactionChannelOptions { entries: [CompactionChannelOption { provider_id_ptr: PTR_NULL(), provider_id_len: 0, provider_name_ptr: PTR_NULL(), provider_name_len: 0, group_id_ptr: PTR_NULL(), group_id_len: 0, group_id_is_null: true, group_name_ptr: PTR_NULL(), group_name_len: 0, models: [0u64; 64], model_ptrs: [PTR_NULL(); 64], models_len: 0 }; 64], len: 0 };
        list_options_for_single_provider(provider, &options);
        let found_opt: u64 = 0;
        let has_opt = false;
        for oi in 0..options.len {
            let e = &options.entries[oi];
            if mgl == 0 {
                if e.group_id_is_null { found_opt = oi; has_opt = true; break; };
            } else {
                if !e.group_id_is_null && e.group_id_len == mgl && str_eq_lit(e.group_id_ptr, e.group_id_len, mg, mgl) { found_opt = oi; has_opt = true; break; };
            };
        }
        if !has_opt {
            readiness_fail(out, STR_PTR("group-missing"), STR_LEN("group-missing"), STR_PTR("所选压缩渠道分组已不可用。"), STR_LEN("所选压缩渠道分组已不可用。"), true);
            return;
        };
        let opt = &options.entries[found_opt];
        let model_found = false;
        for mi in 0..opt.models_len {
            let mp2: ptr = opt.model_ptrs[mi];
            let ml2: u64 = opt.models[mi];
            if str_eq_lit(mp2, ml2, mf, mfl) { model_found = true; break; };
        }
        if !model_found {
            // detail: `所选压缩模型 ${manualFreeModel} 已不在该渠道中。`
            // DEFECT: template literal interpolation (see above).
            readiness_fail(out, STR_PTR("manual-model-unavailable"), STR_LEN("manual-model-unavailable"), STR_PTR("所选压缩模型已不在该渠道中。"), STR_LEN("所选压缩模型已不在该渠道中。"), true);
            return;
        };
        out.ok = true;
        out.provider_id_ptr = opt.provider_id_ptr;
        out.provider_id_len = opt.provider_id_len;
        out.group_id_ptr = opt.group_id_ptr;
        out.group_id_len = opt.group_id_len;
        out.group_id_is_null = opt.group_id_is_null;
        out.model_ptr = mf;
        out.model_len = mfl;
        out.mapped_from_ptr = cm;
        out.mapped_from_len = cml;
        out.source_ptr = STR_PTR("manual");
        out.source_len = STR_LEN("manual");
        return;
    };
    readiness_fail(out, STR_PTR("manual-route-incomplete"), STR_LEN("manual-route-incomplete"), STR_PTR("免费压缩不再自动映射聊天模型；请手动选择压缩渠道、分组和真实模型。"), STR_LEN("免费压缩不再自动映射聊天模型；请手动选择压缩渠道、分组和真实模型。"), true);
}

// DEFECT: helper for the [provider] single-element call above —
// runs the same per-provider option construction as
// listCompactionChannelOptions for exactly one provider node.
fn list_options_for_single_provider(provider: u64, out: &CompactionChannelOptions) -> void {
    out.len = 0;
    let pid: ptr = PTR_NULL();
    let pidl: u64 = 0;
    fstr(provider, STR_PTR("id"), STR_LEN("id"), &pid, &pidl);
    let pname: ptr = PTR_NULL();
    let pnamel: u64 = 0;
    fstr(provider, STR_PTR("name"), STR_LEN("name"), &pname, &pnamel);
    let native = fobj(provider, STR_PTR("nativeModels"), STR_LEN("nativeModels"));
    let groups = fobj(provider, STR_PTR("groups"), STR_LEN("groups"));
    let tg_len: u64 = 0;
    let gn = arr_len(groups);
    let text_groups = [0u64; 128];
    for gi in 0..gn {
        if tg_len >= 128 { break; };
        let g = arr_at(groups, gi);
        let kp: ptr = PTR_NULL();
        let kl: u64 = 0;
        let is_image = false;
        if fstr(g, STR_PTR("kind"), STR_LEN("kind"), &kp, &kl) {
            if str_eq_lit(kp, kl, STR_PTR("image"), STR_LEN("image")) { is_image = true; };
        };
        if is_image { continue; };
        if !group_not_disabled(g) { continue; };
        text_groups[tg_len] = g;
        tg_len = tg_len + 1;
    }
    if tg_len == 0 {
        if arr_len(native) > 0 {
            let opt = &out.entries[0];
            opt.provider_id_ptr = pid;
            opt.provider_id_len = pidl;
            opt.provider_name_ptr = pname;
            opt.provider_name_len = pnamel;
            opt.group_id_is_null = true;
            opt.group_id_len = 0;
            opt.group_name_ptr = STR_PTR("默认分组");
            opt.group_name_len = STR_LEN("默认分组");
            fill_models(opt, native);
            out.len = 1;
        };
        return;
    };
    for ti in 0..tg_len {
        if out.len >= 64 { break; };
        let g2 = text_groups[ti];
        let opt2 = &out.entries[out.len];
        opt2.provider_id_ptr = pid;
        opt2.provider_id_len = pidl;
        opt2.provider_name_ptr = pname;
        opt2.provider_name_len = pnamel;
        let gp: ptr = PTR_NULL();
        let gl: u64 = 0;
        fstr(g2, STR_PTR("id"), STR_LEN("id"), &gp, &gl);
        opt2.group_id_ptr = gp;
        opt2.group_id_len = gl;
        opt2.group_id_is_null = false;
        fstr(g2, STR_PTR("name"), STR_LEN("name"), &gp, &gl);
        opt2.group_name_ptr = gp;
        opt2.group_name_len = gl;
        let gmodels = fobj(g2, STR_PTR("models"), STR_LEN("models"));
        if arr_len(gmodels) > 0 { fill_models(opt2, gmodels); } else { fill_models(opt2, native); };
        out.len = out.len + 1;
    }
}

// TS: export function shouldBlockFreeCompactionSelection(readiness): boolean
fn shouldBlockFreeCompactionSelection(readiness: &FreeCompactionReadiness) -> bool {
    if readiness.ok { return false; };
    return !str_eq_lit(readiness.reason_ptr, readiness.reason_len, STR_PTR("no-active-thread"), STR_LEN("no-active-thread"));
}

//  Human-friendly summary for a failed readiness check, suitable for notices.
// TS: export function describeFreeCompactionUnready(reason, detail?): string
fn describeFreeCompactionUnready(reason_ptr: ptr, reason_len: u64, detail_ptr: ptr, detail_len: u64, detail_has: bool, out: &StrBuf) -> void {
    out.len = 0;
    if str_eq_lit(reason_ptr, reason_len, STR_PTR("no-active-thread"), STR_LEN("no-active-thread")) {
        sb_append_lit(out, STR_PTR("Open a conversation before enabling free compaction."), STR_LEN("Open a conversation before enabling free compaction."));
    } else if str_eq_lit(reason_ptr, reason_len, STR_PTR("remote-workspace"), STR_LEN("remote-workspace")) {
        sb_append_lit(out, STR_PTR("Free compaction is only available in the local workspace mode."), STR_LEN("Free compaction is only available in the local workspace mode."));
    } else if str_eq_lit(reason_ptr, reason_len, STR_PTR("no-current-model"), STR_LEN("no-current-model")) {
        sb_append_lit(out, STR_PTR("Select a model before enabling free compaction."), STR_LEN("Select a model before enabling free compaction."));
    } else if str_eq_lit(reason_ptr, reason_len, STR_PTR("provider-missing"), STR_LEN("provider-missing")) {
        if detail_has { sb_append(out, detail_ptr, detail_len); } else { sb_append_lit(out, STR_PTR("The free relay (omniroute-free) has not been added. Sync free models first."), STR_LEN("The free relay (omniroute-free) has not been added. Sync free models first.")); };
    } else if str_eq_lit(reason_ptr, reason_len, STR_PTR("group-missing"), STR_LEN("group-missing")) {
        if detail_has { sb_append(out, detail_ptr, detail_len); } else { sb_append_lit(out, STR_PTR("The free relay group was not found. Sync free models first."), STR_LEN("The free relay group was not found. Sync free models first.")); };
    } else if str_eq_lit(reason_ptr, reason_len, STR_PTR("group-empty"), STR_LEN("group-empty")) {
        sb_append_lit(out, STR_PTR("The free relay has no synced models yet. Sync free models first."), STR_LEN("The free relay has no synced models yet. Sync free models first."));
    } else if str_eq_lit(reason_ptr, reason_len, STR_PTR("manual-route-incomplete"), STR_LEN("manual-route-incomplete")) {
        if detail_has { sb_append(out, detail_ptr, detail_len); } else { sb_append_lit(out, STR_PTR("请完整选择压缩渠道、分组和模型。"), STR_LEN("请完整选择压缩渠道、分组和模型。")); };
    } else if str_eq_lit(reason_ptr, reason_len, STR_PTR("manual-model-unavailable"), STR_LEN("manual-model-unavailable")) {
        if detail_has { sb_append(out, detail_ptr, detail_len); } else { sb_append_lit(out, STR_PTR("The selected free compaction model is no longer available. Choose another free model."), STR_LEN("The selected free compaction model is no longer available. Choose another free model.")); };
    };
}
