// Converted 1:1 from frontends/free-mode/src/free/VmContextSavingsTab.tsx (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
// SAX: no behavior counterpart — hooks, state setters (setSavings /
// setVmDraft), event handlers and computed style values are kept
// as structure with bind comments only. DEFECT: SAX: no behavior counterpart
// Imports in source: @mui/material (Alert, Box, Stack, Switch,
// TextField, Typography), @mui/material/styles (alpha),
// @codex-ui/shared types (SaVmContextSavingsConfig,
// SaVmPolicyConfig), react types (Dispatch, SetStateAction).
// DEFECT: MUI components have no SAX widget counterparts; tag
// names are preserved verbatim.

<Row title={string} desc={string} testId={string} checked={boolean} onChange={function} activeColor={string?} badge={string?} extra={ReactNode?}>
  <!-- bind: const color = props.activeColor ?? "primary" -->
  <!-- bind: const bg = color === "warning" ? (theme) => alpha(theme.palette.warning.main, 0.04) : color === "info" ? (theme) => alpha(theme.palette.info.main, 0.04) : (theme) => alpha(theme.palette.primary.main, 0.035) -->
  <!-- bind: const border = props.checked ? (color === "warning" ? "warning.light" : color === "info" ? "info.light" : "primary.light") : "divider" -->
  <Box sx="{ p: 1.5, border: '1px solid', borderColor: border, borderRadius: 2, bgcolor: props.checked ? bg : 'transparent' }">
    <Stack direction="row" alignItems="center" justifyContent="space-between">
      <Box sx="{ pr: 2 }">
        <Typography variant="body2" sx="{ fontWeight: 750 }">
          <!-- bind: props.title -->
          <!-- if: props.badge -->
          <Typography component="span" variant="caption" color="text.secondary" sx="{ ml: 1 }">
            <!-- bind: props.badge -->
          </Typography>
          <!-- /if -->
        </Typography>
        <Typography variant="caption" color="text.secondary">
          <!-- bind: props.desc -->
        </Typography>
      </Box>
      <Switch data-testid={props.testId} checked={props.checked} onChange="{(e) => props.onChange(e.target.checked)}" />
    </Stack>
    <!-- bind: props.extra -->
  </Box>
</Row>

<VmContextSavingsTab vmDraft={SaVmPolicyConfig} setVmDraft={Dispatch}>
  <!-- bind: const s = vmDraft.contextSavings ?? {} -->
  <Box sx="{ display: 'flex', flexDirection: 'column', gap: 1.5 }">
    <Typography variant="subtitle2" sx="{ fontWeight: 850 }">上下文节省 (Context Savings)</Typography>
    <Alert severity="info" sx="{ mb: 0.5 }">开启策略后默认全选开启各项上下文优化，最大化节省 Token；按线程生效，切换线程互不干扰。</Alert>
    <Stack spacing={1.25}>
      <!-- 上下文优化全选开关 -->
      <!-- bind: IIFE — const isAllSavingsChecked = Boolean(s.locateBeforeRead && s.grepCircuitBreaker && s.slimRunnerOutput && s.parallelBudget && s.parallelDeduplication && s.tieredSkillInjection && s.foldWaterfallEvents && s.foldHistoryReadSummaries) -->
      <Box sx="{ p: 1.5, border: '1.5px solid', borderColor: isAllSavingsChecked ? 'primary.main' : 'divider', borderRadius: 2, bgcolor: isAllSavingsChecked ? (theme) => alpha(theme.palette.primary.main, 0.06) : (theme) => alpha(theme.palette.action.hover, 0.03) }">
        <Stack direction="row" alignItems="center" justifyContent="space-between">
          <Box sx="{ pr: 2 }">
            <Typography variant="body2" sx="{ fontWeight: 850 }">上下文优化全选 (Select All Context Savings)</Typography>
            <Typography variant="caption" color="text.secondary">一键全选开启全部 8 项上下文裁剪与吞吐优化（大文件先定位后精读、grep输出熔断、测试构建瘦身、并行字节预算、同批去重、Skill分级注入、瀑布流事件折叠、只读输出自动折叠），最大化节省 Token 消耗并提升模型长上下文吞吐能力。</Typography>
          </Box>
          <Switch data-testid="composer-vm-toggle-all-context-savings" checked={isAllSavingsChecked} onChange="{(e) => { const checked = e.target.checked; setSavings(setVmDraft, { locateBeforeRead: checked, grepCircuitBreaker: checked, slimRunnerOutput: checked, parallelBudget: checked, parallelDeduplication: checked, tieredSkillInjection: checked, foldWaterfallEvents: checked, foldHistoryReadSummaries: checked }); }}" />
        </Stack>
      </Box>
      <!-- /bind IIFE -->

      <Row title="OPT-1 先定位后精读" desc="大文件 read_file 超阈值自动拒绝（默认 50KB），引导改用 read_lines / find_references。" testId="composer-vm-savings-locate" checked={s.locateBeforeRead === true} onChange="{(v) => setSavings(setVmDraft, { locateBeforeRead: v })}">
        <!-- extra: if s.locateBeforeRead === true -->
        <Box sx="{ mt: 1, maxWidth: 240 }">
          <TextField size="small" type="number" label="大文件阈值 KB（默认 50）" value={Math.round((s.maxReadFileBytes ?? 50 * 1024) / 1024)} onChange="{(e) => { const kb = Number(e.target.value); if (Number.isFinite(kb) && kb > 0) setSavings(setVmDraft, { maxReadFileBytes: Math.round(kb * 1024) }); }}" inputProps="{ 'aria-label': '大文件阈值 KB', min: 1 }" />
        </Box>
        <!-- /extra -->
      </Row>
      <Row title="OPT-2 grep 输出熔断" desc="结果超上限截断并标注；Token 超限时只回路径与行号。" testId="composer-vm-savings-grep" checked={s.grepCircuitBreaker === true} onChange="{(v) => setSavings(setVmDraft, { grepCircuitBreaker: v })}">
        <!-- extra: if s.grepCircuitBreaker === true -->
        <Stack direction="{ xs: 'column', sm: 'row' }" spacing={1} sx="{ mt: 1 }">
          <TextField size="small" type="number" label="max_results（默认 50）" value={s.grepMaxResults ?? 50} onChange="{(e) => { const v = Number(e.target.value); if (Number.isFinite(v) && v > 0) setSavings(setVmDraft, { grepMaxResults: Math.round(v) }); }}" inputProps="{ 'aria-label': 'grep max results', min: 1 }" />
          <TextField size="small" type="number" label="max_tokens（默认 3000）" value={s.grepMaxTokens ?? 3000} onChange="{(e) => { const v = Number(e.target.value); if (Number.isFinite(v) && v > 0) setSavings(setVmDraft, { grepMaxTokens: Math.round(v) }); }}" inputProps="{ 'aria-label': 'grep max tokens', min: 1 }" />
        </Stack>
        <!-- /extra -->
      </Row>
      <Row title="OPT-3 测试构建输出瘦身" desc="成功只回关键行摘要；失败保留完整定位。" testId="composer-vm-savings-slim" checked={s.slimRunnerOutput === true} onChange="{(v) => setSavings(setVmDraft, { slimRunnerOutput: v })}" />
      <Row title="OPT-4 并行字节预算" desc="整批全文 read 超 K 个直接拒绝；单项超 20KB 与总量超预算截断并标注。" testId="composer-vm-savings-budget" checked={s.parallelBudget === true} onChange="{(v) => setSavings(setVmDraft, { parallelBudget: v })}">
        <!-- extra: if s.parallelBudget === true -->
        <Stack direction="{ xs: 'column', sm: 'row' }" spacing={1} sx="{ mt: 1 }">
          <TextField size="small" type="number" label="总预算 KB（默认 200）" value={Math.round((s.parallelMaxTotalBytes ?? 200 * 1024) / 1024)} onChange="{(e) => { const kb = Number(e.target.value); if (Number.isFinite(kb) && kb > 0) setSavings(setVmDraft, { parallelMaxTotalBytes: Math.round(kb * 1024) }); }}" inputProps="{ 'aria-label': '并行总预算 KB', min: 1 }" />
          <TextField size="small" type="number" label="全文 read 上限 K（默认 4）" value={s.parallelMaxReadFiles ?? 4} onChange="{(e) => { const v = Number(e.target.value); if (Number.isFinite(v) && v > 0) setSavings(setVmDraft, { parallelMaxReadFiles: Math.round(v) }); }}" inputProps="{ 'aria-label': '全文 read 上限', min: 1 }" />
        </Stack>
        <!-- /extra -->
      </Row>
      <Row title="OPT-9 同批去重" desc="同批相同调用只执行一次，结果共享并标注。" testId="composer-vm-savings-dedup" checked={s.parallelDeduplication === true} onChange="{(v) => setSavings(setVmDraft, { parallelDeduplication: v })}" />
      <Row title="OPT-5 Skill 分级注入" desc="首轮全量，后续只注摘要；写操作相关小节按需展开。" testId="composer-vm-savings-tiered" checked={s.tieredSkillInjection === true} onChange="{(v) => setSavings(setVmDraft, { tieredSkillInjection: v })}" activeColor="warning" badge="实验性" />
      <Row title="OPT-6 瀑布流事件折叠" desc="只折叠发给模型的 turn 历史中间事件；UI 显示与存档不动。" testId="composer-vm-savings-fold-events" checked={s.foldWaterfallEvents === true} onChange="{(v) => setSavings(setVmDraft, { foldWaterfallEvents: v })}" activeColor="warning" badge="实验性" />
      <Row title="OPT-7 只读输出自动折叠" desc="只读输出超 N 轮变摘要占位符；写操作永不折叠，只动模型视图。" testId="composer-vm-savings-fold-history" checked={s.foldHistoryReadSummaries === true} onChange="{(v) => setSavings(setVmDraft, { foldHistoryReadSummaries: v })}" activeColor="warning" badge="实验性">
        <!-- extra: if s.foldHistoryReadSummaries === true -->
        <Box sx="{ mt: 1, maxWidth: 240 }">
          <TextField size="small" type="number" label="N 轮阈值（默认 4）" value={s.historyReadFoldTurns ?? 4} onChange="{(e) => { const v = Number(e.target.value); if (Number.isFinite(v) && v > 0) setSavings(setVmDraft, { historyReadFoldTurns: Math.round(v) }); }}" inputProps="{ 'aria-label': '折叠轮数阈值', min: 1 }" />
        </Box>
        <!-- /extra -->
      </Row>
      <Row title="自主修剪过时工具输出 (clear_tool_history)" desc="在长对话探索结束后，大模型可自主将过时的只读检索与文件输出原地替换为简短占位符，释放上下文窗口（省上下文，不影响安全）。" testId="composer-vm-savings-clear-tool-history" checked={vmDraft.tools?.clearToolHistory === true} onChange="{(v) => setVmDraft((curr) => ({ ...curr, tools: { ...curr.tools, clearToolHistory: v } }))}" activeColor="primary" badge="省上下文 · 不影响安全" />
    </Stack>
  </Box>
</VmContextSavingsTab>
