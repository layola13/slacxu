// Converted 1:1 from frontends/vmtool-security/src/web.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "./manifest.sla"
@import "sa_std/string.sa"
// TS re-exports:
//   export { VMTOOL_SECURITY_MANIFEST } from "./manifest.js";  (above import)
//   export { VmToolsSettingsTab } from "./security/VmToolsSettingsTab.js";
//   (converted in ./security/VmToolsSettingsTab.sax alongside this file).

//
// VM tool security — web side (kind "service"). Owns the VM tools
// settings tab (`src/security/VmToolsSettingsTab.tsx`, moved
// verbatim from the host): the sandbox/policy configuration UI the
// composer opens. It reads JEV config from the cxu-frontend-jev
// plugin (cross-plugin staging edge), as before.
//

// DEFECT: the WebFeaturePlugin type comes from @cxu/sdk-frontend,
// which has no SLA counterpart yet. The shape below mirrors the
// TS object 1:1; contribution entries are fixed arrays + len.
struct WebFeaturePlugin {
    manifest: PluginManifest,
    settings_panels: [SettingsPanelContribution; 4],
    settings_panels_len: u64,
}

struct SettingsPanelContribution {
    id_ptr: ptr,
    id_len: u64,
    title_key_ptr: ptr,
    title_key_len: u64,
    render_id: u64,
}

// TS: render: () => { throw new Error("vmtool-security renders
// through the composer's direct VmToolsSettingsTab import
// during staging"); }
// DEFECT: closures and throw have no SLA counterpart; the render
// callback is represented by render_id and this stub, which
// returns the staging error as a status code.
fn vmtool_security_panel_render() -> i32 {
    // error: "vmtool-security renders through the composer's direct VmToolsSettingsTab import during staging"
    return 90;
}

// TS: export const vmToolSecurityWebPlugin: WebFeaturePlugin = { ... };
// export default vmToolSecurityWebPlugin; (SLA has no default
// export; the builder function below is the export.)
fn build_vmToolSecurityWebPlugin(out: &WebFeaturePlugin) -> i32 {
    let mst = load_VMTOOL_SECURITY_MANIFEST(&out.manifest);
    if mst != 0 { return mst; };
    out.settings_panels_len = 1;
    out.settings_panels[0].id_ptr = STR_PTR("vmtool-security");
    out.settings_panels[0].id_len = STR_LEN("vmtool-security");
    out.settings_panels[0].title_key_ptr = STR_PTR("settings.nav.security");
    out.settings_panels[0].title_key_len = STR_LEN("settings.nav.security");
    out.settings_panels[0].render_id = 1;
    return 0;
}
