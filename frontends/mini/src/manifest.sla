// Converted 1:1 from frontends/mini/src/manifest.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "sa_std/fs.sai"

/**
 * Mini Agent manifest — the single source is ../plugin.json; both sides
 * import it from here so the web side never pulls in server code.
 */
// DEFECT: PluginManifest typed fields live in @cxu/sdk-frontend,
// which has no SLA counterpart yet; the manifest is carried as
// its raw plugin.json text (parsed on demand via sa_json_*).
struct PluginManifest {
    json_bytes: [u8; 8192],
    json_len: u64,
}

// DEFECT: TS uses a JSON module import (`with { type: "json" }`,
// inlined at bundle time); SLA has no JSON module import, so the
// manifest is read from ../plugin.json at load time instead.
fn load_MINI_MANIFEST(out: &PluginManifest) -> i32 {
    let total: u64 = 0;
    if sa_std_fs_len(STR_PTR("../plugin.json"), STR_LEN("../plugin.json"), &total) != 0 { return 3; };
    if total > 8192 { return 6; };
    let fh: u64 = 0;
    if sa_std_fs_open_read(STR_PTR("../plugin.json"), STR_LEN("../plugin.json"), &fh) != 0 { return 6; };
    let read_n: u64 = 0;
    let rst = sa_std_fs_file_read(fh, &out.json_bytes, 8192, &read_n);
    sa_fs_file_close(fh);
    if rst != 0 { return 6; };
    out.json_len = read_n;
    return 0;
}
