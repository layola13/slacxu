// Converted 1:1 from frontends/enhance/src/enhance/EnhanceToolsDialog.tsx (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
// SAX: no behavior counterpart — useState/useEffect hooks,
// handleToggleAll/handleToggleSingle/handleSave (async onSave)
// and all handlers are structure + bind comments only. Strings
// via the host TranslateFn t() are bind comments with keys.
// DEFECT: SAX: no behavior counterpart
// Imports in source: react (useState, useEffect), @mui/material
// (Alert, Box, Button, Dialog, DialogActions, DialogContent,
// DialogTitle, Divider, FormControlLabel, IconButton, Stack,
// Switch, Typography), @mui/icons-material (Close, AutoAwesome,
// Article, Search, Edit, AccountTree, BuildCircle,
// CleaningServices, Psychology, Gavel, KeyOff), alpha,
// @codex-ui/shared (ENHANCE_TOOLS_KEYS, countActiveEnhanceTools,
// setAllEnhanceTools; types SaVmPolicyConfig, SaVmToolsConfig,
// SaVmAccountabilityConfig — shared-package unit),
// @cxu/sdk-frontend type TranslateFn.
// DEFECT: MUI components/icons have no SAX counterparts; tag
// names preserved verbatim.

<EnhanceToolsDialog open={boolean} onClose={function} policy={SaVmPolicyConfig?} onSave={function} jevKeyConfigured={boolean?} t={TranslateFn}>
  <!-- state: toolsDraft: SaVmToolsConfig = useState(policy?.tools ?? {}) -->
  <!-- state: accountabilityDraft: SaVmAccountabilityConfig = useState(() => ({ enabled: false, autoPenalize: true, reputationThresholdRed: 50, reputationThresholdYellow: 80, ...(policy?.accountability ?? {}) })) -->
  <!-- effect: useEffect(() => { if (open) { setToolsDraft(policy?.tools ?? {}); setAccountabilityDraft({ enabled: false, autoPenalize: true, reputationThresholdRed: 50, reputationThresholdYellow: 80, ...(policy?.accountability ?? {}) }); } }, [open, policy]) -->
  <!-- bind: const activeCount = countActiveEnhanceTools(toolsDraft) -->
  <!-- bind: const isAllChecked = activeCount === ENHANCE_TOOLS_KEYS.length -->
  <!-- bind: const handleToggleAll = (checked) => setToolsDraft((prev) => setAllEnhanceTools(prev, checked)) -->
  <!-- bind: const handleToggleSingle = (key, checked) => setToolsDraft((prev) => ({ ...prev, [key]: checked })) -->
  <!-- bind: const handleSave = async () => { const isJevConfigured = jevKeyConfigured !== false; const updatedPolicy = { ...policy, tools: { ...policy?.tools, ...toolsDraft }, accountability: { ...policy?.accountability, ...accountabilityDraft, enabled: isJevConfigured ? accountabilityDraft.enabled === true : false } }; await onSave(updatedPolicy); onClose(); } — DEFECT: async -->

  <Dialog open={open} onClose={onClose} fullWidth={true} maxWidth="md" data-testid="composer-enhance-dialog">
    <DialogTitle sx="{ display: 'flex', alignItems: 'center', gap: 1.25, pr: 1, fontWeight: 850 }">
      <AutoAwesomeIcon color="primary" fontSize="medium" />
      <Typography component="span" variant="h6" sx="{ flex: 1, fontWeight: 850 }">代码智能与增强工具 (Code Enhancement Tools)</Typography>
      <FormControlLabel sx="{ m: 0, mr: 1 }" label="{<Typography variant='body2' sx='{ fontWeight: 700 }'>一键全选开启</Typography>}">
        <!-- control -->
        <Switch checked={isAllChecked} onChange="{(e) => handleToggleAll(e.target.checked)}" data-testid="composer-enhance-toggle-all" />
      </FormControlLabel>
      <IconButton aria-label="关闭" onClick={onClose} size="small" data-testid="composer-enhance-close">
        <CloseIcon fontSize="small" />
      </IconButton>
    </DialogTitle>
    <DialogContent dividers={true} sx="{ p: 2.5 }">
      <Alert severity="info" sx="{ mb: 2.5, borderRadius: 2 }">
        <strong>已与安全沙箱彻底解耦</strong>：增强工具集成高性能防爆流读取、毫秒级 tail 日志追踪、极速 ripgrep 检索、精准局部代码编辑、AST 语义分析与即时语法诊断。开启增强工具<strong>不限制终端命令行、不拦截 Shell、无 SLA 语法规则束缚</strong>，全流程原生极速执行。
      </Alert>

      <!-- 1. 防爆流大文件读取与日志追踪 -->
      <Box sx="{ mb: 3 }">
        <Stack direction="row" spacing={1} alignItems="center" sx="{ mb: 1.25 }">
          <ArticleIcon fontSize="small" color="primary" />
          <Typography variant="subtitle2" sx="{ fontWeight: 850, color: 'text.primary' }">1. 防爆流大文件读取与日志追踪 (Token-Safe Reading &amp; Log Tail)</Typography>
        </Stack>
        <Stack spacing={1.25}>
          <ToolRow title="防爆流安全读取与毫秒级日志追踪 (read_file / read_lines / read_file_tail)" desc="内置 Token Headroom 熔断保护，防止大文件或压缩包挤爆上下文；支持按行分页（read_lines）及从文件末尾毫秒级直接 tail 读取（read_file_tail），排查日志极速省流。" testId="composer-enhance-toggle-read-files" checked={toolsDraft.readFiles === true || toolsDraft.replaceRead === true} onChange="{(checked) => handleToggleSingle('readFiles', checked)}" />
        </Stack>
      </Box>

      <Divider sx="{ my: 2.5 }" />

      <!-- 2. 极速检索与全局浏览 -->
      <Box sx="{ mb: 3 }">
        <Stack direction="row" spacing={1} alignItems="center" sx="{ mb: 1.25 }">
          <SearchIcon fontSize="small" color="primary" />
          <Typography variant="subtitle2" sx="{ fontWeight: 850, color: 'text.primary' }">2. 极速检索与全局浏览 (Fast Ripgrep Search &amp; Discovery)</Typography>
        </Stack>
        <Stack spacing={1.25}>
          <ToolRow title="ripgrep 极速搜索与并发检索 (fastSearch: grep / grep_search_async / find_files / list_dir)" desc="原生 ripgrep 多核加速，支持 grep_search_async 批量多词高并发检索与智能熔断保护；秒级 glob 文件探测 (find_files) 与目录浏览 (list_dir)，免去终端慢速查找命令。" testId="composer-enhance-toggle-fast-search" checked={toolsDraft.fastSearch === true} onChange="{(checked) => handleToggleSingle('fastSearch', checked)}" />
        </Stack>
      </Box>

      <Divider sx="{ my: 2.5 }" />

      <!-- 3. 精准代码编辑与批量补丁 -->
      <Box sx="{ mb: 3 }">
        <Stack direction="row" spacing={1} alignItems="center" sx="{ mb: 1.25 }">
          <EditIcon fontSize="small" color="primary" />
          <Typography variant="subtitle2" sx="{ fontWeight: 850, color: 'text.primary' }">3. 精准代码编辑与批量补丁 (Precision Editing &amp; Unified Patch)</Typography>
        </Stack>
        <Stack spacing={1.25}>
          <ToolRow title="精准局部编辑与原子写 (edit_file / write_file)" desc="基于唯一文本锚点定位替换（edit_file），无需重写整个大文件，极致省 Token 并杜绝误篡改；支持原子安全写入（write_file）。" testId="composer-enhance-toggle-edit-files" checked={toolsDraft.editFiles === true || toolsDraft.replaceWrite === true} onChange="{(checked) => handleToggleSingle('editFiles', checked)}" />
          <ToolRow title="多文件统一补丁执行 (apply_patch)" desc="标准 unified diff 补丁批量原子应用，支持多文件同时修改，遇到冲突自动安全回滚。" testId="composer-enhance-toggle-apply-patch" checked={toolsDraft.applyPatch === true || toolsDraft.replaceApplyPatch === true} onChange="{(checked) => handleToggleSingle('applyPatch', checked)}" />
        </Stack>
      </Box>

      <Divider sx="{ my: 2.5 }" />

      <!-- 4. AST 语义与智能重构 -->
      <Box sx="{ mb: 3 }">
        <Stack direction="row" spacing={1} alignItems="center" sx="{ mb: 1.25 }">
          <AccountTreeIcon fontSize="small" color="primary" />
          <Typography variant="subtitle2" sx="{ fontWeight: 850, color: 'text.primary' }">4. AST 语义与智能重构 (AST Semantic Refactoring)</Typography>
        </Stack>
        <Stack spacing={1.25}>
          <ToolRow title="代码文件结构大纲提取 (file_outline)" desc="基于 Tree-sitter 秒级提取源文件的类、函数、接口、枚举与行号范围，避免盲目读取超大文件挤爆上下文。" testId="composer-enhance-toggle-file-outline" checked={toolsDraft.fileOutline === true} onChange="{(checked) => handleToggleSingle('fileOutline', checked)}" />
          <ToolRow title="即时类继承与模块依赖关系图 (code_graph)" desc="毫秒级解析类继承 (extends)、接口实现 (implements)、成员所有权 (owns) 或模块引用 (imports) 拓扑，输出 Graphviz DOT 或 Python Stub，纯内存零落盘。" testId="composer-enhance-toggle-code-graph" checked={toolsDraft.codeGraph === true} onChange="{(checked) => handleToggleSingle('codeGraph', checked)}" />
          <ToolRow title="符号定义与实现预览 (find_definition)" desc="单步直达符号源定义，支持跨文件追踪 import 源头并直接预览函数体代码（最多40行），无需二次 read_file。" testId="composer-enhance-toggle-find-definition" checked={toolsDraft.findDefinition === true} onChange="{(checked) => handleToggleSingle('findDefinition', checked)}" />
          <ToolRow title="AST 语法级跨文件符号重命名 (rename_symbol)" desc="基于语法树原子替换，自动识别代码标识符，精准跳过注释、文档字面量与普通字符串，杜绝全局误伤。" testId="composer-enhance-toggle-rename-symbol" checked={toolsDraft.renameSymbol === true} onChange="{(checked) => handleToggleSingle('renameSymbol', checked)}" />
          <ToolRow title="超大文件模块化抽取 (extract_to_file)" desc="专治 App.tsx 等大文件瘦身：一键抽取代码块到新文件，自动补齐 export，自动提取外部依赖并重写源文件相对导入。" testId="composer-enhance-toggle-extract-to-file" checked={toolsDraft.extractToFile === true} onChange="{(checked) => handleToggleSingle('extractToFile', checked)}" />
          <ToolRow title="文件移动并自动重写导入 (move_file_with_imports)" desc="安全移动/重命名代码文件，自动扫描全工程并将所有引用它的相对导入路径无缝同步更新为新路径。" testId="composer-enhance-toggle-move-with-imports" checked={toolsDraft.moveWithImports === true} onChange="{(checked) => handleToggleSingle('moveWithImports', checked)}" />
        </Stack>
      </Box>

      <Divider sx="{ my: 2.5 }" />

      <!-- 5. 代码诊断与智能编辑 -->
      <Box sx="{ mb: 3 }">
        <Stack direction="row" spacing={1} alignItems="center" sx="{ mb: 1.25 }">
          <BuildCircleIcon fontSize="small" color="primary" />
          <Typography variant="subtitle2" sx="{ fontWeight: 850, color: 'text.primary' }">5. 代码诊断与智能编辑 (Code Diagnostics &amp; Editing)</Typography>
        </Stack>
        <Stack spacing={1.25}>
          <ToolRow title="单文件即时语法诊断 (get_diagnostics)" desc="毫秒级单文件语法与解析检查（TS/JS/Rust/Python/Go），内置 React Hook 违规调用守门，杜绝全量 tsc 等待与白屏崩溃。" testId="composer-enhance-toggle-get-diagnostics" checked={toolsDraft.getDiagnostics === true} onChange="{(checked) => handleToggleSingle('getDiagnostics', checked)}" />
          <ToolRow title="智能合包与导包插入 (add_import)" desc="智能将 import 注入文件头部规范位置；若目标模块已存在导入语句，自动就地合并（如 import { a, b } from '...'），杜绝行号漂移。" testId="composer-enhance-toggle-add-import" checked={toolsDraft.addImport === true} onChange="{(checked) => handleToggleSingle('addImport', checked)}" />
          <ToolRow title="自动整理与清理无用导入 (organize_imports)" desc="基于 AST 自动识别并剔除未使用的 import，合并同源多语句导入，并按标准层级顺序清晰排序。" testId="composer-enhance-toggle-organize-imports" checked={toolsDraft.organizeImports === true} onChange="{(checked) => handleToggleSingle('organizeImports', checked)}" />
          <ToolRow title="代码块作用域与闭包依赖分析 (analyze_scope)" desc="输入代码行号范围，精确计算该代码块引用了哪些外层 state/props，自动生成提取子组件所需的 Props 接口。" testId="composer-enhance-toggle-analyze-scope" checked={toolsDraft.analyzeScope === true} onChange="{(checked) => handleToggleSingle('analyzeScope', checked)}" />
        </Stack>
      </Box>

      <Divider sx="{ my: 2.5 }" />

      <!-- 6. 高效探索与上下文优化 -->
      <Box>
        <Stack direction="row" spacing={1} alignItems="center" sx="{ mb: 1.25 }">
          <CleaningServicesIcon fontSize="small" color="primary" />
          <Typography variant="subtitle2" sx="{ fontWeight: 850, color: 'text.primary' }">6. 高效探索与上下文优化 (Exploration &amp; Context Optimization)</Typography>
        </Stack>
        <Stack spacing={1.25}>
          <ToolRow title="查找符号所有引用与定向探索 (find_references)" desc="极致省 Token：路径唯一化，采用 e0(定义)/e1(导入)/e2(调用) 紧凑枚举；支持候选文件快速定向穿透，支持 Token 熔断保护。" testId="composer-enhance-toggle-find-references" checked={toolsDraft.findReferences === true} onChange="{(checked) => handleToggleSingle('findReferences', checked)}" />
          <ToolRow title="自主修剪过时工具输出 (clear_tool_history) · 省上下文，不影响安全" desc="纯 Token 上下文优化：在长对话探索完成后，大模型可自主将前期冗长的只读与检索输出原地精简为简短占位符，大幅释放上下文并延长对话记忆窗口，不影响任何安全防护策略。" testId="composer-enhance-toggle-clear-tool-history" checked={toolsDraft.clearToolHistory === true} onChange="{(checked) => handleToggleSingle('clearToolHistory', checked)}" />
        </Stack>
      </Box>

      <Divider sx="{ my: 2.5 }" />

      <!-- 7. JEV 主动决策助手 -->
      <Box>
        <Stack direction="row" spacing={1} alignItems="center" sx="{ mb: 1.25 }">
          <PsychologyIcon fontSize="small" color="primary" />
          <Typography variant="subtitle2" sx="{ fontWeight: 850, color: 'text.primary' }">
            <!-- bind: t('jev.enhance.sectionTitle') -->
          </Typography>
        </Stack>
        <!-- if: jevKeyConfigured === false -->
        <Alert severity="warning" sx="{ mb: 1.25, borderRadius: 2 }" data-testid="composer-enhance-jev-key-hint">
          <!-- bind: t('jev.enhance.keyHint') -->
        </Alert>
        <!-- /if -->
        <Stack spacing={1.25}>
          <ToolRow title={t('jev.enhance.chooseTitle')} desc={t('jev.enhance.chooseDesc')} testId="composer-enhance-toggle-jev-choose" checked={toolsDraft.jevChoose === true} onChange="{(checked) => handleToggleSingle('jevChoose', checked)}" />
          <ToolRow title={t('jev.enhance.checklistTitle')} desc={t('jev.enhance.checklistDesc')} testId="composer-enhance-toggle-jev-checklist" checked={toolsDraft.jevChecklist === true} onChange="{(checked) => handleToggleSingle('jevChecklist', checked)}" />
          <ToolRow title={t('jev.enhance.evaluateTitle')} desc={t('jev.enhance.evaluateDesc')} testId="composer-enhance-toggle-jev-evaluate" checked={toolsDraft.jevEvaluate === true} onChange="{(checked) => handleToggleSingle('jevEvaluate', checked)}" />
          <ToolRow title={t('jev.enhance.thinkingTitle')} desc={t('jev.enhance.thinkingDesc')} testId="composer-enhance-toggle-jev-thinking" checked={toolsDraft.jevThinking === true} onChange="{(checked) => handleToggleSingle('jevThinking', checked)}" />
          <ToolRow title={t('jev.enhance.redteamTitle')} desc={t('jev.enhance.redteamDesc')} testId="composer-enhance-toggle-jev-redteam" checked={toolsDraft.jevRedteam === true} onChange="{(checked) => handleToggleSingle('jevRedteam', checked)}" />
          <ToolRow title={t('jev.enhance.rankTitle')} desc={t('jev.enhance.rankDesc')} testId="composer-enhance-toggle-jev-rank" checked={toolsDraft.jevRank === true} onChange="{(checked) => handleToggleSingle('jevRank', checked)}" />
          <ToolRow title={t('jev.enhance.scopeTitle')} desc={t('jev.enhance.scopeDesc')} testId="composer-enhance-toggle-jev-scope" checked={toolsDraft.jevScope === true} onChange="{(checked) => handleToggleSingle('jevScope', checked)}" />
          <ToolRow title={t('jev.enhance.dispatchTitle')} desc={t('jev.enhance.dispatchDesc')} testId="composer-enhance-toggle-jev-dispatch" checked={toolsDraft.jevDispatch === true} onChange="{(checked) => handleToggleSingle('jevDispatch', checked)}" />
          <ToolRow title={t('jev.enhance.consistencyTitle')} desc={t('jev.enhance.consistencyDesc')} testId="composer-enhance-toggle-jev-consistency" checked={toolsDraft.jevConsistency === true} onChange="{(checked) => handleToggleSingle('jevConsistency', checked)}" />
          <ToolRow title={t('jev.enhance.doneTitle')} desc={t('jev.enhance.doneDesc')} testId="composer-enhance-toggle-jev-done" checked={toolsDraft.jevDone === true} onChange="{(checked) => handleToggleSingle('jevDone', checked)}" />
          <ToolRow title={t('jev.enhance.diagnoseTitle')} desc={t('jev.enhance.diagnoseDesc')} testId="composer-enhance-toggle-jev-diagnose" checked={toolsDraft.jevDiagnose === true} onChange="{(checked) => handleToggleSingle('jevDiagnose', checked)}" />
          <ToolRow title={t('jev.enhance.edgeCasesTitle')} desc={t('jev.enhance.edgeCasesDesc')} testId="composer-enhance-toggle-jev-edge-cases" checked={toolsDraft.jevEdgeCases === true} onChange="{(checked) => handleToggleSingle('jevEdgeCases', checked)}" />
          <ToolRow title={t('jev.enhance.blastRadiusTitle')} desc={t('jev.enhance.blastRadiusDesc')} testId="composer-enhance-toggle-jev-blast-radius" checked={toolsDraft.jevBlastRadius === true} onChange="{(checked) => handleToggleSingle('jevBlastRadius', checked)}" />
          <ToolRow title={t('jev.enhance.intentTitle')} desc={t('jev.enhance.intentDesc')} testId="composer-enhance-toggle-jev-intent" checked={toolsDraft.jevIntent === true} onChange="{(checked) => handleToggleSingle('jevIntent', checked)}" />
          <ToolRow title={t('jev.enhance.nextTitle')} desc={t('jev.enhance.nextDesc')} testId="composer-enhance-toggle-jev-next" checked={toolsDraft.jevNext === true} onChange="{(checked) => handleToggleSingle('jevNext', checked)}" />
          <ToolRow title={t('jev.enhance.compressTitle')} desc={t('jev.enhance.compressDesc')} testId="composer-enhance-toggle-jev-compress" checked={toolsDraft.jevCompress === true} onChange="{(checked) => handleToggleSingle('jevCompress', checked)}" />
          <ToolRow title={t('jev.enhance.progressTitle')} desc={t('jev.enhance.progressDesc')} testId="composer-enhance-toggle-jev-progress" checked={toolsDraft.jevProgress === true} onChange="{(checked) => handleToggleSingle('jevProgress', checked)}" />
          <ToolRow title={t('jev.enhance.memoryTitle')} desc={t('jev.enhance.memoryDesc')} testId="composer-enhance-toggle-jev-memory" checked={toolsDraft.jevMemory === true} onChange="{(checked) => handleToggleSingle('jevMemory', checked)}" />
        </Stack>
      </Box>

      <Divider sx="{ my: 2.5 }" />

      <!-- 8. 代码责任与错误惩罚机制 (Accountability & Auto-Immunization Ledger) -->
      <Box>
        <Stack direction="row" spacing={1} alignItems="center" sx="{ mb: 1.25 }">
          <GavelIcon fontSize="small" color="primary" />
          <Typography variant="subtitle2" sx="{ fontWeight: 850, color: 'text.primary' }">
            <!-- bind: t('accountability.sectionTitle') -->
          </Typography>
        </Stack>
        <!-- bind: jevKeyConfigured === false ? warning Alert (icon KeyOffIcon, t('accountability.keyHint'), data-testid composer-enhance-accountability-key-hint) : info Alert (t('accountability.info')) -->
        <Alert severity="warning" icon="{<KeyOffIcon fontSize='inherit' />}" sx="{ mb: 1.25, borderRadius: 2 }" data-testid="composer-enhance-accountability-key-hint">
          <!-- bind: t('accountability.keyHint') -->
        </Alert>
        <!-- /bind ternary (else branch: severity='info', no icon/testid, t('accountability.info')) -->
        <Stack spacing={1.25}>
          <ToolRow title={t('accountability.toggleTitle')} desc={jevKeyConfigured === false ? t('accountability.toggleDisabledDesc') : t('accountability.toggleDesc')} testId="composer-enhance-toggle-accountability" checked={jevKeyConfigured !== false && accountabilityDraft.enabled === true} disabled={jevKeyConfigured === false} onChange="{(checked) => { if (jevKeyConfigured === false) return; setAccountabilityDraft((prev) => ({ ...prev, enabled: checked })); }}" />
        </Stack>
      </Box>
    </DialogContent>
    <DialogActions sx="{ px: 2.5, py: 1.5, justifyContent: 'space-between' }">
      <Typography variant="caption" color="text.secondary">
        当前已激活 <!-- bind: activeCount --> / <!-- bind: ENHANCE_TOOLS_KEYS.length --> 项增强工具
      </Typography>
      <Stack direction="row" spacing={1}>
        <Button onClick={onClose} color="inherit">取消</Button>
        <Button variant="contained" onClick={handleSave} data-testid="composer-enhance-save" sx="{ fontWeight: 750 }">保存并应用</Button>
      </Stack>
    </DialogActions>
  </Dialog>
</EnhanceToolsDialog>

<ToolRow title={string} desc={string} testId={string} checked={boolean} onChange={function} disabled={boolean?}>
  <Box sx="{ p: 1.5, border: '1px solid', borderColor: checked ? 'primary.light' : 'divider', borderRadius: 2, bgcolor: (theme) => checked ? alpha(theme.palette.primary.main, 0.035) : 'transparent', opacity: disabled ? 0.65 : 1, transition: 'all 0.15s ease-in-out' }">
    <Stack direction="row" alignItems="center" justifyContent="space-between" spacing={2}>
      <Box sx="{ flex: 1 }">
        <Typography variant="body2" sx="{ fontWeight: 750, color: disabled ? 'text.disabled' : 'text.primary' }">
          <!-- bind: title -->
        </Typography>
        <Typography variant="caption" color="text.secondary" sx="{ display: 'block', mt: 0.25 }">
          <!-- bind: desc -->
        </Typography>
      </Box>
      <Switch data-testid={testId} checked={checked} disabled={disabled} onChange="{(e) => onChange(e.target.checked)}" />
    </Stack>
  </Box>
</ToolRow>
