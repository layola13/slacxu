// Converted 1:1 from frontends/enhance/src/web.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "./manifest.sla"
@import "sa_std/string.sa"
// TS re-export: export { EnhanceToolsDialog } from "./enhance/EnhanceToolsDialog.js";
// (converted in ./enhance/EnhanceToolsDialog.sax alongside this file).

//
// Code enhancement tools (kind "feature"). Owns the enhancement
// dialog (`src/enhance/EnhanceToolsDialog.tsx`, moved verbatim from
// the host) that the composer opens: per-tool toggles and prompts
// for the JEV-powered active tools. Execution lives in the
// cxu-backend-jev plugin; this plugin is the configuration surface.
//

// DEFECT: the WebFeaturePlugin type comes from @cxu/sdk-frontend,
// which has no SLA counterpart yet. The shape below mirrors the
// TS object 1:1; contribution entries are fixed arrays + len.
struct WebFeaturePlugin {
    manifest: PluginManifest,
    slots: [SlotContribution; 4],
    slots_len: u64,
    settings_panels: [SettingsPanelContribution; 4],
    settings_panels_len: u64,
}

struct SlotContribution {
    slot_ptr: ptr,
    slot_len: u64,
    // render: () => never (throws) in TS; see enhance_slot_render.
    render_id: u64,
}

struct SettingsPanelContribution {
    id_ptr: ptr,
    id_len: u64,
    title_key_ptr: ptr,
    title_key_len: u64,
    render_id: u64,
}

// TS: render: () => { throw new Error("enhance renders through the
// composer's direct EnhanceToolsDialog import during staging"); }
// DEFECT: closures and throw have no SLA counterpart; the render
// callback is represented by render_id and this stub, which
// returns the staging error as a status code.
fn enhance_slot_render() -> i32 {
    // error: "enhance renders through the composer's direct EnhanceToolsDialog import during staging"
    return 90;
}

// TS: export const enhanceWebPlugin: WebFeaturePlugin = { ... };
// export default enhanceWebPlugin; (SLA has no default export;
// the builder function below is the export.)
fn build_enhanceWebPlugin(out: &WebFeaturePlugin) -> i32 {
    let mst = load_ENHANCE_MANIFEST(&out.manifest);
    if mst != 0 { return mst; };
    out.slots_len = 1;
    out.slots[0].slot_ptr = STR_PTR("composer");
    out.slots[0].slot_len = STR_LEN("composer");
    out.slots[0].render_id = 1;
    out.settings_panels_len = 0;
    return 0;
}
