// Converted 1:1 from frontends/muse/src/web.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "./manifest.sla"
@import "sa_std/string.sa"

//  Muse — web side.
// DEFECT: the WebPlugin type comes from @cxu/sdk-frontend/web,
// which has no SLA counterpart yet. The shape below mirrors the
// TS object 1:1 with string fields as (ptr, len) pairs and null
// carried as PTR_NULL() + an is_null flag.
struct WebPlugin {
    manifest: PluginManifest,
    descriptor_id_ptr: ptr,
    descriptor_id_len: u64,
    descriptor_label_ptr: ptr,
    descriptor_label_len: u64,
    descriptor_icon_ptr: ptr,
    descriptor_icon_len: u64,
    descriptor_label_keys_name_ptr: ptr,
    descriptor_label_keys_name_len: u64,
    descriptor_built_in: bool,
    descriptor_default_backend: bool,
    installation_kind_ptr: ptr,
    installation_kind_len: u64,
    installation_kind_is_null: bool,
    provider_id_ptr: ptr,
    provider_id_len: u64,
    provider_id_is_null: bool,
    group_id_ptr: ptr,
    group_id_len: u64,
    group_id_is_null: bool,
    model_ptr: ptr,
    model_len: u64,
    model_is_null: bool,
    skip_activation: bool,
    classification_is_built_in_mini: bool,
    classification_family_ptr: ptr,
    classification_family_len: u64,
    waterfall_compaction_label_ptr: ptr,
    waterfall_compaction_label_len: u64,
}

// TS: export const museWebPlugin: WebPlugin = { ... };
// export default museWebPlugin; — SLA has no default
// export; the builder function below is the export.
fn build_museWebPlugin(out: &WebPlugin) -> i32 {
    let mst = load_MUSE_MANIFEST(&out.manifest);
    if mst != 0 { return mst; };
    out.descriptor_id_ptr = STR_PTR("muse");
    out.descriptor_id_len = STR_LEN("muse");
    out.descriptor_label_ptr = STR_PTR("Muse");
    out.descriptor_label_len = STR_LEN("Muse");
    out.descriptor_icon_ptr = STR_PTR("/icons/muse.png");
    out.descriptor_icon_len = STR_LEN("/icons/muse.png");
    out.descriptor_label_keys_name_ptr = STR_PTR("cliBackend.muse");
    out.descriptor_label_keys_name_len = STR_LEN("cliBackend.muse");
    out.descriptor_built_in = false;
    out.descriptor_default_backend = false;
    out.installation_kind_ptr = STR_PTR("muse");
    out.installation_kind_len = STR_LEN("muse");
    out.installation_kind_is_null = false;
    out.provider_id_ptr = PTR_NULL();
    out.provider_id_len = 0;
    out.provider_id_is_null = true;
    out.group_id_ptr = PTR_NULL();
    out.group_id_len = 0;
    out.group_id_is_null = true;
    out.model_ptr = PTR_NULL();
    out.model_len = 0;
    out.model_is_null = true;
    out.skip_activation = false;
    out.classification_is_built_in_mini = false;
    out.classification_family_ptr = STR_PTR("muse");
    out.classification_family_len = STR_LEN("muse");
    out.waterfall_compaction_label_ptr = STR_PTR("Muse");
    out.waterfall_compaction_label_len = STR_LEN("Muse");
    return 0;
}
