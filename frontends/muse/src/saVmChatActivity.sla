// Converted 1:1 from frontends/muse/src/saVmChatActivity.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "sa_std/encoding/json.sai"
@import "sa_std/ptr.sa"
@import "sa_std/string.sa"

// TS types: payload/item are Record<string, unknown> and
// ChatWaterfallRow comes from @cxu/sdk-frontend. DEFECT: dynamic
// objects — payloads and row.item are carried as JSON text and
// read through sa_json_* accessors; ChatWaterfallRow is reduced
// to (item JSON text, title) — the two fields this module reads.

struct StrBuf {
    bytes: [u8; 65536],
    len: u64,
}

fn sb_append(buf: &StrBuf, src_ptr: ptr, src_len: u64) -> void {
    for i in 0..src_len {
        if buf.len < 65536 {
            let b: u8 = 0;
            PTR_BYTE_AT(b, src_ptr, i);
            buf.bytes[buf.len] = b;
            buf.len = buf.len + 1;
        };
    }
}

fn sb_append_lit(buf: &StrBuf, lit_ptr: ptr, lit_len: u64) -> void {
    sb_append(buf, lit_ptr, lit_len);
}

fn sb_append_u64(buf: &StrBuf, v: u64) -> void {
    if v == 0 {
        if buf.len < 65536 { buf.bytes[buf.len] = 48; buf.len = buf.len + 1; };
        return;
    };
    let digits = [0u8; 20];
    let n: u64 = 0;
    let x = v;
    while x > 0 {
        digits[n] = (48 + (x % 10)) as u8;
        n = n + 1;
        x = x / 10;
    }
    let i = n;
    while i > 0 {
        i = i - 1;
        if buf.len < 65536 { buf.bytes[buf.len] = digits[i]; buf.len = buf.len + 1; };
    }
}

fn sb_append_i64(buf: &StrBuf, v: i64) -> void {
    if v < 0 {
        sb_append_lit(buf, STR_PTR("-"), STR_LEN("-"));
        sb_append_u64(buf, (0 - v) as u64);
    } else {
        sb_append_u64(buf, v as u64);
    };
}

fn str_eq_lit(a_ptr: ptr, a_len: u64, lit_ptr: ptr, lit_len: u64) -> bool {
    if a_len != lit_len { return false; };
    for i in 0..a_len {
        let x: u8 = 0;
        let y: u8 = 0;
        PTR_BYTE_AT(x, a_ptr, i);
        PTR_BYTE_AT(y, lit_ptr, i);
        if x != y { return false; };
    }
    return true;
}

fn str_contains(hay_ptr: ptr, hay_len: u64, nd_ptr: ptr, nd_len: u64) -> bool {
    if nd_len == 0 { return true; };
    if hay_len < nd_len { return false; };
    let last = hay_len - nd_len;
    let i: u64 = 0;
    while i <= last {
        let ok = true;
        for j in 0..nd_len {
            let x: u8 = 0;
            let y: u8 = 0;
            PTR_BYTE_AT(x, hay_ptr, i + j);
            PTR_BYTE_AT(y, nd_ptr, j);
            if x != y { ok = false; break; };
        }
        if ok { return true; };
        i = i + 1;
    }
    return false;
}

fn lower_into(src_ptr: ptr, src_len: u64, out: &StrBuf) -> void {
    out.len = 0;
    for i in 0..src_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, src_ptr, i);
        if b >= 65 && b <= 90 { b = b + 32; };
        if out.len < 65536 { out.bytes[out.len] = b; out.len = out.len + 1; };
    }
}

fn trim_into(src_ptr: ptr, src_len: u64, out_ptr: &ptr, out_len: &u64) -> void {
    let start: u64 = 0;
    let end = src_len;
    while start < end {
        let b: u8 = 0;
        PTR_BYTE_AT(b, src_ptr, start);
        if b == 32 || b == 9 || b == 10 || b == 13 { start = start + 1; } else { break; };
    }
    while end > start {
        let b2: u8 = 0;
        PTR_BYTE_AT(b2, src_ptr, end - 1);
        if b2 == 32 || b2 == 9 || b2 == 10 || b2 == 13 { end = end - 1; } else { break; };
    }
    let p: ptr = PTR_NULL();
    PTR_BYTE_ADD(p, src_ptr, start);
    *out_ptr = p;
    *out_len = end - start;
}

// JSON field reads over a doc node.
fn get_str(node: u64, key_ptr: ptr, key_len: u64, out_ptr: &ptr, out_len: &u64) -> bool {
    if node == 0 { return false; };
    let p: ptr = PTR_NULL();
    let l: u64 = 0;
    if sa_json_object_get_string(node, key_ptr, key_len, &p, &l) != 0 { return false; };
    *out_ptr = p;
    *out_len = l;
    return true;
}

fn get_node(node: u64, key_ptr: ptr, key_len: u64) -> u64 {
    if node == 0 { return 0; };
    let child: u64 = 0;
    if sa_json_object_get(node, key_ptr, key_len, &child) != 0 { return 0; };
    return child;
}

fn has_key(node: u64, key_ptr: ptr, key_len: u64) -> bool {
    return get_node(node, key_ptr, key_len) != 0;
}

fn arr_len(arr: u64) -> u64 {
    if arr == 0 { return 0; };
    let n: u64 = 0;
    while n < 100000 {
        let el: u64 = 0;
        if sa_json_array_get(arr, n, &el) != 0 { break; };
        n = n + 1;
    }
    return n;
}

// String(node) for the scalar field types the source stringifies
// (string | number | boolean). Writes into out; false when the
// field is absent or not a scalar.
fn scalar_str(node: u64, key_ptr: ptr, key_len: u64, out: &StrBuf) -> bool {
    out.len = 0;
    let p: ptr = PTR_NULL();
    let l: u64 = 0;
    if get_str(node, key_ptr, key_len, &p, &l) {
        sb_append(out, p, l);
        return true;
    };
    let iv: i64 = 0;
    if node != 0 && sa_json_object_get_i64(node, key_ptr, key_len, &iv) == 0 {
        sb_append_i64(out, iv);
        return true;
    };
    let fv: f64 = 0.0;
    if node != 0 && sa_json_object_get_f64(node, key_ptr, key_len, &fv) == 0 {
        // DEFECT: JS String(number) formatting (1e21, 0.30000000000000004
        // style) is approximated: integral values print as integers,
        // others with 6 fractional digits trimmed.
        if fv == (fv as i64) as f64 {
            sb_append_i64(out, fv as i64);
        } else {
            let neg = fv < 0.0;
            let a = fv;
            if neg { a = 0.0 - fv; sb_append_lit(out, STR_PTR("-"), STR_LEN("-")); };
            let whole = a as u64;
            sb_append_u64(out, whole);
            sb_append_lit(out, STR_PTR("."), STR_LEN("."));
            let frac = ((a - whole as f64) * 1000000.0 + 0.5) as u64;
            let fd = [0u8; 6];
            let fx = frac;
            let fi: u64 = 6;
            while fi > 0 {
                fi = fi - 1;
                fd[fi] = (48 + (fx % 10)) as u8;
                fx = fx / 10;
            }
            let last = 6;
            while last > 0 && fd[last - 1] == 48 { last = last - 1; }
            for fj in 0..last {
                if out.len < 65536 { out.bytes[out.len] = fd[fj]; out.len = out.len + 1; };
            }
        };
        return true;
    };
    let bv: bool = false;
    if node != 0 && sa_json_object_get_bool(node, key_ptr, key_len, &bv) == 0 {
        if bv { sb_append_lit(out, STR_PTR("true"), STR_LEN("true")); } else { sb_append_lit(out, STR_PTR("false"), STR_LEN("false")); };
        return true;
    };
    return false;
}

// firstStringValue(record, keys): first key whose value is a
// string with non-empty trim; returns the TRIMMED value.
// DEFECT: the keys array is passed as one \n-joined literal.
fn first_string_value(node: u64, keys_ptr: ptr, keys_len: u64, out_ptr: &ptr, out_len: &u64) -> bool {
    let start: u64 = 0;
    let i: u64 = 0;
    while i <= keys_len {
        if i == keys_len || (i < keys_len && byte_at(keys_ptr, i) == 10) {
            let kp: ptr = PTR_NULL();
            PTR_BYTE_ADD(kp, keys_ptr, start);
            let kl = i - start;
            let p: ptr = PTR_NULL();
            let l: u64 = 0;
            if get_str(node, kp, kl, &p, &l) {
                let t: ptr = PTR_NULL();
                let tl: u64 = 0;
                trim_into(p, l, &t, &tl);
                if tl > 0 {
                    *out_ptr = t;
                    *out_len = tl;
                    return true;
                };
            };
            start = i + 1;
        };
        i = i + 1;
        if keys_len == 0 { break; };
    }
    return false;
}

fn byte_at(p: ptr, i: u64) -> u8 {
    let b: u8 = 0;
    PTR_BYTE_AT(b, p, i);
    return b;
}

// TS: function isRecord(value: unknown): value is Record<string, unknown>
// DEFECT: JSON node kind inspection is not in the JSON surface;
// parsed docs in this module come from object texts, so a
// non-zero doc is treated as a record (arrays parsed from text
// are excluded by the caller via the leading-'{' check in
// parse_if_json).
fn is_record(doc: u64) -> bool {
    return doc != 0;
}

// A parsed-or-raw JSON value as this module handles it.
struct JsonValue {
    doc: u64,
    is_record: bool,
}

// TS: export function parseIfJson(value: unknown): unknown
// DEFECT: `unknown` — the input is (text, is_string); strings
// are parsed when they look like JSON, everything else passes
// through (a non-string input is returned as its doc when the
// caller already parsed it, else doc 0 / not a record).
fn parse_if_json(text_ptr: ptr, text_len: u64, is_string: bool, pre_doc: u64, out: &JsonValue) -> void {
    out.doc = 0;
    out.is_record = false;
    if !is_string {
        out.doc = pre_doc;
        out.is_record = pre_doc != 0;
        return;
    };
    let t: ptr = PTR_NULL();
    let tl: u64 = 0;
    trim_into(text_ptr, text_len, &t, &tl);
    if tl > 32768 { return; };
    if tl >= 2 {
        let first = byte_at(t, 0);
        let lastb = byte_at(t, tl - 1);
        if (first == 123 && lastb == 125) || (first == 91 && lastb == 93) {
            let doc = sa_json_parse(t, tl);
            if doc != 0 {
                out.doc = doc;
                out.is_record = first == 123;
            };
        };
    };
}

// The unwrapped args as a stack of docs: base first, nested
// merges appended; reads search LAST-to-FIRST so nested keys
// override base keys, matching the source's object spreads.
// DEFECT: unwrapToolArgs returns this view stack instead of a
// materialized Record<string, unknown> copy (reads are
// equivalent; identity/enumeration are not reproduced).
struct ArgsView {
    docs: [u64; 16],
    docs_len: u64,
}

fn args_get(view: &ArgsView, key_ptr: ptr, key_len: u64) -> u64 {
    let i = view.docs_len;
    while i > 0 {
        i = i - 1;
        let n = get_node(view.docs[i], key_ptr, key_len);
        if n != 0 { return n; };
    }
    return 0;
}

fn args_has(view: &ArgsView, key_ptr: ptr, key_len: u64) -> bool {
    return args_get(view, key_ptr, key_len) != 0;
}

fn args_str(view: &ArgsView, key_ptr: ptr, key_len: u64, out_ptr: &ptr, out_len: &u64) -> bool {
    let i = view.docs_len;
    while i > 0 {
        i = i - 1;
        let p: ptr = PTR_NULL();
        let l: u64 = 0;
        if get_str(view.docs[i], key_ptr, key_len, &p, &l) {
            *out_ptr = p;
            *out_len = l;
            return true;
        };
    }
    return false;
}

fn args_first_string(view: &ArgsView, keys_ptr: ptr, keys_len: u64, out_ptr: &ptr, out_len: &u64) -> bool {
    let i = view.docs_len;
    while i > 0 {
        i = i - 1;
        if first_string_value(view.docs[i], keys_ptr, keys_len, out_ptr, out_len) { return true; };
    }
    return false;
}

fn args_scalar_str(view: &ArgsView, key_ptr: ptr, key_len: u64, out: &StrBuf) -> bool {
    let i = view.docs_len;
    while i > 0 {
        i = i - 1;
        if scalar_str(view.docs[i], key_ptr, key_len, out) { return true; };
    }
    return false;
}

// Serializes a JSON node to text (for parse_if_json of string
// candidates carried as nodes).
fn node_to_text(node: u64, out: &StrBuf) -> bool {
    out.len = 0;
    if node == 0 { return false; };
    let sh: u64 = 0;
    if sa_json_stringify(node, &sh) != 0 { return false; };
    let p: ptr = sa_json_buffer_data(sh);
    let l = sa_json_buffer_len(sh);
    sb_append(out, p, l);
    return true;
}

// Extracts a candidate value (ArgsView base) from a record doc
// by the shared argument-key list; returns false when no key is
// present. The candidate may be a string (JSON-encoded) or a doc.
fn candidate_from(doc: u64, out: &JsonValue) -> bool {
    // keys: "arguments", "input", "parameters", "args",
    // "tool_input", "toolInput", "rawInput", "tool_args", "toolArgs"
    // DEFECT: `key in payload && payload[key] !== undefined` —
    // presence is approximated by object_get success (a JSON
    // null value also counts as present, as in TS).
    let start: u64 = 0;
    let i: u64 = 0;
    let keys_len = STR_LEN("arguments\ninput\nparameters\nargs\ntool_input\ntoolInput\nrawInput\ntool_args\ntoolArgs");
    let keys_ptr: ptr = STR_PTR("arguments\ninput\nparameters\nargs\ntool_input\ntoolInput\nrawInput\ntool_args\ntoolArgs");
    while i <= keys_len {
        if i == keys_len || (i < keys_len && byte_at(keys_ptr, i) == 10) {
            let kp: ptr = PTR_NULL();
            PTR_BYTE_ADD(kp, keys_ptr, start);
            let kl = i - start;
            let child = get_node(doc, kp, kl);
            if child != 0 {
                // candidate = payload[key]; then parseIfJson.
                let sp: ptr = PTR_NULL();
                let sl: u64 = 0;
                if sa_json_object_get_string(doc, kp, kl, &sp, &sl) == 0 {
                    parse_if_json(sp, sl, true, 0, out);
                } else {
                    out.doc = child;
                    out.is_record = true;
                    // DEFECT: a non-object candidate (array) is
                    // marked record here; isRecord(array) is
                    // false in TS — arrays reach this path only
                    // as arg containers, and reads behave the
                    // same in this module.
                };
                return true;
            };
            start = i + 1;
        };
        i = i + 1;
    }
    return false;
}

// TS: export function unwrapToolArgs(payload, row?): Record<string, unknown>
fn unwrapToolArgs(payload_ptr: ptr, payload_len: u64, item_ptr: ptr, item_len: u64, item_has: bool, out: &ArgsView) -> void {
    out.docs_len = 0;
    let payload_doc = sa_json_parse(payload_ptr, payload_len);
    let cand = JsonValue { doc: 0, is_record: false };
    let have = false;
    if payload_doc != 0 {
        have = candidate_from(payload_doc, &cand);
    };
    if !have && item_has {
        let item_doc = sa_json_parse(item_ptr, item_len);
        if item_doc != 0 {
            have = candidate_from(item_doc, &cand);
        };
    };
    if !have {
        // candidate = payload
        cand.doc = payload_doc;
        cand.is_record = payload_doc != 0;
    };
    // let result = isRecord(candidate) ? { ...candidate } : {};
    let result_doc: u64 = 0;
    if cand.is_record { result_doc = cand.doc; };
    if result_doc != 0 {
        out.docs[out.docs_len] = result_doc;
        out.docs_len = out.docs_len + 1;
    };
    if result_doc == 0 { return; };
    // for (const nestedKey of ["Arguments", ...same keys...]):
    //   if nestedKey in result && result[nestedKey] !== undefined:
    //     nestedParsed = parseIfJson(result[nestedKey]);
    //     if isRecord(nestedParsed): result = { ...result, ...nestedParsed };
    let keys_ptr: ptr = STR_PTR("Arguments\narguments\ninput\nparameters\nargs\ntool_input\ntoolInput\nrawInput\ntool_args\ntoolArgs");
    let keys_len = STR_LEN("Arguments\narguments\ninput\nparameters\nargs\ntool_input\ntoolInput\nrawInput\ntool_args\ntoolArgs");
    let start: u64 = 0;
    let i: u64 = 0;
    while i <= keys_len {
        if i == keys_len || (i < keys_len && byte_at(keys_ptr, i) == 10) {
            let kp: ptr = PTR_NULL();
            PTR_BYTE_ADD(kp, keys_ptr, start);
            let kl = i - start;
            let child = get_node(result_doc, kp, kl);
            if child != 0 {
                let nested = JsonValue { doc: 0, is_record: false };
                let sp: ptr = PTR_NULL();
                let sl: u64 = 0;
                if sa_json_object_get_string(result_doc, kp, kl, &sp, &sl) == 0 {
                    parse_if_json(sp, sl, true, 0, &nested);
                } else {
                    nested.doc = child;
                    nested.is_record = true;
                };
                if nested.is_record && out.docs_len < 16 {
                    out.docs[out.docs_len] = nested.doc;
                    out.docs_len = out.docs_len + 1;
                };
            };
            start = i + 1;
        };
        i = i + 1;
    }
}

// TS: const KNOWN_SA_VM_ACTIONS = new Set([...]);
fn known_sa_vm_action(p: ptr, l: u64) -> bool {
    if str_eq_lit(p, l, STR_PTR("read_file"), STR_LEN("read_file")) { return true; };
    if str_eq_lit(p, l, STR_PTR("read_lines"), STR_LEN("read_lines")) { return true; };
    if str_eq_lit(p, l, STR_PTR("read_many"), STR_LEN("read_many")) { return true; };
    if str_eq_lit(p, l, STR_PTR("read_files"), STR_LEN("read_files")) { return true; };
    if str_eq_lit(p, l, STR_PTR("read_file_tail"), STR_LEN("read_file_tail")) { return true; };
    if str_eq_lit(p, l, STR_PTR("tail_file"), STR_LEN("tail_file")) { return true; };
    if str_eq_lit(p, l, STR_PTR("tail"), STR_LEN("tail")) { return true; };
    if str_eq_lit(p, l, STR_PTR("read"), STR_LEN("read")) { return true; };
    if str_eq_lit(p, l, STR_PTR("vm-read"), STR_LEN("vm-read")) { return true; };
    if str_eq_lit(p, l, STR_PTR("vm_read"), STR_LEN("vm_read")) { return true; };
    if str_eq_lit(p, l, STR_PTR("view_file"), STR_LEN("view_file")) { return true; };
    if str_eq_lit(p, l, STR_PTR("view"), STR_LEN("view")) { return true; };
    if str_eq_lit(p, l, STR_PTR("write_file"), STR_LEN("write_file")) { return true; };
    if str_eq_lit(p, l, STR_PTR("write_to_file"), STR_LEN("write_to_file")) { return true; };
    if str_eq_lit(p, l, STR_PTR("write"), STR_LEN("write")) { return true; };
    if str_eq_lit(p, l, STR_PTR("edit_file"), STR_LEN("edit_file")) { return true; };
    if str_eq_lit(p, l, STR_PTR("replace_file_content"), STR_LEN("replace_file_content")) { return true; };
    if str_eq_lit(p, l, STR_PTR("edit"), STR_LEN("edit")) { return true; };
    if str_eq_lit(p, l, STR_PTR("apply_patch"), STR_LEN("apply_patch")) { return true; };
    if str_eq_lit(p, l, STR_PTR("patch"), STR_LEN("patch")) { return true; };
    if str_eq_lit(p, l, STR_PTR("delete_file"), STR_LEN("delete_file")) { return true; };
    if str_eq_lit(p, l, STR_PTR("remove_file"), STR_LEN("remove_file")) { return true; };
    if str_eq_lit(p, l, STR_PTR("delete"), STR_LEN("delete")) { return true; };
    if str_eq_lit(p, l, STR_PTR("safe_delete"), STR_LEN("safe_delete")) { return true; };
    if str_eq_lit(p, l, STR_PTR("copy_file"), STR_LEN("copy_file")) { return true; };
    if str_eq_lit(p, l, STR_PTR("copy"), STR_LEN("copy")) { return true; };
    if str_eq_lit(p, l, STR_PTR("move_file"), STR_LEN("move_file")) { return true; };
    if str_eq_lit(p, l, STR_PTR("move"), STR_LEN("move")) { return true; };
    if str_eq_lit(p, l, STR_PTR("file_info"), STR_LEN("file_info")) { return true; };
    if str_eq_lit(p, l, STR_PTR("info"), STR_LEN("info")) { return true; };
    if str_eq_lit(p, l, STR_PTR("stat"), STR_LEN("stat")) { return true; };
    if str_eq_lit(p, l, STR_PTR("count_lines"), STR_LEN("count_lines")) { return true; };
    if str_eq_lit(p, l, STR_PTR("line_count"), STR_LEN("line_count")) { return true; };
    if str_eq_lit(p, l, STR_PTR("wc"), STR_LEN("wc")) { return true; };
