}

// jevActionKey(args.action) where args.action may be any JSON
// value: only strings are considered (jevActionKey returns
// undefined for non-strings), read through the ArgsView.
fn jev_action_key_of_payload(args: &ArgsView, out_ptr: &ptr, out_len: &u64) -> bool {
    let p: ptr = PTR_NULL();
    let l: u64 = 0;
    if !args_str(args, STR_PTR("action"), STR_LEN("action"), &p, &l) { return false; };
    return jev_action_key(p, l, true, out_ptr, out_len);
}

// TS: function jevActivityDetail(action, args): string | undefined
fn jevActivityDetail(action_ptr: ptr, action_len: u64, args: &ArgsView, out: &StrBuf) -> bool {
    out.len = 0;
    // const question = firstStringValue(args, ["question", "target", "task", "goal", "problem", "context"]);
    // if (question) return compactText(question);
    let vp: ptr = PTR_NULL();
    let vl: u64 = 0;
    if args_first_string(args, STR_PTR("question\ntarget\ntask\ngoal\nproblem\ncontext"), STR_LEN("question\ntarget\ntask\ngoal\nproblem\ncontext"), &vp, &vl) {
        if compactText(vp, vl, out) { return true; };
        // DEFECT: compactText of a non-empty firstStringValue
        // always yields a line in TS; kept for shape parity.
    };
    if str_eq_lit(action_ptr, action_len, STR_PTR("checklist"), STR_LEN("checklist")) {
        // const checks = Array.isArray(args.checks) ? args.checks.length : 0;
        // return checks > 0 ? `${checks} checks` : undefined;
        let checks = args_node(args, STR_PTR("checks"), STR_LEN("checks"));
        let n: u64 = 0;
        if checks != 0 { n = arr_len(checks); };
        if n > 0 {
            sb_append_u64(out, n);
            sb_append_lit(out, STR_PTR(" checks"), STR_LEN(" checks"));
            return true;
        };
        return false;
    };
    if str_eq_lit(action_ptr, action_len, STR_PTR("evaluate"), STR_LEN("evaluate")) {
        let questions = args_node(args, STR_PTR("questions"), STR_LEN("questions"));
        if questions != 0 {
            // if (isRecord(questions)) return `${Object.keys(questions).length} questions`;
            // DEFECT: Object.keys count — the JSON surface has
            // no key enumeration, so record-shaped questions
            // cannot be counted here; the array case below is
            // exact. Record case falls through (undefined).
            // if (Array.isArray(questions)) return `${questions.length} questions`;
            let n = arr_len(questions);
            if n > 0 {
                sb_append_u64(out, n);
                sb_append_lit(out, STR_PTR(" questions"), STR_LEN(" questions"));
                return true;
            };
            // DEFECT: an empty array yields "0 questions" in TS;
            // arr_len cannot distinguish array from record here.
        };
    };
    if str_eq_lit(action_ptr, action_len, STR_PTR("rank"), STR_LEN("rank")) {
        let items = args_node(args, STR_PTR("items"), STR_LEN("items"));
        if items != 0 {
            let n = arr_len(items);
            sb_append_u64(out, n);
            sb_append_lit(out, STR_PTR(" items"), STR_LEN(" items"));
            return true;
        };
        return false;
    };
    // return firstStringValue(args, ["action", "reason", "summary"]);
    if args_first_string(args, STR_PTR("action\nreason\nsummary"), STR_LEN("action\nreason\nsummary"), &vp, &vl) {
        sb_append(out, vp, vl);
        return true;
    };
    return false;
}
