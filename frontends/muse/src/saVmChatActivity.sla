    if str_eq_lit(p, l, STR_PTR("git_diff"), STR_LEN("git_diff")) { return true; };
    if str_eq_lit(p, l, STR_PTR("git-diff"), STR_LEN("git-diff")) { return true; };
    if str_eq_lit(p, l, STR_PTR("code_graph"), STR_LEN("code_graph")) { return true; };
    if str_eq_lit(p, l, STR_PTR("relation_graph"), STR_LEN("relation_graph")) { return true; };
    if str_eq_lit(p, l, STR_PTR("symbol_graph"), STR_LEN("symbol_graph")) { return true; };
    if str_eq_lit(p, l, STR_PTR("repo_map"), STR_LEN("repo_map")) { return true; };
    if str_eq_lit(p, l, STR_PTR("repo-map"), STR_LEN("repo-map")) { return true; };
    if str_eq_lit(p, l, STR_PTR("workspace_outline"), STR_LEN("workspace_outline")) { return true; };
    if str_eq_lit(p, l, STR_PTR("outline_many"), STR_LEN("outline_many")) { return true; };
    if str_eq_lit(p, l, STR_PTR("project_outline"), STR_LEN("project_outline")) { return true; };
    if str_eq_lit(p, l, STR_PTR("verify_loop"), STR_LEN("verify_loop")) { return true; };
    if str_eq_lit(p, l, STR_PTR("verify-loop"), STR_LEN("verify-loop")) { return true; };
    if str_eq_lit(p, l, STR_PTR("verify_changed"), STR_LEN("verify_changed")) { return true; };
    if str_eq_lit(p, l, STR_PTR("find_references"), STR_LEN("find_references")) { return true; };
    if str_eq_lit(p, l, STR_PTR("find_all_references"), STR_LEN("find_all_references")) { return true; };
    if str_eq_lit(p, l, STR_PTR("find_implementations"), STR_LEN("find_implementations")) { return true; };
    if str_eq_lit(p, l, STR_PTR("find_impl"), STR_LEN("find_impl")) { return true; };
    if str_eq_lit(p, l, STR_PTR("implementations"), STR_LEN("implementations")) { return true; };
    if str_eq_lit(p, l, STR_PTR("file_outline"), STR_LEN("file_outline")) { return true; };
    if str_eq_lit(p, l, STR_PTR("outline"), STR_LEN("outline")) { return true; };
    if str_eq_lit(p, l, STR_PTR("rename_symbol"), STR_LEN("rename_symbol")) { return true; };
    if str_eq_lit(p, l, STR_PTR("move_file_with_imports"), STR_LEN("move_file_with_imports")) { return true; };
    if str_eq_lit(p, l, STR_PTR("find_definition"), STR_LEN("find_definition")) { return true; };
    if str_eq_lit(p, l, STR_PTR("extract_to_file"), STR_LEN("extract_to_file")) { return true; };
    if str_eq_lit(p, l, STR_PTR("extract_component"), STR_LEN("extract_component")) { return true; };
    if str_eq_lit(p, l, STR_PTR("extract_hook"), STR_LEN("extract_hook")) { return true; };
    if str_eq_lit(p, l, STR_PTR("atomic_refactor"), STR_LEN("atomic_refactor")) { return true; };
    if str_eq_lit(p, l, STR_PTR("split_plan"), STR_LEN("split_plan")) { return true; };
    if str_eq_lit(p, l, STR_PTR("split_stage"), STR_LEN("split_stage")) { return true; };
    if str_eq_lit(p, l, STR_PTR("split_refine"), STR_LEN("split_refine")) { return true; };
    if str_eq_lit(p, l, STR_PTR("split_repair"), STR_LEN("split_repair")) { return true; };
    if str_eq_lit(p, l, STR_PTR("split_status"), STR_LEN("split_status")) { return true; };
    if str_eq_lit(p, l, STR_PTR("analyze_coupling"), STR_LEN("analyze_coupling")) { return true; };
    if str_eq_lit(p, l, STR_PTR("auto_fix_missing_imports"), STR_LEN("auto_fix_missing_imports")) { return true; };
    if str_eq_lit(p, l, STR_PTR("add_import"), STR_LEN("add_import")) { return true; };
    if str_eq_lit(p, l, STR_PTR("get_diagnostics"), STR_LEN("get_diagnostics")) { return true; };
    if str_eq_lit(p, l, STR_PTR("workspace_diagnostics"), STR_LEN("workspace_diagnostics")) { return true; };
    if str_eq_lit(p, l, STR_PTR("organize_imports"), STR_LEN("organize_imports")) { return true; };
    if str_eq_lit(p, l, STR_PTR("analyze_scope"), STR_LEN("analyze_scope")) { return true; };
    if str_eq_lit(p, l, STR_PTR("run_bun"), STR_LEN("run_bun")) { return true; };
    if str_eq_lit(p, l, STR_PTR("run_project_check"), STR_LEN("run_project_check")) { return true; };
    if str_eq_lit(p, l, STR_PTR("run_host"), STR_LEN("run_host")) { return true; };
    if str_eq_lit(p, l, STR_PTR("exec_host"), STR_LEN("exec_host")) { return true; };
    if str_eq_lit(p, l, STR_PTR("host"), STR_LEN("host")) { return true; };
    return false;
}

//
// JEV advisory decision helpers (17 actions) are distinct from the general SA-VM broker.
// The broker runner (sa_vm_run / jev_sa_vm_run) executes VM operations (edit_file, read_file, etc.)
// which must format as `vm-edit`, `vm-read`, etc. with file arguments. Only genuine JEV
// advisory decisions map to `vm-jev-*`.
//
// TS: const KNOWN_JEV_ADVISORY_ACTIONS = new Set([...]);
fn known_jev_advisory_action(p: ptr, l: u64) -> bool {
    if str_eq_lit(p, l, STR_PTR("choose"), STR_LEN("choose")) { return true; };
    if str_eq_lit(p, l, STR_PTR("select"), STR_LEN("select")) { return true; };
    if str_eq_lit(p, l, STR_PTR("checklist"), STR_LEN("checklist")) { return true; };
    if str_eq_lit(p, l, STR_PTR("evaluate"), STR_LEN("evaluate")) { return true; };
    if str_eq_lit(p, l, STR_PTR("thinking"), STR_LEN("thinking")) { return true; };
    if str_eq_lit(p, l, STR_PTR("redteam"), STR_LEN("redteam")) { return true; };
    if str_eq_lit(p, l, STR_PTR("rank"), STR_LEN("rank")) { return true; };
    if str_eq_lit(p, l, STR_PTR("scope"), STR_LEN("scope")) { return true; };
    if str_eq_lit(p, l, STR_PTR("dispatch"), STR_LEN("dispatch")) { return true; };
    if str_eq_lit(p, l, STR_PTR("consistency"), STR_LEN("consistency")) { return true; };
    if str_eq_lit(p, l, STR_PTR("done"), STR_LEN("done")) { return true; };
    if str_eq_lit(p, l, STR_PTR("diagnose"), STR_LEN("diagnose")) { return true; };
    if str_eq_lit(p, l, STR_PTR("edge-cases"), STR_LEN("edge-cases")) { return true; };
    if str_eq_lit(p, l, STR_PTR("blast-radius"), STR_LEN("blast-radius")) { return true; };
    if str_eq_lit(p, l, STR_PTR("intent"), STR_LEN("intent")) { return true; };
    if str_eq_lit(p, l, STR_PTR("next"), STR_LEN("next")) { return true; };
    if str_eq_lit(p, l, STR_PTR("compress"), STR_LEN("compress")) { return true; };
    if str_eq_lit(p, l, STR_PTR("progress"), STR_LEN("progress")) { return true; };
    if str_eq_lit(p, l, STR_PTR("memory"), STR_LEN("memory")) { return true; };
    return false;
}

// TS: const JEV_ACTION_RE = /^jev[_-]([a-z0-9][a-z0-9_-]*)$/i;
// DEFECT: regex — hand-rolled equivalent below.
fn jev_action_key(value_ptr: ptr, value_len: u64, value_is_string: bool, out_ptr: &ptr, out_len: &u64) -> bool {
    if !value_is_string { return false; };
    let t: ptr = PTR_NULL();
    let tl: u64 = 0;
    trim_into(value_ptr, value_len, &t, &tl);
    // ^jev[_-] — case-insensitive prefix
    if tl < 5 { return false; };
    let b0 = byte_at(t, 0);
    let b1 = byte_at(t, 1);
    let b2 = byte_at(t, 2);
    let b3 = byte_at(t, 3);
    if !(b0 == 106 || b0 == 74) { return false; };
    if !(b1 == 101 || b1 == 69) { return false; };
    if !(b2 == 118 || b2 == 86) { return false; };
    if !(b3 == 95 || b3 == 45) { return false; };
    // capture [a-z0-9][a-z0-9_-]*$ (case-insensitive)
    let cap_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(cap_ptr, t, 4);
    let cap_len = tl - 4;
    if cap_len == 0 { return false; };
    for i in 0..cap_len {
        let c = byte_at(cap_ptr, i);
        let ok = (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95 || c == 45;
        if i == 0 && !( (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) ) { return false; };
        if !ok { return false; };
    }
    // key = match[1].replace(/_/g, "-").toLowerCase() — built in
    // a thread-local style scratch via the caller's out buffer
    // is not available; use a static-free approach: build into
    // a local StrBuf and hand out a view (DEFECT: view into a
    // local — callers must copy; same pattern as jevQuestions).
    let keybuf = StrBuf { bytes: [0u8; 65536], len: 0 };
    for i2 in 0..cap_len {
        let c2 = byte_at(cap_ptr, i2);
        if c2 == 95 { c2 = 45; };
        if c2 >= 65 && c2 <= 90 { c2 = c2 + 32; };
        if keybuf.len < 65536 { keybuf.bytes[keybuf.len] = c2; keybuf.len = keybuf.len + 1; };
    }
    let kp: ptr = PTR_NULL();
    PTR_BYTE_ADD(kp, &keybuf.bytes, 0);
    // Runner tools like `jev_sa_vm_run` are SA-VM brokers, never JEV advisory actions
    if str_eq_lit(kp, keybuf.len, STR_PTR("sa-vm-run"), STR_LEN("sa-vm-run")) { return false; };
    if str_eq_lit(kp, keybuf.len, STR_PTR("savm-run"), STR_LEN("savm-run")) { return false; };
    if str_eq_lit(kp, keybuf.len, STR_PTR("sa-vm"), STR_LEN("sa-vm")) { return false; };
    if str_eq_lit(kp, keybuf.len, STR_PTR("savm"), STR_LEN("savm")) { return false; };
    if str_eq_lit(kp, keybuf.len, STR_PTR("vm-run"), STR_LEN("vm-run")) { return false; };
    if str_eq_lit(kp, keybuf.len, STR_PTR("run"), STR_LEN("run")) { return false; };
    // Standard SA-VM actions prefixed with jev are not JEV advisory actions:
    // KNOWN_SA_VM_ACTIONS.has(match[1].toLowerCase()) — underscores kept,
    // or .has(key) — dashes normalized.
    let lowbuf = StrBuf { bytes: [0u8; 65536], len: 0 };
    lower_into(cap_ptr, cap_len, &lowbuf);
    let lp: ptr = PTR_NULL();
    PTR_BYTE_ADD(lp, &lowbuf.bytes, 0);
    if known_sa_vm_action(lp, lowbuf.len) { return false; };
    if known_sa_vm_action(kp, keybuf.len) { return false; };
    if !known_jev_advisory_action(kp, keybuf.len) { return false; };
    *out_ptr = kp;
    *out_len = keybuf.len;
    return true;
}

// Convenience: jevActionKey over a JSON string field of a doc.
fn jev_action_key_of(node: u64, key_ptr: ptr, key_len: u64, out_ptr: &ptr, out_len: &u64) -> bool {
    let p: ptr = PTR_NULL();
    let l: u64 = 0;
    if !get_str(node, key_ptr, key_len, &p, &l) { return false; };
    return jev_action_key(p, l, true, out_ptr, out_len);
}


// Numeric/bool field reads over an ArgsView (for the detail
// formatting in saVmToolActivity).
fn args_num(view: &ArgsView, key_ptr: ptr, key_len: u64, out: &f64) -> bool {
    let i = view.docs_len;
    while i > 0 {
        i = i - 1;
        let node = view.docs[i];
        if node != 0 {
            let fv: f64 = 0.0;
            if sa_json_object_get_f64(node, key_ptr, key_len, &fv) == 0 { *out = fv; return true; };
            let iv: i64 = 0;
            if sa_json_object_get_i64(node, key_ptr, key_len, &iv) == 0 { *out = iv as f64; return true; };
        };
    }
    return false;
}

fn args_bool(view: &ArgsView, key_ptr: ptr, key_len: u64, out: &bool) -> bool {
    let i = view.docs_len;
    while i > 0 {
        i = i - 1;
        let node = view.docs[i];
        if node != 0 {
            let bv: bool = false;
            if sa_json_object_get_bool(node, key_ptr, key_len, &bv) == 0 { *out = bv; return true; };
        };
    }
    return false;
}

fn args_node(view: &ArgsView, key_ptr: ptr, key_len: u64) -> u64 {
    return args_get(view, key_ptr, key_len);
}

// Joins a JSON array's elements with a separator using
// String() semantics (strings raw). DEFECT: non-string elements
// (numbers, booleans, objects) are not stringified — the JSON
// surface used here exposes element text only for strings;
// TS String(element) formatting is deferred to the fix phase.
fn join_scalar_arr_sep(arr: u64, sep_ptr: ptr, sep_len: u64, out: &StrBuf) -> void {
    out.len = 0;
    let n = arr_len(arr);
    for i in 0..n {
        if i > 0 { sb_append_lit(out, sep_ptr, sep_len); };
        let el: u64 = 0;
        if sa_json_array_get(arr, i, &el) != 0 { continue; };
        let p: ptr = sa_json_string_ptr(el);
        let l: u64 = sa_json_string_len(el);
        sb_append(out, p, l);
    }
}

// TS: function compactText(value: string): string | undefined
fn compactText(text_ptr: ptr, text_len: u64, out: &StrBuf) -> bool {
    out.len = 0;
    let start: u64 = 0;
    let i: u64 = 0;
    while i <= text_len {
        if i == text_len || (i < text_len && byte_at(text_ptr, i) == 10) {
            let seg: ptr = PTR_NULL();
            PTR_BYTE_ADD(seg, text_ptr, start);
            let t: ptr = PTR_NULL();
            let tl: u64 = 0;
            trim_into(seg, i - start, &t, &tl);
            if tl > 0 {
                sb_append(out, t, tl);
                return true;
            };
            start = i + 1;
        };
        i = i + 1;
        if text_len == 0 { break; };
    }
    return false;
}

// Case-insensitive search for a literal; returns index or -1
// (as u64 sentinel 4294967295).
fn find_ci(hay_ptr: ptr, hay_len: u64, from: u64, nd_ptr: ptr, nd_len: u64) -> u64 {
    if hay_len < nd_len || from > hay_len - nd_len { return 4294967295; };
    let last = hay_len - nd_len;
    let i = from;
    while i <= last {
        let ok = true;
        for j in 0..nd_len {
            let a = byte_at(hay_ptr, i + j);
            let b = byte_at(nd_ptr, j);
            if a >= 65 && a <= 90 { a = a + 32; };
            if b >= 65 && b <= 90 { b = b + 32; };
            if a != b { ok = false; break; };
        }
        if ok { return i; };
        i = i + 1;
    }
    return 4294967295;
}

fn rest_of_line(text_ptr: ptr, text_len: u64, from: u64, out: &StrBuf) -> void {
    out.len = 0;
    let i = from;
    while i < text_len {
        let b = byte_at(text_ptr, i);
        if b == 10 || b == 13 { break; };
        if out.len < 65536 { out.bytes[out.len] = b; out.len = out.len + 1; };
        i = i + 1;
    }
}

// TS: function extractPathFromPatch(patch: string): string | undefined
// DEFECT: the three source regexes are hand-rolled scans:
//   /\*\*\*\s+(?:Update|Add|Delete)\s+File:\s*([^\r\n]+)/i
//   /diff --git\/(.+?)\s+b\/(.+)/i   (as written in the source)
//   /(?:---|\+\+\+)\s+[ab]\/([^\r\n]+)/
fn extractPathFromPatch(patch_ptr: ptr, patch_len: u64, out: &StrBuf) -> bool {
    out.len = 0;
    // 1) "*** <Update|Add|Delete> File: <path>"
    let pos: u64 = 0;
    while pos + 3 <= patch_len {
        let idx = find_ci(patch_ptr, patch_len, pos, STR_PTR("***"), STR_LEN("***"));
        if idx == 4294967295 { break; };
        let p = idx + 3;
        // \s+
        while p < patch_len && (byte_at(patch_ptr, p) == 32 || byte_at(patch_ptr, p) == 9 || byte_at(patch_ptr, p) == 13 || byte_at(patch_ptr, p) == 10) { p = p + 1; }
        let kw_len: u64 = 0;
        if find_ci(patch_ptr, patch_len, p, STR_PTR("update"), STR_LEN("update")) == p { kw_len = 6; };
        if kw_len == 0 && find_ci(patch_ptr, patch_len, p, STR_PTR("add"), STR_LEN("add")) == p { kw_len = 3; };
        if kw_len == 0 && find_ci(patch_ptr, patch_len, p, STR_PTR("delete"), STR_LEN("delete")) == p { kw_len = 6; };
        if kw_len > 0 {
            let q = p + kw_len;
            while q < patch_len && (byte_at(patch_ptr, q) == 32 || byte_at(patch_ptr, q) == 9) { q = q + 1; }
            if find_ci(patch_ptr, patch_len, q, STR_PTR("file:"), STR_LEN("file:")) == q {
                let r = q + 5;
                while r < patch_len && (byte_at(patch_ptr, r) == 32 || byte_at(patch_ptr, r) == 9) { r = r + 1; }
                rest_of_line(patch_ptr, patch_len, r, out);
                let t: ptr = PTR_NULL();
                let tl: u64 = 0;
                let __hp1: ptr = PTR_NULL();
                PTR_BYTE_ADD(__hp1, &out.bytes, 0);
                trim_into(__hp1, out.len, &t, &tl);
                if tl > 0 {
                    // return the trimmed capture
                    let res = StrBuf { bytes: [0u8; 65536], len: 0 };
                    sb_append(&res, t, tl);
                    out.len = 0;
                    let __hp1: ptr = PTR_NULL();
                    PTR_BYTE_ADD(__hp1, &res.bytes, 0);
                    sb_append(out, __hp1, res.len);
                    return true;
                };
            };
        };
        pos = idx + 3;
    }
    // 2) "diff --git/<a> b/<b>" — returns group 1 (a path)
    let d = find_ci(patch_ptr, patch_len, 0, STR_PTR("diff --git/"), STR_LEN("diff --git/"));
    if d != 4294967295 {
        let start = d + STR_LEN("diff --git/");
        // (.+?)\s+b\/ — first " b/" after start
        let i = start;
        while i + 3 <= patch_len {
            if byte_at(patch_ptr, i) == 32 && byte_at(patch_ptr, i + 1) == 98 && byte_at(patch_ptr, i + 2) == 47 {
                let t: ptr = PTR_NULL();
                let tl: u64 = 0;
                let seg: ptr = PTR_NULL();
                PTR_BYTE_ADD(seg, patch_ptr, start);
                trim_into(seg, i - start, &t, &tl);
                if tl > 0 {
                    sb_append(out, t, tl);
                    return true;
                };
                break;
            };
            i = i + 1;
        }
    };
    // 3) "--- a/<path>" or "+++ b/<path>"
    let pos2: u64 = 0;
    while pos2 + 3 <= patch_len {
        let i1 = find_ci(patch_ptr, patch_len, pos2, STR_PTR("---"), STR_LEN("---"));
        let i2 = find_ci(patch_ptr, patch_len, pos2, STR_PTR("+++"), STR_LEN("+++"));
        let idx = i1;
        if i2 < idx { idx = i2; };
        if idx == 4294967295 { break; };
        let p = idx + 3;
        // \s+
        let saw_ws = false;
        while p < patch_len && (byte_at(patch_ptr, p) == 32 || byte_at(patch_ptr, p) == 9) { p = p + 1; saw_ws = true; }
        if saw_ws && p + 2 <= patch_len && (byte_at(patch_ptr, p) == 97 || byte_at(patch_ptr, p) == 98) && byte_at(patch_ptr, p + 1) == 47 {
            rest_of_line(patch_ptr, patch_len, p + 2, out);
            let t: ptr = PTR_NULL();
            let tl: u64 = 0;
            let __hp2: ptr = PTR_NULL();
            PTR_BYTE_ADD(__hp2, &out.bytes, 0);
            trim_into(__hp2, out.len, &t, &tl);
            if tl > 0 {
                let res = StrBuf { bytes: [0u8; 65536], len: 0 };
                sb_append(&res, t, tl);
                out.len = 0;
                let __hp2: ptr = PTR_NULL();
                PTR_BYTE_ADD(__hp2, &res.bytes, 0);
                sb_append(out, __hp2, res.len);
                return true;
            };
        };
        pos2 = idx + 3;
    }
    out.len = 0;
    return false;
}

// TS: function isMcpInvocation(rawName, itemType, args): boolean
fn isMcpInvocation(raw_name_ptr: ptr, raw_name_len: u64, item_type_ptr: ptr, item_type_len: u64, item_type_has: bool, args: &ArgsView) -> bool {
    let lower_name = StrBuf { bytes: [0u8; 65536], len: 0 };
    lower_into(raw_name_ptr, raw_name_len, &lower_name);
    let __hp1: ptr = PTR_NULL();
    PTR_BYTE_ADD(__hp1, &lower_name.bytes, 0);
    if str_contains(__hp1, lower_name.len, STR_PTR("mcp"), STR_LEN("mcp")) { return true; };
    if item_type_has {
        let lt = StrBuf { bytes: [0u8; 65536], len: 0 };
        lower_into(item_type_ptr, item_type_len, &lt);
        let __hp2: ptr = PTR_NULL();
        PTR_BYTE_ADD(__hp2, &lt.bytes, 0);
        if str_contains(__hp2, lt.len, STR_PTR("mcp"), STR_LEN("mcp")) { return true; };
    };
    let p: ptr = PTR_NULL();
    let l: u64 = 0;
    if args_first_string(args, STR_PTR("ServerName\nserverName\nserver\nserver_name"), STR_LEN("ServerName\nserverName\nserver\nserver_name"), &p, &l) { return true; };
    if args_first_string(args, STR_PTR("ToolName\ntoolName\ntool_name\ntool"), STR_LEN("ToolName\ntoolName\ntool_name\ntool"), &p, &l) {
        let lt2 = StrBuf { bytes: [0u8; 65536], len: 0 };
        lower_into(p, l, &lt2);
        let __hp3: ptr = PTR_NULL();
        PTR_BYTE_ADD(__hp3, &lt2.bytes, 0);
        if str_contains(__hp3, lt2.len, STR_PTR("mcp"), STR_LEN("mcp")) { return true; };
        let __hp4: ptr = PTR_NULL();
        PTR_BYTE_ADD(__hp4, &lt2.bytes, 0);
        if str_contains(__hp4, lt2.len, STR_PTR("sa-vm"), STR_LEN("sa-vm")) { return true; };
        let __hp5: ptr = PTR_NULL();
        PTR_BYTE_ADD(__hp5, &lt2.bytes, 0);
        if str_contains(__hp5, lt2.len, STR_PTR("savm"), STR_LEN("savm")) { return true; };
        let ln: ptr = PTR_NULL();
        PTR_BYTE_ADD(ln, &lower_name.bytes, 0);
        if str_contains(ln, lower_name.len, STR_PTR("call"), STR_LEN("call")) { return true; };
        if str_contains(ln, lower_name.len, STR_PTR("tool"), STR_LEN("tool")) { return true; };
        if str_eq_lit(ln, lower_name.len, STR_PTR("use_tool"), STR_LEN("use_tool")) { return true; };
    };
    // args.type === "MCP"
    let tp: ptr = PTR_NULL();
    let tl2: u64 = 0;
    if args_str(args, STR_PTR("type"), STR_LEN("type"), &tp, &tl2) {
        if str_eq_lit(tp, tl2, STR_PTR("MCP"), STR_LEN("MCP")) { return true; };
    };
    // (args.rawOutput as any)?.type === "MCP"
    let raw_out = args_node(args, STR_PTR("rawOutput"), STR_LEN("rawOutput"));
    if raw_out != 0 {
        let rp: ptr = PTR_NULL();
        let rl: u64 = 0;
        if get_str(raw_out, STR_PTR("type"), STR_LEN("type"), &rp, &rl) {
            if str_eq_lit(rp, rl, STR_PTR("MCP"), STR_LEN("MCP")) { return true; };
        };
    };
    return false;
}

// TS: export function isSaVmToolPayload(payload, row): boolean
fn isSaVmToolPayload(payload_ptr: ptr, payload_len: u64, item_ptr: ptr, item_len: u64, item_has: bool, row_title_ptr: ptr, row_title_len: u64, row_title_has: bool) -> bool {
    let payload_doc = sa_json_parse(payload_ptr, payload_len);
    let item_doc: u64 = 0;
    if item_has { item_doc = sa_json_parse(item_ptr, item_len); };
    let raw: ptr = PTR_NULL();
    let raw_len: u64 = 0;
    let have_raw = false;
    if payload_doc != 0 {
        have_raw = first_string_value(payload_doc, STR_PTR("tool\nname\nmethod\nnamespace\ntitle"), STR_LEN("tool\nname\nmethod\nnamespace\ntitle"), &raw, &raw_len);
    };
    if !have_raw && item_doc != 0 {
        have_raw = first_string_value(item_doc, STR_PTR("tool\nname\ntoolName\nmethod\ntitle"), STR_LEN("tool\nname\ntoolName\nmethod\ntitle"), &raw, &raw_len);
    };
    if !have_raw && row_title_has {
        raw = row_title_ptr;
        raw_len = row_title_len;
        have_raw = true;
    };
    if !have_raw { return false; };
    let lower = StrBuf { bytes: [0u8; 65536], len: 0 };
    lower_into(raw, raw_len, &lower);
    let lp: ptr = PTR_NULL();
    PTR_BYTE_ADD(lp, &lower.bytes, 0);
    let kp: ptr = PTR_NULL();
    let kl: u64 = 0;
    if jev_action_key(raw, raw_len, true, &kp, &kl) { return true; };
    if str_eq_lit(lp, lower.len, STR_PTR("sa_vm_run"), STR_LEN("sa_vm_run")) { return true; };
    if str_contains(lp, lower.len, STR_PTR("sa_vm"), STR_LEN("sa_vm")) { return true; };
    if str_contains(lp, lower.len, STR_PTR("sa-vm"), STR_LEN("sa-vm")) { return true; };
    if str_contains(lp, lower.len, STR_PTR("savm"), STR_LEN("savm")) { return true; };
    if str_eq_lit(lp, lower.len, STR_PTR("vmrun"), STR_LEN("vmrun")) { return true; };
    if str_eq_lit(lp, lower.len, STR_PTR("vm_run"), STR_LEN("vm_run")) { return true; };
    let item_type = StrBuf { bytes: [0u8; 65536], len: 0 };
    if item_doc != 0 {
        let tp: ptr = PTR_NULL();
        let tl: u64 = 0;
        if get_str(item_doc, STR_PTR("type"), STR_LEN("type"), &tp, &tl) {
            lower_into(tp, tl, &item_type);
        };
    };
    if str_contains(lp, lower.len, STR_PTR("mcp"), STR_LEN("mcp")) { return true; };
    let itp: ptr = PTR_NULL();
    PTR_BYTE_ADD(itp, &item_type.bytes, 0);
    if str_contains(itp, item_type.len, STR_PTR("mcp"), STR_LEN("mcp")) { return true; };
    let args = ArgsView { docs: [0u64; 16], docs_len: 0 };
    unwrapToolArgs(payload_ptr, payload_len, item_ptr, item_len, item_has, &args);
    let sp: ptr = PTR_NULL();
    let sl: u64 = 0;
    if args_first_string(&args, STR_PTR("ServerName\nserverName\nserver\nserver_name"), STR_LEN("ServerName\nserverName\nserver\nserver_name"), &sp, &sl) {
        let ls = StrBuf { bytes: [0u8; 65536], len: 0 };
        lower_into(sp, sl, &ls);
        let lsp: ptr = PTR_NULL();
        PTR_BYTE_ADD(lsp, &ls.bytes, 0);
        if str_eq_lit(lsp, ls.len, STR_PTR("sa-vm"), STR_LEN("sa-vm")) { return true; };
        if str_eq_lit(lsp, ls.len, STR_PTR("savm"), STR_LEN("savm")) { return true; };
        if str_eq_lit(lsp, ls.len, STR_PTR("jev"), STR_LEN("jev")) { return true; };
    };
    if args_first_string(&args, STR_PTR("ToolName\ntoolName\ntool_name\ntool"), STR_LEN("ToolName\ntoolName\ntool_name\ntool"), &sp, &sl) {
        let kp2: ptr = PTR_NULL();
        let kl2: u64 = 0;
        if jev_action_key(sp, sl, true, &kp2, &kl2) { return true; };
        let lt = StrBuf { bytes: [0u8; 65536], len: 0 };
        lower_into(sp, sl, &lt);
        let ltp: ptr = PTR_NULL();
        PTR_BYTE_ADD(ltp, &lt.bytes, 0);
        if str_eq_lit(ltp, lt.len, STR_PTR("sa_vm_run"), STR_LEN("sa_vm_run")) { return true; };
        if str_eq_lit(ltp, lt.len, STR_PTR("savm"), STR_LEN("savm")) { return true; };
        if str_contains(ltp, lt.len, STR_PTR("sa-vm"), STR_LEN("sa-vm")) { return true; };
        if str_contains(ltp, lt.len, STR_PTR("sa_vm"), STR_LEN("sa_vm")) { return true; };
        if str_contains(ltp, lt.len, STR_PTR("savm"), STR_LEN("savm")) { return true; };
    };
    // const action = typeof args.action === "string" ? args.action.trim().toLowerCase() : "";
    let action = StrBuf { bytes: [0u8; 65536], len: 0 };
    let ap: ptr = PTR_NULL();
    let al: u64 = 0;
    if args_str(&args, STR_PTR("action"), STR_LEN("action"), &ap, &al) {
        let t: ptr = PTR_NULL();
        let tl3: u64 = 0;
        trim_into(ap, al, &t, &tl3);
        lower_into(t, tl3, &action);
    };
    let actp: ptr = PTR_NULL();
    PTR_BYTE_ADD(actp, &action.bytes, 0);
    if action.len > 0 {
        let kp3: ptr = PTR_NULL();
        let kl3: u64 = 0;
        if jev_action_key(actp, action.len, true, &kp3, &kl3) { return true; };
    };
    if action.len > 0 && (str_contains(lp, lower.len, STR_PTR("tool"), STR_LEN("tool")) || str_eq_lit(lp, lower.len, STR_PTR("use_tool"), STR_LEN("use_tool")) || known_sa_vm_action(actp, action.len)) {
        return true;
    };
    return false;
}

// Math.floor for f64 (truncation differs on negatives).
fn js_floor(v: f64) -> i64 {
    let t = v as i64;
    if v < 0.0 && (t as f64) != v { return t - 1; };
    return t;
}

fn trimmed_lower(p: ptr, l: u64, out: &StrBuf) -> void {
    let t: ptr = PTR_NULL();
    let tl: u64 = 0;
    trim_into(p, l, &t, &tl);
    lower_into(t, tl, out);
}

// String(value).trim() for a ?? chain value: writes the trimmed
// text and returns true when non-empty (the source's
// `String(x).trim() !== "" ? String(x).trim() : null` test).
fn scalar_trimmed_nonempty(view: &ArgsView, key_ptr: ptr, key_len: u64, out: &StrBuf) -> bool {
    let tmp = StrBuf { bytes: [0u8; 65536], len: 0 };
    if !args_scalar_str(view, key_ptr, key_len, &tmp) { return false; };
    let t: ptr = PTR_NULL();
    let tl: u64 = 0;
    let __hp3: ptr = PTR_NULL();
    PTR_BYTE_ADD(__hp3, &tmp.bytes, 0);
    trim_into(__hp3, tmp.len, &t, &tl);
    out.len = 0;
    sb_append(out, t, tl);
    return tl > 0;
}

// TS: export function saVmToolActivity(payload, row, fallbackDetail?)
// Returns (label, detail, detail_has); detail falls back to
// fallbackDetail when the computed detail is undefined.
fn saVmToolActivity(payload_ptr: ptr, payload_len: u64, item_ptr: ptr, item_len: u64, item_has: bool, row_title_ptr: ptr, row_title_len: u64, row_title_has: bool, fallback_ptr: ptr, fallback_len: u64, fallback_has: bool, out_label: &StrBuf, out_detail: &StrBuf, out_detail_has: &bool) -> void {
    out_label.len = 0;
    out_detail.len = 0;
    *out_detail_has = false;
    let payload_doc = sa_json_parse(payload_ptr, payload_len);
    let item_doc: u64 = 0;
    if item_has { item_doc = sa_json_parse(item_ptr, item_len); };
    let args = ArgsView { docs: [0u64; 16], docs_len: 0 };
    unwrapToolArgs(payload_ptr, payload_len, item_ptr, item_len, item_has, &args);

    let raw_name: ptr = PTR_NULL();
    let raw_name_len: u64 = 0;
    let have_name = false;
    if payload_doc != 0 {
        have_name = first_string_value(payload_doc, STR_PTR("tool\nname\nmethod\nnamespace"), STR_LEN("tool\nname\nmethod\nnamespace"), &raw_name, &raw_name_len);
    };
    if !have_name && item_doc != 0 {
        have_name = first_string_value(item_doc, STR_PTR("tool\nname\ntoolName\nmethod"), STR_LEN("tool\nname\ntoolName\nmethod"), &raw_name, &raw_name_len);
    };
    if !have_name && row_title_has {
        raw_name = row_title_ptr;
        raw_name_len = row_title_len;
        have_name = true;
    };
    // rawName defaults to "" (empty view over the literal)
    let item_type: ptr = PTR_NULL();
    let item_type_len: u64 = 0;
    let item_type_has = false;
    if item_doc != 0 {
        item_type_has = get_str(item_doc, STR_PTR("type"), STR_LEN("type"), &item_type, &item_type_len);
    };

    let is_mcp = isMcpInvocation(raw_name, raw_name_len, item_type, item_type_len, item_type_has, &args);

    // const jev = jevActionKey(args.action) ?? jevActionKey(fsv(ToolName...)) ?? jevActionKey(rawName);
    let jevbuf = StrBuf { bytes: [0u8; 65536], len: 0 };
    let jev_has = false;
    let kp: ptr = PTR_NULL();
    let kl: u64 = 0;
    if jev_action_key_of_payload(&args, &kp, &kl) {
        sb_append(&jevbuf, kp, kl);
        jev_has = true;
    };
    if !jev_has {
        let tp: ptr = PTR_NULL();
        let tl: u64 = 0;
        if args_first_string(&args, STR_PTR("ToolName\ntoolName\ntool_name\ntool"), STR_LEN("ToolName\ntoolName\ntool_name\ntool"), &tp, &tl) {
            if jev_action_key(tp, tl, true, &kp, &kl) {
                sb_append(&jevbuf, kp, kl);
                jev_has = true;
            };
        };
    };
    if !jev_has && have_name {
        if jev_action_key(raw_name, raw_name_len, true, &kp, &kl) {
            sb_append(&jevbuf, kp, kl);
            jev_has = true;
        };
    };

    // const isDirectVmRunner = rawName.includes("sa_vm") || ... (case-sensitive)
    let is_direct = str_contains(raw_name, raw_name_len, STR_PTR("sa_vm"), STR_LEN("sa_vm")) || str_contains(raw_name, raw_name_len, STR_PTR("sa-vm"), STR_LEN("sa-vm")) || str_contains(raw_name, raw_name_len, STR_PTR("savm"), STR_LEN("savm"));

    // const prefix = jev ? "vm-jev-" : (isMcp && !isDirectVmRunner ? "mcptool-" : "vm-");
    let prefix_ptr: ptr = STR_PTR("vm-");
    let prefix_len = STR_LEN("vm-");
    if jev_has {
        prefix_ptr = STR_PTR("vm-jev-");
        prefix_len = STR_LEN("vm-jev-");
    } else if is_mcp && !is_direct {
        prefix_ptr = STR_PTR("mcptool-");
        prefix_len = STR_LEN("mcptool-");
    };

    // const rawAction = ... (nested ternary over args.action /
    // args.ToolName / args.tool / args.tool_name / rawName)
    let action = StrBuf { bytes: [0u8; 65536], len: 0 };
    let ap: ptr = PTR_NULL();
    let al: u64 = 0;
    let action_set = false;
    if args_str(&args, STR_PTR("action"), STR_LEN("action"), &ap, &al) {
        let t: ptr = PTR_NULL();
        let tl2: u64 = 0;
        trim_into(ap, al, &t, &tl2);
        if tl2 > 0 {
            lower_into(t, tl2, &action);
            action_set = true;
        };
    };
    if !action_set {
        // args.ToolName string && !lower.includes("sa_vm_run")
        if args_str(&args, STR_PTR("ToolName"), STR_LEN("ToolName"), &ap, &al) {
            let low = StrBuf { bytes: [0u8; 65536], len: 0 };
            lower_into(ap, al, &low);
            let __hp6: ptr = PTR_NULL();
            PTR_BYTE_ADD(__hp6, &low.bytes, 0);
            if !str_contains(__hp6, low.len, STR_PTR("sa_vm_run"), STR_LEN("sa_vm_run")) {
                trimmed_lower(ap, al, &action);
                action_set = true;
            };
        };
    };
    if !action_set {
        if args_str(&args, STR_PTR("tool"), STR_LEN("tool"), &ap, &al) {
            let low = StrBuf { bytes: [0u8; 65536], len: 0 };
            lower_into(ap, al, &low);
            let __hp7: ptr = PTR_NULL();
            PTR_BYTE_ADD(__hp7, &low.bytes, 0);
            if !str_contains(__hp7, low.len, STR_PTR("sa_vm_run"), STR_LEN("sa_vm_run")) {
                trimmed_lower(ap, al, &action);
                action_set = true;
            };
        };
    };
    if !action_set {
        if args_str(&args, STR_PTR("tool_name"), STR_LEN("tool_name"), &ap, &al) {
            let low = StrBuf { bytes: [0u8; 65536], len: 0 };
            lower_into(ap, al, &low);
            let __hp8: ptr = PTR_NULL();
            PTR_BYTE_ADD(__hp8, &low.bytes, 0);
            if !str_contains(__hp8, low.len, STR_PTR("sa_vm_run"), STR_LEN("sa_vm_run")) {
                trimmed_lower(ap, al, &action);
                action_set = true;
            };
        };
    };
    if !action_set {
        let low_name = StrBuf { bytes: [0u8; 65536], len: 0 };
        lower_into(raw_name, raw_name_len, &low_name);
        let __hp9: ptr = PTR_NULL();
        PTR_BYTE_ADD(__hp9, &low_name.bytes, 0);
        let __hp10: ptr = PTR_NULL();
        PTR_BYTE_ADD(__hp10, &low_name.bytes, 0);
        let __hp11: ptr = PTR_NULL();
        PTR_BYTE_ADD(__hp11, &low_name.bytes, 0);
        if !str_contains(__hp9, low_name.len, STR_PTR("sa_vm"), STR_LEN("sa_vm")) && !str_contains(__hp10, low_name.len, STR_PTR("sa-vm"), STR_LEN("sa-vm")) && !str_contains(__hp11, low_name.len, STR_PTR("call_mcp_tool"), STR_LEN("call_mcp_tool")) {
            trimmed_lower(raw_name, raw_name_len, &action);
            action_set = true;
        };
    };
    let actp: ptr = PTR_NULL();
    PTR_BYTE_ADD(actp, &action.bytes, 0);

    let language = StrBuf { bytes: [0u8; 65536], len: 0 };
    if args_str(&args, STR_PTR("language"), STR_LEN("language"), &ap, &al) {
        trimmed_lower(ap, al, &language);
    };
    let langp: ptr = PTR_NULL();
    PTR_BYTE_ADD(langp, &language.bytes, 0);

    // let actionKey = "run"; if/else chain over action (verbatim
    // comparisons; the suffix buffer holds jev ?? actionKey).
    let suffix = StrBuf { bytes: [0u8; 65536], len: 0 };
    if jev_has {
        let __hp3: ptr = PTR_NULL();
        PTR_BYTE_ADD(__hp3, &jevbuf.bytes, 0);
        sb_append(&suffix, __hp3, jevbuf.len);
    } else if str_eq_lit(actp, action.len, STR_PTR("read_file"), STR_LEN("read_file")) || str_eq_lit(actp, action.len, STR_PTR("read_lines"), STR_LEN("read_lines")) || str_eq_lit(actp, action.len, STR_PTR("read_file_tail"), STR_LEN("read_file_tail")) || str_eq_lit(actp, action.len, STR_PTR("tail_file"), STR_LEN("tail_file")) || str_eq_lit(actp, action.len, STR_PTR("tail"), STR_LEN("tail")) || str_eq_lit(actp, action.len, STR_PTR("read"), STR_LEN("read")) || str_eq_lit(actp, action.len, STR_PTR("vm-read"), STR_LEN("vm-read")) || str_eq_lit(actp, action.len, STR_PTR("vm_read"), STR_LEN("vm_read")) || str_eq_lit(actp, action.len, STR_PTR("view_file"), STR_LEN("view_file")) || str_eq_lit(actp, action.len, STR_PTR("view"), STR_LEN("view")) {
        sb_append_lit(&suffix, STR_PTR("read"), STR_LEN("read"));
    } else if str_eq_lit(actp, action.len, STR_PTR("write_file"), STR_LEN("write_file")) || str_eq_lit(actp, action.len, STR_PTR("write_to_file"), STR_LEN("write_to_file")) || str_eq_lit(actp, action.len, STR_PTR("write"), STR_LEN("write")) {
        sb_append_lit(&suffix, STR_PTR("write"), STR_LEN("write"));
    } else if str_eq_lit(actp, action.len, STR_PTR("edit_file"), STR_LEN("edit_file")) || str_eq_lit(actp, action.len, STR_PTR("replace_file_content"), STR_LEN("replace_file_content")) || str_eq_lit(actp, action.len, STR_PTR("edit"), STR_LEN("edit")) {
        sb_append_lit(&suffix, STR_PTR("edit"), STR_LEN("edit"));
    } else if str_eq_lit(actp, action.len, STR_PTR("apply_patch"), STR_LEN("apply_patch")) || str_eq_lit(actp, action.len, STR_PTR("patch"), STR_LEN("patch")) {
        sb_append_lit(&suffix, STR_PTR("patch"), STR_LEN("patch"));
    } else if str_eq_lit(actp, action.len, STR_PTR("delete_file"), STR_LEN("delete_file")) || str_eq_lit(actp, action.len, STR_PTR("remove_file"), STR_LEN("remove_file")) || str_eq_lit(actp, action.len, STR_PTR("delete"), STR_LEN("delete")) {
        sb_append_lit(&suffix, STR_PTR("delete"), STR_LEN("delete"));
    } else if str_eq_lit(actp, action.len, STR_PTR("copy_file"), STR_LEN("copy_file")) || str_eq_lit(actp, action.len, STR_PTR("copy"), STR_LEN("copy")) {
        sb_append_lit(&suffix, STR_PTR("copy"), STR_LEN("copy"));
    } else if str_eq_lit(actp, action.len, STR_PTR("move_file"), STR_LEN("move_file")) || str_eq_lit(actp, action.len, STR_PTR("move"), STR_LEN("move")) {
        sb_append_lit(&suffix, STR_PTR("move"), STR_LEN("move"));
    } else if str_eq_lit(actp, action.len, STR_PTR("file_info"), STR_LEN("file_info")) || str_eq_lit(actp, action.len, STR_PTR("info"), STR_LEN("info")) || str_eq_lit(actp, action.len, STR_PTR("stat"), STR_LEN("stat")) || str_eq_lit(actp, action.len, STR_PTR("count_lines"), STR_LEN("count_lines")) || str_eq_lit(actp, action.len, STR_PTR("line_count"), STR_LEN("line_count")) || str_eq_lit(actp, action.len, STR_PTR("wc"), STR_LEN("wc")) || str_eq_lit(actp, action.len, STR_PTR("count"), STR_LEN("count")) {
        sb_append_lit(&suffix, STR_PTR("info"), STR_LEN("info"));
    } else if str_eq_lit(actp, action.len, STR_PTR("find_files"), STR_LEN("find_files")) || str_eq_lit(actp, action.len, STR_PTR("find"), STR_LEN("find")) || str_eq_lit(actp, action.len, STR_PTR("find_by_name"), STR_LEN("find_by_name")) {
        sb_append_lit(&suffix, STR_PTR("find"), STR_LEN("find"));
    } else if str_eq_lit(actp, action.len, STR_PTR("list_dir"), STR_LEN("list_dir")) || str_eq_lit(actp, action.len, STR_PTR("list"), STR_LEN("list")) || str_eq_lit(actp, action.len, STR_PTR("ls"), STR_LEN("ls")) {
        sb_append_lit(&suffix, STR_PTR("list"), STR_LEN("list"));
    } else if str_eq_lit(actp, action.len, STR_PTR("grep_search"), STR_LEN("grep_search")) || str_eq_lit(actp, action.len, STR_PTR("grep"), STR_LEN("grep")) {
        sb_append_lit(&suffix, STR_PTR("grep"), STR_LEN("grep"));
    } else if str_eq_lit(actp, action.len, STR_PTR("grep_search_async"), STR_LEN("grep_search_async")) || str_eq_lit(actp, action.len, STR_PTR("grep_async"), STR_LEN("grep_async")) || str_eq_lit(actp, action.len, STR_PTR("async_grep"), STR_LEN("async_grep")) {
        sb_append_lit(&suffix, STR_PTR("grep-async"), STR_LEN("grep-async"));
    } else if str_eq_lit(actp, action.len, STR_PTR("run_js"), STR_LEN("run_js")) || str_eq_lit(actp, action.len, STR_PTR("exec_js"), STR_LEN("exec_js")) || str_eq_lit(langp, language.len, STR_PTR("js"), STR_LEN("js")) || str_eq_lit(langp, language.len, STR_PTR("javascript"), STR_LEN("javascript")) {
        sb_append_lit(&suffix, STR_PTR("js"), STR_LEN("js"));
    } else if str_eq_lit(actp, action.len, STR_PTR("run_py"), STR_LEN("run_py")) || str_eq_lit(actp, action.len, STR_PTR("run_python"), STR_LEN("run_python")) || str_eq_lit(actp, action.len, STR_PTR("exec_py"), STR_LEN("exec_py")) || str_eq_lit(langp, language.len, STR_PTR("py"), STR_LEN("py")) || str_eq_lit(langp, language.len, STR_PTR("python"), STR_LEN("python")) {
        sb_append_lit(&suffix, STR_PTR("py"), STR_LEN("py"));
    } else if str_eq_lit(actp, action.len, STR_PTR("http_fetch"), STR_LEN("http_fetch")) || str_eq_lit(actp, action.len, STR_PTR("fetch"), STR_LEN("fetch")) || str_eq_lit(actp, action.len, STR_PTR("http"), STR_LEN("http")) {
        sb_append_lit(&suffix, STR_PTR("http"), STR_LEN("http"));
    } else if str_eq_lit(actp, action.len, STR_PTR("clear_tool_history"), STR_LEN("clear_tool_history")) || str_eq_lit(actp, action.len, STR_PTR("prune_tool_history"), STR_LEN("prune_tool_history")) {
        sb_append_lit(&suffix, STR_PTR("clear-history"), STR_LEN("clear-history"));
    } else if str_eq_lit(actp, action.len, STR_PTR("find_references"), STR_LEN("find_references")) || str_eq_lit(actp, action.len, STR_PTR("find_all_references"), STR_LEN("find_all_references")) || str_eq_lit(actp, action.len, STR_PTR("find_implementations"), STR_LEN("find_implementations")) || str_eq_lit(actp, action.len, STR_PTR("find_impl"), STR_LEN("find_impl")) || str_eq_lit(actp, action.len, STR_PTR("implementations"), STR_LEN("implementations")) {
        sb_append_lit(&suffix, STR_PTR("references"), STR_LEN("references"));
    } else if str_eq_lit(actp, action.len, STR_PTR("code_graph"), STR_LEN("code_graph")) || str_eq_lit(actp, action.len, STR_PTR("relation_graph"), STR_LEN("relation_graph")) || str_eq_lit(actp, action.len, STR_PTR("symbol_graph"), STR_LEN("symbol_graph")) {
        sb_append_lit(&suffix, STR_PTR("code-graph"), STR_LEN("code-graph"));
    } else if str_eq_lit(actp, action.len, STR_PTR("repo_map"), STR_LEN("repo_map")) || str_eq_lit(actp, action.len, STR_PTR("repo-map"), STR_LEN("repo-map")) {
        sb_append_lit(&suffix, STR_PTR("repo-map"), STR_LEN("repo-map"));
    } else if str_eq_lit(actp, action.len, STR_PTR("workspace_outline"), STR_LEN("workspace_outline")) || str_eq_lit(actp, action.len, STR_PTR("outline_many"), STR_LEN("outline_many")) || str_eq_lit(actp, action.len, STR_PTR("project_outline"), STR_LEN("project_outline")) {
        sb_append_lit(&suffix, STR_PTR("workspace-outline"), STR_LEN("workspace-outline"));
    } else if str_eq_lit(actp, action.len, STR_PTR("verify_loop"), STR_LEN("verify_loop")) || str_eq_lit(actp, action.len, STR_PTR("verify-loop"), STR_LEN("verify-loop")) || str_eq_lit(actp, action.len, STR_PTR("verify_changed"), STR_LEN("verify_changed")) {
        sb_append_lit(&suffix, STR_PTR("verify-loop"), STR_LEN("verify-loop"));
    } else if str_eq_lit(actp, action.len, STR_PTR("git_status"), STR_LEN("git_status")) || str_eq_lit(actp, action.len, STR_PTR("git-status"), STR_LEN("git-status")) {
        sb_append_lit(&suffix, STR_PTR("git-status"), STR_LEN("git-status"));
    } else if str_eq_lit(actp, action.len, STR_PTR("git_diff"), STR_LEN("git_diff")) || str_eq_lit(actp, action.len, STR_PTR("git-diff"), STR_LEN("git-diff")) {
