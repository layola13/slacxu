// mcpSmoke harness 3: tool filters + server-initiated ping.
// Config (run.sh) disables workspace_fact, so discovery must
// record exactly one tool; the fake server sends a ping
// request before answering the echo call and the client
// must reply (the fake logs the reply; run.sh asserts it).
@import "sa_std/io/print.sai"
@import "sa_std/ptr.sa"
@import "../../apps/server/src/mcpClient.sla"

fn has_sub(hay_ptr: ptr, hay_len: u64, nd_ptr: ptr, nd_len: u64) -> bool {
    if nd_len == 0 || hay_len < nd_len { return false; };
    let last = hay_len - nd_len;
    let i: u64 = 0;
    while i <= last {
        let ok = true;
        let j: u64 = 0;
        while j < nd_len {
            let a: u8 = 0;
            let b: u8 = 0;
            PTR_BYTE_AT(a, hay_ptr, i + j);
            PTR_BYTE_AT(b, nd_ptr, j);
            if a != b { ok = false; break; };
            j = j + 1;
        }
        if ok { return true; };
        i = i + 1;
    }
    return false;
}

fn main() -> i32 {
    let mcp = McpState { cfg_bytes: [0u8; 8192], cfg_len: 0, rec_bytes: [0u8; 32768], rec_len: 0, lb_bytes: [0u8; 32768], lb_len: 0, resp_bytes: [0u8; 32768], resp_len: 0, req_bytes: [0u8; 8192], req_len: 0, path_bytes: [0u8; 8192], path_len: 0, err: [0u8; 512], err_len: 0, n_tools: 0, cap_tools: 64, s0_proc: 0, s0_hin: 0, s0_hout: 0, s0_herr: 0, s1_proc: 0, s1_hin: 0, s1_hout: 0, s1_herr: 0, s2_proc: 0, s2_hin: 0, s2_hout: 0, s2_herr: 0, s3_proc: 0, s3_hin: 0, s3_hout: 0, s3_herr: 0, next_req: 100, lb_owner: 0 };
    let out = ByteBuf { bytes: [0u8; 40960], len: 0 };
    mcp_discover(&mcp);
    if mcp.err_len > 0 {
        println("mcp filters: discover error");
        return 11;
    };
    if mcp.n_tools != 1 {
        println("mcp filters: want exactly 1 tool after disabled_tools");
        return 12;
    };
    let rec_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(rec_ptr, &mcp.rec_bytes, 0);
    if has_sub(rec_ptr, mcp.rec_len, STR_PTR("workspace_fact"), STR_LEN("workspace_fact")) {
        println("mcp filters: disabled tool was recorded");
        return 13;
    };
    println("mcp filters ok");
    let out_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(out_ptr, &out.bytes, 0);
    let a1 = "{\"text\":\"ping-race\"}";
    mcp_call(&mcp, STR_PTR("mcp__fake__echo_text"), STR_LEN("mcp__fake__echo_text"), STR_PTR(a1), STR_LEN(a1), &out);
    if !has_sub(out_ptr, out.len, STR_PTR("echo:ping-race"), STR_LEN("echo:ping-race")) {
        println("mcp ping: echo call did not complete");
        return 21;
    };
    println("mcp ping ok");
    mcp_close_all(&mcp);
    return 0;
}
