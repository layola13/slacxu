@import "sa_std/io/print.sai"
@import "sa_std/ptr.sa"
@import "../../apps/server/src/saVmTool.sla"

fn has_sub(hay_ptr: ptr, hay_len: u64, needle: ptr, nlen: u64) -> bool {
    if nlen == 0 { return true; };
    if hay_len < nlen { return false; };
    let i: u64 = 0;
    while i + nlen <= hay_len {
        let j: u64 = 0;
        let ok = true;
        while j < nlen {
            let a: u8 = 0;
            let b: u8 = 0;
            PTR_BYTE_AT(a, hay_ptr, i + j);
            PTR_BYTE_AT(b, needle, j);
            if a != b { ok = false; };
            j = j + 1;
            if !ok { break; };
        }
        if ok { return true; };
        i = i + 1;
    }
    return false;
}

fn main() -> i32 {
    let out = ByteBuf { bytes: [0u8; 40960], len: 0 };
    let out_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(out_ptr, &out.bytes, 0);
    let args1 = "[\"-c\",\"import sys; sys.stderr.write('E'*200000); sys.stderr.write('STDERR_DONE'); sys.stdout.write('OUT_OK')\"]";
    sa_vm_execute(STR_PTR("run_host"), STR_LEN("run_host"), STR_PTR("python3"), STR_LEN("python3"), STR_PTR(args1), STR_LEN(args1), &out);
    if !has_sub(out_ptr, out.len, STR_PTR("exit 0"), STR_LEN("exit 0")) { println("missing exit 0"); return 21; };
    if !has_sub(out_ptr, out.len, STR_PTR("OUT_OK"), STR_LEN("OUT_OK")) { println("missing OUT_OK"); return 22; };
    if !has_sub(out_ptr, out.len, STR_PTR("[stderr]"), STR_LEN("[stderr]")) { println("missing stderr marker"); return 23; };
    if !has_sub(out_ptr, out.len, STR_PTR("STDERR_DONE"), STR_LEN("STDERR_DONE")) { println("missing STDERR_DONE"); return 24; };
    println("vm run_host stderr ok");
    let args2 = "[\"-c\",\"import sys; sys.exit(3)\"]";
    sa_vm_execute(STR_PTR("run_host"), STR_LEN("run_host"), STR_PTR("python3"), STR_LEN("python3"), STR_PTR(args2), STR_LEN(args2), &out);
    if !has_sub(out_ptr, out.len, STR_PTR("exit 3"), STR_LEN("exit 3")) { println("missing exit 3"); return 25; };
    println("vm run_host exit ok");
    println("vm ok");
    return 0;
}
