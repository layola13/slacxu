// Converted 1:1 from mini-codex/src/skills.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "sa_std/io/print.sai"
@import "sa_std/ptr.sa"
// DEFECT: Node API | node:fs/promises readdir/readFile and node:path join/resolve approximated via sa_std fs externs (sa_std_fs_list_names / sa_std_fs_is_dir / sa_std_fs_read) plus byte-wise path helpers.
// @import "sa_std/fs.sai"

// SkillEntry = { name: string; description: string; path: string } (TS line 4).
struct SkillEntry {
    name: [u8; 128], name_len: u64,
    description: [u8; 512], description_len: u64,
    path: [u8; 1024], path_len: u64,
}

// SkillEntry[] carrier (scanSkills caps at 50).
struct SkillList {
    entries: [SkillEntry; 50], len: u64,
}

// Growable text buffer for string returns.
struct SkillStr {
    bytes: [u8; 16384], len: u64,
}

// parseFrontmatter's return: { name?: string; description?: string } — optionals as presence flags.
struct Frontmatter {
    name: [u8; 128], name_len: u64, has_name: bool,
    description: [u8; 512], description_len: u64, has_description: bool,
}

// const ROOTS = [".agents/skills", ".codex/skills", ".claude/skills", ".grok/skills"]; (TS line 6)
// DEFECT: string array constant | no array-of-strings literal; approximated by an index helper.
fn skillRoot(idx: u64, out: &SkillStr) {
    out.len = 0;
    if idx == 0 { skillStrPush(out, STR_PTR(".agents/skills"), STR_LEN(".agents/skills")); };
    if idx == 1 { skillStrPush(out, STR_PTR(".codex/skills"), STR_LEN(".codex/skills")); };
    if idx == 2 { skillStrPush(out, STR_PTR(".claude/skills"), STR_LEN(".claude/skills")); };
    if idx == 3 { skillStrPush(out, STR_PTR(".grok/skills"), STR_LEN(".grok/skills")); };
}

fn skillStrPushByte(out: &SkillStr, b: u8) {
    if out.len < 16384 {
        out.bytes[out.len] = b;
        out.len = out.len + 1;
    };
}

fn skillStrPush(out: &SkillStr, src: ptr, src_len: u64) {
    let i: u64 = 0;
    while i < src_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, src, i);
        skillStrPushByte(out, b);
        i = i + 1;
    }
}

fn bytesEqStr(a: ptr, a_len: u64, b: ptr, b_len: u64) -> bool {
    if a_len != b_len { return false; };
    let i: u64 = 0;
    while i < a_len {
        let x: u8 = 0;
        let y: u8 = 0;
        PTR_BYTE_AT(x, a, i);
        PTR_BYTE_AT(y, b, i);
        if x != y { return false; };
        i = i + 1;
    }
    return true;
}

// join(a, b) byte concatenation with '/'.
// DEFECT: Node API | path.join platform separators not reproduced (POSIX '/' only).
fn joinPath(a_ptr: ptr, a_len: u64, b_ptr: ptr, b_len: u64, out: &SkillStr) {
    out.len = 0;
    skillStrPush(out, a_ptr, a_len);
    if a_len > 0 {
        let last: u8 = 0;
        PTR_BYTE_AT(last, a_ptr, a_len - 1);
        if last != 47 { skillStrPushByte(out, 47); };
    };
    skillStrPush(out, b_ptr, b_len);
}

// TS lines 8-21: parseFrontmatter(md: string): { name?: string; description?: string }
// DEFECT: regex | frontmatter regex /^---\s*\r?\n([\s\S]*?)\r?\n---/ and per-line /^\s*(name|description)\s*:\s*(.*?)\s*$/ and quote-strip regex have no regex engine; approximated with line scanning and manual quote stripping.
// DEFECT: string methods | toLowerCase() and replace(/_/g, "-") approximated byte-wise (ASCII).
fn parseFrontmatter(md_ptr: ptr, md_len: u64, out: &Frontmatter) {
    out.has_name = false;
    out.has_description = false;
    out.name_len = 0;
    out.description_len = 0;
    // Must start with a "---" line.
    if md_len < 3 { return; };
    let b0: u8 = 0;
    let b1: u8 = 0;
    let b2: u8 = 0;
    PTR_BYTE_AT(b0, md_ptr, 0);
    PTR_BYTE_AT(b1, md_ptr, 1);
    PTR_BYTE_AT(b2, md_ptr, 2);
    if b0 != 45 || b1 != 45 || b2 != 45 { return; };
    // Find the end of the first line.
    let pos: u64 = 3;
    while pos < md_len {
        let c: u8 = 0;
        PTR_BYTE_AT(c, md_ptr, pos);
        if c == 10 { pos = pos + 1; break; };
        pos = pos + 1;
    }
    // Process lines until a closing "---" line.
    while pos < md_len {
        let line_start = pos;
        let line_end = pos;
        while line_end < md_len {
            let c: u8 = 0;
            PTR_BYTE_AT(c, md_ptr, line_end);
            if c == 10 { break; };
            line_end = line_end + 1;
        }
        let le = line_end;
        if le > line_start {
            let c: u8 = 0;
            PTR_BYTE_AT(c, md_ptr, le - 1);
            if c == 13 { le = le - 1; };
        };
        // Closing delimiter?
        if le - line_start == 3 {
            let d0: u8 = 0;
            let d1: u8 = 0;
            let d2: u8 = 0;
            PTR_BYTE_AT(d0, md_ptr, line_start);
            PTR_BYTE_AT(d1, md_ptr, line_start + 1);
            PTR_BYTE_AT(d2, md_ptr, line_start + 2);
            if d0 == 45 && d1 == 45 && d2 == 45 { return; };
        };
        // Match ^\s*(name|description)\s*:\s*(.*?)\s*$
        let p = line_start;
        while p < le {
            let c: u8 = 0;
            PTR_BYTE_AT(c, md_ptr, p);
            if c != 32 && c != 9 { break; };
            p = p + 1;
        }
        let key_start = p;
        while p < le {
            let c: u8 = 0;
            PTR_BYTE_AT(c, md_ptr, p);
            if c == 58 { break; }; // ':'
            p = p + 1;
        }
        if p < le {
            let key_len = p - key_start;
            // trim trailing spaces of key
            while key_len > 0 {
                let c: u8 = 0;
                PTR_BYTE_AT(c, md_ptr, key_start + key_len - 1);
                if c != 32 && c != 9 { break; };
                key_len = key_len - 1;
            }
            let kp: ptr = PTR_NULL();
            PTR_BYTE_ADD(kp, md_ptr, key_start);
            let is_name = bytesEqStr(kp, key_len, STR_PTR("name"), STR_LEN("name"));
            let is_desc = bytesEqStr(kp, key_len, STR_PTR("description"), STR_LEN("description"));
            if is_name || is_desc {
                let v = p + 1;
                while v < le {
                    let c: u8 = 0;
                    PTR_BYTE_AT(c, md_ptr, v);
                    if c != 32 && c != 9 { break; };
                    v = v + 1;
                }
                let ve = le;
                while ve > v {
                    let c: u8 = 0;
                    PTR_BYTE_AT(c, md_ptr, ve - 1);
                    if c != 32 && c != 9 { break; };
                    ve = ve - 1;
                }
                // Strip one pair of matching surrounding quotes ("..." or '...').
                if ve - v >= 2 {
                    let q0: u8 = 0;
                    let q1: u8 = 0;
                    PTR_BYTE_AT(q0, md_ptr, v);
                    PTR_BYTE_AT(q1, md_ptr, ve - 1);
                    if (q0 == 34 && q1 == 34) || (q0 == 39 && q1 == 39) {
                        v = v + 1;
                        ve = ve - 1;
                    };
                };
                if is_name {
                    out.has_name = true;
                    out.name_len = 0;
                    let i = v;
                    while i < ve && out.name_len < 128 {
                        let c: u8 = 0;
                        PTR_BYTE_AT(c, md_ptr, i);
                        if c >= 65 && c <= 90 { c = c + 32; }; // toLowerCase
                        if c == 95 { c = 45; }; // '_' -> '-'
                        out.name[out.name_len] = c;
                        out.name_len = out.name_len + 1;
                        i = i + 1;
                    }
                } else {
                    out.has_description = true;
                    out.description_len = 0;
                    let i = v;
                    while i < ve && out.description_len < 512 {
                        let c: u8 = 0;
                        PTR_BYTE_AT(c, md_ptr, i);
                        out.description[out.description_len] = c;
                        out.description_len = out.description_len + 1;
                        i = i + 1;
                    }
                };
            };
        };
        pos = line_end + 1;
    }
}

// /^[a-z0-9]+(?:-[a-z0-9]+)*$/ name validation (TS line 36).
// DEFECT: regex | validated with a byte loop instead of a regex engine.
fn validSkillName(n_ptr: ptr, n_len: u64) -> bool {
    if n_len == 0 { return false; };
    let i: u64 = 0;
    let seg: u64 = 0;
    while i < n_len {
        let c: u8 = 0;
        PTR_BYTE_AT(c, n_ptr, i);
        if c == 45 {
            if seg == 0 { return false; };
            seg = 0;
        } else if (c >= 97 && c <= 122) || (c >= 48 && c <= 57) {
            seg = seg + 1;
        } else {
            return false;
        };
        i = i + 1;
    }
    return seg > 0;
}

// TS lines 23-42: export async function scanSkills(cwd: string): Promise<SkillEntry[]>
// DEFECT: async | async/await + Promise removed; the function is synchronous and fills `found` in place.
// DEFECT: Node API | readdir(..., { withFileTypes: true }) Dirent objects approximated by a newline-separated name listing (sa_std_fs_list_names) plus per-entry is_dir checks; per-entry try/catch approximated by status checks.
// DEFECT: dynamic array | found.push/slice(0, 50) approximated over the fixed-capacity SkillList.
fn scanSkills(cwd_ptr: ptr, cwd_len: u64, found: &SkillList) {
    found.len = 0;
    let r: u64 = 0;
    while r < 4 {
        let root = SkillStr { bytes: [0u8; 16384], len: 0 };
        skillRoot(r, &root);
        let rp: ptr = PTR_NULL();
        PTR_BYTE_ADD(rp, &root.bytes, 0);
        let root_dir = SkillStr { bytes: [0u8; 16384], len: 0 };
        joinPath(cwd_ptr, cwd_len, rp, root.len, &root_dir);
        let rdp: ptr = PTR_NULL();
        PTR_BYTE_ADD(rdp, &root_dir.bytes, 0);
        // let entries; try { entries = await readdir(...) } catch { continue }
        let names = SkillStr { bytes: [0u8; 16384], len: 0 };
        let ok = sa_std_fs_list_names(rdp, root_dir.len, &names.bytes, 16384, &names.len);
        if ok {
            // Entries are newline-separated in `names`.
            let pos: u64 = 0;
            let np: ptr = PTR_NULL();
            PTR_BYTE_ADD(np, &names.bytes, 0);
            while pos < names.len {
                let e_start = pos;
                while pos < names.len {
                    let c: u8 = 0;
                    PTR_BYTE_AT(c, np, pos);
                    if c == 10 { break; };
                    pos = pos + 1;
                }
                let e_len = pos - e_start;
                pos = pos + 1;
                if e_len == 0 { continue; };
                let ep: ptr = PTR_NULL();
                PTR_BYTE_ADD(ep, np, e_start);
                // if (!e.isDirectory()) continue;
                let entry_dir = SkillStr { bytes: [0u8; 16384], len: 0 };
                joinPath(rdp, root_dir.len, ep, e_len, &entry_dir);
                let edp: ptr = PTR_NULL();
                PTR_BYTE_ADD(edp, &entry_dir.bytes, 0);
                if !sa_std_fs_is_dir(edp, entry_dir.len) { continue; };
                // const p = join(cwd, root, e.name, "SKILL.md");
                let pbuf = SkillStr { bytes: [0u8; 16384], len: 0 };
                joinPath(edp, entry_dir.len, STR_PTR("SKILL.md"), STR_LEN("SKILL.md"), &pbuf);
                let pp: ptr = PTR_NULL();
                PTR_BYTE_ADD(pp, &pbuf.bytes, 0);
                // try { const md = await readFile(p, "utf8"); ... } catch {}
                let md = SkillStr { bytes: [0u8; 16384], len: 0 };
                let rok = sa_std_fs_read(pp, pbuf.len, &md.bytes, 16384, &md.len);
                if rok {
                    let mp: ptr = PTR_NULL();
                    PTR_BYTE_ADD(mp, &md.bytes, 0);
                    let meta = Frontmatter { name: [0u8; 128], name_len: 0, has_name: false, description: [0u8; 512], description_len: 0, has_description: false };
                    parseFrontmatter(mp, md.len, &meta);
                    // const name = meta.name || e.name.toLowerCase();
                    let nm = SkillStr { bytes: [0u8; 16384], len: 0 };
                    if meta.has_name && meta.name_len > 0 {
                        let mnp: ptr = PTR_NULL();
                        PTR_BYTE_ADD(mnp, &meta.name, 0);
                        skillStrPush(&nm, mnp, meta.name_len);
                    } else {
                        let i: u64 = 0;
                        while i < e_len {
                            let c: u8 = 0;
                            PTR_BYTE_AT(c, ep, i);
                            if c >= 65 && c <= 90 { c = c + 32; };
                            skillStrPushByte(&nm, c);
                            i = i + 1;
                        }
                    };
                    let nmp: ptr = PTR_NULL();
                    PTR_BYTE_ADD(nmp, &nm.bytes, 0);
                    if !validSkillName(nmp, nm.len) { continue; };
                    if found.len < 50 {
                        let idx = found.len;
                        found.entries[idx].name_len = 0;
                        let i: u64 = 0;
                        while i < nm.len && i < 128 {
                            found.entries[idx].name[i] = nm.bytes[i];
                            i = i + 1;
                        }
                        found.entries[idx].name_len = nm.len;
                        // description: (meta.description || "").slice(0, 200)
                        found.entries[idx].description_len = 0;
                        if meta.has_description {
                            let dlen = meta.description_len;
                            if dlen > 200 { dlen = 200; };
                            let d: u64 = 0;
                            while d < dlen {
                                found.entries[idx].description[d] = meta.description[d];
                                d = d + 1;
                            }
                            found.entries[idx].description_len = dlen;
                        };
                        found.entries[idx].path_len = 0;
                        let q: u64 = 0;
                        while q < pbuf.len && q < 1024 {
                            found.entries[idx].path[q] = pbuf.bytes[q];
                            q = q + 1;
                        }
                        found.entries[idx].path_len = pbuf.len;
                        found.len = found.len + 1;
                    };
                };
            }
        };
        r = r + 1;
    }
    // return found.slice(0, 50); — capacity already capped at 50 above.
}

// TS lines 44-50: expandSlash(text: string, skills: SkillEntry[]): string
// DEFECT: regex | /^\s*\/([a-zA-Z][\w-]*)\s*([\s\S]*)$/ approximated with a byte scan.
// DEFECT: template literal | `[skill:${hit.name} ${hit.path}]\n${rest}`.trim() built by manual concatenation + trailing/leading trim.
fn expandSlash(text_ptr: ptr, text_len: u64, skills: &SkillList, out: &SkillStr) {
    out.len = 0;
    let i: u64 = 0;
    while i < text_len {
        let c: u8 = 0;
        PTR_BYTE_AT(c, text_ptr, i);
        if c != 32 && c != 9 && c != 10 && c != 13 { break; };
        i = i + 1;
    }
    // const m = /^\s*\/([a-zA-Z][\w-]*)\s*([\s\S]*)$/.exec(text); if (!m) return text;
    let is_slash = false;
    if i < text_len {
        let c: u8 = 0;
        PTR_BYTE_AT(c, text_ptr, i);
        if c == 47 { is_slash = true; };
    };
    if !is_slash {
        skillStrPush(out, text_ptr, text_len);
        return;
    };
    i = i + 1;
    let name_start = i;
    // first char must be [a-zA-Z]
    let first_ok = false;
    if i < text_len {
        let c: u8 = 0;
        PTR_BYTE_AT(c, text_ptr, i);
        if (c >= 97 && c <= 122) || (c >= 65 && c <= 90) { first_ok = true; };
    };
    if !first_ok {
        skillStrPush(out, text_ptr, text_len);
        return;
    };
    while i < text_len {
        let c: u8 = 0;
        PTR_BYTE_AT(c, text_ptr, i);
        let word = (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95 || c == 45;
        if !word { break; };
        i = i + 1;
    }
    let name_len = i - name_start;
    // \s* before the rest
    while i < text_len {
        let c: u8 = 0;
        PTR_BYTE_AT(c, text_ptr, i);
        if c != 32 && c != 9 && c != 10 && c != 13 { break; };
        i = i + 1;
    }
    // const hit = skills.find((s) => s.name === m[1].toLowerCase());
    // DEFECT: closure | Array.find with a capturing predicate approximated by an explicit loop.
    let hit: i64 = -1;
    let s: u64 = 0;
    while s < skills.len {
        if skills.entries[s].name_len == name_len {
            let same = true;
            let j: u64 = 0;
            while j < name_len {
                let a: u8 = 0;
                PTR_BYTE_AT(a, text_ptr, name_start + j);
                if a >= 65 && a <= 90 { a = a + 32; };
                if a != skills.entries[s].name[j] { same = false; };
                j = j + 1;
            }
            if same { hit = s as i64; break; };
        };
        s = s + 1;
    }
    if hit < 0 {
        // if (!hit) return text;
        out.len = 0;
        skillStrPush(out, text_ptr, text_len);
        return;
    };
    let h = skills.entries[hit as u64];
    skillStrPush(out, STR_PTR("[skill:"), STR_LEN("[skill:"));
    let hnp: ptr = PTR_NULL();
    PTR_BYTE_ADD(hnp, &h.name, 0);
    skillStrPush(out, hnp, h.name_len);
    skillStrPushByte(out, 32);
    let hpp: ptr = PTR_NULL();
    PTR_BYTE_ADD(hpp, &h.path, 0);
    skillStrPush(out, hpp, h.path_len);
    skillStrPush(out, STR_PTR("]\n"), STR_LEN("]\n"));
    // ${m[2] ?? ""}
    skillStrPush(out, text_ptr + i, text_len - i);
    // .trim() — approximated: drop trailing whitespace bytes.
    while out.len > 0 {
        let c = out.bytes[out.len - 1];
        if c != 32 && c != 9 && c != 10 && c != 13 { break; };
        out.len = out.len - 1;
    }
}

// TS lines 52-59: export async function readSkillBody(entry: SkillEntry): Promise<string>
// DEFECT: async | async/await + Promise removed; synchronous, fills out.
// DEFECT: template literal | truncation notice built by manual concatenation; ${md.length} rendered decimal byte-wise.
// DEFECT: string methods | split("\n").filter(startsWith("#")).slice(0, 30).join("\n") approximated by a line scan collecting heading lines.
fn readSkillBody(entry: &SkillEntry, out: &SkillStr) {
    out.len = 0;
    let ep: ptr = PTR_NULL();
    PTR_BYTE_ADD(ep, &entry.path, 0);
    let md = SkillStr { bytes: [0u8; 16384], len: 0 };
    sa_std_fs_read(ep, entry.path_len, &md.bytes, 16384, &md.len);
    let mp: ptr = PTR_NULL();
    PTR_BYTE_ADD(mp, &md.bytes, 0);
    if md.len > 12000 {
        skillStrPush(out, mp, 12000);
        skillStrPush(out, STR_PTR("\n\n[truncated "), STR_LEN("\n\n[truncated "));
        // ${md.length}
        let digits: [u8; 20] = [0u8; 20];
        let n: u64 = 0;
        let x = md.len;
        if x == 0 { skillStrPushByte(out, 48); };
        while x > 0 {
            digits[n] = 48 + (x % 10) as u8;
            n = n + 1;
            x = x / 10;
        }
        while n > 0 {
            n = n - 1;
            skillStrPushByte(out, digits[n]);
        }
        skillStrPush(out, STR_PTR(" bytes; sections:\n"), STR_LEN(" bytes; sections:\n"));
        // heads: lines starting with '#', at most 30
        let heads: u64 = 0;
        let pos: u64 = 0;
        while pos < md.len && heads < 30 {
            let ls = pos;
            while pos < md.len {
                let c: u8 = 0;
                PTR_BYTE_AT(c, mp, pos);
                if c == 10 { break; };
                pos = pos + 1;
            }
            if pos > ls {
                let c: u8 = 0;
                PTR_BYTE_AT(c, mp, ls);
                if c == 35 { // '#'
                    if heads > 0 { skillStrPushByte(out, 10); };
                    skillStrPush(out, mp + ls, pos - ls);
                    heads = heads + 1;
                };
            };
            pos = pos + 1;
        }
        skillStrPush(out, STR_PTR("\nuse read <path> <start> <end> for detail]"), STR_LEN("\nuse read <path> <start> <end> for detail]"));
        return;
    };
    skillStrPush(out, mp, md.len);
}

// TS lines 61-64: skillListPrompt(skills: SkillEntry[]): string
// DEFECT: template literal | map(...).join("\n") list rendering built by manual concatenation.
fn skillListPrompt(skills: &SkillList, out: &SkillStr) {
    out.len = 0;
    if skills.len == 0 {
        skillStrPush(out, STR_PTR("skills: none"), STR_LEN("skills: none"));
        return;
    };
    skillStrPush(out, STR_PTR("skills:\n"), STR_LEN("skills:\n"));
    let i: u64 = 0;
    while i < skills.len {
        if i > 0 { skillStrPushByte(out, 10); };
        skillStrPush(out, STR_PTR("- "), STR_LEN("- "));
        let np: ptr = PTR_NULL();
        PTR_BYTE_ADD(np, &skills.entries[i].name, 0);
        skillStrPush(out, np, skills.entries[i].name_len);
        skillStrPush(out, STR_PTR(": "), STR_LEN(": "));
        let dp: ptr = PTR_NULL();
        PTR_BYTE_ADD(dp, &skills.entries[i].description, 0);
        skillStrPush(out, dp, skills.entries[i].description_len);
        i = i + 1;
    }
    skillStrPush(out, STR_PTR("\nCall read_skill(name) before using a skill; sa-vm SKILL.md is authoritative for file ops."), STR_LEN("\nCall read_skill(name) before using a skill; sa-vm SKILL.md is authoritative for file ops."));
}

// TS lines 66-70: resolveSkillPath(p: string, skills: SkillEntry[]): string
// DEFECT: exception handling | throw new Error("skill path not in inventory") has no SLA counterpart; approximated as bool (false = would-throw) + out filled on success.
// DEFECT: Node API | resolve(p) path normalization approximated by raw byte comparison (no absolutize/symlink resolution).
fn resolveSkillPath(p_ptr: ptr, p_len: u64, skills: &SkillList, out: &SkillStr) -> bool {
    out.len = 0;
    let i: u64 = 0;
    while i < skills.len {
        let sp: ptr = PTR_NULL();
        PTR_BYTE_ADD(sp, &skills.entries[i].path, 0);
        if bytesEqStr(p_ptr, p_len, sp, skills.entries[i].path_len) {
            skillStrPush(out, sp, skills.entries[i].path_len);
            return true;
        };
        i = i + 1;
    }
    return false;
}
