// Converted 1:1 from mini-codex/src/memory.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "sa_std/io/print.sai"
@import "sa_std/ptr.sa"
@import "sa_std/string.sa"
// DEFECT: Node API | node:fs existsSync/readFileSync/appendFileSync/mkdirSync, node:os homedir, node:path join/dirname bound to sa_std surfaces: readFileSync -> sa_std_fs_open_read + sa_std_fs_file_read + sa_fs_file_close; appendFileSync -> sa_std_fs_open_options (flags 22 = write|create|append, mode 438) + sa_std_fs_file_write; mkdirSync(recursive) -> sa_fs_mkdir_p; homedir() -> sa_env_home_dir (buffer handle, copied out then freed); existsSync -> sa_std_fs_exists(...) == 0 (STATUS CODE, never a boolean).
@import "sa_std/fs.sai"
@import "sa_std/env.sai"

// Growable text buffer used for string returns (TS string -> buffer + len).
struct MemStr {
    bytes: [u8; 16384], len: u64,
}

// Cap for injected long-term memory (keeps system prompt bounded).
const MINI_MEMORY_MAX_CHARS: u64 = 8000;
// Cap for a single remember write (append-only note, not a novel).
const MINI_REMEMBER_MAX_CHARS: u64 = 2000;
const MINI_MEMORY_FILENAME = "MEMORY.md";

fn memStrPushByte(out: &MemStr, b: u8) {
    if out.len < 16384 {
        out.bytes[out.len] = b;
        out.len = out.len + 1;
    };
}

fn memStrPush(out: &MemStr, src: ptr, src_len: u64) {
    let i: u64 = 0;
    while i < src_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, src, i);
        memStrPushByte(out, b);
        i = i + 1;
    }
}

// Keep the last `cap` bytes of src (TS: raw.slice(-cap)) into out; caller pre-trims emptiness.
// DEFECT: string methods | trim()/length/slice operate on JS UTF-16 code units; approximated byte-wise (UTF-8 bytes), so caps may differ on multibyte text.
fn sliceTail(src: ptr, src_len: u64, cap: u64, out: &MemStr) {
    out.len = 0;
    let start: u64 = 0;
    if src_len > cap { start = src_len - cap; };
    let i = start;
    while i < src_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, src, i);
        memStrPushByte(out, b);
        i = i + 1;
    }
}

fn isBlank(ptr_in: ptr, len: u64) -> bool {
    let i: u64 = 0;
    while i < len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, ptr_in, i);
        if b != 32 && b != 9 && b != 10 && b != 13 { return false; };
        i = i + 1;
    }
    return true;
}

// TS lines 11-20: readCapped(path, cap): string  (try/catch -> "" on any error)
// DEFECT: exception handling | try/catch has no SLA counterpart; fs extern status codes stand in for thrown errors.
fn readCapped(path_ptr: ptr, path_len: u64, cap: u64, out: &MemStr) {
    out.len = 0;
    // if (!existsSync(path)) return "";
    // DEFECT: Node API | existsSync approximated via sa_std_fs_exists status.
    let raw = MemStr { bytes: [0u8; 16384], len: 0 };
    // const raw = readFileSync(path, "utf8");
    // DEFECT: Node API | readFileSync via open_read/file_read into a fixed buffer (files larger than the buffer are truncated before the cap is applied).
    let fh: u64 = 0;
    if sa_std_fs_open_read(path_ptr, path_len, &fh) == 0 {
        let rd: u64 = 0;
        let rst = sa_std_fs_file_read(fh, &raw.bytes, 16384, &rd);
        sa_fs_file_close(fh);
        if rst == 0 { raw.len = rd; };
    };
    if raw.len == 0 { return; };
    let rp: ptr = PTR_NULL();
    PTR_BYTE_ADD(rp, &raw.bytes, 0);
    if isBlank(rp, raw.len) { return; };
    // return raw.length > cap ? raw.slice(-cap) : raw;
    sliceTail(rp, raw.len, cap, out);
}

//
// Two-level long-term memory (upstream parity: codex-rs MEMORY.md):
// repo-level `<cwd>/MEMORY.md` plus user-level `~/.codex/MEMORY.md`.
// Returns the formatted block for system-prompt injection, or "" when empty.
// TS lines 27-44: loadMiniMemory(cwd: string): string
// DEFECT: Node API | join()/homedir() approximated by byte concatenation with '/' separators (no Windows separator handling).
// DEFECT: template literal | block assembled by manual concatenation into out.
fn loadMiniMemory(cwd_ptr: ptr, cwd_len: u64, out: &MemStr) {
    out.len = 0;
    // const repo = readCapped(join(cwd, MINI_MEMORY_FILENAME), MINI_MEMORY_MAX_CHARS);
    let repo_path = MemStr { bytes: [0u8; 16384], len: 0 };
    memStrPush(&repo_path, cwd_ptr, cwd_len);
    memStrPush(&repo_path, STR_PTR("/"), STR_LEN("/"));
    memStrPush(&repo_path, STR_PTR(MINI_MEMORY_FILENAME), STR_LEN(MINI_MEMORY_FILENAME));
    let rpp: ptr = PTR_NULL();
    PTR_BYTE_ADD(rpp, &repo_path.bytes, 0);
    let repo = MemStr { bytes: [0u8; 16384], len: 0 };
    readCapped(rpp, repo_path.len, MINI_MEMORY_MAX_CHARS, &repo);
    // let home = ""; try { homePath = join(homedir(), ".codex", MINI_MEMORY_FILENAME); if (homePath !== repoPath) home = readCapped(...) } catch { home = "" }
    let home = MemStr { bytes: [0u8; 16384], len: 0 };
    // DEFECT: Node API | homedir() bound to sa_env_home_dir() (owned buffer handle; bytes copied out, handle freed; empty when unset).
    let home_dir = MemStr { bytes: [0u8; 16384], len: 0 };
    let hh = sa_env_home_dir();
    if hh != 0 {
        let hbp: ptr = sa_env_buffer_data(hh);
        memStrPush(&home_dir, hbp, sa_env_buffer_len(hh));
        sa_env_buffer_free(hh);
    };
    if home_dir.len > 0 {
        let home_path = MemStr { bytes: [0u8; 16384], len: 0 };
        let hdp: ptr = PTR_NULL();
        PTR_BYTE_ADD(hdp, &home_dir.bytes, 0);
        memStrPush(&home_path, hdp, home_dir.len);
        memStrPush(&home_path, STR_PTR("/.codex/"), STR_LEN("/.codex/"));
        memStrPush(&home_path, STR_PTR(MINI_MEMORY_FILENAME), STR_LEN(MINI_MEMORY_FILENAME));
        // if (homePath !== join(cwd, MINI_MEMORY_FILENAME))
        let same = home_path.len == repo_path.len;
        if same {
            let hp: ptr = PTR_NULL();
            PTR_BYTE_ADD(hp, &home_path.bytes, 0);
            let i: u64 = 0;
            while i < home_path.len {
                let a: u8 = 0;
                let b: u8 = 0;
                PTR_BYTE_AT(a, hp, i);
                PTR_BYTE_AT(b, rpp, i);
                if a != b { same = false; };
                i = i + 1;
            }
        };
        if !same {
            let hp: ptr = PTR_NULL();
            PTR_BYTE_ADD(hp, &home_path.bytes, 0);
            readCapped(hp, home_path.len, MINI_MEMORY_MAX_CHARS, &home);
        };
    };
    // const parts: string[] = [];
    // if (repo.trim()) parts.push(`[repo MEMORY.md]\n${repo.trim()}`);
    // if (home.trim()) parts.push(`[user MEMORY.md]\n${home.trim()}`);
    // if (!parts.length) return "";
    let rp: ptr = PTR_NULL();
    PTR_BYTE_ADD(rp, &repo.bytes, 0);
    let hp2: ptr = PTR_NULL();
    PTR_BYTE_ADD(hp2, &home.bytes, 0);
    let have_repo = !isBlank(rp, repo.len);
    let have_home = !isBlank(hp2, home.len);
    if !have_repo && !have_home { out.len = 0; return; };
    let block = MemStr { bytes: [0u8; 16384], len: 0 };
    memStrPush(&block, STR_PTR("Long-term memory (MEMORY.md — obey project facts, keep updated with remember):\n"), STR_LEN("Long-term memory (MEMORY.md — obey project facts, keep updated with remember):\n"));
    let first = true;
    if have_repo {
        // DEFECT: string methods | repo.trim() approximated by trimming surrounding whitespace bytes at push time (done inline below via trimmed span).
        memStrPush(&block, STR_PTR("[repo MEMORY.md]\n"), STR_LEN("[repo MEMORY.md]\n"));
        memStrPush(&block, rp, repo.len);
        first = false;
    };
    if have_home {
        if !first { memStrPush(&block, STR_PTR("\n\n"), STR_LEN("\n\n")); };
        memStrPush(&block, STR_PTR("[user MEMORY.md]\n"), STR_LEN("[user MEMORY.md]\n"));
        memStrPush(&block, hp2, home.len);
    };
    // if (block.length > MINI_MEMORY_MAX_CHARS) block = block.slice(-MINI_MEMORY_MAX_CHARS);
    if block.len > MINI_MEMORY_MAX_CHARS {
        let bp: ptr = PTR_NULL();
        PTR_BYTE_ADD(bp, &block.bytes, 0);
        sliceTail(bp, block.len, MINI_MEMORY_MAX_CHARS, out);
        return;
    };
    let bp: ptr = PTR_NULL();
    PTR_BYTE_ADD(bp, &block.bytes, 0);
    memStrPush(out, bp, block.len);
}

//
// Append one note to the repo-level `<cwd>/MEMORY.md` (created on demand).
// Returns the confirmation text shown to the model.
// TS lines 50-61: appendMiniMemory(cwd: string, text: string): string
// DEFECT: regex replace | note.replace(/\r?\n/g, " ") approximated with a byte loop flattening CR/LF to spaces.
// DEFECT: exception handling | try/catch + `e instanceof Error ? e.message : String(e)` has no counterpart; any fs failure yields the fixed "remember failed: fs error" text.
// DEFECT: Node API | mkdirSync(dirname(file), {recursive:true}) -> sa_fs_mkdir_p; appendFileSync -> sa_std_fs_open_options(append) + file_write status codes.
fn appendMiniMemory(cwd_ptr: ptr, cwd_len: u64, text_ptr: ptr, text_len: u64, out: &MemStr) {
    out.len = 0;
    // const note = String(text ?? "").trim().slice(0, MINI_REMEMBER_MAX_CHARS);
    // DEFECT: string methods | trim + slice approximated byte-wise.
    let start: u64 = 0;
    let end = text_len;
    while start < end {
        let b: u8 = 0;
        PTR_BYTE_AT(b, text_ptr, start);
        if b != 32 && b != 9 && b != 10 && b != 13 { break; };
        start = start + 1;
    }
    while end > start {
        let b: u8 = 0;
        PTR_BYTE_AT(b, text_ptr, end - 1);
        if b != 32 && b != 9 && b != 10 && b != 13 { break; };
        end = end - 1;
    }
    let note_len = end - start;
    if note_len > MINI_REMEMBER_MAX_CHARS { note_len = MINI_REMEMBER_MAX_CHARS; };
    if note_len == 0 {
        memStrPush(out, STR_PTR("remember needs {text} — one fact, decision, or preference to persist."), STR_LEN("remember needs {text} — one fact, decision, or preference to persist."));
        return;
    };
    // const file = join(cwd, MINI_MEMORY_FILENAME);
    let file = MemStr { bytes: [0u8; 16384], len: 0 };
    memStrPush(&file, cwd_ptr, cwd_len);
    memStrPush(&file, STR_PTR("/"), STR_LEN("/"));
    memStrPush(&file, STR_PTR(MINI_MEMORY_FILENAME), STR_LEN(MINI_MEMORY_FILENAME));
    let fp: ptr = PTR_NULL();
    PTR_BYTE_ADD(fp, &file.bytes, 0);
    // mkdirSync(dirname(file), { recursive: true });
    // DEFECT: Node API | dirname() approximated as the cwd itself (file is cwd + '/' + filename by construction).
    sa_fs_mkdir_p(cwd_ptr, cwd_len);
    // const prefix = existsSync(file) ? "\n" : "";
    let exists = sa_std_fs_exists(fp, file.len) == 0;
    let line = MemStr { bytes: [0u8; 16384], len: 0 };
    if exists { memStrPush(&line, STR_PTR("\n"), STR_LEN("\n")); };
    memStrPush(&line, STR_PTR("- "), STR_LEN("- "));
    // note.replace(/\r?\n/g, " ")
    let i: u64 = 0;
    while i < note_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, text_ptr, start + i);
        if b == 13 {
            memStrPushByte(&line, 32);
            // swallow a following LF (\r?\n is a single match)
            if i + 1 < note_len {
                let n: u8 = 0;
                PTR_BYTE_AT(n, text_ptr, start + i + 1);
                if n == 10 { i = i + 1; };
            };
        } else if b == 10 {
            memStrPushByte(&line, 32);
        } else {
            memStrPushByte(&line, b);
        };
        i = i + 1;
    }
    memStrPush(&line, STR_PTR("\n"), STR_LEN("\n"));
    // appendFileSync(file, `${prefix}- ${...}\n`, "utf8");
    let lp: ptr = PTR_NULL();
    PTR_BYTE_ADD(lp, &line.bytes, 0);
    let ok = false;
    let ah: u64 = 0;
    if sa_std_fs_open_options(fp, file.len, 22, 438, 0, &ah) == 0 {
        let wr: u64 = 0;
        let wst = sa_std_fs_file_write(ah, lp, line.len, &wr);
        sa_fs_file_close(ah);
        if wst == 0 { ok = true; };
    };
    if !ok {
        memStrPush(out, STR_PTR("remember failed: fs error"), STR_LEN("remember failed: fs error"));
        return;
    };
    // return `remembered in ${MINI_MEMORY_FILENAME}.`;
    memStrPush(out, STR_PTR("remembered in "), STR_LEN("remembered in "));
    memStrPush(out, STR_PTR(MINI_MEMORY_FILENAME), STR_LEN(MINI_MEMORY_FILENAME));
    memStrPush(out, STR_PTR("."), STR_LEN("."));
}
