// Converted 1:1 from mini-codex/src/tools.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "sa_std/io/print.sai"
@import "sa_std/ptr.sa"
@import "./types.sla"
@import "./imageView.sla"

// TS: import type { ToolDef } from "./types.ts";  (type-only import, ToolDef = { name, description, schema: Record<string, unknown> })
// TS: import { IMAGE_VIEW_TOOL } from "./imageView.ts";
// DEFECT: cross-unit const object import — IMAGE_VIEW_TOOL is a ToolDef value defined in imageView.sla; SLA @import cannot import a data constant, approximated by calling imageView_tool() from that unit in tools_at().

// ---------------------------------------------------------------------------
// TS: export const TOOLS: ToolDef[] = [ ...7 entries... ]
// SLA approximation: ToolDef values are materialised per index by
// tools_name_at / tools_description_at / tools_schema_at (schema kept as the
// exact JSON text of the TS object literal).
// DEFECT: dynamic object — every `schema` is a nested Record<string, unknown>
// object literal (properties/required/additionalProperties, some nested
// `items` objects); SLA has no object literals, so schemas are stored as
// JSON text buffers (parsed by the fix phase via sa_json_*).
// ---------------------------------------------------------------------------

fn TOOLS_count() -> u64 { return 7; }

// Index order 1:1 with source: 0 sa_vm, 1 read_skill, 2 remember,
// 3 update_plan, 4 IMAGE_VIEW_TOOL, 5 list_mcp_resources, 6 read_mcp_resource.
fn TOOLS_name_at(idx: u64, out_len: &u64) -> ptr {
    if idx == 0 { *out_len = STR_LEN("sa_vm"); return STR_PTR("sa_vm"); };
    if idx == 1 { *out_len = STR_LEN("read_skill"); return STR_PTR("read_skill"); };
    if idx == 2 { *out_len = STR_LEN("remember"); return STR_PTR("remember"); };
    if idx == 3 { *out_len = STR_LEN("update_plan"); return STR_PTR("update_plan"); };
    if idx == 4 {
        // DEFECT: `IMAGE_VIEW_TOOL as ToolDef` — TS type assertion on an imported const; name forwarded to imageView.sla.
        return image_view_tool_name(out_len);
    };
    if idx == 5 { *out_len = STR_LEN("list_mcp_resources"); return STR_PTR("list_mcp_resources"); };
    *out_len = STR_LEN("read_mcp_resource");
    return STR_PTR("read_mcp_resource");
}

fn TOOLS_description_at(idx: u64, out_len: &u64) -> ptr {
    if idx == 0 { *out_len = STR_LEN("Ultra workspace tools: {action, ...flat params}, e.g. {action:\"read_file\",path:\"package.json\"}. Writes: write_file {path,content}, edit_file {path,old_text,new_text} (old_text EXACT from prior read, unique context; NEVER input/output), apply_patch {patch}. Batch independent reads/searches only: {action:\"parallel\",parallel:[{action:\"list_dir\",dir:\"src\"},{action:\"grep_search\",query:\"x\"}]} (flat subtasks, same path never twice, writes never batched with reads of same file). Paths workspace-relative. See sa-vm SKILL.md via read_skill for gated AST actions."); return STR_PTR("Ultra workspace tools: {action, ...flat params}, e.g. {action:\"read_file\",path:\"package.json\"}. Writes: write_file {path,content}, edit_file {path,old_text,new_text} (old_text EXACT from prior read, unique context; NEVER input/output), apply_patch {patch}. Batch independent reads/searches only: {action:\"parallel\",parallel:[{action:\"list_dir\",dir:\"src\"},{action:\"grep_search\",query:\"x\"}]} (flat subtasks, same path never twice, writes never batched with reads of same file). Paths workspace-relative. See sa-vm SKILL.md via read_skill for gated AST actions."); };
    if idx == 1 { *out_len = STR_LEN("Load a subscribed SKILL.md by name (progressive disclosure)"); return STR_PTR("Load a subscribed SKILL.md by name (progressive disclosure)"); };
    if idx == 2 { *out_len = STR_LEN("Persist one durable fact/decision/preference to the repo MEMORY.md so future runs remember it. Args {text}. Use for user preferences, project conventions, and decisions worth keeping — not for ephemeral task state."); return STR_PTR("Persist one durable fact/decision/preference to the repo MEMORY.md so future runs remember it. Args {text}. Use for user preferences, project conventions, and decisions worth keeping — not for ephemeral task state."); };
    if idx == 3 { *out_len = STR_LEN("Track genuinely multi-step work: for any task with 3+ steps you must call update_plan first with the full checklist, then update statuses as verified work progresses. Each call replaces the whole list."); return STR_PTR("Track genuinely multi-step work: for any task with 3+ steps you must call update_plan first with the full checklist, then update statuses as verified work progresses. Each call replaces the whole list."); };
    if idx == 4 { return image_view_tool_description(out_len); };
    if idx == 5 { *out_len = STR_LEN("List files/objects exposed by MCP servers (config.toml [mcp_servers.*]). Args {server?} - omit for all connected servers. Read one with read_mcp_resource."); return STR_PTR("List files/objects exposed by MCP servers (config.toml [mcp_servers.*]). Args {server?} - omit for all connected servers. Read one with read_mcp_resource."); };
    *out_len = STR_LEN("Read one MCP server resource as text. Args {server, uri} (both required; discover URIs with list_mcp_resources). Binary content is described, not inlined.");
    return STR_PTR("Read one MCP server resource as text. Args {server, uri} (both required; discover URIs with list_mcp_resources). Binary content is described, not inlined.");
}

// Schema JSON text per TOOLS index (1:1 transcription of the TS literals).
fn TOOLS_schema_at(idx: u64, out: &ByteBuf) -> void {
    buf_reset(out);
    if idx == 0 {
        // sa_vm schema: properties action/path/query/content/old_text/new_text/
        // replaceAll/patch/diff/from/to/source/dest/dir/command/parallel,
        // required ["action"], additionalProperties: true.
        buf_append_lit(out, STR_PTR("{\"type\":\"object\",\"properties\":{\"action\":{\"type\":\"string\",\"description\":\"Native action: read_file/read_lines/list_dir/find_files/grep_search/write_file/edit_file/apply_patch/parallel/run_host/run_bun/git_status/git_diff/ensure_dir/delete_file/move_file/copy_file\"},\"path\":{\"type\":\"string\"},\"query\":{\"type\":\"string\"},\"content\":{\"type\":\"string\"},\"old_text\":{\"type\":\"string\",\"description\":\"Exact existing text for edit_file\"},\"new_text\":{\"type\":\"string\",\"description\":\"Replacement text for edit_file\"},\"replaceAll\":{\"type\":\"boolean\"},\"patch\":{\"type\":\"string\"},\"diff\":{\"type\":\"string\"},\"from\":{\"type\":\"string\"},\"to\":{\"type\":\"string\"},\"source\":{\"type\":\"string\"},\"dest\":{\"type\":\"string\"},\"dir\":{\"type\":\"string\"},\"command\":{\"type\":\"string\"},\"parallel\":{\"type\":\"array\",\"description\":\"Independent subtasks [{action,...flat params}] (no nesting, no same-path read/write mixing)\"}},\"required\":[\"action\"],\"additionalProperties\":true}"), STR_LEN("{\"type\":\"object\",\"properties\":{\"action\":{\"type\":\"string\",\"description\":\"Native action: read_file/read_lines/list_dir/find_files/grep_search/write_file/edit_file/apply_patch/parallel/run_host/run_bun/git_status/git_diff/ensure_dir/delete_file/move_file/copy_file\"},\"path\":{\"type\":\"string\"},\"query\":{\"type\":\"string\"},\"content\":{\"type\":\"string\"},\"old_text\":{\"type\":\"string\",\"description\":\"Exact existing text for edit_file\"},\"new_text\":{\"type\":\"string\",\"description\":\"Replacement text for edit_file\"},\"replaceAll\":{\"type\":\"boolean\"},\"patch\":{\"type\":\"string\"},\"diff\":{\"type\":\"string\"},\"from\":{\"type\":\"string\"},\"to\":{\"type\":\"string\"},\"source\":{\"type\":\"string\"},\"dest\":{\"type\":\"string\"},\"dir\":{\"type\":\"string\"},\"command\":{\"type\":\"string\"},\"parallel\":{\"type\":\"array\",\"description\":\"Independent subtasks [{action,...flat params}] (no nesting, no same-path read/write mixing)\"}},\"required\":[\"action\"],\"additionalProperties\":true}"));
        return;
    };
    if idx == 1 {
        buf_append_lit(out, STR_PTR("{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"}},\"required\":[\"name\"],\"additionalProperties\":false}"), STR_LEN("{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"}},\"required\":[\"name\"],\"additionalProperties\":false}"));
        return;
    };
    if idx == 2 {
        buf_append_lit(out, STR_PTR("{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\"}},\"required\":[\"text\"],\"additionalProperties\":false}"), STR_LEN("{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\"}},\"required\":[\"text\"],\"additionalProperties\":false}"));
        return;
    };
    if idx == 3 {
        // update_plan schema: todos/steps are arrays of nested objects
        // ({content,status} / {step,status}); additionalProperties: true, no required.
        // DEFECT: dynamic object — nested `items: {type:"object", properties:{...}}` has no struct equivalent; kept inside the JSON text.
        buf_append_lit(out, STR_PTR("{\"type\":\"object\",\"properties\":{\"todos\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"content\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"}}}},\"steps\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"step\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"}}}},\"explanation\":{\"type\":\"string\"}},\"additionalProperties\":true}"), STR_LEN("{\"type\":\"object\",\"properties\":{\"todos\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"content\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"}}}},\"steps\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"step\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"}}}},\"explanation\":{\"type\":\"string\"}},\"additionalProperties\":true}"));
        return;
    };
    if idx == 4 { image_view_tool_schema(out); return; };
    if idx == 5 {
        buf_append_lit(out, STR_PTR("{\"type\":\"object\",\"properties\":{\"server\":{\"type\":\"string\"}},\"required\":[],\"additionalProperties\":false}"), STR_LEN("{\"type\":\"object\",\"properties\":{\"server\":{\"type\":\"string\"}},\"required\":[],\"additionalProperties\":false}"));
        return;
    };
    buf_append_lit(out, STR_PTR("{\"type\":\"object\",\"properties\":{\"server\":{\"type\":\"string\"},\"uri\":{\"type\":\"string\"}},\"required\":[\"server\",\"uri\"],\"additionalProperties\":false}"), STR_LEN("{\"type\":\"object\",\"properties\":{\"server\":{\"type\":\"string\"},\"uri\":{\"type\":\"string\"}},\"required\":[\"server\",\"uri\"],\"additionalProperties\":false}"));
}

// ---------------------------------------------------------------------------
// TS: export const SUBAGENT_TOOLS: ToolDef[] = [ ...6 entries... ]
// Same per-index materialisation as TOOLS.
// ---------------------------------------------------------------------------

fn SUBAGENT_TOOLS_count() -> u64 { return 6; }

// Index order 1:1: 0 spawn_agent, 1 send_message, 2 interrupt_agent,
// 3 wait_agent, 4 close_agent, 5 list_agents.
fn SUBAGENT_TOOLS_name_at(idx: u64, out_len: &u64) -> ptr {
    if idx == 0 { *out_len = STR_LEN("spawn_agent"); return STR_PTR("spawn_agent"); };
    if idx == 1 { *out_len = STR_LEN("send_message"); return STR_PTR("send_message"); };
    if idx == 2 { *out_len = STR_LEN("interrupt_agent"); return STR_PTR("interrupt_agent"); };
    if idx == 3 { *out_len = STR_LEN("wait_agent"); return STR_PTR("wait_agent"); };
    if idx == 4 { *out_len = STR_LEN("close_agent"); return STR_PTR("close_agent"); };
    *out_len = STR_LEN("list_agents");
    return STR_PTR("list_agents");
}

fn SUBAGENT_TOOLS_description_at(idx: u64, out_len: &u64) -> ptr {
    if idx == 0 { *out_len = STR_LEN("Delegate an independent subtask to a sub-agent (own thread, same workspace/model). Args {task_name,message,agent_type?} - task_name AND message are BOTH required. Max 5 live children, depth limit 1."); return STR_PTR("Delegate an independent subtask to a sub-agent (own thread, same workspace/model). Args {task_name,message,agent_type?} - task_name AND message are BOTH required. Max 5 live children, depth limit 1."); };
    if idx == 1 { *out_len = STR_LEN("Send a message to an existing sub-agent. Args {target,message}. Queued while it runs; starts a turn immediately when idle."); return STR_PTR("Send a message to an existing sub-agent. Args {target,message}. Queued while it runs; starts a turn immediately when idle."); };
    if idx == 2 { *out_len = STR_LEN("Interrupt a sub-agent's current turn and return its previous status. Args {target}."); return STR_PTR("Interrupt a sub-agent's current turn and return its previous status. Args {target}."); };
    if idx == 3 { *out_len = STR_LEN("Wait for sub-agents and collect final reports. Args {targets,timeout_ms?}. Always wait before the final summary."); return STR_PTR("Wait for sub-agents and collect final reports. Args {targets,timeout_ms?}. Always wait before the final summary."); };
    if idx == 4 { *out_len = STR_LEN("Close a finished sub-agent and free its slot. Args {target}."); return STR_PTR("Close a finished sub-agent and free its slot. Args {target}."); };
    *out_len = STR_LEN("List your live sub-agents.");
    return STR_PTR("List your live sub-agents.");
}

fn SUBAGENT_TOOLS_schema_at(idx: u64, out: &ByteBuf) -> void {
    buf_reset(out);
    if idx == 0 {
        buf_append_lit(out, STR_PTR("{\"type\":\"object\",\"properties\":{\"task_name\":{\"type\":\"string\"},\"taskName\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"},\"prompt\":{\"type\":\"string\"},\"text\":{\"type\":\"string\"},\"agent_type\":{\"type\":\"string\"},\"agentType\":{\"type\":\"string\"}},\"required\":[\"task_name\",\"message\"],\"additionalProperties\":false}"), STR_LEN("{\"type\":\"object\",\"properties\":{\"task_name\":{\"type\":\"string\"},\"taskName\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"},\"prompt\":{\"type\":\"string\"},\"text\":{\"type\":\"string\"},\"agent_type\":{\"type\":\"string\"},\"agentType\":{\"type\":\"string\"}},\"required\":[\"task_name\",\"message\"],\"additionalProperties\":false}"));
        return;
    };
    if idx == 1 {
        buf_append_lit(out, STR_PTR("{\"type\":\"object\",\"properties\":{\"target\":{\"type\":\"string\"},\"id\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"},\"text\":{\"type\":\"string\"}},\"required\":[\"target\",\"message\"],\"additionalProperties\":false}"), STR_LEN("{\"type\":\"object\",\"properties\":{\"target\":{\"type\":\"string\"},\"id\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"},\"text\":{\"type\":\"string\"}},\"required\":[\"target\",\"message\"],\"additionalProperties\":false}"));
        return;
    };
    if idx == 2 {
        buf_append_lit(out, STR_PTR("{\"type\":\"object\",\"properties\":{\"target\":{\"type\":\"string\"},\"id\":{\"type\":\"string\"}},\"required\":[\"target\"],\"additionalProperties\":false}"), STR_LEN("{\"type\":\"object\",\"properties\":{\"target\":{\"type\":\"string\"},\"id\":{\"type\":\"string\"}},\"required\":[\"target\"],\"additionalProperties\":false}"));
        return;
    };
    if idx == 3 {
        // wait_agent: targets is {type:"array", items:{type:"string"}}; timeout_ms is {type:"number"}.
        // DEFECT: dynamic object — nested items schema kept in JSON text only.
        buf_append_lit(out, STR_PTR("{\"type\":\"object\",\"properties\":{\"targets\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"target\":{\"type\":\"string\"},\"timeout_ms\":{\"type\":\"number\"}},\"additionalProperties\":false}"), STR_LEN("{\"type\":\"object\",\"properties\":{\"targets\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"target\":{\"type\":\"string\"},\"timeout_ms\":{\"type\":\"number\"}},\"additionalProperties\":false}"));
        return;
    };
    if idx == 4 {
        buf_append_lit(out, STR_PTR("{\"type\":\"object\",\"properties\":{\"target\":{\"type\":\"string\"}},\"required\":[\"target\"],\"additionalProperties\":false}"), STR_LEN("{\"type\":\"object\",\"properties\":{\"target\":{\"type\":\"string\"}},\"required\":[\"target\"],\"additionalProperties\":false}"));
        return;
    };
    buf_append_lit(out, STR_PTR("{\"type\":\"object\",\"properties\":{},\"additionalProperties\":false}"), STR_LEN("{\"type\":\"object\",\"properties\":{},\"additionalProperties\":false}"));
}

// TS: const SUBAGENT_NAMES = new Set(SUBAGENT_TOOLS.map((t) => t.name));
// DEFECT: Set<string> + Array.map with arrow-function closure — no Set in
// SLA; approximated by linear scan over SUBAGENT_TOOLS_name_at.
fn SUBAGENT_NAMES_has(name_ptr: ptr, name_len: u64) -> bool {
    for i in 0..6 {
        let l: u64 = 0;
        let p = SUBAGENT_TOOLS_name_at(i, &l);
        if l == name_len {
            if bytes_eq(p, l, name_ptr, name_len) { return true; };
        };
    }
    return false;
}

// TS: /** Retired send spellings: accepted (as send_message) but never advertised. */
// TS: const SEND_MESSAGE_ALIASES = new Set(["send_input", "followup_task"]);
// DEFECT: Set<string> literal — approximated by two literal compares.
fn SEND_MESSAGE_ALIASES_has(name_ptr: ptr, name_len: u64) -> bool {
    if bytes_eq(name_ptr, name_len, STR_PTR("send_input"), STR_LEN("send_input")) { return true; };
    if bytes_eq(name_ptr, name_len, STR_PTR("followup_task"), STR_LEN("followup_task")) { return true; };
    return false;
}

// TS: export function isSubagentTool(name: string): boolean {
//       return SUBAGENT_NAMES.has(name) || SEND_MESSAGE_ALIASES.has(name);
//     }
fn isSubagentTool(name_ptr: ptr, name_len: u64) -> bool {
    if SUBAGENT_NAMES_has(name_ptr, name_len) { return true; };
    return SEND_MESSAGE_ALIASES_has(name_ptr, name_len);
}

// TS: export function toolsForDepth(depth: number): ToolDef[] {
//       if ((depth | 0) > 0) return TOOLS;
//       return [...TOOLS, ...SUBAGENT_TOOLS];
//     }
// SLA approximation: writes the selected tool indices into out arrays
// (out_kind 0 = TOOLS index, 1 = SUBAGENT_TOOLS index) and returns the count.
// DEFECT: array spread [...TOOLS, ...SUBAGENT_TOOLS] builds a fresh array
// identity in TS; SLA has no heap arrays of structs — index-pair list used.
// DEFECT: `(depth | 0)` — TS bitwise-or truncation of a float64 to int32
// (e.g. 0.5 -> 0); approximated by comparing the i32 depth directly.
fn toolsForDepth(depth: i32, out_kind: &u64, out_idx: &u64) -> u64 {
    // out_kind / out_idx are base pointers to caller arrays of capacity 13.
    let n: u64 = 0;
    for i in 0..7 {
        ptr_u64_store(out_kind, n, 0);
        ptr_u64_store(out_idx, n, i);
        n = n + 1;
    }
    if depth > 0 { return n; };
    for i in 0..6 {
        ptr_u64_store(out_kind, n, 1);
        ptr_u64_store(out_idx, n, i);
        n = n + 1;
    }
    return n;
}

// TS: export function parseTaskName(v: unknown): string | null {
//       if (typeof v !== "string") return null;
//       const t = v.trim();
//       if (!t || t.length > 64) return null;
//       if (!/^[a-z0-9_]+$/.test(t)) return null;
//       return t;
//     }
// SLA approximation: v arrives as a JSON node handle; the string payload is
// copied trimmed into out and its length returned, or 0 for null.
// DEFECT: `unknown` + typeof runtime test — approximated via sa_json_kind_of.
// DEFECT: RegExp /^[a-z0-9_]+$/ — no regex in sa_std; hand loop over bytes
// (equivalent for this anchored character class).
// DEFECT: string | null return — approximated by length 0 = null (a valid
// task name is never empty, matching the TS `!t` rejection).
fn parseTaskName(v_node: u64, out: &ByteBuf) -> u64 {
    buf_reset(out);
    if sa_json_kind_of(v_node) != 1 { return 0; };
    let p: ptr = sa_json_string_ptr(v_node);
    let l: u64 = sa_json_string_len(v_node);
    // trim(): strip leading/trailing whitespace bytes.
    let lo: u64 = 0;
    let hi: u64 = l;
    while lo < hi {
        let c: u8 = 0;
        PTR_BYTE_AT(c, p, lo);
        if c != 32 {
            if c != 9 {
                if c != 10 {
                    if c != 13 { break; };
                };
            };
        };
        lo = lo + 1;
    }
    while hi > lo {
        let c: u8 = 0;
        PTR_BYTE_AT(c, p, hi - 1);
        if c != 32 {
            if c != 9 {
                if c != 10 {
                    if c != 13 { break; };
                };
            };
        };
        hi = hi - 1;
    }
    let t_len = hi - lo;
    if t_len == 0 { return 0; };
    if t_len > 64 { return 0; };
    for i in 0..t_len {
        let c: u8 = 0;
        PTR_BYTE_AT(c, p, lo + i);
        let ok = false;
        if c >= 97 {
            if c <= 122 { ok = true; };
        };
        if c >= 48 {
            if c <= 57 { ok = true; };
        };
        if c == 95 { ok = true; };
        if !ok { return 0; };
        buf_append_byte(out, c);
    }
    return t_len;
}
