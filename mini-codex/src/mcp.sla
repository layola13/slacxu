// Converted 1:1 from mini-codex/src/mcp.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
// mini-codex standalone MCP client (Codex-style, zero-dep).
// Mirrors apps/server/src/agentRuntime/miniMcp.ts semantics:
// config ~/.codex/config.toml [mcp_servers.*] -> `mcp__<server>__<tool>`.
// Keep the two files in sync (sanitize / qualified names / filtering /
// result-to-text must match or prompts behave differently).

@import "sa_std/io/print.sai"
@import "sa_std/ptr.sa"
@import "sa_std/env.sai"
@import "sa_std/fs.sai"
@import "sa_std/string.sa"
@import "sa_std/json.sai"
@import "./types.sla"
// DEFECT: node:child_process (spawn/ChildProcess), node:fs/promises (readFile),
// node:os (homedir), node:path (join) and node:crypto (createHash) have no
// sa_std counterpart; they appear below as extern-style placeholder calls.

// export const MCP_TOOL_PREFIX = "mcp__";
// DEFECT: SLA has no string-typed module constants; "mcp__" and DELIM "__" are
// inlined as STR_PTR literals at each use site.
const MAX_NAME_LEN: u64 = 64;

// Generic text buffer: SLA string == (ptr, len) into a fixed byte array.
struct TextBuf {
    bytes: [u8; 32768],
    len: u64,
}

// export interface McpToolEntry extends ToolDef { server: string; rawName: string }
// DEFECT: interface inheritance (extends ToolDef) has no SLA counterpart;
// ToolDef fields (name/description/schema) are flattened into the struct.
struct McpToolEntry {
    name: [u8; 128], name_len: u64,
    description: [u8; 512], description_len: u64,
    schema_json: [u8; 4096], schema_json_len: u64,
    server: [u8; 128], server_len: u64,
    raw_name: [u8; 128], raw_name_len: u64,
}

struct McpToolList {
    items: [McpToolEntry; 64],
    len: u64,
}

// type ServerCfg = { name, command?, args, env?, cwd?, url?, httpHeaders?,
//   bearerTokenEnvVar?, enabled, startupTimeoutMs, toolTimeoutMs,
//   enabledTools?, disabledTools? }
// DEFECT: optional fields (T | undefined) have no SLA counterpart; each is a
// has_* flag plus a fixed buffer. Record<string,string> fields (env,
// httpHeaders) and string[] fields (args, enabledTools, disabledTools) are
// kept as JSON text buffers (dynamic object).
struct ServerCfg {
    name: [u8; 128], name_len: u64,
    has_command: bool, command: [u8; 512], command_len: u64,
    args_json: [u8; 2048], args_json_len: u64,
    has_env: bool, env_json: [u8; 2048], env_json_len: u64,
    has_cwd: bool, cwd: [u8; 512], cwd_len: u64,
    has_url: bool, url: [u8; 512], url_len: u64,
    has_http_headers: bool, http_headers_json: [u8; 2048], http_headers_json_len: u64,
    has_bearer_token_env_var: bool, bearer_token_env_var: [u8; 128], bearer_token_env_var_len: u64,
    enabled: bool,
    startup_timeout_ms: u64,
    tool_timeout_ms: u64,
    has_enabled_tools: bool, enabled_tools_json: [u8; 1024], enabled_tools_json_len: u64,
    has_disabled_tools: bool, disabled_tools_json: [u8; 1024], disabled_tools_json_len: u64,
}

struct ServerCfgList {
    items: [ServerCfg; 32],
    len: u64,
}

// export interface McpCallResult { text: string; response: { content: unknown; structuredContent: unknown } }
// DEFECT: response is a dynamic object; kept as JSON text buffer.
struct McpCallResult {
    text: [u8; 8192], text_len: u64,
    response_json: [u8; 16384], response_json_len: u64,
}

// type RawTool = { name: string; description?: string; inputSchema?: Record<string, unknown> }
struct RawTool {
    name: [u8; 128], name_len: u64,
    has_description: bool, description: [u8; 512], description_len: u64,
    has_input_schema: bool, input_schema_json: [u8; 4096], input_schema_json_len: u64,
}

struct RawToolList {
    items: [RawTool; 64],
    len: u64,
}

// type RawResource = { uri: string; name?: string; title?: string; description?: string; mimeType?: string }
struct RawResource {
    uri: [u8; 512], uri_len: u64,
    has_name: bool, name: [u8; 256], name_len: u64,
    has_title: bool, title: [u8; 256], title_len: u64,
    has_description: bool, description: [u8; 512], description_len: u64,
    has_mime_type: bool, mime_type: [u8; 128], mime_type_len: u64,
}

struct RawResourceList {
    items: [RawResource; 200],
    len: u64,
}

// export type McpResourceContent = { uri: string; mimeType?: string; text?: string; blob?: string }
struct McpResourceContent {
    uri: [u8; 512], uri_len: u64,
    has_mime_type: bool, mime_type: [u8; 128], mime_type_len: u64,
    has_text: bool, text: [u8; 8192], text_len: u64,
    has_blob: bool, blob: [u8; 8192], blob_len: u64,
}

struct McpResourceContentList {
    items: [McpResourceContent; 64],
    len: u64,
}

// export type McpResource = { server: string; uri: string; name: string; mimeType?: string }
struct McpResource {
    server: [u8; 128], server_len: u64,
    uri: [u8; 512], uri_len: u64,
    name: [u8; 512], name_len: u64,
    has_mime_type: bool, mime_type: [u8; 128], mime_type_len: u64,
}

struct McpResourceList {
    items: [McpResource; 200],
    len: u64,
}

// ---- local helpers (TS used String methods inline; SLA spells them out) ----

fn text_buf_append(buf: &TextBuf, src_ptr: ptr, src_len: u64) -> void {
    let i: u64 = 0;
    while i < src_len {
        if buf.len >= 32768 { return; };
        let b: u8 = 0;
        PTR_BYTE_AT(b, src_ptr, i);
        buf.bytes[buf.len] = b;
        buf.len = buf.len + 1;
        i = i + 1;
    }
}

fn text_buf_append_byte(buf: &TextBuf, b: u8) -> void {
    if buf.len >= 32768 { return; };
    buf.bytes[buf.len] = b;
    buf.len = buf.len + 1;
}

fn str_eq(a_ptr: ptr, a_len: u64, b_ptr: ptr, b_len: u64) -> bool {
    if a_len != b_len { return false; };
    let i: u64 = 0;
    while i < a_len {
        let a: u8 = 0;
        let b: u8 = 0;
        PTR_BYTE_AT(a, a_ptr, i);
        PTR_BYTE_AT(b, b_ptr, i);
        if a != b { return false; };
        i = i + 1;
    }
    return true;
}

fn starts_with(s_ptr: ptr, s_len: u64, p_ptr: ptr, p_len: u64) -> bool {
    if s_len < p_len { return false; };
    let i: u64 = 0;
    while i < p_len {
        let a: u8 = 0;
        let b: u8 = 0;
        PTR_BYTE_AT(a, s_ptr, i);
        PTR_BYTE_AT(b, p_ptr, i);
        if a != b { return false; };
        i = i + 1;
    }
    return true;
}

fn contains_sub(s_ptr: ptr, s_len: u64, n_ptr: ptr, n_len: u64) -> bool {
    if n_len == 0 { return true; };
    if s_len < n_len { return false; };
    let last = s_len - n_len;
    let i: u64 = 0;
    while i <= last {
        let ok = true;
        let j: u64 = 0;
        while j < n_len {
            let a: u8 = 0;
            let b: u8 = 0;
            PTR_BYTE_AT(a, s_ptr, i + j);
            PTR_BYTE_AT(b, n_ptr, j);
            if a != b { ok = false; break; };
            j = j + 1;
        }
        if ok { return true; };
        i = i + 1;
    }
    return false;
}

// Read an env var into buf; returns true when present (process.env[key]).
// DEFECT: process.env has no SLA counterpart; sa_env_get is the nearest extern.
fn env_get_buf(key_ptr: ptr, key_len: u64, buf: &TextBuf) -> bool {
    buf.len = 0;
    let h = sa_env_get(key_ptr, key_len);
    if h == 0 { return false; };
    let p: ptr = sa_env_buffer_data(h);
    let n: u64 = sa_env_buffer_len(h);
    text_buf_append(buf, p, n);
    return true;
}

fn envOff(has_v: bool, v_ptr: ptr, v_len: u64) -> bool {
    // const s = (v ?? "").trim().toLowerCase();
    // DEFECT: String.trim/toLowerCase have no sa_std counterpart; hand-rolled
    // ASCII trim + lowercase into a scratch buffer.
    let s = TextBuf { bytes: [0u8; 32768], len: 0 };
    if has_v {
        let lo: u64 = 0;
        let hi: u64 = v_len;
        while lo < hi {
            let c: u8 = 0;
            PTR_BYTE_AT(c, v_ptr, lo);
            if c != 32 && c != 9 && c != 10 && c != 13 { break; };
            lo = lo + 1;
        }
        while hi > lo {
            let c: u8 = 0;
            PTR_BYTE_AT(c, v_ptr, hi - 1);
            if c != 32 && c != 9 && c != 10 && c != 13 { break; };
            hi = hi - 1;
        }
        let i: u64 = lo;
        while i < hi {
            let c: u8 = 0;
            PTR_BYTE_AT(c, v_ptr, i);
            if c >= 65 && c <= 90 { c = c + 32; };
            text_buf_append_byte(&s, c);
            i = i + 1;
        }
    };
    let s_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(s_ptr, &s.bytes, 0);
    if str_eq(s_ptr, s.len, STR_PTR("off"), STR_LEN("off")) { return true; };
    if str_eq(s_ptr, s.len, STR_PTR("false"), STR_LEN("false")) { return true; };
    if str_eq(s_ptr, s.len, STR_PTR("0"), STR_LEN("0")) { return true; };
    if str_eq(s_ptr, s.len, STR_PTR("no"), STR_LEN("no")) { return true; };
    if str_eq(s_ptr, s.len, STR_PTR("disabled"), STR_LEN("disabled")) { return true; };
    return false;
}

fn mcpEnabled() -> bool {
    let v = TextBuf { bytes: [0u8; 32768], len: 0 };
    let has = env_get_buf(STR_PTR("MINI_MCP"), STR_LEN("MINI_MCP"), &v);
    let v_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(v_ptr, &v.bytes, 0);
    return !envOff(has, v_ptr, v.len);
}

fn numEnv(key_ptr: ptr, key_len: u64, fallback: u64, min_v: u64, max_v: u64) -> u64 {
    // const t = (process.env[key] ?? "").trim(); if (!t) return fallback;
    // const n = Number(t); if (!Number.isFinite(n)) return fallback;
    // return Math.min(max, Math.max(min, Math.floor(n)));
    // DEFECT: Number(string) parsing (floats, exponents, hex) has no sa_std
    // counterpart; approximated with an unsigned-integer scan.
    let v = TextBuf { bytes: [0u8; 32768], len: 0 };
    let has = env_get_buf(key_ptr, key_len, &v);
    if !has { return fallback; };
    let lo: u64 = 0;
    let hi: u64 = v.len;
    while lo < hi {
        if v.bytes[lo] != 32 && v.bytes[lo] != 9 { break; };
        lo = lo + 1;
    }
    while hi > lo {
        if v.bytes[hi - 1] != 32 && v.bytes[hi - 1] != 9 { break; };
        hi = hi - 1;
    }
    if lo >= hi { return fallback; };
    let n: u64 = 0;
    let i: u64 = lo;
    let any = false;
    while i < hi {
        let c: u8 = v.bytes[i];
        if c < 48 || c > 57 { return fallback; };
        n = n * 10 + (c - 48) as u64;
        any = true;
        i = i + 1;
    }
    if !any { return fallback; };
    if n < min_v { return min_v; };
    if n > max_v { return max_v; };
    return n;
}

// let workspaceRoots: string[] = [];
// DEFECT: module-level mutable state has no SLA counterpart; all module state
// lives in McpGlobals and is threaded through as &McpGlobals.
struct McpGlobals {
    workspace_roots_json: [u8; 4096], workspace_roots_len: u64,
    // const route = new Map<string, { conn: StdioConn | HttpConn; raw: string }>();
    // DEFECT: Map + union-typed values (StdioConn | HttpConn) have no SLA
    // counterpart; route is a JSON text table {"name":{kind,conn,raw}} where
    // kind 0 = stdio_conns index, 1 = http_conns index.
    route_json: [u8; 16384], route_json_len: u64,
    // const serverConns = new Map<string, StdioConn | HttpConn>();
    server_conns_json: [u8; 8192], server_conns_json_len: u64,
    stdio_conns: [StdioConn; 16], stdio_conns_len: u64,
    http_conns: [HttpConn; 16], http_conns_len: u64,
    // let cachedTools: McpToolEntry[] | null = null; let cachedAt = 0;
    has_cached_tools: bool,
    cached_tools: [McpToolEntry; 64], cached_tools_len: u64,
    cached_at: u64,
}

// fn setMcpWorkspaceRoots(roots: Array<string | undefined | null>) -> void
// DEFECT: Set<string> dedup + filter/map with a type-guard closure
// ((r): r is string => ...) have no SLA counterpart; approximated with a
// sequential scan over the JSON text array, dedup by linear search, cap 8.
// roots arrives as a JSON array text (strings / nulls).
fn setMcpWorkspaceRoots(g: &McpGlobals, roots_ptr: ptr, roots_len: u64) -> void {
    let out = TextBuf { bytes: [0u8; 32768], len: 0 };
    text_buf_append(&out, STR_PTR("["), STR_LEN("["]));
    let count: u64 = 0;
    // DEFECT: dynamic JSON array traversal relies on sa_json_* extern helpers.
    let n = sa_json_array_len(roots_ptr, roots_len);
    let i: u64 = 0;
    while i < n {
        if count >= 8 { break; };
        let item = TextBuf { bytes: [0u8; 32768], len: 0 };
        let is_str = sa_json_array_get_string(roots_ptr, roots_len, i, &item.bytes, &item.len);
        i = i + 1;
        if !is_str { continue; };
        // .map((r) => r.trim())
        let lo: u64 = 0;
        let hi: u64 = item.len;
        while lo < hi {
            if item.bytes[lo] != 32 && item.bytes[lo] != 9 && item.bytes[lo] != 10 && item.bytes[lo] != 13 { break; };
            lo = lo + 1;
        }
        while hi > lo {
            if item.bytes[hi - 1] != 32 && item.bytes[hi - 1] != 9 && item.bytes[hi - 1] != 10 && item.bytes[hi - 1] != 13 { break; };
            hi = hi - 1;
        }
        if hi <= lo { continue; };
        // dedup against already-emitted entries (Set semantics, approximated)
        let item_ptr: ptr = PTR_NULL();
        PTR_BYTE_ADD(item_ptr, &item.bytes, lo);
        let dup = false;
        let j: u64 = 0;
        let emitted = sa_json_array_len(&out.bytes, out.len);
        while j < emitted {
            let prev = TextBuf { bytes: [0u8; 32768], len: 0 };
            let ok = sa_json_array_get_string(&out.bytes, out.len, j, &prev.bytes, &prev.len);
            if ok {
                let prev_ptr: ptr = PTR_NULL();
                PTR_BYTE_ADD(prev_ptr, &prev.bytes, 0);
                if str_eq(prev_ptr, prev.len, item_ptr, hi - lo) { dup = true; break; };
            };
            j = j + 1;
        }
        if dup { continue; };
        if count > 0 { text_buf_append(&out, STR_PTR(","), STR_LEN(",")); };
        text_buf_append(&out, STR_PTR("\""), STR_LEN("\""));
        text_buf_append(&out, item_ptr, hi - lo);
        text_buf_append(&out, STR_PTR("\""), STR_LEN("\""));
        count = count + 1;
    }
    text_buf_append(&out, STR_PTR("]"), STR_LEN("]"));
    g.workspace_roots_len = 0;
    let k: u64 = 0;
    while k < out.len && k < 4096 {
        g.workspace_roots_json[k] = out.bytes[k];
        k = k + 1;
    }
    g.workspace_roots_len = k;
}

// fn workspaceRootEntries() -> Array<{ uri: string; name?: string }>
// Result written to out as a JSON array text.
// DEFECT: template literal `file://${r}` and split(/[\\/]/) regex have no SLA
// counterpart; leaf extraction is a hand scan for the last '/' or '\'.
fn workspaceRootEntries(g: &McpGlobals, out: &TextBuf) -> void {
    out.len = 0;
    text_buf_append(out, STR_PTR("["), STR_LEN("["));
    let n = sa_json_array_len(&g.workspace_roots_json, g.workspace_roots_len);
    let i: u64 = 0;
    while i < n {
        let r = TextBuf { bytes: [0u8; 32768], len: 0 };
        let ok = sa_json_array_get_string(&g.workspace_roots_json, g.workspace_roots_len, i, &r.bytes, &r.len);
        i = i + 1;
        if !ok { continue; };
        if i > 1 { text_buf_append(out, STR_PTR(","), STR_LEN(",")); };
        text_buf_append(out, STR_PTR("{\"uri\":\""), STR_LEN("{\"uri\":\""));
        let r_ptr: ptr = PTR_NULL();
        PTR_BYTE_ADD(r_ptr, &r.bytes, 0);
        if !starts_with(r_ptr, r.len, STR_PTR("file://"), STR_LEN("file://")) {
            text_buf_append(out, STR_PTR("file://"), STR_LEN("file://"));
        };
        text_buf_append(out, r_ptr, r.len);
        text_buf_append(out, STR_PTR("\""), STR_LEN("\""));
        // const leaf = r.split(/[\\/]/).filter(Boolean).pop();
        let leaf_start: u64 = 0;
        let j: u64 = 0;
        while j < r.len {
            if r.bytes[j] == 47 || r.bytes[j] == 92 { leaf_start = j + 1; };
            j = j + 1;
        }
        // leaf && leaf !== r  ->  only when a separator was found mid-string
        if leaf_start > 0 && leaf_start < r.len {
            text_buf_append(out, STR_PTR(",\"name\":\""), STR_LEN(",\"name\":\""));
            text_buf_append(out, item_ptr_at(&r.bytes, leaf_start), r.len - leaf_start);
            text_buf_append(out, STR_PTR("\""), STR_LEN("\""));
        };
        text_buf_append(out, STR_PTR("}"), STR_LEN("}"));
    }
    text_buf_append(out, STR_PTR("]"), STR_LEN("]"));
}

// helper: pointer into a byte array at offset (TS used string indexing/slicing)
fn item_ptr_at(arr: &[u8; 32768], off: u64) -> ptr {
    let p: ptr = PTR_NULL();
    PTR_BYTE_ADD(p, arr, off);
    return p;
}

fn expandHome(p_ptr: ptr, p_len: u64, out: &TextBuf) -> void {
    out.len = 0;
    // if (p === "~") return homedir();
    if str_eq(p_ptr, p_len, STR_PTR("~"), STR_LEN("~")) {
        // DEFECT: node:os homedir() has no sa_std counterpart; placeholder extern.
        sa_os_homedir(&out.bytes, &out.len);
        return;
    };
    // if (p.startsWith("~/") || p.startsWith("~\\")) return join(homedir(), p.slice(2));
    if starts_with(p_ptr, p_len, STR_PTR("~/"), STR_LEN("~/")) || starts_with(p_ptr, p_len, STR_PTR("~\\"), STR_LEN("~\\")) {
        // DEFECT: node:path join() has no sa_std counterpart; approximated by
        // homedir + "/" + rest (no Windows separator normalization).
        sa_os_homedir(&out.bytes, &out.len);
        text_buf_append(out, STR_PTR("/"), STR_LEN("/"));
        let rest: ptr = PTR_NULL();
        PTR_BYTE_ADD(rest, p_ptr, 2);
        text_buf_append(out, rest, p_len - 2);
        return;
    };
    text_buf_append(out, p_ptr, p_len);
}

fn expandVars(text_ptr: ptr, text_len: u64, out: &TextBuf) -> void {
    out.len = 0;
    // return text.replace(/\$\{([A-Za-z_][A-Za-z0-9_]*)\}|\$([A-Za-z_][A-Za-z0-9_]*)/g,
    //   (_, b, p) => process.env[String(b ?? p ?? "")] ?? "");
    // DEFECT: regex replace with a callback has no SLA counterpart; hand scan
    // for $NAME and ${NAME}, each replaced by the env value or "".
    let i: u64 = 0;
    while i < text_len {
        let c: u8 = 0;
        PTR_BYTE_AT(c, text_ptr, i);
        if c != 36 {
            text_buf_append_byte(out, c);
            i = i + 1;
            continue;
        };
        // '$' seen: parse optional '{' NAME '}' or bare NAME
        let j: u64 = i + 1;
        let braced = false;
        if j < text_len {
            let b: u8 = 0;
            PTR_BYTE_AT(b, text_ptr, j);
            if b == 123 { braced = true; j = j + 1; };
        };
        let name_start: u64 = j;
        while j < text_len {
            let b: u8 = 0;
            PTR_BYTE_AT(b, text_ptr, j);
            let is_name = (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || (b >= 48 && b <= 57) || b == 95;
            if !is_name { break; };
            j = j + 1;
        }
        if j == name_start {
            // not a variable reference: keep the '$' verbatim
            text_buf_append_byte(out, c);
            i = i + 1;
            continue;
        };
        let name_ptr: ptr = PTR_NULL();
        PTR_BYTE_ADD(name_ptr, text_ptr, name_start);
        let val = TextBuf { bytes: [0u8; 32768], len: 0 };
        let has = env_get_buf(name_ptr, j - name_start, &val);
        if has {
            let val_ptr: ptr = PTR_NULL();
            PTR_BYTE_ADD(val_ptr, &val.bytes, 0);
            text_buf_append(out, val_ptr, val.len);
        };
        i = j;
        if braced && i < text_len {
            let b: u8 = 0;
            PTR_BYTE_AT(b, text_ptr, i);
            if b == 125 { i = i + 1; };
        };
    }
}

fn sanitizeMcpPart(v_ptr: ptr, v_len: u64, out: &TextBuf) -> void {
    out.len = 0;
    // for (const ch of v) out += /[0-9A-Za-z_]/.test(ch) ? ch : "_";
    // DEFECT: for..of iterates Unicode code points and the char test is a
    // regex; approximated byte-wise (non-ASCII bytes each become '_').
    let i: u64 = 0;
    while i < v_len {
        let c: u8 = 0;
        PTR_BYTE_AT(c, v_ptr, i);
        let ok = (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95;
        if ok { text_buf_append_byte(out, c); } else { text_buf_append_byte(out, 95); };
        i = i + 1;
    }
    if out.len == 0 { text_buf_append(out, STR_PTR("_"), STR_LEN("_")); };
}

fn shortHash(text_ptr: ptr, text_len: u64, len: u64, out: &TextBuf) -> void {
    // return createHash("sha1").update(text).digest("hex").slice(0, len);
    // DEFECT: node:crypto sha1 hex digest has no sa_std counterpart
    // (sa_std net.sai exposes sha256 only); placeholder extern + truncation.
    out.len = 0;
    let hex = TextBuf { bytes: [0u8; 32768], len: 0 };
    sa_crypto_sha1_hex(text_ptr, text_len, &hex.bytes, &hex.len);
    let n = len;
    if n > hex.len { n = hex.len; };
    let hex_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(hex_ptr, &hex.bytes, 0);
    text_buf_append(out, hex_ptr, n);
}

fn qualifiedMcpName(server_ptr: ptr, server_len: u64, tool_ptr: ptr, tool_len: u64, out: &TextBuf) -> void {
    out.len = 0;
    // const base = `${MCP_TOOL_PREFIX}${sanitizeMcpPart(server)}${DELIM}${sanitizeMcpPart(tool)}`;
    // DEFECT: template literals / immutable string slicing have no SLA
    // counterpart; assembled in fixed buffers with explicit lengths.
    let s_server = TextBuf { bytes: [0u8; 32768], len: 0 };
    sanitizeMcpPart(server_ptr, server_len, &s_server);
    let s_tool = TextBuf { bytes: [0u8; 32768], len: 0 };
    sanitizeMcpPart(tool_ptr, tool_len, &s_tool);
    let base = TextBuf { bytes: [0u8; 32768], len: 0 };
    text_buf_append(&base, STR_PTR("mcp__"), STR_LEN("mcp__"));
    let sp: ptr = PTR_NULL();
    PTR_BYTE_ADD(sp, &s_server.bytes, 0);
    text_buf_append(&base, sp, s_server.len);
    text_buf_append(&base, STR_PTR("__"), STR_LEN("__"));
    let tp: ptr = PTR_NULL();
    PTR_BYTE_ADD(tp, &s_tool.bytes, 0);
    text_buf_append(&base, tp, s_tool.len);
    if base.len <= MAX_NAME_LEN {
        let bp: ptr = PTR_NULL();
        PTR_BYTE_ADD(bp, &base.bytes, 0);
        text_buf_append(out, bp, base.len);
        return;
    };
    // const suffix = `_${shortHash(`${server}\0${tool}`)}`;
    let key = TextBuf { bytes: [0u8; 32768], len: 0 };
    text_buf_append(&key, server_ptr, server_len);
    text_buf_append_byte(&key, 0);
    text_buf_append(&key, tool_ptr, tool_len);
    let hash = TextBuf { bytes: [0u8; 32768], len: 0 };
    let key_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(key_ptr, &key.bytes, 0);
    shortHash(key_ptr, key.len, 12, &hash);
    let suffix = TextBuf { bytes: [0u8; 32768], len: 0 };
    text_buf_append(&suffix, STR_PTR("_"), STR_LEN("_"));
    let hp: ptr = PTR_NULL();
    PTR_BYTE_ADD(hp, &hash.bytes, 0);
    text_buf_append(&suffix, hp, hash.len);
    // return `${base.slice(0, Math.max(1, MAX_NAME_LEN - suffix.length))}${suffix}`;
    let keep = MAX_NAME_LEN - suffix.len;
    if keep < 1 { keep = 1; };
    if keep > base.len { keep = base.len; };
    let bp2: ptr = PTR_NULL();
    PTR_BYTE_ADD(bp2, &base.bytes, 0);
    text_buf_append(out, bp2, keep);
    let xp: ptr = PTR_NULL();
    PTR_BYTE_ADD(xp, &suffix.bytes, 0);
    text_buf_append(out, xp, suffix.len);
}

fn isMcpTool(name_ptr: ptr, name_len: u64) -> bool {
    // return name.startsWith(MCP_TOOL_PREFIX) && name.includes(DELIM);
    if !starts_with(name_ptr, name_len, STR_PTR("mcp__"), STR_LEN("mcp__")) { return false; };
    return contains_sub(name_ptr, name_len, STR_PTR("__"), STR_LEN("__"));
}

// fn parseValue(text: string) -> unknown
// Result is written to out as JSON text (a parsed value re-serialized).
// DEFECT: `unknown` return type / dynamic values have no SLA counterpart;
// every value is carried as JSON text. JSON.parse is approximated by the
// hand parser below + sa_json_* externs. Recursion is kept 1:1.
fn parseValue(text_ptr: ptr, text_len: u64, out: &TextBuf) -> void {
    out.len = 0;
    if str_eq(text_ptr, text_len, STR_PTR("true"), STR_LEN("true")) {
        text_buf_append(out, STR_PTR("true"), STR_LEN("true"));
        return;
    };
    if str_eq(text_ptr, text_len, STR_PTR("false"), STR_LEN("false")) {
        text_buf_append(out, STR_PTR("false"), STR_LEN("false"));
        return;
    };
    // const q = text.match(/^"((?:[^"\\]|\\.)*)"$/) ?? text.match(/^'([^']*)'$/);
    // DEFECT: regex match has no SLA counterpart; quoted-string detection is
    // a first/last byte check, escape handling approximated by sa_json_*.
    if text_len >= 2 {
        let first: u8 = 0;
        let last: u8 = 0;
        PTR_BYTE_AT(first, text_ptr, 0);
        PTR_BYTE_AT(last, text_ptr, text_len - 1);
        if (first == 34 && last == 34) || (first == 39 && last == 39) {
            // try { return JSON.parse("\"" + inner-escaped + "\""); }
            // catch { return inner; }
            // DEFECT: try/catch has no SLA counterpart; parse status code from
            // the sa_json_* extern decides inner-escaped vs raw inner.
            let inner: ptr = PTR_NULL();
            PTR_BYTE_ADD(inner, text_ptr, 1);
            let st = sa_json_parse_string(inner, text_len - 2, &out.bytes, &out.len);
            if st != 0 {
                out.len = 0;
                text_buf_append(out, inner, text_len - 2);
            };
            return;
        };
    };
    // if (/^-?\d+$/.test(text) || /^-?\d*\.\d+$/.test(text)) return Number(text);
    // DEFECT: regex + Number() semantics approximated by a digit scan; the
    // matched text is emitted verbatim as a JSON number.
    let is_num = true;
    let digits: u64 = 0;
    let dots: u64 = 0;
    let i: u64 = 0;
    if text_len > 0 {
        let c0: u8 = 0;
        PTR_BYTE_AT(c0, text_ptr, 0);
        if c0 == 45 { i = 1; };
    };
    while i < text_len {
        let c: u8 = 0;
        PTR_BYTE_AT(c, text_ptr, i);
        if c >= 48 && c <= 57 { digits = digits + 1; } else if c == 46 { dots = dots + 1; } else { is_num = false; break; };
        i = i + 1;
    }
    if is_num && digits > 0 && dots <= 1 {
        text_buf_append(out, text_ptr, text_len);
        return;
    };
    // if (text.startsWith("[") && text.endsWith("]")) { ...split top-level commas... }
    if text_len >= 2 && starts_with(text_ptr, text_len, STR_PTR("["), STR_LEN("[")) {
        let lb: u8 = 0;
        PTR_BYTE_AT(lb, text_ptr, text_len - 1);
        if lb == 93 {
            let inner_ptr: ptr = PTR_NULL();
            PTR_BYTE_ADD(inner_ptr, text_ptr, 1);
            let inner_len = text_len - 2;
            // trim inner; if (!inner) return [];
            let lo: u64 = 0;
            let hi: u64 = inner_len;
            while lo < hi {
                let c: u8 = 0;
                PTR_BYTE_AT(c, inner_ptr, lo);
                if c != 32 && c != 9 && c != 10 && c != 13 { break; };
                lo = lo + 1;
            }
            while hi > lo {
                let c: u8 = 0;
                PTR_BYTE_AT(c, inner_ptr, hi - 1);
                if c != 32 && c != 9 && c != 10 && c != 13 { break; };
                hi = hi - 1;
            }
            text_buf_append(out, STR_PTR("["), STR_LEN("["));
            if lo < hi {
                // state machine: cur / depth / quote, split on ',' at depth 0
                let cur = TextBuf { bytes: [0u8; 32768], len: 0 };
                let depth: i32 = 0;
                let quote: u8 = 0;
                let has_quote = false;
                let first_part = true;
                let j: u64 = lo;
                while j < hi {
                    let ch: u8 = 0;
                    PTR_BYTE_AT(ch, inner_ptr, j);
                    if has_quote {
                        text_buf_append_byte(&cur, ch);
                        if ch == quote {
                            let prev: u8 = 0;
                            PTR_BYTE_AT(prev, inner_ptr, j - 1);
                            if prev != 92 { has_quote = false; quote = 0; };
                        };
                        j = j + 1;
                        continue;
                    };
                    if ch == 34 || ch == 39 {
                        quote = ch;
                        has_quote = true;
                        text_buf_append_byte(&cur, ch);
                        j = j + 1;
                        continue;
                    };
                    if ch == 91 || ch == 123 { depth = depth + 1; };
                    if ch == 93 || ch == 125 { depth = depth - 1; };
                    if ch == 44 && depth == 0 {
                        // parts.push(cur); cur = "";
                        if !first_part { text_buf_append(out, STR_PTR(","), STR_LEN(",")); };
                        first_part = false;
                        let part = TextBuf { bytes: [0u8; 32768], len: 0 };
                        let cp: ptr = PTR_NULL();
                        PTR_BYTE_ADD(cp, &cur.bytes, 0);
                        parseValue(cp, cur.len, &part);
                        let pp: ptr = PTR_NULL();
                        PTR_BYTE_ADD(pp, &part.bytes, 0);
                        text_buf_append(out, pp, part.len);
                        cur.len = 0;
                        j = j + 1;
                        continue;
                    };
                    text_buf_append_byte(&cur, ch);
                    j = j + 1;
                }
                // if (cur.trim()) parts.push(cur);
                let clo: u64 = 0;
                let chi: u64 = cur.len;
                while clo < chi {
                    if cur.bytes[clo] != 32 && cur.bytes[clo] != 9 && cur.bytes[clo] != 10 && cur.bytes[clo] != 13 { break; };
                    clo = clo + 1;
                }
                while chi > clo {
                    if cur.bytes[chi - 1] != 32 && cur.bytes[chi - 1] != 9 && cur.bytes[chi - 1] != 10 && cur.bytes[chi - 1] != 13 { break; };
                    chi = chi - 1;
                }
                if clo < chi {
                    if !first_part { text_buf_append(out, STR_PTR(","), STR_LEN(",")); };
                    let part = TextBuf { bytes: [0u8; 32768], len: 0 };
                    parseValue(item_ptr_at(&cur.bytes, clo), chi - clo, &part);
                    let pp: ptr = PTR_NULL();
                    PTR_BYTE_ADD(pp, &part.bytes, 0);
                    text_buf_append(out, pp, part.len);
                };
            };
            text_buf_append(out, STR_PTR("]"), STR_LEN("]"));
            return;
        };
    };
    // return text;  (bare string, emitted as a JSON string)
    text_buf_append(out, STR_PTR("\""), STR_LEN("\""));
    text_buf_append(out, text_ptr, text_len);
    text_buf_append(out, STR_PTR("\""), STR_LEN("\""));
}

// fn parseSubset(text: string) -> Record<string, Record<string, unknown>>
// Result written to out as JSON text: { "<server>": { ...nested tables... } }.
// DEFECT: nested dynamic Record objects (servers[server] ??= {}, node[k] ??=
// {} as Record) have no SLA counterpart; the table under construction is kept
// as JSON text and merged via sa_json_* extern helpers.
fn parseSubset(text_ptr: ptr, text_len: u64, out: &TextBuf) -> void {
    out.len = 0;
    text_buf_append(out, STR_PTR("{}"), STR_LEN("{}"));
    // let server: string | null = null; let sub: string[] = []; let acc = {};
    let has_server = false;
    let server = TextBuf { bytes: [0u8; 32768], len: 0 };
    let sub_json = TextBuf { bytes: [0u8; 32768], len: 0 };
    text_buf_append(&sub_json, STR_PTR("[]"), STR_LEN("[]"));
    let acc_json = TextBuf { bytes: [0u8; 32768], len: 0 };
    text_buf_append(&acc_json, STR_PTR("{}"), STR_LEN("{}"));
    // commit() closure: writes acc into servers[server] at path sub.
    // DEFECT: closure capturing mutable server/sub/acc has no SLA counterpart;
    // commit is inlined at both call sites below (header switch + end).
    // for (const rawLine of text.split(/\r?\n/))
    // DEFECT: split by regex /\r?\n/ approximated by a byte scan for '\n'
    // (a preceding '\r' is trimmed with the line).
    let line_start: u64 = 0;
    let pos: u64 = 0;
    while pos <= text_len {
        let at_end = pos == text_len;
        let is_nl = false;
        if !at_end {
            let c: u8 = 0;
            PTR_BYTE_AT(c, text_ptr, pos);
            is_nl = c == 10;
        };
        if at_end || is_nl {
            let raw_ptr: ptr = PTR_NULL();
            PTR_BYTE_ADD(raw_ptr, text_ptr, line_start);
            let raw_len = pos - line_start;
            // ---- process one line (rawLine) ----
            // const line = rawLine.split(/(^|[^\\])#/)[0]?.trim() ?? "";
            // DEFECT: regex split for comment stripping approximated by a scan
            // for '#' not preceded by '\'.
            let cut = raw_len;
            let k: u64 = 0;
            while k < raw_len {
                let c: u8 = 0;
                PTR_BYTE_AT(c, raw_ptr, k);
                if c == 35 {
                    if k == 0 { cut = 0; break; };
                    let prev: u8 = 0;
                    PTR_BYTE_AT(prev, raw_ptr, k - 1);
                    if prev != 92 { cut = k; break; };
                };
                k = k + 1;
            }
            let lo: u64 = 0;
            let hi: u64 = cut;
            while lo < hi {
                let c: u8 = 0;
                PTR_BYTE_AT(c, raw_ptr, lo);
                if c != 32 && c != 9 && c != 13 { break; };
                lo = lo + 1;
            }
            while hi > lo {
                let c: u8 = 0;
                PTR_BYTE_AT(c, raw_ptr, hi - 1);
                if c != 32 && c != 9 && c != 13 { break; };
                hi = hi - 1;
            }
            if lo < hi {
                let line_ptr: ptr = PTR_NULL();
                PTR_BYTE_ADD(line_ptr, raw_ptr, lo);
                let line_len = hi - lo;
                // const header = line.match(/^\[([^\]]+)\]$/);
                // DEFECT: regex header match approximated by first/last byte.
                let is_header = false;
                if line_len >= 2 {
                    let f: u8 = 0;
                    let l: u8 = 0;
                    PTR_BYTE_AT(f, line_ptr, 0);
                    PTR_BYTE_AT(l, line_ptr, line_len - 1);
                    is_header = f == 91 && l == 93;
                };
                if is_header {
                    // commit();  (inlined, see DEFECT above)
                    if has_server {
                        let sp: ptr = PTR_NULL();
                        PTR_BYTE_ADD(sp, &server.bytes, 0);
                        let sbp: ptr = PTR_NULL();
                        PTR_BYTE_ADD(sbp, &sub_json.bytes, 0);
                        let ap: ptr = PTR_NULL();
                        PTR_BYTE_ADD(ap, &acc_json.bytes, 0);
                        sa_json_subset_commit(&out.bytes, &out.len, sp, server.len, sbp, sub_json.len, ap, acc_json.len);
                    };
                    // const path = header[1].trim().split(".").map(strip quotes)
                    let path_json = TextBuf { bytes: [0u8; 32768], len: 0 };
                    let hp: ptr = PTR_NULL();
                    PTR_BYTE_ADD(hp, line_ptr, 1);
                    sa_toml_path_split(hp, line_len - 2, &path_json.bytes, &path_json.len);
                    // if (path[0] !== "mcp_servers" || path.length < 2) { server = null; ... continue; }
                    let p0 = TextBuf { bytes: [0u8; 32768], len: 0 };
                    let has_p0 = sa_json_array_get_string(&path_json.bytes, path_json.len, 0, &p0.bytes, &p0.len);
                    let plen = sa_json_array_len(&path_json.bytes, path_json.len);
                    let p0_ptr: ptr = PTR_NULL();
                    PTR_BYTE_ADD(p0_ptr, &p0.bytes, 0);
                    if !has_p0 || !str_eq(p0_ptr, p0.len, STR_PTR("mcp_servers"), STR_LEN("mcp_servers")) || plen < 2 {
                        has_server = false;
                        server.len = 0;
                        sub_json.len = 0;
                        text_buf_append(&sub_json, STR_PTR("[]"), STR_LEN("[]"));
                        acc_json.len = 0;
                        text_buf_append(&acc_json, STR_PTR("{}"), STR_LEN("{}"));
                    } else {
                        // server = path[1]; sub = path.slice(2); acc = {};
                        has_server = true;
                        server.len = 0;
                        sa_json_array_get_string(&path_json.bytes, path_json.len, 1, &server.bytes, &server.len);
                        sub_json.len = 0;
                        sa_json_array_slice(&path_json.bytes, path_json.len, 2, &sub_json.bytes, &sub_json.len);
                        acc_json.len = 0;
                        text_buf_append(&acc_json, STR_PTR("{}"), STR_LEN("{}"));
                    };
                } else if has_server {
                    // const eq = line.indexOf("="); if (eq < 0) continue;
                    let eq: i64 = -1;
                    let k2: u64 = 0;
                    while k2 < line_len {
                        let c: u8 = 0;
                        PTR_BYTE_AT(c, line_ptr, k2);
                        if c == 61 { eq = k2 as i64; break; };
                        k2 = k2 + 1;
                    }
                    if eq >= 0 {
                        // const key = line.slice(0, eq).trim().replace(/^["']|["']$/g, "");
                        // if (!key || key.includes(".")) continue;
                        let key = TextBuf { bytes: [0u8; 32768], len: 0 };
                        sa_trim_strip_quotes(line_ptr, eq as u64, &key.bytes, &key.len);
                        let kp: ptr = PTR_NULL();
                        PTR_BYTE_ADD(kp, &key.bytes, 0);
                        if key.len > 0 && !contains_sub(kp, key.len, STR_PTR("."), STR_LEN(".")) {
                            // acc[key] = parseValue(line.slice(eq + 1).trim());
                            let vraw: ptr = PTR_NULL();
                            PTR_BYTE_ADD(vraw, line_ptr, (eq as u64) + 1);
                            let val = TextBuf { bytes: [0u8; 32768], len: 0 };
                            let trimmed = TextBuf { bytes: [0u8; 32768], len: 0 };
                            sa_trim_bytes(vraw, line_len - (eq as u64) - 1, &trimmed.bytes, &trimmed.len);
                            let tp2: ptr = PTR_NULL();
                            PTR_BYTE_ADD(tp2, &trimmed.bytes, 0);
                            parseValue(tp2, trimmed.len, &val);
                            let vp: ptr = PTR_NULL();
                            PTR_BYTE_ADD(vp, &val.bytes, 0);
                            sa_json_object_set_json(&acc_json.bytes, &acc_json.len, kp, key.len, vp, val.len);
                        };
                    };
                };
            };
            // ---- end one line ----
            pos = pos + 1;
            line_start = pos;
            continue;
        };
        pos = pos + 1;
    }
    // commit();
    if has_server {
        let sp: ptr = PTR_NULL();
        PTR_BYTE_ADD(sp, &server.bytes, 0);
        let sbp: ptr = PTR_NULL();
        PTR_BYTE_ADD(sbp, &sub_json.bytes, 0);
        let ap: ptr = PTR_NULL();
        PTR_BYTE_ADD(ap, &acc_json.bytes, 0);
        sa_json_subset_commit(&out.bytes, &out.len, sp, server.len, sbp, sub_json.len, ap, acc_json.len);
    };
    // return servers; (already accumulated in out)
}

// fn strMap(v: unknown) -> Record<string, string> | undefined
// Returns has_result; the map is written to out as JSON text.
// DEFECT: Object.entries over a dynamic object has no SLA counterpart;
// iteration goes through sa_json_* extern helpers.
fn strMap(v_ptr: ptr, v_len: u64, has_result: &bool, out: &TextBuf) -> void {
    out.len = 0;
    has_result = false;
    // if (!v || typeof v !== "object" || Array.isArray(v)) return undefined;
    if !sa_json_is_object(v_ptr, v_len) { return; };
    text_buf_append(out, STR_PTR("{"), STR_LEN("{"));
    let n = sa_json_object_len(v_ptr, v_len);
    let i: u64 = 0;
    let first = true;
    while i < n {
        let key = TextBuf { bytes: [0u8; 32768], len: 0 };
        let val_json = TextBuf { bytes: [0u8; 32768], len: 0 };
        sa_json_object_entry(v_ptr, v_len, i, &key.bytes, &key.len, &val_json.bytes, &val_json.len);
        i = i + 1;
        // if (typeof val === "string") out[k] = val;
        // else if (typeof val === "number" || typeof val === "boolean") out[k] = String(val);
        let kind = sa_json_value_kind(&val_json.bytes, val_json.len);
        if kind != 1 && kind != 2 && kind != 3 { continue; };
        if !first { text_buf_append(out, STR_PTR(","), STR_LEN(",")); };
        first = false;
        text_buf_append(out, STR_PTR("\""), STR_LEN("\""));
        let kp: ptr = PTR_NULL();
        PTR_BYTE_ADD(kp, &key.bytes, 0);
        text_buf_append(out, kp, key.len);
        text_buf_append(out, STR_PTR("\":\""), STR_LEN("\":\""));
        if kind == 1 {
            let sv = TextBuf { bytes: [0u8; 32768], len: 0 };
            sa_json_parse_string(&val_json.bytes, val_json.len, &sv.bytes, &sv.len);
            let svp: ptr = PTR_NULL();
            PTR_BYTE_ADD(svp, &sv.bytes, 0);
            text_buf_append(out, svp, sv.len);
        } else {
            let vp: ptr = PTR_NULL();
            PTR_BYTE_ADD(vp, &val_json.bytes, 0);
            text_buf_append(out, vp, val_json.len);
        };
        text_buf_append(out, STR_PTR("\""), STR_LEN("\""));
    }
    text_buf_append(out, STR_PTR("}"), STR_LEN("}"));
    has_result = true;
}

// fn strArr(v: unknown) -> string[] | undefined
// Returns has_result; the array is written to out as a JSON array text.
fn strArr(v_ptr: ptr, v_len: u64, has_result: &bool, out: &TextBuf) -> void {
    out.len = 0;
    has_result = false;
    // if (!Array.isArray(v)) return undefined;
    if !sa_json_is_array(v_ptr, v_len) { return; };
    // return v.filter((x): x is string => typeof x === "string");
    // DEFECT: filter with a type-guard closure approximated by a scan that
    // keeps only string elements.
    text_buf_append(out, STR_PTR("["), STR_LEN("["));
    let n = sa_json_array_len(v_ptr, v_len);
    let i: u64 = 0;
    let first = true;
    while i < n {
        let item = TextBuf { bytes: [0u8; 32768], len: 0 };
        let ok = sa_json_array_get_string(v_ptr, v_len, i, &item.bytes, &item.len);
        i = i + 1;
        if !ok { continue; };
        if !first { text_buf_append(out, STR_PTR(","), STR_LEN(",")); };
        first = false;
        text_buf_append(out, STR_PTR("\""), STR_LEN("\""));
        let ip: ptr = PTR_NULL();
        PTR_BYTE_ADD(ip, &item.bytes, 0);
        text_buf_append(out, ip, item.len);
        text_buf_append(out, STR_PTR("\""), STR_LEN("\""));
    }
    text_buf_append(out, STR_PTR("]"), STR_LEN("]"));
    has_result = true;
}

// fn resolveEnvHeaders(mapping: Record<string, string>) -> Record<string, string>
// mapping and result are JSON text buffers.
fn resolveEnvHeaders(mapping_ptr: ptr, mapping_len: u64, out: &TextBuf) -> void {
    out.len = 0;
    text_buf_append(out, STR_PTR("{"), STR_LEN("{"));
    let n = sa_json_object_len(mapping_ptr, mapping_len);
    let i: u64 = 0;
    let first = true;
    while i < n {
        let header = TextBuf { bytes: [0u8; 32768], len: 0 };
        let env_name_json = TextBuf { bytes: [0u8; 32768], len: 0 };
        sa_json_object_entry(mapping_ptr, mapping_len, i, &header.bytes, &header.len, &env_name_json.bytes, &env_name_json.len);
        i = i + 1;
        let env_name = TextBuf { bytes: [0u8; 32768], len: 0 };
        sa_json_parse_string(&env_name_json.bytes, env_name_json.len, &env_name.bytes, &env_name.len);
        // const value = process.env[envName.trim()];
        let lo: u64 = 0;
        let hi: u64 = env_name.len;
        while lo < hi {
            if env_name.bytes[lo] != 32 && env_name.bytes[lo] != 9 { break; };
            lo = lo + 1;
        }
        while hi > lo {
            if env_name.bytes[hi - 1] != 32 && env_name.bytes[hi - 1] != 9 { break; };
            hi = hi - 1;
        }
        let val = TextBuf { bytes: [0u8; 32768], len: 0 };
        let has = env_get_buf(item_ptr_at(&env_name.bytes, lo), hi - lo, &val);
        // if (value) out[header] = value;
        if has && val.len > 0 {
            if !first { text_buf_append(out, STR_PTR(","), STR_LEN(",")); };
            first = false;
            text_buf_append(out, STR_PTR("\""), STR_LEN("\""));
            let hp: ptr = PTR_NULL();
            PTR_BYTE_ADD(hp, &header.bytes, 0);
            text_buf_append(out, hp, header.len);
            text_buf_append(out, STR_PTR("\":\""), STR_LEN("\":\""));
            let vp: ptr = PTR_NULL();
            PTR_BYTE_ADD(vp, &val.bytes, 0);
            text_buf_append(out, vp, val.len);
            text_buf_append(out, STR_PTR("\""), STR_LEN("\""));
        };
    }
    text_buf_append(out, STR_PTR("}"), STR_LEN("}"));
}

// fn toCfg(name: string, r: Record<string, unknown>) -> ServerCfg | null
// Returns true when a cfg was produced (false == null). r is JSON text.
// DEFECT: dynamic property access with typeof narrowing, ?? fallback chains
// and object spread ({...a, ...b}) have no SLA counterpart; each field is
// probed through sa_json_* externs in source order.
fn toCfg(name_ptr: ptr, name_len: u64, r_ptr: ptr, r_len: u64, out: &ServerCfg) -> bool {
    // const command = typeof r.command === "string" ? r.command : undefined;
    let has_command = sa_json_object_get_string(r_ptr, r_len, STR_PTR("command"), STR_LEN("command"), &out.command, &out.command_len);
    out.has_command = has_command;
    let has_url = sa_json_object_get_string(r_ptr, r_len, STR_PTR("url"), STR_LEN("url"), &out.url, &out.url_len);
    out.has_url = has_url;
    // if (!command && !url) return null;
    if !has_command && !has_url { return false; };
    // const auth = typeof r.auth === "string" ? r.auth.trim().toLowerCase() : "";
    let auth = TextBuf { bytes: [0u8; 32768], len: 0 };
    let has_auth = sa_json_object_get_string(r_ptr, r_len, STR_PTR("auth"), STR_LEN("auth"), &auth.bytes, &auth.len);
    if has_auth {
        // trim + toLowerCase in place (approximation, see envOff DEFECT)
        let lo: u64 = 0;
        let hi: u64 = auth.len;
        while lo < hi {
            if auth.bytes[lo] != 32 && auth.bytes[lo] != 9 { break; };
            lo = lo + 1;
        }
        while hi > lo {
            if auth.bytes[hi - 1] != 32 && auth.bytes[hi - 1] != 9 { break; };
            hi = hi - 1;
        }
        let w: u64 = 0;
        let i: u64 = lo;
        while i < hi {
            let c: u8 = auth.bytes[i];
            if c >= 65 && c <= 90 { c = c + 32; };
            auth.bytes[w] = c;
            w = w + 1;
            i = i + 1;
        }
        auth.len = w;
    };
    let auth_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(auth_ptr, &auth.bytes, 0);
    if str_eq(auth_ptr, auth.len, STR_PTR("ema_auth"), STR_LEN("ema_auth")) || str_eq(auth_ptr, auth.len, STR_PTR("ema"), STR_LEN("ema")) {
        // console.warn(`[mini-mcp] server '${name}' needs enterprise auth (auth = "ema_auth"), skipping: not supported by mini`);
        // DEFECT: console.warn with a template literal has no SLA counterpart;
        // static prefix via println, dynamic name dropped.
        println("[mini-mcp] server needs enterprise auth (auth = \"ema_auth\"), skipping: not supported by mini");
        return false;
    };
    // const oauth = r.oauth as Record<string, unknown> | undefined;
    // if (oauth && typeof oauth === "object" && !Array.isArray(oauth) && Object.keys(oauth).length > 0) { warn; return null; }
    let oauth = TextBuf { bytes: [0u8; 32768], len: 0 };
    let has_oauth = sa_json_object_get_json(r_ptr, r_len, STR_PTR("oauth"), STR_LEN("oauth"), &oauth.bytes, &oauth.len);
    if has_oauth && sa_json_is_object(&oauth.bytes, oauth.len) && sa_json_object_len(&oauth.bytes, oauth.len) > 0 {
        println("[mini-mcp] server declares oauth, skipping: interactive OAuth login is not supported by mini");
        return false;
    };
    // const startupSec = typeof r.startup_timeout_sec === "number" ? ... : typeof r.startup_timeout_secs === "number" ? ... : undefined;
    let startup_sec = TextBuf { bytes: [0u8; 32768], len: 0 };
    let has_startup_sec = sa_json_object_get_number(r_ptr, r_len, STR_PTR("startup_timeout_sec"), STR_LEN("startup_timeout_sec"), &startup_sec.bytes, &startup_sec.len);
    if !has_startup_sec {
        has_startup_sec = sa_json_object_get_number(r_ptr, r_len, STR_PTR("startup_timeout_secs"), STR_LEN("startup_timeout_secs"), &startup_sec.bytes, &startup_sec.len);
    };
    let tool_sec = TextBuf { bytes: [0u8; 32768], len: 0 };
    let has_tool_sec = sa_json_object_get_number(r_ptr, r_len, STR_PTR("tool_timeout_sec"), STR_LEN("tool_timeout_sec"), &tool_sec.bytes, &tool_sec.len);
    if !has_tool_sec {
        has_tool_sec = sa_json_object_get_number(r_ptr, r_len, STR_PTR("tool_timeout_secs"), STR_LEN("tool_timeout_secs"), &tool_sec.bytes, &tool_sec.len);
    };
    // const envHttpHeaders = strMap(r.env_http_headers);
    let ehh_json = TextBuf { bytes: [0u8; 32768], len: 0 };
    let has_ehh_raw = sa_json_object_get_json(r_ptr, r_len, STR_PTR("env_http_headers"), STR_LEN("env_http_headers"), &ehh_json.bytes, &ehh_json.len);
    let ehh_map = TextBuf { bytes: [0u8; 32768], len: 0 };
    let has_ehh_map = false;
    if has_ehh_raw {
        let ep: ptr = PTR_NULL();
        PTR_BYTE_ADD(ep, &ehh_json.bytes, 0);
        strMap(ep, ehh_json.len, &has_ehh_map, &ehh_map);
    };
    // const mergedHeaders = { ...(envHttpHeaders ? resolveEnvHeaders(envHttpHeaders) : {}), ...(strMap(r.http_headers ?? r.headers) ?? {}) };
    // DEFECT: object spread merge approximated by sequential JSON merge
    // (later keys overwrite, matching spread order).
    let merged = TextBuf { bytes: [0u8; 32768], len: 0 };
    text_buf_append(&merged, STR_PTR("{}"), STR_LEN("{}"));
    if has_ehh_map {
        let resolved = TextBuf { bytes: [0u8; 32768], len: 0 };
        let rp: ptr = PTR_NULL();
        PTR_BYTE_ADD(rp, &ehh_map.bytes, 0);
        resolveEnvHeaders(rp, ehh_map.len, &resolved);
        let xp: ptr = PTR_NULL();
        PTR_BYTE_ADD(xp, &resolved.bytes, 0);
        sa_json_object_merge(&merged.bytes, &merged.len, xp, resolved.len);
    };
    let hh_json = TextBuf { bytes: [0u8; 32768], len: 0 };
    let has_hh_raw = sa_json_object_get_json(r_ptr, r_len, STR_PTR("http_headers"), STR_LEN("http_headers"), &hh_json.bytes, &hh_json.len);
    if !has_hh_raw {
        has_hh_raw = sa_json_object_get_json(r_ptr, r_len, STR_PTR("headers"), STR_LEN("headers"), &hh_json.bytes, &hh_json.len);
    };
    if has_hh_raw {
        let hh_map = TextBuf { bytes: [0u8; 32768], len: 0 };
        let has_hh_map = false;
        let hp2: ptr = PTR_NULL();
        PTR_BYTE_ADD(hp2, &hh_json.bytes, 0);
        strMap(hp2, hh_json.len, &has_hh_map, &hh_map);
        if has_hh_map {
            let mp: ptr = PTR_NULL();
            PTR_BYTE_ADD(mp, &hh_map.bytes, 0);
            sa_json_object_merge(&merged.bytes, &merged.len, mp, hh_map.len);
        };
    };
    // ---- assemble the returned ServerCfg literal ----
    let ni: u64 = 0;
    while ni < name_len && ni < 128 {
        let c: u8 = 0;
        PTR_BYTE_AT(c, name_ptr, ni);
        out.name[ni] = c;
        ni = ni + 1;
    }
    out.name_len = ni;
    // args: strArr(r.args) ?? []
    let args_raw = TextBuf { bytes: [0u8; 32768], len: 0 };
    let has_args_raw = sa_json_object_get_json(r_ptr, r_len, STR_PTR("args"), STR_LEN("args"), &args_raw.bytes, &args_raw.len);
    out.args_len = 0;
    if has_args_raw {
        let arr = TextBuf { bytes: [0u8; 32768], len: 0 };
        let has_arr = false;
        let ap2: ptr = PTR_NULL();
        PTR_BYTE_ADD(ap2, &args_raw.bytes, 0);
        strArr(ap2, args_raw.len, &has_arr, &arr);
        if has_arr {
            let ci: u64 = 0;
            while ci < arr.len && ci < 2048 {
                out.args_json[ci] = arr.bytes[ci];
                ci = ci + 1;
            }
            out.args_len = ci;
        };
    };
    if out.args_len == 0 {
        out.args_json[0] = 91;
        out.args_json[1] = 93;
        out.args_len = 2;
    };
    // env: strMap(r.env ?? r.env_vars)
    let env_raw = TextBuf { bytes: [0u8; 32768], len: 0 };
    let has_env_raw = sa_json_object_get_json(r_ptr, r_len, STR_PTR("env"), STR_LEN("env"), &env_raw.bytes, &env_raw.len);
    if !has_env_raw {
        has_env_raw = sa_json_object_get_json(r_ptr, r_len, STR_PTR("env_vars"), STR_LEN("env_vars"), &env_raw.bytes, &env_raw.len);
    };
    out.has_env = false;
    out.env_len = 0;
    if has_env_raw {
        let mp2 = TextBuf { bytes: [0u8; 32768], len: 0 };
        let has_mp = false;
        let ep2: ptr = PTR_NULL();
        PTR_BYTE_ADD(ep2, &env_raw.bytes, 0);
        strMap(ep2, env_raw.len, &has_mp, &mp2);
        if has_mp {
            out.has_env = true;
            let ci: u64 = 0;
            while ci < mp2.len && ci < 2048 {
                out.env_json[ci] = mp2.bytes[ci];
                ci = ci + 1;
            }
            out.env_len = ci;
        };
    };
    // cwd: typeof r.cwd === "string" ? r.cwd : undefined
    out.has_cwd = sa_json_object_get_string(r_ptr, r_len, STR_PTR("cwd"), STR_LEN("cwd"), &out.cwd, &out.cwd_len);
    // httpHeaders: Object.keys(mergedHeaders).length ? mergedHeaders : undefined
    out.has_http_headers = sa_json_object_len(&merged.bytes, merged.len) > 0;
    out.http_headers_len = 0;
    if out.has_http_headers {
        let ci: u64 = 0;
        while ci < merged.len && ci < 2048 {
            out.http_headers_json[ci] = merged.bytes[ci];
            ci = ci + 1;
        }
        out.http_headers_len = ci;
    };
    // bearerTokenEnvVar: typeof r.bearer_token_env_var === "string" ? ... : typeof r.bearerTokenEnvVar === "string" ? ... : undefined
    out.has_bearer_token_env_var = sa_json_object_get_string(r_ptr, r_len, STR_PTR("bearer_token_env_var"), STR_LEN("bearer_token_env_var"), &out.bearer_token_env_var, &out.bearer_token_env_var_len);
    if !out.has_bearer_token_env_var {
        out.has_bearer_token_env_var = sa_json_object_get_string(r_ptr, r_len, STR_PTR("bearerTokenEnvVar"), STR_LEN("bearerTokenEnvVar"), &out.bearer_token_env_var, &out.bearer_token_env_var_len);
    };
    // enabled: r.enabled === undefined ? true : r.enabled === true
    let enabled_json = TextBuf { bytes: [0u8; 32768], len: 0 };
    let has_enabled = sa_json_object_get_json(r_ptr, r_len, STR_PTR("enabled"), STR_LEN("enabled"), &enabled_json.bytes, &enabled_json.len);
    if !has_enabled {
        out.enabled = true;
    } else {
        let ep3: ptr = PTR_NULL();
        PTR_BYTE_ADD(ep3, &enabled_json.bytes, 0);
        out.enabled = str_eq(ep3, enabled_json.len, STR_PTR("true"), STR_LEN("true"));
    };
    // startupTimeoutMs: startupSec !== undefined ? Math.min(120_000, Math.max(1_000, Math.floor(startupSec * 1000))) : numEnv("MINI_MCP_STARTUP_TIMEOUT_MS", 15_000, 1_000, 120_000)
    // DEFECT: float seconds -> ms conversion approximated in u64 arithmetic.
    if has_startup_sec {
        let sec = sa_json_number_to_u64(&startup_sec.bytes, startup_sec.len);
        let ms = sec * 1000;
        if ms < 1000 { ms = 1000; };
        if ms > 120000 { ms = 120000; };
        out.startup_timeout_ms = ms;
    } else {
        out.startup_timeout_ms = numEnv(STR_PTR("MINI_MCP_STARTUP_TIMEOUT_MS"), STR_LEN("MINI_MCP_STARTUP_TIMEOUT_MS"), 15000, 1000, 120000);
    };
    // toolTimeoutMs: toolSec !== undefined ? Math.min(300_000, Math.max(1_000, Math.floor(toolSec * 1000))) : numEnv("MINI_MCP_TOOL_TIMEOUT_MS", 60_000, 1_000, 300_000)
    if has_tool_sec {
        let sec = sa_json_number_to_u64(&tool_sec.bytes, tool_sec.len);
        let ms = sec * 1000;
        if ms < 1000 { ms = 1000; };
        if ms > 300000 { ms = 300000; };
        out.tool_timeout_ms = ms;
    } else {
        out.tool_timeout_ms = numEnv(STR_PTR("MINI_MCP_TOOL_TIMEOUT_MS"), STR_LEN("MINI_MCP_TOOL_TIMEOUT_MS"), 60000, 1000, 300000);
    };
    // enabledTools: strArr(r.enabled_tools); disabledTools: strArr(r.disabled_tools)
    let et_raw = TextBuf { bytes: [0u8; 32768], len: 0 };
    let has_et_raw = sa_json_object_get_json(r_ptr, r_len, STR_PTR("enabled_tools"), STR_LEN("enabled_tools"), &et_raw.bytes, &et_raw.len);
    out.has_enabled_tools = false;
    out.enabled_tools_len = 0;
    if has_et_raw {
        let arr = TextBuf { bytes: [0u8; 32768], len: 0 };
        let has_arr = false;
        let xp2: ptr = PTR_NULL();
        PTR_BYTE_ADD(xp2, &et_raw.bytes, 0);
        strArr(xp2, et_raw.len, &has_arr, &arr);
        if has_arr {
            out.has_enabled_tools = true;
            let ci: u64 = 0;
            while ci < arr.len && ci < 1024 {
                out.enabled_tools_json[ci] = arr.bytes[ci];
                ci = ci + 1;
            }
            out.enabled_tools_len = ci;
        };
    };
    let dt_raw = TextBuf { bytes: [0u8; 32768], len: 0 };
    let has_dt_raw = sa_json_object_get_json(r_ptr, r_len, STR_PTR("disabled_tools"), STR_LEN("disabled_tools"), &dt_raw.bytes, &dt_raw.len);
    out.has_disabled_tools = false;
    out.disabled_tools_len = 0;
    if has_dt_raw {
        let arr = TextBuf { bytes: [0u8; 32768], len: 0 };
        let has_arr = false;
        let xp3: ptr = PTR_NULL();
        PTR_BYTE_ADD(xp3, &dt_raw.bytes, 0);
        strArr(xp3, dt_raw.len, &has_arr, &arr);
        if has_arr {
            out.has_disabled_tools = true;
            let ci: u64 = 0;
            while ci < arr.len && ci < 1024 {
                out.disabled_tools_json[ci] = arr.bytes[ci];
                ci = ci + 1;
            }
            out.disabled_tools_len = ci;
        };
    };
    return true;
}

// async function loadServers() -> Promise<ServerCfg[]>
// DEFECT: async — converted to a synchronous function returning a count via
// out (0 also covers every early return []); await readFile -> blocking read.
fn loadServers(out: &ServerCfgList) -> void {
    out.len = 0;
    if !mcpEnabled() { return; };
    // const home = (process.env.CODEX_HOME ?? "").trim();
    let home = TextBuf { bytes: [0u8; 32768], len: 0 };
    let has_home = env_get_buf(STR_PTR("CODEX_HOME"), STR_LEN("CODEX_HOME"), &home);
    let hlo: u64 = 0;
    let hhi: u64 = 0;
    if has_home {
        hhi = home.len;
        while hlo < hhi {
            if home.bytes[hlo] != 32 && home.bytes[hlo] != 9 { break; };
            hlo = hlo + 1;
        }
        while hhi > hlo {
            if home.bytes[hhi - 1] != 32 && home.bytes[hhi - 1] != 9 { break; };
            hhi = hhi - 1;
        }
    };
    // const path = join(home ? expandHome(home) : join(homedir(), ".codex"), "config.toml");
    // DEFECT: node:path join approximated by '/' concatenation.
    let dir = TextBuf { bytes: [0u8; 32768], len: 0 };
    if has_home && hhi > hlo {
        expandHome(item_ptr_at(&home.bytes, hlo), hhi - hlo, &dir);
    } else {
        sa_os_homedir(&dir.bytes, &dir.len);
        text_buf_append(&dir, STR_PTR("/.codex"), STR_LEN("/.codex"));
    };
    let path = TextBuf { bytes: [0u8; 32768], len: 0 };
    let dp: ptr = PTR_NULL();
    PTR_BYTE_ADD(dp, &dir.bytes, 0);
    text_buf_append(&path, dp, dir.len);
    text_buf_append(&path, STR_PTR("/config.toml"), STR_LEN("/config.toml"));
    // let text: string; try { text = await readFile(path, "utf8"); } catch { return []; }
    // DEFECT: try/catch has no SLA counterpart; the fs extern status code
    // plays the catch role.
    let text = TextBuf { bytes: [0u8; 32768], len: 0 };
    let pp: ptr = PTR_NULL();
    PTR_BYTE_ADD(pp, &path.bytes, 0);
    let rst = sa_std_fs_read_file(pp, path.len, &text.bytes, &text.len);
    if rst != 0 { return; };
    // const tables = parseSubset(text);
    let tables = TextBuf { bytes: [0u8; 32768], len: 0 };
    let tp3: ptr = PTR_NULL();
    PTR_BYTE_ADD(tp3, &text.bytes, 0);
    parseSubset(tp3, text.len, &tables);
    // for (const [name, raw] of Object.entries(tables)) { try { cfg = toCfg(...); if (cfg?.enabled) out.push(cfg); } catch {} }
    // DEFECT: per-server try/catch approximated by toCfg's bool result.
    let n = sa_json_object_len(&tables.bytes, tables.len);
    let i: u64 = 0;
    while i < n {
        if out.len >= 32 { break; };
        let name = TextBuf { bytes: [0u8; 32768], len: 0 };
        let raw = TextBuf { bytes: [0u8; 32768], len: 0 };
        sa_json_object_entry(&tables.bytes, tables.len, i, &name.bytes, &name.len, &raw.bytes, &raw.len);
        i = i + 1;
        let np: ptr = PTR_NULL();
        PTR_BYTE_ADD(np, &name.bytes, 0);
        let rp2: ptr = PTR_NULL();
        PTR_BYTE_ADD(rp2, &raw.bytes, 0);
        let cfg = ServerCfg { name: [0u8; 128], name_len: 0, has_command: false, command: [0u8; 512], command_len: 0, args_json: [0u8; 2048], args_json_len: 0, has_env: false, env_json: [0u8; 2048], env_json_len: 0, has_cwd: false, cwd: [0u8; 512], cwd_len: 0, has_url: false, url: [0u8; 512], url_len: 0, has_http_headers: false, http_headers_json: [0u8; 2048], http_headers_json_len: 0, has_bearer_token_env_var: false, bearer_token_env_var: [0u8; 128], bearer_token_env_var_len: 0, enabled: false, startup_timeout_ms: 0, tool_timeout_ms: 0, has_enabled_tools: false, enabled_tools_json: [0u8; 1024], enabled_tools_json_len: 0, has_disabled_tools: false, disabled_tools_json: [0u8; 1024], disabled_tools_json_len: 0 };
        let ok = toCfg(np, name.len, rp2, raw.len, &cfg);
        if ok && cfg.enabled {
            out.items[out.len] = cfg;
            out.len = out.len + 1;
        };
    }
}

// function withTimeout<T>(p: Promise<T>, ms: number, label: string) -> Promise<T>
// DEFECT: Promise.race + setTimeout/clearTimeout + .finally + generics have
// no SLA counterpart. There is no body to convert: every call site runs its
// operation synchronously and relies on the per-call timeout already carried
// by StdioConn_send / HttpConn_doRpc (the race's only observable effect).
fn withTimeout() -> void {
    return;
}

// fn resultToText(result: { content?: unknown; structuredContent?: unknown } | null) -> string
// result arrives as JSON text (has_result == false models null).
fn resultToText(has_result: bool, result_ptr: ptr, result_len: u64, out: &TextBuf) -> void {
    out.len = 0;
    // if (!result || typeof result !== "object") return "(empty MCP result)";
    if !has_result || !sa_json_is_object(result_ptr, result_len) {
        text_buf_append(out, STR_PTR("(empty MCP result)"), STR_LEN("(empty MCP result)"));
        return;
    };
    let parts = TextBuf { bytes: [0u8; 32768], len: 0 };
    // if (Array.isArray(result.content)) { for (const b of result.content) { ... } }
    // DEFECT: dynamic content-block traversal approximated via sa_json_*.
    let content = TextBuf { bytes: [0u8; 32768], len: 0 };
    let has_content = sa_json_object_get_json(result_ptr, result_len, STR_PTR("content"), STR_LEN("content"), &content.bytes, &content.len);
    if has_content && sa_json_is_array(&content.bytes, content.len) {
        let n = sa_json_array_len(&content.bytes, content.len);
        let i: u64 = 0;
        while i < n {
            let b = TextBuf { bytes: [0u8; 32768], len: 0 };
            sa_json_array_get_json(&content.bytes, content.len, i, &b.bytes, &b.len);
            i = i + 1;
            if !sa_json_is_object(&b.bytes, b.len) { continue; };
            // if (typeof rec.text === "string" && rec.text) parts.push(rec.text);
            // else if (typeof rec.data === "string") parts.push(rec.data);
            let tv = TextBuf { bytes: [0u8; 32768], len: 0 };
            let has_tv = sa_json_object_get_string(&b.bytes, b.len, STR_PTR("text"), STR_LEN("text"), &tv.bytes, &tv.len);
            let pushed = false;
            if has_tv && tv.len > 0 {
                if parts.len > 0 { text_buf_append(&parts, STR_PTR("\n"), STR_LEN("\n")); };
                let tvp: ptr = PTR_NULL();
                PTR_BYTE_ADD(tvp, &tv.bytes, 0);
                text_buf_append(&parts, tvp, tv.len);
                pushed = true;
            };
            if !pushed {
                let dv = TextBuf { bytes: [0u8; 32768], len: 0 };
                let has_dv = sa_json_object_get_string(&b.bytes, b.len, STR_PTR("data"), STR_LEN("data"), &dv.bytes, &dv.len);
                if has_dv {
                    if parts.len > 0 { text_buf_append(&parts, STR_PTR("\n"), STR_LEN("\n")); };
                    let dvp: ptr = PTR_NULL();
                    PTR_BYTE_ADD(dvp, &dv.bytes, 0);
                    text_buf_append(&parts, dvp, dv.len);
                };
            };
        }
    };
    // if (!parts.length && result.structuredContent !== undefined) {
    //   try { parts.push(JSON.stringify(result.structuredContent)); } catch { parts.push(String(...)); } }
    // DEFECT: JSON.stringify / try-catch approximated: the structuredContent
    // JSON text is already its stringified form.
    if parts.len == 0 {
        let sc = TextBuf { bytes: [0u8; 32768], len: 0 };
        let has_sc = sa_json_object_get_json(result_ptr, result_len, STR_PTR("structuredContent"), STR_LEN("structuredContent"), &sc.bytes, &sc.len);
        if has_sc {
            let scp: ptr = PTR_NULL();
            PTR_BYTE_ADD(scp, &sc.bytes, 0);
            text_buf_append(&parts, scp, sc.len);
        };
    };
    // return (parts.join("\n").trim() || "(empty MCP result)").slice(0, 8000);
    let lo: u64 = 0;
    let hi: u64 = parts.len;
    while lo < hi {
        if parts.bytes[lo] != 32 && parts.bytes[lo] != 9 && parts.bytes[lo] != 10 && parts.bytes[lo] != 13 { break; };
        lo = lo + 1;
    }
    while hi > lo {
        if parts.bytes[hi - 1] != 32 && parts.bytes[hi - 1] != 9 && parts.bytes[hi - 1] != 10 && parts.bytes[hi - 1] != 13 { break; };
        hi = hi - 1;
    }
    if lo >= hi {
        text_buf_append(out, STR_PTR("(empty MCP result)"), STR_LEN("(empty MCP result)"));
        return;
    };
    let take = hi - lo;
    if take > 8000 { take = 8000; };
    text_buf_append(out, item_ptr_at(&parts.bytes, lo), take);
}

// fn toMcpResponse(result) -> McpCallResult["response"]
// Writes the {content, structuredContent} JSON text into out.
// DEFECT: indexed-access return type (McpCallResult["response"]) and the
// dynamic result shape are carried as JSON text.
fn toMcpResponse(has_result: bool, result_ptr: ptr, result_len: u64, out: &TextBuf) -> void {
    out.len = 0;
    // if (!result || typeof result !== "object") return { content: [], structuredContent: null };
    if !has_result || !sa_json_is_object(result_ptr, result_len) {
        text_buf_append(out, STR_PTR("{\"content\":[],\"structuredContent\":null}"), STR_LEN("{\"content\":[],\"structuredContent\":null}"));
        return;
    };
    text_buf_append(out, STR_PTR("{\"content\":"), STR_LEN("{\"content\":"));
    // content: Array.isArray(result.content) ? result.content : []
    let content = TextBuf { bytes: [0u8; 32768], len: 0 };
    let has_content = sa_json_object_get_json(result_ptr, result_len, STR_PTR("content"), STR_LEN("content"), &content.bytes, &content.len);
    if has_content && sa_json_is_array(&content.bytes, content.len) {
        let cp: ptr = PTR_NULL();
        PTR_BYTE_ADD(cp, &content.bytes, 0);
        text_buf_append(out, cp, content.len);
    } else {
        text_buf_append(out, STR_PTR("[]"), STR_LEN("[]"));
    };
    text_buf_append(out, STR_PTR(",\"structuredContent\":"), STR_LEN(",\"structuredContent\":"));
    // structuredContent: result.structuredContent ?? null
    let sc = TextBuf { bytes: [0u8; 32768], len: 0 };
    let has_sc = sa_json_object_get_json(result_ptr, result_len, STR_PTR("structuredContent"), STR_LEN("structuredContent"), &sc.bytes, &sc.len);
    if has_sc {
        let scp: ptr = PTR_NULL();
        PTR_BYTE_ADD(scp, &sc.bytes, 0);
        text_buf_append(out, scp, sc.len);
    } else {
        text_buf_append(out, STR_PTR("null"), STR_LEN("null"));
    };
    text_buf_append(out, STR_PTR("}"), STR_LEN("}"));
}

// class StdioConn
// DEFECT: TS class with private fields has no SLA counterpart; converted to
// a struct plus a function family taking &StdioConn as first parameter.
// private proc: ChildProcess -> opaque handles from the spawn extern;
// private pending = new Map<number | string, { resolve, reject }> -> a JSON
// text id set (resolvers cannot be stored; see StdioConn_send DEFECT);
// private buffer / closed kept as fields.
struct StdioConn {
    cfg: ServerCfg,
    proc: u64, hin: u64, hout: u64,
    next_id: u64,
    pending_json: [u8; 4096], pending_len: u64,
    buffer: [u8; 32768], buffer_len: u64,
    closed: bool,
    // resolution slot written by StdioConn_onData for the blocking send pump
    last_id: u64, has_last: bool, last_is_error: bool,
    last_result_json: [u8; 32768], last_result_len: u64,
    fail_err: [u8; 512], fail_err_len: u64,
}

// constructor(private cfg: ServerCfg)
// DEFECT: constructor parameter properties + spawn options object
// ({ env, cwd, stdio: ["pipe","pipe","ignore"], windowsHide }) have no SLA
// counterpart; env is materialized as a JSON text map (process.env merged
// with cfg.env after expandVars) and passed to the spawn extern.
// DEFECT: ChildProcess event subscriptions (stdout.on("data"), .on("error"),
// .on("exit")) have no SLA counterpart; StdioConn_send pumps reads instead.
fn StdioConn_new(cfg: &ServerCfg, out: &StdioConn) -> i32 {
    out.cfg = cfg;
    out.next_id = 1;
    out.pending_len = 0;
    text_buf_append_len(&out.pending_json, &out.pending_len, STR_PTR("{}"), STR_LEN("{}"));
    out.buffer_len = 0;
    out.closed = false;
    out.has_last = false;
    out.last_is_error = false;
    out.last_result_len = 0;
    out.fail_err_len = 0;
    // const env: NodeJS.ProcessEnv = { ...process.env };
    // if (cfg.env) for (const [k, v] of Object.entries(cfg.env)) env[k] = expandVars(v);
    // DEFECT: process.env enumeration is not possible via sa_env_get; the
    // spawn extern is told to inherit the parent env, then cfg.env entries
    // (expandVars applied) are overlaid as JSON text.
    let env_json = TextBuf { bytes: [0u8; 32768], len: 0 };
    text_buf_append(&env_json, STR_PTR("{}"), STR_LEN("{}"));
    if cfg.has_env {
        let n = sa_json_object_len(&cfg.env_json, cfg.env_len);
        let i: u64 = 0;
        while i < n {
            let k = TextBuf { bytes: [0u8; 32768], len: 0 };
            let vj = TextBuf { bytes: [0u8; 32768], len: 0 };
            sa_json_object_entry(&cfg.env_json, cfg.env_len, i, &k.bytes, &k.len, &vj.bytes, &vj.len);
            i = i + 1;
            let v = TextBuf { bytes: [0u8; 32768], len: 0 };
            sa_json_parse_string(&vj.bytes, vj.len, &v.bytes, &v.len);
            let expanded = TextBuf { bytes: [0u8; 32768], len: 0 };
            let vp: ptr = PTR_NULL();
            PTR_BYTE_ADD(vp, &v.bytes, 0);
            expandVars(vp, v.len, &expanded);
            let kp: ptr = PTR_NULL();
            PTR_BYTE_ADD(kp, &k.bytes, 0);
            let xp: ptr = PTR_NULL();
            PTR_BYTE_ADD(xp, &expanded.bytes, 0);
            sa_json_object_set_string(&env_json.bytes, &env_json.len, kp, k.len, xp, expanded.len);
        }
    };
    // this.proc = spawn(expandVars(cfg.command ?? ""), (cfg.args ?? []).map(expandVars), {...});
    let cmd = TextBuf { bytes: [0u8; 32768], len: 0 };
    if cfg.has_command {
        let cp: ptr = PTR_NULL();
        PTR_BYTE_ADD(cp, &cfg.command, 0);
        expandVars(cp, cfg.command_len, &cmd);
    };
    // args: expandVars applied per element (map with an arrow closure in TS)
    let args_json = TextBuf { bytes: [0u8; 32768], len: 0 };
    text_buf_append(&args_json, STR_PTR("["), STR_LEN("["));
    let na = sa_json_array_len(&cfg.args_json, cfg.args_len);
    let ai: u64 = 0;
    let afirst = true;
    while ai < na {
        let a = TextBuf { bytes: [0u8; 32768], len: 0 };
        let ok = sa_json_array_get_string(&cfg.args_json, cfg.args_len, ai, &a.bytes, &a.len);
        ai = ai + 1;
        if !ok { continue; };
        let ex = TextBuf { bytes: [0u8; 32768], len: 0 };
        let ap: ptr = PTR_NULL();
        PTR_BYTE_ADD(ap, &a.bytes, 0);
        expandVars(ap, a.len, &ex);
        if !afirst { text_buf_append(&args_json, STR_PTR(","), STR_LEN(",")); };
        afirst = false;
        text_buf_append(&args_json, STR_PTR("\""), STR_LEN("\""));
        let xp2: ptr = PTR_NULL();
        PTR_BYTE_ADD(xp2, &ex.bytes, 0);
        text_buf_append(&args_json, xp2, ex.len);
        text_buf_append(&args_json, STR_PTR("\""), STR_LEN("\""));
    }
    text_buf_append(&args_json, STR_PTR("]"), STR_LEN("]"));
    // cwd: cfg.cwd ? expandHome(expandVars(cfg.cwd)) : undefined
    let cwd = TextBuf { bytes: [0u8; 32768], len: 0 };
    let has_cwd = false;
    if cfg.has_cwd {
        let ex = TextBuf { bytes: [0u8; 32768], len: 0 };
        let cp2: ptr = PTR_NULL();
        PTR_BYTE_ADD(cp2, &cfg.cwd, 0);
        expandVars(cp2, cfg.cwd_len, &ex);
        let xp3: ptr = PTR_NULL();
        PTR_BYTE_ADD(xp3, &ex.bytes, 0);
        expandHome(xp3, ex.len, &cwd);
        has_cwd = true;
    };
    let cmd_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(cmd_ptr, &cmd.bytes, 0);
    let cwd_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(cwd_ptr, &cwd.bytes, 0);
    // DEFECT: sa_std_process_spawn_bidi (named in the brief) covers the spawn
    // but not per-process env/cwd/stdin-stdout handle triples; placeholder
    // extern returning a status and three handles.
    let st = sa_std_process_spawn_cfg(cmd_ptr, cmd.len, &args_json.bytes, args_json.len, &env_json.bytes, env_json.len, has_cwd, cwd_ptr, cwd.len, &out.proc, &out.hin, &out.hout);
    return st;
}

// helper: append bytes to a (bytes, len) field pair
fn text_buf_append_len(arr: &[u8; 4096], len: &u64, src_ptr: ptr, src_len: u64) -> void {
    let i: u64 = 0;
    while i < src_len {
        if len >= 4096 { return; };
        let b: u8 = 0;
        PTR_BYTE_AT(b, src_ptr, i);
        arr[len] = b;
        len = len + 1;
        i = i + 1;
    }
}

// private onData(chunk: string): void
fn StdioConn_onData(conn: &StdioConn, g: &McpGlobals, chunk_ptr: ptr, chunk_len: u64) -> void {
    // this.buffer += chunk;
    let bi: u64 = 0;
    while bi < chunk_len && conn.buffer_len < 32768 {
        let b: u8 = 0;
        PTR_BYTE_AT(b, chunk_ptr, bi);
        conn.buffer[conn.buffer_len] = b;
        conn.buffer_len = conn.buffer_len + 1;
        bi = bi + 1;
    }
    // while ((idx = this.buffer.indexOf("\n")) >= 0) { ...one line... }
    let idx: i64 = 0;
    while true {
        idx = -1;
        let i: u64 = 0;
        while i < conn.buffer_len {
            if conn.buffer[i] == 10 { idx = i as i64; break; };
            i = i + 1;
        }
        if idx < 0 { break; };
        // const line = this.buffer.slice(0, idx).trim(); this.buffer = this.buffer.slice(idx + 1);
        let line = TextBuf { bytes: [0u8; 32768], len: 0 };
        let lo: u64 = 0;
        let hi: u64 = idx as u64;
        while lo < hi {
            if conn.buffer[lo] != 32 && conn.buffer[lo] != 9 && conn.buffer[lo] != 13 { break; };
            lo = lo + 1;
        }
        while hi > lo {
            if conn.buffer[hi - 1] != 32 && conn.buffer[hi - 1] != 9 && conn.buffer[hi - 1] != 13 { break; };
            hi = hi - 1;
        }
        let ci: u64 = lo;
        while ci < hi {
            text_buf_append_byte(&line, conn.buffer[ci]);
            ci = ci + 1;
        }
        // drop the consumed line + '\n' from the buffer
        let rest = (idx as u64) + 1;
        let w: u64 = 0;
        let r: u64 = rest;
        while r < conn.buffer_len {
            conn.buffer[w] = conn.buffer[r];
            w = w + 1;
            r = r + 1;
        }
        conn.buffer_len = w;
        if line.len == 0 { continue; };
        // let msg: Record<string, unknown>; try { msg = JSON.parse(line); } catch { continue; }
        // DEFECT: try/catch around JSON.parse approximated by the extern status.
        let lp: ptr = PTR_NULL();
        PTR_BYTE_ADD(lp, &line.bytes, 0);
        if !sa_json_is_object(lp, line.len) { continue; };
        // if (msg.id === undefined || msg.id === null) continue;
        let id_json = TextBuf { bytes: [0u8; 32768], len: 0 };
        let has_id = sa_json_object_get_json(lp, line.len, STR_PTR("id"), STR_LEN("id"), &id_json.bytes, &id_json.len);
        if !has_id { continue; };
        let idp: ptr = PTR_NULL();
        PTR_BYTE_ADD(idp, &id_json.bytes, 0);
        if str_eq(idp, id_json.len, STR_PTR("null"), STR_LEN("null")) { continue; };
        let id_num = sa_json_number_to_u64(idp, id_json.len);
        // if (typeof msg.method === "string") { ...server-initiated request... }
        let method = TextBuf { bytes: [0u8; 32768], len: 0 };
        let has_method = sa_json_object_get_string(lp, line.len, STR_PTR("method"), STR_LEN("method"), &method.bytes, &method.len);
        if has_method {
            // let payload: roots/list -> { result: { roots: workspaceRootEntries() } }
            //              ping       -> { result: {} }
            //              else       -> { error: { code: -32601, message: `Method not found: ${method.slice(0, 120)}` } }
            let resp = TextBuf { bytes: [0u8; 32768], len: 0 };
            text_buf_append(&resp, STR_PTR("{\"jsonrpc\":\"2.0\",\"id\":"), STR_LEN("{\"jsonrpc\":\"2.0\",\"id\":"));
            text_buf_append(&resp, idp, id_json.len);
            let mp: ptr = PTR_NULL();
            PTR_BYTE_ADD(mp, &method.bytes, 0);
            if str_eq(mp, method.len, STR_PTR("roots/list"), STR_LEN("roots/list")) {
                let roots = TextBuf { bytes: [0u8; 32768], len: 0 };
                workspaceRootEntries(g, &roots);
                text_buf_append(&resp, STR_PTR(",\"result\":{\"roots\":"), STR_LEN(",\"result\":{\"roots\":"));
                let rp: ptr = PTR_NULL();
                PTR_BYTE_ADD(rp, &roots.bytes, 0);
                text_buf_append(&resp, rp, roots.len);
                text_buf_append(&resp, STR_PTR("}}"), STR_LEN("}}"));
            } else if str_eq(mp, method.len, STR_PTR("ping"), STR_LEN("ping")) {
                text_buf_append(&resp, STR_PTR(",\"result\":{}}"), STR_LEN(",\"result\":{}}"));
            } else {
                text_buf_append(&resp, STR_PTR(",\"error\":{\"code\":-32601,\"message\":\"Method not found: "), STR_LEN(",\"error\":{\"code\":-32601,\"message\":\"Method not found: "));
                let take = method.len;
                if take > 120 { take = 120; };
                text_buf_append(&resp, mp, take);
                text_buf_append(&resp, STR_PTR("\"}}"), STR_LEN("\"}}"));
            };
            text_buf_append(&resp, STR_PTR("}"), STR_LEN("}"));
            text_buf_append(&resp, STR_PTR("\n"), STR_LEN("\n"));
            // try { this.proc.stdin?.write(`${JSON.stringify(...)}\n`); } catch { /* ignore */ }
            let rp2: ptr = PTR_NULL();
            PTR_BYTE_ADD(rp2, &resp.bytes, 0);
            let wst = sa_std_process_write(conn.hin, rp2, resp.len);
            // DEFECT: write failure is swallowed here exactly as in TS (the
            // exit/error handlers surface dead pipes); wst intentionally unused.
            if wst != 0 { };
            continue;
        };
        // const entry = this.pending.get(msg.id); if (!entry) continue;
        // this.pending.delete(msg.id);
        // DEFECT: pending membership is a JSON id set; deleting the id and
        // resolving/rejecting the stored closures is approximated by the
        // last_* slot consumed by StdioConn_send's pump.
        if !sa_json_object_has_id(&conn.pending_json, conn.pending_len, id_num) { continue; };
        sa_json_object_delete_id(&conn.pending_json, &conn.pending_len, id_num);
        conn.last_id = id_num;
        conn.has_last = true;
        // if (msg.error != null) entry.reject(new Error(String(err.message ?? "MCP error").slice(0, 500)));
        // else entry.resolve(msg.result ?? null);
        let err_json = TextBuf { bytes: [0u8; 32768], len: 0 };
        let has_err = sa_json_object_get_json(lp, line.len, STR_PTR("error"), STR_LEN("error"), &err_json.bytes, &err_json.len);
        let err_is_null = true;
        if has_err {
            let ep: ptr = PTR_NULL();
            PTR_BYTE_ADD(ep, &err_json.bytes, 0);
            err_is_null = str_eq(ep, err_json.len, STR_PTR("null"), STR_LEN("null"));
        };
        if has_err && !err_is_null {
            conn.last_is_error = true;
            conn.last_result_len = 0;
            let msg_text = TextBuf { bytes: [0u8; 32768], len: 0 };
            let has_msg = sa_json_object_get_string(&err_json.bytes, err_json.len, STR_PTR("message"), STR_LEN("message"), &msg_text.bytes, &msg_text.len);
            let src = TextBuf { bytes: [0u8; 32768], len: 0 };
            if has_msg {
                let sp: ptr = PTR_NULL();
                PTR_BYTE_ADD(sp, &msg_text.bytes, 0);
                text_buf_append(&src, sp, msg_text.len);
            } else {
                text_buf_append(&src, STR_PTR("MCP error"), STR_LEN("MCP error"));
            };
            let take = src.len;
            if take > 500 { take = 500; };
            let ci2: u64 = 0;
            while ci2 < take {
                conn.last_result_json[ci2] = src.bytes[ci2];
                ci2 = ci2 + 1;
            }
            conn.last_result_len = take;
        } else {
            conn.last_is_error = false;
            let res_json = TextBuf { bytes: [0u8; 32768], len: 0 };
            let has_res = sa_json_object_get_json(lp, line.len, STR_PTR("result"), STR_LEN("result"), &res_json.bytes, &res_json.len);
            conn.last_result_len = 0;
            if has_res {
                let ci3: u64 = 0;
                while ci3 < res_json.len && ci3 < 32768 {
                    conn.last_result_json[ci3] = res_json.bytes[ci3];
                    ci3 = ci3 + 1;
                }
                conn.last_result_len = ci3;
            } else {
                // msg.result ?? null
                conn.last_result_json[0] = 110;
                conn.last_result_json[1] = 117;
                conn.last_result_json[2] = 108;
                conn.last_result_json[3] = 108;
                conn.last_result_len = 4;
            };
        };
    }
}

// private failAll(e: Error): void
fn StdioConn_failAll(conn: &StdioConn, err_ptr: ptr, err_len: u64) -> void {
    // for (const [, entry] of this.pending) entry.reject(e); this.pending.clear();
    // DEFECT: rejecting stored Promise executors has no SLA counterpart; the
    // error is latched in fail_err and the blocking send pump observes it.
    conn.fail_err_len = 0;
    let take = err_len;
    if take > 512 { take = 512; };
    let i: u64 = 0;
    while i < take {
        let b: u8 = 0;
        PTR_BYTE_AT(b, err_ptr, i);
        conn.fail_err[i] = b;
        i = i + 1;
    }
    conn.fail_err_len = take;
    conn.pending_len = 0;
    text_buf_append_len(&conn.pending_json, &conn.pending_len, STR_PTR("{}"), STR_LEN("{}"));
}

// private send<T>(method: string, params: unknown, timeoutMs: number) -> Promise<T>
// Returns 0 on success (result JSON in out), nonzero on error (text in err).
// DEFECT: async/Promise + generic <T> + the Promise executor closure
// ((resolve, reject) => pending.set(...)) have no SLA counterpart; send is a
// synchronous blocking pump: write the request, read chunks into
// StdioConn_onData until the matching id resolves or the timeout expires.
// DEFECT: withTimeout's .finally(() => pending.delete(id)) is folded into
// every exit path below.
fn StdioConn_send(conn: &StdioConn, g: &McpGlobals, method_ptr: ptr, method_len: u64, params_ptr: ptr, params_len: u64, timeout_ms: u64, out: &TextBuf, err: &TextBuf) -> i32 {
    let id = conn.next_id;
    conn.next_id = conn.next_id + 1;
    // this.pending.set(id, { resolve, reject });
    sa_json_object_set_id(&conn.pending_json, &conn.pending_len, id);
    conn.has_last = false;
    // try { this.proc.stdin?.write(`${JSON.stringify({ jsonrpc: "2.0", id, method, params })}\n`); }
    // catch (e) { this.pending.delete(id); return Promise.reject(...); }
    let req = TextBuf { bytes: [0u8; 32768], len: 0 };
    text_buf_append(&req, STR_PTR("{\"jsonrpc\":\"2.0\",\"id\":"), STR_LEN("{\"jsonrpc\":\"2.0\",\"id\":"));
    let id_text = TextBuf { bytes: [0u8; 32768], len: 0 };
    sa_u64_to_dec(id, &id_text.bytes, &id_text.len);
    let ip: ptr = PTR_NULL();
    PTR_BYTE_ADD(ip, &id_text.bytes, 0);
    text_buf_append(&req, ip, id_text.len);
    text_buf_append(&req, STR_PTR(",\"method\":\""), STR_LEN(",\"method\":\""));
    text_buf_append(&req, method_ptr, method_len);
    text_buf_append(&req, STR_PTR("\",\"params\":"), STR_LEN("\",\"params\":"));
    text_buf_append(&req, params_ptr, params_len);
    text_buf_append(&req, STR_PTR("}"), STR_LEN("}"));
    text_buf_append(&req, STR_PTR("\n"), STR_LEN("\n"));
    let rp: ptr = PTR_NULL();
    PTR_BYTE_ADD(rp, &req.bytes, 0);
    let wst = sa_std_process_write(conn.hin, rp, req.len);
    if wst != 0 {
        sa_json_object_delete_id(&conn.pending_json, &conn.pending_len, id);
        err.len = 0;
        text_buf_append(err, STR_PTR("MCP stdin write failed"), STR_LEN("MCP stdin write failed"));
        return 1;
    };
    // return withTimeout(p, timeoutMs, `MCP '${this.cfg.name}' ${method}`)...
    // Blocking pump (approximation): read until onData resolves this id.
    // DEFECT: no Date.now in SLA form here; the read extern takes the
    // remaining timeout directly, decremented per chunk by elapsed reads.
    let remaining = timeout_ms;
    while true {
        if conn.fail_err_len > 0 {
            sa_json_object_delete_id(&conn.pending_json, &conn.pending_len, id);
            err.len = 0;
            let fp: ptr = PTR_NULL();
            PTR_BYTE_ADD(fp, &conn.fail_err, 0);
            text_buf_append(err, fp, conn.fail_err_len);
            return 2;
        };
        if conn.has_last && conn.last_id == id {
            sa_json_object_delete_id(&conn.pending_json, &conn.pending_len, id);
            if conn.last_is_error {
                err.len = 0;
                let lp2: ptr = PTR_NULL();
                PTR_BYTE_ADD(lp2, &conn.last_result_json, 0);
                text_buf_append(err, lp2, conn.last_result_len);
                return 3;
            };
            out.len = 0;
            let lp3: ptr = PTR_NULL();
            PTR_BYTE_ADD(lp3, &conn.last_result_json, 0);
            text_buf_append(out, lp3, conn.last_result_len);
            return 0;
        };
        if remaining == 0 {
            sa_json_object_delete_id(&conn.pending_json, &conn.pending_len, id);
            // `MCP '${name}' ${method} timed out after ${timeoutMs}ms`
            err.len = 0;
            text_buf_append(err, STR_PTR("MCP '"), STR_LEN("MCP '"));
            let np: ptr = PTR_NULL();
            PTR_BYTE_ADD(np, &conn.cfg.name, 0);
            text_buf_append(err, np, conn.cfg.name_len);
            text_buf_append(err, STR_PTR("' "), STR_LEN("' "));
            text_buf_append(err, method_ptr, method_len);
            text_buf_append(err, STR_PTR(" timed out after "), STR_LEN(" timed out after "));
            let tt = TextBuf { bytes: [0u8; 32768], len: 0 };
            sa_u64_to_dec(timeout_ms, &tt.bytes, &tt.len);
            let tp4: ptr = PTR_NULL();
            PTR_BYTE_ADD(tp4, &tt.bytes, 0);
            text_buf_append(err, tp4, tt.len);
            text_buf_append(err, STR_PTR("ms"), STR_LEN("ms"));
            return 4;
        };
        let chunk = TextBuf { bytes: [0u8; 32768], len: 0 };
        // DEFECT: placeholder read-with-timeout extern over the child stdout.
        let got = sa_std_process_read_timeout(conn.hout, &chunk.bytes, 32768, remaining, &chunk.len);
        if got < 0 {
            // process exited / error event: failAll(new Error(`MCP server '${cfg.name}' exited`))
            let em = TextBuf { bytes: [0u8; 32768], len: 0 };
            text_buf_append(&em, STR_PTR("MCP server '"), STR_LEN("MCP server '"));
            let np2: ptr = PTR_NULL();
            PTR_BYTE_ADD(np2, &conn.cfg.name, 0);
            text_buf_append(&em, np2, conn.cfg.name_len);
            text_buf_append(&em, STR_PTR("' exited"), STR_LEN("' exited"));
            let ep2: ptr = PTR_NULL();
            PTR_BYTE_ADD(ep2, &em.bytes, 0);
            StdioConn_failAll(conn, ep2, em.len);
            continue;
        };
        if got == 0 {
            // read timed out for this slice; treat remaining as consumed
            remaining = 0;
            continue;
        };
        remaining = 0;
        let cp3: ptr = PTR_NULL();
        PTR_BYTE_ADD(cp3, &chunk.bytes, 0);
        StdioConn_onData(conn, g, cp3, chunk.len);
    }
    return 0;
}

// async init(): Promise<void>   // DEFECT: async -> synchronous, status code
fn StdioConn_init(conn: &StdioConn, g: &McpGlobals, err: &TextBuf) -> i32 {
    let params = TextBuf { bytes: [0u8; 32768], len: 0 };
    text_buf_append(&params, STR_PTR("{\"protocolVersion\":\"2024-11-05\",\"capabilities\":{},\"clientInfo\":{\"name\":\"mini-codex\",\"version\":\"0.1.12\"}}"), STR_LEN("{\"protocolVersion\":\"2024-11-05\",\"capabilities\":{},\"clientInfo\":{\"name\":\"mini-codex\",\"version\":\"0.1.12\"}}"));
    let res = TextBuf { bytes: [0u8; 32768], len: 0 };
    let pp: ptr = PTR_NULL();
    PTR_BYTE_ADD(pp, &params.bytes, 0);
    let st = StdioConn_send(conn, g, STR_PTR("initialize"), STR_LEN("initialize"), pp, params.len, conn.cfg.startup_timeout_ms, &res, err);
    if st != 0 { return st; };
    // try { stdin.write(notifications/initialized) } catch { /* ignore */ }
    let note = TextBuf { bytes: [0u8; 32768], len: 0 };
    text_buf_append(&note, STR_PTR("{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\"}\n"), STR_LEN("{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\"}\n"));
    let np3: ptr = PTR_NULL();
    PTR_BYTE_ADD(np3, &note.bytes, 0);
    let wst = sa_std_process_write(conn.hin, np3, note.len);
    if wst != 0 { };
    return 0;
}

// async list(): Promise<RawTool[]>   // DEFECT: async -> synchronous
fn StdioConn_list(conn: &StdioConn, g: &McpGlobals, out: &RawToolList, err: &TextBuf) -> i32 {
    out.len = 0;
    let res = TextBuf { bytes: [0u8; 32768], len: 0 };
    let st = StdioConn_send(conn, g, STR_PTR("tools/list"), STR_LEN("tools/list"), STR_PTR("{}"), STR_LEN("{}"), conn.cfg.startup_timeout_ms, &res, err);
    if st != 0 { return st; };
    // return Array.isArray(r.tools) ? r.tools : [];
    let rp: ptr = PTR_NULL();
    PTR_BYTE_ADD(rp, &res.bytes, 0);
    sa_mcp_parse_raw_tools(rp, res.len, out);
    return 0;
}

// async listResources(): Promise<RawResource[]>   // DEFECT: async -> synchronous
fn StdioConn_listResources(conn: &StdioConn, g: &McpGlobals, out: &RawResourceList, err: &TextBuf) -> i32 {
    out.len = 0;
    let res = TextBuf { bytes: [0u8; 32768], len: 0 };
    let st = StdioConn_send(conn, g, STR_PTR("resources/list"), STR_LEN("resources/list"), STR_PTR("{}"), STR_LEN("{}"), conn.cfg.startup_timeout_ms, &res, err);
    if st != 0 { return st; };
    let rp: ptr = PTR_NULL();
    PTR_BYTE_ADD(rp, &res.bytes, 0);
    sa_mcp_parse_raw_resources(rp, res.len, out);
    return 0;
}

// async readResource(uri: string): Promise<McpResourceContent[]>   // DEFECT: async -> synchronous
fn StdioConn_readResource(conn: &StdioConn, g: &McpGlobals, uri_ptr: ptr, uri_len: u64, out: &McpResourceContentList, err: &TextBuf) -> i32 {
    out.len = 0;
    let params = TextBuf { bytes: [0u8; 32768], len: 0 };
    text_buf_append(&params, STR_PTR("{\"uri\":\""), STR_LEN("{\"uri\":\""));
    text_buf_append(&params, uri_ptr, uri_len);
    text_buf_append(&params, STR_PTR("\"}"), STR_LEN("\"}"));
    let res = TextBuf { bytes: [0u8; 32768], len: 0 };
    let pp: ptr = PTR_NULL();
    PTR_BYTE_ADD(pp, &params.bytes, 0);
    let st = StdioConn_send(conn, g, STR_PTR("resources/read"), STR_LEN("resources/read"), pp, params.len, conn.cfg.tool_timeout_ms, &res, err);
    if st != 0 { return st; };
    let rp: ptr = PTR_NULL();
    PTR_BYTE_ADD(rp, &res.bytes, 0);
    sa_mcp_parse_resource_contents(rp, res.len, out);
    return 0;
}

// async callDetailed(name, args, timeoutMs = this.cfg.toolTimeoutMs): Promise<McpCallResult>
// DEFECT: async -> synchronous; default parameter value kept (callers pass
// cfg.tool_timeout_ms explicitly where TS relied on the default).
fn StdioConn_callDetailed(conn: &StdioConn, g: &McpGlobals, name_ptr: ptr, name_len: u64, args_ptr: ptr, args_len: u64, timeout_ms: u64, out: &McpCallResult, err: &TextBuf) -> i32 {
    let params = TextBuf { bytes: [0u8; 32768], len: 0 };
    text_buf_append(&params, STR_PTR("{\"name\":\""), STR_LEN("{\"name\":\""));
    text_buf_append(&params, name_ptr, name_len);
    text_buf_append(&params, STR_PTR("\",\"arguments\":"), STR_LEN("\",\"arguments\":"));
    text_buf_append(&params, args_ptr, args_len);
    text_buf_append(&params, STR_PTR("}"), STR_LEN("}"));
    let res = TextBuf { bytes: [0u8; 32768], len: 0 };
    let pp: ptr = PTR_NULL();
    PTR_BYTE_ADD(pp, &params.bytes, 0);
    let st = StdioConn_send(conn, g, STR_PTR("tools/call"), STR_LEN("tools/call"), pp, params.len, timeout_ms, &res, err);
    if st != 0 { return st; };
    // return { text: resultToText(r), response: toMcpResponse(r) };
    let rp: ptr = PTR_NULL();
    PTR_BYTE_ADD(rp, &res.bytes, 0);
    let txt = TextBuf { bytes: [0u8; 32768], len: 0 };
    resultToText(true, rp, res.len, &txt);
    out.text_len = 0;
    let ti: u64 = 0;
    while ti < txt.len && ti < 8192 {
        out.text[ti] = txt.bytes[ti];
        ti = ti + 1;
    }
    out.text_len = ti;
    let resp = TextBuf { bytes: [0u8; 32768], len: 0 };
    toMcpResponse(true, rp, res.len, &resp);
    out.response_json_len = 0;
    let ri: u64 = 0;
    while ri < resp.len && ri < 16384 {
        out.response_json[ri] = resp.bytes[ri];
        ri = ri + 1;
    }
    out.response_json_len = ri;
    return 0;
}

// async call(name, args): Promise<string>   // DEFECT: async -> synchronous
fn StdioConn_call(conn: &StdioConn, g: &McpGlobals, name_ptr: ptr, name_len: u64, args_ptr: ptr, args_len: u64, out: &TextBuf, err: &TextBuf) -> i32 {
    let r = McpCallResult { text: [0u8; 8192], text_len: 0, response_json: [0u8; 16384], response_json_len: 0 };
    let st = StdioConn_callDetailed(conn, g, name_ptr, name_len, args_ptr, args_len, conn.cfg.tool_timeout_ms, &r, err);
    if st != 0 { return st; };
    out.len = 0;
    let tp5: ptr = PTR_NULL();
    PTR_BYTE_ADD(tp5, &r.text, 0);
    text_buf_append(out, tp5, r.text_len);
    return 0;
}

fn StdioConn_close(conn: &StdioConn) -> void {
    conn.closed = true;
    StdioConn_failAll(conn, STR_PTR("closed"), STR_LEN("closed"));
    // try { this.proc.kill(); } catch { /* ignore */ }
    // DEFECT: try/catch approximated by ignoring the kill extern status.
    let kst = sa_std_process_kill(conn.proc);
    if kst != 0 { };
    // void this.closed;  (field read kept for parity)
    if conn.closed { };
}

// class HttpConn
// DEFECT: class with private fields -> struct + &HttpConn function family
// (same conversion as StdioConn).
struct HttpConn {
    cfg: ServerCfg,
    has_session_id: bool, session_id: [u8; 256], session_id_len: u64,
    next_id: u64,
}

// constructor(private cfg: ServerCfg) {}
fn HttpConn_new(cfg: &ServerCfg, out: &HttpConn) -> void {
    out.cfg = cfg;
    out.has_session_id = false;
    out.session_id_len = 0;
    out.next_id = 1;
}

// private headers(): Record<string, string>  (result as JSON text)
fn HttpConn_headers(conn: &HttpConn, out: &TextBuf) -> void {
    out.len = 0;
    text_buf_append(out, STR_PTR("{\"Content-Type\":\"application/json\",\"Accept\":\"application/json, text/event-stream\""), STR_LEN("{\"Content-Type\":\"application/json\",\"Accept\":\"application/json, text/event-stream\""));
    // if (this.sessionId) h["Mcp-Session-Id"] = this.sessionId;
    if conn.has_session_id {
        text_buf_append(out, STR_PTR(",\"Mcp-Session-Id\":\""), STR_LEN(",\"Mcp-Session-Id\":\""));
        let sp: ptr = PTR_NULL();
        PTR_BYTE_ADD(sp, &conn.session_id, 0);
        text_buf_append(out, sp, conn.session_id_len);
        text_buf_append(out, STR_PTR("\""), STR_LEN("\""));
    };
    // const envName = this.cfg.bearerTokenEnvVar?.trim();
    // const token = envName ? process.env[envName] : undefined;
    // if (token && !h.Authorization) h.Authorization = `Bearer ${token}`;
    if conn.cfg.has_bearer_token_env_var {
        let lo: u64 = 0;
        let hi: u64 = conn.cfg.bearer_token_env_var_len;
        while lo < hi {
            if conn.cfg.bearer_token_env_var[lo] != 32 && conn.cfg.bearer_token_env_var[lo] != 9 { break; };
            lo = lo + 1;
        }
        while hi > lo {
            if conn.cfg.bearer_token_env_var[hi - 1] != 32 && conn.cfg.bearer_token_env_var[hi - 1] != 9 { break; };
            hi = hi - 1;
        }
        if hi > lo {
            let tok = TextBuf { bytes: [0u8; 32768], len: 0 };
            let has_tok = env_get_buf(item_ptr_at(&conn.cfg.bearer_token_env_var, lo), hi - lo, &tok);
            if has_tok && tok.len > 0 {
                text_buf_append(out, STR_PTR(",\"Authorization\":\"Bearer "), STR_LEN(",\"Authorization\":\"Bearer "));
                let tp: ptr = PTR_NULL();
                PTR_BYTE_ADD(tp, &tok.bytes, 0);
                text_buf_append(out, tp, tok.len);
                text_buf_append(out, STR_PTR("\""), STR_LEN("\""));
            };
        };
    };
    // if (this.cfg.httpHeaders) for (const [k, v] of Object.entries(...)) h[k] = expandVars(v);
    if conn.cfg.has_http_headers {
        let n = sa_json_object_len(&conn.cfg.http_headers_json, conn.cfg.http_headers_len);
        let i: u64 = 0;
        while i < n {
            let k = TextBuf { bytes: [0u8; 32768], len: 0 };
            let vj = TextBuf { bytes: [0u8; 32768], len: 0 };
            sa_json_object_entry(&conn.cfg.http_headers_json, conn.cfg.http_headers_len, i, &k.bytes, &k.len, &vj.bytes, &vj.len);
            i = i + 1;
            let v = TextBuf { bytes: [0u8; 32768], len: 0 };
            sa_json_parse_string(&vj.bytes, vj.len, &v.bytes, &v.len);
            let ex = TextBuf { bytes: [0u8; 32768], len: 0 };
            let vp: ptr = PTR_NULL();
            PTR_BYTE_ADD(vp, &v.bytes, 0);
            expandVars(vp, v.len, &ex);
            let kp: ptr = PTR_NULL();
            PTR_BYTE_ADD(kp, &k.bytes, 0);
            let xp: ptr = PTR_NULL();
            PTR_BYTE_ADD(xp, &ex.bytes, 0);
            sa_json_object_set_string(out, kp, k.len, xp, ex.len);
        }
    };
    text_buf_append(out, STR_PTR("}"), STR_LEN("}"));
}

// private async doRpc<T>(method, params, timeoutMs): Promise<T>
// Returns 0 + result JSON in out; nonzero + message in err.
// DEFECT: fetch / AbortController / setTimeout abort / Response headers and
// .text() have no sa_std counterpart (the sa_std HTTP client is an SSE turn
// API, not a general JSON POST); a single placeholder extern performs the
// POST with a timeout. try/catch/finally collapses to its status code, and
// the AbortError rename is folded into the extern's timeout status.
fn HttpConn_doRpc(conn: &HttpConn, method_ptr: ptr, method_len: u64, params_ptr: ptr, params_len: u64, timeout_ms: u64, out: &TextBuf, err: &TextBuf) -> i32 {
    let id = conn.next_id;
    conn.next_id = conn.next_id + 1;
    // body: JSON.stringify({ jsonrpc: "2.0", id: this.nextId++, method, params })
    let body = TextBuf { bytes: [0u8; 32768], len: 0 };
    text_buf_append(&body, STR_PTR("{\"jsonrpc\":\"2.0\",\"id\":"), STR_LEN("{\"jsonrpc\":\"2.0\",\"id\":"));
    let id_text = TextBuf { bytes: [0u8; 32768], len: 0 };
    sa_u64_to_dec(id, &id_text.bytes, &id_text.len);
    let ip: ptr = PTR_NULL();
    PTR_BYTE_ADD(ip, &id_text.bytes, 0);
    text_buf_append(&body, ip, id_text.len);
    text_buf_append(&body, STR_PTR(",\"method\":\""), STR_LEN(",\"method\":\""));
    text_buf_append(&body, method_ptr, method_len);
    text_buf_append(&body, STR_PTR("\",\"params\":"), STR_LEN("\",\"params\":"));
    text_buf_append(&body, params_ptr, params_len);
    text_buf_append(&body, STR_PTR("}"), STR_LEN("}"));
    let headers = TextBuf { bytes: [0u8; 32768], len: 0 };
    HttpConn_headers(conn, &headers);
    let url_ptr: ptr = PTR_NULL();
    let url_len: u64 = 0;
    if conn.cfg.has_url {
        PTR_BYTE_ADD(url_ptr, &conn.cfg.url, 0);
        url_len = conn.cfg.url_len;
    };
    let status: u64 = 0;
    let resp_headers = TextBuf { bytes: [0u8; 32768], len: 0 };
    let resp_text = TextBuf { bytes: [0u8; 32768], len: 0 };
    let bp: ptr = PTR_NULL();
    PTR_BYTE_ADD(bp, &body.bytes, 0);
    let fst = sa_http_post_json(url_ptr, url_len, &headers.bytes, headers.len, bp, body.len, timeout_ms, &status, &resp_headers.bytes, &resp_headers.len, &resp_text.bytes, &resp_text.len);
    if fst == 2 {
        // catch: e.name === "AbortError" -> `MCP '${name}' ${method} timed out after ${timeoutMs}ms`
        err.len = 0;
        text_buf_append(err, STR_PTR("MCP '"), STR_LEN("MCP '"));
        let np: ptr = PTR_NULL();
        PTR_BYTE_ADD(np, &conn.cfg.name, 0);
        text_buf_append(err, np, conn.cfg.name_len);
        text_buf_append(err, STR_PTR("' "), STR_LEN("' "));
        text_buf_append(err, method_ptr, method_len);
        text_buf_append(err, STR_PTR(" timed out after "), STR_LEN(" timed out after "));
        let tt = TextBuf { bytes: [0u8; 32768], len: 0 };
        sa_u64_to_dec(timeout_ms, &tt.bytes, &tt.len);
        let tp: ptr = PTR_NULL();
        PTR_BYTE_ADD(tp, &tt.bytes, 0);
        text_buf_append(err, tp, tt.len);
        text_buf_append(err, STR_PTR("ms"), STR_LEN("ms"));
        return 1;
    };
    if fst != 0 {
        err.len = 0;
        text_buf_append(err, STR_PTR("MCP HTTP transport error"), STR_LEN("MCP HTTP transport error"));
        return 1;
    };
    // const session = res.headers.get("mcp-session-id"); if (session) this.sessionId = session;
    let sess = TextBuf { bytes: [0u8; 32768], len: 0 };
    let has_sess = sa_http_header_get(&resp_headers.bytes, resp_headers.len, STR_PTR("mcp-session-id"), STR_LEN("mcp-session-id"), &sess.bytes, &sess.len);
    if has_sess {
        conn.has_session_id = true;
        conn.session_id_len = 0;
        let si: u64 = 0;
        while si < sess.len && si < 256 {
            conn.session_id[si] = sess.bytes[si];
            si = si + 1;
        }
        conn.session_id_len = si;
    };
    // const text = await res.text();
    let tp2: ptr = PTR_NULL();
    PTR_BYTE_ADD(tp2, &resp_text.bytes, 0);
    // if (res.status === 401 || res.status === 403) throw new Error(`HTTP ${status}: MCP server '${name}' needs OAuth login — run \`codex mcp login ${name}\` (or set bearer_token_env_var/http_headers in config.toml), then retry.`);
    if status == 401 || status == 403 {
        err.len = 0;
        text_buf_append(err, STR_PTR("HTTP "), STR_LEN("HTTP "));
        let st_text = TextBuf { bytes: [0u8; 32768], len: 0 };
        sa_u64_to_dec(status, &st_text.bytes, &st_text.len);
        let stp: ptr = PTR_NULL();
        PTR_BYTE_ADD(stp, &st_text.bytes, 0);
        text_buf_append(err, stp, st_text.len);
        text_buf_append(err, STR_PTR(": MCP server '"), STR_LEN(": MCP server '"));
        let np2: ptr = PTR_NULL();
        PTR_BYTE_ADD(np2, &conn.cfg.name, 0);
        text_buf_append(err, np2, conn.cfg.name_len);
        text_buf_append(err, STR_PTR("' needs OAuth login — run `codex mcp login "), STR_LEN("' needs OAuth login — run `codex mcp login "));
        text_buf_append(err, np2, conn.cfg.name_len);
        text_buf_append(err, STR_PTR("` (or set bearer_token_env_var/http_headers in config.toml), then retry."), STR_LEN("` (or set bearer_token_env_var/http_headers in config.toml), then retry."));
        return 2;
    };
    // if (!res.ok) throw new Error(`HTTP ${res.status}: ${text.slice(0, 300)}`);
    if status < 200 || status >= 300 {
        err.len = 0;
        text_buf_append(err, STR_PTR("HTTP "), STR_LEN("HTTP "));
        let st_text = TextBuf { bytes: [0u8; 32768], len: 0 };
        sa_u64_to_dec(status, &st_text.bytes, &st_text.len);
        let stp: ptr = PTR_NULL();
        PTR_BYTE_ADD(stp, &st_text.bytes, 0);
        text_buf_append(err, stp, st_text.len);
        text_buf_append(err, STR_PTR(": "), STR_LEN(": "));
        let take = resp_text.len;
        if take > 300 { take = 300; };
        text_buf_append(err, tp2, take);
        return 3;
    };
    // let parsed: Record<string, unknown> | null = null;
    // if (text.includes("data:")) { scan SSE lines for the last JSON payload }
    // else { try { parsed = JSON.parse(text); } catch { parsed = null; } }
    let parsed = TextBuf { bytes: [0u8; 32768], len: 0 };
    let has_parsed = false;
    if contains_sub(tp2, resp_text.len, STR_PTR("data:"), STR_LEN("data:")) {
        // for (const line of text.split(/\r?\n/)) { ... data: payloads ... }
        // DEFECT: regex split /\r?\n/ approximated by '\n' scan with '\r' trim.
        let line_start: u64 = 0;
        let pos: u64 = 0;
        while pos <= resp_text.len {
            let at_end = pos == resp_text.len;
            let is_nl = false;
            if !at_end { is_nl = resp_text.bytes[pos] == 10; };
            if at_end || is_nl {
                let raw_ptr: ptr = PTR_NULL();
                PTR_BYTE_ADD(raw_ptr, tp2, line_start);
                let raw_len = pos - line_start;
                // const t = line.trim();
                let lo: u64 = 0;
                let hi: u64 = raw_len;
                while lo < hi {
                    let c: u8 = 0;
                    PTR_BYTE_AT(c, raw_ptr, lo);
                    if c != 32 && c != 9 && c != 13 { break; };
                    lo = lo + 1;
                }
                while hi > lo {
                    let c: u8 = 0;
                    PTR_BYTE_AT(c, raw_ptr, hi - 1);
                    if c != 32 && c != 9 && c != 13 { break; };
                    hi = hi - 1;
                }
                // if (!t.startsWith("data:")) continue;
                if hi - lo >= 5 && starts_with(item_ptr_at(&resp_text.bytes, line_start + lo), hi - lo, STR_PTR("data:"), STR_LEN("data:")) {
                    // const payload = t.slice(5).trim(); if (!payload || payload === "[DONE]") continue;
                    let plo: u64 = lo + 5;
                    while plo < hi {
                        let c: u8 = 0;
                        PTR_BYTE_AT(c, raw_ptr, plo);
                        if c != 32 && c != 9 && c != 13 { break; };
                        plo = plo + 1;
                    }
                    if plo < hi {
                        let pay_ptr: ptr = PTR_NULL();
                        PTR_BYTE_ADD(pay_ptr, raw_ptr, plo);
                        let pay_len = hi - plo;
                        if !str_eq(pay_ptr, pay_len, STR_PTR("[DONE]"), STR_LEN("[DONE]")) {
                            // try { parsed = JSON.parse(payload); } catch { /* keep scanning */ }
                            if sa_json_is_object(pay_ptr, pay_len) {
                                parsed.len = 0;
                                text_buf_append(&parsed, pay_ptr, pay_len);
                                has_parsed = true;
                            };
                        };
                    };
                };
                pos = pos + 1;
                line_start = pos;
                continue;
            };
            pos = pos + 1;
        }
    } else {
        if sa_json_is_object(tp2, resp_text.len) {
            parsed.len = 0;
            text_buf_append(&parsed, tp2, resp_text.len);
            has_parsed = true;
        };
    };
    // if (!parsed) throw new Error("empty MCP HTTP response");
    if !has_parsed {
        err.len = 0;
        text_buf_append(err, STR_PTR("empty MCP HTTP response"), STR_LEN("empty MCP HTTP response"));
        return 4;
    };
    // if (parsed.error != null) throw new Error(String(err.message ?? "MCP error").slice(0, 500));
    let perr = TextBuf { bytes: [0u8; 32768], len: 0 };
    let pp2: ptr = PTR_NULL();
    PTR_BYTE_ADD(pp2, &parsed.bytes, 0);
    let has_perr = sa_json_object_get_json(pp2, parsed.len, STR_PTR("error"), STR_LEN("error"), &perr.bytes, &perr.len);
    if has_perr {
        let ep: ptr = PTR_NULL();
        PTR_BYTE_ADD(ep, &perr.bytes, 0);
        if !str_eq(ep, perr.len, STR_PTR("null"), STR_LEN("null")) {
            let msg = TextBuf { bytes: [0u8; 32768], len: 0 };
            let has_msg = sa_json_object_get_string(ep, perr.len, STR_PTR("message"), STR_LEN("message"), &msg.bytes, &msg.len);
            err.len = 0;
            if has_msg {
                let mp: ptr = PTR_NULL();
                PTR_BYTE_ADD(mp, &msg.bytes, 0);
                let take = msg.len;
                if take > 500 { take = 500; };
                text_buf_append(err, mp, take);
            } else {
                text_buf_append(err, STR_PTR("MCP error"), STR_LEN("MCP error"));
            };
            return 5;
        };
    };
    // return (parsed.result ?? null) as T;
    out.len = 0;
    let res_json = TextBuf { bytes: [0u8; 32768], len: 0 };
    let has_res = sa_json_object_get_json(pp2, parsed.len, STR_PTR("result"), STR_LEN("result"), &res_json.bytes, &res_json.len);
    if has_res {
        let rp3: ptr = PTR_NULL();
        PTR_BYTE_ADD(rp3, &res_json.bytes, 0);
        text_buf_append(out, rp3, res_json.len);
    } else {
        text_buf_append(out, STR_PTR("null"), STR_LEN("null"));
    };
    return 0;
}

// private async rpc<T>(method, params, timeoutMs): Promise<T>
// DEFECT: async -> synchronous. Expired-session retry is kept 1:1.
fn HttpConn_rpc(conn: &HttpConn, method_ptr: ptr, method_len: u64, params_ptr: ptr, params_len: u64, timeout_ms: u64, out: &TextBuf, err: &TextBuf) -> i32 {
    // try { return await this.doRpc<T>(method, params, timeoutMs); }
    let st = HttpConn_doRpc(conn, method_ptr, method_len, params_ptr, params_len, timeout_ms, out, err);
    if st == 0 { return 0; };
    // catch (e) { if (this.sessionId && e instanceof Error && /HTTP 404/.test(e.message)) { ...retry once... } throw e; }
    // DEFECT: regex /HTTP 404/ approximated by substring search; instanceof
    // Error is vacuous here because err is always an error text.
    let ep: ptr = PTR_NULL();
    PTR_BYTE_ADD(ep, &err.bytes, 0);
    if conn.has_session_id && contains_sub(ep, err.len, STR_PTR("HTTP 404"), STR_LEN("HTTP 404")) {
        conn.has_session_id = false;
        conn.session_id_len = 0;
        // await this.doRpc("initialize", {...}, this.cfg.startupTimeoutMs);
        let init_params = TextBuf { bytes: [0u8; 32768], len: 0 };
        text_buf_append(&init_params, STR_PTR("{\"protocolVersion\":\"2024-11-05\",\"capabilities\":{},\"clientInfo\":{\"name\":\"mini-codex\",\"version\":\"0.1.12\"}}"), STR_LEN("{\"protocolVersion\":\"2024-11-05\",\"capabilities\":{},\"clientInfo\":{\"name\":\"mini-codex\",\"version\":\"0.1.12\"}}"));
        let sink = TextBuf { bytes: [0u8; 32768], len: 0 };
        let ip2: ptr = PTR_NULL();
        PTR_BYTE_ADD(ip2, &init_params.bytes, 0);
        let ist = HttpConn_doRpc(conn, STR_PTR("initialize"), STR_LEN("initialize"), ip2, init_params.len, conn.cfg.startup_timeout_ms, &sink, err);
        if ist != 0 { return ist; };
        // return this.doRpc<T>(method, params, timeoutMs);
        return HttpConn_doRpc(conn, method_ptr, method_len, params_ptr, params_len, timeout_ms, out, err);
    };
    return st;
}

// async init(): Promise<void>   // DEFECT: async -> synchronous
fn HttpConn_init(conn: &HttpConn, err: &TextBuf) -> i32 {
    let params = TextBuf { bytes: [0u8; 32768], len: 0 };
    text_buf_append(&params, STR_PTR("{\"protocolVersion\":\"2024-11-05\",\"capabilities\":{},\"clientInfo\":{\"name\":\"mini-codex\",\"version\":\"0.1.12\"}}"), STR_LEN("{\"protocolVersion\":\"2024-11-05\",\"capabilities\":{},\"clientInfo\":{\"name\":\"mini-codex\",\"version\":\"0.1.12\"}}"));
    let res = TextBuf { bytes: [0u8; 32768], len: 0 };
    let pp: ptr = PTR_NULL();
    PTR_BYTE_ADD(pp, &params.bytes, 0);
    let st = HttpConn_rpc(conn, STR_PTR("initialize"), STR_LEN("initialize"), pp, params.len, conn.cfg.startup_timeout_ms, &res, err);
    if st != 0 { return st; };
    // Spec-mandated initialized notification; best-effort (202/404 both fine).
    // try { await fetch(url, { method: "POST", headers, body: notification, signal }) } catch { /* non-fatal */ }
    // DEFECT: the notification POST reuses the fetch placeholder extern and
    // every outcome is ignored, as in TS; its timeout is
    // Math.min(5_000, cfg.startupTimeoutMs).
    let note = TextBuf { bytes: [0u8; 32768], len: 0 };
    text_buf_append(&note, STR_PTR("{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\"}"), STR_LEN("{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\"}"));
    let headers = TextBuf { bytes: [0u8; 32768], len: 0 };
    HttpConn_headers(conn, &headers);
    let url_ptr: ptr = PTR_NULL();
    let url_len: u64 = 0;
    if conn.cfg.has_url {
        PTR_BYTE_ADD(url_ptr, &conn.cfg.url, 0);
        url_len = conn.cfg.url_len;
    };
    let ntimeout = conn.cfg.startup_timeout_ms;
    if ntimeout > 5000 { ntimeout = 5000; };
    let nstatus: u64 = 0;
    let nresp_h = TextBuf { bytes: [0u8; 32768], len: 0 };
    let nresp_t = TextBuf { bytes: [0u8; 32768], len: 0 };
    let np4: ptr = PTR_NULL();
    PTR_BYTE_ADD(np4, &note.bytes, 0);
    let nst = sa_http_post_json(url_ptr, url_len, &headers.bytes, headers.len, np4, note.len, ntimeout, &nstatus, &nresp_h.bytes, &nresp_h.len, &nresp_t.bytes, &nresp_t.len);
    if nst != 0 { };
    return 0;
}

// async list(): Promise<RawTool[]>   // DEFECT: async -> synchronous
fn HttpConn_list(conn: &HttpConn, out: &RawToolList, err: &TextBuf) -> i32 {
    out.len = 0;
    let res = TextBuf { bytes: [0u8; 32768], len: 0 };
    let st = HttpConn_rpc(conn, STR_PTR("tools/list"), STR_LEN("tools/list"), STR_PTR("{}"), STR_LEN("{}"), conn.cfg.startup_timeout_ms, &res, err);
    if st != 0 { return st; };
    let rp: ptr = PTR_NULL();
    PTR_BYTE_ADD(rp, &res.bytes, 0);
    sa_mcp_parse_raw_tools(rp, res.len, out);
    return 0;
}

// async listResources(): Promise<RawResource[]>   // DEFECT: async -> synchronous
fn HttpConn_listResources(conn: &HttpConn, out: &RawResourceList, err: &TextBuf) -> i32 {
    out.len = 0;
    let res = TextBuf { bytes: [0u8; 32768], len: 0 };
    let st = HttpConn_rpc(conn, STR_PTR("resources/list"), STR_LEN("resources/list"), STR_PTR("{}"), STR_LEN("{}"), conn.cfg.startup_timeout_ms, &res, err);
    if st != 0 { return st; };
    let rp: ptr = PTR_NULL();
    PTR_BYTE_ADD(rp, &res.bytes, 0);
    sa_mcp_parse_raw_resources(rp, res.len, out);
    return 0;
}

// async readResource(uri: string): Promise<McpResourceContent[]>   // DEFECT: async -> synchronous
fn HttpConn_readResource(conn: &HttpConn, uri_ptr: ptr, uri_len: u64, out: &McpResourceContentList, err: &TextBuf) -> i32 {
    out.len = 0;
    let params = TextBuf { bytes: [0u8; 32768], len: 0 };
    text_buf_append(&params, STR_PTR("{\"uri\":\""), STR_LEN("{\"uri\":\""));
    text_buf_append(&params, uri_ptr, uri_len);
    text_buf_append(&params, STR_PTR("\"}"), STR_LEN("\"}"));
    let res = TextBuf { bytes: [0u8; 32768], len: 0 };
    let pp: ptr = PTR_NULL();
    PTR_BYTE_ADD(pp, &params.bytes, 0);
    let st = HttpConn_rpc(conn, STR_PTR("resources/read"), STR_LEN("resources/read"), pp, params.len, conn.cfg.tool_timeout_ms, &res, err);
    if st != 0 { return st; };
    let rp: ptr = PTR_NULL();
    PTR_BYTE_ADD(rp, &res.bytes, 0);
    sa_mcp_parse_resource_contents(rp, res.len, out);
    return 0;
}

// async callDetailed(name, args, timeoutMs = this.cfg.toolTimeoutMs): Promise<McpCallResult>
// DEFECT: async -> synchronous (see StdioConn_callDetailed note).
fn HttpConn_callDetailed(conn: &HttpConn, name_ptr: ptr, name_len: u64, args_ptr: ptr, args_len: u64, timeout_ms: u64, out: &McpCallResult, err: &TextBuf) -> i32 {
    let params = TextBuf { bytes: [0u8; 32768], len: 0 };
    text_buf_append(&params, STR_PTR("{\"name\":\""), STR_LEN("{\"name\":\""));
    text_buf_append(&params, name_ptr, name_len);
    text_buf_append(&params, STR_PTR("\",\"arguments\":"), STR_LEN("\",\"arguments\":"));
    text_buf_append(&params, args_ptr, args_len);
    text_buf_append(&params, STR_PTR("}"), STR_LEN("}"));
    let res = TextBuf { bytes: [0u8; 32768], len: 0 };
    let pp: ptr = PTR_NULL();
    PTR_BYTE_ADD(pp, &params.bytes, 0);
    let st = HttpConn_rpc(conn, STR_PTR("tools/call"), STR_LEN("tools/call"), pp, params.len, timeout_ms, &res, err);
    if st != 0 { return st; };
    let rp: ptr = PTR_NULL();
    PTR_BYTE_ADD(rp, &res.bytes, 0);
    let txt = TextBuf { bytes: [0u8; 32768], len: 0 };
    resultToText(true, rp, res.len, &txt);
    out.text_len = 0;
    let ti: u64 = 0;
    while ti < txt.len && ti < 8192 {
        out.text[ti] = txt.bytes[ti];
        ti = ti + 1;
    }
    out.text_len = ti;
    let resp = TextBuf { bytes: [0u8; 32768], len: 0 };
    toMcpResponse(true, rp, res.len, &resp);
    out.response_json_len = 0;
    let ri: u64 = 0;
    while ri < resp.len && ri < 16384 {
        out.response_json[ri] = resp.bytes[ri];
        ri = ri + 1;
    }
    out.response_json_len = ri;
    return 0;
}

// async call(name, args): Promise<string>   // DEFECT: async -> synchronous
fn HttpConn_call(conn: &HttpConn, name_ptr: ptr, name_len: u64, args_ptr: ptr, args_len: u64, out: &TextBuf, err: &TextBuf) -> i32 {
    let r = McpCallResult { text: [0u8; 8192], text_len: 0, response_json: [0u8; 16384], response_json_len: 0 };
    let st = HttpConn_callDetailed(conn, name_ptr, name_len, args_ptr, args_len, conn.cfg.tool_timeout_ms, &r, err);
    if st != 0 { return st; };
    out.len = 0;
    let tp: ptr = PTR_NULL();
    PTR_BYTE_ADD(tp, &r.text, 0);
    text_buf_append(out, tp, r.text_len);
    return 0;
}

fn HttpConn_close(conn: &HttpConn) -> void {
    conn.has_session_id = false;
    conn.session_id_len = 0;
}

// ---- connection dispatch ----
// DEFECT: the union type StdioConn | HttpConn has no SLA counterpart; every
// union call site dispatches on kind (0 = stdio, 1 = http) + index into the
// McpGlobals tables.
fn Conn_init(g: &McpGlobals, kind: u64, idx: u64, err: &TextBuf) -> i32 {
    if kind == 1 {
        return HttpConn_init(&g.http_conns[idx], err);
    };
    return StdioConn_init(&g.stdio_conns[idx], g, err);
}

fn Conn_list(g: &McpGlobals, kind: u64, idx: u64, out: &RawToolList, err: &TextBuf) -> i32 {
    if kind == 1 {
        return HttpConn_list(&g.http_conns[idx], out, err);
    };
    return StdioConn_list(&g.stdio_conns[idx], g, out, err);
}

fn Conn_listResources(g: &McpGlobals, kind: u64, idx: u64, out: &RawResourceList, err: &TextBuf) -> i32 {
    if kind == 1 {
        return HttpConn_listResources(&g.http_conns[idx], out, err);
    };
    return StdioConn_listResources(&g.stdio_conns[idx], g, out, err);
}

fn Conn_readResource(g: &McpGlobals, kind: u64, idx: u64, uri_ptr: ptr, uri_len: u64, out: &McpResourceContentList, err: &TextBuf) -> i32 {
    if kind == 1 {
        return HttpConn_readResource(&g.http_conns[idx], uri_ptr, uri_len, out, err);
    };
    return StdioConn_readResource(&g.stdio_conns[idx], g, uri_ptr, uri_len, out, err);
}

fn Conn_callDetailed(g: &McpGlobals, kind: u64, idx: u64, name_ptr: ptr, name_len: u64, args_ptr: ptr, args_len: u64, timeout_ms: u64, out: &McpCallResult, err: &TextBuf) -> i32 {
    if kind == 1 {
        return HttpConn_callDetailed(&g.http_conns[idx], name_ptr, name_len, args_ptr, args_len, timeout_ms, out, err);
    };
    return StdioConn_callDetailed(&g.stdio_conns[idx], g, name_ptr, name_len, args_ptr, args_len, timeout_ms, out, err);
}

fn Conn_close(g: &McpGlobals, kind: u64, idx: u64) -> void {
    if kind == 1 {
        HttpConn_close(&g.http_conns[idx]);
        return;
    };
    StdioConn_close(&g.stdio_conns[idx]);
}

// route lookup: route_json maps qualified name -> {"kind":k,"conn":i,"raw":"..."}
// DEFECT: Map<string, {conn, raw}> get has no counterpart; JSON table probe.
fn route_get(g: &McpGlobals, name_ptr: ptr, name_len: u64, kind: &u64, idx: &u64, raw: &TextBuf) -> bool {
    let entry = TextBuf { bytes: [0u8; 32768], len: 0 };
    let ok = sa_json_object_get_json_strkey(&g.route_json, g.route_json_len, name_ptr, name_len, &entry.bytes, &entry.len);
    if !ok { return false; };
    let ep: ptr = PTR_NULL();
    PTR_BYTE_ADD(ep, &entry.bytes, 0);
    kind = sa_json_object_get_u64(ep, entry.len, STR_PTR("kind"), STR_LEN("kind"));
    idx = sa_json_object_get_u64(ep, entry.len, STR_PTR("conn"), STR_LEN("conn"));
    raw.len = 0;
    sa_json_object_get_string(ep, entry.len, STR_PTR("raw"), STR_LEN("raw"), &raw.bytes, &raw.len);
    return true;
}

fn allows(cfg: &ServerCfg, raw_ptr: ptr, raw_len: u64) -> bool {
    // if (cfg.enabledTools && !cfg.enabledTools.includes(raw)) return false;
    if cfg.has_enabled_tools {
        if !sa_json_array_contains_string(&cfg.enabled_tools_json, cfg.enabled_tools_len, raw_ptr, raw_len) { return false; };
    };
    // if (cfg.disabledTools && cfg.disabledTools.includes(raw)) return false;
    if cfg.has_disabled_tools {
        if sa_json_array_contains_string(&cfg.disabled_tools_json, cfg.disabled_tools_len, raw_ptr, raw_len) { return false; };
    };
    return true;
}

struct StagedTool {
    cfg_name: [u8; 128], cfg_name_len: u64,
    kind: u64, conn_idx: u64,
    raw: RawTool,
}

struct StagedToolList {
    items: [StagedTool; 256],
    len: u64,
}

// Discover MCP tools (cached 60s). Never throws.
// DEFECT: async -> synchronous; every TS catch becomes a status code that is
// deliberately swallowed here, exactly like the source. Date.now() has no
// sa_std counterpart; sa_time_now_ms() is a placeholder extern.
fn loadMcpTools(g: &McpGlobals, force: bool, out: &McpToolList) -> void {
    out.len = 0;
    if !mcpEnabled() { return; };
    let now = sa_time_now_ms();
    let refresh_ms = numEnv(STR_PTR("MINI_MCP_REFRESH_MS"), STR_LEN("MINI_MCP_REFRESH_MS"), 60000, 5000, 600000);
    if !force && g.has_cached_tools && now - g.cached_at < refresh_ms {
        let i: u64 = 0;
        while i < g.cached_tools_len {
            out.items[i] = g.cached_tools[i];
            i = i + 1;
        }
        out.len = g.cached_tools_len;
        return;
    };
    let servers = ServerCfgList { items: [ServerCfg { name: [0u8; 128], name_len: 0, has_command: false, command: [0u8; 512], command_len: 0, args_json: [0u8; 2048], args_json_len: 0, has_env: false, env_json: [0u8; 2048], env_json_len: 0, has_cwd: false, cwd: [0u8; 512], cwd_len: 0, has_url: false, url: [0u8; 512], url_len: 0, has_http_headers: false, http_headers_json: [0u8; 2048], http_headers_json_len: 0, has_bearer_token_env_var: false, bearer_token_env_var: [0u8; 128], bearer_token_env_var_len: 0, enabled: false, startup_timeout_ms: 0, tool_timeout_ms: 0, has_enabled_tools: false, enabled_tools_json: [0u8; 1024], enabled_tools_json_len: 0, has_disabled_tools: false, disabled_tools_json: [0u8; 1024], disabled_tools_json_len: 0 }; 32], len: 0 };
    loadServers(&servers);
    let max_tools = numEnv(STR_PTR("MINI_MCP_MAX_TOOLS"), STR_LEN("MINI_MCP_MAX_TOOLS"), 64, 0, 256);
    // const staged: Array<{ cfg: ServerCfg; conn: StdioConn | HttpConn; raw: RawTool }> = [];
    let staged = StagedToolList { items: [StagedTool { cfg_name: [0u8; 128], cfg_name_len: 0, kind: 0, conn_idx: 0, raw: RawTool { name: [0u8; 128], name_len: 0, has_description: false, description: [0u8; 512], description_len: 0, has_input_schema: false, input_schema_json: [0u8; 4096], input_schema_json_len: 0 } }; 256], len: 0 };
    // snapshot of the previous route's conns (closed after the swap below)
    let old_route = TextBuf { bytes: [0u8; 32768], len: 0 };
    let orp: ptr = PTR_NULL();
    PTR_BYTE_ADD(orp, &g.route_json, 0);
    text_buf_append(&old_route, orp, g.route_json_len);
    let si: u64 = 0;
    while si < servers.len {
        let cfg = &servers.items[si];
        si = si + 1;
        // let conn: StdioConn | HttpConn;
        // try { conn = cfg.url ? new HttpConn(cfg) : new StdioConn(cfg); await withTimeout(conn.init(), cfg.startupTimeoutMs + 2_000, ...); const tools = await withTimeout(conn.list(), cfg.startupTimeoutMs, ...); ... }
        // catch (e) { console.warn(...); try { conn!.close(); } catch {} }
        // DEFECT: withTimeout wrappers are folded into init/list (their own
        // timeouts govern); the catch is the nonzero status path.
        let kind: u64 = 0;
        let idx: u64 = 0;
        let failed = false;
        let fail_msg = TextBuf { bytes: [0u8; 32768], len: 0 };
        if cfg.has_url {
            kind = 1;
            idx = g.http_conns_len;
            if idx >= 16 { failed = true; text_buf_append(&fail_msg, STR_PTR("too many MCP connections"), STR_LEN("too many MCP connections")); } else {
                HttpConn_new(cfg, &g.http_conns[idx]);
                g.http_conns_len = g.http_conns_len + 1;
            };
        } else {
            kind = 0;
            idx = g.stdio_conns_len;
            if idx >= 16 { failed = true; text_buf_append(&fail_msg, STR_PTR("too many MCP connections"), STR_LEN("too many MCP connections")); } else {
                let cst = StdioConn_new(cfg, &g.stdio_conns[idx]);
                if cst != 0 { failed = true; text_buf_append(&fail_msg, STR_PTR("spawn failed"), STR_LEN("spawn failed")); } else {
                    g.stdio_conns_len = g.stdio_conns_len + 1;
                };
            };
        };
        if !failed {
            let err = TextBuf { bytes: [0u8; 32768], len: 0 };
            let ist = Conn_init(g, kind, idx, &err);
            if ist != 0 {
                failed = true;
                let ep: ptr = PTR_NULL();
                PTR_BYTE_ADD(ep, &err.bytes, 0);
                text_buf_append(&fail_msg, ep, err.len);
            } else {
                let tools = RawToolList { items: [RawTool { name: [0u8; 128], name_len: 0, has_description: false, description: [0u8; 512], description_len: 0, has_input_schema: false, input_schema_json: [0u8; 4096], input_schema_json_len: 0 }; 64], len: 0 };
                let lst = Conn_list(g, kind, idx, &tools, &err);
                if lst != 0 {
                    failed = true;
                    let ep2: ptr = PTR_NULL();
                    PTR_BYTE_ADD(ep2, &err.bytes, 0);
                    text_buf_append(&fail_msg, ep2, err.len);
                } else {
                    let ti: u64 = 0;
                    while ti < tools.len {
                        let t = &tools.items[ti];
                        ti = ti + 1;
                        // if (!t || typeof t.name !== "string" || !t.name || !allows(cfg, t.name)) continue;
                        if t.name_len == 0 { continue; };
                        let rp: ptr = PTR_NULL();
                        PTR_BYTE_ADD(rp, &t.name, 0);
                        if !allows(cfg, rp, t.name_len) { continue; };
                        if staged.len >= 256 { break; };
                        let s = &staged.items[staged.len];
                        s.cfg_name_len = 0;
                        let ci: u64 = 0;
                        while ci < cfg.name_len {
                            s.cfg_name[ci] = cfg.name[ci];
                            ci = ci + 1;
                        }
                        s.cfg_name_len = cfg.name_len;
                        s.kind = kind;
                        s.conn_idx = idx;
                        s.raw = t;
                        staged.len = staged.len + 1;
                    }
                };
            };
        };
        if failed {
            // console.warn(`[mini-mcp] server '${cfg.name}' unavailable, skipping: ${msg.slice(0, 200)}`);
            // DEFECT: console.warn template approximated by a static println;
            // the server name and message are not printed.
            println("[mini-mcp] server unavailable, skipping (see _defects/mini-codex-B.md)");
            Conn_close(g, kind, idx);
        };
        // if (maxTools > 0 && staged.length >= maxTools) break;
        if max_tools > 0 && staged.len >= max_tools { break; };
    }
    // const counts = new Map<string, number>(); (built during staging in TS)
    // DEFECT: the counts Map is computed here by a second scan over staged
    // qualified names; the resulting counts are identical.
    // const used = new Set<string>();
    let used_json = TextBuf { bytes: [0u8; 32768], len: 0 };
    text_buf_append(&used_json, STR_PTR("[]"), STR_LEN("[]"));
    // const nextRoute = new Map<string, { conn, raw }>();
    let next_route = TextBuf { bytes: [0u8; 32768], len: 0 };
    text_buf_append(&next_route, STR_PTR("{}"), STR_LEN("{}"));
    let qi: u64 = 0;
    while qi < staged.len {
        let s = &staged.items[qi];
        qi = qi + 1;
        // if (maxTools > 0 && out.length >= maxTools) { try { s.conn.close(); } catch {} continue; }
        if max_tools > 0 && out.len >= max_tools {
            Conn_close(g, s.kind, s.conn_idx);
            continue;
        };
        // let name = qualifiedMcpName(s.cfg.name, s.raw.name);
        let cfg_name_ptr: ptr = PTR_NULL();
        PTR_BYTE_ADD(cfg_name_ptr, &s.cfg_name, 0);
        let raw_ptr: ptr = PTR_NULL();
        PTR_BYTE_ADD(raw_ptr, &s.raw.name, 0);
        let name = TextBuf { bytes: [0u8; 32768], len: 0 };
        qualifiedMcpName(cfg_name_ptr, s.cfg_name_len, raw_ptr, s.raw.name_len, &name);
        // count of staged entries sharing this base name (the counts Map)
        let cnt: u64 = 0;
        let cj: u64 = 0;
        while cj < staged.len {
            let o = &staged.items[cj];
            cj = cj + 1;
            let ocp: ptr = PTR_NULL();
            PTR_BYTE_ADD(ocp, &o.cfg_name, 0);
            let orp2: ptr = PTR_NULL();
            PTR_BYTE_ADD(orp2, &o.raw.name, 0);
            let oname = TextBuf { bytes: [0u8; 32768], len: 0 };
            qualifiedMcpName(ocp, o.cfg_name_len, orp2, o.raw.name_len, &oname);
            let np: ptr = PTR_NULL();
            PTR_BYTE_ADD(np, &name.bytes, 0);
            let op: ptr = PTR_NULL();
            PTR_BYTE_ADD(op, &oname.bytes, 0);
            if str_eq(np, name.len, op, oname.len) { cnt = cnt + 1; };
        }
        let name_ptr: ptr = PTR_NULL();
        PTR_BYTE_ADD(name_ptr, &name.bytes, 0);
        // if ((counts.get(name) ?? 0) > 1 || used.has(name)) { ...disambiguate... }
        if cnt > 1 || sa_json_array_contains_string(&used_json.bytes, used_json.len, name_ptr, name.len) {
            // const rawId = `${s.cfg.name}\0${s.raw.name}`;
            let raw_id = TextBuf { bytes: [0u8; 32768], len: 0 };
            text_buf_append(&raw_id, cfg_name_ptr, s.cfg_name_len);
            text_buf_append_byte(&raw_id, 0);
            text_buf_append(&raw_id, raw_ptr, s.raw.name_len);
            // name = qualifiedMcpName(`${s.cfg.name}_${shortHash(rawId, 6)}`, s.raw.name);
            let h = TextBuf { bytes: [0u8; 32768], len: 0 };
            let rip: ptr = PTR_NULL();
            PTR_BYTE_ADD(rip, &raw_id.bytes, 0);
            shortHash(rip, raw_id.len, 6, &h);
            let salted = TextBuf { bytes: [0u8; 32768], len: 0 };
            text_buf_append(&salted, cfg_name_ptr, s.cfg_name_len);
            text_buf_append(&salted, STR_PTR("_"), STR_LEN("_"));
            let hp: ptr = PTR_NULL();
            PTR_BYTE_ADD(hp, &h.bytes, 0);
            text_buf_append(&salted, hp, h.len);
            let sp2: ptr = PTR_NULL();
            PTR_BYTE_ADD(sp2, &salted.bytes, 0);
            qualifiedMcpName(sp2, salted.len, raw_ptr, s.raw.name_len, &name);
            // let n = 1; while (used.has(name) && n < 10) { name = qualifiedMcpName(`${cfg}_${shortHash(`${rawId}${n}`, 6)}`, raw); n++; }
            let n: u64 = 1;
            while n < 10 {
                let np2: ptr = PTR_NULL();
                PTR_BYTE_ADD(np2, &name.bytes, 0);
                if !sa_json_array_contains_string(&used_json.bytes, used_json.len, np2, name.len) { break; };
                let key2 = TextBuf { bytes: [0u8; 32768], len: 0 };
                text_buf_append(&key2, rip, raw_id.len);
                let nt = TextBuf { bytes: [0u8; 32768], len: 0 };
                sa_u64_to_dec(n, &nt.bytes, &nt.len);
                let ntp: ptr = PTR_NULL();
                PTR_BYTE_ADD(ntp, &nt.bytes, 0);
                text_buf_append(&key2, ntp, nt.len);
                let h2 = TextBuf { bytes: [0u8; 32768], len: 0 };
                let k2p: ptr = PTR_NULL();
                PTR_BYTE_ADD(k2p, &key2.bytes, 0);
                shortHash(k2p, key2.len, 6, &h2);
                let salted2 = TextBuf { bytes: [0u8; 32768], len: 0 };
                text_buf_append(&salted2, cfg_name_ptr, s.cfg_name_len);
                text_buf_append(&salted2, STR_PTR("_"), STR_LEN("_"));
                let h2p: ptr = PTR_NULL();
                PTR_BYTE_ADD(h2p, &h2.bytes, 0);
                text_buf_append(&salted2, h2p, h2.len);
                let s2p: ptr = PTR_NULL();
                PTR_BYTE_ADD(s2p, &salted2.bytes, 0);
                qualifiedMcpName(s2p, salted2.len, raw_ptr, s.raw.name_len, &name);
                n = n + 1;
            }
        };
        // if (used.has(name)) continue; used.add(name);
        let np3: ptr = PTR_NULL();
        PTR_BYTE_ADD(np3, &name.bytes, 0);
        if sa_json_array_contains_string(&used_json.bytes, used_json.len, np3, name.len) { continue; };
        sa_json_array_push_string(&used_json.bytes, &used_json.len, np3, name.len);
        // nextRoute.set(name, { conn: s.conn, raw: s.raw.name });
        sa_json_object_set_route(&next_route.bytes, &next_route.len, np3, name.len, s.kind, s.conn_idx, raw_ptr, s.raw.name_len);
        // out.push({ name, description: `[${cfg.name}] ${(...)}.slice(0, 500)`, schema: {...}, server, rawName });
        if out.len >= 64 { continue; };
        let e = &out.items[out.len];
        e.name_len = 0;
        let ei: u64 = 0;
        while ei < name.len && ei < 128 {
            e.name[ei] = name.bytes[ei];
            ei = ei + 1;
        }
        e.name_len = ei;
        // description: `[${s.cfg.name}] ` + (typeof s.raw.description === "string" && s.raw.description ? s.raw.description : `MCP tool ${s.raw.name}`), sliced to 500
        let desc = TextBuf { bytes: [0u8; 32768], len: 0 };
        text_buf_append(&desc, STR_PTR("["), STR_LEN("["));
        text_buf_append(&desc, cfg_name_ptr, s.cfg_name_len);
        text_buf_append(&desc, STR_PTR("] "), STR_LEN("] "));
        if s.raw.has_description && s.raw.description_len > 0 {
            let dp: ptr = PTR_NULL();
            PTR_BYTE_ADD(dp, &s.raw.description, 0);
            text_buf_append(&desc, dp, s.raw.description_len);
        } else {
            text_buf_append(&desc, STR_PTR("MCP tool "), STR_LEN("MCP tool "));
            text_buf_append(&desc, raw_ptr, s.raw.name_len);
        };
        e.description_len = 0;
        let di: u64 = 0;
        let dtake = desc.len;
        if dtake > 500 { dtake = 500; };
        while di < dtake {
            e.description[di] = desc.bytes[di];
            di = di + 1;
        }
        e.description_len = di;
        // schema: { ...(s.raw.inputSchema && typeof s.raw.inputSchema === "object" ? s.raw.inputSchema : { type: "object", properties: {} }), additionalProperties: true }
        // DEFECT: schema object spread approximated by copying the inputSchema
        // JSON text (or the default) and setting additionalProperties via extern.
        e.schema_json_len = 0;
        if s.raw.has_input_schema {
            let si2: u64 = 0;
            while si2 < s.raw.input_schema_json_len && si2 < 4096 {
                e.schema_json[si2] = s.raw.input_schema_json[si2];
                si2 = si2 + 1;
            }
            e.schema_json_len = si2;
        } else {
            let dj = TextBuf { bytes: [0u8; 32768], len: 0 };
            text_buf_append(&dj, STR_PTR("{\"type\":\"object\",\"properties\":{}}"), STR_LEN("{\"type\":\"object\",\"properties\":{}}"));
            let dji: u64 = 0;
            while dji < dj.len {
                e.schema_json[dji] = dj.bytes[dji];
                dji = dji + 1;
            }
            e.schema_json_len = dj.len;
        };
        sa_json_object_set_bool(&e.schema_json, &e.schema_json_len, STR_PTR("additionalProperties"), STR_LEN("additionalProperties"), true);
        e.server_len = 0;
        let vi: u64 = 0;
        while vi < s.cfg_name_len {
            e.server[vi] = s.cfg_name[vi];
            vi = vi + 1;
        }
        e.server_len = vi;
        e.raw_name_len = 0;
        let wi: u64 = 0;
        while wi < s.raw.name_len {
            e.raw_name[wi] = s.raw.name[wi];
            wi = wi + 1;
        }
        e.raw_name_len = wi;
        out.len = out.len + 1;
    }
    // for (const [, r] of route) { if (![...nextRoute.values()].includes(r)) { try { r.conn.close(); } catch {} } }
    // DEFECT: identity comparison of route values ([...nextRoute.values()]
    // .includes(r)) has no counterpart; by construction staged conns are new
    // slots, so every previous-route conn is closed here, as in TS.
    // DEFECT: conn slots are append-only in this conversion; closed slots are
    // not compacted or reused (table caps: 16 stdio + 16 http).
    let on = sa_json_object_len(&old_route.bytes, old_route.len);
    let oi: u64 = 0;
    while oi < on {
        let k = TextBuf { bytes: [0u8; 32768], len: 0 };
        let v = TextBuf { bytes: [0u8; 32768], len: 0 };
        sa_json_object_entry(&old_route.bytes, old_route.len, oi, &k.bytes, &k.len, &v.bytes, &v.len);
        oi = oi + 1;
        let vp: ptr = PTR_NULL();
        PTR_BYTE_ADD(vp, &v.bytes, 0);
        let okind = sa_json_object_get_u64(vp, v.len, STR_PTR("kind"), STR_LEN("kind"));
        let oidx = sa_json_object_get_u64(vp, v.len, STR_PTR("conn"), STR_LEN("conn"));
        Conn_close(g, okind, oidx);
    }
    // route.clear(); for (const [k, v] of nextRoute) route.set(k, v);
    g.route_json_len = 0;
    let ri2: u64 = 0;
    while ri2 < next_route.len && ri2 < 16384 {
        g.route_json[ri2] = next_route.bytes[ri2];
        ri2 = ri2 + 1;
    }
    g.route_json_len = ri2;
    // serverConns.clear(); for (const [, r] of nextRoute) { const owner = staged.find((s) => s.conn === r.conn); if (owner && !serverConns.has(owner.cfg.name)) serverConns.set(owner.cfg.name, r.conn); }
    // DEFECT: staged.find with an identity closure approximated by a scan on
    // (kind, conn_idx).
    g.server_conns_json_len = 0;
    let sc = TextBuf { bytes: [0u8; 32768], len: 0 };
    text_buf_append(&sc, STR_PTR("{}"), STR_LEN("{}"));
    let nn = sa_json_object_len(&next_route.bytes, next_route.len);
    let ni2: u64 = 0;
    while ni2 < nn {
        let k = TextBuf { bytes: [0u8; 32768], len: 0 };
        let v = TextBuf { bytes: [0u8; 32768], len: 0 };
        sa_json_object_entry(&next_route.bytes, next_route.len, ni2, &k.bytes, &k.len, &v.bytes, &v.len);
        ni2 = ni2 + 1;
        let vp2: ptr = PTR_NULL();
        PTR_BYTE_ADD(vp2, &v.bytes, 0);
        let vkind = sa_json_object_get_u64(vp2, v.len, STR_PTR("kind"), STR_LEN("kind"));
        let vidx = sa_json_object_get_u64(vp2, v.len, STR_PTR("conn"), STR_LEN("conn"));
        let fi: u64 = 0;
        while fi < staged.len {
            let s = &staged.items[fi];
            fi = fi + 1;
            if s.kind == vkind && s.conn_idx == vidx {
                let snp: ptr = PTR_NULL();
                PTR_BYTE_ADD(snp, &s.cfg_name, 0);
                if !sa_json_object_has_strkey(&sc.bytes, sc.len, snp, s.cfg_name_len) {
                    sa_json_object_set_route(&sc.bytes, &sc.len, snp, s.cfg_name_len, vkind, vidx, STR_PTR(""), 0);
                };
                break;
            };
        }
    }
    let sci: u64 = 0;
    while sci < sc.len && sci < 8192 {
        g.server_conns_json[sci] = sc.bytes[sci];
        sci = sci + 1;
    }
    g.server_conns_json_len = sci;
    // cachedTools = out; cachedAt = now; return out;
    g.has_cached_tools = true;
    g.cached_tools_len = 0;
    let ci2: u64 = 0;
    while ci2 < out.len {
        g.cached_tools[ci2] = out.items[ci2];
        ci2 = ci2 + 1;
    }
    g.cached_tools_len = out.len;
    g.cached_at = now;
}

// Detailed variant: keeps raw {content, structuredContent} for PostToolUse
// tool_response (Codex parity).
// DEFECT: async -> synchronous; the TS try/catch around the call becomes the
// status path that produces the "MCP tool error (...)" text result.
fn runMcpToolDetailed(g: &McpGlobals, qualified_ptr: ptr, qualified_len: u64, args_ptr: ptr, args_len: u64, out: &McpCallResult) -> void {
    // let target = route.get(qualified);
    let kind: u64 = 0;
    let idx: u64 = 0;
    let raw = TextBuf { bytes: [0u8; 32768], len: 0 };
    let found = route_get(g, qualified_ptr, qualified_len, &kind, &idx, &raw);
    if !found {
        // await loadMcpTools(false); target = route.get(qualified);
        let scratch = McpToolList { items: [McpToolEntry { name: [0u8; 128], name_len: 0, description: [0u8; 512], description_len: 0, schema_json: [0u8; 4096], schema_json_len: 0, server: [0u8; 128], server_len: 0, raw_name: [0u8; 128], raw_name_len: 0 }; 64], len: 0 };
        loadMcpTools(g, false, &scratch);
        found = route_get(g, qualified_ptr, qualified_len, &kind, &idx, &raw);
    };
    if !found {
        // const text = `unknown MCP tool: ${qualified.slice(0, 120)}. MCP tools come from ~/.codex/config.toml [mcp_servers.*] as mcp__<server>__<tool>.`;
        let t = TextBuf { bytes: [0u8; 32768], len: 0 };
        text_buf_append(&t, STR_PTR("unknown MCP tool: "), STR_LEN("unknown MCP tool: "));
        let take = qualified_len;
        if take > 120 { take = 120; };
        text_buf_append(&t, qualified_ptr, take);
        text_buf_append(&t, STR_PTR(". MCP tools come from ~/.codex/config.toml [mcp_servers.*] as mcp__<server>__<tool>."), STR_LEN(". MCP tools come from ~/.codex/config.toml [mcp_servers.*] as mcp__<server>__<tool>."));
        out.text_len = 0;
        let i: u64 = 0;
        while i < t.len && i < 8192 {
            out.text[i] = t.bytes[i];
            i = i + 1;
        }
        out.text_len = i;
        out.response_json_len = 0;
        let rj = TextBuf { bytes: [0u8; 32768], len: 0 };
        text_buf_append(&rj, STR_PTR("{\"content\":[],\"structuredContent\":null}"), STR_LEN("{\"content\":[],\"structuredContent\":null}"));
        let j: u64 = 0;
        while j < rj.len {
            out.response_json[j] = rj.bytes[j];
            j = j + 1;
        }
        out.response_json_len = rj.len;
        return;
    };
    // try { return await target.conn.callDetailed(target.raw, args ?? {}); }
    // catch (e) { const text = `MCP tool error (${qualified.slice(0, 80)}): ${msg.slice(0, 500)}`; return { text, response: {...} }; }
    let err = TextBuf { bytes: [0u8; 32768], len: 0 };
    let rp: ptr = PTR_NULL();
    PTR_BYTE_ADD(rp, &raw.bytes, 0);
    let st = Conn_callDetailed(g, kind, idx, rp, raw.len, args_ptr, args_len, tool_timeout_of(g, kind, idx), out, &err);
    if st != 0 {
        let t = TextBuf { bytes: [0u8; 32768], len: 0 };
        text_buf_append(&t, STR_PTR("MCP tool error ("), STR_LEN("MCP tool error ("));
        let take = qualified_len;
        if take > 80 { take = 80; };
        text_buf_append(&t, qualified_ptr, take);
        text_buf_append(&t, STR_PTR("): "), STR_LEN("): "));
        let ep: ptr = PTR_NULL();
        PTR_BYTE_ADD(ep, &err.bytes, 0);
        let etake = err.len;
        if etake > 500 { etake = 500; };
        text_buf_append(&t, ep, etake);
        out.text_len = 0;
        let i: u64 = 0;
        while i < t.len && i < 8192 {
            out.text[i] = t.bytes[i];
            i = i + 1;
        }
        out.text_len = i;
        out.response_json_len = 0;
        let rj = TextBuf { bytes: [0u8; 32768], len: 0 };
        text_buf_append(&rj, STR_PTR("{\"content\":[],\"structuredContent\":null}"), STR_LEN("{\"content\":[],\"structuredContent\":null}"));
        let j: u64 = 0;
        while j < rj.len {
            out.response_json[j] = rj.bytes[j];
            j = j + 1;
        }
        out.response_json_len = rj.len;
    };
}

// helper: cfg.toolTimeoutMs of a conn slot (TS relied on callDetailed's
// default parameter); part of the union-dispatch approximation.
fn tool_timeout_of(g: &McpGlobals, kind: u64, idx: u64) -> u64 {
    if kind == 1 { return g.http_conns[idx].cfg.tool_timeout_ms; };
    return g.stdio_conns[idx].cfg.tool_timeout_ms;
}

// DEFECT: async -> synchronous (thin wrapper over runMcpToolDetailed).
fn runMcpTool(g: &McpGlobals, qualified_ptr: ptr, qualified_len: u64, args_ptr: ptr, args_len: u64, out: &TextBuf) -> void {
    let r = McpCallResult { text: [0u8; 8192], text_len: 0, response_json: [0u8; 16384], response_json_len: 0 };
    runMcpToolDetailed(g, qualified_ptr, qualified_len, args_ptr, args_len, &r);
    out.len = 0;
    let tp: ptr = PTR_NULL();
    PTR_BYTE_ADD(tp, &r.text, 0);
    text_buf_append(out, tp, r.text_len);
}

// Raw server/tool caller for mcp_tool hook handlers (bypasses hook pipeline; no recursion).
// Returns 0 + text in out; nonzero + message in err (TS throws).
// DEFECT: async -> synchronous; the Date.now() deadline arithmetic and the
// nested withTimeout calls are folded into a single remaining-ms value
// passed to callDetailed.
fn callMcpByServerRaw(g: &McpGlobals, server_ptr: ptr, server_len: u64, tool_ptr: ptr, tool_len: u64, input_ptr: ptr, input_len: u64, has_timeout: bool, timeout_ms: u64, out: &TextBuf, err: &TextBuf) -> i32 {
    // const deadline = timeoutMs === undefined ? undefined : Date.now() + timeoutMs;
    let deadline: u64 = 0;
    if has_timeout { deadline = sa_time_now_ms() + timeout_ms; };
    // const conn = timeoutMs === undefined ? await serverConn(server) : await withTimeout(serverConn(server), timeoutMs, `MCP hook '${server}/${tool}'`);
    let kind: u64 = 0;
    let idx: u64 = 0;
    let found = serverConn(g, server_ptr, server_len, &kind, &idx);
    if !found {
        // throw new Error(`unknown or unavailable MCP server: ${String(server).slice(0, 120)}`);
        err.len = 0;
        text_buf_append(err, STR_PTR("unknown or unavailable MCP server: "), STR_LEN("unknown or unavailable MCP server: "));
        let take = server_len;
        if take > 120 { take = 120; };
        text_buf_append(err, server_ptr, take);
        return 1;
    };
    // const remainingMs = deadline === undefined ? undefined : Math.max(1, deadline - Date.now());
    let call_timeout = tool_timeout_of(g, kind, idx);
    if has_timeout {
        let now2 = sa_time_now_ms();
        let rem: u64 = 1;
        if deadline > now2 { rem = deadline - now2; };
        call_timeout = rem;
    };
    // const r = remainingMs === undefined ? await conn.callDetailed(tool, input ?? {}) : await withTimeout(conn.callDetailed(tool, input ?? {}, remainingMs), remainingMs, ...);
    // return r.text;
    let r = McpCallResult { text: [0u8; 8192], text_len: 0, response_json: [0u8; 16384], response_json_len: 0 };
    let st = Conn_callDetailed(g, kind, idx, tool_ptr, tool_len, input_ptr, input_len, call_timeout, &r, err);
    if st != 0 { return st; };
    out.len = 0;
    let tp: ptr = PTR_NULL();
    PTR_BYTE_ADD(tp, &r.text, 0);
    text_buf_append(out, tp, r.text_len);
    return 0;
}

fn mcpStatusLine(g: &McpGlobals, out: &TextBuf) -> void {
    out.len = 0;
    if !mcpEnabled() {
        text_buf_append(out, STR_PTR("mcp: off (MINI_MCP=off)"), STR_LEN("mcp: off (MINI_MCP=off)"));
        return;
    };
    // if (!cachedTools) return "mcp: not loaded yet (from ~/.codex/config.toml [mcp_servers.*])";
    if !g.has_cached_tools {
        text_buf_append(out, STR_PTR("mcp: not loaded yet (from ~/.codex/config.toml [mcp_servers.*])"), STR_LEN("mcp: not loaded yet (from ~/.codex/config.toml [mcp_servers.*])"));
        return;
    };
    if g.cached_tools_len == 0 {
        text_buf_append(out, STR_PTR("mcp: no servers/tools"), STR_LEN("mcp: no servers/tools"));
        return;
    };
    // const byServer = new Map<string, number>(); for (const t of cachedTools) byServer.set(t.server, (byServer.get(t.server) ?? 0) + 1);
    // return `mcp: ${[...byServer].map(([s, n]) => `${s} (${n} tools)`).join(", ")}`;
    // DEFECT: Map counting + spread/map/join template assembly approximated
    // by a linear scan emitting each server once with its count.
    text_buf_append(out, STR_PTR("mcp: "), STR_LEN("mcp: "));
    let i: u64 = 0;
    let first = true;
    while i < g.cached_tools_len {
        let srv_ptr: ptr = PTR_NULL();
        PTR_BYTE_ADD(srv_ptr, &g.cached_tools[i].server, 0);
        let srv_len = g.cached_tools[i].server_len;
        // skip servers already emitted
        let seen = false;
        let j: u64 = 0;
        while j < i {
            let p2: ptr = PTR_NULL();
            PTR_BYTE_ADD(p2, &g.cached_tools[j].server, 0);
            if str_eq(p2, g.cached_tools[j].server_len, srv_ptr, srv_len) { seen = true; break; };
            j = j + 1;
        }
        i = i + 1;
        if seen { continue; };
        let cnt: u64 = 0;
        let k: u64 = 0;
        while k < g.cached_tools_len {
            let p3: ptr = PTR_NULL();
            PTR_BYTE_ADD(p3, &g.cached_tools[k].server, 0);
            if str_eq(p3, g.cached_tools[k].server_len, srv_ptr, srv_len) { cnt = cnt + 1; };
            k = k + 1;
        }
        if !first { text_buf_append(out, STR_PTR(", "), STR_LEN(", ")); };
        first = false;
        text_buf_append(out, srv_ptr, srv_len);
        text_buf_append(out, STR_PTR(" ("), STR_LEN(" ("));
        let nt = TextBuf { bytes: [0u8; 32768], len: 0 };
        sa_u64_to_dec(cnt, &nt.bytes, &nt.len);
        let ntp: ptr = PTR_NULL();
        PTR_BYTE_ADD(ntp, &nt.bytes, 0);
        text_buf_append(out, ntp, nt.len);
        text_buf_append(out, STR_PTR(" tools)"), STR_LEN(" tools)"));
    }
}

fn resourceContentsToText(contents: &McpResourceContentList, out: &TextBuf) -> void {
    out.len = 0;
    // if (!Array.isArray(contents) || !contents.length) return "(empty MCP resource)";
    if contents.len == 0 {
        text_buf_append(out, STR_PTR("(empty MCP resource)"), STR_LEN("(empty MCP resource)"));
        return;
    };
    let parts = TextBuf { bytes: [0u8; 32768], len: 0 };
    let i: u64 = 0;
    while i < contents.len {
        let entry = &contents.items[i];
        i = i + 1;
        // if (typeof entry.text === "string" && entry.text) parts.push(entry.text);
        if entry.has_text && entry.text_len > 0 {
            if parts.len > 0 { text_buf_append(&parts, STR_PTR("\n"), STR_LEN("\n")); };
            let tp: ptr = PTR_NULL();
            PTR_BYTE_ADD(tp, &entry.text, 0);
            text_buf_append(&parts, tp, entry.text_len);
            continue;
        };
        // else if (typeof entry.blob === "string" && entry.blob) { const bytes = Math.floor((entry.blob.length * 3) / 4); parts.push(`[binary content${entry.mimeType ? ` (${entry.mimeType})` : ""} ~${bytes} bytes, base64 omitted]`); }
        if entry.has_blob && entry.blob_len > 0 {
            if parts.len > 0 { text_buf_append(&parts, STR_PTR("\n"), STR_LEN("\n")); };
            text_buf_append(&parts, STR_PTR("[binary content"), STR_LEN("[binary content"));
            if entry.has_mime_type {
                text_buf_append(&parts, STR_PTR(" ("), STR_LEN(" ("));
                let mp: ptr = PTR_NULL();
                PTR_BYTE_ADD(mp, &entry.mime_type, 0);
                text_buf_append(&parts, mp, entry.mime_type_len);
                text_buf_append(&parts, STR_PTR(")"), STR_LEN(")"));
            };
            text_buf_append(&parts, STR_PTR(" ~"), STR_LEN(" ~"));
            let bytes = (entry.blob_len * 3) / 4;
            let nt = TextBuf { bytes: [0u8; 32768], len: 0 };
            sa_u64_to_dec(bytes, &nt.bytes, &nt.len);
            let ntp: ptr = PTR_NULL();
            PTR_BYTE_ADD(ntp, &nt.bytes, 0);
            text_buf_append(&parts, ntp, nt.len);
            text_buf_append(&parts, STR_PTR(" bytes, base64 omitted]"), STR_LEN(" bytes, base64 omitted]"));
        };
    }
    // return (parts.join("\n").trim() || "(empty MCP resource)").slice(0, 8000);
    let lo: u64 = 0;
    let hi: u64 = parts.len;
    while lo < hi {
        if parts.bytes[lo] != 32 && parts.bytes[lo] != 9 && parts.bytes[lo] != 10 && parts.bytes[lo] != 13 { break; };
        lo = lo + 1;
    }
    while hi > lo {
        if parts.bytes[hi - 1] != 32 && parts.bytes[hi - 1] != 9 && parts.bytes[hi - 1] != 10 && parts.bytes[hi - 1] != 13 { break; };
        hi = hi - 1;
    }
    if lo >= hi {
        text_buf_append(out, STR_PTR("(empty MCP resource)"), STR_LEN("(empty MCP resource)"));
        return;
    };
    let take = hi - lo;
    if take > 8000 { take = 8000; };
    text_buf_append(out, item_ptr_at(&parts.bytes, lo), take);
}

// async function serverConn(name: string) -> Promise<(StdioConn | HttpConn) | null>
// Returns true + (kind, idx) when found.
// DEFECT: async -> synchronous; [...serverConns].find(([k]) => k === want ||
// k.toLowerCase() === want.toLowerCase()) approximated by a key scan with an
// ASCII case-insensitive comparison.
fn serverConn(g: &McpGlobals, name_ptr: ptr, name_len: u64, kind: &u64, idx: &u64) -> bool {
    // const want = String(name ?? "").trim();
    let lo: u64 = 0;
    let hi: u64 = name_len;
    while lo < hi {
        let c: u8 = 0;
        PTR_BYTE_AT(c, name_ptr, lo);
        if c != 32 && c != 9 && c != 10 && c != 13 { break; };
        lo = lo + 1;
    }
    while hi > lo {
        let c: u8 = 0;
        PTR_BYTE_AT(c, name_ptr, hi - 1);
        if c != 32 && c != 9 && c != 10 && c != 13 { break; };
        hi = hi - 1;
    }
    if lo >= hi { return false; };
    let want_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(want_ptr, name_ptr, lo);
    let want_len = hi - lo;
    // first attempt over the current serverConns table
    let attempt: u64 = 0;
    while attempt < 2 {
        let n = sa_json_object_len(&g.server_conns_json, g.server_conns_json_len);
        let i: u64 = 0;
        while i < n {
            let k = TextBuf { bytes: [0u8; 32768], len: 0 };
            let v = TextBuf { bytes: [0u8; 32768], len: 0 };
            sa_json_object_entry(&g.server_conns_json, g.server_conns_json_len, i, &k.bytes, &k.len, &v.bytes, &v.len);
            i = i + 1;
            let kp: ptr = PTR_NULL();
            PTR_BYTE_ADD(kp, &k.bytes, 0);
            if str_eq(kp, k.len, want_ptr, want_len) || str_eq_lower(kp, k.len, want_ptr, want_len) {
                let vp: ptr = PTR_NULL();
                PTR_BYTE_ADD(vp, &v.bytes, 0);
                kind = sa_json_object_get_u64(vp, v.len, STR_PTR("kind"), STR_LEN("kind"));
                idx = sa_json_object_get_u64(vp, v.len, STR_PTR("conn"), STR_LEN("conn"));
                return true;
            };
        }
        if attempt == 0 {
            // await loadMcpTools(false); then retry once
            let scratch = McpToolList { items: [McpToolEntry { name: [0u8; 128], name_len: 0, description: [0u8; 512], description_len: 0, schema_json: [0u8; 4096], schema_json_len: 0, server: [0u8; 128], server_len: 0, raw_name: [0u8; 128], raw_name_len: 0 }; 64], len: 0 };
            loadMcpTools(g, false, &scratch);
        };
        attempt = attempt + 1;
    }
    return false;
}

// helper: ASCII case-insensitive equality (TS used toLowerCase on both sides;
// Unicode case folding is not reproduced).
fn str_eq_lower(a_ptr: ptr, a_len: u64, b_ptr: ptr, b_len: u64) -> bool {
    if a_len != b_len { return false; };
    let i: u64 = 0;
    while i < a_len {
        let a: u8 = 0;
        let b: u8 = 0;
        PTR_BYTE_AT(a, a_ptr, i);
        PTR_BYTE_AT(b, b_ptr, i);
        if a >= 65 && a <= 90 { a = a + 32; };
        if b >= 65 && b <= 90 { b = b + 32; };
        if a != b { return false; };
        i = i + 1;
    }
    return true;
}

// List resources across connected servers (optionally one server). Never throws.
// DEFECT: async -> synchronous; the names Set becomes a JSON array text with
// linear membership; per-server try/catch becomes the status path.
fn listMcpResources(g: &McpGlobals, has_server: bool, server_ptr: ptr, server_len: u64, out: &McpResourceList) -> void {
    out.len = 0;
    if !mcpEnabled() { return; };
    // const names = new Set<string>();
    let names = TextBuf { bytes: [0u8; 32768], len: 0 };
    text_buf_append(&names, STR_PTR("[]"), STR_LEN("[]"));
    if has_server {
        // if (server?.trim()) names.add(server.trim());
        let lo: u64 = 0;
        let hi: u64 = server_len;
        while lo < hi {
            let c: u8 = 0;
            PTR_BYTE_AT(c, server_ptr, lo);
            if c != 32 && c != 9 { break; };
            lo = lo + 1;
        }
        while hi > lo {
            let c: u8 = 0;
            PTR_BYTE_AT(c, server_ptr, hi - 1);
            if c != 32 && c != 9 { break; };
            hi = hi - 1;
        }
        if lo < hi {
            sa_json_array_push_string(&names.bytes, &names.len, item_ptr_at_bytes(server_ptr, lo), hi - lo);
        };
    } else {
        // for (const k of serverConns.keys()) names.add(k);
        collect_server_names(g, &names);
        if sa_json_array_len(&names.bytes, names.len) == 0 {
            // await loadMcpTools(false); for (const k of serverConns.keys()) names.add(k);
            let scratch = McpToolList { items: [McpToolEntry { name: [0u8; 128], name_len: 0, description: [0u8; 512], description_len: 0, schema_json: [0u8; 4096], schema_json_len: 0, server: [0u8; 128], server_len: 0, raw_name: [0u8; 128], raw_name_len: 0 }; 64], len: 0 };
            loadMcpTools(g, false, &scratch);
            collect_server_names(g, &names);
        };
    };
    // for (const name of names) { const conn = await serverConn(name); if (!conn) continue; try { ... } catch (e) { console.warn(...); } }
    let nn = sa_json_array_len(&names.bytes, names.len);
    let ni: u64 = 0;
    while ni < nn {
        let name = TextBuf { bytes: [0u8; 32768], len: 0 };
        sa_json_array_get_string(&names.bytes, names.len, ni, &name.bytes, &name.len);
        ni = ni + 1;
        let np: ptr = PTR_NULL();
        PTR_BYTE_ADD(np, &name.bytes, 0);
        let kind: u64 = 0;
        let idx: u64 = 0;
        if !serverConn(g, np, name.len, &kind, &idx) { continue; };
        // const raw = await withTimeout(conn.listResources(), 15_000, `MCP '${name}' resources/list`);
        // DEFECT: withTimeout folded into listResources (see loadMcpTools note).
        let raw_list = RawResourceList { items: [RawResource { uri: [0u8; 512], uri_len: 0, has_name: false, name: [0u8; 256], name_len: 0, has_title: false, title: [0u8; 256], title_len: 0, has_description: false, description: [0u8; 512], description_len: 0, has_mime_type: false, mime_type: [0u8; 128], mime_type_len: 0 }; 200], len: 0 };
        let err = TextBuf { bytes: [0u8; 32768], len: 0 };
        let st = Conn_listResources(g, kind, idx, &raw_list, &err);
        if st != 0 {
            // console.warn(`[mini-mcp] resources/list failed for '${name}': ${msg.slice(0, 200)}`);
            println("[mini-mcp] resources/list failed (see _defects/mini-codex-B.md)");
            continue;
        };
        let ri: u64 = 0;
        while ri < raw_list.len {
            let r = &raw_list.items[ri];
            ri = ri + 1;
            // if (!r || typeof r.uri !== "string" || !r.uri) continue;
            if r.uri_len == 0 { continue; };
            if out.len >= 200 { return; };
            let e = &out.items[out.len];
            e.server_len = 0;
            let a: u64 = 0;
            while a < name.len && a < 128 {
                e.server[a] = name.bytes[a];
                a = a + 1;
            }
            e.server_len = a;
            e.uri_len = 0;
            let b: u64 = 0;
            while b < r.uri_len && b < 512 {
                e.uri[b] = r.uri[b];
                b = b + 1;
            }
            e.uri_len = b;
            // name: typeof r.name === "string" && r.name ? r.name : r.uri
            e.name_len = 0;
            if r.has_name && r.name_len > 0 {
                let c2: u64 = 0;
                while c2 < r.name_len && c2 < 512 {
                    e.name[c2] = r.name[c2];
                    c2 = c2 + 1;
                }
                e.name_len = c2;
            } else {
                let c2: u64 = 0;
                while c2 < r.uri_len && c2 < 512 {
                    e.name[c2] = r.uri[c2];
                    c2 = c2 + 1;
                }
                e.name_len = c2;
            };
            // ...(typeof r.mimeType === "string" && r.mimeType ? { mimeType: r.mimeType } : {})
            // DEFECT: conditional spread property approximated by the has_* flag.
            e.has_mime_type = r.has_mime_type && r.mime_type_len > 0;
            e.mime_type_len = 0;
            if e.has_mime_type {
                let d: u64 = 0;
                while d < r.mime_type_len && d < 128 {
                    e.mime_type[d] = r.mime_type[d];
                    d = d + 1;
                }
                e.mime_type_len = d;
            };
            out.len = out.len + 1;
            if out.len >= 200 { return; };
        }
    }
}

// helper: push every serverConns key into the names JSON array
fn collect_server_names(g: &McpGlobals, names: &TextBuf) -> void {
    let n = sa_json_object_len(&g.server_conns_json, g.server_conns_json_len);
    let i: u64 = 0;
    while i < n {
        let k = TextBuf { bytes: [0u8; 32768], len: 0 };
        let v = TextBuf { bytes: [0u8; 32768], len: 0 };
        sa_json_object_entry(&g.server_conns_json, g.server_conns_json_len, i, &k.bytes, &k.len, &v.bytes, &v.len);
        i = i + 1;
        let kp: ptr = PTR_NULL();
        PTR_BYTE_ADD(kp, &k.bytes, 0);
        if !sa_json_array_contains_string(&names.bytes, names.len, kp, k.len) {
            sa_json_array_push_string(&names.bytes, &names.len, kp, k.len);
        };
    }
}

// helper: pointer offset into a raw (ptr) buffer
fn item_ptr_at_bytes(base: ptr, off: u64) -> ptr {
    let p: ptr = PTR_NULL();
    PTR_BYTE_ADD(p, base, off);
    return p;
}

// Read one MCP resource as text. Never throws.
// DEFECT: async -> synchronous; catch becomes the error-text return path.
fn readMcpResource(g: &McpGlobals, server_ptr: ptr, server_len: u64, uri_ptr: ptr, uri_len: u64, out: &TextBuf) -> void {
    out.len = 0;
    // const name = String(server ?? "").trim(); const id = String(uri ?? "").trim();
    let name = TextBuf { bytes: [0u8; 32768], len: 0 };
    sa_trim_bytes(server_ptr, server_len, &name.bytes, &name.len);
    let idb = TextBuf { bytes: [0u8; 32768], len: 0 };
    sa_trim_bytes(uri_ptr, uri_len, &idb.bytes, &idb.len);
    if name.len == 0 || idb.len == 0 {
        text_buf_append(out, STR_PTR("read_mcp_resource needs {server, uri}."), STR_LEN("read_mcp_resource needs {server, uri}."));
        return;
    };
    if !mcpEnabled() {
        text_buf_append(out, STR_PTR("MCP is disabled (MINI_MCP=off)."), STR_LEN("MCP is disabled (MINI_MCP=off)."));
        return;
    };
    let np: ptr = PTR_NULL();
    PTR_BYTE_ADD(np, &name.bytes, 0);
    let kind: u64 = 0;
    let idx: u64 = 0;
    if !serverConn(g, np, name.len, &kind, &idx) {
        // return `unknown or unavailable MCP server: ${name.slice(0, 120)}. Resources come from ~/.codex/config.toml [mcp_servers.*]; list them with list_mcp_resources first.`;
        text_buf_append(out, STR_PTR("unknown or unavailable MCP server: "), STR_LEN("unknown or unavailable MCP server: "));
        let take = name.len;
        if take > 120 { take = 120; };
        text_buf_append(out, np, take);
        text_buf_append(out, STR_PTR(". Resources come from ~/.codex/config.toml [mcp_servers.*]; list them with list_mcp_resources first."), STR_LEN(". Resources come from ~/.codex/config.toml [mcp_servers.*]; list them with list_mcp_resources first."));
        return;
    };
    // try { const contents = await withTimeout(conn.readResource(id), 60_000, `MCP '${name}' resources/read`); return resourceContentsToText(contents); }
    // catch (e) { return `MCP resource error (${name.slice(0, 80)} ${id.slice(0, 120)}): ${msg.slice(0, 500)}`; }
    // DEFECT: withTimeout folded into readResource (see loadMcpTools note).
    let contents = McpResourceContentList { items: [McpResourceContent { uri: [0u8; 512], uri_len: 0, has_mime_type: false, mime_type: [0u8; 128], mime_type_len: 0, has_text: false, text: [0u8; 8192], text_len: 0, has_blob: false, blob: [0u8; 8192], blob_len: 0 }; 64], len: 0 };
    let err = TextBuf { bytes: [0u8; 32768], len: 0 };
    let ip3: ptr = PTR_NULL();
    PTR_BYTE_ADD(ip3, &idb.bytes, 0);
    let st = Conn_readResource(g, kind, idx, ip3, idb.len, &contents, &err);
    if st != 0 {
        text_buf_append(out, STR_PTR("MCP resource error ("), STR_LEN("MCP resource error ("));
        let take = name.len;
        if take > 80 { take = 80; };
        text_buf_append(out, np, take);
        text_buf_append(out, STR_PTR(" "), STR_LEN(" "));
        let itake = idb.len;
        if itake > 120 { itake = 120; };
        text_buf_append(out, ip3, itake);
        text_buf_append(out, STR_PTR("): "), STR_LEN("): "));
        let ep: ptr = PTR_NULL();
        PTR_BYTE_ADD(ep, &err.bytes, 0);
        let etake = err.len;
        if etake > 500 { etake = 500; };
        text_buf_append(out, ep, etake);
        return;
    };
    resourceContentsToText(&contents, out);
}
