}

fn itemLen_thread(it_kind: u64, text_len: u64, args_len: u64, name_len: u64, output_len: u64, images_len: u64) -> u64 {
    if it_kind == 0 { return text_len; };
    if it_kind == 1 { return text_len; };
    if it_kind == 2 { return text_len; };
    if it_kind == 3 { return text_len; };
    if it_kind == 4 { return args_len + name_len; };
    if it_kind == 5 { return output_len + images_len; };
    return 0;
}

