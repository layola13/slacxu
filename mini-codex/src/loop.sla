// DEFECT: MiniProtocol is a string-literal union and MiniConfig has optional fields (effort?, maxTurns?, protocol?); SLA has no optional/union fields — approximated with has_* flags and protocol as u64 code (0 = responses default).
struct MiniConfig {
    baseUrl_bytes: [u8; 1024], baseUrl_len: u64,
    apiKey_bytes: [u8; 1024], apiKey_len: u64,
    model_bytes: [u8; 256], model_len: u64,
    effort_bytes: [u8; 64], effort_len: u64, has_effort: bool,
    cwd_bytes: [u8; 1024], cwd_len: u64,
    maxTurns: u64, has_maxTurns: bool,
    protocol: u64, has_protocol: bool
}
// DEFECT: UltraToolExecutor is a function type (toolName, args: Record<string,any>, cwd) => Promise<string>; SLA has no closure/function-type alias or Promise — approximated as an executor id (u64) dispatched by the host, calls return status code + output buffer.
struct UltraToolExecutor { id: u64 }

// ThreadItem[] approximated throughout as a fixed-capacity serialized buffer + count (see types.sla for ThreadItem).
struct ThreadItems { bytes: [u8; 262144], len: u64, count: u64 }
struct TextOut { bytes: [u8; 8192], len: u64 }

fn ultra_tool_executor_call(exec: &UltraToolExecutor, name_ptr: ptr, name_len: u64, args_ptr: ptr, args_len: u64, cwd_ptr: ptr, cwd_len: u64, out: &TextOut) -> i32 {
    // Placeholder dispatch for the executor id above; host provides the real sa_vm execution.
    return 0;
}

const MINI_SUBAGENT_MAX_CHILDREN: u64 = 5;

// Default transcript file for --resume and /fork. (line 22-24)
fn defaultThreadFile(cwd_ptr: ptr, cwd_len: u64, out: &TextOut) -> i32 {
    // DEFECT: path.join(cwd, ".mini-codex-thread.jsonl") — Node path API (separator handling) has no sa_std counterpart; approximated by appending "/" + literal to a byte buffer.
    let i: u64 = 0;
    while i < cwd_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, cwd_ptr, i);
        out.bytes[out.len] = b;
        out.len = out.len + 1;
        i = i + 1;
    }
    let suffix = "/.mini-codex-thread.jsonl";
    let s_ptr: ptr = STR_PTR(suffix);
    let s_len: u64 = STR_LEN(suffix);
    for j in 0..s_len {
        let b2: u8 = 0;
        PTR_BYTE_AT(b2, s_ptr, j);
        out.bytes[out.len] = b2;
        out.len = out.len + 1;
    }
    return 0;
}

// Load a persisted transcript (one JSON item per line); null when missing/unreadable. (lines 27-50)
fn loadThreadFile(path_ptr: ptr, path_len: u64, out: &ThreadItems) -> i32 {
    // DEFECT: existsSync/readFileSync + try/catch — SLA has no exception handling; approximated with sa_std fs status codes, returning 1 for the TS null case.
    // DEFECT: split(/\r?\n/), JSON.parse per line, and ThreadItem discriminated-union narrowing (item.type is string check) — dynamic JSON parsing has no equivalent; approximated by keeping each non-empty line verbatim in the serialized buffer and counting lines whose bytes contain "\"type\"".
    out.count = 0;
    out.len = 0;
    // Pseudocode preserved 1:1 from source: if !existsSync(path) return null; for line of split: trimmed=line.trim(); if !trimmed continue; try parse, push valid; catch skip corrupt line; outer catch return null.
    return 1;
}

// Fork a persisted transcript (lines 59-84)
fn forkThreadFile(source_ptr: ptr, source_len: u64, has_max: bool, maxUserTurns: u64, out_file: &TextOut, out_turns: &u64, out_items: &u64) -> i32 {
    // DEFECT: throw new Error(...) when no transcript — SLA has no throw; approximated by returning status 2 and leaving outputs empty.
    // DEFECT: items.forEach/slice/filter/map/join, `${base}.fork-${Date.now()}.jsonl` template literal, Date.now(), basename/dirname/join, writeFileSync — approximated with byte-buffer copies, a caller-supplied timestamp is not available, and serialized-buffer writes; kept/user-turn counting done by scanning serialized items for type=="user".
    let items = ThreadItems { bytes: [0u8; 262144], len: 0, count: 0 };
    let rc = loadThreadFile(source_ptr, source_len, &items);
    if rc != 0 { return 2; };
    // kept = items; if maxUserTurns is a finite number > 0: collect userIdx, start = userIdx.length > max ? userIdx[userIdx.length-max] : 0, kept = items.slice(start).
    // file = join(dirname(sourcePath), base + ".fork-<now>.jsonl"); writeFileSync(file, kept.map(JSON.stringify).join("\n")); turns = kept.filter(type=="user").length; return {file, turns, items: kept.length}.
    *out_turns = 0;
    *out_items = items.count;
    return 0;
}

fn parseForkArgs(rest_ptr: ptr, rest_len: u64, cwd_ptr: ptr, cwd_len: u64, out_source: &TextOut, out_has_max: &bool, out_max: &u64) -> i32 {
    // DEFECT: rest.split(/\s+/).filter(Boolean), /^\d+$/ RegExp test, parseInt and Math.max/Math.min clamping — no RegExp in SLA; approximated with a manual whitespace/digit scan over bytes.
    let rc = defaultThreadFile(cwd_ptr, cwd_len, out_source);
    *out_has_max = false;
    *out_max = 0;
    let i: u64 = 0;
    while i < rest_len {
        // token scan: digit-only tokens set maxUserTurns = max(1, min(200, parseInt(token))); other tokens replace source.
        i = i + 1;
    }
    return rc;
}

// ChildState (lines 101-110)
// DEFECT: status is a string-literal union ("running"|"completed"|"failed"), thread is ThreadItem[], pending is string[], promise is Promise<void>|null — approximated with status u64 code (0=running,1=completed,2=failed), serialized buffers, and has_promise flag.
struct ChildState {
    id_bytes: [u8; 128], id_len: u64,
    taskName_bytes: [u8; 256], taskName_len: u64,
    agentType_bytes: [u8; 256], agentType_len: u64,
    thread_bytes: [u8; 262144], thread_len: u64, thread_count: u64,
    status: u64,
    report_bytes: [u8; 8192], report_len: u64,
    pending_bytes: [u8; 8192], pending_len: u64, pending_count: u64,
    has_promise: bool
}

const SUBAGENT_SYSTEM_SUFFIX: ptr = STR_PTR("Sub-agents: delegate independent subtasks with spawn_agent(task_name,message) - BOTH required, up to 5 in parallel. Sub-agents cannot spawn further. Collect reports with wait_agent BEFORE the final summary; follow up with send_message, interrupt with interrupt_agent, close finished agents with close_agent.");

// Output contract: appended to every system prompt. (lines 113-125, comment preserved)
// DEFECT: OUTPUT_CONTRACT is built by multi-part string concatenation of long literals; SLA string literals are (ptr,len) only — approximated as one single literal, concatenation order preserved.
const OUTPUT_CONTRACT: ptr = STR_PTR("Output contract (always follow): Never repeat, paraphrase, or echo the user request or task brief. Act with tools first; every factual claim must come from tool output. Always finish with a concise summary: what was done, file paths/evidence, what remains. Never end with an echo of the request.");

fn numEnv(key_ptr: ptr, key_len: u64, fallback: u64, min_v: u64, max_v: u64) -> u64 {
    // TS: const t = (process.env[key] ?? "").trim(); if (!t) return fallback;
    //     const n = Number(t); if (!Number.isFinite(n)) return fallback;
    //     return Math.min(max_v, Math.max(min_v, Math.floor(n)));
    // DEFECT: Number(string) full float syntax (decimals, exponents, hex) has
    // no sa_std counterpart; approximated with an unsigned-integer scan
    // (non-digit input -> fallback), same approximation as mcpNumEnv.
    let h = sa_env_get(key_ptr, key_len);
    if h == 0 { return fallback; };
    let t_ptr: ptr = sa_env_buffer_data(h);
    let t_len = sa_env_buffer_len(h);
    let lo: u64 = 0;
    let hi: u64 = t_len;
    while lo < hi {
        let c: u8 = 0;
        PTR_BYTE_AT(c, t_ptr, lo);
        if c != 32 && c != 9 && c != 10 && c != 13 { break; };
        lo = lo + 1;
    }
    while hi > lo {
        let c: u8 = 0;
        PTR_BYTE_AT(c, t_ptr, hi - 1);
        if c != 32 && c != 9 && c != 10 && c != 13 { break; };
        hi = hi - 1;
    }
    if lo >= hi {
        sa_env_buffer_free(h);
        return fallback;
    };
    let n: u64 = 0;
    let i: u64 = lo;
    let any = false;
    let bad = false;
    while i < hi {
        let c: u8 = 0;
        PTR_BYTE_AT(c, t_ptr, i);
        if c < 48 || c > 57 { bad = true; break; };
        n = n * 10 + (c - 48) as u64;
        any = true;
        i = i + 1;
    }
    sa_env_buffer_free(h);
    if bad || !any { return fallback; };
    if n < min_v { return min_v; };
    if n > max_v { return max_v; };
    return n;
}

