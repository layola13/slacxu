}

// Strip the protocol marker lines, keeping the evidence text. (lines 1055-1057)
fn cleanGoalMarker(text_ptr: ptr, text_len: u64, out: &TextOut) -> i32 {
    // DEFECT: text.split(/\r?\n/).filter(l => !/^\s*GOAL_(DONE|BLOCKED)\s*$/.test(l)).join("\n").trim() — split/filter/join with a closure and RegExp have no SLA counterpart; approximated with a line-by-line scan that copies every non-marker line and trims the result (ASCII).
    return 0;
}

// Validate the terminal response shape before honoring DONE/BLOCKED. (lines 1060-1063)
fn isGoalTerminalSupported(text_ptr: ptr, text_len: u64, objective_ptr: ptr, objective_len: u64, thread: &ThreadItems, startIndex: u64) -> bool {
    // summary = cleanGoalMarker(text); return Boolean(summary) && !isEchoOfPrompt(objective, summary) && hasGoalToolEvidence(thread, startIndex)
    let summary = TextOut { bytes: [0u8; 8192], len: 0 };
    let rc = cleanGoalMarker(text_ptr, text_len, &summary);
    if rc != 0 { return false; };
    if summary.len == 0 { return false; };
    let sum_p: ptr = PTR_NULL();
    PTR_BYTE_ADD(sum_p, &summary.bytes, 0);
    if isEchoOfPrompt(objective_ptr, objective_len, sum_p, summary.len) { return false; };
    return hasGoalToolEvidence(thread, startIndex);
}

fn goalSystemSuffix(objective_ptr: ptr, objective_len: u64, out: &TextOut) -> i32 {
    // DEFECT: return `[goal mode] Objective: ${objective}\n` + seven numbered rule literals concatenated ("Rules: 1) Make a 3-7 step plan, then act with tools — do not just describe. 2) Verify every change with tools (read files back, run tests/checks, show evidence). 3) Never claim success without tool evidence. 4) When the objective is achieved AND verified, end your final message with a summary plus 1-5 evidence bullets and a last line containing only GOAL_DONE. 5) If truly blocked (missing credentials, permissions, or resources after trying alternatives), report what was tried plus evidence and end with a last line containing only GOAL_BLOCKED. 6) Never repeat the objective back as your answer. 7) Track genuinely multi-step goals with update_plan (full checklist each call, one step in_progress at a time) and persist durable decisions/preferences with remember.") — template interpolation approximated by appending objective bytes between the fixed prefix and the rules literal.
    return 0;
}

// GoalModeArgs (lines 1075-1081)
// DEFECT: interface extending the AgentLoopArgs shape plus objective: string and optional chain?: MiniResponsesChain, holding the same Map/function/reference fields — approximated by embedding the AgentLoopArgs fields as ptr handles plus objective buffer and has_chain flag, mirroring AgentLoopArgs above.
struct GoalModeArgs {
    cfg_ptr: ptr, thread_ptr: ptr, tools_bytes: [u8; 32768], tools_len: u64, tools_count: u64,
    system_bytes: [u8; 16384], system_len: u64,
    children_ptr: ptr, exec_id: u64, skills_ptr: ptr,
    sessionId_bytes: [u8; 128], sessionId_len: u64,
    objective_bytes: [u8; 4096], objective_len: u64, depth: u64,
    chain_prevId_bytes: [u8; 256], chain_prevId_len: u64, chain_sentHash_bytes: [u8; 256], chain_sentHash_len: u64, chain_sentCount: u64, has_chain: bool
}
struct GoalModeResult { answer_bytes: [u8; 8192], answer_len: u64, chain_prevId_bytes: [u8; 256], chain_prevId_len: u64, chain_sentHash_bytes: [u8; 256], chain_sentHash_len: u64, chain_sentCount: u64 }

