// Transcript auto-load (lines 166-206, comments preserved in source order)
// DEFECT: loadThreadAuto destructures the object returned by loadThreadAutoWithDropped ({thread, dropped}) — SLA has no object destructuring/return objects; approximated with separate out parameters.
fn loadThreadAuto(save_ptr: ptr, save_len: u64, has_initial: bool, initial: &ThreadItems, out: &ThreadItems) -> i32 {
    let dropped = ThreadItems { bytes: [0u8; 262144], len: 0, count: 0 };
    let rc = loadThreadAutoWithDropped(save_ptr, save_len, has_initial, initial, out, &dropped);
    return rc;
}

fn loadThreadAutoWithDropped(save_ptr: ptr, save_len: u64, has_initial: bool, initial: &ThreadItems, out_thread: &ThreadItems, out_dropped: &ThreadItems) -> i32 {
    // DEFECT: initial?: ThreadItem[] | undefined, [...initial] spread copy, {thread, dropped} object returns, prev?.length optional chaining — approximated with has_initial flag and field-wise buffer copies.
    let keep = numEnv(STR_PTR("MINI_THREAD_KEEP"), STR_LEN("MINI_THREAD_KEEP"), 200, 20, 2000);
    if has_initial {
        if initial.count <= keep { out_thread.count = initial.count; return 0; };
        // sliced = splitKeptTail(initial, keep); return pinDroppedPlan(sliced.thread, sliced.dropped)
        return splitKeptTail(initial, keep, out_thread, out_dropped);
    };
    let prev = ThreadItems { bytes: [0u8; 262144], len: 0, count: 0 };
    let rc = loadThreadFile(save_ptr, save_len, &prev);
    if rc != 0 { out_thread.count = 0; out_dropped.count = 0; return 0; };
    if prev.count <= keep { out_thread.count = prev.count; return 0; };
    let rc2 = splitKeptTail(&prev, keep, out_thread, out_dropped);
    return pinDroppedPlan(out_thread, out_dropped);
}

// Slice the kept tail + dropped prefix (pure, keeps the cap logic in one place). (lines 209-211)
fn splitKeptTail(items: &ThreadItems, keep: u64, out_thread: &ThreadItems, out_dropped: &ThreadItems) -> i32 {
    // DEFECT: items.slice(items.length - keep) / items.slice(0, items.length - keep) on a dynamic array — approximated by count arithmetic over the serialized buffer; byte offsets of individual items are not tracked.
    if items.count <= keep { out_thread.count = items.count; out_dropped.count = 0; return 0; };
    out_thread.count = keep;
    out_dropped.count = items.count - keep;
    return 0;
}

// Carry the latest dropped plan forward (lines 214-230, comment preserved)
fn pinDroppedPlan(thread: &ThreadItems, dropped: &ThreadItems) -> i32 {
    // DEFECT: thread.some(t => t.type === "plan") closure, [plan, ...thread] spread, dropped.filter((_, i) => i !== planIdx) — no closures/spread in SLA; approximated with explicit reverse/forward scans and in-place buffer removal.
    let planIdx: i64 = -1;
    let i: u64 = dropped.count;
    while i > 0 {
        i = i - 1;
        // if dropped[i].type === "plan" { planIdx = i; break; }
    }
    if planIdx < 0 { return 0; };
    // if thread already has a plan item, return unchanged; else thread = [plan, ...thread], dropped = dropped without planIdx.
    return 0;
}

