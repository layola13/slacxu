    let s_ptr: ptr = STR_PTR(suffix);
    let s_len: u64 = STR_LEN(suffix);
    for j in 0..s_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, s_ptr, j);
        out.bytes[out.len] = b;
        out.len = out.len + 1;
    }
    return 0;
}

