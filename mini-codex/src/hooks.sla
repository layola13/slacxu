// DEFECT: dynamic object — same JSON.stringify object-literal issue as
// preToolUseStdin.
fn postToolUseStdin(sessionId_ptr: ptr, sessionId_len: u64, turnId_ptr: ptr, turnId_len: u64, cwd_ptr: ptr, cwd_len: u64, model_ptr: ptr, model_len: u64, toolName_ptr: ptr, toolName_len: u64, toolInput_node: u64, toolResponse_node: u64, toolUseId_ptr: ptr, toolUseId_len: u64, out: &ByteBuf) -> void {
    let obj = sa_json_object_new();
    sa_json_object_set_string(obj, STR_PTR("session_id"), STR_LEN("session_id"), sessionId_ptr, sessionId_len);
    sa_json_object_set_string(obj, STR_PTR("turn_id"), STR_LEN("turn_id"), turnId_ptr, turnId_len);
    sa_json_object_set_null(obj, STR_PTR("transcript_path"), STR_LEN("transcript_path"));
    sa_json_object_set_string(obj, STR_PTR("cwd"), STR_LEN("cwd"), cwd_ptr, cwd_len);
    sa_json_object_set_string(obj, STR_PTR("hook_event_name"), STR_LEN("hook_event_name"), STR_PTR("PostToolUse"), STR_LEN("PostToolUse"));
    sa_json_object_set_string(obj, STR_PTR("model"), STR_LEN("model"), model_ptr, model_len);
    sa_json_object_set_string(obj, STR_PTR("permission_mode"), STR_LEN("permission_mode"), STR_PTR("default"), STR_LEN("default"));
    sa_json_object_set_string(obj, STR_PTR("tool_name"), STR_LEN("tool_name"), toolName_ptr, toolName_len);
    let ti = toolInput_node;
    if ti == 0 { ti = sa_json_empty_object(); };
    sa_json_object_set_node_key(obj, STR_PTR("tool_input"), STR_LEN("tool_input"), ti);
    let tr = toolResponse_node;
    if tr == 0 { tr = sa_json_empty_object(); };
    sa_json_object_set_node_key(obj, STR_PTR("tool_response"), STR_LEN("tool_response"), tr);
    sa_json_object_set_string(obj, STR_PTR("tool_use_id"), STR_LEN("tool_use_id"), toolUseId_ptr, toolUseId_len);
    buf_reset(out);
    sa_json_stringify_into(obj, out);
}

// TS: export interface ParsedHookOutput {
//   blocked: boolean; blockReason?: string; updatedInput?: unknown;
//   additionalContext?: string; systemMessage?: string; stop?: boolean;
// }
// DEFECT: optional fields + `updatedInput?: unknown` — has_* flags;
// updatedInput kept as a JSON node handle (0 = absent; a JSON null value
// in TS would also be `!== undefined` and thus "present" — divergence:
// node-kind 5 null is still distinguishable via parsed.has_updatedInput).
struct ParsedHookOutput {
    blocked: bool,
    blockReason_ptr: ptr, blockReason_len: u64, has_blockReason: bool,
    updatedInput_node: u64, has_updatedInput: bool,
    additionalContext_ptr: ptr, additionalContext_len: u64, has_additionalContext: bool,
    systemMessage_ptr: ptr, systemMessage_len: u64, has_systemMessage: bool,
    stop: bool, has_stop: bool,
}

// TS: function asRecord(v: unknown): Record<string, unknown> | null {
//   return v && typeof v === "object" && !Array.isArray(v) ? (v as Record<string, unknown>) : null;
// }
// Returns v_node when it is a JSON object node, else 0 (TS null).
// DEFECT: dynamic object — unknown type test via JSON node kind.
fn asRecord(v_node: u64) -> u64 {
    if v_node == 0 { return 0; };
    if sa_json_kind_of(v_node) == 3 { return v_node; };
    return 0;
}

// TS: /** Parse command-hook stdout JSON (Codex output_parser subset). Never throws. */
// TS: export function parseHookOutput(stdout: string, eventName: HookEventName): ParsedHookOutput {
//   const t = (stdout ?? "").trim();
//   if (!t) return { blocked: false };
//   let p: unknown = null;
//   try { p = JSON.parse(t) as unknown; }
//   catch {
//     // Non-JSON stdout = informational warning only (Codex keeps running).
//     return { blocked: false, systemMessage: t.slice(0, 2000) };
//   }
//   const r = asRecord(p);
//   if (!r) return { blocked: false };
//   const out: ParsedHookOutput = { blocked: false };
//   const decision = typeof r.decision === "string" ? r.decision.toLowerCase() : "";
//   const cont = typeof r.continue === "boolean" ? r.continue : undefined;
//   const reason = typeof r.reason === "string" && r.reason.trim() ? r.reason.trim() : undefined;
//   const sysMsg = typeof r.systemMessage === "string" && r.systemMessage.trim()
//     ? r.systemMessage.trim()
//     : (typeof r.system_message === "string" && (r.system_message as string).trim()
//       ? String(r.system_message).trim() : undefined);
//   if (sysMsg) out.systemMessage = sysMsg.slice(0, 2000);
//   if (decision === "block" || decision === "deny" || cont === false) {
//     out.blocked = true;
//     if (reason) out.blockReason = reason.slice(0, 2000);
//   }
//   const specific = asRecord(r.hookSpecificOutput) ?? asRecord(r.hook_specific_output);
//   if (specific) {
//     const add = typeof specific.additionalContext === "string" ? specific.additionalContext
//       : (typeof specific.additional_context === "string" ? String(specific.additional_context) : undefined);
//     if (add && add.trim()) out.additionalContext = add.trim().slice(0, 8000);
//     const upd = (specific.updatedInput ?? specific.updated_input) as unknown;
//     if (eventName === "PreToolUse" && upd !== undefined) out.updatedInput = upd;
//   }
//   // Legacy flat shape: {additionalContext, updatedInput} at top level.
//   if (!out.additionalContext && typeof r.additionalContext === "string" && (r.additionalContext as string).trim()) {
//     out.additionalContext = String(r.additionalContext).trim().slice(0, 8000);
//   }
//   if (eventName === "PreToolUse" && out.updatedInput === undefined && r.updatedInput !== undefined) {
//     out.updatedInput = r.updatedInput as unknown;
//   }
//   return out;
// }
// DEFECT: try/catch around JSON.parse — parse status code branch.
// DEFECT: dynamic object — all field reads are JSON node lookups with
// runtime typeof checks (kind tests); String(...) coercions in TS accept
// only strings on these paths anyway (guarded by typeof), preserved.
// DEFECT: string methods trim/toLowerCase/slice(0, N) — byte scans + capped
// copies into caller-owned buffers inside `out` (pointers reference the
// parsed JSON node's storage, then truncated views via *_len).
// DEFECT: nullish coalescing `asRecord(...) ?? asRecord(...)` and
// `??`/`!== undefined` presence semantics on updatedInput — node 0 =
// absent, has_updatedInput carries presence.
fn parseHookOutput(stdout_ptr: ptr, stdout_len: u64, has_stdout: bool, eventName: u64, out: &ParsedHookOutput) -> void {
    parsed_hook_output_reset(out);
    // t = (stdout ?? "").trim()
    let base_ptr = stdout_ptr;
    let base_len: u64 = 0;
    if has_stdout { base_len = stdout_len; };
    let lo: u64 = 0;
    let hi: u64 = base_len;
    while lo < hi {
        let c: u8 = 0;
        PTR_BYTE_AT(c, base_ptr, lo);
        if c != 32 {
            if c != 9 {
                if c != 10 {
                    if c != 13 { break; };
                };
            };
        };
        lo = lo + 1;
    }
    while hi > lo {
        let c: u8 = 0;
        PTR_BYTE_AT(c, base_ptr, hi - 1);
        if c != 32 {
            if c != 9 {
                if c != 10 {
                    if c != 13 { break; };
                };
            };
        };
        hi = hi - 1;
    }
    if hi <= lo { return; };
    let t_ptr = ptr_add(base_ptr, lo);
    let t_len = hi - lo;
    let p_node: u64 = 0;
    if sa_json_parse(t_ptr, t_len, &p_node) != 0 {
        // Non-JSON stdout = informational warning only (Codex keeps running).
        out.has_systemMessage = true;
        out.systemMessage_ptr = t_ptr;
        out.systemMessage_len = min_u64(t_len, 2000);
        return;
    };
    let r = asRecord(p_node);
    if r == 0 { return; };
    // decision (lowercased)
    let d_ptr: ptr = PTR_NULL();
    let d_len: u64 = 0;
    let decision_block = false;
    let decision_deny = false;
    if sa_json_object_get_string(r, STR_PTR("decision"), STR_LEN("decision"), &d_ptr, &d_len) == 0 {
        decision_block = bytes_eq_lower(d_ptr, d_len, STR_PTR("block"), STR_LEN("block"));
        decision_deny = bytes_eq_lower(d_ptr, d_len, STR_PTR("deny"), STR_LEN("deny"));
    };
    // continue === false ?
    let cont_false = false;
    let cont_node: u64 = 0;
    if sa_json_object_get(r, STR_PTR("continue"), STR_LEN("continue"), &cont_node) == 0 {
        if sa_json_kind_of(cont_node) == 6 {
            if !sa_json_bool_value(cont_node) { cont_false = true; };
        };
    };
    // reason (trimmed, non-empty)
    let reason_ptr: ptr = PTR_NULL();
    let reason_len: u64 = 0;
    let has_reason = json_get_trimmed_string(r, STR_PTR("reason"), STR_LEN("reason"), &reason_ptr, &reason_len);
    // systemMessage ?? system_message (trimmed, non-empty)
    let sys_ptr: ptr = PTR_NULL();
    let sys_len: u64 = 0;
    let has_sys = json_get_trimmed_string(r, STR_PTR("systemMessage"), STR_LEN("systemMessage"), &sys_ptr, &sys_len);
    if !has_sys { has_sys = json_get_trimmed_string(r, STR_PTR("system_message"), STR_LEN("system_message"), &sys_ptr, &sys_len); };
    if has_sys {
        out.has_systemMessage = true;
        out.systemMessage_ptr = sys_ptr;
        out.systemMessage_len = min_u64(sys_len, 2000);
    };
    if decision_block { out.blocked = true; } else {
        if decision_deny { out.blocked = true; } else {
            if cont_false { out.blocked = true; };
        };
    };
    if out.blocked {
        if has_reason {
            out.has_blockReason = true;
            out.blockReason_ptr = reason_ptr;
            out.blockReason_len = min_u64(reason_len, 2000);
        };
    };
    // hookSpecificOutput ?? hook_specific_output
    let specific: u64 = 0;
    let sp_node: u64 = 0;
    if sa_json_object_get(r, STR_PTR("hookSpecificOutput"), STR_LEN("hookSpecificOutput"), &sp_node) == 0 { specific = asRecord(sp_node); };
    if specific == 0 {
        sp_node = 0;
        if sa_json_object_get(r, STR_PTR("hook_specific_output"), STR_LEN("hook_specific_output"), &sp_node) == 0 { specific = asRecord(sp_node); };
    };
    if specific != 0 {
        let add_ptr: ptr = PTR_NULL();
        let add_len: u64 = 0;
        let has_add = false;
        // NOTE: TS does NOT trim-check the camelCase branch before use,
        // it checks `add && add.trim()` afterwards; the snake branch is
        // taken whenever camelCase is not a string at all.
        if sa_json_object_get_string(specific, STR_PTR("additionalContext"), STR_LEN("additionalContext"), &add_ptr, &add_len) == 0 { has_add = true; } else {
            if sa_json_object_get_string(specific, STR_PTR("additional_context"), STR_LEN("additional_context"), &add_ptr, &add_len) == 0 { has_add = true; };
        };
        if has_add {
            // add.trim() non-empty -> out.additionalContext = add.trim().slice(0, 8000)
            let tlo: u64 = 0;
            let thi: u64 = add_len;
            while tlo < thi {
                let c: u8 = 0;
                PTR_BYTE_AT(c, add_ptr, tlo);
                if c != 32 {
                    if c != 9 {
                        if c != 10 {
                            if c != 13 { break; };
                        };
                    };
                };
                tlo = tlo + 1;
            }
            while thi > tlo {
                let c: u8 = 0;
                PTR_BYTE_AT(c, add_ptr, thi - 1);
                if c != 32 {
                    if c != 9 {
                        if c != 10 {
                            if c != 13 { break; };
                        };
                    };
                };
                thi = thi - 1;
            }
            if thi > tlo {
                out.has_additionalContext = true;
                out.additionalContext_ptr = ptr_add(add_ptr, tlo);
                out.additionalContext_len = min_u64(thi - tlo, 8000);
            };
        };
        // upd = specific.updatedInput ?? specific.updated_input
        let upd: u64 = 0;
        let has_upd = false;
        if sa_json_object_get(specific, STR_PTR("updatedInput"), STR_LEN("updatedInput"), &upd) == 0 { has_upd = true; } else {
            if sa_json_object_get(specific, STR_PTR("updated_input"), STR_LEN("updated_input"), &upd) == 0 { has_upd = true; };
        };
        if eventName == 0 {
            if has_upd { out.updatedInput_node = upd; out.has_updatedInput = true; };
        };
    };
    // Legacy flat shape.
    if !out.has_additionalContext {
        let f_ptr: ptr = PTR_NULL();
        let f_len: u64 = 0;
        if json_get_trimmed_string(r, STR_PTR("additionalContext"), STR_LEN("additionalContext"), &f_ptr, &f_len) {
            out.has_additionalContext = true;
            out.additionalContext_ptr = f_ptr;
            out.additionalContext_len = min_u64(f_len, 8000);
        };
    };
    if eventName == 0 {
        if !out.has_updatedInput {
            let upd2: u64 = 0;
            if sa_json_object_get(r, STR_PTR("updatedInput"), STR_LEN("updatedInput"), &upd2) == 0 {
                out.updatedInput_node = upd2;
                out.has_updatedInput = true;
            };
        };
    };
}

// ---------------------------------------------------------------------------
// TS: function runShell(cmd: string, stdin: string, cwd: string, timeoutMs: number): Promise<{ stdout: string; exitCode: number; timedOut: boolean }> {
//   return new Promise((resolve) => {
//     const isWin = process.platform === "win32";
//     // NOTE (Windows): windowsVerbatimArguments disables Node's command-line
//     // quoting/escaping so hook stdout keeps its double quotes intact
//     // (cmd would otherwise receive \" and echo literal backslashes,
//     // breaking JSON hook output). The command is the tail of the line,
//     // so verbatim join is safe here.
//     const child = spawn(isWin ? "cmd.exe" : "sh", isWin ? ["/d", "/s", "/c", cmd] : ["-c", cmd], {
//       cwd: cwd || undefined, stdio: ["pipe", "pipe", "pipe"], windowsHide: true,
//       ...(isWin ? { windowsVerbatimArguments: true } : {}),
//     });
//     let stdout = "";
//     let done = false;
//     const timer = setTimeout(() => {
//       if (done) return;
//       done = true;
//       try { child.kill("SIGKILL"); } catch { /* ignore */ }
//       resolve({ stdout, exitCode: 124, timedOut: true });
//     }, Math.max(500, Math.min(120_000, timeoutMs)));
//     child.stdout?.on("data", (c) => { stdout += String(c); if (stdout.length > 64_000) stdout = stdout.slice(0, 64_000); });
//     child.on("error", () => { if (!done) { done = true; clearTimeout(timer); resolve({ stdout, exitCode: 127, timedOut: false }); } });
//     child.on("close", (code) => { if (!done) { done = true; clearTimeout(timer); resolve({ stdout, exitCode: code ?? 0, timedOut: false }); } });
//     try {
//       child.stdin?.write(stdin);
//       child.stdin?.end();
//     } catch { /* ignore */ }
//   });
// }
// Result struct for the TS anonymous return type { stdout, exitCode, timedOut }.
struct RunShellResult { stdout_ptr: ptr, stdout_len: u64, exitCode: i32, timedOut: bool }
// DEFECT: async — Promise executor + ChildProcess event listeners
// (.on("data"/"error"/"close")) and setTimeout racing completion have no
// SLA counterpart; approximated by the synchronous blocking
// sa_std_process_spawn_bidi extern (spawn + stdin write + stdout drain +
// timeout kill, std already implements this shape for the mini bridge).
// DEFECT: closure — the resolve-once `done` flag and captured stdout
// accumulator are event-loop state; the blocking extern collapses the
// three resolve paths to (exitCode 124 + timedOut) / (127 on spawn error) /
// (child code ?? 0), matching the TS outcomes.
// DEFECT: Node API — node:child_process spawn options (windowsHide,
// windowsVerbatimArguments, cmd.exe /d /s /c vs sh -c) have no sa_std
// equivalent; platform branch kept as a flag read, verbatim-arguments
// semantics lost on Windows.
// DEFECT: stdout cap 64_000 via slice — buffer capacity in `out_stdout`.
fn runShell(cmd_ptr: ptr, cmd_len: u64, stdin_ptr: ptr, stdin_len: u64, cwd_ptr: ptr, cwd_len: u64, timeoutMs: u64, out_stdout: &ByteBuf, out: &RunShellResult) -> void {
    buf_reset(out_stdout);
    let clamped = timeoutMs;
    if clamped < 500 { clamped = 500; };
    if clamped > 120000 { clamped = 120000; };
    let is_win = sa_platform_is_win32();
    // argv: win32 -> ["cmd.exe"-style handled by extern flag] ; else sh -c cmd
    let rc = sa_std_process_spawn_bidi(is_win, cmd_ptr, cmd_len, stdin_ptr, stdin_len, cwd_ptr, cwd_len, clamped, out_stdout);
    out.stdout_ptr = buf_ptr(out_stdout);
    out.stdout_len = out_stdout.len;
    if rc == 124 {
        out.exitCode = 124;
        out.timedOut = true;
        return;
    };
    if rc == 127 {
        out.exitCode = 127;
        out.timedOut = false;
        return;
    };
    out.exitCode = rc;
    out.timedOut = false;
}

// TS: export interface HookExecCtx {
//   sessionId: string; turnId: string; cwd: string; model: string;
//   toolName: string; toolUseId: string; toolInput: Record<string, unknown>;
//   toolResponse?: unknown;
//   /** Raw MCP caller for mcp_tool handlers (bypasses hooks to avoid recursion). */
//   callMcpRaw: (server: string, tool: string, input: Record<string, unknown>, timeoutMs: number) => Promise<string>;
//   sink?: HookEventSink;
// }
// DEFECT: function-typed field callMcpRaw returning Promise<string> — an
// opaque u64 caller id dispatched by call_mcp_raw_dispatch() (fix phase
// registry); sink likewise an id (see HookEventSink DEFECT above).
// DEFECT: dynamic object — toolInput is a JSON node handle; toolResponse
// is an arbitrary node handle (0 = absent/undefined).
struct HookExecCtx {
    sessionId_ptr: ptr, sessionId_len: u64,
    turnId_ptr: ptr, turnId_len: u64,
    cwd_ptr: ptr, cwd_len: u64,
    model_ptr: ptr, model_len: u64,
    toolName_ptr: ptr, toolName_len: u64,
    toolUseId_ptr: ptr, toolUseId_len: u64,
    toolInput_node: u64,
    toolResponse_node: u64, has_toolResponse: bool,
    callMcpRaw_id: u64,
    sink_id: u64, has_sink: bool,
}

// TS: export interface HookExecResult {
//   blocked: boolean; blockReason?: string; updatedInput?: Record<string, unknown>;
//   additionalContexts: string[]; feedback?: string;
//   hookEvents: HookCompletedEvent[];
// }
// DEFECT: arrays of strings / events — fixed capacities (32 contexts,
// 64 completed events, the max matched handlers across 5 files) + lens.
struct HookExecResult {
    blocked: bool,
    blockReason_ptr: ptr, blockReason_len: u64, has_blockReason: bool,
    updatedInput_node: u64, has_updatedInput: bool,
    additionalContexts_ptr: [ptr; 32], additionalContexts_len_field: [u64; 32], additionalContexts_len: u64,
    feedback_ptr: ptr, feedback_len: u64, has_feedback: bool,
    hookEvents: [HookCompletedEvent; 64], hookEvents_len: u64,
}

// TS: function emitStarted(sink: HookEventSink | undefined, run: HookRunSummary, turnId: string | null): void {
//   try { sink?.({ type: "hook_started", event: { turn_id: turnId, run: { ...run } } }); } catch { /* ignore */ }
// }
// DEFECT: callback invocation sink?.(...) with an object literal wrapping a
// spread copy { ...run } — sink id dispatch; the copy is by-value struct
// assignment (TS shallow-copies: entries array is shared there, deep-copied
// here — divergence only if a sink mutates entries, none do).
// DEFECT: try/catch swallowing sink errors — dispatch returns a status
// that is ignored, matching the swallow.
fn emitStarted(sink_id: u64, has_sink: bool, run: &HookRunSummary, turnId_ptr: ptr, turnId_len: u64, has_turnId: bool) -> void {
    if !has_sink { return; };
    let ev = HookEvent { type_code: 0, started: HookStartedEvent { turn_id_ptr: turnId_ptr, turn_id_len: turnId_len, has_turn_id: has_turnId, run: *run }, completed: HookCompletedEvent { turn_id_ptr: PTR_NULL(), turn_id_len: 0, has_turn_id: false, run: *run } };
    // DEFECT: struct literal construction of both union arms — the inactive arm duplicates `run` as filler (TS union has exactly one payload).
    hook_sink_dispatch(sink_id, &ev);
}

// TS: function emitCompleted(sink: HookEventSink | undefined, run: HookRunSummary, turnId: string | null): HookCompletedEvent {
//   const ev: HookCompletedEvent = { turn_id: turnId, run: { ...run } };
//   try { sink?.({ type: "hook_completed", event: ev }); } catch { /* ignore */ }
//   return ev;
// }
// DEFECT: callback + spread copy { ...run } — as emitStarted.
fn emitCompleted(sink_id: u64, has_sink: bool, run: &HookRunSummary, turnId_ptr: ptr, turnId_len: u64, has_turnId: bool, out: &HookCompletedEvent) -> void {
    out.turn_id_ptr = turnId_ptr;
    out.turn_id_len = turnId_len;
    out.has_turn_id = has_turnId;
    out.run = *run;
    if !has_sink { return; };
    let ev = HookEvent { type_code: 1, started: HookStartedEvent { turn_id_ptr: PTR_NULL(), turn_id_len: 0, has_turn_id: false, run: *run }, completed: *out };
    hook_sink_dispatch(sink_id, &ev);
}

// TS: function baseRun(eventName: HookEventName, handler: HookHandlerConfig, index: number, sourcePath: string, source: HookSource, statusMessage?: string): HookRunSummary {
//   const now = Date.now();
//   return {
//     id: uuid(), event_name: eventName,
//     handler_type: handler.type, execution_mode: "sync", scope: "turn",
//     source_path: sourcePath, source, display_order: index,
//     status: "running", status_message: statusMessage ?? null,
//     started_at: now, completed_at: null, duration_ms: null, entries: [],
//   };
// }
// DEFECT: Node API — node:crypto randomUUID for `id` approximated by
// sa_uuid_v4 into caller scratch; Date.now() via sa_time_now_ms.
// DEFECT: object literal return — struct fill; status_message ?? null via
// has_statusMessage (statusMessage param presence flag).
fn baseRun(eventName: u64, handler: &HookHandlerConfig, index: u64, sourcePath_ptr: ptr, sourcePath_len: u64, source: u64, statusMessage_ptr: ptr, statusMessage_len: u64, has_statusMessage: bool, id_scratch: &ByteBuf, out: &HookRunSummary) -> void {
    let now = sa_time_now_ms();
    buf_reset(id_scratch);
    sa_uuid_v4(id_scratch);
    out.id_ptr = buf_ptr(id_scratch);
    out.id_len = id_scratch.len;
    out.event_name = eventName;
    out.handler_type = handler.type_code;
    out.execution_mode = 0;
    out.scope = 0;
    out.source_path_ptr = sourcePath_ptr;
    out.source_path_len = sourcePath_len;
    out.source = source;
    out.display_order = index;
    out.status = 0;
    out.status_message_ptr = statusMessage_ptr;
    out.status_message_len = statusMessage_len;
    out.has_status_message = has_statusMessage;
    out.started_at = now;
    out.completed_at = 0;
    out.has_completed_at = false;
    out.duration_ms = 0;
    out.has_duration_ms = false;
    out.entries_len = 0;
}

// TS: function finishRun(run: HookRunSummary, status: HookRunStatus, entries: HookOutputEntry[], statusMessage?: string): HookRunSummary {
//   const done = Date.now();
//   return {
//     ...run, status, entries,
//     status_message: statusMessage ?? run.status_message ?? null,
//     completed_at: done, duration_ms: Math.max(0, done - run.started_at),
//   };
// }
// Mutates `run` in place (TS returns a new object; all call sites reassign
// `run = finishRun(...)`, so in-place is observably equivalent here).
// DEFECT: object spread { ...run, ... } shallow copy — in-place field
// updates; callers must not retain the pre-finish alias (none do).
// DEFECT: entries array parameter copied by reference in TS — entries are
// appended into run.entries (capacity 32) instead.
fn finishRun(run: &HookRunSummary, status: u64, entries_ptr: &HookOutputEntry, entries_len: u64, statusMessage_ptr: ptr, statusMessage_len: u64, has_statusMessage: bool) -> void {
    let done = sa_time_now_ms();
    run.status = status;
    run.entries_len = 0;
    for i in 0..entries_len {
        if run.entries_len < 32 {
            run.entries[run.entries_len] = entries_ptr[i];
            run.entries_len = run.entries_len + 1;
        };
    }
    if has_statusMessage {
        run.status_message_ptr = statusMessage_ptr;
        run.status_message_len = statusMessage_len;
        run.has_status_message = true;
    };
    run.completed_at = done;
    run.has_completed_at = true;
    let dur = done - run.started_at;
    // Math.max(0, ...) — timestamps are u64 ms here; a backwards clock
    // would underflow, clamped by the sa_time source being monotonic-ish.
    run.duration_ms = dur;
    run.has_duration_ms = true;
}

// ---------------------------------------------------------------------------
// TS: /** Execute matched handlers for one event. Emits HookStarted/HookCompleted per handler (Codex parity). */
// TS: export async function executeHooks(
//   events: HookEvents,
//   files: Array<{ path: string; source: HookSource }>,
//   eventName: HookEventName,
//   ctx: HookExecCtx,
// ): Promise<HookExecResult> {
//   // Attribute each handler to its origin file (user hooks.json first, then
//   // project .codex/hooks.json), preserving Codex display_order semantics.
//   const perFile = cache?.perFile ?? [];
//   const matched: Array<{ group: MatcherGroup; handler: HookHandlerConfig; index: number; sourcePath: string; source: HookSource }> = [];
//   if (perFile.length) {
//     let order = 0;
//     for (const f of perFile) {
//       for (const g of f.events[eventName] ?? []) {
//         const n = g.hooks.length;
//         if (matcherMatches(g.matcher, ctx.toolName)) {
//           for (const h of g.hooks) matched.push({ group: g, handler: h, index: order++, sourcePath: f.path, source: f.source });
//         } else order += n;
//       }
//     }
//   } else {
//     for (const m of selectHookHandlers(events, eventName, ctx.toolName)) {
//       matched.push({
//         ...m,
//         sourcePath: files[0]?.path ?? join(codexHome(), "hooks.json"),
//         source: files[0]?.source ?? "unknown",
//       });
//     }
//   }
//   const res: HookExecResult = { blocked: false, additionalContexts: [], hookEvents: [] };
//   if (!matched.length) return res;
//   for (const m of matched) { ...per-handler body, see branch comments... }
//   return res;
// }
// SLA approximation: synchronous fill of `res`; returns 0.
// DEFECT: async — awaited runShell / ctx.callMcpRaw inside a sequential
// loop; blocking externs preserve the order and the per-handler sequence.
// DEFECT: module-global cache read (cache?.perFile) — state parameter.
// DEFECT: matched array of anonymous objects — parallel fixed arrays
// (capacity 64 handler matches; TS unbounded) with handler structs copied
// by value (TS holds references; handlers are never mutated, equivalent).
// DEFECT: object spread { ...m, sourcePath, source } in the fallback
// branch — fields copied explicitly.
// DEFECT: optional chaining files[0]?.path + ?? join(codexHome(), ...) —
// explicit files_len check + path build.
fn executeHooks(state: &HookModuleState, events: &HookEvents, files_ptr: &HookFileRef, files_len: u64, eventName: u64, ctx: &HookExecCtx, res: &HookExecResult) -> i32 {
    hook_exec_result_reset(res);
    // ---- build matched list ----
    let matched_handlers: [HookHandlerConfig; 64];
    let matched_index: [u64; 64];
    let matched_src_ptr: [ptr; 64];
    let matched_src_len: [u64; 64];
    let matched_source: [u64; 64];
    let matched_len: u64 = 0;
    let used_per_file = false;
    if state.has_cache {
        if state.cache.perFile_len > 0 { used_per_file = true; };
    };
    if used_per_file {
        let order: u64 = 0;
        for fi in 0..state.cache.perFile_len {
            let f = &state.cache.perFile[fi];
            let gcount = hook_events_len(&f.events, eventName);
            for gi in 0..gcount {
                let g = hook_events_group_at(&f.events, eventName, gi);
                let n = g.hooks_len;
                if matcherMatches(g.has_matcher, g.matcher_ptr, g.matcher_len, ctx.toolName_ptr, ctx.toolName_len) {
                    for hi in 0..n {
                        if matched_len < 64 {
                            matched_handlers[matched_len] = g.hooks[hi];
                            matched_index[matched_len] = order;
                            matched_src_ptr[matched_len] = f.path_ptr;
                            matched_src_len[matched_len] = f.path_len;
                            matched_source[matched_len] = f.source;
                            matched_len = matched_len + 1;
                        };
                        order = order + 1;
                    }
                } else { order = order + n; };
            }
        }
    } else {
        let sel_gi: [u64; 64];
        let sel_hi: [u64; 64];
        let sel_index: [u64; 64];
        let sel_count = selectHookHandlers(events, eventName, ctx.toolName_ptr, ctx.toolName_len, sel_gi, sel_hi, sel_index);
        // fallback source: files[0] or join(codexHome(), "hooks.json") / "unknown"
        let fb_ptr: ptr = PTR_NULL();
        let fb_len: u64 = 0;
        let fb_source: u64 = 2;
        let fb_buf = ByteBuf { bytes: [0u8; 4096], len: 0 };
        if files_len > 0 {
            fb_ptr = files_ptr[0].path_ptr;
            fb_len = files_ptr[0].path_len;
            fb_source = files_ptr[0].source;
        } else {
            codexHome(&fb_buf);
            buf_append_lit(&fb_buf, STR_PTR("/hooks.json"), STR_LEN("/hooks.json"));
            fb_ptr = buf_ptr(&fb_buf);
            fb_len = fb_buf.len;
        };
        for si in 0..sel_count {
            let g = hook_events_group_at(events, eventName, sel_gi[si]);
            if matched_len < 64 {
                matched_handlers[matched_len] = g.hooks[sel_hi[si]];
                matched_index[matched_len] = sel_index[si];
                matched_src_ptr[matched_len] = fb_ptr;
                matched_src_len[matched_len] = fb_len;
                matched_source[matched_len] = fb_source;
                matched_len = matched_len + 1;
            };
        }
    };
    if matched_len == 0 { return 0; };
    // ---- per-handler execution ----
    for mi in 0..matched_len {
        let h = &matched_handlers[mi];
        // const statusMsg = (h.type === "command" || h.type === "mcp_tool") ? (h.statusMessage ?? null) : null;
        let has_status_msg = false;
        if h.type_code == 0 { has_status_msg = h.has_statusMessage; };
        if h.type_code == 1 { has_status_msg = h.has_statusMessage; };
        let run = hook_run_new();
        let id_scratch = ByteBuf { bytes: [0u8; 64], len: 0 };
        if has_status_msg {
            baseRun(eventName, h, matched_index[mi], matched_src_ptr[mi], matched_src_len[mi], matched_source[mi], h.statusMessage_ptr, h.statusMessage_len, true, &id_scratch, &run);
        } else {
            baseRun(eventName, h, matched_index[mi], matched_src_ptr[mi], matched_src_len[mi], matched_source[mi], PTR_NULL(), 0, false, &id_scratch, &run);
        };
        emitStarted(ctx.sink_id, ctx.has_sink, &run, ctx.turnId_ptr, ctx.turnId_len, true);
        let started = sa_time_now_ms();
        // DEFECT: try/catch wrapping the whole per-handler body — SLA has
        // no exceptions; branch status codes stand in, and the TS catch
        // (finishRun "failed" with e.message sliced to 2000) is
        // approximated by execute_hooks_fail() at the points that can throw
        // in TS (render/parse of dynamic values); pure byte work cannot.
        if h.type_code == 0 {
            execute_hooks_command(state, eventName, ctx, h, &run, res);
        } else {
            if h.type_code == 1 {
                execute_hooks_mcp(eventName, ctx, h, &run, res, started);
            } else {
                // prompt/agent handlers: parsed as Codex internal only; mini cannot run them.
                // text: `hook type '${h.type}' is not supported by mini-codex (Codex parity: needs app-server); ignoring`
                let entries: [HookOutputEntry; 32];
                let entries_len: u64 = 0;
                let msg = ByteBuf { bytes: [0u8; 512], len: 0 };
                buf_append_lit(&msg, STR_PTR("hook type '"), STR_LEN("hook type '"));
                let tn_len: u64 = 0;
                let tn_ptr = hook_handler_type_name(h.type_code, &tn_len);
                buf_append_slice(&msg, tn_ptr, 0, tn_len);
                buf_append_lit(&msg, STR_PTR("' is not supported by mini-codex (Codex parity: needs app-server); ignoring"), STR_LEN("' is not supported by mini-codex (Codex parity: needs app-server); ignoring"));
                push_entry(&entries, &entries_len, 4, buf_ptr(&msg), msg.len);
                finishRun(&run, 2, &entries, entries_len, PTR_NULL(), 0, false);
                let completed = hook_completed_new();
                emitCompleted(ctx.sink_id, ctx.has_sink, &run, ctx.turnId_ptr, ctx.turnId_len, true, &completed);
                hook_exec_push_completed(res, &completed);
            };
        };
    }
    return 0;
}

// Command-handler branch of executeHooks (extracted — SLA fn scope).
// TS body:
//   const command = process.platform === "win32" && h.commandWindows ? h.commandWindows : h.command;
//   const stdin = eventName === "PreToolUse" ? preToolUseStdin({...}) : postToolUseStdin({...});
//   const timeoutMs = Math.max(500, Math.min(120_000, Math.floor(((h.timeout ?? 30)) * 1000)));
//   const r = await runShell(command, stdin, ctx.cwd, timeoutMs);
//   if (r.timedOut) { run = finishRun(run, "failed", [{ kind: "error", text: `hook timed out after ${timeoutMs}ms` }]); res.hookEvents.push(emitCompleted(...)); continue; }
//   if (r.exitCode !== 0 && !r.stdout.trim()) { ... "failed", `hook exited with code ${r.exitCode}` ... continue; }
//   const parsed = parseHookOutput(r.stdout, eventName);
//   const entries: HookOutputEntry[] = [];
//   if (parsed.systemMessage) entries.push({ kind: "warning", text: parsed.systemMessage });
//   if (parsed.additionalContext) { entries.push({ kind: "context", text: parsed.additionalContext.slice(0, 500) }); res.additionalContexts.push(parsed.additionalContext); }
//   if (parsed.blocked) { entries.push({ kind: "feedback", text: parsed.blockReason ?? `${eventName} hook blocked ${ctx.toolName}` });
//     run = finishRun(run, "blocked", entries, parsed.blockReason ?? "blocked by hook"); ...;
//     res.blocked = true; res.blockReason = parsed.blockReason ?? `Blocked by ${eventName} hook (${ctx.toolName}).`;
//     if (eventName === "PostToolUse" && parsed.blockReason) res.feedback = parsed.blockReason;
//     continue; }   // (remaining hooks still run — the outer loop continues)
//   if (eventName === "PreToolUse" && parsed.updatedInput !== undefined) {
//     const upd = asRecord(parsed.updatedInput);
//     if (upd) { res.updatedInput = upd; entries.push({ kind: "feedback", text: "hook rewrote tool input" }); }
//     else { entries.push({ kind: "error", text: "hook updatedInput must be an object; ignored" }); } }
//   if (r.exitCode !== 0) { run = finishRun(run, "failed", [...entries, { kind: "error", text: `hook exited with code ${r.exitCode}` }]); }
//   else { run = finishRun(run, "completed", entries); }
//   res.hookEvents.push(emitCompleted(ctx.sink, run, ctx.turnId));
// DEFECT: template literals (`hook timed out after ${timeoutMs}ms`, the
// blocked fallback texts with ${eventName}/${ctx.toolName}) — assembled
// with buf_append_lit/buf_append_u64/buf_append_slice.
// DEFECT: spread [...entries, newEntry] on the failed path — push_entry.
// DEFECT: Node API — process.platform === "win32" via sa_platform_is_win32.
fn execute_hooks_command(state: &HookModuleState, eventName: u64, ctx: &HookExecCtx, h: &HookHandlerConfig, run: &HookRunSummary, res: &HookExecResult) -> void {
    let cmd_ptr = h.command_ptr;
    let cmd_len = h.command_len;
    if sa_platform_is_win32() {
        if h.has_commandWindows { cmd_ptr = h.commandWindows_ptr; cmd_len = h.commandWindows_len; };
    };
    let stdin_buf = ByteBuf { bytes: [0u8; 262144], len: 0 };
    // DEFECT: stdin buffer capacity 262144 — TS strings unbounded (tool_input serialisation).
    if eventName == 0 {
        preToolUseStdin(ctx.sessionId_ptr, ctx.sessionId_len, ctx.turnId_ptr, ctx.turnId_len, ctx.cwd_ptr, ctx.cwd_len, ctx.model_ptr, ctx.model_len, ctx.toolName_ptr, ctx.toolName_len, ctx.toolInput_node, ctx.toolUseId_ptr, ctx.toolUseId_len, &stdin_buf);
    } else {
        postToolUseStdin(ctx.sessionId_ptr, ctx.sessionId_len, ctx.turnId_ptr, ctx.turnId_len, ctx.cwd_ptr, ctx.cwd_len, ctx.model_ptr, ctx.model_len, ctx.toolName_ptr, ctx.toolName_len, ctx.toolInput_node, ctx.toolResponse_node, ctx.toolUseId_ptr, ctx.toolUseId_len, &stdin_buf);
    };
    let timeout_s: f64 = 30.0;
    if h.has_timeout { timeout_s = h.timeout_s; };
    let timeout_ms = clamp_u64(f64_ms(timeout_s), 500, 120000);
    let stdout_buf = ByteBuf { bytes: [0u8; 65536], len: 0 };
    let r = RunShellResult { stdout_ptr: PTR_NULL(), stdout_len: 0, exitCode: 0, timedOut: false };
    // DEFECT: stdout buffer capacity 65536 matches the TS 64_000 slice cap approximately (TS caps at 64_000 chars mid-stream).
    runShell(cmd_ptr, cmd_len, buf_ptr(&stdin_buf), stdin_buf.len, ctx.cwd_ptr, ctx.cwd_len, timeout_ms, &stdout_buf, &r);
    let entries: [HookOutputEntry; 32];
    let entries_len: u64 = 0;
    let completed = hook_completed_new();
    if r.timedOut {
        let msg = ByteBuf { bytes: [0u8; 128], len: 0 };
        buf_append_lit(&msg, STR_PTR("hook timed out after "), STR_LEN("hook timed out after "));
        buf_append_u64(&msg, timeout_ms);
        buf_append_lit(&msg, STR_PTR("ms"), STR_LEN("ms"));
        push_entry(&entries, &entries_len, 4, buf_ptr(&msg), msg.len);
        finishRun(run, 2, &entries, entries_len, PTR_NULL(), 0, false);
        emitCompleted(ctx.sink_id, ctx.has_sink, run, ctx.turnId_ptr, ctx.turnId_len, true, &completed);
        hook_exec_push_completed(res, &completed);
        return;
    };
    if r.exitCode != 0 {
        if !slice_nonempty_trimmed(r.stdout_ptr, 0, r.stdout_len) {
            let msg = ByteBuf { bytes: [0u8; 128], len: 0 };
            buf_append_lit(&msg, STR_PTR("hook exited with code "), STR_LEN("hook exited with code "));
            buf_append_i32(&msg, r.exitCode);
            push_entry(&entries, &entries_len, 4, buf_ptr(&msg), msg.len);
            finishRun(run, 2, &entries, entries_len, PTR_NULL(), 0, false);
            emitCompleted(ctx.sink_id, ctx.has_sink, run, ctx.turnId_ptr, ctx.turnId_len, true, &completed);
            hook_exec_push_completed(res, &completed);
            return;
        };
    };
    let parsed = parsed_hook_output_new();
    parseHookOutput(r.stdout_ptr, r.stdout_len, true, eventName, &parsed);
    if parsed.has_systemMessage { push_entry(&entries, &entries_len, 0, parsed.systemMessage_ptr, parsed.systemMessage_len); };
    if parsed.has_additionalContext {
        push_entry(&entries, &entries_len, 3, parsed.additionalContext_ptr, min_u64(parsed.additionalContext_len, 500));
        hook_exec_push_context(res, parsed.additionalContext_ptr, parsed.additionalContext_len);
    };
    if parsed.blocked {
        // feedback text: parsed.blockReason ?? `${eventName} hook blocked ${ctx.toolName}`
        if parsed.has_blockReason {
            push_entry(&entries, &entries_len, 2, parsed.blockReason_ptr, parsed.blockReason_len);
        } else {
            let msg = ByteBuf { bytes: [0u8; 512], len: 0 };
            let en_len: u64 = 0;
            let en_ptr = HOOK_EVENT_NAMES_at(eventName, &en_len);
            buf_append_slice(&msg, en_ptr, 0, en_len);
            buf_append_lit(&msg, STR_PTR(" hook blocked "), STR_LEN(" hook blocked "));
            buf_append_slice(&msg, ctx.toolName_ptr, 0, ctx.toolName_len);
            push_entry(&entries, &entries_len, 2, buf_ptr(&msg), msg.len);
        };
        if parsed.has_blockReason {
            finishRun(run, 3, &entries, entries_len, parsed.blockReason_ptr, parsed.blockReason_len, true);
        } else {
            finishRun(run, 3, &entries, entries_len, STR_PTR("blocked by hook"), STR_LEN("blocked by hook"), true);
        };
        emitCompleted(ctx.sink_id, ctx.has_sink, run, ctx.turnId_ptr, ctx.turnId_len, true, &completed);
        hook_exec_push_completed(res, &completed);
        res.blocked = true;
        if parsed.has_blockReason {
            res.blockReason_ptr = parsed.blockReason_ptr;
            res.blockReason_len = parsed.blockReason_len;
            res.has_blockReason = true;
        } else {
            // `Blocked by ${eventName} hook (${ctx.toolName}).`
            let msg = ByteBuf { bytes: [0u8; 512], len: 0 };
            buf_append_lit(&msg, STR_PTR("Blocked by "), STR_LEN("Blocked by "));
            let en_len: u64 = 0;
            let en_ptr = HOOK_EVENT_NAMES_at(eventName, &en_len);
            buf_append_slice(&msg, en_ptr, 0, en_len);
            buf_append_lit(&msg, STR_PTR(" hook ("), STR_LEN(" hook ("));
            buf_append_slice(&msg, ctx.toolName_ptr, 0, ctx.toolName_len);
            buf_append_lit(&msg, STR_PTR(")."), STR_LEN(")."));
            res.blockReason_ptr = buf_ptr(&msg);
            res.blockReason_len = msg.len;
            res.has_blockReason = true;
        };
        if eventName == 2 {
            if parsed.has_blockReason { res.feedback_ptr = parsed.blockReason_ptr; res.feedback_len = parsed.blockReason_len; res.has_feedback = true; };
        };
        return;
    };
    if eventName == 0 {
        if parsed.has_updatedInput {
            let upd = asRecord(parsed.updatedInput_node);
            if upd != 0 {
                res.updatedInput_node = upd;
                res.has_updatedInput = true;
                push_entry(&entries, &entries_len, 2, STR_PTR("hook rewrote tool input"), STR_LEN("hook rewrote tool input"));
            } else {
                push_entry(&entries, &entries_len, 4, STR_PTR("hook updatedInput must be an object; ignored"), STR_LEN("hook updatedInput must be an object; ignored"));
            };
        };
    };
    if r.exitCode != 0 {
        let msg = ByteBuf { bytes: [0u8; 128], len: 0 };
        buf_append_lit(&msg, STR_PTR("hook exited with code "), STR_LEN("hook exited with code "));
        buf_append_i32(&msg, r.exitCode);
        push_entry(&entries, &entries_len, 4, buf_ptr(&msg), msg.len);
        finishRun(run, 2, &entries, entries_len, PTR_NULL(), 0, false);
    } else {
        finishRun(run, 1, &entries, entries_len, PTR_NULL(), 0, false);
    };
    emitCompleted(ctx.sink_id, ctx.has_sink, run, ctx.turnId_ptr, ctx.turnId_len, true, &completed);
    hook_exec_push_completed(res, &completed);
}

// mcp_tool-handler branch of executeHooks (extracted — SLA fn scope).
// TS body:
//   const timeoutMs = Math.max(500, Math.min(300_000, Math.floor(((h.timeout ?? 60)) * 1000)));
//   let rendered: Record<string, unknown>;
//   try {
//     rendered = renderMcpHookInput(h.input, {
//       tool_name: ctx.toolName, tool_use_id: ctx.toolUseId, cwd: ctx.cwd,
//       session_id: ctx.sessionId, turn_id: ctx.turnId,
//       server: h.server, tool: h.tool, tool_input: ctx.toolInput,
//     });
//   } catch (e) {
//     run = finishRun(run, "failed", [{ kind: "error", text: e instanceof Error ? e.message : String(e) }]);
//     res.hookEvents.push(emitCompleted(ctx.sink, run, ctx.turnId));
//     continue;
//   }
//   try {
//     const text = await ctx.callMcpRaw(h.server, h.tool, rendered, timeoutMs);
//     // MCP hook output uses command-hook semantics: parse JSON decisions from text.
//     const parsed = parseHookOutput(text, eventName);
//     const entries: HookOutputEntry[] = [];
//     if (parsed.systemMessage) entries.push({ kind: "warning", text: parsed.systemMessage });
//     if (parsed.additionalContext) {
//       entries.push({ kind: "context", text: parsed.additionalContext.slice(0, 500) });
//       res.additionalContexts.push(parsed.additionalContext);
//     } else if (text.trim() && text.trim() !== "(empty MCP result)") {
//       // Non-decision MCP output still counts as hook output (context, truncated).
//       entries.push({ kind: "context", text: text.slice(0, 500) });
//     }
//     if (parsed.blocked) {
//       entries.push({ kind: "feedback", text: parsed.blockReason ?? `${eventName} MCP hook blocked ${ctx.toolName}` });
//       run = finishRun(run, "blocked", entries, parsed.blockReason ?? "blocked by MCP hook");
//       res.hookEvents.push(emitCompleted(ctx.sink, run, ctx.turnId));
//       res.blocked = true;
//       res.blockReason = parsed.blockReason ?? `Blocked by ${eventName} MCP hook (${h.server}/${h.tool}).`;
//       continue;
//     }
//     if (eventName === "PreToolUse" && parsed.updatedInput !== undefined) {
//       const upd = asRecord(parsed.updatedInput);
//       if (upd) res.updatedInput = upd;
//     }
//     run = finishRun(run, "completed", entries);
//     res.hookEvents.push(emitCompleted(ctx.sink, run, ctx.turnId));
//   } catch (e) {
//     const msg = e instanceof Error ? e.message : String(e);
//     run = finishRun(run, "failed", [{ kind: "error", text: msg.slice(0, 2000) }]);
//     res.hookEvents.push(emitCompleted(ctx.sink, run, ctx.turnId));
//   }
//   void started;
// DEFECT: async — await ctx.callMcpRaw (function field returning
// Promise<string>) via call_mcp_raw_dispatch blocking call.
// DEFECT: try/catch + instanceof Error ? e.message : String(e) — dispatch
// status + error text buffer; the renderMcpHookInput throw is the 0
// sentinel with the fixed Codex-parity message.
// DEFECT: template literals in blocked fallback texts — buf assembly.
// DEFECT: `void started` — TS marks the outer `started` timestamp unused
// on this path; the parameter is accepted and ignored here identically.
fn execute_hooks_mcp(eventName: u64, ctx: &HookExecCtx, h: &HookHandlerConfig, run: &HookRunSummary, res: &HookExecResult, started: u64) -> void {
    let timeout_s: f64 = 60.0;
    if h.has_timeout { timeout_s = h.timeout_s; };
    let timeout_ms = clamp_u64(f64_ms(timeout_s), 500, 300000);
    let entries: [HookOutputEntry; 32];
    let entries_len: u64 = 0;
    let completed = hook_completed_new();
    let tctx = HookTemplateCtx { tool_name_ptr: ctx.toolName_ptr, tool_name_len: ctx.toolName_len, tool_use_id_ptr: ctx.toolUseId_ptr, tool_use_id_len: ctx.toolUseId_len, cwd_ptr: ctx.cwd_ptr, cwd_len: ctx.cwd_len, session_id_ptr: ctx.sessionId_ptr, session_id_len: ctx.sessionId_len, turn_id_ptr: ctx.turnId_ptr, turn_id_len: ctx.turnId_len, server_ptr: h.server_ptr, server_len: h.server_len, tool_ptr: h.tool_ptr, tool_len: h.tool_len, tool_input_node: ctx.toolInput_node };
    let scratch = ByteBuf { bytes: [0u8; 262144], len: 0 };
    let rendered = renderMcpHookInput(h.input_node, &tctx, &scratch);
    if rendered == 0 {
        push_entry(&entries, &entries_len, 4, STR_PTR("MCP hook input must be representable as TOML (null rejected, Codex parity)"), STR_LEN("MCP hook input must be representable as TOML (null rejected, Codex parity)"));
        finishRun(run, 2, &entries, entries_len, PTR_NULL(), 0, false);
        emitCompleted(ctx.sink_id, ctx.has_sink, run, ctx.turnId_ptr, ctx.turnId_len, true, &completed);
        hook_exec_push_completed(res, &completed);
        return;
    };
    let text_buf = ByteBuf { bytes: [0u8; 262144], len: 0 };
    let err_buf = ByteBuf { bytes: [0u8; 4096], len: 0 };
    let call_rc = call_mcp_raw_dispatch(ctx.callMcpRaw_id, h.server_ptr, h.server_len, h.tool_ptr, h.tool_len, rendered, timeout_ms, &text_buf, &err_buf);
    if call_rc != 0 {
        push_entry(&entries, &entries_len, 4, buf_ptr(&err_buf), min_u64(err_buf.len, 2000));
        finishRun(run, 2, &entries, entries_len, PTR_NULL(), 0, false);
        emitCompleted(ctx.sink_id, ctx.has_sink, run, ctx.turnId_ptr, ctx.turnId_len, true, &completed);
        hook_exec_push_completed(res, &completed);
        return;
    };
    let parsed = parsed_hook_output_new();
    parseHookOutput(buf_ptr(&text_buf), text_buf.len, true, eventName, &parsed);
    if parsed.has_systemMessage { push_entry(&entries, &entries_len, 0, parsed.systemMessage_ptr, parsed.systemMessage_len); };
    if parsed.has_additionalContext {
        push_entry(&entries, &entries_len, 3, parsed.additionalContext_ptr, min_u64(parsed.additionalContext_len, 500));
        hook_exec_push_context(res, parsed.additionalContext_ptr, parsed.additionalContext_len);
    } else {
        if slice_nonempty_trimmed(buf_ptr(&text_buf), 0, text_buf.len) {
            if !bytes_eq(buf_ptr(&text_buf), text_buf.len, STR_PTR("(empty MCP result)"), STR_LEN("(empty MCP result)")) {
                // NOTE: TS compares text.trim() to "(empty MCP result)" — trimmed text vs the literal; the compare here is on the untrimmed buffer (divergence for padded results).
                // DEFECT: string trim + equality — approximated on the raw buffer.
                push_entry(&entries, &entries_len, 3, buf_ptr(&text_buf), min_u64(text_buf.len, 500));
            };
        };
    };
    if parsed.blocked {
        if parsed.has_blockReason {
            push_entry(&entries, &entries_len, 2, parsed.blockReason_ptr, parsed.blockReason_len);
        } else {
            let msg = ByteBuf { bytes: [0u8; 512], len: 0 };
            let en_len: u64 = 0;
            let en_ptr = HOOK_EVENT_NAMES_at(eventName, &en_len);
            buf_append_slice(&msg, en_ptr, 0, en_len);
            buf_append_lit(&msg, STR_PTR(" MCP hook blocked "), STR_LEN(" MCP hook blocked "));
            buf_append_slice(&msg, ctx.toolName_ptr, 0, ctx.toolName_len);
            push_entry(&entries, &entries_len, 2, buf_ptr(&msg), msg.len);
        };
        if parsed.has_blockReason {
            finishRun(run, 3, &entries, entries_len, parsed.blockReason_ptr, parsed.blockReason_len, true);
        } else {
            finishRun(run, 3, &entries, entries_len, STR_PTR("blocked by MCP hook"), STR_LEN("blocked by MCP hook"), true);
        };
        emitCompleted(ctx.sink_id, ctx.has_sink, run, ctx.turnId_ptr, ctx.turnId_len, true, &completed);
        hook_exec_push_completed(res, &completed);
        res.blocked = true;
        if parsed.has_blockReason {
            res.blockReason_ptr = parsed.blockReason_ptr;
            res.blockReason_len = parsed.blockReason_len;
            res.has_blockReason = true;
        } else {
            // `Blocked by ${eventName} MCP hook (${h.server}/${h.tool}).`
            let msg = ByteBuf { bytes: [0u8; 512], len: 0 };
            buf_append_lit(&msg, STR_PTR("Blocked by "), STR_LEN("Blocked by "));
            let en_len: u64 = 0;
            let en_ptr = HOOK_EVENT_NAMES_at(eventName, &en_len);
            buf_append_slice(&msg, en_ptr, 0, en_len);
            buf_append_lit(&msg, STR_PTR(" MCP hook ("), STR_LEN(" MCP hook ("));
            buf_append_slice(&msg, h.server_ptr, 0, h.server_len);
            buf_append_lit(&msg, STR_PTR("/"), STR_LEN("/"));
            buf_append_slice(&msg, h.tool_ptr, 0, h.tool_len);
            buf_append_lit(&msg, STR_PTR(")."), STR_LEN(")."));
            res.blockReason_ptr = buf_ptr(&msg);
            res.blockReason_len = msg.len;
            res.has_blockReason = true;
        };
        return;
    };
    if eventName == 0 {
        if parsed.has_updatedInput {
            let upd = asRecord(parsed.updatedInput_node);
            if upd != 0 { res.updatedInput_node = upd; res.has_updatedInput = true; };
        };
    };
    finishRun(run, 1, &entries, entries_len, PTR_NULL(), 0, false);
    emitCompleted(ctx.sink_id, ctx.has_sink, run, ctx.turnId_ptr, ctx.turnId_len, true, &completed);
    hook_exec_push_completed(res, &completed);
}

// ---------------------------------------------------------------------------
// TS: export function defaultHookSink(): HookEventSink {
//   return (e) => {
//     try {
//       const run = e.event.run;
//       const id = run.id.slice(0, 8);
//       if (e.type === "hook_started") {
//         process.stderr.write(`[hook:${run.event_name}:${run.handler_type}:${id}] start ${run.source_path} order=${run.display_order}\n`);
//       } else {
//         process.stderr.write(`[hook:${run.event_name}:${run.handler_type}:${id}] ${run.status} ${run.duration_ms ?? 0}ms` +
//           (run.status_message ? ` ${run.status_message.slice(0, 200)}` : "") + "\n");
//       }
//     } catch { /* ignore */ }
//   };
// }
// The returned sink is registered under the fixed id 1.
fn defaultHookSink() -> u64 { return 1; }

// Body of the default sink (invoked via hook_sink_dispatch for id 1).
// DEFECT: closure — the returned arrow function capturing nothing but
// closing over module scope; a plain function here.
// DEFECT: Node API — process.stderr.write via sa_stderr_write extern.
// DEFECT: template literals with ${} interpolation + string concatenation
// — buf assembly; event_name/handler_type/status print as their literal
// names (TS prints the string values; codes map back via *_name helpers).
// DEFECT: try/catch swallowing formatting errors — writes are status-
// returning and ignored identically.
fn default_hook_sink_handle(e: &HookEvent) -> void {
    let run: &HookRunSummary = &e.completed.run;
    let is_started = false;
    if e.type_code == 0 { run = &e.started.run; is_started = true; };
    let line = ByteBuf { bytes: [0u8; 4096], len: 0 };
    // DEFECT: line buffer capacity 4096 — TS builds unbounded strings (source_path can be long).
    buf_append_lit(&line, STR_PTR("[hook:"), STR_LEN("[hook:"));
    let en_len: u64 = 0;
    let en_ptr = HOOK_EVENT_NAMES_at(run.event_name, &en_len);
    buf_append_slice(&line, en_ptr, 0, en_len);
    buf_append_lit(&line, STR_PTR(":"), STR_LEN(":"));
    let ht_len: u64 = 0;
    let ht_ptr = hook_handler_type_name(run.handler_type, &ht_len);
    buf_append_slice(&line, ht_ptr, 0, ht_len);
    buf_append_lit(&line, STR_PTR(":"), STR_LEN(":"));
    buf_append_slice(&line, run.id_ptr, 0, min_u64(run.id_len, 8));
    buf_append_lit(&line, STR_PTR("]"), STR_LEN("]"));
    if is_started {
        buf_append_lit(&line, STR_PTR(" start "), STR_LEN(" start "));
        buf_append_slice(&line, run.source_path_ptr, 0, run.source_path_len);
        buf_append_lit(&line, STR_PTR(" order="), STR_LEN(" order="));
        buf_append_u64(&line, run.display_order);
        buf_append_lit(&line, STR_PTR("\n"), STR_LEN("\n"));
    } else {
        buf_append_lit(&line, STR_PTR(" "), STR_LEN(" "));
        let st_len: u64 = 0;
        let st_ptr = hook_run_status_name(run.status, &st_len);
        buf_append_slice(&line, st_ptr, 0, st_len);
        buf_append_lit(&line, STR_PTR(" "), STR_LEN(" "));
        let dur: u64 = 0;
        if run.has_duration_ms { dur = run.duration_ms; };
        buf_append_u64(&line, dur);
        buf_append_lit(&line, STR_PTR("ms"), STR_LEN("ms"));
        if run.has_status_message {
            if run.status_message_len > 0 {
                buf_append_lit(&line, STR_PTR(" "), STR_LEN(" "));
                buf_append_slice(&line, run.status_message_ptr, 0, min_u64(run.status_message_len, 200));
            };
        };
        buf_append_lit(&line, STR_PTR("\n"), STR_LEN("\n"));
    };
    sa_stderr_write(buf_ptr(&line), line.len);
}

// TS: export function describeHooks(events: HookEvents): string {
//   const parts: string[] = [];
//   for (const n of ["PreToolUse", "PostToolUse"] as HookEventName[]) {
//     const g = events[n] ?? [];
//     const c = g.reduce((a, x) => a + x.hooks.length, 0);
//     if (c) parts.push(`${n}:${c}`);
//   }
//   return parts.length ? parts.join(" ") : "none";
// }
// Writes the result into out, returns its length.
// DEFECT: closure — Array.reduce with an accumulator arrow function; loop.
// DEFECT: dynamic key access events[n] over a literal tuple cast
// `as HookEventName[]` — the two event codes 0 and 2 are unrolled.
// DEFECT: template literal `${n}:${c}` + join(" ") — buf assembly.
fn describeHooks(events: &HookEvents, out: &ByteBuf) -> u64 {
    buf_reset(out);
    let parts: u64 = 0;
    for k in 0..2 {
        let event_code: u64 = 0;
        if k == 1 { event_code = 2; };
        let c: u64 = 0;
        let gcount = hook_events_len(events, event_code);
        for gi in 0..gcount {
            let g = hook_events_group_at(events, event_code, gi);
            c = c + g.hooks_len;
        }
        if c > 0 {
            if parts > 0 { buf_append_lit(out, STR_PTR(" "), STR_LEN(" ")); };
            let n_len: u64 = 0;
            let n_ptr = HOOK_EVENT_NAMES_at(event_code, &n_len);
            buf_append_slice(out, n_ptr, 0, n_len);
            buf_append_lit(out, STR_PTR(":"), STR_LEN(":"));
            buf_append_u64(out, c);
            parts = parts + 1;
        };
    }
    if parts == 0 {
        buf_append_lit(out, STR_PTR("none"), STR_LEN("none"));
    };
    return out.len;
}

// ---------------------------------------------------------------------------
// Unit-local helpers (no TS counterparts — they materialise the container
// operations the TS gets from plain objects/arrays; kept together so the
// fix phase can replace them with real sa_std / JSON-layer calls).
// DEFECT: dynamic object — HookEvents container helpers stand in for plain
// object property access; several are slot/push plumbing over the fixed
// arrays and are only sketched (pointer identity), not full copies.
// ---------------------------------------------------------------------------

fn hook_events_new() -> HookEvents {
    let e: HookEvents;
    hook_events_reset(&e);
    return e;
}

fn hook_events_reset(e: &HookEvents) -> void {
    e.groups0_len = 0;
    e.groups1_len = 0;
    e.groups2_len = 0;
    e.groups3_len = 0;
    e.groups4_len = 0;
    e.groups5_len = 0;
    e.groups6_len = 0;
    e.groups7_len = 0;
    e.groups8_len = 0;
    e.groups9_len = 0;
    e.groups10_len = 0;
    e.groups11_len = 0;
}

fn hook_events_any(e: &HookEvents) -> bool {
    for i in 0..12 {
        if hook_events_len(e, i) > 0 { return true; };
    }
    return false;
}

fn hook_events_copy(dst: &HookEvents, src: &HookEvents) -> void {
    *dst = *src;
}

// Returns &MatcherGroup for (eventName, gi) — caller guarantees gi < len.
fn hook_events_group_at(e: &HookEvents, eventName: u64, gi: u64) -> &MatcherGroup {
    if eventName == 0 { return &e.groups0[gi]; };
    if eventName == 1 { return &e.groups1[gi]; };
    if eventName == 2 { return &e.groups2[gi]; };
    if eventName == 3 { return &e.groups3[gi]; };
    if eventName == 4 { return &e.groups4[gi]; };
    if eventName == 5 { return &e.groups5[gi]; };
    if eventName == 6 { return &e.groups6[gi]; };
    if eventName == 7 { return &e.groups7[gi]; };
    if eventName == 8 { return &e.groups8[gi]; };
    if eventName == 9 { return &e.groups9[gi]; };
    if eventName == 10 { return &e.groups10[gi]; };
    return &e.groups11[gi];
}

fn hook_events_set_len(e: &HookEvents, eventName: u64, n: u64) -> void {
    if eventName == 0 { e.groups0_len = n; return; };
    if eventName == 1 { e.groups1_len = n; return; };
    if eventName == 2 { e.groups2_len = n; return; };
    if eventName == 3 { e.groups3_len = n; return; };
    if eventName == 4 { e.groups4_len = n; return; };
    if eventName == 5 { e.groups5_len = n; return; };
    if eventName == 6 { e.groups6_len = n; return; };
    if eventName == 7 { e.groups7_len = n; return; };
    if eventName == 8 { e.groups8_len = n; return; };
    if eventName == 9 { e.groups9_len = n; return; };
    if eventName == 10 { e.groups10_len = n; return; };
    e.groups11_len = n;
}

// Appends a zeroed MatcherGroup slot for eventName, returns it (0 if full).
fn hook_events_group_push_slot(e: &HookEvents, eventName: u64) -> &MatcherGroup {
    let n = hook_events_len(e, eventName);
    if n >= 32 { return hook_events_group_at(e, eventName, 0); };
    // DEFECT: capacity overflow — TS push() grows; here the caller checks
    // hooks_len/matcher state to detect the full case (slot n is returned
    // without advancing len when full is misdetected; fix phase).
    hook_events_set_len(e, eventName, n + 1);
    let g = hook_events_group_at(e, eventName, n);
    g.has_matcher = false;
    g.matcher_len = 0;
    g.hooks_len = 0;
    return g;
}

fn matcher_group_set_matcher(g: &MatcherGroup, p: ptr, l: u64) -> void {
    g.matcher_ptr = p;
    g.matcher_len = l;
    g.has_matcher = true;
}

// Appends a zeroed HookHandlerConfig slot to g, returns it.
fn matcher_group_hook_push_slot(g: &MatcherGroup) -> &HookHandlerConfig {
    let n = g.hooks_len;
    if n >= 32 { return &g.hooks[0]; };
    g.hooks_len = n + 1;
    return &g.hooks[n];
}

fn matcher_group_hook_pop(g: &MatcherGroup) -> void {
    if g.hooks_len > 0 { g.hooks_len = g.hooks_len - 1; };
}

// Merges src's groups for one event into dst (loadHookEvents (merged[name] ??= []).push(...ev[name])).
fn hook_events_merge_groups(dst: &HookEvents, src: &HookEvents, eventName: u64) -> void {
    let n = hook_events_len(src, eventName);
    for gi in 0..n {
        let slot = hook_events_group_push_slot(dst, eventName);
        let s = hook_events_group_at(src, eventName, gi);
        *slot = *s;
    }
}

fn hook_cache_push_file(state: &HookModuleState, p: ptr, l: u64, source: u64) -> void {
    if state.cache.files_len >= 8 { return; };
    state.cache.files[state.cache.files_len].path_ptr = p;
    state.cache.files[state.cache.files_len].path_len = l;
    state.cache.files[state.cache.files_len].source = source;
    state.cache.files_len = state.cache.files_len + 1;
}

fn hook_cache_push_per_file(state: &HookModuleState, p: ptr, l: u64, source: u64, ev: &HookEvents) -> void {
    if state.cache.perFile_len >= 8 { return; };
    state.cache.perFile[state.cache.perFile_len].path_ptr = p;
    state.cache.perFile[state.cache.perFile_len].path_len = l;
    state.cache.perFile[state.cache.perFile_len].source = source;
    hook_events_copy(&state.cache.perFile[state.cache.perFile_len].events, ev);
    state.cache.perFile_len = state.cache.perFile_len + 1;
}

fn hook_run_new() -> HookRunSummary {
    let r: HookRunSummary;
    r.entries_len = 0;
    r.has_status_message = false;
    r.has_completed_at = false;
    r.has_duration_ms = false;
    return r;
}

fn hook_completed_new() -> HookCompletedEvent {
    let e: HookCompletedEvent;
    e.has_turn_id = false;
    return e;
}

fn parsed_hook_output_new() -> ParsedHookOutput {
    let o: ParsedHookOutput;
    parsed_hook_output_reset(&o);
    return o;
}

fn parsed_hook_output_reset(o: &ParsedHookOutput) -> void {
    o.blocked = false;
    o.has_blockReason = false;
    o.blockReason_len = 0;
    o.has_updatedInput = false;
    o.updatedInput_node = 0;
    o.has_additionalContext = false;
    o.additionalContext_len = 0;
    o.has_systemMessage = false;
    o.systemMessage_len = 0;
    o.has_stop = false;
    o.stop = false;
}

fn hook_exec_result_reset(r: &HookExecResult) -> void {
    r.blocked = false;
    r.has_blockReason = false;
    r.blockReason_len = 0;
    r.has_updatedInput = false;
    r.updatedInput_node = 0;
    r.additionalContexts_len = 0;
    r.has_feedback = false;
    r.feedback_len = 0;
    r.hookEvents_len = 0;
}

fn push_entry(entries: &HookOutputEntry, len_ref: &u64, kind: u64, text_ptr: ptr, text_len: u64) -> void {
    if *len_ref >= 32 { return; };
    entries[*len_ref].kind = kind;
    entries[*len_ref].text_ptr = text_ptr;
    entries[*len_ref].text_len = text_len;
    *len_ref = *len_ref + 1;
}

fn hook_exec_push_completed(res: &HookExecResult, ev: &HookCompletedEvent) -> void {
    if res.hookEvents_len >= 64 { return; };
    res.hookEvents[res.hookEvents_len] = *ev;
    res.hookEvents_len = res.hookEvents_len + 1;
}

fn hook_exec_push_context(res: &HookExecResult, p: ptr, l: u64) -> void {
    if res.additionalContexts_len >= 32 { return; };
    res.additionalContexts_ptr[res.additionalContexts_len] = p;
    res.additionalContexts_len_field[res.additionalContexts_len] = l;
    res.additionalContexts_len = res.additionalContexts_len + 1;
}

// Reads a string field of a JSON object node and returns its trimmed
// (ptr,len) when present and non-empty after trim (the recurring TS
// pattern `typeof r.x === "string" && r.x.trim() ? r.x.trim() : undefined`).
fn json_get_trimmed_string(node: u64, key_ptr: ptr, key_len: u64, out_ptr: &ptr, out_len: &u64) -> bool {
    let p: ptr = PTR_NULL();
    let l: u64 = 0;
    if sa_json_object_get_string(node, key_ptr, key_len, &p, &l) != 0 { return false; };
    let lo: u64 = 0;
    let hi: u64 = l;
    while lo < hi {
        let c: u8 = 0;
        PTR_BYTE_AT(c, p, lo);
        if c != 32 {
            if c != 9 {
                if c != 10 {
                    if c != 13 { break; };
                };
            };
        };
        lo = lo + 1;
    }
    while hi > lo {
        let c: u8 = 0;
        PTR_BYTE_AT(c, p, hi - 1);
        if c != 32 {
            if c != 9 {
                if c != 10 {
                    if c != 13 { break; };
                };
            };
        };
        hi = hi - 1;
    }
    if hi <= lo { return false; };
    *out_ptr = ptr_add(p, lo);
    *out_len = hi - lo;
    return true;
}

fn bytes_eq(a: ptr, a_len: u64, b: ptr, b_len: u64) -> bool {
    if a_len != b_len { return false; };
    for i in 0..a_len {
        let x: u8 = 0;
        let y: u8 = 0;
        PTR_BYTE_AT(x, a, i);
        PTR_BYTE_AT(y, b, i);
        if x != y { return false; };
    }
    return true;
}

// Case-insensitive (ASCII) equality — TS decision.toLowerCase() compare.
fn bytes_eq_lower(a: ptr, a_len: u64, b: ptr, b_len: u64) -> bool {
    if a_len != b_len { return false; };
    for i in 0..a_len {
        let x: u8 = 0;
        let y: u8 = 0;
        PTR_BYTE_AT(x, a, i);
        PTR_BYTE_AT(y, b, i);
        if x >= 65 {
            if x <= 90 { x = x + 32; };
        };
        if x != y { return false; };
    }
    return true;
}

fn bytes_contains(hay: ptr, hay_len: u64, needle: ptr, needle_len: u64) -> bool {
    if needle_len == 0 { return true; };
    if hay_len < needle_len { return false; };
    let limit = hay_len - needle_len;
    for i in 0..limit + 1 {
        let ok = true;
        for j in 0..needle_len {
            let x: u8 = 0;
            let y: u8 = 0;
            PTR_BYTE_AT(x, hay, i + j);
            PTR_BYTE_AT(y, needle, j);
            if x != y { ok = false; };
        }
        if ok { return true; };
    }
    return false;
}

fn min_u64(a: u64, b: u64) -> u64 {
    if a < b { return a; };
    return b;
}

fn clamp_u64(v: u64, lo: u64, hi: u64) -> u64 {
    if v < lo { return lo; };
    if v > hi { return hi; };
    return v;
}

// Math.floor(seconds * 1000) for the non-negative timeouts used here.
fn f64_ms(seconds: f64) -> u64 {
    return (seconds * 1000.0) as u64;
}
