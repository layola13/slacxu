// Converted 1:1 from mini-codex/src/hooks.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
// Codex-parity hook runtime for mini-codex (MCP hook events).
//
// Reference (E:\projects\codex):
// - codex-rs/config/src/hook_config.rs      (HooksFile/HookEventsToml/MatcherGroup/
//   HookHandlerConfig::{command,mcp_tool,prompt,agent}, 12 events, MCP null rejection)
// - codex-rs/hooks/src/events/pre_tool_use.rs / post_tool_use.rs (matcher dispatch,
//   command stdin JSON, updated_input/additionalContext/block semantics)
// - codex-rs/hooks/src/mcp.rs               (HookMcpCall/HookMcpExecutor)
// - codex-rs/core/src/hook_runtime.rs       (HookStarted/HookCompleted emission)
// - codex-rs/core/src/tools/handlers/mcp.rs (mcp__<server>__<tool> naming,
//   PreToolUse tool_input = parsed JSON args,
//   PostToolUse tool_response = {content, structuredContent})
// - codex-rs/protocol/src/protocol.rs       (HookStartedEvent/HookCompletedEvent/
//   HookRunSummary/HandlerType/EventName/RunStatus)
//
// Scope: PreToolUse/PostToolUse around every tool call (MCP first-class).
// Other 10 events load but only emit via explicit helpers (no silent drop of config).
@import "sa_std/io/print.sai"
@import "sa_std/ptr.sa"
@import "sa_std/fs.sai"
@import "sa_std/env.sai"
@import "sa_std/process.sai"
@import "sa_std/json.sai"
// TS imports (lines 18-22): node:crypto randomUUID as uuid, node:child_process
// spawn, node:fs/promises readFile, node:os homedir, node:path join.
// DEFECT: Node API — node:crypto/node:child_process/node:fs/promises/node:os/
// node:path have no 1:1 sa_std counterparts; approximated with sa_std env/fs/
// process externs and (ptr,len) path buffers (see per-function DEFECTs).

// ---------------------------------------------------------------------------
// TS: export type HookEventName = "PreToolUse" | "PermissionRequest" |
//     "PostToolUse" | "PreCompact" | "PostCompact" | "SessionStart" |
//     "SessionEnd" | "UserPromptSubmit" | "SubagentStart" | "SubagentStop" |
//     "Stop" | "Interrupt";
// DEFECT: string-literal union type — approximated by u64 enum codes
// 0..11 in HOOK_EVENT_NAMES order; name text recovered via
// HOOK_EVENT_NAMES_at().
// ---------------------------------------------------------------------------

fn HOOK_EVENT_NAMES_count() -> u64 { return 12; }

fn HOOK_EVENT_NAMES_at(idx: u64, out_len: &u64) -> ptr {
    if idx == 0 { *out_len = STR_LEN("PreToolUse"); return STR_PTR("PreToolUse"); };
    if idx == 1 { *out_len = STR_LEN("PermissionRequest"); return STR_PTR("PermissionRequest"); };
    if idx == 2 { *out_len = STR_LEN("PostToolUse"); return STR_PTR("PostToolUse"); };
    if idx == 3 { *out_len = STR_LEN("PreCompact"); return STR_PTR("PreCompact"); };
    if idx == 4 { *out_len = STR_LEN("PostCompact"); return STR_PTR("PostCompact"); };
    if idx == 5 { *out_len = STR_LEN("SessionStart"); return STR_PTR("SessionStart"); };
    if idx == 6 { *out_len = STR_LEN("SessionEnd"); return STR_PTR("SessionEnd"); };
    if idx == 7 { *out_len = STR_LEN("UserPromptSubmit"); return STR_PTR("UserPromptSubmit"); };
    if idx == 8 { *out_len = STR_LEN("SubagentStart"); return STR_PTR("SubagentStart"); };
    if idx == 9 { *out_len = STR_LEN("SubagentStop"); return STR_PTR("SubagentStop"); };
    if idx == 10 { *out_len = STR_LEN("Stop"); return STR_PTR("Stop"); };
    *out_len = STR_LEN("Interrupt");
    return STR_PTR("Interrupt");
}

// TS: export type HookHandlerType = "command" | "mcp_tool" | "prompt" | "agent";
// DEFECT: string-literal union — u64 codes: 0 command, 1 mcp_tool, 2 prompt, 3 agent.
fn hook_handler_type_name(code: u64, out_len: &u64) -> ptr {
    if code == 0 { *out_len = STR_LEN("command"); return STR_PTR("command"); };
    if code == 1 { *out_len = STR_LEN("mcp_tool"); return STR_PTR("mcp_tool"); };
    if code == 2 { *out_len = STR_LEN("prompt"); return STR_PTR("prompt"); };
    *out_len = STR_LEN("agent");
    return STR_PTR("agent");
}

// TS: export type HookRunStatus = "running" | "completed" | "failed" | "blocked" | "stopped";
// DEFECT: string-literal union — u64 codes: 0 running, 1 completed, 2 failed, 3 blocked, 4 stopped.
fn hook_run_status_name(code: u64, out_len: &u64) -> ptr {
    if code == 0 { *out_len = STR_LEN("running"); return STR_PTR("running"); };
    if code == 1 { *out_len = STR_LEN("completed"); return STR_PTR("completed"); };
    if code == 2 { *out_len = STR_LEN("failed"); return STR_PTR("failed"); };
    if code == 3 { *out_len = STR_LEN("blocked"); return STR_PTR("blocked"); };
    *out_len = STR_LEN("stopped");
    return STR_PTR("stopped");
}

// TS: export type HookSource = "user" | "project" | "unknown";
// DEFECT: string-literal union — u64 codes: 0 user, 1 project, 2 unknown.
fn hook_source_name(code: u64, out_len: &u64) -> ptr {
    if code == 0 { *out_len = STR_LEN("user"); return STR_PTR("user"); };
    if code == 1 { *out_len = STR_LEN("project"); return STR_PTR("project"); };
    *out_len = STR_LEN("unknown");
    return STR_PTR("unknown");
}

// TS: export interface HookOutputEntry { kind: "warning" | "stop" | "feedback" | "context" | "error"; text: string }
// kind codes: 0 warning, 1 stop, 2 feedback, 3 context, 4 error.
struct HookOutputEntry { kind: u64, text_ptr: ptr, text_len: u64 }

// TS: export interface HookRunSummary {
//   id: string; event_name: HookEventName; handler_type: HookHandlerType;
//   execution_mode: "sync"; scope: "turn"; source_path: string;
//   source: HookSource; display_order: number; status: HookRunStatus;
//   status_message: string | null; started_at: number;
//   completed_at: number | null; duration_ms: number | null;
//   entries: HookOutputEntry[]; }
// DEFECT: nullable fields (string | null, number | null) — approximated with
// has_* flags; execution_mode/scope are the string literals "sync"/"turn",
// kept as fixed codes 0/0 (only values the TS ever produces).
// DEFECT: entries array — fixed capacity 32 + len (a single hook run never
// emits more in the TS code paths).
struct HookRunSummary {
    id_ptr: ptr, id_len: u64,
    event_name: u64, handler_type: u64,
    execution_mode: u64, scope: u64,
    source_path_ptr: ptr, source_path_len: u64,
    source: u64, display_order: u64,
    status: u64,
    status_message_ptr: ptr, status_message_len: u64, has_status_message: bool,
    started_at: u64,
    completed_at: u64, has_completed_at: bool,
    duration_ms: u64, has_duration_ms: bool,
    entries: [HookOutputEntry; 32], entries_len: u64,
}

// TS: export interface HookStartedEvent { turn_id: string | null; run: HookRunSummary }
// TS: export interface HookCompletedEvent { turn_id: string | null; run: HookRunSummary }
struct HookStartedEvent { turn_id_ptr: ptr, turn_id_len: u64, has_turn_id: bool, run: HookRunSummary }
struct HookCompletedEvent { turn_id_ptr: ptr, turn_id_len: u64, has_turn_id: bool, run: HookRunSummary }

// TS: export type HookEvent = { type: "hook_started"; event: HookStartedEvent }
//     | { type: "hook_completed"; event: HookCompletedEvent };
// DEFECT: discriminated union — tagged struct, type_code 0 = hook_started,
// 1 = hook_completed; both payloads stored, only the tagged one is live.
struct HookEvent { type_code: u64, started: HookStartedEvent, completed: HookCompletedEvent }

// TS: export type HookEventSink = (e: HookEvent) => void;
// DEFECT: function type / callback — SLA has no first-class function values;
// a sink is an opaque u64 id dispatched by hook_sink_dispatch() (fix phase
// wires the registry); 0 = no sink (TS undefined).

// TS: export type HookHandlerConfig =
//   | { type: "command"; command: string; commandWindows?: string; timeout?: number; statusMessage?: string }
//   | { type: "mcp_tool"; server: string; tool: string; input: Record<string, unknown>; timeout?: number; statusMessage?: string }
//   | { type: "prompt" }
//   | { type: "agent" };
// DEFECT: discriminated union with optional fields — flattened tagged
// struct; type_code reuses HookHandlerType codes (0 command, 1 mcp_tool,
// 2 prompt, 3 agent); absent optionals via has_* flags.
// DEFECT: dynamic object — mcp_tool `input: Record<string, unknown>` is a
// JSON node handle (input_node), not a struct.
struct HookHandlerConfig {
    type_code: u64,
    command_ptr: ptr, command_len: u64,
    commandWindows_ptr: ptr, commandWindows_len: u64, has_commandWindows: bool,
    server_ptr: ptr, server_len: u64,
    tool_ptr: ptr, tool_len: u64,
    input_node: u64,
    timeout_s: f64, has_timeout: bool,
    statusMessage_ptr: ptr, statusMessage_len: u64, has_statusMessage: bool,
}

// TS: export interface MatcherGroup { matcher?: string; hooks: HookHandlerConfig[] }
// DEFECT: hooks array — fixed capacity 32 + len.
struct MatcherGroup { matcher_ptr: ptr, matcher_len: u64, has_matcher: bool, hooks: [HookHandlerConfig; 32], hooks_len: u64 }

// TS: export type HookEvents = Partial<Record<HookEventName, MatcherGroup[]>>
// DEFECT: Partial<Record<...>> dynamic keyed object — struct with one
// fixed-capacity group array per event name (capacity 32 groups each);
// *_len == 0 encodes the absent key.
struct HookEvents {
    groups0: [MatcherGroup; 32], groups0_len: u64,
    groups1: [MatcherGroup; 32], groups1_len: u64,
    groups2: [MatcherGroup; 32], groups2_len: u64,
    groups3: [MatcherGroup; 32], groups3_len: u64,
    groups4: [MatcherGroup; 32], groups4_len: u64,
    groups5: [MatcherGroup; 32], groups5_len: u64,
    groups6: [MatcherGroup; 32], groups6_len: u64,
    groups7: [MatcherGroup; 32], groups7_len: u64,
    groups8: [MatcherGroup; 32], groups8_len: u64,
    groups9: [MatcherGroup; 32], groups9_len: u64,
    groups10: [MatcherGroup; 32], groups10_len: u64,
    groups11: [MatcherGroup; 32], groups11_len: u64,
}

// Accessor for the per-event group array (event code -> base ptr + len).
// DEFECT: dynamic key indexing events[eventName] — switch on the enum code.
fn hook_events_len(events: &HookEvents, event_name: u64) -> u64 {
    if event_name == 0 { return events.groups0_len; };
    if event_name == 1 { return events.groups1_len; };
    if event_name == 2 { return events.groups2_len; };
    if event_name == 3 { return events.groups3_len; };
    if event_name == 4 { return events.groups4_len; };
    if event_name == 5 { return events.groups5_len; };
    if event_name == 6 { return events.groups6_len; };
    if event_name == 7 { return events.groups7_len; };
    if event_name == 8 { return events.groups8_len; };
    if event_name == 9 { return events.groups9_len; };
    if event_name == 10 { return events.groups10_len; };
    return events.groups11_len;
}

// TS: interface LoadedHooks { events: HookEvents; sourcePath: string; source: HookSource }
struct LoadedHooks { events: HookEvents, sourcePath_ptr: ptr, sourcePath_len: u64, source: u64 }

// TS: interface HookCache {
//   at: number; cwd: string; events: HookEvents;
//   files: Array<{ path: string; source: HookSource }>;
//   perFile: Array<{ path: string; source: HookSource; events: HookEvents }>; }
// DEFECT: nested arrays of objects — fixed capacities (8 files, matching the
// 5 candidate paths loadHookEvents probes) + len fields.
struct HookFileRef { path_ptr: ptr, path_len: u64, source: u64 }
struct HookPerFile { path_ptr: ptr, path_len: u64, source: u64, events: HookEvents }
struct HookCache {
    at: u64, cwd_ptr: ptr, cwd_len: u64, events: HookEvents,
    files: [HookFileRef; 8], files_len: u64,
    perFile: [HookPerFile; 8], perFile_len: u64,
}

// TS: let cache: HookCache | null = null;
// DEFECT: module-level mutable state + null — global struct + has_cache flag
// (SLA globals are caller-owned storage in this approximation; the fix phase
// must give `cache` a single static home).
struct HookModuleState { cache: HookCache, has_cache: bool }

// TS: function codexHome(): string {
//   const h = (process.env.CODEX_HOME ?? "").trim();
//   if (h) return h.startsWith("~") ? join(homedir(), h.slice(1)) : h;
//   return join(homedir(), ".codex");
// }
// Writes the result path into out, returns its length.
// DEFECT: process.env / node:os homedir / node:path join — approximated with
// sa_std env lookup + byte-buffer path concatenation (no separator
// normalisation; TS join() also resolves "." / ".." segments).
// DEFECT: string methods trim/startsWith/slice — byte scans.
fn codexHome(out: &ByteBuf) -> u64 {
    buf_reset(out);
    let h_ptr: ptr = PTR_NULL();
    let h_len: u64 = 0;
    sa_env_get(STR_PTR("CODEX_HOME"), STR_LEN("CODEX_HOME"), &h_ptr, &h_len);
    // trim
    let lo: u64 = 0;
    let hi: u64 = h_len;
    while lo < hi {
        let c: u8 = 0;
        PTR_BYTE_AT(c, h_ptr, lo);
        if c != 32 {
            if c != 9 {
                if c != 10 {
                    if c != 13 { break; };
                };
            };
        };
        lo = lo + 1;
    }
    while hi > lo {
        let c: u8 = 0;
        PTR_BYTE_AT(c, h_ptr, hi - 1);
        if c != 32 {
            if c != 9 {
                if c != 10 {
                    if c != 13 { break; };
                };
            };
        };
        hi = hi - 1;
    }
    if hi > lo {
        let first: u8 = 0;
        PTR_BYTE_AT(first, h_ptr, lo);
        if first == 126 {
            // "~..." -> join(homedir(), h.slice(1))
            sa_env_home(out);
            buf_append_slice(out, h_ptr, lo + 1, hi);
            return out.len;
        };
        buf_append_slice(out, h_ptr, lo, hi);
        return out.len;
    };
    // join(homedir(), ".codex")
    sa_env_home(out);
    buf_append_lit(out, STR_PTR("/.codex"), STR_LEN("/.codex"));
    return out.len;
}

// ---------------------------------------------------------------------------
// TS: function normalizeEvents(raw: unknown): HookEvents {
//   const out: HookEvents = {};
//   if (!raw || typeof raw !== "object" || Array.isArray(raw)) return out;
//   const rec = raw as Record<string, unknown>;
//   // Accept both {hooks:{PreToolUse:[...]}} (hooks.json) and flat {PreToolUse:[...]}.
//   const body = rec.hooks && typeof rec.hooks === "object" && !Array.isArray(rec.hooks)
//     ? (rec.hooks as Record<string, unknown>) : rec;
//   for (const name of HOOK_EVENT_NAMES) {
//     const v = (body as Record<string, unknown>)[name];
//     if (!Array.isArray(v)) continue;
//     const groups: MatcherGroup[] = [];
//     for (const g of v) {
//       if (!g || typeof g !== "object" || Array.isArray(g)) continue;
//       const gr = g as Record<string, unknown>;
//       const hooks: HookHandlerConfig[] = [];
//       if (Array.isArray(gr.hooks)) for (const h of gr.hooks) {
//         const hc = normalizeHandler(h);
//         if (hc) hooks.push(hc);
//       }
//       groups.push({
//         ...(typeof gr.matcher === "string" ? { matcher: gr.matcher } : {}),
//         hooks,
//       });
//     }
//     out[name] = groups;
//   }
//   return out;
// }
// SLA approximation: raw is a JSON node handle; iteration is over the JSON
// layer (sa_json_*), results are written into the fixed arrays of `out`.
// DEFECT: dynamic object — `unknown`, typeof/Array.isArray runtime dispatch,
// Record casts and dynamic key access (body[name]) have no SLA counterpart;
// approximated via JSON node kinds and per-name key lookup.
// DEFECT: object spread `...(cond ? { matcher } : {})` in the group literal —
// approximated by conditionally setting has_matcher/matcher fields.
// DEFECT: Array.push growth — fixed capacities (32 groups/event, 32 hooks/
// group); overflow entries are dropped (TS keeps all).
fn normalizeEvents(raw_node: u64, out: &HookEvents) -> void {
    hook_events_reset(out);
    if raw_node == 0 { return; };
    if sa_json_kind_of(raw_node) != 3 { return; };
    // body = rec.hooks (object) ?? rec
    let body_node = raw_node;
    let hooks_node: u64 = 0;
    if sa_json_object_get(raw_node, STR_PTR("hooks"), STR_LEN("hooks"), &hooks_node) == 0 {
        if sa_json_kind_of(hooks_node) == 3 { body_node = hooks_node; };
    };
    for name_idx in 0..12 {
        let name_len: u64 = 0;
        let name_ptr = HOOK_EVENT_NAMES_at(name_idx, &name_len);
        let v_node: u64 = 0;
        if sa_json_object_get(body_node, name_ptr, name_len, &v_node) != 0 { continue; };
        if sa_json_kind_of(v_node) != 2 { continue; };
        let g_count = sa_json_array_len(v_node);
        for gi in 0..g_count {
            let g_node: u64 = 0;
            if sa_json_array_get(v_node, gi, &g_node) != 0 { continue; };
            if sa_json_kind_of(g_node) != 3 { continue; };
            let group_slot = hook_events_group_push_slot(out, name_idx);
            if group_slot == 0 { continue; };
            // matcher (optional string)
            let m_ptr: ptr = PTR_NULL();
            let m_len: u64 = 0;
            if sa_json_object_get_string(g_node, STR_PTR("matcher"), STR_LEN("matcher"), &m_ptr, &m_len) == 0 {
                matcher_group_set_matcher(group_slot, m_ptr, m_len);
            };
            // hooks[]
            let hs_node: u64 = 0;
            if sa_json_object_get(g_node, STR_PTR("hooks"), STR_LEN("hooks"), &hs_node) == 0 {
                if sa_json_kind_of(hs_node) == 2 {
                    let h_count = sa_json_array_len(hs_node);
                    for hi in 0..h_count {
                        let h_node: u64 = 0;
                        if sa_json_array_get(hs_node, hi, &h_node) != 0 { continue; };
                        let hc_slot = matcher_group_hook_push_slot(group_slot);
                        if hc_slot == 0 { continue; };
                        // DEFECT: normalizeHandler returns HookHandlerConfig | null and push is conditional — slot is pre-allocated; a null result must roll the slot back (fix phase).
                        if normalizeHandler(h_node, hc_slot) != 0 {
                            matcher_group_hook_pop(group_slot);
                        };
                    }
                };
            };
        }
    }
}

// TS: function normalizeHandler(h: unknown): HookHandlerConfig | null {
//   if (!h || typeof h !== "object" || Array.isArray(h)) return null;
//   const r = h as Record<string, unknown>;
//   if (r.type === "command" && typeof r.command === "string") {
//     // Codex parity: platform override wins on Windows (hook_config.rs command_windows).
//     const commandWindows = typeof r.commandWindows === "string" ? r.commandWindows
//       : (typeof r.command_windows === "string" ? String(r.command_windows) : undefined);
//     return {
//       type: "command",
//       command: r.command,
//       ...(commandWindows ? { commandWindows } : {}),
//       ...(typeof r.timeout === "number" ? { timeout: r.timeout } : {}),
//       ...(typeof r.statusMessage === "string" ? { statusMessage: r.statusMessage } : {}),
//     };
//   }
//   if (r.type === "mcp_tool" && typeof r.server === "string" && typeof r.tool === "string") {
//     const input = (r.input && typeof r.input === "object" && !Array.isArray(r.input)
//       ? (r.input as Record<string, unknown>) : {});
//     // Codex parity: MCP hook input must be TOML-representable -> reject null anywhere.
//     if (containsNull(input)) return null;
//     return {
//       type: "mcp_tool",
//       server: r.server, tool: r.tool, input,
//       ...(typeof r.timeout === "number" ? { timeout: r.timeout } : {}),
//       ...(typeof r.statusMessage === "string" ? { statusMessage: r.statusMessage } : {}),
//     };
//   }
//   if (r.type === "prompt") return { type: "prompt" };
//   if (r.type === "agent") return { type: "agent" };
//   return null;
// }
// Returns 0 on success (out filled), 1 for the TS `null` result.
// DEFECT: dynamic object — unknown/Record dispatch via JSON node kinds.
// DEFECT: conditional spread fields in object literals — has_* flags.
// DEFECT: String(r.command_windows) coercion of an arbitrary value — only
// the string case is read; non-string command_windows values are dropped
// (TS would stringify numbers/booleans).
fn normalizeHandler(h_node: u64, out: &HookHandlerConfig) -> i32 {
    if h_node == 0 { return 1; };
    if sa_json_kind_of(h_node) != 3 { return 1; };
    let t_ptr: ptr = PTR_NULL();
    let t_len: u64 = 0;
    if sa_json_object_get_string(h_node, STR_PTR("type"), STR_LEN("type"), &t_ptr, &t_len) != 0 { return 1; };
    if bytes_eq(t_ptr, t_len, STR_PTR("command"), STR_LEN("command")) {
        let cmd_ptr: ptr = PTR_NULL();
        let cmd_len: u64 = 0;
        if sa_json_object_get_string(h_node, STR_PTR("command"), STR_LEN("command"), &cmd_ptr, &cmd_len) != 0 { return 1; };
        out.type_code = 0;
        out.command_ptr = cmd_ptr;
        out.command_len = cmd_len;
        // commandWindows ?? command_windows
        let cw_ptr: ptr = PTR_NULL();
        let cw_len: u64 = 0;
        if sa_json_object_get_string(h_node, STR_PTR("commandWindows"), STR_LEN("commandWindows"), &cw_ptr, &cw_len) == 0 {
            out.commandWindows_ptr = cw_ptr;
            out.commandWindows_len = cw_len;
            out.has_commandWindows = true;
        } else {
            if sa_json_object_get_string(h_node, STR_PTR("command_windows"), STR_LEN("command_windows"), &cw_ptr, &cw_len) == 0 {
                out.commandWindows_ptr = cw_ptr;
                out.commandWindows_len = cw_len;
                out.has_commandWindows = true;
            };
        };
        hook_handler_copy_optionals(h_node, out);
        return 0;
    };
    if bytes_eq(t_ptr, t_len, STR_PTR("mcp_tool"), STR_LEN("mcp_tool")) {
        let s_ptr: ptr = PTR_NULL();
        let s_len: u64 = 0;
        let tl_ptr: ptr = PTR_NULL();
        let tl_len: u64 = 0;
        if sa_json_object_get_string(h_node, STR_PTR("server"), STR_LEN("server"), &s_ptr, &s_len) != 0 { return 1; };
        if sa_json_object_get_string(h_node, STR_PTR("tool"), STR_LEN("tool"), &tl_ptr, &tl_len) != 0 { return 1; };
        let input_node: u64 = 0;
        let raw_input: u64 = 0;
        if sa_json_object_get(h_node, STR_PTR("input"), STR_LEN("input"), &raw_input) == 0 {
            if sa_json_kind_of(raw_input) == 3 { input_node = raw_input; };
        };
        if input_node == 0 { input_node = sa_json_empty_object(); };
        if containsNull(input_node) { return 1; };
        out.type_code = 1;
        out.server_ptr = s_ptr;
        out.server_len = s_len;
        out.tool_ptr = tl_ptr;
        out.tool_len = tl_len;
        out.input_node = input_node;
        hook_handler_copy_optionals(h_node, out);
        return 0;
    };
    if bytes_eq(t_ptr, t_len, STR_PTR("prompt"), STR_LEN("prompt")) { out.type_code = 2; return 0; };
    if bytes_eq(t_ptr, t_len, STR_PTR("agent"), STR_LEN("agent")) { out.type_code = 3; return 0; };
    return 1;
}

// Shared tail of the command/mcp_tool branches: timeout + statusMessage.
// DEFECT: `typeof r.timeout === "number"` — JSON number node read as f64;
// TS keeps the raw JS number (could be non-finite); f64 field approximates.
fn hook_handler_copy_optionals(h_node: u64, out: &HookHandlerConfig) -> void {
    let to_node: u64 = 0;
    if sa_json_object_get(h_node, STR_PTR("timeout"), STR_LEN("timeout"), &to_node) == 0 {
        if sa_json_kind_of(to_node) == 4 {
            out.timeout_s = sa_json_number_f64(to_node);
            out.has_timeout = true;
        };
    };
    let sm_ptr: ptr = PTR_NULL();
    let sm_len: u64 = 0;
    if sa_json_object_get_string(h_node, STR_PTR("statusMessage"), STR_LEN("statusMessage"), &sm_ptr, &sm_len) == 0 {
        out.statusMessage_ptr = sm_ptr;
        out.statusMessage_len = sm_len;
        out.has_statusMessage = true;
    };
}

// TS: function containsNull(v: unknown): boolean {
//   if (v === null) return true;
//   if (Array.isArray(v)) return v.some(containsNull);
//   if (v && typeof v === "object") return Object.values(v as Record<string, unknown>).some(containsNull);
//   return false;
// }
// DEFECT: recursion over an `unknown` dynamic value + Array.some/Object.
// values with a function argument (higher-order) — approximated by explicit
// recursion over JSON node kinds (null=0 kind code in this approximation:
// sa_json_kind_of returns 5 for null).
// DEFECT: closure — containsNull passed as a callback to .some(); inlined
// as direct recursion here.
fn containsNull(v_node: u64) -> bool {
    let kind = sa_json_kind_of(v_node);
    if kind == 5 { return true; };
    if kind == 2 {
        let n = sa_json_array_len(v_node);
        for i in 0..n {
            let el: u64 = 0;
            if sa_json_array_get(v_node, i, &el) == 0 {
                if containsNull(el) { return true; };
            };
        }
        return false;
    };
    if kind == 3 {
        let n = sa_json_object_len(v_node);
        for i in 0..n {
            let val: u64 = 0;
            if sa_json_object_value_at(v_node, i, &val) == 0 {
                if containsNull(val) { return true; };
            };
        }
        return false;
    };
    return false;
}

// TS: /** Canonicalize event names: PreToolUse/pre_tool_use/pretooluse all map. */
// TS: function canonicalEventName(k: string): HookEventName | null {
//   const n = k.trim().toLowerCase().replace(/[_\-\s]/g, "");
//   for (const name of HOOK_EVENT_NAMES) {
//     if (name.toLowerCase().replace(/[_\-\s]/g, "") === n) return name;
//   }
//   return null;
// }
// Returns the event code 0..11, or 12 for the TS `null` result.
// DEFECT: RegExp replace /[_\-\s]/g + toLowerCase string pipeline — hand
// byte loop: lowercase ASCII and drop '_' / '-' / whitespace while copying.
fn canonicalEventName(k_ptr: ptr, k_len: u64, norm: &ByteBuf) -> u64 {
    buf_reset(norm);
    // n = normalised k
    let n_len: u64 = 0;
    // trim first (TS trims before lowercasing/stripping)
    let lo: u64 = 0;
    let hi: u64 = k_len;
    while lo < hi {
        let c: u8 = 0;
        PTR_BYTE_AT(c, k_ptr, lo);
        if c != 32 {
            if c != 9 {
                if c != 10 {
                    if c != 13 { break; };
                };
            };
        };
        lo = lo + 1;
    }
    while hi > lo {
        let c: u8 = 0;
        PTR_BYTE_AT(c, k_ptr, hi - 1);
        if c != 32 {
            if c != 9 {
                if c != 10 {
                    if c != 13 { break; };
                };
            };
        };
        hi = hi - 1;
    }
    for i in lo..hi {
        let c: u8 = 0;
        PTR_BYTE_AT(c, k_ptr, i);
        if c == 95 { continue; };
        if c == 45 { continue; };
        if c == 32 { continue; };
        if c == 9 { continue; };
        if c == 10 { continue; };
        if c == 13 { continue; };
        if c >= 65 {
            if c <= 90 { c = c + 32; };
        };
        buf_append_byte(norm, c);
        n_len = n_len + 1;
    }
    // compare against each canonical name normalised the same way
    for idx in 0..12 {
        let name_len: u64 = 0;
        let name_ptr = HOOK_EVENT_NAMES_at(idx, &name_len);
        let cand: u64 = 0;
        let cand_len: u64 = 0;
        for j in 0..name_len {
            let c: u8 = 0;
            PTR_BYTE_AT(c, name_ptr, j);
            if c >= 65 {
                if c <= 90 { c = c + 32; };
            };
            if cand_len < n_len {
                let want: u8 = 0;
                PTR_BYTE_AT(want, buf_ptr(norm), cand_len);
                if want != c { cand = 999; };
            };
            cand_len = cand_len + 1;
        }
        if cand == 0 {
            if cand_len == n_len { return idx; };
        };
    }
    return 12;
}

// TS: function parseTomlScalar(text: string): unknown { ...recursive... }
// Handles: "true"/"false", quoted strings (via a JSON.parse re-escape
// trick), integers/floats via /^-?\d+$/ and /^-?\d*\.\d+$/ + Number(t),
// [arrays] with a hand-written depth/quote-aware comma splitter that
// recurses, and {inline tables} split on "," with key = scalar pairs.
// Returns a JSON node handle representing the parsed value.
// DEFECT: dynamic value — `unknown` return (bool/string/number/array/
// object) has no SLA type; JSON node handle used throughout.
// DEFECT: RegExp numeric tests /^-?\d+$/ etc. — hand byte scans.
// DEFECT: try/catch around JSON.parse(`"${...}"`) for escape decoding —
// approximated by sa_json_parse of a rebuilt quoted string; the TS catch
// fallback (raw inner text) is taken when the parse fails.
// DEFECT: string index access inner[i]/inner[i-1] and char-by-char state
// machine (quote/depth) — byte loop over (ptr,len); the TS splitter does
// not handle escaped quotes inside single-quoted strings beyond the
// previous-char backslash check, preserved here.
fn parseTomlScalar(text_ptr: ptr, text_len: u64) -> u64 {
    // t = text.trim()
    let lo: u64 = 0;
    let hi: u64 = text_len;
    while lo < hi {
        let c: u8 = 0;
        PTR_BYTE_AT(c, text_ptr, lo);
        if c != 32 {
            if c != 9 {
                if c != 10 {
                    if c != 13 { break; };
                };
            };
        };
        lo = lo + 1;
    }
    while hi > lo {
        let c: u8 = 0;
        PTR_BYTE_AT(c, text_ptr, hi - 1);
        if c != 32 {
            if c != 9 {
                if c != 10 {
                    if c != 13 { break; };
                };
            };
        };
        hi = hi - 1;
    }
    let t_ptr = ptr_add(text_ptr, lo);
    let t_len = hi - lo;
    if bytes_eq(t_ptr, t_len, STR_PTR("true"), STR_LEN("true")) { return sa_json_bool(true); };
    if bytes_eq(t_ptr, t_len, STR_PTR("false"), STR_LEN("false")) { return sa_json_bool(false); };
    if t_len >= 2 {
        let first: u8 = 0;
        let last: u8 = 0;
        PTR_BYTE_AT(first, t_ptr, 0);
        PTR_BYTE_AT(last, t_ptr, t_len - 1);
        if first == 34 {
            if last == 34 { return parse_toml_quoted(t_ptr, t_len); };
        };
        if first == 39 {
            if last == 39 { return parse_toml_quoted(t_ptr, t_len); };
        };
        if toml_is_int(t_ptr, t_len) { return sa_json_number_parse(t_ptr, t_len); };
        if toml_is_float(t_ptr, t_len) { return sa_json_number_parse(t_ptr, t_len); };
        if first == 91 {
            if last == 93 { return parse_toml_array(t_ptr, t_len); };
        };
        if first == 123 {
            if last == 125 { return parse_toml_inline_table(t_ptr, t_len); };
        };
    };
    // bare string fallback: return t itself
    return sa_json_string(t_ptr, t_len);
}

// Quoted-scalar branch of parseTomlScalar (split out only because SLA has
// no closures to keep it inline; name kept local to this unit).
// DEFECT: nested function extraction — TS has this inline in parseTomlScalar;
// SLA fn is file-scope (no behavioural change, logged per brief).
fn parse_toml_quoted(t_ptr: ptr, t_len: u64) -> u64 {
    // try JSON.parse("\"" + inner.replace(/\\/g,"\\\\").replace(/"/g,"\\\"") + "\"")
    // catch -> inner raw
    let node = sa_json_parse_quoted_inner(t_ptr, t_len);
    if node != 0 { return node; };
    return sa_json_string(ptr_add(t_ptr, 1), t_len - 2);
}

fn toml_is_int(p: ptr, l: u64) -> bool {
    let i: u64 = 0;
    if l == 0 { return false; };
    let c0: u8 = 0;
    PTR_BYTE_AT(c0, p, 0);
    if c0 == 45 { i = 1; };
    if i >= l { return false; };
    while i < l {
        let c: u8 = 0;
        PTR_BYTE_AT(c, p, i);
        if c < 48 { return false; };
        if c > 57 { return false; };
        i = i + 1;
    }
    return true;
}

fn toml_is_float(p: ptr, l: u64) -> bool {
    // /^-?\d*\.\d+$/
    let i: u64 = 0;
    let c0: u8 = 0;
    if l == 0 { return false; };
    PTR_BYTE_AT(c0, p, 0);
    if c0 == 45 { i = 1; };
    let digits_before: u64 = 0;
    while i < l {
        let c: u8 = 0;
        PTR_BYTE_AT(c, p, i);
        if c < 48 { break; };
        if c > 57 { break; };
        i = i + 1;
        digits_before = digits_before + 1;
    }
    if i >= l { return false; };
    let dot: u8 = 0;
    PTR_BYTE_AT(dot, p, i);
    if dot != 46 { return false; };
    i = i + 1;
    let digits_after: u64 = 0;
    while i < l {
        let c: u8 = 0;
        PTR_BYTE_AT(c, p, i);
        if c < 48 { return false; };
        if c > 57 { return false; };
        i = i + 1;
        digits_after = digits_after + 1;
    }
    if digits_after == 0 { return false; };
    return true;
}

// [ ... ] branch: depth/quote-aware comma split, recursive parseTomlScalar
// per part (TS: parts.map((p) => parseTomlScalar(p.trim()))).
// DEFECT: Array.map with arrow closure — explicit loop + array node append.
fn parse_toml_array(t_ptr: ptr, t_len: u64) -> u64 {
    let arr = sa_json_array_new();
    if t_len <= 2 { return arr; };
    let inner_ptr = ptr_add(t_ptr, 1);
    let inner_len = t_len - 2;
    // inner.trim() emptiness handled by the loop emitting no parts.
    let cur_lo: u64 = 0;
    let depth: i32 = 0;
    let quote: u8 = 0;
    let has_quote = false;
    let i: u64 = 0;
    while i < inner_len {
        let ch: u8 = 0;
        PTR_BYTE_AT(ch, inner_ptr, i);
        if has_quote {
            if ch == quote {
                let prev: u8 = 0;
                if i > 0 { PTR_BYTE_AT(prev, inner_ptr, i - 1); };
                if prev != 92 { has_quote = false; };
            };
            i = i + 1;
            continue;
        };
        if ch == 34 { has_quote = true; quote = ch; i = i + 1; continue; };
        if ch == 39 { has_quote = true; quote = ch; i = i + 1; continue; };
        if ch == 91 { depth = depth + 1; };
        if ch == 123 { depth = depth + 1; };
        if ch == 93 { depth = depth - 1; };
        if ch == 125 { depth = depth - 1; };
        if ch == 44 {
            if depth == 0 {
                let part = parseTomlScalar(ptr_add(inner_ptr, cur_lo), i - cur_lo);
                sa_json_array_push(arr, part);
                cur_lo = i + 1;
            };
        };
        i = i + 1;
    }
    // trailing part: TS pushes cur only if cur.trim() is non-empty.
    if slice_nonempty_trimmed(inner_ptr, cur_lo, inner_len) {
        let part = parseTomlScalar(ptr_add(inner_ptr, cur_lo), inner_len - cur_lo);
        sa_json_array_push(arr, part);
    };
    return arr;
}

// { ... } inline-table branch: split inner on "," (NOT depth-aware in TS),
// each segment split at the first "=", key unquoted, value recursive.
// DEFECT: try/catch around the whole branch returning the raw string t on
// error — SLA parse helpers do not throw; malformed segments are skipped
// exactly as the TS `eq < 0 -> continue` path, the catch-all is lost.
fn parse_toml_inline_table(t_ptr: ptr, t_len: u64) -> u64 {
    let obj = sa_json_object_new();
    if t_len <= 2 { return obj; };
    let inner_ptr = ptr_add(t_ptr, 1);
    let inner_len = t_len - 2;
    if !slice_nonempty_trimmed(inner_ptr, 0, inner_len) { return obj; };
    let seg_lo: u64 = 0;
    let i: u64 = 0;
    while i <= inner_len {
        let at_end = false;
        if i == inner_len { at_end = true; };
        let ch: u8 = 0;
        if !at_end { PTR_BYTE_AT(ch, inner_ptr, i); };
        if at_end {
            toml_inline_table_segment(obj, inner_ptr, seg_lo, i);
        } else {
            if ch == 44 {
                toml_inline_table_segment(obj, inner_ptr, seg_lo, i);
                seg_lo = i + 1;
            };
        };
        i = i + 1;
    }
    return obj;
}

fn toml_inline_table_segment(obj: u64, inner_ptr: ptr, lo: u64, hi: u64) -> void {
    // eq = seg.indexOf("="); if (eq < 0) continue;
    let eq: u64 = hi;
    let i = lo;
    while i < hi {
        let c: u8 = 0;
        PTR_BYTE_AT(c, inner_ptr, i);
        if c == 61 { eq = i; break; };
        i = i + 1;
    }
    if eq == hi { return; };
    // key = seg.slice(0, eq).trim().replace(/^["']|["']$/g, "")
    let key_node = toml_unquote_key(inner_ptr, lo, eq);
    let val = parseTomlScalar(ptr_add(inner_ptr, eq + 1), hi - eq - 1);
    sa_json_object_set_node(obj, key_node, val);
}

// key unquoting shared by parseTomlHooks/ensurePath segments:
// trim, then strip one leading and one trailing quote char if present
// (TS regex /^["']|["']$/g strips each end independently).
fn toml_unquote_key(p: ptr, lo: u64, hi: u64) -> u64 {
    let a = lo;
    let b = hi;
    while a < b {
        let c: u8 = 0;
        PTR_BYTE_AT(c, p, a);
        if c != 32 {
            if c != 9 { break; };
        };
        a = a + 1;
    }
    while b > a {
        let c: u8 = 0;
        PTR_BYTE_AT(c, p, b - 1);
        if c != 32 {
            if c != 9 { break; };
        };
        b = b - 1;
    }
    if a < b {
        let c: u8 = 0;
        PTR_BYTE_AT(c, p, a);
        if c == 34 { a = a + 1; } else {
            if c == 39 { a = a + 1; };
        };
    };
    if b > a {
        let c: u8 = 0;
        PTR_BYTE_AT(c, p, b - 1);
        if c == 34 { b = b - 1; } else {
            if c == 39 { b = b - 1; };
        };
    };
    return sa_json_string(ptr_add(p, a), b - a);
}

fn slice_nonempty_trimmed(p: ptr, lo: u64, hi: u64) -> bool {
    let i = lo;
    while i < hi {
        let c: u8 = 0;
        PTR_BYTE_AT(c, p, i);
        if c != 32 {
            if c != 9 {
                if c != 10 {
                    if c != 13 { return true; };
                };
            };
        };
        i = i + 1;
    }
    return false;
}

// ---------------------------------------------------------------------------
// TS: function ensurePath(root: Record<string, unknown>, path: string[], isArray: boolean): Record<string, unknown> {
//   let node = root;
//   for (let i = 0; i < path.length - 1; i++) {
//     const k = path[i]!;
//     let nxt = node[k] as unknown;
//     if (!nxt || typeof nxt !== "object" || Array.isArray(nxt)) { nxt = {}; node[k] = nxt; }
//     node = nxt as Record<string, unknown>;
//   }
//   const last = path[path.length - 1]!;
//   if (isArray) {
//     let arr = node[last] as unknown;
//     if (!Array.isArray(arr)) { arr = []; node[last] = arr; }
//     const el: Record<string, unknown> = {};
//     (arr as unknown[]).push(el);
//     return el;
//   }
//   let leaf = node[last] as unknown;
//   if (!leaf || typeof leaf !== "object" || Array.isArray(leaf)) { leaf = {}; node[last] = leaf; }
//   return leaf as Record<string, unknown>;
// }
// Path segments arrive as JSON node handles in path_nodes[0..path_len).
// DEFECT: dynamic object — Record<string, unknown> tree mutation via string
// keys; approximated over JSON object nodes (sa_json_object_get/set_node).
// DEFECT: non-null assertion path[i]! — SLA indexing of the segment array
// is unchecked here in the same way (bounds are the caller's contract).
fn ensurePath(root_node: u64, path_nodes: &u64, path_len: u64, isArray: bool) -> u64 {
    let node = root_node;
    let i: u64 = 0;
    while i + 1 < path_len {
        let k_node = ptr_u64_load(path_nodes, i);
        let nxt: u64 = 0;
        let found = sa_json_object_get_node_by_node(node, k_node, &nxt);
        if found != 0 { nxt = 0; };
        if nxt == 0 { nxt = sa_json_object_new(); sa_json_object_set_node_by_node(node, k_node, nxt); } else {
            if sa_json_kind_of(nxt) != 3 { nxt = sa_json_object_new(); sa_json_object_set_node_by_node(node, k_node, nxt); };
        };
        node = nxt;
        i = i + 1;
    }
    let last_node = ptr_u64_load(path_nodes, path_len - 1);
    if isArray {
        let arr: u64 = 0;
        if sa_json_object_get_node_by_node(node, last_node, &arr) != 0 { arr = 0; };
        if arr == 0 { arr = sa_json_array_new(); sa_json_object_set_node_by_node(node, last_node, arr); } else {
            if sa_json_kind_of(arr) != 2 { arr = sa_json_array_new(); sa_json_object_set_node_by_node(node, last_node, arr); };
        };
        let el = sa_json_object_new();
        sa_json_array_push(arr, el);
        return el;
    };
    let leaf: u64 = 0;
    if sa_json_object_get_node_by_node(node, last_node, &leaf) != 0 { leaf = 0; };
    if leaf == 0 { leaf = sa_json_object_new(); sa_json_object_set_node_by_node(node, last_node, leaf); } else {
        if sa_json_kind_of(leaf) != 3 { leaf = sa_json_object_new(); sa_json_object_set_node_by_node(node, last_node, leaf); };
    };
    return leaf;
}

// TS: /** Minimal TOML subset for hooks: [table] / [[array]] + key = value. Never throws. */
// TS: function parseTomlHooks(text: string): Record<string, unknown> {
//   const root: Record<string, unknown> = {};
//   let cur: Record<string, unknown> = root;
//   for (const rawLine of text.split(/\r?\n/)) {
//     const line = rawLine.split(/(^|[^\\])#/)[0]?.trim() ?? "";
//     if (!line) continue;
//     const arrHead = line.match(/^\[\[\s*([^\]]+?)\s*\]\]$/);
//     const tblHead = line.match(/^\[\s*([^\]]+?)\s*\]$/);
//     if (arrHead) {
//       const path = arrHead[1]!.trim().split(".").map((s) => s.trim().replace(/^["']|["']$/g, ""));
//       if (!path.length) continue;
//       cur = ensurePath(root, path, true);
//       continue;
//     }
//     if (tblHead) { ...same with ensurePath(root, path, false)... }
//     const eq = line.indexOf("=");
//     if (eq < 0) continue;
//     const key = line.slice(0, eq).trim().replace(/^["']|["']$/g, "");
//     if (!key || key.includes(".")) continue;
//     try { cur[key] = parseTomlScalar(line.slice(eq + 1).trim()); } catch { /* skip bad value */ }
//   }
//   return root;
// }
// DEFECT: RegExp — split(/\r?\n/), split(/(^|[^\\])#/) comment stripping,
// and the two header match regexes have no sa_std counterpart; hand byte
// scans below (comment rule: a '#' at start or preceded by a non-backslash
// char ends the line, exactly the TS regex split semantics).
// DEFECT: dynamic object — root/cur are JSON object nodes.
// DEFECT: optional chaining `?.` + nullish `?? ""` on the split result —
// the scan always yields a (possibly empty) line slice.
// DEFECT: try/catch "skip bad value" — parseTomlScalar cannot throw in
// SLA; the catch path is unrepresentable and dropped.
// DEFECT: closure — .map((s) => ...) unquoting of path segments inlined
// into toml_split_path.
fn parseTomlHooks(text_ptr: ptr, text_len: u64) -> u64 {
    let root = sa_json_object_new();
    let cur = root;
    let line_lo: u64 = 0;
    let pos: u64 = 0;
    while pos <= text_len {
        let at_end = false;
        if pos == text_len { at_end = true; };
        let ch: u8 = 0;
        if !at_end { PTR_BYTE_AT(ch, text_ptr, pos); };
        let is_nl = false;
        if ch == 10 { is_nl = true; };
        if at_end { cur = parse_toml_hooks_line(root, cur, text_ptr, line_lo, pos); line_lo = pos; } else {
            if is_nl {
                cur = parse_toml_hooks_line(root, cur, text_ptr, line_lo, pos);
                line_lo = pos + 1;
            };
        };
        pos = pos + 1;
    }
    return root;
}

// One raw line of parseTomlHooks (extracted: SLA has no closures / no
// continue-to-outer-loop; returns the new `cur` node).
// DEFECT: nested function extraction — TS keeps this inline in the loop.
fn parse_toml_hooks_line(root: u64, cur_in: u64, text_ptr: ptr, raw_lo: u64, raw_hi: u64) -> u64 {
    let cur = cur_in;
    // strip trailing \r (from /\r?\n/ split)
    let hi = raw_hi;
    if hi > raw_lo {
        let c: u8 = 0;
        PTR_BYTE_AT(c, text_ptr, hi - 1);
        if c == 13 { hi = hi - 1; };
    };
    // comment split: cut at first '#' that is at start or after a non-'\' char
    let end = hi;
    let i = raw_lo;
    while i < hi {
        let c: u8 = 0;
        PTR_BYTE_AT(c, text_ptr, i);
        if c == 35 {
            if i == raw_lo { end = i; break; };
            let prev: u8 = 0;
            PTR_BYTE_AT(prev, text_ptr, i - 1);
            if prev != 92 { end = i; break; };
        };
        i = i + 1;
    }
    // trim
    let lo = raw_lo;
    let b = end;
    while lo < b {
        let c: u8 = 0;
        PTR_BYTE_AT(c, text_ptr, lo);
        if c != 32 {
            if c != 9 {
                if c != 13 { break; };
            };
        };
        lo = lo + 1;
    }
    while b > lo {
        let c: u8 = 0;
        PTR_BYTE_AT(c, text_ptr, b - 1);
        if c != 32 {
            if c != 9 {
                if c != 13 { break; };
            };
        };
        b = b - 1;
    }
    if lo >= b { return cur; };
    let line_ptr = ptr_add(text_ptr, lo);
    let line_len = b - lo;
    // [[path]] header?
    if line_len >= 4 {
        let c0: u8 = 0;
        let c1: u8 = 0;
        let cl: u8 = 0;
        let cl2: u8 = 0;
        PTR_BYTE_AT(c0, line_ptr, 0);
        PTR_BYTE_AT(c1, line_ptr, 1);
        PTR_BYTE_AT(cl, line_ptr, line_len - 1);
        PTR_BYTE_AT(cl2, line_ptr, line_len - 2);
        if c0 == 91 {
            if c1 == 91 {
                if cl == 93 {
                    if cl2 == 93 {
                        let path_buf: u64 = 0;
                        let path_len = toml_split_path(ptr_add(line_ptr, 2), line_len - 4, &path_buf);
                        if path_len == 0 { return cur; };
                        return ensurePath(root, path_buf, path_len, true);
                    };
                };
            };
        };
        if c0 == 91 {
            if cl == 93 {
                let path_buf: u64 = 0;
                let path_len = toml_split_path(ptr_add(line_ptr, 1), line_len - 2, &path_buf);
                if path_len == 0 { return cur; };
                return ensurePath(root, path_buf, path_len, false);
            };
        };
    };
    // key = value
    let eq: u64 = line_len;
    let j: u64 = 0;
    while j < line_len {
        let c: u8 = 0;
        PTR_BYTE_AT(c, line_ptr, j);
        if c == 61 { eq = j; break; };
        j = j + 1;
    }
    if eq == line_len { return cur; };
    // key: trimmed + unquoted; empty or containing '.' -> skip
    if slice_has_byte(line_ptr, 0, eq, 46) {
        // NOTE: TS tests the *trimmed/unquoted* key for '.'; the scan here
        // covers the raw slice (superset) — divergence logged.
        // DEFECT: string includes(".") on the processed key — approximated on the raw slice.
        return cur;
    };
    let key_node = toml_unquote_key(line_ptr, 0, eq);
    if sa_json_string_len(key_node) == 0 { return cur; };
    let val = parseTomlScalar(ptr_add(line_ptr, eq + 1), line_len - eq - 1);
    sa_json_object_set_node_by_node(cur, key_node, val);
    return cur;
}

// Split a dotted header path on '.', trim + unquote each segment; writes
// segment string-node handles into out_nodes, returns the segment count.
fn toml_split_path(p: ptr, l: u64, out_nodes: &u64) -> u64 {
    let n: u64 = 0;
    let seg_lo: u64 = 0;
    let i: u64 = 0;
    while i <= l {
        let at_end = false;
        if i == l { at_end = true; };
        let ch: u8 = 0;
        if !at_end { PTR_BYTE_AT(ch, p, i); };
        if at_end {
            let seg = toml_unquote_key(p, seg_lo, i);
            ptr_u64_store(out_nodes, n, seg);
            n = n + 1;
        } else {
            if ch == 46 {
                let seg = toml_unquote_key(p, seg_lo, i);
                ptr_u64_store(out_nodes, n, seg);
                n = n + 1;
                seg_lo = i + 1;
            };
        };
        i = i + 1;
    }
    return n;
}

fn slice_has_byte(p: ptr, lo: u64, hi: u64, want: u8) -> bool {
    let i = lo;
    while i < hi {
        let c: u8 = 0;
        PTR_BYTE_AT(c, p, i);
        if c == want { return true; };
        i = i + 1;
    }
    return false;
}

// TS: function normalizeEventsTolerant(raw: unknown): HookEvents {
//   const ev = normalizeEvents(raw);
//   if (Object.keys(ev).length) return ev;
//   // Case-insensitive retry: remap keys like pre_tool_use / hooks.pre_tool_use.
//   if (!raw || typeof raw !== "object" || Array.isArray(raw)) return ev;
//   const rec = raw as Record<string, unknown>;
//   const body = rec.hooks && typeof rec.hooks === "object" && !Array.isArray(rec.hooks)
//     ? (rec.hooks as Record<string, unknown>) : rec;
//   // Also unwrap single "hooks" TOML table nesting: {hooks:{PreToolUse:[...]}}
//   const remapped: Record<string, unknown> = {};
//   for (const [k, v] of Object.entries(body)) {
//     const canon = canonicalEventName(k);
//     if (canon) remapped[canon] = v;
//   }
//   if (!Object.keys(remapped).length) return ev;
//   return normalizeEvents(remapped);
// }
// DEFECT: dynamic object — Object.keys/Object.entries over a dynamic
// record; approximated via sa_json_object_len / key iteration and a rebuilt
// remapped JSON object node.
fn normalizeEventsTolerant(raw_node: u64, out: &HookEvents) -> void {
    normalizeEvents(raw_node, out);
    if hook_events_any(out) { return; };
    if raw_node == 0 { return; };
    if sa_json_kind_of(raw_node) != 3 { return; };
    let body_node = raw_node;
    let hooks_node: u64 = 0;
    if sa_json_object_get(raw_node, STR_PTR("hooks"), STR_LEN("hooks"), &hooks_node) == 0 {
        if sa_json_kind_of(hooks_node) == 3 { body_node = hooks_node; };
    };
    let remapped = sa_json_object_new();
    let any = false;
    let n = sa_json_object_len(body_node);
    let norm: u64 = 0;
    let norm_buf = ByteBuf { bytes: [0u8; 4096], len: 0 };
    // DEFECT: ByteBuf literal capacity 4096 for canonical names — TS strings are unbounded; names here are short header keys.
    for i in 0..n {
        let k_ptr: ptr = PTR_NULL();
        let k_len: u64 = 0;
        let v_node: u64 = 0;
        if sa_json_object_entry_at(body_node, i, &k_ptr, &k_len, &v_node) != 0 { continue; };
        let canon = canonicalEventName(k_ptr, k_len, &norm_buf);
        if canon < 12 {
            let cn_len: u64 = 0;
            let cn_ptr = HOOK_EVENT_NAMES_at(canon, &cn_len);
            sa_json_object_set(remapped, cn_ptr, cn_len, v_node);
            any = true;
        };
        norm = norm + 0;
    }
    if !any { return; };
    normalizeEvents(remapped, out);
}

// TS: function parseHookFile(text: string, path: string): HookEvents {
//   try {
//     if (path.endsWith(".toml")) {
//       const parsed = parseTomlHooks(text);
//       // config.toml nests under [hooks.*]: unwrap one level if present.
//       const maybeHooks = (parsed as Record<string, unknown>).hooks;
//       const doc = maybeHooks && typeof maybeHooks === "object" && !Array.isArray(maybeHooks)
//         ? { ...(parsed as Record<string, unknown>), ...(maybeHooks as Record<string, unknown>), hooks: maybeHooks }
//         : parsed;
//       return normalizeEventsTolerant(maybeHooks ?? doc);
//     }
//     const parsed = JSON.parse(text) as unknown;
//     return normalizeEventsTolerant(parsed);
//   } catch { return {}; }
// }
// DEFECT: try/catch — JSON.parse failure returns {}; SLA parse returns a
// status, approximated by checking sa_json_parse status (no exceptions).
// DEFECT: object spread merge { ...parsed, ...maybeHooks, hooks: maybeHooks }
// — the merged `doc` is only used via `maybeHooks ?? doc`, and maybeHooks is
// defined exactly when doc would carry extra keys; approximated by passing
// maybeHooks when present, else parsed (the spread-only keys are lost).
// DEFECT: string endsWith(".toml") — byte suffix compare.
fn parseHookFile(text_ptr: ptr, text_len: u64, path_ptr: ptr, path_len: u64, out: &HookEvents) -> void {
    hook_events_reset(out);
    if path_len >= 5 {
        let is_toml = bytes_eq(ptr_add(path_ptr, path_len - 5), 5, STR_PTR(".toml"), STR_LEN(".toml"));
        if is_toml {
            let parsed = parseTomlHooks(text_ptr, text_len);
            let maybeHooks: u64 = 0;
            let has_mh = false;
            if sa_json_object_get(parsed, STR_PTR("hooks"), STR_LEN("hooks"), &maybeHooks) == 0 {
                if sa_json_kind_of(maybeHooks) == 3 { has_mh = true; };
            };
            if has_mh { normalizeEventsTolerant(maybeHooks, out); return; };
            normalizeEventsTolerant(parsed, out);
            return;
        };
    };
    let parsed: u64 = 0;
    if sa_json_parse(text_ptr, text_len, &parsed) != 0 { return; };
    normalizeEventsTolerant(parsed, out);
}

// TS: /** Load hooks from all Codex-parity sources. Never throws.
//  * Order: user config.toml [hooks.*] -> user hooks.toml/json ->
//  * project .codex/hooks.toml/json. Missing/unreadable = no hooks. */
// TS: export async function loadHookEvents(cwd: string, force = false): Promise<HookEvents> {
//   const now = Date.now();
//   if (!force && cache && cache.cwd === cwd && now - cache.at < 30_000) return cache.events;
//   const home = codexHome();
//   const files: Array<{ path: string; source: HookSource }> = [
//     { path: join(home, "config.toml"), source: "user" },
//     { path: join(home, "hooks.toml"), source: "user" },
//     { path: join(home, "hooks.json"), source: "user" },
//     ...(cwd ? [
//       { path: join(cwd, ".codex", "hooks.toml"), source: "project" as HookSource },
//       { path: join(cwd, ".codex", "hooks.json"), source: "project" as HookSource },
//     ] : []),
//   ];
//   const merged: HookEvents = {};
//   const seen: Array<{ path: string; source: HookSource }> = [];
//   const perFile: Array<{ path: string; source: HookSource; events: HookEvents }> = [];
//   for (const f of files) {
//     try {
//       const text = await readFile(f.path, "utf8");
//       const ev = parseHookFile(text, f.path);
//       seen.push(f);
//       perFile.push({ path: f.path, source: f.source, events: ev });
//       for (const name of HOOK_EVENT_NAMES) {
//         if (ev[name]?.length) (merged[name] ??= []).push(...ev[name]!);
//       }
//     } catch { /* missing/unreadable = no hooks, like Codex */ }
//   }
//   cache = { at: now, cwd, events: merged, files: seen, perFile };
//   return merged;
// }
// SLA approximation: synchronous; fills `out` with merged events and updates
// state.cache; returns 0.
// DEFECT: async — async/await readFile (node:fs/promises) has no SLA
// counterpart; synchronous sa_std_fs read used, ordering preserved.
// DEFECT: Date.now() wall clock / 30_000 ms cache window — approximated by
// sa_std monotonic/wall extern (fix phase picks the clock); the comparison
// arithmetic is preserved.
// DEFECT: conditional spread of the files array `...(cwd ? [...] : [])` —
// explicit count 3 or 5.
// DEFECT: try/catch per file (missing/unreadable = skip) — read status code.
// DEFECT: optional chaining ev[name]?.length, nullish assignment ??= and
// array spread push (...ev[name]!) — explicit len checks + group copies.
// DEFECT: module-global cache assignment — state struct passed in.
fn loadHookEvents(state: &HookModuleState, cwd_ptr: ptr, cwd_len: u64, force: bool, out: &HookEvents) -> i32 {
    let now = sa_time_now_ms();
    if !force {
        if state.has_cache {
            if bytes_eq(state.cache.cwd_ptr, state.cache.cwd_len, cwd_ptr, cwd_len) {
                if now - state.cache.at < 30000 {
                    hook_events_copy(out, &state.cache.events);
                    return 0;
                };
            };
        };
    };
    let home_buf = ByteBuf { bytes: [0u8; 4096], len: 0 };
    codexHome(&home_buf);
    // candidate files: home/config.toml, home/hooks.toml, home/hooks.json,
    // [cwd/.codex/hooks.toml, cwd/.codex/hooks.json]
    let file_count: u64 = 3;
    if cwd_len > 0 { file_count = 5; };
    hook_events_reset(out);
    state.cache.files_len = 0;
    state.cache.perFile_len = 0;
    for fi in 0..file_count {
        let path_buf = ByteBuf { bytes: [0u8; 4096], len: 0 };
        let source: u64 = 0;
        if fi < 3 {
            buf_append_slice(&path_buf, buf_ptr(&home_buf), 0, home_buf.len);
            buf_append_lit(&path_buf, STR_PTR("/"), STR_LEN("/"));
            source = 0;
        } else {
            buf_append_slice(&path_buf, cwd_ptr, 0, cwd_len);
            buf_append_lit(&path_buf, STR_PTR("/.codex/"), STR_LEN("/.codex/"));
            source = 1;
        };
        if fi == 0 { buf_append_lit(&path_buf, STR_PTR("config.toml"), STR_LEN("config.toml")); };
        if fi == 1 { buf_append_lit(&path_buf, STR_PTR("hooks.toml"), STR_LEN("hooks.toml")); };
        if fi == 2 { buf_append_lit(&path_buf, STR_PTR("hooks.json"), STR_LEN("hooks.json")); };
        if fi == 3 { buf_append_lit(&path_buf, STR_PTR("hooks.toml"), STR_LEN("hooks.toml")); };
        if fi == 4 { buf_append_lit(&path_buf, STR_PTR("hooks.json"), STR_LEN("hooks.json")); };
        let text_buf = ByteBuf { bytes: [0u8; 262144], len: 0 };
        // DEFECT: file content buffer capacity 262144 — TS readFile is unbounded.
        if sa_std_fs_read_file(buf_ptr(&path_buf), path_buf.len, &text_buf) != 0 { continue; };
        let ev = hook_events_new();
        // DEFECT: default construction — TS `const ev` is a fresh plain object; hook_events_new() stands in for it (fix phase provides the constructor).
        parseHookFile(buf_ptr(&text_buf), text_buf.len, buf_ptr(&path_buf), path_buf.len, &ev);
        hook_cache_push_file(state, buf_ptr(&path_buf), path_buf.len, source);
        hook_cache_push_per_file(state, buf_ptr(&path_buf), path_buf.len, source, &ev);
        for name_idx in 0..12 {
            hook_events_merge_groups(out, &ev, name_idx);
        }
    }
    state.cache.at = now;
    state.cache.cwd_ptr = cwd_ptr;
    state.cache.cwd_len = cwd_len;
    hook_events_copy(&state.cache.events, out);
    state.has_cache = true;
    return 0;
}

// TS: export function hookFilesLoaded(): Array<{ path: string; source: HookSource }> {
//   return cache?.files ?? [];
// }
// SLA approximation: copies cache.files into out arrays, returns count.
// DEFECT: optional chaining cache?.files + nullish ?? [] — has_cache check;
// returning the live array reference is approximated by copying refs out.
fn hookFilesLoaded(state: &HookModuleState, out_paths: &u64, out_lens: &u64, out_sources: &u64) -> u64 {
    if !state.has_cache { return 0; };
    let n = state.cache.files_len;
    for i in 0..n {
        ptr_u64_store(out_paths, i, ptr_to_u64(state.cache.files[i].path_ptr));
        ptr_u64_store(out_lens, i, state.cache.files[i].path_len);
        ptr_u64_store(out_sources, i, state.cache.files[i].source);
    }
    return n;
}

// TS: /** Codex matcher semantics: empty matcher matches all; else regex against tool_name. */
// TS: export function matcherMatches(matcher: string | undefined, toolName: string): boolean {
//   if (!matcher || !matcher.trim()) return true;
//   try {
//     return new RegExp(matcher).test(toolName);
//   } catch {
//     return toolName.includes(matcher);
//   }
// }
// DEFECT: RegExp — new RegExp(matcher).test(toolName) has no sa_std
// counterpart; approximated by substring search (which is exactly the TS
// catch fallback, toolName.includes(matcher)). Regex-only matchers
// (anchors, classes, alternation) will diverge until a regex engine lands.
// DEFECT: try/catch around RegExp construction — invalid-pattern fallback
// is the only path taken here.
fn matcherMatches(has_matcher: bool, matcher_ptr: ptr, matcher_len: u64, toolName_ptr: ptr, toolName_len: u64) -> bool {
    if !has_matcher { return true; };
    if !slice_nonempty_trimmed(matcher_ptr, 0, matcher_len) { return true; };
    return bytes_contains(toolName_ptr, toolName_len, matcher_ptr, matcher_len);
}

// TS: export function selectHookHandlers(events: HookEvents, eventName: HookEventName, toolName: string): Array<{ group: MatcherGroup; handler: HookHandlerConfig; index: number }> {
//   const out: Array<{ group: MatcherGroup; handler: HookHandlerConfig; index: number }> = [];
//   const groups = events[eventName] ?? [];
//   let order = 0;
//   for (const g of groups) {
//     if (!matcherMatches(g.matcher, toolName)) { order += g.hooks.length; continue; }
//     for (const h of g.hooks) out.push({ group: g, handler: h, index: order++ });
//   }
//   return out;
// }
// SLA approximation: writes matched (group_slot, handler_slot, index)
// triples into caller arrays; slots are (events_base, event_name, gi, hi)
// coordinates resolved by hook_handler_at(). Returns match count.
// DEFECT: array of anonymous objects {group, handler, index} holding live
// object references — coordinate tuples used instead of references.
// DEFECT: dynamic key access events[eventName] + ?? [] — hook_events_len /
// per-event arrays.
fn selectHookHandlers(events: &HookEvents, eventName: u64, toolName_ptr: ptr, toolName_len: u64, out_gi: &u64, out_hi: &u64, out_index: &u64) -> u64 {
    let n: u64 = 0;
    let order: u64 = 0;
    let gcount = hook_events_len(events, eventName);
    for gi in 0..gcount {
        let g = hook_events_group_at(events, eventName, gi);
        if !matcherMatches(g.has_matcher, g.matcher_ptr, g.matcher_len, toolName_ptr, toolName_len) {
            order = order + g.hooks_len;
            continue;
        };
        for hi in 0..g.hooks_len {
            ptr_u64_store(out_gi, n, gi);
            ptr_u64_store(out_hi, n, hi);
            ptr_u64_store(out_index, n, order);
            order = order + 1;
            n = n + 1;
        }
    }
    return n;
}

// TS: /** Codex mcp_hook_tool_input parity: tool_input is the resolved JSON args object. */
// TS: export function mcpHookToolInput(args: unknown): Record<string, unknown> {
//   if (args && typeof args === "object" && !Array.isArray(args)) return args as Record<string, unknown>;
//   if (typeof args === "string") {
//     if (!args.trim()) return {};
//     try {
//       const p = JSON.parse(args) as unknown;
//       if (p && typeof p === "object" && !Array.isArray(p)) return p as Record<string, unknown>;
//       return { _raw: args };
//     } catch { return { _raw: args }; }
//   }
//   return {};
// }
// Returns a JSON object node handle in every path ({} / args / {_raw}).
// DEFECT: dynamic object — unknown dispatch + object literal { _raw: args }
// built via the JSON layer.
// DEFECT: try/catch around JSON.parse — parse status code.
fn mcpHookToolInput(args_node: u64) -> u64 {
    let kind = sa_json_kind_of(args_node);
    if kind == 3 { return args_node; };
    if kind == 1 {
        let p: ptr = sa_json_string_ptr(args_node);
        let l: u64 = sa_json_string_len(args_node);
        if !slice_nonempty_trimmed(p, 0, l) { return sa_json_empty_object(); };
        let parsed: u64 = 0;
        if sa_json_parse(p, l, &parsed) == 0 {
            if sa_json_kind_of(parsed) == 3 { return parsed; };
        };
        let raw_obj = sa_json_object_new();
        sa_json_object_set_string(raw_obj, STR_PTR("_raw"), STR_LEN("_raw"), p, l);
        return raw_obj;
    };
    return sa_json_empty_object();
}

// ---------------------------------------------------------------------------
// TS: export interface HookTemplateCtx extends Record<string, unknown> {
//   tool_name: string; tool_use_id: string; cwd: string;
//   session_id: string; turn_id: string; server: string; tool: string;
//   tool_input: Record<string, unknown>;
// }
// DEFECT: interface extending Record<string, unknown> (open index
// signature) — the known fields are a struct; arbitrary extra keys have no
// home and are dropped (lookupPath only ever reads the known fields in
// practice, plus tool_input.* subpaths).
// DEFECT: dynamic object — tool_input is a JSON node handle.
struct HookTemplateCtx {
    tool_name_ptr: ptr, tool_name_len: u64,
    tool_use_id_ptr: ptr, tool_use_id_len: u64,
    cwd_ptr: ptr, cwd_len: u64,
    session_id_ptr: ptr, session_id_len: u64,
    turn_id_ptr: ptr, turn_id_len: u64,
    server_ptr: ptr, server_len: u64,
    tool_ptr: ptr, tool_len: u64,
    tool_input_node: u64,
}

// Build the Record view of a HookTemplateCtx as a JSON object node
// (the TS passes ctx itself where a Record is expected).
fn hook_template_ctx_to_node(ctx: &HookTemplateCtx) -> u64 {
    let obj = sa_json_object_new();
    sa_json_object_set_string(obj, STR_PTR("tool_name"), STR_LEN("tool_name"), ctx.tool_name_ptr, ctx.tool_name_len);
    sa_json_object_set_string(obj, STR_PTR("tool_use_id"), STR_LEN("tool_use_id"), ctx.tool_use_id_ptr, ctx.tool_use_id_len);
    sa_json_object_set_string(obj, STR_PTR("cwd"), STR_LEN("cwd"), ctx.cwd_ptr, ctx.cwd_len);
    sa_json_object_set_string(obj, STR_PTR("session_id"), STR_LEN("session_id"), ctx.session_id_ptr, ctx.session_id_len);
    sa_json_object_set_string(obj, STR_PTR("turn_id"), STR_LEN("turn_id"), ctx.turn_id_ptr, ctx.turn_id_len);
    sa_json_object_set_string(obj, STR_PTR("server"), STR_LEN("server"), ctx.server_ptr, ctx.server_len);
    sa_json_object_set_string(obj, STR_PTR("tool"), STR_LEN("tool"), ctx.tool_ptr, ctx.tool_len);
    sa_json_object_set_node_key(obj, STR_PTR("tool_input"), STR_LEN("tool_input"), ctx.tool_input_node);
    return obj;
}

// TS: function lookupPath(ctx: Record<string, unknown>, path: string): unknown {
//   const parts = path.split(".");
//   let cur: unknown = ctx;
//   for (const p of parts) {
//     if (!cur || typeof cur !== "object" || Array.isArray(cur)) return undefined;
//     cur = (cur as Record<string, unknown>)[p];
//   }
//   return cur;
// }
// Returns the node found, or 0 for the TS `undefined` result.
// DEFECT: dynamic object — unknown traversal over JSON nodes; `undefined`
// encoded as node 0.
fn lookupPath(ctx_node: u64, path_ptr: ptr, path_len: u64) -> u64 {
    let cur = ctx_node;
    let seg_lo: u64 = 0;
    let i: u64 = 0;
    while i <= path_len {
        let at_end = false;
        if i == path_len { at_end = true; };
        let ch: u8 = 0;
        if !at_end { PTR_BYTE_AT(ch, path_ptr, i); };
        if at_end {
            if sa_json_kind_of(cur) != 3 { return 0; };
            let nxt: u64 = 0;
            if sa_json_object_get(cur, ptr_add(path_ptr, seg_lo), i - seg_lo, &nxt) != 0 { return 0; };
            cur = nxt;
        } else {
            if ch == 46 {
                if sa_json_kind_of(cur) != 3 { return 0; };
                let nxt: u64 = 0;
                if sa_json_object_get(cur, ptr_add(path_ptr, seg_lo), i - seg_lo, &nxt) != 0 { return 0; };
                cur = nxt;
                seg_lo = i + 1;
            };
        };
        i = i + 1;
    }
    return cur;
}

// TS: function expandTemplateString(s: string, ctx: Record<string, unknown>): string {
//   return s.replace(/\$\{([^}]+)\}/g, (_, expr: string) => {
//     const v = lookupPath(ctx, expr.trim());
//     if (v === undefined || v === null) return "";
//     if (typeof v === "string") return v;
//     try { return JSON.stringify(v) ?? ""; } catch { return String(v); }
//   });
// }
// DEFECT: RegExp replace /\$\{([^}]+)\}/g with a replacer callback
// (closure) — hand scan for "${" ... "}" segments; the callback body is
// expand_template_expr() below.
// DEFECT: try/catch + JSON.stringify(v) ?? "" / String(v) fallback —
// stringify status approximated; String(v) for non-JSON values (functions,
// symbols — impossible from JSON input) is not reproduced.
fn expandTemplateString(s_ptr: ptr, s_len: u64, ctx_node: u64, out: &ByteBuf) -> void {
    buf_reset(out);
    let i: u64 = 0;
    while i < s_len {
        let c: u8 = 0;
        PTR_BYTE_AT(c, s_ptr, i);
        let next: u8 = 0;
        if i + 1 < s_len { PTR_BYTE_AT(next, s_ptr, i + 1); };
        if c == 36 {
            if next == 123 {
                // find closing '}'
                let j = i + 2;
                let close: u64 = s_len;
                while j < s_len {
                    let cj: u8 = 0;
                    PTR_BYTE_AT(cj, s_ptr, j);
                    if cj == 125 { close = j; break; };
                    j = j + 1;
                }
                if close < s_len {
                    if close > i + 2 {
                        expand_template_expr(out, ctx_node, ptr_add(s_ptr, i + 2), close - (i + 2));
                        i = close + 1;
                        continue;
                    };
                };
            };
        };
        buf_append_byte(out, c);
        i = i + 1;
    }
}

// Replacer body of expandTemplateString for one ${expr} segment.
// DEFECT: nested function extraction — TS inline arrow closure.
fn expand_template_expr(out: &ByteBuf, ctx_node: u64, expr_ptr: ptr, expr_len: u64) -> void {
    // expr.trim()
    let lo: u64 = 0;
    let hi: u64 = expr_len;
    while lo < hi {
        let c: u8 = 0;
        PTR_BYTE_AT(c, expr_ptr, lo);
        if c != 32 {
            if c != 9 {
                if c != 10 {
                    if c != 13 { break; };
                };
            };
        };
        lo = lo + 1;
    }
    while hi > lo {
        let c: u8 = 0;
        PTR_BYTE_AT(c, expr_ptr, hi - 1);
        if c != 32 {
            if c != 9 {
                if c != 10 {
                    if c != 13 { break; };
                };
            };
        };
        hi = hi - 1;
    }
    let v = lookupPath(ctx_node, ptr_add(expr_ptr, lo), hi - lo);
    if v == 0 { return; };
    let kind = sa_json_kind_of(v);
    if kind == 5 { return; };
    if kind == 1 {
        let p: ptr = sa_json_string_ptr(v);
        let l: u64 = sa_json_string_len(v);
        buf_append_slice(out, p, 0, l);
        return;
    };
    sa_json_stringify_into(v, out);
}

// TS: function renderValue(v: unknown, ctx: Record<string, unknown>): unknown {
//   if (typeof v === "string") return expandTemplateString(v, ctx);
//   if (Array.isArray(v)) return v.map((x) => renderValue(x, ctx));
//   if (v && typeof v === "object") {
//     const out: Record<string, unknown> = {};
//     for (const [k, val] of Object.entries(v as Record<string, unknown>)) out[k] = renderValue(val, ctx);
//     return out;
//   }
//   return v;
// }
// DEFECT: dynamic value — recursion over unknown via JSON node kinds;
// Array.map / Object.entries with closures replaced by explicit loops
// building fresh JSON nodes (TS also builds fresh containers).
fn renderValue(v_node: u64, ctx_node: u64, scratch: &ByteBuf) -> u64 {
    let kind = sa_json_kind_of(v_node);
    if kind == 1 {
        let p: ptr = sa_json_string_ptr(v_node);
        let l: u64 = sa_json_string_len(v_node);
        expandTemplateString(p, l, ctx_node, scratch);
        return sa_json_string(buf_ptr(scratch), scratch.len);
    };
    if kind == 2 {
        let arr = sa_json_array_new();
        let n = sa_json_array_len(v_node);
        for i in 0..n {
            let el: u64 = 0;
            if sa_json_array_get(v_node, i, &el) == 0 {
                sa_json_array_push(arr, renderValue(el, ctx_node, scratch));
            };
        }
        return arr;
    };
    if kind == 3 {
        let obj = sa_json_object_new();
        let n = sa_json_object_len(v_node);
        for i in 0..n {
            let k_ptr: ptr = PTR_NULL();
            let k_len: u64 = 0;
            let val: u64 = 0;
            if sa_json_object_entry_at(v_node, i, &k_ptr, &k_len, &val) == 0 {
                sa_json_object_set(obj, k_ptr, k_len, renderValue(val, ctx_node, scratch));
            };
        }
        return obj;
    };
    return v_node;
}

// TS: /** Render an mcp_tool handler input template (Codex: ${tool_input.*} etc.). Throws on null. */
// TS: export function renderMcpHookInput(input: Record<string, unknown>, ctx: HookTemplateCtx): Record<string, unknown> {
//   const rendered = renderValue(input, ctx as unknown as Record<string, unknown>) as Record<string, unknown>;
//   if (containsNull(rendered)) throw new Error("MCP hook input must be representable as TOML (null rejected, Codex parity)");
//   return rendered;
// }
// Returns the rendered node, or 0 when the TS would throw (caller maps 0
// to the error entry "MCP hook input must be representable as TOML (null
// rejected, Codex parity)").
// DEFECT: throw Error — no exceptions in SLA; 0 sentinel + caller-side
// error text (the only caller, executeHooks, catches it the same way).
fn renderMcpHookInput(input_node: u64, ctx: &HookTemplateCtx, scratch: &ByteBuf) -> u64 {
    let ctx_node = hook_template_ctx_to_node(ctx);
    let rendered = renderValue(input_node, ctx_node, scratch);
    if containsNull(rendered) { return 0; };
    return rendered;
}

// TS: function preToolUseStdin(c: { sessionId: string; turnId: string; cwd: string; model: string; toolName: string; toolInput: unknown; toolUseId: string }): string {
//   return JSON.stringify({
//     session_id: c.sessionId, turn_id: c.turnId, transcript_path: null, cwd: c.cwd,
//     hook_event_name: "PreToolUse", model: c.model, permission_mode: "default",
//     tool_name: c.toolName, tool_input: c.toolInput ?? {}, tool_use_id: c.toolUseId,
//   });
// }
// DEFECT: dynamic object — anonymous parameter object type + object
// literal passed to JSON.stringify; built as a JSON node then stringified.
// Key order 1:1 with the TS literal (JSON.stringify preserves it).
// DEFECT: nullish `c.toolInput ?? {}` — toolInput_node 0 -> empty object.
fn preToolUseStdin(sessionId_ptr: ptr, sessionId_len: u64, turnId_ptr: ptr, turnId_len: u64, cwd_ptr: ptr, cwd_len: u64, model_ptr: ptr, model_len: u64, toolName_ptr: ptr, toolName_len: u64, toolInput_node: u64, toolUseId_ptr: ptr, toolUseId_len: u64, out: &ByteBuf) -> void {
    let obj = sa_json_object_new();
    sa_json_object_set_string(obj, STR_PTR("session_id"), STR_LEN("session_id"), sessionId_ptr, sessionId_len);
    sa_json_object_set_string(obj, STR_PTR("turn_id"), STR_LEN("turn_id"), turnId_ptr, turnId_len);
    sa_json_object_set_null(obj, STR_PTR("transcript_path"), STR_LEN("transcript_path"));
    sa_json_object_set_string(obj, STR_PTR("cwd"), STR_LEN("cwd"), cwd_ptr, cwd_len);
    sa_json_object_set_string(obj, STR_PTR("hook_event_name"), STR_LEN("hook_event_name"), STR_PTR("PreToolUse"), STR_LEN("PreToolUse"));
    sa_json_object_set_string(obj, STR_PTR("model"), STR_LEN("model"), model_ptr, model_len);
    sa_json_object_set_string(obj, STR_PTR("permission_mode"), STR_LEN("permission_mode"), STR_PTR("default"), STR_LEN("default"));
    sa_json_object_set_string(obj, STR_PTR("tool_name"), STR_LEN("tool_name"), toolName_ptr, toolName_len);
    let ti = toolInput_node;
    if ti == 0 { ti = sa_json_empty_object(); };
    sa_json_object_set_node_key(obj, STR_PTR("tool_input"), STR_LEN("tool_input"), ti);
    sa_json_object_set_string(obj, STR_PTR("tool_use_id"), STR_LEN("tool_use_id"), toolUseId_ptr, toolUseId_len);
    buf_reset(out);
    sa_json_stringify_into(obj, out);
}

// TS: function postToolUseStdin(c: { ...same + toolResponse: unknown }): string {
//   return JSON.stringify({
//     session_id: c.sessionId, turn_id: c.turnId, transcript_path: null, cwd: c.cwd,
//     hook_event_name: "PostToolUse", model: c.model, permission_mode: "default",
//     tool_name: c.toolName, tool_input: c.toolInput ?? {}, tool_response: c.toolResponse ?? {},
//     tool_use_id: c.toolUseId,
