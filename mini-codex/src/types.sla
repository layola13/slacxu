// Converted 1:1 from mini-codex/src/types.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
// Pure type file -> struct/constant declarations.
@import "sa_std/ptr.sa"
@import "sa_std/string.sa"

// ThreadItem discriminated union (TS lines 1-7) -> tag constants + one struct.
// DEFECT: discriminated union | SLA has no union types; approximated with a kind tag + all variant fields present.
const THREAD_ITEM_USER: u64 = 0;
const THREAD_ITEM_MESSAGE: u64 = 1;
const THREAD_ITEM_REASONING: u64 = 2;
const THREAD_ITEM_FUNCTION_CALL: u64 = 3;
const THREAD_ITEM_FUNCTION_CALL_OUTPUT: u64 = 4;
const THREAD_ITEM_PLAN: u64 = 5;

// Inline plan step shape from the "plan" variant: { step: string; status: string }.
struct ThreadPlanStep {
    step: [u8; 512], step_len: u64,
    status: [u8; 32], status_len: u64,
}

struct ThreadItem {
    kind: u64, // one of THREAD_ITEM_* above; TS: type: "user"|"message"|"reasoning"|"function_call"|"function_call_output"|"plan"
    text: [u8; 8192], text_len: u64, // user/message/reasoning/plan variants
    call_id: [u8; 128], call_id_len: u64, // function_call / function_call_output variants
    name: [u8; 256], name_len: u64, // function_call variant
    args: [u8; 8192], args_len: u64, // function_call variant (JSON text)
    output: [u8; 8192], output_len: u64, // function_call_output variant
    // DEFECT: optional dynamic array | images?: string[] has no fixed-capacity equivalent; kept as a JSON text buffer of the string array.
    images_json: [u8; 8192], images_json_len: u64, has_images: bool,
    plan: [ThreadPlanStep; 20], plan_len: u64, // plan variant: Array<{ step, status }>
}

// ToolDef (TS lines 9-13).
struct ToolDef {
    name: [u8; 256], name_len: u64,
    description: [u8; 1024], description_len: u64,
    // DEFECT: dynamic object | schema: Record<string, unknown> kept as a JSON text buffer.
    schema_json: [u8; 8192], schema_json_len: u64,
}

// One entry of TurnResult.calls: { callId: string; name: string; args: string }.
struct TurnCall {
    call_id: [u8; 128], call_id_len: u64,
    name: [u8; 256], name_len: u64,
    args: [u8; 8192], args_len: u64,
}

// TurnResult (TS lines 15-21).
struct TurnResult {
    items: [ThreadItem; 256], items_len: u64,
    calls: [TurnCall; 64], calls_len: u64,
    text: [u8; 8192], text_len: u64,
    // Stored response id (responses protocol) for previous_response_id chaining.
    // TS: responseId?: string -> optional approximated with a presence flag.
    response_id: [u8; 256], response_id_len: u64, has_response_id: bool,
}

// ---------------------------------------------------------------------------
// Shared byte-buffer scaffolding for the mini-codex domain.
// The bulk converter emitted buf_* calls in tools.sla / hooks.sla (JSON text
// builders) and ByteBuf literals in both, but never emitted the definitions
// anywhere in the domain. They live here because types.sla is the one unit
// every consumer already imports (a second definition in any sibling unit
// would collide in loop.sla, which imports tools + hooks together).
// ---------------------------------------------------------------------------
struct ByteBuf {
    bytes: [u8; 262144],
    len: u64,
}

fn buf_reset(b: &ByteBuf) {
    b.len = 0;
}

fn buf_ptr(b: &ByteBuf) -> ptr {
    let p: ptr = PTR_NULL();
    PTR_BYTE_ADD(p, &b.bytes, 0);
    return p;
}

fn buf_append_byte(b: &ByteBuf, c: u8) {
    if b.len < 262144 {
        b.bytes[b.len] = c;
        b.len = b.len + 1;
    };
}

fn buf_append_slice(b: &ByteBuf, src: ptr, n: u64) {
    let i: u64 = 0;
    while i < n {
        let c: u8 = 0;
        PTR_BYTE_AT(c, src, i);
        buf_append_byte(b, c);
        i = i + 1;
    }
}

fn buf_append_lit(b: &ByteBuf, src: ptr, n: u64) {
    buf_append_slice(b, src, n);
}

fn buf_append_u64_dec(b: &ByteBuf, v: u64) {
    let digits: [u8; 20] = [0u8; 20];
    let n: u64 = 0;
    let x = v;
    if x == 0 {
        buf_append_byte(b, 48);
        return;
    };
    while x > 0 {
        digits[n] = 48 + (x % 10) as u8;
        n = n + 1;
        x = x / 10;
    }
    while n > 0 {
        n = n - 1;
        buf_append_byte(b, digits[n]);
    }
}

fn buf_append_i32_dec(b: &ByteBuf, v: i32) {
    let x = v;
    if x < 0 {
        buf_append_byte(b, 45);
        x = 0 - x;
    };
    buf_append_u64_dec(b, x as u64);
}

fn bytes_eq(a: ptr, a_len: u64, b: ptr, b_len: u64) -> bool {
    if a_len != b_len { return false; };
    for i in 0..a_len {
        let x: u8 = 0;
        let y: u8 = 0;
        PTR_BYTE_AT(x, a, i);
        PTR_BYTE_AT(y, b, i);
        if x != y { return false; };
    }
    return true;
}

// Range append: copies src[start..end] (the converter's 4-arg slice form
// used throughout hooks.sla).
fn buf_append_range(b: &ByteBuf, src: ptr, start: u64, end: u64) {
    let i: u64 = start;
    while i < end {
        let c: u8 = 0;
        PTR_BYTE_AT(c, src, i);
        buf_append_byte(b, c);
        i = i + 1;
    }
}

// Pointer helpers the converter assumed as free functions (hooks.sla uses
// ptr_add / ptr_u64_load / ptr_u64_store / ptr_to_u64 throughout).
fn ptr_add(p: ptr, off: u64) -> ptr {
    let q: ptr = PTR_NULL();
    PTR_BYTE_ADD(q, p, off);
    return q;
}

fn ptr_to_u64(p: ptr) -> u64 {
    let v: u64 = 0;
    PTR_ADDR(v, p);
    return v;
}

fn ptr_u64_load(p: ptr, idx: u64) -> u64 {
    let q: ptr = PTR_NULL();
    PTR_BYTE_ADD(q, p, idx * 8);
    let v: u64 = 0;
    PTR_READ_U64(v, q);
    return v;
}

fn ptr_u64_store(p: ptr, idx: u64, v: u64) {
    let q: ptr = PTR_NULL();
    PTR_BYTE_ADD(q, p, idx * 8);
    PTR_WRITE_U64(q, v);
}
