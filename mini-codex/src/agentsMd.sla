// Converted 1:1 from mini-codex/src/agentsMd.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "sa_std/io/print.sai"
@import "sa_std/ptr.sa"
// DEFECT: Node API | node:fs existsSync/readFileSync/statSync and node:path dirname/join/resolve approximated via sa_std fs externs (sa_std_fs_exists / sa_std_fs_is_file / sa_std_fs_read) plus byte-wise path helpers below.
// @import "sa_std/fs.sai"

/** Cap for injected AGENTS.md text (upstream parity: bounded repo instructions). */
const AGENTS_MD_MAX_BYTES: u64 = 8192;
/** How far up the tree to look (covers repo root + a few parent scopes). */
const AGENTS_MD_MAX_LEVELS: u64 = 12;

// One path string (TS string -> fixed buffer + len).
struct MdPath {
    bytes: [u8; 1024], len: u64,
}

// string[] carrier for findAgentsMdFiles' return.
struct MdPathList {
    paths: [MdPath; 12], len: u64,
}

// Growable text buffer for loadAgentsMd's return value.
struct MdStr {
    bytes: [u8; 16384], len: u64,
}

fn mdStrPushByte(out: &MdStr, b: u8) {
    if out.len < 16384 {
        out.bytes[out.len] = b;
        out.len = out.len + 1;
    };
}

fn mdStrPush(out: &MdStr, src: ptr, src_len: u64) {
    let i: u64 = 0;
    while i < src_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, src, i);
        mdStrPushByte(out, b);
        i = i + 1;
    }
}

fn mdPathPushByte(p: &MdPath, b: u8) {
    if p.len < 1024 {
        p.bytes[p.len] = b;
        p.len = p.len + 1;
    };
}

fn mdPathPush(p: &MdPath, src: ptr, src_len: u64) {
    let i: u64 = 0;
    while i < src_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, src, i);
        mdPathPushByte(p, b);
        i = i + 1;
    }
}

// join(dir, "AGENTS.md") — byte concatenation with '/'.
// DEFECT: Node API | path.join platform separators not reproduced (POSIX '/' only).
fn joinAgentsMd(dir: &MdPath, out: &MdPath) {
    out.len = 0;
    let dp: ptr = PTR_NULL();
    PTR_BYTE_ADD(dp, &dir.bytes, 0);
    mdPathPush(out, dp, dir.len);
    if dir.len > 0 {
        let last: u8 = 0;
        PTR_BYTE_AT(last, dp, dir.len - 1);
        if last != 47 { mdPathPushByte(out, 47); }; // '/'
    };
    mdPathPush(out, STR_PTR("AGENTS.md"), STR_LEN("AGENTS.md"));
}

// dirname(dir) — strip the last path component in place.
// DEFECT: Node API | path.dirname approximated byte-wise; root/edge cases ("/", trailing slashes) only roughly match.
fn dirnameInPlace(dir: &MdPath) {
    let dp: ptr = PTR_NULL();
    PTR_BYTE_ADD(dp, &dir.bytes, 0);
    let n = dir.len;
    // drop trailing slashes (keeping a lone root)
    while n > 1 {
        let b: u8 = 0;
        PTR_BYTE_AT(b, dp, n - 1);
        if b != 47 { break; };
        n = n - 1;
    }
    // drop the last component
    while n > 1 {
        let b: u8 = 0;
        PTR_BYTE_AT(b, dp, n - 1);
        if b == 47 { break; };
        n = n - 1;
    }
    // drop the separator itself unless root
    if n > 1 { n = n - 1; };
    dir.len = n;
}

fn mdPathEq(a: &MdPath, b: &MdPath) -> bool {
    if a.len != b.len { return false; };
    let ap: ptr = PTR_NULL();
    PTR_BYTE_ADD(ap, &a.bytes, 0);
    let bp: ptr = PTR_NULL();
    PTR_BYTE_ADD(bp, &b.bytes, 0);
    let i: u64 = 0;
    while i < a.len {
        let x: u8 = 0;
        let y: u8 = 0;
        PTR_BYTE_AT(x, ap, i);
        PTR_BYTE_AT(y, bp, i);
        if x != y { return false; };
        i = i + 1;
    }
    return true;
}

/**
 * Walk up from cwd collecting AGENTS.md files, root-first (nearest last, so
 * the nearest scope — highest precedence per the AGENTS.md spec — comes last).
 */
// TS lines 13-33: findAgentsMdFiles(cwd: string, maxLevels = AGENTS_MD_MAX_LEVELS): string[]
// DEFECT: default parameter | maxLevels default (12) has no SLA default-arg; callers must pass it explicitly.
// DEFECT: Node API | resolve(cwd) approximated as-is (no absolutize/symlink resolution); resolve failure (TS try/catch -> return []) cannot occur in this approximation.
// DEFECT: exception handling | per-entry try/catch around existsSync/statSync replaced by fs extern status checks.
// DEFECT: dynamic array | found.reverse() on a JS array approximated by collecting nearest-first then reversing the fixed list in place.
fn findAgentsMdFiles(cwd_ptr: ptr, cwd_len: u64, maxLevels: u64, found: &MdPathList) {
    found.len = 0;
    let dir = MdPath { bytes: [0u8; 1024], len: 0 };
    mdPathPush(&dir, cwd_ptr, cwd_len);
    let i: u64 = 0;
    while i < maxLevels {
        let candidate = MdPath { bytes: [0u8; 1024], len: 0 };
        joinAgentsMd(&dir, &candidate);
        let cp: ptr = PTR_NULL();
        PTR_BYTE_ADD(cp, &candidate.bytes, 0);
        if sa_std_fs_exists(cp, candidate.len) && sa_std_fs_is_file(cp, candidate.len) {
            if found.len < 12 {
                found.paths[found.len] = candidate;
                found.len = found.len + 1;
            };
        };
        let parent = MdPath { bytes: [0u8; 1024], len: 0 };
        parent = dir;
        dirnameInPlace(&parent);
        if mdPathEq(&parent, &dir) { break; };
        dir = parent;
        i = i + 1;
    }
    // return found.reverse();
    let a: u64 = 0;
    let b = found.len;
    while b > 0 && a < b - 1 {
        b = b - 1;
        let tmp = found.paths[a];
        found.paths[a] = found.paths[b];
        found.paths[b] = tmp;
        a = a + 1;
    }
}

/**
 * Load and concatenate AGENTS.md scope files, bounded to maxBytes total.
 * Returns null when no AGENTS.md exists in scope (caller omits the section).
 */
// TS lines 39-66: loadAgentsMd(cwd, maxBytes = AGENTS_MD_MAX_BYTES, maxLevels = AGENTS_MD_MAX_LEVELS): string | null
// DEFECT: nullable return | string | null approximated as bool (false = null) + out buffer.
// DEFECT: default parameters | defaults not expressible; callers pass AGENTS_MD_MAX_BYTES / AGENTS_MD_MAX_LEVELS explicitly.
// DEFECT: string methods | body.trim() / chunk.slice / parts.join approximated byte-wise (lengths are bytes, not UTF-16 units).
// DEFECT: template literal | `# Repo instructions (${file})\n${text}` and the truncation marker built by manual concatenation.
fn loadAgentsMd(cwd_ptr: ptr, cwd_len: u64, maxBytes: u64, maxLevels: u64, out: &MdStr) -> bool {
    out.len = 0;
    let files = MdPathList { paths: [MdPath { bytes: [0u8; 1024], len: 0 }; 12], len: 0 };
    findAgentsMdFiles(cwd_ptr, cwd_len, maxLevels, &files);
    if files.len == 0 { return false; };
    let parts = MdStr { bytes: [0u8; 16384], len: 0 };
    let used: u64 = 0;
    let part_count: u64 = 0;
    let f: u64 = 0;
    while f < files.len {
        if used >= maxBytes { break; };
        let file = files.paths[f];
        let fp: ptr = PTR_NULL();
        PTR_BYTE_ADD(fp, &file.bytes, 0);
        // let body = ""; try { body = readFileSync(file, "utf8") } catch { continue }
        let body = MdStr { bytes: [0u8; 16384], len: 0 };
        let ok = sa_std_fs_read(fp, file.len, &body.bytes, 16384, &body.len);
        if !ok {
            f = f + 1;
            continue;
        };
        // const text = body.trim(); if (!text) continue;
        let bp: ptr = PTR_NULL();
        PTR_BYTE_ADD(bp, &body.bytes, 0);
        let ts: u64 = 0;
        let te = body.len;
        while ts < te {
            let c: u8 = 0;
            PTR_BYTE_AT(c, bp, ts);
            if c != 32 && c != 9 && c != 10 && c != 13 { break; };
            ts = ts + 1;
        }
        while te > ts {
            let c: u8 = 0;
            PTR_BYTE_AT(c, bp, te - 1);
            if c != 32 && c != 9 && c != 10 && c != 13 { break; };
            te = te - 1;
        }
        if te <= ts {
            f = f + 1;
            continue;
        };
        // const chunk = files.length > 1 ? `# Repo instructions (${file})\n${text}` : text;
        let chunk = MdStr { bytes: [0u8; 16384], len: 0 };
        if files.len > 1 {
            mdStrPush(&chunk, STR_PTR("# Repo instructions ("), STR_LEN("# Repo instructions ("));
            mdStrPush(&chunk, fp, file.len);
            mdStrPush(&chunk, STR_PTR(")\n"), STR_LEN(")\n"));
        };
        let i = ts;
        while i < te {
            let c: u8 = 0;
            PTR_BYTE_AT(c, bp, i);
            mdStrPushByte(&chunk, c);
            i = i + 1;
        }
        // const room = maxBytes - used;
        let room = maxBytes - used;
        if part_count > 0 {
            mdStrPush(&parts, STR_PTR("\n\n---\n\n"), STR_LEN("\n\n---\n\n"));
        };
        if chunk.len > room {
            // parts.push(`${chunk.slice(0, room)}\n…[AGENTS.md truncated to ${maxBytes} bytes]`); used = maxBytes;
            let cp2: ptr = PTR_NULL();
            PTR_BYTE_ADD(cp2, &chunk.bytes, 0);
            mdStrPush(&parts, cp2, room);
            mdStrPush(&parts, STR_PTR("\n…[AGENTS.md truncated to "), STR_LEN("\n…[AGENTS.md truncated to "));
            // maxBytes rendered decimal (template interpolation)
            let digits: [u8; 20] = [0u8; 20];
            let n: u64 = 0;
            let x = maxBytes;
            if x == 0 { mdStrPushByte(&parts, 48); };
            while x > 0 {
                digits[n] = 48 + (x % 10) as u8;
                n = n + 1;
                x = x / 10;
            }
            while n > 0 {
                n = n - 1;
                mdStrPushByte(&parts, digits[n]);
            }
            mdStrPush(&parts, STR_PTR(" bytes]"), STR_LEN(" bytes]"));
            used = maxBytes;
        } else {
            let cp2: ptr = PTR_NULL();
            PTR_BYTE_ADD(cp2, &chunk.bytes, 0);
            mdStrPush(&parts, cp2, chunk.len);
            used = used + chunk.len;
        };
        part_count = part_count + 1;
        f = f + 1;
    }
    // const out = parts.join("\n\n---\n\n").trim(); return out || null;
    // (join separators were inserted between parts above; final trim approximated byte-wise)
    let pp: ptr = PTR_NULL();
    PTR_BYTE_ADD(pp, &parts.bytes, 0);
    let s: u64 = 0;
    let e = parts.len;
    while s < e {
        let c: u8 = 0;
        PTR_BYTE_AT(c, pp, s);
        if c != 32 && c != 9 && c != 10 && c != 13 { break; };
        s = s + 1;
    }
    while e > s {
        let c: u8 = 0;
        PTR_BYTE_AT(c, pp, e - 1);
        if c != 32 && c != 9 && c != 10 && c != 13 { break; };
        e = e - 1;
    }
    if e <= s { return false; };
    let i = s;
    while i < e {
        let c: u8 = 0;
        PTR_BYTE_AT(c, pp, i);
        mdStrPushByte(out, c);
        i = i + 1;
    }
    return true;
}
