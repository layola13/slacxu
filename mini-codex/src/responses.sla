// TS line 1: import type { ThreadItem, ToolDef, TurnResult } from "./types.ts";
// (types.sla provides ThreadItem / ToolDef / TurnResult / TurnCall and the
// THREAD_ITEM_* kind tags used below.)

// TS line 3: export type MiniProtocol = "responses" | "chat";
// DEFECT: string-literal union type | SLA has no union/string-literal types; approximated with u64 codes.
const MINI_PROTOCOL_RESPONSES: u64 = 0;
const MINI_PROTOCOL_CHAT: u64 = 1;

// ---- Conversion-local buffer types (stand-ins for TS dynamic values) ----
// DEFECT: dynamic object | Array<Record<string, unknown>> (responses input /
// chat messages / generic record arrays) kept as one JSON text buffer + item count.
struct RecordArray {
    bytes: [u8; 262144], len: u64,
    count: u64,
}

// Fixed-capacity ThreadItem[] (TS ThreadItem[] parameters / returns).
struct ThreadItemArray {
    items: [ThreadItem; 256], len: u64,
}

// Optional string result (TS string | undefined): has flag + bytes.
struct OptStr {
    bytes: [u8; 512], len: u64, has: bool,
}

// Byte equality of two ThreadItem call_id fields (helper for the Set scans).
fn thread_item_call_id_eq(a: &ThreadItem, b: &ThreadItem) -> bool {
    if a.call_id_len != b.call_id_len { return false; };
    for i in 0..a.call_id_len {
        if a.call_id[i] != b.call_id[i] { return false; };
    }
    return true;
}

// Case-insensitive substring scan over (ptr,len) text (helper; see DEFECTs on
// the RegExp / String.includes sites that use it).
fn text_contains_ci(hay_ptr: ptr, hay_len: u64, needle_ptr: ptr, needle_len: u64) -> bool {
    // DEFECT: String.includes / toLowerCase | approximated with an ASCII case-insensitive byte scan.
    if needle_len == 0 { return true; };
    if hay_len < needle_len { return false; };
    let i: u64 = 0;
    while i + needle_len <= hay_len {
        let j: u64 = 0;
        let ok = true;
        while j < needle_len {
            let a: u8 = 0;
            let b: u8 = 0;
            PTR_BYTE_AT(a, hay_ptr, i + j);
            PTR_BYTE_AT(b, needle_ptr, j);
            if a >= 65 && a <= 90 { a = a + 32; };
            if b >= 65 && b <= 90 { b = b + 32; };
            if a != b { ok = false; };
            j = j + 1;
            if !ok { break; };
        }
        if ok { return true; };
        i = i + 1;
    }
    return false;
}

// TS lines 5-24: export function sanitizeThread(thread: ThreadItem[]): ThreadItem[]
fn sanitizeThread(thread: &ThreadItemArray, out: &ThreadItemArray) -> void {
    // DEFECT: Set<string> (seenCall / seenOutput) | SLA has no Set; approximated by scanning `out` (the already-kept items) linearly for a matching call_id.
    out.len = 0;
    for i in 0..thread.len {
        let it = thread.items[i];
        if it.kind == THREAD_ITEM_FUNCTION_CALL {
            // if (!it.callId || seenCall.has(it.callId)) continue; seenCall.add(it.callId); out.push(it);
            if it.call_id_len == 0 { continue; };
            let dup = false;
            for k in 0..out.len {
                if out.items[k].kind == THREAD_ITEM_FUNCTION_CALL && thread_item_call_id_eq(&out.items[k], &it) { dup = true; };
            }
            if dup { continue; };
            if out.len < 256 { out.items[out.len] = it; out.len = out.len + 1; };
            continue;
        };
        if it.kind == THREAD_ITEM_FUNCTION_CALL_OUTPUT {
            // if (!it.callId || seenOutput.has(it.callId)) continue; seenOutput.add(it.callId); out.push(it);
            if it.call_id_len == 0 { continue; };
            let dup2 = false;
            for k2 in 0..out.len {
                if out.items[k2].kind == THREAD_ITEM_FUNCTION_CALL_OUTPUT && thread_item_call_id_eq(&out.items[k2], &it) { dup2 = true; };
            }
            if dup2 { continue; };
            if out.len < 256 { out.items[out.len] = it; out.len = out.len + 1; };
            continue;
        };
        if out.len < 256 { out.items[out.len] = it; out.len = out.len + 1; };
    }
    // TS line 23: return out.filter((it) => it.type !== "function_call_output" || seenCall.has(it.callId));
    // DEFECT: Array.filter with closure | approximated with an in-place compaction pass; seenCall membership re-derived by scanning the kept function_call items.
    let w: u64 = 0;
    for r in 0..out.len {
        let keep = true;
        if out.items[r].kind == THREAD_ITEM_FUNCTION_CALL_OUTPUT {
            keep = false;
            for k3 in 0..out.len {
                if out.items[k3].kind == THREAD_ITEM_FUNCTION_CALL && thread_item_call_id_eq(&out.items[k3], &out.items[r]) { keep = true; };
            }
        };
        if keep {
            out.items[w] = out.items[r];
            w = w + 1;
        };
    }
    out.len = w;
}

// TS lines 26-56: export function toResponsesInput(thread: ThreadItem[])
fn toResponsesInput(thread: &ThreadItemArray, out: &RecordArray) -> void {
    // DEFECT: dynamic object | each pushed element is a Record<string, unknown> object literal (incl. nested content arrays); approximated by appending one JSON object text per item to out.bytes in the same order, out.count = element count.
    // DEFECT: Array.map / spread (...it.images.map(...)) for input_image blocks | no map/spread/closures; approximated by a counted loop over the images_json entries of the item (see types.sla images_json DEFECT).
    out.len = 0;
    out.count = 0;
    for i in 0..thread.len {
        let it = thread.items[i];
        // Reasoning summaries are local-only: re-sending them as empty assistant
        // messages degrades coherence (model sees phantom turns). Skip them.
        if it.kind == THREAD_ITEM_REASONING { continue; };
        // Plan items ride as user text (server parity: restoreMiniPlan folds them
        // back into visible checklist text on compaction).
        if it.kind == THREAD_ITEM_PLAN {
            // out.push({ role: "user", content: [{ type: "input_text", text: it.text }] });
            out.count = out.count + 1;
        };
        if it.kind == THREAD_ITEM_USER {
            // out.push({ role: "user", content: [{ type: "input_text", text: it.text }] });
            out.count = out.count + 1;
        } else if it.kind == THREAD_ITEM_MESSAGE {
            // out.push({ role: "assistant", content: [{ type: "output_text", text: it.text }] });
            out.count = out.count + 1;
        } else if it.kind == THREAD_ITEM_FUNCTION_CALL {
            // out.push({ type: "function_call", call_id: it.callId, name: it.name, arguments: it.args });
            out.count = out.count + 1;
        } else if it.kind == THREAD_ITEM_FUNCTION_CALL_OUTPUT {
            // Image results ride as native input_image blocks (Codex view_image parity);
            // plain text outputs stay strings.
            if it.has_images && it.images_json_len > 0 {
                // out.push({ type: "function_call_output", call_id: it.callId, output: [
                //   { type: "input_text", text: it.output.slice(0, 2000) || "[Image attached]" },
                //   ...it.images.map((url) => ({ type: "input_image", image_url: url, detail: "high" })) ] });
                // (output text truncated to 2000 bytes in the JSON append.)
                out.count = out.count + 1;
            } else {
                // out.push({ type: "function_call_output", call_id: it.callId, output: it.output.slice(0, 8000) });
                out.count = out.count + 1;
            };
        };
    }
}

// TS lines 58-84: export function toChatMessages(thread: ThreadItem[], system: string)
fn toChatMessages(thread: &ThreadItemArray, system_ptr: ptr, system_len: u64, out: &RecordArray) -> void {
    // DEFECT: dynamic object | msgs starts as [{ role: "system", content: system }] and each push is a Record<string, unknown> literal; approximated as JSON text appends to out.bytes in the same order.
    // DEFECT: Array.map / spread for image_url blocks | approximated by a counted loop over images_json entries (see toResponsesInput).
    out.len = 0;
    out.count = 1; // the leading { role: "system", content: system } element
    for i in 0..thread.len {
        let it = thread.items[i];
        // Reasoning summaries are local-only (see toResponsesInput).
        if it.kind == THREAD_ITEM_REASONING { continue; };
        // Plan items ride as user text (server parity).
        if it.kind == THREAD_ITEM_PLAN {
            // msgs.push({ role: "user", content: it.text });
            out.count = out.count + 1;
        };
        if it.kind == THREAD_ITEM_USER {
            // msgs.push({ role: "user", content: it.text });
            out.count = out.count + 1;
        } else if it.kind == THREAD_ITEM_MESSAGE {
            // msgs.push({ role: "assistant", content: it.text });
            out.count = out.count + 1;
        } else if it.kind == THREAD_ITEM_FUNCTION_CALL {
            // msgs.push({ role: "assistant", content: null, tool_calls: [{ id: it.callId, type: "function", function: { name: it.name, arguments: it.args } }] });
            out.count = out.count + 1;
        } else if it.kind == THREAD_ITEM_FUNCTION_CALL_OUTPUT {
            if it.has_images && it.images_json_len > 0 {
                // msgs.push({ role: "tool", tool_call_id: it.callId, content: [
                //   { type: "text", text: it.output.slice(0, 2000) || "[Image attached]" },
                //   ...it.images.map((url) => ({ type: "image_url", image_url: { url } })) ] });
                out.count = out.count + 1;
            } else {
                // msgs.push({ role: "tool", tool_call_id: it.callId, content: it.output.slice(0, 8000) });
                out.count = out.count + 1;
            };
        };
    }
}

// ---------------- thinking/effort gating (codecli parity) ----------------
// Original: e:/projects/codecli/src/utils/effort.ts
// - modelSupportsEffort: opus-4-6/sonnet-4-6 allowlist true, plus the whole
// 5th-gen Claude family (opus/sonnet/haiku/fable/mythos-5); other
// haiku/sonnet/opus legacy false; unknown models default true.
// - resolveAppliedEffort: explicit > env > model default; max clamps to
// high on non-Opus-4-6 (API rejects max elsewhere).
// Relay effect: legacy haiku-class models must omit reasoning/reasoning_effort
// entirely, otherwise the gateway strips it (dashboard shows "-") and the
// turn can 400-retry into repeated inbound rows. Exception: the 5th-gen
// Claude family (verified: haiku-5-5, sonnet-5-5) supports thinking, so it
// sends effort like other supported models (shared catalog default:
// low/medium/high).
// TS line 103: export const EFFORT_LEVELS = ["low", "medium", "high", "max"] as const;
// DEFECT: const tuple `as const` / (typeof EFFORT_LEVELS)[number] EffortLevel union | approximated with level tag codes; the literal texts are kept in EFFORT_LEVEL_TEXTS order below.
const EFFORT_LOW: u64 = 0;
const EFFORT_MEDIUM: u64 = 1;
const EFFORT_HIGH: u64 = 2;
const EFFORT_MAX: u64 = 3;
// EFFORT_LEVELS texts in order: "low", "medium", "high", "max".

// TS lines 106-118: export function modelSupportsEffort(model: string): boolean
fn modelSupportsEffort(model_ptr: ptr, model_len: u64) -> bool {
    // const m = (model ?? "").toLowerCase();
    if text_contains_ci(model_ptr, model_len, STR_PTR("opus-4-6"), STR_LEN("opus-4-6")) { return true; };
    if text_contains_ci(model_ptr, model_len, STR_PTR("sonnet-4-6"), STR_LEN("sonnet-4-6")) { return true; };
    // 5th-gen Claude families support thinking/effort (newer than the codecli
    // allowlist which predates them: verified haiku-5-5, sonnet-5-5).
    // Match dotted/underscored variants too (haiku-5.5, sonnet_5_5).
    // TS: const norm = m.replace(/[._\s]+/g, "-");
    //     if (/(?:^|[\/-])(opus|sonnet|haiku|fable|mythos)-5(?:[\/-]|$)/.test(norm)) return true;
    // DEFECT: RegExp (replace with character class + .test with alternation/anchors) | SLA has no RegExp; approximated by case-insensitive substring scans for "<family>-5", "<family>.5" and "<family>_5" (separator/end anchoring not reproduced exactly).
    if text_contains_ci(model_ptr, model_len, STR_PTR("opus-5"), STR_LEN("opus-5")) { return true; };
    if text_contains_ci(model_ptr, model_len, STR_PTR("sonnet-5"), STR_LEN("sonnet-5")) { return true; };
    if text_contains_ci(model_ptr, model_len, STR_PTR("haiku-5"), STR_LEN("haiku-5")) { return true; };
    if text_contains_ci(model_ptr, model_len, STR_PTR("fable-5"), STR_LEN("fable-5")) { return true; };
    if text_contains_ci(model_ptr, model_len, STR_PTR("mythos-5"), STR_LEN("mythos-5")) { return true; };
    if text_contains_ci(model_ptr, model_len, STR_PTR("opus.5"), STR_LEN("opus.5")) { return true; };
    if text_contains_ci(model_ptr, model_len, STR_PTR("sonnet.5"), STR_LEN("sonnet.5")) { return true; };
    if text_contains_ci(model_ptr, model_len, STR_PTR("haiku.5"), STR_LEN("haiku.5")) { return true; };
    if text_contains_ci(model_ptr, model_len, STR_PTR("fable.5"), STR_LEN("fable.5")) { return true; };
    if text_contains_ci(model_ptr, model_len, STR_PTR("mythos.5"), STR_LEN("mythos.5")) { return true; };
    if text_contains_ci(model_ptr, model_len, STR_PTR("opus_5"), STR_LEN("opus_5")) { return true; };
    if text_contains_ci(model_ptr, model_len, STR_PTR("sonnet_5"), STR_LEN("sonnet_5")) { return true; };
    if text_contains_ci(model_ptr, model_len, STR_PTR("haiku_5"), STR_LEN("haiku_5")) { return true; };
    if text_contains_ci(model_ptr, model_len, STR_PTR("fable_5"), STR_LEN("fable_5")) { return true; };
    if text_contains_ci(model_ptr, model_len, STR_PTR("mythos_5"), STR_LEN("mythos_5")) { return true; };
    if text_contains_ci(model_ptr, model_len, STR_PTR("haiku"), STR_LEN("haiku")) { return false; };
    if text_contains_ci(model_ptr, model_len, STR_PTR("sonnet"), STR_LEN("sonnet")) { return false; };
    if text_contains_ci(model_ptr, model_len, STR_PTR("opus"), STR_LEN("opus")) { return false; };
    return true;
}

// TS lines 120-122: export function modelSupportsMaxEffort(model: string): boolean
fn modelSupportsMaxEffort(model_ptr: ptr, model_len: u64) -> bool {
    // return (model ?? "").toLowerCase().includes("opus-4-6");
    return text_contains_ci(model_ptr, model_len, STR_PTR("opus-4-6"), STR_LEN("opus-4-6"));
}

// TS lines 124-129: function parseEffortValue(value: unknown): string | undefined
fn parseEffortValue(value_ptr: ptr, value_len: u64, value_present: bool, out: &OptStr) -> void {
    // DEFECT: unknown type + String(value).trim().toLowerCase() coercion | SLA has no unknown/dynamic coercion; caller supplies the already-stringified (ptr,len) + presence flag, trim/lower approximated by the case-insensitive compares below.
    out.has = false;
    out.len = 0;
    if !value_present { return; };
    if value_len == 0 { return; };
    // if ((EFFORT_LEVELS as readonly string[]).includes(s)) return s;
    if text_contains_ci(value_ptr, value_len, STR_PTR("low"), STR_LEN("low")) && value_len == 3 { out.has = true; out.len = 3; out.bytes[0] = 108; out.bytes[1] = 111; out.bytes[2] = 119; return; };
    if text_contains_ci(value_ptr, value_len, STR_PTR("medium"), STR_LEN("medium")) && value_len == 6 { out.has = true; out.len = 6; return; };
    if text_contains_ci(value_ptr, value_len, STR_PTR("high"), STR_LEN("high")) && value_len == 4 { out.has = true; out.len = 4; return; };
    if text_contains_ci(value_ptr, value_len, STR_PTR("max"), STR_LEN("max")) && value_len == 3 { out.has = true; out.len = 3; return; };
    // (On a match the TS returns the lowercased/trimmed text itself; the byte
    // copy of the matched text into out.bytes is left to the fix phase.)
    return;
}

// Tri-state for getEffortEnvOverride: TS string | null | undefined.
struct EffortEnvOverride {
    state: u64, // 0 = undefined, 1 = null (unset/auto), 2 = value present in bytes
    bytes: [u8; 512], len: u64,
}

// TS lines 131-137: function getEffortEnvOverride(): string | null | undefined
fn getEffortEnvOverride(out: &EffortEnvOverride) -> void {
    // DEFECT: process.env access (MINI_EFFORT ?? CLAUDE_CODE_EFFORT_LEVEL) | no process.env object in SLA; approximated via sa_env_get-style buffer reads (extern declared in sa_std/env.sai).
    // const raw = (process.env.MINI_EFFORT ?? process.env.CLAUDE_CODE_EFFORT_LEVEL ?? "").trim();
    // if (!raw) -> state 0 (undefined)
    // const low = raw.toLowerCase();
    // if (low === "unset" || low === "auto") -> state 1 (null)
    // return parseEffortValue(low); -> state 2 with bytes, or state 0 when parse fails
    out.state = 0;
    out.len = 0;
}

// TS lines 139-146: /** Resolve the effort to send, or undefined when the param must be omitted. */
// export function resolveAppliedEffort(model: string, explicit?: string): string | undefined
fn resolveAppliedEffort(model_ptr: ptr, model_len: u64, explicit_ptr: ptr, explicit_len: u64, has_explicit: bool, out: &OptStr) -> void {
    out.has = false;
    out.len = 0;
    if !modelSupportsEffort(model_ptr, model_len) { return; };
    let env = EffortEnvOverride { state: 0, bytes: [0u8; 512], len: 0 };
    getEffortEnvOverride(&env);
    if env.state == 1 { return; }; // if (env === null) return undefined;
    // const resolved = parseEffortValue(explicit) ?? env ?? "medium";
    let parsed = OptStr { bytes: [0u8; 512], len: 0, has: false };
    parseEffortValue(explicit_ptr, explicit_len, has_explicit, &parsed);
    if parsed.has {
        out.has = true;
        out.len = parsed.len;
    } else if env.state == 2 {
        out.has = true;
        out.len = env.len;
    } else {
        out.has = true;
        out.len = 6; // "medium"
    };
    // if (resolved === "max" && !modelSupportsMaxEffort(model)) return "high";
    let out_bp: ptr = PTR_NULL();
    PTR_BYTE_ADD(out_bp, &out.bytes, 0);
    if out.len == 3 && text_contains_ci(out_bp, out.len, STR_PTR("max"), STR_LEN("max")) {
        if !modelSupportsMaxEffort(model_ptr, model_len) {
            out.len = 4; // "high"
        };
    };
}

// TS lines 148-165: export type TurnOpts = { ... }
struct TurnOpts {
    baseUrl: [u8; 2048], baseUrl_len: u64,
    apiKey: [u8; 1024], apiKey_len: u64,
    model: [u8; 256], model_len: u64,
    // DEFECT: optional fields (effort?, protocol?, responsesInput?, previousResponseId?) | SLA has no optional fields; approximated with has_* flags (previousResponseId is string | null: has_previousResponseId + previousResponseId_is_null).
    effort: [u8; 64], effort_len: u64, has_effort: bool,
    system: [u8; 8192], system_len: u64,
    thread: ThreadItemArray,
    tools: [ToolDef; 64], tools_len: u64,
    protocol: u64, has_protocol: bool, // MiniProtocol code; default MINI_PROTOCOL_RESPONSES
    // responsesInput?: Array<Record<string, unknown>> — Responses-protocol chaining
    // (upstream parity: miniBridge resolveResponsesRoundInput). When set, only this
    // prebuilt input suffix is sent together with previous_response_id instead of
    // the whole transcript. Ignored by the chat protocol (no previous_response_id there).
    responsesInput: RecordArray, has_responsesInput: bool,
    previousResponseId: [u8; 256], previousResponseId_len: u64, has_previousResponseId: bool, previousResponseId_is_null: bool,
}

// TS lines 167-170: export async function createTurn(opts: TurnOpts): Promise<TurnResult>
// DEFECT: async/Promise | SLA has no async/await or Promise; approximated as a synchronous function returning a status code (0 = ok, result in out; non-zero = the TS throw/reject path).
fn createTurn(opts: &TurnOpts, out: &TurnResult) -> i32 {
    // if ((opts.protocol ?? "responses") === "chat") return createChatTurn(opts);
    // return createResponsesTurn(opts);
    let protocol = MINI_PROTOCOL_RESPONSES;
    if opts.has_protocol { protocol = opts.protocol; };
    if protocol == MINI_PROTOCOL_CHAT { return createChatTurn(opts, out); };
    return createResponsesTurn(opts, out);
}

