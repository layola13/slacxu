// TS lines 182-183:
const MINI_UPSTREAM_RETRY_BASE_DELAY_MS: u64 = 500;
const MINI_UPSTREAM_RETRY_MAX_DELAY_MS: u64 = 10000;

// TS lines 185-188: /** Retryable upstream statuses (mirrors the relay-facing set in miniBridge). */
// export function isUpstreamRetryableStatus(status: number): boolean
fn isUpstreamRetryableStatus(status: u64) -> bool {
    return status == 408 || status == 425 || status == 429 || status >= 500;
}

// TS lines 190-193: function isAbortError(e: unknown): boolean
fn isAbortError(e_ptr: ptr, e_len: u64, e_is_error: bool) -> bool {
    // DEFECT: unknown/Error instance check (e instanceof Error ? `${e.name}: ${e.message}` : String(e ?? "")) | caller supplies the flattened "name: message" text + flag.
    // DEFECT: RegExp /aborterror|aborted|operation was aborted/i | approximated with case-insensitive substring scans (alternation order preserved).
    if text_contains_ci(e_ptr, e_len, STR_PTR("aborterror"), STR_LEN("aborterror")) { return true; };
    if text_contains_ci(e_ptr, e_len, STR_PTR("aborted"), STR_LEN("aborted")) { return true; };
    if text_contains_ci(e_ptr, e_len, STR_PTR("operation was aborted"), STR_LEN("operation was aborted")) { return true; };
    return false;
}

// TS lines 195-200: export function upstreamRetryDelayMs(retryIndex: number, retryAfterMs?: number): number
fn upstreamRetryDelayMs(retryIndex: u64, has_retryAfterMs: bool, retryAfterMs: u64) -> u64 {
    if has_retryAfterMs {
        // return Math.min(MINI_UPSTREAM_RETRY_MAX_DELAY_MS, Math.round(retryAfterMs));
        if retryAfterMs > MINI_UPSTREAM_RETRY_MAX_DELAY_MS { return MINI_UPSTREAM_RETRY_MAX_DELAY_MS; };
        return retryAfterMs;
    };
    // return Math.min(MAX, BASE * 2 ** Math.max(0, retryIndex));
    let delay = MINI_UPSTREAM_RETRY_BASE_DELAY_MS;
    for i in 0..retryIndex {
        delay = delay * 2;
        if delay > MINI_UPSTREAM_RETRY_MAX_DELAY_MS { return MINI_UPSTREAM_RETRY_MAX_DELAY_MS; };
    }
    if delay > MINI_UPSTREAM_RETRY_MAX_DELAY_MS { return MINI_UPSTREAM_RETRY_MAX_DELAY_MS; };
    return delay;
}

// TS lines 202-224: /** Parse Retry-After / retry-after-ms headers plus "retry in N s" body hints. */
// export function upstreamRetryAfterMs(headers?: Headers | null, bodyText?: string): number | undefined
fn upstreamRetryAfterMs(headers_ptr: ptr, headers_len: u64, has_headers: bool, body_ptr: ptr, body_len: u64, has_body: bool, out: &OptStr) -> void {
    // DEFECT: Headers object (headers?.get("retry-after") / .get("retry-after-ms")) | no Headers type in SLA/sa_std; caller supplies the headers flattened as text; per-name lookup approximated by substring scans for "retry-after" / "retry-after-ms" in the fix phase.
    // DEFECT: Date.parse / Date.now() for HTTP-date Retry-After values | no date API counterpart used here; only the numeric-seconds branch is approximated, the date branch falls through to undefined.
    // DEFECT: RegExp /(?:try again|retry)(?:\s+after|\s+in)?\s+([0-9]+(?:\.[0-9]+)?)\s*(ms|milliseconds?|s|seconds?)/i.exec(bodyText) | no RegExp; approximated by scanning body text for "try again"/"retry" followed by a decimal number and a unit word in the fix phase.
    // TS flow preserved: retry-after seconds -> *1000; else retry-after-ms -> round;
    // else body hint value * (unit starts with "ms" ? 1 : 1000); else undefined (out.has = false).
    out.has = false;
    out.len = 0;
}

