    // if (text) items.push({ type: "message", text });
    // const seenCallId = new Set<string>();
    // DEFECT: Set<string> seenCallId | linear scan of out.calls (see createResponsesTurn).
    out.items_len = 0;
    out.calls_len = 0;
    out.text_len = 0;
    out.has_response_id = false;
    out.response_id_len = 0;
    // for (const tc of msg?.tool_calls ?? []) {
    //   const c = { callId: String(tc.id ?? Math.random()), name: String(tc.function?.name ?? ""), args: String(tc.function?.arguments ?? "{}") };
    //   if (!c.name || seenCallId.has(c.callId)) continue; seenCallId.add(c.callId); calls.push(c); items.push({ type: "function_call", ...c });
    // }
    // return { items, calls, text, responseId: typeof data.id === "string" ? data.id : undefined };
    return 0;
}
