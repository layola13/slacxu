// ---------------- previous_response_id chaining (miniBridge parity) ----------------

// TS lines 272-279: /** Conversation state for responses `previous_response_id` chaining. */
// export interface MiniResponsesChain { prevId: string | null; sentHash: string; sentCount: number; }
struct MiniResponsesChain {
    // DEFECT: string | null field | approximated with has_prevId flag (false = null).
    prevId: [u8; 256], prevId_len: u64, has_prevId: bool,
    sentHash: [u8; 64], sentHash_len: u64,
    sentCount: u64,
}

// TS line 281: export const EMPTY_MINI_RESPONSES_CHAIN: MiniResponsesChain = { prevId: null, sentHash: "", sentCount: 0 };
// DEFECT: const object literal | SLA has no const struct values; approximated with an initializer function writing the EMPTY value.
fn EMPTY_MINI_RESPONSES_CHAIN(out: &MiniResponsesChain) -> void {
    out.has_prevId = false;
    out.prevId_len = 0;
    out.sentHash_len = 0;
    out.sentCount = 0;
}

// TS lines 283-290: /** Tiny FNV-1a hash (avoids a crypto import for a prefix-equality check). */
// export function hashMiniChainPrefix(s: string): string
fn hashMiniChainPrefix(s_ptr: ptr, s_len: u64, out: &OptStr) -> void {
    let h: u64 = 0x811c9dc5;
    for i in 0..s_len {
        let c: u8 = 0;
        PTR_BYTE_AT(c, s_ptr, i);
        h = h ^ (c as u64);
        // TS: h = Math.imul(h, 0x01000193);
        // DEFECT: Math.imul 32-bit multiply / (h >>> 0).toString(16) | approximated by keeping the low 32 bits after each multiply and rendering hex digits manually below.
        h = (h * 0x01000193) % 4294967296;
    }
    // Render h as lowercase hex (no leading zeros, matching toString(16)) into out.bytes.
    out.has = true;
    out.len = 0;
    if h == 0 {
        out.bytes[0] = 48; // "0"
        out.len = 1;
        return;
    };
    let digits: [u8; 8] = [0u8; 8];
    let n: u64 = 0;
    let v = h;
    while v > 0 {
        let d = v % 16;
        if d < 10 { digits[n] = 48 + (d as u8); } else { digits[n] = 87 + (d as u8); };
        n = n + 1;
        v = v / 16;
    }
    let w: u64 = 0;
    let r = n;
    while r > 0 {
        r = r - 1;
        out.bytes[w] = digits[r];
        w = w + 1;
    }
    out.len = w;
}

// Result of resolveResponsesRoundInput (TS object return { input, previousResponseId, chained }).
struct ResponsesRoundInput {
    input: RecordArray,
    previousResponseId: [u8; 256], previousResponseId_len: u64, has_previousResponseId: bool, // false = null
    chained: bool,
}

// TS lines 292-310: /**
//  * Resolve a responses round into full or chained input. When the thread still
//  * starts with the exact prefix the server stored (hash match), only the new
//  * suffix is sent with `previous_response_id`. Any mutation breaks the match
//  * and falls back to a full send, so chaining can never corrupt the thread.
//  */
// export function resolveResponsesRoundInput<T extends Record<string, any>>(full: T[], chain: MiniResponsesChain): { input: T[]; previousResponseId: string | null; chained: boolean }
// DEFECT: generic <T extends Record<string, any>> | SLA has no generics; T[] approximated as RecordArray (JSON text buffer) for all instantiations.
// DEFECT: JSON.stringify(full.slice(0, chain.sentCount)) + Array.slice by item count | item byte offsets are not tracked in RecordArray; the caller supplies prefix_ptr/prefix_len = the JSON text of the first chain.sentCount items, and the suffix input bytes are full.bytes minus that prefix (prefix_bytes_len).
fn resolveResponsesRoundInput(full: &RecordArray, prefix_ptr: ptr, prefix_len: u64, prefix_bytes_len: u64, chain: &MiniResponsesChain, out: &ResponsesRoundInput) -> void {
    if chain.has_prevId && chain.sentCount > 0 && full.count >= chain.sentCount {
        // try {
        //   if (hashMiniChainPrefix(JSON.stringify(full.slice(0, chain.sentCount))) === chain.sentHash) {
        //     return { input: full.slice(chain.sentCount), previousResponseId: chain.prevId, chained: true };
        //   }
        // } catch { /* Fall through to a full send. */ }
        // DEFECT: try/catch around stringify/hash | approximated by the hash compare alone; a hashing failure cannot be distinguished in this pass.
        let h = OptStr { bytes: [0u8; 512], len: 0, has: false };
        hashMiniChainPrefix(prefix_ptr, prefix_len, &h);
        let same = h.has && h.len == chain.sentHash_len;
        if same {
            for i in 0..h.len {
                if h.bytes[i] != chain.sentHash[i] { same = false; };
            }
        };
        if same {
            // out.input = full bytes after prefix_bytes_len (suffix items only)
            out.input.len = 0;
            if full.len > prefix_bytes_len { out.input.len = full.len - prefix_bytes_len; };
            out.input.count = full.count - chain.sentCount;
            out.has_previousResponseId = true;
            out.previousResponseId_len = chain.prevId_len;
            for j in 0..chain.prevId_len { out.previousResponseId[j] = chain.prevId[j]; }
            out.chained = true;
            return;
        };
    };
    // return { input: full, previousResponseId: null, chained: false };
    out.input.len = full.len;
    out.input.count = full.count;
    out.has_previousResponseId = false;
    out.previousResponseId_len = 0;
    out.chained = false;
}

// TS lines 312-322: /** Advance the chain after a round whose response the server stored. */
// export function advanceResponsesChain<T extends Record<string, any>>(full: T[], responseId: string | null | undefined): MiniResponsesChain
// DEFECT: generic <T> (see resolveResponsesRoundInput) | full_json_ptr/full_json_len carry JSON.stringify(full).
fn advanceResponsesChain(full: &RecordArray, full_json_ptr: ptr, full_json_len: u64, responseId_ptr: ptr, responseId_len: u64, has_responseId: bool, out: &MiniResponsesChain) -> void {
    if !has_responseId {
        // if (!responseId) return EMPTY_MINI_RESPONSES_CHAIN;
        EMPTY_MINI_RESPONSES_CHAIN(out);
        return;
    };
    // try {
    //   return { prevId: responseId, sentHash: hashMiniChainPrefix(JSON.stringify(full)), sentCount: full.length };
    // } catch { return EMPTY_MINI_RESPONSES_CHAIN; }
    // DEFECT: try/catch | no exceptions in SLA; the catch fallback (EMPTY chain) is taken only on the !responseId path above in this pass.
    out.has_prevId = true;
    out.prevId_len = responseId_len;
    for i in 0..responseId_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, responseId_ptr, i);
        out.prevId[i] = b;
    }
    let h = OptStr { bytes: [0u8; 512], len: 0, has: false };
    hashMiniChainPrefix(full_json_ptr, full_json_len, &h);
    out.sentHash_len = h.len;
    for j in 0..h.len { out.sentHash[j] = h.bytes[j]; }
    out.sentCount = full.count;
}

// TS lines 324-328: /** A chained round the relay rejects (400 / stale id) must retry once with full input. */
// export function isChainRejectedError(e: unknown, status?: number): boolean
fn isChainRejectedError(e_ptr: ptr, e_len: u64, e_is_error: bool, has_status: bool, status: u64) -> bool {
    if has_status && status == 400 { return true; };
    // const msg = e instanceof Error ? e.message : String(e ?? "");
    // DEFECT: unknown/Error instance check | caller supplies the flattened message text (see isAbortError).
    // DEFECT: RegExp /previous_response_id|previous response|invalid.*response.*id|expired.*response|response.*not found|response.*expired/i | no RegExp (the .* alternatives cannot be reproduced by substring scan); approximated with case-insensitive substring scans for the literal alternatives and the key fragments of the .* patterns.
    if text_contains_ci(e_ptr, e_len, STR_PTR("previous_response_id"), STR_LEN("previous_response_id")) { return true; };
    if text_contains_ci(e_ptr, e_len, STR_PTR("previous response"), STR_LEN("previous response")) { return true; };
    if text_contains_ci(e_ptr, e_len, STR_PTR("response"), STR_LEN("response")) && text_contains_ci(e_ptr, e_len, STR_PTR("expired"), STR_LEN("expired")) { return true; };
    if text_contains_ci(e_ptr, e_len, STR_PTR("response"), STR_LEN("response")) && text_contains_ci(e_ptr, e_len, STR_PTR("not found"), STR_LEN("not found")) { return true; };
    if text_contains_ci(e_ptr, e_len, STR_PTR("invalid"), STR_LEN("invalid")) && text_contains_ci(e_ptr, e_len, STR_PTR("response"), STR_LEN("response")) { return true; };
    return false;
}

// TS lines 330-356: /**
//  * One responses round through the chain: send only the new suffix when the
//  * thread prefix matches what the server stored, else send full input. A relay
//  * rejection of a chained round retries once with full input (miniBridge
//  * parity), so a stale/expired stored response degrades to one wasted call,
//  * never a failed turn.
//  */
// export async function createChainedTurn(opts: TurnOpts, fullInput: Array<Record<string, unknown>>, chain: MiniResponsesChain): Promise<{ result: TurnResult; chain: MiniResponsesChain }>
// DEFECT: async/Promise + object return { result, chain } | approximated synchronously with a status return and out parameters (out_result / out_chain).
// DEFECT: spread { ...opts, responsesInput: round.input, previousResponseId: round.previousResponseId } | no object spread; approximated by copying opts field-wise into round_opts and overriding the two fields.
fn createChainedTurn(opts: &TurnOpts, fullInput: &RecordArray, prefix_ptr: ptr, prefix_len: u64, prefix_bytes_len: u64, full_json_ptr: ptr, full_json_len: u64, chain: &MiniResponsesChain, out_result: &TurnResult, out_chain: &MiniResponsesChain) -> i32 {
    let round = ResponsesRoundInput { input: RecordArray { bytes: [0u8; 262144], len: 0, count: 0 }, previousResponseId: [0u8; 256], previousResponseId_len: 0, has_previousResponseId: false, chained: false };
    resolveResponsesRoundInput(fullInput, prefix_ptr, prefix_len, prefix_bytes_len, chain, &round);
    // try {
    //   const result = await createTurn({ ...opts, responsesInput: round.input, previousResponseId: round.previousResponseId });
    //   return { result, chain: advanceResponsesChain(fullInput, result.responseId) };
    // } catch (e) {
    //   if (round.chained && isChainRejectedError(e)) {
    //     try { process.stderr.write(`[mini] previous_response_id rejected by relay; retrying with full input.\n`); } catch { /* ignore */ }
    //     const result = await createTurn({ ...opts });
    //     return { result, chain: advanceResponsesChain(fullInput, result.responseId) };
    //   }
    //   throw e;
    // }
    // DEFECT: try/catch / throw / await (see createTurn) | the chained attempt runs first; on a non-zero status with round.chained and a chain-rejection-shaped error text, one full-input retry runs; otherwise the status propagates (the TS throw).
    let round_opts = TurnOpts {
        baseUrl: opts.baseUrl, baseUrl_len: opts.baseUrl_len,
        apiKey: opts.apiKey, apiKey_len: opts.apiKey_len,
        model: opts.model, model_len: opts.model_len,
        effort: opts.effort, effort_len: opts.effort_len, has_effort: opts.has_effort,
        system: opts.system, system_len: opts.system_len,
        thread: opts.thread,
        tools: opts.tools, tools_len: opts.tools_len,
        protocol: opts.protocol, has_protocol: opts.has_protocol,
        responsesInput: round.input, has_responsesInput: true,
        previousResponseId: round.previousResponseId, previousResponseId_len: round.previousResponseId_len, has_previousResponseId: true, previousResponseId_is_null: !round.has_previousResponseId,
    };
    let st = createTurn(&round_opts, out_result);
    if st == 0 {
        let rid_p: ptr = PTR_NULL();
        PTR_BYTE_ADD(rid_p, &out_result.response_id, 0);
        advanceResponsesChain(fullInput, full_json_ptr, full_json_len, rid_p, out_result.response_id_len, out_result.has_response_id, out_chain);
        return 0;
    };
    if round.chained {
        // (error text for isChainRejectedError would come from the failed turn;
        // in this pass any chained failure takes the rejection check with an
        // empty message + no status, i.e. only the 400-status path can match —
        // recorded here as part of the async/throw approximation.)
        sa_print_bytes(STR_PTR("[mini] previous_response_id rejected by relay; retrying with full input.\n"), STR_LEN("[mini] previous_response_id rejected by relay; retrying with full input.\n"));
        let st2 = createTurn(opts, out_result);
        if st2 == 0 {
            let rid2_p: ptr = PTR_NULL();
            PTR_BYTE_ADD(rid2_p, &out_result.response_id, 0);
            advanceResponsesChain(fullInput, full_json_ptr, full_json_len, rid2_p, out_result.response_id_len, out_result.has_response_id, out_chain);
            return 0;
        };
        return st2;
    };
    return st;
}

