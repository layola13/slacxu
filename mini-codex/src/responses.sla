fn numEnvInt(key_ptr: ptr, key_len: u64, fallback: u64, min_v: u64, max_v: u64) -> u64 {
    // DEFECT: process.env[key], Number(t), Number.isFinite, Math.floor/min/max | approximated via an env buffer read + manual decimal parse and clamping (env read itself left as the sa_std/env.sai extern call in the fix phase).
    // const t = (process.env[key] ?? "").trim(); if (!t) return fallback;
