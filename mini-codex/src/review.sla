const REVIEW_SYSTEM_SUFFIX: ptr = STR_PTR("This is a READ-ONLY code review run: inspect with sa_vm read/list/grep/git_status/git_diff and image_view only. Never write, edit, or execute workspace code to 'fix' findings - report them.");
