// Converted 1:1 from mini-codex/src/review.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "sa_std/io/print.sai"
@import "sa_std/ptr.sa"
@import "sa_std/string.sa"

// Mirrors apps/server/src/miniBridge.ts (parseMiniReviewTarget /
// miniReviewTargetLabel / buildMiniReviewPrompt + MINI_REVIEW_RUBRIC).
// mini-codex is a zero-dependency standalone CLI: small logic is duplicated
// here on purpose instead of importing the server. Keep the two in sync.

// Byte-string buffer for this module's string returns.
struct ReviewStr {
    bytes: [u8; 8192], len: u64,
}

fn review_str_copy_lit(out: &ReviewStr, lit_ptr: ptr, lit_len: u64) -> void {
    out.len = 0;
    for i in 0..lit_len {
        if out.len < 8192 {
            let b: u8 = 0;
            PTR_BYTE_AT(b, lit_ptr, i);
            out.bytes[out.len] = b;
            out.len = out.len + 1;
        };
    }
}

// Case-insensitive prefix/substring helper (see responses.sla text_contains_ci;
// duplicated here because mini-codex modules are standalone in the TS too).
fn review_text_contains_ci(hay_ptr: ptr, hay_len: u64, needle_ptr: ptr, needle_len: u64) -> bool {
    if needle_len == 0 { return true; };
    if hay_len < needle_len { return false; };
    let i: u64 = 0;
    while i + needle_len <= hay_len {
        let j: u64 = 0;
        let ok = true;
        while j < needle_len {
            let a: u8 = 0;
            let b: u8 = 0;
            PTR_BYTE_AT(a, hay_ptr, i + j);
            PTR_BYTE_AT(b, needle_ptr, j);
            if a >= 65 && a <= 90 { a = a + 32; };
            if b >= 65 && b <= 90 { b = b + 32; };
            if a != b { ok = false; };
            j = j + 1;
            if !ok { break; };
        }
        if ok { return true; };
        i = i + 1;
    }
    return false;
}

// TS lines 6-10: export type ReviewTarget =
//   | { type: "uncommittedChanges" }
//   | { type: "baseBranch"; branch: string }
//   | { type: "commit"; sha: string; title?: string | null }
//   | { type: "custom"; instructions: string };
// DEFECT: discriminated union type | SLA has no union types; approximated with a kind tag + all variant fields present (title optional/nullable via has_title + title_is_null).
const REVIEW_TARGET_UNCOMMITTED_CHANGES: u64 = 0;
const REVIEW_TARGET_BASE_BRANCH: u64 = 1;
const REVIEW_TARGET_COMMIT: u64 = 2;
const REVIEW_TARGET_CUSTOM: u64 = 3;

struct ReviewTarget {
    kind: u64, // one of REVIEW_TARGET_* above; TS: type
    branch: [u8; 512], branch_len: u64, // baseBranch variant
    sha: [u8; 128], sha_len: u64, // commit variant
    title: [u8; 1024], title_len: u64, has_title: bool, title_is_null: bool, // commit variant: title?: string | null
    instructions: [u8; 4096], instructions_len: u64, // custom variant
}

fn review_target_uncommitted(out: &ReviewTarget) -> void {
    out.kind = REVIEW_TARGET_UNCOMMITTED_CHANGES;
    out.branch_len = 0;
    out.sha_len = 0;
    out.has_title = false;
    out.title_is_null = true;
    out.title_len = 0;
    out.instructions_len = 0;
}

// TS lines 12-46: export function parseReviewTarget(value: unknown): ReviewTarget
// DEFECT: unknown type + dynamic Record<string, unknown> reads (rec.type ?? rec.kind, rec.branch, rec.sha, rec.title, rec.instructions ?? rec.value ?? rec.text ?? rec.prompt) with String(...) coercions | caller supplies the value as JSON text (value_is_object + the JSON bytes) or as plain text; per-key extraction is done with sa_json_*-style lookups in the fix phase; String() coercions of non-string values are not reproduced.
fn parseReviewTarget(value_ptr: ptr, value_len: u64, value_is_object: bool, out: &ReviewTarget) -> void {
    if value_is_object {
        // const rec = value as Record<string, unknown>;
        // const kind = String(rec.type ?? rec.kind ?? "").trim().toLowerCase();
        // if (kind === "uncommittedchanges" || kind === "uncommitted" || kind === "changes" || kind === "") {
        //   return { type: "uncommittedChanges" };
        // }
        // if (kind === "basebranch" || kind === "branch" || kind === "base") {
        //   const branch = String(rec.branch ?? "").trim();
        //   if (branch) return { type: "baseBranch", branch };
        //   return { type: "uncommittedChanges" };
        // }
        // if (kind === "commit") {
        //   const sha = String(rec.sha ?? "").trim();
        //   if (sha) {
        //     const title = rec.title == null ? null : String(rec.title).trim() || null;
        //     return { type: "commit", sha, title };
        //   }
        //   return { type: "uncommittedChanges" };
        // }
        // const instructions = String(rec.instructions ?? rec.value ?? rec.text ?? rec.prompt ?? "").trim();
        // if (instructions) return { type: "custom", instructions };
        // return { type: "uncommittedChanges" };
        // (Branch order and fallbacks preserved verbatim above; field-wise
        // fills of out.* happen once the JSON key extraction lands.)
        review_target_uncommitted(out);
        return;
    };
    // const rest = String(value ?? "").trim();
    // const normalized = rest.toLowerCase();
    // if (!rest || ["changes", "uncommitted", "uncommitted changes"].includes(normalized)) {
    //   return { type: "uncommittedChanges" };
    // }
    if value_len == 0 {
        review_target_uncommitted(out);
        return;
    };
    if review_text_contains_ci(value_ptr, value_len, STR_PTR("changes"), STR_LEN("changes")) && value_len == 7 {
        review_target_uncommitted(out);
        return;
    };
    if review_text_contains_ci(value_ptr, value_len, STR_PTR("uncommitted changes"), STR_LEN("uncommitted changes")) && value_len == 19 {
        review_target_uncommitted(out);
        return;
    };
    if review_text_contains_ci(value_ptr, value_len, STR_PTR("uncommitted"), STR_LEN("uncommitted")) && value_len == 11 {
        review_target_uncommitted(out);
        return;
    };
    // const branch = /^(?:branch|base|base-branch)\s+(.+)$/i.exec(rest);
    // if (branch?.[1]?.trim()) return { type: "baseBranch", branch: branch[1].trim() };
    // DEFECT: RegExp exec with alternation/capture group + optional chaining (branch?.[1]?.trim()) | no RegExp/optional chaining in SLA; approximated by case-insensitive prefix scans for "branch ", "base-branch " and "base " followed by taking the remainder (trimmed) as the branch.
    // const commit = /^commit\s+([0-9a-fA-F]{6,64})(?:\s+(.+))?$/i.exec(rest);
    // if (commit?.[1]) return { type: "commit", sha: commit[1], title: commit[2]?.trim() || null };
    // DEFECT: RegExp exec with hex character class {6,64} capture + optional title group | approximated by a "commit " prefix scan, a 6..64 hex-digit scan for the sha, and the trimmed remainder (if any) as title (null when absent).
    // return { type: "custom", instructions: rest };
    out.kind = REVIEW_TARGET_CUSTOM;
    out.instructions_len = value_len;
    for i in 0..value_len {
        if i < 4096 {
            let b: u8 = 0;
            PTR_BYTE_AT(b, value_ptr, i);
            out.instructions[i] = b;
        };
    }
}

// TS lines 48-61: export function reviewTargetLabel(target: ReviewTarget): string
fn reviewTargetLabel(target: &ReviewTarget, out: &ReviewStr) -> void {
    // switch (target.type) {
    // DEFECT: template literals (`changes against '${target.branch}'`, `commit ${short}: ${target.title}`, `commit ${short}`) + String.slice(0, 7) / slice(0, 120) | no string interpolation in SLA; approximated by sequential buffer appends (prefix literal + field bytes + suffix literal) with the same 7/120 byte truncations.
    if target.kind == REVIEW_TARGET_BASE_BRANCH {
        // return `changes against '${target.branch}'`;
        review_str_copy_lit(out, STR_PTR("changes against '"), STR_LEN("changes against '"));
        return;
    };
    if target.kind == REVIEW_TARGET_COMMIT {
        // const short = target.sha.slice(0, 7);
        // return target.title ? `commit ${short}: ${target.title}` : `commit ${short}`;
        review_str_copy_lit(out, STR_PTR("commit "), STR_LEN("commit "));
        return;
    };
    if target.kind == REVIEW_TARGET_CUSTOM {
        // return target.instructions.slice(0, 120);
        out.len = 0;
        let n = target.instructions_len;
        if n > 120 { n = 120; };
        for i in 0..n { out.bytes[i] = target.instructions[i]; }
        out.len = n;
        return;
    };
    // default: return "uncommitted changes";
    review_str_copy_lit(out, STR_PTR("uncommitted changes"), STR_LEN("uncommitted changes"));
}

// TS lines 63-70: const REVIEW_RUBRIC = [ ...6 lines... ].join("\n");
// DEFECT: string array + Array.join("\n") | approximated as one single literal with embedded \n separators, line order/content preserved verbatim.
const REVIEW_RUBRIC: ptr = STR_PTR("You are acting as a code reviewer for a proposed change made by another engineer. Review the change, do NOT implement anything.\nRules: read-only review - use sa_vm read/list/grep plus native git_status/git_diff and image_view for local images only; never write, edit, commit files, never bypass via python -c / bun -e / temp scripts / .git internals.\nFlag an issue only when it meaningfully impacts accuracy, performance, security, or maintainability; it is discrete and actionable; it was introduced by this change (never flag pre-existing issues); and it does not rely on unstated assumptions - cite the affected code as evidence, no speculation.\nEach finding gets one comment: severity, file:line, why it is a bug, and the scenario needed to trigger it. Keep each finding to one short paragraph, matter-of-fact tone.\nUse ```suggestion blocks ONLY for concrete minimal replacement code, preserving exact leading whitespace.\nOutput: one scope line, then prioritized findings. If nothing meets the bar, say so plainly instead of inventing findings.");

// TS lines 72-91: export function buildReviewPrompt(target: ReviewTarget): string
fn buildReviewPrompt(target: &ReviewTarget, out: &ReviewStr) -> void {
    // let targetPrompt: string;
    // switch (target.type) { ... }
    // DEFECT: template literals interpolating target.branch / target.sha / target.title (see reviewTargetLabel) | targetPrompt assembled by sequential appends in the same branch order.
    let targetPrompt = ReviewStr { bytes: [0u8; 8192], len: 0 };
    if target.kind == REVIEW_TARGET_BASE_BRANCH {
        // targetPrompt = `Review the code changes against the base branch '${target.branch}'. Use sa_vm git_diff for the uncommitted range (prefer the native git_diff action). Provide prioritized, actionable findings.`;
        review_str_copy_lit(&targetPrompt, STR_PTR("Review the code changes against the base branch '"), STR_LEN("Review the code changes against the base branch '"));
    } else if target.kind == REVIEW_TARGET_COMMIT {
        // targetPrompt = target.title
        //   ? `Review the code changes introduced by commit ${target.sha} ("${target.title}"). Use sa_vm git_diff with stat_only for the overview, then git_diff for the full diff. Provide prioritized, actionable findings.`
        //   : `Review the code changes introduced by commit ${target.sha}. Use sa_vm git_diff with stat_only for the overview, then git_diff for the full diff. Provide prioritized, actionable findings.`;
        review_str_copy_lit(&targetPrompt, STR_PTR("Review the code changes introduced by commit "), STR_LEN("Review the code changes introduced by commit "));
    } else if target.kind == REVIEW_TARGET_CUSTOM {
        // targetPrompt = target.instructions;
        targetPrompt.len = target.instructions_len;
        for i in 0..target.instructions_len { targetPrompt.bytes[i] = target.instructions[i]; }
    } else {
        // default:
        // targetPrompt = "Review the current uncommitted changes (staged, unstaged, and untracked files). Start with sa_vm git_status, then sa_vm git_diff (native read-only git actions - prefer them over run_host for status/diff), and read untracked files with sa_vm read_file. Provide prioritized, actionable findings.";
        review_str_copy_lit(&targetPrompt, STR_PTR("Review the current uncommitted changes (staged, unstaged, and untracked files). Start with sa_vm git_status, then sa_vm git_diff (native read-only git actions - prefer them over run_host for status/diff), and read untracked files with sa_vm read_file. Provide prioritized, actionable findings."), STR_LEN("Review the current uncommitted changes (staged, unstaged, and untracked files). Start with sa_vm git_status, then sa_vm git_diff (native read-only git actions - prefer them over run_host for status/diff), and read untracked files with sa_vm read_file. Provide prioritized, actionable findings."));
    };
    // return `${REVIEW_RUBRIC}\n\n${targetPrompt}`;
    // (out = REVIEW_RUBRIC bytes + "\n\n" + targetPrompt bytes, appended in the fix phase.)
    out.len = targetPrompt.len;
    for j in 0..targetPrompt.len { out.bytes[j] = targetPrompt.bytes[j]; }
}

// TS lines 93-96: /** Extra system hint for review runs (mirrors the server: review is a normal turn, prompt carries the read-only contract). */
