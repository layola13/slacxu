// Converted 1:1 from mini-codex/test/agentsMd.test.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
// DEFECT: test framework | bun:test describe/test/expect has no SLA counterpart; approximated: each test() becomes a fn returning via TestCtx counters, expect(...) becomes expect* helper calls, and main() runs every test in order and returns the failure count.
@import "sa_std/io/print.sai"
@import "sa_std/ptr.sa"
@import "sa_std/string.sa"
@import "../src/agentsMd.sla"
// DEFECT: Node API | node:fs mkdtempSync/mkdirSync/writeFileSync, node:os tmpdir, node:path join approximated via sa_std fs externs (sa_std_fs_mkdir / sa_std_fs_write) and byte concatenation; mkdtemp's random suffix is replaced by fixed test directory names under /tmp.
@import "sa_std/fs.sai"

struct TestCtx {
    checks: u64,
    fails: u64,
}

fn expectTrue(ctx: &TestCtx, cond: bool, label_ptr: ptr, label_len: u64) {
    ctx.checks = ctx.checks + 1;
    if !cond {
        ctx.fails = ctx.fails + 1;
        sa_print_bytes(STR_PTR("FAIL: "), STR_LEN("FAIL: "));
        sa_print_bytes(label_ptr, label_len);
    };
}

fn expectEqStr(ctx: &TestCtx, a_ptr: ptr, a_len: u64, b_ptr: ptr, b_len: u64, label_ptr: ptr, label_len: u64) {
    let same = a_len == b_len;
    if same {
        let i: u64 = 0;
        while i < a_len {
            let x: u8 = 0;
            let y: u8 = 0;
            PTR_BYTE_AT(x, a_ptr, i);
            PTR_BYTE_AT(y, b_ptr, i);
            if x != y { same = false; };
            i = i + 1;
        }
    };
    expectTrue(ctx, same, label_ptr, label_len);
}

fn expectContains(ctx: &TestCtx, hay_ptr: ptr, hay_len: u64, nd_ptr: ptr, nd_len: u64, label_ptr: ptr, label_len: u64) {
    let found = false;
    if hay_len >= nd_len {
        let last = hay_len - nd_len;
        let i: u64 = 0;
        while i <= last && !found {
            let ok = true;
            let j: u64 = 0;
            while j < nd_len {
                let x: u8 = 0;
                let y: u8 = 0;
                PTR_BYTE_AT(x, hay_ptr, i + j);
                PTR_BYTE_AT(y, nd_ptr, j);
                if x != y { ok = false; };
                j = j + 1;
            }
            if ok { found = true; };
            i = i + 1;
        }
    };
    expectTrue(ctx, found, label_ptr, label_len);
}

fn indexOfSub(hay_ptr: ptr, hay_len: u64, nd_ptr: ptr, nd_len: u64) -> i64 {
    if hay_len < nd_len { return -1; };
    let last = hay_len - nd_len;
    let i: u64 = 0;
    while i <= last {
        let ok = true;
        let j: u64 = 0;
        while j < nd_len {
            let x: u8 = 0;
            let y: u8 = 0;
            PTR_BYTE_AT(x, hay_ptr, i + j);
            PTR_BYTE_AT(y, nd_ptr, j);
            if x != y { ok = false; };
            j = j + 1;
        }
        if ok { return i as i64; };
        i = i + 1;
    }
    return -1;
}

// join(dir, name) helper for fixture paths (TS used node:path join).
fn join2(a_ptr: ptr, a_len: u64, b_ptr: ptr, b_len: u64, out: &MdPath) {
    out.len = 0;
    let i: u64 = 0;
    while i < a_len {
        let c: u8 = 0;
        PTR_BYTE_AT(c, a_ptr, i);
        mdPathPushByte(out, c);
        i = i + 1;
    }
    mdPathPushByte(out, 47); // '/'
    i = 0;
    while i < b_len {
        let c: u8 = 0;
        PTR_BYTE_AT(c, b_ptr, i);
        mdPathPushByte(out, c);
        i = i + 1;
    }
}

fn writeTextFile(path: &MdPath, text_ptr: ptr, text_len: u64) {
    let pp: ptr = PTR_NULL();
    PTR_BYTE_ADD(pp, &path.bytes, 0);
    sa_std_fs_write(pp, path.len, text_ptr, text_len);
}

fn mkdirPath(path: &MdPath) {
    let pp: ptr = PTR_NULL();
    PTR_BYTE_ADD(pp, &path.bytes, 0);
    sa_std_fs_mkdir(pp, path.len);
}

// describe("findAgentsMdFiles")
fn test_findAgentsMdFiles(ctx: &TestCtx) {
    // test("finds nested scopes root-first, ignores missing")
    // const dir = mkdtempSync(join(tmpdir(), "mini-agents-"));
    // DEFECT: Node API | mkdtempSync random directory approximated by a fixed path.
    let dir = MdPath { bytes: [0u8; 1024], len: 0 };
    join2(STR_PTR("/tmp"), STR_LEN("/tmp"), STR_PTR("mini-agents-fixed1"), STR_LEN("mini-agents-fixed1"), &dir);
    mkdirPath(&dir);
    // const sub = join(dir, "a", "b"); mkdirSync(sub, { recursive: true });
    // DEFECT: Node API | recursive mkdir approximated by creating each level.
    let a = MdPath { bytes: [0u8; 1024], len: 0 };
    let dp: ptr = PTR_NULL();
    PTR_BYTE_ADD(dp, &dir.bytes, 0);
    join2(dp, dir.len, STR_PTR("a"), STR_LEN("a"), &a);
    mkdirPath(&a);
    let sub = MdPath { bytes: [0u8; 1024], len: 0 };
    let ap: ptr = PTR_NULL();
    PTR_BYTE_ADD(ap, &a.bytes, 0);
    join2(ap, a.len, STR_PTR("b"), STR_LEN("b"), &sub);
    mkdirPath(&sub);
    // writeFileSync(join(dir, "AGENTS.md"), "root rules");
    let root_file = MdPath { bytes: [0u8; 1024], len: 0 };
    joinAgentsMd(&dir, &root_file);
    writeTextFile(&root_file, STR_PTR("root rules"), STR_LEN("root rules"));
    // writeFileSync(join(sub, "AGENTS.md"), "leaf rules");
    let leaf_file = MdPath { bytes: [0u8; 1024], len: 0 };
    joinAgentsMd(&sub, &leaf_file);
    writeTextFile(&leaf_file, STR_PTR("leaf rules"), STR_LEN("leaf rules"));
    // const found = findAgentsMdFiles(sub, 4);
    let sp: ptr = PTR_NULL();
    PTR_BYTE_ADD(sp, &sub.bytes, 0);
    let found = MdPathList { paths: [MdPath { bytes: [0u8; 1024], len: 0 }; 12], len: 0 };
    findAgentsMdFiles(sp, sub.len, 4, &found);
    // expect(found).toEqual([join(dir, "AGENTS.md"), join(sub, "AGENTS.md")]);
    expectTrue(ctx, found.len == 2, STR_PTR("finds nested scopes: count"), STR_LEN("finds nested scopes: count"));
    if found.len == 2 {
        let f0: ptr = PTR_NULL();
        PTR_BYTE_ADD(f0, &found.paths[0].bytes, 0);
        let rfp: ptr = PTR_NULL();
        PTR_BYTE_ADD(rfp, &root_file.bytes, 0);
        expectEqStr(ctx, f0, found.paths[0].len, rfp, root_file.len, STR_PTR("finds nested scopes: [0] root"), STR_LEN("finds nested scopes: [0] root"));
        let f1: ptr = PTR_NULL();
        PTR_BYTE_ADD(f1, &found.paths[1].bytes, 0);
        let lfp: ptr = PTR_NULL();
        PTR_BYTE_ADD(lfp, &leaf_file.bytes, 0);
        expectEqStr(ctx, f1, found.paths[1].len, lfp, leaf_file.len, STR_PTR("finds nested scopes: [1] leaf"), STR_LEN("finds nested scopes: [1] leaf"));
    };
    // test("empty dir -> []")
    let empty = MdPath { bytes: [0u8; 1024], len: 0 };
    join2(STR_PTR("/tmp"), STR_LEN("/tmp"), STR_PTR("mini-agents-empty-fixed"), STR_LEN("mini-agents-empty-fixed"), &empty);
    mkdirPath(&empty);
    let ep: ptr = PTR_NULL();
    PTR_BYTE_ADD(ep, &empty.bytes, 0);
    let found2 = MdPathList { paths: [MdPath { bytes: [0u8; 1024], len: 0 }; 12], len: 0 };
    findAgentsMdFiles(ep, empty.len, 1, &found2);
    expectTrue(ctx, found2.len == 0, STR_PTR("empty dir -> []"), STR_LEN("empty dir -> []"));
}

// describe("loadAgentsMd")
fn test_loadAgentsMd(ctx: &TestCtx) {
    // test("concatenates scopes, nearest last (highest precedence)")
    let dir = MdPath { bytes: [0u8; 1024], len: 0 };
    join2(STR_PTR("/tmp"), STR_LEN("/tmp"), STR_PTR("mini-agents-fixed2"), STR_LEN("mini-agents-fixed2"), &dir);
    mkdirPath(&dir);
    let sub = MdPath { bytes: [0u8; 1024], len: 0 };
    let dp: ptr = PTR_NULL();
    PTR_BYTE_ADD(dp, &dir.bytes, 0);
    join2(dp, dir.len, STR_PTR("pkg"), STR_LEN("pkg"), &sub);
    mkdirPath(&sub);
    let root_file = MdPath { bytes: [0u8; 1024], len: 0 };
    joinAgentsMd(&dir, &root_file);
    writeTextFile(&root_file, STR_PTR("root rules"), STR_LEN("root rules"));
    let leaf_file = MdPath { bytes: [0u8; 1024], len: 0 };
    joinAgentsMd(&sub, &leaf_file);
    writeTextFile(&leaf_file, STR_PTR("leaf rules"), STR_LEN("leaf rules"));
    // const out = loadAgentsMd(sub, AGENTS_MD_MAX_BYTES, 4);
    let sp: ptr = PTR_NULL();
    PTR_BYTE_ADD(sp, &sub.bytes, 0);
    let out = MdStr { bytes: [0u8; 16384], len: 0 };
    let has = loadAgentsMd(sp, sub.len, AGENTS_MD_MAX_BYTES, 4, &out);
    expectTrue(ctx, has, STR_PTR("concatenates scopes: non-null"), STR_LEN("concatenates scopes: non-null"));
    let op: ptr = PTR_NULL();
    PTR_BYTE_ADD(op, &out.bytes, 0);
    expectContains(ctx, op, out.len, STR_PTR("root rules"), STR_LEN("root rules"), STR_PTR("concatenates scopes: root"), STR_LEN("concatenates scopes: root"));
    expectContains(ctx, op, out.len, STR_PTR("leaf rules"), STR_LEN("leaf rules"), STR_PTR("concatenates scopes: leaf"), STR_LEN("concatenates scopes: leaf"));
    // expect(out!.indexOf("root rules")).toBeLessThan(out!.indexOf("leaf rules"));
    // DEFECT: assertion | expect(...).toBeLessThan approximated by comparing indexOfSub results.
    let ri = indexOfSub(op, out.len, STR_PTR("root rules"), STR_LEN("root rules"));
    let li = indexOfSub(op, out.len, STR_PTR("leaf rules"), STR_LEN("leaf rules"));
    expectTrue(ctx, ri >= 0 && li >= 0 && ri < li, STR_PTR("concatenates scopes: order"), STR_LEN("concatenates scopes: order"));
    // test("no AGENTS.md -> null")
    let none_dir = MdPath { bytes: [0u8; 1024], len: 0 };
    join2(STR_PTR("/tmp"), STR_LEN("/tmp"), STR_PTR("mini-agents-none-fixed"), STR_LEN("mini-agents-none-fixed"), &none_dir);
    mkdirPath(&none_dir);
    let ndp: ptr = PTR_NULL();
    PTR_BYTE_ADD(ndp, &none_dir.bytes, 0);
    let out2 = MdStr { bytes: [0u8; 16384], len: 0 };
    let has2 = loadAgentsMd(ndp, none_dir.len, AGENTS_MD_MAX_BYTES, 1, &out2);
    expectTrue(ctx, !has2, STR_PTR("no AGENTS.md -> null"), STR_LEN("no AGENTS.md -> null"));
    // test("total output capped")
    let cap_dir = MdPath { bytes: [0u8; 1024], len: 0 };
    join2(STR_PTR("/tmp"), STR_LEN("/tmp"), STR_PTR("mini-agents-fixed3"), STR_LEN("mini-agents-fixed3"), &cap_dir);
    mkdirPath(&cap_dir);
    let cap_file = MdPath { bytes: [0u8; 1024], len: 0 };
    joinAgentsMd(&cap_dir, &cap_file);
    // writeFileSync(join(dir, "AGENTS.md"), `x\n${"y".repeat(AGENTS_MD_MAX_BYTES + 100)}`);
    // DEFECT: string methods | "y".repeat(n) + template literal approximated by filling a byte buffer.
    let big = MdStr { bytes: [0u8; 16384], len: 0 };
    mdStrPushByte(&big, 120); // 'x'
    mdStrPushByte(&big, 10); // '\n'
    let n = AGENTS_MD_MAX_BYTES + 100;
    let i: u64 = 0;
    while i < n {
        mdStrPushByte(&big, 121); // 'y'
        i = i + 1;
    }
    let bp: ptr = PTR_NULL();
    PTR_BYTE_ADD(bp, &big.bytes, 0);
    writeTextFile(&cap_file, bp, big.len);
    let cdp: ptr = PTR_NULL();
    PTR_BYTE_ADD(cdp, &cap_dir.bytes, 0);
    let out3 = MdStr { bytes: [0u8; 16384], len: 0 };
    let has3 = loadAgentsMd(cdp, cap_dir.len, AGENTS_MD_MAX_BYTES, AGENTS_MD_MAX_LEVELS, &out3);
    expectTrue(ctx, has3, STR_PTR("total output capped: non-null"), STR_LEN("total output capped: non-null"));
    // expect(out.length).toBeLessThanOrEqual(AGENTS_MD_MAX_BYTES + 64);
    expectTrue(ctx, out3.len <= AGENTS_MD_MAX_BYTES + 64, STR_PTR("total output capped: length"), STR_LEN("total output capped: length"));
    let o3p: ptr = PTR_NULL();
    PTR_BYTE_ADD(o3p, &out3.bytes, 0);
    expectContains(ctx, o3p, out3.len, STR_PTR("truncated"), STR_LEN("truncated"), STR_PTR("total output capped: marker"), STR_LEN("total output capped: marker"));
}

fn main() -> i32 {
    let ctx = TestCtx { checks: 0, fails: 0 };
    test_findAgentsMdFiles(&ctx);
    test_loadAgentsMd(&ctx);
    if ctx.fails > 0 {
        sa_print_bytes(STR_PTR("agentsMd.test: FAIL"), STR_LEN("agentsMd.test: FAIL"));
        return 1;
    };
    sa_print_bytes(STR_PTR("agentsMd.test: PASS"), STR_LEN("agentsMd.test: PASS"));
    return 0;
}

// Fix-phase wrappers (Agent M): the bulk pass called a fabricated
// sa_std_fs_write / sa_std_fs_mkdir pair; bind them to the real surface.
fn sa_std_fs_write(path_p: ptr, path_l: u64, data_p: ptr, data_l: u64) -> i32 {
    return sa_fs_write_file(path_p, path_l, data_p, data_l);
}

fn sa_std_fs_mkdir(path_p: ptr, path_l: u64) -> i32 {
    return sa_fs_mkdir_p(path_p, path_l);
}
