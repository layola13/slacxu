// Converted 1:1 from mini-codex/test/loop.test.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
// Regression tests for: echo-repeat, context amnesia, /goal placebo.
// Run: bun test test/loop.test.ts (no network: pure helpers only).
// DEFECT: test framework | bun:test describe/test/expect has no SLA counterpart; approximated: each test() becomes a fn, expect(...) becomes expect* helper calls, main() runs all tests and returns the failure count.
// DEFECT: cross-unit signatures | loop.sla / responses.sla are converted by another unit; calls below assume (ptr,len)/struct approximations of their signatures. Skills argument of buildBaseSystem is always [] in these tests and is omitted (noted per call).
@import "sa_std/io/print.sai"
@import "sa_std/ptr.sa"
@import "../src/types.sla"
@import "../src/loop.sla"
@import "../src/responses.sla"
// DEFECT: Node API | node:fs mkdtempSync/readFileSync/writeFileSync, node:os tmpdir, node:path join approximated via sa_std fs externs (sa_std_fs_mkdir / sa_std_fs_read / sa_std_fs_write) and byte concatenation; mkdtemp random suffixes replaced by fixed names.
// @import "sa_std/fs.sai"

struct TestCtx {
    checks: u64,
    fails: u64,
}

// Growable text buffer (TS string / JSON text).
struct LoopStr {
    bytes: [u8; 32768], len: u64,
}

// ThreadItem[] carrier (TS ThreadItem[]).
struct ThreadVec {
    items: [ThreadItem; 512], len: u64,
}

// runPrompt config approximation: { baseUrl, apiKey, model, cwd }.
struct LoopCfg {
    base_url: [u8; 256], base_url_len: u64,
    api_key: [u8; 256], api_key_len: u64,
    model: [u8; 128], model_len: u64,
    cwd: [u8; 1024], cwd_len: u64,
}

// Captured fetch bodies from the stubbed-fetch runPrompt runs (JSON array text + count).
struct FetchBodies {
    json: [u8; 32768], json_len: u64,
    count: u64,
}

fn expectTrue(ctx: &TestCtx, cond: bool, label_ptr: ptr, label_len: u64) {
    ctx.checks = ctx.checks + 1;
    if !cond {
        ctx.fails = ctx.fails + 1;
        print("FAIL: ");
        println(label_ptr, label_len);
    };
}

fn bufEq(a_ptr: ptr, a_len: u64, b_ptr: ptr, b_len: u64) -> bool {
    if a_len != b_len { return false; };
    let i: u64 = 0;
    while i < a_len {
        let x: u8 = 0;
        let y: u8 = 0;
        PTR_BYTE_AT(x, a_ptr, i);
        PTR_BYTE_AT(y, b_ptr, i);
        if x != y { return false; };
        i = i + 1;
    }
    return true;
}

fn bufContains(hay_ptr: ptr, hay_len: u64, nd_ptr: ptr, nd_len: u64) -> bool {
    if hay_len < nd_len { return false; };
    let last = hay_len - nd_len;
    let i: u64 = 0;
    while i <= last {
        let ok = true;
        let j: u64 = 0;
        while j < nd_len {
            let x: u8 = 0;
            let y: u8 = 0;
            PTR_BYTE_AT(x, hay_ptr, i + j);
            PTR_BYTE_AT(y, nd_ptr, j);
            if x != y { ok = false; };
            j = j + 1;
        }
        if ok { return true; };
        i = i + 1;
    }
    return false;
}

fn expectContains(ctx: &TestCtx, hay_ptr: ptr, hay_len: u64, nd_ptr: ptr, nd_len: u64, label_ptr: ptr, label_len: u64) {
    expectTrue(ctx, bufContains(hay_ptr, hay_len, nd_ptr, nd_len), label_ptr, label_len);
}

fn expectNotContains(ctx: &TestCtx, hay_ptr: ptr, hay_len: u64, nd_ptr: ptr, nd_len: u64, label_ptr: ptr, label_len: u64) {
    expectTrue(ctx, !bufContains(hay_ptr, hay_len, nd_ptr, nd_len), label_ptr, label_len);
}

fn indexOfSub(hay_ptr: ptr, hay_len: u64, nd_ptr: ptr, nd_len: u64) -> i64 {
    if hay_len < nd_len { return -1; };
    let last = hay_len - nd_len;
    let i: u64 = 0;
    while i <= last {
        let ok = true;
        let j: u64 = 0;
        while j < nd_len {
            let x: u8 = 0;
            let y: u8 = 0;
            PTR_BYTE_AT(x, hay_ptr, i + j);
            PTR_BYTE_AT(y, nd_ptr, j);
            if x != y { ok = false; };
            j = j + 1;
        }
        if ok { return i as i64; };
        i = i + 1;
    }
    return -1;
}

// --- ThreadItem literal constructors (TS object literals in the tests) ---

fn emptyItem() -> ThreadItem {
    return ThreadItem { kind: 0, text: [0u8; 8192], text_len: 0, call_id: [0u8; 128], call_id_len: 0, name: [0u8; 256], name_len: 0, args: [0u8; 8192], args_len: 0, output: [0u8; 8192], output_len: 0, images_json: [0u8; 8192], images_json_len: 0, has_images: false, plan: [ThreadPlanStep { step: [0u8; 512], step_len: 0, status: [0u8; 32], status_len: 0 }; 20], plan_len: 0 };
}

fn setField(dst: ptr, dst_cap: u64, src_ptr: ptr, src_len: u64) -> u64 {
    let n = src_len;
    if n > dst_cap { n = dst_cap; };
    let i: u64 = 0;
    while i < n {
        let b: u8 = 0;
        PTR_BYTE_AT(b, src_ptr, i);
        dst[i] = b;
        i = i + 1;
    }
    return n;
}

fn makeTextItem(kind: u64, text_ptr: ptr, text_len: u64) -> ThreadItem {
    let it = emptyItem();
    it.kind = kind;
    let dp: ptr = PTR_NULL();
    PTR_BYTE_ADD(dp, &it.text, 0);
    it.text_len = setField(dp, 8192, text_ptr, text_len);
    return it;
}

fn makeCallItem(call_id_ptr: ptr, call_id_len: u64, name_ptr: ptr, name_len: u64, args_ptr: ptr, args_len: u64) -> ThreadItem {
    let it = emptyItem();
    it.kind = THREAD_ITEM_FUNCTION_CALL;
    let dp: ptr = PTR_NULL();
    PTR_BYTE_ADD(dp, &it.call_id, 0);
    it.call_id_len = setField(dp, 128, call_id_ptr, call_id_len);
    let np: ptr = PTR_NULL();
    PTR_BYTE_ADD(np, &it.name, 0);
    it.name_len = setField(np, 256, name_ptr, name_len);
    let ap: ptr = PTR_NULL();
    PTR_BYTE_ADD(ap, &it.args, 0);
    it.args_len = setField(ap, 8192, args_ptr, args_len);
    return it;
}

fn makeOutputItem(call_id_ptr: ptr, call_id_len: u64, out_ptr: ptr, out_len: u64) -> ThreadItem {
    let it = emptyItem();
    it.kind = THREAD_ITEM_FUNCTION_CALL_OUTPUT;
    let dp: ptr = PTR_NULL();
    PTR_BYTE_ADD(dp, &it.call_id, 0);
    it.call_id_len = setField(dp, 128, call_id_ptr, call_id_len);
    let op: ptr = PTR_NULL();
    PTR_BYTE_ADD(op, &it.output, 0);
    it.output_len = setField(op, 8192, out_ptr, out_len);
    return it;
}

fn threadPush(tv: &ThreadVec, it: &ThreadItem) {
    if tv.len < 512 {
        tv.items[tv.len] = it;
        tv.len = tv.len + 1;
    };
}

// expect(a).toEqual(b) for ThreadItem — field-wise comparison of the populated fields.
// DEFECT: assertion | toEqual deep equality approximated by comparing kind + all text fields.
fn itemEq(a: &ThreadItem, b: &ThreadItem) -> bool {
    if a.kind != b.kind { return false; };
    let ap: ptr = PTR_NULL();
    PTR_BYTE_ADD(ap, &a.text, 0);
    let bp: ptr = PTR_NULL();
    PTR_BYTE_ADD(bp, &b.text, 0);
    if !bufEq(ap, a.text_len, bp, b.text_len) { return false; };
    let ac: ptr = PTR_NULL();
    PTR_BYTE_ADD(ac, &a.call_id, 0);
    let bc: ptr = PTR_NULL();
    PTR_BYTE_ADD(bc, &b.call_id, 0);
    if !bufEq(ac, a.call_id_len, bc, b.call_id_len) { return false; };
    let an: ptr = PTR_NULL();
    PTR_BYTE_ADD(an, &a.name, 0);
    let bn: ptr = PTR_NULL();
    PTR_BYTE_ADD(bn, &b.name, 0);
    if !bufEq(an, a.name_len, bn, b.name_len) { return false; };
    let ao: ptr = PTR_NULL();
    PTR_BYTE_ADD(ao, &a.output, 0);
    let bo: ptr = PTR_NULL();
    PTR_BYTE_ADD(bo, &b.output, 0);
    if !bufEq(ao, a.output_len, bo, b.output_len) { return false; };
    return true;
}

fn expectItemEq(ctx: &TestCtx, a: &ThreadItem, b: &ThreadItem, label_ptr: ptr, label_len: u64) {
    expectTrue(ctx, itemEq(a, b), label_ptr, label_len);
}

fn loopStrPush(out: &LoopStr, src_ptr: ptr, src_len: u64) {
    let i: u64 = 0;
    while i < src_len && out.len < 32768 {
        let b: u8 = 0;
        PTR_BYTE_AT(b, src_ptr, i);
        out.bytes[out.len] = b;
        out.len = out.len + 1;
        i = i + 1;
    }
}

// Build a JSONL file content from items (TS: items.map(x => JSON.stringify(x)).join("\n")).
// DEFECT: dynamic object | JSON.stringify of ThreadItem approximated by a canonical rendering: {"type":"<kind>","text":"<text>"} / call / output shapes; test data avoids characters needing escaping.
fn itemToJson(it: &ThreadItem, out: &LoopStr) {
    if it.kind == THREAD_ITEM_USER || it.kind == THREAD_ITEM_MESSAGE || it.kind == THREAD_ITEM_REASONING {
        loopStrPush(out, STR_PTR("{\"type\":\""), STR_LEN("{\"type\":\""));
        if it.kind == THREAD_ITEM_USER { loopStrPush(out, STR_PTR("user"), STR_LEN("user")); };
        if it.kind == THREAD_ITEM_MESSAGE { loopStrPush(out, STR_PTR("message"), STR_LEN("message")); };
        if it.kind == THREAD_ITEM_REASONING { loopStrPush(out, STR_PTR("reasoning"), STR_LEN("reasoning")); };
        loopStrPush(out, STR_PTR("\",\"text\":\""), STR_LEN("\",\"text\":\""));
        let tp: ptr = PTR_NULL();
        PTR_BYTE_ADD(tp, &it.text, 0);
        loopStrPush(out, tp, it.text_len);
        loopStrPush(out, STR_PTR("\"}"), STR_LEN("\"}"));
    } else if it.kind == THREAD_ITEM_FUNCTION_CALL {
        loopStrPush(out, STR_PTR("{\"type\":\"function_call\",\"callId\":\""), STR_LEN("{\"type\":\"function_call\",\"callId\":\""));
        let cp: ptr = PTR_NULL();
        PTR_BYTE_ADD(cp, &it.call_id, 0);
        loopStrPush(out, cp, it.call_id_len);
        loopStrPush(out, STR_PTR("\",\"name\":\""), STR_LEN("\",\"name\":\""));
        let np: ptr = PTR_NULL();
        PTR_BYTE_ADD(np, &it.name, 0);
        loopStrPush(out, np, it.name_len);
        loopStrPush(out, STR_PTR("\",\"args\":\""), STR_LEN("\",\"args\":\""));
        let ap: ptr = PTR_NULL();
        PTR_BYTE_ADD(ap, &it.args, 0);
        loopStrPush(out, ap, it.args_len);
        loopStrPush(out, STR_PTR("\"}"), STR_LEN("\"}"));
    } else if it.kind == THREAD_ITEM_FUNCTION_CALL_OUTPUT {
        loopStrPush(out, STR_PTR("{\"type\":\"function_call_output\",\"callId\":\""), STR_LEN("{\"type\":\"function_call_output\",\"callId\":\""));
        let cp: ptr = PTR_NULL();
        PTR_BYTE_ADD(cp, &it.call_id, 0);
        loopStrPush(out, cp, it.call_id_len);
        loopStrPush(out, STR_PTR("\",\"output\":\""), STR_LEN("\",\"output\":\""));
        let op: ptr = PTR_NULL();
        PTR_BYTE_ADD(op, &it.output, 0);
        loopStrPush(out, op, it.output_len);
        loopStrPush(out, STR_PTR("\"}"), STR_LEN("\"}"));
    };
}

fn writeThreadFile(path_ptr: ptr, path_len: u64, tv: &ThreadVec) {
    let content = LoopStr { bytes: [0u8; 32768], len: 0 };
    let i: u64 = 0;
    while i < tv.len {
        if i > 0 { loopStrPush(&content, STR_PTR("\n"), STR_LEN("\n")); };
        itemToJson(&tv.items[i], &content);
        i = i + 1;
    }
    let cp: ptr = PTR_NULL();
    PTR_BYTE_ADD(cp, &content.bytes, 0);
    sa_std_fs_write(path_ptr, path_len, cp, content.len);
}

// join(tmpdir(), name) stand-in: builds "/tmp/<name>" into out (returns ptr via out buffer).
fn tmpPath(name_ptr: ptr, name_len: u64, out: &LoopStr) {
    out.len = 0;
    loopStrPush(out, STR_PTR("/tmp/"), STR_LEN("/tmp/"));
    loopStrPush(out, name_ptr, name_len);
}

fn cfgOf(cwd_ptr: ptr, cwd_len: u64) -> LoopCfg {
    // const cfg = { baseUrl: "http://127.0.0.1:1", apiKey: "x", model: "m", cwd: ... };
    let c = LoopCfg { base_url: [0u8; 256], base_url_len: 0, api_key: [0u8; 256], api_key_len: 0, model: [0u8; 128], model_len: 0, cwd: [0u8; 1024], cwd_len: 0 };
    let bp: ptr = PTR_NULL();
    PTR_BYTE_ADD(bp, &c.base_url, 0);
    c.base_url_len = setField(bp, 256, STR_PTR("http://127.0.0.1:1"), STR_LEN("http://127.0.0.1:1"));
    let kp: ptr = PTR_NULL();
    PTR_BYTE_ADD(kp, &c.api_key, 0);
    c.api_key_len = setField(kp, 256, STR_PTR("x"), STR_LEN("x"));
    let mp: ptr = PTR_NULL();
    PTR_BYTE_ADD(mp, &c.model, 0);
    c.model_len = setField(mp, 128, STR_PTR("m"), STR_LEN("m"));
    let wp: ptr = PTR_NULL();
    PTR_BYTE_ADD(wp, &c.cwd, 0);
    c.cwd_len = setField(wp, 1024, cwd_ptr, cwd_len);
    return c;
}

// describe("output contract (anti-echo)")
fn test_outputContract(ctx: &TestCtx) {
    let s = LoopStr { bytes: [0u8; 32768], len: 0 };
    // test("base system forbids repeating the request") — buildBaseSystem("", [], 0)
    buildBaseSystem(STR_PTR(""), 0, 0, STR_PTR(""), 0, false, &s);
    let sp: ptr = PTR_NULL();
    PTR_BYTE_ADD(sp, &s.bytes, 0);
    expectContains(ctx, sp, s.len, STR_PTR("Never repeat"), STR_LEN("Never repeat"), STR_PTR("base system: Never repeat"), STR_LEN("base system: Never repeat"));
    expectContains(ctx, sp, s.len, STR_PTR("summary"), STR_LEN("summary"), STR_PTR("base system: summary"), STR_LEN("base system: summary"));
    // test("depth 0 keeps subagent suffix, depth 1 drops it")
    buildBaseSystem(STR_PTR(""), 0, 0, STR_PTR(""), 0, false, &s);
    sp = PTR_NULL();
    PTR_BYTE_ADD(sp, &s.bytes, 0);
    expectContains(ctx, sp, s.len, STR_PTR("Sub-agents:"), STR_LEN("Sub-agents:"), STR_PTR("depth 0: Sub-agents"), STR_LEN("depth 0: Sub-agents"));
    buildBaseSystem(STR_PTR(""), 0, 1, STR_PTR(""), 0, false, &s);
    sp = PTR_NULL();
    PTR_BYTE_ADD(sp, &s.bytes, 0);
    expectNotContains(ctx, sp, s.len, STR_PTR("Sub-agents:"), STR_LEN("Sub-agents:"), STR_PTR("depth 1: no Sub-agents"), STR_LEN("depth 1: no Sub-agents"));
}

// describe("parseGoalArgs")
fn test_parseGoalArgs(ctx: &TestCtx) {
    let out = LoopStr { bytes: [0u8; 32768], len: 0 };
    // test("parses objective")
    let ok = parseGoalArgs(STR_PTR("/goal fix login and verify"), STR_LEN("/goal fix login and verify"), &out);
    let op: ptr = PTR_NULL();
    PTR_BYTE_ADD(op, &out.bytes, 0);
    expectTrue(ctx, ok && bufEq(op, out.len, STR_PTR("fix login and verify"), STR_LEN("fix login and verify")), STR_PTR("parseGoalArgs: objective"), STR_LEN("parseGoalArgs: objective"));
    // test("bare /goal -> empty (usage)")
    ok = parseGoalArgs(STR_PTR("/goal"), STR_LEN("/goal"), &out);
    expectTrue(ctx, ok && out.len == 0, STR_PTR("parseGoalArgs: bare"), STR_LEN("parseGoalArgs: bare"));
    ok = parseGoalArgs(STR_PTR("/goal   "), STR_LEN("/goal   "), &out);
    expectTrue(ctx, ok && out.len == 0, STR_PTR("parseGoalArgs: bare spaces"), STR_LEN("parseGoalArgs: bare spaces"));
    // test("non-goal -> null") — null approximated by ok == false.
    // DEFECT: nullable return | string | null approximated as bool + out buffer.
    ok = parseGoalArgs(STR_PTR("hello"), STR_LEN("hello"), &out);
    expectTrue(ctx, !ok, STR_PTR("parseGoalArgs: hello null"), STR_LEN("parseGoalArgs: hello null"));
    ok = parseGoalArgs(STR_PTR("/goals x"), STR_LEN("/goals x"), &out);
    expectTrue(ctx, !ok, STR_PTR("parseGoalArgs: /goals null"), STR_LEN("parseGoalArgs: /goals null"));
    ok = parseGoalArgs(STR_PTR("/status"), STR_LEN("/status"), &out);
    expectTrue(ctx, !ok, STR_PTR("parseGoalArgs: /status null"), STR_LEN("parseGoalArgs: /status null"));
}

// describe("goal markers")
fn test_goalMarkers(ctx: &TestCtx) {
    // test("DONE/BLOCKED detection")
    expectTrue(ctx, isGoalDone(STR_PTR("did it\nGOAL_DONE"), STR_LEN("did it\nGOAL_DONE")), STR_PTR("isGoalDone: trailing"), STR_LEN("isGoalDone: trailing"));
    expectTrue(ctx, !isGoalDone(STR_PTR("GOAL_DONE\nmore claims after marker"), STR_LEN("GOAL_DONE\nmore claims after marker")), STR_PTR("isGoalDone: not last"), STR_LEN("isGoalDone: not last"));
    expectTrue(ctx, !isGoalDone(STR_PTR("GOAL_DONE extra"), STR_LEN("GOAL_DONE extra")), STR_PTR("isGoalDone: extra"), STR_LEN("isGoalDone: extra"));
    expectTrue(ctx, isGoalBlocked(STR_PTR("stuck\nGOAL_BLOCKED"), STR_LEN("stuck\nGOAL_BLOCKED")), STR_PTR("isGoalBlocked: trailing"), STR_LEN("isGoalBlocked: trailing"));
    expectTrue(ctx, !isGoalBlocked(STR_PTR("GOAL_BLOCKED\nnot actually blocked"), STR_LEN("GOAL_BLOCKED\nnot actually blocked")), STR_PTR("isGoalBlocked: not last"), STR_LEN("isGoalBlocked: not last"));
    expectTrue(ctx, !isGoalDone(STR_PTR("nothing"), STR_LEN("nothing")), STR_PTR("isGoalDone: nothing"), STR_LEN("isGoalDone: nothing"));
    // test("cleanGoalMarker strips marker lines only")
    let out = LoopStr { bytes: [0u8; 32768], len: 0 };
    cleanGoalMarker(STR_PTR("fixed x\n- evidence\nGOAL_DONE"), STR_LEN("fixed x\n- evidence\nGOAL_DONE"), &out);
    let op: ptr = PTR_NULL();
    PTR_BYTE_ADD(op, &out.bytes, 0);
    expectTrue(ctx, bufEq(op, out.len, STR_PTR("fixed x\n- evidence"), STR_LEN("fixed x\n- evidence")), STR_PTR("cleanGoalMarker: strips"), STR_LEN("cleanGoalMarker: strips"));
    cleanGoalMarker(STR_PTR("GOAL_BLOCKED"), STR_LEN("GOAL_BLOCKED"), &out);
    expectTrue(ctx, out.len == 0, STR_PTR("cleanGoalMarker: only marker"), STR_LEN("cleanGoalMarker: only marker"));
    // test("goal suffix demands evidence + markers + no echo")
    goalSystemSuffix(STR_PTR("fix X"), STR_LEN("fix X"), &out);
    op = PTR_NULL();
    PTR_BYTE_ADD(op, &out.bytes, 0);
    expectContains(ctx, op, out.len, STR_PTR("GOAL_DONE"), STR_LEN("GOAL_DONE"), STR_PTR("goal suffix: DONE"), STR_LEN("goal suffix: DONE"));
    expectContains(ctx, op, out.len, STR_PTR("GOAL_BLOCKED"), STR_LEN("GOAL_BLOCKED"), STR_PTR("goal suffix: BLOCKED"), STR_LEN("goal suffix: BLOCKED"));
    expectContains(ctx, op, out.len, STR_PTR("evidence"), STR_LEN("evidence"), STR_PTR("goal suffix: evidence"), STR_LEN("goal suffix: evidence"));
    expectContains(ctx, op, out.len, STR_PTR("Never repeat"), STR_LEN("Never repeat"), STR_PTR("goal suffix: Never repeat"), STR_LEN("goal suffix: Never repeat"));
}

// describe("hasGoalToolEvidence")
fn test_hasGoalToolEvidence(ctx: &TestCtx) {
    // test("requires a call and its output within the current goal")
    let thread = ThreadVec { items: [ThreadItem { kind: 0, text: [0u8; 8192], text_len: 0, call_id: [0u8; 128], call_id_len: 0, name: [0u8; 256], name_len: 0, args: [0u8; 8192], args_len: 0, output: [0u8; 8192], output_len: 0, images_json: [0u8; 8192], images_json_len: 0, has_images: false, plan: [ThreadPlanStep { step: [0u8; 512], step_len: 0, status: [0u8; 32], status_len: 0 }; 20], plan_len: 0 }; 512], len: 0 };
    threadPush(&thread, &makeCallItem(STR_PTR("old"), STR_LEN("old"), STR_PTR("read"), STR_LEN("read"), STR_PTR("{}"), STR_LEN("{}")));
    threadPush(&thread, &makeOutputItem(STR_PTR("old"), STR_LEN("old"), STR_PTR("old result"), STR_LEN("old result")));
    threadPush(&thread, &makeTextItem(THREAD_ITEM_USER, STR_PTR("new goal"), STR_LEN("new goal")));
    threadPush(&thread, &makeCallItem(STR_PTR("new"), STR_LEN("new"), STR_PTR("test"), STR_LEN("test"), STR_PTR("{}"), STR_LEN("{}")));
    threadPush(&thread, &makeOutputItem(STR_PTR("new"), STR_LEN("new"), STR_PTR("tests passed"), STR_LEN("tests passed")));
    expectTrue(ctx, hasGoalToolEvidence(&thread, 2, true), STR_PTR("evidence: from 2"), STR_LEN("evidence: from 2"));
    expectTrue(ctx, !hasGoalToolEvidence(&thread, 4, true), STR_PTR("evidence: from 4"), STR_LEN("evidence: from 4"));
    // test("does not accept an unmatched output as evidence")
    let t2 = ThreadVec { items: [ThreadItem { kind: 0, text: [0u8; 8192], text_len: 0, call_id: [0u8; 128], call_id_len: 0, name: [0u8; 256], name_len: 0, args: [0u8; 8192], args_len: 0, output: [0u8; 8192], output_len: 0, images_json: [0u8; 8192], images_json_len: 0, has_images: false, plan: [ThreadPlanStep { step: [0u8; 512], step_len: 0, status: [0u8; 32], status_len: 0 }; 20], plan_len: 0 }; 512], len: 0 };
    threadPush(&t2, &makeOutputItem(STR_PTR("missing"), STR_LEN("missing"), STR_PTR("result"), STR_LEN("result")));
    expectTrue(ctx, !hasGoalToolEvidence(&t2, 0, false), STR_PTR("evidence: unmatched"), STR_LEN("evidence: unmatched"));
}

// describe("isGoalTerminalSupported")
fn test_isGoalTerminalSupported(ctx: &TestCtx) {
    let evidence = ThreadVec { items: [ThreadItem { kind: 0, text: [0u8; 8192], text_len: 0, call_id: [0u8; 128], call_id_len: 0, name: [0u8; 256], name_len: 0, args: [0u8; 8192], args_len: 0, output: [0u8; 8192], output_len: 0, images_json: [0u8; 8192], images_json_len: 0, has_images: false, plan: [ThreadPlanStep { step: [0u8; 512], step_len: 0, status: [0u8; 32], status_len: 0 }; 20], plan_len: 0 }; 512], len: 0 };
    threadPush(&evidence, &makeCallItem(STR_PTR("verify"), STR_LEN("verify"), STR_PTR("test"), STR_LEN("test"), STR_PTR("{}"), STR_LEN("{}")));
    threadPush(&evidence, &makeOutputItem(STR_PTR("verify"), STR_LEN("verify"), STR_PTR("tests passed"), STR_LEN("tests passed")));
    let empty = ThreadVec { items: [ThreadItem { kind: 0, text: [0u8; 8192], text_len: 0, call_id: [0u8; 128], call_id_len: 0, name: [0u8; 256], name_len: 0, args: [0u8; 8192], args_len: 0, output: [0u8; 8192], output_len: 0, images_json: [0u8; 8192], images_json_len: 0, has_images: false, plan: [ThreadPlanStep { step: [0u8; 512], step_len: 0, status: [0u8; 32], status_len: 0 }; 20], plan_len: 0 }; 512], len: 0 };
    // test("requires a non-echo summary and tool output")
    expectTrue(ctx, !isGoalTerminalSupported(STR_PTR("\nGOAL_DONE"), STR_LEN("\nGOAL_DONE"), STR_PTR("fix login"), STR_LEN("fix login"), &evidence), STR_PTR("terminal: empty summary"), STR_LEN("terminal: empty summary"));
    expectTrue(ctx, !isGoalTerminalSupported(STR_PTR("fix login\nGOAL_DONE"), STR_LEN("fix login\nGOAL_DONE"), STR_PTR("fix login"), STR_LEN("fix login"), &evidence), STR_PTR("terminal: echo summary"), STR_LEN("terminal: echo summary"));
    expectTrue(ctx, isGoalTerminalSupported(STR_PTR("Fixed login and verified tests.\nGOAL_DONE"), STR_LEN("Fixed login and verified tests.\nGOAL_DONE"), STR_PTR("fix login"), STR_LEN("fix login"), &evidence), STR_PTR("terminal: supported"), STR_LEN("terminal: supported"));
    expectTrue(ctx, !isGoalTerminalSupported(STR_PTR("Fixed login.\nGOAL_DONE"), STR_LEN("Fixed login.\nGOAL_DONE"), STR_PTR("fix login"), STR_LEN("fix login"), &empty), STR_PTR("terminal: no evidence"), STR_LEN("terminal: no evidence"));
}

// describe("shouldWrapUp")
fn test_shouldWrapUp(ctx: &TestCtx) {
    expectTrue(ctx, shouldWrapUp(STR_PTR(""), 0, -1, 2), STR_PTR("wrapUp: empty"), STR_LEN("wrapUp: empty"));
    expectTrue(ctx, shouldWrapUp(STR_PTR("  "), STR_LEN("  "), -1, -1), STR_PTR("wrapUp: blank"), STR_LEN("wrapUp: blank"));
    expectTrue(ctx, shouldWrapUp(STR_PTR("echo of request"), STR_LEN("echo of request"), 0, 3), STR_PTR("wrapUp: calls after text"), STR_LEN("wrapUp: calls after text"));
    expectTrue(ctx, !shouldWrapUp(STR_PTR("summary"), STR_LEN("summary"), 3, 2), STR_PTR("wrapUp: text after calls"), STR_LEN("wrapUp: text after calls"));
    expectTrue(ctx, !shouldWrapUp(STR_PTR("summary"), STR_LEN("summary"), 1, -1), STR_PTR("wrapUp: text only"), STR_LEN("wrapUp: text only"));
}

// describe("isEchoOfPrompt (pure-echo guard)")
fn test_isEchoOfPrompt(ctx: &TestCtx) {
    expectTrue(ctx, isEchoOfPrompt(STR_PTR("fix the login redirect"), STR_LEN("fix the login redirect"), STR_PTR("fix the login redirect"), STR_LEN("fix the login redirect")), STR_PTR("echo: exact"), STR_LEN("echo: exact"));
    expectTrue(ctx, isEchoOfPrompt(STR_PTR("/goal fix the login redirect"), STR_LEN("/goal fix the login redirect"), STR_PTR("fix the login redirect"), STR_LEN("fix the login redirect")), STR_PTR("echo: prefix stripped"), STR_LEN("echo: prefix stripped"));
    expectTrue(ctx, isEchoOfPrompt(STR_PTR("fix the login redirect and verify with tests"), STR_LEN("fix the login redirect and verify with tests"), STR_PTR("Sure, I will fix the login redirect and verify with tests"), STR_LEN("Sure, I will fix the login redirect and verify with tests")), STR_PTR("echo: wrapped"), STR_LEN("echo: wrapped"));
    expectTrue(ctx, !isEchoOfPrompt(STR_PTR("fix the login redirect"), STR_LEN("fix the login redirect"), STR_PTR("Fixed redirect in src/auth.ts:42 (added returnUrl passthrough). Verified with bun test (12 pass)."), STR_LEN("Fixed redirect in src/auth.ts:42 (added returnUrl passthrough). Verified with bun test (12 pass).")), STR_PTR("echo: real summary"), STR_LEN("echo: real summary"));
    expectTrue(ctx, isEchoOfPrompt(STR_PTR("fix it"), STR_LEN("fix it"), STR_PTR("fix it"), STR_LEN("fix it")), STR_PTR("echo: short exact"), STR_LEN("echo: short exact"));
    expectTrue(ctx, !isEchoOfPrompt(STR_PTR("fix it now please"), STR_LEN("fix it now please"), STR_PTR("ok"), STR_LEN("ok")), STR_PTR("echo: short output"), STR_LEN("echo: short output"));
    expectTrue(ctx, !isEchoOfPrompt(STR_PTR(""), 0, STR_PTR("something"), STR_LEN("something")), STR_PTR("echo: empty prompt"), STR_LEN("echo: empty prompt"));
    expectTrue(ctx, !isEchoOfPrompt(STR_PTR("something"), STR_LEN("something"), STR_PTR(""), 0), STR_PTR("echo: empty output"), STR_LEN("echo: empty output"));
}

// describe("digestToolOutputs (grounded fallback)")
fn test_digestToolOutputs(ctx: &TestCtx) {
    // test("lists calls with outputs, newest last")
    let thread = ThreadVec { items: [ThreadItem { kind: 0, text: [0u8; 8192], text_len: 0, call_id: [0u8; 128], call_id_len: 0, name: [0u8; 256], name_len: 0, args: [0u8; 8192], args_len: 0, output: [0u8; 8192], output_len: 0, images_json: [0u8; 8192], images_json_len: 0, has_images: false, plan: [ThreadPlanStep { step: [0u8; 512], step_len: 0, status: [0u8; 32], status_len: 0 }; 20], plan_len: 0 }; 512], len: 0 };
    threadPush(&thread, &makeTextItem(THREAD_ITEM_USER, STR_PTR("do x"), STR_LEN("do x")));
    threadPush(&thread, &makeCallItem(STR_PTR("c1"), STR_LEN("c1"), STR_PTR("sa_vm"), STR_LEN("sa_vm"), STR_PTR("{}"), STR_LEN("{}")));
    threadPush(&thread, &makeOutputItem(STR_PTR("c1"), STR_LEN("c1"), STR_PTR("line1\nline2"), STR_LEN("line1\nline2")));
    threadPush(&thread, &makeCallItem(STR_PTR("c2"), STR_LEN("c2"), STR_PTR("mcp__fs__read"), STR_LEN("mcp__fs__read"), STR_PTR("{}"), STR_LEN("{}")));
    threadPush(&thread, &makeOutputItem(STR_PTR("c2"), STR_LEN("c2"), STR_PTR("content here"), STR_LEN("content here")));
    let d = LoopStr { bytes: [0u8; 32768], len: 0 };
    digestToolOutputs(&thread, &d);
    let dp: ptr = PTR_NULL();
    PTR_BYTE_ADD(dp, &d.bytes, 0);
    expectContains(ctx, dp, d.len, STR_PTR("sa_vm"), STR_LEN("sa_vm"), STR_PTR("digest: sa_vm"), STR_LEN("digest: sa_vm"));
    expectContains(ctx, dp, d.len, STR_PTR("mcp__fs__read"), STR_LEN("mcp__fs__read"), STR_PTR("digest: mcp"), STR_LEN("digest: mcp"));
    expectContains(ctx, dp, d.len, STR_PTR("content here"), STR_LEN("content here"), STR_PTR("digest: content"), STR_LEN("digest: content"));
    let i1 = indexOfSub(dp, d.len, STR_PTR("sa_vm"), STR_LEN("sa_vm"));
    let i2 = indexOfSub(dp, d.len, STR_PTR("mcp__fs__read"), STR_LEN("mcp__fs__read"));
    expectTrue(ctx, i1 >= 0 && i2 >= 0 && i1 < i2, STR_PTR("digest: order"), STR_LEN("digest: order"));
    // test("no outputs -> empty")
    let t2 = ThreadVec { items: [ThreadItem { kind: 0, text: [0u8; 8192], text_len: 0, call_id: [0u8; 128], call_id_len: 0, name: [0u8; 256], name_len: 0, args: [0u8; 8192], args_len: 0, output: [0u8; 8192], output_len: 0, images_json: [0u8; 8192], images_json_len: 0, has_images: false, plan: [ThreadPlanStep { step: [0u8; 512], step_len: 0, status: [0u8; 32], status_len: 0 }; 20], plan_len: 0 }; 512], len: 0 };
    threadPush(&t2, &makeTextItem(THREAD_ITEM_USER, STR_PTR("hi"), STR_LEN("hi")));
    digestToolOutputs(&t2, &d);
    expectTrue(ctx, d.len == 0, STR_PTR("digest: empty"), STR_LEN("digest: empty"));
    // test("unknown call id falls back to 'tool'")
    let t3 = ThreadVec { items: [ThreadItem { kind: 0, text: [0u8; 8192], text_len: 0, call_id: [0u8; 128], call_id_len: 0, name: [0u8; 256], name_len: 0, args: [0u8; 8192], args_len: 0, output: [0u8; 8192], output_len: 0, images_json: [0u8; 8192], images_json_len: 0, has_images: false, plan: [ThreadPlanStep { step: [0u8; 512], step_len: 0, status: [0u8; 32], status_len: 0 }; 20], plan_len: 0 }; 512], len: 0 };
    threadPush(&t3, &makeOutputItem(STR_PTR("zz"), STR_LEN("zz"), STR_PTR("o"), STR_LEN("o")));
    digestToolOutputs(&t3, &d);
    dp = PTR_NULL();
    PTR_BYTE_ADD(dp, &d.bytes, 0);
    expectContains(ctx, dp, d.len, STR_PTR("tool"), STR_LEN("tool"), STR_PTR("digest: fallback tool"), STR_LEN("digest: fallback tool"));
}

// --- helpers for part 2 ---

fn emptyThreadVec() -> ThreadVec {
    return ThreadVec { items: [ThreadItem { kind: 0, text: [0u8; 8192], text_len: 0, call_id: [0u8; 128], call_id_len: 0, name: [0u8; 256], name_len: 0, args: [0u8; 8192], args_len: 0, output: [0u8; 8192], output_len: 0, images_json: [0u8; 8192], images_json_len: 0, has_images: false, plan: [ThreadPlanStep { step: [0u8; 512], step_len: 0, status: [0u8; 32], status_len: 0 }; 20], plan_len: 0 }; 512], len: 0 };
}

// Build "<prefix><i>" text (TS template `${prefix}${i}`) into a fresh user item.
// DEFECT: template literal | index rendered decimal byte-wise.
fn makeIndexedUser(prefix_ptr: ptr, prefix_len: u64, idx: u64) -> ThreadItem {
    let buf = LoopStr { bytes: [0u8; 32768], len: 0 };
    loopStrPush(&buf, prefix_ptr, prefix_len);
    let digits: [u8; 20] = [0u8; 20];
    let n: u64 = 0;
    let x = idx;
    if x == 0 { loopStrPush(&buf, STR_PTR("0"), STR_LEN("0")); };
    while x > 0 {
        digits[n] = 48 + (x % 10) as u8;
        n = n + 1;
        x = x / 10;
    }
    while n > 0 {
        n = n - 1;
        let one: [u8; 1] = [digits[n]];
        let dp: ptr = PTR_NULL();
        PTR_BYTE_ADD(dp, &one, 0);
        loopStrPush(&buf, dp, 1);
    }
    let bp: ptr = PTR_NULL();
    PTR_BYTE_ADD(bp, &buf.bytes, 0);
    return makeTextItem(THREAD_ITEM_USER, bp, buf.len);
}

// DEFECT: Node API | process.env.MINI_THREAD_KEEP / MINI_GOAL_MAX_TURNS reads+writes approximated via sa_std env externs (sa_std_env_set / sa_std_env_unset); TS `delete process.env.X` becomes unset.
// @import "sa_std/env.sai"

// describe("loadThreadAuto (anti-amnesia)")
fn test_loadThreadAuto(ctx: &TestCtx) {
    // test("explicit initial wins")
    let init = emptyThreadVec();
    threadPush(&init, &makeTextItem(THREAD_ITEM_USER, STR_PTR("hi"), STR_LEN("hi")));
    let got = emptyThreadVec();
    loadThreadAuto(STR_PTR("/nonexistent/x.jsonl"), STR_LEN("/nonexistent/x.jsonl"), &init, true, &got);
    expectTrue(ctx, got.len == 1, STR_PTR("loadThreadAuto: init len"), STR_LEN("loadThreadAuto: init len"));
    if got.len == 1 { expectItemEq(ctx, &got.items[0], &init.items[0], STR_PTR("loadThreadAuto: init wins"), STR_LEN("loadThreadAuto: init wins")); };
    // test("missing file -> []")
    // DEFECT: Date/timer | `nope-${Date.now()}.jsonl` approximated by a fixed filename.
    let missing = LoopStr { bytes: [0u8; 32768], len: 0 };
    tmpPath(STR_PTR("nope-fixed.jsonl"), STR_LEN("nope-fixed.jsonl"), &missing);
    let mp: ptr = PTR_NULL();
    PTR_BYTE_ADD(mp, &missing.bytes, 0);
    let empty = emptyThreadVec();
    loadThreadAuto(mp, missing.len, &empty, false, &got);
    expectTrue(ctx, got.len == 0, STR_PTR("loadThreadAuto: missing []"), STR_LEN("loadThreadAuto: missing []"));
    // test("loads persisted history")
    let dir = LoopStr { bytes: [0u8; 32768], len: 0 };
    tmpPath(STR_PTR("mini-loop-fixed1"), STR_LEN("mini-loop-fixed1"), &dir);
    let dp2: ptr = PTR_NULL();
    PTR_BYTE_ADD(dp2, &dir.bytes, 0);
    sa_std_fs_mkdir(dp2, dir.len);
    let f = LoopStr { bytes: [0u8; 32768], len: 0 };
    loopStrPush(&f, dp2, dir.len);
    loopStrPush(&f, STR_PTR("/t.jsonl"), STR_LEN("/t.jsonl"));
    let fp: ptr = PTR_NULL();
    PTR_BYTE_ADD(fp, &f.bytes, 0);
    let seed = emptyThreadVec();
    threadPush(&seed, &makeTextItem(THREAD_ITEM_USER, STR_PTR("earlier"), STR_LEN("earlier")));
    threadPush(&seed, &makeTextItem(THREAD_ITEM_MESSAGE, STR_PTR("done"), STR_LEN("done")));
    writeThreadFile(fp, f.len, &seed);
    loadThreadAuto(fp, f.len, &empty, false, &got);
    expectTrue(ctx, got.len == 2, STR_PTR("loadThreadAuto: persisted len"), STR_LEN("loadThreadAuto: persisted len"));
    if got.len == 2 { expectItemEq(ctx, &got.items[0], &seed.items[0], STR_PTR("loadThreadAuto: persisted [0]"), STR_LEN("loadThreadAuto: persisted [0]")); };
    // test("caps growth via MINI_THREAD_KEEP")
    let seed50 = emptyThreadVec();
    let i: u64 = 0;
    while i < 50 {
        // Array.from({length:50}, (_, i) => ({type:"user", text:`m${i}`}))
        // DEFECT: closure | Array.from mapper approximated by this explicit loop.
        threadPush(&seed50, &makeIndexedUser(STR_PTR("m"), STR_LEN("m"), i));
        i = i + 1;
    }
    writeThreadFile(fp, f.len, &seed50);
    sa_std_env_set(STR_PTR("MINI_THREAD_KEEP"), STR_LEN("MINI_THREAD_KEEP"), STR_PTR("30"), STR_LEN("30"));
    // TS wraps in try/finally to delete the env var; sequential calls here.
    // DEFECT: exception handling | try/finally has no counterpart; env restore is sequential.
    loadThreadAuto(fp, f.len, &empty, false, &got);
    sa_std_env_unset(STR_PTR("MINI_THREAD_KEEP"), STR_LEN("MINI_THREAD_KEEP"));
    expectTrue(ctx, got.len == 30, STR_PTR("loadThreadAuto: keep 30"), STR_LEN("loadThreadAuto: keep 30"));
    if got.len == 30 {
        let want = makeIndexedUser(STR_PTR("m"), STR_LEN("m"), 20);
        expectItemEq(ctx, &got.items[0], &want, STR_PTR("loadThreadAuto: keep first m20"), STR_LEN("loadThreadAuto: keep first m20"));
    };
}

// describe("reasoning not re-sent to model")
fn test_reasoningNotResent(ctx: &TestCtx) {
    let thread = emptyThreadVec();
    threadPush(&thread, &makeTextItem(THREAD_ITEM_USER, STR_PTR("do x"), STR_LEN("do x")));
    threadPush(&thread, &makeTextItem(THREAD_ITEM_REASONING, STR_PTR("thinking..."), STR_LEN("thinking...")));
    threadPush(&thread, &makeTextItem(THREAD_ITEM_MESSAGE, STR_PTR("ok"), STR_LEN("ok")));
    // test("responses input skips reasoning")
    let input = LoopStr { bytes: [0u8; 32768], len: 0 };
    let input_len = toResponsesInput(&thread, &input);
    expectTrue(ctx, input_len == 2, STR_PTR("responses input: len 2"), STR_LEN("responses input: len 2"));
    let ip: ptr = PTR_NULL();
    PTR_BYTE_ADD(ip, &input.bytes, 0);
    // expect(JSON.stringify(input)).not.toContain("thinking")
    expectNotContains(ctx, ip, input.len, STR_PTR("thinking"), STR_LEN("thinking"), STR_PTR("responses input: no thinking"), STR_LEN("responses input: no thinking"));
    // test("chat messages skip reasoning")
    let msgs = LoopStr { bytes: [0u8; 32768], len: 0 };
    let msgs_len = toChatMessages(&thread, STR_PTR("sys"), STR_LEN("sys"), &msgs);
    expectTrue(ctx, msgs_len == 3, STR_PTR("chat messages: len 3"), STR_LEN("chat messages: len 3")); // system + user + assistant
    let cp: ptr = PTR_NULL();
    PTR_BYTE_ADD(cp, &msgs.bytes, 0);
    expectNotContains(ctx, cp, msgs.len, STR_PTR("thinking"), STR_LEN("thinking"), STR_PTR("chat messages: no thinking"), STR_LEN("chat messages: no thinking"));
}

// describe("proactive base prompt (anti-passive)")
fn test_proactiveBasePrompt(ctx: &TestCtx) {
    let s = LoopStr { bytes: [0u8; 32768], len: 0 };
    // test("no 'then stop'; demands plan/act/verify/report")
    buildBaseSystem(STR_PTR(""), 0, 0, STR_PTR(""), 0, false, &s);
    let sp: ptr = PTR_NULL();
    PTR_BYTE_ADD(sp, &s.bytes, 0);
    expectNotContains(ctx, sp, s.len, STR_PTR("then stop"), STR_LEN("then stop"), STR_PTR("proactive: no then stop"), STR_LEN("proactive: no then stop"));
    expectContains(ctx, sp, s.len, STR_PTR("Plan briefly"), STR_LEN("Plan briefly"), STR_PTR("proactive: Plan briefly"), STR_LEN("proactive: Plan briefly"));
    expectContains(ctx, sp, s.len, STR_PTR("Keep working until the request is done"), STR_LEN("Keep working until the request is done"), STR_PTR("proactive: Keep working"), STR_LEN("proactive: Keep working"));
    expectContains(ctx, sp, s.len, STR_PTR("verify"), STR_LEN("verify"), STR_PTR("proactive: verify"), STR_LEN("proactive: verify"));
    // test("agentsMd section appended only when present")
    buildBaseSystem(STR_PTR(""), 0, 0, STR_PTR(""), 0, false, &s);
    sp = PTR_NULL();
    PTR_BYTE_ADD(sp, &s.bytes, 0);
    expectNotContains(ctx, sp, s.len, STR_PTR("AGENTS.md"), STR_LEN("AGENTS.md"), STR_PTR("proactive: no AGENTS.md"), STR_LEN("proactive: no AGENTS.md"));
    buildBaseSystem(STR_PTR(""), 0, 0, STR_PTR("Always run tests."), STR_LEN("Always run tests."), true, &s);
    sp = PTR_NULL();
    PTR_BYTE_ADD(sp, &s.bytes, 0);
    expectContains(ctx, sp, s.len, STR_PTR("AGENTS.md"), STR_LEN("AGENTS.md"), STR_PTR("proactive: AGENTS.md present"), STR_LEN("proactive: AGENTS.md present"));
    expectContains(ctx, sp, s.len, STR_PTR("Always run tests."), STR_LEN("Always run tests."), STR_PTR("proactive: agents text"), STR_LEN("proactive: agents text"));
}

// describe("loadThreadAutoWithDropped (compact-on-overflow)")
fn test_loadThreadAutoWithDropped(ctx: &TestCtx) {
    let empty = emptyThreadVec();
    // test("explicit initial -> no dropped")
    let init = emptyThreadVec();
    threadPush(&init, &makeTextItem(THREAD_ITEM_USER, STR_PTR("hi"), STR_LEN("hi")));
    let thread = emptyThreadVec();
    let dropped = emptyThreadVec();
    loadThreadAutoWithDropped(STR_PTR("/nonexistent/x.jsonl"), STR_LEN("/nonexistent/x.jsonl"), &init, true, &thread, &dropped);
    // expect(...).toEqual({ thread: init, dropped: [] })
    expectTrue(ctx, thread.len == 1 && dropped.len == 0, STR_PTR("withDropped: explicit"), STR_LEN("withDropped: explicit"));
    if thread.len == 1 { expectItemEq(ctx, &thread.items[0], &init.items[0], STR_PTR("withDropped: explicit item"), STR_LEN("withDropped: explicit item")); };
    // test("oversized explicit initial (--resume) splits tail + dropped like the default path")
    let init50 = emptyThreadVec();
    let i: u64 = 0;
    while i < 50 {
        threadPush(&init50, &makeIndexedUser(STR_PTR("r"), STR_LEN("r"), i));
        i = i + 1;
    }
    sa_std_env_set(STR_PTR("MINI_THREAD_KEEP"), STR_LEN("MINI_THREAD_KEEP"), STR_PTR("30"), STR_LEN("30"));
    loadThreadAutoWithDropped(STR_PTR("/nonexistent/x.jsonl"), STR_LEN("/nonexistent/x.jsonl"), &init50, true, &thread, &dropped);
    sa_std_env_unset(STR_PTR("MINI_THREAD_KEEP"), STR_LEN("MINI_THREAD_KEEP"));
    expectTrue(ctx, thread.len == 30, STR_PTR("withDropped: resume thread 30"), STR_LEN("withDropped: resume thread 30"));
    expectTrue(ctx, dropped.len == 20, STR_PTR("withDropped: resume dropped 20"), STR_LEN("withDropped: resume dropped 20"));
    if thread.len == 30 {
        let want = makeIndexedUser(STR_PTR("r"), STR_LEN("r"), 20);
        expectItemEq(ctx, &thread.items[0], &want, STR_PTR("withDropped: resume first r20"), STR_LEN("withDropped: resume first r20"));
    };
    if dropped.len == 20 {
        let want0 = makeIndexedUser(STR_PTR("r"), STR_LEN("r"), 0);
        expectItemEq(ctx, &dropped.items[0], &want0, STR_PTR("withDropped: resume dropped r0"), STR_LEN("withDropped: resume dropped r0"));
    };
    // fixture dir/file for the next two tests
    let dir = LoopStr { bytes: [0u8; 32768], len: 0 };
    tmpPath(STR_PTR("mini-loop-fixed2"), STR_LEN("mini-loop-fixed2"), &dir);
    let dp2: ptr = PTR_NULL();
    PTR_BYTE_ADD(dp2, &dir.bytes, 0);
    sa_std_fs_mkdir(dp2, dir.len);
    let f = LoopStr { bytes: [0u8; 32768], len: 0 };
    loopStrPush(&f, dp2, dir.len);
    loopStrPush(&f, STR_PTR("/t.jsonl"), STR_LEN("/t.jsonl"));
    let fp: ptr = PTR_NULL();
    PTR_BYTE_ADD(fp, &f.bytes, 0);
    // test("under keep -> no dropped")
    let one = emptyThreadVec();
    threadPush(&one, &makeTextItem(THREAD_ITEM_USER, STR_PTR("a"), STR_LEN("a")));
    writeThreadFile(fp, f.len, &one);
    loadThreadAutoWithDropped(fp, f.len, &empty, false, &thread, &dropped);
    expectTrue(ctx, thread.len == 1 && dropped.len == 0, STR_PTR("withDropped: under keep"), STR_LEN("withDropped: under keep"));
    if thread.len == 1 { expectItemEq(ctx, &thread.items[0], &one.items[0], STR_PTR("withDropped: under keep item"), STR_LEN("withDropped: under keep item")); };
    // test("overflow splits kept tail + dropped prefix")
    let items50 = emptyThreadVec();
    i = 0;
    while i < 50 {
        threadPush(&items50, &makeIndexedUser(STR_PTR("m"), STR_LEN("m"), i));
        i = i + 1;
    }
    writeThreadFile(fp, f.len, &items50);
    sa_std_env_set(STR_PTR("MINI_THREAD_KEEP"), STR_LEN("MINI_THREAD_KEEP"), STR_PTR("30"), STR_LEN("30"));
    loadThreadAutoWithDropped(fp, f.len, &empty, false, &thread, &dropped);
    sa_std_env_unset(STR_PTR("MINI_THREAD_KEEP"), STR_LEN("MINI_THREAD_KEEP"));
    expectTrue(ctx, thread.len == 30, STR_PTR("withDropped: overflow thread 30"), STR_LEN("withDropped: overflow thread 30"));
    expectTrue(ctx, dropped.len == 20, STR_PTR("withDropped: overflow dropped 20"), STR_LEN("withDropped: overflow dropped 20"));
    if thread.len == 30 {
        let want = makeIndexedUser(STR_PTR("m"), STR_LEN("m"), 20);
        expectItemEq(ctx, &thread.items[0], &want, STR_PTR("withDropped: overflow first m20"), STR_LEN("withDropped: overflow first m20"));
    };
    if dropped.len == 20 {
        let want0 = makeIndexedUser(STR_PTR("m"), STR_LEN("m"), 0);
        expectItemEq(ctx, &dropped.items[0], &want0, STR_PTR("withDropped: overflow dropped m0"), STR_LEN("withDropped: overflow dropped m0"));
    };
    // test("buildMemoryItem marks the compacted prefix")
    let item = emptyItem();
    buildMemoryItem(STR_PTR("did X"), STR_LEN("did X"), 20, &item);
    expectTrue(ctx, item.kind == THREAD_ITEM_USER, STR_PTR("buildMemoryItem: type user"), STR_LEN("buildMemoryItem: type user"));
    let itp: ptr = PTR_NULL();
    PTR_BYTE_ADD(itp, &item.text, 0);
    expectContains(ctx, itp, item.text_len, STR_PTR("[memory]"), STR_LEN("[memory]"), STR_PTR("buildMemoryItem: [memory]"), STR_LEN("buildMemoryItem: [memory]"));
    expectContains(ctx, itp, item.text_len, STR_PTR("20 items"), STR_LEN("20 items"), STR_PTR("buildMemoryItem: 20 items"), STR_LEN("buildMemoryItem: 20 items"));
    expectContains(ctx, itp, item.text_len, STR_PTR("did X"), STR_LEN("did X"), STR_PTR("buildMemoryItem: did X"), STR_LEN("buildMemoryItem: did X"));
    // test("withCompactedMemory falls back to evidence digest when the summarizer fails")
    // DEFECT: async | await withCompactedMemory approximated synchronously.
    let dirp = LoopStr { bytes: [0u8; 32768], len: 0 };
    tmpPath(STR_PTR(""), 0, &dirp);
    let dpp: ptr = PTR_NULL();
    PTR_BYTE_ADD(dpp, &dirp.bytes, 0);
    let cfg = cfgOf(dpp, 5); // cwd: tmpdir() -> "/tmp"
    let thread1 = emptyThreadVec();
    threadPush(&thread1, &makeTextItem(THREAD_ITEM_USER, STR_PTR("recent"), STR_LEN("recent")));
    let dropped1 = emptyThreadVec();
    threadPush(&dropped1, &makeCallItem(STR_PTR("c1"), STR_LEN("c1"), STR_PTR("sa_vm"), STR_LEN("sa_vm"), STR_PTR("{}"), STR_LEN("{}")));
    threadPush(&dropped1, &makeOutputItem(STR_PTR("c1"), STR_LEN("c1"), STR_PTR("did the thing"), STR_LEN("did the thing")));
    let got = emptyThreadVec();
    withCompactedMemory(&cfg, &thread1, &dropped1, &got);
    expectTrue(ctx, got.len == 2, STR_PTR("withCompactedMemory: len 2"), STR_LEN("withCompactedMemory: len 2"));
    if got.len == 2 {
        expectTrue(ctx, got.items[0].kind == THREAD_ITEM_USER, STR_PTR("withCompactedMemory: [0] user"), STR_LEN("withCompactedMemory: [0] user"));
        let g0: ptr = PTR_NULL();
        PTR_BYTE_ADD(g0, &got.items[0].text, 0);
        expectContains(ctx, g0, got.items[0].text_len, STR_PTR("[memory]"), STR_LEN("[memory]"), STR_PTR("withCompactedMemory: [memory]"), STR_LEN("withCompactedMemory: [memory]"));
        expectContains(ctx, g0, got.items[0].text_len, STR_PTR("did the thing"), STR_LEN("did the thing"), STR_PTR("withCompactedMemory: evidence"), STR_LEN("withCompactedMemory: evidence"));
        expectItemEq(ctx, &got.items[1], &thread1.items[0], STR_PTR("withCompactedMemory: [1] recent"), STR_LEN("withCompactedMemory: [1] recent"));
    };
    // test("withCompactedMemory is identity when nothing dropped")
    let no_dropped = emptyThreadVec();
    withCompactedMemory(&cfg, &thread1, &no_dropped, &got);
    // expect(...).toBe(thread) — reference identity.
    // DEFECT: assertion | toBe reference identity has no counterpart over value structs; approximated by length + item equality.
    expectTrue(ctx, got.len == thread1.len, STR_PTR("withCompactedMemory: identity len"), STR_LEN("withCompactedMemory: identity len"));
    if got.len == thread1.len && got.len > 0 { expectItemEq(ctx, &got.items[0], &thread1.items[0], STR_PTR("withCompactedMemory: identity item"), STR_LEN("withCompactedMemory: identity item")); };
    // test("boundPrefixForSummary caps large prefixes with head + digest + tail")
    let items200 = emptyThreadVec();
    i = 0;
    while i < 200 {
        threadPush(&items200, &makeIndexedUser(STR_PTR("m"), STR_LEN("m"), i));
        i = i + 1;
    }
    let bounded = emptyThreadVec();
    boundPrefixForSummary(&items200, 80, &bounded);
    expectTrue(ctx, bounded.len == 80, STR_PTR("boundPrefix: len 80"), STR_LEN("boundPrefix: len 80"));
    if bounded.len == 80 {
        let w0 = makeIndexedUser(STR_PTR("m"), STR_LEN("m"), 0);
        expectItemEq(ctx, &bounded.items[0], &w0, STR_PTR("boundPrefix: head m0"), STR_LEN("boundPrefix: head m0"));
        let w199 = makeIndexedUser(STR_PTR("m"), STR_LEN("m"), 199);
        expectItemEq(ctx, &bounded.items[79], &w199, STR_PTR("boundPrefix: tail m199"), STR_LEN("boundPrefix: tail m199"));
        let b20: ptr = PTR_NULL();
        PTR_BYTE_ADD(b20, &bounded.items[20].text, 0);
        expectTrue(ctx, bounded.items[20].kind == THREAD_ITEM_USER, STR_PTR("boundPrefix: [20] user"), STR_LEN("boundPrefix: [20] user"));
        expectContains(ctx, b20, bounded.items[20].text_len, STR_PTR("omitted 121 middle items"), STR_LEN("omitted 121 middle items"), STR_PTR("boundPrefix: omitted note"), STR_LEN("boundPrefix: omitted note"));
    };
    let first80 = emptyThreadVec();
    i = 0;
    while i < 80 {
        threadPush(&first80, &items200.items[i]);
        i = i + 1;
    }
    boundPrefixForSummary(&first80, 80, &bounded);
    // expect(...).toHaveLength(80)
    expectTrue(ctx, bounded.len == 80, STR_PTR("boundPrefix: exact 80"), STR_LEN("boundPrefix: exact 80"));
}

// describe("ensureThreadBudget (mid-turn anti-amnesia)")
fn test_ensureThreadBudget(ctx: &TestCtx) {
    // test("identity when inside budget")
    let thread = emptyThreadVec();
    threadPush(&thread, &makeTextItem(THREAD_ITEM_USER, STR_PTR("hi"), STR_LEN("hi")));
    let got = emptyThreadVec();
    ensureThreadBudget(&thread, 120000, &got);
    // expect(...).toBe(thread) — identity approximated by content equality (see DEFECT above).
    expectTrue(ctx, got.len == thread.len, STR_PTR("budget: identity len"), STR_LEN("budget: identity len"));
    if got.len == 1 { expectItemEq(ctx, &got.items[0], &thread.items[0], STR_PTR("budget: identity item"), STR_LEN("budget: identity item")); };
    // test("squeezes the middle into a [memory] digest, keeps markers + newest")
    let items = emptyThreadVec();
    threadPush(&items, &makeTextItem(THREAD_ITEM_USER, STR_PTR("[memory] old summary"), STR_LEN("[memory] old summary")));
    let i: u64 = 0;
    while i < 60 {
        // `mid message number ${i} with some padding text to consume chars`
        // DEFECT: template literal | per-item text assembled with the indexed helper makeIndexedMid.
        let assembled = makeIndexedMid(i);
        threadPush(&items, &assembled);
        i = i + 1;
    }
    threadPush(&items, &makeCallItem(STR_PTR("c1"), STR_LEN("c1"), STR_PTR("sa_vm"), STR_LEN("sa_vm"), STR_PTR("{}"), STR_LEN("{}")));
    threadPush(&items, &makeOutputItem(STR_PTR("c1"), STR_LEN("c1"), STR_PTR("fresh evidence here"), STR_LEN("fresh evidence here")));
    ensureThreadBudget(&items, 2000, &got);
    expectTrue(ctx, got.len < items.len, STR_PTR("budget: squeezed shorter"), STR_LEN("budget: squeezed shorter"));
    expectTrue(ctx, estimateThreadChars(&got) < estimateThreadChars(&items), STR_PTR("budget: squeezed chars"), STR_LEN("budget: squeezed chars"));
    if got.len > 0 {
        expectItemEq(ctx, &got.items[0], &items.items[0], STR_PTR("budget: keeps [memory] head"), STR_LEN("budget: keeps [memory] head"));
        let last_want = makeOutputItem(STR_PTR("c1"), STR_LEN("c1"), STR_PTR("fresh evidence here"), STR_LEN("fresh evidence here"));
        expectItemEq(ctx, &got.items[got.len - 1], &last_want, STR_PTR("budget: keeps newest"), STR_LEN("budget: keeps newest"));
    };
    // const mid = got.find((t) => t.type === "user" && t.text.includes("squeezed out of context budget"));
    // DEFECT: closure | Array.find with predicate approximated by an explicit scan.
    let found_mid = false;
    let j: u64 = 0;
    while j < got.len {
        if got.items[j].kind == THREAD_ITEM_USER {
            let gp: ptr = PTR_NULL();
            PTR_BYTE_ADD(gp, &got.items[j].text, 0);
            if bufContains(gp, got.items[j].text_len, STR_PTR("squeezed out of context budget"), STR_LEN("squeezed out of context budget")) { found_mid = true; };
        };
        j = j + 1;
    }
    expectTrue(ctx, found_mid, STR_PTR("budget: squeeze marker"), STR_LEN("budget: squeeze marker"));
    // test("keeps at least the newest 8 items even under a tiny budget")
    let items30 = emptyThreadVec();
    i = 0;
    while i < 30 {
        threadPush(&items30, &makeIndexedPadding(i));
        i = i + 1;
    }
    ensureThreadBudget(&items30, 20000, &got);
    expectTrue(ctx, got.len >= 8, STR_PTR("budget: at least 8"), STR_LEN("budget: at least 8"));
    if got.len > 0 { expectItemEq(ctx, &got.items[got.len - 1], &items30.items[29], STR_PTR("budget: newest kept"), STR_LEN("budget: newest kept")); };
    // test("repairs cut call/output pairs so fresh evidence survives sanitize")
    let items2 = emptyThreadVec();
    threadPush(&items2, &makeTextItem(THREAD_ITEM_USER, STR_PTR("old filler"), STR_LEN("old filler")));
    i = 1;
    while i <= 5 {
        let cid = makeIndexedUser(STR_PTR("c"), STR_LEN("c"), i);
        let ctp: ptr = PTR_NULL();
        PTR_BYTE_ADD(ctp, &cid.text, 0);
        threadPush(&items2, &makeCallItem(ctp, cid.text_len, STR_PTR("sa_vm"), STR_LEN("sa_vm"), STR_PTR("{}"), STR_LEN("{}")));
        i = i + 1;
    }
    i = 1;
    while i <= 5 {
        let cid = makeIndexedUser(STR_PTR("c"), STR_LEN("c"), i);
        let ctp: ptr = PTR_NULL();
        PTR_BYTE_ADD(ctp, &cid.text, 0);
        let out_text = makeIndexedFresh(i);
        let otp: ptr = PTR_NULL();
        PTR_BYTE_ADD(otp, &out_text.text, 0);
        threadPush(&items2, &makeOutputItem(ctp, cid.text_len, otp, out_text.text_len));
        i = i + 1;
    }
    threadPush(&items2, &makeTextItem(THREAD_ITEM_USER, STR_PTR("newer exchange one"), STR_LEN("newer exchange one")));
    threadPush(&items2, &makeTextItem(THREAD_ITEM_USER, STR_PTR("newer exchange two"), STR_LEN("newer exchange two")));
    ensureThreadBudget(&items2, 200, &got);
    // const calls = new Set(got.filter(...).map(...)); every fresh-evidence output must have its call.
    // DEFECT: Set/closure | Set membership approximated by a linear scan over got's call items.
    j = 0;
    while j < got.len {
        if got.items[j].kind == THREAD_ITEM_FUNCTION_CALL_OUTPUT {
            let gp: ptr = PTR_NULL();
            PTR_BYTE_ADD(gp, &got.items[j].output, 0);
            if bufContains(gp, got.items[j].output_len, STR_PTR("fresh evidence"), STR_LEN("fresh evidence")) {
                let has_call = false;
                let k: u64 = 0;
                while k < got.len {
                    if got.items[k].kind == THREAD_ITEM_FUNCTION_CALL {
                        let ap: ptr = PTR_NULL();
                        PTR_BYTE_ADD(ap, &got.items[k].call_id, 0);
                        let bp2: ptr = PTR_NULL();
                        PTR_BYTE_ADD(bp2, &got.items[j].call_id, 0);
                        if bufEq(ap, got.items[k].call_id_len, bp2, got.items[j].call_id_len) { has_call = true; };
                    };
                    k = k + 1;
                }
                expectTrue(ctx, has_call, STR_PTR("budget: pair repaired"), STR_LEN("budget: pair repaired"));
            };
        };
        j = j + 1;
    }
    // Restored calls slot just before their outputs: idx("c1") >= 0 and idx("c1") < outIdx("c1").
    let call_idx = findCallIndex(&got, STR_PTR("c1"), STR_LEN("c1"));
    let out_idx = findOutputIndex(&got, STR_PTR("c1"), STR_LEN("c1"));
    expectTrue(ctx, call_idx >= 0, STR_PTR("budget: c1 call present"), STR_LEN("budget: c1 call present"));
    expectTrue(ctx, call_idx < out_idx, STR_PTR("budget: c1 before output"), STR_LEN("budget: c1 before output"));
    // test("image payload chars count toward the budget")
    // const bigImage = "data:image/png;base64," + "A".repeat(5000);
    // DEFECT: string methods | "A".repeat(5000) approximated by a fill loop; the image string is held in a LoopStr.
    let big = LoopStr { bytes: [0u8; 32768], len: 0 };
    loopStrPush(&big, STR_PTR("data:image/png;base64,"), STR_LEN("data:image/png;base64,"));
    i = 0;
    while i < 5000 {
        loopStrPush(&big, STR_PTR("A"), STR_LEN("A"));
        i = i + 1;
    }
    let fillers = emptyThreadVec();
    i = 0;
    while i < 12 {
        threadPush(&fillers, &makeIndexedFiller(i));
        i = i + 1;
    }
    let plain = emptyThreadVec();
    i = 0;
    while i < fillers.len {
        threadPush(&plain, &fillers.items[i]);
        i = i + 1;
    }
    threadPush(&plain, &makeCallItem(STR_PTR("v1"), STR_LEN("v1"), STR_PTR("image_view"), STR_LEN("image_view"), STR_PTR("{}"), STR_LEN("{}")));
    threadPush(&plain, &makeOutputItem(STR_PTR("v1"), STR_LEN("v1"), STR_PTR("saw a login form"), STR_LEN("saw a login form")));
    threadPush(&plain, &makeTextItem(THREAD_ITEM_USER, STR_PTR("recent follow-up"), STR_LEN("recent follow-up")));
    // const withImage = plain.map((t) => t.type === "function_call_output" ? { ...t, images: [bigImage] } : t);
    // DEFECT: closure/spread | Array.map + object spread approximated by an explicit copy loop setting images on the output item.
    // DEFECT: dynamic array | images: string[] stored raw in images_json (see types.sla); char accounting uses the raw image bytes.
    let with_image = emptyThreadVec();
    i = 0;
    while i < plain.len {
        let it = plain.items[i];
        if it.kind == THREAD_ITEM_FUNCTION_CALL_OUTPUT {
            let bp3: ptr = PTR_NULL();
            PTR_BYTE_ADD(bp3, &big.bytes, 0);
            let dp3: ptr = PTR_NULL();
            PTR_BYTE_ADD(dp3, &it.images_json, 0);
            it.images_json_len = setField(dp3, 8192, bp3, big.len);
            it.has_images = true;
        };
        threadPush(&with_image, &it);
        i = i + 1;
    }
    expectTrue(ctx, estimateThreadChars(&with_image) - estimateThreadChars(&plain) == big.len, STR_PTR("budget: image chars counted"), STR_LEN("budget: image chars counted"));
    // 450 chars fits the text-only thread but not the image-carrying one.
    ensureThreadBudget(&plain, 450, &got);
    // expect(ensureThreadBudget(plain, 450)).toBe(plain) — identity approximated by content equality.
    expectTrue(ctx, got.len == plain.len, STR_PTR("budget: plain fits 450"), STR_LEN("budget: plain fits 450"));
    ensureThreadBudget(&with_image, 450, &got);
    let squeezed = false;
    j = 0;
    while j < got.len {
        if got.items[j].kind == THREAD_ITEM_USER {
            let gp: ptr = PTR_NULL();
            PTR_BYTE_ADD(gp, &got.items[j].text, 0);
            if bufContains(gp, got.items[j].text_len, STR_PTR("squeezed out of context budget"), STR_LEN("squeezed out of context budget")) { squeezed = true; };
        };
        j = j + 1;
    }
    expectTrue(ctx, squeezed, STR_PTR("budget: image thread squeezed"), STR_LEN("budget: image thread squeezed"));
}

// `mid message number ${i} with some padding text to consume chars`
fn makeIndexedMid(idx: u64) -> ThreadItem {
    let pre = makeIndexedUser(STR_PTR("mid message number "), STR_LEN("mid message number "), idx);
    let buf = LoopStr { bytes: [0u8; 32768], len: 0 };
    let pp: ptr = PTR_NULL();
    PTR_BYTE_ADD(pp, &pre.text, 0);
    loopStrPush(&buf, pp, pre.text_len);
    loopStrPush(&buf, STR_PTR(" with some padding text to consume chars"), STR_LEN(" with some padding text to consume chars"));
    let bp: ptr = PTR_NULL();
    PTR_BYTE_ADD(bp, &buf.bytes, 0);
    return makeTextItem(THREAD_ITEM_USER, bp, buf.len);
}

// `item ${i} padding padding padding`
fn makeIndexedPadding(idx: u64) -> ThreadItem {
    let pre = makeIndexedUser(STR_PTR("item "), STR_LEN("item "), idx);
    let buf = LoopStr { bytes: [0u8; 32768], len: 0 };
    let pp: ptr = PTR_NULL();
    PTR_BYTE_ADD(pp, &pre.text, 0);
    loopStrPush(&buf, pp, pre.text_len);
    loopStrPush(&buf, STR_PTR(" padding padding padding"), STR_LEN(" padding padding padding"));
    let bp: ptr = PTR_NULL();
    PTR_BYTE_ADD(bp, &buf.bytes, 0);
    return makeTextItem(THREAD_ITEM_USER, bp, buf.len);
}

// `filler note number ${i}`
fn makeIndexedFiller(idx: u64) -> ThreadItem {
    return makeIndexedUser(STR_PTR("filler note number "), STR_LEN("filler note number "), idx);
}

// `fresh evidence number ${i} with padding` (as a text-carrying item for output text bytes)
fn makeIndexedFresh(idx: u64) -> ThreadItem {
    let pre = makeIndexedUser(STR_PTR("fresh evidence number "), STR_LEN("fresh evidence number "), idx);
    let buf = LoopStr { bytes: [0u8; 32768], len: 0 };
    let pp: ptr = PTR_NULL();
    PTR_BYTE_ADD(pp, &pre.text, 0);
    loopStrPush(&buf, pp, pre.text_len);
    loopStrPush(&buf, STR_PTR(" with padding"), STR_LEN(" with padding"));
    let bp: ptr = PTR_NULL();
    PTR_BYTE_ADD(bp, &buf.bytes, 0);
    return makeTextItem(THREAD_ITEM_USER, bp, buf.len);
}

fn findCallIndex(tv: &ThreadVec, id_ptr: ptr, id_len: u64) -> i64 {
    let i: u64 = 0;
    while i < tv.len {
        if tv.items[i].kind == THREAD_ITEM_FUNCTION_CALL {
            let ap: ptr = PTR_NULL();
            PTR_BYTE_ADD(ap, &tv.items[i].call_id, 0);
            if bufEq(ap, tv.items[i].call_id_len, id_ptr, id_len) { return i as i64; };
        };
        i = i + 1;
    }
    return -1;
}

fn findOutputIndex(tv: &ThreadVec, id_ptr: ptr, id_len: u64) -> i64 {
    let i: u64 = 0;
    while i < tv.len {
        if tv.items[i].kind == THREAD_ITEM_FUNCTION_CALL_OUTPUT {
            let ap: ptr = PTR_NULL();
            PTR_BYTE_ADD(ap, &tv.items[i].call_id, 0);
            if bufEq(ap, tv.items[i].call_id_len, id_ptr, id_len) { return i as i64; };
        };
        i = i + 1;
    }
    return -1;
}

// describe("needsActionNudge (anti-passive)")
fn test_needsActionNudge(ctx: &TestCtx) {
    // test("fires for action-like prompts with zero tool calls")
    expectTrue(ctx, needsActionNudge(STR_PTR("修复登录跳转 bug"), STR_LEN("修复登录跳转 bug"), -1), STR_PTR("nudge: zh fix"), STR_LEN("nudge: zh fix"));
    expectTrue(ctx, needsActionNudge(STR_PTR("implement the login redirect"), STR_LEN("implement the login redirect"), -1), STR_PTR("nudge: implement"), STR_LEN("nudge: implement"));
    expectTrue(ctx, needsActionNudge(STR_PTR("看看 src/loop.ts 里的问题"), STR_LEN("看看 src/loop.ts 里的问题"), -1), STR_PTR("nudge: zh look"), STR_LEN("nudge: zh look"));
    // test("silent when tools were used, for greetings, or slash commands")
    expectTrue(ctx, !needsActionNudge(STR_PTR("修复登录跳转 bug"), STR_LEN("修复登录跳转 bug"), 2), STR_PTR("nudge: tools used"), STR_LEN("nudge: tools used"));
    expectTrue(ctx, !needsActionNudge(STR_PTR("你好"), STR_LEN("你好"), -1), STR_PTR("nudge: greeting"), STR_LEN("nudge: greeting"));
    expectTrue(ctx, !needsActionNudge(STR_PTR("/status"), STR_LEN("/status"), -1), STR_PTR("nudge: /status"), STR_LEN("nudge: /status"));
    expectTrue(ctx, !needsActionNudge(STR_PTR("/goal fix it"), STR_LEN("/goal fix it"), -1), STR_PTR("nudge: /goal"), STR_LEN("nudge: /goal"));
    expectTrue(ctx, !needsActionNudge(STR_PTR(""), 0, -1), STR_PTR("nudge: empty"), STR_LEN("nudge: empty"));
    // test("buildActionNudge demands tool action with evidence")
    let item = emptyItem();
    buildActionNudge(STR_PTR("修复登录跳转"), STR_LEN("修复登录跳转"), &item);
    expectTrue(ctx, item.kind == THREAD_ITEM_USER, STR_PTR("buildActionNudge: type user"), STR_LEN("buildActionNudge: type user"));
    let ip: ptr = PTR_NULL();
    PTR_BYTE_ADD(ip, &item.text, 0);
    expectContains(ctx, ip, item.text_len, STR_PTR("without using any tools"), STR_LEN("without using any tools"), STR_PTR("buildActionNudge: text 1"), STR_LEN("buildActionNudge: text 1"));
    expectContains(ctx, ip, item.text_len, STR_PTR("sa_vm"), STR_LEN("sa_vm"), STR_PTR("buildActionNudge: sa_vm"), STR_LEN("buildActionNudge: sa_vm"));
}

// describe("runPrompt integration (stubbed fetch, no network)")
// DEFECT: async | all three tests are async in TS; approximated synchronously.
// DEFECT: fetch mock | globalThis.fetch replacement + Response/JSON.stringify stubs have no counterpart; runPrompt is called with a fetch_mode selecting the transcribed stub (1 = compaction+passive, 2 = goal tool-shy, 3 = spawn) and captures request bodies into FetchBodies.
// DEFECT: closure | the exec callback `async () => "tool out"` is approximated by exec_mode 0 (stub returning "tool out").
// DEFECT: exception handling | try/finally restoring fetch/env approximated by sequential restores.
fn test_runPromptIntegration(ctx: &TestCtx) {
    // test("overflow compacts to [memory] AND a passive answer triggers the action nudge")
    let dir = LoopStr { bytes: [0u8; 32768], len: 0 };
    tmpPath(STR_PTR("mini-e2e-fixed"), STR_LEN("mini-e2e-fixed"), &dir);
    let dp2: ptr = PTR_NULL();
    PTR_BYTE_ADD(dp2, &dir.bytes, 0);
    sa_std_fs_mkdir(dp2, dir.len);
    let save_file = LoopStr { bytes: [0u8; 32768], len: 0 };
    loopStrPush(&save_file, dp2, dir.len);
    loopStrPush(&save_file, STR_PTR("/thread.jsonl"), STR_LEN("/thread.jsonl"));
    let sfp: ptr = PTR_NULL();
    PTR_BYTE_ADD(sfp, &save_file.bytes, 0);
    let seed = emptyThreadVec();
    let i: u64 = 0;
    while i < 25 {
        threadPush(&seed, &makeIndexedUser(STR_PTR("earlier note "), STR_LEN("earlier note "), i));
        i = i + 1;
    }
    writeThreadFile(sfp, save_file.len, &seed);
    sa_std_env_set(STR_PTR("MINI_THREAD_KEEP"), STR_LEN("MINI_THREAD_KEEP"), STR_PTR("10"), STR_LEN("10"));
    let bodies = FetchBodies { json: [0u8; 32768], json_len: 0, count: 0 };
    let cfg = cfgOf(dp2, dir.len);
    let out = LoopStr { bytes: [0u8; 32768], len: 0 };
    runPrompt(&cfg, STR_PTR("修复登录bug问题"), STR_LEN("修复登录bug问题"), 0, sfp, save_file.len, 1, &bodies, &out);
    sa_std_env_unset(STR_PTR("MINI_THREAD_KEEP"), STR_LEN("MINI_THREAD_KEEP"));
    // 1 x compaction summary + 2 x agent turns (initial + nudge), no wrap-up.
    expectTrue(ctx, bodies.count == 3, STR_PTR("runPrompt e2e: 3 calls"), STR_LEN("runPrompt e2e: 3 calls"));
    // The nudge turn's input carries the action-nudge instruction.
    let bjp: ptr = PTR_NULL();
    PTR_BYTE_ADD(bjp, &bodies.json, 0);
    expectContains(ctx, bjp, bodies.json_len, STR_PTR("without using any tools"), STR_LEN("without using any tools"), STR_PTR("runPrompt e2e: nudge on wire"), STR_LEN("runPrompt e2e: nudge on wire"));
    // The persisted transcript leads with the [memory] compaction item.
    let saved = LoopStr { bytes: [0u8; 32768], len: 0 };
    sa_std_fs_read(sfp, save_file.len, &saved.bytes, 32768, &saved.len);
    let svp: ptr = PTR_NULL();
    PTR_BYTE_ADD(svp, &saved.bytes, 0);
    // First line only (TS: split("\n").filter(Boolean).map(JSON.parse)[0]).
    let line_end: u64 = 0;
    while line_end < saved.len {
        let c: u8 = 0;
        PTR_BYTE_AT(c, svp, line_end);
        if c == 10 { break; };
        line_end = line_end + 1;
    }
    expectContains(ctx, svp, line_end, STR_PTR("\"user\""), STR_LEN("\"user\""), STR_PTR("runPrompt e2e: saved[0] user"), STR_LEN("runPrompt e2e: saved[0] user"));
    expectContains(ctx, svp, line_end, STR_PTR("[memory]"), STR_LEN("[memory]"), STR_PTR("runPrompt e2e: saved[0] memory"), STR_LEN("runPrompt e2e: saved[0] memory"));
    expectContains(ctx, svp, line_end, STR_PTR("prior summary here"), STR_LEN("prior summary here"), STR_PTR("runPrompt e2e: saved summary"), STR_LEN("runPrompt e2e: saved summary"));
    let op: ptr = PTR_NULL();
    PTR_BYTE_ADD(op, &out.bytes, 0);
    expectTrue(ctx, bufEq(op, out.len, STR_PTR("已经看完了"), STR_LEN("已经看完了")), STR_PTR("runPrompt e2e: final text"), STR_LEN("runPrompt e2e: final text"));
    // test("/goal with a tool-shy model names the zero-tool problem on re-nudge")
    let dir2 = LoopStr { bytes: [0u8; 32768], len: 0 };
    tmpPath(STR_PTR("mini-goal-fixed"), STR_LEN("mini-goal-fixed"), &dir2);
    let d2p: ptr = PTR_NULL();
    PTR_BYTE_ADD(d2p, &dir2.bytes, 0);
    sa_std_fs_mkdir(d2p, dir2.len);
    let save2 = LoopStr { bytes: [0u8; 32768], len: 0 };
    loopStrPush(&save2, d2p, dir2.len);
    loopStrPush(&save2, STR_PTR("/thread.jsonl"), STR_LEN("/thread.jsonl"));
    let s2p: ptr = PTR_NULL();
    PTR_BYTE_ADD(s2p, &save2.bytes, 0);
    sa_std_env_set(STR_PTR("MINI_GOAL_MAX_TURNS"), STR_LEN("MINI_GOAL_MAX_TURNS"), STR_PTR("8"), STR_LEN("8"));
    let bodies2 = FetchBodies { json: [0u8; 32768], json_len: 0, count: 0 };
    let cfg2 = cfgOf(d2p, dir2.len);
    runPrompt(&cfg2, STR_PTR("/goal 修登录问题"), STR_LEN("/goal 修登录问题"), 0, s2p, save2.len, 2, &bodies2, &out);
    sa_std_env_unset(STR_PTR("MINI_GOAL_MAX_TURNS"), STR_LEN("MINI_GOAL_MAX_TURNS"));
    // Budget floor is 8: one text-only turn per segment, then exhaustion.
    expectTrue(ctx, bodies2.count == 8, STR_PTR("runPrompt goal: 8 bodies"), STR_LEN("runPrompt goal: 8 bodies"));
    let b2p: ptr = PTR_NULL();
    PTR_BYTE_ADD(b2p, &bodies2.json, 0);
    expectContains(ctx, b2p, bodies2.json_len, STR_PTR("have not used any tools yet"), STR_LEN("have not used any tools yet"), STR_PTR("runPrompt goal: re-nudge text"), STR_LEN("runPrompt goal: re-nudge text"));
    op = PTR_NULL();
    PTR_BYTE_ADD(op, &out.bytes, 0);
    expectContains(ctx, op, out.len, STR_PTR("turn budget exhausted"), STR_LEN("turn budget exhausted"), STR_PTR("runPrompt goal: exhausted"), STR_LEN("runPrompt goal: exhausted"));
    // test("a text-only sub-agent gets one action nudge before its report is accepted")
    let dir3 = LoopStr { bytes: [0u8; 32768], len: 0 };
    tmpPath(STR_PTR("mini-child-fixed"), STR_LEN("mini-child-fixed"), &dir3);
    let d3p: ptr = PTR_NULL();
    PTR_BYTE_ADD(d3p, &dir3.bytes, 0);
    sa_std_fs_mkdir(d3p, dir3.len);
    let save3 = LoopStr { bytes: [0u8; 32768], len: 0 };
    loopStrPush(&save3, d3p, dir3.len);
    loopStrPush(&save3, STR_PTR("/thread.jsonl"), STR_LEN("/thread.jsonl"));
    let s3p: ptr = PTR_NULL();
    PTR_BYTE_ADD(s3p, &save3.bytes, 0);
    let bodies3 = FetchBodies { json: [0u8; 32768], json_len: 0, count: 0 };
    let cfg3 = cfgOf(d3p, dir3.len);
    runPrompt(&cfg3, STR_PTR("查一下登录跳转的实现路径"), STR_LEN("查一下登录跳转的实现路径"), 0, s3p, save3.len, 3, &bodies3, &out);
    op = PTR_NULL();
    PTR_BYTE_ADD(op, &out.bytes, 0);
    expectTrue(ctx, bufEq(op, out.len, STR_PTR("已分派子代理"), STR_LEN("已分派子代理")), STR_PTR("runPrompt child: final text"), STR_LEN("runPrompt child: final text"));
    // The child runs in the background: TS polls bodies with setTimeout until the child's 2nd turn appears (5s deadline).
    // DEFECT: Date/timer | setTimeout polling loop + Date.now deadline approximated away: the synchronous conversion has already recorded the child turns when runPrompt returns.
    let b3p: ptr = PTR_NULL();
    PTR_BYTE_ADD(b3p, &bodies3.json, 0);
    // Count child bodies (inputs containing the task-brief marker) and check the 2nd carries the nudge.
    let marker = STR_PTR("Task brief from the parent agent");
    let marker_len = STR_LEN("Task brief from the parent agent");
    let first = indexOfSub(b3p, bodies3.json_len, marker, marker_len);
    expectTrue(ctx, first >= 0, STR_PTR("runPrompt child: first child turn"), STR_LEN("runPrompt child: first child turn"));
    let second: i64 = -1;
    if first >= 0 {
        second = indexOfSub(b3p + (first as u64) + marker_len, bodies3.json_len - (first as u64) - marker_len, marker, marker_len);
    };
    expectTrue(ctx, second >= 0, STR_PTR("runPrompt child: second child turn"), STR_LEN("runPrompt child: second child turn"));
    if second >= 0 {
        let rest_start = (first as u64) + marker_len + (second as u64);
        expectContains(ctx, b3p + rest_start, bodies3.json_len - rest_start, STR_PTR("without using any tools"), STR_LEN("without using any tools"), STR_PTR("runPrompt child: child nudged"), STR_LEN("runPrompt child: child nudged"));
    };
}

fn main() -> i32 {
    let ctx = TestCtx { checks: 0, fails: 0 };
    test_outputContract(&ctx);
    test_parseGoalArgs(&ctx);
    test_goalMarkers(&ctx);
    test_hasGoalToolEvidence(&ctx);
    test_isGoalTerminalSupported(&ctx);
    test_shouldWrapUp(&ctx);
    test_isEchoOfPrompt(&ctx);
    test_digestToolOutputs(&ctx);
    test_loadThreadAuto(&ctx);
    test_reasoningNotResent(&ctx);
    test_proactiveBasePrompt(&ctx);
    test_loadThreadAutoWithDropped(&ctx);
    test_ensureThreadBudget(&ctx);
    test_needsActionNudge(&ctx);
    test_runPromptIntegration(&ctx);
    if ctx.fails > 0 {
        println("loop.test: FAIL");
        return 1;
    };
    println("loop.test: PASS");
    return 0;
}
