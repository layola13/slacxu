// DEFECT: test framework (bun:test describe/test/expect) | SLA has no test framework in this pass; the single describe() is a section comment and each test(name, fn) is a same-named fn returning i32 (0 = all expectations held), expect() approximated by the expect_* helpers below (same convention as fourpiece.test.sla). Tests are not executed by any runner in this pass.
// DEFECT: Node imports (node:fs mkdtempSync/readFileSync, node:os tmpdir, node:path join) | approximated via sa_std fs externs + manual path joins; temp dir names carry a fixed suffix instead of mkdtempSync's random one.

// ---- expect_* approximations (see fourpiece.test.sla) ----
// DEFECT: expect matchers (toBe, toContain, toBeNull via ?? null, toBeGreaterThan, toBeLessThanOrEqual) | helpers record pass/fail into a per-test failure counter.
struct TestCtx {
    failures: u64,
}
fn expect_true(ctx: &TestCtx, cond: bool) -> void {
    if !cond { ctx.failures = ctx.failures + 1; };
}
fn expect_eq_u64(ctx: &TestCtx, actual: u64, expected: u64) -> void {
    if actual != expected { ctx.failures = ctx.failures + 1; };
}
fn expect_contains(ctx: &TestCtx, hay_ptr: ptr, hay_len: u64, needle_ptr: ptr, needle_len: u64) -> void {
    if hay_len < needle_len { ctx.failures = ctx.failures + 1; };
}

// Captured stub-fetch request bodies (TS: const bodies: Array<Record<string, any>> = []).
// DEFECT: dynamic object array | bodies kept as JSON text buffers + count.
struct BodiesArray {
    bytes: [u8; 262144], len: u64, count: u64,
}

// DEFECT: stubbed global fetch (globalThis.fetch = async (_url, init) => {...}; finally { globalThis.fetch = realFetch }) | no globalThis/assignable fetch/Response constructor/try-finally in SLA; approximated per-test by a local stub function with the same canned-response sequence, a calls counter, and bodies captured into a BodiesArray (see fourpiece.test.sla).
// DEFECT: async test functions with await runPrompt / await import(...) | test fns are synchronous; awaited calls use the synchronous .sla forms, dynamic imports become direct .sla imports (plan.sla is imported at the top of this file).

