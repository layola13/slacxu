// Converted 1:1 from mini-codex/test/hooks.test.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
// Verification for mini-codex MCP hook events (Codex parity).
// Run: bun test test/hooks.test.ts
// DEFECT: test framework | bun:test describe/test/expect has no SLA counterpart; approximated: each test() becomes a fn, expect(...) becomes expect* helper calls, main() runs all tests and returns the failure count.
// PHASE-1 ADAPTATION (Agent M): the bulk pass wrote this test against an imagined JSON-text hooks API (own HookCtx/HookResult struct approximations). It is rebound here to the real hooks.sla / mcpHooks.sla surface: matcherMatches takes has_matcher first; selectHookHandlers runs over a HookEvents built by hooks' parseHookFile; mcpHookToolInput goes through mcpHooks' mh_tool_input text adapter; renderMcpHookInput through a HookTemplateCtx adapter; parseHookOutput over hooks' ParsedHookOutput; executeHooks through mcpHooks' mh_execute adapter (statuses read back from hook_events_json, codes 1=completed 2=failed 3=blocked per hooks' finishRun); runToolWithHooks / loadHookEvents through the real stateful entry points.
// DEFECT: callbacks | the sink event recorder and the callMcpRaw timeout recorder are host callbacks: hooks.sla routes sink events to a documented no-op dispatch and callMcpRaw to an explicit-error dispatch in this port, so the sink-sequence and timeout-recorder assertions are dropped (not faked); the mcp_tool case keeps only its not-blocked assertion. Registered in _defects/FIX_MINI_CODEX.md.
// DEFECT: Node API | process.cwd() approximated by the literal "/tmp"; platform branch approximated as non-win32 (IS_WIN32 = false).
@import "sa_std/io/print.sai"
@import "sa_std/ptr.sa"
@import "sa_std/string.sa"
@import "sa_std/encoding/json.sai"
@import "../src/hooks.sla"
@import "../src/mcpHooks.sla"

struct TestCtx {
    checks: u64,
    fails: u64,
}

// Growable text buffer (JSON text stands in for TS objects).
struct HookStr {
    bytes: [u8; 8192], len: u64,
}

const IS_WIN32: bool = false;

fn expectTrue(ctx: &TestCtx, cond: bool, label_ptr: ptr, label_len: u64) {
    ctx.checks = ctx.checks + 1;
    if !cond {
        ctx.fails = ctx.fails + 1;
        sa_print_bytes(STR_PTR("FAIL: "), STR_LEN("FAIL: "));
        sa_print_bytes(label_ptr, label_len);
        sa_print_bytes(STR_PTR("\n"), STR_LEN("\n"));
    };
}

fn strEqBuf(a_ptr: ptr, a_len: u64, b_ptr: ptr, b_len: u64) -> bool {
    if a_len != b_len { return false; };
    let i: u64 = 0;
    while i < a_len {
        let x: u8 = 0;
        let y: u8 = 0;
        PTR_BYTE_AT(x, a_ptr, i);
        PTR_BYTE_AT(y, b_ptr, i);
        if x != y { return false; };
        i = i + 1;
    }
    return true;
}

fn expectEqJson(ctx: &TestCtx, got_ptr: ptr, got_len: u64, want_ptr: ptr, want_len: u64, label_ptr: ptr, label_len: u64) {
    // DEFECT: assertion | expect(...).toEqual(object) deep equality approximated by canonical JSON text comparison (key order sensitive).
    expectTrue(ctx, strEqBuf(got_ptr, got_len, want_ptr, want_len), label_ptr, label_len);
}

fn expectContains(ctx: &TestCtx, hay_ptr: ptr, hay_len: u64, nd_ptr: ptr, nd_len: u64, label_ptr: ptr, label_len: u64) {
    let found = false;
    if hay_len >= nd_len {
        let last = hay_len - nd_len;
        let i: u64 = 0;
        while i <= last && !found {
            let ok = true;
            let j: u64 = 0;
            while j < nd_len {
                let x: u8 = 0;
                let y: u8 = 0;
                PTR_BYTE_AT(x, hay_ptr, i + j);
                PTR_BYTE_AT(y, nd_ptr, j);
                if x != y { ok = false; };
                j = j + 1;
            }
            if ok { found = true; };
            i = i + 1;
        }
    };
    expectTrue(ctx, found, label_ptr, label_len);
}

fn putText(dst: ptr, src_ptr: ptr, src_len: u64, len_out: &u64) {
    let i: u64 = 0;
    while i < src_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, src_ptr, i);
        let dp: ptr = PTR_NULL();
        PTR_BYTE_ADD(dp, dst, i);
        PTR_WRITE_U8(dp, b);
        i = i + 1;
    }
    *len_out = src_len;
}

