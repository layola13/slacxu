 session_id_len: 0, next_id: 0 }; 16], http_conns_len: 0, has_cached_tools: false, cached_tools: [McpToolEntry { name: [0u8; 128], name_len: 0, description: [0u8; 512], description_len: 0, schema_json: [0u8; 4096], schema_json_len: 0, server: [0u8; 128], server_len: 0, raw_name: [0u8; 128], raw_name_len: 0 }; 64], cached_tools_len: 0, cached_at: 0 };
}

// ctxBase (TS lines 117-124) as an mcpHooks HookCtx value: sessionId "s1",
// turnId "t1", cwd "/tmp" (process.cwd() stand-in), model "test",
// toolName "mcp__fs__read", toolUseId "call-1", toolInput { path: "/tmp/x" }.
fn makeCtxBase(out: &HookCtx) {
    let c = HookCtx { session_id: [0u8; 128], session_id_len: 0, turn_id: [0u8; 64], turn_id_len: 0, cwd: [0u8; 512], cwd_len: 0, model: [0u8; 128], model_len: 0, tool_name: [0u8; 128], tool_name_len: 0, tool_use_id: [0u8; 128], tool_use_id_len: 0, tool_input_json: [0u8; 8192], tool_input_json_len: 0, has_tool_response: false, tool_response_json: [0u8; 16384], tool_response_json_len: 0, sink: 0, use_call_mcp_raw: false };
    let p: ptr = PTR_NULL();
    PTR_BYTE_ADD(p, &c.session_id, 0);
    putText(p, STR_PTR("s1"), STR_LEN("s1"), &c.session_id_len);
    p = PTR_NULL();
    PTR_BYTE_ADD(p, &c.turn_id, 0);
    putText(p, STR_PTR("t1"), STR_LEN("t1"), &c.turn_id_len);
    p = PTR_NULL();
    PTR_BYTE_ADD(p, &c.cwd, 0);
    putText(p, STR_PTR("/tmp"), STR_LEN("/tmp"), &c.cwd_len);
    p = PTR_NULL();
    PTR_BYTE_ADD(p, &c.model, 0);
    putText(p, STR_PTR("test"), STR_LEN("test"), &c.model_len);
    p = PTR_NULL();
    PTR_BYTE_ADD(p, &c.tool_name, 0);
    putText(p, STR_PTR("mcp__fs__read"), STR_LEN("mcp__fs__read"), &c.tool_name_len);
    p = PTR_NULL();
    PTR_BYTE_ADD(p, &c.tool_use_id, 0);
    putText(p, STR_PTR("call-1"), STR_LEN("call-1"), &c.tool_use_id_len);
    p = PTR_NULL();
    PTR_BYTE_ADD(p, &c.tool_input_json, 0);
    putText(p, STR_PTR("{\"path\":\"/tmp/x\"}"), STR_LEN("{\"path\":\"/tmp/x\"}"), &c.tool_input_json_len);
    *out = c;
}

fn testFiles() -> [HookFileRef; 8] {
    return [HookFileRef { path_ptr: STR_PTR("test.json"), path_len: 9, source: 0 }; 8];
}

fn eventsFromText(text_ptr: ptr, text_len: u64, out: &HookEvents) {
    parseHookFile(text_ptr, text_len, STR_PTR("test.json"), STR_LEN("test.json"), out);
}

// Count hook runs in an McpHookExecResult by counting "\"status\":" keys in
// its hook_events_json (one per emitted run).
fn runsOf(r: &McpHookExecResult) -> u64 {
    let base: ptr = PTR_NULL();
    PTR_BYTE_ADD(base, &r.hook_events_json, 0);
    let n: u64 = 0;
    if r.hook_events_json_len >= 9 {
        let last = r.hook_events_json_len - 9;
        let i: u64 = 0;
        while i <= last {
            let c0: u8 = 0; let c1: u8 = 0; let c2: u8 = 0; let c3: u8 = 0; let c4: u8 = 0; let c5: u8 = 0; let c6: u8 = 0; let c7: u8 = 0; let c8: u8 = 0;
            PTR_BYTE_AT(c0, base, i);
            PTR_BYTE_AT(c1, base, i + 1);
            PTR_BYTE_AT(c2, base, i + 2);
            PTR_BYTE_AT(c3, base, i + 3);
            PTR_BYTE_AT(c4, base, i + 4);
            PTR_BYTE_AT(c5, base, i + 5);
            PTR_BYTE_AT(c6, base, i + 6);
            PTR_BYTE_AT(c7, base, i + 7);
            PTR_BYTE_AT(c8, base, i + 8);
            if c0 == 34 && c1 == 115 && c2 == 116 && c3 == 97 && c4 == 116 && c5 == 117 && c6 == 115 && c7 == 34 && c8 == 58 { n = n + 1; };
            i = i + 1;
        }
    };
    return n;
}

// Status code of the first hook run in hook_events_json (0 = no runs).
// hooks.sla finishRun codes: 1 = completed, 2 = failed, 3 = blocked.
fn firstStatusCode(r: &McpHookExecResult) -> u64 {
    let base: ptr = PTR_NULL();
    PTR_BYTE_ADD(base, &r.hook_events_json, 0);
    if r.hook_events_json_len >= 10 {
        let last = r.hook_events_json_len - 9;
        let i: u64 = 0;
        while i <= last {
            let c0: u8 = 0; let c1: u8 = 0; let c2: u8 = 0; let c3: u8 = 0; let c4: u8 = 0; let c5: u8 = 0; let c6: u8 = 0; let c7: u8 = 0; let c8: u8 = 0;
            PTR_BYTE_AT(c0, base, i);
            PTR_BYTE_AT(c1, base, i + 1);
            PTR_BYTE_AT(c2, base, i + 2);
            PTR_BYTE_AT(c3, base, i + 3);
            PTR_BYTE_AT(c4, base, i + 4);
            PTR_BYTE_AT(c5, base, i + 5);
            PTR_BYTE_AT(c6, base, i + 6);
            PTR_BYTE_AT(c7, base, i + 7);
            PTR_BYTE_AT(c8, base, i + 8);
            if c0 == 34 && c1 == 115 && c2 == 116 && c3 == 97 && c4 == 116 && c5 == 117 && c6 == 115 && c7 == 34 && c8 == 58 {
                let d: u8 = 0;
                PTR_BYTE_AT(d, base, i + 9);
                if d >= 48 && d <= 57 { return (d - 48) as u64; };
                return 0;
            };
            i = i + 1;
        }
    };
    return 0;
}

fn eventStatusEq(r: &McpHookExecResult, idx: u64, want_ptr: ptr, want_len: u64) -> bool {
    // Only the first run is exercised by these tests (idx is always 0).
    if idx != 0 { return false; };
    let code = firstStatusCode(r);
    if strEqBuf(want_ptr, want_len, STR_PTR("completed"), STR_LEN("completed")) { return code == 1; };
    if strEqBuf(want_ptr, want_len, STR_PTR("failed"), STR_LEN("failed")) { return code == 2; };
    if strEqBuf(want_ptr, want_len, STR_PTR("blocked"), STR_LEN("blocked")) { return code == 3; };
    return false;
}

// describe("matcher (Codex parity)")
fn test_matcher(ctx: &TestCtx) {
    // test("empty matcher matches all")
    // DEFECT: optional/undefined argument | matcherMatches(undefined, ...) approximated with a has_matcher flag (real signature: has_matcher first).
    expectTrue(ctx, matcherMatches(false, STR_PTR(""), 0, STR_PTR("mcp__fs__read"), STR_LEN("mcp__fs__read")), STR_PTR("empty matcher: undefined"), STR_LEN("empty matcher: undefined"));
    expectTrue(ctx, matcherMatches(true, STR_PTR(""), 0, STR_PTR("mcp__fs__read"), STR_LEN("mcp__fs__read")), STR_PTR("empty matcher: ''"), STR_LEN("empty matcher: ''"));
    // test("regex matcher")
    expectTrue(ctx, matcherMatches(true, STR_PTR("^mcp__"), STR_LEN("^mcp__"), STR_PTR("mcp__fs__read"), STR_LEN("mcp__fs__read")), STR_PTR("regex matcher: ^mcp__ hit"), STR_LEN("regex matcher: ^mcp__ hit"));
    expectTrue(ctx, !matcherMatches(true, STR_PTR("^mcp__"), STR_LEN("^mcp__"), STR_PTR("sa_vm"), STR_LEN("sa_vm")), STR_PTR("regex matcher: ^mcp__ miss"), STR_LEN("regex matcher: ^mcp__ miss"));
    expectTrue(ctx, matcherMatches(true, STR_PTR("Write|Edit"), STR_LEN("Write|Edit"), STR_PTR("Edit"), STR_LEN("Edit")), STR_PTR("regex matcher: Write|Edit"), STR_LEN("regex matcher: Write|Edit"));
    // test("invalid regex falls back to substring")
    expectTrue(ctx, matcherMatches(true, STR_PTR("(["), STR_LEN("(["), STR_PTR("tool ([x]"), STR_LEN("tool ([x]")), STR_PTR("invalid regex -> substring"), STR_LEN("invalid regex -> substring"));
    // test("selectHookHandlers keeps display order")
    // const ev: HookEvents = { PreToolUse: [ { matcher: "^mcp__", hooks: [...] }, { hooks: [...] } ] };
    // The events object is built with hooks' own parseHookFile (the shape it
    // tolerates is the in-memory HookEvents JSON).
    let ev = "{\"PreToolUse\":[{\"matcher\":\"^mcp__\",\"hooks\":[{\"type\":\"command\",\"command\":\"echo hi\"}]},{\"hooks\":[{\"type\":\"command\",\"command\":\"echo all\"}]}]}";
    let events = hook_events_new();
    eventsFromText(STR_PTR(ev), STR_LEN(ev), &events);
    let gi = [0u64; 64];
    let hi = [0u64; 64];
    let ix = [0u64; 64];
    let n = selectHookHandlers(&events, 0, STR_PTR("mcp__a__b"), STR_LEN("mcp__a__b"), &gi[0], &hi[0], &ix[0]);
    expectTrue(ctx, n == 2, STR_PTR("selectHookHandlers: len 2"), STR_LEN("selectHookHandlers: len 2"));
    if n == 2 {
        expectTrue(ctx, ix[0] == 0, STR_PTR("selectHookHandlers: [0].index"), STR_LEN("selectHookHandlers: [0].index"));
        expectTrue(ctx, ix[1] == 1, STR_PTR("selectHookHandlers: [1].index"), STR_LEN("selectHookHandlers: [1].index"));
    };
    let n2 = selectHookHandlers(&events, 0, STR_PTR("sa_vm"), STR_LEN("sa_vm"), &gi[0], &hi[0], &ix[0]);
    expectTrue(ctx, n2 == 1, STR_PTR("selectHookHandlers: sa_vm len 1"), STR_LEN("selectHookHandlers: sa_vm len 1"));
}

// describe("mcpHookToolInput (Codex parity)") — via mcpHooks' mh_tool_input
// text adapter (text -> JSON node -> hooks' mcpHookToolInput -> text).
fn test_mcpHookToolInput(ctx: &TestCtx) {
    let out = TextBuf { bytes: [0u8; 32768], len: 0 };
    let op: ptr = PTR_NULL();
    PTR_BYTE_ADD(op, &out.bytes, 0);
    // test("object passes through") — expect(mcpHookToolInput({ a: 1 })).toEqual({ a: 1 });
    mh_tool_input(STR_PTR("{\"a\":1}"), STR_LEN("{\"a\":1}"), &out);
    expectEqJson(ctx, op, out.len, STR_PTR("{\"a\":1}"), STR_LEN("{\"a\":1}"), STR_PTR("mcpHookToolInput: object"), STR_LEN("mcpHookToolInput: object"));
    // test("empty string -> {}")
    mh_tool_input(STR_PTR(""), 0, &out);
    expectEqJson(ctx, op, out.len, STR_PTR("{}"), STR_LEN("{}"), STR_PTR("mcpHookToolInput: empty"), STR_LEN("mcpHookToolInput: empty"));
    // test("JSON string parsed")
    mh_tool_input(STR_PTR("{\"x\":1}"), STR_LEN("{\"x\":1}"), &out);
    expectEqJson(ctx, op, out.len, STR_PTR("{\"x\":1}"), STR_LEN("{\"x\":1}"), STR_PTR("mcpHookToolInput: json string"), STR_LEN("mcpHookToolInput: json string"));
    // test("non-JSON string -> {_raw}")
    mh_tool_input(STR_PTR("hello"), STR_LEN("hello"), &out);
    expectEqJson(ctx, op, out.len, STR_PTR("{\"_raw\":\"hello\"}"), STR_LEN("{\"_raw\":\"hello\"}"), STR_PTR("mcpHookToolInput: _raw"), STR_LEN("mcpHookToolInput: _raw"));
}

// Text-mode adapter for hooks' renderMcpHookInput(input_node, &HookTemplateCtx, &ByteBuf).
fn renderText(input_ptr: ptr, input_len: u64, ctx_ptr: ptr, ctx_len: u64, out: &HookStr) {
    let b_name = TextBuf { bytes: [0u8; 32768], len: 0 };
    let b_use = TextBuf { bytes: [0u8; 32768], len: 0 };
    let b_cwd = TextBuf { bytes: [0u8; 32768], len: 0 };
    let b_ses = TextBuf { bytes: [0u8; 32768], len: 0 };
    let b_trn = TextBuf { bytes: [0u8; 32768], len: 0 };
    let b_srv = TextBuf { bytes: [0u8; 32768], len: 0 };
    let b_tol = TextBuf { bytes: [0u8; 32768], len: 0 };
    let q1: ptr = PTR_NULL();
    PTR_BYTE_ADD(q1, &b_name.bytes, 0);
    mj_get_string(ctx_ptr, ctx_len, STR_PTR("tool_name"), STR_LEN("tool_name"), q1, &b_name.len);
    let q2: ptr = PTR_NULL();
    PTR_BYTE_ADD(q2, &b_use.bytes, 0);
    mj_get_string(ctx_ptr, ctx_len, STR_PTR("tool_use_id"), STR_LEN("tool_use_id"), q2, &b_use.len);
    let q3: ptr = PTR_NULL();
    PTR_BYTE_ADD(q3, &b_cwd.bytes, 0);
    mj_get_string(ctx_ptr, ctx_len, STR_PTR("cwd"), STR_LEN("cwd"), q3, &b_cwd.len);
    let q4: ptr = PTR_NULL();
    PTR_BYTE_ADD(q4, &b_ses.bytes, 0);
    mj_get_string(ctx_ptr, ctx_len, STR_PTR("session_id"), STR_LEN("session_id"), q4, &b_ses.len);
    let q5: ptr = PTR_NULL();
    PTR_BYTE_ADD(q5, &b_trn.bytes, 0);
    mj_get_string(ctx_ptr, ctx_len, STR_PTR("turn_id"), STR_LEN("turn_id"), q5, &b_trn.len);
    let q6: ptr = PTR_NULL();
    PTR_BYTE_ADD(q6, &b_srv.bytes, 0);
    mj_get_string(ctx_ptr, ctx_len, STR_PTR("server"), STR_LEN("server"), q6, &b_srv.len);
    let q7: ptr = PTR_NULL();
    PTR_BYTE_ADD(q7, &b_tol.bytes, 0);
    mj_get_string(ctx_ptr, ctx_len, STR_PTR("tool"), STR_LEN("tool"), q7, &b_tol.len);
    let b_tin = TextBuf { bytes: [0u8; 32768], len: 0 };
    let q8: ptr = PTR_NULL();
    PTR_BYTE_ADD(q8, &b_tin.bytes, 0);
    mj_get_json(ctx_ptr, ctx_len, STR_PTR("tool_input"), STR_LEN("tool_input"), q8, &b_tin.len);
    let tin = sa_json_parse(q8, b_tin.len);
    if tin == 0 { tin = sa_json_parse(STR_PTR("{}"), STR_LEN("{}")); };
    let inode = sa_json_parse(input_ptr, input_len);
    let p1: ptr = PTR_NULL();
    PTR_BYTE_ADD(p1, &b_name.bytes, 0);
    let p2: ptr = PTR_NULL();
    PTR_BYTE_ADD(p2, &b_use.bytes, 0);
    let p3: ptr = PTR_NULL();
    PTR_BYTE_ADD(p3, &b_cwd.bytes, 0);
    let p4: ptr = PTR_NULL();
    PTR_BYTE_ADD(p4, &b_ses.bytes, 0);
    let p5: ptr = PTR_NULL();
    PTR_BYTE_ADD(p5, &b_trn.bytes, 0);
    let p6: ptr = PTR_NULL();
    PTR_BYTE_ADD(p6, &b_srv.bytes, 0);
    let p7: ptr = PTR_NULL();
    PTR_BYTE_ADD(p7, &b_tol.bytes, 0);
    let tctx = HookTemplateCtx { tool_name_ptr: p1, tool_name_len: b_name.len, tool_use_id_ptr: p2, tool_use_id_len: b_use.len, cwd_ptr: p3, cwd_len: b_cwd.len, session_id_ptr: p4, session_id_len: b_ses.len, turn_id_ptr: p5, turn_id_len: b_trn.len, server_ptr: p6, server_len: b_srv.len, tool_ptr: p7, tool_len: b_tol.len, tool_input_node: tin };
    let scratch = ByteBuf { bytes: [0u8; 262144], len: 0 };
    let res_node = renderMcpHookInput(inode, &tctx, &scratch);
    out.len = 0;
    let dp: ptr = PTR_NULL();
    PTR_BYTE_ADD(dp, &out.bytes, 0);
    mj_node_text(res_node, 8192, dp, &out.len);
}

// describe("renderMcpHookInput templating")
fn test_renderMcpHookInput(ctx: &TestCtx) {
    // test("expands ${tool_input.*} (Codex test shape)")
    let input = "{\"file_path\":\"${tool_input.file_path}\",\"include_ignored\":false}";
    let c = "{\"tool_name\":\"mcp__security__scan\",\"tool_use_id\":\"u1\",\"cwd\":\"/w\",\"session_id\":\"s\",\"turn_id\":\"t\",\"server\":\"security\",\"tool\":\"scan\",\"tool_input\":{\"file_path\":\"/a/b.txt\"}}";
    let out = HookStr { bytes: [0u8; 8192], len: 0 };
    renderText(STR_PTR(input), STR_LEN(input), STR_PTR(c), STR_LEN(c), &out);
    let op: ptr = PTR_NULL();
    PTR_BYTE_ADD(op, &out.bytes, 0);
    expectEqJson(ctx, op, out.len, STR_PTR("{\"file_path\":\"/a/b.txt\",\"include_ignored\":false}"), STR_LEN("{\"file_path\":\"/a/b.txt\",\"include_ignored\":false}"), STR_PTR("renderMcpHookInput: expands"), STR_LEN("renderMcpHookInput: expands"));
    // test("missing path -> empty string")
    let input2 = "{\"p\":\"${tool_input.missing}\"}";
    let c2 = "{\"tool_name\":\"n\",\"tool_use_id\":\"u\",\"cwd\":\"/w\",\"session_id\":\"s\",\"turn_id\":\"t\",\"server\":\"sv\",\"tool\":\"tl\",\"tool_input\":{}}";
    renderText(STR_PTR(input2), STR_LEN(input2), STR_PTR(c2), STR_LEN(c2), &out);
    op = PTR_NULL();
    PTR_BYTE_ADD(op, &out.bytes, 0);
    expectEqJson(ctx, op, out.len, STR_PTR("{\"p\":\"\"}"), STR_LEN("{\"p\":\"\"}"), STR_PTR("renderMcpHookInput: missing"), STR_LEN("renderMcpHookInput: missing"));
}

// describe("parseHookOutput") — over hooks' ParsedHookOutput (event index 0 = PreToolUse).
fn test_parseHookOutput(ctx: &TestCtx) {
    let p = emptyParsed();
    // test("empty -> approve")
    parseHookOutput(STR_PTR(""), 0, false, 0, &p);
    expectTrue(ctx, !p.blocked, STR_PTR("parseHookOutput: empty approve"), STR_LEN("parseHookOutput: empty approve"));
    // test("decision block") — TS builds the input with JSON.stringify({...}); the equivalent literal is used.
    parseHookOutput(STR_PTR("{\"decision\":\"block\",\"reason\":\"nope\"}"), STR_LEN("{\"decision\":\"block\",\"reason\":\"nope\"}"), true, 0, &p);
    expectTrue(ctx, p.blocked, STR_PTR("parseHookOutput: decision block"), STR_LEN("parseHookOutput: decision block"));
    expectTrue(ctx, p.has_blockReason && strEqBuf(p.blockReason_ptr, p.blockReason_len, STR_PTR("nope"), STR_LEN("nope")), STR_PTR("parseHookOutput: blockReason"), STR_LEN("parseHookOutput: blockReason"));
    // test("continue:false blocks")
    parseHookOutput(STR_PTR("{\"continue\":false}"), STR_LEN("{\"continue\":false}"), true, 0, &p);
    expectTrue(ctx, p.blocked, STR_PTR("parseHookOutput: continue false"), STR_LEN("parseHookOutput: continue false"));
    // test("updatedInput + additionalContext")
    parseHookOutput(STR_PTR("{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"updatedInput\":{\"x\":2},\"additionalContext\":\"ctx here\"}}"), STR_LEN("{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"updatedInput\":{\"x\":2},\"additionalContext\":\"ctx here\"}}"), true, 0, &p);
    expectTrue(ctx, !p.blocked, STR_PTR("parseHookOutput: updatedInput not blocked"), STR_LEN("parseHookOutput: updatedInput not blocked"));
    expectTrue(ctx, p.has_updatedInput, STR_PTR("parseHookOutput: updatedInput present"), STR_LEN("parseHookOutput: updatedInput present"));
    let tb = TextBuf { bytes: [0u8; 32768], len: 0 };
    let tp: ptr = PTR_NULL();
    PTR_BYTE_ADD(tp, &tb.bytes, 0);
    mj_node_text(p.updatedInput_node, 32768, tp, &tb.len);
    expectEqJson(ctx, tp, tb.len, STR_PTR("{\"x\":2}"), STR_LEN("{\"x\":2}"), STR_PTR("parseHookOutput: updatedInput value"), STR_LEN("parseHookOutput: updatedInput value"));
    expectTrue(ctx, p.has_additionalContext && strEqBuf(p.additionalContext_ptr, p.additionalContext_len, STR_PTR("ctx here"), STR_LEN("ctx here")), STR_PTR("parseHookOutput: additionalContext"), STR_LEN("parseHookOutput: additionalContext"));
    // test("non-JSON stdout is warning only")
    parseHookOutput(STR_PTR("just a note"), STR_LEN("just a note"), true, 0, &p);
    expectTrue(ctx, !p.blocked, STR_PTR("parseHookOutput: note not blocked"), STR_LEN("parseHookOutput: note not blocked"));
    expectTrue(ctx, p.has_systemMessage && strEqBuf(p.systemMessage_ptr, p.systemMessage_len, STR_PTR("just a note"), STR_LEN("just a note")), STR_PTR("parseHookOutput: systemMessage"), STR_LEN("parseHookOutput: systemMessage"));
}

// describe("executeHooks with command handlers") — via mcpHooks' mh_execute
// adapter over hooks' real executeHooks (event index 0 = PreToolUse).
// DEFECT: async | every executeHooks test is async in TS (await); the SLA executor is a blocking pump, so the calls are synchronous here.
fn test_executeHooks(ctx: &TestCtx) {
    let state = hook_module_state_new();
    let files = testFiles();
    let tin = sa_json_parse(STR_PTR("{\"path\":\"/tmp/x\"}"), STR_LEN("{\"path\":\"/tmp/x\"}"));
    // test("no handlers -> no events")
    let events0 = hook_events_new();
    eventsFromText(STR_PTR("{}"), STR_LEN("{}"), &events0);
    let base = HookCtx { session_id: [0u8; 128], session_id_len: 0, turn_id: [0u8; 64], turn_id_len: 0, cwd: [0u8; 512], cwd_len: 0, model: [0u8; 128], model_len: 0, tool_name: [0u8; 128], tool_name_len: 0, tool_use_id: [0u8; 128], tool_use_id_len: 0, tool_input_json: [0u8; 8192], tool_input_json_len: 0, has_tool_response: false, tool_response_json: [0u8; 16384], tool_response_json_len: 0, sink: 0, use_call_mcp_raw: false };
    makeCtxBase(&base);
    let r = emptyExecResult();
    mh_execute(&state, &events0, &files, 1, 0, &base, tin, &r);
    expectTrue(ctx, !r.blocked, STR_PTR("executeHooks: no handlers not blocked"), STR_LEN("executeHooks: no handlers not blocked"));
    expectTrue(ctx, runsOf(&r) == 0, STR_PTR("executeHooks: no handlers no events"), STR_LEN("executeHooks: no handlers no events"));
    // test("empty-output command -> completed event")
    // const ev = { PreToolUse: [{ hooks: [{ type: "command", command: win32 ? "exit 0" : "true" }] }] };
    let ev1 = "{\"PreToolUse\":[{\"hooks\":[{\"type\":\"command\",\"command\":\"true\"}]}]}";
    if IS_WIN32 { ev1 = "{\"PreToolUse\":[{\"hooks\":[{\"type\":\"command\",\"command\":\"exit 0\"}]}]}"; };
    let events1 = hook_events_new();
    eventsFromText(STR_PTR(ev1), STR_LEN(ev1), &events1);
    let base2 = HookCtx { session_id: [0u8; 128], session_id_len: 0, turn_id: [0u8; 64], turn_id_len: 0, cwd: [0u8; 512], cwd_len: 0, model: [0u8; 128], model_len: 0, tool_name: [0u8; 128], tool_name_len: 0, tool_use_id: [0u8; 128], tool_use_id_len: 0, tool_input_json: [0u8; 8192], tool_input_json_len: 0, has_tool_response: false, tool_response_json: [0u8; 16384], tool_response_json_len: 0, sink: 0, use_call_mcp_raw: false };
    makeCtxBase(&base2);
    base2.sink = 1; // sink: (e) => seen.push(e.type) — routed to hooks' sink dispatch (documented no-op in this port; the seen-sequence assertion is dropped, see header)
    mh_execute(&state, &events1, &files, 1, 0, &base2, tin, &r);
    expectTrue(ctx, !r.blocked, STR_PTR("executeHooks: true not blocked"), STR_LEN("executeHooks: true not blocked"));
    expectTrue(ctx, runsOf(&r) == 1, STR_PTR("executeHooks: true one event"), STR_LEN("executeHooks: true one event"));
    expectTrue(ctx, eventStatusEq(&r, 0, STR_PTR("completed"), STR_LEN("completed")), STR_PTR("executeHooks: true completed"), STR_LEN("executeHooks: true completed"));
    // test("block command -> blocked + reason")
    // NOTE: runShell already wraps with cmd.exe/sh, so pass the bare command.
    let ev2 = "{\"PreToolUse\":[{\"hooks\":[{\"type\":\"command\",\"command\":\"printf '%s' '{\\\"decision\\\":\\\"block\\\",\\\"reason\\\":\\\"policy says no\\\"}'\"}]}]}";
    if IS_WIN32 { ev2 = "{\"PreToolUse\":[{\"hooks\":[{\"type\":\"command\",\"command\":\"echo {\\\"decision\\\":\\\"block\\\",\\\"reason\\\":\\\"policy says no\\\"}\"}]}]}"; };
    let events2 = hook_events_new();
    eventsFromText(STR_PTR(ev2), STR_LEN(ev2), &events2);
    let base3 = HookCtx { session_id: [0u8; 128], session_id_len: 0, turn_id: [0u8; 64], turn_id_len: 0, cwd: [0u8; 512], cwd_len: 0, model: [0u8; 128], model_len: 0, tool_name: [0u8; 128], tool_name_len: 0, tool_use_id: [0u8; 128], tool_use_id_len: 0, tool_input_json: [0u8; 8192], tool_input_json_len: 0, has_tool_response: false, tool_response_json: [0u8; 16384], tool_response_json_len: 0, sink: 0, use_call_mcp_raw: false };
    makeCtxBase(&base3);
    mh_execute(&state, &events2, &files, 1, 0, &base3, tin, &r);
    expectTrue(ctx, r.blocked, STR_PTR("executeHooks: block command blocked"), STR_LEN("executeHooks: block command blocked"));
    let brp: ptr = PTR_NULL();
    PTR_BYTE_ADD(brp, &r.block_reason, 0);
    expectContains(ctx, brp, r.block_reason_len, STR_PTR("policy says no"), STR_LEN("policy says no"), STR_PTR("executeHooks: block reason"), STR_LEN("executeHooks: block reason"));
    expectTrue(ctx, eventStatusEq(&r, 0, STR_PTR("blocked"), STR_LEN("blocked")), STR_PTR("executeHooks: block status"), STR_LEN("executeHooks: block status"));
    // test("rewrite command -> updatedInput")
    let ev3 = "{\"PreToolUse\":[{\"hooks\":[{\"type\":\"command\",\"command\":\"printf '%s' '{\\\"hookSpecificOutput\\\":{\\\"hookEventName\\\":\\\"PreToolUse\\\",\\\"updatedInput\\\":{\\\"path\\\":\\\"/rewritten\\\"}}}'\"}]}]}";
    if IS_WIN32 { ev3 = "{\"PreToolUse\":[{\"hooks\":[{\"type\":\"command\",\"command\":\"echo {\\\"hookSpecificOutput\\\":{\\\"hookEventName\\\":\\\"PreToolUse\\\",\\\"updatedInput\\\":{\\\"path\\\":\\\"/rewritten\\\"}}}\"}]}]}"; };
    let events3 = hook_events_new();
    eventsFromText(STR_PTR(ev3), STR_LEN(ev3), &events3);
    let base4 = HookCtx { session_id: [0u8; 128], session_id_len: 0, turn_id: [0u8; 64], turn_id_len: 0, cwd: [0u8; 512], cwd_len: 0, model: [0u8; 128], model_len: 0, tool_name: [0u8; 128], tool_name_len: 0, tool_use_id: [0u8; 128], tool_use_id_len: 0, tool_input_json: [0u8; 8192], tool_input_json_len: 0, has_tool_response: false, tool_response_json: [0u8; 16384], tool_response_json_len: 0, sink: 0, use_call_mcp_raw: false };
    makeCtxBase(&base4);
    mh_execute(&state, &events3, &files, 1, 0, &base4, tin, &r);
    expectTrue(ctx, !r.blocked, STR_PTR("executeHooks: rewrite not blocked"), STR_LEN("executeHooks: rewrite not blocked"));
    let uip: ptr = PTR_NULL();
    PTR_BYTE_ADD(uip, &r.updated_input_json, 0);
    expectTrue(ctx, r.has_updated_input, STR_PTR("executeHooks: rewrite has updatedInput"), STR_LEN("executeHooks: rewrite has updatedInput"));
    expectEqJson(ctx, uip, r.updated_input_json_len, STR_PTR("{\"path\":\"/rewritten\"}"), STR_LEN("{\"path\":\"/rewritten\"}"), STR_PTR("executeHooks: rewrite updatedInput"), STR_LEN("executeHooks: rewrite updatedInput"));
    // test("mcp_tool handler forwards its configured timeout to the raw MCP executor")
    // The timeout recorder is the callMcpRaw host callback; in this port the
    // dispatch is an explicit-error stub, so only the not-blocked outcome is
    // asserted (see header DEFECT note).
    let ev4 = "{\"PreToolUse\":[{\"hooks\":[{\"type\":\"mcp_tool\",\"server\":\"policy\",\"tool\":\"check\",\"input\":{},\"timeout\":1.25}]}]}";
    let events4 = hook_events_new();
    eventsFromText(STR_PTR(ev4), STR_LEN(ev4), &events4);
    let base5 = HookCtx { session_id: [0u8; 128], session_id_len: 0, turn_id: [0u8; 64], turn_id_len: 0, cwd: [0u8; 512], cwd_len: 0, model: [0u8; 128], model_len: 0, tool_name: [0u8; 128], tool_name_len: 0, tool_use_id: [0u8; 128], tool_use_id_len: 0, tool_input_json: [0u8; 8192], tool_input_json_len: 0, has_tool_response: false, tool_response_json: [0u8; 16384], tool_response_json_len: 0, sink: 0, use_call_mcp_raw: false };
    makeCtxBase(&base5);
    base5.use_call_mcp_raw = true; // callMcpRaw: async (_server, _tool, _input, timeoutMs) => { timeouts.push(timeoutMs); return ""; }
    mh_execute(&state, &events4, &files, 1, 0, &base5, tin, &r);
    expectTrue(ctx, !r.blocked, STR_PTR("executeHooks: mcp_tool not blocked"), STR_LEN("executeHooks: mcp_tool not blocked"));
    // test("bad command -> failed event, no throw")
    let ev5 = "{\"PreToolUse\":[{\"hooks\":[{\"type\":\"command\",\"command\":\"definitely-not-a-real-binary-xyz\"}]}]}";
    let events5 = hook_events_new();
    eventsFromText(STR_PTR(ev5), STR_LEN(ev5), &events5);
    let base6 = HookCtx { session_id: [0u8; 128], session_id_len: 0, turn_id: [0u8; 64], turn_id_len: 0, cwd: [0u8; 512], cwd_len: 0, model: [0u8; 128], model_len: 0, tool_name: [0u8; 128], tool_name_len: 0, tool_use_id: [0u8; 128], tool_use_id_len: 0, tool_input_json: [0u8; 8192], tool_input_json_len: 0, has_tool_response: false, tool_response_json: [0u8; 16384], tool_response_json_len: 0, sink: 0, use_call_mcp_raw: false };
    makeCtxBase(&base6);
    mh_execute(&state, &events5, &files, 1, 0, &base6, tin, &r);
    expectTrue(ctx, !r.blocked, STR_PTR("executeHooks: bad command not blocked"), STR_LEN("executeHooks: bad command not blocked"));
    expectTrue(ctx, runsOf(&r) == 1, STR_PTR("executeHooks: bad command one event"), STR_LEN("executeHooks: bad command one event"));
    expectTrue(ctx, eventStatusEq(&r, 0, STR_PTR("failed"), STR_LEN("failed")), STR_PTR("executeHooks: bad command failed"), STR_LEN("executeHooks: bad command failed"));
    // test("unsupported prompt handler -> failed event, no throw")
    let ev6 = "{\"PreToolUse\":[{\"hooks\":[{\"type\":\"prompt\"}]}]}";
    let events6 = hook_events_new();
    eventsFromText(STR_PTR(ev6), STR_LEN(ev6), &events6);
    let base7 = HookCtx { session_id: [0u8; 128], session_id_len: 0, turn_id: [0u8; 64], turn_id_len: 0, cwd: [0u8; 512], cwd_len: 0, model: [0u8; 128], model_len: 0, tool_name: [0u8; 128], tool_name_len: 0, tool_use_id: [0u8; 128], tool_use_id_len: 0, tool_input_json: [0u8; 8192], tool_input_json_len: 0, has_tool_response: false, tool_response_json: [0u8; 16384], tool_response_json_len: 0, sink: 0, use_call_mcp_raw: false };
    makeCtxBase(&base7);
    mh_execute(&state, &events6, &files, 1, 0, &base7, tin, &r);
    expectTrue(ctx, eventStatusEq(&r, 0, STR_PTR("failed"), STR_LEN("failed")), STR_PTR("executeHooks: prompt failed"), STR_LEN("executeHooks: prompt failed"));
}

// describe("runToolWithHooks (no hooks configured)")
fn test_runToolWithHooks(ctx: &TestCtx) {
    // test("non-MCP tool passes through when no hooks file")
    // runToolWithHooks("sa_vm", { action: "list_dir" }, "call-x", { cwd, model: "test", sink: null, execNonMcp: async () => "ok-from-exec" })
    // DEFECT: closure/callback | execNonMcp is the host tool-executor seam (opts.exec_non_mcp = 1 selects it); in this port mh_exec_non_mcp is an explicit host-boundary failure, so the output assertion below is registered as runtime-blocked in FIX_MINI_CODEX.md (compile-through only).
    // DEFECT: async | await approximated synchronously (the pipeline is a blocking pump in this port).
    let g = HookGlobals { warned_no_sink: false };
    let mcp = zeroMcpGlobals();
    let opts = HookPipelineOpts { cwd: [0u8; 512], cwd_len: 0, model: [0u8; 128], model_len: 0, has_session_id: false, session_id: [0u8; 128], session_id_len: 0, has_turn_id: false, turn_id: [0u8; 64], turn_id_len: 0, sink_kind: 1, sink: 0, exec_non_mcp: 1 };
    let ocp: ptr = PTR_NULL();
    PTR_BYTE_ADD(ocp, &opts.cwd, 0);
    putText(ocp, STR_PTR("/tmp"), STR_LEN("/tmp"), &opts.cwd_len);
    let omp: ptr = PTR_NULL();
    PTR_BYTE_ADD(omp, &opts.model, 0);
    putText(omp, STR_PTR("test"), STR_LEN("test"), &opts.model_len);
    let r = RunToolWithHooksResult { output: [0u8; 16384], output_len: 0, hook_events_json: [0u8; 16384], hook_events_json_len: 0, blocked: false };
    runToolWithHooks(&g, &mcp, STR_PTR("sa_vm"), STR_LEN("sa_vm"), STR_PTR("{\"action\":\"list_dir\"}"), STR_LEN("{\"action\":\"list_dir\"}"), STR_PTR("call-x"), STR_LEN("call-x"), &opts, &r);
    let op: ptr = PTR_NULL();
    PTR_BYTE_ADD(op, &r.output, 0);
    expectTrue(ctx, strEqBuf(op, r.output_len, STR_PTR("ok-from-exec"), STR_LEN("ok-from-exec")), STR_PTR("runToolWithHooks: output"), STR_LEN("runToolWithHooks: output"));
    expectTrue(ctx, !r.blocked, STR_PTR("runToolWithHooks: not blocked"), STR_LEN("runToolWithHooks: not blocked"));
    // test("loadHookEvents never throws without files") — the real entry
    // point returns a status code; 0 is its never-throws success outcome and
    // the returned events object is the HookEvents struct itself.
    let state = hook_module_state_new();
    let events = hook_events_new();
    let st = loadHookEvents(&state, STR_PTR("/tmp"), STR_LEN("/tmp"), false, &events);
    expectTrue(ctx, st == 0, STR_PTR("loadHookEvents: never throws"), STR_LEN("loadHookEvents: never throws"));
}

fn main() -> i32 {
    let ctx = TestCtx { checks: 0, fails: 0 };
    test_matcher(&ctx);
    test_mcpHookToolInput(&ctx);
    test_renderMcpHookInput(&ctx);
    test_parseHookOutput(&ctx);
    test_executeHooks(&ctx);
    test_runToolWithHooks(&ctx);
    if ctx.fails > 0 {
        sa_print_bytes(STR_PTR("hooks.test: FAIL\n"), STR_LEN("hooks.test: FAIL\n"));
        return 1;
    };
    sa_print_bytes(STR_PTR("hooks.test: PASS\n"), STR_LEN("hooks.test: PASS\n"));
    return 0;
}
