// Converted 1:1 from mini-codex/test/hooks.test.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
// Verification for mini-codex MCP hook events (Codex parity).
// Run: bun test test/hooks.test.ts
// DEFECT: test framework | bun:test describe/test/expect has no SLA counterpart; approximated: each test() becomes a fn, expect(...) becomes expect* helper calls, main() runs all tests and returns the failure count.
// DEFECT: cross-unit signatures | hooks.sla / mcpHooks.sla are converted by another unit; the imports below assume JSON-text/struct approximations of their signatures (HookEvents, contexts and results are dynamic objects in TS).
@import "sa_std/io/print.sai"
@import "sa_std/ptr.sa"
@import "../src/hooks.sla"
@import "../src/mcpHooks.sla"

struct TestCtx {
    checks: u64,
    fails: u64,
}

// Growable text buffer (JSON text stands in for TS objects).
struct HookStr {
    bytes: [u8; 8192], len: u64,
}

// selectHookHandlers return approximation: selected handler indexes in display order.
struct SelList {
    idxs: [u64; 16], len: u64,
}

// parseHookOutput return approximation.
struct ParsedHook {
    blocked: bool,
    block_reason: [u8; 1024], block_reason_len: u64, has_block_reason: bool,
    updated_input_json: [u8; 4096], updated_input_json_len: u64, has_updated_input: bool,
    additional_context: [u8; 4096], additional_context_len: u64, has_additional_context: bool,
    system_message: [u8; 4096], system_message_len: u64, has_system_message: bool,
}

// One hook run event (r.hookEvents[i].run.status).
struct HookRunEvent {
    status: [u8; 32], status_len: u64, // "completed" | "blocked" | "failed"
}

// executeHooks / runToolWithHooks result approximation.
struct HookResult {
    blocked: bool,
    block_reason: [u8; 1024], block_reason_len: u64, has_block_reason: bool,
    updated_input_json: [u8; 4096], updated_input_json_len: u64, has_updated_input: bool,
    output: [u8; 8192], output_len: u64, // runToolWithHooks only
    events: [HookRunEvent; 16], events_len: u64,
}

// executeHooks context approximation (TS ctxBase object).
// DEFECT: closure/callback | callMcpRaw (async callback) and sink (event callback) have no SLA counterpart; approximated by mode fields: call_mcp_raw_mode selects a local stub, sink events are appended to sink_types as JSON text; recorded timeouts land in `timeouts`.
struct HookCtx {
    session_id: [u8; 64], session_id_len: u64,
    turn_id: [u8; 64], turn_id_len: u64,
    cwd: [u8; 1024], cwd_len: u64,
    model: [u8; 64], model_len: u64,
    tool_name: [u8; 128], tool_name_len: u64,
    tool_use_id: [u8; 64], tool_use_id_len: u64,
    tool_input_json: [u8; 4096], tool_input_json_len: u64,
    call_mcp_raw_mode: u64, // 0 = default stub returning "", 1 = record-timeout stub
    timeouts: [u64; 8], timeouts_len: u64,
    sink_types_json: [u8; 4096], sink_types_json_len: u64, has_sink: bool,
}

// DEFECT: Node API | process.cwd() / process.platform globals have no counterpart; cwd is passed as a literal "/tmp" stand-in and the platform branch is approximated as non-win32 (is_win32 = false).
const IS_WIN32: bool = false;

fn expectTrue(ctx: &TestCtx, cond: bool, label_ptr: ptr, label_len: u64) {
    ctx.checks = ctx.checks + 1;
    if !cond {
        ctx.fails = ctx.fails + 1;
        print("FAIL: ");
        println(label_ptr, label_len);
    };
}

fn strEqBuf(a_ptr: ptr, a_len: u64, b_ptr: ptr, b_len: u64) -> bool {
    if a_len != b_len { return false; };
    let i: u64 = 0;
    while i < a_len {
        let x: u8 = 0;
        let y: u8 = 0;
        PTR_BYTE_AT(x, a_ptr, i);
        PTR_BYTE_AT(y, b_ptr, i);
        if x != y { return false; };
        i = i + 1;
    }
    return true;
}

fn expectEqJson(ctx: &TestCtx, got_ptr: ptr, got_len: u64, want_ptr: ptr, want_len: u64, label_ptr: ptr, label_len: u64) {
    // DEFECT: assertion | expect(...).toEqual(object) deep equality approximated by canonical JSON text comparison (key order sensitive).
    expectTrue(ctx, strEqBuf(got_ptr, got_len, want_ptr, want_len), label_ptr, label_len);
}

fn expectContains(ctx: &TestCtx, hay_ptr: ptr, hay_len: u64, nd_ptr: ptr, nd_len: u64, label_ptr: ptr, label_len: u64) {
    let found = false;
    if hay_len >= nd_len {
        let last = hay_len - nd_len;
        let i: u64 = 0;
        while i <= last && !found {
            let ok = true;
            let j: u64 = 0;
            while j < nd_len {
                let x: u8 = 0;
                let y: u8 = 0;
                PTR_BYTE_AT(x, hay_ptr, i + j);
                PTR_BYTE_AT(y, nd_ptr, j);
                if x != y { ok = false; };
                j = j + 1;
            }
            if ok { found = true; };
            i = i + 1;
        }
    };
    expectTrue(ctx, found, label_ptr, label_len);
}

// describe("matcher (Codex parity)")
fn test_matcher(ctx: &TestCtx) {
    // test("empty matcher matches all")
    // DEFECT: optional/undefined argument | matcherMatches(undefined, ...) approximated with a has_matcher flag.
    expectTrue(ctx, matcherMatches(STR_PTR(""), 0, false, STR_PTR("mcp__fs__read"), STR_LEN("mcp__fs__read")), STR_PTR("empty matcher: undefined"), STR_LEN("empty matcher: undefined"));
    expectTrue(ctx, matcherMatches(STR_PTR(""), 0, true, STR_PTR("mcp__fs__read"), STR_LEN("mcp__fs__read")), STR_PTR("empty matcher: ''"), STR_LEN("empty matcher: ''"));
    // test("regex matcher")
    // DEFECT: regex | matcher semantics (RegExp with substring fallback) live in the hooks unit; calls transcribed as-is.
    expectTrue(ctx, matcherMatches(STR_PTR("^mcp__"), STR_LEN("^mcp__"), true, STR_PTR("mcp__fs__read"), STR_LEN("mcp__fs__read")), STR_PTR("regex matcher: ^mcp__ hit"), STR_LEN("regex matcher: ^mcp__ hit"));
    expectTrue(ctx, !matcherMatches(STR_PTR("^mcp__"), STR_LEN("^mcp__"), true, STR_PTR("sa_vm"), STR_LEN("sa_vm")), STR_PTR("regex matcher: ^mcp__ miss"), STR_LEN("regex matcher: ^mcp__ miss"));
    expectTrue(ctx, matcherMatches(STR_PTR("Write|Edit"), STR_LEN("Write|Edit"), true, STR_PTR("Edit"), STR_LEN("Edit")), STR_PTR("regex matcher: Write|Edit"), STR_LEN("regex matcher: Write|Edit"));
    // test("invalid regex falls back to substring")
    expectTrue(ctx, matcherMatches(STR_PTR("(["), STR_LEN("(["), true, STR_PTR("tool ([x]"), STR_LEN("tool ([x]")), STR_PTR("invalid regex -> substring"), STR_LEN("invalid regex -> substring"));
    // test("selectHookHandlers keeps display order")
    // const ev: HookEvents = { PreToolUse: [ { matcher: "^mcp__", hooks: [...] }, { hooks: [...] } ] };
    // DEFECT: dynamic object | HookEvents object literal kept as JSON text.
    let ev = "{\"PreToolUse\":[{\"matcher\":\"^mcp__\",\"hooks\":[{\"type\":\"command\",\"command\":\"echo hi\"}]},{\"hooks\":[{\"type\":\"command\",\"command\":\"echo all\"}]}]}";
    let sel = SelList { idxs: [0u64; 16], len: 0 };
    selectHookHandlers(STR_PTR(ev), STR_LEN(ev), STR_PTR("PreToolUse"), STR_LEN("PreToolUse"), STR_PTR("mcp__a__b"), STR_LEN("mcp__a__b"), &sel);
    expectTrue(ctx, sel.len == 2, STR_PTR("selectHookHandlers: len 2"), STR_LEN("selectHookHandlers: len 2"));
    if sel.len == 2 {
        expectTrue(ctx, sel.idxs[0] == 0, STR_PTR("selectHookHandlers: [0].index"), STR_LEN("selectHookHandlers: [0].index"));
        expectTrue(ctx, sel.idxs[1] == 1, STR_PTR("selectHookHandlers: [1].index"), STR_LEN("selectHookHandlers: [1].index"));
    };
    let none = SelList { idxs: [0u64; 16], len: 0 };
    selectHookHandlers(STR_PTR(ev), STR_LEN(ev), STR_PTR("PreToolUse"), STR_LEN("PreToolUse"), STR_PTR("sa_vm"), STR_LEN("sa_vm"), &none);
    expectTrue(ctx, none.len == 1, STR_PTR("selectHookHandlers: sa_vm len 1"), STR_LEN("selectHookHandlers: sa_vm len 1"));
}

// describe("mcpHookToolInput (Codex parity)")
fn test_mcpHookToolInput(ctx: &TestCtx) {
    let out = HookStr { bytes: [0u8; 8192], len: 0 };
    // test("object passes through") — expect(mcpHookToolInput({ a: 1 })).toEqual({ a: 1 });
    mcpHookToolInput(STR_PTR("{\"a\":1}"), STR_LEN("{\"a\":1}"), &out);
    let op: ptr = PTR_NULL();
    PTR_BYTE_ADD(op, &out.bytes, 0);
    expectEqJson(ctx, op, out.len, STR_PTR("{\"a\":1}"), STR_LEN("{\"a\":1}"), STR_PTR("mcpHookToolInput: object"), STR_LEN("mcpHookToolInput: object"));
    // test("empty string -> {}")
    mcpHookToolInput(STR_PTR(""), 0, &out);
    op = PTR_NULL();
    PTR_BYTE_ADD(op, &out.bytes, 0);
    expectEqJson(ctx, op, out.len, STR_PTR("{}"), STR_LEN("{}"), STR_PTR("mcpHookToolInput: empty"), STR_LEN("mcpHookToolInput: empty"));
    // test("JSON string parsed")
    mcpHookToolInput(STR_PTR("{\"x\":1}"), STR_LEN("{\"x\":1}"), &out);
    op = PTR_NULL();
    PTR_BYTE_ADD(op, &out.bytes, 0);
    expectEqJson(ctx, op, out.len, STR_PTR("{\"x\":1}"), STR_LEN("{\"x\":1}"), STR_PTR("mcpHookToolInput: json string"), STR_LEN("mcpHookToolInput: json string"));
    // test("non-JSON string -> {_raw}")
    mcpHookToolInput(STR_PTR("hello"), STR_LEN("hello"), &out);
    op = PTR_NULL();
    PTR_BYTE_ADD(op, &out.bytes, 0);
    expectEqJson(ctx, op, out.len, STR_PTR("{\"_raw\":\"hello\"}"), STR_LEN("{\"_raw\":\"hello\"}"), STR_PTR("mcpHookToolInput: _raw"), STR_LEN("mcpHookToolInput: _raw"));
}

// describe("renderMcpHookInput templating")
fn test_renderMcpHookInput(ctx: &TestCtx) {
    // test("expands ${tool_input.*} (Codex test shape)")
    let input = "{\"file_path\":\"${tool_input.file_path}\",\"include_ignored\":false}";
    let c = "{\"tool_name\":\"mcp__security__scan\",\"tool_use_id\":\"u1\",\"cwd\":\"/w\",\"session_id\":\"s\",\"turn_id\":\"t\",\"server\":\"security\",\"tool\":\"scan\",\"tool_input\":{\"file_path\":\"/a/b.txt\"}}";
    let out = HookStr { bytes: [0u8; 8192], len: 0 };
    renderMcpHookInput(STR_PTR(input), STR_LEN(input), STR_PTR(c), STR_LEN(c), &out);
    let op: ptr = PTR_NULL();
    PTR_BYTE_ADD(op, &out.bytes, 0);
    expectEqJson(ctx, op, out.len, STR_PTR("{\"file_path\":\"/a/b.txt\",\"include_ignored\":false}"), STR_LEN("{\"file_path\":\"/a/b.txt\",\"include_ignored\":false}"), STR_PTR("renderMcpHookInput: expands"), STR_LEN("renderMcpHookInput: expands"));
    // test("missing path -> empty string")
    let input2 = "{\"p\":\"${tool_input.missing}\"}";
    let c2 = "{\"tool_name\":\"n\",\"tool_use_id\":\"u\",\"cwd\":\"/w\",\"session_id\":\"s\",\"turn_id\":\"t\",\"server\":\"sv\",\"tool\":\"tl\",\"tool_input\":{}}";
    renderMcpHookInput(STR_PTR(input2), STR_LEN(input2), STR_PTR(c2), STR_LEN(c2), &out);
    op = PTR_NULL();
    PTR_BYTE_ADD(op, &out.bytes, 0);
    expectEqJson(ctx, op, out.len, STR_PTR("{\"p\":\"\"}"), STR_LEN("{\"p\":\"\"}"), STR_PTR("renderMcpHookInput: missing"), STR_LEN("renderMcpHookInput: missing"));
}

// describe("parseHookOutput")
fn test_parseHookOutput(ctx: &TestCtx) {
    let p = ParsedHook { blocked: false, block_reason: [0u8; 1024], block_reason_len: 0, has_block_reason: false, updated_input_json: [0u8; 4096], updated_input_json_len: 0, has_updated_input: false, additional_context: [0u8; 4096], additional_context_len: 0, has_additional_context: false, system_message: [0u8; 4096], system_message_len: 0, has_system_message: false };
    // test("empty -> approve")
    parseHookOutput(STR_PTR(""), 0, STR_PTR("PreToolUse"), STR_LEN("PreToolUse"), &p);
    expectTrue(ctx, !p.blocked, STR_PTR("parseHookOutput: empty approve"), STR_LEN("parseHookOutput: empty approve"));
    // test("decision block") — TS builds the input with JSON.stringify({...}).
    // DEFECT: dynamic object | JSON.stringify input approximated by the equivalent literal.
    parseHookOutput(STR_PTR("{\"decision\":\"block\",\"reason\":\"nope\"}"), STR_LEN("{\"decision\":\"block\",\"reason\":\"nope\"}"), STR_PTR("PreToolUse"), STR_LEN("PreToolUse"), &p);
    expectTrue(ctx, p.blocked, STR_PTR("parseHookOutput: decision block"), STR_LEN("parseHookOutput: decision block"));
    let brp: ptr = PTR_NULL();
    PTR_BYTE_ADD(brp, &p.block_reason, 0);
    expectTrue(ctx, p.has_block_reason && strEqBuf(brp, p.block_reason_len, STR_PTR("nope"), STR_LEN("nope")), STR_PTR("parseHookOutput: blockReason"), STR_LEN("parseHookOutput: blockReason"));
    // test("continue:false blocks")
    parseHookOutput(STR_PTR("{\"continue\":false}"), STR_LEN("{\"continue\":false}"), STR_PTR("PreToolUse"), STR_LEN("PreToolUse"), &p);
    expectTrue(ctx, p.blocked, STR_PTR("parseHookOutput: continue false"), STR_LEN("parseHookOutput: continue false"));
    // test("updatedInput + additionalContext")
    parseHookOutput(STR_PTR("{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"updatedInput\":{\"x\":2},\"additionalContext\":\"ctx here\"}}"), STR_LEN("{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"updatedInput\":{\"x\":2},\"additionalContext\":\"ctx here\"}}"), STR_PTR("PreToolUse"), STR_LEN("PreToolUse"), &p);
    expectTrue(ctx, !p.blocked, STR_PTR("parseHookOutput: updatedInput not blocked"), STR_LEN("parseHookOutput: updatedInput not blocked"));
    let uip: ptr = PTR_NULL();
    PTR_BYTE_ADD(uip, &p.updated_input_json, 0);
    expectTrue(ctx, p.has_updated_input, STR_PTR("parseHookOutput: updatedInput present"), STR_LEN("parseHookOutput: updatedInput present"));
    expectEqJson(ctx, uip, p.updated_input_json_len, STR_PTR("{\"x\":2}"), STR_LEN("{\"x\":2}"), STR_PTR("parseHookOutput: updatedInput value"), STR_LEN("parseHookOutput: updatedInput value"));
    let acp: ptr = PTR_NULL();
    PTR_BYTE_ADD(acp, &p.additional_context, 0);
    expectTrue(ctx, p.has_additional_context && strEqBuf(acp, p.additional_context_len, STR_PTR("ctx here"), STR_LEN("ctx here")), STR_PTR("parseHookOutput: additionalContext"), STR_LEN("parseHookOutput: additionalContext"));
    // test("non-JSON stdout is warning only")
    parseHookOutput(STR_PTR("just a note"), STR_LEN("just a note"), STR_PTR("PreToolUse"), STR_LEN("PreToolUse"), &p);
    expectTrue(ctx, !p.blocked, STR_PTR("parseHookOutput: note not blocked"), STR_LEN("parseHookOutput: note not blocked"));
    let smp: ptr = PTR_NULL();
    PTR_BYTE_ADD(smp, &p.system_message, 0);
    expectTrue(ctx, p.has_system_message && strEqBuf(smp, p.system_message_len, STR_PTR("just a note"), STR_LEN("just a note")), STR_PTR("parseHookOutput: systemMessage"), STR_LEN("parseHookOutput: systemMessage"));
}

// ctxBase (TS lines 117-124) as a HookCtx value.
// DEFECT: object literal/spread | ctxBase and {...ctxBase, sink} spreads approximated by struct construction + field override.
fn makeCtxBase() -> HookCtx {
    let c = HookCtx { session_id: [0u8; 64], session_id_len: 0, turn_id: [0u8; 64], turn_id_len: 0, cwd: [0u8; 1024], cwd_len: 0, model: [0u8; 64], model_len: 0, tool_name: [0u8; 128], tool_name_len: 0, tool_use_id: [0u8; 64], tool_use_id_len: 0, tool_input_json: [0u8; 4096], tool_input_json_len: 0, call_mcp_raw_mode: 0, timeouts: [0u64; 8], timeouts_len: 0, sink_types_json: [0u8; 4096], sink_types_json_len: 0, has_sink: false };
    // sessionId: "s1", turnId: "t1", cwd: process.cwd(), model: "test",
    // toolName: "mcp__fs__read", toolUseId: "call-1", toolInput: { path: "/tmp/x" },
    // callMcpRaw: async () => "", sink: undefined
    c.session_id_len = 2; c.session_id[0] = 115; c.session_id[1] = 49; // "s1"
    c.turn_id_len = 2; c.turn_id[0] = 116; c.turn_id[1] = 49; // "t1"
    c.cwd_len = 4; c.cwd[0] = 47; c.cwd[1] = 116; c.cwd[2] = 109; c.cwd[3] = 112; // "/tmp" stand-in for process.cwd()
    c.model_len = 4; c.model[0] = 116; c.model[1] = 101; c.model[2] = 115; c.model[3] = 116; // "test"
    return c;
}

fn eventStatusEq(r: &HookResult, idx: u64, want_ptr: ptr, want_len: u64) -> bool {
    if idx >= r.events_len { return false; };
    let sp: ptr = PTR_NULL();
    PTR_BYTE_ADD(sp, &r.events[idx].status, 0);
    return strEqBuf(sp, r.events[idx].status_len, want_ptr, want_len);
}

// describe("executeHooks with command handlers")
// DEFECT: async | every executeHooks test is async in TS (await); approximated synchronously.
fn test_executeHooks(ctx: &TestCtx) {
    let sources = "[{\"path\":\"test\",\"source\":\"user\"}]";
    // test("no handlers -> no events")
    let base = makeCtxBase();
    let r = HookResult { blocked: false, block_reason: [0u8; 1024], block_reason_len: 0, has_block_reason: false, updated_input_json: [0u8; 4096], updated_input_json_len: 0, has_updated_input: false, output: [0u8; 8192], output_len: 0, events: [HookRunEvent { status: [0u8; 32], status_len: 0 }; 16], events_len: 0 };
    executeHooks(STR_PTR("{}"), STR_LEN("{}"), STR_PTR("[]"), STR_LEN("[]"), STR_PTR("PreToolUse"), STR_LEN("PreToolUse"), &base, &r);
    expectTrue(ctx, !r.blocked, STR_PTR("executeHooks: no handlers not blocked"), STR_LEN("executeHooks: no handlers not blocked"));
    expectTrue(ctx, r.events_len == 0, STR_PTR("executeHooks: no handlers no events"), STR_LEN("executeHooks: no handlers no events"));
    // test("empty-output command -> completed event")
    // const ev = { PreToolUse: [{ hooks: [{ type: "command", command: win32 ? "exit 0" : "true" }] }] };
    let ev1 = "{\"PreToolUse\":[{\"hooks\":[{\"type\":\"command\",\"command\":\"true\"}]}]}";
    if IS_WIN32 { ev1 = "{\"PreToolUse\":[{\"hooks\":[{\"type\":\"command\",\"command\":\"exit 0\"}]}]}"; };
    let base2 = makeCtxBase();
    base2.has_sink = true; // sink: (e) => seen.push(e.type)
    executeHooks(STR_PTR(ev1), STR_LEN(ev1), STR_PTR(sources), STR_LEN(sources), STR_PTR("PreToolUse"), STR_LEN("PreToolUse"), &base2, &r);
    expectTrue(ctx, !r.blocked, STR_PTR("executeHooks: true not blocked"), STR_LEN("executeHooks: true not blocked"));
    expectTrue(ctx, r.events_len == 1, STR_PTR("executeHooks: true one event"), STR_LEN("executeHooks: true one event"));
    expectTrue(ctx, eventStatusEq(&r, 0, STR_PTR("completed"), STR_LEN("completed")), STR_PTR("executeHooks: true completed"), STR_LEN("executeHooks: true completed"));
    // expect(seen).toEqual(["hook_started", "hook_completed"]);
    // DEFECT: closure | sink callback approximated by the callee filling sink_types_json with the event type sequence.
    let stp: ptr = PTR_NULL();
    PTR_BYTE_ADD(stp, &base2.sink_types_json, 0);
    expectEqJson(ctx, stp, base2.sink_types_json_len, STR_PTR("[\"hook_started\",\"hook_completed\"]"), STR_LEN("[\"hook_started\",\"hook_completed\"]"), STR_PTR("executeHooks: sink sequence"), STR_LEN("executeHooks: sink sequence"));
    // test("block command -> blocked + reason")
    // NOTE: runShell already wraps with cmd.exe/sh, so pass the bare command.
    let command = "printf '%s' '{\"decision\":\"block\",\"reason\":\"policy says no\"}'";
    if IS_WIN32 { command = "echo {\"decision\":\"block\",\"reason\":\"policy says no\"}"; };
    let ev2 = "{\"PreToolUse\":[{\"hooks\":[{\"type\":\"command\",\"command\":\"printf '%s' '{\\\"decision\\\":\\\"block\\\",\\\"reason\\\":\\\"policy says no\\\"}'\"}]}]}";
    if IS_WIN32 { ev2 = "{\"PreToolUse\":[{\"hooks\":[{\"type\":\"command\",\"command\":\"echo {\\\"decision\\\":\\\"block\\\",\\\"reason\\\":\\\"policy says no\\\"}\"}]}]}"; };
    let base3 = makeCtxBase();
    executeHooks(STR_PTR(ev2), STR_LEN(ev2), STR_PTR(sources), STR_LEN(sources), STR_PTR("PreToolUse"), STR_LEN("PreToolUse"), &base3, &r);
    expectTrue(ctx, r.blocked, STR_PTR("executeHooks: block command blocked"), STR_LEN("executeHooks: block command blocked"));
    let brp: ptr = PTR_NULL();
    PTR_BYTE_ADD(brp, &r.block_reason, 0);
    expectContains(ctx, brp, r.block_reason_len, STR_PTR("policy says no"), STR_LEN("policy says no"), STR_PTR("executeHooks: block reason"), STR_LEN("executeHooks: block reason"));
    expectTrue(ctx, eventStatusEq(&r, 0, STR_PTR("blocked"), STR_LEN("blocked")), STR_PTR("executeHooks: block status"), STR_LEN("executeHooks: block status"));
    // test("rewrite command -> updatedInput")
    let ev3 = "{\"PreToolUse\":[{\"hooks\":[{\"type\":\"command\",\"command\":\"printf '%s' '{\\\"hookSpecificOutput\\\":{\\\"hookEventName\\\":\\\"PreToolUse\\\",\\\"updatedInput\\\":{\\\"path\\\":\\\"/rewritten\\\"}}}'\"}]}]}";
    if IS_WIN32 { ev3 = "{\"PreToolUse\":[{\"hooks\":[{\"type\":\"command\",\"command\":\"echo {\\\"hookSpecificOutput\\\":{\\\"hookEventName\\\":\\\"PreToolUse\\\",\\\"updatedInput\\\":{\\\"path\\\":\\\"/rewritten\\\"}}}\"}]}]}"; };
    let base4 = makeCtxBase();
    executeHooks(STR_PTR(ev3), STR_LEN(ev3), STR_PTR(sources), STR_LEN(sources), STR_PTR("PreToolUse"), STR_LEN("PreToolUse"), &base4, &r);
    expectTrue(ctx, !r.blocked, STR_PTR("executeHooks: rewrite not blocked"), STR_LEN("executeHooks: rewrite not blocked"));
    let uip: ptr = PTR_NULL();
    PTR_BYTE_ADD(uip, &r.updated_input_json, 0);
    expectTrue(ctx, r.has_updated_input, STR_PTR("executeHooks: rewrite has updatedInput"), STR_LEN("executeHooks: rewrite has updatedInput"));
    expectEqJson(ctx, uip, r.updated_input_json_len, STR_PTR("{\"path\":\"/rewritten\"}"), STR_LEN("{\"path\":\"/rewritten\"}"), STR_PTR("executeHooks: rewrite updatedInput"), STR_LEN("executeHooks: rewrite updatedInput"));
    // test("mcp_tool handler forwards its configured timeout to the raw MCP executor")
    // const ev = { PreToolUse: [{ hooks: [{ type: "mcp_tool", server: "policy", tool: "check", input: {}, timeout: 1.25 }] }] };
    // callMcpRaw: async (_server, _tool, _input, timeoutMs) => { timeouts.push(timeoutMs); return ""; }
    let ev4 = "{\"PreToolUse\":[{\"hooks\":[{\"type\":\"mcp_tool\",\"server\":\"policy\",\"tool\":\"check\",\"input\":{},\"timeout\":1.25}]}]}";
    let base5 = makeCtxBase();
    base5.call_mcp_raw_mode = 1; // record-timeout stub
    executeHooks(STR_PTR(ev4), STR_LEN(ev4), STR_PTR(sources), STR_LEN(sources), STR_PTR("PreToolUse"), STR_LEN("PreToolUse"), &base5, &r);
    expectTrue(ctx, !r.blocked, STR_PTR("executeHooks: mcp_tool not blocked"), STR_LEN("executeHooks: mcp_tool not blocked"));
    // expect(timeouts).toEqual([1250]);
    expectTrue(ctx, base5.timeouts_len == 1 && base5.timeouts[0] == 1250, STR_PTR("executeHooks: timeout 1250"), STR_LEN("executeHooks: timeout 1250"));
    expectTrue(ctx, eventStatusEq(&r, 0, STR_PTR("completed"), STR_LEN("completed")), STR_PTR("executeHooks: mcp_tool completed"), STR_LEN("executeHooks: mcp_tool completed"));
    // test("bad command -> failed event, no throw")
    let ev5 = "{\"PreToolUse\":[{\"hooks\":[{\"type\":\"command\",\"command\":\"definitely-not-a-real-binary-xyz\"}]}]}";
    let base6 = makeCtxBase();
    executeHooks(STR_PTR(ev5), STR_LEN(ev5), STR_PTR(sources), STR_LEN(sources), STR_PTR("PreToolUse"), STR_LEN("PreToolUse"), &base6, &r);
    expectTrue(ctx, !r.blocked, STR_PTR("executeHooks: bad command not blocked"), STR_LEN("executeHooks: bad command not blocked"));
    expectTrue(ctx, r.events_len == 1, STR_PTR("executeHooks: bad command one event"), STR_LEN("executeHooks: bad command one event"));
    expectTrue(ctx, eventStatusEq(&r, 0, STR_PTR("failed"), STR_LEN("failed")), STR_PTR("executeHooks: bad command failed"), STR_LEN("executeHooks: bad command failed"));
    // test("unsupported prompt handler -> failed event, no throw")
    let ev6 = "{\"PreToolUse\":[{\"hooks\":[{\"type\":\"prompt\"}]}]}";
    let base7 = makeCtxBase();
    executeHooks(STR_PTR(ev6), STR_LEN(ev6), STR_PTR(sources), STR_LEN(sources), STR_PTR("PreToolUse"), STR_LEN("PreToolUse"), &base7, &r);
    expectTrue(ctx, eventStatusEq(&r, 0, STR_PTR("failed"), STR_LEN("failed")), STR_PTR("executeHooks: prompt failed"), STR_LEN("executeHooks: prompt failed"));
}

// describe("runToolWithHooks (no hooks configured)")
fn test_runToolWithHooks(ctx: &TestCtx) {
    // test("non-MCP tool passes through when no hooks file")
    // runToolWithHooks("sa_vm", { action: "list_dir" }, "call-x", { cwd, model: "test", sink: null, execNonMcp: async () => "ok-from-exec" })
    // DEFECT: closure/callback | execNonMcp async callback approximated by an exec mode field on the options struct (mode 1 = returns "ok-from-exec").
    // DEFECT: async | await approximated synchronously.
    let r = HookResult { blocked: false, block_reason: [0u8; 1024], block_reason_len: 0, has_block_reason: false, updated_input_json: [0u8; 4096], updated_input_json_len: 0, has_updated_input: false, output: [0u8; 8192], output_len: 0, events: [HookRunEvent { status: [0u8; 32], status_len: 0 }; 16], events_len: 0 };
    runToolWithHooks(STR_PTR("sa_vm"), STR_LEN("sa_vm"), STR_PTR("{\"action\":\"list_dir\"}"), STR_LEN("{\"action\":\"list_dir\"}"), STR_PTR("call-x"), STR_LEN("call-x"), STR_PTR("/tmp"), STR_LEN("/tmp"), STR_PTR("test"), STR_LEN("test"), 1, &r);
    let op: ptr = PTR_NULL();
    PTR_BYTE_ADD(op, &r.output, 0);
    expectTrue(ctx, strEqBuf(op, r.output_len, STR_PTR("ok-from-exec"), STR_LEN("ok-from-exec")), STR_PTR("runToolWithHooks: output"), STR_LEN("runToolWithHooks: output"));
    expectTrue(ctx, !r.blocked, STR_PTR("runToolWithHooks: not blocked"), STR_LEN("runToolWithHooks: not blocked"));
    // test("loadHookEvents never throws without files")
    let ev = HookStr { bytes: [0u8; 8192], len: 0 };
    loadHookEvents(STR_PTR("/tmp"), STR_LEN("/tmp"), &ev);
    // expect(typeof ev).toBe("object") — approximated: the call returns with a JSON object buffer.
    let ep: ptr = PTR_NULL();
    PTR_BYTE_ADD(ep, &ev.bytes, 0);
    expectTrue(ctx, ev.len >= 2, STR_PTR("loadHookEvents: returns object"), STR_LEN("loadHookEvents: returns object"));
    if ev.len >= 1 {
        let c: u8 = 0;
        PTR_BYTE_AT(c, ep, 0);
        expectTrue(ctx, c == 123, STR_PTR("loadHookEvents: object shape"), STR_LEN("loadHookEvents: object shape")); // '{'
    };
}

fn main() -> i32 {
    let ctx = TestCtx { checks: 0, fails: 0 };
    test_matcher(&ctx);
    test_mcpHookToolInput(&ctx);
    test_renderMcpHookInput(&ctx);
    test_parseHookOutput(&ctx);
    test_executeHooks(&ctx);
    test_runToolWithHooks(&ctx);
    if ctx.fails > 0 {
        println("hooks.test: FAIL");
        return 1;
    };
    println("hooks.test: PASS");
    return 0;
}
