fn test_retryable_statuses() -> i32 {
    let ctx = TestCtx { failures: 0 };
    expect_true(&ctx, isUpstreamRetryableStatus(429));
    expect_true(&ctx, isUpstreamRetryableStatus(503));
    expect_true(&ctx, !isUpstreamRetryableStatus(400));
    expect_true(&ctx, !isUpstreamRetryableStatus(200));
    return ctx.failures as i32;
}

// TS lines 142-150: test("backoff honors Retry-After", () => {
//   expect(upstreamRetryDelayMs(0)).toBe(500);
//   expect(upstreamRetryDelayMs(1)).toBe(1000);
//   expect(upstreamRetryDelayMs(99)).toBe(10000);
//   expect(upstreamRetryDelayMs(0, 250)).toBe(250);
//   expect(upstreamRetryAfterMs(new Headers({ "retry-after": "2" }))).toBe(2000);
//   expect(upstreamRetryAfterMs(null, "try again in 3 s")).toBe(3000);
//   expect(upstreamRetryAfterMs(null, "nothing here")).toBeUndefined();
// });
fn test_backoff_honors_retry_after() -> i32 {
    let ctx = TestCtx { failures: 0 };
    expect_eq_u64(&ctx, upstreamRetryDelayMs(0, false, 0), 500);
    expect_eq_u64(&ctx, upstreamRetryDelayMs(1, false, 0), 1000);
    expect_eq_u64(&ctx, upstreamRetryDelayMs(99, false, 0), 10000);
    expect_eq_u64(&ctx, upstreamRetryDelayMs(0, true, 250), 250);
    // DEFECT: Headers constructor (new Headers({ "retry-after": "2" })) | headers supplied as flattened text (see responses.sla upstreamRetryAfterMs DEFECT); expected result 2000.
    // upstreamRetryAfterMs(headers_text "retry-after: 2", no body) -> has, 2000
    // upstreamRetryAfterMs(no headers, body "try again in 3 s") -> has, 3000
    // upstreamRetryAfterMs(no headers, body "nothing here") -> undefined (has = false)
    return ctx.failures as i32;
}

