// DEFECT: test framework (bun:test describe/test/expect) | SLA has no test framework in this pass; each describe() below is a section comment and each test(name, fn) is a same-named fn returning i32 (0 = all its expectations held), with expect() calls approximated by the expect_* helpers here. Tests are not executed by any runner in this pass.
// DEFECT: Node imports (node:fs mkdtempSync/readFileSync/writeFileSync, node:os tmpdir, node:path join) | approximated via sa_std fs externs + manual path joins; temp dir names carry a fixed suffix instead of mkdtempSync's random one.

// ---- expect_* approximations (TS expect(x).<matcher>(y)) ----
// DEFECT: expect matchers (toEqual deep equality, toBeNull, toBe, toContain, toBeGreaterThan, toBeLessThan, toBeUndefined) | no assertion library; helpers record pass/fail into a per-test failure counter (deep toEqual on objects/arrays is approximated by JSON-text byte equality).
struct TestCtx {
    failures: u64,
}
fn expect_true(ctx: &TestCtx, cond: bool) -> void {
    if !cond { ctx.failures = ctx.failures + 1; };
}
fn expect_eq_u64(ctx: &TestCtx, actual: u64, expected: u64) -> void {
    if actual != expected { ctx.failures = ctx.failures + 1; };
}
fn expect_contains(ctx: &TestCtx, hay_ptr: ptr, hay_len: u64, needle_ptr: ptr, needle_len: u64) -> void {
    // (substring scan in the fix phase; see responses.sla text_contains_ci)
    if hay_len < needle_len { ctx.failures = ctx.failures + 1; };
}

// Captured stub-fetch request bodies (TS: const bodies: Array<Record<string, any>> = []).
// DEFECT: dynamic object array | bodies kept as JSON text buffers + count.
struct BodiesArray {
    bytes: [u8; 262144], len: u64, count: u64,
}

// DEFECT: stubbed global fetch (globalThis.fetch = async (_url, init) => {...}; ... finally { globalThis.fetch = realFetch }) | SLA has no globalThis, no assignable global fetch, no Response constructor, and no try/finally; approximated per-test by a local stub_fetch_* function with the same canned-response sequence, a calls counter, and bodies captured into a BodiesArray. Restoring the real fetch is a no-op here.
// DEFECT: async test functions (test(name, async () => {...}) with await createChainedTurn / await runPrompt) | test fns are synchronous; awaited calls use the synchronous .sla forms.

