// TS lines 88-92: test("chain rejection is detected", () => {
//   expect(isChainRejectedError(new Error("x"), 400)).toBe(true);
//   expect(isChainRejectedError(new Error("previous_response_id expired"))).toBe(true);
//   expect(isChainRejectedError(new Error("boom"), 500)).toBe(false);
// });
fn test_chain_rejection_is_detected() -> i32 {
    let ctx = TestCtx { failures: 0 };
    // DEFECT: Error objects (new Error("...")) as arguments | isChainRejectedError takes the flattened message text + flags (see responses.sla); the three calls map to ("x", is_error, has_status, 400), ("previous_response_id expired", is_error, no status), ("boom", is_error, has_status, 500).
    expect_true(&ctx, isChainRejectedError(STR_PTR("x"), STR_LEN("x"), true, true, 400));
    expect_true(&ctx, isChainRejectedError(STR_PTR("previous_response_id expired"), STR_LEN("previous_response_id expired"), true, false, 0));
    expect_true(&ctx, !isChainRejectedError(STR_PTR("boom"), STR_LEN("boom"), true, true, 500));
    return ctx.failures as i32;
}

