// Converted 1:1 from tests/server/miniAnthropicThinking.test.ts (CXU plugins, tests tree @ e113825e). Wave-2 test conversion batch 2 (AH) — SLA @test form; assertion semantics preserved 1:1 (expect(x).toEqual(y) -> field-by-field compares + panic(code) on mismatch; expect(x).toBeUndefined() -> node absent/null check).
// DEFECT: test framework | bun:test describe/test/expect has no SLA counterpart; each test() becomes one @test (describe name kept in this comment: "mini anthropic thinking effort"), each expect becomes an explicit compare (same registration class as wave-1/wave-2 test conversions).
// Mapping notes: TS thread/opts object literals -> equivalent JSON text parsed via the product's mb_parse into sa_json doc handles (the product SLA form of miniChatThreadToAnthropicBody). TS effort === undefined -> the effort key is omitted from the opts JSON. TS tools: [] -> "tools":[].
@import "sa_std/encoding/json.sai"
@import "sa_std/string.sa"
@import "sa_std/ptr.sa"
@import "../../backends/mini/src/runtime/miniBridge.sla"

fn mat_run(model_ptr: ptr, model_len: u64, has_effort: bool, eff_ptr: ptr, eff_len: u64, omit: bool, disable: bool, out: &u64) {
    let oj = MbJson { bytes: [0u8; 262144], len: 0 };
    mb_jappend(&oj, STR_PTR("{\"model\":\""), STR_LEN("{\"model\":\""));
    mb_jappend(&oj, model_ptr, model_len);
    mb_jappend(&oj, STR_PTR("\",\"tools\":[]"), STR_LEN("\",\"tools\":[]"));
    if has_effort {
        mb_jappend(&oj, STR_PTR(",\"effort\":\""), STR_LEN(",\"effort\":\""));
        mb_jappend(&oj, eff_ptr, eff_len);
        mb_jappend(&oj, STR_PTR("\""), STR_LEN("\""));
    };
    if omit { mb_jappend(&oj, STR_PTR(",\"omitThinking\":true"), STR_LEN(",\"omitThinking\":true")); };
    if disable { mb_jappend(&oj, STR_PTR(",\"disableThinking\":true"), STR_LEN(",\"disableThinking\":true")); };
    mb_jappend(&oj, STR_PTR("}"), STR_LEN("}"));
    let opts: u64 = mb_parse(mb_jp(&oj), oj.len);
    let thread: u64 = mb_parse(STR_PTR("[{\"role\":\"user\",\"content\":\"hi\"}]"), STR_LEN("[{\"role\":\"user\",\"content\":\"hi\"}]"));
    miniChatThreadToAnthropicBody(thread, opts, out);
}

// mode: 0 = thinking undefined, 1 = {type:"disabled"}, 2 = {type:"enabled", budget_tokens: budget}
fn mat_expect(body: u64, mode: u64, budget: i64, code: u64) {
    let th: u64 = mb_g_node(body, STR_PTR("thinking"), STR_LEN("thinking"));
    if mode == 0 {
        if th != 0 && mb_kind(th) != MB_JK_NULL { panic(code); };
        return;
    };
    if th == 0 || mb_kind(th) != MB_JK_OBJECT { panic(code); };
    let ty = MbStr { bytes: [0u8; 8192], len: 0 };
    let ok: bool = mb_g_str(th, STR_PTR("type"), STR_LEN("type"), &ty);
    if !ok { panic(code); };
    if mode == 1 {
        if !mb_s_eq(&ty, STR_PTR("disabled"), STR_LEN("disabled")) { panic(code); };
        return;
    };
    if !mb_s_eq(&ty, STR_PTR("enabled"), STR_LEN("enabled")) { panic(code); };
    let b: i64 = 0;
    let okb: bool = mb_g_i64(th, STR_PTR("budget_tokens"), STR_LEN("budget_tokens"), &b);
    if !okb { panic(code); };
    if b != budget { panic(code); };
}

fn mat_max_tokens(body: u64, want: i64, code: u64) {
    let v: i64 = 0;
    let ok: bool = mb_g_i64(body, STR_PTR("max_tokens"), STR_LEN("max_tokens"), &v);
    if !ok { panic(code); };
    if v != want { panic(code); };
}

@test "空值默认 medium：带 thinking enabled/2048"() {
    let body: u64 = 0;
    mat_run(STR_PTR("claude-sonnet-4-5"), STR_LEN("claude-sonnet-4-5"), false, STR_PTR(""), STR_LEN(""), false, false, &body);
    mat_expect(body, 2, 2048, 11);
    mat_max_tokens(body, MINI_ANTHROPIC_MAX_TOKENS(), 12);
    mat_run(STR_PTR("claude-sonnet-4-5"), STR_LEN("claude-sonnet-4-5"), true, STR_PTR(""), STR_LEN(""), false, false, &body);
    mat_expect(body, 2, 2048, 13);
    mat_max_tokens(body, MINI_ANTHROPIC_MAX_TOKENS(), 14);
    mat_run(STR_PTR("claude-sonnet-4-5"), STR_LEN("claude-sonnet-4-5"), true, STR_PTR("  "), STR_LEN("  "), false, false, &body);
    mat_expect(body, 2, 2048, 15);
    mat_max_tokens(body, MINI_ANTHROPIC_MAX_TOKENS(), 16);
    mat_run(STR_PTR("claude-sonnet-4-5"), STR_LEN("claude-sonnet-4-5"), true, STR_PTR("has space"), STR_LEN("has space"), false, false, &body);
    mat_expect(body, 2, 2048, 17);
    mat_max_tokens(body, MINI_ANTHROPIC_MAX_TOKENS(), 18);
    mat_run(STR_PTR("claude-sonnet-4-5"), STR_LEN("claude-sonnet-4-5"), true, STR_PTR("unknown-level"), STR_LEN("unknown-level"), false, false, &body);
    mat_expect(body, 2, 2048, 19);
    mat_max_tokens(body, MINI_ANTHROPIC_MAX_TOKENS(), 20);
}

@test "全档位映射对齐 8 档 + ultra 别名"() {
    let body: u64 = 0;
    mat_run(STR_PTR("claude-sonnet-4-5"), STR_LEN("claude-sonnet-4-5"), true, STR_PTR("none"), STR_LEN("none"), false, false, &body);
    mat_expect(body, 1, 0, 21);
    mat_run(STR_PTR("claude-sonnet-4-5"), STR_LEN("claude-sonnet-4-5"), true, STR_PTR("minimal"), STR_LEN("minimal"), false, false, &body);
    mat_expect(body, 2, 1024, 22);
    mat_run(STR_PTR("claude-sonnet-4-5"), STR_LEN("claude-sonnet-4-5"), true, STR_PTR("low"), STR_LEN("low"), false, false, &body);
    mat_expect(body, 2, 1024, 23);
    mat_run(STR_PTR("claude-sonnet-4-5"), STR_LEN("claude-sonnet-4-5"), true, STR_PTR("medium"), STR_LEN("medium"), false, false, &body);
    mat_expect(body, 2, 2048, 24);
    mat_run(STR_PTR("claude-sonnet-4-5"), STR_LEN("claude-sonnet-4-5"), true, STR_PTR("high"), STR_LEN("high"), false, false, &body);
    mat_expect(body, 2, 4096, 25);
    mat_run(STR_PTR("claude-sonnet-4-5"), STR_LEN("claude-sonnet-4-5"), true, STR_PTR("xhigh"), STR_LEN("xhigh"), false, false, &body);
    mat_expect(body, 2, 8192, 26);
    mat_run(STR_PTR("claude-sonnet-4-5"), STR_LEN("claude-sonnet-4-5"), true, STR_PTR("ultra"), STR_LEN("ultra"), false, false, &body);
    mat_expect(body, 2, 8192, 27);
    mat_run(STR_PTR("claude-sonnet-4-5"), STR_LEN("claude-sonnet-4-5"), true, STR_PTR("max"), STR_LEN("max"), false, false, &body);
    mat_expect(body, 2, 8192, 28);
    mat_run(STR_PTR("claude-sonnet-4-5"), STR_LEN("claude-sonnet-4-5"), true, STR_PTR(" XHigh "), STR_LEN(" XHigh "), false, false, &body);
    mat_expect(body, 2, 8192, 29);
}

@test "xhigh/ultra/max 拉高 max_tokens 到 budget+2048"() {
    let body: u64 = 0;
    mat_run(STR_PTR("claude-sonnet-4-5"), STR_LEN("claude-sonnet-4-5"), true, STR_PTR("ultra"), STR_LEN("ultra"), false, false, &body);
    mat_max_tokens(body, 10240, 31);
}

@test "haiku 非 high/xhigh 保持 disabled，high 仍 enabled"() {
    let body: u64 = 0;
    mat_run(STR_PTR("claude-haiku-4-5"), STR_LEN("claude-haiku-4-5"), true, STR_PTR("medium"), STR_LEN("medium"), false, false, &body);
    mat_expect(body, 1, 0, 41);
    mat_run(STR_PTR("claude-haiku-4-5"), STR_LEN("claude-haiku-4-5"), true, STR_PTR("high"), STR_LEN("high"), false, false, &body);
    mat_expect(body, 2, 4096, 42);
}

@test "omitThinking/disableThinking 语义不变"() {
    let body: u64 = 0;
    mat_run(STR_PTR("claude-sonnet-4-5"), STR_LEN("claude-sonnet-4-5"), true, STR_PTR("high"), STR_LEN("high"), true, false, &body);
    mat_expect(body, 0, 0, 51);
    mat_run(STR_PTR("claude-sonnet-4-5"), STR_LEN("claude-sonnet-4-5"), true, STR_PTR("high"), STR_LEN("high"), false, true, &body);
    mat_expect(body, 1, 0, 52);
}

@test "非 Claude 模型走 Anthropic 协议时保持旧语义"() {
    let body: u64 = 0;
    mat_run(STR_PTR("gpt-5.4"), STR_LEN("gpt-5.4"), false, STR_PTR(""), STR_LEN(""), false, false, &body);
    mat_expect(body, 0, 0, 61);
    mat_run(STR_PTR("gpt-5.4"), STR_LEN("gpt-5.4"), true, STR_PTR(""), STR_LEN(""), false, false, &body);
    mat_expect(body, 0, 0, 62);
    mat_run(STR_PTR("gpt-5.4"), STR_LEN("gpt-5.4"), true, STR_PTR("ultra"), STR_LEN("ultra"), false, false, &body);
    mat_expect(body, 0, 0, 63);
    mat_run(STR_PTR("gpt-5.4"), STR_LEN("gpt-5.4"), true, STR_PTR("max"), STR_LEN("max"), false, false, &body);
    mat_expect(body, 0, 0, 64);
    mat_run(STR_PTR("gpt-5.4"), STR_LEN("gpt-5.4"), true, STR_PTR("minimal"), STR_LEN("minimal"), false, false, &body);
    mat_expect(body, 0, 0, 65);
    mat_run(STR_PTR("gpt-5.4"), STR_LEN("gpt-5.4"), true, STR_PTR("low"), STR_LEN("low"), false, false, &body);
    mat_expect(body, 1, 0, 66);
    mat_run(STR_PTR("gpt-5.4"), STR_LEN("gpt-5.4"), true, STR_PTR("none"), STR_LEN("none"), false, false, &body);
    mat_expect(body, 1, 0, 67);
    mat_run(STR_PTR("gpt-5.4"), STR_LEN("gpt-5.4"), true, STR_PTR("medium"), STR_LEN("medium"), false, false, &body);
    mat_expect(body, 2, 2048, 68);
    mat_run(STR_PTR("gpt-5.4"), STR_LEN("gpt-5.4"), true, STR_PTR("high"), STR_LEN("high"), false, false, &body);
    mat_expect(body, 2, 4096, 69);
}
