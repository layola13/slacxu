// Converted 1:1 from tests/server/miniDeepkeyChannel.test.ts (CXU plugins, tests tree @ e113825e). Wave-2 test conversion batch 2 (AH) — SLA @test form; assertion semantics preserved 1:1 (expect(x).toBe(y) -> explicit compare + panic(code) on mismatch).
// DEFECT: test framework | bun:test test/expect has no SLA counterpart; each test() becomes one @test, each expect becomes an explicit compare (same registration class as wave-1/wave-2 test conversions).
// Mapping notes: TS array/object literals -> equivalent JSON text parsed via the product's mb_parse into sa_json doc handles (the product SLA form of these functions). TS EMPTY_MINI_RESPONSES_CHAIN -> product mb_empty_responses_chain (prevId null, sentJson "", sentCount 0 — same shape).
@import "sa_std/encoding/json.sai"
@import "sa_std/string.sa"
@import "../../backends/mini/src/runtime/miniBridge.sla"

fn mdc_strict(base_ptr: ptr, base_len: u64, prov_ptr: ptr, prov_len: u64, grp_ptr: ptr, grp_len: u64, want: bool, code: u64) {
    let got: bool = isMiniStrictAssistantUpstream(base_ptr, base_len, prov_ptr, prov_len, grp_ptr, grp_len);
    if got != want { panic(code); };
}

fn mdc_part_type(doc: u64, idx: u64, want_ptr: ptr, want_len: u64, code: u64) {
    let item: u64 = mb_a_at(doc, idx);
    let content: u64 = mb_g_node(item, STR_PTR("content"), STR_LEN("content"));
    let part: u64 = mb_a_at(content, 0);
    let ty = MbStr { bytes: [0u8; 8192], len: 0 };
    let ok: bool = mb_g_str(part, STR_PTR("type"), STR_LEN("type"), &ty);
    if !ok { panic(code); };
    if !mb_s_eq(&ty, want_ptr, want_len) { panic(code); };
}

fn mdc_part_text(doc: u64, idx: u64, want_ptr: ptr, want_len: u64, code: u64) {
    let item: u64 = mb_a_at(doc, idx);
    let content: u64 = mb_g_node(item, STR_PTR("content"), STR_LEN("content"));
    let part: u64 = mb_a_at(content, 0);
    let tx = MbStr { bytes: [0u8; 8192], len: 0 };
    let ok: bool = mb_g_str(part, STR_PTR("text"), STR_LEN("text"), &tx);
    if !ok { panic(code); };
    if !mb_s_eq(&tx, want_ptr, want_len) { panic(code); };
}

@test "deepkey/gpt-6.1-sol channel is lenient, opencode stays strict"() {
    mdc_strict(STR_PTR("https://opencode.ai/api"), STR_LEN("https://opencode.ai/api"), STR_PTR("x"), STR_LEN("x"), STR_PTR("y"), STR_LEN("y"), true, 11);
    mdc_strict(STR_PTR("https://any"), STR_LEN("https://any"), STR_PTR("opencode"), STR_LEN("opencode"), STR_PTR("g"), STR_LEN("g"), true, 12);
    mdc_strict(STR_PTR("https://any"), STR_LEN("https://any"), STR_PTR("p"), STR_LEN("p"), STR_PTR("opencode-free"), STR_LEN("opencode-free"), true, 13);
    mdc_strict(STR_PTR("https://deepkey.top/v1"), STR_LEN("https://deepkey.top/v1"), STR_PTR("deepkey"), STR_LEN("deepkey"), STR_PTR("group-1791018008525-f6ej"), STR_LEN("group-1791018008525-f6ej"), false, 14);
    mdc_strict(STR_PTR("https://deepkey.top/v1"), STR_LEN("https://deepkey.top/v1"), STR_PTR("deepkey"), STR_LEN("deepkey"), STR_PTR("default"), STR_LEN("default"), false, 15);
}

@test "relax converts assistant output_text to input_text, leaves the rest"() {
    let input: u64 = mb_parse(STR_PTR("[{\"role\":\"user\",\"content\":[{\"type\":\"input_text\",\"text\":\"最近改了什么？\"}]},{\"role\":\"assistant\",\"content\":[{\"type\":\"output_text\",\"text\":\"reply\"}]},{\"role\":\"assistant\",\"content\":[{\"type\":\"input_text\",\"text\":\"already lenient\"}]},{\"type\":\"function_call\",\"call_id\":\"c1\",\"name\":\"sa_vm\",\"arguments\":\"{}\"},{\"type\":\"function_call_output\",\"call_id\":\"c1\",\"output\":\"ok\"}]"), STR_LEN("[{\"role\":\"user\",\"content\":[{\"type\":\"input_text\",\"text\":\"最近改了什么？\"}]},{\"role\":\"assistant\",\"content\":[{\"type\":\"output_text\",\"text\":\"reply\"}]},{\"role\":\"assistant\",\"content\":[{\"type\":\"input_text\",\"text\":\"already lenient\"}]},{\"type\":\"function_call\",\"call_id\":\"c1\",\"name\":\"sa_vm\",\"arguments\":\"{}\"},{\"type\":\"function_call_output\",\"call_id\":\"c1\",\"output\":\"ok\"}]"));
    if input == 0 { panic(20); };
    let out: u64 = 0;
    relaxMiniResponsesAssistantText(input, &out);
    mdc_part_type(out, 1, STR_PTR("input_text"), STR_LEN("input_text"), 21);
    mdc_part_text(out, 1, STR_PTR("reply"), STR_LEN("reply"), 22);
    mdc_part_type(out, 0, STR_PTR("input_text"), STR_LEN("input_text"), 23);
    mdc_part_type(out, 2, STR_PTR("input_text"), STR_LEN("input_text"), 24);
    let item3: u64 = mb_a_at(out, 3);
    let ty3 = MbStr { bytes: [0u8; 8192], len: 0 };
    let ok3: bool = mb_g_str(item3, STR_PTR("type"), STR_LEN("type"), &ty3);
    if !ok3 { panic(25); };
    if !mb_s_eq(&ty3, STR_PTR("function_call"), STR_LEN("function_call")) { panic(25); };
    mdc_part_type(input, 1, STR_PTR("output_text"), STR_LEN("output_text"), 26);
}

@test "deepkey round input keeps chain stable after relax"() {
    let input: u64 = mb_parse(STR_PTR("[{\"role\":\"user\",\"content\":[{\"type\":\"input_text\",\"text\":\"hi\"}]},{\"role\":\"assistant\",\"content\":[{\"type\":\"output_text\",\"text\":\"reply\"}]}]"), STR_LEN("[{\"role\":\"user\",\"content\":[{\"type\":\"input_text\",\"text\":\"hi\"}]},{\"role\":\"assistant\",\"content\":[{\"type\":\"output_text\",\"text\":\"reply\"}]}]"));
    if input == 0 { panic(30); };
    let sanitized: u64 = 0;
    sanitizeMiniResponsesInput(input, &sanitized);
    let relaxed: u64 = 0;
    relaxMiniResponsesAssistantText(sanitized, &relaxed);
    mdc_part_type(sanitized, 1, STR_PTR("output_text"), STR_LEN("output_text"), 31);
    mdc_part_type(relaxed, 1, STR_PTR("input_text"), STR_LEN("input_text"), 32);
    let chain: u64 = 0;
    mb_empty_responses_chain(&chain);
    let round: u64 = 0;
    resolveResponsesRoundInput(relaxed, chain, &round);
    let chained: bool = true;
    let okc: bool = mb_g_bool(round, STR_PTR("chained"), STR_LEN("chained"), &chained);
    if !okc { panic(33); };
    if chained { panic(33); };
    let prev: u64 = mb_g_node(round, STR_PTR("previousResponseId"), STR_LEN("previousResponseId"));
    if mb_kind(prev) != MB_JK_NULL { panic(34); };
    let rin: u64 = mb_g_node(round, STR_PTR("input"), STR_LEN("input"));
    if mb_n_count(rin) != 2 { panic(35); };
}
