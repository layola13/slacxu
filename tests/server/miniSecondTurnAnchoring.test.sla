// Converted 1:1 from tests/server/miniSecondTurnAnchoring.test.ts (CXU plugins, tests tree @ e113825e). Wave-2 test conversion batch 2 (AH) — SLA @test form; assertion semantics preserved 1:1 (expect(x).toContain(y) -> substring scan + panic(code) on mismatch; expect(x).not.toContain(y) -> absence check + panic(code)).
// DEFECT: test framework | bun:test describe/test/expect has no SLA counterpart; each test() becomes one @test (describe name kept in this comment: "mini second-turn anchoring"), each expect becomes an explicit compare (same registration class as wave-1/wave-2 test conversions).
// Mapping notes: TS message/line arrays -> equivalent JSON text parsed via the product's mb_parse into sa_json doc handles (the product SLA form of these functions). TS buildMiniHistoryPayload(lines, protocol) uses default maxChars = MINI_HISTORY_MAX_CHARS = 24000 (miniBridge.ts:790) — passed explicitly here. The TS protocol loop (["chat","responses"]) is unrolled into sequential blocks with identical assertions.
@import "sa_std/encoding/json.sai"
@import "sa_std/string.sa"
@import "../../backends/mini/src/runtime/miniBridge.sla"

fn msa_contains(p: ptr, n: u64, needle_ptr: ptr, needle_len: u64, code: u64) {
    if !mb_contains(p, n, needle_ptr, needle_len) { panic(code); };
}

fn msa_not_contains(p: ptr, n: u64, needle_ptr: ptr, needle_len: u64, code: u64) {
    if mb_contains(p, n, needle_ptr, needle_len) { panic(code); };
}

fn msa_payload_block(lines: u64, proto_ptr: ptr, proto_len: u64, block: &MbStr, recap: &MbStr, has_recap: &bool) {
    let payload = MbJson { bytes: [0u8; 262144], len: 0 };
    buildMiniHistoryPayload(lines, proto_ptr, proto_len, 24000, &payload);
    let doc: u64 = mb_parse(mb_jp(&payload), payload.len);
    let okb: bool = mb_g_str(doc, STR_PTR("historyBlock"), STR_LEN("historyBlock"), block);
    if !okb { panic(90); };
    *has_recap = mb_g_str(doc, STR_PTR("recapText"), STR_LEN("recapText"), recap);
}

@test "turn-2 history keeps task-1 evidence but frames it as completed background"() {
    let messages: u64 = mb_parse(STR_PTR("[{\"type\":\"userMessage\",\"id\":\"mini-user-t1\",\"turnId\":\"t1\",\"threadId\":\"th\",\"text\":\"TASK ONE: paint the fence red\",\"role\":\"user\",\"status\":\"completed\"},{\"type\":\"toolCall\",\"id\":\"mini-tool-t1-c1\",\"turnId\":\"t1\",\"threadId\":\"th\",\"name\":\"sa_vm\",\"arguments\":\"{\\\"action\\\":\\\"read_file\\\",\\\"path\\\":\\\"fence.txt\\\"}\",\"output\":\"fence is blue\",\"status\":\"completed\"},{\"type\":\"agentMessage\",\"id\":\"mini-msg-t1\",\"turnId\":\"t1\",\"threadId\":\"th\",\"text\":\"Painted the fence red, verified by reading fence.txt.\"}]"), STR_LEN("[{\"type\":\"userMessage\",\"id\":\"mini-user-t1\",\"turnId\":\"t1\",\"threadId\":\"th\",\"text\":\"TASK ONE: paint the fence red\",\"role\":\"user\",\"status\":\"completed\"},{\"type\":\"toolCall\",\"id\":\"mini-tool-t1-c1\",\"turnId\":\"t1\",\"threadId\":\"th\",\"name\":\"sa_vm\",\"arguments\":\"{\\\"action\\\":\\\"read_file\\\",\\\"path\\\":\\\"fence.txt\\\"}\",\"output\":\"fence is blue\",\"status\":\"completed\"},{\"type\":\"agentMessage\",\"id\":\"mini-msg-t1\",\"turnId\":\"t1\",\"threadId\":\"th\",\"text\":\"Painted the fence red, verified by reading fence.txt.\"}]"));
    if messages == 0 { panic(10); };
    let lines: u64 = 0;
    miniHistoryLinesFromMessages(messages, STR_PTR("t2"), STR_LEN("t2"), 0, &lines);
    let joined = MbJson { bytes: [0u8; 262144], len: 0 };
    mb_lines_join(lines, &joined);
    msa_contains(mb_jp(&joined), joined.len, STR_PTR("TASK ONE"), STR_LEN("TASK ONE"), 11);
    msa_contains(mb_jp(&joined), joined.len, STR_PTR("fence is blue"), STR_LEN("fence is blue"), 12);
    let block_c = MbStr { bytes: [0u8; 8192], len: 0 };
    let recap_c = MbStr { bytes: [0u8; 8192], len: 0 };
    let has_recap_c: bool = false;
    msa_payload_block(lines, STR_PTR("chat"), STR_LEN("chat"), &block_c, &recap_c, &has_recap_c);
    msa_contains(mb_sp(&block_c), block_c.len, STR_PTR("background context"), STR_LEN("background context"), 13);
    msa_contains(mb_sp(&block_c), block_c.len, STR_PTR("the latest user message below is the current task"), STR_LEN("the latest user message below is the current task"), 14);
    msa_not_contains(mb_sp(&block_c), block_c.len, STR_PTR("MUST respect"), STR_LEN("MUST respect"), 15);
    let block_r = MbStr { bytes: [0u8; 8192], len: 0 };
    let recap_r = MbStr { bytes: [0u8; 8192], len: 0 };
    let has_recap_r: bool = false;
    msa_payload_block(lines, STR_PTR("responses"), STR_LEN("responses"), &block_r, &recap_r, &has_recap_r);
    msa_contains(mb_sp(&block_r), block_r.len, STR_PTR("background context"), STR_LEN("background context"), 16);
    msa_contains(mb_sp(&block_r), block_r.len, STR_PTR("the latest user message below is the current task"), STR_LEN("the latest user message below is the current task"), 17);
    msa_not_contains(mb_sp(&block_r), block_r.len, STR_PTR("MUST respect"), STR_LEN("MUST respect"), 18);
    if !has_recap_r { panic(19); };
    msa_contains(mb_sp(&recap_r), recap_r.len, STR_PTR("background context only"), STR_LEN("background context only"), 20);
}

@test "verbatim first-user pin is labeled handled background, not new orders"() {
    let lines: u64 = mb_parse(STR_PTR("[\"user: TASK ONE: paint the fence red\",\"assistant: done\"]"), STR_LEN("[\"user: TASK ONE: paint the fence red\",\"assistant: done\"]"));
    if lines == 0 { panic(30); };
    let pinned: u64 = 0;
    pinMiniHistoryUserLines(lines, 1000, &pinned);
    let pj = MbJson { bytes: [0u8; 262144], len: 0 };
    mb_lines_join(pinned, &pj);
    msa_contains(mb_jp(&pj), pj.len, STR_PTR("user: TASK ONE: paint the fence red"), STR_LEN("user: TASK ONE: paint the fence red"), 31);
    let empty1: u64 = mb_parse(STR_PTR("[]"), STR_LEN("[]"));
    let empty2: u64 = mb_parse(STR_PTR("[]"), STR_LEN("[]"));
    let out: u64 = 0;
    assembleMiniSummarizedHistory(STR_PTR("S"), STR_LEN("S"), pinned, empty1, empty2, &out);
    let oj = MbJson { bytes: [0u8; 262144], len: 0 };
    mb_lines_join(out, &oj);
    msa_contains(mb_jp(&oj), oj.len, STR_PTR("already covered"), STR_LEN("already covered"), 32);
    msa_contains(mb_jp(&oj), oj.len, STR_PTR("background context"), STR_LEN("background context"), 33);
}

@test "stale plan reminder yields to a fresh unrelated user task"() {
    let steps: u64 = mb_parse(STR_PTR("[{\"step\":\"paint the fence\",\"status\":\"in_progress\"}]"), STR_LEN("[{\"step\":\"paint the fence\",\"status\":\"in_progress\"}]"));
    if steps == 0 { panic(40); };
    let note = MbJson { bytes: [0u8; 262144], len: 0 };
    let is_null: bool = true;
    miniPendingPlanReminder(steps, &note, &is_null);
    if is_null { panic(41); };
    msa_contains(mb_jp(&note), note.len, STR_PTR("follow the user message instead"), STR_LEN("follow the user message instead"), 42);
}
