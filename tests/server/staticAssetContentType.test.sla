@import "sa_std/string.sa"
@import "sa_std/ptr.sa"
@import "../../apps/server/src/staticAssetContentType.sla"

fn sact_expect(path_ptr: ptr, path_len: u64, want_ptr: ptr, want_len: u64, code: u64) {
    let op: ptr = PTR_NULL();
    let ol: u64 = 0;
    let found: bool = false;
    staticAssetContentType(path_ptr, path_len, &op, &ol, &found);
    if !found { panic(code); };
    if ol != want_len { panic(code); };
    let i: u64 = 0;
    while i < ol {
        let a: u8 = 0;
        let b: u8 = 0;
        PTR_BYTE_AT(a, op, i);
        PTR_BYTE_AT(b, want_ptr, i);
        if a != b { panic(code); };
        i = i + 1;
    }
}

fn sact_expect_null(path_ptr: ptr, path_len: u64, code: u64) {
    let op: ptr = PTR_NULL();
    let ol: u64 = 0;
    let found: bool = false;
    staticAssetContentType(path_ptr, path_len, &op, &ol, &found);
    if found { panic(code); };
}

@test "serves SVG and common web assets with browser-compatible content types"() {
    sact_expect(STR_PTR("icons/codex-color.svg"), STR_LEN("icons/codex-color.svg"), STR_PTR("image/svg+xml; charset=utf-8"), STR_LEN("image/svg+xml; charset=utf-8"), 11);
    sact_expect(STR_PTR("assets/main.js"), STR_LEN("assets/main.js"), STR_PTR("application/javascript; charset=utf-8"), STR_LEN("application/javascript; charset=utf-8"), 12);
    sact_expect(STR_PTR("assets/font.woff2"), STR_LEN("assets/font.woff2"), STR_PTR("font/woff2"), STR_LEN("font/woff2"), 13);
}

@test "does not guess unknown static asset content types"() {
    sact_expect_null(STR_PTR("asset.unknown"), STR_LEN("asset.unknown"), 21);
}
