// Converted 1:1 from tests/server/effectiveGroupBaseUrl.test.ts (CXU plugins, tests tree @ e113825e). Wave-2 test conversion batch 2 (AH) — SLA @test form; assertion semantics preserved 1:1 (expect(x).toBe(y) -> explicit compare + panic(code) on mismatch; expect(x).toBeNull() -> found == false).
// DEFECT: test framework | bun:test test/expect has no SLA counterpart; each test() becomes one @test, each expect becomes an explicit compare (same registration class as wave-1/wave-2 test conversions).
// Mapping notes: TS group/Headers objects -> the product SLA's rpg_JsonBuf JSON-text model: withEffectiveGroupBaseUrl reads the group doc's "baseUrl" field; resolveThreadStableSessionId reads a {"headers":{...}} doc (product rpg_header_trimmed); resolveOpenCodeBackendUserAgent reads the hint at the doc root (product body). TS reference-identity assertions (filled !== group; result === group) have no SLA counterpart for the copy-out form — they are represented by the semantic equivalents asserted here (output baseUrl filled while the input buffer stays byte-identical; output text equal to input text for the identity cases) and registered in this note. TS OPENCODE_BACKEND_USER_AGENTS.claude/.openclaude are the sdk constants "codex-ultra-claude/1.0" / "codex-ultra-openclaude/1.0" (sdk-backend/src/openCodeSessionProtocol.sla:33-34, matching the .ts values). The product UA fn consults env OPENCODE_USER_AGENT first; the test environment must not set it (the canonical gate env does not).
@import "sa_std/encoding/json.sai"
@import "sa_std/string.sa"
@import "sa_std/ptr.sa"
@import "../../backends/relay-config/src/relay/relayProtocolGateway.sla"

fn egb_jb(lit_ptr: ptr, lit_len: u64, out: &rpg_JsonBuf) {
    rpg_jb_assign(out, lit_ptr, lit_len);
}

fn egb_contains(p: ptr, n: u64, needle_ptr: ptr, needle_len: u64) -> bool {
    if n < needle_len { return false; };
    let last: u64 = n - needle_len;
    let i: u64 = 0;
    while i <= last {
        let ok: bool = true;
        let j: u64 = 0;
        while j < needle_len {
            let x: u8 = 0;
            let y: u8 = 0;
            PTR_BYTE_AT(x, p, i + j);
            PTR_BYTE_AT(y, needle_ptr, j);
            if x != y { ok = false; break; };
            j = j + 1;
        }
        if ok { return true; };
        i = i + 1;
    }
    return false;
}

fn egb_base_url(jb: &rpg_JsonBuf, out: &RpgStr) -> bool {
    let doc: u64 = rpg_jb_doc(jb);
    if doc == 0 { return false; };
    let ok: bool = jg_str(doc, STR_PTR("baseUrl"), STR_LEN("baseUrl"), out);
    rpg_free_doc(doc);
    return ok;
}

@test "withEffectiveGroupBaseUrl fills a missing group baseUrl from the provider"() {
    let group = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
    egb_jb(STR_PTR("{\"id\":\"go\",\"baseUrl\":null}"), STR_LEN("{\"id\":\"go\",\"baseUrl\":null}"), &group);
    let before: u64 = group.len;
    let filled = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
    withEffectiveGroupBaseUrl(&group, STR_PTR("https://opencode.ai/zen/go/v1"), STR_LEN("https://opencode.ai/zen/go/v1"), true, &filled);
    let url = RpgStr { bytes: [0u8; 8192], len: 0 };
    if !egb_base_url(&filled, &url) { panic(11); };
    if !rpg_rs_eq(&url, STR_PTR("https://opencode.ai/zen/go/v1"), STR_LEN("https://opencode.ai/zen/go/v1")) { panic(11); };
    if group.len != before { panic(12); };
    if !egb_contains(rpg_jb_ptr(&group), group.len, STR_PTR("\"baseUrl\":null"), STR_LEN("\"baseUrl\":null")) { panic(12); };
}

@test "withEffectiveGroupBaseUrl keeps group override and empty fallbacks"() {
    let group = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
    egb_jb(STR_PTR("{\"id\":\"default\",\"baseUrl\":\"http://127.0.0.1:4096\"}"), STR_LEN("{\"id\":\"default\",\"baseUrl\":\"http://127.0.0.1:4096\"}"), &group);
    let out = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
    withEffectiveGroupBaseUrl(&group, STR_PTR("https://opencode.ai/zen/go/v1"), STR_LEN("https://opencode.ai/zen/go/v1"), true, &out);
    let url = RpgStr { bytes: [0u8; 8192], len: 0 };
    if !egb_base_url(&out, &url) { panic(21); };
    if !rpg_rs_eq(&url, STR_PTR("http://127.0.0.1:4096"), STR_LEN("http://127.0.0.1:4096")) { panic(21); };
    let bare = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
    egb_jb(STR_PTR("{\"id\":\"x\"}"), STR_LEN("{\"id\":\"x\"}"), &bare);
    let out2 = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
    withEffectiveGroupBaseUrl(&bare, STR_PTR(""), STR_LEN(""), false, &out2);
    if egb_base_url(&out2, &url) { panic(22); };
    let out3 = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
    withEffectiveGroupBaseUrl(&bare, STR_PTR("  "), STR_LEN("  "), true, &out3);
    if egb_base_url(&out3, &url) { panic(23); };
}

@test "resolveThreadStableSessionId prefers session-id, then thread-id"() {
    let empty = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
    let out = RpgStr { bytes: [0u8; 8192], len: 0 };
    if resolveThreadStableSessionId(&empty, &out) { panic(31); };
    let hdrs = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
    egb_jb(STR_PTR("{\"headers\":{}}"), STR_LEN("{\"headers\":{}}"), &hdrs);
    if resolveThreadStableSessionId(&hdrs, &out) { panic(32); };
    egb_jb(STR_PTR("{\"headers\":{\"thread-id\":\"t-1\"}}"), STR_LEN("{\"headers\":{\"thread-id\":\"t-1\"}}"), &hdrs);
    if !resolveThreadStableSessionId(&hdrs, &out) { panic(33); };
    if !rpg_rs_eq(&out, STR_PTR("t-1"), STR_LEN("t-1")) { panic(33); };
    egb_jb(STR_PTR("{\"headers\":{\"session-id\":\"s-9\",\"thread-id\":\"t-1\"}}"), STR_LEN("{\"headers\":{\"session-id\":\"s-9\",\"thread-id\":\"t-1\"}}"), &hdrs);
    if !resolveThreadStableSessionId(&hdrs, &out) { panic(34); };
    if !rpg_rs_eq(&out, STR_PTR("s-9"), STR_LEN("s-9")) { panic(34); };
}

@test "resolveOpenCodeBackendUserAgent maps the bridge hint to a dedicated UA"() {
    let empty = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
    let out = RpgStr { bytes: [0u8; 8192], len: 0 };
    if resolveOpenCodeBackendUserAgent(&empty, &out) { panic(41); };
    let hdrs = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
    egb_jb(STR_PTR("{}"), STR_LEN("{}"), &hdrs);
    if resolveOpenCodeBackendUserAgent(&hdrs, &out) { panic(42); };
    egb_jb(STR_PTR("{\"x-codex-cli-backend\":\"codex\"}"), STR_LEN("{\"x-codex-cli-backend\":\"codex\"}"), &hdrs);
    if resolveOpenCodeBackendUserAgent(&hdrs, &out) { panic(43); };
    egb_jb(STR_PTR("{\"x-codex-cli-backend\":\"claude\"}"), STR_LEN("{\"x-codex-cli-backend\":\"claude\"}"), &hdrs);
    if !resolveOpenCodeBackendUserAgent(&hdrs, &out) { panic(44); };
    if !rpg_rs_eq(&out, STR_PTR("codex-ultra-claude/1.0"), STR_LEN("codex-ultra-claude/1.0")) { panic(44); };
    egb_jb(STR_PTR("{\"x-codex-cli-backend\":\"OpenClaude\"}"), STR_LEN("{\"x-codex-cli-backend\":\"OpenClaude\"}"), &hdrs);
    if !resolveOpenCodeBackendUserAgent(&hdrs, &out) { panic(45); };
    if !rpg_rs_eq(&out, STR_PTR("codex-ultra-openclaude/1.0"), STR_LEN("codex-ultra-openclaude/1.0")) { panic(45); };
}
