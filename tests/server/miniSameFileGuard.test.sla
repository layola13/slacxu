// Converted 1:1 from tests/server/miniSameFileGuard.test.ts (CXU plugins, tests tree @ e113825e). Wave-2 test conversion batch 2 (AH) — SLA @test form; assertion semantics preserved 1:1 (expect(x).toBeNull() -> out_is_null check + panic(code); expect(x).toBe("a.ts") -> out text compare + panic(code)).
// DEFECT: test framework | bun:test describe/test/expect has no SLA counterpart; each test() becomes one @test (describe name kept in this comment: "MiniSameFileReadGuard pagination"), each expect becomes an explicit compare (same registration class as wave-1/wave-2 test conversions).
// NOTE: product body backends/mini/src/runtime/miniTurnSafety.sla is a bulk-conversion skeleton (its own header: "Bulk conversion pass — defects logged, not yet fixed"): MiniSameFileReadGuard_observeRound's loop body is comment-only and always reports null, isMiniSameFileReadAction is a preset `return false`, extractMiniReadFileKeys is a preset 0-count (also registered by Agent AA as a miniBridge sibling stub). Assertions are converted as written in TS and are expected to expose that skeleton — the test is NOT adjusted to it.
// Mapping notes: TS readRound() result objects -> product MiniToolRoundResult values (name "sa_vm", args as JSON text, output text). TS MINI_REFUSED_READ_PREFIX = "blocked: same-file read refused" (product keeps it as a comment literal, miniTurnSafety.sla:10). TS MINI_SAME_FILE_READ_LIMIT = product MINI_SAME_FILE_READ_LIMIT() = 2. The product observeRound takes a (&result, count) pair; the TS two-result round in "metadata probes" is fed as two consecutive one-result rounds — grouping is immaterial for metadata actions (never counted in either form) and is registered here.
@import "sa_std/string.sa"
@import "sa_std/ptr.sa"
@import "../../backends/mini/src/runtime/miniTurnSafety.sla"

fn msg_result(name_ptr: ptr, name_len: u64, args_ptr: ptr, args_len: u64, out_ptr: ptr, out_len: u64) -> MiniToolRoundResult {
    let r = MiniToolRoundResult { name: [0u8; 128], name_len: 0, args_json: [0u8; 16384], args_json_len: 0, output: [0u8; 65536], output_len: 0 };
    let nn: u64 = name_len;
    if nn > 128 { nn = 128; };
    let i: u64 = 0;
    while i < nn {
        let b: u8 = 0;
        PTR_BYTE_AT(b, name_ptr, i);
        r.name[i] = b;
        i = i + 1;
    }
    r.name_len = nn;
    let an: u64 = args_len;
    if an > 16384 { an = 16384; };
    i = 0;
    while i < an {
        let b: u8 = 0;
        PTR_BYTE_AT(b, args_ptr, i);
        r.args_json[i] = b;
        i = i + 1;
    }
    r.args_json_len = an;
    let on: u64 = out_len;
    if on > 65536 { on = 65536; };
    i = 0;
    while i < on {
        let b: u8 = 0;
        PTR_BYTE_AT(b, out_ptr, i);
        r.output[i] = b;
        i = i + 1;
    }
    r.output_len = on;
    return r;
}

fn msg_guard() -> MiniSameFileReadGuard {
    return MiniSameFileReadGuard { states_keys: [0u8; 65536], states_key_lens: [0u64; 256], states: [MiniFileReadState { overlaps: 0, lastStart: 0, lastStart_is_null: true, lastEnd: 0, lastEnd_is_null: true }; 256], states_len: 0 };
}

fn msg_round(guard: &MiniSameFileReadGuard, res: &MiniToolRoundResult, count: u64, progress: bool, want_null: bool, want_ptr: ptr, want_len: u64, code: u64) {
    let buf = [0u8; 512];
    let bp: ptr = PTR_NULL();
    PTR_BYTE_ADD(bp, &buf, 0);
    let ol: u64 = 0;
    let is_null: bool = false;
    let rc: i32 = MiniSameFileReadGuard_observeRound(guard, res, count, progress, bp, &ol, &is_null);
    if want_null {
        if !is_null { panic(code); };
        return;
    };
    if is_null { panic(code); };
    if ol != want_len { panic(code); };
    let i: u64 = 0;
    while i < ol {
        let a: u8 = 0;
        let b: u8 = 0;
        PTR_BYTE_AT(a, bp, i);
        PTR_BYTE_AT(b, want_ptr, i);
        if a != b { panic(code); };
        i = i + 1;
    }
}

fn msg_read_round(guard: &MiniSameFileReadGuard, args_ptr: ptr, args_len: u64, want_null: bool, want_ptr: ptr, want_len: u64, code: u64) {
    let first = msg_result(STR_PTR("sa_vm"), STR_LEN("sa_vm"), args_ptr, args_len, STR_PTR("content"), STR_LEN("content"));
    msg_round(guard, &first, 1, false, want_null, want_ptr, want_len, code);
}

fn msg_round_unasserted(guard: &MiniSameFileReadGuard, args_ptr: ptr, args_len: u64, output_ptr: ptr, output_len: u64, progress: bool) {
    let first = msg_result(STR_PTR("sa_vm"), STR_LEN("sa_vm"), args_ptr, args_len, output_ptr, output_len);
    let buf = [0u8; 512];
    let bp: ptr = PTR_NULL();
    PTR_BYTE_ADD(bp, &buf, 0);
    let ol: u64 = 0;
    let is_null: bool = false;
    let rc: i32 = MiniSameFileReadGuard_observeRound(guard, &first, 1, progress, bp, &ol, &is_null);
}

@test "forward paging a 586-line file never trips the guard"() {
    let g = msg_guard();
    msg_read_round(&g, STR_PTR("{\"action\":\"read_lines\",\"path\":\"index.html\",\"start_line\":1,\"end_line\":250}"), STR_LEN("{\"action\":\"read_lines\",\"path\":\"index.html\",\"start_line\":1,\"end_line\":250}"), true, STR_PTR(""), STR_LEN(""), 11);
    msg_read_round(&g, STR_PTR("{\"action\":\"read_lines\",\"path\":\"index.html\",\"start_line\":250,\"end_line\":500}"), STR_LEN("{\"action\":\"read_lines\",\"path\":\"index.html\",\"start_line\":250,\"end_line\":500}"), true, STR_PTR(""), STR_LEN(""), 12);
    msg_read_round(&g, STR_PTR("{\"action\":\"read_lines\",\"path\":\"index.html\",\"start_line\":500,\"end_line\":586}"), STR_LEN("{\"action\":\"read_lines\",\"path\":\"index.html\",\"start_line\":500,\"end_line\":586}"), true, STR_PTR(""), STR_LEN(""), 13);
    msg_read_round(&g, STR_PTR("{\"action\":\"read_lines\",\"path\":\"index.html\",\"start_line\":586,\"end_line\":800}"), STR_LEN("{\"action\":\"read_lines\",\"path\":\"index.html\",\"start_line\":586,\"end_line\":800}"), true, STR_PTR(""), STR_LEN(""), 14);
}

@test "overlapping re-reads still trip after the limit"() {
    let g = msg_guard();
    let limit: u64 = MINI_SAME_FILE_READ_LIMIT();
    let i: u64 = 0;
    while i < limit {
        msg_read_round(&g, STR_PTR("{\"action\":\"read_lines\",\"path\":\"a.ts\",\"start_line\":1,\"end_line\":100}"), STR_LEN("{\"action\":\"read_lines\",\"path\":\"a.ts\",\"start_line\":1,\"end_line\":100}"), true, STR_PTR(""), STR_LEN(""), 21);
        i = i + 1;
    }
    msg_read_round(&g, STR_PTR("{\"action\":\"read_lines\",\"path\":\"a.ts\",\"start_line\":1,\"end_line\":100}"), STR_LEN("{\"action\":\"read_lines\",\"path\":\"a.ts\",\"start_line\":1,\"end_line\":100}"), false, STR_PTR("a.ts"), STR_LEN("a.ts"), 22);
}

@test "metadata probes do not count as thrash"() {
    let g = msg_guard();
    let limit: u64 = MINI_SAME_FILE_READ_LIMIT();
    let i: u64 = 0;
    while i < limit + 2 {
        let first = msg_result(STR_PTR("sa_vm"), STR_LEN("sa_vm"), STR_PTR("{\"action\":\"count_lines\",\"path\":\"big.ts\"}"), STR_LEN("{\"action\":\"count_lines\",\"path\":\"big.ts\"}"), STR_PTR("{}"), STR_LEN("{}"));
        msg_round(&g, &first, 1, false, true, STR_PTR(""), STR_LEN(""), 31);
        let second = msg_result(STR_PTR("sa_vm"), STR_LEN("sa_vm"), STR_PTR("{\"action\":\"file_info\",\"path\":\"big.ts\"}"), STR_LEN("{\"action\":\"file_info\",\"path\":\"big.ts\"}"), STR_PTR("{}"), STR_LEN("{}"));
        msg_round(&g, &second, 1, false, true, STR_PTR(""), STR_LEN(""), 31);
        i = i + 1;
    }
    if isMiniSameFileReadAction(STR_PTR("count_lines"), STR_LEN("count_lines"), true) { panic(32); };
    if isMiniSameFileReadAction(STR_PTR("file_info"), STR_LEN("file_info"), true) { panic(33); };
    if !isMiniSameFileReadAction(STR_PTR("read_lines"), STR_LEN("read_lines"), true) { panic(34); };
    if !isMiniSameFileReadAction(STR_PTR("read_file"), STR_LEN("read_file"), true) { panic(35); };
}

@test "refused-read outputs are not re-counted"() {
    let g = msg_guard();
    let limit: u64 = MINI_SAME_FILE_READ_LIMIT();
    let i: u64 = 0;
    while i < limit + 1 {
        msg_round_unasserted(&g, STR_PTR("{\"action\":\"read_lines\",\"path\":\"hot.ts\",\"start_line\":10,\"end_line\":60}"), STR_LEN("{\"action\":\"read_lines\",\"path\":\"hot.ts\",\"start_line\":10,\"end_line\":60}"), STR_PTR("content"), STR_LEN("content"), false);
        i = i + 1;
    }
    msg_read_round(&g, STR_PTR("{\"action\":\"read_lines\",\"path\":\"hot.ts\",\"start_line\":10,\"end_line\":60}"), STR_LEN("{\"action\":\"read_lines\",\"path\":\"hot.ts\",\"start_line\":10,\"end_line\":60}"), false, STR_PTR("hot.ts"), STR_LEN("hot.ts"), 41);
    let j: u64 = 0;
    while j < 3 {
        let first = msg_result(STR_PTR("sa_vm"), STR_LEN("sa_vm"), STR_PTR("{\"action\":\"read_lines\",\"path\":\"hot.ts\",\"start_line\":10,\"end_line\":60}"), STR_LEN("{\"action\":\"read_lines\",\"path\":\"hot.ts\",\"start_line\":10,\"end_line\":60}"), STR_PTR("blocked: same-file read refused (hot.ts): ..."), STR_LEN("blocked: same-file read refused (hot.ts): ..."));
        msg_round(&g, &first, 1, false, true, STR_PTR(""), STR_LEN(""), 42);
        j = j + 1;
    }
}

@test "write progress resets the guard"() {
    let g = msg_guard();
    let limit: u64 = MINI_SAME_FILE_READ_LIMIT();
    let i: u64 = 0;
    while i < limit {
        msg_round_unasserted(&g, STR_PTR("{\"action\":\"read_lines\",\"path\":\"w.ts\",\"start_line\":1,\"end_line\":50}"), STR_LEN("{\"action\":\"read_lines\",\"path\":\"w.ts\",\"start_line\":1,\"end_line\":50}"), STR_PTR("content"), STR_LEN("content"), false);
        i = i + 1;
    }
    let empty = msg_result(STR_PTR(""), STR_LEN(""), STR_PTR(""), STR_LEN(""), STR_PTR(""), STR_LEN(""));
    msg_round(&g, &empty, 0, true, true, STR_PTR(""), STR_LEN(""), 51);
    msg_read_round(&g, STR_PTR("{\"action\":\"read_lines\",\"path\":\"w.ts\",\"start_line\":1,\"end_line\":50}"), STR_LEN("{\"action\":\"read_lines\",\"path\":\"w.ts\",\"start_line\":1,\"end_line\":50}"), true, STR_PTR(""), STR_LEN(""), 52);
}

@test "different files are tracked independently"() {
    let g = msg_guard();
    let limit: u64 = MINI_SAME_FILE_READ_LIMIT();
    let i: u64 = 0;
    while i < limit {
        msg_read_round(&g, STR_PTR("{\"action\":\"read_lines\",\"path\":\"x.ts\",\"start_line\":1,\"end_line\":50}"), STR_LEN("{\"action\":\"read_lines\",\"path\":\"x.ts\",\"start_line\":1,\"end_line\":50}"), true, STR_PTR(""), STR_LEN(""), 61);
        msg_read_round(&g, STR_PTR("{\"action\":\"read_lines\",\"path\":\"y.ts\",\"start_line\":1,\"end_line\":50}"), STR_LEN("{\"action\":\"read_lines\",\"path\":\"y.ts\",\"start_line\":1,\"end_line\":50}"), true, STR_PTR(""), STR_LEN(""), 62);
        i = i + 1;
    }
}
