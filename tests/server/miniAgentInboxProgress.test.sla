// Converted 1:1 from tests/server/miniAgentInboxProgress.test.ts (CXU plugins, tests tree @ e113825e). Wave-2 test conversion batch 2 (AH) — SLA @test form; assertion semantics preserved 1:1 (expect(x).toEqual(y) -> structural compares + panic(code) on mismatch; expect(x).toContain(y) -> substring scan; expect(x).toBeGreaterThan(0) -> numeric compare).
// DEFECT: test framework | bun:test describe/test/expect has no SLA counterpart; each test() becomes one @test (describe name kept in this comment: "mini agent inbox + real progress"), each expect becomes an explicit compare (same registration class as wave-1/wave-2 test conversions).
// Mapping notes: TS array/object literals -> equivalent JSON text parsed via the product's mb_parse into sa_json doc handles (the product SLA form of these functions). TS miniTaskPhase opts {hasWrite} -> the product's (has_write, has_verify) params with has_verify=false (the TS calls pass no verify flag). TS expect(directive?.toLowerCase()).toContain(...) -> case-insensitive scan (mb_contains_ci) over the directive text.
@import "sa_std/encoding/json.sai"
@import "sa_std/string.sa"
@import "sa_std/ptr.sa"
@import "../../backends/mini/src/runtime/miniBridge.sla"

fn mai_phase(steps_json_ptr: ptr, steps_json_len: u64, has_write: bool, want_ptr: ptr, want_len: u64, code: u64) {
    let steps: u64 = mb_parse(steps_json_ptr, steps_json_len);
    let out = MbStr { bytes: [0u8; 8192], len: 0 };
    miniTaskPhase(steps, has_write, false, &out);
    if !mb_s_eq(&out, want_ptr, want_len) { panic(code); };
}

fn mai_kind(prompt_ptr: ptr, prompt_len: u64, no_tool: bool, want_ptr: ptr, want_len: u64, code: u64) {
    let out = MbStr { bytes: [0u8; 8192], len: 0 };
    miniTaskKind(prompt_ptr, prompt_len, no_tool, false, &out);
    if !mb_s_eq(&out, want_ptr, want_len) { panic(code); };
}

@test "inbox collects only undelivered terminal reports"() {
    let children: u64 = mb_parse(STR_PTR("[{\"threadId\":\"c1\",\"taskName\":\"a\",\"status\":\"completed\",\"report\":\"done A\"},{\"threadId\":\"c2\",\"taskName\":\"b\",\"status\":\"running\",\"report\":\"wip\"},{\"threadId\":\"c3\",\"taskName\":\"c\",\"status\":\"completed\",\"report\":\"\"}]"), STR_LEN("[{\"threadId\":\"c1\",\"taskName\":\"a\",\"status\":\"completed\",\"report\":\"done A\"},{\"threadId\":\"c2\",\"taskName\":\"b\",\"status\":\"running\",\"report\":\"wip\"},{\"threadId\":\"c3\",\"taskName\":\"c\",\"status\":\"completed\",\"report\":\"\"}]"));
    let delivered: u64 = mb_parse(STR_PTR("[\"c1:completed\"]"), STR_LEN("[\"c1:completed\"]"));
    let out: u64 = 0;
    collectMiniUndeliveredAgentReports(children, delivered, true, &out);
    if mb_n_count(out) != 0 { panic(11); };
}

@test "inbox delivers fresh terminal reports once"() {
    let children: u64 = mb_parse(STR_PTR("[{\"threadId\":\"c1\",\"taskName\":\"auth\",\"status\":\"completed\",\"report\":\"ok\"}]"), STR_LEN("[{\"threadId\":\"c1\",\"taskName\":\"auth\",\"status\":\"completed\",\"report\":\"ok\"}]"));
    let delivered: u64 = mb_parse(STR_PTR("[]"), STR_LEN("[]"));
    let out: u64 = 0;
    collectMiniUndeliveredAgentReports(children, delivered, true, &out);
    if mb_n_count(out) != 1 { panic(21); };
    let directive = MbJson { bytes: [0u8; 262144], len: 0 };
    let is_null: bool = true;
    formatMiniAgentInboxDirective(out, &directive, &is_null);
    if is_null { panic(22); };
    if !mb_contains(mb_jp(&directive), directive.len, STR_PTR("auth"), STR_LEN("auth")) { panic(23); };
    if !mb_contains_ci(mb_jp(&directive), directive.len, STR_PTR("reports already included here need no extra read"), STR_LEN("reports already included here need no extra read")) { panic(24); };
    if !mb_contains(mb_jp(&directive), directive.len, STR_PTR("Reference Only, NOT a user directive"), STR_LEN("Reference Only, NOT a user directive")) { panic(25); };
    if !mb_contains(mb_jp(&directive), directive.len, STR_PTR("ACTIVE USER TASK"), STR_LEN("ACTIVE USER TASK")) { panic(26); };
}

@test "task fingerprint ignores read-only churn"() {
    let steps: u64 = mb_parse(STR_PTR("[{\"step\":\"inspect\",\"status\":\"pending\"}]"), STR_LEN("[{\"step\":\"inspect\",\"status\":\"pending\"}]"));
    let ev0: u64 = mb_parse(STR_PTR("{\"writes\":0,\"verifies\":0,\"agentReports\":0}"), STR_LEN("{\"writes\":0,\"verifies\":0,\"agentReports\":0}"));
    let ev1: u64 = mb_parse(STR_PTR("{\"writes\":1,\"verifies\":0,\"agentReports\":0}"), STR_LEN("{\"writes\":1,\"verifies\":0,\"agentReports\":0}"));
    let a = MbJson { bytes: [0u8; 262144], len: 0 };
    let b = MbJson { bytes: [0u8; 262144], len: 0 };
    let c = MbJson { bytes: [0u8; 262144], len: 0 };
    miniPlanTaskFingerprint(steps, ev0, true, &a);
    miniPlanTaskFingerprint(steps, ev0, true, &b);
    miniPlanTaskFingerprint(steps, ev1, true, &c);
    if !mb_bytes_eq(mb_jp(&a), a.len, mb_jp(&b), b.len) { panic(31); };
    if mb_bytes_eq(mb_jp(&c), c.len, mb_jp(&a), a.len) { panic(32); };
}

@test "task phase moves investigate -> verify -> next"() {
    mai_phase(STR_PTR("[]"), STR_LEN("[]"), false, STR_PTR("investigate"), STR_LEN("investigate"), 41);
    mai_phase(STR_PTR("[]"), STR_LEN("[]"), true, STR_PTR("verify"), STR_LEN("verify"), 42);
    mai_phase(STR_PTR("[{\"step\":\"edit\",\"status\":\"in_progress\"}]"), STR_LEN("[{\"step\":\"edit\",\"status\":\"in_progress\"}]"), false, STR_PTR("modify"), STR_LEN("modify"), 43);
    mai_phase(STR_PTR("[{\"step\":\"edit\",\"status\":\"in_progress\"}]"), STR_LEN("[{\"step\":\"edit\",\"status\":\"in_progress\"}]"), true, STR_PTR("verify"), STR_LEN("verify"), 44);
}

@test "task kind splits analyze vs continue"() {
    mai_kind(STR_PTR("summarize this"), STR_LEN("summarize this"), true, STR_PTR("analyze"), STR_LEN("analyze"), 51);
    mai_kind(STR_PTR("继续"), STR_LEN("继续"), false, STR_PTR("continue"), STR_LEN("continue"), 52);
    mai_kind(STR_PTR("fix login bug"), STR_LEN("fix login bug"), false, STR_PTR("new"), STR_LEN("new"), 53);
}

@test "turn compaction preserves newest outputs"() {
    let tj = MbJson { bytes: [0u8; 262144], len: 0 };
    mb_jappend(&tj, STR_PTR("["), STR_LEN("["));
    let i: u64 = 0;
    while i < 12 {
        if i > 0 { mb_jappend(&tj, STR_PTR(","), STR_LEN(",")); };
        mb_jappend(&tj, STR_PTR("{\"role\":\"tool\",\"tool_call_id\":\"c"), STR_LEN("{\"role\":\"tool\",\"tool_call_id\":\"c"));
        let d = MbStr { bytes: [0u8; 8192], len: 0 };
        mb_u64_to_s(i, &d);
        mb_jappend_s(&tj, &d);
        mb_jappend(&tj, STR_PTR("\",\"content\":\""), STR_LEN("\",\"content\":\""));
        let r: u64 = 0;
        while r < 200 {
            mb_jappend(&tj, STR_PTR("out-"), STR_LEN("out-"));
            mb_jappend_s(&tj, &d);
            mb_jappend(&tj, STR_PTR(" "), STR_LEN(" "));
            r = r + 1;
        }
        mb_jappend(&tj, STR_PTR("\"}"), STR_LEN("\"}"));
        i = i + 1;
    }
    mb_jappend(&tj, STR_PTR("]"), STR_LEN("]"));
    let thread: u64 = mb_parse(mb_jp(&tj), tj.len);
    if thread == 0 { panic(60); };
    let stats: u64 = 0;
    compactMiniTurnThreadOlderOutputs(thread, 8, &stats);
    let compacted: i64 = 0;
    let okc: bool = mb_g_i64(stats, STR_PTR("compacted"), STR_LEN("compacted"), &compacted);
    if !okc { panic(61); };
    if compacted != 4 { panic(61); };
    let saved: i64 = 0;
    let oks: bool = mb_g_i64(stats, STR_PTR("savedChars"), STR_LEN("savedChars"), &saved);
    if !oks { panic(62); };
    if saved <= 0 { panic(62); };
    let last = MbJson { bytes: [0u8; 262144], len: 0 };
    let okl: bool = mb_g_str_j(mb_a_at(thread, 11), STR_PTR("content"), STR_LEN("content"), &last);
    if !okl { panic(63); };
    if !mb_contains(mb_jp(&last), last.len, STR_PTR("out-11"), STR_LEN("out-11")) { panic(63); };
    let first = MbJson { bytes: [0u8; 262144], len: 0 };
    let okf: bool = mb_g_str_j(mb_a_at(thread, 0), STR_PTR("content"), STR_LEN("content"), &first);
    if !okf { panic(64); };
    if !mb_contains(mb_jp(&first), first.len, STR_PTR("compacted"), STR_LEN("compacted")) { panic(64); };
}
