// Converted 1:1 from tests/server/opencodeReview.test.ts (CXU plugins, tests tree @ e113825e). Wave-2 test conversion batch 2 (AH) — SLA @test form; assertion semantics preserved 1:1 (expect(x).toEqual(y) -> field-by-field compares + panic(code) on mismatch; expect(x).toContain(y) -> substring scan; expect(x).toBeNull() -> not-found check).
// DEFECT: test framework | bun:test describe/test/expect has no SLA counterpart; each test() becomes one @test (describe name kept in this comment: "opencode /review (mini parity)"), each expect becomes an explicit compare (same registration class as wave-1/wave-2 test conversions).
// Mapping notes: (1) TS OPENCODE_REVIEW_SLASH_RE is a RegExp value; the product SLA keeps only the pattern text (opencode_review_slash_re_pattern) and documents that the pattern "is applied by hand in callers" (opencodeReview.sla, DEFECT note at the constant). The capture assertions below therefore apply the documented hand rule in the test (leading-whitespace skip, "/review" literal, word-boundary check) — registered approximation, not a product regex surface. (2) TS object-form parse inputs ({type:"branch",...}) -> equivalent JSON text; the product parse accepts the object form when the first non-space byte is '{' (its own documented mapping). (3) Target kind tags: 0=uncommittedChanges, 1=baseBranch, 2=commit, 3=custom (product target_init/parse).
@import "sa_std/encoding/json.sai"
@import "sa_std/string.sa"
@import "sa_std/ptr.sa"
@import "../../backends/opencode/src/runtime/opencodeReview.sla"

fn ocr_span_eq(p: ptr, n: u64, wp: ptr, wn: u64, code: u64) {
    if n != wn { panic(code); };
    let i: u64 = 0;
    while i < n {
        let a: u8 = 0;
        let b: u8 = 0;
        PTR_BYTE_AT(a, p, i);
        PTR_BYTE_AT(b, wp, i);
        if a != b { panic(code); };
        i = i + 1;
    }
}

fn ocr_is_word(c: u8) -> bool {
    if c >= 48 && c <= 57 { return true; };
    if c >= 65 && c <= 90 { return true; };
    if c >= 97 && c <= 122 { return true; };
    return c == 95;
}

fn ocr_is_space(c: u8) -> bool {
    return c == 32 || c == 9 || c == 10 || c == 13;
}

// Hand application of /^\s*\/review\b([\s\S]*)$/ per the product's registered
// approximation: returns found + capture span (pointer/len into the input).
fn ocr_capture(p: ptr, n: u64, out_off: &u64, out_len: &u64) -> bool {
    *out_off = 0;
    *out_len = 0;
    let i: u64 = 0;
    while i < n {
        let c: u8 = 0;
        PTR_BYTE_AT(c, p, i);
        if !ocr_is_space(c) { break; };
        i = i + 1;
    }
    if i + 7 > n { return false; };
    let lit: ptr = STR_PTR("/review");
    let k: u64 = 0;
    while k < 7 {
        let a: u8 = 0;
        let b: u8 = 0;
        PTR_BYTE_AT(a, p, i + k);
        PTR_BYTE_AT(b, lit, k);
        if a != b { return false; };
        k = k + 1;
    }
    let j: u64 = i + 7;
    if j < n {
        let c: u8 = 0;
        PTR_BYTE_AT(c, p, j);
        if ocr_is_word(c) { return false; };
    };
    *out_off = j;
    *out_len = n - j;
    return true;
}

fn ocr_capture_trimmed(p: ptr, n: u64, want_ptr: ptr, want_len: u64, code: u64) {
    let off: u64 = 0;
    let len: u64 = 0;
    if !ocr_capture(p, n, &off, &len) { panic(code); };
    let sp: ptr = PTR_NULL();
    PTR_BYTE_ADD(sp, p, off);
    let a: u64 = 0;
    let b: u64 = len;
    while a < b {
        let c: u8 = 0;
        PTR_BYTE_AT(c, sp, a);
        if !ocr_is_space(c) { break; };
        a = a + 1;
    }
    while b > a {
        let c: u8 = 0;
        PTR_BYTE_AT(c, sp, b - 1);
        if !ocr_is_space(c) { break; };
        b = b - 1;
    }
    let tp: ptr = PTR_NULL();
    PTR_BYTE_ADD(tp, sp, a);
    ocr_span_eq(tp, b - a, want_ptr, want_len, code);
}

fn ocr_target() -> OpencodeReviewTarget {
    return OpencodeReviewTarget { kind: 0, branch: [0u8; 512], branch_len: 0, sha: [0u8; 128], sha_len: 0, title: [0u8; 1024], title_len: 0, has_title: false, instructions: [0u8; 8192], instructions_len: 0 };
}

fn ocr_field_eq(t: &OpencodeReviewTarget, field: u64, wp: ptr, wn: u64, code: u64) {
    let p: ptr = PTR_NULL();
    let n: u64 = 0;
    if field == 0 { PTR_BYTE_ADD(p, &t.branch, 0); n = t.branch_len; };
    if field == 1 { PTR_BYTE_ADD(p, &t.sha, 0); n = t.sha_len; };
    if field == 2 { PTR_BYTE_ADD(p, &t.title, 0); n = t.title_len; };
    if field == 3 { PTR_BYTE_ADD(p, &t.instructions, 0); n = t.instructions_len; };
    ocr_span_eq(p, n, wp, wn, code);
}

fn ocr_expect_target(t: &OpencodeReviewTarget, kind: u32, code: u64) {
    if t.kind != kind { panic(code); };
}

fn ocr_buf_contains(b: &ByteBuf, needle_ptr: ptr, needle_len: u64, code: u64) {
    let bp: ptr = PTR_NULL();
    PTR_BYTE_ADD(bp, &b.bytes, 0);
    if b.len < needle_len { panic(code); };
    let last: u64 = b.len - needle_len;
    let i: u64 = 0;
    let found: bool = false;
    while i <= last && !found {
        let ok: bool = true;
        let j: u64 = 0;
        while j < needle_len {
            let x: u8 = 0;
            let y: u8 = 0;
            PTR_BYTE_AT(x, bp, i + j);
            PTR_BYTE_AT(y, needle_ptr, j);
            if x != y { ok = false; break; };
            j = j + 1;
        }
        if ok { found = true; };
        i = i + 1;
    }
    if !found { panic(code); };
}

fn ocr_buf_not_contains(b: &ByteBuf, needle_ptr: ptr, needle_len: u64, code: u64) {
    let bp: ptr = PTR_NULL();
    PTR_BYTE_ADD(bp, &b.bytes, 0);
    if b.len < needle_len { return; };
    let last: u64 = b.len - needle_len;
    let i: u64 = 0;
    while i <= last {
        let ok: bool = true;
        let j: u64 = 0;
        while j < needle_len {
            let x: u8 = 0;
            let y: u8 = 0;
            PTR_BYTE_AT(x, bp, i + j);
            PTR_BYTE_AT(y, needle_ptr, j);
            if x != y { ok = false; break; };
            j = j + 1;
        }
        if ok { panic(code); };
        i = i + 1;
    }
}

@test "slash regex captures the target text"() {
    let off: u64 = 0;
    let len: u64 = 0;
    if !ocr_capture(STR_PTR("/review"), STR_LEN("/review"), &off, &len) { panic(11); };
    if len != 0 { panic(11); };
    ocr_capture_trimmed(STR_PTR("  /review branch main"), STR_LEN("  /review branch main"), STR_PTR("branch main"), STR_LEN("branch main"), 12);
    if ocr_capture(STR_PTR("/reviewer x"), STR_LEN("/reviewer x"), &off, &len) { panic(13); };
    if ocr_capture(STR_PTR("please /review"), STR_LEN("please /review"), &off, &len) { panic(14); };
}

@test "parseOpencodeReviewTarget mirrors mini grammar"() {
    let t = ocr_target();
    parseOpencodeReviewTarget(STR_PTR(""), STR_LEN(""), &t);
    ocr_expect_target(&t, 0, 21);
    parseOpencodeReviewTarget(STR_PTR("uncommitted"), STR_LEN("uncommitted"), &t);
    ocr_expect_target(&t, 0, 22);
    parseOpencodeReviewTarget(STR_PTR("branch main"), STR_LEN("branch main"), &t);
    ocr_expect_target(&t, 1, 23);
    ocr_field_eq(&t, 0, STR_PTR("main"), STR_LEN("main"), 24);
    parseOpencodeReviewTarget(STR_PTR("base main"), STR_LEN("base main"), &t);
    ocr_expect_target(&t, 1, 25);
    ocr_field_eq(&t, 0, STR_PTR("main"), STR_LEN("main"), 26);
    parseOpencodeReviewTarget(STR_PTR("commit abc1234"), STR_LEN("commit abc1234"), &t);
    ocr_expect_target(&t, 2, 27);
    ocr_field_eq(&t, 1, STR_PTR("abc1234"), STR_LEN("abc1234"), 28);
    if t.has_title { panic(29); };
    parseOpencodeReviewTarget(STR_PTR("commit abc1234 Fix bug"), STR_LEN("commit abc1234 Fix bug"), &t);
    ocr_expect_target(&t, 2, 30);
    ocr_field_eq(&t, 1, STR_PTR("abc1234"), STR_LEN("abc1234"), 31);
    if !t.has_title { panic(32); };
    ocr_field_eq(&t, 2, STR_PTR("Fix bug"), STR_LEN("Fix bug"), 33);
    parseOpencodeReviewTarget(STR_PTR("focus on auth"), STR_LEN("focus on auth"), &t);
    ocr_expect_target(&t, 3, 34);
    ocr_field_eq(&t, 3, STR_PTR("focus on auth"), STR_LEN("focus on auth"), 35);
    parseOpencodeReviewTarget(STR_PTR("{\"type\":\"branch\",\"branch\":\"dev\"}"), STR_LEN("{\"type\":\"branch\",\"branch\":\"dev\"}"), &t);
    ocr_expect_target(&t, 1, 36);
    ocr_field_eq(&t, 0, STR_PTR("dev"), STR_LEN("dev"), 37);
    parseOpencodeReviewTarget(STR_PTR("{\"type\":\"commit\",\"sha\":\"abc1234\",\"title\":\"T\"}"), STR_LEN("{\"type\":\"commit\",\"sha\":\"abc1234\",\"title\":\"T\"}"), &t);
    ocr_expect_target(&t, 2, 38);
    ocr_field_eq(&t, 1, STR_PTR("abc1234"), STR_LEN("abc1234"), 39);
    if !t.has_title { panic(40); };
    ocr_field_eq(&t, 2, STR_PTR("T"), STR_LEN("T"), 41);
}

@test "review prompt is read-only and uses opencode-native tools"() {
    let t = ocr_target();
    parseOpencodeReviewTarget(STR_PTR(""), STR_LEN(""), &t);
    let prompt = ByteBuf { bytes: [0u8; 16384], len: 0 };
    buildOpencodeReviewPrompt(&t, &prompt);
    ocr_buf_contains(&prompt, STR_PTR("do NOT implement anything"), STR_LEN("do NOT implement anything"), 51);
    ocr_buf_contains(&prompt, STR_PTR("never write, edit, or commit files"), STR_LEN("never write, edit, or commit files"), 52);
    ocr_buf_contains(&prompt, STR_PTR("git status"), STR_LEN("git status"), 53);
    ocr_buf_contains(&prompt, STR_PTR("git diff"), STR_LEN("git diff"), 54);
    ocr_buf_not_contains(&prompt, STR_PTR("sa_vm"), STR_LEN("sa_vm"), 55);
}

@test "review prompt renders branch/commit targets"() {
    let t = ocr_target();
    parseOpencodeReviewTarget(STR_PTR("branch main"), STR_LEN("branch main"), &t);
    let prompt = ByteBuf { bytes: [0u8; 16384], len: 0 };
    buildOpencodeReviewPrompt(&t, &prompt);
    ocr_buf_contains(&prompt, STR_PTR("'main'"), STR_LEN("'main'"), 61);
    parseOpencodeReviewTarget(STR_PTR("{\"type\":\"commit\",\"sha\":\"abc1234\",\"title\":\"Fix\"}"), STR_LEN("{\"type\":\"commit\",\"sha\":\"abc1234\",\"title\":\"Fix\"}"), &t);
    buildOpencodeReviewPrompt(&t, &prompt);
    ocr_buf_contains(&prompt, STR_PTR("abc1234"), STR_LEN("abc1234"), 62);
    ocr_buf_contains(&prompt, STR_PTR("Fix"), STR_LEN("Fix"), 63);
}

@test "formatOpencodeReviewSlash round-trips through the parser"() {
    let src = ocr_target();
    let dst = ocr_target();
    let slash = ByteBuf { bytes: [0u8; 16384], len: 0 };
    parseOpencodeReviewTarget(STR_PTR(""), STR_LEN(""), &src);
    formatOpencodeReviewSlash(&src, &slash);
    ocr_roundtrip(&slash, &src, 71);
    parseOpencodeReviewTarget(STR_PTR("branch main"), STR_LEN("branch main"), &src);
    formatOpencodeReviewSlash(&src, &slash);
    ocr_roundtrip(&slash, &src, 72);
    parseOpencodeReviewTarget(STR_PTR("commit abc1234 Fix bug"), STR_LEN("commit abc1234 Fix bug"), &src);
    formatOpencodeReviewSlash(&src, &slash);
    ocr_roundtrip(&slash, &src, 73);
    parseOpencodeReviewTarget(STR_PTR("commit abc1234"), STR_LEN("commit abc1234"), &src);
    formatOpencodeReviewSlash(&src, &slash);
    ocr_roundtrip(&slash, &src, 74);
    parseOpencodeReviewTarget(STR_PTR("focus on auth"), STR_LEN("focus on auth"), &src);
    formatOpencodeReviewSlash(&src, &slash);
    ocr_roundtrip(&slash, &src, 75);
}

fn ocr_roundtrip(slash: &ByteBuf, src: &OpencodeReviewTarget, code: u64) {
    let sp: ptr = PTR_NULL();
    PTR_BYTE_ADD(sp, &slash.bytes, 0);
    let off: u64 = 0;
    let len: u64 = 0;
    if !ocr_capture(sp, slash.len, &off, &len) { panic(code); };
    let rp: ptr = PTR_NULL();
    PTR_BYTE_ADD(rp, sp, off);
    let dst = ocr_target();
    parseOpencodeReviewTarget(rp, len, &dst);
    if dst.kind != src.kind { panic(code); };
    if dst.branch_len != src.branch_len { panic(code); };
    if dst.sha_len != src.sha_len { panic(code); };
    if dst.has_title != src.has_title { panic(code); };
    if dst.title_len != src.title_len { panic(code); };
    if dst.instructions_len != src.instructions_len { panic(code); };
    let a: ptr = PTR_NULL();
    let b: ptr = PTR_NULL();
    PTR_BYTE_ADD(a, &dst.branch, 0);
    PTR_BYTE_ADD(b, &src.branch, 0);
    ocr_span_eq(a, dst.branch_len, b, src.branch_len, code);
    PTR_BYTE_ADD(a, &dst.sha, 0);
    PTR_BYTE_ADD(b, &src.sha, 0);
    ocr_span_eq(a, dst.sha_len, b, src.sha_len, code);
    PTR_BYTE_ADD(a, &dst.title, 0);
    PTR_BYTE_ADD(b, &src.title, 0);
    ocr_span_eq(a, dst.title_len, b, src.title_len, code);
    PTR_BYTE_ADD(a, &dst.instructions, 0);
    PTR_BYTE_ADD(b, &src.instructions, 0);
    ocr_span_eq(a, dst.instructions_len, b, src.instructions_len, code);
}
