// Converted 1:1 from tests/server/miniTurnCompletion.test.ts (CXU plugins, tests tree @ e113825e). Wave-2 test conversion batch 2 (AH) — SLA @test form; assertion semantics preserved 1:1 (expect(x).toBe(y) -> explicit compare + panic(code) on mismatch).
// DEFECT: test framework | bun:test describe/test/expect has no SLA counterpart; each test() becomes one @test (describe name kept in this comment: "miniDeclaresTurnComplete"), each expect becomes an explicit compare (same registration class as wave-1/wave-2 test conversions).
@import "sa_std/string.sa"
@import "../../backends/mini/src/runtime/miniBridge.sla"

fn mtc_expect(text_ptr: ptr, text_len: u64, want: bool, code: u64) {
    let got: bool = miniDeclaresTurnComplete(text_ptr, text_len);
    if got != want { panic(code); };
}

@test "accepts an explicit DONE marker as the final line"() {
    mtc_expect(STR_PTR("DONE: fixed the login redirect"), STR_LEN("DONE: fixed the login redirect"), true, 11);
    mtc_expect(STR_PTR("Summary of changes...\nDONE: all requested edits applied"), STR_LEN("Summary of changes...\nDONE: all requested edits applied"), true, 12);
    mtc_expect(STR_PTR("  DONE: done  "), STR_LEN("  DONE: done  "), true, 13);
}

@test "accepts the Chinese marker with half/full-width colon"() {
    mtc_expect(STR_PTR("完成：修改了3个文件"), STR_LEN("完成：修改了3个文件"), true, 21);
    mtc_expect(STR_PTR("完成: verified with tests"), STR_LEN("完成: verified with tests"), true, 22);
}

@test "accepts case-insensitive DONE and Done markers"() {
    mtc_expect(STR_PTR("Done: fixed the login redirect"), STR_LEN("Done: fixed the login redirect"), true, 31);
    mtc_expect(STR_PTR("done: all tasks finished"), STR_LEN("done: all tasks finished"), true, 32);
}

@test "accepts markdown-decorated markers (bold, bullet, header)"() {
    mtc_expect(STR_PTR("**DONE:** fixed the login redirect"), STR_LEN("**DONE:** fixed the login redirect"), true, 41);
    mtc_expect(STR_PTR("**DONE**: all requested edits applied"), STR_LEN("**DONE**: all requested edits applied"), true, 42);
    mtc_expect(STR_PTR("**Done:** case-insensitive bold"), STR_LEN("**Done:** case-insensitive bold"), true, 43);
    mtc_expect(STR_PTR("- DONE: bullet item"), STR_LEN("- DONE: bullet item"), true, 44);
    mtc_expect(STR_PTR("* **DONE:** bullet with bold"), STR_LEN("* **DONE:** bullet with bold"), true, 45);
    mtc_expect(STR_PTR("### DONE: header style"), STR_LEN("### DONE: header style"), true, 46);
    mtc_expect(STR_PTR("**完成：**所有改动已应用"), STR_LEN("**完成：**所有改动已应用"), true, 47);
    mtc_expect(STR_PTR("**完成**: 冒号在加粗外部"), STR_LEN("**完成**: 冒号在加粗外部"), true, 48);
    mtc_expect(STR_PTR("- 完成：列表中文"), STR_LEN("- 完成：列表中文"), true, 49);
}

@test "mid-answer mentions never end the turn"() {
    mtc_expect(STR_PTR("DONE: part one\nContinuing with part two"), STR_LEN("DONE: part one\nContinuing with part two"), false, 51);
    mtc_expect(STR_PTR("接下来完成剩余部分"), STR_LEN("接下来完成剩余部分"), false, 52);
    mtc_expect(STR_PTR("完成：第一步\n接下来处理第二步"), STR_LEN("完成：第一步\n接下来处理第二步"), false, 53);
}

@test "prose without the marker shape does not match"() {
    mtc_expect(STR_PTR(""), STR_LEN(""), false, 61);
    mtc_expect(STR_PTR("任务已经完成"), STR_LEN("任务已经完成"), false, 62);
    mtc_expect(STR_PTR("GOAL_DONE"), STR_LEN("GOAL_DONE"), false, 63);
    mtc_expect(STR_PTR("UNDONE: still working"), STR_LEN("UNDONE: still working"), false, 64);
    mtc_expect(STR_PTR("_UNDONE: still working"), STR_LEN("_UNDONE: still working"), false, 65);
    mtc_expect(STR_PTR("DONE_TASK: still running"), STR_LEN("DONE_TASK: still running"), false, 66);
}

@test "marker check is orthogonal to the question gate"() {
    mtc_expect(STR_PTR("DONE: 还有问题吗?"), STR_LEN("DONE: 还有问题吗?"), true, 71);
}
