@import "sa_std/string.sa"
@import "../../backends/relay-config/src/relay/relayProtocolGateway.sla"

fn abe_expect_effort(json_ptr: ptr, json_len: u64, want_ptr: ptr, want_len: u64, code: u64) {
    let thinking = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
    rpg_jb_assign(&thinking, json_ptr, json_len);
    let out = RpgStr { bytes: [0u8; 8192], len: 0 };
    let has: bool = anthropicBudgetToEffort(&thinking, &out);
    if !has { panic(code); };
    if !rpg_rs_eq(&out, want_ptr, want_len) { panic(code); };
}

fn abe_expect_none(json_ptr: ptr, json_len: u64, code: u64) {
    let thinking = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
    rpg_jb_assign(&thinking, json_ptr, json_len);
    let out = RpgStr { bytes: [0u8; 8192], len: 0 };
    let has: bool = anthropicBudgetToEffort(&thinking, &out);
    if has { panic(code); };
}

@test "anthropic enabled thinking budget maps to effort tier"() {
    abe_expect_effort(STR_PTR("{\"type\":\"enabled\",\"budget_tokens\":1024}"), STR_LEN("{\"type\":\"enabled\",\"budget_tokens\":1024}"), STR_PTR("low"), STR_LEN("low"), 11);
    abe_expect_effort(STR_PTR("{\"type\":\"enabled\",\"budget_tokens\":2048}"), STR_LEN("{\"type\":\"enabled\",\"budget_tokens\":2048}"), STR_PTR("medium"), STR_LEN("medium"), 12);
    abe_expect_effort(STR_PTR("{\"type\":\"enabled\",\"budget_tokens\":4096}"), STR_LEN("{\"type\":\"enabled\",\"budget_tokens\":4096}"), STR_PTR("high"), STR_LEN("high"), 13);
    abe_expect_effort(STR_PTR("{\"type\":\"enabled\",\"budget_tokens\":8192}"), STR_LEN("{\"type\":\"enabled\",\"budget_tokens\":8192}"), STR_PTR("xhigh"), STR_LEN("xhigh"), 14);
}

@test "non-enabled or missing budgets yield no effort"() {
    abe_expect_none(STR_PTR("{\"type\":\"disabled\"}"), STR_LEN("{\"type\":\"disabled\"}"), 21);
    abe_expect_none(STR_PTR("{\"type\":\"adaptive\"}"), STR_LEN("{\"type\":\"adaptive\"}"), 22);
    abe_expect_none(STR_PTR("{\"type\":\"enabled\"}"), STR_LEN("{\"type\":\"enabled\"}"), 23);
}
