// Converted 1:1 from tests/server/threadHistoryPaging.test.ts (CXU plugins, tests tree @ e113825e). Wave-2 test conversion — SLA @test form; assertion semantics preserved 1:1 (expect(x).toEqual(y) -> structural compares over the product's serialized page JSON + panic(code) on mismatch; expect(x).toBeNull() -> has_nextCursor == false).
// DEFECT: test framework | bun:test test/expect has no SLA counterpart; each test() becomes one @test, each expect becomes explicit compares (same registration class as wave-1 test conversions).
// RUN STATUS (2026-10-27): sa check PASS; sa test BLOCKED by SAB direct lowering error.UnsupportedSabDirectFeature triggered by calling pageThreadHistory (probe-isolated in _defects/probes/t2_thp_probe.sla: import-only closure OK; the call fails fast). Compiler-surface residual — registered in _defects/FIX_TESTS_WAVE2.md; test not adjusted.
// Mapping notes: the product SLA form takes turns/messages as JSON text and returns the page as JSON text (sdk-backend/src/threadHistoryPaging.sla header documents this approximation). TS result.turns and result.data are the same page array in TS; the SLA form serializes it once as page_json, so the TS assertion result.data == result.turns is represented by asserting on that single page (noted, not dropped).
// Form note: helpers returning structs/derived ptrs hit SAB error.UnsupportedSabDirectFeature on the sa test path (check passes); this file therefore inlines option/result handling in the test bodies.
@import "sa_std/encoding/json.sai"
@import "sa_std/string.sa"
@import "sa_std/ptr.sa"
@import "../../apps/server/src/threadHistoryPaging.sla"

fn thp_str_field(node: u64, key_ptr: ptr, key_len: u64, want_ptr: ptr, want_len: u64, code: u64) {
    let sp: ptr = PTR_NULL();
    let sl: u64 = 0;
    let rc: i32 = sa_json_object_get_string(node, key_ptr, key_len, &sp, &sl);
    if rc != 0 { panic(code); };
    if sl != want_len { panic(code); };
    let i: u64 = 0;
    while i < sl {
        let a: u8 = 0;
        let b: u8 = 0;
        PTR_BYTE_AT(a, sp, i);
        PTR_BYTE_AT(b, want_ptr, i);
        if a != b { panic(code); };
        i = i + 1;
    }
}

@test "history pages sort turns and return only that page's messages"() {
    let opts = PageOptions { has_cursor: false, cursor: [0u8; 128], cursor_len: 0, has_limit: true, limit: 1, ascending: false };
    let out = PageResult { page_json: [0u8; 262144], page_len: 0, has_nextCursor: false, nextCursor: [0u8; 128], nextCursor_len: 0 };
    let rc: i32 = pageThreadHistory(STR_PTR("thread"), STR_LEN("thread"), STR_PTR("[{\"id\":\"old\",\"status\":\"completed\",\"createdAt\":1},{\"id\":\"new\",\"status\":\"completed\",\"createdAt\":2}]"), STR_LEN("[{\"id\":\"old\",\"status\":\"completed\",\"createdAt\":1},{\"id\":\"new\",\"status\":\"completed\",\"createdAt\":2}]"), STR_PTR("[{\"id\":\"old-user\",\"turnId\":\"old\"},{\"id\":\"new-user\",\"turnId\":\"new\"}]"), STR_LEN("[{\"id\":\"old-user\",\"turnId\":\"old\"},{\"id\":\"new-user\",\"turnId\":\"new\"}]"), &opts, &out);
    if rc != 0 { panic(10); };
    let page_p: ptr = PTR_NULL();
    PTR_BYTE_ADD(page_p, &out.page_json, 0);
    let doc: u64 = sa_json_parse(page_p, out.page_len);
    if doc == 0 { panic(11); };
    let n: u64 = 0;
    let rc1: i32 = sa_json_value_count(doc, &n);
    if rc1 != 0 || n != 1 { panic(12); };
    let turn: u64 = 0;
    let rc2: i32 = sa_json_array_get(doc, 0, &turn);
    if rc2 != 0 || turn == 0 { panic(13); };
    thp_str_field(turn, STR_PTR("id"), STR_LEN("id"), STR_PTR("new"), STR_LEN("new"), 14);
    let items: u64 = 0;
    let rc3: i32 = sa_json_object_get(turn, STR_PTR("items"), STR_LEN("items"), &items);
    if rc3 != 0 || items == 0 { panic(15); };
    let ni: u64 = 0;
    let rc4: i32 = sa_json_value_count(items, &ni);
    if rc4 != 0 || ni != 1 { panic(16); };
    let item0: u64 = 0;
    let rc5: i32 = sa_json_array_get(items, 0, &item0);
    if rc5 != 0 || item0 == 0 { panic(17); };
    thp_str_field(item0, STR_PTR("id"), STR_LEN("id"), STR_PTR("new-user"), STR_LEN("new-user"), 18);
    thp_str_field(item0, STR_PTR("turnId"), STR_LEN("turnId"), STR_PTR("new"), STR_LEN("new"), 19);
    if !out.has_nextCursor { panic(20); };
    if out.nextCursor_len != 3 { panic(21); };
    let cp: ptr = PTR_NULL();
    PTR_BYTE_ADD(cp, &out.nextCursor, 0);
    let w0: u8 = 0;
    let w1: u8 = 0;
    let w2: u8 = 0;
    PTR_BYTE_AT(w0, cp, 0);
    PTR_BYTE_AT(w1, cp, 1);
    PTR_BYTE_AT(w2, cp, 2);
    if w0 != 110 || w1 != 101 || w2 != 119 { panic(22); };
}

@test "history page cursor reaches the end without duplicating a turn"() {
    let turns_ptr: ptr = STR_PTR("[{\"id\":\"old\",\"status\":\"completed\",\"createdAt\":1},{\"id\":\"new\",\"status\":\"completed\",\"createdAt\":2}]");
    let turns_len: u64 = STR_LEN("[{\"id\":\"old\",\"status\":\"completed\",\"createdAt\":1},{\"id\":\"new\",\"status\":\"completed\",\"createdAt\":2}]");
    let opts1 = PageOptions { has_cursor: false, cursor: [0u8; 128], cursor_len: 0, has_limit: true, limit: 1, ascending: false };
    let first = PageResult { page_json: [0u8; 262144], page_len: 0, has_nextCursor: false, nextCursor: [0u8; 128], nextCursor_len: 0 };
    let rc: i32 = pageThreadHistory(STR_PTR("thread"), STR_LEN("thread"), turns_ptr, turns_len, STR_PTR("[]"), STR_LEN("[]"), &opts1, &first);
    if rc != 0 { panic(30); };
    if !first.has_nextCursor { panic(31); };
    let opts2 = PageOptions { has_cursor: true, cursor: [0u8; 128], cursor_len: 0, has_limit: true, limit: 1, ascending: false };
    opts2.cursor_len = first.nextCursor_len;
    let ci: u64 = 0;
    while ci < first.nextCursor_len {
        opts2.cursor[ci] = first.nextCursor[ci];
        ci = ci + 1;
    }
    let second = PageResult { page_json: [0u8; 262144], page_len: 0, has_nextCursor: false, nextCursor: [0u8; 128], nextCursor_len: 0 };
    let rc2: i32 = pageThreadHistory(STR_PTR("thread"), STR_LEN("thread"), turns_ptr, turns_len, STR_PTR("[]"), STR_LEN("[]"), &opts2, &second);
    if rc2 != 0 { panic(32); };
    let page_p: ptr = PTR_NULL();
    PTR_BYTE_ADD(page_p, &second.page_json, 0);
    let doc: u64 = sa_json_parse(page_p, second.page_len);
    if doc == 0 { panic(33); };
    let n: u64 = 0;
    let rc3: i32 = sa_json_value_count(doc, &n);
    if rc3 != 0 || n != 1 { panic(34); };
    let turn: u64 = 0;
    let rc4: i32 = sa_json_array_get(doc, 0, &turn);
    if rc4 != 0 || turn == 0 { panic(35); };
    thp_str_field(turn, STR_PTR("id"), STR_LEN("id"), STR_PTR("old"), STR_LEN("old"), 36);
    if second.has_nextCursor { panic(37); };
}
