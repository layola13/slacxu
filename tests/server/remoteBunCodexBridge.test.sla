// Converted 1:1 from tests/server/remoteBunCodexBridge.test.ts (CXU plugins, tests tree @ e113825e). Wave-2 test conversion — SLA @test form; assertion semantics preserved 1:1 (expect(x).toBe(y) -> explicit compare + panic(code) on mismatch).
// DEFECT: test framework | bun:test describe/test/expect has no SLA counterpart; each test() becomes one @test (describe name kept in this comment: "remote SSH reconnect policy"), each expect becomes an explicit compare (same registration class as wave-1 test conversions).
// DEFECT: Error object | TS passes new Error(msg); product SLA form takes (is_error, msg_ptr, msg_len) — the test passes is_error=true with the same message text.
// NOTE: product isRemoteRpcRetrySafe is a length-class approximation (see its own comments in backends/codex/src/runtime/remoteBunCodexBridge.sla); assertions are converted as written in TS and are expected to expose that divergence — the test is NOT adjusted to the approximation.
@import "sa_std/string.sa"
@import "../../backends/codex/src/runtime/remoteBunCodexBridge.sla"

fn rbc_expect_safe(method_ptr: ptr, method_len: u64, want: bool, code: u64) {
    let got: bool = isRemoteRpcRetrySafe(method_ptr, method_len);
    if got != want { panic(code); };
}

fn rbc_expect_delay(attempt: u64, want: u64, code: u64) {
    let got: u64 = remoteReconnectDelayMs(attempt);
    if got != want { panic(code); };
}

@test "retries only read RPCs"() {
    rbc_expect_safe(STR_PTR("thread/read"), STR_LEN("thread/read"), true, 11);
    rbc_expect_safe(STR_PTR("thread/turns/list"), STR_LEN("thread/turns/list"), true, 12);
    rbc_expect_safe(STR_PTR("turn/start"), STR_LEN("turn/start"), false, 13);
    rbc_expect_safe(STR_PTR("turn/interrupt"), STR_LEN("turn/interrupt"), false, 14);
    rbc_expect_safe(STR_PTR("thread/goal/set"), STR_LEN("thread/goal/set"), false, 15);
}

@test "distinguishes transport failures from remote RPC errors"() {
    let a: bool = isRemoteTransportFailure(true, STR_PTR("fetch failed: ECONNRESET"), STR_LEN("fetch failed: ECONNRESET"));
    if !a { panic(21); };
    let b: bool = isRemoteTransportFailure(true, STR_PTR("Relay group is disabled"), STR_LEN("Relay group is disabled"));
    if b { panic(22); };
}

@test "backs off to a stable low-frequency probe for long outages"() {
    rbc_expect_delay(0, 250, 31);
    rbc_expect_delay(1, 500, 32);
    rbc_expect_delay(2, 1000, 33);
    rbc_expect_delay(3, 2000, 34);
    rbc_expect_delay(4, 4000, 35);
    rbc_expect_delay(5, 8000, 36);
    rbc_expect_delay(6, 16000, 37);
    rbc_expect_delay(7, 30000, 38);
    rbc_expect_delay(8, 30000, 39);
    rbc_expect_delay(100, 30000, 40);
}

@test "bounds reconnect attempts during an outage"() {
    let m: u64 = REMOTE_RECONNECT_MAX_ATTEMPTS();
    if m != 8 { panic(41); };
}
