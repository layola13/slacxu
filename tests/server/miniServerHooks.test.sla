// Converted 1:1 from tests/server/miniServerHooks.test.ts (CXU plugins, tests tree @ e113825e). Wave-2 test conversion batch 2 (AH) — SLA @test form; assertion semantics preserved 1:1 (expect(x).toBeNull() -> out_is_null check + panic(code); expect(x).not.toBeNull() / toContain(y) -> explicit compares).
// DEFECT: test framework | bun:test describe/test/expect has no SLA counterpart; each test() becomes one @test (describe name kept in this comment: "mini server MCP hooks"), each expect becomes an explicit compare (same registration class as wave-1/wave-2 test conversions).
// REGISTERED NON-CONVERSION (1 of 2 tests): "fires Pre/PostToolUse around the raw runner and preserves errors" is not expressible on the product SLA surface — runWithServerMcpHooks takes the runner as an invoke_id (u64) with no SLA-callable dispatch, fireServerHook's body is comment-only, and handler registration (onMiniServerHook) stores handler ids in a caller-owned ServerHookHandlers table with no event-observation surface (product header: bulk conversion pass, bodies are comment/preset). Converting it would require inventing product surface; it is registered here and in FIX_TESTS_WAVE2B.md instead.
// NOTE: shouldAutoRememberServerToolResult's product body is a preset (sets *out_is_null = true unconditionally, in-code DEFECT: regex). The converted assertions below are as written in TS and are expected to expose that preset — the test is NOT adjusted to it.
@import "sa_std/string.sa"
@import "sa_std/ptr.sa"
@import "../../backends/mini/src/runtime/miniServerHooks.sla"

fn msh_call(name_ptr: ptr, name_len: u64, out_text_ptr: ptr, out_text_len: u64, buf: ptr, out_len: &u64, out_is_null: &bool) {
    let rc: i32 = shouldAutoRememberServerToolResult(name_ptr, name_len, out_text_ptr, out_text_len, buf, out_len, out_is_null);
}

fn msh_expect_null(name_ptr: ptr, name_len: u64, out_text_ptr: ptr, out_text_len: u64, code: u64) {
    let buf = [0u8; 8192];
    let bp: ptr = PTR_NULL();
    PTR_BYTE_ADD(bp, &buf, 0);
    let ol: u64 = 0;
    let is_null: bool = false;
    msh_call(name_ptr, name_len, out_text_ptr, out_text_len, bp, &ol, &is_null);
    if !is_null { panic(code); };
}

@test "auto-remember triage mirrors mini-codex keywords and ignores noise"() {
    msh_expect_null(STR_PTR("mcp__demo__x"), STR_LEN("mcp__demo__x"), STR_PTR("short"), STR_LEN("short"), 51);
    msh_expect_null(STR_PTR("mcp__demo__x"), STR_LEN("mcp__demo__x"), STR_PTR("tool error: something failed badly here"), STR_LEN("tool error: something failed badly here"), 52);
    let buf = [0u8; 8192];
    let bp: ptr = PTR_NULL();
    PTR_BYTE_ADD(bp, &buf, 0);
    let ol: u64 = 0;
    let is_null: bool = false;
    msh_call(STR_PTR("mcp__demo__cfg"), STR_LEN("mcp__demo__cfg"), STR_PTR("用户偏好：以后构建都用 bun，不要用 npm，这个约定长期有效请记住"), STR_LEN("用户偏好：以后构建都用 bun，不要用 npm，这个约定长期有效请记住"), bp, &ol, &is_null);
    if is_null { panic(53); };
    let needle: ptr = STR_PTR("mcp__demo__cfg");
    let nlen: u64 = STR_LEN("mcp__demo__cfg");
    if ol < nlen { panic(54); };
    let last: u64 = ol - nlen;
    let i: u64 = 0;
    let found: bool = false;
    while i <= last && !found {
        let ok: bool = true;
        let j: u64 = 0;
        while j < nlen {
            let x: u8 = 0;
            let y: u8 = 0;
            PTR_BYTE_AT(x, bp, i + j);
            PTR_BYTE_AT(y, needle, j);
            if x != y { ok = false; break; };
            j = j + 1;
        }
        if ok { found = true; };
        i = i + 1;
    }
    if !found { panic(54); };
}
