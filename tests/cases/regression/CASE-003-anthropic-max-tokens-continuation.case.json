{
  "id": "CASE-003-anthropic-max-tokens-continuation",
  "title": "Anthropic 输出达到 max_tokens 时自动接关续写而非报错或撤回",
  "component": "miniBridge.ts",
  "tags": ["anthropic", "max_tokens", "continuation", "relay", "stream"],
  "category": "protocol_stream",
  "description": "当上游返回 stop_reason: max_tokens 时，流式已输出的前缀必须固化在瀑布流中（无闪烁撤回），并触发 continuation 接力请求继续后续生成，严禁直接丢弃或抛出截断异常。",
  "input": {
    "model": "claude-sonnet-4-5",
    "stopReason": "max_tokens",
    "partialText": "这是前 8192 个 token 的输出..."
  },
  "simulation": {
    "events": [
      {
        "type": "message_delta",
        "delta": { "stop_reason": "max_tokens" },
        "usage": { "output_tokens": 8192 }
      }
    ]
  },
  "negativeMatcher": {
    "forbiddenPatterns": [
      "mini anthropic output truncated at max_tokens unhandled",
      "API Error: Claude's response exceeded",
      "revoke flicker"
    ],
    "forbiddenStates": {
      "continuationFailed": true,
      "prefixDiscarded": true
    }
  },
  "positiveInvariants": {
    "requiredPatterns": [
      "continuing with max_tokens="
    ],
    "requiredStates": {
      "continuationAttempted": true,
      "prefixStreamCommitted": true
    }
  },
  "runner": "verifyMaxTokensContinuation"
}
