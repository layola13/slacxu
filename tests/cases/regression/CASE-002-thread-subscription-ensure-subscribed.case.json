{
  "id": "CASE-002-thread-subscription-ensure-subscribed",
  "title": "普通对话连续发送与历史打开后订阅保证不挂起",
  "component": "threadSubscriptionRegistry.ts",
  "tags": ["subscription", "lifecycle", "waiting-hang", "lease"],
  "category": "lifecycle",
  "description": "2026-08-15 回归：watch() 必须触发 ensureSubscribed()。watcher 或 activeTurnHold 任一存在时必须保持订阅与重试；完成取消观看后 activeTurnHoldCount 与 subscribedThreadCount 必须收敛为 0，防止下一轮发送停在 waiting。",
  "input": {
    "threadId": "thread-regression-sub-test",
    "turnId": "turn-regression-sub-001"
  },
  "simulation": {
    "rounds": [
      {
        "action": "watch",
        "expectEnsureSubscribed": true
      },
      {
        "action": "startTurn",
        "holdActiveTurn": true
      },
      {
        "action": "completeTurn",
        "releaseActiveTurn": true
      },
      {
        "action": "unwatch",
        "expectSettledZero": true
      }
    ]
  },
  "negativeMatcher": {
    "forbiddenPatterns": [
      "activeTurnHoldCount=1, subscribed=false",
      "retryExhausted=true",
      "lease blocked forever"
    ],
    "forbiddenStates": {
      "stuckInWaiting": true,
      "unsettledHoldCount": 1
    }
  },
  "positiveInvariants": {
    "requiredStates": {
      "subscribed": true,
      "settledWatcherCount": 0,
      "settledActiveTurnHoldCount": 0,
      "settledSubscribedThreadCount": 0
    }
  },
  "runner": "verifyThreadSubscriptionLifecycle"
}
