// Converted 1:1 from tests/shared/workspacePermissions.test.ts (CXU plugins, tests tree @ e113825e). Wave-2 test conversion — SLA @test form; assertion semantics preserved 1:1 (expect(x).toEqual({...}) -> field-by-field compares + panic(code) on mismatch).
// DEFECT: test framework | bun:test test/expect has no SLA counterpart; each test() becomes one @test, each expect becomes explicit compares (same registration class as wave-1 test conversions).
// Mapping notes: TS permission id "workspaceAsk" is PermissionPresetId value 1 (table in packages/shared/src/index.sla); TS sandboxPolicy.type "workspaceWrite" is SandboxPolicyValue variant 1 (CodexSandboxMode workspace-write = 1, same file). TS string literals "C:\\Work" / "D:\\Shared" are single-backslash paths, written "C:\\Work" / "D:\\Shared" in SLA literals.
@import "sa_std/string.sa"
@import "sa_std/ptr.sa"
@import "../../packages/shared/src/index.sla"

fn wsp_streq(p1: ptr, l1: u64, p2: ptr, l2: u64, code: u64) {
    if l1 != l2 { panic(code); };
    let i: u64 = 0;
    while i < l1 {
        let a: u8 = 0;
        let b: u8 = 0;
        PTR_BYTE_AT(a, p1, i);
        PTR_BYTE_AT(b, p2, i);
        if a != b { panic(code); };
        i = i + 1;
    }
}

@test "maps additional workspace roots into writable sandbox roots"() {
    let roots = StrList { items: [StrRef { ptr: PTR_NULL(), len: 0 }; 32], len: 0 };
    roots.items[0] = StrRef { ptr: STR_PTR("D:\\Shared"), len: STR_LEN("D:\\Shared") };
    roots.items[1] = StrRef { ptr: STR_PTR("C:\\Work"), len: STR_LEN("C:\\Work") };
    roots.len = 2;
    let out = PermissionTurnOverrides { sandbox: CodexSandboxMode { value: 0 }, sandboxPolicy: SandboxPolicyValue { variant: 0, networkAccess: false, writableRoots: StrList { items: [StrRef { ptr: PTR_NULL(), len: 0 }; 32], len: 0 }, excludeTmpdirEnvVar: false, excludeSlashTmp: false }, approvalPolicy: CodexApprovalPolicy { value: 0 } };
    let ok: bool = permissionToTurnOverrides(1, STR_PTR("C:\\Work"), STR_LEN("C:\\Work"), &roots, &out);
    if !ok { panic(10); };
    if out.sandboxPolicy.variant != 1 { panic(11); };
    if out.sandboxPolicy.writableRoots.len != 2 { panic(12); };
    wsp_streq(out.sandboxPolicy.writableRoots.items[0].ptr, out.sandboxPolicy.writableRoots.items[0].len, STR_PTR("C:\\Work"), STR_LEN("C:\\Work"), 13);
    wsp_streq(out.sandboxPolicy.writableRoots.items[1].ptr, out.sandboxPolicy.writableRoots.items[1].len, STR_PTR("D:\\Shared"), STR_LEN("D:\\Shared"), 14);
    if out.sandboxPolicy.networkAccess { panic(15); };
    if out.sandboxPolicy.excludeTmpdirEnvVar { panic(16); };
    if out.sandboxPolicy.excludeSlashTmp { panic(17); };
}
