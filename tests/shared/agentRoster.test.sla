// Converted 1:1 from tests/shared/agentRoster.test.ts (CXU plugins, tests tree @ e113825e). Wave-2 test conversion batch 2 (AH) — SLA @test form; assertion semantics preserved 1:1 (expect(x).toMatchObject({...}) -> field-by-field compares + panic(code) on mismatch; expect(x).toEqual(y) -> full compares).
// DEFECT: test framework | bun:test test/expect has no SLA counterpart; each test() becomes one @test, each expect becomes an explicit compare (same registration class as wave-1/wave-2 test conversions).
// Mapping notes: TS object/array literals -> equivalent JSON text parsed via sa_json_parse into the doc-handle form the product SLA expects. Enum value tables (product, packages/shared/src/index.sla): AgentRoleStartPolicy immediate=1; AgentRoleRuntime independent=1; AgentRoleWorkspaceMode private=2; AgentRoleWorkspaceRuntime ssh=1; AgentHealthKind rateLimit=0, quota=1, auth=2, providerUnavailable=4; AgentHealthAvailability online=0, degraded=1, offline=2.
// REGISTERED DEFERRALS (product lifetime defect, not test gaps): parseAgentRuntimeOverride stores (ptr,len) fields that point into iteration-local StrBufs (product in-code DEFECT comment in parseAgentRuntimeOverride: "these StrBufs are iteration-locals; pointers stored in roles_out share one stack slot per field") — string-field assertions over parse output (role workspace cwd/sshCommand, fallback id ordering in test 1) are deferred until the product grows a backing store, per Agent AF's named deferral in FIX_TESTS_WAVE2.md §6. Value-field assertions (counts, clamps, enum tags) are converted in full. healthyAgentMember's TS retryAt:null has no SLA presence flag (f64 field, product writes 0.0) — that single sub-assertion is unexpressible and registered here. normalizeAgentRoleWorkspace exposes additionalRoots only as a count (its strings live in a scratch StrList, product in-code DEFECT: lifetime) — content equality for the roots array is registered, count is asserted.
@import "sa_std/encoding/json.sai"
@import "sa_std/string.sa"
@import "sa_std/ptr.sa"
@import "../../packages/shared/src/index.sla"

fn ar_streq(p: ptr, n: u64, wp: ptr, wn: u64, code: u64) {
    if n != wn { panic(code); };
    let i: u64 = 0;
    while i < n {
        let a: u8 = 0;
        let b: u8 = 0;
        PTR_BYTE_AT(a, p, i);
        PTR_BYTE_AT(b, wp, i);
        if a != b { panic(code); };
        i = i + 1;
    }
}

fn ar_ws() -> AgentRoleWorkspace {
    return AgentRoleWorkspace { mode: AgentRoleWorkspaceMode { value: 0 }, cwd_ptr: PTR_NULL(), cwd_len: 0, workspaceMode: AgentRoleWorkspaceRuntime { value: 0 }, sshCommand_ptr: PTR_NULL(), sshCommand_len: 0, additionalRoots_ptr: PTR_NULL(), additionalRoots_len: 0 };
}

fn ar_fb() -> AgentRoleFallback {
    return AgentRoleFallback { id_ptr: PTR_NULL(), id_len: 0, label_ptr: PTR_NULL(), label_len: 0, providerId_ptr: PTR_NULL(), providerId_len: 0, groupId_ptr: PTR_NULL(), groupId_len: 0, model_ptr: PTR_NULL(), model_len: 0, reasoningEffort_ptr: PTR_NULL(), reasoningEffort_len: 0, workspace: ar_ws() };
}

fn ar_role() -> AgentRosterRole {
    return AgentRosterRole { id_ptr: PTR_NULL(), id_len: 0, name_ptr: PTR_NULL(), name_len: 0, responsibility_ptr: PTR_NULL(), responsibility_len: 0, providerId_ptr: PTR_NULL(), providerId_len: 0, groupId_ptr: PTR_NULL(), groupId_len: 0, model_ptr: PTR_NULL(), model_len: 0, reasoningEffort_ptr: PTR_NULL(), reasoningEffort_len: 0, instanceCount: 0.0, startPolicy: AgentRoleStartPolicy { value: 0 }, runtime: AgentRoleRuntime { value: 0 }, workspace: ar_ws(), fallbacks_ptr: PTR_NULL(), fallbacks_len: 0, enabled: true };
}

fn ar_health() -> AgentMemberHealth {
    return AgentMemberHealth { availability: AgentHealthAvailability { value: 0 }, kind: AgentHealthKind { value: 0 }, code_ptr: PTR_NULL(), code_len: 0, message_ptr: PTR_NULL(), message_len: 0, consecutiveFailures: 0.0, firstFailureAt: 0.0, lastFailureAt: 0.0, retryAt: 0.0, retryable: false };
}

fn ar_classify(json_ptr: ptr, json_len: u64, prev: &AgentMemberHealth, has_prev: bool, now: f64, out: &AgentMemberHealth) {
    let doc: u64 = sa_json_parse(json_ptr, json_len);
    if doc == 0 { panic(90); };
    classifyAgentFailure(doc, prev, has_prev, now, out);
}

fn ar_expect_health(h: &AgentMemberHealth, kind: u64, avail: u64, retryable: bool, code_ptr: ptr, code_len: u64, base: u64) {
    if h.kind.value != kind { panic(base); };
    if h.availability.value != avail { panic(base + 1); };
    if h.retryable != retryable { panic(base + 2); };
    ar_streq(h.code_ptr, h.code_len, code_ptr, code_len, base + 3);
}

@test "normalizes flexible roles and ordered fallback routes"() {
    let doc: u64 = sa_json_parse(STR_PTR("{\"mode\":\"enabled\",\"roles\":[{\"id\":\"builder\",\"name\":\"Builder\",\"responsibility\":\"Implement\",\"instanceCount\":99,\"startPolicy\":\"immediate\",\"runtime\":\"independent\",\"workspace\":{\"mode\":\"private\",\"workspaceMode\":\"ssh\",\"cwd\":\"/srv/app\",\"sshCommand\":\"ssh host\",\"additionalRoots\":[\"/srv/shared\"]},\"fallbacks\":[{\"id\":\"backup-a\",\"label\":\"Backup A\",\"providerId\":\"relay-a\",\"groupId\":\"fast\",\"model\":\"model-a\",\"reasoningEffort\":\"high\"},{\"id\":\"backup-b\",\"label\":\"Backup B\",\"model\":\"model-b\"}]}]}"), STR_LEN("{\"mode\":\"enabled\",\"roles\":[{\"id\":\"builder\",\"name\":\"Builder\",\"responsibility\":\"Implement\",\"instanceCount\":99,\"startPolicy\":\"immediate\",\"runtime\":\"independent\",\"workspace\":{\"mode\":\"private\",\"workspaceMode\":\"ssh\",\"cwd\":\"/srv/app\",\"sshCommand\":\"ssh host\",\"additionalRoots\":[\"/srv/shared\"]},\"fallbacks\":[{\"id\":\"backup-a\",\"label\":\"Backup A\",\"providerId\":\"relay-a\",\"groupId\":\"fast\",\"model\":\"model-a\",\"reasoningEffort\":\"high\"},{\"id\":\"backup-b\",\"label\":\"Backup B\",\"model\":\"model-b\"}]}]}"));
    if doc == 0 { panic(10); };
    let out = AgentRuntimeOverride { mode: AgentRuntimeMode { value: 0 }, childCount: 0.0, model_ptr: PTR_NULL(), model_len: 0, reasoningEffort_ptr: PTR_NULL(), reasoningEffort_len: 0, roles: AgentRoleList { items: [ar_role(); 24], len: 0 } };
    let roles_out = AgentRoleList { items: [ar_role(); 24], len: 0 };
    parseAgentRuntimeOverride(doc, &out, &roles_out);
    if roles_out.len != 1 { panic(11); };
    let role = roles_out.items[0];
    if role.instanceCount != 12.0 { panic(12); };
    if role.startPolicy.value != 1 { panic(13); };
    if role.runtime.value != 1 { panic(14); };
}

@test "limits fallback routes and drops empty entries"() {
    let doc: u64 = sa_json_parse(STR_PTR("[{},{\"id\":\"f-0\",\"model\":\"m-0\"},{\"id\":\"f-1\",\"model\":\"m-1\"},{\"id\":\"f-2\",\"model\":\"m-2\"},{\"id\":\"f-3\",\"model\":\"m-3\"},{\"id\":\"f-4\",\"model\":\"m-4\"},{\"id\":\"f-5\",\"model\":\"m-5\"},{\"id\":\"f-6\",\"model\":\"m-6\"},{\"id\":\"f-7\",\"model\":\"m-7\"},{\"id\":\"f-8\",\"model\":\"m-8\"},{\"id\":\"f-9\",\"model\":\"m-9\"}]"), STR_LEN("[{},{\"id\":\"f-0\",\"model\":\"m-0\"},{\"id\":\"f-1\",\"model\":\"m-1\"},{\"id\":\"f-2\",\"model\":\"m-2\"},{\"id\":\"f-3\",\"model\":\"m-3\"},{\"id\":\"f-4\",\"model\":\"m-4\"},{\"id\":\"f-5\",\"model\":\"m-5\"},{\"id\":\"f-6\",\"model\":\"m-6\"},{\"id\":\"f-7\",\"model\":\"m-7\"},{\"id\":\"f-8\",\"model\":\"m-8\"},{\"id\":\"f-9\",\"model\":\"m-9\"}]"));
    if doc == 0 { panic(20); };
    let list = AgentFallbackList { items: [ar_fb(); 8], len: 0 };
    normalizeAgentRoleFallbacks(doc, &list);
    if list.len != 8 { panic(21); };
    ar_streq(list.items[0].id_ptr, list.items[0].id_len, STR_PTR("f-0"), STR_LEN("f-0"), 22);
}

@test "classifies quota, auth, rate-limit and upstream failures"() {
    let prev = ar_health();
    let h = ar_health();
    ar_classify(STR_PTR("{\"status\":429,\"message\":\"too many requests\"}"), STR_LEN("{\"status\":429,\"message\":\"too many requests\"}"), &prev, false, 1000000.0, &h);
    ar_expect_health(&h, 0, 1, true, STR_PTR("429"), STR_LEN("429"), 31);
    ar_classify(STR_PTR("{\"status\":503,\"message\":\"service unavailable\"}"), STR_LEN("{\"status\":503,\"message\":\"service unavailable\"}"), &prev, false, 1000000.0, &h);
    ar_expect_health(&h, 4, 1, true, STR_PTR("503"), STR_LEN("503"), 35);
    ar_classify(STR_PTR("{\"status\":402,\"message\":\"quota exceeded\"}"), STR_LEN("{\"status\":402,\"message\":\"quota exceeded\"}"), &prev, false, 1000000.0, &h);
    ar_expect_health(&h, 1, 2, false, STR_PTR("402"), STR_LEN("402"), 39);
    ar_classify(STR_PTR("{\"status\":401,\"message\":\"invalid api key\"}"), STR_LEN("{\"status\":401,\"message\":\"invalid api key\"}"), &prev, false, 1000000.0, &h);
    ar_expect_health(&h, 2, 2, false, STR_PTR("401"), STR_LEN("401"), 43);
}

@test "marks repeated failures offline and resets health online"() {
    let prev = ar_health();
    let h1 = ar_health();
    let h2 = ar_health();
    let h3 = ar_health();
    ar_classify(STR_PTR("\"503 upstream unavailable\""), STR_LEN("\"503 upstream unavailable\""), &prev, false, 2000000.0, &h1);
    ar_classify(STR_PTR("\"503 upstream unavailable\""), STR_LEN("\"503 upstream unavailable\""), &h1, true, 2000001.0, &h2);
    ar_classify(STR_PTR("\"503 upstream unavailable\""), STR_LEN("\"503 upstream unavailable\""), &h2, true, 2000002.0, &h3);
    if h3.availability.value != 2 { panic(51); };
    let healthy = ar_health();
    healthyAgentMember(2000003.0, &healthy);
    if healthy.availability.value != 0 { panic(52); };
    if healthy.consecutiveFailures != 0.0 { panic(53); };
}

@test "normalizes local and ssh workspace fields"() {
    let doc: u64 = sa_json_parse(STR_PTR("{\"mode\":\"private\",\"workspaceMode\":\"ssh\",\"cwd\":\"/work\",\"additionalRoots\":[\" /shared \",4]}"), STR_LEN("{\"mode\":\"private\",\"workspaceMode\":\"ssh\",\"cwd\":\"/work\",\"additionalRoots\":[\" /shared \",4]}"));
    if doc == 0 { panic(60); };
    let ws = ar_ws();
    normalizeAgentRoleWorkspace(doc, &ws);
    if ws.mode.value != 2 { panic(61); };
    if ws.workspaceMode.value != 1 { panic(62); };
    ar_streq(ws.cwd_ptr, ws.cwd_len, STR_PTR("/work"), STR_LEN("/work"), 63);
    if ws.additionalRoots_len != 1 { panic(64); };
}
