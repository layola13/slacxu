// Converted 1:1 from tests/shared/tokenUsage.test.ts (CXU plugins, tests tree @ e113825e). Wave-2 test conversion — SLA @test form; assertion semantics preserved 1:1 (expect(x).toMatchObject({...}) -> field-by-field compares + panic(code) on mismatch).
// DEFECT: test framework | bun:test test/expect has no SLA counterpart; each test() becomes one @test, each expect becomes explicit compares (same registration class as wave-1 test conversions).
// Input objects are passed as JSON text parsed via sa_json_parse into the doc-handle form the product SLA expects (TS object literal -> equivalent JSON text, key order preserved).
@import "sa_std/encoding/json.sai"
@import "sa_std/string.sa"
@import "../../packages/shared/src/tokenUsage.sla"

fn tu_zero() -> NormalizedTokenUsage {
    return NormalizedTokenUsage { totalTokens: 0.0, inputTokens: 0.0, cachedInputTokens: 0.0, cacheWriteInputTokens: 0.0, outputTokens: 0.0, reasoningOutputTokens: 0.0, source: TokenUsageSource { value: 0 }, reasoningIncludedInOutput: false, reasoningIncludedInOutput_present: false, uncachedInputTokens: 0.0, uncachedInputTokens_present: false };
}

fn tu_run(json_ptr: ptr, json_len: u64, hint: i64, out: &NormalizedTokenUsage, code: u64) {
    let doc: u64 = sa_json_parse(json_ptr, json_len);
    if doc == 0 { panic(code); };
    let ok: bool = normalizeTokenUsage(doc, hint, out);
    if !ok { panic(code); };
}

fn tu_feq(actual: f64, want: f64, code: u64) {
    if actual != want { panic(code); };
}

@test "normalizes Anthropic cache fields without inventing reasoning"() {
    let out = tu_zero();
    tu_run(STR_PTR("{\"input_tokens\":100,\"cache_read_input_tokens\":40,\"cache_creation_input_tokens\":10,\"output_tokens\":20}"), STR_LEN("{\"input_tokens\":100,\"cache_read_input_tokens\":40,\"cache_creation_input_tokens\":10,\"output_tokens\":20}"), 1, &out, 10);
    tu_feq(out.inputTokens, 150.0, 11);
    tu_feq(out.cachedInputTokens, 40.0, 12);
    tu_feq(out.cacheWriteInputTokens, 10.0, 13);
    tu_feq(out.outputTokens, 20.0, 14);
    tu_feq(out.reasoningOutputTokens, 0.0, 15);
    if !out.reasoningIncludedInOutput { panic(16); };
    tu_feq(out.totalTokens, 170.0, 17);
    tu_feq(out.uncachedInputTokens, 100.0, 18);
}

@test "normalizes OpenAI cache and reasoning fields"() {
    let out = tu_zero();
    tu_run(STR_PTR("{\"prompt_tokens\":100,\"completion_tokens\":20,\"prompt_tokens_details\":{\"cached_tokens\":40,\"cache_write_tokens\":10},\"completion_tokens_details\":{\"reasoning_tokens\":5}}"), STR_LEN("{\"prompt_tokens\":100,\"completion_tokens\":20,\"prompt_tokens_details\":{\"cached_tokens\":40,\"cache_write_tokens\":10},\"completion_tokens_details\":{\"reasoning_tokens\":5}}"), 0, &out, 20);
    tu_feq(out.inputTokens, 100.0, 21);
    tu_feq(out.cachedInputTokens, 40.0, 22);
    tu_feq(out.cacheWriteInputTokens, 10.0, 23);
    tu_feq(out.outputTokens, 20.0, 24);
    tu_feq(out.totalTokens, 120.0, 25);
}

@test "treats OpenAI Responses usage (input_tokens + *_details) as inclusive, not Anthropic"() {
    let out = tu_zero();
    tu_run(STR_PTR("{\"input_tokens\":1000,\"input_tokens_details\":{\"cached_tokens\":600},\"output_tokens\":300,\"output_tokens_details\":{\"reasoning_tokens\":200}}"), STR_LEN("{\"input_tokens\":1000,\"input_tokens_details\":{\"cached_tokens\":600},\"output_tokens\":300,\"output_tokens_details\":{\"reasoning_tokens\":200}}"), -1, &out, 30);
    if out.source.value != 0 { panic(31); };
    tu_feq(out.inputTokens, 1000.0, 32);
    tu_feq(out.cachedInputTokens, 600.0, 33);
    tu_feq(out.outputTokens, 300.0, 34);
    tu_feq(out.reasoningOutputTokens, 200.0, 35);
    tu_feq(out.totalTokens, 1300.0, 36);
    tu_feq(out.uncachedInputTokens, 400.0, 37);
}

@test "ring payload flagged reasoningIncludedInOutput does not double-count reasoning"() {
    let out = tu_zero();
    tu_run(STR_PTR("{\"totalTokens\":1300,\"inputTokens\":1000,\"cachedInputTokens\":0,\"cacheWriteInputTokens\":0,\"outputTokens\":300,\"reasoningOutputTokens\":200,\"reasoningIncludedInOutput\":true}"), STR_LEN("{\"totalTokens\":1300,\"inputTokens\":1000,\"cachedInputTokens\":0,\"cacheWriteInputTokens\":0,\"outputTokens\":300,\"reasoningOutputTokens\":200,\"reasoningIncludedInOutput\":true}"), -1, &out, 40);
    tu_feq(out.inputTokens, 1000.0, 41);
    tu_feq(out.outputTokens, 300.0, 42);
    tu_feq(out.totalTokens, 1300.0, 43);
}

@test "normalizes Gemini usage metadata"() {
    let out = tu_zero();
    tu_run(STR_PTR("{\"promptTokenCount\":100,\"candidatesTokenCount\":20,\"cachedContentTokenCount\":40}"), STR_LEN("{\"promptTokenCount\":100,\"candidatesTokenCount\":20,\"cachedContentTokenCount\":40}"), 2, &out, 50);
    tu_feq(out.inputTokens, 100.0, 51);
    tu_feq(out.cachedInputTokens, 40.0, 52);
    tu_feq(out.outputTokens, 20.0, 53);
    tu_feq(out.totalTokens, 120.0, 54);
}

@test "normalizes opencode exclusive splits to inclusive standard"() {
    let out = tu_zero();
    tu_run(STR_PTR("{\"inputTokens\":100,\"cachedInputTokens\":80,\"cacheWriteInputTokens\":20,\"outputTokens\":10,\"reasoningOutputTokens\":30}"), STR_LEN("{\"inputTokens\":100,\"cachedInputTokens\":80,\"cacheWriteInputTokens\":20,\"outputTokens\":10,\"reasoningOutputTokens\":30}"), 4, &out, 60);
    tu_feq(out.inputTokens, 200.0, 61);
    tu_feq(out.cachedInputTokens, 80.0, 62);
    tu_feq(out.cacheWriteInputTokens, 20.0, 63);
    tu_feq(out.outputTokens, 40.0, 64);
    tu_feq(out.reasoningOutputTokens, 30.0, 65);
    tu_feq(out.totalTokens, 240.0, 66);
}
