// Converted 1:1 from backends/cline/src/server.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
//
// Cline (Augment Code) — server side (kind "backend"). Independent
// plugin. Reopened 2026-10-24: the ACP runtime cluster lives under
// src/runtime (ported from the pre-refactor host implementation); the
// host constructs the bridge from there via staging imports.
//
// SDK types (EngineHandle, EngineStatus, PluginInstallation,
// ServerHost, ServerPlugin) come from @cxu/sdk-backend/server —
// see the sdk-backend unit. Re-export of CLINE_MANIFEST mirrors
// `export { CLINE_MANIFEST }` from ./manifest.sla.
@import "./manifest.sla"
@import "sa_std/string.sa"

// class ClineEngine implements EngineHandle.
// #status: EngineStatus = { phase: "stopped", transport: "websocket" } —
// string fields kept as (ptr, len) into string literals.
struct ClineEngine {
    pluginId_ptr: ptr,
    pluginId_len: u64,
    status_phase_ptr: ptr,
    status_phase_len: u64,
    status_transport_ptr: ptr,
    status_transport_len: u64,
}

fn ClineEngine_new(self: &ClineEngine) -> void {
    self.pluginId_ptr = STR_PTR("cline");
    self.pluginId_len = STR_LEN("cline");
    self.status_phase_ptr = STR_PTR("stopped");
    self.status_phase_len = STR_LEN("stopped");
    self.status_transport_ptr = STR_PTR("websocket");
    self.status_transport_len = STR_LEN("websocket");
}

// DEFECT: async — TS `async start(): Promise<EngineStatus>`;
// converted to a synchronous fn returning a status code; the
// resulting EngineStatus is self.status_*.
fn ClineEngine_start(self: &ClineEngine) -> i32 {
    self.status_phase_ptr = STR_PTR("ready");
    self.status_phase_len = STR_LEN("ready");
    self.status_transport_ptr = STR_PTR("websocket");
    self.status_transport_len = STR_LEN("websocket");
    return 0;
}

// DEFECT: async — TS `async stop(): Promise<void>`.
fn ClineEngine_stop(self: &ClineEngine) -> i32 {
    self.status_phase_ptr = STR_PTR("stopped");
    self.status_phase_len = STR_LEN("stopped");
    self.status_transport_ptr = STR_PTR("websocket");
    self.status_transport_len = STR_LEN("websocket");
    return 0;
}

// status(): EngineStatus — TS returns this.#status; here the
// caller reads self.status_phase_* / self.status_transport_*.
fn ClineEngine_status(self: &ClineEngine) -> void {
}

// DEFECT: async + throw + unknown return — TS
// `async handleRpc(): Promise<unknown>` throws
// Error("cline plugin engine is not wired to the host yet (phase 1 declaration)").
// SLA has no exceptions; returns error code 1.
fn ClineEngine_handleRpc(self: &ClineEngine, out_ptr: ptr, out_len: &u64) -> i32 {
    return 1;
}

// export const clineServerPlugin: ServerPlugin — an object
// literal with function properties. SLA struct literals cannot
// hold closures; descriptor data is kept as fields and each
// function property becomes a free fn below.
// DEFECT: dynamic object / closures in ServerPlugin literal.
struct ClineServerPlugin {
    manifest_doc: u64,
    cliSettings_slug_ptr: ptr,
    cliSettings_slug_len: u64,
    cliSettings_enabledEnvVar_ptr: ptr,
    cliSettings_enabledEnvVar_len: u64,
    discovery_preferredPathPrefKey_ptr: ptr,
    discovery_preferredPathPrefKey_len: u64,
}

fn clineServerPlugin_new(self: &ClineServerPlugin, manifest_doc: u64) -> void {
    self.manifest_doc = manifest_doc;
    self.cliSettings_slug_ptr = STR_PTR("cline-cli");
    self.cliSettings_slug_len = STR_LEN("cline-cli");
    self.cliSettings_enabledEnvVar_ptr = STR_PTR("CODEX_UI_CLINE_COMPATIBLE_CLI_ENABLED");
    self.cliSettings_enabledEnvVar_len = STR_LEN("CODEX_UI_CLINE_COMPATIBLE_CLI_ENABLED");
    self.discovery_preferredPathPrefKey_ptr = STR_PTR("cliPreferredClinePath");
    self.discovery_preferredPathPrefKey_len = STR_LEN("cliPreferredClinePath");
}

// discovery.binaryNames: ["cline"]
fn clineServerPlugin_discovery_binaryNames(idx: u64, out: &ptr, out_len: &u64) -> bool {
    if idx != 0 { return false; };
    *out = STR_PTR("cline");
    *out_len = STR_LEN("cline");
    return true;
}

// discovery.envBinVars: ["CLINE_BIN", "CODEX_UI_CLINE_BIN"]
fn clineServerPlugin_discovery_envBinVars(idx: u64, out: &ptr, out_len: &u64) -> bool {
    if idx == 0 {
        *out = STR_PTR("CLINE_BIN");
        *out_len = STR_LEN("CLINE_BIN");
        return true;
    };
    if idx == 1 {
        *out = STR_PTR("CODEX_UI_CLINE_BIN");
        *out_len = STR_LEN("CODEX_UI_CLINE_BIN");
        return true;
    };
    return false;
}

// discovery.matchesKind: () => true
fn clineServerPlugin_discovery_matchesKind() -> bool {
    return true;
}

// createEngine(_host: ServerHost): EngineHandle — returns a new engine.
fn clineServerPlugin_createEngine(host: u64, out: &ClineEngine) -> void {
    ClineEngine_new(out);
}

// DEFECT: async — TS `async findInstallations(): Promise<PluginInstallation[]>` returns [].
fn clineServerPlugin_findInstallations(out_count: &u64) -> i32 {
    *out_count = 0;
    return 0;
}

// skillRoots(): string[] — returns [".cline/skills"].
fn clineServerPlugin_skillRoots(idx: u64, out: &ptr, out_len: &u64) -> bool {
    if idx != 0 { return false; };
    *out = STR_PTR(".cline/skills");
    *out_len = STR_LEN(".cline/skills");
    return true;
}
