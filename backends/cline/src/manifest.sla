// Converted 1:1 from backends/cline/src/manifest.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
//
// Cline manifest — the single source is ../plugin.json; both sides
// import it from here so the web side never pulls in server code.
//
// DEFECT: TS uses a JSON module import assertion
// (`import manifestJson from "../plugin.json" with { type: "json" }`)
// and re-exports it typed as PluginManifest from @cxu/sdk-backend.
// SLA has no JSON module imports and no structural typing; the
// manifest is kept as the raw JSON text of ../plugin.json, parsed
// at load time with sa_json_parse. The PluginManifest struct lives
// in the sdk-backend unit.

// CLINE_MANIFEST: parsed plugin.json document handle (sa_json doc id).
struct ClineManifest {
    doc: u64,
}

// Loads ../plugin.json (relative to this file's plugin root) into
// the manifest holder. Returns 0 on success.
fn CLINE_MANIFEST_load(self: &ClineManifest, json_ptr: ptr, json_len: u64) -> i32 {
    self.doc = sa_json_parse(json_ptr, json_len);
    if self.doc == 0 { return 1; };
    return 0;
}
