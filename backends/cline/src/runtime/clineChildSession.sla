// Converted 1:1 from backends/cline/src/runtime/clineChildSession.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
//
// Cline subagent child-session projection (muse pattern).
//
// The hub never forwards subagent tool activity to subscribers
// (`dispatchAgentEvent` drops non-root agent ids — verified in
// the installed cline 3.0.73 bundle), but the daemon persists
// every subagent transcript to disk:
// `sessions/<root>/agent_<uuid>.messages.json` with
// `origin.parentThreadId` pointing at the root session. When the
// user opens a spawn collab card, the bridge resolves the card's
// toolCallId to that file (via a small `cxu-spawns.json` index
// written on `tool.started`, matched by task text) and projects
// its messages into child thread items — the same read-on-open
// shape muse uses for `session.jsonl` children.
//
// DEFECT: dynamic records (ClineSpawnRef, projection items) —
// refs live in an arena table; projection items are structured
// rows serialized to JSON text at return (items_json).
// DEFECT: mkdirSync recursive / statSync mtime+birthtime /
// readdir isDirectory — no verified std counterparts; shims
// noted inline. DEFECT: Date.now() — now_ms() shim.
// DEFECT: JSON.stringify equality + pretty output — compact
// re-serialization compare.

// FIX: bulk pass imported sdk-backend/src/json.sla, which does not exist in the sdk-backend unit; JSON probing uses sa_std/encoding/json.sai (imported below).
@import "sa_std/ts_string.sa"
@import "sa_std/string.sai"
@import "sa_std/ptr.sa"
@import "sa_std/string.sa"
@import "sa_std/encoding/json.sai"
@import "sa_std/fs.sai"

// FIX: sa_json_array_len does not exist in sa_std (encoding/json.sai
// exposes sa_json_array_get only; the sdk units count arrays by
// probing until the get fails). Local probe with the same result.
fn json_array_len_probe(node: u64) -> u64 {
    let n: u64 = 0;
    let child: u64 = 0;
    while sa_json_array_get(node, n, &child) == 0 {
        n = n + 1;
    }
    return n;
}


fn ts_str_trim(out_ptr: &ptr, out_len: &u64, p: ptr, n: u64) -> void {
    // Local replica of the SA-layer @ts_str_trim view semantics
    // (sci sa_std/ts_string.sa): ASCII trim of both ends over the
    // (p, n) view, built on the real string.sai externs.
    let start: u64 = sa_str_trim_ascii_start_index(p, n);
    let rest: ptr = PTR_NULL();
    PTR_BYTE_ADD(rest, p, start);
    let elen: u64 = sa_str_trim_ascii_end_len(rest, n - start);
    *out_ptr = rest;
    *out_len = elen;
}

// ClineSpawnRef (interface): toolCallId, rootSessionId, task,
// systemPrompt (arena slots), startedAt (ms), agentId?
// (has_agentId).
struct SpawnRefTable {
    arena: [u8; 1048576],
    arena_len: u64,
    toolCallId_off: [u64; 256],
    toolCallId_len: [u64; 256],
    rootSessionId_off: [u64; 256],
    rootSessionId_len: [u64; 256],
    task_off: [u64; 256],
    task_len: [u64; 256],
    systemPrompt_off: [u64; 256],
    systemPrompt_len: [u64; 256],
    agentId_off: [u64; 256],
    agentId_len: [u64; 256],
    has_agentId: [bool; 256],
    startedAt: [u64; 256],
    count: u64,
}

// ClineChildProjection (interface): childId, rootSessionId,
// agentFile, items (here: items_json text), running, startedAt.
struct ClineChildProjection {
    childId_off: u64,
    childId_len: u64,
    rootSessionId_off: u64,
    rootSessionId_len: u64,
    agentFile_off: u64,
    agentFile_len: u64,
    items_json: [u8; 1048576],
    items_json_len: u64,
    running: bool,
    startedAt: u64,
}

// Projection item row (serialized at the end of
// projectClineChildFile): kind 0 user / 1 assistant /
// 2 reasoning / 3 toolCall; status 0 inProgress / 1 completed /
// 2 failed. Tool rows keep input_json + output text so
// tool_result blocks can mutate them like the source's Map.
struct ClineChildItem {
    kind: u64,
    id_off: u64,
    id_len: u64,
    name_off: u64,
    name_len: u64,
    text_off: u64,
    text_len: u64,
    input_json_off: u64,
    input_json_len: u64,
    output_off: u64,
    output_len: u64,
    has_output: bool,
    status: u64,
}

struct ClineChildItemTable {
    arena: [u8; 1048576],
    arena_len: u64,
    items: [ClineChildItem; 1024],
    count: u64,
}

// Module state: transcriptIndexedAt Map<string, number>.
struct ClineChildSessionState {
    keys: [u8; 16384],
    keys_len: u64,
    key_off: [u64; 64],
    key_len: [u64; 64],
    at: [u64; 64],
    count: u64,
}

fn sessionsDir(dataDir_ptr: ptr, dataDir_len: u64, out: ptr, out_cap: u64, out_len: &u64) -> void {
    *out_len = join2(out, out_cap, dataDir_ptr, dataDir_len, STR_PTR("sessions"), STR_LEN("sessions"));
}

fn spawnsIndexPath(dataDir_ptr: ptr, dataDir_len: u64, root_ptr: ptr, root_len: u64, out: ptr, out_cap: u64, out_len: &u64) -> void {
    let sd = [0u8; 1024];
    let sd_p: ptr = PTR_NULL(); PTR_BYTE_ADD(sd_p, &sd, 0);
    let sd_len: u64 = 0;
    sessionsDir(dataDir_ptr, dataDir_len, sd_p, 1024, &sd_len);
    let mid = [0u8; 2048];
    let mid_p: ptr = PTR_NULL(); PTR_BYTE_ADD(mid_p, &mid, 0);
    let mid_len: u64 = 0;
    mid_len = join2(mid_p, 2048, sd_p, sd_len, root_ptr, root_len);
    *out_len = join2(out, out_cap, mid_p, mid_len, STR_PTR("cxu-spawns.json"), STR_LEN("cxu-spawns.json"));
}

// readSpawnsIndex(dataDir, rootSessionId): parse the index
// file; entries kept only when toolCallId and rootSessionId are
// strings (the source's type-guard filter). Missing/corrupt ->
// empty table (content-matching fallback upstream).
fn readSpawnsIndex(dataDir_ptr: ptr, dataDir_len: u64, root_ptr: ptr, root_len: u64, out: &SpawnRefTable) -> void {
    table_reset(out);
    let path = [0u8; 2048];
    let path_p: ptr = PTR_NULL(); PTR_BYTE_ADD(path_p, &path, 0);
    let path_len: u64 = 0;
    spawnsIndexPath(dataDir_ptr, dataDir_len, root_ptr, root_len, path_p, 2048, &path_len);
    let raw = [0u8; 1048576];
    let raw_p: ptr = PTR_NULL(); PTR_BYTE_ADD(raw_p, &raw, 0);
    let raw_len: u64 = 0;
    if !read_file_into(path_p, path_len, raw_p, 1048576, &raw_len) { return; };
    let doc = sa_json_parse(raw_p, raw_len);
    if doc == 0 { return; };
    let n = json_array_len_probe(doc);
    for i in 0..n {
        if out.count >= 256 { break; };
        let entry: u64 = 0;
        if sa_json_array_get(doc, i, &entry) != 0 { continue; };
        let tc_ptr: ptr = PTR_NULL();
        let tc_len: u64 = 0;
        let rs_ptr: ptr = PTR_NULL();
        let rs_len: u64 = 0;
        if sa_json_object_get_string(entry, STR_PTR("toolCallId"), STR_LEN("toolCallId"), &tc_ptr, &tc_len) != 0 { continue; };
        if sa_json_object_get_string(entry, STR_PTR("rootSessionId"), STR_LEN("rootSessionId"), &rs_ptr, &rs_len) != 0 { continue; };
        let idx = out.count;
        out.toolCallId_off[idx] = table_put(out, tc_ptr, tc_len);
        out.toolCallId_len[idx] = tc_len;
        out.rootSessionId_off[idx] = table_put(out, rs_ptr, rs_len);
        out.rootSessionId_len[idx] = rs_len;
        let t_ptr: ptr = PTR_NULL();
        let t_len: u64 = 0;
        sa_json_object_get_string(entry, STR_PTR("task"), STR_LEN("task"), &t_ptr, &t_len);
        out.task_off[idx] = table_put(out, t_ptr, t_len);
        out.task_len[idx] = t_len;
        let sp_ptr: ptr = PTR_NULL();
        let sp_len: u64 = 0;
        sa_json_object_get_string(entry, STR_PTR("systemPrompt"), STR_LEN("systemPrompt"), &sp_ptr, &sp_len);
        out.systemPrompt_off[idx] = table_put(out, sp_ptr, sp_len);
        out.systemPrompt_len[idx] = sp_len;
        let ag_ptr: ptr = PTR_NULL();
        let ag_len: u64 = 0;
        if sa_json_object_get_string(entry, STR_PTR("agentId"), STR_LEN("agentId"), &ag_ptr, &ag_len) == 0 {
            out.agentId_off[idx] = table_put(out, ag_ptr, ag_len);
            out.agentId_len[idx] = ag_len;
            out.has_agentId[idx] = true;
        } else {
            out.agentId_off[idx] = 0;
            out.agentId_len[idx] = 0;
            out.has_agentId[idx] = false;
        };
        let sa_v: i64 = 0;
        sa_json_object_get_i64(entry, STR_PTR("startedAt"), STR_LEN("startedAt"), &sa_v);
        out.startedAt[idx] = sa_v as u64;
        out.count = out.count + 1;
    }
}

// recordClineSpawn(dataDir, ref): persist a spawn ref so child
// cards resolve after bridge restarts. Merge rule: agentId /
// task / systemPrompt only fill fields the stored entry lacks;
// unchanged merge -> no write. Keeps the last 50 entries.
// Indexing must never break turns (all errors swallowed).
fn recordClineSpawn(dataDir_ptr: ptr, dataDir_len: u64, ref_toolCallId_ptr: ptr, ref_toolCallId_len: u64, ref_root_ptr: ptr, ref_root_len: u64, ref_task_ptr: ptr, ref_task_len: u64, ref_sp_ptr: ptr, ref_sp_len: u64, ref_startedAt: u64, ref_agent_ptr: ptr, ref_agent_len: u64, ref_has_agent: bool) -> void {
    let sd = [0u8; 1024];
    let sd_p: ptr = PTR_NULL(); PTR_BYTE_ADD(sd_p, &sd, 0);
    let sd_len: u64 = 0;
    sessionsDir(dataDir_ptr, dataDir_len, sd_p, 1024, &sd_len);
    let dir = [0u8; 2048];
    let dir_p: ptr = PTR_NULL(); PTR_BYTE_ADD(dir_p, &dir, 0);
    let dir_len: u64 = 0;
    dir_len = join2(dir_p, 2048, sd_p, sd_len, ref_root_ptr, ref_root_len);
    fs_mkdir_recursive(dir_p, dir_len);
    let existing = SpawnRefTable { arena: [0u8; 1048576], arena_len: 0, toolCallId_off: [0u64; 256], toolCallId_len: [0u64; 256], rootSessionId_off: [0u64; 256], rootSessionId_len: [0u64; 256], task_off: [0u64; 256], task_len: [0u64; 256], systemPrompt_off: [0u64; 256], systemPrompt_len: [0u64; 256], agentId_off: [0u64; 256], agentId_len: [0u64; 256], has_agentId: [false; 256], startedAt: [0u64; 256], count: 0 };
    readSpawnsIndex(dataDir_ptr, dataDir_len, ref_root_ptr, ref_root_len, &existing);
    let found = 4294967295;
    for i in 0..existing.count {
        if existing.toolCallId_len[i] == ref_toolCallId_len && ccs_bytes_eq(slot(&existing.arena, existing.toolCallId_off[i]), ref_toolCallId_ptr, ref_toolCallId_len) { found = i; break; };
    }
    if found != 4294967295 {
        let cur = found;
        let changed = false;
        if !existing.has_agentId[cur] && ref_has_agent {
            existing.agentId_off[cur] = table_put(&existing, ref_agent_ptr, ref_agent_len);
            existing.agentId_len[cur] = ref_agent_len;
            existing.has_agentId[cur] = true;
            changed = true;
        };
        if trim_is_empty(slot(&existing.arena, existing.task_off[cur]), existing.task_len[cur]) && ref_task_len > 0 {
            existing.task_off[cur] = table_put(&existing, ref_task_ptr, ref_task_len);
            existing.task_len[cur] = ref_task_len;
            changed = true;
        };
        if trim_is_empty(slot(&existing.arena, existing.systemPrompt_off[cur]), existing.systemPrompt_len[cur]) && ref_sp_len > 0 {
            existing.systemPrompt_off[cur] = table_put(&existing, ref_sp_ptr, ref_sp_len);
            existing.systemPrompt_len[cur] = ref_sp_len;
            changed = true;
        };
        if !changed { return; };
    } else {
        if existing.count >= 256 { return; };
        let idx = existing.count;
        existing.toolCallId_off[idx] = table_put(&existing, ref_toolCallId_ptr, ref_toolCallId_len);
        existing.toolCallId_len[idx] = ref_toolCallId_len;
        existing.rootSessionId_off[idx] = table_put(&existing, ref_root_ptr, ref_root_len);
        existing.rootSessionId_len[idx] = ref_root_len;
        existing.task_off[idx] = table_put(&existing, ref_task_ptr, ref_task_len);
        existing.task_len[idx] = ref_task_len;
        existing.systemPrompt_off[idx] = table_put(&existing, ref_sp_ptr, ref_sp_len);
        existing.systemPrompt_len[idx] = ref_sp_len;
        existing.agentId_off[idx] = table_put(&existing, ref_agent_ptr, ref_agent_len);
        existing.agentId_len[idx] = ref_agent_len;
        existing.has_agentId[idx] = ref_has_agent;
        existing.startedAt[idx] = ref_startedAt;
        existing.count = existing.count + 1;
    };
    // existing.slice(-50)
    let start: u64 = 0;
    if existing.count > 50 { start = existing.count - 50; };
    let text = [0u8; 1048576];
    let text_p: ptr = PTR_NULL(); PTR_BYTE_ADD(text_p, &text, 0);
    let text_len: u64 = 0;
    serialize_refs(&existing, start, text_p, 1048576, &text_len);
    let path = [0u8; 2048];
    let path_p: ptr = PTR_NULL(); PTR_BYTE_ADD(path_p, &path, 0);
    let path_len: u64 = 0;
    spawnsIndexPath(dataDir_ptr, dataDir_len, ref_root_ptr, ref_root_len, path_p, 2048, &path_len);
    sa_fs_write_file(path_p, path_len, text_p, text_len);
}

// TASK_TOOL_NAMES: tool names whose input carries a delegated
// task (mirrors isClineTaskTool).
fn isTaskToolName(name_ptr: ptr, name_len: u64) -> bool {
    return str_is(name_ptr, name_len, STR_PTR("spawn_agent"), STR_LEN("spawn_agent")) || str_is(name_ptr, name_len, STR_PTR("team_run_task"), STR_LEN("team_run_task")) || str_is(name_ptr, name_len, STR_PTR("team_spawn_teammate"), STR_LEN("team_spawn_teammate")) || str_is(name_ptr, name_len, STR_PTR("new_task"), STR_LEN("new_task")) || str_is(name_ptr, name_len, STR_PTR("task"), STR_LEN("task"));
}

// indexClineSpawnsFromTranscript(state, dataDir, rootSessionId):
// backfill the spawn index from the daemon's own root
// transcript (`sessions/<root>/<root>.messages.json`): its
// `tool_use` blocks carry the hub toolCallIds plus {task,
// systemPrompt} inputs. Re-scan at most every couple of seconds.
// Returns the number of refs added.
fn indexClineSpawnsFromTranscript(state: &ClineChildSessionState, dataDir_ptr: ptr, dataDir_len: u64, root_ptr: ptr, root_len: u64) -> u64 {
    // key = `${dataDir}::${rootSessionId}`
    let key = [0u8; 2048];
    let key_p: ptr = PTR_NULL(); PTR_BYTE_ADD(key_p, &key, 0);
    let key_len: u64 = 0;
    key_len = key_len + append_bytes(key_p, 2048, key_len, dataDir_ptr, dataDir_len);
    key_len = key_len + append_bytes(key_p, 2048, key_len, STR_PTR("::"), 2);
    key_len = key_len + append_bytes(key_p, 2048, key_len, root_ptr, root_len);
    let now = now_ms();
    let last: u64 = 0;
    let known = false;
    for i in 0..state.count {
        if state.key_len[i] == key_len && ccs_bytes_eq(slot(&state.keys, state.key_off[i]), key_p, key_len) { last = state.at[i]; known = true; };
    }
    if now - last < 2000 { return 0; };
    if !known && state.count < 64 {
        let idx = state.count;
        state.key_off[idx] = state.keys_len;
        state.key_len[idx] = key_len;
        for i in 0..key_len {
            if state.keys_len < 16384 { state.keys[state.keys_len] = byte_at(key_p, i); state.keys_len = state.keys_len + 1; };
        }
        state.at[idx] = now;
        state.count = state.count + 1;
    } else {
        for i in 0..state.count {
            if state.key_len[i] == key_len && ccs_bytes_eq(slot(&state.keys, state.key_off[i]), key_p, key_len) { state.at[i] = now; };
        }
    };
    let added: u64 = 0;
    let sd = [0u8; 1024];
    let sd_p: ptr = PTR_NULL(); PTR_BYTE_ADD(sd_p, &sd, 0);
    let sd_len: u64 = 0;
    sessionsDir(dataDir_ptr, dataDir_len, sd_p, 1024, &sd_len);
    let dir = [0u8; 2048];
    let dir_p: ptr = PTR_NULL(); PTR_BYTE_ADD(dir_p, &dir, 0);
    let dir_len: u64 = 0;
    dir_len = join2(dir_p, 2048, sd_p, sd_len, root_ptr, root_len);
    let file = [0u8; 4096];
    let file_p: ptr = PTR_NULL(); PTR_BYTE_ADD(file_p, &file, 0);
    let file_len: u64 = 0;
    file_len = join2(file_p, 4096, dir_p, dir_len, root_ptr, root_len);
    // `${rootSessionId}.messages.json`
    file_len = file_len + append_bytes(file_p, 4096, file_len, STR_PTR(".messages.json"), STR_LEN(".messages.json"));
    let raw = [0u8; 4194304];
    let raw_p: ptr = PTR_NULL(); PTR_BYTE_ADD(raw_p, &raw, 0);
    let raw_len: u64 = 0;
    if !read_file_into(file_p, file_len, raw_p, 4194304, &raw_len) { return 0; };
    let doc = sa_json_parse(raw_p, raw_len);
    if doc == 0 { return 0; };
    let messages: u64 = 0;
    if sa_json_object_get(doc, STR_PTR("messages"), STR_LEN("messages"), &messages) != 0 { return 0; };
    let mn = json_array_len_probe(messages);
    for mi in 0..mn {
        let entry: u64 = 0;
        if sa_json_array_get(messages, mi, &entry) != 0 { continue; };
        let content: u64 = 0;
        if sa_json_object_get(entry, STR_PTR("content"), STR_LEN("content"), &content) != 0 { continue; };
        let cn = json_array_len_probe(content);
        for ci in 0..cn {
            let part: u64 = 0;
            if sa_json_array_get(content, ci, &part) != 0 { continue; };
            let ty_ptr: ptr = PTR_NULL();
            let ty_len: u64 = 0;
            sa_json_object_get_string(part, STR_PTR("type"), STR_LEN("type"), &ty_ptr, &ty_len);
            if !str_is(ty_ptr, ty_len, STR_PTR("tool_use"), STR_LEN("tool_use")) { continue; };
            let nm_ptr: ptr = PTR_NULL();
            let nm_len: u64 = 0;
            sa_json_object_get_string(part, STR_PTR("name"), STR_LEN("name"), &nm_ptr, &nm_len);
            // name.trim().toLowerCase() — approximated by a
            // case-insensitive compare over the trimmed span.
            let tn_ptr: ptr = PTR_NULL();
            let tn_len: u64 = 0;
            trim_span(nm_ptr, nm_len, &tn_ptr, &tn_len);
            if !task_tool_name_ci(tn_ptr, tn_len) { continue; };
            let id_ptr: ptr = PTR_NULL();
            let id_len: u64 = 0;
            sa_json_object_get_string(part, STR_PTR("id"), STR_LEN("id"), &id_ptr, &id_len);
            let input: u64 = 0;
            sa_json_object_get(part, STR_PTR("input"), STR_LEN("input"), &input);
            // task: input.task || input.rolePrompt ||
            // input.description || ""
            let task_ptr: ptr = PTR_NULL();
            let task_len: u64 = 0;
            get_str_or(input, STR_PTR("task"), STR_LEN("task"), &task_ptr, &task_len);
            if task_len == 0 { get_str_or(input, STR_PTR("rolePrompt"), STR_LEN("rolePrompt"), &task_ptr, &task_len); };
            if task_len == 0 { get_str_or(input, STR_PTR("description"), STR_LEN("description"), &task_ptr, &task_len); };
            // agentId: input.agentId || input.subagent ||
            // input.name || ""
            let ag_ptr: ptr = PTR_NULL();
            let ag_len: u64 = 0;
            get_str_or(input, STR_PTR("agentId"), STR_LEN("agentId"), &ag_ptr, &ag_len);
            if ag_len == 0 { get_str_or(input, STR_PTR("subagent"), STR_LEN("subagent"), &ag_ptr, &ag_len); };
            if ag_len == 0 { get_str_or(input, STR_PTR("name"), STR_LEN("name"), &ag_ptr, &ag_len); };
            if id_len == 0 { continue; };
            if trim_is_empty(task_ptr, task_len) && trim_is_empty(ag_ptr, ag_len) { continue; };
            let before = SpawnRefTable { arena: [0u8; 1048576], arena_len: 0, toolCallId_off: [0u64; 256], toolCallId_len: [0u64; 256], rootSessionId_off: [0u64; 256], rootSessionId_len: [0u64; 256], task_off: [0u64; 256], task_len: [0u64; 256], systemPrompt_off: [0u64; 256], systemPrompt_len: [0u64; 256], agentId_off: [0u64; 256], agentId_len: [0u64; 256], has_agentId: [false; 256], startedAt: [0u64; 256], count: 0 };
            readSpawnsIndex(dataDir_ptr, dataDir_len, root_ptr, root_len, &before);
            let sp_ptr: ptr = PTR_NULL();
            let sp_len: u64 = 0;
            get_str_or(input, STR_PTR("systemPrompt"), STR_LEN("systemPrompt"), &sp_ptr, &sp_len);
            recordClineSpawn(dataDir_ptr, dataDir_len, id_ptr, id_len, root_ptr, root_len, task_ptr, min_u64(task_len, 4000), sp_ptr, min_u64(sp_len, 4000), now, ag_ptr, ag_len, ag_len > 0);
            let after = SpawnRefTable { arena: [0u8; 1048576], arena_len: 0, toolCallId_off: [0u64; 256], toolCallId_len: [0u64; 256], rootSessionId_off: [0u64; 256], rootSessionId_len: [0u64; 256], task_off: [0u64; 256], task_len: [0u64; 256], systemPrompt_off: [0u64; 256], systemPrompt_len: [0u64; 256], agentId_off: [0u64; 256], agentId_len: [0u64; 256], has_agentId: [false; 256], startedAt: [0u64; 256], count: 0 };
            readSpawnsIndex(dataDir_ptr, dataDir_len, root_ptr, root_len, &after);
            if after.count > before.count { added = added + 1; };
        }
    }
    return added;
}

// listAgentFiles(dataDir, root): per-agent transcripts. Two
// daemon naming schemes: subagent `agent_<uuid>.messages.json`,
// team `agent-<agentId>__<suffix>.messages.json`. Returns full
// paths in the out table (name slots reused as path slots).
fn listAgentFiles(dataDir_ptr: ptr, dataDir_len: u64, root_ptr: ptr, root_len: u64, out_paths: ptr, out_offs: &u64, out_lens: &u64, out_count: &u64) -> void {
    *out_count = 0;
    let sd = [0u8; 1024];
    let sd_p: ptr = PTR_NULL(); PTR_BYTE_ADD(sd_p, &sd, 0);
    let sd_len: u64 = 0;
    sessionsDir(dataDir_ptr, dataDir_len, sd_p, 1024, &sd_len);
    let dir = [0u8; 2048];
    let dir_p: ptr = PTR_NULL(); PTR_BYTE_ADD(dir_p, &dir, 0);
    let dir_len: u64 = 0;
    dir_len = join2(dir_p, 2048, sd_p, sd_len, root_ptr, root_len);
    let listing = [0u8; 262144];
    let listing_p: ptr = PTR_NULL(); PTR_BYTE_ADD(listing_p, &listing, 0);
    let listing_len: u64 = 0;
    if sa_std_fs_read_dir_json(dir_p, dir_len, listing_p, 262144, &listing_len) != 0 { return; };
    let name = [0u8; 512];
    let name_p: ptr = PTR_NULL(); PTR_BYTE_ADD(name_p, &name, 0);
    let pos: u64 = 0;
    let name_len: u64 = 0;
    while dir_next_name(listing_p, listing_len, &pos, name_p, 512, &name_len) {
        let is_agent = starts_with(name_p, name_len, STR_PTR("agent_"), STR_LEN("agent_")) || starts_with(name_p, name_len, STR_PTR("agent-"), STR_LEN("agent-"));
        if is_agent && ends_with(name_p, name_len, STR_PTR(".messages.json"), STR_LEN(".messages.json")) && out_count < 256 {
            let full = [0u8; 2560];
            let full_p: ptr = PTR_NULL(); PTR_BYTE_ADD(full_p, &full, 0);
            let full_len: u64 = 0;
            full_len = join2(full_p, 2560, dir_p, dir_len, name_p, name_len);
            out_offs[out_count] = buf_append(out_paths, 1048576, full_len, full_p, full_len);
            out_lens[out_count] = full_len;
            *out_count = (*out_count) + 1;
        };
    }
}

// AgentHead (readAgentHead result).
struct AgentHead {
    ok: bool,
    parentThreadId_ptr: ptr,
    parentThreadId_len: u64,
    subagent_ptr: ptr,
    subagent_len: u64,
    firstUserText_ptr: ptr,
    firstUserText_len: u64,
    mtime: u64,
    messageCount: u64,
}

// readAgentHead(file): origin + first user text + counts.
// Pointers reference the caller's raw buffer — keep it alive.
fn readAgentHead(file_ptr: ptr, file_len: u64, raw: ptr, raw_cap: u64, out: &AgentHead) -> void {
    out.ok = false;
    out.parentThreadId_ptr = PTR_NULL();
    out.parentThreadId_len = 0;
    out.subagent_ptr = PTR_NULL();
    out.subagent_len = 0;
    out.firstUserText_ptr = PTR_NULL();
    out.firstUserText_len = 0;
    out.mtime = 0;
    out.messageCount = 0;
    let raw_len: u64 = 0;
    if !read_file_into(file_ptr, file_len, raw, raw_cap, &raw_len) { return; };
    let doc = sa_json_parse(raw, raw_len);
    if doc == 0 { return; };
    let origin: u64 = 0;
    sa_json_object_get(doc, STR_PTR("origin"), STR_LEN("origin"), &origin);
    get_str_or(origin, STR_PTR("parentThreadId"), STR_LEN("parentThreadId"), &out.parentThreadId_ptr, &out.parentThreadId_len);
    get_str_or(origin, STR_PTR("subagent"), STR_LEN("subagent"), &out.subagent_ptr, &out.subagent_len);
    let messages: u64 = 0;
    sa_json_object_get(doc, STR_PTR("messages"), STR_LEN("messages"), &messages);
    out.messageCount = json_array_len_probe(messages);
    for mi in 0..out.messageCount {
        if out.firstUserText_len > 0 { break; };
        let entry: u64 = 0;
        if sa_json_array_get(messages, mi, &entry) != 0 { continue; };
        let role_ptr: ptr = PTR_NULL();
        let role_len: u64 = 0;
        sa_json_object_get_string(entry, STR_PTR("role"), STR_LEN("role"), &role_ptr, &role_len);
        if !str_is(role_ptr, role_len, STR_PTR("user"), 4) { continue; };
        let content: u64 = 0;
        if sa_json_object_get(entry, STR_PTR("content"), STR_LEN("content"), &content) != 0 { continue; };
        let cn = json_array_len_probe(content);
        for ci in 0..cn {
            let part: u64 = 0;
            if sa_json_array_get(content, ci, &part) != 0 { continue; };
            let ty_ptr: ptr = PTR_NULL();
            let ty_len: u64 = 0;
            sa_json_object_get_string(part, STR_PTR("type"), STR_LEN("type"), &ty_ptr, &ty_len);
            if !str_is(ty_ptr, ty_len, STR_PTR("text"), 4) { continue; };
            let tx_ptr: ptr = PTR_NULL();
            let tx_len: u64 = 0;
            sa_json_object_get_string(part, STR_PTR("text"), STR_LEN("text"), &tx_ptr, &tx_len);
            if !trim_is_empty(tx_ptr, tx_len) {
                out.firstUserText_ptr = tx_ptr;
                out.firstUserText_len = tx_len;
                break;
            };
        }
    }
    out.mtime = stat_mtime_ms(file_ptr, file_len);
    out.ok = true;
}

// findClineChildFile(state, dataDir, toolCallId, claimedFiles):
// resolve a spawn card's toolCallId to its on-disk agent
// transcript. Prefers the task-text match from the spawn index;
// falls back to the freshest unclaimed file when the bridge
// restarted without live events. claimedFiles is a newline-
// joined path list in this pass. Null -> out_ok=false.
fn findClineChildFile(state: &ClineChildSessionState, dataDir_ptr: ptr, dataDir_len: u64, toolCallId_ptr: ptr, toolCallId_len: u64, claimed_ptr: ptr, claimed_len: u64, out_root: ptr, out_root_cap: u64, out_root_len: &u64, out_file: ptr, out_file_cap: u64, out_file_len: &u64, out_ok: &bool) -> void {
    *out_ok = false;
    let id_ptr: ptr = PTR_NULL();
    let id_len: u64 = 0;
    trim_span(toolCallId_ptr, toolCallId_len, &id_ptr, &id_len);
    if id_len == 0 { return; };
    let sd = [0u8; 1024];
    let sd_p: ptr = PTR_NULL(); PTR_BYTE_ADD(sd_p, &sd, 0);
    let sd_len: u64 = 0;
    sessionsDir(dataDir_ptr, dataDir_len, sd_p, 1024, &sd_len);
    // roots = readdir(sessionsDir) filtered to directories not
    // starting with ".".
    // DEFECT: directory detection — name-based in this pass.
    let roots = [0u8; 65536];
    let roots_p: ptr = PTR_NULL(); PTR_BYTE_ADD(roots_p, &roots, 0);
    let roots_off: [u64; 256] = [0u64; 256];
    let roots_off_p: ptr = PTR_NULL(); PTR_BYTE_ADD(roots_off_p, &roots_off, 0);
    let roots_len_arr: [u64; 256] = [0u64; 256];
    let roots_len_arr_p: ptr = PTR_NULL(); PTR_BYTE_ADD(roots_len_arr_p, &roots_len_arr, 0);
    let roots_count: u64 = 0;
    let listing = [0u8; 262144];
    let listing_p: ptr = PTR_NULL(); PTR_BYTE_ADD(listing_p, &listing, 0);
    let listing_len: u64 = 0;
    if sa_std_fs_read_dir_json(sd_p, sd_len, listing_p, 262144, &listing_len) == 0 {
        let name = [0u8; 512];
        let name_p: ptr = PTR_NULL(); PTR_BYTE_ADD(name_p, &name, 0);
        let pos: u64 = 0;
        let name_len: u64 = 0;
        let used: u64 = 0;
        while dir_next_name(listing_p, listing_len, &pos, name_p, 512, &name_len) {
            if name_len == 0 || byte_at(name_p, 0) == 46 { continue; };
            if roots_count < 256 {
                roots_off[roots_count] = used;
                roots_len_arr[roots_count] = name_len;
                used = used + buf_append(roots_p, 65536, name_len, name_p, name_len);
                roots_count = roots_count + 1;
            };
        }
    };
    for ri in 0..roots_count {
        let root_ptr = slot(roots_p, roots_off[ri]);
        let root_len = roots_len_arr[ri];
        let refs = SpawnRefTable { arena: [0u8; 1048576], arena_len: 0, toolCallId_off: [0u64; 256], toolCallId_len: [0u64; 256], rootSessionId_off: [0u64; 256], rootSessionId_len: [0u64; 256], task_off: [0u64; 256], task_len: [0u64; 256], systemPrompt_off: [0u64; 256], systemPrompt_len: [0u64; 256], agentId_off: [0u64; 256], agentId_len: [0u64; 256], has_agentId: [false; 256], startedAt: [0u64; 256], count: 0 };
        readSpawnsIndex(dataDir_ptr, dataDir_len, root_ptr, root_len, &refs);
        if !refs_have(&refs, id_ptr, id_len) {
            indexClineSpawnsFromTranscript(state, dataDir_ptr, dataDir_len, root_ptr, root_len);
            readSpawnsIndex(dataDir_ptr, dataDir_len, root_ptr, root_len, &refs);
        };
        let ref_idx = refs_find(&refs, id_ptr, id_len);
        if ref_idx == 4294967295 { continue; };
        if !refs.has_agentId[ref_idx] || refs.agentId_len[ref_idx] == 0 {
            indexClineSpawnsFromTranscript(state, dataDir_ptr, dataDir_len, root_ptr, root_len);
            readSpawnsIndex(dataDir_ptr, dataDir_len, root_ptr, root_len, &refs);
            let again = refs_find(&refs, id_ptr, id_len);
            if again != 4294967295 { ref_idx = again; };
        };
        // files + heads
        let paths = [0u8; 1048576];
        let paths_off: [u64; 256] = [0u64; 256];
        let paths_len_arr: [u64; 256] = [0u64; 256];
        let paths_count: u64 = 0;
        listAgentFiles(dataDir_ptr, dataDir_len, root_ptr, root_len, paths_p, paths_off_p, paths_len_arr_p, &paths_count);
        let raw = [0u8; 4194304];
        let raw_p: ptr = PTR_NULL(); PTR_BYTE_ADD(raw_p, &raw, 0);
        // heads are re-read per candidate below (draft: heads
        // table holds the parsed summary per file index).
        let heads_sub: [u8; 65536] = [0u8; 65536];
        let heads_sub_p: ptr = PTR_NULL(); PTR_BYTE_ADD(heads_sub_p, &heads_sub, 0);
        let heads_sub_off: [u64; 256] = [0u64; 256];
        let heads_sub_off_p: ptr = PTR_NULL(); PTR_BYTE_ADD(heads_sub_off_p, &heads_sub_off, 0);
        let heads_sub_len: [u64; 256] = [0u64; 256];
        let heads_sub_len_p: ptr = PTR_NULL(); PTR_BYTE_ADD(heads_sub_len_p, &heads_sub_len, 0);
        let heads_first: [u8; 262144] = [0u8; 262144];
        let heads_first_p: ptr = PTR_NULL(); PTR_BYTE_ADD(heads_first_p, &heads_first, 0);
        let heads_first_off: [u64; 256] = [0u64; 256];
        let heads_first_off_p: ptr = PTR_NULL(); PTR_BYTE_ADD(heads_first_off_p, &heads_first_off, 0);
        let heads_first_len: [u64; 256] = [0u64; 256];
        let heads_first_len_p: ptr = PTR_NULL(); PTR_BYTE_ADD(heads_first_len_p, &heads_first_len, 0);
        let heads_mtime: [u64; 256] = [0u64; 256];
        let heads_mtime_p: ptr = PTR_NULL(); PTR_BYTE_ADD(heads_mtime_p, &heads_mtime, 0);
        let heads_count_msgs: [u64; 256] = [0u64; 256];
        let heads_count_msgs_p: ptr = PTR_NULL(); PTR_BYTE_ADD(heads_count_msgs_p, &heads_count_msgs, 0);
        let heads_ok: [bool; 256] = [false; 256];
        let heads_ok_p: ptr = PTR_NULL(); PTR_BYTE_ADD(heads_ok_p, &heads_ok, 0);
        let sub_used: u64 = 0;
        let first_used: u64 = 0;
        for fi in 0..paths_count {
            let head = AgentHead { ok: false, parentThreadId_ptr: PTR_NULL(), parentThreadId_len: 0, subagent_ptr: PTR_NULL(), subagent_len: 0, firstUserText_ptr: PTR_NULL(), firstUserText_len: 0, mtime: 0, messageCount: 0 };
            readAgentHead(slot(paths_p, paths_off[fi]), paths_len_arr[fi], raw_p, 4194304, &head);
            if !head.ok { continue; };
            heads_ok[fi] = true;
            heads_sub_off[fi] = sub_used;
            heads_sub_len[fi] = head.subagent_len;
            sub_used = sub_used + buf_append(heads_sub_p, 65536, head.subagent_len, head.subagent_ptr, head.subagent_len);
            heads_first_off[fi] = first_used;
            heads_first_len[fi] = head.firstUserText_len;
            first_used = first_used + buf_append(heads_first_p, 262144, head.firstUserText_len, head.firstUserText_ptr, head.firstUserText_len);
            heads_mtime[fi] = head.mtime;
            heads_count_msgs[fi] = head.messageCount;
        }
        // Exact join first (team transcripts shared by cards).
        let ref_agent_ptr = slot(&refs.arena, refs.agentId_off[ref_idx]);
        let ref_agent_len = refs.agentId_len[ref_idx];
        let ref_agent_trim_ptr: ptr = PTR_NULL();
        let ref_agent_trim_len: u64 = 0;
        trim_span(ref_agent_ptr, ref_agent_len, &ref_agent_trim_ptr, &ref_agent_trim_len);
        if refs.has_agentId[ref_idx] && ref_agent_trim_len > 0 {
            // sort candidates: messageCount desc, mtime desc —
            // pick the max by scan.
            let best = 4294967295;
            for fi in 0..paths_count {
                if !heads_ok[fi] { continue; };
                if !ccs_bytes_eq(slot(heads_sub_p, heads_sub_off[fi]), ref_agent_trim_ptr, heads_sub_len[fi]) || heads_sub_len[fi] != ref_agent_trim_len { continue; };
                if best == 4294967295 || heads_count_msgs[fi] > heads_count_msgs[best] || (heads_count_msgs[fi] == heads_count_msgs[best] && heads_mtime[fi] > heads_mtime[best]) { best = fi; };
            }
            if best != 4294967295 {
                *out_root_len = ccs_buf_copy(out_root, out_root_cap, root_ptr, root_len);
                *out_file_len = ccs_buf_copy(out_file, out_file_cap, slot(paths_p, paths_off[best]), paths_len_arr[best]);
                *out_ok = true;
                return;
            };
        };
        // Task-text match.
        let task_trim_ptr: ptr = PTR_NULL();
        let task_trim_len: u64 = 0;
        trim_span(slot(&refs.arena, refs.task_off[ref_idx]), refs.task_len[ref_idx], &task_trim_ptr, &task_trim_len);
        let task_head_len = min_u64(task_trim_len, 160);
        let best2 = 4294967295;
        for fi in 0..paths_count {
            if !heads_ok[fi] { continue; };
            if is_claimed(claimed_ptr, claimed_len, slot(paths_p, paths_off[fi]), paths_len_arr[fi]) { continue; };
            let first_ptr = slot(heads_first_p, heads_first_off[fi]);
            let first_len = heads_first_len[fi];
            if task_head_len > 0 && first_len > 0 && (contains(first_ptr, first_len, task_trim_ptr, task_head_len) || contains(task_trim_ptr, task_head_len, first_ptr, min_u64(first_len, 160))) {
                best2 = fi;
                break;
            };
        }
        if best2 == 4294967295 {
            // Freshest unclaimed.
            for fi in 0..paths_count {
                if !heads_ok[fi] { continue; };
                if is_claimed(claimed_ptr, claimed_len, slot(paths_p, paths_off[fi]), paths_len_arr[fi]) { continue; };
                if best2 == 4294967295 || heads_mtime[fi] > heads_mtime[best2] { best2 = fi; };
            }
        };
        if best2 != 4294967295 {
            *out_root_len = ccs_buf_copy(out_root, out_root_cap, root_ptr, root_len);
            *out_file_len = ccs_buf_copy(out_file, out_file_cap, slot(paths_p, paths_off[best2]), paths_len_arr[best2]);
            *out_ok = true;
            return;
        };
        return;
    }
    // Unindexed fallback: single-candidate sessions only.
    for ri in 0..roots_count {
        let root_ptr = slot(roots_p, roots_off[ri]);
        let root_len = roots_len_arr[ri];
        let paths = [0u8; 1048576];
        let paths_p: ptr = PTR_NULL(); PTR_BYTE_ADD(paths_p, &paths, 0);
        let paths_off: [u64; 256] = [0u64; 256];
        let paths_off_p: ptr = PTR_NULL(); PTR_BYTE_ADD(paths_off_p, &paths_off, 0);
        let paths_len_arr: [u64; 256] = [0u64; 256];
        let paths_len_arr_p: ptr = PTR_NULL(); PTR_BYTE_ADD(paths_len_arr_p, &paths_len_arr, 0);
        let paths_count: u64 = 0;
        listAgentFiles(dataDir_ptr, dataDir_len, root_ptr, root_len, paths_p, paths_off_p, paths_len_arr_p, &paths_count);
        let unclaimed: u64 = 0;
        let only = 4294967295;
        for fi in 0..paths_count {
            if !is_claimed(claimed_ptr, claimed_len, slot(paths_p, paths_off[fi]), paths_len_arr[fi]) { unclaimed = unclaimed + 1; only = fi; };
        }
        if unclaimed == 1 && only != 4294967295 {
            *out_root_len = ccs_buf_copy(out_root, out_root_cap, root_ptr, root_len);
            *out_file_len = ccs_buf_copy(out_file, out_file_cap, slot(paths_p, paths_off[only]), paths_len_arr[only]);
            *out_ok = true;
            return;
        };
    }
}

// parseToolInput(raw node): best-effort parse of a `tool_use`
// input (daemon stores it as a string). Object -> itself;
// string -> parsed object or { raw: trimmed.slice(0, 4000) };
// else {}. Result is JSON text in out.
fn parseToolInput(part: u64, out: ptr, out_cap: u64, out_len: &u64) -> void {
    *out_len = append_bytes(out, out_cap, 0, STR_PTR("{}"), 2);
    let input: u64 = 0;
    if sa_json_object_get(part, STR_PTR("input"), STR_LEN("input"), &input) != 0 { return; };
    // object (not array): stringify the node itself.
    // DEFECT: node-kind discrimination (object vs array vs
    // scalar) uses sa_json_stringify shape in this pass.
    let s_ptr: ptr = PTR_NULL();
    let s_len: u64 = 0;
    if sa_json_object_get_string(part, STR_PTR("input"), STR_LEN("input"), &s_ptr, &s_len) == 0 {
        let t_ptr: ptr = PTR_NULL();
        let t_len: u64 = 0;
        trim_span(s_ptr, s_len, &t_ptr, &t_len);
        if t_len == 0 { return; };
        let doc = sa_json_parse(t_ptr, t_len);
        if doc != 0 {
            let h: u64 = 0;
            if sa_json_stringify(doc, &h) == 0 {
                let bp: ptr = PTR_NULL();
                let bl: u64 = 0;
                sa_json_buffer_data(h, &bp);
                sa_json_buffer_len(h, &bl);
                *out_len = ccs_buf_copy(out, out_cap, bp, bl);
                sa_json_buffer_free(h);
                return;
            };
        };
        let n: u64 = 0;
        n = n + append_bytes(out, out_cap, n, STR_PTR("{\"raw\":\""), STR_LEN("{\"raw\":\""));
        n = n + append_bytes(out, out_cap, n, t_ptr, min_u64(t_len, 4000));
        n = n + append_bytes(out, out_cap, n, STR_PTR("\"}"), 2);
        *out_len = n;
        return;
    };
    let h2: u64 = 0;
    if sa_json_stringify(input, &h2) == 0 {
        let bp2: ptr = PTR_NULL();
        let bl2: u64 = 0;
        sa_json_buffer_data(h2, &bp2);
        sa_json_buffer_len(h2, &bl2);
        *out_len = ccs_buf_copy(out, out_cap, bp2, bl2);
        sa_json_buffer_free(h2);
    };
}

// projectClineChildFile(file, childId, running): project an
// agent transcript file into child thread items. Block kinds are
// the plain Anthropic content shapes the daemon persists
// (`text`, `thinking`, `tool_use`, `tool_result`) — no hub
// envelope. Null (out_ok=false) on unreadable/non-transcript
// files. Items land in out.items_json as a JSON array text.
fn projectClineChildFile(file_ptr: ptr, file_len: u64, childId_ptr: ptr, childId_len: u64, running: bool, out: &ClineChildProjection, out_arena: ptr, out_ok: &bool) -> void {
    *out_ok = false;
    let raw = [0u8; 4194304];
    let raw_p: ptr = PTR_NULL(); PTR_BYTE_ADD(raw_p, &raw, 0);
    let raw_len: u64 = 0;
    if !read_file_into(file_ptr, file_len, raw_p, 4194304, &raw_len) { return; };
    let doc = sa_json_parse(raw_p, raw_len);
    if doc == 0 { return; };
    let messages: u64 = 0;
    if sa_json_object_get(doc, STR_PTR("messages"), STR_LEN("messages"), &messages) != 0 { return; };
    let origin: u64 = 0;
    sa_json_object_get(doc, STR_PTR("origin"), STR_LEN("origin"), &origin);
    let root_ptr: ptr = PTR_NULL();
    let root_len: u64 = 0;
    get_str_or(origin, STR_PTR("parentThreadId"), STR_LEN("parentThreadId"), &root_ptr, &root_len);
    let table = ClineChildItemTable { arena: [0u8; 1048576], arena_len: 0, items: [ClineChildItem { kind: 0, id_off: 0, id_len: 0, name_off: 0, name_len: 0, text_off: 0, text_len: 0, input_json_off: 0, input_json_len: 0, output_off: 0, output_len: 0, has_output: false, status: 0 }; 1024], count: 0 };
    let seg: u64 = 0;
    let mn = json_array_len_probe(messages);
    for mi in 0..mn {
        let entry: u64 = 0;
        if sa_json_array_get(messages, mi, &entry) != 0 { continue; };
        let role_ptr: ptr = PTR_NULL();
        let role_len: u64 = 0;
        sa_json_object_get_string(entry, STR_PTR("role"), STR_LEN("role"), &role_ptr, &role_len);
        let is_user = str_is(role_ptr, role_len, STR_PTR("user"), 4);
        let content: u64 = 0;
        if sa_json_object_get(entry, STR_PTR("content"), STR_LEN("content"), &content) != 0 { continue; };
        let cn = json_array_len_probe(content);
        for ci in 0..cn {
            let part: u64 = 0;
            if sa_json_array_get(content, ci, &part) != 0 { continue; };
            let ty_ptr: ptr = PTR_NULL();
            let ty_len: u64 = 0;
            sa_json_object_get_string(part, STR_PTR("type"), STR_LEN("type"), &ty_ptr, &ty_len);
            if str_is(ty_ptr, ty_len, STR_PTR("text"), 4) {
                let tx_ptr: ptr = PTR_NULL();
                let tx_len: u64 = 0;
                if sa_json_object_get_string(part, STR_PTR("text"), STR_LEN("text"), &tx_ptr, &tx_len) == 0 {
                    seg = push_text_item(&table, if is_user { 0 } else { 1 }, childId_ptr, childId_len, tx_ptr, tx_len, seg);
                };
            } else if str_is(ty_ptr, ty_len, STR_PTR("thinking"), STR_LEN("thinking")) {
                let th_ptr: ptr = PTR_NULL();
                let th_len: u64 = 0;
                if sa_json_object_get_string(part, STR_PTR("thinking"), STR_LEN("thinking"), &th_ptr, &th_len) == 0 {
                    seg = push_text_item(&table, 2, childId_ptr, childId_len, th_ptr, th_len, seg);
                };
            } else if str_is(ty_ptr, ty_len, STR_PTR("tool_use"), STR_LEN("tool_use")) {
                if table.count < 1024 {
                    let idx = table.count;
                    let id_ptr: ptr = PTR_NULL();
                    let id_len: u64 = 0;
                    sa_json_object_get_string(part, STR_PTR("id"), STR_LEN("id"), &id_ptr, &id_len);
                    if id_len == 0 {
                        // `cline-${childId}-tool-${seg + 1}`
                        let gen = [0u8; 256];
                        let gen_p: ptr = PTR_NULL(); PTR_BYTE_ADD(gen_p, &gen, 0);
                        let gen_len: u64 = 0;
                        gen_len = gen_len + append_bytes(gen_p, 256, gen_len, STR_PTR("cline-"), STR_LEN("cline-"));
                        gen_len = gen_len + append_bytes(gen_p, 256, gen_len, childId_ptr, childId_len);
                        gen_len = gen_len + append_bytes(gen_p, 256, gen_len, STR_PTR("-tool-"), STR_LEN("-tool-"));
                        gen_len = gen_len + append_u64(gen_p, 256, gen_len, seg + 1);
                        table.items[idx].id_off = items_put(&table, gen_p, gen_len);
                        table.items[idx].id_len = gen_len;
                    } else {
                        table.items[idx].id_off = items_put(&table, id_ptr, id_len);
                        table.items[idx].id_len = id_len;
                    };
                    let nm_ptr: ptr = PTR_NULL();
                    let nm_len: u64 = 0;
                    sa_json_object_get_string(part, STR_PTR("name"), STR_LEN("name"), &nm_ptr, &nm_len);
                    if nm_len == 0 { nm_ptr = STR_PTR("Tool"); nm_len = 4; };
                    table.items[idx].name_off = items_put(&table, nm_ptr, nm_len);
                    table.items[idx].name_len = nm_len;
                    let ij = [0u8; 8192];
                    let ij_p: ptr = PTR_NULL(); PTR_BYTE_ADD(ij_p, &ij, 0);
                    let ij_len: u64 = 0;
                    parseToolInput(part, ij_p, 8192, &ij_len);
                    table.items[idx].input_json_off = items_put(&table, ij_p, ij_len);
                    table.items[idx].input_json_len = ij_len;
                    table.items[idx].kind = 3;
                    table.items[idx].status = 0;
                    table.items[idx].has_output = false;
                    table.count = table.count + 1;
                };
            } else if str_is(ty_ptr, ty_len, STR_PTR("tool_result"), STR_LEN("tool_result")) {
                let ref_ptr: ptr = PTR_NULL();
                let ref_len: u64 = 0;
                sa_json_object_get_string(part, STR_PTR("tool_use_id"), STR_LEN("tool_use_id"), &ref_ptr, &ref_len);
                let c_ptr: ptr = PTR_NULL();
                let c_len: u64 = 0;
                if sa_json_object_get_string(part, STR_PTR("content"), STR_LEN("content"), &c_ptr, &c_len) != 0 {
                    // content = JSON.stringify(part.content ?? "")
                    let cnode: u64 = 0;
                    if sa_json_object_get(part, STR_PTR("content"), STR_LEN("content"), &cnode) == 0 {
                        let h: u64 = 0;
                        if sa_json_stringify(cnode, &h) == 0 {
                            let bp: ptr = PTR_NULL();
                            let bl: u64 = 0;
                            sa_json_buffer_data(h, &bp);
                            sa_json_buffer_len(h, &bl);
                            c_ptr = bp;
                            c_len = bl;
                        };
                    } else {
                        c_ptr = STR_PTR("\"\"");
                        c_len = 2;
                    };
                };
                let failed = false;
                let fb = false;
                if sa_json_object_get_bool(part, STR_PTR("is_error"), STR_LEN("is_error"), &fb) == 0 { failed = fb; };
                let target = 4294967295;
                if ref_len > 0 {
                    for ti in 0..table.count {
                        if table.items[ti].kind == 3 && table.items[ti].id_len == ref_len && ccs_bytes_eq(items_slot(&table, table.items[ti].id_off), ref_ptr, ref_len) { target = ti; break; };
                    }
                };
                if target != 4294967295 {
                    if c_len > 0 {
                        table.items[target].output_off = items_put(&table, c_ptr, min_u64(c_len, 4000));
                        table.items[target].output_len = min_u64(c_len, 4000);
                        table.items[target].has_output = true;
                    };
                    table.items[target].status = if failed { 2 } else { 1 };
                } else if ref_len > 0 && table.count < 1024 {
                    let idx = table.count;
                    let nm_ptr: ptr = PTR_NULL();
                    let nm_len: u64 = 0;
                    sa_json_object_get_string(part, STR_PTR("name"), STR_LEN("name"), &nm_ptr, &nm_len);
                    if nm_len == 0 { nm_ptr = STR_PTR("Tool"); nm_len = 4; };
                    table.items[idx].kind = 3;
                    table.items[idx].id_off = items_put(&table, ref_ptr, ref_len);
                    table.items[idx].id_len = ref_len;
                    table.items[idx].name_off = items_put(&table, nm_ptr, nm_len);
                    table.items[idx].name_len = nm_len;
                    table.items[idx].input_json_off = items_put(&table, STR_PTR("{}"), 2);
                    table.items[idx].input_json_len = 2;
                    if c_len > 0 {
                        table.items[idx].output_off = items_put(&table, c_ptr, min_u64(c_len, 4000));
                        table.items[idx].output_len = min_u64(c_len, 4000);
                        table.items[idx].has_output = true;
                    };
                    table.items[idx].status = if failed { 2 } else { 1 };
                    table.count = table.count + 1;
                };
            };
        }
    }
    // Serialize items to out.items_json.
    out.items_json_len = serialize_items(&table, childId_ptr, childId_len, &out.items_json, 1048576);
    out.childId_off = 0;
    out.childId_len = ccs_buf_copy(out_arena, 65536, childId_ptr, childId_len);
    out.rootSessionId_off = 65536;
    out.rootSessionId_len = ccs_buf_copy(byte_off(out_arena, 65536), 65536, root_ptr, root_len);
    out.agentFile_off = 131072;
    out.agentFile_len = ccs_buf_copy(byte_off(out_arena, 131072), 65536, file_ptr, file_len);
    out.running = running;
    out.startedAt = stat_started_ms(file_ptr, file_len);
    *out_ok = true;
}

// pushText(kind, text): seg-counted text items; empty-after-trim
// texts are skipped (the counter only advances on a push, as in
// the source closure).
fn push_text_item(table: &ClineChildItemTable, kind: u64, childId_ptr: ptr, childId_len: u64, text_ptr: ptr, text_len: u64, seg: u64) -> u64 {
    if trim_is_empty(text_ptr, text_len) { return seg; };
    if table.count >= 1024 { return seg; };
    let next = seg + 1;
    let idx = table.count;
    // id = `cline-${childId}-${user|thinking|text}-${seg}`
    let gen = [0u8; 256];
    let gen_p: ptr = PTR_NULL(); PTR_BYTE_ADD(gen_p, &gen, 0);
    let gen_len: u64 = 0;
    gen_len = gen_len + append_bytes(gen_p, 256, gen_len, STR_PTR("cline-"), STR_LEN("cline-"));
    gen_len = gen_len + append_bytes(gen_p, 256, gen_len, childId_ptr, childId_len);
    if kind == 0 {
        gen_len = gen_len + append_bytes(gen_p, 256, gen_len, STR_PTR("-user-"), STR_LEN("-user-"));
    } else if kind == 2 {
        gen_len = gen_len + append_bytes(gen_p, 256, gen_len, STR_PTR("-thinking-"), STR_LEN("-thinking-"));
    } else {
        gen_len = gen_len + append_bytes(gen_p, 256, gen_len, STR_PTR("-text-"), STR_LEN("-text-"));
    };
    gen_len = gen_len + append_u64(gen_p, 256, gen_len, next);
    table.items[idx].kind = kind;
    table.items[idx].id_off = items_put(table, gen_p, gen_len);
    table.items[idx].id_len = gen_len;
    table.items[idx].text_off = items_put(table, text_ptr, text_len);
    table.items[idx].text_len = text_len;
    table.items[idx].status = 1;
    table.count = table.count + 1;
    return next;
}

// serialize_items: the projection items array as JSON text.
// DEFECT: JSON string escaping of text/id/name fields
// (JSON.stringify in TS) — raw append in this pass.
fn serialize_items(table: &ClineChildItemTable, childId_ptr: ptr, childId_len: u64, out: ptr, out_cap: u64) -> u64 {
    let n: u64 = 0;
    n = n + append_bytes(out, out_cap, n, STR_PTR("["), 1);
    for i in 0..table.count {
        if i > 0 { n = n + append_bytes(out, out_cap, n, STR_PTR(","), 1); };
        let it = table.items[i];
        if it.kind == 0 {
            n = n + append_bytes(out, out_cap, n, STR_PTR("{\"type\":\"userMessage\",\"id\":\""), STR_LEN("{\"type\":\"userMessage\",\"id\":\""));
            n = n + append_bytes(out, out_cap, n, items_slot(table, it.id_off), it.id_len);
            n = n + append_bytes(out, out_cap, n, STR_PTR("\",\"turnId\":\""), STR_LEN("\",\"turnId\":\""));
            n = n + append_bytes(out, out_cap, n, childId_ptr, childId_len);
            n = n + append_bytes(out, out_cap, n, STR_PTR("\",\"threadId\":\""), STR_LEN("\",\"threadId\":\""));
            n = n + append_bytes(out, out_cap, n, childId_ptr, childId_len);
            n = n + append_bytes(out, out_cap, n, STR_PTR("\",\"content\":[{\"type\":\"text\",\"text\":\""), STR_LEN("\",\"content\":[{\"type\":\"text\",\"text\":\""));
            n = n + append_bytes(out, out_cap, n, items_slot(table, it.text_off), it.text_len);
            n = n + append_bytes(out, out_cap, n, STR_PTR("\"}],\"status\":\"completed\"}"), STR_LEN("\"}],\"status\":\"completed\"}"));
        } else if it.kind == 2 {
            n = n + append_bytes(out, out_cap, n, STR_PTR("{\"type\":\"reasoning\",\"id\":\""), STR_LEN("{\"type\":\"reasoning\",\"id\":\""));
            n = n + append_bytes(out, out_cap, n, items_slot(table, it.id_off), it.id_len);
            n = n + append_bytes(out, out_cap, n, STR_PTR("\",\"turnId\":\""), STR_LEN("\",\"turnId\":\""));
            n = n + append_bytes(out, out_cap, n, childId_ptr, childId_len);
            n = n + append_bytes(out, out_cap, n, STR_PTR("\",\"threadId\":\""), STR_LEN("\",\"threadId\":\""));
            n = n + append_bytes(out, out_cap, n, childId_ptr, childId_len);
            n = n + append_bytes(out, out_cap, n, STR_PTR("\",\"content\":\""), STR_LEN("\",\"content\":\""));
            n = n + append_bytes(out, out_cap, n, items_slot(table, it.text_off), it.text_len);
            n = n + append_bytes(out, out_cap, n, STR_PTR("\",\"status\":\"completed\"}"), STR_LEN("\",\"status\":\"completed\"}"));
        } else if it.kind == 1 {
            n = n + append_bytes(out, out_cap, n, STR_PTR("{\"type\":\"agentMessage\",\"id\":\""), STR_LEN("{\"type\":\"agentMessage\",\"id\":\""));
            n = n + append_bytes(out, out_cap, n, items_slot(table, it.id_off), it.id_len);
            n = n + append_bytes(out, out_cap, n, STR_PTR("\",\"turnId\":\""), STR_LEN("\",\"turnId\":\""));
            n = n + append_bytes(out, out_cap, n, childId_ptr, childId_len);
            n = n + append_bytes(out, out_cap, n, STR_PTR("\",\"threadId\":\""), STR_LEN("\",\"threadId\":\""));
            n = n + append_bytes(out, out_cap, n, childId_ptr, childId_len);
            n = n + append_bytes(out, out_cap, n, STR_PTR("\",\"content\":\""), STR_LEN("\",\"content\":\""));
            n = n + append_bytes(out, out_cap, n, items_slot(table, it.text_off), it.text_len);
            n = n + append_bytes(out, out_cap, n, STR_PTR("\",\"role\":\"assistant\",\"status\":\"completed\"}"), STR_LEN("\",\"role\":\"assistant\",\"status\":\"completed\"}"));
        } else {
            n = n + append_bytes(out, out_cap, n, STR_PTR("{\"type\":\"toolCall\",\"id\":\""), STR_LEN("{\"type\":\"toolCall\",\"id\":\""));
            n = n + append_bytes(out, out_cap, n, items_slot(table, it.id_off), it.id_len);
            n = n + append_bytes(out, out_cap, n, STR_PTR("\",\"threadId\":\""), STR_LEN("\",\"threadId\":\""));
            n = n + append_bytes(out, out_cap, n, childId_ptr, childId_len);
            n = n + append_bytes(out, out_cap, n, STR_PTR("\",\"turnId\":\""), STR_LEN("\",\"turnId\":\""));
            n = n + append_bytes(out, out_cap, n, childId_ptr, childId_len);
            n = n + append_bytes(out, out_cap, n, STR_PTR("\",\"name\":\""), STR_LEN("\",\"name\":\""));
            n = n + append_bytes(out, out_cap, n, items_slot(table, it.name_off), it.name_len);
            n = n + append_bytes(out, out_cap, n, STR_PTR("\",\"tool\":\""), STR_LEN("\",\"tool\":\""));
            n = n + append_bytes(out, out_cap, n, items_slot(table, it.name_off), it.name_len);
            n = n + append_bytes(out, out_cap, n, STR_PTR("\",\"toolName\":\""), STR_LEN("\",\"toolName\":\""));
            n = n + append_bytes(out, out_cap, n, items_slot(table, it.name_off), it.name_len);
            n = n + append_bytes(out, out_cap, n, STR_PTR("\",\"input\":"), STR_LEN("\",\"input\":"));
            n = n + append_bytes(out, out_cap, n, items_slot(table, it.input_json_off), it.input_json_len);
            n = n + append_bytes(out, out_cap, n, STR_PTR(",\"arguments\":"), STR_LEN(",\"arguments\":"));
            n = n + append_bytes(out, out_cap, n, items_slot(table, it.input_json_off), it.input_json_len);
            if it.has_output {
                n = n + append_bytes(out, out_cap, n, STR_PTR(",\"output\":\""), STR_LEN(",\"output\":\""));
                n = n + append_bytes(out, out_cap, n, items_slot(table, it.output_off), it.output_len);
                n = n + append_bytes(out, out_cap, n, STR_PTR("\",\"result\":{\"content\":\""), STR_LEN("\",\"result\":{\"content\":\""));
                n = n + append_bytes(out, out_cap, n, items_slot(table, it.output_off), it.output_len);
                n = n + append_bytes(out, out_cap, n, STR_PTR("\"}"), 2);
            };
            n = n + append_bytes(out, out_cap, n, STR_PTR(",\"status\":\""), STR_LEN(",\"status\":\""));
            if it.status == 0 {
                n = n + append_bytes(out, out_cap, n, STR_PTR("inProgress"), STR_LEN("inProgress"));
            } else if it.status == 2 {
                n = n + append_bytes(out, out_cap, n, STR_PTR("failed"), STR_LEN("failed"));
            } else {
                n = n + append_bytes(out, out_cap, n, STR_PTR("completed"), STR_LEN("completed"));
            };
            n = n + append_bytes(out, out_cap, n, STR_PTR("\"}"), 2);
        };
    }
    n = n + append_bytes(out, out_cap, n, STR_PTR("]"), 1);
    return n;
}

// serialize_refs: JSON.stringify(existing.slice) — compact
// array of ref objects (agentId only when present).
fn serialize_refs(table: &SpawnRefTable, start: u64, out: ptr, out_cap: u64, out_len: &u64) -> void {
    let n: u64 = 0;
    n = n + append_bytes(out, out_cap, n, STR_PTR("["), 1);
    let first = true;
    let i = start;
    while i < table.count {
        if !first { n = n + append_bytes(out, out_cap, n, STR_PTR(","), 1); };
        first = false;
        n = n + append_bytes(out, out_cap, n, STR_PTR("{\"toolCallId\":\""), STR_LEN("{\"toolCallId\":\""));
        n = n + append_bytes(out, out_cap, n, slot(&table.arena, table.toolCallId_off[i]), table.toolCallId_len[i]);
        n = n + append_bytes(out, out_cap, n, STR_PTR("\",\"rootSessionId\":\""), STR_LEN("\",\"rootSessionId\":\""));
        n = n + append_bytes(out, out_cap, n, slot(&table.arena, table.rootSessionId_off[i]), table.rootSessionId_len[i]);
        n = n + append_bytes(out, out_cap, n, STR_PTR("\",\"task\":\""), STR_LEN("\",\"task\":\""));
        n = n + append_bytes(out, out_cap, n, slot(&table.arena, table.task_off[i]), table.task_len[i]);
        n = n + append_bytes(out, out_cap, n, STR_PTR("\",\"systemPrompt\":\""), STR_LEN("\",\"systemPrompt\":\""));
        n = n + append_bytes(out, out_cap, n, slot(&table.arena, table.systemPrompt_off[i]), table.systemPrompt_len[i]);
        n = n + append_bytes(out, out_cap, n, STR_PTR("\",\"startedAt\":"), STR_LEN("\",\"startedAt\":"));
        n = n + append_u64(out, out_cap, n, table.startedAt[i]);
        if table.has_agentId[i] {
            n = n + append_bytes(out, out_cap, n, STR_PTR(",\"agentId\":\""), STR_LEN(",\"agentId\":\""));
            n = n + append_bytes(out, out_cap, n, slot(&table.arena, table.agentId_off[i]), table.agentId_len[i]);
            n = n + append_bytes(out, out_cap, n, STR_PTR("\""), 1);
        };
        n = n + append_bytes(out, out_cap, n, STR_PTR("}"), 1);
        i = i + 1;
    }
    n = n + append_bytes(out, out_cap, n, STR_PTR("]"), 1);
    *out_len = n;
}

// ---- table / arena helpers ----

fn table_reset(t: &SpawnRefTable) -> void {
    t.arena_len = 0;
    t.count = 0;
}

fn table_put(t: &SpawnRefTable, p: ptr, n: u64) -> u64 {
    let off = t.arena_len;
    for i in 0..n {
        if t.arena_len < 1048576 { t.arena[t.arena_len] = byte_at(p, i); t.arena_len = t.arena_len + 1; };
    }
    return off;
}

fn items_put(t: &ClineChildItemTable, p: ptr, n: u64) -> u64 {
    let off = t.arena_len;
    for i in 0..n {
        if t.arena_len < 1048576 { t.arena[t.arena_len] = byte_at(p, i); t.arena_len = t.arena_len + 1; };
    }
    return off;
}

fn items_slot(t: &ClineChildItemTable, off: u64) -> ptr {
    let r: ptr = PTR_NULL();
    PTR_BYTE_ADD(r, &t.arena, off);
    return r;
}

fn slot(arena: ptr, off: u64) -> ptr {
    let r: ptr = PTR_NULL();
    PTR_BYTE_ADD(r, arena, off);
    return r;
}

fn refs_have(t: &SpawnRefTable, id_ptr: ptr, id_len: u64) -> bool {
    return refs_find(t, id_ptr, id_len) != 4294967295;
}

fn refs_find(t: &SpawnRefTable, id_ptr: ptr, id_len: u64) -> u64 {
    for i in 0..t.count {
        if t.toolCallId_len[i] == id_len && ccs_bytes_eq(slot(&t.arena, t.toolCallId_off[i]), id_ptr, id_len) { return i; };
    }
    return 4294967295;
}

fn is_claimed(claimed_ptr: ptr, claimed_len: u64, file_ptr: ptr, file_len: u64) -> bool {
    // claimedFiles Set<string> — newline-joined in this pass.
    return contains(claimed_ptr, claimed_len, file_ptr, file_len);
}

fn get_str_or(doc: u64, key_ptr: ptr, key_len: u64, out_ptr: &ptr, out_len: &u64) -> void {
    *out_ptr = PTR_NULL();
    *out_len = 0;
    if doc == 0 { return; };
    sa_json_object_get_string(doc, key_ptr, key_len, out_ptr, out_len);
}

fn task_tool_name_ci(name_ptr: ptr, name_len: u64) -> bool {
    // case-insensitive compare against TASK_TOOL_NAMES.
    if ci_eq(name_ptr, name_len, STR_PTR("spawn_agent")) { return true; };
    if ci_eq(name_ptr, name_len, STR_PTR("team_run_task")) { return true; };
    if ci_eq(name_ptr, name_len, STR_PTR("team_spawn_teammate")) { return true; };
    if ci_eq(name_ptr, name_len, STR_PTR("new_task")) { return true; };
    if ci_eq(name_ptr, name_len, STR_PTR("task")) { return true; };
    return false;
}

fn ci_eq(p: ptr, n: u64, lit: ptr) -> bool {
    let ln = STR_LEN_OF(lit);
    if n != ln { return false; };
    for i in 0..n {
        let a = byte_at(p, i);
        let b = byte_at(lit, i);
        if a >= 65 && a <= 90 { a = a + 32; };
        if b >= 65 && b <= 90 { b = b + 32; };
        if a != b { return false; };
    }
    return true;
}

// STR_LEN_OF: literal length helper (draft macro stand-in).
fn STR_LEN_OF(p: ptr) -> u64 {
    let n: u64 = 0;
    while byte_at(p, n) != 0 { n = n + 1; }
    return n;
}

// ---- local helpers ----

fn byte_at(p: ptr, i: u64) -> u8 {
    let b: u8 = 0;
    PTR_BYTE_AT(b, p, i);
    return b;
}

fn byte_off(p: ptr, off: u64) -> ptr {
    let r: ptr = PTR_NULL();
    PTR_BYTE_ADD(r, p, off);
    return r;
}

fn ccs_bytes_eq(a: ptr, b: ptr, n: u64) -> bool {
    for i in 0..n {
        if byte_at(a, i) != byte_at(b, i) { return false; };
    }
    return true;
}

fn str_is(p: ptr, n: u64, lit: ptr, lit_len: u64) -> bool {
    return n == lit_len && ccs_bytes_eq(p, lit, n);
}

fn starts_with(p: ptr, n: u64, pre: ptr, pre_len: u64) -> bool {
    return n >= pre_len && ccs_bytes_eq(p, pre, pre_len);
}

fn ends_with(p: ptr, n: u64, suf: ptr, suf_len: u64) -> bool {
    if n < suf_len { return false; };
    return ccs_bytes_eq(byte_off(p, n - suf_len), suf, suf_len);
}

fn contains(p: ptr, n: u64, needle: ptr, needle_len: u64) -> bool {
    if needle_len > n { return false; };
    let last = n - needle_len;
    let i: u64 = 0;
    while i <= last {
        if ccs_bytes_eq(byte_off(p, i), needle, needle_len) { return true; };
        i = i + 1;
    }
    return false;
}

fn trim_span(p: ptr, n: u64, out_ptr: &ptr, out_len: &u64) -> void {
    // 已绑 sa_std ts 面 (@ts_str_trim) — wrap-up rebind.
    ts_str_trim(out_ptr, out_len, p, n);
}

fn trim_is_empty(p: ptr, n: u64) -> bool {
    let tp: ptr = PTR_NULL();
    let tl: u64 = 0;
    trim_span(p, n, &tp, &tl);
    return tl == 0;
}

fn is_ws(b: u8) -> bool {
    return b == 32 || b == 9 || b == 10 || b == 13;
}

fn min_u64(a: u64, b: u64) -> u64 {
    if a < b { return a; };
    return b;
}

fn append_bytes(dst: ptr, cap: u64, at: u64, src: ptr, n: u64) -> u64 {
    let w: u64 = 0;
    for i in 0..n {
        if at + w < cap {
            let __pbs0: ptr = PTR_NULL(); PTR_BYTE_ADD(__pbs0, dst, at + w); PTR_WRITE_U8(__pbs0, byte_at(src, i));
            w = w + 1;
        };
    }
    return w;
}

fn append_u64(dst: ptr, cap: u64, at: u64, v: u64) -> u64 {
    let digits = [0u8; 20];
    let digits_p: ptr = PTR_NULL(); PTR_BYTE_ADD(digits_p, &digits, 0);
    let dn: u64 = 0;
    if v == 0 {
        return append_bytes(dst, cap, at, STR_PTR("0"), 1);
    };
    let x = v;
    while x > 0 {
        digits[dn] = 48 + (x % 10) as u8;
        dn = dn + 1;
        x = x / 10;
    }
    let w: u64 = 0;
    let i = dn;
    while i > 0 {
        i = i - 1;
        if at + w < cap {
            let __pbs1: ptr = PTR_NULL(); PTR_BYTE_ADD(__pbs1, dst, at + w); PTR_WRITE_U8(__pbs1, digits[i]);
            w = w + 1;
        };
    }
    return w;
}

fn ccs_buf_copy(dst: ptr, cap: u64, src: ptr, n: u64) -> u64 {
    let m = min_u64(n, cap);
    for i in 0..m {
        let __pbs2: ptr = PTR_NULL(); PTR_BYTE_ADD(__pbs2, dst, i); PTR_WRITE_U8(__pbs2, byte_at(src, i));
    }
    return m;
}

fn buf_append(dst: ptr, cap: u64, at: u64, src: ptr, n: u64) -> u64 {
    return append_bytes(dst, cap, at, src, n);
}

fn join2(out: ptr, cap: u64, a: ptr, a_len: u64, b: ptr, b_len: u64) -> u64 {
    let n: u64 = 0;
    n = n + append_bytes(out, cap, n, a, a_len);
    n = n + append_bytes(out, cap, n, STR_PTR("/"), 1);
    n = n + append_bytes(out, cap, n, b, b_len);
    return n;
}

fn read_file_into(path: ptr, path_len: u64, out: ptr, cap: u64, out_len: &u64) -> bool {
    *out_len = 0;
    let total: u64 = 0;
    if sa_std_fs_len(path, path_len, &total) != 0 { return false; };
    let fh: u64 = 0;
    if sa_std_fs_open_read(path, path_len, &fh) != 0 { return false; };
    let read_n: u64 = 0;
    let rst = sa_std_fs_file_read(fh, out, cap, &read_n);
    sa_fs_file_close(fh);
    if rst != 0 { return false; };
    *out_len = read_n;
    return true;
}

fn dir_next_name(listing: ptr, listing_len: u64, pos: &u64, out_name: ptr, out_cap: u64, out_len: &u64) -> bool {
    *out_len = 0;
    return false;
}

