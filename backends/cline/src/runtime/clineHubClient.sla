// Converted 1:1 from backends/cline/src/runtime/clineHubClient.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
//
// Client for the Cline CLI's own hub daemon — the interface the
// vendor's TUI/kanban clients use, reverse-engineered from the
// cline 3.0.73 binary and verified live against it (2026-10-24).
// ACP was rejected by the user (too restrictive, and it refuses
// sessions without a vendor login); the hub protocol has neither
// problem: providers are plain BYOK config.
//
// Protocol (protocolVersion "v1"):
//  - The daemon is started with `cline hub start
//    --discovery-path <file>` and writes a discovery record
//    {url, authToken, pid, ...} there. It is a detached process;
//    CLINE_DATA_DIR pins its state directory.
//  - Transport: WebSocket to <url> (ws://127.0.0.1:<port>/hub)
//    with the auth token as a subprotocol:
//    `cline-hub-auth.<authToken>`.
//  - Commands: {kind:"command", envelope:{version:"v1",
//    command, requestId, clientId, sessionId?, timeoutMs,
//    payload}}; replies come back as {kind:"reply",
//    envelope:{version, requestId, ok, payload?, error?}}.
//  - The first command on a socket must be client.register.
//  - Events arrive as {kind:"event", envelope:{version, event,
//    eventId, sessionId, timestamp, payload, sequence?}} after
//    sending a raw {kind:"stream.subscribe", clientId,
//    sessionId?} frame (no sessionId = all sessions; events may
//    be delivered twice when both a global and a per-session
//    subscription match — consumers dedupe by eventId).
//  - Turns: session.create (provider/model ride in
//    payload.metadata) then run.enqueue {prompt}; completion is
//    the run.completed / run.failed event, whose payload.result
//    carries {text, usage, messages}.
//
// DEFECT: WebSocket client — sa_std has a built-in WS core but
// no verified SLA client surface in this pass; ws_* shims are
// declared by use. DEFECT: Promise pending map — pending
// entries carry result slots the owner polls after feeding
// inbound frames (handleMessage); timeouts are evaluated by
// the owner's poll loop, not setTimeout. DEFECT: EventEmitter
// ("event" / "disconnected") — an event queue buffer with
// `kind\tpayload\n` records. DEFECT: Math.random / process.pid
// / process.kill(pid, 0) — shims. DEFECT: runtimeEnv callback
// — the caller supplies an env snapshot text.

@import "./clineCommand.sla"
// FIX: bulk pass imported sdk-backend/src/process.sla, which does not exist in the sdk-backend unit (vestigial import removed; faces come from sa_std .sai imports).@import "sa_std/ts_string.sa"
@import "sa_std/string.sai"
@import "sa_std/ptr.sa"
@import "sa_std/string.sa"
@import "sa_std/encoding/json.sai"
@import "sa_std/fs.sai"

fn chc_ts_str_trim(out_ptr: &ptr, out_len: &u64, p: ptr, n: u64) -> void {
    // Local replica of the SA-layer @ts_str_trim view semantics
    // (sci sa_std/ts_string.sa): ASCII trim of both ends over the
    // (p, n) view, built on the real string.sai externs.
    let start: u64 = sa_str_trim_ascii_start_index(p, n);
    let rest: ptr = PTR_NULL();
    PTR_BYTE_ADD(rest, p, start);
    let elen: u64 = sa_str_trim_ascii_end_len(rest, n - start);
    *out_ptr = rest;
    *out_len = elen;
}

// CLINE_MIN_HUB_VERSION: minimum CLI that supports
// `hub start --discovery-path` (reverse-engineered from 3.0.73
// and verified live against it). Older CLIs fail hub start with
// `unknown option '--discovery-path'` — gate here with an
// actionable error instead of surfacing the raw vendor usage
// text.
fn CLINE_MIN_HUB_VERSION_ptr() -> ptr { return STR_PTR("3.0.73"); }
fn CLINE_MIN_HUB_VERSION_len() -> u64 { return STR_LEN("3.0.73"); }

// compareClineVersions(a, b): numeric triple compare
// (-1 | 0 | 1); non-numeric segments count as 0.
fn compareClineVersions(a_ptr: ptr, a_len: u64, b_ptr: ptr, b_len: u64) -> i64 {
    let pa: [i64; 8] = [0i64; 8];
    let pa_p: ptr = PTR_NULL(); PTR_BYTE_ADD(pa_p, &pa, 0);
    let pa_n: u64 = 0;
    split_version(a_ptr, a_len, pa_p, &pa_n);
    let pb: [i64; 8] = [0i64; 8];
    let pb_p: ptr = PTR_NULL(); PTR_BYTE_ADD(pb_p, &pb, 0);
    let pb_n: u64 = 0;
    split_version(b_ptr, b_len, pb_p, &pb_n);
    let len = pa_n;
    if pb_n > len { len = pb_n; };
    for i in 0..len {
        let x: i64 = 0;
        if i < pa_n { x = pa[i]; };
        let y: i64 = 0;
        if i < pb_n { y = pb[i]; };
        if x < y { return 0 - 1; };
        if x > y { return 1; };
    }
    return 0;
}

// isClineHubSupported(version): whether the probed CLI can
// serve the hub protocol. Unknown (probe failed) proceeds — the
// spawn failure itself surfaces. Known-old fails fast.
fn isClineHubSupported(version_ptr: ptr, version_len: u64, has_version: bool) -> bool {
    if !has_version { return true; };
    let tp: ptr = PTR_NULL();
    let tl: u64 = 0;
    chc_trim_span(version_ptr, version_len, &tp, &tl);
    if tl == 0 { return true; };
    return compareClineVersions(tp, tl, CLINE_MIN_HUB_VERSION_ptr(), CLINE_MIN_HUB_VERSION_len()) >= 0;
}

// ClineHubDiscovery (interface): url, authToken, pid?, hubId?.
struct ClineHubDiscovery {
    url_ptr: ptr,
    url_len: u64,
    authToken_ptr: ptr,
    authToken_len: u64,
    pid: i64,
    has_pid: bool,
    hubId_ptr: ptr,
    hubId_len: u64,
    has_hubId: bool,
}

// ClineHubEvent (interface): event, eventId?, sessionId?,
// timestamp?, sequence?, payload (doc handle) — delivered
// through the client's event queue as JSON text.

// Pending command entry: requestId -> result slot (status:
// 0 waiting, 1 resolved (payload doc), 2 rejected (error text
// in the arena)).
struct ClineHubPending {
    requestId_off: u64,
    requestId_len: u64,
    status: u64,
    payload_doc: u64,
    err_off: u64,
    err_len: u64,
    deadline_ms: u64,
    name_off: u64,
    name_len: u64,
}

struct ClineHubClient {
    binPath_ptr: ptr,
    binPath_len: u64,
    dataDir_ptr: ptr,
    dataDir_len: u64,
    env_ptr: ptr,
    env_len: u64,
    has_env: bool,
    ws: u64,
    has_socket: bool,
    registered: bool,
    connecting: bool,
    pending: [ClineHubPending; 256],
    pending_count: u64,
    subscribed: [u8; 65536],
    subscribed_len: u64,
    subscribed_off: [u64; 128],
    subscribed_slen: [u64; 128],
    subscribed_count: u64,
    globalSubscribed: bool,
    requestSeq: u64,
    clientId: [u8; 64],
    clientId_len: u64,
    arena: [u8; 262144],
    arena_len: u64,
    eventQueue: [u8; 1048576],
    eventQueue_len: u64,
}

// REGISTER_TIMEOUT_MS = 30_000

fn ClineHubClient_new(self: &ClineHubClient, binPath_ptr: ptr, binPath_len: u64, dataDir_ptr: ptr, dataDir_len: u64, env_ptr: ptr, env_len: u64, has_env: bool) -> void {
    self.binPath_ptr = binPath_ptr;
    self.binPath_len = binPath_len;
    self.dataDir_ptr = dataDir_ptr;
    self.dataDir_len = dataDir_len;
    self.env_ptr = env_ptr;
    self.env_len = env_len;
    self.has_env = has_env;
    self.ws = 0;
    self.has_socket = false;
    self.registered = false;
    self.connecting = false;
    self.pending_count = 0;
    self.subscribed_len = 0;
    self.subscribed_count = 0;
    self.globalSubscribed = false;
    self.requestSeq = 0;
    self.arena_len = 0;
    self.eventQueue_len = 0;
    // clientId = `core-cxu-${Math.random().toString(36).slice(2, 10)}`
    self.clientId_len = 0;
    self.clientId_len = self.clientId_len + chc_append_bytes(&self.clientId, 64, self.clientId_len, STR_PTR("core-cxu-"), STR_LEN("core-cxu-"));
    let suffix = [0u8; 16];
    let suffix_p: ptr = PTR_NULL(); PTR_BYTE_ADD(suffix_p, &suffix, 0);
    let suffix_len: u64 = 0;
    random_base36(suffix_p, 16, &suffix_len);
    let take = suffix_len;
    if take > 8 { take = 8; };
    self.clientId_len = self.clientId_len + chc_append_bytes(&self.clientId, 64, self.clientId_len, suffix_p, take);
}

// discoveryPath getter: join(dataDir, "hub-discovery.json").
fn ClineHubClient_discoveryPath(self: &ClineHubClient, out: ptr, out_cap: u64, out_len: &u64) -> void {
    *out_len = chc_join2(out, out_cap, self.dataDir_ptr, self.dataDir_len, STR_PTR("hub-discovery.json"), STR_LEN("hub-discovery.json"));
}

// ensureHub(): start the hub daemon unless a compatible one is
// already running. Blocking form of the source's async method:
// spawn + wait, then read the discovery record. Errors are
// written to out_err (code 1) with the source's messages.
fn ClineHubClient_ensureHub(self: &ClineHubClient, versionCache: &ClineVersionCache, out: &ClineHubDiscovery, out_err: ptr, out_err_cap: u64, out_err_len: &u64) -> i32 {
    let existing = ClineHubDiscovery { url_ptr: PTR_NULL(), url_len: 0, authToken_ptr: PTR_NULL(), authToken_len: 0, pid: 0, has_pid: false, hubId_ptr: PTR_NULL(), hubId_len: 0, has_hubId: false };
    let has_existing = false;
    ClineHubClient_readDiscovery(self, &existing, &has_existing);
    if has_existing && existing.has_pid && existing.pid != 0 && isProcessAlive(existing.pid) {
        out.url_ptr = existing.url_ptr;
        out.url_len = existing.url_len;
        out.authToken_ptr = existing.authToken_ptr;
        out.authToken_len = existing.authToken_len;
        out.pid = existing.pid;
        out.has_pid = existing.has_pid;
        out.hubId_ptr = existing.hubId_ptr;
        out.hubId_len = existing.hubId_len;
        out.has_hubId = existing.has_hubId;
        return 0;
    };
    let ver_ptr: ptr = PTR_NULL();
    let ver_len: u64 = 0;
    let has_ver = false;
    probeClineVersion(versionCache, self.binPath_ptr, self.binPath_len, &ver_ptr, &ver_len, &has_ver);
    if !isClineHubSupported(ver_ptr, ver_len, has_ver) {
        let n: u64 = 0;
        n = n + chc_append_bytes(out_err, out_err_cap, n, STR_PTR("cline hub requires CLI >= 3.0.73 for --discovery-path (found "), STR_LEN("cline hub requires CLI >= 3.0.73 for --discovery-path (found "));
        n = n + chc_append_bytes(out_err, out_err_cap, n, ver_ptr, ver_len);
        n = n + chc_append_bytes(out_err, out_err_cap, n, STR_PTR("); update with 'npm update -g cline' and retry"), STR_LEN("); update with 'npm update -g cline' and retry"));
        *out_err_len = n;
        return 1;
    };
    // env = { ...(runtimeEnv?.() ?? process.env),
    //   CLINE_DATA_DIR: dataDir } — caller snapshot + override.
    let env_text = [0u8; 16384];
    let env_text_p: ptr = PTR_NULL(); PTR_BYTE_ADD(env_text_p, &env_text, 0);
    let env_text_len: u64 = 0;
    if self.has_env {
        env_text_len = env_text_len + chc_append_bytes(env_text_p, 16384, env_text_len, self.env_ptr, self.env_len);
    };
    env_text_len = env_text_len + chc_append_bytes(env_text_p, 16384, env_text_len, STR_PTR("CLINE_DATA_DIR="), STR_LEN("CLINE_DATA_DIR="));
    env_text_len = env_text_len + chc_append_bytes(env_text_p, 16384, env_text_len, self.dataDir_ptr, self.dataDir_len);
    env_text_len = env_text_len + chc_append_bytes(env_text_p, 16384, env_text_len, STR_PTR("\n"), 1);
    // spawnCli(binPath, ["hub", "start", "--discovery-path",
    // discoveryPath], { env, stdio: ["ignore","pipe","pipe"] })
    let dpath = [0u8; 1024];
    let dpath_p: ptr = PTR_NULL(); PTR_BYTE_ADD(dpath_p, &dpath, 0);
    let dpath_len: u64 = 0;
    ClineHubClient_discoveryPath(self, dpath_p, 1024, &dpath_len);
    let code = run_hub_start(self.binPath_ptr, self.binPath_len, dpath_p, dpath_len, env_text_p, env_text_len, out_err, out_err_cap, out_err_len);
    if code != 0 {
        // reject(new Error(`cline hub start failed (${code}):
        // ${stderr.slice(0, 300)}`)) — out_err carries stderr;
        // the prefix is the caller's to format in this pass.
        return 1;
    };
    let discovery = ClineHubDiscovery { url_ptr: PTR_NULL(), url_len: 0, authToken_ptr: PTR_NULL(), authToken_len: 0, pid: 0, has_pid: false, hubId_ptr: PTR_NULL(), hubId_len: 0, has_hubId: false };
    let has_discovery = false;
    ClineHubClient_readDiscovery(self, &discovery, &has_discovery);
    if !has_discovery {
        *out_err_len = chc_append_bytes(out_err, out_err_cap, 0, STR_PTR("cline hub did not write a discovery record"), STR_LEN("cline hub did not write a discovery record"));
        return 1;
    };
    out.url_ptr = discovery.url_ptr;
    out.url_len = discovery.url_len;
    out.authToken_ptr = discovery.authToken_ptr;
    out.authToken_len = discovery.authToken_len;
    out.pid = discovery.pid;
    out.has_pid = discovery.has_pid;
    out.hubId_ptr = discovery.hubId_ptr;
    out.hubId_len = discovery.hubId_len;
    out.has_hubId = discovery.has_hubId;
    return 0;
}

fn ClineHubClient_readDiscovery(self: &ClineHubClient, out: &ClineHubDiscovery, out_ok: &bool) -> void {
    *out_ok = false;
    let dpath = [0u8; 1024];
    let dpath_p: ptr = PTR_NULL(); PTR_BYTE_ADD(dpath_p, &dpath, 0);
    let dpath_len: u64 = 0;
    ClineHubClient_discoveryPath(self, dpath_p, 1024, &dpath_len);
    let total: u64 = 0;
    if sa_std_fs_len(dpath_p, dpath_len, &total) != 0 { return; };
    let raw = [0u8; 65536];
    let raw_p: ptr = PTR_NULL(); PTR_BYTE_ADD(raw_p, &raw, 0);
    let raw_len: u64 = 0;
    if !chc_read_file_into(dpath_p, dpath_len, raw_p, 65536, &raw_len) { return; };
    let doc = sa_json_parse(raw_p, raw_len);
    if doc == 0 { return; };
    if sa_json_object_get_string(doc, STR_PTR("url"), STR_LEN("url"), &out.url_ptr, &out.url_len) != 0 { return; };
    if sa_json_object_get_string(doc, STR_PTR("authToken"), STR_LEN("authToken"), &out.authToken_ptr, &out.authToken_len) != 0 { return; };
    let pid_v: i64 = 0;
    if sa_json_object_get_i64(doc, STR_PTR("pid"), STR_LEN("pid"), &pid_v) == 0 {
        out.pid = pid_v;
        out.has_pid = true;
    } else {
        out.pid = 0;
        out.has_pid = false;
    };
    if sa_json_object_get_string(doc, STR_PTR("hubId"), STR_LEN("hubId"), &out.hubId_ptr, &out.hubId_len) == 0 {
        out.has_hubId = true;
    } else {
        out.has_hubId = false;
    };
    *out_ok = true;
}

// connect(): ensure the hub, open the socket, register, and
// restore subscriptions. Blocking form: the ws shim connects
// synchronously in this pass.
// DEFECT: the connectPromise de-dup collapses (a re-entrant
// connect during connect is not representable synchronously).
fn ClineHubClient_connect(self: &ClineHubClient, versionCache: &ClineVersionCache, out_err: ptr, out_err_cap: u64, out_err_len: &u64) -> i32 {
    if self.has_socket && self.registered { return 0; };
    let discovery = ClineHubDiscovery { url_ptr: PTR_NULL(), url_len: 0, authToken_ptr: PTR_NULL(), authToken_len: 0, pid: 0, has_pid: false, hubId_ptr: PTR_NULL(), hubId_len: 0, has_hubId: false };
    let rc = ClineHubClient_ensureHub(self, versionCache, &discovery, out_err, out_err_cap, out_err_len);
    if rc != 0 { return rc; };
    let sub = [0u8; 8192];
    let sub_p: ptr = PTR_NULL(); PTR_BYTE_ADD(sub_p, &sub, 0);
    let sub_len: u64 = 0;
    sub_len = sub_len + chc_append_bytes(sub_p, 8192, sub_len, STR_PTR("cline-hub-auth."), STR_LEN("cline-hub-auth."));
    sub_len = sub_len + chc_append_bytes(sub_p, 8192, sub_len, discovery.authToken_ptr, discovery.authToken_len);
    let ws: u64 = 0;
    if ws_connect(discovery.url_ptr, discovery.url_len, sub_p, sub_len, &ws) != 0 {
        *out_err_len = chc_append_bytes(out_err, out_err_cap, 0, STR_PTR("cline hub socket failed to open"), STR_LEN("cline hub socket failed to open"));
        return 1;
    };
    self.ws = ws;
    self.has_socket = true;
    // await commandOnce("client.register", {...}, undefined,
    // REGISTER_TIMEOUT_MS, true)
    let payload = [0u8; 1024];
    let payload_p: ptr = PTR_NULL(); PTR_BYTE_ADD(payload_p, &payload, 0);
    let payload_len: u64 = 0;
    payload_len = payload_len + chc_append_bytes(payload_p, 1024, payload_len, STR_PTR("{\"clientId\":\""), STR_LEN("{\"clientId\":\""));
    payload_len = payload_len + chc_append_bytes(payload_p, 1024, payload_len, &self.clientId, self.clientId_len);
    payload_len = payload_len + chc_append_bytes(payload_p, 1024, payload_len, STR_PTR("\",\"clientType\":\"cxu-bridge\",\"displayName\":\"codex-react-ui cline bridge\",\"transport\":\"native\",\"actorKind\":\"client\",\"capabilities\":[],\"metadata\":{\"version\":\"0.0.95\",\"pid\":"), STR_LEN("\",\"clientType\":\"cxu-bridge\",\"displayName\":\"codex-react-ui cline bridge\",\"transport\":\"native\",\"actorKind\":\"client\",\"capabilities\":[],\"metadata\":{\"version\":\"0.0.95\",\"pid\":"));
    payload_len = payload_len + append_i64(payload_p, 1024, payload_len, process_pid());
    payload_len = payload_len + chc_append_bytes(payload_p, 1024, payload_len, STR_PTR("},\"workspaceContext\":{}}"), STR_LEN("},\"workspaceContext\":{}}"));
    let req = [0u8; 128];
    let req_p: ptr = PTR_NULL(); PTR_BYTE_ADD(req_p, &req, 0);
    let req_len: u64 = 0;
    let crc = ClineHubClient_commandOnce(self, STR_PTR("client.register"), STR_LEN("client.register"), payload_p, payload_len, PTR_NULL(), 0, false, 30000, true, req_p, 128, &req_len, out_err, out_err_cap, out_err_len);
    if crc != 0 { return crc; };
    // The register reply is awaited by the owner's pump in this
    // pass; the source sets registered = true after the await.
    self.registered = true;
    // Restore subscriptions after (re)connect.
    if self.globalSubscribed { ClineHubClient_sendSubscribe(self, PTR_NULL(), 0, false); };
    for i in 0..self.subscribed_count {
        ClineHubClient_sendSubscribe(self, chc_slot(&self.subscribed, self.subscribed_off[i]), self.subscribed_slen[i], true);
    }
    return 0;
}

fn ClineHubClient_handleSocketClosed(self: &ClineHubClient) -> void {
    self.registered = false;
    self.has_socket = false;
    for i in 0..self.pending_count {
        if self.pending[i].status == 0 {
            self.pending[i].status = 2;
            let msg = [0u8; 256];
            let msg_p: ptr = PTR_NULL(); PTR_BYTE_ADD(msg_p, &msg, 0);
            let msg_len: u64 = 0;
            msg_len = msg_len + chc_append_bytes(msg_p, 256, msg_len, STR_PTR("cline hub connection closed (request "), STR_LEN("cline hub connection closed (request "));
            msg_len = msg_len + chc_append_bytes(msg_p, 256, msg_len, chc_slot(&self.arena, self.pending[i].requestId_off), self.pending[i].requestId_len);
            msg_len = msg_len + chc_append_bytes(msg_p, 256, msg_len, STR_PTR(")"), 1);
            self.pending[i].err_off = hub_arena_put(self, msg_p, msg_len);
            self.pending[i].err_len = msg_len;
        };
    }
    self.pending_count = 0;
    queue_event(self, STR_PTR("disconnected"), STR_LEN("disconnected"), PTR_NULL(), 0);
}

// handleMessage(text): reply resolution + event fan-out. The
// owner feeds inbound frames here (the ws shim's poll in the
// repair phase).
fn ClineHubClient_handleMessage(self: &ClineHubClient, text_ptr: ptr, text_len: u64) -> void {
    let msg = sa_json_parse(text_ptr, text_len);
    if msg == 0 { return; };
    let envelope = msg;
    let env_node: u64 = 0;
    if sa_json_object_get(msg, STR_PTR("envelope"), STR_LEN("envelope"), &env_node) == 0 { envelope = env_node; };
    let kind_ptr: ptr = PTR_NULL();
    let kind_len: u64 = 0;
    sa_json_object_get_string(msg, STR_PTR("kind"), STR_LEN("kind"), &kind_ptr, &kind_len);
    if chc_str_is(kind_ptr, kind_len, STR_PTR("reply"), STR_LEN("reply")) {
        let rid_ptr: ptr = PTR_NULL();
        let rid_len: u64 = 0;
        if sa_json_object_get_string(envelope, STR_PTR("requestId"), STR_LEN("requestId"), &rid_ptr, &rid_len) != 0 { return; };
        let idx = 4294967295;
        for i in 0..self.pending_count {
            if self.pending[i].requestId_len == rid_len && chc_bytes_eq(chc_slot(&self.arena, self.pending[i].requestId_off), rid_ptr, rid_len) { idx = i; break; };
        }
        if idx == 4294967295 { return; };
        let ok = false;
        let okb = false;
        if sa_json_object_get_bool(envelope, STR_PTR("ok"), STR_LEN("ok"), &okb) == 0 { ok = okb; };
        if ok {
            let payload: u64 = 0;
            sa_json_object_get(envelope, STR_PTR("payload"), STR_LEN("payload"), &payload);
            self.pending[idx].payload_doc = payload;
            self.pending[idx].status = 1;
        } else {
            let err_node: u64 = 0;
            sa_json_object_get(envelope, STR_PTR("error"), STR_LEN("error"), &err_node);
            let m_ptr: ptr = PTR_NULL();
            let m_len: u64 = 0;
            if err_node != 0 && sa_json_object_get_string(err_node, STR_PTR("message"), STR_LEN("message"), &m_ptr, &m_len) == 0 {
                self.pending[idx].err_off = hub_arena_put(self, m_ptr, m_len);
                self.pending[idx].err_len = m_len;
            } else {
                self.pending[idx].err_off = hub_arena_put(self, STR_PTR("cline hub command failed"), STR_LEN("cline hub command failed"));
                self.pending[idx].err_len = STR_LEN("cline hub command failed");
            };
            self.pending[idx].status = 2;
        };
        pending_remove(self, idx);
        return;
    };
    if chc_str_is(kind_ptr, kind_len, STR_PTR("event"), STR_LEN("event")) {
        // ClineHubEvent assembled as JSON text (envelope fields
        // + payload verbatim via stringify).
        let ev = [0u8; 65536];
        let ev_p: ptr = PTR_NULL(); PTR_BYTE_ADD(ev_p, &ev, 0);
        let ev_len: u64 = 0;
        ev_len = ev_len + chc_append_bytes(ev_p, 65536, ev_len, STR_PTR("{\"event\":\""), STR_LEN("{\"event\":\""));
        let e_ptr: ptr = PTR_NULL();
        let e_len: u64 = 0;
        sa_json_object_get_string(envelope, STR_PTR("event"), STR_LEN("event"), &e_ptr, &e_len);
        ev_len = ev_len + chc_append_bytes(ev_p, 65536, ev_len, e_ptr, e_len);
        ev_len = append_opt_str(ev_p, 65536, ev_len, envelope, STR_PTR("eventId"), STR_LEN("eventId"));
        ev_len = append_opt_str(ev_p, 65536, ev_len, envelope, STR_PTR("sessionId"), STR_LEN("sessionId"));
        ev_len = append_opt_num(ev_p, 65536, ev_len, envelope, STR_PTR("timestamp"), STR_LEN("timestamp"));
        ev_len = append_opt_num(ev_p, 65536, ev_len, envelope, STR_PTR("sequence"), STR_LEN("sequence"));
        ev_len = ev_len + chc_append_bytes(ev_p, 65536, ev_len, STR_PTR(",\"payload\":"), STR_LEN(",\"payload\":"));
        let payload: u64 = 0;
        if sa_json_object_get(envelope, STR_PTR("payload"), STR_LEN("payload"), &payload) == 0 {
            let h: u64 = 0;
            if sa_json_stringify(payload, &h) == 0 {
                let bp: ptr = PTR_NULL();
                let bl: u64 = 0;
                sa_json_buffer_data(h, &bp);
                sa_json_buffer_len(h, &bl);
                ev_len = ev_len + chc_append_bytes(ev_p, 65536, ev_len, bp, bl);
                sa_json_buffer_free(h);
            } else {
                ev_len = ev_len + chc_append_bytes(ev_p, 65536, ev_len, STR_PTR("{}"), 2);
            };
        } else {
            ev_len = ev_len + chc_append_bytes(ev_p, 65536, ev_len, STR_PTR("{}"), 2);
        };
        ev_len = ev_len + chc_append_bytes(ev_p, 65536, ev_len, STR_PTR("}"), 1);
        if e_len > 0 { queue_event(self, STR_PTR("event"), STR_LEN("event"), ev_p, ev_len); };
    };
}

fn ClineHubClient_sendSubscribe(self: &ClineHubClient, sessionId_ptr: ptr, sessionId_len: u64, has_session: bool) -> void {
    if !self.has_socket || !ws_is_open(self.ws) { return; };
    let frame = [0u8; 1024];
    let frame_p: ptr = PTR_NULL(); PTR_BYTE_ADD(frame_p, &frame, 0);
    let frame_len: u64 = 0;
    frame_len = frame_len + chc_append_bytes(frame_p, 1024, frame_len, STR_PTR("{\"kind\":\"stream.subscribe\",\"clientId\":\""), STR_LEN("{\"kind\":\"stream.subscribe\",\"clientId\":\""));
    frame_len = frame_len + chc_append_bytes(frame_p, 1024, frame_len, &self.clientId, self.clientId_len);
    frame_len = frame_len + chc_append_bytes(frame_p, 1024, frame_len, STR_PTR("\""), 1);
    if has_session {
        frame_len = frame_len + chc_append_bytes(frame_p, 1024, frame_len, STR_PTR(",\"sessionId\":\""), STR_LEN(",\"sessionId\":\""));
        frame_len = frame_len + chc_append_bytes(frame_p, 1024, frame_len, sessionId_ptr, sessionId_len);
        frame_len = frame_len + chc_append_bytes(frame_p, 1024, frame_len, STR_PTR("\""), 1);
    };
    frame_len = frame_len + chc_append_bytes(frame_p, 1024, frame_len, STR_PTR("}"), 1);
    ws_send(self.ws, frame_p, frame_len);
}

// subscribe(sessionId?): subscribe to one session's events (or
// all sessions when omitted).
fn ClineHubClient_subscribe(self: &ClineHubClient, sessionId_ptr: ptr, sessionId_len: u64, has_session: bool) -> void {
    if has_session {
        for i in 0..self.subscribed_count {
            if self.subscribed_slen[i] == sessionId_len && chc_bytes_eq(chc_slot(&self.subscribed, self.subscribed_off[i]), sessionId_ptr, sessionId_len) { return; };
        }
        if self.subscribed_count < 128 {
            let idx = self.subscribed_count;
            self.subscribed_off[idx] = self.subscribed_len;
            self.subscribed_slen[idx] = sessionId_len;
            for i in 0..sessionId_len {
                if self.subscribed_len < 65536 { self.subscribed[self.subscribed_len] = chc_byte_at(sessionId_ptr, i); self.subscribed_len = self.subscribed_len + 1; };
            }
            self.subscribed_count = self.subscribed_count + 1;
        };
    } else {
        if self.globalSubscribed { return; };
        self.globalSubscribed = true;
    };
    ClineHubClient_sendSubscribe(self, sessionId_ptr, sessionId_len, has_session);
}

// command(name, payload, sessionId?, timeoutMs): one
// transparent reconnect + retry, mirroring the vendor client.
// In this pass commandOnce registers the pending entry and
// sends; the RESULT is collected from the pending table by the
// owner's pump (see log). Returns the requestId text.
fn ClineHubClient_command(self: &ClineHubClient, versionCache: &ClineVersionCache, name_ptr: ptr, name_len: u64, payload_ptr: ptr, payload_len: u64, sessionId_ptr: ptr, sessionId_len: u64, has_session: bool, timeoutMs: u64, out_req: ptr, out_req_cap: u64, out_req_len: &u64, out_err: ptr, out_err_cap: u64, out_err_len: &u64) -> i32 {
    let rc = ClineHubClient_commandOnce(self, name_ptr, name_len, payload_ptr, payload_len, sessionId_ptr, sessionId_len, has_session, timeoutMs, false, out_req, out_req_cap, out_req_len, out_err, out_err_cap, out_err_len);
    if rc == 0 { return 0; };
    if chc_str_is(name_ptr, name_len, STR_PTR("client.register"), STR_LEN("client.register")) { return rc; };
    self.registered = false;
    if self.has_socket { ws_close(self.ws); };
    self.has_socket = false;
    return ClineHubClient_commandOnce(self, name_ptr, name_len, payload_ptr, payload_len, sessionId_ptr, sessionId_len, has_session, timeoutMs, false, out_req, out_req_cap, out_req_len, out_err, out_err_cap, out_err_len);
}

fn ClineHubClient_commandOnce(self: &ClineHubClient, name_ptr: ptr, name_len: u64, payload_ptr: ptr, payload_len: u64, sessionId_ptr: ptr, sessionId_len: u64, has_session: bool, timeoutMs: u64, skipConnect: bool, out_req: ptr, out_req_cap: u64, out_req_len: &u64, out_err: ptr, out_err_cap: u64, out_err_len: &u64) -> i32 {
    if !skipConnect {
        // await this.connect() — needs the version cache; the
        // caller-driven form passes through connect() first in
        // this pass (see log).
    };
    if !self.has_socket || !ws_is_open(self.ws) {
        *out_err_len = chc_append_bytes(out_err, out_err_cap, 0, STR_PTR("cline hub socket is not open"), STR_LEN("cline hub socket is not open"));
        return 1;
    };
    // requestId = `hubreq_${Date.now()}_${++this.requestSeq}`
    self.requestSeq = self.requestSeq + 1;
    let rid = [0u8; 128];
    let rid_p: ptr = PTR_NULL(); PTR_BYTE_ADD(rid_p, &rid, 0);
    let rid_len: u64 = 0;
    rid_len = rid_len + chc_append_bytes(rid_p, 128, rid_len, STR_PTR("hubreq_"), STR_LEN("hubreq_"));
    rid_len = rid_len + chc_append_u64(rid_p, 128, rid_len, chc_now_ms());
    rid_len = rid_len + chc_append_bytes(rid_p, 128, rid_len, STR_PTR("_"), 1);
    rid_len = rid_len + chc_append_u64(rid_p, 128, rid_len, self.requestSeq);
    if self.pending_count < 256 {
        let idx = self.pending_count;
        self.pending[idx].requestId_off = hub_arena_put(self, rid_p, rid_len);
        self.pending[idx].requestId_len = rid_len;
        self.pending[idx].name_off = hub_arena_put(self, name_ptr, name_len);
        self.pending[idx].name_len = name_len;
        self.pending[idx].status = 0;
        self.pending[idx].payload_doc = 0;
        self.pending[idx].err_off = 0;
        self.pending[idx].err_len = 0;
        self.pending[idx].deadline_ms = chc_now_ms() + timeoutMs;
        self.pending_count = self.pending_count + 1;
    };
    // socket.send(JSON.stringify({ kind: "command", envelope:
    // { version: "v1", command, requestId, clientId, sessionId?,
    // timeoutMs, payload } }))
    // DEFECT: payload is already-serialized JSON text here; the
    // source embeds the payload object (equivalent on the wire).
    let frame = [0u8; 1048576];
    let frame_p: ptr = PTR_NULL(); PTR_BYTE_ADD(frame_p, &frame, 0);
    let frame_len: u64 = 0;
    frame_len = frame_len + chc_append_bytes(frame_p, 1048576, frame_len, STR_PTR("{\"kind\":\"command\",\"envelope\":{\"version\":\"v1\",\"command\":\""), STR_LEN("{\"kind\":\"command\",\"envelope\":{\"version\":\"v1\",\"command\":\""));
    frame_len = frame_len + chc_append_bytes(frame_p, 1048576, frame_len, name_ptr, name_len);
    frame_len = frame_len + chc_append_bytes(frame_p, 1048576, frame_len, STR_PTR("\",\"requestId\":\""), STR_LEN("\",\"requestId\":\""));
    frame_len = frame_len + chc_append_bytes(frame_p, 1048576, frame_len, rid_p, rid_len);
    frame_len = frame_len + chc_append_bytes(frame_p, 1048576, frame_len, STR_PTR("\",\"clientId\":\""), STR_LEN("\",\"clientId\":\""));
    frame_len = frame_len + chc_append_bytes(frame_p, 1048576, frame_len, &self.clientId, self.clientId_len);
    frame_len = frame_len + chc_append_bytes(frame_p, 1048576, frame_len, STR_PTR("\""), 1);
    if has_session {
        frame_len = frame_len + chc_append_bytes(frame_p, 1048576, frame_len, STR_PTR(",\"sessionId\":\""), STR_LEN(",\"sessionId\":\""));
        frame_len = frame_len + chc_append_bytes(frame_p, 1048576, frame_len, sessionId_ptr, sessionId_len);
        frame_len = frame_len + chc_append_bytes(frame_p, 1048576, frame_len, STR_PTR("\""), 1);
    };
    frame_len = frame_len + chc_append_bytes(frame_p, 1048576, frame_len, STR_PTR(",\"timeoutMs\":"), STR_LEN(",\"timeoutMs\":"));
    frame_len = frame_len + chc_append_u64(frame_p, 1048576, frame_len, timeoutMs);
    frame_len = frame_len + chc_append_bytes(frame_p, 1048576, frame_len, STR_PTR(",\"payload\":"), STR_LEN(",\"payload\":"));
    if payload_len > 0 {
        frame_len = frame_len + chc_append_bytes(frame_p, 1048576, frame_len, payload_ptr, payload_len);
    } else {
        frame_len = frame_len + chc_append_bytes(frame_p, 1048576, frame_len, STR_PTR("{}"), 2);
    };
    frame_len = frame_len + chc_append_bytes(frame_p, 1048576, frame_len, STR_PTR("}}"), 2);
    ws_send(self.ws, frame_p, frame_len);
    *out_req_len = chc_buf_copy(out_req, out_req_cap, rid_p, rid_len);
    return 0;
}

fn ClineHubClient_close(self: &ClineHubClient) -> void {
    if self.has_socket { ws_close(self.ws); };
    self.has_socket = false;
    self.registered = false;
}

// isProcessAlive(pid): process.kill(pid, 0) probe.
// DEFECT: no verified std kill-probe surface — shim.
fn isProcessAlive(pid: i64) -> bool {
    return pid > 0 && process_alive(pid);
}

// run_hub_start: spawnCli + drain stderr + wait; nonzero exit
// writes `cline hub start failed (<code>): <stderr[:300]>` to
// out_err and returns 1.
fn run_hub_start(bin_ptr: ptr, bin_len: u64, dpath_ptr: ptr, dpath_len: u64, env_ptr: ptr, env_len: u64, out_err: ptr, out_err_cap: u64, out_err_len: &u64) -> i32 {
    let argv = [0u8; 4096];
    let argv_p: ptr = PTR_NULL(); PTR_BYTE_ADD(argv_p, &argv, 0);
    let offs: [u64; 5] = [0u64; 5];
    let offs_p: ptr = PTR_NULL(); PTR_BYTE_ADD(offs_p, &offs, 0);
    let lens: [u64; 5] = [0u64; 5];
    let lens_p: ptr = PTR_NULL(); PTR_BYTE_ADD(lens_p, &lens, 0);
    let used: u64 = 0;
    offs[0] = used;
    used = used + chc_append_bytes(argv_p, 4096, used, bin_ptr, bin_len);
    lens[0] = bin_len;
    offs[1] = used;
    used = used + chc_append_bytes(argv_p, 4096, used, STR_PTR("hub"), 3);
    lens[1] = 3;
    offs[2] = used;
    used = used + chc_append_bytes(argv_p, 4096, used, STR_PTR("start"), 5);
    lens[2] = 5;
    offs[3] = used;
    used = used + chc_append_bytes(argv_p, 4096, used, STR_PTR("--discovery-path"), STR_LEN("--discovery-path"));
    lens[3] = STR_LEN("--discovery-path");
    offs[4] = used;
    used = used + chc_append_bytes(argv_p, 4096, used, dpath_ptr, dpath_len);
    lens[4] = dpath_len;
    let proc: u64 = 0;
    let hin: u64 = 0;
    let hout: u64 = 0;
    let herr: u64 = 0;
    if spawn_bidi_env(argv_p, offs_p, lens_p, 5, env_ptr, env_len, &proc, &hin, &hout, &herr) != 0 {
        *out_err_len = chc_append_bytes(out_err, out_err_cap, 0, STR_PTR("cline hub start failed to spawn"), STR_LEN("cline hub start failed to spawn"));
        return 1;
    };
    sa_std_close(hin);
    let drain = [0u8; 65536];
    let drain_p: ptr = PTR_NULL(); PTR_BYTE_ADD(drain_p, &drain, 0);
    drain_handle(hout, drain_p, 65536);
    let err_bytes = [0u8; 65536];
    let err_bytes_p: ptr = PTR_NULL(); PTR_BYTE_ADD(err_bytes_p, &err_bytes, 0);
    let err_len = drain_handle(herr, err_bytes_p, 65536);
    let code: i32 = 0;
    sa_std_process_wait(proc, &code);
    if code != 0 {
        let n: u64 = 0;
        n = n + chc_append_bytes(out_err, out_err_cap, n, STR_PTR("cline hub start failed ("), STR_LEN("cline hub start failed ("));
        n = n + chc_append_u64(out_err, out_err_cap, n, code as u64);
        n = n + chc_append_bytes(out_err, out_err_cap, n, STR_PTR("): "), 3);
        let take = err_len;
        if take > 300 { take = 300; };
        n = n + chc_append_bytes(out_err, out_err_cap, n, err_bytes_p, take);
        *out_err_len = n;
        return 1;
    };
    return 0;
}

// ---- pending / queue / arena helpers ----

fn pending_remove(self: &ClineHubClient, idx: u64) -> void {
    // The source deletes the entry; the result stays readable
    // because the caller copied it — in this pass the entry is
    // compacted out and results must be read BEFORE the next
    // handleMessage call (see log).
    let i = idx;
    while i + 1 < self.pending_count {
        self.pending[i] = self.pending[i + 1];
        i = i + 1;
    }
    if self.pending_count > 0 { self.pending_count = self.pending_count - 1; };
}

fn queue_event(self: &ClineHubClient, kind_ptr: ptr, kind_len: u64, payload_ptr: ptr, payload_len: u64) -> void {
    self.eventQueue_len = self.eventQueue_len + chc_append_bytes(&self.eventQueue, 1048576, self.eventQueue_len, kind_ptr, kind_len);
    self.eventQueue_len = self.eventQueue_len + chc_append_bytes(&self.eventQueue, 1048576, self.eventQueue_len, STR_PTR("\t"), 1);
    if payload_len > 0 {
        self.eventQueue_len = self.eventQueue_len + chc_append_bytes(&self.eventQueue, 1048576, self.eventQueue_len, payload_ptr, payload_len);
    };
    self.eventQueue_len = self.eventQueue_len + chc_append_bytes(&self.eventQueue, 1048576, self.eventQueue_len, STR_PTR("\n"), 1);
}

fn hub_arena_put(self: &ClineHubClient, p: ptr, n: u64) -> u64 {
    let off = self.arena_len;
    for i in 0..n {
        if self.arena_len < 262144 { self.arena[self.arena_len] = chc_byte_at(p, i); self.arena_len = self.arena_len + 1; };
    }
    return off;
}

fn append_opt_str(out: ptr, cap: u64, at: u64, doc: u64, key_ptr: ptr, key_len: u64) -> u64 {
    let v_ptr: ptr = PTR_NULL();
    let v_len: u64 = 0;
    if sa_json_object_get_string(doc, key_ptr, key_len, &v_ptr, &v_len) != 0 { return at; };
    let n = at;
    n = n + chc_append_bytes(out, cap, n, STR_PTR(",\""), 2);
    n = n + chc_append_bytes(out, cap, n, key_ptr, key_len);
    n = n + chc_append_bytes(out, cap, n, STR_PTR("\":\""), 3);
    n = n + chc_append_bytes(out, cap, n, v_ptr, v_len);
    n = n + chc_append_bytes(out, cap, n, STR_PTR("\""), 1);
    return n;
}

fn append_opt_num(out: ptr, cap: u64, at: u64, doc: u64, key_ptr: ptr, key_len: u64) -> u64 {
    let v: i64 = 0;
    if sa_json_object_get_i64(doc, key_ptr, key_len, &v) != 0 { return at; };
    let n = at;
    n = n + chc_append_bytes(out, cap, n, STR_PTR(",\""), 2);
    n = n + chc_append_bytes(out, cap, n, key_ptr, key_len);
    n = n + chc_append_bytes(out, cap, n, STR_PTR("\":"), 2);
    n = n + append_i64(out, cap, n, v);
    return n;
}

fn split_version(p: ptr, n: u64, out: &i64, out_n: &u64) -> void {
    *out_n = 0;
    let tp: ptr = PTR_NULL();
    let tl: u64 = 0;
    chc_trim_span(p, n, &tp, &tl);
    let start: u64 = 0;
    let i: u64 = 0;
    while i <= tl {
        if i == tl || chc_byte_at(tp, i) == 46 {
            if out_n < 8 {
                out[out_n] = parse_int_span(chc_byte_off(tp, start), i - start);
                *out_n = (*out_n) + 1;
            };
            start = i + 1;
        };
        i = i + 1;
    }
}

// parse_int_span: Number.parseInt prefix semantics — leading
// digits only; no digits -> 0 here (NaN counts as 0 upstream).
fn parse_int_span(p: ptr, n: u64) -> i64 {
    let v: i64 = 0;
    let any = false;
    for i in 0..n {
        let b = chc_byte_at(p, i);
        if b < 48 || b > 57 { break; };
        v = v * 10 + (b - 48) as i64;
        any = true;
    }
    if !any { return 0; };
    return v;
}

// ---- ws shims ----
// DEFECT: WebSocket client surface (ws npm package in TS).
fn ws_connect(url_ptr: ptr, url_len: u64, subprotocol_ptr: ptr, subprotocol_len: u64, out_ws: &u64) -> i32 {
    *out_ws = 0;
    return 1;
}

fn ws_is_open(ws: u64) -> bool {
    return ws != 0;
}

fn ws_send(ws: u64, data: ptr, data_len: u64) -> void {
}

fn ws_close(ws: u64) -> void {
}

// process_pid / process_alive / random_base36 / now_ms shims.
// DEFECT: no verified std counterparts in this pass.
fn process_pid() -> i64 {
    return 0;
}

fn process_alive(pid: i64) -> bool {
    return false;
}

fn random_base36(out: ptr, out_cap: u64, out_len: &u64) -> void {
    *out_len = 0;
}

fn chc_now_ms() -> u64 {
    return 0;
}

fn drain_handle(handle: u64, out: ptr, cap: u64) -> u64 {
    let total: u64 = 0;
    let chunk = [0u8; 8192];
    let chunk_p: ptr = PTR_NULL(); PTR_BYTE_ADD(chunk_p, &chunk, 0);
    while true {
        let got: u64 = 0;
        let rst = sa_io_read(handle, chunk_p, 8192, &got);
        if rst != 0 || got == 0 { break; };
        for i in 0..got {
            if total < cap { let __pbs0: ptr = PTR_NULL(); PTR_BYTE_ADD(__pbs0, out, total); PTR_WRITE_U8(__pbs0, chunk[i]); total = total + 1; };
        }
        if got < 8192 { break; };
    }
    sa_std_close(handle);
    return total;
}

// ---- local helpers ----

fn chc_byte_at(p: ptr, i: u64) -> u8 {
    let b: u8 = 0;
    PTR_BYTE_AT(b, p, i);
    return b;
}

fn chc_byte_off(p: ptr, off: u64) -> ptr {
    let r: ptr = PTR_NULL();
    PTR_BYTE_ADD(r, p, off);
    return r;
}

fn chc_slot(arena: ptr, off: u64) -> ptr {
    return chc_byte_off(arena, off);
}

fn chc_bytes_eq(a: ptr, b: ptr, n: u64) -> bool {
    for i in 0..n {
        if chc_byte_at(a, i) != chc_byte_at(b, i) { return false; };
    }
    return true;
}

fn chc_str_is(p: ptr, n: u64, lit: ptr, lit_len: u64) -> bool {
    return n == lit_len && chc_bytes_eq(p, lit, n);
}

fn chc_trim_span(p: ptr, n: u64, out_ptr: &ptr, out_len: &u64) -> void {
    // 已绑 sa_std ts 面 (@ts_str_trim) — wrap-up rebind.
    chc_ts_str_trim(out_ptr, out_len, p, n);
}

fn chc_is_ws(b: u8) -> bool {
    return b == 32 || b == 9 || b == 10 || b == 13;
}

fn chc_append_bytes(dst: ptr, cap: u64, at: u64, src: ptr, n: u64) -> u64 {
    let w: u64 = 0;
    for i in 0..n {
        if at + w < cap {
            let __pbs1: ptr = PTR_NULL(); PTR_BYTE_ADD(__pbs1, dst, at + w); PTR_WRITE_U8(__pbs1, chc_byte_at(src, i));
            w = w + 1;
        };
    }
    return w;
}

fn chc_append_u64(dst: ptr, cap: u64, at: u64, v: u64) -> u64 {
    let digits = [0u8; 20];
    let digits_p: ptr = PTR_NULL(); PTR_BYTE_ADD(digits_p, &digits, 0);
    let dn: u64 = 0;
    if v == 0 { return chc_append_bytes(dst, cap, at, STR_PTR("0"), 1); };
    let x = v;
    while x > 0 {
        digits[dn] = 48 + (x % 10) as u8;
        dn = dn + 1;
        x = x / 10;
    }
    let w: u64 = 0;
    let i = dn;
    while i > 0 {
        i = i - 1;
        if at + w < cap { let __pbs2: ptr = PTR_NULL(); PTR_BYTE_ADD(__pbs2, dst, at + w); PTR_WRITE_U8(__pbs2, digits[i]); w = w + 1; };
    }
    return w;
}

fn append_i64(dst: ptr, cap: u64, at: u64, v: i64) -> u64 {
    if v < 0 {
        let n = chc_append_bytes(dst, cap, at, STR_PTR("-"), 1);
        return n + chc_append_u64(dst, cap, at + n, (0 - v) as u64);
    };
    return chc_append_u64(dst, cap, at, v as u64);
}

fn chc_buf_copy(dst: ptr, cap: u64, src: ptr, n: u64) -> u64 {
    let m = n;
    if m > cap { m = cap; };
    for i in 0..m {
        let __pbs3: ptr = PTR_NULL(); PTR_BYTE_ADD(__pbs3, dst, i); PTR_WRITE_U8(__pbs3, chc_byte_at(src, i));
    }
    return m;
}

fn chc_join2(out: ptr, cap: u64, a: ptr, a_len: u64, b: ptr, b_len: u64) -> u64 {
    let n: u64 = 0;
    n = n + chc_append_bytes(out, cap, n, a, a_len);
    n = n + chc_append_bytes(out, cap, n, STR_PTR("/"), 1);
    n = n + chc_append_bytes(out, cap, n, b, b_len);
    return n;
}

fn chc_read_file_into(path: ptr, path_len: u64, out: ptr, cap: u64, out_len: &u64) -> bool {
    *out_len = 0;
    let total: u64 = 0;
    if sa_std_fs_len(path, path_len, &total) != 0 { return false; };
    let fh: u64 = 0;
    if sa_std_fs_open_read(path, path_len, &fh) != 0 { return false; };
    let read_n: u64 = 0;
    let rst = sa_std_fs_file_read(fh, out, cap, &read_n);
    sa_fs_file_close(fh);
    if rst != 0 { return false; };
    *out_len = read_n;
    return true;
}
