// Converted 1:1 from backends/cline/src/runtime/clineAgentBridge.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
//
// Cline backend bridge — a CodexRuntimeClient over the
// Cline CLI's own hub daemon (see clineHubClient.sla for
// the reverse-engineered protocol).
//
// Design notes (from the source):
//  - NOT ACP (user decision 2026-10-24: too restrictive,
//    and its session gate demands a vendor login). The hub
//    path is fully BYOK: providers are configured in the
//    data dir (clineProviders.sla) and selected per session
//    through create metadata — no Cline account involved.
//  - NOT embedded either: the hub is a detached daemon
//    process of the user's own external `cline` binary
//    (like `opencode serve`).
//  - The workbench thread id IS the hub session id, so
//    history survives bridge restarts through session.list
//    / session.get / session.messages.
//  - Sessions are created with autoApproveTools=true — the
//    same posture as the CLI's own headless mode. If an
//    approval event still arrives it is answered
//    "approved" via approval.respond; the manifest
//    honestly declares permissionRoundTrips=false.
//
// Shape notes: EventEmitter -> owner-pumped eventQueue
// ("message"/"status"/"stderr" records); hub commands are
// synchronous in this pass via the hub_command_sync shim
// over clineHubClient.sla's pending table (the pump model
// is a repair-phase item); Map/Set members become fixed
// tables; child-session lookups call the canonical fns in
// clineChildSession.sla through local wrappers.

@import "sa_std/fs.sai"
@import "sa_std/encoding/json.sai"
@import "sa_std/process.sai"
@import "sa_std/env.sai"
@import "./clineHubClient.sla"
@import "./clineCommand.sla"
@import "./clineChildSession.sla"
// FIX: bulk pass imported sdk-backend/src/json.sla, which does not exist in the sdk-backend unit (vestigial import removed; faces come from sa_std .sai imports).// FIX: bulk pass imported sdk-backend/src/process.sla, which does not exist in the sdk-backend unit (vestigial import removed; faces come from sa_std .sai imports).@import "sa_std/string.sai"
@import "sa_std/ptr.sa"
@import "sa_std/string.sa"

fn cab_ts_str_trim(out_ptr: &ptr, out_len: &u64, p: ptr, n: u64) -> void {
    // Local replica of the SA-layer @ts_str_trim view semantics
    // (sci sa_std/ts_string.sa): ASCII trim of both ends over the
    // (p, n) view, built on the real string.sai externs.
    let start: u64 = sa_str_trim_ascii_start_index(p, n);
    let rest: ptr = PTR_NULL();
    PTR_BYTE_ADD(rest, p, start);
    let elen: u64 = sa_str_trim_ascii_end_len(rest, n - start);
    *out_ptr = rest;
    *out_len = elen;
}

// ClineUpstreamConfig (interface): providers.json entry id
// written by writeClineRelayProvider + model.
struct ClineUpstreamConfig {
    providerEntryId_ptr: ptr,
    providerEntryId_len: u64,
    model_ptr: ptr,
    model_len: u64,
}

// ClineHubEvent: one queued hub event (produced by
// ClineHubClient_pollEvent in clineHubClient.sla).
struct ClineHubEvent {
    event_ptr: ptr,
    event_len: u64,
    sessionId_ptr: ptr,
    sessionId_len: u64,
    has_sessionId: bool,
    eventId_ptr: ptr,
    eventId_len: u64,
    has_eventId: bool,
    payload: u64,
}

struct ClinePlanStep {
    step: [u8; 512],
    step_len: u64,
    status: [u8; 32],
    status_len: u64,
    key: [u8; 128],
    key_len: u64,
}

struct ClinePendingTeamRun {
    runId: [u8; 128],
    runId_len: u64,
    toolCallId: [u8; 128],
    toolCallId_len: u64,
    turnId: [u8; 64],
    turnId_len: u64,
    threadId: [u8; 128],
    threadId_len: u64,
    agentId: [u8; 128],
    agentId_len: u64,
    has_agentId: bool,
}

struct ClineTurnRow {
    id: [u8; 64],
    id_len: u64,
    status: [u8; 32],
    status_len: u64,
}

struct ClineSessionState {
    threadId_ptr: ptr,
    threadId_len: u64,
    cwd_ptr: ptr,
    cwd_len: u64,
    has_cwd: bool,
    model_ptr: ptr,
    model_len: u64,
    has_model: bool,
    providerEntryId_ptr: ptr,
    providerEntryId_len: u64,
    has_providerEntryId: bool,
    createdAt: u64,
    activeTurnId: [u8; 64],
    activeTurnId_len: u64,
    has_activeTurnId: bool,
    activeRunId: [u8; 128],
    activeRunId_len: u64,
    has_activeRunId: bool,
    activeItemId: [u8; 160],
    activeItemId_len: u64,
    has_activeItemId: bool,
    streamedText: [u8; 262144],
    streamedText_len: u64,
    itemStarted: bool,
    textSegIndex: u64,
    reasoningSeq: u64,
    planSteps: [ClinePlanStep; 128],
    planSteps_count: u64,
