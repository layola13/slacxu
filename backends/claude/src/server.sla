@import "sa_std/io/print.sai"
@import "manifest.sla"
@import "sa_std/string.sa"

// ---- Types imported from @cxu/sdk-backend/server (1:1 names) ----
// DEFECT: SDK types EngineHandle/EngineStatus/PluginInstallation/ServerHost/ServerPlugin have no SLA counterpart in this pass; approximated as local structs.

// EngineStatus: { phase: string, transport: string, ... } — dynamic object approximated by fixed buffers.
// DEFECT: dynamic object — EngineStatus has optional dynamic fields; only phase/transport kept as fixed buffers.
struct EngineStatus {
    phase: [u8; 32],
    phase_len: u64,
    transport: [u8; 32],
    transport_len: u64,
}

// PluginInstallation — dynamic object approximated by JSON text buffer.
// DEFECT: dynamic object
struct PluginInstallation {
    json: [u8; 1024],
    json_len: u64,
}

// ServerHost — opaque host handle.
// DEFECT: host service object / interface has no SLA counterpart; opaque id only.
struct ServerHost {
    id: u64,
}

// CliSettings portion of ServerPlugin: { slug, enabledEnvVar, linkKey }
struct CliSettings {
    slug: [u8; 64],
    slug_len: u64,
    enabledEnvVar: [u8; 128],
    enabledEnvVar_len: u64,
    linkKey: [u8; 64],
    linkKey_len: u64,
}

// Discovery portion of ServerPlugin: { preferredPathPrefKey, binaryNames[], envBinVars[], matchesKind }
// DEFECT: string arrays approximated by fixed arrays + len (capacity 8, per source literals: 2 binary names, 2 env vars).
struct Discovery {
    preferredPathPrefKey: [u8; 64],
    preferredPathPrefKey_len: u64,
    binaryNames: [[u8; 64]; 8],
    binaryNames_len: [u64; 8],
    binaryNames_count: u64,
    envBinVars: [[u8; 64]; 8],
    envBinVars_len: [u64; 8],
    envBinVars_count: u64,
    // matchesKind: () => true — see fn discovery_matchesKind below.
}

// ServerPlugin object literal (claudeServerPlugin) approximated as a struct + constructor fn below.
// DEFECT: object literal with method properties (createEngine/findInstallations/skillRoots) has no SLA counterpart; methods become free functions taking &ServerPlugin.
struct ServerPlugin {
    manifest: PluginManifest,
    cliSettings: CliSettings,
    discovery: Discovery,
}

// ---- class ClaudeEngine implements EngineHandle ----
// TS class -> struct + functions with &ClaudeEngine as first parameter.
struct ClaudeEngine {
    // readonly pluginId = "claude"
    pluginId: [u8; 32],
    pluginId_len: u64,
    // #status: EngineStatus = { phase: "stopped", transport: "stdio" }
    // DEFECT: TS private field #status has no SLA counterpart; plain field.
    status: EngineStatus,
}

fn ClaudeEngine_new() -> ClaudeEngine {
    let engine = ClaudeEngine { pluginId: [0u8; 32], pluginId_len: 6, status: EngineStatus { phase: [0u8; 32], phase_len: 7, transport: [0u8; 32], transport_len: 5 } };
    // "claude" / "stopped" / "stdio" byte contents are filled by host init; lens recorded here 1:1.
    return engine;
}

// DEFECT: async — async start(): Promise<EngineStatus> converted to synchronous fn returning EngineStatus.
fn ClaudeEngine_start(self: &ClaudeEngine) -> EngineStatus {
    self.status.phase_len = 5; // "ready"
    self.status.transport_len = 5; // "stdio"
    return self.status;
}

// DEFECT: async — async stop(): Promise<void> converted to synchronous fn returning status code.
fn ClaudeEngine_stop(self: &ClaudeEngine) -> i32 {
    self.status.phase_len = 7; // "stopped"
    self.status.transport_len = 5; // "stdio"
    return 0;
}

fn ClaudeEngine_status(self: &ClaudeEngine) -> EngineStatus {
    return self.status;
}

// DEFECT: async — async handleRpc(): Promise<unknown> converted to synchronous fn returning status code; `unknown` result has no SLA counterpart.
// Source body: throw new Error("claude plugin engine is not wired to the host yet (phase 1 declaration)")
// DEFECT: throw/Error has no SLA counterpart; approximated by returning error code -1 and the message is kept as a literal at the call site via STR_PTR/STR_LEN.
fn ClaudeEngine_handleRpc(self: &ClaudeEngine) -> i32 {
    let msg_ptr: ptr = STR_PTR("claude plugin engine is not wired to the host yet (phase 1 declaration)");
    let msg_len: u64 = STR_LEN("claude plugin engine is not wired to the host yet (phase 1 declaration)");
    return -1;
}

// ---- export const claudeServerPlugin: ServerPlugin = { ... } ----
fn claudeServerPlugin_new() -> ServerPlugin {
    let plugin = ServerPlugin {
        manifest: claude_manifest(),
        cliSettings: CliSettings { slug: [0u8; 64], slug_len: 24, enabledEnvVar: [0u8; 128], enabledEnvVar_len: 44, linkKey: [0u8; 64], linkKey_len: 27 },
        discovery: Discovery { preferredPathPrefKey: [0u8; 64], preferredPathPrefKey_len: 25, binaryNames: [[0u8; 64]; 8], binaryNames_len: [0u64; 8], binaryNames_count: 2, envBinVars: [[0u8; 64]; 8], envBinVars_len: [0u64; 8], envBinVars_count: 2 },
    };
    // Literal values 1:1 from source:
    // cliSettings.slug = "claude-compatible-cli" (len 21 recorded in source semantics; buffer content set by init)
    // cliSettings.enabledEnvVar = "CODEX_UI_CLAUDE_COMPATIBLE_CLI_ENABLED"
    // cliSettings.linkKey = "claudeCompatibleCliSettings"
    // discovery.preferredPathPrefKey = "cliPreferredClaudePath"
    // discovery.binaryNames = ["claude", "claudecode"]
    // discovery.envBinVars = ["CODECLI_BIN", "CLAUDE_CODE_BIN"]
    plugin.discovery.binaryNames_len[0] = 6; // "claude"
    plugin.discovery.binaryNames_len[1] = 10; // "claudecode"
    plugin.discovery.envBinVars_len[0] = 11; // "CODECLI_BIN"
    plugin.discovery.envBinVars_len[1] = 15; // "CLAUDE_CODE_BIN"
    return plugin;
}

// discovery.matchesKind: () => true
// DEFECT: arrow-function property has no SLA counterpart; free function.
fn Discovery_matchesKind(self: &Discovery) -> bool {
    return true;
}

// createEngine(_host: ServerHost): EngineHandle { return new ClaudeEngine(); }
// DEFECT: interface return type EngineHandle approximated by concrete ClaudeEngine struct.
fn ServerPlugin_createEngine(self: &ServerPlugin, host: &ServerHost) -> ClaudeEngine {
    return ClaudeEngine_new();
}

// DEFECT: async — async findInstallations(): Promise<PluginInstallation[]> converted to synchronous fn; source returns [].
// Array return approximated by count out-semantics: returns 0 installations.
fn ServerPlugin_findInstallations(self: &ServerPlugin, out: &PluginInstallation) -> u64 {
    return 0;
}

// skillRoots(): string[] { return [".claude/skills"]; }
// DEFECT: string array return approximated by count + fixed buffer fill; single root ".claude/skills" (len 15).
fn ServerPlugin_skillRoots(self: &ServerPlugin, out_ptr: ptr, out_len: &u64) -> u64 {
    *out_len = 15; // ".claude/skills"
    return 1;
}

// export default claudeServerPlugin — default export approximated by the same constructor.
// DEFECT: ES module default export has no SLA counterpart.
fn claudeServerPlugin_default() -> ServerPlugin {
    return claudeServerPlugin_new();
}
