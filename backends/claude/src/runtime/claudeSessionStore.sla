// Persists Claude-compatible CLI external session metadata separately
// from Codex thread IDs. This allows history to remain readable after
// a server restart, and enables resume when a valid external session exists.
//
// Schema: one row per internal thread ID that uses the Claude backend.

// DEFECT: nullable string fields (string | null) approximated with has_* flags;
// string values are fixed byte buffers + len.
struct ClaudeSessionRecord {
    threadId: [u8; 128],
    threadId_len: u64,
    ownerId: [u8; 128],
    ownerId_len: u64,
    has_externalSessionId: bool,
    externalSessionId: [u8; 128],
    externalSessionId_len: u64,
    has_cliVersion: bool,
    cliVersion: [u8; 64],
    cliVersion_len: u64,
    has_model: bool,
    model: [u8; 256],
    model_len: u64,
    has_cwd: bool,
    cwd: [u8; 1024],
    cwd_len: u64,
    has_permissionMode: bool,
    permissionMode: [u8; 64],
    permissionMode_len: u64,
    has_configDir: bool,
    configDir: [u8; 1024],
    configDir_len: u64,
    has_stateJson: bool,
    stateJson: [u8; 262144],
    stateJson_len: u64,
    createdAt: u64, // ms since epoch (TS number)
    updatedAt: u64,
}

struct ClaudeSessionRow {
    thread_id: [u8; 128],
    thread_id_len: u64,
    owner_id: [u8; 128],
    owner_id_len: u64,
    has_external_session_id: bool,
    external_session_id: [u8; 128],
    external_session_id_len: u64,
    has_cli_version: bool,
    cli_version: [u8; 64],
    cli_version_len: u64,
    has_model: bool,
    model: [u8; 256],
    model_len: u64,
    has_cwd: bool,
    cwd: [u8; 1024],
    cwd_len: u64,
    has_permission_mode: bool,
    permission_mode: [u8; 64],
    permission_mode_len: u64,
    has_config_dir: bool,
    config_dir: [u8; 1024],
    config_dir_len: u64,
    has_state_json: bool,
    state_json: [u8; 262144],
    state_json_len: u64,
    created_at: u64,
    updated_at: u64,
}

// TS class ClaudeSessionStore -> struct + function family with &ClaudeSessionStore first param.
struct ClaudeSessionStore {
    db: u64, // RuntimeDatabase opaque handle
}

// DEFECT: Date.now() — wall-clock ms extern assumed (sa_std time surface unverified).
fn claudeSessionStore_now_ms() -> u64 {
    return sa_time_now_ms();
}

// constructor(private readonly db: RuntimeDatabase)
fn ClaudeSessionStore_new(store: &ClaudeSessionStore, db: u64) -> i32 {
    store.db = db;
    // this.db.exec(`CREATE TABLE IF NOT EXISTS claude_sessions (...)`)
    let rc = runtime_db_exec(db, STR_PTR("CREATE TABLE IF NOT EXISTS claude_sessions (thread_id TEXT NOT NULL, owner_id TEXT NOT NULL, external_session_id TEXT, cli_version TEXT, model TEXT, cwd TEXT, permission_mode TEXT, config_dir TEXT, state_json TEXT, created_at INTEGER NOT NULL, updated_at INTEGER NOT NULL, PRIMARY KEY (thread_id, owner_id))"), STR_LEN("CREATE TABLE IF NOT EXISTS claude_sessions (thread_id TEXT NOT NULL, owner_id TEXT NOT NULL, external_session_id TEXT, cli_version TEXT, model TEXT, cwd TEXT, permission_mode TEXT, config_dir TEXT, state_json TEXT, created_at INTEGER NOT NULL, updated_at INTEGER NOT NULL, PRIMARY KEY (thread_id, owner_id))"));
    if rc != 0 { return rc; };
    // try { ALTER TABLE ... ADD COLUMN state_json } catch {} — errors swallowed in TS.
    let ignored1 = runtime_db_exec(db, STR_PTR("ALTER TABLE claude_sessions ADD COLUMN state_json TEXT"), STR_LEN("ALTER TABLE claude_sessions ADD COLUMN state_json TEXT"));
    // try { ALTER TABLE ... ADD COLUMN config_dir } catch {}
    let ignored2 = runtime_db_exec(db, STR_PTR("ALTER TABLE claude_sessions ADD COLUMN config_dir TEXT"), STR_LEN("ALTER TABLE claude_sessions ADD COLUMN config_dir TEXT"));
    return 0;
}

