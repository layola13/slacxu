// DEFECT: node:fs/promises (access/readFile/readdir/rename/writeFile) and
// node:crypto randomUUID have no direct sa_std counterparts; sa_std_fs_*
// placeholder externs + host_random_uuid are used. All async functions are
// converted to synchronous ones returning status codes (throw -> err buffer).
// DEFECT: regex patterns MODEL_CONTEXT_VARIANT_PATTERN / CLAUDE_MODEL_PATTERN /
// CLAUDE_MSIX_PACKAGE_PATTERN approximated by hand-written scans.
// DEFECT: JsonObject = Record<string, unknown> — config objects are JSON text
// buffers manipulated with sa_json_obj_* placeholder helpers (set/delete/get).

// type JsonObject = Record<string, unknown>  -> JSON text buffer.


// FIX(be2): StrMap/strmap_* live in claudeCompatibleTurnProjector,
// which this unit does not import; local twins over Probe's StrList
// (append-only shadow entries, latest-write-wins — same model as TP).
struct DiStrMap {
    keys: StrList,
    vals: StrList,
}

fn di_strmap_set(m: &DiStrMap, key_ptr: ptr, key_len: u64, val_ptr: ptr, val_len: u64) -> void {
    strlist_push(&m.keys, key_ptr, key_len);
    strlist_push(&m.vals, val_ptr, val_len);
    return;
}

fn di_strmap_get_latest(m: &DiStrMap, key_ptr: ptr, key_len: u64, out: &ByteBuf) -> bool {
    let idx: i64 = (m.keys.count as i64) - 1;
    while idx >= 0 {
        let koff: u64 = 0;
        let voff: u64 = 0;
        let i: u64 = 0;
        while i < (idx as u64) { koff = koff + m.keys.lens[i]; voff = voff + m.vals.lens[i]; i = i + 1; }
        if m.keys.lens[idx as u64] == key_len {
            let cap_dk: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_dk, &m.keys.items, koff);
            if bytes_eq_buf(cap_dk, key_len, key_ptr, key_len) {
                let cap_dv: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_dv, &m.vals.items, voff);
                buf_append_bytes(out, cap_dv, m.vals.lens[idx as u64]);
                return true;
            };
        };
        idx = idx - 1;
    }
    return false;
}


fn di_strset_has(set: &StrList, key_ptr: ptr, key_len: u64) -> bool {
    let off: u64 = 0;
    let i: u64 = 0;
    while i < set.count {
        if set.lens[i] == key_len {
            let cap_ds: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ds, &set.items, off);
            if bytes_eq_buf(cap_ds, key_len, key_ptr, key_len) { return true; };
        };
        off = off + set.lens[i];
        i = i + 1;
    }
    return false;
}

fn di_strset_add(set: &StrList, key_ptr: ptr, key_len: u64) -> void {
    if !(di_strset_has(set, key_ptr, key_len)) { strlist_push(set, key_ptr, key_len); };
    return;
}


// FIX(be2): host_platform_name placeholder implemented over
// Probe's platform probes (win32 via the OS env var; the
// supported non-win32 host here reports "linux").
fn host_platform_name(out: &ByteBuf) -> void {
    if host_platform_is_win32() { buf_append_lit(out, STR_PTR("win32"), STR_LEN("win32")); } else { buf_append_lit(out, STR_PTR("linux"), STR_LEN("linux")); };
    return;
}

struct ClaudeDesktopRelayMapping {
    from: [u8; 512],
    from_len: u64,
    to: [u8; 512],
    to_len: u64,
}

struct ClaudeDesktopInjectionResult {
    desktopModels: StrList,
    groupModelMappings: [ClaudeDesktopRelayMapping; 256],
    groupModelMappings_count: u64,
}

// Returned when automatic discovery cannot locate the config library, so the
// client can prompt for a manually entered path (configLibraryDir).
// TS: export const CLAUDE_DESKTOP_CONFIG_NOT_FOUND_CODE = "claudeDesktopConfigLibraryNotFound";
// (string constant — referenced by literal at call sites.)

struct ClaudeDesktopInjectionInput {
    baseUrl: [u8; 2048],
    baseUrl_len: u64,
    token: [u8; 4096],
    token_len: u64,
    models: StrList,
    has_configLibraryDir: bool,
    configLibraryDir: [u8; 1024],
    configLibraryDir_len: u64,
    has_platform: bool, // NodeJS.Platform as string
    platform: [u8; 32],
    platform_len: u64,
    has_localAppData: bool,
    localAppData: [u8; 1024],
    localAppData_len: u64,
}

struct ModelContextVariant {
    baseModel: [u8; 512],
    baseModel_len: u64,
    contextSuffix: [u8; 64], // match text with whitespace removed, e.g. "[200k]"
    contextSuffix_len: u64,
}

// splitModelContextVariant(model): { baseModel, contextSuffix }
// DEFECT: MODEL_CONTEXT_VARIANT_PATTERN = /\[(\d+(?:\.\d+)?)\s*([km])\]$/i
// approximated: trailing "[<digits[.digits]><spaces><k|m>]" bracket scan.
fn splitModelContextVariant(model_ptr: ptr, model_len: u64, out: &ModelContextVariant) -> void {
    // const normalized = model.trim();
    let normalized = ByteBuf { bytes: [0u8; 65536], len: 0 };
    buf_append_bytes(&normalized, model_ptr, model_len);
    buf_trim_in_place(&normalized);
    out.contextSuffix_len = 0;
    // find last '[' such that the tail matches the pattern and ends at the end
    let match_start: i64 = -1;
    let i: u64 = 0;
    while i < normalized.len {
        if normalized.bytes[i] == 91 { match_start = i; };
        i = i + 1;
    }
    let ok: bool = false;
    if match_start >= 0 && normalized.len > 0 && normalized.bytes[normalized.len - 1] == 93 {
        let j: u64 = match_start + 1;
        let digits: u64 = 0;
        let dots: u64 = 0;
        while j < normalized.len - 1 {
            let c = normalized.bytes[j];
            if c >= 48 && c <= 57 { digits = digits + 1; j = j + 1; }
            else if c == 46 && dots == 0 { dots = dots + 1; j = j + 1; }
            else { break; };
        }
        // \s*
        while j < normalized.len - 1 && probe_is_space(normalized.bytes[j]) { j = j + 1; }
        // ([km]) case-insensitive, then ']' at end
        if digits > 0 && j == normalized.len - 2 {
            let unit = normalized.bytes[j];
            if unit == 107 || unit == 109 || unit == 75 || unit == 77 { ok = true; };
        };
    };
    if ok {
        // baseModel: normalized.slice(0, match.index).trim()
        let base = ByteBuf { bytes: [0u8; 65536], len: 0 };
        let cap_p86: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p86, &normalized.bytes, 0);
        buf_append_bytes(&base, cap_p86, match_start);
        buf_trim_in_place(&base);
        out.baseModel_len = base.len;
        buf_copy_to(&base, &out.baseModel);
        // contextSuffix: match[0].replace(/\s+/g, "")
        // DEFECT: regex whitespace strip approximated by scan.
        out.contextSuffix_len = 0;
        let k: u64 = match_start;
        while k < normalized.len {
            let c = normalized.bytes[k];
            if !(probe_is_space(c)) {
                out.contextSuffix[out.contextSuffix_len] = c;
                out.contextSuffix_len = out.contextSuffix_len + 1;
            };
            k = k + 1;
        }
        return;
    };
    // return { baseModel: normalized, contextSuffix: "" };
    out.baseModel_len = normalized.len;
    buf_copy_to(&normalized, &out.baseModel);
    return;
}

// DEFECT: CLAUDE_MODEL_PATTERN = /(?:^|[./:_-])claude(?:[./:_-]|$)/i approximated:
// find case-insensitive "claude" whose preceding char is start or one of ./:_-
// and whose following char is one of ./:_- or end.
fn claude_model_pattern_test(p: ptr, len: u64) -> bool {
    if len < 6 { return false; };
    let i: u64 = 0;
    while i + 6 <= len {
        let is_claude: bool = true;
        let word: [u8; 6] = [99, 108, 97, 117, 100, 101]; // "claude"
        let word_p: ptr = PTR_NULL(); PTR_BYTE_ADD(word_p, &word, 0);
        let j: u64 = 0;
        while j < 6 {
            let c = PTR_BYTE_AT(p, i + j);
            if c >= 65 && c <= 90 { c = c + 32; };
            if c != word[j] { is_claude = false; };
            j = j + 1;
        }
        if is_claude {
            let before_ok: bool = i == 0 || is_model_sep(PTR_BYTE_AT(p, i - 1));
            let after: u64 = i + 6;
            let after_ok: bool = after >= len || is_model_sep(PTR_BYTE_AT(p, after));
            if before_ok && after_ok { return true; };
        };
        i = i + 1;
    }
    return false;
}

fn is_model_sep(c: u8) -> bool {
    return c == 46 || c == 47 || c == 58 || c == 95 || c == 45;
}

// buildClaudeDesktopRelayInjection(sourceModels, modelMappings = {})
// modelMappings is Record<string,string> as JSON text.
// Returns 0 ok / 1 throw (error text in err).
fn buildClaudeDesktopRelayInjection(sourceModels: &StrList, mappings_json_ptr: ptr, mappings_json_len: u64, out: &ClaudeDesktopInjectionResult, err: &ByteBuf) -> i32 {
    out.desktopModels = StrList { items: [0u8; 16384], items_len: 0, lens: [0u64; 64], count: 0 };
    out.groupModelMappings_count = 0;
    // const aliasTargets = new Map<string, string>();
    let aliasTargets = DiStrMap { keys: StrList { items: [0u8; 16384], items_len: 0, lens: [0u64; 64], count: 0 }, vals: StrList { items: [0u8; 16384], items_len: 0, lens: [0u64; 64], count: 0 } };
    // for (const sourceModel of [...new Set(sourceModels.map(m => m.trim()).filter(Boolean))])
    // DEFECT: Set dedup + map/filter chain approximated by explicit loop with seen-check.
    let mappings_doc: u64 = 0;
    if mappings_json_len > 0 { mappings_doc = sa_json_parse(mappings_json_ptr, mappings_json_len); };
    let seen = StrList { items: [0u8; 16384], items_len: 0, lens: [0u64; 64], count: 0 };
    let off: u64 = 0;
    let si: u64 = 0;
    while si < sourceModels.count {
        let raw_model = ByteBuf { bytes: [0u8; 65536], len: 0 };
        buf_append_bytes(&raw_model, PTR_ADD(sourceModels.items, off), sourceModels.lens[si]);
        off = off + sourceModels.lens[si];
        si = si + 1;
        buf_trim_in_place(&raw_model); // .map(m => m.trim())
        if raw_model.len == 0 { continue; }; // .filter(Boolean)
        let cap_p20638: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p20638, &raw_model.bytes, 0);
        if di_strset_has(&seen, cap_p20638, raw_model.len) { continue; }; // new Set(...)
        let cap_p20641: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p20641, &raw_model.bytes, 0);
        di_strset_add(&seen, cap_p20641, raw_model.len);
        let sourceModel = ByteBuf { bytes: [0u8; 65536], len: 0 };
        let cap_p87: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p87, &raw_model.bytes, 0);
        buf_append_bytes(&sourceModel, cap_p87, raw_model.len);
        // const source = splitModelContextVariant(sourceModel);
        let source = ModelContextVariant { baseModel: [0u8; 512], baseModel_len: 0, contextSuffix: [0u8; 64], contextSuffix_len: 0 };
        let cap_p20642: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p20642, &sourceModel.bytes, 0);
        splitModelContextVariant( cap_p20642, sourceModel.len, &source);
        // if (CLAUDE_MODEL_PATTERN.test(source.baseModel)) { desktopModels.push(sourceModel); continue; }
        let cap_p20644: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p20644, &source.baseModel, 0);
        if claude_model_pattern_test( cap_p20644, source.baseModel_len) {
            strlist_push_buf(&out.desktopModels, &sourceModel.bytes, sourceModel.len);
            continue;
        };
        // const requestedAlias = (modelMappings[sourceModel] ?? modelMappings[source.baseModel] ?? "").trim();
        let requestedAlias = ByteBuf { bytes: [0u8; 65536], len: 0 };
        let has_alias: bool = false;
        if mappings_doc != 0 {
            // FIX(be2): a pre-loop json handle cannot be consumed by
            // extern calls inside the loop (LoopConditionalConsume);
            // re-parse per iteration into a loop-local handle.
            let iter_doc = sa_json_parse(mappings_json_ptr, mappings_json_len);
            let jgs_p20: ptr = PTR_NULL(); PTR_BYTE_ADD(jgs_p20, &requestedAlias.bytes, 0);
            let cap_p88: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p88, &sourceModel.bytes, 0);
            let n1: u64 = json_get_string_copy(iter_doc, cap_p88, sourceModel.len, jgs_p20, 512);
            let cap_p20663: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p20663, &sourceModel.bytes, 0);
            if json_has(iter_doc, cap_p20663, sourceModel.len) { requestedAlias.len = n1; has_alias = true; }
            else {
                let jgs_p21: ptr = PTR_NULL(); PTR_BYTE_ADD(jgs_p21, &requestedAlias.bytes, 0);
                let cap_p20665: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p20665, &source.baseModel, 0);
                let n2: u64 = json_get_string_copy(iter_doc, cap_p20665, source.baseModel_len, jgs_p21, 512);
                let cap_p20664: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p20664, &source.baseModel, 0);
                if json_has(iter_doc, cap_p20664, source.baseModel_len) { requestedAlias.len = n2; has_alias = true; };
            };
            if iter_doc != 0 { sa_json_free(iter_doc); };
        };
        if has_alias { buf_trim_in_place(&requestedAlias); } else { requestedAlias.len = 0; };
        // const alias = splitModelContextVariant(requestedAlias);
        let alias = ModelContextVariant { baseModel: [0u8; 512], baseModel_len: 0, contextSuffix: [0u8; 64], contextSuffix_len: 0 };
        let cap_p20643: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p20643, &requestedAlias.bytes, 0);
        splitModelContextVariant( cap_p20643, requestedAlias.len, &alias);
        // if (!requestedAlias || !CLAUDE_MODEL_PATTERN.test(alias.baseModel)) throw new Error(`Claude model mapping is required for non-Claude model: ${sourceModel}`);
        let cap_p20645: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p20645, &alias.baseModel, 0);
        if requestedAlias.len == 0 || !(claude_model_pattern_test( cap_p20645, alias.baseModel_len)) {
            buf_append_lit(err, STR_PTR("Claude model mapping is required for non-Claude model: "), STR_LEN("Claude model mapping is required for non-Claude model: "));
            let cap_p89: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p89, &sourceModel.bytes, 0);
            buf_append_bytes(err, cap_p89, sourceModel.len);
            // mappings_doc intentionally not freed on this error path:
            // freeing a pre-loop handle inside the loop trips
            // LoopConditionalConsume; it is released after the loop.
            return 1;
        };
        // const existingTarget = aliasTargets.get(alias.baseModel);
        // if (existingTarget && existingTarget !== source.baseModel) throw ...
        let existingTarget = ByteBuf { bytes: [0u8; 65536], len: 0 };
        let cap_p20881: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p20881, &alias.baseModel, 0);
        if di_strmap_get_latest(&aliasTargets, cap_p20881, alias.baseModel_len, &existingTarget) {
            let cap_p90: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p90, &existingTarget.bytes, 0);
            let cap_p20882: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p20882, &source.baseModel, 0);
            if existingTarget.len != source.baseModel_len || !(bytes_eq_buf(cap_p90, existingTarget.len, cap_p20882, source.baseModel_len)) {
                buf_append_lit(err, STR_PTR("Claude model alias is already mapped to another model: "), STR_LEN("Claude model alias is already mapped to another model: "));
                let cap_p20884: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p20884, &alias.baseModel, 0);
                buf_append_bytes(err, cap_p20884, alias.baseModel_len);
                // mappings_doc intentionally not freed on this error path:
            // freeing a pre-loop handle inside the loop trips
            // LoopConditionalConsume; it is released after the loop.
                return 1;
            };
        };
        // aliasTargets.set(alias.baseModel, source.baseModel);
        let cap_p20892: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p20892, &alias.baseModel, 0);
        let cap_p20893: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p20893, &source.baseModel, 0);
        di_strmap_set(&aliasTargets, cap_p20892, alias.baseModel_len, cap_p20893, source.baseModel_len);
        // const contextSuffix = source.contextSuffix || alias.contextSuffix;
        // desktopModels.push(`${alias.baseModel}${contextSuffix}`);
        let dm = ByteBuf { bytes: [0u8; 65536], len: 0 };
        let cap_p20885: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p20885, &alias.baseModel, 0);
        buf_append_bytes(&dm, cap_p20885, alias.baseModel_len);
        let cap_p20886: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p20886, &source.contextSuffix, 0);
        let cap_p20887: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p20887, &alias.contextSuffix, 0);
        if source.contextSuffix_len > 0 { buf_append_bytes(&dm, cap_p20886, source.contextSuffix_len); } else { buf_append_bytes(&dm, cap_p20887, alias.contextSuffix_len); };
        strlist_push_buf(&out.desktopModels, &dm.bytes, dm.len);
        // groupModelMappings.push({ from: alias.baseModel, to: source.baseModel });
        // (dedup by `from` happens at return via new Map(...); applied on insert here)
        // DEFECT: dedup-at-return approximated by replace-on-same-from at push time.
        let replaced: bool = false;
        let gi: u64 = 0;
        while gi < out.groupModelMappings_count {
            let cap_p20883: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p20883, &alias.baseModel, 0);
            let cap_p20930: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p20930, &out.groupModelMappings[gi].from, 0);
            if out.groupModelMappings[gi].from_len == alias.baseModel_len && bytes_eq_buf( cap_p20930, out.groupModelMappings[gi].from_len, cap_p20883, alias.baseModel_len) {
                out.groupModelMappings[gi].to_len = source.baseModel_len;
                let cap_p20943: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p20943, &source.baseModel, 0);
                buf_copy_ptr_to( cap_p20943, source.baseModel_len, &out.groupModelMappings[gi].to);
                replaced = true;
            };
            gi = gi + 1;
        }
        if !(replaced) && out.groupModelMappings_count < 256 {
            let m = &out.groupModelMappings[out.groupModelMappings_count];
            m.from_len = alias.baseModel_len;
            let cap_p20944: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p20944, &alias.baseModel, 0);
            buf_copy_ptr_to( cap_p20944, alias.baseModel_len, &m.from);
            m.to_len = source.baseModel_len;
            let cap_p20945: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p20945, &source.baseModel, 0);
            buf_copy_ptr_to( cap_p20945, source.baseModel_len, &m.to);
            out.groupModelMappings_count = out.groupModelMappings_count + 1;
        };
    }
    if mappings_doc != 0 { sa_json_free(mappings_doc); };
    // return { desktopModels: [...new Set(desktopModels)], groupModelMappings: [...new Map(...).values()] };
    // DEFECT: final Set dedup of desktopModels approximated by in-place dedup pass.
    dedup_strlist(&out.desktopModels);
    return 0;
}

fn dedup_strlist(list: &StrList) -> void {
    let out_list = StrList { items: [0u8; 16384], items_len: 0, lens: [0u64; 64], count: 0 };
    let off: u64 = 0;
    let i: u64 = 0;
    while i < list.count {
        if !(di_strset_has(&out_list, PTR_ADD(list.items, off), list.lens[i])) {
            strlist_push(&out_list, PTR_ADD(list.items, off), list.lens[i]);
        };
        off = off + list.lens[i];
        i = i + 1;
    }
    list.items_len = out_list.items_len;
    list.count = out_list.count;
    let j: u64 = 0;
    while j < out_list.items_len { list.items[j] = out_list.items[j]; j = j + 1; }
    let k: u64 = 0;
    while k < out_list.count { list.lens[k] = out_list.lens[k]; k = k + 1; }
    return;
}

// The publisher hash suffix of the MSIX package family name varies per machine.
// TS: const CLAUDE_MSIX_PACKAGE_PATTERN = /^Claude_[A-Za-z0-9]+$/i;
// DEFECT: regex approximated by scan: prefix "Claude_" (case-insensitive) + 1..n alnum.
fn msix_package_pattern_test(name_ptr: ptr, name_len: u64) -> bool {
    if name_len < 8 { return false; };
    let prefix: [u8; 7] = [99, 108, 97, 117, 100, 101, 95]; // "claude_"
    let prefix_p: ptr = PTR_NULL(); PTR_BYTE_ADD(prefix_p, &prefix, 0);
    let i: u64 = 0;
    while i < 7 {
        let c = PTR_BYTE_AT(name_ptr, i);
        if c >= 65 && c <= 90 { c = c + 32; };
        if c != prefix[i] { return false; };
        i = i + 1;
    }
    let j: u64 = 7;
    while j < name_len {
        let c = PTR_BYTE_AT(name_ptr, j);
        let alnum: bool = (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57);
        if !(alnum) { return false; };
        j = j + 1;
    }
    return true;
}

// async function pathExists(path): Promise<boolean>
// DEFECT: async + fs access try/catch -> synchronous exists probe.
fn pathExists(path_ptr: ptr, path_len: u64) -> bool {
    return sa_std_fs_exists(path_ptr, path_len) == 0; // FIX (fs_exists sweep): pathExists is true when the status is 0 (polarity was inverted)
}

// export async function resolveClaudeConfigLibraryDir(options = {}): Promise<string>
// DEFECT: async — synchronous; returns 0 + path in out, 1 + error text in err (TS throws).
// options.platform defaults to process.platform and options.localAppData to
// process.env.LOCALAPPDATA — platform via host_platform_name placeholder.
fn resolveClaudeConfigLibraryDir(has_platform: bool, platform_ptr: ptr, platform_len: u64, has_localAppData: bool, localAppData_ptr: ptr, localAppData_len: u64, env_ptr: ptr, env_len: u64, out: &ByteBuf, err: &ByteBuf) -> i32 {
    // const targetPlatform = options.platform ?? process.platform;
    let target = ByteBuf { bytes: [0u8; 65536], len: 0 };
    if has_platform { buf_append_bytes(&target, platform_ptr, platform_len); } else { host_platform_name(&target); };
    // if (targetPlatform !== "win32") throw new Error("Claude Desktop injection is only available on Windows");
    let cap_p91: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p91, &target.bytes, 0);
    if !(bytes_eq_buf(cap_p91, target.len, STR_PTR("win32"), STR_LEN("win32"))) {
        buf_append_lit(err, STR_PTR("Claude Desktop injection is only available on Windows"), STR_LEN("Claude Desktop injection is only available on Windows"));
        return 1;
    };
    // const localAppData = options.localAppData ?? process.env.LOCALAPPDATA;
    let lad = ByteBuf { bytes: [0u8; 65536], len: 0 };
    if has_localAppData { buf_append_bytes(&lad, localAppData_ptr, localAppData_len); } else { let ig_lad = env_get(env_ptr, env_len, STR_PTR("LOCALAPPDATA"), STR_LEN("LOCALAPPDATA"), &lad); };
    // if (!localAppData?.trim()) throw new Error("LOCALAPPDATA is unavailable");
    let lad_probe = ByteBuf { bytes: [0u8; 65536], len: 0 };
    let cap_p92: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p92, &lad.bytes, 0);
    buf_append_bytes(&lad_probe, cap_p92, lad.len);
    buf_trim_in_place(&lad_probe);
    if lad_probe.len == 0 {
        buf_append_lit(err, STR_PTR("LOCALAPPDATA is unavailable"), STR_LEN("LOCALAPPDATA is unavailable"));
        return 1;
    };
    // const candidates = [join(localAppData, "Claude-3p", "configLibrary")];
    let candidates = StrList { items: [0u8; 16384], items_len: 0, lens: [0u64; 64], count: 0 };
    path_join_push(&candidates, &lad, STR_PTR("Claude-3p\\configLibrary"), STR_LEN("Claude-3p\\configLibrary"));
    // try { const entries = (await readdir(packagesDir, {withFileTypes:true})).filter(isDirectory && PATTERN.test(name)).map(name).sort(); for (...) candidates.push(...Local..., ...Roaming...) } catch {}
    let packagesDir = ByteBuf { bytes: [0u8; 65536], len: 0 };
    let cap_p93: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p93, &lad.bytes, 0);
    buf_append_bytes(&packagesDir, cap_p93, lad.len);
    buf_append_lit(&packagesDir, STR_PTR("\\Packages"), STR_LEN("\\Packages"));
    let entries = StrList { items: [0u8; 16384], items_len: 0, lens: [0u64; 64], count: 0 };
    let cap_ld: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ld, &packagesDir.bytes, 0);
    if probe_list_dir_names(cap_ld, packagesDir.len, &entries) == 0 {
        // DEFECT: .sort() on entry names approximated — list_dir order assumed sorted.
        let off: u64 = 0;
        let ei: u64 = 0;
        while ei < entries.count {
            let name_len: u64 = entries.lens[ei];
            let full = ByteBuf { bytes: [0u8; 65536], len: 0 };
            let cap_p94: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p94, &packagesDir.bytes, 0);
            buf_append_bytes(&full, cap_p94, packagesDir.len);
            buf_append_lit(&full, STR_PTR("\\"), STR_LEN("\\"));
            buf_append_bytes(&full, PTR_ADD(entries.items, off), name_len);
            if probe_fs_is_dir(cap_p94, full.len) != 0 && msix_package_pattern_test(PTR_ADD(entries.items, off), name_len) {
                path_join_push(&candidates, &full, STR_PTR("LocalCache\\Local\\Claude-3p\\configLibrary"), STR_LEN("LocalCache\\Local\\Claude-3p\\configLibrary"));
                path_join_push(&candidates, &full, STR_PTR("LocalCache\\Roaming\\Claude-3p\\configLibrary"), STR_LEN("LocalCache\\Roaming\\Claude-3p\\configLibrary"));
            };
            off = off + name_len;
            ei = ei + 1;
        }
    };
    // for (const candidate of candidates) if (await pathExists(candidate)) return candidate;
    let coff: u64 = 0;
    let ci: u64 = 0;
    while ci < candidates.count {
        if pathExists(PTR_ADD(candidates.items, coff), candidates.lens[ci]) {
            buf_append_bytes(out, PTR_ADD(candidates.items, coff), candidates.lens[ci]);
            return 0;
        };
        coff = coff + candidates.lens[ci];
        ci = ci + 1;
    }
    // throw new Error(`Claude Desktop config library directory was not found (searched: ${candidates.join(", ")})`);
    buf_append_lit(err, STR_PTR("Claude Desktop config library directory was not found (searched: "), STR_LEN("Claude Desktop config library directory was not found (searched: "));
    let joined = ByteBuf { bytes: [0u8; 65536], len: 0 };
    strlist_join(&candidates, STR_PTR(", "), STR_LEN(", "), &joined);
    let cap_p95: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p95, &joined.bytes, 0);
    buf_append_bytes(err, cap_p95, joined.len);
    buf_append_lit(err, STR_PTR(")"), STR_LEN(")"));
    return 1;
}

struct ClaudeActiveConfig {
    id: [u8; 256],
    id_len: u64,
    path: [u8; 2048],
    path_len: u64,
    config_json: [u8; 262144], // JsonObject as JSON text
    config_json_len: u64,
}

// export async function readClaudeActiveConfig(configLibraryDir): Promise<{ id, path, config }>
// DEFECT: async — synchronous status-code form.
fn readClaudeActiveConfig(configLibraryDir_ptr: ptr, configLibraryDir_len: u64, out: &ClaudeActiveConfig, err: &ByteBuf) -> i32 {
    // const meta = parseJsonObject(await readFile(join(dir, "_meta.json"), "utf8"), "Claude Desktop config metadata");
    let meta_path = ByteBuf { bytes: [0u8; 65536], len: 0 };
    buf_append_bytes(&meta_path, configLibraryDir_ptr, configLibraryDir_len);
    buf_append_lit(&meta_path, STR_PTR("\\_meta.json"), STR_LEN("\\_meta.json"));
    let meta_src = ByteBuf { bytes: [0u8; 65536], len: 0 };
    let cap_rf1: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_rf1, &meta_path.bytes, 0);
    let fh1 = sa_fs_read_file(cap_rf1, meta_path.len, 262144);
    if fh1 == 0 {
        buf_append_lit(err, STR_PTR("could not read Claude Desktop config metadata"), STR_LEN("could not read Claude Desktop config metadata"));
        return 1;
    };
    let fh1_data: ptr = PTR_NULL();
    fh1_data = sa_fs_read_buffer_data(fh1);
    buf_append_bytes(&meta_src, fh1_data, sa_fs_read_buffer_len(fh1));
    let igf1 = sa_fs_read_buffer_free(fh1);
    let meta = ByteBuf { bytes: [0u8; 65536], len: 0 };
    let cap_p21046: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p21046, &meta_src.bytes, 0);
    if parseJsonObject( cap_p21046, meta_src.len, STR_PTR("Claude Desktop config metadata"), STR_LEN("Claude Desktop config metadata"), &meta, err) != 0 { return 1; };
    // const id = typeof meta.appliedId === "string" ? meta.appliedId.trim() : "";
    let id = ByteBuf { bytes: [0u8; 65536], len: 0 };
    let meta_doc = sa_json_parse(&meta.bytes, meta.len);
    if meta_doc != 0 {
        if json_has(meta_doc, STR_PTR("appliedId"), STR_LEN("appliedId")) {
            let jgs_p22: ptr = PTR_NULL(); PTR_BYTE_ADD(jgs_p22, &id.bytes, 0);
            id.len = json_get_string_copy(meta_doc, STR_PTR("appliedId"), STR_LEN("appliedId"), jgs_p22, 256);
            buf_trim_in_place(&id);
        };
        sa_json_free(meta_doc);
    };
    // if (!id || basename(id) !== id || !/^[A-Za-z0-9_-]+$/.test(id)) throw ...
    // DEFECT: id charset regex approximated by scan; basename check via separator scan.
    let id_ok: bool = id.len > 0;
    if id_ok {
        let i: u64 = 0;
        while i < id.len {
            let c = id.bytes[i];
            let ok_char: bool = (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95 || c == 45;
            if !(ok_char) { id_ok = false; };
            i = i + 1;
        }
    };
    if !(id_ok) {
        buf_append_lit(err, STR_PTR("Claude Desktop active third-party config was not found"), STR_LEN("Claude Desktop active third-party config was not found"));
        return 1;
    };
    out.id_len = id.len;
    buf_copy_to(&id, &out.id);
    // const path = join(configLibraryDir, `${id}.json`);
    let path = ByteBuf { bytes: [0u8; 65536], len: 0 };
    buf_append_bytes(&path, configLibraryDir_ptr, configLibraryDir_len);
    buf_append_lit(&path, STR_PTR("\\"), STR_LEN("\\"));
    let cap_p96: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p96, &id.bytes, 0);
    buf_append_bytes(&path, cap_p96, id.len);
    buf_append_lit(&path, STR_PTR(".json"), STR_LEN(".json"));
    out.path_len = path.len;
    buf_copy_to(&path, &out.path);
    // const config = parseJsonObject(await readFile(path, "utf8"), "Claude Desktop active config");
    let cfg_src = ByteBuf { bytes: [0u8; 65536], len: 0 };
    let cap_rf2: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_rf2, &path.bytes, 0);
    let fh2 = sa_fs_read_file(cap_rf2, path.len, 262144);
    if fh2 == 0 {
        buf_append_lit(err, STR_PTR("could not read Claude Desktop active config"), STR_LEN("could not read Claude Desktop active config"));
        return 1;
    };
    let fh2_data: ptr = PTR_NULL();
    fh2_data = sa_fs_read_buffer_data(fh2);
    buf_append_bytes(&cfg_src, fh2_data, sa_fs_read_buffer_len(fh2));
    let igf2 = sa_fs_read_buffer_free(fh2);
    let cfg = ByteBuf { bytes: [0u8; 65536], len: 0 };
    let cap_p21047: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p21047, &cfg_src.bytes, 0);
    if parseJsonObject( cap_p21047, cfg_src.len, STR_PTR("Claude Desktop active config"), STR_LEN("Claude Desktop active config"), &cfg, err) != 0 { return 1; };
    out.config_json_len = cfg.len;
    buf_copy_to(&cfg, &out.config_json);
    return 0;
}

struct ClaudeDesktopWriteResult {
    id: [u8; 256],
    id_len: u64,
    configPath: [u8; 2048],
    configPath_len: u64,
    desktopConfigPath: [u8; 2048],
    desktopConfigPath_len: u64,
}

// export async function writeClaudeDesktopInference(input): Promise<{ id, configPath, desktopConfigPath }>
// DEFECT: async — synchronous status-code form.
// DEFECT: dynamic JSON object merge ({...active.config, ...}) / delete keys /
// JSON.stringify(..., null, 2) approximated by sa_json_obj_* placeholder helpers
// operating on JSON text (key-order and pretty-print details not reproduced).

// FIX(be2): the sa_json_obj_* helpers were placeholders over a
// JSON text buffer. Implemented for real over the std handle API:
// parse the buffer text, mutate the node tree, stringify back.
// An empty/unparseable buffer starts from an empty object
// (matches the TS flow, where nextConfig always begins as a
// parsed object). Stringify buffers deliberately not freed
// (FIX_SAVMTOOL leak class).
fn di_json_obj_parse(buf: &ByteBuf) -> u64 {
    let cap_pj: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_pj, &buf.bytes, 0);
    let doc = sa_json_parse(cap_pj, buf.len);
    if doc != 0 && sa_json_kind(doc) == 7 { return doc; };
    return sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
}

fn di_json_obj_flush(buf: &ByteBuf, doc: u64) -> void {
    let hb: u64 = 0;
    if sa_json_stringify(doc, &hb) == 0 && hb != 0 {
        let dp: ptr = PTR_NULL();
        dp = sa_json_buffer_data(hb);
        buf.len = 0;
        buf_append_bytes(buf, dp, sa_json_buffer_len(hb));
    };
    let ig = sa_json_free(doc);
    return;
}

fn di_json_obj_set_string(buf: &ByteBuf, key_ptr: ptr, key_len: u64, val_ptr: ptr, val_len: u64) -> void {
    let doc = di_json_obj_parse(buf);
    if doc == 0 { return; };
    let ig = sa_json_object_set_string(doc, key_ptr, key_len, val_ptr, val_len);
    di_json_obj_flush(buf, doc);
    return;
}

fn di_json_obj_set_bool(buf: &ByteBuf, key_ptr: ptr, key_len: u64, value: bool) -> void {
    let doc = di_json_obj_parse(buf);
    if doc == 0 { return; };
    let ig = sa_json_object_set_bool(doc, key_ptr, key_len, if value { 1 } else { 0 });
    di_json_obj_flush(buf, doc);
    return;
}

fn di_json_obj_set_string_array(buf: &ByteBuf, key_ptr: ptr, key_len: u64, list: &StrList) -> void {
    let doc = di_json_obj_parse(buf);
    if doc == 0 { return; };
    let arr = sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
    if arr != 0 {
        let off: u64 = 0;
        let i: u64 = 0;
        while i < list.count {
            let cap_ja: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ja, &list.items, off);
            let igp = sa_json_array_push_string(arr, cap_ja, list.lens[i]);
            off = off + list.lens[i];
            i = i + 1;
        }
        let ig = sa_json_object_set_node(doc, key_ptr, key_len, arr);
    };
    di_json_obj_flush(buf, doc);
    return;
}

fn di_json_obj_delete(buf: &ByteBuf, key_ptr: ptr, key_len: u64) -> void {
    let doc = di_json_obj_parse(buf);
    if doc == 0 { return; };
    let ig = sa_json_object_remove(doc, key_ptr, key_len);
    di_json_obj_flush(buf, doc);
    return;
}


// FIX(be2): host_random_uuid bound to sa_deno_random_uuid
// (crypto.sai:32) with fmt-buffer readback.
fn di_random_uuid_append(out: &ByteBuf) -> void {
    let h: u64 = sa_deno_random_uuid();
    if h != 0 {
        let dp: ptr = PTR_NULL();
        dp = sa_fmt_buffer_data(h);
        buf_append_bytes(out, dp, sa_fmt_buffer_len(h));
        let ig = sa_fmt_buffer_free(h);
    };
    return;
}

// FIX(be2): sa_json_stringify_pretty was a placeholder. Bound to
// parse + sa_json_stringify over the std handle API. Deviation:
// output is compact, not the TS 2-space pretty layout; the JSON
// content is identical (the file is re-parsed by its readers).
fn di_json_stringify_pretty(src_ptr: ptr, src_len: u64, out: &ByteBuf) -> void {
    let doc = sa_json_parse(src_ptr, src_len);
    if doc == 0 { return; };
    di_json_obj_flush(out, doc);
    return;
}


// FIX(be2): sa_json_is_object bound to the kind face (7 = object).
fn di_json_is_object(doc: u64) -> bool {
    return doc != 0 && sa_json_kind(doc) == 7;
}

fn writeClaudeDesktopInference(input: &ClaudeDesktopInjectionInput, env_ptr: ptr, env_len: u64, out: &ClaudeDesktopWriteResult, err: &ByteBuf) -> i32 {
    // const baseUrl = input.baseUrl.trim().replace(/\/+$/, "");
    // DEFECT: trailing-slash regex strip approximated by scan.
    let baseUrl = ByteBuf { bytes: [0u8; 65536], len: 0 };
    let cap_p20887: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p20887, &input.baseUrl, 0);
    buf_append_bytes(&baseUrl, cap_p20887, input.baseUrl_len);
    buf_trim_in_place(&baseUrl);
    while baseUrl.len > 0 && baseUrl.bytes[baseUrl.len - 1] == 47 { baseUrl.len = baseUrl.len - 1; }
    // const token = input.token.trim();
    let token = ByteBuf { bytes: [0u8; 65536], len: 0 };
    let cap_p20888: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p20888, &input.token, 0);
    buf_append_bytes(&token, cap_p20888, input.token_len);
    buf_trim_in_place(&token);
    // const requestedModels = [...new Set(input.models.map(m => m.trim()).filter(Boolean))];
    let requestedModels = StrList { items: [0u8; 16384], items_len: 0, lens: [0u64; 64], count: 0 };
    let moff: u64 = 0;
    let mi: u64 = 0;
    while mi < input.models.count {
        let m = ByteBuf { bytes: [0u8; 65536], len: 0 };
        buf_append_bytes(&m, PTR_ADD(input.models.items, moff), input.models.lens[mi]);
        moff = moff + input.models.lens[mi];
        mi = mi + 1;
        buf_trim_in_place(&m);
        let cap_p20639: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p20639, &m.bytes, 0);
        if m.len > 0 && !(di_strset_has(&requestedModels, cap_p20639, m.len)) {
            strlist_push_buf(&requestedModels, &m.bytes, m.len);
        };
    }
    // const variantBaseModels = new Set(requestedModels.flatMap(model => { const match = model.match(PATTERN); return match ? [model.slice(0, match.index).trim()] : []; }));
    // DEFECT: flatMap approximated by loop; slice(0, match.index) equals splitModelContextVariant baseModel.
    let variantBaseModels = StrList { items: [0u8; 16384], items_len: 0, lens: [0u64; 64], count: 0 };
    let voff: u64 = 0;
    let vi: u64 = 0;
    while vi < requestedModels.count {
        let v = ModelContextVariant { baseModel: [0u8; 512], baseModel_len: 0, contextSuffix: [0u8; 64], contextSuffix_len: 0 };
        splitModelContextVariant(PTR_ADD(requestedModels.items, voff), requestedModels.lens[vi], &v);
        let cap_p20640: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p20640, &v.baseModel, 0);
        if v.contextSuffix_len > 0 && !(di_strset_has(&variantBaseModels, cap_p20640, v.baseModel_len)) {
            strlist_push_buf(&variantBaseModels, &v.baseModel, v.baseModel_len);
        };
        voff = voff + requestedModels.lens[vi];
        vi = vi + 1;
    }
    // const models = requestedModels.filter(model => PATTERN.test(model) || !variantBaseModels.has(model));
    // DEFECT: PATTERN.test(model) — model carries a variant suffix iff split yields one.
    let models = StrList { items: [0u8; 16384], items_len: 0, lens: [0u64; 64], count: 0 };
    let foff: u64 = 0;
    let fi: u64 = 0;
    while fi < requestedModels.count {
        let v2 = ModelContextVariant { baseModel: [0u8; 512], baseModel_len: 0, contextSuffix: [0u8; 64], contextSuffix_len: 0 };
        splitModelContextVariant(PTR_ADD(requestedModels.items, foff), requestedModels.lens[fi], &v2);
        if v2.contextSuffix_len > 0 || !(di_strset_has(&variantBaseModels, PTR_ADD(requestedModels.items, foff), requestedModels.lens[fi])) {
            strlist_push(&models, PTR_ADD(requestedModels.items, foff), requestedModels.lens[fi]);
        };
        foff = foff + requestedModels.lens[fi];
        fi = fi + 1;
    }
    // if (!baseUrl || !token || models.length === 0) throw new Error("Claude Desktop injection requires a gateway URL, token, and at least one model");
    if baseUrl.len == 0 || token.len == 0 || models.count == 0 {
        buf_append_lit(err, STR_PTR("Claude Desktop injection requires a gateway URL, token, and at least one model"), STR_LEN("Claude Desktop injection requires a gateway URL, token, and at least one model"));
        return 1;
    };
    // const configLibraryDir = input.configLibraryDir ?? await resolveClaudeConfigLibraryDir({ platform: input.platform, localAppData: input.localAppData });
    let configLibraryDir = ByteBuf { bytes: [0u8; 65536], len: 0 };
    if input.has_configLibraryDir {
        let cap_p20889: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p20889, &input.configLibraryDir, 0);
        buf_append_bytes(&configLibraryDir, cap_p20889, input.configLibraryDir_len);
    } else {
        let cap_p21049: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p21049, &input.platform, 0);
        let cap_p21050: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p21050, &input.localAppData, 0);
        let rc_cfg = resolveClaudeConfigLibraryDir(input.has_platform, cap_p21049, input.platform_len, input.has_localAppData, cap_p21050, input.localAppData_len, env_ptr, env_len, &configLibraryDir, err);
        if rc_cfg != 0 { return 1; };
    };
    // const active = await readClaudeActiveConfig(configLibraryDir);
    let active = ClaudeActiveConfig { id: [0u8; 256], id_len: 0, path: [0u8; 2048], path_len: 0, config_json: [0u8; 262144], config_json_len: 0 };
    let cap_p21051: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p21051, &configLibraryDir.bytes, 0);
    if readClaudeActiveConfig( cap_p21051, configLibraryDir.len, &active, err) != 0 { return 1; };
    // const nextConfig: JsonObject = { ...active.config, inferenceGatewayBaseUrl: baseUrl, inferenceGatewayApiKey: token, inferenceGatewayAuthScheme: "bearer", inferenceProvider: "gateway", inferenceCredentialKind: "static", inferenceModels: models, modelDiscoveryEnabled: false };
    // delete nextConfig.inference; delete nextConfig.models;
    let nextConfig = ByteBuf { bytes: [0u8; 65536], len: 0 };
    let cap_p20890: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p20890, &active.config_json, 0);
    buf_append_bytes(&nextConfig, cap_p20890, active.config_json_len);
    let cap_p21114: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p21114, &baseUrl.bytes, 0);
    di_json_obj_set_string(&nextConfig, STR_PTR("inferenceGatewayBaseUrl"), STR_LEN("inferenceGatewayBaseUrl"), cap_p21114, baseUrl.len);
    let cap_p21115: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p21115, &token.bytes, 0);
    di_json_obj_set_string(&nextConfig, STR_PTR("inferenceGatewayApiKey"), STR_LEN("inferenceGatewayApiKey"), cap_p21115, token.len);
    di_json_obj_set_string(&nextConfig, STR_PTR("inferenceGatewayAuthScheme"), STR_LEN("inferenceGatewayAuthScheme"), STR_PTR("bearer"), STR_LEN("bearer"));
    di_json_obj_set_string(&nextConfig, STR_PTR("inferenceProvider"), STR_LEN("inferenceProvider"), STR_PTR("gateway"), STR_LEN("gateway"));
    di_json_obj_set_string(&nextConfig, STR_PTR("inferenceCredentialKind"), STR_LEN("inferenceCredentialKind"), STR_PTR("static"), STR_LEN("static"));
    di_json_obj_set_string_array(&nextConfig, STR_PTR("inferenceModels"), STR_LEN("inferenceModels"), &models);
    di_json_obj_set_bool(&nextConfig, STR_PTR("modelDiscoveryEnabled"), STR_LEN("modelDiscoveryEnabled"), false);
    di_json_obj_delete(&nextConfig, STR_PTR("inference"), STR_LEN("inference"));
    di_json_obj_delete(&nextConfig, STR_PTR("models"), STR_LEN("models"));
    // const temporaryPath = join(configLibraryDir, `.${active.id}.${randomUUID()}.tmp`);
    let temporaryPath = ByteBuf { bytes: [0u8; 65536], len: 0 };
    let cap_p97: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p97, &configLibraryDir.bytes, 0);
    buf_append_bytes(&temporaryPath, cap_p97, configLibraryDir.len);
    buf_append_lit(&temporaryPath, STR_PTR("\\."), STR_LEN("\\."));
    let cap_p20891: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p20891, &active.id, 0);
    buf_append_bytes(&temporaryPath, cap_p20891, active.id_len);
    buf_append_lit(&temporaryPath, STR_PTR("."), STR_LEN("."));
    di_random_uuid_append(&temporaryPath);
    buf_append_lit(&temporaryPath, STR_PTR(".tmp"), STR_LEN(".tmp"));
    // await writeFile(temporaryPath, `${JSON.stringify(nextConfig, null, 2)}\n`, { encoding: "utf8", mode: 0o600 });
    let rendered = ByteBuf { bytes: [0u8; 65536], len: 0 };
    let cap_p21169: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p21169, &nextConfig.bytes, 0);
    di_json_stringify_pretty( cap_p21169, nextConfig.len, &rendered);
    buf_append_lit(&rendered, STR_PTR("\n"), STR_LEN("\n"));
    // FIX(be2): write-then-chmod over sa_fs_write_file +
    // sa_fs_set_permissions (fs.sai:48,120); TS passes mode 0o600
    // (384) to writeFile directly.
    let cap_w1: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_w1, &temporaryPath.bytes, 0);
    let cap_w2: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_w2, &rendered.bytes, 0);
    if sa_fs_write_file(cap_w1, temporaryPath.len, cap_w2, rendered.len) != 0 || sa_fs_set_permissions(cap_w1, temporaryPath.len, 384) != 0 {
        buf_append_lit(err, STR_PTR("could not write temporary config"), STR_LEN("could not write temporary config"));
        return 1;
    };
    // await rename(temporaryPath, active.path);
    let cap_rn: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_rn, &active.path, 0);
    if sa_fs_rename(cap_w1, temporaryPath.len, cap_rn, active.path_len) != 0 {
        buf_append_lit(err, STR_PTR("could not rename temporary config"), STR_LEN("could not rename temporary config"));
        return 1;
    };
    // const desktopConfigPath = join(dirname(configLibraryDir), "claude_desktop_config.json");
    let desktopConfigPath = ByteBuf { bytes: [0u8; 65536], len: 0 };
    let cap_p21206: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p21206, &configLibraryDir.bytes, 0);
    path_dirname( cap_p21206, configLibraryDir.len, &desktopConfigPath);
    buf_append_lit(&desktopConfigPath, STR_PTR("\\claude_desktop_config.json"), STR_LEN("\\claude_desktop_config.json"));
    // let existingDesktopConfig: JsonObject = {};
    // try { existingDesktopConfig = parseJsonObject(await readFile(desktopConfigPath, "utf8"), "Claude Desktop settings"); }
    // catch (error) { if (!(error instanceof Error) || !/ENOENT/.test(error.message)) throw error; }
    // DEFECT: ENOENT detection on the error approximates "file missing" via exists probe.
    let existingDesktopConfig = ByteBuf { bytes: [0u8; 65536], len: 0 };
    buf_append_lit(&existingDesktopConfig, STR_PTR("{}"), STR_LEN("{}"));
    let cap_p21207: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p21207, &desktopConfigPath.bytes, 0);
    if pathExists( cap_p21207, desktopConfigPath.len) {
        let dsrc = ByteBuf { bytes: [0u8; 65536], len: 0 };
        let fh3 = sa_fs_read_file(cap_p21207, desktopConfigPath.len, 262144);
        if fh3 == 0 {
            buf_append_lit(err, STR_PTR("could not read Claude Desktop settings"), STR_LEN("could not read Claude Desktop settings"));
            return 1;
        };
        let fh3_data: ptr = PTR_NULL();
        fh3_data = sa_fs_read_buffer_data(fh3);
        buf_append_bytes(&dsrc, fh3_data, sa_fs_read_buffer_len(fh3));
        let igf3 = sa_fs_read_buffer_free(fh3);
        let parsed_desktop = ByteBuf { bytes: [0u8; 65536], len: 0 };
        let cap_p21048: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p21048, &dsrc.bytes, 0);
        if parseJsonObject( cap_p21048, dsrc.len, STR_PTR("Claude Desktop settings"), STR_LEN("Claude Desktop settings"), &parsed_desktop, err) != 0 { return 1; };
        existingDesktopConfig.len = 0;
        let cap_p98: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p98, &parsed_desktop.bytes, 0);
        buf_append_bytes(&existingDesktopConfig, cap_p98, parsed_desktop.len);
    };
    // const nextDesktopConfig: JsonObject = { ...existingDesktopConfig, deploymentMode: "3p" }; delete nextDesktopConfig.awaitingSignIn;
    let nextDesktopConfig = ByteBuf { bytes: [0u8; 65536], len: 0 };
    let cap_p99: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p99, &existingDesktopConfig.bytes, 0);
    buf_append_bytes(&nextDesktopConfig, cap_p99, existingDesktopConfig.len);
    di_json_obj_set_string(&nextDesktopConfig, STR_PTR("deploymentMode"), STR_LEN("deploymentMode"), STR_PTR("3p"), STR_LEN("3p"));
    di_json_obj_delete(&nextDesktopConfig, STR_PTR("awaitingSignIn"), STR_LEN("awaitingSignIn"));
    // await writeFile(desktopConfigPath, `${JSON.stringify(nextDesktopConfig, null, 2)}\n`, { encoding: "utf8", mode: 0o600 });
    let rendered2 = ByteBuf { bytes: [0u8; 65536], len: 0 };
    let cap_p21170: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p21170, &nextDesktopConfig.bytes, 0);
    di_json_stringify_pretty( cap_p21170, nextDesktopConfig.len, &rendered2);
    buf_append_lit(&rendered2, STR_PTR("\n"), STR_LEN("\n"));
    let cap_w3: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_w3, &desktopConfigPath.bytes, 0);
    let cap_w4: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_w4, &rendered2.bytes, 0);
    if sa_fs_write_file(cap_w3, desktopConfigPath.len, cap_w4, rendered2.len) != 0 || sa_fs_set_permissions(cap_w3, desktopConfigPath.len, 384) != 0 {
        buf_append_lit(err, STR_PTR("could not write desktop config"), STR_LEN("could not write desktop config"));
        return 1;
    };
    // return { id: active.id, configPath: active.path, desktopConfigPath };
    out.id_len = active.id_len;
    let cap_p20946: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p20946, &active.id, 0);
    buf_copy_ptr_to( cap_p20946, active.id_len, &out.id);
    out.configPath_len = active.path_len;
    let cap_p20947: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p20947, &active.path, 0);
    buf_copy_ptr_to( cap_p20947, active.path_len, &out.configPath);
    out.desktopConfigPath_len = desktopConfigPath.len;
    buf_copy_to(&desktopConfigPath, &out.desktopConfigPath);
    return 0;
}

// DEFECT: node:path dirname approximated — strip last segment after / or \.
fn path_dirname(p: ptr, len: u64, out: &ByteBuf) -> void {
    let end: u64 = len;
    while end > 0 && (PTR_BYTE_AT(p, end - 1) == 47 || PTR_BYTE_AT(p, end - 1) == 92) { end = end - 1; }
    let last: i64 = -1;
    let i: u64 = 0;
    while i < end {
        let c = PTR_BYTE_AT(p, i);
        if c == 47 || c == 92 { last = i; };
        i = i + 1;
    }
    if last < 0 { buf_append_bytes(out, p, end); return; };
    buf_append_bytes(out, p, last);
    return;
}

// fn parseJsonObject(source, label): JsonObject — returns 0 + object JSON text in out, 1 + error in err.
fn parseJsonObject(source_ptr: ptr, source_len: u64, label_ptr: ptr, label_len: u64, out: &ByteBuf, err: &ByteBuf) -> i32 {
    // let value; try { value = JSON.parse(source); } catch { throw new Error(`${label} is not valid JSON`); }
    let doc = sa_json_parse(source_ptr, source_len);
    if doc == 0 {
        buf_append_bytes(err, label_ptr, label_len);
        buf_append_lit(err, STR_PTR(" is not valid JSON"), STR_LEN(" is not valid JSON"));
        return 1;
    };
    // if (!value || typeof value !== "object" || Array.isArray(value)) throw new Error(`${label} must be a JSON object`);
    let is_obj: bool = di_json_is_object(doc);
    sa_json_free(doc);
    if !(is_obj) {
        buf_append_bytes(err, label_ptr, label_len);
        buf_append_lit(err, STR_PTR(" must be a JSON object"), STR_LEN(" must be a JSON object"));
        return 1;
    };
    buf_append_bytes(out, source_ptr, source_len);
    return 0;
}
