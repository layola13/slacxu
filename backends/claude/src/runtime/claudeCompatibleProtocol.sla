    parent_tool_use_id: [u8; 128],
    parent_tool_use_id_len: u64,
    message_id: [u8; 128],
    message_id_len: u64,
    message_role: [u8; 32], // "assistant"
    message_role_len: u64,
    content_json: [u8; 65536], // raw JSON of message.content
    content_json_len: u64,
    has_error: bool,
    error_type: [u8; 128],
    error_type_len: u64,
    error_message: [u8; 2048],
    error_message_len: u64,
}

