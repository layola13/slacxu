// DEFECT: union type — TS ClaudeMessage is a discriminated union of the message
// structs above plus a catch-all { type: string; session_id?: string; [key: string]: unknown }.
// SLA has no sum types; approximated as a kind tag + raw JSON buffer, with the
// concrete structs above available for field access after inspection.
const CLAUDE_MESSAGE_KIND_UNKNOWN: u64 = 0;
const CLAUDE_MESSAGE_KIND_SYSTEM_INIT: u64 = 1;
const CLAUDE_MESSAGE_KIND_ASSISTANT: u64 = 2;
const CLAUDE_MESSAGE_KIND_USER: u64 = 3;
const CLAUDE_MESSAGE_KIND_RESULT: u64 = 4;
const CLAUDE_MESSAGE_KIND_STREAM_EVENT: u64 = 5;
const CLAUDE_MESSAGE_KIND_CONTROL_REQUEST: u64 = 6;
const CLAUDE_MESSAGE_KIND_CONTROL_RESPONSE: u64 = 7;
const CLAUDE_MESSAGE_KIND_STREAMLINED_TEXT: u64 = 8;

struct ClaudeMessage {
    kind: u64,
    type_: [u8; 64],
    type_len: u64,
    has_session_id: bool,
    session_id: [u8; 128],
    session_id_len: u64,
    json: [u8; 262144], // full raw JSON text of the message (catch-all payload)
    json_len: u64,
}

// DEFECT: union type — TS ClaudeContentBlock is a discriminated union
// ({type:"text"} | {type:"tool_use"} | {type:"tool_result"} | {type:"thinking"} | catch-all).
// Approximated as one struct with a type tag and all fields present.
struct ClaudeContentBlock {
    type_: [u8; 64],
    type_len: u64,
    text: [u8; 65536],
    text_len: u64,
    id: [u8; 128],
    id_len: u64,
    name: [u8; 256],
    name_len: u64,
    input_json: [u8; 65536], // tool_use.input: unknown in TS
    input_json_len: u64,
    tool_use_id: [u8; 128],
    tool_use_id_len: u64,
    content_json: [u8; 65536], // tool_result.content: unknown in TS
    content_json_len: u64,
    thinking: [u8; 65536],
    thinking_len: u64,
}

// Parse a raw NDJSON line into a typed Claude message.
// Returns null for unparseable lines.
// DEFECT: nullable return — SLA has no null for struct returns; returns status code
// (0 = ok, 1 = empty line, 2 = JSON parse failure) and fills `out` on success.
// DEFECT: dynamic JSON — JSON.parse typed cast approximated by sa_json_* field probes.
fn parseClaudeMessage(line_ptr: ptr, line_len: u64, out: &ClaudeMessage) -> i32 {
    // const trimmed = line.trim();
    let start: u64 = 0;
    let end: u64 = line_len;
    while start < end {
        let c = PTR_BYTE_AT(line_ptr, start);
        if c != 32 && c != 9 && c != 10 && c != 13 { break; };
        start = start + 1;
    }
    while end > start {
        let c = PTR_BYTE_AT(line_ptr, end - 1);
        if c != 32 && c != 9 && c != 10 && c != 13 { break; };
        end = end - 1;
    }
    // if (trimmed.length === 0) return null;
    if end <= start { return 1; };
    let tlen: u64 = end - start;
    // try { return JSON.parse(trimmed) as ClaudeMessage; } catch { return null; }
    let doc = sa_json_parse(PTR_ADD(line_ptr, start), tlen);
    if doc == 0 { return 2; };
    out.json_len = 0;
    let i: u64 = 0;
    while i < tlen {
        out.json[i] = PTR_BYTE_AT(line_ptr, start + i);
        i = i + 1;
    }
    out.json_len = tlen;
    // Read "type" field to classify the union kind.
    let jgs_p8: ptr = PTR_NULL(); PTR_BYTE_ADD(jgs_p8, &out.type_, 0);
    out.type_len = json_get_string_copy(doc, STR_PTR("type"), STR_LEN("type"), jgs_p8, 64);
    out.has_session_id = json_has(doc, STR_PTR("session_id"), STR_LEN("session_id"));
    if out.has_session_id {
        let jgs_p9: ptr = PTR_NULL(); PTR_BYTE_ADD(jgs_p9, &out.session_id, 0);
        out.session_id_len = json_get_string_copy(doc, STR_PTR("session_id"), STR_LEN("session_id"), jgs_p9, 128);
    };
    out.kind = CLAUDE_MESSAGE_KIND_UNKNOWN;
    let cap_p53: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p53, &out.type_, 0);
    if bytes_eq(cap_p53, out.type_len, STR_PTR("system"), STR_LEN("system")) { out.kind = CLAUDE_MESSAGE_KIND_SYSTEM_INIT; };
    let cap_p54: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p54, &out.type_, 0);
    if bytes_eq(cap_p54, out.type_len, STR_PTR("assistant"), STR_LEN("assistant")) { out.kind = CLAUDE_MESSAGE_KIND_ASSISTANT; };
    let cap_p55: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p55, &out.type_, 0);
    if bytes_eq(cap_p55, out.type_len, STR_PTR("user"), STR_LEN("user")) { out.kind = CLAUDE_MESSAGE_KIND_USER; };
    let cap_p56: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p56, &out.type_, 0);
    if bytes_eq(cap_p56, out.type_len, STR_PTR("result"), STR_LEN("result")) { out.kind = CLAUDE_MESSAGE_KIND_RESULT; };
    let cap_p57: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p57, &out.type_, 0);
    if bytes_eq(cap_p57, out.type_len, STR_PTR("stream_event"), STR_LEN("stream_event")) { out.kind = CLAUDE_MESSAGE_KIND_STREAM_EVENT; };
    let cap_p58: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p58, &out.type_, 0);
    if bytes_eq(cap_p58, out.type_len, STR_PTR("control_request"), STR_LEN("control_request")) { out.kind = CLAUDE_MESSAGE_KIND_CONTROL_REQUEST; };
    let cap_p59: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p59, &out.type_, 0);
    if bytes_eq(cap_p59, out.type_len, STR_PTR("control_response"), STR_LEN("control_response")) { out.kind = CLAUDE_MESSAGE_KIND_CONTROL_RESPONSE; };
    let cap_p60: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p60, &out.type_, 0);
    if bytes_eq(cap_p60, out.type_len, STR_PTR("streamlined_text"), STR_LEN("streamlined_text")) { out.kind = CLAUDE_MESSAGE_KIND_STREAMLINED_TEXT; };
    sa_json_free(doc);
    return 0;
}

// Extract the session_id from any Claude message.
// DEFECT: TS returns string | undefined; SLA returns length (0 = undefined) and copies into out buffer.
fn extractSessionId(message: &ClaudeMessage, out_ptr: ptr, out_cap: u64) -> u64 {
    // return typeof message.session_id === "string" ? message.session_id : undefined;
    if !(message.has_session_id) { return 0; };
    let n: u64 = message.session_id_len;
    if n > out_cap { n = out_cap; };
    let i: u64 = 0;
    while i < n {
        PTR_SET_BYTE(out_ptr, i, message.session_id[i]);
        i = i + 1;
    }
    return n;
}

// Correct control_response structure for Claude Code 2.x.
// The response object wraps subtype, request_id, and an optional response field.
// DEFECT: dynamic object — TS returns JsonValue object; SLA builds the JSON text
// into the out buffer and returns its length.
fn buildControlResponse(requestId_ptr: ptr, requestId_len: u64, allowed: bool, has_denyReason: bool, denyReason_ptr: ptr, denyReason_len: u64, out: &ByteBuf) -> u64 {
    if !(allowed) {
        // return { type: "control_response", response: { subtype: "error", request_id, error: denyReason ?? "Permission denied by user" } }
        buf_append_lit(out, STR_PTR("{\"type\":\"control_response\",\"response\":{\"subtype\":\"error\",\"request_id\":\""), STR_LEN("{\"type\":\"control_response\",\"response\":{\"subtype\":\"error\",\"request_id\":\""));
        buf_append_bytes(out, requestId_ptr, requestId_len);
        buf_append_lit(out, STR_PTR("\",\"error\":\""), STR_LEN("\",\"error\":\""));
        if has_denyReason {
            buf_append_bytes(out, denyReason_ptr, denyReason_len);
        } else {
            buf_append_lit(out, STR_PTR("Permission denied by user"), STR_LEN("Permission denied by user"));
        };
        buf_append_lit(out, STR_PTR("\"}}"), STR_LEN("\"}}"));
        return out.len;
    };
    // return { type: "control_response", response: { subtype: "success", request_id, response: { behavior: "allow" } } }
    buf_append_lit(out, STR_PTR("{\"type\":\"control_response\",\"response\":{\"subtype\":\"success\",\"request_id\":\""), STR_LEN("{\"type\":\"control_response\",\"response\":{\"subtype\":\"success\",\"request_id\":\""));
    buf_append_bytes(out, requestId_ptr, requestId_len);
    buf_append_lit(out, STR_PTR("\",\"response\":{\"behavior\":\"allow\"}}}"), STR_LEN("\",\"response\":{\"behavior\":\"allow\"}}}"));
    return out.len;
}

// Build a control_request to interrupt the current turn.
// DEFECT: dynamic object — TS returns JsonValue object; SLA builds JSON text into out buffer.
fn buildInterruptRequest(requestId_ptr: ptr, requestId_len: u64, out: &ByteBuf) -> u64 {
    // return { type: "control_request", request_id: requestId, request: { subtype: "interrupt" } }
    buf_append_lit(out, STR_PTR("{\"type\":\"control_request\",\"request_id\":\""), STR_LEN("{\"type\":\"control_request\",\"request_id\":\""));
    buf_append_bytes(out, requestId_ptr, requestId_len);
    buf_append_lit(out, STR_PTR("\",\"request\":{\"subtype\":\"interrupt\"}}"), STR_LEN("\",\"request\":{\"subtype\":\"interrupt\"}}"));
    return out.len;
}
