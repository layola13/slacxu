// FIX: sa_json_has does not exist in sa_std; key presence is
// sa_json_object_get succeeding (encoding/json.sai).
fn json_has(doc: u64, key_ptr: ptr, key_len: u64) -> bool {
    let h: u64 = 0;
    return sa_json_object_get(doc, key_ptr, key_len, &h) == 0;
}




// Narrow type definitions for the Claude Code stream-json protocol.
// These are intentionally minimal — they cover only the message shapes
// the projector needs to inspect. Unknown fields are ignored.
//
// Reference: E:\projects\codecli\src\entrypoints\sdk\coreSchemas.ts
//            E:\projects\codecli\src\entrypoints\sdk\controlSchemas.ts

// DEFECT: dynamic object — ClaudeSystemInitMessage.tools is string[] in TS;
// SLA approximation: fixed array of (ptr,len) pairs, capacity 256 + tools_len.
// DEFECT: string fields are (ptr,len) pairs into caller-owned buffers; no owned String type.
struct ClaudeSystemInitMessage {
    type_: [u8; 32], // "system"
    type_len: u64,
    subtype: [u8; 64], // "init"
    subtype_len: u64,
    session_id: [u8; 128],
    session_id_len: u64,
    claude_code_version: [u8; 64],
    claude_code_version_len: u64,
    cwd: [u8; 1024],
    cwd_len: u64,
    model: [u8; 256],
    model_len: u64,
    permissionMode: [u8; 64],
    permissionMode_len: u64,
    tools: [u8; 16384], // concatenated tool names, newline-separated (approximation)
    tools_len: u64,
    tools_count: u64,
}

