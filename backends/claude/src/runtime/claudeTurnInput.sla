// Converted 1:1 from backends/claude/src/runtime/claudeTurnInput.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "sa_std/string.sa"
@import "sa_std/ptr.sa"
@import "sa_std/encoding/json.sai"
@import "sa_std/fs.sai"
@import "claudeCompatibleProbe.sla"
@import "sa_std/encoding/base64.sai"
@import "sa_std/fmt.sai"


// FIX: sa_json_input_entry_string / _has_string do not exist in
// sa_std; they probe entry idx of a JSON array doc for a string
// field. Bound here over sa_json_array_get +
// sa_json_object_get_string (encoding/json.sai).
fn json_input_entry_string(doc: u64, idx: u64, key_ptr: ptr, key_len: u64, out: ptr, out_cap: u64) -> u64 {
    let entry: u64 = 0;
    if sa_json_array_get(doc, idx, &entry) != 0 { return 0; };
    let sp: ptr = PTR_NULL();
    let sl: u64 = 0;
    if sa_json_object_get_string(entry, key_ptr, key_len, &sp, &sl) != 0 { return 0; };
    let n = sl;
    if n > out_cap { n = out_cap; };
    let i: u64 = 0;
    while i < n {
        let v: u8 = 0;
        PTR_BYTE_AT(v, sp, i);
        let wp: ptr = PTR_NULL();
        PTR_BYTE_ADD(wp, out, i);
        PTR_WRITE_U8(wp, v);
        i = i + 1;
    }
    return n;
}

fn json_input_entry_has_string(doc: u64, idx: u64, key_ptr: ptr, key_len: u64) -> bool {
    let entry: u64 = 0;
    if sa_json_array_get(doc, idx, &entry) != 0 { return false; };
    let sp: ptr = PTR_NULL();
    let sl: u64 = 0;
    return sa_json_object_get_string(entry, key_ptr, key_len, &sp, &sl) == 0;
}


// Converts workbench `turn/start` input blocks into the shape the Claude
// Code stream-json stdin protocol expects.
// (Composer block types text/image/localImage/mention/skill; images become
// base64 `image` blocks, file attachments become `@"path"` refs — see TS header.)

// DEFECT: @cxu/sdk-backend helpers pathOnlyHistoryPlaceholder / toPathOnlyImageBlock
// have no SLA counterpart; host_* placeholder externs below return their JSON text.
// DEFECT: JsonValue blocks are dynamic JSON; params/entries are JSON text buffers
// probed with sa_json_input_* placeholder accessors (sa_std lacks a generic
// array-of-objects JSON surface).
// DEFECT: async (node:fs/promises readFile) — converted to synchronous reads;
// extractTurnInput is marked DEFECT: async at its signature.

const MAX_INLINE_IMAGE_BYTES: u64 = 25165824; // 24 * 1024 * 1024

// Media types the Messages API accepts for base64 image sources.
// TS: const SUPPORTED_IMAGE_MEDIA_TYPES = new Set(["image/jpeg", "image/png", "image/gif", "image/webp"]);
// DEFECT: Set membership approximated by comparisons.
fn is_supported_image_media_type(v_ptr: ptr, v_len: u64) -> bool {
    if bytes_eq_buf(v_ptr, v_len, STR_PTR("image/jpeg"), STR_LEN("image/jpeg")) { return true; };
    if bytes_eq_buf(v_ptr, v_len, STR_PTR("image/png"), STR_LEN("image/png")) { return true; };
    if bytes_eq_buf(v_ptr, v_len, STR_PTR("image/gif"), STR_LEN("image/gif")) { return true; };
    if bytes_eq_buf(v_ptr, v_len, STR_PTR("image/webp"), STR_LEN("image/webp")) { return true; };
    return false;
}

// DEFECT: union types ClaudeImageSource / ClaudeContentBlockParam approximated
// as tagged structs.
const IMAGE_SOURCE_BASE64: u64 = 0;
const IMAGE_SOURCE_URL: u64 = 1;

struct ClaudeImageSource {
    source_kind: u64, // IMAGE_SOURCE_*
    media_type: [u8; 64], // base64 variant only
    media_type_len: u64,
    data: [u8; 33554432], // base64 text (base64 variant); DEFECT: fixed 32MB cap
    data_len: u64,
    url: [u8; 8192], // url variant only
    url_len: u64,
}

struct ClaudeImageBlock {
    // type: "image" (constant)
    source: ClaudeImageSource,
}

struct ClaudeContentBlockParam {
    block_kind: u64, // 0 = { type: "text", text }, 1 = ClaudeImageBlock
    text: [u8; 1048576],
    text_len: u64,
    image: ClaudeImageBlock,
}

struct ClaudeTurnInput {
    text: [u8; 1048576],
    text_len: u64,
    displayText: [u8; 1048576],
    displayText_len: u64,
    images: [ClaudeImageBlock; 64], // DEFECT: fixed capacity
    images_count: u64,
    attachmentBlocks: StrList, // JsonValue[] as raw JSON texts
    warnings: StrList, // string[]
}

// stringField(record, keys): first key whose value is a non-empty string.
// Here the "record" is an input-array entry probed from the params doc.
fn turn_entry_string_field(doc: u64, idx: u64, key_ptr: ptr, key_len: u64, out: &ByteBuf) -> bool {
    // typeof value === "string" && value.trim() — returns the *untrimmed* value in TS.
    let raw: [u8; 8192] = [0u8; 8192];
    let raw_p: ptr = PTR_NULL(); PTR_BYTE_ADD(raw_p, &raw, 0);
    let n: u64 = json_input_entry_string(doc, idx, key_ptr, key_len, raw_p, 8192);
    if !(json_input_entry_has_string(doc, idx, key_ptr, key_len)) { return false; };
    let probe = ByteBuf { bytes: [0u8; 65536], len: 0 };
    buf_append_bytes(&probe, raw_p, n);
    buf_trim_in_place(&probe);
    if probe.len == 0 { return false; };
    buf_append_bytes(out, raw_p, n);
    return true;
}

// Detect the media type from base64 magic bytes, as the CLI does for bridge input.
// Returns false for TS undefined; out receives the media type.
fn detectImageMediaType(base64_ptr: ptr, base64_len: u64, out: &ByteBuf) -> bool {
    // const head = base64.slice(0, 16);
    // if (head.startsWith("/9j/")) return "image/jpeg"; etc.
    if starts_with(base64_ptr, base64_len, STR_PTR("/9j/"), STR_LEN("/9j/")) { buf_append_lit(out, STR_PTR("image/jpeg"), STR_LEN("image/jpeg")); return true; };
    if starts_with(base64_ptr, base64_len, STR_PTR("iVBORw0KGgo"), STR_LEN("iVBORw0KGgo")) { buf_append_lit(out, STR_PTR("image/png"), STR_LEN("image/png")); return true; };
    if starts_with(base64_ptr, base64_len, STR_PTR("R0lGOD"), STR_LEN("R0lGOD")) { buf_append_lit(out, STR_PTR("image/gif"), STR_LEN("image/gif")); return true; };
    if starts_with(base64_ptr, base64_len, STR_PTR("UklGR"), STR_LEN("UklGR")) { buf_append_lit(out, STR_PTR("image/webp"), STR_LEN("image/webp")); return true; };
    return false;
}

fn starts_with(p: ptr, len: u64, prefix_ptr: ptr, prefix_len: u64) -> bool {
    if len < prefix_len { return false; };
    let i: u64 = 0;
    while i < prefix_len { if PTR_BYTE_AT(p, i) != PTR_BYTE_AT(prefix_ptr, i) { return false; }; i = i + 1; }
    return true;
}

fn imageMediaTypeForPath(path_ptr: ptr, path_len: u64, out: &ByteBuf) -> bool {
    // switch (path.split(".").pop()?.toLowerCase())
    // last "." segment
    let dot: u64 = 0;
    let has_dot: bool = false;
    let i: u64 = 0;
    while i < path_len { if PTR_BYTE_AT(path_ptr, i) == 46 { dot = i; has_dot = true; }; i = i + 1; }
    if !has_dot { return false; };
    let ext = ByteBuf { bytes: [0u8; 65536], len: 0 };
    buf_append_bytes(&ext, PTR_ADD(path_ptr, dot + 1), path_len - dot - 1);
    buf_lower_in_place(&ext);
    let cap_p117: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p117, &ext.bytes, 0);
    if bytes_eq_buf(cap_p117, ext.len, STR_PTR("png"), STR_LEN("png")) { buf_append_lit(out, STR_PTR("image/png"), STR_LEN("image/png")); return true; };
    let cap_p118: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p118, &ext.bytes, 0);
    let cap_p119: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p119, &ext.bytes, 0);
    if bytes_eq_buf(cap_p118, ext.len, STR_PTR("jpg"), STR_LEN("jpg")) || bytes_eq_buf(cap_p119, ext.len, STR_PTR("jpeg"), STR_LEN("jpeg")) { buf_append_lit(out, STR_PTR("image/jpeg"), STR_LEN("image/jpeg")); return true; };
    let cap_p120: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p120, &ext.bytes, 0);
    if bytes_eq_buf(cap_p120, ext.len, STR_PTR("gif"), STR_LEN("gif")) { buf_append_lit(out, STR_PTR("image/gif"), STR_LEN("image/gif")); return true; };
    let cap_p121: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p121, &ext.bytes, 0);
    if bytes_eq_buf(cap_p121, ext.len, STR_PTR("webp"), STR_LEN("webp")) { buf_append_lit(out, STR_PTR("image/webp"), STR_LEN("image/webp")); return true; };
    return false;
}

// Pick a media type the API accepts.
fn normalizeImageMediaType(has_declared: bool, declared_ptr: ptr, declared_len: u64, base64_ptr: ptr, base64_len: u64, out: &ByteBuf) -> void {
    // const lowered = declared?.toLowerCase();
    let lowered = ByteBuf { bytes: [0u8; 65536], len: 0 };
    if has_declared { buf_append_bytes(&lowered, declared_ptr, declared_len); buf_lower_in_place(&lowered); };
    // if (lowered === "image/jpg") return "image/jpeg";
    let cap_p122: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p122, &lowered.bytes, 0);
    if bytes_eq_buf(cap_p122, lowered.len, STR_PTR("image/jpg"), STR_LEN("image/jpg")) { buf_append_lit(out, STR_PTR("image/jpeg"), STR_LEN("image/jpeg")); return; };
    // if (lowered && SUPPORTED_IMAGE_MEDIA_TYPES.has(lowered)) return lowered;
    let cap_p123: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p123, &lowered.bytes, 0);
    let cap_ti1001: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ti1001, &lowered.bytes, 0);
    if lowered.len > 0 && is_supported_image_media_type( cap_ti1001, lowered.len) { buf_append_bytes(out, cap_p123, lowered.len); return; };
    // return detectImageMediaType(base64) ?? "image/png";
    if detectImageMediaType(base64_ptr, base64_len, out) { return; };
    buf_append_lit(out, STR_PTR("image/png"), STR_LEN("image/png"));
    return;
}

struct ParsedDataUrl {
    has_mediaType: bool,
    mediaType: [u8; 128],
    mediaType_len: u64,
    base64: [u8; 33554432], // DEFECT: fixed cap
    base64_len: u64,
}

// Returns false for TS null.
// FIX(be2): uri_decode_bytes existed nowhere (sa_std has no
// percent-decode face — checked encoding/ and the full sa_std
// inventory). decodeURIComponent semantics implemented by hand:
// %XX hex pairs decode to bytes, everything else passes through
// ('+' is NOT special for decodeURIComponent). DEFECT: TS throws on
// malformed escapes / invalid UTF-8; this pass copies malformed
// escapes literally and does not validate UTF-8.
fn ti_buf_append_u64(out: &ByteBuf, v: u64) -> void {
    if v == 0 { buf_append_byte(out, 48); return; };
    let digits: [u8; 20] = [0u8; 20];
    let n: u64 = 0;
    let x = v;
    while x > 0 {
        digits[n] = (x % 10) as u8 + 48;
        n = n + 1;
        x = x / 10;
    }
    while n > 0 {
        n = n - 1;
        buf_append_byte(out, digits[n]);
    }
    return;
}

fn ti_hex_val(c: u8) -> u8 {
    if c >= 48 && c <= 57 { return c - 48; };
    if c >= 65 && c <= 70 { return c - 55; };
    if c >= 97 && c <= 102 { return c - 87; };
    return 255;
}

fn ti_uri_decode_bytes(p: ptr, n: u64, out: &ByteBuf) -> void {
    let i: u64 = 0;
    while i < n {
        let c: u8 = PTR_BYTE_AT(p, i);
        if c == 37 && i + 2 < n {
            let h1 = ti_hex_val(PTR_BYTE_AT(p, i + 1));
            let h2 = ti_hex_val(PTR_BYTE_AT(p, i + 2));
            if h1 != 255 && h2 != 255 {
                out.bytes[out.len] = h1 * 16 + h2;
                out.len = out.len + 1;
                i = i + 3;
                continue;
            };
        };
        out.bytes[out.len] = c;
        out.len = out.len + 1;
        i = i + 1;
    }
    return;
}

fn parseDataUrl(url_ptr: ptr, url_len: u64, out: &ParsedDataUrl) -> bool {
    // if (!url.startsWith("data:")) return null;
    if !(starts_with(url_ptr, url_len, STR_PTR("data:"), STR_LEN("data:"))) { return false; };
    // const separator = url.indexOf(","); if (separator < 0) return null;
    let sep: u64 = 0;
    let has_sep: bool = false;
    let i: u64 = 0;
    while i < url_len { if PTR_BYTE_AT(url_ptr, i) == 44 { sep = i; has_sep = true; break; }; i = i + 1; }
    if !has_sep { return false; };
    // const header = url.slice(5, separator); const payload = url.slice(separator + 1);
    let header_len: u64 = sep - 5;
    // const isBase64 = /;base64$/i.test(header);
    // DEFECT: regex suffix test approximated by case-insensitive suffix scan.
    let hdr_ptr: ptr = PTR_ADD(url_ptr, 5);
    let is_base64: bool = ends_with_ci(hdr_ptr, header_len, STR_PTR(";base64"), STR_LEN(";base64"));
    // const mediaType = header.replace(/;base64$/i, "").split(";")[0]?.trim() || undefined;
    let mt = ByteBuf { bytes: [0u8; 65536], len: 0 };
    let mt_end: u64 = header_len;
    if is_base64 { mt_end = header_len - STR_LEN(";base64"); };
    let j: u64 = 0;
    while j < mt_end && PTR_BYTE_AT(url_ptr, 5 + j) != 59 { j = j + 1; }
    buf_append_bytes(&mt, PTR_ADD(url_ptr, 5), j);
    buf_trim_in_place(&mt);
    out.has_mediaType = mt.len > 0;
    out.mediaType_len = mt.len;
    buf_copy_to(&mt, &out.mediaType);
    let payload_ptr: ptr = PTR_ADD(url_ptr, sep + 1);
    let payload_len: u64 = url_len - sep - 1;
    if is_base64 {
        // return { mediaType, base64: payload.replace(/\s+/g, "") };
        // DEFECT: regex whitespace strip approximated by scan.
        out.base64_len = 0;
        let k: u64 = 0;
        while k < payload_len {
            let c = PTR_BYTE_AT(payload_ptr, k);
            if !(probe_is_space(c)) {
                out.base64[out.base64_len] = c;
                out.base64_len = out.base64_len + 1;
            };
            k = k + 1;
        }
        return true;
    };
    // return { mediaType, base64: Buffer.from(decodeURIComponent(payload), "binary").toString("base64") };
    // DEFECT: decodeURIComponent + Node Buffer base64 — approximated by
    // uri_decode_bytes + sa_base64_encode placeholder externs.
    let decoded = ByteBuf { bytes: [0u8; 65536], len: 0 };
    ti_uri_decode_bytes(payload_ptr, payload_len, &decoded);
    // FIX(be2): sa_base64_encode was a placeholder extern; the real
    // encode face is sa_deno_btoa (handle) + sa_fmt_buffer_data/len.
    let cap_tiD: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_tiD, &decoded.bytes, 0);
    let bh = sa_deno_btoa(cap_tiD, decoded.len);
    out.base64_len = 0;
    if bh != 0 {
        let bp: ptr = PTR_NULL();
        bp = sa_fmt_buffer_data(bh);
        let bl = sa_fmt_buffer_len(bh);
        let bn = bl;
        if bn > 33554432 { bn = 33554432; };
        let bi: u64 = 0;
        while bi < bn {
            let bv: u8 = 0;
            PTR_BYTE_AT(bv, bp, bi);
            out.base64[bi] = bv;
            bi = bi + 1;
        }
        out.base64_len = bn;
        let frc = sa_fmt_buffer_free(bh);
    };
    return true;
}

fn ti_lower_byte(b: u8) -> u8 {
    if b >= 65 && b <= 90 { return b + 32; };
    return b;
}

fn ends_with_ci(p: ptr, len: u64, suffix_ptr: ptr, suffix_len: u64) -> bool {
    if len < suffix_len { return false; };
    let i: u64 = 0;
    while i < suffix_len {
        let a: u8 = PTR_BYTE_AT(p, len - suffix_len + i);
        let b: u8 = PTR_BYTE_AT(suffix_ptr, i);
        a = ti_lower_byte(a);
        b = ti_lower_byte(b);
        if a != b { return false; };
        i = i + 1;
    }
    return true;
}

// DEFECT: regex /^https?:\/\//i approximated by case-insensitive prefix checks.
fn isRemoteUrl(value_ptr: ptr, value_len: u64) -> bool {
    return starts_with_ci(value_ptr, value_len, STR_PTR("http://"), STR_LEN("http://")) || starts_with_ci(value_ptr, value_len, STR_PTR("https://"), STR_LEN("https://"));
}

fn starts_with_ci(p: ptr, len: u64, prefix_ptr: ptr, prefix_len: u64) -> bool {
    if len < prefix_len { return false; };
    let i: u64 = 0;
    while i < prefix_len {
        let a: u8 = PTR_BYTE_AT(p, i);
        let b: u8 = PTR_BYTE_AT(prefix_ptr, i);
        a = ti_lower_byte(a);
        b = ti_lower_byte(b);
        if a != b { return false; };
        i = i + 1;
    }
    return true;
}

// async function readImageFromDisk(path): Promise<ClaudeImageBlock>
// DEFECT: async — synchronous; returns 0 ok / 1 error (TS throws; error text in err).
fn readImageFromDisk(path_ptr: ptr, path_len: u64, out: &ClaudeImageBlock, err: &ByteBuf) -> i32 {
    // const bytes = await readFile(path);
    // FIX(be2): the 5-arg sa_std_fs_read_file was fictional; the real
    // face is the handle form sa_fs_read_file + read_buffer_data/len.
    let fh = sa_fs_read_file(path_ptr, path_len, 33554432);
    if fh == 0 {
        buf_append_lit(err, STR_PTR("could not read file"), STR_LEN("could not read file"));
        return 1;
    };
    let fdata: ptr = PTR_NULL();
    fdata = sa_fs_read_buffer_data(fh);
    let flen = sa_fs_read_buffer_len(fh);
    // if (bytes.byteLength > MAX_INLINE_IMAGE_BYTES) throw new Error(`image is ${Math.round(bytes.byteLength / 1024 / 1024)} MiB, above the inline limit`);
    if flen > MAX_INLINE_IMAGE_BYTES {
        buf_append_lit(err, STR_PTR("image is "), STR_LEN("image is "));
        ti_buf_append_u64(err, (flen + 524288) / 1048576); // Math.round(x / 1024 / 1024)
        buf_append_lit(err, STR_PTR(" MiB, above the inline limit"), STR_LEN(" MiB, above the inline limit"));
        let frc2 = sa_fs_read_buffer_free(fh);
        return 1;
    };
    // const base64 = bytes.toString("base64"); bound to sa_deno_btoa.
    out.source.source_kind = IMAGE_SOURCE_BASE64;
    let bh2 = sa_deno_btoa(fdata, flen);
    out.source.data_len = 0;
    if bh2 != 0 {
        let bp2: ptr = PTR_NULL();
        bp2 = sa_fmt_buffer_data(bh2);
        let bl2 = sa_fmt_buffer_len(bh2);
        let bn2 = bl2;
        if bn2 > 33554432 { bn2 = 33554432; };
        let bi2: u64 = 0;
        while bi2 < bn2 {
            let bv2: u8 = 0;
            PTR_BYTE_AT(bv2, bp2, bi2);
            out.source.data[bi2] = bv2;
            bi2 = bi2 + 1;
        }
        out.source.data_len = bn2;
        let frc3 = sa_fmt_buffer_free(bh2);
    };
    let frc4 = sa_fs_read_buffer_free(fh);
    // media_type: normalizeImageMediaType(imageMediaTypeForPath(path), base64)
    let declared = ByteBuf { bytes: [0u8; 65536], len: 0 };
    let has_declared: bool = imageMediaTypeForPath(path_ptr, path_len, &declared);
    let mt = ByteBuf { bytes: [0u8; 65536], len: 0 };
    let cap_ti27859: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ti27859, &declared.bytes, 0);
    let cap_ti27861: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ti27861, &out.source.data, 0);
    normalizeImageMediaType(has_declared, cap_ti27859, declared.len, cap_ti27861, out.source.data_len, &mt);
    out.source.media_type_len = mt.len;
    buf_copy_to(&mt, &out.source.media_type);
    out.source.url_len = 0;
    return 0;
}

// Splice an `@"path"` ref into the prompt.
fn withPathRef(text_ptr: ptr, text_len: u64, path_ptr: ptr, path_len: u64, out: &ByteBuf) -> void {
    // const quoted = `@"${path}"`;
    let quoted = ByteBuf { bytes: [0u8; 65536], len: 0 };
    buf_append_lit(&quoted, STR_PTR("@\""), STR_LEN("@\""));
    buf_append_bytes(&quoted, path_ptr, path_len);
    buf_append_lit(&quoted, STR_PTR("\""), STR_LEN("\""));
    // if (text.includes(quoted)) return text;
    let cap_p124: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p124, &quoted.bytes, 0);
    if buf_index_of(text_ptr, text_len, cap_p124, quoted.len) >= 0 { buf_append_bytes(out, text_ptr, text_len); return; };
    // const index = text.indexOf(path); if (index >= 0) return slice(0, index) + quoted + slice(index + path.length);
    let idx: i64 = buf_index_of(text_ptr, text_len, path_ptr, path_len);
    if idx >= 0 {
        buf_append_bytes(out, text_ptr, idx);
        let cap_p125: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p125, &quoted.bytes, 0);
        buf_append_bytes(out, cap_p125, quoted.len);
        buf_append_bytes(out, PTR_ADD(text_ptr, idx + path_len), text_len - idx - path_len);
        return;
    };
    // return text ? `${text}\n${quoted}` : quoted;
    if text_len > 0 {
        buf_append_bytes(out, text_ptr, text_len);
        buf_append_lit(out, STR_PTR("\n"), STR_LEN("\n"));
    };
    let cap_p126: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p126, &quoted.bytes, 0);
    buf_append_bytes(out, cap_p126, quoted.len);
    return;
}

fn buf_index_of(hay: ptr, hay_len: u64, needle: ptr, needle_len: u64) -> i64 {
    if needle_len > hay_len { return -1; };
    let i: u64 = 0;
    while i + needle_len <= hay_len {
        let eq: bool = true;
        let j: u64 = 0;
        while j < needle_len { if PTR_BYTE_AT(hay, i + j) != PTR_BYTE_AT(needle, j) { eq = false; }; j = j + 1; }
        if eq { return i; };
        i = i + 1;
    }
    return -1;
}

// Build the Claude-facing prompt from workbench turn params.
// `params.input` accepts the composer block list, a plain string, or the
// legacy `params.prompt` string. params is a Record<string, JsonValue> as JSON text.
// DEFECT: async — converted to a synchronous function (awaits on readFile become
// blocking reads); signature marked per brief.
// FIX(be2): the sa_json_input_* accessors were placeholder externs.
// Bound here over the real json.sai navigation faces; `doc` is the
// turn params object and all three probe its "input" field.
fn ti_input_node(doc: u64, out: &u64) -> bool {
    let h: u64 = 0;
    if sa_json_object_get(doc, STR_PTR("input"), STR_LEN("input"), &h) != 0 { return false; };
    *out = h;
    return true;
}

fn ti_input_is_string(doc: u64) -> bool {
    let h: u64 = 0;
    if !ti_input_node(doc, &h) { return false; };
    return sa_json_kind(h) == 5;
}

fn ti_input_array_count(doc: u64, has: &bool) -> u64 {
    *has = false;
    let h: u64 = 0;
    if !ti_input_node(doc, &h) { return 0; };
    if sa_json_kind(h) != 6 { return 0; };
    let cnt: u64 = 0;
    if sa_json_value_count(h, &cnt) != 0 { return 0; };
    *has = true;
    return cnt;
}

fn ti_input_entry_json(doc: u64, idx: u64, out: &ByteBuf) -> void {
    out.len = 0;
    let h: u64 = 0;
    if !ti_input_node(doc, &h) { return; };
    let entry: u64 = 0;
    if sa_json_array_get(h, idx, &entry) != 0 { return; };
    let sh: u64 = 0;
    if sa_json_stringify(entry, &sh) != 0 { return; };
    let sp: ptr = PTR_NULL();
    sp = sa_json_string_ptr(sh);
    let sl = sa_json_string_len(sh);
    let n = sl;
    if n > 65536 { n = 65536; };
    let i: u64 = 0;
    while i < n {
        let v: u8 = 0;
        PTR_BYTE_AT(v, sp, i);
        out.bytes[i] = v;
        i = i + 1;
    }
    out.len = n;
    return;
}

// FIX(be2): host_pathOnlyHistoryPlaceholder / host_toPathOnlyImageBlock
// were placeholder externs for the sdk-backend helpers
// pathOnlyHistoryPlaceholder / toPathOnlyImageBlock
// (sdk-backend/src/imagePersistence.ts:65 / :54). Both are pure
// string builders, so they are implemented here for real; the JSON
// text form matches this unit's attachmentBlocks model (entries are
// JSON text), with string values JSON-escaped.
fn ti_path_only_placeholder(name_ptr: ptr, name_len: u64, reason_ptr: ptr, reason_len: u64, out: &ByteBuf) -> void {
    out.len = 0;
    buf_append_lit(out, STR_PTR("{\"type\":\"text\",\"text\":\"[Attached image \\\""), STR_LEN("{\"type\":\"text\",\"text\":\"[Attached image \\\""));
    json_escape_into(out, name_ptr, name_len);
    buf_append_lit(out, STR_PTR("\\\" was omitted: "), STR_LEN("\\\" was omitted: "));
    json_escape_into(out, reason_ptr, reason_len);
    buf_append_lit(out, STR_PTR("]\",\"text_elements\":[]}"), STR_LEN("]\",\"text_elements\":[]}"));
    return;
}

fn ti_to_path_only_image_block(path_ptr: ptr, path_len: u64, name_ptr: ptr, name_len: u64, out: &ByteBuf) -> void {
    let tp = ByteBuf { bytes: [0u8; 65536], len: 0 };
    buf_append_bytes(&tp, path_ptr, path_len);
    buf_trim_in_place(&tp);
    let tn = ByteBuf { bytes: [0u8; 65536], len: 0 };
    buf_append_bytes(&tn, name_ptr, name_len);
    buf_trim_in_place(&tn);
    out.len = 0;
    buf_append_lit(out, STR_PTR("{\"type\":\"localImage\",\"path\":\""), STR_LEN("{\"type\":\"localImage\",\"path\":\""));
    let cap_tiP: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_tiP, &tp.bytes, 0);
    json_escape_into(out, cap_tiP, tp.len);
    buf_append_lit(out, STR_PTR("\""), STR_LEN("\""));
    if tn.len > 0 {
        buf_append_lit(out, STR_PTR(",\"name\":\""), STR_LEN(",\"name\":\""));
        let cap_tiN: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_tiN, &tn.bytes, 0);
        json_escape_into(out, cap_tiN, tn.len);
        buf_append_lit(out, STR_PTR("\""), STR_LEN("\""));
    };
    buf_append_lit(out, STR_PTR("}"), STR_LEN("}"));
    return;
}

fn extractTurnInput(params_json_ptr: ptr, params_json_len: u64, out: &ClaudeTurnInput) -> void {
    out.text_len = 0;
    out.displayText_len = 0;
    out.images_count = 0;
    out.attachmentBlocks = StrList { items: [0u8; 16384], items_len: 0, lens: [0u64; 64], count: 0 };
    out.warnings = StrList { items: [0u8; 16384], items_len: 0, lens: [0u64; 64], count: 0 };
    let doc = sa_json_parse(params_json_ptr, params_json_len);
    if doc == 0 { return; };
    // const input = params.input;
    // if (typeof input === "string") return { text: input, displayText: input, images: [], attachmentBlocks: [], warnings: [] };
    let input_str = ByteBuf { bytes: [0u8; 65536], len: 0 };
    if ti_input_is_string(doc) {
        let jgs_p23: ptr = PTR_NULL(); PTR_BYTE_ADD(jgs_p23, &input_str.bytes, 0);
        input_str.len = json_get_string_copy(doc, STR_PTR("input"), STR_LEN("input"), jgs_p23, 1048576);
        out.text_len = input_str.len;
        buf_copy_to(&input_str, &out.text);
        out.displayText_len = input_str.len;
        buf_copy_to(&input_str, &out.displayText);
        sa_json_free(doc);
        return;
    };
    // if (!Array.isArray(input)) { const prompt = typeof params.prompt === "string" ? params.prompt : ""; return {...}; }
    let has_input_array: bool = false;
    let input_count: u64 = ti_input_array_count(doc, &has_input_array);
    if !(has_input_array) {
        let prompt = ByteBuf { bytes: [0u8; 65536], len: 0 };
        if json_has(doc, STR_PTR("prompt"), STR_LEN("prompt")) {
            let jgs_p24: ptr = PTR_NULL(); PTR_BYTE_ADD(jgs_p24, &prompt.bytes, 0);
            prompt.len = json_get_string_copy(doc, STR_PTR("prompt"), STR_LEN("prompt"), jgs_p24, 1048576);
        };
        out.text_len = prompt.len;
        buf_copy_to(&prompt, &out.text);
        out.displayText_len = prompt.len;
        buf_copy_to(&prompt, &out.displayText);
        sa_json_free(doc);
        return;
    };
    // const textParts/images/attachmentBlocks/pathRefs/warnings = [];
    let textParts = StrList { items: [0u8; 16384], items_len: 0, lens: [0u64; 64], count: 0 };
    let pathRefs = StrList { items: [0u8; 16384], items_len: 0, lens: [0u64; 64], count: 0 };
    let idx: u64 = 0;
    while idx < input_count {
        // const block = blockRecord(entry); const type = typeof block.type === "string" ? block.type : "";
        let type_buf: [u8; 64] = [0u8; 64];
        let type_buf_p: ptr = PTR_NULL(); PTR_BYTE_ADD(type_buf_p, &type_buf, 0);
        let type_len: u64 = 0;
        if json_input_entry_has_string(doc, idx, STR_PTR("type"), STR_LEN("type")) {
            type_len = json_input_entry_string(doc, idx, STR_PTR("type"), STR_LEN("type"), type_buf_p, 64);
        };
        // text blocks
        if bytes_eq_buf(type_buf_p, type_len, STR_PTR("text"), STR_LEN("text")) || bytes_eq_buf(type_buf_p, type_len, STR_PTR("input_text"), STR_LEN("input_text")) || bytes_eq_buf(type_buf_p, type_len, STR_PTR("inputText"), STR_LEN("inputText")) {
            // if (typeof block.text === "string" && block.text) textParts.push(block.text);
            let t = ByteBuf { bytes: [0u8; 65536], len: 0 };
            let cap_p127: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p127, &t.bytes, 0);
            t.len = json_input_entry_string(doc, idx, STR_PTR("text"), STR_LEN("text"), cap_p127, 262144);
            if json_input_entry_has_string(doc, idx, STR_PTR("text"), STR_LEN("text")) && t.len > 0 {
                strlist_push_buf(&textParts, &t.bytes, t.len);
            };
            idx = idx + 1;
            continue;
        };
        // mention / skill / file / document -> path refs
        if bytes_eq_buf(type_buf_p, type_len, STR_PTR("mention"), STR_LEN("mention")) || bytes_eq_buf(type_buf_p, type_len, STR_PTR("skill"), STR_LEN("skill")) || bytes_eq_buf(type_buf_p, type_len, STR_PTR("file"), STR_LEN("file")) || bytes_eq_buf(type_buf_p, type_len, STR_PTR("document"), STR_LEN("document")) {
            // const path = stringField(block, ["path"]); if (path) { pathRefs.push(path); attachmentBlocks.push(entry); }
            let p = ByteBuf { bytes: [0u8; 65536], len: 0 };
            if turn_entry_string_field(doc, idx, STR_PTR("path"), STR_LEN("path"), &p) {
                strlist_push_buf(&pathRefs, &p.bytes, p.len);
                let entry_json = ByteBuf { bytes: [0u8; 65536], len: 0 };
                ti_input_entry_json(doc, idx, &entry_json);
                strlist_push_buf(&out.attachmentBlocks, &entry_json.bytes, entry_json.len);
            };
            idx = idx + 1;
            continue;
        };
        // if (type !== "image" && !== "input_image" && !== "inputImage" && !== "localImage") continue;
        let is_image: bool = bytes_eq_buf(type_buf_p, type_len, STR_PTR("image"), STR_LEN("image")) || bytes_eq_buf(type_buf_p, type_len, STR_PTR("input_image"), STR_LEN("input_image")) || bytes_eq_buf(type_buf_p, type_len, STR_PTR("inputImage"), STR_LEN("inputImage")) || bytes_eq_buf(type_buf_p, type_len, STR_PTR("localImage"), STR_LEN("localImage"));
        if !(is_image) { idx = idx + 1; continue; };
        // const source = stringField(block, ["url", "image_url", "imageUrl", "path"]); if (!source) continue;
        let source = ByteBuf { bytes: [0u8; 65536], len: 0 };
        let has_source: bool = turn_entry_string_field(doc, idx, STR_PTR("url"), STR_LEN("url"), &source);
        if !(has_source) { source.len = 0; has_source = turn_entry_string_field(doc, idx, STR_PTR("image_url"), STR_LEN("image_url"), &source); };
        if !(has_source) { source.len = 0; has_source = turn_entry_string_field(doc, idx, STR_PTR("imageUrl"), STR_LEN("imageUrl"), &source); };
        if !(has_source) { source.len = 0; has_source = turn_entry_string_field(doc, idx, STR_PTR("path"), STR_LEN("path"), &source); };
        if !(has_source) { idx = idx + 1; continue; };
        // const label = stringField(block, ["name"]) ?? (source.startsWith("data:") ? "image" : source);
        let label = ByteBuf { bytes: [0u8; 65536], len: 0 };
        if !(turn_entry_string_field(doc, idx, STR_PTR("name"), STR_LEN("name"), &label)) {
            label.len = 0;
            let cap_p128: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p128, &source.bytes, 0);
            let cap_ti27927: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ti27927, &source.bytes, 0);
            if starts_with( cap_ti27927, source.len, STR_PTR("data:"), STR_LEN("data:")) { buf_append_lit(&label, STR_PTR("image"), STR_LEN("image")); } else { buf_append_bytes(&label, cap_p128, source.len); };
        };
        // const dataUrl = parseDataUrl(source);
        let parsed = ParsedDataUrl { has_mediaType: false, mediaType: [0u8; 128], mediaType_len: 0, base64: [0u8; 33554432], base64_len: 0 };
        let cap_ti27928: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ti27928, &source.bytes, 0);
        if parseDataUrl( cap_ti27928, source.len, &parsed) {
            if parsed.base64_len == 0 {
                // warnings.push(`Dropped empty image attachment ${label}`); attachmentBlocks.push(pathOnlyHistoryPlaceholder(label, "empty image data"))
                let w = ByteBuf { bytes: [0u8; 65536], len: 0 };
                buf_append_lit(&w, STR_PTR("Dropped empty image attachment "), STR_LEN("Dropped empty image attachment "));
                let cap_p129: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p129, &label.bytes, 0);
                buf_append_bytes(&w, cap_p129, label.len);
                strlist_push_buf(&out.warnings, &w.bytes, w.len);
                let ph = ByteBuf { bytes: [0u8; 65536], len: 0 };
                ti_path_only_placeholder(cap_p129, label.len, STR_PTR("empty image data"), STR_LEN("empty image data"), &ph);
                strlist_push_buf(&out.attachmentBlocks, &ph.bytes, ph.len);
                idx = idx + 1;
                continue;
            };
            // images.push({ type: "image", source: { type: "base64", media_type: normalizeImageMediaType(dataUrl.mediaType, dataUrl.base64), data: dataUrl.base64 } });
            if out.images_count < 64 {
                let blk = &out.images[out.images_count];
                blk.source.source_kind = IMAGE_SOURCE_BASE64;
                let mt = ByteBuf { bytes: [0u8; 65536], len: 0 };
                let cap_ti27860: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ti27860, &parsed.mediaType, 0);
                let cap_ti27862: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ti27862, &parsed.base64, 0);
                normalizeImageMediaType(parsed.has_mediaType, cap_ti27860, parsed.mediaType_len, cap_ti27862, parsed.base64_len, &mt);
                blk.source.media_type_len = mt.len;
                buf_copy_to(&mt, &blk.source.media_type);
                blk.source.data_len = parsed.base64_len;
                let cap_tiB: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_tiB, &parsed.base64, 0);
                buf_copy_ptr_to(cap_tiB, parsed.base64_len, &blk.source.data);
                blk.source.url_len = 0;
                out.images_count = out.images_count + 1;
            };
            let ph2 = ByteBuf { bytes: [0u8; 65536], len: 0 };
            let cap_tiL2: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_tiL2, &label.bytes, 0);
            ti_path_only_placeholder(cap_tiL2, label.len, STR_PTR("inline image data is never persisted; save it into the workspace first"), STR_LEN("inline image data is never persisted; save it into the workspace first"), &ph2);
            strlist_push_buf(&out.attachmentBlocks, &ph2.bytes, ph2.len);
            idx = idx + 1;
            continue;
        };
        // if (isRemoteUrl(source)) { images.push({ type: "image", source: { type: "url", url: source } }); attachmentBlocks.push(entry); continue; }
        let cap_ti28023: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ti28023, &source.bytes, 0);
        if isRemoteUrl( cap_ti28023, source.len) {
            if out.images_count < 64 {
                let blk2 = &out.images[out.images_count];
                blk2.source.source_kind = IMAGE_SOURCE_URL;
                blk2.source.url_len = source.len;
                buf_copy_to(&source, &blk2.source.url);
                blk2.source.media_type_len = 0;
                blk2.source.data_len = 0;
                out.images_count = out.images_count + 1;
            };
            let entry_json2 = ByteBuf { bytes: [0u8; 65536], len: 0 };
            ti_input_entry_json(doc, idx, &entry_json2);
            strlist_push_buf(&out.attachmentBlocks, &entry_json2.bytes, entry_json2.len);
            idx = idx + 1;
            continue;
        };
        // try { images.push(await readImageFromDisk(source)); attachmentBlocks.push(toPathOnlyImageBlock({ path: source, name: label })); }
        // catch (error) { warnings.push(`Could not inline image ${label}: ${message}`); pathRefs.push(source); attachmentBlocks.push(entry); }
        let disk_block = ClaudeImageBlock { source: ClaudeImageSource { source_kind: 0, media_type: [0u8; 64], media_type_len: 0, data: [0u8; 33554432], data_len: 0, url: [0u8; 8192], url_len: 0 } };
        let disk_err = ByteBuf { bytes: [0u8; 65536], len: 0 };
        let cap_ti28024: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ti28024, &source.bytes, 0);
        if readImageFromDisk( cap_ti28024, source.len, &disk_block, &disk_err) == 0 {
            if out.images_count < 64 {
                out.images[out.images_count] = disk_block;
                out.images_count = out.images_count + 1;
            };
            let pob = ByteBuf { bytes: [0u8; 65536], len: 0 };
            let cap_tiS: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_tiS, &source.bytes, 0);
            let cap_tiL: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_tiL, &label.bytes, 0);
            ti_to_path_only_image_block(cap_tiS, source.len, cap_tiL, label.len, &pob);
            strlist_push_buf(&out.attachmentBlocks, &pob.bytes, pob.len);
        } else {
            let w2 = ByteBuf { bytes: [0u8; 65536], len: 0 };
            buf_append_lit(&w2, STR_PTR("Could not inline image "), STR_LEN("Could not inline image "));
            let cap_p130: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p130, &label.bytes, 0);
            buf_append_bytes(&w2, cap_p130, label.len);
            buf_append_lit(&w2, STR_PTR(": "), STR_LEN(": "));
            let cap_p131: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p131, &disk_err.bytes, 0);
            buf_append_bytes(&w2, cap_p131, disk_err.len);
            strlist_push_buf(&out.warnings, &w2.bytes, w2.len);
            strlist_push_buf(&pathRefs, &source.bytes, source.len);
            let entry_json3 = ByteBuf { bytes: [0u8; 65536], len: 0 };
            ti_input_entry_json(doc, idx, &entry_json3);
            strlist_push_buf(&out.attachmentBlocks, &entry_json3.bytes, entry_json3.len);
        };
        idx = idx + 1;
    }
    // const displayText = textParts.join("\n");
    let displayText = ByteBuf { bytes: [0u8; 65536], len: 0 };
    strlist_join(&textParts, STR_PTR("\n"), STR_LEN("\n"), &displayText);
    out.displayText_len = displayText.len;
    buf_copy_to(&displayText, &out.displayText);
    // let text = displayText; for (const path of pathRefs) text = withPathRef(text, path);
    let text = ByteBuf { bytes: [0u8; 65536], len: 0 };
    let cap_p132: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p132, &displayText.bytes, 0);
    buf_append_bytes(&text, cap_p132, displayText.len);
    let poff: u64 = 0;
    let pi: u64 = 0;
    while pi < pathRefs.count {
        let next = ByteBuf { bytes: [0u8; 65536], len: 0 };
        let cap_ti28025: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ti28025, &text.bytes, 0);
        withPathRef( cap_ti28025, text.len, PTR_ADD(pathRefs.items, poff), pathRefs.lens[pi], &next);
        text.len = 0;
        let cap_p133: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p133, &next.bytes, 0);
        buf_append_bytes(&text, cap_p133, next.len);
        poff = poff + pathRefs.lens[pi];
        pi = pi + 1;
    }
    out.text_len = text.len;
    buf_copy_to(&text, &out.text);
    sa_json_free(doc);
    return;
}

// Build the `message.content` payload for a stream-json user message.
// Output is the JsonValue as JSON text: a JSON string when no images, else an
// array of image blocks with the text block last.
fn buildClaudeUserContent(text_ptr: ptr, text_len: u64, images: &[ClaudeImageBlock], images_count: u64, out: &ByteBuf) -> void {
    // if (images.length === 0) return text;
    if images_count == 0 {
        buf_append_lit(out, STR_PTR("\""), STR_LEN("\""));
        json_escape_into(out, text_ptr, text_len);
        buf_append_lit(out, STR_PTR("\""), STR_LEN("\""));
        return;
    };
    // const blocks: ClaudeContentBlockParam[] = [...images]; if (text) blocks.push({ type: "text", text }); return blocks;
    buf_append_lit(out, STR_PTR("["), STR_LEN("["));
    let i: u64 = 0;
    while i < images_count {
        if i > 0 { buf_append_lit(out, STR_PTR(","), STR_LEN(",")); };
        let blk = &images[i];
        buf_append_lit(out, STR_PTR("{\"type\":\"image\",\"source\":"), STR_LEN("{\"type\":\"image\",\"source\":"));
        if blk.source.source_kind == IMAGE_SOURCE_URL {
            buf_append_lit(out, STR_PTR("{\"type\":\"url\",\"url\":\""), STR_LEN("{\"type\":\"url\",\"url\":\""));
            let cap_ti28026: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ti28026, &blk.source.url, 0);
            json_escape_into(out, cap_ti28026, blk.source.url_len);
            buf_append_lit(out, STR_PTR("\"}"), STR_LEN("\"}"));
        } else {
            buf_append_lit(out, STR_PTR("{\"type\":\"base64\",\"media_type\":\""), STR_LEN("{\"type\":\"base64\",\"media_type\":\""));
            let cap_ti28027: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ti28027, &blk.source.media_type, 0);
            buf_append_bytes(out, cap_ti28027, blk.source.media_type_len);
            buf_append_lit(out, STR_PTR("\",\"data\":\""), STR_LEN("\",\"data\":\""));
            let cap_p1: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p1, &blk.source.data, 0);
            buf_append_bytes(out, cap_p1, blk.source.data_len);
            buf_append_lit(out, STR_PTR("\"}"), STR_LEN("\"}"));
        };
        buf_append_lit(out, STR_PTR("}"), STR_LEN("}"));
        i = i + 1;
    }
    if text_len > 0 {
        buf_append_lit(out, STR_PTR(",{\"type\":\"text\",\"text\":\""), STR_LEN(",{\"type\":\"text\",\"text\":\""));
        json_escape_into(out, text_ptr, text_len);
        buf_append_lit(out, STR_PTR("\"}"), STR_LEN("\"}"));
    };
    buf_append_lit(out, STR_PTR("]"), STR_LEN("]"));
    return;
}
