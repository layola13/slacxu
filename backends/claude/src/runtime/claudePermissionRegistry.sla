// Converted 1:1 from backends/claude/src/runtime/claudePermissionRegistry.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "sa_std/string.sa"
@import "sa_std/ptr.sa"

// Tracks pending permission requests from Claude-compatible runtimes.
// Each request is bound to its owning thread, turn, and runtime instance,
// so responses are never routed to the wrong bridge.
//
// This registry is separate from the SSH server request map to prevent
// a Claude permission response from being sent to a Codex app-server bridge.

// DEFECT: Map<string, PendingClaudePermission> + Map<string, string> — SLA has no
// hash map; approximated by fixed-capacity entry arrays (capacity 256) with
// linear lookup. Timer handles (ReturnType<typeof setTimeout>) replaced by an
// absolute deadline (expires_at_ms) realized by ClaudePermissionRegistry_checkTimeouts,
// which the owner must pump — TS fires handleTimeout autonomously.
struct PendingClaudePermission {
    serverRequestId: [u8; 256], // "claude-perm-..." server-facing request ID
    serverRequestId_len: u64,
    claudeRequestId: [u8; 128], // Claude CLI's internal request_id
    claudeRequestId_len: u64,
    threadId: [u8; 128],
    threadId_len: u64,
    ownerId: [u8; 128],
    ownerId_len: u64,
    turnId: [u8; 128],
    turnId_len: u64,
    runtimeId: [u8; 256],
    runtimeId_len: u64,
    createdAt: u64, // Date.now() ms
    timeoutMs: u64,
    has_timer: bool, // TS timer: Timeout | null
    expires_at_ms: u64, // deadline standing in for the timer
    occupied: bool, // slot in use (array storage bookkeeping)
}

// DEFECT: union type PermissionResponse = { allowed: true } | { allowed: false; denyReason?: string }
// approximated as one struct with a discriminant flag.
struct PermissionResponse {
    allowed: bool,
    has_denyReason: bool,
    denyReason: [u8; 2048],
    denyReason_len: u64,
}

const DEFAULT_PERMISSION_TIMEOUT_MS: u64 = 300000; // 5 * 60 * 1000

struct ClaudePermissionRegistry {
    pending: [PendingClaudePermission; 256], // stands in for both Maps (byClaudeRequestId resolved by scan)
    pending_count: u64,
    // onTimeout: ((entry) => void) | null — callback approximated by a target id;
    // timed-out entries are copied to last_timeout for the owner to consume.
    has_onTimeout: bool,
    onTimeout_target: u64,
    has_last_timeout: bool,
    last_timeout: PendingClaudePermission,
}

fn registry_find(reg: &ClaudePermissionRegistry, serverRequestId_ptr: ptr, serverRequestId_len: u64) -> i64 {
    let i: u64 = 0;
    while i < reg.pending_count {
        if reg.pending[i].occupied && reg.pending[i].serverRequestId_len == serverRequestId_len && bytes_eq_range(&reg.pending[i].serverRequestId, serverRequestId_ptr, serverRequestId_len) {
            return i;
        };
        i = i + 1;
    }
    return -1;
}

fn bytes_eq_range(a: &[u8], b_ptr: ptr, b_len: u64) -> bool {
    let i: u64 = 0;
    while i < b_len { if a[i] != PTR_BYTE_AT(b_ptr, i) { return false; }; i = i + 1; };
    return true;
}

fn registry_remove_at(reg: &ClaudePermissionRegistry, idx: u64) -> void {
    // swap-remove; TS Map preserves insertion order — DEFECT: order not preserved.
    let last: u64 = reg.pending_count - 1;
    if idx != last { reg.pending[idx] = reg.pending[last]; };
    reg.pending[last].occupied = false;
    reg.pending_count = last;
    return;
}

// Register a new pending permission request.
// Returns the server-facing request ID (written to out_serverRequestId, length returned).
fn ClaudePermissionRegistry_register(reg: &ClaudePermissionRegistry, claudeRequestId_ptr: ptr, claudeRequestId_len: u64, threadId_ptr: ptr, threadId_len: u64, ownerId_ptr: ptr, ownerId_len: u64, turnId_ptr: ptr, turnId_len: u64, runtimeId_ptr: ptr, runtimeId_len: u64, has_timeoutMs: bool, timeoutMs_in: u64, out_serverRequestId: &ByteBuf) -> u64 {
    // const serverRequestId = "claude-perm-" + input.claudeRequestId;
    buf_append_lit(out_serverRequestId, STR_PTR("claude-perm-"), STR_LEN("claude-perm-"));
    buf_append_bytes(out_serverRequestId, claudeRequestId_ptr, claudeRequestId_len);
    // const timeoutMs = input.timeoutMs ?? DEFAULT_PERMISSION_TIMEOUT_MS;
    let timeoutMs: u64 = DEFAULT_PERMISSION_TIMEOUT_MS;
    if has_timeoutMs { timeoutMs = timeoutMs_in; };
    // Clean up any existing entry with the same serverRequestId: this.cancel(serverRequestId);
    ClaudePermissionRegistry_cancel(reg, &out_serverRequestId.bytes, out_serverRequestId.len);
    // const entry: PendingClaudePermission = {..., createdAt: Date.now(), timeoutMs, timer: null};
    if reg.pending_count >= 256 { return out_serverRequestId.len; };
    let idx: u64 = reg.pending_count;
    let e = &reg.pending[idx];
    e.occupied = true;
    e.serverRequestId_len = out_serverRequestId.len;
    buf_copy_ptr_to(&out_serverRequestId.bytes, out_serverRequestId.len, &e.serverRequestId);
    e.claudeRequestId_len = claudeRequestId_len;
    buf_copy_ptr_to(claudeRequestId_ptr, claudeRequestId_len, &e.claudeRequestId);
    e.threadId_len = threadId_len;
    buf_copy_ptr_to(threadId_ptr, threadId_len, &e.threadId);
    e.ownerId_len = ownerId_len;
    buf_copy_ptr_to(ownerId_ptr, ownerId_len, &e.ownerId);
    e.turnId_len = turnId_len;
    buf_copy_ptr_to(turnId_ptr, turnId_len, &e.turnId);
    e.runtimeId_len = runtimeId_len;
    buf_copy_ptr_to(runtimeId_ptr, runtimeId_len, &e.runtimeId);
    e.createdAt = sa_time_now_ms();
    e.timeoutMs = timeoutMs;
    // entry.timer = setTimeout(() => { this.handleTimeout(serverRequestId); }, timeoutMs); entry.timer.unref();
    e.has_timer = true;
    e.expires_at_ms = e.createdAt + timeoutMs;
    reg.pending_count = reg.pending_count + 1;
    // this.pending.set(...); this.byClaudeRequestId.set(input.claudeRequestId, serverRequestId);
    return out_serverRequestId.len;
}

// Look up a pending permission by its server-facing request ID.
// Returns true and fills out when found (TS returns entry | undefined).
fn ClaudePermissionRegistry_get(reg: &ClaudePermissionRegistry, serverRequestId_ptr: ptr, serverRequestId_len: u64, out: &PendingClaudePermission) -> bool {
    let idx = registry_find(reg, serverRequestId_ptr, serverRequestId_len);
    if idx < 0 { return false; };
    out = reg.pending[idx];
    return true;
}

// Look up a pending permission by the Claude CLI's request_id.
fn ClaudePermissionRegistry_getByClaudeRequestId(reg: &ClaudePermissionRegistry, claudeRequestId_ptr: ptr, claudeRequestId_len: u64, out: &PendingClaudePermission) -> bool {
    // const serverRequestId = this.byClaudeRequestId.get(claudeRequestId); if (!serverRequestId) return undefined; return this.pending.get(serverRequestId);
    let i: u64 = 0;
    while i < reg.pending_count {
        if reg.pending[i].occupied && reg.pending[i].claudeRequestId_len == claudeRequestId_len && bytes_eq_range(&reg.pending[i].claudeRequestId, claudeRequestId_ptr, claudeRequestId_len) {
            out = reg.pending[i];
            return true;
        };
        i = i + 1;
    }
    return false;
}

// Consume a permission request (remove it from the registry).
// Returns true and fills out if found (TS returns entry | undefined).
fn ClaudePermissionRegistry_consume(reg: &ClaudePermissionRegistry, serverRequestId_ptr: ptr, serverRequestId_len: u64, out: &PendingClaudePermission) -> bool {
    let idx = registry_find(reg, serverRequestId_ptr, serverRequestId_len);
    if idx < 0 { return false; };
    out = reg.pending[idx];
    // if (entry.timer) clearTimeout(entry.timer); — deadline discarded with the entry.
    registry_remove_at(reg, idx);
    return true;
}

// Cancel a pending permission request. Does NOT trigger the timeout callback.
fn ClaudePermissionRegistry_cancel(reg: &ClaudePermissionRegistry, serverRequestId_ptr: ptr, serverRequestId_len: u64) -> void {
    let idx = registry_find(reg, serverRequestId_ptr, serverRequestId_len);
    if idx < 0 { return; };
    registry_remove_at(reg, idx);
    return;
}

// Cancel all pending permissions for a given runtime.
// Returns the cancelled serverRequestIds (TS string[]) into out list.
fn ClaudePermissionRegistry_cancelAllForRuntime(reg: &ClaudePermissionRegistry, runtimeId_ptr: ptr, runtimeId_len: u64, out: &StrList) -> void {
    // for (const [serverRequestId, entry] of this.pending) { if (entry.runtimeId === runtimeId) { clearTimeout; delete both maps; cancelled.push(serverRequestId); } }
    let i: u64 = 0;
    while i < reg.pending_count {
        if reg.pending[i].occupied && reg.pending[i].runtimeId_len == runtimeId_len && bytes_eq_range(&reg.pending[i].runtimeId, runtimeId_ptr, runtimeId_len) {
            strlist_push_buf(out, &reg.pending[i].serverRequestId, reg.pending[i].serverRequestId_len);
            registry_remove_at(reg, i);
        } else {
            i = i + 1;
        };
    }
    return;
}

// Cancel all pending permissions for a given thread.
fn ClaudePermissionRegistry_cancelAllForThread(reg: &ClaudePermissionRegistry, threadId_ptr: ptr, threadId_len: u64, out: &StrList) -> void {
    let i: u64 = 0;
    while i < reg.pending_count {
        if reg.pending[i].occupied && reg.pending[i].threadId_len == threadId_len && bytes_eq_range(&reg.pending[i].threadId, threadId_ptr, threadId_len) {
            strlist_push_buf(out, &reg.pending[i].serverRequestId, reg.pending[i].serverRequestId_len);
            registry_remove_at(reg, i);
        } else {
            i = i + 1;
        };
    }
    return;
}

// get size(): number
fn ClaudePermissionRegistry_size(reg: &ClaudePermissionRegistry) -> u64 {
    return reg.pending_count;
}

// List all pending permissions (for diagnostics).
// DEFECT: TS returns PendingClaudePermission[]; SLA copies up to out_cap entries, returns count.
fn ClaudePermissionRegistry_list(reg: &ClaudePermissionRegistry, out: &[PendingClaudePermission], out_cap: u64) -> u64 {
    let n: u64 = reg.pending_count;
    if n > out_cap { n = out_cap; };
    let i: u64 = 0;
    while i < n { out[i] = reg.pending[i]; i = i + 1; };
    return n;
}

// Check if there are pending permissions for a given thread.
fn ClaudePermissionRegistry_hasPendingForThread(reg: &ClaudePermissionRegistry, threadId_ptr: ptr, threadId_len: u64) -> bool {
    let i: u64 = 0;
    while i < reg.pending_count {
        if reg.pending[i].occupied && reg.pending[i].threadId_len == threadId_len && bytes_eq_range(&reg.pending[i].threadId, threadId_ptr, threadId_len) { return true; };
        i = i + 1;
    }
    return false;
}

// private handleTimeout(serverRequestId) — realized by checkTimeouts below.
// DEFECT: setTimeout callback + optional onTimeout class field (function value)
// — approximated: expired entries are removed and the most recent one is stored
// in reg.last_timeout with has_onTimeout gating, for the owner to consume.
fn ClaudePermissionRegistry_handleTimeout(reg: &ClaudePermissionRegistry, serverRequestId_ptr: ptr, serverRequestId_len: u64) -> void {
    let idx = registry_find(reg, serverRequestId_ptr, serverRequestId_len);
    if idx < 0 { return; };
    let entry = reg.pending[idx];
    registry_remove_at(reg, idx);
    // this.onTimeout?.(entry);
    if reg.has_onTimeout {
        reg.last_timeout = entry;
        reg.has_last_timeout = true;
    };
    return;
}

// Pump for expired timers (stands in for setTimeout firing).
fn ClaudePermissionRegistry_checkTimeouts(reg: &ClaudePermissionRegistry) -> void {
    let now: u64 = sa_time_now_ms();
    let i: u64 = 0;
    while i < reg.pending_count {
        if reg.pending[i].occupied && reg.pending[i].has_timer && now >= reg.pending[i].expires_at_ms {
            let id_copy: [u8; 256] = reg.pending[i].serverRequestId;
            let id_len: u64 = reg.pending[i].serverRequestId_len;
            ClaudePermissionRegistry_handleTimeout(reg, &id_copy, id_len);
            i = 0; // restart scan after removal (approximation)
        } else {
            i = i + 1;
        };
    }
    return;
}

// onTimeout setter (TS public field assignment).
fn ClaudePermissionRegistry_setOnTimeout(reg: &ClaudePermissionRegistry, has_callback: bool, target: u64) -> void {
    reg.has_onTimeout = has_callback;
    reg.onTimeout_target = target;
    return;
}
