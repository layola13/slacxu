fn tp_json_event_delta_string(doc: u64, key_ptr: ptr, key_len: u64, dst: ptr, cap: u64) -> u64 {
    let d: u64 = 0;
    if !tp_json_event_sub(doc, STR_PTR("delta"), STR_LEN("delta"), &d) { return 0; };
    return tp_json_str_field(d, key_ptr, key_len, dst, cap);
}

fn tp_json_event_delta_has(doc: u64, key_ptr: ptr, key_len: u64) -> bool {
    let d: u64 = 0;
    if !tp_json_event_sub(doc, STR_PTR("delta"), STR_LEN("delta"), &d) { return false; };
