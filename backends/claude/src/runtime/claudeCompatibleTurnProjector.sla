fn tp_json_event_message_string(doc: u64, key_ptr: ptr, key_len: u64, dst: ptr, cap: u64) -> u64 {
    let m: u64 = 0;
    if !tp_json_event_sub(doc, STR_PTR("message"), STR_LEN("message"), &m) { return 0; };
