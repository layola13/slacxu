fn tp_json_errors_count(doc: u64) -> u64 {
    let errs: u64 = 0;
    if !tp_json_nav(doc, STR_PTR("errors"), STR_LEN("errors"), &errs) { return 0; };
    if sa_json_kind(errs) != 6 { return 0; };
    let cnt: u64 = 0;
    if sa_json_value_count(errs, &cnt) != 0 { return 0; };
    return cnt;
}

fn tp_json_errors_get(doc: u64, idx: u64, dst: ptr, cap: u64) -> u64 {
    let errs: u64 = 0;
    if !tp_json_nav(doc, STR_PTR("errors"), STR_LEN("errors"), &errs) { return 0; };
    let el: u64 = 0;
    if sa_json_array_get(errs, idx, &el) != 0 { return 0; };
    return tp_json_str_node(el, dst, cap);
}

// FIX(be2): buf_append_u64 was called but only defined in the Jev domain
// (not imported here). TP-local decimal appender.
fn tp_buf_append_u64(out: &ByteBuf, v: u64) -> void {
    if v == 0 { buf_append_byte(out, 48); return; };
    let digits: [u8; 20] = [0u8; 20];
    let n: u64 = 0;
    let x = v;
    while x > 0 {
        digits[n] = (x % 10) as u8 + 48;
        n = n + 1;
        x = x / 10;
    }
    while n > 0 {
        n = n - 1;
        buf_append_byte(out, digits[n]);
    }
}

fn tp_buf_copy_buf(src_ptr: ptr, src_len: u64, dst: &[u8]) -> void {
    let i: u64 = 0;
    while i < src_len { dst[i] = PTR_BYTE_AT(src_ptr, i); i = i + 1; }
    return;
}

fn strmap_has(m: &StrMap, key_ptr: ptr, key_len: u64) -> bool {
    let off: u64 = 0;
    let i: u64 = 0;
    while i < m.keys.count {
        if m.keys.lens[i] == key_len && bytes_eq_buf(PTR_ADD(m.keys.items, off), key_len, key_ptr, key_len) { return true; };
        off = off + m.keys.lens[i];
        i = i + 1;
    }
    return false;
}

fn strmap_get(m: &StrMap, key_ptr: ptr, key_len: u64, out: &ByteBuf) -> bool {
    let koff: u64 = 0;
    let voff: u64 = 0;
    let i: u64 = 0;
    while i < m.keys.count {
        if m.keys.lens[i] == key_len && bytes_eq_buf(PTR_ADD(m.keys.items, koff), key_len, key_ptr, key_len) {
            buf_append_bytes(out, PTR_ADD(m.vals.items, voff), m.vals.lens[i]);
            return true;
        };
        koff = koff + m.keys.lens[i];
        voff = voff + m.vals.lens[i];
        i = i + 1;
    }
    return false;
}

fn strmap_set(m: &StrMap, key_ptr: ptr, key_len: u64, val_ptr: ptr, val_len: u64) -> void {
    let koff: u64 = 0;
    let voff: u64 = 0;
    let i: u64 = 0;
    while i < m.keys.count {
        if m.keys.lens[i] == key_len && bytes_eq_buf(PTR_ADD(m.keys.items, koff), key_len, key_ptr, key_len) {
            // DEFECT: value replacement in packed storage approximated by append-only
            // shadow entry — later sets append a new pair and get() scans from the end.
            // (Implemented via strmap_set_latest below at call sites that need replace.)
            strlist_push(&m.keys, key_ptr, key_len);
            strlist_push(&m.vals, val_ptr, val_len);
            return;
        };
        koff = koff + m.keys.lens[i];
        voff = voff + m.vals.lens[i];
        i = i + 1;
    }
    strlist_push(&m.keys, key_ptr, key_len);
    strlist_push(&m.vals, val_ptr, val_len);
    return;
}

// get() honoring latest-write-wins under the append-only approximation.
fn strmap_get_latest(m: &StrMap, key_ptr: ptr, key_len: u64, out: &ByteBuf) -> bool {
    let idx: i64 = m.keys.count - 1;
    while idx >= 0 {
        let koff: u64 = 0;
        let voff: u64 = 0;
        let i: u64 = 0;
        while i < idx { koff = koff + m.keys.lens[i]; voff = voff + m.vals.lens[i]; i = i + 1; }
        if m.keys.lens[idx] == key_len && bytes_eq_buf(PTR_ADD(m.keys.items, koff), key_len, key_ptr, key_len) {
            buf_append_bytes(out, PTR_ADD(m.vals.items, voff), m.vals.lens[idx]);
            return true;
        };
        idx = idx - 1;
    }
    return false;
}

fn strset_has(set: &StrList, key_ptr: ptr, key_len: u64) -> bool {
    let off: u64 = 0;
    let i: u64 = 0;
    while i < set.count {
        if set.lens[i] == key_len && bytes_eq_buf(PTR_ADD(set.items, off), key_len, key_ptr, key_len) { return true; };
        off = off + set.lens[i];
        i = i + 1;
    }
    return false;
}

fn strset_add(set: &StrList, key_ptr: ptr, key_len: u64) -> void {
    if !(strset_has(set, key_ptr, key_len)) { strlist_push(set, key_ptr, key_len); };
    return;
}

// Normalized events emitted by the projector.
// These match the Codex Ultra notification method names so the existing
// waterfall UI can render them without changes.
struct ProjectedEvent {
    kind: [u8; 64], // "thread/started" | "turn/started" | "turn/completed" | "turn/failed" | "turn/interrupted" | "item/agentMessage/delta" | "item/reasoning/textDelta" | "item/started" | "item/completed" | "item/permissionRequest" | "system/init"
    kind_len: u64,
    threadId: [u8; 128],
    threadId_len: u64,
    turnId: [u8; 128],
    turnId_len: u64,
    externalSessionId: [u8; 128],
    externalSessionId_len: u64,
    has_model: bool,
    model: [u8; 256],
    model_len: u64,
    has_cwd: bool,
    cwd: [u8; 1024],
    cwd_len: u64,
    has_error: bool,
    error: [u8; 4096],
    error_len: u64,
    itemId: [u8; 512],
    itemId_len: u64,
    delta: [u8; 262144],
    delta_len: u64,
    item_json: [u8; 262144], // item: Record<string, JsonValue> as JSON text
    item_json_len: u64,
    requestId: [u8; 256],
    requestId_len: u64,
    toolName: [u8; 256],
    toolName_len: u64,
    input_json: [u8; 262144], // input: unknown as JSON text
    input_json_len: u64,
    has_toolUseId: bool,
    toolUseId: [u8; 128],
    toolUseId_len: u64,
    has_version: bool,
    version: [u8; 64],
    version_len: u64,
    has_permissionMode: bool,
    permissionMode: [u8; 64],
    permissionMode_len: u64,
    json: [u8; 262144], // unused mirror of other structs' raw-json field
    json_len: u64,
}

fn projected_event_new(kind_ptr: ptr, kind_len: u64, threadId_ptr: ptr, threadId_len: u64, turnId_ptr: ptr, turnId_len: u64, out: &ProjectedEvent) -> void {
    out.kind_len = kind_len;
    buf_copy_ptr_to(kind_ptr, kind_len, &out.kind);
    out.threadId_len = threadId_len;
    buf_copy_ptr_to(threadId_ptr, threadId_len, &out.threadId);
    out.turnId_len = turnId_len;
    buf_copy_ptr_to(turnId_ptr, turnId_len, &out.turnId);
    out.externalSessionId_len = 0;
    out.has_model = false;
    out.model_len = 0;
    out.has_cwd = false;
    out.cwd_len = 0;
    out.has_error = false;
    out.error_len = 0;
    out.itemId_len = 0;
    out.delta_len = 0;
    out.item_json_len = 0;
    out.requestId_len = 0;
    out.toolName_len = 0;
    out.input_json_len = 0;
    out.has_toolUseId = false;
    out.toolUseId_len = 0;
    out.has_version = false;
    out.version_len = 0;
    out.has_permissionMode = false;
    out.permissionMode_len = 0;
    out.json_len = 0;
    return;
}

// State machine for a single Claude turn.
// Ensures exactly one terminal event is emitted per turn.
const TURN_STATUS_RUNNING: u64 = 0;
const TURN_STATUS_COMPLETED: u64 = 1;
const TURN_STATUS_FAILED: u64 = 2;
const TURN_STATUS_INTERRUPTED: u64 = 3;

// TS streamToolBlocks value: { id: string; name: string; argumentsJson: string; initialInput: JsonValue }
struct StreamToolBlock {
    occupied: bool,
    id: [u8; 128],
    id_len: u64,
    name: [u8; 256],
    name_len: u64,
    argumentsJson: [u8; 262144],
    argumentsJson_len: u64,
    initialInput_json: [u8; 262144],
    initialInput_json_len: u64,
}

struct TurnState {
    turnId: [u8; 128],
    turnId_len: u64,
    threadId: [u8; 128],
    threadId_len: u64,
    status: u64, // TURN_STATUS_*
    assistantItemIds: StrList, // Set<string>
    assistantTextBlocks: StrList, // string[]
    has_streamMessageId: bool,
    streamMessageId: [u8; 128],
    streamMessageId_len: u64,
    streamedAssistantItems: StrMap, // Map<string, string>
    streamedReasoningItems: StrMap, // Map<string, string>
    toolItems_keys: StrList, // Map<string, Record<string, JsonValue>> keys
    toolItems_json: StrList, // ... values as item JSON text
    streamToolBlocks: [StreamToolBlock; 64], // Map<number, StreamToolBlock> by block index
}

struct ProjectorContext {
    threadId: [u8; 128],
    threadId_len: u64,
    turnId: [u8; 128],
    turnId_len: u64,
    sessionToThread: StrMap, // Map<string, string>: external session_id -> internal threadId
    turn_status: u64, // mirror of turn.status for the runtime's isTurnActive check
    turn: TurnState,
}

fn toolItems_get(ctx: &ProjectorContext, id_ptr: ptr, id_len: u64, out: &ByteBuf) -> bool {
    let koff: u64 = 0;
    let voff: u64 = 0;
    let i: u64 = 0;
    while i < ctx.turn.toolItems_keys.count {
        if ctx.turn.toolItems_keys.lens[i] == id_len && bytes_eq_buf(PTR_ADD(ctx.turn.toolItems_keys.items, koff), id_len, id_ptr, id_len) {
            buf_append_bytes(out, PTR_ADD(ctx.turn.toolItems_json.items, voff), ctx.turn.toolItems_json.lens[i]);
            return true;
        };
        koff = koff + ctx.turn.toolItems_keys.lens[i];
        voff = voff + ctx.turn.toolItems_json.lens[i];
        i = i + 1;
    }
    return false;
}

fn toolItems_set(ctx: &ProjectorContext, id_ptr: ptr, id_len: u64, item_json_ptr: ptr, item_json_len: u64) -> void {
    // Append-only with latest-wins reads via toolItems_get_latest at read sites that need it.
    strlist_push(&ctx.turn.toolItems_keys, id_ptr, id_len);
    strlist_push(&ctx.turn.toolItems_json, item_json_ptr, item_json_len);
    return;
}

fn toolItems_get_latest(ctx: &ProjectorContext, id_ptr: ptr, id_len: u64, out: &ByteBuf) -> bool {
    let idx: i64 = ctx.turn.toolItems_keys.count - 1;
    while idx >= 0 {
        let koff: u64 = 0;
        let voff: u64 = 0;
        let i: u64 = 0;
        while i < idx { koff = koff + ctx.turn.toolItems_keys.lens[i]; voff = voff + ctx.turn.toolItems_json.lens[i]; i = i + 1; }
        if ctx.turn.toolItems_keys.lens[idx] == id_len && bytes_eq_buf(PTR_ADD(ctx.turn.toolItems_keys.items, koff), id_len, id_ptr, id_len) {
            buf_append_bytes(out, PTR_ADD(ctx.turn.toolItems_json.items, voff), ctx.turn.toolItems_json.lens[idx]);
            return true;
        };
        idx = idx - 1;
    }
    return false;
}

// Create a fresh projector context for a new turn.
fn createProjectorContext(threadId_ptr: ptr, threadId_len: u64, turnId_ptr: ptr, turnId_len: u64, out: &ProjectorContext) -> void {
    out.threadId_len = threadId_len;
    buf_copy_ptr_to(threadId_ptr, threadId_len, &out.threadId);
    out.turnId_len = turnId_len;
    buf_copy_ptr_to(turnId_ptr, turnId_len, &out.turnId);
    out.sessionToThread = StrMap { keys: StrList { items: [0u8; 16384], items_len: 0, lens: [0u64; 64], count: 0 }, vals: StrList { items: [0u8; 16384], items_len: 0, lens: [0u64; 64], count: 0 } };
    out.turn_status = TURN_STATUS_RUNNING;
    let t = &out.turn;
    t.turnId_len = turnId_len;
    buf_copy_ptr_to(turnId_ptr, turnId_len, &t.turnId);
    t.threadId_len = threadId_len;
    buf_copy_ptr_to(threadId_ptr, threadId_len, &t.threadId);
    t.status = TURN_STATUS_RUNNING;
    t.assistantItemIds = StrList { items: [0u8; 16384], items_len: 0, lens: [0u64; 64], count: 0 };
    t.assistantTextBlocks = StrList { items: [0u8; 16384], items_len: 0, lens: [0u64; 64], count: 0 };
    t.has_streamMessageId = false;
    t.streamMessageId_len = 0;
    t.streamedAssistantItems = StrMap { keys: StrList { items: [0u8; 16384], items_len: 0, lens: [0u64; 64], count: 0 }, vals: StrList { items: [0u8; 16384], items_len: 0, lens: [0u64; 64], count: 0 } };
    t.streamedReasoningItems = StrMap { keys: StrList { items: [0u8; 16384], items_len: 0, lens: [0u64; 64], count: 0 }, vals: StrList { items: [0u8; 16384], items_len: 0, lens: [0u64; 64], count: 0 } };
    t.toolItems_keys = StrList { items: [0u8; 16384], items_len: 0, lens: [0u64; 64], count: 0 };
    t.toolItems_json = StrList { items: [0u8; 16384], items_len: 0, lens: [0u64; 64], count: 0 };
    let bi: u64 = 0;
    while bi < 64 { t.streamToolBlocks[bi].occupied = false; t.streamToolBlocks[bi].argumentsJson_len = 0; t.streamToolBlocks[bi].initialInput_json_len = 0; bi = bi + 1; }
    return;
}

// DEFECT: regex replace /\r\n/g -> "\n" approximated by byte scan; .trim() by buf trim.
fn normalizeAssistantText(value_ptr: ptr, value_len: u64, out: &ByteBuf) -> void {
    let i: u64 = 0;
    while i < value_len {
        let c = PTR_BYTE_AT(value_ptr, i);
        if c == 13 && i + 1 < value_len && PTR_BYTE_AT(value_ptr, i + 1) == 10 {
            buf_append_byte(out, 10);
            i = i + 2;
        } else {
            buf_append_byte(out, c);
            i = i + 1;
        };
    }
    buf_trim_in_place(out);
    return;
}

fn assistantResultAlreadyProjected(blocks: &StrList, result_ptr: ptr, result_len: u64) -> bool {
    // const normalizedBlocks = blocks.map(normalizeAssistantText).filter(Boolean);
    // return normalizedBlocks.includes(result)
    //   || normalizeAssistantText(normalizedBlocks.join("\n")) === result
    //   || normalizeAssistantText(normalizedBlocks.join("")) === result;
    let joined_nl = ByteBuf { bytes: [0u8; 65536], len: 0 };
    let joined_raw = ByteBuf { bytes: [0u8; 65536], len: 0 };
    let off: u64 = 0;
    let kept: u64 = 0;
    let i: u64 = 0;
    while i < blocks.count {
        let nb = ByteBuf { bytes: [0u8; 65536], len: 0 };
        normalizeAssistantText(PTR_ADD(blocks.items, off), blocks.lens[i], &nb);
        off = off + blocks.lens[i];
        if nb.len > 0 {
            // includes(result): normalized block equals result
            let cap_p66: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p66, &nb.bytes, 0);
            if nb.len == result_len && bytes_eq_buf(cap_p66, nb.len, result_ptr, result_len) { return true; };
            if kept > 0 { buf_append_lit(&joined_nl, STR_PTR("\n"), STR_LEN("\n")); };
            let cap_p67: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p67, &nb.bytes, 0);
            buf_append_bytes(&joined_nl, cap_p67, nb.len);
            let cap_p68: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p68, &nb.bytes, 0);
            buf_append_bytes(&joined_raw, cap_p68, nb.len);
            kept = kept + 1;
        };
        i = i + 1;
    }
    let jn = ByteBuf { bytes: [0u8; 65536], len: 0 };
    let cap_nat1: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_nat1, &joined_nl.bytes, 0);
    normalizeAssistantText(cap_nat1, joined_nl.len, &jn);
    let cap_p69: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p69, &jn.bytes, 0);
    if jn.len == result_len && bytes_eq_buf(cap_p69, jn.len, result_ptr, result_len) { return true; };
    let jr = ByteBuf { bytes: [0u8; 65536], len: 0 };
    let cap_nat2: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_nat2, &joined_raw.bytes, 0);
    normalizeAssistantText(cap_nat2, joined_raw.len, &jr);
    let cap_p70: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p70, &jr.bytes, 0);
    if jr.len == result_len && bytes_eq_buf(cap_p70, jr.len, result_ptr, result_len) { return true; };
    return false;
}

fn reconcileStreamedItem(items: &StrMap, incoming_ptr: ptr, incoming_len: u64) -> bool {
    // const normalizedIncoming = normalizeAssistantText(incoming); if (!normalizedIncoming) return false;
    let ni = ByteBuf { bytes: [0u8; 65536], len: 0 };
    normalizeAssistantText(incoming_ptr, incoming_len, &ni);
    if ni.len == 0 { return false; };
    // for (const [itemId, current] of items) { ... if longer, items.set(itemId, incoming); return true; }
    let koff: u64 = 0;
    let voff: u64 = 0;
    let i: u64 = 0;
    while i < items.keys.count {
        let cur = ByteBuf { bytes: [0u8; 65536], len: 0 };
        buf_append_bytes(&cur, PTR_ADD(items.vals.items, voff), items.vals.lens[i]);
        let nc = ByteBuf { bytes: [0u8; 65536], len: 0 };
        let cap_nat3: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_nat3, &cur.bytes, 0);
        normalizeAssistantText(cap_nat3, cur.len, &nc);
        let relevant: bool = true;
        if nc.len == 0 { relevant = false; };
        let cap_p72: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p72, &ni.bytes, 0);
        let cap_p74: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p74, &nc.bytes, 0);
        if relevant && !(buf_contains(&nc.bytes, nc.len, cap_p72, ni.len)) && !(buf_contains(&ni.bytes, ni.len, cap_p74, nc.len)) { relevant = false; };
        if relevant {
            if ni.len > nc.len {
                strmap_set(items, PTR_ADD(items.keys.items, koff), items.keys.lens[i], incoming_ptr, incoming_len);
            };
            return true;
        };
        koff = koff + items.keys.lens[i];
        voff = voff + items.vals.lens[i];
        i = i + 1;
    }
    return false;
}

// fn streamedToolArguments(block): JsonValue — output as JSON text.
// DEFECT: JSON.parse try/catch — parse failure returns the raw source *string*
// as a JsonValue; here a failed parse is JSON-encoded as a string literal.
fn streamedToolArguments(block: &StreamToolBlock, out: &ByteBuf) -> void {
    // const source = block.argumentsJson.trim(); if (!source) return block.initialInput;
    let src = ByteBuf { bytes: [0u8; 65536], len: 0 };
    let cap_ba1: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ba1, &block.argumentsJson, 0);
    buf_append_bytes(&src, cap_ba1, block.argumentsJson_len);
    buf_trim_in_place(&src);
    if src.len == 0 {
        let cap_ba2: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ba2, &block.initialInput_json, 0);
        buf_append_bytes(out, cap_ba2, block.initialInput_json_len);
        return;
    };
    // try { return JSON.parse(source) } catch { return source }
    let doc = sa_json_parse(&src.bytes, src.len);
    if doc != 0 {
        sa_json_free(doc);
        let cap_p75: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p75, &src.bytes, 0);
        buf_append_bytes(out, cap_p75, src.len);
        return;
    };
    buf_append_lit(out, STR_PTR("\""), STR_LEN("\""));
    let cap_je1: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_je1, &src.bytes, 0);
    json_escape_into(out, cap_je1, src.len);
    buf_append_lit(out, STR_PTR("\""), STR_LEN("\""));
    return;
}

// Convert a projected event into a JSON-RPC notification that the
// existing Codex Ultra frontend expects.
// DEFECT: TS builds a params Record and returns { method, params }; SLA writes
// the full notification JSON text: {"method": "...", "params": {...}}.
fn toNotification(event: &ProjectedEvent, out: &ByteBuf) -> void {
    let kind: ptr = PTR_NULL(); PTR_BYTE_ADD(kind, &event.kind, 0);
    let kl: u64 = event.kind_len;
    buf_append_lit(out, STR_PTR("{\"method\":\""), STR_LEN("{\"method\":\""));
    // method name: for item/permissionRequest the method is "item/tool/requestPermission"
    let is_perm: bool = bytes_eq_buf(kind, kl, STR_PTR("item/permissionRequest"), STR_LEN("item/permissionRequest"));
    if is_perm {
        buf_append_lit(out, STR_PTR("item/tool/requestPermission"), STR_LEN("item/tool/requestPermission"));
    } else {
        buf_append_bytes(out, kind, kl);
    };
    buf_append_lit(out, STR_PTR("\",\"params\":{"), STR_LEN("\",\"params\":{"));
    // params.threadId / params.turnId common to most kinds
    let is_thread_started: bool = bytes_eq_buf(kind, kl, STR_PTR("thread/started"), STR_LEN("thread/started"));
    let is_system_init: bool = bytes_eq_buf(kind, kl, STR_PTR("system/init"), STR_LEN("system/init"));
    buf_append_lit(out, STR_PTR("\"threadId\":\""), STR_LEN("\"threadId\":\""));
    let cap_je2: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_je2, &event.threadId, 0);
    json_escape_into(out, cap_je2, event.threadId_len);
    buf_append_lit(out, STR_PTR("\""), STR_LEN("\""));
    if is_thread_started || is_system_init {
        buf_append_lit(out, STR_PTR(",\"externalSessionId\":\""), STR_LEN(",\"externalSessionId\":\""));
        let cap_je3: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_je3, &event.externalSessionId, 0);
        json_escape_into(out, cap_je3, event.externalSessionId_len);
        buf_append_lit(out, STR_PTR("\""), STR_LEN("\""));
    };
    if is_system_init {
        // if (event.version) params.claudeCodeVersion = event.version; model/cwd/permissionMode likewise
        if event.has_version { json_param_string(out, STR_PTR("claudeCodeVersion"), STR_LEN("claudeCodeVersion"), &event.version, event.version_len); };
        if event.has_model { json_param_string(out, STR_PTR("model"), STR_LEN("model"), &event.model, event.model_len); };
        if event.has_cwd { json_param_string(out, STR_PTR("cwd"), STR_LEN("cwd"), &event.cwd, event.cwd_len); };
        if event.has_permissionMode { json_param_string(out, STR_PTR("permissionMode"), STR_LEN("permissionMode"), &event.permissionMode, event.permissionMode_len); };
        buf_append_lit(out, STR_PTR("}}"), STR_LEN("}}"));
        return;
    };
    if is_thread_started {
        if event.has_model { json_param_string(out, STR_PTR("model"), STR_LEN("model"), &event.model, event.model_len); };
        if event.has_cwd { json_param_string(out, STR_PTR("cwd"), STR_LEN("cwd"), &event.cwd, event.cwd_len); };
        buf_append_lit(out, STR_PTR("}}"), STR_LEN("}}"));
        return;
    };
    // all remaining kinds carry turnId
    buf_append_lit(out, STR_PTR(",\"turnId\":\""), STR_LEN(",\"turnId\":\""));
    let cap_je4: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_je4, &event.turnId, 0);
    json_escape_into(out, cap_je4, event.turnId_len);
    buf_append_lit(out, STR_PTR("\""), STR_LEN("\""));
    if bytes_eq_buf(kind, kl, STR_PTR("turn/started"), STR_LEN("turn/started")) || bytes_eq_buf(kind, kl, STR_PTR("turn/completed"), STR_LEN("turn/completed")) || bytes_eq_buf(kind, kl, STR_PTR("turn/failed"), STR_LEN("turn/failed")) || bytes_eq_buf(kind, kl, STR_PTR("turn/interrupted"), STR_LEN("turn/interrupted")) {
        // params.turn = { id: turnId, threadId, status }
        let status_ptr: ptr = STR_PTR("running");
        let status_len: u64 = STR_LEN("running");
        if bytes_eq_buf(kind, kl, STR_PTR("turn/completed"), STR_LEN("turn/completed")) { status_ptr = STR_PTR("completed"); status_len = STR_LEN("completed"); };
        if bytes_eq_buf(kind, kl, STR_PTR("turn/failed"), STR_LEN("turn/failed")) { status_ptr = STR_PTR("failed"); status_len = STR_LEN("failed"); };
        if bytes_eq_buf(kind, kl, STR_PTR("turn/interrupted"), STR_LEN("turn/interrupted")) { status_ptr = STR_PTR("interrupted"); status_len = STR_LEN("interrupted"); };
        buf_append_lit(out, STR_PTR(",\"turn\":{\"id\":\""), STR_LEN(",\"turn\":{\"id\":\""));
        let cap_je5: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_je5, &event.turnId, 0);
        json_escape_into(out, cap_je5, event.turnId_len);
        buf_append_lit(out, STR_PTR("\",\"threadId\":\""), STR_LEN("\",\"threadId\":\""));
        let cap_je6: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_je6, &event.threadId, 0);
        json_escape_into(out, cap_je6, event.threadId_len);
        buf_append_lit(out, STR_PTR("\",\"status\":\""), STR_LEN("\",\"status\":\""));
        buf_append_bytes(out, status_ptr, status_len);
        buf_append_lit(out, STR_PTR("\"}"), STR_LEN("\"}"));
        // turn/failed: if (event.error) params.error = event.error;
        if bytes_eq_buf(kind, kl, STR_PTR("turn/failed"), STR_LEN("turn/failed")) && event.has_error {
            json_param_string(out, STR_PTR("error"), STR_LEN("error"), &event.error, event.error_len);
        };
        buf_append_lit(out, STR_PTR("}}"), STR_LEN("}}"));
        return;
    };
    if bytes_eq_buf(kind, kl, STR_PTR("item/agentMessage/delta"), STR_LEN("item/agentMessage/delta")) || bytes_eq_buf(kind, kl, STR_PTR("item/reasoning/textDelta"), STR_LEN("item/reasoning/textDelta")) {
        // params.itemId / params.delta
        json_param_string(out, STR_PTR("itemId"), STR_LEN("itemId"), &event.itemId, event.itemId_len);
        json_param_string(out, STR_PTR("delta"), STR_LEN("delta"), &event.delta, event.delta_len);
        buf_append_lit(out, STR_PTR("}}"), STR_LEN("}}"));
        return;
    };
    if bytes_eq_buf(kind, kl, STR_PTR("item/started"), STR_LEN("item/started")) || bytes_eq_buf(kind, kl, STR_PTR("item/completed"), STR_LEN("item/completed")) {
        // params.item = event.item (raw JSON)
        buf_append_lit(out, STR_PTR(",\"item\":"), STR_LEN(",\"item\":"));
        let cap_ba3: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ba3, &event.item_json, 0);
        if event.item_json_len > 0 { buf_append_bytes(out, cap_ba3, event.item_json_len); } else { buf_append_lit(out, STR_PTR("{}"), STR_LEN("{}")); };
        buf_append_lit(out, STR_PTR("}}"), STR_LEN("}}"));
        return;
    };
    if is_perm {
        // params.id = requestId; params.toolName; params.input; if (toolUseId) params.toolUseId
        json_param_string(out, STR_PTR("id"), STR_LEN("id"), &event.requestId, event.requestId_len);
        json_param_string(out, STR_PTR("toolName"), STR_LEN("toolName"), &event.toolName, event.toolName_len);
        buf_append_lit(out, STR_PTR(",\"input\":"), STR_LEN(",\"input\":"));
        let cap_ba4: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ba4, &event.input_json, 0);
        if event.input_json_len > 0 { buf_append_bytes(out, cap_ba4, event.input_json_len); } else { buf_append_lit(out, STR_PTR("{}"), STR_LEN("{}")); };
        if event.has_toolUseId { json_param_string(out, STR_PTR("toolUseId"), STR_LEN("toolUseId"), &event.toolUseId, event.toolUseId_len); };
        buf_append_lit(out, STR_PTR("}}"), STR_LEN("}}"));
        return;
    };
    buf_append_lit(out, STR_PTR("}}"), STR_LEN("}}"));
    return;
}

fn json_param_string(out: &ByteBuf, key_ptr: ptr, key_len: u64, val: &[u8], val_len: u64) -> void {
    buf_append_lit(out, STR_PTR(",\""), STR_LEN(",\""));
    buf_append_bytes(out, key_ptr, key_len);
    buf_append_lit(out, STR_PTR("\":\""), STR_LEN("\":\""));
    let cap_jp1: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_jp1, val, 0);
    json_escape_into(out, cap_jp1, val_len);
    buf_append_lit(out, STR_PTR("\""), STR_LEN("\""));
    return;
}

// Resolve the threadId for a message, using the session-to-thread map
// and falling back to the context's threadId for single-thread bridges.
fn resolveThread(ctx: &ProjectorContext, has_sessionId: bool, sessionId_ptr: ptr, sessionId_len: u64, out: &ByteBuf) -> void {
    if has_sessionId {
        // if (ctx.sessionToThread.has(sessionId)) return ctx.sessionToThread.get(sessionId)!;
        if strmap_has(&ctx.sessionToThread, sessionId_ptr, sessionId_len) {
            strmap_get_latest(&ctx.sessionToThread, sessionId_ptr, sessionId_len, out);
            return;
        };
        // if (sessionId && !has) ctx.sessionToThread.set(sessionId, ctx.threadId);
        let cap_sm9: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_sm9, &ctx.threadId, 0);
        strmap_set(&ctx.sessionToThread, sessionId_ptr, sessionId_len, cap_sm9, ctx.threadId_len);
    };
    let cap_ba5: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ba5, &ctx.threadId, 0);
    buf_append_bytes(out, cap_ba5, ctx.threadId_len);
    return;
}

// Runtime helper (used by ClaudeCompatibleRuntime_getExternalSessionId):
// find the session id whose mapped thread equals threadId.
fn projector_session_for_thread(ctx: &ProjectorContext, threadId_ptr: ptr, threadId_len: u64, out: &ByteBuf) -> bool {
    let koff: u64 = 0;
    let voff: u64 = 0;
    let i: u64 = 0;
    while i < ctx.sessionToThread.keys.count {
        if ctx.sessionToThread.vals.lens[i] == threadId_len && bytes_eq_buf(PTR_ADD(ctx.sessionToThread.vals.items, voff), threadId_len, threadId_ptr, threadId_len) {
            buf_append_bytes(out, PTR_ADD(ctx.sessionToThread.keys.items, koff), ctx.sessionToThread.keys.lens[i]);
            return true;
        };
        koff = koff + ctx.sessionToThread.keys.lens[i];
        voff = voff + ctx.sessionToThread.vals.lens[i];
        i = i + 1;
    }
    return false;
}

// Check if the turn has already reached a terminal state.
fn isTerminal(ctx: &ProjectorContext) -> bool {
    return ctx.turn.status != TURN_STATUS_RUNNING;
}

// Mark the turn as terminal. Returns true if this is the first terminal transition.
fn markTerminal(ctx: &ProjectorContext, status: u64) -> bool {
    if isTerminal(ctx) { return false; };
    ctx.turn.status = status;
    ctx.turn_status = status;
    return true;
}

fn events_push(events: &[ProjectedEvent], count: &u64, cap: u64, ev: &ProjectedEvent) -> void {
    if *count >= cap { return; };
    events[*count] = *ev;
    *count = (*count) + 1;
    return;
}

// Build a toolCall item JSON: {type:"toolCall", id, threadId, turnId, name, tool, toolName, input, arguments, status}
fn build_tool_item(out: &ByteBuf, id_ptr: ptr, id_len: u64, threadId_ptr: ptr, threadId_len: u64, turnId_ptr: ptr, turnId_len: u64, name_ptr: ptr, name_len: u64, args_json_ptr: ptr, args_json_len: u64, status_ptr: ptr, status_len: u64) -> void {
    buf_append_lit(out, STR_PTR("{\"type\":\"toolCall\",\"id\":\""), STR_LEN("{\"type\":\"toolCall\",\"id\":\""));
    json_escape_into(out, id_ptr, id_len);
    buf_append_lit(out, STR_PTR("\",\"threadId\":\""), STR_LEN("\",\"threadId\":\""));
    json_escape_into(out, threadId_ptr, threadId_len);
    buf_append_lit(out, STR_PTR("\",\"turnId\":\""), STR_LEN("\",\"turnId\":\""));
    json_escape_into(out, turnId_ptr, turnId_len);
    buf_append_lit(out, STR_PTR("\",\"name\":\""), STR_LEN("\",\"name\":\""));
    json_escape_into(out, name_ptr, name_len);
    buf_append_lit(out, STR_PTR("\",\"tool\":\""), STR_LEN("\",\"tool\":\""));
    json_escape_into(out, name_ptr, name_len);
    buf_append_lit(out, STR_PTR("\",\"toolName\":\""), STR_LEN("\",\"toolName\":\""));
    json_escape_into(out, name_ptr, name_len);
    buf_append_lit(out, STR_PTR("\",\"input\":"), STR_LEN("\",\"input\":"));
    if args_json_len > 0 { buf_append_bytes(out, args_json_ptr, args_json_len); } else { buf_append_lit(out, STR_PTR("{}"), STR_LEN("{}")); };
    buf_append_lit(out, STR_PTR(",\"arguments\":"), STR_LEN(",\"arguments\":"));
    if args_json_len > 0 { buf_append_bytes(out, args_json_ptr, args_json_len); } else { buf_append_lit(out, STR_PTR("{}"), STR_LEN("{}")); };
    buf_append_lit(out, STR_PTR(",\"status\":\""), STR_LEN(",\"status\":\""));
    buf_append_bytes(out, status_ptr, status_len);
    buf_append_lit(out, STR_PTR("\"}"), STR_LEN("\"}"));
    return;
}

// Build an agentMessage/reasoning completed item JSON.
fn build_message_item(out: &ByteBuf, is_reasoning: bool, id_ptr: ptr, id_len: u64, threadId_ptr: ptr, threadId_len: u64, text_ptr: ptr, text_len: u64) -> void {
    if is_reasoning {
        buf_append_lit(out, STR_PTR("{\"type\":\"reasoning\",\"id\":\""), STR_LEN("{\"type\":\"reasoning\",\"id\":\""));
        json_escape_into(out, id_ptr, id_len);
        buf_append_lit(out, STR_PTR("\",\"threadId\":\""), STR_LEN("\",\"threadId\":\""));
        json_escape_into(out, threadId_ptr, threadId_len);
        buf_append_lit(out, STR_PTR("\",\"text\":\""), STR_LEN("\",\"text\":\""));
        json_escape_into(out, text_ptr, text_len);
        buf_append_lit(out, STR_PTR("\",\"status\":\"completed\"}"), STR_LEN("\",\"status\":\"completed\"}"));
        return;
    };
    buf_append_lit(out, STR_PTR("{\"type\":\"agentMessage\",\"id\":\""), STR_LEN("{\"type\":\"agentMessage\",\"id\":\""));
    json_escape_into(out, id_ptr, id_len);
    buf_append_lit(out, STR_PTR("\",\"threadId\":\""), STR_LEN("\",\"threadId\":\""));
    json_escape_into(out, threadId_ptr, threadId_len);
    buf_append_lit(out, STR_PTR("\",\"content\":\""), STR_LEN("\",\"content\":\""));
    json_escape_into(out, text_ptr, text_len);
    buf_append_lit(out, STR_PTR("\",\"role\":\"assistant\",\"status\":\"completed\"}"), STR_LEN("\",\"role\":\"assistant\",\"status\":\"completed\"}"));
    return;
}

// Project a single parsed Claude message into zero or more normalized events.
// Returns the number of events written to `events` (TS returns ProjectedEvent[]).
// DEFECT: message field access — TS casts ClaudeMessage to the concrete
// interfaces; here fields are probed from message.json with sa_json_* nested /
// content-block accessors (placeholders, see header DEFECT). Array.isArray
// checks map to *_count probes returning a has-array flag.
fn projectMessage(message: &ClaudeMessage, ctx: &ProjectorContext, events: &[ProjectedEvent], cap: u64) -> u64 {
    let count: u64 = 0;
    let doc = sa_json_parse(&message.json, message.json_len);
    if doc == 0 { return 0; };
    let type_ptr: ptr = PTR_NULL(); PTR_BYTE_ADD(type_ptr, &message.type_, 0);
    let type_len: u64 = message.type_len;

    // case "system"
    if bytes_eq_buf(type_ptr, type_len, STR_PTR("system"), STR_LEN("system")) {
        // if (message.subtype === "init") { const init = message as ClaudeSystemInitMessage; ... }
        let subtype: [u8; 64] = [0u8; 64];
        let subtype_p: ptr = PTR_NULL(); PTR_BYTE_ADD(subtype_p, &subtype, 0);
        let subtype_len: u64 = json_get_string_copy(doc, STR_PTR("subtype"), STR_LEN("subtype"), subtype_p, 64);
        if bytes_eq_buf(subtype_p, subtype_len, STR_PTR("init"), STR_LEN("init")) {
            let threadId = ByteBuf { bytes: [0u8; 65536], len: 0 };
            let cap_rt1: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_rt1, &message.session_id, 0);
            resolveThread(ctx, message.has_session_id, cap_rt1, message.session_id_len, &threadId);
            let ev = ProjectedEvent { kind: [0u8; 64], kind_len: 0, threadId: [0u8; 128], threadId_len: 0, turnId: [0u8; 128], turnId_len: 0, externalSessionId: [0u8; 128], externalSessionId_len: 0, has_model: false, model: [0u8; 256], model_len: 0, has_cwd: false, cwd: [0u8; 1024], cwd_len: 0, has_error: false, error: [0u8; 4096], error_len: 0, itemId: [0u8; 512], itemId_len: 0, delta: [0u8; 262144], delta_len: 0, item_json: [0u8; 262144], item_json_len: 0, requestId: [0u8; 256], requestId_len: 0, toolName: [0u8; 256], toolName_len: 0, input_json: [0u8; 262144], input_json_len: 0, has_toolUseId: false, toolUseId: [0u8; 128], toolUseId_len: 0, has_version: false, version: [0u8; 64], version_len: 0, has_permissionMode: false, permissionMode: [0u8; 64], permissionMode_len: 0, json: [0u8; 262144], json_len: 0 };
            let cap_pe1: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_pe1, &threadId.bytes, 0);
            let cap_pt101: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_pt101, &ctx.turnId, 0);
            projected_event_new(STR_PTR("system/init"), STR_LEN("system/init"), cap_pe1, threadId.len, cap_pt101, ctx.turnId_len, &ev);
            ev.externalSessionId_len = message.session_id_len;
            let cap_cb1: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_cb1, &message.session_id, 0);
            tp_buf_copy_buf(cap_cb1, message.session_id_len, &ev.externalSessionId);
            // version: init.claude_code_version; model; cwd; permissionMode (all required in TS init interface)
            ev.has_version = true;
            let jgs_p10: ptr = PTR_NULL(); PTR_BYTE_ADD(jgs_p10, &ev.version, 0);
            ev.version_len = json_get_string_copy(doc, STR_PTR("claude_code_version"), STR_LEN("claude_code_version"), jgs_p10, 64);
            ev.has_model = true;
            let jgs_p11: ptr = PTR_NULL(); PTR_BYTE_ADD(jgs_p11, &ev.model, 0);
            ev.model_len = json_get_string_copy(doc, STR_PTR("model"), STR_LEN("model"), jgs_p11, 256);
            ev.has_cwd = true;
            let jgs_p12: ptr = PTR_NULL(); PTR_BYTE_ADD(jgs_p12, &ev.cwd, 0);
            ev.cwd_len = json_get_string_copy(doc, STR_PTR("cwd"), STR_LEN("cwd"), jgs_p12, 1024);
            ev.has_permissionMode = true;
            let jgs_p13: ptr = PTR_NULL(); PTR_BYTE_ADD(jgs_p13, &ev.permissionMode, 0);
            ev.permissionMode_len = json_get_string_copy(doc, STR_PTR("permissionMode"), STR_LEN("permissionMode"), jgs_p13, 64);
            events_push(events, &count, cap, &ev);
        };
        sa_json_free(doc);
        return count;
    };

    // case "assistant"
    if bytes_eq_buf(type_ptr, type_len, STR_PTR("assistant"), STR_LEN("assistant")) {
        if isTerminal(ctx) { sa_json_free(doc); return count; };
        let threadId = ByteBuf { bytes: [0u8; 65536], len: 0 };
        let cap_rt2: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_rt2, &message.session_id, 0);
        resolveThread(ctx, message.has_session_id, cap_rt2, message.session_id_len, &threadId);
        // const content = msg.message?.content; if (!Array.isArray(content)) return events;
        let has_content: bool = false;
        let block_count: u64 = tp_json_message_content_count(doc, &has_content);
        if !(has_content) { sa_json_free(doc); return count; };
        // msg.message.id (for stable stream item ids)
        let msg_id: [u8; 128] = [0u8; 128];
        let msg_id_p: ptr = PTR_NULL(); PTR_BYTE_ADD(msg_id_p, &msg_id, 0);
        let msg_id_len: u64 = tp_json_get_nested_string(doc, STR_PTR("message"), STR_LEN("message"), STR_PTR("id"), STR_LEN("id"), msg_id_p, 128);
        let blockIndex: u64 = 0;
        while blockIndex < block_count {
            let btype: [u8; 64] = [0u8; 64];
            let btype_p: ptr = PTR_NULL(); PTR_BYTE_ADD(btype_p, &btype, 0);
            let btype_len: u64 = tp_json_content_block_string(doc, blockIndex, STR_PTR("type"), STR_LEN("type"), btype_p, 64);
            if bytes_eq_buf(btype_p, btype_len, STR_PTR("text"), STR_LEN("text")) {
                // block.type === "text" && typeof block.text === "string"
                let btext = ByteBuf { bytes: [0u8; 65536], len: 0 };
                let has_text: bool = tp_json_content_block_has(doc, blockIndex, STR_PTR("text"), STR_LEN("text"));
                let cap_td1: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_td1, &btext.bytes, 0);
                let bt_len: u64 = tp_json_content_block_string(doc, blockIndex, STR_PTR("text"), STR_LEN("text"), cap_td1, 262144);
                btext.len = bt_len;
                if has_text {
                    project_assistant_text_block(ctx, &threadId, &msg_id, msg_id_len, message, blockIndex, &btext, events, &count, cap);
                };
            } else if bytes_eq_buf(btype_p, btype_len, STR_PTR("thinking"), STR_LEN("thinking")) {
                let bthink = ByteBuf { bytes: [0u8; 65536], len: 0 };
                let has_think: bool = tp_json_content_block_has(doc, blockIndex, STR_PTR("thinking"), STR_LEN("thinking"));
                let cap_td2: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_td2, &bthink.bytes, 0);
                let bk_len: u64 = tp_json_content_block_string(doc, blockIndex, STR_PTR("thinking"), STR_LEN("thinking"), cap_td2, 262144);
                bthink.len = bk_len;
                if has_think {
                    project_assistant_thinking_block(ctx, &threadId, &msg_id, msg_id_len, message, blockIndex, &bthink, events, &count, cap);
                };
            } else if bytes_eq_buf(btype_p, btype_len, STR_PTR("tool_use"), STR_LEN("tool_use")) {
                // block.type === "tool_use" && typeof block.id === "string"
                let bid: [u8; 128] = [0u8; 128];
                let bid_p: ptr = PTR_NULL(); PTR_BYTE_ADD(bid_p, &bid, 0);
                let bid_len: u64 = tp_json_content_block_string(doc, blockIndex, STR_PTR("id"), STR_LEN("id"), bid_p, 128);
                if bid_len > 0 || tp_json_content_block_has(doc, blockIndex, STR_PTR("id"), STR_LEN("id")) {
                    // const toolArgs = (block.input ?? {}) as JsonValue; const toolName = block.name as string;
                    let toolArgs = ByteBuf { bytes: [0u8; 65536], len: 0 };
                    if !(tp_json_content_block_json(doc, blockIndex, STR_PTR("input"), STR_LEN("input"), &toolArgs)) {
                        buf_append_lit(&toolArgs, STR_PTR("{}"), STR_LEN("{}"));
                    };
                    let bname: [u8; 256] = [0u8; 256];
                    let bname_p: ptr = PTR_NULL(); PTR_BYTE_ADD(bname_p, &bname, 0);
                    let bname_len: u64 = tp_json_content_block_string(doc, blockIndex, STR_PTR("name"), STR_LEN("name"), bname_p, 256);
                    let item = ByteBuf { bytes: [0u8; 65536], len: 0 };
                    let cap_bt1: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_bt1, &threadId.bytes, 0);
                    let cap_bt2: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_bt2, &ctx.turnId, 0);
                    let cap_bt3: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_bt3, &toolArgs.bytes, 0);
                    build_tool_item(&item, bid_p, bid_len, cap_bt1, threadId.len, cap_bt2, ctx.turnId_len, bname_p, bname_len, cap_bt3, toolArgs.len, STR_PTR("inProgress"), STR_LEN("inProgress"));
                    // ctx.turn.toolItems.set(block.id, item);
                    let cap_ts201: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ts201, &item.bytes, 0);
                    toolItems_set(ctx, bid_p, bid_len, cap_ts201, item.len);
                    // events.push({ kind: "item/started", threadId, turnId, item });
                    push_item_event(events, &count, cap, STR_PTR("item/started"), STR_LEN("item/started"), &threadId, ctx, &item);
                };
            };
            blockIndex = blockIndex + 1;
        }
        sa_json_free(doc);
        return count;
    };

    // case "user"
    if bytes_eq_buf(type_ptr, type_len, STR_PTR("user"), STR_LEN("user")) {
        if isTerminal(ctx) { sa_json_free(doc); return count; };
        let threadId = ByteBuf { bytes: [0u8; 65536], len: 0 };
        let cap_rt3: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_rt3, &message.session_id, 0);
        resolveThread(ctx, message.has_session_id, cap_rt3, message.session_id_len, &threadId);
        let has_content: bool = false;
        let block_count: u64 = tp_json_message_content_count(doc, &has_content);
        if has_content {
            let blockIndex: u64 = 0;
            while blockIndex < block_count {
                let btype: [u8; 64] = [0u8; 64];
                let btype_p: ptr = PTR_NULL(); PTR_BYTE_ADD(btype_p, &btype, 0);
                let btype_len: u64 = tp_json_content_block_string(doc, blockIndex, STR_PTR("type"), STR_LEN("type"), btype_p, 64);
                if bytes_eq_buf(btype_p, btype_len, STR_PTR("tool_result"), STR_LEN("tool_result")) {
                    let tuid: [u8; 128] = [0u8; 128];
                    let tuid_p: ptr = PTR_NULL(); PTR_BYTE_ADD(tuid_p, &tuid, 0);
                    let tuid_len: u64 = tp_json_content_block_string(doc, blockIndex, STR_PTR("tool_use_id"), STR_LEN("tool_use_id"), tuid_p, 128);
                    if tuid_len > 0 || tp_json_content_block_has(doc, blockIndex, STR_PTR("tool_use_id"), STR_LEN("tool_use_id")) {
                        project_tool_result_block(ctx, doc, blockIndex, &threadId, &tuid, tuid_len, events, &count, cap);
                    };
                };
                blockIndex = blockIndex + 1;
            }
        };
        sa_json_free(doc);
        return count;
    };

    // case "stream_event"
    if bytes_eq_buf(type_ptr, type_len, STR_PTR("stream_event"), STR_LEN("stream_event")) {
        if isTerminal(ctx) { sa_json_free(doc); return count; };
        project_stream_event(doc, message, ctx, events, &count, cap);
        sa_json_free(doc);
        return count;
    };

    // case "streamlined_text"
    if bytes_eq_buf(type_ptr, type_len, STR_PTR("streamlined_text"), STR_LEN("streamlined_text")) {
        if isTerminal(ctx) { sa_json_free(doc); return count; };
        let threadId = ByteBuf { bytes: [0u8; 65536], len: 0 };
        let cap_rt4: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_rt4, &message.session_id, 0);
        resolveThread(ctx, message.has_session_id, cap_rt4, message.session_id_len, &threadId);
        let text = ByteBuf { bytes: [0u8; 65536], len: 0 };
        let jgs_p14: ptr = PTR_NULL(); PTR_BYTE_ADD(jgs_p14, &text.bytes, 0);
        text.len = json_get_string_copy(doc, STR_PTR("text"), STR_LEN("text"), jgs_p14, 262144);
        // const itemId = (msg.uuid ?? ctx.turnId) + "-text";
        let itemId = ByteBuf { bytes: [0u8; 65536], len: 0 };
        append_uuid_or_turn(message, ctx, &itemId);
        buf_append_lit(&itemId, STR_PTR("-text"), STR_LEN("-text"));
        let cap_ss301: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ss301, &itemId.bytes, 0);
        if !(strset_has(&ctx.turn.assistantItemIds, cap_ss301, itemId.len)) {
            let cap_ss302: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ss302, &itemId.bytes, 0);
            strset_add(&ctx.turn.assistantItemIds, cap_ss302, itemId.len);
            strlist_push_buf(&ctx.turn.assistantTextBlocks, &text.bytes, text.len);
            let item = ByteBuf { bytes: [0u8; 65536], len: 0 };
            let cap_bm401: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_bm401, &itemId.bytes, 0);
            let cap_bm402: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_bm402, &threadId.bytes, 0);
            let cap_bm403: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_bm403, &text.bytes, 0);
            build_message_item(&item, false, cap_bm401, itemId.len, cap_bm402, threadId.len, cap_bm403, text.len);
            push_item_event(events, &count, cap, STR_PTR("item/completed"), STR_LEN("item/completed"), &threadId, ctx, &item);
        };
        sa_json_free(doc);
        return count;
    };

    // case "result"
    if bytes_eq_buf(type_ptr, type_len, STR_PTR("result"), STR_LEN("result")) {
        if isTerminal(ctx) { sa_json_free(doc); return count; };
        project_result_message(doc, message, ctx, events, &count, cap);
        sa_json_free(doc);
        return count;
    };

    // case "control_request"
    if bytes_eq_buf(type_ptr, type_len, STR_PTR("control_request"), STR_LEN("control_request")) {
        // if (msg.request?.subtype === "can_use_tool") { ... }
        let rsubtype: [u8; 64] = [0u8; 64];
        let rsubtype_p: ptr = PTR_NULL(); PTR_BYTE_ADD(rsubtype_p, &rsubtype, 0);
        let rsubtype_len: u64 = tp_json_get_nested_string(doc, STR_PTR("request"), STR_LEN("request"), STR_PTR("subtype"), STR_LEN("subtype"), rsubtype_p, 64);
        if bytes_eq_buf(rsubtype_p, rsubtype_len, STR_PTR("can_use_tool"), STR_LEN("can_use_tool")) {
            let threadId = ByteBuf { bytes: [0u8; 65536], len: 0 };
            let cap_rt5: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_rt5, &message.session_id, 0);
            resolveThread(ctx, message.has_session_id, cap_rt5, message.session_id_len, &threadId);
            let ev = ProjectedEvent { kind: [0u8; 64], kind_len: 0, threadId: [0u8; 128], threadId_len: 0, turnId: [0u8; 128], turnId_len: 0, externalSessionId: [0u8; 128], externalSessionId_len: 0, has_model: false, model: [0u8; 256], model_len: 0, has_cwd: false, cwd: [0u8; 1024], cwd_len: 0, has_error: false, error: [0u8; 4096], error_len: 0, itemId: [0u8; 512], itemId_len: 0, delta: [0u8; 262144], delta_len: 0, item_json: [0u8; 262144], item_json_len: 0, requestId: [0u8; 256], requestId_len: 0, toolName: [0u8; 256], toolName_len: 0, input_json: [0u8; 262144], input_json_len: 0, has_toolUseId: false, toolUseId: [0u8; 128], toolUseId_len: 0, has_version: false, version: [0u8; 64], version_len: 0, has_permissionMode: false, permissionMode: [0u8; 64], permissionMode_len: 0, json: [0u8; 262144], json_len: 0 };
            let cap_pe2: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_pe2, &threadId.bytes, 0);
            let cap_pt102: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_pt102, &ctx.turnId, 0);
            projected_event_new(STR_PTR("item/permissionRequest"), STR_LEN("item/permissionRequest"), cap_pe2, threadId.len, cap_pt102, ctx.turnId_len, &ev);
            // requestId: msg.request_id
            let jgs_p15: ptr = PTR_NULL(); PTR_BYTE_ADD(jgs_p15, &ev.requestId, 0);
            ev.requestId_len = json_get_string_copy(doc, STR_PTR("request_id"), STR_LEN("request_id"), jgs_p15, 256);
            // toolName: msg.request.tool_name ?? "unknown"
            let cap_td3: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_td3, &ev.toolName, 0);
            ev.toolName_len = tp_json_get_nested_string(doc, STR_PTR("request"), STR_LEN("request"), STR_PTR("tool_name"), STR_LEN("tool_name"), cap_td3, 256);
            if ev.toolName_len == 0 && !(tp_json_get_nested_has(doc, STR_PTR("request"), STR_LEN("request"), STR_PTR("tool_name"), STR_LEN("tool_name"))) {
                ev.toolName_len = STR_LEN("unknown");
                buf_copy_lit_to(STR_PTR("unknown"), STR_LEN("unknown"), &ev.toolName);
            };
            // input: (msg.request.input ?? {}) as JsonValue
            let input = ByteBuf { bytes: [0u8; 65536], len: 0 };
            if !(tp_json_get_nested_json(doc, STR_PTR("request"), STR_LEN("request"), STR_PTR("input"), STR_LEN("input"), &input)) {
                buf_append_lit(&input, STR_PTR("{}"), STR_LEN("{}"));
            };
            ev.input_json_len = input.len;
            buf_copy_to(&input, &ev.input_json);
            // ...(msg.request.tool_use_id ? { toolUseId } : {})
            let tuid: [u8; 128] = [0u8; 128];
            let tuid_p: ptr = PTR_NULL(); PTR_BYTE_ADD(tuid_p, &tuid, 0);
            let tuid_len: u64 = tp_json_get_nested_string(doc, STR_PTR("request"), STR_LEN("request"), STR_PTR("tool_use_id"), STR_LEN("tool_use_id"), tuid_p, 128);
            if tuid_len > 0 {
                ev.has_toolUseId = true;
                ev.toolUseId_len = tuid_len;
                tp_buf_copy_buf(tuid_p, tuid_len, &ev.toolUseId);
            };
            events_push(events, &count, cap, &ev);
        };
        sa_json_free(doc);
        return count;
    };

    // default: return events;
    sa_json_free(doc);
    return count;
}

fn push_item_event(events: &[ProjectedEvent], count: &u64, cap: u64, kind_ptr: ptr, kind_len: u64, threadId: &ByteBuf, ctx: &ProjectorContext, item: &ByteBuf) -> void {
    let ev = ProjectedEvent { kind: [0u8; 64], kind_len: 0, threadId: [0u8; 128], threadId_len: 0, turnId: [0u8; 128], turnId_len: 0, externalSessionId: [0u8; 128], externalSessionId_len: 0, has_model: false, model: [0u8; 256], model_len: 0, has_cwd: false, cwd: [0u8; 1024], cwd_len: 0, has_error: false, error: [0u8; 4096], error_len: 0, itemId: [0u8; 512], itemId_len: 0, delta: [0u8; 262144], delta_len: 0, item_json: [0u8; 262144], item_json_len: 0, requestId: [0u8; 256], requestId_len: 0, toolName: [0u8; 256], toolName_len: 0, input_json: [0u8; 262144], input_json_len: 0, has_toolUseId: false, toolUseId: [0u8; 128], toolUseId_len: 0, has_version: false, version: [0u8; 64], version_len: 0, has_permissionMode: false, permissionMode: [0u8; 64], permissionMode_len: 0, json: [0u8; 262144], json_len: 0 };
    let cap_pe3: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_pe3, &threadId.bytes, 0);
    let cap_pt1: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_pt1, &ctx.turnId, 0);
    projected_event_new(kind_ptr, kind_len, cap_pe3, threadId.len, cap_pt1, ctx.turnId_len, &ev);
    ev.item_json_len = item.len;
    buf_copy_to(item, &ev.item_json);
    events_push(events, count, cap, &ev);
    return;
}

// (msg.uuid ?? ctx.turnId) prefix used by several itemId constructions.
// DEFECT: the ClaudeMessage union struct in claudeCompatibleProtocol.sla does not
// carry uuid (it lives on the concrete message structs); probed from raw JSON here.
fn append_uuid_or_turn(message: &ClaudeMessage, ctx: &ProjectorContext, out: &ByteBuf) -> void {
    let doc = sa_json_parse(&message.json, message.json_len);
    let uuid: [u8; 128] = [0u8; 128];
    let uuid_p: ptr = PTR_NULL(); PTR_BYTE_ADD(uuid_p, &uuid, 0);
    let uuid_len: u64 = 0;
    if doc != 0 {
        uuid_len = json_get_string_copy(doc, STR_PTR("uuid"), STR_LEN("uuid"), uuid_p, 128);
        sa_json_free(doc);
    };
    if uuid_len > 0 {
        buf_append_bytes(out, uuid_p, uuid_len);
        return;
    };
    let cap_ba6: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ba6, &ctx.turnId, 0);
    buf_append_bytes(out, cap_ba6, ctx.turnId_len);
    return;
}

fn message_uuid(message: &ClaudeMessage, out: &ByteBuf) -> bool {
    let doc = sa_json_parse(&message.json, message.json_len);
    if doc == 0 { return false; };
    let jgs_p16: ptr = PTR_NULL(); PTR_BYTE_ADD(jgs_p16, &out.bytes, 0);
    let n: u64 = json_get_string_copy(doc, STR_PTR("uuid"), STR_LEN("uuid"), jgs_p16, 128);
    sa_json_free(doc);
    out.len = n;
    return n > 0;
}

// Assistant "text" block projection (the big dedup/reconcile branch in TS).
fn project_assistant_text_block(ctx: &ProjectorContext, threadId: &ByteBuf, msg_id: &[u8], msg_id_len: u64, message: &ClaudeMessage, blockIndex: u64, btext: &ByteBuf, events: &[ProjectedEvent], count: &u64, cap: u64) -> void {
    // const streamedText = [...ctx.turn.streamedAssistantItems.values()].join("");
    let streamedText = ByteBuf { bytes: [0u8; 65536], len: 0 };
    strmap_join_values(&ctx.turn.streamedAssistantItems, &streamedText);
    // const stableStreamItemId = msg.message.id ? `${msg.message.id}-text-${blockIndex}` : undefined;
    let stableId = ByteBuf { bytes: [0u8; 65536], len: 0 };
    let has_stable: bool = msg_id_len > 0;
    if has_stable {
        let cap_ms1: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ms1, msg_id, 0);
        buf_append_bytes(&stableId, cap_ms1, msg_id_len);
        buf_append_lit(&stableId, STR_PTR("-text-"), STR_LEN("-text-"));
        tp_buf_append_u64(&stableId, blockIndex);
    };
    // const matchesStableStreamItem = Boolean(stableStreamItemId && ctx.turn.streamedAssistantItems.has(stableStreamItemId));
    let cap_sh501: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_sh501, &stableId.bytes, 0);
    let matches: bool = has_stable && strmap_has(&ctx.turn.streamedAssistantItems, cap_sh501, stableId.len);
    // if (matchesStableStreamItem) ctx.turn.streamedAssistantItems.set(stableStreamItemId!, block.text);
    if matches {
        let cap_sm1a: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_sm1a, &stableId.bytes, 0);
        let cap_sm1b: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_sm1b, &btext.bytes, 0);
        strmap_set(&ctx.turn.streamedAssistantItems, cap_sm1a, stableId.len, cap_sm1b, btext.len);
    };
    // if (matches || reconcileStreamedItem(...) || (normalize(streamedText) && normalize(streamedText).includes(normalize(block.text)))) continue;
    let skip: bool = matches;
    let cap_rc601: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_rc601, &btext.bytes, 0);
    if !(skip) { skip = reconcileStreamedItem(&ctx.turn.streamedAssistantItems, cap_rc601, btext.len); };
    if !(skip) {
        let nst = ByteBuf { bytes: [0u8; 65536], len: 0 };
        let cap_nat4: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_nat4, &streamedText.bytes, 0);
        normalizeAssistantText(cap_nat4, streamedText.len, &nst);
        let nbt = ByteBuf { bytes: [0u8; 65536], len: 0 };
        let cap_nat5: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_nat5, &btext.bytes, 0);
        normalizeAssistantText(cap_nat5, btext.len, &nbt);
        let cap_p77: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p77, &nbt.bytes, 0);
        if nst.len > 0 && buf_contains(&nst.bytes, nst.len, cap_p77, nbt.len) { skip = true; };
    };
    if skip { return; };
    // const itemId = (msg.uuid ?? ctx.turnId) + "-text-" + blockIndex;
    let itemId = ByteBuf { bytes: [0u8; 65536], len: 0 };
    append_uuid_or_turn(message, ctx, &itemId);
    buf_append_lit(&itemId, STR_PTR("-text-"), STR_LEN("-text-"));
    tp_buf_append_u64(&itemId, blockIndex);
    // if (!ctx.turn.assistantItemIds.has(itemId)) { add; push block; push item/completed agentMessage }
    let cap_ss303: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ss303, &itemId.bytes, 0);
    if !(strset_has(&ctx.turn.assistantItemIds, cap_ss303, itemId.len)) {
        let cap_ss304: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ss304, &itemId.bytes, 0);
        strset_add(&ctx.turn.assistantItemIds, cap_ss304, itemId.len);
        strlist_push_buf(&ctx.turn.assistantTextBlocks, &btext.bytes, btext.len);
        let item = ByteBuf { bytes: [0u8; 65536], len: 0 };
        let cap_bm404: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_bm404, &itemId.bytes, 0);
        let cap_bm405: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_bm405, &threadId.bytes, 0);
        let cap_bm406: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_bm406, &btext.bytes, 0);
        build_message_item(&item, false, cap_bm404, itemId.len, cap_bm405, threadId.len, cap_bm406, btext.len);
        push_item_event(events, count, cap, STR_PTR("item/completed"), STR_LEN("item/completed"), threadId, ctx, &item);
    };
    return;
}

// Assistant "thinking" block projection (symmetric to text; reasoning items).
fn project_assistant_thinking_block(ctx: &ProjectorContext, threadId: &ByteBuf, msg_id: &[u8], msg_id_len: u64, message: &ClaudeMessage, blockIndex: u64, bthink: &ByteBuf, events: &[ProjectedEvent], count: &u64, cap: u64) -> void {
    let streamedReasoning = ByteBuf { bytes: [0u8; 65536], len: 0 };
    strmap_join_values(&ctx.turn.streamedReasoningItems, &streamedReasoning);
    let stableId = ByteBuf { bytes: [0u8; 65536], len: 0 };
    let has_stable: bool = msg_id_len > 0;
    if has_stable {
        let cap_ms2: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ms2, msg_id, 0);
        buf_append_bytes(&stableId, cap_ms2, msg_id_len);
        buf_append_lit(&stableId, STR_PTR("-reasoning-"), STR_LEN("-reasoning-"));
        tp_buf_append_u64(&stableId, blockIndex);
    };
    let cap_sh502: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_sh502, &stableId.bytes, 0);
    let matches: bool = has_stable && strmap_has(&ctx.turn.streamedReasoningItems, cap_sh502, stableId.len);
    if matches {
        let cap_sm2a: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_sm2a, &stableId.bytes, 0);
        let cap_sm2b: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_sm2b, &bthink.bytes, 0);
        strmap_set(&ctx.turn.streamedReasoningItems, cap_sm2a, stableId.len, cap_sm2b, bthink.len);
    };
    let skip: bool = matches;
    let cap_rc602: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_rc602, &bthink.bytes, 0);
    if !(skip) { skip = reconcileStreamedItem(&ctx.turn.streamedReasoningItems, cap_rc602, bthink.len); };
    if !(skip) {
        let nst = ByteBuf { bytes: [0u8; 65536], len: 0 };
        let cap_nat6: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_nat6, &streamedReasoning.bytes, 0);
        normalizeAssistantText(cap_nat6, streamedReasoning.len, &nst);
        let nbt = ByteBuf { bytes: [0u8; 65536], len: 0 };
        let cap_nat7: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_nat7, &bthink.bytes, 0);
        normalizeAssistantText(cap_nat7, bthink.len, &nbt);
        let cap_p79: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p79, &nbt.bytes, 0);
        if nst.len > 0 && buf_contains(&nst.bytes, nst.len, cap_p79, nbt.len) { skip = true; };
    };
    if skip { return; };
    let itemId = ByteBuf { bytes: [0u8; 65536], len: 0 };
    append_uuid_or_turn(message, ctx, &itemId);
    buf_append_lit(&itemId, STR_PTR("-thinking-"), STR_LEN("-thinking-"));
    tp_buf_append_u64(&itemId, blockIndex);
    let cap_ss305: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ss305, &itemId.bytes, 0);
    if !(strset_has(&ctx.turn.assistantItemIds, cap_ss305, itemId.len)) {
        let cap_ss306: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ss306, &itemId.bytes, 0);
        strset_add(&ctx.turn.assistantItemIds, cap_ss306, itemId.len);
        let item = ByteBuf { bytes: [0u8; 65536], len: 0 };
        let cap_bm407: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_bm407, &itemId.bytes, 0);
        let cap_bm408: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_bm408, &threadId.bytes, 0);
        let cap_bm409: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_bm409, &bthink.bytes, 0);
        build_message_item(&item, true, cap_bm407, itemId.len, cap_bm408, threadId.len, cap_bm409, bthink.len);
        push_item_event(events, count, cap, STR_PTR("item/completed"), STR_LEN("item/completed"), threadId, ctx, &item);
    };
    return;
}

fn strmap_join_values(m: &StrMap, out: &ByteBuf) -> void {
    // [...map.values()].join("") — latest value per key under append-only storage
    // is approximated by concatenating all stored values in insertion order.
    // DEFECT: replaced values would double-count; acceptable bulk approximation.
    let off: u64 = 0;
    let i: u64 = 0;
    while i < m.vals.count {
        buf_append_bytes(out, PTR_ADD(m.vals.items, off), m.vals.lens[i]);
        off = off + m.vals.lens[i];
        i = i + 1;
    }
    return;
}

// User "tool_result" block projection.
fn project_tool_result_block(ctx: &ProjectorContext, doc: u64, blockIndex: u64, threadId: &ByteBuf, tuid: &[u8], tuid_len: u64, events: &[ProjectedEvent], count: &u64, cap: u64) -> void {
    // const existing = ctx.turn.toolItems.get(block.tool_use_id);
    let existing = ByteBuf { bytes: [0u8; 65536], len: 0 };
    let cap_tg1: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_tg1, tuid, 0);
    let has_existing: bool = toolItems_get_latest(ctx, cap_tg1, tuid_len, &existing);
    // const toolName = existing?.toolName ?? existing?.name ?? "Tool";
    // const toolArgs = existing?.arguments ?? existing?.input ?? {};
    let toolName = ByteBuf { bytes: [0u8; 65536], len: 0 };
    let toolArgs = ByteBuf { bytes: [0u8; 65536], len: 0 };
    if has_existing {
        let edoc = sa_json_parse(&existing.bytes, existing.len);
        if edoc != 0 {
            let jgs_p17: ptr = PTR_NULL(); PTR_BYTE_ADD(jgs_p17, &toolName.bytes, 0);
            toolName.len = json_get_string_copy(edoc, STR_PTR("toolName"), STR_LEN("toolName"), jgs_p17, 256);
            let jgs_p18: ptr = PTR_NULL(); PTR_BYTE_ADD(jgs_p18, &toolName.bytes, 0);
            if toolName.len == 0 { toolName.len = json_get_string_copy(edoc, STR_PTR("name"), STR_LEN("name"), jgs_p18, 256); };
            if !(tp_json_get_json_field(edoc, STR_PTR("arguments"), STR_LEN("arguments"), &toolArgs)) {
                if !(tp_json_get_json_field(edoc, STR_PTR("input"), STR_LEN("input"), &toolArgs)) {
                    buf_append_lit(&toolArgs, STR_PTR("{}"), STR_LEN("{}"));
                };
            };
            sa_json_free(edoc);
        };
    };
    if toolName.len == 0 { buf_append_lit(&toolName, STR_PTR("Tool"), STR_LEN("Tool")); };
    if toolArgs.len == 0 { buf_append_lit(&toolArgs, STR_PTR("{}"), STR_LEN("{}")); };
    // const item = { ...(existing ?? {}), type: "toolCall", id, threadId, turnId, name/tool/toolName, input, arguments, result: { content: block.content ?? "" }, status: is_error ? "failed" : "completed" };
    // DEFECT: object spread of the existing item approximated by rebuilding the
    // item from its probed fields (unknown extra fields of `existing` are lost).
    let content = ByteBuf { bytes: [0u8; 65536], len: 0 };
    if !(tp_json_content_block_json(doc, blockIndex, STR_PTR("content"), STR_LEN("content"), &content)) {
        buf_append_lit(&content, STR_PTR("\"\""), STR_LEN("\"\""));
    };
    let is_error: bool = tp_json_content_block_bool(doc, blockIndex, STR_PTR("is_error"), STR_LEN("is_error"));
    let status_ptr: ptr = STR_PTR("completed");
    let status_len: u64 = STR_LEN("completed");
    if is_error { status_ptr = STR_PTR("failed"); status_len = STR_LEN("failed"); };
    let item = ByteBuf { bytes: [0u8; 65536], len: 0 };
    buf_append_lit(&item, STR_PTR("{\"type\":\"toolCall\",\"id\":\""), STR_LEN("{\"type\":\"toolCall\",\"id\":\""));
    let cap_je20: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_je20, tuid, 0);
    json_escape_into(&item, cap_je20, tuid_len);
    buf_append_lit(&item, STR_PTR("\",\"threadId\":\""), STR_LEN("\",\"threadId\":\""));
    let cap_je7: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_je7, &threadId.bytes, 0);
    json_escape_into(&item, cap_je7, threadId.len);
    buf_append_lit(&item, STR_PTR("\",\"turnId\":\""), STR_LEN("\",\"turnId\":\""));
    let cap_je8: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_je8, &ctx.turnId, 0);
    json_escape_into(&item, cap_je8, ctx.turnId_len);
    buf_append_lit(&item, STR_PTR("\",\"name\":\""), STR_LEN("\",\"name\":\""));
    let cap_je9: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_je9, &toolName.bytes, 0);
    json_escape_into(&item, cap_je9, toolName.len);
    buf_append_lit(&item, STR_PTR("\",\"tool\":\""), STR_LEN("\",\"tool\":\""));
    let cap_je10: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_je10, &toolName.bytes, 0);
    json_escape_into(&item, cap_je10, toolName.len);
    buf_append_lit(&item, STR_PTR("\",\"toolName\":\""), STR_LEN("\",\"toolName\":\""));
    let cap_je11: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_je11, &toolName.bytes, 0);
    json_escape_into(&item, cap_je11, toolName.len);
    buf_append_lit(&item, STR_PTR("\",\"input\":"), STR_LEN("\",\"input\":"));
    let cap_p80: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p80, &toolArgs.bytes, 0);
    buf_append_bytes(&item, cap_p80, toolArgs.len);
    buf_append_lit(&item, STR_PTR(",\"arguments\":"), STR_LEN(",\"arguments\":"));
    let cap_p81: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p81, &toolArgs.bytes, 0);
    buf_append_bytes(&item, cap_p81, toolArgs.len);
    buf_append_lit(&item, STR_PTR(",\"result\":{\"content\":"), STR_LEN(",\"result\":{\"content\":"));
    let cap_p82: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p82, &content.bytes, 0);
    buf_append_bytes(&item, cap_p82, content.len);
    buf_append_lit(&item, STR_PTR("},\"status\":\""), STR_LEN("},\"status\":\""));
    buf_append_bytes(&item, status_ptr, status_len);
    buf_append_lit(&item, STR_PTR("\"}"), STR_LEN("\"}"));
    // ctx.turn.toolItems.set(block.tool_use_id, item);
    let cap_ts202: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ts202, &item.bytes, 0);
    let cap_tg2: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_tg2, tuid, 0);
    toolItems_set(ctx, cap_tg2, tuid_len, cap_ts202, item.len);
    push_item_event(events, count, cap, STR_PTR("item/completed"), STR_LEN("item/completed"), threadId, ctx, &item);
    return;
}

// stream_event case body.
// DEFECT: event.* nested field access via sa_json_event_* placeholder probes
// (event.content_block.*, event.delta.*, event.message.*).
fn project_stream_event(doc: u64, message: &ClaudeMessage, ctx: &ProjectorContext, events: &[ProjectedEvent], count: &u64, cap: u64) -> void {
    let threadId = ByteBuf { bytes: [0u8; 65536], len: 0 };
    let cap_rt6: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_rt6, &message.session_id, 0);
    resolveThread(ctx, message.has_session_id, cap_rt6, message.session_id_len, &threadId);
    // const event = msg.event;
    let etype: [u8; 64] = [0u8; 64];
    let etype_p: ptr = PTR_NULL(); PTR_BYTE_ADD(etype_p, &etype, 0);
    let etype_len: u64 = tp_json_get_nested_string(doc, STR_PTR("event"), STR_LEN("event"), STR_PTR("type"), STR_LEN("type"), etype_p, 64);
    let ev_msg_id: [u8; 128] = [0u8; 128];
    let ev_msg_id_p: ptr = PTR_NULL(); PTR_BYTE_ADD(ev_msg_id_p, &ev_msg_id, 0);
    let ev_msg_id_len: u64 = tp_json_event_message_string(doc, STR_PTR("id"), STR_LEN("id"), ev_msg_id_p, 128);
    // if (event.type === "message_start" && event.message?.id) ctx.turn.streamMessageId = event.message.id;
    // else if (!ctx.turn.streamMessageId && msg.uuid) ctx.turn.streamMessageId = msg.uuid;
    if bytes_eq_buf(etype_p, etype_len, STR_PTR("message_start"), STR_LEN("message_start")) && ev_msg_id_len > 0 {
        ctx.turn.has_streamMessageId = true;
        ctx.turn.streamMessageId_len = ev_msg_id_len;
        tp_buf_copy_buf(ev_msg_id_p, ev_msg_id_len, &ctx.turn.streamMessageId);
    } else if !(ctx.turn.has_streamMessageId) {
        let uuid = ByteBuf { bytes: [0u8; 65536], len: 0 };
        if message_uuid(message, &uuid) {
            ctx.turn.has_streamMessageId = true;
            ctx.turn.streamMessageId_len = uuid.len;
            buf_copy_to(&uuid, &ctx.turn.streamMessageId);
        };
    };
    // const blockIndex = typeof event.index === "number" && Number.isFinite(event.index) ? event.index : 0;
    let blockIndex: u64 = 0;
    let idx_val: i64 = 0;
    if tp_json_get_nested_number(doc, STR_PTR("event"), STR_LEN("event"), STR_PTR("index"), STR_LEN("index"), &idx_val) {
        if idx_val >= 0 { blockIndex = idx_val; };
    };
    if bytes_eq_buf(etype_p, etype_len, STR_PTR("content_block_start"), STR_LEN("content_block_start")) {
        project_content_block_start(doc, ctx, &threadId, blockIndex, &ev_msg_id, ev_msg_id_len, events, count, cap);
        return;
    };
    if bytes_eq_buf(etype_p, etype_len, STR_PTR("content_block_delta"), STR_LEN("content_block_delta")) {
        project_content_block_delta(doc, ctx, &threadId, blockIndex, &ev_msg_id, ev_msg_id_len, events, count, cap);
        return;
    };
    return;
}

fn push_delta_event(ctx: &ProjectorContext, threadId: &ByteBuf, is_reasoning: bool, itemId: &ByteBuf, text: &ByteBuf, events: &[ProjectedEvent], count: &u64, cap: u64) -> void {
    // Append text to the streamed items map: items.set(itemId, `${items.get(itemId) ?? ""}${text}`)
    let map_ptr: u64 = 0;
    let existing = ByteBuf { bytes: [0u8; 65536], len: 0 };
    if is_reasoning {
        let cap_sg701: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_sg701, &itemId.bytes, 0);
        strmap_get_latest(&ctx.turn.streamedReasoningItems, cap_sg701, itemId.len, &existing);
        let cap_p83: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p83, &text.bytes, 0);
        buf_append_bytes(&existing, cap_p83, text.len);
        let cap_sm3a: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_sm3a, &itemId.bytes, 0);
        let cap_sm3b: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_sm3b, &existing.bytes, 0);
        strmap_set(&ctx.turn.streamedReasoningItems, cap_sm3a, itemId.len, cap_sm3b, existing.len);
    } else {
        let cap_sg702: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_sg702, &itemId.bytes, 0);
        strmap_get_latest(&ctx.turn.streamedAssistantItems, cap_sg702, itemId.len, &existing);
        let cap_p84: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p84, &text.bytes, 0);
        buf_append_bytes(&existing, cap_p84, text.len);
        let cap_sm4a: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_sm4a, &itemId.bytes, 0);
        let cap_sm4b: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_sm4b, &existing.bytes, 0);
        strmap_set(&ctx.turn.streamedAssistantItems, cap_sm4a, itemId.len, cap_sm4b, existing.len);
    };
    // events.push({ kind: channel === "reasoning" ? "item/reasoning/textDelta" : "item/agentMessage/delta", threadId, turnId, itemId, delta: text })
    let ev = ProjectedEvent { kind: [0u8; 64], kind_len: 0, threadId: [0u8; 128], threadId_len: 0, turnId: [0u8; 128], turnId_len: 0, externalSessionId: [0u8; 128], externalSessionId_len: 0, has_model: false, model: [0u8; 256], model_len: 0, has_cwd: false, cwd: [0u8; 1024], cwd_len: 0, has_error: false, error: [0u8; 4096], error_len: 0, itemId: [0u8; 512], itemId_len: 0, delta: [0u8; 262144], delta_len: 0, item_json: [0u8; 262144], item_json_len: 0, requestId: [0u8; 256], requestId_len: 0, toolName: [0u8; 256], toolName_len: 0, input_json: [0u8; 262144], input_json_len: 0, has_toolUseId: false, toolUseId: [0u8; 128], toolUseId_len: 0, has_version: false, version: [0u8; 64], version_len: 0, has_permissionMode: false, permissionMode: [0u8; 64], permissionMode_len: 0, json: [0u8; 262144], json_len: 0 };
    if is_reasoning {
        let cap_pe4: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_pe4, &threadId.bytes, 0);
        let cap_pt103: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_pt103, &ctx.turnId, 0);
        projected_event_new(STR_PTR("item/reasoning/textDelta"), STR_LEN("item/reasoning/textDelta"), cap_pe4, threadId.len, cap_pt103, ctx.turnId_len, &ev);
    } else {
        let cap_pe5: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_pe5, &threadId.bytes, 0);
        let cap_pt104: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_pt104, &ctx.turnId, 0);
        projected_event_new(STR_PTR("item/agentMessage/delta"), STR_LEN("item/agentMessage/delta"), cap_pe5, threadId.len, cap_pt104, ctx.turnId_len, &ev);
    };
    ev.itemId_len = itemId.len;
    buf_copy_to(itemId, &ev.itemId);
    ev.delta_len = text.len;
    buf_copy_to(text, &ev.delta);
    events_push(events, count, cap, &ev);
    return;
}

fn project_content_block_start(doc: u64, ctx: &ProjectorContext, threadId: &ByteBuf, blockIndex: u64, ev_msg_id: &[u8], ev_msg_id_len: u64, events: &[ProjectedEvent], count: &u64, cap: u64) -> void {
    // const cb = event.content_block;
    let cbtype: [u8; 64] = [0u8; 64];
    let cbtype_p: ptr = PTR_NULL(); PTR_BYTE_ADD(cbtype_p, &cbtype, 0);
    let cbtype_len: u64 = tp_json_event_block_string(doc, STR_PTR("type"), STR_LEN("type"), cbtype_p, 64);
    // const channel = cb?.type === "thinking" ? "reasoning" : cb?.type === "text" ? "text" : undefined;
    let channel: u64 = 0; // 0 none, 1 text, 2 reasoning
    if bytes_eq_buf(cbtype_p, cbtype_len, STR_PTR("thinking"), STR_LEN("thinking")) { channel = 2; };
    if bytes_eq_buf(cbtype_p, cbtype_len, STR_PTR("text"), STR_LEN("text")) { channel = 1; };
    // const text = typeof cb?.text === "string" ? cb.text : typeof cb?.thinking === "string" ? cb.thinking : "";
    let text = ByteBuf { bytes: [0u8; 65536], len: 0 };
    if tp_json_event_block_has(doc, STR_PTR("text"), STR_LEN("text")) {
        let cap_td4: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_td4, &text.bytes, 0);
        text.len = tp_json_event_block_string(doc, STR_PTR("text"), STR_LEN("text"), cap_td4, 262144);
    } else if tp_json_event_block_has(doc, STR_PTR("thinking"), STR_LEN("thinking")) {
        let cap_td5: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_td5, &text.bytes, 0);
        text.len = tp_json_event_block_string(doc, STR_PTR("thinking"), STR_LEN("thinking"), cap_td5, 262144);
    };
    // if (cb?.type === "tool_use" && typeof cb.id === "string" && typeof cb.name === "string" && cb.name !== "Agent" && cb.name !== "Task")
    if bytes_eq_buf(cbtype_p, cbtype_len, STR_PTR("tool_use"), STR_LEN("tool_use")) {
        let cbid: [u8; 128] = [0u8; 128];
        let cbid_p: ptr = PTR_NULL(); PTR_BYTE_ADD(cbid_p, &cbid, 0);
        let cbid_len: u64 = tp_json_event_block_string(doc, STR_PTR("id"), STR_LEN("id"), cbid_p, 128);
        let cbname: [u8; 256] = [0u8; 256];
        let cbname_p: ptr = PTR_NULL(); PTR_BYTE_ADD(cbname_p, &cbname, 0);
        let cbname_len: u64 = tp_json_event_block_string(doc, STR_PTR("name"), STR_LEN("name"), cbname_p, 256);
        let name_ok: bool = cbname_len > 0 && !(bytes_eq_buf(cbname_p, cbname_len, STR_PTR("Agent"), STR_LEN("Agent"))) && !(bytes_eq_buf(cbname_p, cbname_len, STR_PTR("Task"), STR_LEN("Task")));
        if cbid_len > 0 && name_ok && blockIndex < 64 {
            // const toolBlock = { id: cb.id, name: cb.name, argumentsJson: "", initialInput: (cb.input ?? {}) };
            let tb = &ctx.turn.streamToolBlocks[blockIndex];
            tb.occupied = true;
            tb.id_len = cbid_len;
            tp_buf_copy_buf(cbid_p, cbid_len, &tb.id);
            tb.name_len = cbname_len;
            tp_buf_copy_buf(cbname_p, cbname_len, &tb.name);
            tb.argumentsJson_len = 0;
            tb.initialInput_json_len = 0;
            let init_input = ByteBuf { bytes: [0u8; 65536], len: 0 };
            if !(tp_json_event_block_json(doc, STR_PTR("input"), STR_LEN("input"), &init_input)) {
                buf_append_lit(&init_input, STR_PTR("{}"), STR_LEN("{}"));
            };
            tb.initialInput_json_len = init_input.len;
            buf_copy_to(&init_input, &tb.initialInput_json);
            // const startArgs = streamedToolArguments(toolBlock); item started; toolItems.set
            let startArgs = ByteBuf { bytes: [0u8; 65536], len: 0 };
            streamedToolArguments(tb, &startArgs);
            let item = ByteBuf { bytes: [0u8; 65536], len: 0 };
            let cap_bt4: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_bt4, &threadId.bytes, 0);
            let cap_bt5: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_bt5, &ctx.turnId, 0);
            let cap_bt6: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_bt6, &startArgs.bytes, 0);
            build_tool_item(&item, cbid_p, cbid_len, cap_bt4, threadId.len, cap_bt5, ctx.turnId_len, cbname_p, cbname_len, cap_bt6, startArgs.len, STR_PTR("inProgress"), STR_LEN("inProgress"));
            let cap_ts203: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ts203, &item.bytes, 0);
            toolItems_set(ctx, cbid_p, cbid_len, cap_ts203, item.len);
            push_item_event(events, count, cap, STR_PTR("item/started"), STR_LEN("item/started"), threadId, ctx, &item);
        };
    };
    // if (channel && text.length > 0) { itemId = ...; items.set(...); events.push(delta) }
    if channel != 0 && text.len > 0 {
        let itemId = ByteBuf { bytes: [0u8; 65536], len: 0 };
        if ctx.turn.has_streamMessageId {
            let cap_ba7: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ba7, &ctx.turn.streamMessageId, 0);
            buf_append_bytes(&itemId, cap_ba7, ctx.turn.streamMessageId_len);
        } else if ev_msg_id_len > 0 {
            let cap_em1: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_em1, ev_msg_id, 0);
            buf_append_bytes(&itemId, cap_em1, ev_msg_id_len);
        } else {
            let cap_ba8: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ba8, &ctx.turnId, 0);
            buf_append_bytes(&itemId, cap_ba8, ctx.turnId_len);
        };
        if channel == 2 { buf_append_lit(&itemId, STR_PTR("-reasoning-"), STR_LEN("-reasoning-")); } else { buf_append_lit(&itemId, STR_PTR("-text-"), STR_LEN("-text-")); };
        tp_buf_append_u64(&itemId, blockIndex);
        push_delta_event(ctx, threadId, channel == 2, &itemId, &text, events, count, cap);
    };
    return;
}

fn project_content_block_delta(doc: u64, ctx: &ProjectorContext, threadId: &ByteBuf, blockIndex: u64, ev_msg_id: &[u8], ev_msg_id_len: u64, events: &[ProjectedEvent], count: &u64, cap: u64) -> void {
    // const delta = event.delta;
    let dtype: [u8; 64] = [0u8; 64];
    let dtype_p: ptr = PTR_NULL(); PTR_BYTE_ADD(dtype_p, &dtype, 0);
    let dtype_len: u64 = tp_json_event_delta_string(doc, STR_PTR("type"), STR_LEN("type"), dtype_p, 64);
    // if (delta?.type === "input_json_delta" && typeof delta.partial_json === "string")
    if bytes_eq_buf(dtype_p, dtype_len, STR_PTR("input_json_delta"), STR_LEN("input_json_delta")) && tp_json_event_delta_has(doc, STR_PTR("partial_json"), STR_LEN("partial_json")) {
        let partial = ByteBuf { bytes: [0u8; 65536], len: 0 };
        let cap_td6: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_td6, &partial.bytes, 0);
        partial.len = tp_json_event_delta_string(doc, STR_PTR("partial_json"), STR_LEN("partial_json"), cap_td6, 262144);
        // const toolBlock = ctx.turn.streamToolBlocks.get(blockIndex); if (toolBlock) { toolBlock.argumentsJson += partial; ... push item/started }
        if blockIndex < 64 && ctx.turn.streamToolBlocks[blockIndex].occupied {
            let tb = &ctx.turn.streamToolBlocks[blockIndex];
            let i: u64 = 0;
            while i < partial.len { tb.argumentsJson[tb.argumentsJson_len + i] = partial.bytes[i]; i = i + 1; }
            tb.argumentsJson_len = tb.argumentsJson_len + partial.len;
            let deltaArgs = ByteBuf { bytes: [0u8; 65536], len: 0 };
            streamedToolArguments(tb, &deltaArgs);
            let item = ByteBuf { bytes: [0u8; 65536], len: 0 };
            let cap_bt7: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_bt7, &tb.id, 0);
            let cap_bt8: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_bt8, &threadId.bytes, 0);
            let cap_bt9: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_bt9, &ctx.turnId, 0);
            let cap_bt10: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_bt10, &tb.name, 0);
            let cap_bt11: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_bt11, &deltaArgs.bytes, 0);
            build_tool_item(&item, cap_bt7, tb.id_len, cap_bt8, threadId.len, cap_bt9, ctx.turnId_len, cap_bt10, tb.name_len, cap_bt11, deltaArgs.len, STR_PTR("inProgress"), STR_LEN("inProgress"));
            let cap_ts204: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ts204, &tb.id, 0);
            let cap_ts205: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ts205, &item.bytes, 0);
            toolItems_set(ctx, cap_ts204, tb.id_len, cap_ts205, item.len);
            push_item_event(events, count, cap, STR_PTR("item/started"), STR_LEN("item/started"), threadId, ctx, &item);
        };
    };
    // const channel = delta?.type === "thinking_delta" || typeof delta?.thinking === "string" ? "reasoning" : typeof delta?.text === "string" || delta?.type === "text_delta" ? "text" : undefined;
    let channel: u64 = 0;
    let has_thinking: bool = tp_json_event_delta_has(doc, STR_PTR("thinking"), STR_LEN("thinking"));
    let has_text: bool = tp_json_event_delta_has(doc, STR_PTR("text"), STR_LEN("text"));
    if bytes_eq_buf(dtype_p, dtype_len, STR_PTR("thinking_delta"), STR_LEN("thinking_delta")) || has_thinking { channel = 2; }
    else if has_text || bytes_eq_buf(dtype_p, dtype_len, STR_PTR("text_delta"), STR_LEN("text_delta")) { channel = 1; };
    // const text = channel === "reasoning" ? (typeof delta?.thinking === "string" ? delta.thinking : "") : (typeof delta?.text === "string" ? delta.text : "");
    let text = ByteBuf { bytes: [0u8; 65536], len: 0 };
    let cap_td7: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_td7, &text.bytes, 0);
    if channel == 2 && has_thinking { text.len = tp_json_event_delta_string(doc, STR_PTR("thinking"), STR_LEN("thinking"), cap_td7, 262144); };
    let cap_td8: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_td8, &text.bytes, 0);
    if channel == 1 && has_text { text.len = tp_json_event_delta_string(doc, STR_PTR("text"), STR_LEN("text"), cap_td8, 262144); };
    if channel != 0 && text.len > 0 {
        let itemId = ByteBuf { bytes: [0u8; 65536], len: 0 };
        if ctx.turn.has_streamMessageId {
            let cap_ba9: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ba9, &ctx.turn.streamMessageId, 0);
            buf_append_bytes(&itemId, cap_ba9, ctx.turn.streamMessageId_len);
        } else if ev_msg_id_len > 0 {
            let cap_em2: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_em2, ev_msg_id, 0);
            buf_append_bytes(&itemId, cap_em2, ev_msg_id_len);
        } else {
            let cap_ba10: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ba10, &ctx.turnId, 0);
            buf_append_bytes(&itemId, cap_ba10, ctx.turnId_len);
        };
        if channel == 2 { buf_append_lit(&itemId, STR_PTR("-reasoning-"), STR_LEN("-reasoning-")); } else { buf_append_lit(&itemId, STR_PTR("-text-"), STR_LEN("-text-")); };
        tp_buf_append_u64(&itemId, blockIndex);
        push_delta_event(ctx, threadId, channel == 2, &itemId, &text, events, count, cap);
    };
    return;
}

// result case body.
fn project_result_message(doc: u64, message: &ClaudeMessage, ctx: &ProjectorContext, events: &[ProjectedEvent], count: &u64, cap: u64) -> void {
    let threadId = ByteBuf { bytes: [0u8; 65536], len: 0 };
    let cap_rt7: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_rt7, &message.session_id, 0);
    resolveThread(ctx, message.has_session_id, cap_rt7, message.session_id_len, &threadId);
    // const isError = msg.is_error === true || msg.subtype !== "success";
    let isError: bool = tp_json_get_bool(doc, STR_PTR("is_error"), STR_LEN("is_error"));
    let subtype: [u8; 64] = [0u8; 64];
    let subtype_p: ptr = PTR_NULL(); PTR_BYTE_ADD(subtype_p, &subtype, 0);
    let subtype_len: u64 = json_get_string_copy(doc, STR_PTR("subtype"), STR_LEN("subtype"), subtype_p, 64);
    if !(bytes_eq_buf(subtype_p, subtype_len, STR_PTR("success"), STR_LEN("success"))) { isError = true; };
    // for (const [itemId, text] of ctx.turn.streamedReasoningItems) { flush as reasoning item/completed }
    flush_streamed_items(ctx, &threadId, true, events, count, cap);
    // for (const [itemId, text] of ctx.turn.streamedAssistantItems) { flush as agentMessage item/completed + assistantTextBlocks.push }
    flush_streamed_items(ctx, &threadId, false, events, count, cap);
    // if (typeof msg.result === "string" && msg.result.length > 0) { ... }
    let result = ByteBuf { bytes: [0u8; 65536], len: 0 };
    let jgs_p19: ptr = PTR_NULL(); PTR_BYTE_ADD(jgs_p19, &result.bytes, 0);
    result.len = json_get_string_copy(doc, STR_PTR("result"), STR_LEN("result"), jgs_p19, 262144);
    if result.len > 0 {
        // const resultItemId = "result-" + (msg.session_id ?? ctx.turnId);
        let resultItemId = ByteBuf { bytes: [0u8; 65536], len: 0 };
        buf_append_lit(&resultItemId, STR_PTR("result-"), STR_LEN("result-"));
        let cap_p85: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p85, &message.session_id, 0);
        let cap_ba11: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ba11, &ctx.turnId, 0);
        if message.has_session_id { buf_append_bytes(&resultItemId, cap_p85, message.session_id_len); } else { buf_append_bytes(&resultItemId, cap_ba11, ctx.turnId_len); };
        let normalizedResult = ByteBuf { bytes: [0u8; 65536], len: 0 };
        let cap_nat8: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_nat8, &result.bytes, 0);
        normalizeAssistantText(cap_nat8, result.len, &normalizedResult);
        let cap_ss307: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ss307, &resultItemId.bytes, 0);
        let cap_ar1: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ar1, &normalizedResult.bytes, 0);
        if !(strset_has(&ctx.turn.assistantItemIds, cap_ss307, resultItemId.len)) && !(assistantResultAlreadyProjected(&ctx.turn.assistantTextBlocks, cap_ar1, normalizedResult.len)) {
            let cap_ss308: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ss308, &resultItemId.bytes, 0);
            strset_add(&ctx.turn.assistantItemIds, cap_ss308, resultItemId.len);
            strlist_push_buf(&ctx.turn.assistantTextBlocks, &result.bytes, result.len);
            let item = ByteBuf { bytes: [0u8; 65536], len: 0 };
            let cap_bm410: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_bm410, &resultItemId.bytes, 0);
            let cap_bm411: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_bm411, &threadId.bytes, 0);
            let cap_bm412: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_bm412, &result.bytes, 0);
            build_message_item(&item, false, cap_bm410, resultItemId.len, cap_bm411, threadId.len, cap_bm412, result.len);
            push_item_event(events, count, cap, STR_PTR("item/completed"), STR_LEN("item/completed"), &threadId, ctx, &item);
        };
    };
    // if (markTerminal(ctx, isError ? "failed" : "completed")) events.push({ kind, threadId, turnId, ...(isError && msg.errors?.length ? { error: msg.errors[0] } : {}) });
    let status: u64 = TURN_STATUS_COMPLETED;
    if isError { status = TURN_STATUS_FAILED; };
    if markTerminal(ctx, status) {
        let ev = ProjectedEvent { kind: [0u8; 64], kind_len: 0, threadId: [0u8; 128], threadId_len: 0, turnId: [0u8; 128], turnId_len: 0, externalSessionId: [0u8; 128], externalSessionId_len: 0, has_model: false, model: [0u8; 256], model_len: 0, has_cwd: false, cwd: [0u8; 1024], cwd_len: 0, has_error: false, error: [0u8; 4096], error_len: 0, itemId: [0u8; 512], itemId_len: 0, delta: [0u8; 262144], delta_len: 0, item_json: [0u8; 262144], item_json_len: 0, requestId: [0u8; 256], requestId_len: 0, toolName: [0u8; 256], toolName_len: 0, input_json: [0u8; 262144], input_json_len: 0, has_toolUseId: false, toolUseId: [0u8; 128], toolUseId_len: 0, has_version: false, version: [0u8; 64], version_len: 0, has_permissionMode: false, permissionMode: [0u8; 64], permissionMode_len: 0, json: [0u8; 262144], json_len: 0 };
        if isError {
            let cap_pe6: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_pe6, &threadId.bytes, 0);
            let cap_pt105: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_pt105, &ctx.turnId, 0);
            projected_event_new(STR_PTR("turn/failed"), STR_LEN("turn/failed"), cap_pe6, threadId.len, cap_pt105, ctx.turnId_len, &ev);
            // msg.errors && msg.errors.length > 0 -> error: msg.errors[0]
            let err_count: u64 = tp_json_errors_count(doc);
            if err_count > 0 {
                ev.has_error = true;
                let cap_td9: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_td9, &ev.error, 0);
                ev.error_len = tp_json_errors_get(doc, 0, cap_td9, 4096);
            };
        } else {
            let cap_pe7: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_pe7, &threadId.bytes, 0);
            let cap_pt106: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_pt106, &ctx.turnId, 0);
            projected_event_new(STR_PTR("turn/completed"), STR_LEN("turn/completed"), cap_pe7, threadId.len, cap_pt106, ctx.turnId_len, &ev);
        };
        events_push(events, count, cap, &ev);
    };
    return;
}

fn flush_streamed_items(ctx: &ProjectorContext, threadId: &ByteBuf, is_reasoning: bool, events: &[ProjectedEvent], count: &u64, cap: u64) -> void {
    // for (const [itemId, text] of items) { if (!text || assistantItemIds.has(itemId)) continue; add; [assistant only: assistantTextBlocks.push(text)]; push item/completed }
    // DEFECT: iteration over the Map uses unique keys (latest value per key) —
    // approximated by scanning stored pairs and skipping shadowed duplicates.
    let keys = &ctx.turn.streamedAssistantItems.keys;
    let vals = &ctx.turn.streamedAssistantItems.vals;
    if is_reasoning {
        keys = &ctx.turn.streamedReasoningItems.keys;
        vals = &ctx.turn.streamedReasoningItems.vals;
    };
    let koff: u64 = 0;
    let voff: u64 = 0;
    let i: u64 = 0;
    while i < keys.count {
        let klen: u64 = keys.lens[i];
        let vlen: u64 = vals.lens[i];
        if vlen > 0 && !(strset_has(&ctx.turn.assistantItemIds, PTR_ADD(keys.items, koff), klen)) {
            strset_add(&ctx.turn.assistantItemIds, PTR_ADD(keys.items, koff), klen);
            if !(is_reasoning) {
                strlist_push(&ctx.turn.assistantTextBlocks, PTR_ADD(vals.items, voff), vlen);
            };
            let item = ByteBuf { bytes: [0u8; 65536], len: 0 };
            let cap_bm413: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_bm413, &threadId.bytes, 0);
            build_message_item(&item, is_reasoning, PTR_ADD(keys.items, koff), klen, cap_bm413, threadId.len, PTR_ADD(vals.items, voff), vlen);
            push_item_event(events, count, cap, STR_PTR("item/completed"), STR_LEN("item/completed"), threadId, ctx, &item);
        };
        koff = koff + klen;
        voff = voff + vlen;
        i = i + 1;
    }
    return;
}

// Force-terminate the turn (e.g., when the CLI process exits unexpectedly).
// Returns a terminal event if the turn was still running (has_out mirrors TS null).
fn forceTerminate(ctx: &ProjectorContext, error_ptr: ptr, error_len: u64, out: &ProjectedEvent, has_out: &bool) -> void {
    *has_out = false;
    // if (markTerminal(ctx, "failed")) return { kind: "turn/failed", threadId, turnId, ...(error ? { error } : {}) };
    if markTerminal(ctx, TURN_STATUS_FAILED) {
        let cap_pt107: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_pt107, &ctx.turnId, 0);
        let cap_mi2: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_mi2, &ctx.threadId, 0);
        projected_event_new(STR_PTR("turn/failed"), STR_LEN("turn/failed"), cap_mi2, ctx.threadId_len, cap_pt107, ctx.turnId_len, out);
        if error_len > 0 {
            out.has_error = true;
            out.error_len = error_len;
            buf_copy_ptr_to(error_ptr, error_len, &out.error);
        };
        *has_out = true;
    };
    return;
}

// Mark the turn as interrupted (e.g., when the user sends turn/interrupt).
fn markInterrupted(ctx: &ProjectorContext, out: &ProjectedEvent, has_out: &bool) -> void {
    *has_out = false;
    if markTerminal(ctx, TURN_STATUS_INTERRUPTED) {
        let cap_pt108: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_pt108, &ctx.turnId, 0);
        let cap_mi1: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_mi1, &ctx.threadId, 0);
        projected_event_new(STR_PTR("turn/interrupted"), STR_LEN("turn/interrupted"), cap_mi1, ctx.threadId_len, cap_pt108, ctx.turnId_len, out);
        *has_out = true;
    };
    return;
}
