// Converted 1:1 from backends/claude/src/runtime/claudeCompatibleTurnProjector.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "sa_std/string.sa"
@import "sa_std/ptr.sa"
@import "sa_std/encoding/json.sai"
@import "claudeCompatibleProtocol.sla"
@import "claudeCompatibleProbe.sla" // FIX: shared ByteBuf/buf_* prelude lives in the probe (unit hub)



// DEFECT: @codex-ui/shared JsonValue/JsonRpcNotification are dynamic JSON;
// notifications and item payloads are JSON text buffers here.
// DEFECT: ProjectedEvent is a discriminated union of 11 object shapes in TS;
// approximated as one struct with kind tag + all variant fields + has_* flags.
// DEFECT: TurnState uses Set<string> and Map<string, *> — approximated by
// StrList-as-set and StrMap (parallel key/value StrLists) with linear lookup.
// DEFECT: sa_std JSON surface has no nested-object/array accessors; the
// sa_json_* probes used below for message content blocks and stream_event
// fields are placeholders for that missing surface.

// String map (TS Map<string, string>): parallel key/value lists.
struct StrMap {
    keys: StrList,
    vals: StrList,
}

// FIX(be2): buf_copy_buf was called but only defined in claudeCompatibleRuntime.sla,
// which is not imported here (and itself imports this file, so a same-name
// definition would collide in its closure). TP-local copy, same semantics
// as the Runtime definition: byte copy src[0..src_len) into dst array.
// FIX(be2): the sa_json_* event/message accessors called in this file were
// fabricated (defined nowhere in sa_std or this tree). TP-local implementations
// over the real json.sai surface follow. Navigation paths follow the TS
// shapes: message.content[] (assistant lines), event.content_block /
// event.delta / event.message (stream_event lines), errors[] (result lines).
// String copies clamp to the caller cap and return the copied length (the
// Probe hub's json_get_string_copy pattern).
fn tp_json_nav(doc: u64, key_ptr: ptr, key_len: u64, out: &u64) -> bool {
    let h: u64 = 0;
    if sa_json_object_get(doc, key_ptr, key_len, &h) != 0 { return false; };
    *out = h;
    return true;
}

fn tp_json_nav2(doc: u64, k1_ptr: ptr, k1_len: u64, k2_ptr: ptr, k2_len: u64, out: &u64) -> bool {
    let mid: u64 = 0;
    if !tp_json_nav(doc, k1_ptr, k1_len, &mid) { return false; };
    return tp_json_nav(mid, k2_ptr, k2_len, out);
}

fn tp_json_str_field(node: u64, key_ptr: ptr, key_len: u64, dst: ptr, cap: u64) -> u64 {
    let sp: ptr = PTR_NULL();
    let sl: u64 = 0;
    if sa_json_object_get_string(node, key_ptr, key_len, &sp, &sl) != 0 { return 0; };
    let n = sl;
    if n > cap { n = cap; };
    let i: u64 = 0;
    while i < n {
        let v: u8 = 0;
        PTR_BYTE_AT(v, sp, i);
        let wp: ptr = PTR_NULL();
        PTR_BYTE_ADD(wp, dst, i);
        PTR_WRITE_U8(wp, v);
        i = i + 1;
    }
    return n;
}

fn tp_json_str_node(node: u64, dst: ptr, cap: u64) -> u64 {
    if sa_json_kind(node) != 5 { return 0; };
    let sp: ptr = sa_json_string_ptr(node);
    let sl: u64 = sa_json_string_len(node);
    let n = sl;
    if n > cap { n = cap; };
    let i: u64 = 0;
    while i < n {
        let v: u8 = 0;
        PTR_BYTE_AT(v, sp, i);
        let wp: ptr = PTR_NULL();
        PTR_BYTE_ADD(wp, dst, i);
        PTR_WRITE_U8(wp, v);
        i = i + 1;
    }
    return n;
}

fn tp_json_into_buf(node: u64, out: &ByteBuf) -> bool {
    let hb: u64 = 0;
    if sa_json_stringify(node, &hb) != 0 { return false; };
    // NOTE: the stringify buffer is deliberately not freed (same documented
    // leak class as FIX_SAVMTOOL's json_text buffers).
    let dp: ptr = sa_json_buffer_data(hb);
    let dl: u64 = sa_json_buffer_len(hb);
    let n = dl;
    if n > 65536 { n = 65536; };
    let i: u64 = 0;
    while i < n {
        let v: u8 = 0;
        PTR_BYTE_AT(v, dp, i);
        out.bytes[i] = v;
        i = i + 1;
    }
    out.len = n;
    return true;
}

fn tp_json_msg_block(doc: u64, idx: u64, out: &u64) -> bool {
    let msg: u64 = 0;
    if !tp_json_nav(doc, STR_PTR("message"), STR_LEN("message"), &msg) { return false; };
    let content: u64 = 0;
    if !tp_json_nav(msg, STR_PTR("content"), STR_LEN("content"), &content) { return false; };
    if sa_json_kind(content) != 6 { return false; };
    let blk: u64 = 0;
    if sa_json_array_get(content, idx, &blk) != 0 { return false; };
    *out = blk;
    return true;
}

fn tp_json_event_sub(doc: u64, sub_ptr: ptr, sub_len: u64, out: &u64) -> bool {
    let ev: u64 = 0;
    if !tp_json_nav(doc, STR_PTR("event"), STR_LEN("event"), &ev) { return false; };
    return tp_json_nav(ev, sub_ptr, sub_len, out);
}

fn tp_json_get_bool(doc: u64, key_ptr: ptr, key_len: u64) -> bool {
    let v: u8 = 0;
    if sa_json_object_get_bool(doc, key_ptr, key_len, &v) != 0 { return false; };
    return v != 0;
}

fn tp_json_get_json_field(doc: u64, key_ptr: ptr, key_len: u64, out: &ByteBuf) -> bool {
    let h: u64 = 0;
    if !tp_json_nav(doc, key_ptr, key_len, &h) { return false; };
    return tp_json_into_buf(h, out);
}

fn tp_json_get_nested_string(doc: u64, k1_ptr: ptr, k1_len: u64, k2_ptr: ptr, k2_len: u64, dst: ptr, cap: u64) -> u64 {
    let mid: u64 = 0;
    if !tp_json_nav(doc, k1_ptr, k1_len, &mid) { return 0; };
    return tp_json_str_field(mid, k2_ptr, k2_len, dst, cap);
}

fn tp_json_get_nested_has(doc: u64, k1_ptr: ptr, k1_len: u64, k2_ptr: ptr, k2_len: u64) -> bool {
    let h: u64 = 0;
    return tp_json_nav2(doc, k1_ptr, k1_len, k2_ptr, k2_len, &h);
}

fn tp_json_get_nested_json(doc: u64, k1_ptr: ptr, k1_len: u64, k2_ptr: ptr, k2_len: u64, out: &ByteBuf) -> bool {
    let h: u64 = 0;
    if !tp_json_nav2(doc, k1_ptr, k1_len, k2_ptr, k2_len, &h) { return false; };
    return tp_json_into_buf(h, out);
}

fn tp_json_get_nested_number(doc: u64, k1_ptr: ptr, k1_len: u64, k2_ptr: ptr, k2_len: u64, out: &i64) -> bool {
    let mid: u64 = 0;
    if !tp_json_nav(doc, k1_ptr, k1_len, &mid) { return false; };
    let v: i64 = 0;
    if sa_json_object_get_i64(mid, k2_ptr, k2_len, &v) == 0 { *out = v; return true; };
    let fv: f64 = 0.0;
    if sa_json_object_get_f64(mid, k2_ptr, k2_len, &fv) == 0 { *out = fv as i64; return true; };
    return false;
}

fn tp_json_message_content_count(doc: u64, has: &bool) -> u64 {
    *has = false;
    let msg: u64 = 0;
    if !tp_json_nav(doc, STR_PTR("message"), STR_LEN("message"), &msg) { return 0; };
    let content: u64 = 0;
    if !tp_json_nav(msg, STR_PTR("content"), STR_LEN("content"), &content) { return 0; };
    if sa_json_kind(content) != 6 { return 0; };
    let cnt: u64 = 0;
    if sa_json_value_count(content, &cnt) != 0 { return 0; };
    *has = true;
    return cnt;
}

fn tp_json_content_block_string(doc: u64, idx: u64, key_ptr: ptr, key_len: u64, dst: ptr, cap: u64) -> u64 {
    let blk: u64 = 0;
    if !tp_json_msg_block(doc, idx, &blk) { return 0; };
    return tp_json_str_field(blk, key_ptr, key_len, dst, cap);
}

fn tp_json_content_block_has(doc: u64, idx: u64, key_ptr: ptr, key_len: u64) -> bool {
    let blk: u64 = 0;
    if !tp_json_msg_block(doc, idx, &blk) { return false; };
    let h: u64 = 0;
    return tp_json_nav(blk, key_ptr, key_len, &h);
}

fn tp_json_content_block_json(doc: u64, idx: u64, key_ptr: ptr, key_len: u64, out: &ByteBuf) -> bool {
    let blk: u64 = 0;
    if !tp_json_msg_block(doc, idx, &blk) { return false; };
    let h: u64 = 0;
    if !tp_json_nav(blk, key_ptr, key_len, &h) { return false; };
    return tp_json_into_buf(h, out);
}

fn tp_json_content_block_bool(doc: u64, idx: u64, key_ptr: ptr, key_len: u64) -> bool {
    let blk: u64 = 0;
    if !tp_json_msg_block(doc, idx, &blk) { return false; };
    let v: u8 = 0;
    if sa_json_object_get_bool(blk, key_ptr, key_len, &v) != 0 { return false; };
    return v != 0;
}

fn tp_json_event_block_string(doc: u64, key_ptr: ptr, key_len: u64, dst: ptr, cap: u64) -> u64 {
    let cb: u64 = 0;
    if !tp_json_event_sub(doc, STR_PTR("content_block"), STR_LEN("content_block"), &cb) { return 0; };
    return tp_json_str_field(cb, key_ptr, key_len, dst, cap);
}

