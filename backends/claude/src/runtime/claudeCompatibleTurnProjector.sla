    let cb: u64 = 0;
    if !tp_json_event_sub(doc, STR_PTR("content_block"), STR_LEN("content_block"), &cb) { return false; };
    let h: u64 = 0;
    return tp_json_nav(cb, key_ptr, key_len, &h);
}

fn tp_json_event_block_json(doc: u64, key_ptr: ptr, key_len: u64, out: &ByteBuf) -> bool {
    let cb: u64 = 0;
    if !tp_json_event_sub(doc, STR_PTR("content_block"), STR_LEN("content_block"), &cb) { return false; };
    let h: u64 = 0;
    if !tp_json_nav(cb, key_ptr, key_len, &h) { return false; };
