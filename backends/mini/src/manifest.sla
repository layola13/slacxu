// Converted 1:1 from backends/mini/src/manifest.ts (CXU plugins @ f2cb649d).
//
// Mini Agent manifest — the single source is ../plugin.json; both sides
// import it from here so the web side never pulls in server code.
//
// DEFECT: TS uses a JSON module import assertion
// (`import manifestJson from "../plugin.json" with { type: "json" }`)
// and re-exports it typed as PluginManifest from @cxu/sdk-backend.
// SLA has no JSON module imports and no structural typing; the
// manifest is kept as the raw JSON text of ../plugin.json, parsed
// at load time with sa_json_parse. The PluginManifest struct lives
// in the sdk-backend unit. (Same model as the cline manifest.)

// MINI_MANIFEST: parsed plugin.json document handle (sa_json doc id).
@import "sa_std/encoding/json.sai"
@import "sa_std/ptr.sa"
@import "sa_std/string.sa"

struct MiniManifest {
    doc: u64,
}

// Loads ../plugin.json (inlined below; single source is the file
// on disk) into the manifest holder. Returns 0 on success.
fn MINI_MANIFEST_load(self: &MiniManifest, json_ptr: ptr, json_len: u64) -> i32 {
    self.doc = sa_json_parse(json_ptr, json_len);
    if self.doc == 0 { return 1; };
    return 0;
}

// The verbatim text of ../plugin.json.
fn mini_manifest_json(out_ptr: &ptr, out_len: &u64) -> void {
    *out_ptr = STR_PTR("{\"capabilities\":{\"compaction\":true,\"fileParts\":true,\"history\":true,\"mcp\":true,\"permissionRoundTrips\":false,\"skills\":true,\"slashCommandForwarding\":false},\"defaultInstalled\":true,\"displayName\":\"Mini Agent\",\"id\":\"mini\",\"kind\":\"backend\",\"presentation\":{\"icon\":\"/icons/mini.svg\",\"label\":\"Mini\",\"labelKey\":\"cliBackend.mini\"},\"sides\":{\"server\":true,\"web\":false},\"version\":\"0.1.0\"}");
    *out_len = STR_LEN("{\"capabilities\":{\"compaction\":true,\"fileParts\":true,\"history\":true,\"mcp\":true,\"permissionRoundTrips\":false,\"skills\":true,\"slashCommandForwarding\":false},\"defaultInstalled\":true,\"displayName\":\"Mini Agent\",\"id\":\"mini\",\"kind\":\"backend\",\"presentation\":{\"icon\":\"/icons/mini.svg\",\"label\":\"Mini\",\"labelKey\":\"cliBackend.mini\"},\"sides\":{\"server\":true,\"web\":false},\"version\":\"0.1.0\"}");
}
