@import "sa_std/io/print.sai"
//
 //* Mini Agent — server side. Mini is the built-in agent runtime: it has no
 //* external CLI binary, which is why it is the one plugin installed by
 //* default. Phase 1 declares the SDK contract; the host still serves mini
 //* through its existing runtime path until the Phase 2 extraction moves
 //* the runtime behind `createEngine`.
 //
// DEFECT: multi-line import statement; names follow on subsequent lines, module on closing line
import type {
  EngineHandle,
  EngineStatus,
  PluginInstallation,
  ServerHost,
  ServerPlugin,
} from "@cxu/sdk-backend/server";

// @import "./manifest.js" // names: MINI_MANIFEST

// re-export: MINI_MANIFEST

struct MiniEngine { // was: class implements EngineHandle 
  readonly pluginId = "mini";
  #status: EngineStatus = { phase: "stopped", transport: "builtin" }; // DEFECT: JS #private field

  fn start(self: &MiniEngine, ) -> EngineStatus { // method of MiniEngine
    self.#status = { phase: "ready", transport: "builtin" }; // DEFECT: JS #private field
    return self.#status; // DEFECT: JS #private field
  }

  fn stop(self: &MiniEngine, ) -> void { // method of MiniEngine
    self.#status = { phase: "stopped", transport: "builtin" }; // DEFECT: JS #private field
  }

  fn status(self: &MiniEngine, ) -> EngineStatus { // method of MiniEngine
    return self.#status; // DEFECT: JS #private field
  }

  fn handleRpc(self: &MiniEngine, ) -> JsonValue { // method of MiniEngine
    throw new Error("mini plugin engine is not wired to the host yet (phase 1 declaration)"); // DEFECT: exception (try/catch/throw)
  }
}

let miniServerPlugin: ServerPlugin = {
  manifest: MINI_MANIFEST,
  discovery: {
    binaryNames: [],
    envBinVars: [],
    matchesKind: () => false, // DEFECT: arrow function / closure
  },
  createEngine(_host: ServerHost): EngineHandle {
    return new MiniEngine();
  },
  findInstallations(): Promise<PluginInstallation[]> { // DEFECT: Promise
    // Built-in runtime: there is no CLI binary to discover.
    return [];
  },
  skillRoots(): string[] {
    return [".codex/skills"];
  },
};

miniServerPlugin;
