// Retranslated (FIX be2, (c)-class) from backends/mini/src/server.ts
// (CXU plugins @ f2cb649d). The bulk pass left this file as raw
// TS residue; this is a full retranslation on the domain's
// established server-plugin model (cf. grok/src/server.sla).
//
// Mini Agent — server side. Mini is the built-in agent runtime:
// it has no external CLI binary, which is why it is the one
// plugin installed by default. Phase 1 declares the SDK
// contract; the host still serves mini through its existing
// runtime path until the Phase 2 extraction moves the runtime
// behind `createEngine`.
//
// TS: import type { EngineHandle, EngineStatus,
// PluginInstallation, ServerHost, ServerPlugin } from
// "@cxu/sdk-backend/server"; — interface types have no SLA
// structs; modelled as local structs + fn families below.
// TS: import { MINI_MANIFEST } from "./manifest.js"; export
// { MINI_MANIFEST }; — re-export forwarding, mirrored by the
// @import below.
@import "./manifest.sla"
@import "sa_std/ptr.sa"
@import "sa_std/string.sa"

struct EngineStatus {
    // phase: "stopped" | "ready" held as text buffer
    phase_ptr: ptr,
    phase_len: u64,
    transport_ptr: ptr,
    transport_len: u64,
}

// class MiniEngine implements EngineHandle.
// readonly pluginId = "mini"; #status starts
// { phase: "stopped", transport: "builtin" }.
struct MiniEngine {
    pluginId_ptr: ptr,
    pluginId_len: u64,
    status: EngineStatus,
}

fn MiniEngine_new() -> MiniEngine {
    let st = EngineStatus { phase_ptr: STR_PTR("stopped"), phase_len: 7, transport_ptr: STR_PTR("builtin"), transport_len: 7 };
    let e = MiniEngine { pluginId_ptr: STR_PTR("mini"), pluginId_len: 4, status: st };
    return e;
}

// DEFECT: async — TS `async start(): Promise<EngineStatus>`;
// blocking-form translation (status code + out param), per
// the domain async model. Sets phase "ready".
fn MiniEngine_start(self: &MiniEngine, out_status: &EngineStatus) -> i32 {
    self.status.phase_ptr = STR_PTR("ready");
    self.status.phase_len = 5;
    self.status.transport_ptr = STR_PTR("builtin");
    self.status.transport_len = 7;
    out_status.phase_ptr = self.status.phase_ptr;
    out_status.phase_len = self.status.phase_len;
    out_status.transport_ptr = self.status.transport_ptr;
    out_status.transport_len = self.status.transport_len;
    return 0;
}

// DEFECT: async — TS `async stop(): Promise<void>`.
fn MiniEngine_stop(self: &MiniEngine) -> i32 {
    self.status.phase_ptr = STR_PTR("stopped");
    self.status.phase_len = 7;
    self.status.transport_ptr = STR_PTR("builtin");
    self.status.transport_len = 7;
    return 0;
}

fn MiniEngine_status(self: &MiniEngine, out_status: &EngineStatus) -> void {
    out_status.phase_ptr = self.status.phase_ptr;
    out_status.phase_len = self.status.phase_len;
    out_status.transport_ptr = self.status.transport_ptr;
    out_status.transport_len = self.status.transport_len;
}

// DEFECT: async + throw — TS handleRpc(): Promise<unknown>
// always throws Error("mini plugin engine is not wired to the
// host yet (phase 1 declaration)"); SLA returns error code 1
// and copies the message into the err buffer. The dynamic
// `unknown` return has no SLA type.
fn MiniEngine_handleRpc(self: &MiniEngine, err_ptr: ptr, err_cap: u64, err_len: &u64) -> i32 {
    let msg = STR_PTR("mini plugin engine is not wired to the host yet (phase 1 declaration)");
    let ml = STR_LEN("mini plugin engine is not wired to the host yet (phase 1 declaration)");
    let n: u64 = 0;
    while n < ml && n < err_cap {
        let b: u8 = 0;
        PTR_BYTE_AT(b, msg, n);
        let wp: ptr = PTR_NULL(); PTR_BYTE_ADD(wp, err_ptr, n);
        PTR_WRITE_U8(wp, b);
        n = n + 1;
    }
    *err_len = n;
    return 1;
}

// DEFECT: ServerPlugin object literal (manifest / discovery /
// createEngine / findInstallations / skillRoots) has no SLA
// object type; flattened into the struct + functions below.
// discovery.binaryNames / envBinVars are both [] (built-in
// runtime, no CLI binary to discover).
struct MiniServerPlugin {
    manifest: MiniManifest,
    binaryNames_len: u64,
    envBinVars_len: u64,
}

// TS discovery.matchesKind: () => false — closure converted
// to a plain function.
fn MiniServerPlugin_matchesKind() -> bool {
    return false;
}

// TS createEngine(_host: ServerHost): EngineHandle — the host
// parameter is an injected interface, unused by the source
// (named _host); modelled as an opaque handle.
fn MiniServerPlugin_createEngine(host: u64) -> MiniEngine {
    let e = MiniEngine_new();
    return e;
}

// DEFECT: async — TS findInstallations():
// Promise<PluginInstallation[]> returns [] (built-in runtime:
// no CLI binary to discover); count 0.
fn MiniServerPlugin_findInstallations(out_count: &u64) -> i32 {
    *out_count = 0;
    return 0;
}

// TS skillRoots(): string[] returns [".codex/skills"]; the
// single root is written to out, count set to 1.
fn MiniServerPlugin_skillRoots(out_ptr: &ptr, out_len: &u64, out_count: &u64) -> i32 {
    *out_ptr = STR_PTR(".codex/skills");
    *out_len = STR_LEN(".codex/skills");
    *out_count = 1;
    return 0;
}

// export const miniServerPlugin / export default
// miniServerPlugin — constructed by the host via this init
// (no module-level singleton instance in SLA); the manifest
// holder is loaded from the verbatim plugin.json text.
fn miniServerPlugin_init(out: &MiniServerPlugin) -> i32 {
    out.binaryNames_len = 0;
    out.envBinVars_len = 0;
    let mp: ptr = PTR_NULL();
    let ml: u64 = 0;
    mini_manifest_json(&mp, &ml);
    return MINI_MANIFEST_load(&out.manifest, mp, ml);
}
