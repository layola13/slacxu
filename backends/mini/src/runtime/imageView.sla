    size: [u8; 16], size_len: u64,
    color: [u8; 16], color_len: u64,
    analysisMode: [u8; 16], analysisMode_len: u64, has_analysisMode: bool,
    detail: [u8; 16], detail_len: u64, has_detail: bool,
    degraded: bool, has_degraded: bool,
}

