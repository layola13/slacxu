fn miniIsConciseDevelopmentFollowup(prompt_ptr: ptr, prompt_len: u64, hasDevelopmentContext: bool) -> bool {
    // text = prompt.trim(); return hasDevelopmentContext && text.length>0 && text.length<=160
    //   && !miniIsDirectAnswerPrompt(text) && !miniIsAnalysisOnlyPrompt(text)
    //   && !/[?？]|^(?:如何|怎么|为什么|为何|请问|how\b|why\b)/i.test(text)
    if !hasDevelopmentContext { return false; };
    if prompt_len == 0 { return false; };
    if prompt_len > 160 { return false; };
    return !miniIsDirectAnswerPrompt(prompt_ptr, prompt_len) && !miniIsAnalysisOnlyPrompt(prompt_ptr, prompt_len);
}

