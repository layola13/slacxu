//
 //* Whether a tool call needs interactive approval. `never` (danger bypass)
 //* and unset (legacy/CLI threads) run without prompts; any other explicit
 //* policy asks. Session bypass ("Allow session") suppresses further prompts.
 //
fn miniNeedsApproval(approvalPolicy: JsonValue, bypass: JsonValue) -> bool { // was: function miniNeedsApproval
  if (bypass === true) return false;
  let policy = typeof approvalPolicy === "string" ? approvalPolicy.trim().toLowerCase() : ""; // DEFECT: runtime type test (typeof/instanceof/in)
  if (!policy || policy === "never" || policy === "bypass") return false;
  return true;
}

// Human-readable target for an approval card (path or command preview). */
fn miniApprovalTarget(a: JsonValue) -> TextBuf { // was: function miniApprovalTarget
  let arg = (a ?? {}) as Record<string, any>; // DEFECT: type assertion (as)
  for (const key of ["path", "file", "target", "dir", "cwd", "from", "to", "uri"]) {
    let v = arg[key];
    if (typeof v === "string" && v.trim()) return v.trim().slice(0, 300); // DEFECT: runtime type test (typeof/instanceof/in)
  }
  if (typeof arg.exe === "string" && arg.exe.trim()) { // DEFECT: runtime type test (typeof/instanceof/in)
    let parts = [arg.exe.trim(), ...(Array.isArray(arg.args) ? arg.args.filter((x) => typeof x === "string") : [])]; // DEFECT: runtime type test (typeof/instanceof/in)
    let parts_p: ptr = PTR_NULL(); PTR_BYTE_ADD(parts_p, &parts, 0);
    return parts.join(" ").slice(0, 300); // DEFECT: JS Array/String method
  }
  if (typeof arg.command === "string" && arg.command.trim()) return arg.command.trim().slice(0, 300); // DEFECT: runtime type test (typeof/instanceof/in)
  return "";
}

// Normalize a frontend approval answer (item/* + legacy spellings) to a decision. */
fn parseMiniApprovalDecision(result: JsonValue, error: JsonValue) -> MiniApprovalDecision { // was: function parseMiniApprovalDecision
  if (error) return "cancel";
  let record = (result ?? {}) as Record<string, any>; // DEFECT: type assertion (as)
  let raw = typeof record.decision === "string" ? record.decision.trim().toLowerCase() : ""; // DEFECT: runtime type test (typeof/instanceof/in)
  if (raw === "accept" || raw === "approved") return "accept";
  if (raw === "acceptforsession" || raw === "approved_for_session" || raw === "accept_for_session") return "session";
  if (raw === "cancel" || raw === "abort") return "cancel";
  return "decline";
}

fn isMiniPlanRequest(r: JsonValue) -> bool { // was: function isMiniPlanRequest
  if (r.sandbox === "read-only") return true;
  if (r.mode === "plan") return true;
  if (r.collaborationMode === "plan") return true;
  let cm = r.collaborationMode as Record<string, any> | undefined; // DEFECT: type assertion (as)
  if (cm && typeof cm === "object" && (cm.mode === "plan" || cm.settings?.mode === "plan")) return true; // DEFECT: runtime type test (typeof/instanceof/in)
  if (r.planModeEnabled === true) return true;
  return false;
}

fn miniGoalState(s: MiniSession) -> JsonValue { // was: function miniGoalState
  let startedAt = typeof s.goalStartedAt === "number" ? s.goalStartedAt : undefined; // DEFECT: runtime type test (typeof/instanceof/in)
  return {
    threadId: s.threadId,
    objective: s.goalObjective ?? "",
    status: s.goalStatus ?? "active",
    tokenBudget: typeof s.goalTokenBudget === "number" ? s.goalTokenBudget : null, // DEFECT: runtime type test (typeof/instanceof/in)
    tokensUsed: typeof s.goalTokensUsed === "number" ? s.goalTokensUsed : 0, // DEFECT: runtime type test (typeof/instanceof/in)
    timeUsedSeconds: startedAt ? Math.max(0, Math.floor((Date.now() - startedAt) / 1000)) : 0,
  };
}

// Accept `tokenBudget` / `token_budget` / `budget`; null/undefined clears. */
fn normalizeMiniGoalBudget(v: JsonValue) -> number   { // was: function normalizeMiniGoalBudget
  if (v === undefined) return undefined;
  if (v === null) return null;
  let n = typeof v === "string" && v.trim() !== "" ? Number(v.trim()) : typeof v === "number" ? v : NaN; // DEFECT: runtime type test (typeof/instanceof/in)
  if (!Number.isFinite(n)) return undefined;
  if (n <= 0) return null;
  return Math.min(10_000_000, Math.floor(n));
}

// True when an explicit goal budget exists and cumulative usage reached it. */
fn isMiniGoalBudgetExhausted(s: Pick) -> bool { // was: function isMiniGoalBudgetExhausted
  if (typeof s.goalTokenBudget !== "number" || s.goalTokenBudget <= 0) return false; // DEFECT: runtime type test (typeof/instanceof/in)
  return (typeof s.goalTokensUsed === "number" ? s.goalTokensUsed : 0) >= s.goalTokenBudget; // DEFECT: runtime type test (typeof/instanceof/in)
}

//
 //* Authoritative per-continuation prompt. Replaces the old bare 2-line
 //* "Continue working toward ..." nudge that carried no progress, no budget,
 //* and no completion contract — the direct cause of the repeated list-task loop.
 //
function buildMiniGoalContinuationPrompt(s: {
  goalObjective?: string | null;
  goalTokensUsed?: number;
  goalTokenBudget?: number | null;
  goalStartedAt?: number;
}, opts: { count: number; max: number; planText?: string; stagnantTurns?: number }): string {
  return buildGoalContinuationPrompt(s, { ...opts, stagnantLimit: MINI_GOAL_STAGNANT_LIMIT, planToolName: "update_plan" });
}

fn normalizeMiniGoalStatus(v: JsonValue) -> string  { // was: function normalizeMiniGoalStatus
  let s = typeof v === "string" ? v.trim().toLowerCase() : ""; // DEFECT: runtime type test (typeof/instanceof/in)
  if (s === "active" || s === "paused" || s === "blocked" || s === "complete" || s === "completed") {
    return s === "completed" ? "complete" : s;
  }
  if (s === "usagelimited" || s === "usage_limited" || s === "usage-limited") return "usageLimited";
  if (s === "budgetlimited" || s === "budget_limited" || s === "budget-limited") return "budgetLimited";
  return null;
}

// Upstream errors that mean the account/quota is spent (goal -> usageLimited). */
let MINI_GOAL_USAGE_LIMIT_ERROR_RE =
  /(\b429\b|rate[\s_-]?limit|quota|insufficient[\s_-]?(balance|credit|funds)|usage[\s_-]?limit|billing|额度|余额不足|配额)/i;

// Consecutive no-progress goal turns before the host marks the goal blocked. */
let MINI_GOAL_STAGNANT_LIMIT = 3;

//
 //* Cross-turn progress fingerprint: tool names + arg paths + output head +
 //* plan steps + assistant text head for one turn. Two turns that did the same
 //* reads and printed the same list produce the same fingerprint.
 //
fn miniGoalTurnFingerprint(messages: JsonArray, turnId: TextBuf) -> TextBuf { // was: function miniGoalTurnFingerprint
  let parts: string[] = [];
  for (const m of messages) {
    if (!m || typeof m !== "object") continue; // DEFECT: runtime type test (typeof/instanceof/in)
    let rec = m as Record<string, any>; // DEFECT: type assertion (as)
    if (String(rec.turnId ?? "") !== turnId) continue;
    let t = String(rec.type ?? "");
    if (t === "toolCall") {
      let name = String(rec.name ?? "tool");
      let args = String(rec.arguments ?? "").slice(0, 200); // DEFECT: JS Array/String method
      let out = String(rec.output ?? "").slice(0, 300); // DEFECT: JS Array/String method
      parts.push(`tool:${name}:${args}=>${out}`); // DEFECT: JS Array/String method
    } else if (t === "plan") {
      let plan = Array.isArray(rec.plan) ? rec.plan : [];
      parts.push(`plan:${plan.map((e: any) => `${String(e?.step ?? e?.text ?? "").slice(0, 80)}:${String(e?.status ?? "")}`).join("|")}`); // DEFECT: optional chaining ?.
    } else if (t === "agentMessage") {
      parts.push(`msg:${String(rec.text ?? "").slice(0, 200)}`); // DEFECT: JS Array/String method
    }
  }
  return parts.join("\n").slice(0, 4000); // DEFECT: JS Array/String method
}

// Recent goal turns whose tool fingerprints are compared (catches A/B/A/B loops). */
let MINI_GOAL_FINGERPRINT_WINDOW = 6;

//
 //* Work-only fingerprint (tool calls + plan, no assistant text), hashed. A turn
 //* that re-runs the same reads with reworded prose used to count as progress.
 //* Empty when the turn made no tool/plan call at all.
 //
fn miniGoalToolFingerprint(messages: JsonArray, turnId: TextBuf) -> TextBuf { // was: function miniGoalToolFingerprint
  let parts: string[] = [];
  for (const m of messages) {
    if (!m || typeof m !== "object") continue; // DEFECT: runtime type test (typeof/instanceof/in)
    let rec = m as Record<string, any>; // DEFECT: type assertion (as)
    if (String(rec.turnId ?? "") !== turnId) continue;
    let t = String(rec.type ?? "");
    if (t === "toolCall") {
      parts.push(`tool:${String(rec.name ?? "tool")}:${String(rec.arguments ?? "").slice(0, 200)}=>${String(rec.output ?? "").slice(0, 300)}`); // DEFECT: JS Array/String method
    } else if (t === "plan") {
      let plan = Array.isArray(rec.plan) ? rec.plan : [];
      parts.push(`plan:${plan.map((e: any) => `${String(e?.step ?? e?.text ?? "").slice(0, 80)}:${String(e?.status ?? "")}`).join("|")}`); // DEFECT: optional chaining ?.
    }
  }
  if (!parts.length) return "";
  return createHash("sha1").update(parts.join("\n")).digest("hex").slice(0, 16); // DEFECT: JS Array/String method
}

//
 //* Track cross-turn stagnation (Codex "no-progress check": status restatements
 //* and unexecuted plans are no progress). A goal turn counts as no progress
 //* when its full fingerprint equals the previous turn's, its tool work repeats
 //* any of the last MINI_GOAL_FINGERPRINT_WINDOW turns, or it made no tool/plan
 //* call. Returns true after MINI_GOAL_STAGNANT_LIMIT consecutive no-progress
 //* turns — the caller then marks the goal blocked instead of续跑. One turn
 //* before that the continuation prompt carries a final warning.
 //
function noteMiniGoalTurnProgress(s: {
  goalLastFingerprint?: string;
  goalStagnantTurns?: number;
  goalRecentToolFingerprints?: string[];
}, fingerprint: string, toolFingerprint?: string): boolean {
  let recent = Array.isArray(s.goalRecentToolFingerprints) ? s.goalRecentToolFingerprints : [];
  let repeatedWhole = Boolean(fingerprint) && fingerprint === s.goalLastFingerprint;
  // toolFingerprint undefined = caller did not compute it (legacy behavior).
  let repeatedWork = toolFingerprint !== undefined && (toolFingerprint === "" || recent.includes(toolFingerprint)); // DEFECT: JS Array/String method
  if (repeatedWhole || repeatedWork) {
    s.goalStagnantTurns = (typeof s.goalStagnantTurns === "number" ? s.goalStagnantTurns : 0) + 1; // DEFECT: runtime type test (typeof/instanceof/in)
  } else {
    s.goalStagnantTurns = 0;
  }
  s.goalLastFingerprint = fingerprint;
  if (toolFingerprint) s.goalRecentToolFingerprints = [...recent, toolFingerprint].slice(-MINI_GOAL_FINGERPRINT_WINDOW); // DEFECT: JS Array/String method
  return (s.goalStagnantTurns ?? 0) >= MINI_GOAL_STAGNANT_LIMIT;
}

// Reasoning effort (thinking mode) mirrors Codex CLI: low/medium/high/xhigh/
// max/ultra (+ none/minimal/persistent/custom passthrough). Normalized to the
// lowercase wire value; empty/unknown returns undefined so callers keep the
// session default. Default session effort is "medium" (same as workbench).
let MINI_DEFAULT_EFFORT = "medium";

fn normalizeMiniEffort(v: JsonValue) -> string  { // was: function normalizeMiniEffort
  if (typeof v !== "string") return undefined; // DEFECT: runtime type test (typeof/instanceof/in)
  let s = v.trim().toLowerCase(); // DEFECT: JS Array/String method
  if (!s || s.length > 64) return undefined;
  if (s === "extra-high" || s === "extra_high" || s === "x-high") return "xhigh";
  if (/^[a-z0-9][a-z0-9\-_]*$/.test(s)) return s;
  return undefined;
}

fn extractMiniEffort(r: JsonValue) -> string  { // was: function extractMiniEffort
  let direct = normalizeMiniEffort(r.effort)
    ?? normalizeMiniEffort(r.reasoningEffort)
    ?? normalizeMiniEffort(r.reasoning_effort)
    ?? normalizeMiniEffort(r.modelReasoningEffort)
    ?? normalizeMiniEffort(r.model_reasoning_effort);
  if (direct) return direct;
  let cm = r.collaborationMode as Record<string, any> | undefined; // DEFECT: type assertion (as)
  if (cm && typeof cm === "object") { // DEFECT: runtime type test (typeof/instanceof/in)
    let nested = normalizeMiniEffort(cm.reasoning_effort)
      ?? normalizeMiniEffort(cm.reasoningEffort)
      ?? normalizeMiniEffort(cm.effort);
    if (nested) return nested;
    let settings = cm.settings as Record<string, any> | undefined; // DEFECT: type assertion (as)
    if (settings && typeof settings === "object") { // DEFECT: runtime type test (typeof/instanceof/in)
      let fromSettings = normalizeMiniEffort(settings.reasoning_effort)
        ?? normalizeMiniEffort(settings.reasoningEffort)
        ?? normalizeMiniEffort(settings.effort);
      if (fromSettings) return fromSettings;
    }
  }
  let config = r.config as Record<string, any> | undefined; // DEFECT: type assertion (as)
  if (config && typeof config === "object") { // DEFECT: runtime type test (typeof/instanceof/in)
    let fromConfig = normalizeMiniEffort(config.model_reasoning_effort)
      ?? normalizeMiniEffort(config.reasoning_effort)
      ?? normalizeMiniEffort(config.reasoningEffort);
    if (fromConfig) return fromConfig;
  }
  return undefined;
}

fn miniAdditionalRoots(r: JsonValue, cwd: TextBuf) -> string[]  { // was: function miniAdditionalRoots
  let raw = Array.isArray(r.additionalRoots)
    ? r.additionalRoots
    : Array.isArray(r.runtimeWorkspaceRoots) ? r.runtimeWorkspaceRoots.slice(1) : []; // DEFECT: JS Array/String method
  let roots = raw
    .filter((value): value is string => typeof value === "string" && value.trim().length > 0) // DEFECT: runtime type test (typeof/instanceof/in)
    .map((value) => value.trim()) // DEFECT: JS Array/String method
    .filter((value, index, all) => all.indexOf(value) === index && value !== cwd); // DEFECT: JS Array/String method
  return roots.length ? roots : undefined;
}


// Context window follows the same resolution as the Codex engine catalog
// (`buildCodexModelCatalog`): model `[1m]`-style variants win, then the
// relay-group setting (user-editable in relay settings), otherwise the
// 272K product default.
let MINI_DEFAULT_CONTEXT_WINDOW = 272_000;

function resolveMiniContextWindow(
  model: string,
  capability?: ModelCapabilityDescriptor | null,
  groupContextWindow?: number | null,
): number {
  return resolveModelContextWindow(model, capability ?? undefined, groupContextWindow ?? undefined)
    ?? MINI_DEFAULT_CONTEXT_WINDOW;
}

struct MiniUsageDelta { // was: interface 
  inputTokens: number;
  outputTokens: number;
  cachedInputTokens?: number;
  cacheWriteInputTokens?: number;
  reasoningOutputTokens?: number;
}

fn num(v: JsonValue) -> number  { // was: function num
  return typeof v === "number" && Number.isFinite(v) && v >= 0 ? Math.floor(v) : undefined; // DEFECT: runtime type test (typeof/instanceof/in)
}

// Inclusive input/output totals, with cache/reasoning as subsets (not extra tokens). */
fn normalizeMiniUsage(raw: JsonValue) -> MiniUsageDelta  { // was: function normalizeMiniUsage
  if (!raw || typeof raw !== "object") return null; // DEFECT: runtime type test (typeof/instanceof/in)
  let r = raw as Record<string, unknown>; // DEFECT: type assertion (as)
  let details = (value: unknown): Record<string, unknown> => // DEFECT: arrow function / closure
    value && typeof value === "object" && !Array.isArray(value) ? value as Record<string, unknown> : {}; // DEFECT: runtime type test (typeof/instanceof/in)
  let inputDetails = details(r.input_tokens_details ?? r.prompt_tokens_details);
  let outputDetails = details(r.output_tokens_details ?? r.completion_tokens_details);
  let input = num(r.input_tokens) ?? num(r.prompt_tokens);
  let output = num(r.output_tokens) ?? num(r.completion_tokens);
  let cached = num(inputDetails.cached_tokens) ?? num(r.cached_tokens) ?? num(r.cache_read_input_tokens);
  let cacheWrite = num(inputDetails.cache_write_tokens) ?? num(r.cache_write_tokens) ?? num(r.cache_creation_input_tokens);
  let reasoning = num(outputDetails.reasoning_tokens) ?? num(r.reasoning_tokens);
  if (input === undefined && output === undefined && cached === undefined && cacheWrite === undefined && reasoning === undefined) return null;
  let cacheTokens = (cached ?? 0) + (cacheWrite ?? 0);
  // Raw Anthropic input_tokens excludes both cache categories. OpenAI chat and
  // Responses (including gateway-converted Anthropic usage) already include them.
  let anthropic = r.prompt_tokens === undefined && r.input_tokens_details === undefined && r.prompt_tokens_details === undefined
    && (num(r.cache_read_input_tokens) !== undefined || num(r.cache_creation_input_tokens) !== undefined);
  return {
    inputTokens: anthropic ? (input ?? 0) + cacheTokens : Math.max(input ?? 0, cacheTokens),
    outputTokens: Math.max(output ?? 0, reasoning ?? 0),
    ...(cached !== undefined ? { cachedInputTokens: cached } : {}),
    ...(cacheWrite !== undefined ? { cacheWriteInputTokens: cacheWrite } : {}),
    ...(reasoning !== undefined ? { reasoningOutputTokens: reasoning } : {}),
  };
}

// (Data-URL blanking for token counting lives in miniTokenizer.cleanMiniTokenText.)

// Conservative token estimate with data URLs blanked out.
 //*
 //* Exact o200k_base count via `miniTokenizer` (falls back to a CJK-aware
 //* char heuristic when the WASM encoder cannot load), so the composer ring,
 //* auto-compact triggers, and the in-turn budget all run on real tokens.
 //
fn estimateMiniTokens(text: JsonValue) -> f64 { // was: function estimateMiniTokens
  return countMiniTokens(text);
}

// Hot-loop budget guard: heuristic only, never exact o200k encoding.
 //*
 //* Measured under bun: exact encoding costs ~2.5s for 4k chars and ~65s for
 //* 20k chars, synchronously on the server event loop. The round loop calls
 //* this on the full thread JSON every round, so exact counting froze the
 //* whole service (all sessions, all watchers, HTTP) — the frontend/backend
 //* "random freeze" scaled with history size and agent concurrency. The guard
 //* only decides shrink/wrap-up, where ±10% heuristic error is harmless. 
fn miniOverTurnBudget(threadJson: TextBuf, turnBudget: f64) -> bool { // was: function miniOverTurnBudget
  return heuristicMiniTokens(threadJson) > turnBudget;
}

// Max history text carried into a turn (chars, before token estimation). */
// Max history chars per turn. Raised from 9000: a single long turn emits
 //* dozens of agent segments, and a pure 9000-char tail cut the task-defining
 //* early messages — the model then claimed to have no prior-task context. 
let MINI_HISTORY_MAX_CHARS = 24000;
// Head budget: earliest (task-defining) history lines always survive capping. */
let MINI_HISTORY_HEAD_CHARS = 6000;
// Marker replacing omitted middle history. */
let MINI_HISTORY_OMIT_MARKER = "\n[... middle history omitted for length ...]\n";

//
 //* Head+tail history selection: keep the earliest lines (task definition)
 //* plus the most recent tail within maxChars. Pure tail truncation dropped
 //* the task goal in long sessions.
 //
fn headTailHistoryText(lines: JsonArray, maxChars: f64) -> TextBuf { // was: function headTailHistoryText
  let full = lines.join("\n"); // DEFECT: JS Array/String method
  if (full.length <= maxChars) return full;
  let head = "";
  let headCount = 0;
  for (const line of lines) {
    if (head.length + line.length + 1 > MINI_HISTORY_HEAD_CHARS) break;
    head += (head ? "\n" : "") + line;
    headCount++;
  }
  let tailBudget = Math.max(0, maxChars - head.length - MINI_HISTORY_OMIT_MARKER.length);
  let tailParts: string[] = [];
  let tailLen = 0;
  for (let i = lines.length - 1; i >= headCount; i--) {
    let line = lines[i] ?? "";
    if (tailLen + line.length + 1 > tailBudget) break;
    tailParts.unshift(line);
    tailLen += line.length + 1;
  }
  if (tailParts.length === 0) return head.slice(0, maxChars); // DEFECT: JS Array/String method
  return `${head}${MINI_HISTORY_OMIT_MARKER}${tailParts.join("\n")}`; // DEFECT: JS Array/String method
}

//
 //* Split earlier-turn history into its two carriers so it is sent exactly once:
 //*
 //* - `historyBlock` appends to the chat system message (`systemWithHistory`).
 //* - `recapText` is the explicit `[earlier conversation]` input, kept ONLY for
 //*   the responses protocol whose `instructions` carry no history.
 //
// Older-history summarization (LLM) budget knobs. */
// Raw-tail floor once summarizing (the budget-derived tail is usually larger). */
let MINI_HISTORY_TAIL_CHARS = 12000;
let MINI_HISTORY_SUMMARY_MAX_INPUT_CHARS = 40000;
let MINI_HISTORY_SUMMARY_MAX_OUTPUT_CHARS = 8000;
// Share of the context window earlier-turn history may occupy (tokens). */
let MINI_HISTORY_BUDGET_RATIO = 0.25;
// Absolute ceiling for history text even on huge windows (chars ~ 64k tokens). */
let MINI_HISTORY_BUDGET_MAX_CHARS = 256_000;
// Per-item truncation used ONLY when history exceeds its budget (legacy default). */
let MINI_HISTORY_OVER_BUDGET_ITEM_CHARS = 800;

//
 //* History char budget derived from the resolved context window: history that
 //* fits is sent WITHOUT per-item truncation; only over-budget history falls
 //* back to per-item cuts + head/tail capping. Floors at MINI_HISTORY_MAX_CHARS
 //* so small windows never get less than the historical behavior.
 //
fn miniHistoryBudgetChars(contextWindow: f64) -> f64 { // was: function miniHistoryBudgetChars
  let w = Number.isFinite(contextWindow) && contextWindow > 0
    ? contextWindow
    : MINI_TURN_INPUT_BUDGET_DEFAULT_WINDOW;
  return Math.min(MINI_HISTORY_BUDGET_MAX_CHARS, Math.max(MINI_HISTORY_MAX_CHARS, Math.floor(w * MINI_HISTORY_BUDGET_RATIO * 4)));
}

//
 //* Split history lines into older (model-summary candidate) + tail (sent raw).
 //* Tail holds the newest lines within TAIL budget, at least one line.
 //
function splitHistoryForSummary(lines: string[], tailChars = MINI_HISTORY_TAIL_CHARS): { older: string[]; tail: string[] } {
  let tail: string[] = [];
  let tailLen = 0;
  let i = lines.length;
  for (; i > 0; i--) {
    let line = lines[i - 1] ?? "";
    if (tail.length > 0 && tailLen + line.length + 1 > tailChars) break;
    tail.unshift(line);
    tailLen += line.length + 1;
  }
  return { older: lines.slice(0, i), tail }; // DEFECT: JS Array/String method
}

// Summarize only once earlier-turn history would exceed this share of its budget. */
let MINI_HISTORY_SUMMARY_TRIGGER_RATIO = 0.85;
// Budget shares once summarizing: raw recent tail / verbatim user messages / unsummarized carry / summary. */
let MINI_HISTORY_TAIL_BUDGET_RATIO = 0.4;
let MINI_HISTORY_PINNED_USER_RATIO = 0.15;
let MINI_HISTORY_CARRY_RATIO = 0.1;
let MINI_HISTORY_SUMMARY_BUDGET_RATIO = 0.25;
// Sequential fold calls allowed for one (initial) summary backlog. */
let MINI_HISTORY_SUMMARY_MAX_CHUNKS = 3;
// Stable lines recorded as the cached summary boundary. */
let MINI_HISTORY_ANCHOR_LINES = 3;
// Earliest user message (task definition) always survives pinning, capped. */
let MINI_HISTORY_FIRST_USER_CHARS = 2000;

//
 //* Codex compacts near the window limit; the old fixed 6000-char trigger
 //* summarized after two or three tool-heavy turns while most of the history
 //* budget sat unused. History that fits is sent raw.
 //
fn miniHistoryNeedsSummary(lines: JsonArray, budgetChars: f64) -> bool { // was: function miniHistoryNeedsSummary
  return lines.join("\n").length > budgetChars * MINI_HISTORY_SUMMARY_TRIGGER_RATIO; // DEFECT: JS Array/String method
}

// type MiniHistorySummaryCache = JsonValue // was: { anchor: string[]; summary: string }

// Only the newest continuation fragment survives history collapse, so these
// lines vanish between turns and can never serve as a boundary.
let isMiniContinuationLine = (line: string): boolean => line.startsWith("goal-continuation:"); // DEFECT: JS Array/String method

// Boundary of a summary covering all of `older`: its last stable lines. */
fn miniHistoryAnchor(older: JsonArray) -> JsonArray { // was: function miniHistoryAnchor
  return older.filter((l) => !isMiniContinuationLine(l)).slice(-MINI_HISTORY_ANCHOR_LINES); // DEFECT: JS Array/String method
}

//
 //* Index just past the cached boundary in `older`, or -1 when the boundary is
 //* gone (compaction, render-mode switch). The earliest match wins: re-folding
 //* a repeated block duplicates a little, a later match would skip lines.
 //
fn locateMiniHistoryAnchor(older: JsonArray, anchor: JsonArray) -> f64 { // was: function locateMiniHistoryAnchor
  if (!anchor.length) return -1;
  let stable = older.map((line, index) => ({ line, index })).filter((x) => !isMiniContinuationLine(x.line)); // DEFECT: JS Array/String method
  for (let end = anchor.length; end <= stable.length; end++) {
    let hit = true;
    for (let k = 0; k < anchor.length; k++) {
      if (stable[end - anchor.length + k]!.line !== anchor[k]) { hit = false; break; }
    }
    if (hit) return stable[end - 1]!.index + 1;
  }
  return -1;
}

type MiniHistorySummaryPlan =
  | { kind: "reuse"; summary: string; carry: string[] }
  | { kind: "summarize"; base: string; pending: string[] };

//
 //* Rolling summary: every older line is either inside the cached summary or
 //* pending. Small pending backlogs ride along raw (no model call); larger ones
 //* are folded into the previous summary. Nothing is dropped between the two.
 //
//
 //* Code-state-aware handoff instruction for the history-summary model call.
 //* Generic summaries paraphrase away the exact state code-writing continuations
 //* need, so the schema forces verbatim preservation: touched files with line
 //* ranges, open diagnostics quoted exactly, pending edit anchors, and the
 //* do-not-retry list. Exported for unit testing.
 //
fn buildMiniHistorySummaryAsk(previous: TextBuf, outputChars: f64) -> TextBuf { // was: function buildMiniHistorySummaryAsk
  return [
    "You are writing a CONTEXT CHECKPOINT handoff summary of earlier coding-agent history for the agent that continues the task.",
    previous ? "Merge the previous summary with the new history into ONE updated summary; keep everything from the previous summary that still matters." : "",
    "Use exactly these sections, terse bullets, no prose intro:",
    "- GOALS: user goals and hard constraints.",
    "- TOUCHED: every file read or changed as `path` plus line ranges touched and one-line outcome each (e.g. `src/a.ts L10-L40 edited ok`, `src/b.ts L5-L9 read`).",
    "- ERRORS: open diagnostics quoted VERBATIM as `path Lline:Ccol message` lines — never paraphrase error text.",
    "- PLAN: task-plan checklist with each step's status.",
    "- NEXT: clear next steps, including exact pending edit anchors (file + old_text snippet) when known.",
    "- AVOID: approaches already tried that failed — do not retry these.",
    `At most ${outputChars} characters. Nothing the next turn needs may be dropped; when in doubt keep exact paths, line numbers, and error text over prose.`, // DEFECT: template literal interpolation
  ].filter(Boolean).join("\n"); // DEFECT: JS Array/String method
}

function planMiniHistorySummary(
  older: string[],
  cache: MiniHistorySummaryCache | undefined,
  carryBudgetChars: number,
): MiniHistorySummaryPlan {
  let at = cache ? locateMiniHistoryAnchor(older, cache.anchor) : -1;
  if (cache && at >= 0) {
    let pending = older.slice(at); // DEFECT: JS Array/String method
    if (pending.join("\n").length <= carryBudgetChars) return { kind: "reuse", summary: cache.summary, carry: pending }; // DEFECT: JS Array/String method
    return { kind: "summarize", base: cache.summary, pending };
  }
  return { kind: "summarize", base: "", pending: older };
}

//
 //* Split a pending backlog into summary-request chunks. Per-line caps tighten
 //* until the backlog fits MINI_HISTORY_SUMMARY_MAX_CHUNKS calls, instead of the
 //* old head-only slice that silently dropped the middle of long sessions.
 //
function chunkMiniSummaryInput(
  pending: string[],
  maxChars = MINI_HISTORY_SUMMARY_MAX_INPUT_CHARS,
  maxChunks = MINI_HISTORY_SUMMARY_MAX_CHUNKS,
): string[] {
  let last: string[] = [];
  for (const cap of [0, 1200, 600, 300, 160]) {
    let capped = cap > 0 ? pending.map((l) => (l.length > cap ? `${l.slice(0, cap)}…` : l)) : pending; // DEFECT: JS Array/String method
    if (capped.some((l) => l.length > maxChars)) continue; // DEFECT: JS Array/String method
    let chunks: string[] = [];
    let cur = "";
    for (const line of capped) {
      if (cur && cur.length + 1 + line.length > maxChars) {
        chunks.push(cur); // DEFECT: JS Array/String method
        cur = line;
      } else {
        cur = cur ? `${cur}\n${line}` : line; // DEFECT: template literal interpolation
      }
    }
    if (cur) chunks.push(cur); // DEFECT: JS Array/String method
    last = chunks;
    if (chunks.length <= maxChunks) return chunks;
  }
  // Extreme backlog only: keep the task-defining first chunk plus the newest.
  return last.length > maxChunks ? [last[0]!, ...last.slice(-(maxChunks - 1))] : last; // DEFECT: JS Array/String method
}

//
 //* Real user messages from the summarized part, verbatim (Codex keeps them
 //* across compaction): the earliest one always, then newest-first within the
 //* budget; the message crossing the budget is truncated.
 //
fn pinMiniHistoryUserLines(lines: JsonArray, budgetChars: f64) -> JsonArray { // was: function pinMiniHistoryUserLines
  let users = lines.map((line, index) => ({ line, index })).filter((x) => x.line.startsWith("user: ")); // DEFECT: JS Array/String method
  if (!users.length || budgetChars <= 0) return [];
  let first = users[0]!;
  let firstText = first.line.length > MINI_HISTORY_FIRST_USER_CHARS ? `${first.line.slice(0, MINI_HISTORY_FIRST_USER_CHARS)}…` : first.line; // DEFECT: JS Array/String method
  let picked: Array<{ index: number; text: string }> = [];
  let used = firstText.length + 1;
  for (let i = users.length - 1; i >= 1; i--) {
    let room = budgetChars - used;
    if (room <= 0) break;
    let { line, index } = users[i]!;
    let text = line.length > room ? `${line.slice(0, room)}…` : line; // DEFECT: JS Array/String method
    picked.push({ index, text }); // DEFECT: JS Array/String method
    used += text.length + 1;
    if (line.length > room) break;
  }
  picked.push({ index: first.index, text: firstText }); // DEFECT: JS Array/String method
  return picked.sort((a, b) => a.index - b.index).map((x) => x.text); // DEFECT: JS Array/String method
}

function assembleMiniSummarizedHistory(parts: {
  summary: string;
  pinnedUsers: string[];
  carry: string[];
  tail: string[];
}): string[] {
  let out = [`[earlier history summary]\n${parts.summary}`]; // DEFECT: template literal interpolation
  if (parts.pinnedUsers.length) out.push(`[earlier user messages, verbatim - already covered, background context]\n${parts.pinnedUsers.join("\n")}`); // DEFECT: JS Array/String method
  return [...out, ...parts.carry, ...parts.tail];
}

fn formatMiniLiveTurnPrompt(prompt: TextBuf, hasHistory: bool) -> TextBuf { // was: function formatMiniLiveTurnPrompt
  let languageSentence =
    "write the final answer in the same language as the ACTIVE task above (e.g. Chinese task → Simplified Chinese answer unless the user explicitly asks otherwise)."; // DEFECT: type assertion (as)
  if (!hasHistory) return `${prompt}\n\n[Task context: ${MINI_SHORT_TASK_RULE}]\n[Language: ${languageSentence}]`; // DEFECT: template literal interpolation
  return [
    "[ACTIVE USER TASK - CURRENT TURN ONLY]:",
    prompt,
    "",
    "[Task context]:",
    "- The above request is the user's active task for this turn.",
    "- Conversation history provides context and verified progress, not a new execution request.",
    "- Use history to interpret references and answers to the previous assistant question; do not detach a concise follow-up from that question or revive unrelated old tasks.",
    `- ${MINI_SHORT_TASK_RULE}`, // DEFECT: template literal interpolation
    "- Resume earlier unfinished work when the current task asks to continue it; avoid repeating completed work.",
    "- Focus execution on the ACTIVE task above.",
    `- Language: ${languageSentence}`, // DEFECT: template literal interpolation
  ].join("\n"); // DEFECT: JS Array/String method
}

function buildMiniHistoryPayload(
  historyLines: string[],
  protocol: "responses" | "chat" | "anthropic",
  maxChars = MINI_HISTORY_MAX_CHARS,
): { historyBlock: string; recapText: string | null } {
  if (historyLines.length === 0) return { historyBlock: "", recapText: null };
  let hist = headTailHistoryText(historyLines, maxChars);
  return {
    // Framing matters: this block is a COMPLETED record, not standing
    // orders. Without the supremacy clause the model (especially smaller
    // ones) treats the first pinned user request as the current task and
    // redoes it every turn ("only remembers the first task"). The latest
    // live user message below is the ONLY current task.
    historyBlock: `\nConversation history so far (earlier turns for background context; the latest user message below is the current task):\n${hist}\nUse verified progress from history for the current task, including unfinished work when the user asks to continue.\n`, // DEFECT: template literal interpolation
    recapText: protocol === "responses" ? `[earlier conversation - background context only]\n${hist}\n[end of earlier conversation - continue with the task that follows]` : null, // DEFECT: template literal interpolation
  };
}

// Fraction of the model context window a single turn may accumulate. */
let MINI_TURN_INPUT_BUDGET_RATIO = 0.7;
// Floor so tiny windows still get a usable turn before wrap-up. */
let MINI_TURN_INPUT_BUDGET_MIN_TOKENS = 4000;
// Fallback window when the relay reports none. */
let MINI_TURN_INPUT_BUDGET_DEFAULT_WINDOW = 128_000;

// In-turn input budget (tokens): wrap up with text instead of tool calls past this. */
fn miniTurnInputBudgetTokens(contextWindow: f64) -> f64 { // was: function miniTurnInputBudgetTokens
  let window = Number.isFinite(contextWindow) && contextWindow > 0
    ? Math.floor(contextWindow)
    : MINI_TURN_INPUT_BUDGET_DEFAULT_WINDOW;
  return Math.max(MINI_TURN_INPUT_BUDGET_MIN_TOKENS, Math.floor(window * MINI_TURN_INPUT_BUDGET_RATIO));
}

// Marker heading the tail-riding memory digest item (prompt-cache geometry:
 //*  the digest must stay out of the cached prefix). Also used to strip stale
