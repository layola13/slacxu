        }
        rc = mb_s_node(opts, STR_PTR("images"), STR_LEN("images"), images_arr);
        mb_enqueue_run(b, STR_PTR("turn"), STR_LEN("turn"), mb_sp(&thread), thread.len, mb_sp(&turn), turn.len, mb_jp(&prompt), prompt.len, opts);
        *out = res;
        return;
    };
    // default: throw new Error(`Mini backend does not support ${method}`)
    let msg = MbJson { bytes: [0u8; 262144], len: 0 };
    mb_jassign(&msg, STR_PTR("Mini backend does not support "), STR_LEN("Mini backend does not support "));
    mb_jappend(&msg, method_p, method_n);
    mb_throw_j(out_err, out_throw, &msg);
}

// TS: private scheduleGoalAutoContinuation(threadId) — the 1000 ms
// setTimeout lands as a deadline in b.goal_deadlines; the host fires due
// timers via MiniBridge_fire_due_goal_timers (B8c).
fn MiniBridge_schedule_goal_auto_continuation(b: &MiniBridgeState, thread_p: ptr, thread_n: u64) -> void {
    let s: u64 = MiniBridge_get_session(b, thread_p, thread_n);
    if s == 0 { MiniBridge_clear_goal_timer(b, thread_p, thread_n); return; };
    let status = MbStr { bytes: [0u8; 8192], len: 0 };
    let objective = MbStr { bytes: [0u8; 8192], len: 0 };
    let obj_trim = MbStr { bytes: [0u8; 8192], len: 0 };
    if mb_g_str(s, STR_PTR("goalObjective"), STR_LEN("goalObjective"), &objective) { mb_trim_to(mb_sp(&objective), objective.len, &obj_trim); };
    if !mb_g_str(s, STR_PTR("goalStatus"), STR_LEN("goalStatus"), &status) || !mb_bytes_eq(mb_sp(&status), status.len, STR_PTR("active"), STR_LEN("active")) || obj_trim.len == 0 {
        MiniBridge_clear_goal_timer(b, thread_p, thread_n);
        return;
    };
    if isMiniGoalBudgetExhausted(s) {
        let rc: i32 = mb_s_str(s, STR_PTR("goalStatus"), STR_LEN("goalStatus"), STR_PTR("budgetLimited"), STR_LEN("budgetLimited"));
        MiniBridge_clear_goal_timer(b, thread_p, thread_n);
        rc = mb_o_remove(b.goal_counts, thread_p, thread_n);
        MiniBridge_persist(b, s);
        let goal_text = MbJson { bytes: [0u8; 262144], len: 0 };
        miniGoalState(s, &goal_text);
        let gparams: u64 = mb_new_obj();
        rc = mb_s_node(gparams, STR_PTR("goal"), STR_LEN("goal"), mb_parse(mb_jp(&goal_text), goal_text.len));
        mb_emit_note(b, STR_PTR("thread/goal/updated"), STR_LEN("thread/goal/updated"), gparams);
        return;
    };
    if mb_g_has(s, STR_PTR("activeTurnId"), STR_LEN("activeTurnId")) { return; };
    if mb_g_node(b.goal_deadlines, thread_p, thread_n) != 0 { return; };
    let count: i64 = 0;
    let ok_c: bool = mb_g_i64(b.goal_counts, thread_p, thread_n, &count);
    if count >= (MAX_MINI_GOAL_AUTO_CONTINUATIONS() as i64) {
        let rc: i32 = mb_s_str(s, STR_PTR("goalStatus"), STR_LEN("goalStatus"), STR_PTR("blocked"), STR_LEN("blocked"));
        MiniBridge_clear_goal_timer(b, thread_p, thread_n);
        rc = mb_o_remove(b.goal_counts, thread_p, thread_n);
        MiniBridge_persist(b, s);
        let goal_text = MbJson { bytes: [0u8; 262144], len: 0 };
        miniGoalState(s, &goal_text);
        let gparams: u64 = mb_new_obj();
        rc = mb_s_node(gparams, STR_PTR("goal"), STR_LEN("goal"), mb_parse(mb_jp(&goal_text), goal_text.len));
        mb_emit_note(b, STR_PTR("thread/goal/updated"), STR_LEN("thread/goal/updated"), gparams);
        return;
    };
    let rc2: i32 = mb_s_i64(b.goal_deadlines, thread_p, thread_n, mb_now_ms() + 1000);
}
// fs/readFile + fs/writeFile target resolution (TS: isAbsolute / "~" / join).
// POSIX separators (B0 path-op registration covers the win32 divergence).
fn mb_resolve_fs_target(cwd_p: ptr, cwd_n: u64, path_p: ptr, path_n: u64, out: &MbJson) -> void {
    let is_abs: bool = path_n > 0 && mb_byte_at(path_p, 0) == 47;
    let is_tilde: bool = path_n > 0 && mb_byte_at(path_p, 0) == 126;
    mb_jclear(out);
    if is_abs || is_tilde {
        mb_jappend(out, path_p, path_n);
        return;
    };
    mb_jappend(out, cwd_p, cwd_n);
    if cwd_n > 0 && mb_byte_at(cwd_p, cwd_n - 1) != 47 { mb_jpush(out, 47); };
    mb_jappend(out, path_p, path_n);
}
fn mb_dirname(p: ptr, n: u64, out: &MbStr) -> void {
    out.len = 0;
    let i: u64 = n;
    let last: i64 = 0 - 1;
    while i > 0 {
        i = i - 1;
        if mb_byte_at(p, i) == 47 { last = i as i64; break; };
    }
    if last < 0 { mb_sassign(out, STR_PTR("."), STR_LEN(".")); return; };
    if last == 0 { mb_sassign(out, STR_PTR("/"), STR_LEN("/")); return; };
    mb_slice_to_s(p, n, 0, last as u64, out);
}
// Build a JSON string doc from raw text (JSON-escaped).
fn mb_str_doc(text_p: ptr, text_n: u64, out: &u64) -> void {
    let esc = MbJson { bytes: [0u8; 262144], len: 0 };
    mb_jpush(&esc, 34);
    let i: u64 = 0;
    while i < text_n {
        let byte: u8 = mb_byte_at(text_p, i);
        if byte == 34 || byte == 92 {
            mb_jpush(&esc, 92);
            mb_jpush(&esc, byte);
        } else if byte == 10 {
            mb_jappend(&esc, STR_PTR("\\n"), STR_LEN("\\n"));
        } else if byte == 13 {
            mb_jappend(&esc, STR_PTR("\\r"), STR_LEN("\\r"));
        } else if byte == 9 {
            mb_jappend(&esc, STR_PTR("\\t"), STR_LEN("\\t"));
        } else if byte < 32 {
            mb_jappend(&esc, STR_PTR("\\u00"), STR_LEN("\\u00"));
            let hi: u8 = byte / 16;
            let lo: u8 = byte % 16;
            mb_jpush(&esc, if hi < 10 { 48 + hi } else { 87 + hi });
            mb_jpush(&esc, if lo < 10 { 48 + lo } else { 87 + lo });
        } else {
            mb_jpush(&esc, byte);
        };
        i = i + 1;
    }
    mb_jpush(&esc, 34);
    *out = mb_parse(mb_jp(&esc), esc.len);
}

// TS: goalContinuationTurnKeys.delete(`${threadId}:${turnId}`) helper.
fn mb_delete_goal_turn_key(b: &MiniBridgeState, tid_p: ptr, tid_n: u64, turn_p: ptr, turn_n: u64) -> void {
    let gkey = MbJson { bytes: [0u8; 262144], len: 0 };
    mb_key2(tid_p, tid_n, 58, turn_p, turn_n, &gkey);
    let count: u64 = mb_n_count(b.goal_turn_keys);
    let i: u64 = 0;
    while i < count {
        let entry = MbStr { bytes: [0u8; 8192], len: 0 };
        if mb_n_str(mb_a_at(b.goal_turn_keys, i), &entry) && mb_bytes_eq(mb_sp(&entry), entry.len, mb_jp(&gkey), gkey.len) {
            mb_arr_remove_at(&b.goal_turn_keys, i);
            return;
        };
        i = i + 1;
    }
}
// TS: private completeTurn(s, turnId, text, opts).
fn MiniBridge_complete_turn(b: &MiniBridgeState, handlers: &ServerHookHandlers, s: u64, turn_p: ptr, turn_n: u64, text_p: ptr, text_n: u64, system_turn: bool) -> void {
    let turn: u64 = mb_sess_turn(s, turn_p, turn_n);
    if turn == 0 { return; };
    let tstatus = MbStr { bytes: [0u8; 8192], len: 0 };
    let has_ts: bool = mb_g_str(turn, STR_PTR("status"), STR_LEN("status"), &tstatus);
    if !mb_bytes_eq(mb_sp(&tstatus), tstatus.len, STR_PTR("inProgress"), STR_LEN("inProgress")) { return; };
    let active = MbStr { bytes: [0u8; 8192], len: 0 };
    if !mb_g_str(s, STR_PTR("activeTurnId"), STR_LEN("activeTurnId"), &active) { return; };
    if !mb_bytes_eq(mb_sp(&active), active.len, turn_p, turn_n) { return; };
    if isMiniTurnCancelled(s, turn_p, turn_n) { return; };
    let tid = MbStr { bytes: [0u8; 8192], len: 0 };
    let has_tid: bool = mb_g_str(s, STR_PTR("threadId"), STR_LEN("threadId"), &tid);
    MiniBridge_flush_deltas(b, mb_sp(&tid), tid.len, turn_p, turn_n);
    MiniBridge_emit_retry_recovered_if_needed(b, s, turn_p, turn_n);
    let item: u64 = mb_new_obj();
    let rc: i32 = mb_s_str(item, STR_PTR("type"), STR_LEN("type"), STR_PTR("agentMessage"), STR_LEN("agentMessage"));
    let iid = MbJson { bytes: [0u8; 262144], len: 0 };
    mb_jassign(&iid, STR_PTR("mini-msg-"), STR_LEN("mini-msg-"));
    mb_jappend(&iid, turn_p, turn_n);
    rc = mb_s_str(item, STR_PTR("id"), STR_LEN("id"), mb_jp(&iid), iid.len);
    rc = mb_s_str(item, STR_PTR("turnId"), STR_LEN("turnId"), turn_p, turn_n);
    rc = mb_s_str(item, STR_PTR("threadId"), STR_LEN("threadId"), mb_sp(&tid), tid.len);
    rc = mb_s_str(item, STR_PTR("role"), STR_LEN("role"), STR_PTR("assistant"), STR_LEN("assistant"));
    rc = mb_s_str(item, STR_PTR("status"), STR_LEN("status"), STR_PTR("completed"), STR_LEN("completed"));
    rc = mb_s_str(item, STR_PTR("text"), STR_LEN("text"), text_p, text_n);
    let content: u64 = mb_new_arr();
    let block: u64 = mb_new_obj();
    rc = mb_s_str(block, STR_PTR("type"), STR_LEN("type"), STR_PTR("text"), STR_LEN("text"));
    rc = mb_s_str(block, STR_PTR("text"), STR_LEN("text"), text_p, text_n);
    rc = mb_a_push_node(content, block);
    rc = mb_s_node(item, STR_PTR("content"), STR_LEN("content"), content);
    let messages: u64 = mb_g_node(s, STR_PTR("messages"), STR_LEN("messages"));
    rc = mb_a_push_node(messages, mb_clone_node(item));
    rc = mb_s_str(turn, STR_PTR("status"), STR_LEN("status"), STR_PTR("completed"), STR_LEN("completed"));
    mb_sess_clear_active(s);
    mb_delete_goal_turn_key(b, mb_sp(&tid), tid.len, turn_p, turn_n);
    MiniBridge_persist(b, s);
    let params: u64 = mb_turn_params(s, turn_p, turn_n);
    rc = mb_s_node(params, STR_PTR("item"), STR_LEN("item"), item);
    mb_emit_note(b, STR_PTR("item/completed"), STR_LEN("item/completed"), params);
    mb_emit_turn_settled(b, s, turn_p, turn_n, STR_PTR("turn/completed"), STR_LEN("turn/completed"), STR_PTR("completed"), STR_LEN("completed"));
    mb_fire_finish_hook(handlers, s, turn_p, turn_n, STR_PTR("completed"), STR_LEN("completed"), text_p, text_n);
    MiniBridge_drain_queued_turn(b, handlers, s);
    if !isMiniTurnCancelled(s, turn_p, turn_n) {
        MiniBridge_settle_goal_after_turn(b, s, turn_p, turn_n, text_p, text_n, system_turn);
    };
}
// TS: private drainQueuedTurn(s) — shift happens before the active check.
fn MiniBridge_drain_queued_turn(b: &MiniBridgeState, handlers: &ServerHookHandlers, s: u64) -> void {
    let queued: u64 = mb_g_node(s, STR_PTR("queuedTurns"), STR_LEN("queuedTurns"));
    if queued == 0 || mb_n_count(queued) == 0 { return; };
    let next: u64 = mb_a_at(queued, 0);
    let rest: u64 = queued;
    mb_arr_remove_at(&rest, 0);
    let rc0: i32 = mb_s_node(s, STR_PTR("queuedTurns"), STR_LEN("queuedTurns"), rest);
    if mb_g_has(s, STR_PTR("activeTurnId"), STR_LEN("activeTurnId")) { return; };
    let tid = MbStr { bytes: [0u8; 8192], len: 0 };
    let has_tid: bool = mb_g_str(s, STR_PTR("threadId"), STR_LEN("threadId"), &tid);
    let text = MbStr { bytes: [0u8; 8192], len: 0 };
    let has_text: bool = mb_g_str(next, STR_PTR("text"), STR_LEN("text"), &text);
    let turn = MbStr { bytes: [0u8; 8192], len: 0 };
    mb_new_uuid(&turn);
    let user_item: u64 = mb_new_obj();
    let rc: i32 = mb_s_str(user_item, STR_PTR("type"), STR_LEN("type"), STR_PTR("userMessage"), STR_LEN("userMessage"));
    let iid = MbJson { bytes: [0u8; 262144], len: 0 };
    mb_jassign(&iid, STR_PTR("mini-user-"), STR_LEN("mini-user-"));
    mb_jappend(&iid, mb_sp(&turn), turn.len);
    rc = mb_s_str(user_item, STR_PTR("id"), STR_LEN("id"), mb_jp(&iid), iid.len);
    rc = mb_s_str(user_item, STR_PTR("turnId"), STR_LEN("turnId"), mb_sp(&turn), turn.len);
    rc = mb_s_str(user_item, STR_PTR("threadId"), STR_LEN("threadId"), mb_sp(&tid), tid.len);
    rc = mb_s_str(user_item, STR_PTR("text"), STR_LEN("text"), mb_sp(&text), text.len);
    let content: u64 = mb_new_arr();
    if text.len > 0 {
        let block: u64 = mb_new_obj();
        rc = mb_s_str(block, STR_PTR("type"), STR_LEN("type"), STR_PTR("text"), STR_LEN("text"));
        rc = mb_s_str(block, STR_PTR("text"), STR_LEN("text"), mb_sp(&text), text.len);
        rc = mb_a_push_node(content, block);
    };
    let images: u64 = mb_g_node(next, STR_PTR("images"), STR_LEN("images"));
    let opts: u64 = mb_new_obj();
    if images != 0 && mb_kind(images) == MB_JK_ARRAY {
        let ic: u64 = mb_n_count(images);
        let ii: u64 = 0;
        while ii < ic {
            let img: u64 = mb_a_at(images, ii);
            if img != 0 {
                let block: u64 = mb_new_obj();
                rc = mb_s_str(block, STR_PTR("type"), STR_LEN("type"), STR_PTR("image"), STR_LEN("image"));
                let url = MbStr { bytes: [0u8; 8192], len: 0 };
                let ok_u: bool = mb_g_str(img, STR_PTR("url"), STR_LEN("url"), &url);
                rc = mb_s_str(block, STR_PTR("url"), STR_LEN("url"), mb_sp(&url), url.len);
                let det = MbStr { bytes: [0u8; 8192], len: 0 };
                if !mb_g_str(img, STR_PTR("detail"), STR_LEN("detail"), &det) { mb_sassign(&det, STR_PTR("auto"), STR_LEN("auto")); };
                rc = mb_s_str(block, STR_PTR("detail"), STR_LEN("detail"), mb_sp(&det), det.len);
                rc = mb_a_push_node(content, block);
            };
            ii = ii + 1;
        }
        rc = mb_s_node(opts, STR_PTR("images"), STR_LEN("images"), mb_clone_node(images));
    };
    rc = mb_s_node(user_item, STR_PTR("content"), STR_LEN("content"), content);
    rc = mb_s_str(user_item, STR_PTR("role"), STR_LEN("role"), STR_PTR("user"), STR_LEN("user"));
    rc = mb_s_str(user_item, STR_PTR("status"), STR_LEN("status"), STR_PTR("completed"), STR_LEN("completed"));
    let messages: u64 = mb_g_node(s, STR_PTR("messages"), STR_LEN("messages"));
    rc = mb_a_push_node(messages, user_item);
    let turn_rec: u64 = mb_new_obj();
    rc = mb_s_str(turn_rec, STR_PTR("id"), STR_LEN("id"), mb_sp(&turn), turn.len);
    rc = mb_s_str(turn_rec, STR_PTR("status"), STR_LEN("status"), STR_PTR("inProgress"), STR_LEN("inProgress"));
    rc = mb_s_i64(turn_rec, STR_PTR("createdAt"), STR_LEN("createdAt"), mb_now_ms());
    let turns: u64 = mb_g_node(s, STR_PTR("turns"), STR_LEN("turns"));
    rc = mb_a_push_node(turns, turn_rec);
    rc = mb_s_str(s, STR_PTR("activeTurnId"), STR_LEN("activeTurnId"), mb_sp(&turn), turn.len);
    rc = mb_s_bool(s, STR_PTR("aborted"), STR_LEN("aborted"), false);
    rc = mb_s_bool(s, STR_PTR("activeAbort"), STR_LEN("activeAbort"), true);
    if !mb_g_has(s, STR_PTR("preview"), STR_LEN("preview")) {
        let p80 = MbStr { bytes: [0u8; 8192], len: 0 };
        mb_slice_to_s(mb_sp(&text), text.len, 0, 80, &p80);
        rc = mb_s_str(s, STR_PTR("preview"), STR_LEN("preview"), mb_sp(&p80), p80.len);
    };
    MiniBridge_persist(b, s);
    let params: u64 = mb_new_obj();
    rc = mb_s_str(params, STR_PTR("threadId"), STR_LEN("threadId"), mb_sp(&tid), tid.len);
    rc = mb_s_str(params, STR_PTR("turnId"), STR_LEN("turnId"), mb_sp(&turn), turn.len);
    let turn_obj: u64 = mb_new_obj();
    rc = mb_s_str(turn_obj, STR_PTR("id"), STR_LEN("id"), mb_sp(&turn), turn.len);
    rc = mb_s_str(turn_obj, STR_PTR("threadId"), STR_LEN("threadId"), mb_sp(&tid), tid.len);
    rc = mb_s_str(turn_obj, STR_PTR("status"), STR_LEN("status"), STR_PTR("inProgress"), STR_LEN("inProgress"));
    rc = mb_s_node(params, STR_PTR("turn"), STR_LEN("turn"), turn_obj);
    mb_emit_note(b, STR_PTR("turn/started"), STR_LEN("turn/started"), params);
    let params2: u64 = mb_new_obj();
    rc = mb_s_str(params2, STR_PTR("threadId"), STR_LEN("threadId"), mb_sp(&tid), tid.len);
    rc = mb_s_str(params2, STR_PTR("turnId"), STR_LEN("turnId"), mb_sp(&turn), turn.len);
    rc = mb_s_node(params2, STR_PTR("item"), STR_LEN("item"), mb_clone_node(user_item));
    mb_emit_note(b, STR_PTR("item/completed"), STR_LEN("item/completed"), params2);
    mb_enqueue_run(b, STR_PTR("turn"), STR_LEN("turn"), mb_sp(&tid), tid.len, mb_sp(&turn), turn.len, mb_sp(&text), text.len, opts);
}
// TS: private settleGoalAfterTurn(s, turnId, text, opts).
fn MiniBridge_settle_goal_after_turn(b: &MiniBridgeState, s: u64, turn_p: ptr, turn_n: u64, text_p: ptr, text_n: u64, system_turn: bool) -> void {
    let status = MbStr { bytes: [0u8; 8192], len: 0 };
    if !mb_g_str(s, STR_PTR("goalStatus"), STR_LEN("goalStatus"), &status) { return; };
    if !mb_bytes_eq(mb_sp(&status), status.len, STR_PTR("active"), STR_LEN("active")) { return; };
    let objective = MbStr { bytes: [0u8; 8192], len: 0 };
    if !mb_g_str(s, STR_PTR("goalObjective"), STR_LEN("goalObjective"), &objective) { return; };
    let obj_trim = MbStr { bytes: [0u8; 8192], len: 0 };
    mb_trim_to(mb_sp(&objective), objective.len, &obj_trim);
    if obj_trim.len == 0 { return; };
    let tid = MbStr { bytes: [0u8; 8192], len: 0 };
    let has_tid: bool = mb_g_str(s, STR_PTR("threadId"), STR_LEN("threadId"), &tid);
    if !system_turn && hasGoalCompleteSignal(text_p, text_n) {
        let rc: i32 = mb_s_str(s, STR_PTR("goalStatus"), STR_LEN("goalStatus"), STR_PTR("complete"), STR_LEN("complete"));
        rc = mb_s_i64(s, STR_PTR("goalStagnantTurns"), STR_LEN("goalStagnantTurns"), 0);
        MiniBridge_clear_goal_timer(b, mb_sp(&tid), tid.len);
        rc = mb_o_remove(b.goal_counts, mb_sp(&tid), tid.len);
        MiniBridge_persist(b, s);
        let goal_text = MbJson { bytes: [0u8; 262144], len: 0 };
        miniGoalState(s, &goal_text);
        let gparams: u64 = mb_new_obj();
        rc = mb_s_node(gparams, STR_PTR("goal"), STR_LEN("goal"), mb_parse(mb_jp(&goal_text), goal_text.len));
        mb_emit_note(b, STR_PTR("thread/goal/updated"), STR_LEN("thread/goal/updated"), gparams);
        return;
    };
    let messages: u64 = mb_g_node(s, STR_PTR("messages"), STR_LEN("messages"));
    let fingerprint = MbJson { bytes: [0u8; 262144], len: 0 };
    miniGoalTurnFingerprint(messages, turn_p, turn_n, &fingerprint);
    if fingerprint.len == 0 || system_turn {
        MiniBridge_persist(b, s);
        MiniBridge_schedule_goal_auto_continuation(b, mb_sp(&tid), tid.len);
        return;
    };
    let tool_fp = MbStr { bytes: [0u8; 8192], len: 0 };
    miniGoalToolFingerprint(messages, turn_p, turn_n, &tool_fp);
    let stagnant: bool = noteMiniGoalTurnProgress(s, mb_jp(&fingerprint), fingerprint.len, mb_sp(&tool_fp), tool_fp.len, tool_fp.len > 0);
    if stagnant {
        let rc: i32 = mb_s_str(s, STR_PTR("goalStatus"), STR_LEN("goalStatus"), STR_PTR("blocked"), STR_LEN("blocked"));
        MiniBridge_clear_goal_timer(b, mb_sp(&tid), tid.len);
        rc = mb_o_remove(b.goal_counts, mb_sp(&tid), tid.len);
        MiniBridge_persist(b, s);
        let goal_text = MbJson { bytes: [0u8; 262144], len: 0 };
        miniGoalState(s, &goal_text);
        let gparams: u64 = mb_new_obj();
        rc = mb_s_node(gparams, STR_PTR("goal"), STR_LEN("goal"), mb_parse(mb_jp(&goal_text), goal_text.len));
        mb_emit_note(b, STR_PTR("thread/goal/updated"), STR_LEN("thread/goal/updated"), gparams);
        return;
    };
    MiniBridge_persist(b, s);
    MiniBridge_schedule_goal_auto_continuation(b, mb_sp(&tid), tid.len);
}
// TS: private async startGoalContinuationTurn(threadId) — the awaited
// runMiniTurn lands as a pending_runs enqueue (see the B8 header note).
fn MiniBridge_start_goal_continuation_turn(b: &MiniBridgeState, thread_p: ptr, thread_n: u64) -> void {
    let s: u64 = MiniBridge_get_session(b, thread_p, thread_n);
    if s == 0 { return; };
    if mb_g_has(s, STR_PTR("activeTurnId"), STR_LEN("activeTurnId")) { return; };
    let status = MbStr { bytes: [0u8; 8192], len: 0 };
    if !mb_g_str(s, STR_PTR("goalStatus"), STR_LEN("goalStatus"), &status) { return; };
    if !mb_bytes_eq(mb_sp(&status), status.len, STR_PTR("active"), STR_LEN("active")) { return; };
    let objective = MbStr { bytes: [0u8; 8192], len: 0 };
    if !mb_g_str(s, STR_PTR("goalObjective"), STR_LEN("goalObjective"), &objective) { return; };
    let obj_trim = MbStr { bytes: [0u8; 8192], len: 0 };
    mb_trim_to(mb_sp(&objective), objective.len, &obj_trim);
    if obj_trim.len == 0 { return; };
    if isMiniGoalBudgetExhausted(s) {
        let rc0: i32 = mb_s_str(s, STR_PTR("goalStatus"), STR_LEN("goalStatus"), STR_PTR("budgetLimited"), STR_LEN("budgetLimited"));
        MiniBridge_clear_goal_timer(b, thread_p, thread_n);
        rc0 = mb_o_remove(b.goal_counts, thread_p, thread_n);
        MiniBridge_persist(b, s);
        let goal_text0 = MbJson { bytes: [0u8; 262144], len: 0 };
        miniGoalState(s, &goal_text0);
        let gparams0: u64 = mb_new_obj();
        rc0 = mb_s_node(gparams0, STR_PTR("goal"), STR_LEN("goal"), mb_parse(mb_jp(&goal_text0), goal_text0.len));
        mb_emit_note(b, STR_PTR("thread/goal/updated"), STR_LEN("thread/goal/updated"), gparams0);
        return;
    };
    let turn = MbStr { bytes: [0u8; 8192], len: 0 };
    mb_new_uuid(&turn);
    let count: i64 = 0;
    let ok_c: bool = mb_g_i64(b.goal_counts, thread_p, thread_n, &count);
    let next_count: i64 = count + 1;
    let rc: i32 = mb_s_i64(b.goal_counts, thread_p, thread_n, next_count);
    let messages: u64 = mb_g_node(s, STR_PTR("messages"), STR_LEN("messages"));
    let plan_text = MbJson { bytes: [0u8; 262144], len: 0 };
    let steps: u64 = 0;
    restoreMiniPlan(messages, &steps);
    let has_plan: bool = false;
    if steps != 0 && mb_n_count(steps) > 0 {
        formatMiniPlanText(steps, &plan_text);
        has_plan = plan_text.len > 0;
    };
    let stagnant: i64 = 0;
    let ok_st: bool = mb_g_i64(s, STR_PTR("goalStagnantTurns"), STR_LEN("goalStagnantTurns"), &stagnant);
    let prompt_text = MbJson { bytes: [0u8; 262144], len: 0 };
    buildMiniGoalContinuationPrompt(s, next_count, MAX_MINI_GOAL_AUTO_CONTINUATIONS() as i64, mb_jp(&plan_text), plan_text.len, has_plan, stagnant, true, &prompt_text);
    let user_item: u64 = mb_new_obj();
    rc = mb_s_str(user_item, STR_PTR("type"), STR_LEN("type"), STR_PTR("goalContinuation"), STR_LEN("goalContinuation"));
    let iid = MbJson { bytes: [0u8; 262144], len: 0 };
    mb_jassign(&iid, STR_PTR("mini-goal-"), STR_LEN("mini-goal-"));
    mb_jappend(&iid, mb_sp(&turn), turn.len);
    rc = mb_s_str(user_item, STR_PTR("id"), STR_LEN("id"), mb_jp(&iid), iid.len);
    rc = mb_s_str(user_item, STR_PTR("turnId"), STR_LEN("turnId"), mb_sp(&turn), turn.len);
    rc = mb_s_str(user_item, STR_PTR("threadId"), STR_LEN("threadId"), thread_p, thread_n);
    rc = mb_s_str(user_item, STR_PTR("text"), STR_LEN("text"), mb_jp(&prompt_text), prompt_text.len);
    let content: u64 = mb_new_arr();
    let block: u64 = mb_new_obj();
    rc = mb_s_str(block, STR_PTR("type"), STR_LEN("type"), STR_PTR("text"), STR_LEN("text"));
    rc = mb_s_str(block, STR_PTR("text"), STR_LEN("text"), mb_jp(&prompt_text), prompt_text.len);
    rc = mb_a_push_node(content, block);
    rc = mb_s_node(user_item, STR_PTR("content"), STR_LEN("content"), content);
    rc = mb_s_str(user_item, STR_PTR("role"), STR_LEN("role"), STR_PTR("user"), STR_LEN("user"));
    rc = mb_s_str(user_item, STR_PTR("status"), STR_LEN("status"), STR_PTR("completed"), STR_LEN("completed"));
    rc = mb_a_push_node(messages, user_item);
    let turn_rec: u64 = mb_new_obj();
    rc = mb_s_str(turn_rec, STR_PTR("id"), STR_LEN("id"), mb_sp(&turn), turn.len);
    rc = mb_s_str(turn_rec, STR_PTR("status"), STR_LEN("status"), STR_PTR("inProgress"), STR_LEN("inProgress"));
    rc = mb_s_i64(turn_rec, STR_PTR("createdAt"), STR_LEN("createdAt"), mb_now_ms());
    let turns: u64 = mb_g_node(s, STR_PTR("turns"), STR_LEN("turns"));
    rc = mb_a_push_node(turns, turn_rec);
    rc = mb_s_str(s, STR_PTR("activeTurnId"), STR_LEN("activeTurnId"), mb_sp(&turn), turn.len);
    rc = mb_s_bool(s, STR_PTR("aborted"), STR_LEN("aborted"), false);
    rc = mb_s_bool(s, STR_PTR("activeAbort"), STR_LEN("activeAbort"), true);
    let gkey = MbJson { bytes: [0u8; 262144], len: 0 };
    mb_key2(thread_p, thread_n, 58, mb_sp(&turn), turn.len, &gkey);
    rc = mb_a_push_str(b.goal_turn_keys, mb_jp(&gkey), gkey.len);
    MiniBridge_persist(b, s);
    let params: u64 = mb_new_obj();
    rc = mb_s_str(params, STR_PTR("threadId"), STR_LEN("threadId"), thread_p, thread_n);
    rc = mb_s_str(params, STR_PTR("turnId"), STR_LEN("turnId"), mb_sp(&turn), turn.len);
    let turn_obj: u64 = mb_new_obj();
    rc = mb_s_str(turn_obj, STR_PTR("id"), STR_LEN("id"), mb_sp(&turn), turn.len);
    rc = mb_s_str(turn_obj, STR_PTR("threadId"), STR_LEN("threadId"), thread_p, thread_n);
    rc = mb_s_str(turn_obj, STR_PTR("status"), STR_LEN("status"), STR_PTR("inProgress"), STR_LEN("inProgress"));
    rc = mb_s_node(params, STR_PTR("turn"), STR_LEN("turn"), turn_obj);
    mb_emit_note(b, STR_PTR("turn/started"), STR_LEN("turn/started"), params);
    let params2: u64 = mb_new_obj();
    rc = mb_s_str(params2, STR_PTR("threadId"), STR_LEN("threadId"), thread_p, thread_n);
    rc = mb_s_str(params2, STR_PTR("turnId"), STR_LEN("turnId"), mb_sp(&turn), turn.len);
    rc = mb_s_node(params2, STR_PTR("item"), STR_LEN("item"), mb_clone_node(user_item));
    mb_emit_note(b, STR_PTR("item/completed"), STR_LEN("item/completed"), params2);
    mb_enqueue_run(b, STR_PTR("turn"), STR_LEN("turn"), thread_p, thread_n, mb_sp(&turn), turn.len, mb_jp(&prompt_text), prompt_text.len, mb_new_obj());
}
// Host seam: fire goal-continuation timers whose deadline has passed.
fn MiniBridge_fire_due_goal_timers(b: &MiniBridgeState) -> void {
    let guard: u64 = 0;
    while guard < 4096 {
        guard = guard + 1;
        let count: u64 = mb_n_count(b.goal_deadlines);
        if count == 0 { return; };
        let now: i64 = mb_now_ms();
        let found: bool = false;
        let fkey = MbJson { bytes: [0u8; 262144], len: 0 };
        let i: u64 = 0;
        while i < count && !found {
            let kp: ptr = PTR_NULL();
            let kn: u64 = 0;
            if mb_key_at(b.goal_deadlines, i, &kp, &kn) {
                let dl: i64 = 0;
                let node: u64 = mb_g_node(b.goal_deadlines, kp, kn);
                if mb_n_i64(node, &dl) && dl <= now {
                    mb_jassign(&fkey, kp, kn);
                    found = true;
                };
            };
            i = i + 1;
        }
        if !found { return; };
        let rc: i32 = mb_o_remove(b.goal_deadlines, mb_jp(&fkey), fkey.len);
        MiniBridge_start_goal_continuation_turn(b, mb_jp(&fkey), fkey.len);
    }
}
// TS: private async answerStatus(s, turnId).
// ASYNC landing: blocking-contract — skills.list / findAgentsMdProjectRoot /
// collectAgentsMdFiles / resolveTarget are all blocking extern surfaces in
// their SLA ports; the .catch(() => ...) shapes land as status checks.
fn MiniBridge_answer_status(b: &MiniBridgeState, cache: &MiniMcpCacheState, handlers: &ServerHookHandlers, s: u64, turn_p: ptr, turn_n: u64) -> void {
    let cwd = MbStr { bytes: [0u8; 8192], len: 0 };
    let has_cwd: bool = mb_g_str(s, STR_PTR("cwd"), STR_LEN("cwd"), &cwd);
    let cwds = PathTable { items: [BigBuf { bytes: [0; 131072], len: 0 }; 64], count: 0 };
    bb_append(&cwds.items[0], mb_sp(&cwd), cwd.len);
    cwds.count = 1;
    let groups = ClaudeSkillGroupSet { items: [ClaudeSkillGroup { cwd: [0; 4096], cwd_len: 0, skills: [ClaudeSkillEntry { name: [0; 256], name_len: 0, description: [0; 4096], description_len: 0, path: [0; 4096], path_len: 0, scope: 0, enabled: false }; 256], skills_count: 0, errors: [SkillError { path: [0; 4096], path_len: 0, message: [0; 4096], message_len: 0 }; 64], errors_count: 0 }; 64], count: 0 };
    claudeSkillInventory_list(&b.skills, &cwds, &groups);
    let skill_names = MbJson { bytes: [0u8; 262144], len: 0 };
    let gi: u64 = 0;
    while gi < groups.count && gi < 64 {
        let ki: u64 = 0;
        while ki < groups.items[gi].skills_count && ki < 256 {
            if groups.items[gi].skills[ki].enabled {
                if skill_names.len > 0 { mb_jappend(&skill_names, STR_PTR(", "), STR_LEN(", ")); };
                let np: ptr = PTR_NULL();
                PTR_BYTE_ADD(np, &groups.items[gi].skills[ki].name, 0);
                mb_jappend(&skill_names, np, groups.items[gi].skills[ki].name_len);
            };
            ki = ki + 1;
        }
        gi = gi + 1;
    }
    if skill_names.len == 0 { mb_jassign(&skill_names, STR_PTR("none"), STR_LEN("none")); };
    let agents_md = MbJson { bytes: [0u8; 262144], len: 0 };
    mb_jassign(&agents_md, STR_PTR("off"), STR_LEN("off"));
    let mode = MbStr { bytes: [0u8; 8192], len: 0 };
    let mrc: i32 = miniAgentsMdMode(mb_sp(&mode), &mode.len);
    if !mb_bytes_eq(mb_sp(&mode), mode.len, STR_PTR("off"), STR_LEN("off")) {
        let root = MbStr { bytes: [0u8; 8192], len: 0 };
        let rrc: i32 = findAgentsMdProjectRoot(mb_sp(&cwd), cwd.len, mb_sp(&root), &root.len);
        if rrc != 0 {
            mb_jassign(&agents_md, STR_PTR("unavailable"), STR_LEN("unavailable"));
        } else {
            let files: [AgentsMdFile; 64] = [AgentsMdFile { path: [0; 1024], path_len: 0, scopeDir: [0; 1024], scopeDir_len: 0, content: [0; 16384], content_len: 0, truncated: false }; 64];
            let flen: u64 = 0;
            let crc2: i32 = collectAgentsMdFiles(mb_sp(&root), root.len, mb_sp(&cwd), cwd.len, mb_sp(&mode), mode.len, &files[0], &flen);
            if crc2 != 0 {
                mb_jassign(&agents_md, STR_PTR("unavailable"), STR_LEN("unavailable"));
            } else {
                let n_s = MbStr { bytes: [0u8; 8192], len: 0 };
                mb_u64_to_s(flen, &n_s);
                mb_jclear(&agents_md);
                mb_jappend(&agents_md, mb_sp(&n_s), n_s.len);
                mb_jappend(&agents_md, STR_PTR(" file(s)"), STR_LEN(" file(s)"));
            };
        };
    };
    let window_line = MbJson { bytes: [0u8; 262144], len: 0 };
    let lcw_node: u64 = mb_g_node(s, STR_PTR("lastContextWindow"), STR_LEN("lastContextWindow"));
    let lcw: f64 = 0.0;
    if lcw_node != 0 && mb_num_finite(lcw_node, &lcw) {
        let n_s = MbStr { bytes: [0u8; 8192], len: 0 };
        mb_i64_to_s(mb_round_half(lcw) as i64, &n_s);
        mb_jappend(&window_line, mb_sp(&n_s), n_s.len);
        mb_jappend(&window_line, STR_PTR(" (last turn)"), STR_LEN(" (last turn)"));
    } else {
        mb_jassign(&window_line, STR_PTR("unknown"), STR_LEN("unknown"));
    };
    let target: u64 = 0;
    let terr = MbJson { bytes: [0u8; 262144], len: 0 };
    let tthrow: bool = false;
    MiniBridge_resolve_target(b, s, &target, &terr, &tthrow);
    if !tthrow && target != 0 {
        let resolved_cw: i64 = 0;
        MiniBridge_resolve_session_context_window(s, target, &resolved_cw);
        let n_s = MbStr { bytes: [0u8; 8192], len: 0 };
        mb_i64_to_s(resolved_cw, &n_s);
        mb_jclear(&window_line);
        mb_jappend(&window_line, mb_sp(&n_s), n_s.len);
        mb_jappend(&window_line, STR_PTR(" (resolved)"), STR_LEN(" (resolved)"));
    };
    let tid = MbStr { bytes: [0u8; 8192], len: 0 };
    let has_tid: bool = mb_g_str(s, STR_PTR("threadId"), STR_LEN("threadId"), &tid);
    let model = MbStr { bytes: [0u8; 8192], len: 0 };
    let has_model: bool = mb_g_str(s, STR_PTR("model"), STR_LEN("model"), &model);
    let eff = MbStr { bytes: [0u8; 8192], len: 0 };
    if !mb_g_str(s, STR_PTR("effort"), STR_LEN("effort"), &eff) { mb_sassign(&eff, STR_PTR("medium"), STR_LEN("medium")); };
    let prov = MbStr { bytes: [0u8; 8192], len: 0 };
    if !mb_g_str(s, STR_PTR("providerId"), STR_LEN("providerId"), &prov) { mb_sassign(&prov, STR_PTR("(env)"), STR_LEN("(env)")); };
    let grp = MbStr { bytes: [0u8; 8192], len: 0 };
    if !mb_g_str(s, STR_PTR("groupId"), STR_LEN("groupId"), &grp) { mb_sassign(&grp, STR_PTR("(default)"), STR_LEN("(default)")); };
    let turns_node: u64 = mb_g_node(s, STR_PTR("turns"), STR_LEN("turns"));
    let msgs_node: u64 = mb_g_node(s, STR_PTR("messages"), STR_LEN("messages"));
    let tcount: u64 = mb_n_count(turns_node);
    let mcount: u64 = mb_n_count(msgs_node);
    let pct: i64 = mb_round_half(miniAutoCompactThreshold()) as i64;
    let mcp_line = MbStr { bytes: [0u8; 8192], len: 0 };
    let lrc: i32 = miniMcpStatusLine(cache, mb_sp(&mcp_line), &mcp_line.len);
    let text = MbJson { bytes: [0u8; 262144], len: 0 };
    mb_jappend(&text, STR_PTR("mini-codex status: ok\nthread: "), STR_LEN("mini-codex status: ok\nthread: "));
    mb_jappend(&text, mb_sp(&tid), tid.len);
    mb_jappend(&text, STR_PTR("\nmodel: "), STR_LEN("\nmodel: "));
    mb_jappend(&text, mb_sp(&model), model.len);
    mb_jappend(&text, STR_PTR("\neffort: "), STR_LEN("\neffort: "));
    mb_jappend(&text, mb_sp(&eff), eff.len);
    mb_jappend(&text, STR_PTR("\ncwd: "), STR_LEN("\ncwd: "));
    mb_jappend(&text, mb_sp(&cwd), cwd.len);
    mb_jappend(&text, STR_PTR("\nrelay: "), STR_LEN("\nrelay: "));
    mb_jappend(&text, mb_sp(&prov), prov.len);
    mb_jappend(&text, STR_PTR(" / "), STR_LEN(" / "));
    mb_jappend(&text, mb_sp(&grp), grp.len);
    mb_jappend(&text, STR_PTR("\nwindow: "), STR_LEN("\nwindow: "));
    mb_jappend(&text, mb_jp(&window_line), window_line.len);
    mb_jappend(&text, STR_PTR(", auto-compact at "), STR_LEN(", auto-compact at "));
    let pct_s = MbStr { bytes: [0u8; 8192], len: 0 };
    mb_i64_to_s(pct, &pct_s);
    mb_jappend(&text, mb_sp(&pct_s), pct_s.len);
    mb_jappend(&text, STR_PTR("%\nturns: "), STR_LEN("%\nturns: "));
    let tc_s = MbStr { bytes: [0u8; 8192], len: 0 };
    mb_u64_to_s(tcount, &tc_s);
    mb_jappend(&text, mb_sp(&tc_s), tc_s.len);
    mb_jappend(&text, STR_PTR(", messages: "), STR_LEN(", messages: "));
    let mc_s = MbStr { bytes: [0u8; 8192], len: 0 };
    mb_u64_to_s(mcount, &mc_s);
    mb_jappend(&text, mb_sp(&mc_s), mc_s.len);
    mb_jappend(&text, STR_PTR("\nskills: "), STR_LEN("\nskills: "));
    mb_jappend(&text, mb_jp(&skill_names), skill_names.len);
    mb_jappend(&text, STR_PTR("\nagentsMd: "), STR_LEN("\nagentsMd: "));
    mb_jappend(&text, mb_jp(&agents_md), agents_md.len);
    mb_jpush(&text, 10);
    mb_jappend(&text, mb_sp(&mcp_line), mcp_line.len);
    MiniBridge_complete_turn(b, handlers, s, turn_p, turn_n, mb_jp(&text), text.len, true);
}

// TS: private async compactSession(s, turnId, opts).
// ASYNC landing: blocking-contract. DEFECT(std): the stall timer cannot
// preempt a blocking fetch (sa_io_read has no poll variant — see the exec
// drain registration); compactStalled is therefore always false in the port
// and the stall-error branch of the TS catch is unreachable, while the
// interrupt branch (miniInterruptFromAbort) is preserved verbatim.
fn MiniBridge_compact_session(b: &MiniBridgeState, handlers: &ServerHookHandlers, s: u64, turn_p: ptr, turn_n: u64, auto: bool, out_err: &MbJson, out_throw: &bool) -> void {
    *out_throw = false;
    mb_jclear(out_err);
    let tid = MbStr { bytes: [0u8; 8192], len: 0 };
    let has_tid: bool = mb_g_str(s, STR_PTR("threadId"), STR_LEN("threadId"), &tid);
    let messages: u64 = mb_g_node(s, STR_PTR("messages"), STR_LEN("messages"));
    let item: u64 = 0;
    let mc0: u64 = mb_n_count(messages);
    let i0: u64 = 0;
    while i0 < mc0 && item == 0 {
        let m: u64 = mb_a_at(messages, i0);
        if m != 0 {
            let ty = MbStr { bytes: [0u8; 8192], len: 0 };
            let ok_ty: bool = mb_g_str(m, STR_PTR("type"), STR_LEN("type"), &ty);
            let mt = MbStr { bytes: [0u8; 8192], len: 0 };
            let ok_mt: bool = mb_g_str(m, STR_PTR("turnId"), STR_LEN("turnId"), &mt);
            if (mb_bytes_eq(mb_sp(&ty), ty.len, STR_PTR("contextCompaction"), STR_LEN("contextCompaction")) || mb_bytes_eq(mb_sp(&ty), ty.len, STR_PTR("compaction"), STR_LEN("compaction"))) && ok_mt && mb_bytes_eq(mb_sp(&mt), mt.len, turn_p, turn_n) { item = m; };
        };
        i0 = i0 + 1;
    }
    if item == 0 {
        let created: u64 = mb_new_obj();
        let rc0: i32 = mb_s_str(created, STR_PTR("type"), STR_LEN("type"), STR_PTR("contextCompaction"), STR_LEN("contextCompaction"));
        let iid0 = MbJson { bytes: [0u8; 262144], len: 0 };
        mb_jassign(&iid0, STR_PTR("mini-compact-"), STR_LEN("mini-compact-"));
        mb_jappend(&iid0, turn_p, turn_n);
        rc0 = mb_s_str(created, STR_PTR("id"), STR_LEN("id"), mb_jp(&iid0), iid0.len);
        rc0 = mb_s_str(created, STR_PTR("threadId"), STR_LEN("threadId"), mb_sp(&tid), tid.len);
        rc0 = mb_s_str(created, STR_PTR("turnId"), STR_LEN("turnId"), turn_p, turn_n);
        rc0 = mb_s_str(created, STR_PTR("title"), STR_LEN("title"), STR_PTR("Context compaction"), STR_LEN("Context compaction"));
        rc0 = mb_s_str(created, STR_PTR("status"), STR_LEN("status"), STR_PTR("inProgress"), STR_LEN("inProgress"));
        rc0 = mb_s_str(created, STR_PTR("cliBackend"), STR_LEN("cliBackend"), STR_PTR("mini"), STR_LEN("mini"));
        rc0 = mb_a_push_node(messages, created);
        // Re-locate the stored handle (push clones into the session doc).
        let mc1: u64 = mb_n_count(messages);
        let i1: u64 = 0;
        while i1 < mc1 && item == 0 {
            let m: u64 = mb_a_at(messages, i1);
            if m != 0 {
                let mid = MbStr { bytes: [0u8; 8192], len: 0 };
                if mb_g_str(m, STR_PTR("id"), STR_LEN("id"), &mid) && mb_bytes_eq(mb_sp(&mid), mid.len, mb_jp(&iid0), iid0.len) { item = m; };
            };
            i1 = i1 + 1;
        }
        MiniBridge_emit_item_started(b, s, turn_p, turn_n, item);
    };
    let active = MbStr { bytes: [0u8; 8192], len: 0 };
    if !mb_g_str(s, STR_PTR("activeTurnId"), STR_LEN("activeTurnId"), &active) { return; };
    if !mb_bytes_eq(mb_sp(&active), active.len, turn_p, turn_n) { return; };
    if mb_n_count(messages) <= 2 {
        let rc1: i32 = mb_s_str(item, STR_PTR("status"), STR_LEN("status"), STR_PTR("completed"), STR_LEN("completed"));
        MiniBridge_emit_item_completed(b, s, turn_p, turn_n, item);
        MiniBridge_complete_turn(b, handlers, s, turn_p, turn_n, STR_PTR("nothing to compact: history is already minimal."), STR_LEN("nothing to compact: history is already minimal."), false);
        return;
    };
    let target: u64 = 0;
    let terr = MbJson { bytes: [0u8; 262144], len: 0 };
    let tthrow: bool = false;
    MiniBridge_resolve_target(b, s, &target, &terr, &tthrow);
    if tthrow { mb_throw_j(out_err, out_throw, &terr); return; };
    let max_retries: i64 = 0;
    let ok_mr: bool = mb_g_i64(target, STR_PTR("maxRetries"), STR_LEN("maxRetries"), &max_retries);
    let rc: i32 = mb_s_i64(s, STR_PTR("activeMaxRetries"), STR_LEN("activeMaxRetries"), max_retries);
    let base_url = MbStr { bytes: [0u8; 8192], len: 0 };
    let has_bu: bool = mb_g_str(target, STR_PTR("baseUrl"), STR_LEN("baseUrl"), &base_url);
    if base_url.len > 0 && mb_byte_at(mb_sp(&base_url), base_url.len - 1) == 47 {
        let trimmed = MbStr { bytes: [0u8; 8192], len: 0 };
        mb_slice_to_s(mb_sp(&base_url), base_url.len, 0, base_url.len - 1, &trimmed);
        mb_sassign_s2(&base_url, &trimmed);
    };
    let api_key = MbStr { bytes: [0u8; 8192], len: 0 };
    let has_ak: bool = mb_g_str(target, STR_PTR("apiKey"), STR_LEN("apiKey"), &api_key);
    let protocol = MbStr { bytes: [0u8; 8192], len: 0 };
    let has_pr: bool = mb_g_str(target, STR_PTR("protocol"), STR_LEN("protocol"), &protocol);
    let model = MbStr { bytes: [0u8; 8192], len: 0 };
    let has_model: bool = mb_g_str(s, STR_PTR("model"), STR_LEN("model"), &model);
    let effort = MbStr { bytes: [0u8; 8192], len: 0 };
    if !mb_g_str(s, STR_PTR("effort"), STR_LEN("effort"), &effort) { mb_sassign(&effort, STR_PTR("medium"), STR_LEN("medium")); };
    let ask = "Summarize this coding-agent transcript in 20 bullet lines or less. Preserve every durable conversation anchor exactly when possible: user requirements and preferences, file paths, decisions, constraints, unique facts, pending work, and the task-plan checklist with each step's status. Do not discard an early fact merely because it is old. No prose intro.";
    // compactCtrl: the doc-model abort handle is the session flag.
    rc = mb_s_bool(s, STR_PTR("activeAbort"), STR_LEN("activeAbort"), true);
    let img_unsupported: bool = false;
    let ok_iu: bool = mb_g_bool(s, STR_PTR("imageInputUnsupported"), STR_LEN("imageInputUnsupported"), &img_unsupported);
    let compact_content: u64 = 0;
    buildMiniCompactContent(messages, mb_sp(&protocol), protocol.len, 12000, !img_unsupported, &compact_content);
    let headers: u64 = mb_new_obj();
    let auth = MbJson { bytes: [0u8; 262144], len: 0 };
    mb_jappend(&auth, STR_PTR("Bearer "), STR_LEN("Bearer "));
    mb_jappend(&auth, mb_sp(&api_key), api_key.len);
    rc = mb_s_str(headers, STR_PTR("Authorization"), STR_LEN("Authorization"), mb_jp(&auth), auth.len);
    rc = mb_s_str(headers, STR_PTR("Content-Type"), STR_LEN("Content-Type"), STR_PTR("application/json"), STR_LEN("application/json"));
    let body: u64 = mb_new_obj();
    let url = MbJson { bytes: [0u8; 262144], len: 0 };
    mb_jappend(&url, mb_sp(&base_url), base_url.len);
    mb_jpush(&url, 47);
    let is_anthropic: bool = mb_bytes_eq(mb_sp(&protocol), protocol.len, STR_PTR("anthropic"), STR_LEN("anthropic"));
    let is_chat: bool = mb_bytes_eq(mb_sp(&protocol), protocol.len, STR_PTR("chat"), STR_LEN("chat"));
    if is_anthropic || is_chat {
        mb_jappend(&url, if is_anthropic { STR_PTR("messages") } else { STR_PTR("chat/completions") }, if is_anthropic { STR_LEN("messages") } else { STR_LEN("chat/completions") });
        rc = mb_s_str(body, STR_PTR("model"), STR_LEN("model"), mb_sp(&model), model.len);
        if is_anthropic {
            let compact_text = MbJson { bytes: [0u8; 262144], len: 0 };
            let cc: u64 = mb_n_count(compact_content);
            let ci: u64 = 0;
            while ci < cc {
                let blk: u64 = mb_a_at(compact_content, ci);
                if blk != 0 {
                    let ty = MbStr { bytes: [0u8; 8192], len: 0 };
                    let ok_ty: bool = mb_g_str(blk, STR_PTR("type"), STR_LEN("type"), &ty);
                    if mb_bytes_eq(mb_sp(&ty), ty.len, STR_PTR("text"), STR_LEN("text")) || mb_bytes_eq(mb_sp(&ty), ty.len, STR_PTR("input_text"), STR_LEN("input_text")) {
                        let t = MbStr { bytes: [0u8; 8192], len: 0 };
                        if mb_g_str(blk, STR_PTR("text"), STR_LEN("text"), &t) && t.len > 0 {
                            if compact_text.len > 0 { mb_jpush(&compact_text, 10); };
                            mb_jappend(&compact_text, mb_sp(&t), t.len);
                        };
                    };
                };
                ci = ci + 1;
            }
            rc = mb_s_str(body, STR_PTR("system"), STR_LEN("system"), STR_PTR(ask), STR_LEN(ask));
            let msgs: u64 = mb_new_arr();
            let um: u64 = mb_new_obj();
            rc = mb_s_str(um, STR_PTR("role"), STR_LEN("role"), STR_PTR("user"), STR_LEN("user"));
            rc = mb_s_str(um, STR_PTR("content"), STR_LEN("content"), mb_jp(&compact_text), compact_text.len);
            rc = mb_a_push_node(msgs, um);
            rc = mb_s_node(body, STR_PTR("messages"), STR_LEN("messages"), msgs);
            rc = mb_s_i64(body, STR_PTR("max_tokens"), STR_LEN("max_tokens"), MINI_ANTHROPIC_MAX_TOKENS() as i64);
        } else {
            rc = mb_s_str(body, STR_PTR("reasoning_effort"), STR_LEN("reasoning_effort"), mb_sp(&effort), effort.len);
            let msgs: u64 = mb_new_arr();
            let sm: u64 = mb_new_obj();
            rc = mb_s_str(sm, STR_PTR("role"), STR_LEN("role"), STR_PTR("system"), STR_LEN("system"));
            rc = mb_s_str(sm, STR_PTR("content"), STR_LEN("content"), STR_PTR(ask), STR_LEN(ask));
            rc = mb_a_push_node(msgs, sm);
            let um: u64 = mb_new_obj();
            rc = mb_s_str(um, STR_PTR("role"), STR_LEN("role"), STR_PTR("user"), STR_LEN("user"));
            rc = mb_s_node(um, STR_PTR("content"), STR_LEN("content"), compact_content);
            rc = mb_a_push_node(msgs, um);
            rc = mb_s_node(body, STR_PTR("messages"), STR_LEN("messages"), msgs);
        };
    } else {
        mb_jappend(&url, STR_PTR("responses"), STR_LEN("responses"));
        rc = mb_s_str(body, STR_PTR("model"), STR_LEN("model"), mb_sp(&model), model.len);
        let reasoning: u64 = mb_new_obj();
        rc = mb_s_str(reasoning, STR_PTR("effort"), STR_LEN("effort"), mb_sp(&effort), effort.len);
        rc = mb_s_node(body, STR_PTR("reasoning"), STR_LEN("reasoning"), reasoning);
        let empty_desc = ModelCapabilityDescriptor { reasoningEfforts: StrList { items: [StrRef { ptr: PTR_NULL(), len: 0 }; 32], len: 0 }, reasoningEfforts_present: false, contextWindow: 0.0, contextWindow_present: false, maxOutputTokens: 0.0, maxOutputTokens_present: false, verbosity: 0, verbosity_present: false, supportsVerbosity: false, supportsVerbosity_present: false, source: 0, source_present: false };
        let cap_node: u64 = mb_g_node(target, STR_PTR("modelCapability"), STR_LEN("modelCapability"));
        let verb_field: u64 = 0;
        miniResponsesVerbosityField(mb_sp(&model), model.len, &empty_desc, cap_node != 0 && mb_kind(cap_node) != MB_JK_NULL, &verb_field);
        if verb_field != 0 {
            let vk = MbStr { bytes: [0u8; 8192], len: 0 };
            if mb_g_str(verb_field, STR_PTR("verbosity"), STR_LEN("verbosity"), &vk) { rc = mb_s_str(body, STR_PTR("verbosity"), STR_LEN("verbosity"), mb_sp(&vk), vk.len); };
            mb_free_doc(verb_field);
        };
        rc = mb_s_str(body, STR_PTR("instructions"), STR_LEN("instructions"), STR_PTR(ask), STR_LEN(ask));
        let input_arr: u64 = mb_new_arr();
        let um: u64 = mb_new_obj();
        rc = mb_s_str(um, STR_PTR("role"), STR_LEN("role"), STR_PTR("user"), STR_LEN("user"));
        rc = mb_s_node(um, STR_PTR("content"), STR_LEN("content"), compact_content);
        rc = mb_a_push_node(input_arr, um);
        rc = mb_s_node(body, STR_PTR("input"), STR_LEN("input"), input_arr);
    };
    let body_text = MbJson { bytes: [0u8; 262144], len: 0 };
    let ok_bt: bool = mb_stringify_node(body, &body_text);
    mb_free_doc(body);
    let res: u64 = 0;
    let ferr = MbJson { bytes: [0u8; 262144], len: 0 };
    let fthrow: bool = false;
    let fexhausted: bool = false;
    MiniBridge_fetch_upstream(b, s, turn_p, turn_n, mb_jp(&url), url.len, STR_PTR("POST"), STR_LEN("POST"), headers, mb_jp(&body_text), body_text.len, true, max_retries as u64, &res, &ferr, &fthrow, &fexhausted);
    mb_free_doc(headers);
    let summary = MbJson { bytes: [0u8; 262144], len: 0 };
    let fail_err = MbJson { bytes: [0u8; 262144], len: 0 };
    let failed: bool = false;
    if fthrow {
        mb_jassign_j(&fail_err, &ferr);
        failed = true;
    } else {
        let ok_flag: bool = false;
        let ok_r: bool = mb_g_bool(res, STR_PTR("ok"), STR_LEN("ok"), &ok_flag);
        if !ok_flag {
            let status: i64 = 0;
            let ok_st: bool = mb_g_i64(res, STR_PTR("status"), STR_LEN("status"), &status);
            let rbody = MbJson { bytes: [0u8; 262144], len: 0 };
            let ok_rb: bool = mb_g_str_j(res, STR_PTR("body"), STR_LEN("body"), &rbody);
            mb_jassign(&fail_err, STR_PTR("compact "), STR_LEN("compact "));
            mb_jappend(&fail_err, mb_sp(&protocol), protocol.len);
            mb_jpush(&fail_err, 32);
            let st_s = MbStr { bytes: [0u8; 8192], len: 0 };
            mb_i64_to_s(status, &st_s);
            mb_jappend(&fail_err, mb_sp(&st_s), st_s.len);
            mb_jappend(&fail_err, STR_PTR(": "), STR_LEN(": "));
            let b300 = MbStr { bytes: [0u8; 8192], len: 0 };
            mb_slice_to_s(mb_jp(&rbody), rbody.len, 0, 300, &b300);
            mb_jappend(&fail_err, mb_sp(&b300), b300.len);
            failed = true;
        } else {
            let rbody = MbJson { bytes: [0u8; 262144], len: 0 };
            let ok_rb: bool = mb_g_str_j(res, STR_PTR("body"), STR_LEN("body"), &rbody);
            let data: u64 = mb_parse(mb_jp(&rbody), rbody.len);
            if is_anthropic {
                let content: u64 = mb_g_node(data, STR_PTR("content"), STR_LEN("content"));
                if content != 0 && mb_kind(content) == MB_JK_ARRAY {
                    let cc: u64 = mb_n_count(content);
                    let ci: u64 = 0;
                    while ci < cc {
                        let part: u64 = mb_a_at(content, ci);
                        if part != 0 {
                            let ty = MbStr { bytes: [0u8; 8192], len: 0 };
                            if mb_g_str(part, STR_PTR("type"), STR_LEN("type"), &ty) && mb_bytes_eq(mb_sp(&ty), ty.len, STR_PTR("text"), STR_LEN("text")) {
                                let t = MbJson { bytes: [0u8; 262144], len: 0 };
                                mb_field_text(part, STR_PTR("text"), STR_LEN("text"), &t);
                                mb_jappend(&summary, mb_jp(&t), t.len);
                            };
                        };
                        ci = ci + 1;
                    }
                };
            } else if is_chat {
                let choices: u64 = mb_g_node(data, STR_PTR("choices"), STR_LEN("choices"));
                if choices != 0 && mb_kind(choices) == MB_JK_ARRAY && mb_n_count(choices) > 0 {
                    let first: u64 = mb_a_at(choices, 0);
                    let msg: u64 = mb_g_node(first, STR_PTR("message"), STR_LEN("message"));
                    if msg != 0 { mb_field_text(msg, STR_PTR("content"), STR_LEN("content"), &summary); };
                };
            } else {
                let output: u64 = mb_g_node(data, STR_PTR("output"), STR_LEN("output"));
                if output != 0 && mb_kind(output) == MB_JK_ARRAY {
                    let oc: u64 = mb_n_count(output);
                    let oi: u64 = 0;
                    while oi < oc {
                        let oitem: u64 = mb_a_at(output, oi);
                        if oitem != 0 {
                            let ty = MbStr { bytes: [0u8; 8192], len: 0 };
                            if mb_g_str(oitem, STR_PTR("type"), STR_LEN("type"), &ty) && mb_bytes_eq(mb_sp(&ty), ty.len, STR_PTR("message"), STR_LEN("message")) {
                                let content: u64 = mb_g_node(oitem, STR_PTR("content"), STR_LEN("content"));
                                if content != 0 && mb_kind(content) == MB_JK_ARRAY {
                                    let cc: u64 = mb_n_count(content);
                                    let ci: u64 = 0;
                                    while ci < cc {
                                        let part: u64 = mb_a_at(content, ci);
                                        if part != 0 {
                                            let t = MbJson { bytes: [0u8; 262144], len: 0 };
                                            mb_field_text(part, STR_PTR("text"), STR_LEN("text"), &t);
                                            mb_jappend(&summary, mb_jp(&t), t.len);
                                        };
                                        ci = ci + 1;
                                    }
                                };
                            };
                        };
                        oi = oi + 1;
                    }
                };
            };
            let trimmed = MbStr { bytes: [0u8; 8192], len: 0 };
            mb_trim_to(mb_jp(&summary), summary.len, &trimmed);
            mb_jclear(&summary);
            mb_jappend(&summary, mb_sp(&trimmed), trimmed.len);
        };
    };
    // finally: clearTimeout + activeAbort release (the port's compact run is
    // the only installer of the flag while it runs — see header note).
    rc = mb_o_remove(s, STR_PTR("activeAbort"), STR_LEN("activeAbort"));
    if failed {
        rc = mb_s_str(item, STR_PTR("status"), STR_LEN("status"), STR_PTR("failed"), STR_LEN("failed"));
        MiniBridge_emit_item_completed(b, s, turn_p, turn_n, item);
        let ij = MbJson { bytes: [0u8; 262144], len: 0 };
        let is_null: bool = true;
        miniInterruptFromAbort(s, mb_jp(&fail_err), fail_err.len, &ij, &is_null);
        if !is_null { mb_throw_j(out_err, out_throw, &ij); return; };
        mb_throw_j(out_err, out_throw, &fail_err);
        return;
    };
    if summary.len == 0 {
        rc = mb_s_str(item, STR_PTR("status"), STR_LEN("status"), STR_PTR("failed"), STR_LEN("failed"));
        MiniBridge_emit_item_completed(b, s, turn_p, turn_n, item);
        mb_throw(out_err, out_throw, STR_PTR("compact returned empty summary"), STR_LEN("compact returned empty summary"));
        return;
    };
    let active2 = MbStr { bytes: [0u8; 8192], len: 0 };
    if !mb_g_str(s, STR_PTR("activeTurnId"), STR_LEN("activeTurnId"), &active2) { return; };
    if !mb_bytes_eq(mb_sp(&active2), active2.len, turn_p, turn_n) { return; };
    let kept: u64 = mb_n_count(messages);
    rc = mb_s_str(item, STR_PTR("status"), STR_LEN("status"), STR_PTR("completed"), STR_LEN("completed"));
    let kept_s = MbStr { bytes: [0u8; 8192], len: 0 };
    mb_u64_to_s(kept, &kept_s);
    let item_text = MbJson { bytes: [0u8; 262144], len: 0 };
    mb_jassign(&item_text, STR_PTR("compacted "), STR_LEN("compacted "));
    mb_jappend(&item_text, mb_sp(&kept_s), kept_s.len);
    mb_jappend(&item_text, STR_PTR(" items"), STR_LEN(" items"));
    rc = mb_s_str(item, STR_PTR("text"), STR_LEN("text"), mb_jp(&item_text), item_text.len);
    rc = mb_s_str(item, STR_PTR("type"), STR_LEN("type"), STR_PTR("contextCompaction"), STR_LEN("contextCompaction"));
    // buildAgentsMdCompactionNote(s.agentsMdActive, s.cwd)
    let amd_note = MbStr { bytes: [0u8; 8192], len: 0 };
    let amd_node: u64 = mb_g_node(s, STR_PTR("agentsMdActive"), STR_LEN("agentsMdActive"));
    let amd_present: bool = amd_node != 0 && mb_kind(amd_node) == MB_JK_ARRAY;
    let amd_text = MbJson { bytes: [0u8; 262144], len: 0 };
    let amd_count: u64 = 0;
    if amd_present {
        let ok_at: bool = mb_stringify_node(amd_node, &amd_text);
        amd_count = mb_n_count(amd_node);
    };
    let cwd = MbStr { bytes: [0u8; 8192], len: 0 };
    let has_cwd: bool = mb_g_str(s, STR_PTR("cwd"), STR_LEN("cwd"), &cwd);
    let nrc: i32 = buildAgentsMdCompactionNote(mb_jp(&amd_text), amd_text.len, amd_count, amd_present, mb_sp(&cwd), cwd.len, mb_sp(&amd_note), &amd_note.len);
    let anchors = MbJson { bytes: [0u8; 262144], len: 0 };
    buildMiniCompactionAnchors(messages, 32000, &anchors);
    let summary_with = MbJson { bytes: [0u8; 262144], len: 0 };
    mb_jappend(&summary_with, mb_jp(&summary), summary.len);
    if anchors.len > 0 {
        mb_jappend(&summary_with, STR_PTR("\n\n[durable conversation anchors]\n"), STR_LEN("\n\n[durable conversation anchors]\n"));
        mb_jappend(&summary_with, mb_jp(&anchors), anchors.len);
    };
    if amd_note.len > 0 {
        mb_jappend(&summary_with, STR_PTR("\n\n"), STR_LEN("\n\n"));
        mb_jappend(&summary_with, mb_sp(&amd_note), amd_note.len);
    };
    let carried: u64 = 0;
    let carried_null: bool = true;
    carryMiniPlanForward(messages, turn_p, turn_n, mb_sp(&tid), tid.len, &carried, &carried_null);
    let compact_images: u64 = mb_new_arr();
    if !img_unsupported { buildMiniHistoricalImageContent(messages, mb_sp(&protocol), protocol.len, &compact_images); };
    let new_messages: u64 = mb_new_arr();
    let summary_msg: u64 = mb_new_obj();
    rc = mb_s_str(summary_msg, STR_PTR("type"), STR_LEN("type"), STR_PTR("userMessage"), STR_LEN("userMessage"));
    let sid = MbJson { bytes: [0u8; 262144], len: 0 };
    mb_jassign(&sid, STR_PTR("mini-compact-"), STR_LEN("mini-compact-"));
    mb_jappend(&sid, turn_p, turn_n);
    rc = mb_s_str(summary_msg, STR_PTR("id"), STR_LEN("id"), mb_jp(&sid), sid.len);
    rc = mb_s_str(summary_msg, STR_PTR("turnId"), STR_LEN("turnId"), turn_p, turn_n);
    rc = mb_s_str(summary_msg, STR_PTR("threadId"), STR_LEN("threadId"), mb_sp(&tid), tid.len);
    rc = mb_s_str(summary_msg, STR_PTR("role"), STR_LEN("role"), STR_PTR("user"), STR_LEN("user"));
    rc = mb_s_str(summary_msg, STR_PTR("status"), STR_LEN("status"), STR_PTR("completed"), STR_LEN("completed"));
    let msg_text = MbJson { bytes: [0u8; 262144], len: 0 };
    mb_jassign(&msg_text, STR_PTR("[compacted "), STR_LEN("[compacted "));
    mb_jappend(&msg_text, mb_sp(&kept_s), kept_s.len);
    mb_jappend(&msg_text, STR_PTR(" items]\n"), STR_LEN(" items]\n"));
    mb_jappend(&msg_text, mb_jp(&summary_with), summary_with.len);
    rc = mb_s_str(summary_msg, STR_PTR("text"), STR_LEN("text"), mb_jp(&msg_text), msg_text.len);
    let content: u64 = mb_new_arr();
    let block: u64 = mb_new_obj();
    let is_responses: bool = mb_bytes_eq(mb_sp(&protocol), protocol.len, STR_PTR("responses"), STR_LEN("responses"));
    rc = mb_s_str(block, STR_PTR("type"), STR_LEN("type"), if is_responses { STR_PTR("input_text") } else { STR_PTR("text") }, if is_responses { STR_LEN("input_text") } else { STR_LEN("text") });
    rc = mb_s_str(block, STR_PTR("text"), STR_LEN("text"), mb_jp(&summary_with), summary_with.len);
    rc = mb_a_push_node(content, block);
    if compact_images != 0 && mb_kind(compact_images) == MB_JK_ARRAY {
        let ic: u64 = mb_n_count(compact_images);
        let ii: u64 = 0;
        while ii < ic {
            let rc2: i32 = mb_a_push_node(content, mb_clone_node(mb_a_at(compact_images, ii)));
            ii = ii + 1;
        }
    };
    rc = mb_s_node(summary_msg, STR_PTR("content"), STR_LEN("content"), content);
    rc = mb_a_push_node(new_messages, summary_msg);
    rc = mb_a_push_node(new_messages, mb_clone_node(item));
    if !carried_null && carried != 0 { rc = mb_a_push_node(new_messages, carried); };
    rc = mb_s_node(s, STR_PTR("messages"), STR_LEN("messages"), new_messages);
    MiniBridge_emit_item_completed(b, s, turn_p, turn_n, item);
    rc = mb_s_i64(s, STR_PTR("lastAutoCompactAt"), STR_LEN("lastAutoCompactAt"), mb_now_ms());
    rc = mb_o_remove(b.history_summary_cache, mb_sp(&tid), tid.len);
    let used: u64 = heuristicMiniTokens(mb_jp(&summary), summary.len);
    rc = mb_s_i64(s, STR_PTR("lastUsedTokens"), STR_LEN("lastUsedTokens"), used as i64);
    let lcw_node: u64 = mb_g_node(s, STR_PTR("lastContextWindow"), STR_LEN("lastContextWindow"));
    let lcw: f64 = 0.0;
    let has_lcw: bool = lcw_node != 0 && mb_num_finite(lcw_node, &lcw);
    if auto && has_lcw && lcw > 0.0 {
        let pct: i64 = mb_round_half((used as f64) / lcw * 100.0) as i64;
        let done_text = MbJson { bytes: [0u8; 262144], len: 0 };
        mb_jassign(&done_text, STR_PTR("auto-compacted "), STR_LEN("auto-compacted "));
        mb_jappend(&done_text, mb_sp(&kept_s), kept_s.len);
        mb_jappend(&done_text, STR_PTR(" items into summary (context was "), STR_LEN(" items into summary (context was "));
        let pct_s = MbStr { bytes: [0u8; 8192], len: 0 };
        mb_i64_to_s(pct, &pct_s);
        mb_jappend(&done_text, mb_sp(&pct_s), pct_s.len);
        mb_jappend(&done_text, STR_PTR("% full)."), STR_LEN("% full)."));
        MiniBridge_complete_turn(b, handlers, s, turn_p, turn_n, mb_jp(&done_text), done_text.len, true);
    } else {
        let done_text = MbJson { bytes: [0u8; 262144], len: 0 };
        mb_jassign(&done_text, STR_PTR("compacted "), STR_LEN("compacted "));
        mb_jappend(&done_text, mb_sp(&kept_s), kept_s.len);
        mb_jappend(&done_text, STR_PTR(" items into summary."), STR_LEN(" items into summary."));
        MiniBridge_complete_turn(b, handlers, s, turn_p, turn_n, mb_jp(&done_text), done_text.len, true);
    };
}

// TS: private miniChildStatus(child).
fn MiniBridge_child_status(child: u64, out: &MbStr) -> void {
    if mb_g_has(child, STR_PTR("activeTurnId"), STR_LEN("activeTurnId")) { mb_sassign(out, STR_PTR("running"), STR_LEN("running")); return; };
    if !mb_g_str(child, STR_PTR("subStatus"), STR_LEN("subStatus"), out) { mb_sassign(out, STR_PTR("running"), STR_LEN("running")); };
}
// TS: private miniLiveChildren(parent) — count form (the port's consumers
// need the residency count and per-child scans, done at the call sites).
fn MiniBridge_live_child_count(b: &MiniBridgeState, parent: u64) -> u64 {
    let ptid = MbStr { bytes: [0u8; 8192], len: 0 };
    let has_ptid: bool = mb_g_str(parent, STR_PTR("threadId"), STR_LEN("threadId"), &ptid);
    let total: u64 = 0;
    let seen: u64 = mb_new_arr();
    let count: u64 = mb_n_count(b.sessions);
    let i: u64 = 0;
    while i < count {
        let kp: ptr = PTR_NULL();
        let kn: u64 = 0;
        if mb_key_at(b.sessions, i, &kp, &kn) {
            let cs: u64 = mb_g_node(b.sessions, kp, kn);
            if cs != 0 {
                let par = MbStr { bytes: [0u8; 8192], len: 0 };
                let closed: bool = false;
                let ok_cl: bool = mb_g_bool(cs, STR_PTR("closed"), STR_LEN("closed"), &closed);
                if mb_g_str(cs, STR_PTR("parentThreadId"), STR_LEN("parentThreadId"), &par) && mb_bytes_eq(mb_sp(&par), par.len, mb_sp(&ptid), ptid.len) && MiniBridge_child_owner_visible(parent, cs) && !closed {
                    total = total + 1;
                    let rc: i32 = mb_a_push_str(seen, kp, kn);
                };
            };
        };
        i = i + 1;
    }
    // options.listSnapshots landing: the bridge snapshot store.
    let scount: u64 = mb_n_count(b.snapshots);
    let si: u64 = 0;
    while si < scount {
        let kp: ptr = PTR_NULL();
        let kn: u64 = 0;
        if mb_key_at(b.snapshots, si, &kp, &kn) {
            let snap: u64 = mb_g_node(b.snapshots, kp, kn);
            if snap != 0 && !mb_str_in_arr(seen, kp, kn, false) {
                let par = MbStr { bytes: [0u8; 8192], len: 0 };
                let archived: bool = false;
                let ok_a: bool = mb_g_bool(snap, STR_PTR("archived"), STR_LEN("archived"), &archived);
                let closed: bool = false;
                let ok_c: bool = mb_g_bool(snap, STR_PTR("closed"), STR_LEN("closed"), &closed);
                if mb_g_str(snap, STR_PTR("parentThreadId"), STR_LEN("parentThreadId"), &par) && mb_bytes_eq(mb_sp(&par), par.len, mb_sp(&ptid), ptid.len) && !archived && !closed && MiniBridge_child_owner_visible(parent, snap) {
                    total = total + 1;
                };
            };
        };
        si = si + 1;
    }
    return total;
}
// TS: private miniFindChild(parent, target).
fn MiniBridge_find_child(b: &MiniBridgeState, parent: u64, target_p: ptr, target_n: u64, out: &u64, out_has: &bool) -> void {
    *out = 0;
    *out_has = false;
    let t = MbStr { bytes: [0u8; 8192], len: 0 };
    mb_trim_to(target_p, target_n, &t);
    if t.len == 0 { return; };
    let ptid = MbStr { bytes: [0u8; 8192], len: 0 };
    let has_ptid: bool = mb_g_str(parent, STR_PTR("threadId"), STR_LEN("threadId"), &ptid);
    let count: u64 = mb_n_count(b.sessions);
    let i: u64 = 0;
    while i < count {
        let kp: ptr = PTR_NULL();
        let kn: u64 = 0;
        if mb_key_at(b.sessions, i, &kp, &kn) {
            let cs: u64 = mb_g_node(b.sessions, kp, kn);
            if cs != 0 {
                let par = MbStr { bytes: [0u8; 8192], len: 0 };
                let closed: bool = false;
                let ok_cl: bool = mb_g_bool(cs, STR_PTR("closed"), STR_LEN("closed"), &closed);
                if mb_g_str(cs, STR_PTR("parentThreadId"), STR_LEN("parentThreadId"), &par) && mb_bytes_eq(mb_sp(&par), par.len, mb_sp(&ptid), ptid.len) && MiniBridge_child_owner_visible(parent, cs) && !closed {
                    let tn = MbStr { bytes: [0u8; 8192], len: 0 };
                    let ok_tn: bool = mb_g_str(cs, STR_PTR("taskName"), STR_LEN("taskName"), &tn);
                    if mb_bytes_eq(kp, kn, mb_sp(&t), t.len) || (ok_tn && mb_bytes_eq(mb_sp(&tn), tn.len, mb_sp(&t), t.len)) {
                        *out = cs;
                        *out_has = true;
                        return;
                    };
                };
            };
        };
        i = i + 1;
    }
    let scount: u64 = mb_n_count(b.snapshots);
    let si: u64 = 0;
    while si < scount {
        let kp: ptr = PTR_NULL();
        let kn: u64 = 0;
        if mb_key_at(b.snapshots, si, &kp, &kn) {
            let snap: u64 = mb_g_node(b.snapshots, kp, kn);
            if snap != 0 {
                let par = MbStr { bytes: [0u8; 8192], len: 0 };
                let archived: bool = false;
                let ok_a: bool = mb_g_bool(snap, STR_PTR("archived"), STR_LEN("archived"), &archived);
                let closed: bool = false;
                let ok_c: bool = mb_g_bool(snap, STR_PTR("closed"), STR_LEN("closed"), &closed);
                if mb_g_str(snap, STR_PTR("parentThreadId"), STR_LEN("parentThreadId"), &par) && mb_bytes_eq(mb_sp(&par), par.len, mb_sp(&ptid), ptid.len) && !archived && !closed && MiniBridge_child_owner_visible(parent, snap) {
                    let tn = MbStr { bytes: [0u8; 8192], len: 0 };
                    let ok_tn: bool = mb_g_str(snap, STR_PTR("taskName"), STR_LEN("taskName"), &tn);
                    if mb_bytes_eq(kp, kn, mb_sp(&t), t.len) || (ok_tn && mb_bytes_eq(mb_sp(&tn), tn.len, mb_sp(&t), t.len)) {
                        let owner = MbStr { bytes: [0u8; 8192], len: 0 };
                        let has_owner: bool = mb_g_str(parent, STR_PTR("ownerId"), STR_LEN("ownerId"), &owner);
                        MiniBridge_get_or_restore_session(b, kp, kn, mb_sp(&owner), owner.len, has_owner, out, out_has);
                        return;
                    };
                };
            };
        };
        si = si + 1;
    }
}
// TS: private collectMiniAgentInbox(parent) — reports as docs
// {agentId, [taskName], status, report}.
fn MiniBridge_collect_inbox(b: &MiniBridgeState, parent: u64, out: &u64) -> void {
    let reports: u64 = mb_new_arr();
    let ptid = MbStr { bytes: [0u8; 8192], len: 0 };
    let has_ptid: bool = mb_g_str(parent, STR_PTR("threadId"), STR_LEN("threadId"), &ptid);
    let delivered: u64 = mb_g_node(parent, STR_PTR("deliveredAgentReports"), STR_LEN("deliveredAgentReports"));
    let count: u64 = mb_n_count(b.sessions);
    let i: u64 = 0;
    while i < count {
        let kp: ptr = PTR_NULL();
        let kn: u64 = 0;
        if mb_key_at(b.sessions, i, &kp, &kn) {
            let cs: u64 = mb_g_node(b.sessions, kp, kn);
            if cs != 0 {
                let par = MbStr { bytes: [0u8; 8192], len: 0 };
                let closed: bool = false;
                let ok_cl: bool = mb_g_bool(cs, STR_PTR("closed"), STR_LEN("closed"), &closed);
                if mb_g_str(cs, STR_PTR("parentThreadId"), STR_LEN("parentThreadId"), &par) && mb_bytes_eq(mb_sp(&par), par.len, mb_sp(&ptid), ptid.len) && MiniBridge_child_owner_visible(parent, cs) && !closed && !mb_g_has(cs, STR_PTR("activeTurnId"), STR_LEN("activeTurnId")) {
                    let st = MbStr { bytes: [0u8; 8192], len: 0 };
                    MiniBridge_child_status(cs, &st);
                    if mb_bytes_eq(mb_sp(&st), st.len, STR_PTR("completed"), STR_LEN("completed")) || mb_bytes_eq(mb_sp(&st), st.len, STR_PTR("failed"), STR_LEN("failed")) || mb_bytes_eq(mb_sp(&st), st.len, STR_PTR("interrupted"), STR_LEN("interrupted")) {
                        let report = MbStr { bytes: [0u8; 8192], len: 0 };
                        let ok_r: bool = mb_g_str(cs, STR_PTR("finalReport"), STR_LEN("finalReport"), &report);
                        let report_trim = MbStr { bytes: [0u8; 8192], len: 0 };
                        mb_trim_to(mb_sp(&report), report.len, &report_trim);
                        let inputs: u64 = mb_g_node(cs, STR_PTR("pendingInputs"), STR_LEN("pendingInputs"));
                        let pending: u64 = 0;
                        if inputs != 0 { pending = mb_n_count(inputs); };
                        if report_trim.len > 0 && pending == 0 {
                            let key = MbJson { bytes: [0u8; 262144], len: 0 };
                            miniAgentInboxKey(kp, kn, mb_sp(&st), st.len, &key);
                            if delivered == 0 || !mb_str_in_arr(delivered, mb_jp(&key), key.len, false) {
                                let rec: u64 = mb_new_obj();
                                let rc: i32 = mb_s_str(rec, STR_PTR("agentId"), STR_LEN("agentId"), kp, kn);
                                let tn = MbStr { bytes: [0u8; 8192], len: 0 };
                                if mb_g_str(cs, STR_PTR("taskName"), STR_LEN("taskName"), &tn) { rc = mb_s_str(rec, STR_PTR("taskName"), STR_LEN("taskName"), mb_sp(&tn), tn.len); };
                                rc = mb_s_str(rec, STR_PTR("status"), STR_LEN("status"), mb_sp(&st), st.len);
                                let rep = MbStr { bytes: [0u8; 8192], len: 0 };
                                mb_slice_to_s(mb_sp(&report_trim), report_trim.len, 0, 8000, &rep);
                                rc = mb_s_str(rec, STR_PTR("report"), STR_LEN("report"), mb_sp(&rep), rep.len);
                                rc = mb_a_push_node(reports, rec);
                            };
                        };
                    };
                };
            };
        };
        i = i + 1;
    }
    *out = reports;
}
// TS: private markMiniAgentInboxDelivered(parent, reports).
fn MiniBridge_mark_inbox_delivered(b: &MiniBridgeState, parent: u64, reports: u64) -> void {
    if reports == 0 || mb_n_count(reports) == 0 { return; };
    let delivered: u64 = mb_g_node(parent, STR_PTR("deliveredAgentReports"), STR_LEN("deliveredAgentReports"));
    if delivered == 0 || mb_kind(delivered) != MB_JK_ARRAY {
        delivered = mb_new_arr();
        let rc0: i32 = mb_s_node(parent, STR_PTR("deliveredAgentReports"), STR_LEN("deliveredAgentReports"), delivered);
    };
    let count: u64 = mb_n_count(reports);
    let i: u64 = 0;
    while i < count {
        let r: u64 = mb_a_at(reports, i);
        if r != 0 {
            let aid = MbStr { bytes: [0u8; 8192], len: 0 };
            let st = MbStr { bytes: [0u8; 8192], len: 0 };
            let ok_a: bool = mb_g_str(r, STR_PTR("agentId"), STR_LEN("agentId"), &aid);
            let ok_s: bool = mb_g_str(r, STR_PTR("status"), STR_LEN("status"), &st);
            let key = MbJson { bytes: [0u8; 262144], len: 0 };
            miniAgentInboxKey(mb_sp(&aid), aid.len, mb_sp(&st), st.len, &key);
            if !mb_str_in_arr(delivered, mb_jp(&key), key.len, false) {
                let rc: i32 = mb_a_push_str(delivered, mb_jp(&key), key.len);
            };
        };
        i = i + 1;
    }
    MiniBridge_persist(b, parent);
}
// TS: async handleMiniRequestUserInput(s, turnId, args) — Promise landing:
// the record lives in b.pending_user_inputs with a deadline; the host's
// respond() settles it ({resolved, answer}); this waiter polls it in 10 ms
// steps exactly like sleepWithMiniAbort (entry-snapshot/deadline-poll
// registration, ASYNC_MODEL).
fn MiniBridge_handle_request_user_input(b: &MiniBridgeState, s: u64, turn_p: ptr, turn_n: u64, args: u64, out: &MbJson) -> void {
    mb_jclear(out);
    let raw_q: u64 = mb_g_node(args, STR_PTR("questions"), STR_LEN("questions"));
    if raw_q == 0 || mb_kind(raw_q) != MB_JK_ARRAY || mb_n_count(raw_q) == 0 {
        mb_jassign(out, STR_PTR("No questions provided to request_user_input."), STR_LEN("No questions provided to request_user_input."));
        return;
    };
    let normalized: u64 = mb_new_arr();
    let qc: u64 = mb_n_count(raw_q);
    let qi: u64 = 0;
    while qi < qc {
        let q: u64 = mb_a_at(raw_q, qi);
        let entry: u64 = mb_new_obj();
        let id = MbStr { bytes: [0u8; 8192], len: 0 };
        let has_id: bool = mb_req_trim_str(q, STR_PTR("id"), STR_LEN("id"), &id);
        if !has_id {
            let idx_s = MbStr { bytes: [0u8; 8192], len: 0 };
            mb_u64_to_s(qi + 1, &idx_s);
            mb_sassign(&id, STR_PTR("q_"), STR_LEN("q_"));
            // append index digits
            let joined = MbJson { bytes: [0u8; 262144], len: 0 };
            mb_jassign(&joined, STR_PTR("q_"), STR_LEN("q_"));
            mb_jappend(&joined, mb_sp(&idx_s), idx_s.len);
            mb_sassign(&id, mb_jp(&joined), joined.len);
        };
        let rc: i32 = mb_s_str(entry, STR_PTR("id"), STR_LEN("id"), mb_sp(&id), id.len);
        let question = MbStr { bytes: [0u8; 8192], len: 0 };
        if !mb_g_str(q, STR_PTR("question"), STR_LEN("question"), &question) {
            if !mb_g_str(q, STR_PTR("title"), STR_LEN("title"), &question) {
                let ok_t: bool = mb_g_str(q, STR_PTR("text"), STR_LEN("text"), &question);
            };
        };
        rc = mb_s_str(entry, STR_PTR("question"), STR_LEN("question"), mb_sp(&question), question.len);
        let header = MbStr { bytes: [0u8; 8192], len: 0 };
        if mb_g_str(q, STR_PTR("header"), STR_LEN("header"), &header) { rc = mb_s_str(entry, STR_PTR("header"), STR_LEN("header"), mb_sp(&header), header.len); };
        let options: u64 = mb_g_node(q, STR_PTR("options"), STR_LEN("options"));
        if options != 0 && mb_kind(options) == MB_JK_ARRAY && mb_n_count(options) > 0 {
            let opts_out: u64 = mb_new_arr();
            let oc: u64 = mb_n_count(options);
            let oi: u64 = 0;
            while oi < oc {
                let ov = MbJson { bytes: [0u8; 262144], len: 0 };
                mb_json_scalar_text(mb_a_at(options, oi), &ov);
                let rc2: i32 = mb_a_push_str(opts_out, mb_jp(&ov), ov.len);
                oi = oi + 1;
            }
            rc = mb_s_node(entry, STR_PTR("options"), STR_LEN("options"), opts_out);
        };
        let multi: bool = false;
        let mv: bool = false;
        if mb_g_bool(q, STR_PTR("is_multi_select"), STR_LEN("is_multi_select"), &mv) && mv { multi = true; };
        if mb_g_bool(q, STR_PTR("isMultiSelect"), STR_LEN("isMultiSelect"), &mv) && mv { multi = true; };
        if mb_g_bool(q, STR_PTR("multiple"), STR_LEN("multiple"), &mv) && mv { multi = true; };
        if multi { rc = mb_s_bool(entry, STR_PTR("is_multi_select"), STR_LEN("is_multi_select"), true); };
        rc = mb_a_push_node(normalized, entry);
        qi = qi + 1;
    }
    let tid = MbStr { bytes: [0u8; 8192], len: 0 };
    let has_tid: bool = mb_g_str(s, STR_PTR("threadId"), STR_LEN("threadId"), &tid);
    let uuid = MbStr { bytes: [0u8; 8192], len: 0 };
    mb_new_uuid(&uuid);
    let request_id = MbJson { bytes: [0u8; 262144], len: 0 };
    mb_jassign(&request_id, STR_PTR("mini-input-"), STR_LEN("mini-input-"));
    mb_jappend(&request_id, mb_sp(&uuid), 8);
    let server_req: u64 = mb_new_obj();
    let rc: i32 = mb_s_str(server_req, STR_PTR("id"), STR_LEN("id"), mb_jp(&request_id), request_id.len);
    rc = mb_s_str(server_req, STR_PTR("method"), STR_LEN("method"), STR_PTR("item/tool/requestUserInput"), STR_LEN("item/tool/requestUserInput"));
    let params: u64 = mb_new_obj();
    rc = mb_s_str(params, STR_PTR("itemId"), STR_LEN("itemId"), mb_jp(&request_id), request_id.len);
    rc = mb_s_str(params, STR_PTR("threadId"), STR_LEN("threadId"), mb_sp(&tid), tid.len);
    rc = mb_s_str(params, STR_PTR("turnId"), STR_LEN("turnId"), turn_p, turn_n);
    rc = mb_s_node(params, STR_PTR("questions"), STR_LEN("questions"), normalized);
    rc = mb_s_node(server_req, STR_PTR("params"), STR_LEN("params"), params);
    let sent: bool = MiniBridge_emit(b, STR_PTR("message"), STR_LEN("message"), server_req);
    let record: u64 = mb_new_obj();
    rc = mb_s_str(record, STR_PTR("threadId"), STR_LEN("threadId"), mb_sp(&tid), tid.len);
    rc = mb_s_str(record, STR_PTR("turnId"), STR_LEN("turnId"), turn_p, turn_n);
    rc = mb_s_bool(record, STR_PTR("resolved"), STR_LEN("resolved"), false);
    rc = mb_s_node(b.pending_user_inputs, mb_jp(&request_id), request_id.len, record);
    let deadline: i64 = mb_now_ms() + 120000;
    while mb_now_ms() < deadline {
        let rec: u64 = mb_g_node(b.pending_user_inputs, mb_jp(&request_id), request_id.len);
        if rec != 0 {
            let resolved: bool = false;
            let ok_r: bool = mb_g_bool(rec, STR_PTR("resolved"), STR_LEN("resolved"), &resolved);
            if resolved {
                let answer = MbJson { bytes: [0u8; 262144], len: 0 };
                let ok_a: bool = mb_g_str_j(rec, STR_PTR("answer"), STR_LEN("answer"), &answer);
                let rc2: i32 = mb_o_remove(b.pending_user_inputs, mb_jp(&request_id), request_id.len);
                if answer.len == 0 || mb_j_eq(&answer, STR_PTR("(用户跳过提问，请按默认选项继续)"), STR_LEN("(用户跳过提问，请按默认选项继续)")) {
                    mb_jassign(out, STR_PTR("(用户跳过提问，请按默认选项继续。不要重复提问，不要返回空回复，直接给出文字或工具调用继续任务。)"), STR_LEN("(用户跳过提问，请按默认选项继续。不要重复提问，不要返回空回复，直接给出文字或工具调用继续任务。)"));
                } else {
                    mb_jassign(out, STR_PTR("User answered: "), STR_LEN("User answered: "));
                    mb_jappend(out, mb_jp(&answer), answer.len);
                    mb_jappend(out, STR_PTR("\n(Continue the task based on this answer. Do not ask the same question again. Do not return an empty reply; produce text or tool calls.)"), STR_LEN("\n(Continue the task based on this answer. Do not ask the same question again. Do not return an empty reply; produce text or tool calls.)"));
                };
                return;
            };
        };
        mb_sleep_ms(10);
    }
    let rc3: i32 = mb_o_remove(b.pending_user_inputs, mb_jp(&request_id), request_id.len);
    mb_jassign(out, STR_PTR("(用户超时未回复，请按推荐/默认选项继续，不要重复提问)"), STR_LEN("(用户超时未回复，请按推荐/默认选项继续，不要重复提问)"));
}
// TS: async requestMiniApproval(s, turnId, lane, summary, timeoutMs) —
// same Promise landing as handleMiniRequestUserInput; timeout resolves
// "timeout" and drops the record, cancel arrives via respond().
fn MiniBridge_request_approval(b: &MiniBridgeState, s: u64, turn_p: ptr, turn_n: u64, lane_p: ptr, lane_n: u64, action_p: ptr, action_n: u64, target_p: ptr, target_n: u64, reason_p: ptr, reason_n: u64, timeout_ms: u64, out: &MbStr) -> void {
    out.len = 0;
    let tid = MbStr { bytes: [0u8; 8192], len: 0 };
    let has_tid: bool = mb_g_str(s, STR_PTR("threadId"), STR_LEN("threadId"), &tid);
    let cwd = MbStr { bytes: [0u8; 8192], len: 0 };
    let has_cwd: bool = mb_g_str(s, STR_PTR("cwd"), STR_LEN("cwd"), &cwd);
    let uuid = MbStr { bytes: [0u8; 8192], len: 0 };
    mb_new_uuid(&uuid);
    let request_id = MbJson { bytes: [0u8; 262144], len: 0 };
    mb_jassign(&request_id, STR_PTR("mini-approval-"), STR_LEN("mini-approval-"));
    mb_jappend(&request_id, mb_sp(&uuid), 8);
    let is_file: bool = mb_bytes_eq(lane_p, lane_n, STR_PTR("file"), STR_LEN("file"));
    let server_req: u64 = mb_new_obj();
    let rc: i32 = mb_s_str(server_req, STR_PTR("id"), STR_LEN("id"), mb_jp(&request_id), request_id.len);
    rc = mb_s_str(server_req, STR_PTR("method"), STR_LEN("method"), if is_file { STR_PTR("item/fileChange/requestApproval") } else { STR_PTR("item/commandExecution/requestApproval") }, if is_file { STR_LEN("item/fileChange/requestApproval") } else { STR_LEN("item/commandExecution/requestApproval") });
    let params: u64 = mb_new_obj();
    rc = mb_s_str(params, STR_PTR("threadId"), STR_LEN("threadId"), mb_sp(&tid), tid.len);
    rc = mb_s_str(params, STR_PTR("turnId"), STR_LEN("turnId"), turn_p, turn_n);
    rc = mb_s_str(params, STR_PTR("action"), STR_LEN("action"), action_p, action_n);
    rc = mb_s_str(params, STR_PTR("target"), STR_LEN("target"), target_p, target_n);
    rc = mb_s_str(params, STR_PTR("reason"), STR_LEN("reason"), reason_p, reason_n);
    rc = mb_s_str(params, STR_PTR("cwd"), STR_LEN("cwd"), mb_sp(&cwd), cwd.len);
    rc = mb_s_str(params, STR_PTR("source"), STR_LEN("source"), STR_PTR("mini"), STR_LEN("mini"));
    rc = mb_s_node(server_req, STR_PTR("params"), STR_LEN("params"), params);
    let sent: bool = MiniBridge_emit(b, STR_PTR("message"), STR_LEN("message"), server_req);
    let wait: u64 = timeout_ms;
    if wait == 0 { wait = MINI_APPROVAL_TIMEOUT_MS(); };
    if wait < 1000 { wait = 1000; };
    if wait > 600000 { wait = 600000; };
    let record: u64 = mb_new_obj();
    rc = mb_s_str(record, STR_PTR("threadId"), STR_LEN("threadId"), mb_sp(&tid), tid.len);
    rc = mb_s_str(record, STR_PTR("turnId"), STR_LEN("turnId"), turn_p, turn_n);
    rc = mb_s_bool(record, STR_PTR("resolved"), STR_LEN("resolved"), false);
    rc = mb_s_node(b.pending_approvals, mb_jp(&request_id), request_id.len, record);
    let deadline: i64 = mb_now_ms() + (wait as i64);
    while mb_now_ms() < deadline {
        let rec: u64 = mb_g_node(b.pending_approvals, mb_jp(&request_id), request_id.len);
        if rec != 0 {
            let resolved: bool = false;
            let ok_r: bool = mb_g_bool(rec, STR_PTR("resolved"), STR_LEN("resolved"), &resolved);
            if resolved {
                let decision = MbStr { bytes: [0u8; 8192], len: 0 };
                let ok_d: bool = mb_g_str(rec, STR_PTR("decision"), STR_LEN("decision"), &decision);
                let rc2: i32 = mb_o_remove(b.pending_approvals, mb_jp(&request_id), request_id.len);
                mb_sassign(out, mb_sp(&decision), decision.len);
                return;
            };
        };
        mb_sleep_ms(10);
    }
    let rc3: i32 = mb_o_remove(b.pending_approvals, mb_jp(&request_id), request_id.len);
    mb_sassign(out, STR_PTR("timeout"), STR_LEN("timeout"));
}

// TS: async handleMiniSubagentCall(s, name, a) — returns a string (JSON or
// plain text). ASYNC landing: blocking-contract; wait_agent's await on
// waitForMiniChildNotify lands on the B7 deadline-poll waiter.
fn MiniBridge_handle_subagent_call(b: &MiniBridgeState, handlers: &ServerHookHandlers, s: u64, name_p: ptr, name_n: u64, a: u64, out: &MbJson) -> void {
    mb_jclear(out);
    let name = MbStr { bytes: [0u8; 8192], len: 0 };
    normalizeMiniSubagentToolName(name_p, name_n, true, &name);
    let s_tid = MbStr { bytes: [0u8; 8192], len: 0 };
    let has_s_tid: bool = mb_g_str(s, STR_PTR("threadId"), STR_LEN("threadId"), &s_tid);
    if mb_bytes_eq(mb_sp(&name), name.len, STR_PTR("spawn_agent"), STR_LEN("spawn_agent")) {
        let depth: i64 = 0;
        let ok_d: bool = mb_g_i64(s, STR_PTR("depth"), STR_LEN("depth"), &depth);
        let child_depth: i64 = depth + 1;
        if isMiniSubagentDepthExceeded(child_depth, MINI_SUBAGENT_MAX_DEPTH() as i64) || mb_g_has(s, STR_PTR("parentThreadId"), STR_LEN("parentThreadId")) {
            mb_jassign(out, STR_PTR("Agent depth limit reached. Solve the task yourself - sub-agents cannot spawn further."), STR_LEN("Agent depth limit reached. Solve the task yourself - sub-agents cannot spawn further."));
            return;
        };
        let message = MbJson { bytes: [0u8; 262144], len: 0 };
        miniCoerceSpawnMessage(a, &message);
        if message.len == 0 {
            mb_jassign(out, STR_PTR("spawn_agent needs {task_name,message}: a non-empty plain-text brief describing the subtask."), STR_LEN("spawn_agent needs {task_name,message}: a non-empty plain-text brief describing the subtask."));
            return;
        };
        let task_name = MbStr { bytes: [0u8; 8192], len: 0 };
        let tn_null: bool = true;
        let tn_node: u64 = mb_g_node(a, STR_PTR("task_name"), STR_LEN("task_name"));
        if tn_node == 0 { tn_node = mb_g_node(a, STR_PTR("taskName"), STR_LEN("taskName")); };
        parseMiniSubagentTaskName(tn_node, &task_name, &tn_null);
        if tn_null {
            let uuid = MbStr { bytes: [0u8; 8192], len: 0 };
            mb_new_uuid(&uuid);
            let joined = MbJson { bytes: [0u8; 262144], len: 0 };
            mb_jassign(&joined, STR_PTR("task_"), STR_LEN("task_"));
            // TS: randomUUID().replace(/-/g, "").slice(0, 8)
            let ui: u64 = 0;
            let taken: u64 = 0;
            while ui < uuid.len && taken < 8 {
                let byte: u8 = uuid.bytes[ui];
                if byte != 45 { mb_jpush(&joined, byte); taken = taken + 1; };
                ui = ui + 1;
            }
            mb_sassign(&task_name, mb_jp(&joined), joined.len);
        };
        let agent_type = MbStr { bytes: [0u8; 8192], len: 0 };
        if !mb_g_str(a, STR_PTR("agent_type"), STR_LEN("agent_type"), &agent_type) {
            let ok_at: bool = mb_g_str(a, STR_PTR("agentType"), STR_LEN("agentType"), &agent_type);
        };
        let live: u64 = MiniBridge_live_child_count(b, s);
        let max_children: u64 = miniSubagentMaxChildren();
        if live >= max_children {
            let msg = MbJson { bytes: [0u8; 262144], len: 0 };
            mb_jassign(&msg, STR_PTR("Agent concurrency limit reached ("), STR_LEN("Agent concurrency limit reached ("));
            let mc_s = MbStr { bytes: [0u8; 8192], len: 0 };
            mb_u64_to_s(max_children, &mc_s);
            mb_jappend(&msg, mb_sp(&mc_s), mc_s.len);
            mb_jappend(&msg, STR_PTR("). Wait for running agents with wait_agent or close finished ones, then retry."), STR_LEN("). Wait for running agents with wait_agent or close finished ones, then retry."));
            mb_jassign_j(out, &msg);
            return;
        };
        let child_id = MbStr { bytes: [0u8; 8192], len: 0 };
        mb_new_uuid(&child_id);
        let child: u64 = mb_new_obj();
        let rc: i32 = mb_s_str(child, STR_PTR("threadId"), STR_LEN("threadId"), mb_sp(&child_id), child_id.len);
        let v = MbStr { bytes: [0u8; 8192], len: 0 };
        if mb_g_str(s, STR_PTR("ownerId"), STR_LEN("ownerId"), &v) { rc = mb_s_str(child, STR_PTR("ownerId"), STR_LEN("ownerId"), mb_sp(&v), v.len); };
