                    let msg = MbJson { bytes: [0u8; 262144], len: 0 };
                    mb_jassign(&msg, STR_PTR("cannot resume multi-agent v2 child "), STR_LEN("cannot resume multi-agent v2 child "));
                    mb_jappend(&msg, mb_sp(&thread), thread.len);
                    mb_jappend(&msg, STR_PTR(": parent ownership is unavailable; resume the parent first"), STR_LEN(": parent ownership is unavailable; resume the parent first"));
                    mb_throw_j(out_err, out_throw, &msg);
                    return;
                };
            };
            let eff = MbStr { bytes: [0u8; 8192], len: 0 };
            let has_eff: bool = false;
            extractMiniEffort(rr, &eff, &has_eff);
            if has_eff {
                let rc: i32 = mb_s_str(s, STR_PTR("effort"), STR_LEN("effort"), mb_sp(&eff), eff.len);
                MiniBridge_persist(b, s);
            };
            let sb = MbStr { bytes: [0u8; 8192], len: 0 };
            let has_sb: bool = false;
            normalizeMiniSandbox(mb_g_node(rr, STR_PTR("sandbox"), STR_LEN("sandbox")), &sb, &has_sb);
            let ap = MbStr { bytes: [0u8; 8192], len: 0 };
            let has_ap: bool = false;
            normalizeMiniSandbox(mb_g_node(rr, STR_PTR("approvalPolicy"), STR_LEN("approvalPolicy")), &ap, &has_ap);
            if has_sb || has_ap {
                if has_sb { let rc2: i32 = mb_s_str(s, STR_PTR("sandbox"), STR_LEN("sandbox"), mb_sp(&sb), sb.len); };
                if has_ap { let rc3: i32 = mb_s_str(s, STR_PTR("approvalPolicy"), STR_LEN("approvalPolicy"), mb_sp(&ap), ap.len); };
                MiniBridge_persist(b, s);
