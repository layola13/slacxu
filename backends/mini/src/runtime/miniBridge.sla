      }
      let reopened = self.getOrRestoreSession(targetSnap.threadId, s.ownerId);
      if (!reopened || reopened.parentThreadId !== s.threadId) return `resume_agent: unknown closed sub-agent '${String(target ?? "").slice(0, 80)}'. Only children closed by close_agent can be resumed; use list_agents to see live agents.`; // DEFECT: JS Array/String method
      reopened.closed = undefined;
      if (reopened.subStatus !== "completed" && reopened.subStatus !== "failed" && reopened.subStatus !== "interrupted") reopened.subStatus = "interrupted";
      reopened.pendingInputs = reopened.pendingInputs ?? [];
      self.persist(reopened);
      self.notifyMiniChild(reopened.threadId);
      return JSON.stringify({ agent_id: reopened.threadId, status: self.miniChildStatus(reopened), resumed: true }); // DEFECT: dynamic JSON (JSON.parse/stringify)
    }
    if (name === "interrupt_agent") {
      let target = typeof a.target === "string" ? a.target : typeof a.id === "string" ? a.id : ""; // DEFECT: runtime type test (typeof/instanceof/in)
