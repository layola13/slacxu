        let sd_low = MbStr { bytes: [0u8; 8192], len: 0 };
        mb_lower_into(mb_sp(&sd), sd.len, &sd_low);
        opts.ascending = mb_bytes_eq(mb_sp(&sd_low), sd_low.len, STR_PTR("asc"), STR_LEN("asc"));
        let pres = PageResult { page_json: [0; 262144], page_len: 0, has_nextCursor: false, nextCursor: [0; 128], nextCursor_len: 0 };
        let prc: i32 = pageThreadHistory(mb_sp(&thread), thread.len, mb_jp(&turns_text), turns_text.len, mb_jp(&msgs_text), msgs_text.len, &opts, &pres);
        let page_base: ptr = PTR_NULL();
        PTR_BYTE_ADD(page_base, &pres.page_json, 0);
        let page_doc: u64 = mb_parse(page_base, pres.page_len);
        let res: u64 = mb_new_obj();
        let rc: i32 = mb_s_node(res, STR_PTR("turns"), STR_LEN("turns"), mb_clone_node(page_doc));
        rc = mb_s_node(res, STR_PTR("data"), STR_LEN("data"), mb_clone_node(page_doc));
        if pres.has_nextCursor {
