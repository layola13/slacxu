                if !has_child { child = MiniBridge_get_session(b, mb_sp(&id), id.len); has_child = child != 0; };
                let bad: bool = !has_child;
                if has_child {
                    let par = MbStr { bytes: [0u8; 8192], len: 0 };
                    if mb_g_str(child, STR_PTR("parentThreadId"), STR_LEN("parentThreadId"), &par) && !mb_bytes_eq(mb_sp(&par), par.len, mb_sp(&s_tid), s_tid.len) { bad = true; };
                };
                let entry: u64 = mb_new_obj();
                if bad {
                    let rc: i32 = mb_s_str(entry, STR_PTR("agent_id"), STR_LEN("agent_id"), mb_sp(&id), id.len);
                    rc = mb_s_str(entry, STR_PTR("status"), STR_LEN("status"), STR_PTR("notFound"), STR_LEN("notFound"));
                    rc = mb_s_bool(entry, STR_PTR("has_report"), STR_LEN("has_report"), false);
                } else {
