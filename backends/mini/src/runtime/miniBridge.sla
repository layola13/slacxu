fn miniDeclaresTurnComplete(text: TextBuf) -> bool { // was: function miniDeclaresTurnComplete
  let lines = String(text ?? "").split(/\r?\n/).map((l) => l.trim()).filter(Boolean); // DEFECT: JS Array/String method
  if (!lines.length) return false;
  return /^[\s>*_`#-]*[*_`]{0,2}(?:DONE|完成)[*_`]{0,2}\s*[:：]/i.test(lines[lines.length - 1]!);
}
