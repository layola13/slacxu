            while wi < id_count {
                let id = MbStr { bytes: [0u8; 8192], len: 0 };
                let ok_id: bool = mb_n_str(mb_a_at(ids, wi), &id);
                let child: u64 = 0;
                let has_child: bool = false;
                MiniBridge_find_child(b, s, mb_sp(&id), id.len, &child, &has_child);
                if !has_child { child = MiniBridge_get_session(b, mb_sp(&id), id.len); has_child = child != 0; };
                if has_child {
                    let cid = MbStr { bytes: [0u8; 8192], len: 0 };
                    let ok_c: bool = mb_g_str(child, STR_PTR("threadId"), STR_LEN("threadId"), &cid);
                    let rc: i32 = mb_a_push_str(watch, mb_sp(&cid), cid.len);
                } else {
                    let rc: i32 = mb_a_push_str(watch, mb_sp(&id), id.len);
                };
                wi = wi + 1;
            }
            let wait_ms: u64 = remaining as u64;
            if wait_ms > 30000 { wait_ms = 30000; };
            MiniBridge_wait_child_notify(b, watch, wait_ms);
        }
    };
    if mb_bytes_eq(mb_sp(&name), name.len, STR_PTR("close_agent"), STR_LEN("close_agent")) {
        let target = MbStr { bytes: [0u8; 8192], len: 0 };
        if !mb_g_str(a, STR_PTR("target"), STR_LEN("target"), &target) {
            let ok_t: bool = mb_g_str(a, STR_PTR("id"), STR_LEN("id"), &target);
        };
        let child: u64 = 0;
        let has_child: bool = false;
        MiniBridge_find_child(b, s, mb_sp(&target), target.len, &child, &has_child);
        if !has_child {
            let msg = MbJson { bytes: [0u8; 262144], len: 0 };
            mb_jassign(&msg, STR_PTR("close_agent: unknown sub-agent '"), STR_LEN("close_agent: unknown sub-agent '"));
            let t80 = MbStr { bytes: [0u8; 8192], len: 0 };
            mb_slice_to_s(mb_sp(&target), target.len, 0, 80, &t80);
            mb_jappend(&msg, mb_sp(&t80), t80.len);
            mb_jappend(&msg, STR_PTR("'."), STR_LEN("'."));
            mb_jassign_j(out, &msg);
            return;
        };
        let prev = MbStr { bytes: [0u8; 8192], len: 0 };
        MiniBridge_child_status(child, &prev);
        MiniBridge_cancel_queued_child_turn(b, child, STR_PTR(""), STR_LEN(""), false);
        let report = MbStr { bytes: [0u8; 8192], len: 0 };
        let ok_r: bool = mb_g_str(child, STR_PTR("finalReport"), STR_LEN("finalReport"), &report);
        let rep2000 = MbStr { bytes: [0u8; 8192], len: 0 };
        mb_slice_to_s(mb_sp(&report), report.len, 0, 2000, &rep2000);
        let active = MbStr { bytes: [0u8; 8192], len: 0 };
        if mb_g_str(child, STR_PTR("activeTurnId"), STR_LEN("activeTurnId"), &active) {
            mb_sess_cancel_turn(child, mb_sp(&active), active.len);
        };
        let rc: i32 = mb_s_bool(child, STR_PTR("aborted"), STR_LEN("aborted"), true);
        rc = mb_o_remove(child, STR_PTR("activeTurnId"), STR_LEN("activeTurnId"));
        rc = mb_o_remove(child, STR_PTR("activeAbort"), STR_LEN("activeAbort"));
        if mb_bytes_eq(mb_sp(&prev), prev.len, STR_PTR("completed"), STR_LEN("completed")) || mb_bytes_eq(mb_sp(&prev), prev.len, STR_PTR("failed"), STR_LEN("failed")) {
            rc = mb_s_str(child, STR_PTR("subStatus"), STR_LEN("subStatus"), mb_sp(&prev), prev.len);
        } else {
            rc = mb_s_str(child, STR_PTR("subStatus"), STR_LEN("subStatus"), STR_PTR("interrupted"), STR_LEN("interrupted"));
        };
        rc = mb_s_node(child, STR_PTR("pendingInputs"), STR_LEN("pendingInputs"), mb_new_arr());
        rc = mb_s_bool(child, STR_PTR("closed"), STR_LEN("closed"), true);
        MiniBridge_persist(b, child);
        let child_id = MbStr { bytes: [0u8; 8192], len: 0 };
        let has_cid: bool = mb_g_str(child, STR_PTR("threadId"), STR_LEN("threadId"), &child_id);
        rc = mb_o_remove(b.sessions, mb_sp(&child_id), child_id.len);
        let fired: u64 = MiniBridge_notify_child(b, mb_sp(&child_id), child_id.len);
        let res: u64 = mb_new_obj();
        rc = mb_s_str(res, STR_PTR("agent_id"), STR_LEN("agent_id"), mb_sp(&child_id), child_id.len);
        rc = mb_s_str(res, STR_PTR("previous_status"), STR_LEN("previous_status"), mb_sp(&prev), prev.len);
        rc = mb_s_str(res, STR_PTR("report"), STR_LEN("report"), mb_sp(&rep2000), rep2000.len);
        let ok_s: bool = mb_stringify_node(res, out);
        return;
    };
    if mb_bytes_eq(mb_sp(&name), name.len, STR_PTR("resume_agent"), STR_LEN("resume_agent")) {
        let target = MbStr { bytes: [0u8; 8192], len: 0 };
        if !mb_g_str(a, STR_PTR("target"), STR_LEN("target"), &target) {
            let ok_t: bool = mb_g_str(a, STR_PTR("id"), STR_LEN("id"), &target);
        };
        let t = MbStr { bytes: [0u8; 8192], len: 0 };
        mb_trim_to(mb_sp(&target), target.len, &t);
        if t.len == 0 {
            mb_jassign(out, STR_PTR("resume_agent needs a target agent_id (a child previously closed by close_agent)."), STR_LEN("resume_agent needs a target agent_id (a child previously closed by close_agent)."));
            return;
        };
        // Live and never closed: report status (reopen is a no-op).
        let count: u64 = mb_n_count(b.sessions);
        let i: u64 = 0;
        while i < count {
            let kp: ptr = PTR_NULL();
            let kn: u64 = 0;
            if mb_key_at(b.sessions, i, &kp, &kn) {
                let cs: u64 = mb_g_node(b.sessions, kp, kn);
                if cs != 0 {
                    let par = MbStr { bytes: [0u8; 8192], len: 0 };
                    let closed: bool = false;
                    let ok_c: bool = mb_g_bool(cs, STR_PTR("closed"), STR_LEN("closed"), &closed);
                    if mb_g_str(cs, STR_PTR("parentThreadId"), STR_LEN("parentThreadId"), &par) && mb_bytes_eq(mb_sp(&par), par.len, mb_sp(&s_tid), s_tid.len) && MiniBridge_child_owner_visible(s, cs) && !closed {
                        let tn = MbStr { bytes: [0u8; 8192], len: 0 };
                        let ok_tn: bool = mb_g_str(cs, STR_PTR("taskName"), STR_LEN("taskName"), &tn);
                        if mb_bytes_eq(kp, kn, mb_sp(&t), t.len) || (ok_tn && mb_bytes_eq(mb_sp(&tn), tn.len, mb_sp(&t), t.len)) {
                            let status = MbStr { bytes: [0u8; 8192], len: 0 };
                            MiniBridge_child_status(cs, &status);
                            let res: u64 = mb_new_obj();
                            let rc: i32 = mb_s_str(res, STR_PTR("agent_id"), STR_LEN("agent_id"), kp, kn);
                            rc = mb_s_str(res, STR_PTR("status"), STR_LEN("status"), mb_sp(&status), status.len);
                            rc = mb_s_bool(res, STR_PTR("resumed"), STR_LEN("resumed"), false);
                            let ok_s: bool = mb_stringify_node(res, out);
                            return;
                        };
                    };
                };
            };
            i = i + 1;
        }
        // Closed rollout retained by close_agent: rehydrate and reopen.
        let snap_id = MbStr { bytes: [0u8; 8192], len: 0 };
        let has_snap: bool = false;
        let scount: u64 = mb_n_count(b.snapshots);
        let si: u64 = 0;
        while si < scount && !has_snap {
            let kp: ptr = PTR_NULL();
            let kn: u64 = 0;
            if mb_key_at(b.snapshots, si, &kp, &kn) {
                let snap: u64 = mb_g_node(b.snapshots, kp, kn);
                if snap != 0 {
                    let par = MbStr { bytes: [0u8; 8192], len: 0 };
                    let closed: bool = false;
                    let ok_c: bool = mb_g_bool(snap, STR_PTR("closed"), STR_LEN("closed"), &closed);
                    if mb_g_str(snap, STR_PTR("parentThreadId"), STR_LEN("parentThreadId"), &par) && mb_bytes_eq(mb_sp(&par), par.len, mb_sp(&s_tid), s_tid.len) && MiniBridge_child_owner_visible(s, snap) && closed {
                        let tn = MbStr { bytes: [0u8; 8192], len: 0 };
                        let ok_tn: bool = mb_g_str(snap, STR_PTR("taskName"), STR_LEN("taskName"), &tn);
                        if mb_bytes_eq(kp, kn, mb_sp(&t), t.len) || (ok_tn && mb_bytes_eq(mb_sp(&tn), tn.len, mb_sp(&t), t.len)) {
                            mb_sassign(&snap_id, kp, kn);
                            has_snap = true;
                        };
                    };
                };
            };
            si = si + 1;
        }
        if !has_snap {
            let msg = MbJson { bytes: [0u8; 262144], len: 0 };
            mb_jassign(&msg, STR_PTR("resume_agent: unknown closed sub-agent '"), STR_LEN("resume_agent: unknown closed sub-agent '"));
            let t80 = MbStr { bytes: [0u8; 8192], len: 0 };
            mb_slice_to_s(mb_sp(&target), target.len, 0, 80, &t80);
            mb_jappend(&msg, mb_sp(&t80), t80.len);
            mb_jappend(&msg, STR_PTR("'. Only children closed by close_agent can be resumed; use list_agents to see live agents."), STR_LEN("'. Only children closed by close_agent can be resumed; use list_agents to see live agents."));
            mb_jassign_j(out, &msg);
            return;
        };
        let live: u64 = MiniBridge_live_child_count(b, s);
        let max_children: u64 = miniSubagentMaxChildren();
        if live >= max_children {
            let msg = MbJson { bytes: [0u8; 262144], len: 0 };
            mb_jassign(&msg, STR_PTR("Agent concurrency limit reached ("), STR_LEN("Agent concurrency limit reached ("));
            let mc_s = MbStr { bytes: [0u8; 8192], len: 0 };
            mb_u64_to_s(max_children, &mc_s);
            mb_jappend(&msg, mb_sp(&mc_s), mc_s.len);
            mb_jappend(&msg, STR_PTR("). Wait for running agents with wait_agent or close finished ones, then retry."), STR_LEN("). Wait for running agents with wait_agent or close finished ones, then retry."));
            mb_jassign_j(out, &msg);
            return;
        };
        let owner = MbStr { bytes: [0u8; 8192], len: 0 };
        let has_owner: bool = mb_g_str(s, STR_PTR("ownerId"), STR_LEN("ownerId"), &owner);
        let reopened: u64 = 0;
        let has_reopened: bool = false;
        MiniBridge_get_or_restore_session(b, mb_sp(&snap_id), snap_id.len, mb_sp(&owner), owner.len, has_owner, &reopened, &has_reopened);
        let bad: bool = !has_reopened;
        if has_reopened {
            let par = MbStr { bytes: [0u8; 8192], len: 0 };
            if !mb_g_str(reopened, STR_PTR("parentThreadId"), STR_LEN("parentThreadId"), &par) || !mb_bytes_eq(mb_sp(&par), par.len, mb_sp(&s_tid), s_tid.len) { bad = true; };
        };
        if bad {
            let msg = MbJson { bytes: [0u8; 262144], len: 0 };
            mb_jassign(&msg, STR_PTR("resume_agent: unknown closed sub-agent '"), STR_LEN("resume_agent: unknown closed sub-agent '"));
            let t80 = MbStr { bytes: [0u8; 8192], len: 0 };
            mb_slice_to_s(mb_sp(&target), target.len, 0, 80, &t80);
            mb_jappend(&msg, mb_sp(&t80), t80.len);
            mb_jappend(&msg, STR_PTR("'. Only children closed by close_agent can be resumed; use list_agents to see live agents."), STR_LEN("'. Only children closed by close_agent can be resumed; use list_agents to see live agents."));
            mb_jassign_j(out, &msg);
            return;
        };
        let rc: i32 = mb_o_remove(reopened, STR_PTR("closed"), STR_LEN("closed"));
        let sub = MbStr { bytes: [0u8; 8192], len: 0 };
        let has_sub: bool = mb_g_str(reopened, STR_PTR("subStatus"), STR_LEN("subStatus"), &sub);
        let terminal_sub: bool = has_sub && (mb_bytes_eq(mb_sp(&sub), sub.len, STR_PTR("completed"), STR_LEN("completed")) || mb_bytes_eq(mb_sp(&sub), sub.len, STR_PTR("failed"), STR_LEN("failed")) || mb_bytes_eq(mb_sp(&sub), sub.len, STR_PTR("interrupted"), STR_LEN("interrupted")));
        if !terminal_sub { rc = mb_s_str(reopened, STR_PTR("subStatus"), STR_LEN("subStatus"), STR_PTR("interrupted"), STR_LEN("interrupted")); };
        if !mb_g_has(reopened, STR_PTR("pendingInputs"), STR_LEN("pendingInputs")) { rc = mb_s_node(reopened, STR_PTR("pendingInputs"), STR_LEN("pendingInputs"), mb_new_arr()); };
        MiniBridge_persist(b, reopened);
        let fired: u64 = MiniBridge_notify_child(b, mb_sp(&snap_id), snap_id.len);
        let status = MbStr { bytes: [0u8; 8192], len: 0 };
        MiniBridge_child_status(reopened, &status);
        let res: u64 = mb_new_obj();
        rc = mb_s_str(res, STR_PTR("agent_id"), STR_LEN("agent_id"), mb_sp(&snap_id), snap_id.len);
        rc = mb_s_str(res, STR_PTR("status"), STR_LEN("status"), mb_sp(&status), status.len);
        rc = mb_s_bool(res, STR_PTR("resumed"), STR_LEN("resumed"), true);
        let ok_s: bool = mb_stringify_node(res, out);
        return;
    };
    if mb_bytes_eq(mb_sp(&name), name.len, STR_PTR("interrupt_agent"), STR_LEN("interrupt_agent")) {
        let target = MbStr { bytes: [0u8; 8192], len: 0 };
        if !mb_g_str(a, STR_PTR("target"), STR_LEN("target"), &target) {
            let ok_t: bool = mb_g_str(a, STR_PTR("id"), STR_LEN("id"), &target);
        };
        let child: u64 = 0;
        let has_child: bool = false;
        MiniBridge_find_child(b, s, mb_sp(&target), target.len, &child, &has_child);
        if !has_child {
            let msg = MbJson { bytes: [0u8; 262144], len: 0 };
            mb_jassign(&msg, STR_PTR("interrupt_agent: unknown sub-agent '"), STR_LEN("interrupt_agent: unknown sub-agent '"));
            let t80 = MbStr { bytes: [0u8; 8192], len: 0 };
            mb_slice_to_s(mb_sp(&target), target.len, 0, 80, &t80);
            mb_jappend(&msg, mb_sp(&t80), t80.len);
            mb_jappend(&msg, STR_PTR("'. Use list_agents to see live agents."), STR_LEN("'. Use list_agents to see live agents."));
            mb_jassign_j(out, &msg);
            return;
        };
        let prev = MbStr { bytes: [0u8; 8192], len: 0 };
        MiniBridge_child_status(child, &prev);
        let child_id = MbStr { bytes: [0u8; 8192], len: 0 };
        let has_cid: bool = mb_g_str(child, STR_PTR("threadId"), STR_LEN("threadId"), &child_id);
        let active = MbStr { bytes: [0u8; 8192], len: 0 };
        if !mb_g_str(child, STR_PTR("activeTurnId"), STR_LEN("activeTurnId"), &active) {
            let res: u64 = mb_new_obj();
            let rc: i32 = mb_s_str(res, STR_PTR("agent_id"), STR_LEN("agent_id"), mb_sp(&child_id), child_id.len);
            rc = mb_s_str(res, STR_PTR("previous_status"), STR_LEN("previous_status"), mb_sp(&prev), prev.len);
            rc = mb_s_bool(res, STR_PTR("interrupted"), STR_LEN("interrupted"), false);
            let ok_s: bool = mb_stringify_node(res, out);
            return;
        };
        mb_sess_cancel_turn(child, mb_sp(&active), active.len);
        let rc: i32 = mb_s_bool(child, STR_PTR("aborted"), STR_LEN("aborted"), true);
        let fired: u64 = MiniBridge_notify_child(b, mb_sp(&child_id), child_id.len);
        let res: u64 = mb_new_obj();
        rc = mb_s_str(res, STR_PTR("agent_id"), STR_LEN("agent_id"), mb_sp(&child_id), child_id.len);
        rc = mb_s_str(res, STR_PTR("previous_status"), STR_LEN("previous_status"), mb_sp(&prev), prev.len);
        rc = mb_s_bool(res, STR_PTR("interrupted"), STR_LEN("interrupted"), true);
        let ok_s2: bool = mb_stringify_node(res, out);
        return;
    };
    if mb_bytes_eq(mb_sp(&name), name.len, STR_PTR("list_agents"), STR_LEN("list_agents")) {
        let prefix_raw = MbStr { bytes: [0u8; 8192], len: 0 };
        let ok_p: bool = mb_g_str(a, STR_PTR("path_prefix"), STR_LEN("path_prefix"), &prefix_raw);
        let prefix = MbStr { bytes: [0u8; 8192], len: 0 };
        mb_trim_to(mb_sp(&prefix_raw), prefix_raw.len, &prefix);
        while prefix.len > 0 && prefix.bytes[prefix.len - 1] == 47 { prefix.len = prefix.len - 1; }
        let agents: u64 = mb_new_arr();
        let seen: u64 = mb_new_arr();
        let count: u64 = mb_n_count(b.sessions);
        let i: u64 = 0;
        while i < count {
            let kp: ptr = PTR_NULL();
            let kn: u64 = 0;
            if mb_key_at(b.sessions, i, &kp, &kn) {
                let cs: u64 = mb_g_node(b.sessions, kp, kn);
                if cs != 0 {
                    let par = MbStr { bytes: [0u8; 8192], len: 0 };
                    let closed: bool = false;
                    let ok_c: bool = mb_g_bool(cs, STR_PTR("closed"), STR_LEN("closed"), &closed);
                    if mb_g_str(cs, STR_PTR("parentThreadId"), STR_LEN("parentThreadId"), &par) && mb_bytes_eq(mb_sp(&par), par.len, mb_sp(&s_tid), s_tid.len) && MiniBridge_child_owner_visible(s, cs) && !closed {
                        let tn = MbStr { bytes: [0u8; 8192], len: 0 };
                        let has_tn: bool = mb_g_str(cs, STR_PTR("taskName"), STR_LEN("taskName"), &tn);
                        let matches: bool = prefix.len == 0 || (has_tn && (mb_bytes_eq(mb_sp(&tn), tn.len, mb_sp(&prefix), prefix.len) || mb_index_of(mb_sp(&tn), tn.len, mb_sp(&prefix), prefix.len) == 0));
                        if matches {
                            let e: u64 = mb_new_obj();
                            let rc: i32 = mb_s_str(e, STR_PTR("agent_id"), STR_LEN("agent_id"), kp, kn);
                            rc = mb_s_str(e, STR_PTR("task_name"), STR_LEN("task_name"), mb_sp(&tn), tn.len);
                            let at = MbStr { bytes: [0u8; 8192], len: 0 };
                            let ok_at: bool = mb_g_str(cs, STR_PTR("agentType"), STR_LEN("agentType"), &at);
                            rc = mb_s_str(e, STR_PTR("agent_type"), STR_LEN("agent_type"), mb_sp(&at), at.len);
                            let status = MbStr { bytes: [0u8; 8192], len: 0 };
                            MiniBridge_child_status(cs, &status);
                            rc = mb_s_str(e, STR_PTR("status"), STR_LEN("status"), mb_sp(&status), status.len);
                            rc = mb_a_push_node(agents, e);
                            rc = mb_a_push_str(seen, kp, kn);
                        };
                    };
                };
            };
            i = i + 1;
        }
        let scount: u64 = mb_n_count(b.snapshots);
        let si: u64 = 0;
        while si < scount {
            let kp: ptr = PTR_NULL();
            let kn: u64 = 0;
            if mb_key_at(b.snapshots, si, &kp, &kn) {
                let snap: u64 = mb_g_node(b.snapshots, kp, kn);
                if snap != 0 && !mb_str_in_arr(seen, kp, kn, false) {
                    let par = MbStr { bytes: [0u8; 8192], len: 0 };
                    let archived: bool = false;
                    let ok_a: bool = mb_g_bool(snap, STR_PTR("archived"), STR_LEN("archived"), &archived);
                    let closed: bool = false;
                    let ok_c: bool = mb_g_bool(snap, STR_PTR("closed"), STR_LEN("closed"), &closed);
                    if mb_g_str(snap, STR_PTR("parentThreadId"), STR_LEN("parentThreadId"), &par) && mb_bytes_eq(mb_sp(&par), par.len, mb_sp(&s_tid), s_tid.len) && !archived && !closed && MiniBridge_child_owner_visible(s, snap) {
                        let tn = MbStr { bytes: [0u8; 8192], len: 0 };
                        let has_tn: bool = mb_g_str(snap, STR_PTR("taskName"), STR_LEN("taskName"), &tn);
                        let matches: bool = prefix.len == 0 || (has_tn && (mb_bytes_eq(mb_sp(&tn), tn.len, mb_sp(&prefix), prefix.len) || mb_index_of(mb_sp(&tn), tn.len, mb_sp(&prefix), prefix.len) == 0));
                        if matches {
                            let e: u64 = mb_new_obj();
                            let rc: i32 = mb_s_str(e, STR_PTR("agent_id"), STR_LEN("agent_id"), kp, kn);
                            rc = mb_s_str(e, STR_PTR("task_name"), STR_LEN("task_name"), mb_sp(&tn), tn.len);
                            let at = MbStr { bytes: [0u8; 8192], len: 0 };
                            let ok_at: bool = mb_g_str(snap, STR_PTR("agentType"), STR_LEN("agentType"), &at);
                            rc = mb_s_str(e, STR_PTR("agent_type"), STR_LEN("agent_type"), mb_sp(&at), at.len);
                            let sub = MbStr { bytes: [0u8; 8192], len: 0 };
                            let has_sub: bool = mb_g_str(snap, STR_PTR("subStatus"), STR_LEN("subStatus"), &sub);
                            if !has_sub || mb_bytes_eq(mb_sp(&sub), sub.len, STR_PTR("running"), STR_LEN("running")) {
                                rc = mb_s_str(e, STR_PTR("status"), STR_LEN("status"), STR_PTR("interrupted"), STR_LEN("interrupted"));
                            } else {
                                rc = mb_s_str(e, STR_PTR("status"), STR_LEN("status"), mb_sp(&sub), sub.len);
                            };
                            rc = mb_a_push_node(agents, e);
                        };
                    };
                };
            };
            si = si + 1;
        }
        let res: u64 = mb_new_obj();
        let rc9: i32 = mb_s_node(res, STR_PTR("agents"), STR_LEN("agents"), agents);
        let ok_s: bool = mb_stringify_node(res, out);
        return;
    };
    miniUnknownToolError(mb_sp(&name), name.len, true, out);
}
