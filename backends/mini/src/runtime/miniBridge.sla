        rc = mb_s_str(s, STR_PTR("cwd"), STR_LEN("cwd"), mb_sp(&cwd), cwd.len);
        if !mb_g_str(rr, STR_PTR("model"), STR_LEN("model"), &v) { mb_sassign(&v, STR_PTR("gpt-5-mini"), STR_LEN("gpt-5-mini")); };
        rc = mb_s_str(s, STR_PTR("model"), STR_LEN("model"), mb_sp(&v), v.len);
        let roots: u64 = 0;
        let has_roots: bool = false;
        miniAdditionalRoots(rr, mb_sp(&cwd), cwd.len, &roots, &has_roots);
        if has_roots { rc = mb_s_node(s, STR_PTR("additionalRoots"), STR_LEN("additionalRoots"), roots); };
        if mb_g_str(rr, STR_PTR("providerId"), STR_LEN("providerId"), &v) { rc = mb_s_str(s, STR_PTR("providerId"), STR_LEN("providerId"), mb_sp(&v), v.len); };
        if mb_g_str(rr, STR_PTR("groupId"), STR_LEN("groupId"), &v) { rc = mb_s_str(s, STR_PTR("groupId"), STR_LEN("groupId"), mb_sp(&v), v.len); };
        let eff = MbStr { bytes: [0u8; 8192], len: 0 };
        let has_eff: bool = false;
        extractMiniEffort(rr, &eff, &has_eff);
        if !has_eff { mb_sassign(&eff, STR_PTR("medium"), STR_LEN("medium")); };
        rc = mb_s_str(s, STR_PTR("effort"), STR_LEN("effort"), mb_sp(&eff), eff.len);
        let sb = MbStr { bytes: [0u8; 8192], len: 0 };
        let has_sb: bool = false;
        normalizeMiniSandbox(mb_g_node(rr, STR_PTR("sandbox"), STR_LEN("sandbox")), &sb, &has_sb);
        if has_sb { rc = mb_s_str(s, STR_PTR("sandbox"), STR_LEN("sandbox"), mb_sp(&sb), sb.len); };
        let ap = MbStr { bytes: [0u8; 8192], len: 0 };
