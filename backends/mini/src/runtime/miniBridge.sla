                            let grp: u64 = mb_g_node(s, STR_PTR("groupId"), STR_LEN("groupId"));
                            if grp != 0 { rc = mb_s_node(e, STR_PTR("groupId"), STR_LEN("groupId"), mb_clone_node(grp)); } else { rc = mb_s_null(e, STR_PTR("groupId"), STR_LEN("groupId")); };
                            if mb_g_str(s, STR_PTR("model"), STR_LEN("model"), &v) { rc = mb_s_str(e, STR_PTR("model"), STR_LEN("model"), mb_sp(&v), v.len); };
                            if mb_g_str(s, STR_PTR("name"), STR_LEN("name"), &v) { rc = mb_s_str(e, STR_PTR("name"), STR_LEN("name"), mb_sp(&v), v.len); } else { rc = mb_s_null(e, STR_PTR("name"), STR_LEN("name")); };
                            if mb_g_str(s, STR_PTR("preview"), STR_LEN("preview"), &v) { rc = mb_s_str(e, STR_PTR("preview"), STR_LEN("preview"), mb_sp(&v), v.len); } else { rc = mb_s_null(e, STR_PTR("preview"), STR_LEN("preview")); };
                            let has_active: bool = mb_g_has(s, STR_PTR("activeTurnId"), STR_LEN("activeTurnId"));
                            rc = mb_s_str(e, STR_PTR("status"), STR_LEN("status"), if has_active { STR_PTR("running") } else { STR_PTR("idle") }, if has_active { STR_LEN("running") } else { STR_LEN("idle") });
                            rc = mb_a_push_node(threads, e);
                            rc = mb_a_push_str(seen, kp, kn);
