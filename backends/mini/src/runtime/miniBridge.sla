  let toBlocks = (content: unknown): Array<Record<string, unknown>> => { // DEFECT: arrow function / closure
    if (typeof content === "string") return content.trim() ? [{ type: "text", text: content }] : []; // DEFECT: runtime type test (typeof/instanceof/in)
    if (Array.isArray(content)) return (content as Array<Record<string, unknown>>).filter((b) => b && typeof b === "object"); // DEFECT: runtime type test (typeof/instanceof/in)
    return [];
  };
  let fromBlocks = (blocks: Array<Record<string, unknown>>, role: string): Record<string, unknown> | null => { // DEFECT: arrow function / closure
    if (!blocks.length) return null;
    if (blocks.length === 1 && blocks[0]?.type === "text") return { role, content: String(blocks[0]?.text ?? "") }; // DEFECT: optional chaining ?.
    return { role, content: blocks };
  };
  let merged: Array<Record<string, unknown>> = [];
  for (const msg of raw) {
    let role = String((msg as Record<string, unknown>).role ?? ""); // DEFECT: type assertion (as)
    if (!role) continue;
    let blocks = toBlocks((msg as Record<string, unknown>).content); // DEFECT: type assertion (as)
    if (!blocks.length) continue;
    let prev = merged.length ? merged[merged.length - 1] as Record<string, unknown> : null; // DEFECT: type assertion (as)
    if (prev && String(prev.role ?? "") === role) {
      let prevBlocks = toBlocks(prev.content);
      let next = fromBlocks([...prevBlocks, ...blocks], role);
      if (next) merged[merged.length - 1] = next;
      continue;
    }
    let next = fromBlocks(blocks, role);
    if (next) merged.push(next); // DEFECT: JS Array/String method
  }
  let toolUseIdsOf = (msg: Record<string, unknown> | null): Set<string> => { // DEFECT: arrow function / closure
    let ids = new Set<string>(); // DEFECT: JS builtin construction (Map/Set/Date/RegExp/AbortController/Error)
    if (!msg || String(msg.role ?? "") !== "assistant") return ids;
    for (const b of toBlocks(msg.content)) {
      if (b.type === "tool_use" && typeof b.id === "string" && b.id) ids.add(b.id); // DEFECT: runtime type test (typeof/instanceof/in)
    }
    return ids;
  };
  let messages: Array<Record<string, unknown>> = [];
  for (const msg of merged) {
    let role = String(msg.role ?? "");
    if (role !== "user" && role !== "assistant") continue;
    if (role === "user") {
      let blocks = toBlocks(msg.content);
      let hasResult = blocks.some((b) => b.type === "tool_result"); // DEFECT: JS Array/String method
      if (!hasResult) {
        let next = fromBlocks(blocks, role);
        if (next) messages.push(next); // DEFECT: JS Array/String method
        continue;
      }
      let prev = messages.length ? messages[messages.length - 1] as Record<string, unknown> : null; // DEFECT: type assertion (as)
      let valid = toolUseIdsOf(prev);
      let kept = blocks.filter((b) => { // DEFECT: JS Array/String method
        if (b.type !== "tool_result") return true;
        return typeof b.tool_use_id === "string" && valid.has(b.tool_use_id); // DEFECT: runtime type test (typeof/instanceof/in)
      });
      // A user turn made only of orphan results carries no task signal and
      // would still 400 (previous message is not its tool_use): drop it so
      // the next user text re-anchors the thread.
      let onlyOrphans = kept.every((b) => b.type !== "text" && b.type !== "image"); // DEFECT: JS Array/String method
      if (!kept.length || (onlyOrphans && kept.length !== blocks.length && valid.size === 0)) {
        if (!kept.length) continue;
        let nonResult = kept.filter((b) => b.type !== "tool_result"); // DEFECT: JS Array/String method
        if (!nonResult.length) continue;
        let next = fromBlocks(nonResult, role);
        if (next) messages.push(next); // DEFECT: JS Array/String method
        continue;
      }
      let next = fromBlocks(kept, role);
      if (next) messages.push(next); // DEFECT: JS Array/String method
      continue;
    }
    let next = fromBlocks(toBlocks(msg.content), role);
    if (next) messages.push(next); // DEFECT: JS Array/String method
  }
  // Anthropic requires the first message to be user. Drop leading assistants
  // left behind when history truncation removed the opening user turn.
  while (messages.length && String(messages[0]?.role ?? "") !== "user") messages.shift(); // DEFECT: optional chaining ?.
  // This model family rejects assistant prefill: the conversation must end
  // with a user message. Orphan filtering above can expose a trailing
  // assistant (its results never arrived): drop dangling tool_uses, and if a
  // trailing assistant text remains, re-anchor with a minimal user continuer
  // instead of 400ing. Mini-only; chat/responses threads are untouched.
  while (messages.length && String(messages[messages.length - 1]?.role ?? "") === "assistant") { // DEFECT: optional chaining ?.
    let last = messages[messages.length - 1] as Record<string, unknown>; // DEFECT: type assertion (as)
    let blocks = toBlocks(last.content);
    if (blocks.some((b) => b.type === "tool_use")) { // DEFECT: JS Array/String method
      messages.pop();
      continue;
    }
    if (!blocks.length) {
      messages.pop();
      continue;
    }
    messages.push({ role: "user", content: "[Continue with the task above.]" }); // DEFECT: JS Array/String method
    break;
  }
  // Trailing-text nudge (send-time only, never persisted): some gateways
  // reject a final user message that carries only `tool_result` blocks even
  // though the spec allows it. A neutral text block keeps pairing intact.
  // No-op unless the tail is exactly tool_result-only, so identical input
  // without the flag yields an identical skeleton (used to detect N/A).
  let trailingText = typeof opts.trailingUserText === "string" ? opts.trailingUserText : ""; // DEFECT: runtime type test (typeof/instanceof/in)
  if (trailingText.trim() && messages.length) { // DEFECT: JS Array/String method
    let lastNudged = messages[messages.length - 1] as Record<string, unknown>; // DEFECT: type assertion (as)
    if (String(lastNudged?.role ?? "") === "user") { // DEFECT: optional chaining ?.
      let lastBlocks = toBlocks(lastNudged.content);
      if (lastBlocks.some((b) => b.type === "tool_result") // DEFECT: JS Array/String method
        && !lastBlocks.some((b) => b.type === "text" || b.type === "image")) { // DEFECT: JS Array/String method
        let nudged = fromBlocks([...lastBlocks, { type: "text", text: trailingText }], "user");
        if (nudged) messages[messages.length - 1] = nudged;
      }
    }
  }
  if (!messages.length) messages.push({ role: "user", content: "[Continue with the task above.]" }); // DEFECT: JS Array/String method
  // Claude 专属：思考档位默认与全档位映射只对 Claude 模型生效。
  // 非 Claude 模型走 Anthropic 协议时保持旧语义（仅 medium/high/xhigh 带
  // thinking，low/none → disabled，其余省略），避免 Codex/其他模型原来
  // 能跑的调用被意外开启 thinking。
  let isClaudeModel = isClaudeModelId(opts.model);
  let normEffort = normalizeMiniEffort(opts.effort) ?? (isClaudeModel ? MINI_DEFAULT_EFFORT : undefined);
  let isHaiku = /haiku/i.test(String(opts.model ?? ""));
  // Adaptive-only models (Opus/Sonnet/Haiku 5.5+): legacy enabled/budget 400s. Explicit
  // opt-in wins, otherwise auto-detect by model id so the first attempt is
  // already adaptive. wantDisabled still omits thinking (allowed by upstream).
  // Old Haiku gating (only high/xhigh keep thinking) does NOT apply to adaptive
  // models: haiku-5-5 supports full adaptive efforts like opus/sonnet-5-5.
  let wantAdaptive = opts.adaptiveThinking ?? requiresAnthropicAdaptiveThinking(opts.model);
  let wantDisabled = opts.disableThinking || normEffort === "none"
    || (!isClaudeModel && normEffort === "low")
    || (isHaiku && !wantAdaptive && normEffort !== "high" && normEffort !== "xhigh");

  let maxTokens = opts.maxTokens ?? MINI_ANTHROPIC_MAX_TOKENS;
  let thinkingObj: Record<string, unknown> | undefined;
  let outputConfigObj: Record<string, unknown> | undefined;
  if (!opts.omitThinking) {
    if (wantAdaptive) {
      if (!wantDisabled) {
        let adaptiveEffort = miniAnthropicAdaptiveEffort(normEffort ?? MINI_DEFAULT_EFFORT) ?? "medium";
        thinkingObj = { type: "adaptive" };
        outputConfigObj = { effort: adaptiveEffort };
      }
    } else if (wantDisabled && (opts.disableThinking || normEffort || isHaiku)) {
      thinkingObj = { type: "disabled" };
    } else if (isClaudeModel && normEffort) {
      // 8档对齐: none→disabled(上); minimal/low→1024; medium→2048;
      // high→4096; xhigh/ultra/max→8192 (ultra→xhigh, max→xhigh 与 sanitizeClaudeCliEffort 一致)。
      let budget = normEffort === "xhigh" || normEffort === "ultra" || normEffort === "max" ? 8192
        : normEffort === "high" ? 4096
        : normEffort === "minimal" || normEffort === "low" ? 1024
        : 2048;
      maxTokens = Math.max(maxTokens, budget + 2048);
      thinkingObj = { type: "enabled", budget_tokens: budget };
    } else if (!isClaudeModel && (normEffort === "medium" || normEffort === "high" || normEffort === "xhigh")) {
      // 非 Claude 保持旧语义。
      let budget = normEffort === "xhigh" ? 8192 : normEffort === "high" ? 4096 : 2048;
      maxTokens = Math.max(maxTokens, budget + 2048);
      thinkingObj = { type: "enabled", budget_tokens: budget };
    }
  }

  let body: Record<string, unknown> = {
    model: opts.model,
    max_tokens: maxTokens,
    messages,
    stream: true,
  };
  if (thinkingObj) body.thinking = thinkingObj;
  if (outputConfigObj) body.output_config = outputConfigObj;
  if (systems.length) body.system = systems.join("\n\n"); // DEFECT: JS Array/String method
  if (opts.tools.length) {
    body.tools = opts.tools.map((t) => { // DEFECT: JS Array/String method
      let s = t.schema && typeof t.schema === "object" && !Array.isArray(t.schema) ? t.schema : {}; // DEFECT: runtime type test (typeof/instanceof/in)
      let input_schema = typeof (s as Record<string, unknown>).type === "string" // DEFECT: runtime type test (typeof/instanceof/in)
        ? s
        : { type: "object", ...s };
      return {
        name: t.name,
        description: t.description ?? "",
        input_schema,
      };
    });
    body.tool_choice = { type: "auto" };
  }
  return body;
}

// Newest outputs kept intact when shrinking a turn thread in place. */
let MINI_SHRINK_KEEP_FULL_OUTPUTS = 3;
// Max chars per older tool output after shrinking. */
let MINI_SHRINK_MAX_OUTPUT_CHARS = 1000;

fn shrinkMiniOutputText(text: TextBuf, maxChars: f64) -> TextBuf { // was: function shrinkMiniOutputText
  if (text.length <= maxChars) return text;
  // Head+tail: code-writing follow-ups usually need the tail (the target
  // function, the applied hunk) more than the middle. Total stays ~maxChars
  // so budget accounting is unchanged.
  let tailChars = Math.floor(maxChars * 0.4);
  let headChars = Math.max(0, maxChars - tailChars);
  return `${text.slice(0, headChars)}\n…[output truncated, ${text.length - maxChars} chars omitted]\n${text.slice(text.length - tailChars)}`; // DEFECT: JS Array/String method
}

// True when serialized sa_vm args describe a file-lane write (edit/write/patch/...). */
fn isMiniFileLaneArgs(raw: JsonValue) -> bool { // was: function isMiniFileLaneArgs
  if (typeof raw !== "string" || !raw.trim()) return false; // DEFECT: runtime type test (typeof/instanceof/in)
  try { // DEFECT: exception (try/catch/throw)
    let parsed = JSON.parse(raw) as Record<string, any>; // DEFECT: dynamic JSON (JSON.parse/stringify)
    let act = typeof parsed.action === "string" ? parsed.action.trim().toLowerCase() : ""; // DEFECT: runtime type test (typeof/instanceof/in)
    return MINI_FILE_LANE_ACTIONS.has(act);
  } catch { // DEFECT: exception (try/catch/throw)
    return false;
  }
}

fn shrinkMiniOutputParts(parts: JsonArray, maxChars: f64) -> TextBuf { // was: function shrinkMiniOutputParts
  let texts: string[] = [];
  for (const p of parts) {
    if (typeof p === "string") { texts.push(p); continue; } // DEFECT: runtime type test (typeof/instanceof/in)
    if (!p || typeof p !== "object") continue; // DEFECT: runtime type test (typeof/instanceof/in)
    let rec = p as Record<string, any>; // DEFECT: type assertion (as)
    if (typeof rec.text === "string") texts.push(rec.text); // DEFECT: runtime type test (typeof/instanceof/in)
  }
  return shrinkMiniOutputText(texts.join("\n"), maxChars); // DEFECT: JS Array/String method
}

//
 //* Shrink older tool outputs inside a turn accumulator (same items, shorter
 //* outputs) so a long turn fits the in-turn budget without ending the work.
 //* Structurally safe: call/output pairing and ids are untouched, only output
 //* text is truncated and image parts are dropped from old outputs.
 //* Code-writing aware: outputs of file-lane writes (edit/write/apply_patch,
 //* resolved from the thread's own call items) are never shrunk — they carry
 //* the exact post-edit state follow-up steps depend on, and they are small
 //* anyway. Truncation keeps head+tail instead of head-only.
 //* Returns how many outputs were shrunk and roughly how many chars were saved.
 //
function shrinkMiniThreadOutputs<T extends Record<string, any>>(
  thread: T[],
  keepFull: number = MINI_SHRINK_KEEP_FULL_OUTPUTS,
  maxChars: number = MINI_SHRINK_MAX_OUTPUT_CHARS,
): { shrunk: number; savedChars: number } {
  // File-lane write outputs are load-bearing exact state: resolve their
  // call ids from the thread's own call items (both protocols) and exempt
  // them from shrinking.
  let protectedIds = new Set<string>(); // DEFECT: JS builtin construction (Map/Set/Date/RegExp/AbortController/Error)
  for (const it of thread) {
    let rec = it as Record<string, any>; // DEFECT: type assertion (as)
    if (Array.isArray(rec.tool_calls)) {
      for (const tc of rec.tool_calls) {
        let t = tc as Record<string, any>; // DEFECT: type assertion (as)
        let fn = t?.function as Record<string, any> | undefined; // DEFECT: optional chaining ?.
        if (typeof t?.id === "string" && fn?.name === "sa_vm" && isMiniFileLaneArgs(fn.arguments)) { // DEFECT: runtime type test (typeof/instanceof/in)
          protectedIds.add(t.id);
        }
      }
    }
    if ((rec.type === "function_call" || rec.type === "custom_tool_call")
      && typeof rec.call_id === "string" && rec.name === "sa_vm" && isMiniFileLaneArgs(rec.arguments)) { // DEFECT: runtime type test (typeof/instanceof/in)
      protectedIds.add(rec.call_id);
    }
  }
  let outputIdx: number[] = [];
  for (let i = 0; i < thread.length; i++) {
    let it = thread[i] as Record<string, any>; // DEFECT: type assertion (as)
    if (it?.role === "tool" || it?.type === "function_call_output") outputIdx.push(i); // DEFECT: optional chaining ?.
  }
  let shrinkable = outputIdx
    .filter((i) => { // DEFECT: JS Array/String method
      let it = thread[i] as Record<string, any>; // DEFECT: type assertion (as)
      let id = it?.tool_call_id ?? it?.call_id; // DEFECT: optional chaining ?.
      return typeof id !== "string" || !protectedIds.has(id); // DEFECT: runtime type test (typeof/instanceof/in)
    })
    .slice(0, Math.max(0, outputIdx.length - keepFull)); // DEFECT: JS Array/String method
  let shrunk = 0;
  let savedChars = 0;
  for (const i of shrinkable) {
    let it = thread[i] as Record<string, any>; // DEFECT: type assertion (as)
    let content = it.content;
    let output = it.output;
    if (typeof content === "string" && content.length > maxChars) { // DEFECT: runtime type test (typeof/instanceof/in)
      savedChars += content.length - maxChars;
      it.content = shrinkMiniOutputText(content, maxChars);
      shrunk++;
    } else if (Array.isArray(content)) {
      let before = JSON.stringify(content).length; // DEFECT: dynamic JSON (JSON.parse/stringify)
      let next = shrinkMiniOutputParts(content, maxChars);
      if (next.length < before) { it.content = next; savedChars += before - next.length; shrunk++; }
    } else if (typeof output === "string" && output.length > maxChars) { // DEFECT: runtime type test (typeof/instanceof/in)
      savedChars += output.length - maxChars;
      it.output = shrinkMiniOutputText(output, maxChars);
      shrunk++;
    } else if (Array.isArray(output)) {
      let before = JSON.stringify(output).length; // DEFECT: dynamic JSON (JSON.parse/stringify)
      let next = shrinkMiniOutputParts(output, maxChars);
      if (next.length < before) { it.output = next; savedChars += before - next.length; shrunk++; }
    }
  }
  return { shrunk, savedChars };
}

struct MiniUsageTotals { // was: interface 
  inputTokens: number;
  outputTokens: number;
  cachedInputTokens?: number;
  cacheWriteInputTokens?: number;
  reasoningOutputTokens?: number;
  estimated: boolean;
}

// Build the `thread/tokenUsage/updated` payload the composer ring consumes. */
function buildMiniTokenUsage(
  totals: MiniUsageTotals,
  round: MiniUsageDelta,
  contextWindow: number,
): Record<string, unknown> {
  let last = {
    totalTokens: round.inputTokens + round.outputTokens,
    inputTokens: round.inputTokens,
    cachedInputTokens: round.cachedInputTokens ?? 0,
    cacheWriteInputTokens: round.cacheWriteInputTokens ?? 0,
    outputTokens: round.outputTokens,
    reasoningOutputTokens: round.reasoningOutputTokens ?? 0,
    // normalizeMiniUsage already folds reasoning into outputTokens; tell the
    // usage store not to add it a second time (axonhub: completion includes reasoning).
    reasoningIncludedInOutput: true,
  };
  let total = {
    totalTokens: totals.inputTokens + totals.outputTokens,
    inputTokens: totals.inputTokens,
    cachedInputTokens: totals.cachedInputTokens ?? 0,
    cacheWriteInputTokens: totals.cacheWriteInputTokens ?? 0,
    outputTokens: totals.outputTokens,
    reasoningOutputTokens: totals.reasoningOutputTokens ?? 0,
    reasoningIncludedInOutput: true,
  };
  // Ring semantics mirror the engine: context load = latest input side.
  let contextUsage = {
    ...last,
    totalTokens: round.inputTokens,
    outputTokens: 0,
    reasoningOutputTokens: 0,
  };
  return { total, last, contextUsage, modelContextWindow: contextWindow };
}

// Auto-compact policy (Codex principle: threshold trigger + cooldown +
// never block the send). Defaults match the product savings-mode range.
let MINI_AUTO_COMPACT_DEFAULT_THRESHOLD = 80;
let MINI_AUTO_COMPACT_MIN_THRESHOLD = 50;
let MINI_AUTO_COMPACT_MAX_THRESHOLD = 95;
let MINI_AUTO_COMPACT_COOLDOWN_MS = 60_000;

fn miniAutoCompactThreshold() -> f64 { // was: function miniAutoCompactThreshold
  let text = (process.env.MINI_AUTO_COMPACT_THRESHOLD ?? "").trim(); // DEFECT: process.* Node API
  if (!text) return MINI_AUTO_COMPACT_DEFAULT_THRESHOLD;
  let raw = Number(text);
  if (!Number.isFinite(raw)) return MINI_AUTO_COMPACT_DEFAULT_THRESHOLD;
  return Math.min(MINI_AUTO_COMPACT_MAX_THRESHOLD, Math.max(MINI_AUTO_COMPACT_MIN_THRESHOLD, Math.round(raw)));
}

fn miniAutoCompactEnabled() -> bool { // was: function miniAutoCompactEnabled
  let raw = (process.env.MINI_AUTO_COMPACT ?? "").trim().toLowerCase(); // DEFECT: process.* Node API
  return raw !== "off" && raw !== "false" && raw !== "0" && raw !== "no";
}

function shouldMiniAutoCompact(s: {
  messages?: unknown;
  lastUsedTokens?: number;
  lastContextWindow?: number;
  lastAutoCompactAt?: number;
}): boolean {
  if (!miniAutoCompactEnabled()) return false;
  let messages = Array.isArray(s.messages) ? s.messages : [];
  if (messages.length <= 2) return false;
  let used = typeof s.lastUsedTokens === "number" ? s.lastUsedTokens : 0; // DEFECT: runtime type test (typeof/instanceof/in)
  let window = typeof s.lastContextWindow === "number" ? s.lastContextWindow : 0; // DEFECT: runtime type test (typeof/instanceof/in)
  if (!(used > 0) || !(window > 0)) return false;
  if (used / window < miniAutoCompactThreshold() / 100) return false;
  let last = typeof s.lastAutoCompactAt === "number" ? s.lastAutoCompactAt : 0; // DEFECT: runtime type test (typeof/instanceof/in)
  if (Date.now() - last < MINI_AUTO_COMPACT_COOLDOWN_MS) return false;
  return true;
}

fn mergeMiniUsageDelta(base: MiniUsageDelta , next: MiniUsageDelta ) -> MiniUsageDelta  { // was: function mergeMiniUsageDelta
  if (!next) return base;
  if (!base) return next;
  let merged: MiniUsageDelta = { inputTokens: base.inputTokens + next.inputTokens, outputTokens: base.outputTokens + next.outputTokens };
  for (const key of ["cachedInputTokens", "cacheWriteInputTokens", "reasoningOutputTokens"] as const) { // DEFECT: type assertion (as)
    if (base[key] !== undefined || next[key] !== undefined) merged[key] = (base[key] ?? 0) + (next[key] ?? 0);
  }
  return merged;
}

// Path-like sa_vm fields whose leading `~` expands to the home directory.
// Code fields (`content`, `source`, `query`, `pattern`) are never touched.
let MINI_TILDE_PATH_FIELDS = new Set([ // DEFECT: JS builtin construction (Map/Set/Date/RegExp/AbortController/Error)
  "path", "file", "target", "dir", "directory", "cwd",
  "from", "to", "destination", "dest",
]);

fn isMiniTildePath(v: JsonValue) -> v is string { // was: function isMiniTildePath
  return typeof v === "string" && (v === "~" || v.startsWith("~/") || v.startsWith("~\\")); // DEFECT: runtime type test (typeof/instanceof/in)
}

fn expandMiniTildeArgs(obj: JsonValue) -> JsonValue { // was: function expandMiniTildeArgs
  let out: Record<string, any> = { ...obj };
  for (const [key, value] of Object.entries(out)) {
    if (MINI_TILDE_PATH_FIELDS.has(key) && isMiniTildePath(value)) out[key] = expandLeadingTilde(value);
  }
  // Batched tasks nest one level down (`parallel: [{action, path, ...}]`).
  for (const listKey of ["parallel", "tasks"]) {
    let list = out[listKey];
    if (Array.isArray(list)) {
      out[listKey] = list.map((entry) => // DEFECT: JS Array/String method
        entry && typeof entry === "object" && !Array.isArray(entry) // DEFECT: runtime type test (typeof/instanceof/in)
          ? expandMiniTildeArgs(entry as Record<string, any>) // DEFECT: type assertion (as)
          : entry,
      );
    }
  }
  return out;
}

let MINI_TOOLS = [
  { name: "sa_vm", description: "Ultra workspace tools: {action, ...flat params}, e.g. {action:\"read_file\",path:\"package.json\"}; never nest file paths in args. For independent reads/searches, send multiple sa_vm calls in ONE round (native parallel, read-only calls run concurrently). Batch only independent work: never dependent steps, never writes, never the same path twice in one round. sa_vm parallel is temporarily disabled (use native multi-call; batch writes go sequential or apply_patch). Paths are workspace-relative (~ allowed). Actions include read_file/read_lines/read_many/list_dir/find_files/grep_search/write_file/edit_file/apply_patch, split_plan/split_stage/split_refine/split_repair/split_status, run_bun, run_host {command or exe,args[]} (safe git writes go here, e.g. {exe:\"git\",args:[\"checkout\",\"<branch>\"]} or [\"switch\",\"<branch>\"] or [\"fetch\"]; clean/revert/reset --hard stay blocked), git_status/git_diff/git_log {max_count?,revision?} (read-only: status/diff/log only, never for switching branches), session/checkpoint tools (local_checkpoint {message?} snapshots dirty worktree to a git commit; restore_checkpoint {commit} rolls back), and JEV decision actions (jev_done {user_request,actual_work,evidence} for delivery sign-off, jev_choose, jev_checklist, jev_thinking, jev_redteam, jev_rank, jev_scope, jev_dispatch, jev_consistency, jev_diagnose, jev_edge_cases, jev_blast_radius, jev_intent, jev_next, jev_compress, jev_progress). Delivery sign-off: call jev_done with {user_request,actual_work,evidence} before completing implementation work. Writes: write_file needs {path,content} (create/overwrite whole file); edit_file needs {path,old_text,new_text} with old_text copied EXACTLY from a prior read (long unique context, never type definitions as values; set replaceAll:true only to replace every occurrence); apply_patch needs {patch} with *** Begin Patch envelope (NOT a raw unified diff; single-file edits prefer edit_file). NEVER use {input,output} for edits - they are not edit params. Reads: read_many needs {files:[up to 10]} with one shared slice (different slices use parallel). Splits: split_plan {path,task} -> split_stage/split_refine {session_id,module_name,ops:[{path,content|patch}]} (content XOR patch, 1-20 ops, no delete/rename) -> split_repair phase=diff then validate then commit {confirm:true}. read_skill is optional: load a listed skill only when the task needs its specialized guidance.", schema: { type: "object", properties: { action: { type: "string" }, path: { type: "string" }, query: { type: "string" }, content: { type: "string" }, old_text: { type: "string", description: "Exact existing text to replace for edit_file (must match file verbatim)." }, new_text: { type: "string", description: "Replacement text for edit_file." }, replaceAll: { type: "boolean", description: "Replace every occurrence for edit_file (default false, requires unique context otherwise)." }, patch: { type: "string", description: "Patch text with *** Begin Patch envelope (*** Update File: + @@ hunks); raw unified diffs are rejected." }, diff: { type: "string" }, from: { type: "string" }, to: { type: "string" }, source: { type: "string" }, dest: { type: "string" }, parallel: { type: "array", description: "Independent subtasks [{action,...flat params}]; never nest parallel, never repeat same path, never mix writes with reads of same file." }, files: { type: "array" }, ops: { type: "array" }, phase: { type: "string" }, module_name: { type: "string" }, task: { type: "string" }, confirm: { type: "boolean" }, max_tokens: { type: "number" }, max_tokens_per_file: { type: "number" }, exe: { type: "string" }, command: { type: "string", description: "Command string for run_host, e.g. 'git log --oneline -10'." }, session_id: { type: "string" }, input: { type: "string" }, commit: { type: "string" }, yield_time_ms: { type: "number" }, start_line: { type: "number" }, end_line: { type: "number" }, dir: { type: "string" }, pattern: { type: "string" }, depth: { type: "number" }, max_entries: { type: "number" }, max_count: { type: "number", description: "Max commits to display for git_log (default 10)." }, revision: { type: "string", description: "Git revision or range for git_log / git_diff (e.g. 'HEAD~5' or 'main..HEAD')." }, args: { type: "array", items: { type: "string" } }, user_request: { type: "string", description: "Original user request for jev_done delivery review." }, actual_work: { type: "string", description: "Actual work performed for jev_done." }, evidence: { type: "string", description: "Verification evidence for jev_done." }, question: { type: "string", description: "Question or goal for JEV decision actions." }, options: { type: "object", description: "Options or hypotheses for JEV decision actions." }, checks: { type: "object", description: "Checklist criteria for JEV decision actions." } }, required: ["action"], additionalProperties: true } }, // DEFECT: type assertion (as)
  { name: "read_skill", description: 'Load a listed SKILL.md by name (e.g. {"name":"sa-vm"}) when the task needs that skill\'s specialized guidance. Common sa_vm actions are described on the tool itself.', schema: { type: "object", properties: { name: { type: "string" } }, required: ["name"], additionalProperties: false } },
  MINI_IMAGE_VIEW_TOOL,
  { name: "update_plan", description: 'Track multi-step work, code modifications, and tasks with a structured todo list. Proactively call update_plan at the start of multi-step or exploratory work to establish your checklist, then update statuses (pending, in_progress, completed) as work completes. Each call replaces the whole list. Args: {todos:[{content,status}]} or {steps:[{step,status}]}; status is pending|in_progress|completed.', schema: { type: "object", properties: { todos: { type: "array", items: { type: "object", properties: { content: { type: "string" }, status: { type: "string" }, id: { type: "string" } } } }, steps: { type: "array", items: { type: "object", properties: { step: { type: "string" }, text: { type: "string" }, status: { type: "string" } } } }, explanation: { type: "string" } }, additionalProperties: true } }, // DEFECT: type assertion (as)
  { name: "request_user_input", description: 'Ask the user structured clarification questions mid-turn when a blocking requirement, design preference, or ambiguous goal cannot be resolved autonomously. Execution pauses until the user responds in a dialog modal, and returns their structured choices. Args: {questions:[{id?,question,header?,options?,is_multi_select?}]}. Example: {"questions":[{"id":"choice","question":"Select build target","options":["Debug","Release"]}]}', schema: { type: "object", properties: { questions: { type: "array", items: { type: "object", properties: { id: { type: "string" }, question: { type: "string" }, header: { type: "string" }, options: { type: "array", items: { type: "string" } }, is_multi_select: { type: "boolean" } }, required: ["question"] } } }, required: ["questions"], additionalProperties: true } },
  { name: "web_search", description: 'Search the web for technical documentation, API specifications, release notes, and error resolution. Args: {query, max_results?}. Returns search results with titles, URLs, and text snippets.', schema: { type: "object", properties: { query: { type: "string", description: "Search query or error message" }, max_results: { type: "number", description: "Max results (1-10, default 5)" } }, required: ["query"], additionalProperties: false } },
  { name: "list_mcp_resources", description: 'List files/objects exposed by MCP servers (config.toml [mcp_servers.*]). Args: {server?} - omit for all connected servers. Read one with read_mcp_resource.', schema: { type: "object", properties: { server: { type: "string" } }, additionalProperties: false } },
  { name: "read_mcp_resource", description: 'Read one MCP server resource as text. Args: {server, uri} (both required; discover URIs with list_mcp_resources). Binary content is described, not inlined.', schema: { type: "object", properties: { server: { type: "string" }, uri: { type: "string" } }, required: ["server", "uri"], additionalProperties: false } }, // DEFECT: type assertion (as)
