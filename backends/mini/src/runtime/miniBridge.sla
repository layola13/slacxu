fn mb_str_num_convert(doc: u64, kp: ptr, kn: u64) -> void {
    let node: u64 = mb_g_node(doc, kp, kn);
    if node == 0 || mb_kind(node) != MB_JK_STRING { return; };
    let s = MbStr { bytes: [0u8; 8192], len: 0 };
    let raw = MbStr { bytes: [0u8; 8192], len: 0 };
    let ok: bool = mb_n_str(node, &raw);
    mb_trim_to(mb_sp(&raw), raw.len, &s);
    if mb_is_int_str(mb_sp(&s), s.len) {
        let v: i64 = 0;
        if mb_parse_i64(mb_sp(&s), s.len, &v) { let rc: i32 = mb_s_f64(doc, kp, kn, v as f64); };
    };
}
fn mb_node_number(node: u64, out: &f64) -> bool {
    *out = 0.0;
    if node == 0 { return false; };
    if mb_kind(node) == MB_JK_INT || mb_kind(node) == MB_JK_FLOAT { return mb_n_f64(node, out); };
    if mb_kind(node) == MB_JK_STRING {
        let s = MbStr { bytes: [0u8; 8192], len: 0 };
        let ok: bool = mb_n_str(node, &s);
        let v: i64 = 0;
        if mb_parse_i64(mb_sp(&s), s.len, &v) { *out = v as f64; return true; };
        return mb_parse_f64(mb_sp(&s), s.len, out);
    };
    return false;
}
// /^-n\s*(\d+)$/ or /^-(\d+)$/ -> captured number.
fn mb_git_dash_num(p: ptr, n: u64, out: &u64) -> bool {
    *out = 0;
    if n >= 2 && mb_byte_at(p, 0) == 45 && mb_byte_at(p, 1) == 110 {
        let i: u64 = 2;
        while i < n && (mb_byte_at(p, i) == 32 || mb_byte_at(p, i) == 9) { i = i + 1; }
        if i >= n { return false; };
        let v: u64 = 0;
        let digits: u64 = 0;
        while i < n && mb_byte_at(p, i) >= 48 && mb_byte_at(p, i) <= 57 { v = v * 10 + (mb_byte_at(p, i) - 48) as u64; digits = digits + 1; i = i + 1; }
        if digits == 0 || i != n { return false; };
        *out = v;
        return true;
    };
    if n >= 2 && mb_byte_at(p, 0) == 45 {
        let i: u64 = 1;
        let v: u64 = 0;
        let digits: u64 = 0;
        while i < n && mb_byte_at(p, i) >= 48 && mb_byte_at(p, i) <= 57 { v = v * 10 + (mb_byte_at(p, i) - 48) as u64; digits = digits + 1; i = i + 1; }
        if digits == 0 || i != n { return false; };
        *out = v;
        return true;
    };
    return false;
}
fn mb_last_index_of(p: ptr, n: u64, needle: ptr, nn: u64) -> i64 {
    if nn == 0 || n < nn { return 0 - 1; };
    let i: u64 = n - nn + 1;
    while i > 0 {
        i = i - 1;
        if mb_bytes_eq(mb_ptr_add(p, i), nn, needle, nn) { return i as i64; };
    }
    return 0 - 1;
}
// ---- replay-safe args + push helpers (TS:2795-2850) ----
const MINI_TOOL_ARG_REPLAY_FALLBACK: ptr = "{}";
fn miniReplayableArgs(raw_p: ptr, raw_n: u64, is_str: bool, out: &MbJson) -> void {
    out.len = 0;
    if !is_str { mb_jassign(out, STR_PTR("{}"), STR_LEN("{}")); return; };
    let t = MbStr { bytes: [0u8; 8192], len: 0 };
    mb_trim_to(raw_p, raw_n, &t);
    if t.len == 0 { mb_jassign(out, STR_PTR("{}"), STR_LEN("{}")); return; };
    let parsed: u64 = mb_parse(raw_p, raw_n);
    if parsed != 0 { mb_free_doc(parsed); mb_jassign(out, raw_p, raw_n); return; };
    mb_jassign(out, STR_PTR("{}"), STR_LEN("{}"));
}
fn pushChatToolCall(thread: u64, call_id_p: ptr, call_id_n: u64, name_p: ptr, name_n: u64, args_p: ptr, args_n: u64) -> void {
    let args = MbJson { bytes: [0u8; 262144], len: 0 };
    miniReplayableArgs(args_p, args_n, true, &args);
    let fn_obj: u64 = mb_new_obj();
    let rc: i32 = mb_s_str(fn_obj, STR_PTR("name"), STR_LEN("name"), name_p, name_n);
    rc = mb_s_str(fn_obj, STR_PTR("arguments"), STR_LEN("arguments"), mb_jp(&args), args.len);
    let tc: u64 = mb_new_obj();
    rc = mb_s_str(tc, STR_PTR("id"), STR_LEN("id"), call_id_p, call_id_n);
    rc = mb_s_str(tc, STR_PTR("type"), STR_LEN("type"), STR_PTR("function"), STR_LEN("function"));
    rc = mb_s_node(tc, STR_PTR("function"), STR_LEN("function"), fn_obj);
    let calls: u64 = mb_new_arr();
    rc = mb_a_push_node(calls, tc);
    let msg: u64 = mb_new_obj();
    rc = mb_s_str(msg, STR_PTR("role"), STR_LEN("role"), STR_PTR("assistant"), STR_LEN("assistant"));
    rc = mb_s_null(msg, STR_PTR("content"), STR_LEN("content"));
    rc = mb_s_node(msg, STR_PTR("tool_calls"), STR_LEN("tool_calls"), calls);
    rc = mb_a_push_node(thread, msg);
}
fn pushResponsesToolCall(thread: u64, call_id_p: ptr, call_id_n: u64, name_p: ptr, name_n: u64, args_p: ptr, args_n: u64) -> void {
    let args = MbJson { bytes: [0u8; 262144], len: 0 };
    miniReplayableArgs(args_p, args_n, true, &args);
    let msg: u64 = mb_new_obj();
    let rc: i32 = mb_s_str(msg, STR_PTR("type"), STR_LEN("type"), STR_PTR("function_call"), STR_LEN("function_call"));
    rc = mb_s_str(msg, STR_PTR("call_id"), STR_LEN("call_id"), call_id_p, call_id_n);
    rc = mb_s_str(msg, STR_PTR("name"), STR_LEN("name"), name_p, name_n);
    rc = mb_s_str(msg, STR_PTR("arguments"), STR_LEN("arguments"), mb_jp(&args), args.len);
    rc = mb_a_push_node(thread, msg);
}
