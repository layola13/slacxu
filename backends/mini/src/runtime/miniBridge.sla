//
 //* Short-lived `command/exec` process owned by MiniBridge (Codex parity for
 //* the Transcript terminal). Separate from resident `terminal/*` PTYs (handled
 //* in index.ts) and from model-facing `sa_vm run_host` sessions: argv vector,
 //* timeout-bound, buffered or streamed via `command/exec/outputDelta`.
 //
struct MiniExecSession { // was: type alias object
  id: string;
  child: ChildProcess;
  streamed: boolean;
  stdout: string;
  stderr: string;
  stdoutEmitted: number;
  stderrEmitted: number;
  stdoutCapped: boolean;
  stderrCapped: boolean;
  cap: number;
  done: boolean;
  exitCode: number | null;
  timedOut: boolean;
  timer?: ReturnType<typeof setTimeout>; // DEFECT: runtime type test (typeof/instanceof/in)
};

let MINI_EXEC_DEFAULT_TIMEOUT_MS = 120000;
let MINI_EXEC_MAX_TIMEOUT_MS = 600000;
let MINI_EXEC_DEFAULT_CAP_BYTES = 1024 * 1024;
let MINI_EXEC_MAX_CAP_BYTES = 16 * 1024 * 1024;
let MINI_EXEC_MAX_ARGV = 64;
// How long an approval card waits before counting as declined (cap 10 min). */
let MINI_APPROVAL_TIMEOUT_MS = 120000;

//
 //* 父进程退出/超时/terminate 时杀掉 mini command/exec 整棵树。
 //* Windows 上只 kill 直接子进程会留下孙进程（cmd 包装器拉起的真实命令），
 //* 用 taskkill /T /F（与 agy/grok/opencode manager 一致）；POSIX 直接 SIGKILL。
 //
fn killMiniExecTree(child: ChildProcess, signal: NodeJS.Signals = "SIGKILL") -> void { // was: function killMiniExecTree
  try { // DEFECT: exception (try/catch/throw)
    let pid = child.pid;
    if (pid && process.platform === "win32") { // DEFECT: process.* Node API
      let killer = spawn("taskkill", ["/pid", String(pid), "/T", "/F"], { windowsHide: true });
      killer.on("error", () => { // DEFECT: arrow function / closure
        try { child.kill(signal); } catch {} // DEFECT: exception (try/catch/throw)
      });
    } else {
      child.kill(signal);
    }
  } catch { /* best-effort */ } // DEFECT: exception (try/catch/throw)
}

// 同步版：仅用于进程 `exit` 钩子（async 已来不及）。 */
fn killMiniExecTreeSync(child: ChildProcess) -> void { // was: function killMiniExecTreeSync
  try { // DEFECT: exception (try/catch/throw)
    let pid = child.pid;
    if (!pid) return;
    if (process.platform === "win32") { // DEFECT: process.* Node API
      spawnSync("taskkill", ["/pid", String(pid), "/T", "/F"], { windowsHide: true, stdio: "ignore" });
    } else {
      try { child.kill("SIGKILL"); } catch {} // DEFECT: exception (try/catch/throw)
    }
  } catch { /* best-effort */ } // DEFECT: exception (try/catch/throw)
}

// 存活中的 mini command/exec 子进程：父进程退出时同步整树杀掉，防止孤儿常驻后台。 */
let liveMiniExecProcs = new Set<ChildProcess>(); // DEFECT: JS builtin construction (Map/Set/Date/RegExp/AbortController/Error)
let miniExecShutdownHooksInstalled = false;

fn ensureMiniExecShutdownHooks() -> void { // was: function ensureMiniExecShutdownHooks
  if (miniExecShutdownHooksInstalled) return;
  miniExecShutdownHooksInstalled = true;
  let killAllSync = () => { // DEFECT: arrow function / closure
    for (const proc of Array.from(liveMiniExecProcs)) {
      killMiniExecTreeSync(proc);
    }
    liveMiniExecProcs.clear();
  };
  try { // DEFECT: exception (try/catch/throw)
    process.on("exit", () => { // DEFECT: arrow function / closure
      try { killAllSync(); } catch { /* ignore */ } // DEFECT: exception (try/catch/throw)
    });
  } catch { /* ignore */ } // DEFECT: exception (try/catch/throw)
  try { process.once("SIGINT", () => { try { killAllSync(); } catch {} }); } catch { /* ignore */ } // DEFECT: exception (try/catch/throw)
  try { process.once("SIGTERM", () => { try { killAllSync(); } catch {} }); } catch { /* ignore */ } // DEFECT: exception (try/catch/throw)
}

fn isMiniTurnCancelled(session: MiniSession, turnId: TextBuf) -> bool { // was: function isMiniTurnCancelled
  return session.cancelledTurnIds?.has(turnId) ?? false; // DEFECT: optional chaining ?.
}

fn isMiniTurnSteering(session: MiniSession, turnId: TextBuf) -> bool { // was: function isMiniTurnSteering
  return session.steerTurnId === turnId;
}

// Normalize an upstream abort caused by an active same-turn steer. */
fn miniSteerFromAbort(session: MiniSession, turnId: TextBuf, error: JsonValue) -> Error  { // was: function miniSteerFromAbort
  if (!isMiniTurnSteering(session, turnId)) return null;
  let name = error != null && typeof error === "object" ? String((error as Record<string, unknown>).name ?? "") : ""; // DEFECT: runtime type test (typeof/instanceof/in)
  let message = error instanceof Error ? `${error.name}: ${error.message}` : String(error ?? ""); // DEFECT: runtime type test (typeof/instanceof/in)
  if (/abort|cancel|operation was aborted|terminated/i.test(`${name} ${message}`)) return new Error("steered"); // DEFECT: JS builtin construction (Map/Set/Date/RegExp/AbortController/Error)
  return null;
}

fn isMiniTurnEventStale(session: MiniSession, turnId: TextBuf) -> bool { // was: function isMiniTurnEventStale
  let turn = (session.turns ?? []).find((entry) => entry.id === turnId); // DEFECT: JS Array/String method
  return isMiniTurnCancelled(session, turnId)
    || isMiniTurnSteering(session, turnId)
    || (session.activeTurnId !== undefined && session.activeTurnId !== turnId)
    || Boolean(turn && turn.status !== "inProgress" && turn.status !== "in_progress");
}

let MINI_GOAL_CONTINUATION_MARKER = GOAL_CONTINUATION_MARKER;

//
 //* Internal item type for host-driven /goal continuations. These are NOT user
 //* turns: the live prompt is passed to runMiniTurn directly, and history keeps
 //* only the newest one (older prompts are superseded by its authoritative
 //* progress block). The web waterfall filters them from display by marker
 //* text, same as the legacy userMessage continuations they replace.
 //
let MINI_GOAL_CONTINUATION_ITEM_TYPE = "goalContinuation";

//
 //* One-way migration for persisted threads: legacy continuations were stored
 //* as userMessage items carrying the marker. Retype (same id, same payload)
 //* so every continuation replays as an internal fragment.
 //
fn migrateMiniLegacyContinuations(messages: JsonArray) -> JsonArray { // was: function migrateMiniLegacyContinuations
  if (!Array.isArray(messages)) return messages;
  let changed = false;
  let out = messages.map((m) => { // DEFECT: JS Array/String method
    if (!m || typeof m !== "object") return m; // DEFECT: runtime type test (typeof/instanceof/in)
    let rec = m as Record<string, unknown>; // DEFECT: type assertion (as)
    if (String(rec.type ?? "") === "userMessage"
      && typeof rec.text === "string" // DEFECT: runtime type test (typeof/instanceof/in)
      && rec.text.includes(MINI_GOAL_CONTINUATION_MARKER)) { // DEFECT: JS Array/String method
      changed = true;
      return { ...rec, type: MINI_GOAL_CONTINUATION_ITEM_TYPE } as JsonValue; // DEFECT: type assertion (as)
    }
    return m;
  });
  return changed ? out : messages;
}

fn isMiniGoalContinuationMessage(m: JsonValue) -> bool { // was: function isMiniGoalContinuationMessage
  if (!m || typeof m !== "object") return false; // DEFECT: runtime type test (typeof/instanceof/in)
  let rec = m as Record<string, unknown>; // DEFECT: type assertion (as)
  if (String(rec.type ?? "") === MINI_GOAL_CONTINUATION_ITEM_TYPE) return true;
  return String(rec.type ?? "") === "userMessage"
    && typeof rec.text === "string" // DEFECT: runtime type test (typeof/instanceof/in)
    && rec.text.includes(MINI_GOAL_CONTINUATION_MARKER); // DEFECT: JS Array/String method
}

//
 //* Pure anomaly protection for host-driven /goal continuations. Normal
 //* termination flows through GOAL_COMPLETE, budget exhaustion
 //* (budgetLimited), or cross-turn stagnation (blocked after
 //* MINI_GOAL_STAGNANT_LIMIT no-change turns) — reaching this cap means all
 //* three guards failed, so the goal is parked as blocked for human review.
 //
let MAX_MINI_GOAL_AUTO_CONTINUATIONS = 50;

let MINI_PLAN_DIRECTIVE = "Plan mode is ACTIVE: develop the plan autonomously and inspect available context before asking questions. Resolve non-blocking uncertainty with explicit reasonable assumptions. If user input is genuinely required because the answer would materially change the plan, group all blocking questions together. While in Plan mode, use read-only tools only and produce a complete actionable plan via update_plan, then stop.";

