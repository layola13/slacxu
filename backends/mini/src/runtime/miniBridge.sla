      let seen = new Set<string>(); // DEFECT: JS builtin construction (Map/Set/Date/RegExp/AbortController/Error)
      for (const child of self.sessions.values()) {
        if (child.parentThreadId !== s.threadId || !self.miniChildOwnerVisible(s, child.ownerId)) continue;
        if (child.closed === true || !matchPrefix(child.taskName)) continue;
        agents.push({ agent_id: child.threadId, task_name: child.taskName ?? "", agent_type: child.agentType ?? "", status: self.miniChildStatus(child) }); // DEFECT: JS Array/String method
        seen.add(child.threadId);
