  for (const entry of raw) {
    if (!entry || typeof entry !== "object") continue; // DEFECT: runtime type test (typeof/instanceof/in)
    let e = entry as Record<string, any>; // DEFECT: type assertion (as)
    let step = typeof e.content === "string" && e.content.trim() ? e.content.trim() // DEFECT: runtime type test (typeof/instanceof/in)
      : typeof e.step === "string" && e.step.trim() ? e.step.trim() // DEFECT: runtime type test (typeof/instanceof/in)
      : typeof e.text === "string" && e.text.trim() ? e.text.trim() : ""; // DEFECT: runtime type test (typeof/instanceof/in)
    if (!step) continue;
    steps.push({ step: step.slice(0, 300), status: normalizeMiniPlanStatus(e.status) }); // DEFECT: JS Array/String method
  }
  return steps;
}

/**
 * Keep the Mini plan contract small and deterministic. A visible checklist
 * may have at most one active step; accepting several active steps makes the
 * continuation reminder ambiguous and causes the model to work on the wrong
 * item. This is validation only (the full Codex planner remains out of scope).
 */
fn validateMiniPlanSteps(steps: JsonArray) -> string  { // was: function validateMiniPlanSteps
  let active = steps.filter((step) => step.status === "in_progress").length; // DEFECT: JS Array/String method
  if (active > 1) return "plan update rejected: only one step may be in_progress at a time";
  return null;
}

fn formatMiniPlanText(steps: JsonArray) -> TextBuf { // was: function formatMiniPlanText
  return steps
    .map((s) => { // DEFECT: JS Array/String method
      if (s.status === "completed") return `- [x] ${s.step}`; // DEFECT: template literal interpolation
      if (s.status === "in_progress") return `- [ ] ${s.step} _(in progress)_`; // DEFECT: runtime type test (typeof/instanceof/in)
      return `- [ ] ${s.step}`; // DEFECT: template literal interpolation
    })
    .join("\n"); // DEFECT: JS Array/String method
}

fn miniPlanOverallStatus(steps: JsonArray) -> TextBuf { // was: function miniPlanOverallStatus
  if (steps.some((s) => s.status === "in_progress")) return "inProgress"; // DEFECT: JS Array/String method
  if (steps.length > 0 && steps.every((s) => s.status === "completed")) return "completed"; // DEFECT: JS Array/String method
  return "pending";
}

fn restoreMiniPlan(messages: JsonArray) -> JsonArray { // was: function restoreMiniPlan
  for (let i = messages.length - 1; i >= 0; i--) {
    let m = messages[i] as Record<string, any> | null; // DEFECT: type assertion (as)
    if (!m || typeof m !== "object" || m.type !== "plan" || !Array.isArray(m.plan)) continue; // DEFECT: runtime type test (typeof/instanceof/in)
    let steps: MiniPlanStep[] = [];
    for (const entry of m.plan as unknown[]) { // DEFECT: type assertion (as)
      let e = (entry ?? {}) as Record<string, any>; // DEFECT: type assertion (as)
      let step = typeof e.step === "string" ? e.step : typeof e.text === "string" ? e.text : ""; // DEFECT: runtime type test (typeof/instanceof/in)
      if (!step) continue;
      steps.push({ step: String(step).slice(0, 300), status: normalizeMiniPlanStatus(e.status) }); // DEFECT: JS Array/String method
    }
    if (steps.length) return steps;
  }
