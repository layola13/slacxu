      method: "command/exec/outputDelta",
      params: { processId, deltaBase64: slice.toString("base64"), stream, capReached },
    });
  }

  fn bufferMiniExec(self: &MiniBridge, exec: MiniExecSession, stream: TextBuf, bytes: TextBuf) -> void { // method of MiniBridge
    let text = Buffer.isBuffer(bytes) ? bytes.toString("utf8") : bytes;
    if (!text) return;
