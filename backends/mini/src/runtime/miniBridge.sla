fn buildMiniSubagentPrompt(taskName: TextBuf, message: TextBuf, agentType: TextBuf) -> TextBuf { // was: function buildMiniSubagentPrompt
  let role = agentType?.trim() ? `Role: ${agentType.trim().slice(0, 120)}.` : ""; // DEFECT: optional chaining ?.
  return [
