  }

  fn hasPendingApproval(self: &MiniBridge, id: TextBuf) -> bool { // method of MiniBridge
    return self.pendingApprovals.has(String(id));
  }

  fn abortPendingUserInput(self: &MiniBridge, threadId: TextBuf) -> void { // method of MiniBridge
    for (const [id, pending] of self.pendingUserInputs.entries()) {
      if (pending.threadId === threadId) {
        clearTimeout(pending.timer); // DEFECT: timer
        self.pendingUserInputs.delete(id);
        pending.resolve("(turn interrupted)");
      }
    }
    for (const [id, approval] of self.pendingApprovals.entries()) {
      if (approval.threadId === threadId) {
        clearTimeout(approval.timer); // DEFECT: timer
        self.pendingApprovals.delete(id);
        approval.resolve("cancel");
      }
    }
  }

  fn hasSession(self: &MiniBridge, threadId: TextBuf, ownerId: TextBuf) -> bool { // method of MiniBridge
    let session = self.sessions.get(threadId);
    if (!session) return false;
    return !ownerId || !session.ownerId || session.ownerId === "local" || session.ownerId === ownerId;
  }

  fn getOrRestoreSession(self: &MiniBridge, threadId: TextBuf, ownerId: TextBuf) -> MiniSession  { // method of MiniBridge
    let s = self.sessions.get(threadId);
    // A bridge is shared by all authenticated clients. Never let a request
    // from another owner reuse an already-materialized session. Legacy
    // `local` history remains readable by authenticated owners, but explicitly
    // owned history must stay private.
    if (s && ownerId && s.ownerId && s.ownerId !== "local" && s.ownerId !== ownerId) return undefined;
    if (!s && self.options?.loadSnapshot) { // DEFECT: optional chaining ?.
      let snap = self.options.loadSnapshot(threadId, ownerId);
      if (snap) {
        if (ownerId && snap.ownerId && snap.ownerId !== "local" && snap.ownerId !== ownerId) return undefined;
        s = {
          threadId: snap.threadId, ownerId: snap.ownerId ?? ownerId, cwd: snap.cwd,
          model: snap.model ?? "gpt-5-mini", additionalRoots: snap.additionalRoots, turns: snap.turns ?? [], messages: snap.messages ?? [],
          providerId: snap.providerId, groupId: snap.groupId, preview: snap.preview,
          name: typeof snap.name === "string" && snap.name ? snap.name : undefined, // DEFECT: runtime type test (typeof/instanceof/in)
          effort: normalizeMiniEffort(snap.effort) ?? MINI_DEFAULT_EFFORT,
          createdAt: typeof snap.createdAt === "number" ? snap.createdAt : undefined, // DEFECT: runtime type test (typeof/instanceof/in)
          lastUsedTokens: typeof snap.lastUsedTokens === "number" ? snap.lastUsedTokens : undefined, // DEFECT: runtime type test (typeof/instanceof/in)
          lastContextWindow: typeof snap.lastContextWindow === "number" ? snap.lastContextWindow : undefined, // DEFECT: runtime type test (typeof/instanceof/in)
          lastAutoCompactAt: typeof snap.lastAutoCompactAt === "number" ? snap.lastAutoCompactAt : undefined, // DEFECT: runtime type test (typeof/instanceof/in)
          agentsMdActive: restoreAgentsMdActive(snap.agentsMdActive),
          imageInputUnsupported: snap.imageInputUnsupported === true ? true : undefined,
          archived: snap.archived === true ? true : undefined,
          closed: snap.closed === true ? true : undefined,
          sandbox: typeof snap.sandbox === "string" && snap.sandbox ? snap.sandbox : undefined, // DEFECT: runtime type test (typeof/instanceof/in)
          approvalPolicy: typeof snap.approvalPolicy === "string" && snap.approvalPolicy ? snap.approvalPolicy : undefined, // DEFECT: runtime type test (typeof/instanceof/in)
          goalObjective: typeof snap.goalObjective === "string" && snap.goalObjective ? snap.goalObjective : undefined, // DEFECT: runtime type test (typeof/instanceof/in)
          goalStatus: typeof snap.goalStatus === "string" && snap.goalStatus ? snap.goalStatus : undefined, // DEFECT: runtime type test (typeof/instanceof/in)
          goalTokenBudget: typeof snap.goalTokenBudget === "number" && Number.isFinite(snap.goalTokenBudget) && snap.goalTokenBudget > 0 ? Math.floor(snap.goalTokenBudget) : (snap.goalTokenBudget === null ? null : undefined), // DEFECT: runtime type test (typeof/instanceof/in)
          goalTokensUsed: typeof snap.goalTokensUsed === "number" && Number.isFinite(snap.goalTokensUsed) && snap.goalTokensUsed >= 0 ? Math.floor(snap.goalTokensUsed) : undefined, // DEFECT: runtime type test (typeof/instanceof/in)
          goalStartedAt: typeof snap.goalStartedAt === "number" && Number.isFinite(snap.goalStartedAt) ? snap.goalStartedAt : undefined, // DEFECT: runtime type test (typeof/instanceof/in)
          goalLastFingerprint: typeof snap.goalLastFingerprint === "string" ? snap.goalLastFingerprint.slice(0, 4000) : undefined, // DEFECT: runtime type test (typeof/instanceof/in)
          goalStagnantTurns: typeof snap.goalStagnantTurns === "number" && Number.isFinite(snap.goalStagnantTurns) ? Math.max(0, Math.floor(snap.goalStagnantTurns)) : undefined, // DEFECT: runtime type test (typeof/instanceof/in)
          goalRecentToolFingerprints: Array.isArray(snap.goalRecentToolFingerprints)
            ? snap.goalRecentToolFingerprints.filter((f): f is string => typeof f === "string" && f.length > 0).slice(-MINI_GOAL_FINGERPRINT_WINDOW).map((f) => f.slice(0, 64)) // DEFECT: runtime type test (typeof/instanceof/in)
            : undefined,
          approvalBypass: snap.approvalBypass === true ? true : undefined,
          pureChat: snap.pureChat === true ? true : undefined,
          webSearch: snap.webSearch === true ? true : undefined,
          parentThreadId: snap.parentThreadId, depth: snap.depth, taskName: snap.taskName,
          agentType: snap.agentType,
          // A restored child is never "running": its loop died with the
          // previous process, so report the persisted terminal state.
          subStatus: snap.parentThreadId ? (snap.subStatus === "running" || !snap.subStatus ? "interrupted" : snap.subStatus) : snap.subStatus,
          finalReport: snap.finalReport,
        };
        // One-way migration: legacy continuations were stored as userMessage
        // items carrying the marker. Retype them so history treats every
        // continuation as an internal fragment (newest-only replay).
        if (Array.isArray(s.messages)) s.messages = migrateMiniLegacyContinuations(s.messages as JsonValue[]); // DEFECT: type assertion (as)
        // A restored session never has a live turn: any persisted `inProgress`
        // turn is an orphan (502-retry abort, reload, or restart killed the
        // loop without settling it). Settle it now so the thread is usable.
        self.sessions.set(threadId, s);
        self.healOrphanMiniInProgressTurns(s);
      }
    }
    return s;
  }

  private resolveTarget(s: MiniSession): Promise<{ baseUrl: string; apiKey: string; protocol: "responses" | "chat" | "anthropic"; maxRetries: number; groupContextWindow: number | null; modelCapability: ModelCapabilityDescriptor | null }> { // DEFECT: Promise
    let target = s.providerId && self.options?.resolveRelayTarget // DEFECT: optional chaining ?.
      ? self.options.resolveRelayTarget(s.providerId, s.groupId, s.model).catch(() => undefined) // DEFECT: exception (try/catch/throw)
      : undefined;
    let env: Record<string, string> | undefined;
    if (!target && s.providerId && self.options?.resolveRelayEnv) env = self.options.resolveRelayEnv(s.providerId, s.groupId, s.model).catch(() => undefined); // DEFECT: optional chaining ?.
    let baseUrl = target?.baseUrl ?? env?.OPENAI_BASE_URL ?? env?.RELAY_BASE_URL ?? process.env.MINI_BASE_URL ?? "https://api.openai.com/v1"; // DEFECT: optional chaining ?.
    let apiKey = target?.apiKey ?? env?.OPENAI_API_KEY ?? env?.RELAY_API_KEY ?? process.env.MINI_API_KEY ?? process.env.OPENAI_API_KEY ?? ""; // DEFECT: optional chaining ?.
    if (!apiKey) throw new Error(`mini relay has no usable route (provider=${s.providerId ?? "?"} group=${s.groupId ?? "?"}): pick an enabled text relay/group or set MINI_API_KEY`); // DEFECT: exception (try/catch/throw)
    // Inherit the per-relay stream-retry budget: the same `streamMaxRetries`
    // value the user configures for this relay (Codex `stream_max_retries`).
    // Context window likewise follows the relay-group setting (user-editable),
    // resolved per model with the same helper the engine catalog uses.
    return {
      baseUrl, apiKey, protocol: target?.protocol ?? (process.env.MINI_PROTOCOL === "anthropic" ? "anthropic" : process.env.MINI_PROTOCOL === "chat" ? "chat" : "responses"), // DEFECT: optional chaining ?.
      maxRetries: clampMiniStreamMaxRetries(target?.streamMaxRetries), // DEFECT: optional chaining ?.
      groupContextWindow: typeof target?.contextWindow === "number" && target.contextWindow > 0 ? Math.round(target.contextWindow) : null, // DEFECT: runtime type test (typeof/instanceof/in)
      modelCapability: target?.modelCapability ?? null, // DEFECT: optional chaining ?.
    };
  }

  fn resolveSessionContextWindow(self: &MiniBridge, s: MiniSession, target: JsonValue) -> f64 { // method of MiniBridge
    return resolveMiniContextWindow(s.model, target.modelCapability, target.groupContextWindow);
  }

  /**
   * Summarize the older history slice with the turn's own relay/model.
   * Cached per thread while the older part barely grows; any failure
   * returns "" so the caller falls back to raw head+tail truncation.
   */
    //
   //* Rolling summary of `older`: returns the summary plus the older lines it
   //* does NOT cover (carry, sent raw), or null when no summary exists and the
   //* model call failed (caller falls back to raw head/tail truncation).
   //
  private summarizeMiniOlderHistory( // DEFECT: async function
    s: MiniSession,
    turnId: string,
    older: string[],
    budgets: { carryChars: number; summaryChars: number },
    target: { baseUrl: string; apiKey: string; protocol: "responses" | "chat" | "anthropic"; maxRetries: number; modelCapability?: ModelCapabilityDescriptor | null },
  ): Promise<{ summary: string; carry: string[] } | null> { // DEFECT: Promise
    let plan = planMiniHistorySummary(older, self.miniHistorySummaryCache.get(s.threadId), budgets.carryChars);
    if (plan.kind === "reuse") return { summary: plan.summary, carry: plan.carry };
    let outputChars = Math.max(1000, Math.min(MINI_HISTORY_SUMMARY_MAX_OUTPUT_CHARS, budgets.summaryChars));
    let summary = plan.base;
    for (const chunk of chunkMiniSummaryInput(plan.pending)) {
      let next = self.requestMiniHistorySummary(s, turnId, summary, chunk, outputChars, target); // DEFECT: async/await
      if (!next) {
        // Keep what is already summarized; the unfolded backlog rides raw
        // (the payload's head/tail cap bounds it) instead of vanishing.
        return summary ? { summary, carry: plan.pending } : null;
      }
      summary = next;
    }
    self.miniHistorySummaryCache.set(s.threadId, { anchor: miniHistoryAnchor(older), summary });
    return { summary, carry: [] };
  }

  private requestMiniHistorySummary( // DEFECT: async function
    s: MiniSession,
    turnId: string,
    previous: string,
    chunk: string,
    outputChars: number,
    target: { baseUrl: string; apiKey: string; protocol: "responses" | "chat" | "anthropic"; maxRetries: number; modelCapability?: ModelCapabilityDescriptor | null },
  ): Promise<string> { // DEFECT: Promise
    let ask = [
      buildMiniHistorySummaryAsk(previous, outputChars),
    ].filter(Boolean).join("\n"); // DEFECT: JS Array/String method
    let inputText = previous ? `[previous summary]\n${previous}\n\n[new history]\n${chunk}` : chunk; // DEFECT: template literal interpolation
    let effort = s.effort ?? MINI_DEFAULT_EFFORT;
    // Mini-only explicit messages/ support: reuse the same normalizer as the
    // live turn loop so a base already ending in /messages is not doubled.
    let url = target.protocol === "anthropic"
      ? miniAnthropicMessagesUrl(target.baseUrl)
      : `${target.baseUrl.replace(/\/$/, "")}/${target.protocol === "chat" ? "chat/completions" : "responses"}`; // DEFECT: JS Array/String method
    let body = target.protocol === "chat"
      ? { model: s.model, reasoning_effort: effort, messages: [{ role: "system", content: ask }, { role: "user", content: inputText }] }
      : target.protocol === "anthropic"
        ? { model: s.model, system: ask, messages: [{ role: "user", content: inputText }], max_tokens: Math.min(8192, Math.max(1024, Math.ceil(outputChars / 2))) }
        : { model: s.model, reasoning: { effort }, ...miniResponsesVerbosityField(s.model, target.modelCapability), instructions: ask, input: [{ role: "user", content: [{ type: "input_text", text: inputText }] }] };
    try { // DEFECT: exception (try/catch/throw)
      // Summary is auxiliary: cap its own retry budget so a flaky relay
      // cannot burn the turn's budget before the real turn starts.
      let summaryHeaders: Record<string, string> = {
        Authorization: `Bearer ${target.apiKey}`, // DEFECT: template literal interpolation
        "Content-Type": "application/json",
      };
      if (target.protocol === "anthropic") {
        if (target.apiKey) summaryHeaders["x-api-key"] = target.apiKey;
        summaryHeaders["anthropic-version"] = "2023-06-01";
      }
      let res = self.fetchMiniUpstream(s, turnId, url, { // DEFECT: async/await
        method: "POST",
        headers: summaryHeaders,
        signal: miniSummaryRequestSignal(),
        body: JSON.stringify(body), // DEFECT: dynamic JSON (JSON.parse/stringify)
      }, Math.min(target.maxRetries, 2));
      if (!res.ok) throw new Error(`summary ${res.status}`); // DEFECT: exception (try/catch/throw)
      let summary = "";
      if (target.protocol === "chat") {
        let data = (res.json()) as { choices?: Array<{ message?: { content?: string | null } }> }; // DEFECT: async/await
        summary = String(data.choices?.[0]?.message?.content ?? "").trim(); // DEFECT: optional chaining ?.
      } else if (target.protocol === "anthropic") {
        let data = (res.json()) as { content?: Array<{ type?: string; text?: string }> }; // DEFECT: async/await
        summary = (data.content ?? []).filter((c) => c.type === "text").map((c) => c.text ?? "").join("").trim(); // DEFECT: JS Array/String method
      } else {
        let data = (res.json()) as { output?: Array<{ type?: string; content?: Array<{ text?: string }> }> }; // DEFECT: async/await
        summary = (data.output ?? []).filter((o) => o.type === "message").flatMap((o) => o.content ?? []).map((c) => c.text ?? "").join("").trim(); // DEFECT: JS Array/String method
      }
      return summary.slice(0, outputChars); // DEFECT: JS Array/String method
    } catch (e) { // DEFECT: exception (try/catch/throw)
      console.warn(`[mini] history summary failed for turn ${turnId}, falling back to truncation: ${e instanceof Error ? e.message : String(e)}`); // DEFECT: runtime type test (typeof/instanceof/in)
      return "";
    }
  }

  fn emitMiniUsage(self: &MiniBridge, s: MiniSession, turnId: TextBuf, totals: MiniUsageTotals, round: MiniUsageDelta, contextWindow: f64) -> void { // method of MiniBridge
    if (isMiniTurnEventStale(s, turnId)) return;
    s.lastUsedTokens = round.inputTokens + round.outputTokens;
    s.lastContextWindow = contextWindow;
    // P1 metering: accumulate per-goal usage while a goal is active so the
    // budget gate and continuation prompt report real numbers instead of 0.
    if (s.goalStatus === "active" && s.goalObjective?.trim()) { // DEFECT: optional chaining ?.
      s.goalTokensUsed = (typeof s.goalTokensUsed === "number" ? s.goalTokensUsed : 0) + round.inputTokens + round.outputTokens; // DEFECT: runtime type test (typeof/instanceof/in)
      if (isMiniGoalBudgetExhausted(s)) {
        s.goalStatus = "budgetLimited";
        self.clearGoalContinuationTimer(s.threadId);
        self.goalContinuationCounts.delete(s.threadId);
        self.persist(s);
        self.emit("notification", { method: "thread/goal/updated", params: { goal: miniGoalState(s) } });
      } else {
        self.persist(s);
      }
    }
    self.emit("notification", {
      method: "thread/tokenUsage/updated",
      params: { threadId: s.threadId, turnId, tokenUsage: buildMiniTokenUsage(totals, round, contextWindow) },
    });
  }

    // Round/fetch-level retry notices not yet settled (turn key -> count). */
  private miniPendingRetryNotice = new Map<string, number>(); // DEFECT: JS builtin construction (Map/Set/Date/RegExp/AbortController/Error)

  fn miniRetryNoticeKey(self: &MiniBridge, s: MiniSession, turnId: TextBuf) -> TextBuf { // method of MiniBridge
    return `${s.threadId}:${turnId}`; // DEFECT: template literal interpolation
  }

  fn emitMiniRetryNotice(self: &MiniBridge, s: MiniSession, turnId: TextBuf, attempt: f64, maxRetries: f64, detail: TextBuf) -> void { // method of MiniBridge
    if (isMiniTurnEventStale(s, turnId)) return;
    let key = self.miniRetryNoticeKey(s, turnId);
    self.miniPendingRetryNotice.set(key, (self.miniPendingRetryNotice.get(key) ?? 0) + 1);
    // Live-only notice (never persisted to s.messages, so it cannot pollute
    // model history). The waterfall groups consecutive retryError rows into
    // a retry group card, same as Codex stream retries.
    let item = {
      type: "retryError", id: `mini-retry-${turnId}`, turnId, threadId: s.threadId, // DEFECT: template literal interpolation
      title: `Retrying request (${attempt}/${maxRetries})`, text: detail, status: "running", // DEFECT: template literal interpolation
      payload: { retryError: true, retrySource: "mini", attempt, max: maxRetries, willRetry: true },
    };
    self.emit("notification", { method: "item/completed", params: { threadId: s.threadId, turnId, item } });
  }

    //
   //* Settle a still-running retry card after the turn recovered: without this
   //* the waterfall keeps a `running` retryError item and the frontend drops
   //* the untimestamped `turn/completed` as ambiguous, so a retried turn never
   //* settles visually even though the answer is complete.
   //
  fn emitMiniRetryRecoveredIfNeeded(self: &MiniBridge, s: MiniSession, turnId: TextBuf) -> void { // method of MiniBridge
    let key = self.miniRetryNoticeKey(s, turnId);
    let attempts = self.miniPendingRetryNotice.get(key) ?? 0;
    if (!attempts) return;
    self.miniPendingRetryNotice.delete(key);
    self.emitMiniRetryRecovered(s, turnId, attempts, s.activeMaxRetries ?? MINI_STREAM_RETRY_DEFAULT);
  }

    // Settle a still-running retry card when the turn fails or is interrupted. */
  fn failMiniRetryNotice(self: &MiniBridge, s: MiniSession, turnId: TextBuf) -> void { // method of MiniBridge
    let key = self.miniRetryNoticeKey(s, turnId);
    if (!self.miniPendingRetryNotice.has(key)) return;
    self.miniPendingRetryNotice.delete(key);
    if (isMiniTurnEventStale(s, turnId)) return;
    let item = {
      type: "retryError", id: `mini-retry-${turnId}`, turnId, threadId: s.threadId, // DEFECT: template literal interpolation
      title: "Retrying request", text: "Gave up retrying; see the error below.", status: "failed",
      payload: { retryError: true, retrySource: "mini", willRetry: false, exhausted: true },
    };
    self.emit("notification", { method: "item/completed", params: { threadId: s.threadId, turnId, item } });
  }

  fn emitMiniRetryRecovered(self: &MiniBridge, s: MiniSession, turnId: TextBuf, attempts: f64, maxRetries: f64) -> void { // method of MiniBridge
    if (isMiniTurnEventStale(s, turnId)) return;
    let item = {
      type: "retryError", id: `mini-retry-${turnId}`, turnId, threadId: s.threadId, // DEFECT: template literal interpolation
      title: "Retry recovered", text: `Upstream recovered after ${attempts} retr${attempts === 1 ? "y" : "ies"} (budget ${attempts}/${maxRetries}).`, status: "completed", // DEFECT: template literal interpolation
      payload: { retryError: true, retrySource: "mini", recovered: true, attempt: attempts, max: maxRetries },
    };
    self.emit("notification", { method: "item/completed", params: { threadId: s.threadId, turnId, item } });
  }

    //
   //* One-shot live notice for a dropped attachment. Live-only (never pushed to
   //* `s.messages`, so it stays out of the replayed transcript) and `completed`,
   //* so neither the waterfall nor the failed-turn recovery planner reads the
   //* still-running turn as dead.
   //
  fn emitMiniImageDroppedNotice(self: &MiniBridge, s: MiniSession, turnId: TextBuf, dropped: f64) -> void { // method of MiniBridge
    if (isMiniTurnEventStale(s, turnId)) return;
    let item = {
      type: "retryError", id: `mini-image-note-${turnId}`, turnId, threadId: s.threadId, // DEFECT: template literal interpolation
      title: "Attached image skipped",
      text: `The selected model cannot read images, so ${dropped} attached image${dropped === 1 ? " was" : "s were"} dropped from this request. The text was sent; pick a vision-capable model to have images read.`, // DEFECT: template literal interpolation
      status: "completed",
      payload: { retryError: true, retrySource: "mini", imageInputUnsupported: true, dropped },
    };
    self.emit("notification", { method: "item/completed", params: { threadId: s.threadId, turnId, item } });
  }

  fn fetchMiniUpstream(self: &MiniBridge, s: MiniSession, turnId: TextBuf, url: TextBuf, init: RequestInit, maxRetries: f64) -> Response { // method of MiniBridge
    let userAgent = resolveMiniAgentUserAgent();
    let reqHeaders = new Headers(init.headers);
    if (!reqHeaders.has("User-Agent") && !reqHeaders.has("user-agent")) {
      reqHeaders.set("User-Agent", userAgent);
    }
    let finalInit: RequestInit = { ...init, headers: reqHeaders };
    let retries = 0;
    let rateLimitAttempts = 0;
    for (let attempt = 0; ; attempt++) {
      if (isMiniTurnCancelled(s, turnId)) throw new Error("interrupted"); // DEFECT: exception (try/catch/throw)
      let res: Response;
      try { // DEFECT: exception (try/catch/throw)
        res = fetch(url, finalInit); // DEFECT: async/await
      } catch (e) { // DEFECT: exception (try/catch/throw)
        if (isMiniTurnCancelled(s, turnId)) throw new Error("interrupted"); // DEFECT: exception (try/catch/throw)
        let interrupted = miniInterruptFromAbort(s, e);
        if (interrupted) throw interrupted; // DEFECT: exception (try/catch/throw)
        if (attempt < maxRetries && isMiniRetryableError(e) && !isMiniTurnCancelled(s, turnId)) {
          retries++;
          let detail = e instanceof Error ? e.message : String(e); // DEFECT: runtime type test (typeof/instanceof/in)
          self.emitMiniRetryNotice(s, turnId, attempt + 1, maxRetries, `Mini upstream connection failed, retrying: ${detail.slice(0, 200)}`); // DEFECT: JS Array/String method
          sleepWithMiniAbort(miniRetryDelayMs(attempt), init.signal); // DEFECT: async/await
          continue;
        }
        if (isMiniRetryableError(e)) {
          try { (e as Record<string, unknown>).__miniUpstreamRetriesExhausted = true; } catch { /* ignore */ } // DEFECT: exception (try/catch/throw)
        }
        throw e; // DEFECT: exception (try/catch/throw)
      }
      // 429 rate limits get their own bounded budget with Retry-After-aware
      // backoff (gateway free-channel cadence). Terminal quota/auth 429s
      // fall through to the normal path and fail fast with guidance.
      if (res.status === 429 && !isMiniTurnCancelled(s, turnId)) {
        let bodyPreview = res.text().catch(() => ""); // DEFECT: exception (try/catch/throw)
        if (!isMiniTerminalQuotaError(bodyPreview)
          && rateLimitAttempts < MINI_429_MAX_ATTEMPTS
          && attempt < maxRetries) {
          rateLimitAttempts++;
          retries++;
          let delay = mini429DelayMs(rateLimitAttempts - 1, miniRetryAfterMs(res.headers, bodyPreview));
          self.emitMiniRetryNotice(s, turnId, rateLimitAttempts, MINI_429_MAX_ATTEMPTS, `Mini upstream 429 rate limited, retrying in ${delay}ms (${rateLimitAttempts}/${MINI_429_MAX_ATTEMPTS})`); // DEFECT: template literal interpolation
          sleepWithMiniAbort(delay, init.signal); // DEFECT: async/await
          continue;
        }
        // Terminal quota 429 or exhausted rate-limit budget: return the
        // response so the caller throws the shaped `chat/responses 429`
        // error (excluded from round-level double retry by the status gate).
        // The body was already consumed above, so hand back a fresh Response
        // carrying the same text; callers read it (`await res.text()`) and the
        // original object would throw "Body already used".
        return new Response(bodyPreview, { status: res.status, statusText: res.statusText, headers: res.headers });
      }
      if (res.ok || attempt >= maxRetries || isMiniTurnCancelled(s, turnId) || !isMiniRetryableStatus(res.status)) {
        if (res.ok && retries > 0) {
          self.miniPendingRetryNotice.delete(self.miniRetryNoticeKey(s, turnId));
          self.emitMiniRetryRecovered(s, turnId, retries, maxRetries);
        }
        return res;
      }
      let bodyPreview = res.text().catch(() => ""); // DEFECT: exception (try/catch/throw)
      retries++;
      let delay = miniRetryDelayMs(attempt, miniRetryAfterMs(res.headers, bodyPreview));
      self.emitMiniRetryNotice(s, turnId, attempt + 1, maxRetries, `Mini upstream ${res.status}, retrying in ${delay}ms`); // DEFECT: template literal interpolation
      sleepWithMiniAbort(delay, init.signal); // DEFECT: async/await
    }
  }

  fn emitMiniExecDelta(self: &MiniBridge, processId: TextBuf, stream: TextBuf, bytes: TextBuf) -> void { // method of MiniBridge
    let exec = self.miniExecs.get(processId);
    if (!exec || exec.done) return;
    let buf = Buffer.isBuffer(bytes) ? bytes : Buffer.from(bytes);
    if (!buf.length) return;
    let emitted = stream === "stdout" ? exec.stdoutEmitted : exec.stderrEmitted;
    if (stream === "stdout" ? exec.stdoutCapped : exec.stderrCapped) return;
    let room = exec.cap - emitted;
    if (room <= 0) return;
    let slice = buf.length > room ? buf.subarray(0, room) : buf;
    let capReached = buf.length > room;
    if (stream === "stdout") {
      exec.stdoutEmitted += slice.length;
      if (capReached) exec.stdoutCapped = true;
    } else {
