let MINI_READ_ONLY_HOST_COMMANDS = new Set([ // DEFECT: JS builtin construction (Map/Set/Date/RegExp/AbortController/Error)
  "cat", "dir", "find", "grep", "head", "ls", "more", "pwd", "rg", "sort", "stat", "tail", "type", "uniq", "wc", "where", "which",
