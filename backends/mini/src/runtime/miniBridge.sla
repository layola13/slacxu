fn historyItemToText(m: JsonValue, perItemCap = 800: JsonValue) -> TextBuf { // was: function historyItemToText
  if (!m || typeof m !== "object") return ""; // DEFECT: runtime type test (typeof/instanceof/in)
  let rec = m as Record<string, any>; // DEFECT: type assertion (as)
  // Error/retry notices must never enter model history: a failed turn's
  // raw `chat 429` / `responses 502` / `stream connection failed` text
  // would otherwise pollute the next turn and the model would hallucinate
  // budget limits or repeat the failure. The waterfall renders these as
  // error cards from the persisted `error` item instead.
  let t = String(rec.type ?? "");
  if (t === "error" || t === "retryError" || t === "retryErrorGroup") return "";
  let status = String(rec.status ?? "").toLowerCase(); // DEFECT: JS Array/String method
  if (status === "failed" || status === "error" || status === "interrupted") return "";
  // perItemCap<=0 means "no truncation": when the history fits the context
  // budget there is no reason to destroy content the model already read.
  // Truncation applies ONLY under budget pressure (see miniHistoryBudgetChars).
  let cut = (v: string): string => (perItemCap > 0 ? v.slice(0, perItemCap) : v); // DEFECT: JS Array/String method
  // Tool arguments stay short even in full mode: they are call scaffolding,
  // not content the model needs back. (300 matches the historical default.)
  let cutArgs = (v: string): string => v.slice(0, 300); // DEFECT: JS Array/String method
  if (t === "userMessage") return `user: ${cut(String((m as Record<string, any>).text ?? ""))}`; // DEFECT: template literal interpolation
  // Internal goal-continuation fragment: only the newest one survives the
  // collapse in miniHistoryLinesFromMessages, so render it in full (it carries
  // the authoritative plan/progress block the next turn must respect).
  if (t === MINI_GOAL_CONTINUATION_ITEM_TYPE) {
    let body = String((m as Record<string, any>).text ?? ""); // DEFECT: type assertion (as)
    if (!body.trim()) return ""; // DEFECT: JS Array/String method
    return `goal-continuation: ${cut(body)}`; // DEFECT: template literal interpolation
  }
  if (t === "agentMessage") {
    let text = `assistant: ${cut(String((m as Record<string, any>).text ?? ""))}`; // DEFECT: template literal interpolation
    // Already-persisted failed turns (written before the error-card fix)
    // stored raw upstream errors as completed assistant text; keep them
    // out of future model input as well.
    if (MINI_POLLUTING_ERROR_RE.test(text)) return "";
    return text;
  }
  if (t === "toolCall") return `tool ${String((m as Record<string, any>).name ?? "")} ${cutArgs(String((m as Record<string, any>).arguments ?? ""))} => ${cut(String((m as Record<string, any>).output ?? ""))}`; // DEFECT: template literal interpolation
  if (t === "imageView") {
    let p = String((m as Record<string, any>).path ?? "").slice(0, 300); // DEFECT: JS Array/String method
    return p ? `[viewed image: ${p}]` : ""; // DEFECT: template literal interpolation
  }
  if (t === "compaction") return `[compaction: ${String((m as Record<string, any>).text ?? "")}]`; // DEFECT: template literal interpolation
  if (t === "plan") {
    let plan = (m as Record<string, any>).plan; // DEFECT: type assertion (as)
    if (Array.isArray(plan)) {
      let lines = plan
        .map((e: any) => `- [${String(e?.status ?? "") === "completed" ? "x" : " "}] ${String(e?.step ?? e?.text ?? "")}`) // DEFECT: optional chaining ?.
        .filter((l: string) => l.trim() !== "- [ ]"); // DEFECT: JS Array/String method
      if (lines.length) return `task plan:\n${perItemCap > 0 ? lines.join("\n").slice(0, Math.min(1200, perItemCap)) : lines.join("\n")}`; // DEFECT: JS Array/String method
    }
    return "";
  }
  return "";
}

// type MiniStoredImage = JsonValue // was: { url: string; detail?: string }

fn miniStoredImages(message: JsonValue) -> JsonArray { // was: function miniStoredImages
  if (!message || typeof message !== "object") return []; // DEFECT: runtime type test (typeof/instanceof/in)
  let rec = message as Record<string, unknown>; // DEFECT: type assertion (as)
  let rawContent = Array.isArray(rec.content) ? rec.content : [];
  let images: MiniStoredImage[] = [];
  let seen = new Set<string>(); // DEFECT: JS builtin construction (Map/Set/Date/RegExp/AbortController/Error)
  for (const raw of rawContent) {
    if (!raw || typeof raw !== "object") continue; // DEFECT: runtime type test (typeof/instanceof/in)
    let block = raw as Record<string, unknown>; // DEFECT: type assertion (as)
    let type = String(block.type ?? "").toLowerCase(); // DEFECT: JS Array/String method
    if (type !== "image" && type !== "input_image" && type !== "image_url" && type !== "inputimage") continue;
    let imageUrl = block.image_url;
    let url = typeof block.url === "string" // DEFECT: runtime type test (typeof/instanceof/in)
      ? block.url
      : typeof imageUrl === "string" // DEFECT: runtime type test (typeof/instanceof/in)
        ? imageUrl
        : imageUrl && typeof imageUrl === "object" // DEFECT: runtime type test (typeof/instanceof/in)
          ? String((imageUrl as Record<string, unknown>).url ?? "") // DEFECT: type assertion (as)
          : "";
    if (!url || seen.has(url)) continue;
    seen.add(url);
    images.push({ url, detail: typeof block.detail === "string" ? block.detail : undefined }); // DEFECT: runtime type test (typeof/instanceof/in)
  }
  return images;
}

fn miniHistoricalImageMessage(message: JsonValue, protocol: TextBuf) -> JsonValue { // was: function miniHistoricalImageMessage
  if (!message || typeof message !== "object") return null; // DEFECT: runtime type test (typeof/instanceof/in)
  let rec = message as Record<string, unknown>; // DEFECT: type assertion (as)
  if (rec.type !== "userMessage") return null;
  let images = miniStoredImages(message);
  if (!images.length) return null;
  if (protocol !== "responses") {
    return {
      role: "user",
      content: images.map((image) => ({ type: "image_url", image_url: { url: image.url, ...(image.detail ? { detail: image.detail } : {}) } })), // DEFECT: JS Array/String method
    };
  }
  return {
    role: "user",
    content: images.map((image) => ({ type: "input_image", image_url: image.url, detail: image.detail ?? "auto" })), // DEFECT: JS Array/String method
  };
}

fn buildMiniCompactContent(messages: JsonArray, protocol: TextBuf, limit = 12000: JsonValue, includeImages = true: JsonValue) -> JsonArray { // was: function buildMiniCompactContent
  let transcript = buildMiniCompactTranscript(messages, limit);
  let anchors = buildMiniCompactionAnchors(messages);
  let content: Array<Record<string, unknown>> = transcript ? [{ type: protocol === "responses" ? "input_text" : "text", text: transcript }] : [];
  if (anchors) {
    content.push({ // DEFECT: JS Array/String method
      type: protocol === "responses" ? "input_text" : "text",
      text: `[durable conversation anchors]\n${anchors}`, // DEFECT: template literal interpolation
    });
  }
