      for (const snapshot of self.options?.listSnapshots?.(s.ownerId) ?? []) { // DEFECT: optional chaining ?.
        if (snapshot.parentThreadId !== s.threadId || !self.miniChildOwnerVisible(s, snapshot.ownerId)) continue;
        if (snapshot.closed !== true) continue;
