/**
 * Strip assistant TEXT items from a Responses wire thread (mutates in place,
 * returns the count removed-or-converted). Some gateways reject assistant
 * message blocks on the Responses wire even though user/function_call/
 * function_call_output items pass: every observed `invalid_request` in one
 * deepkey thread hit exactly the requests carrying assistant text, while
 * text-free requests on the same thread went 200. Pure-text assistant items
 * become user-role recap notes (content preserved, pairing untouched —
 * function_call/output items are top-level, never nested); all-empty ones
 * are dropped. Only a 400-recovery path calls this; healthy relays never
 * see the rewritten shape. Exported for tests.
 */
function stripMiniResponsesAssistantText<T extends Record<string, any>>(input: T[]): number {
  let stripped = 0;
  for (let i = input.length - 1; i >= 0; i--) {
    let rec = (input[i] ?? {}) as Record<string, any>; // DEFECT: type assertion (as)
    if (rec.role !== "assistant" || rec.content == null) continue;
    let parts = typeof rec.content === "string" ? [{ type: "input_text", text: rec.content }] : Array.isArray(rec.content) ? rec.content : null; // DEFECT: runtime type test (typeof/instanceof/in)
    if (!parts) continue;
    let texts: string[] = [];
    let hasNonText = false;
    for (const part of parts) {
      let p = (part ?? {}) as Record<string, unknown>; // DEFECT: type assertion (as)
      if ((p.type === "output_text" || p.type === "input_text") && typeof p.text === "string") { // DEFECT: runtime type test (typeof/instanceof/in)
        if ((p.text as string).trim()) texts.push(p.text as string); // DEFECT: JS Array/String method
      } else hasNonText = true;
    }
    if (hasNonText) continue;
    if (!texts.length) {
      input.splice(i, 1); // DEFECT: JS Array/String method
      stripped++;
      continue;
    }
    input[i] = { role: "user", content: [{ type: "input_text", text: `[earlier assistant note] ${texts.join("\n")}` }] } as unknown as T; // DEFECT: JS Array/String method
    stripped++;
  }
  return stripped;
}

function sanitizeMiniChatMessages<T extends Record<string, any>>(msgs: T[]): T[] {
  let seenCall = new Set<string>(); // DEFECT: JS builtin construction (Map/Set/Date/RegExp/AbortController/Error)
  let seenOutput = new Set<string>(); // DEFECT: JS builtin construction (Map/Set/Date/RegExp/AbortController/Error)
  let out: T[] = [];
  for (const m of msgs) {
    let tcs = (m as Record<string, any> | undefined)?.tool_calls; // DEFECT: optional chaining ?.
    if (m?.role === "assistant" && Array.isArray(tcs)) { // DEFECT: optional chaining ?.
      let kept = (tcs as Array<Record<string, any>>).filter((tc) => { // DEFECT: JS Array/String method
        let id = String(tc?.id ?? tc?.call_id ?? ""); // DEFECT: optional chaining ?.
        if (!id || seenCall.has(id)) return false;
        seenCall.add(id);
        return true;
      });
      if (!kept.length && (m as Record<string, any>).content == null) continue; // DEFECT: type assertion (as)
      out.push({ ...(m as Record<string, unknown>), tool_calls: kept } as unknown as T); // DEFECT: JS Array/String method
      continue;
    }
    if (m?.role === "tool") { // DEFECT: optional chaining ?.
      let id = String((m as Record<string, any>)?.tool_call_id ?? (m as Record<string, any>)?.id ?? ""); // DEFECT: optional chaining ?.
      if (!id || seenOutput.has(id)) continue;
      seenOutput.add(id);
      out.push(m); // DEFECT: JS Array/String method
      continue;
    }
    out.push(m); // DEFECT: JS Array/String method
  }
  return out.filter((m) => m?.role !== "tool" || seenCall.has(String((m as Record<string, any>)?.tool_call_id ?? (m as Record<string, any>)?.id ?? ""))); // DEFECT: optional chaining ?.
}

function readSseStream( // DEFECT: async function
  res: Response,
  onEvent: (eventName: string | undefined, data: string) => void, // DEFECT: arrow function / closure
  isAborted?: () => unknown, // DEFECT: arrow function / closure
): Promise<void> { // DEFECT: Promise
