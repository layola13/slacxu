}
let MINI_FIRST_PLAN_NOTE = "This looks like multi-step work and no checklist exists yet: call update_plan FIRST with the complete checklist ({todos:[{content,status}]}), then work the in_progress step with sa_vm. Each call replaces the whole list; only one step may be in_progress.";
