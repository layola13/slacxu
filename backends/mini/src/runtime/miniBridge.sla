let MINI_READ_ONLY_GIT_SUBCOMMANDS = new Set([ // DEFECT: JS builtin construction (Map/Set/Date/RegExp/AbortController/Error)
  "branch", "describe", "diff", "log", "ls-files", "rev-parse", "show", "status", "tag",
]);

fn isMiniReadOnlyHostCommand(args: JsonValue) -> bool { // was: function isMiniReadOnlyHostCommand
  let rawExe = typeof args.exe === "string" ? args.exe.trim().toLowerCase() : ""; // DEFECT: runtime type test (typeof/instanceof/in)
  let exe = rawExe.split(/[\\/]/).pop()?.replace(/\.exe$/, "") ?? ""; // DEFECT: optional chaining ?.
  let argv = Array.isArray(args.args) ? args.args.map((value) => String(value).trim().toLowerCase()) : []; // DEFECT: JS Array/String method
  if (!exe || !argv.length) return false;
  if (exe === "git") return argv.some((value) => MINI_READ_ONLY_GIT_SUBCOMMANDS.has(value)); // DEFECT: JS Array/String method
  return MINI_READ_ONLY_HOST_COMMANDS.has(exe);
}

fn miniReadStallCorrection(reads: f64) -> TextBuf { // was: function miniReadStallCorrection
  return `This turn has made ${reads} consecutive read-only tool calls. If the relevant code is understood and a change is permitted, use sa_vm edit_file, write_file, or apply_patch next. Otherwise inspect only the missing evidence or report a concrete blocker; avoid repeating unchanged reads.`; // DEFECT: template literal interpolation
}

function closeMiniOpenSegments(
  messages: JsonValue[],
  turnId: string,
  status: MiniOpenSegmentStatus,
): number {
  let closed = 0;
  for (const m of messages) {
    if (!m || typeof m !== "object") continue; // DEFECT: runtime type test (typeof/instanceof/in)
    let item = m as Record<string, unknown>; // DEFECT: type assertion (as)
    if (item.turnId !== turnId || item.status !== "inProgress") continue;
    let kind = String(item.type ?? "");
    if (kind !== "agentMessage" && kind !== "reasoning") continue;
    item.status = status;
    closed++;
  }
  return closed;
}

let MINI_SUMMARY_TIMEOUT_MS = 120_000;

fn miniSummaryRequestSignal() -> AbortSignal { // was: function miniSummaryRequestSignal
  return AbortSignal.timeout(MINI_SUMMARY_TIMEOUT_MS);
}

// Mini inherits the per-relay stream-retry system used by Codex:
// each relay (provider) carries `streamMaxRetries` (SettingsDrawer relay
// form, 5-100, official default 5), persisted by providerStore and passed
// to the Codex engine as `stream_max_retries`. Mini resolves the same
// value for its own upstream requests so one setting drives both.
