    if mb_bytes_eq(method_p, method_n, STR_PTR("thread/compact/start"), STR_LEN("thread/compact/start")) {
        let thread = MbStr { bytes: [0u8; 8192], len: 0 };
        mb_req_id(rr, STR_PTR("threadId"), STR_LEN("threadId"), &thread);
        let owner = MbStr { bytes: [0u8; 8192], len: 0 };
        let has_owner: bool = mb_g_str(rr, STR_PTR("ownerId"), STR_LEN("ownerId"), &owner);
        let s: u64 = 0;
        let has_s: bool = false;
        MiniBridge_get_or_restore_session(b, mb_sp(&thread), thread.len, mb_sp(&owner), owner.len, has_owner, &s, &has_s);
        if !has_s {
            let res: u64 = mb_new_obj();
            let rc0: i32 = mb_s_bool(res, STR_PTR("ok"), STR_LEN("ok"), false);
            *out = res;
            return;
        };
        let released: bool = MiniBridge_release_stale_active_slot(s);
        if mb_g_has(s, STR_PTR("activeTurnId"), STR_LEN("activeTurnId")) {
