    mb_trim_to(p, n, &t);
    return mb_str_in_lit_arr(STR_PTR("[\"write_file\",\"write\",\"edit_file\",\"edit\",\"apply_patch\",\"patch\",\"delete_file\",\"delete\",\"remove_file\",\"safe_delete\",\"move_file\",\"move\",\"rename\",\"rename_file\",\"copy_file\",\"copy\",\"mkdir\",\"ensure_dir\",\"move_file_with_imports\",\"extract_to_file\",\"extract_file\",\"extract_module\",\"extract_component\",\"extract_hook\",\"split_stage\",\"split_refine\",\"split_repair\",\"add_import\",\"insert_import\",\"organize_imports\",\"clean_unused_imports\",\"sort_imports\",\"auto_fix_missing_imports\",\"fix_missing_imports\",\"atomic_refactor\",\"rename_symbol\",\"run_bun\",\"run_bun_profile\",\"run_project_check\",\"project_check\",\"run_host\",\"exec_host\",\"host\",\"run_js\",\"exec_js\",\"run_py\",\"run_python\",\"exec_py\",\"write_stdin\",\"stdin\",\"input_stdin\",\"kill_session\",\"kill_process\",\"stop_session\",\"local_checkpoint\",\"checkpoint\",\"restore_checkpoint\"]"), STR_LEN("[\"write_file\",\"write\",\"edit_file\",\"edit\",\"apply_patch\",\"patch\",\"delete_file\",\"delete\",\"remove_file\",\"safe_delete\",\"move_file\",\"move\",\"rename\",\"rename_file\",\"copy_file\",\"copy\",\"mkdir\",\"ensure_dir\",\"move_file_with_imports\",\"extract_to_file\",\"extract_file\",\"extract_module\",\"extract_component\",\"extract_hook\",\"split_stage\",\"split_refine\",\"split_repair\",\"add_import\",\"insert_import\",\"organize_imports\",\"clean_unused_imports\",\"sort_imports\",\"auto_fix_missing_imports\",\"fix_missing_imports\",\"atomic_refactor\",\"rename_symbol\",\"run_bun\",\"run_bun_profile\",\"run_project_check\",\"project_check\",\"run_host\",\"exec_host\",\"host\",\"run_js\",\"exec_js\",\"run_py\",\"run_python\",\"exec_py\",\"write_stdin\",\"stdin\",\"input_stdin\",\"kill_session\",\"kill_process\",\"stop_session\",\"local_checkpoint\",\"checkpoint\",\"restore_checkpoint\"]"), mb_sp(&t), t.len, true);
}
fn mb_is_file_lane_action(p: ptr, n: u64) -> bool {
    let t = MbStr { bytes: [0u8; 8192], len: 0 };
    mb_trim_to(p, n, &t);
    return mb_str_in_lit_arr(STR_PTR("[\"write_file\",\"write\",\"edit_file\",\"edit\",\"apply_patch\",\"patch\",\"delete_file\",\"delete\",\"remove_file\",\"safe_delete\",\"move_file\",\"move\",\"rename\",\"rename_file\",\"rename_symbol\",\"copy_file\",\"copy\",\"mkdir\",\"ensure_dir\",\"move_file_with_imports\",\"extract_to_file\",\"extract_file\",\"extract_module\",\"extract_component\",\"extract_hook\",\"add_import\",\"insert_import\",\"organize_imports\",\"clean_unused_imports\",\"sort_imports\",\"auto_fix_missing_imports\",\"fix_missing_imports\",\"atomic_refactor\",\"split_stage\",\"split_refine\",\"split_repair\"]"), STR_LEN("[\"write_file\",\"write\",\"edit_file\",\"edit\",\"apply_patch\",\"patch\",\"delete_file\",\"delete\",\"remove_file\",\"safe_delete\",\"move_file\",\"move\",\"rename\",\"rename_file\",\"rename_symbol\",\"copy_file\",\"copy\",\"mkdir\",\"ensure_dir\",\"move_file_with_imports\",\"extract_to_file\",\"extract_file\",\"extract_module\",\"extract_component\",\"extract_hook\",\"add_import\",\"insert_import\",\"organize_imports\",\"clean_unused_imports\",\"sort_imports\",\"auto_fix_missing_imports\",\"fix_missing_imports\",\"atomic_refactor\",\"split_stage\",\"split_refine\",\"split_repair\"]"), mb_sp(&t), t.len, true);
}
fn normalizeMiniSandbox(node: u64, out: &MbStr, out_has: &bool) -> void {
    out.len = 0;
    *out_has = false;
    let raw = MbStr { bytes: [0u8; 8192], len: 0 };
    if !mb_n_str(node, &raw) { return; };
    mb_trim_to(mb_sp(&raw), raw.len, out);
    *out_has = out.len > 0;
}
fn miniApprovalLane(p: ptr, n: u64, out: &MbStr, out_has: &bool) -> void {
    out.len = 0;
    *out_has = false;
    let t = MbStr { bytes: [0u8; 8192], len: 0 };
    mb_trim_to(p, n, &t);
    if t.len == 0 { return; };
    if mb_str_in_lit_arr(STR_PTR("[\"run_js\",\"exec_js\",\"js\",\"javascript\",\"node\",\"run_node\",\"exec_node\",\"exec_bun\",\"eval_js\",\"run_py\",\"run_python\",\"exec_py\",\"py\",\"python\"]"), STR_LEN("[\"run_js\",\"exec_js\",\"js\",\"javascript\",\"node\",\"run_node\",\"exec_node\",\"exec_bun\",\"eval_js\",\"run_py\",\"run_python\",\"exec_py\",\"py\",\"python\"]"), mb_sp(&t), t.len, true) {
        mb_sassign(out, STR_PTR("exec"), STR_LEN("exec"));
        *out_has = true;
        return;
    };
    if mb_str_in_lit_arr(STR_PTR("[\"delete_file\",\"delete\",\"remove_file\",\"safe_delete\"]"), STR_LEN("[\"delete_file\",\"delete\",\"remove_file\",\"safe_delete\"]"), mb_sp(&t), t.len, true) {
        mb_sassign(out, STR_PTR("file"), STR_LEN("file"));
        *out_has = true;
        return;
    };
}
fn miniNeedsApproval(policy_p: ptr, policy_n: u64, has_policy: bool, bypass: bool) -> bool {
    if bypass { return false; };
    if !has_policy { return false; };
    let t = MbStr { bytes: [0u8; 8192], len: 0 };
    mb_trim_to(policy_p, policy_n, &t);
    if t.len == 0 { return false; };
    if mb_eq_ci(mb_sp(&t), t.len, STR_PTR("never"), STR_LEN("never")) { return false; };
    if mb_eq_ci(mb_sp(&t), t.len, STR_PTR("bypass"), STR_LEN("bypass")) { return false; };
    return true;
}
fn miniApprovalTarget(args: u64, out: &MbStr) -> void {
    out.len = 0;
    if args == 0 { return; };
    let keys: [u8; 7] = [0; 7];
    let key_names = MbJson { bytes: [0u8; 262144], len: 0 };
    mb_jassign(&key_names, STR_PTR("[\"path\",\"file\",\"target\",\"dir\",\"cwd\",\"from\",\"to\",\"uri\"]"), STR_LEN("[\"path\",\"file\",\"target\",\"dir\",\"cwd\",\"from\",\"to\",\"uri\"]"));
    let kdoc: u64 = mb_j_doc(&key_names);
    let kc: u64 = mb_n_count(kdoc);
    let ki: u64 = 0;
    while ki < kc {
        let k = MbStr { bytes: [0u8; 8192], len: 0 };
        if mb_n_str(mb_a_at(kdoc, ki), &k) {
            let v = MbStr { bytes: [0u8; 8192], len: 0 };
            if mb_g_str(args, mb_sp(&k), k.len, &v) {
                let t = MbStr { bytes: [0u8; 8192], len: 0 };
                mb_trim_to(mb_sp(&v), v.len, &t);
                if t.len > 0 {
                    if t.len > 300 { mb_sassign(out, mb_sp(&t), 300); } else { mb_sassign(out, mb_sp(&t), t.len); };
                    mb_free_doc(kdoc);
                    return;
                };
            };
        };
        ki = ki + 1;
    }
    mb_free_doc(kdoc);
    let exe = MbStr { bytes: [0u8; 8192], len: 0 };
    if mb_g_str(args, STR_PTR("exe"), STR_LEN("exe"), &exe) {
        let et = MbStr { bytes: [0u8; 8192], len: 0 };
        mb_trim_to(mb_sp(&exe), exe.len, &et);
        if et.len > 0 {
            let joined = MbJson { bytes: [0u8; 262144], len: 0 };
            mb_jassign_s(&joined, &et);
            let arr: u64 = mb_g_node(args, STR_PTR("args"), STR_LEN("args"));
            if arr != 0 && mb_kind(arr) == MB_JK_ARRAY {
                let ac: u64 = mb_n_count(arr);
                let ai: u64 = 0;
                while ai < ac {
                    let a = MbStr { bytes: [0u8; 8192], len: 0 };
                    if mb_n_str(mb_a_at(arr, ai), &a) { mb_jpush(&joined, 32); mb_jappend_s(&joined, &a); };
                    ai = ai + 1;
                }
            };
            if joined.len > 300 { mb_sassign(out, mb_jp(&joined), 300); } else { mb_sassign(out, mb_jp(&joined), joined.len); };
            return;
        };
    };
    let cmd = MbStr { bytes: [0u8; 8192], len: 0 };
    if mb_g_str(args, STR_PTR("command"), STR_LEN("command"), &cmd) {
        let ct = MbStr { bytes: [0u8; 8192], len: 0 };
        mb_trim_to(mb_sp(&cmd), cmd.len, &ct);
        if ct.len > 300 { mb_sassign(out, mb_sp(&ct), 300); } else { mb_sassign(out, mb_sp(&ct), ct.len); };
    };
}
fn parseMiniApprovalDecision(result: u64, has_error: bool, out: &MbStr) -> void {
    if has_error { mb_sassign(out, STR_PTR("cancel"), STR_LEN("cancel")); return; };
    let raw0 = MbStr { bytes: [0u8; 8192], len: 0 };
    let raw = MbStr { bytes: [0u8; 8192], len: 0 };
    if result != 0 { let ok: bool = mb_g_str(result, STR_PTR("decision"), STR_LEN("decision"), &raw0); };
    mb_trim_to(mb_sp(&raw0), raw0.len, &raw);
    if mb_eq_ci(mb_sp(&raw), raw.len, STR_PTR("accept"), STR_LEN("accept")) || mb_eq_ci(mb_sp(&raw), raw.len, STR_PTR("approved"), STR_LEN("approved")) { mb_sassign(out, STR_PTR("accept"), STR_LEN("accept")); return; };
    if mb_eq_ci(mb_sp(&raw), raw.len, STR_PTR("acceptforsession"), STR_LEN("acceptforsession")) || mb_eq_ci(mb_sp(&raw), raw.len, STR_PTR("approved_for_session"), STR_LEN("approved_for_session")) || mb_eq_ci(mb_sp(&raw), raw.len, STR_PTR("accept_for_session"), STR_LEN("accept_for_session")) { mb_sassign(out, STR_PTR("session"), STR_LEN("session")); return; };
    if mb_eq_ci(mb_sp(&raw), raw.len, STR_PTR("cancel"), STR_LEN("cancel")) || mb_eq_ci(mb_sp(&raw), raw.len, STR_PTR("abort"), STR_LEN("abort")) { mb_sassign(out, STR_PTR("cancel"), STR_LEN("cancel")); return; };
    mb_sassign(out, STR_PTR("decline"), STR_LEN("decline"));
}
fn isMiniPlanRequest(r: u64) -> bool {
    let s = MbStr { bytes: [0u8; 8192], len: 0 };
    if mb_g_str(r, STR_PTR("sandbox"), STR_LEN("sandbox"), &s) && mb_s_eq(&s, STR_PTR("read-only"), STR_LEN("read-only")) { return true; };
    if mb_g_str(r, STR_PTR("mode"), STR_LEN("mode"), &s) && mb_s_eq(&s, STR_PTR("plan"), STR_LEN("plan")) { return true; };
    let cm: u64 = mb_g_node(r, STR_PTR("collaborationMode"), STR_LEN("collaborationMode"));
    if cm != 0 {
        if mb_kind(cm) == MB_JK_STRING && mb_n_str(cm, &s) && mb_s_eq(&s, STR_PTR("plan"), STR_LEN("plan")) { return true; };
        if mb_kind(cm) == MB_JK_OBJECT {
            if mb_g_str(cm, STR_PTR("mode"), STR_LEN("mode"), &s) && mb_s_eq(&s, STR_PTR("plan"), STR_LEN("plan")) { return true; };
            let settings: u64 = mb_g_node(cm, STR_PTR("settings"), STR_LEN("settings"));
            if settings != 0 && mb_g_str(settings, STR_PTR("mode"), STR_LEN("mode"), &s) && mb_s_eq(&s, STR_PTR("plan"), STR_LEN("plan")) { return true; };
        };
    };
    let pb: bool = false;
    if mb_g_bool(r, STR_PTR("planModeEnabled"), STR_LEN("planModeEnabled"), &pb) && pb { return true; };
    return false;
}

// ---- goal state / budget / progress (TS:522-655) ----
fn miniGoalState(session: u64, out: &MbJson) -> void {
    let doc: u64 = mb_new_obj();
    let tid = MbStr { bytes: [0u8; 8192], len: 0 };
    let ok0: bool = mb_g_str(session, STR_PTR("threadId"), STR_LEN("threadId"), &tid);
    let rc: i32 = mb_s_str(doc, STR_PTR("threadId"), STR_LEN("threadId"), mb_sp(&tid), tid.len);
    let obj = MbStr { bytes: [0u8; 8192], len: 0 };
    let has_obj: bool = mb_g_str(session, STR_PTR("goalObjective"), STR_LEN("goalObjective"), &obj);
    rc = mb_s_str(doc, STR_PTR("objective"), STR_LEN("objective"), mb_sp(&obj), obj.len);
    let status = MbStr { bytes: [0u8; 8192], len: 0 };
    if !mb_g_str(session, STR_PTR("goalStatus"), STR_LEN("goalStatus"), &status) { mb_sassign(&status, STR_PTR("active"), STR_LEN("active")); };
    rc = mb_s_str(doc, STR_PTR("status"), STR_LEN("status"), mb_sp(&status), status.len);
    let budget: f64 = 0.0;
    if mb_g_f64(session, STR_PTR("goalTokenBudget"), STR_LEN("goalTokenBudget"), &budget) { rc = mb_s_f64(doc, STR_PTR("tokenBudget"), STR_LEN("tokenBudget"), budget); } else { rc = mb_s_null(doc, STR_PTR("tokenBudget"), STR_LEN("tokenBudget")); };
    let used: f64 = 0.0;
    let has_used: bool = mb_g_f64(session, STR_PTR("goalTokensUsed"), STR_LEN("goalTokensUsed"), &used);
    rc = mb_s_f64(doc, STR_PTR("tokensUsed"), STR_LEN("tokensUsed"), used);
    let started: f64 = 0.0;
    let secs: i64 = 0;
    if mb_g_f64(session, STR_PTR("goalStartedAt"), STR_LEN("goalStartedAt"), &started) {
        let diff: i64 = mb_now_ms() - mb_floor_f64(started);
        if diff > 0 { secs = diff / 1000; };
    };
    rc = mb_s_i64(doc, STR_PTR("timeUsedSeconds"), STR_LEN("timeUsedSeconds"), secs);
    let st: i32 = mb_doc_to_j(doc, out);
    mb_free_doc(doc);
}
// Returns kind: 0 = undefined, 1 = null, 2 = value (out_val).
fn normalizeMiniGoalBudget(node: u64, present: bool, out_kind: &u64, out_val: &i64) -> void {
    *out_kind = 0;
    *out_val = 0;
    if !present { return; };
    if node == 0 || mb_kind(node) == MB_JK_NULL { *out_kind = 1; return; };
    let n: f64 = 0.0;
    let has: bool = false;
    if mb_kind(node) == MB_JK_STRING {
        let s = MbStr { bytes: [0u8; 8192], len: 0 };
        if mb_n_str(node, &s) {
            let t = MbStr { bytes: [0u8; 8192], len: 0 };
            mb_trim_to(mb_sp(&s), s.len, &t);
            if t.len > 0 && mb_parse_f64(mb_sp(&t), t.len, &n) { has = true; };
        };
    } else if mb_n_f64(node, &n) { has = true; };
    if !has { return; };
    if n <= 0.0 { *out_kind = 1; return; };
    let floored: i64 = mb_floor_f64(n);
    if floored > 10000000 { floored = 10000000; };
    *out_kind = 2;
    *out_val = floored;
}
fn isMiniGoalBudgetExhausted(session: u64) -> bool {
    let budget: f64 = 0.0;
    if !mb_g_f64(session, STR_PTR("goalTokenBudget"), STR_LEN("goalTokenBudget"), &budget) { return false; };
    if budget <= 0.0 { return false; };
    let used: f64 = 0.0;
    let has: bool = mb_g_f64(session, STR_PTR("goalTokensUsed"), STR_LEN("goalTokensUsed"), &used);
    return used >= budget;
}
fn buildMiniGoalContinuationPrompt(session: u64, count: i64, max: i64, plan_p: ptr, plan_n: u64, has_plan: bool, stagnant: i64, has_stagnant: bool, out: &MbJson) -> void {
    let st = GoalContinuationState { has_goalObjective: false, goalObjective: [0u8; 8192], goalObjective_len: 0, has_goalTokensUsed: false, goalTokensUsed: 0, has_goalTokenBudget: false, goalTokenBudget: 0, has_goalStartedAt: false, goalStartedAt: 0 };
    let obj = MbStr { bytes: [0u8; 8192], len: 0 };
    if mb_g_str(session, STR_PTR("goalObjective"), STR_LEN("goalObjective"), &obj) {
        st.has_goalObjective = true;
        mb_sassign(&obj, mb_sp(&obj), obj.len);
        for i in 0..obj.len { st.goalObjective[i] = obj.bytes[i]; }
        st.goalObjective_len = obj.len;
    };
    let fv: f64 = 0.0;
    if mb_g_f64(session, STR_PTR("goalTokensUsed"), STR_LEN("goalTokensUsed"), &fv) { st.has_goalTokensUsed = true; st.goalTokensUsed = fv as u64; };
    if mb_g_f64(session, STR_PTR("goalTokenBudget"), STR_LEN("goalTokenBudget"), &fv) { st.has_goalTokenBudget = true; st.goalTokenBudget = fv as u64; };
    if mb_g_f64(session, STR_PTR("goalStartedAt"), STR_LEN("goalStartedAt"), &fv) { st.has_goalStartedAt = true; st.goalStartedAt = fv as u64; };
    let opts = GoalContinuationOptions { count: count as u64, max: max as u64, has_planText: has_plan, planText: [0u8; 8192], planText_len: 0, has_stagnantTurns: has_stagnant, stagnantTurns: 0, has_stagnantLimit: true, stagnantLimit: 3, has_planToolName: true, planToolName: [0u8; 64], planToolName_len: 0 };
    if has_plan {
        let pp = MbStr { bytes: [0u8; 8192], len: 0 };
        mb_sassign(&pp, plan_p, plan_n);
        for i in 0..pp.len { opts.planText[i] = pp.bytes[i]; }
        opts.planText_len = pp.len;
    };
    if has_stagnant { opts.stagnantTurns = stagnant as u64; };
    let tn = MbStr { bytes: [0u8; 8192], len: 0 };
    mb_sassign(&tn, STR_PTR("update_plan"), STR_LEN("update_plan"));
    for i in 0..tn.len { opts.planToolName[i] = tn.bytes[i]; }
    opts.planToolName_len = tn.len;
    let pb = PromptBuf { bytes: [0u8; 32768], len: 0 };
    let rc: i32 = buildGoalContinuationPrompt(&st, &opts, mb_now_ms() as u64, &pb);
    out.len = 0;
    let pp2: ptr = PTR_NULL();
    PTR_BYTE_ADD(pp2, &pb.bytes, 0);
    mb_jappend(out, pp2, pb.len);
}
fn normalizeMiniGoalStatus(node: u64, out: &MbStr, out_has: &bool) -> void {
    out.len = 0;
    *out_has = false;
    let raw = MbStr { bytes: [0u8; 8192], len: 0 };
    if !mb_n_str(node, &raw) { return; };
    let t = MbStr { bytes: [0u8; 8192], len: 0 };
    mb_trim_to(mb_sp(&raw), raw.len, &t);
    let low = MbStr { bytes: [0u8; 8192], len: 0 };
    mb_lower_into(mb_sp(&t), t.len, &low);
    if mb_s_eq(&low, STR_PTR("active"), STR_LEN("active")) || mb_s_eq(&low, STR_PTR("paused"), STR_LEN("paused")) || mb_s_eq(&low, STR_PTR("blocked"), STR_LEN("blocked")) || mb_s_eq(&low, STR_PTR("complete"), STR_LEN("complete")) { mb_sassign(out, mb_sp(&low), low.len); *out_has = true; return; };
    if mb_s_eq(&low, STR_PTR("completed"), STR_LEN("completed")) { mb_sassign(out, STR_PTR("complete"), STR_LEN("complete")); *out_has = true; return; };
    if mb_s_eq(&low, STR_PTR("usagelimited"), STR_LEN("usagelimited")) || mb_s_eq(&low, STR_PTR("usage_limited"), STR_LEN("usage_limited")) || mb_s_eq(&low, STR_PTR("usage-limited"), STR_LEN("usage-limited")) { mb_sassign(out, STR_PTR("usageLimited"), STR_LEN("usageLimited")); *out_has = true; return; };
    if mb_s_eq(&low, STR_PTR("budgetlimited"), STR_LEN("budgetlimited")) || mb_s_eq(&low, STR_PTR("budget_limited"), STR_LEN("budget_limited")) || mb_s_eq(&low, STR_PTR("budget-limited"), STR_LEN("budget-limited")) { mb_sassign(out, STR_PTR("budgetLimited"), STR_LEN("budgetLimited")); *out_has = true; return; };
}
// TS MINI_GOAL_USAGE_LIMIT_ERROR_RE; \b429\b approximated with digit
// boundaries (ERE has no \b in the portable subset; registered).
fn mb_is_goal_usage_limit_error(p: ptr, n: u64) -> bool {
    return mb_re_test(p, n, STR_PTR("(^|[^0-9])429([^0-9]|$)|rate[ \t_-]?limit|quota|insufficient[ \t_-]?(balance|credit|funds)|usage[ \t_-]?limit|billing"), STR_LEN("(^|[^0-9])429([^0-9]|$)|rate[ \t_-]?limit|quota|insufficient[ \t_-]?(balance|credit|funds)|usage[ \t_-]?limit|billing"), true)
        || mb_contains(p, n, STR_PTR("额度"), STR_LEN("额度"))
        || mb_contains(p, n, STR_PTR("余额不足"), STR_LEN("余额不足"))
        || mb_contains(p, n, STR_PTR("配额"), STR_LEN("配额"));
}
fn mb_plan_step_text(entry: u64, out: &MbJson) -> void {
    // `${step ?? text}` head helper shared by the fingerprint builders.
    out.len = 0;
    if entry == 0 { return; };
    if mb_g_str_j(entry, STR_PTR("step"), STR_LEN("step"), out) { return; };
    let ok: bool = mb_g_str_j(entry, STR_PTR("text"), STR_LEN("text"), out);
}
fn miniGoalTurnFingerprint(messages: u64, turn_p: ptr, turn_n: u64, out: &MbJson) -> void {
    out.len = 0;
    if messages == 0 || mb_kind(messages) != MB_JK_ARRAY { return; };
    let parts = MbJson { bytes: [0u8; 262144], len: 0 };
    let count: u64 = mb_n_count(messages);
    let i: u64 = 0;
    let first: bool = true;
    while i < count {
        let m: u64 = mb_a_at(messages, i);
        i = i + 1;
        if m == 0 || mb_kind(m) != MB_JK_OBJECT { continue; };
        let tid = MbStr { bytes: [0u8; 8192], len: 0 };
        let has_tid: bool = mb_g_str(m, STR_PTR("turnId"), STR_LEN("turnId"), &tid);
        let tid_txt = MbJson { bytes: [0u8; 262144], len: 0 };
        if !has_tid { let ok: bool = mb_g_str_j(m, STR_PTR("turnId"), STR_LEN("turnId"), &tid_txt); mb_sassign_j(&tid, &tid_txt); };
        if !mb_bytes_eq(mb_sp(&tid), tid.len, turn_p, turn_n) { continue; };
        let ty = MbStr { bytes: [0u8; 8192], len: 0 };
        let ok2: bool = mb_g_str(m, STR_PTR("type"), STR_LEN("type"), &ty);
        let line = MbJson { bytes: [0u8; 262144], len: 0 };
        if mb_s_eq(&ty, STR_PTR("toolCall"), STR_LEN("toolCall")) {
            let name = MbStr { bytes: [0u8; 8192], len: 0 };
            if !mb_g_str(m, STR_PTR("name"), STR_LEN("name"), &name) { mb_sassign(&name, STR_PTR("tool"), STR_LEN("tool")); };
            let args = MbJson { bytes: [0u8; 262144], len: 0 };
            mb_json_scalar_text(mb_g_node(m, STR_PTR("arguments"), STR_LEN("arguments")), &args);
            let output = MbJson { bytes: [0u8; 262144], len: 0 };
            mb_json_scalar_text(mb_g_node(m, STR_PTR("output"), STR_LEN("output")), &output);
            mb_jappend(&line, STR_PTR("tool:"), STR_LEN("tool:"));
            mb_jappend_s(&line, &name);
            mb_jpush(&line, 58);
            mb_slice_head(mb_jp(&args), args.len, 200, &args);
            mb_jappend_j(&line, &args);
            mb_jappend(&line, STR_PTR("=>"), STR_LEN("=>"));
            mb_slice_head(mb_jp(&output), output.len, 300, &output);
            mb_jappend_j(&line, &output);
        } else if mb_s_eq(&ty, STR_PTR("plan"), STR_LEN("plan")) {
            mb_jappend(&line, STR_PTR("plan:"), STR_LEN("plan:"));
            let plan: u64 = mb_g_node(m, STR_PTR("plan"), STR_LEN("plan"));
            if plan != 0 && mb_kind(plan) == MB_JK_ARRAY {
                let pc: u64 = mb_n_count(plan);
                let pi: u64 = 0;
                while pi < pc {
                    if pi > 0 { mb_jpush(&line, 124); };
                    let e: u64 = mb_a_at(plan, pi);
                    let step = MbJson { bytes: [0u8; 262144], len: 0 };
                    mb_plan_step_text(e, &step);
                    mb_slice_head(mb_jp(&step), step.len, 80, &step);
                    mb_jappend_j(&line, &step);
                    mb_jpush(&line, 58);
                    let status = MbStr { bytes: [0u8; 8192], len: 0 };
                    if e != 0 { let ok3: bool = mb_g_str(e, STR_PTR("status"), STR_LEN("status"), &status); };
                    mb_jappend_s(&line, &status);
                    pi = pi + 1;
                }
            };
        } else if mb_s_eq(&ty, STR_PTR("agentMessage"), STR_LEN("agentMessage")) {
            let text = MbJson { bytes: [0u8; 262144], len: 0 };
            mb_json_scalar_text(mb_g_node(m, STR_PTR("text"), STR_LEN("text")), &text);
            mb_jappend(&line, STR_PTR("msg:"), STR_LEN("msg:"));
            mb_slice_head(mb_jp(&text), text.len, 200, &text);
            mb_jappend_j(&line, &text);
        } else { continue; };
        if !first { mb_jpush(&parts, 10); };
        first = false;
        mb_jappend_j(&parts, &line);
    }
    mb_slice_head(mb_jp(&parts), parts.len, 4000, out);
}
fn miniGoalToolFingerprint(messages: u64, turn_p: ptr, turn_n: u64, out: &MbStr) -> void {
    out.len = 0;
    if messages == 0 || mb_kind(messages) != MB_JK_ARRAY { return; };
    let parts = MbJson { bytes: [0u8; 262144], len: 0 };
    let count: u64 = mb_n_count(messages);
    let i: u64 = 0;
    let first: bool = true;
    while i < count {
        let m: u64 = mb_a_at(messages, i);
        i = i + 1;
        if m == 0 || mb_kind(m) != MB_JK_OBJECT { continue; };
        let tid = MbStr { bytes: [0u8; 8192], len: 0 };
        let has_tid: bool = mb_g_str(m, STR_PTR("turnId"), STR_LEN("turnId"), &tid);
        if !has_tid {
            let tid_txt = MbJson { bytes: [0u8; 262144], len: 0 };
            let ok: bool = mb_g_str_j(m, STR_PTR("turnId"), STR_LEN("turnId"), &tid_txt);
            mb_sassign_j(&tid, &tid_txt);
        };
        if !mb_bytes_eq(mb_sp(&tid), tid.len, turn_p, turn_n) { continue; };
        let ty = MbStr { bytes: [0u8; 8192], len: 0 };
        let ok2: bool = mb_g_str(m, STR_PTR("type"), STR_LEN("type"), &ty);
        let line = MbJson { bytes: [0u8; 262144], len: 0 };
        if mb_s_eq(&ty, STR_PTR("toolCall"), STR_LEN("toolCall")) {
            let name = MbStr { bytes: [0u8; 8192], len: 0 };
            if !mb_g_str(m, STR_PTR("name"), STR_LEN("name"), &name) { mb_sassign(&name, STR_PTR("tool"), STR_LEN("tool")); };
            let args = MbJson { bytes: [0u8; 262144], len: 0 };
            mb_json_scalar_text(mb_g_node(m, STR_PTR("arguments"), STR_LEN("arguments")), &args);
            let output = MbJson { bytes: [0u8; 262144], len: 0 };
            mb_json_scalar_text(mb_g_node(m, STR_PTR("output"), STR_LEN("output")), &output);
            mb_jappend(&line, STR_PTR("tool:"), STR_LEN("tool:"));
            mb_jappend_s(&line, &name);
            mb_jpush(&line, 58);
            mb_slice_head(mb_jp(&args), args.len, 200, &args);
            mb_jappend_j(&line, &args);
            mb_jappend(&line, STR_PTR("=>"), STR_LEN("=>"));
            mb_slice_head(mb_jp(&output), output.len, 300, &output);
            mb_jappend_j(&line, &output);
        } else if mb_s_eq(&ty, STR_PTR("plan"), STR_LEN("plan")) {
            mb_jappend(&line, STR_PTR("plan:"), STR_LEN("plan:"));
            let plan: u64 = mb_g_node(m, STR_PTR("plan"), STR_LEN("plan"));
            if plan != 0 && mb_kind(plan) == MB_JK_ARRAY {
                let pc: u64 = mb_n_count(plan);
                let pi: u64 = 0;
                while pi < pc {
                    if pi > 0 { mb_jpush(&line, 124); };
                    let e: u64 = mb_a_at(plan, pi);
                    let step = MbJson { bytes: [0u8; 262144], len: 0 };
                    mb_plan_step_text(e, &step);
                    mb_slice_head(mb_jp(&step), step.len, 80, &step);
                    mb_jappend_j(&line, &step);
                    mb_jpush(&line, 58);
                    let status = MbStr { bytes: [0u8; 8192], len: 0 };
                    if e != 0 { let ok3: bool = mb_g_str(e, STR_PTR("status"), STR_LEN("status"), &status); };
                    mb_jappend_s(&line, &status);
                    pi = pi + 1;
                }
            };
        } else { continue; };
        if !first { mb_jpush(&parts, 10); };
        first = false;
        mb_jappend_j(&parts, &line);
    }
    if parts.len == 0 { return; };
    let hex: [u8; 40] = [0u8; 40];
    let hp: ptr = PTR_NULL();
    PTR_BYTE_ADD(hp, &hex, 0);
    let hlen: u64 = 0;
    mb_sha1_hex(mb_jp(&parts), parts.len, hp, &hlen);
    mb_sassign(out, hp, 16);
}
fn noteMiniGoalTurnProgress(session: u64, fp_p: ptr, fp_n: u64, tool_p: ptr, tool_n: u64, has_tool: bool) -> bool {
    let recent: u64 = mb_g_node(session, STR_PTR("goalRecentToolFingerprints"), STR_LEN("goalRecentToolFingerprints"));
    let last = MbJson { bytes: [0u8; 262144], len: 0 };
    let has_last: bool = mb_g_str_j(session, STR_PTR("goalLastFingerprint"), STR_LEN("goalLastFingerprint"), &last);
    let repeated_whole: bool = fp_n > 0 && has_last && mb_bytes_eq(mb_jp(&last), last.len, fp_p, fp_n);
    let repeated_work: bool = false;
    if has_tool {
        if tool_n == 0 { repeated_work = true; } else if mb_str_in_arr(recent, tool_p, tool_n, false) { repeated_work = true; };
    };
    let stagnant: f64 = 0.0;
    let has_stag: bool = mb_g_f64(session, STR_PTR("goalStagnantTurns"), STR_LEN("goalStagnantTurns"), &stagnant);
    let cur: i64 = mb_floor_f64(stagnant);
    if repeated_whole || repeated_work { cur = cur + 1; } else { cur = 0; };
    let rc: i32 = mb_s_i64(session, STR_PTR("goalStagnantTurns"), STR_LEN("goalStagnantTurns"), cur);
    rc = mb_s_str(session, STR_PTR("goalLastFingerprint"), STR_LEN("goalLastFingerprint"), fp_p, fp_n);
    if has_tool && tool_n > 0 {
        let next: u64 = mb_new_arr();
        if recent != 0 && mb_kind(recent) == MB_JK_ARRAY {
            let cnt: u64 = mb_n_count(recent);
            let start: u64 = 0;
            if cnt >= 6 { start = cnt - 5; };
            let i: u64 = start;
            while i < cnt {
                let s = MbStr { bytes: [0u8; 8192], len: 0 };
                if mb_n_str(mb_a_at(recent, i), &s) { let rc2: i32 = mb_a_push_str(next, mb_sp(&s), s.len); };
                i = i + 1;
            }
        };
        let rc3: i32 = mb_a_push_str(next, tool_p, tool_n);
        rc = mb_s_node(session, STR_PTR("goalRecentToolFingerprints"), STR_LEN("goalRecentToolFingerprints"), next);
    };
    return cur >= 3;
}

// ================= TS 655-1344: effort, usage, history, chains =================
// miniTaskIntent.sla carries MINI_SHORT_TASK_RULE only as a comment (its
// registered seam); the bridge is the consumer, so the const lives here
// with the verbatim TS value.
const MINI_SHORT_TASK_RULE = "Treat concise development tasks, feature names, and answers to your previous question as sufficient direction. Use the latest request together with relevant conversation context to infer reasonable details from the codebase; do not claim there is no requirement merely because the user omitted an implementation verb. Preserve explicit explanation-only requests and ask a targeted question only for a concrete ambiguity or blocker that cannot safely be resolved from context.";
const MINI_HISTORY_OMIT_MARKER = "\n[... middle history omitted for length ...]\n";

fn normalizeMiniEffort(node: u64, out: &MbStr, out_has: &bool) -> void {
    out.len = 0;
    *out_has = false;
    let raw = MbStr { bytes: [0u8; 8192], len: 0 };
    if !mb_n_str(node, &raw) { return; };
    let t = MbStr { bytes: [0u8; 8192], len: 0 };
    mb_trim_to(mb_sp(&raw), raw.len, &t);
    let low = MbStr { bytes: [0u8; 8192], len: 0 };
    mb_lower_into(mb_sp(&t), t.len, &low);
    if low.len == 0 || low.len > 64 { return; };
    if mb_s_eq(&low, STR_PTR("extra-high"), STR_LEN("extra-high")) || mb_s_eq(&low, STR_PTR("extra_high"), STR_LEN("extra_high")) || mb_s_eq(&low, STR_PTR("x-high"), STR_LEN("x-high")) {
        mb_sassign(out, STR_PTR("xhigh"), STR_LEN("xhigh"));
        *out_has = true;
        return;
    };
    if mb_re_test(mb_sp(&low), low.len, STR_PTR("^[a-z0-9][a-z0-9_-]*$"), STR_LEN("^[a-z0-9][a-z0-9_-]*$"), false) {
        mb_sassign(out, mb_sp(&low), low.len);
        *out_has = true;
    };
}
fn mb_effort_from(doc: u64, key: ptr, klen: u64, out: &MbStr, out_has: &bool) -> void {
    if *out_has { return; };
    let node: u64 = mb_g_node(doc, key, klen);
    if node != 0 { normalizeMiniEffort(node, out, out_has); };
}
fn extractMiniEffort(r: u64, out: &MbStr, out_has: &bool) -> void {
    out.len = 0;
    *out_has = false;
    if r == 0 { return; };
    mb_effort_from(r, STR_PTR("effort"), STR_LEN("effort"), out, out_has);
    mb_effort_from(r, STR_PTR("reasoningEffort"), STR_LEN("reasoningEffort"), out, out_has);
    mb_effort_from(r, STR_PTR("reasoning_effort"), STR_LEN("reasoning_effort"), out, out_has);
    mb_effort_from(r, STR_PTR("modelReasoningEffort"), STR_LEN("modelReasoningEffort"), out, out_has);
    mb_effort_from(r, STR_PTR("model_reasoning_effort"), STR_LEN("model_reasoning_effort"), out, out_has);
    if *out_has { return; };
    let cm: u64 = mb_g_node(r, STR_PTR("collaborationMode"), STR_LEN("collaborationMode"));
    if cm != 0 && mb_kind(cm) == MB_JK_OBJECT {
        mb_effort_from(cm, STR_PTR("reasoning_effort"), STR_LEN("reasoning_effort"), out, out_has);
        mb_effort_from(cm, STR_PTR("reasoningEffort"), STR_LEN("reasoningEffort"), out, out_has);
        mb_effort_from(cm, STR_PTR("effort"), STR_LEN("effort"), out, out_has);
        if !*out_has {
            let settings: u64 = mb_g_node(cm, STR_PTR("settings"), STR_LEN("settings"));
            if settings != 0 && mb_kind(settings) == MB_JK_OBJECT {
                mb_effort_from(settings, STR_PTR("reasoning_effort"), STR_LEN("reasoning_effort"), out, out_has);
                mb_effort_from(settings, STR_PTR("reasoningEffort"), STR_LEN("reasoningEffort"), out, out_has);
                mb_effort_from(settings, STR_PTR("effort"), STR_LEN("effort"), out, out_has);
            };
        };
    };
    if *out_has { return; };
    let config: u64 = mb_g_node(r, STR_PTR("config"), STR_LEN("config"));
    if config != 0 && mb_kind(config) == MB_JK_OBJECT {
        mb_effort_from(config, STR_PTR("model_reasoning_effort"), STR_LEN("model_reasoning_effort"), out, out_has);
        mb_effort_from(config, STR_PTR("reasoning_effort"), STR_LEN("reasoning_effort"), out, out_has);
        mb_effort_from(config, STR_PTR("reasoningEffort"), STR_LEN("reasoningEffort"), out, out_has);
    };
}
fn miniAdditionalRoots(r: u64, cwd_p: ptr, cwd_n: u64, out: &u64, out_has: &bool) -> void {
    *out = 0;
    *out_has = false;
    if r == 0 { return; };
    let raw: u64 = mb_g_node(r, STR_PTR("additionalRoots"), STR_LEN("additionalRoots"));
    let skip_first: bool = false;
    if raw == 0 || mb_kind(raw) != MB_JK_ARRAY {
        raw = mb_g_node(r, STR_PTR("runtimeWorkspaceRoots"), STR_LEN("runtimeWorkspaceRoots"));
        skip_first = true;
    };
    if raw == 0 || mb_kind(raw) != MB_JK_ARRAY { return; };
    let result: u64 = mb_new_arr();
    let count: u64 = mb_n_count(raw);
    let i: u64 = 0;
    if skip_first { i = 1; };
    while i < count {
        let s = MbStr { bytes: [0u8; 8192], len: 0 };
        if mb_n_str(mb_a_at(raw, i), &s) {
            let t = MbStr { bytes: [0u8; 8192], len: 0 };
            mb_trim_to(mb_sp(&s), s.len, &t);
            if t.len > 0 && !mb_bytes_eq(mb_sp(&t), t.len, cwd_p, cwd_n) && !mb_str_in_arr(result, mb_sp(&t), t.len, false) {
                let rc: i32 = mb_a_push_str(result, mb_sp(&t), t.len);
            };
        };
        i = i + 1;
    }
    if mb_n_count(result) == 0 { mb_free_doc(result); return; };
    *out = result;
    *out_has = true;
}
fn resolveMiniContextWindow(model_p: ptr, model_n: u64, explicit: &ModelCapabilityDescriptor, has_explicit: bool, group_cw: f64, has_group: bool, out: &i64) -> void {
    let v: f64 = 0.0;
    if resolveModelContextWindow(model_p, model_n, explicit, has_explicit, group_cw, has_group, &v) {
        *out = mb_floor_f64(v);
        return;
    };
    *out = 272000;
}
fn mb_num(node: u64, out: &i64, out_has: &bool) -> void {
    *out = 0;
    *out_has = false;
    let v: f64 = 0.0;
    if !mb_n_f64(node, &v) { return; };
    if v != v || v < 0.0 { return; };
    // Infinity guard: f64 inf casts are UB-adjacent; TS Number.isFinite gate.
    if v > 9007199254740991.0 { return; };
    *out = mb_floor_f64(v);
    *out_has = true;
}
fn mb_num_field(doc: u64, key: ptr, klen: u64, out: &i64, out_has: &bool) -> void {
    mb_num(mb_g_node(doc, key, klen), out, out_has);
}
fn mb_details_obj(doc: u64, key1: ptr, k1: u64, key2: ptr, k2: u64) -> u64 {
    let v: u64 = mb_g_node(doc, key1, k1);
    if v != 0 && mb_kind(v) == MB_JK_OBJECT { return v; };
    v = mb_g_node(doc, key2, k2);
    if v != 0 && mb_kind(v) == MB_JK_OBJECT { return v; };
    return 0;
}
fn normalizeMiniUsage(raw: u64, out: &MbJson, out_has: &bool) -> void {
    out.len = 0;
    *out_has = false;
    if raw == 0 || mb_kind(raw) != MB_JK_OBJECT { return; };
    let in_det: u64 = mb_details_obj(raw, STR_PTR("input_tokens_details"), STR_LEN("input_tokens_details"), STR_PTR("prompt_tokens_details"), STR_LEN("prompt_tokens_details"));
    let out_det: u64 = mb_details_obj(raw, STR_PTR("output_tokens_details"), STR_LEN("output_tokens_details"), STR_PTR("completion_tokens_details"), STR_LEN("completion_tokens_details"));
    let input: i64 = 0;
    let has_input: bool = false;
    mb_num_field(raw, STR_PTR("input_tokens"), STR_LEN("input_tokens"), &input, &has_input);
    if !has_input { mb_num_field(raw, STR_PTR("prompt_tokens"), STR_LEN("prompt_tokens"), &input, &has_input); };
    let output: i64 = 0;
    let has_output: bool = false;
    mb_num_field(raw, STR_PTR("output_tokens"), STR_LEN("output_tokens"), &output, &has_output);
    if !has_output { mb_num_field(raw, STR_PTR("completion_tokens"), STR_LEN("completion_tokens"), &output, &has_output); };
    let cached: i64 = 0;
    let has_cached: bool = false;
    if in_det != 0 { mb_num_field(in_det, STR_PTR("cached_tokens"), STR_LEN("cached_tokens"), &cached, &has_cached); };
    if !has_cached { mb_num_field(raw, STR_PTR("cached_tokens"), STR_LEN("cached_tokens"), &cached, &has_cached); };
    if !has_cached { mb_num_field(raw, STR_PTR("cache_read_input_tokens"), STR_LEN("cache_read_input_tokens"), &cached, &has_cached); };
    let cache_write: i64 = 0;
    let has_cw: bool = false;
    if in_det != 0 { mb_num_field(in_det, STR_PTR("cache_write_tokens"), STR_LEN("cache_write_tokens"), &cache_write, &has_cw); };
    if !has_cw { mb_num_field(raw, STR_PTR("cache_write_tokens"), STR_LEN("cache_write_tokens"), &cache_write, &has_cw); };
    if !has_cw { mb_num_field(raw, STR_PTR("cache_creation_input_tokens"), STR_LEN("cache_creation_input_tokens"), &cache_write, &has_cw); };
    let reasoning: i64 = 0;
    let has_reasoning: bool = false;
    if out_det != 0 { mb_num_field(out_det, STR_PTR("reasoning_tokens"), STR_LEN("reasoning_tokens"), &reasoning, &has_reasoning); };
    if !has_reasoning { mb_num_field(raw, STR_PTR("reasoning_tokens"), STR_LEN("reasoning_tokens"), &reasoning, &has_reasoning); };
    if !has_input && !has_output && !has_cached && !has_cw && !has_reasoning { return; };
    let cache_tokens: i64 = cached + cache_write;
    let pt: i64 = 0;
    let has_pt: bool = false;
    mb_num_field(raw, STR_PTR("prompt_tokens"), STR_LEN("prompt_tokens"), &pt, &has_pt);
    let anthropic: bool = !has_pt
        && mb_g_node(raw, STR_PTR("input_tokens_details"), STR_LEN("input_tokens_details")) == 0
        && mb_g_node(raw, STR_PTR("prompt_tokens_details"), STR_LEN("prompt_tokens_details")) == 0
        && (has_cached && mb_g_node(raw, STR_PTR("cache_read_input_tokens"), STR_LEN("cache_read_input_tokens")) != 0 || has_cw && mb_g_node(raw, STR_PTR("cache_creation_input_tokens"), STR_LEN("cache_creation_input_tokens")) != 0);
    // NOTE: the anthropic test above mirrors TS field-presence checks
    // (num(...) !== undefined), using raw node presence for the two cache
    // fields and has_cached/has_cw from the fallback chain — equivalent
    // for well-formed usage payloads; registered in the ledger.
    let doc: u64 = mb_new_obj();
    let final_input: i64 = 0;
    if anthropic { final_input = input + cache_tokens; } else if input > cache_tokens { final_input = input; } else { final_input = cache_tokens; };
    let rc: i32 = mb_s_i64(doc, STR_PTR("inputTokens"), STR_LEN("inputTokens"), final_input);
    let final_output: i64 = output;
    if reasoning > final_output { final_output = reasoning; };
    rc = mb_s_i64(doc, STR_PTR("outputTokens"), STR_LEN("outputTokens"), final_output);
    if has_cached { rc = mb_s_i64(doc, STR_PTR("cachedInputTokens"), STR_LEN("cachedInputTokens"), cached); };
    if has_cw { rc = mb_s_i64(doc, STR_PTR("cacheWriteInputTokens"), STR_LEN("cacheWriteInputTokens"), cache_write); };
    if has_reasoning { rc = mb_s_i64(doc, STR_PTR("reasoningOutputTokens"), STR_LEN("reasoningOutputTokens"), reasoning); };
    let st: i32 = mb_doc_to_j(doc, out);
    mb_free_doc(doc);
    *out_has = true;
}
fn estimateMiniTokens(state: &MiniTokenizerState, text_p: ptr, text_n: u64, is_string: bool) -> u64 {
    return countMiniTokens(state, text_p, text_n, is_string);
}
fn miniOverTurnBudget(thread_p: ptr, thread_n: u64, budget: i64) -> bool {
    return heuristicMiniTokens(thread_p, thread_n) > (budget as u64);
}
// lines are JSON string arrays throughout the history family.
fn mb_lines_join_len(lines: u64) -> u64 {
    if lines == 0 || mb_kind(lines) != MB_JK_ARRAY { return 0; };
    let count: u64 = mb_n_count(lines);
    let total: u64 = 0;
    let i: u64 = 0;
    while i < count {
        let s = MbStr { bytes: [0u8; 8192], len: 0 };
        let node: u64 = mb_a_at(lines, i);
        if mb_n_str(node, &s) { total = total + s.len + 1; } else {
            let t = MbJson { bytes: [0u8; 262144], len: 0 };
            mb_json_scalar_text(node, &t);
            total = total + t.len + 1;
        };
        i = i + 1;
    }
    if total > 0 { total = total - 1; };
    return total;
}
fn mb_lines_join(lines: u64, out: &MbJson) -> void {
    out.len = 0;
    if lines == 0 || mb_kind(lines) != MB_JK_ARRAY { return; };
    let count: u64 = mb_n_count(lines);
    let i: u64 = 0;
    while i < count {
        if i > 0 { mb_jpush(out, 10); };
        let node: u64 = mb_a_at(lines, i);
        let s = MbStr { bytes: [0u8; 8192], len: 0 };
        if mb_n_str(node, &s) { mb_jappend_s(out, &s); } else {
            let t = MbJson { bytes: [0u8; 262144], len: 0 };
            mb_json_scalar_text(node, &t);
            mb_jappend_j(out, &t);
        };
        i = i + 1;
    }
}
fn mb_line_at(lines: u64, idx: u64, out: &MbJson) -> void {
    out.len = 0;
    let node: u64 = mb_a_at(lines, idx);
    if node == 0 { return; };
    if !mb_n_str_j(node, out) { mb_json_scalar_text(node, out); };
}
fn headTailHistoryText(lines: u64, max_chars: i64, out: &MbJson) -> void {
    out.len = 0;
    if lines == 0 || mb_kind(lines) != MB_JK_ARRAY { return; };
    let full_len: u64 = mb_lines_join_len(lines);
    if full_len <= (max_chars as u64) { mb_lines_join(lines, out); return; };
    let count: u64 = mb_n_count(lines);
    let head = MbJson { bytes: [0u8; 262144], len: 0 };
    let head_count: u64 = 0;
    let hi: u64 = 0;
    while hi < count {
        let line = MbJson { bytes: [0u8; 262144], len: 0 };
        mb_line_at(lines, hi, &line);
        if head.len + line.len + 1 > 6000 { break; };
        if head.len > 0 { mb_jpush(&head, 10); };
        mb_jappend_j(&head, &line);
        head_count = head_count + 1;
        hi = hi + 1;
    }
    let marker_len: u64 = STR_LEN("\n[... middle history omitted for length ...]\n");
    let tail_budget: i64 = max_chars - (head.len as i64) - (marker_len as i64);
    if tail_budget < 0 { tail_budget = 0; };
    let tail = MbJson { bytes: [0u8; 262144], len: 0 };
    let tail_len: u64 = 0;
    let ti: u64 = count;
    while ti > head_count {
        ti = ti - 1;
        let line = MbJson { bytes: [0u8; 262144], len: 0 };
        mb_line_at(lines, ti, &line);
        if tail_len + line.len + 1 > (tail_budget as u64) { break; };
        if tail.len > 0 {
            let merged = MbJson { bytes: [0u8; 262144], len: 0 };
            mb_jappend_j(&merged, &line);
            mb_jpush(&merged, 10);
            mb_jappend_j(&merged, &tail);
            mb_jassign_j(&tail, &merged);
        } else { mb_jassign_j(&tail, &line); };
        tail_len = tail_len + line.len + 1;
    }
    if tail.len == 0 {
        mb_slice_head(mb_jp(&head), head.len, max_chars as u64, out);
        return;
    };
    mb_jappend_j(out, &head);
    mb_jappend(out, STR_PTR("\n[... middle history omitted for length ...]\n"), STR_LEN("\n[... middle history omitted for length ...]\n"));
    mb_jappend_j(out, &tail);
}
fn miniHistoryBudgetChars(context_window: i64) -> i64 {
    let w: i64 = context_window;
    if w <= 0 { w = 128000; };
    let v: i64 = w;
    if v < 24000 { v = 24000; };
    if v > 256000 { v = 256000; };
    return v;
}
fn splitHistoryForSummary(lines: u64, tail_chars: i64, out_older: &u64, out_tail: &u64) -> void {
    *out_older = mb_new_arr();
    *out_tail = mb_new_arr();
    if lines == 0 || mb_kind(lines) != MB_JK_ARRAY { return; };
    let count: u64 = mb_n_count(lines);
    let tail_len: u64 = 0;
    let i: u64 = count;
    while i > 0 {
        let line = MbJson { bytes: [0u8; 262144], len: 0 };
        mb_line_at(lines, i - 1, &line);
        if tail_len > 0 && tail_len + line.len + 1 > (tail_chars as u64) { break; };
        tail_len = tail_len + line.len + 1;
        i = i - 1;
    }
    let k: u64 = 0;
    while k < count {
        let node: u64 = mb_clone_node(mb_a_at(lines, k));
        if k < i { let rc: i32 = mb_a_push_node(*out_older, node); } else { let rc: i32 = mb_a_push_node(*out_tail, node); };
        k = k + 1;
    }
}
fn miniHistoryNeedsSummary(lines: u64, budget_chars: i64) -> bool {
    let joined: u64 = mb_lines_join_len(lines);
    return (joined as f64) > (budget_chars as f64) * 0.85;
}
fn mb_is_continuation_line(p: ptr, n: u64) -> bool {
    return mb_starts_with(p, n, STR_PTR("goal-continuation:"), STR_LEN("goal-continuation:"));
}
fn miniHistoryAnchor(older: u64, out: &u64) -> void {
    *out = mb_new_arr();
    if older == 0 || mb_kind(older) != MB_JK_ARRAY { return; };
    let stable: u64 = mb_new_arr();
    let count: u64 = mb_n_count(older);
    let i: u64 = 0;
    while i < count {
        let line = MbJson { bytes: [0u8; 262144], len: 0 };
        mb_line_at(older, i, &line);
        if !mb_is_continuation_line(mb_jp(&line), line.len) {
            let rc: i32 = mb_a_push_str(stable, mb_jp(&line), line.len);
        };
        i = i + 1;
    }
    let sc: u64 = mb_n_count(stable);
    let start: u64 = 0;
    if sc > 3 { start = sc - 3; };
    let k: u64 = start;
    while k < sc {
        let s = MbStr { bytes: [0u8; 8192], len: 0 };
        if mb_n_str(mb_a_at(stable, k), &s) { let rc: i32 = mb_a_push_str(*out, mb_sp(&s), s.len); };
        k = k + 1;
    }
    mb_free_doc(stable);
}
fn locateMiniHistoryAnchor(older: u64, anchor: u64) -> i64 {
    if anchor == 0 || mb_kind(anchor) != MB_JK_ARRAY || mb_n_count(anchor) == 0 { return -1; };
    if older == 0 || mb_kind(older) != MB_JK_ARRAY { return -1; };
    let ac: u64 = mb_n_count(anchor);
    let count: u64 = mb_n_count(older);
    // stable entries: (line, original index)
    let stable_lines: u64 = mb_new_arr();
    let stable_idx: u64 = mb_new_arr();
    let i: u64 = 0;
    while i < count {
        let line = MbJson { bytes: [0u8; 262144], len: 0 };
        mb_line_at(older, i, &line);
        if !mb_is_continuation_line(mb_jp(&line), line.len) {
            let rc: i32 = mb_a_push_str(stable_lines, mb_jp(&line), line.len);
            rc = mb_a_push_i64(stable_idx, i as i64);
        };
        i = i + 1;
    }
    let sc: u64 = mb_n_count(stable_lines);
    let result: i64 = -1;
    let end: u64 = ac;
    while end <= sc && result < 0 {
        let hit: bool = true;
        let k: u64 = 0;
        while k < ac {
            let a = MbStr { bytes: [0u8; 8192], len: 0 };
            let b = MbStr { bytes: [0u8; 8192], len: 0 };
            let oka: bool = mb_n_str(mb_a_at(stable_lines, end - ac + k), &a);
            let okb: bool = mb_n_str(mb_a_at(anchor, k), &b);
            if !mb_s_eq_s(&a, &b) { hit = false; };
            k = k + 1;
        }
        if hit {
            let iv: i64 = 0;
            let ok: bool = mb_n_i64(mb_a_at(stable_idx, end - 1), &iv);
            result = iv + 1;
        };
        end = end + 1;
    }
    mb_free_doc(stable_lines);
    mb_free_doc(stable_idx);
    return result;
}
fn buildMiniHistorySummaryAsk(prev_p: ptr, prev_n: u64, output_chars: i64, out: &MbJson) -> void {
    out.len = 0;
    mb_jappend(out, STR_PTR("You are writing a CONTEXT CHECKPOINT handoff summary of earlier coding-agent history for the agent that continues the task."), STR_LEN("You are writing a CONTEXT CHECKPOINT handoff summary of earlier coding-agent history for the agent that continues the task."));
    if prev_n > 0 {
        mb_jpush(out, 10);
        mb_jappend(out, STR_PTR("Merge the previous summary with the new history into ONE updated summary; keep everything from the previous summary that still matters."), STR_LEN("Merge the previous summary with the new history into ONE updated summary; keep everything from the previous summary that still matters."));
    };
    mb_jpush(out, 10);
    mb_jappend(out, STR_PTR("Use exactly these sections, terse bullets, no prose intro:"), STR_LEN("Use exactly these sections, terse bullets, no prose intro:"));
    mb_jpush(out, 10);
    mb_jappend(out, STR_PTR("- GOALS: user goals and hard constraints."), STR_LEN("- GOALS: user goals and hard constraints."));
    mb_jpush(out, 10);
    mb_jappend(out, STR_PTR("- TOUCHED: every file read or changed as `path` plus line ranges touched and one-line outcome each (e.g. `src/a.ts L10-L40 edited ok`, `src/b.ts L5-L9 read`)."), STR_LEN("- TOUCHED: every file read or changed as `path` plus line ranges touched and one-line outcome each (e.g. `src/a.ts L10-L40 edited ok`, `src/b.ts L5-L9 read`)."));
    mb_jpush(out, 10);
    mb_jappend(out, STR_PTR("- ERRORS: open diagnostics quoted VERBATIM as `path Lline:Ccol message` lines — never paraphrase error text."), STR_LEN("- ERRORS: open diagnostics quoted VERBATIM as `path Lline:Ccol message` lines — never paraphrase error text."));
    mb_jpush(out, 10);
    mb_jappend(out, STR_PTR("- PLAN: task-plan checklist with each step's status."), STR_LEN("- PLAN: task-plan checklist with each step's status."));
    mb_jpush(out, 10);
    mb_jappend(out, STR_PTR("- NEXT: clear next steps, including exact pending edit anchors (file + old_text snippet) when known."), STR_LEN("- NEXT: clear next steps, including exact pending edit anchors (file + old_text snippet) when known."));
    mb_jpush(out, 10);
    mb_jappend(out, STR_PTR("- AVOID: approaches already tried that failed — do not retry these."), STR_LEN("- AVOID: approaches already tried that failed — do not retry these."));
    mb_jpush(out, 10);
    mb_jappend(out, STR_PTR("At most "), STR_LEN("At most "));
    let num = MbStr { bytes: [0u8; 8192], len: 0 };
    mb_i64_to_s(output_chars, &num);
    mb_jappend_s(out, &num);
    mb_jappend(out, STR_PTR(" characters. Nothing the next turn needs may be dropped; when in doubt keep exact paths, line numbers, and error text over prose."), STR_LEN(" characters. Nothing the next turn needs may be dropped; when in doubt keep exact paths, line numbers, and error text over prose."));
}
// Plan object: {kind:"reuse", summary, carry[]} | {kind:"summarize", base, pending[]}
fn planMiniHistorySummary(older: u64, cache: u64, carry_budget: i64, out: &MbJson) -> void {
    let plan: u64 = mb_new_obj();
    let at: i64 = -1;
    let summary = MbJson { bytes: [0u8; 262144], len: 0 };
    if cache != 0 {
        let anchor: u64 = mb_g_node(cache, STR_PTR("anchor"), STR_LEN("anchor"));
        at = locateMiniHistoryAnchor(older, anchor);
        let ok: bool = mb_g_str_j(cache, STR_PTR("summary"), STR_LEN("summary"), &summary);
    };
    if cache != 0 && at >= 0 {
        let pending: u64 = mb_new_arr();
        let count: u64 = 0;
        if older != 0 { count = mb_n_count(older); };
        let i: u64 = at as u64;
        while i < count {
            let rc: i32 = mb_a_push_node(pending, mb_clone_node(mb_a_at(older, i)));
            i = i + 1;
        }
        if (mb_lines_join_len(pending) as i64) <= carry_budget {
            let rc: i32 = mb_s_str(plan, STR_PTR("kind"), STR_LEN("kind"), STR_PTR("reuse"), STR_LEN("reuse"));
            rc = mb_s_str(plan, STR_PTR("summary"), STR_LEN("summary"), mb_jp(&summary), summary.len);
            rc = mb_s_node(plan, STR_PTR("carry"), STR_LEN("carry"), pending);
        } else {
            let rc: i32 = mb_s_str(plan, STR_PTR("kind"), STR_LEN("kind"), STR_PTR("summarize"), STR_LEN("summarize"));
            rc = mb_s_str(plan, STR_PTR("base"), STR_LEN("base"), mb_jp(&summary), summary.len);
            rc = mb_s_node(plan, STR_PTR("pending"), STR_LEN("pending"), pending);
        };
    } else {
        let rc: i32 = mb_s_str(plan, STR_PTR("kind"), STR_LEN("kind"), STR_PTR("summarize"), STR_LEN("summarize"));
        rc = mb_s_str(plan, STR_PTR("base"), STR_LEN("base"), STR_PTR(""), STR_LEN(""));
        if older != 0 { rc = mb_s_node(plan, STR_PTR("pending"), STR_LEN("pending"), mb_clone_node(older)); } else { let empty: u64 = mb_new_arr(); rc = mb_s_node(plan, STR_PTR("pending"), STR_LEN("pending"), empty); };
    };
    let st: i32 = mb_doc_to_j(plan, out);
    mb_free_doc(plan);
}
fn mb_cap_line(line_p: ptr, line_n: u64, cap: u64, out: &MbJson) -> void {
    out.len = 0;
    if cap > 0 && line_n > cap {
        mb_slice_head(line_p, line_n, cap, out);
        mb_jappend(out, STR_PTR("…"), STR_LEN("…"));
        return;
    };
    mb_jassign(out, line_p, line_n);
}
fn chunkMiniSummaryInput(pending: u64, max_chars: i64, max_chunks: i64, out: &u64) -> void {
    *out = mb_new_arr();
    if pending == 0 || mb_kind(pending) != MB_JK_ARRAY { return; };
    let count: u64 = mb_n_count(pending);
    let caps: [u64; 5] = [0; 5];
    caps[1] = 1200;
    caps[2] = 600;
    caps[3] = 300;
    caps[4] = 160;
    let last_chunks: u64 = 0;
    let ci: u64 = 0;
    while ci < 5 {
        let cap: u64 = caps[ci];
        ci = ci + 1;
        // skip this cap level when any (capped) line still exceeds maxChars
        let any_over: bool = false;
        let li: u64 = 0;
        while li < count {
            let line = MbJson { bytes: [0u8; 262144], len: 0 };
            mb_line_at(pending, li, &line);
            let capped = MbJson { bytes: [0u8; 262144], len: 0 };
            mb_cap_line(mb_jp(&line), line.len, cap, &capped);
            if capped.len > (max_chars as u64) { any_over = true; };
            li = li + 1;
        }
        if any_over { continue; };
        let chunks: u64 = mb_new_arr();
        let cur = MbJson { bytes: [0u8; 262144], len: 0 };
        let li2: u64 = 0;
        while li2 < count {
            let line = MbJson { bytes: [0u8; 262144], len: 0 };
            mb_line_at(pending, li2, &line);
            let capped = MbJson { bytes: [0u8; 262144], len: 0 };
            mb_cap_line(mb_jp(&line), line.len, cap, &capped);
            if cur.len > 0 && cur.len + 1 + capped.len > (max_chars as u64) {
                let rc: i32 = mb_a_push_str(chunks, mb_jp(&cur), cur.len);
                mb_jassign_j(&cur, &capped);
            } else {
                if cur.len > 0 { mb_jpush(&cur, 10); };
                mb_jappend_j(&cur, &capped);
            };
            li2 = li2 + 1;
        }
        if cur.len > 0 { let rc: i32 = mb_a_push_str(chunks, mb_jp(&cur), cur.len); };
        if last_chunks != 0 { mb_free_doc(last_chunks); };
        last_chunks = chunks;
        if (mb_n_count(chunks) as i64) <= max_chunks {
            *out = chunks;
            return;
        };
    }
    if last_chunks != 0 && (mb_n_count(last_chunks) as i64) > max_chunks {
        let result: u64 = mb_new_arr();
        let total: u64 = mb_n_count(last_chunks);
        let first = MbStr { bytes: [0u8; 8192], len: 0 };
        // chunks can exceed MbStr; carry via MbJson slices instead.
        let head = MbJson { bytes: [0u8; 262144], len: 0 };
        let okh: bool = mb_n_str_j(mb_a_at(last_chunks, 0), &head);
        let rc: i32 = mb_a_push_str(result, mb_jp(&head), head.len);
        let keep_from: u64 = 0;
        if total > (max_chunks as u64) { keep_from = total - ((max_chunks as u64) - 1); };
        let i: u64 = keep_from;
        while i < total {
            let c = MbJson { bytes: [0u8; 262144], len: 0 };
            let ok: bool = mb_n_str_j(mb_a_at(last_chunks, i), &c);
            let rc2: i32 = mb_a_push_str(result, mb_jp(&c), c.len);
            i = i + 1;
        }
        mb_free_doc(last_chunks);
        *out = result;
        return;
    };
    if last_chunks != 0 { *out = last_chunks; };
}
fn pinMiniHistoryUserLines(lines: u64, budget_chars: i64, out: &u64) -> void {
    *out = mb_new_arr();
    if lines == 0 || mb_kind(lines) != MB_JK_ARRAY || budget_chars <= 0 { return; };
    // Collect user lines (index, text) into parallel arrays.
    let idxs: u64 = mb_new_arr();
    let texts: u64 = mb_new_arr();
    let count: u64 = mb_n_count(lines);
    let i: u64 = 0;
    while i < count {
        let line = MbJson { bytes: [0u8; 262144], len: 0 };
        mb_line_at(lines, i, &line);
        if mb_starts_with(mb_jp(&line), line.len, STR_PTR("user: "), STR_LEN("user: ")) {
            let rc: i32 = mb_a_push_i64(idxs, i as i64);
            rc = mb_a_push_str(texts, mb_jp(&line), line.len);
        };
        i = i + 1;
    }
    let uc: u64 = mb_n_count(idxs);
    if uc == 0 { mb_free_doc(idxs); mb_free_doc(texts); return; };
    let first_text = MbJson { bytes: [0u8; 262144], len: 0 };
    let okf: bool = mb_n_str_j(mb_a_at(texts, 0), &first_text);
    if first_text.len > 2000 {
        let cut = MbJson { bytes: [0u8; 262144], len: 0 };
        mb_slice_head(mb_jp(&first_text), first_text.len, 2000, &cut);
        mb_jappend(&cut, STR_PTR("…"), STR_LEN("…"));
        mb_jassign_j(&first_text, &cut);
    };
    // picked entries as JSON objects {index, text}, newest-first scan.
    let picked: u64 = mb_new_arr();
    let used: u64 = first_text.len + 1;
    let k: u64 = uc;
    while k > 1 {
        k = k - 1;
        let room: i64 = budget_chars - (used as i64);
        if room <= 0 { break; };
        let line = MbJson { bytes: [0u8; 262144], len: 0 };
        let ok: bool = mb_n_str_j(mb_a_at(texts, k), &line);
        let text = MbJson { bytes: [0u8; 262144], len: 0 };
        if line.len > (room as u64) {
            mb_slice_head(mb_jp(&line), line.len, room as u64, &text);
            mb_jappend(&text, STR_PTR("…"), STR_LEN("…"));
        } else { mb_jassign_j(&text, &line); };
        let entry: u64 = mb_new_obj();
        let idx_v: i64 = 0;
        let oki: bool = mb_n_i64(mb_a_at(idxs, k), &idx_v);
        let rc: i32 = mb_s_i64(entry, STR_PTR("index"), STR_LEN("index"), idx_v);
        rc = mb_s_str(entry, STR_PTR("text"), STR_LEN("text"), mb_jp(&text), text.len);
        rc = mb_a_push_node(picked, entry);
        used = used + text.len + 1;
        if line.len > (room as u64) { break; };
    }
    let first_entry: u64 = mb_new_obj();
    let first_idx: i64 = 0;
    let okfi: bool = mb_n_i64(mb_a_at(idxs, 0), &first_idx);
    let rc: i32 = mb_s_i64(first_entry, STR_PTR("index"), STR_LEN("index"), first_idx);
    rc = mb_s_str(first_entry, STR_PTR("text"), STR_LEN("text"), mb_jp(&first_text), first_text.len);
    rc = mb_a_push_node(picked, first_entry);
    // Sort picked by index ascending (insertion sort; small arrays).
    let pc: u64 = mb_n_count(picked);
    let a: u64 = 1;
    while a < pc {
        let b: u64 = a;
        while b > 0 {
            let x: i64 = 0;
            let y: i64 = 0;
            let okx: bool = mb_g_i64(mb_a_at(picked, b - 1), STR_PTR("index"), STR_LEN("index"), &x);
            let oky: bool = mb_g_i64(mb_a_at(picked, b), STR_PTR("index"), STR_LEN("index"), &y);
            if x <= y { break; };
            // swap via rebuild (JSON arrays have no set-at in this surface;
            // use remove+insert emulation through a fresh array)
            let swapped: u64 = mb_new_arr();
            let si: u64 = 0;
            while si < pc {
                let src: u64 = mb_a_at(picked, si);
                if si == b - 1 { src = mb_a_at(picked, b); } else if si == b { src = mb_a_at(picked, b - 1); };
                let rc2: i32 = mb_a_push_node(swapped, mb_clone_node(src));
                si = si + 1;
            }
            mb_free_doc(picked);
            picked = swapped;
            b = b - 1;
        }
        a = a + 1;
    }
    let pi: u64 = 0;
    while pi < pc {
        let t = MbJson { bytes: [0u8; 262144], len: 0 };
        let ok: bool = mb_g_str_j(mb_a_at(picked, pi), STR_PTR("text"), STR_LEN("text"), &t);
        let rc2: i32 = mb_a_push_str(*out, mb_jp(&t), t.len);
        pi = pi + 1;
    }
    mb_free_doc(idxs);
    mb_free_doc(texts);
    mb_free_doc(picked);
}
fn assembleMiniSummarizedHistory(summary_p: ptr, summary_n: u64, pinned: u64, carry: u64, tail: u64, out: &u64) -> void {
    *out = mb_new_arr();
    let head = MbJson { bytes: [0u8; 262144], len: 0 };
    mb_jappend(&head, STR_PTR("[earlier history summary]\n"), STR_LEN("[earlier history summary]\n"));
    mb_jappend(&head, summary_p, summary_n);
    let rc: i32 = mb_a_push_str(*out, mb_jp(&head), head.len);
    if pinned != 0 && mb_n_count(pinned) > 0 {
        let joined = MbJson { bytes: [0u8; 262144], len: 0 };
        mb_lines_join(pinned, &joined);
        let block = MbJson { bytes: [0u8; 262144], len: 0 };
        mb_jappend(&block, STR_PTR("[earlier user messages, verbatim - already covered, background context]\n"), STR_LEN("[earlier user messages, verbatim - already covered, background context]\n"));
        mb_jappend_j(&block, &joined);
        rc = mb_a_push_str(*out, mb_jp(&block), block.len);
    };
    if carry != 0 {
        let cc: u64 = mb_n_count(carry);
        let i: u64 = 0;
        while i < cc { let line = MbJson { bytes: [0u8; 262144], len: 0 }; mb_line_at(carry, i, &line); rc = mb_a_push_str(*out, mb_jp(&line), line.len); i = i + 1; }
    };
    if tail != 0 {
        let tc: u64 = mb_n_count(tail);
        let i: u64 = 0;
        while i < tc { let line = MbJson { bytes: [0u8; 262144], len: 0 }; mb_line_at(tail, i, &line); rc = mb_a_push_str(*out, mb_jp(&line), line.len); i = i + 1; }
    };
}
fn formatMiniLiveTurnPrompt(prompt_p: ptr, prompt_n: u64, has_history: bool, out: &MbJson) -> void {
    out.len = 0;
    if !has_history {
        mb_jappend(out, prompt_p, prompt_n);
        mb_jappend(out, STR_PTR("\n\n[Task context: "), STR_LEN("\n\n[Task context: "));
        mb_jappend(out, STR_PTR(MINI_SHORT_TASK_RULE), STR_LEN(MINI_SHORT_TASK_RULE));
        mb_jappend(out, STR_PTR("]\n[Language: write the final answer in the same language as the ACTIVE task above (e.g. Chinese task → Simplified Chinese answer unless the user explicitly asks otherwise).]"), STR_LEN("]\n[Language: write the final answer in the same language as the ACTIVE task above (e.g. Chinese task → Simplified Chinese answer unless the user explicitly asks otherwise).]"));
        return;
    };
    mb_jappend(out, STR_PTR("[ACTIVE USER TASK - CURRENT TURN ONLY]:\n"), STR_LEN("[ACTIVE USER TASK - CURRENT TURN ONLY]:\n"));
    mb_jappend(out, prompt_p, prompt_n);
    mb_jappend(out, STR_PTR("\n\n[Task context]:\n- The above request is the user's active task for this turn.\n- Conversation history provides context and verified progress, not a new execution request.\n- Use history to interpret references and answers to the previous assistant question; do not detach a concise follow-up from that question or revive unrelated old tasks.\n- "), STR_LEN("\n\n[Task context]:\n- The above request is the user's active task for this turn.\n- Conversation history provides context and verified progress, not a new execution request.\n- Use history to interpret references and answers to the previous assistant question; do not detach a concise follow-up from that question or revive unrelated old tasks.\n- "));
    mb_jappend(out, STR_PTR(MINI_SHORT_TASK_RULE), STR_LEN(MINI_SHORT_TASK_RULE));
    mb_jappend(out, STR_PTR("\n- Resume earlier unfinished work when the current task asks to continue it; avoid repeating completed work.\n- Focus execution on the ACTIVE task above.\n- Language: write the final answer in the same language as the ACTIVE task above (e.g. Chinese task → Simplified Chinese answer unless the user explicitly asks otherwise)."), STR_LEN("\n- Resume earlier unfinished work when the current task asks to continue it; avoid repeating completed work.\n- Focus execution on the ACTIVE task above.\n- Language: write the final answer in the same language as the ACTIVE task above (e.g. Chinese task → Simplified Chinese answer unless the user explicitly asks otherwise)."));
}
// Returns {historyBlock, recapText|null} as a JSON object text.
fn buildMiniHistoryPayload(lines: u64, protocol_p: ptr, protocol_n: u64, max_chars: i64, out: &MbJson) -> void {
    let doc: u64 = mb_new_obj();
    if lines == 0 || mb_kind(lines) != MB_JK_ARRAY || mb_n_count(lines) == 0 {
        let rc: i32 = mb_s_str(doc, STR_PTR("historyBlock"), STR_LEN("historyBlock"), STR_PTR(""), STR_LEN(""));
        rc = mb_s_null(doc, STR_PTR("recapText"), STR_LEN("recapText"));
        let st: i32 = mb_doc_to_j(doc, out);
        mb_free_doc(doc);
        return;
    };
    let hist = MbJson { bytes: [0u8; 262144], len: 0 };
    headTailHistoryText(lines, max_chars, &hist);
    let block = MbJson { bytes: [0u8; 262144], len: 0 };
    mb_jappend(&block, STR_PTR("\nConversation history so far (earlier turns for background context; the latest user message below is the current task):\n"), STR_LEN("\nConversation history so far (earlier turns for background context; the latest user message below is the current task):\n"));
    mb_jappend_j(&block, &hist);
    mb_jappend(&block, STR_PTR("\nUse verified progress from history for the current task, including unfinished work when the user asks to continue.\n"), STR_LEN("\nUse verified progress from history for the current task, including unfinished work when the user asks to continue.\n"));
    let rc: i32 = mb_s_str(doc, STR_PTR("historyBlock"), STR_LEN("historyBlock"), mb_jp(&block), block.len);
    if mb_bytes_eq(protocol_p, protocol_n, STR_PTR("responses"), STR_LEN("responses")) {
        let recap = MbJson { bytes: [0u8; 262144], len: 0 };
        mb_jappend(&recap, STR_PTR("[earlier conversation - background context only]\n"), STR_LEN("[earlier conversation - background context only]\n"));
        mb_jappend_j(&recap, &hist);
        mb_jappend(&recap, STR_PTR("\n[end of earlier conversation - continue with the task that follows]"), STR_LEN("\n[end of earlier conversation - continue with the task that follows]"));
        rc = mb_s_str(doc, STR_PTR("recapText"), STR_LEN("recapText"), mb_jp(&recap), recap.len);
    } else {
        rc = mb_s_null(doc, STR_PTR("recapText"), STR_LEN("recapText"));
    };
    let st: i32 = mb_doc_to_j(doc, out);
    mb_free_doc(doc);
}
fn miniTurnInputBudgetTokens(context_window: i64) -> i64 {
    let w: i64 = context_window;
    if w <= 0 { w = 128000; };
    let v: i64 = mb_floor_f64((w as f64) * 0.7);
    if v < 4000 { v = 4000; };
    return v;
}
fn stripMiniMemoryTailItems(items: u64, out: &u64) -> void {
    *out = mb_new_arr();
    if items == 0 || mb_kind(items) != MB_JK_ARRAY { return; };
    let count: u64 = mb_n_count(items);
    let i: u64 = 0;
    while i < count {
        let item: u64 = mb_a_at(items, i);
        let probe = MbJson { bytes: [0u8; 262144], len: 0 };
        let content: u64 = 0;
        if item != 0 { content = mb_g_node(item, STR_PTR("content"), STR_LEN("content")); };
        if content != 0 { let ok: bool = mb_stringify_node(content, &probe); } else if item != 0 { let ok: bool = mb_stringify_node(item, &probe); };
        if !mb_contains(mb_jp(&probe), probe.len, STR_PTR("[Background memory notes"), STR_LEN("[Background memory notes")) {
            let rc: i32 = mb_a_push_node(*out, mb_clone_node(item));
        };
        i = i + 1;
    }
}
fn mb_turn_limit_from_env(key: ptr, klen: u64, fallback: i64) -> i64 {
    let v = MbStr { bytes: [0u8; 8192], len: 0 };
    if !mb_env_get(key, klen, &v) { return fallback; };
    let t = MbStr { bytes: [0u8; 8192], len: 0 };
    mb_trim_to(mb_sp(&v), v.len, &t);
    if t.len == 0 { return fallback; };
    let n: f64 = 0.0;
    if !mb_parse_f64(mb_sp(&t), t.len, &n) { return fallback; };
    if n <= 0.0 { return fallback; };
    let f: i64 = mb_floor_f64(n);
    if f < 1 { f = 1; };
    return f;
}
// Returns {maxRounds, maxCalls} object doc.
fn resolveMiniTurnLimits(out: &u64) -> void {
    *out = mb_new_obj();
    let rc: i32 = mb_s_i64(*out, STR_PTR("maxRounds"), STR_LEN("maxRounds"), mb_turn_limit_from_env(STR_PTR("MINI_TURN_MAX_ROUNDS"), STR_LEN("MINI_TURN_MAX_ROUNDS"), 40));
    rc = mb_s_i64(*out, STR_PTR("maxCalls"), STR_LEN("maxCalls"), mb_turn_limit_from_env(STR_PTR("MINI_TURN_MAX_TOOL_CALLS"), STR_LEN("MINI_TURN_MAX_TOOL_CALLS"), 120));
}
fn miniTurnCapTripped(rounds: i64, calls: i64, limits: u64) -> bool {
    let mr: i64 = 0;
    let mc: i64 = 0;
    let ok1: bool = mb_g_i64(limits, STR_PTR("maxRounds"), STR_LEN("maxRounds"), &mr);
    let ok2: bool = mb_g_i64(limits, STR_PTR("maxCalls"), STR_LEN("maxCalls"), &mc);
    return rounds >= mr || calls >= mc;
}
// ---- responses chain (TS:1179-1290) ----
fn mb_empty_responses_chain(out: &u64) -> void {
    *out = mb_new_obj();
    let rc: i32 = mb_s_null(*out, STR_PTR("prevId"), STR_LEN("prevId"));
    rc = mb_s_str(*out, STR_PTR("sentJson"), STR_LEN("sentJson"), STR_PTR(""), STR_LEN(""));
    rc = mb_s_i64(*out, STR_PTR("sentCount"), STR_LEN("sentCount"), 0);
}
// out: {input: arr doc, previousResponseId: str|null, chained: bool} object doc.
fn resolveResponsesRoundInput(full: u64, chain: u64, out: &u64) -> void {
    *out = mb_new_obj();
    let prev = MbStr { bytes: [0u8; 8192], len: 0 };
    let has_prev: bool = chain != 0 && mb_g_str(chain, STR_PTR("prevId"), STR_LEN("prevId"), &prev) && prev.len > 0;
    let sent_count: i64 = 0;
    let has_sc: bool = chain != 0 && mb_g_i64(chain, STR_PTR("sentCount"), STR_LEN("sentCount"), &sent_count);
    let sent_json = MbJson { bytes: [0u8; 262144], len: 0 };
    if chain != 0 { let ok: bool = mb_g_str_j(chain, STR_PTR("sentJson"), STR_LEN("sentJson"), &sent_json); };
    if has_prev && sent_count > 0 && full != 0 && (mb_n_count(full) as i64) >= sent_count {
        let prefix: u64 = mb_new_arr();
        let i: u64 = 0;
        while i < (sent_count as u64) {
            let rc: i32 = mb_a_push_node(prefix, mb_clone_node(mb_a_at(full, i)));
            i = i + 1;
        }
        let prefix_text = MbJson { bytes: [0u8; 262144], len: 0 };
        let ok2: bool = mb_stringify_node(prefix, &prefix_text);
        mb_free_doc(prefix);
        if mb_bytes_eq(mb_jp(&prefix_text), prefix_text.len, mb_jp(&sent_json), sent_json.len) {
            let suffix: u64 = mb_new_arr();
            let total: u64 = mb_n_count(full);
            let k: u64 = sent_count as u64;
            while k < total {
                let rc: i32 = mb_a_push_node(suffix, mb_clone_node(mb_a_at(full, k)));
                k = k + 1;
            }
            let rc: i32 = mb_s_node(*out, STR_PTR("input"), STR_LEN("input"), suffix);
            rc = mb_s_str(*out, STR_PTR("previousResponseId"), STR_LEN("previousResponseId"), mb_sp(&prev), prev.len);
            rc = mb_s_bool(*out, STR_PTR("chained"), STR_LEN("chained"), true);
            return;
        };
    };
    let rc: i32 = mb_s_node(*out, STR_PTR("input"), STR_LEN("input"), mb_clone_node(full));
    rc = mb_s_null(*out, STR_PTR("previousResponseId"), STR_LEN("previousResponseId"));
    rc = mb_s_bool(*out, STR_PTR("chained"), STR_LEN("chained"), false);
}
fn advanceResponsesChain(full: u64, resp_p: ptr, resp_n: u64, has_resp: bool, out: &u64) -> void {
    if !has_resp || resp_n == 0 { mb_empty_responses_chain(out); return; };
    *out = mb_new_obj();
    let rc: i32 = mb_s_str(*out, STR_PTR("prevId"), STR_LEN("prevId"), resp_p, resp_n);
    let text = MbJson { bytes: [0u8; 262144], len: 0 };
    let ok: bool = full != 0 && mb_stringify_node(full, &text);
    rc = mb_s_str(*out, STR_PTR("sentJson"), STR_LEN("sentJson"), mb_jp(&text), text.len);
    let cnt: i64 = 0;
    if full != 0 { cnt = mb_n_count(full) as i64; };
    rc = mb_s_i64(*out, STR_PTR("sentCount"), STR_LEN("sentCount"), cnt);
}
fn isMiniOpenAiModel(model_p: ptr, model_n: u64, has_model: bool) -> bool {
    if !has_model { return false; };
    let t = MbStr { bytes: [0u8; 8192], len: 0 };
    mb_trim_to(model_p, model_n, &t);
    let low = MbStr { bytes: [0u8; 8192], len: 0 };
    mb_lower_into(mb_sp(&t), t.len, &low);
    // replace(/^.*\//, ""): keep text after the last '/'.
    let start: u64 = 0;
    let i: u64 = 0;
    while i < low.len { if low.bytes[i] == 47 { start = i + 1; }; i = i + 1; }
    let id = MbStr { bytes: [0u8; 8192], len: 0 };
    mb_sassign(&id, mb_ptr_add(mb_sp(&low), start), low.len - start);
    return mb_re_test(mb_sp(&id), id.len, STR_PTR("^(gpt-|chatgpt|codex-|o[1-9](-|$))"), STR_LEN("^(gpt-|chatgpt|codex-|o[1-9](-|$))"), false);
}
fn isMiniResponsesChainingTrusted(base_p: ptr, base_n: u64, model_p: ptr, model_n: u64, has_model: bool) -> bool {
    let flag = MbStr { bytes: [0u8; 8192], len: 0 };
    if mb_env_get(STR_PTR("MINI_RESPONSES_CHAINING"), STR_LEN("MINI_RESPONSES_CHAINING"), &flag) {
        let t = MbStr { bytes: [0u8; 8192], len: 0 };
        mb_trim_to(mb_sp(&flag), flag.len, &t);
        let low = MbStr { bytes: [0u8; 8192], len: 0 };
        mb_lower_into(mb_sp(&t), t.len, &low);
        if mb_s_eq(&low, STR_PTR("1"), STR_LEN("1")) || mb_s_eq(&low, STR_PTR("true"), STR_LEN("true")) || mb_s_eq(&low, STR_PTR("on"), STR_LEN("on")) { return true; };
        if mb_s_eq(&low, STR_PTR("0"), STR_LEN("0")) || mb_s_eq(&low, STR_PTR("false"), STR_LEN("false")) || mb_s_eq(&low, STR_PTR("off"), STR_LEN("off")) { return false; };
    };
    if !isMiniOpenAiModel(model_p, model_n, has_model) { return true; };
    let bt = MbStr { bytes: [0u8; 8192], len: 0 };
    mb_trim_to(base_p, base_n, &bt);
    return mb_re_test(mb_sp(&bt), bt.len, STR_PTR("^https?://api\\.openai\\.com(/|$)"), STR_LEN("^https?://api\\.openai\\.com(/|$)"), true);
}
fn isMiniStrictAssistantUpstream(base_p: ptr, base_n: u64, provider_p: ptr, provider_n: u64, group_p: ptr, group_n: u64) -> bool {
    if mb_re_test(base_p, base_n, STR_PTR("opencode\\.ai"), STR_LEN("opencode\\.ai"), true) { return true; };
    let pl = MbStr { bytes: [0u8; 8192], len: 0 };
    mb_lower_into(provider_p, provider_n, &pl);
    let gl = MbStr { bytes: [0u8; 8192], len: 0 };
    mb_lower_into(group_p, group_n, &gl);
    return mb_s_eq(&pl, STR_PTR("opencode"), STR_LEN("opencode")) || mb_s_eq(&pl, STR_PTR("opencode-free"), STR_LEN("opencode-free")) || mb_s_eq(&gl, STR_PTR("opencode"), STR_LEN("opencode")) || mb_s_eq(&gl, STR_PTR("opencode-free"), STR_LEN("opencode-free"));
}
fn relaxMiniResponsesAssistantText(input: u64, out: &u64) -> void {
    *out = mb_new_arr();
    if input == 0 || mb_kind(input) != MB_JK_ARRAY { return; };
    let count: u64 = mb_n_count(input);
    let i: u64 = 0;
    while i < count {
        let item: u64 = mb_a_at(input, i);
        i = i + 1;
        let role = MbStr { bytes: [0u8; 8192], len: 0 };
        let content: u64 = 0;
        if item != 0 { let ok: bool = mb_g_str(item, STR_PTR("role"), STR_LEN("role"), &role); content = mb_g_node(item, STR_PTR("content"), STR_LEN("content")); };
        if item == 0 || !mb_s_eq(&role, STR_PTR("assistant"), STR_LEN("assistant")) || content == 0 || mb_kind(content) != MB_JK_ARRAY {
            let rc: i32 = mb_a_push_node(*out, mb_clone_node(item));
            continue;
        };
        let new_content: u64 = mb_new_arr();
        let touched: bool = false;
        let cc: u64 = mb_n_count(content);
        let ci: u64 = 0;
        while ci < cc {
            let part: u64 = mb_a_at(content, ci);
            ci = ci + 1;
            let ty = MbStr { bytes: [0u8; 8192], len: 0 };
            let has_text: bool = false;
            if part != 0 {
                let ok: bool = mb_g_str(part, STR_PTR("type"), STR_LEN("type"), &ty);
                let tv = MbStr { bytes: [0u8; 8192], len: 0 };
                has_text = mb_g_str(part, STR_PTR("text"), STR_LEN("text"), &tv);
            };
            if part != 0 && mb_s_eq(&ty, STR_PTR("output_text"), STR_LEN("output_text")) && has_text {
                touched = true;
                let np: u64 = mb_new_obj();
                let pc: u64 = mb_n_count(part);
                let pi: u64 = 0;
                let rc0: i32 = mb_s_str(np, STR_PTR("type"), STR_LEN("type"), STR_PTR("input_text"), STR_LEN("input_text"));
                while pi < pc {
                    let kp: ptr = PTR_NULL();
                    let kn: u64 = 0;
                    if mb_key_at(part, pi, &kp, &kn) && !mb_bytes_eq(kp, kn, STR_PTR("type"), STR_LEN("type")) {
                        let rc: i32 = mb_s_node(np, kp, kn, mb_clone_node(mb_g_node(part, kp, kn)));
                    };
                    pi = pi + 1;
                }
                let rc2: i32 = mb_a_push_node(new_content, np);
            } else {
                let rc3: i32 = mb_a_push_node(new_content, mb_clone_node(part));
            };
        }
        if !touched {
            mb_free_doc(new_content);
            let rc: i32 = mb_a_push_node(*out, mb_clone_node(item));
        } else {
            let ni: u64 = mb_clone_node(item);
            let rc: i32 = mb_s_node(ni, STR_PTR("content"), STR_LEN("content"), new_content);
            let rc2: i32 = mb_a_push_node(*out, ni);
        };
    }
}
fn mb_summarize_add_chars(node: u64, acc: &u64) -> void {
    if node == 0 { return; };
    let k: u64 = mb_kind(node);
    if k == MB_JK_STRING {
        // Long strings exceed MbStr; count via string_len directly.
        // (deref hoisted: *acc cannot be an arithmetic operand directly)
        let cur: u64 = *acc;
        *acc = cur + sa_json_string_len(node);
        return;
    };
    if k == MB_JK_ARRAY {
        let c: u64 = mb_n_count(node);
        let i: u64 = 0;
        while i < c { mb_summarize_add_chars(mb_a_at(node, i), acc); i = i + 1; }
        return;
    };
    if k == MB_JK_OBJECT {
        let c: u64 = mb_n_count(node);
        let i: u64 = 0;
        while i < c {
            let kp: ptr = PTR_NULL();
            let kn: u64 = 0;
            if mb_key_at(node, i, &kp, &kn) { mb_summarize_add_chars(mb_g_node(node, kp, kn), acc); };
            i = i + 1;
        }
        return;
    };
}
fn summarizeMiniResponsesInput(input: u64, out: &MbJson) -> void {
    out.len = 0;
    // Count maps as JSON objects of name->count, preserving insertion order.
    let roles: u64 = mb_new_obj();
    let role_order: u64 = mb_new_arr();
    let types: u64 = mb_new_obj();
    let type_order: u64 = mb_new_arr();
    let chars: u64 = 0;
    if input != 0 && mb_kind(input) == MB_JK_ARRAY {
        let count: u64 = mb_n_count(input);
        let i: u64 = 0;
        while i < count {
            let item: u64 = mb_a_at(input, i);
            i = i + 1;
            if item == 0 { continue; };
            let role_key = MbStr { bytes: [0u8; 8192], len: 0 };
            if !mb_g_str(item, STR_PTR("role"), STR_LEN("role"), &role_key) {
                if !mb_g_str(item, STR_PTR("type"), STR_LEN("type"), &role_key) { mb_sassign(&role_key, STR_PTR("?"), STR_LEN("?")); };
            };
            mb_count_map_inc(roles, role_order, mb_sp(&role_key), role_key.len);
            let content: u64 = mb_g_node(item, STR_PTR("content"), STR_LEN("content"));
            if content != 0 && mb_kind(content) == MB_JK_ARRAY {
                let cc: u64 = mb_n_count(content);
                let ci: u64 = 0;
                while ci < cc {
                    let part: u64 = mb_a_at(content, ci);
                    ci = ci + 1;
                    if part == 0 { continue; };
                    let t = MbStr { bytes: [0u8; 8192], len: 0 };
                    if !mb_g_str(part, STR_PTR("type"), STR_LEN("type"), &t) { mb_sassign(&t, STR_PTR("?"), STR_LEN("?")); };
                    mb_count_map_inc(types, type_order, mb_sp(&t), t.len);
                    let probe: u64 = mb_g_node(part, STR_PTR("text"), STR_LEN("text"));
                    if probe == 0 { probe = mb_g_node(part, STR_PTR("output"), STR_LEN("output")); };
                    if probe == 0 { probe = mb_g_node(part, STR_PTR("arguments"), STR_LEN("arguments")); };
                    mb_summarize_add_chars(probe, &chars);
                }
            } else {
                let ty = MbStr { bytes: [0u8; 8192], len: 0 };
                if mb_g_str(item, STR_PTR("type"), STR_LEN("type"), &ty) {
                    mb_count_map_inc(types, type_order, mb_sp(&ty), ty.len);
                    let probe: u64 = mb_g_node(item, STR_PTR("output"), STR_LEN("output"));
                    if probe == 0 { probe = mb_g_node(item, STR_PTR("arguments"), STR_LEN("arguments")); };
                    mb_summarize_add_chars(probe, &chars);
                };
            };
        }
    };
    mb_jappend(out, STR_PTR("n="), STR_LEN("n="));
    let n_s = MbStr { bytes: [0u8; 8192], len: 0 };
    let total: u64 = 0;
    if input != 0 { total = mb_n_count(input); };
    mb_u64_to_s(total, &n_s);
    mb_jappend_s(out, &n_s);
    mb_jappend(out, STR_PTR(" roles{"), STR_LEN(" roles{"));
    mb_count_map_fmt(roles, role_order, out);
    mb_jappend(out, STR_PTR("} types{"), STR_LEN("} types{"));
    mb_count_map_fmt(types, type_order, out);
    mb_jappend(out, STR_PTR("} chars~"), STR_LEN("} chars~"));
    let c_s = MbStr { bytes: [0u8; 8192], len: 0 };
    mb_u64_to_s(chars, &c_s);
    mb_jappend_s(out, &c_s);
    mb_free_doc(roles);
    mb_free_doc(role_order);
    mb_free_doc(types);
    mb_free_doc(type_order);
}
fn mb_count_map_inc(map: u64, order: u64, key_p: ptr, key_n: u64) -> void {
    let cur: i64 = 0;
    if mb_g_i64(map, key_p, key_n, &cur) {
        let rc: i32 = mb_s_i64(map, key_p, key_n, cur + 1);
        return;
    };
    let rc: i32 = mb_s_i64(map, key_p, key_n, 1);
    rc = mb_a_push_str(order, key_p, key_n);
}
fn mb_count_map_fmt(map: u64, order: u64, out: &MbJson) -> void {
    let count: u64 = mb_n_count(order);
    let i: u64 = 0;
    while i < count {
        if i > 0 { mb_jpush(out, 44); };
        let k = MbStr { bytes: [0u8; 8192], len: 0 };
        let ok: bool = mb_n_str(mb_a_at(order, i), &k);
        mb_jappend_s(out, &k);
        mb_jpush(out, 58);
        let v: i64 = 0;
        let ok2: bool = mb_g_i64(map, mb_sp(&k), k.len, &v);
        let vs = MbStr { bytes: [0u8; 8192], len: 0 };
        mb_i64_to_s(v, &vs);
        mb_jappend_s(out, &vs);
        i = i + 1;
    }
}
// ---- protocol error detectors (TS:1292-1380) ----
fn mb_error_text(name_p: ptr, name_n: u64, msg_p: ptr, msg_n: u64, out: &MbJson) -> void {
    // TS: error instanceof Error ? error.message : String(error ?? "")
    out.len = 0;
    mb_jappend(out, msg_p, msg_n);
}
fn isModelProtocolUnsupportedError(msg_p: ptr, msg_n: u64) -> bool {
    if !mb_re_test(msg_p, msg_n, STR_PTR("responses 400([^0-9]|$)"), STR_LEN("responses 400([^0-9]|$)"), false) { return false; };
    return mb_re_test(msg_p, msg_n, STR_PTR("ModelProtocolUnsupported|does not support this protocol"), STR_LEN("ModelProtocolUnsupported|does not support this protocol"), true);
}
fn isClaudeModelId(model_p: ptr, model_n: u64) -> bool {
    return mb_re_test(model_p, model_n, STR_PTR("(^|/)claude"), STR_LEN("(^|/)claude"), true);
}
fn requiresAnthropicAdaptiveThinking(model_p: ptr, model_n: u64) -> bool {
    let t = MbStr { bytes: [0u8; 8192], len: 0 };
    mb_trim_to(model_p, model_n, &t);
    let low = MbStr { bytes: [0u8; 8192], len: 0 };
    mb_lower_into(mb_sp(&t), t.len, &low);
    // normalized = lower.replace(/[._\s]+/g, "-")
    let norm = MbJson { bytes: [0u8; 262144], len: 0 };
    let i: u64 = 0;
    let in_run: bool = false;
    while i < low.len {
        let b: u8 = low.bytes[i];
        if b == 46 || b == 95 || mb_is_ws(b) {
            if !in_run { mb_jpush(&norm, 45); in_run = true; };
        } else { mb_jpush(&norm, b); in_run = false; };
        i = i + 1;
    }
    if mb_re_test(mb_jp(&norm), norm.len, STR_PTR("claude-(opus|sonnet|haiku)-5"), STR_LEN("claude-(opus|sonnet|haiku)-5"), true) { return true; };
    return mb_re_test(mb_jp(&norm), norm.len, STR_PTR("claude-.*5-5"), STR_LEN("claude-.*5-5"), true);
}
fn miniAnthropicAdaptiveEffort(effort_p: ptr, effort_n: u64, has_effort: bool, out: &MbStr, out_has: &bool) -> void {
    out.len = 0;
    *out_has = false;
    if !has_effort { return; };
    let t = MbStr { bytes: [0u8; 8192], len: 0 };
    mb_trim_to(effort_p, effort_n, &t);
    let low = MbStr { bytes: [0u8; 8192], len: 0 };
    mb_lower_into(mb_sp(&t), t.len, &low);
    if low.len == 0 || mb_s_eq(&low, STR_PTR("none"), STR_LEN("none")) { return; };
    if mb_s_eq(&low, STR_PTR("minimal"), STR_LEN("minimal")) { mb_sassign(out, STR_PTR("low"), STR_LEN("low")); *out_has = true; return; };
    if mb_s_eq(&low, STR_PTR("ultra"), STR_LEN("ultra")) { mb_sassign(out, STR_PTR("xhigh"), STR_LEN("xhigh")); *out_has = true; return; };
    if mb_s_eq(&low, STR_PTR("low"), STR_LEN("low")) || mb_s_eq(&low, STR_PTR("medium"), STR_LEN("medium")) || mb_s_eq(&low, STR_PTR("high"), STR_LEN("high")) || mb_s_eq(&low, STR_PTR("xhigh"), STR_LEN("xhigh")) || mb_s_eq(&low, STR_PTR("max"), STR_LEN("max")) {
        mb_sassign(out, mb_sp(&low), low.len);
        *out_has = true;
    };
}
fn isAnthropicAdaptiveThinkingRequiredError(msg_p: ptr, msg_n: u64) -> bool {
    return mb_re_test(msg_p, msg_n, STR_PTR("requires adaptive thinking|adaptive.*thinking|output_config.*effort"), STR_LEN("requires adaptive thinking|adaptive.*thinking|output_config.*effort"), true);
}

// ================= TS 1345-2463: Anthropic family, shrink, tools =================
const MINI_ANTHROPIC_TRAILING_TEXT = "[Tool results received above; continue with the task.]";
const MINI_ANTHROPIC_MAX_TOKENS_TRUNCATED = "mini anthropic output truncated at max_tokens";
fn MINI_CONTEXT_OVERFLOW_MAX_RECOVERIES() -> i64 { return 2; }

fn mb_normalize_model_id(p: ptr, n: u64, out: &MbJson) -> void {
    let t = MbStr { bytes: [0u8; 8192], len: 0 };
    mb_trim_to(p, n, &t);
    let low = MbStr { bytes: [0u8; 8192], len: 0 };
    mb_lower_into(mb_sp(&t), t.len, &low);
    out.len = 0;
    let i: u64 = 0;
    let in_run: bool = false;
    while i < low.len {
        let b: u8 = low.bytes[i];
        if b == 46 || b == 95 || mb_is_ws(b) { if !in_run { mb_jpush(out, 45); in_run = true; }; } else { mb_jpush(out, b); in_run = false; };
        i = i + 1;
    }
}
fn isMiniAnthropicPrefillError(msg_p: ptr, msg_n: u64) -> bool {
    if !mb_re_test(msg_p, msg_n, STR_PTR("^anthropic([^a-z]|$)"), STR_LEN("^anthropic([^a-z]|$)"), true) { return false; };
    return mb_re_test(msg_p, msg_n, STR_PTR("prefill|must end with a user message"), STR_LEN("prefill|must end with a user message"), true);
}
fn isMiniAnthropicEmptyResponseError(msg_p: ptr, msg_n: u64) -> bool {
    return mb_re_test(msg_p, msg_n, STR_PTR("empty.*anthropic.*response|anthropic.*empty.*response|closed anthropic stream with empty response|anthropic stream ended before a terminal completion marker"), STR_LEN("empty.*anthropic.*response|anthropic.*empty.*response|closed anthropic stream with empty response|anthropic stream ended before a terminal completion marker"), true);
}
fn isAnthropicEndpointUnsupportedError(msg_p: ptr, msg_n: u64) -> bool {
    if mb_re_test(msg_p, msg_n, STR_PTR("^anthropic (404|405)([^0-9]|$)"), STR_LEN("^anthropic (404|405)([^0-9]|$)"), true) { return true; };
    return isMiniAnthropicEmptyResponseError(msg_p, msg_n);
}
fn miniAnthropicOutputCapForModel(model_p: ptr, model_n: u64, has_model: bool) -> i64 {
    let norm = MbJson { bytes: [0u8; 262144], len: 0 };
    if has_model { mb_normalize_model_id(model_p, model_n, &norm); };
    if mb_re_test(mb_jp(&norm), norm.len, STR_PTR("claude-(fable|mythos|opus|sonnet|haiku)-5"), STR_LEN("claude-(fable|mythos|opus|sonnet|haiku)-5"), true)
        || mb_re_test(mb_jp(&norm), norm.len, STR_PTR("claude-.*5-5"), STR_LEN("claude-.*5-5"), true)
        || mb_re_test(mb_jp(&norm), norm.len, STR_PTR("claude-(opus|sonnet|haiku)-4-[6-9]"), STR_LEN("claude-(opus|sonnet|haiku)-4-[6-9]"), true) { return 128000; };
    if mb_re_test(mb_jp(&norm), norm.len, STR_PTR("claude"), STR_LEN("claude"), true) { return 64000; };
    return 32000;
}
fn isMiniContextOverflowError(msg_p: ptr, msg_n: u64) -> bool {
    if mb_re_test(msg_p, msg_n, STR_PTR("relay unavailable|stall timeout"), STR_LEN("relay unavailable|stall timeout"), true) { return false; };
    return mb_re_test(msg_p, msg_n, STR_PTR("prompt is too long|prompt too long|context[_ ]length[_ ]exceeded|maximum context length|context window|input is too long|too many (input )?tokens|exceeds? the (maximum|model'?s?|context)|request too large|input length .* exceed"), STR_LEN("prompt is too long|prompt too long|context[_ ]length[_ ]exceeded|maximum context length|context window|input is too long|too many (input )?tokens|exceeds? the (maximum|model'?s?|context)|request too large|input length .* exceed"), true);
}
fn isMiniAnthropicCacheControlUnsupportedError(msg_p: ptr, msg_n: u64) -> bool {
    if !mb_re_test(msg_p, msg_n, STR_PTR("cache_control"), STR_LEN("cache_control"), true) { return false; };
    return mb_re_test(msg_p, msg_n, STR_PTR("(^|[^a-z])(unknown|unsupported|extra|unexpected|not permitted|forbidden|invalid|not allowed)([^a-z]|$)"), STR_LEN("(^|[^a-z])(unknown|unsupported|extra|unexpected|not permitted|forbidden|invalid|not allowed)([^a-z]|$)"), true);
}
fn isMiniAnthropicMaxTokensRejectedError(msg_p: ptr, msg_n: u64) -> bool {
    if !mb_re_test(msg_p, msg_n, STR_PTR("^anthropic 4[0-9][0-9]([^0-9]|$)"), STR_LEN("^anthropic 4[0-9][0-9]([^0-9]|$)"), true) { return false; };
    return mb_re_test(msg_p, msg_n, STR_PTR("max_tokens"), STR_LEN("max_tokens"), true);
}
fn miniAnthropicMessagesUrl(base_p: ptr, base_n: u64, out: &MbStr) -> void {
    out.len = 0;
    let end: u64 = base_n;
    while end > 0 && mb_byte_at(base_p, end - 1) == 47 { end = end - 1; }
    if end == 0 { mb_sassign(out, STR_PTR("/messages"), STR_LEN("/messages")); return; };
    let trimmed = MbStr { bytes: [0u8; 8192], len: 0 };
    mb_sassign(&trimmed, base_p, end);
    if mb_re_test(mb_sp(&trimmed), trimmed.len, STR_PTR("/messages$"), STR_LEN("/messages$"), true) { mb_sassign(out, mb_sp(&trimmed), trimmed.len); return; };
    if mb_re_test(mb_sp(&trimmed), trimmed.len, STR_PTR("/v1$"), STR_LEN("/v1$"), true) {
        mb_sassign(out, mb_sp(&trimmed), trimmed.len);
        mb_sappend(out, STR_PTR("/messages"), STR_LEN("/messages"));
        return;
    };
    // URL parse (manual): scheme://host[/path]
    let scheme: i64 = mb_index_of(mb_sp(&trimmed), trimmed.len, STR_PTR("://"), STR_LEN("://"));
    if scheme >= 0 {
        let host_start: u64 = (scheme as u64) + 3;
        let slash: i64 = -1;
        let i: u64 = host_start;
        while i < trimmed.len { if trimmed.bytes[i] == 47 { slash = i as i64; break; }; i = i + 1; }
        if slash < 0 || (slash as u64) == trimmed.len - 1 {
            mb_sassign(out, mb_sp(&trimmed), trimmed.len);
            mb_sappend(out, STR_PTR("/v1/messages"), STR_LEN("/v1/messages"));
            return;
        };
    };
    mb_sassign(out, mb_sp(&trimmed), trimmed.len);
    mb_sappend(out, STR_PTR("/messages"), STR_LEN("/messages"));
}
fn miniAnthropicTextOf(content: u64, out: &MbJson) -> void {
    out.len = 0;
    if content == 0 { return; };
    if mb_kind(content) == MB_JK_STRING { let ok: bool = mb_n_str_j(content, out); return; };
    if mb_kind(content) != MB_JK_ARRAY { return; };
    let count: u64 = mb_n_count(content);
    let i: u64 = 0;
    while i < count {
        let part: u64 = mb_a_at(content, i);
        i = i + 1;
        if part == 0 || mb_kind(part) != MB_JK_OBJECT { continue; };
        let ty = MbStr { bytes: [0u8; 8192], len: 0 };
        let ok: bool = mb_g_str(part, STR_PTR("type"), STR_LEN("type"), &ty);
        if mb_s_eq(&ty, STR_PTR("text"), STR_LEN("text")) || mb_s_eq(&ty, STR_PTR("input_text"), STR_LEN("input_text")) {
            let t = MbJson { bytes: [0u8; 262144], len: 0 };
            mb_json_scalar_text(mb_g_node(part, STR_PTR("text"), STR_LEN("text")), &t);
            mb_jappend_j(out, &t);
        };
    }
}
// Returns an image block doc or 0.
fn miniAnthropicImageBlock(part: u64) -> u64 {
    if part == 0 { return 0; };
    let url = MbJson { bytes: [0u8; 262144], len: 0 };
    if !mb_g_str_j(part, STR_PTR("url"), STR_LEN("url"), &url) {
        let nested: u64 = mb_g_node(part, STR_PTR("image_url"), STR_LEN("image_url"));
        if nested != 0 { let ok: bool = mb_g_str_j(nested, STR_PTR("url"), STR_LEN("url"), &url); };
    };
    if url.len == 0 { return 0; };
    // Manual data-URL parse: ^data:([^;,]+)?(;base64)?,(.*)$
    if !mb_starts_with(mb_jp(&url), url.len, STR_PTR("data:"), STR_LEN("data:")) { return 0; };
    let comma: i64 = mb_index_of(mb_jp(&url), url.len, STR_PTR(","), STR_LEN(","));
    if comma < 0 { return 0; };
    let header = MbJson { bytes: [0u8; 262144], len: 0 };
    mb_slice_to(mb_jp(&url), url.len, 5, comma, &header);
    if !mb_contains(mb_jp(&header), header.len, STR_PTR(";base64"), STR_LEN(";base64")) { return 0; };
    let media = MbJson { bytes: [0u8; 262144], len: 0 };
    let semi: i64 = mb_index_of(mb_jp(&header), header.len, STR_PTR(";"), STR_LEN(";"));
    if semi >= 0 { mb_slice_to(mb_jp(&header), header.len, 0, semi, &media); } else { mb_jassign_j(&media, &header); };
    if media.len == 0 { mb_jassign(&media, STR_PTR("image/png"), STR_LEN("image/png")); };
    let data = MbJson { bytes: [0u8; 262144], len: 0 };
    mb_slice_to(mb_jp(&url), url.len, comma + 1, url.len as i64, &data);
    let block: u64 = mb_new_obj();
    let source: u64 = mb_new_obj();
    let rc: i32 = mb_s_str(block, STR_PTR("type"), STR_LEN("type"), STR_PTR("image"), STR_LEN("image"));
    rc = mb_s_str(source, STR_PTR("type"), STR_LEN("type"), STR_PTR("base64"), STR_LEN("base64"));
    rc = mb_s_str(source, STR_PTR("media_type"), STR_LEN("media_type"), mb_jp(&media), media.len);
    rc = mb_s_str(source, STR_PTR("data"), STR_LEN("data"), mb_jp(&data), data.len);
    rc = mb_s_node(block, STR_PTR("source"), STR_LEN("source"), source);
    return block;
}
fn miniAnthropicSafeInput(args_p: ptr, args_n: u64, out: &u64) -> void {
    let doc: u64 = sa_json_parse(args_p, args_n);
    if doc != 0 && mb_kind(doc) == MB_JK_OBJECT { *out = doc; return; };
    if doc != 0 { mb_free_doc(doc); };
    *out = mb_new_obj();
}
fn mb_js_typeof(node: u64, present: bool, out: &MbStr) -> void {
    if !present { mb_sassign(out, STR_PTR("undefined"), STR_LEN("undefined")); return; };
    if node == 0 { mb_sassign(out, STR_PTR("undefined"), STR_LEN("undefined")); return; };
    let k: u64 = mb_kind(node);
    if k == MB_JK_STRING { mb_sassign(out, STR_PTR("string"), STR_LEN("string")); return; };
    if k == MB_JK_INT || k == MB_JK_FLOAT { mb_sassign(out, STR_PTR("number"), STR_LEN("number")); return; };
    if k == MB_JK_BOOL { mb_sassign(out, STR_PTR("boolean"), STR_LEN("boolean")); return; };
    mb_sassign(out, STR_PTR("object"), STR_LEN("object"));
}
// toBlocks for Anthropic shapes: content node -> array doc of block docs.
fn mb_anth_to_blocks(content: u64, with_text_field: bool, out: &u64) -> void {
    *out = mb_new_arr();
    if content == 0 { return; };
    if mb_kind(content) == MB_JK_STRING {
        let t = MbJson { bytes: [0u8; 262144], len: 0 };
        let ok: bool = mb_n_str_j(content, &t);
        let tt = MbStr { bytes: [0u8; 8192], len: 0 };
        mb_trim_to(mb_jp(&t), t.len, &tt);
        if tt.len > 0 {
            let b: u64 = mb_new_obj();
            let rc: i32 = mb_s_str(b, STR_PTR("type"), STR_LEN("type"), STR_PTR("text"), STR_LEN("text"));
            if with_text_field { rc = mb_s_str(b, STR_PTR("text"), STR_LEN("text"), mb_jp(&t), t.len); };
            rc = mb_a_push_node(*out, b);
        };
        return;
    };
    if mb_kind(content) == MB_JK_ARRAY {
        let count: u64 = mb_n_count(content);
        let i: u64 = 0;
        while i < count {
            let b: u64 = mb_a_at(content, i);
            if b != 0 && mb_kind(b) == MB_JK_OBJECT { let rc: i32 = mb_a_push_node(*out, mb_clone_node(b)); };
            i = i + 1;
        }
    };
}
// fromBlocks: blocks arr + role -> message doc (0 when empty).
fn mb_anth_from_blocks(blocks: u64, role_p: ptr, role_n: u64, out: &u64) -> void {
    *out = 0;
    if blocks == 0 || mb_n_count(blocks) == 0 { return; };
    let msg: u64 = mb_new_obj();
    let rc: i32 = mb_s_str(msg, STR_PTR("role"), STR_LEN("role"), role_p, role_n);
    if mb_n_count(blocks) == 1 {
        let b: u64 = mb_a_at(blocks, 0);
        let ty = MbStr { bytes: [0u8; 8192], len: 0 };
        if b != 0 && mb_g_str(b, STR_PTR("type"), STR_LEN("type"), &ty) && mb_s_eq(&ty, STR_PTR("text"), STR_LEN("text")) {
            let t = MbJson { bytes: [0u8; 262144], len: 0 };
            let ok: bool = mb_g_str_j(b, STR_PTR("text"), STR_LEN("text"), &t);
            rc = mb_s_str(msg, STR_PTR("content"), STR_LEN("content"), mb_jp(&t), t.len);
            *out = msg;
            return;
        };
    };
    rc = mb_s_node(msg, STR_PTR("content"), STR_LEN("content"), mb_clone_node(blocks));
    *out = msg;
}
fn miniAnthropicSkeleton(messages: u64, present: bool, out: &MbJson) -> void {
    out.len = 0;
    if !present || messages == 0 || mb_kind(messages) != MB_JK_ARRAY {
        mb_jappend(out, STR_PTR("<non-array:"), STR_LEN("<non-array:"));
        let t = MbStr { bytes: [0u8; 8192], len: 0 };
        mb_js_typeof(messages, present, &t);
        mb_jappend_s(out, &t);
        mb_jpush(out, 62);
        return;
    };
    let count: u64 = mb_n_count(messages);
    let i: u64 = 0;
    while i < count {
        if i > 0 { mb_jappend(out, STR_PTR(" > "), STR_LEN(" > ")); };
        let m: u64 = mb_a_at(messages, i);
        i = i + 1;
        let role = MbStr { bytes: [0u8; 8192], len: 0 };
        if m != 0 { let ok: bool = mb_g_str(m, STR_PTR("role"), STR_LEN("role"), &role); };
        if role.len == 0 { mb_sassign(&role, STR_PTR("?"), STR_LEN("?")); };
        mb_jappend_s(out, &role);
        mb_jpush(out, 91);
        let blocks: u64 = 0;
        let content: u64 = 0;
        if m != 0 { content = mb_g_node(m, STR_PTR("content"), STR_LEN("content")); };
        mb_anth_to_blocks(content, false, &blocks);
        let texts: u64 = 0;
        let uses: u64 = 0;
        let ress: u64 = 0;
        let imgs: u64 = 0;
        let bc: u64 = mb_n_count(blocks);
        let bi: u64 = 0;
        while bi < bc {
            let b: u64 = mb_a_at(blocks, bi);
            bi = bi + 1;
            let ty = MbStr { bytes: [0u8; 8192], len: 0 };
            if b != 0 { let ok: bool = mb_g_str(b, STR_PTR("type"), STR_LEN("type"), &ty); };
            if mb_s_eq(&ty, STR_PTR("text"), STR_LEN("text")) { texts = texts + 1; } else if mb_s_eq(&ty, STR_PTR("tool_use"), STR_LEN("tool_use")) { uses = uses + 1; } else if mb_s_eq(&ty, STR_PTR("tool_result"), STR_LEN("tool_result")) { ress = ress + 1; } else if mb_s_eq(&ty, STR_PTR("image"), STR_LEN("image")) { imgs = imgs + 1; };
        }
        let other: u64 = bc - texts - uses - ress - imgs;
        let first_kind: bool = true;
        if texts > 0 { mb_anth_skel_kind(out, texts, STR_PTR("txt"), STR_LEN("txt"), &first_kind); };
        if uses > 0 { mb_anth_skel_kind(out, uses, STR_PTR("use"), STR_LEN("use"), &first_kind); };
        if ress > 0 { mb_anth_skel_kind(out, ress, STR_PTR("res"), STR_LEN("res"), &first_kind); };
        if imgs > 0 { mb_anth_skel_kind(out, imgs, STR_PTR("img"), STR_LEN("img"), &first_kind); };
        if other > 0 { mb_anth_skel_kind(out, other, STR_PTR("other"), STR_LEN("other"), &first_kind); };
        if bc == 0 { mb_jappend(out, STR_PTR("empty"), STR_LEN("empty")); };
        mb_jpush(out, 93);
        mb_free_doc(blocks);
    }
}
fn mb_anth_skel_kind(out: &MbJson, n: u64, name: ptr, name_n: u64, first: &bool) -> void {
    if !*first { mb_jpush(out, 43); };
    *first = false;
    let s = MbStr { bytes: [0u8; 8192], len: 0 };
    mb_u64_to_s(n, &s);
    mb_jappend_s(out, &s);
    mb_jappend(out, name, name_n);
}
fn miniAnthropicBodyIssues(body: u64, out: &u64) -> void {
    *out = mb_new_arr();
    let messages: u64 = 0;
    if body != 0 { messages = mb_g_node(body, STR_PTR("messages"), STR_LEN("messages")); };
    let skel = MbJson { bytes: [0u8; 262144], len: 0 };
    miniAnthropicSkeleton(messages, messages != 0, &skel);
    if messages == 0 || mb_kind(messages) != MB_JK_ARRAY || mb_n_count(messages) == 0 {
        let issue = MbJson { bytes: [0u8; 262144], len: 0 };
        mb_jappend(&issue, STR_PTR("empty messages (skeleton: "), STR_LEN("empty messages (skeleton: "));
        mb_jappend_j(&issue, &skel);
        mb_jpush(&issue, 41);
        let rc: i32 = mb_a_push_str(*out, mb_jp(&issue), issue.len);
        return;
    };
    let count: u64 = mb_n_count(messages);
    let first_role = MbStr { bytes: [0u8; 8192], len: 0 };
    let okf: bool = mb_g_str(mb_a_at(messages, 0), STR_PTR("role"), STR_LEN("role"), &first_role);
    if !mb_s_eq(&first_role, STR_PTR("user"), STR_LEN("user")) {
        let issue = MbJson { bytes: [0u8; 262144], len: 0 };
        mb_jappend(&issue, STR_PTR("first message is "), STR_LEN("first message is "));
        if first_role.len > 0 { mb_jappend_s(&issue, &first_role); } else { mb_jpush(&issue, 63); };
        mb_jappend(&issue, STR_PTR(" (skeleton: "), STR_LEN(" (skeleton: "));
        mb_jappend_j(&issue, &skel);
        mb_jpush(&issue, 41);
        let rc: i32 = mb_a_push_str(*out, mb_jp(&issue), issue.len);
    };
    let last_role = MbStr { bytes: [0u8; 8192], len: 0 };
    let okl: bool = mb_g_str(mb_a_at(messages, count - 1), STR_PTR("role"), STR_LEN("role"), &last_role);
    if !mb_s_eq(&last_role, STR_PTR("user"), STR_LEN("user")) {
        let issue = MbJson { bytes: [0u8; 262144], len: 0 };
        mb_jappend(&issue, STR_PTR("last message is "), STR_LEN("last message is "));
        if last_role.len > 0 { mb_jappend_s(&issue, &last_role); } else { mb_jpush(&issue, 63); };
        mb_jappend(&issue, STR_PTR(" — prefill rejected (skeleton: "), STR_LEN(" — prefill rejected (skeleton: "));
        mb_jappend_j(&issue, &skel);
        mb_jpush(&issue, 41);
        let rc: i32 = mb_a_push_str(*out, mb_jp(&issue), issue.len);
    };
    let prev_use: u64 = mb_new_arr();
    let i: u64 = 0;
    while i < count {
        let m: u64 = mb_a_at(messages, i);
        let idx: u64 = i;
        i = i + 1;
        let role = MbStr { bytes: [0u8; 8192], len: 0 };
        if m != 0 { let ok: bool = mb_g_str(m, STR_PTR("role"), STR_LEN("role"), &role); };
        if !mb_s_eq(&role, STR_PTR("user"), STR_LEN("user")) && !mb_s_eq(&role, STR_PTR("assistant"), STR_LEN("assistant")) {
            let issue = MbJson { bytes: [0u8; 262144], len: 0 };
            mb_jappend(&issue, STR_PTR("msg"), STR_LEN("msg"));
            let ns = MbStr { bytes: [0u8; 8192], len: 0 };
            mb_u64_to_s(idx, &ns);
            mb_jappend_s(&issue, &ns);
            mb_jappend(&issue, STR_PTR(" has unexpected role "), STR_LEN(" has unexpected role "));
            mb_jappend_s(&issue, &role);
            let rc: i32 = mb_a_push_str(*out, mb_jp(&issue), issue.len);
            mb_free_doc(prev_use);
            prev_use = mb_new_arr();
            continue;
        };
        if idx > 0 {
            let prev_role = MbStr { bytes: [0u8; 8192], len: 0 };
            let okp: bool = mb_g_str(mb_a_at(messages, idx - 1), STR_PTR("role"), STR_LEN("role"), &prev_role);
            if mb_s_eq_s(&prev_role, &role) {
                let issue = MbJson { bytes: [0u8; 262144], len: 0 };
                mb_jappend(&issue, STR_PTR("msg"), STR_LEN("msg"));
                let ns = MbStr { bytes: [0u8; 8192], len: 0 };
                mb_u64_to_s(idx, &ns);
                mb_jappend_s(&issue, &ns);
                mb_jappend(&issue, STR_PTR(" repeats role "), STR_LEN(" repeats role "));
                mb_jappend_s(&issue, &role);
                mb_jappend(&issue, STR_PTR(" (skeleton: "), STR_LEN(" (skeleton: "));
                mb_jappend_j(&issue, &skel);
                mb_jpush(&issue, 41);
                let rc: i32 = mb_a_push_str(*out, mb_jp(&issue), issue.len);
            };
        };
        let blocks: u64 = 0;
        mb_anth_to_blocks(mb_g_node(m, STR_PTR("content"), STR_LEN("content")), true, &blocks);
        if mb_n_count(blocks) == 0 {
            let issue = MbJson { bytes: [0u8; 262144], len: 0 };
            mb_jappend(&issue, STR_PTR("msg"), STR_LEN("msg"));
            let ns = MbStr { bytes: [0u8; 8192], len: 0 };
            mb_u64_to_s(idx, &ns);
            mb_jappend_s(&issue, &ns);
            mb_jappend(&issue, STR_PTR(" ("), STR_LEN(" ("));
            mb_jappend_s(&issue, &role);
            mb_jappend(&issue, STR_PTR(") has empty content"), STR_LEN(") has empty content"));
            let rc: i32 = mb_a_push_str(*out, mb_jp(&issue), issue.len);
            mb_free_doc(blocks);
            mb_free_doc(prev_use);
            prev_use = mb_new_arr();
            continue;
        };
        if mb_s_eq(&role, STR_PTR("user"), STR_LEN("user")) {
            let bc: u64 = mb_n_count(blocks);
            let bi: u64 = 0;
            while bi < bc {
                let b: u64 = mb_a_at(blocks, bi);
                bi = bi + 1;
                let ty = MbStr { bytes: [0u8; 8192], len: 0 };
                if b != 0 { let ok: bool = mb_g_str(b, STR_PTR("type"), STR_LEN("type"), &ty); };
                if mb_s_eq(&ty, STR_PTR("tool_result"), STR_LEN("tool_result")) {
                    let id = MbStr { bytes: [0u8; 8192], len: 0 };
                    let has_id: bool = b != 0 && mb_g_str(b, STR_PTR("tool_use_id"), STR_LEN("tool_use_id"), &id);
                    if !has_id || !mb_str_in_arr(prev_use, mb_sp(&id), id.len, false) {
                        let issue = MbJson { bytes: [0u8; 262144], len: 0 };
                        mb_jappend(&issue, STR_PTR("msg"), STR_LEN("msg"));
                        let ns = MbStr { bytes: [0u8; 8192], len: 0 };
                        mb_u64_to_s(idx, &ns);
                        mb_jappend_s(&issue, &ns);
                        mb_jappend(&issue, STR_PTR(" orphan tool_result "), STR_LEN(" orphan tool_result "));
                        if has_id && id.len > 0 { mb_jappend_s(&issue, &id); } else { mb_jpush(&issue, 63); };
                        mb_jappend(&issue, STR_PTR(" (skeleton: "), STR_LEN(" (skeleton: "));
                        mb_jappend_j(&issue, &skel);
                        mb_jpush(&issue, 41);
                        let rc: i32 = mb_a_push_str(*out, mb_jp(&issue), issue.len);
                    };
                };
            }
            mb_free_doc(blocks);
            mb_free_doc(prev_use);
            prev_use = mb_new_arr();
            continue;
        };
        // assistant: prevUse = ids of its tool_use blocks
        mb_free_doc(prev_use);
        prev_use = mb_new_arr();
        let bc: u64 = mb_n_count(blocks);
        let bi: u64 = 0;
        while bi < bc {
            let b: u64 = mb_a_at(blocks, bi);
            bi = bi + 1;
            let ty = MbStr { bytes: [0u8; 8192], len: 0 };
            let id = MbStr { bytes: [0u8; 8192], len: 0 };
            if b != 0 {
                let ok: bool = mb_g_str(b, STR_PTR("type"), STR_LEN("type"), &ty);
                let ok2: bool = mb_g_str(b, STR_PTR("id"), STR_LEN("id"), &id);
            };
            if mb_s_eq(&ty, STR_PTR("tool_use"), STR_LEN("tool_use")) && id.len > 0 {
                let rc: i32 = mb_a_push_str(prev_use, mb_sp(&id), id.len);
            };
        }
        mb_free_doc(blocks);
    }
    mb_free_doc(prev_use);
}
fn miniAnthropicApplyPromptCache(body: u64, out: &u64) -> void {
    *out = mb_clone_node(body);
    if *out == 0 { *out = mb_new_obj(); return; };
    let cc: u64 = mb_new_obj();
    let rc0: i32 = mb_s_str(cc, STR_PTR("type"), STR_LEN("type"), STR_PTR("ephemeral"), STR_LEN("ephemeral"));
    let system: u64 = mb_g_node(*out, STR_PTR("system"), STR_LEN("system"));
    if system != 0 && mb_kind(system) == MB_JK_STRING {
        let t = MbJson { bytes: [0u8; 262144], len: 0 };
        let ok: bool = mb_n_str_j(system, &t);
        let tt = MbStr { bytes: [0u8; 8192], len: 0 };
        mb_trim_to(mb_jp(&t), t.len, &tt);
        if tt.len > 0 {
            let arr: u64 = mb_new_arr();
            let blk: u64 = mb_new_obj();
            let rc: i32 = mb_s_str(blk, STR_PTR("type"), STR_LEN("type"), STR_PTR("text"), STR_LEN("text"));
            rc = mb_s_str(blk, STR_PTR("text"), STR_LEN("text"), mb_jp(&t), t.len);
            rc = mb_s_node(blk, STR_PTR("cache_control"), STR_LEN("cache_control"), mb_clone_node(cc));
            rc = mb_a_push_node(arr, blk);
            rc = mb_s_node(*out, STR_PTR("system"), STR_LEN("system"), arr);
        };
    };
    let tools: u64 = mb_g_node(*out, STR_PTR("tools"), STR_LEN("tools"));
    if tools != 0 && mb_kind(tools) == MB_JK_ARRAY && mb_n_count(tools) > 0 {
        let last_tool: u64 = mb_a_at(tools, mb_n_count(tools) - 1);
        let rc: i32 = mb_s_node(last_tool, STR_PTR("cache_control"), STR_LEN("cache_control"), mb_clone_node(cc));
    };
    let messages: u64 = mb_g_node(*out, STR_PTR("messages"), STR_LEN("messages"));
    if messages != 0 && mb_kind(messages) == MB_JK_ARRAY && mb_n_count(messages) > 0 {
        let last_msg: u64 = mb_a_at(messages, mb_n_count(messages) - 1);
        let content: u64 = mb_g_node(last_msg, STR_PTR("content"), STR_LEN("content"));
        if content != 0 && mb_kind(content) == MB_JK_STRING {
            let t = MbJson { bytes: [0u8; 262144], len: 0 };
            let ok: bool = mb_n_str_j(content, &t);
            let tt = MbStr { bytes: [0u8; 8192], len: 0 };
            mb_trim_to(mb_jp(&t), t.len, &tt);
            if tt.len > 0 {
                let arr: u64 = mb_new_arr();
                let blk: u64 = mb_new_obj();
                let rc: i32 = mb_s_str(blk, STR_PTR("type"), STR_LEN("type"), STR_PTR("text"), STR_LEN("text"));
                rc = mb_s_str(blk, STR_PTR("text"), STR_LEN("text"), mb_jp(&t), t.len);
                rc = mb_s_node(blk, STR_PTR("cache_control"), STR_LEN("cache_control"), mb_clone_node(cc));
                rc = mb_a_push_node(arr, blk);
                rc = mb_s_node(last_msg, STR_PTR("content"), STR_LEN("content"), arr);
            };
        } else if content != 0 && mb_kind(content) == MB_JK_ARRAY && mb_n_count(content) > 0 {
            let last_block: u64 = mb_a_at(content, mb_n_count(content) - 1);
            let rc: i32 = mb_s_node(last_block, STR_PTR("cache_control"), STR_LEN("cache_control"), mb_clone_node(cc));
        };
    };
    mb_free_doc(cc);
}

// ---- miniChatThreadToAnthropicBody (TS:1675-2010) ----
fn mb_arr_replace_last(arr: &u64, new_item: u64) -> void {
    if *arr == 0 || mb_n_count(*arr) == 0 { return; };
    let next: u64 = mb_new_arr();
    let count: u64 = mb_n_count(*arr);
    let i: u64 = 0;
    while i + 1 < count {
        let rc: i32 = mb_a_push_node(next, mb_clone_node(mb_a_at(*arr, i)));
        i = i + 1;
    }
    let rc: i32 = mb_a_push_node(next, new_item);
    mb_free_doc(*arr);
    *arr = next;
}
fn mb_arr_drop_first(arr: &u64) -> void {
    if *arr == 0 || mb_n_count(*arr) == 0 { return; };
    let next: u64 = mb_new_arr();
    let count: u64 = mb_n_count(*arr);
    let i: u64 = 1;
    while i < count {
        let rc: i32 = mb_a_push_node(next, mb_clone_node(mb_a_at(*arr, i)));
        i = i + 1;
    }
    mb_free_doc(*arr);
    *arr = next;
}
fn mb_arr_pop(arr: &u64) -> void {
    if *arr == 0 || mb_n_count(*arr) == 0 { return; };
    let next: u64 = mb_new_arr();
    let count: u64 = mb_n_count(*arr);
    let i: u64 = 0;
    while i + 1 < count {
        let rc: i32 = mb_a_push_node(next, mb_clone_node(mb_a_at(*arr, i)));
        i = i + 1;
    }
    mb_free_doc(*arr);
    *arr = next;
}
fn mb_anth_tool_use_ids(msg: u64, out: &u64) -> void {
    *out = mb_new_arr();
    if msg == 0 { return; };
    let role = MbStr { bytes: [0u8; 8192], len: 0 };
    let ok: bool = mb_g_str(msg, STR_PTR("role"), STR_LEN("role"), &role);
    if !mb_s_eq(&role, STR_PTR("assistant"), STR_LEN("assistant")) { return; };
    let blocks: u64 = 0;
    mb_anth_to_blocks(mb_g_node(msg, STR_PTR("content"), STR_LEN("content")), true, &blocks);
    let count: u64 = mb_n_count(blocks);
    let i: u64 = 0;
    while i < count {
        let b: u64 = mb_a_at(blocks, i);
        i = i + 1;
        let ty = MbStr { bytes: [0u8; 8192], len: 0 };
        let id = MbStr { bytes: [0u8; 8192], len: 0 };
        if b != 0 {
            let ok1: bool = mb_g_str(b, STR_PTR("type"), STR_LEN("type"), &ty);
            let ok2: bool = mb_g_str(b, STR_PTR("id"), STR_LEN("id"), &id);
        };
        if mb_s_eq(&ty, STR_PTR("tool_use"), STR_LEN("tool_use")) && id.len > 0 {
            let rc: i32 = mb_a_push_str(*out, mb_sp(&id), id.len);
        };
    }
    mb_free_doc(blocks);
}
fn mb_anth_push_tool_results(raw: &u64, open_group: &bool, blocks: u64) -> void {
    if blocks == 0 || mb_n_count(blocks) == 0 { return; };
    if *open_group {
        let count: u64 = mb_n_count(*raw);
        let last: u64 = mb_a_at(*raw, count - 1);
        let content: u64 = mb_g_node(last, STR_PTR("content"), STR_LEN("content"));
        if content != 0 && mb_kind(content) == MB_JK_ARRAY {
            let bc: u64 = mb_n_count(blocks);
            let i: u64 = 0;
            while i < bc {
                let rc: i32 = mb_a_push_node(content, mb_clone_node(mb_a_at(blocks, i)));
                i = i + 1;
            }
            return;
        };
    };
    let msg: u64 = mb_new_obj();
    let rc: i32 = mb_s_str(msg, STR_PTR("role"), STR_LEN("role"), STR_PTR("user"), STR_LEN("user"));
    rc = mb_s_node(msg, STR_PTR("content"), STR_LEN("content"), mb_clone_node(blocks));
    rc = mb_a_push_node(*raw, msg);
    *open_group = true;
}
fn miniChatThreadToAnthropicBody(thread: u64, opts: u64, out: &u64) -> void {
    let systems: u64 = mb_new_arr();
    let raw: u64 = mb_new_arr();
    let open_group: bool = false;
    let tcount: u64 = 0;
    if thread != 0 && mb_kind(thread) == MB_JK_ARRAY { tcount = mb_n_count(thread); };
    let ti: u64 = 0;
    while ti < tcount {
        let item: u64 = mb_a_at(thread, ti);
        ti = ti + 1;
        if item == 0 || mb_kind(item) != MB_JK_OBJECT { continue; };
        let role = MbStr { bytes: [0u8; 8192], len: 0 };
        let okr: bool = mb_g_str(item, STR_PTR("role"), STR_LEN("role"), &role);
        let content: u64 = mb_g_node(item, STR_PTR("content"), STR_LEN("content"));
        if mb_s_eq(&role, STR_PTR("system"), STR_LEN("system")) {
            let text = MbJson { bytes: [0u8; 262144], len: 0 };
            miniAnthropicTextOf(content, &text);
            let tt = MbStr { bytes: [0u8; 8192], len: 0 };
            mb_trim_to(mb_jp(&text), text.len, &tt);
            if tt.len > 0 { let rc: i32 = mb_a_push_str(systems, mb_jp(&text), text.len); };
            open_group = false;
            continue;
        };
        if mb_s_eq(&role, STR_PTR("user"), STR_LEN("user")) {
            open_group = false;
            if content != 0 && mb_kind(content) == MB_JK_STRING {
                let t = MbJson { bytes: [0u8; 262144], len: 0 };
                let ok: bool = mb_n_str_j(content, &t);
                let tt = MbStr { bytes: [0u8; 8192], len: 0 };
                mb_trim_to(mb_jp(&t), t.len, &tt);
                if tt.len > 0 {
                    let msg: u64 = mb_new_obj();
                    let rc: i32 = mb_s_str(msg, STR_PTR("role"), STR_LEN("role"), STR_PTR("user"), STR_LEN("user"));
                    rc = mb_s_str(msg, STR_PTR("content"), STR_LEN("content"), mb_jp(&t), t.len);
                    rc = mb_a_push_node(raw, msg);
                };
                continue;
            };
            if content == 0 || mb_kind(content) != MB_JK_ARRAY { continue; };
            let blocks: u64 = mb_new_arr();
            let pc: u64 = mb_n_count(content);
            let pi: u64 = 0;
            while pi < pc {
                let part: u64 = mb_a_at(content, pi);
                pi = pi + 1;
                if part == 0 || mb_kind(part) != MB_JK_OBJECT { continue; };
                let ty = MbStr { bytes: [0u8; 8192], len: 0 };
                let ok: bool = mb_g_str(part, STR_PTR("type"), STR_LEN("type"), &ty);
                if mb_s_eq(&ty, STR_PTR("text"), STR_LEN("text")) || mb_s_eq(&ty, STR_PTR("input_text"), STR_LEN("input_text")) {
                    let t = MbJson { bytes: [0u8; 262144], len: 0 };
                    if mb_g_str_j(part, STR_PTR("text"), STR_LEN("text"), &t) {
                        let tt = MbStr { bytes: [0u8; 8192], len: 0 };
                        mb_trim_to(mb_jp(&t), t.len, &tt);
                        if tt.len > 0 {
                            let b: u64 = mb_new_obj();
                            let rc: i32 = mb_s_str(b, STR_PTR("type"), STR_LEN("type"), STR_PTR("text"), STR_LEN("text"));
                            rc = mb_s_str(b, STR_PTR("text"), STR_LEN("text"), mb_jp(&t), t.len);
                            rc = mb_a_push_node(blocks, b);
                        };
                    };
                } else if mb_s_eq(&ty, STR_PTR("image_url"), STR_LEN("image_url")) || mb_s_eq(&ty, STR_PTR("input_image"), STR_LEN("input_image")) || mb_s_eq(&ty, STR_PTR("image"), STR_LEN("image")) {
                    let img: u64 = miniAnthropicImageBlock(part);
                    if img != 0 { let rc: i32 = mb_a_push_node(blocks, img); };
                };
            }
            if mb_n_count(blocks) == 0 { mb_free_doc(blocks); continue; };
            let msg: u64 = 0;
            mb_anth_from_blocks(blocks, STR_PTR("user"), STR_LEN("user"), &msg);
            mb_free_doc(blocks);
            if msg != 0 { let rc: i32 = mb_a_push_node(raw, msg); };
            continue;
        };
        if mb_s_eq(&role, STR_PTR("assistant"), STR_LEN("assistant")) {
            open_group = false;
            let blocks: u64 = mb_new_arr();
            let text = MbJson { bytes: [0u8; 262144], len: 0 };
            miniAnthropicTextOf(content, &text);
            let tt = MbStr { bytes: [0u8; 8192], len: 0 };
            mb_trim_to(mb_jp(&text), text.len, &tt);
            if tt.len > 0 {
                let b: u64 = mb_new_obj();
                let rc: i32 = mb_s_str(b, STR_PTR("type"), STR_LEN("type"), STR_PTR("text"), STR_LEN("text"));
                rc = mb_s_str(b, STR_PTR("text"), STR_LEN("text"), mb_jp(&text), text.len);
                rc = mb_a_push_node(blocks, b);
            };
            let calls: u64 = mb_g_node(item, STR_PTR("tool_calls"), STR_LEN("tool_calls"));
            if calls != 0 && mb_kind(calls) == MB_JK_ARRAY {
                let cc: u64 = mb_n_count(calls);
                let ci: u64 = 0;
                while ci < cc {
                    let tc: u64 = mb_a_at(calls, ci);
                    ci = ci + 1;
                    if tc == 0 { continue; };
                    let fnn: u64 = mb_g_node(tc, STR_PTR("function"), STR_LEN("function"));
                    let name = MbStr { bytes: [0u8; 8192], len: 0 };
                    let args_text = MbJson { bytes: [0u8; 262144], len: 0 };
                    let args_is_str: bool = false;
                    if fnn != 0 {
                        let ok1: bool = mb_g_str(fnn, STR_PTR("name"), STR_LEN("name"), &name);
                        let anode: u64 = mb_g_node(fnn, STR_PTR("arguments"), STR_LEN("arguments"));
                        if anode != 0 && mb_kind(anode) == MB_JK_STRING { args_is_str = mb_n_str_j(anode, &args_text); } else if anode == 0 { mb_jassign(&args_text, STR_PTR("{}"), STR_LEN("{}")); args_is_str = true; } else { mb_jassign(&args_text, STR_PTR("[object Object]"), STR_LEN("[object Object]")); args_is_str = true; };
                    };
                    let id = MbStr { bytes: [0u8; 8192], len: 0 };
                    if !mb_g_str(tc, STR_PTR("id"), STR_LEN("id"), &id) { let ok2: bool = mb_g_str(tc, STR_PTR("call_id"), STR_LEN("call_id"), &id); };
                    // TS String(tc?.id ?? tc?.call_id ?? ""): a non-string id
                    // stringifies; our scalar fallback mirrors that.
                    if id.len == 0 {
                        let idnode: u64 = mb_g_node(tc, STR_PTR("id"), STR_LEN("id"));
                        if idnode == 0 { idnode = mb_g_node(tc, STR_PTR("call_id"), STR_LEN("call_id")); };
                        if idnode != 0 && mb_kind(idnode) != MB_JK_STRING {
                            let t = MbJson { bytes: [0u8; 262144], len: 0 };
                            mb_json_scalar_text(idnode, &t);
                            mb_sassign_j(&id, &t);
                        };
                    };
                    if name.len == 0 || id.len == 0 { continue; };
                    let input: u64 = 0;
                    miniAnthropicSafeInput(mb_jp(&args_text), args_text.len, &input);
                    let b: u64 = mb_new_obj();
                    let rc: i32 = mb_s_str(b, STR_PTR("type"), STR_LEN("type"), STR_PTR("tool_use"), STR_LEN("tool_use"));
                    rc = mb_s_str(b, STR_PTR("id"), STR_LEN("id"), mb_sp(&id), id.len);
                    rc = mb_s_str(b, STR_PTR("name"), STR_LEN("name"), mb_sp(&name), name.len);
                    rc = mb_s_node(b, STR_PTR("input"), STR_LEN("input"), input);
                    rc = mb_a_push_node(blocks, b);
                }
            };
            if mb_n_count(blocks) == 0 { mb_free_doc(blocks); continue; };
            let msg: u64 = 0;
            mb_anth_from_blocks(blocks, STR_PTR("assistant"), STR_LEN("assistant"), &msg);
            mb_free_doc(blocks);
            if msg != 0 { let rc: i32 = mb_a_push_node(raw, msg); };
            continue;
        };
        if mb_s_eq(&role, STR_PTR("tool"), STR_LEN("tool")) {
            let id = MbStr { bytes: [0u8; 8192], len: 0 };
            if !mb_g_str(item, STR_PTR("tool_call_id"), STR_LEN("tool_call_id"), &id) { let ok: bool = mb_g_str(item, STR_PTR("id"), STR_LEN("id"), &id); };
            if id.len == 0 {
                let idnode: u64 = mb_g_node(item, STR_PTR("tool_call_id"), STR_LEN("tool_call_id"));
                if idnode == 0 { idnode = mb_g_node(item, STR_PTR("id"), STR_LEN("id")); };
                if idnode != 0 && mb_kind(idnode) != MB_JK_STRING {
                    let t = MbJson { bytes: [0u8; 262144], len: 0 };
                    mb_json_scalar_text(idnode, &t);
                    mb_sassign_j(&id, &t);
                };
            };
            if id.len == 0 { continue; };
            let result_text = MbJson { bytes: [0u8; 262144], len: 0 };
            if content != 0 && mb_kind(content) == MB_JK_STRING { let ok: bool = mb_n_str_j(content, &result_text); } else if content != 0 { let ok: bool = mb_stringify_node(content, &result_text); };
            let tt = MbStr { bytes: [0u8; 8192], len: 0 };
            mb_trim_to(mb_jp(&result_text), result_text.len, &tt);
            let b: u64 = mb_new_obj();
            let rc: i32 = mb_s_str(b, STR_PTR("type"), STR_LEN("type"), STR_PTR("tool_result"), STR_LEN("tool_result"));
            rc = mb_s_str(b, STR_PTR("tool_use_id"), STR_LEN("tool_use_id"), mb_sp(&id), id.len);
            if tt.len > 0 { rc = mb_s_str(b, STR_PTR("content"), STR_LEN("content"), mb_jp(&result_text), result_text.len); } else { rc = mb_s_str(b, STR_PTR("content"), STR_LEN("content"), STR_PTR("(empty result)"), STR_LEN("(empty result)")); };
            let one: u64 = mb_new_arr();
            rc = mb_a_push_node(one, b);
            mb_anth_push_tool_results(&raw, &open_group, one);
            mb_free_doc(one);
            continue;
        };
    }
    // Phase 2: merge consecutive same-role messages.
    let merged: u64 = mb_new_arr();
    let rc_count: u64 = mb_n_count(raw);
    let ri: u64 = 0;
    while ri < rc_count {
        let msg: u64 = mb_a_at(raw, ri);
        ri = ri + 1;
        let role = MbStr { bytes: [0u8; 8192], len: 0 };
        if msg != 0 { let ok: bool = mb_g_str(msg, STR_PTR("role"), STR_LEN("role"), &role); };
        if role.len == 0 { continue; };
        let blocks: u64 = 0;
        mb_anth_to_blocks(mb_g_node(msg, STR_PTR("content"), STR_LEN("content")), true, &blocks);
        if mb_n_count(blocks) == 0 { mb_free_doc(blocks); continue; };
        let mc: u64 = mb_n_count(merged);
        if mc > 0 {
            let prev: u64 = mb_a_at(merged, mc - 1);
            let prev_role = MbStr { bytes: [0u8; 8192], len: 0 };
            let okp: bool = mb_g_str(prev, STR_PTR("role"), STR_LEN("role"), &prev_role);
            if mb_s_eq_s(&prev_role, &role) {
                let prev_blocks: u64 = 0;
                mb_anth_to_blocks(mb_g_node(prev, STR_PTR("content"), STR_LEN("content")), true, &prev_blocks);
                let all: u64 = mb_new_arr();
                let ac: u64 = mb_n_count(prev_blocks);
                let ai: u64 = 0;
                while ai < ac { let rc: i32 = mb_a_push_node(all, mb_clone_node(mb_a_at(prev_blocks, ai))); ai = ai + 1; }
                let bc: u64 = mb_n_count(blocks);
                let bi: u64 = 0;
                while bi < bc { let rc: i32 = mb_a_push_node(all, mb_clone_node(mb_a_at(blocks, bi))); bi = bi + 1; }
                mb_free_doc(prev_blocks);
                let next: u64 = 0;
                mb_anth_from_blocks(all, mb_sp(&role), role.len, &next);
                mb_free_doc(all);
                mb_free_doc(blocks);
                if next != 0 { mb_arr_replace_last(&merged, next); };
                continue;
            };
        };
        let next: u64 = 0;
        mb_anth_from_blocks(blocks, mb_sp(&role), role.len, &next);
        mb_free_doc(blocks);
        if next != 0 { let rc: i32 = mb_a_push_node(merged, next); };
    }
    mb_free_doc(raw);
    // Phase 3: orphan tool_result filtering.
    let messages: u64 = mb_new_arr();
    let mg_count: u64 = mb_n_count(merged);
    let mi: u64 = 0;
    while mi < mg_count {
        let msg: u64 = mb_a_at(merged, mi);
        mi = mi + 1;
        let role = MbStr { bytes: [0u8; 8192], len: 0 };
        if msg != 0 { let ok: bool = mb_g_str(msg, STR_PTR("role"), STR_LEN("role"), &role); };
        if !mb_s_eq(&role, STR_PTR("user"), STR_LEN("user")) && !mb_s_eq(&role, STR_PTR("assistant"), STR_LEN("assistant")) { continue; };
        let blocks: u64 = 0;
        mb_anth_to_blocks(mb_g_node(msg, STR_PTR("content"), STR_LEN("content")), true, &blocks);
        if mb_s_eq(&role, STR_PTR("assistant"), STR_LEN("assistant")) {
            let next: u64 = 0;
            mb_anth_from_blocks(blocks, mb_sp(&role), role.len, &next);
            mb_free_doc(blocks);
            if next != 0 { let rc: i32 = mb_a_push_node(messages, next); };
            continue;
        };
        let has_result: bool = false;
        let bc: u64 = mb_n_count(blocks);
        let bi: u64 = 0;
        while bi < bc {
            let b: u64 = mb_a_at(blocks, bi);
            bi = bi + 1;
            let ty = MbStr { bytes: [0u8; 8192], len: 0 };
            if b != 0 { let ok: bool = mb_g_str(b, STR_PTR("type"), STR_LEN("type"), &ty); };
            if mb_s_eq(&ty, STR_PTR("tool_result"), STR_LEN("tool_result")) { has_result = true; };
        }
        if !has_result {
            let next: u64 = 0;
            mb_anth_from_blocks(blocks, mb_sp(&role), role.len, &next);
            mb_free_doc(blocks);
            if next != 0 { let rc: i32 = mb_a_push_node(messages, next); };
            continue;
        };
        let valid: u64 = mb_new_arr();
        let mcount: u64 = mb_n_count(messages);
        if mcount > 0 { mb_anth_tool_use_ids(mb_a_at(messages, mcount - 1), &valid); };
        let kept: u64 = mb_new_arr();
        let bi2: u64 = 0;
        while bi2 < bc {
            let b: u64 = mb_a_at(blocks, bi2);
            bi2 = bi2 + 1;
            let ty = MbStr { bytes: [0u8; 8192], len: 0 };
            if b != 0 { let ok: bool = mb_g_str(b, STR_PTR("type"), STR_LEN("type"), &ty); };
            if !mb_s_eq(&ty, STR_PTR("tool_result"), STR_LEN("tool_result")) {
                let rc: i32 = mb_a_push_node(kept, mb_clone_node(b));
            } else {
                let id = MbStr { bytes: [0u8; 8192], len: 0 };
                let has_id: bool = b != 0 && mb_g_str(b, STR_PTR("tool_use_id"), STR_LEN("tool_use_id"), &id);
                if has_id && mb_str_in_arr(valid, mb_sp(&id), id.len, false) {
                    let rc: i32 = mb_a_push_node(kept, mb_clone_node(b));
                };
            };
        }
        mb_free_doc(blocks);
        if mb_n_count(kept) == 0 { mb_free_doc(kept); mb_free_doc(valid); continue; };
        let only_orphans: bool = true;
        let kc: u64 = mb_n_count(kept);
        let ki: u64 = 0;
        while ki < kc {
            let b: u64 = mb_a_at(kept, ki);
            ki = ki + 1;
            let ty = MbStr { bytes: [0u8; 8192], len: 0 };
            if b != 0 { let ok: bool = mb_g_str(b, STR_PTR("type"), STR_LEN("type"), &ty); };
            if mb_s_eq(&ty, STR_PTR("text"), STR_LEN("text")) || mb_s_eq(&ty, STR_PTR("image"), STR_LEN("image")) { only_orphans = false; };
        }
        if only_orphans && kc != bc && mb_n_count(valid) == 0 {
            let non_result: u64 = mb_new_arr();
            let ki2: u64 = 0;
            while ki2 < kc {
                let b: u64 = mb_a_at(kept, ki2);
                ki2 = ki2 + 1;
                let ty = MbStr { bytes: [0u8; 8192], len: 0 };
                if b != 0 { let ok: bool = mb_g_str(b, STR_PTR("type"), STR_LEN("type"), &ty); };
                if !mb_s_eq(&ty, STR_PTR("tool_result"), STR_LEN("tool_result")) { let rc: i32 = mb_a_push_node(non_result, mb_clone_node(b)); };
            }
            mb_free_doc(kept);
            if mb_n_count(non_result) == 0 { mb_free_doc(non_result); mb_free_doc(valid); continue; };
            let next: u64 = 0;
            mb_anth_from_blocks(non_result, STR_PTR("user"), STR_LEN("user"), &next);
            mb_free_doc(non_result);
            mb_free_doc(valid);
            if next != 0 { let rc: i32 = mb_a_push_node(messages, next); };
            continue;
        };
        mb_free_doc(valid);
        let next: u64 = 0;
        mb_anth_from_blocks(kept, STR_PTR("user"), STR_LEN("user"), &next);
        mb_free_doc(kept);
        if next != 0 { let rc: i32 = mb_a_push_node(messages, next); };
    }
    mb_free_doc(merged);
    // Phase 4: leading assistants dropped.
    while mb_n_count(messages) > 0 {
        let role = MbStr { bytes: [0u8; 8192], len: 0 };
        let ok: bool = mb_g_str(mb_a_at(messages, 0), STR_PTR("role"), STR_LEN("role"), &role);
        if mb_s_eq(&role, STR_PTR("user"), STR_LEN("user")) { break; };
        mb_arr_drop_first(&messages);
    }
    // Phase 5: trailing assistant handling.
    let guard: u64 = 0;
    while mb_n_count(messages) > 0 && guard < 100000 {
        guard = guard + 1;
        let count: u64 = mb_n_count(messages);
        let last: u64 = mb_a_at(messages, count - 1);
        let role = MbStr { bytes: [0u8; 8192], len: 0 };
        let ok: bool = mb_g_str(last, STR_PTR("role"), STR_LEN("role"), &role);
        if !mb_s_eq(&role, STR_PTR("assistant"), STR_LEN("assistant")) { break; };
        let blocks: u64 = 0;
        mb_anth_to_blocks(mb_g_node(last, STR_PTR("content"), STR_LEN("content")), true, &blocks);
        let has_use: bool = false;
        let bc: u64 = mb_n_count(blocks);
        let bi: u64 = 0;
        while bi < bc {
            let b: u64 = mb_a_at(blocks, bi);
            bi = bi + 1;
            let ty = MbStr { bytes: [0u8; 8192], len: 0 };
            if b != 0 { let ok2: bool = mb_g_str(b, STR_PTR("type"), STR_LEN("type"), &ty); };
            if mb_s_eq(&ty, STR_PTR("tool_use"), STR_LEN("tool_use")) { has_use = true; };
        }
        mb_free_doc(blocks);
        if has_use || bc == 0 { mb_arr_pop(&messages); continue; };
        let cont: u64 = mb_new_obj();
        let rc: i32 = mb_s_str(cont, STR_PTR("role"), STR_LEN("role"), STR_PTR("user"), STR_LEN("user"));
        rc = mb_s_str(cont, STR_PTR("content"), STR_LEN("content"), STR_PTR("[Continue with the task above.]"), STR_LEN("[Continue with the task above.]"));
        rc = mb_a_push_node(messages, cont);
        break;
    }
    // Phase 6: trailing-text nudge.
    let trailing = MbJson { bytes: [0u8; 262144], len: 0 };
    let has_trailing: bool = opts != 0 && mb_g_str_j(opts, STR_PTR("trailingUserText"), STR_LEN("trailingUserText"), &trailing);
    if has_trailing {
        let tt = MbStr { bytes: [0u8; 8192], len: 0 };
        mb_trim_to(mb_jp(&trailing), trailing.len, &tt);
        if tt.len > 0 && mb_n_count(messages) > 0 {
            let count: u64 = mb_n_count(messages);
            let last: u64 = mb_a_at(messages, count - 1);
            let role = MbStr { bytes: [0u8; 8192], len: 0 };
            let ok: bool = mb_g_str(last, STR_PTR("role"), STR_LEN("role"), &role);
            if mb_s_eq(&role, STR_PTR("user"), STR_LEN("user")) {
                let blocks: u64 = 0;
                mb_anth_to_blocks(mb_g_node(last, STR_PTR("content"), STR_LEN("content")), true, &blocks);
                let has_result: bool = false;
                let has_text_or_img: bool = false;
                let bc: u64 = mb_n_count(blocks);
                let bi: u64 = 0;
                while bi < bc {
                    let b: u64 = mb_a_at(blocks, bi);
                    bi = bi + 1;
                    let ty = MbStr { bytes: [0u8; 8192], len: 0 };
                    if b != 0 { let ok2: bool = mb_g_str(b, STR_PTR("type"), STR_LEN("type"), &ty); };
                    if mb_s_eq(&ty, STR_PTR("tool_result"), STR_LEN("tool_result")) { has_result = true; };
                    if mb_s_eq(&ty, STR_PTR("text"), STR_LEN("text")) || mb_s_eq(&ty, STR_PTR("image"), STR_LEN("image")) { has_text_or_img = true; };
                }
                if has_result && !has_text_or_img {
                    let nb: u64 = mb_new_obj();
                    let rc: i32 = mb_s_str(nb, STR_PTR("type"), STR_LEN("type"), STR_PTR("text"), STR_LEN("text"));
                    rc = mb_s_str(nb, STR_PTR("text"), STR_LEN("text"), mb_jp(&trailing), trailing.len);
                    rc = mb_a_push_node(blocks, nb);
                    let nudged: u64 = 0;
                    mb_anth_from_blocks(blocks, STR_PTR("user"), STR_LEN("user"), &nudged);
                    if nudged != 0 { mb_arr_replace_last(&messages, nudged); };
                };
                mb_free_doc(blocks);
            };
        };
    };
    if mb_n_count(messages) == 0 {
        let cont: u64 = mb_new_obj();
        let rc: i32 = mb_s_str(cont, STR_PTR("role"), STR_LEN("role"), STR_PTR("user"), STR_LEN("user"));
        rc = mb_s_str(cont, STR_PTR("content"), STR_LEN("content"), STR_PTR("[Continue with the task above.]"), STR_LEN("[Continue with the task above.]"));
        rc = mb_a_push_node(messages, cont);
    };
    // Phase 7: thinking + body assembly.
    let model = MbStr { bytes: [0u8; 8192], len: 0 };
    if opts != 0 { let ok: bool = mb_g_str(opts, STR_PTR("model"), STR_LEN("model"), &model); };
    let is_claude: bool = isClaudeModelId(mb_sp(&model), model.len);
    let effort = MbStr { bytes: [0u8; 8192], len: 0 };
    let has_effort: bool = false;
    if opts != 0 { normalizeMiniEffort(mb_g_node(opts, STR_PTR("effort"), STR_LEN("effort")), &effort, &has_effort); };
    if !has_effort && is_claude { mb_sassign(&effort, STR_PTR("medium"), STR_LEN("medium")); has_effort = true; };
    let is_haiku: bool = mb_re_test(mb_sp(&model), model.len, STR_PTR("haiku"), STR_LEN("haiku"), true);
    let want_adaptive: bool = requiresAnthropicAdaptiveThinking(mb_sp(&model), model.len);
    if opts != 0 {
        let ab: bool = false;
        if mb_g_bool(opts, STR_PTR("adaptiveThinking"), STR_LEN("adaptiveThinking"), &ab) { want_adaptive = ab; };
    };
    let disable_thinking: bool = false;
    let omit_thinking: bool = false;
    if opts != 0 {
        let b1: bool = false;
        if mb_g_bool(opts, STR_PTR("disableThinking"), STR_LEN("disableThinking"), &b1) { disable_thinking = b1; };
        let b2: bool = false;
        if mb_g_bool(opts, STR_PTR("omitThinking"), STR_LEN("omitThinking"), &b2) { omit_thinking = b2; };
    };
    let want_disabled: bool = disable_thinking
        || (has_effort && mb_s_eq(&effort, STR_PTR("none"), STR_LEN("none")))
        || (!is_claude && has_effort && mb_s_eq(&effort, STR_PTR("low"), STR_LEN("low")))
        || (is_haiku && !want_adaptive && !(has_effort && (mb_s_eq(&effort, STR_PTR("high"), STR_LEN("high")) || mb_s_eq(&effort, STR_PTR("xhigh"), STR_LEN("xhigh")))));
    let max_tokens: i64 = 8192;
    if opts != 0 {
        let mt: f64 = 0.0;
        if mb_g_f64(opts, STR_PTR("maxTokens"), STR_LEN("maxTokens"), &mt) { max_tokens = mb_floor_f64(mt); };
    };
    let thinking: u64 = 0;
    let output_config: u64 = 0;
    if !omit_thinking {
        if want_adaptive {
            if !want_disabled {
                thinking = mb_new_obj();
                let rc: i32 = mb_s_str(thinking, STR_PTR("type"), STR_LEN("type"), STR_PTR("adaptive"), STR_LEN("adaptive"));
                let ae = MbStr { bytes: [0u8; 8192], len: 0 };
                let has_ae: bool = false;
                if has_effort { miniAnthropicAdaptiveEffort(mb_sp(&effort), effort.len, true, &ae, &has_ae); };
                if !has_ae { mb_sassign(&ae, STR_PTR("medium"), STR_LEN("medium")); };
                output_config = mb_new_obj();
                rc = mb_s_str(output_config, STR_PTR("effort"), STR_LEN("effort"), mb_sp(&ae), ae.len);
            };
        } else if want_disabled && (disable_thinking || has_effort || is_haiku) {
            thinking = mb_new_obj();
            let rc: i32 = mb_s_str(thinking, STR_PTR("type"), STR_LEN("type"), STR_PTR("disabled"), STR_LEN("disabled"));
        } else if is_claude && has_effort {
            let budget: i64 = 2048;
            if mb_s_eq(&effort, STR_PTR("xhigh"), STR_LEN("xhigh")) || mb_s_eq(&effort, STR_PTR("ultra"), STR_LEN("ultra")) || mb_s_eq(&effort, STR_PTR("max"), STR_LEN("max")) { budget = 8192; } else if mb_s_eq(&effort, STR_PTR("high"), STR_LEN("high")) { budget = 4096; } else if mb_s_eq(&effort, STR_PTR("minimal"), STR_LEN("minimal")) || mb_s_eq(&effort, STR_PTR("low"), STR_LEN("low")) { budget = 1024; };
            if max_tokens < budget + 2048 { max_tokens = budget + 2048; };
            thinking = mb_new_obj();
            let rc: i32 = mb_s_str(thinking, STR_PTR("type"), STR_LEN("type"), STR_PTR("enabled"), STR_LEN("enabled"));
            rc = mb_s_i64(thinking, STR_PTR("budget_tokens"), STR_LEN("budget_tokens"), budget);
        } else if !is_claude && has_effort && (mb_s_eq(&effort, STR_PTR("medium"), STR_LEN("medium")) || mb_s_eq(&effort, STR_PTR("high"), STR_LEN("high")) || mb_s_eq(&effort, STR_PTR("xhigh"), STR_LEN("xhigh"))) {
            let budget: i64 = 2048;
            if mb_s_eq(&effort, STR_PTR("xhigh"), STR_LEN("xhigh")) { budget = 8192; } else if mb_s_eq(&effort, STR_PTR("high"), STR_LEN("high")) { budget = 4096; };
            if max_tokens < budget + 2048 { max_tokens = budget + 2048; };
            thinking = mb_new_obj();
            let rc: i32 = mb_s_str(thinking, STR_PTR("type"), STR_LEN("type"), STR_PTR("enabled"), STR_LEN("enabled"));
            rc = mb_s_i64(thinking, STR_PTR("budget_tokens"), STR_LEN("budget_tokens"), budget);
        };
    };
    let body: u64 = mb_new_obj();
    let rc: i32 = mb_s_str(body, STR_PTR("model"), STR_LEN("model"), mb_sp(&model), model.len);
    rc = mb_s_i64(body, STR_PTR("max_tokens"), STR_LEN("max_tokens"), max_tokens);
    rc = mb_s_node(body, STR_PTR("messages"), STR_LEN("messages"), messages);
    rc = mb_s_bool(body, STR_PTR("stream"), STR_LEN("stream"), true);
    if thinking != 0 { rc = mb_s_node(body, STR_PTR("thinking"), STR_LEN("thinking"), thinking); };
    if output_config != 0 { rc = mb_s_node(body, STR_PTR("output_config"), STR_LEN("output_config"), output_config); };
    if mb_n_count(systems) > 0 {
        let joined = MbJson { bytes: [0u8; 262144], len: 0 };
        mb_lines_join(systems, &joined);
        // systems join with "\n\n": rebuild manually (lines_join uses "\n").
        let sj = MbJson { bytes: [0u8; 262144], len: 0 };
        let sc: u64 = mb_n_count(systems);
        let si: u64 = 0;
        while si < sc {
            if si > 0 { mb_jappend(&sj, STR_PTR("\n\n"), STR_LEN("\n\n")); };
            let s = MbStr { bytes: [0u8; 8192], len: 0 };
            let oks: bool = mb_n_str(mb_a_at(systems, si), &s);
            mb_jappend_s(&sj, &s);
            si = si + 1;
        }
        rc = mb_s_str(body, STR_PTR("system"), STR_LEN("system"), mb_jp(&sj), sj.len);
    };
    mb_free_doc(systems);
    let tools: u64 = 0;
    if opts != 0 { tools = mb_g_node(opts, STR_PTR("tools"), STR_LEN("tools")); };
    if tools != 0 && mb_kind(tools) == MB_JK_ARRAY && mb_n_count(tools) > 0 {
        let out_tools: u64 = mb_new_arr();
        let tc: u64 = mb_n_count(tools);
        let ti2: u64 = 0;
        while ti2 < tc {
            let t: u64 = mb_a_at(tools, ti2);
            ti2 = ti2 + 1;
            let entry: u64 = mb_new_obj();
            let name = MbStr { bytes: [0u8; 8192], len: 0 };
            let desc = MbStr { bytes: [0u8; 8192], len: 0 };
            if t != 0 {
                let ok1: bool = mb_g_str(t, STR_PTR("name"), STR_LEN("name"), &name);
                let ok2: bool = mb_g_str(t, STR_PTR("description"), STR_LEN("description"), &desc);
            };
            let rc2: i32 = mb_s_str(entry, STR_PTR("name"), STR_LEN("name"), mb_sp(&name), name.len);
            rc2 = mb_s_str(entry, STR_PTR("description"), STR_LEN("description"), mb_sp(&desc), desc.len);
            let schema: u64 = 0;
            if t != 0 { schema = mb_g_node(t, STR_PTR("schema"), STR_LEN("schema")); };
            let input_schema: u64 = mb_new_obj();
            if schema != 0 && mb_kind(schema) == MB_JK_OBJECT {
                // copy schema keys; ensure type:"object" when type is not a string
                let kc: u64 = mb_n_count(schema);
                let ki: u64 = 0;
                let type_is_str: bool = false;
                let tv = MbStr { bytes: [0u8; 8192], len: 0 };
                if mb_g_str(schema, STR_PTR("type"), STR_LEN("type"), &tv) { type_is_str = true; };
                if !type_is_str { let rc3: i32 = mb_s_str(input_schema, STR_PTR("type"), STR_LEN("type"), STR_PTR("object"), STR_LEN("object")); };
                while ki < kc {
                    let kp: ptr = PTR_NULL();
                    let kn: u64 = 0;
                    if mb_key_at(schema, ki, &kp, &kn) {
                        if type_is_str || !mb_bytes_eq(kp, kn, STR_PTR("type"), STR_LEN("type")) {
                            let rc3: i32 = mb_s_node(input_schema, kp, kn, mb_clone_node(mb_g_node(schema, kp, kn)));
                        } else {
                            let rc3: i32 = mb_s_node(input_schema, kp, kn, mb_clone_node(mb_g_node(schema, kp, kn)));
                        };
                    };
                    ki = ki + 1;
                }
            } else {
                let rc3: i32 = mb_s_str(input_schema, STR_PTR("type"), STR_LEN("type"), STR_PTR("object"), STR_LEN("object"));
            };
            rc2 = mb_s_node(entry, STR_PTR("input_schema"), STR_LEN("input_schema"), input_schema);
            rc2 = mb_a_push_node(out_tools, entry);
        }
        rc = mb_s_node(body, STR_PTR("tools"), STR_LEN("tools"), out_tools);
        let tcobj: u64 = mb_new_obj();
        let rc4: i32 = mb_s_str(tcobj, STR_PTR("type"), STR_LEN("type"), STR_PTR("auto"), STR_LEN("auto"));
        rc = mb_s_node(body, STR_PTR("tool_choice"), STR_LEN("tool_choice"), tcobj);
    };
    *out = body;
}

// ---- shrink family (TS:2011-2187) ----
fn MINI_SHRINK_KEEP_FULL_OUTPUTS() -> u64 { return 3; }
fn MINI_SHRINK_MAX_OUTPUT_CHARS() -> u64 { return 1000; }
fn shrinkMiniOutputText(text_p: ptr, text_n: u64, max_chars: u64, out: &MbJson) -> void {
    out.len = 0;
    if text_n <= max_chars { mb_jassign(out, text_p, text_n); return; };
    let tail_chars: u64 = (max_chars * 2) / 5;
    let head_chars: u64 = max_chars - tail_chars;
    mb_jappend(out, text_p, head_chars);
    let omitted: u64 = text_n - max_chars;
    mb_jappend(out, STR_PTR("\n…[output truncated, "), STR_LEN("\n…[output truncated, "));
    let num = MbStr { bytes: [0u8; 8192], len: 0 };
    mb_u64_to_s(omitted, &num);
    mb_jappend_s(out, &num);
    mb_jappend(out, STR_PTR(" chars omitted]\n"), STR_LEN(" chars omitted]\n"));
    mb_jappend(out, mb_ptr_add(text_p, text_n - tail_chars), tail_chars);
}
fn isMiniFileLaneArgs(args_text_p: ptr, args_text_n: u64) -> bool {
    let doc: u64 = mb_parse(args_text_p, args_text_n);
    if doc == 0 { return false; };
    if doc == 0 || mb_kind(doc) != MB_JK_OBJECT { mb_free_doc(doc); return false; };
    let action = MbStr { bytes: [0u8; 8192], len: 0 };
    let ok: bool = mb_g_str(doc, STR_PTR("action"), STR_LEN("action"), &action);
    mb_free_doc(doc);
    if !ok { return false; };
    return mb_is_file_lane_action(mb_sp(&action), action.len);
}
fn shrinkMiniOutputParts(content: u64, max_chars: u64, out: &MbJson) -> void {
    // (content: string | Array<{text?}>) -> shrunk text.
    out.len = 0;
    if content == 0 { return; };
    if mb_kind(content) == MB_JK_STRING {
        let t = MbJson { bytes: [0u8; 262144], len: 0 };
        let ok: bool = mb_n_str_j(content, &t);
        shrinkMiniOutputText(mb_jp(&t), t.len, max_chars, out);
        return;
    };
    if mb_kind(content) != MB_JK_ARRAY {
        shrinkMiniOutputText(STR_PTR(""), STR_LEN(""), max_chars, out);
        return;
    };
    let combined = MbJson { bytes: [0u8; 262144], len: 0 };
    let count: u64 = mb_n_count(content);
    let i: u64 = 0;
    let first: bool = true;
    while i < count {
        let part: u64 = mb_a_at(content, i);
        i = i + 1;
        if part == 0 { continue; };
        if mb_kind(part) == MB_JK_STRING {
            if !first { mb_jappend(&combined, STR_PTR("\n"), STR_LEN("\n")); };
            first = false;
            let t = MbJson { bytes: [0u8; 262144], len: 0 };
            let ok: bool = mb_n_str_j(part, &t);
            mb_jappend(&combined, mb_jp(&t), t.len);
        } else if mb_kind(part) == MB_JK_OBJECT {
            let t = MbStr { bytes: [0u8; 8192], len: 0 };
            let ok: bool = mb_g_str(part, STR_PTR("text"), STR_LEN("text"), &t);
            if ok {
                if !first { mb_jappend(&combined, STR_PTR("\n"), STR_LEN("\n")); };
                first = false;
                mb_jappend_s(&combined, &t);
            };
        };
    }
    shrinkMiniOutputText(mb_jp(&combined), combined.len, max_chars, out);
}
// In-place thread shrink (TS:2094-2187): `thread` is the array doc, mutated
// via path-addressed handles; returns shrink stats object.
fn shrinkMiniThreadOutputs(thread: u64, keep_full: u64, max_chars: u64, out_stats: &u64) -> void {
    let stats: u64 = mb_new_obj();
    let rc: i32 = mb_s_i64(stats, STR_PTR("shrunk"), STR_LEN("shrunk"), 0);
    rc = mb_s_i64(stats, STR_PTR("savedChars"), STR_LEN("savedChars"), 0);
    *out_stats = stats;
    if thread == 0 || mb_kind(thread) != MB_JK_ARRAY { return; };
    // Protected outputs (file-lane sa_vm calls).
    let protected_ids: u64 = mb_new_arr();
    let count: u64 = mb_n_count(thread);
    let i: u64 = 0;
    while i < count {
        let item: u64 = mb_a_at(thread, i);
        i = i + 1;
        if item == 0 || mb_kind(item) != MB_JK_OBJECT { continue; };
        let role = MbStr { bytes: [0u8; 8192], len: 0 };
        let ok: bool = mb_g_str(item, STR_PTR("role"), STR_LEN("role"), &role);
        if mb_s_eq(&role, STR_PTR("assistant"), STR_LEN("assistant")) {
            let calls: u64 = mb_g_node(item, STR_PTR("tool_calls"), STR_LEN("tool_calls"));
            if calls != 0 && mb_kind(calls) == MB_JK_ARRAY {
                let cc: u64 = mb_n_count(calls);
                let ci: u64 = 0;
                while ci < cc {
                    let tc: u64 = mb_a_at(calls, ci);
                    ci = ci + 1;
                    if tc == 0 { continue; };
                    let fnn: u64 = mb_g_node(tc, STR_PTR("function"), STR_LEN("function"));
                    let name = MbStr { bytes: [0u8; 8192], len: 0 };
                    let args = MbJson { bytes: [0u8; 262144], len: 0 };
                    if fnn != 0 {
                        let ok1: bool = mb_g_str(fnn, STR_PTR("name"), STR_LEN("name"), &name);
                        let anode: u64 = mb_g_node(fnn, STR_PTR("arguments"), STR_LEN("arguments"));
                        if anode != 0 && mb_kind(anode) == MB_JK_STRING { let ok2: bool = mb_n_str_j(anode, &args); };
                    };
                    if mb_s_eq(&name, STR_PTR("sa_vm"), STR_LEN("sa_vm")) && isMiniFileLaneArgs(mb_jp(&args), args.len) {
                        let id = MbStr { bytes: [0u8; 8192], len: 0 };
                        if !mb_g_str(tc, STR_PTR("id"), STR_LEN("id"), &id) { let ok3: bool = mb_g_str(tc, STR_PTR("call_id"), STR_LEN("call_id"), &id); };
                        if id.len > 0 { let rc2: i32 = mb_a_push_str(protected_ids, mb_sp(&id), id.len); };
                    };
                }
            };
            continue;
        };
        let ty = MbStr { bytes: [0u8; 8192], len: 0 };
        let okt: bool = mb_g_str(item, STR_PTR("type"), STR_LEN("type"), &ty);
        if mb_s_eq(&ty, STR_PTR("function_call"), STR_LEN("function_call")) || mb_s_eq(&ty, STR_PTR("custom_tool_call"), STR_LEN("custom_tool_call")) {
            let name = MbStr { bytes: [0u8; 8192], len: 0 };
            let args = MbJson { bytes: [0u8; 262144], len: 0 };
            let ok1: bool = mb_g_str(item, STR_PTR("name"), STR_LEN("name"), &name);
            let anode: u64 = mb_g_node(item, STR_PTR("arguments"), STR_LEN("arguments"));
            if anode == 0 { anode = mb_g_node(item, STR_PTR("input"), STR_LEN("input")); };
            if anode != 0 && mb_kind(anode) == MB_JK_STRING { let ok2: bool = mb_n_str_j(anode, &args); };
            if mb_s_eq(&name, STR_PTR("sa_vm"), STR_LEN("sa_vm")) && isMiniFileLaneArgs(mb_jp(&args), args.len) {
                let id = MbStr { bytes: [0u8; 8192], len: 0 };
                if !mb_g_str(item, STR_PTR("call_id"), STR_LEN("call_id"), &id) { let ok3: bool = mb_g_str(item, STR_PTR("id"), STR_LEN("id"), &id); };
                if id.len > 0 { let rc2: i32 = mb_a_push_str(protected_ids, mb_sp(&id), id.len); };
            };
        };
    }
    // Collect output items (indices).
    let outputs: u64 = mb_new_arr();
    let j: u64 = 0;
    while j < count {
        let item: u64 = mb_a_at(thread, j);
        j = j + 1;
        if item == 0 || mb_kind(item) != MB_JK_OBJECT { continue; };
        let role = MbStr { bytes: [0u8; 8192], len: 0 };
        let ty = MbStr { bytes: [0u8; 8192], len: 0 };
        let ok1: bool = mb_g_str(item, STR_PTR("role"), STR_LEN("role"), &role);
        let ok2: bool = mb_g_str(item, STR_PTR("type"), STR_LEN("type"), &ty);
        if mb_s_eq(&role, STR_PTR("tool"), STR_LEN("tool")) || mb_s_eq(&ty, STR_PTR("function_call_output"), STR_LEN("function_call_output")) {
            let idx: u64 = j - 1;
            let rc2: i32 = mb_a_push_i64(outputs, idx as i64);
        };
    }
    let oc: u64 = mb_n_count(outputs);
    let shrinkable_count: u64 = 0;
    if oc > keep_full { shrinkable_count = oc - keep_full; };
    let shrunk: i64 = 0;
    let saved: i64 = 0;
    let k: u64 = 0;
    while k < shrinkable_count {
        let idxv: f64 = 0.0;
        let oki: bool = mb_n_f64(mb_a_at(outputs, k), &idxv);
        k = k + 1;
        let item: u64 = mb_a_at(thread, idxv as u64);
        if item == 0 { continue; };
        // skip protected
        let id = MbStr { bytes: [0u8; 8192], len: 0 };
        let ty = MbStr { bytes: [0u8; 8192], len: 0 };
        let ok2: bool = mb_g_str(item, STR_PTR("type"), STR_LEN("type"), &ty);
        if mb_s_eq(&ty, STR_PTR("function_call_output"), STR_LEN("function_call_output")) {
            if !mb_g_str(item, STR_PTR("call_id"), STR_LEN("call_id"), &id) { let ok3: bool = mb_g_str(item, STR_PTR("id"), STR_LEN("id"), &id); };
        } else {
            if !mb_g_str(item, STR_PTR("tool_call_id"), STR_LEN("tool_call_id"), &id) { let ok3: bool = mb_g_str(item, STR_PTR("id"), STR_LEN("id"), &id); };
        };
        if id.len > 0 && mb_str_in_arr(protected_ids, mb_sp(&id), id.len, false) { continue; };
        let is_resp: bool = mb_s_eq(&ty, STR_PTR("function_call_output"), STR_LEN("function_call_output"));
        let field_ptr: ptr = PTR_NULL();
        let field_len: u64 = 0;
        if is_resp { field_ptr = STR_PTR("output"); field_len = STR_LEN("output"); } else { field_ptr = STR_PTR("content"); field_len = STR_LEN("content"); };
        let content: u64 = mb_g_node(item, field_ptr, field_len);
        if content == 0 { continue; };
        if mb_kind(content) == MB_JK_STRING {
            let t = MbJson { bytes: [0u8; 262144], len: 0 };
            let ok4: bool = mb_n_str_j(content, &t);
            if t.len > max_chars {
                let shrunk_text = MbJson { bytes: [0u8; 262144], len: 0 };
                shrinkMiniOutputText(mb_jp(&t), t.len, max_chars, &shrunk_text);
                let rc2: i32 = mb_s_str(item, field_ptr, field_len, mb_jp(&shrunk_text), shrunk_text.len);
                shrunk = shrunk + 1;
                saved = saved + (t.len - max_chars) as i64;
            };
        } else if mb_kind(content) == MB_JK_ARRAY {
            let before = MbJson { bytes: [0u8; 262144], len: 0 };
            let ok4: bool = mb_stringify_node(content, &before);
            let shrunk_text = MbJson { bytes: [0u8; 262144], len: 0 };
            shrinkMiniOutputParts(content, max_chars, &shrunk_text);
            if shrunk_text.len < before.len {
                let rc2: i32 = mb_s_str(item, field_ptr, field_len, mb_jp(&shrunk_text), shrunk_text.len);
                shrunk = shrunk + 1;
                saved = saved + (before.len - shrunk_text.len) as i64;
            };
        };
    }
    mb_free_doc(protected_ids);
    mb_free_doc(outputs);
    rc = mb_s_i64(stats, STR_PTR("shrunk"), STR_LEN("shrunk"), shrunk);
    rc = mb_s_i64(stats, STR_PTR("savedChars"), STR_LEN("savedChars"), saved);
}
// ---- usage build/merge + auto-compact (TS:2188-2328 subset; rest in B5/B7) ----
fn buildMiniTokenUsage(totals: u64, round: u64, context_window: f64, out: &u64) -> void {
    let body: u64 = mb_new_obj();
    let total: u64 = mb_new_obj();
    let last: u64 = mb_new_obj();
    let copy_keys: [ptr; 6] = [STR_PTR("inputTokens"), STR_PTR("cachedInputTokens"), STR_PTR("cacheWriteInputTokens"), STR_PTR("outputTokens"), STR_PTR("reasoningOutputTokens"), STR_PTR("totalTokens")];
    let copy_lens: [u64; 6] = [STR_LEN("inputTokens"), STR_LEN("cachedInputTokens"), STR_LEN("cacheWriteInputTokens"), STR_LEN("outputTokens"), STR_LEN("reasoningOutputTokens"), STR_LEN("totalTokens")];
    let ki: u64 = 0;
    while ki < 6 {
        let v: f64 = 0.0;
        if totals != 0 && mb_g_f64(totals, copy_keys[ki], copy_lens[ki], &v) { let rc: i32 = mb_s_f64(total, copy_keys[ki], copy_lens[ki], v); };
        let v2: f64 = 0.0;
        if round != 0 && mb_g_f64(round, copy_keys[ki], copy_lens[ki], &v2) { let rc: i32 = mb_s_f64(last, copy_keys[ki], copy_lens[ki], v2); };
        ki = ki + 1;
    }
    let rc: i32 = mb_s_bool(total, STR_PTR("reasoningIncludedInOutput"), STR_LEN("reasoningIncludedInOutput"), true);
    rc = mb_s_bool(last, STR_PTR("reasoningIncludedInOutput"), STR_LEN("reasoningIncludedInOutput"), true);
    rc = mb_s_node(body, STR_PTR("total"), STR_LEN("total"), total);
    rc = mb_s_node(body, STR_PTR("last"), STR_LEN("last"), last);
    let ctx: u64 = mb_new_obj();
    let rin: f64 = 0.0;
    if round != 0 { let ok: bool = mb_g_f64(round, STR_PTR("inputTokens"), STR_LEN("inputTokens"), &rin); };
    rc = mb_s_f64(ctx, STR_PTR("inputTokens"), STR_LEN("inputTokens"), rin);
    rc = mb_s_f64(ctx, STR_PTR("cachedInputTokens"), STR_LEN("cachedInputTokens"), 0.0);
    rc = mb_s_f64(ctx, STR_PTR("cacheWriteInputTokens"), STR_LEN("cacheWriteInputTokens"), 0.0);
    rc = mb_s_f64(ctx, STR_PTR("outputTokens"), STR_LEN("outputTokens"), 0.0);
    rc = mb_s_f64(ctx, STR_PTR("reasoningOutputTokens"), STR_LEN("reasoningOutputTokens"), 0.0);
    rc = mb_s_f64(ctx, STR_PTR("totalTokens"), STR_LEN("totalTokens"), rin);
    rc = mb_s_bool(ctx, STR_PTR("reasoningIncludedInOutput"), STR_LEN("reasoningIncludedInOutput"), true);
    rc = mb_s_node(body, STR_PTR("contextUsage"), STR_LEN("contextUsage"), ctx);
    rc = mb_s_f64(body, STR_PTR("modelContextWindow"), STR_LEN("modelContextWindow"), context_window);
    *out = body;
}
fn mergeMiniUsageDelta(base: u64, has_base: bool, next: u64, has_next: bool, out: &u64, out_has: &bool) -> void {
    *out = 0;
    *out_has = false;
    if !has_next { if has_base { *out = mb_clone_node(base); *out_has = true; }; return; };
    if !has_base { *out = mb_clone_node(next); *out_has = true; return; };
    let merged: u64 = mb_new_obj();
    let keys: [ptr; 2] = [STR_PTR("inputTokens"), STR_PTR("outputTokens")];
    let lens: [u64; 2] = [STR_LEN("inputTokens"), STR_LEN("outputTokens")];
    let ki: u64 = 0;
    while ki < 2 {
        let a: f64 = 0.0;
        let b: f64 = 0.0;
        let oka: bool = mb_g_f64(base, keys[ki], lens[ki], &a);
        let okb: bool = mb_g_f64(next, keys[ki], lens[ki], &b);
        let rc: i32 = mb_s_f64(merged, keys[ki], lens[ki], a + b);
        ki = ki + 1;
    }
    let opt_keys: [ptr; 4] = [STR_PTR("cachedInputTokens"), STR_PTR("cacheWriteInputTokens"), STR_PTR("reasoningOutputTokens"), STR_PTR("totalTokens")];
    let opt_lens: [u64; 4] = [STR_LEN("cachedInputTokens"), STR_LEN("cacheWriteInputTokens"), STR_LEN("reasoningOutputTokens"), STR_LEN("totalTokens")];
    let oi: u64 = 0;
    while oi < 4 {
        let a: f64 = 0.0;
        let b: f64 = 0.0;
        let oka: bool = mb_g_f64(base, opt_keys[oi], opt_lens[oi], &a);
        let okb: bool = mb_g_f64(next, opt_keys[oi], opt_lens[oi], &b);
        if oka || okb { let rc: i32 = mb_s_f64(merged, opt_keys[oi], opt_lens[oi], a + b); };
        oi = oi + 1;
    }
    *out = merged;
    *out_has = true;
}
fn MINI_AUTO_COMPACT_DEFAULT_THRESHOLD() -> f64 { return 80.0; }
fn MINI_AUTO_COMPACT_MIN_THRESHOLD() -> f64 { return 50.0; }
fn MINI_AUTO_COMPACT_MAX_THRESHOLD() -> f64 { return 95.0; }
fn MINI_AUTO_COMPACT_COOLDOWN_MS() -> u64 { return 60000; }
fn miniAutoCompactThreshold() -> f64 {
    let raw = MbStr { bytes: [0u8; 8192], len: 0 };
    let has: bool = mb_env_get(STR_PTR("MINI_AUTO_COMPACT_THRESHOLD"), STR_LEN("MINI_AUTO_COMPACT_THRESHOLD"), &raw);
    if !has { return MINI_AUTO_COMPACT_DEFAULT_THRESHOLD(); };
    let parsed: f64 = 0.0;
    if !mb_parse_f64(mb_sp(&raw), raw.len, &parsed) { return MINI_AUTO_COMPACT_DEFAULT_THRESHOLD(); };
    if parsed != parsed { return MINI_AUTO_COMPACT_DEFAULT_THRESHOLD(); };
    let rounded: f64 = mb_round_half(parsed);
    if rounded < MINI_AUTO_COMPACT_MIN_THRESHOLD() { return MINI_AUTO_COMPACT_MIN_THRESHOLD(); };
    if rounded > MINI_AUTO_COMPACT_MAX_THRESHOLD() { return MINI_AUTO_COMPACT_MAX_THRESHOLD(); };
    return rounded;
}
fn miniAutoCompactEnabled() -> bool {
    let raw = MbStr { bytes: [0u8; 8192], len: 0 };
    let has: bool = mb_env_get(STR_PTR("MINI_AUTO_COMPACT"), STR_LEN("MINI_AUTO_COMPACT"), &raw);
    if !has { return true; };
    let low = MbStr { bytes: [0u8; 8192], len: 0 };
    mb_lower_into(mb_sp(&raw), raw.len, &low);
    let t = MbStr { bytes: [0u8; 8192], len: 0 };
    mb_trim_to(mb_sp(&low), low.len, &t);
    return !(mb_s_eq(&t, STR_PTR("off"), STR_LEN("off")) || mb_s_eq(&t, STR_PTR("false"), STR_LEN("false")) || mb_s_eq(&t, STR_PTR("0"), STR_LEN("0")) || mb_s_eq(&t, STR_PTR("no"), STR_LEN("no")));
}
fn shouldMiniAutoCompact(session: u64, now_ms: u64) -> bool {
    if !miniAutoCompactEnabled() { return false; };
    if session == 0 { return false; };
    let messages: u64 = mb_g_node(session, STR_PTR("messages"), STR_LEN("messages"));
    if messages == 0 || mb_kind(messages) != MB_JK_ARRAY || mb_n_count(messages) <= 2 { return false; };
    let usage: u64 = mb_g_node(session, STR_PTR("lastUsage"), STR_LEN("lastUsage"));
    let used: f64 = 0.0;
    if usage != 0 { let ok: bool = mb_g_f64(usage, STR_PTR("inputTokens"), STR_LEN("inputTokens"), &used); };
    let window: f64 = 0.0;
    let okw: bool = mb_g_f64(session, STR_PTR("contextWindow"), STR_LEN("contextWindow"), &window);
    if !(used > 0.0) || !(window > 0.0) { return false; };
    let ratio: f64 = used / window;
    let threshold: f64 = miniAutoCompactThreshold() / 100.0;
    if ratio < threshold { return false; };
    let last_at: f64 = 0.0;
    let okl: bool = mb_g_f64(session, STR_PTR("lastAutoCompactAt"), STR_LEN("lastAutoCompactAt"), &last_at);
    let elapsed: i64 = now_ms as i64 - last_at as i64;
    if elapsed < MINI_AUTO_COMPACT_COOLDOWN_MS() as i64 { return false; };
    return true;
}
// ---- tilde family (TS:2330-2380) ----
fn mb_is_tilde_path(v_p: ptr, v_n: u64) -> bool {
    if v_n == 1 && mb_byte_at(v_p, 0) == 126 { return true; };
    if v_n >= 2 && mb_byte_at(v_p, 0) == 126 && (mb_byte_at(v_p, 1) == 47 || mb_byte_at(v_p, 1) == 92) { return true; };
    return false;
}
// Local faithful expandLeadingTilde (TS imageView.ts:6-14). Registered: the
// sibling imageView.sla expandLeadingTilde is an identity stub (DEFECT-noted
// there), so the bridge carries its own copy bound to $HOME directly.
fn mb_expand_leading_tilde(p: ptr, n: u64, out: &MbStr) -> void {
    out.len = 0;
    if !mb_is_tilde_path(p, n) { mb_sassign(out, p, n); return; };
    let home = MbStr { bytes: [0u8; 8192], len: 0 };
    let has_home: bool = mb_env_get(STR_PTR("HOME"), STR_LEN("HOME"), &home);
    if !has_home || home.len == 0 { mb_sassign(out, p, n); return; };
    if n == 1 { mb_sassign(out, mb_sp(&home), home.len); return; };
    // "~/" or "~\\": home + "/" + rest (TS normalizes the separator to "/").
    mb_sassign(out, mb_sp(&home), home.len);
    mb_sappend(out, STR_PTR("/"), STR_LEN("/"));
    mb_sappend(out, mb_ptr_add(p, 2), n - 2);
}
fn mb_is_tilde_field(kp: ptr, kn: u64) -> bool {
    return mb_bytes_eq(kp, kn, STR_PTR("path"), STR_LEN("path"))
        || mb_bytes_eq(kp, kn, STR_PTR("file"), STR_LEN("file"))
        || mb_bytes_eq(kp, kn, STR_PTR("target"), STR_LEN("target"))
        || mb_bytes_eq(kp, kn, STR_PTR("dir"), STR_LEN("dir"))
        || mb_bytes_eq(kp, kn, STR_PTR("directory"), STR_LEN("directory"))
        || mb_bytes_eq(kp, kn, STR_PTR("cwd"), STR_LEN("cwd"))
        || mb_bytes_eq(kp, kn, STR_PTR("from"), STR_LEN("from"))
        || mb_bytes_eq(kp, kn, STR_PTR("to"), STR_LEN("to"))
        || mb_bytes_eq(kp, kn, STR_PTR("destination"), STR_LEN("destination"))
        || mb_bytes_eq(kp, kn, STR_PTR("dest"), STR_LEN("dest"));
}
fn mb_expand_tilde_obj(obj: u64, out: &u64) -> void {
    let next: u64 = mb_new_obj();
    *out = next;
    if obj == 0 || mb_kind(obj) != MB_JK_OBJECT { return; };
    let kc: u64 = mb_n_count(obj);
    let ki: u64 = 0;
    while ki < kc {
        let kp: ptr = PTR_NULL();
        let kn: u64 = 0;
        ki = ki + 1;
        if !mb_key_at(obj, ki - 1, &kp, &kn) { continue; };
        let value: u64 = mb_g_node(obj, kp, kn);
        if mb_is_tilde_field(kp, kn) && value != 0 && mb_kind(value) == MB_JK_STRING {
            let v = MbStr { bytes: [0u8; 8192], len: 0 };
            let ok: bool = mb_n_str(value, &v);
            if mb_is_tilde_path(mb_sp(&v), v.len) {
                let expanded = MbStr { bytes: [0u8; 8192], len: 0 };
                mb_expand_leading_tilde(mb_sp(&v), v.len, &expanded);
                let rc: i32 = mb_s_str(next, kp, kn, mb_sp(&expanded), expanded.len);
                continue;
            };
        };
        if (mb_bytes_eq(kp, kn, STR_PTR("parallel"), STR_LEN("parallel")) || mb_bytes_eq(kp, kn, STR_PTR("tasks"), STR_LEN("tasks"))) && value != 0 && mb_kind(value) == MB_JK_ARRAY {
            let arr: u64 = mb_new_arr();
            let ac: u64 = mb_n_count(value);
            let ai: u64 = 0;
            while ai < ac {
                let entry: u64 = mb_a_at(value, ai);
                ai = ai + 1;
                if entry != 0 && mb_kind(entry) == MB_JK_OBJECT {
                    let sub: u64 = 0;
                    mb_expand_tilde_obj(entry, &sub);
                    let rc: i32 = mb_a_push_node(arr, sub);
                } else {
                    let rc: i32 = mb_a_push_node(arr, mb_clone_node(entry));
                };
            }
            let rc: i32 = mb_s_node(next, kp, kn, arr);
            continue;
        };
        let rc: i32 = mb_s_node(next, kp, kn, mb_clone_node(value));
    }
}
fn expandMiniTildeArgs(args: u64, out: &u64) -> void {
    if args == 0 || mb_kind(args) != MB_JK_OBJECT { *out = mb_new_obj(); return; };
    mb_expand_tilde_obj(args, out);
}
// ---- subagent consts (TS:2382-2404) ----
fn MINI_SUBAGENT_MAX_DEPTH() -> u64 { return 1; }
fn MINI_SUBAGENT_DEFAULT_MAX_CHILDREN() -> u64 { return 5; }
fn MINI_SUBAGENT_DEFAULT_WAIT_MS() -> u64 { return 60000; }
fn MINI_SUBAGENT_MIN_WAIT_MS() -> u64 { return 1000; }
fn MINI_SUBAGENT_MAX_WAIT_MS() -> u64 { return 300000; }
const MINI_SUBAGENT_MAX_CHILDREN: u64 = 5;
fn miniSubagentMaxChildren() -> u64 {
    let raw = MbStr { bytes: [0u8; 8192], len: 0 };
    let has: bool = mb_env_get(STR_PTR("MINI_SUBAGENT_MAX_CHILDREN"), STR_LEN("MINI_SUBAGENT_MAX_CHILDREN"), &raw);
    if !has || raw.len == 0 { return MINI_SUBAGENT_DEFAULT_MAX_CHILDREN(); };
    let parsed: f64 = 0.0;
    if !mb_parse_f64(mb_sp(&raw), raw.len, &parsed) { return MINI_SUBAGENT_DEFAULT_MAX_CHILDREN(); };
    let n: i64 = mb_floor_f64(parsed);
    if n < 1 { return MINI_SUBAGENT_DEFAULT_MAX_CHILDREN(); };
    if n > 32 { return 32; };
    return n as u64;
}

// ---- tool tables (TS:2196-2210, 2259-2269; image_view from imageView.ts:38-55) ----
// The tables are data: carried as verbatim JSON text (extracted mechanically
// from the TS literals) and parsed on demand.
fn mb_mini_tools(out: &u64) -> void {
    let text: ptr = STR_PTR("[{\"name\":\"sa_vm\",\"description\":\"Ultra workspace tools: {action, ...flat params}, e.g. {action:\\\"read_file\\\",path:\\\"package.json\\\"}; never nest file paths in args. For independent reads/searches, send multiple sa_vm calls in ONE round (native parallel, read-only calls run concurrently). Batch only independent work: never dependent steps, never writes, never the same path twice in one round. sa_vm parallel is temporarily disabled (use native multi-call; batch writes go sequential or apply_patch). Paths are workspace-relative (~ allowed). Actions include read_file/read_lines/read_many/list_dir/find_files/grep_search/write_file/edit_file/apply_patch, split_plan/split_stage/split_refine/split_repair/split_status, run_bun, run_host {command or exe,args[]} (safe git writes go here, e.g. {exe:\\\"git\\\",args:[\\\"checkout\\\",\\\"<branch>\\\"]} or [\\\"switch\\\",\\\"<branch>\\\"] or [\\\"fetch\\\"]; clean/revert/reset --hard stay blocked), git_status/git_diff/git_log {max_count?,revision?} (read-only: status/diff/log only, never for switching branches), session/checkpoint tools (local_checkpoint {message?} snapshots dirty worktree to a git commit; restore_checkpoint {commit} rolls back), and JEV decision actions (jev_done {user_request,actual_work,evidence} for delivery sign-off, jev_choose, jev_checklist, jev_thinking, jev_redteam, jev_rank, jev_scope, jev_dispatch, jev_consistency, jev_diagnose, jev_edge_cases, jev_blast_radius, jev_intent, jev_next, jev_compress, jev_progress). Delivery sign-off: call jev_done with {user_request,actual_work,evidence} before completing implementation work. Writes: write_file needs {path,content} (create/overwrite whole file); edit_file needs {path,old_text,new_text} with old_text copied EXACTLY from a prior read (long unique context, never type definitions as values; set replaceAll:true only to replace every occurrence); apply_patch needs {patch} with *** Begin Patch envelope (NOT a raw unified diff; single-file edits prefer edit_file). NEVER use {input,output} for edits - they are not edit params. Reads: read_many needs {files:[up to 10]} with one shared slice (different slices use parallel). Splits: split_plan {path,task} -> split_stage/split_refine {session_id,module_name,ops:[{path,content|patch}]} (content XOR patch, 1-20 ops, no delete/rename) -> split_repair phase=diff then validate then commit {confirm:true}. read_skill is optional: load a listed skill only when the task needs its specialized guidance.\",\"schema\":{\"type\":\"object\",\"properties\":{\"action\":{\"type\":\"string\"},\"path\":{\"type\":\"string\"},\"query\":{\"type\":\"string\"},\"content\":{\"type\":\"string\"},\"old_text\":{\"type\":\"string\",\"description\":\"Exact existing text to replace for edit_file (must match file verbatim).\"},\"new_text\":{\"type\":\"string\",\"description\":\"Replacement text for edit_file.\"},\"replaceAll\":{\"type\":\"boolean\",\"description\":\"Replace every occurrence for edit_file (default false, requires unique context otherwise).\"},\"patch\":{\"type\":\"string\",\"description\":\"Patch text with *** Begin Patch envelope (*** Update File: + @@ hunks); raw unified diffs are rejected.\"},\"diff\":{\"type\":\"string\"},\"from\":{\"type\":\"string\"},\"to\":{\"type\":\"string\"},\"source\":{\"type\":\"string\"},\"dest\":{\"type\":\"string\"},\"parallel\":{\"type\":\"array\",\"description\":\"Independent subtasks [{action,...flat params}]; never nest parallel, never repeat same path, never mix writes with reads of same file.\"},\"files\":{\"type\":\"array\"},\"ops\":{\"type\":\"array\"},\"phase\":{\"type\":\"string\"},\"module_name\":{\"type\":\"string\"},\"task\":{\"type\":\"string\"},\"confirm\":{\"type\":\"boolean\"},\"max_tokens\":{\"type\":\"number\"},\"max_tokens_per_file\":{\"type\":\"number\"},\"exe\":{\"type\":\"string\"},\"command\":{\"type\":\"string\",\"description\":\"Command string for run_host, e.g. 'git log --oneline -10'.\"},\"session_id\":{\"type\":\"string\"},\"input\":{\"type\":\"string\"},\"commit\":{\"type\":\"string\"},\"yield_time_ms\":{\"type\":\"number\"},\"start_line\":{\"type\":\"number\"},\"end_line\":{\"type\":\"number\"},\"dir\":{\"type\":\"string\"},\"pattern\":{\"type\":\"string\"},\"depth\":{\"type\":\"number\"},\"max_entries\":{\"type\":\"number\"},\"max_count\":{\"type\":\"number\",\"description\":\"Max commits to display for git_log (default 10).\"},\"revision\":{\"type\":\"string\",\"description\":\"Git revision or range for git_log / git_diff (e.g. 'HEAD~5' or 'main..HEAD').\"},\"args\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"user_request\":{\"type\":\"string\",\"description\":\"Original user request for jev_done delivery review.\"},\"actual_work\":{\"type\":\"string\",\"description\":\"Actual work performed for jev_done.\"},\"evidence\":{\"type\":\"string\",\"description\":\"Verification evidence for jev_done.\"},\"question\":{\"type\":\"string\",\"description\":\"Question or goal for JEV decision actions.\"},\"options\":{\"type\":\"object\",\"description\":\"Options or hypotheses for JEV decision actions.\"},\"checks\":{\"type\":\"object\",\"description\":\"Checklist criteria for JEV decision actions.\"}},\"required\":[\"action\"],\"additionalProperties\":true}},{\"name\":\"read_skill\",\"description\":\"Load a listed SKILL.md by name (e.g. {\\\"name\\\":\\\"sa-vm\\\"}) when the task needs that skill's specialized guidance. Common sa_vm actions are described on the tool itself.\",\"schema\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"}},\"required\":[\"name\"],\"additionalProperties\":false}},{\"name\":\"image_view\",\"description\":\"View a local image file for visual inspection (screenshots, mockups, diagrams, photos). Ask JEV to choose analysisMode when the task is ambiguous: \\\"ui\\\" (screen layout), \\\"ocr\\\" (text), \\\"shape\\\" (contours/geometry/silhouette), \\\"pixel\\\" (transparency/colors), \\\"diagram\\\", or \\\"photo\\\". Args: {path (REQUIRED, workspace-relative, absolute, or ~/ image path; local files only, no URLs), analysisMode (\\\"auto\\\" default, or ui|ocr|shape|pixel|diagram|photo), task (short analysis goal), size (optional override: \\\"720p\\\" or \\\"original\\\"), color (optional override: \\\"rgb\\\", \\\"rgba\\\", or \\\"gray\\\")}. The selected mode controls resize/color/detail to avoid sending unnecessarily expensive pixels.\",\"schema\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\",\"description\":\"Local image path (workspace-relative, absolute, or ~/); no URLs.\"},\"analysisMode\":{\"type\":\"string\",\"enum\":[\"auto\",\"ui\",\"ocr\",\"shape\",\"pixel\",\"diagram\",\"photo\"],\"description\":\"JEV-selected visual analysis mode.\"},\"task\":{\"type\":\"string\",\"description\":\"Short visual analysis goal used by auto mode.\"},\"size\":{\"type\":\"string\",\"enum\":[\"original\",\"720p\"],\"description\":\"\\\"720p\\\" (default) or \\\"original\\\".\"},\"color\":{\"type\":\"string\",\"enum\":[\"rgba\",\"rgb\",\"gray\"],\"description\":\"\\\"rgb\\\" (default), \\\"rgba\\\", or \\\"gray\\\".\"}},\"required\":[\"path\"],\"additionalProperties\":false}},{\"name\":\"update_plan\",\"description\":\"Track multi-step work, code modifications, and tasks with a structured todo list. Proactively call update_plan at the start of multi-step or exploratory work to establish your checklist, then update statuses (pending, in_progress, completed) as work completes. Each call replaces the whole list. Args: {todos:[{content,status}]} or {steps:[{step,status}]}; status is pending|in_progress|completed.\",\"schema\":{\"type\":\"object\",\"properties\":{\"todos\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"content\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"},\"id\":{\"type\":\"string\"}}}},\"steps\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"step\":{\"type\":\"string\"},\"text\":{\"type\":\"string\"},\"status\":{\"type\":\"string\"}}}},\"explanation\":{\"type\":\"string\"}},\"additionalProperties\":true}},{\"name\":\"request_user_input\",\"description\":\"Ask the user structured clarification questions mid-turn when a blocking requirement, design preference, or ambiguous goal cannot be resolved autonomously. Execution pauses until the user responds in a dialog modal, and returns their structured choices. Args: {questions:[{id?,question,header?,options?,is_multi_select?}]}. Example: {\\\"questions\\\":[{\\\"id\\\":\\\"choice\\\",\\\"question\\\":\\\"Select build target\\\",\\\"options\\\":[\\\"Debug\\\",\\\"Release\\\"]}]}\",\"schema\":{\"type\":\"object\",\"properties\":{\"questions\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"id\":{\"type\":\"string\"},\"question\":{\"type\":\"string\"},\"header\":{\"type\":\"string\"},\"options\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"is_multi_select\":{\"type\":\"boolean\"}},\"required\":[\"question\"]}}},\"required\":[\"questions\"],\"additionalProperties\":true}},{\"name\":\"web_search\",\"description\":\"Search the web for technical documentation, API specifications, release notes, and error resolution. Args: {query, max_results?}. Returns search results with titles, URLs, and text snippets.\",\"schema\":{\"type\":\"object\",\"properties\":{\"query\":{\"type\":\"string\",\"description\":\"Search query or error message\"},\"max_results\":{\"type\":\"number\",\"description\":\"Max results (1-10, default 5)\"}},\"required\":[\"query\"],\"additionalProperties\":false}},{\"name\":\"list_mcp_resources\",\"description\":\"List files/objects exposed by MCP servers (config.toml [mcp_servers.*]). Args: {server?} - omit for all connected servers. Read one with read_mcp_resource.\",\"schema\":{\"type\":\"object\",\"properties\":{\"server\":{\"type\":\"string\"}},\"additionalProperties\":false}},{\"name\":\"read_mcp_resource\",\"description\":\"Read one MCP server resource as text. Arg