        let has_model: bool = mb_g_str(s, STR_PTR("model"), STR_LEN("model"), &model);
        rc = mb_s_str(tobj, STR_PTR("model"), STR_LEN("model"), mb_sp(&model), model.len);
        let sbn: u64 = mb_g_node(s, STR_PTR("sandbox"), STR_LEN("sandbox"));
        if sbn != 0 { rc = mb_s_node(tobj, STR_PTR("sandbox"), STR_LEN("sandbox"), mb_clone_node(sbn)); } else { rc = mb_s_null(tobj, STR_PTR("sandbox"), STR_LEN("sandbox")); };
        let apn: u64 = mb_g_node(s, STR_PTR("approvalPolicy"), STR_LEN("approvalPolicy"));
        if apn != 0 { rc = mb_s_node(tobj, STR_PTR("approvalPolicy"), STR_LEN("approvalPolicy"), mb_clone_node(apn)); } else { rc = mb_s_null(tobj, STR_PTR("approvalPolicy"), STR_LEN("approvalPolicy")); };
        rc = mb_s_str(tobj, STR_PTR("status"), STR_LEN("status"), STR_PTR("active"), STR_LEN("active"));
        rc = mb_s_i64(tobj, STR_PTR("createdAt"), STR_LEN("createdAt"), mb_now_ms());
        let res: u64 = mb_new_obj();
        rc = mb_s_node(res, STR_PTR("thread"), STR_LEN("thread"), tobj);
        rc = mb_s_str(res, STR_PTR("threadId"), STR_LEN("threadId"), mb_sp(&thread), thread.len);
        *out = res;
        return;
    };
    if mb_bytes_eq(method_p, method_n, STR_PTR("thread/read"), STR_LEN("thread/read")) || mb_bytes_eq(method_p, method_n, STR_PTR("thread/resume"), STR_LEN("thread/resume")) {
        let is_resume: bool = mb_bytes_eq(method_p, method_n, STR_PTR("thread/resume"), STR_LEN("thread/resume"));
        let thread = MbStr { bytes: [0u8; 8192], len: 0 };
        mb_req_id(rr, STR_PTR("threadId"), STR_LEN("threadId"), &thread);
        let owner = MbStr { bytes: [0u8; 8192], len: 0 };
        let has_owner: bool = mb_g_str(rr, STR_PTR("ownerId"), STR_LEN("ownerId"), &owner);
        let include_turns: bool = true;
        let itv: bool = true;
        if mb_g_bool(rr, STR_PTR("includeTurns"), STR_LEN("includeTurns"), &itv) { include_turns = itv; };
        let s: u64 = 0;
        let has_s: bool = false;
        MiniBridge_get_or_restore_session(b, mb_sp(&thread), thread.len, mb_sp(&owner), owner.len, has_owner, &s, &has_s);
        if !has_s {
            if is_resume {
