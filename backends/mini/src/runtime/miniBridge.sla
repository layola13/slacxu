}
fn mb_mini_subagent_tools(out: &u64) -> void {
    let text: ptr = STR_PTR("[{\"name\":\"spawn_agent\",\"description\":\"Delegate an independent subtask to a sub-agent (child thread with same workspace/relay/model). Args: {task_name,message,agent_type?} - task_name AND message are BOTH required. task_name uses lowercase letters, digits, underscores. message is a plain-text task brief (NEVER todos/steps - use update_plan separately for checklists). Example: {\\\"task_name\\\":\\\"task_a\\\",\\\"message\\\":\\\"Read package.json via sa_vm read_file and report name and version.\\\"}. Returns {agent_id,task_name,nickname,status}. Max 5 live children, depth limit 1 (children cannot spawn).\",\"schema\":{\"type\":\"object\",\"properties\":{\"task_name\":{\"type\":\"string\",\"description\":\"REQUIRED. Canonical task name: lowercase letters, digits, underscores.\"},\"taskName\":{\"type\":\"string\"},\"message\":{\"type\":\"string\",\"description\":\"REQUIRED. Plain-text task brief. Never pass update_plan todos/steps here.\"},\"prompt\":{\"type\":\"string\"},\"text\":{\"type\":\"string\"},\"agent_type\":{\"type\":\"string\"},\"agentType\":{\"type\":\"string\"}},\"required\":[\"task_name\",\"message\"],\"additionalProperties\":false}},{\"name\":\"send_message\",\"description\":\"Queue a message on an existing sub-agent without starting a new turn. Args: {target,message}. target is agent_id (or task_name). The message waits in its inbox; use followup_task to trigger the next turn, interrupt_agent to redirect a running turn. Reuse agents when the follow-up depends on their previous context.\",\"schema\":{\"type\":\"object\",\"properties\":{\"target\":{\"type\":\"string\"},\"id\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"},\"text\":{\"type\":\"string\"}},\"required\":[\"target\",\"message\"],\"additionalProperties\":false}},{\"name\":\"followup_task\",\"description\":\"Send a follow-up task to an existing sub-agent and trigger a turn if it is idle. Args: {target,message}. target is agent_id (or task_name). If the agent is already running, the task is queued for its next turn; use interrupt_agent first to redirect the current turn instead.\",\"schema\":{\"type\":\"object\",\"properties\":{\"target\":{\"type\":\"string\"},\"id\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"},\"text\":{\"type\":\"string\"}},\"required\":[\"target\",\"message\"],\"additionalProperties\":false}},{\"name\":\"read_agent_report\",\"description\":\"Read a finished sub-agent full final report. Args: {target}. target is agent_id (or task_name). wait_agent returns status only; use this to fetch report content on demand.\",\"schema\":{\"type\":\"object\",\"properties\":{\"target\":{\"type\":\"string\"},\"id\":{\"type\":\"string\"}},\"required\":[\"target\"],\"additionalProperties\":false}},{\"name\":\"interrupt_agent\",\"description\":\"Interrupt a sub-agent's current turn, if any, and return its previous status. Args: {target}. The agent remains available for messages and follow-up tasks.\",\"schema\":{\"type\":\"object\",\"properties\":{\"target\":{\"type\":\"string\"},\"id\":{\"type\":\"string\"}},\"required\":[\"target\"],\"additionalProperties\":false}},{\"name\":\"wait_agent\",\"description\":\"Wait for sub-agent mailbox activity or terminal status. Args: {targets,timeout_ms?}. targets is a list of agent_id (or single target). Returns {agents:[{agent_id,status,has_report,report?}],timedOut}; completed reports are returned inline (capped) and also delivered to the parent live thread, so do NOT call read_agent_report for reports already included here.\",\"schema\":{\"type\":\"object\",\"properties\":{\"targets\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"target\":{\"type\":\"string\"},\"timeout_ms\":{\"type\":\"number\"},\"timeoutMs\":{\"type\":\"number\"}},\"additionalProperties\":false}},{\"name\":\"close_agent\",\"description\":\"Close a finished sub-agent and free its concurrency slot. Args: {target}. Completed agents count toward the 5-agent limit until closed - do not keep agents open longer than needed. The child rollout is retained and can be reopened with resume_agent.\",\"schema\":{\"type\":\"object\",\"properties\":{\"target\":{\"type\":\"string\"},\"id\":{\"type\":\"string\"}},\"required\":[\"target\"],\"additionalProperties\":false}},{\"name\":\"resume_agent\",\"description\":\"Resume a previously closed sub-agent by id so it can receive follow-up tasks and wait_agent calls. Args: {target}. target is agent_id (or task_name) of a child closed by close_agent. Returns {agent_id,status,resumed}.\",\"schema\":{\"type\":\"object\",\"properties\":{\"target\":{\"type\":\"string\"},\"id\":{\"type\":\"string\"}},\"required\":[\"target\"],\"additionalProperties\":false}},{\"name\":\"list_agents\",\"description\":\"List your live sub-agents with task names and statuses.\",\"schema\":{\"type\":\"object\",\"properties\":{\"path_prefix\":{\"type\":\"string\"}},\"additionalProperties\":false}}]");
    let n: u64 = STR_LEN("[{\"name\":\"spawn_agent\",\"description\":\"Delegate an independent subtask to a sub-agent (child thread with same workspace/relay/model). Args: {task_name,message,agent_type?} - task_name AND message are BOTH required. task_name uses lowercase letters, digits, underscores. message is a plain-text task brief (NEVER todos/steps - use update_plan separately for checklists). Example: {\\\"task_name\\\":\\\"task_a\\\",\\\"message\\\":\\\"Read package.json via sa_vm read_file and report name and version.\\\"}. Returns {agent_id,task_name,nickname,status}. Max 5 live children, depth limit 1 (children cannot spawn).\",\"schema\":{\"type\":\"object\",\"properties\":{\"task_name\":{\"type\":\"string\",\"description\":\"REQUIRED. Canonical task name: lowercase letters, digits, underscores.\"},\"taskName\":{\"type\":\"string\"},\"message\":{\"type\":\"string\",\"description\":\"REQUIRED. Plain-text task brief. Never pass update_plan todos/steps here.\"},\"prompt\":{\"type\":\"string\"},\"text\":{\"type\":\"string\"},\"agent_type\":{\"type\":\"string\"},\"agentType\":{\"type\":\"string\"}},\"required\":[\"task_name\",\"message\"],\"additionalProperties\":false}},{\"name\":\"send_message\",\"description\":\"Queue a message on an existing sub-agent without starting a new turn. Args: {target,message}. target is agent_id (or task_name). The message waits in its inbox; use followup_task to trigger the next turn, interrupt_agent to redirect a running turn. Reuse agents when the follow-up depends on their previous context.\",\"schema\":{\"type\":\"object\",\"properties\":{\"target\":{\"type\":\"string\"},\"id\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"},\"text\":{\"type\":\"string\"}},\"required\":[\"target\",\"message\"],\"additionalProperties\":false}},{\"name\":\"followup_task\",\"description\":\"Send a follow-up task to an existing sub-agent and trigger a turn if it is idle. Args: {target,message}. target is agent_id (or task_name). If the agent is already running, the task is queued for its next turn; use interrupt_agent first to redirect the current turn instead.\",\"schema\":{\"type\":\"object\",\"properties\":{\"target\":{\"type\":\"string\"},\"id\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"},\"text\":{\"type\":\"string\"}},\"required\":[\"target\",\"message\"],\"additionalProperties\":false}},{\"name\":\"read_agent_report\",\"description\":\"Read a finished sub-agent full final report. Args: {target}. target is agent_id (or task_name). wait_agent returns status only; use this to fetch report content on demand.\",\"schema\":{\"type\":\"object\",\"properties\":{\"target\":{\"type\":\"string\"},\"id\":{\"type\":\"string\"}},\"required\":[\"target\"],\"additionalProperties\":false}},{\"name\":\"interrupt_agent\",\"description\":\"Interrupt a sub-agent's current turn, if any, and return its previous status. Args: {target}. The agent remains available for messages and follow-up tasks.\",\"schema\":{\"type\":\"object\",\"properties\":{\"target\":{\"type\":\"string\"},\"id\":{\"type\":\"string\"}},\"required\":[\"target\"],\"additionalProperties\":false}},{\"name\":\"wait_agent\",\"description\":\"Wait for sub-agent mailbox activity or terminal status. Args: {targets,timeout_ms?}. targets is a list of agent_id (or single target). Returns {agents:[{agent_id,status,has_report,report?}],timedOut}; completed reports are returned inline (capped) and also delivered to the parent live thread, so do NOT call read_agent_report for reports already included here.\",\"schema\":{\"type\":\"object\",\"properties\":{\"targets\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"target\":{\"type\":\"string\"},\"timeout_ms\":{\"type\":\"number\"},\"timeoutMs\":{\"type\":\"number\"}},\"additionalProperties\":false}},{\"name\":\"close_agent\",\"description\":\"Close a finished sub-agent and free its concurrency slot. Args: {target}. Completed agents count toward the 5-agent limit until closed - do not keep agents open longer than needed. The child rollout is retained and can be reopened with resume_agent.\",\"schema\":{\"type\":\"object\",\"properties\":{\"target\":{\"type\":\"string\"},\"id\":{\"type\":\"string\"}},\"required\":[\"target\"],\"additionalProperties\":false}},{\"name\":\"resume_agent\",\"description\":\"Resume a previously closed sub-agent by id so it can receive follow-up tasks and wait_agent calls. Args: {target}. target is agent_id (or task_name) of a child closed by close_agent. Returns {agent_id,status,resumed}.\",\"schema\":{\"type\":\"object\",\"properties\":{\"target\":{\"type\":\"string\"},\"id\":{\"type\":\"string\"}},\"required\":[\"target\"],\"additionalProperties\":false}},{\"name\":\"list_agents\",\"description\":\"List your live sub-agents with task names and statuses.\",\"schema\":{\"type\":\"object\",\"properties\":{\"path_prefix\":{\"type\":\"string\"}},\"additionalProperties\":false}}]");
    *out = mb_parse(text, n);
}
fn miniToolsForDepth(depth: i64, out: &u64) -> void {
    if depth > 0 { mb_mini_tools(out); return; };
    let base: u64 = 0;
    mb_mini_tools(&base);
    let subs: u64 = 0;
    mb_mini_subagent_tools(&subs);
    let count: u64 = mb_n_count(subs);
    let i: u64 = 0;
    while i < count {
        let rc: i32 = mb_a_push_node(base, mb_clone_node(mb_a_at(subs, i)));
        i = i + 1;
    }
    mb_free_doc(subs);
    *out = base;
}

// ---- subagent/tool-name classification (TS:2211-2395) ----
const MINI_SUBAGENT_USAGE_HINT: ptr = "Sub-agents: use spawn_agent only for substantial independent work that benefits from parallelism; wait_agent waits and returns completed reports inline (no extra read_agent_report needed for reports already delivered); closed agents stay resumable via resume_agent.";
fn MINI_CHILD_TURN_CONCURRENCY_DEFAULT() -> u64 { return 3; }
fn MINI_CHILD_PENDING_INPUTS_DEFAULT() -> u64 { return 8; }
fn mb_positive_env_int(key_p: ptr, key_n: u64, fallback: u64, min_v: u64, max_v: u64) -> u64 {
    let raw = MbStr { bytes: [0u8; 8192], len: 0 };
    let has: bool = mb_env_get(key_p, key_n, &raw);
    let t = MbStr { bytes: [0u8; 8192], len: 0 };
    if has { mb_trim_to(mb_sp(&raw), raw.len, &t); };
    let parsed: f64 = 0.0;
    if !has || !mb_parse_f64(mb_sp(&t), t.len, &parsed) { return fallback; };
    if !(parsed > 0.0) { return fallback; };
    let v: u64 = mb_floor_f64(parsed) as u64;
    if v < min_v { return min_v; };
    if v > max_v { return max_v; };
    return v;
}
fn miniChildTurnConcurrency() -> u64 {
    return mb_positive_env_int(STR_PTR("MINI_MAX_CONCURRENT_CHILD_TURNS"), STR_LEN("MINI_MAX_CONCURRENT_CHILD_TURNS"), MINI_CHILD_TURN_CONCURRENCY_DEFAULT(), 1, MINI_SUBAGENT_MAX_CHILDREN);
}
fn miniChildPendingInputLimit() -> u64 {
    return mb_positive_env_int(STR_PTR("MINI_MAX_PENDING_CHILD_INPUTS"), STR_LEN("MINI_MAX_PENDING_CHILD_INPUTS"), MINI_CHILD_PENDING_INPUTS_DEFAULT(), 1, 64);
}
fn mb_mini_subagent_tool_names(out: &u64) -> void {
    *out = mb_parse(STR_PTR("[\"spawn_agent\",\"send_message\",\"followup_task\",\"read_agent_report\",\"interrupt_agent\",\"wait_agent\",\"close_agent\",\"resume_agent\",\"list_agents\"]"), STR_LEN("[\"spawn_agent\",\"send_message\",\"followup_task\",\"read_agent_report\",\"interrupt_agent\",\"wait_agent\",\"close_agent\",\"resume_agent\",\"list_agents\"]"));
}
fn normalizeMiniSubagentToolName(name_p: ptr, name_n: u64, is_str: bool, out: &MbStr) -> void {
    out.len = 0;
    if !is_str { return; };
    if mb_bytes_eq(name_p, name_n, STR_PTR("send_input"), STR_LEN("send_input")) { mb_sassign(out, STR_PTR("send_message"), STR_LEN("send_message")); return; };
    mb_sassign(out, name_p, name_n);
}
fn isMiniSubagentTool(name_p: ptr, name_n: u64, is_str: bool) -> bool {
    if is_str && mb_bytes_eq(name_p, name_n, STR_PTR("send_input"), STR_LEN("send_input")) { return true; };
    if !is_str { return false; };
    let names: u64 = 0;
    mb_mini_subagent_tool_names(&names);
    let found: bool = mb_str_in_arr(names, name_p, name_n, false);
    mb_free_doc(names);
    return found;
}
fn mb_mini_jev_actions(out: &u64) -> void {
    *out = mb_parse(STR_PTR("[\"jev_choose\",\"jev_checklist\",\"jev_evaluate\",\"jev_thinking\",\"jev_redteam\",\"jev_rank\",\"jev_scope\",\"jev_dispatch\",\"jev_consistency\",\"jev_done\",\"jev_diagnose\",\"jev_edge_cases\",\"jev_blast_radius\",\"jev_intent\",\"jev_next\",\"jev_compress\",\"jev_progress\"]"), STR_LEN("[\"jev_choose\",\"jev_checklist\",\"jev_evaluate\",\"jev_thinking\",\"jev_redteam\",\"jev_rank\",\"jev_scope\",\"jev_dispatch\",\"jev_consistency\",\"jev_done\",\"jev_diagnose\",\"jev_edge_cases\",\"jev_blast_radius\",\"jev_intent\",\"jev_next\",\"jev_compress\",\"jev_progress\"]"));
}
fn isMiniSaVmToolName(name_p: ptr, name_n: u64, is_str: bool) -> bool {
    if !is_str { return false; };
    let n = MbStr { bytes: [0u8; 8192], len: 0 };
    mb_trim_to(name_p, name_n, &n);
    let p: ptr = mb_sp(&n);
    let len: u64 = n.len;
    if mb_bytes_eq(p, len, STR_PTR("sa_vm"), STR_LEN("sa_vm")) || mb_bytes_eq(p, len, STR_PTR("sa_vm_run"), STR_LEN("sa_vm_run"))
        || mb_bytes_eq(p, len, STR_PTR("git_log"), STR_LEN("git_log")) || mb_bytes_eq(p, len, STR_PTR("git-log"), STR_LEN("git-log"))
        || mb_bytes_eq(p, len, STR_PTR("git_status"), STR_LEN("git_status")) || mb_bytes_eq(p, len, STR_PTR("git-status"), STR_LEN("git-status"))
        || mb_bytes_eq(p, len, STR_PTR("git_diff"), STR_LEN("git_diff")) || mb_bytes_eq(p, len, STR_PTR("git-diff"), STR_LEN("git-diff"))
        || mb_bytes_eq(p, len, STR_PTR("run_host"), STR_LEN("run_host")) || mb_bytes_eq(p, len, STR_PTR("exec_host"), STR_LEN("exec_host"))
        || mb_bytes_eq(p, len, STR_PTR("host"), STR_LEN("host")) || mb_bytes_eq(p, len, STR_PTR("bash"), STR_LEN("bash"))
        || mb_bytes_eq(p, len, STR_PTR("sh"), STR_LEN("sh")) { return true; };
    let jev: u64 = 0;
    mb_mini_jev_actions(&jev);
    let in_jev: bool = mb_str_in_arr(jev, p, len, false);
    mb_free_doc(jev);
    if in_jev { return true; };
    if mb_starts_with(p, len, STR_PTR("mcp__"), STR_LEN("mcp__")) && (mb_contains(p, len, STR_PTR("sa_vm"), STR_LEN("sa_vm")) || mb_contains(p, len, STR_PTR("sa-vm"), STR_LEN("sa-vm"))) { return true; };
    return false;
}
fn mb_mini_sa_vm_action_names(out: &u64) -> void {
    *out = mb_parse(STR_PTR("[\"read_file\",\"read_lines\",\"read_many\",\"read_files\",\"read_file_tail\",\"count_lines\",\"file_info\",\"stat\",\"test_path\",\"file_exists\",\"exists\",\"ensure_dir\",\"mkdir\",\"list_dir\",\"find_files\",\"grep_search\",\"grep_search_async\",\"write_file\",\"edit_file\",\"apply_patch\",\"delete_file\",\"safe_delete\",\"move_file\",\"copy_file\",\"move_file_with_imports\",\"find_references\",\"find_implementations\",\"find_definition\",\"file_outline\",\"workspace_outline\",\"rename_symbol\",\"extract_to_file\",\"add_import\",\"get_diagnostics\",\"workspace_diagnostics\",\"organize_imports\",\"verify_loop\",\"verify_changed\",\"analyze_scope\",\"split_plan\",\"split_stage\",\"split_refine\",\"split_repair\",\"split_status\",\"run_bun\",\"run_project_check\",\"run_host\",\"exec_host\",\"host\",\"bash\",\"sh\",\"run_js\",\"run_py\",\"git_status\",\"git-status\",\"git_diff\",\"git-diff\",\"git_log\",\"git-log\",\"save_note\",\"add_memory\",\"edit_memory\",\"save_memory\",\"read_memory\",\"delete_memory\",\"sa_vm_run\"]"), STR_LEN("[\"read_file\",\"read_lines\",\"read_many\",\"read_files\",\"read_file_tail\",\"count_lines\",\"file_info\",\"stat\",\"test_path\",\"file_exists\",\"exists\",\"ensure_dir\",\"mkdir\",\"list_dir\",\"find_files\",\"grep_search\",\"grep_search_async\",\"write_file\",\"edit_file\",\"apply_patch\",\"delete_file\",\"safe_delete\",\"move_file\",\"copy_file\",\"move_file_with_imports\",\"find_references\",\"find_implementations\",\"find_definition\",\"file_outline\",\"workspace_outline\",\"rename_symbol\",\"extract_to_file\",\"add_import\",\"get_diagnostics\",\"workspace_diagnostics\",\"organize_imports\",\"verify_loop\",\"verify_changed\",\"analyze_scope\",\"split_plan\",\"split_stage\",\"split_refine\",\"split_repair\",\"split_status\",\"run_bun\",\"run_project_check\",\"run_host\",\"exec_host\",\"host\",\"bash\",\"sh\",\"run_js\",\"run_py\",\"git_status\",\"git-status\",\"git_diff\",\"git-diff\",\"git_log\",\"git-log\",\"save_note\",\"add_memory\",\"edit_memory\",\"save_memory\",\"read_memory\",\"delete_memory\",\"sa_vm_run\"]"));
    // TS spreads MINI_JEV_ACTIONS into the set.
    let jev: u64 = 0;
    mb_mini_jev_actions(&jev);
    let count: u64 = mb_n_count(jev);
    let i: u64 = 0;
    while i < count {
        let rc: i32 = mb_a_push_node(*out, mb_clone_node(mb_a_at(jev, i)));
        i = i + 1;
    }
    mb_free_doc(jev);
}
fn mb_mini_shell_spellings(out: &u64) -> void {
    *out = mb_parse(STR_PTR("[\"bash\",\"sh\",\"shell\",\"exec\",\"terminal\",\"cmd\",\"powershell\",\"pwsh\",\"curl\",\"wget\"]"), STR_LEN("[\"bash\",\"sh\",\"shell\",\"exec\",\"terminal\",\"cmd\",\"powershell\",\"pwsh\",\"curl\",\"wget\"]"));
}
// Write-redirect table (TS:2233-2257): returns the hint for a lowercased
// top-level write spelling, or empty.
fn mb_write_redirect_hint(lower_p: ptr, lower_n: u64, out: &MbJson) -> void {
    out.len = 0;
    if mb_bytes_eq(lower_p, lower_n, STR_PTR("edit"), STR_LEN("edit")) || mb_bytes_eq(lower_p, lower_n, STR_PTR("edit_file"), STR_LEN("edit_file")) { mb_jassign(out, STR_PTR("Call sa_vm with {\"action\":\"edit_file\",\"path\":\"<workspace-relative file>\",\"old_text\":\"<exact unique snippet from a prior read>\",\"new_text\":\"<replacement>\"} instead."), STR_LEN("Call sa_vm with {\"action\":\"edit_file\",\"path\":\"<workspace-relative file>\",\"old_text\":\"<exact unique snippet from a prior read>\",\"new_text\":\"<replacement>\"} instead.")); return; };
    if mb_bytes_eq(lower_p, lower_n, STR_PTR("write"), STR_LEN("write")) || mb_bytes_eq(lower_p, lower_n, STR_PTR("write_file"), STR_LEN("write_file")) { mb_jassign(out, STR_PTR("Call sa_vm with {\"action\":\"write_file\",\"path\":\"<workspace-relative file>\",\"content\":\"<full file text>\"} instead."), STR_LEN("Call sa_vm with {\"action\":\"write_file\",\"path\":\"<workspace-relative file>\",\"content\":\"<full file text>\"} instead.")); return; };
    if mb_bytes_eq(lower_p, lower_n, STR_PTR("patch"), STR_LEN("patch")) || mb_bytes_eq(lower_p, lower_n, STR_PTR("apply_patch"), STR_LEN("apply_patch")) { mb_jassign(out, STR_PTR("Call sa_vm with {\"action\":\"apply_patch\",\"patch\":\"*** Begin Patch\\n*** Update File: <file>\\n@@\\n-...\\n+...\\n*** End Patch\"} instead (envelope required, not a raw unified diff)."), STR_LEN("Call sa_vm with {\"action\":\"apply_patch\",\"patch\":\"*** Begin Patch\\n*** Update File: <file>\\n@@\\n-...\\n+...\\n*** End Patch\"} instead (envelope required, not a raw unified diff).")); return; };
    if mb_bytes_eq(lower_p, lower_n, STR_PTR("delete"), STR_LEN("delete")) || mb_bytes_eq(lower_p, lower_n, STR_PTR("delete_file"), STR_LEN("delete_file")) { mb_jassign(out, STR_PTR("Call sa_vm with {\"action\":\"delete_file\",\"path\":\"<workspace-relative file>\"} instead."), STR_LEN("Call sa_vm with {\"action\":\"delete_file\",\"path\":\"<workspace-relative file>\"} instead.")); return; };
    if mb_bytes_eq(lower_p, lower_n, STR_PTR("move"), STR_LEN("move")) || mb_bytes_eq(lower_p, lower_n, STR_PTR("move_file"), STR_LEN("move_file")) { mb_jassign(out, STR_PTR("Call sa_vm with {\"action\":\"move_file\",\"from\":\"<src>\",\"to\":\"<dst>\"} instead."), STR_LEN("Call sa_vm with {\"action\":\"move_file\",\"from\":\"<src>\",\"to\":\"<dst>\"} instead.")); return; };
    if mb_bytes_eq(lower_p, lower_n, STR_PTR("copy"), STR_LEN("copy")) || mb_bytes_eq(lower_p, lower_n, STR_PTR("copy_file"), STR_LEN("copy_file")) { mb_jassign(out, STR_PTR("Call sa_vm with {\"action\":\"copy_file\",\"from\":\"<src>\",\"to\":\"<dst>\"} instead."), STR_LEN("Call sa_vm with {\"action\":\"copy_file\",\"from\":\"<src>\",\"to\":\"<dst>\"} instead.")); return; };
    if mb_bytes_eq(lower_p, lower_n, STR_PTR("read_many"), STR_LEN("read_many")) { mb_jassign(out, STR_PTR("Call sa_vm with {\"action\":\"read_many\",\"files\":[\"<file1>\",\"<file2>\"]} instead (files array, max 10, one shared slice; different slices use parallel)."), STR_LEN("Call sa_vm with {\"action\":\"read_many\",\"files\":[\"<file1>\",\"<file2>\"]} instead (files array, max 10, one shared slice; different slices use parallel).")); return; };
    if mb_bytes_eq(lower_p, lower_n, STR_PTR("split_plan"), STR_LEN("split_plan")) { mb_jassign(out, STR_PTR("Call sa_vm with {\"action\":\"split_plan\",\"path\":\"<big file>\",\"task\":\"<goal>\"} instead, then split_stage/split_refine with {session_id,module_name,ops:[{path,content|patch}]}, then split_repair phase=diff/validate/commit."), STR_LEN("Call sa_vm with {\"action\":\"split_plan\",\"path\":\"<big file>\",\"task\":\"<goal>\"} instead, then split_stage/split_refine with {session_id,module_name,ops:[{path,content|patch}]}, then split_repair phase=diff/validate/commit.")); return; };
    if mb_bytes_eq(lower_p, lower_n, STR_PTR("split_stage"), STR_LEN("split_stage")) { mb_jassign(out, STR_PTR("Call sa_vm with {\"action\":\"split_stage\",\"session_id\":\"<id>\",\"module_name\":\"<name>\",\"ops\":[{\"path\":\"<file>\",\"content\":\"...\"}]} instead."), STR_LEN("Call sa_vm with {\"action\":\"split_stage\",\"session_id\":\"<id>\",\"module_name\":\"<name>\",\"ops\":[{\"path\":\"<file>\",\"content\":\"...\"}]} instead.")); return; };
    if mb_bytes_eq(lower_p, lower_n, STR_PTR("split_refine"), STR_LEN("split_refine")) { mb_jassign(out, STR_PTR("Call sa_vm with {\"action\":\"split_refine\",\"session_id\":\"<id>\",\"module_name\":\"<name>\",\"ops\":[{\"path\":\"<file>\",\"content\":\"...\"}]} instead."), STR_LEN("Call sa_vm with {\"action\":\"split_refine\",\"session_id\":\"<id>\",\"module_name\":\"<name>\",\"ops\":[{\"path\":\"<file>\",\"content\":\"...\"}]} instead.")); return; };
    if mb_bytes_eq(lower_p, lower_n, STR_PTR("split_repair"), STR_LEN("split_repair")) { mb_jassign(out, STR_PTR("Call sa_vm with {\"action\":\"split_repair\",\"session_id\":\"<id>\",\"phase\":\"diff|validate|commit\",\"confirm\":true} instead (commit needs fresh diff+validate)."), STR_LEN("Call sa_vm with {\"action\":\"split_repair\",\"session_id\":\"<id>\",\"phase\":\"diff|validate|commit\",\"confirm\":true} instead (commit needs fresh diff+validate).")); return; };
    if mb_bytes_eq(lower_p, lower_n, STR_PTR("split_status"), STR_LEN("split_status")) { mb_jassign(out, STR_PTR("Call sa_vm with {\"action\":\"split_status\",\"session_id\":\"<id>\"} instead."), STR_LEN("Call sa_vm with {\"action\":\"split_status\",\"session_id\":\"<id>\"} instead.")); return; };
}
fn miniUnknownToolError(name_p: ptr, name_n: u64, is_str: bool, out: &MbJson) -> void {
    out.len = 0;
    let n = MbStr { bytes: [0u8; 8192], len: 0 };
    if is_str { mb_trim_to(name_p, name_n, &n); };
    mb_jappend(out, STR_PTR("unknown tool: "), STR_LEN("unknown tool: "));
    mb_jappend_s(out, &n);
    if n.len == 0 { return; };
    let lower = MbStr { bytes: [0u8; 8192], len: 0 };
    mb_lower_into(mb_sp(&n), n.len, &lower);
    let shells: u64 = 0;
    mb_mini_shell_spellings(&shells);
    let in_shell: bool = mb_str_in_arr(shells, mb_sp(&lower), lower.len, false);
    mb_free_doc(shells);
    if in_shell {
        mb_jappend(out, STR_PTR(". Shell commands run through sa_vm {\"action\":\"run_host\",\"exe\":\"<allowlisted binary>\",\"args\":[...]} (bun/node/python/zig/cargo/go/rustc/git and workspace paths only)."), STR_LEN(". Shell commands run through sa_vm {\"action\":\"run_host\",\"exe\":\"<allowlisted binary>\",\"args\":[...]} (bun/node/python/zig/cargo/go/rustc/git and workspace paths only)."));
        return;
    };
    let hint = MbJson { bytes: [0u8; 262144], len: 0 };
    mb_write_redirect_hint(mb_sp(&lower), lower.len, &hint);
    if hint.len > 0 {
        mb_jappend(out, STR_PTR(". "), STR_LEN(". "));
        mb_jappend(out, mb_jp(&hint), hint.len);
        return;
    };
    let actions: u64 = 0;
    mb_mini_sa_vm_action_names(&actions);
    let in_actions: bool = mb_str_in_arr(actions, mb_sp(&lower), lower.len, false);
    mb_free_doc(actions);
    if in_actions || isMiniWriteAction(mb_sp(&lower), lower.len) {
        mb_jappend(out, STR_PTR(". Call sa_vm with {\"action\":\""), STR_LEN(". Call sa_vm with {\"action\":\""));
        mb_jappend_s(out, &lower);
        mb_jappend(out, STR_PTR("\", ...} instead (e.g. {\"action\":\""), STR_LEN("\", ...} instead (e.g. {\"action\":\""));
        mb_jappend_s(out, &lower);
        mb_jappend(out, STR_PTR("\",\"path\":\"<workspace-relative path>\"})."), STR_LEN("\",\"path\":\"<workspace-relative path>\"})."));
        return;
    };
    mb_jappend(out, STR_PTR(". Workspace operations run through sa_vm, e.g. {\"action\":\"read_file\",\"path\":\"package.json\"}."), STR_LEN(". Workspace operations run through sa_vm, e.g. {\"action\":\"read_file\",\"path\":\"package.json\"}."));
}

// ---- B4: tool-list assembly, arg validation, normalization (TS:2396-3180) ----
// ASYNC-REGISTER (blocking contract): TS miniToolsWithMcpForDepth is async
// only because listMiniMcpTools awaits MCP discovery; the sibling SLA entry
// is a blocking call, so the port is 1:1 blocking. The sibling's own
// buildToolDefs is a registered (b) seam (returns zero tools today), so the
// merge below is real code over a seam that currently yields the base list.
fn miniToolsWithMcpForDepth(depth: i64, cache: &MiniMcpCacheState, state: &MiniMcpModuleState, out: &u64) -> void {
    let base: u64 = 0;
    miniToolsForDepth(depth, &base);
    let defs: [MiniMcpToolDef; 64] = [MiniMcpToolDef { name: [0u8; 128], name_len: 0, description: [0u8; 512], description_len: 0, schema_json: [0u8; 8192], schema_json_len: 0, server: [0u8; 128], server_len: 0, rawName: [0u8; 256], rawName_len: 0 }; 64];
    let count: u64 = 0;
    let rc: i32 = listMiniMcpTools(cache, state, false, &defs[0], &count);
    if rc != 0 || count == 0 { *out = base; return; };
    let known: u64 = mb_new_arr();
    let bc: u64 = mb_n_count(base);
    let bi: u64 = 0;
    while bi < bc {
        let nm = MbStr { bytes: [0u8; 8192], len: 0 };
        let t: u64 = mb_a_at(base, bi);
        bi = bi + 1;
        if t != 0 && mb_g_str(t, STR_PTR("name"), STR_LEN("name"), &nm) { let rc2: i32 = mb_a_push_str(known, mb_sp(&nm), nm.len); };
    }
    let di: u64 = 0;
    while di < count && di < 64 {
        let d: MiniMcpToolDef = defs[di];
        di = di + 1;
        let name_s = MbStr { bytes: [0u8; 8192], len: 0 };
        let desc_s = MbStr { bytes: [0u8; 8192], len: 0 };
        let ni: u64 = 0;
        while ni < d.name_len { mb_spush(&name_s, d.name[ni]); ni = ni + 1; }
        let dsi: u64 = 0;
        while dsi < d.description_len { mb_spush(&desc_s, d.description[dsi]); dsi = dsi + 1; }
        if mb_str_in_arr(known, mb_sp(&name_s), name_s.len, false) { continue; };
        let entry: u64 = mb_new_obj();
        let rc2: i32 = mb_s_str(entry, STR_PTR("name"), STR_LEN("name"), mb_sp(&name_s), name_s.len);
        rc2 = mb_s_str(entry, STR_PTR("description"), STR_LEN("description"), mb_sp(&desc_s), desc_s.len);
        let schema_text = MbJson { bytes: [0u8; 262144], len: 0 };
        let sji: u64 = 0;
        while sji < d.schema_json_len { mb_jpush(&schema_text, d.schema_json[sji]); sji = sji + 1; }
        let schema: u64 = mb_parse(mb_jp(&schema_text), schema_text.len);
        if schema == 0 { schema = mb_new_obj(); };
        rc2 = mb_s_node(entry, STR_PTR("schema"), STR_LEN("schema"), schema);
        rc2 = mb_a_push_node(base, entry);
    }
    mb_free_doc(known);
    *out = base;
}
fn parseMiniSubagentTaskName(v: u64, out: &MbStr, out_is_null: &bool) -> void {
    out.len = 0;
    *out_is_null = true;
    if v == 0 || mb_kind(v) != MB_JK_STRING { return; };
    let t = MbStr { bytes: [0u8; 8192], len: 0 };
    let raw = MbStr { bytes: [0u8; 8192], len: 0 };
    let ok: bool = mb_n_str(v, &raw);
    mb_trim_to(mb_sp(&raw), raw.len, &t);
    if t.len == 0 || t.len > 64 { return; };
    if !mb_re_test(mb_sp(&t), t.len, STR_PTR("^[a-z0-9_]+$"), STR_LEN("^[a-z0-9_]+$"), false) { return; };
    mb_sassign_s2(out, &t);
    *out_is_null = false;
}
fn mb_sassign_s2(dst: &MbStr, src: &MbStr) -> void { dst.len = 0; mb_sappend(dst, mb_sp(src), src.len); }
fn isMiniSubagentDepthExceeded(child_depth: i64, max_depth: i64) -> bool { return child_depth > max_depth; }
fn normalizeMiniWaitTimeout(v: u64) -> u64 {
    let n: f64 = 0.0;
    let have: bool = false;
    if v != 0 && (mb_kind(v) == MB_JK_INT || mb_kind(v) == MB_JK_FLOAT) { have = mb_n_f64(v, &n); } else if v != 0 && mb_kind(v) == MB_JK_STRING {
        let t = MbStr { bytes: [0u8; 8192], len: 0 };
        let raw = MbStr { bytes: [0u8; 8192], len: 0 };
        let ok: bool = mb_n_str(v, &raw);
        mb_trim_to(mb_sp(&raw), raw.len, &t);
        if t.len > 0 { have = mb_parse_f64(mb_sp(&t), t.len, &n); };
    };
    if !have || n != n { return MINI_SUBAGENT_DEFAULT_WAIT_MS(); };
    let f: i64 = mb_floor_f64(n);
    if f < MINI_SUBAGENT_MIN_WAIT_MS() as i64 { return MINI_SUBAGENT_MIN_WAIT_MS(); };
    if f > MINI_SUBAGENT_MAX_WAIT_MS() as i64 { return MINI_SUBAGENT_MAX_WAIT_MS(); };
    return f as u64;
}
fn buildMiniSubagentPrompt(task_p: ptr, task_n: u64, msg_p: ptr, msg_n: u64, agent_p: ptr, agent_n: u64, has_agent: bool, out: &MbJson) -> void {
    out.len = 0;
    let role = MbJson { bytes: [0u8; 262144], len: 0 };
    if has_agent {
        let t = MbStr { bytes: [0u8; 8192], len: 0 };
        mb_trim_to(agent_p, agent_n, &t);
        if t.len > 0 {
            mb_jappend(&role, STR_PTR("Role: "), STR_LEN("Role: "));
            let take: u64 = t.len;
            if take > 120 { take = 120; };
            mb_jappend(&role, mb_sp(&t), take);
            mb_jappend(&role, STR_PTR("."), STR_LEN("."));
        };
    };
    let line1 = MbJson { bytes: [0u8; 262144], len: 0 };
    mb_jappend(&line1, STR_PTR("You are a mini sub-agent (task '"), STR_LEN("You are a mini sub-agent (task '"));
    mb_jappend(&line1, task_p, task_n);
    mb_jappend(&line1, STR_PTR("'). "), STR_LEN("'). "));
    mb_jappend(&line1, mb_jp(&role), role.len);
    mb_jappend(&line1, STR_PTR(" Work autonomously in the shared workspace with sa_vm (plus mcp__<server>__<tool> MCP tools when advertised); use update_plan for 3+ steps."), STR_LEN(" Work autonomously in the shared workspace with sa_vm (plus mcp__<server>__<tool> MCP tools when advertised); use update_plan for 3+ steps."));
    let l1 = MbJson { bytes: [0u8; 262144], len: 0 };
    let lt = MbStr { bytes: [0u8; 8192], len: 0 };
    // line1.trim()
    let trimmed = MbJson { bytes: [0u8; 262144], len: 0 };
    mb_trim_to(mb_jp(&line1), line1.len, &lt);
    mb_jassign(&trimmed, mb_sp(&lt), lt.len);
    mb_jappend(out, mb_jp(&trimmed), trimmed.len);
    mb_jappend(out, STR_PTR("\n\nTask brief from the parent agent:\n"), STR_LEN("\n\nTask brief from the parent agent:\n"));
    let mt = MbStr { bytes: [0u8; 8192], len: 0 };
    mb_trim_to(msg_p, msg_n, &mt);
    mb_jappend(out, mb_sp(&mt), mt.len);
    mb_jappend(out, STR_PTR("\n\nReport back with a self-contained plain-text summary (findings, file paths, decisions, pending work). Be concise: state each finding once, no preamble, no filler, no acknowledgement of this brief. Write the report in the same language as the task brief unless otherwise asked. Work efficiently with as few tool calls as possible: send independent reads/searches as multiple sa_vm calls in one round (native parallel), never repeat the same read or search, stop once answerable. Do NOT ask for continuation - finish the task in this turn."), STR_LEN("\n\nReport back with a self-contained plain-text summary (findings, file paths, decisions, pending work). Be concise: state each finding once, no preamble, no filler, no acknowledgement of this brief. Write the report in the same language as the task brief unless otherwise asked. Work efficiently with as few tool calls as possible: send independent reads/searches as multiple sa_vm calls in one round (native parallel), never repeat the same read or search, stop once answerable. Do NOT ask for continuation - finish the task in this turn."));
}
fn mb_coerce_pick_keys(list: u64, k1: ptr, k1n: u64, k2: ptr, k2n: u64, k3: ptr, k3n: u64, k4: ptr, k4n: u64, out_arr: &u64) -> void {
    let count: u64 = 0;
    if list != 0 && mb_kind(list) == MB_JK_ARRAY { count = mb_n_count(list); };
    let i: u64 = 0;
    while i < count {
        let item: u64 = mb_a_at(list, i);
        i = i + 1;
        if item == 0 || mb_kind(item) != MB_JK_OBJECT { continue; };
        let keys: [ptr; 4] = [k1, k2, k3, k4];
        let lens: [u64; 4] = [k1n, k2n, k3n, k4n];
        let ki: u64 = 0;
        while ki < 4 {
            let v = MbStr { bytes: [0u8; 8192], len: 0 };
            let has: bool = mb_g_str(item, keys[ki], lens[ki], &v);
            ki = ki + 1;
            if has {
                let t = MbStr { bytes: [0u8; 8192], len: 0 };
                mb_trim_to(mb_sp(&v), v.len, &t);
                if t.len > 0 { let rc: i32 = mb_a_push_str(*out_arr, mb_sp(&t), t.len); break; };
            };
        }
    }
}
fn miniCoerceSpawnMessage(a: u64, out: &MbJson) -> void {
    out.len = 0;
    if a == 0 { return; };
    let direct: [ptr; 3] = [STR_PTR("message"), STR_PTR("prompt"), STR_PTR("text")];
    let direct_lens: [u64; 3] = [STR_LEN("message"), STR_LEN("prompt"), STR_LEN("text")];
    let di: u64 = 0;
    while di < 3 {
        let v = MbStr { bytes: [0u8; 8192], len: 0 };
        let has: bool = mb_g_str(a, direct[di], direct_lens[di], &v);
        di = di + 1;
        if has {
            let t = MbStr { bytes: [0u8; 8192], len: 0 };
            mb_trim_to(mb_sp(&v), v.len, &t);
            if t.len > 0 { mb_jassign(out, mb_sp(&t), t.len); return; };
        };
    }
    let parts: u64 = mb_new_arr();
    mb_coerce_pick_keys(mb_g_node(a, STR_PTR("todos"), STR_LEN("todos")), STR_PTR("content"), STR_LEN("content"), STR_PTR("text"), STR_LEN("text"), STR_PTR("step"), STR_LEN("step"), STR_PTR("title"), STR_LEN("title"), &parts);
    mb_coerce_pick_keys(mb_g_node(a, STR_PTR("steps"), STR_LEN("steps")), STR_PTR("step"), STR_LEN("step"), STR_PTR("text"), STR_LEN("text"), STR_PTR("content"), STR_LEN("content"), STR_PTR("title"), STR_LEN("title"), &parts);
    if mb_n_count(parts) == 0 { mb_free_doc(parts); return; };
    mb_jappend(out, STR_PTR("Subtask checklist from the parent agent (treat every line as part of ONE subtask brief):\n"), STR_LEN("Subtask checklist from the parent agent (treat every line as part of ONE subtask brief):\n"));
    let count: u64 = mb_n_count(parts);
    let i: u64 = 0;
    while i < count {
        if i > 0 { mb_jappend(out, STR_PTR("\n"), STR_LEN("\n")); };
        let num = MbStr { bytes: [0u8; 8192], len: 0 };
        mb_u64_to_s(i + 1, &num);
        mb_jappend_s(out, &num);
        mb_jappend(out, STR_PTR(". "), STR_LEN(". "));
        let line = MbStr { bytes: [0u8; 8192], len: 0 };
        let ok: bool = mb_n_str(mb_a_at(parts, i), &line);
        mb_jappend_s(out, &line);
        i = i + 1;
    }
    mb_free_doc(parts);
}
// ---- command-line tokenizer + shell-operator scan (TS:2925-2982) ----
fn parseCommandLineTokens(cmd_p: ptr, cmd_n: u64, out: &u64) -> void {
    let arr: u64 = mb_new_arr();
    *out = arr;
    let text = MbStr { bytes: [0u8; 8192], len: 0 };
    mb_trim_to(cmd_p, cmd_n, &text);
    if text.len == 0 { return; };
    let p: ptr = mb_sp(&text);
    let n: u64 = text.len;
    let current = MbStr { bytes: [0u8; 8192], len: 0 };
    let in_double: bool = false;
    let in_single: bool = false;
    let escaped: bool = false;
    let i: u64 = 0;
    while i < n {
        let ch: u8 = mb_byte_at(p, i);
        i = i + 1;
        if escaped { mb_spush(&current, ch); escaped = false; continue; };
        if ch == 92 { escaped = true; continue; };
        if ch == 34 && !in_single { in_double = !in_double; continue; };
        if ch == 39 && !in_double { in_single = !in_single; continue; };
        if (ch == 32 || ch == 9 || ch == 10 || ch == 13 || ch == 11 || ch == 12) && !in_double && !in_single {
            if current.len > 0 { let rc: i32 = mb_a_push_str(arr, mb_sp(&current), current.len); current.len = 0; };
            continue;
        };
        mb_spush(&current, ch);
    }
    if current.len > 0 { let rc: i32 = mb_a_push_str(arr, mb_sp(&current), current.len); };
}
fn miniRunHostShellOperator(tokens: u64, out: &MbStr, out_is_null: &bool) -> void {
    out.len = 0;
    *out_is_null = true;
    if tokens == 0 || mb_kind(tokens) != MB_JK_ARRAY { return; };
    let ops: u64 = mb_parse(STR_PTR("[\"&&\",\"||\",\"|\",\";\",\">\",\">>\",\"<\",\"2>\",\"2>&1\",\"&\"]"), STR_LEN("[\"&&\",\"||\",\"|\",\";\",\">\",\">>\",\"<\",\"2>\",\"2>&1\",\"&\"]"));
    let count: u64 = mb_n_count(tokens);
    let i: u64 = 0;
    while i < count {
        let t: u64 = mb_a_at(tokens, i);
        i = i + 1;
        if t == 0 || mb_kind(t) != MB_JK_STRING { continue; };
        let v = MbStr { bytes: [0u8; 8192], len: 0 };
        let raw = MbStr { bytes: [0u8; 8192], len: 0 };
        let ok: bool = mb_n_str(t, &raw);
        mb_trim_to(mb_sp(&raw), raw.len, &v);
        if mb_str_in_arr(ops, mb_sp(&v), v.len, false) {
            mb_sassign_s2(out, &v);
            *out_is_null = false;
            mb_free_doc(ops);
            return;
        };
    }
    mb_free_doc(ops);
}

// ---- arg validation (TS:2474-2793) ----
fn mb_o_remove(doc: u64, kp: ptr, kn: u64) -> i32 { if doc == 0 { return 0 - 1; }; return sa_json_object_remove(doc, kp, kn); }
fn mb_truthy(node: u64) -> bool {
    if node == 0 { return false; };
    let k: u32 = mb_kind(node);
    if k == MB_JK_NULL { return false; };
    if k == MB_JK_BOOL { let b: bool = false; let ok: bool = mb_n_bool(node, &b); return b; };
    if k == MB_JK_INT || k == MB_JK_FLOAT { let v: f64 = 0.0; let ok: bool = mb_n_f64(node, &v); return v != 0.0; };
    if k == MB_JK_STRING { let s = MbStr { bytes: [0u8; 8192], len: 0 }; let ok: bool = mb_n_str(node, &s); return s.len > 0; };
    return true;
}
fn mb_ne(doc: u64, kp: ptr, kn: u64) -> bool {
    // TS nonEmpty(v): typeof string && trim non-empty.
    if doc == 0 { return false; };
    let node: u64 = mb_g_node(doc, kp, kn);
    if node == 0 || mb_kind(node) != MB_JK_STRING { return false; };
    let s = MbStr { bytes: [0u8; 8192], len: 0 };
    let ok: bool = mb_n_str(node, &s);
    let t = MbStr { bytes: [0u8; 8192], len: 0 };
    mb_trim_to(mb_sp(&s), s.len, &t);
    return t.len > 0;
}
fn mb_ne_any(doc: u64, k1: ptr, k1n: u64, k2: ptr, k2n: u64, k3: ptr, k3n: u64, k4: ptr, k4n: u64, k5: ptr, k5n: u64) -> bool {
    return mb_ne(doc, k1, k1n) || mb_ne(doc, k2, k2n) || mb_ne(doc, k3, k3n) || mb_ne(doc, k4, k4n) || mb_ne(doc, k5, k5n);
}
fn mb_keys_join(doc: u64, cap: u64, out: &MbJson) -> void {
    out.len = 0;
    if doc == 0 || mb_kind(doc) != MB_JK_OBJECT { return; };
    let count: u64 = mb_n_count(doc);
    let i: u64 = 0;
    while i < count {
        let kp: ptr = PTR_NULL();
        let kn: u64 = 0;
        i = i + 1;
        if !mb_key_at(doc, i - 1, &kp, &kn) { continue; };
        if i > 1 { mb_jappend(out, STR_PTR(","), STR_LEN(",")); };
        mb_jappend(out, kp, kn);
    }
    if out.len > cap { out.len = cap; };
}
fn mb_json_slice(doc: u64, cap: u64, out: &MbJson) -> void {
    out.len = 0;
    if doc == 0 { mb_jappend(out, STR_PTR("undefined"), STR_LEN("undefined")); return; };
    let ok: bool = mb_stringify_node(doc, out);
    if out.len > cap { out.len = cap; };
}
fn mb_scalar_text_of(doc: u64, kp: ptr, kn: u64, out: &MbJson) -> void {
    // String(arg[key] ?? "") for the validator's action/exe reads.
    out.len = 0;
    if doc == 0 { return; };
    let node: u64 = mb_g_node(doc, kp, kn);
    if node == 0 || mb_kind(node) == MB_JK_NULL { return; };
    if mb_kind(node) == MB_JK_STRING { let ok: bool = mb_n_str_j(node, out); return; };
    mb_json_scalar_text(node, out);
}
fn mb_act_of(doc: u64, out: &MbStr) -> void {
    let raw = MbJson { bytes: [0u8; 262144], len: 0 };
    mb_scalar_text_of(doc, STR_PTR("action"), STR_LEN("action"), &raw);
    let t = MbStr { bytes: [0u8; 8192], len: 0 };
    mb_trim_to(mb_jp(&raw), raw.len, &t);
    mb_lower_into(mb_sp(&t), t.len, out);
}
fn mb_err_set(out: &MbJson, out_is_null: &bool) -> void { *out_is_null = false; }
fn miniToolArgValidationError(name_p: ptr, name_n: u64, a: u64, vm_sandbox_off: bool, out: &MbJson, out_is_null: &bool) -> void {
    out.len = 0;
    *out_is_null = true;
    let arg: u64 = a;
    if arg == 0 { arg = mb_new_obj(); };
    if isMiniSaVmToolName(name_p, name_n, true) {
        let act = MbStr { bytes: [0u8; 8192], len: 0 };
        mb_act_of(arg, &act);
        if act.len == 0 {
            let jev: u64 = 0;
            mb_mini_jev_actions(&jev);
            let name_is_jev: bool = mb_str_in_arr(jev, name_p, name_n, false);
            mb_free_doc(jev);
            let has_work_keys: bool = mb_truthy(mb_g_node(arg, STR_PTR("user_request"), STR_LEN("user_request"))) || mb_truthy(mb_g_node(arg, STR_PTR("actual_work"), STR_LEN("actual_work"))) || mb_truthy(mb_g_node(arg, STR_PTR("request"), STR_LEN("request"))) || mb_truthy(mb_g_node(arg, STR_PTR("work"), STR_LEN("work")));
            if name_is_jev { mb_sassign(&act, name_p, name_n); } else if has_work_keys { mb_sassign(&act, STR_PTR("jev_done"), STR_LEN("jev_done")); };
        };
        if mb_s_eq(&act, STR_PTR("jev_done"), STR_LEN("jev_done")) {
            let has_req: bool = mb_ne_any(arg, STR_PTR("user_request"), STR_LEN("user_request"), STR_PTR("userRequest"), STR_LEN("userRequest"), STR_PTR("request"), STR_LEN("request"), STR_PTR("question"), STR_LEN("question"), STR_PTR("goal"), STR_LEN("goal")) || mb_ne(arg, STR_PTR("prompt"), STR_LEN("prompt"));
            let has_work: bool = mb_ne_any(arg, STR_PTR("actual_work"), STR_LEN("actual_work"), STR_PTR("actualWork"), STR_LEN("actualWork"), STR_PTR("work"), STR_LEN("work"), STR_PTR("content"), STR_LEN("content"), STR_PTR("context"), STR_LEN("context"));
            if !has_req {
                mb_jappend(out, STR_PTR("sa_vm jev_done needs {\"action\":\"jev_done\",\"user_request\":\"<goal>\",\"actual_work\":\"<changes made>\",\"evidence\":\"<tests/verification>\"}. Got keys: "), STR_LEN("sa_vm jev_done needs {\"action\":\"jev_done\",\"user_request\":\"<goal>\",\"actual_work\":\"<changes made>\",\"evidence\":\"<tests/verification>\"}. Got keys: "));
                let keys = MbJson { bytes: [0u8; 262144], len: 0 };
                mb_keys_join(arg, 200, &keys);
                mb_jappend(out, mb_jp(&keys), keys.len);
                *out_is_null = false;
                return;
            };
            if !has_work {
                mb_jappend(out, STR_PTR("sa_vm jev_done needs {\"action\":\"jev_done\",\"user_request\":\"...\",\"actual_work\":\"<changes made>\",\"evidence\":\"...\"}. Got keys: "), STR_LEN("sa_vm jev_done needs {\"action\":\"jev_done\",\"user_request\":\"...\",\"actual_work\":\"<changes made>\",\"evidence\":\"...\"}. Got keys: "));
                let keys = MbJson { bytes: [0u8; 262144], len: 0 };
                mb_keys_join(arg, 200, &keys);
                mb_jappend(out, mb_jp(&keys), keys.len);
                *out_is_null = false;
                return;
            };
            return;
        };
