  return content;
}

fn buildMiniHistoricalImageContent(messages: JsonArray, protocol: TextBuf) -> JsonArray { // was: function buildMiniHistoricalImageContent
  let content: Array<Record<string, unknown>> = [];
  let seen = new Set<string>(); // DEFECT: JS builtin construction (Map/Set/Date/RegExp/AbortController/Error)
  for (const message of messages ?? []) {
    for (const image of miniStoredImages(message)) {
      if (seen.has(image.url)) continue;
      seen.add(image.url);
      content.push(protocol === "responses" // DEFECT: JS Array/String method
        ? { type: "input_image", image_url: image.url, detail: image.detail ?? "auto" }
        : { type: "image_url", image_url: { url: image.url, ...(image.detail ? { detail: image.detail } : {}) } });
    }
  }
  return content;
}

//
 //* Text-only upstreams reject an attached image instead of ignoring it, and
 //* they reject it as a hard request error rather than a stream cut. The shape
 //* varies per relay (`Cannot read "image" (this model does not support image
 //* input)`, `unsupported content part: image`, 中文 `不支持图片`), so match the
 //* informative variants instead of any 400 that happens to mention an image.
 //
let MINI_IMAGE_UNSUPPORTED_RE =
  /does not support image|does not support image input|does not support images|not support image|image(?:_url|s)?\b[^\n]{0,60}(?:is )?(?:not supported|unsupported|forbidden|not allowed)|unsupported (?:image|input type|content (?:type|part))[^\n]{0,80}image|cannot read ["'“]?image|vision(?: input)? (?:is )?not supported|text[- ]only model|模型?不(?:支持|接受)图(?:片|像)|仅支持文本/i;

fn isMiniImageUnsupportedError(err: JsonValue) -> bool { // was: function isMiniImageUnsupportedError
  let msg = err instanceof Error ? `${err.name}: ${err.message}` : String(err ?? ""); // DEFECT: runtime type test (typeof/instanceof/in)
  return MINI_IMAGE_UNSUPPORTED_RE.test(msg);
}

fn isMiniImageContentBlock(block: JsonValue) -> bool { // was: function isMiniImageContentBlock
  if (!block || typeof block !== "object") return false; // DEFECT: runtime type test (typeof/instanceof/in)
  let type = String((block as Record<string, unknown>).type ?? "").toLowerCase(); // DEFECT: JS Array/String method
  return type === "image" || type === "image_url" || type === "input_image" || type === "inputimage";
}

/**
 * Drop every image part from an outgoing Mini request thread in place and
 * report how many were removed. Text parts survive, so the turn keeps the
 * prompt the user actually typed instead of dying on the attachment. A
 * message that carried nothing but images (a replayed historical attachment)
 * is removed outright rather than sent as an empty content part.
 */
function stripMiniThreadImages<T extends Record<string, any>>(thread: T[]): number {
  let removed = 0;
  for (let index = thread.length - 1; index >= 0; index--) {
    let entry = thread[index] as Record<string, any>; // DEFECT: type assertion (as)
    if (!entry || typeof entry !== "object" || !Array.isArray(entry.content)) continue; // DEFECT: runtime type test (typeof/instanceof/in)
    let content = entry.content as unknown[]; // DEFECT: type assertion (as)
    let kept = content.filter((block) => !isMiniImageContentBlock(block)); // DEFECT: JS Array/String method
    let dropped = content.length - kept.length;
    if (!dropped) continue;
    removed += dropped;
    entry.content = kept;
    if (!kept.length && entry.role !== "assistant" && !Array.isArray(entry.tool_calls)) thread.splice(index, 1); // DEFECT: JS Array/String method
  }
  return removed;
}

// type MiniPlanStep = TextBuf // was: { step: string; status: "pending" | "in_progress" | "completed" }

fn normalizeMiniPlanStatus(v: JsonValue) -> MiniPlanStep["status"] { // was: function normalizeMiniPlanStatus
  let s = typeof v === "string" ? v.replace(/[_-]+/g, "").toLowerCase() : ""; // DEFECT: runtime type test (typeof/instanceof/in)
  if (s === "completed" || s === "complete" || s === "done") return "completed";
  if (s === "inprogress" || s === "running" || s === "started") return "in_progress";
  return "pending";
}

fn extractMiniPlanSteps(args: JsonValue) -> MiniPlanStep[]  { // was: function extractMiniPlanSteps
  let raw = Array.isArray(args.todos) ? args.todos : Array.isArray(args.steps) ? args.steps : null;
