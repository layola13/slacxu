let MINI_FIRST_ACTION_NOTE = "No workspace tool has run in this turn yet. For a workspace task, execute the next concrete sa_vm action (read, edit, write, or run_host) now. Do not end the turn with narration or suggested steps alone; take the first tool action.";
let MINI_WRITE_HINT_RE = /(修改|改动|更新|修复|调整|重构|创建|添加|增加|设计|制作|绘制|引入|集成|加上|删除|优化|实现|编写|写入|改进|改善|完善|解决|搞定|处理|动手|落地|写(一|两|几)?(个|段|份)?(函数|代码|脚本|程序|接口|用例|测试|组件|页面|方法|类|模块|功能)|改代码|修bug|fix|edit|write|create|implement|refactor|update|modify|patch|apply|design|build|add|integrate)/i;

// Prompt wants workspace writes: keyword hit OR a continuation nudge/turn
 //*  ("继续/你调用啊/做吧") inheriting the previous task's write intent.
 //*  Callers additionally gate on taskKind !== "analyze", so analyze-only
 //*  sessions never inherit write pressure from a bare "继续". 
fn miniPromptWantsWrite(prompt: TextBuf, opts: JsonValue) -> bool { // was: function miniPromptWantsWrite
  if (miniIsDirectAnswerPrompt(prompt) || miniIsAnalysisOnlyPrompt(prompt)) return false;
  if (MINI_WRITE_HINT_RE.test(prompt)) return true;
  if (miniIsConciseDevelopmentFollowup(prompt, opts?.hasDevelopmentContext === true)) return true; // DEFECT: optional chaining ?.
  return opts?.isContinuationNudge === true || opts?.isContinuationTurn === true; // DEFECT: optional chaining ?.
}

// Prompt references prior unfinished work without being a bare nudge
 //*  ("把剩下的做完", "继续把它搞定", "收尾一下"). Full-nudge matching
 //*  (isMiniContinuationNudge) is too narrow for these; substring reference
