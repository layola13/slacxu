        let turn = MbStr { bytes: [0u8; 8192], len: 0 };
        mb_new_uuid(&turn);
        let turn_rec: u64 = mb_new_obj();
        let rc: i32 = mb_s_str(turn_rec, STR_PTR("id"), STR_LEN("id"), mb_sp(&turn), turn.len);
        rc = mb_s_str(turn_rec, STR_PTR("status"), STR_LEN("status"), STR_PTR("inProgress"), STR_LEN("inProgress"));
        rc = mb_s_i64(turn_rec, STR_PTR("createdAt"), STR_LEN("createdAt"), mb_now_ms());
        let turns: u64 = mb_g_node(s, STR_PTR("turns"), STR_LEN("turns"));
        rc = mb_a_push_node(turns, turn_rec);
