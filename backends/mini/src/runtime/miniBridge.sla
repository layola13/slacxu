fn isModelProtocolUnsupportedError(error: JsonValue) -> bool { // was: function isModelProtocolUnsupportedError
  let message = error instanceof Error ? error.message : String(error ?? ""); // DEFECT: runtime type test (typeof/instanceof/in)
  if (!/\bresponses 400\b/.test(message)) return false;
  return /ModelProtocolUnsupported|does not support this protocol/i.test(message);
}

