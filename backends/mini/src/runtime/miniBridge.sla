// Which approval card lane a sa_vm action needs (null = read-only, never gated). */
fn miniApprovalLane(action: JsonValue) -> MiniApprovalLane  { // was: function miniApprovalLane
  let act = typeof action === "string" ? action.trim().toLowerCase() : ""; // DEFECT: runtime type test (typeof/instanceof/in)
