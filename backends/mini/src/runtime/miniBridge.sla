      let matchPrefix = (taskName: unknown): boolean => { // DEFECT: arrow function / closure
        if (!prefix) return true;
        return typeof taskName === "string" && (taskName === prefix || taskName.startsWith(prefix)); // DEFECT: runtime type test (typeof/instanceof/in)
      };
