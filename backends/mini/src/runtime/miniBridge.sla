let MINI_PLAN_SYNC_RULE = "When a plan is useful, use update_plan to keep its statuses aligned with verified work. A plan is a guide, not a reason to repeat completed work; if blocked or no longer making progress, say so clearly in the final summary.";

let MINI_PLAN_AWARE_SUMMARY_RULE = "Use update_plan to track progress when the task is genuinely multi-step, involves multiple files/steps, or when the user asks for a plan; simple single-action tasks should go straight to work. Continue useful unfinished work autonomously, but do not loop merely to clear a stale checklist. Turn safety limits are finite: finish efficiently and report any remaining work honestly.";

let MINI_ACTION_MANDATE_RULE = `Workspace execution: when the user requests implementation and the current mode permits it, inspect the relevant code, apply focused changes using sa_vm, and verify the result. Verify correctness through execution: run code, tests, or typechecks to confirm expected outputs; evidence before synthesis. Work through the task or plan to completion in this turn, marking items completed only after work and verification are done. Avoid text before/after your response such as "Here is what I will do next" or merely suggesting next steps without taking them; only use tools to complete tasks. Remember active user corrections, review feedback, and scope constraints across turns. ${MINI_SHORT_TASK_RULE} Respect the session's sandbox, approval settings, analysis-only requests, and denied tools. When blocked or no change is needed, report that honestly from concrete evidence instead of retrying the same action; a short task or previously read files are not evidence that no change is needed.`; // DEFECT: template literal interpolation

/**
 * Mini execution style: the Codex "Preamble messages" section inside
 * CODEX_FALLBACK_INSTRUCTIONS asks for a light preamble before tool calls.
 * Mini runs headless tool-first turns instead, so this states the output
 * format directly without override or negation language.
 */
let MINI_SILENT_EXEC_RULE = "Execution style: call tools directly without conversational preambles, acknowledgements, transitions, or restatements of the plan or request. Between tool calls, emit no extra text. When a round calls tools (search, workspace, or any function), emit only the tool calls silently in that round: do not output the final answer, comprehensive tables, or conclusions in the same round. Present all explanation and conclusions in the single final answer of the turn, after all tool results are returned. A failed tool call is simply an error to fix and retry silently.";

/**
 * Mirror of the codex-rs "Presenting your work and final message" section
 * (default.md: brevity default of ~10 lines, factual tone, file references
 * instead of pasted contents). The silent-exec rule above constrains chatter
 * *between* tool calls but says nothing about the final answer itself, so
 * long turns used to end in an unbounded recap dump. This caps it.
 */
let MINI_FINAL_BREVITY_RULE = "Final-answer brevity is the default: keep this turn's single final answer very concise (no more than ~10 lines) unless the task genuinely needs detail for the user's understanding. Match structure to complexity - a simple factual result needs only a sentence, larger changes get short grouped bullets ordered by importance. Never respond with a greeting when the user provided a technical instruction or question. Do not end with narration of suggested next steps instead of taking action. Be factual with no filler, conversational commentary, or repetition. Reference file paths (workspace-relative, with line numbers) instead of pasting file contents, and never tell the user to save or copy code you already wrote.";

/**
 * Efficiency counterpart to the brevity rules above: the silent-exec and
 * final-answer rules cap *text*, but a model can still burn a turn with
 * dozens of redundant reads/searches before writing that concise answer.
 * This caps *work*: targeted lookup first, batch what is independent, and
 * stop as soon as the turn is answerable.
 */
let MINI_EFFICIENCY_RULE = "Work efficiently with as few tool calls as possible: prefer targeted grep_search/file_outline over broad directory reads; send independent reads/searches as multiple sa_vm tool calls in one round. Avoid redundant reads: never re-read unchanged content without a concrete reason. Different file ranges and queries are distinct reads. Stop as soon as answerable: when the requested information is obtained (e.g. file content, search results), answer directly without further exploration. Git log/status alone is NOT answerable for deep-analysis requests (e.g. 深入分析/detailed review/risk breakdown): pull git diff and the changed files before concluding. Once the relevant code is understood, apply the requested change when permitted and verify it. If more evidence is needed, inspect it; if blocked or no change is needed, answer directly. Never defer required evidence to a next round: phrases like 需下一轮继续/next round are not a valid completion."; // DEFECT: type assertion (as)

/**
 * Language follow (mirrors codex-rs `Use the user's language` used for recap
 * and thread titles): upstream Codex main answers rely on the base model to
 * match tone, but Mini's 21KB English-heavy system prompt pulls weak models
 * back to English. This explicit rule + the per-turn mandate in
 * `formatMiniLiveTurnPrompt` keep Chinese questions answered in Chinese.
 */
let MINI_LANGUAGE_RULE = "Language: always write this turn's single final answer in the same language as the ACTIVE user task for this turn (e.g. Chinese task → Simplified Chinese answer unless the user explicitly asks otherwise). Harness runtime status notes and conversation history never set the answer language. Tool parameters, code, file paths and identifiers stay in their original language; only the natural-language explanation follows the ACTIVE task language."; // DEFECT: type assertion (as)

/**
 * Mirror of codex-rs `text.verbosity` (client.rs serializes it for models whose
 * model_info.support_verbosity is true). Resolution is capability-driven via the
 * shared `resolveModelVerbosity`, whose per-model defaults are mirrored from
 * `codex-rs/models-manager/models.json` (gpt-5.4-mini is `medium`,
 * gpt-daybreak-red-latest is `high`, the rest `low`). Non-OpenAI upstreams
 * (duck.ai, ollama, strict proxies) resolve to `undefined` and never see the
 * field, so they cannot reject it; a group may also force it off with
 * `modelCapabilities[model].supportsVerbosity = false`.
 */
function miniResponsesVerbosityField(
  model: string,
  capability?: ModelCapabilityDescriptor | null,
): Record<string, unknown> {
  let verbosity = resolveModelVerbosity(model, capability ?? undefined);
  return verbosity ? { text: { verbosity } } : {};
}

/* ------------------------------------------------------------------ *
 * Echo gate - mechanical, deliberately not prompt-based.
 *
 * A prompt override alone cannot stop the echo chamber: every assistant text
 * segment used to be emitted as its own agentMessage item and persisted into
 * `s.messages`, and `historyItemToText` fed those restatements back into the
 * next turn. A model that restated the request once was then primed to
 * restate it again, so the repetition compounded across turns. The harness now
 * decides what is visible: a short segment that only mirrors the user's prompt
 * or text already shown is dropped before it is emitted, persisted, replayed
 * upstream or reused as history. Long segments (real answers, summaries,
 * diffs) are never dropped.
 * ------------------------------------------------------------------ */

// Buffered text this long is real work: materialize it and stream it live. */
let MINI_ECHO_MATERIALIZE_CHARS = 260;
// Share of the candidate's own tokens that must appear in the source text. */
let MINI_ECHO_USER_OVERLAP = 0.5;
let MINI_ECHO_SELF_OVERLAP = 0.6;
// How much already-shown text to keep for self-echo comparison. */
let MINI_ECHO_PRIOR_WINDOW = 4000;
// Assistant history lines longer than this are never treated as echo. */
let MINI_HISTORY_ECHO_MAX_CHARS = 200;

//
 //* Tokenize for overlap scoring: latin/digit words plus CJK characters and
 //* character bigrams, because a Chinese restatement rarely reuses exact words
 //* but almost always reuses characters and 2-grams.
 //
fn miniEchoTokens(text: TextBuf) -> JsonArray { // was: function miniEchoTokens
  let normalized = String(text ?? "").toLowerCase().replace(/[^0-9a-z\u4e00-\u9fff]+/g, " "); // DEFECT: JS Array/String method
  let tokens = new Set<string>(); // DEFECT: JS builtin construction (Map/Set/Date/RegExp/AbortController/Error)
  for (const word of normalized.split(" ")) { // DEFECT: JS Array/String method
    if (!word) continue;
    if (/^[\u4e00-\u9fff]/.test(word)) {
      let chars = [...word];
      let chars_p: ptr = PTR_NULL(); PTR_BYTE_ADD(chars_p, &chars, 0);
      for (const ch of chars) tokens.add(ch);
      for (let i = 0; i + 1 < chars.length; i += 1) tokens.add(`${chars[i]}${chars[i + 1]}`); // DEFECT: template literal interpolation
    } else if (word.length > 2) {
      tokens.add(word);
    }
  }
  return tokens;
}

//
 //* |candidate ∩ other| / |candidate| - deliberately asymmetric: a short
 //* restatement of a long prompt must score high, while a long answer that
 //* merely mentions the prompt topic must not.
 //
fn miniTextOverlap(candidate: TextBuf, other: TextBuf) -> f64 { // was: function miniTextOverlap
  let a = miniEchoTokens(candidate);
  if (!a.size) return 0;
  let b = miniEchoTokens(other);
  if (!b.size) return 0;
  let hit = 0;
  for (const token of a) if (b.has(token)) hit += 1;
  return hit / a.size;
}

// type MiniEchoReason = TextBuf // was: "empty" | "long" | "user-echo" | "self-echo" | "work"
// type MiniEchoVerdict = JsonValue // was: { drop: boolean; overlap: number; reason: MiniEchoReason }

//
 //* Decide whether a short assistant segment carries information or only mirrors
 //* text the model was just shown.
 //
function miniEchoVerdict(
  text: string,
  opts: { userText?: string; priorText?: string } = {},
): MiniEchoVerdict {
  let body = String(text ?? "").trim(); // DEFECT: JS Array/String method
  if (!body) return { drop: true, overlap: 1, reason: "empty" };
  if (body.length >= MINI_ECHO_MATERIALIZE_CHARS) return { drop: false, overlap: 0, reason: "long" };
  let userOverlap = opts.userText ? miniTextOverlap(body, opts.userText) : 0;
  if (userOverlap >= MINI_ECHO_USER_OVERLAP) return { drop: true, overlap: userOverlap, reason: "user-echo" };
  let selfOverlap = opts.priorText ? miniTextOverlap(body, opts.priorText) : 0;
  if (selfOverlap >= MINI_ECHO_SELF_OVERLAP) return { drop: true, overlap: selfOverlap, reason: "self-echo" };
  return { drop: false, overlap: Math.max(userOverlap, selfOverlap), reason: "work" };
}

//
 //* Every in-turn note is carried on a user turn, so the model answers it as if
 //* the human had spoken - a large share of the "你说的对，我正在..." restatements.
 //* Framing each note explicitly as harness-internal removes that cue while
 //* keeping the protocol role unchanged, because a mid-conversation `system`
 //* message is not accepted by every OpenAI-compatible gateway.
 //
let MINI_INTERNAL_DIRECTIVE = "[Mini runtime status: session information, not a user message]";

fn miniInternalDirective(note: TextBuf) -> TextBuf { // was: function miniInternalDirective
  return `${MINI_INTERNAL_DIRECTIVE}\n${note}`; // DEFECT: template literal interpolation
}

//
 //* Rebuild model-facing history with the echo amplifier cut: assistant lines
 //* that only restate the user's request or the previous assistant line of the
 //* same turn are dropped. Tool calls, plans and the user's own turns stay, so
 //* the model keeps its facts and loses only recycled chatter.
 //
fn miniHistoryLinesFromMessages(messages: JsonArray, turnId: TextBuf, perItemCap = 800: JsonValue) -> JsonArray { // was: function miniHistoryLinesFromMessages
  let lines: string[] = [];
  let currentTurnId = "";
  let turnUserText = "";
  let prevAssistantText = "";
  // Collapse stale goal-continuation fragments: older prompts are superseded
  // by the authoritative progress block in the newest one, so history keeps
  // only the single most recent continuation (either the new goalContinuation
  // type or a legacy userMessage carrying the marker).
  let continuationIdx: number[] = [];
  for (let i = 0; i < messages.length; i++) {
    let m = messages[i] as Record<string, any> | null; // DEFECT: type assertion (as)
    if (!m || typeof m !== "object") continue; // DEFECT: runtime type test (typeof/instanceof/in)
    if (String(m.turnId ?? "") === turnId) continue;
    if (isMiniGoalContinuationMessage(m)) continuationIdx.push(i); // DEFECT: JS Array/String method
  }
  let dropContinuation = new Set(continuationIdx.slice(0, Math.max(0, continuationIdx.length - 1))); // DEFECT: JS Array/String method
  for (let idx = 0; idx < messages.length; idx++) {
    let message = messages[idx];
    if (dropContinuation.has(idx)) continue;
    if (!message || typeof message !== "object") continue; // DEFECT: runtime type test (typeof/instanceof/in)
    let rec = message as Record<string, any>; // DEFECT: type assertion (as)
    let itemTurnId = String(rec.turnId ?? "");
    if (itemTurnId === turnId) continue;
    if (itemTurnId !== currentTurnId) {
      currentTurnId = itemTurnId;
      turnUserText = "";
      prevAssistantText = "";
    }
    let kind = String(rec.type ?? "");
    if (kind === "userMessage") {
      turnUserText = String(rec.text ?? "");
      prevAssistantText = "";
    }
    let text = historyItemToText(message, perItemCap);
    if (!text.trim()) continue; // DEFECT: JS Array/String method
    if (kind === "agentMessage") {
      let body = String(rec.text ?? "");
      // A blank body still renders as a bare "assistant:" history line, which
      // costs input tokens and tells the model nothing.
      if (!body.trim()) continue; // DEFECT: JS Array/String method
      if (body.length <= MINI_HISTORY_ECHO_MAX_CHARS) {
        if (turnUserText && miniTextOverlap(body, turnUserText) >= MINI_ECHO_USER_OVERLAP) continue;
        if (prevAssistantText && miniTextOverlap(body, prevAssistantText) >= MINI_ECHO_SELF_OVERLAP) continue;
      }
      prevAssistantText = body;
    }
    lines.push(text); // DEFECT: JS Array/String method
  }
  return lines;
}

fn miniPendingPlanReminder(steps: JsonArray) -> string  { // was: function miniPendingPlanReminder
  let pending = steps.filter((s) => s.status !== "completed"); // DEFECT: JS Array/String method
  if (!pending.length) return null;
  let lines = pending
    .slice(0, 8) // DEFECT: JS Array/String method
    .map((s) => `- [ ] ${s.step}${s.status === "in_progress" ? " _(in progress)_" : ""}`); // DEFECT: runtime type test (typeof/instanceof/in)
  return [
    `The plan checklist still has ${pending.length} unfinished step(s):`, // DEFECT: template literal interpolation
    ...lines,
    "Continue the next useful step now and update the checklist when its status changes. Do NOT repeat completed work; if blocked, report the blocker concisely.",
    "Use the next useful tool when permitted, or give the final answer if blocked.",
    "A concise task is not a blocker. Previously inspected files complete investigation, not pending implementation; reuse that evidence to make the requested change. Do not end with an unchanged workspace recap or a request for a new goal.",
    "If the user's latest message asks for something unrelated to this plan, follow the user message instead and leave the plan untouched.",
  ].join("\n"); // DEFECT: JS Array/String method
}

fn miniPlanProgressFingerprint(steps: JsonArray, toolCalls: f64) -> TextBuf { // was: function miniPlanProgressFingerprint
  return JSON.stringify({ // DEFECT: dynamic JSON (JSON.parse/stringify)
    steps: steps.map(({ step, status }) => ({ step, status })), // DEFECT: JS Array/String method
    toolCalls,
  });
}

//
 //* Real-progress fingerprint: plan step statuses + effective evidence only.
 //* Repeated reads / failed calls that only bump totalToolCalls do NOT create
 //* a new fingerprint, so `shouldContinueMiniPlan` stops read loops instead of
 //* spinning on them. Writes, verification diagnostics, and delivered sub-agent
 //* reports count as progress.
 //
struct MiniTaskEvidence { // was: interface 
  writes?: number;
  verifies?: number;
  agentReports?: number;
}

fn miniPlanTaskFingerprint(steps: JsonArray, evidence: MiniTaskEvidence) -> TextBuf { // was: function miniPlanTaskFingerprint
  let e = evidence ?? {};
  return JSON.stringify({ // DEFECT: dynamic JSON (JSON.parse/stringify)
    steps: steps.map(({ step, status }) => ({ step, status })), // DEFECT: JS Array/String method
    writes: typeof e.writes === "number" ? e.writes : 0, // DEFECT: runtime type test (typeof/instanceof/in)
    verifies: typeof e.verifies === "number" ? e.verifies : 0, // DEFECT: runtime type test (typeof/instanceof/in)
    agentReports: typeof e.agentReports === "number" ? e.agentReports : 0, // DEFECT: runtime type test (typeof/instanceof/in)
  });
}

// Lightweight task phase: investigate -> modify -> verify -> next -> done. */
// type MiniTaskPhase = TextBuf // was: "investigate" | "modify" | "verify" | "next" | "done"

function miniTaskPhase(
  steps: MiniPlanStep[],
  opts?: { hasWrite?: boolean; hasVerify?: boolean },
): MiniTaskPhase {
  let pending = steps.filter((s) => s.status !== "completed"); // DEFECT: JS Array/String method
  if (!steps.length) return opts?.hasWrite ? "verify" : "investigate"; // DEFECT: optional chaining ?.
  if (!pending.length) return "done";
  let current = pending[0];
  if (current && current.status === "in_progress") {
    if (opts?.hasVerify) return "next"; // DEFECT: optional chaining ?.
    return opts?.hasWrite ? "verify" : "modify"; // DEFECT: optional chaining ?.
  }
  if (opts?.hasWrite && !opts?.hasVerify) return "verify"; // DEFECT: optional chaining ?.
  if (opts?.hasWrite) return "next"; // DEFECT: optional chaining ?.
  return "investigate";
}

// Classify the turn so prompts stop conflicting: analyze-only vs continue vs new. */
// type MiniTaskKind = TextBuf // was: "analyze" | "continue" | "new"

function miniTaskKind(
  prompt: string,
  opts?: { noToolRequested?: boolean; isContinuation?: boolean },
): MiniTaskKind {
  if (opts?.noToolRequested === true || miniIsAnalysisOnlyPrompt(prompt)) return "analyze"; // DEFECT: optional chaining ?.
  if (opts?.isContinuation === true || isMiniContinuationNudge(prompt)) return "continue"; // DEFECT: optional chaining ?.
  return "new";
}

// Cap for one inbox report inside the live model thread (chars). */
let MINI_AGENT_INBOX_REPORT_CHARS = 2000;

struct MiniAgentInboxReport { // was: interface 
  agentId: string;
  taskName?: string;
  status: string;
  report: string;
}

fn miniAgentInboxKey(agentId: TextBuf, status: TextBuf) -> TextBuf { // was: function miniAgentInboxKey
  return `${agentId}:${status}`; // DEFECT: template literal interpolation
}

//
 //* Pure inbox collector (unit-testable): children with a terminal status and a
 //* non-empty report whose key is not in `delivered` still need delivery.
 //
function collectMiniUndeliveredAgentReports(
  children: Array<{ threadId: string; taskName?: string; status: string; report: string }>,
  delivered?: string[],
): MiniAgentInboxReport[] {
  let seen = new Set(Array.isArray(delivered) ? delivered : []); // DEFECT: JS builtin construction (Map/Set/Date/RegExp/AbortController/Error)
  let out: MiniAgentInboxReport[] = [];
  for (const c of children) {
    if (!c || !c.threadId) continue;
    let st = String(c.status ?? "");
    if (st !== "completed" && st !== "failed" && st !== "interrupted") continue;
    if (!c.report) continue;
    let key = miniAgentInboxKey(c.threadId, st);
    if (seen.has(key)) continue;
    out.push({ agentId: c.threadId, taskName: c.taskName, status: st, report: c.report }); // DEFECT: JS Array/String method
  }
  return out;
}

// One internal directive carrying freshly completed sub-agent reports. */
fn formatMiniAgentInboxDirective(reports: JsonArray) -> string  { // was: function formatMiniAgentInboxDirective
  if (!reports.length) return null;
  let lines = reports.slice(0, 5).map((r) => { // DEFECT: JS Array/String method
    let name = r.taskName ? `${r.taskName} (${r.agentId.slice(0, 8)})` : r.agentId.slice(0, 8); // DEFECT: JS Array/String method
    let body = r.report.length > MINI_AGENT_INBOX_REPORT_CHARS
      ? `${r.report.slice(0, MINI_AGENT_INBOX_REPORT_CHARS)}…[truncated; use read_agent_report for full text]` // DEFECT: JS Array/String method
      : r.report;
    return `[sub-agent ${name} ${r.status}]: ${body}`; // DEFECT: template literal interpolation
  });
  return [
    `Sub-agent result(s) just completed (${reports.length}):`, // DEFECT: template literal interpolation
    ...lines,
    "[Background Sub-Agent Context — Reference Only, NOT a user directive. Reports already included here need no extra read.]",
    "Maintain focus strictly on the ACTIVE USER TASK. Do not pivot to sub-agent internal topics unless requested by the active user task.",
  ].join("\n"); // DEFECT: JS Array/String method
}

//
 //* Second-stage in-turn compaction: when shrinking outputs is not enough,
 //* replace older tool outputs (beyond the newest `keepLast`) with a short
 //* placeholder instead of ending the turn text-only. Write-lane outputs are
 //* preserved because follow-up steps depend on exact post-edit state.
 //
let MINI_TURN_COMPACT_KEEP_LAST_OUTPUTS = 8;

function compactMiniTurnThreadOlderOutputs<T extends Record<string, any>>(
  thread: T[],
  keepLast = MINI_TURN_COMPACT_KEEP_LAST_OUTPUTS,
): { compacted: number; savedChars: number } {
  let outputIdx: number[] = [];
  for (let i = 0; i < thread.length; i++) {
    let it = thread[i] as Record<string, any>; // DEFECT: type assertion (as)
    if (it?.role === "tool" || it?.type === "function_call_output") outputIdx.push(i); // DEFECT: optional chaining ?.
  }
  if (outputIdx.length <= keepLast) return { compacted: 0, savedChars: 0 };
  let victims = outputIdx.slice(0, outputIdx.length - keepLast); // DEFECT: JS Array/String method
  let compacted = 0;
  let savedChars = 0;
  for (const i of victims) {
    let it = thread[i] as Record<string, any>; // DEFECT: type assertion (as)
    let content = it.content;
    let output = it.output;
    if (typeof content === "string" && content.length > 400) { // DEFECT: runtime type test (typeof/instanceof/in)
      savedChars += content.length - 400;
      let id = String(it.tool_call_id ?? it.call_id ?? "tool");
      it.content = `[earlier tool output compacted (${content.length} chars omitted to stay within context; newest outputs below remain full): ${id}]`; // DEFECT: template literal interpolation
      compacted++;
    } else if (typeof output === "string" && output.length > 400) { // DEFECT: runtime type test (typeof/instanceof/in)
      savedChars += output.length - 400;
      let id = String(it.tool_call_id ?? it.call_id ?? "tool");
      it.output = `[earlier tool output compacted (${output.length} chars omitted to stay within context; newest outputs below remain full): ${id}]`; // DEFECT: template literal interpolation
      compacted++;
    }
  }
  return { compacted, savedChars };
}

fn shouldContinueMiniPlan(seenProgress: JsonArray, progress: TextBuf) -> bool { // was: function shouldContinueMiniPlan
  if (seenProgress.has(progress)) return false;
  seenProgress.add(progress);
  return true;
}

