                            let roots: u64 = mb_g_node(s, STR_PTR("additionalRoots"), STR_LEN("additionalRoots"));
                            if roots != 0 { rc = mb_s_node(e, STR_PTR("additionalRoots"), STR_LEN("additionalRoots"), mb_clone_node(roots)); } else { rc = mb_s_node(e, STR_PTR("additionalRoots"), STR_LEN("additionalRoots"), mb_new_arr()); };
