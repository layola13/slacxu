  fn emitMiniItemStarted(self: &MiniBridge, s: MiniSession, turnId: TextBuf, item: JsonValue) -> void { // method of MiniBridge
    if (isMiniTurnEventStale(s, turnId)) return;
    self.emit("notification", {
      method: "item/started",
      params: {
        threadId: s.threadId,
        ...(s.parentThreadId ? { parentThreadId: s.parentThreadId } : {}),
        turnId,
        item
      }
    });
  }

  fn rollbackMiniRoundLiveSegments(self: &MiniBridge, s: MiniSession, turnId: TextBuf, msgIdBase: TextBuf, segIndexBefore: f64, allowSteering = false: JsonValue) -> void { // method of MiniBridge
    if (isMiniTurnEventStale(s, turnId) && !(isMiniTurnSteering(s, turnId) || allowSteering)) return;
    self.flushMiniDeltas(s.threadId, turnId);
    let itemIds = miniRoundLiveSegmentIds(s.messages, msgIdBase, segIndexBefore);
    s.messages = rollbackMiniRoundLiveSegments(s.messages, msgIdBase, segIndexBefore);
    if (itemIds.length) {
      self.emit("notification", {
        method: "mini/item/rollback",
        params: {
          threadId: s.threadId,
          ...(s.parentThreadId ? { parentThreadId: s.parentThreadId } : {}),
          turnId,
          itemIds
        }
      });
    }
  }

    //
   //* Retire steer-committed candidates that the final answer supersedes. Only
   //* ids still present in the stored messages are removed and reported.
   //
  fn retireMiniSegments(self: &MiniBridge, s: MiniSession, turnId: TextBuf, itemIds: JsonArray) -> void { // method of MiniBridge
    self.flushMiniDeltas(s.threadId, turnId);
    let idOf = (m: JsonValue): string => String((m as Record<string, unknown> | null)?.id ?? ""); // DEFECT: optional chaining ?.
    let retired = itemIds.filter((id) => s.messages.some((m) => idOf(m) === id)); // DEFECT: JS Array/String method
    if (!retired.length) return;
    s.messages = s.messages.filter((m) => !retired.includes(idOf(m))); // DEFECT: JS Array/String method
    self.emit("notification", {
      method: "mini/item/rollback",
      params: {
        threadId: s.threadId,
        ...(s.parentThreadId ? { parentThreadId: s.parentThreadId } : {}),
        turnId,
        itemIds: retired
      }
    });
  }

  fn flushMiniDeltas(self: &MiniBridge, threadId: TextBuf, turnId: TextBuf) -> void { // method of MiniBridge
    let key = `${threadId}:${turnId}`; // DEFECT: template literal interpolation
    let timer = self.pendingDeltaTimers.get(key);
    if (timer !== undefined) clearTimeout(timer); // DEFECT: timer
    self.pendingDeltaTimers.delete(key);
    let pending = self.pendingDeltasByTurn.get(key);
    if (!pending) return;
    self.pendingDeltasByTurn.delete(key);
    let s = self.sessions.get(threadId);
    if (s && isMiniTurnEventStale(s, turnId)) return;
    for (const delta of pending.values()) {
      self.emit("notification", {
        method: delta.method,
        params: {
          threadId: delta.threadId,
          ...(s?.parentThreadId ? { parentThreadId: s.parentThreadId } : {}), // DEFECT: optional chaining ?.
          turnId: delta.turnId,
          itemId: delta.itemId,
          delta: delta.delta
        }
      });
    }
  }

  private queueMiniDelta(
    method: PendingMiniDelta["method"],
    s: MiniSession,
    turnId: string,
    itemId: string,
    delta: string,
  ): void {
    if (!delta || isMiniTurnEventStale(s, turnId)) return;
    let key = `${s.threadId}:${turnId}`; // DEFECT: template literal interpolation
    let pending = self.pendingDeltasByTurn.get(key);
    if (!pending) {
      pending = new Map(); // DEFECT: JS builtin construction (Map/Set/Date/RegExp/AbortController/Error)
      self.pendingDeltasByTurn.set(key, pending);
    }
    let itemKey = `${method}:${itemId}`; // DEFECT: template literal interpolation
    let previous = pending.get(itemKey);
    pending.set(itemKey, {
      method,
      threadId: s.threadId,
      turnId,
      itemId,
      delta: `${previous?.delta ?? ""}${delta}` // DEFECT: optional chaining ?.
    });
    if (!self.pendingDeltaTimers.has(key)) {
      self.pendingDeltaTimers.set(key, setTimeout(() => self.flushMiniDeltas(s.threadId, turnId), MINI_DELTA_FLUSH_MS)); // DEFECT: timer
    }
  }

  fn emitMiniAgentDelta(self: &MiniBridge, s: MiniSession, turnId: TextBuf, itemId: TextBuf, delta: TextBuf) -> void { // method of MiniBridge
    self.queueMiniDelta("item/agentMessage/delta", s, turnId, itemId, delta);
  }

  fn emitMiniReasonDelta(self: &MiniBridge, s: MiniSession, turnId: TextBuf, itemId: TextBuf, delta: TextBuf) -> void { // method of MiniBridge
    self.queueMiniDelta("item/reasoning/textDelta", s, turnId, itemId, delta);
  }

  fn emitMiniItemCompleted(self: &MiniBridge, s: MiniSession, turnId: TextBuf, item: JsonValue) -> void { // method of MiniBridge
    if (isMiniTurnEventStale(s, turnId)) return;
    self.flushMiniDeltas(s.threadId, turnId);
    self.emit("notification", {
      method: "item/completed",
      params: {
        threadId: s.threadId,
        ...(s.parentThreadId ? { parentThreadId: s.parentThreadId } : {}),
        turnId,
        item
      }
    });
  }

  fn persist(self: &MiniBridge, s: MiniSession) -> void { // method of MiniBridge
    self.options?.onSnapshot?.({ // DEFECT: optional chaining ?.
      threadId: s.threadId, ownerId: s.ownerId, cwd: s.cwd, model: s.model,
      additionalRoots: s.additionalRoots,
      providerId: s.providerId, groupId: s.groupId, preview: s.preview, name: s.name,
      effort: s.effort ?? MINI_DEFAULT_EFFORT, createdAt: s.createdAt,
      lastUsedTokens: s.lastUsedTokens, lastContextWindow: s.lastContextWindow,
      lastAutoCompactAt: s.lastAutoCompactAt, agentsMdActive: s.agentsMdActive,
      imageInputUnsupported: s.imageInputUnsupported === true ? true : undefined,
      archived: s.archived,
      closed: s.closed === true ? true : undefined,
      sandbox: s.sandbox, approvalPolicy: s.approvalPolicy,
      goalObjective: s.goalObjective, goalStatus: s.goalStatus,
      goalTokenBudget: s.goalTokenBudget, goalTokensUsed: s.goalTokensUsed, goalStartedAt: s.goalStartedAt,
      goalLastFingerprint: s.goalLastFingerprint, goalStagnantTurns: s.goalStagnantTurns,
      goalRecentToolFingerprints: s.goalRecentToolFingerprints,
      approvalBypass: s.approvalBypass === true ? true : undefined,
      pureChat: s.pureChat === true ? true : undefined,
      webSearch: s.webSearch === true ? true : undefined,
      turns: s.turns, messages: s.messages,
      parentThreadId: s.parentThreadId, depth: s.depth, taskName: s.taskName, agentType: s.agentType,
      subStatus: s.subStatus, finalReport: s.finalReport,
    });
  }

    //
   //* Settle orphaned `inProgress` turns that no live turn owns. After a
   //* 502-retry abort, a reload, or a service restart, the persisted snapshot
   //* can keep an `inProgress` turn while `activeTurnId` is gone (or never
   //* restored): `turn/start` then throws "Turn is already active" forever and
   //* the UI spins on a turn that will never settle. Only heals when nothing
   //* live claims the slot — a newer turn that owns `activeTurnId` is never
   //* touched.
   //
    //
   //* Release an `activeTurnId` slot whose turn already settled (failed,
   //* interrupted, completed) or no longer exists, so `review/start` and
   //* `thread/compact/start` do not throw "Turn is already active" forever
   //* after a 502-retry abort race. A genuinely `inProgress` turn is kept.
   //
  fn releaseStaleMiniActiveSlot(self: &MiniBridge, s: MiniSession) -> bool { // method of MiniBridge
    if (s.activeTurnId === undefined) return false;
    let activeTurn = s.turns.find((entry) => entry.id === s.activeTurnId); // DEFECT: JS Array/String method
    if (activeTurn && (activeTurn.status === "inProgress" || activeTurn.status === "in_progress")) return false;
    s.activeTurnId = undefined;
    s.activeAbort = undefined;
    s.activeMaxRetries = undefined;
    return true;
  }

  fn healOrphanMiniInProgressTurns(self: &MiniBridge, s: MiniSession) -> bool { // method of MiniBridge
    if (s.activeTurnId !== undefined) return false;
    let healed = false;
    for (const turn of s.turns) {
      if (turn.status !== "inProgress" && turn.status !== "in_progress") continue;
      closeMiniOpenSegments(s.messages, turn.id, "interrupted");
      turn.status = "interrupted";
      healed = true;
      self.emit("notification", {
        method: "turn/interrupted",
        params: {
          threadId: s.threadId,
          ...(s.parentThreadId ? { parentThreadId: s.parentThreadId } : {}),
          turnId: turn.id,
          turn: { id: turn.id, threadId: s.threadId, ...(s.parentThreadId ? { parentThreadId: s.parentThreadId } : {}), status: "interrupted" }
        }
      });
    }
    if (healed) self.persist(s);
    return healed;
  }

  fn failTurn(self: &MiniBridge, s: MiniSession, turnId: TextBuf, err: TextBuf) -> void { // method of MiniBridge
    let turn = s.turns.find((entry) => entry.id === turnId); // DEFECT: JS Array/String method
    if (!turn || turn.status !== "inProgress" || s.activeTurnId !== turnId) return;
    self.flushMiniDeltas(s.threadId, turnId);
    // Failed-turn segments stay failed (never "completed") so they render
    // as an error card and are excluded from future model history.
    // `activeTurnId` is released so the user can resend immediately.
    closeMiniOpenSegments(s.messages, turnId, "failed");
    self.emit("notification", {
      method: "item/completed",
      params: {
        threadId: s.threadId,
        ...(s.parentThreadId ? { parentThreadId: s.parentThreadId } : {}),
        turnId,
        item: { type: "reasoning", id: `mini-reason-${turnId}`, turnId, threadId: s.threadId, status: "failed" } // DEFECT: template literal interpolation
      }
    });
    let friendly = formatMiniUpstreamError(err, s.activeMaxRetries ?? MINI_STREAM_RETRY_DEFAULT);
    let maxForCard = s.activeMaxRetries ?? MINI_STREAM_RETRY_DEFAULT;
    let item = { type: "error", id: `mini-err-${turnId}`, turnId, threadId: s.threadId, title: "Mini request failed", text: friendly, status: "failed", payload: { retryError: true, exhausted: true, retrySource: "mini", attempt: maxForCard, max: maxForCard } }; // DEFECT: template literal interpolation
    s.messages.push(item as JsonValue); // DEFECT: JS Array/String method
    turn.status = "failed";
    s.activeTurnId = undefined;
    self.goalContinuationTurnKeys.delete(`${s.threadId}:${turnId}`); // DEFECT: template literal interpolation
    s.activeMaxRetries = undefined;
    s.activeAbort = undefined;
    s.pendingSteers = undefined;
    s.steerTurnId = undefined;
    s.aborted = false;
    let goalParked = self.parkGoalAfterFailedTurn(s, err);
    self.persist(s);
    self.failMiniRetryNotice(s, turnId);
    self.emit("notification", {
      method: "item/completed",
      params: {
        threadId: s.threadId,
        ...(s.parentThreadId ? { parentThreadId: s.parentThreadId } : {}),
        turnId,
        item
      }
    });
    if (goalParked) self.emit("notification", { method: "thread/goal/updated", params: { goal: miniGoalState(s) } });
    self.emit("notification", {
      method: "turn/failed",
      params: {
        threadId: s.threadId,
        ...(s.parentThreadId ? { parentThreadId: s.parentThreadId } : {}),
        turnId,
        turn: { id: turnId, threadId: s.threadId, ...(s.parentThreadId ? { parentThreadId: s.parentThreadId } : {}), status: "failed", completedAt: Math.floor(Date.now() / 1000) },
        error: friendly
      }
    });
    void fireMiniTurnFinishHook({
      threadId: s.threadId, turnId,
      ...(s.parentThreadId ? { parentThreadId: s.parentThreadId } : {}),
      cwd: s.cwd, model: s.model, status: "failed",
      summary: friendly,
      ...(s.parentThreadId && s.agentType ? { agentName: s.agentType } : {}),
    });
    if (s.parentThreadId) self.finishMiniSubagent(s, "failed", friendly);
  }

    //
   //* A failed turn used to leave an active goal silently stalled: status stayed
   //* active but no continuation was ever scheduled, and the banner offered only
   //* pause. Like Codex, park it: quota errors -> usageLimited, anything else ->
   //* blocked. Both are resumable from the banner.
   //
  fn parkGoalAfterFailedTurn(self: &MiniBridge, s: MiniSession, err: TextBuf) -> bool { // method of MiniBridge
    if (s.parentThreadId || s.goalStatus !== "active" || !s.goalObjective?.trim()) return false; // DEFECT: optional chaining ?.
    s.goalStatus = MINI_GOAL_USAGE_LIMIT_ERROR_RE.test(err) ? "usageLimited" : "blocked";
    self.clearGoalContinuationTimer(s.threadId);
    self.goalContinuationCounts.delete(s.threadId);
    return true;
  }

  fn interruptTurn(self: &MiniBridge, s: MiniSession, turnId: TextBuf) -> void { // method of MiniBridge
    let turn = s.turns.find((entry) => entry.id === turnId); // DEFECT: JS Array/String method
    // A late rejection/abort from an older async turn must never terminate a
    // newer turn that has already claimed `activeTurnId`.
    if (
      !turn
      || (turn.status !== "inProgress" && turn.status !== "in_progress")
      || s.activeTurnId !== turnId
    ) return;
    if (s.parentThreadId) self.cancelQueuedMiniChildTurn(s, turnId);
    self.flushMiniDeltas(s.threadId, turnId);
    closeMiniOpenSegments(s.messages, turnId, "interrupted");
    self.emit("notification", {
      method: "item/completed",
      params: {
        threadId: s.threadId,
        ...(s.parentThreadId ? { parentThreadId: s.parentThreadId } : {}),
        turnId,
        item: { type: "reasoning", id: `mini-reason-${turnId}`, turnId, threadId: s.threadId, status: "interrupted" } // DEFECT: template literal interpolation
      }
    });
    turn.status = "interrupted";
    s.activeTurnId = undefined;
    self.goalContinuationTurnKeys.delete(`${s.threadId}:${turnId}`); // DEFECT: template literal interpolation
    s.activeMaxRetries = undefined;
    s.activeAbort = undefined;
    s.pendingSteers = undefined;
    s.steerTurnId = undefined;
    self.persist(s);
    self.failMiniRetryNotice(s, turnId);
    self.emit("notification", {
      method: "turn/interrupted",
      params: {
        threadId: s.threadId,
        ...(s.parentThreadId ? { parentThreadId: s.parentThreadId } : {}),
        turnId,
        turn: { id: turnId, threadId: s.threadId, ...(s.parentThreadId ? { parentThreadId: s.parentThreadId } : {}), status: "interrupted", completedAt: Math.floor(Date.now() / 1000) }
      }
    });
    void fireMiniTurnFinishHook({
      threadId: s.threadId, turnId,
      ...(s.parentThreadId ? { parentThreadId: s.parentThreadId } : {}),
      cwd: s.cwd, model: s.model, status: "interrupted",
      summary: "",
      ...(s.parentThreadId && s.agentType ? { agentName: s.agentType } : {}),
    });
    if (s.parentThreadId) self.finishMiniSubagent(s, "interrupted", "");
  }

  fn completeTurn(self: &MiniBridge, s: MiniSession, turnId: TextBuf, text: TextBuf, opts: JsonValue) -> void { // method of MiniBridge
    let turn = s.turns.find((entry) => entry.id === turnId); // DEFECT: JS Array/String method
    if (!turn || turn.status !== "inProgress" || s.activeTurnId !== turnId || isMiniTurnCancelled(s, turnId)) return;
    self.flushMiniDeltas(s.threadId, turnId);
    self.emitMiniRetryRecoveredIfNeeded(s, turnId);
    let item = { type: "agentMessage", id: `mini-msg-${turnId}`, turnId, threadId: s.threadId, role: "assistant", status: "completed", text, content: [{ type: "text", text }] }; // DEFECT: template literal interpolation
    s.messages.push(item as JsonValue); // DEFECT: JS Array/String method
    let t = s.turns.find((x) => x.id === turnId); // DEFECT: JS Array/String method
    if (t) t.status = "completed";
    s.activeTurnId = undefined;
    self.goalContinuationTurnKeys.delete(`${s.threadId}:${turnId}`); // DEFECT: template literal interpolation
    s.activeMaxRetries = undefined;
    s.activeAbort = undefined;
    s.pendingSteers = undefined;
    s.steerTurnId = undefined;
    self.persist(s);
    self.emit("notification", {
      method: "item/completed",
      params: {
        threadId: s.threadId,
        ...(s.parentThreadId ? { parentThreadId: s.parentThreadId } : {}),
        turnId,
        item
      }
    });
    self.emit("notification", {
      method: "turn/completed",
      params: {
        threadId: s.threadId,
        ...(s.parentThreadId ? { parentThreadId: s.parentThreadId } : {}),
        turnId,
        turn: { id: turnId, threadId: s.threadId, ...(s.parentThreadId ? { parentThreadId: s.parentThreadId } : {}), status: "completed", completedAt: Math.floor(Date.now() / 1000) }
      }
    });
    void fireMiniTurnFinishHook({
      threadId: s.threadId, turnId,
      ...(s.parentThreadId ? { parentThreadId: s.parentThreadId } : {}),
      cwd: s.cwd, model: s.model, status: "completed",
      summary: text,
      ...(s.parentThreadId && s.agentType ? { agentName: s.agentType } : {}),
    });
    self.drainQueuedTurn(s);
    if (!isMiniTurnCancelled(s, turnId)) {
      self.settleGoalAfterTurn(s, turnId, text, { systemTurn: opts?.systemTurn }); // DEFECT: optional chaining ?.
    }
  }

    // Start the newest prompt queued through turn/steer after the active turn. */
  fn drainQueuedTurn(self: &MiniBridge, s: MiniSession) -> void { // method of MiniBridge
    let next = s.queuedTurns?.shift(); // DEFECT: optional chaining ?.
    if (!next || s.activeTurnId) return;
    let turnId = randomUUID();
    let userItem = {
      type: "userMessage", id: `mini-user-${turnId}`, turnId, threadId: s.threadId, // DEFECT: template literal interpolation
      text: next.text,
      content: [
        ...(next.text ? [{ type: "text", text: next.text }] : []),
        ...(next.images ?? []).map((image) => ({ type: "image", url: image.url, detail: image.detail ?? "auto" })), // DEFECT: JS Array/String method
      ],
      role: "user", status: "completed",
    };
    s.messages.push(userItem as JsonValue); // DEFECT: JS Array/String method
    s.turns.push({ id: turnId, status: "inProgress", createdAt: Date.now() }); // DEFECT: JS Array/String method
    s.activeTurnId = turnId;
    s.aborted = false;
    s.preview ??= next.text.slice(0, 80); // DEFECT: JS Array/String method
    self.persist(s);
    self.emit("notification", { method: "turn/started", params: { threadId: s.threadId, turnId, turn: { id: turnId, threadId: s.threadId, status: "inProgress" } } });
    self.emit("notification", { method: "item/completed", params: { threadId: s.threadId, turnId, item: userItem } });
    void self.runMiniTurn(s, turnId, next.text, { images: next.images }).catch((error) => { // DEFECT: exception (try/catch/throw)
      let message = String((error as Error)?.message ?? error); // DEFECT: optional chaining ?.
      if (message === "interrupted") self.interruptTurn(s, turnId);
      else self.failTurn(s, turnId, message);
    });
  }

  fn answerStatus(self: &MiniBridge, s: MiniSession, turnId: TextBuf) -> void { // method of MiniBridge
    let groups = self.skills.list([s.cwd]).catch(() => []); // DEFECT: exception (try/catch/throw)
    let skills = groups.flatMap((g) => g.skills).filter((x) => x.enabled).map((x) => x.name); // DEFECT: JS Array/String method
    let agentsMd = "off";
    if (miniAgentsMdMode() !== "off") {
      try { // DEFECT: exception (try/catch/throw)
        let root = findAgentsMdProjectRoot(s.cwd); // DEFECT: async/await
        agentsMd = `${(collectAgentsMdFiles(root, s.cwd, miniAgentsMdMode())).length} file(s)`; // DEFECT: template literal interpolation
      } catch { // DEFECT: exception (try/catch/throw)
        agentsMd = "unavailable";
      }
    }
    // Resolved window, not the product default: compaction and the composer
    // ring both run on this number (model [Nx] suffix > relay-group setting >
    // model catalog > 272K fallback), so a 128K here means the group or the
    // model genuinely caps at 128K — not a display bug.
    let windowLine = typeof s.lastContextWindow === "number" ? `${s.lastContextWindow} (last turn)` : "unknown"; // DEFECT: runtime type test (typeof/instanceof/in)
    try { // DEFECT: exception (try/catch/throw)
      let target = self.resolveTarget(s); // DEFECT: async/await
      windowLine = `${self.resolveSessionContextWindow(s, { groupContextWindow: target.groupContextWindow, modelCapability: target.modelCapability })} (resolved)`; // DEFECT: template literal interpolation
    } catch { // DEFECT: exception (try/catch/throw)
      // No usable route (e.g. no API key in tests): keep the persisted value.
    }
    let text = [
      `mini-codex status: ok`,
      `thread: ${s.threadId}`, // DEFECT: template literal interpolation
      `model: ${s.model}`, // DEFECT: template literal interpolation
      `effort: ${s.effort ?? MINI_DEFAULT_EFFORT}`, // DEFECT: template literal interpolation
      `cwd: ${s.cwd}`, // DEFECT: template literal interpolation
      `relay: ${s.providerId ?? "(env)"} / ${s.groupId ?? "(default)"}`, // DEFECT: template literal interpolation
      `window: ${windowLine}, auto-compact at ${miniAutoCompactThreshold()}%`, // DEFECT: template literal interpolation
      `turns: ${s.turns.length}, messages: ${s.messages.length}`, // DEFECT: template literal interpolation
      `skills: ${skills.length ? skills.join(", ") : "none"}`, // DEFECT: JS Array/String method
      `agentsMd: ${agentsMd}`, // DEFECT: template literal interpolation
      miniMcpStatusLine(),
    ].join("\n"); // DEFECT: JS Array/String method
    self.completeTurn(s, turnId, text, { systemTurn: true });
  }

  fn compactSession(self: &MiniBridge, s: MiniSession, turnId: TextBuf, opts: JsonValue) -> void { // method of MiniBridge
    let compactionItemId = `mini-compact-${turnId}`; // DEFECT: template literal interpolation
    let compactionItem = s.messages.find( // DEFECT: JS Array/String method
      (m: any) => m && (m.type === "contextCompaction" || m.type === "compaction") && m.turnId === turnId // DEFECT: arrow function / closure
    ) as Record<string, JsonValue> | undefined; // DEFECT: type assertion (as)
    if (!compactionItem) {
      compactionItem = {
        type: "contextCompaction",
        id: compactionItemId,
        threadId: s.threadId,
        turnId,
        title: "Context compaction",
        status: "inProgress",
        cliBackend: "mini",
      };
      s.messages.push(compactionItem as JsonValue); // DEFECT: JS Array/String method
      self.emitMiniItemStarted(s, turnId, compactionItem);
    }

    // A compaction request can settle after interruption while a new turn has
    // already claimed the session. Do not let its item or completion leak into
    // that newer turn.
    if (s.activeTurnId !== turnId) return;
    if (s.messages.length <= 2) {
      compactionItem.status = "completed";
      self.emitMiniItemCompleted(s, turnId, { ...compactionItem });
      self.completeTurn(s, turnId, "nothing to compact: history is already minimal.");
      return;
    }
    let { baseUrl, apiKey, protocol, maxRetries, modelCapability } = self.resolveTarget(s); // DEFECT: async/await
    s.activeMaxRetries = maxRetries;
    let ask = "Summarize this coding-agent transcript in 20 bullet lines or less. Preserve every durable conversation anchor exactly when possible: user requirements and preferences, file paths, decisions, constraints, unique facts, pending work, and the task-plan checklist with each step's status. Do not discard an early fact merely because it is old. No prose intro.";
    let summary = "";
    let compactCtrl = new AbortController(); // DEFECT: JS builtin construction (Map/Set/Date/RegExp/AbortController/Error)
    s.activeAbort = compactCtrl;
    let compactStalled = false;
    let compactStallTimer = setTimeout(() => { // DEFECT: timer
      compactStalled = true;
      try { compactCtrl.abort(); } catch { /* ignore */ } // DEFECT: exception (try/catch/throw)
    }, miniRoundStallTimeoutMs());
    try { // DEFECT: exception (try/catch/throw)
    let effort = s.effort ?? MINI_DEFAULT_EFFORT;
    let compactContent = buildMiniCompactContent(s.messages, protocol, 12000, s.imageInputUnsupported !== true);
    if (protocol === "chat" || protocol === "anthropic") {
      let isAnthropic = protocol === "anthropic";
      let compactText = compactContent
        .filter((b) => b.type === "text" || b.type === "input_text") // DEFECT: JS Array/String method
        .map((b) => String(b.text ?? "")) // DEFECT: JS Array/String method
        .filter(Boolean) // DEFECT: JS Array/String method
        .join("\n"); // DEFECT: JS Array/String method
      let res = self.fetchMiniUpstream(s, turnId, `${baseUrl.replace(/\/$/, "")}/${isAnthropic ? "messages" : "chat/completions"}`, { // DEFECT: JS Array/String method
        method: "POST",
        headers: { Authorization: `Bearer ${apiKey}`, "Content-Type": "application/json" }, // DEFECT: template literal interpolation
        signal: compactCtrl.signal,
        body: JSON.stringify(isAnthropic // DEFECT: dynamic JSON (JSON.parse/stringify)
          ? { model: s.model, system: ask, messages: [{ role: "user", content: compactText }], max_tokens: MINI_ANTHROPIC_MAX_TOKENS }
          : { model: s.model, reasoning_effort: effort, messages: [{ role: "system", content: ask }, { role: "user", content: compactContent }] }),
      }, maxRetries);
      if (!res.ok) throw new Error(`compact ${protocol} ${res.status}: ${(res.text()).slice(0, 300)}`); // DEFECT: exception (try/catch/throw)
      if (isAnthropic) {
        let data = (res.json()) as { content?: Array<{ type?: string; text?: string }> }; // DEFECT: async/await
        summary = (data.content ?? []).filter((c) => c.type === "text").map((c) => c.text ?? "").join("").trim(); // DEFECT: JS Array/String method
      } else {
      let data = (res.json()) as { choices?: Array<{ message?: { content?: string | null } }> }; // DEFECT: async/await
      summary = String(data.choices?.[0]?.message?.content ?? "").trim(); // DEFECT: optional chaining ?.
      }
    } else {
      let res = self.fetchMiniUpstream(s, turnId, `${baseUrl.replace(/\/$/, "")}/responses`, { // DEFECT: JS Array/String method
        method: "POST",
        headers: { Authorization: `Bearer ${apiKey}`, "Content-Type": "application/json" }, // DEFECT: template literal interpolation
        signal: compactCtrl.signal,
        body: JSON.stringify({ model: s.model, reasoning: { effort }, ...miniResponsesVerbosityField(s.model, modelCapability), instructions: ask, input: [{ role: "user", content: compactContent }] }), // DEFECT: dynamic JSON (JSON.parse/stringify)
      }, maxRetries);
      if (!res.ok) throw new Error(`compact responses ${res.status}: ${(res.text()).slice(0, 300)}`); // DEFECT: exception (try/catch/throw)
      let data = (res.json()) as { output?: Array<{ type?: string; content?: Array<{ text?: string }> }> }; // DEFECT: async/await
      summary = (data.output ?? []).filter((o) => o.type === "message").flatMap((o) => o.content ?? []).map((c) => c.text ?? "").join("").trim(); // DEFECT: JS Array/String method
    }
    } catch (e) { // DEFECT: exception (try/catch/throw)
      compactionItem.status = "failed";
      self.emitMiniItemCompleted(s, turnId, { ...compactionItem });
      let interrupted = miniInterruptFromAbort(s, e);
      if (interrupted) throw interrupted; // DEFECT: exception (try/catch/throw)
      if (!s.aborted && compactStalled) throw new Error(`压缩请求上游长时间无响应 (stall timeout): 请稍后重试。`); // DEFECT: exception (try/catch/throw)
      throw e; // DEFECT: exception (try/catch/throw)
    } finally {
      clearTimeout(compactStallTimer); // DEFECT: timer
      if (s.activeAbort === compactCtrl) s.activeAbort = undefined;
    }
    if (!summary) {
      compactionItem.status = "failed";
      self.emitMiniItemCompleted(s, turnId, { ...compactionItem });
      throw new Error("compact returned empty summary"); // DEFECT: exception (try/catch/throw)
    }
    if (s.activeTurnId !== turnId) return;
    let kept = s.messages.length;
    compactionItem.status = "completed";
    compactionItem.text = `compacted ${kept} items`; // DEFECT: template literal interpolation
    compactionItem.type = "contextCompaction";
    // Restore delivered AGENTS.md files model-visible: the folded transcript
    // loses them, so their paths ride the summary (system files re-render
    // next turn, nested ones re-attach on touch).
    let agentsMdNote = buildAgentsMdCompactionNote(s.agentsMdActive, s.cwd);
    let anchors = buildMiniCompactionAnchors(s.messages);
    let anchorNote = anchors ? `[durable conversation anchors]\n${anchors}` : ""; // DEFECT: template literal interpolation
    let summaryWithAgents = [summary, anchorNote, agentsMdNote].filter(Boolean).join("\n\n"); // DEFECT: JS Array/String method
    // Keep the live plan checklist structurally: restoreMiniPlan scans
    // messages for plan items, and folding the transcript used to wipe them —
    // the next turn then saw no plan and hallucinated progress. Carry
    // unfinished steps forward so the turn resumes the checklist.
    let carriedPlan = carryMiniPlanForward(s.messages, turnId, s.threadId);
    let compactImages = s.imageInputUnsupported === true ? [] : buildMiniHistoricalImageContent(s.messages, protocol);
    s.messages = [
      { type: "userMessage", id: `mini-compact-${turnId}`, turnId, threadId: s.threadId, role: "user", status: "completed", text: `[compacted ${kept} items]\n${summaryWithAgents}`, content: [{ type: protocol === "responses" ? "input_text" : "text", text: summaryWithAgents }, ...compactImages] } as JsonValue, // DEFECT: template literal interpolation
      compactionItem as JsonValue, // DEFECT: type assertion (as)
      ...(carriedPlan ? [carriedPlan] : []),
    ];
    self.emitMiniItemCompleted(s, turnId, { ...compactionItem });
    s.lastAutoCompactAt = Date.now();
    // Transcript was folded: any cached older-history summary is stale.
    self.miniHistorySummaryCache.delete(s.threadId);
    // History just shrank to a summary: reset usage so the next send barrier
    // measures the compacted history instead of re-compacting in a loop.
    // Heuristic (not exact o200k): summaries can be 10k+ chars and exact
    // encoding stalls the event loop for seconds here.
    s.lastUsedTokens = heuristicMiniTokens(summary);
    if (opts?.auto && typeof s.lastUsedTokens === "number" && typeof s.lastContextWindow === "number" && s.lastContextWindow > 0) { // DEFECT: runtime type test (typeof/instanceof/in)
      let pct = Math.round((s.lastUsedTokens / s.lastContextWindow) * 100);
      self.completeTurn(s, turnId, `auto-compacted ${kept} items into summary (context was ${pct}% full).`, { systemTurn: true }); // DEFECT: template literal interpolation
    } else {
      self.completeTurn(s, turnId, `compacted ${kept} items into summary.`, { systemTurn: true }); // DEFECT: template literal interpolation
    }
  }

  fn applyGoalDirective(self: &MiniBridge, s: MiniSession, text: TextBuf) -> TextBuf { // method of MiniBridge
    if (s.goalStatus !== "active" || !s.goalObjective?.trim()) return text; // DEFECT: optional chaining ?.
    if (text.includes(MINI_GOAL_CONTINUATION_MARKER)) return text; // DEFECT: JS Array/String method
    if (isMiniContinuationNudge(text)) {
      return [
        "<persisted-goal>",
        "This conversation has a persisted /goal objective. Treat it as the acceptance criteria of your work:", // DEFECT: type assertion (as)
        s.goalObjective.trim(), // DEFECT: JS Array/String method
        "When the objective is fully achieved and verified by tool output, reply with exactly GOAL_COMPLETE on its own line and stop.",
        "</persisted-goal>",
        "",
        text,
      ].join("\n"); // DEFECT: JS Array/String method
    }
    return text;
  }

  fn clearGoalContinuationTimer(self: &MiniBridge, threadId: TextBuf) -> void { // method of MiniBridge
    let timer = self.goalContinuationTimers.get(threadId);
    if (!timer) return;
    clearTimeout(timer); // DEFECT: timer
    self.goalContinuationTimers.delete(threadId);
  }

  fn scheduleGoalAutoContinuation(self: &MiniBridge, threadId: TextBuf) -> void { // method of MiniBridge
    let s = self.sessions.get(threadId);
    if (!s || s.goalStatus !== "active" || !s.goalObjective?.trim()) { // DEFECT: optional chaining ?.
      self.clearGoalContinuationTimer(threadId);
      return;
    }
    // Budget gate: stop before scheduling when the configured budget is spent.
    if (isMiniGoalBudgetExhausted(s)) {
      s.goalStatus = "budgetLimited";
      self.clearGoalContinuationTimer(threadId);
      self.goalContinuationCounts.delete(threadId);
      self.persist(s);
      self.emit("notification", { method: "thread/goal/updated", params: { goal: miniGoalState(s) } });
      return;
    }
    if (s.activeTurnId || self.goalContinuationTimers.has(threadId)) return;
    let count = self.goalContinuationCounts.get(threadId) ?? 0;
    if (count >= MAX_MINI_GOAL_AUTO_CONTINUATIONS) {
      s.goalStatus = "blocked";
      self.clearGoalContinuationTimer(threadId);
      self.goalContinuationCounts.delete(threadId);
      self.persist(s);
      self.emit("notification", { method: "thread/goal/updated", params: { goal: miniGoalState(s) } });
      return;
    }
    let timer = setTimeout(() => { // DEFECT: timer
      self.goalContinuationTimers.delete(threadId);
      void self.startGoalContinuationTurn(threadId);
    }, 1000);
    self.goalContinuationTimers.set(threadId, timer);
  }

    //
   //* Shared goal-turn settlement: GOAL_COMPLETE wins; otherwise record a
   //* cross-turn progress fingerprint and convert N consecutive no-change turns
   //* into blocked instead of looping to 50.
   //
  fn settleGoalAfterTurn(self: &MiniBridge, s: MiniSession, turnId: TextBuf, text: TextBuf, opts: JsonValue) -> void { // method of MiniBridge
    if (s.goalStatus !== "active" || !s.goalObjective?.trim()) return; // DEFECT: optional chaining ?.
    // System turns (status query, manual/auto compaction) carry no goal
    // progress: they must not claim GOAL_COMPLETE (a compaction summary can
    // quote the marker) and must not feed synthetic texts like "compacted N
    // items into summary." into the stagnation fingerprint — right after a
    // transcript fold that would silently reset goalStagnantTurns. An active
    // goal still schedules its continuation below (pre-existing behavior).
    if (!opts?.systemTurn) { // DEFECT: optional chaining ?.
      if (hasGoalCompleteSignal(text)) {
        s.goalStatus = "complete";
        s.goalStagnantTurns = 0;
        self.clearGoalContinuationTimer(s.threadId);
        self.goalContinuationCounts.delete(s.threadId);
        self.persist(s);
        self.emit("notification", { method: "thread/goal/updated", params: { goal: miniGoalState(s) } });
        return;
      }
    }
    // Defense in depth alongside completeTurn's systemTurn flag: a turn
    // with no model content (no tool/plan/message for this turnId — e.g. a
    // transcript fold replaced s.messages) must not touch the stagnation
    // counters. noteMiniGoalTurnProgress would otherwise treat the empty
    // fingerprint as "new progress" and silently reset goalStagnantTurns.
    let fingerprint = "";
    try { // DEFECT: exception (try/catch/throw)
      fingerprint = miniGoalTurnFingerprint(s.messages, turnId);
    } catch { fingerprint = ""; } // DEFECT: exception (try/catch/throw)
    if (!fingerprint || opts?.systemTurn) { // DEFECT: optional chaining ?.
      self.persist(s);
      self.scheduleGoalAutoContinuation(s.threadId);
      return;
    }
    let stagnant = false;
    try { // DEFECT: exception (try/catch/throw)
      stagnant = noteMiniGoalTurnProgress(s, fingerprint, miniGoalToolFingerprint(s.messages, turnId));
    } catch { stagnant = false; } // DEFECT: exception (try/catch/throw)
    if (stagnant) {
      s.goalStatus = "blocked";
      self.clearGoalContinuationTimer(s.threadId);
      self.goalContinuationCounts.delete(s.threadId);
      self.persist(s);
      self.emit("notification", { method: "thread/goal/updated", params: { goal: miniGoalState(s) } });
      return;
    }
    self.persist(s);
    self.scheduleGoalAutoContinuation(s.threadId);
  }

  fn startGoalContinuationTurn(self: &MiniBridge, threadId: TextBuf) -> void { // method of MiniBridge
    let s = self.sessions.get(threadId);
    if (!s || s.activeTurnId) return;
    if (s.goalStatus !== "active" || !s.goalObjective?.trim()) return; // DEFECT: optional chaining ?.
    if (isMiniGoalBudgetExhausted(s)) {
      s.goalStatus = "budgetLimited";
      self.clearGoalContinuationTimer(threadId);
      self.goalContinuationCounts.delete(threadId);
      self.persist(s);
      self.emit("notification", { method: "thread/goal/updated", params: { goal: miniGoalState(s) } });
      return;
    }
    let turnId = randomUUID();
    let nextCount = (self.goalContinuationCounts.get(threadId) ?? 0) + 1;
    self.goalContinuationCounts.set(threadId, nextCount);
    // Authoritative progress block: current plan resolves the "re-list the
    // same tasks" loop by telling the model what is already decided/done.
    let planText = "";
    try { // DEFECT: exception (try/catch/throw)
      let steps = restoreMiniPlan(s.messages);
      if (steps.length) planText = formatMiniPlanText(steps);
    } catch { planText = ""; } // DEFECT: exception (try/catch/throw)
    let promptText = buildMiniGoalContinuationPrompt(s, { count: nextCount, max: MAX_MINI_GOAL_AUTO_CONTINUATIONS, planText, stagnantTurns: s.goalStagnantTurns ?? 0 });
    // Internal fragment, not a user turn: the live prompt goes to runMiniTurn
    // directly. History keeps only the newest fragment (see the collapse in
    // miniHistoryLinesFromMessages); the waterfall filters it by marker text.
    let userItem = { type: MINI_GOAL_CONTINUATION_ITEM_TYPE, id: `mini-goal-${turnId}`, turnId, threadId, text: promptText, content: [{ type: "text", text: promptText }], role: "user", status: "completed" }; // DEFECT: template literal interpolation
    s.messages.push(userItem as JsonValue); // DEFECT: JS Array/String method
    s.turns.push({ id: turnId, status: "inProgress", createdAt: Date.now() }); // DEFECT: JS Array/String method
    s.activeTurnId = turnId; s.aborted = false;
    self.goalContinuationTurnKeys.add(`${threadId}:${turnId}`); // DEFECT: template literal interpolation
    self.persist(s);
    self.emit("notification", { method: "turn/started", params: { threadId, turnId, turn: { id: turnId, threadId, status: "inProgress" } } });
    self.emit("notification", { method: "item/completed", params: { threadId, turnId, item: userItem } });
    try { // DEFECT: exception (try/catch/throw)
      self.runMiniTurn(s, turnId, promptText, {}); // DEFECT: async/await
    } catch (e) { // DEFECT: exception (try/catch/throw)
      let message = String((e as Error)?.message ?? e); // DEFECT: optional chaining ?.
      if (message === "interrupted") self.interruptTurn(s, turnId);
      else self.failTurn(s, turnId, message);
    }
  }

  fn miniChildOwnerVisible(self: &MiniBridge, parent: MiniSession, childOwner: TextBuf) -> bool { // method of MiniBridge
    if (!childOwner || childOwner === "local") return true;
    if (!parent.ownerId || parent.ownerId === "local") return false;
    return childOwner === parent.ownerId;
  }

  fn miniLiveChildren(self: &MiniBridge, parent: MiniSession) -> JsonArray { // method of MiniBridge
    let out: Array<MiniSession | MiniSnapshot> = [];
    let seen = new Set<string>(); // DEFECT: JS builtin construction (Map/Set/Date/RegExp/AbortController/Error)
    for (const child of self.sessions.values()) {
      if (child.parentThreadId !== parent.threadId || !self.miniChildOwnerVisible(parent, child.ownerId)) continue;
      if (child.closed === true) continue; // close_agent released residency; resumable via resume_agent.
      // Residency is released by close_agent, not by turn completion. Keep
      // finished/failed/interrupted children registered until explicitly
      // closed so the concurrency budget cannot be bypassed by spawning again.
      out.push(child); // DEFECT: JS Array/String method
      seen.add(child.threadId);
    }
    for (const snapshot of self.options?.listSnapshots?.(parent.ownerId) ?? []) { // DEFECT: optional chaining ?.
      if (snapshot.parentThreadId !== parent.threadId || snapshot.archived || snapshot.closed === true || seen.has(snapshot.threadId)) continue;
      if (!self.miniChildOwnerVisible(parent, snapshot.ownerId)) continue;
      out.push(snapshot); // DEFECT: JS Array/String method
    }
    return out;
  }

  fn miniFindChild(self: &MiniBridge, parent: MiniSession, target: JsonValue) -> MiniSession  { // method of MiniBridge
    let t = typeof target === "string" ? target.trim() : ""; // DEFECT: runtime type test (typeof/instanceof/in)
    if (!t) return undefined;
    for (const child of self.sessions.values()) {
      if (child.parentThreadId !== parent.threadId || !self.miniChildOwnerVisible(parent, child.ownerId)) continue;
      if (child.closed === true) continue;
      if (child.threadId === t || child.taskName === t) return child;
    }
    for (const snapshot of self.options?.listSnapshots?.(parent.ownerId) ?? []) { // DEFECT: optional chaining ?.
      if (snapshot.parentThreadId !== parent.threadId || snapshot.archived || snapshot.closed === true || !self.miniChildOwnerVisible(parent, snapshot.ownerId)) continue;
      if (snapshot.threadId !== t && snapshot.taskName !== t) continue;
      return self.getOrRestoreSession(snapshot.threadId, parent.ownerId);
    }
    return undefined;
  }

  fn miniChildStatus(self: &MiniBridge, child: MiniSession) -> TextBuf { // method of MiniBridge
    if (child.activeTurnId) return "running";
    return child.subStatus ?? "running";
  }

    //
   //* Result inbox (OpenCode task.ts inject parity): collect freshly completed
   //* child reports not yet delivered to the parent live thread. Pure scan over
   //* live sessions; delivery bookkeeping lives on `deliveredAgentReports` so a
   //* report is injected exactly once even if wait_agent already inlined it.
   //
  fn collectMiniAgentInbox(self: &MiniBridge, parent: MiniSession) -> JsonArray { // method of MiniBridge
    let delivered = new Set(Array.isArray(parent.deliveredAgentReports) ? parent.deliveredAgentReports : []); // DEFECT: JS builtin construction (Map/Set/Date/RegExp/AbortController/Error)
    let out: MiniAgentInboxReport[] = [];
    for (const child of self.sessions.values()) {
      if (child.parentThreadId !== parent.threadId || !self.miniChildOwnerVisible(parent, child.ownerId)) continue;
      if (child.closed === true) continue;
      if (child.activeTurnId) continue;
      let st = self.miniChildStatus(child);
      if (st !== "completed" && st !== "failed" && st !== "interrupted") continue;
      let report = (child.finalReport ?? "").trim(); // DEFECT: JS Array/String method
      if (!report) continue;
      let pending = (child.pendingInputs ?? []).length;
      if (pending > 0) continue;
      let key = miniAgentInboxKey(child.threadId, st);
      if (delivered.has(key)) continue;
      out.push({ agentId: child.threadId, taskName: child.taskName, status: st, report: report.slice(0, 8000) }); // DEFECT: JS Array/String method
    }
    return out;
  }

    // Mark inbox reports delivered (persists so restarts do not re-inject). */
  fn markMiniAgentInboxDelivered(self: &MiniBridge, parent: MiniSession, reports: JsonArray) -> void { // method of MiniBridge
    if (!reports.length) return;
    parent.deliveredAgentReports ??= [];
    for (const r of reports) {
      let key = miniAgentInboxKey(r.agentId, r.status);
      if (!parent.deliveredAgentReports.includes(key)) parent.deliveredAgentReports.push(key); // DEFECT: JS Array/String method
    }
    try { self.persist(parent); } catch { /* best-effort */ } // DEFECT: exception (try/catch/throw)
  }

  fn cancelQueuedMiniChildTurn(self: &MiniBridge, child: MiniSession, turnId: TextBuf) -> void { // method of MiniBridge
    for (const queued of self.miniChildTurnQueue) {
      if (queued.child === child && (!turnId || queued.turnId === turnId)) queued.cancelled = true;
    }
  }

  fn pumpMiniChildTurnQueue(self: &MiniBridge, ) -> void { // method of MiniBridge
    let limit = miniChildTurnConcurrency();
    while (self.miniChildTurnsInFlight < limit && self.miniChildTurnQueue.length) {
      let queued = self.miniChildTurnQueue.shift()!;
      if (queued.cancelled || queued.child.activeTurnId !== queued.turnId) continue;
      self.miniChildTurnsInFlight++;
      let run = self.runMiniTurn(queued.child, queued.turnId, queued.prompt, {});
      void run
        .catch((e) => { // DEFECT: exception (try/catch/throw)
          let msg = String((e as Error)?.message ?? e); // DEFECT: optional chaining ?.
          if (msg === "interrupted") self.interruptTurn(queued.child, queued.turnId);
          else self.failTurn(queued.child, queued.turnId, msg);
        })
        .finally(() => { // DEFECT: arrow function / closure
          self.miniChildTurnsInFlight = Math.max(0, self.miniChildTurnsInFlight - 1);
          self.pumpMiniChildTurnQueue();
        });
    }
  }

  fn enqueueMiniChildTurn(self: &MiniBridge, child: MiniSession, turnId: TextBuf, prompt: TextBuf) -> void { // method of MiniBridge
    self.miniChildTurnQueue.push({ child, turnId, prompt, cancelled: false }); // DEFECT: JS Array/String method
    self.pumpMiniChildTurnQueue();
  }

  fn startMiniChildTurn(self: &MiniBridge, child: MiniSession, promptText: TextBuf) -> void { // method of MiniBridge
    let turnId = randomUUID();
    let userItem = { type: "userMessage", id: `mini-user-${turnId}`, turnId, threadId: child.threadId, text: promptText, content: [{ type: "text", text: promptText }], role: "user", status: "completed" }; // DEFECT: template literal interpolation
    child.messages.push(userItem as JsonValue); // DEFECT: JS Array/String method
    child.turns.push({ id: turnId, status: "inProgress", createdAt: Date.now() }); // DEFECT: JS Array/String method
    child.activeTurnId = turnId; child.aborted = false; child.subStatus = "running";
    if (!child.preview) child.preview = promptText.slice(0, 80); // DEFECT: JS Array/String method
    self.persist(child);
    self.notifyMiniChild(child.threadId);
    self.emit("notification", {
      method: "turn/started",
      params: {
        threadId: child.threadId,
        ...(child.parentThreadId ? { parentThreadId: child.parentThreadId } : {}),
        turnId,
        turn: {
          id: turnId,
          threadId: child.threadId,
          ...(child.parentThreadId ? { parentThreadId: child.parentThreadId } : {}),
          status: "inProgress"
        }
      }
    });
    self.emit("notification", {
      method: "item/completed",
      params: {
        threadId: child.threadId,
        ...(child.parentThreadId ? { parentThreadId: child.parentThreadId } : {}),
        turnId,
        item: userItem
      }
    });
    let run = (s: MiniSession, tid: string, p: string): Promise<void> => self.runMiniTurn(s, tid, p, {}); // DEFECT: arrow function / closure
    let starter = self.options?.startSubagentTurn; // DEFECT: optional chaining ?.
    // A host-provided starter owns its scheduling contract. The embedded Mini
    // path uses the bounded FIFO queue below so a five-child burst cannot open
    // five simultaneous relay streams on top of the parent turn.
    if (!starter) {
      self.enqueueMiniChildTurn(child, turnId, promptText);
      return;
    }
    try { // DEFECT: exception (try/catch/throw)
      starter(child, promptText, run);
    } catch (e) { // DEFECT: exception (try/catch/throw)
      self.failTurn(child, turnId, String((e as Error)?.message ?? e)); // DEFECT: optional chaining ?.
    }
  }

  fn drainMiniSubagentQueue(self: &MiniBridge, child: MiniSession) -> void { // method of MiniBridge
    if (child.activeTurnId) return;
    let next = (child.pendingInputs ?? []).shift();
    if (!next) return;
    self.persist(child);
    self.startMiniChildTurn(child, next);
  }

  fn finishMiniSubagent(self: &MiniBridge, child: MiniSession, status: TextBuf, report: TextBuf) -> void { // method of MiniBridge
    // A provider callback can settle after parent/thread deletion. Do not
    // persist or emit a deleted child back into history from that stale object.
    if (self.sessions.get(child.threadId) !== child) return;
    child.subStatus = status;
    if (report) child.finalReport = report.slice(0, 8000); // DEFECT: JS Array/String method
    else if (status === "completed" && !child.finalReport) child.finalReport = "";
    self.persist(child);
    // Structured completion event (official parity): wait_agent returns status
    // only; full content travels here + read_agent_report, never inlined in
    // every wait poll. Cap event payload like the stored report.
    let completedReport = (child.finalReport ?? "").slice(0, 8000); // DEFECT: JS Array/String method
    if (child.parentThreadId) {
      self.emit("notification", {
        method: "agent/completed",
        params: {
          parentThreadId: child.parentThreadId,
          threadId: child.threadId,
          agent_id: child.threadId,
          task_name: child.taskName ?? "",
          status,
          has_report: completedReport.length > 0,
          report_bytes: completedReport.length,
          report_preview: completedReport.slice(0, 500), // DEFECT: JS Array/String method
          report: completedReport,
        },
      });
      // Compat: lifecycle listeners also watch agent/status/updated.
      self.emit("notification", {
        method: "agent/status/updated",
        params: { threadId: child.threadId, parentThreadId: child.parentThreadId, status, report: completedReport.slice(0, 2000) }, // DEFECT: JS Array/String method
      });
      // Official parity (G1): the completion also lands in the parent history
      // as a user-role marker capped to ~1000 tokens, so the parent model sees
      // the outcome without an extra read_agent_report round-trip. The full
      // text stays in read_agent_report + the event above. NOTE: uses the
      // char heuristic, never countMiniTokens — exact o200k encoding takes
      // tens of seconds on long reports under bun and would stall completion.
      let parent = self.sessions.get(child.parentThreadId);
      if (parent) {
        let markerCap = 900;
        let markerText = completedReport;
        if (heuristicMiniTokens(markerText) > markerCap) {
          let budget = Math.min(markerText.length, 3600);
          while (budget > 0 && heuristicMiniTokens(markerText.slice(0, budget)) > markerCap) { // DEFECT: JS Array/String method
            budget = Math.floor(budget * 0.8);
          }
          markerText = `${markerText.slice(0, budget).trimEnd()}…[truncated to ~1000 tokens; use read_agent_report for the full report]`; // DEFECT: JS Array/String method
        }
        let marker = `[sub-agent ${child.taskName ?? child.threadId} ${status}]: ${markerText}`; // DEFECT: template literal interpolation
        parent.messages.push({ // DEFECT: JS Array/String method
          type: "userMessage",
          id: `mini-agent-done-${randomUUID().slice(0, 8)}`, // DEFECT: JS Array/String method
          turnId: parent.activeTurnId ?? `mini-external-${Date.now()}`, // DEFECT: template literal interpolation
          threadId: parent.threadId,
          text: marker,
          content: [{ type: "text", text: marker }],
          role: "user",
          status: "completed",
        } as JsonValue); // DEFECT: type assertion (as)
        self.persist(parent);
      }
    }
    if (status !== "completed") { self.drainMiniSubagentQueue(child); self.notifyMiniChild(child.threadId); return; }
    self.drainMiniSubagentQueue(child);
    self.notifyMiniChild(child.threadId);
  }

  handleMiniRequestUserInput( // DEFECT: async function
    s: MiniSession,
    turnId: string,
    args: Record<string, any>
  ): Promise<string> { // DEFECT: Promise
    let rawQuestions = Array.isArray(args.questions) ? args.questions : [];
    if (!rawQuestions.length) {
      return "No questions provided to request_user_input.";
    }

    let normalizedQuestions = rawQuestions.map((q: any, idx: number) => { // DEFECT: JS Array/String method
      let id = typeof q.id === "string" && q.id.trim() ? q.id.trim() : `q_${idx + 1}`; // DEFECT: runtime type test (typeof/instanceof/in)
      let question = typeof q.question === "string" ? q.question : String(q.title || q.text || ""); // DEFECT: runtime type test (typeof/instanceof/in)
      let header = typeof q.header === "string" ? q.header : undefined; // DEFECT: runtime type test (typeof/instanceof/in)
      let options = Array.isArray(q.options) ? q.options.map(String) : undefined; // DEFECT: JS Array/String method
      let isMultiSelect = Boolean(q.is_multi_select || q.isMultiSelect || q.multiple);
      return {
        id,
        question,
        ...(header ? { header } : {}),
        ...(options && options.length ? { options } : {}),
        ...(isMultiSelect ? { is_multi_select: true } : {}),
      };
    });

    let requestId = `mini-input-${randomUUID().slice(0, 8)}`; // DEFECT: JS Array/String method
    let serverReq: JsonRpcRequest = {
      id: requestId,
      method: "item/tool/requestUserInput",
      params: {
        itemId: requestId,
        threadId: s.threadId,
        turnId,
        questions: normalizedQuestions as unknown as JsonValue[], // DEFECT: type assertion (as)
      } as Record<string, JsonValue>, // DEFECT: type assertion (as)
    };

    self.emit("message", serverReq);

    return new Promise<string>((resolve) => { // DEFECT: JS builtin construction (Map/Set/Date/RegExp/AbortController/Error)
      let timeoutMs = 120_000;
      let timer = setTimeout(() => { // DEFECT: timer
        if (self.pendingUserInputs.has(requestId)) {
          self.pendingUserInputs.delete(requestId);
          resolve("(用户超时未回复，请按推荐/默认选项继续，不要重复提问)");
        }
      }, timeoutMs);

      self.pendingUserInputs.set(requestId, {
        resolve: (ans: string) => { // DEFECT: arrow function / closure
          resolve(ans ? `User answered: ${ans}\n(Continue the task based on this answer. Do not ask the same question again. Do not return an empty reply; produce text or tool calls.)` : "(用户跳过提问，请按默认选项继续。不要重复提问，不要返回空回复，直接给出文字或工具调用继续任务。)"); // DEFECT: template literal interpolation
        },
        threadId: s.threadId,
        turnId,
        timer,
      });
    });
  }

    //
   //* Ask the user to approve one mutating tool call. Renders in the existing
   //* approval modal (method-driven, zero frontend changes): file writes use
   //* `item/fileChange/requestApproval`, exec uses
   //* `item/commandExecution/requestApproval`. Answers arrive through the
   //* generic server-request/respond route into `respond()`. Timeout behaves
   //* like a decline (turn continues); cancel aborts the turn.
   //
  requestMiniApproval( // DEFECT: async function
    s: MiniSession,
    turnId: string,
    lane: MiniApprovalLane,
    summary: { action: string; target: string; reason: string },
    timeoutMs = MINI_APPROVAL_TIMEOUT_MS,
  ): Promise<MiniApprovalDecision> { // DEFECT: Promise
    let requestId = `mini-approval-${randomUUID().slice(0, 8)}`; // DEFECT: JS Array/String method
    let method = lane === "file" ? "item/fileChange/requestApproval" : "item/commandExecution/requestApproval";
    let serverReq: JsonRpcRequest = {
      id: requestId,
      method,
      params: {
        threadId: s.threadId,
        turnId,
        action: summary.action,
        target: summary.target,
        reason: summary.reason,
        cwd: s.cwd,
        source: "mini",
      } as Record<string, JsonValue>, // DEFECT: type assertion (as)
    };
    self.emit("message", serverReq);
    return new Promise<MiniApprovalDecision>((resolve) => { // DEFECT: JS builtin construction (Map/Set/Date/RegExp/AbortController/Error)
      let wait = Math.min(Math.max(1000, Math.floor(timeoutMs) || MINI_APPROVAL_TIMEOUT_MS), 600000);
      let timer = setTimeout(() => { // DEFECT: timer
        if (self.pendingApprovals.has(requestId)) {
          self.pendingApprovals.delete(requestId);
          resolve("timeout");
        }
      }, wait);
      self.pendingApprovals.set(requestId, { resolve, threadId: s.threadId, turnId, timer });
    });
  }

  fn handleMiniSubagentCall(self: &MiniBridge, s: MiniSession, name: TextBuf, a: JsonValue) -> TextBuf { // method of MiniBridge
    // Retired spelling send_input transparently behaves as send_message.
    // followup_task is first-class (queue + trigger) and never an alias.
    name = normalizeMiniSubagentToolName(name);
    if (name === "spawn_agent") {
      let childDepth = (s.depth ?? 0) + 1;
      if (isMiniSubagentDepthExceeded(childDepth)) {
        return "Agent depth limit reached. Solve the task yourself - sub-agents cannot spawn further.";
      }
      if (s.parentThreadId) {
        return "Agent depth limit reached. Solve the task yourself - sub-agents cannot spawn further.";
      }
      let message = miniCoerceSpawnMessage(a);
      if (!message) return "spawn_agent needs {task_name,message}: a non-empty plain-text brief describing the subtask.";
      let rawTask = typeof a.task_name === "string" ? a.task_name : typeof a.taskName === "string" ? a.taskName : ""; // DEFECT: runtime type test (typeof/instanceof/in)
      let taskName = parseMiniSubagentTaskName(rawTask)
        ?? `task_${randomUUID().replace(/-/g, "").slice(0, 8)}`; // DEFECT: JS Array/String method
      let agentType = typeof a.agent_type === "string" ? a.agent_type : typeof a.agentType === "string" ? a.agentType : ""; // DEFECT: runtime type test (typeof/instanceof/in)
      let live = self.miniLiveChildren(s);
      let maxChildren = miniSubagentMaxChildren();
      if (live.length >= maxChildren) {
        return `Agent concurrency limit reached (${maxChildren}). Wait for running agents with wait_agent or close finished ones, then retry.`; // DEFECT: template literal interpolation
      }
      let childId = randomUUID();
      let child: MiniSession = {
        threadId: childId, ownerId: s.ownerId, cwd: s.cwd, model: s.model,
        providerId: s.providerId, groupId: s.groupId,
        // Workspace roots follow the parent (same trust domain, depth-limited):
        // without them the child loses cross-root search, MCP roots, and
        // agentsMd scopes and fails with permission/file-not-found errors.
        additionalRoots: s.additionalRoots ? [...s.additionalRoots] : undefined,
        agentsMdActive: s.agentsMdActive ? [...s.agentsMdActive] : undefined,
        effort: normalizeMiniEffort(a.reasoning_effort ?? a.reasoningEffort ?? a.effort) ?? s.effort ?? MINI_DEFAULT_EFFORT,
        // Policy follows the parent (sandbox + approval cards); the session
        // bypass never inherits - each thread earns its own "allow session".
        sandbox: s.sandbox, approvalPolicy: s.approvalPolicy,
        createdAt: Date.now(),
        turns: [], messages: [],
        parentThreadId: s.threadId, depth: childDepth,
        agentType: agentType.trim().slice(0, 120) || undefined, // DEFECT: JS Array/String method
        taskName, subStatus: "running", finalReport: "", pendingInputs: [],
      };
      self.sessions.set(childId, child);
      self.emit("notification", {
        method: "thread/started",
        params: {
          thread: {
            id: childId,
            parentThreadId: s.threadId,
            agentNickname: taskName,
            agentRole: agentType || "agent",
            model: child.model,
            cliBackend: "mini",
            createdAt: Date.now(),
            updatedAt: Date.now(),
            status: { type: "active" },
          },
        },
      });
      self.startMiniChildTurn(child, buildMiniSubagentPrompt(taskName, message, agentType));
      return JSON.stringify({ agent_id: childId, task_name: taskName, nickname: taskName, status: "running" }); // DEFECT: dynamic JSON (JSON.parse/stringify)
    }
    if (name === "send_message") {
      let target = typeof a.target === "string" ? a.target : typeof a.id === "string" ? a.id : ""; // DEFECT: runtime type test (typeof/instanceof/in)
      let child = self.miniFindChild(s, target);
      if (!child) return `send_message: unknown sub-agent '${String(target ?? "").slice(0, 80)}'. Use list_agents to see live agents.`; // DEFECT: JS Array/String method
      let message = typeof a.message === "string" && a.message.trim() // DEFECT: runtime type test (typeof/instanceof/in)
        ? a.message.trim() // DEFECT: JS Array/String method
        : typeof a.text === "string" && a.text.trim() ? a.text.trim() : ""; // DEFECT: runtime type test (typeof/instanceof/in)
      if (!message) return "send_message needs a non-empty message.";
      if (a.interrupt === true) {
