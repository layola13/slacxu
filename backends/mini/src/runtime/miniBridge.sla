        if (snapshot.parentThreadId !== s.threadId || snapshot.archived || snapshot.closed === true || seen.has(snapshot.threadId) || !self.miniChildOwnerVisible(s, snapshot.ownerId)) continue;
        if (!matchPrefix(snapshot.taskName)) continue;
        agents.push({ // DEFECT: JS Array/String method
          agent_id: snapshot.threadId,
          task_name: snapshot.taskName ?? "",
          agent_type: snapshot.agentType ?? "",
          status: snapshot.subStatus === "running" || !snapshot.subStatus ? "interrupted" : snapshot.subStatus,
        });
      }
      return JSON.stringify({ agents }); // DEFECT: dynamic JSON (JSON.parse/stringify)
    }
    return miniUnknownToolError(name);
  }

  fn runMiniTurn(self: &MiniBridge, s: MiniSession, turnId: TextBuf, prompt: TextBuf, opts: TextBuf) -> void { // method of MiniBridge
    let isClaude = isClaudeModelId(s.model);
    // Threads that already proved chat-only skip the wasted responses 400 probe.
    // Claude models NEVER fall back or switch to chat.
    let entryOpts = !opts?.forceProtocol && !isClaude && self.miniChatFallbackThreads.has(self.miniChatFallbackKey(s)) // DEFECT: optional chaining ?.
      ? { ...opts, forceProtocol: "chat" as const } // DEFECT: type assertion (as)
      : opts;
    return self.runMiniTurnOnce(s, turnId, prompt, entryOpts).catch((error) => { // DEFECT: exception (try/catch/throw)
      if (isModelProtocolUnsupportedError(error) && !isClaude && entryOpts?.forceProtocol !== "chat") { // DEFECT: optional chaining ?.
        // Generic fallback (no model allowlist): a chat-only model behind a
        // responses-fixed group fails fast with ModelProtocolUnsupported before
        // any tool executes, so re-running the turn over chat is side-effect
        // free. Remember per thread+model to skip the wasted 400 next turn.
        console.warn(`[mini] ${s.model ?? "?"} rejected responses protocol; retrying turn ${turnId} over chat`); // DEFECT: template literal interpolation
        self.miniChatFallbackThreads.add(self.miniChatFallbackKey(s));
        return self.runMiniTurn(s, turnId, prompt, { ...opts, forceProtocol: "chat" });
      }
      if (isAnthropicEndpointUnsupportedError(error) && !isClaude && !isMiniAnthropicEmptyResponseError(error) && entryOpts?.forceProtocol !== "chat") { // DEFECT: optional chaining ?.
        // Generic recovery (no model gate): the relay has no Messages surface
        // for this route. Chat is the next most compatible wire format.
        // Empty streams are excluded: Claude turns stay on Messages and retry
        // there (same-turn retry below), they never flip to chat.
        console.warn(`[mini] anthropic endpoint unavailable for ${s.model ?? "?"}; retrying turn ${turnId} over chat`); // DEFECT: template literal interpolation
        self.miniChatFallbackThreads.add(self.miniChatFallbackKey(s));
        return self.runMiniTurn(s, turnId, prompt, { ...opts, forceProtocol: "chat" });
      }
      let message = String((error as Error)?.message ?? error); // DEFECT: optional chaining ?.
      if (message !== "steered" || s.activeTurnId !== turnId || !s.pendingSteers?.length) throw error; // DEFECT: optional chaining ?.
      let steers = s.pendingSteers.splice(0); // DEFECT: JS Array/String method
      s.steerTurnId = undefined;
      self.persist(s);
      let combinedPrompt = [prompt, ...steers.map((steer) => steer.text).filter(Boolean)].filter(Boolean).join("\n\n"); // DEFECT: JS Array/String method
      let images = [...(opts?.images ?? []), ...steers.flatMap((steer) => steer.images ?? [])]; // DEFECT: optional chaining ?.
      // The upstream HTTP request cannot be mutated in flight. Restart its
      // next round under the same turn id with the original request and all
      // steering input accepted before the abort settled.
      return self.runMiniTurn(s, turnId, combinedPrompt, { ...opts, images });
    });
  }

  fn runMiniTurnOnce(self: &MiniBridge, s: MiniSession, turnId: TextBuf, prompt: TextBuf, opts: TextBuf) -> void { // method of MiniBridge
    if (isMiniTurnCancelled(s, turnId)) throw new Error("interrupted"); // DEFECT: exception (try/catch/throw)
    let { baseUrl, apiKey, protocol: resolvedProtocol, maxRetries, groupContextWindow, modelCapability } = self.resolveTarget(s); // DEFECT: async/await
    let isClaude = isClaudeModelId(s.model);
    // Wire protocol: Claude models strictly use native Anthropic Messages protocol and must NEVER switch to chat.
    // For non-Claude models: explicit force wins, otherwise the relay default.
    let wireProtocol = isClaude ? "anthropic" : (opts?.forceProtocol ?? resolvedProtocol); // DEFECT: optional chaining ?.
    // Thread shape follows the chat family for anthropic (converted to Messages
    // format at send time), so every cThread/rThread site below keeps working
    // unchanged; only the transport branch uses wireProtocol.
    let protocol: "responses" | "chat" = wireProtocol === "responses" ? "responses" : "chat";
    if (isMiniTurnCancelled(s, turnId)) throw new Error("interrupted"); // DEFECT: exception (try/catch/throw)
    if (s.activeTurnId === turnId) s.activeMaxRetries = maxRetries;
    let contextWindow = self.resolveSessionContextWindow(s, { groupContextWindow, modelCapability });
    // Pure-conversation mode (side chat duck route): skip every agentic
    // input — skills, AGENTS.md, MCP tools, capabilities, memory digest —
    // and run with an empty tool list plus a minimal system prompt.
    let pureChat = s.pureChat === true;
    // Prep runs concurrently: skills, AGENTS.md, MCP tools, and capabilities
    // are independent — sequential awaits added ~4 setup round-trips per turn.
    let skillsPromise: Promise<any[]> = pureChat ? Promise.resolve([]) : self.skills.list([s.cwd]).catch(() => []); // DEFECT: exception (try/catch/throw)
    let agentsMdMode = pureChat ? "off" : miniAgentsMdMode();
    let agentsMdPromise = ((): Promise<{ files: AgentsMdFile[]; root: string; scopes: Array<{ root: string; base: string }> }> => { // DEFECT: arrow function / closure
      if (agentsMdMode === "off") return { files: [], root: s.cwd, scopes: [{ root: s.cwd, base: s.cwd }] };
      try { // DEFECT: exception (try/catch/throw)
        let root = findAgentsMdProjectRoot(s.cwd); // DEFECT: async/await
        let files = collectAgentsMdFiles(root, s.cwd, agentsMdMode); // DEFECT: async/await
        let seenContent = new Set(files.map((file) => file.content.trim())); // DEFECT: JS Array/String method
        for (const extra of collectExtraRootsAgentsMd(s.additionalRoots, agentsMdMode)) { // DEFECT: async/await
          if (seenContent.has(extra.content.trim())) continue; // DEFECT: JS Array/String method
          seenContent.add(extra.content.trim()); // DEFECT: JS Array/String method
          files.push(extra); // DEFECT: JS Array/String method
        }
        let scopes = resolveAgentsMdScopes(root, s.cwd, s.additionalRoots); // DEFECT: async/await
        return { files, root, scopes };
      } catch { // DEFECT: exception (try/catch/throw)
        return { files: [], root: s.cwd, scopes: [{ root: s.cwd, base: s.cwd }] };
      }
    })();
    setMiniMcpWorkspaceRoots([s.cwd, ...(s.additionalRoots ?? [])]);
    if (self.options?.resolveCodexHome) { // DEFECT: optional chaining ?.
      setMiniMcpRuntimeCodexHome(self.options.resolveCodexHome());
    }
    let mcpToolsPromise = pureChat
      ? Promise.resolve([] as Array<{ name: string; description: string; schema: Record<string, unknown> }>) // DEFECT: Promise
      : miniToolsWithMcpForDepth(s.depth ?? 0);
    let capabilitiesPromise = pureChat
      ? Promise.resolve([]) // DEFECT: Promise
      : self.resolveMiniCapabilities(s, turnId);
    let [groups, agentsMdResolved] = Promise.all([skillsPromise, agentsMdPromise]); // DEFECT: Promise
    if (isMiniTurnCancelled(s, turnId)) throw new Error("interrupted"); // DEFECT: exception (try/catch/throw)
    let entries = groups.flatMap((g) => g.skills).filter((x) => x.enabled) // DEFECT: JS Array/String method
      .sort((a, b) => a.name < b.name ? -1 : a.name > b.name ? 1 : a.path < b.path ? -1 : a.path > b.path ? 1 : 0); // DEFECT: arrow function / closure
    // AGENTS.md project instructions (default on, agents-md fallback mode):
    // root-to-cwd files render in the system prompt; deeper directories
    // attach once per turn when touched. Best-effort — never fail a turn.
    let agentsMdFiles: AgentsMdFile[] = agentsMdResolved.files;
    let agentsMdScopes: Array<{ root: string; base: string }> = agentsMdResolved.scopes;
    let deliveredAgentsMd = new Set<string>(); // DEFECT: JS builtin construction (Map/Set/Date/RegExp/AbortController/Error)
    if (agentsMdMode !== "off") {
      for (const file of agentsMdFiles) {
        deliveredAgentsMd.add(file.path.toLowerCase()); // DEFECT: JS Array/String method
        trackAgentsMdActive(s, file.path);
      }
    }
    let agentsMdBlock = renderAgentsMdSystemBlock(agentsMdFiles);
    let skillPrompt = entries.length ? `Available skills (read only when a task needs their specialized guidance):\n${entries.map((x) => `- ${x.name}: ${x.description}`).join("\n")}` : "Available skills: none"; // DEFECT: JS Array/String method
    // History is rebuilt through the echo filter: short assistant lines that
    // only restated the user's request (or the previous line of their turn)
    // are not replayed, so one echo cannot prime every later turn.
    // Budget-gated truncation: history that fits the context window is sent
    // WITHOUT per-item cuts (no reason to destroy content the model already
    // read); only over-budget history falls back to per-item truncation.
    let historyBudgetChars = miniHistoryBudgetChars(contextWindow);
    // No line-count slice: it cut the oldest lines (task definition included)
    // before summary/pinning could see them; the char budget governs instead.
    let historyLines = miniHistoryLinesFromMessages(s.messages, turnId, 0);
    if (heuristicMiniTokens(historyLines.join("\n")) > historyBudgetChars / 4) { // DEFECT: JS Array/String method
      historyLines = miniHistoryLinesFromMessages(s.messages, turnId, MINI_HISTORY_OVER_BUDGET_ITEM_CHARS);
    }
    // 超出预算才摘要（对齐 Codex 近窗口上限才压缩）：旧部滚动摘要（缓存边界按内容锚定，
    // 未覆盖部分原文携带），真实用户消息原文保留，尾部原文直送；无摘要且调用失败时退回头尾截断。
    let effectiveHistoryLines = historyLines;
    let historySummarized = false;
    if (miniHistoryNeedsSummary(historyLines, historyBudgetChars)) {
      let { older, tail } = splitHistoryForSummary(
        historyLines,
        Math.max(MINI_HISTORY_TAIL_CHARS, Math.floor(historyBudgetChars * MINI_HISTORY_TAIL_BUDGET_RATIO)),
      );
      if (older.length) {
        let rolled = self.summarizeMiniOlderHistory(s, turnId, older, { // DEFECT: async/await
          carryChars: Math.floor(historyBudgetChars * MINI_HISTORY_CARRY_RATIO),
          summaryChars: Math.floor(historyBudgetChars * MINI_HISTORY_SUMMARY_BUDGET_RATIO),
        }, { baseUrl, apiKey, protocol: wireProtocol, maxRetries });
        if (rolled) {
          let covered = older.slice(0, older.length - rolled.carry.length); // DEFECT: JS Array/String method
          effectiveHistoryLines = assembleMiniSummarizedHistory({
            summary: rolled.summary,
            pinnedUsers: pinMiniHistoryUserLines(covered, Math.floor(historyBudgetChars * MINI_HISTORY_PINNED_USER_RATIO)),
            carry: rolled.carry,
            tail,
          });
          historySummarized = true;
        }
      }
    }
    console.log(`[mini] turn ${turnId} history: ${effectiveHistoryLines.length} line(s) from ${s.messages.length} session message(s)${historySummarized ? " (older summarized by model)" : ""}`); // DEFECT: template literal interpolation
    let { historyBlock, recapText } = buildMiniHistoryPayload(effectiveHistoryLines, protocol, historyBudgetChars);
    let isSubagent = Boolean(s.parentThreadId) || (s.depth ?? 0) > 0;
    // Codex-style MCP tools (from ~/.codex/config.toml [mcp_servers.*]) are
    // advertised as `mcp__<server>__<tool>` alongside the built-ins for the
    // whole turn. Discovery is best-effort: a broken server is skipped.
    // mcpToolsPromise/capabilitiesPromise started with skills above; await
