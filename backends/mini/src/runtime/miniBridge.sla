                let rc: i32 = mb_s_node(res, STR_PTR("agents"), STR_LEN("agents"), snapshot);
                rc = mb_s_bool(res, STR_PTR("timedOut"), STR_LEN("timedOut"), true);
                let ok_s: bool = mb_stringify_node(res, out);
                return;
            };
            let watch: u64 = mb_new_arr();
