                let ok_es: bool = mb_g_str(entry, STR_PTR("status"), STR_LEN("status"), &estatus);
                if mb_bytes_eq(mb_sp(&estatus), estatus.len, STR_PTR("running"), STR_LEN("running")) { all_done = false; };
