                            if mb_g_str(snap, STR_PTR("preview"), STR_LEN("preview"), &v) { rc = mb_s_str(e, STR_PTR("preview"), STR_LEN("preview"), mb_sp(&v), v.len); } else { rc = mb_s_null(e, STR_PTR("preview"), STR_LEN("preview")); };
                            rc = mb_s_str(e, STR_PTR("status"), STR_LEN("status"), STR_PTR("idle"), STR_LEN("idle"));
