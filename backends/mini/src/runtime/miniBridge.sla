// File-mutating or code-executing sa_vm actions, blocked under read-only sandbox. */
fn isMiniWriteAction(action: JsonValue) -> bool { // was: function isMiniWriteAction
  return typeof action === "string" && MINI_PLAN_WRITE_ACTIONS.has(action.trim().toLowerCase()); // DEFECT: runtime type test (typeof/instanceof/in)
}

// Normalize thread sandbox/approval strings (Codex `sandbox` / `approvalPolicy` contract). */
fn normalizeMiniSandbox(v: JsonValue) -> string  { // was: function normalizeMiniSandbox
