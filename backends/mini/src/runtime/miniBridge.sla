      if (exec.stdout.length < exec.cap) exec.stdout = (exec.stdout + text).slice(0, exec.cap); // DEFECT: JS Array/String method
    } else if (exec.stderr.length < exec.cap) {
      exec.stderr = (exec.stderr + text).slice(0, exec.cap); // DEFECT: JS Array/String method
    }
  }

