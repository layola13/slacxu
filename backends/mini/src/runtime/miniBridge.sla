      self.notifyMiniChild(child.threadId);
      return JSON.stringify({ agent_id: child.threadId, previous_status: prev, report }); // DEFECT: dynamic JSON (JSON.parse/stringify)
    }
    if (name === "resume_agent") {
      let target = typeof a.target === "string" ? a.target : typeof a.id === "string" ? a.id : ""; // DEFECT: runtime type test (typeof/instanceof/in)
      let t = target.trim(); // DEFECT: JS Array/String method
      if (!t) return `resume_agent needs a target agent_id (a child previously closed by close_agent).`;
      // Live and never closed: report status like upstream (reopen is a no-op).
      for (const child of self.sessions.values()) {
        if (child.parentThreadId !== s.threadId || !self.miniChildOwnerVisible(s, child.ownerId)) continue;
        if ((child.threadId === t || child.taskName === t) && child.closed !== true) {
