          }
          // Inline delivery (OpenCode task.ts inject parity): the parent sees
          // the report in this tool result, so no extra read_agent_report
          // round is needed. Mark it delivered so the round-loop inbox drain
          // does not repeat it.
          let report = full.slice(0, MINI_AGENT_INBOX_REPORT_CHARS); // DEFECT: JS Array/String method
          try { // DEFECT: exception (try/catch/throw)
            s.deliveredAgentReports ??= [];
            let key = miniAgentInboxKey(child.threadId, status);
            if (!s.deliveredAgentReports.includes(key)) s.deliveredAgentReports.push(key); // DEFECT: JS Array/String method
          } catch { /* delivery bookkeeping is best-effort */ } // DEFECT: exception (try/catch/throw)
          return {
            agent_id: child.threadId,
            status,
            has_report: true,
            report,
          };
        });
      for (;;) {
        let snapshot = snapshotWithReports();
        let allDone = snapshot.every((r) => r.status !== "running"); // DEFECT: JS Array/String method
        if (allDone) { try { self.persist(s); } catch { /* ignore */ } return JSON.stringify({ agents: snapshot, timedOut: false }); } // DEFECT: exception (try/catch/throw)
        let remaining = deadline - Date.now();
        if (remaining <= 0) {
          return JSON.stringify({ agents: snapshot, timedOut: true }); // DEFECT: dynamic JSON (JSON.parse/stringify)
        }
        // Event-driven: wake on child state change (start/finish/queue/
        // interrupt/close) instead of 150ms busy polling. Watch the resolved
        // child thread ids so close_agent (session deleted) still wakes us.
        let watchIds: string[] = [];
        for (const id of ids) {
          let child = self.miniFindChild(s, id) ?? self.sessions.get(id);
          watchIds.push(child?.threadId ?? id); // DEFECT: optional chaining ?.
        }
        self.waitForMiniChildNotify(watchIds, Math.min(remaining, 30000)); // DEFECT: async/await
      }
    }
    if (name === "close_agent") {
      let target = typeof a.target === "string" ? a.target : typeof a.id === "string" ? a.id : ""; // DEFECT: runtime type test (typeof/instanceof/in)
      let child = self.miniFindChild(s, target);
      if (!child) return `close_agent: unknown sub-agent '${String(target ?? "").slice(0, 80)}'.`; // DEFECT: JS Array/String method
      let prev = self.miniChildStatus(child);
      self.cancelQueuedMiniChildTurn(child);
      let report = (child.finalReport ?? "").slice(0, 2000); // DEFECT: JS Array/String method
      if (child.activeTurnId) {
        child.cancelledTurnIds ??= new Set<string>(); // DEFECT: JS builtin construction (Map/Set/Date/RegExp/AbortController/Error)
        child.cancelledTurnIds.add(child.activeTurnId);
      }
      try { child.aborted = true; child.activeAbort?.abort(); } catch { /* ignore */ } // DEFECT: optional chaining ?.
      child.activeTurnId = undefined;
      child.activeAbort = undefined;
      // Upstream parity: closing releases residency but retains the rollout so
