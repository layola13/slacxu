fn requiresAnthropicAdaptiveThinking(model: TextBuf) -> bool { // was: function requiresAnthropicAdaptiveThinking
  let normalized = String(model ?? "").trim().toLowerCase().replace(/[._\s]+/g, "-"); // DEFECT: JS Array/String method
  if (/claude-(opus|sonnet|haiku)-5/i.test(normalized)) return true;
  return /claude-.*5-5/i.test(normalized);
}

//
