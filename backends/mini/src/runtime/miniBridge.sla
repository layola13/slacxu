        let ok: bool = mb_n_str(mb_a_at(lines, i), &line);
        i = i + 1;
        let t = MbStr { bytes: [0u8; 8192], len: 0 };
        mb_trim_to(mb_sp(&line), line.len, &t);
        if t.len > 0 { mb_sassign_s2(&last, &t); found = true; };
    }
    mb_free_doc(lines);
    if !found { return false; };
    return mb_re_test(mb_sp(&last), last.len, STR_PTR("^[ \t>*_`#-]*[*_`]{0,2}(DONE|完成)[*_`]{0,2}[ \t]*[:：]"), STR_LEN("^[ \t>*_`#-]*[*_`]{0,2}(DONE|完成)[*_`]{0,2}[ \t]*[:：]"), true);
}
fn wrapMiniCurrentTask(prompt_p: ptr, prompt_n: u64, has_history: bool, out: &MbJson) -> void {
    formatMiniLiveTurnPrompt(prompt_p, prompt_n, has_history, out);
}

// ---- B5a: history text, plan family, echo gate, inbox (TS:3183-3790) ----
fn mb_str_of_node(node: u64, out: &MbJson) -> void {
    // String(node ?? "") coercion for the string-typed fields of this zone.
    out.len = 0;
    if node == 0 || mb_kind(node) == MB_JK_NULL { return; };
    if mb_kind(node) == MB_JK_STRING { let ok: bool = mb_n_str_j(node, out); return; };
    if mb_kind(node) == MB_JK_OBJECT { mb_jappend(out, STR_PTR("[object Object]"), STR_LEN("[object Object]")); return; };
    mb_json_scalar_text(node, out);
}
fn mb_field_text(rec: u64, kp: ptr, kn: u64, out: &MbJson) -> void {
    out.len = 0;
    if rec == 0 { return; };
    mb_str_of_node(mb_g_node(rec, kp, kn), out);
}
fn mb_cut(v_p: ptr, v_n: u64, cap: i64, out: &MbJson) -> void {
    out.len = 0;
    if cap > 0 && v_n > cap as u64 { mb_jappend(out, v_p, cap as u64); return; };
    mb_jappend(out, v_p, v_n);
}
fn mb_polluting_error_re_test(p: ptr, n: u64) -> bool {
    return mb_re_test(p, n, STR_PTR("stream connection failed|responses_retry|error sending request|didn't complete gracefully|waiting to retry|retry_delay|connection failed|chat[ \t\n\r]+[0-9]{3}[ \t\n\r]*:|responses[ \t\n\r]+[0-9]{3}[ \t\n\r]*:|relay unavailable|empty response|Mini request failed|免费额度已用完|上游限流|中转暂不可用|历史未被污染"), STR_LEN("stream connection failed|responses_retry|error sending request|didn't complete gracefully|waiting to retry|retry_delay|connection failed|chat[ \t\n\r]+[0-9]{3}[ \t\n\r]*:|responses[ \t\n\r]+[0-9]{3}[ \t\n\r]*:|relay unavailable|empty response|Mini request failed|免费额度已用完|上游限流|中转暂不可用|历史未被污染"), true);
}
fn historyItemToText(m: u64, per_item_cap: i64, out: &MbJson) -> void {
    out.len = 0;
    if m == 0 || mb_kind(m) != MB_JK_OBJECT { return; };
    let t = MbJson { bytes: [0u8; 262144], len: 0 };
    mb_field_text(m, STR_PTR("type"), STR_LEN("type"), &t);
    if mb_j_eq(&t, STR_PTR("error"), STR_LEN("error")) || mb_j_eq(&t, STR_PTR("retryError"), STR_LEN("retryError")) || mb_j_eq(&t, STR_PTR("retryErrorGroup"), STR_LEN("retryErrorGroup")) { return; };
    let status = MbJson { bytes: [0u8; 262144], len: 0 };
    mb_field_text(m, STR_PTR("status"), STR_LEN("status"), &status);
    let status_l = MbStr { bytes: [0u8; 8192], len: 0 };
    mb_lower_into(mb_jp(&status), status.len, &status_l);
    if mb_s_eq(&status_l, STR_PTR("failed"), STR_LEN("failed")) || mb_s_eq(&status_l, STR_PTR("error"), STR_LEN("error")) || mb_s_eq(&status_l, STR_PTR("interrupted"), STR_LEN("interrupted")) { return; };
    if mb_j_eq(&t, STR_PTR("userMessage"), STR_LEN("userMessage")) {
        let body = MbJson { bytes: [0u8; 262144], len: 0 };
        mb_field_text(m, STR_PTR("text"), STR_LEN("text"), &body);
        let cut = MbJson { bytes: [0u8; 262144], len: 0 };
        mb_cut(mb_jp(&body), body.len, per_item_cap, &cut);
        mb_jappend(out, STR_PTR("user: "), STR_LEN("user: "));
        mb_jappend(out, mb_jp(&cut), cut.len);
        return;
    };
    if mb_j_eq(&t, STR_PTR("goalContinuation"), STR_LEN("goalContinuation")) {
        let body = MbJson { bytes: [0u8; 262144], len: 0 };
        mb_field_text(m, STR_PTR("text"), STR_LEN("text"), &body);
        let bt = MbStr { bytes: [0u8; 8192], len: 0 };
        mb_trim_to(mb_jp(&body), body.len, &bt);
        if bt.len == 0 { return; };
        let cut = MbJson { bytes: [0u8; 262144], len: 0 };
        mb_cut(mb_jp(&body), body.len, per_item_cap, &cut);
        mb_jappend(out, STR_PTR("goal-continuation: "), STR_LEN("goal-continuation: "));
        mb_jappend(out, mb_jp(&cut), cut.len);
        return;
    };
    if mb_j_eq(&t, STR_PTR("agentMessage"), STR_LEN("agentMessage")) {
        let body = MbJson { bytes: [0u8; 262144], len: 0 };
        mb_field_text(m, STR_PTR("text"), STR_LEN("text"), &body);
        let cut = MbJson { bytes: [0u8; 262144], len: 0 };
        mb_cut(mb_jp(&body), body.len, per_item_cap, &cut);
        let text = MbJson { bytes: [0u8; 262144], len: 0 };
        mb_jappend(&text, STR_PTR("assistant: "), STR_LEN("assistant: "));
        mb_jappend(&text, mb_jp(&cut), cut.len);
        if mb_polluting_error_re_test(mb_jp(&text), text.len) { return; };
        mb_jassign_j(out, &text);
        return;
    };
    if mb_j_eq(&t, STR_PTR("toolCall"), STR_LEN("toolCall")) {
        let name = MbJson { bytes: [0u8; 262144], len: 0 };
        mb_field_text(m, STR_PTR("name"), STR_LEN("name"), &name);
        let args = MbJson { bytes: [0u8; 262144], len: 0 };
        mb_field_text(m, STR_PTR("arguments"), STR_LEN("arguments"), &args);
        let output = MbJson { bytes: [0u8; 262144], len: 0 };
        mb_field_text(m, STR_PTR("output"), STR_LEN("output"), &output);
        mb_jappend(out, STR_PTR("tool "), STR_LEN("tool "));
        mb_jappend(out, mb_jp(&name), name.len);
        mb_jappend(out, STR_PTR(" "), STR_LEN(" "));
        let cut_args = MbJson { bytes: [0u8; 262144], len: 0 };
        mb_cut(mb_jp(&args), args.len, 300, &cut_args);
        mb_jappend(out, mb_jp(&cut_args), cut_args.len);
        mb_jappend(out, STR_PTR(" => "), STR_LEN(" => "));
        let cut_out = MbJson { bytes: [0u8; 262144], len: 0 };
        mb_cut(mb_jp(&output), output.len, per_item_cap, &cut_out);
        mb_jappend(out, mb_jp(&cut_out), cut_out.len);
        return;
    };
    if mb_j_eq(&t, STR_PTR("imageView"), STR_LEN("imageView")) {
        let pth = MbJson { bytes: [0u8; 262144], len: 0 };
        mb_field_text(m, STR_PTR("path"), STR_LEN("path"), &pth);
        if pth.len > 300 { pth.len = 300; };
        if pth.len == 0 { return; };
        mb_jappend(out, STR_PTR("[viewed image: "), STR_LEN("[viewed image: "));
        mb_jappend(out, mb_jp(&pth), pth.len);
        mb_jappend(out, STR_PTR("]"), STR_LEN("]"));
        return;
    };
    if mb_j_eq(&t, STR_PTR("compaction"), STR_LEN("compaction")) {
        let body = MbJson { bytes: [0u8; 262144], len: 0 };
        mb_field_text(m, STR_PTR("text"), STR_LEN("text"), &body);
        mb_jappend(out, STR_PTR("[compaction: "), STR_LEN("[compaction: "));
        mb_jappend(out, mb_jp(&body), body.len);
        mb_jappend(out, STR_PTR("]"), STR_LEN("]"));
        return;
    };
    if mb_j_eq(&t, STR_PTR("plan"), STR_LEN("plan")) {
        let plan: u64 = mb_g_node(m, STR_PTR("plan"), STR_LEN("plan"));
        if plan == 0 || mb_kind(plan) != MB_JK_ARRAY { return; };
        let lines = MbJson { bytes: [0u8; 262144], len: 0 };
        let count: u64 = mb_n_count(plan);
        let i: u64 = 0;
        let kept: u64 = 0;
        while i < count {
            let e: u64 = mb_a_at(plan, i);
            i = i + 1;
            let st = MbJson { bytes: [0u8; 262144], len: 0 };
            if e != 0 { mb_field_text(e, STR_PTR("status"), STR_LEN("status"), &st); };
            let step = MbJson { bytes: [0u8; 262144], len: 0 };
            if e != 0 {
                mb_field_text(e, STR_PTR("step"), STR_LEN("step"), &step);
                if step.len == 0 { mb_field_text(e, STR_PTR("text"), STR_LEN("text"), &step); };
            };
            let line = MbJson { bytes: [0u8; 262144], len: 0 };
            mb_jappend(&line, STR_PTR("- ["), STR_LEN("- ["));
            if mb_j_eq(&st, STR_PTR("completed"), STR_LEN("completed")) { mb_jappend(&line, STR_PTR("x"), STR_LEN("x")); } else { mb_jappend(&line, STR_PTR(" "), STR_LEN(" ")); };
            mb_jappend(&line, STR_PTR("] "), STR_LEN("] "));
            mb_jappend(&line, mb_jp(&step), step.len);
            let lt = MbStr { bytes: [0u8; 8192], len: 0 };
            mb_trim_to(mb_jp(&line), line.len, &lt);
            if mb_s_eq(&lt, STR_PTR("- [ ]"), STR_LEN("- [ ]")) { continue; };
            if kept > 0 { mb_jappend(out, STR_PTR("\n"), STR_LEN("\n")); };
            // accumulate into `lines` via out directly (out is empty here)
            mb_jappend(out, mb_jp(&line), line.len);
            kept = kept + 1;
        }
        if kept == 0 { out.len = 0; return; };
        let joined = MbJson { bytes: [0u8; 262144], len: 0 };
        mb_jassign_j(&joined, out);
        out.len = 0;
        mb_jappend(out, STR_PTR("task plan:\n"), STR_LEN("task plan:\n"));
        if per_item_cap > 0 {
            let cap: u64 = 1200;
            if (per_item_cap as u64) < cap { cap = per_item_cap as u64; };
            mb_jappend(out, mb_jp(&joined), mb_min_u64(joined.len, cap));
        } else {
            mb_jappend(out, mb_jp(&joined), joined.len);
        };
        return;
    };
}
fn mb_min_u64(a: u64, b: u64) -> u64 { if a < b { return a; }; return b; }
// ---- stored images + compact content (TS:3256-3366) ----
fn miniStoredImages(message: u64, out: &u64) -> void {
    let arr: u64 = mb_new_arr();
    *out = arr;
    if message == 0 || mb_kind(message) != MB_JK_OBJECT { return; };
    let content: u64 = mb_g_node(message, STR_PTR("content"), STR_LEN("content"));
    if content == 0 || mb_kind(content) != MB_JK_ARRAY { return; };
    let seen: u64 = mb_new_arr();
    let count: u64 = mb_n_count(content);
    let i: u64 = 0;
    while i < count {
        let block: u64 = mb_a_at(content, i);
        i = i + 1;
        if block == 0 || mb_kind(block) != MB_JK_OBJECT { continue; };
        let ty = MbJson { bytes: [0u8; 262144], len: 0 };
        mb_field_text(block, STR_PTR("type"), STR_LEN("type"), &ty);
        let tyl = MbStr { bytes: [0u8; 8192], len: 0 };
        mb_lower_into(mb_jp(&ty), ty.len, &tyl);
        if !mb_s_eq(&tyl, STR_PTR("image"), STR_LEN("image")) && !mb_s_eq(&tyl, STR_PTR("input_image"), STR_LEN("input_image")) && !mb_s_eq(&tyl, STR_PTR("image_url"), STR_LEN("image_url")) && !mb_s_eq(&tyl, STR_PTR("inputimage"), STR_LEN("inputimage")) { continue; };
        let url = MbJson { bytes: [0u8; 262144], len: 0 };
        let url_node: u64 = mb_g_node(block, STR_PTR("url"), STR_LEN("url"));
        if url_node != 0 && mb_kind(url_node) == MB_JK_STRING { let ok: bool = mb_n_str_j(url_node, &url); } else {
            let iu: u64 = mb_g_node(block, STR_PTR("image_url"), STR_LEN("image_url"));
            if iu != 0 && mb_kind(iu) == MB_JK_STRING { let ok: bool = mb_n_str_j(iu, &url); } else if iu != 0 && mb_kind(iu) == MB_JK_OBJECT { mb_field_text(iu, STR_PTR("url"), STR_LEN("url"), &url); };
        };
        if url.len == 0 || mb_str_in_arr(seen, mb_jp(&url), url.len, false) { continue; };
        let rc: i32 = mb_a_push_str(seen, mb_jp(&url), url.len);
        let entry: u64 = mb_new_obj();
        rc = mb_s_str(entry, STR_PTR("url"), STR_LEN("url"), mb_jp(&url), url.len);
        let detail_node: u64 = mb_g_node(block, STR_PTR("detail"), STR_LEN("detail"));
        if detail_node != 0 && mb_kind(detail_node) == MB_JK_STRING {
            let d = MbStr { bytes: [0u8; 8192], len: 0 };
            let ok: bool = mb_n_str(detail_node, &d);
            rc = mb_s_str(entry, STR_PTR("detail"), STR_LEN("detail"), mb_sp(&d), d.len);
        };
        rc = mb_a_push_node(arr, entry);
    }
    mb_free_doc(seen);
}
fn miniHistoricalImageMessage(message: u64, protocol_p: ptr, protocol_n: u64, out: &u64, out_is_null: &bool) -> void {
    *out = 0;
    *out_is_null = true;
    if message == 0 || mb_kind(message) != MB_JK_OBJECT { return; };
    let ty = MbJson { bytes: [0u8; 262144], len: 0 };
    mb_field_text(message, STR_PTR("type"), STR_LEN("type"), &ty);
    if !mb_j_eq(&ty, STR_PTR("userMessage"), STR_LEN("userMessage")) { return; };
    let images: u64 = 0;
    miniStoredImages(message, &images);
    if mb_n_count(images) == 0 { mb_free_doc(images); return; };
    let is_resp: bool = mb_bytes_eq(protocol_p, protocol_n, STR_PTR("responses"), STR_LEN("responses"));
    let content: u64 = mb_new_arr();
    let count: u64 = mb_n_count(images);
    let i: u64 = 0;
    while i < count {
        let img: u64 = mb_a_at(images, i);
        i = i + 1;
        let url = MbStr { bytes: [0u8; 8192], len: 0 };
        let ok: bool = mb_g_str(img, STR_PTR("url"), STR_LEN("url"), &url);
        let detail = MbStr { bytes: [0u8; 8192], len: 0 };
        let has_detail: bool = mb_g_str(img, STR_PTR("detail"), STR_LEN("detail"), &detail);
        let part: u64 = mb_new_obj();
        if !is_resp {
            let rc: i32 = mb_s_str(part, STR_PTR("type"), STR_LEN("type"), STR_PTR("image_url"), STR_LEN("image_url"));
            let iu: u64 = mb_new_obj();
            rc = mb_s_str(iu, STR_PTR("url"), STR_LEN("url"), mb_sp(&url), url.len);
            if has_detail { rc = mb_s_str(iu, STR_PTR("detail"), STR_LEN("detail"), mb_sp(&detail), detail.len); };
            rc = mb_s_node(part, STR_PTR("image_url"), STR_LEN("image_url"), iu);
        } else {
            let rc: i32 = mb_s_str(part, STR_PTR("type"), STR_LEN("type"), STR_PTR("input_image"), STR_LEN("input_image"));
            rc = mb_s_str(part, STR_PTR("image_url"), STR_LEN("image_url"), mb_sp(&url), url.len);
            if has_detail { rc = mb_s_str(part, STR_PTR("detail"), STR_LEN("detail"), mb_sp(&detail), detail.len); } else { rc = mb_s_str(part, STR_PTR("detail"), STR_LEN("detail"), STR_PTR("auto"), STR_LEN("auto")); };
        };
        let rc: i32 = mb_a_push_node(content, part);
    }
    mb_free_doc(images);
    let msg: u64 = mb_new_obj();
    let rc: i32 = mb_s_str(msg, STR_PTR("role"), STR_LEN("role"), STR_PTR("user"), STR_LEN("user"));
    rc = mb_s_node(msg, STR_PTR("content"), STR_LEN("content"), content);
    *out = msg;
    *out_is_null = false;
}
fn buildMiniHistoricalImageContent(messages: u64, protocol_p: ptr, protocol_n: u64, out: &u64) -> void {
    let content: u64 = mb_new_arr();
    *out = content;
    let seen: u64 = mb_new_arr();
    let is_resp: bool = mb_bytes_eq(protocol_p, protocol_n, STR_PTR("responses"), STR_LEN("responses"));
    let count: u64 = 0;
    if messages != 0 && mb_kind(messages) == MB_JK_ARRAY { count = mb_n_count(messages); };
    let i: u64 = 0;
    while i < count {
        let images: u64 = 0;
        miniStoredImages(mb_a_at(messages, i), &images);
        i = i + 1;
        let ic: u64 = mb_n_count(images);
        let j: u64 = 0;
        while j < ic {
            let img: u64 = mb_a_at(images, j);
            j = j + 1;
            let url = MbStr { bytes: [0u8; 8192], len: 0 };
            let ok: bool = mb_g_str(img, STR_PTR("url"), STR_LEN("url"), &url);
            if mb_str_in_arr(seen, mb_sp(&url), url.len, false) { continue; };
            let rc: i32 = mb_a_push_str(seen, mb_sp(&url), url.len);
            let detail = MbStr { bytes: [0u8; 8192], len: 0 };
            let has_detail: bool = mb_g_str(img, STR_PTR("detail"), STR_LEN("detail"), &detail);
            let part: u64 = mb_new_obj();
            if is_resp {
                rc = mb_s_str(part, STR_PTR("type"), STR_LEN("type"), STR_PTR("input_image"), STR_LEN("input_image"));
                rc = mb_s_str(part, STR_PTR("image_url"), STR_LEN("image_url"), mb_sp(&url), url.len);
                if has_detail { rc = mb_s_str(part, STR_PTR("detail"), STR_LEN("detail"), mb_sp(&detail), detail.len); } else { rc = mb_s_str(part, STR_PTR("detail"), STR_LEN("detail"), STR_PTR("auto"), STR_LEN("auto")); };
            } else {
                rc = mb_s_str(part, STR_PTR("type"), STR_LEN("type"), STR_PTR("image_url"), STR_LEN("image_url"));
                let iu: u64 = mb_new_obj();
                rc = mb_s_str(iu, STR_PTR("url"), STR_LEN("url"), mb_sp(&url), url.len);
                if has_detail { rc = mb_s_str(iu, STR_PTR("detail"), STR_LEN("detail"), mb_sp(&detail), detail.len); };
                rc = mb_s_node(part, STR_PTR("image_url"), STR_LEN("image_url"), iu);
            };
            rc = mb_a_push_node(content, part);
        }
        mb_free_doc(images);
    }
    mb_free_doc(seen);
}
fn buildMiniCompactContent(messages: u64, protocol_p: ptr, protocol_n: u64, limit: u64, include_images: bool, out: &u64) -> void {
    let content: u64 = mb_new_arr();
    *out = content;
    let is_resp: bool = mb_bytes_eq(protocol_p, protocol_n, STR_PTR("responses"), STR_LEN("responses"));
    let transcript = MbJson { bytes: [0u8; 262144], len: 0 };
    buildMiniCompactTranscript(messages, limit, &transcript);
    if transcript.len > 0 {
        let part: u64 = mb_new_obj();
        let rc: i32 = mb_s_str(part, STR_PTR("type"), STR_LEN("type"), STR_PTR("input_text"), STR_LEN("input_text"));
        if !is_resp { rc = mb_s_str(part, STR_PTR("type"), STR_LEN("type"), STR_PTR("text"), STR_LEN("text")); };
        rc = mb_s_str(part, STR_PTR("text"), STR_LEN("text"), mb_jp(&transcript), transcript.len);
        rc = mb_a_push_node(content, part);
    };
    let anchors = MbJson { bytes: [0u8; 262144], len: 0 };
    buildMiniCompactionAnchors(messages, 32000, &anchors);
    if anchors.len > 0 {
        let part: u64 = mb_new_obj();
        let rc: i32 = mb_s_str(part, STR_PTR("type"), STR_LEN("type"), STR_PTR("input_text"), STR_LEN("input_text"));
        if !is_resp { rc = mb_s_str(part, STR_PTR("type"), STR_LEN("type"), STR_PTR("text"), STR_LEN("text")); };
        let text = MbJson { bytes: [0u8; 262144], len: 0 };
        mb_jappend(&text, STR_PTR("[durable conversation anchors]\n"), STR_LEN("[durable conversation anchors]\n"));
        mb_jappend(&text, mb_jp(&anchors), anchors.len);
        rc = mb_s_str(part, STR_PTR("text"), STR_LEN("text"), mb_jp(&text), text.len);
        rc = mb_a_push_node(content, part);
    };
    if include_images {
        let imgs: u64 = 0;
        buildMiniHistoricalImageContent(messages, protocol_p, protocol_n, &imgs);
        let ic: u64 = mb_n_count(imgs);
        let j: u64 = 0;
        while j < ic { let rc: i32 = mb_a_push_node(content, mb_clone_node(mb_a_at(imgs, j))); j = j + 1; }
        mb_free_doc(imgs);
    };
}
fn isMiniImageUnsupportedError(msg_p: ptr, msg_n: u64) -> bool {
    return mb_re_test(msg_p, msg_n, STR_PTR("does not support image|does not support images|not support image|image(_url|s)?[^
]{0,60}(not supported|unsupported|forbidden|not allowed)|unsupported (image|input type|content (type|part))[^
]{0,80}image|cannot read [\"'“]?image|vision( input)? (is )?not supported|text[- ]only model|模型?不(支持|接受)图(片|像)|仅支持文本"), STR_LEN("does not support image|does not support images|not support image|image(_url|s)?[^
]{0,60}(not supported|unsupported|forbidden|not allowed)|unsupported (image|input type|content (type|part))[^
]{0,80}image|cannot read [\"'“]?image|vision( input)? (is )?not supported|text[- ]only model|模型?不(支持|接受)图(片|像)|仅支持文本"), true);
}
fn isMiniImageContentBlock(block: u64) -> bool {
    if block == 0 || mb_kind(block) != MB_JK_OBJECT { return false; };
    let ty = MbJson { bytes: [0u8; 262144], len: 0 };
    mb_field_text(block, STR_PTR("type"), STR_LEN("type"), &ty);
    let tyl = MbStr { bytes: [0u8; 8192], len: 0 };
    mb_lower_into(mb_jp(&ty), ty.len, &tyl);
    return mb_s_eq(&tyl, STR_PTR("image"), STR_LEN("image")) || mb_s_eq(&tyl, STR_PTR("image_url"), STR_LEN("image_url")) || mb_s_eq(&tyl, STR_PTR("input_image"), STR_LEN("input_image")) || mb_s_eq(&tyl, STR_PTR("inputimage"), STR_LEN("inputimage"));
}
fn stripMiniThreadImages(thread: &u64, out_removed: &u64) -> void {
    // SLA form: the array handle is updated in place (&u64) because the
    // sa_json surface has no array-remove; splices rebuild the array doc.
    let removed_total: u64 = 0;
    *out_removed = 0;
    if *thread == 0 || mb_kind(*thread) != MB_JK_ARRAY { return; };
    let idx: u64 = mb_n_count(*thread);
    while idx > 0 {
        idx = idx - 1;
        let entry: u64 = mb_a_at(*thread, idx);
        if entry == 0 || mb_kind(entry) != MB_JK_OBJECT { continue; };
        let content: u64 = mb_g_node(entry, STR_PTR("content"), STR_LEN("content"));
        if content == 0 || mb_kind(content) != MB_JK_ARRAY { continue; };
        let kept: u64 = mb_new_arr();
        let cc: u64 = mb_n_count(content);
        let ci: u64 = 0;
        let dropped: u64 = 0;
        while ci < cc {
            let block: u64 = mb_a_at(content, ci);
            ci = ci + 1;
            if isMiniImageContentBlock(block) { dropped = dropped + 1; } else { let rc: i32 = mb_a_push_node(kept, mb_clone_node(block)); };
        }
        if dropped == 0 { mb_free_doc(kept); continue; };
        removed_total = removed_total + dropped;
        let rc: i32 = mb_s_node(entry, STR_PTR("content"), STR_LEN("content"), kept);
        if mb_n_count(kept) == 0 {
            let role = MbStr { bytes: [0u8; 8192], len: 0 };
            let has_role: bool = mb_g_str(entry, STR_PTR("role"), STR_LEN("role"), &role);
            let calls: u64 = mb_g_node(entry, STR_PTR("tool_calls"), STR_LEN("tool_calls"));
            let has_calls: bool = calls != 0 && mb_kind(calls) == MB_JK_ARRAY;
            if !mb_s_eq(&role, STR_PTR("assistant"), STR_LEN("assistant")) && !has_calls {
                mb_arr_remove_at(thread, idx);
            };
        };
    }
    *out_removed = removed_total;
}
fn mb_arr_remove_at(arr: &u64, idx: u64) -> void {
    let next: u64 = mb_new_arr();
    let count: u64 = mb_n_count(*arr);
    let i: u64 = 0;
    while i < count {
        if i != idx { let rc: i32 = mb_a_push_node(next, mb_clone_node(mb_a_at(*arr, i))); };
        i = i + 1;
    }
    mb_free_doc(*arr);
    *arr = next;
}

// ---- plan family (TS:3395-3520) ----
fn normalizeMiniPlanStatus(v: u64, out: &MbStr) -> void {
    out.len = 0;
    if v != 0 && mb_kind(v) == MB_JK_STRING {
        let raw = MbStr { bytes: [0u8; 8192], len: 0 };
        let ok: bool = mb_n_str(v, &raw);
        // s.replace(/[_-]+/g, "").toLowerCase()
        let squashed = MbStr { bytes: [0u8; 8192], len: 0 };
        let i: u64 = 0;
        while i < raw.len {
            let b: u8 = raw.bytes[i];
            i = i + 1;
            if b == 95 || b == 45 { continue; };
            mb_spush(&squashed, mb_lower_byte(b));
        }
        if mb_s_eq(&squashed, STR_PTR("completed"), STR_LEN("completed")) || mb_s_eq(&squashed, STR_PTR("complete"), STR_LEN("complete")) || mb_s_eq(&squashed, STR_PTR("done"), STR_LEN("done")) { mb_sassign(out, STR_PTR("completed"), STR_LEN("completed")); return; };
        if mb_s_eq(&squashed, STR_PTR("inprogress"), STR_LEN("inprogress")) || mb_s_eq(&squashed, STR_PTR("running"), STR_LEN("running")) || mb_s_eq(&squashed, STR_PTR("started"), STR_LEN("started")) { mb_sassign(out, STR_PTR("in_progress"), STR_LEN("in_progress")); return; };
    };
    mb_sassign(out, STR_PTR("pending"), STR_LEN("pending"));
}
fn extractMiniPlanSteps(args: u64, out: &u64, out_is_null: &bool) -> void {
    *out = 0;
    *out_is_null = true;
    if args == 0 { return; };
    let raw: u64 = mb_g_node(args, STR_PTR("todos"), STR_LEN("todos"));
    if raw == 0 || mb_kind(raw) != MB_JK_ARRAY { raw = mb_g_node(args, STR_PTR("steps"), STR_LEN("steps")); };
    if raw == 0 || mb_kind(raw) != MB_JK_ARRAY { return; };
    let steps: u64 = mb_new_arr();
    let count: u64 = mb_n_count(raw);
    let i: u64 = 0;
    while i < count {
        let e: u64 = mb_a_at(raw, i);
        i = i + 1;
        if e == 0 || mb_kind(e) != MB_JK_OBJECT { continue; };
        let step = MbStr { bytes: [0u8; 8192], len: 0 };
        let picked: bool = false;
        let keys: [ptr; 3] = [STR_PTR("content"), STR_PTR("step"), STR_PTR("text")];
        let lens: [u64; 3] = [STR_LEN("content"), STR_LEN("step"), STR_LEN("text")];
        let ki: u64 = 0;
        while ki < 3 && !picked {
            let cand = MbStr { bytes: [0u8; 8192], len: 0 };
            let has: bool = mb_g_str(e, keys[ki], lens[ki], &cand);
            ki = ki + 1;
            if has {
                let t = MbStr { bytes: [0u8; 8192], len: 0 };
                mb_trim_to(mb_sp(&cand), cand.len, &t);
                if t.len > 0 { mb_sassign_s2(&step, &cand); picked = true; };
            };
        }
        if !picked { continue; };
        if step.len > 300 { step.len = 300; };
        let status = MbStr { bytes: [0u8; 8192], len: 0 };
        normalizeMiniPlanStatus(mb_g_node(e, STR_PTR("status"), STR_LEN("status")), &status);
        let entry: u64 = mb_new_obj();
        let rc: i32 = mb_s_str(entry, STR_PTR("step"), STR_LEN("step"), mb_sp(&step), step.len);
        rc = mb_s_str(entry, STR_PTR("status"), STR_LEN("status"), mb_sp(&status), status.len);
        rc = mb_a_push_node(steps, entry);
    }
    *out = steps;
    *out_is_null = false;
}
fn validateMiniPlanSteps(steps: u64, out: &MbJson, out_is_null: &bool) -> void {
    out.len = 0;
    *out_is_null = true;
    let active: u64 = 0;
    let count: u64 = 0;
    if steps != 0 && mb_kind(steps) == MB_JK_ARRAY { count = mb_n_count(steps); };
    let i: u64 = 0;
    while i < count {
        let st = MbStr { bytes: [0u8; 8192], len: 0 };
        let e: u64 = mb_a_at(steps, i);
        i = i + 1;
        if e != 0 && mb_g_str(e, STR_PTR("status"), STR_LEN("status"), &st) && mb_s_eq(&st, STR_PTR("in_progress"), STR_LEN("in_progress")) { active = active + 1; };
    }
    if active > 1 {
        mb_jassign(out, STR_PTR("plan update rejected: only one step may be in_progress at a time"), STR_LEN("plan update rejected: only one step may be in_progress at a time"));
        *out_is_null = false;
    };
}
fn formatMiniPlanText(steps: u64, out: &MbJson) -> void {
    out.len = 0;
    let count: u64 = 0;
    if steps != 0 && mb_kind(steps) == MB_JK_ARRAY { count = mb_n_count(steps); };
    let i: u64 = 0;
    while i < count {
        let e: u64 = mb_a_at(steps, i);
        i = i + 1;
        if i > 1 { mb_jappend(out, STR_PTR("\n"), STR_LEN("\n")); };
        let step = MbStr { bytes: [0u8; 8192], len: 0 };
        let status = MbStr { bytes: [0u8; 8192], len: 0 };
        if e != 0 {
            let ok1: bool = mb_g_str(e, STR_PTR("step"), STR_LEN("step"), &step);
            let ok2: bool = mb_g_str(e, STR_PTR("status"), STR_LEN("status"), &status);
        };
        if mb_s_eq(&status, STR_PTR("completed"), STR_LEN("completed")) {
            mb_jappend(out, STR_PTR("- [x] "), STR_LEN("- [x] "));
            mb_jappend_s(out, &step);
        } else if mb_s_eq(&status, STR_PTR("in_progress"), STR_LEN("in_progress")) {
            mb_jappend(out, STR_PTR("- [ ] "), STR_LEN("- [ ] "));
            mb_jappend_s(out, &step);
            mb_jappend(out, STR_PTR(" _(in progress)_"), STR_LEN(" _(in progress)_"));
        } else {
            mb_jappend(out, STR_PTR("- [ ] "), STR_LEN("- [ ] "));
            mb_jappend_s(out, &step);
        };
    }
}
fn miniPlanOverallStatus(steps: u64, out: &MbStr) -> void {
    out.len = 0;
    let count: u64 = 0;
    if steps != 0 && mb_kind(steps) == MB_JK_ARRAY { count = mb_n_count(steps); };
    let any_active: bool = false;
    let all_done: bool = count > 0;
    let i: u64 = 0;
    while i < count {
        let st = MbStr { bytes: [0u8; 8192], len: 0 };
        let e: u64 = mb_a_at(steps, i);
        i = i + 1;
        if e != 0 { let ok: bool = mb_g_str(e, STR_PTR("status"), STR_LEN("status"), &st); };
        if mb_s_eq(&st, STR_PTR("in_progress"), STR_LEN("in_progress")) { any_active = true; };
        if !mb_s_eq(&st, STR_PTR("completed"), STR_LEN("completed")) { all_done = false; };
    }
    if any_active { mb_sassign(out, STR_PTR("inProgress"), STR_LEN("inProgress")); return; };
    if all_done { mb_sassign(out, STR_PTR("completed"), STR_LEN("completed")); return; };
    mb_sassign(out, STR_PTR("pending"), STR_LEN("pending"));
}
fn restoreMiniPlan(messages: u64, out: &u64) -> void {
    let steps_out: u64 = mb_new_arr();
    *out = steps_out;
    if messages == 0 || mb_kind(messages) != MB_JK_ARRAY { return; };
    let idx: u64 = mb_n_count(messages);
    while idx > 0 {
        idx = idx - 1;
        let m: u64 = mb_a_at(messages, idx);
        if m == 0 || mb_kind(m) != MB_JK_OBJECT { continue; };
        let ty = MbJson { bytes: [0u8; 262144], len: 0 };
        mb_field_text(m, STR_PTR("type"), STR_LEN("type"), &ty);
        if !mb_j_eq(&ty, STR_PTR("plan"), STR_LEN("plan")) { continue; };
        let plan: u64 = mb_g_node(m, STR_PTR("plan"), STR_LEN("plan"));
        if plan == 0 || mb_kind(plan) != MB_JK_ARRAY { continue; };
        let count: u64 = mb_n_count(plan);
        let i: u64 = 0;
        while i < count {
            let e: u64 = mb_a_at(plan, i);
            i = i + 1;
            let step = MbStr { bytes: [0u8; 8192], len: 0 };
            let has_step: bool = false;
            if e != 0 && mb_kind(e) == MB_JK_OBJECT {
                has_step = mb_g_str(e, STR_PTR("step"), STR_LEN("step"), &step);
                if !has_step { has_step = mb_g_str(e, STR_PTR("text"), STR_LEN("text"), &step); };
            };
            if !has_step { continue; };
            // TS: `typeof e.step === "string" ? e.step : ...`; String(step) then slice(0,300)
            if step.len > 300 { step.len = 300; };
            let status = MbStr { bytes: [0u8; 8192], len: 0 };
            if e != 0 { normalizeMiniPlanStatus(mb_g_node(e, STR_PTR("status"), STR_LEN("status")), &status); };
            let entry: u64 = mb_new_obj();
            let rc: i32 = mb_s_str(entry, STR_PTR("step"), STR_LEN("step"), mb_sp(&step), step.len);
            rc = mb_s_str(entry, STR_PTR("status"), STR_LEN("status"), mb_sp(&status), status.len);
            rc = mb_a_push_node(steps_out, entry);
        }
        if mb_n_count(steps_out) > 0 { return; };
    }
}
fn carryMiniPlanForward(messages: u64, turn_p: ptr, turn_n: u64, thread_p: ptr, thread_n: u64, out: &u64, out_is_null: &bool) -> void {
    *out = 0;
    *out_is_null = true;
    let all: u64 = 0;
    restoreMiniPlan(messages, &all);
    let pending: u64 = mb_new_arr();
    let count: u64 = mb_n_count(all);
    let i: u64 = 0;
    while i < count {
        let e: u64 = mb_a_at(all, i);
        i = i + 1;
        let st = MbStr { bytes: [0u8; 8192], len: 0 };
        if e != 0 { let ok: bool = mb_g_str(e, STR_PTR("status"), STR_LEN("status"), &st); };
        if !mb_s_eq(&st, STR_PTR("completed"), STR_LEN("completed")) { let rc: i32 = mb_a_push_node(pending, mb_clone_node(e)); };
    }
    mb_free_doc(all);
    if mb_n_count(pending) == 0 { mb_free_doc(pending); return; };
    let item: u64 = mb_new_obj();
    let rc: i32 = mb_s_str(item, STR_PTR("type"), STR_LEN("type"), STR_PTR("plan"), STR_LEN("plan"));
    let id = MbJson { bytes: [0u8; 262144], len: 0 };
    mb_jappend(&id, STR_PTR("mini-plan-"), STR_LEN("mini-plan-"));
    mb_jappend(&id, turn_p, turn_n);
    rc = mb_s_str(item, STR_PTR("id"), STR_LEN("id"), mb_jp(&id), id.len);
    rc = mb_s_str(item, STR_PTR("turnId"), STR_LEN("turnId"), turn_p, turn_n);
    rc = mb_s_str(item, STR_PTR("threadId"), STR_LEN("threadId"), thread_p, thread_n);
    // plan entries carry only {step, status} (already the shape)
    rc = mb_s_node(item, STR_PTR("plan"), STR_LEN("plan"), pending);
    let text = MbJson { bytes: [0u8; 262144], len: 0 };
    formatMiniPlanText(pending, &text);
    rc = mb_s_str(item, STR_PTR("text"), STR_LEN("text"), mb_jp(&text), text.len);
    let status = MbStr { bytes: [0u8; 8192], len: 0 };
    miniPlanOverallStatus(pending, &status);
    rc = mb_s_str(item, STR_PTR("status"), STR_LEN("status"), mb_sp(&status), status.len);
    *out = item;
    *out_is_null = false;
}
const MINI_PLAN_SYNC_RULE: ptr = "When a plan is useful, use update_plan to keep its statuses aligned with verified work. A plan is a guide, not a reason to repeat completed work; if blocked or no longer making progress, say so clearly in the final summary.";
const MINI_PLAN_AWARE_SUMMARY_RULE: ptr = "Use update_plan to track progress when the task is genuinely multi-step, involves multiple files/steps, or when the user asks for a plan; simple single-action tasks should go straight to work. Continue useful unfinished work autonomously, but do not loop merely to clear a stale checklist. Turn safety limits are finite: finish efficiently and report any remaining work honestly.";
const MINI_SILENT_EXEC_RULE: ptr = "Execution style: call tools directly without conversational preambles, acknowledgements, transitions, or restatements of the plan or request. Between tool calls, emit no extra text. When a round calls tools (search, workspace, or any function), emit only the tool calls silently in that round: do not output the final answer, comprehensive tables, or conclusions in the same round. Present all explanation and conclusions in the single final answer of the turn, after all tool results are returned. A failed tool call is simply an error to fix and retry silently.";
const MINI_FINAL_BREVITY_RULE: ptr = "Final-answer brevity is the default: keep this turn's single final answer very concise (no more than ~10 lines) unless the task genuinely needs detail for the user's understanding. Match structure to complexity - a simple factual result needs only a sentence, larger changes get short grouped bullets ordered by importance. Never respond with a greeting when the user provided a technical instruction or question. Do not end with narration of suggested next steps instead of taking action. Be factual with no filler, conversational commentary, or repetition. Reference file paths (workspace-relative, with line numbers) instead of pasting file contents, and never tell the user to save or copy code you already wrote.";
const MINI_EFFICIENCY_RULE: ptr = "Work efficiently with as few tool calls as possible: prefer targeted grep_search/file_outline over broad directory reads; send independent reads/searches as multiple sa_vm tool calls in one round. Avoid redundant reads: never re-read unchanged content without a concrete reason. Different file ranges and queries are distinct reads. Stop as soon as answerable: when the requested information is obtained (e.g. file content, search results), answer directly without further exploration. Git log/status alone is NOT answerable for deep-analysis requests (e.g. 深入分析/detailed review/risk breakdown): pull git diff and the changed files before concluding. Once the relevant code is understood, apply the requested change when permitted and verify it. If more evidence is needed, inspect it; if blocked or no change is needed, answer directly. Never defer required evidence to a next round: phrases like 需下一轮继续/next round are not a valid completion.";
const MINI_LANGUAGE_RULE: ptr = "Language: always write this turn's single final answer in the same language as the ACTIVE user task for this turn (e.g. Chinese task → Simplified Chinese answer unless the user explicitly asks otherwise). Harness runtime status notes and conversation history never set the answer language. Tool parameters, code, file paths and identifiers stay in their original language; only the natural-language explanation follows the ACTIVE task language.";
fn mb_action_mandate_rule(out: &MbJson) -> void {
    out.len = 0;
    mb_jappend(out, STR_PTR("Workspace execution: when the user requests implementation and the current mode permits it, inspect the relevant code, apply focused changes using sa_vm, and verify the result. Verify correctness through execution: run code, tests, or typechecks to confirm expected outputs; evidence before synthesis. Work through the task or plan to completion in this turn, marking items completed only after work and verification are done. Avoid text before/after your response such as \"Here is what I will do next\" or merely suggesting next steps without taking them; only use tools to complete tasks. Remember active user corrections, review feedback, and scope constraints across turns. "), STR_LEN("Workspace execution: when the user requests implementation and the current mode permits it, inspect the relevant code, apply focused changes using sa_vm, and verify the result. Verify correctness through execution: run code, tests, or typechecks to confirm expected outputs; evidence before synthesis. Work through the task or plan to completion in this turn, marking items completed only after work and verification are done. Avoid text before/after your response such as \"Here is what I will do next\" or merely suggesting next steps without taking them; only use tools to complete tasks. Remember active user corrections, review feedback, and scope constraints across turns. "));
    mb_jappend(out, STR_PTR(MINI_SHORT_TASK_RULE), STR_LEN(MINI_SHORT_TASK_RULE));
    mb_jappend(out, STR_PTR(" Respect the session's sandbox, approval settings, analysis-only requests, and denied tools. When blocked or no change is needed, report that honestly from concrete evidence instead of retrying the same action; a short task or previously read files are not evidence that no change is needed."), STR_LEN(" Respect the session's sandbox, approval settings, analysis-only requests, and denied tools. When blocked or no change is needed, report that honestly from concrete evidence instead of retrying the same action; a short task or previously read files are not evidence that no change is needed."));
}
fn miniResponsesVerbosityField(model_p: ptr, model_n: u64, capability: &ModelCapabilityDescriptor, has_capability: bool, out: &u64) -> void {
    let empty_desc = ModelCapabilityDescriptor { reasoningEfforts: StrList { items: [StrRef { ptr: PTR_NULL(), len: 0 }; 32], len: 0 }, reasoningEfforts_present: false, contextWindow: 0.0, contextWindow_present: false, maxOutputTokens: 0.0, maxOutputTokens_present: false, verbosity: 0, verbosity_present: false, supportsVerbosity: false, supportsVerbosity_present: false, source: 0, source_present: false };
    let cap_ref: &ModelCapabilityDescriptor = capability;
    if !has_capability { cap_ref = &empty_desc; };
    let tag: u64 = 0;
    let has: bool = resolveModelVerbosity(model_p, model_n, cap_ref, has_capability, &tag);
    let obj: u64 = mb_new_obj();
    *out = obj;
    if !has { return; };
    let name: ptr = STR_PTR("low");
    let name_len: u64 = STR_LEN("low");
    if tag == 1 { name = STR_PTR("medium"); name_len = STR_LEN("medium"); } else if tag == 2 { name = STR_PTR("high"); name_len = STR_LEN("high"); };
    let text: u64 = mb_new_obj();
    let rc: i32 = mb_s_str(text, STR_PTR("verbosity"), STR_LEN("verbosity"), name, name_len);
    rc = mb_s_node(obj, STR_PTR("text"), STR_LEN("text"), text);
}
// ---- echo gate (TS:3522-3660) ----
fn MINI_ECHO_MATERIALIZE_CHARS() -> u64 { return 260; }
fn MINI_ECHO_USER_OVERLAP() -> f64 { return 0.5; }
fn MINI_ECHO_SELF_OVERLAP() -> f64 { return 0.6; }
fn MINI_ECHO_PRIOR_WINDOW() -> u64 { return 4000; }
fn MINI_HISTORY_ECHO_MAX_CHARS() -> u64 { return 200; }
fn mb_is_cjk3(b0: u8, b1: u8) -> bool {
    // U+4E00..U+9FFF in UTF-8: E4 B8 80 .. E9 BF BF.
    if b0 == 0xE4 { return b1 >= 0xB8; };
    if b0 >= 0xE5 && b0 <= 0xE8 { return true; };
    if b0 == 0xE9 { return b1 <= 0xBF; };
    return false;
}
fn mb_echo_tokens(text_p: ptr, text_n: u64, out: &u64) -> void {
    // Normalize: lowercase latin, keep [0-9a-z] and CJK chars, rest -> space.
    // Tokens are collected in a JSON string array acting as the set.
    let set: u64 = mb_new_arr();
    *out = set;
    let word = MbJson { bytes: [0u8; 262144], len: 0 };
    let word_is_cjk: bool = false;
    let i: u64 = 0;
    while i <= text_n {
        let is_sep: bool = i == text_n;
        let ch_len: u64 = 1;
        let cjk: bool = false;
        let lb: u8 = 0;
        if !is_sep {
            let b0: u8 = mb_byte_at(text_p, i);
            if b0 < 128 {
                if (b0 >= 48 && b0 <= 57) || (b0 >= 97 && b0 <= 122) { lb = b0; } else if b0 >= 65 && b0 <= 90 { lb = b0 + 32; } else { is_sep = true; };
            } else if b0 >= 0xE4 && b0 <= 0xE9 && i + 2 < text_n + 1 && i + 2 <= text_n - 1 + 1 && i + 2 < text_n + 1 {
                if i + 2 < text_n + 1 && mb_is_cjk3(b0, mb_byte_at(text_p, i + 1)) { cjk = true; ch_len = 3; } else { is_sep = true; };
            } else { is_sep = true; };
        };
        if is_sep {
            if word.len > 0 {
                if word_is_cjk {
                    // per char + bigrams (chars are 3-byte units here)
                    let chars: u64 = word.len / 3;
                    let ci: u64 = 0;
                    while ci < chars {
                        let one = MbStr { bytes: [0u8; 8192], len: 0 };
                        mb_sassign(&one, mb_ptr_add(mb_jp(&word), ci * 3), 3);
                        if !mb_str_in_arr(set, mb_sp(&one), one.len, false) { let rc: i32 = mb_a_push_str(set, mb_sp(&one), one.len); };
                        if ci + 1 < chars {
                            let two = MbStr { bytes: [0u8; 8192], len: 0 };
                            mb_sassign(&two, mb_ptr_add(mb_jp(&word), ci * 3), 6);
                            if !mb_str_in_arr(set, mb_sp(&two), two.len, false) { let rc: i32 = mb_a_push_str(set, mb_sp(&two), two.len); };
                        };
                        ci = ci + 1;
                    }
                } else if word.len > 2 {
                    if !mb_str_in_arr(set, mb_jp(&word), word.len, false) { let rc: i32 = mb_a_push_str(set, mb_jp(&word), word.len); };
                };
                word.len = 0;
                word_is_cjk = false;
            };
            i = i + 1;
            continue;
        };
        if cjk {
            if word.len > 0 && !word_is_cjk {
                // mixed word boundary: flush latin part as separator would
                if word.len > 2 && !mb_str_in_arr(set, mb_jp(&word), word.len, false) { let rc: i32 = mb_a_push_str(set, mb_jp(&word), word.len); };
                word.len = 0;
            };
            word_is_cjk = true;
            mb_jappend(&word, mb_ptr_add(text_p, i), 3);
            i = i + 3;
            continue;
        };
        if word_is_cjk {
            // latin char right after CJK: TS keeps them in the same split word;
            // the word still "starts with CJK" so char tokenization applies.
            mb_jpush(&word, lb);
            i = i + 1;
            continue;
        };
        mb_jpush(&word, lb);
        i = i + 1;
    }
}
fn miniTextOverlap(candidate_p: ptr, candidate_n: u64, other_p: ptr, other_n: u64) -> f64 {
    let a: u64 = 0;
    mb_echo_tokens(candidate_p, candidate_n, &a);
    let a_count: u64 = mb_n_count(a);
    if a_count == 0 { mb_free_doc(a); return 0.0; };
    let b: u64 = 0;
    mb_echo_tokens(other_p, other_n, &b);
    if mb_n_count(b) == 0 { mb_free_doc(a); mb_free_doc(b); return 0.0; };
    let hit: u64 = 0;
    let i: u64 = 0;
    while i < a_count {
        let tok = MbStr { bytes: [0u8; 8192], len: 0 };
        let ok: bool = mb_n_str(mb_a_at(a, i), &tok);
        i = i + 1;
        if mb_str_in_arr(b, mb_sp(&tok), tok.len, false) { hit = hit + 1; };
    }
    mb_free_doc(a);
    mb_free_doc(b);
    return hit as f64 / a_count as f64;
}
fn miniEchoVerdict(text_p: ptr, text_n: u64, user_p: ptr, user_n: u64, has_user: bool, prior_p: ptr, prior_n: u64, has_prior: bool, out: &u64) -> void {
    let body = MbStr { bytes: [0u8; 8192], len: 0 };
    mb_trim_to(text_p, text_n, &body);
    let verdict: u64 = mb_new_obj();
    *out = verdict;
    if body.len == 0 {
        let rc: i32 = mb_s_bool(verdict, STR_PTR("drop"), STR_LEN("drop"), true);
        rc = mb_s_f64(verdict, STR_PTR("overlap"), STR_LEN("overlap"), 1.0);
        rc = mb_s_str(verdict, STR_PTR("reason"), STR_LEN("reason"), STR_PTR("empty"), STR_LEN("empty"));
        return;
    };
    if body.len >= MINI_ECHO_MATERIALIZE_CHARS() {
        let rc: i32 = mb_s_bool(verdict, STR_PTR("drop"), STR_LEN("drop"), false);
        rc = mb_s_f64(verdict, STR_PTR("overlap"), STR_LEN("overlap"), 0.0);
        rc = mb_s_str(verdict, STR_PTR("reason"), STR_LEN("reason"), STR_PTR("long"), STR_LEN("long"));
        return;
    };
    let user_overlap: f64 = 0.0;
    if has_user { user_overlap = miniTextOverlap(mb_sp(&body), body.len, user_p, user_n); };
    if user_overlap >= MINI_ECHO_USER_OVERLAP() {
        let rc: i32 = mb_s_bool(verdict, STR_PTR("drop"), STR_LEN("drop"), true);
        rc = mb_s_f64(verdict, STR_PTR("overlap"), STR_LEN("overlap"), user_overlap);
        rc = mb_s_str(verdict, STR_PTR("reason"), STR_LEN("reason"), STR_PTR("user-echo"), STR_LEN("user-echo"));
        return;
    };
    let self_overlap: f64 = 0.0;
    if has_prior { self_overlap = miniTextOverlap(mb_sp(&body), body.len, prior_p, prior_n); };
    if self_overlap >= MINI_ECHO_SELF_OVERLAP() {
        let rc: i32 = mb_s_bool(verdict, STR_PTR("drop"), STR_LEN("drop"), true);
        rc = mb_s_f64(verdict, STR_PTR("overlap"), STR_LEN("overlap"), self_overlap);
        rc = mb_s_str(verdict, STR_PTR("reason"), STR_LEN("reason"), STR_PTR("self-echo"), STR_LEN("self-echo"));
        return;
    };
    let max_overlap: f64 = user_overlap;
    if self_overlap > max_overlap { max_overlap = self_overlap; };
    let rc: i32 = mb_s_bool(verdict, STR_PTR("drop"), STR_LEN("drop"), false);
    rc = mb_s_f64(verdict, STR_PTR("overlap"), STR_LEN("overlap"), max_overlap);
    rc = mb_s_str(verdict, STR_PTR("reason"), STR_LEN("reason"), STR_PTR("work"), STR_LEN("work"));
}
const MINI_INTERNAL_DIRECTIVE: ptr = "[Mini runtime status: session information, not a user message]";
fn miniInternalDirective(note_p: ptr, note_n: u64, out: &MbJson) -> void {
    out.len = 0;
    mb_jappend(out, STR_PTR("[Mini runtime status: session information, not a user message]\n"), STR_LEN("[Mini runtime status: session information, not a user message]\n"));
    mb_jappend(out, note_p, note_n);
}
fn miniHistoryLinesFromMessages(messages: u64, turn_p: ptr, turn_n: u64, per_item_cap: i64, out: &u64) -> void {
    let lines: u64 = mb_new_arr();
    *out = lines;
    if messages == 0 || mb_kind(messages) != MB_JK_ARRAY { return; };
    let count: u64 = mb_n_count(messages);
    // Pass 1: continuation indices for this exclusion set.
    let continuation_idx: u64 = mb_new_arr();
    let i: u64 = 0;
    while i < count {
        let m: u64 = mb_a_at(messages, i);
        i = i + 1;
        if m == 0 || mb_kind(m) != MB_JK_OBJECT { continue; };
        let tid = MbJson { bytes: [0u8; 262144], len: 0 };
        mb_field_text(m, STR_PTR("turnId"), STR_LEN("turnId"), &tid);
        if tid.len == turn_n && mb_bytes_eq(mb_jp(&tid), tid.len, turn_p, turn_n) { continue; };
        if isMiniGoalContinuationMessage(m) { let rc: i32 = mb_a_push_i64(continuation_idx, (i - 1) as i64); };
    }
    let drop_count: u64 = 0;
    let ci_count: u64 = mb_n_count(continuation_idx);
    if ci_count > 1 { drop_count = ci_count - 1; };
    let current_turn = MbJson { bytes: [0u8; 262144], len: 0 };
    let turn_user_text = MbJson { bytes: [0u8; 262144], len: 0 };
    let prev_assistant_text = MbJson { bytes: [0u8; 262144], len: 0 };
    let idx: u64 = 0;
    while idx < count {
        let message: u64 = mb_a_at(messages, idx);
        let this_idx: u64 = idx;
        idx = idx + 1;
        // dropped continuation?
        let dropped: bool = false;
        let di: u64 = 0;
        while di < drop_count {
            let dv: f64 = 0.0;
            let ok: bool = mb_n_f64(mb_a_at(continuation_idx, di), &dv);
            di = di + 1;
            if ok && (dv as u64) == this_idx { dropped = true; };
        }
        if dropped { continue; };
        if message == 0 || mb_kind(message) != MB_JK_OBJECT { continue; };
        let item_turn = MbJson { bytes: [0u8; 262144], len: 0 };
        mb_field_text(message, STR_PTR("turnId"), STR_LEN("turnId"), &item_turn);
        if item_turn.len == turn_n && mb_bytes_eq(mb_jp(&item_turn), item_turn.len, turn_p, turn_n) { continue; };
        if !mb_j_eq(&item_turn, mb_jp(&current_turn), current_turn.len) {
            mb_jassign_j(&current_turn, &item_turn);
            turn_user_text.len = 0;
            prev_assistant_text.len = 0;
        };
        let kind = MbJson { bytes: [0u8; 262144], len: 0 };
        mb_field_text(message, STR_PTR("type"), STR_LEN("type"), &kind);
        if mb_j_eq(&kind, STR_PTR("userMessage"), STR_LEN("userMessage")) {
            mb_field_text(message, STR_PTR("text"), STR_LEN("text"), &turn_user_text);
            prev_assistant_text.len = 0;
        };
        let text = MbJson { bytes: [0u8; 262144], len: 0 };
        historyItemToText(message, per_item_cap, &text);
        let tt = MbStr { bytes: [0u8; 8192], len: 0 };
        mb_trim_to(mb_jp(&text), text.len, &tt);
        if tt.len == 0 { continue; };
        if mb_j_eq(&kind, STR_PTR("agentMessage"), STR_LEN("agentMessage")) {
            let body = MbJson { bytes: [0u8; 262144], len: 0 };
            mb_field_text(message, STR_PTR("text"), STR_LEN("text"), &body);
            let bt = MbStr { bytes: [0u8; 8192], len: 0 };
            mb_trim_to(mb_jp(&body), body.len, &bt);
            if bt.len == 0 { continue; };
            if body.len <= MINI_HISTORY_ECHO_MAX_CHARS() {
                if turn_user_text.len > 0 && miniTextOverlap(mb_jp(&body), body.len, mb_jp(&turn_user_text), turn_user_text.len) >= MINI_ECHO_USER_OVERLAP() { continue; };
                if prev_assistant_text.len > 0 && miniTextOverlap(mb_jp(&body), body.len, mb_jp(&prev_assistant_text), prev_assistant_text.len) >= MINI_ECHO_SELF_OVERLAP() { continue; };
            };
            mb_jassign_j(&prev_assistant_text, &body);
        };
        let rc: i32 = mb_a_push_str(lines, mb_jp(&text), text.len);
    }
    mb_free_doc(continuation_idx);
}
// ---- plan reminder / fingerprints / phase / kind (TS:3662-3760) ----
fn miniPendingPlanReminder(steps: u64, out: &MbJson, out_is_null: &bool) -> void {
    out.len = 0;
    *out_is_null = true;
    let pending: u64 = mb_new_arr();
    let count: u64 = 0;
    if steps != 0 && mb_kind(steps) == MB_JK_ARRAY { count = mb_n_count(steps); };
    let i: u64 = 0;
    while i < count {
        let e: u64 = mb_a_at(steps, i);
        i = i + 1;
        let st = MbStr { bytes: [0u8; 8192], len: 0 };
        if e != 0 { let ok: bool = mb_g_str(e, STR_PTR("status"), STR_LEN("status"), &st); };
        if !mb_s_eq(&st, STR_PTR("completed"), STR_LEN("completed")) { let rc: i32 = mb_a_push_node(pending, mb_clone_node(e)); };
    }
    let pc: u64 = mb_n_count(pending);
    if pc == 0 { mb_free_doc(pending); return; };
    mb_jappend(out, STR_PTR("The plan checklist still has "), STR_LEN("The plan checklist still has "));
    let num = MbStr { bytes: [0u8; 8192], len: 0 };
    mb_u64_to_s(pc, &num);
    mb_jappend_s(out, &num);
    mb_jappend(out, STR_PTR(" unfinished step(s):"), STR_LEN(" unfinished step(s):"));
    let shown: u64 = pc;
    if shown > 8 { shown = 8; };
    let j: u64 = 0;
    while j < shown {
        let e: u64 = mb_a_at(pending, j);
        j = j + 1;
        let step = MbStr { bytes: [0u8; 8192], len: 0 };
        let st = MbStr { bytes: [0u8; 8192], len: 0 };
        if e != 0 {
            let ok1: bool = mb_g_str(e, STR_PTR("step"), STR_LEN("step"), &step);
            let ok2: bool = mb_g_str(e, STR_PTR("status"), STR_LEN("status"), &st);
        };
        mb_jappend(out, STR_PTR("\n- [ ] "), STR_LEN("\n- [ ] "));
        mb_jappend_s(out, &step);
        if mb_s_eq(&st, STR_PTR("in_progress"), STR_LEN("in_progress")) { mb_jappend(out, STR_PTR(" _(in progress)_"), STR_LEN(" _(in progress)_")); };
    }
    mb_free_doc(pending);
    mb_jappend(out, STR_PTR("\nContinue the next useful step now and update the checklist when its status changes. Do NOT repeat completed work; if blocked, report the blocker concisely."), STR_LEN("\nContinue the next useful step now and update the checklist when its status changes. Do NOT repeat completed work; if blocked, report the blocker concisely."));
    mb_jappend(out, STR_PTR("\nUse the next useful tool when permitted, or give the final answer if blocked."), STR_LEN("\nUse the next useful tool when permitted, or give the final answer if blocked."));
    mb_jappend(out, STR_PTR("\nA concise task is not a blocker. Previously inspected files complete investigation, not pending implementation; reuse that evidence to make the requested change. Do not end with an unchanged workspace recap or a request for a new goal."), STR_LEN("\nA concise task is not a blocker. Previously inspected files complete investigation, not pending implementation; reuse that evidence to make the requested change. Do not end with an unchanged workspace recap or a request for a new goal."));
    mb_jappend(out, STR_PTR("\nIf the user's latest message asks for something unrelated to this plan, follow the user message instead and leave the plan untouched."), STR_LEN("\nIf the user's latest message asks for something unrelated to this plan, follow the user message instead and leave the plan untouched."));
    *out_is_null = false;
}
fn mb_steps_projection(steps: u64, out: &u64) -> void {
    let arr: u64 = mb_new_arr();
    *out = arr;
    let count: u64 = 0;
    if steps != 0 && mb_kind(steps) == MB_JK_ARRAY { count = mb_n_count(steps); };
    let i: u64 = 0;
    while i < count {
        let e: u64 = mb_a_at(steps, i);
        i = i + 1;
        let entry: u64 = mb_new_obj();
        let step = MbStr { bytes: [0u8; 8192], len: 0 };
        let status = MbStr { bytes: [0u8; 8192], len: 0 };
        if e != 0 {
            let ok1: bool = mb_g_str(e, STR_PTR("step"), STR_LEN("step"), &step);
            let ok2: bool = mb_g_str(e, STR_PTR("status"), STR_LEN("status"), &status);
        };
        let rc: i32 = mb_s_str(entry, STR_PTR("step"), STR_LEN("step"), mb_sp(&step), step.len);
        rc = mb_s_str(entry, STR_PTR("status"), STR_LEN("status"), mb_sp(&status), status.len);
        rc = mb_a_push_node(arr, entry);
    }
}
fn miniPlanProgressFingerprint(steps: u64, tool_calls: u64, out: &MbJson) -> void {
    let proj: u64 = 0;
    mb_steps_projection(steps, &proj);
    let obj: u64 = mb_new_obj();
    let rc: i32 = mb_s_node(obj, STR_PTR("steps"), STR_LEN("steps"), proj);
    rc = mb_s_f64(obj, STR_PTR("toolCalls"), STR_LEN("toolCalls"), tool_calls as f64);
    let ok: bool = mb_stringify_node(obj, out);
    mb_free_doc(obj);
}
fn miniPlanTaskFingerprint(steps: u64, evidence: u64, has_evidence: bool, out: &MbJson) -> void {
    let proj: u64 = 0;
    mb_steps_projection(steps, &proj);
    let obj: u64 = mb_new_obj();
    let rc: i32 = mb_s_node(obj, STR_PTR("steps"), STR_LEN("steps"), proj);
    let w: f64 = 0.0;
    let v: f64 = 0.0;
    let r: f64 = 0.0;
    if has_evidence && evidence != 0 {
        let ok1: bool = mb_g_f64(evidence, STR_PTR("writes"), STR_LEN("writes"), &w);
        let ok2: bool = mb_g_f64(evidence, STR_PTR("verifies"), STR_LEN("verifies"), &v);
        let ok3: bool = mb_g_f64(evidence, STR_PTR("agentReports"), STR_LEN("agentReports"), &r);
        // TS typeof checks: non-number fields count as 0 (mb_g_f64 only reads numbers)
    };
    rc = mb_s_f64(obj, STR_PTR("writes"), STR_LEN("writes"), w);
    rc = mb_s_f64(obj, STR_PTR("verifies"), STR_LEN("verifies"), v);
    rc = mb_s_f64(obj, STR_PTR("agentReports"), STR_LEN("agentReports"), r);
    let ok: bool = mb_stringify_node(obj, out);
    mb_free_doc(obj);
}
fn miniTaskPhase(steps: u64, has_write: bool, has_verify: bool, out: &MbStr) -> void {
    out.len = 0;
    let count: u64 = 0;
    if steps != 0 && mb_kind(steps) == MB_JK_ARRAY { count = mb_n_count(steps); };
    if count == 0 {
        if has_write { mb_sassign(out, STR_PTR("verify"), STR_LEN("verify")); } else { mb_sassign(out, STR_PTR("investigate"), STR_LEN("investigate")); };
        return;
    };
    let first_pending: u64 = 0;
    let pending_count: u64 = 0;
    let i: u64 = 0;
    while i < count {
        let e: u64 = mb_a_at(steps, i);
        i = i + 1;
        let st = MbStr { bytes: [0u8; 8192], len: 0 };
        if e != 0 { let ok: bool = mb_g_str(e, STR_PTR("status"), STR_LEN("status"), &st); };
        if !mb_s_eq(&st, STR_PTR("completed"), STR_LEN("completed")) {
            pending_count = pending_count + 1;
            if first_pending == 0 { first_pending = e; };
        };
    }
    if pending_count == 0 { mb_sassign(out, STR_PTR("done"), STR_LEN("done")); return; };
    let cur_status = MbStr { bytes: [0u8; 8192], len: 0 };
    if first_pending != 0 { let ok: bool = mb_g_str(first_pending, STR_PTR("status"), STR_LEN("status"), &cur_status); };
    if mb_s_eq(&cur_status, STR_PTR("in_progress"), STR_LEN("in_progress")) {
        if has_verify { mb_sassign(out, STR_PTR("next"), STR_LEN("next")); return; };
        if has_write { mb_sassign(out, STR_PTR("verify"), STR_LEN("verify")); } else { mb_sassign(out, STR_PTR("modify"), STR_LEN("modify")); };
        return;
    };
    if has_write && !has_verify { mb_sassign(out, STR_PTR("verify"), STR_LEN("verify")); return; };
    if has_write { mb_sassign(out, STR_PTR("next"), STR_LEN("next")); return; };
    mb_sassign(out, STR_PTR("investigate"), STR_LEN("investigate"));
}
fn miniTaskKind(prompt_p: ptr, prompt_n: u64, no_tool_requested: bool, is_continuation: bool, out: &MbStr) -> void {
    out.len = 0;
    if no_tool_requested || miniIsAnalysisOnlyPrompt(prompt_p, prompt_n) { mb_sassign(out, STR_PTR("analyze"), STR_LEN("analyze")); return; };
    if is_continuation || isMiniContinuationNudge(prompt_p, prompt_n) { mb_sassign(out, STR_PTR("continue"), STR_LEN("continue")); return; };
    mb_sassign(out, STR_PTR("new"), STR_LEN("new"));
}
// ---- agent inbox (TS:3762-3790) ----
fn MINI_AGENT_INBOX_REPORT_CHARS() -> u64 { return 2000; }
fn miniAgentInboxKey(agent_p: ptr, agent_n: u64, status_p: ptr, status_n: u64, out: &MbJson) -> void {
    out.len = 0;
    mb_jappend(out, agent_p, agent_n);
    mb_jappend(out, STR_PTR(":"), STR_LEN(":"));
    mb_jappend(out, status_p, status_n);
}
fn collectMiniUndeliveredAgentReports(children: u64, delivered: u64, has_delivered: bool, out: &u64) -> void {
    let reports: u64 = mb_new_arr();
    *out = reports;
    let count: u64 = 0;
    if children != 0 && mb_kind(children) == MB_JK_ARRAY { count = mb_n_count(children); };
    let i: u64 = 0;
    while i < count {
        let c: u64 = mb_a_at(children, i);
        i = i + 1;
        if c == 0 || mb_kind(c) != MB_JK_OBJECT { continue; };
        let thread_id = MbStr { bytes: [0u8; 8192], len: 0 };
        let has_tid: bool = mb_g_str(c, STR_PTR("threadId"), STR_LEN("threadId"), &thread_id);
        if !has_tid || thread_id.len == 0 { continue; };
        let status = MbJson { bytes: [0u8; 262144], len: 0 };
        mb_field_text(c, STR_PTR("status"), STR_LEN("status"), &status);
        if !mb_j_eq(&status, STR_PTR("completed"), STR_LEN("completed")) && !mb_j_eq(&status, STR_PTR("failed"), STR_LEN("failed")) && !mb_j_eq(&status, STR_PTR("interrupted"), STR_LEN("interrupted")) { continue; };
        let report = MbJson { bytes: [0u8; 262144], len: 0 };
        let report_node: u64 = mb_g_node(c, STR_PTR("report"), STR_LEN("report"));
        if report_node != 0 && mb_kind(report_node) == MB_JK_STRING { let ok: bool = mb_n_str_j(report_node, &report); };
        if report.len == 0 { continue; };
        let key = MbJson { bytes: [0u8; 262144], len: 0 };
        miniAgentInboxKey(mb_sp(&thread_id), thread_id.len, mb_jp(&status), status.len, &key);
        if has_delivered && delivered != 0 && mb_str_in_arr(delivered, mb_jp(&key), key.len, false) { continue; };
        let entry: u64 = mb_new_obj();
        let rc: i32 = mb_s_str(entry, STR_PTR("agentId"), STR_LEN("agentId"), mb_sp(&thread_id), thread_id.len);
        let task_name = MbStr { bytes: [0u8; 8192], len: 0 };
        if mb_g_str(c, STR_PTR("taskName"), STR_LEN("taskName"), &task_name) { rc = mb_s_str(entry, STR_PTR("taskName"), STR_LEN("taskName"), mb_sp(&task_name), task_name.len); };
        rc = mb_s_str(entry, STR_PTR("status"), STR_LEN("status"), mb_jp(&status), status.len);
        rc = mb_s_str(entry, STR_PTR("report"), STR_LEN("report"), mb_jp(&report), report.len);
        rc = mb_a_push_node(reports, entry);
    }
}
fn formatMiniAgentInboxDirective(reports: u64, out: &MbJson, out_is_null: &bool) -> void {
    out.len = 0;
    *out_is_null = true;
    if reports == 0 || mb_kind(reports) != MB_JK_ARRAY || mb_n_count(reports) == 0 { return; };
    let count: u64 = mb_n_count(reports);
    mb_jappend(out, STR_PTR("Sub-agent result(s) just completed ("), STR_LEN("Sub-agent result(s) just completed ("));
    let num = MbStr { bytes: [0u8; 8192], len: 0 };
    mb_u64_to_s(count, &num);
    mb_jappend_s(out, &num);
    mb_jappend(out, STR_PTR("):"), STR_LEN("):"));
    let shown: u64 = count;
    if shown > 5 { shown = 5; };
    let i: u64 = 0;
    while i < shown {
        let r: u64 = mb_a_at(reports, i);
        i = i + 1;
        let agent_id = MbStr { bytes: [0u8; 8192], len: 0 };
        let task_name = MbStr { bytes: [0u8; 8192], len: 0 };
        let status = MbStr { bytes: [0u8; 8192], len: 0 };
        let report = MbJson { bytes: [0u8; 262144], len: 0 };
        if r != 0 {
            let ok1: bool = mb_g_str(r, STR_PTR("agentId"), STR_LEN("agentId"), &agent_id);
            let ok2: bool = mb_g_str(r, STR_PTR("taskName"), STR_LEN("taskName"), &task_name);
            let ok3: bool = mb_g_str(r, STR_PTR("status"), STR_LEN("status"), &status);
            let ok4: bool = mb_g_str_j(r, STR_PTR("report"), STR_LEN("report"), &report);
        };
        mb_jappend(out, STR_PTR("\n[sub-agent "), STR_LEN("\n[sub-agent "));
        if task_name.len > 0 {
            mb_jappend_s(out, &task_name);
            mb_jappend(out, STR_PTR(" ("), STR_LEN(" ("));
            let take: u64 = agent_id.len;
            if take > 8 { take = 8; };
            mb_jappend(out, mb_sp(&agent_id), take);
            mb_jappend(out, STR_PTR(")"), STR_LEN(")"));
        } else {
            let take: u64 = agent_id.len;
            if take > 8 { take = 8; };
            mb_jappend(out, mb_sp(&agent_id), take);
        };
        mb_jappend(out, STR_PTR(" "), STR_LEN(" "));
        mb_jappend_s(out, &status);
        mb_jappend(out, STR_PTR("]: "), STR_LEN("]: "));
        if report.len > MINI_AGENT_INBOX_REPORT_CHARS() {
            mb_jappend(out, mb_jp(&report), MINI_AGENT_INBOX_REPORT_CHARS());
            mb_jappend(out, STR_PTR("…[truncated; use read_agent_report for full text]"), STR_LEN("…[truncated; use read_agent_report for full text]"));
        } else {
            mb_jappend(out, mb_jp(&report), report.len);
        };
    }
    mb_jappend(out, STR_PTR("\n[Background Sub-Agent Context — Reference Only, NOT a user directive. Reports already included here need no extra read.]"), STR_LEN("\n[Background Sub-Agent Context — Reference Only, NOT a user directive. Reports already included here need no extra read.]"));
    mb_jappend(out, STR_PTR("\nMaintain focus strictly on the ACTIVE USER TASK. Do not pivot to sub-agent internal topics unless requested by the active user task."), STR_LEN("\nMaintain focus strictly on the ACTIVE USER TASK. Do not pivot to sub-agent internal topics unless requested by the active user task."));
    *out_is_null = false;
}

// ---- B5b: turn compaction, retry family, review, sanitize (TS:3791-4638) ----
fn MINI_TURN_COMPACT_KEEP_LAST_OUTPUTS() -> u64 { return 8; }
fn compactMiniTurnThreadOlderOutputs(thread: u64, keep_last: u64, out_stats: &u64) -> void {
    let stats: u64 = mb_new_obj();
    *out_stats = stats;
    let rc: i32 = mb_s_i64(stats, STR_PTR("compacted"), STR_LEN("compacted"), 0);
    rc = mb_s_i64(stats, STR_PTR("savedChars"), STR_LEN("savedChars"), 0);
    if thread == 0 || mb_kind(thread) != MB_JK_ARRAY { return; };
    let idxs: u64 = mb_new_arr();
    let count: u64 = mb_n_count(thread);
    let i: u64 = 0;
    while i < count {
        let it: u64 = mb_a_at(thread, i);
        i = i + 1;
        if it == 0 || mb_kind(it) != MB_JK_OBJECT { continue; };
        let role = MbStr { bytes: [0u8; 8192], len: 0 };
        let ty = MbStr { bytes: [0u8; 8192], len: 0 };
        let ok1: bool = mb_g_str(it, STR_PTR("role"), STR_LEN("role"), &role);
        let ok2: bool = mb_g_str(it, STR_PTR("type"), STR_LEN("type"), &ty);
        if mb_s_eq(&role, STR_PTR("tool"), STR_LEN("tool")) || mb_s_eq(&ty, STR_PTR("function_call_output"), STR_LEN("function_call_output")) {
            let rc2: i32 = mb_a_push_i64(idxs, (i - 1) as i64);
        };
    }
    let oc: u64 = mb_n_count(idxs);
    if oc <= keep_last { mb_free_doc(idxs); return; };
    let victims: u64 = oc - keep_last;
    let compacted: i64 = 0;
    let saved: i64 = 0;
    let vi: u64 = 0;
    while vi < victims {
        let iv: f64 = 0.0;
        let ok: bool = mb_n_f64(mb_a_at(idxs, vi), &iv);
        vi = vi + 1;
        let it: u64 = mb_a_at(thread, iv as u64);
        if it == 0 { continue; };
        let content_node: u64 = mb_g_node(it, STR_PTR("content"), STR_LEN("content"));
        let output_node: u64 = mb_g_node(it, STR_PTR("output"), STR_LEN("output"));
        let id = MbJson { bytes: [0u8; 262144], len: 0 };
        let id_node: u64 = mb_g_node(it, STR_PTR("tool_call_id"), STR_LEN("tool_call_id"));
        if id_node == 0 || mb_kind(id_node) == MB_JK_NULL { id_node = mb_g_node(it, STR_PTR("call_id"), STR_LEN("call_id")); };
        if id_node != 0 && mb_kind(id_node) != MB_JK_NULL { mb_str_of_node(id_node, &id); } else { mb_jassign(&id, STR_PTR("tool"), STR_LEN("tool")); };
        if content_node != 0 && mb_kind(content_node) == MB_JK_STRING {
            let text = MbJson { bytes: [0u8; 262144], len: 0 };
            let ok2: bool = mb_n_str_j(content_node, &text);
            if text.len > 400 {
                saved = saved + (text.len - 400) as i64;
                let note = MbJson { bytes: [0u8; 262144], len: 0 };
                mb_jappend(&note, STR_PTR("[earlier tool output compacted ("), STR_LEN("[earlier tool output compacted ("));
                let num = MbStr { bytes: [0u8; 8192], len: 0 };
                mb_u64_to_s(text.len, &num);
                mb_jappend_s(&note, &num);
                mb_jappend(&note, STR_PTR(" chars omitted to stay within context; newest outputs below remain full): "), STR_LEN(" chars omitted to stay within context; newest outputs below remain full): "));
                mb_jappend(&note, mb_jp(&id), id.len);
                mb_jappend(&note, STR_PTR("]"), STR_LEN("]"));
                let rc2: i32 = mb_s_str(it, STR_PTR("content"), STR_LEN("content"), mb_jp(&note), note.len);
                compacted = compacted + 1;
                continue;
            };
        };
        if output_node != 0 && mb_kind(output_node) == MB_JK_STRING {
            let text = MbJson { bytes: [0u8; 262144], len: 0 };
            let ok2: bool = mb_n_str_j(output_node, &text);
            if text.len > 400 {
                saved = saved + (text.len - 400) as i64;
                let note = MbJson { bytes: [0u8; 262144], len: 0 };
                mb_jappend(&note, STR_PTR("[earlier tool output compacted ("), STR_LEN("[earlier tool output compacted ("));
                let num = MbStr { bytes: [0u8; 8192], len: 0 };
                mb_u64_to_s(text.len, &num);
                mb_jappend_s(&note, &num);
                mb_jappend(&note, STR_PTR(" chars omitted to stay within context; newest outputs below remain full): "), STR_LEN(" chars omitted to stay within context; newest outputs below remain full): "));
                mb_jappend(&note, mb_jp(&id), id.len);
                mb_jappend(&note, STR_PTR("]"), STR_LEN("]"));
                let rc2: i32 = mb_s_str(it, STR_PTR("output"), STR_LEN("output"), mb_jp(&note), note.len);
                compacted = compacted + 1;
            };
        };
    }
    mb_free_doc(idxs);
    rc = mb_s_i64(stats, STR_PTR("compacted"), STR_LEN("compacted"), compacted);
    rc = mb_s_i64(stats, STR_PTR("savedChars"), STR_LEN("savedChars"), saved);
}
fn shouldContinueMiniPlan(seen: u64, progress_p: ptr, progress_n: u64) -> bool {
    if mb_str_in_arr(seen, progress_p, progress_n, false) { return false; };
    let rc: i32 = mb_a_push_str(seen, progress_p, progress_n);
    return true;
}
fn MAX_MINI_BUDGET_EXCUSE_CORRECTIONS() -> u64 { return 3; }
fn mb_budget_excuse_re_test(p: ptr, n: u64) -> bool {
    return mb_re_test(p, n, STR_PTR("预算(限制|用尽|耗尽|不足|超限|额度)|工具预算|轮数限制|工具受限|不再能调用|无法继续调用|tool[ \t-]?call budget|budget (limit|reached|exhausted|exceeded|ran out)|ran out of (tool|round|call)|round limit|no (more|further) tool calls? (allowed|remaining|left)|token budget|tool execution (paused|stopped|halted)|no active (user )?task|no further progress (possible|can be made)|blocker:[ \t]*no active"), STR_LEN("预算(限制|用尽|耗尽|不足|超限|额度)|工具预算|轮数限制|工具受限|不再能调用|无法继续调用|tool[ \t-]?call budget|budget (limit|reached|exhausted|exceeded|ran out)|ran out of (tool|round|call)|round limit|no (more|further) tool calls? (allowed|remaining|left)|token budget|tool execution (paused|stopped|halted)|no active (user )?task|no further progress (possible|can be made)|blocker:[ \t]*no active"), true);
}
fn miniBudgetExcuseCorrection(text_p: ptr, text_n: u64, has_tool_calls: bool, out: &MbJson, out_is_null: &bool) -> void {
    out.len = 0;
    *out_is_null = true;
    if text_n == 0 || !mb_budget_excuse_re_test(text_p, text_n) { return; };
    if has_tool_calls {
        mb_jassign(out, STR_PTR("The turn is not paused and results have already been gathered. Answer the user directly using the information collected from your tool calls; do not claim tool execution is paused or that there is no active task."), STR_LEN("The turn is not paused and results have already been gathered. Answer the user directly using the information collected from your tool calls; do not claim tool execution is paused or that there is no active task."));
    } else {
        mb_jassign(out, STR_PTR("Correction: the configured turn safety limit still has room - it has not been reached. Continue the next unfinished step now with the smallest useful tool call; do not repeat the budget claim."), STR_LEN("Correction: the configured turn safety limit still has room - it has not been reached. Continue the next unfinished step now with the smallest useful tool call; do not repeat the budget claim."));
    };
    *out_is_null = false;
}
fn MAX_MINI_CODE_INTENT_CONTINUATIONS() -> u64 { return 2; }
fn mb_code_intent_re_test(p: ptr, n: u64) -> bool {
    // TS builds MINI_CODE_INTENT_RE from parts with glue [^，。！？；：\n]{0,8}?;
    // ERE has no non-greedy quantifier: greedy {0,8} is equivalent for test().
    let pat = MbJson { bytes: [0u8; 262144], len: 0 };
    mb_jappend(&pat, STR_PTR("(接下[来]?[我]?[将要]?(修改|改动|更新|修复|调整|重构|创建|添加|删除|优化|实现|编写|写入)|准备"), STR_LEN("(接下[来]?[我]?[将要]?(修改|改动|更新|修复|调整|重构|创建|添加|删除|优化|实现|编写|写入)|准备"));
    mb_jappend(&pat, STR_PTR("[^，。！？；：\n]{0,8}"), STR_LEN("[^，。！？；：\n]{0,8}"));
    mb_jappend(&pat, STR_PTR("(修改|改动|更新|修复|调整|重构|创建|添加|实现|编写|动手)|让我[来]?"), STR_LEN("(修改|改动|更新|修复|调整|重构|创建|添加|实现|编写|动手)|让我[来]?"));
    mb_jappend(&pat, STR_PTR("[^，。！？；：\n]{0,8}"), STR_LEN("[^，。！？；：\n]{0,8}"));
    mb_jappend(&pat, STR_PTR("(修改|改|处理|修复|实现)|开始"), STR_LEN("(修改|改|处理|修复|实现)|开始"));
    mb_jappend(&pat, STR_PTR("[^，。！？；：\n]{0,8}"), STR_LEN("[^，。！？；：\n]{0,8}"));
    mb_jappend(&pat, STR_PTR("(修改|改|写|实现|调整|动手)|我来(修改|处理|搞定|写)|马上(改|修改|处理|修复)|现在就(改|修改|动手)|我.{0,4}动手|直接动手|动手(修|改|写|优化)|这就(改|修|写|动手)|开(修|改|干)|i'll (now )?(modify|update|fix|refactor|create|add|implement|apply|edit|write)|let me (modify|update|fix|implement|handle)|going to (modify|update|fix|implement|write)|proceeding to (modify|update|fix|implement)|next,? i will (modify|update|fix|implement|write|apply)|是否(需要|进行|确认|同意|希望)"), STR_LEN("(修改|改|写|实现|调整|动手)|我来(修改|处理|搞定|写)|马上(改|修改|处理|修复)|现在就(改|修改|动手)|我.{0,4}动手|直接动手|动手(修|改|写|优化)|这就(改|修|写|动手)|开(修|改|干)|i'll (now )?(modify|update|fix|refactor|create|add|implement|apply|edit|write)|let me (modify|update|fix|implement|handle)|going to (modify|update|fix|implement|write)|proceeding to (modify|update|fix|implement)|next,? i will (modify|update|fix|implement|write|apply)|是否(需要|进行|确认|同意|希望)"));
    mb_jappend(&pat, STR_PTR("[^，。！？；：\n]{0,8}"), STR_LEN("[^，。！？；：\n]{0,8}"));
    mb_jappend(&pat, STR_PTR("(修改|改动|更新|修复|调整|实现|应用|替换)|请问是否(需要|进行|确认|修改)|建议方案如下|修改方案如下|shall i (proceed|modify|fix|update|implement|make the change)|would you like me to (modify|fix|update|implement|proceed|apply)|do you want me to (modify|fix|update|implement|proceed))"), STR_LEN("(修改|改动|更新|修复|调整|实现|应用|替换)|请问是否(需要|进行|确认|修改)|建议方案如下|修改方案如下|shall i (proceed|modify|fix|update|implement|make the change)|would you like me to (modify|fix|update|implement|proceed|apply)|do you want me to (modify|fix|update|implement|proceed))"));
    return mb_re_test(p, n, mb_jp(&pat), pat.len, true);
}
fn miniCodeIntentCorrection(text_p: ptr, text_n: u64, out: &MbJson, out_is_null: &bool) -> void {
    out.len = 0;
    *out_is_null = true;
    if text_n == 0 || !mb_code_intent_re_test(text_p, text_n) { return; };
    mb_jassign(out, STR_PTR("The requested implementation has not been written yet. When permitted, use sa_vm edit_file, write_file, or apply_patch for the next concrete change. If no change is needed or execution is blocked, explain the reason in the final answer."), STR_LEN("The requested implementation has not been written yet. When permitted, use sa_vm edit_file, write_file, or apply_patch for the next concrete change. If no change is needed or execution is blocked, explain the reason in the final answer."));
    *out_is_null = false;
}
fn MAX_MINI_READ_STALL_STEERS() -> u64 { return 2; }
fn MINI_READ_STALL_THRESHOLD() -> u64 { return 4; }
fn MINI_READ_STALL_HARD_LIMIT() -> u64 { return 6; }
fn isMiniReadOnlyAction(action: u64) -> bool {
    if action == 0 || mb_kind(action) != MB_JK_STRING { return false; };
    let raw = MbStr { bytes: [0u8; 8192], len: 0 };
    let ok: bool = mb_n_str(action, &raw);
    let t = MbStr { bytes: [0u8; 8192], len: 0 };
    mb_trim_to(mb_sp(&raw), raw.len, &t);
    let low = MbStr { bytes: [0u8; 8192], len: 0 };
    mb_lower_into(mb_sp(&t), t.len, &low);
    let set: u64 = mb_parse(STR_PTR("[\"read\",\"read_file\",\"vm-read\",\"vm_read\",\"read_lines\",\"read_many\",\"read_files\",\"read_file_tail\",\"tail\",\"tail_file\",\"list_dir\",\"find\",\"find_files\",\"list_files\",\"grep\",\"grep_search\",\"grep_async\",\"grep_search_async\",\"async_grep\",\"stat\",\"file_info\",\"test_path\",\"file_exists\",\"exists\",\"count_lines\",\"line_count\",\"wc\",\"count\",\"file_outline\",\"outline\",\"list_symbols\",\"workspace_outline\",\"outline_many\",\"project_outline\",\"find_references\",\"find_all_references\",\"references\",\"find_usages\",\"find_implementations\",\"find_impl\",\"implementations\",\"find_definition\",\"goto_definition\",\"def\",\"lookup_symbol\",\"get_definition\",\"code_graph\",\"relation_graph\",\"symbol_graph\",\"repo_map\",\"repo-map\",\"get_diagnostics\",\"diagnostics\",\"check_syntax\",\"workspace_diagnostics\",\"analyze_scope\",\"scope_analysis\",\"git_status\",\"git-status\",\"git_diff\",\"git-diff\",\"git_log\",\"git-log\",\"split_plan\",\"split_status\"]"), STR_LEN("[\"read\",\"read_file\",\"vm-read\",\"vm_read\",\"read_lines\",\"read_many\",\"read_files\",\"read_file_tail\",\"tail\",\"tail_file\",\"list_dir\",\"find\",\"find_files\",\"list_files\",\"grep\",\"grep_search\",\"grep_async\",\"grep_search_async\",\"async_grep\",\"stat\",\"file_info\",\"test_path\",\"file_exists\",\"exists\",\"count_lines\",\"line_count\",\"wc\",\"count\",\"file_outline\",\"outline\",\"list_symbols\",\"workspace_outline\",\"outline_many\",\"project_outline\",\"find_references\",\"find_all_references\",\"references\",\"find_usages\",\"find_implementations\",\"find_impl\",\"implementations\",\"find_definition\",\"goto_definition\",\"def\",\"lookup_symbol\",\"get_definition\",\"code_graph\",\"relation_graph\",\"symbol_graph\",\"repo_map\",\"repo-map\",\"get_diagnostics\",\"diagnostics\",\"check_syntax\",\"workspace_diagnostics\",\"analyze_scope\",\"scope_analysis\",\"git_status\",\"git-status\",\"git_diff\",\"git-diff\",\"git_log\",\"git-log\",\"split_plan\",\"split_status\"]"));
    let found: bool = mb_str_in_arr(set, mb_sp(&low), low.len, false);
    mb_free_doc(set);
    return found;
}
fn isMiniReadOnlyHostCommand(args: u64) -> bool {
    if args == 0 { return false; };
    let raw_exe = MbStr { bytes: [0u8; 8192], len: 0 };
    let has_exe: bool = mb_g_str(args, STR_PTR("exe"), STR_LEN("exe"), &raw_exe);
    let exe_t = MbStr { bytes: [0u8; 8192], len: 0 };
    mb_trim_to(mb_sp(&raw_exe), raw_exe.len, &exe_t);
    let exe_l = MbStr { bytes: [0u8; 8192], len: 0 };
    mb_lower_into(mb_sp(&exe_t), exe_t.len, &exe_l);
    // basename: split on / and \
    let base = MbStr { bytes: [0u8; 8192], len: 0 };
    let start: u64 = 0;
    let i: u64 = 0;
    while i < exe_l.len {
        let b: u8 = exe_l.bytes[i];
        i = i + 1;
        if b == 47 || b == 92 { start = i; };
    }
    mb_slice_to_s(mb_sp(&exe_l), exe_l.len, start, exe_l.len, &base);
    if mb_ends_with(mb_sp(&base), base.len, STR_PTR(".exe"), STR_LEN(".exe")) { base.len = base.len - 4; };
    let argv: u64 = mb_g_node(args, STR_PTR("args"), STR_LEN("args"));
    if base.len == 0 || argv == 0 || mb_kind(argv) != MB_JK_ARRAY || mb_n_count(argv) == 0 { return false; };
    if mb_s_eq(&base, STR_PTR("git"), STR_LEN("git")) {
        let git_set: u64 = mb_parse(STR_PTR("[\"branch\",\"describe\",\"diff\",\"log\",\"ls-files\",\"rev-parse\",\"show\",\"status\",\"tag\"]"), STR_LEN("[\"branch\",\"describe\",\"diff\",\"log\",\"ls-files\",\"rev-parse\",\"show\",\"status\",\"tag\"]"));
        let ac: u64 = mb_n_count(argv);
        let ai: u64 = 0;
        let found: bool = false;
        while ai < ac {
            let v = MbJson { bytes: [0u8; 262144], len: 0 };
            mb_str_of_node(mb_a_at(argv, ai), &v);
            ai = ai + 1;
            let vt = MbStr { bytes: [0u8; 8192], len: 0 };
            mb_trim_to(mb_jp(&v), v.len, &vt);
            let vl = MbStr { bytes: [0u8; 8192], len: 0 };
            mb_lower_into(mb_sp(&vt), vt.len, &vl);
            if mb_str_in_arr(git_set, mb_sp(&vl), vl.len, false) { found = true; };
        }
        mb_free_doc(git_set);
        return found;
    };
    let host_set: u64 = mb_parse(STR_PTR("[\"cat\",\"dir\",\"find\",\"grep\",\"head\",\"ls\",\"more\",\"pwd\",\"rg\",\"sort\",\"stat\",\"tail\",\"type\",\"uniq\",\"wc\",\"where\",\"which\"]"), STR_LEN("[\"cat\",\"dir\",\"find\",\"grep\",\"head\",\"ls\",\"more\",\"pwd\",\"rg\",\"sort\",\"stat\",\"tail\",\"type\",\"uniq\",\"wc\",\"where\",\"which\"]"));
    let found: bool = mb_str_in_arr(host_set, mb_sp(&base), base.len, false);
    mb_free_doc(host_set);
    return found;
}
fn mb_slice_to_s(p: ptr, n: u64, start: u64, end: u64, out: &MbStr) -> void {
    out.len = 0;
    let j = MbJson { bytes: [0u8; 262144], len: 0 };
    mb_slice_to(p, n, start as i64, end as i64, &j);
    mb_sassign_j(out, &j);
}
fn miniReadStallCorrection(reads: u64, out: &MbJson) -> void {
    out.len = 0;
    mb_jappend(out, STR_PTR("This turn has made "), STR_LEN("This turn has made "));
    let num = MbStr { bytes: [0u8; 8192], len: 0 };
    mb_u64_to_s(reads, &num);
    mb_jappend_s(out, &num);
    mb_jappend(out, STR_PTR(" consecutive read-only tool calls. If the relevant code is understood and a change is permitted, use sa_vm edit_file, write_file, or apply_patch next. Otherwise inspect only the missing evidence or report a concrete blocker; avoid repeating unchanged reads."), STR_LEN(" consecutive read-only tool calls. If the relevant code is understood and a change is permitted, use sa_vm edit_file, write_file, or apply_patch next. Otherwise inspect only the missing evidence or report a concrete blocker; avoid repeating unchanged reads."));
}
fn closeMiniOpenSegments(messages: u64, turn_p: ptr, turn_n: u64, status_p: ptr, status_n: u64, out_closed: &u64) -> void {
    let closed_total: u64 = 0;
    *out_closed = 0;
    if messages == 0 || mb_kind(messages) != MB_JK_ARRAY { return; };
    let count: u64 = mb_n_count(messages);
    let i: u64 = 0;
    while i < count {
        let m: u64 = mb_a_at(messages, i);
        i = i + 1;
        if m == 0 || mb_kind(m) != MB_JK_OBJECT { continue; };
        let tid = MbStr { bytes: [0u8; 8192], len: 0 };
        let has_tid: bool = mb_g_str(m, STR_PTR("turnId"), STR_LEN("turnId"), &tid);
        if !has_tid || !mb_s_eq(&tid, turn_p, turn_n) { continue; };
        let st = MbStr { bytes: [0u8; 8192], len: 0 };
        let has_st: bool = mb_g_str(m, STR_PTR("status"), STR_LEN("status"), &st);
        if !has_st || !mb_s_eq(&st, STR_PTR("inProgress"), STR_LEN("inProgress")) { continue; };
        let kind = MbJson { bytes: [0u8; 262144], len: 0 };
        mb_field_text(m, STR_PTR("type"), STR_LEN("type"), &kind);
        if !mb_j_eq(&kind, STR_PTR("agentMessage"), STR_LEN("agentMessage")) && !mb_j_eq(&kind, STR_PTR("reasoning"), STR_LEN("reasoning")) { continue; };
        let rc: i32 = mb_s_str(m, STR_PTR("status"), STR_LEN("status"), status_p, status_n);
        closed_total = closed_total + 1;
    }
    *out_closed = closed_total;
}
fn MINI_SUMMARY_TIMEOUT_MS() -> u64 { return 120000; }
// DEFECT(host): AbortSignal has no SLA surface (four-source check: no
// AbortSignal in sala docs, sla demos/tests, or sa_std); the timeout value
// is the carrier — hosts construct their own signal from it.
fn miniSummaryRequestSignalMs() -> u64 { return MINI_SUMMARY_TIMEOUT_MS(); }
// ---- retry family (TS:4020-4115) ----
fn MINI_STREAM_RETRY_MIN() -> u64 { return 5; }
fn MINI_STREAM_RETRY_MAX() -> u64 { return 100; }
fn MINI_STREAM_RETRY_DEFAULT() -> u64 { return 5; }
fn clampMiniStreamMaxRetries(v: u64) -> u64 {
    let parsed: f64 = 0.0;
    let have: bool = false;
    if v != 0 && (mb_kind(v) == MB_JK_INT || mb_kind(v) == MB_JK_FLOAT) { have = mb_n_f64(v, &parsed); } else {
        // Number(v): strings parse, other types stringify-then-parse (NaN mostly)
        let text = MbJson { bytes: [0u8; 262144], len: 0 };
        mb_str_of_node(v, &text);
        have = mb_parse_f64(mb_jp(&text), text.len, &parsed);
    };
    if !have || parsed != parsed { return MINI_STREAM_RETRY_DEFAULT(); };
    let rounded: f64 = mb_round_half(parsed);
    if rounded < MINI_STREAM_RETRY_MIN() as f64 { return MINI_STREAM_RETRY_MIN(); };
    if rounded > MINI_STREAM_RETRY_MAX() as f64 { return MINI_STREAM_RETRY_MAX(); };
    return rounded as u64;
}
fn isMiniRetryableStatus(status: i64) -> bool { return status == 408 || (status >= 500 && status <= 599); }
fn mb_terminal_quota_re_test(p: ptr, n: u64) -> bool {
    return mb_re_test(p, n, STR_PTR("insufficient_quota|quota[_ \t-]*(exceeded|exhausted|ran out)|billing|balance|欠费|余额|免费额度|daily free limit|free.*limit.*reached|invalid[_ \t-]*api[_ \t-]*key|incorrect api key|unauthorized|access[_ \t-]*denied|forbidden|account.*(deactiv|suspend|disabled)|permission denied|密钥无效|无权"), STR_LEN("insufficient_quota|quota[_ \t-]*(exceeded|exhausted|ran out)|billing|balance|欠费|余额|免费额度|daily free limit|free.*limit.*reached|invalid[_ \t-]*api[_ \t-]*key|incorrect api key|unauthorized|access[_ \t-]*denied|forbidden|account.*(deactiv|suspend|disabled)|permission denied|密钥无效|无权"), true);
}
fn isMiniTerminalQuotaError(text_p: ptr, text_n: u64) -> bool { return mb_terminal_quota_re_test(text_p, text_n); }
fn MINI_429_MAX_ATTEMPTS() -> u64 { return 5; }
fn MINI_RETRY_BASE_DELAY_MS() -> u64 { return 500; }
fn MINI_RETRY_MAX_DELAY_MS() -> u64 { return 10000; }
fn mini429DelayMs(retry_index: i64, retry_after_ms: f64, has_retry_after: bool) -> u64 {
    if has_retry_after && retry_after_ms == retry_after_ms && retry_after_ms >= 0.0 {
        let r: f64 = mb_round_half(retry_after_ms);
        if r > MINI_RETRY_MAX_DELAY_MS() as f64 { return MINI_RETRY_MAX_DELAY_MS(); };
        return r as u64;
    };
    let delays: [u64; 5] = [2000, 5000, 10000, 10000, 10000];
    let bounded: i64 = retry_index;
    if bounded < 0 { bounded = 0; };
    if bounded > 4 { bounded = 4; };
    return delays[bounded as u64];
}
fn miniRetryDelayMs(retry_index: i64, retry_after_ms: f64, has_retry_after: bool) -> u64 {
    if has_retry_after && retry_after_ms == retry_after_ms && retry_after_ms >= 0.0 {
        let r: f64 = mb_round_half(retry_after_ms);
        if r > MINI_RETRY_MAX_DELAY_MS() as f64 { return MINI_RETRY_MAX_DELAY_MS(); };
        return r as u64;
    };
    let idx: i64 = retry_index;
    if idx < 0 { idx = 0; };
    // 500 * 2^idx capped at 10000
    let delay: u64 = MINI_RETRY_BASE_DELAY_MS();
    let k: i64 = 0;
    while k < idx && delay < MINI_RETRY_MAX_DELAY_MS() { delay = delay * 2; k = k + 1; }
    if delay > MINI_RETRY_MAX_DELAY_MS() { return MINI_RETRY_MAX_DELAY_MS(); };
    return delay;
}
fn miniRetryAfterMs(headers: u64, has_headers: bool, body_p: ptr, body_n: u64, has_body: bool, now_ms: u64, out: &f64, out_has: &bool) -> void {
    *out = 0.0;
    *out_has = false;
    if has_headers && headers != 0 {
        let raw = MbStr { bytes: [0u8; 8192], len: 0 };
        let has_raw: bool = mb_g_str(headers, STR_PTR("retry-after"), STR_LEN("retry-after"), &raw);
        if !has_raw { has_raw = mb_g_str(headers, STR_PTR("Retry-After"), STR_LEN("Retry-After"), &raw); };
        if has_raw {
            let t = MbStr { bytes: [0u8; 8192], len: 0 };
            mb_trim_to(mb_sp(&raw), raw.len, &t);
            if t.len > 0 {
                let seconds: f64 = 0.0;
                if mb_parse_f64(mb_sp(&t), t.len, &seconds) {
                    let ms: f64 = mb_round_half(seconds * 1000.0);
                    if ms < 0.0 { ms = 0.0; };
                    *out = ms;
                    *out_has = true;
                    return;
                };
                // DEFECT(std): HTTP-date Date.parse has no sa_std surface
                // (date_parse_ms is a registered backends B-class gap);
                // unparsable dates fall through like a missing header.
            };
        };
        let raw_ms = MbStr { bytes: [0u8; 8192], len: 0 };
        let has_ms: bool = mb_g_str(headers, STR_PTR("retry-after-ms"), STR_LEN("retry-after-ms"), &raw_ms);
        if !has_ms { has_ms = mb_g_str(headers, STR_PTR("Retry-After-Ms"), STR_LEN("Retry-After-Ms"), &raw_ms); };
        if has_ms {
            let t = MbStr { bytes: [0u8; 8192], len: 0 };
            mb_trim_to(mb_sp(&raw_ms), raw_ms.len, &t);
            let ms: f64 = 0.0;
            if t.len > 0 && mb_parse_f64(mb_sp(&t), t.len, &ms) {
                let r: f64 = mb_round_half(ms);
                if r < 0.0 { r = 0.0; };
                *out = r;
                *out_has = true;
                return;
            };
        };
    };
    if has_body && body_n > 0 {
        let m: u64 = mb_re_match(body_p, body_n, STR_PTR("(try again|retry)( after| in)?[ \t]+([0-9]+(\\.[0-9]+)?)[ \t]*(ms|milliseconds?|s|seconds?)"), STR_LEN("(try again|retry)( after| in)?[ \t]+([0-9]+(\\.[0-9]+)?)[ \t]*(ms|milliseconds?|s|seconds?)"), true);
        if m != 0 {
            let num_s = MbStr { bytes: [0u8; 8192], len: 0 };
            let unit_s = MbStr { bytes: [0u8; 8192], len: 0 };
            let ok1: bool = mb_re_group(m, 3, &num_s);
            let ok2: bool = mb_re_group(m, 5, &unit_s);
            let value: f64 = 0.0;
            if ok1 && mb_parse_f64(mb_sp(&num_s), num_s.len, &value) {
                let is_ms: bool = mb_starts_with(mb_sp(&unit_s), unit_s.len, STR_PTR("ms"), STR_LEN("ms"));
                let ms: f64 = value;
                if !is_ms { ms = value * 1000.0; };
                let r: f64 = mb_round_half(ms);
                if r < 0.0 { r = 0.0; };
                *out = r;
                *out_has = true;
            };
            mb_re_free_match(m);
        };
    };
}
fn mb_retryable_message_re_test(p: ptr, n: u64) -> bool {
    return mb_re_test(p, n, STR_PTR("connection failed|error sending request|fetch failed|network|econnreset|etimedout|econnaborted|socket|stream connection failed|terminated|didn't complete gracefully|temporarily unavailable|bad gateway|service unavailable|gateway timeout|unexpected end of json|premature close|truncated|body used already|empty response|empty stream"), STR_LEN("connection failed|error sending request|fetch failed|network|econnreset|etimedout|econnaborted|socket|stream connection failed|terminated|didn't complete gracefully|temporarily unavailable|bad gateway|service unavailable|gateway timeout|unexpected end of json|premature close|truncated|body used already|empty response|empty stream"), true);
}
fn isMiniRetryableError(name_p: ptr, name_n: u64, msg_p: ptr, msg_n: u64) -> bool {
    if mb_re_test(name_p, name_n, STR_PTR("aborterror"), STR_LEN("aborterror"), true) { return false; };
    // TS also rejects DOMException AbortError/TimeoutError by name: covered by
    // the aborterror class above for "AbortError"; TimeoutError name alone is
    // not rejected upstream unless the message carries the abort signature.
    if mb_re_test(msg_p, msg_n, STR_PTR("abort|timeout|timed out"), STR_LEN("abort|timeout|timed out"), true) && mb_re_test(msg_p, msg_n, STR_PTR("abortsignal|the operation was aborted"), STR_LEN("abortsignal|the operation was aborted"), true) { return false; };
    return mb_retryable_message_re_test(msg_p, msg_n);
}
fn isMiniRoundStreamRetryable(msg_p: ptr, msg_n: u64, retries_exhausted: bool) -> bool {
    if mb_re_test(msg_p, msg_n, STR_PTR("relay unavailable|(chat|responses) [0-9]{3}[ \t]*:"), STR_LEN("relay unavailable|(chat|responses) [0-9]{3}[ \t]*:"), true) { return false; };
    if retries_exhausted { return false; };
    // err name is unavailable at this call shape; message-only classification.
    return mb_retryable_message_re_test(msg_p, msg_n);
}
fn mb_seg_index(id_p: ptr, id_n: u64, prefix_p: ptr, prefix_n: u64, out: &f64, matches: &bool, finite: &bool) -> void {
    *matches = false;
    *finite = false;
    *out = 0.0;
    if !mb_starts_with(id_p, id_n, prefix_p, prefix_n) { return; };
    *matches = true;
    let rest = MbStr { bytes: [0u8; 8192], len: 0 };
    mb_slice_to_s(id_p, id_n, prefix_n, id_n, &rest);
    // Number("") is 0 in JS; Number of non-numeric is NaN (not finite).
    if rest.len == 0 { *out = 0.0; *finite = true; return; };
    let v: f64 = 0.0;
    if mb_parse_f64(mb_sp(&rest), rest.len, &v) { *out = v; *finite = true; };
}
fn rollbackMiniRoundLiveSegments(messages: u64, base_p: ptr, base_n: u64, seg_index_before: f64, out: &u64) -> void {
    let kept: u64 = mb_new_arr();
    *out = kept;
    let prefix = MbJson { bytes: [0u8; 262144], len: 0 };
    mb_jappend(&prefix, base_p, base_n);
    mb_jappend(&prefix, STR_PTR("-s"), STR_LEN("-s"));
    let count: u64 = 0;
    if messages != 0 && mb_kind(messages) == MB_JK_ARRAY { count = mb_n_count(messages); };
    let i: u64 = 0;
    while i < count {
        let m: u64 = mb_a_at(messages, i);
        i = i + 1;
        if m == 0 || mb_kind(m) != MB_JK_OBJECT { let rc: i32 = mb_a_push_node(kept, mb_clone_node(m)); continue; };
        let id = MbJson { bytes: [0u8; 262144], len: 0 };
        mb_field_text(m, STR_PTR("id"), STR_LEN("id"), &id);
        let n: f64 = 0.0;
        let matches: bool = false;
        let finite: bool = false;
        mb_seg_index(mb_jp(&id), id.len, mb_jp(&prefix), prefix.len, &n, &matches, &finite);
        if !matches { let rc: i32 = mb_a_push_node(kept, mb_clone_node(m)); continue; };
        if finite && n > seg_index_before { continue; };
        let rc: i32 = mb_a_push_node(kept, mb_clone_node(m));
    }
}
fn miniRoundLiveSegmentIds(messages: u64, base_p: ptr, base_n: u64, seg_index_before: f64, out: &u64) -> void {
    let ids: u64 = mb_new_arr();
    *out = ids;
    let prefix = MbJson { bytes: [0u8; 262144], len: 0 };
    mb_jappend(&prefix, base_p, base_n);
    mb_jappend(&prefix, STR_PTR("-s"), STR_LEN("-s"));
    let count: u64 = 0;
    if messages != 0 && mb_kind(messages) == MB_JK_ARRAY { count = mb_n_count(messages); };
    let i: u64 = 0;
    while i < count {
        let m: u64 = mb_a_at(messages, i);
        i = i + 1;
        if m == 0 || mb_kind(m) != MB_JK_OBJECT { continue; };
        let id = MbJson { bytes: [0u8; 262144], len: 0 };
        mb_field_text(m, STR_PTR("id"), STR_LEN("id"), &id);
        let n: f64 = 0.0;
        let matches: bool = false;
        let finite: bool = false;
        mb_seg_index(mb_jp(&id), id.len, mb_jp(&prefix), prefix.len, &n, &matches, &finite);
        if matches && finite && n > seg_index_before { let rc: i32 = mb_a_push_str(ids, mb_jp(&id), id.len); };
    }
}
fn miniRoundStallTimeoutMs() -> u64 {
    let raw = MbStr { bytes: [0u8; 8192], len: 0 };
    let has: bool = mb_env_get(STR_PTR("MINI_STALL_TIMEOUT_MS"), STR_LEN("MINI_STALL_TIMEOUT_MS"), &raw);
    // Number("") is 0 in JS -> falls back; Number of the raw env string.
    let parsed: f64 = 0.0;
    let have: bool = false;
    if has { have = mb_parse_f64(mb_sp(&raw), raw.len, &parsed); };
    if have && parsed > 0.0 { return mb_round_half(parsed) as u64; };
    return 120000;
}
// Blocking-form sleep with abort polling (ASYNC_MODEL entry-snapshot +
// deadline-poll): returns false when the session abort flag fired.
fn sleepWithMiniAbort(ms: u64, session: u64) -> bool {
    let waited: u64 = 0;
    while waited < ms {
        if session != 0 {
            let aborted: bool = false;
            if mb_g_bool(session, STR_PTR("aborted"), STR_LEN("aborted"), &aborted) && aborted { return false; };
        };
        let step: u64 = ms - waited;
        if step > 10 { step = 10; };
        mb_sleep_ms(step);
        waited = waited + step;
    }
    if session != 0 {
        let aborted: bool = false;
        if mb_g_bool(session, STR_PTR("aborted"), STR_LEN("aborted"), &aborted) && aborted { return false; };
    };
    return true;
}
fn miniInterruptFromAbort(session: u64, err_p: ptr, err_n: u64, out: &MbJson, out_is_null: &bool) -> void {
    out.len = 0;
    *out_is_null = true;
    if session == 0 { return; };
    let aborted: bool = false;
    if !mb_g_bool(session, STR_PTR("aborted"), STR_LEN("aborted"), &aborted) || !aborted { return; };
    if mb_re_test(err_p, err_n, STR_PTR("abort|interrupted"), STR_LEN("abort|interrupted"), true) {
        mb_jassign(out, STR_PTR("interrupted"), STR_LEN("interrupted"));
        *out_is_null = false;
    };
}

// ---- compact transcript / anchors / upstream error (TS:4115-4230) ----
fn buildMiniCompactTranscript(messages: u64, limit: u64, out: &MbJson) -> void {
    out.len = 0;
    let tail: u64 = mb_new_arr();
    let used: u64 = 0;
    let count: u64 = 0;
    if messages != 0 && mb_kind(messages) == MB_JK_ARRAY { count = mb_n_count(messages); };
    let idx: u64 = count;
    while idx > 0 {
        idx = idx - 1;
        let text = MbJson { bytes: [0u8; 262144], len: 0 };
        historyItemToText(mb_a_at(messages, idx), 800, &text);
        let tt = MbStr { bytes: [0u8; 8192], len: 0 };
        mb_trim_to(mb_jp(&text), text.len, &tt);
        let trimmed = MbJson { bytes: [0u8; 262144], len: 0 };
        mb_jassign(&trimmed, mb_sp(&tt), tt.len);
        if trimmed.len > 800 { trimmed.len = 800; };
        if trimmed.len == 0 { continue; };
        if mb_n_count(tail) > 0 && used + trimmed.len + 1 > limit { break; };
        // unshift
        let next: u64 = mb_new_arr();
        let rc: i32 = mb_a_push_str(next, mb_jp(&trimmed), trimmed.len);
        let tc: u64 = mb_n_count(tail);
        let ti: u64 = 0;
        while ti < tc { rc = mb_a_push_node(next, mb_clone_node(mb_a_at(tail, ti))); ti = ti + 1; }
        mb_free_doc(tail);
        tail = next;
        used = used + trimmed.len + 1;
        if used >= limit { break; };
    }
    let joined = MbJson { bytes: [0u8; 262144], len: 0 };
    mb_lines_join(tail, &joined);
    mb_free_doc(tail);
    if joined.len > limit { joined.len = limit; };
    mb_jassign_j(out, &joined);
}
fn buildMiniCompactionAnchors(messages: u64, limit: u64, out: &MbJson) -> void {
    out.len = 0;
    let lines: u64 = mb_new_arr();
    let count: u64 = 0;
    if messages != 0 && mb_kind(messages) == MB_JK_ARRAY { count = mb_n_count(messages); };
    let i: u64 = 0;
    while i < count {
        let text = MbJson { bytes: [0u8; 262144], len: 0 };
        historyItemToText(mb_a_at(messages, i), 800, &text);
        i = i + 1;
        let tt = MbStr { bytes: [0u8; 8192], len: 0 };
        mb_trim_to(mb_jp(&text), text.len, &tt);
        if tt.len == 0 { continue; };
        let line = MbJson { bytes: [0u8; 262144], len: 0 };
        mb_jassign(&line, mb_sp(&tt), tt.len);
        if line.len > 1200 { line.len = 1200; };
        let rc: i32 = mb_a_push_str(lines, mb_jp(&line), line.len);
    }
    let full = MbJson { bytes: [0u8; 262144], len: 0 };
    mb_lines_join(lines, &full);
    if full.len <= limit { mb_free_doc(lines); mb_jassign_j(out, &full); return; };
    let head_limit: u64 = (limit * 3) / 5;
    let tail_limit: u64 = limit - head_limit;
    let head: u64 = mb_new_arr();
    let head_used: u64 = 0;
    let lc: u64 = mb_n_count(lines);
    let hi: u64 = 0;
    while hi < lc {
        let line = MbStr { bytes: [0u8; 8192], len: 0 };
        let ok: bool = mb_n_str(mb_a_at(lines, hi), &line);
        hi = hi + 1;
        if head_used + line.len + 1 > head_limit { break; };
        let rc: i32 = mb_a_push_str(head, mb_sp(&line), line.len);
        head_used = head_used + line.len + 1;
    }
    let tail_arr: u64 = mb_new_arr();
    let tail_used: u64 = 0;
    let ti: u64 = lc;
    while ti > 0 {
        ti = ti - 1;
        let line = MbStr { bytes: [0u8; 8192], len: 0 };
        let ok: bool = mb_n_str(mb_a_at(lines, ti), &line);
        if tail_used + line.len + 1 > tail_limit { break; };
        let next: u64 = mb_new_arr();
        let rc: i32 = mb_a_push_str(next, mb_sp(&line), line.len);
        let tc: u64 = mb_n_count(tail_arr);
        let tj: u64 = 0;
        while tj < tc { rc = mb_a_push_node(next, mb_clone_node(mb_a_at(tail_arr, tj))); tj = tj + 1; }
        mb_free_doc(tail_arr);
        tail_arr = next;
        tail_used = tail_used + line.len + 1;
    }
    mb_free_doc(lines);
    mb_lines_join(head, out);
    mb_free_doc(head);
    mb_jappend(out, STR_PTR("\n[middle history omitted from durable anchors]"), STR_LEN("\n[middle history omitted from durable anchors]"));
    let tail_text = MbJson { bytes: [0u8; 262144], len: 0 };
    mb_lines_join(tail_arr, &tail_text);
    mb_free_doc(tail_arr);
    if tail_text.len > 0 {
        mb_jappend(out, STR_PTR("\n"), STR_LEN("\n"));
        mb_jappend(out, mb_jp(&tail_text), tail_text.len);
    };
    if out.len > limit { out.len = limit; };
}
fn formatMiniUpstreamError(raw_p: ptr, raw_n: u64, max_retries: u64, out: &MbJson) -> void {
    out.len = 0;
    let take: u64 = raw_n;
    if take > 500 { take = 500; };
    mb_jappend(out, raw_p, take);
    if mb_terminal_quota_re_test(mb_jp(out), out.len) {
        mb_jappend(out, STR_PTR("\n该中转站免费额度已用完或密钥无权：可切换模型/分组后直接重发继续对话，或稍后再试。本轮历史未被污染，重发不会带上错误内容。"), STR_LEN("\n该中转站免费额度已用完或密钥无权：可切换模型/分组后直接重发继续对话，或稍后再试。本轮历史未被污染，重发不会带上错误内容。"));
        return;
    };
    if mb_re_test(mb_jp(out), out.len, STR_PTR("rate[_ \t-]*limit|too many requests|(^|[^0-9])429([^0-9]|$)"), STR_LEN("rate[_ \t-]*limit|too many requests|(^|[^0-9])429([^0-9]|$)"), true) {
        mb_jappend(out, STR_PTR("\n上游限流（429），已自动重试仍未恢复：可稍后直接重发再试一次，或切换分组/模型。本轮历史未被污染，重发不会带上错误内容。"), STR_LEN("\n上游限流（429），已自动重试仍未恢复：可稍后直接重发再试一次，或切换分组/模型。本轮历史未被污染，重发不会带上错误内容。"));
        return;
    };
    if mb_re_test(mb_jp(out), out.len, STR_PTR("relay unavailable|502|503"), STR_LEN("relay unavailable|502|503"), true) {
        mb_jappend(out, STR_PTR("\n中转暂不可用（已按该中转站配置重试 "), STR_LEN("\n中转暂不可用（已按该中转站配置重试 "));
        let num = MbStr { bytes: [0u8; 8192], len: 0 };
        mb_u64_to_s(max_retries, &num);
        mb_jappend_s(out, &num);
        mb_jappend(out, STR_PTR(" 次）：可直接重发再试一次。本轮历史未被污染，重发不会带上错误内容。"), STR_LEN(" 次）：可直接重发再试一次。本轮历史未被污染，重发不会带上错误内容。"));
        return;
    };
}
// ---- review family (TS:4232-4330) ----
fn parseMiniReviewTarget(value: u64, out: &u64) -> void {
    if value != 0 && mb_kind(value) == MB_JK_OBJECT {
        let kind_text = MbJson { bytes: [0u8; 262144], len: 0 };
        mb_field_text(value, STR_PTR("type"), STR_LEN("type"), &kind_text);
        if kind_text.len == 0 { mb_field_text(value, STR_PTR("kind"), STR_LEN("kind"), &kind_text); };
        let kind = MbStr { bytes: [0u8; 8192], len: 0 };
        let kt = MbStr { bytes: [0u8; 8192], len: 0 };
        mb_trim_to(mb_jp(&kind_text), kind_text.len, &kt);
        mb_lower_into(mb_sp(&kt), kt.len, &kind);
        if mb_s_eq(&kind, STR_PTR("uncommittedchanges"), STR_LEN("uncommittedchanges")) || mb_s_eq(&kind, STR_PTR("uncommitted"), STR_LEN("uncommitted")) || mb_s_eq(&kind, STR_PTR("changes"), STR_LEN("changes")) || kind.len == 0 {
            *out = mb_parse(STR_PTR("{\"type\":\"uncommittedChanges\"}"), STR_LEN("{\"type\":\"uncommittedChanges\"}"));
            return;
        };
        if mb_s_eq(&kind, STR_PTR("basebranch"), STR_LEN("basebranch")) || mb_s_eq(&kind, STR_PTR("branch"), STR_LEN("branch")) || mb_s_eq(&kind, STR_PTR("base"), STR_LEN("base")) {
            let branch = MbJson { bytes: [0u8; 262144], len: 0 };
            mb_field_text(value, STR_PTR("branch"), STR_LEN("branch"), &branch);
            let bt = MbStr { bytes: [0u8; 8192], len: 0 };
            mb_trim_to(mb_jp(&branch), branch.len, &bt);
            if bt.len > 0 {
                let obj: u64 = mb_new_obj();
                let rc: i32 = mb_s_str(obj, STR_PTR("type"), STR_LEN("type"), STR_PTR("baseBranch"), STR_LEN("baseBranch"));
                rc = mb_s_str(obj, STR_PTR("branch"), STR_LEN("branch"), mb_jp(&branch), branch.len);
                *out = obj;
                return;
            };
            *out = mb_parse(STR_PTR("{\"type\":\"uncommittedChanges\"}"), STR_LEN("{\"type\":\"uncommittedChanges\"}"));
            return;
        };
        if mb_s_eq(&kind, STR_PTR("commit"), STR_LEN("commit")) {
            let sha = MbJson { bytes: [0u8; 262144], len: 0 };
            mb_field_text(value, STR_PTR("sha"), STR_LEN("sha"), &sha);
            let st = MbStr { bytes: [0u8; 8192], len: 0 };
            mb_trim_to(mb_jp(&sha), sha.len, &st);
            if st.len > 0 {
                let obj: u64 = mb_new_obj();
                let rc: i32 = mb_s_str(obj, STR_PTR("type"), STR_LEN("type"), STR_PTR("commit"), STR_LEN("commit"));
                rc = mb_s_str(obj, STR_PTR("sha"), STR_LEN("sha"), mb_jp(&sha), sha.len);
                let title_node: u64 = mb_g_node(value, STR_PTR("title"), STR_LEN("title"));
                if title_node == 0 || mb_kind(title_node) == MB_JK_NULL {
                    rc = mb_s_null(obj, STR_PTR("title"), STR_LEN("title"));
                } else {
                    let title = MbJson { bytes: [0u8; 262144], len: 0 };
                    mb_field_text(value, STR_PTR("title"), STR_LEN("title"), &title);
                    let tt = MbStr { bytes: [0u8; 8192], len: 0 };
                    mb_trim_to(mb_jp(&title), title.len, &tt);
                    if tt.len > 0 { rc = mb_s_str(obj, STR_PTR("title"), STR_LEN("title"), mb_jp(&title), title.len); } else { rc = mb_s_null(obj, STR_PTR("title"), STR_LEN("title")); };
                };
                *out = obj;
                return;
            };
            *out = mb_parse(STR_PTR("{\"type\":\"uncommittedChanges\"}"), STR_LEN("{\"type\":\"uncommittedChanges\"}"));
            return;
        };
        let instructions = MbJson { bytes: [0u8; 262144], len: 0 };
        mb_field_text(value, STR_PTR("instructions"), STR_LEN("instructions"), &instructions);
        if instructions.len == 0 { mb_field_text(value, STR_PTR("value"), STR_LEN("value"), &instructions); };
        if instructions.len == 0 { mb_field_text(value, STR_PTR("text"), STR_LEN("text"), &instructions); };
        if instructions.len == 0 { mb_field_text(value, STR_PTR("prompt"), STR_LEN("prompt"), &instructions); };
        let it = MbStr { bytes: [0u8; 8192], len: 0 };
        mb_trim_to(mb_jp(&instructions), instructions.len, &it);
        if it.len > 0 {
            let obj: u64 = mb_new_obj();
            let rc: i32 = mb_s_str(obj, STR_PTR("type"), STR_LEN("type"), STR_PTR("custom"), STR_LEN("custom"));
            rc = mb_s_str(obj, STR_PTR("instructions"), STR_LEN("instructions"), mb_jp(&instructions), instructions.len);
            *out = obj;
            return;
        };
        *out = mb_parse(STR_PTR("{\"type\":\"uncommittedChanges\"}"), STR_LEN("{\"type\":\"uncommittedChanges\"}"));
        return;
    };
    let rest = MbJson { bytes: [0u8; 262144], len: 0 };
    mb_str_of_node(value, &rest);
    let rest_t = MbStr { bytes: [0u8; 8192], len: 0 };
    mb_trim_to(mb_jp(&rest), rest.len, &rest_t);
    let normalized = MbStr { bytes: [0u8; 8192], len: 0 };
    mb_lower_into(mb_sp(&rest_t), rest_t.len, &normalized);
    if rest_t.len == 0 || mb_s_eq(&normalized, STR_PTR("changes"), STR_LEN("changes")) || mb_s_eq(&normalized, STR_PTR("uncommitted"), STR_LEN("uncommitted")) || mb_s_eq(&normalized, STR_PTR("uncommitted changes"), STR_LEN("uncommitted changes")) {
        *out = mb_parse(STR_PTR("{\"type\":\"uncommittedChanges\"}"), STR_LEN("{\"type\":\"uncommittedChanges\"}"));
        return;
    };
    let bm: u64 = mb_re_match(mb_sp(&rest_t), rest_t.len, STR_PTR("^(branch|base|base-branch)[ \t]+(.+)$"), STR_LEN("^(branch|base|base-branch)[ \t]+(.+)$"), true);
    if bm != 0 {
        let branch = MbStr { bytes: [0u8; 8192], len: 0 };
        let ok: bool = mb_re_group(bm, 2, &branch);
        mb_re_free_match(bm);
        let bt = MbStr { bytes: [0u8; 8192], len: 0 };
        mb_trim_to(mb_sp(&branch), branch.len, &bt);
        if bt.len > 0 {
            let obj: u64 = mb_new_obj();
            let rc: i32 = mb_s_str(obj, STR_PTR("type"), STR_LEN("type"), STR_PTR("baseBranch"), STR_LEN("baseBranch"));
            rc = mb_s_str(obj, STR_PTR("branch"), STR_LEN("branch"), mb_sp(&branch), branch.len);
            *out = obj;
            return;
        };
    };
    let cm: u64 = mb_re_match(mb_sp(&rest_t), rest_t.len, STR_PTR("^commit[ \t]+([0-9a-fA-F]{6,64})([ \t]+(.+))?$"), STR_LEN("^commit[ \t]+([0-9a-fA-F]{6,64})([ \t]+(.+))?$"), true);
    if cm != 0 {
        let sha = MbStr { bytes: [0u8; 8192], len: 0 };
        let title = MbStr { bytes: [0u8; 8192], len: 0 };
        let ok1: bool = mb_re_group(cm, 1, &sha);
        let ok2: bool = mb_re_group(cm, 3, &title);
        mb_re_free_match(cm);
        let obj: u64 = mb_new_obj();
        let rc: i32 = mb_s_str(obj, STR_PTR("type"), STR_LEN("type"), STR_PTR("commit"), STR_LEN("commit"));
        rc = mb_s_str(obj, STR_PTR("sha"), STR_LEN("sha"), mb_sp(&sha), sha.len);
        let tt = MbStr { bytes: [0u8; 8192], len: 0 };
        mb_trim_to(mb_sp(&title), title.len, &tt);
        if tt.len > 0 { rc = mb_s_str(obj, STR_PTR("title"), STR_LEN("title"), mb_sp(&title), title.len); } else { rc = mb_s_null(obj, STR_PTR("title"), STR_LEN("title")); };
        *out = obj;
        return;
    };
    let obj: u64 = mb_new_obj();
    let rc: i32 = mb_s_str(obj, STR_PTR("type"), STR_LEN("type"), STR_PTR("custom"), STR_LEN("custom"));
    rc = mb_s_str(obj, STR_PTR("instructions"), STR_LEN("instructions"), mb_jp(&rest), rest.len);
    *out = obj;
}
fn miniReviewTargetLabel(target: u64, out: &MbJson) -> void {
    out.len = 0;
    let ty = MbStr { bytes: [0u8; 8192], len: 0 };
    if target != 0 { let ok: bool = mb_g_str(target, STR_PTR("type"), STR_LEN("type"), &ty); };
    if mb_s_eq(&ty, STR_PTR("baseBranch"), STR_LEN("baseBranch")) {
        let branch = MbStr { bytes: [0u8; 8192], len: 0 };
        let ok: bool = mb_g_str(target, STR_PTR("branch"), STR_LEN("branch"), &branch);
        mb_jappend(out, STR_PTR("changes against '"), STR_LEN("changes against '"));
        mb_jappend_s(out, &branch);
        mb_jappend(out, STR_PTR("'"), STR_LEN("'"));
        return;
    };
    if mb_s_eq(&ty, STR_PTR("commit"), STR_LEN("commit")) {
        let sha = MbStr { bytes: [0u8; 8192], len: 0 };
        let ok: bool = mb_g_str(target, STR_PTR("sha"), STR_LEN("sha"), &sha);
        let title = MbStr { bytes: [0u8; 8192], len: 0 };
        let has_title: bool = mb_g_str(target, STR_PTR("title"), STR_LEN("title"), &title);
        mb_jappend(out, STR_PTR("commit "), STR_LEN("commit "));
        let take: u64 = sha.len;
        if take > 7 { take = 7; };
        mb_jappend(out, mb_sp(&sha), take);
        if has_title {
            mb_jappend(out, STR_PTR(": "), STR_LEN(": "));
            mb_jappend_s(out, &title);
        };
        return;
    };
    if mb_s_eq(&ty, STR_PTR("custom"), STR_LEN("custom")) {
        let ins = MbStr { bytes: [0u8; 8192], len: 0 };
        let ok: bool = mb_g_str(target, STR_PTR("instructions"), STR_LEN("instructions"), &ins);
        let take: u64 = ins.len;
        if take > 120 { take = 120; };
        mb_jappend(out, mb_sp(&ins), take);
        return;
    };
    mb_jappend(out, STR_PTR("uncommitted changes"), STR_LEN("uncommitted changes"));
}
fn mb_review_rubric(out: &MbJson) -> void {
    out.len = 0;
    mb_jappend(out, STR_PTR("You are acting as a code reviewer for a proposed change made by another engineer. Review the change, do NOT implement anything."), STR_LEN("You are acting as a code reviewer for a proposed change made by another engineer. Review the change, do NOT implement anything."));
    mb_jappend(out, STR_PTR("\nRules: read-only review - use sa_vm read/list/grep plus native git_status/git_diff and image_view for local images only (run_host exe allowlist is bun/node/python/zig/git - destructive git reset --hard/clean/revert is blocked there only when VM safe exec interception is on; prefer git_status/git_diff for status/diff); never write, edit, commit files, never bypass via python -c / bun -e / temp scripts / .git internals."), STR_LEN("\nRules: read-only review - use sa_vm read/list/grep plus native git_status/git_diff and image_view for local images only (run_host exe allowlist is bun/node/python/zig/git - destructive git reset --hard/clean/revert is blocked there only when VM safe exec interception is on; prefer git_status/git_diff for status/diff); never write, edit, commit files, never bypass via python -c / bun -e / temp scripts / .git internals."));
    mb_jappend(out, STR_PTR("\nFlag an issue only when it meaningfully impacts accuracy, performance, security, or maintainability; it is discrete and actionable; it was introduced by this change (never flag pre-existing issues); and it does not rely on unstated assumptions - cite the affected code as evidence, no speculation."), STR_LEN("\nFlag an issue only when it meaningfully impacts accuracy, performance, security, or maintainability; it is discrete and actionable; it was introduced by this change (never flag pre-existing issues); and it does not rely on unstated assumptions - cite the affected code as evidence, no speculation."));
    mb_jappend(out, STR_PTR("\nEach finding gets one comment: severity, file:line, why it is a bug, and the scenario needed to trigger it. Keep each finding to one short paragraph, matter-of-fact tone."), STR_LEN("\nEach finding gets one comment: severity, file:line, why it is a bug, and the scenario needed to trigger it. Keep each finding to one short paragraph, matter-of-fact tone."));
    mb_jappend(out, STR_PTR("\nUse ```suggestion blocks ONLY for concrete minimal replacement code, preserving exact leading whitespace."), STR_LEN("\nUse ```suggestion blocks ONLY for concrete minimal replacement code, preserving exact leading whitespace."));
    mb_jappend(out, STR_PTR("\nOutput: one scope line, then prioritized findings. If nothing meets the bar, say so plainly instead of inventing findings."), STR_LEN("\nOutput: one scope line, then prioritized findings. If nothing meets the bar, say so plainly instead of inventing findings."));
}
fn buildMiniReviewPrompt(target: u64, out: &MbJson) -> void {
    out.len = 0;
    let ty = MbStr { bytes: [0u8; 8192], len: 0 };
    if target != 0 { let ok: bool = mb_g_str(target, STR_PTR("type"), STR_LEN("type"), &ty); };
    let target_prompt = MbJson { bytes: [0u8; 262144], len: 0 };
    if mb_s_eq(&ty, STR_PTR("baseBranch"), STR_LEN("baseBranch")) {
        let branch = MbStr { bytes: [0u8; 8192], len: 0 };
        let ok: bool = mb_g_str(target, STR_PTR("branch"), STR_LEN("branch"), &branch);
        mb_jappend(&target_prompt, STR_PTR("Review the code changes against the base branch '"), STR_LEN("Review the code changes against the base branch '"));
        mb_jappend_s(&target_prompt, &branch);
        mb_jappend(&target_prompt, STR_PTR("'. Use sa_vm git_diff for the uncommitted range (prefer the native git_diff action; destructive git via run_host is blocked only when VM safe exec interception is on). Provide prioritized, actionable findings."), STR_LEN("'. Use sa_vm git_diff for the uncommitted range (prefer the native git_diff action; destructive git via run_host is blocked only when VM safe exec interception is on). Provide prioritized, actionable findings."));
    } else if mb_s_eq(&ty, STR_PTR("commit"), STR_LEN("commit")) {
        let sha = MbStr { bytes: [0u8; 8192], len: 0 };
        let ok: bool = mb_g_str(target, STR_PTR("sha"), STR_LEN("sha"), &sha);
        let title = MbStr { bytes: [0u8; 8192], len: 0 };
        let has_title: bool = mb_g_str(target, STR_PTR("title"), STR_LEN("title"), &title);
        mb_jappend(&target_prompt, STR_PTR("Review the code changes introduced by commit "), STR_LEN("Review the code changes introduced by commit "));
        mb_jappend_s(&target_prompt, &sha);
        if has_title {
            mb_jappend(&target_prompt, STR_PTR(" (\""), STR_LEN(" (\""));
            mb_jappend_s(&target_prompt, &title);
            mb_jappend(&target_prompt, STR_PTR("\")"), STR_LEN("\")"));
        };
        mb_jappend(&target_prompt, STR_PTR(". Use sa_vm git_diff with stat_only for the overview, then git_diff for the full diff (prefer the native git_diff action; destructive git via run_host is blocked only when VM safe exec interception is on). Provide prioritized, actionable findings."), STR_LEN(". Use sa_vm git_diff with stat_only for the overview, then git_diff for the full diff (prefer the native git_diff action; destructive git via run_host is blocked only when VM safe exec interception is on). Provide prioritized, actionable findings."));
    } else if mb_s_eq(&ty, STR_PTR("custom"), STR_LEN("custom")) {
        let ins = MbStr { bytes: [0u8; 8192], len: 0 };
        let ok: bool = mb_g_str(target, STR_PTR("instructions"), STR_LEN("instructions"), &ins);
        mb_jappend_s(&target_prompt, &ins);
    } else {
        mb_jappend(&target_prompt, STR_PTR("Review the current uncommitted changes (staged, unstaged, and untracked files). Start with sa_vm git_status, then sa_vm git_diff (native read-only git actions - prefer them over run_host for status/diff), and read untracked files with sa_vm read_file. Provide prioritized, actionable findings."), STR_LEN("Review the current uncommitted changes (staged, unstaged, and untracked files). Start with sa_vm git_status, then sa_vm git_diff (native read-only git actions - prefer them over run_host for status/diff), and read untracked files with sa_vm read_file. Provide prioritized, actionable findings."));
    };
    mb_review_rubric(out);
    mb_jappend(out, STR_PTR("\n\n"), STR_LEN("\n\n"));
    mb_jappend(out, mb_jp(&target_prompt), target_prompt.len);
}
fn mb_fmt_value(v: u64, out: &MbJson) -> void {
    out.len = 0;
    if v != 0 && mb_kind(v) == MB_JK_STRING { let ok: bool = mb_n_str_j(v, out); } else if v != 0 { let ok: bool = mb_stringify_node(v, out); };
    if out.len > 8000 { out.len = 8000; };
}
// ---- patch touched files + auto-verify (TS:4332-4390) ----
fn miniPatchTouchedFiles(patch: u64, limit: u64, out: &u64) -> void {
    let files: u64 = mb_new_arr();
    *out = files;
    if patch == 0 || mb_kind(patch) != MB_JK_STRING { return; };
    let text = MbJson { bytes: [0u8; 262144], len: 0 };
    let ok: bool = mb_n_str_j(patch, &text);
    let lines_text = MbJson { bytes: [0u8; 262144], len: 0 };
    mb_split_on(mb_jp(&text), text.len, STR_PTR("\n"), STR_LEN("\n"), &lines_text);
    let lines: u64 = mb_parse(mb_jp(&lines_text), lines_text.len);
    if lines == 0 { return; };
    let seen: u64 = mb_new_arr();
    let count: u64 = mb_n_count(lines);
    let i: u64 = 0;
    while i < count {
        if mb_n_count(files) >= limit { break; };
        let line = MbStr { bytes: [0u8; 8192], len: 0 };
        let ok2: bool = mb_n_str(mb_a_at(lines, i), &line);
        i = i + 1;
        let t = MbStr { bytes: [0u8; 8192], len: 0 };
        mb_trim_to(mb_sp(&line), line.len, &t);
        let p = MbStr { bytes: [0u8; 8192], len: 0 };
        let matched: bool = false;
        if mb_starts_with(mb_sp(&t), t.len, STR_PTR("*** Add File:"), STR_LEN("*** Add File:")) { mb_slice_to_s(mb_sp(&t), t.len, 13, t.len, &p); matched = true; } else if mb_starts_with(mb_sp(&t), t.len, STR_PTR("*** Update File:"), STR_LEN("*** Update File:")) { mb_slice_to_s(mb_sp(&t), t.len, 16, t.len, &p); matched = true; } else if mb_starts_with(mb_sp(&t), t.len, STR_PTR("*** Move to:"), STR_LEN("*** Move to:")) { mb_slice_to_s(mb_sp(&t), t.len, 12, t.len, &p); matched = true; };
        if !matched { continue; };
        let pt = MbStr { bytes: [0u8; 8192], len: 0 };
        mb_trim_to(mb_sp(&p), p.len, &pt);
        if pt.len == 0 || mb_str_in_arr(seen, mb_sp(&pt), pt.len, false) { continue; };
        let rc: i32 = mb_a_push_str(seen, mb_sp(&pt), pt.len);
        rc = mb_a_push_str(files, mb_sp(&pt), pt.len);
    }
    mb_free_doc(seen);
    mb_free_doc(lines);
}
fn miniAutoVerifyTargets(action: u64, args: u64, stdout_p: ptr, stdout_n: u64, out: &u64) -> void {
    let empty: u64 = mb_new_arr();
    *out = empty;
    let gate = MbStr { bytes: [0u8; 8192], len: 0 };
    if mb_env_get(STR_PTR("SA_VM_MINI_AUTO_VERIFY"), STR_LEN("SA_VM_MINI_AUTO_VERIFY"), &gate) && mb_s_eq(&gate, STR_PTR("false"), STR_LEN("false")) { return; };
    let act_text = MbJson { bytes: [0u8; 262144], len: 0 };
    mb_str_of_node(action, &act_text);
    let act_t = MbStr { bytes: [0u8; 8192], len: 0 };
    mb_trim_to(mb_jp(&act_text), act_text.len, &act_t);
    let act = MbStr { bytes: [0u8; 8192], len: 0 };
    mb_lower_into(mb_sp(&act_t), act_t.len, &act);
    if mb_s_eq(&act, STR_PTR("edit"), STR_LEN("edit")) || mb_s_eq(&act, STR_PTR("edit_file"), STR_LEN("edit_file")) || mb_s_eq(&act, STR_PTR("write"), STR_LEN("write")) || mb_s_eq(&act, STR_PTR("write_file"), STR_LEN("write_file")) {
        if !mb_starts_with(stdout_p, stdout_n, STR_PTR("Successfully edited"), STR_LEN("Successfully edited")) && !mb_starts_with(stdout_p, stdout_n, STR_PTR("Successfully wrote"), STR_LEN("Successfully wrote")) { return; };
        let keys: [ptr; 3] = [STR_PTR("path"), STR_PTR("file"), STR_PTR("target")];
        let lens: [u64; 3] = [STR_LEN("path"), STR_LEN("file"), STR_LEN("target")];
        let ki: u64 = 0;
        while ki < 3 {
            let v: u64 = mb_g_node(args, keys[ki], lens[ki]);
            ki = ki + 1;
            if v != 0 && mb_kind(v) == MB_JK_STRING {
                let s = MbStr { bytes: [0u8; 8192], len: 0 };
                let ok: bool = mb_n_str(v, &s);
                let t = MbStr { bytes: [0u8; 8192], len: 0 };
                mb_trim_to(mb_sp(&s), s.len, &t);
                if t.len > 0 { let rc: i32 = mb_a_push_str(empty, mb_sp(&s), s.len); return; };
            };
        }
        return;
    };
    if mb_s_eq(&act, STR_PTR("apply_patch"), STR_LEN("apply_patch")) || mb_s_eq(&act, STR_PTR("patch"), STR_LEN("patch")) {
        if !mb_starts_with(stdout_p, stdout_n, STR_PTR("Successfully applied"), STR_LEN("Successfully applied")) { return; };
        let patch_node: u64 = mb_g_node(args, STR_PTR("patch"), STR_LEN("patch"));
        if patch_node == 0 || mb_kind(patch_node) == MB_JK_NULL { patch_node = mb_g_node(args, STR_PTR("diff"), STR_LEN("diff")); };
        if patch_node == 0 || mb_kind(patch_node) == MB_JK_NULL { patch_node = mb_g_node(args, STR_PTR("content"), STR_LEN("content")); };
        mb_free_doc(empty);
        miniPatchTouchedFiles(patch_node, 5, out);
        return;
    };
}
fn miniAutoVerifyTarget(action: u64, args: u64, stdout_p: ptr, stdout_n: u64, out: &MbStr, out_is_null: &bool) -> void {
    out.len = 0;
    *out_is_null = true;
    let targets: u64 = 0;
    miniAutoVerifyTargets(action, args, stdout_p, stdout_n, &targets);
    if mb_n_count(targets) > 0 {
        let ok: bool = mb_n_str(mb_a_at(targets, 0), out);
        *out_is_null = false;
    };
    mb_free_doc(targets);
}
// ---- dedupe / unique id / sanitize (TS:4392-4560) ----
fn dedupeMiniToolCalls(calls: u64, out: &u64) -> void {
    let result: u64 = mb_new_arr();
    *out = result;
    let seen: u64 = mb_new_arr();
    let count: u64 = 0;
    if calls != 0 && mb_kind(calls) == MB_JK_ARRAY { count = mb_n_count(calls); };
    let i: u64 = 0;
    while i < count {
        let c: u64 = mb_a_at(calls, i);
        i = i + 1;
        let id = MbJson { bytes: [0u8; 262144], len: 0 };
        if c != 0 && mb_kind(c) == MB_JK_OBJECT { mb_field_text(c, STR_PTR("callId"), STR_LEN("callId"), &id); };
        if id.len == 0 || mb_str_in_arr(seen, mb_jp(&id), id.len, false) { continue; };
        let rc: i32 = mb_a_push_str(seen, mb_jp(&id), id.len);
        rc = mb_a_push_node(result, mb_clone_node(c));
    }
    mb_free_doc(seen);
}
fn uniqueMiniCallId(raw: u64, issued: u64, round: u64, out: &MbStr, out_is_null: &bool) -> void {
    out.len = 0;
    *out_is_null = true;
    let id = MbJson { bytes: [0u8; 262144], len: 0 };
    mb_str_of_node(raw, &id);
    if id.len == 0 || mb_str_in_arr(round, mb_jp(&id), id.len, false) { return; };
    if mb_str_in_arr(issued, mb_jp(&id), id.len, false) {
        let fresh = MbStr { bytes: [0u8; 8192], len: 0 };
        mb_new_uuid(&fresh);
        let rc: i32 = mb_a_push_str(round, mb_sp(&fresh), fresh.len);
        rc = mb_a_push_str(issued, mb_sp(&fresh), fresh.len);
        mb_sassign_s2(out, &fresh);
        *out_is_null = false;
        return;
    };
    let rc: i32 = mb_a_push_str(round, mb_jp(&id), id.len);
    rc = mb_a_push_str(issued, mb_jp(&id), id.len);
    mb_sassign_j(out, &id);
    *out_is_null = false;
}
fn mb_call_key(it: u64, out: &MbJson) -> void {
    out.len = 0;
    if it == 0 || mb_kind(it) != MB_JK_OBJECT { return; };
    mb_field_text(it, STR_PTR("call_id"), STR_LEN("call_id"), out);
    if out.len == 0 {
        let node: u64 = mb_g_node(it, STR_PTR("call_id"), STR_LEN("call_id"));
        // String(it.call_id ?? it.id ?? ""): call_id present-but-empty stays ""
        if node != 0 { return; };
        mb_field_text(it, STR_PTR("id"), STR_LEN("id"), out);
    };
}
fn sanitizeMiniResponsesInput(input: u64, out: &u64) -> void {
    let result: u64 = mb_new_arr();
    *out = result;
    let seen_call: u64 = mb_new_arr();
    let seen_output: u64 = mb_new_arr();
    let count: u64 = 0;
    if input != 0 && mb_kind(input) == MB_JK_ARRAY { count = mb_n_count(input); };
    let i: u64 = 0;
    while i < count {
        let it: u64 = mb_a_at(input, i);
        i = i + 1;
        let ty = MbJson { bytes: [0u8; 262144], len: 0 };
        if it != 0 && mb_kind(it) == MB_JK_OBJECT { mb_field_text(it, STR_PTR("type"), STR_LEN("type"), &ty); };
        let is_call: bool = mb_j_eq(&ty, STR_PTR("function_call"), STR_LEN("function_call")) || mb_j_eq(&ty, STR_PTR("custom_tool_call"), STR_LEN("custom_tool_call"));
        let is_output: bool = mb_j_eq(&ty, STR_PTR("function_call_output"), STR_LEN("function_call_output")) || mb_j_eq(&ty, STR_PTR("custom_tool_call_output"), STR_LEN("custom_tool_call_output"));
        if is_call {
            let id = MbJson { bytes: [0u8; 262144], len: 0 };
            mb_call_key(it, &id);
            if id.len == 0 || mb_str_in_arr(seen_call, mb_jp(&id), id.len, false) { continue; };
            let rc: i32 = mb_a_push_str(seen_call, mb_jp(&id), id.len);
            rc = mb_a_push_node(result, mb_clone_node(it));
            continue;
        };
        if is_output {
            let id = MbJson { bytes: [0u8; 262144], len: 0 };
            mb_call_key(it, &id);
            if id.len == 0 || mb_str_in_arr(seen_output, mb_jp(&id), id.len, false) { continue; };
            let rc: i32 = mb_a_push_str(seen_output, mb_jp(&id), id.len);
            rc = mb_a_push_node(result, mb_clone_node(it));
            continue;
        };
        let rc: i32 = mb_a_push_node(result, mb_clone_node(it));
    }
    // filter: outputs whose call was never seen are dropped
    let filtered: u64 = mb_new_arr();
    let rc2: i32 = mb_s_node_str(filtered, result, seen_call);
    mb_free_doc(result);
    mb_free_doc(seen_call);
    mb_free_doc(seen_output);
    *out = filtered;
}
fn mb_s_node_str(filtered: u64, result: u64, seen_call: u64) -> i32 {
    let count: u64 = mb_n_count(result);
    let i: u64 = 0;
    while i < count {
        let it: u64 = mb_a_at(result, i);
        i = i + 1;
        let ty = MbJson { bytes: [0u8; 262144], len: 0 };
        if it != 0 && mb_kind(it) == MB_JK_OBJECT { mb_field_text(it, STR_PTR("type"), STR_LEN("type"), &ty); };
        let is_output: bool = mb_j_eq(&ty, STR_PTR("function_call_output"), STR_LEN("function_call_output")) || mb_j_eq(&ty, STR_PTR("custom_tool_call_output"), STR_LEN("custom_tool_call_output"));
        if is_output {
            let id = MbJson { bytes: [0u8; 262144], len: 0 };
            mb_call_key(it, &id);
            if !mb_str_in_arr(seen_call, mb_jp(&id), id.len, false) { continue; };
        };
        let rc: i32 = mb_a_push_node(filtered, mb_clone_node(it));
    }
    return 0;
}
fn stripMiniResponsesAssistantText(input: u64, out_stripped: &u64) -> void {
    let stripped: u64 = 0;
    *out_stripped = 0;
    if input == 0 || mb_kind(input) != MB_JK_ARRAY { return; };
    let idx: u64 = mb_n_count(input);
    while idx > 0 {
        idx = idx - 1;
        let rec: u64 = mb_a_at(input, idx);
        if rec == 0 || mb_kind(rec) != MB_JK_OBJECT { continue; };
        let role = MbStr { bytes: [0u8; 8192], len: 0 };
        let has_role: bool = mb_g_str(rec, STR_PTR("role"), STR_LEN("role"), &role);
        if !has_role || !mb_s_eq(&role, STR_PTR("assistant"), STR_LEN("assistant")) { continue; };
        let content: u64 = mb_g_node(rec, STR_PTR("content"), STR_LEN("content"));
        if content == 0 || mb_kind(content) == MB_JK_NULL { continue; };
        let parts: u64 = 0;
        let single: bool = false;
        if mb_kind(content) == MB_JK_STRING {
            parts = mb_new_arr();
            let part: u64 = mb_new_obj();
            let rc: i32 = mb_s_str(part, STR_PTR("type"), STR_LEN("type"), STR_PTR("input_text"), STR_LEN("input_text"));
            let t = MbStr { bytes: [0u8; 8192], len: 0 };
            let ok: bool = mb_n_str(content, &t);
            rc = mb_s_str(part, STR_PTR("text"), STR_LEN("text"), mb_sp(&t), t.len);
            rc = mb_a_push_node(parts, part);
            single = true;
        } else if mb_kind(content) == MB_JK_ARRAY { parts = content; } else { continue; };
        let texts: u64 = mb_new_arr();
        let has_non_text: bool = false;
        let pc: u64 = mb_n_count(parts);
        let pi: u64 = 0;
        while pi < pc {
            let part: u64 = mb_a_at(parts, pi);
            pi = pi + 1;
            let pty = MbStr { bytes: [0u8; 8192], len: 0 };
            let ptext = MbStr { bytes: [0u8; 8192], len: 0 };
            let has_pty: bool = part != 0 && mb_g_str(part, STR_PTR("type"), STR_LEN("type"), &pty);
            let has_ptext: bool = part != 0 && mb_g_str(part, STR_PTR("text"), STR_LEN("text"), &ptext);
            if (mb_s_eq(&pty, STR_PTR("output_text"), STR_LEN("output_text")) || mb_s_eq(&pty, STR_PTR("input_text"), STR_LEN("input_text"))) && has_ptext {
                let tt = MbStr { bytes: [0u8; 8192], len: 0 };
                mb_trim_to(mb_sp(&ptext), ptext.len, &tt);
                if tt.len > 0 { let rc: i32 = mb_a_push_str(texts, mb_sp(&ptext), ptext.len); };
            } else { has_non_text = true; };
        }
        if single { mb_free_doc(parts); };
        if has_non_text { mb_free_doc(texts); continue; };
        if mb_n_count(texts) == 0 {
            mb_free_doc(texts);
            mb_arr_remove_at(&input, idx);
            stripped = stripped + 1;
            continue;
        };
        let joined = MbJson { bytes: [0u8; 262144], len: 0 };
        mb_lines_join(texts, &joined);
        mb_free_doc(texts);
        let note_text = MbJson { bytes: [0u8; 262144], len: 0 };
        mb_jappend(&note_text, STR_PTR("[earlier assistant note] "), STR_LEN("[earlier assistant note] "));
        mb_jappend(&note_text, mb_jp(&joined), joined.len);
        let part: u64 = mb_new_obj();
        let rc: i32 = mb_s_str(part, STR_PTR("type"), STR_LEN("type"), STR_PTR("input_text"), STR_LEN("input_text"));
        rc = mb_s_str(part, STR_PTR("text"), STR_LEN("text"), mb_jp(&note_text), note_text.len);
        let content_arr: u64 = mb_new_arr();
        rc = mb_a_push_node(content_arr, part);
        let replacement: u64 = mb_new_obj();
        rc = mb_s_str(replacement, STR_PTR("role"), STR_LEN("role"), STR_PTR("user"), STR_LEN("user"));
        rc = mb_s_node(replacement, STR_PTR("content"), STR_LEN("content"), content_arr);
        mb_arr_replace_last_n(&input, idx, replacement);
        stripped = stripped + 1;
    }
    *out_stripped = stripped;
}
fn mb_arr_replace_last_n(arr: &u64, idx: u64, new_item: u64) -> void {
    // Replace element at idx (rebuild; sa_json has no array set-at).
    let next: u64 = mb_new_arr();
    let count: u64 = mb_n_count(*arr);
    let i: u64 = 0;
    while i < count {
        if i == idx { let rc: i32 = mb_a_push_node(next, mb_clone_node(new_item)); } else { let rc: i32 = mb_a_push_node(next, mb_clone_node(mb_a_at(*arr, i))); };
        i = i + 1;
    }
    mb_free_doc(*arr);
    *arr = next;
}
fn sanitizeMiniChatMessages(msgs: u64, out: &u64) -> void {
    let result: u64 = mb_new_arr();
    *out = result;
    let seen_call: u64 = mb_new_arr();
    let seen_output: u64 = mb_new_arr();
    let count: u64 = 0;
    if msgs != 0 && mb_kind(msgs) == MB_JK_ARRAY { count = mb_n_count(msgs); };
    let i: u64 = 0;
    while i < count {
        let m: u64 = mb_a_at(msgs, i);
        i = i + 1;
        let role = MbStr { bytes: [0u8; 8192], len: 0 };
        if m != 0 && mb_kind(m) == MB_JK_OBJECT { let ok: bool = mb_g_str(m, STR_PTR("role"), STR_LEN("role"), &role); };
        let calls: u64 = 0;
        if m != 0 { calls = mb_g_node(m, STR_PTR("tool_calls"), STR_LEN("tool_calls")); };
        if mb_s_eq(&role, STR_PTR("assistant"), STR_LEN("assistant")) && calls != 0 && mb_kind(calls) == MB_JK_ARRAY {
            let kept: u64 = mb_new_arr();
            let cc: u64 = mb_n_count(calls);
            let ci: u64 = 0;
            while ci < cc {
                let tc: u64 = mb_a_at(calls, ci);
                ci = ci + 1;
                let id = MbJson { bytes: [0u8; 262144], len: 0 };
                if tc != 0 {
                    mb_field_text(tc, STR_PTR("id"), STR_LEN("id"), &id);
                    let id_node: u64 = mb_g_node(tc, STR_PTR("id"), STR_LEN("id"));
                    if id_node == 0 { mb_field_text(tc, STR_PTR("call_id"), STR_LEN("call_id"), &id); };
                };
                if id.len == 0 || mb_str_in_arr(seen_call, mb_jp(&id), id.len, false) { continue; };
                let rc: i32 = mb_a_push_str(seen_call, mb_jp(&id), id.len);
                rc = mb_a_push_node(kept, mb_clone_node(tc));
            }
            let content: u64 = mb_g_node(m, STR_PTR("content"), STR_LEN("content"));
            if mb_n_count(kept) == 0 && (content == 0 || mb_kind(content) == MB_JK_NULL) { mb_free_doc(kept); continue; };
            let clone: u64 = mb_clone_node(m);
            let rc: i32 = mb_s_node(clone, STR_PTR("tool_calls"), STR_LEN("tool_calls"), kept);
            rc = mb_a_push_node(result, clone);
            continue;
        };
        if mb_s_eq(&role, STR_PTR("tool"), STR_LEN("tool")) {
            let id = MbJson { bytes: [0u8; 262144], len: 0 };
            mb_field_text(m, STR_PTR("tool_call_id"), STR_LEN("tool_call_id"), &id);
            let id_node: u64 = mb_g_node(m, STR_PTR("tool_call_id"), STR_LEN("tool_call_id"));
            if id_node == 0 { mb_field_text(m, STR_PTR("id"), STR_LEN("id"), &id); };
            if id.len == 0 || mb_str_in_arr(seen_output, mb_jp(&id), id.len, false) { continue; };
            let rc: i32 = mb_a_push_str(seen_output, mb_jp(&id), id.len);
            rc = mb_a_push_node(result, mb_clone_node(m));
            continue;
        };
        let rc: i32 = mb_a_push_node(result, mb_clone_node(m));
    }
    // filter tool messages whose call was never seen
    let filtered: u64 = mb_new_arr();
    let rc2: u64 = mb_n_count(result);
    let fi: u64 = 0;
    while fi < rc2 {
        let m: u64 = mb_a_at(result, fi);
        fi = fi + 1;
        let role = MbStr { bytes: [0u8; 8192], len: 0 };
        if m != 0 && mb_kind(m) == MB_JK_OBJECT { let ok: bool = mb_g_str(m, STR_PTR("role"), STR_LEN("role"), &role); };
        if mb_s_eq(&role, STR_PTR("tool"), STR_LEN("tool")) {
            let id = MbJson { bytes: [0u8; 262144], len: 0 };
            mb_field_text(m, STR_PTR("tool_call_id"), STR_LEN("tool_call_id"), &id);
            let id_node: u64 = mb_g_node(m, STR_PTR("tool_call_id"), STR_LEN("tool_call_id"));
            if id_node == 0 { mb_field_text(m, STR_PTR("id"), STR_LEN("id"), &id); };
            if !mb_str_in_arr(seen_call, mb_jp(&id), id.len, false) { continue; };
        };
        let rc: i32 = mb_a_push_node(filtered, mb_clone_node(m));
    }
    mb_free_doc(result);
    mb_free_doc(seen_call);
    mb_free_doc(seen_output);
    *out = filtered;
}
