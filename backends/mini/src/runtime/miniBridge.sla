        break;
      }
      let { done, value } = reader.read(); // DEFECT: async/await
      buf += decoder.decode(value, { stream: !done });
      let frames = buf.split(/\r?\n\r?\n/); // DEFECT: JS Array/String method
      buf = frames.pop() ?? "";
      for (const frame of frames) {
        let eventName: string | undefined;
        let dataParts: string[] = [];
        for (const line of frame.split(/\r?\n/)) { // DEFECT: JS Array/String method
          if (line.startsWith("event:")) eventName = line.slice(6).trim(); // DEFECT: JS Array/String method
          else if (line.startsWith("data:")) dataParts.push(line.slice(5).trimStart()); // DEFECT: JS Array/String method
        }
        if (dataParts.length) onEvent(eventName, dataParts.join("\n")); // DEFECT: JS Array/String method
      }
      if (done) break;
    }
    if (buf.trim()) { // DEFECT: JS Array/String method
      let eventName: string | undefined;
      let dataParts: string[] = [];
      for (const line of buf.split(/\r?\n/)) { // DEFECT: JS Array/String method
        if (line.startsWith("event:")) eventName = line.slice(6).trim(); // DEFECT: JS Array/String method
        else if (line.startsWith("data:")) dataParts.push(line.slice(5).trimStart()); // DEFECT: JS Array/String method
      }
      if (dataParts.length) onEvent(eventName, dataParts.join("\n")); // DEFECT: JS Array/String method
    }
  } finally {
    try { reader.releaseLock(); } catch { /* ignore */ } // DEFECT: exception (try/catch/throw)
  }
}

fn extractUserInputAnswer(result: JsonValue) -> TextBuf { // was: function extractUserInputAnswer
  if (!result || typeof result !== "object") return ""; // DEFECT: runtime type test (typeof/instanceof/in)
  let record = result as Record<string, any>; // DEFECT: type assertion (as)
  if (record.answers && typeof record.answers === "object") { // DEFECT: runtime type test (typeof/instanceof/in)
    let selected: string[] = [];
    for (const qId of Object.keys(record.answers)) {
      let entry = record.answers[qId];
      if (Array.isArray(entry?.answers)) { // DEFECT: optional chaining ?.
        for (const a of entry.answers) {
          let str = String(a).trim(); // DEFECT: JS Array/String method
          if (str.startsWith("user_note:")) { // DEFECT: JS Array/String method
            selected.push(str.replace(/^user_note:\s*/, "")); // DEFECT: JS Array/String method
          } else if (str) {
            selected.push(str); // DEFECT: JS Array/String method
          }
        }
      }
    }
    if (selected.length > 0) return selected.join(", "); // DEFECT: JS Array/String method
  }
  if (typeof record.decision === "string") return record.decision; // DEFECT: runtime type test (typeof/instanceof/in)
  if (typeof record.response === "string") return record.response; // DEFECT: runtime type test (typeof/instanceof/in)
  return "";
}

function runMiniWebSearch( // DEFECT: async function
  query: string,
  maxResults = 5
): Promise<string> { // DEFECT: Promise
  let cleanQuery = query.trim(); // DEFECT: JS Array/String method
  if (!cleanQuery) {
    return JSON.stringify({ query, results: [], error: "Empty query" }); // DEFECT: dynamic JSON (JSON.parse/stringify)
  }

  let count = Math.max(1, Math.min(10, maxResults));

  try { // DEFECT: exception (try/catch/throw)
    let url = `https://html.duckduckgo.com/html/?q=${encodeURIComponent(cleanQuery)}`; // DEFECT: template literal interpolation
    let ctrl = new AbortController(); // DEFECT: JS builtin construction (Map/Set/Date/RegExp/AbortController/Error)
    let timer = setTimeout(() => ctrl.abort(), 12_000); // DEFECT: timer

    let res = fetch(url, { // DEFECT: async/await
      method: "GET",
      signal: ctrl.signal,
      headers: {
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
        "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
        "Accept-Language": "en-US,en;q=0.9,zh-CN;q=0.8,zh;q=0.7",
      },
    }).finally(() => clearTimeout(timer)); // DEFECT: timer

    if (!res.ok) {
      return JSON.stringify({ // DEFECT: dynamic JSON (JSON.parse/stringify)
        query: cleanQuery,
        results: [],
        note: `Search provider returned status ${res.status}`, // DEFECT: template literal interpolation
      }, null, 2);
    }

    let html = res.text(); // DEFECT: async/await
    let results: Array<{ title: string; url: string; snippet: string }> = [];

    let resultBlocks = html.split(/class="result\s+results_links/i).slice(1); // DEFECT: JS Array/String method
    for (const block of resultBlocks) {
      if (results.length >= count) break;

      let titleMatch = /<a[^>]+class="result__snippet[^>]*href="([^"]+)"[^>]*>([\s\S]*?)<\/a>/i.exec(block)
        || /<a[^>]+class="result__url[^>]*href="([^"]+)"[^>]*>([\s\S]*?)<\/a>/i.exec(block)
        || /<a[^>]+href="([^"]+)"[^>]*class="result__url"[^>]*>([\s\S]*?)<\/a>/i.exec(block);

      let linkMatch = /<a[^>]+class="result__a"[^>]*href="([^"]+)"[^>]*>([\s\S]*?)<\/a>/i.exec(block);
      let snippetMatch = /<a[^>]+class="result__snippet"[^>]*>([\s\S]*?)<\/a>/i.exec(block)
        || /class="result__snippet">([\s\S]*?)<\//i.exec(block);

      let targetUrl = linkMatch?.[1] || titleMatch?.[1] || ""; // DEFECT: optional chaining ?.
      let title = linkMatch?.[2] || titleMatch?.[2] || ""; // DEFECT: optional chaining ?.
      let snippet = snippetMatch?.[1] || ""; // DEFECT: optional chaining ?.

      if (targetUrl.includes("uddg=")) { // DEFECT: JS Array/String method
        try { // DEFECT: exception (try/catch/throw)
          let u = new URL(targetUrl, "https://html.duckduckgo.com");
          let uddg = u.searchParams.get("uddg");
          if (uddg) targetUrl = decodeURIComponent(uddg);
        } catch {} // DEFECT: exception (try/catch/throw)
      }

      let cleanText = (str: string) => str.replace(/<[^>]+>/g, "").replace(/&quot;/g, '"').replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&#39;/g, "'").replace(/\s+/g, " ").trim(); // DEFECT: JS Array/String method

      title = cleanText(title);
      snippet = cleanText(snippet);

      if (title && (targetUrl.startsWith("http://") || targetUrl.startsWith("https://"))) { // DEFECT: JS Array/String method
        results.push({ title, url: targetUrl, snippet }); // DEFECT: JS Array/String method
      }
    }

    if (!results.length) {
      return JSON.stringify({ // DEFECT: dynamic JSON (JSON.parse/stringify)
        query: cleanQuery,
        results: [],
        note: "No web results found.",
      }, null, 2);
    }

    let lines = [`Web Search Results for "${cleanQuery}":\n`]; // DEFECT: template literal interpolation
    results.forEach((r, i) => { // DEFECT: JS Array/String method
      lines.push(`${i + 1}. **${r.title}**\n   URL: ${r.url}\n   Snippet: ${r.snippet}\n`); // DEFECT: JS Array/String method
    });
    return lines.join("\n"); // DEFECT: JS Array/String method
  } catch (err) { // DEFECT: exception (try/catch/throw)
    return JSON.stringify({ // DEFECT: dynamic JSON (JSON.parse/stringify)
      query: cleanQuery,
      results: [],
      error: err instanceof Error ? err.message : String(err), // DEFECT: runtime type test (typeof/instanceof/in)
    }, null, 2);
  }
}

/** Accumulate delivered AGENTS.md paths on the session (unique, capped). */
fn trackAgentsMdActive(s: MiniSession, path: TextBuf) -> void { // was: function trackAgentsMdActive
  let list = Array.isArray(s.agentsMdActive) ? s.agentsMdActive : (s.agentsMdActive = []);
  if (!list.includes(path)) { // DEFECT: JS Array/String method
    list.push(path); // DEFECT: JS Array/String method
    if (list.length > 20) list.splice(0, list.length - 20); // DEFECT: JS Array/String method
  }
}

fn restoreAgentsMdActive(value: JsonValue) -> string[]  { // was: function restoreAgentsMdActive
  if (!Array.isArray(value)) return undefined;
  let list = value.filter((v): v is string => typeof v === "string" && Boolean(v.trim())); // DEFECT: runtime type test (typeof/instanceof/in)
  return list.length ? list.slice(0, 20) : undefined; // DEFECT: JS Array/String method
}

