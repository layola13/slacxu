            mb_trim_to(mb_jp(&raw_exe), raw_exe.len, &raw_exe_t);
            let raw_exe_l = MbStr { bytes: [0u8; 8192], len: 0 };
            mb_lower_into(mb_sp(&raw_exe_t), raw_exe_t.len, &raw_exe_l);
            let is_git: bool = mb_s_eq(&raw_exe_l, STR_PTR("git"), STR_LEN("git")) || mb_ends_with(mb_sp(&raw_exe_l), raw_exe_l.len, STR_PTR("/git"), STR_LEN("/git")) || mb_ends_with(mb_sp(&raw_exe_l), raw_exe_l.len, STR_PTR("\\git"), STR_LEN("\\git")) || (mb_ends_with(mb_sp(&raw_exe_l), raw_exe_l.len, STR_PTR(".exe"), STR_LEN(".exe")) && mb_contains(mb_sp(&raw_exe_l), raw_exe_l.len, STR_PTR("git"), STR_LEN("git")));
            let args_node2: u64 = mb_g_node(arg, STR_PTR("args"), STR_LEN("args"));
            let args_empty: bool = args_node2 == 0 || mb_kind(args_node2) != MB_JK_ARRAY || mb_n_count(args_node2) == 0;
            if is_git && !has_cmd {
                if args_empty {
                    mb_jassign(out, STR_PTR("sa_vm run_host with exe:\"git\" requires a non-empty args array (e.g. {\"action\":\"run_host\",\"exe\":\"git\",\"args\":[\"log\",\"--oneline\",\"-10\"]} or {\"action\":\"run_host\",\"command\":\"git log --oneline -10\"}, or use {\"action\":\"git_log\",\"max_count\":10})."), STR_LEN("sa_vm run_host with exe:\"git\" requires a non-empty args array (e.g. {\"action\":\"run_host\",\"exe\":\"git\",\"args\":[\"log\",\"--oneline\",\"-10\"]} or {\"action\":\"run_host\",\"command\":\"git log --oneline -10\"}, or use {\"action\":\"git_log\",\"max_count\":10})."));
                    *out_is_null = false;
                    return;
                };
            } else if !has_cmd && args_empty {
                mb_jappend(out, STR_PTR("sa_vm run_host with exe:\""), STR_LEN("sa_vm run_host with exe:\""));
                let exe_raw = MbJson { bytes: [0u8; 262144], len: 0 };
                mb_scalar_text_of(arg, STR_PTR("exe"), STR_LEN("exe"), &exe_raw);
                let et = MbStr { bytes: [0u8; 8192], len: 0 };
                mb_trim_to(mb_jp(&exe_raw), exe_raw.len, &et);
                let take: u64 = et.len;
                if take > 120 { take = 120; };
                mb_jappend(out, mb_sp(&et), take);
                mb_jappend(out, STR_PTR("\" requires a non-empty args array, or use the single-string command form {\"action\":\"run_host\",\"command\":\"<command>\"}."), STR_LEN("\" requires a non-empty args array, or use the single-string command form {\"action\":\"run_host\",\"command\":\"<command>\"}."));
                *out_is_null = false;
                return;
            };
            let cmd_text = MbJson { bytes: [0u8; 262144], len: 0 };
            mb_scalar_text_of(arg, STR_PTR("command"), STR_LEN("command"), &cmd_text);
            if cmd_text.len == 0 { mb_scalar_text_of(arg, STR_PTR("cmd"), STR_LEN("cmd"), &cmd_text); };
            if cmd_text.len == 0 { mb_scalar_text_of(arg, STR_PTR("line"), STR_LEN("line"), &cmd_text); };
            let tokens: u64 = 0;
            if cmd_text.len > 0 { parseCommandLineTokens(mb_jp(&cmd_text), cmd_text.len, &tokens); } else {
                tokens = mb_new_arr();
                let args_node3: u64 = mb_g_node(arg, STR_PTR("args"), STR_LEN("args"));
                if args_node3 != 0 && mb_kind(args_node3) == MB_JK_ARRAY {
                    let ac: u64 = mb_n_count(args_node3);
                    let ai: u64 = 0;
                    while ai < ac { let rc: i32 = mb_a_push_node(tokens, mb_clone_node(mb_a_at(args_node3, ai))); ai = ai + 1; }
                };
            };
            let op = MbStr { bytes: [0u8; 8192], len: 0 };
            let op_is_null: bool = true;
            miniRunHostShellOperator(tokens, &op, &op_is_null);
            mb_free_doc(tokens);
            if !op_is_null {
                mb_jappend(out, STR_PTR("sa_vm run_host runs ONE program with argv (no shell), so shell operator \""), STR_LEN("sa_vm run_host runs ONE program with argv (no shell), so shell operator \""));
                mb_jappend_s(out, &op);
                mb_jappend(out, STR_PTR("\" is not supported. Split into separate run_host calls in the same round (independent) or sequential rounds (dependent); for filtering use tool params (head_lines/tail_lines) instead of pipes."), STR_LEN("\" is not supported. Split into separate run_host calls in the same round (independent) or sequential rounds (dependent); for filtering use tool params (head_lines/tail_lines) instead of pipes."));
                *out_is_null = false;
                return;
            };
            return;
        };
        return;
    };
    if mb_bytes_eq(name_p, name_n, STR_PTR("read_skill"), STR_LEN("read_skill")) {
        if !mb_ne(arg, STR_PTR("name"), STR_LEN("name")) {
            mb_jassign(out, STR_PTR("read_skill needs {\"name\":\"<skill>\"}."), STR_LEN("read_skill needs {\"name\":\"<skill>\"}."));
            *out_is_null = false;
        };
        return;
    };
    if mb_bytes_eq(name_p, name_n, STR_PTR("image_view"), STR_LEN("image_view")) {
        let text = MbJson { bytes: [0u8; 262144], len: 0 };
        let ok: bool = mb_stringify_node(arg, &text);
        let err_buf = MbStr { bytes: [0u8; 8192], len: 0 };
        let err_len: u64 = 0;
        let err_is_null: bool = true;
        let rc: i32 = miniImageViewArgError(mb_jp(&text), text.len, mb_sp(&err_buf), &err_len, &err_is_null);
        if !err_is_null {
            mb_jassign(out, mb_sp(&err_buf), err_len);
            *out_is_null = false;
        };
        return;
    };
    if mb_bytes_eq(name_p, name_n, STR_PTR("request_user_input"), STR_LEN("request_user_input")) {
        let qs: u64 = mb_g_node(arg, STR_PTR("questions"), STR_LEN("questions"));
        if qs == 0 || mb_kind(qs) != MB_JK_ARRAY || mb_n_count(qs) == 0 {
            mb_jassign(out, STR_PTR("request_user_input needs {questions:[{question,options?}]}."), STR_LEN("request_user_input needs {questions:[{question,options?}]}."));
            *out_is_null = false;
        };
        return;
    };
    if mb_bytes_eq(name_p, name_n, STR_PTR("web_search"), STR_LEN("web_search")) {
        if !mb_ne(arg, STR_PTR("query"), STR_LEN("query")) && !mb_ne(arg, STR_PTR("q"), STR_LEN("q")) {
            mb_jassign(out, STR_PTR("web_search needs a non-empty query string."), STR_LEN("web_search needs a non-empty query string."));
            *out_is_null = false;
        };
        return;
    };
    if mb_bytes_eq(name_p, name_n, STR_PTR("list_mcp_resources"), STR_LEN("list_mcp_resources")) { return; };
    if mb_bytes_eq(name_p, name_n, STR_PTR("read_mcp_resource"), STR_LEN("read_mcp_resource")) {
        if !mb_ne(arg, STR_PTR("server"), STR_LEN("server")) {
            mb_jassign(out, STR_PTR("read_mcp_resource needs {\"server\":\"<mcp server>\"}."), STR_LEN("read_mcp_resource needs {\"server\":\"<mcp server>\"}."));
            *out_is_null = false;
            return;
        };
        if !mb_ne(arg, STR_PTR("uri"), STR_LEN("uri")) {
            mb_jassign(out, STR_PTR("read_mcp_resource needs {\"uri\":\"<resource uri>\"} (discover URIs with list_mcp_resources)."), STR_LEN("read_mcp_resource needs {\"uri\":\"<resource uri>\"} (discover URIs with list_mcp_resources)."));
            *out_is_null = false;
        };
        return;
    };
    if mb_bytes_eq(name_p, name_n, STR_PTR("spawn_agent"), STR_LEN("spawn_agent")) {
        let coerced = MbJson { bytes: [0u8; 262144], len: 0 };
        miniCoerceSpawnMessage(arg, &coerced);
        let ct = MbStr { bytes: [0u8; 8192], len: 0 };
        mb_trim_to(mb_jp(&coerced), coerced.len, &ct);
        if ct.len > 0 { return; };
        if !mb_ne(arg, STR_PTR("task_name"), STR_LEN("task_name")) && !mb_ne(arg, STR_PTR("taskName"), STR_LEN("taskName")) {
            mb_jassign(out, STR_PTR("spawn_agent needs {task_name,message}: task_name uses lowercase/digits/underscores, message is a non-empty plain-text brief. Do NOT pass update_plan fields (todos/steps) here - call update_plan as a separate tool call."), STR_LEN("spawn_agent needs {task_name,message}: task_name uses lowercase/digits/underscores, message is a non-empty plain-text brief. Do NOT pass update_plan fields (todos/steps) here - call update_plan as a separate tool call."));
            *out_is_null = false;
            return;
        };
        mb_jassign(out, STR_PTR("spawn_agent needs a non-empty message describing the subtask. Do NOT pass update_plan fields (todos/steps) here - call update_plan as a separate tool call."), STR_LEN("spawn_agent needs a non-empty message describing the subtask. Do NOT pass update_plan fields (todos/steps) here - call update_plan as a separate tool call."));
        *out_is_null = false;
        return;
    };
    let normalized = MbStr { bytes: [0u8; 8192], len: 0 };
    normalizeMiniSubagentToolName(name_p, name_n, true, &normalized);
    if mb_s_eq(&normalized, STR_PTR("send_message"), STR_LEN("send_message")) {
        if !mb_ne(arg, STR_PTR("target"), STR_LEN("target")) && !mb_ne(arg, STR_PTR("id"), STR_LEN("id")) {
            mb_jassign(out, STR_PTR("send_message needs a target agent_id (from spawn_agent). Use list_agents to see live agents. It only queues; use followup_task to trigger the next turn."), STR_LEN("send_message needs a target agent_id (from spawn_agent). Use list_agents to see live agents. It only queues; use followup_task to trigger the next turn."));
            *out_is_null = false;
            return;
        };
        if !mb_ne(arg, STR_PTR("message"), STR_LEN("message")) && !mb_ne(arg, STR_PTR("text"), STR_LEN("text")) {
            mb_jassign(out, STR_PTR("send_message needs a non-empty message."), STR_LEN("send_message needs a non-empty message."));
            *out_is_null = false;
        };
        return;
    };
    if mb_bytes_eq(name_p, name_n, STR_PTR("followup_task"), STR_LEN("followup_task")) {
        if !mb_ne(arg, STR_PTR("target"), STR_LEN("target")) && !mb_ne(arg, STR_PTR("id"), STR_LEN("id")) {
            mb_jassign(out, STR_PTR("followup_task needs a target agent_id (from spawn_agent). Use list_agents to see live agents."), STR_LEN("followup_task needs a target agent_id (from spawn_agent). Use list_agents to see live agents."));
            *out_is_null = false;
            return;
        };
        if !mb_ne(arg, STR_PTR("message"), STR_LEN("message")) && !mb_ne(arg, STR_PTR("text"), STR_LEN("text")) {
            mb_jassign(out, STR_PTR("followup_task needs a non-empty message."), STR_LEN("followup_task needs a non-empty message."));
            *out_is_null = false;
        };
        return;
    };
    if mb_bytes_eq(name_p, name_n, STR_PTR("read_agent_report"), STR_LEN("read_agent_report")) {
        if !mb_ne(arg, STR_PTR("target"), STR_LEN("target")) && !mb_ne(arg, STR_PTR("id"), STR_LEN("id")) {
            mb_jassign(out, STR_PTR("read_agent_report needs a target agent_id (from spawn_agent). Use list_agents to see live agents."), STR_LEN("read_agent_report needs a target agent_id (from spawn_agent). Use list_agents to see live agents."));
            *out_is_null = false;
        };
        return;
    };
    if mb_bytes_eq(name_p, name_n, STR_PTR("interrupt_agent"), STR_LEN("interrupt_agent")) {
        if !mb_ne(arg, STR_PTR("target"), STR_LEN("target")) && !mb_ne(arg, STR_PTR("id"), STR_LEN("id")) {
            mb_jassign(out, STR_PTR("interrupt_agent needs a target agent_id (from spawn_agent). Use list_agents to see live agents."), STR_LEN("interrupt_agent needs a target agent_id (from spawn_agent). Use list_agents to see live agents."));
            *out_is_null = false;
        };
        return;
    };
    if mb_bytes_eq(name_p, name_n, STR_PTR("wait_agent"), STR_LEN("wait_agent")) {
        let any_target: bool = false;
        let targets: u64 = mb_g_node(arg, STR_PTR("targets"), STR_LEN("targets"));
        if targets != 0 && mb_kind(targets) == MB_JK_ARRAY {
            let tc: u64 = mb_n_count(targets);
            let ti: u64 = 0;
            while ti < tc {
                let t: u64 = mb_a_at(targets, ti);
                ti = ti + 1;
                let s = MbJson { bytes: [0u8; 262144], len: 0 };
                if t != 0 && mb_kind(t) == MB_JK_STRING { let ok: bool = mb_n_str_j(t, &s); } else if t != 0 && mb_kind(t) != MB_JK_NULL { mb_json_scalar_text(t, &s); };
                let tt = MbStr { bytes: [0u8; 8192], len: 0 };
                mb_trim_to(mb_jp(&s), s.len, &tt);
                if tt.len > 0 { any_target = true; };
            }
        } else {
            let single = MbStr { bytes: [0u8; 8192], len: 0 };
            let has1: bool = mb_g_str(arg, STR_PTR("target"), STR_LEN("target"), &single);
            if !has1 { let has2: bool = mb_g_str(arg, STR_PTR("targets"), STR_LEN("targets"), &single); };
            let tt = MbStr { bytes: [0u8; 8192], len: 0 };
            mb_trim_to(mb_sp(&single), single.len, &tt);
            if tt.len > 0 { any_target = true; };
        };
        if !any_target {
            mb_jassign(out, STR_PTR("wait_agent needs at least one target agent_id (from spawn_agent)."), STR_LEN("wait_agent needs at least one target agent_id (from spawn_agent)."));
            *out_is_null = false;
        };
        return;
    };
    if mb_bytes_eq(name_p, name_n, STR_PTR("close_agent"), STR_LEN("close_agent")) {
        if !mb_ne(arg, STR_PTR("target"), STR_LEN("target")) && !mb_ne(arg, STR_PTR("id"), STR_LEN("id")) {
            mb_jassign(out, STR_PTR("close_agent needs a target agent_id."), STR_LEN("close_agent needs a target agent_id."));
            *out_is_null = false;
        };
        return;
    };
    if mb_bytes_eq(name_p, name_n, STR_PTR("resume_agent"), STR_LEN("resume_agent")) {
        if !mb_ne(arg, STR_PTR("target"), STR_LEN("target")) && !mb_ne(arg, STR_PTR("id"), STR_LEN("id")) {
            mb_jassign(out, STR_PTR("resume_agent needs a target agent_id (a child previously closed by close_agent)."), STR_LEN("resume_agent needs a target agent_id (a child previously closed by close_agent)."));
            *out_is_null = false;
        };
        return;
    };
}
// read_many file list resolution (TS arg-validation shape): files array |
// files string | paths array | [path]; entries String()-ed, trimmed, non-empty.
fn mb_read_many_files(arg: u64, out: &u64) -> void {
    let list: u64 = mb_new_arr();
    *out = list;
    let files_node: u64 = mb_g_node(arg, STR_PTR("files"), STR_LEN("files"));
    let src: u64 = 0;
    if files_node != 0 && mb_kind(files_node) == MB_JK_ARRAY { src = files_node; } else if files_node != 0 && mb_kind(files_node) == MB_JK_STRING {
        let one: u64 = mb_new_arr();
        let rc: i32 = mb_a_push_node(one, mb_clone_node(files_node));
        src = one;
    } else {
        let paths_node: u64 = mb_g_node(arg, STR_PTR("paths"), STR_LEN("paths"));
        if paths_node != 0 && mb_kind(paths_node) == MB_JK_ARRAY { src = paths_node; } else {
            let path_node: u64 = mb_g_node(arg, STR_PTR("path"), STR_LEN("path"));
            if path_node != 0 && mb_kind(path_node) == MB_JK_STRING {
                let one: u64 = mb_new_arr();
                let rc: i32 = mb_a_push_node(one, mb_clone_node(path_node));
                src = one;
            };
        };
    };
    if src == 0 { return; };
    let count: u64 = mb_n_count(src);
    let i: u64 = 0;
    while i < count {
        let f: u64 = mb_a_at(src, i);
        i = i + 1;
        let s = MbJson { bytes: [0u8; 262144], len: 0 };
        if f != 0 && mb_kind(f) == MB_JK_STRING { let ok: bool = mb_n_str_j(f, &s); } else if f != 0 && mb_kind(f) != MB_JK_NULL { mb_json_scalar_text(f, &s); };
        let t = MbStr { bytes: [0u8; 8192], len: 0 };
        mb_trim_to(mb_jp(&s), s.len, &t);
        if t.len > 0 { let rc: i32 = mb_a_push_str(list, mb_sp(&t), t.len); };
    }
}

// ---- normalizeSaVmArgs (TS:2984-3180) ----
fn mb_copy_alias(out: u64, dst_p: ptr, dst_n: u64, s1: ptr, s1n: u64, s2: ptr, s2n: u64, s3: ptr, s3n: u64, s4: ptr, s4n: u64) -> void {
    if mb_g_node(out, dst_p, dst_n) != 0 { return; };
    let srcs: [ptr; 4] = [s1, s2, s3, s4];
    let lens: [u64; 4] = [s1n, s2n, s3n, s4n];
    let i: u64 = 0;
    while i < 4 {
        let v: u64 = mb_g_node(out, srcs[i], lens[i]);
        i = i + 1;
        if v != 0 { let rc: i32 = mb_s_node(out, dst_p, dst_n, mb_clone_node(v)); return; };
    }
}
fn mb_str_field(doc: u64, kp: ptr, kn: u64, out: &MbStr, has: &bool) -> void {
    out.len = 0;
    *has = false;
    let node: u64 = mb_g_node(doc, kp, kn);
    if node != 0 && mb_kind(node) == MB_JK_STRING { *has = mb_n_str(node, out); };
}
fn mb_set_str_field(doc: u64, kp: ptr, kn: u64, v: &MbStr) -> void {
    let rc: i32 = mb_s_str(doc, kp, kn, mb_sp(v), v.len);
}
fn mb_is_int_str(p: ptr, n: u64) -> bool {
    return mb_re_test(p, n, STR_PTR("^-?[0-9]+$"), STR_LEN("^-?[0-9]+$"), false);
}
fn normalizeSaVmArgs(a: u64, tool_p: ptr, tool_n: u64, has_tool: bool, out: &u64) -> void {
    let o: u64 = mb_clone_node(a);
    if o == 0 { o = mb_new_obj(); };
    *out = o;
    if has_tool {
        let t = MbStr { bytes: [0u8; 8192], len: 0 };
        let raw = MbStr { bytes: [0u8; 8192], len: 0 };
        mb_sassign(&raw, tool_p, tool_n);
        mb_trim_to(mb_sp(&raw), raw.len, &t);
        let action_node: u64 = mb_g_node(o, STR_PTR("action"), STR_LEN("action"));
        let jev: u64 = 0;
        mb_mini_jev_actions(&jev);
        let t_is_jev: bool = mb_str_in_arr(jev, mb_sp(&t), t.len, false);
        if t_is_jev {
            if action_node == 0 { let rc: i32 = mb_s_str(o, STR_PTR("action"), STR_LEN("action"), mb_sp(&t), t.len); };
        } else if mb_s_eq(&t, STR_PTR("git_log"), STR_LEN("git_log")) || mb_s_eq(&t, STR_PTR("git-log"), STR_LEN("git-log")) || mb_s_eq(&t, STR_PTR("git_status"), STR_LEN("git_status")) || mb_s_eq(&t, STR_PTR("git-status"), STR_LEN("git-status")) || mb_s_eq(&t, STR_PTR("git_diff"), STR_LEN("git_diff")) || mb_s_eq(&t, STR_PTR("git-diff"), STR_LEN("git-diff")) || mb_s_eq(&t, STR_PTR("run_host"), STR_LEN("run_host")) || mb_s_eq(&t, STR_PTR("exec_host"), STR_LEN("exec_host")) || mb_s_eq(&t, STR_PTR("host"), STR_LEN("host")) || mb_s_eq(&t, STR_PTR("bash"), STR_LEN("bash")) || mb_s_eq(&t, STR_PTR("sh"), STR_LEN("sh")) {
            if action_node == 0 { let rc: i32 = mb_s_str(o, STR_PTR("action"), STR_LEN("action"), mb_sp(&t), t.len); };
        } else if mb_starts_with(mb_sp(&t), t.len, STR_PTR("mcp__"), STR_LEN("mcp__")) {
            // sub = t.split("__").pop(): text after the LAST "__".
            let sub = MbStr { bytes: [0u8; 8192], len: 0 };
            let idx: i64 = mb_last_index_of(mb_sp(&t), t.len, STR_PTR("__"), STR_LEN("__"));
            if idx >= 0 { let subj = MbJson { bytes: [0u8; 262144], len: 0 }; mb_slice_to(mb_sp(&t), t.len, idx + 2, t.len as i64, &subj); mb_sassign_j(&sub, &subj); } else { mb_sassign_s2(&sub, &t); };
            let actions: u64 = 0;
            mb_mini_sa_vm_action_names(&actions);
            let sub_known: bool = mb_str_in_arr(actions, mb_sp(&sub), sub.len, false) || mb_str_in_arr(jev, mb_sp(&sub), sub.len, false);
            mb_free_doc(actions);
            if sub_known && action_node == 0 { let rc: i32 = mb_s_str(o, STR_PTR("action"), STR_LEN("action"), mb_sp(&sub), sub.len); };
        };
        mb_free_doc(jev);
    };
    if mb_g_node(o, STR_PTR("action"), STR_LEN("action")) == 0 {
        let has_keys: bool = mb_truthy(mb_g_node(o, STR_PTR("user_request"), STR_LEN("user_request"))) || mb_truthy(mb_g_node(o, STR_PTR("actual_work"), STR_LEN("actual_work"))) || mb_truthy(mb_g_node(o, STR_PTR("request"), STR_LEN("request"))) || mb_truthy(mb_g_node(o, STR_PTR("work"), STR_LEN("work")));
        if has_keys { let rc: i32 = mb_s_str(o, STR_PTR("action"), STR_LEN("action"), STR_PTR("jev_done"), STR_LEN("jev_done")); };
    };
    let action_raw = MbStr { bytes: [0u8; 8192], len: 0 };
    let has_action_str: bool = false;
    mb_str_field(o, STR_PTR("action"), STR_LEN("action"), &action_raw, &has_action_str);
    if has_action_str && (mb_s_eq(&action_raw, STR_PTR("bash"), STR_LEN("bash")) || mb_s_eq(&action_raw, STR_PTR("sh"), STR_LEN("sh"))) {
        let rc: i32 = mb_s_str(o, STR_PTR("action"), STR_LEN("action"), STR_PTR("run_host"), STR_LEN("run_host"));
    };
    let parallel_node: u64 = mb_g_node(o, STR_PTR("parallel"), STR_LEN("parallel"));
    if parallel_node != 0 && mb_kind(parallel_node) == MB_JK_ARRAY {
        let mapped: u64 = mb_new_arr();
        let count: u64 = mb_n_count(parallel_node);
        let i: u64 = 0;
        while i < count {
            let item: u64 = mb_a_at(parallel_node, i);
            i = i + 1;
            if item != 0 && mb_kind(item) == MB_JK_OBJECT {
                let sub: u64 = 0;
                normalizeSaVmArgs(item, STR_PTR(""), STR_LEN(""), false, &sub);
                let rc: i32 = mb_a_push_node(mapped, sub);
            } else {
                let rc: i32 = mb_a_push_node(mapped, mb_clone_node(item));
            };
        }
        let rc: i32 = mb_s_node(o, STR_PTR("parallel"), STR_LEN("parallel"), mapped);
        return;
    };
    mb_copy_alias(o, STR_PTR("old_text"), STR_LEN("old_text"), STR_PTR("oldText"), STR_LEN("oldText"), STR_PTR("old_string"), STR_LEN("old_string"), STR_PTR("oldString"), STR_LEN("oldString"), STR_PTR("old"), STR_LEN("old"));
