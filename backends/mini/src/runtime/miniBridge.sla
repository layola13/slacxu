  return /(?:继续|接着|往下|下一步|proceed|continue|keep\s+going|go\s+on|carry\s+on|开始|执行|确认|需要|进行|处理)[^?？]{0,15}[?？]\s*$/i.test(lastLine);
}
let MINI_AUTO_CONTINUE_NOTE = "Continue working on the user's request with the next concrete sa_vm tool call now (inspect, edit, write, verify, or search). Do not end the turn with narration alone while the requested work is unfinished; if genuinely no change is needed, state that explicitly as the final answer. If the requested work is already complete, do NOT repeat the summary: end your reply with a final line starting with \"DONE:\" followed by a one-line summary."; // DEFECT: type assertion (as)
