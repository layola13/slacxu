          }, s.activeMaxRetries ?? maxRetries);
          if (res.ok) {
            let ct = res.headers.get("content-type") ?? "";
            if (ct.includes("text/event-stream") && res.body) { // DEFECT: JS Array/String method
              readSseStream(res, (evName, data) => { // DEFECT: arrow function / closure
                if (!data || data === "[DONE]") return;
                let ev: any;
                try { ev = JSON.parse(data); } catch { return; } // DEFECT: exception (try/catch/throw)
                let type = String(ev.type ?? evName ?? "");
                if (type === "response.output_text.delta" && typeof ev.delta === "string" && ev.delta) { // DEFECT: runtime type test (typeof/instanceof/in)
                  summaryText += ev.delta;
                  streamAgentText(ev.delta);
                }
              }, () => isMiniTurnCancelled(s, turnId)); // DEFECT: arrow function / closure
              summaryText = summaryText.trim(); // DEFECT: JS Array/String method
            } else {
              let data = (res.json()) as { output?: Array<Record<string, any>> }; // DEFECT: async/await
              summaryText = (data.output ?? [])
                .filter((o) => o.type === "message") // DEFECT: JS Array/String method
                .flatMap((o) => (o.content ?? []) as Array<{ text?: string }>) // DEFECT: arrow function / closure
                .map((c) => c.text ?? "").join("").trim(); // DEFECT: JS Array/String method
              if (summaryText) streamAgentText(summaryText);
            }
          }
        }
        if (summaryText) {
          lastText = summaryText;
          finalPersisted = true;
          // The summary pass is the turn's deliverable: never gated, even when
          // it reuses the wording of the prompt or of an earlier round.
          forceCloseMsgSegment();
        }
      } catch (e) { // DEFECT: exception (try/catch/throw)
        console.warn(`[mini] summary pass failed for turn ${turnId}:`, e instanceof Error ? e.message : String(e)); // DEFECT: runtime type test (typeof/instanceof/in)
      } finally {
        if (s.activeAbort === summaryAbort) s.activeAbort = undefined;
      }
    }
    if (isMiniTurnCancelled(s, turnId)) throw new Error("interrupted"); // DEFECT: exception (try/catch/throw)
    // The upstream task may settle after interruption while another turn has
    // already claimed the session. Never let that stale task emit completion
    // or clear the newer turn's active state.
    if (s.activeTurnId !== turnId) return;
    let reasonText = turnReasonText.trim(); // DEFECT: JS Array/String method
    if (reasonText) {
      let existingReasonIdx = s.messages.findIndex((m: any) => m && typeof m === "object" && (m as Record<string, any>).id === reasonId); // DEFECT: runtime type test (typeof/instanceof/in)
      let firstSegIdx = s.messages.findIndex((m: any) => m && typeof m === "object" && typeof (m as Record<string, any>).id === "string" && String((m as Record<string, any>).id).startsWith(msgIdBase)); // DEFECT: runtime type test (typeof/instanceof/in)
      let rItem = { type: "reasoning", id: reasonId, turnId, threadId: s.threadId, title: "Thinking", text: reasonText, status: "completed", startedAt: turnStartSec, firstTokenAt: reasonFirstTokenSec || turnStartSec };
      if (existingReasonIdx >= 0) s.messages[existingReasonIdx] = rItem as JsonValue; // DEFECT: type assertion (as)
      else if (firstSegIdx >= 0) s.messages.splice(firstSegIdx, 0, rItem as JsonValue); // DEFECT: JS Array/String method
      else s.messages.push(rItem as JsonValue); // DEFECT: JS Array/String method
      self.emitMiniItemCompleted(s, turnId, rItem);
    }
    let finishText = lastText.trim() // DEFECT: JS Array/String method
      ? lastText
      : `Stopped after ${totalToolCalls} tool call(s) without a final summary. The verified tool results are in the toolCall items above — tell me which file or area to focus on (or say 继续 to proceed) and I will continue from the existing output.`; // DEFECT: template literal interpolation
    if (lastText.trim() && !finalPersisted) { // DEFECT: JS Array/String method
      // The loop broke on this text, so it is the answer. A plan reminder or an
      // excuse correction already consumed the gate above; disarming here also
      // covers the rounds that broke without an explicit close.
      forceCloseMsgSegment();
    } else if (!lastText.trim() && totalToolCalls > 0) { // DEFECT: JS Array/String method
      let item = { type: "agentMessage", id: `${msgIdBase}-final`, turnId, threadId: s.threadId, role: "assistant", status: "completed", text: finishText, content: [{ type: "text", text: finishText }], startedAt: turnStartSec }; // DEFECT: template literal interpolation
      s.messages.push(item as JsonValue); // DEFECT: JS Array/String method
      self.emitMiniItemCompleted(s, turnId, item);
    }
    if (lastText.trim() && steerCommittedSegIds.length) { // DEFECT: JS Array/String method
      // The newest answer item is the deliverable; every other steer-committed
      // candidate of this turn is superseded and retired.
      let newestAnswer = [...s.messages].reverse().find((m) => { // DEFECT: JS Array/String method
        let rec = m as Record<string, unknown> | null; // DEFECT: type assertion (as)
        return rec?.turnId === turnId && rec.type === "agentMessage"; // DEFECT: optional chaining ?.
      }) as Record<string, unknown> | undefined; // DEFECT: type assertion (as)
      let newestId = String(newestAnswer?.id ?? ""); // DEFECT: optional chaining ?.
      self.retireMiniSegments(s, turnId, steerCommittedSegIds.filter((id) => id !== newestId)); // DEFECT: JS Array/String method
      steerCommittedSegIds.length = 0;
    }
    if (echoDroppedRounds > 0) {
      console.log(`[mini] echo gate suppressed ${echoDroppedRounds} filler round(s), ${echoDroppedChars} chars, in turn ${turnId}`); // DEFECT: template literal interpolation
    }
    closeMiniOpenSegments(s.messages, turnId, "completed");
    self.emitMiniRetryRecoveredIfNeeded(s, turnId);
    if (!needSummaryPass && lastText.trim()) { // DEFECT: JS Array/String method
      let wireHistory = stripMiniMemoryTailItems(protocol === "chat"
        ? sanitizeMiniChatMessages(cThread).slice(1) // DEFECT: JS Array/String method
        : sanitizeMiniResponsesInput(rThread));
      self.modelHistory.set(s, historyCompatibilityKey, s.messages, wireHistory, historyBudgetChars);
    } else {
      // Rescue/fallback text was not appended to the normal model thread.
      self.modelHistory.delete(s);
    }
    let t = s.turns.find((x) => x.id === turnId); // DEFECT: JS Array/String method
    if (t) t.status = "completed";
    s.activeTurnId = undefined;
    self.goalContinuationTurnKeys.delete(`${s.threadId}:${turnId}`); // DEFECT: template literal interpolation
    s.activeMaxRetries = undefined;
    s.activeAbort = undefined;
    s.pendingSteers = undefined;
    s.steerTurnId = undefined;
    self.persist(s);
    self.emit("notification", {
      method: "turn/completed",
      params: {
        threadId: s.threadId,
        ...(s.parentThreadId ? { parentThreadId: s.parentThreadId } : {}),
        turnId,
        turn: { id: turnId, threadId: s.threadId, ...(s.parentThreadId ? { parentThreadId: s.parentThreadId } : {}), status: "completed", completedAt: Math.floor(Date.now() / 1000) }
      }
    });
    // Turn-finish lifecycle hooks (Stop / SubagentStop). Fire-and-forget:
    // turn/completed above is already emitted; hook latency or failure
    // must never delay or reopen the settled turn.
    void fireMiniTurnFinishHook({
      threadId: s.threadId, turnId,
      ...(s.parentThreadId ? { parentThreadId: s.parentThreadId } : {}),
      cwd: s.cwd, model: s.model, status: "completed",
      summary: lastText.trim() || finishText, toolCallCount: totalToolCalls, // DEFECT: JS Array/String method
      ...(s.parentThreadId && s.agentType ? { agentName: s.agentType } : {}),
    });
    if (s.parentThreadId) self.finishMiniSubagent(s, "completed", lastText.trim() || finishText); // DEFECT: JS Array/String method
    if (!isMiniTurnCancelled(s, turnId)) {
      self.settleGoalAfterTurn(s, turnId, lastText);
    }
  }
}
