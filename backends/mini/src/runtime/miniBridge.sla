//
 //* Unknown-tool error with a recovery hint: models trained on Codex-style
 //* harnesses call file/edit/patch tools top-level, but Mini exposes them as
 //* sa_vm actions. Tell the model the exact retry shape instead of a bare
 //* "unknown tool" so one failed call becomes a silent self-fix, not a stall.
 //
fn miniUnknownToolError(name: JsonValue) -> TextBuf { // was: function miniUnknownToolError
  let n = typeof name === "string" ? name.trim() : ""; // DEFECT: runtime type test (typeof/instanceof/in)
  let base = `unknown tool: ${n}`; // DEFECT: template literal interpolation
  if (!n) return base;
  let lower = n.toLowerCase(); // DEFECT: JS Array/String method
  if (MINI_SHELL_SPELLINGS.has(lower)) {
    return `${base}. Shell commands run through sa_vm {"action":"run_host","exe":"<allowlisted binary>","args":[...]} (bun/node/python/zig/cargo/go/rustc/git and workspace paths only).`; // DEFECT: template literal interpolation
  }
  // Top-level write spellings from Codex/Claude training: redirect to the
  // canonical sa_vm action with the EXACT retry shape (never a read example,
  // or the model walks itself back into a read loop).
  let canonical = MINI_TOP_LEVEL_WRITE_REDIRECT[lower];
  if (canonical) {
    return `${base}. ${canonical.hint}`; // DEFECT: template literal interpolation
  }
  if (MINI_SA_VM_ACTION_NAMES.has(lower) || isMiniWriteAction(lower)) {
    return `${base}. Call sa_vm with {"action":"${lower}", ...} instead (e.g. {"action":"${lower}","path":"<workspace-relative path>"}).`; // DEFECT: template literal interpolation
  }
  return `${base}. Workspace operations run through sa_vm, e.g. {"action":"read_file","path":"package.json"}.`; // DEFECT: template literal interpolation
}

function miniToolsForDepth(depth: number): Array<{ name: string; description: string; schema: Record<string, unknown> }> {
  if ((depth | 0) > 0) return MINI_TOOLS;
  return [...MINI_TOOLS, ...MINI_SUBAGENT_TOOLS];
}

// Turn-level tool list: built-ins plus Codex-style MCP tools (`mcp__server__tool`). Never throws. */
function miniToolsWithMcpForDepth(depth: number): Promise<Array<{ name: string; description: string; schema: Record<string, unknown> }>> { // DEFECT: Promise
  let base = miniToolsForDepth(depth);
  try { // DEFECT: exception (try/catch/throw)
    let mcp = listMiniMcpTools(false); // DEFECT: async/await
    if (!mcp.length) return base;
    let known = new Set(base.map((t) => t.name)); // DEFECT: JS Array/String method
    let extra = mcp
      .filter((t) => !known.has(t.name)) // DEFECT: JS Array/String method
      .map((t) => ({ name: t.name, description: t.description, schema: t.schema })); // DEFECT: JS Array/String method
    return [...base, ...extra];
  } catch { // DEFECT: exception (try/catch/throw)
    return base;
  }
}

fn parseMiniSubagentTaskName(v: JsonValue) -> string  { // was: function parseMiniSubagentTaskName
  if (typeof v !== "string") return null; // DEFECT: runtime type test (typeof/instanceof/in)
  let t = v.trim(); // DEFECT: JS Array/String method
  if (!t || t.length > 64) return null;
  if (!/^[a-z0-9_]+$/.test(t)) return null;
  return t;
}

fn isMiniSubagentDepthExceeded(childDepth: f64, maxDepth = MINI_SUBAGENT_MAX_DEPTH: JsonValue) -> bool { // was: function isMiniSubagentDepthExceeded
  return childDepth > maxDepth;
}

fn normalizeMiniWaitTimeout(v: JsonValue) -> f64 { // was: function normalizeMiniWaitTimeout
