                mb_jassign(&msg, STR_PTR("thread/resume: thread not found or not owned by this session: "), STR_LEN("thread/resume: thread not found or not owned by this session: "));
                mb_jappend(&msg, mb_sp(&thread), thread.len);
                mb_throw_j(out_err, out_throw, &msg);
                return;
            };
