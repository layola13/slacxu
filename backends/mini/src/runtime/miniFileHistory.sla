    agentType: [u8; 128], agentType_len: u64, has_agentType: bool,
    subStatus: [u8; 128], subStatus_len: u64, has_subStatus: bool,
    finalReport: [u8; 65536], finalReport_len: u64, has_finalReport: bool,
    archived: bool, has_archived: bool,
    sandbox: [u8; 128], sandbox_len: u64, has_sandbox: bool,
    approvalPolicy: [u8; 128], approvalPolicy_len: u64, has_approvalPolicy: bool,
    goalObjective: [u8; 4096], goalObjective_len: u64, goalObjective_is_null: bool, has_goalObjective: bool,
