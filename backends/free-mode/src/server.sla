// Converted 1:1 from backends/free-mode/src/server.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
//
// Free (money-saving) mode — server side (kind "feature"). Owns the
// free-compaction relay request logic (`src/free/
// compactionRelayRequest.ts`, moved verbatim from the host): route
// resolution, model/tool rewriting and fallback tracking for free
// compaction through the relay engine (cxu-backend-relay-config).
// The workbench server imports it via a staging import, as before.

@import "manifest.sla"
// Re-export forwarding (source: export { FREE_MODE_MANIFEST } from "./manifest.js";
// export * from "./free/compactionRelayRequest.js";)
@import "free/compactionRelayRequest.sla"

// DEFECT: TS class + interface (ServicePlugin from @cxu/sdk-backend) — no
// classes/interfaces in SLA; class becomes a struct + function family with
// &Struct first parameter, method names preserved.
struct FreeModeService {
    manifest: FreeModeManifest,
}

// DEFECT: async start(_host: ServiceHost): Promise<void> — converted to a
// synchronous function returning a status code (0 = ok).
// Pure request-shaping library at the service layer; the host
// drives it per compaction request, as before the move.
fn FreeModeService_start(self: &FreeModeService, host: u64) -> i32 {
    return 0;
}

// DEFECT: async stop(): Promise<void> — synchronous status-code form.
fn FreeModeService_stop(self: &FreeModeService) -> i32 {
    return 0;
}

// Source: export const freeModeServicePlugin: ServicePlugin = new FreeModeService();
// DEFECT: module-level singleton instance; represented as an init function the
// host calls once (no module-level mutable state in SLA).
fn freeModeServicePlugin_init(out: &FreeModeService) -> void {
    out.manifest.json_len = 0;
}
