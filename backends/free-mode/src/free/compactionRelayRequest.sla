fn rewriteRelayRequestModel(body_ptr: ptr, body_len: u64, model_ptr: ptr, model_len: u64, out_body: &JsonBuf) -> i32 {
    // DEFECT: spread { ...body, model } + JSON.stringify over a dynamic object
