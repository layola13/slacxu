// DEFECT: async + Web Fetch API — TS:
//   rewriteRelayRequestToolsForSaVm(request: Request, _toolsConfig?: SaVmToolsConfig): Promise<Request>
// Approximation: body JSON text in, rewritten body JSON text out (tools array
// filtered through isSaVmBlockedToolName); status 0 = rewritten, 1 = unchanged.
fn rewriteRelayRequestToolsForSaVm(body_ptr: ptr, body_len: u64, tools_config_doc: u64, out_body: &JsonBuf) -> i32 {
    // VM enablement is the security boundary. Tool replacement toggles control
    // convenience routing, but must never re-expose a host shell to the model.
    // Source flow: body.tools must be a non-empty array, else return request
    // unchanged; filter tools whose name (rec.name ?? rec.function.name) is
    // blocked; if nothing was filtered, return request unchanged.
    // DEFECT: dynamic array filter over JSON — sa_json_array_get iteration +
    // rebuild of the tools array as JSON text.
    return 1;
}

struct CompactionRelayRoute {
    providerId: [u8; 256],
    providerId_len: u64,
    groupId: [u8; 256],
    groupId_len: u64,
    model: [u8; 256],
    model_len: u64,
}

struct FreeCompactionFailureState {
    operationId: [u8; 256],
    operationId_len: u64,
    failures: u64,
    forceNative: bool,
    updatedAt: u64,
    threadId: [u8; 256],
    threadId_len: u64,
    occupied: bool,
}

// DEFECT: TS class with Map<string, FreeCompactionFailureState> — Map becomes
// a fixed-capacity table (64 entries) with linear lookup; class becomes
// struct + function family (method names preserved).
struct FreeCompactionFallbackTracker {
    states: [FreeCompactionFailureState; 64],
    states_len: u64,
    maxFreeFailures: u64,
    staleAfterMs: u64,
}

fn FreeCompactionFallbackTracker_new(maxFreeFailures: u64, staleAfterMs: u64, out: &FreeCompactionFallbackTracker) -> void {
    out.states_len = 0;
    out.maxFreeFailures = maxFreeFailures; // source default: 3
    out.staleAfterMs = staleAfterMs;       // source default: 30 * 60_000
}

// DEFECT: `now = Date.now()` default parameter — SLA has no wall-clock
// default; callers pass `now` explicitly (ms).
fn FreeCompactionFallbackTracker_currentState(self: &FreeCompactionFallbackTracker, threadId_ptr: ptr, threadId_len: u64, operationId_ptr: ptr, operationId_len: u64, now: u64, out: &FreeCompactionFailureState) -> bool {
    // Source: state = states.get(threadId); if (!state) return null;
    // if (state.operationId !== operationId || now - state.updatedAt >= staleAfterMs)
    //   { states.delete(threadId); return null; } return state;
    // DEFECT: string-key Map lookup/delete over the fixed table (byte compare).
    return false;
}

fn FreeCompactionFallbackTracker_shouldUseNative(self: &FreeCompactionFallbackTracker, threadId_ptr: ptr, threadId_len: u64, operationId_ptr: ptr, operationId_len: u64, now: u64) -> bool {
    let state = FreeCompactionFailureState { operationId: [0u8; 256], operationId_len: 0, failures: 0, forceNative: false, updatedAt: 0, threadId: [0u8; 256], threadId_len: 0, occupied: false };
    if !FreeCompactionFallbackTracker_currentState(self, threadId_ptr, threadId_len, operationId_ptr, operationId_len, now, &state) {
        return false;
    };
    return state.forceNative;
}

struct RecordFailureResult {
    failures: u64,
    fallbackNow: bool,
}

fn FreeCompactionFallbackTracker_recordFailure(self: &FreeCompactionFallbackTracker, threadId_ptr: ptr, threadId_len: u64, operationId_ptr: ptr, operationId_len: u64, now: u64, out: &RecordFailureResult) -> void {
    let previous = FreeCompactionFailureState { operationId: [0u8; 256], operationId_len: 0, failures: 0, forceNative: false, updatedAt: 0, threadId: [0u8; 256], threadId_len: 0, occupied: false };
    let has_prev = FreeCompactionFallbackTracker_currentState(self, threadId_ptr, threadId_len, operationId_ptr, operationId_len, now, &previous);
    let failures: u64 = 1;
    if has_prev { failures = previous.failures + 1; };
    let fallbackNow = failures >= self.maxFreeFailures;
    // Source: states.set(threadId, { operationId, failures, forceNative: fallbackNow, updatedAt: now })
    // DEFECT: Map set over the fixed table (insert-or-replace by threadId bytes).
    out.failures = failures;
    out.fallbackNow = fallbackNow;
}

fn FreeCompactionFallbackTracker_clear(self: &FreeCompactionFallbackTracker, threadId_ptr: ptr, threadId_len: u64) -> void {
    // Source: states.delete(threadId) — DEFECT: table delete by byte key.
}

fn isFreeCompactionFallbackStatus(status: u64) -> bool {
    return status == 429 || status >= 500;
}

// DEFECT: ThreadRuntimeMetadata is a shared-package dynamic type
// (@codex-ui/shared); consumed here as a JSON document handle with the four
// freeAutoCompact* members probed via sa_json_object_get_*.
fn resolveCompactionRelayRoute(metadata_doc: u64, out: &CompactionRelayRoute) -> bool {
    if metadata_doc == 0 { return false; };
    let enabled: bool = false;
    if sa_json_object_get_bool(metadata_doc, STR_PTR("freeAutoCompactEnabled"), STR_LEN("freeAutoCompactEnabled"), &enabled) != 0 {
        return false;
    };
    if !enabled { return false; };
    // manual* = metadata.freeAutoCompact{ProviderId,GroupId,Model}?.trim()
    // If any manual value present: all three must be non-empty and model must
    // not be "big-pickle" (case-insensitive), else null. Otherwise null.
    // DEFECT: optional chaining + trim + toLowerCase over dynamic members —
    // probed with sa_json_object_get_string in the fix phase.
    return false;
}
