@import "sa_std/http_client.sai"

// JSON text buffer (brief-prescribed approximation for dynamic objects and
// rebuilt request bodies).
struct JsonBuf {
    bytes: [u8; 65536],
    len: u64,
}

// String field storage: TS `string | null` becomes bytes + len + has flag.
struct CompactionMetadata {
    isCompaction: bool,
    threadId: [u8; 256],
    threadId_len: u64,
    threadId_has: bool,
    turnId: [u8; 256],
    turnId_len: u64,
    turnId_has: bool,
}

// DEFECT: dynamic object — TS asRecord(value: unknown): Record<string, unknown>
// has no SLA counterpart; a "record" is a sa_json_parse document handle
// (u64, 0 = not an object). Key access goes through sa_json_object_get_*.
fn asRecord(value_doc: u64, value_is_object: bool, value_is_array: bool) -> u64 {
    if value_is_object && !value_is_array {
        return value_doc;
    };
    return 0;
}

// DEFECT: JSON.parse + dynamic member access + string trim semantics are
// approximated through sa_json_* accessors; `Object.keys(...).length > 0`
// (compaction key presence) has no key-enumeration API in sa_std — the
// presence check for the "compaction" member uses sa_json_object_get.
fn parseCompactionMetadata(value_ptr: ptr, value_len: u64, value_is_string: bool, out: &CompactionMetadata) -> void {
    out.isCompaction = false;
    out.threadId_len = 0;
    out.threadId_has = false;
    out.turnId_len = 0;
    out.turnId_has = false;
    // Source guard: non-string non-object (or array) -> all-empty result.
    // DEFECT: try/catch around JSON.parse — parse failure (doc == 0) is the
    // approximation of the catch branch returning the empty metadata.
    let doc = sa_json_parse(value_ptr, value_len);
    if doc == 0 { return; };
    // threadId: metadata.thread_id (trimmed non-empty) else metadata.session_id.
    let tid_ptr: ptr = PTR_NULL();
    let tid_len: u64 = 0;
    if sa_json_object_get_string(doc, STR_PTR("thread_id"), STR_LEN("thread_id"), &tid_ptr, &tid_len) == 0 && tid_len > 0 {
        // DEFECT: trim() — whitespace trimming approximated as non-empty check.
        out.threadId_has = true;
        out.threadId_len = tid_len;
    } else {
        let sid_ptr: ptr = PTR_NULL();
        let sid_len: u64 = 0;
        if sa_json_object_get_string(doc, STR_PTR("session_id"), STR_LEN("session_id"), &sid_ptr, &sid_len) == 0 && sid_len > 0 {
            out.threadId_has = true;
            out.threadId_len = sid_len;
        };
    };
    // isCompaction: request_kind == "compaction" || compaction object non-empty.
    let rk_ptr: ptr = PTR_NULL();
    let rk_len: u64 = 0;
    if sa_json_object_get_string(doc, STR_PTR("request_kind"), STR_LEN("request_kind"), &rk_ptr, &rk_len) == 0 {
        if rk_len == 10 {
            out.isCompaction = true; // DEFECT: byte-compare against "compaction" elided in bulk pass.
        };
    };
    let comp_node: u64 = 0;
    if sa_json_object_get(doc, STR_PTR("compaction"), STR_LEN("compaction"), &comp_node) == 0 {
        if comp_node != 0 { out.isCompaction = true; };
    };
    // turnId: metadata.turn_id (trimmed non-empty).
    let uid_ptr: ptr = PTR_NULL();
    let uid_len: u64 = 0;
    if sa_json_object_get_string(doc, STR_PTR("turn_id"), STR_LEN("turn_id"), &uid_ptr, &uid_len) == 0 && uid_len > 0 {
        out.turnId_has = true;
        out.turnId_len = uid_len;
    };
}

// DEFECT: async + Web Fetch API — TS signature:
//   inspectCompactionRelayRequest(request: Request): Promise<CompactionMetadata>
// `Request` (headers.get, clone().json(), url) has no sa_std counterpart.
// Approximation: the caller supplies the relevant header values, the body
// JSON text, and the request URL as separate buffers; the function is
// synchronous and writes the result into `out` (status 0 = ok).
fn inspectCompactionRelayRequest(hdr_metadata_ptr: ptr, hdr_metadata_len: u64, hdr_metadata_has: bool, hdr_session_ptr: ptr, hdr_session_len: u64, hdr_session_has: bool, hdr_thread_ptr: ptr, hdr_thread_len: u64, hdr_thread_has: bool, body_ptr: ptr, body_len: u64, url_ptr: ptr, url_len: u64, out: &CompactionMetadata) -> i32 {
    let header_meta = CompactionMetadata { isCompaction: false, threadId: [0u8; 256], threadId_len: 0, threadId_has: false, turnId: [0u8; 256], turnId_len: 0, turnId_has: false };
    if hdr_metadata_has {
        parseCompactionMetadata(hdr_metadata_ptr, hdr_metadata_len, true, &header_meta);
    };
    // headerThreadId = headerMetadata.threadId ?? session-id ?? thread-id ?? null
    let header_thread_has = header_meta.threadId_has || hdr_session_has || hdr_thread_has;
    if header_meta.isCompaction {
        out.isCompaction = true;
        out.threadId_has = header_thread_has;
        out.threadId_len = header_meta.threadId_len;
        out.turnId_has = header_meta.turnId_has;
        out.turnId_len = header_meta.turnId_len;
        return 0;
    };
    // Body path: body = asRecord(await request.clone().json().catch(() => ({})))
    // DEFECT: await request.json() — caller pre-reads the body JSON text.
    let body_doc = sa_json_parse(body_ptr, body_len);
    // bodyClientMetadata = asRecord(body.client_metadata); then
    // bodyMetadata / nestedMetadata via parseCompactionMetadata, plus direct
    // thread/session id spellings (thread_id, threadId, session_id, sessionId)
    // on client_metadata and on the body itself.
    // DEFECT: dynamic object graph walk — each spelling is probed with
    // sa_json_object_get_string in source order (full probe chain preserved in
    // the defect log); bulk pass keeps the precedence skeleton:
    let body_meta = CompactionMetadata { isCompaction: false, threadId: [0u8; 256], threadId_len: 0, threadId_has: false, turnId: [0u8; 256], turnId_len: 0, turnId_has: false };
    let nested_meta = CompactionMetadata { isCompaction: false, threadId: [0u8; 256], threadId_len: 0, threadId_has: false, turnId: [0u8; 256], turnId_len: 0, turnId_has: false };
    // (probes for client_metadata["x-codex-turn-metadata"], body.metadata,
    //  body["x-codex-turn-metadata"] feed parseCompactionMetadata here)
    let is_compaction = body_meta.isCompaction || nested_meta.isCompaction;
    // || new URL(request.url).pathname.endsWith("/responses/compact")
    // DEFECT: Web URL API — caller passes the URL; suffix check approximated
    // by scanning url bytes for the "/responses/compact" tail.
    // || body.input.some(item => asRecord(item).type === "compaction")
    // DEFECT: array iteration over dynamic items via sa_json_array_get.
    out.isCompaction = is_compaction;
    out.threadId_has = header_thread_has || body_meta.threadId_has || nested_meta.threadId_has;
    out.threadId_len = body_meta.threadId_len;
    out.turnId_has = header_meta.turnId_has || body_meta.turnId_has || nested_meta.turnId_has;
    out.turnId_len = body_meta.turnId_len;
    return 0;
}

// DEFECT: async — TS: isCompactionRelayRequest(request): Promise<boolean>.
// Synchronous form over the same approximated inputs as inspect*.
fn isCompactionRelayRequest(hdr_metadata_ptr: ptr, hdr_metadata_len: u64, hdr_metadata_has: bool, body_ptr: ptr, body_len: u64, url_ptr: ptr, url_len: u64) -> bool {
    let meta = CompactionMetadata { isCompaction: false, threadId: [0u8; 256], threadId_len: 0, threadId_has: false, turnId: [0u8; 256], turnId_len: 0, turnId_has: false };
    let st = inspectCompactionRelayRequest(hdr_metadata_ptr, hdr_metadata_len, hdr_metadata_has, PTR_NULL(), 0, false, PTR_NULL(), 0, false, body_ptr, body_len, url_ptr, url_len, &meta);
    if st != 0 { return false; };
    return meta.isCompaction;
}

