fn isSaVmBlockedToolName(name_ptr: ptr, name_len: u64) -> bool {
    if name_len == 0 { return false; };
    // Source: normalized = name.trim().toLowerCase();
    //         baseName = normalized.split(/[:/]/).pop() ?? normalized;
    //         return SET.has(normalized) || SET.has(baseName) || REGEX.test(normalized)
    // DEFECT: regex /(?:^|[._:/-])(bash|shell|exec|python(?:\d+(?:\.\d+)?)?|py|node(?:js)?|bun(?:x)?|deno|ts-node|tsx|npx|javascript|typescript|js|powershell|pwsh|cmd)(?:$|[._:/-])/i
    // has no SLA counterpart (no regex engine in sa_std) — the set-membership
