// private mapRow(row: PiSessionRow): PiSessionRecord — field-by-field rename
// (thread_id -> threadId, etc.); in SLA both structs share field names, so this
// is a straight copy kept for 1:1 correspondence.
fn pi_session_store_map_row(row: &PiSessionRow, out: &PiSessionRecord) -> i32 {
    out.thread_id_len = row.thread_id_len;
    out.owner_id_len = row.owner_id_len;
    out.session_id_len = row.session_id_len;
    out.has_session_id = row.has_session_id;
    out.cli_version_len = row.cli_version_len;
    out.has_cli_version = row.has_cli_version;
    out.model_len = row.model_len;
    out.has_model = row.has_model;
    out.cwd_len = row.cwd_len;
    out.has_cwd = row.has_cwd;
    out.permission_mode_len = row.permission_mode_len;
    out.has_permission_mode = row.has_permission_mode;
    out.state_json_len = row.state_json_len;
    out.has_state_json = row.has_state_json;
    out.created_at = row.created_at;
    out.updated_at = row.updated_at;
    // DEFECT: byte payloads of the string fields are copied by the SQL layer;
    // only lengths/flags are transferred in this pass.
    return 0;
}
