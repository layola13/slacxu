// Converted 1:1 from backends/pi/src/runtime/piSessionStore.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.

@import "sa_std/io/print.sai"

// Persists Pi CLI session and conversation metadata separately
// from Codex thread IDs. This allows history to remain readable after
// a server restart, and enables resuming existing conversations.
//
// Schema: one row per internal thread ID that uses the Pi backend.

// DEFECT: RuntimeDatabase (SQLite-style prepare/exec/run/get/all from
// @cxu/sdk-backend) has no sa_std counterpart in this pass; the store is
// represented by an opaque db handle value and each SQL statement is kept as a
// string constant next to the function that issues it.

struct PiSessionRecord {
    thread_id: [128]u8,
    thread_id_len: u64,
    owner_id: [128]u8,
    owner_id_len: u64,
    session_id: [256]u8, // string | null
    session_id_len: u64,
    has_session_id: bool,
    cli_version: [64]u8, // string | null
    cli_version_len: u64,
    has_cli_version: bool,
    model: [256]u8, // string | null
    model_len: u64,
    has_model: bool,
    cwd: [1024]u8, // string | null
    cwd_len: u64,
    has_cwd: bool,
    permission_mode: [64]u8, // string | null
    permission_mode_len: u64,
    has_permission_mode: bool,
    state_json: [65536]u8, // string | null (JSON text)
    state_json_len: u64,
    has_state_json: bool,
    created_at: u64,
    updated_at: u64,
}

// PiSessionRow: snake_case mirror of PiSessionRecord as stored in SQLite.
// DEFECT: kept as a separate struct to mirror the source 1:1 even though the
// fields coincide after conversion.
struct PiSessionRow {
    thread_id: [128]u8,
    thread_id_len: u64,
    owner_id: [128]u8,
    owner_id_len: u64,
    session_id: [256]u8,
    session_id_len: u64,
    has_session_id: bool,
    cli_version: [64]u8,
    cli_version_len: u64,
    has_cli_version: bool,
    model: [256]u8,
    model_len: u64,
    has_model: bool,
    cwd: [1024]u8,
    cwd_len: u64,
    has_cwd: bool,
    permission_mode: [64]u8,
    permission_mode_len: u64,
    has_permission_mode: bool,
    state_json: [65536]u8,
    state_json_len: u64,
    has_state_json: bool,
    created_at: u64,
    updated_at: u64,
}

// class PiSessionStore { constructor(private readonly db: RuntimeDatabase) { ... } }
struct PiSessionStore {
    db: u64, // DEFECT: opaque RuntimeDatabase handle
}

// CREATE TABLE statement issued by the constructor (verbatim from source):
// CREATE TABLE IF NOT EXISTS pi_sessions (
//   thread_id TEXT NOT NULL, owner_id TEXT NOT NULL, session_id TEXT,
//   cli_version TEXT, model TEXT, cwd TEXT, permission_mode TEXT,
//   state_json TEXT, created_at INTEGER NOT NULL, updated_at INTEGER NOT NULL,
//   PRIMARY KEY (thread_id, owner_id) );
fn pi_session_store_new(db: u64, out: &PiSessionStore) -> i32 {
    out.db = db;
    // this.db.exec(`CREATE TABLE IF NOT EXISTS pi_sessions (...)`)
    // DEFECT: db.exec of the DDL above is deferred to the SQL layer.
    return 0;
}

// DEFECT: Date.now() has no direct binding here; approximated by an extern clock.
fn pi_session_now_ms() -> u64 {
    return 0;
}

// upsert(input): PiSessionRecord
// SQL (verbatim): INSERT INTO pi_sessions (thread_id, owner_id, session_id,
// cli_version, model, cwd, permission_mode, state_json, created_at, updated_at)
// VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
// ON CONFLICT(thread_id, owner_id) DO UPDATE SET
//   session_id = COALESCE(excluded.session_id, pi_sessions.session_id), ...
//   updated_at = excluded.updated_at
// Each field uses `input.field ?? existing?.field ?? null` merge semantics.
// DEFECT: prepared statement parameter binding + COALESCE upsert deferred to the
// SQL layer; the merge is sketched against `existing` when present.
fn pi_session_store_upsert(store: &PiSessionStore, input: &PiSessionRecord, out: &PiSessionRecord) -> i32 {
    let now = pi_session_now_ms();
    // const existing = this.get(input.ownerId, input.threadId);
    let existing = PiSessionRecord { thread_id: [0u8; 128], thread_id_len: 0, owner_id: [0u8; 128], owner_id_len: 0, session_id: [0u8; 256], session_id_len: 0, has_session_id: false, cli_version: [0u8; 64], cli_version_len: 0, has_cli_version: false, model: [0u8; 256], model_len: 0, has_model: false, cwd: [0u8; 1024], cwd_len: 0, has_cwd: false, permission_mode: [0u8; 64], permission_mode_len: 0, has_permission_mode: false, state_json: [0u8; 65536], state_json_len: 0, has_state_json: false, created_at: 0, updated_at: 0 };
    let has_existing = pi_session_store_get(store, input, &existing) == 0;
    // .run(threadId, ownerId, sessionId ?? existing?.sessionId ?? null, ..., existing?.createdAt ?? now, now)
    // DEFECT: statement execution deferred; out mirrors the merged record shape.
    out.thread_id_len = input.thread_id_len;
    out.owner_id_len = input.owner_id_len;
    out.created_at = now;
    if has_existing { out.created_at = existing.created_at; };
    out.updated_at = now;
    // return this.get(input.ownerId, input.threadId)!;
    // DEFECT: non-null assertion on the re-read; a failed re-read is not modeled.
    return 0;
}

// get(ownerId, threadId): PiSessionRecord | null
// SQL: SELECT * FROM pi_sessions WHERE thread_id = ? AND owner_id = ? LIMIT 1
// Returns 0 and fills out when a row exists, 1 when null.
fn pi_session_store_get(store: &PiSessionStore, key: &PiSessionRecord, out: &PiSessionRecord) -> i32 {
    // const row = this.db.prepare(...).get(threadId, ownerId) as PiSessionRow | undefined;
    // return row ? this.mapRow(row) : null;
    // DEFECT: query execution deferred to the SQL layer.
    return 1;
}

