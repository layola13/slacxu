@import "sa_std/io/print.sai"

// DEFECT: Node APIs node:fs (existsSync/readdirSync), node:path (join),
// node:child_process (spawnSync) and pluginHostServices() from @cxu/sdk-backend
// have no direct sa_std counterpart in this pass; filesystem/process probes are
// approximated with extern-style calls noted per function.

struct PiCliProbeResult {
    available: bool,
    bin_path: [1024]u8,
    bin_path_len: u64,
    version: [64]u8, // version?: string
    has_version: bool,
    configured: bool, // configured?: boolean
    has_configured: bool,
    err: [1024]u8, // error?: string
    err_len: u64,
    has_error: bool,
}

// DEFECT: NodeJS.ProcessEnv is a dynamic string map; env access is approximated by
// (name_ptr, name_len) -> value buffer extern lookups throughout this file.

// Check whether ~/.pi directory exists.
// env: NodeJS.ProcessEnv = process.env
fn is_pi_configured(home_ptr: ptr, home_len: u64) -> bool {
    // const home = env.USERPROFILE ?? env.HOME ?? ""; if (!home) return false;
    if home_len == 0 { return false; };
    // return existsSync(join(home, ".pi"));
    // DEFECT: path join + existsSync approximated by a single fs-exists extern over
    // the caller-assembled "<home>/.pi" path.
    return pi_probe_path_exists(home_ptr, home_len, STR_PTR("/.pi"), STR_LEN("/.pi"));
}

// DEFECT: extern placeholder for existsSync(join(a, b)); no sa_std binding yet.
fn pi_probe_path_exists(a_ptr: ptr, a_len: u64, b_ptr: ptr, b_len: u64) -> bool {
    // Not implemented in this pass (conversion only).
    return false;
}

// DEFECT: extern placeholder for pluginHostServices().cli.* lookups
// (getPreferredCliBinary / getCachedLatestCliPath / enumerateCliCandidates);
// returns the number of bytes written to out, 0 when absent.
fn pi_host_cli_lookup(kind: u64, name_ptr: ptr, name_len: u64, out_ptr: ptr, out_cap: u64) -> u64 {
    return 0;
}

// Find the pi binary path, respecting user selection, env overrides,
// cached enumeration, and standard PATH / npm -g / bun -g / brew / linuxbrew
// locations. 服务端最小 PATH 下必须显式兜底，否则只能回退到裸 `pi` 导致版本未知。
// Writes the result path into out (capacity 1024) and returns its length.
fn find_pi_bin(env_home_ptr: ptr, env_home_len: u64, is_windows: bool, out: &PiCliProbeResult) -> u64 {
    // const preferred = pluginHostServices().cli.getPreferredCliBinary("pi");
    // if (preferred && existsSync(preferred)) return preferred;
    // DEFECT: host-service lookup chain approximated via pi_host_cli_lookup.
    let n = pi_host_cli_lookup(0, STR_PTR("pi"), STR_LEN("pi"), STR_PTR(""), 0);
    if n > 0 { return n; };
    // const latestCached = pluginHostServices().cli.getCachedLatestCliPath("pi");
    // if (latestCached && existsSync(latestCached)) return latestCached;
    n = pi_host_cli_lookup(1, STR_PTR("pi"), STR_LEN("pi"), STR_PTR(""), 0);
    if n > 0 { return n; };
    // const configured = env.PI_BIN || env.CODEX_UI_PI_BIN;
    // if (configured && configured.trim() && existsSync(configured.trim())) return configured.trim();
    // DEFECT: env map reads (PI_BIN / CODEX_UI_PI_BIN) approximated by caller-passed
    // values in the full implementation; omitted here, falls through to enumeration.
    // const candidates = pluginHostServices().cli.enumerateCliCandidates("pi", env, process.platform);
    // if (candidates.length > 0) return candidates[0]!;
    n = pi_host_cli_lookup(2, STR_PTR("pi"), STR_LEN("pi"), STR_PTR(""), 0);
    if n > 0 { return n; };

    if is_windows {
        // Windows candidates (source order preserved):
        //   %APPDATA%/npm/pi.cmd, %APPDATA%/npm/pi.exe,
        //   <home>/.bun/bin/pi.cmd, <home>/.bun/bin/pi.exe,
        //   D:\Program Files\nodejs\pi.cmd,
        //   <ProgramFiles>/nodejs/pi.cmd, <ProgramFiles(x86)>/nodejs/pi.cmd,
        //   D:\Program Files\nodejs\pi.exe,
        //   <ProgramFiles>/nodejs/pi.exe, <ProgramFiles(x86)>/nodejs/pi.exe
        // DEFECT: candidate list is data, not code; each entry would be probed with
        // pi_probe_path_exists in order. Elided in this pass.
        return pi_write_literal(out, STR_PTR("pi"), STR_LEN("pi"));
    };
    // POSIX fallbacks (source order preserved):
    //   <home>/.pi/bin/pi, <home>/bin/pi, /usr/local/bin/pi, /usr/bin/pi,
    //   /opt/bin/pi, /opt/homebrew/bin/pi, /home/linuxbrew/.linuxbrew/bin/pi,
    //   <home>/.linuxbrew/bin/pi, <home>/.local/bin/pi, <home>/.bun/bin/pi,
    //   <home>/.bun/install/global/bin/pi, <home>/.npm-global/bin/pi,
    //   <home>/.codex-ultra/bin/pi, /tools/node/bin/pi,
    //   <npm_config_prefix>/bin/pi, <NVM_BIN>/pi, ...nvmPiBinDirs(home)
    // DEFECT: candidate list is data, not code; each entry would be probed with
    // pi_probe_path_exists in order. Elided in this pass.
    return pi_write_literal(out, STR_PTR("pi"), STR_LEN("pi"));
}

fn pi_write_literal(out: &PiCliProbeResult, p: ptr, len: u64) -> u64 {
    out.bin_path_len = len;
    let i: u64 = 0;
    while i < len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, p, i);
        out.bin_path[i] = b;
        i = i + 1;
    }
    return len;
}

// function nvmPiBinDirs(home: string): string[]
// DEFECT: readdirSync directory enumeration + try/catch has no counterpart here;
// returns a count of "<home>/.nvm/versions/node/<ver>/bin/pi" candidate paths (0 on error).
fn nvm_pi_bin_dirs(home_ptr: ptr, home_len: u64) -> u64 {
    if home_len == 0 { return 0; };
    // try { readdirSync(join(home, ".nvm", "versions", "node"), { withFileTypes: true })
    //   .filter((e) => e.isDirectory()).map((e) => join(root, e.name, "bin", "pi")) }
    // catch { return []; }
    // DEFECT: closure filter/map over directory entries not expressible; count only.
    return 0;
}

// Probe an explicit pi CLI binary for version and availability.
// DEFECT: spawnSync (synchronous child process with timeout/encoding options),
// RegExp version matching (/(\d+\.\d+\.\d+)/, /(\d+\.\d+)/) and try/catch have no
// SLA counterpart in this pass; approximated by an extern spawn-and-capture plus a
// manual digit scan.
fn probe_pi_cli_command(bin_ptr: ptr, bin_len: u64, is_windows: bool, out: &PiCliProbeResult) -> i32 {
    out.bin_path_len = bin_len;
    let i: u64 = 0;
    while i < bin_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, bin_ptr, i);
        out.bin_path[i] = b;
        i = i + 1;
    }
    // const isWindowsNonExe = process.platform === "win32" && !bin.toLowerCase().endsWith(".exe");
    // const proc = spawnSync(bin, ["--version"], { env, encoding: "utf8", timeout: 5000,
    //   windowsHide: true, shell: isWindowsNonExe });
    // DEFECT: spawnSync approximated by status code rc; stdout/stderr capture elided.
    let rc = pi_probe_spawn_version(bin_ptr, bin_len, is_windows);
    if rc < 0 {
        // if (proc.error) return { available: false, binPath: bin, error: proc.error.message };
        out.available = false;
        out.has_error = true;
        return 0;
    };
    // const output = (proc.stdout || proc.stderr || "").trim();
    // const match = output.match(/(\d+\.\d+\.\d+)/) ?? output.match(/(\d+\.\d+)/);
    // const version = match ? match[1] : undefined;
    // DEFECT: regex match approximated by pi_probe_scan_version (not implemented).
    out.available = rc == 0 || out.has_version;
    out.configured = is_pi_configured(bin_ptr, 0);
    out.has_configured = true;
    return 0;
}

// DEFECT: extern placeholder for spawnSync(bin, ["--version"], { timeout: 5000 }).
fn pi_probe_spawn_version(bin_ptr: ptr, bin_len: u64, is_windows: bool) -> i32 {
    return -1;
}
