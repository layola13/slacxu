// have no SLA counterparts in this pass; noted per use below.
// DEFECT: JsonValue is dynamic JSON — every params/result/item in this file is
// carried as JSON text in fixed buffers, with well-known fields extracted.

struct PiTurnRecord {
    id: [128]u8,
    id_len: u64,
    status: [32]u8, // "inProgress" | "completed" | "failed" | "interrupted" | "in_progress"
    status_len: u64,
    created_at: u64,
}

// PiSessionSnapshot (exported interface)
struct PiSessionSnapshot {
    thread_id: [128]u8,
    thread_id_len: u64,
    owner_id: [128]u8, // ownerId?: string
    owner_id_len: u64,
    has_owner_id: bool,
    session_id: [256]u8, // sessionId?: string
    session_id_len: u64,
    has_session_id: bool,
    preview: [512]u8, // preview?: string (source slices to 80 chars)
    preview_len: u64,
    has_preview: bool,
    model: [1024]u8, // model?: string
    model_len: u64,
    has_model: bool,
    developer_instructions: [8192]u8, // developerInstructions?: string
    developer_instructions_len: u64,
    has_developer_instructions: bool,
    cwd: [1024]u8, // cwd?: string
    cwd_len: u64,
    has_cwd: bool,
    turns: [128]PiTurnRecord,
    turns_len: u64,
    // messages: JsonValue[] — DEFECT: dynamic array kept as one JSON text buffer.
    messages_json: [262144]u8,
    messages_json_len: u64,
    messages_count: u64,
}

// PiBridgeOptions: three optional callbacks.
// DEFECT: function-typed options (resolveRelayConfig returning a Promise,
// onSnapshot, loadSnapshot, loadMetadata) cannot be struct fields; they become
// host-registered callback ids resolved by the bridge's call sites.
struct PiBridgeOptions {
    has_resolve_relay_config: bool,
    resolve_relay_config_cb: u64,
    has_on_snapshot: bool,
    on_snapshot_cb: u64,
    has_load_snapshot: bool,
    load_snapshot_cb: u64,
    has_load_metadata: bool,
    load_metadata_cb: u64,
}

// PiSession (internal interface) — snapshot fields + provider/group + runtime.
struct PiSession {
    thread_id: [128]u8,
    thread_id_len: u64,
    owner_id: [128]u8,
    owner_id_len: u64,
    has_owner_id: bool,
    cwd: [1024]u8,
    cwd_len: u64,
    model: [1024]u8,
    model_len: u64,
    has_model: bool,
    developer_instructions: [8192]u8,
    developer_instructions_len: u64,
    has_developer_instructions: bool,
    session_id: [256]u8,
    session_id_len: u64,
    has_session_id: bool,
    provider_id: [128]u8,
    provider_id_len: u64,
    has_provider_id: bool,
    group_id: [128]u8,
    group_id_len: u64,
    has_group_id: bool,
    preview: [512]u8,
    preview_len: u64,
    has_preview: bool,
    active_turn_id: [128]u8, // activeTurnId?: string
    active_turn_id_len: u64,
    has_active_turn_id: bool,
    runtime: PiRuntimeAdapter, // runtime?: PiRuntimeAdapter via has_runtime
    has_runtime: bool,
    turns: [128]PiTurnRecord,
    turns_len: u64,
    messages_json: [262144]u8, // messages: JsonValue[]
    messages_json_len: u64,
    messages_count: u64,
}

// class PiBridge extends EventEmitter implements CodexRuntimeClient
// DEFECT: sessions is Map<string, PiSession> — fixed slot array (capacity 32).
// DEFECT: emit("notification", notif) becomes a host notification sink call.
struct PiBridge {
    options: PiBridgeOptions, // private options?: PiBridgeOptions via has_options
    has_options: bool,
    sessions: [32]PiSession,
    sessions_used: [32]bool,
    sessions_count: u64,
    status_phase: [32]u8, // EngineStatus { phase, transport, message }
    status_phase_len: u64,
    status_transport: [32]u8,
    status_transport_len: u64,
    status_message: [128]u8,
    status_message_len: u64,
}

// export const PI_OFFICIAL_PROVIDER_ID = "pi-relay";
// (value recorded here; referenced by server.sla)

fn pi_bridge_new(opts: &PiBridgeOptions, has_opts: bool, out: &PiBridge) -> i32 {
    out.has_options = has_opts;
    if has_opts { out.options = opts; };
    out.sessions_count = 0;
    let i: u64 = 0;
    while i < 32 {
        out.sessions_used[i] = false;
        i = i + 1;
    }
    // this.status = { phase: "ready", transport: "stdio", message: "Pi coding agent RPC ready" };
    out.status_phase_len = 5; // "ready"
    out.status_transport_len = 5; // "stdio"
    out.status_message_len = 25; // "Pi coding agent RPC ready"
    // DEFECT: status string bytes materialized in the repair phase.
    return 0;
}

// getStatus(): EngineStatus — returns 0; status fields live on the bridge.
fn pi_bridge_get_status(bridge: &PiBridge) -> i32 {
    return 0;
}

// async start(): Promise<EngineStatus> — resets status to ready.
// DEFECT: async — synchronous here.
fn pi_bridge_start(bridge: &PiBridge) -> i32 {
    bridge.status_phase_len = 5; // "ready"
    bridge.status_message_len = 25; // "Pi coding agent RPC ready"
    return 0;
}

// stop(): stop every session runtime, clear sessions, status -> stopped.
fn pi_bridge_stop(bridge: &PiBridge) -> i32 {
    // for (const session of this.sessions.values()) session.runtime?.stop();
    let i: u64 = 0;
    while i < 32 {
        if bridge.sessions_used[i] && bridge.sessions[i].has_runtime {
            pi_runtime_adapter_stop(&bridge.sessions[i].runtime, 3000);
        };
        bridge.sessions_used[i] = false;
        i = i + 1;
    }
    bridge.sessions_count = 0;
    bridge.status_phase_len = 7; // "stopped"
    bridge.status_message_len = 27; // "Pi coding agent RPC stopped"
    return 0;
}

// async restart(): stop() then start().
// DEFECT: async — synchronous here.
fn pi_bridge_restart(bridge: &PiBridge) -> i32 {
    pi_bridge_stop(bridge);
    return pi_bridge_start(bridge);
}

// async notify(_method, _params?): Promise<void> — no-op in source.
// DEFECT: async no-op kept as an empty synchronous function.
fn pi_bridge_notify(bridge: &PiBridge, method_ptr: ptr, method_len: u64) -> i32 {
    return 0;
}

// respond(_id, _result?, _error?): void — no-op in source.
fn pi_bridge_respond(bridge: &PiBridge, id_ptr: ptr, id_len: u64) -> i32 {
    return 0;
}

fn pi_bridge_has_session(bridge: &PiBridge, thread_id_ptr: ptr, thread_id_len: u64) -> bool {
    return pi_bridge_find_session(bridge, thread_id_ptr, thread_id_len) >= 0;
}

// DEFECT: Map lookup by string key approximated by a linear slot scan with
// byte comparison in the repair phase; returns the slot index or -1.
fn pi_bridge_find_session(bridge: &PiBridge, thread_id_ptr: ptr, thread_id_len: u64) -> i64 {
    let i: u64 = 0;
    while i < 32 {
        if bridge.sessions_used[i] && bridge.sessions[i].thread_id_len == thread_id_len {
            // DEFECT: byte equality of the key deferred to a memequal helper.
            return i as i64;
        };
        i = i + 1;
    }
    return -1;
}

fn pi_bridge_delete_session(bridge: &PiBridge, thread_id_ptr: ptr, thread_id_len: u64) -> i32 {
    let idx = pi_bridge_find_session(bridge, thread_id_ptr, thread_id_len);
    if idx >= 0 {
        let s = &bridge.sessions[idx];
        if s.has_runtime { pi_runtime_adapter_stop(&s.runtime, 3000); };
        bridge.sessions_used[idx] = false;
        bridge.sessions_count = bridge.sessions_count - 1;
    };
    return 0;
}

// restoreSession(snapshot): PiSession — merges sessionId/preview/turns/messages
// into an existing session when present; otherwise builds a new PiSession with
// cwd defaulting to process.cwd() and turns/messages defaulting to [].
// DEFECT: process.cwd() default + reference-identity return approximated by
// returning the slot index.
fn pi_bridge_restore_session(bridge: &PiBridge, snap: &PiSessionSnapshot) -> i64 {
    let idx = pi_bridge_find_session(bridge, snap.thread_id, snap.thread_id_len);
    if idx >= 0 {
        let s = &bridge.sessions[idx];
        if snap.has_session_id { s.session_id_len = snap.session_id_len; s.has_session_id = true; };
        if snap.has_preview { s.preview_len = snap.preview_len; s.has_preview = true; };
        s.turns_len = snap.turns_len;
        s.messages_json_len = snap.messages_json_len;
        s.messages_count = snap.messages_count;
        // DEFECT: array/buffer payload copies accompany the lengths in repair.
        return idx;
    };
    // Allocate a fresh slot.
    let slot: u64 = 0;
    let found = false;
    let i: u64 = 0;
    while i < 32 {
        if !bridge.sessions_used[i] && !found {
            slot = i;
            found = true;
        };
        i = i + 1;
    }
    if !found { return -1; };
    let s = &bridge.sessions[slot];
    s.thread_id_len = snap.thread_id_len;
    s.owner_id_len = snap.owner_id_len;
    s.has_owner_id = snap.has_owner_id;
    s.session_id_len = snap.session_id_len;
    s.has_session_id = snap.has_session_id;
    s.preview_len = snap.preview_len;
    s.has_preview = snap.has_preview;
    s.model_len = snap.model_len;
    s.has_model = snap.has_model;
    s.developer_instructions_len = snap.developer_instructions_len;
    s.has_developer_instructions = snap.has_developer_instructions;
    s.cwd_len = snap.cwd_len; // ?? process.cwd() when absent
    s.has_active_turn_id = false;
    s.has_runtime = false;
    s.turns_len = snap.turns_len;
    s.messages_json_len = snap.messages_json_len;
    s.messages_count = snap.messages_count;
    bridge.sessions_used[slot] = true;
    bridge.sessions_count = bridge.sessions_count + 1;
    return slot as i64;
}

