// case "turn/start": (the long case — behavior preserved in source order)
//   1. session = getOrRestoreSession; owner guard: session.ownerId set, not
//      "local", != ownerId -> throw Error(`Pi session belongs to another owner: ${threadId}`).
//      Same guard against storedMeta from loadMetadata when no session.
//      DEFECT: throw -> error return.
//   2. cwd/providerId/groupId/model resolved record -> session -> storedMeta ->
//      defaults (model last default "pi-relay/default");
//      developerInstructions = trimmed record value ?? session's.
//   3. Create the session when missing; else update ownerId/providerId/groupId/
//      model/developerInstructions/cwd.
//   4. relayConfig = await options.resolveRelayConfig(providerId, groupId, model).
//      DEFECT: await on a callback Promise.
//   5. runtime: new PiRuntimeAdapter({ threadId, cwd, sessionId, model,
//      relayConfig }) + wireRuntimeEvents + session.runtime = runtime; else
//      runtime.updateConfig({ cwd, sessionId, model, relayConfig }).
//   6. Active turn: interrupt() the runtime; if the previous turn is still
//      inProgress/in_progress mark it "interrupted" and emit turn/interrupted.
//   7. turnId = randomUUID(); prompt assembly: record.input array — text items
//      append text + "\n" to promptText, other items go to attachmentBlocks;
//      else record.prompt string. cleanPrompt = promptText.trim();
//      executionPrompt = developerInstructions ?
//        `${developerInstructions}\n\n[User Instruction]\n${cleanPrompt}` : cleanPrompt.
//      userItem (type userMessage, id `pi-user-${turnId}`, content = text block
//      { type: "text", text: cleanPrompt, text_elements: [] } + attachments,
//      status completed, startedAt/completedAt = floor(Date.now()/1000)) pushed
//      to messages; turn { turnId, inProgress, Date.now() } pushed; activeTurnId
//      set; preview = cleanPrompt.slice(0, 80) when unset; persistSession;
//      emit turn/started + item/completed(userItem).
//   8. void runtime.executeTurn(executionPrompt, turnId).catch(err => { ... }):
//      only when the turn is still the active inProgress one — build errItem
//      (type agentMessage, id `pi-err-${turnId}`, status failed; message
//      enriched when /spawn|ENOENT|not found|Failed to spawn|not running or
//      stdin/i matches: appends "(pi CLI 未找到或无法启动：请安装 pi，或设置
//      PI_BIN / CODEX_UI_PI_BIN 指向 pi 可执行文件；relay 扩展缺失时设置
//      CODEX_UI_PI_RELAY_EXTENSION)"), push errItem, turn failed, clear
//      activeTurnId, persist, emit item/completed + turn/failed.
//      DEFECT: fire-and-forget Promise + .catch closure + RegExp test — the
//      background turn becomes a poll loop in the repair phase; the regex
//      becomes a substring scan.
//   9. return { turn: { id: turnId, threadId, status: "inProgress" }, turnId }.
fn pi_bridge_req_turn_start(bridge: &PiBridge, params_json_ptr: ptr, params_json_len: u64) -> i32 {
