// Pi Agent RPC protocol types and message framing.
// Reference: E:\projects\pi\packages\coding-agent\src\modes\rpc\rpc-types.ts

// ============================================================================
// Commands (stdin)
// ============================================================================

// DEFECT: TS discriminated union PiRpcCommand (15 variants + open string index
// signature) has no union-type counterpart; represented as one struct with a
// `type` tag field plus all variant fields, and the raw JSON text buffer.
struct PiRpcCommand {
    type_bytes: [u8; 32], // "prompt" | "steer" | "follow_up" | "abort" | "new_session" |
                        // "get_state" | "set_model" | "get_available_models" |
                        // "set_thinking_level" | "set_steering_mode" |
                        // "set_follow_up_mode" | "compact" | "set_auto_retry" |
                        // "get_messages" | "get_session_stats" | string
    type_len: u64,
    has_id: bool,
    id: [u8; 128],
    id_len: u64,
    message: [u8; 8192], // prompt/steer/follow_up
    message_len: u64,
    has_images: bool, // images?: unknown[] — DEFECT: dynamic array, kept as JSON text
    images_json: [u8; 4096],
    images_json_len: u64,
    streaming_behavior: [u8; 16], // streamingBehavior?: "steer" | "followUp"
    streaming_behavior_len: u64,
    parent_session: [u8; 256], // new_session.parentSession?: string
    parent_session_len: u64,
    provider: [u8; 128], // set_model.provider
    provider_len: u64,
    model_id: [u8; 128], // set_model.modelId
    model_id_len: u64,
    level: [u8; 32], // set_thinking_level.level
    level_len: u64,
    mode: [u8; 16], // set_steering_mode / set_follow_up_mode: "all" | "one-at-a-time"
    mode_len: u64,
    custom_instructions: [u8; 4096], // compact.customInstructions?: string
    custom_instructions_len: u64,
    enabled: bool, // set_auto_retry.enabled
    // DEFECT: open index signature [key: string]: unknown — extra fields only
    // survive in the raw JSON buffer.
    raw_json: [u8; 16384],
    raw_json_len: u64,
}

// ============================================================================
// Responses (stdout)
// ============================================================================

// PiRpcResponseSuccess / PiRpcResponseError merged; `success` is the discriminant.
// DEFECT: union type merged into one struct; data?: unknown kept as JSON text.
struct PiRpcResponse {
    has_id: bool,
    id: [u8; 128],
    id_len: u64,
    // type: "response" (constant)
    command: [u8; 64],
    command_len: u64,
    success: bool,
    has_data: bool,
    data_json: [u8; 16384], // data?: unknown
    data_json_len: u64,
    err: [u8; 2048], // error: string (error variant only)
    err_len: u64,
}

// ============================================================================
// Extension UI Requests & Responses
// ============================================================================

struct PiRpcExtensionUIRequest {
    // type: "extension_ui_request" (constant)
    id: [u8; 128],
    id_len: u64,
    method: [u8; 32], // "select" | "confirm" | "input" | "editor" | "notify" |
                    // "setStatus" | "setWidget" | "setTitle" | string
    method_len: u64,
    title: [u8; 512],
    title_len: u64,
    has_title: bool,
    message: [u8; 2048],
    message_len: u64,
    has_message: bool,
    options: [u8; 2048], // options?: string[] as JSON text
    options_len: u64,   // DEFECT: string array approximated as JSON text buffer
    has_options: bool,
    placeholder: [u8; 512],
    placeholder_len: u64,
    has_placeholder: bool,
    timeout_ms: u64,
    has_timeout: bool,
    // DEFECT: open index signature [key: string]: unknown — raw JSON only.
    raw_json: [u8; 16384],
    raw_json_len: u64,
}

// PiRpcExtensionUIResponse union (value | confirmed | cancelled variants).
// DEFECT: union merged into one struct; variant selected by has_value/has_confirmed/cancelled.
struct PiRpcExtensionUIResponse {
    // type: "extension_ui_response" (constant)
    id: [u8; 128],
    id_len: u64,
    has_value: bool,
    value: [u8; 2048],
    value_len: u64,
    has_confirmed: bool,
    confirmed: bool,
    cancelled: bool,
}

