    id_len: u64,
    has_id: bool,
    name: [u8; 128],
    name_len: u64,
    has_name: bool,
    has_arguments: bool,
    arguments_json: [u8; 8192], // arguments?: unknown
    arguments_json_len: u64,
    raw_json: [u8; 16384],
    raw_json_len: u64,
}

