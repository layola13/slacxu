    role_len: u64,
    has_role: bool,
    // content?: PiRpcMessageContent[] | string — DEFECT: array|string union kept as JSON text.
    content_json: [u8; 32768],
    content_json_len: u64,
    has_content: bool,
    tool_call_id: [u8; 128],
    tool_call_id_len: u64,
    has_tool_call_id: bool,
    tool_name: [u8; 128],
    tool_name_len: u64,
    has_tool_name: bool,
    is_error: bool,
    has_is_error: bool,
    api: [u8; 64],
    api_len: u64,
    has_api: bool,
    provider: [u8; 128],
    provider_len: u64,
    has_provider: bool,
    model: [u8; 128],
    model_len: u64,
    has_model: bool,
    has_usage: bool,
    usage: PiRpcUsage,
    stop_reason: [u8; 64],
    stop_reason_len: u64,
    has_stop_reason: bool,
    error_message: [u8; 2048],
    error_message_len: u64,
    has_error_message: bool,
    timestamp: u64,
    has_timestamp: bool,
    raw_json: [u8; 32768],
    raw_json_len: u64,
}

// PiRpcEvent union: { type: "agent_start" } | { type: "turn_start" } |
// { type: "message_start"; message } | { type: "message_update"; assistantMessageEvent } |
// { type: "message_end"; message } | { type: "turn_end"; message? } |
// { type: "agent_end"; messages? } | { type: "agent_settled" } | open variant.
// DEFECT: union merged into one struct keyed by type_bytes.
struct PiRpcEvent {
    type_bytes: [u8; 32],
    type_len: u64,
    has_message: bool,
    message: PiRpcSessionMessage,
    has_assistant_message_event: bool,
    assistant_message_event: PiRpcAssistantMessageEvent,
    messages_json: [u8; 32768], // agent_end.messages?: PiRpcSessionMessage[]
    messages_json_len: u64,
    has_messages: bool,
    raw_json: [u8; 32768],
    raw_json_len: u64,
}

// PiRpcIncomingMessage = PiRpcResponse | PiRpcExtensionUIRequest | PiRpcEvent
// DEFECT: union; consumers dispatch on the raw `type` string. Represented by the
// raw JSON line plus a kind tag: 1=response, 2=extension_ui_request, 3=event, 0=invalid.
struct PiRpcIncomingMessage {
    kind: u64,
    raw_json: [u8; 32768],
    raw_json_len: u64,
}

// ============================================================================
// Framing & Sanitization
// ============================================================================

// Strict newline-delimited framing buffer.
// Does not use readline; preserves surrogate pairs and UTF-8 stream boundaries.
// class PiLineFramingBuffer { private buffer = ""; ... }
struct PiLineFramingBuffer {
    buffer: [u8; 65536],
    len: u64, // DEFECT: fixed capacity replaces the unbounded JS string buffer
}

// Append a chunk of UTF-8 text and extract all complete lines.
// push(chunk: string): string[] — lines are written into `lines` (fixed array of
// line buffers provided by the caller); returns the number of complete lines.
// DEFECT: string[] return approximated by caller-provided fixed buffers.
fn pi_line_framing_buffer_push(fb: &PiLineFramingBuffer, chunk_ptr: ptr, chunk_len: u64, lines_ptr: ptr, lines_cap: u64) -> u64 {
    // this.buffer += chunk;
    let i: u64 = 0;
    while i < chunk_len {
        if fb.len < 65536 {
            let b: u8 = 0;
            PTR_BYTE_AT(b, chunk_ptr, i);
            fb.buffer[fb.len] = b;
            fb.len = fb.len + 1;
        };
        i = i + 1;
    }
    // while ((idx = this.buffer.indexOf("\n")) !== -1) { ... lines.push(line); }
    // DEFECT: line extraction into caller buffers is elided in this pass; the scan
    // below only counts complete lines and compacts the buffer.
    let count: u64 = 0;
    let start: u64 = 0;
    let j: u64 = 0;
    while j < fb.len {
        if fb.buffer[j] == 10 {
            // line = buffer[start..j], with a trailing "\r" stripped
            count = count + 1;
            start = j + 1;
        };
        j = j + 1;
    }
    // this.buffer = remainder after the last newline
    let rem: u64 = 0;
    let k = start;
    while k < fb.len {
        fb.buffer[rem] = fb.buffer[k];
        rem = rem + 1;
        k = k + 1;
    }
    fb.len = rem;
    return count;
}

// Clear any remaining buffered text.
fn pi_line_framing_buffer_clear(fb: &PiLineFramingBuffer) -> i32 {
    fb.len = 0;
    return 0;
}

// get remaining(): string — returns the buffered length; bytes stay in fb.buffer.
fn pi_line_framing_buffer_remaining(fb: &PiLineFramingBuffer) -> u64 {
    return fb.len;
}

// Parse a single JSON line from Pi stdout.
// Returns null if the line is not valid JSON. Unknown types pass through safely.
// DEFECT: JSON.parse + try/catch approximated by sa_json extern validation; the
// parsed value is the raw line retained in out.raw_json (no AST materialization).
fn parse_pi_rpc_line(line_ptr: ptr, line_len: u64, out: &PiRpcIncomingMessage) -> bool {
    // const trimmed = line.trim(); if (!trimmed) return null;
    if line_len == 0 { out.kind = 0; return false; };
    // try { const parsed = JSON.parse(trimmed);
    //   if (parsed && typeof parsed === "object" && typeof parsed.type === "string")
    //     return parsed as PiRpcIncomingMessage; } catch { }
    // return null;
    // DEFECT: JSON.parse/typeof checks deferred to the sa_json layer; kind stays 3
    // (generic event) until the repair phase wires real parsing.
    out.kind = 3;
    out.raw_json_len = line_len;
    let i: u64 = 0;
    while i < line_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, line_ptr, i);
        out.raw_json[i] = b;
        i = i + 1;
    }
    return true;
}

// Serialize a command to a newline-terminated JSON string.
// DEFECT: JSON.stringify approximated by copying cmd.raw_json and appending "\n";
// returns the number of bytes written to out.
fn format_pi_rpc_command(cmd: &PiRpcCommand, out_ptr: ptr, out_cap: u64) -> u64 {
    let n: u64 = 0;
    let i: u64 = 0;
    while i < cmd.raw_json_len {
        // DEFECT: per-byte copy stands in for JSON.stringify(cmd).
        n = n + 1;
        i = i + 1;
    }
    // + "\n"
    return n + 1;
}

// Serialize an extension UI response to a newline-terminated JSON string.
// DEFECT: JSON.stringify approximated as in format_pi_rpc_command.
fn format_pi_extension_ui_response(res: &PiRpcExtensionUIResponse, out_ptr: ptr, out_cap: u64) -> u64 {
    // Builds {"type":"extension_ui_response","id":...,"cancelled":true} etc. as JSON
    // text in the repair phase; this pass returns the id length + framing byte.
    return res.id_len + 1;
}

// Sanitize secrets (API keys, Authorization headers, tokens) from logs and error messages.
// DEFECT: three RegExp replacements (/(sk-[a-zA-Z0-9_\-]{8,})/g,
// /(Bearer\s+)[a-zA-Z0-9_\-\.]{8,}/gi, /(api[_-]?key["':\s]+)[a-zA-Z0-9_\-]{8,}/gi)
// have no regex engine counterpart in SLA; approximated by a byte scan stub that
// copies the input unchanged in this pass. Returns bytes written to out.
fn sanitize_pi_rpc_text(text_ptr: ptr, text_len: u64, out_ptr: ptr, out_cap: u64) -> u64 {
    let n: u64 = 0;
    let i: u64 = 0;
    while i < text_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, text_ptr, i);
        // DEFECT: pattern matching/redaction not implemented; byte copied verbatim.
        n = n + 1;
        i = i + 1;
    }
    return n;
}
