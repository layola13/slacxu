                        // "text_start" | "text_delta" | "text_end" |
                        // "toolcall_start" | "toolcall_delta" | "toolcall_end" | string
    type_len: u64,
    content_index: u64,
    has_content_index: bool,
    delta: [u8; 8192],
    delta_len: u64,
    has_delta: bool,
    content: [u8; 8192],
    content_len: u64,
    has_content: bool,
    id: [u8; 128],
    id_len: u64,
    has_id: bool,
    tool_name: [u8; 128],
    tool_name_len: u64,
    has_tool_name: bool,
    name: [u8; 128],
    name_len: u64,
    has_name: bool,
    has_arguments: bool,
    arguments_json: [u8; 8192],
    arguments_json_len: u64,
    has_tool_call: bool,
    tool_call_json: [u8; 8192], // toolCall?: unknown
    tool_call_json_len: u64,
    has_partial: bool,
    partial_json: [u8; 16384], // partial?: unknown
    partial_json_len: u64,
    raw_json: [u8; 32768],
    raw_json_len: u64,
}

struct PiRpcUsage {
    input: u64,
    output: u64,
    cache_read: u64,
    cache_write: u64,
    total_tokens: u64,
    has_cost: bool,
    cost_input: f64,
    cost_output: f64,
    cost_cache_read: f64,
    cost_cache_write: f64,
    cost_total: f64,
}

struct PiRpcSessionMessage {
