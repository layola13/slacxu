// Converted 1:1 from backends/pi/src/runtime/piTurnProjector.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.

@import "sa_std/io/print.sai"
@import "piRpcProtocol.sla"

// DEFECT: JsonValue / JsonRpcNotification from @codex-ui/shared are dynamic JSON;
// every item/notification in this file is carried as JSON text in fixed buffers.
// DEFECT: Map<string, ...> fields of PiProjectorContext become fixed slot arrays
// (capacity 64) with parallel key buffers; Map iteration order = insertion order
// is preserved by slot order.

// PiProjectedEvent discriminated union (kind tag):
//   1 "turn/started"        { threadId, turnId }
//   2 "turn/completed"      { threadId, turnId, usage? }
//   3 "turn/failed"         { threadId, turnId, error? }
//   4 "turn/interrupted"    { threadId, turnId }
//   5 "item/agentMessage/delta"  { threadId, turnId, itemId, delta }
//   6 "item/reasoning/textDelta" { threadId, turnId, itemId, delta }
//   7 "item/started"        { threadId, turnId, item }
//   8 "item/completed"      { threadId, turnId, item }
//   9 "system/init"         { threadId, sessionId? }
struct PiProjectedEvent {
    kind: u64,
    thread_id: [128]u8,
    thread_id_len: u64,
    turn_id: [128]u8,
    turn_id_len: u64,
    item_id: [256]u8,
    item_id_len: u64,
    delta: [32768]u8,
    delta_len: u64,
    err: [2048]u8,
    err_len: u64,
    has_error: bool,
    item_json: [65536]u8, // item: Record<string, JsonValue> as JSON text
    item_json_len: u64,
    has_usage: bool,
    usage: PiRpcUsage,
    session_id: [256]u8,
    session_id_len: u64,
    has_session_id: bool,
}

// Event list returned by projectPiMessage / forceTerminatePi (source: PiProjectedEvent[]).
// DEFECT: dynamic array approximated by fixed capacity 128.
struct PiProjectedEvents {
    items: [128]PiProjectedEvent,
    len: u64,
}

struct PiProjectorContext {
    thread_id: [128]u8,
    thread_id_len: u64,
    turn_id: [128]u8,
    turn_id_len: u64,
    session_id: [256]u8,
    session_id_len: u64,
    has_session_id: bool,
    status: u64, // 0 "running" | 1 "completed" | 2 "failed" | 3 "interrupted"
    message_seq: u64,
    text_segment_seq: u64,
    tool_call_seq: u64,
    current_assistant_item_id: [256]u8,
    current_assistant_item_id_len: u64,
    current_assistant_text: [65536]u8,
    current_assistant_text_len: u64,
    has_started_current_assistant_message: bool,
    has_completed_current_assistant_message: bool,
    has_started_current_reasoning: bool,
    has_completed_current_reasoning: bool,
    current_reasoning_item_id: [256]u8,
    current_reasoning_item_id_len: u64,
    current_reasoning_text: [65536]u8,
    current_reasoning_text_len: u64,
    assistant_item_id: [256]u8,
    assistant_item_id_len: u64,
    reasoning_item_id: [256]u8,
    reasoning_item_id_len: u64,
    assistant_text: [131072]u8,
    assistant_text_len: u64,
    reasoning_text: [131072]u8,
    reasoning_text_len: u64,
    has_started_turn: bool,
    has_started_agent_message: bool,
    has_completed_agent_message: bool,
    // activeToolItems: Map<string, Record<string, JsonValue>>
    tool_item_keys: [64][256]u8,
    tool_item_key_lens: [64]u64,
    tool_item_json: [64][8192]u8,
    tool_item_json_len: [64]u64,
    tool_item_status: [64][16]u8, // extracted "status" field for settled checks
    tool_item_status_len: [64]u64,
    tool_item_count: u64,
    // toolContentIndexToId: Map<string, string>
    tool_index_keys: [64][64]u8,
    tool_index_key_lens: [64]u64,
    tool_index_vals: [64][256]u8,
    tool_index_val_lens: [64]u64,
    tool_index_count: u64,
    // toolIdAliases: Map<string, string>
    tool_alias_keys: [64][256]u8,
    tool_alias_key_lens: [64]u64,
    tool_alias_vals: [64][256]u8,
    tool_alias_val_lens: [64]u64,
    tool_alias_count: u64,
    // toolRawArguments: Map<string, string>
    tool_raw_keys: [64][256]u8,
    tool_raw_key_lens: [64]u64,
    tool_raw_vals: [64][16384]u8,
    tool_raw_val_lens: [64]u64,
    tool_raw_count: u64,
    has_last_usage: bool,
    last_usage: PiRpcUsage,
}

// DEFECT: Date.now()/1000 timestamps are produced by an extern clock in the
// repair phase; helper kept for 1:1 call-site correspondence.
fn pi_now_seconds() -> u64 {
    return 0;
}

// DEFECT: template literals `pi-msg-${turnId}-0` etc. are string interpolation;
// id assembly is deferred to a formatting helper in the repair phase. The three
// id shapes used in this file: pi-msg-<turnId>-<messageSeq>[-<textSegmentSeq>],
// pi-thought-<turnId>-<messageSeq>[-<textSegmentSeq>], pi-tool-<turnId>-<...>.
fn pi_make_item_id(prefix_kind: u64, turn_id_ptr: ptr, turn_id_len: u64, seq_a: u64, seq_b: u64, has_b: bool, out_ptr: ptr, out_cap: u64) -> u64 {
    return 0;
}

fn create_pi_projector_context(thread_id_ptr: ptr, thread_id_len: u64, turn_id_ptr: ptr, turn_id_len: u64, out: &PiProjectorContext) -> i32 {
    out.thread_id_len = thread_id_len;
    out.turn_id_len = turn_id_len;
    out.has_session_id = false;
    out.session_id_len = 0;
    out.status = 0; // "running"
    out.message_seq = 0;
    out.text_segment_seq = 0;
    out.tool_call_seq = 0;
    // const initialAssistantItemId = `pi-msg-${turnId}-0`;
    // const initialReasoningItemId = `pi-thought-${turnId}-0`;
    out.current_assistant_text_len = 0;
    out.current_reasoning_text_len = 0;
    out.has_started_current_assistant_message = false;
    out.has_completed_current_assistant_message = false;
    out.has_started_current_reasoning = false;
    out.has_completed_current_reasoning = false;
    out.assistant_text_len = 0;
    out.reasoning_text_len = 0;
    out.has_started_turn = false;
    out.has_started_agent_message = false;
    out.has_completed_agent_message = false;
    out.tool_item_count = 0;
    out.tool_index_count = 0;
    out.tool_alias_count = 0;
    out.tool_raw_count = 0;
    out.has_last_usage = false;
    // DEFECT: id strings materialized by pi_make_item_id in the repair phase;
    // currentAssistantItemId/assistantItemId = initialAssistantItemId,
    // currentReasoningItemId/reasoningItemId = initialReasoningItemId.
    return 0;
}

fn start_new_pi_segment(ctx: &PiProjectorContext) -> i32 {
    ctx.text_segment_seq = ctx.text_segment_seq + 1;
    // ctx.currentAssistantItemId = `pi-msg-${ctx.turnId}-${ctx.messageSeq}-${ctx.textSegmentSeq}`;
    ctx.current_assistant_text_len = 0;
    // ctx.currentReasoningItemId = `pi-thought-${ctx.turnId}-${ctx.messageSeq}-${ctx.textSegmentSeq}`;
    ctx.current_reasoning_text_len = 0;
    // ctx.assistantItemId = ctx.currentAssistantItemId;
    // ctx.reasoningItemId = ctx.currentReasoningItemId;
    ctx.has_started_current_assistant_message = false;
    ctx.has_completed_current_assistant_message = false;
    ctx.has_started_current_reasoning = false;
    ctx.has_completed_current_reasoning = false;
    return 0;
}

// function completeActiveReasoning(ctx, events, status = "completed")
// Pushes an item/completed reasoning event when a reasoning segment is open.
// DEFECT: the item object literal becomes JSON text assembled in the repair
// phase; event kind/thread/turn/status are recorded on the event slot here.
fn complete_active_reasoning(ctx: &PiProjectorContext, events: &PiProjectedEvents, status: u64) -> i32 {
    if ctx.has_started_current_reasoning && !ctx.has_completed_current_reasoning {
        ctx.has_completed_current_reasoning = true;
        // events.push({ kind: "item/completed", threadId, turnId, item: {
        //   id: ctx.currentReasoningItemId, turnId, threadId, type: "reasoning",
        //   title: "Reasoning", status, text: ctx.currentReasoningText,
        //   completedAt: floor(Date.now()/1000) } });
        if events.len < 128 {
            events.items[events.len].kind = 8;
            events.len = events.len + 1;
        };
    };
    return 0;
}

// function completeActiveAssistantMessage(ctx, events, status = "completed")
// finalContent = [reasoning block if currentReasoningText] + [text block if
// currentAssistantText]; pushes item/completed agentMessage.
fn complete_active_assistant_message(ctx: &PiProjectorContext, events: &PiProjectedEvents, status: u64) -> i32 {
    if ctx.has_started_current_assistant_message && !ctx.has_completed_current_assistant_message {
        ctx.has_completed_current_assistant_message = true;
        ctx.has_completed_agent_message = true;
        // events.push({ kind: "item/completed", ..., item: {
        //   id: ctx.currentAssistantItemId!, turnId, threadId, role: "assistant",
        //   type: "agentMessage", status, text: ctx.currentAssistantText,
        //   content: finalContent, completedAt } });
        // DEFECT: non-null assertion `currentAssistantItemId!` has no counterpart.
        if events.len < 128 {
            events.items[events.len].kind = 8;
            events.len = events.len + 1;
        };
    };
    return 0;
}

// projectPiMessage(msg, ctx): PiProjectedEvent[]
// Structure preserved 1:1; each switch case of the source maps to a branch
// below keyed on the event type string (carried in msg.raw_json `type`).
// DEFECT: the source narrows the union with `as` casts and reads arbitrary
// fields off dynamic JSON (evt.message, evt.assistantMessageEvent, teStart.args,
// sessMsg.content blocks, ...); field extraction goes through the sa_json layer
// in the repair phase and is noted per case.
fn project_pi_message(msg: &PiRpcIncomingMessage, ctx: &PiProjectorContext, events: &PiProjectedEvents) -> i32 {
    events.len = 0;
    if ctx.status != 0 { return 0; }; // if (ctx.status !== "running") return events;

    // Auto-emit turn/started if not already emitted
    if !ctx.has_started_turn {
        ctx.has_started_turn = true;
        events.items[events.len].kind = 1; // "turn/started"
        events.len = events.len + 1;
    };

    // 1. Command responses: if (msg.type === "response") and res.success === false
    //    -> ctx.status = "failed"; push turn/failed with res.error ||
    //    "Pi command failed"; return events.
    if msg.kind == 1 {
        // DEFECT: PiRpcResponse success/error extraction deferred to sa_json.
        return 0;
    };

    // 2. RPC events switch (evt.type):
    // case "agent_start" / "turn_start": internal marker, no-op.
    //
    // case "message_start": if message.role === "assistant": complete the open
    //   assistant message (messageSeq += 1 first when it was open), complete
    //   reasoning, toolContentIndexToId.clear(), reset current texts,
    //   textSegmentSeq = 0, rebuild current ids from messageSeq/textSegmentSeq.
    //
    // case "message_update": on assistantMessageEvent —
    //   "thinking_delta": roll to a new reasoning segment when the previous one
    //     completed; emit item/started (reasoning) once; append delta to
    //     reasoningText + currentReasoningText; push item/reasoning/textDelta.
    //   "text_delta": completeActiveReasoning; append to assistantText; roll to
    //     a new text segment when completed; emit item/started (agentMessage)
    //     once; append to currentAssistantText; push item/agentMessage/delta.
    //   "toolcall_start"/"toolcall_delta"/"toolcall_end": complete reasoning +
    //     assistant message; resolve rawToolCall from toolCall / partial.content
    //     [contentIndex] / partial; resolve callId via contentIndex map
    //     (`${messageSeq}:${contentIndex}`), explicit id + toolIdAliases, never
    //     reusing a settled (non-inProgress) item — fresh ids are
    //     `pi-tool-${turnId}-${++toolCallSeq}` (or -<messageSeq>-<contentIndex> /
    //     -<messageSeq>-<activeToolItems.size> fallbacks); toolName from
    //     toolName || rawToolCall.name || rawToolCall.toolName || name ||
    //     existing.toolName || "Tool".
    //     start: upsert activeToolItems (spread existing, status inProgress,
    //       arguments/input from rawToolCall.arguments ?? updateEvt.arguments),
    //       push item/started only for new items.
    //     delta: append to toolRawArguments; try JSON.parse incrementally and
    //       update arguments/input on success (partial JSON ignored).
    //     end: arguments from rawToolCall or parsed toolRawArguments; upsert.
    //   DEFECT: Map get/set/has, spread objects, JSON.parse in try/catch and
    //   template-literal keys approximated by the slot arrays on ctx.
    //
    // case "tool_execution_start": complete reasoning + assistant; callId from
    //   toolCallId via aliases, fresh `pi-tool-...` when missing or settled;
    //   upsert item (args = teStart.args ?? existing.arguments ?? {}); push
    //   item/started only for new items.
    // case "tool_execution_update": item.output = partialResult when present.
    // case "tool_execution_end": status = isError ? "failed" : "completed";
    //   output/result = result; completedAt; push item/completed.
    //
    // case "message_end": role "toolResult" -> settle the matching inProgress
    //   tool item from content (status from isError), push item/completed.
    //   role "assistant" -> when no message was started, rebuild fullText from
    //   string content or text blocks and emit item/started; complete reasoning
    //   + assistant; record usage; errorMessage -> status failed + turn/failed +
    //   return; then messageSeq += 1 and reset the segment fields/ids.
    //
    // case "turn_end": record message.usage into lastUsage.
    // case "agent_end": internal marker, no-op.
    // case "agent_settled": settle all inProgress tool items (item/completed),
    //   complete reasoning + assistant, synthesize an empty agentMessage
    //   item/completed when none was started, status = "completed", push
    //   turn/completed with lastUsage.
    // default: unknown event — non-fatal passthrough.
    // DEFECT: the full per-case bodies operate on dynamic JSON; they are carried
    // as the annotated control flow above in this bulk pass and land with the
    // sa_json field accessors in the repair phase.
    return 0;
}

// toPiNotification(event): JsonRpcNotification | null
// Each kind maps to { method: <kind>, params: { threadId, turnId, engine: "pi",
// ... } }; "system/init" returns null. Params shapes per kind (from source):
//   turn/*: turn: { id, threadId, status, completedAt?, usage?/error? },
//     plus completedAt and error at the params level for failed.
//   item/started|completed: item passthrough.
//   item/*/delta kinds: itemId + delta passthrough.
// DEFECT: notification assembled as JSON text; returns false for the null case.
fn to_pi_notification(event: &PiProjectedEvent, out_ptr: ptr, out_cap: u64) -> bool {
    if event.kind == 9 { return false; }; // case "system/init": return null;
    // DEFECT: JSON assembly of the params object deferred to the repair phase.
    return true;
}

// forceTerminatePi(ctx, reason, error?): PiProjectedEvent[]
// Settles inProgress tool items with status completed (reason "completed") or
// failed, completes reasoning/assistant with finalStatus, synthesizes an
// agentMessage from accumulated assistantText/reasoningText/error when none
// started, sets ctx.status = reason, and pushes the matching turn/* event
// (turn/completed carries lastUsage).
fn force_terminate_pi(ctx: &PiProjectorContext, reason: u64, err_ptr: ptr, err_len: u64, has_error: bool, events: &PiProjectedEvents) -> i32 {
    events.len = 0;
    if ctx.status != 0 { return 0; }; // if (ctx.status !== "running") return events;
    // for (const [, item] of ctx.activeToolItems.entries())
    //   if (item.status === "inProgress") { item.status = ...; push item/completed }
    let i: u64 = 0;
    while i < ctx.tool_item_count {
        // DEFECT: per-item status lives inside the item JSON; slot status field
        // mirrors it for this scan.
        i = i + 1;
    }
    let final_status = reason; // completed | interrupted | failed mapping is identity here
    complete_active_reasoning(ctx, events, final_status);
    if ctx.has_started_current_assistant_message && !ctx.has_completed_current_assistant_message {
        complete_active_assistant_message(ctx, events, final_status);
    } else if !ctx.has_started_agent_message {
        ctx.has_started_agent_message = true;
        // push item/completed agentMessage { id: currentAssistantItemId ||
        //   `pi-msg-${turnId}-0`, status: finalStatus,
        //   text: assistantText || error || "", content: [reasoning?, text?] }
        if events.len < 128 {
            events.items[events.len].kind = 8;
            events.len = events.len + 1;
        };
    };
    ctx.status = reason;
    if events.len < 128 {
        if reason == 1 { events.items[events.len].kind = 2; }; // turn/completed (+ usage)
        if reason == 3 { events.items[events.len].kind = 4; }; // turn/interrupted
        if reason == 2 { events.items[events.len].kind = 3; }; // turn/failed (+ error)
        events.len = events.len + 1;
    };
    return 0;
}
