struct PiRelayConfig {
    base_url: [1024]u8, // baseUrl?: string
    base_url_len: u64,
    has_base_url: bool,
    api_key: [1024]u8, // apiKey?: string — credential, passed via env only
    api_key_len: u64,
    has_api_key: bool,
    api: [64]u8, // api?: string
    api_len: u64,
    has_api: bool,
    model: [1024]u8, // model?: string
    model_len: u64,
    has_model: bool,
}

struct PiProcessConfig {
    thread_id: [128]u8,
    thread_id_len: u64,
    workspace_cwd: [1024]u8,
    workspace_cwd_len: u64,
    model: [1024]u8,
    model_len: u64,
    has_model: bool,
    session_dir: [1024]u8,
    session_dir_len: u64,
    has_session_dir: bool,
    has_relay_config: bool,
    relay_config: PiRelayConfig,
    // envOverrides?: Record<string, string> — DEFECT: dynamic object, JSON text.
    env_overrides_json: [8192]u8,
    env_overrides_json_len: u64,
    has_env_overrides: bool,
    idle_timeout_ms: u64, // default 10 minutes (600_000ms)
    has_idle_timeout_ms: bool,
    ack_timeout_ms: u64, // default 60 seconds (60_000ms)
    has_ack_timeout_ms: bool,
    turn_timeout_ms: u64, // default 10 minutes (600_000ms)
    has_turn_timeout_ms: bool,
}

