// resolveExistingPiRelayExtensionDir(env): string | null
// Search order preserved from source:
//   0. env.CODEX_UI_PI_RELAY_EXTENSION (valid dir, else any existing path, else warn+search)
//   1. Up to 6 ancestors of the module dir: <dir>/extensions/pi-relay,
//      <dir>/desktop-resources/extensions/pi-relay
//   2. Up to 4 ancestors of process.execPath dir: extensions/pi-relay,
//      server-bundle/extensions/pi-relay, desktop-resources/extensions/pi-relay
//   3. process.cwd(), ../, ../../ roots: extensions/pi-relay,
//      desktop-resources/extensions/pi-relay
//   4. join(codexUiDataDir(env), "extensions", "pi-relay")
//   5. <home>/.cxu/extensions/pi-relay, <home>/.codex-ultra/extensions/pi-relay
//   6. "D:\\projects\\codex-ultra\\extensions\\pi-relay"
//   else null.
// DEFECT: import.meta.url / fileURLToPath / process.execPath / path traversal
// loops over candidate path strings are data-driven; the walk is deferred.
// Returns 0 and fills out when found, 1 for null.
fn resolve_existing_pi_relay_extension_dir(out_ptr: ptr, out_cap: u64) -> i32 {
    // console.warn(`[piRpcProcessManager] CODEX_UI_PI_RELAY_EXTENSION="..." not found; searching candidates.`)
    // DEFECT: console.warn + template literal approximated by print in repair phase.
    return 1;
}

// ensurePiRelayExtensionDir(env): string
// Returns the existing dir, else materializes the builtin extension under
// join(codexUiDataDir(env), "extensions", "pi-relay"): mkdirSync recursive,
// write index.js with BUILTIN_PI_RELAY_EXTENSION_CODE when missing/empty, and
// write package.json {"name":"@codex-ultra/pi-relay-extension","version":"1.0.0",
// "type":"module","main":"index.js"} when missing. On error: warn + return targetDir.
// DEFECT: fs writes + JSON.stringify of the package object deferred; control flow kept.
fn ensure_pi_relay_extension_dir(out_ptr: ptr, out_cap: u64) -> u64 {
    // const existing = resolveExistingPiRelayExtensionDir(env);
    // if (existing) return existing;
    // try { mkdirSync(targetDir, { recursive: true }); ... } catch (err) {
    //   console.warn(...); return targetDir; }
    return 0;
}

// defaultPiRelayExtensionDir(env): ensurePiRelayExtensionDir(env)
fn default_pi_relay_extension_dir(out_ptr: ptr, out_cap: u64) -> u64 {
    return ensure_pi_relay_extension_dir(out_ptr, out_cap);
}

// ============================================================================
// class PiRpcProcessManager extends EventEmitter
// Manages the lifecycle of a dedicated Pi RPC child process for a thread.
// DEFECT: EventEmitter base class — emit/on become callback slots noted per event
// ("exit", "error", "line", "message", "stderr", "timeout").
// DEFECT: pendingCommands is Map<string, {command, resolve, reject, timer}> —
// Promise continuations stored in a map; approximated by fixed slots below.
// DEFECT: NodeJS.Timeout handles approximated by timer id fields (0 = none).
// ============================================================================
struct PiRpcProcessManager {
    config: PiProcessConfig, // public readonly config
    child_proc: u64, // ChildProcessWithoutNullStreams | null (bidi process handle)
    child_hin: u64,
    child_hout: u64,
    child_herr: u64,
    child_pid: u64,
    has_child: bool,
    stopping: bool,
    framing_buffer: PiLineFramingBuffer,
    stderr_line_count: u64,
    next_command_id: u64, // starts at 1
    active_turn: bool,
    ack_timer: u64,
    turn_timer: u64,
    idle_timer: u64,
    // pendingCommands slots (capacity 64)
    pending_ids: [64][128]u8,
    pending_id_lens: [64]u64,
    pending_used: [64]bool,
    pending_count: u64,
}

fn pi_rpc_process_manager_new(cfg: &PiProcessConfig, out: &PiRpcProcessManager) -> i32 {
    out.config = cfg;
    out.has_child = false;
    out.stopping = false;
    out.stderr_line_count = 0;
    out.next_command_id = 1;
    out.active_turn = false;
    out.ack_timer = 0;
    out.turn_timer = 0;
    out.idle_timer = 0;
    out.pending_count = 0;
    pi_line_framing_buffer_clear(&out.framing_buffer);
    return 0;
}

// start(baseEnv): spawns the Pi process in RPC mode with -a and pi-relay extension.
// DEFECT: void fire-and-forget async pieces (initial set_auto_retry sendCommand
// .catch(() => undefined)) become sequential calls; spawn goes through the host
// spawn service equivalent (pluginHostServices().codex.spawnCodexCommand).
fn pi_rpc_process_manager_start(mgr: &PiRpcProcessManager) -> i32 {
    if mgr.has_child { return 0; };
    // const bin = findPiBin(baseEnv);
    // const extensionDir = defaultPiRelayExtensionDir(baseEnv);
    // if (!existsSync(extensionDir)) throw new Error(
    //   `Pi relay extension not found at "${extensionDir}". ` +
    //   `Set CODEX_UI_PI_RELAY_EXTENSION to the extensions/pi-relay directory.`);
    // DEFECT: throw -> error return code -1.
    // const sessionDir = this.config.sessionDir || defaultPiSessionDir();
    // Model arg: relayConfig present -> base = config.model ||
    //   relayConfig.model.split(",")[0].trim() || "default", prefixed "pi-relay/"
    //   unless already prefixed; else config.model || "pi-relay/default".
    // DEFECT: string split/trim/startsWith approximated in the repair phase.
    // args = ["-e", extensionDir] (when it exists) + ["--mode", "rpc",
    //   "--session-dir", sessionDir, "--model", modelArg, "--no-context-files"]
    // (source comment: pi v0.74.2 has no -a and no --session-id; verified 2026-09-22.)
    // env = { ...baseEnv, ...config.envOverrides }; relayConfig fields copied to
    //   PI_LAUNCH_BASE_URL / PI_LAUNCH_API_KEY / PI_LAUNCH_API / PI_LAUNCH_MODEL.
    // env.PI_LAUNCH_OPENCODE_SESSION ??= deriveOpenCodeSessionId(config.threadId);
    // env.PI_LAUNCH_OPENCODE_CLIENT ??= "desktop";
    // env.PI_LAUNCH_OPENCODE_PROJECT ??= "global";
    // DEFECT: env is a dynamic string map + ??= nullish assignment; kept as JSON text.
    // runCwd = config.workspaceCwd if it exists else process.cwd().
    // If bin ends with .js/.mjs/.ts: spawnBin = process.execPath,
    //   spawnArgs = [bin, ...args], env.ELECTRON_RUN_AS_NODE = "1".
    // const child = spawnCodexCommand(spawnBin, spawnArgs, { cwd: runCwd, env,
    //   stdio: ["pipe","pipe","pipe"], windowsHide: true });
    // if (!child || !child.pid) throw new Error("Failed to spawn Pi RPC process");
    // DEFECT: throw -> error return code -2.
    mgr.stopping = false;
    pi_line_framing_buffer_clear(&mgr.framing_buffer);
    mgr.stderr_line_count = 0;
    // child.once("exit", ...) / child.once("error", ...) / child.stdout.on("data", ...)
    // / child.stderr.on("data", ...) registrations:
    // DEFECT: stream event callbacks replaced by the poll entry points
    // pi_rpc_process_manager_on_stdout / _on_stderr / _on_exit / _on_error below.
    // void this.sendCommand({ type: "set_auto_retry", enabled: true }).catch(() => undefined);
    // this.resetIdleTimer();
    pi_rpc_process_manager_reset_idle_timer(mgr);
    return 0;
}

// child.stdout.on("data"): lines = framingBuffer.push(text); for each line:
// emit("line", line) + handleIncomingLine(line).
// DEFECT: event emission approximated by direct sequential calls.
fn pi_rpc_process_manager_on_stdout(mgr: &PiRpcProcessManager, chunk_ptr: ptr, chunk_len: u64) -> i32 {
    // const lines = this.framingBuffer.push(chunk.toString("utf8"));
    // DEFECT: Buffer.toString + per-line dispatch deferred with the framing buffer.
    return 0;
}

// child.stderr.on("data"): trim; skip empty; count lines; while count <=
// MAX_STDERR_LINES (500): emit("stderr", sanitizePiRpcText(text)).
fn pi_rpc_process_manager_on_stderr(mgr: &PiRpcProcessManager, chunk_ptr: ptr, chunk_len: u64) -> i32 {
    if chunk_len == 0 { return 0; };
    mgr.stderr_line_count = mgr.stderr_line_count + 1;
    if mgr.stderr_line_count <= 500 {
        // const sanitized = sanitizePiRpcText(text); this.emit("stderr", sanitized);
    };
    return 0;
}

// child.once("exit", (code, signal)): activeTurn=false; clearAllTimers();
// rejectAllPending(Error(`Process exited prematurely with code=${code}, signal=${signal}`));
// emit("exit", { code, signal }); child = null.
fn pi_rpc_process_manager_on_exit(mgr: &PiRpcProcessManager, code: i32, signal_ptr: ptr, signal_len: u64) -> i32 {
    mgr.active_turn = false;
    pi_rpc_process_manager_clear_all_timers(mgr);
    pi_rpc_process_manager_reject_all_pending(mgr, -1);
    mgr.has_child = false;
    return 0;
}

// child.once("error", (err)): activeTurn=false; clearAllTimers();
// rejectAllPending(err); emit("error", err); child = null.
fn pi_rpc_process_manager_on_error(mgr: &PiRpcProcessManager, err_code: i32) -> i32 {
    mgr.active_turn = false;
    pi_rpc_process_manager_clear_all_timers(mgr);
    pi_rpc_process_manager_reject_all_pending(mgr, err_code);
    mgr.has_child = false;
    return 0;
}

