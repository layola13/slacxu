// stop(timeoutMs = 3_000): graceful stop with escalation
// (stdin close -> SIGTERM -> SIGKILL after a further 1_500ms; on win32 uses
// spawn("taskkill", ["/pid", pid, "/T", "/F"]) with SIGTERM fallback).
// DEFECT: nested setTimeout escalation chain + taskkill child spawn approximated
// by timer ids; kill semantics map to the process extern in the repair phase.
fn pi_rpc_process_manager_stop(mgr: &PiRpcProcessManager, timeout_ms: u64) -> i32 {
    if mgr.stopping { return 0; };
    mgr.stopping = true;
    mgr.active_turn = false;
    pi_rpc_process_manager_clear_all_timers(mgr);
    if !mgr.has_child {
        mgr.stopping = false;
        return 0;
    };
    // try { child.stdin.end(); } catch {}
    // termTimer = setTimeout(() => { if same child && !killed { taskkill or
    //   SIGTERM; killTimer = setTimeout(SIGKILL, 1500); killTimer.unref(); } }, timeoutMs);
    // termTimer.unref();
    return 0;
}

fn pi_rpc_process_manager_is_running(mgr: &PiRpcProcessManager) -> bool {
    // return this.child !== null && !this.child.killed;
    // DEFECT: child.killed flag approximated by has_child.
    return mgr.has_child;
}

// get pid(): number | null
fn pi_rpc_process_manager_pid(mgr: &PiRpcProcessManager) -> u64 {
    if mgr.has_child { return mgr.child_pid; };
    return 0;
}

// get isTurnActive(): boolean
fn pi_rpc_process_manager_is_turn_active(mgr: &PiRpcProcessManager) -> bool {
    return mgr.active_turn;
}

// private resetTurnTimer(): setTimeout(turnTimeoutMs ?? DEFAULT_TURN_TIMEOUT_MS)
// -> emit("timeout", { type: "turn", details }) + stop(1000); timer.unref().
// DEFECT: setTimeout/unref approximated by a timer id slot.
fn pi_rpc_process_manager_reset_turn_timer(mgr: &PiRpcProcessManager) -> i32 {
    pi_rpc_process_manager_clear_turn_timer(mgr);
    return 0;
}

fn pi_rpc_process_manager_clear_turn_timer(mgr: &PiRpcProcessManager) -> i32 {
    mgr.turn_timer = 0;
    return 0;
}

// private resetIdleTimer(): setTimeout(idleTimeoutMs ?? DEFAULT_IDLE_TIMEOUT_MS)
// -> emit("timeout", { type: "idle", details }) + stop(2000); timer.unref().
fn pi_rpc_process_manager_reset_idle_timer(mgr: &PiRpcProcessManager) -> i32 {
    pi_rpc_process_manager_clear_idle_timer(mgr);
    return 0;
}

fn pi_rpc_process_manager_clear_idle_timer(mgr: &PiRpcProcessManager) -> i32 {
    mgr.idle_timer = 0;
    return 0;
}

fn pi_rpc_process_manager_clear_all_timers(mgr: &PiRpcProcessManager) -> i32 {
    pi_rpc_process_manager_clear_turn_timer(mgr);
    pi_rpc_process_manager_clear_idle_timer(mgr);
    mgr.ack_timer = 0;
    return 0;
}

// private rejectAllPending(err): for each pending entry clearTimeout + reject(err);
// pendingCommands.clear().
// DEFECT: Promise rejection has no counterpart; entries are dropped and the
// error code is recorded by the caller path.
fn pi_rpc_process_manager_reject_all_pending(mgr: &PiRpcProcessManager, err_code: i32) -> i32 {
    let i: u64 = 0;
    while i < 64 {
        mgr.pending_used[i] = false;
        i = i + 1;
    }
    mgr.pending_count = 0;
    return 0;
}
