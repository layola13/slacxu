// Converted 1:1 from backends/pi/src/manifest.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.

@import "sa_std/io/print.sai"
@import "sa_std/ptr.sa"

// Pi manifest — the single source is ../plugin.json; both sides
// import it from here so the web side never pulls in server code.

// DEFECT: JSON module import (`import manifestJson from "../plugin.json" with { type: "json" }`)
// has no SLA counterpart; the plugin.json bytes are embedded as a fixed buffer instead,
// and PluginManifest typing from @cxu/sdk-backend is not represented.
struct PiManifest {
    json_bytes: [u8; 8192],
    json_len: u64,
}

// export const PI_MANIFEST: PluginManifest = manifestJson as PluginManifest;
// DEFECT: compile-time JSON import + type assertion; PI_MANIFEST is materialized at
// runtime by copying the plugin.json text into the buffer (see pi_manifest_load).
fn pi_manifest_load(out: &PiManifest, json_ptr: ptr, json_len: u64) -> i32 {
    if json_len > 8192 { return 1; };
    out.json_len = json_len;
    // DEFECT: byte copy loop stands in for the JSON module binding.
    let i: u64 = 0;
    while i < json_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, json_ptr, i);
        out.json_bytes[i] = b;
        i = i + 1;
    }
    return 0;
}
