// Converted 1:1 from backends/pi/src/server.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.

@import "sa_std/io/print.sai"
@import "manifest.sla"
@import "runtime/piBridge.sla"
@import "sa_std/string.sa"
@import "sa_std/ptr.sa"

// Pi — server side (kind "backend"). Independent plugin.
// Phase 1: declaration level — the runtime/bridge and installation
// discovery move here from the host in Phase 2.

// DEFECT: SDK types EngineHandle / EngineStatus / PluginInstallation / ServerHost /
// ServerPlugin from @cxu/sdk-backend/server have no SLA counterpart; represented as
// plain structs + JSON text buffers below.

// EngineStatus { phase, transport } as fixed text fields.
struct PiEngineStatus {
    phase: [u8; 32],
    phase_len: u64,
    transport: [u8; 32],
    transport_len: u64,
}

// class PiEngine implements EngineHandle
struct PiEngine {
    plugin_id: [u8; 16], // readonly pluginId = "pi"
    plugin_id_len: u64,
    status: PiEngineStatus, // #status private field
}

fn pi_engine_new(out: &PiEngine) -> i32 {
    out.plugin_id_len = 2;
    out.plugin_id[0] = 112; // 'p'
    out.plugin_id[1] = 105; // 'i'
    pi_engine_status_set(out, STR_PTR("stopped"), STR_LEN("stopped"), STR_PTR("stdio"), STR_LEN("stdio"));
    return 0;
}

fn pi_engine_status_set(engine: &PiEngine, phase_ptr: ptr, phase_len: u64, transport_ptr: ptr, transport_len: u64) -> i32 {
    engine.status.phase_len = phase_len;
    engine.status.transport_len = transport_len;
    let i: u64 = 0;
    while i < phase_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, phase_ptr, i);
        engine.status.phase[i] = b;
        i = i + 1;
    }
    let j: u64 = 0;
    while j < transport_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, transport_ptr, j);
        engine.status.transport[j] = b;
        j = j + 1;
    }
    return 0;
}

// async start(): Promise<EngineStatus>
// DEFECT: async — converted to a synchronous function returning a status code.
fn pi_engine_start(engine: &PiEngine) -> i32 {
    pi_engine_status_set(engine, STR_PTR("ready"), STR_LEN("ready"), STR_PTR("stdio"), STR_LEN("stdio"));
    return 0;
}

// async stop(): Promise<void>
// DEFECT: async — converted to a synchronous function returning a status code.
fn pi_engine_stop(engine: &PiEngine) -> i32 {
    pi_engine_status_set(engine, STR_PTR("stopped"), STR_LEN("stopped"), STR_PTR("stdio"), STR_LEN("stdio"));
    return 0;
}

fn pi_engine_status(engine: &PiEngine, out: &PiEngineStatus) -> i32 {
    out.phase_len = engine.status.phase_len;
    out.transport_len = engine.status.transport_len;
    let i: u64 = 0;
    while i < engine.status.phase_len {
        out.phase[i] = engine.status.phase[i];
        i = i + 1;
    }
    let j: u64 = 0;
    while j < engine.status.transport_len {
        out.transport[j] = engine.status.transport[j];
        j = j + 1;
    }
    return 0;
}

// async handleRpc(): Promise<unknown> — throws in the source.
// DEFECT: async + throw; error is reported via the return code instead of an exception.
fn pi_engine_handle_rpc(engine: &PiEngine) -> i32 {
    // throw new Error("pi plugin engine is not wired to the host yet (phase 1 declaration)")
    return -1;
}

// export const piServerPlugin: ServerPlugin = { ... }
// DEFECT: object literal plugin descriptor (with nested cliSettings/discovery objects
// and a matchesKind closure) has no SLA object-literal counterpart; flattened into a
// struct of text fields + separate functions below.
struct PiServerPlugin {
    // manifest: PI_MANIFEST (see manifest.sla)
    // officialProviderId: PI_OFFICIAL_PROVIDER_ID (see piBridge.sla)
    cli_slug: [u8; 16], // cliSettings.slug = "pi-cli"
    cli_slug_len: u64,
    cli_enabled_env_var: [u8; 64], // cliSettings.enabledEnvVar = "CODEX_UI_PI_COMPATIBLE_CLI_ENABLED"
    cli_enabled_env_var_len: u64,
    cli_link_key: [u8; 32], // cliSettings.linkKey = "piCompatibleCliSettings"
    cli_link_key_len: u64,
    discovery_preferred_path_pref_key: [u8; 32], // discovery.preferredPathPrefKey = "cliPreferredPiPath"
    discovery_preferred_path_pref_key_len: u64,
    discovery_binary_name_0: [u8; 8], // discovery.binaryNames = ["pi"]
    discovery_binary_name_0_len: u64,
    discovery_env_bin_var_0: [u8; 8], // discovery.envBinVars = ["PI_BIN", "CODEX_UI_PI_BIN"]
    discovery_env_bin_var_0_len: u64,
    discovery_env_bin_var_1: [u8; 24],
    discovery_env_bin_var_1_len: u64,
}

// discovery.matchesKind: () => true
// DEFECT: closure; converted to a plain function that always returns true.
fn pi_discovery_matches_kind() -> bool {
    return true;
}

// createEngine(_host: ServerHost): EngineHandle
// DEFECT: ServerHost is an SDK host interface; the host parameter is dropped.
fn pi_server_plugin_create_engine(out: &PiEngine) -> i32 {
    return pi_engine_new(out);
}

// async findInstallations(): Promise<PluginInstallation[]> — returns [].
// DEFECT: async; returns a count (always 0) instead of a Promise of an array.
fn pi_server_plugin_find_installations() -> u64 {
    return 0;
}

// skillRoots(): string[] — returns [].
fn pi_server_plugin_skill_roots() -> u64 {
    return 0;
}

// export default piServerPlugin; — no default-export counterpart; piServerPlugin
// struct above is the single representation.
