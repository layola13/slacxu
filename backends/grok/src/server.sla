// Converted 1:1 from backends/grok/src/server.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
// Grok — server side (kind "backend"). Independent plugin.
// Phase 1: declaration level — the runtime/bridge and installation
// discovery move here from the host in Phase 2.
@import "sa_std/io/print.sai"
@import "manifest.sla"
@import "runtime/grokBridge.sla"
@import "sa_std/string.sa"

// DEFECT: EngineHandle / EngineStatus / PluginInstallation / ServerHost / ServerPlugin types from @cxu/sdk-backend/server have no SLA structs; modelled as local structs + JSON buffers below.
// DEFECT: class + private field (#status) + interface implementation has no SLA equivalent; class -> struct + function family with &Struct first arg.

struct EngineStatus {
    // phase: "stopped" | "ready" | ... held as text buffer
    phase_ptr: ptr,
    phase_len: u64,
    // transport: "stdio"
    transport_ptr: ptr,
    transport_len: u64,
}

struct GrokEngine {
    pluginId_ptr: ptr,
    pluginId_len: u64,
    status: EngineStatus,
}

fn GrokEngine_new() -> GrokEngine {
    let st = EngineStatus { phase_ptr: STR_PTR("stopped"), phase_len: 7, transport_ptr: STR_PTR("stdio"), transport_len: 5 };
    let e = GrokEngine { pluginId_ptr: STR_PTR("grok"), pluginId_len: 4, status: st };
    return e;
}

// DEFECT: async — start(): Promise<EngineStatus> converted to synchronous fn returning status code + out param.
fn GrokEngine_start(self: &GrokEngine, out_status: &EngineStatus) -> i32 {
    self.status.phase_ptr = STR_PTR("ready");
    self.status.phase_len = 5;
    self.status.transport_ptr = STR_PTR("stdio");
    self.status.transport_len = 5;
    out_status.phase_ptr = self.status.phase_ptr;
    out_status.phase_len = self.status.phase_len;
    out_status.transport_ptr = self.status.transport_ptr;
    out_status.transport_len = self.status.transport_len;
    return 0;
}

// DEFECT: async — stop(): Promise<void> converted to synchronous fn.
fn GrokEngine_stop(self: &GrokEngine) -> i32 {
    self.status.phase_ptr = STR_PTR("stopped");
    self.status.phase_len = 7;
    self.status.transport_ptr = STR_PTR("stdio");
    self.status.transport_len = 5;
    return 0;
}

fn GrokEngine_status(self: &GrokEngine, out_status: &EngineStatus) -> void {
    out_status.phase_ptr = self.status.phase_ptr;
    out_status.phase_len = self.status.phase_len;
    out_status.transport_ptr = self.status.transport_ptr;
    out_status.transport_len = self.status.transport_len;
}

// DEFECT: async + throw — handleRpc(): Promise<unknown> always throws in TS; SLA returns error code 1 and writes the message to err buffer. Dynamic `unknown` return has no SLA type.
fn GrokEngine_handleRpc(self: &GrokEngine, err_ptr: ptr, err_len: &u64) -> i32 {
    // "grok plugin engine is not wired to the host yet (phase 1 declaration)"
    *err_len = 70;
    return 1;
}

// DEFECT: ServerPlugin object literal (manifest / officialProviderId / cliSettings / discovery / createEngine / findInstallations / skillRoots) has no SLA object type; flattened into constants + functions below.
// DEFECT: arrow-function property `matchesKind: () => true` is a closure; converted to a plain function.
struct GrokServerPlugin {
    manifest: GrokManifest,
    officialProviderId_ptr: ptr,
    officialProviderId_len: u64,
    cli_slug_ptr: ptr,
    cli_slug_len: u64,
    cli_enabledEnvVar_ptr: ptr,
    cli_enabledEnvVar_len: u64,
    cli_linkKey_ptr: ptr,
    cli_linkKey_len: u64,
    discovery_preferredPathPrefKey_ptr: ptr,
    discovery_preferredPathPrefKey_len: u64,
    // binaryNames: ["grok", "agent"] — fixed array, capacity 2
    binaryNames_len: u64,
    // envBinVars: ["GROK_BIN", "CODEX_UI_GROK_BIN"] — fixed array, capacity 2
    envBinVars_len: u64,
}

fn GrokServerPlugin_matchesKind() -> bool {
    return true;
}

fn GrokServerPlugin_createEngine(host_json_ptr: ptr, host_json_len: u64) -> GrokEngine {
    // DEFECT: ServerHost parameter is a host-injected interface; passed as JSON text buffer, unused in phase 1 (source ignores it as _host).
    let e = GrokEngine_new();
    return e;
}

// DEFECT: async — findInstallations(): Promise<PluginInstallation[]> converted to synchronous fn returning count 0.
fn GrokServerPlugin_findInstallations(out_count: &u64) -> i32 {
    *out_count = 0;
    return 0;
}

fn GrokServerPlugin_skillRoots(out_count: &u64) -> i32 {
    *out_count = 0;
    return 0;
}

// export const grokServerPlugin / export default grokServerPlugin — see GrokServerPlugin struct above; GROK_OFFICIAL_PROVIDER_ID comes from runtime/grokBridge.sla.
