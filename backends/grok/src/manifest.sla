// Converted 1:1 from backends/grok/src/manifest.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
// Grok manifest — the single source is ../plugin.json; both sides
// import it from here so the web side never pulls in server code.
@import "sa_std/io/print.sai"

// DEFECT: JSON import assertion (`import manifestJson from "../plugin.json" with { type: "json" }`) has no SLA counterpart; plugin.json is kept as an external JSON text buffer loaded at runtime.
// DEFECT: PluginManifest type imported from @cxu/sdk-backend has no SLA struct yet; represented as JSON text buffer.

struct GrokManifest {
    // DEFECT: dynamic object — PluginManifest shape held as JSON text buffer (ptr,len).
    json_ptr: ptr,
    json_len: u64,
}

// GROK_MANIFEST: PluginManifest = manifestJson as PluginManifest
// DEFECT: `as PluginManifest` type assertion has no SLA equivalent; value is the raw plugin.json text.
fn grok_manifest() -> GrokManifest {
    let m = GrokManifest { json_ptr: STR_PTR("{}"), json_len: 2 };
    return m;
}
