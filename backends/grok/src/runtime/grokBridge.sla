// DEFECT: async — restart(): Promise<EngineStatus> = stop() then start(), synchronous sequence.
fn GrokBridge_restart(self: &GrokBridge) -> i32 {
    GrokBridge_stop(self);
    return GrokBridge_start(self);
}

