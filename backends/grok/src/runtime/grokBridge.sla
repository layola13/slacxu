}

// DEFECT: GrokBridgeOptions holds optional async callbacks (resolveRelayEnv / resolveRelayProxyConfig returning Promises) and sync callbacks (onSnapshot / loadSnapshot / loadMetadata) — closures/function types have no SLA equivalent; each becomes a host-registered callback id (u64, 0 = absent) invoked through extern dispatch.
struct GrokBridgeOptions {
    resolveRelayEnv_cb: u64,
    resolveRelayProxyConfig_cb: u64,
    onSnapshot_cb: u64,
    loadSnapshot_cb: u64,
    loadMetadata_cb: u64,
}

