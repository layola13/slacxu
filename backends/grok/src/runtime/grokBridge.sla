// DEFECT: EventEmitter base class + CodexRuntimeClient interface (from @cxu/sdk-backend) have no SLA equivalents; GrokBridge is a struct + function family, "notification" emissions become explicit dispatch calls, and host SDK helpers (bootstrapProjectSaVmAssets, pageThreadHistory) are extern-style calls.
// DEFECT: dynamic JSON — JsonValue / ProviderConfig / ChannelGroupConfig payloads are JSON text buffers (ptr,len) throughout this file.

// GROK_OFFICIAL_PROVIDER_ID = "grok-official"
fn grok_official_provider_id(out_ptr: ptr, out_len: &u64) -> void {
    out_ptr = STR_PTR("grok-official");
    *out_len = 13;
}

// buildGrokOfficialProvider(): ProviderConfig — the literal is serialized 1:1 into a JSON text buffer:
