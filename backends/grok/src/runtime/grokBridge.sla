// DEFECT: Date.now() timestamps are filled at build time by the caller-provided clock value (now_ms).
fn buildGrokOfficialProvider(now_ms: u64, out_ptr: ptr, out_len: &u64) -> void {
    *out_len = 0;
}

struct GrokTurn {
    id_ptr: ptr,
    id_len: u64,
    status_ptr: ptr,
    status_len: u64,
    createdAt: u64,
}

