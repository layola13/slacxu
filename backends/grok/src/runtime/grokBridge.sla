// DEFECT: Map<string, GrokSession> (sessions) has no SLA equivalent; fixed array capacity 64 + len, keyed by threadId byte equality.
struct GrokBridge {
    has_options: bool,
    options: GrokBridgeOptions,
    sessions_len: u64,
    // status: EngineStatus { phase, transport, message } held as three text buffers
    status_phase_ptr: ptr,
    status_phase_len: u64,
    status_transport_ptr: ptr,
    status_transport_len: u64,
    status_message_ptr: ptr,
    status_message_len: u64,
}

fn GrokBridge_new(has_options: bool, options: &GrokBridgeOptions, out_self: &GrokBridge) -> void {
    // super(); this.options = options; status = { phase: "ready", transport: "stdio", message: "Grok CLI ready" }
    out_self.has_options = has_options;
    out_self.sessions_len = 0;
    out_self.status_phase_ptr = STR_PTR("ready");
    out_self.status_phase_len = 5;
    out_self.status_transport_ptr = STR_PTR("stdio");
    out_self.status_transport_len = 5;
    out_self.status_message_ptr = STR_PTR("Grok CLI ready");
    out_self.status_message_len = 14;
}

fn GrokBridge_getStatus(self: &GrokBridge, out_phase_ptr: ptr, out_phase_len: &u64) -> void {
    out_phase_ptr = self.status_phase_ptr;
    *out_phase_len = self.status_phase_len;
}

