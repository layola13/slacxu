// Converted 1:1 from backends/grok/src/runtime/grokCompatibleProtocol.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
// Protocol framing and parsing for Grok CLI (`grok.exe`) streaming-json mode.
// Ground truth is based on live NDJSON probes over Stdio:
// - Event "available_commands": Available tools and slash commands.
// - Event "thought": Incremental reasoning/thinking token chunks.
// - Event "text": Incremental agent message text chunks.
// - Event "tool_call": Tool call start (toolCallId, toolName, kind, status, rawInput).
// - Event "tool_call_update": Tool call progress / completion (toolCallId, status, rawOutput).
// - Event "usage": Token usage for model response.
// - Event "end": Final turn outcome with sessionId, stopReason, full usage and modelUsage.
// - Event "error": Error during execution.
@import "sa_std/io/print.sai"

// DEFECT: dynamic JSON — all event payloads are NDJSON text; optional/unknown fields are kept in JSON text buffers (ptr,len) instead of typed fields.

struct GrokUsage {
    has_input_tokens: bool,
    input_tokens: u64,
    has_output_tokens: bool,
    output_tokens: u64,
    has_reasoning_tokens: bool,
    reasoning_tokens: u64,
    has_cache_read_input_tokens: bool,
    cache_read_input_tokens: u64,
    has_cache_creation_input_tokens: bool,
    cache_creation_input_tokens: u64,
    has_total_tokens: bool,
    total_tokens: u64,
}

struct GrokThoughtEvent {
    type_ptr: ptr, // "thought"
    type_len: u64,
    data_ptr: ptr,
    data_len: u64,
}

struct GrokTextEvent {
    type_ptr: ptr, // "text"
    type_len: u64,
    data_ptr: ptr,
    data_len: u64,
}

struct GrokToolCallEvent {
    type_ptr: ptr, // "tool_call"
    type_len: u64,
    toolCallId_ptr: ptr,
    toolCallId_len: u64,
    toolName_ptr: ptr,
    toolName_len: u64,
    has_title: bool,
    title_ptr: ptr,
    title_len: u64,
    has_kind: bool,
    kind_ptr: ptr,
    kind_len: u64,
    has_status: bool,
    status_ptr: ptr,
    status_len: u64,
    // DEFECT: dynamic object — rawInput: Record<string, unknown> kept as JSON text buffer.
    rawInput_ptr: ptr,
    rawInput_len: u64,
    // DEFECT: dynamic object — content?: unknown[] kept as JSON text buffer.
    content_ptr: ptr,
    content_len: u64,
    // DEFECT: dynamic object — locations?: unknown[] kept as JSON text buffer.
    locations_ptr: ptr,
    locations_len: u64,
}

struct GrokToolCallUpdateEvent {
    type_ptr: ptr, // "tool_call_update"
    type_len: u64,
    toolCallId_ptr: ptr,
    toolCallId_len: u64,
    has_status: bool,
    status_ptr: ptr, // "completed" | "failed" | string
    status_len: u64,
    // DEFECT: dynamic object — rawOutput: Record<string, unknown> kept as JSON text buffer.
    rawOutput_ptr: ptr,
    rawOutput_len: u64,
    content_ptr: ptr,
    content_len: u64,
    locations_ptr: ptr,
    locations_len: u64,
}

struct GrokUsageEvent {
    type_ptr: ptr, // "usage"
    type_len: u64,
    has_messageId: bool,
    messageId_ptr: ptr,
    messageId_len: u64,
    has_stopReason: bool,
    stopReason_ptr: ptr,
    stopReason_len: u64,
    has_signature: bool,
    signature_ptr: ptr,
    signature_len: u64,
    has_usage: bool,
    usage: GrokUsage,
}

struct GrokEndEvent {
    type_ptr: ptr, // "end"
    type_len: u64,
    stopReason_ptr: ptr,
    stopReason_len: u64,
    sessionId_ptr: ptr,
    sessionId_len: u64,
    has_requestId: bool,
    requestId_ptr: ptr,
    requestId_len: u64,
    has_usage: bool,
    usage: GrokUsage,
    has_num_turns: bool,
    num_turns: u64,
    has_total_cost_usd: bool,
    total_cost_usd: f64,
    has_total_cost_usd_ticks: bool,
    total_cost_usd_ticks: u64,
    // DEFECT: dynamic object — modelUsage?: Record<string, unknown> kept as JSON text buffer.
    modelUsage_ptr: ptr,
    modelUsage_len: u64,
}

struct GrokErrorEvent {
    type_ptr: ptr, // "error"
    type_len: u64,
    message_ptr: ptr,
    message_len: u64,
}

struct GrokAvailableCommandsEvent {
    type_ptr: ptr, // "available_commands"
    type_len: u64,
    // tools: string[] / commands: string[] — variable-length string lists kept as JSON text buffers.
    // DEFECT: dynamic array — string[] has no fixed SLA capacity; JSON buffer approximation.
    tools_ptr: ptr,
    tools_len: u64,
    commands_ptr: ptr,
    commands_len: u64,
}

// DEFECT: discriminated union — `GrokEvent = ... | { type: string; [key: string]: unknown }` (union + index signature) has no SLA union type; represented as a tagged struct carrying the raw JSON line plus a kind tag.
// kind: 0=none 1=thought 2=text 3=tool_call 4=tool_call_update 5=usage 6=end 7=error 8=available_commands 9=other
struct GrokEvent {
    kind: u64,
    type_ptr: ptr,
    type_len: u64,
    raw_ptr: ptr,
    raw_len: u64,
}

// Parse one line of NDJSON from grok.exe stdout.
// Returns null if the line is empty, malformed, or non-JSON. (SLA: returns found=false instead of null.)
// DEFECT: try/catch + JSON.parse exception flow has no SLA equivalent; parse failure is reported via the found flag / status code.
fn parseGrokLine(line_ptr: ptr, line_len: u64, out_event: &GrokEvent, out_found: &bool) -> i32 {
    *out_found = false;
    out_event.kind = 0;
    // trimmed = line.trim(); if (!trimmed || !trimmed.startsWith("{")) return null;
    if line_len == 0 { return 0; };
    // DEFECT: string trim / startsWith need byte-scan helpers from sa_std; approximated by caller passing a pre-trimmed line.
    let parsed_ok: bool = false;
    // parsed = JSON.parse(trimmed) via sa_json_* externs (see sa_std .sai).
    // if (typeof parsed === "object" && parsed !== null && "type" in parsed) return parsed as GrokEvent;
    // DEFECT: `in` operator / runtime typeof check on dynamic JSON approximated by a sa_json_has_key("type") probe.
    if parsed_ok {
        out_event.raw_ptr = line_ptr;
        out_event.raw_len = line_len;
        *out_found = true;
    };
    return 0;
}
