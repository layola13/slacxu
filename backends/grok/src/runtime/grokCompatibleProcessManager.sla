// DEFECT: EventEmitter inheritance (class extends EventEmitter) has no SLA equivalent; emitter is a struct field + explicit emit_* functions. Events: "rawLine", "event", "stderr", "error", "exit".
// DEFECT: node:child_process ChildProcessWithoutNullStreams handle and node:readline createInterface line splitter have no sa_std 1:1 surface; child handle is an opaque u64 and line splitting is approximated over the stdout byte stream (cf. sa_std_process_spawn_bidi style externs).

struct GrokProcessConfig {
    prompt_ptr: ptr,
    prompt_len: u64,
    cwd_ptr: ptr,
    cwd_len: u64,
    has_sessionId: bool,
    sessionId_ptr: ptr,
    sessionId_len: u64,
    has_model: bool,
    model_ptr: ptr,
    model_len: u64,
    has_effort: bool,
    effort_ptr: ptr,
    effort_len: u64,
    // mode?: "acceptEdits" | "plan" — 0=acceptEdits/default, 1=plan
    mode_is_plan: bool,
    // DEFECT: dynamic object — envOverrides?: Record<string,string> kept as JSON text buffer.
    envOverrides_ptr: ptr,
    envOverrides_len: u64,
}

struct GrokCompatibleProcessManager {
    child: u64, // 0 = none
    stopping: bool,
    config: GrokProcessConfig,
}

fn GrokCompatibleProcessManager_new(config: &GrokProcessConfig, out_self: &GrokCompatibleProcessManager) -> void {
    out_self.child = 0;
    out_self.stopping = false;
    out_self.config.prompt_ptr = config.prompt_ptr;
    out_self.config.prompt_len = config.prompt_len;
    out_self.config.cwd_ptr = config.cwd_ptr;
    out_self.config.cwd_len = config.cwd_len;
}

fn GrokCompatibleProcessManager_isRunning(self: &GrokCompatibleProcessManager) -> bool {
    // return Boolean(this.child && !this.child.killed && this.child.exitCode === null);
    return self.child != 0;
}

