// Line/event dispatch replacing the readline + emitter wiring (see DEFECT above).
fn GrokCompatibleProcessManager_onStdoutLine(self: &GrokCompatibleProcessManager, line_ptr: ptr, line_len: u64, out_event: &GrokEvent, out_has_event: &bool) -> void {
    // emit("rawLine", line) — owner receives the raw line unchanged.
    parseGrokLine(line_ptr, line_len, out_event, out_has_event);
    // if (event) emit("event", event) — signalled via out_has_event.
}

