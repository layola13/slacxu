fn GrokCompatibleProcessManager_waitForExit(self: &GrokCompatibleProcessManager, timeoutMs: u64) -> i32 {
    if !GrokCompatibleProcessManager_isRunning(self) { return 0; };
    // return new Promise((resolve) => { const timer = setTimeout(() => { this.stop(); resolve(); }, timeoutMs); this.once("exit", () => { clearTimeout(timer); resolve(); }); });
    return 0;
}

