@import "sa_std/io/print.sai"
@import "grokCompatibleProcessManager.sla"
@import "grokCompatibleTurnProjector.sla"
@import "grokCompatibleProtocol.sla"

// DEFECT: EventEmitter inheritance has no SLA equivalent; events "sessionId" / "notification" / "error" are delivered through explicit out-params / dispatch functions instead of .on subscriptions (see executeTurn notes).

struct GrokRuntimeConfig {
    threadId_ptr: ptr,
    threadId_len: u64,
    cwd_ptr: ptr,
    cwd_len: u64,
    has_sessionId: bool,
    sessionId_ptr: ptr,
    sessionId_len: u64,
    has_model: bool,
    model_ptr: ptr,
    model_len: u64,
    has_effort: bool,
    effort_ptr: ptr,
    effort_len: u64,
    mode_is_plan: bool, // mode?: "acceptEdits" | "plan"
    has_providerId: bool,
    providerId_ptr: ptr,
    providerId_len: u64,
    has_groupId: bool,
    groupId_ptr: ptr,
    groupId_len: u64,
    // DEFECT: dynamic object — envOverrides?: Record<string,string> kept as JSON text buffer.
    envOverrides_ptr: ptr,
    envOverrides_len: u64,
}

// DEFECT: class -> struct + function family; nullable class fields (process / ctx) become has_* flags + embedded structs.
struct GrokCompatibleRuntime {
    has_process: bool,
    process: GrokCompatibleProcessManager,
    has_ctx: bool,
    ctx: GrokProjectorContext,
    config: GrokRuntimeConfig,
}

fn GrokCompatibleRuntime_new(config: &GrokRuntimeConfig, out_self: &GrokCompatibleRuntime) -> void {
    out_self.has_process = false;
    out_self.has_ctx = false;
    out_self.config.threadId_ptr = config.threadId_ptr;
    out_self.config.threadId_len = config.threadId_len;
    out_self.config.cwd_ptr = config.cwd_ptr;
    out_self.config.cwd_len = config.cwd_len;
}

// DEFECT: dynamic object — setEnvOverrides(env: Record<string,string>) takes a JSON text buffer.
fn GrokCompatibleRuntime_setEnvOverrides(self: &GrokCompatibleRuntime, env_ptr: ptr, env_len: u64) -> void {
    self.config.envOverrides_ptr = env_ptr;
    self.config.envOverrides_len = env_len;
}

// DEFECT: Partial<GrokRuntimeConfig> + Object.assign(this.config, updates) — mapped/partial type and dynamic assign have no SLA equivalents; updates are applied field-by-field from a full config plus a per-field present mask in the fix phase.
fn GrokCompatibleRuntime_updateConfig(self: &GrokCompatibleRuntime, updates: &GrokRuntimeConfig) -> void {
    self.config.cwd_ptr = updates.cwd_ptr;
    self.config.cwd_len = updates.cwd_len;
    self.config.model_ptr = updates.model_ptr;
    self.config.model_len = updates.model_len;
}

fn GrokCompatibleRuntime_threadId(self: &GrokCompatibleRuntime, out_ptr: ptr, out_len: &u64) -> void {
    out_ptr = self.config.threadId_ptr;
    out_len = self.config.threadId_len;
}

fn GrokCompatibleRuntime_sessionId(self: &GrokCompatibleRuntime, out_ptr: ptr, out_len: &u64, out_has: &bool) -> void {
    // return this.ctx?.sessionId ?? this.config.sessionId;
    // DEFECT: optional chaining + nullish coalescing flattened to has_* checks.
    if self.has_ctx {
        out_ptr = self.ctx.sessionId_ptr;
        out_len = self.ctx.sessionId_len;
        out_has = self.ctx.has_sessionId;
        return;
    };
    out_ptr = self.config.sessionId_ptr;
    out_len = self.config.sessionId_len;
    out_has = self.config.has_sessionId;
}

