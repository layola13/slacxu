}

// 从 tool_call_update 的 rawOutput 里提取子会话 id（subagent_id / task_id）。
// DEFECT: spread of Set into array ([...ids]) — result written to a fixed array capacity 8 + count.
fn extractGrokSubagentIds(rawOutput_ptr: ptr, rawOutput_len: u64, out_count: &u64) -> void {
    out_count = 0;
    collectGrokSubagentIds(rawOutput_ptr, rawOutput_len, out_count);
}

// DEFECT: dynamic object — buildGrokSubagentItem returns Record<string, JsonValue>; in SLA it serializes the collabAgentToolCall item into a JSON text buffer (out_item). Field logic preserved 1:1:
// description = asNonEmptyText(input.description) ?? asNonEmptyText(input.title) ?? ""; prompt = asNonEmptyText(input.prompt) ?? "";
// agentRole = asNonEmptyText(input.subagent_type) ?? asNonEmptyText(input.agent) ?? "subagent";
// agentStatus = status === "in_progress" ? "running" : status;
// receiverThreadIds = rawOutput === undefined ? [] : extractGrokSubagentIds(rawOutput);
// childThreadId = receiverThreadIds.length === 1 ? receiverThreadIds[0]! : undefined; (DEFECT: non-null assertion -> length guard)
// message = in_progress ? (description || `${agentRole} running`) : failed ? (description || `${agentRole} failed`) : (description || `${agentRole} completed`); (DEFECT: template literals -> buffer concat)
// outputText: string rawOutput as-is, object via JSON.stringify in try/catch (DEFECT: try/catch -> status check), then .trim().slice(0, 6000).
// Item: { type: "collabAgentToolCall", id: callId, threadId, turnId, tool: "task", status, senderThreadId: threadId, receiverThreadIds, prompt, agentId: childThreadId ?? callId, ...(childThreadId ? { agentThreadId: childThreadId } : {}), agentName: description || agentRole, agentRole, agentStatus, agentsStates: childThreadId ? { [childThreadId]: { status: agentStatus, message } } : {}, input, arguments: input, ...(outputText ? { output: outputText } : {}) }
// DEFECT: object spread with conditional computed key ({ [childThreadId]: ... }) has no SLA equivalent; the JSON buffer is built conditionally field-by-field.
fn buildGrokSubagentItem(threadId_ptr: ptr, threadId_len: u64, turnId_ptr: ptr, turnId_len: u64, callId_ptr: ptr, callId_len: u64, input_ptr: ptr, input_len: u64, status: u64, has_rawOutput: bool, rawOutput_ptr: ptr, rawOutput_len: u64, out_item_ptr: ptr, out_item_len: &u64) -> void {
    out_item_len = 0;
}

fn completeActiveAssistantMessage(ctx: &GrokProjectorContext, out_events_len: &u64, status: u64) -> void {
    if ctx.hasStartedCurrentAssistantMessage && !ctx.hasCompletedCurrentAssistantMessage {
        ctx.hasCompletedCurrentAssistantMessage = true;
        // events.push({ kind: "item/completed", threadId, turnId, item: { type: "agentMessage", id: ctx.currentAssistantItemId, threadId, turnId, content: [{ type: "text", text: ctx.currentAssistantText, text_elements: [] }], text: ctx.currentAssistantText, role: "assistant", status, completedAt: Math.floor(Date.now() / 1000) } });
        out_events_len = out_events_len + 1;
    };
}

// DEFECT: switch over the GrokEvent discriminated union with per-case type casts (event as GrokThoughtEvent etc.) — SLA dispatches on the raw JSON "type" string compared byte-wise; casts become field extraction from the same JSON buffer.
fn projectGrokEvent(event: &GrokEvent, ctx: &GrokProjectorContext, out_events_len: &u64) -> void {
    out_events_len = 0;
    if ctx.status != 0 { return; };
    if !ctx.hasStartedTurn {
        ctx.hasStartedTurn = true;
        // events.push({ kind: "turn/started", threadId, turnId });
        out_events_len = out_events_len + 1;
    };
    // switch (event.type):
    // case "available_commands": break; (preamble, no-op)
    // case "thought": if (thought.data) { if (hasCompletedCurrentAssistantMessage || hasCompletedCurrentReasoning) startNewGrokSegment(ctx); if (!hasStartedCurrentReasoning) { hasStartedCurrentReasoning = true; push item/started reasoning { title: "Reasoning", text: "", status: "inProgress", startedAt, firstTokenAt }; } reasoningText += data; currentReasoningText += data; push item/reasoning/textDelta; }
    // case "text": if (text.data) { assistantText += data; hasStartedAgentMessage = true; completeActiveReasoning(ctx, events); if (hasCompletedCurrentAssistantMessage) startNewGrokSegment(ctx); if (!hasStartedCurrentAssistantMessage) { hasStartedCurrentAssistantMessage = true; push item/started agentMessage { role: "assistant", status: "inProgress", text: "", content: [] }; } currentAssistantText += data; push item/agentMessage/delta; }
    // case "tool_call": completeActiveReasoning; complete current assistant message if open; callId = tc.toolCallId || `grok-tool-${turnId}-${Date.now()}`; toolName = tc.toolName || tc.title || "tool"; inputObj = tc.rawInput ?? {}; if (toolName === "use_tool") toolName = inputObj.tool_name || inputObj.toolName || inputObj.name (when string); resolvedInput = { ...inputObj, ...(inputObj.tool_input object ? inputObj.tool_input : {}) }; (DEFECT: object spread merge of dynamic JSON -> JSON buffer merge) if (isGrokTaskToolName(toolName)) { activeToolItems.set(callId, buildGrokSubagentItem(..., "in_progress")); break; } toolItem = { type: "toolCall", id: callId, threadId, turnId, name/tool/toolName: toolName, input/arguments: resolvedInput, status: "in_progress" }; activeToolItems.set(callId, toolItem); push item/started.
    // case "tool_call_update": callId = tcu.toolCallId; existing = activeToolItems.get(callId) ?? default toolCall item; if (existing.type === "collabAgentToolCall") { terminal = status completed/failed mapping; input = existing.input ?? existing.arguments (object check); updated = buildGrokSubagentItem(..., terminal ?? "in_progress", tcu.rawOutput); activeToolItems.set; linked = receiverThreadIds.length > 0; if (terminal) push item/completed; else if (linked && !emittedTaskStarts.has(callId)) { emittedTaskStarts.add(callId); push item/started; } break; } isDone = completed||failed; updated = { ...existing, turnId, status: isDone ? (failed ? "failed" : "completed") : "in_progress", ...(tcu.rawOutput ? { output: tcu.rawOutput } : {}) }; activeToolItems.set; if (isDone) push item/completed.
    // case "usage": completeActiveReasoning; complete current assistant message if open; break;
    // case "end": ctx.sessionId = end.sessionId; push system/init; completeActiveReasoning; complete assistant if open; unsettledTools = [...activeToolItems.values()].some(item => status in_progress/inProgress/started); (DEFECT: spread + Array.some closure -> explicit loop) stopReason normalized trim().toLowerCase(); cleanStop = "" or "end_turn"; if (unsettledTools || !cleanStop) { ctx.status = failed; push turn/failed with reason `grok turn stopped (${end.stopReason || "unknown reason"})` (+ " with tools still running" when unsettledTools); break; } ctx.status = completed; push turn/completed.
    // case "error": ctx.status = failed; errorText = err.message || "Grok execution failed"; completeActiveReasoning(failed); if assistant open complete it failed; else if (!hasStartedAgentMessage && !hasStartedCurrentReasoning) { hasStartedAgentMessage = true; push item/started + item/completed agentMessage failed with errorText (id = ctx.assistantItemId || `grok-err-${turnId}`); } push turn/failed.
}

// DEFECT: JsonRpcNotification return (or null) — null is out_found=false; the notification JSON is built into a text buffer per kind:
// turn/started -> { method: "turn/started", params: { threadId, turnId, turn: { id: turnId, threadId, status: "inProgress" } } }
// turn/completed -> status "completed"; turn/failed -> turn: { ..., status: "failed", error: error ?? null }, error: error ?? undefined (DEFECT: `as unknown as Record<string, JsonValue>` double cast dropped — buffer built directly)
// turn/interrupted -> status "interrupted"
// item/agentMessage/delta -> { threadId, turnId, itemId, delta }; item/reasoning/textDelta -> same shape
// item/started / item/completed -> { threadId, turnId, item }
// system/init -> { method: "grok/init", params: { threadId, sessionId } }
// default -> null
fn toGrokNotification(event: &GrokProjectedEvent, out_ptr: ptr, out_len: &u64, out_found: &bool) -> void {
    out_found = false;
    out_len = 0;
}

fn forceTerminateGrok(ctx: &GrokProjectorContext, reason: u64, has_error: bool, error_ptr: ptr, error_len: u64, out_events_len: &u64) -> void {
    // reason: 2=failed 3=interrupted (default "interrupted")
    out_events_len = 0;
    if ctx.status != 0 { return; };
    ctx.status = reason;
    // const errorText = error || (reason === "failed" ? "Process terminated abruptly" : undefined);
    // completeActiveReasoning(ctx, events, interrupted|failed per reason);
    // if assistant open -> completeActiveAssistantMessage(same status);
    // else if (reason === "failed" && !hasStartedAgentMessage && !hasStartedCurrentReasoning && errorText) push item/started + item/completed failed agentMessage (id = ctx.assistantItemId || `grok-err-${ctx.turnId}`);
    // push { kind: reason === "interrupted" ? "turn/interrupted" : "turn/failed", threadId, turnId, error: errorText };
}
