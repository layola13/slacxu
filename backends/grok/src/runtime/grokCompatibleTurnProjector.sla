// Converted 1:1 from backends/grok/src/runtime/grokCompatibleTurnProjector.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "sa_std/io/print.sai"
@import "grokCompatibleProtocol.sla"

// DEFECT: dynamic JSON — JsonValue / JsonRpcNotification (from @codex-ui/shared) and every `item: Record<string, JsonValue>` payload are JSON text buffers (ptr,len) in SLA; projected events are a tagged struct instead of the TS discriminated union.
// GrokProjectedEvent union -> kind tag: 0=turn/started 1=turn/completed 2=turn/failed 3=turn/interrupted 4=item/agentMessage/delta 5=item/reasoning/textDelta 6=item/started 7=item/completed 8=system/init
struct GrokProjectedEvent {
    kind: u64,
    threadId_ptr: ptr,
    threadId_len: u64,
    turnId_ptr: ptr,
    turnId_len: u64,
    has_error: bool,
    error_ptr: ptr,
    error_len: u64,
    // itemId (delta kinds) / item JSON (started/completed kinds)
    itemId_ptr: ptr,
    itemId_len: u64,
    delta_ptr: ptr,
    delta_len: u64,
    item_ptr: ptr,
    item_len: u64,
    // system/init fields
    sessionId_ptr: ptr,
    sessionId_len: u64,
    has_cwd: bool,
    cwd_ptr: ptr,
    cwd_len: u64,
    // DEFECT: dynamic array — tools?: string[] kept as JSON text buffer.
    tools_ptr: ptr,
    tools_len: u64,
}

// DEFECT: Map<string, Record<string, JsonValue>> (activeToolItems) and Set<string> (emittedTaskStarts) have no SLA equivalents; both are fixed-capacity key arrays (capacity 64, estimated from per-turn tool-call volume) + len, keyed by (ptr,len) callId byte equality.
struct GrokProjectorContext {
    threadId_ptr: ptr,
    threadId_len: u64,
    turnId_ptr: ptr,
    turnId_len: u64,
    has_sessionId: bool,
    sessionId_ptr: ptr,
    sessionId_len: u64,
    // status: "running" | "completed" | "failed" | "interrupted" -> 0=running 1=completed 2=failed 3=interrupted
    status: u64,
    textSegmentSeq: u64,
    currentAssistantItemId_ptr: ptr,
    currentAssistantItemId_len: u64,
    // DEFECT: JS string accumulation (currentAssistantText += data) — growable string approximated by a fixed byte buffer capacity 65536 + len.
    currentAssistantText_len: u64,
    hasStartedCurrentAssistantMessage: bool,
    hasCompletedCurrentAssistantMessage: bool,
    hasStartedCurrentReasoning: bool,
    hasCompletedCurrentReasoning: bool,
    currentReasoningItemId_ptr: ptr,
    currentReasoningItemId_len: u64,
    currentReasoningText_len: u64,
    assistantItemId_ptr: ptr,
    assistantItemId_len: u64,
    reasoningItemId_ptr: ptr,
    reasoningItemId_len: u64,
    assistantText_len: u64,
    reasoningText_len: u64,
    hasStartedTurn: bool,
    hasStartedAgentMessage: bool,
    activeToolItems_len: u64,
    emittedTaskStarts_len: u64,
}

fn createGrokProjectorContext(threadId_ptr: ptr, threadId_len: u64, turnId_ptr: ptr, turnId_len: u64, out_ctx: &GrokProjectorContext) -> void {
    // const initialAssistantItemId = `grok-msg-${turnId}-0`;
    // const initialReasoningItemId = `grok-thought-${turnId}-0`;
    // DEFECT: template literals (`grok-msg-${turnId}-0`) have no SLA string interpolation; ids are built by byte-buffer concatenation in the fix phase.
    out_ctx.threadId_ptr = threadId_ptr;
    out_ctx.threadId_len = threadId_len;
    out_ctx.turnId_ptr = turnId_ptr;
    out_ctx.turnId_len = turnId_len;
    out_ctx.status = 0;
    out_ctx.textSegmentSeq = 0;
    out_ctx.currentAssistantText_len = 0;
    out_ctx.currentReasoningText_len = 0;
    out_ctx.assistantText_len = 0;
    out_ctx.reasoningText_len = 0;
    out_ctx.hasStartedCurrentAssistantMessage = false;
    out_ctx.hasCompletedCurrentAssistantMessage = false;
    out_ctx.hasStartedCurrentReasoning = false;
    out_ctx.hasCompletedCurrentReasoning = false;
    out_ctx.hasStartedTurn = false;
    out_ctx.hasStartedAgentMessage = false;
    out_ctx.activeToolItems_len = 0;
    out_ctx.emittedTaskStarts_len = 0;
}

fn startNewGrokSegment(ctx: &GrokProjectorContext) -> void {
    ctx.textSegmentSeq = ctx.textSegmentSeq + 1;
    // ctx.currentAssistantItemId = `grok-msg-${ctx.turnId}-${ctx.textSegmentSeq}`;
    // ctx.currentReasoningItemId = `grok-thought-${ctx.turnId}-${ctx.textSegmentSeq}`;
    ctx.currentAssistantText_len = 0;
    ctx.currentReasoningText_len = 0;
    ctx.hasStartedCurrentAssistantMessage = false;
    ctx.hasCompletedCurrentAssistantMessage = false;
    ctx.hasStartedCurrentReasoning = false;
    ctx.hasCompletedCurrentReasoning = false;
}

// 对齐 mini(muse)/opencode：思考独立成 reasoning 项，正文只含 text，
// 瀑布流靠 reasoningBuffer 把思考挂到下一条 agentMessage 的 Thinking 位，
// 正文不再重复思考内容。
// DEFECT: events array push (GrokProjectedEvent[]) — caller-provided fixed array capacity 32 + len out-param (out_events_len) used by all projector functions in this file.
fn completeActiveReasoning(ctx: &GrokProjectorContext, out_events_len: &u64, status: u64) -> void {
    // status default "completed"; 1=completed 2=failed 3=interrupted
    if ctx.hasStartedCurrentReasoning && !ctx.hasCompletedCurrentReasoning {
        ctx.hasCompletedCurrentReasoning = true;
        // events.push({ kind: "item/completed", threadId, turnId, item: { type: "reasoning", id: ctx.currentReasoningItemId, threadId, turnId, title: "Reasoning", text: ctx.currentReasoningText, status, completedAt: Math.floor(Date.now() / 1000) } });
        // DEFECT: dynamic object — item literal serialized to a JSON text buffer via sa_json_* externs.
        out_events_len = out_events_len + 1;
    };
}

// Grok 原生 task 工具的线名（对齐 grok-build `is_task_tool_id`）：
// task | Task | spawn_subagent。命中后投影为 collabAgentToolCall，
// 子 agent 视图（agent rail / all-agents 页）才能正确收敛。
fn isGrokTaskToolName(name_ptr: ptr, name_len: u64) -> bool {
    // const trimmed = name.trim().toLowerCase(); if (!trimmed) return false;
    // const bare = trimmed.split(/[/:._-]{1,2}/).pop() ?? trimmed;
    // DEFECT: RegExp split (/[/:._-]{1,2}/) + Array.pop + ?? — no SLA regex; approximated by scanning for the last separator byte run (/ : . _ -) and taking the tail segment.
    // const compact = bare.replace(/[_-]+/g, "");
    // DEFECT: RegExp replace (/[_-]+/g) approximated by a byte filter dropping '_' and '-'.
    // return compact === "task" || compact === "spawnsubagent";
    return false;
}

fn asNonEmptyText(value_ptr: ptr, value_len: u64, is_string: bool, out_ptr: ptr, out_len: &u64, out_has: &bool) -> void {
    // return typeof value === "string" && value.trim() ? value.trim() : undefined;
    // DEFECT: typeof runtime check on unknown — caller passes is_string from the JSON node kind.
    out_has = is_string && value_len > 0;
    out_ptr = value_ptr;
    out_len = value_len;
}

// DEFECT: recursion over dynamic JSON (string | array | object) + RegExp global matching + Set<string> accumulation — collectGrokSubagentIds is the recursive walker; in SLA it walks the JSON text buffer with sa_json_* externs and appends matches to a fixed array capacity 8 (source caps `into.size >= 8` identically).
