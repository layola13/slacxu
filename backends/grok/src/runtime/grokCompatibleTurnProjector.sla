    //   const trimmed = value.trim();
    //   if (trimmed.startsWith("{") || trimmed.startsWith("[")) { try { collectGrokSubagentIds(JSON.parse(trimmed), into); } catch { /* 非 JSON 文本，忽略 */ } }
    //   DEFECT: try/catch around JSON.parse — parse status code checked instead.
    //   return;
    // }
    // if (Array.isArray(value)) { for (const entry of value) { if (into.size >= 8) return; collectGrokSubagentIds(entry, into); } return; }
    // if (value && typeof value === "object") {
    //   const record = value as Record<string, unknown>;
    //   for (const key of ["subagent_id","subagent_ids","task_id","task_ids","resume_from","resume_from_hint"]) {
    //     const direct = record[key];
    //     if (typeof direct === "string") { if (/^[\w-]{4,128}$/.test(direct.trim())) into.add(direct.trim()); continue; }
    //     DEFECT: anchored RegExp test (/^[\w-]{4,128}$/) approximated by a byte-run length/charset check.
    //     if (Array.isArray(direct)) { for (const entry of direct) { ...same string check... into.add(...); } continue; }
    //     collectGrokSubagentIds(direct, into);
