// DEFECT: class -> struct + function family; http.Server handle is opaque u64 (0 = none).
struct GrokProxyServer {
    server: u64,
    port: u64,
    config: GrokProxyConfig,
}

fn GrokProxyServer_new(config: &GrokProxyConfig, out_self: &GrokProxyServer) -> void {
    out_self.server = 0;
    out_self.port = 0;
    out_self.config.targetBaseUrl_ptr = config.targetBaseUrl_ptr;
    out_self.config.targetBaseUrl_len = config.targetBaseUrl_len;
    out_self.config.targetModel_ptr = config.targetModel_ptr;
    out_self.config.targetModel_len = config.targetModel_len;
    out_self.config.apiKeys_len = config.apiKeys_len;
}

fn GrokProxyServer_url(self: &GrokProxyServer, out_ptr: ptr, out_len: &u64) -> void {
    // return `http://127.0.0.1:${this.port}`; — DEFECT: template literal -> buffer concatenation.
    out_len = 0;
}

fn GrokProxyServer_boundPort(self: &GrokProxyServer) -> u64 {
    return self.port;
}

// DEFECT: Partial<GrokProxyConfig> + object spread merge ({ ...this.config, ...config }) -> field-wise copy of the present fields only (present mask in the fix phase).
fn GrokProxyServer_updateConfig(self: &GrokProxyServer, config: &GrokProxyConfig) -> void {
    self.config.targetBaseUrl_ptr = config.targetBaseUrl_ptr;
    self.config.targetBaseUrl_len = config.targetBaseUrl_len;
    self.config.targetModel_ptr = config.targetModel_ptr;
    self.config.targetModel_len = config.targetModel_len;
}

