@import "sa_std/io/print.sai"

// DEFECT: Node http server (node:http createServer / IncomingMessage / ServerResponse), global fetch / Response / AbortSignal, TextDecoder, Buffer, and streams (getReader) have no sa_std 1:1 surfaces in this conversion; the server handle is an opaque u64, request/response bodies are byte buffers, and upstream fetches are extern-style calls in the shape of sa_http_client_* (see sa_std .sai). Each use is noted inline.
// DEFECT: dynamic JSON — every payload (Record<string, any>) is a JSON text buffer (ptr,len); all translation functions below parse and rebuild JSON buffers field-by-field in source order via sa_json_* externs.

struct GrokProxyConfig {
    targetBaseUrl_ptr: ptr,
    targetBaseUrl_len: u64,
    targetModel_ptr: ptr,
    targetModel_len: u64,
    // apiKeys: string[] — fixed array capacity 16 + len (capacity estimated from key-rotation semantics).
    apiKeys_len: u64,
    // DEFECT: dynamic object — provider?: ProviderConfig / group?: ChannelGroupConfig kept as JSON text buffers.
    has_provider: bool,
    provider_ptr: ptr,
    provider_len: u64,
    has_group: bool,
    group_ptr: ptr,
    group_len: u64,
    // Owning conversation: used to derive the stable per-thread x-opencode-session header.
    has_threadId: bool,
    threadId_ptr: ptr,
    threadId_len: u64,
    has_modelDisplayName: bool,
    modelDisplayName_ptr: ptr,
    modelDisplayName_len: u64,
    has_grokCliModel: bool,
    grokCliModel_ptr: ptr,
    grokCliModel_len: u64,
    has_reasoningEffort: bool,
    reasoningEffort_ptr: ptr,
    reasoningEffort_len: u64,
    has_maxTokens: bool,
    maxTokens: u64,
    has_maxCompletionTokens: bool,
    maxCompletionTokens: u64,
    // wireApi?: "chat" | "responses" | "anthropic" | "gemini" -> GrokWireApi tag below
    has_wireApi: bool,
    wireApi: u64,
    has_verbose: bool,
    verbose: bool,
}

// GrokWireApi tag: 0=chat 1=responses 2=anthropic 3=gemini (source: export type GrokWireApi = "chat" | "responses" | "anthropic" | "gemini")

// buildUpstreamUrl(baseUrl, path): base trimmed of trailing "/"+; [pathPart, queryPart] = path.split("?"); query = queryPart ? `?${queryPart}` : ""; rel = pathPart without leading "/"+; if (base.endsWith("/v1") && rel.startsWith("v1/")) rel = rel.slice(3); return `${base}/${rel}${query}`;
// DEFECT: RegExp replaces (/\/+$/, /^\/+/) + string split + template literal — approximated by byte scans trimming '/' runs and a '?' split; result built by buffer concatenation.
fn buildUpstreamUrl(baseUrl_ptr: ptr, baseUrl_len: u64, path_ptr: ptr, path_len: u64, out_ptr: ptr, out_len: &u64) -> void {
    out_len = 0;
}

// Normalize a group `responseProtocol` (or legacy wireApi value) to the upstream wire protocol the Grok proxy must speak.
// CLI input protocol (Responses vs Chat, decided by request path) is orthogonal: this only describes what the *upstream relay* expects, so a
// responses-only relay (wireApi=responses) never receives chat/completions.
// v = String(value ?? "").trim().toLowerCase(); "responses"|"openai-response"|"openai-responses" -> responses; "anthropic"|"claude"|"messages" -> anthropic; "gemini"|"google"|"vertex" -> gemini; else chat.
fn normalizeGrokWireApi(value_ptr: ptr, value_len: u64) -> u64 {
    return 0;
}

// resolveGrokWireApi(group, model?): protocol = group?.responseProtocol; void model; return normalizeGrokWireApi(protocol ?? "chat");
// DEFECT: `void model` (deliberately unused parameter) kept as an ignored parameter to preserve the signature.
fn resolveGrokWireApi(group_ptr: ptr, group_len: u64, has_group: bool, model_ptr: ptr, model_len: u64) -> u64 {
    return 0;
}

fn resolveResponsesEndpoint(baseUrl_ptr: ptr, baseUrl_len: u64, out_ptr: ptr, out_len: &u64) -> void {
    // return buildUpstreamUrl(baseUrl, "/v1/responses");
    buildUpstreamUrl(baseUrl_ptr, baseUrl_len, STR_PTR("/v1/responses"), STR_LEN("/v1/responses"), out_ptr, out_len);
}

fn resolveAnthropicEndpoint(baseUrl_ptr: ptr, baseUrl_len: u64, out_ptr: ptr, out_len: &u64) -> void {
    // trimmed = baseUrl.trim().replace(/\/+$/, ""); if endsWith "/messages" return trimmed; if endsWith "/v1" return `${trimmed}/messages`; return `${trimmed}/v1/messages`;
    out_len = 0;
}

fn resolveGeminiGenerateEndpoint(baseUrl_ptr: ptr, baseUrl_len: u64, model_ptr: ptr, model_len: u64, out_ptr: ptr, out_len: &u64) -> void {
    // base = trim + strip trailing "/"+; if (!base) base = "https://generativelanguage.googleapis.com"; if base includes ":generateContent" or ":streamGenerateContent" return base; cleanModel = model without "models/" prefix; if endsWith "/v1beta" or "/v1" return `${base}/models/${cleanModel}:generateContent`; return `${base}/v1beta/models/${cleanModel}:generateContent`;
    out_len = 0;
}

// responsesRequestToChat(payload, activeModel, options?): full translation preserved 1:1 as JSON-buffer rewriting:
// - model = activeModel; inputItems = payload.input || []; string input -> [{ type: "message", role: "user", content: input }]; non-array -> [].
// - messages = []; systemTexts = []; instructions (string, trimmed) pushed to systemTexts.
// - rawTools = [...payload.tools] plus tools of every input item with type "additional_tools".
// - Per input item: message/assistant_message/agent_message (or typeless with role/content/text): role resolution (missing -> assistant for assistant_message/agent_message else user; "developer" -> "system"); content from string, or array parts joined (p.text || p.output_text || p.output_text_delta), or item.text; system -> systemTexts else messages.push({ role, content }).
// - function_call/custom_tool_call/mcp_tool_call: callId = item.call_id || `call_${randomUUID slice 12}`; name = item.name || "tool"; argumentsStr from string or JSON.stringify(object); appended to last assistant message's tool_calls (creating the array) or a new { role: "assistant", content: null, tool_calls: [...] } message.
// - function_call_output/custom_tool_call_output/tool_search_output/mcp_tool_call_output: outputStr from content ?? output ?? text (string / array parts joined / JSON.stringify); messages.push({ role: "tool", tool_call_id: callId, name, content: outputStr }).
// - If systemTexts non-empty: messages.unshift({ role: "system", content: systemTexts.join("\n\n") }). (DEFECT: Array.unshift/spread on dynamic arrays -> buffer rebuild with the system message first)
// - openaiTools: function tools -> { type: "function", function: { name, description || "", parameters || {} } }; namespace tools flattened to `${nsName}__${subName}`; custom tools only "exec_command" kept.
// - outPayload = { model, messages, stream: Boolean(payload.stream) }; tools + tool_choice "auto" when any; copies temperature/top_p/presence_penalty/frequency_penalty/max_tokens/max_completion_tokens/reasoning_effort when present in payload; then options fallbacks for reasoning_effort / max_completion_tokens / max_tokens.
// DEFECT: randomUUID() for synthesized call ids — uuid extern (see grokBridge.sla note).
fn responsesRequestToChat(payload_ptr: ptr, payload_len: u64, activeModel_ptr: ptr, activeModel_len: u64, has_opts: bool, reasoningEffort_ptr: ptr, reasoningEffort_len: u64, maxTokens: u64, maxCompletionTokens: u64, out_ptr: ptr, out_len: &u64) -> void {
    out_len = 0;
}

// chatResponseToResponses(chatResp): choices[0].message -> output items: reasoning (message.reasoning_content || message.reasoning) as { type: "reasoning", summary: [summary_text], content: [reasoning_text], encrypted_content: null }; outputText as { type: "message", role: "assistant", content: [output_text] }; each tool_call as { type: "function_call", id: `tc_${uuid12}`, call_id: tc.id || `call_${uuid12}`, name: fn.name || "tool", arguments: fn.arguments || "{}" }.
// usage mapping prompt_tokens ?? input_tokens, completion_tokens ?? output_tokens, total ?? sum. Returns { id: `resp_${uuid12}`, object: "response", output, output_text, usage: { input_tokens, output_tokens, total_tokens }, status: "completed" }.
fn chatResponseToResponses(chatResp_ptr: ptr, chatResp_len: u64, out_ptr: ptr, out_len: &u64) -> void {
    out_len = 0;
}

// chatRequestToResponses(payload, activeModel, options = {}): messages -> Responses input: system/developer content text accumulated into instructions; tool messages -> { type: "function_call_output", call_id, output }; other messages -> { type: "message", role, content: contentText } when text present, plus one function_call per tool_call ({ call_id: tc.id || synthesized, name, arguments stringified }); empty message -> { type: "message", role, content: "" }.
// Tools flattened to { type: "function", name, description || "", parameters || { type: "object", properties: {} } } (tools without a name skipped).
// out = { model: activeModel, input, stream: Boolean(payload.stream) }; instructions joined "\n\n" when any; tools + tool_choice "auto" when any; temperature/top_p copied; max_output_tokens from max_completion_tokens ?? max_tokens ?? options; reasoning = { effort } from reasoning_effort ?? options.reasoningEffort.
fn chatRequestToResponses(payload_ptr: ptr, payload_len: u64, activeModel_ptr: ptr, activeModel_len: u64, has_opts: bool, reasoningEffort_ptr: ptr, reasoningEffort_len: u64, maxTokens: u64, maxCompletionTokens: u64, out_ptr: ptr, out_len: &u64) -> void {
    out_len = 0;
}

// responsesResponseToChat(responsesJson, model): output items -> content (message parts' text appended; output_text seeds content), reasoning (reasoning items' summary+content text), toolCalls from function_call items ({ id: call_id || id || synthesized, type: "function", function: { name || "tool", arguments string-or-stringified } }).
// message = { role: "assistant", content: content || null } + reasoning_content when reasoning + tool_calls when any; content forced "" when nothing at all.
// Returns { id: responsesJson.id || `chatcmpl_${uuid12}`, object: "chat.completion", created: now_s, model, choices: [{ index: 0, message, finish_reason: toolCalls ? "tool_calls" : "stop" }], usage: { prompt_tokens: input_tokens ?? 0, completion_tokens: output_tokens ?? 0, total_tokens: total ?? sum } }.
fn responsesResponseToChat(responsesJson_ptr: ptr, responsesJson_len: u64, model_ptr: ptr, model_len: u64, out_ptr: ptr, out_len: &u64) -> void {
    out_len = 0;
}

// openAiMessagesToAnthropicPayload(messages, tools, model, options = {}): system/developer text -> systemTexts; tool messages -> user message with [{ type: "tool_result", tool_use_id, content }]; other messages -> blocks: text block for string content + one tool_use block per tool_call ({ id || `toolu_${uuid8}`, name, input: JSON.parse(arguments) in try/catch with { _raw } fallback — DEFECT: try/catch -> parse status check }); empty blocks -> [{ type: "text", text: "(empty)" }]; role assistant stays assistant else user. No messages -> single "(empty)" user message.
// body = { model, max_tokens: options.maxTokens in (0,16384] clamp else 8192, messages, stream: false }; system joined when any; temperature when numeric; tools mapped to { name, description || "", input_schema: parameters || { type: "object", properties: {} } }.
fn openAiMessagesToAnthropicPayload(messages_ptr: ptr, messages_len: u64, tools_ptr: ptr, tools_len: u64, model_ptr: ptr, model_len: u64, has_maxTokens: bool, maxTokens: u64, has_temperature: bool, temperature: f64, out_ptr: ptr, out_len: &u64) -> void {
    out_len = 0;
}

// anthropicResponseToChat(anthropicJson, model): content blocks -> text concatenation + tool_use blocks -> toolCalls ({ id || synthesized, function: { name || "tool", arguments: JSON.stringify(input ?? {}) } }); usage input/output tokens, total = sum; same chat.completion envelope as responsesResponseToChat.
fn anthropicResponseToChat(anthropicJson_ptr: ptr, anthropicJson_len: u64, model_ptr: ptr, model_len: u64, out_ptr: ptr, out_len: &u64) -> void {
    out_len = 0;
}

// openAiMessagesToGeminiPayload(messages, tools, model): system/developer text -> systemTexts; tool messages -> { role: "user", parts: [{ text }] }; other messages -> parts: text part + functionCall parts ({ name, args: JSON.parse(arguments) try/catch { _raw } fallback }); empty parts -> [{ text: "(empty)" }]; role assistant -> "model" else "user". void model (DEFECT: deliberately unused parameter kept). body = { contents }; systemInstruction = { parts: [{ text: joined }] } when any; tools -> [{ functionDeclarations: [...] }].
fn openAiMessagesToGeminiPayload(messages_ptr: ptr, messages_len: u64, tools_ptr: ptr, tools_len: u64, model_ptr: ptr, model_len: u64, out_ptr: ptr, out_len: &u64) -> void {
