// Converted 1:1 from backends/grok/src/runtime/grokSessionStore.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
// Persists Grok CLI session and conversation metadata separately
// from Codex thread IDs. This allows history to remain readable after
// a server restart, and enables resuming existing conversations using --resume.
// Schema: one row per internal thread ID that uses the Grok backend.
@import "sa_std/io/print.sai"

// DEFECT: RuntimeDatabase from @cxu/sdk-backend is a host-injected SQLite handle; in SLA it is an opaque handle value (db: u64) and all SQL goes through extern-style calls. No sa_std SQLite surface was assumed beyond prepare/exec/run/get/all equivalents noted per function.

struct GrokSessionRecord {
    threadId_ptr: ptr,
    threadId_len: u64,
    ownerId_ptr: ptr,
    ownerId_len: u64,
    // sessionId: string | null — has_* flag models nullability (same pattern for all nullable fields below).
    has_sessionId: bool,
    sessionId_ptr: ptr,
    sessionId_len: u64,
    has_cliVersion: bool,
    cliVersion_ptr: ptr,
    cliVersion_len: u64,
    has_model: bool,
    model_ptr: ptr,
    model_len: u64,
    has_cwd: bool,
    cwd_ptr: ptr,
    cwd_len: u64,
    has_permissionMode: bool,
    permissionMode_ptr: ptr,
    permissionMode_len: u64,
    has_stateJson: bool,
    stateJson_ptr: ptr,
    stateJson_len: u64,
    createdAt: u64,
    updatedAt: u64,
}

// GrokSessionRow mirrors the snake_case DB columns (thread_id, owner_id, session_id, cli_version, model, cwd, permission_mode, state_json, created_at, updated_at) — same fields as GrokSessionRecord; kept as a separate struct to preserve the 1:1 source shape.
struct GrokSessionRow {
    thread_id_ptr: ptr,
    thread_id_len: u64,
    owner_id_ptr: ptr,
    owner_id_len: u64,
    has_session_id: bool,
    session_id_ptr: ptr,
    session_id_len: u64,
    has_cli_version: bool,
    cli_version_ptr: ptr,
    cli_version_len: u64,
    has_model: bool,
    model_ptr: ptr,
    model_len: u64,
    has_cwd: bool,
    cwd_ptr: ptr,
    cwd_len: u64,
    has_permission_mode: bool,
    permission_mode_ptr: ptr,
    permission_mode_len: u64,
    has_state_json: bool,
    state_json_ptr: ptr,
    state_json_len: u64,
    created_at: u64,
    updated_at: u64,
}

// DEFECT: class with constructor side effect (CREATE TABLE) -> struct + init function family.
struct GrokSessionStore {
    db: u64,
}

