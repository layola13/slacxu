fn GrokSessionStore_mapRow(self: &GrokSessionStore, row: &GrokSessionRow, out_record: &GrokSessionRecord) -> void {
    out_record.threadId_ptr = row.thread_id_ptr;
    out_record.threadId_len = row.thread_id_len;
    out_record.ownerId_ptr = row.owner_id_ptr;
    out_record.ownerId_len = row.owner_id_len;
    out_record.has_sessionId = row.has_session_id;
    out_record.sessionId_ptr = row.session_id_ptr;
    out_record.sessionId_len = row.session_id_len;
    out_record.has_cliVersion = row.has_cli_version;
    out_record.cliVersion_ptr = row.cli_version_ptr;
    out_record.cliVersion_len = row.cli_version_len;
    out_record.has_model = row.has_model;
    out_record.model_ptr = row.model_ptr;
    out_record.model_len = row.model_len;
    out_record.has_cwd = row.has_cwd;
    out_record.cwd_ptr = row.cwd_ptr;
    out_record.cwd_len = row.cwd_len;
    out_record.has_permissionMode = row.has_permission_mode;
    out_record.permissionMode_ptr = row.permission_mode_ptr;
    out_record.permissionMode_len = row.permission_mode_len;
    out_record.has_stateJson = row.has_state_json;
    out_record.stateJson_ptr = row.state_json_ptr;
    out_record.stateJson_len = row.state_json_len;
    out_record.createdAt = row.created_at;
    out_record.updatedAt = row.updated_at;
}
