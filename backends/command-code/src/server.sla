// Converted 1:1 from backends/command-code/src/server.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
//
// Command Code — server side (kind "backend"). Independent plugin.
// The print-mode bridge lives under src/runtime; the host constructs
// the bridge from there via staging imports.
//
// SDK types (EngineHandle, EngineStatus, PluginInstallation,
// ServerHost, ServerPlugin) come from @cxu/sdk-backend/server —
// see the sdk-backend unit. Re-export of COMMAND_CODE_MANIFEST
// mirrors `export { COMMAND_CODE_MANIFEST }` from ./manifest.sla.
@import "./manifest.sla"
@import "sa_std/string.sa"

// class CommandCodeEngine implements EngineHandle.
// #status: EngineStatus = { phase: "stopped", transport: "stdio" } —
// string fields kept as (ptr, len) into string literals.
struct CommandCodeEngine {
    pluginId_ptr: ptr,
    pluginId_len: u64,
    status_phase_ptr: ptr,
    status_phase_len: u64,
    status_transport_ptr: ptr,
    status_transport_len: u64,
}

fn CommandCodeEngine_new(self: &CommandCodeEngine) -> void {
    self.pluginId_ptr = STR_PTR("command-code");
    self.pluginId_len = STR_LEN("command-code");
    self.status_phase_ptr = STR_PTR("stopped");
    self.status_phase_len = STR_LEN("stopped");
    self.status_transport_ptr = STR_PTR("stdio");
    self.status_transport_len = STR_LEN("stdio");
}

// DEFECT: async — TS `async start(): Promise<EngineStatus>`;
// converted to a synchronous fn returning a status code; the
// resulting EngineStatus is self.status_*.
fn CommandCodeEngine_start(self: &CommandCodeEngine) -> i32 {
    self.status_phase_ptr = STR_PTR("ready");
    self.status_phase_len = STR_LEN("ready");
    self.status_transport_ptr = STR_PTR("stdio");
    self.status_transport_len = STR_LEN("stdio");
    return 0;
}

// DEFECT: async — TS `async stop(): Promise<void>`.
fn CommandCodeEngine_stop(self: &CommandCodeEngine) -> i32 {
    self.status_phase_ptr = STR_PTR("stopped");
    self.status_phase_len = STR_LEN("stopped");
    self.status_transport_ptr = STR_PTR("stdio");
    self.status_transport_len = STR_LEN("stdio");
    return 0;
}

// status(): EngineStatus — TS returns this.#status; here the
// caller reads self.status_phase_* / self.status_transport_*.
fn CommandCodeEngine_status(self: &CommandCodeEngine) -> void {
}

// DEFECT: async + throw + unknown return — TS
// `async handleRpc(): Promise<unknown>` throws
// Error("command-code plugin engine is not wired to the host yet (phase 1 declaration)").
// SLA has no exceptions; returns error code 1.
fn CommandCodeEngine_handleRpc(self: &CommandCodeEngine, out_ptr: ptr, out_len: &u64) -> i32 {
    return 1;
}

// export const commandCodeServerPlugin: ServerPlugin — an object
// literal with function properties. SLA struct literals cannot
// hold closures; descriptor data is kept as fields and each
// function property becomes a free fn below.
// DEFECT: dynamic object / closures in ServerPlugin literal.
struct CommandCodeServerPlugin {
    manifest_doc: u64,
    cliSettings_slug_ptr: ptr,
    cliSettings_slug_len: u64,
    cliSettings_enabledEnvVar_ptr: ptr,
    cliSettings_enabledEnvVar_len: u64,
    discovery_preferredPathPrefKey_ptr: ptr,
    discovery_preferredPathPrefKey_len: u64,
}

fn commandCodeServerPlugin_new(self: &CommandCodeServerPlugin, manifest_doc: u64) -> void {
    self.manifest_doc = manifest_doc;
    self.cliSettings_slug_ptr = STR_PTR("command-code-cli");
    self.cliSettings_slug_len = STR_LEN("command-code-cli");
    self.cliSettings_enabledEnvVar_ptr = STR_PTR("CODEX_UI_COMMAND_CODE_COMPATIBLE_CLI_ENABLED");
    self.cliSettings_enabledEnvVar_len = STR_LEN("CODEX_UI_COMMAND_CODE_COMPATIBLE_CLI_ENABLED");
    self.discovery_preferredPathPrefKey_ptr = STR_PTR("cliPreferredCommandCodePath");
    self.discovery_preferredPathPrefKey_len = STR_LEN("cliPreferredCommandCodePath");
}

// discovery.binaryNames: ["command-code"]
// Never the bare "cmd" alias: on Windows that is cmd.exe.
fn commandCodeServerPlugin_discovery_binaryNames(idx: u64, out: &ptr, out_len: &u64) -> bool {
    if idx != 0 { return false; };
    *out = STR_PTR("command-code");
    *out_len = STR_LEN("command-code");
    return true;
}

// discovery.envBinVars: ["COMMAND_CODE_BIN", "CODEX_UI_COMMAND_CODE_BIN"]
fn commandCodeServerPlugin_discovery_envBinVars(idx: u64, out: &ptr, out_len: &u64) -> bool {
    if idx == 0 {
        *out = STR_PTR("COMMAND_CODE_BIN");
        *out_len = STR_LEN("COMMAND_CODE_BIN");
        return true;
    };
    if idx == 1 {
        *out = STR_PTR("CODEX_UI_COMMAND_CODE_BIN");
        *out_len = STR_LEN("CODEX_UI_COMMAND_CODE_BIN");
        return true;
    };
    return false;
}

// discovery.matchesKind: () => true
fn commandCodeServerPlugin_discovery_matchesKind() -> bool {
    return true;
}

// createEngine(_host: ServerHost): EngineHandle — returns a new engine.
fn commandCodeServerPlugin_createEngine(host: u64, out: &CommandCodeEngine) -> void {
    CommandCodeEngine_new(out);
}

// DEFECT: async — TS `async findInstallations(): Promise<PluginInstallation[]>` returns [].
fn commandCodeServerPlugin_findInstallations(out_count: &u64) -> i32 {
    *out_count = 0;
    return 0;
}

// skillRoots(): string[] — returns [".commandcode/skills"].
fn commandCodeServerPlugin_skillRoots(idx: u64, out: &ptr, out_len: &u64) -> bool {
    if idx != 0 { return false; };
    *out = STR_PTR(".commandcode/skills");
    *out_len = STR_LEN(".commandcode/skills");
    return true;
}
