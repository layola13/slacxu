// without payload. host_event_log_event(kind, line): full
// line log. All no-ops when no logger is wired.
fn host_event_log_init(errors_ptr: ptr, errors_len: u64) -> void {}
fn host_event_log_frame(kind_ptr: ptr, kind_len: u64, payload_len: u64) -> void {}
fn host_event_log_event(kind_ptr: ptr, kind_len: u64, line_ptr: ptr, line_len: u64) -> void {}

// json helpers over doc handles used throughout the bridges
// (sdk-backend json.sla family; declared by use here).
fn json_object_keys(doc: u64, payload: ptr, out: ptr, out_cap: u64) -> u64 { return 0; }
fn json_node_string(node: u64, out_ptr: &ptr, out_len: &u64) -> void { out_ptr = PTR_NULL(); out_len = 0; }
fn json_node_is_string(node: u64, out: &bool) -> void { out = false; }
fn process_poll_exit(proc: u64, out_code: &i32, out_exited: &bool) -> void { out_code = 0; out_exited = false; }
fn process_kill(proc: u64, signame_ptr: ptr, signame_len: u64) -> void {}
fn uuid_new(out: ptr, out_cap: u64) -> u64 {
    // DEFECT: random UUID unavailable in this pass; emits a
    // zero UUID (matches the other bridges in this unit).
    return append_bytes(out, out_cap, 0, STR_PTR("00000000-0000-4000-8000-000000000000"), STR_LEN("00000000-0000-4000-8000-000000000000"));
}
fn now_ms() -> u64 { return 0; }
fn process_cwd(out: ptr, out_cap: u64) -> u64 {
    let n: u64 = 0;
    env_get(STR_PTR("PWD"), STR_LEN("PWD"), out, out_cap, &n);
    return n;
}
fn env_get(key_ptr: ptr, key_len: u64, out: ptr, out_cap: u64, out_len: &u64) -> bool {
    let v_ptr: ptr = PTR_NULL();
    let v_len: u64 = 0;
    if sa_env_get(key_ptr, key_len, &v_ptr, &v_len) != 0 { out_len = 0; return false; };
    out_len = buf_copy(out, out_cap, v_ptr, v_len);
    return true;
}

// ts_trim_span: String.prototype.trim span — 已绑 sa_std
// ts 面 (@ts_str_trim in sa_std/ts_string.sa; {ptr,len}
// handle model — the repair phase aligns the exact macro
// signature).
fn ts_trim_span(p: ptr, n: u64, out_ptr: &ptr, out_len: &u64) -> void {
    @ts_str_trim(out_ptr, out_len, p, n);
}

fn sa_env_get(key_ptr: ptr, key_len: u64, out_ptr: &ptr, out_len: &u64) -> i32;
fn sa_json_parse(text_ptr: ptr, text_len: u64) -> u64;
fn sa_json_object_get(doc: u64, key_ptr: ptr, key_len: u64, out: &u64) -> i32;
fn sa_json_object_get_string(doc: u64, key_ptr: ptr, key_len: u64, out_ptr: &ptr, out_len: &u64) -> i32;
fn sa_json_object_get_i64(doc: u64, key_ptr: ptr, key_len: u64, out: &i64) -> i32;
fn sa_json_object_get_bool(doc: u64, key_ptr: ptr, key_len: u64, out: &bool) -> i32;
fn sa_json_array_len(doc: u64, out: &u64) -> i32;
fn sa_json_array_get(doc: u64, idx: u64, out: &u64) -> i32;
fn sa_json_stringify_pretty(node: u64, out: ptr, out_cap: u64, out_len: &u64) -> i32;

fn stringify_into(node: u64, out: ptr, out_cap: u64) -> u64 {
    if node == 0 { return append_bytes(out, out_cap, 0, STR_PTR("null"), 4); };
    let n: u64 = 0;
    if sa_json_stringify_pretty(node, out, out_cap, &n) != 0 { return 0; };
    return n;
}

fn slot(base: ptr, off: u64) -> ptr { return byte_off(base, off); }

fn byte_off(base: ptr, off: u64) -> ptr {
    let arr = base as [u8];
    return &arr[off];
}

fn byte_at(base: ptr, idx: u64) -> u8 {
    if base == PTR_NULL() { return 0; };
    let arr = base as [u8];
    return arr[idx];
}

fn bytes_eq(a: ptr, b: ptr, n: u64) -> bool {
    if n == 0 { return true; };
    if a == PTR_NULL() || b == PTR_NULL() { return false; };
    let i: u64 = 0;
    while i < n {
        if byte_at(a, i) != byte_at(b, i) { return false; };
        i = i + 1;
    }
    return true;
}

fn str_is(p: ptr, n: u64, lit_ptr: ptr, lit_len: u64) -> bool {
    return n == lit_len && bytes_eq(p, lit_ptr, lit_len);
}

fn append_bytes(dst: ptr, dst_cap: u64, used: u64, src: ptr, src_len: u64) -> u64 {
    let i: u64 = 0;
    while i < src_len {
        if used + i >= dst_cap { break; };
        let a = dst as [u8];
        a[used + i] = byte_at(src, i);
        i = i + 1;
    }
    return i;
}

fn buf_copy(dst: ptr, dst_cap: u64, src: ptr, src_len: u64) -> u64 {
    return append_bytes(dst, dst_cap, 0, src, src_len);
}

fn append_u64(dst: ptr, dst_cap: u64, used: u64, v: u64) -> u64 {
    let digits = [0u8; 24];
    let dn: u64 = 0;
    let x = v;
    if x == 0 { digits[0] = 48; dn = 1; } else {
        let tmp = [0u8; 24];
        let tn: u64 = 0;
        while x > 0 {
            tmp[tn] = (48 + (x % 10)) as u8;
            tn = tn + 1;
            x = x / 10;
        }
        while tn > 0 { tn = tn - 1; digits[dn] = tmp[tn]; dn = dn + 1; };
    };
    return used + append_bytes(dst, dst_cap, used, &digits, dn);
}

fn append_i64(dst: ptr, dst_cap: u64, used: u64, v: i64) -> u64 {
    if v < 0 {
        let n = used + append_bytes(dst, dst_cap, used, STR_PTR("-"), 1);
        return append_u64(dst, dst_cap, n, (0 - v) as u64);
    };
    return append_u64(dst, dst_cap, used, v as u64);
}

fn find_byte(buf: ptr, len: u64, from: u64, b: u8) -> u64 {
    let i: u64 = from;
    while i < len {
        if byte_at(buf, i) == b { return i; };
        i = i + 1;
    }
    return 4294967295;
}

fn to_lower(out: ptr, out_cap: u64, src: ptr, src_len: u64) -> u64 {
    let n = buf_copy(out, out_cap, src, src_len);
    let i: u64 = 0;
    while i < n {
        let b = byte_at(out, i);
        if b >= 65 && b <= 90 {
            let a = out as [u8];
            a[i] = b + 32;
        };
        i = i + 1;
    }
    return n;
}

fn date_parse_ms(out: &u64) -> bool { return false; }
