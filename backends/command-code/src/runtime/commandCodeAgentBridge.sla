fn fs_read_all(path_ptr: ptr, path_len: u64, out: ptr, out_cap: u64, out_len: &u64) -> i32;
fn fs_write_all(path_ptr: ptr, path_len: u64, data_ptr: ptr, data_len: u64) -> i32;
fn fs_mkdir_recursive(path_ptr: ptr, path_len: u64) -> i32;
fn fs_unlink(path_ptr: ptr, path_len: u64) -> i32;
