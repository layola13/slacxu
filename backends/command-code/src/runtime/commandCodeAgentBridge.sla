// host_event_log_init(errorsFile): createBridgeEventLogger
// (sdk-backend feature; declared by use in this pass).
// host_event_log_frame(kind, payloadLen): streamed-chunk log
// without payload. host_event_log_event(kind, line): full
// line log. All no-ops when no logger is wired.
fn host_event_log_init(errors_ptr: ptr, errors_len: u64) -> void {}
fn host_event_log_frame(kind_ptr: ptr, kind_len: u64, payload_len: u64) -> void {}
fn host_event_log_event(kind_ptr: ptr, kind_len: u64, line_ptr: ptr, line_len: u64) -> void {}

// json helpers over doc handles used throughout the bridges
// (sdk-backend json.sla family; declared by use here).
// FIX(be2): real keys implementation (was a 0-stub with the
// wrong arity): keys appended to the arena, offs/lens tables
// filled, count out.
fn json_object_keys(doc: u64, arena: ptr, arena_cap: u64, offs: ptr, lens: ptr, out_count: &u64) -> void {
    *out_count = 0;
    if doc == 0 { return; };
    let total: u64 = 0;
    if sa_json_value_count(doc, &total) != 0 { return; };
    let used: u64 = 0;
    let i: u64 = 0;
    while i < total {
        let kp: ptr = PTR_NULL();
        let kl: u64 = 0;
        if sa_json_object_key_at(doc, i, &kp, &kl) == 0 {
            let op: ptr = PTR_NULL(); PTR_BYTE_ADD(op, offs, i * 8);
            PTR_WRITE_U64(op, used);
            let lp: ptr = PTR_NULL(); PTR_BYTE_ADD(lp, lens, i * 8);
            PTR_WRITE_U64(lp, kl);
            used = used + append_bytes(arena, arena_cap, used, kp, kl);
            *out_count = (*out_count) + 1;
        };
        i = i + 1;
    }
}
fn json_node_string(node: u64, out_ptr: &ptr, out_len: &u64) -> void { *out_ptr = PTR_NULL(); *out_len = 0; }
fn json_node_is_string(node: u64, out: &bool) -> void { *out = false; }
fn process_poll_exit(proc: u64, out_code: &i32, out_exited: &bool) -> void { *out_code = 0; *out_exited = false; }
fn process_kill(proc: u64, signame_ptr: ptr, signame_len: u64) -> void {}
fn uuid_new(out: ptr, out_cap: u64) -> u64 {
    // FIX(be2): bound to sa_deno_random_uuid (crypto.sai).
    let h = sa_deno_random_uuid();
    if h == 0 { return 0; };
    let dp: ptr = PTR_NULL();
    dp = sa_fmt_buffer_data(h);
    let dl = sa_fmt_buffer_len(h);
    let n = append_bytes(out, out_cap, 0, dp, dl);
    sa_fmt_buffer_free(h);
    return n;
}
fn now_ms() -> u64 { return (sa_time_unix_ms() as u64); }
fn process_cwd(out: ptr, out_cap: u64) -> u64 {
    let n: u64 = 0;
    env_get(STR_PTR("PWD"), STR_LEN("PWD"), out, out_cap, &n);
    return n;
}
fn env_get(key_ptr: ptr, key_len: u64, out: ptr, out_cap: u64, out_len: &u64) -> bool {
    let v_ptr: ptr = PTR_NULL();
    let v_len: u64 = 0;
    if sa_env_get4(key_ptr, key_len, &v_ptr, &v_len) != 0 { *out_len = 0; return false; };
    *out_len = ccab_buf_copy(out, out_cap, v_ptr, v_len);
    return true;
}

// ts_trim_span: String.prototype.trim span — 已绑 sa_std
// ts 面 (@ts_str_trim in sa_std/ts_string.sa; {ptr,len}
// handle model — the repair phase aligns the exact macro
// signature).
fn ts_trim_span(p: ptr, n: u64, out_ptr: &ptr, out_len: &u64) -> void {
    ts_str_trim(out_ptr, out_len, p, n);
}

// FIX(be2): decl block bound. The sa_json_* decls duplicated
// sa_std/encoding/json.sai externs (deleted). Local shims:
fn sa_env_get4(key_ptr: ptr, key_len: u64, out_ptr: &ptr, out_len: &u64) -> i32 {
    *out_ptr = PTR_NULL();
    *out_len = 0;
    let h = sa_env_get(key_ptr, key_len);
    if h == 0 { return 1; };
    *out_ptr = sa_env_buffer_data(h);
    *out_len = sa_env_buffer_len(h);
    return 0;
}

fn sa_json_array_len(doc: u64, out: &u64) -> i32 {
    if doc == 0 { *out = 0; return 1; };
    let n: u64 = 0;
    let rc = sa_json_value_count(doc, &n);
    *out = n;
    return rc;
}

// Compact stringify (no pretty face in json.sai; deviation
// noted — callers re-parse or embed the text).
fn sa_json_stringify_pretty(node: u64, out: ptr, out_cap: u64, out_len: &u64) -> i32 {
    *out_len = 0;
    if node == 0 { return 1; };
    let h: u64 = 0;
    if sa_json_stringify(node, &h) != 0 { return 1; };
    if h == 0 { return 1; };
    let dp: ptr = PTR_NULL();
    dp = sa_json_buffer_data(h);
    let dl = sa_json_buffer_len(h);
    let n = append_bytes(out, out_cap, 0, dp, dl);
    sa_json_buffer_free(h);
    *out_len = n;
    return 0;
}

fn stringify_into(node: u64, out: ptr, out_cap: u64) -> u64 {
    if node == 0 { return append_bytes(out, out_cap, 0, STR_PTR("null"), 4); };
    let n: u64 = 0;
    if sa_json_stringify_pretty(node, out, out_cap, &n) != 0 { return 0; };
    return n;
}


// FIX(be2): join2 was called but never defined (Providers
// has join3). Path join with '/' separator, Providers model.
fn join2(out: ptr, cap: u64, a: ptr, a_len: u64, b: ptr, b_len: u64) -> u64 {
    let n: u64 = 0;
    n = n + append_bytes(out, cap, n, a, a_len);
    if n > 0 && n < cap {
        let last: u8 = 0;
        PTR_BYTE_AT(last, out, n - 1);
        if last != 47 {
            let wp: ptr = PTR_NULL(); PTR_BYTE_ADD(wp, out, n);
            PTR_WRITE_U8(wp, 47);
            n = n + 1;
        };
    };
    n = n + append_bytes(out, cap, n, b, b_len);
    return n;
}

fn slot(base: ptr, off: u64) -> ptr { return byte_off(base, off); }

fn byte_off(base: ptr, off: u64) -> ptr {
    let p: ptr = PTR_NULL(); PTR_BYTE_ADD(p, base, off);
    return p;
}

fn byte_at(base: ptr, idx: u64) -> u8 {
    if base == PTR_NULL() { return 0; };
    let v: u8 = 0;
    PTR_BYTE_AT(v, base, idx);
    return v;
}

fn ccab_bytes_eq(a: ptr, b: ptr, n: u64) -> bool {
    if n == 0 { return true; };
    if a == PTR_NULL() || b == PTR_NULL() { return false; };
    let i: u64 = 0;
    while i < n {
        if byte_at(a, i) != byte_at(b, i) { return false; };
        i = i + 1;
    }
    return true;
}

fn str_is(p: ptr, n: u64, lit_ptr: ptr, lit_len: u64) -> bool {
    return n == lit_len && ccab_bytes_eq(p, lit_ptr, lit_len);
}

fn append_bytes(dst: ptr, dst_cap: u64, used: u64, src: ptr, src_len: u64) -> u64 {
    let i: u64 = 0;
    while i < src_len {
        if used + i >= dst_cap { break; };
        let wp: ptr = PTR_NULL(); PTR_BYTE_ADD(wp, dst, used + i);
        PTR_WRITE_U8(wp, byte_at(src, i));
        i = i + 1;
    }
    return i;
}

fn ccab_buf_copy(dst: ptr, dst_cap: u64, src: ptr, src_len: u64) -> u64 {
    return append_bytes(dst, dst_cap, 0, src, src_len);
}

fn append_u64(dst: ptr, dst_cap: u64, used: u64, v: u64) -> u64 {
    let digits = [0u8; 24];
    let digits_p: ptr = PTR_NULL(); PTR_BYTE_ADD(digits_p, &digits, 0);
    let dn: u64 = 0;
    let x = v;
    if x == 0 { digits[0] = 48; dn = 1; } else {
        let tmp = [0u8; 24];
        let tmp_p: ptr = PTR_NULL(); PTR_BYTE_ADD(tmp_p, &tmp, 0);
        let tn: u64 = 0;
        while x > 0 {
            tmp[tn] = (48 + (x % 10)) as u8;
            tn = tn + 1;
            x = x / 10;
        }
        while tn > 0 { tn = tn - 1; digits[dn] = tmp[tn]; dn = dn + 1; }
    };
    return used + append_bytes(dst, dst_cap, used, digits_p, dn);
}

fn append_i64(dst: ptr, dst_cap: u64, used: u64, v: i64) -> u64 {
    if v < 0 {
        let n = used + append_bytes(dst, dst_cap, used, STR_PTR("-"), 1);
        return append_u64(dst, dst_cap, n, (0 - v) as u64);
    };
    return append_u64(dst, dst_cap, used, v as u64);
}

fn find_byte(buf: ptr, len: u64, from: u64, b: u8) -> u64 {
    let i: u64 = from;
    while i < len {
        if byte_at(buf, i) == b { return i; };
        i = i + 1;
    }
    return 4294967295;
}

fn to_lower(out: ptr, out_cap: u64, src: ptr, src_len: u64) -> u64 {
    let n = ccab_buf_copy(out, out_cap, src, src_len);
    let i: u64 = 0;
    while i < n {
        let b = byte_at(out, i);
        if b >= 65 && b <= 90 {
            let wp: ptr = PTR_NULL(); PTR_BYTE_ADD(wp, out, i);
            PTR_WRITE_U8(wp, b + 32);
        };
        i = i + 1;
    }
    return n;
}

fn date_parse_ms(out: &u64) -> bool { return false; }
// FIX(be2): sa_io_read decl duplicated io.sai (deleted);
// fs_* helpers bound to fs.sai faces.

// FIX(be2): read_file_into was called but never defined.
fn read_file_into(path_ptr: ptr, path_len: u64, out: ptr, out_cap: u64, out_len: &u64) -> bool {
    return fs_read_all(path_ptr, path_len, out, out_cap, out_len) == 0;
}

fn fs_read_all(path_ptr: ptr, path_len: u64, out: ptr, out_cap: u64, out_len: &u64) -> i32 {
    *out_len = 0;
    let h = sa_fs_read_file(path_ptr, path_len, out_cap);
    if h == 0 { return 1; };
    let dp: ptr = PTR_NULL();
    dp = sa_fs_read_buffer_data(h);
    let dl = sa_fs_read_buffer_len(h);
    let n = append_bytes(out, out_cap, 0, dp, dl);
    sa_fs_read_buffer_free(h);
    *out_len = n;
    return 0;
}

fn fs_write_all(path_ptr: ptr, path_len: u64, data_ptr: ptr, data_len: u64) -> i32 {
    return sa_fs_write_file(path_ptr, path_len, data_ptr, data_len);
}

fn fs_mkdir_recursive(path_ptr: ptr, path_len: u64) -> i32 {
    return sa_fs_mkdir_p(path_ptr, path_len);
}

fn fs_unlink(path_ptr: ptr, path_len: u64) -> i32 {
    return sa_fs_remove_file(path_ptr, path_len);
}
