// Converted 1:1 from backends/muse/src/server.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
//
// Muse — server side (kind "backend"). Independent plugin.
// Phase 1: declaration level — the runtime/bridge and installation
// discovery move here from the host in Phase 2.
//
// SDK types (EngineHandle, EngineStatus, PluginInstallation,
// ServerHost, ServerPlugin) come from @cxu/sdk-backend/server —
// see the sdk-backend unit. Re-export of MUSE_MANIFEST mirrors
// `export { MUSE_MANIFEST }` from ./manifest.sla;
// MUSE_OFFICIAL_PROVIDER_ID is imported from ./runtime/museBridge.sla.
@import "./manifest.sla"
@import "./runtime/museBridge.sla"

// class MuseEngine implements EngineHandle.
// #status: EngineStatus = { phase: "stopped", transport: "stdio" } —
// string fields kept as (ptr, len) into string literals.
// DEFECT: class + interface implements + #private field — SLA has no
// classes/interfaces/private fields; struct + fn family with the
// engine struct as first parameter, fields are plain fields.
struct MuseEngine {
    pluginId_ptr: ptr,
    pluginId_len: u64,
    status_phase_ptr: ptr,
    status_phase_len: u64,
    status_transport_ptr: ptr,
    status_transport_len: u64,
}

fn MuseEngine_new(self: &MuseEngine) -> void {
    self.pluginId_ptr = STR_PTR("muse");
    self.pluginId_len = STR_LEN("muse");
    self.status_phase_ptr = STR_PTR("stopped");
    self.status_phase_len = STR_LEN("stopped");
    self.status_transport_ptr = STR_PTR("stdio");
    self.status_transport_len = STR_LEN("stdio");
}

// DEFECT: async — TS `async start(): Promise<EngineStatus>`;
// converted to a synchronous fn returning a status code; the
// resulting EngineStatus is self.status_*.
fn MuseEngine_start(self: &MuseEngine) -> i32 {
    self.status_phase_ptr = STR_PTR("ready");
    self.status_phase_len = STR_LEN("ready");
    self.status_transport_ptr = STR_PTR("stdio");
    self.status_transport_len = STR_LEN("stdio");
    return 0;
}

// DEFECT: async — TS `async stop(): Promise<void>`.
fn MuseEngine_stop(self: &MuseEngine) -> i32 {
    self.status_phase_ptr = STR_PTR("stopped");
    self.status_phase_len = STR_LEN("stopped");
    self.status_transport_ptr = STR_PTR("stdio");
    self.status_transport_len = STR_LEN("stdio");
    return 0;
}

// status(): EngineStatus — TS returns this.#status; here the
// caller reads self.status_phase_* / self.status_transport_*.
fn MuseEngine_status(self: &MuseEngine) -> void {
}

// DEFECT: async + throw + unknown return — TS
// `async handleRpc(): Promise<unknown>` throws
// Error("muse plugin engine is not wired to the host yet (phase 1 declaration)").
// SLA has no exceptions; returns error code 1.
fn MuseEngine_handleRpc(self: &MuseEngine, out_ptr: ptr, out_len: &u64) -> i32 {
    return 1;
}

// export const museServerPlugin: ServerPlugin — an object literal
// with function properties.
// DEFECT: dynamic object / closures in ServerPlugin literal — SLA
// struct literals cannot hold closures; descriptor data is kept as
// fields and each function property becomes a free fn below.
struct MuseServerPlugin {
    manifest_doc: u64,
    officialProviderId_ptr: ptr,
    officialProviderId_len: u64,
    cliSettings_slug_ptr: ptr,
    cliSettings_slug_len: u64,
    cliSettings_enabledEnvVar_ptr: ptr,
    cliSettings_enabledEnvVar_len: u64,
    discovery_preferredPathPrefKey_ptr: ptr,
    discovery_preferredPathPrefKey_len: u64,
}

fn museServerPlugin_new(self: &MuseServerPlugin, manifest_doc: u64) -> void {
    self.manifest_doc = manifest_doc;
    // officialProviderId = MUSE_OFFICIAL_PROVIDER_ID (museBridge.sla).
    self.officialProviderId_ptr = MUSE_OFFICIAL_PROVIDER_ID_ptr();
    self.officialProviderId_len = MUSE_OFFICIAL_PROVIDER_ID_len();
    self.cliSettings_slug_ptr = STR_PTR("muse-cli");
    self.cliSettings_slug_len = STR_LEN("muse-cli");
    self.cliSettings_enabledEnvVar_ptr = STR_PTR("CODEX_UI_MUSE_COMPATIBLE_CLI_ENABLED");
    self.cliSettings_enabledEnvVar_len = STR_LEN("CODEX_UI_MUSE_COMPATIBLE_CLI_ENABLED");
    self.discovery_preferredPathPrefKey_ptr = STR_PTR("cliPreferredMusePath");
    self.discovery_preferredPathPrefKey_len = STR_LEN("cliPreferredMusePath");
}

// discovery.binaryNames: ["muse"]
fn museServerPlugin_discovery_binaryNames(idx: u64, out: &ptr, out_len: &u64) -> bool {
    if idx != 0 { return false; };
    out = STR_PTR("muse");
    out_len = STR_LEN("muse");
    return true;
}

// discovery.envBinVars: ["MUSE_BIN", "CODEX_UI_MUSE_BIN"]
fn museServerPlugin_discovery_envBinVars(idx: u64, out: &ptr, out_len: &u64) -> bool {
    if idx == 0 {
        out = STR_PTR("MUSE_BIN");
        out_len = STR_LEN("MUSE_BIN");
        return true;
    };
    if idx == 1 {
        out = STR_PTR("CODEX_UI_MUSE_BIN");
        out_len = STR_LEN("CODEX_UI_MUSE_BIN");
        return true;
    };
    return false;
}

// discovery.matchesKind: () => true
fn museServerPlugin_discovery_matchesKind() -> bool {
    return true;
}

// createEngine(_host: ServerHost): EngineHandle — returns a new engine.
fn museServerPlugin_createEngine(host: u64, out: &MuseEngine) -> void {
    MuseEngine_new(out);
}

// DEFECT: async — TS `async findInstallations(): Promise<PluginInstallation[]>` returns [].
fn museServerPlugin_findInstallations(out_count: &u64) -> i32 {
    out_count = 0;
    return 0;
}

// skillRoots(): string[] — returns [".codex/skills"].
fn museServerPlugin_skillRoots(idx: u64, out: &ptr, out_len: &u64) -> bool {
    if idx != 0 { return false; };
    out = STR_PTR(".codex/skills");
    out_len = STR_LEN(".codex/skills");
    return true;
}

// export default museServerPlugin — SLA has no default export;
// consumers reference museServerPlugin_* directly.
