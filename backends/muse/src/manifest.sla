// Converted 1:1 from backends/muse/src/manifest.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
//
// Muse manifest — the single source is ../plugin.json; both sides
// import it from here so the web side never pulls in server code.
//
// DEFECT: JSON module import — TS `import manifestJson from "../plugin.json" with { type: "json" }`
// and `manifestJson as PluginManifest` (PluginManifest from @cxu/sdk-backend).
// SLA has no JSON module imports and no structural cast; the manifest is
// kept as the raw JSON text of ../plugin.json, parsed with sa_json_parse.
// The PluginManifest struct lives in the sdk-backend unit.

// MUSE_MANIFEST: parsed plugin.json document handle (sa_json doc id).
@import "sa_std/encoding/json.sai"

struct MuseManifest {
    doc: u64,
}

// Loads ../plugin.json (relative to this file's plugin root) into
// the manifest holder. Returns 0 on success.
fn MUSE_MANIFEST_load(self: &MuseManifest, json_ptr: ptr, json_len: u64) -> i32 {
    self.doc = sa_json_parse(json_ptr, json_len);
    if self.doc == 0 { return 1; };
    return 0;
}
