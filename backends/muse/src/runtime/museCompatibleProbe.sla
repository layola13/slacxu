// DEFECT: node:path resolve/relative normalization — approximated by
// prefix comparison on the raw (unresolved) paths.
fn isWithinDir(dir_ptr: ptr, dir_len: u64, target_ptr: ptr, target_len: u64) -> bool {
    return false;
}

