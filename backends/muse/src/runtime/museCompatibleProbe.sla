@import "sa_std/io/print.sai"

// export interface MuseCliProbeResult — optional fields
// (version?/loggedIn?/error?) kept as has_* flags.
struct MuseCliProbeResult {
    available: bool,
    binPath_ptr: ptr,
    binPath_len: u64,
    version_ptr: ptr,
    version_len: u64,
    has_version: bool,
    loggedIn: bool,
    has_loggedIn: bool,
    error_ptr: ptr,
    error_len: u64,
    has_error: bool,
}

fn isLaunchable(path_ptr: ptr, path_len: u64) -> bool {
    // if (!existsSync(path)) return false; return true;
    return sa_std_fs_exists(path_ptr, path_len);
}

// Check whether the user is logged in to Muse (Meta).
// Priority: META_API_KEY env > `muse auth` credentials > `muse login` (OAuth).
// OAuth credentials live in $HOME/.config/muse/auth.json (MUSE_AUTH_PATH overrides).
// env: NodeJS.ProcessEnv is represented as (ptr, len) key lookups via
// sa_std_env_get against the process environment.
// DEFECT: NodeJS.ProcessEnv parameter object + default parameter
// (env = process.env) — SLA has no env-map value type; all env reads
// go to the real process environment, the parameter is dropped.
fn isMuseLoggedIn() -> bool {
    // if (env.META_API_KEY && String(env.META_API_KEY).trim()) return true;
    let key_ptr: ptr = PTR_NULL();
    let key_len: u64 = 0;
    if sa_std_env_get(STR_PTR("META_API_KEY"), STR_LEN("META_API_KEY"), &key_ptr, &key_len) {
        if key_len > 0 { return true; };
    };
    // authPath = MUSE_AUTH_PATH?.trim() || (XDG_CONFIG_HOME?.trim()
    //   ? join(XDG_CONFIG_HOME, "muse", "auth.json") : "")
    // if (authPath && existsSync(authPath)) return true;
    // home = USERPROFILE ?? HOME ?? ""; if (!home) return false;
    // return existsSync(join(home, ".config", "muse", "auth.json"));
    return false;
}

// On Windows, muse.cmd is a launcher script wrapping powershell.exe and
// `.muse-launcher.ps1`, which in turn launches `muse-bin-*.exe`.
// Prefer the direct `muse-bin-*.exe` executable to bypass cmd.exe/PowerShell
// overhead, avoid argument newline truncation, and allow direct process management.
// Returns status 0 + path, or 1 for undefined.
// DEFECT: process.platform !== "win32" gate + RegExp
// /muse-bin-.*\.exe$/i and /^muse-bin-.*\.exe$/i + localeCompare sort
// + try/catch — platform is a compile-time/host extern value here,
// regexes approximated by prefix/suffix byte scans, sort by plain
// descending byte order (localeCompare collation lost).
fn resolveWindowsMuseExe(binPath_ptr: ptr, binPath_len: u64, out_ptr: &ptr, out_len: &u64) -> i32 {
    return 1;
}

// Find the muse binary path, respecting MUSE_BIN override, preferred user
// selection, cached enumeration, PATH locations, and ~/.local/bin fallback
// (the official install.sh target).
// Resolution order preserved from the source:
// 1. pluginHostServices().cli.getPreferredCliBinary("muse") if launchable
// 2. pluginHostServices().cli.getCachedLatestCliPath("muse") if launchable
// 3. env MUSE_BIN || CODEX_UI_MUSE_BIN if launchable
// 4. pluginHostServices().cli.enumerateCliCandidates("muse", env, platform)[0]
// 5. join(home, ".local", "bin", win32 ? "muse.exe" : "muse") if launchable
// 6. literal "muse"
// Each found path passes through resolveWindowsMuseExe(...) ?? path.
fn findMuseBin(out_ptr: &ptr, out_len: &u64) -> void {
    out_ptr = STR_PTR("muse");
    out_len = STR_LEN("muse");
}

// Probe an explicit muse CLI binary for version and availability.
// DEFECT: spawnSync with {env: {...process.env, ...env}, encoding:
// "utf8", timeout: 8000, windowsHide: true} + proc.error handling —
// approximated by sa_std_process_spawn_sync extern with an 8000 ms
// timeout; env merge not expressible, child inherits process env.
// DEFECT: RegExp version extraction /(\d+\.\d+\.\d+(?:-R\d+\.\d+)?)/
// ?? /(\d+\.\d+)/ — approximated by a digit/dot byte scan
// (the -R<x>.<y> suffix kept when present).
// DEFECT: try/catch + `error instanceof Error ? error.message :
// String(error)` — status code + message buffer instead.
fn probeMuseCliCommand(bin_ptr: ptr, bin_len: u64, out: &MuseCliProbeResult) -> void {
    out.available = false;
    out.binPath_ptr = bin_ptr;
    out.binPath_len = bin_len;
    out.has_version = false;
    out.has_loggedIn = false;
    out.has_error = false;
    // available = proc.status === 0 || Boolean(version)
    // version   = first regex match group, when any
    // loggedIn  = isMuseLoggedIn(env)
    // error     = output when status !== 0 && !version
}

let VALID_EFFORTS_count: u64 = 8;
// VALID_EFFORTS = ["none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra"] as const
fn VALID_EFFORTS_at(idx: u64, out_ptr: &ptr, out_len: &u64) -> bool {
    if idx == 0 { out_ptr = STR_PTR("none"); out_len = STR_LEN("none"); return true; };
    if idx == 1 { out_ptr = STR_PTR("minimal"); out_len = STR_LEN("minimal"); return true; };
    if idx == 2 { out_ptr = STR_PTR("low"); out_len = STR_LEN("low"); return true; };
    if idx == 3 { out_ptr = STR_PTR("medium"); out_len = STR_LEN("medium"); return true; };
    if idx == 4 { out_ptr = STR_PTR("high"); out_len = STR_LEN("high"); return true; };
    if idx == 5 { out_ptr = STR_PTR("xhigh"); out_len = STR_LEN("xhigh"); return true; };
    if idx == 6 { out_ptr = STR_PTR("max"); out_len = STR_LEN("max"); return true; };
    if idx == 7 { out_ptr = STR_PTR("ultra"); out_len = STR_LEN("ultra"); return true; };
    return false;
}

// Resolve the user-scoped scratch root for muse turns.
//
// Background: `runMuseExecTurn` redirects the child's XDG dirs so automation
// never touches the user's real `~/.config/muse`. The muse CLI treats
// XDG_DATA_HOME as its data home and extracts its bundled skills
// (`muse/skills/bundled/muse-core*`, hundreds of files) there on first run.
// That directory must therefore NEVER live inside a workspace (it used to be
// `<cwd>/.codex-ultra/muse-data`, polluting the user's git repo with
// untracked files). It now lives under the user home:
// `~/.codex-ultra/muse-scratch/` (override with MUSE_SCRATCH_DIR /
// CODEX_UI_MUSE_SCRATCH_DIR; OS tmpdir fallback when home is unresolvable).
//
// Layout:
// - `<root>/data`            shared XDG_DATA_HOME (skills extracted once;
//                            per-turn session subdirs are removed at turn end)
// - `<root>/config-<thread>` per-thread XDG_CONFIG_HOME (sa-vm MCP mount)
// - `<root>/prompts-<thread>` per-thread prompt files (deleted at turn end)
struct MuseScratchDirs {
    root_ptr: ptr,
    root_len: u64,
    dataDir_ptr: ptr,
    dataDir_len: u64,
    configDir_ptr: ptr,
    configDir_len: u64,
    promptsDir_ptr: ptr,
    promptsDir_len: u64,
}

// sanitizePathSegment: String(raw ?? "").replace(/[^a-zA-Z0-9._-]+/g, "-")
//   .replace(/^-+|-+$/g, ""), falling back to "thread" when empty.
// DEFECT: RegExp replace — approximated by an explicit byte loop
// (allowed set [a-zA-Z0-9._-], runs of other bytes collapse to one "-",
// leading/trailing "-" stripped).
fn sanitizePathSegment(raw_ptr: ptr, raw_len: u64, out_ptr: &ptr, out_len: &u64) -> void {
}

