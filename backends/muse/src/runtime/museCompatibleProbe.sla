// Build safe spawn arguments for a `muse exec --json` single-turn run.
// Dual-mode:
//  - official: no baseUrl, relies on `muse login` / META_API_KEY, default model muse-spark-1.3.
//  - relay (login-free): baseUrl + META_API_KEY injected via child env only.
// Options object fields (all optional strings unless noted):
// prompt, promptFilePath, model, effort, sessionId, workspace,
// baseUrl, dangerouslyBypassPermissions (bool).
// Arg order preserved from the source:
//   ["exec", "--json", "--provider", "meta", "--no-foreign-personal-context"]
//   + ["--model", model]? + ["--reasoning-effort", effort.toLowerCase()]?
//     (only when the lowercased effort is in VALID_EFFORTS)
//   + ["--base-url", baseUrl]? + ["--session-id", sessionId]?
//   + ["--workspace", workspace, "--trust-workspace"]?
//   + (dangerouslyBypassPermissions === true ? ["--yolo"]
//      : ["--approval-mode", "on-request"])
//   + ["--prompt-file", promptFilePath] or [prompt]
// (The Chinese comment in the source explains --no-foreign-personal-context:
// only the current project's skills/rules are loaded; foreign personal
// context is excluded, project skills come via --workspace/--trust-workspace.)
// DEFECT: options object + dynamic string[] push — caller provides a
// fixed-capacity argv array (cap 24 entries) + count out-param;
// `.trim()` checks approximated by len checks on pre-trimmed inputs.
fn buildMuseExecArgs(prompt_ptr: ptr, prompt_len: u64, has_prompt: bool, promptFilePath_ptr: ptr, promptFilePath_len: u64, model_ptr: ptr, model_len: u64, effort_ptr: ptr, effort_len: u64, sessionId_ptr: ptr, sessionId_len: u64, workspace_ptr: ptr, workspace_len: u64, baseUrl_ptr: ptr, baseUrl_len: u64, dangerouslyBypassPermissions: bool, out_argv: &ptr, out_lens: &u64, out_count: &u64) -> void {
    out_count = 0;
}

// Per-run muse config dir (mirrors opencode's `OPENCODE_CONFIG_CONTENT`
// inline injection): muse reads MCP servers from
// `$XDG_CONFIG_HOME/muse/settings.json` (`{schema_version:1,
// mcpServers:{...}}`, entry `{id?, command, args?, env?}` — verified
// against muse 1.4.7, stdio spawn + env passthrough both work).
//
// Why per-run XDG instead of writing home: the user's real
// `~/.config/muse/settings.json` must never be touched by automation;
// a generated dir keeps the sa-vm MCP attach scoped to this thread's turns.
// The dir used to live under `<cwd>/.codex-ultra/muse-config`; it now lives
// in the user-scoped scratch root (see resolveMuseScratchDirs) so workspaces
// stay clean. Pass `xdgRoot` to override; defaults to the legacy cwd layout
// for backward compatibility.
//
// Returns the XDG root to set as `XDG_CONFIG_HOME` for the child, or
// undefined (status 1) when no script path is available (caller then
// spawns without MCP, same as before).
// Settings written: JSON.stringify({...prev, schema_version:
// prev.schema_version (number) or 1, mcpServers: {...prevServers,
// "sa-vm": {id: "sa-vm", command: nodeCmd, args: [scriptPath], env}}}, null, 2)
// where nodeCmd = process.execPath when win32 and it matches
// /node(\.exe)?$/i, else "node"; env carries CODEX_UI_TOKEN (options.token
// ?? base.CODEX_UI_TOKEN ?? process.env.CODEX_UI_TOKEN) when non-empty,
// CODEX_UI_API_URL (options.apiUrl) when non-empty, and always
// MUSE_SA_VM_ENVELOPE = "1".
// Auth passthrough: when <museDir>/auth.json does not exist, the first
// existing candidate of [join(realXdg, "muse", "auth.json"),
// MUSE_AUTH_PATH, join(realHome, ".config", "muse", "auth.json")] is
// symlinkSync'd, falling back to copyFileSync on failure.
// DEFECT: dynamic JSON build/parse of settings.json (prev merge,
// mcpServers spread) — approximated by JSON text buffer assembly with
// sa_json_* lookups for prev.schema_version / prev.mcpServers.
// DEFECT: symlinkSync with copy fallback + nested try/catch — sa_std
// has no symlink extern; approximated by copy only.
fn buildMuseSaVmSettingsDir(cwd_ptr: ptr, cwd_len: u64, scriptPath_ptr: ptr, scriptPath_len: u64, token_ptr: ptr, token_len: u64, has_token: bool, apiUrl_ptr: ptr, apiUrl_len: u64, has_apiUrl: bool, xdgRoot_ptr: ptr, xdgRoot_len: u64, has_xdgRoot: bool, out_ptr: &ptr, out_len: &u64) -> i32 {
    return 1;
}

