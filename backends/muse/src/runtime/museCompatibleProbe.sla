// DEFECT: env object spread/merge — SLA has no env-map value; the
// child env is assembled as key/value buffers by the spawn extern,
// with CI=1 and FORCE_COLOR=0 appended last (overriding, as in source).
fn buildSafeMuseEnv(extra_count: u64) -> void {
}
