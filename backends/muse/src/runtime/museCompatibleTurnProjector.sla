// Converted 1:1 from backends/muse/src/runtime/museCompatibleTurnProjector.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
//
// Muse exec --json 瀑布流投影器。
//
// 背景：MuseBridge 原来只解析 `run.output.delta` 纯文本，
// thinking / todolist / subagent / mcp / skill 全部丢失。
// 本投影器参考 mini/opencode 的做法，把 muse exec --json stdout 的
// `tool.result`（`correlation_facts.tool_name` 带工具名，verified 2026-10-13：
// stdout 只有 result、没有 started）、`tool_batch.effect.*`（session log 形状，
// 保留兼容）、`write_todos` 输出、`subagent_*` / `read_skill` / `mcp__*` /
// reasoning 文本统一投影成 Codex Ultra 前端已能渲染的 item 类型：
// - reasoning -> type=reasoning + item/reasoning/textDelta
// - agent 文本 -> type=agentMessage + item/agentMessage/delta
// - write_todos/todowrite -> type=plan（turn/plan/updated 同形）
// - subagent_spawn/status -> type=collabAgentToolCall
// - mcp__/skill/read_skill -> type=toolCall（保留原名，瀑布流按 toolCall 渲染）
// - 普通工具 -> type=toolCall
//
// 防御性设计：muse 不同 provider/版本的 record 字段名可能漂移，
// 所有提取函数都做多键兼容，解析失败时回退为普通 toolCall 行，
// 绝不吞掉工具调用。
//
// Source import: types JsonRpcNotification, JsonValue from "@codex-ui/shared".
@import "sa_std/io/print.sai"

// export type MuseProjectedEvent — a discriminated union:
//   { kind: "turn/started", threadId, turnId }
//   { kind: "turn/completed", threadId, turnId }
//   { kind: "turn/failed", threadId, turnId, error? }
//   { kind: "item/agentMessage/delta", threadId, turnId, itemId, delta }
//   { kind: "item/reasoning/textDelta", threadId, turnId, itemId, delta }
//   { kind: "item/started", threadId, turnId, item: Record<string, JsonValue> }
//   { kind: "item/completed", threadId, turnId, item: Record<string, JsonValue> }
//   { kind: "turn/plan/updated", threadId, turnId,
//     plan: Array<{ step: string; status: string }>, planItem: Record<...> }
// DEFECT: discriminated union type — events are JSON text buffers
// with a "kind" string field; kind constants are compared by bytes.
struct MuseProjectedEvent {
    kind_ptr: ptr,
    kind_len: u64,
    json_ptr: ptr,
    json_len: u64,
}

// Event list accumulator: functions below append to a caller-owned
// JSON array buffer + count (the source's MuseProjectedEvent[]).
struct MuseProjectedEventList {
    json_ptr: ptr,
    json_len: u64,
    count: u64,
}

// export interface MuseProjectorContext — the mutable projector
// state. String accumulators are (ptr, len) into context-owned
// buffers; the six Map/Set collections are host-side maps keyed by
// string buffers, held as opaque u64 handles.
struct MuseProjectorContext {
    threadId_ptr: ptr,
    threadId_len: u64,
    turnId_ptr: ptr,
    turnId_len: u64,
    status: u64, // 0 = running, 1 = completed, 2 = failed
    hasStartedTurn: bool,
    assistantIndex: u64,
    assistantItemId_ptr: ptr,
    assistantItemId_len: u64,
    assistantStarted: bool,
    assistantDone: bool,
    assistantText_ptr: ptr,
    assistantText_len: u64,
    reasoningItemId_ptr: ptr,
    reasoningItemId_len: u64,
    reasoningStarted: bool,
    reasoningDone: bool,
    reasoningText_ptr: ptr,
    reasoningText_len: u64,
    // activeTools: Map<string, Record<string, JsonValue>>
    activeTools: u64,
    // pendingPlanCandidates: Set<string>
    pendingPlanCandidates: u64,
    // tool_output_ref → 工具名：部分 tool.result 缺 correlation_facts，
    // 靠输出引用文件名里的 `<tool>-stdout` 片段按 call_id 回填。
    toolNameByCallId: u64,
    // subagent.control 记录的 subagent_id → 模型侧 tool call_id。
    subagentCallBySubagentId: u64,
    // subagent_id → 子会话 id（subagent.control.child_session_bound/start_attested）。
    subagentChildBySubagentId: u64,
    // subagent_id → {objective, role, taskName}（resume_context_recorded）。
    subagentMetaBySubagentId: u64,
    // workflow_run_id → 模型侧 tool call_id（workflow_run_launched.call_id）。
    workflowCallByRunId: u64,
    planStarted: bool,
    lastPlanJson_ptr: ptr,
    lastPlanJson_len: u64,
    // True when replaying a subagent session log offline (no stdout stream).
    // Child logs carry committed reasoning/assistant text instead of deltas,
    // and the log's terminal record must close the turn.
    offline: bool,
    has_offline: bool,
}

// museAssistantItemId(turnId, index = 0): `muse-msg-${turnId}-${index}`
// DEFECT: template literal + default parameter — byte assembly;
// caller passes index explicitly (0 for the default).
fn museAssistantItemId(turnId_ptr: ptr, turnId_len: u64, index: u64, out_ptr: &ptr, out_len: &u64) -> void {
}

fn createMuseProjectorContext(threadId_ptr: ptr, threadId_len: u64, turnId_ptr: ptr, turnId_len: u64, out: &MuseProjectorContext) -> void {
    out.threadId_ptr = threadId_ptr;
    out.threadId_len = threadId_len;
    out.turnId_ptr = turnId_ptr;
    out.turnId_len = turnId_len;
    out.status = 0;
    out.hasStartedTurn = false;
    out.assistantIndex = 0;
    museAssistantItemId(turnId_ptr, turnId_len, 0, &out.assistantItemId_ptr, &out.assistantItemId_len);
    out.assistantStarted = false;
    out.assistantDone = false;
    out.assistantText_len = 0;
    // reasoningItemId = `muse-thought-${turnId}-0`
    out.reasoningStarted = false;
    out.reasoningDone = false;
    out.reasoningText_len = 0;
    out.planStarted = false;
    out.lastPlanJson_len = 0;
    out.offline = false;
    out.has_offline = false;
}

fn nowSec() -> u64 {
    // Math.floor(Date.now() / 1000)
    return sa_std_time_now_ms() / 1000;
}

// 输出截断与 mini 对齐（miniBridge toolItem output.slice(0, 2000)）：
// 事件/历史落盘只保留前 2000 字符，防止大工具输出撑爆内存与事件流。
// DEFECT: JS string slice counts UTF-16 code units — byte slice here
// (may split a multi-byte character at the boundary).
fn sliceOutputText(text_ptr: ptr, text_len: u64, out_len: &u64) -> void {
    out_len = text_len;
    if out_len > 2000 { out_len = 2000; };
}

fn ensureTurnStarted(ctx: &MuseProjectorContext, events: &MuseProjectedEventList) -> void {
    if ctx.hasStartedTurn { return; };
    ctx.hasStartedTurn = true;
    // push { kind: "turn/started", threadId, turnId }
    events.count = events.count + 1;
}

// asRecord(value): Record<string, unknown> — {} for non-objects.
// Represented as a sa_json doc id; 0 stands for the empty object.
// DEFECT: dynamic object — see museHistoryProjection.sla.
fn asRecord(doc: u64, key_ptr: ptr, key_len: u64) -> u64 {
    return sa_json_get_object(doc, key_ptr, key_len);
}

fn asText(doc: u64, key_ptr: ptr, key_len: u64, out_ptr: &ptr, out_len: &u64) -> bool {
    // typeof value === "string" && value.trim() ? value : undefined
    return sa_json_get_string_nonempty(doc, key_ptr, key_len, out_ptr, out_len);
}

// pushAssistantDelta: empty delta -> no-op; ensureTurnStarted; a
// done assistant segment is reset and advanced (assistantIndex += 1,
// new assistantItemId); completeActiveReasoning first; when not
// started, push item/started with item {type: "agentMessage",
// id: assistantItemId, threadId, turnId, role: "assistant",
// status: "inProgress", text: "", content: [], startedAt: nowSec()};
// append delta to assistantText; push item/agentMessage/delta.
fn pushAssistantDelta(ctx: &MuseProjectorContext, events: &MuseProjectedEventList, delta_ptr: ptr, delta_len: u64) -> void {
}

// pushReasoningDelta: mirror of pushAssistantDelta for the reasoning
// segment (item {type: "reasoning", id: reasoningItemId, title:
// "Thinking", text: "", status: "inProgress", startedAt: nowSec(),
// firstTokenAt: nowSec()}), then item/reasoning/textDelta.
fn pushReasoningDelta(ctx: &MuseProjectorContext, events: &MuseProjectedEventList, delta_ptr: ptr, delta_len: u64) -> void {
}

// completeActiveReasoning: when reasoningStarted && !reasoningDone,
// mark done and push item/completed with the full reasoning item
// (status "completed", text = reasoningText).
fn completeActiveReasoning(ctx: &MuseProjectorContext, events: &MuseProjectedEventList) -> void {
}

// completeActiveAssistant: when assistantStarted && !assistantDone,
// mark done and push item/completed with {type: "agentMessage",
// id, threadId, turnId, role: "assistant", status: "completed",
// text: assistantText, content: [{type: "text", text: assistantText}]}.
fn completeActiveAssistant(ctx: &MuseProjectorContext, events: &MuseProjectedEventList) -> void {
}

