fn isMuseAgentCardToolName(toolName_ptr: ptr, toolName_len: u64) -> bool {
    // normalized in {subagentspawn, task, subagent, workflow}
    return false;
}

fn isMuseSubagentControlToolName(toolName_ptr: ptr, toolName_len: u64) -> bool {
    // normalized in {subagentwait, subagentreadresult, subagentstatus,
    // subagentcancel, subagentsendmessage}
    return false;
}

fn isMuseSkillToolName(toolName_ptr: ptr, toolName_len: u64) -> bool {
    // normalized === readskill || === skill || startsWith("skill")
    return false;
}

fn isMuseMcpToolName(toolName_ptr: ptr, toolName_len: u64) -> bool {
    // lower starts with "mcp__" | "mcp-" | "mcp:" or includes "__"
    return false;
