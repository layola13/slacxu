fn isMusePlanToolName(toolName_ptr: ptr, toolName_len: u64) -> bool {
    // normalized in {writetodos, todowrite, settodo, sessiontodo, todos}
    return false;
}

fn isMuseSubagentToolName(toolName_ptr: ptr, toolName_len: u64) -> bool {
    // normalized in {subagentspawn, subagentstatus, subagentsendmessage,
    // subagentwait, subagentreadresult, subagentcancel, task, subagent, workflow}
    return false;
