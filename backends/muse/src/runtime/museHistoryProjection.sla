// Converted 1:1 from backends/muse/src/runtime/museHistoryProjection.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
//
// Read-only projection over native Muse CLI session logs
// (`<xdg-data>/muse/sessions/<date>/<sid>/session.jsonl`,
// e.g. `~/.local/share/muse/sessions/2026-10-19/<sid>/session.jsonl`).
//
// Mirrors the opencode native projection semantics:
// - list: bounded, sorted by recency, no subscription, no runtime creation.
// - the native log is NEVER written here; files are only read (with byte/line
//   caps) so a running `muse` CLI keeps its locks.
//
// Why this exists: `museThreadListResult` only reads the internal
// `muse_sessions` table, so a fresh machine (or sessions created by a bare
// `muse` CLI outside Ultra) renders an empty Muse tab. Listing native
// `session.jsonl` files alongside internal threads fixes the empty tab
// without implicit watch/resume of full histories.
//
// Source imports: existsSync, readdirSync, readFileSync, statSync from
// "node:fs"; homedir from "node:os"; join from "node:path".
@import "sa_std/io/print.sai"
@import "sa_std/string.sa"
@import "sa_std/encoding/json.sai"

// FIX: sa_json_get_object does not exist in sa_std; it is
// sa_json_object_get with a zero-on-miss convention.
fn json_get_object(doc: u64, key_ptr: ptr, key_len: u64) -> u64 {
    let node: u64 = 0;
    if sa_json_object_get(doc, key_ptr, key_len, &node) != 0 { return 0; };
    return node;
}


// FIX: sa_json_get_string does not exist in sa_std. The real face
// is sa_json_object_get_string (encoding/json.sai), which yields
// the string node's (ptr, len); this helper copies it into the
// caller's fixed buffer and returns the byte count (0 if absent
// or not a string), matching the converted call sites.
fn json_get_string_copy(doc: u64, key_ptr: ptr, key_len: u64, dst: ptr, cap: u64) -> u64 {
    let sp: ptr = PTR_NULL();
    let sl: u64 = 0;
    if sa_json_object_get_string(doc, key_ptr, key_len, &sp, &sl) != 0 { return 0; };
    let n = sl;
    if n > cap { n = cap; };
    let i: u64 = 0;
    while i < n {
        let v: u8 = 0;
        PTR_BYTE_AT(v, sp, i);
        let wp: ptr = PTR_NULL();
        PTR_BYTE_ADD(wp, dst, i);
        PTR_WRITE_U8(wp, v);
        i = i + 1;
    }
    return n;
}


const NATIVE_MUSE_LIST_LIMIT: u64 = 200;
const NATIVE_MUSE_PREVIEW_LINES: u64 = 60;
const NATIVE_MUSE_PREVIEW_MAX_BYTES: u64 = 65536;
const NATIVE_MUSE_MAX_DEPTH: u64 = 5;
const NATIVE_MUSE_MAX_VISITED_DIRS: u64 = 3000;

// type JsonRecord = Record<string, unknown>
// DEFECT: dynamic object — Record<string, unknown> has no SLA
// counterpart; parsed JSON is kept as JSON text buffers and accessed
// through sa_json_* externs by key path.

// export interface NativeMuseThreadEntry extends JsonRecord { id: string }
// DEFECT: interface extends dynamic Record — the entry is a JSON text
// buffer built by listNativeMuseThreads; only `id` is also kept as a
// typed (ptr, len) pair.
struct NativeMuseThreadEntry {
    id_ptr: ptr,
    id_len: u64,
    json_ptr: ptr,
    json_len: u64,
}

// DEFECT: process.env access (MUSE_TEST_HOME / MUSE_DATA_HOME /
// XDG_DATA_HOME / LOCALAPPDATA / APPDATA / MUSE_SESSIONS_DIR) +
// homedir() + [...new Set(dirs)] dedupe — approximated by
// sa_std_env_get externs and a linear dedupe pass; path join by byte
// concatenation (no normalization).
fn candidateMuseDataDirs(out_dirs: &ptr, out_lens: &u64, out_count: &u64) -> void {
    // Order preserved from the source:
    // 1. MUSE_TEST_HOME set -> join(testHome, "muse")
    // 2. MUSE_DATA_HOME set -> the value itself
    // 3. home = testHome || homedir(); xdg = XDG_DATA_HOME -> join(xdg, "muse")
    // 4. home -> join(home, ".local", "share", "muse")
    // 5. LOCALAPPDATA -> join(localAppData, "muse")
    // 6. APPDATA -> join(appData, "muse")
    // 7. home -> join(home, "AppData", "Local", "muse")
    // then dedupe preserving first occurrence.
    *out_count = 0;
}

// All native Muse `sessions/` roots currently present (empty when never ran here).
// Per candidate dir: sessionsRoot = MUSE_SESSIONS_DIR (trimmed) when set,
// else join(dir, "sessions"); pushed when existsSync(sessionsRoot);
// the loop breaks after the first dir when MUSE_SESSIONS_DIR is set.
// DEFECT: try/catch around existsSync — status-code branch instead.
fn resolveNativeMuseSessionsRoots(out_roots: &ptr, out_lens: &u64, out_count: &u64) -> void {
    *out_count = 0;
}

fn mhp_asText(value_ptr: ptr, value_len: u64, value_kind: u64, out_ptr: &ptr, out_len: &u64) -> bool {
    // typeof value === "string" && value.trim() ? value : undefined
    if value_kind != 1 { return false; };
    if value_len == 0 { return false; };
    *out_ptr = value_ptr;
    *out_len = value_len;
    return true;
}

// asRecord(value): Record<string, unknown> — {} for non-objects.
// Represented as a sa_json doc id; 0 stands for the empty object.
fn mhp_asRecord(doc: u64, key_ptr: ptr, key_len: u64) -> u64 {
    return json_get_object(doc, key_ptr, key_len);
}

// Dig one level for a human text field inside a parsed JSONL record.
// Checks, in order: record.prompt, payload.prompt, rec.prompt,
// input.prompt, record.text, payload.text, record.content,
// payload.content, record.message, payload.message; then loops
// containers [input, rec, payload, record] x keys
// ["prompt", "text", "content", "message"].
// DEFECT: dynamic JSON traversal (payload.record ?? record.record,
// payload.input ?? rec.input ?? record.input) — approximated by
// sa_json key-path lookups in the same order.
fn extractRecordText(record_doc: u64, out_ptr: &ptr, out_len: &u64) -> bool {
    return false;
}

fn payloadTypeOf(record_doc: u64, out_ptr: &ptr, out_len: &u64) -> bool {
    // const t = record.payload_type; typeof t === "string" ? t : ""
    return json_get_string_copy(record_doc, STR_PTR("payload_type"), STR_LEN("payload_type"), out_ptr, out_len);
}

// First user-ish text inside a native `session.jsonl`: prefer start/prompt
// lines, fall back to the first text seen. Bounded read (64KiB + 60 lines).
// Returns status 0 + text, or 1 for null.
// DEFECT: readFileSync + string slice/split + JSON.parse per line in
// try/catch — approximated by a bounded byte read and per-line
// sa_json_parse attempts skipping failures. Note the source caps by
// JS string length (UTF-16 code units), not bytes.
// DEFECT: RegExp /start|prompt|user|session|init/ on the lowercased
// payload type — no regex engine; approximated by substring scans
// for the five alternatives.
fn readNativeMusePreview(logPath_ptr: ptr, logPath_len: u64, out_ptr: &ptr, out_len: &u64) -> i32 {
    return 1;
}

// Locate a native session log by id across all candidate roots (read-only).
// Guards: empty sid or sid containing "/", "\\" or ".." -> null.
// BFS with a queue of {dir, depth}, depth cap NATIVE_MUSE_MAX_DEPTH,
// visited cap NATIVE_MUSE_MAX_VISITED_DIRS (returns null when exceeded).
// DEFECT: queue of objects + readdirSync({withFileTypes:true}) +
// Dirent.isDirectory() — approximated by a fixed-capacity queue array
// (cap 3000 entries, matching the visited cap) and sa_std_fs_readdir
// externs yielding entry kind flags.
fn resolveNativeMuseSessionLog(sessionId_ptr: ptr, sessionId_len: u64, out_ptr: &ptr, out_len: &u64) -> i32 {
    return 1;
}

// Bounded native history listing for the sidebar's Muse tab.
// Scans `<sessions>/<date>/<sid>/session.jsonl`, dedupes by session id and sorts
// by mtime — the same entry shape `museThreadListResult` produces for
// internal threads so the web catalog consumes both interchangeably.
// Entry JSON built per session dir (verbatim shape from the source):
//   { id: sid, sessionId: sid, parentThreadId: null, preview,
//     model: null, createdAt: secs, updatedAt: secs, recencyAt: secs,
//     status: { type: "notLoaded" }, cwd: null, cliBackend: "muse",
//     source: "appServer", native: true, turns: [] }
// where secs = Math.floor(statSync(logPath).mtimeMs / 1000), falling
// back to Date.now() when stat fails, and preview falls back to
// "Muse conversation".
// DEFECT: Map<string, NativeMuseThreadEntry> dedupe + spread/sort/slice
// ([...byId.values()].sort(...).slice(0, capped)) — approximated by
// fixed-capacity arrays (cap 500, matching the limit clamp) and an
// explicit sort pass; capped = Math.max(1, Math.min(500, limit)).
// DEFECT: default parameter (limit = NATIVE_MUSE_LIST_LIMIT) —
// caller passes 0 to mean the default 200.
fn listNativeMuseThreads(limit: u64, out_entries: &NativeMuseThreadEntry, out_count: &u64) -> i32 {
    *out_count = 0;
    return 0;
}
