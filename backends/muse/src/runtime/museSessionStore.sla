// Converted 1:1 from backends/muse/src/runtime/museSessionStore.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
//
// Persists Muse CLI session and conversation metadata separately
// from Codex thread IDs. This allows history to remain readable after
// a server restart, and enables resuming existing conversations using --resume.
//
// Schema: one row per internal thread ID that uses the Muse backend.
//
// RuntimeDatabase comes from @cxu/sdk-backend (sdk-backend unit);
// the db handle is carried as an opaque u64 in the store struct.
@import "sa_std/io/print.sai"

// export interface MuseSessionRecord — nullable string fields
// (string | null) kept as (ptr, len) + has_* flags; number -> u64.
struct MuseSessionRecord {
    threadId_ptr: ptr,
    threadId_len: u64,
    ownerId_ptr: ptr,
    ownerId_len: u64,
    sessionId_ptr: ptr,
    sessionId_len: u64,
    has_sessionId: bool,
    cliVersion_ptr: ptr,
    cliVersion_len: u64,
    has_cliVersion: bool,
    model_ptr: ptr,
    model_len: u64,
    has_model: bool,
    cwd_ptr: ptr,
    cwd_len: u64,
    has_cwd: bool,
    permissionMode_ptr: ptr,
    permissionMode_len: u64,
    has_permissionMode: bool,
    stateJson_ptr: ptr,
    stateJson_len: u64,
    has_stateJson: bool,
    createdAt: u64,
    updatedAt: u64,
}

// interface MuseSessionRow — the snake_case DB row shape; same
// layout as MuseSessionRecord, field names are the column names
// (thread_id, owner_id, session_id, cli_version, model, cwd,
// permission_mode, state_json, created_at, updated_at).
struct MuseSessionRow {
    thread_id_ptr: ptr,
    thread_id_len: u64,
    owner_id_ptr: ptr,
    owner_id_len: u64,
    session_id_ptr: ptr,
    session_id_len: u64,
    has_session_id: bool,
    cli_version_ptr: ptr,
    cli_version_len: u64,
    has_cli_version: bool,
    model_ptr: ptr,
    model_len: u64,
    has_model: bool,
    cwd_ptr: ptr,
    cwd_len: u64,
    has_cwd: bool,
    permission_mode_ptr: ptr,
    permission_mode_len: u64,
    has_permission_mode: bool,
    state_json_ptr: ptr,
    state_json_len: u64,
    has_state_json: bool,
    created_at: u64,
    updated_at: u64,
}

// export class MuseSessionStore — class -> struct + fn family.
// DEFECT: class + constructor(private readonly db) — SLA has no
// classes or constructor injection; db is a plain field set by
// MuseSessionStore_new, which also runs the CREATE TABLE exec.
struct MuseSessionStore {
    db: u64,
}

// SQL kept verbatim from the source (constructor exec):
//   CREATE TABLE IF NOT EXISTS muse_sessions (
//     thread_id TEXT NOT NULL, owner_id TEXT NOT NULL,
//     session_id TEXT, cli_version TEXT, model TEXT, cwd TEXT,
//     permission_mode TEXT, state_json TEXT,
//     created_at INTEGER NOT NULL, updated_at INTEGER NOT NULL,
//     PRIMARY KEY (thread_id, owner_id)
//   );
// DEFECT: template-literal SQL + db.exec/prepare/run/get/all —
// sa_std has no SQLite prepared-statement API surface here; each
// method calls placeholder externs sa_db_exec / sa_db_prepare_*
// and the SQL text is passed via STR_PTR/STR_LEN.
fn MuseSessionStore_new(self: &MuseSessionStore, db: u64) -> i32 {
    self.db = db;
    return sa_db_exec(db, STR_PTR("CREATE TABLE IF NOT EXISTS muse_sessions (thread_id TEXT NOT NULL, owner_id TEXT NOT NULL, session_id TEXT, cli_version TEXT, model TEXT, cwd TEXT, permission_mode TEXT, state_json TEXT, created_at INTEGER NOT NULL, updated_at INTEGER NOT NULL, PRIMARY KEY (thread_id, owner_id))"), STR_LEN("CREATE TABLE IF NOT EXISTS muse_sessions (thread_id TEXT NOT NULL, owner_id TEXT NOT NULL, session_id TEXT, cli_version TEXT, model TEXT, cwd TEXT, permission_mode TEXT, state_json TEXT, created_at INTEGER NOT NULL, updated_at INTEGER NOT NULL, PRIMARY KEY (thread_id, owner_id))"));
}

// upsert(input): MuseSessionRecord
// SQL kept verbatim from the source:
//   INSERT INTO muse_sessions (thread_id, owner_id, session_id, cli_version, model, cwd, permission_mode, state_json, created_at, updated_at)
//   VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
//   ON CONFLICT(thread_id, owner_id) DO UPDATE SET
//     session_id = COALESCE(excluded.session_id, muse_sessions.session_id),
//     cli_version = COALESCE(excluded.cli_version, muse_sessions.cli_version),
//     model = COALESCE(excluded.model, muse_sessions.model),
//     cwd = COALESCE(excluded.cwd, muse_sessions.cwd),
//     permission_mode = COALESCE(excluded.permission_mode, muse_sessions.permission_mode),
//     state_json = COALESCE(excluded.state_json, muse_sessions.state_json),
//     updated_at = excluded.updated_at
// Each bound value is `input.x ?? existing?.x ?? null`.
// DEFECT: optional chaining + nullish coalescing (input.x ?? existing?.x ?? null)
// and the non-null assertion `this.get(...)!` — approximated by
// explicit has_* flag selection; the final get is assumed to succeed
// (returns status 1 if the row is somehow absent).
// DEFECT: Date.now() — approximated by sa_std_time_now_ms extern.
fn MuseSessionStore_upsert(self: &MuseSessionStore, input: &MuseSessionRecord, out: &MuseSessionRecord) -> i32 {
    let now: u64 = sa_std_time_now_ms();
    let existing = MuseSessionRecord { threadId_ptr: PTR_NULL(), threadId_len: 0, ownerId_ptr: PTR_NULL(), ownerId_len: 0, sessionId_ptr: PTR_NULL(), sessionId_len: 0, has_sessionId: false, cliVersion_ptr: PTR_NULL(), cliVersion_len: 0, has_cliVersion: false, model_ptr: PTR_NULL(), model_len: 0, has_model: false, cwd_ptr: PTR_NULL(), cwd_len: 0, has_cwd: false, permissionMode_ptr: PTR_NULL(), permissionMode_len: 0, has_permissionMode: false, stateJson_ptr: PTR_NULL(), stateJson_len: 0, has_stateJson: false, createdAt: 0, updatedAt: 0 };
    let has_existing: bool = false;
    if MuseSessionStore_get(self, input.ownerId_ptr, input.ownerId_len, input.threadId_ptr, input.threadId_len, &existing) == 0 { has_existing = true; };
    // Bound values: input field when present, else existing, else null.
    // (Selection logic per field follows the ?? chain in the source.)
    let created_at: u64 = now;
    if has_existing { created_at = existing.createdAt; };
    let rc: i32 = sa_db_run_upsert(self.db, input, &existing, has_existing, created_at, now);
    if rc != 0 { return rc; };
    return MuseSessionStore_get(self, input.ownerId_ptr, input.ownerId_len, input.threadId_ptr, input.threadId_len, out);
}

// get(ownerId, threadId): MuseSessionRecord | null
// SQL: SELECT * FROM muse_sessions WHERE thread_id = ? AND owner_id = ? LIMIT 1
// Returns 0 and fills out when found, 1 when null.
fn MuseSessionStore_get(self: &MuseSessionStore, ownerId_ptr: ptr, ownerId_len: u64, threadId_ptr: ptr, threadId_len: u64, out: &MuseSessionRecord) -> i32 {
    let row = MuseSessionRow { thread_id_ptr: PTR_NULL(), thread_id_len: 0, owner_id_ptr: PTR_NULL(), owner_id_len: 0, session_id_ptr: PTR_NULL(), session_id_len: 0, has_session_id: false, cli_version_ptr: PTR_NULL(), cli_version_len: 0, has_cli_version: false, model_ptr: PTR_NULL(), model_len: 0, has_model: false, cwd_ptr: PTR_NULL(), cwd_len: 0, has_cwd: false, permission_mode_ptr: PTR_NULL(), permission_mode_len: 0, has_permission_mode: false, state_json_ptr: PTR_NULL(), state_json_len: 0, has_state_json: false, created_at: 0, updated_at: 0 };
    if sa_db_get_by_thread_owner(self.db, threadId_ptr, threadId_len, ownerId_ptr, ownerId_len, &row) != 0 { return 1; };
    MuseSessionStore_mapRow(self, &row, out);
    return 0;
}

// getMetadata(ownerId, threadId): Pick<MuseSessionRecord, "threadId" | "ownerId" | "sessionId" | "model" | "cwd"> | null
// SQL: SELECT thread_id, owner_id, session_id, model, cwd FROM muse_sessions WHERE thread_id = ? AND owner_id = ? LIMIT 1
// DEFECT: Pick<> mapped type — approximated by filling only the five
// picked fields of a full MuseSessionRecord.
fn MuseSessionStore_getMetadata(self: &MuseSessionStore, ownerId_ptr: ptr, ownerId_len: u64, threadId_ptr: ptr, threadId_len: u64, out: &MuseSessionRecord) -> i32 {
    return sa_db_get_metadata(self.db, threadId_ptr, threadId_len, ownerId_ptr, ownerId_len, out);
}

// findByThreadId(threadId): MuseSessionRecord | null
// SQL: SELECT * FROM muse_sessions WHERE thread_id = ? LIMIT 1
fn MuseSessionStore_findByThreadId(self: &MuseSessionStore, threadId_ptr: ptr, threadId_len: u64, out: &MuseSessionRecord) -> i32 {
    let row = MuseSessionRow { thread_id_ptr: PTR_NULL(), thread_id_len: 0, owner_id_ptr: PTR_NULL(), owner_id_len: 0, session_id_ptr: PTR_NULL(), session_id_len: 0, has_session_id: false, cli_version_ptr: PTR_NULL(), cli_version_len: 0, has_cli_version: false, model_ptr: PTR_NULL(), model_len: 0, has_model: false, cwd_ptr: PTR_NULL(), cwd_len: 0, has_cwd: false, permission_mode_ptr: PTR_NULL(), permission_mode_len: 0, has_permission_mode: false, state_json_ptr: PTR_NULL(), state_json_len: 0, has_state_json: false, created_at: 0, updated_at: 0 };
    if sa_db_get_by_thread(self.db, threadId_ptr, threadId_len, &row) != 0 { return 1; };
    MuseSessionStore_mapRow(self, &row, out);
    return 0;
}

// findBySessionId(sessionId): MuseSessionRecord | null
// SQL: SELECT * FROM muse_sessions WHERE session_id = ? LIMIT 1
fn MuseSessionStore_findBySessionId(self: &MuseSessionStore, sessionId_ptr: ptr, sessionId_len: u64, out: &MuseSessionRecord) -> i32 {
    let row = MuseSessionRow { thread_id_ptr: PTR_NULL(), thread_id_len: 0, owner_id_ptr: PTR_NULL(), owner_id_len: 0, session_id_ptr: PTR_NULL(), session_id_len: 0, has_session_id: false, cli_version_ptr: PTR_NULL(), cli_version_len: 0, has_cli_version: false, model_ptr: PTR_NULL(), model_len: 0, has_model: false, cwd_ptr: PTR_NULL(), cwd_len: 0, has_cwd: false, permission_mode_ptr: PTR_NULL(), permission_mode_len: 0, has_permission_mode: false, state_json_ptr: PTR_NULL(), state_json_len: 0, has_state_json: false, created_at: 0, updated_at: 0 };
    if sa_db_get_by_session(self.db, sessionId_ptr, sessionId_len, &row) != 0 { return 1; };
    MuseSessionStore_mapRow(self, &row, out);
    return 0;
}

// listByOwner(ownerId): MuseSessionRecord[]
// SQL: SELECT * FROM muse_sessions WHERE owner_id = ? ORDER BY updated_at DESC
// DEFECT: dynamic array return + rows.map(...) — caller provides a
// fixed-capacity array (cap 1024 rows, noted here) + count out-param.
fn MuseSessionStore_listByOwner(self: &MuseSessionStore, ownerId_ptr: ptr, ownerId_len: u64, out_rows: &MuseSessionRecord, out_count: &u64) -> i32 {
    return sa_db_list_by_owner(self.db, ownerId_ptr, ownerId_len, out_rows, out_count);
}

// delete(ownerId, threadId): void
// SQL: DELETE FROM muse_sessions WHERE thread_id = ? AND owner_id = ?
fn MuseSessionStore_delete(self: &MuseSessionStore, ownerId_ptr: ptr, ownerId_len: u64, threadId_ptr: ptr, threadId_len: u64) -> i32 {
    return sa_db_delete_by_thread_owner(self.db, threadId_ptr, threadId_len, ownerId_ptr, ownerId_len);
}

// deleteByThread(threadId): void
// SQL: DELETE FROM muse_sessions WHERE thread_id = ?
fn MuseSessionStore_deleteByThread(self: &MuseSessionStore, threadId_ptr: ptr, threadId_len: u64) -> i32 {
    return sa_db_delete_by_thread(self.db, threadId_ptr, threadId_len);
}

// deleteByThreadId(threadId): void — delegates to deleteByThread.
fn MuseSessionStore_deleteByThreadId(self: &MuseSessionStore, threadId_ptr: ptr, threadId_len: u64) -> i32 {
    return MuseSessionStore_deleteByThread(self, threadId_ptr, threadId_len);
}

// private mapRow(row: MuseSessionRow): MuseSessionRecord —
// field-by-field snake_case -> camelCase copy.
// DEFECT: private method — SLA has no visibility; plain fn in the family.
fn MuseSessionStore_mapRow(self: &MuseSessionStore, row: &MuseSessionRow, out: &MuseSessionRecord) -> void {
    out.threadId_ptr = row.thread_id_ptr;
    out.threadId_len = row.thread_id_len;
    out.ownerId_ptr = row.owner_id_ptr;
    out.ownerId_len = row.owner_id_len;
    out.sessionId_ptr = row.session_id_ptr;
    out.sessionId_len = row.session_id_len;
    out.has_sessionId = row.has_session_id;
    out.cliVersion_ptr = row.cli_version_ptr;
    out.cliVersion_len = row.cli_version_len;
    out.has_cliVersion = row.has_cli_version;
    out.model_ptr = row.model_ptr;
    out.model_len = row.model_len;
    out.has_model = row.has_model;
    out.cwd_ptr = row.cwd_ptr;
    out.cwd_len = row.cwd_len;
    out.has_cwd = row.has_cwd;
    out.permissionMode_ptr = row.permission_mode_ptr;
    out.permissionMode_len = row.permission_mode_len;
    out.has_permissionMode = row.has_permission_mode;
    out.stateJson_ptr = row.state_json_ptr;
    out.stateJson_len = row.state_json_len;
    out.has_stateJson = row.has_state_json;
    out.createdAt = row.created_at;
    out.updatedAt = row.updated_at;
}
