// Converted 1:1 from backends/muse/src/runtime/museSessionStore.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
//
// Persists Muse CLI session and conversation metadata separately
// from Codex thread IDs. This allows history to remain readable after
// a server restart, and enables resuming existing conversations using --resume.
//
// Schema: one row per internal thread ID that uses the Muse backend.
//
// RuntimeDatabase comes from @cxu/sdk-backend (sdk-backend unit);
// the db handle is carried as an opaque u64 in the store struct.
@import "sa_std/io/print.sai"
@import "sa_std/encoding/json.sai"
@import "sa_std/time.sai"
@import "sa_std/globals.sai"
@import "sa_std/plugin_sqlite.sa"
@import "sa_std/string.sa"
@import "sa_std/ptr.sa"

// export interface MuseSessionRecord — nullable string fields
// (string | null) kept as (ptr, len) + has_* flags; number -> u64.
struct MuseSessionRecord {
    threadId_ptr: ptr,
    threadId_len: u64,
    ownerId_ptr: ptr,
    ownerId_len: u64,
    sessionId_ptr: ptr,
    sessionId_len: u64,
    has_sessionId: bool,
    cliVersion_ptr: ptr,
    cliVersion_len: u64,
    has_cliVersion: bool,
    model_ptr: ptr,
    model_len: u64,
    has_model: bool,
    cwd_ptr: ptr,
    cwd_len: u64,
    has_cwd: bool,
    permissionMode_ptr: ptr,
    permissionMode_len: u64,
    has_permissionMode: bool,
    stateJson_ptr: ptr,
    stateJson_len: u64,
    has_stateJson: bool,
    createdAt: u64,
    updatedAt: u64,
}

// interface MuseSessionRow — the snake_case DB row shape; same
// layout as MuseSessionRecord, field names are the column names
// (thread_id, owner_id, session_id, cli_version, model, cwd,
// permission_mode, state_json, created_at, updated_at).
struct MuseSessionRow {
    thread_id_ptr: ptr,
    thread_id_len: u64,
    owner_id_ptr: ptr,
    owner_id_len: u64,
    session_id_ptr: ptr,
    session_id_len: u64,
    has_session_id: bool,
    cli_version_ptr: ptr,
    cli_version_len: u64,
    has_cli_version: bool,
    model_ptr: ptr,
    model_len: u64,
    has_model: bool,
    cwd_ptr: ptr,
    cwd_len: u64,
    has_cwd: bool,
    permission_mode_ptr: ptr,
    permission_mode_len: u64,
    has_permission_mode: bool,
    state_json_ptr: ptr,
    state_json_len: u64,
    has_state_json: bool,
    created_at: u64,
    updated_at: u64,
}

// export class MuseSessionStore — class -> struct + fn family.
// DEFECT: class + constructor(private readonly db) — SLA has no
// classes or constructor injection; db is a plain field set by
// MuseSessionStore_new, which also runs the CREATE TABLE exec.
struct MuseSessionStore {
    db: u64,
    // Materialization buffer for row strings (record/row
    // (ptr, len) fields point into it; owned by the store).
    rowbuf: [u8; 1048576],
}

// SQL kept verbatim from the source (constructor exec):
//   CREATE TABLE IF NOT EXISTS muse_sessions (
//     thread_id TEXT NOT NULL, owner_id TEXT NOT NULL,
//     session_id TEXT, cli_version TEXT, model TEXT, cwd TEXT,
//     permission_mode TEXT, state_json TEXT,
//     created_at INTEGER NOT NULL, updated_at INTEGER NOT NULL,
//     PRIMARY KEY (thread_id, owner_id)
//   );
// DEFECT: template-literal SQL + db.exec/prepare/run/get/all —
// sa_std has no SQLite prepared-statement API surface here; each
// method calls placeholder externs sa_db_exec / sa_db_prepare_*
// and the SQL text is passed via STR_PTR/STR_LEN.
fn MuseSessionStore_new(self: &MuseSessionStore, db: u64) -> i32 {
    self.db = db;
    return sa_db_exec(db, STR_PTR("CREATE TABLE IF NOT EXISTS muse_sessions (thread_id TEXT NOT NULL, owner_id TEXT NOT NULL, session_id TEXT, cli_version TEXT, model TEXT, cwd TEXT, permission_mode TEXT, state_json TEXT, created_at INTEGER NOT NULL, updated_at INTEGER NOT NULL, PRIMARY KEY (thread_id, owner_id))"), STR_LEN("CREATE TABLE IF NOT EXISTS muse_sessions (thread_id TEXT NOT NULL, owner_id TEXT NOT NULL, session_id TEXT, cli_version TEXT, model TEXT, cwd TEXT, permission_mode TEXT, state_json TEXT, created_at INTEGER NOT NULL, updated_at INTEGER NOT NULL, PRIMARY KEY (thread_id, owner_id))"));
}

// upsert(input): MuseSessionRecord
// SQL kept verbatim from the source:
//   INSERT INTO muse_sessions (thread_id, owner_id, session_id, cli_version, model, cwd, permission_mode, state_json, created_at, updated_at)
//   VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
//   ON CONFLICT(thread_id, owner_id) DO UPDATE SET
//     session_id = COALESCE(excluded.session_id, muse_sessions.session_id),
//     cli_version = COALESCE(excluded.cli_version, muse_sessions.cli_version),
//     model = COALESCE(excluded.model, muse_sessions.model),
//     cwd = COALESCE(excluded.cwd, muse_sessions.cwd),
//     permission_mode = COALESCE(excluded.permission_mode, muse_sessions.permission_mode),
//     state_json = COALESCE(excluded.state_json, muse_sessions.state_json),
//     updated_at = excluded.updated_at
// Each bound value is `input.x ?? existing?.x ?? null`.
// DEFECT: optional chaining + nullish coalescing (input.x ?? existing?.x ?? null)
// and the non-null assertion `this.get(...)!` — approximated by
// explicit has_* flag selection; the final get is assumed to succeed
// (returns status 1 if the row is somehow absent).
// DEFECT: Date.now() — approximated by sa_std_time_now_ms extern.
fn MuseSessionStore_upsert(self: &MuseSessionStore, input: &MuseSessionRecord, out: &MuseSessionRecord) -> i32 {
    let now: u64 = sa_std_time_now_ms();
    let existing = MuseSessionRecord { threadId_ptr: PTR_NULL(), threadId_len: 0, ownerId_ptr: PTR_NULL(), ownerId_len: 0, sessionId_ptr: PTR_NULL(), sessionId_len: 0, has_sessionId: false, cliVersion_ptr: PTR_NULL(), cliVersion_len: 0, has_cliVersion: false, model_ptr: PTR_NULL(), model_len: 0, has_model: false, cwd_ptr: PTR_NULL(), cwd_len: 0, has_cwd: false, permissionMode_ptr: PTR_NULL(), permissionMode_len: 0, has_permissionMode: false, stateJson_ptr: PTR_NULL(), stateJson_len: 0, has_stateJson: false, createdAt: 0, updatedAt: 0 };
    let has_existing: bool = false;
    if MuseSessionStore_get(self, input.ownerId_ptr, input.ownerId_len, input.threadId_ptr, input.threadId_len, &existing) == 0 { has_existing = true; };
    // Bound values: input field when present, else existing, else null.
    // (Selection logic per field follows the ?? chain in the source.)
    let created_at: u64 = now;
    if has_existing { created_at = existing.createdAt; };
    let rc: i32 = sa_db_run_upsert(self.db, input, &existing, has_existing, created_at, now);
    if rc != 0 { return rc; };
    return MuseSessionStore_get(self, input.ownerId_ptr, input.ownerId_len, input.threadId_ptr, input.threadId_len, out);
}

// get(ownerId, threadId): MuseSessionRecord | null
// SQL: SELECT * FROM muse_sessions WHERE thread_id = ? AND owner_id = ? LIMIT 1
// Returns 0 and fills out when found, 1 when null.
fn MuseSessionStore_get(self: &MuseSessionStore, ownerId_ptr: ptr, ownerId_len: u64, threadId_ptr: ptr, threadId_len: u64, out: &MuseSessionRecord) -> i32 {
    let row = MuseSessionRow { thread_id_ptr: PTR_NULL(), thread_id_len: 0, owner_id_ptr: PTR_NULL(), owner_id_len: 0, session_id_ptr: PTR_NULL(), session_id_len: 0, has_session_id: false, cli_version_ptr: PTR_NULL(), cli_version_len: 0, has_cli_version: false, model_ptr: PTR_NULL(), model_len: 0, has_model: false, cwd_ptr: PTR_NULL(), cwd_len: 0, has_cwd: false, permission_mode_ptr: PTR_NULL(), permission_mode_len: 0, has_permission_mode: false, state_json_ptr: PTR_NULL(), state_json_len: 0, has_state_json: false, created_at: 0, updated_at: 0 };
    let rb: ptr = PTR_NULL(); PTR_BYTE_ADD(rb, &self.rowbuf, 0);
    if sa_db_get_by_thread_owner(self.db, threadId_ptr, threadId_len, ownerId_ptr, ownerId_len, rb, &row) != 0 { return 1; };
    MuseSessionStore_mapRow(self, &row, out);
    return 0;
}

// getMetadata(ownerId, threadId): Pick<MuseSessionRecord, "threadId" | "ownerId" | "sessionId" | "model" | "cwd"> | null
// SQL: SELECT thread_id, owner_id, session_id, model, cwd FROM muse_sessions WHERE thread_id = ? AND owner_id = ? LIMIT 1
// DEFECT: Pick<> mapped type — approximated by filling only the five
// picked fields of a full MuseSessionRecord.
fn MuseSessionStore_getMetadata(self: &MuseSessionStore, ownerId_ptr: ptr, ownerId_len: u64, threadId_ptr: ptr, threadId_len: u64, out: &MuseSessionRecord) -> i32 {
    let rb: ptr = PTR_NULL(); PTR_BYTE_ADD(rb, &self.rowbuf, 0);
    return sa_db_get_metadata(self.db, threadId_ptr, threadId_len, ownerId_ptr, ownerId_len, rb, out);
}

// findByThreadId(threadId): MuseSessionRecord | null
// SQL: SELECT * FROM muse_sessions WHERE thread_id = ? LIMIT 1
fn MuseSessionStore_findByThreadId(self: &MuseSessionStore, threadId_ptr: ptr, threadId_len: u64, out: &MuseSessionRecord) -> i32 {
    let row = MuseSessionRow { thread_id_ptr: PTR_NULL(), thread_id_len: 0, owner_id_ptr: PTR_NULL(), owner_id_len: 0, session_id_ptr: PTR_NULL(), session_id_len: 0, has_session_id: false, cli_version_ptr: PTR_NULL(), cli_version_len: 0, has_cli_version: false, model_ptr: PTR_NULL(), model_len: 0, has_model: false, cwd_ptr: PTR_NULL(), cwd_len: 0, has_cwd: false, permission_mode_ptr: PTR_NULL(), permission_mode_len: 0, has_permission_mode: false, state_json_ptr: PTR_NULL(), state_json_len: 0, has_state_json: false, created_at: 0, updated_at: 0 };
    let rb: ptr = PTR_NULL(); PTR_BYTE_ADD(rb, &self.rowbuf, 0);
    if sa_db_get_by_thread(self.db, threadId_ptr, threadId_len, rb, &row) != 0 { return 1; };
    MuseSessionStore_mapRow(self, &row, out);
    return 0;
}

// findBySessionId(sessionId): MuseSessionRecord | null
// SQL: SELECT * FROM muse_sessions WHERE session_id = ? LIMIT 1
fn MuseSessionStore_findBySessionId(self: &MuseSessionStore, sessionId_ptr: ptr, sessionId_len: u64, out: &MuseSessionRecord) -> i32 {
    let row = MuseSessionRow { thread_id_ptr: PTR_NULL(), thread_id_len: 0, owner_id_ptr: PTR_NULL(), owner_id_len: 0, session_id_ptr: PTR_NULL(), session_id_len: 0, has_session_id: false, cli_version_ptr: PTR_NULL(), cli_version_len: 0, has_cli_version: false, model_ptr: PTR_NULL(), model_len: 0, has_model: false, cwd_ptr: PTR_NULL(), cwd_len: 0, has_cwd: false, permission_mode_ptr: PTR_NULL(), permission_mode_len: 0, has_permission_mode: false, state_json_ptr: PTR_NULL(), state_json_len: 0, has_state_json: false, created_at: 0, updated_at: 0 };
    let rb: ptr = PTR_NULL(); PTR_BYTE_ADD(rb, &self.rowbuf, 0);
    if sa_db_get_by_session(self.db, sessionId_ptr, sessionId_len, rb, &row) != 0 { return 1; };
    MuseSessionStore_mapRow(self, &row, out);
    return 0;
}

// listByOwner(ownerId): MuseSessionRecord[]
// SQL: SELECT * FROM muse_sessions WHERE owner_id = ? ORDER BY updated_at DESC
// DEFECT: dynamic array return + rows.map(...) — caller provides a
// fixed-capacity array (cap 1024 rows, noted here) + count out-param.
fn MuseSessionStore_listByOwner(self: &MuseSessionStore, ownerId_ptr: ptr, ownerId_len: u64, out_rows: &[MuseSessionRecord], out_count: &u64) -> i32 {
    let rb: ptr = PTR_NULL(); PTR_BYTE_ADD(rb, &self.rowbuf, 0);
    return sa_db_list_by_owner(self.db, ownerId_ptr, ownerId_len, rb, out_rows, out_count);
}

// delete(ownerId, threadId): void
// SQL: DELETE FROM muse_sessions WHERE thread_id = ? AND owner_id = ?
fn MuseSessionStore_delete(self: &MuseSessionStore, ownerId_ptr: ptr, ownerId_len: u64, threadId_ptr: ptr, threadId_len: u64) -> i32 {
    return sa_db_delete_by_thread_owner(self.db, threadId_ptr, threadId_len, ownerId_ptr, ownerId_len);
}

// deleteByThread(threadId): void
// SQL: DELETE FROM muse_sessions WHERE thread_id = ?
fn MuseSessionStore_deleteByThread(self: &MuseSessionStore, threadId_ptr: ptr, threadId_len: u64) -> i32 {
    return sa_db_delete_by_thread(self.db, threadId_ptr, threadId_len);
}

// deleteByThreadId(threadId): void — delegates to deleteByThread.
fn MuseSessionStore_deleteByThreadId(self: &MuseSessionStore, threadId_ptr: ptr, threadId_len: u64) -> i32 {
    return MuseSessionStore_deleteByThread(self, threadId_ptr, threadId_len);
}

// private mapRow(row: MuseSessionRow): MuseSessionRecord —
// field-by-field snake_case -> camelCase copy.
// DEFECT: private method — SLA has no visibility; plain fn in the family.
fn MuseSessionStore_mapRow(self: &MuseSessionStore, row: &MuseSessionRow, out: &MuseSessionRecord) -> void {
    out.threadId_ptr = row.thread_id_ptr;
    out.threadId_len = row.thread_id_len;
    out.ownerId_ptr = row.owner_id_ptr;
    out.ownerId_len = row.owner_id_len;
    out.sessionId_ptr = row.session_id_ptr;
    out.sessionId_len = row.session_id_len;
    out.has_sessionId = row.has_session_id;
    out.cliVersion_ptr = row.cli_version_ptr;
    out.cliVersion_len = row.cli_version_len;
    out.has_cliVersion = row.has_cli_version;
    out.model_ptr = row.model_ptr;
    out.model_len = row.model_len;
    out.has_model = row.has_model;
    out.cwd_ptr = row.cwd_ptr;
    out.cwd_len = row.cwd_len;
    out.has_cwd = row.has_cwd;
    out.permissionMode_ptr = row.permission_mode_ptr;
    out.permissionMode_len = row.permission_mode_len;
    out.has_permissionMode = row.has_permission_mode;
    out.stateJson_ptr = row.state_json_ptr;
    out.stateJson_len = row.state_json_len;
    out.has_stateJson = row.has_state_json;
    out.createdAt = row.created_at;
    out.updatedAt = row.updated_at;
}

// ---------------------------------------------------------------------------
// SQLite binding layer (licenseStore model, mss_ prefix): the
// sa_db_* shims route to the SA_SQLITE_* facade macros; row JSON
// from SA_SQLITE_STEP_JSON is cached per statement in a global
// u64 cell keyed "sqlite.doc.<stmt>"; columns are read by INDEX
// (SELECT * order = table definition order). Row strings are
// materialized into the store rowbuf.
// ---------------------------------------------------------------------------

struct MssKeyBuf {
    bytes: [u8; 64],
    len: u64,
}

fn mss_key_append(b: &MssKeyBuf, src: ptr, src_len: u64) -> void {
    let i: u64 = 0;
    while i < src_len && b.len < 64 {
        let v: u8 = 0;
        PTR_BYTE_AT(v, src, i);
        b.bytes[b.len] = v;
        b.len = b.len + 1;
        i = i + 1;
    }
}

fn mss_key_append_u64(b: &MssKeyBuf, v: u64) -> void {
    if v >= 10 { mss_key_append_u64(b, v / 10); };
    let d: u8 = 48 + ((v % 10) as u8);
    if b.len < 64 { b.bytes[b.len] = d; b.len = b.len + 1; };
}

fn mss_row_key(out: &MssKeyBuf, stmt: u64) -> void {
    out.len = 0;
    mss_key_append(out, STR_PTR("sqlite.doc."), STR_LEN("sqlite.doc."));
    mss_key_append_u64(out, stmt);
}

fn mss_row_doc(stmt: u64) -> u64 {
    let key = MssKeyBuf { bytes: [0u8; 64], len: 0 };
    mss_row_key(&key, stmt);
    let kp: ptr = PTR_NULL();
    PTR_BYTE_ADD(kp, &key.bytes, 0);
    let doc: u64 = 0;
    let ig = sa_global_u64_get(kp, key.len, &doc);
    return doc;
}

fn mss_set_row_doc(stmt: u64, doc: u64) -> void {
    let key = MssKeyBuf { bytes: [0u8; 64], len: 0 };
    mss_row_key(&key, stmt);
    let kp: ptr = PTR_NULL();
    PTR_BYTE_ADD(kp, &key.bytes, 0);
    let ig = sa_global_u64_set(kp, key.len, doc);
}

fn mss_column_node(stmt: u64, idx: u64) -> u64 {
    let doc = mss_row_doc(stmt);
    if doc == 0 { return 0; };
    let kp: ptr = PTR_NULL();
    let kl: u64 = 0;
    if sa_json_object_key_at(doc, idx, &kp, &kl) != 0 { return 0; };
    let node: u64 = 0;
    if sa_json_object_get(doc, kp, kl, &node) != 0 { return 0; };
    return node;
}

fn mss_prepare(db: u64, sql_ptr: ptr, sql_len: u64) -> u64 {
    let st: u64 = 0;
    let stmt: u64 = 0;
    SA_SQLITE_PREPARE(st, stmt, db, sql_ptr, sql_len);
    return stmt;
}

fn mss_bind_text(stmt: u64, idx: u64, val_ptr: ptr, val_len: u64) -> void {
    let st: u64 = 0;
    SA_SQLITE_BIND_TEXT(st, stmt, idx, val_ptr, val_len);
}

fn mss_bind_null(stmt: u64, idx: u64) -> void {
    let st: u64 = 0;
    SA_SQLITE_BIND_NULL(st, stmt, idx);
}

fn mss_bind_int(stmt: u64, idx: u64, value: u64) -> void {
    let st: u64 = 0;
    SA_SQLITE_BIND_INT(st, stmt, idx, value);
}

fn mss_bind_text_or_null(stmt: u64, idx: u64, has: bool, val_ptr: ptr, val_len: u64) -> void {
    if has {
        mss_bind_text(stmt, idx, val_ptr, val_len);
    } else {
        mss_bind_null(stmt, idx);
    };
}

fn mss_step(stmt: u64) -> bool {
    let old = mss_row_doc(stmt);
    if old != 0 {
        let ig = sa_json_free(old);
        mss_set_row_doc(stmt, 0);
    };
    let st: u64 = 0;
    let ready: u64 = 0;
    let rp: ptr = PTR_NULL();
    let rl: u64 = 0;
    SA_SQLITE_STEP_JSON(st, ready, rp, rl, stmt);
    if ready == 0 { return false; };
    let doc = sa_json_parse(rp, rl);
    mss_set_row_doc(stmt, doc);
    return doc != 0;
}

fn mss_finalize(stmt: u64) -> void {
    let old = mss_row_doc(stmt);
    if old != 0 {
        let ig = sa_json_free(old);
        mss_set_row_doc(stmt, 0);
    };
    let st: u64 = 0;
    SA_SQLITE_FINALIZE(st, stmt);
}

fn mss_column_is_null(stmt: u64, idx: u64) -> bool {
    let node = mss_column_node(stmt, idx);
    if node == 0 { return true; };
    return sa_json_kind(node) == 0;
}

fn mss_column_int(stmt: u64, idx: u64) -> u64 {
    let node = mss_column_node(stmt, idx);
    if node == 0 { return 0; };
    let v: i64 = 0;
    if sa_json_as_i64(node, &v) != 0 { return 0; };
    return v as u64;
}

fn mss_fill_text(stmt: u64, idx: u64, rowbuf: ptr, cursor: &u64, out_ptr: &ptr, out_len: &u64, out_has: &bool) -> void {
    *out_ptr = PTR_NULL();
    *out_len = 0;
    *out_has = false;
    if mss_column_is_null(stmt, idx) { return; };
    let node = mss_column_node(stmt, idx);
    if node == 0 { return; };
    if sa_json_kind(node) != 5 { return; };
    let sp: ptr = PTR_NULL();
    sp = sa_json_string_ptr(node);
    let sl = sa_json_string_len(node);
    let n = sl;
    if (*cursor) + n > 1048576 { n = 1048576 - (*cursor); };
    let dst: ptr = PTR_NULL();
    PTR_BYTE_ADD(dst, rowbuf, (*cursor));
    let i: u64 = 0;
    while i < n {
        let v: u8 = 0;
        PTR_BYTE_AT(v, sp, i);
        let wp: ptr = PTR_NULL();
        PTR_BYTE_ADD(wp, dst, i);
        PTR_WRITE_U8(wp, v);
        i = i + 1;
    }
    *out_ptr = dst;
    *out_len = n;
    *out_has = true;
    *cursor = (*cursor) + n;
}

// SELECT * order: thread_id 0, owner_id 1, session_id 2,
// cli_version 3, model 4, cwd 5, permission_mode 6,
// state_json 7, created_at 8, updated_at 9.
fn mss_fill_row(stmt: u64, rowbuf: ptr, cursor: &u64, out: &MuseSessionRow) -> void {
    let h0 = false;
    mss_fill_text(stmt, 0, rowbuf, cursor, &out.thread_id_ptr, &out.thread_id_len, &h0);
    let h1 = false;
    mss_fill_text(stmt, 1, rowbuf, cursor, &out.owner_id_ptr, &out.owner_id_len, &h1);
    mss_fill_text(stmt, 2, rowbuf, cursor, &out.session_id_ptr, &out.session_id_len, &out.has_session_id);
    mss_fill_text(stmt, 3, rowbuf, cursor, &out.cli_version_ptr, &out.cli_version_len, &out.has_cli_version);
    mss_fill_text(stmt, 4, rowbuf, cursor, &out.model_ptr, &out.model_len, &out.has_model);
    mss_fill_text(stmt, 5, rowbuf, cursor, &out.cwd_ptr, &out.cwd_len, &out.has_cwd);
    mss_fill_text(stmt, 6, rowbuf, cursor, &out.permission_mode_ptr, &out.permission_mode_len, &out.has_permission_mode);
    mss_fill_text(stmt, 7, rowbuf, cursor, &out.state_json_ptr, &out.state_json_len, &out.has_state_json);
    out.created_at = mss_column_int(stmt, 8);
    out.updated_at = mss_column_int(stmt, 9);
}

fn mss_query_row(db: u64, sql_ptr: ptr, sql_len: u64, b1_ptr: ptr, b1_len: u64, b2_ptr: ptr, b2_len: u64, n_binds: u64, rowbuf: ptr, out: &MuseSessionRow) -> i32 {
    let stmt = mss_prepare(db, sql_ptr, sql_len);
    if stmt == 0 { return 1; };
    if n_binds >= 1 { mss_bind_text(stmt, 1, b1_ptr, b1_len); };
    if n_binds >= 2 { mss_bind_text(stmt, 2, b2_ptr, b2_len); };
    let found = mss_step(stmt);
    let rc: i32 = 1;
    if found {
        let cursor: u64 = 0;
        mss_fill_row(stmt, rowbuf, &cursor, out);
        rc = 0;
    };
    mss_finalize(stmt);
    return rc;
}

fn mss_map_row(row: &MuseSessionRow, out: &MuseSessionRecord) -> void {
    out.threadId_ptr = row.thread_id_ptr;
    out.threadId_len = row.thread_id_len;
    out.ownerId_ptr = row.owner_id_ptr;
    out.ownerId_len = row.owner_id_len;
    out.sessionId_ptr = row.session_id_ptr;
    out.sessionId_len = row.session_id_len;
    out.has_sessionId = row.has_session_id;
    out.cliVersion_ptr = row.cli_version_ptr;
    out.cliVersion_len = row.cli_version_len;
    out.has_cliVersion = row.has_cli_version;
    out.model_ptr = row.model_ptr;
    out.model_len = row.model_len;
    out.has_model = row.has_model;
    out.cwd_ptr = row.cwd_ptr;
    out.cwd_len = row.cwd_len;
    out.has_cwd = row.has_cwd;
    out.permissionMode_ptr = row.permission_mode_ptr;
    out.permissionMode_len = row.permission_mode_len;
    out.has_permissionMode = row.has_permission_mode;
    out.stateJson_ptr = row.state_json_ptr;
    out.stateJson_len = row.state_json_len;
    out.has_stateJson = row.has_state_json;
    out.createdAt = row.created_at;
    out.updatedAt = row.updated_at;
}

fn sa_std_time_now_ms() -> u64 {
    return (sa_time_unix_ms() as u64);
}

fn sa_db_exec(db: u64, sql_ptr: ptr, sql_len: u64) -> i32 {
    let st: u64 = 0;
    SA_SQLITE_EXEC(st, db, sql_ptr, sql_len);
    return st as i32;
}

fn sa_db_run_upsert(db: u64, input: &MuseSessionRecord, existing: &MuseSessionRecord, has_existing: bool, created: u64, now: u64) -> i32 {
    let sql = "INSERT INTO muse_sessions (thread_id, owner_id, session_id, cli_version, model, cwd, permission_mode, state_json, created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?) ON CONFLICT(thread_id, owner_id) DO UPDATE SET session_id = COALESCE(excluded.session_id, muse_sessions.session_id), cli_version = COALESCE(excluded.cli_version, muse_sessions.cli_version), model = COALESCE(excluded.model, muse_sessions.model), cwd = COALESCE(excluded.cwd, muse_sessions.cwd), permission_mode = COALESCE(excluded.permission_mode, muse_sessions.permission_mode), state_json = COALESCE(excluded.state_json, muse_sessions.state_json), updated_at = excluded.updated_at";
    let stmt = mss_prepare(db, STR_PTR(sql), STR_LEN(sql));
    if stmt == 0 { return 1; };
    mss_bind_text(stmt, 1, input.threadId_ptr, input.threadId_len);
    mss_bind_text(stmt, 2, input.ownerId_ptr, input.ownerId_len);
    // per-field ?? chain: input, else existing, else null
    let s_has = input.has_sessionId || (has_existing && existing.has_sessionId);
    let s_ptr = input.sessionId_ptr;
    let s_len = input.sessionId_len;
    if !input.has_sessionId && has_existing { s_ptr = existing.sessionId_ptr; s_len = existing.sessionId_len; };
    mss_bind_text_or_null(stmt, 3, s_has, s_ptr, s_len);
    let c_has = input.has_cliVersion || (has_existing && existing.has_cliVersion);
    let c_ptr = input.cliVersion_ptr;
    let c_len = input.cliVersion_len;
    if !input.has_cliVersion && has_existing { c_ptr = existing.cliVersion_ptr; c_len = existing.cliVersion_len; };
    mss_bind_text_or_null(stmt, 4, c_has, c_ptr, c_len);
    let m_has = input.has_model || (has_existing && existing.has_model);
    let m_ptr = input.model_ptr;
    let m_len = input.model_len;
    if !input.has_model && has_existing { m_ptr = existing.model_ptr; m_len = existing.model_len; };
    mss_bind_text_or_null(stmt, 5, m_has, m_ptr, m_len);
    let w_has = input.has_cwd || (has_existing && existing.has_cwd);
    let w_ptr = input.cwd_ptr;
    let w_len = input.cwd_len;
    if !input.has_cwd && has_existing { w_ptr = existing.cwd_ptr; w_len = existing.cwd_len; };
    mss_bind_text_or_null(stmt, 6, w_has, w_ptr, w_len);
    let p_has = input.has_permissionMode || (has_existing && existing.has_permissionMode);
    let p_ptr = input.permissionMode_ptr;
    let p_len = input.permissionMode_len;
    if !input.has_permissionMode && has_existing { p_ptr = existing.permissionMode_ptr; p_len = existing.permissionMode_len; };
    mss_bind_text_or_null(stmt, 7, p_has, p_ptr, p_len);
    let j_has = input.has_stateJson || (has_existing && existing.has_stateJson);
    let j_ptr = input.stateJson_ptr;
    let j_len = input.stateJson_len;
    if !input.has_stateJson && has_existing { j_ptr = existing.stateJson_ptr; j_len = existing.stateJson_len; };
    mss_bind_text_or_null(stmt, 8, j_has, j_ptr, j_len);
    mss_bind_int(stmt, 9, created);
    mss_bind_int(stmt, 10, now);
    let ig = mss_step(stmt);
    mss_finalize(stmt);
    return 0;
}

fn sa_db_get_by_thread_owner(db: u64, threadId_ptr: ptr, threadId_len: u64, ownerId_ptr: ptr, ownerId_len: u64, rowbuf: ptr, out: &MuseSessionRow) -> i32 {
    let sql = "SELECT * FROM muse_sessions WHERE thread_id = ? AND owner_id = ? LIMIT 1";
    return mss_query_row(db, STR_PTR(sql), STR_LEN(sql), threadId_ptr, threadId_len, ownerId_ptr, ownerId_len, 2, rowbuf, out);
}

fn sa_db_get_by_thread(db: u64, threadId_ptr: ptr, threadId_len: u64, rowbuf: ptr, out: &MuseSessionRow) -> i32 {
    let sql = "SELECT * FROM muse_sessions WHERE thread_id = ? LIMIT 1";
    return mss_query_row(db, STR_PTR(sql), STR_LEN(sql), threadId_ptr, threadId_len, PTR_NULL(), 0, 1, rowbuf, out);
}

fn sa_db_get_by_session(db: u64, sessionId_ptr: ptr, sessionId_len: u64, rowbuf: ptr, out: &MuseSessionRow) -> i32 {
    let sql = "SELECT * FROM muse_sessions WHERE session_id = ? LIMIT 1";
    return mss_query_row(db, STR_PTR(sql), STR_LEN(sql), sessionId_ptr, sessionId_len, PTR_NULL(), 0, 1, rowbuf, out);
}

fn sa_db_get_metadata(db: u64, threadId_ptr: ptr, threadId_len: u64, ownerId_ptr: ptr, ownerId_len: u64, rowbuf: ptr, out: &MuseSessionRecord) -> i32 {
    let sql = "SELECT thread_id, owner_id, session_id, model, cwd FROM muse_sessions WHERE thread_id = ? AND owner_id = ? LIMIT 1";
    let stmt = mss_prepare(db, STR_PTR(sql), STR_LEN(sql));
    if stmt == 0 { return 1; };
    mss_bind_text(stmt, 1, threadId_ptr, threadId_len);
    mss_bind_text(stmt, 2, ownerId_ptr, ownerId_len);
    let found = mss_step(stmt);
    let rc: i32 = 1;
    if found {
        let cursor: u64 = 0;
        let h = false;
        mss_fill_text(stmt, 0, rowbuf, &cursor, &out.threadId_ptr, &out.threadId_len, &h);
        mss_fill_text(stmt, 1, rowbuf, &cursor, &out.ownerId_ptr, &out.ownerId_len, &h);
        mss_fill_text(stmt, 2, rowbuf, &cursor, &out.sessionId_ptr, &out.sessionId_len, &out.has_sessionId);
        mss_fill_text(stmt, 3, rowbuf, &cursor, &out.model_ptr, &out.model_len, &out.has_model);
        mss_fill_text(stmt, 4, rowbuf, &cursor, &out.cwd_ptr, &out.cwd_len, &out.has_cwd);
        out.has_cliVersion = false;
        out.cliVersion_len = 0;
        out.has_permissionMode = false;
        out.permissionMode_len = 0;
        out.has_stateJson = false;
        out.stateJson_len = 0;
        out.createdAt = 0;
        out.updatedAt = 0;
        rc = 0;
    };
    mss_finalize(stmt);
    return rc;
}

fn sa_db_list_by_owner(db: u64, ownerId_ptr: ptr, ownerId_len: u64, rowbuf: ptr, out_rows: &[MuseSessionRecord], out_count: &u64) -> i32 {
    let sql = "SELECT * FROM muse_sessions WHERE owner_id = ? ORDER BY updated_at DESC";
    *out_count = 0;
    let stmt = mss_prepare(db, STR_PTR(sql), STR_LEN(sql));
    if stmt == 0 { return 1; };
    mss_bind_text(stmt, 1, ownerId_ptr, ownerId_len);
    let cursor: u64 = 0;
    while *out_count < 32 {
        if !mss_step(stmt) { break; };
        let row = MuseSessionRow { thread_id_ptr: PTR_NULL(), thread_id_len: 0, owner_id_ptr: PTR_NULL(), owner_id_len: 0, session_id_ptr: PTR_NULL(), session_id_len: 0, has_session_id: false, cli_version_ptr: PTR_NULL(), cli_version_len: 0, has_cli_version: false, model_ptr: PTR_NULL(), model_len: 0, has_model: false, cwd_ptr: PTR_NULL(), cwd_len: 0, has_cwd: false, permission_mode_ptr: PTR_NULL(), permission_mode_len: 0, has_permission_mode: false, state_json_ptr: PTR_NULL(), state_json_len: 0, has_state_json: false, created_at: 0, updated_at: 0 };
        mss_fill_row(stmt, rowbuf, &cursor, &row);
        mss_map_row(&row, &out_rows[*out_count]);
        *out_count = (*out_count) + 1;
    }
    mss_finalize(stmt);
    return 0;
}

fn sa_db_delete_by_thread_owner(db: u64, threadId_ptr: ptr, threadId_len: u64, ownerId_ptr: ptr, ownerId_len: u64) -> i32 {
    let sql = "DELETE FROM muse_sessions WHERE thread_id = ? AND owner_id = ?";
    let stmt = mss_prepare(db, STR_PTR(sql), STR_LEN(sql));
    if stmt == 0 { return 1; };
    mss_bind_text(stmt, 1, threadId_ptr, threadId_len);
    mss_bind_text(stmt, 2, ownerId_ptr, ownerId_len);
    let ig = mss_step(stmt);
    mss_finalize(stmt);
    return 0;
}

fn sa_db_delete_by_thread(db: u64, threadId_ptr: ptr, threadId_len: u64) -> i32 {
    let sql = "DELETE FROM muse_sessions WHERE thread_id = ?";
    let stmt = mss_prepare(db, STR_PTR(sql), STR_LEN(sql));
    if stmt == 0 { return 1; };
    mss_bind_text(stmt, 1, threadId_ptr, threadId_len);
    let ig = mss_step(stmt);
    mss_finalize(stmt);
    return 0;
}
