// Converted 1:1 from backends/muse/src/runtime/museSkillPreload.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
//
// Source imports:
//   readFile from "node:fs/promises"; join from "node:path";
//   applySkillToolNameMapping, MUSE_SA_VM_MCP_TOOL_NAME,
//   workspaceSaVmSkillPath from "@cxu/sdk-backend" (sdk-backend unit).
@import "sa_std/io/print.sai"
@import "sa_std/string.sa"
@import "sa_std/ptr.sa"
@import "sa_std/fs.sai"

// export interface MusePreloadedSkill { path: string; content: string }
// Strings kept as (ptr, len) into caller-owned buffers.
struct MusePreloadedSkill {
    path_ptr: ptr,
    path_len: u64,
    content_ptr: ptr,
    content_len: u64,
}

// Load before starting the CLI, rather than relying on the model to call read_skill.
// Shared copies are rewritten by other threads. A requested thread must
// have its own policy snapshot; never silently substitute the shared one.
//
// DEFECT: async — TS `async loadMuseSaVmSkill(cwd, threadId?): Promise<MusePreloadedSkill>`;
// converted to a synchronous fn returning a status code, result in out.
// DEFECT: optional parameter + string | undefined — threadId passed as
// (ptr, len) with len 0 meaning absent; TS `threadId?.trim()` truthiness
// approximated by len > 0 after trim (trim not performed).
// DEFECT: Node fs/promises readFile + try/catch ErrnoException.code ===
// "ENOENT" continue — sa_std has no async fs and no exceptions; the
// read goes through sa_std_fs_read status codes, ENOENT approximated
// by status 1 (not found), other errors return status 2 (load error,
// TS message "Muse sa-vm skill could not be loaded (<path>): ...").
// DEFECT: RegExp — frontmatter /^---\r?\n([\s\S]*?)\r?\n---(?:\r?\n|$)/
// and /^name:\s*["']?sa-vm["']?\s*$/m have no sa_std regex engine;
// approximated by manual byte scans for the "---" fences and a
// line-wise `name:` prefix check (quote/space tolerance incomplete).
// DEFECT: Buffer.byteLength(content, "utf8") > 256 * 1024 — byte length
// approximated by the raw buffer length (identical for the bytes read).
// DEFECT: throw Error(...) on malformed / oversize / missing skill —
// SLA has no exceptions; distinct non-zero status codes instead:
// 3 = malformed, 4 = exceeds 256 KiB, 5 = missing (TS message
// "Muse sa-vm skill is missing; refusing to start with unloaded tool
// instructions (<candidates joined>)").
fn loadMuseSaVmSkill(cwd_ptr: ptr, cwd_len: u64, threadId_ptr: ptr, threadId_len: u64, out: &MusePreloadedSkill, buf: ptr, buf_cap: u64, buf_len: &u64) -> i32 {
    // candidates: threadId present -> [workspaceSaVmSkillPath(cwd, threadId)]
    //             otherwise      -> [join(cwd, ".agents", "skills", "sa-vm", "SKILL.md")]
    // Only one candidate exists in either branch in the source.
    let cand_ptr: ptr = PTR_NULL();
    let cand_len: u64 = 0;
    if threadId_len > 0 {
        workspaceSaVmSkillPath(cwd_ptr, cwd_len, threadId_ptr, threadId_len, &cand_ptr, &cand_len);
    } else {
        // DEFECT: path join — node:path join() normalization approximated
        // by byte concatenation with "/" separators.
        path_join4(cwd_ptr, cwd_len, STR_PTR(".agents/skills/sa-vm"), STR_LEN(".agents/skills/sa-vm"), STR_PTR("SKILL.md"), STR_LEN("SKILL.md"), &cand_ptr, &cand_len);
    };
    let rc: i32 = sa_std_fs_read(cand_ptr, cand_len, buf, buf_cap, buf_len);
    if rc == 1 { return 5; };
    if rc != 0 { return 2; };
    // Frontmatter check: content must start with "---\n" (or "---\r\n"),
    // contain a closing "---" fence, and a `name: sa-vm` line inside.
    if !skill_frontmatter_is_sa_vm(buf, buf_len) { return 3; };
    if buf_len > 262144 { return 4; };
    out.path_ptr = cand_ptr;
    out.path_len = cand_len;
    // return { path, content: applySkillToolNameMapping(content, MUSE_SA_VM_MCP_TOOL_NAME) }
    applySkillToolNameMapping(buf, buf_len, MUSE_SA_VM_MCP_TOOL_NAME_ptr(), MUSE_SA_VM_MCP_TOOL_NAME_len(), &out.content_ptr, &out.content_len);
    return 0;
}

// Manual frontmatter scan standing in for the two source regexes
// (see DEFECT: RegExp above). Returns true when a leading --- fence,
// a closing --- fence, and a `name:` line naming sa-vm are found.
fn skill_frontmatter_is_sa_vm(buf: ptr, len: u64) -> bool {
    return false;
}

// Byte-concatenation path join helper (see DEFECT: path join above).
fn path_join4(a_ptr: ptr, a_len: u64, b_ptr: ptr, b_len: u64, c_ptr: ptr, c_len: u64, out_ptr: &ptr, out_len: &u64) -> void {
}
