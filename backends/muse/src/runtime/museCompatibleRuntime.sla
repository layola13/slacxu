// Converted 1:1 from backends/muse/src/runtime/museCompatibleRuntime.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
//
// Source imports: spawn / ChildProcessWithoutNullStreams from
// "node:child_process"; EventEmitter from "node:events";
// createInterface from "node:readline"; appendFileSync, mkdirSync,
// readdirSync, readFileSync, existsSync, writeFileSync, unlinkSync,
// rmSync from "node:fs"; join, dirname from "node:path"; randomUUID
// from "node:crypto"; homedir from "node:os"; pluginHostServices from
// "@cxu/sdk-backend"; findMuseBin, buildMuseExecArgs, buildSafeMuseEnv,
// buildMuseSaVmSettingsDir, resolveMuseScratchDirs,
// resolveMuseScratchRoot, isWithinDir from
// "./museCompatibleProbe.sla"; createMuseProjectorContext,
// projectMuseJsonlRecord, finalizeMuseProjection (+ types) from
// "./museCompatibleTurnProjector.sla".
@import "sa_std/io/print.sai"
@import "./museCompatibleProbe.sla"
@import "./museCompatibleTurnProjector.sla"

// export interface MuseExecTurnOptions — string fields as (ptr, len),
// optional fields with has_* flags.
struct MuseExecTurnOptions {
    prompt_ptr: ptr,
    prompt_len: u64,
    cwd_ptr: ptr,
    cwd_len: u64,
    threadId_ptr: ptr,
    threadId_len: u64,
    sessionId_ptr: ptr,
    sessionId_len: u64,
    has_sessionId: bool,
    model_ptr: ptr,
    model_len: u64,
    has_model: bool,
    effort_ptr: ptr,
    effort_len: u64,
    has_effort: bool,
    baseUrl_ptr: ptr,
    baseUrl_len: u64,
    has_baseUrl: bool,
    relayApiKey_ptr: ptr,
    relayApiKey_len: u64,
    has_relayApiKey: bool,
    dangerouslyBypassPermissions: bool,
    has_dangerouslyBypassPermissions: bool,
    timeoutMs: u64,
    has_timeoutMs: bool,
    // env: NodeJS.ProcessEnv — dropped, child env derives from the
    // process environment (see DEFECT on runMuseExecTurn).
    saVmMcpScriptPath_ptr: ptr,
    saVmMcpScriptPath_len: u64,
    has_saVmMcpScriptPath: bool,
    saVmApiUrl_ptr: ptr,
    saVmApiUrl_len: u64,
    has_saVmApiUrl: bool,
    token_ptr: ptr,
    token_len: u64,
    has_token: bool,
    // DEFECT: callback field onSpawn?: (child) => void — SLA has no
    // closures; represented as a u64 callback id resolved by the host.
    onSpawn_cb: u64,
    turnId_ptr: ptr,
    turnId_len: u64,
    has_turnId: bool,
}

// export interface MuseExecTurnResult
struct MuseExecTurnResult {
    text_ptr: ptr,
    text_len: u64,
    sessionId_ptr: ptr,
    sessionId_len: u64,
    has_sessionId: bool,
    completed: bool,
    rawLines: u64,
    // 失败时的真实原因（stderr 尾部 / spawn 错误 / 超时），成功时为空。
    error_ptr: ptr,
    error_len: u64,
    has_error: bool,
}

// interface MuseJsonlRecord { payload_type?: string; payload?: Record<string, any> }
// DEFECT: dynamic object — record kept as a sa_json doc id.
struct MuseJsonlRecord {
    doc: u64,
}

// Extract assistant text deltas from muse exec --json JSONL records.
// acc is the source's `{ text: string }` accumulator object, here a
// text buffer + length pair mutated in place.
// Rules preserved from the source:
// - line must trim to a "{"-prefixed JSON record, else false.
// - payload_type "run.output.delta" with string payload.text:
//   acc.text += payload.text; return true.
// - "run.reasoning.delta" / "run.thinking.delta" /
//   "run.output.reasoning.delta" with string text: return true
//   (counted, but NOT accumulated — reasoning goes to the projector).
// - "run.terminal.completed" with string payload.text and empty
//   acc.text: acc.text = payload.text; return true.
// - otherwise false.
// DEFECT: JSON.parse in try/catch — sa_json_parse status instead.
fn projectMuseJsonlLine(line_ptr: ptr, line_len: u64, acc_ptr: ptr, acc_len: &u64, acc_cap: u64) -> bool {
    return false;
}

// export interface MuseExecTurnOptionsWithTurn extends MuseExecTurnOptions { turnId?: string }
// — folded into MuseExecTurnOptions.turnId_* above.
// DEFECT: interface extends — SLA structs do not extend; merged.

fn extractMuseSessionId(line_ptr: ptr, line_len: u64, out_ptr: &ptr, out_len: &u64) -> bool {
    // JSON.parse(line).stream?.id, string and non-empty, else undefined.
    return false;
}

// Best-effort removal of the pre-scratch workspace litter. Older builds
// redirected the child's XDG dirs into `<cwd>/.codex-ultra/` (`muse-data`,
// `muse-config`, `muse-prompts`), where muse unpacked hundreds of bundled
// skill files on first run — showing up as untracked files in the user's git
// repo. New turns use the user-scoped scratch root instead (see
// resolveMuseScratchDirs); this removes the legacy dirs once. Only touches
// those three exact subdirs, never anything else.
// Guard: base = join(cwd, ".codex-ultra"); skipped when base is just
// ".codex-ultra" (empty cwd). Each dir removed with
// rmSync(dir, {recursive: true, force: true}) when it exists.
fn removeLegacyMuseWorkspaceDirs(cwd_ptr: ptr, cwd_len: u64) -> void {
}

// Run one headless `muse exec --json --provider meta` turn.
// Emits `delta` events for streaming text and resolves with the full text.
// Relay mode: baseUrl + relayApiKey (as META_API_KEY) travel only in child env.
//
// export class MuseCompatibleRuntime extends EventEmitter
// DEFECT: class extends EventEmitter — SLA has no inheritance or
// EventEmitter; struct + fn family, events delivered through the
// emit callback id (see runMuseExecTurn's emit_cb) with the source's
// rename rule: "error" is emitted as "runtimeError".
struct MuseCompatibleRuntime {
    child_pid: u64,
    has_child: bool,
    child_killed: bool,
    child_exitCode: i32,
    has_exitCode: bool,
    interrupted: bool,
}

fn MuseCompatibleRuntime_isRunning(self: &MuseCompatibleRuntime) -> bool {
    // Boolean(this.child && !this.child.killed && this.child.exitCode === null)
    return self.has_child && !self.child_killed && !self.has_exitCode;
}

// DEFECT: async + Promise.finally — TS
// `async runExecTurn(options): Promise<MuseExecTurnResult>` wraps
// runMuseExecTurn with an emit forwarder (error -> runtimeError) and
// clears this.child in finally. Converted to a synchronous call;
// this.child is set by the internal onSpawn hook and cleared before
// returning.
fn MuseCompatibleRuntime_runExecTurn(self: &MuseCompatibleRuntime, options: &MuseExecTurnOptions, emit_cb: u64, out: &MuseExecTurnResult) -> i32 {
    self.interrupted = false;
    return runMuseExecTurn(options, emit_cb, out);
}

// interrupt(): void — semantics preserved from the source:
// no-op when already interrupted or no child; ends child stdin when
// open; on win32 spawns taskkill /pid <pid> /T /F (falling back to
// child.kill("SIGTERM") + child.kill() on killer error), elsewhere
// child.kill("SIGTERM") then child.kill("SIGKILL"), all best-effort.
// DEFECT: child process handle + taskkill spawn — approximated by
// sa_std_process_* externs on child_pid (process-tree kill on POSIX
// is only the direct child; tree semantics lost).
fn MuseCompatibleRuntime_interrupt(self: &MuseCompatibleRuntime) -> void {
    if self.interrupted { return; };
    self.interrupted = true;
    if !self.has_child { return; };
    sa_std_process_kill(self.child_pid, 15);
    sa_std_process_kill(self.child_pid, 9);
}

// 在 per-turn 数据目录下定位 muse session log（verified 1.4.7/1.4.10：
// `$XDG_DATA_HOME/muse/sessions/<date>/<session-id>/session.jsonl`，
// 实测日期层可能为 1 层 `<YYYY-MM-DD>` 或 3 层 `<YYYY>/<MM>/<DD>`）。
// 使用 BFS 遍历至多 5 层子目录精确匹配 `<sid>/session.jsonl`，不假设日期层级。
// DEFECT: BFS queue of {dir, depth} objects + readdirSync withFileTypes
// — fixed-capacity queue array + sa_std_fs_readdir externs, as in
// museHistoryProjection.sla.
fn findMuseSessionLog(dataDir_ptr: ptr, dataDir_len: u64, sessionId_ptr: ptr, sessionId_len: u64, out_ptr: &ptr, out_len: &u64) -> i32 {
    return 1;
}

// Workflow/native subagents write their own log under the parent session:
// `sessions/<date...>/<parent>/subagent/<child>/session.jsonl` (verified
// 2026-10-22 against Muse 1.4.11 workflow + native subagent runs).
//
// Child sessions are not CUX threads, so the parent thread/read path cannot
// restore them; opening a child card used to hit the Codex bridge and fail
// with `thread not loaded`. Search the scratch data root and the real XDG
// data root (resumed parents keep their children beside the original log).
// Roots searched (in order, deduped by Set in the source): scratch
// data dir, env XDG_DATA_HOME, join(home, ".local", "share"); BFS to
// depth 8 under each <root>/muse/sessions.
fn findMuseChildSessionLog(childSessionId_ptr: ptr, childSessionId_len: u64, out_ptr: &ptr, out_len: &u64) -> i32 {
    return 1;
}

// export interface MuseChildSessionProjection — items is an array of
// dynamic records; kept as a JSON text buffer (items_json).
struct MuseChildSessionProjection {
    logPath_ptr: ptr,
    logPath_len: u64,
    items_json_ptr: ptr,
    items_json_len: u64,
    status: u64, // 0 = running, 1 = completed, 2 = failed
    startedAt: u64,
}

// Project a subagent session log into the same item shape the parent
// waterfall uses. Child logs contain reasoning_committed / tool_batch.effect
// events instead of the parent's stdout `tool.result`, so the projector's
// offline branch handles those inner kinds.
// Per line: JSON.parse; startedAt from the first finite
// Date.parse(record.recorded_at) (seconds); "runtime.session" records
// with payload.event.kind === "terminal" capture event.terminal;
// every line goes through projectMuseJsonlRecord with an offline
// context and item/started|completed events are upserted by id
// (started appends when absent, completed replaces in place or
// appends). Final status: terminal (or ctx.status when no terminal)
// lowercased — /fail|error|cancel/ -> failed,
// /complete|terminal|success/ -> completed, else running.
// DEFECT: Date.parse on ISO strings + RegExp status tests —
// approximated by sa_std_time_parse_iso extern and substring scans.
// DEFECT: dynamic item array upsert — items kept as a JSON array
// text buffer, upsert done by id lookup in the buffer.
fn readMuseChildSessionLog(childSessionId_ptr: ptr, childSessionId_len: u64, out: &MuseChildSessionProjection) -> i32 {
    return 1;
}

// runMuseExecTurn(options, emit?) — the core turn runner.
// Flow preserved from the source, in order:
// 1. bin = findMuseBin(env). captureSessionId = resume sessionId when
//    present, else randomUUID(); scratch = resolveMuseScratchDirs(threadId);
//    captureDataDir = scratch.dataDir only for new sessions (resume turns
//    keep the real XDG so resume is not broken); promptDir = scratch.promptsDir;
//    removeLegacyMuseWorkspaceDirs(cwd) once.
// 2. Prompt file: mkdir promptDir; write prompt-<captureSessionId>-<Date.now()>.txt;
//    on failure fall back to passing the prompt inline as argv.
// 3. args = buildMuseExecArgs({prompt or promptFilePath, model, effort,
//    sessionId: captureSessionId, workspace: cwd, baseUrl,
//    dangerouslyBypassPermissions}).
// 4. childEnv: XDG_DATA_HOME = captureDataDir (mkdir first) when set;
//    META_API_KEY = relayApiKey when non-empty.
// 5. sa-vm MCP mount when saVmMcpScriptPath set: apiUrl from
//    saVmApiUrl or http://127.0.0.1:<CODEX_UI_PORT|43110>; token from
//    options.token ?? CODEX_UI_TOKEN; settingsDir =
//    buildMuseSaVmSettingsDir({cwd, xdgRoot: scratch.configDir, ...});
//    on success XDG_CONFIG_HOME = settingsDir and
//    MUSE_SA_VM_ENVELOPE = "1"; on failure the prompt file is unlinked
//    and the turn resolves {text: "", completed: false, rawLines: 0,
//    error: "Muse sa-vm MCP configuration failed; refusing to start
//    without required workspace tools"} — never a silent native-only run.
// 6. env = buildSafeMuseEnv({}, childEnv); timeoutMs defaults to
//    8 * 60_000 ms.
// 7. Spawn via pluginHostServices().codex.resolveCodexSpawn + spawn
//    {cwd, env, stdio: ["ignore", "pipe", "pipe"], windowsHide: true};
//    spawn throw -> emit error + finish(false, message).
// 8. readline over stdout: rawLines++; optional JSONL dump to
//    MUSE_JSONL_DUMP_DIR (appendFileSync per line, file
//    muse-<threadId>-<Date.now()>.jsonl); sessionId from the first
//    extractMuseSessionId hit; projectMuseJsonlRecord per line ->
//    emit "projected"; projectMuseJsonlLine -> emit "delta"
//    {threadId, text: acc.text}.
// 9. Session-log tailer (only when captureDataDir): poll immediately,
//    then setInterval 150 ms; tracks logOffset/logRemainder, projects
//    new complete lines through the same projector -> "projected".
// 10. stderr data appended to stderrTail, capped to the last 4000 chars.
// 11. Timeout timer: kill SIGTERM, finish(acc.text.length > 0, ...)
//     with a "muse exec timed out after <timeoutMs>ms" error (plus
//     stderr tail) when nothing was produced.
// 12. child "error" -> finish(false, spawnError); child "close" ->
//     finish(true) when code === 0 or acc.text non-empty, else
//     finish(false, stderrTail || "muse exec exited with code <code>").
// 13. finish(): once-only; clears timers, unlinks the prompt file,
//     final log poll, removes this turn's session subdir when logPath
//     is within captureDataDir (rmSync dirname, recursive), then
//     finalizeMuseProjection -> emit "projected", and resolves
//     {text: acc.text, sessionId, completed, rawLines, error} where
//     error = explicitError || stderrText || spawnError ||
//     "muse exec exited with code <exitCode>" || "muse exec turn failed".
// DEFECT: Promise + readline stream + setInterval/setTimeout timers
// + child event handlers ("error"/"close"/stderr "data") — SLA has
// no streams, timers, or Promise; approximated by a single blocking
// sa_std_process_spawn_bidi-style extern driving a poll loop, with
// the 150 ms log poll and the timeout folded into that loop. Event
// ordering between stdout lines, log lines, and stderr is therefore
// only approximately the source's.
// DEFECT: emit callback (event, data) — represented by emit_cb id;
// "delta"/"projected"/"error" payloads are JSON text buffers.
// DEFECT: randomUUID / Date.now in file names — sa_std externs.
fn runMuseExecTurn(options: &MuseExecTurnOptions, emit_cb: u64, out: &MuseExecTurnResult) -> i32 {
    out.completed = false;
    out.rawLines = 0;
    out.has_sessionId = false;
    out.has_error = false;
    return 1;
}
