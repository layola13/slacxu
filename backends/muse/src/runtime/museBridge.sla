fn MuseBridge_notify(self: &MuseBridge, method_ptr: ptr, method_len: u64, params_ptr: ptr, params_len: u64) -> i32 {
    return 0;
}

fn MuseBridge_respond(self: &MuseBridge, id_ptr: ptr, id_len: u64) -> void {
}

fn MuseBridge_hasSession(self: &MuseBridge, threadId_ptr: ptr, threadId_len: u64) -> bool {
    return false;
}

// True when `threadId` is a workflow/native subagent session rather than a
// CUX thread. Opening the child card must route thread/read to Muse; the
// Codex bridge cannot load these ids and used to fail the whole tab with
// `thread not loaded`.
fn MuseBridge_hasChildThread(self: &MuseBridge, threadId_ptr: ptr, threadId_len: u64) -> bool {
    let path_ptr: ptr = PTR_NULL();
    let path_len: u64 = 0;
    return MuseBridge_childSessionLogPath(self, threadId_ptr, threadId_len, &path_ptr, &path_len) == 0;
}

// childLogCache: cached path (or null) is reused for 5_000 ms
// (Date.now() - cached.at < 5_000); misses are cached briefly too.
// DEFECT: Date.now() cache timestamps — sa_std_time_now_ms extern.
fn MuseBridge_childSessionLogPath(self: &MuseBridge, threadId_ptr: ptr, threadId_len: u64, out_ptr: &ptr, out_len: &u64) -> i32 {
    return findMuseChildSessionLog(threadId_ptr, threadId_len, out_ptr, out_len);
}

fn MuseBridge_readChildSession(self: &MuseBridge, threadId_ptr: ptr, threadId_len: u64, out: &MuseChildSessionProjection) -> i32 {
    let path_ptr: ptr = PTR_NULL();
    let path_len: u64 = 0;
    if MuseBridge_childSessionLogPath(self, threadId_ptr, threadId_len, &path_ptr, &path_len) != 0 { return 1; };
    return readMuseChildSessionLog(threadId_ptr, threadId_len, out);
}

// childThreadSnapshot(threadId, projection, includeTurns): JsonValue
// Builds (verbatim shape): { thread: { id, sessionId: threadId,
