// request(method, params?, _timeoutMs?): Promise<JsonValue>
// The JSON-RPC dispatcher. params is a JSON object buffer (record);
// the result is a JSON text buffer. Method cases, in source order:
// - "thread/start": threadId = randomUUID(); session created with
//   ownerId/cwd (default process.cwd())/model (default
//   MUSE_DEFAULT_MODEL)/effort (reasoningEffort ?? effort)/
//   providerId (default MUSE_OFFICIAL_PROVIDER_ID)/groupId
//   (default "default"); persisted; bootstrapProjectSaVmAssets(cwd,
//   threadId); returns {thread: {id, cliBackend: "muse", cwd, model,
//   status: "active", createdAt: Date.now()}, threadId}.
// - "thread/read" / "thread/resume": metadata fast path when
//   !includeTurns && !liveSession && !childProjection &&
//   loadMetadata (missing metadata -> idle empty thread shape);
//   childProjection -> childThreadSnapshot; unknown session -> idle
//   empty shape; else the full thread shape with turns mapped
//   (in_progress -> active turn ? "inProgress" : "interrupted",
//   startedAt = floor(createdAt/1000), items filtered by turnId).
// - "thread/turns/list": unknown session -> child snapshot turns or
//   {turns: [], data: [], nextCursor: null}; else
//   pageThreadHistory(threadId, turns, messages, {cursor,
//   limit ?? 32, sortDirection ?? "desc"}).
// - "thread/list": sessions mapped to {id, cwd, model, preview,
//   createdAt: turns[0]?.createdAt ?? Date.now()}.
// - "thread/delete": deleteSession; returns {ok: true}.
// - "turn/start": see MuseBridge_request_turnStart below.
// - "turn/interrupt": interrupt the active turn's runtime, mark the
//   turn "interrupted", mark the active assistant message
//   "interrupted", persist, emit turn/interrupted; {ok: true}.
// - "thread/compact/start": for a live session, emits turn/started,
//   item/completed (type "compaction", id muse-compact-<turnId>),
//   turn/completed with a fresh randomUUID turnId and returns the
//   completed turn; without a session returns {success: false}.
// - "thread/goal/set": stores goalObjective/goalStatus (default
//   "active") and persists; {ok: true} or {ok: false}.
// - "thread/goal/get": {goal: {objective, status} | null}.
// - default: returns {}.
// DEFECT: async + switch over dynamic JSON params + throw Error on
// relay/login failures in turn/start — status codes + error buffer
// instead of exceptions; each case is a helper fn below to keep the
// 1:1 case order readable.
fn MuseBridge_request(self: &MuseBridge, method_ptr: ptr, method_len: u64, params_ptr: ptr, params_len: u64, out_ptr: &ptr, out_len: &u64, err_ptr: &ptr, err_len: &u64) -> i32 {
    return 0;
}

// "turn/start" case (the long one), step order preserved:
// 1. session = getOrRestoreSession(threadId, ownerId); cwd/providerId/
//    groupId/model/effort resolved from record with session/default
//    fallbacks (see request docs above).
// 2. saVmExplicitlyDisabled = record.vmEnabled === false &&
//    record.enhanceEnabled !== true; developerInstructions from the
//    record (trimmed, empty -> undefined), else undefined when
//    explicitly disabled, else the session's stored value.
// 3. Create-or-update the session with those fields.
// 4. relayTarget = resolveRelayTarget(...); a non-official provider
//    without a target throws "Muse 中转配置缺失 (provider=<p>
//    group=<g>)，请检查中转站密钥与分组模型；官方模式请先运行 muse
//    login 或设置 META_API_KEY"; official without isMuseLoggedIn()
//    and without a target throws "Muse 官方模式未登录：请先运行
//    `muse login`，或设置 META_API_KEY，或切换到中转站分组".
// 5. Prompt assembly: record.input array items of type "text" are
//    concatenated (text + "\n") into promptText, other items go to
