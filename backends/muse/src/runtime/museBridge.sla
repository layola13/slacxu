fn MuseBridge_resolveRelayTarget(self: &MuseBridge, providerId_ptr: ptr, providerId_len: u64, has_providerId: bool, groupId_ptr: ptr, groupId_len: u64, has_groupId: bool, model_ptr: ptr, model_len: u64, has_model: bool, out: &MuseRelayTarget) -> i32 {
    return 1;
