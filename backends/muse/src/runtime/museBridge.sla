// 按 id 落盘单行（started 不存在才追加，completed 按 id 原位替换）。
// 盲目 push 会导致同一 id 存两行，历史重开时回答显示两遍——回归禁区。
// kind: 0 = "item/started", 1 = "item/completed". item is a JSON
// record buffer; ignored when its "id" is not a string.
// DEFECT: Array.findIndex over dynamic JsonValue[] — approximated by
// a linear scan of the JSON array buffer comparing "id" fields.
fn upsertMuseSessionItem(session: &MusePersistedSessionLike, kind: u64, item_ptr: ptr, item_len: u64) -> void {
}

// 投影批次 → 通知列表（纯函数，可单测）。
// turn 级事件由 turn 收尾统一发射，这里跳过，避免 turn/completed 重复。
// Per event: skip non-objects / non-string kind; skip kinds
// "turn/completed" | "turn/failed" | "turn/started"; otherwise
// notif = toMuseNotification(evt); for "item/started" /
// "item/completed" with params.item, upsertMuseSessionItem first;
// then push the notification. Per-event try/catch in the source
// (单事件投影失败不影响其他行) becomes a per-event status check.
// Notifications are appended to the out JSON array buffer.
// DEFECT: try/catch per event + dynamic event objects — status
// checks over JSON buffers instead.
fn applyMuseProjectedBatch(session: &MusePersistedSessionLike, batched_ptr: ptr, batched_len: u64, out_ptr: &ptr, out_len: &u64, out_count: &u64) -> void {
    *out_count = 0;
}

// 学自 opencode/agy：跨 turn 的工具指令必须前置到 executionPrompt，
// 不能赌模型去读 skill 文件。Muse 经 MCP 加载工具，会话里只有
// `mcp__<server>__<tool>` 全名；模型高频剥掉前缀误调裸名（如 sa_vm_run），
// 必报 unknown tool（verified 2026-10-13）。此规则每 turn 置顶。
// MUSE_MCP_NAMING_RULE — the joined lines, verbatim from the source:
// "[MCP tool naming - hard rule]"
// "Workspace tools are loaded via MCP: always call them by their FULL session names exactly as listed (e.g. `mcp__sa_vm__sa_vm_run`); bare un-prefixed tool names do not exist and fail with \"unknown tool\"."
// "If a call fails with unknown tool, retry ONCE with `mcp__sa_vm__sa_vm_run` and the identical JSON args - never retry the bare name, never switch topics, never ask what to do. Never strip the `mcp__<server>__` prefix."
// "Actions `list_dir`, `read_file`, `read_lines`, `count_lines`, `file_info`, `grep_search`, `find_files`, `edit_file`, `write_file`, `apply_patch` have NO bare tool: call them ONLY as `mcp__sa_vm__sa_vm_run({ action: 'list_dir', ... })`. Bare `read_file`/`edit_file`/`write_file`/`search`/`workflow` in the tool list are DIFFERENT native tools with different arguments - never use them for `action`-routed calls."
// "Every sa-vm call MUST carry `action` plus its required fields: e.g. `mcp__sa_vm__sa_vm_run({ \"action\": \"list_dir\", \"dir\": \".\" })`, `mcp__sa_vm__sa_vm_run({ \"action\": \"read_file\", \"path\": \"package.json\" })`, `mcp__sa_vm__sa_vm_run({ \"action\": \"grep_search\", \"query\": \"foo\", \"dir\": \".\" })`. WRONG: `{}`. An empty `{}` call auto-runs `list_dir('.')` as a probe fallback — do NOT treat that directory listing as the answer and do NOT resend `{}`; send ONE full-argument call instead. When unsure what to call first, default to `list_dir` with `dir: \".\"`."
// "Do not invent `default.` or `functions.` prefixes. For large files, locate symbols with `grep_search`/`file_outline` and read a bounded range with `read_lines` plus `start_line`/`end_line`; a whole-file size rejection is NOT tool unavailability. Never retry the same rejected whole-file read."
fn MUSE_MCP_NAMING_RULE_ptr() -> ptr { return STR_PTR("[MCP tool naming - hard rule]"); }
fn MUSE_MCP_NAMING_RULE_len() -> u64 { return 0; }

// MUSE_EXECUTION_DIRECTIVE — joined lines, verbatim from the source:
// "[Execution Directives - Crucial]"
// "1. Before any workspace tool call, read and follow the [Preloaded Skill: sa-vm] below when present; it was loaded by the host before execution, so no read_skill call is needed for that skill. Then execute the user request with the documented full tool name and complete arguments. Never guess tool names or schemas. For explanation-only requests, answer directly without unnecessary tool calls."
// "2. DO NOT output conversational acknowledgments (such as 'Ready', 'Acknowledged', or asking 'What task should I work on?') or preamble/announcements (such as '我能...', '现在开始...', '让我来...') BEFORE calling tools. If tools are needed, call tools FIRST with NO preceding text. Output explanations, conclusions, or answers ONLY AFTER tool execution completes."
// + MUSE_MCP_NAMING_RULE
fn MUSE_EXECUTION_DIRECTIVE_ptr() -> ptr { return STR_PTR("[Execution Directives - Crucial]"); }
fn MUSE_EXECUTION_DIRECTIVE_len() -> u64 { return 0; }

// 临时关闭 sa-vm MCP：CODEX_MUSE_DISABLE_SA_VM=1 时不挂载、不注入 sa-vm 规则，Muse 只用原生工具。
// DEFECT: process.env read at module load — evaluated once by the
// host at startup into this flag.
// FIX(be2): SLA has no mutable top-level let; the TS module-load
// constant becomes an accessor over the same env read
// (process.env.CODEX_MUSE_DISABLE_SA_VM === "1").
fn muse_sa_vm_disabled() -> bool {
    let h = sa_env_get(STR_PTR("CODEX_MUSE_DISABLE_SA_VM"), STR_LEN("CODEX_MUSE_DISABLE_SA_VM"));
    if h == 0 { return false; };
    if sa_env_buffer_len(h) != 1 { return false; };
    let bp: ptr = PTR_NULL();
    bp = sa_env_buffer_data(h);
    return PTR_BYTE_AT(bp, 0) == 49;
}

// The sa-vm MCP is mounted per turn. Any turn that carries sa-vm developer
// instructions (VM tools or enhance-only tools) must mount it and map the
// instructions to the MCP name. Treating `vmEnabled: false` as "no tools"
// here produced prompts that said "No sa-vm MCP server is attached" while the
// tool block still told the model to call `sa_vm_run`, so every first call
// failed with unknown tool.
// record is the turn/start params JSON buffer; vmEnabled /
// enhanceEnabled are read from it by key.
fn resolveMuseSaVmEnabled(record_ptr: ptr, record_len: u64, developerInstructions_ptr: ptr, developerInstructions_len: u64, has_developerInstructions: bool) -> bool {
    if muse_sa_vm_disabled() { return false; };
    if has_developerInstructions && developerInstructions_len > 0 { return true; };
    return false;
    // || record.vmEnabled === true || record.enhanceEnabled === true
}

// buildMuseExecutionPrompt(developerInstructions, cleanPrompt,
//   { preloadedSkill?, saVmEnabled? }): string
// Assembly preserved from the source:
// - directives = saVmEnabled (default true) ? MUSE_EXECUTION_DIRECTIVE
//   : "[Execution Directives - Crucial]\nUse only the native tools actually listed in this session, with their declared arguments. No sa-vm MCP server is attached."
// - skillReference = saVmEnabled && preloadedSkill
//   ? "\n\n[Preloaded Skill: sa-vm]\nSource: <path>\n<content>\n[End Preloaded Skill: sa-vm]" : ""
// - executionRules = directives + skillReference
// - with developerInstructions: mapped = saVmEnabled
//   ? mapSaVmToolReferences(trimmed, MUSE_SA_VM_MCP_TOOL_NAME) : trimmed;
//   userText ? "[User Instruction]\n<user>\n\n<rules>\n\n[Tool Reference & Constraints]\n<mapped>"
//            : "<rules>\n\n[Tool Reference & Constraints]\n<mapped>"
// - without: userText ? "[User Instruction]\n<user>\n\n<rules>" : "<rules>"
// Output written into the caller's prompt buffer.
fn buildMuseExecutionPrompt(developerInstructions_ptr: ptr, developerInstructions_len: u64, has_developerInstructions: bool, cleanPrompt_ptr: ptr, cleanPrompt_len: u64, preloadedSkill: &MusePreloadedSkill, has_preloadedSkill: bool, saVmEnabled: bool, has_saVmEnabled: bool, out_ptr: &ptr, out_len: &u64) -> void {
}

// export class MuseBridge extends EventEmitter implements CodexRuntimeClient
// DEFECT: class extends EventEmitter + implements interface + Map
// fields — struct + fn family; sessions and childLogCache are
// host-side maps keyed by thread/session id buffers, represented as
// opaque u64 handles; emit("notification", ...) goes through the
// host notification extern sa_host_emit_notification.
struct MuseBridge {
    options: MuseBridgeOptions,
    has_options: bool,
    sessions: u64,
    childLogCache: u64,
    status_phase_ptr: ptr,
    status_phase_len: u64,
    status_transport_ptr: ptr,
    status_transport_len: u64,
    status_message_ptr: ptr,
    status_message_len: u64,
    has_status_message: bool,
}

fn MuseBridge_new(self: &MuseBridge, options: &MuseBridgeOptions, has_options: bool) -> void {
    self.has_options = has_options;
    // status = { phase: "ready", transport: "stdio", message: "Muse CLI ready" }
    self.status_phase_ptr = STR_PTR("ready");
    self.status_phase_len = STR_LEN("ready");
    self.status_transport_ptr = STR_PTR("stdio");
    self.status_transport_len = STR_LEN("stdio");
    self.status_message_ptr = STR_PTR("Muse CLI ready");
    self.status_message_len = STR_LEN("Muse CLI ready");
    self.has_status_message = true;
}

// getStatus(): EngineStatus — caller reads self.status_*.
fn MuseBridge_getStatus(self: &MuseBridge) -> void {
}

// DEFECT: async — TS `async start(): Promise<EngineStatus>` probes
