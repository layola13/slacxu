// DEFECT: dynamic object assembly — JSON text buffer output.
fn MuseBridge_childThreadSnapshot(self: &MuseBridge, threadId_ptr: ptr, threadId_len: u64, projection: &MuseChildSessionProjection, includeTurns: bool, out_ptr: &ptr, out_len: &u64) -> void {
}

