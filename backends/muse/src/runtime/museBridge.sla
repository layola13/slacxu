// else {phase: "ready", message: "Muse CLI v<version ?? "unknown"> ready"}.
fn MuseBridge_start(self: &MuseBridge) -> i32 {
    return 0;
}

// stop(): void — interrupt every session runtime, clear sessions,
// status {phase: "stopped", message: "Muse CLI stopped"}.
fn MuseBridge_stop(self: &MuseBridge) -> void {
}

// DEFECT: async — restart() = stop() then start().
fn MuseBridge_restart(self: &MuseBridge) -> i32 {
    MuseBridge_stop(self);
    return MuseBridge_start(self);
}

