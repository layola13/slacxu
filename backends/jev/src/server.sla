// Converted 1:1 from backends/jev/src/server.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
//
// JEV evaluation engine — server side (kind "service"). Owns the JEV
// upstream client and the native jev_* tool implementations
// (`src/jev/saVmJev.ts`, moved verbatim from the host) plus the
// OpenAI-bridge converter (`src/jev/jevOpenAiBridge.ts`). The host's
// SA-VM engine (saVmTool) and the workbench server import the engine
// from here via staging imports; shared JEV config state lives in the
// engine module itself, exactly as before the move.
//
// TS: import type { ServiceHost, ServicePlugin } from "@cxu/sdk-backend";
// ServiceHost / ServicePlugin are interface types from the
// sdk-backend unit; SLA has no interfaces, so the host handle is an
// opaque u64 and the plugin is the JevService struct + fn family.
// TS: export { JEV_MANIFEST } from "./manifest.js"; — re-export
// forwarding, mirrored by the @import below.
// TS: export * from "./jev/saVmJev.js"; export * from
// "./jev/jevOpenAiBridge.js"; — barrel re-exports, mirrored by the
// @imports below.
@import "./manifest.sla"
@import "./jev/saVmJev.sla"
@import "./jev/jevOpenAiBridge.sla"

// class JevService implements ServicePlugin.
// readonly manifest = JEV_MANIFEST — kept as the parsed manifest
// document handle (see manifest.sla).
struct JevService {
    manifest_doc: u64,
}

fn JevService_new(self: &JevService, manifest_doc: u64) -> void {
    self.manifest_doc = manifest_doc;
}

// DEFECT: async — TS `async start(_host: ServiceHost): Promise<void>`;
// converted to a synchronous fn returning a status code.
// The engine is stateless at the service layer: its config and
// rate-limit state live in saVmJev.ts and are driven by the host.
fn JevService_start(self: &JevService, host: u64) -> i32 {
    return 0;
}

// DEFECT: async — TS `async stop(): Promise<void>`.
fn JevService_stop(self: &JevService) -> i32 {
    return 0;
}

// export const jevServicePlugin: ServicePlugin = new JevService();
// Constructed by the host via JevService_new + JevService_start;
// there is no module-level singleton instance in SLA.
// DEFECT: module-level singleton instance; represented as an init
// function the host calls once.
fn jevServicePlugin_init(out: &JevService, manifest_doc: u64) -> void {
    JevService_new(out, manifest_doc);
}
