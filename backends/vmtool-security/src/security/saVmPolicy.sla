// Converted 1:1 from backends/vmtool-security/src/security/saVmPolicy.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
// Source imports: { isAbsolute, join, relative, resolve, sep } from "node:path";
//   { statSync } from "node:fs"; { tmpdir } from "node:os";
//   types { SaVmBunSubcommand, SaVmContextSavingsConfig, SaVmDeletePolicy,
//     SaVmFsEntry, SaVmHttpAllowRule, SaVmPolicyConfig, SaVmProcessExecRule } from "@codex-ui/shared";
//   { ALL_SA_VM_BUN_PROFILES, ALL_SA_VM_BUN_SUBCOMMANDS } from "@codex-ui/shared";
//   { codexUiDataDir } from "@cxu/sdk-backend";
//
// DEFECT: node:path / node:fs / node:os have no direct sa_std counterparts.
// Path normalization (resolve/join/relative/isAbsolute) is approximated by
// the local helpers at the bottom of this file (POSIX-style, lowercase +
// forward-slash like the source's policy space); statSync maps to
// sa_std_fs_* metadata; tmpdir()/process.env map to sa_env_get; the Windows
// path semantics (drive letters, sep) are only partially representable and
// are logged as defects. codexUiDataDir comes from the sdk-backend unit.

// ---------- shared shapes ----------
struct StrItem {
    bytes: [u8; 1024],
    len: u64,
}
struct StrList {
    items: [StrItem; 128],
    len: u64,
}

// SaVmPathOperation = "read" | "write" | "transfer" -> tag 0/1/2.
// SaVmDeletePolicy = "rename" | "move" | "deny" -> tag 0/1/2 (2 = deny).

struct SaVmFsEntry {
    path: [u8; 1024],
    path_len: u64,
    access: u32, // 0 = read, 1 = write, 2 = deny
}
struct FsEntryList {
    items: [SaVmFsEntry; 128],
    len: u64,
}

// From @codex-ui/shared (converted in the pkg units); field shape kept 1:1.
struct SaVmHttpAllowRule {
    host: [u8; 512],
    host_len: u64,
    methods: StrList,
    has_methods: bool,
    paths: StrList,
    has_paths: bool,
}
struct HttpRuleList {
    items: [SaVmHttpAllowRule; 128],
    len: u64,
}
struct SaVmProcessExecRule {
    path: [u8; 4096],
    path_len: u64,
    args: StrList,
    has_args: bool,
}
struct ExecRuleList {
    items: [SaVmProcessExecRule; 128],
    len: u64,
}

struct NormalizedFs {
    entries: FsEntryList,
    read: StrList,
    write: StrList,
    transfer: StrList,
    delete: u32, // SaVmDeletePolicy tag
    backupDir: [u8; 1024],
    backupDir_len: u64,
    backupDir_has: bool,
}
struct NormalizedProcess {
    spawn: bool,
    exec: ExecRuleList,
    bunProfiles: StrList,
    has_bunProfiles: bool,
    bun_enabled: bool,
    bun_allowedSubcommands: StrList,
    has_bun: bool,
}
struct NormalizedTools {
    replaceRead: bool,
    replaceWrite: bool,
    replaceApplyPatch: bool,
    replaceExec: bool,
    readFiles: bool,
    editFiles: bool,
    applyPatch: bool,
    fastSearch: bool,
    clearToolHistory: bool,
    findReferences: bool,
    renameSymbol: bool,
    fileOutline: bool,
    moveWithImports: bool,
    findDefinition: bool,
    extractToFile: bool,
    addImport: bool,
    getDiagnostics: bool,
    organizeImports: bool,
    analyzeScope: bool,
    codeGraph: bool,
}
// SaVmContextSavingsConfig (shared): booleans + optional positive numbers
// (u64 + has flag per optional number).
struct SaVmContextSavingsConfig {
    locateBeforeRead: bool,
    maxReadFileBytes: u64,
    maxReadFileBytes_has: bool,
    grepCircuitBreaker: bool,
    grepMaxResults: u64,
    grepMaxResults_has: bool,
    grepMaxTokens: u64,
    grepMaxTokens_has: bool,
    slimRunnerOutput: bool,
    parallelBudget: bool,
    parallelMaxTotalBytes: u64,
    parallelMaxTotalBytes_has: bool,
    parallelMaxReadFiles: u64,
    parallelMaxReadFiles_has: bool,
    parallelDeduplication: bool,
    tieredSkillInjection: bool,
    foldWaterfallEvents: bool,
    foldHistoryReadSummaries: bool,
    historyReadFoldTurns: u64,
    historyReadFoldTurns_has: bool,
}
struct NormalizedSaVmPolicy {
    engine: u32, // 0 = "native", 1 = "vm"
    fs: NormalizedFs,
    http_allow: HttpRuleList,
    env_allow: StrList,
    process: NormalizedProcess,
    execution_javascript: bool,
    execution_python: bool,
    tools: NormalizedTools,
    contextSavings: SaVmContextSavingsConfig,
    contextSavings_has: bool,
}

// SaVmPolicyDecision = { allowed: true; path } | { allowed: false; reason; path? }
struct SaVmPolicyDecision {
    allowed: bool,
    reason: [u8; 2048],
    reason_len: u64,
    path: [u8; 1024],
    path_len: u64,
    path_has: bool,
}

// ENHANCED_TOOLS_READ_ONLY (source lines 13-35, 18 names): Set<string> ->
// literal table + membership fn. Names in source order: read_file, read_lines,
// read_many, read_files, read_file_tail, count_lines, file_info, test_path,
// file_exists, exists, stat, find_files, list_dir, grep_search,
// grep_search_async, code_graph, relation_graph, symbol_graph.
// DEFECT: Set materialization in fix phase (same pattern as blocked-tools
// table in the free-mode unit).
fn ENHANCED_TOOLS_READ_ONLY_has(name_ptr: ptr, name_len: u64) -> bool {
    return false;
}

fn DEFAULT_ENV_at(idx: u64, out: &StrItem) -> bool {
    // DEFAULT_ENV = ["CWD", "PROJECT"]
    if idx == 0 { out.len = 3; return true; };
    if idx == 1 { out.len = 7; return true; };
    return false;
}
// DEFAULT_HTTP_METHODS = ["GET", "POST"]; MAX_POLICY_PATHS = 128.

// DEFECT: dynamic config object — SaVmPolicyConfig is consumed as a JSON doc
// handle (0 = undefined); every `config?.x.y` probe in the source maps to
// sa_json_object_get_* chains, and the `(config as any)` casts have no typed
// counterpart at all. The full probe order is preserved in the defect log.
fn normalizeSaVmPolicy(config_doc: u64, cwd_ptr: ptr, cwd_len: u64, additionalRoots: &StrList, out: &NormalizedSaVmPolicy) -> void {
    // Source flow (lines 76-166):
    //  root = resolve(cwd)
    //  configRoots = config.additionalRoots (any-cast) else config.fs.additionalRoots,
    //    filtered to non-empty strings
    //  defaultRoots = [root, ...allAdditionalRoots resolved against root]
    //  entries = fs.entries present ? normalizeEntries : legacyEntries
    //  additional roots (slice(1)) get implicit "<root>/**" read entries unless
    //    an identical rule exists or a deny glob covers them
    //  help roots (salaRoot config / CODEX_UI_SA_VM_SALA_DIR, SA_STD_DIR /
    //    CODEX_UI_SA_STD_DIR, join(codexUiDataDir(),"sa-vm"), tmpdir(), "/tmp",
    //    "C:/tmp") get implicit read entries unless denied
    //    DEFECT: process.env access -> sa_env_get; tmpdir -> env TMPDIR approx.
    //  read = dedupe(entries read|write paths); write = dedupe(write paths)
    //  transfer = normalizePatterns(fs.transfer, root, write)
    //  delete = fs.delete in {rename, move, deny} else "deny"
    //  backupDir = fs.backupDir (null -> null; string -> resolvePolicyPath)
    //  engine = config.engine == "vm" ? "vm" : "native"
    //  http.allow = normalizeHttpRules; env.allow = normalizeEnv
    //  process = { spawn: ==true, exec: normalizeExecRules,
    //              ...bunProfiles if non-empty, ...normalizeBunConfig }
    //  execution = { javascript: ==true, python: ==true }
    //  tools = each flag `!== false` (20 flags, source lines 141-162)
    //  contextSavings spread only when config.contextSavings present
}

fn normalizeContextSavings(value_doc: u64, out: &SaVmContextSavingsConfig, has: &bool) -> void {
    // Source: non-object -> undefined. Each boolean is `== true`; each number
    // kept only when typeof number && > 0 (else undefined -> has=false).
    // DEFECT: dynamic object probing via sa_json_object_get_*.
    has = false;
}

struct BunConfigResult {
    has_bun: bool,
    enabled: bool,
    allowedSubcommands: StrList,
}
fn normalizeBunConfig(value_doc: u64, value_kind: u32, out: &BunConfigResult) -> void {
    // value_kind: 0 = other/undefined ({}), 1 = true (all subcommands),
    // 2 = false (disabled, []), 3 = object { enabled !== false,
    // allowedSubcommands filtered to ALL_SA_VM_BUN_SUBCOMMANDS members, or all
    // when not an array }.
    // DEFECT: ALL_SA_VM_BUN_SUBCOMMANDS comes from @codex-ui/shared (pkg unit).
    out.has_bun = false;
}

fn normalizeBunProfiles(value_doc: u64, out: &StrList) -> void {
    // Source: non-array -> []; keep string entries present in
    // ALL_SA_VM_BUN_PROFILES, deduped. DEFECT: shared constant table (pkg unit).
    out.len = 0;
}

// DEFECT: regex ^(?:con|prn|aux|nul|com[1-9]|lpt[1-9])(?:\..*)?$ /i
// (WINDOWS_DEVICE_NAMES) — no regex engine in SLA; stub returns false.
fn isWindowsDeviceName(name_ptr: ptr, name_len: u64) -> bool {
    return false;
}

fn checkSaVmPath(policy: &NormalizedSaVmPolicy, operation: u32, candidate_ptr: ptr, candidate_len: u64, cwd_ptr: ptr, cwd_len: u64, out: &SaVmPolicyDecision) -> void {
    // Source flow:
    //  invalid (non-string/blank/NUL) -> deny "invalid path characters"
    //    (candidate is typed (ptr,len) here; the NUL/blank checks carry over)
    //  path = resolvePolicyPath(candidate, resolve(cwd))
    //  basename is a Windows device name -> deny "path targets reserved device name: <basename>" (+path)
    //  operation == "read": statSync(path) isFile/isDirectory -> allow
    //    (enhanced tools decoupled from sandbox for reads)
    //    DEFECT: statSync -> sa_std_fs metadata probe; try/catch -> status code.
    //  entries non-empty: access = resolveFsAccess(entries, path);
    //    deny -> deny "path is denied for <op>: '<candidate>'. Workspace root is '<cwd>'." (+path)
    //    read op allows access read|write; write/transfer require write
    //    else deny "path is not allowed for <op>: ..."
    //  fallback: pattern list per operation (read/write/transfer);
    //    matchesAny -> allow; else deny "path is not allowed ..."
    out.allowed = false;
    out.reason_len = 0;
    out.path_has = false;
}

fn checkSaVmDelete(policy: &NormalizedSaVmPolicy, candidate_ptr: ptr, candidate_len: u64, cwd_ptr: ptr, cwd_len: u64, out: &SaVmPolicyDecision) -> void {
    // Source flow: invalid -> deny; device name -> deny; delete == "deny" ->
    // deny "delete policy is deny"; entries: deny access -> deny; non-write
    // access (unless rename/move + transfer match) -> deny "path is not
    // writable for delete"; path must match transfer or write patterns ->
    // deny "path is not allowed for transfer"; rename/move requires backupDir
    // inside a writable root -> deny "delete backupDir must be inside a
    // writable policy root"; else allow.
    out.allowed = false;
    out.reason_len = 0;
    out.path_has = false;
}

fn checkSaVmHttp(policy: &NormalizedSaVmPolicy, url_ptr: ptr, url_len: u64, method_ptr: ptr, method_len: u64, out: &SaVmPolicyDecision) -> void {
    // Source flow: new URL(urlValue) catch -> deny "invalid URL"
    //   DEFECT: Web URL API — no URL parser extern in sa_std; parse scheme/
    //   host/path/credentials over the byte buffer in fix phase.
    //  method (trim+upper) must be GET or POST -> deny "HTTP method <m> is not allowed"
    //  username/password present or protocol != "https:" ->
    //    deny "only HTTPS URLs without credentials are allowed"
    //  any allow rule: hostMatches(hostname, rule.host) && methods (rule or
    //    DEFAULT_HTTP_METHODS, uppercased) include method && (no rule.paths
    //    or some globMatches(pathname, pattern))
    //  matched -> allow with path = parsed.toString()
    //  else deny "host, path, or method is not in the HTTP allowlist"
    out.allowed = false;
    out.reason_len = 0;
    out.path_has = false;
}

fn checkSaVmEnv(policy: &NormalizedSaVmPolicy, name_ptr: ptr, name_len: u64, out: &SaVmPolicyDecision) -> void {
    // policy.env.allow.includes(name) -> allow (path = name)
    // else deny "environment variable <name> is not allowed"
    out.allowed = false;
    out.reason_len = 0;
    out.path_has = false;
}

fn checkSaVmProcess(policy: &NormalizedSaVmPolicy, executable_ptr: ptr, executable_len: u64, args: &StrList, out: &SaVmPolicyDecision) -> void {
    // Source flow: trimmed executable empty -> deny "process executable is required"
    //  rules = exec rules where executableMatches(executable, rule.path)
    //  none -> deny "executable <e> is not in the process allowlist"
    //  no rule with (!rule.args || argsMatch(rule.args, args)) ->
    //    deny "arguments for <e> are not allowed"
    //  else allow (path = executable)
    out.allowed = false;
    out.reason_len = 0;
    out.path_has = false;
}

fn checkSaVmBunProfile(policy: &NormalizedSaVmPolicy, profile_ptr: ptr, profile_len: u64, out: &SaVmPolicyDecision) -> void {
    // Source: normalized = profile.trim().toLowerCase(); empty -> deny
    // "Bun profile is required"; not in policy.process.bunProfiles -> deny
    // "Bun profile <p> is not enabled in the VM policy. Enable it in Settings
    // -> VM Tools -> Fixed Project Check Profiles for this thread, then retry
    // via sa_vm_run run_project_check"; else allow (path = normalized).
    out.allowed = false;
    out.reason_len = 0;
    out.path_has = false;
}

fn checkSaVmBunExecution(policy: &NormalizedSaVmPolicy, bunBinary_ptr: ptr, bunBinary_len: u64, subcommand_ptr: ptr, subcommand_len: u64, args: &StrList, out: &SaVmPolicyDecision) -> void {
    // Source: if policy.process.bun present: disabled -> deny "Bun execution
    // is disabled in the VM policy"; allowedSubcommands non-empty and missing
    // subcommand -> deny "Bun subcommand '<s>' is not in the allowed list:
    // [<joined>]"; else allow (path = bunBinary).
    // Without bun config: delegate to checkSaVmProcess(policy, bunBinary,
    // [subcommand, ...args]).
    out.allowed = false;
    out.reason_len = 0;
    out.path_has = false;
}

fn isSaVmScriptExecutionAllowed(policy: &NormalizedSaVmPolicy, executable_ptr: ptr, executable_len: u64) -> bool {
    // Source: name = basename(lowercased, backslashes -> slashes);
    // isPython/isJavaScript/isBun via regexes (DEFECT: regex ->
    //   ^(?:python(?:\d+(?:\.\d+)?)?|py|pypy(?:\d+)?)(?:\.exe)?$
    //   ^(?:node(?:js)?|deno|ts-node|tsx|npx)(?:\.exe)?$
    //   ^bun(?:x)?(?:\.exe)?$)
    // return (isPython && execution.python) || (isJavaScript &&
    //   execution.javascript) || (isBun && bun?.enabled)
    return false;
}

// SaVmExecutionRequestKind = "bun" | "javascript" | "python" | "other" -> 0/1/2/3
struct ClassifyResult {
    kind: u32,
    isBun: bool,
    isJs: bool,
    isPy: bool,
}
struct ClassifyInput {
    action_doc: u64,      // each field is an `unknown` JSON node handle;
    language_doc: u64,    // string-ness/length probed via sa_json_string_*
    subcommand_doc: u64,
    args_doc: u64,
    test_file_doc: u64,
    filter_doc: u64,
    profile_doc: u64,
}
fn classifySaVmExecutionRequest(input: &ClassifyInput, out: &ClassifyResult) -> void {
    // Source precedence (lines 416-465): python first (action in
    // {run_py, run_python, exec_py, py, python} or lang in {py, python});
    // then bun (action run_bun | run_project_check, or action in {bun,
    // exec_bun} WITH any of subcommand/args/test_file/filter/profile
    // present); then javascript (long action set {run_js, exec_js, js,
    // javascript, node, bun, run_node, exec_node, exec_bun, eval_js} or lang
    // in {js, javascript, node, bun, ts, typescript}); else "other".
    // All comparisons are trim+lowercase string equalities — implementable
    // over the probed strings; bulk pass records the sets here.
    out.kind = 3;
    out.isBun = false;
    out.isJs = false;
    out.isPy = false;
}

fn classifyBunRequest(input: &ClassifyInput) -> bool {
    let r = ClassifyResult { kind: 3, isBun: false, isJs: false, isPy: false };
    classifySaVmExecutionRequest(input, &r);
    return r.isBun;
}

struct ArgvResult {
    executable: [u8; 1024],
    executable_len: u64,
    args: StrList,
    has: bool,
}
fn extractCommandArgv(value_doc: u64, value_is_array: bool, value_is_string: bool, out: &ArgvResult) -> void {
    // Source: array -> string entries only; empty -> null; else
    // { executable: entries[0], args: entries[1..] }.
    // String -> tokenize: value.trim().match(/(?:[^\s"']+|"[^"]*"|'[^']*')+/g)
    // with surrounding quotes stripped per token.
    // DEFECT: regex tokenizer — hand-written quote-aware scanner in fix
    // phase; DEFECT: dynamic value (unknown) via JSON node handles.
    out.has = false;
    out.executable_len = 0;
    out.args.len = 0;
}

// ---------- internal helpers (source order) ----------
fn normalizePatterns(value: &StrList, value_has: bool, cwd_ptr: ptr, cwd_len: u64, fallback: &StrList, out: &StrList) -> void {
    // Source: entries = value non-empty ? value : fallback mapped to
    // "<entry>/**" (unless ends with "*"); result = dedupe(first
    // MAX_POLICY_PATHS resolved via resolvePattern).
    out.len = 0;
}

fn legacyEntries(fsConfig_doc: u64, cwd_ptr: ptr, cwd_len: u64, defaultRoots: &StrList, out: &FsEntryList) -> void {
    // Source: read/write pattern lists from fs.read/fs.write with fallback
    // [defaultRoots[0]]; entries = read entries + write entries; when neither
    // fs.read nor fs.write configured, additional roots get read entries;
    // dedupeEntries at the end.
    out.len = 0;
}

fn normalizeEntries(value_doc: u64, cwd_ptr: ptr, cwd_len: u64, out: &FsEntryList) -> void {
    // Source: non-array -> []; first 128 entries; keep entries with a
    // non-blank string path and access in {read, write, deny}; path resolved
    // via resolvePattern; dedupeEntries.
    out.len = 0;
}

fn normalizeHttpRules(value_doc: u64, out: &HttpRuleList) -> void {
    // Source: non-array -> []; first 128; keep entries with non-blank string
    // host (trimmed, lowercased); methods = entry.methods or
    // DEFAULT_HTTP_METHODS, uppercased, filtered to GET/POST; paths kept
    // (first 64) only when non-empty.
    out.len = 0;
}

fn normalizeEnv(value: &StrList, value_has: bool, out: &StrList) -> void {
    // Source: source = value non-empty ? value : DEFAULT_ENV; keep entries
    // matching /^[A-Za-z_][A-Za-z0-9_]*$/ (DEFECT: regex — character-class
    // scan is directly implementable), first 64, deduped.
    out.len = 0;
}

fn normalizeExecRules(value_doc: u64, out: &ExecRuleList) -> void {
    // Source: non-array -> []; first 128; keep entries with non-blank string
    // path (trimmed, capped 4096 chars); args kept (first 64) only when
    // non-empty.
    out.len = 0;
}

fn resolvePattern(value_ptr: ptr, value_len: u64, cwd_ptr: ptr, cwd_len: u64, out: &StrItem) -> void {
    // Source: expanded = value.replace(/\$\{PROJECT\}|\$PROJECT/gi, cwd)
    //   .replace(/\\/g, "/");
    // if drive-letter or absolute -> lowercased expanded;
    // else resolve(cwd, expanded) with slashes + lowercase.
    // DEFECT: regex ${PROJECT} substitution + node:path resolve — byte-level
    // substitution and POSIX normalization in fix phase.
    out.len = 0;
}

fn resolvePolicyPath(value_ptr: ptr, value_len: u64, cwd_ptr: ptr, cwd_len: u64, out: &StrItem) -> void {
    // Source: ${PROJECT} expansion, then absolute ? resolve(it) :
    // resolve(cwd, it), slashes normalized, lowercased.
    out.len = 0;
}

fn matchesAny(path_ptr: ptr, path_len: u64, patterns: &StrList) -> bool {
    for i in 0..patterns.len {
        if globMatches(path_ptr, path_len, &patterns.items[i]) { return true; };
    }
    return false;
}

fn globMatches(value_ptr: ptr, value_len: u64, pattern: &StrItem) -> bool {
    // Source: builds a RegExp from the glob (** -> .*, * -> [^/]*, ? -> [^/],
    // other regex metachars escaped), case-insensitive, anchored; plus the
    // "/**" suffix also matches the bare prefix.
    // DEFECT: RegExp construction — a direct glob scanner implements the same
    // semantics without a regex engine (fix phase); bulk pass returns false.
    return false;
}

fn hostMatches(host_ptr: ptr, host_len: u64, pattern_ptr: ptr, pattern_len: u64) -> bool {
    // Source: lowercase both, strip leading "*." from pattern; equal or
    // host ends with "." + pattern. (Implementable byte-wise; bulk skeleton.)
    return false;
}

fn executableMatches(value_ptr: ptr, value_len: u64, pattern: &StrItem) -> bool {
    // Source: normalized (slashes, lowercase) equality; else when the pattern
    // has no "/", basename equality or basename == pattern + ".exe"; else
    // globMatches. (Skeleton; globMatches caveat applies.)
    return false;
}

fn argsMatch(patterns: &StrList, args: &StrList) -> bool {
    // Source: trailing "*" pattern -> args may be longer; otherwise lengths
    // must be equal; each fixed pattern globMatches the corresponding arg.
    return false;
}

fn dedupe(values: &StrList, out: &StrList) -> void {
    // Source: [...new Set(values)] — order-preserving byte-equality dedupe.
    out.len = 0;
}

fn dedupeEntries(entries: &FsEntryList, out: &FsEntryList) -> void {
    // Source: dedupe by `${access}:${path}` key, order-preserving.
    out.len = 0;
}

fn resolveFsAccess(entries: &FsEntryList, path_ptr: ptr, path_len: u64, out_access: &u32, has: &bool) -> void {
    // Source: matches = entries whose pattern fsPatternMatches(path);
    // none -> null; any deny -> "deny" (explicit safety boundary always
    // wins); else sort by patternSpecificity desc, write-before-read on ties;
    // return first access.
    has = false;
    out_access = 0;
}

fn patternSpecificity(pattern_ptr: ptr, pattern_len: u64) -> u64 {
    // Source: pattern minus trailing "/**" minus all [?*] chars, length.
    return 0;
}

fn fsPatternMatches(value_ptr: ptr, value_len: u64, pattern: &StrItem) -> bool {
    // Source: globMatches(value, pattern) || (pattern has no [?*] &&
    // (value == pattern || value starts with pattern-trimmed + "/")).
    return false;
}

fn pathWithin(root_ptr: ptr, root_len: u64, candidate_ptr: ptr, candidate_len: u64) -> bool {
    // Source: rest = relative(resolve(root), resolve(candidate)); within iff
    // rest == "" || (rest != ".." && !rest.startsWith(".." + sep) &&
    // !isAbsolute(rest)).
    // DEFECT: node:path relative/resolve/isAbsolute (see header defect).
    return false;
}
