@import "saVmPolicy.sla"

// String-out storage for `string | null` returns.
struct StrOut {
    bytes: [u8; 2048],
    len: u64,
    has: bool,
}

// SaVmScriptLanguage = "python" | "javascript" | "bun" — string union
// becomes an i32 tag: -1 = null, 0 = python, 1 = javascript, 2 = bun.
fn SaVmScriptLanguage_name(tag: i32, out: &StrOut) -> void {
    out.has = tag >= 0;
    out.len = 0;
    // DEFECT: tag -> literal name materialization in fix phase.
}

struct SaVmScriptToolRequest {
    language: i32,
    executable: [u8; 1024],
    executable_len: u64,
    args: [u8; 4096],
    args_len: u64,
    args_count: u64,
    reason: [u8; 128],
    reason_len: u64,
}

// SaVmInterceptionDecision discriminated union ->
// action tag: 0 = allow, 1 = deny, 2 = require_sa_vm.
struct SaVmInterceptionDecision {
    action: u32,
    reason: [u8; 2048],
    reason_len: u64,
    request: SaVmScriptToolRequest,
}

// DEFECT: regex — SLA/sa_std has no regex engine. Every RegExp test in this
// file (and saVmPolicy.sla) routes through this stub in the bulk pass; the
// pattern is identified by `pattern_id` and quoted at the call site. Returns
// false (the safe-deny side is chosen by callers' fall-through structure only
// where the source does so; see defect log).
fn re_test(pattern_id: u64, text_ptr: ptr, text_len: u64) -> bool {
    return false;
}

// DEFECT: from @cxu/sdk-backend (converted in the sdk-backend unit);
// declared here as an external predicate over the request text.
// fn isSystemWebSearchPermissionRequest(text_ptr, text_len) -> bool

// Returns the script language for a host executable, if it is Python, JS, or Bun.
fn saVmScriptLanguage(executable_ptr: ptr, executable_len: u64) -> i32 {
    // Source: name = executable.replace(/\\/g, "/").toLowerCase().split("/").at(-1) ?? ""
    // DEFECT: string replace/toLowerCase/split — basename extraction over the
    // byte buffer in fix phase.
    // DEFECT: regex ^(?:python(?:\d+(?:\.\d+)?)?|py|pypy(?:\d+)?)(?:\.exe)?$ -> re_test(1, ...)
    if re_test(1, executable_ptr, executable_len) { return 0; };
    // DEFECT: regex ^(?:bun(?:x)?)(?:\.exe)?$ -> re_test(2, ...)
    if re_test(2, executable_ptr, executable_len) { return 2; };
    // DEFECT: regex ^(?:node(?:js)?|deno|ts-node|tsx|npx)(?:\.exe)?$ -> re_test(3, ...)
    if re_test(3, executable_ptr, executable_len) { return 1; };
    return -1;
}

fn isSaVmScriptExecutable(executable_ptr: ptr, executable_len: u64, is_string: bool) -> bool {
    if !is_string { return false; };
    return saVmScriptLanguage(executable_ptr, executable_len) != -1;
}

fn str_eq_lit(a_ptr: ptr, a_len: u64, lit_ptr: ptr, lit_len: u64) -> bool {
    if a_len != lit_len { return false; };
    for i in 0..a_len {
        let x: u8 = 0;
        let y: u8 = 0;
        PTR_BYTE_AT(x, a_ptr, i);
        PTR_BYTE_AT(y, lit_ptr, i);
        if x != y { return false; };
    }
    return true;
}

fn isSaVmDirectCommandMethod(method_ptr: ptr, method_len: u64) -> bool {
    if str_eq_lit(method_ptr, method_len, STR_PTR("command/exec"), STR_LEN("command/exec")) { return true; };
    if str_eq_lit(method_ptr, method_len, STR_PTR("command/exec/write"), STR_LEN("command/exec/write")) { return true; };
    if str_eq_lit(method_ptr, method_len, STR_PTR("command/exec/terminate"), STR_LEN("command/exec/terminate")) { return true; };
    if str_eq_lit(method_ptr, method_len, STR_PTR("command/exec/resize"), STR_LEN("command/exec/resize")) { return true; };
    if str_eq_lit(method_ptr, method_len, STR_PTR("thread/shellCommand"), STR_LEN("thread/shellCommand")) { return true; };
    if str_eq_lit(method_ptr, method_len, STR_PTR("item/commandExecution/requestApproval"), STR_LEN("item/commandExecution/requestApproval")) { return true; };
    if str_eq_lit(method_ptr, method_len, STR_PTR("execCommandApproval"), STR_LEN("execCommandApproval")) { return true; };
    if str_eq_lit(method_ptr, method_len, STR_PTR("applyPatchApproval"), STR_LEN("applyPatchApproval")) { return true; };
    return false;
}

// DEFECT: dynamic object — asRecord(params: unknown) over a JSON doc handle
// (same approximation as the free-mode unit).
fn asRecord(value_doc: u64, value_is_object: bool, value_is_array: bool) -> u64 {
    if value_is_object && !value_is_array { return value_doc; };
    return 0;
}

// Identifies a real host command/tool invocation. Plain model text is not
// inspected, so asking the model to write Python or JavaScript remains safe.
// DEFECT: params is `unknown` — a JSON doc handle; dynamic member probes
// (record.command ?? record.cmd ?? record.argv, tool-name candidate chain
// [record.tool, record.toolName, record.name, record.item.tool,
// record.item.name].find(string)) go through sa_json_object_get_* in source
// order. Returns has=true on a hit.
fn classifySaVmScriptToolRequest(method_ptr: ptr, method_len: u64, params_doc: u64, out: &SaVmScriptToolRequest, has: &bool) {
    has = false;
    // Command methods: parse argv via extractCommandArgv (saVmPolicy.sla);
    // language = saVmScriptLanguage(parsed.executable); if the executable is
    // a shell (bash|sh|zsh|cmd|powershell|pwsh — DEFECT: regex -> re_test(4)),
    // scan joined args for python/bun/node mentions
    // (DEFECT: regexes -> re_test(5..7)) and classify accordingly.
    // Tool-name path: cleanTool basename -> saVmScriptLanguage, else literal
    // name sets (run_py|exec_py|run_python|python), (run_bun|exec_bun|bun),
    // (run_js|exec_js|run_node|javascript|js|node) — DEFECT: regexes ->
    // re_test(8..10). Reason literal on every hit:
    // "direct-script-execution-requires-sa-vm".
}

// Detects common PowerShell anti-patterns and returns specific guidance
// pointing to equivalent native sa_vm_run actions. out.has=false means null.
// The source is an ordered chain of ~24 regex tests, each returning a fixed
// guidance literal (preserved verbatim in the fix-phase table). Bulk pass:
// each branch is a re_test stub in source order; the guidance literals are:
//  1 vm-read missing            13 Format-*/Out-String
//  2 git via subprocess/bun -e  14 Select-String
//  3 .git internals             15 Where-Object pipeline
//  4 for/foreach loops          16 which/where.exe
//  5 ';' chained file ops       17 find with -name/-type
//  6 cmd /c wrapper             18 rg/grep/findstr
//  7 cd/Set-Location            19 head/tail truncation
//  8 && chaining                20 Select -First/-Last
//  9 Get-Process/ps             21 -ErrorAction SilentlyContinue
// 10 Get-Date/date              22 2>$null / Out-Host / 2>&1
// 11 (reserved)                 23 '>'/'>>' redirection
// 12 Format-* (see 13)          24 Set-Content/Out-File piping
// 25 Test-Path                  26 Get-ChildItem/dir/ls
// 27 Get-Content/gc/cat/type    28 git <verb> direct
// 29 bun/node/python/zig shell invocation with help/build/test/version
// DEFECT: regex — all branches route through re_test(100 + branch_no).
fn detectPowerShellAntiPattern(cmd_ptr: ptr, cmd_len: u64, out: &StrOut) -> void {
    out.has = false;
    out.len = 0;
    if cmd_len == 0 { return; };
    for branch in 1..30 {
        if re_test(100 + branch, cmd_ptr, cmd_len) {
            out.has = true;
            // DEFECT: guidance literal for `branch` selected from the
            // fix-phase table (literals in the .ts source, lines 129-208).
            return;
        };
    }
}

struct InterceptInput {
    cwd: [u8; 1024],
    cwd_len: u64,
    additionalRoots_doc: u64, // JSON array handle, 0 = none
    policy_doc: u64,          // SaVmPolicyConfig as JSON doc handle, 0 = undefined
}

// Deterministic broker decision used by tests and request routing. Host
// Python/Node execution is never allowed directly, even when the legacy UI
// execution toggle is enabled; callers must submit an `sa_vm_run` request.
fn interceptSaVmRequest(method_ptr: ptr, method_len: u64, params_doc: u64, input: &InterceptInput, out: &SaVmInterceptionDecision) -> void {
    // 1. script = classifySaVmScriptToolRequest(method, params)
    //    -> { action: "require_sa_vm", request: script }
    // 2. Direct command methods: fullCmd = command/cmd/argv joined;
    //    antiPattern = detectPowerShellAntiPattern(fullCmd)
    //    -> deny with "direct host command execution is disabled in SA-VM
    //       mode; use sa_vm_run" (+ ". Prohibited shell anti-pattern
    //       detected: <antiPattern>" when present).
    // 3. Web-search bypass: text = [query, prompt, text, url] strings joined;
    //    isSystemWebSearchPermissionRequest(text) && url not http(s)://
    //    -> allow "web-search-bypass". DEFECT: SDK predicate (see above) +
    //    regex ^https?:// -> re_test(200).
    // 4. policy = normalizeSaVmPolicy(input.policy, input.cwd, input.additionalRoots ?? [])
    // 5. Method table (string equality, in source order):
    //    gitDiffToRemote -> deny "gitDiffToRemote requires an explicit git argv allowlist"
    //    applyPatchApproval -> deny "native apply_patch is disabled in SA-VM mode; use packaged sa_vm_run tools"
    //    item/fileChange/requestApproval -> deny "native file change/apply_patch execution is disabled in SA-VM mode; use packaged sa_vm_run tools"
    //    fs/readFile|fs/readDirectory|fs/getMetadata|fs/watch -> checkSaVmPath(policy,"read",path,cwd)
    //    fs/writeFile|fs/createDirectory|fs/mkdir -> checkSaVmPath(policy,"write",...)
    //    fs/copy -> read(source) then write(destination)
    //    fs/rename|fs/move -> checkSaVmDelete(source) then checkSaVmPath(write, destination)
    //    fs/remove|fs/delete|fs/deleteFile|fs/removeFile (+rename/move dup) -> checkSaVmDelete(path)
    //    network/request|http/request|fetch -> checkSaVmHttp(policy, url, method ?? "GET")
    //    fuzzyFileSearch -> every root must pass checkSaVmPath "read"
    //    mcpServer/tool/call|mcpServer/resource/read -> deny "MCP host tools/resources are disabled in SA-VM mode; use policy-approved sa_vm_run actions"
    //    default -> allow "not-a-tool"
    //    Allowed policy checks map to allow "policy-allowed"; denied ones to
    //    deny with decision.reason. Missing required fields deny with the
    //    source's literal reasons ("filesystem path is required", "copy
    //    sourcePath and destinationPath are required", "rename source and
    //    destination paths are required", "network URL is required",
    //    "search roots are required").
    // DEFECT: dynamic params probing (record.path/sourcePath/destination/
    // oldPath/newPath/to/url/method/roots spellings) via sa_json_object_get_*
    // in source precedence order — full chain in the defect log.
    out.action = 0;
    out.reason_len = 0;
}
