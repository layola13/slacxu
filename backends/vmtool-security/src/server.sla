// Converted 1:1 from backends/vmtool-security/src/server.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
//
// VM tool security — server side (kind "service"). Owns the SA-VM
// security policy engine (`src/security/saVmPolicy.ts`: path/command/
// network allow rules, bun profiles) and the interception checks
// (`src/security/saVmInterception.ts`), moved verbatim from the
// host. The SA-VM engine files (saVmTool, saVmApplyPatch,
// saVmCodeGraph, saVmSplitWorkflow, gitWorkspace, index) consume
// them via explicit staging imports; the policy store location
// still comes from the host's localDatabase (staging edge).

@import "manifest.sla"
// Re-export forwarding (source: export { VMTOOL_SECURITY_MANIFEST } from "./manifest.js";
// export * from "./security/saVmPolicy.js"; export * from "./security/saVmInterception.js";)
@import "security/saVmPolicy.sla"
@import "security/saVmInterception.sla"

// DEFECT: TS class + interface (ServicePlugin from @cxu/sdk-backend) — no
// classes/interfaces in SLA; class becomes a struct + function family with
// &Struct first parameter, method names preserved.
struct VmToolSecurityService {
    manifest: VmToolSecurityManifest,
}

// DEFECT: async start(_host: ServiceHost): Promise<void> — converted to a
// synchronous function returning a status code (0 = ok).
// Pure policy/check library at the service layer; the host's
// SA-VM engine drives it per tool call, as before the move.
fn VmToolSecurityService_start(self: &VmToolSecurityService, host: u64) -> i32 {
    return 0;
}

// DEFECT: async stop(): Promise<void> — synchronous status-code form.
fn VmToolSecurityService_stop(self: &VmToolSecurityService) -> i32 {
    return 0;
}

// Source: export const vmToolSecurityServicePlugin: ServicePlugin = new VmToolSecurityService();
// DEFECT: module-level singleton instance; represented as an init function the
// host calls once (no module-level mutable state in SLA).
fn vmToolSecurityServicePlugin_init(out: &VmToolSecurityService) -> void {
    out.manifest.json_len = 0;
}
