// Converted 1:1 from backends/agy/src/runtime/agySessionStore.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
//
// Persists Antigravity (AGY) CLI session and conversation
// metadata separately from Codex thread IDs. This allows history
// to remain readable after a server restart, and enables
// resuming existing conversations using --conversation.
//
// Schema: one row per internal thread ID that uses the AGY
// backend.
//
// DEFECT: RuntimeDatabase (@cxu/sdk-backend) prepare/run/get/
// all/exec — a prepared-statement SQLite surface. The SLA side
// keeps the SQL text verbatim and routes through db_* shims in
// this file; the real binding (sdk-backend RuntimeDatabase or a
// std sqlite surface) is fixed in the repair phase.
// DEFECT: Date.now() — no verified std wall-clock extern; now
// values come through db_now_ms() shim.
// DEFECT: nullable string columns — (ptr,len) + has_ flags;
// query results materialize into caller-owned row buffers
// (AgySessionRow slots), lifetime owned by the store struct.

// AgySessionRecord (interface) — one record.
@import "sa_std/string.sa"
@import "sa_std/encoding/json.sai"
@import "sa_std/time.sai"
@import "sa_std/globals.sai"
@import "sa_std/plugin_sqlite.sa"
@import "sa_std/ptr.sa"

struct AgySessionRecord {
    threadId_ptr: ptr,
    threadId_len: u64,
    ownerId_ptr: ptr,
    ownerId_len: u64,
    has_conversationId: bool,
    conversationId_ptr: ptr,
    conversationId_len: u64,
    has_cliVersion: bool,
    cliVersion_ptr: ptr,
    cliVersion_len: u64,
    has_model: bool,
    model_ptr: ptr,
    model_len: u64,
    has_cwd: bool,
    cwd_ptr: ptr,
    cwd_len: u64,
    has_permissionMode: bool,
    permissionMode_ptr: ptr,
    permissionMode_len: u64,
    has_stateJson: bool,
    stateJson_ptr: ptr,
    stateJson_len: u64,
    createdAt: u64,
    updatedAt: u64,
}

// AgySessionRow — the snake_case row shape; same fields, the
// mapping is 1:1 so one struct serves both (TS keeps two nominal
// types; mapRow below is the identity field copy).
struct AgySessionStore {
    db: u64,
    rowbuf: [u8; 1048576],
}

fn AgySessionStore_new(self: &AgySessionStore, db: u64) -> void {
    self.db = db;
    db_exec(self.db, STR_PTR("CREATE TABLE IF NOT EXISTS agy_sessions (thread_id TEXT NOT NULL, owner_id TEXT NOT NULL, conversation_id TEXT, cli_version TEXT, model TEXT, cwd TEXT, permission_mode TEXT, state_json TEXT, created_at INTEGER NOT NULL, updated_at INTEGER NOT NULL, PRIMARY KEY (thread_id, owner_id))"), STR_LEN("CREATE TABLE IF NOT EXISTS agy_sessions (thread_id TEXT NOT NULL, owner_id TEXT NOT NULL, conversation_id TEXT, cli_version TEXT, model TEXT, cwd TEXT, permission_mode TEXT, state_json TEXT, created_at INTEGER NOT NULL, updated_at INTEGER NOT NULL, PRIMARY KEY (thread_id, owner_id))"));
    // try { ALTER TABLE ... ADD COLUMN state_json } catch {}
    // DEFECT: try/catch — error deliberately ignored, the shim
    // folds failure into its return code which is dropped here.
    db_exec(self.db, STR_PTR("ALTER TABLE agy_sessions ADD COLUMN state_json TEXT"), STR_LEN("ALTER TABLE agy_sessions ADD COLUMN state_json TEXT"));
}

// upsert(input): the COALESCE-preserving insert. Optional input
// fields arrive as has_ flags on `input`; existing values are
// read first (this.get) exactly like the source.
// DEFECT: the SQL is kept verbatim; parameter binding order is
// (threadId, ownerId, conversationId, cliVersion, model, cwd,
// permissionMode, stateJson, createdAt, updatedAt) via db_run10.
fn AgySessionStore_upsert(self: &AgySessionStore, input: &AgySessionRecord, out: &AgySessionRecord, out_ok: &bool) -> void {
    let now = db_now_ms();
    let existing = AgySessionRecord { threadId_ptr: PTR_NULL(), threadId_len: 0, ownerId_ptr: PTR_NULL(), ownerId_len: 0, has_conversationId: false, conversationId_ptr: PTR_NULL(), conversationId_len: 0, has_cliVersion: false, cliVersion_ptr: PTR_NULL(), cliVersion_len: 0, has_model: false, model_ptr: PTR_NULL(), model_len: 0, has_cwd: false, cwd_ptr: PTR_NULL(), cwd_len: 0, has_permissionMode: false, permissionMode_ptr: PTR_NULL(), permissionMode_len: 0, has_stateJson: false, stateJson_ptr: PTR_NULL(), stateJson_len: 0, createdAt: 0, updatedAt: 0 };
    let has_existing = false;
    AgySessionStore_get(self, input.ownerId_ptr, input.ownerId_len, input.threadId_ptr, input.threadId_len, &existing, &has_existing);
    // value = input.field ?? existing?.field ?? null — per field:
    // the resolved values ride in `res` (borrowed from input or
    // existing); db_run10 takes (has, ptr, len) triples.
    let res = AgySessionRecord { threadId_ptr: PTR_NULL(), threadId_len: 0, ownerId_ptr: PTR_NULL(), ownerId_len: 0, has_conversationId: false, conversationId_ptr: PTR_NULL(), conversationId_len: 0, has_cliVersion: false, cliVersion_ptr: PTR_NULL(), cliVersion_len: 0, has_model: false, model_ptr: PTR_NULL(), model_len: 0, has_cwd: false, cwd_ptr: PTR_NULL(), cwd_len: 0, has_permissionMode: false, permissionMode_ptr: PTR_NULL(), permissionMode_len: 0, has_stateJson: false, stateJson_ptr: PTR_NULL(), stateJson_len: 0, createdAt: 0, updatedAt: 0 };
    resolve_field(input.has_conversationId, input.conversationId_ptr, input.conversationId_len, has_existing && existing.has_conversationId, existing.conversationId_ptr, existing.conversationId_len, &res.has_conversationId, &res.conversationId_ptr, &res.conversationId_len);
    resolve_field(input.has_cliVersion, input.cliVersion_ptr, input.cliVersion_len, has_existing && existing.has_cliVersion, existing.cliVersion_ptr, existing.cliVersion_len, &res.has_cliVersion, &res.cliVersion_ptr, &res.cliVersion_len);
    resolve_field(input.has_model, input.model_ptr, input.model_len, has_existing && existing.has_model, existing.model_ptr, existing.model_len, &res.has_model, &res.model_ptr, &res.model_len);
    resolve_field(input.has_cwd, input.cwd_ptr, input.cwd_len, has_existing && existing.has_cwd, existing.cwd_ptr, existing.cwd_len, &res.has_cwd, &res.cwd_ptr, &res.cwd_len);
    resolve_field(input.has_permissionMode, input.permissionMode_ptr, input.permissionMode_len, has_existing && existing.has_permissionMode, existing.permissionMode_ptr, existing.permissionMode_len, &res.has_permissionMode, &res.permissionMode_ptr, &res.permissionMode_len);
    resolve_field(input.has_stateJson, input.stateJson_ptr, input.stateJson_len, has_existing && existing.has_stateJson, existing.stateJson_ptr, existing.stateJson_len, &res.has_stateJson, &res.stateJson_ptr, &res.stateJson_len);
    let created = now;
    if has_existing { created = existing.createdAt; };
    db_run_upsert(self.db, input, &res, created, now);
    // return this.get(input.ownerId, input.threadId)!
    AgySessionStore_get(self, input.ownerId_ptr, input.ownerId_len, input.threadId_ptr, input.threadId_len, out, out_ok);
}

fn AgySessionStore_get(self: &AgySessionStore, ownerId_ptr: ptr, ownerId_len: u64, threadId_ptr: ptr, threadId_len: u64, out: &AgySessionRecord, out_ok: &bool) -> void {
    // SELECT * FROM agy_sessions WHERE thread_id = ? AND owner_id = ? LIMIT 1
    // (bind order in the source call is (threadId, ownerId).)
    let cap_p25115: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p25115, &self.rowbuf, 0);
    *out_ok = db_get_by_thread_owner(self.db, threadId_ptr, threadId_len, ownerId_ptr, ownerId_len, cap_p25115, 1048576, out);
}

fn AgySessionStore_listByOwner(self: &AgySessionStore, ownerId_ptr: ptr, ownerId_len: u64, out_count: &u64) -> void {
    // SELECT * FROM agy_sessions WHERE owner_id = ? ORDER BY updated_at DESC
    // DEFECT: rows.map(mapRow) materialization — the shim writes
    // rows into the store rowbuf and reports the count; callers
    // read them back per index via db_row_at (repair phase).
    let cap_p25116: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p25116, &self.rowbuf, 0);
    *out_count = db_all_by_owner(self.db, ownerId_ptr, ownerId_len, cap_p25116, 1048576);
}

fn AgySessionStore_delete(self: &AgySessionStore, threadId_ptr: ptr, threadId_len: u64, ownerId_ptr: ptr, ownerId_len: u64) -> bool {
    // DELETE FROM agy_sessions WHERE thread_id = ? AND owner_id = ?
    return db_run_changes(self.db, STR_PTR("DELETE FROM agy_sessions WHERE thread_id = ? AND owner_id = ?"), STR_LEN("DELETE FROM agy_sessions WHERE thread_id = ? AND owner_id = ?"), threadId_ptr, threadId_len, ownerId_ptr, ownerId_len) > 0;
}

fn AgySessionStore_deleteByThread(self: &AgySessionStore, threadId_ptr: ptr, threadId_len: u64) -> u64 {
    // DELETE FROM agy_sessions WHERE thread_id = ?
    return db_run_changes1(self.db, STR_PTR("DELETE FROM agy_sessions WHERE thread_id = ?"), STR_LEN("DELETE FROM agy_sessions WHERE thread_id = ?"), threadId_ptr, threadId_len);
}

fn AgySessionStore_findByConversationId(self: &AgySessionStore, conversationId_ptr: ptr, conversationId_len: u64, out: &AgySessionRecord, out_ok: &bool) -> void {
    // SELECT * FROM agy_sessions WHERE conversation_id = ? LIMIT 1
    let cap_p25117: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p25117, &self.rowbuf, 0);
    *out_ok = db_get_by_conversation(self.db, conversationId_ptr, conversationId_len, cap_p25117, 1048576, out);
}

// getMetadata: Pick<threadId|ownerId|conversationId|model|cwd>
// SELECT thread_id, owner_id, conversation_id, model, cwd ...
// The record struct carries all fields; the metadata queries
// fill only the picked ones (others stay empty here).
fn AgySessionStore_getMetadata(self: &AgySessionStore, ownerId_ptr: ptr, ownerId_len: u64, threadId_ptr: ptr, threadId_len: u64, out: &AgySessionRecord, out_ok: &bool) -> void {
    let cap_p25118: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p25118, &self.rowbuf, 0);
    *out_ok = db_get_meta_by_thread_owner(self.db, threadId_ptr, threadId_len, ownerId_ptr, ownerId_len, cap_p25118, 1048576, out);
}

fn AgySessionStore_findMetadataByConversationId(self: &AgySessionStore, conversationId_ptr: ptr, conversationId_len: u64, out: &AgySessionRecord, out_ok: &bool) -> void {
    let cap_p25119: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p25119, &self.rowbuf, 0);
    *out_ok = db_get_meta_by_conversation(self.db, conversationId_ptr, conversationId_len, cap_p25119, 1048576, out);
}

fn AgySessionStore_findByThreadId(self: &AgySessionStore, threadId_ptr: ptr, threadId_len: u64, out: &AgySessionRecord, out_ok: &bool) -> void {
    // SELECT * FROM agy_sessions WHERE thread_id = ? LIMIT 1
    let cap_p25120: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_p25120, &self.rowbuf, 0);
    *out_ok = db_get_by_thread(self.db, threadId_ptr, threadId_len, cap_p25120, 1048576, out);
}

// mapRow(row): snake_case row -> camelCase record. The two
// structs are field-identical in this conversion, so mapRow is
// the identity copy (kept as a fn for 1:1 correspondence).
fn mapRow(row: &AgySessionRecord, out: &AgySessionRecord) -> void {
    *out = *row;
}

// ---- db shims (DEFECT: RuntimeDatabase surface) ----

fn resolve_field(in_has: bool, in_ptr: ptr, in_len: u64, ex_has: bool, ex_ptr: ptr, ex_len: u64, out_has: &bool, out_ptr: &ptr, out_len: &u64) -> void {
    if in_has {
        *out_has = true;
        *out_ptr = in_ptr;
        *out_len = in_len;
        return;
    };
    if ex_has {
        *out_has = true;
        *out_ptr = ex_ptr;
        *out_len = ex_len;
        return;
    };
    *out_has = false;
    *out_len = 0;
}

// ---------------------------------------------------------------------------
// SQLite binding layer (licenseStore / claudeSessionStore model,
// agy_ prefix): SA_SQLITE_* macros over the facade; row JSON from
// SA_SQLITE_STEP_JSON is cached per statement in a global u64
// cell keyed "sqlite.doc.<stmt>"; columns are read by INDEX
// (SELECT * order = table definition order). Record strings are
// materialized into the store rowbuf; record (ptr, len) fields
// point into it.
// ---------------------------------------------------------------------------

struct AgyKeyBuf {
    bytes: [u8; 64],
    len: u64,
}

fn agy_key_append( b: &AgyKeyBuf, src: ptr, src_len: u64) -> void {
    let i: u64 = 0;
    while i < src_len && b.len < 64 {
        let v: u8 = 0;
        PTR_BYTE_AT(v, src, i);
        b.bytes[b.len] = v;
        b.len = b.len + 1;
        i = i + 1;
    }
}

fn agy_key_append_u64(b: &AgyKeyBuf, v: u64) -> void {
    if v >= 10 { agy_key_append_u64(b, v / 10); };
    let d: u8 = 48 + ((v % 10) as u8);
    if b.len < 64 { b.bytes[b.len] = d; b.len = b.len + 1; };
}

fn agy_row_key(out: &AgyKeyBuf, stmt: u64) -> void {
    out.len = 0;
    agy_key_append(out, STR_PTR("sqlite.doc."), STR_LEN("sqlite.doc."));
    agy_key_append_u64(out, stmt);
}

fn agy_row_doc(stmt: u64) -> u64 {
    let key = AgyKeyBuf { bytes: [0u8; 64], len: 0 };
    agy_row_key(&key, stmt);
    let kp: ptr = PTR_NULL();
    PTR_BYTE_ADD(kp, &key.bytes, 0);
    let doc: u64 = 0;
    let ig = sa_global_u64_get(kp, key.len, &doc);
    return doc;
}

fn agy_set_row_doc(stmt: u64, doc: u64) -> void {
    let key = AgyKeyBuf { bytes: [0u8; 64], len: 0 };
    agy_row_key(&key, stmt);
    let kp: ptr = PTR_NULL();
    PTR_BYTE_ADD(kp, &key.bytes, 0);
    let ig = sa_global_u64_set(kp, key.len, doc);
}

fn agy_column_node(stmt: u64, idx: u64) -> u64 {
    let doc = agy_row_doc(stmt);
    if doc == 0 { return 0; };
    let kp: ptr = PTR_NULL();
    let kl: u64 = 0;
    if sa_json_object_key_at(doc, idx, &kp, &kl) != 0 { return 0; };
    let node: u64 = 0;
    if sa_json_object_get(doc, kp, kl, &node) != 0 { return 0; };
    return node;
}

fn agy_prepare(db: u64, sql_ptr: ptr, sql_len: u64) -> u64 {
    let st: u64 = 0;
    let stmt: u64 = 0;
    SA_SQLITE_PREPARE(st, stmt, db, sql_ptr, sql_len);
    return stmt;
}

fn agy_bind_text(stmt: u64, idx: u64, val_ptr: ptr, val_len: u64) -> void {
    let st: u64 = 0;
    SA_SQLITE_BIND_TEXT(st, stmt, idx, val_ptr, val_len);
}

fn agy_bind_null(stmt: u64, idx: u64) -> void {
    let st: u64 = 0;
    SA_SQLITE_BIND_NULL(st, stmt, idx);
}

fn agy_bind_int(stmt: u64, idx: u64, value: u64) -> void {
    let st: u64 = 0;
    SA_SQLITE_BIND_INT(st, stmt, idx, value);
}

fn agy_bind_text_or_null(stmt: u64, idx: u64, has: bool, val_ptr: ptr, val_len: u64) -> void {
    if has {
        agy_bind_text(stmt, idx, val_ptr, val_len);
    } else {
        agy_bind_null(stmt, idx);
    };
}

// Step once; on a row, cache its JSON document and (optionally)
// expose the raw row JSON text.
fn agy_step(stmt: u64, raw_ptr: &ptr, raw_len: &u64) -> bool {
    let old = agy_row_doc(stmt);
    if old != 0 {
        let ig = sa_json_free(old);
        agy_set_row_doc(stmt, 0);
    };
    let st: u64 = 0;
    let ready: u64 = 0;
    let rp: ptr = PTR_NULL();
    let rl: u64 = 0;
    SA_SQLITE_STEP_JSON(st, ready, rp, rl, stmt);
    *raw_ptr = rp;
    *raw_len = rl;
    if ready == 0 { return false; };
    let doc = sa_json_parse(rp, rl);
    agy_set_row_doc(stmt, doc);
    return doc != 0;
}

fn agy_finalize(stmt: u64) -> void {
    let old = agy_row_doc(stmt);
    if old != 0 {
        let ig = sa_json_free(old);
        agy_set_row_doc(stmt, 0);
    };
    let st: u64 = 0;
    SA_SQLITE_FINALIZE(st, stmt);
}

fn agy_column_is_null(stmt: u64, idx: u64) -> bool {
    let node = agy_column_node(stmt, idx);
    if node == 0 { return true; };
    return sa_json_kind(node) == 0;
}

fn agy_column_int(stmt: u64, idx: u64) -> u64 {
    let node = agy_column_node(stmt, idx);
    if node == 0 { return 0; };
    let v: i64 = 0;
    if sa_json_as_i64(node, &v) != 0 { return 0; };
    return v as u64;
}

fn agy_changes(db: u64) -> u64 {
    let stmt = agy_prepare(db, STR_PTR("SELECT changes()"), STR_LEN("SELECT changes()"));
    if stmt == 0 { return 0; };
    let rp: ptr = PTR_NULL();
    let rl: u64 = 0;
    let n: u64 = 0;
    if agy_step(stmt, &rp, &rl) { n = agy_column_int(stmt, 0); };
    agy_finalize(stmt);
    return n;
}

// Copy one text column into the rowbuf at the cursor; set the
// record field to the materialized span.
fn agy_fill_text(stmt: u64, idx: u64, rowbuf: ptr, cursor: &u64, out_ptr: &ptr, out_len: &u64, out_has: &bool) -> void {
    *out_ptr = PTR_NULL();
    *out_len = 0;
    *out_has = false;
    if agy_column_is_null(stmt, idx) { return; };
    let node = agy_column_node(stmt, idx);
    if node == 0 { return; };
    if sa_json_kind(node) != 5 { return; };
    let sp: ptr = PTR_NULL();
    sp = sa_json_string_ptr(node);
    let sl = sa_json_string_len(node);
    let n = sl;
    if (*cursor) + n > 1048576 { n = 1048576 - (*cursor); };
    let dst: ptr = PTR_NULL();
    PTR_BYTE_ADD(dst, rowbuf, (*cursor));
    let i: u64 = 0;
    while i < n {
        let v: u8 = 0;
        PTR_BYTE_AT(v, sp, i);
        let wp: ptr = PTR_NULL();
        PTR_BYTE_ADD(wp, dst, i);
        PTR_WRITE_U8(wp, v);
        i = i + 1;
    }
    *out_ptr = dst;
    *out_len = n;
    *out_has = true;
    *cursor = (*cursor) + n;
}

// SELECT * column order: thread_id 0, owner_id 1,
// conversation_id 2, cli_version 3, model 4, cwd 5,
// permission_mode 6, state_json 7, created_at 8, updated_at 9.
fn agy_fill_record(stmt: u64, rowbuf: ptr, out: &AgySessionRecord) -> void {
    let cursor: u64 = 0;
    let has0 = false;
    agy_fill_text(stmt, 0, rowbuf, &cursor, &out.threadId_ptr, &out.threadId_len, &has0);
    let has1 = false;
    agy_fill_text(stmt, 1, rowbuf, &cursor, &out.ownerId_ptr, &out.ownerId_len, &has1);
    agy_fill_text(stmt, 2, rowbuf, &cursor, &out.conversationId_ptr, &out.conversationId_len, &out.has_conversationId);
    agy_fill_text(stmt, 3, rowbuf, &cursor, &out.cliVersion_ptr, &out.cliVersion_len, &out.has_cliVersion);
    agy_fill_text(stmt, 4, rowbuf, &cursor, &out.model_ptr, &out.model_len, &out.has_model);
    agy_fill_text(stmt, 5, rowbuf, &cursor, &out.cwd_ptr, &out.cwd_len, &out.has_cwd);
    agy_fill_text(stmt, 6, rowbuf, &cursor, &out.permissionMode_ptr, &out.permissionMode_len, &out.has_permissionMode);
    agy_fill_text(stmt, 7, rowbuf, &cursor, &out.stateJson_ptr, &out.stateJson_len, &out.has_stateJson);
    out.createdAt = agy_column_int(stmt, 8);
    out.updatedAt = agy_column_int(stmt, 9);
}

// Metadata SELECT order: thread_id 0, owner_id 1,
// conversation_id 2, model 3, cwd 4; all other fields empty.
fn agy_fill_meta(stmt: u64, rowbuf: ptr, out: &AgySessionRecord) -> void {
    let cursor: u64 = 0;
    let has0 = false;
    agy_fill_text(stmt, 0, rowbuf, &cursor, &out.threadId_ptr, &out.threadId_len, &has0);
    let has1 = false;
    agy_fill_text(stmt, 1, rowbuf, &cursor, &out.ownerId_ptr, &out.ownerId_len, &has1);
    agy_fill_text(stmt, 2, rowbuf, &cursor, &out.conversationId_ptr, &out.conversationId_len, &out.has_conversationId);
    out.has_cliVersion = false;
    out.cliVersion_len = 0;
    agy_fill_text(stmt, 3, rowbuf, &cursor, &out.model_ptr, &out.model_len, &out.has_model);
    agy_fill_text(stmt, 4, rowbuf, &cursor, &out.cwd_ptr, &out.cwd_len, &out.has_cwd);
    out.has_permissionMode = false;
    out.permissionMode_len = 0;
    out.has_stateJson = false;
    out.stateJson_len = 0;
    out.createdAt = 0;
    out.updatedAt = 0;
}

fn agy_query_one(db: u64, sql_ptr: ptr, sql_len: u64, b1_ptr: ptr, b1_len: u64, b2_ptr: ptr, b2_len: u64, n_binds: u64, meta: bool, rowbuf: ptr, out: &AgySessionRecord) -> bool {
    let stmt = agy_prepare(db, sql_ptr, sql_len);
    if stmt == 0 { return false; };
    if n_binds >= 1 { agy_bind_text(stmt, 1, b1_ptr, b1_len); };
    if n_binds >= 2 { agy_bind_text(stmt, 2, b2_ptr, b2_len); };
    let rp: ptr = PTR_NULL();
    let rl: u64 = 0;
    let found = agy_step(stmt, &rp, &rl);
    if found {
        if meta {
            agy_fill_meta(stmt, rowbuf, out);
        } else {
            agy_fill_record(stmt, rowbuf, out);
        };
    };
    agy_finalize(stmt);
    return found;
}

fn db_exec(db: u64, sql_ptr: ptr, sql_len: u64) -> i32 {
    let st: u64 = 0;
    SA_SQLITE_EXEC(st, db, sql_ptr, sql_len);
    return st as i32;
}

fn db_now_ms() -> u64 {
    return (sa_time_unix_ms() as u64);
}

fn db_run_upsert(db: u64, input: &AgySessionRecord, res: &AgySessionRecord, created: u64, now: u64) -> void {
    let sql = "INSERT INTO agy_sessions (thread_id, owner_id, conversation_id, cli_version, model, cwd, permission_mode, state_json, created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?) ON CONFLICT(thread_id, owner_id) DO UPDATE SET conversation_id = COALESCE(excluded.conversation_id, agy_sessions.conversation_id), cli_version = COALESCE(excluded.cli_version, agy_sessions.cli_version), model = COALESCE(excluded.model, agy_sessions.model), cwd = COALESCE(excluded.cwd, agy_sessions.cwd), permission_mode = COALESCE(excluded.permission_mode, agy_sessions.permission_mode), state_json = COALESCE(excluded.state_json, agy_sessions.state_json), updated_at = excluded.updated_at";
    let stmt = agy_prepare(db, STR_PTR(sql), STR_LEN(sql));
    if stmt == 0 { return; };
    agy_bind_text(stmt, 1, input.threadId_ptr, input.threadId_len);
    agy_bind_text(stmt, 2, input.ownerId_ptr, input.ownerId_len);
    agy_bind_text_or_null(stmt, 3, res.has_conversationId, res.conversationId_ptr, res.conversationId_len);
    agy_bind_text_or_null(stmt, 4, res.has_cliVersion, res.cliVersion_ptr, res.cliVersion_len);
    agy_bind_text_or_null(stmt, 5, res.has_model, res.model_ptr, res.model_len);
    agy_bind_text_or_null(stmt, 6, res.has_cwd, res.cwd_ptr, res.cwd_len);
    agy_bind_text_or_null(stmt, 7, res.has_permissionMode, res.permissionMode_ptr, res.permissionMode_len);
    agy_bind_text_or_null(stmt, 8, res.has_stateJson, res.stateJson_ptr, res.stateJson_len);
    agy_bind_int(stmt, 9, created);
    agy_bind_int(stmt, 10, now);
    let rp: ptr = PTR_NULL();
    let rl: u64 = 0;
    let ig = agy_step(stmt, &rp, &rl);
    agy_finalize(stmt);
}

fn db_get_by_thread_owner(db: u64, threadId_ptr: ptr, threadId_len: u64, ownerId_ptr: ptr, ownerId_len: u64, rowbuf: ptr, cap: u64, out: &AgySessionRecord) -> bool {
    let sql = "SELECT * FROM agy_sessions WHERE thread_id = ? AND owner_id = ? LIMIT 1";
    return agy_query_one(db, STR_PTR(sql), STR_LEN(sql), threadId_ptr, threadId_len, ownerId_ptr, ownerId_len, 2, false, rowbuf, out);
}

fn db_get_by_conversation(db: u64, conversationId_ptr: ptr, conversationId_len: u64, rowbuf: ptr, cap: u64, out: &AgySessionRecord) -> bool {
    let sql = "SELECT * FROM agy_sessions WHERE conversation_id = ? LIMIT 1";
    return agy_query_one(db, STR_PTR(sql), STR_LEN(sql), conversationId_ptr, conversationId_len, PTR_NULL(), 0, 1, false, rowbuf, out);
}

fn db_get_by_thread(db: u64, threadId_ptr: ptr, threadId_len: u64, rowbuf: ptr, cap: u64, out: &AgySessionRecord) -> bool {
    let sql = "SELECT * FROM agy_sessions WHERE thread_id = ? LIMIT 1";
    return agy_query_one(db, STR_PTR(sql), STR_LEN(sql), threadId_ptr, threadId_len, PTR_NULL(), 0, 1, false, rowbuf, out);
}

fn db_get_meta_by_thread_owner(db: u64, threadId_ptr: ptr, threadId_len: u64, ownerId_ptr: ptr, ownerId_len: u64, rowbuf: ptr, cap: u64, out: &AgySessionRecord) -> bool {
    let sql = "SELECT thread_id, owner_id, conversation_id, model, cwd FROM agy_sessions WHERE thread_id = ? AND owner_id = ? LIMIT 1";
    return agy_query_one(db, STR_PTR(sql), STR_LEN(sql), threadId_ptr, threadId_len, ownerId_ptr, ownerId_len, 2, true, rowbuf, out);
}

fn db_get_meta_by_conversation(db: u64, conversationId_ptr: ptr, conversationId_len: u64, rowbuf: ptr, cap: u64, out: &AgySessionRecord) -> bool {
    let sql = "SELECT thread_id, owner_id, conversation_id, model, cwd FROM agy_sessions WHERE conversation_id = ? LIMIT 1";
    return agy_query_one(db, STR_PTR(sql), STR_LEN(sql), conversationId_ptr, conversationId_len, PTR_NULL(), 0, 1, true, rowbuf, out);
}

fn db_all_by_owner(db: u64, ownerId_ptr: ptr, ownerId_len: u64, rowbuf: ptr, cap: u64) -> u64 {
    let sql = "SELECT * FROM agy_sessions WHERE owner_id = ? ORDER BY updated_at DESC";
    let stmt = agy_prepare(db, STR_PTR(sql), STR_LEN(sql));
    if stmt == 0 { return 0; };
    agy_bind_text(stmt, 1, ownerId_ptr, ownerId_len);
    let count: u64 = 0;
    let cursor: u64 = 0;
    // Rows materialize as their JSON texts, newline-separated,
    // in the rowbuf (readback per index is the repair-phase
    // db_row_at surface noted in listByOwner).
    while true {
        let rp: ptr = PTR_NULL();
        let rl: u64 = 0;
        if !agy_step(stmt, &rp, &rl) { break; };
        count = count + 1;
        let n = rl;
        if cursor + n + 1 > cap { n = cap - cursor; };
        let i: u64 = 0;
        while i < n {
            let v: u8 = 0;
            PTR_BYTE_AT(v, rp, i);
            let wp: ptr = PTR_NULL();
            PTR_BYTE_ADD(wp, rowbuf, cursor + i);
            PTR_WRITE_U8(wp, v);
            i = i + 1;
        }
        cursor = cursor + n;
        if cursor < cap {
            let wp: ptr = PTR_NULL();
            PTR_BYTE_ADD(wp, rowbuf, cursor);
            PTR_WRITE_U8(wp, 10);
            cursor = cursor + 1;
        };
    }
    agy_finalize(stmt);
    return count;
}

fn db_run_changes(db: u64, sql_ptr: ptr, sql_len: u64, p1_ptr: ptr, p1_len: u64, p2_ptr: ptr, p2_len: u64) -> u64 {
    let stmt = agy_prepare(db, sql_ptr, sql_len);
    if stmt == 0 { return 0; };
    agy_bind_text(stmt, 1, p1_ptr, p1_len);
    agy_bind_text(stmt, 2, p2_ptr, p2_len);
    let rp: ptr = PTR_NULL();
    let rl: u64 = 0;
    let ig = agy_step(stmt, &rp, &rl);
    agy_finalize(stmt);
    return agy_changes(db);
}

fn db_run_changes1(db: u64, sql_ptr: ptr, sql_len: u64, p1_ptr: ptr, p1_len: u64) -> u64 {
    let stmt = agy_prepare(db, sql_ptr, sql_len);
    if stmt == 0 { return 0; };
    agy_bind_text(stmt, 1, p1_ptr, p1_len);
    let rp: ptr = PTR_NULL();
    let rl: u64 = 0;
    let ig = agy_step(stmt, &rp, &rl);
    agy_finalize(stmt);
    return agy_changes(db);
}
