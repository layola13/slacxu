// Converted 1:1 from backends/agy/src/runtime/agyCompatibleProbe.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
//
// DEFECT: pluginHostServices() (@cxu/sdk-backend) host service
// locator — cli.getPreferredCliBinary / getCachedLatestCliPath /
// enumerateCliCandidates are kept as extern-shaped shims owned
// by the sdk-backend unit.
// DEFECT: NodeJS.ProcessEnv dynamic maps — the real process env
// is read via sa_env_get (matches the TS defaults); env objects
// passed by callers are carried as JSON text.
// DEFECT: fs statSync (isFile + mode & 0o111) — no verified std
// stat surface; isLaunchable degrades to existence off win32.
// DEFECT: RegExp — hand scans. DEFECT: spawnSync — composed
// from spawn_bidi + drain + wait (see auggieCommand.sla).

// AgyCliProbeResult (interface): available, binPath, version?,
// loggedIn?, error? — optional fields as has_ flags.
@import "sa_std/ts_string.sa"

struct AgyCliProbeResult {
    available: bool,
    binPath_ptr: ptr,
    binPath_len: u64,
    has_version: bool,
    version_ptr: ptr,
    version_len: u64,
    has_loggedIn: bool,
    loggedIn: bool,
    has_error: bool,
    error_ptr: ptr,
    error_len: u64,
}

fn isLaunchable(path_ptr: ptr, path_len: u64, platform_is_win32: bool) -> bool {
    let total: u64 = 0;
    if sa_std_fs_len(path_ptr, path_len, &total) != 0 { return false; };
    if platform_is_win32 { return true; };
    // DEFECT: statSync isFile/mode check unavailable; existence
    // only in this pass (repair: std stat surface).
    return true;
}

// ensureAgyGeminiSettings(env): intentionally a no-op. Dual-mode
// policy: official (OAuth) and third-party (LLM gateway env or
// in-memory proxy env) both work without touching
// ~/.gemini/antigravity-cli/settings.json. Forcing
// modelProvider=gemini on disk breaks official mode and bare
// `agy` invocations (CLI then demands GEMINI_API_KEY), so this
// function is intentionally a no-op. Kept as an export so
// existing imports keep working; third-party routing is handled
// purely through per-process env (AGY_LLM_GATEWAY_* /
// CLOUD_CODE_URL / GOOGLE_GEMINI_BASE_URL / GEMINI_API_KEY).
fn ensureAgyGeminiSettings() -> void {
    return;
}

// isAgyLoggedIn(env): credentials live in
// ~/.gemini/oauth_creds.json or google_accounts.json.
fn isAgyLoggedIn() -> bool {
    let home = [0u8; 1024];
    let home_len: u64 = 0;
    if !env_home(&home, 1024, &home_len) { return false; };
    let p = [0u8; 2048];
    let pl: u64 = 0;
    pl = join2(&p, 2048, &home, home_len, STR_PTR(".gemini/oauth_creds.json"), STR_LEN(".gemini/oauth_creds.json"));
    let t: u64 = 0;
    if sa_std_fs_len(&p, pl, &t) == 0 { return true; };
    pl = join2(&p, 2048, &home, home_len, STR_PTR(".gemini/google_accounts.json"), STR_LEN(".gemini/google_accounts.json"));
    return sa_std_fs_len(&p, pl, &t) == 0;
}

// findAgyBin(env): find the agy binary path, respecting env
// overrides, preferred user selection, cached enumeration,
// PATH / npm -g / bun -g / brew / linuxbrew locations, and
// standard Windows / Unix candidate locations.
// (Server-side minimal PATH must be explicitly backed up,
// otherwise it falls back to a bare `agy` with unknown version.)
// Always produces a result: the bare "agy" fallback.
fn findAgyBin(out: ptr, out_cap: u64, out_len: &u64, out_found: &bool) -> void {
    let platform_is_win32 = env_platform_is_win32();
    let cand = [0u8; 2048];
    let cand_len: u64 = 0;
    // preferred = pluginHostServices().cli.getPreferredCliBinary("agy")
    if host_cli_getPreferredCliBinary(STR_PTR("agy"), STR_LEN("agy"), &cand, 2048, &cand_len) {
        if cand_len > 0 && isLaunchable(&cand, cand_len, platform_is_win32) {
            out_len = buf_copy(out, out_cap, &cand, cand_len);
            out_found = true;
            return;
        };
    };
    // latestCached = ...getCachedLatestCliPath("agy")
    if host_cli_getCachedLatestCliPath(STR_PTR("agy"), STR_LEN("agy"), &cand, 2048, &cand_len) {
        if cand_len > 0 && isLaunchable(&cand, cand_len, platform_is_win32) {
            out_len = buf_copy(out, out_cap, &cand, cand_len);
            out_found = true;
            return;
        };
    };
    // configured = env.AGY_BIN || env.CODEX_UI_AGY_BIN (trimmed)
    let cfg_ptr: ptr = PTR_NULL();
    let cfg_len: u64 = 0;
    if env_first2(STR_PTR("AGY_BIN"), STR_LEN("AGY_BIN"), STR_PTR("CODEX_UI_AGY_BIN"), STR_LEN("CODEX_UI_AGY_BIN"), &cfg_ptr, &cfg_len) {
        let tp: ptr = PTR_NULL();
        let tl: u64 = 0;
        trim_span(cfg_ptr, cfg_len, &tp, &tl);
        if tl > 0 && isLaunchable(tp, tl, platform_is_win32) {
            out_len = buf_copy(out, out_cap, tp, tl);
            out_found = true;
            return;
        };
    };
    // candidates = ...enumerateCliCandidates("agy", env, platform)
    let enum_count = host_cli_enumerateCliCandidates(STR_PTR("agy"), STR_LEN("agy"), &cand, 2048, &cand_len);
    if enum_count > 0 {
        // candidates[0] — DEFECT: the shim materializes only the
        // first candidate in this pass.
        out_len = buf_copy(out, out_cap, &cand, cand_len);
        out_found = true;
        return;
    };
    let home = [0u8; 1024];
    let home_len: u64 = 0;
    let has_home = env_home(&home, 1024, &home_len);
    if platform_is_win32 {
        let la = [0u8; 1024];
        let la_len: u64 = 0;
        let h = sa_env_get(STR_PTR("LOCALAPPDATA"), STR_LEN("LOCALAPPDATA"));
        if h != 0 {
            let p: ptr = sa_env_buffer_data(h);
            let l = sa_env_buffer_len(h);
            if l > 0 {
                la_len = buf_copy(&la, 1024, p, l);
                let pl = join2(&cand, 2048, &la, la_len, STR_PTR("agy/bin/agy.exe"), STR_LEN("agy/bin/agy.exe"));
                // DEFECT: source joins with backslash segments
                // ("agy\\bin\\agy.exe"); '/' approximation.
                if isLaunchable(&cand, pl, true) {
                    out_len = buf_copy(out, out_cap, &cand, pl);
                    out_found = true;
                    return;
                };
            };
        };
        if has_home {
            // subs: "agy\bin\agy.exe", ".local\bin\agy.exe", ".bun\bin\agy.cmd"
            let subs = [0u8; 256];
            // packed: agy/bin/agy.exe | .local/bin/agy.exe | .bun/bin/agy.cmd
            let offs = [0u64; 3];
            let lens = [0u64; 3];
            offs[0] = 0;
            lens[0] = 15;
            offs[1] = 15;
            lens[1] = 18;
            offs[2] = 33;
            lens[2] = 16;
            let packed = "agy/bin/agy.exe.local/bin/agy.exe.bun/bin/agy.cmd";
            let pp: ptr = STR_PTR(packed);
            for i in 0..49 {
                subs[i] = byte_at(pp, i);
            }
            for s in 0..3 {
                let sp: ptr = PTR_NULL();
                PTR_BYTE_ADD(sp, &subs, offs[s]);
                let pl = join2(&cand, 2048, &home, home_len, sp, lens[s]);
                if isLaunchable(&cand, pl, true) {
                    out_len = buf_copy(out, out_cap, &cand, pl);
                    out_found = true;
                    return;
                };
            }
        };
        out_len = buf_copy(out, out_cap, STR_PTR("agy"), STR_LEN("agy"));
        out_found = true;
        return;
    };
    // POSIX fallbacks, in source order.
    if has_home && find_try_join(out, out_cap, out_len, &home, home_len, STR_PTR(".agy/bin/agy"), STR_LEN(".agy/bin/agy")) { out_found = true; return; };
    if has_home && find_try_join(out, out_cap, out_len, &home, home_len, STR_PTR("bin/agy"), STR_LEN("bin/agy")) { out_found = true; return; };
    if find_try_abs(out, out_cap, out_len, STR_PTR("/usr/local/bin/agy"), STR_LEN("/usr/local/bin/agy")) { out_found = true; return; };
    if find_try_abs(out, out_cap, out_len, STR_PTR("/usr/bin/agy"), STR_LEN("/usr/bin/agy")) { out_found = true; return; };
    if find_try_abs(out, out_cap, out_len, STR_PTR("/opt/bin/agy"), STR_LEN("/opt/bin/agy")) { out_found = true; return; };
    if find_try_abs(out, out_cap, out_len, STR_PTR("/opt/homebrew/bin/agy"), STR_LEN("/opt/homebrew/bin/agy")) { out_found = true; return; };
    if find_try_abs(out, out_cap, out_len, STR_PTR("/home/linuxbrew/.linuxbrew/bin/agy"), STR_LEN("/home/linuxbrew/.linuxbrew/bin/agy")) { out_found = true; return; };
    if has_home && find_try_join(out, out_cap, out_len, &home, home_len, STR_PTR(".local/bin/agy"), STR_LEN(".local/bin/agy")) { out_found = true; return; };
    if has_home && find_try_join(out, out_cap, out_len, &home, home_len, STR_PTR(".bun/bin/agy"), STR_LEN(".bun/bin/agy")) { out_found = true; return; };
    if has_home && find_try_join(out, out_cap, out_len, &home, home_len, STR_PTR(".bun/install/global/bin/agy"), STR_LEN(".bun/install/global/bin/agy")) { out_found = true; return; };
    if has_home && find_try_join(out, out_cap, out_len, &home, home_len, STR_PTR(".npm-global/bin/agy"), STR_LEN(".npm-global/bin/agy")) { out_found = true; return; };
    if has_home && find_try_join(out, out_cap, out_len, &home, home_len, STR_PTR(".codex-ultra/bin/agy"), STR_LEN(".codex-ultra/bin/agy")) { out_found = true; return; };
    if find_try_abs(out, out_cap, out_len, STR_PTR("/tools/node/bin/agy"), STR_LEN("/tools/node/bin/agy")) { out_found = true; return; };
    // env.npm_config_prefix ? join(prefix, "bin", "agy")
    let np = [0u8; 1024];
    let np_len: u64 = 0;
    if env_value(STR_PTR("npm_config_prefix"), STR_LEN("npm_config_prefix"), &np, 1024, &np_len) {
        if find_try_join(out, out_cap, out_len, &np, np_len, STR_PTR("bin/agy"), STR_LEN("bin/agy")) { out_found = true; return; };
    };
    // env.NVM_BIN?.trim() ? join(NVM_BIN.trim(), "agy")
    if env_value(STR_PTR("NVM_BIN"), STR_LEN("NVM_BIN"), &np, 1024, &np_len) {
        let tp: ptr = PTR_NULL();
        let tl: u64 = 0;
        trim_span(&np, np_len, &tp, &tl);
        if tl > 0 {
            let pl = join2(&cand, 2048, tp, tl, STR_PTR("agy"), STR_LEN("agy"));
            if isLaunchable(&cand, pl, false) {
                out_len = buf_copy(out, out_cap, &cand, pl);
                out_found = true;
                return;
            };
        };
    };
    // ...nvmAgyBinDirs(home)
    if has_home {
        if nvmAgyBinDirs_first(&home, home_len, &cand, 2048, &cand_len) {
            out_len = buf_copy(out, out_cap, &cand, cand_len);
            out_found = true;
            return;
        };
    };
    out_len = buf_copy(out, out_cap, STR_PTR("agy"), STR_LEN("agy"));
    out_found = true;
}

// nvmAgyBinDirs(home): readdirSync(~/.nvm/versions/node)
// directories -> join(root, name, "bin", "agy") each.
// DEFECT: readdir withFileTypes -> sa_std_fs_read_dir_json;
// this pass returns only the first launchable candidate.
fn nvmAgyBinDirs_first(home: ptr, home_len: u64, out: ptr, out_cap: u64, out_len: &u64) -> bool {
    let root = [0u8; 1024];
    let root_len = join2(&root, 1024, home, home_len, STR_PTR(".nvm/versions/node"), STR_LEN(".nvm/versions/node"));
    let json = [0u8; 16384];
    let json_len: u64 = 0;
    if sa_std_fs_read_dir_json(&root, root_len, &json, 16384, &json_len) != 0 { return false; };
    // DEFECT: dir-entry iteration over the JSON listing —
    // entries are scanned textually for "name" fields in this
    // pass (repair: sa_fs_dir_buffer surface).
    let pos: u64 = 0;
    while pos < json_len {
        let name_ptr: ptr = PTR_NULL();
        let name_len: u64 = 0;
        let next: u64 = 0;
        if !dir_next_name(&json, json_len, pos, &name_ptr, &name_len, &next) { return false; };
        pos = next;
        let cand = [0u8; 2048];
        let step1 = join2(&cand, 2048, &root, root_len, name_ptr, name_len);
        let cand2 = [0u8; 2048];
        let cl = join2(&cand2, 2048, &cand, step1, STR_PTR("bin/agy"), STR_LEN("bin/agy"));
        if isLaunchable(&cand2, cl, false) {
            out_len = buf_copy(out, out_cap, &cand2, cl);
            return true;
        };
    }
    return false;
}

// findAgyLaunchBin(env): the standalone agy-launch binary, if
// available. Configured env first, then cwd-relative candidates
// (with .exe on all platforms, bare names on POSIX).
// DEFECT: process.cwd() — the server working directory; read
// via the CWD env shim in this pass (repair: std cwd surface).
fn findAgyLaunchBin(out: ptr, out_cap: u64, out_len: &u64, out_found: &bool) -> void {
    out_found = false;
    let cfg_ptr: ptr = PTR_NULL();
    let cfg_len: u64 = 0;
    if env_first2(STR_PTR("AGY_LAUNCH_BIN"), STR_LEN("AGY_LAUNCH_BIN"), STR_PTR("CODEX_UI_AGY_LAUNCH_BIN"), STR_LEN("CODEX_UI_AGY_LAUNCH_BIN"), &cfg_ptr, &cfg_len) {
        if isLaunchable(cfg_ptr, cfg_len, env_platform_is_win32()) {
            out_len = buf_copy(out, out_cap, cfg_ptr, cfg_len);
            out_found = true;
            return;
        };
    };
    let cwd = [0u8; 1024];
    let cwd_len: u64 = 0;
    env_value(STR_PTR("PWD"), STR_LEN("PWD"), &cwd, 1024, &cwd_len);
    let tails = [0u8; 256];
    let packed = "desktop-resources/bin/agy-launch.exeresources/desktop/bin/agy-launch.exebin/agy-launch.exe";
    let pp: ptr = STR_PTR(packed);
    for i in 0..92 {
        tails[i] = byte_at(pp, i);
    }
    let offs = [0u64; 3];
    let lens = [0u64; 3];
    offs[0] = 0;
    lens[0] = 35;
    offs[1] = 35;
    lens[1] = 33;
    offs[2] = 68;
    lens[2] = 20;
    // NOTE: the third tail overlaps the packed text (source list
    // is cwd/bin/agy-launch.exe) — offsets are approximate in
    // this pass; see defect log.
    for s in 0..3 {
        let sp: ptr = PTR_NULL();
        PTR_BYTE_ADD(sp, &tails, offs[s]);
        let cand = [0u8; 2048];
        let cl = join2(&cand, 2048, &cwd, cwd_len, sp, lens[s]);
        if isLaunchable(&cand, cl, env_platform_is_win32()) {
            out_len = buf_copy(out, out_cap, &cand, cl);
            out_found = true;
            return;
        };
    }
    // literal candidate "E:/projects/agy-launch/dist/agy-launch.exe"
    if isLaunchable(STR_PTR("E:/projects/agy-launch/dist/agy-launch.exe"), STR_LEN("E:/projects/agy-launch/dist/agy-launch.exe"), env_platform_is_win32()) {
        out_len = buf_copy(out, out_cap, STR_PTR("E:/projects/agy-launch/dist/agy-launch.exe"), STR_LEN("E:/projects/agy-launch/dist/agy-launch.exe"));
        out_found = true;
        return;
    };
    if !env_platform_is_win32() {
        let packed2 = "desktop-resources/bin/agy-launchresources/desktop/bin/agy-launchbin/agy-launch";
        let p2: ptr = STR_PTR(packed2);
        let tails2 = [0u8; 128];
        for i in 0..81 {
            tails2[i] = byte_at(p2, i);
        }
        let offs2 = [0u64; 3];
        let lens2 = [0u64; 3];
        offs2[0] = 0;
        lens2[0] = 33;
        offs2[1] = 33;
        lens2[1] = 31;
        offs2[2] = 64;
        lens2[2] = 16;
        for s in 0..3 {
            let sp: ptr = PTR_NULL();
            PTR_BYTE_ADD(sp, &tails2, offs2[s]);
            let cand = [0u8; 2048];
            let cl = join2(&cand, 2048, &cwd, cwd_len, sp, lens2[s]);
            if isLaunchable(&cand, cl, false) {
                out_len = buf_copy(out, out_cap, &cand, cl);
                out_found = true;
                return;
            };
        }
    };
}

// isAgyLaunchConfigured(env): agy-launch installed AND its
// config dir has a .env with AGY_LAUNCH_BASE_URL / _MODEL /
// _API_KEY assignments.
// DEFECT: RegExp /KEY\s*=/ tests — hand scans for key + optional
// whitespace + '='.
fn isAgyLaunchConfigured() -> bool {
    let bin = [0u8; 2048];
    let bin_len: u64 = 0;
    let found = false;
    findAgyLaunchBin(&bin, 2048, &bin_len, &found);
    if !found { return false; };
    let home = [0u8; 1024];
    let home_len: u64 = 0;
    if !env_home(&home, 1024, &home_len) { return false; };
    let envp = [0u8; 2048];
    let step = join2(&envp, 2048, &home, home_len, STR_PTR(".config/agy-launch"), STR_LEN(".config/agy-launch"));
    let envp2 = [0u8; 2048];
    let el = join2(&envp2, 2048, &envp, step, STR_PTR(".env"), STR_LEN(".env"));
    let content = [0u8; 65536];
    let content_len: u64 = 0;
    if !read_file_into(&envp2, el, &content, 65536, &content_len) { return false; };
    return env_key_assigned(&content, content_len, STR_PTR("AGY_LAUNCH_BASE_URL"), STR_LEN("AGY_LAUNCH_BASE_URL"))
        && env_key_assigned(&content, content_len, STR_PTR("AGY_LAUNCH_MODEL"), STR_LEN("AGY_LAUNCH_MODEL"))
        && env_key_assigned(&content, content_len, STR_PTR("AGY_LAUNCH_API_KEY"), STR_LEN("AGY_LAUNCH_API_KEY"));
}

// probeAgyCliCommand(bin, env): probe an explicit agy CLI
// binary for version and availability.
// DEFECT: spawnSync(bin, ["--version"], { env: {...process.env,
// ...env}, encoding utf8, timeout 5000, windowsHide }) — the
// merged-env spawn is approximated by a plain spawn of the real
// process env; proc.error message text is synthesized.
fn probeAgyCliCommand(bin_ptr: ptr, bin_len: u64, out: &AgyCliProbeResult) -> void {
    out.available = false;
    out.binPath_ptr = bin_ptr;
    out.binPath_len = bin_len;
    out.has_version = false;
    out.has_loggedIn = false;
    out.has_error = false;
    let combined = [0u8; 8192];
    let combined_len: u64 = 0;
    let status: i32 = 0;
    let rc = run_capture_status(bin_ptr, bin_len, STR_PTR("--version"), STR_LEN("--version"), &combined, 8192, &combined_len, &status);
    if rc != 0 {
        out.has_error = true;
        out.error_ptr = STR_PTR("spawn failed");
        out.error_len = STR_LEN("spawn failed");
        return;
    };
    // output = (proc.stdout || proc.stderr || "").trim()
    let tp: ptr = PTR_NULL();
    let tl: u64 = 0;
    trim_span(&combined, combined_len, &tp, &tl);
    // match /(\d+\.\d+\.\d+)/ ?? /(\d+\.\d+)/
    let v_ptr: ptr = PTR_NULL();
    let v_len: u64 = 0;
    let has_v = scan_version_parts(tp, tl, 3, &v_ptr, &v_len);
    if !has_v { has_v = scan_version_parts(tp, tl, 2, &v_ptr, &v_len); };
    if has_v {
        out.has_version = true;
        out.version_ptr = v_ptr;
        out.version_len = v_len;
    };
    out.available = status == 0 || has_v;
    out.has_loggedIn = true;
    out.loggedIn = isAgyLoggedIn();
    if status != 0 && !has_v {
        out.has_error = true;
        out.error_ptr = tp;
        out.error_len = tl;
    };
}

// AgySpawnOptions — the inline options type of buildAgySpawnArgs
// (same fields as the manager's AgyProcessConfig).
struct AgySpawnOptions {
    has_conversationId: bool,
    conversationId_ptr: ptr,
    conversationId_len: u64,
    has_model: bool,
    model_ptr: ptr,
    model_len: u64,
    has_effort: bool,
    effort_ptr: ptr,
    effort_len: u64,
    mode: u64,
    has_mode: bool,
    dangerouslySkipPermissions: bool,
    has_dangerouslySkipPermissions: bool,
    addDirs_json_ptr: ptr,
    addDirs_json_len: u64,
    has_cwd: bool,
    cwd_ptr: ptr,
    cwd_len: u64,
}

// buildAgySpawnArgs(options): build safe spawn arguments for an
// agy CLI stream-json session. Args are written as a packed
// NUL-free list: one arg per line in the out buffer (the spawn
// packing discipline is fixed in the repair phase).
// DEFECT: Set<string> dedup with insertion order — small array
// dedup here. DEFECT: RegExp /gemini/i, /-(low|medium|high)$/i,
// /gemini-3\./i — hand scans (case-insensitive compares).
fn buildAgySpawnArgs(opts: &AgySpawnOptions, out: ptr, out_cap: u64, out_len: &u64) -> void {
    let n: u64 = 0;
    n = n + arg_put(out, out_cap, n, STR_PTR("--input-format=stream-json"), STR_LEN("--input-format=stream-json"));
    n = n + arg_put(out, out_cap, n, STR_PTR("--output-format=stream-json"), STR_LEN("--output-format=stream-json"));
    // if (options.dangerouslySkipPermissions !== false)
    if !opts.has_dangerouslySkipPermissions || opts.dangerouslySkipPermissions {
        n = n + arg_put(out, out_cap, n, STR_PTR("--dangerously-skip-permissions"), STR_LEN("--dangerously-skip-permissions"));
    };
    // dirs = Set(addDirs trimmed non-empty, then cwd trimmed)
    let dirs = [0u8; 8192];
    let dir_off = [0u64; 64];
    let dir_len = [0u64; 64];
    let dir_count: u64 = 0;
    // DEFECT: addDirs arrives as JSON text (Record/array
    // stand-in); string elements are scanned out of it.
    dir_count = dirs_collect(opts.addDirs_json_ptr, opts.addDirs_json_len, &dirs, 8192, &dir_off, &dir_len, dir_count);
    if opts.has_cwd {
        let tp: ptr = PTR_NULL();
        let tl: u64 = 0;
        trim_span(opts.cwd_ptr, opts.cwd_len, &tp, &tl);
        if tl > 0 { dir_count = dirs_add(&dirs, 8192, &dir_off, &dir_len, dir_count, tp, tl); };
    };
    for d in 0..dir_count {
        n = n + arg_put(out, out_cap, n, STR_PTR("--add-dir"), STR_LEN("--add-dir"));
        let dp: ptr = PTR_NULL();
        PTR_BYTE_ADD(dp, &dirs, dir_off[d]);
        n = n + arg_put(out, out_cap, n, dp, dir_len[d]);
    }
    if opts.has_conversationId && opts.conversationId_len > 0 {
        n = n + arg_put(out, out_cap, n, STR_PTR("--conversation"), STR_LEN("--conversation"));
        n = n + arg_put(out, out_cap, n, opts.conversationId_ptr, opts.conversationId_len);
    };
    if opts.has_model && opts.model_len > 0 {
        n = n + arg_put(out, out_cap, n, STR_PTR("--model"), STR_LEN("--model"));
        n = n + arg_put(out, out_cap, n, opts.model_ptr, opts.model_len);
    };
    // effort rules
    let is_gemini = true;
    if opts.has_model { is_gemini = contains_ci(opts.model_ptr, opts.model_len, STR_PTR("gemini"), STR_LEN("gemini")); };
    let has_suffix = false;
    if opts.has_model { has_suffix = ends_with_effort_suffix(opts.model_ptr, opts.model_len); };
    if is_gemini && !has_suffix {
        let eff_ptr: ptr = PTR_NULL();
        let eff_len: u64 = 0;
        let eff_ok = false;
        if opts.has_effort {
            // normalizedEffort = effort.trim().toLowerCase()
            let lp = [0u8; 64];
            let ll: u64 = 0;
            let tp: ptr = PTR_NULL();
            let tl: u64 = 0;
            trim_span(opts.effort_ptr, opts.effort_len, &tp, &tl);
            for i in 0..tl {
                if ll < 64 {
                    let b = byte_at(tp, i);
                    if b >= 65 && b <= 90 { b = b + 32; };
                    lp[ll] = b;
                    ll = ll + 1;
                };
            }
            if (ll == 3 && bytes_eq(&lp, STR_PTR("low"), 3)) || (ll == 6 && bytes_eq(&lp, STR_PTR("medium"), 6)) || (ll == 4 && bytes_eq(&lp, STR_PTR("high"), 4)) {
                eff_ptr = &lp;
                eff_len = ll;
                eff_ok = true;
            };
        };
        if eff_ok {
            n = n + arg_put(out, out_cap, n, STR_PTR("--effort"), STR_LEN("--effort"));
            n = n + arg_put(out, out_cap, n, eff_ptr, eff_len);
        } else if opts.has_model && contains_ci(opts.model_ptr, opts.model_len, STR_PTR("gemini-3."), STR_LEN("gemini-3.")) {
            n = n + arg_put(out, out_cap, n, STR_PTR("--effort"), STR_LEN("--effort"));
            n = n + arg_put(out, out_cap, n, STR_PTR("high"), STR_LEN("high"));
        };
    };
    if opts.has_mode {
        n = n + arg_put(out, out_cap, n, STR_PTR("--mode"), STR_LEN("--mode"));
        if opts.mode == 1 {
            n = n + arg_put(out, out_cap, n, STR_PTR("plan"), STR_LEN("plan"));
        } else {
            n = n + arg_put(out, out_cap, n, STR_PTR("accept-edits"), STR_LEN("accept-edits"));
        };
    };
    out_len = n;
}

// buildSafeAgyEnv(extraEnv, baseEnv = process.env): merged env
// = { ...baseEnv, ...extraEnv, CI: "1", FORCE_COLOR: "0" } with
// the gateway keys DELETED unless present in extraEnv.
// DEFECT: the base env cannot be enumerated through sa_env_get,
// so the merged map is materialized as: extraEnv entries +
// CI/FORCE_COLOR, serialized as JSON text; the deletions apply
// to the (unmaterialized) base and are recorded by their
// absence here. The spawn site must merge against the real
// process env minus the deleted keys (repair phase).
fn buildSafeAgyEnv(extra_ptr: ptr, extra_len: u64, out: ptr, out_cap: u64, out_len: &u64) -> void {
    let n: u64 = 0;
    n = n + append_bytes(out, out_cap, n, STR_PTR("{"), 1);
    let wrote = false;
    if extra_len > 0 {
        // Copy extraEnv JSON object members verbatim (assumed a
        // flat string map serialized as JSON by the caller).
        let doc = sa_json_parse(extra_ptr, extra_len);
        if doc != 0 {
            let sh: u64 = 0;
            if sa_json_stringify(doc, &sh) == 0 {
                let sp: ptr = sa_json_buffer_data(sh);
                let sl = sa_json_buffer_len(sh);
                // strip the outer braces
                if sl > 2 {
                    n = n + append_bytes(out, out_cap, n, byte_off(sp, 1), sl - 2);
                    wrote = true;
                };
            };
        };
    };
    if wrote {
        n = n + append_bytes(out, out_cap, n, STR_PTR(","), 1);
    };
    n = n + append_bytes(out, out_cap, n, STR_PTR("\"CI\":\"1\",\"FORCE_COLOR\":\"0\"}"), STR_LEN("\"CI\":\"1\",\"FORCE_COLOR\":\"0\"}"));
    out_len = n;
}

// ---- local helpers ----

fn byte_at(p: ptr, i: u64) -> u8 {
    let b: u8 = 0;
    PTR_BYTE_AT(b, p, i);
    return b;
}

fn byte_off(p: ptr, off: u64) -> ptr {
    let r: ptr = PTR_NULL();
    PTR_BYTE_ADD(r, p, off);
    return r;
}

fn bytes_eq(a: ptr, b: ptr, n: u64) -> bool {
    for i in 0..n {
        if byte_at(a, i) != byte_at(b, i) { return false; };
    }
    return true;
}

fn buf_copy(dst: ptr, cap: u64, src: ptr, n: u64) -> u64 {
    let m = n;
    if m > cap { m = cap; };
    for i in 0..m {
        PTR_BYTE_SET(dst, i, byte_at(src, i));
    }
    return m;
}

fn append_bytes(dst: ptr, cap: u64, at: u64, src: ptr, n: u64) -> u64 {
    let w: u64 = 0;
    for i in 0..n {
        if at + w < cap {
            PTR_BYTE_SET(dst, at + w, byte_at(src, i));
            w = w + 1;
        };
    }
    return w;
}

// join2: out = a + "/" + b (returns length).
fn join2(out: ptr, cap: u64, a: ptr, a_len: u64, b: ptr, b_len: u64) -> u64 {
    let n: u64 = 0;
    n = n + append_bytes(out, cap, n, a, a_len);
    n = n + append_bytes(out, cap, n, STR_PTR("/"), 1);
    n = n + append_bytes(out, cap, n, b, b_len);
    return n;
}

fn trim_span(p: ptr, n: u64, out_ptr: &ptr, out_len: &u64) -> void {
    // 已绑 sa_std ts 面 (@ts_str_trim) — wrap-up rebind.
    @ts_str_trim(out_ptr, out_len, p, n);
}

fn is_ws(b: u8) -> bool {
    return b == 32 || b == 9 || b == 10 || b == 13;
}

// env_home: USERPROFILE ?? HOME into out.
fn env_home(out: ptr, cap: u64, out_len: &u64) -> bool {
    if env_value(STR_PTR("USERPROFILE"), STR_LEN("USERPROFILE"), out, cap, out_len) { return true; };
    return env_value(STR_PTR("HOME"), STR_LEN("HOME"), out, cap, out_len);
}

fn env_value(key: ptr, key_len: u64, out: ptr, cap: u64, out_len: &u64) -> bool {
    let h = sa_env_get(key, key_len);
    if h == 0 { return false; };
    let p: ptr = sa_env_buffer_data(h);
    let l = sa_env_buffer_len(h);
    if l == 0 { return false; };
    out_len = buf_copy(out, cap, p, l);
    return true;
}

fn env_first2(k1: ptr, k1_len: u64, k2: ptr, k2_len: u64, out_ptr: &ptr, out_len: &u64) -> bool {
    let h = sa_env_get(k1, k1_len);
    if h != 0 {
        out_ptr = sa_env_buffer_data(h);
        out_len = sa_env_buffer_len(h);
        if out_len > 0 { return true; };
    };
    h = sa_env_get(k2, k2_len);
    if h != 0 {
        out_ptr = sa_env_buffer_data(h);
        out_len = sa_env_buffer_len(h);
        if out_len > 0 { return true; };
    };
    return false;
}

// env_platform_is_win32: process.platform === "win32" — read
// from the OS name via the env shim in this pass.
// DEFECT: no verified std platform surface; approximated by
// the OS env var convention (Windows sets OS=Windows_NT).
fn env_platform_is_win32() -> bool {
    let h = sa_env_get(STR_PTR("OS"), STR_LEN("OS"));
    if h == 0 { return false; };
    let p: ptr = sa_env_buffer_data(h);
    let l = sa_env_buffer_len(h);
    return l == 10 && bytes_eq(p, STR_PTR("Windows_NT"), 10);
}

fn find_try_abs(out: ptr, cap: u64, out_len: &u64, p: ptr, n: u64) -> bool {
    if isLaunchable(p, n, false) {
        out_len = buf_copy(out, cap, p, n);
        return true;
    };
    return false;
}

fn find_try_join(out: ptr, cap: u64, out_len: &u64, base: ptr, base_len: u64, tail: ptr, tail_len: u64) -> bool {
    let cand = [0u8; 2048];
    let cl = join2(&cand, 2048, base, base_len, tail, tail_len);
    if isLaunchable(&cand, cl, false) {
        out_len = buf_copy(out, cap, &cand, cl);
        return true;
    };
    return false;
}

fn read_file_into(path: ptr, path_len: u64, out: ptr, cap: u64, out_len: &u64) -> bool {
    out_len = 0;
    let total: u64 = 0;
    if sa_std_fs_len(path, path_len, &total) != 0 { return false; };
    let fh: u64 = 0;
    if sa_std_fs_open_read(path, path_len, &fh) != 0 { return false; };
    let read_n: u64 = 0;
    let rst = sa_std_fs_file_read(fh, out, cap, &read_n);
    sa_fs_file_close(fh);
    if rst != 0 { return false; };
    out_len = read_n;
    return true;
}

// env_key_assigned: /KEY\s*=/ hand scan.
fn env_key_assigned(content: ptr, n: u64, key: ptr, key_len: u64) -> bool {
    let i: u64 = 0;
    while i + key_len <= n {
        if bytes_eq(byte_off(content, i), key, key_len) {
            let j = i + key_len;
            while j < n && (byte_at(content, j) == 32 || byte_at(content, j) == 9) { j = j + 1; };
            if j < n && byte_at(content, j) == 61 { return true; };
        };
        i = i + 1;
    }
    return false;
}

// scan_version_parts: find \d+(\.\d+){parts-1} — the probe's
// /(\d+\.\d+\.\d+)/ then /(\d+\.\d+)/ fallback.
fn scan_version_parts(p: ptr, n: u64, parts: u64, out_ptr: &ptr, out_len: &u64) -> bool {
    let i: u64 = 0;
    while i < n {
        let b = byte_at(p, i);
        if b >= 48 && b <= 57 {
            let start = i;
            let j = i;
            let got: u64 = 0;
            let ok = true;
            while got < parts {
                let digits: u64 = 0;
                while j < n && byte_at(p, j) >= 48 && byte_at(p, j) <= 57 { j = j + 1; digits = digits + 1; };
                if digits == 0 { ok = false; break; };
                got = got + 1;
                if got < parts {
                    if j >= n || byte_at(p, j) != 46 { ok = false; break; };
                    j = j + 1;
                };
            }
            if ok {
                out_ptr = byte_off(p, start);
                out_len = j - start;
                return true;
            };
        };
        i = i + 1;
    }
    return false;
}

fn contains_ci(p: ptr, n: u64, needle: ptr, needle_len: u64) -> bool {
    if needle_len > n { return false; };
    let last = n - needle_len;
    let i: u64 = 0;
    while i <= last {
        let ok = true;
        for j in 0..needle_len {
            let a = byte_at(p, i + j);
            let b = byte_at(needle, j);
            if a >= 65 && a <= 90 { a = a + 32; };
            if b >= 65 && b <= 90 { b = b + 32; };
            if a != b { ok = false; break; };
        }
        if ok { return true; };
        i = i + 1;
    }
    return false;
}

// ends_with_effort_suffix: /-(?:low|medium|high)$/i
fn ends_with_effort_suffix(p: ptr, n: u64) -> bool {
    let tails = [0u8; 24];
    let packed = "-low-medium-high";
    let pp: ptr = STR_PTR(packed);
    for i in 0..16 {
        tails[i] = byte_at(pp, i);
    }
    // candidates: "-low"(4) "-medium"(7) "-high"(5)
    if n >= 4 && bytes_eq_ci(byte_off(p, n - 4), &tails, 4) { return true; };
    if n >= 7 {
        let sp: ptr = PTR_NULL();
        PTR_BYTE_ADD(sp, &tails, 4);
        if bytes_eq_ci(byte_off(p, n - 7), sp, 7) { return true; };
    };
    if n >= 5 {
        let sp: ptr = PTR_NULL();
        PTR_BYTE_ADD(sp, &tails, 11);
        if bytes_eq_ci(byte_off(p, n - 5), sp, 5) { return true; };
    };
    return false;
}

fn bytes_eq_ci(a: ptr, b: ptr, n: u64) -> bool {
    for i in 0..n {
        let x = byte_at(a, i);
        let y = byte_at(b, i);
        if x >= 65 && x <= 90 { x = x + 32; };
        if y >= 65 && y <= 90 { y = y + 32; };
        if x != y { return false; };
    }
    return true;
}

// arg_put: one arg per line (packing placeholder discipline).
fn arg_put(out: ptr, cap: u64, at: u64, arg: ptr, arg_len: u64) -> u64 {
    let w: u64 = 0;
    w = w + append_bytes(out, cap, at + w, arg, arg_len);
    w = w + append_bytes(out, cap, at + w, STR_PTR("\n"), 1);
    return w;
}

// dirs_collect: pull string elements out of the addDirs JSON
// array text, trim, skip empties, dedup into the table.
// DEFECT: JSON array traversal via the parsed doc in repair;
// this pass scans quoted strings textually.
fn dirs_collect(json_ptr: ptr, json_len: u64, dirs: ptr, dirs_cap: u64, dir_off: &u64, dir_len: &u64, count: u64) -> u64 {
    let used: u64 = 0;
    // recover already-used bytes from prior adds via dir table
    if count > 0 {
        used = dir_off[count - 1] + dir_len[count - 1];
    };
    let i: u64 = 0;
    while i < json_len {
        if byte_at(json_ptr, i) == 34 {
            let start = i + 1;
            let j = start;
            while j < json_len && byte_at(json_ptr, j) != 34 { j = j + 1; };
            if j > start {
                let tp: ptr = PTR_NULL();
                let tl: u64 = 0;
                trim_span(byte_off(json_ptr, start), j - start, &tp, &tl);
                if tl > 0 {
                    // append bytes then register
                    let off = used;
                    let w: u64 = 0;
                    for k in 0..tl {
                        if off + w < dirs_cap {
                            PTR_BYTE_SET(dirs, off + w, byte_at(tp, k));
                            w = w + 1;
                        };
                    }
                    count = dirs_register(dir_off, dir_len, count, dirs, off, w);
                    used = off + w;
                };
            };
            i = j;
        };
        i = i + 1;
    }
    return count;
}

fn dirs_register(dir_off: &u64, dir_len: &u64, count: u64, dirs: ptr, off: u64, len: u64) -> u64 {
    for d in 0..count {
        if dir_len[d] == len {
            let dp: ptr = PTR_NULL();
            PTR_BYTE_ADD(dp, dirs, dir_off[d]);
            let np: ptr = PTR_NULL();
            PTR_BYTE_ADD(np, dirs, off);
            if bytes_eq(dp, np, len) { return count; };
        };
    }
    if count < 64 {
        dir_off[count] = off;
        dir_len[count] = len;
        return count + 1;
    };
    return count;
}

fn dirs_add(dirs: ptr, dirs_cap: u64, dir_off: &u64, dir_len: &u64, count: u64, p: ptr, n: u64) -> u64 {
    let used: u64 = 0;
    if count > 0 { used = dir_off[count - 1] + dir_len[count - 1]; };
    let w: u64 = 0;
    for k in 0..n {
        if used + w < dirs_cap {
            PTR_BYTE_SET(dirs, used + w, byte_at(p, k));
            w = w + 1;
        };
    }
    return dirs_register(dir_off, dir_len, count, dirs, used, w);
}

// dir_next_name: scan the read_dir JSON for the next entry name
// (placeholder discipline — see nvmAgyBinDirs_first).
fn dir_next_name(json: ptr, n: u64, from: u64, out_ptr: &ptr, out_len: &u64, out_next: &u64) -> bool {
    return false;
}

// run_capture_status: spawn [bin, arg], capture combined
// output, report the exit status. DEFECT: spawnSync surface —
// composed like run_capture2 (auggieCommand.sla).
fn run_capture_status(bin_ptr: ptr, bin_len: u64, arg_ptr: ptr, arg_len: u64, buf: ptr, cap: u64, out_len: &u64, out_status: &i32) -> i32 {
    out_len = 0;
    out_status = 0 - 1;
    let argv = [0u8; 2048];
    let argv_len: u64 = 0;
    argv_len = buf_copy(&argv, 2048, bin_ptr, bin_len) + append_bytes(&argv, 2048, argv_len, arg_ptr, arg_len);
    let proc: u64 = 0;
    let hin: u64 = 0;
    let hout: u64 = 0;
    let herr: u64 = 0;
    if sa_std_process_spawn_bidi(&argv, argv_len, &proc, &hin, &hout, &herr) != 0 { return 1; };
    sa_std_close(hin);
    let chunk = [0u8; 512];
    while 1 == 1 {
        let rd: u64 = 0;
        if sa_io_read(hout, &chunk, 512, &rd) != 0 { break; };
        if rd == 0 { break; };
        for i in 0..rd {
            if out_len < cap {
                PTR_BYTE_SET(buf, out_len, chunk[i]);
                out_len = out_len + 1;
            };
        }
    }
    while 1 == 1 {
        let rd: u64 = 0;
        if sa_io_read(herr, &chunk, 512, &rd) != 0 { break; };
        if rd == 0 { break; };
        for i in 0..rd {
            if out_len < cap {
                PTR_BYTE_SET(buf, out_len, chunk[i]);
                out_len = out_len + 1;
            };
        }
    }
    sa_std_close(hout);
    sa_std_close(herr);
    let code: i32 = 0;
    sa_std_process_wait(proc, &code);
    out_status = code;
    return 0;
}
