// uuid_new: randomUUID() shim. DEFECT: no verified std uuid.
fn uuid_new(out: ptr, out_cap: u64, out_len: &u64) -> void {
    *out_len = ab_buf_copy(out, out_cap, STR_PTR("00000000-0000-4000-8000-000000000000"), STR_LEN("00000000-0000-4000-8000-000000000000"));
}

// process_cwd: process.cwd() via the PWD env shim.
fn process_cwd(out: ptr, out_cap: u64) -> u64 {
    let h = sa_env_get(STR_PTR("PWD"), STR_LEN("PWD"));
    if h == 0 { return 0; };
    let p: ptr = PTR_NULL();
    let l: u64 = 0;
    sa_env_buffer_data(h, &p);
    sa_env_buffer_len(h, &l);
    return ab_buf_copy(out, out_cap, p, l);
}

// now_ms: Date.now() shim. DEFECT: no verified std clock.
fn now_ms() -> u64 {
    return 0;
}

// ts_trim_span: String.prototype.trim — 已绑 sa_std ts 面
// (@import "sa_std/ts_string.sa" 的 @ts_str_trim；句柄模型
// {ptr,len}，此处为其 span 形态绑定，精确宏签名在修复阶段对齐）。
fn ts_trim_span(p: ptr, n: u64, out_ptr: &ptr, out_len: &u64) -> void {
    ab_ts_str_trim(out_ptr, out_len, p, n);
}

// json_node_string / json_node_is_null: bare-node accessors
// over the sa_json surface. DEFECT: node-kind surface shims.
fn json_node_string(node: u64, out_ptr: &ptr, out_len: &u64) -> void {
    *out_ptr = PTR_NULL();
    *out_len = 0;
}

fn json_node_is_null(node: u64) -> bool {
    return node == 0;
}

fn stringify_into(node: u64, out: ptr, out_cap: u64) -> u64 {
    if node == 0 { return ab_append_bytes(out, out_cap, 0, STR_PTR("{}"), 2); };
    let h: u64 = 0;
    if sa_json_stringify(node, &h) != 0 { return ab_append_bytes(out, out_cap, 0, STR_PTR("{}"), 2); };
    let bp: ptr = PTR_NULL();
    let bl: u64 = 0;
    sa_json_buffer_data(h, &bp);
    sa_json_buffer_len(h, &bl);
    let n = ab_buf_copy(out, out_cap, bp, bl);
    sa_json_buffer_free(h);
    return n;
}

// queue_next: one `kind\tpayload\n` record (same format as the
// runtime/process-manager queues).
fn queue_next(queue: ptr, queue_len: u64, pos: &u64, kind_out: ptr, kind_cap: u64, kind_len: &u64, payload_out: ptr, payload_cap: u64, payload_len: &u64, out_has: &bool) -> void {
    *out_has = false;
    *kind_len = 0;
    *payload_len = 0;
    if pos >= queue_len { return; };
    let tab = find_byte(queue, queue_len, pos, 9);
    if tab == 4294967295 { return; };
    *kind_len = ab_buf_copy(kind_out, kind_cap, ab_byte_off(queue, pos), tab - *pos);
    let nl = find_byte(queue, queue_len, tab + 1, 10);
    let end = queue_len;
    if nl != 4294967295 { end = nl; };
    *payload_len = ab_buf_copy(payload_out, payload_cap, ab_byte_off(queue, tab + 1), end - tab - 1);
    *pos = end + 1;
    *out_has = true;
}

// ---- local helpers ----

fn ab_byte_at(p: ptr, i: u64) -> u8 {
    let b: u8 = 0;
    PTR_BYTE_AT(b, p, i);
    return b;
}

fn ab_byte_off(p: ptr, off: u64) -> ptr {
    let r: ptr = PTR_NULL();
    PTR_BYTE_ADD(r, p, off);
    return r;
}

fn slot(arena: ptr, off: u64) -> ptr {
    return ab_byte_off(arena, off);
}

fn ab_bytes_eq(a: ptr, b: ptr, n: u64) -> bool {
    for i in 0..n {
        if ab_byte_at(a, i) != ab_byte_at(b, i) { return false; };
    }
    return true;
}

fn str_is(p: ptr, n: u64, lit: ptr, lit_len: u64) -> bool {
    return n == lit_len && ab_bytes_eq(p, lit, n);
}

fn contains(p: ptr, n: u64, needle: ptr, needle_len: u64) -> bool {
    if needle_len > n { return false; };
    let last = n - needle_len;
    let i: u64 = 0;
    while i <= last {
        if ab_bytes_eq(ab_byte_off(p, i), needle, needle_len) { return true; };
        i = i + 1;
    }
    return false;
}

fn find_byte(buf: ptr, n: u64, from: u64, want: u8) -> u64 {
    let i = from;
    while i < n {
        if ab_byte_at(buf, i) == want { return i; };
        i = i + 1;
    }
    return 4294967295;
}

fn ab_trim_span(p: ptr, n: u64, out_ptr: &ptr, out_len: &u64) -> void {
    let start: u64 = 0;
    let end = n;
    while start < end && ab_is_ws(ab_byte_at(p, start)) { start = start + 1; }
    while end > start && ab_is_ws(ab_byte_at(p, end - 1)) { end = end - 1; }
    *out_ptr = ab_byte_off(p, start);
    *out_len = end - start;
}

fn trim_is_empty(p: ptr, n: u64) -> bool {
    let tp: ptr = PTR_NULL();
    let tl: u64 = 0;
    ab_trim_span(p, n, &tp, &tl);
    return tl == 0;
}

fn ab_is_ws(b: u8) -> bool {
    return b == 32 || b == 9 || b == 10 || b == 13;
}

fn ab_append_bytes(dst: ptr, cap: u64, at: u64, src: ptr, n: u64) -> u64 {
    let w: u64 = 0;
    for i in 0..n {
        if at + w < cap {
            let __pbs1: ptr = PTR_NULL(); PTR_BYTE_ADD(__pbs1, dst, at + w); PTR_WRITE_U8(__pbs1, ab_byte_at(src, i));
            w = w + 1;
        };
    }
    return w;
}

fn append_u64(dst: ptr, cap: u64, at: u64, v: u64) -> u64 {
    let digits = [0u8; 20];
    let digits_p: ptr = PTR_NULL(); PTR_BYTE_ADD(digits_p, &digits, 0);
    let dn: u64 = 0;
    if v == 0 { return ab_append_bytes(dst, cap, at, STR_PTR("0"), 1); };
    let x = v;
    while x > 0 {
        digits[dn] = 48 + (x % 10) as u8;
        dn = dn + 1;
        x = x / 10;
    }
    let w: u64 = 0;
    let i = dn;
    while i > 0 {
        i = i - 1;
        if at + w < cap { let __pbs2: ptr = PTR_NULL(); PTR_BYTE_ADD(__pbs2, dst, at + w); PTR_WRITE_U8(__pbs2, digits[i]); w = w + 1; };
    }
    return w;
}

fn ab_buf_copy(dst: ptr, cap: u64, src: ptr, n: u64) -> u64 {
    let m = n;
    if m > cap { m = cap; };
    for i in 0..m {
        let __pbs3: ptr = PTR_NULL(); PTR_BYTE_ADD(__pbs3, dst, i); PTR_WRITE_U8(__pbs3, ab_byte_at(src, i));
    }
    return m;
}

fn buf_append(dst: ptr, cap: u64, at: u64, src: ptr, n: u64) -> u64 {
    return ab_append_bytes(dst, cap, at, src, n);
}

fn ab_join2(out: ptr, cap: u64, a: ptr, a_len: u64, b: ptr, b_len: u64) -> u64 {
    let n: u64 = 0;
    n = n + ab_append_bytes(out, cap, n, a, a_len);
    n = n + ab_append_bytes(out, cap, n, STR_PTR("/"), 1);
    n = n + ab_append_bytes(out, cap, n, b, b_len);
    return n;
}

fn ab_read_file_into(path: ptr, path_len: u64, out: ptr, cap: u64, out_len: &u64) -> bool {
    *out_len = 0;
    let total: u64 = 0;
    if sa_std_fs_len(path, path_len, &total) != 0 { return false; };
    let fh: u64 = 0;
    if sa_std_fs_open_read(path, path_len, &fh) != 0 { return false; };
    let read_n: u64 = 0;
    let rst = sa_std_fs_file_read(fh, out, cap, &read_n);
    sa_fs_file_close(fh);
    if rst != 0 { return false; };
    *out_len = read_n;
    return true;
}
