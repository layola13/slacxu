// Converted 1:1 from backends/agy/src/runtime/agyBridge.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
//
// DEFECT: AgyBridgeOptions callbacks (async resolveRelayEnv /
// resolveRelayProxyConfig, onSnapshot, loadSnapshot,
// loadMetadata) — host shim fns declared by use at the bottom
// of this file. DEFECT: EventEmitter ("message" /
// "notification") — event queue records drained by the owner.
// DEFECT: setTimeout(10ms) pending-turn timers — deadline
// fields fired by AgyBridge_pollPending. DEFECT: sessions Map —
// a fixed table (cap 16) of embedded session structs; each
// session embeds a full AgyCompatibleRuntime + AgyProxyServer,
// so the table is memory-heavy (repair phase: handle-based
// sessions). DEFECT: messages: JsonValue[] — item JSON texts in
// a per-session arena. DEFECT: randomUUID / process.cwd /
// Date.now — shims. DEFECT: URL parsing (formatProxyHost) —
// hand scan. DEFECT: JSON string escaping in assembled result /
// snapshot texts — raw append.

@import "./agyCompatibleRuntime.sla"
@import "./agyCompatibleProxy.sla"
@import "./agyCompatibleProbe.sla"
@import "sa_std/string.sai"
@import "sa_std/ptr.sa"
@import "sa_std/string.sa"
@import "sa_std/encoding/json.sai"
@import "sa_std/env.sai"
@import "sa_std/fs.sai"

fn ab_ts_str_trim(out_ptr: &ptr, out_len: &u64, p: ptr, n: u64) -> void {
    // Local replica of the SA-layer @ts_str_trim view semantics
    // (sci sa_std/ts_string.sa): ASCII trim of both ends over the
    // (p, n) view, built on the real string.sai externs.
    let start: u64 = sa_str_trim_ascii_start_index(p, n);
    let rest: ptr = PTR_NULL();
    PTR_BYTE_ADD(rest, p, start);
    let elen: u64 = sa_str_trim_ascii_end_len(rest, n - start);
    *out_ptr = rest;
    *out_len = elen;
}

// AGY_OFFICIAL_PROVIDER_ID = "agy-official"
fn AGY_OFFICIAL_PROVIDER_ID_ptr() -> ptr { return STR_PTR("agy-official"); }
fn AGY_OFFICIAL_PROVIDER_ID_len() -> u64 { return STR_LEN("agy-official"); }

// AGY_OFFICIAL_MODELS (16 entries, source order).
fn agy_official_model_at(idx: u64, out_ptr: &ptr, out_len: &u64) -> bool {
    if idx == 0 { *out_ptr = STR_PTR("gemini-3.8-flash-high"); *out_len = STR_LEN("gemini-3.8-flash-high"); return true; };
    if idx == 1 { *out_ptr = STR_PTR("gemini-3.8-flash-medium"); *out_len = STR_LEN("gemini-3.8-flash-medium"); return true; };
    if idx == 2 { *out_ptr = STR_PTR("gemini-3.8-flash-low"); *out_len = STR_LEN("gemini-3.8-flash-low"); return true; };
    if idx == 3 { *out_ptr = STR_PTR("gemini-3.8-pro-high"); *out_len = STR_LEN("gemini-3.8-pro-high"); return true; };
    if idx == 4 { *out_ptr = STR_PTR("gemini-3.8-pro-low"); *out_len = STR_LEN("gemini-3.8-pro-low"); return true; };
    if idx == 5 { *out_ptr = STR_PTR("gemini-3.7-flash-high"); *out_len = STR_LEN("gemini-3.7-flash-high"); return true; };
    if idx == 6 { *out_ptr = STR_PTR("gemini-3.7-flash-medium"); *out_len = STR_LEN("gemini-3.7-flash-medium"); return true; };
    if idx == 7 { *out_ptr = STR_PTR("gemini-3.7-flash-low"); *out_len = STR_LEN("gemini-3.7-flash-low"); return true; };
    if idx == 8 { *out_ptr = STR_PTR("gemini-3.6-flash-high"); *out_len = STR_LEN("gemini-3.6-flash-high"); return true; };
    if idx == 9 { *out_ptr = STR_PTR("gemini-3.6-flash-medium"); *out_len = STR_LEN("gemini-3.6-flash-medium"); return true; };
    if idx == 10 { *out_ptr = STR_PTR("gemini-3.6-flash-low"); *out_len = STR_LEN("gemini-3.6-flash-low"); return true; };
    if idx == 11 { *out_ptr = STR_PTR("gemini-3.1-pro-high"); *out_len = STR_LEN("gemini-3.1-pro-high"); return true; };
    if idx == 12 { *out_ptr = STR_PTR("gemini-3.1-pro-low"); *out_len = STR_LEN("gemini-3.1-pro-low"); return true; };
    if idx == 13 { *out_ptr = STR_PTR("claude-sonnet-4-6"); *out_len = STR_LEN("claude-sonnet-4-6"); return true; };
    if idx == 14 { *out_ptr = STR_PTR("claude-opus-4-6-thinking"); *out_len = STR_LEN("claude-opus-4-6-thinking"); return true; };
    if idx == 15 { *out_ptr = STR_PTR("gpt-oss-120b-medium"); *out_len = STR_LEN("gpt-oss-120b-medium"); return true; };
    return false;
}

// isAgyOfficialModel(model?)
fn isAgyOfficialModel(model_ptr: ptr, model_len: u64, has_model: bool) -> bool {
    if !has_model { return false; };
    for i in 0..16 {
        let p: ptr = PTR_NULL();
        let l: u64 = 0;
        agy_official_model_at(i, &p, &l);
        if l == model_len && ab_bytes_eq(p, model_ptr, l) { return true; };
    }
    return false;
}

// formatProxyHost(url?): "none" for empty, URL host, "unknown"
// for empty host, "configured" on parse failure.
fn formatProxyHost(url_ptr: ptr, url_len: u64, has_url: bool, out: ptr, out_cap: u64, out_len: &u64) -> void {
    if !has_url || url_len == 0 {
        *out_len = ab_buf_copy(out, out_cap, STR_PTR("none"), 4);
        return;
    };
    // host = after "://" up to '/', ':', '?' or '#'
    let start: u64 = 0;
    let i: u64 = 0;
    let found = false;
    while i + 2 < url_len {
        if ab_byte_at(url_ptr, i) == 58 && ab_byte_at(url_ptr, i + 1) == 47 && ab_byte_at(url_ptr, i + 2) == 47 {
            start = i + 3;
            found = true;
            break;
        };
        i = i + 1;
    }
    if !found {
        *out_len = ab_buf_copy(out, out_cap, STR_PTR("configured"), STR_LEN("configured"));
        return;
    };
    let end = start;
    while end < url_len {
        let b = ab_byte_at(url_ptr, end);
        if b == 47 || b == 58 || b == 63 || b == 35 { break; };
        end = end + 1;
    }
    if end == start {
        *out_len = ab_buf_copy(out, out_cap, STR_PTR("unknown"), STR_LEN("unknown"));
        return;
    };
    *out_len = ab_buf_copy(out, out_cap, ab_byte_off(url_ptr, start), end - start);
}

// buildAgyOfficialProvider(): the official ProviderConfig as
// JSON text (the shared ProviderConfig shape).
fn buildAgyOfficialProvider(out: ptr, out_cap: u64, out_len: &u64) -> void {
    let models = [0u8; 1024];
    let models_p: ptr = PTR_NULL(); PTR_BYTE_ADD(models_p, &models, 0);
    let models_len: u64 = 0;
    models_len = models_len + ab_append_bytes(models_p, 1024, models_len, STR_PTR("["), 1);
    for i in 0..16 {
        let p: ptr = PTR_NULL();
        let l: u64 = 0;
        agy_official_model_at(i, &p, &l);
        if i > 0 { models_len = models_len + ab_append_bytes(models_p, 1024, models_len, STR_PTR(","), 1); };
        models_len = models_len + ab_append_bytes(models_p, 1024, models_len, STR_PTR("\""), 1);
        models_len = models_len + ab_append_bytes(models_p, 1024, models_len, p, l);
        models_len = models_len + ab_append_bytes(models_p, 1024, models_len, STR_PTR("\""), 1);
    }
    models_len = models_len + ab_append_bytes(models_p, 1024, models_len, STR_PTR("]"), 1);
    let now = now_ms();
    let n: u64 = 0;
    n = n + ab_append_bytes(out, out_cap, n, STR_PTR("{\"id\":\"agy-official\",\"name\":\"Antigravity 官方\",\"kind\":\"responsesRelay\",\"serviceProvider\":{\"id\":\"google-antigravity\",\"name\":\"Google Antigravity\"},\"baseUrl\":\"https://cloudcode-pa.googleapis.com\",\"defaultModel\":\"gemini-3.8-flash-high\",\"nativeModels\":"), STR_LEN("{\"id\":\"agy-official\",\"name\":\"Antigravity 官方\",\"kind\":\"responsesRelay\",\"serviceProvider\":{\"id\":\"google-antigravity\",\"name\":\"Google Antigravity\"},\"baseUrl\":\"https://cloudcode-pa.googleapis.com\",\"defaultModel\":\"gemini-3.8-flash-high\",\"nativeModels\":"));
    n = n + ab_append_bytes(out, out_cap, n, models_p, models_len);
    n = n + ab_append_bytes(out, out_cap, n, STR_PTR(",\"modelAliases\":[],\"stationType\":\"official\",\"channelMode\":\"fast\",\"remark\":\"Antigravity Official (Google OAuth)\",\"groups\":[{\"id\":\"default\",\"name\":\"default\",\"baseUrl\":\"https://cloudcode-pa.googleapis.com\",\"kind\":\"text\",\"status\":\"enabled\",\"groupRatio\":1,\"models\":"), STR_LEN(",\"modelAliases\":[],\"stationType\":\"official\",\"channelMode\":\"fast\",\"remark\":\"Antigravity Official (Google OAuth)\",\"groups\":[{\"id\":\"default\",\"name\":\"default\",\"baseUrl\":\"https://cloudcode-pa.googleapis.com\",\"kind\":\"text\",\"status\":\"enabled\",\"groupRatio\":1,\"models\":"));
    n = n + ab_append_bytes(out, out_cap, n, models_p, models_len);
    n = n + ab_append_bytes(out, out_cap, n, STR_PTR(",\"responseProtocol\":\"gemini\",\"responseProtocolMode\":\"fixed\",\"remark\":\"Antigravity 官方直连 (Google OAuth)\",\"authType\":\"none\",\"credentialMode\":\"group\",\"keyMode\":\"single\",\"keys\":[]}],\"createdAt\":"), STR_LEN(",\"responseProtocol\":\"gemini\",\"responseProtocolMode\":\"fixed\",\"remark\":\"Antigravity 官方直连 (Google OAuth)\",\"authType\":\"none\",\"credentialMode\":\"group\",\"keyMode\":\"single\",\"keys\":[]}],\"createdAt\":"));
    n = n + append_u64(out, out_cap, n, now);
    n = n + ab_append_bytes(out, out_cap, n, STR_PTR(",\"updatedAt\":"), STR_LEN(",\"updatedAt\":"));
    n = n + append_u64(out, out_cap, n, now);
    n = n + ab_append_bytes(out, out_cap, n, STR_PTR("}"), 1);
    *out_len = n;
}

// AgySession (interface) + AgySessionSnapshot (same fields +
// turns/messages). Strings are caller/doc-owned slots.
struct AgyTurnRow {
    id: [u8; 64],
    id_len: u64,
    status: [u8; 32],
    status_len: u64,
    createdAt: u64,
}

struct AgySession {
    threadId_ptr: ptr,
    threadId_len: u64,
    ownerId_ptr: ptr,
    ownerId_len: u64,
    has_ownerId: bool,
    cwd_ptr: ptr,
    cwd_len: u64,
    addDirs_ptr: ptr,
    addDirs_len: u64,
    has_addDirs: bool,
    model_ptr: ptr,
    model_len: u64,
    has_model: bool,
    effort_ptr: ptr,
    effort_len: u64,
    has_effort: bool,
    developerInstructions_ptr: ptr,
    developerInstructions_len: u64,
    has_developerInstructions: bool,
    mode: u64,
    has_mode: bool,
    conversationId_ptr: ptr,
    conversationId_len: u64,
    has_conversationId: bool,
    providerId_ptr: ptr,
    providerId_len: u64,
    has_providerId: bool,
    groupId_ptr: ptr,
    groupId_len: u64,
    has_groupId: bool,
    preview_ptr: ptr,
    preview_len: u64,
    has_preview: bool,
    goalObjective_ptr: ptr,
    goalObjective_len: u64,
    has_goalObjective: bool,
    goal_null: bool,
    goalStatus_ptr: ptr,
    goalStatus_len: u64,
    has_goalStatus: bool,
    activeTurnId: [u8; 64],
    activeTurnId_len: u64,
    has_activeTurnId: bool,
    pending_deadline: u64,
    has_pending: bool,
    pending_prompt: [u8; 262144],
    pending_prompt_len: u64,
    pending_turnId: [u8; 64],
    pending_turnId_len: u64,
    pending_compact: bool,
    proxy: AgyProxyServer,
    has_proxy: bool,
    runtime: AgyCompatibleRuntime,
    has_runtime: bool,
    turns: [AgyTurnRow; 256],
    turns_count: u64,
    messages: [u8; 1048576],
    messages_len: u64,
    msg_off: [u64; 2048],
