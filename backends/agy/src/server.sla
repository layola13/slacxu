// Converted 1:1 from backends/agy/src/server.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
//
// Antigravity — server side (kind "backend"). Independent plugin.
// Phase 1: declaration level — the runtime/bridge and installation
// discovery move here from the host in Phase 2.
//
// SDK types (EngineHandle, EngineStatus, PluginInstallation,
// ServerHost, ServerPlugin) come from @cxu/sdk-backend/server —
// see the sdk-backend unit. Re-export of AGY_MANIFEST mirrors
// `export { AGY_MANIFEST }` from ./manifest.sla;
// AGY_OFFICIAL_PROVIDER_ID is imported from ./runtime/agyBridge.sla.
@import "./manifest.sla"
@import "./runtime/agyBridge.sla"
@import "sa_std/string.sa"

// class AgyEngine implements EngineHandle.
// #status: EngineStatus = { phase: "stopped", transport: "stdio" } —
// string fields kept as (ptr, len) into string literals.
struct AgyEngine {
    pluginId_ptr: ptr,
    pluginId_len: u64,
    status_phase_ptr: ptr,
    status_phase_len: u64,
    status_transport_ptr: ptr,
    status_transport_len: u64,
}

fn AgyEngine_new(self: &AgyEngine) -> void {
    self.pluginId_ptr = STR_PTR("agy");
    self.pluginId_len = STR_LEN("agy");
    self.status_phase_ptr = STR_PTR("stopped");
    self.status_phase_len = STR_LEN("stopped");
    self.status_transport_ptr = STR_PTR("stdio");
    self.status_transport_len = STR_LEN("stdio");
}

// DEFECT: async — TS `async start(): Promise<EngineStatus>`;
// converted to a synchronous fn returning a status code; the
// resulting EngineStatus is self.status_*.
fn AgyEngine_start(self: &AgyEngine) -> i32 {
    self.status_phase_ptr = STR_PTR("ready");
    self.status_phase_len = STR_LEN("ready");
    self.status_transport_ptr = STR_PTR("stdio");
    self.status_transport_len = STR_LEN("stdio");
    return 0;
}

// DEFECT: async — TS `async stop(): Promise<void>`.
fn AgyEngine_stop(self: &AgyEngine) -> i32 {
    self.status_phase_ptr = STR_PTR("stopped");
    self.status_phase_len = STR_LEN("stopped");
    self.status_transport_ptr = STR_PTR("stdio");
    self.status_transport_len = STR_LEN("stdio");
    return 0;
}

// status(): EngineStatus — TS returns this.#status; here the
// caller reads self.status_phase_* / self.status_transport_*.
fn AgyEngine_status(self: &AgyEngine) -> void {
}

// DEFECT: async + throw + unknown return — TS
// `async handleRpc(): Promise<unknown>` throws
// Error("agy plugin engine is not wired to the host yet (phase 1 declaration)").
// SLA has no exceptions; returns error code 1.
fn AgyEngine_handleRpc(self: &AgyEngine, out_ptr: ptr, out_len: &u64) -> i32 {
    return 1;
}

// export const agyServerPlugin: ServerPlugin — an object literal
// with function properties. SLA struct literals cannot hold
// closures; descriptor data is kept as fields and each function
// property becomes a free fn below.
// DEFECT: dynamic object / closures in ServerPlugin literal.
// Extra field vs the sibling plugins: officialProviderId:
// AGY_OFFICIAL_PROVIDER_ID, and cliSettings.linkKey:
// "agyCompatibleCliSettings".
struct AgyServerPlugin {
    manifest_doc: u64,
    officialProviderId_ptr: ptr,
    officialProviderId_len: u64,
    cliSettings_slug_ptr: ptr,
    cliSettings_slug_len: u64,
    cliSettings_enabledEnvVar_ptr: ptr,
    cliSettings_enabledEnvVar_len: u64,
    cliSettings_linkKey_ptr: ptr,
    cliSettings_linkKey_len: u64,
    discovery_preferredPathPrefKey_ptr: ptr,
    discovery_preferredPathPrefKey_len: u64,
}

fn agyServerPlugin_new(self: &AgyServerPlugin, manifest_doc: u64) -> void {
    self.manifest_doc = manifest_doc;
    // officialProviderId = AGY_OFFICIAL_PROVIDER_ID (agyBridge.sla).
    self.officialProviderId_ptr = AGY_OFFICIAL_PROVIDER_ID_ptr();
    self.officialProviderId_len = AGY_OFFICIAL_PROVIDER_ID_len();
    self.cliSettings_slug_ptr = STR_PTR("agy-cli");
    self.cliSettings_slug_len = STR_LEN("agy-cli");
    self.cliSettings_enabledEnvVar_ptr = STR_PTR("CODEX_UI_AGY_COMPATIBLE_CLI_ENABLED");
    self.cliSettings_enabledEnvVar_len = STR_LEN("CODEX_UI_AGY_COMPATIBLE_CLI_ENABLED");
    self.cliSettings_linkKey_ptr = STR_PTR("agyCompatibleCliSettings");
    self.cliSettings_linkKey_len = STR_LEN("agyCompatibleCliSettings");
    self.discovery_preferredPathPrefKey_ptr = STR_PTR("cliPreferredAgyPath");
    self.discovery_preferredPathPrefKey_len = STR_LEN("cliPreferredAgyPath");
}

// discovery.binaryNames: ["agy"]
fn agyServerPlugin_discovery_binaryNames(idx: u64, out: &ptr, out_len: &u64) -> bool {
    if idx != 0 { return false; };
    *out = STR_PTR("agy");
    *out_len = STR_LEN("agy");
    return true;
}

// discovery.envBinVars: ["AGY_BIN", "CODEX_UI_AGY_BIN"]
fn agyServerPlugin_discovery_envBinVars(idx: u64, out: &ptr, out_len: &u64) -> bool {
    if idx == 0 {
        *out = STR_PTR("AGY_BIN");
        *out_len = STR_LEN("AGY_BIN");
        return true;
    };
    if idx == 1 {
        *out = STR_PTR("CODEX_UI_AGY_BIN");
        *out_len = STR_LEN("CODEX_UI_AGY_BIN");
        return true;
    };
    return false;
}

// discovery.matchesKind: () => true
fn agyServerPlugin_discovery_matchesKind() -> bool {
    return true;
}

// createEngine(_host: ServerHost): EngineHandle — returns a new engine.
fn agyServerPlugin_createEngine(host: u64, out: &AgyEngine) -> void {
    AgyEngine_new(out);
}

// DEFECT: async — TS `async findInstallations(): Promise<PluginInstallation[]>` returns [].
fn agyServerPlugin_findInstallations(out_count: &u64) -> i32 {
    *out_count = 0;
    return 0;
}

// skillRoots(): string[] — returns [] for agy.
fn agyServerPlugin_skillRoots(idx: u64, out: &ptr, out_len: &u64) -> bool {
    return false;
}
