// Converted 1:1 from backends/codex/src/manifest.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
// Source comment (1:1): Codex manifest — the single source is ../plugin.json; both sides
// import it from here so the web side never pulls in server code.

// DEFECT: JSON import with import attribute (`with { type: "json" }`) has no SLA counterpart; plugin.json content is represented as a JSON text buffer constant placeholder.
// DEFECT: PluginManifest type imported from @cxu/sdk-backend has no SLA counterpart in this pass; represented by a local struct with a JSON text buffer (dynamic object).
@import "sa_std/io/print.sai"

// PluginManifest (from @cxu/sdk-backend) — dynamic manifest object.
// DEFECT: dynamic object — full PluginManifest shape is a dynamic JSON object; stored as JSON text buffer.
struct PluginManifest {
    json: [u8; 4096],
    json_len: u64,
}

// manifestJson: imported value of ../plugin.json.
// DEFECT: JSON module import not supported; value must be filled by host/build step from ../plugin.json.
const CODEX_MANIFEST_JSON: [u8; 4096] = [0u8; 4096];
const CODEX_MANIFEST_JSON_LEN: u64 = 0;

// export const CODEX_MANIFEST: PluginManifest = manifestJson as PluginManifest;
// DEFECT: type assertion `as PluginManifest` has no SLA counterpart; approximated by copying the JSON buffer into a PluginManifest value.
fn codex_manifest() -> PluginManifest {
    let manifest = PluginManifest { json: [0u8; 4096], json_len: 0 };
    manifest.json_len = CODEX_MANIFEST_JSON_LEN;
    for i in 0..CODEX_MANIFEST_JSON_LEN {
        manifest.json[i] = CODEX_MANIFEST_JSON[i];
    }
    return manifest;
}
