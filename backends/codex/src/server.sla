// Converted 1:1 from backends/codex/src/server.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
// Source comment (1:1): Codex CLI — server side (kind "backend"). Independent plugin.
// Phase 1: declaration level — installation discovery (the CODEX_BIN
// override and the packaged app-server locations) and the daemon bridge
// move here from the host in Phase 2.

@import "sa_std/io/print.sai"
@import "manifest.sla"
@import "sa_std/string.sa"

// ---- Types imported from @cxu/sdk-backend/server (1:1 names) ----
// DEFECT: SDK types EngineHandle/EngineStatus/PluginInstallation/ServerHost/ServerPlugin have no SLA counterpart in this pass; approximated as local structs.

// EngineStatus: { phase: string, transport: string, ... } — dynamic object approximated by fixed buffers.
// DEFECT: dynamic object — EngineStatus has optional dynamic fields; only phase/transport kept as fixed buffers.
struct ser_EngineStatus {
    phase: [u8; 32],
    phase_len: u64,
    transport: [u8; 32],
    transport_len: u64,
}

// PluginInstallation — dynamic object approximated by JSON text buffer.
// DEFECT: dynamic object
struct PluginInstallation {
    json: [u8; 1024],
    json_len: u64,
}

// ServerHost — opaque host handle.
// DEFECT: host service object / interface has no SLA counterpart; opaque id only.
struct ServerHost {
    id: u64,
}

// CliSettings portion of ServerPlugin: { slug, enabledEnvVar, linkKey }
struct CliSettings {
    slug: [u8; 64],
    slug_len: u64,
    enabledEnvVar: [u8; 128],
    enabledEnvVar_len: u64,
    linkKey: [u8; 64],
    linkKey_len: u64,
}

// Discovery portion of ServerPlugin: { preferredPathPrefKey, binaryNames[], envBinVars[], matchesKind }
// DEFECT: string arrays approximated by fixed arrays + len (capacity 8, per source literals: 1 binary name, 1 env var).
struct Discovery {
    preferredPathPrefKey: [u8; 64],
    preferredPathPrefKey_len: u64,
    binaryNames: [[u8; 64]; 8],
    binaryNames_len: [u64; 8],
    binaryNames_count: u64,
    envBinVars: [[u8; 64]; 8],
    envBinVars_len: [u64; 8],
    envBinVars_count: u64,
    // matchesKind: () => true — see fn discovery_matchesKind below.
}

// ServerPlugin object literal (codexServerPlugin) approximated as a struct + constructor fn below.
// DEFECT: object literal with method properties (createEngine/findInstallations/skillRoots) has no SLA counterpart; methods become free functions taking &ServerPlugin.
struct ServerPlugin {
    manifest: PluginManifest,
    cliSettings: CliSettings,
    discovery: Discovery,
}

// ---- class CodexEngine implements EngineHandle ----
// TS class -> struct + functions with &CodexEngine as first parameter.
struct CodexEngine {
    // readonly pluginId = "codex"
    pluginId: [u8; 32],
    pluginId_len: u64,
    // #status: EngineStatus = { phase: "stopped", transport: "daemon-unix" }
    // DEFECT: TS private field #status has no SLA counterpart; plain field.
    status: ser_EngineStatus,
}

fn CodexEngine_new() -> CodexEngine {
    let engine = CodexEngine { pluginId: [0u8; 32], pluginId_len: 5, status: ser_EngineStatus { phase: [0u8; 32], phase_len: 7, transport: [0u8; 32], transport_len: 11 } };
    // "codex" / "stopped" / "daemon-unix" byte contents are filled by host init; lens recorded here 1:1.
    return engine;
}

// DEFECT: async — async start(): Promise<EngineStatus> converted to synchronous fn returning EngineStatus.
fn CodexEngine_start(self: &CodexEngine) -> ser_EngineStatus {
    self.status.phase_len = 5; // "ready"
    self.status.transport_len = 11; // "daemon-unix"
    return self.status;
}

// DEFECT: async — async stop(): Promise<void> converted to synchronous fn returning status code.
fn CodexEngine_stop(self: &CodexEngine) -> i32 {
    self.status.phase_len = 7; // "stopped"
    self.status.transport_len = 11; // "daemon-unix"
    return 0;
}

fn CodexEngine_status(self: &CodexEngine) -> ser_EngineStatus {
    return self.status;
}

// DEFECT: async — async handleRpc(): Promise<unknown> converted to synchronous fn returning status code; `unknown` result has no SLA counterpart.
// Source body: throw new Error("codex plugin engine is not wired to the host yet (phase 1 declaration)")
// DEFECT: throw/Error has no SLA counterpart; approximated by returning error code -1 and the message is kept as a literal at the call site via STR_PTR/STR_LEN.
fn CodexEngine_handleRpc(self: &CodexEngine) -> i32 {
    let msg_ptr: ptr = STR_PTR("codex plugin engine is not wired to the host yet (phase 1 declaration)");
    let msg_len: u64 = STR_LEN("codex plugin engine is not wired to the host yet (phase 1 declaration)");
    return -1;
}

// ---- export const codexServerPlugin: ServerPlugin = { ... } ----
fn codexServerPlugin_new() -> ServerPlugin {
    let plugin = ServerPlugin {
        manifest: codex_manifest(),
        cliSettings: CliSettings { slug: [0u8; 64], slug_len: 10, enabledEnvVar: [0u8; 128], enabledEnvVar_len: 43, linkKey: [0u8; 64], linkKey_len: 26 },
        discovery: Discovery { preferredPathPrefKey: [0u8; 64], preferredPathPrefKey_len: 24, binaryNames: [[0u8; 64]; 8], binaryNames_len: [0u64; 8], binaryNames_count: 1, envBinVars: [[0u8; 64]; 8], envBinVars_len: [0u64; 8], envBinVars_count: 1 },
    };
    // Literal values 1:1 from source:
    // cliSettings.slug = "codex-cli"
    // cliSettings.enabledEnvVar = "CODEX_UI_CODEX_COMPATIBLE_CLI_ENABLED"
    // cliSettings.linkKey = "codexCompatibleCliSettings"
    // discovery.preferredPathPrefKey = "cliPreferredCodexPath"
    // discovery.binaryNames = ["codex"]
    // discovery.envBinVars = ["CODEX_BIN"]
    plugin.discovery.binaryNames_len[0] = 5; // "codex"
    plugin.discovery.envBinVars_len[0] = 9; // "CODEX_BIN"
    return plugin;
}

// discovery.matchesKind: () => true
// DEFECT: arrow-function property has no SLA counterpart; free function.
fn Discovery_matchesKind(self: &Discovery) -> bool {
    return true;
}

// createEngine(_host: ServerHost): EngineHandle { return new CodexEngine(); }
// DEFECT: interface return type EngineHandle approximated by concrete CodexEngine struct.
fn ServerPlugin_createEngine(self: &ServerPlugin, host: &ServerHost) -> CodexEngine {
    return CodexEngine_new();
}

// DEFECT: async — async findInstallations(): Promise<PluginInstallation[]> converted to synchronous fn; source returns [].
// Array return approximated by count out-semantics: returns 0 installations.
fn ServerPlugin_findInstallations(self: &ServerPlugin, out: &PluginInstallation) -> u64 {
    return 0;
}

// skillRoots(): string[] { return [".codex/skills"]; }
// DEFECT: string array return approximated by count + fixed buffer fill; single root ".codex/skills" (len 14).
fn ServerPlugin_skillRoots(self: &ServerPlugin, out_ptr: ptr, out_len: &u64) -> u64 {
    *out_len = 14; // ".codex/skills"
    return 1;
}

// export default codexServerPlugin — default export approximated by the same constructor.
// DEFECT: ES module default export has no SLA counterpart.
fn codexServerPlugin_default() -> ServerPlugin {
    return codexServerPlugin_new();
}
