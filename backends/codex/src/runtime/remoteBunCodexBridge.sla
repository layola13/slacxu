// DEFECT: async — async restart(): Promise<EngineStatus> { this.stop(); return await this.start(); }
fn RemoteBunCodexBridge_restart(self: &RemoteBunCodexBridge, out: &rbcb_EngineStatus) -> i32 {
    RemoteBunCodexBridge_stop(self);
    return RemoteBunCodexBridge_start(self, out);
}

// DEFECT: async — async request(method, params?): Promise<JsonValue>
// Source: await ensureConnected();
// try { result = asRecord(await transport.request(tunnelId!, "POST", "/api/codex/rpc", { method, params }, apiSession!)); }
// catch (error) { if (!isRemoteTransportFailure(error)) throw error; const reconnecting = this.reconnect(error);
//   if (!isRemoteRpcRetrySafe(method)) { void reconnecting.catch(() => undefined); throw error; }
//   await reconnecting; result = asRecord(await transport.request(... same ...)); }
// const data = asRecord(result.data ?? result); return (data.result ?? data) as JsonValue;
// DEFECT: non-null assertions (tunnelId!/apiSession!), ?? fallbacks and `as` cast approximated by has_* flags + buffer selection in fix phase.
fn RemoteBunCodexBridge_request(self: &RemoteBunCodexBridge, method_ptr: ptr, method_len: u64, params: &rbcb_JsonValue, out: &rbcb_JsonValue) -> i32 {
    let rc: i32 = RemoteBunCodexBridge_ensureConnected(self);
    if rc != 0 { return rc; };
    let body = rbcb_JsonValue { json: [0u8; 8192], json_len: 0 }; // { method, params } JSON built in fix phase
    let result = rbcb_JsonValue { json: [0u8; 8192], json_len: 0 };
    let tunnel_ptr: ptr = PTR_NULL();
    let session_ptr: ptr = PTR_NULL();
    rc = RemoteBunTransport_request(&self.transport, tunnel_ptr, self.tunnelId_len, STR_PTR("POST"), STR_LEN("POST"), STR_PTR("/api/codex/rpc"), STR_LEN("/api/codex/rpc"), &body, true, session_ptr, self.apiSession_len, true, &result);
    if rc != 0 {
        // catch branch: transport-failure classification needs the error message; approximated by rc==-2 meaning transport failure in fix phase.
        // DEFECT: error value inspection approximated by reserved rc.
        if rc != -2 { return rc; };
        // const reconnecting = this.reconnect(error);
        if !isRemoteRpcRetrySafe(method_ptr, method_len) {
            // void reconnecting.catch(() => undefined); throw error;
            let rstatus = rbcb_EngineStatus { phase: [0u8; 32], phase_len: 0, transport: [0u8; 32], transport_len: 0, message: [0u8; 1024], message_len: 0, has_message: false, startedAt: 0, has_startedAt: false };
            RemoteBunCodexBridge_reconnect(self, &rstatus);
            return rc;
        };
        let rstatus2 = rbcb_EngineStatus { phase: [0u8; 32], phase_len: 0, transport: [0u8; 32], transport_len: 0, message: [0u8; 1024], message_len: 0, has_message: false, startedAt: 0, has_startedAt: false };
        let rrc: i32 = RemoteBunCodexBridge_reconnect(self, &rstatus2);
        if rrc != 0 { return rrc; };
        // retry once with the (new) tunnel/session
        rc = RemoteBunTransport_request(&self.transport, tunnel_ptr, self.tunnelId_len, STR_PTR("POST"), STR_LEN("POST"), STR_PTR("/api/codex/rpc"), STR_LEN("/api/codex/rpc"), &body, true, session_ptr, self.apiSession_len, true, &result);
        if rc != 0 { return rc; };
    };
    // data = asRecord(result.data ?? result); return data.result ?? data — buffer selection in fix phase.
    out.json_len = result.json_len;
    for i in 0..result.json_len {
        out.json[i] = result.json[i];
    }
    return 0;
}

// DEFECT: async — async notify(method, params?): Promise<void> { await this.request(method, params); }
