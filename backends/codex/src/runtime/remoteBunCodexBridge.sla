// DEFECT: async — async start(): Promise<EngineStatus>
// Source: if (phase==="ready") return getStatus(); if (this.starting) return await this.starting;
// this.starting = this.startInternal(); try { return await this.starting; } finally { this.starting = null; }
fn RemoteBunCodexBridge_start(self: &RemoteBunCodexBridge, out: &rbcb_EngineStatus) -> i32 {
    if self.status.phase_len == 5 {
        *out = self.status;
        return 0;
    };
    if self.has_starting {
        *out = self.starting_status;
        return 0;
    };
    self.has_starting = true;
    let rc: i32 = RemoteBunCodexBridge_startInternal(self, out);
    self.starting_status = *out;
    self.has_starting = false; // finally
    return rc;
}

// DEFECT: async — private async startInternal(): Promise<EngineStatus>
fn RemoteBunCodexBridge_startInternal(self: &RemoteBunCodexBridge, out: &rbcb_EngineStatus) -> i32 {
    // this.status = { phase: "starting", transport: "stdio", message: "Connecting to remote Bun Server", startedAt: Date.now() }; emit("status", getStatus());
    self.status.phase_len = 8; // "starting"
    self.status.message_len = 31; // "Connecting to remote Bun Server"
    self.status.has_message = true;
    self.status.startedAt = 0; // DEFECT: Date.now() approximated
    self.status.has_startedAt = true;
    RemoteBunCodexBridge_emit_status(self);
    // try { await this.connect(false); } catch (error) { this.releaseConnection(); throw error; }
    let rc: i32 = RemoteBunCodexBridge_connect(self, false);
    if rc != 0 {
        RemoteBunCodexBridge_releaseConnection(self);
        *out = self.status;
        return rc;
    };
    self.pollAbort = false;
    // void this.pollEvents(); — fire-and-forget async loop.
    // DEFECT: floating async loop approximated: host pump drives RemoteBunCodexBridge_pollEventsStep; one step invoked here.
    RemoteBunCodexBridge_pollEventsStep(self);
    // this.status = { phase: "ready", transport: "stdio", message: "Remote Bun Server ready" }; emit; return getStatus();
    self.status.phase_len = 5; // "ready"
    self.status.message_len = 23; // "Remote Bun Server ready"
    RemoteBunCodexBridge_emit_status(self);
    *out = self.status;
    return 0;
}

fn RemoteBunCodexBridge_stop(self: &RemoteBunCodexBridge) -> i32 {
    self.pollAbort = true;
    self.connectionGeneration = self.connectionGeneration + 1;
    // const tunnelId = this.tunnelId; const session = this.apiSession; this.tunnelId = null; this.apiSession = null;
    let had_tunnel: bool = self.has_tunnelId;
    let had_session: bool = self.has_apiSession;
    let tunnel_len: u64 = self.tunnelId_len;
    let session_len: u64 = self.apiSession_len;
    self.has_tunnelId = false;
    self.tunnelId_len = 0;
    self.has_apiSession = false;
    self.apiSession_len = 0;
    if had_tunnel {
        if had_session {
            // void transport.request(tunnelId, "DELETE", `/api/codex/sessions/${encodeURIComponent(session)}`, undefined, session)
            //   .catch(() => undefined).finally(() => transport.closeTunnel(tunnelId));
            // DEFECT: Promise chain .catch/.finally + encodeURIComponent + template literal path approximated sequentially: DELETE request (errors ignored), then closeTunnel.
            let body = rbcb_JsonValue { json: [0u8; 8192], json_len: 0 };
            let resp = rbcb_JsonValue { json: [0u8; 8192], json_len: 0 };
            let tunnel_ptr: ptr = PTR_NULL();
            RemoteBunTransport_request(&self.transport, tunnel_ptr, tunnel_len, STR_PTR("DELETE"), STR_LEN("DELETE"), STR_PTR("/api/codex/sessions/"), STR_LEN("/api/codex/sessions/"), &body, false, tunnel_ptr, session_len, true, &resp);
            RemoteBunTransport_closeTunnel(&self.transport, tunnel_ptr, tunnel_len);
        } else {
            let tunnel_ptr: ptr = PTR_NULL();
            RemoteBunTransport_closeTunnel(&self.transport, tunnel_ptr, tunnel_len);
        };
    };
    // this.status = { phase: "stopped", transport: "stdio", message: "Detached; remote task continues" }; emit("status", ...);
    self.status.phase_len = 7; // "stopped"
    self.status.message_len = 31; // "Detached; remote task continues"
    self.status.has_message = true;
    RemoteBunCodexBridge_emit_status(self);
    return 0;
}

// DEFECT: async — async interrupt(threadId, turnId): Promise<JsonValue> { await ensureConnected(); return await request("turn/interrupt", { threadId, turnId }); }
// DEFECT: object literal params { threadId, turnId } approximated by JSON buffer built in fix phase.
fn RemoteBunCodexBridge_interrupt(self: &RemoteBunCodexBridge, thread_id_ptr: ptr, thread_id_len: u64, turn_id_ptr: ptr, turn_id_len: u64, out: &rbcb_JsonValue) -> i32 {
