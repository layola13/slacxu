// public respond(id, result?, error?): void — synchronous in source (fire-and-forget by contract, see source comment).
// Source: if (!tunnelId || !apiSession) { emit("stderr", "Dropped a response for remote request " + String(id) + ": the remote node is detached\n"); return; }
// void transport.request(tunnelId, "POST", "/api/codex/server-request/respond", { requestId: id, ...(error ? { error } : { result: result ?? {} }) }, apiSession)
//   .catch((cause) => emit("stderr", "Failed to answer remote request " + String(id) + ": " + (cause instanceof Error ? cause.message : String(cause)) + "\n"));
// DEFECT: spread-conditional object + String(id) concatenation + Promise .catch closure approximated sequentially; string building in fix phase.
fn RemoteBunCodexBridge_respond(self: &RemoteBunCodexBridge, id: &rbcb_JsonRpcId, result: &rbcb_JsonValue, has_result: bool, error: &rbcb_JsonRpcError, has_error: bool) -> i32 {
    if !self.has_tunnelId {
        RemoteBunCodexBridge_emit_stderr(self, STR_PTR("Dropped a response for remote request "), STR_LEN("Dropped a response for remote request "));
        return 0;
    };
    if !self.has_apiSession {
        RemoteBunCodexBridge_emit_stderr(self, STR_PTR("Dropped a response for remote request "), STR_LEN("Dropped a response for remote request "));
        return 0;
    };
    let body = rbcb_JsonValue { json: [0u8; 8192], json_len: 0 }; // { requestId: id, error|result } built in fix phase
    let resp = rbcb_JsonValue { json: [0u8; 8192], json_len: 0 };
    let tunnel_ptr: ptr = PTR_NULL();
    let session_ptr: ptr = PTR_NULL();
    let rc: i32 = RemoteBunTransport_request(&self.transport, tunnel_ptr, self.tunnelId_len, STR_PTR("POST"), STR_LEN("POST"), STR_PTR("/api/codex/server-request/respond"), STR_LEN("/api/codex/server-request/respond"), &body, true, session_ptr, self.apiSession_len, true, &resp);
    if rc != 0 {
        // .catch handler: emit("stderr", "Failed to answer remote request " + String(id) + ": " + message + "\n")
        RemoteBunCodexBridge_emit_stderr(self, STR_PTR("Failed to answer remote request "), STR_LEN("Failed to answer remote request "));
    };
    return 0;
}

// DEFECT: async — private async pollEvents(): Promise<void> — while (!pollAbort && tunnelId && apiSession) { try { ... } catch { ... } }
// Long-poll loop split into a step fn (one iteration) + driver fn preserving the loop, because SLA has no async loop task.
// One iteration: query = new URLSearchParams({ after: String(cursor), waitMs: "30000", limit: "512", threadId: route.threadId });
// result = asRecord(await transport.request(tunnelId, "GET", `/api/codex/events?${query}`, undefined, apiSession));
// data = asRecord(result.data ?? result); events = Array.isArray(data.events) ? data.events : [];
// for (const value of events) { const event = asRecord(value); cursor = Math.max(cursor, number(event.id) ?? 0); emit("cursor", cursor);
//   if (event.kind === "notification" || event.kind === "serverRequest") emit("message", event.payload); }
// DEFECT: URLSearchParams, template literal URL, Array.isArray, dynamic event objects approximated: URL built in fix phase; events iterated from JSON array buffer with per-event extraction helpers.
fn RemoteBunCodexBridge_pollEventsStep(self: &RemoteBunCodexBridge) -> i32 {
    let body = rbcb_JsonValue { json: [0u8; 8192], json_len: 0 };
    let result = rbcb_JsonValue { json: [0u8; 8192], json_len: 0 };
    let tunnel_ptr: ptr = PTR_NULL();
    let session_ptr: ptr = PTR_NULL();
    // path = "/api/codex/events?after=<cursor>&waitMs=30000&limit=512&threadId=<route.threadId>" (built in fix phase)
    let rc: i32 = RemoteBunTransport_request(&self.transport, tunnel_ptr, self.tunnelId_len, STR_PTR("GET"), STR_LEN("GET"), STR_PTR("/api/codex/events?"), STR_LEN("/api/codex/events?"), &body, false, session_ptr, self.apiSession_len, true, &result);
    if rc != 0 {
        if self.pollAbort { return 1; }; // catch: if (pollAbort) return;
        // if (!isRemoteTransportFailure(error)) { status = { phase:"error", ... message }; emit status; return; }
        if rc != -2 {
            self.status.phase_len = 5; // "error"
            RemoteBunCodexBridge_emit_status(self);
            return 1;
        };
        // try { await reconnect(error); } catch { return; }
        let rstatus = rbcb_EngineStatus { phase: [0u8; 32], phase_len: 0, transport: [0u8; 32], transport_len: 0, message: [0u8; 1024], message_len: 0, has_message: false, startedAt: 0, has_startedAt: false };
        let rrc: i32 = RemoteBunCodexBridge_reconnect(self, &rstatus);
        if rrc != 0 { return 1; };
        return 0;
    };
    // events loop: count/ids/kinds/payloads extracted in fix phase; cursor advance + emits per event:
    // (loop body preserved above; sequential per-event work:)
    //   self.cursor = max(self.cursor, event_id); emit_cursor; if kind notification/serverRequest: emit_message(payload)
    return 0;
}

fn RemoteBunCodexBridge_pollEvents(self: &RemoteBunCodexBridge) -> i32 {
    while !self.pollAbort {
        if !self.has_tunnelId { break; };
        if !self.has_apiSession { break; };
        let rc: i32 = RemoteBunCodexBridge_pollEventsStep(self);
        if rc == 1 { break; };
    }
    return 0;
}

// DEFECT: async — private async ensureConnected(): Promise<void>
// if (phase==="ready" && tunnelId && apiSession) return; if (this.reconnecting) { await this.reconnecting; return; } await this.start();
fn RemoteBunCodexBridge_ensureConnected(self: &RemoteBunCodexBridge) -> i32 {
    if self.status.phase_len == 5 {
        if self.has_tunnelId {
            if self.has_apiSession { return 0; };
        };
    };
    if self.has_reconnecting {
        return 0; // await stored reconnecting promise (status in reconnecting_status)
    };
    let out = rbcb_EngineStatus { phase: [0u8; 32], phase_len: 0, transport: [0u8; 32], transport_len: 0, message: [0u8; 1024], message_len: 0, has_message: false, startedAt: 0, has_startedAt: false };
    return RemoteBunCodexBridge_start(self, &out);
}

// DEFECT: async — private async reconnect(cause: unknown): Promise<EngineStatus>
// Source: if (pollAbort) throw cause; if (this.reconnecting) return await it;
// const generation = ++this.connectionGeneration;
// this.reconnecting = (async () => { releaseConnection(); let lastError = cause;
//   for (let attempt = 0; !pollAbort && generation === connectionGeneration && attempt < REMOTE_RECONNECT_MAX_ATTEMPTS; attempt++) {
//     delayMs = remoteReconnectDelayMs(attempt);
//     message = attempt+1 < MAX ? `SSH connection lost; reconnecting in ${delayMs}ms (attempt ${attempt+1})` : `... (final attempt ${attempt+1}/${MAX})`;
//     status = { phase: "reconnecting", transport: "stdio", message }; emit status;
//     await delay(delayMs);
//     try { await connect(true); status = { phase:"ready", ..., message:"Remote Bun Server reconnected" }; emit; return getStatus(); }
//     catch (error) { lastError = error; releaseConnection(); } }
//   if (!pollAbort && generation === connectionGeneration) { status = { phase:"error", ..., message: `SSH reconnect exhausted after ${MAX} attempts: ${message}` }; emit; }
//   throw lastError; })();
// try { return await this.reconnecting; } finally { this.reconnecting = null; }
// DEFECT: async IIFE Promise + throw of unknown cause + template literals approximated sequentially with rc propagation.
fn RemoteBunCodexBridge_reconnect(self: &RemoteBunCodexBridge, out: &rbcb_EngineStatus) -> i32 {
    if self.pollAbort { return -1; }; // throw cause
    if self.has_reconnecting {
        *out = self.reconnecting_status;
        return 0;
    };
    self.connectionGeneration = self.connectionGeneration + 1;
    let generation: u64 = self.connectionGeneration;
    self.has_reconnecting = true;
    RemoteBunCodexBridge_releaseConnection(self);
    let last_rc: i32 = -1;
    let attempt: u64 = 0;
    while attempt < 8 {
        if self.pollAbort { break; };
        if generation != self.connectionGeneration { break; };
        let delay_ms: u64 = remoteReconnectDelayMs(attempt);
        // status = { phase: "reconnecting", transport: "stdio", message: <attempt/final-attempt template> }
        self.status.phase_len = 12; // "reconnecting"
        self.status.has_message = true;
        RemoteBunCodexBridge_emit_status(self);
        // await delay(delayMs) — host sleep.
        // DEFECT: Promise delay approximated by host sleep call in fix phase.
        let rc: i32 = RemoteBunCodexBridge_connect(self, true);
        if rc == 0 {
            self.status.phase_len = 5; // "ready"
            self.status.message_len = 30; // "Remote Bun Server reconnected"
            RemoteBunCodexBridge_emit_status(self);
            *out = self.status;
            self.has_reconnecting = false;
            return 0;
        };
        last_rc = rc;
        RemoteBunCodexBridge_releaseConnection(self);
        attempt = attempt + 1;
    }
    if !self.pollAbort {
        if generation == self.connectionGeneration {
            // status = { phase: "error", ..., message: `SSH reconnect exhausted after 8 attempts: ${lastError message}` }
            self.status.phase_len = 5; // "error"
            self.status.has_message = true;
            RemoteBunCodexBridge_emit_status(self);
        };
    };
    self.has_reconnecting = false; // finally
    *out = self.status;
    return last_rc; // throw lastError
}

// DEFECT: async — private async connect(preserveCursor: boolean): Promise<void>
// Source: const previousCursor = this.cursor;
// const tunnel = await transport.openTunnel(route.command, route.remotePort); this.tunnelId = tunnel.tunnelId;
// try { await transport.request(tunnelId, "POST", "/api/engine/start");
//   const session = asRecord(await transport.request(tunnelId, "POST", "/api/codex/sessions"));
//   const data = asRecord(session.data ?? session); this.apiSession = text(data.sessionId);
//   if (!apiSession) throw new Error("Remote Bun Server did not create an API session");
//   this.cursor = preserveCursor ? previousCursor : this.cursor > 0 ? this.cursor : number(data.cursor) ?? 0;
// } catch (error) { transport.closeTunnel(tunnelId); this.tunnelId = null; this.apiSession = null; throw error; }
// DEFECT: nested ternary + ?? + dynamic session object approximated sequentially.
fn RemoteBunCodexBridge_connect(self: &RemoteBunCodexBridge, preserve_cursor: bool) -> i32 {
    let previous_cursor: u64 = self.cursor;
    let tunnel = TunnelHandle { tunnelId: [0u8; 256], tunnelId_len: 0 };
    let rc: i32 = RemoteBunTransport_openTunnel(&self.transport, STR_PTR(""), 0, self.route.remotePort, &tunnel);
    // NOTE: command bytes are route.command (ptr/len) — passed via STR_PTR placeholder above; fix phase wires route buffer pointer.
    if rc != 0 { return rc; };
    self.tunnelId_len = tunnel.tunnelId_len;
    self.has_tunnelId = true;
    let body = rbcb_JsonValue { json: [0u8; 8192], json_len: 0 };
    let resp = rbcb_JsonValue { json: [0u8; 8192], json_len: 0 };
    let tunnel_ptr: ptr = PTR_NULL();
    rc = RemoteBunTransport_request(&self.transport, tunnel_ptr, self.tunnelId_len, STR_PTR("POST"), STR_LEN("POST"), STR_PTR("/api/engine/start"), STR_LEN("/api/engine/start"), &body, false, tunnel_ptr, 0, false, &resp);
    if rc == 0 {
        rc = RemoteBunTransport_request(&self.transport, tunnel_ptr, self.tunnelId_len, STR_PTR("POST"), STR_LEN("POST"), STR_PTR("/api/codex/sessions"), STR_LEN("/api/codex/sessions"), &body, false, tunnel_ptr, 0, false, &resp);
    };
    if rc == 0 {
        // data.sessionId via text(): string && non-empty else null; data.cursor via number()
        // DEFECT: dynamic field extraction approximated; session id length stored by transport helper in fix phase.
        if self.apiSession_len == 0 {
            // throw new Error("Remote Bun Server did not create an API session") — falls into catch branch below.
            rc = -1;
        };
    };
    if rc != 0 {
        RemoteBunTransport_closeTunnel(&self.transport, tunnel_ptr, self.tunnelId_len);
        self.has_tunnelId = false;
        self.tunnelId_len = 0;
        self.has_apiSession = false;
        self.apiSession_len = 0;
        return rc;
    };
    self.has_apiSession = self.apiSession_len > 0;
    if preserve_cursor {
        self.cursor = previous_cursor;
    } else {
        if self.cursor == 0 {
            // self.cursor = number(data.cursor) ?? 0 — extracted in fix phase.
            self.cursor = 0;
        };
    };
    return 0;
}

fn RemoteBunCodexBridge_releaseConnection(self: &RemoteBunCodexBridge) -> i32 {
    // const tunnelId = this.tunnelId; this.tunnelId = null; this.apiSession = null; if (tunnelId) transport.closeTunnel(tunnelId);
    let had: bool = self.has_tunnelId;
    let len: u64 = self.tunnelId_len;
    self.has_tunnelId = false;
    self.tunnelId_len = 0;
    self.has_apiSession = false;
    self.apiSession_len = 0;
    if had {
        let tunnel_ptr: ptr = PTR_NULL();
        RemoteBunTransport_closeTunnel(&self.transport, tunnel_ptr, len);
    };
    return 0;
}

// ---- Module-level helpers ----

// function asRecord(value: unknown): Record<string, unknown>
// return value && typeof value === "object" && !Array.isArray(value) ? value : {};
// DEFECT: dynamic object check approximated: JSON buffer is treated as record iff it parses as an object (fix phase); here identity copy semantics noted.
fn asRecord(value: &rbcb_JsonValue, out: &rbcb_JsonValue) -> i32 {
    out.json_len = value.json_len;
    for i in 0..value.json_len {
        out.json[i] = value.json[i];
    }
    return 0;
}

// function text(value: unknown): string | null — typeof string && non-empty ? value : null.
// DEFECT: unknown value inspection approximated by (is_string flag, len).
fn text(is_string: bool, in_ptr: ptr, in_len: u64, out_len: &u64) -> bool {
    if !is_string { *out_len = 0; return false; };
    if in_len == 0 { *out_len = 0; return false; };
    *out_len = in_len;
    return true;
}

// function number(value: unknown): number | null — typeof number && Number.isFinite ? value : null.
// DEFECT: unknown value inspection approximated by (is_number flag, value).
fn number_helper(is_number: bool, value: f64, out: &f64) -> bool {
    if !is_number { return false; };
    *out = value;
    return true;
}

// function safeCursor(value: unknown): number
// const cursor = Number(value); return Number.isSafeInteger(cursor) && cursor >= 0 ? cursor : 0;
// DEFECT: Number() coercion of unknown approximated by explicit value + presence flag.
fn safeCursor(value: u64, has_value: bool) -> u64 {
    if !has_value { return 0; };
    return value;
}

// function delay(ms: number): Promise<void> { return new Promise((resolve) => setTimeout(resolve, ms)); }
// DEFECT: async — Promise/setTimeout delay approximated by host sleep; synchronous placeholder.
fn delay(ms: u64) -> i32 { return 0; }

// export function remoteReconnectDelayMs(attempt: number): number
// if (attempt <= 0) return 250; return Math.min(30_000, 500 * 2 ** Math.min(attempt - 1, 6));
// DEFECT: exponent operator ** approximated by loop multiplication.
fn remoteReconnectDelayMs(attempt: u64) -> u64 {
    if attempt == 0 { return 250; };
    let exp: u64 = attempt - 1;
    if exp > 6 { exp = 6; };
    let mult: u64 = 1;
    for i in 0..exp {
        mult = mult * 2;
    }
    let value: u64 = 500 * mult;
    if value > 30000 { return 30000; };
    return value;
}

// export function isRemoteRpcRetrySafe(method: string): boolean
// return /^(thread\/(read|turns\/list|items\/list|history\/(fileInfo|tail))|config\/(read|get)|thread\/goal\/get)$/.test(method);
// DEFECT: regex test has no SLA counterpart; approximated by prefix/exact length dispatch (full byte compare in fix phase).
// Safe set: thread/read, thread/turns/list, thread/items/list, thread/history/fileInfo, thread/history/tail,
//           config/read, config/get, thread/goal/get.
fn isRemoteRpcRetrySafe(method_ptr: ptr, method_len: u64) -> bool {
    if method_len == 11 { return true; }; // thread/read | config/read is 11 too — both safe
    if method_len == 10 { return true; }; // config/get
    if method_len == 15 { return true; }; // thread/goal/get
    if method_len == 17 { return true; }; // thread/turns/list | thread/items/list
    if method_len == 19 { return true; }; // thread/history/tail
    if method_len == 23 { return true; }; // thread/history/fileInfo
    return false;
}

