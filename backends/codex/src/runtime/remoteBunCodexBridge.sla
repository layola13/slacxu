fn RemoteBunCodexBridge_new(route: &RemoteThreadRoutePick, transport: &RemoteBunTransport) -> RemoteBunCodexBridge {
    let bridge = RemoteBunCodexBridge {
        status: rbcb_EngineStatus { phase: [0u8; 32], phase_len: 4, transport: [0u8; 32], transport_len: 5, message: [0u8; 1024], message_len: 0, has_message: false, startedAt: 0, has_startedAt: false },
        tunnelId: [0u8; 256],
        tunnelId_len: 0,
        has_tunnelId: false,
        apiSession: [0u8; 256],
        apiSession_len: 0,
        has_apiSession: false,
        cursor: 0,
        pollAbort: false,
        has_starting: false,
        starting_status: rbcb_EngineStatus { phase: [0u8; 32], phase_len: 0, transport: [0u8; 32], transport_len: 0, message: [0u8; 1024], message_len: 0, has_message: false, startedAt: 0, has_startedAt: false },
        has_reconnecting: false,
        reconnecting_status: rbcb_EngineStatus { phase: [0u8; 32], phase_len: 0, transport: [0u8; 32], transport_len: 0, message: [0u8; 1024], message_len: 0, has_message: false, startedAt: 0, has_startedAt: false },
        connectionGeneration: 0,
        route: *route,
        transport: *transport,
        listeners_status: 0,
        listeners_message: 0,
        listeners_stderr: 0,
        listeners_cursor: 0,
    };
    // status = { phase: "idle", transport: "stdio" }; this.cursor = safeCursor(route.eventCursor);
    bridge.cursor = safeCursor(route.eventCursor, route.has_eventCursor);
    return bridge;
}

