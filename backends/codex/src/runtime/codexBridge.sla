// ---- Shared JSON-RPC / JSON value types (from @codex-ui/shared) ----
// DEFECT: dynamic JSON (JsonValue) has no SLA counterpart; approximated by JSON text buffer everywhere below.
// DEFECT: generics / union types (JsonRpcId = string|number) approximated by tagged struct.
struct JsonValue {
    json: [u8; 8192],
    json_len: u64,
}

struct JsonRpcId {
    is_number: bool,
    num: i64,
    str: [u8; 128],
    str_len: u64,
}

struct JsonRpcError {
    message: [u8; 1024],
    message_len: u64,
    code: i64,
    has_code: bool,
}

// JsonRpcMessage: { id?, method?, params?, result?, error? } — dynamic object.
// DEFECT: dynamic object
struct JsonRpcMessage {
    has_id: bool,
    id: JsonRpcId,
    has_method: bool,
    method: [u8; 128],
    method_len: u64,
    params: JsonValue,
    has_result: bool,
    result: JsonValue,
    has_error: bool,
    error: JsonRpcError,
}

// JsonRpcFailure = { error: JsonRpcError } — folded into JsonRpcError above.
// DEFECT: type alias / structural typing approximated.

// EngineStatus (from @codex-ui/shared): dynamic status object.
// DEFECT: dynamic object — optional fields (codexBin/codexVersion/appServerUserAgent/codexHome/startedAt/message) as fixed buffers + presence flags.
struct EngineStatus {
    phase: [u8; 32],
    phase_len: u64,
    transport: [u8; 32],
    transport_len: u64,
    codexBin: [u8; 512],
    codexBin_len: u64,
    has_codexBin: bool,
    codexVersion: [u8; 128],
    codexVersion_len: u64,
    has_codexVersion: bool,
    appServerUserAgent: [u8; 512],
    appServerUserAgent_len: u64,
    has_appServerUserAgent: bool,
    codexHome: [u8; 512],
    codexHome_len: u64,
    has_codexHome: bool,
    startedAt: u64,
    has_startedAt: bool,
    message: [u8; 1024],
    message_len: u64,
    has_message: bool,
}

// type PendingRequest = { resolve, reject, method }
// DEFECT: closure/callback fields (resolve/reject) have no SLA counterpart; pending table stores method + slot index, resolution is delivered by handleLine directly to the waiting caller state.
struct PendingRequest {
    id: [u8; 32],
    id_len: u64,
    method: [u8; 128],
    method_len: u64,
    resolved: bool,
    rejected: bool,
    result: JsonValue,
    error: JsonRpcError,
    has_timer: bool,
    timeout_ms: u64,
}

// Pending table: source uses Map<string, PendingRequest>; fixed capacity 256.
// DEFECT: Map dynamic collection approximated by fixed array + count.
struct PendingTable {
    items: [PendingRequest; 256],
    count: u64,
}

// function stringifyError(error: unknown): string
// DEFECT: `unknown` type + instanceof Error check approximated by (is_error flag, ptr,len) input; result written to out buffer.
fn stringifyError(is_error: bool, msg_ptr: ptr, msg_len: u64, out_ptr: ptr, out_len: &u64) -> u64 {
    out_len = msg_len;
    return msg_len;
}

// ---- Extern / host-service surface (pluginHostServices().codex.* and process) ----
// DEFECT: Node child_process ChildProcessWithoutNullStreams, readline createInterface, process.env/process.cwd/Date.now have no direct SLA counterpart; approximated via sa_std process spawn-bidirectional externs and host-service function ids.
// runtimeEnv: () => NodeJS.ProcessEnv — callback returning dynamic env object.
// DEFECT: closure returning dynamic object; represented by an env JSON buffer owned by the bridge.
struct ProcessEnv {
    json: [u8; 8192],
    json_len: u64,
}

// PluginHostServices["codex"]["spawnCodexCommand"] / ["findCodexBinary"] — injected function values.
// DEFECT: dependency-injected function values / default parameter expressions calling pluginHostServices() at construction time; approximated by host-service selector ids (0 = default host service).
struct CodexBridge {
    // private child: ChildProcessWithoutNullStreams | null — child process handle (0 = null).
    child: u64,
    // private nextId = 1
    nextId: u64,
    // private pending = new Map<string, PendingRequest>()
    pending: PendingTable,
    // private status: EngineStatus = { phase: "idle", transport: "stdio" }
    status: EngineStatus,
    // private recovery: Promise<EngineStatus> | null
    // DEFECT: Promise field approximated by flag + stored status.
    has_recovery: bool,
    recovery_status: EngineStatus,
    // constructor-injected: runtimeEnv callback env buffer
    runtimeEnv: ProcessEnv,
    // constructor-injected: spawnCommand / findBinary host-service selector ids
    spawnCommand_id: u64,
    findBinary_id: u64,
    // EventEmitter state: registered listener counts for "status"/"message"/"stderr".
    // DEFECT: EventEmitter inheritance (extends EventEmitter) has no SLA counterpart; emit() becomes direct fn calls CodexBridge_emit_* below.
    listeners_status: u64,
    listeners_message: u64,
    listeners_stderr: u64,
}

fn CodexBridge_new(runtimeEnv: &ProcessEnv, spawnCommand_id: u64, findBinary_id: u64) -> CodexBridge {
    let bridge = CodexBridge {
        child: 0,
        nextId: 1,
        pending: PendingTable { items: [PendingRequest { id: [0u8; 32], id_len: 0, method: [0u8; 128], method_len: 0, resolved: false, rejected: false, result: JsonValue { json: [0u8; 8192], json_len: 0 }, error: JsonRpcError { message: [0u8; 1024], message_len: 0, code: 0, has_code: false }, has_timer: false, timeout_ms: 0 }; 256], count: 0 },
        status: EngineStatus { phase: [0u8; 32], phase_len: 4, transport: [0u8; 32], transport_len: 5, codexBin: [0u8; 512], codexBin_len: 0, has_codexBin: false, codexVersion: [0u8; 128], codexVersion_len: 0, has_codexVersion: false, appServerUserAgent: [0u8; 512], appServerUserAgent_len: 0, has_appServerUserAgent: false, codexHome: [0u8; 512], codexHome_len: 0, has_codexHome: false, startedAt: 0, has_startedAt: false, message: [0u8; 1024], message_len: 0, has_message: false },
        has_recovery: false,
        recovery_status: EngineStatus { phase: [0u8; 32], phase_len: 0, transport: [0u8; 32], transport_len: 0, codexBin: [0u8; 512], codexBin_len: 0, has_codexBin: false, codexVersion: [0u8; 128], codexVersion_len: 0, has_codexVersion: false, appServerUserAgent: [0u8; 512], appServerUserAgent_len: 0, has_appServerUserAgent: false, codexHome: [0u8; 512], codexHome_len: 0, has_codexHome: false, startedAt: 0, has_startedAt: false, message: [0u8; 1024], message_len: 0, has_message: false },
        runtimeEnv: ProcessEnv { json: [0u8; 8192], json_len: 0 },
        spawnCommand_id: spawnCommand_id,
        findBinary_id: findBinary_id,
        listeners_status: 0,
        listeners_message: 0,
        listeners_stderr: 0,
    };
    // status.phase = "idle", status.transport = "stdio" (lens set above; bytes filled by init helper)
    bridge.runtimeEnv.json_len = runtimeEnv.json_len;
    for i in 0..runtimeEnv.json_len {
        bridge.runtimeEnv.json[i] = runtimeEnv.json[i];
    }
    return bridge;
}

// EventEmitter emit() approximations.
