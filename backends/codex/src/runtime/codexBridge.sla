fn CodexBridge_emit_status(self: &CodexBridge) -> i32 { return 0; }
fn CodexBridge_emit_message(self: &CodexBridge, msg: &JsonRpcMessage) -> i32 { return 0; }
fn CodexBridge_emit_stderr(self: &CodexBridge, msg_ptr: ptr, msg_len: u64) -> i32 { return 0; }

fn CodexBridge_getStatus(self: &CodexBridge) -> EngineStatus {
    // return { ...this.status } — spread copy approximated by struct copy.
    return self.status;
}

fn CodexBridge_setStatus(self: &CodexBridge, status: &EngineStatus) -> i32 {
    self.status = status;
    CodexBridge_emit_status(self);
    return 0;
}

fn CodexBridge_resolveCodexBin(self: &CodexBridge, out_ptr: ptr, out_len: &u64) -> i32 {
    // return this.findBinary();
    // DEFECT: host service findCodexBinary() call approximated; host fills out buffer, length returned in out_len.
    out_len = 0;
    return 0;
}

// DEFECT: async — async start(): Promise<EngineStatus> -> synchronous fn returning status code, result status written to out.
// Source flow preserved step by step in comments + sequential calls.
fn CodexBridge_start(self: &CodexBridge, out: &EngineStatus) -> i32 {
    // if (phase === "ready" || phase === "starting") return getStatus();
    if self.status.phase_len == 5 {
        out = self.status;
        return 0;
    };
    // const codexBin = this.resolveCodexBin();
    let codexBin_len: u64 = 0;
    let codexBin_ptr: ptr = PTR_NULL();
    CodexBridge_resolveCodexBin(self, codexBin_ptr, &codexBin_len);
    // setStatus({ phase: "starting", codexBin, startedAt: Date.now(), message: "Starting codex app-server" })
    // DEFECT: Date.now() approximated by host-provided startedAt value (0 in this pass).
    let starting = self.status;
    starting.phase_len = 8; // "starting"
    starting.codexBin_len = codexBin_len;
    starting.has_codexBin = true;
    starting.startedAt = 0;
    starting.has_startedAt = true;
    starting.message_len = 25; // "Starting codex app-server"
    starting.has_message = true;
    CodexBridge_setStatus(self, &starting);
    // const child = this.spawnCommand(codexBin, pluginHostServices().codex.codexAppServerArgs(codexBin), { cwd: process.cwd(), env: { ...process.env, ...this.runtimeEnv() } });
    // DEFECT: spawn options dynamic object (cwd/env spread) approximated by runtimeEnv JSON buffer; child handle stored as id.
    self.child = 1;
    // child.once("exit"/"error"), child.stdin.once("error") -> invalidateChild(child, ...)
    // DEFECT: event listener registration (once/on) approximated; the handlers' logic lives in CodexBridge_invalidateChild and is invoked by the host event pump.
    // const stdout = createInterface({ input: child.stdout }); stdout.on("line", handleLine); child.stderr.on("data", redact+emit "stderr")
    // DEFECT: readline line stream approximated by host pump calling CodexBridge_handleLine / stderr forwarding (redactSecrets applied first).
    // try { const initialize = await requestOnChild("initialize", {clientInfo:{name:"codex-tui",title:"Codex TUI",version:"0.1.0"},capabilities:{experimentalApi:true,mcpServerOpenaiFormElicitation:true}}); await notify("initialized", {}); ... setStatus(ready...) ; void readCodexVersion(...).then(...) ; return getStatus(); }
    // DEFECT: async/await + try/catch + floating Promise .then approximated sequentially; error branch sets phase "error" and returns -1 (source rethrows new Error(message)).
    let init_result = JsonValue { json: [0u8; 8192], json_len: 0 };
    let rc: i32 = CodexBridge_requestOnChild(self, STR_PTR("initialize"), STR_LEN("initialize"), &init_result, 15000, &init_result);
    if rc != 0 {
        CodexBridge_stop(self);
        let err_status = self.status;
        err_status.phase_len = 5; // "error"
        err_status.codexBin_len = codexBin_len;
        err_status.has_codexBin = true;
        CodexBridge_setStatus(self, &err_status);
        out = self.status;
        return -1;
    };
    CodexBridge_notify(self, STR_PTR("initialized"), STR_LEN("initialized"), &init_result);
    // const init = initialize as Record<...> — userAgent/codexHome string fields extracted from init JSON.
    // DEFECT: dynamic JSON field access (init.userAgent / init.codexHome typeof string checks) approximated; extraction done by JSON helper in fix phase.
    let ready = self.status;
    ready.phase_len = 5; // "ready"
    ready.codexBin_len = codexBin_len;
    ready.has_codexBin = true;
    ready.has_codexVersion = false; // codexVersion: undefined in source at this point
    ready.message_len = 22; // "Codex app-server ready"
    ready.has_message = true;
    CodexBridge_setStatus(self, &ready);
    // void this.readCodexVersion(codexBin).then((ver) => { if (ver && phase==="ready") setStatus({...status, codexVersion: ver}) })
    // DEFECT: Promise .then closure capturing mutable state approximated sequentially.
    let ver_len: u64 = 0;
    let ver_ptr: ptr = PTR_NULL();
    CodexBridge_readCodexVersion(self, codexBin_ptr, codexBin_len, ver_ptr, &ver_len);
    if ver_len > 0 {
        let with_ver = self.status;
        with_ver.codexVersion_len = ver_len;
        with_ver.has_codexVersion = true;
        CodexBridge_setStatus(self, &with_ver);
    };
    out = self.status;
    return 0;
}

fn CodexBridge_stop(self: &CodexBridge) -> i32 {
    // for (const request of this.pending.values()) request.reject({ message: "Codex app-server stopped" });
    for i in 0..self.pending.count {
        self.pending.items[i].rejected = true;
        self.pending.items[i].error.message_len = 25; // "Codex app-server stopped"
    }
    self.pending.count = 0; // this.pending.clear()
    let stopped = self.status;
    stopped.phase_len = 7; // "stopped"
    stopped.message_len = 7; // "Stopped"
    stopped.has_message = true;
    CodexBridge_setStatus(self, &stopped);
    // this.child?.kill("SIGTERM"); this.child = null;
    // DEFECT: optional chaining + ChildProcess.kill approximated by host kill call on handle id.
    self.child = 0;
    return 0;
}

// DEFECT: async — async restart(): Promise<EngineStatus> { this.stop(); return this.start(); }
fn CodexBridge_restart(self: &CodexBridge, out: &EngineStatus) -> i32 {
    CodexBridge_stop(self);
    return CodexBridge_start(self, out);
}

// DEFECT: async — async request(method, params?, timeoutMs = 15000): Promise<JsonValue> { await ensureRunning(); return requestOnChild(...); }
fn CodexBridge_request(self: &CodexBridge, method_ptr: ptr, method_len: u64, params: &JsonValue, timeout_ms: u64, out: &JsonValue) -> i32 {
    let rc: i32 = CodexBridge_ensureRunning(self);
    if rc != 0 { return rc; };
    return CodexBridge_requestOnChild(self, method_ptr, method_len, params, timeout_ms, out);
}

// DEFECT: async — private async requestOnChild(...): Promise<JsonValue> built on new Promise((resolve,reject)=>{ setTimeout...; pending.set(...); this.send(payload); })
// DEFECT: Promise constructor + setTimeout/clearTimeout timer approximated: pending entry records timeout_ms; host pump enforces timeout and rejects with "Request '<method>' timed out after <timeoutMs>ms".
fn CodexBridge_requestOnChild(self: &CodexBridge, method_ptr: ptr, method_len: u64, params: &JsonValue, timeout_ms: u64, out: &JsonValue) -> i32 {
    if self.child == 0 {
        // throw new Error("Codex app-server is not running")
        return -1;
    };
    let id: u64 = self.nextId;
    self.nextId = self.nextId + 1;
    // const payload: JsonRpcMessage = { id, method, params };
    let payload = JsonRpcMessage { has_id: true, id: JsonRpcId { is_number: true, num: 0, str: [0u8; 128], str_len: 0 }, has_method: true, method: [0u8; 128], method_len: method_len, params: params, has_result: false, result: JsonValue { json: [0u8; 8192], json_len: 0 }, has_error: false, error: JsonRpcError { message: [0u8; 1024], message_len: 0, code: 0, has_code: false } };
    payload.id.num = id;
    // this.pending.set(String(id), { resolve wrapper clearing timer, reject wrapper clearing timer, method })
    if self.pending.count < 256 {
        let entry = PendingRequest { id: [0u8; 32], id_len: 0, method: [0u8; 128], method_len: method_len, resolved: false, rejected: false, result: JsonValue { json: [0u8; 8192], json_len: 0 }, error: JsonRpcError { message: [0u8; 1024], message_len: 0, code: 0, has_code: false }, has_timer: timeout_ms > 0, timeout_ms: timeout_ms };
        self.pending.items[self.pending.count] = entry;
        self.pending.count = self.pending.count + 1;
    };
    // try { this.send(payload); } catch (error) { pending.delete; clearTimeout; reject({message: stringifyError(error)}); }
    let src: i32 = CodexBridge_send(self, &payload);
    if src != 0 {
        // remove the pending entry just added (sequential approximation of delete(String(id)))
        if self.pending.count > 0 { self.pending.count = self.pending.count - 1; };
        return -1;
    };
    // Resolution is delivered asynchronously in source; in this synchronous approximation the host pump fills out via handleLine before returning.
    out.json_len = 0;
    return 0;
}

// DEFECT: async — async notify(method, params?): Promise<void> { this.send({ method, params }); }
fn CodexBridge_notify(self: &CodexBridge, method_ptr: ptr, method_len: u64, params: &JsonValue) -> i32 {
    let msg = JsonRpcMessage { has_id: false, id: JsonRpcId { is_number: true, num: 0, str: [0u8; 128], str_len: 0 }, has_method: true, method: [0u8; 128], method_len: method_len, params: params, has_result: false, result: JsonValue { json: [0u8; 8192], json_len: 0 }, has_error: false, error: JsonRpcError { message: [0u8; 1024], message_len: 0, code: 0, has_code: false } };
    return CodexBridge_send(self, &msg);
}

fn CodexBridge_respond(self: &CodexBridge, id: &JsonRpcId, result: &JsonValue, has_result: bool, error: &JsonRpcError, has_error: bool) -> i32 {
    // if (error) send({ id, error }) else send({ id, result: result ?? {} })
    // DEFECT: nullish coalescing `result ?? {}` approximated by has_result flag; empty object = zero-len JSON buffer convention in this pass.
    let msg = JsonRpcMessage { has_id: true, id: id, has_method: false, method: [0u8; 128], method_len: 0, params: JsonValue { json: [0u8; 8192], json_len: 0 }, has_result: !has_error, result: result, has_error: has_error, error: error };
    return CodexBridge_send(self, &msg);
}

fn CodexBridge_send(self: &CodexBridge, message: &JsonRpcMessage) -> i32 {
    if self.child == 0 {
        // throw new Error("Codex app-server is not running")
        return -1;
    };
    // this.child.stdin.write(`${JSON.stringify(message)}\n`);
    // DEFECT: JSON.stringify of dynamic message + template literal approximated by JSON text buffer serialization of the message (fix phase: sa_json_*).
    return 0;
}

// DEFECT: async — private async ensureRunning(): Promise<void>
// Source: if (this.recovery) { await this.recovery; return; } if (this.child) return; if (phase==="stopped") throw; if (!this.recovery) this.recovery = this.start().finally(() => { this.recovery = null; }); await this.recovery; if (!this.child) throw;
fn CodexBridge_ensureRunning(self: &CodexBridge) -> i32 {
    if self.has_recovery {
        // await this.recovery — already-completed status stored in recovery_status.
        return 0;
    };
    if self.child != 0 { return 0; };
    if self.status.phase_len == 7 {
        // phase "stopped" candidate — source compares phase string value, not length; length check is the approximation used throughout this file.
        // throw new Error("Codex app-server is stopped")
        return -1;
    };
    self.has_recovery = true;
    let out = EngineStatus { phase: [0u8; 32], phase_len: 0, transport: [0u8; 32], transport_len: 0, codexBin: [0u8; 512], codexBin_len: 0, has_codexBin: false, codexVersion: [0u8; 128], codexVersion_len: 0, has_codexVersion: false, appServerUserAgent: [0u8; 512], appServerUserAgent_len: 0, has_appServerUserAgent: false, codexHome: [0u8; 512], codexHome_len: 0, has_codexHome: false, startedAt: 0, has_startedAt: false, message: [0u8; 1024], message_len: 0, has_message: false };
    let rc: i32 = CodexBridge_start(self, &out);
    self.recovery_status = out;
    self.has_recovery = false; // .finally(() => { this.recovery = null; })
    if rc != 0 { return rc; };
    if self.child == 0 {
        // throw new Error("Codex app-server is not running")
        return -1;
    };
    return 0;
}

fn CodexBridge_invalidateChild(self: &CodexBridge, child: u64, msg_ptr: ptr, msg_len: u64) -> i32 {
    if self.child != child { return 0; };
    for i in 0..self.pending.count {
        self.pending.items[i].rejected = true;
        self.pending.items[i].error.message_len = msg_len;
    }
    self.pending.count = 0;
    self.child = 0;
    // if (this.status.phase !== "stopped") setStatus({ ...status, phase: "error", message })
    let st = self.status;
    st.phase_len = 5; // "error"
    st.message_len = msg_len;
    st.has_message = true;
    CodexBridge_setStatus(self, &st);
    return 0;
}

fn CodexBridge_handleLine(self: &CodexBridge, line_ptr: ptr, line_len: u64) -> i32 {
    // if (line.trim().length === 0) return;
    if line_len == 0 { return 0; };
    // let message: JsonRpcMessage; try { message = JSON.parse(line) } catch { emit("stderr", `Unparseable app-server stdout: ${redactSecrets(line)}`); return; }
    // DEFECT: JSON.parse / try-catch approximated: host JSON parser returns nonzero on failure; template literal approximated by prefix literal + redacted line emit in fix phase.
    let msg = JsonRpcMessage { has_id: false, id: JsonRpcId { is_number: true, num: 0, str: [0u8; 128], str_len: 0 }, has_method: false, method: [0u8; 128], method_len: 0, params: JsonValue { json: [0u8; 8192], json_len: 0 }, has_result: false, result: JsonValue { json: [0u8; 8192], json_len: 0 }, has_error: false, error: JsonRpcError { message: [0u8; 1024], message_len: 0, code: 0, has_code: false } };
    let parsed: bool = true; // placeholder for JSON.parse success in this bulk pass
    if !parsed {
        CodexBridge_emit_stderr(self, line_ptr, line_len);
        return 0;
    };
    // if ("id" in message && pending.has(String(message.id))) { resolve/reject pending; return; }
    // DEFECT: `in` operator + Map.has/get/delete approximated by linear scan of pending table by stringified id.
    if msg.has_id {
        for i in 0..self.pending.count {
            // match on String(id): id_len comparison is the approximation in this pass.
            if self.pending.items[i].id_len == msg.id.str_len {
                if msg.has_error {
                    self.pending.items[i].rejected = true;
                    self.pending.items[i].error = msg.error;
                } else {
                    self.pending.items[i].resolved = true;
                    if msg.has_result {
                        self.pending.items[i].result = msg.result;
                    };
                    // else pending.resolve({}) — empty object convention.
                };
                // pending.delete: shift-remove approximated by count shrink of last slot bookkeeping in fix phase.
                return 0;
            };
        }
    };
    // this.emit("message", message);
    CodexBridge_emit_message(self, &msg);
    return 0;
}

// DEFECT: async — private async readCodexVersion(codexBin): Promise<string|undefined> built on new Promise with setTimeout(3000), stdout data accumulation, once exit/error.
