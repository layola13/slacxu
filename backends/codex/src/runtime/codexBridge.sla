fn CodexBridge_readCodexVersion(self: &CodexBridge, codexBin_ptr: ptr, codexBin_len: u64, out_ptr: ptr, out_len: &u64) -> i32 {
    out_len = 0; // resolve(output.trim() || undefined) — empty output => undefined => len 0
    return 0;
}

