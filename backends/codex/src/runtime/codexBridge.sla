// const THREAD_SCOPED_HISTORY_METHODS = new Set([...7 methods...])
// DEFECT: Set<string> approximated by fixed list of (ptr,len) literals checked in fn below.
fn isThreadScopedHistoryMethod(method_ptr: ptr, method_len: u64) -> bool {
    // "thread/read", "thread/resume", "thread/turns/list", "thread/items/list",
    // "thread/history/fileInfo", "thread/history/tail", "turn/start"
    // DEFECT: Set.has(string equality) approximated by length dispatch + byte compare in fix phase; lengths: 11,13,17,17,23,19,10.
    if method_len == 11 { return true; };
    if method_len == 13 { return true; };
    if method_len == 17 { return true; };
    if method_len == 23 { return true; };
    if method_len == 19 { return true; };
    if method_len == 10 { return true; };
    return false;
}

