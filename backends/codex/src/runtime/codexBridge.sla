}

// function redactSecrets(value: string): string — three regex replaces:
//   /sk-[A-Za-z0-9_-]{12,}/g -> "sk-***"
//   /Bearer\s+[A-Za-z0-9._~+/=-]{12,}/gi -> "Bearer ***"
//   /api[_-]?key["'=:\s]+[A-Za-z0-9._~+/=-]{8,}/gi -> "api_key=***"
// DEFECT: regex replace has no SLA/sa_std counterpart in this pass; approximated as in-place copy with length preserved, redaction to be implemented in fix phase.
fn redactSecrets(in_ptr: ptr, in_len: u64, out_ptr: ptr, out_len: &u64) -> u64 {
    out_len = in_len;
    return in_len;
}

// ---- export class AutoFallbackCodexRuntimeClient extends EventEmitter implements CodexRuntimeClient ----
// DEFECT: class inheritance (extends EventEmitter) + interface implementation approximated as struct + function family (same pattern as CodexBridge).
// CodexRuntimeClient references are type-tagged handles: kind 0=CodexBridge, 1=DaemonCodexBridge, 2=other host bridge (Mini/codecli fallback).
struct CodexRuntimeClientRef {
    kind: u64,
    bridge: CodexBridge,
    daemon: DaemonCodexBridge,
}

struct AutoFallbackCodexRuntimeClient {
    activeClient_kind: u64,
    // private activeClient: CodexRuntimeClient — represented by kind + the two concrete slots below via primary/fallback refs.
    primaryClient: CodexRuntimeClientRef,
    fallbackClient: CodexRuntimeClientRef,
    isFallback: bool,
    listeners_status: u64,
    listeners_message: u64,
    listeners_stderr: u64,
}

fn AutoFallbackCodexRuntimeClient_new(primary: &CodexRuntimeClientRef, fallback: &CodexRuntimeClientRef, has_fallback: bool) -> AutoFallbackCodexRuntimeClient {
    let client = AutoFallbackCodexRuntimeClient {
        activeClient_kind: primary.kind,
        primaryClient: primary,
        fallbackClient: fallback,
        isFallback: false,
        listeners_status: 0,
        listeners_message: 0,
        listeners_stderr: 0,
    };
    // fallbackClient ?? pluginHostServices().mini.createFallbackBridge()
    // DEFECT: nullish coalescing + host service default approximated by has_fallback flag; when false the host supplies the Mini fallback bridge in fix phase.
    // this.activeClient = this.primaryClient; this.wirePrimaryEvents();
    AutoFallbackCodexRuntimeClient_wirePrimaryEvents(&client);
    return client;
}

// private wirePrimaryEvents(): primaryClient.on("status"/"message"/"stderr", closures)
// DEFECT: event subscription with closures capturing `this` and mutable isFallback; approximated by dispatch fns below which the host event pump calls.
fn AutoFallbackCodexRuntimeClient_wirePrimaryEvents(self: &AutoFallbackCodexRuntimeClient) -> i32 { return 0; }

// Handler for primary "status": if (status.phase==="error" && !isFallback) { console.warn(...); activateFallback(); return; } if (!isFallback) emit("status", status);
// DEFECT: console.warn approximated by stderr emit in fix phase.
fn AutoFallbackCodexRuntimeClient_onPrimaryStatus(self: &AutoFallbackCodexRuntimeClient, status: &EngineStatus) -> i32 {
    if status.phase_len == 5 {
        if !self.isFallback {
            AutoFallbackCodexRuntimeClient_activateFallback(self);
            return 0;
        };
    };
    return 0;
}

fn AutoFallbackCodexRuntimeClient_onPrimaryMessage(self: &AutoFallbackCodexRuntimeClient, msg: &JsonRpcMessage) -> i32 {
    return 0; // if (!isFallback) emit("message", msg)
}

fn AutoFallbackCodexRuntimeClient_onPrimaryStderr(self: &AutoFallbackCodexRuntimeClient, err_ptr: ptr, err_len: u64) -> i32 {
    return 0; // if (!isFallback) emit("stderr", err)
}

fn AutoFallbackCodexRuntimeClient_activateFallback(self: &AutoFallbackCodexRuntimeClient) -> i32 {
    if self.isFallback { return 0; };
    self.isFallback = true;
    // try { this.primaryClient.stop(); } catch {}
    // DEFECT: try/catch-empty approximated; stop dispatch by kind in fix phase.
    self.activeClient_kind = self.fallbackClient.kind;
    // fallbackClient.on("status"/"message"/"stderr", guarded closures forwarding only while isFallback)
    // DEFECT: closure guards approximated by AutoFallbackCodexRuntimeClient_onFallback* dispatch fns.
    // this.emit("status", this.getStatus());
    return 0;
}

fn AutoFallbackCodexRuntimeClient_onFallbackStatus(self: &AutoFallbackCodexRuntimeClient, status: &EngineStatus) -> i32 { return 0; }
fn AutoFallbackCodexRuntimeClient_onFallbackMessage(self: &AutoFallbackCodexRuntimeClient, msg: &JsonRpcMessage) -> i32 { return 0; }
fn AutoFallbackCodexRuntimeClient_onFallbackStderr(self: &AutoFallbackCodexRuntimeClient, err_ptr: ptr, err_len: u64) -> i32 { return 0; }

fn AutoFallbackCodexRuntimeClient_isFallbackActive(self: &AutoFallbackCodexRuntimeClient) -> bool {
    return self.isFallback;
}

fn AutoFallbackCodexRuntimeClient_getStatus(self: &AutoFallbackCodexRuntimeClient, out: &EngineStatus) -> i32 {
    // const status = this.activeClient.getStatus();
    // DEFECT: polymorphic dispatch through interface approximated by kind dispatch in fix phase; primary/daemon getStatus called there.
    out = self.primaryClient.bridge.status;
    if self.isFallback {
        // base = status.message ?? "Mini ready"; if base does not include "fallback to Mini active",
        // message = `${base} (fallback to Mini active: Codex runtime unavailable)`
        // DEFECT: template literal + String.includes approximated by message_len bookkeeping in fix phase.
    };
    return 0;
}

// DEFECT: async — async start(): Promise<EngineStatus>
fn AutoFallbackCodexRuntimeClient_start(self: &AutoFallbackCodexRuntimeClient, out: &EngineStatus) -> i32 {
    if self.isFallback {
        // return this.fallbackClient.start();
        out = self.fallbackClient.bridge.status;
        return 0;
    };
    // try { const status = await primaryClient.start(); if (status.phase==="error") { activateFallback(); return fallbackClient.start(); } return status; }
    // catch (error) { console.warn(... stringifyError(error)); activateFallback(); return fallbackClient.start(); }
    // DEFECT: try/catch + console.warn approximated sequentially with rc checks.
    let rc: i32 = CodexBridge_start(&self.primaryClient.bridge, out);
    if rc != 0 {
        AutoFallbackCodexRuntimeClient_activateFallback(self);
        out = self.fallbackClient.bridge.status;
        return 0;
    };
    if out.phase_len == 5 {
        AutoFallbackCodexRuntimeClient_activateFallback(self);
        out = self.fallbackClient.bridge.status;
        return 0;
    };
    return 0;
}

fn AutoFallbackCodexRuntimeClient_stop(self: &AutoFallbackCodexRuntimeClient) -> i32 {
    // this.activeClient.stop(); — dispatch by activeClient_kind in fix phase.
    return 0;
}

// DEFECT: async — async restart(): Promise<EngineStatus>
// Source: if isFallback, retry primary first (start; if phase!=="error" switch back, isFallback=false, emit status, return status; catch -> stay), then fallbackClient.restart(); else return this.start().
fn AutoFallbackCodexRuntimeClient_restart(self: &AutoFallbackCodexRuntimeClient, out: &EngineStatus) -> i32 {
    if self.isFallback {
        let rc: i32 = CodexBridge_start(&self.primaryClient.bridge, out);
        if rc == 0 {
            if out.phase_len != 5 {
                self.activeClient_kind = self.primaryClient.kind;
                self.isFallback = false;
                return 0;
            };
        };
        // return this.fallbackClient.restart();
        return CodexBridge_restart(&self.fallbackClient.bridge, out);
    };
    return AutoFallbackCodexRuntimeClient_start(self, out);
}

// DEFECT: async — async request(method, params?, timeoutMs?): Promise<JsonValue>
// Source guard: if isFallback && isThreadScopedHistoryMethod(method) && threadIdFromParams(params):
//   try return await fallbackClient.request(...); catch (error) { if (!isThreadMissingError(error)) throw error;
//     try return await primaryClient.request(...); catch (primaryError) { throw new Error(`Codex runtime unavailable (fallback to Mini active): ${stringifyError(primaryError)}. Restart the Codex runtime and retry history restore.`); } }
// Otherwise return this.activeClient.request(method, params, timeoutMs).
fn AutoFallbackCodexRuntimeClient_request(self: &AutoFallbackCodexRuntimeClient, method_ptr: ptr, method_len: u64, params: &JsonValue, timeout_ms: u64, out: &JsonValue) -> i32 {
    if self.isFallback {
        if isThreadScopedHistoryMethod(method_ptr, method_len) {
            let tid_len: u64 = 0;
            let tid_ptr: ptr = PTR_NULL();
            if threadIdFromParams(params, tid_ptr, &tid_len) {
                let rc: i32 = CodexBridge_request(&self.fallbackClient.bridge, method_ptr, method_len, params, timeout_ms, out);
                if rc == 0 { return 0; };
                // if (!isThreadMissingError(error)) throw error; — non-missing errors propagate as rc.
                // DEFECT: error-object inspection (isThreadMissingError over thrown value) approximated: rc==-2 reserved for thread-missing in fix phase.
                if rc != -2 { return rc; };
                let prc: i32 = CodexBridge_request(&self.primaryClient.bridge, method_ptr, method_len, params, timeout_ms, out);
                if prc != 0 {
                    // throw new Error("Codex runtime unavailable (fallback to Mini active): ... Restart the Codex runtime and retry history restore.")
                    return -3;
                };
                return 0;
            };
        };
    };
    // return this.activeClient.request(...) — dispatch by activeClient_kind in fix phase; primary bridge used here.
    if self.isFallback {
        return CodexBridge_request(&self.fallbackClient.bridge, method_ptr, method_len, params, timeout_ms, out);
    };
    return CodexBridge_request(&self.primaryClient.bridge, method_ptr, method_len, params, timeout_ms, out);
}

// DEFECT: async — async notify(method, params?): Promise<void> { return this.activeClient.notify(method, params); }
fn AutoFallbackCodexRuntimeClient_notify(self: &AutoFallbackCodexRuntimeClient, method_ptr: ptr, method_len: u64, params: &JsonValue) -> i32 {
    if self.isFallback {
        return CodexBridge_notify(&self.fallbackClient.bridge, method_ptr, method_len, params);
    };
    return CodexBridge_notify(&self.primaryClient.bridge, method_ptr, method_len, params);
}

fn AutoFallbackCodexRuntimeClient_respond(self: &AutoFallbackCodexRuntimeClient, id: &JsonRpcId, result: &JsonValue, has_result: bool, error: &JsonRpcError, has_error: bool) -> i32 {
    if self.isFallback {
        return CodexBridge_respond(&self.fallbackClient.bridge, id, result, has_result, error, has_error);
    };
    return CodexBridge_respond(&self.primaryClient.bridge, id, result, has_result, error, has_error);
}

// ---- export function createCodexRuntimeClient(runtimeEnv, platform = process.platform, fallbackClient?): CodexRuntimeClient ----
// DEFECT: default parameter process.platform + process.env access approximated by explicit platform/mode inputs (mode string buffer + is_windows flag).
// Mode values from process.env.CODEX_UI_APP_SERVER_MODE ?? "auto", trimmed + lowercased.
// DEFECT: string trim/toLowerCase + ?? approximated by caller-normalized mode buffer.
fn createCodexRuntimeClient(runtimeEnv: &ProcessEnv, is_windows: bool, mode_ptr: ptr, mode_len: u64, has_fallback: bool, out_kind: &u64) -> i32 {
    // if (mode === "stdio" || mode === "legacy-stdio") return new VirtualConfigCodexRuntimeClient(new CodexBridge(runtimeEnv));
    // DEFECT: VirtualConfigCodexRuntimeClient wrapper (from @cxu/sdk-backend) approximated by kind tag; wrapping applied by host in fix phase.
    // DEFECT: string equality on mode approximated by length dispatch in this pass (5="stdio", 12="legacy-stdio", 6="daemon", 4="auto", 0="", 7="codecli", 4="mini" — auto/mini share length, disambiguated in fix phase by byte compare).
    if mode_len == 5 { out_kind = 0; return 0; };
    if mode_len == 12 { out_kind = 0; return 0; };
    if mode_len == 6 {
        // mode === "daemon": if (platform === "win32") throw new Error("CODEX_UI_APP_SERVER_MODE=daemon is not supported on Windows because it requires a Unix socket. Use 'auto' or 'stdio'.");
        if is_windows { return -1; };
        // return new VirtualConfigCodexRuntimeClient(new DaemonCodexBridge(resolveDefaultSocketPath(), runtimeEnv));
        out_kind = 1;
        return 0;
    };
    if mode_len == 7 {
        // mode === "codecli": return new VirtualConfigCodexRuntimeClient(pluginHostServices().codeCli.createBridge(runtimeEnv));
        out_kind = 2;
        return 0;
    };
    if mode_len == 4 {
        // mode === "auto" (or "mini", see defect above):
        // auto: if (!pluginHostServices().codex.isCodexCliAvailable(platform)) return VirtualConfig(fallbackClient ?? mini.createFallbackBridge());
        //       client = win32 ? CodexBridge : DaemonCodexBridge; return VirtualConfig(new AutoFallbackCodexRuntimeClient(client, fallbackClient));
        // mini: return VirtualConfig(fallbackClient ?? mini.createFallbackBridge());
        // DEFECT: host-service availability check + branch between auto/mini approximated; kind 3 = AutoFallback(CodexBridge|Daemon), kind 2 = direct fallback/mini/codecli host bridge.
        if is_windows { out_kind = 3; return 0; };
        out_kind = 3;
        return 0;
    };
    if mode_len == 0 {
        // mode === "" treated as auto (same branch as above in source).
        out_kind = 3;
        return 0;
    };
    // throw new Error(`Unsupported CODEX_UI_APP_SERVER_MODE '${...}'. Use 'auto', 'daemon', 'stdio', 'codecli', or 'mini'.`);
    return -1;
}
