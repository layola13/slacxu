// DEFECT: async — export async function detectRemoteOs(args: string[]): Promise<RemoteOs>
// Source: const connectArgs = ["-o", "ConnectTimeout=15"];
// try { const { stdout } = await execFileAsync("ssh", [...connectArgs, ...args, "uname -s 2>/dev/null"], { timeout: 15_000, maxBuffer: 64 * 1024 });
//   if (String(stdout).trim()) return "posix"; } catch {}
// const { stdout } = await execFileAsync("ssh", [...connectArgs, ...args, powershellEncodedCommand("Write-Output Windows")], { timeout: 15_000, maxBuffer: 64 * 1024 });
// if (String(stdout).trim().toLowerCase().includes("windows")) return "windows";
// throw new Error("Unable to determine the SSH host operating system");
// DEFECT: destructuring, spread args arrays, execFile options object approximated; args passed as (count/len table + slice offset) like other fns in this file; result tag out: 0=posix, 1=windows.
fn detectRemoteOs(args_count: &u64, args_offset: u64, out_os: &u64) -> i32 {
    // First probe: ssh -o ConnectTimeout=15 <args...> "uname -s 2>/dev/null" { timeout: 15000, maxBuffer: 65536 }
    // stdout non-empty after trim -> posix. (exec via host process extern in fix phase; probe result flag:)
    let posix_stdout_nonempty: bool = false;
    if posix_stdout_nonempty {
        *out_os = 0;
        return 0;
    };
    // Second probe: ssh ... powershellEncodedCommand("Write-Output Windows"); stdout lowercased includes "windows" -> windows.
    let windows_stdout_has_windows: bool = false;
    if windows_stdout_has_windows {
        *out_os = 1;
        return 0;
    };
    return -1; // throw new Error("Unable to determine the SSH host operating system")
}

