    // DEFECT: spread-conditional object approximated by has_error branch in serialization (fix phase).
    if self.child == 0 { return 0; };
    return 0;
}

fn SshCodexBridge_handleLine(self: &SshCodexBridge, line_ptr: ptr, line_len: u64) -> i32 {
    if line_len == 0 { return 0; }; // if (!line.trim()) return;
    // let message; try { message = JSON.parse(line) } catch { emit("stderr", "Unparseable remote app-server stdout: " + line); return; }
    // DEFECT: JSON.parse/try-catch + string concatenation approximated as in other bridges.
    let msg = scb_JsonRpcMessage { has_id: false, id: scb_JsonRpcId { is_number: true, num: 0, str: [0u8; 128], str_len: 0 }, has_method: false, method: [0u8; 128], method_len: 0, params: scb_JsonValue { json: [0u8; 8192], json_len: 0 }, has_result: false, result: scb_JsonValue { json: [0u8; 8192], json_len: 0 }, has_error: false, error: scb_JsonRpcError { message: [0u8; 1024], message_len: 0, code: 0, has_code: false } };
    let parsed: bool = true;
    if !parsed {
        SshCodexBridge_emit_stderr(self, line_ptr, line_len);
        return 0;
    };
    // const messageId = "id" in message ? message.id : undefined;
    // const pending = messageId !== undefined ? this.pending.get(String(messageId)) : undefined;
    // if (pending) { delete; clearTimeout; if ("error" in message) pending.reject(message.error); else pending.resolve("result" in message ? message.result : {}); return; }
    if msg.has_id {
        for i in 0..self.pending.count {
            if self.pending.items[i].id_len == msg.id.str_len {
                self.pending.items[i].has_timer = false;
                if msg.has_error {
                    self.pending.items[i].rejected = true;
                    self.pending.items[i].error = msg.error;
                } else {
                    self.pending.items[i].resolved = true;
                    if msg.has_result {
                        self.pending.items[i].result = msg.result;
                    };
                };
                return 0;
            };
        }
    };
    SshCodexBridge_emit_message(self, &msg);
    return 0;
}

