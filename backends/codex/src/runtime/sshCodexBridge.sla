// DEFECT: array spread/map/join/template literals, spawn options object, event registrations, optional chaining (?.) approximated sequentially; remote command string assembly happens in a scratch buffer in fix phase (fragments preserved verbatim above).
fn SshCodexBridge_startInternal(self: &SshCodexBridge, out: &scb_EngineStatus) -> i32 {
    // Step 1: splitSshCommand(profile.command) into parts buffer (capacity 32 args, 256 bytes each).
    // DEFECT: string[] dynamic array approximated by fixed arrays.
    let parts_count: u64 = 0;
    let parts_len: [u64; 32] = [0u64; 32];
    let parts_len_p: ptr = PTR_NULL(); PTR_BYTE_ADD(parts_len_p, &parts_len, 0);
    let cmd_ptr: ptr = PTR_NULL();
    splitSshCommand(cmd_ptr, self.profile.command_len, &parts_count, parts_len_p);
    // parts[0] !== "ssh" (len 3) || parts.length < 2 -> throw
    if parts_count < 2 { *out = self.status; return -1; };
    if parts_len[0] != 3 { *out = self.status; return -1; };
    // Step 2: status starting.
    self.status.phase_len = 8; // "starting"
    self.status.message_len = 32; // "Starting remote Codex app-server"
    self.status.has_message = true;
    self.status.startedAt = 0; // DEFECT: Date.now() approximated
    self.status.has_startedAt = true;
    SshCodexBridge_emit_status(self);
    // Step 3: remoteOs = await detectRemoteOs(parts.slice(1)) — args slice approximated by (parts offset 1).
    let remote_os: u64 = 0;
    let orc: i32 = detectRemoteOs(&parts_count, 1, &remote_os);
    if orc != 0 { *out = self.status; return orc; };
    // Steps 4-6: build remote command + forwardArgs, spawn ssh child, write token line to stdin.
    // (string assembly + spawn via sa_std process externs in fix phase; child handle placeholder:)
    self.child = 1;
    // Step 7: event registrations -> host pump calls SshCodexBridge_fail / SshCodexBridge_handleLine / stderr emit.
    // Step 8: initialize handshake.
    let init_params = scb_JsonValue { json: [0u8; 8192], json_len: 0 };
    let init_result = scb_JsonValue { json: [0u8; 8192], json_len: 0 };
    let rc: i32 = SshCodexBridge_request(self, STR_PTR("initialize"), STR_LEN("initialize"), &init_params, 15000, &init_result);
    if rc != 0 {
        SshCodexBridge_stop(self);
        *out = self.status;
        return -1; // throw new Error(rpcErrorMessage(error))
    };
    let empty = scb_JsonValue { json: [0u8; 8192], json_len: 0 };
    SshCodexBridge_notify(self, STR_PTR("initialized"), STR_LEN("initialized"), &empty);
    // record/codexHome extraction from init JSON (typeof string check) — fix phase.
    let codex_home_len: u64 = 0;
    let has_codex_home: bool = false;
    if self.options.has_modelCatalog {
        if !has_codex_home {
            SshCodexBridge_stop(self);
            *out = self.status;
            return -1; // throw new Error("Remote Codex app-server did not report an absolute codexHome")
        };
        // await writeRemoteModelCatalog(parts.slice(1), remoteOs, codexHome, options.modelCatalog)
        let wrc: i32 = writeRemoteModelCatalog(&parts_count, 1, remote_os, codex_home_len, &self.options.modelCatalog);
        if wrc != 0 {
            SshCodexBridge_stop(self);
            *out = self.status;
            return -1;
        };
    };
    if self.options.has_configEdits {
        if self.options.configEdits_count > 0 {
            // configEdits.map: entries with keyPath === "model_catalog_json" (len 18) && codexHome get value = remoteCatalogPath(codexHome, remoteOs).
            for i in 0..self.options.configEdits_count {
                if self.options.configEdits[i].keyPath_len == 18 {
                    if has_codex_home {
                        // value replaced by remoteCatalogPath(...) — path written into edit.value buffer in fix phase.
                    };
                };
            }
            let bw_params = scb_JsonValue { json: [0u8; 8192], json_len: 0 }; // { edits: configEdits, reloadUserConfig: true }
            let bw_result = scb_JsonValue { json: [0u8; 8192], json_len: 0 };
            let brc: i32 = SshCodexBridge_request(self, STR_PTR("config/batchWrite"), STR_LEN("config/batchWrite"), &bw_params, 120000, &bw_result);
            if brc != 0 {
                SshCodexBridge_stop(self);
                *out = self.status;
                return -1;
            };
        };
    };
    // status ready: appServerUserAgent from record.userAgent (typeof check), codexHome, message "Remote Codex app-server ready".
    self.status.phase_len = 5; // "ready"
    self.status.codexHome_len = codex_home_len;
    self.status.has_codexHome = has_codex_home;
    self.status.message_len = 30; // "Remote Codex app-server ready"
    SshCodexBridge_emit_status(self);
    *out = self.status;
    return 0;
}

fn SshCodexBridge_stop(self: &SshCodexBridge) -> i32 {
    self.has_starting = false; // this.starting = null
    for i in 0..self.pending.count {
        self.pending.items[i].has_timer = false; // clearTimeout
        if self.pending.items[i].method_len == 14 {
            self.pending.items[i].resolved = true; // turn/interrupt resolves {}
        } else {
            self.pending.items[i].rejected = true;
            self.pending.items[i].error.message_len = 27; // "Remote Codex bridge stopped"
        };
    }
    self.pending.count = 0;
    // try { this.child?.kill("SIGTERM"); } catch {} this.child = null;
    self.child = 0;
    self.status.phase_len = 7; // "stopped"
    self.status.message_len = 7; // "Stopped"
    self.status.has_message = true;
    SshCodexBridge_emit_status(self);
    return 0;
}

// DEFECT: async — async restart(): Promise<EngineStatus> { this.stop(); return this.start(); }
fn SshCodexBridge_restart(self: &SshCodexBridge, out: &scb_EngineStatus) -> i32 {
    SshCodexBridge_stop(self);
    return SshCodexBridge_start(self, out);
}

// DEFECT: async — async request(method, params?, timeoutMs = 15000): Promise<JsonValue>
// Source (single-line body, expanded): if (!child && method==="turn/interrupt") return {}; if (!child) await start();
// if (!child) throw new Error("Remote Codex app-server is not running"); const id = nextId++;
// return new Promise((resolve, reject) => { const pending = { method, resolve, reject };
//   if (timeoutMs > 0) pending.timer = setTimeout(() => { pending.delete; if (method==="turn/interrupt") { stop(); resolve({}); return; } reject({ message: "Request '" + method + "' timed out after " + timeoutMs + "ms" }); }, timeoutMs);
//   pending.set(String(id), pending); child?.stdin.write(JSON.stringify({ id, method, params }) + "\n"); });
// DEFECT: Promise + setTimeout callback (which calls stop() for turn/interrupt) approximated: pending entry carries timeout; host timer fires SshCodexBridge_requestTimeout below.
fn SshCodexBridge_request(self: &SshCodexBridge, method_ptr: ptr, method_len: u64, params: &scb_JsonValue, timeout_ms: u64, out: &scb_JsonValue) -> i32 {
    if self.child == 0 {
        if method_len == 14 {
            out.json_len = 0; // return {} — turn/interrupt
            return 0;
        };
        let st = scb_EngineStatus { phase: [0u8; 32], phase_len: 0, transport: [0u8; 32], transport_len: 0, appServerUserAgent: [0u8; 512], appServerUserAgent_len: 0, has_appServerUserAgent: false, codexHome: [0u8; 512], codexHome_len: 0, has_codexHome: false, startedAt: 0, has_startedAt: false, message: [0u8; 1024], message_len: 0, has_message: false };
        let rc: i32 = SshCodexBridge_start(self, &st);
        if rc != 0 { return rc; };
    };
    if self.child == 0 { return -1; }; // throw "Remote Codex app-server is not running"
    let id: u64 = self.nextId;
    self.nextId = self.nextId + 1;
    if self.pending.count < 256 {
        let entry = Pending { id: [0u8; 32], id_len: 0, method: [0u8; 128], method_len: method_len, resolved: false, rejected: false, result: scb_JsonValue { json: [0u8; 8192], json_len: 0 }, error: scb_JsonRpcError { message: [0u8; 1024], message_len: 0, code: 0, has_code: false }, has_timer: timeout_ms > 0, timeout_ms: timeout_ms };
        self.pending.items[self.pending.count] = entry;
        self.pending.count = self.pending.count + 1;
    };
    // child.stdin.write(JSON.stringify({ id, method, params }) + "\n") — JSON serialization in fix phase.
    out.json_len = 0;
    return 0;
}

// Timeout handler for one pending entry (source setTimeout callback above).
fn SshCodexBridge_requestTimeout(self: &SshCodexBridge, idx: u64, out: &scb_JsonValue) -> i32 {
    // this.pending.delete(String(id)) — removal bookkeeping in fix phase.
    if self.pending.items[idx].method_len == 14 {
        SshCodexBridge_stop(self);
        out.json_len = 0; // resolve({})
        return 0;
    };
    // reject({ message: "Request '" + method + "' timed out after " + timeoutMs + "ms" })
    self.pending.items[idx].rejected = true;
    return -1;
}

// DEFECT: async — async notify(method, params?): Promise<void>
// if (!child) await start(); if (!child) throw ...; child.stdin.write(JSON.stringify({ method, params }) + "\n");
fn SshCodexBridge_notify(self: &SshCodexBridge, method_ptr: ptr, method_len: u64, params: &scb_JsonValue) -> i32 {
    if self.child == 0 {
        let st = scb_EngineStatus { phase: [0u8; 32], phase_len: 0, transport: [0u8; 32], transport_len: 0, appServerUserAgent: [0u8; 512], appServerUserAgent_len: 0, has_appServerUserAgent: false, codexHome: [0u8; 512], codexHome_len: 0, has_codexHome: false, startedAt: 0, has_startedAt: false, message: [0u8; 1024], message_len: 0, has_message: false };
        let rc: i32 = SshCodexBridge_start(self, &st);
        if rc != 0 { return rc; };
    };
    if self.child == 0 { return -1; };
    return 0;
}

fn SshCodexBridge_respond(self: &SshCodexBridge, id: &scb_JsonRpcId, result: &scb_JsonValue, has_result: bool, error: &scb_JsonRpcError, has_error: bool) -> i32 {
