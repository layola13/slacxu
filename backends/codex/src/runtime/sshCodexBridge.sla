fn SshCodexBridge_new(profile: &SshWorkspaceProfile, options: &SshCodexBridgeOptions) -> SshCodexBridge {
    let bridge = SshCodexBridge {
        child: 0,
        pending: scb_PendingTable { items: [Pending { id: [0u8; 32], id_len: 0, method: [0u8; 128], method_len: 0, resolved: false, rejected: false, result: scb_JsonValue { json: [0u8; 8192], json_len: 0 }, error: scb_JsonRpcError { message: [0u8; 1024], message_len: 0, code: 0, has_code: false }, has_timer: false, timeout_ms: 0 }; 256], count: 0 },
        nextId: 1,
        has_starting: false,
        starting_status: scb_EngineStatus { phase: [0u8; 32], phase_len: 0, transport: [0u8; 32], transport_len: 0, appServerUserAgent: [0u8; 512], appServerUserAgent_len: 0, has_appServerUserAgent: false, codexHome: [0u8; 512], codexHome_len: 0, has_codexHome: false, startedAt: 0, has_startedAt: false, message: [0u8; 1024], message_len: 0, has_message: false },
        status: scb_EngineStatus { phase: [0u8; 32], phase_len: 4, transport: [0u8; 32], transport_len: 5, appServerUserAgent: [0u8; 512], appServerUserAgent_len: 0, has_appServerUserAgent: false, codexHome: [0u8; 512], codexHome_len: 0, has_codexHome: false, startedAt: 0, has_startedAt: false, message: [0u8; 1024], message_len: 0, has_message: false },
        profile: *profile,
        options: *options,
        listeners_status: 0,
        listeners_message: 0,
        listeners_stderr: 0,
    };
    // status = { phase: "idle", transport: "stdio" } (lens set above)
    return bridge;
}

fn SshCodexBridge_emit_status(self: &SshCodexBridge) -> i32 { return 0; }
fn SshCodexBridge_emit_message(self: &SshCodexBridge, msg: &scb_JsonRpcMessage) -> i32 { return 0; }
fn SshCodexBridge_emit_stderr(self: &SshCodexBridge, msg_ptr: ptr, msg_len: u64) -> i32 { return 0; }

fn SshCodexBridge_getStatus(self: &SshCodexBridge) -> scb_EngineStatus {
    return self.status; // { ...this.status }
}

// DEFECT: async — async start(): Promise<EngineStatus>
// if (phase==="ready") return getStatus(); if (this.starting) return await this.starting;
// this.starting = this.startInternal(); try { return await this.starting; } finally { this.starting = null; }
fn SshCodexBridge_start(self: &SshCodexBridge, out: &scb_EngineStatus) -> i32 {
    if self.status.phase_len == 5 {
        *out = self.status;
        return 0;
    };
    if self.has_starting {
        *out = self.starting_status;
        return 0;
    };
    self.has_starting = true;
    let rc: i32 = SshCodexBridge_startInternal(self, out);
    self.starting_status = *out;
    self.has_starting = false; // finally
    return rc;
}

// The fail closure inside startInternal: (message) => { for pending: clearTimeout; turn/interrupt resolves {} else rejects {message}; pending.clear(); child=null; status={...status, phase:"error", message}; emit status; }
// DEFECT: closure capturing mutable state approximated as a named fn taking &self.
fn SshCodexBridge_fail(self: &SshCodexBridge, msg_ptr: ptr, msg_len: u64) -> i32 {
    for i in 0..self.pending.count {
        self.pending.items[i].has_timer = false; // clearTimeout(pending.timer)
        // pending.method === "turn/interrupt" (len 14) resolves {}, else rejects.
        if self.pending.items[i].method_len == 14 {
            self.pending.items[i].resolved = true;
        } else {
            self.pending.items[i].rejected = true;
            self.pending.items[i].error.message_len = msg_len;
        };
    }
    self.pending.count = 0;
    self.child = 0;
    self.status.phase_len = 5; // "error"
    self.status.message_len = msg_len;
    self.status.has_message = true;
    SshCodexBridge_emit_status(self);
    return 0;
}

