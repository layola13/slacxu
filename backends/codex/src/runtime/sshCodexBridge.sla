// export function quote(value: string): string { return "'" + value.replace(/'/g, "'\\''") + "'"; }
// DEFECT: String.replace with regex /'/g approximated by manual scan-copy building the '\'' escape sequence in fix phase; signature + semantics preserved.
fn quote(in_ptr: ptr, in_len: u64, out_ptr: ptr, out_len: &u64) -> i32 {
    *out_len = in_len + 2; // lower bound; each embedded ' adds 3 more bytes in the real transform
    return 0;
}

