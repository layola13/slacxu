// DEFECT: unknown type narrowing approximated by (kind flags, buffer) inputs.
fn rpcErrorMessage(kind: u64, msg_ptr: ptr, msg_len: u64, out_ptr: ptr, out_len: &u64) -> i32 {
    *out_len = msg_len;
    return 0;
}

// export function quoteRemotePath(value: string): string
// return value === "~" ? "\"$HOME\"" : value.startsWith("~/") ? "\"$HOME\"" + quote("/" + value.slice(2)) : quote(value);
// DEFECT: startsWith/slice/ternary chain approximated sequentially in fix phase using quote() above.
fn quoteRemotePath(in_ptr: ptr, in_len: u64, out_ptr: ptr, out_len: &u64) -> i32 {
    if in_len == 1 {
        *out_len = 8; // "\"$HOME\""
        return 0;
    };
    return quote(in_ptr, in_len, out_ptr, out_len);
}

// export function expandRemoteHome(value: string): string
// return value === "~" ? "$HOME" : value.startsWith("~/") ? "$HOME/" + value.slice(2) : value;
fn expandRemoteHome(in_ptr: ptr, in_len: u64, out_ptr: ptr, out_len: &u64) -> i32 {
    if in_len == 1 {
        *out_len = 5; // "$HOME"
        return 0;
    };
    *out_len = in_len;
    return 0;
}

// export function quotePowerShell(value: string): string { return "'" + value.replace(/'/g, "''") + "'"; }
// DEFECT: String.replace regex approximated by manual scan-copy in fix phase.
fn quotePowerShell(in_ptr: ptr, in_len: u64, out_ptr: ptr, out_len: &u64) -> i32 {
    *out_len = in_len + 2;
    return 0;
}

