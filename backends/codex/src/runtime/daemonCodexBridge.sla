// ---- Shared JSON types (from @codex-ui/shared) — same approximations as codexBridge.sla ----
// DEFECT: dynamic JSON (JsonValue) approximated by JSON text buffer.
struct JsonValue {
    json: [u8; 8192],
    json_len: u64,
}

struct JsonRpcId {
    is_number: bool,
    num: i64,
    str: [u8; 128],
    str_len: u64,
}

struct JsonRpcError {
    message: [u8; 1024],
    message_len: u64,
    code: i64,
    has_code: bool,
}

// DEFECT: dynamic object — JsonRpcMessage optional fields as presence flags.
struct JsonRpcMessage {
    has_id: bool,
    id: JsonRpcId,
    has_method: bool,
    method: [u8; 128],
    method_len: u64,
    params: JsonValue,
    has_result: bool,
    result: JsonValue,
    has_error: bool,
    error: JsonRpcError,
}

// EngineStatus with daemon-specific optional fields (realtimeSync, connectionEpoch).
// DEFECT: dynamic object — optional fields as fixed buffers + presence flags.
struct EngineStatus {
    phase: [u8; 32],
    phase_len: u64,
    transport: [u8; 32],
    transport_len: u64,
    realtimeSync: [u8; 32],
    realtimeSync_len: u64,
    has_realtimeSync: bool,
    connectionEpoch: u64,
    has_connectionEpoch: bool,
    codexBin: [u8; 512],
    codexBin_len: u64,
    has_codexBin: bool,
    codexVersion: [u8; 128],
    codexVersion_len: u64,
    has_codexVersion: bool,
    appServerUserAgent: [u8; 512],
    appServerUserAgent_len: u64,
    has_appServerUserAgent: bool,
    codexHome: [u8; 512],
    codexHome_len: u64,
    has_codexHome: bool,
    startedAt: u64,
    has_startedAt: bool,
    message: [u8; 1024],
    message_len: u64,
    has_message: bool,
}

// type PendingRequest = { resolve, reject, method }
// DEFECT: closure fields approximated as in codexBridge.sla (method + resolution state).
struct PendingRequest {
    id: [u8; 32],
    id_len: u64,
    method: [u8; 128],
    method_len: u64,
    resolved: bool,
    rejected: bool,
    result: JsonValue,
    error: JsonRpcError,
    has_timer: bool,
    timeout_ms: u64,
}

// DEFECT: Map<string, PendingRequest> approximated by fixed array + count (capacity 256).
struct PendingTable {
    items: [PendingRequest; 256],
    count: u64,
}

// ProcessEnv: NodeJS.ProcessEnv dynamic object.
// DEFECT: dynamic object — JSON text buffer.
struct ProcessEnv {
    json: [u8; 8192],
    json_len: u64,
}

