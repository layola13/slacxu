// function daemonRuntimeEnv(env): ProcessEnv — keeps entries where
// (key startsWith "CODEX_UI_PROVIDER_" && endsWith "_API_KEY") || key === RELAY_GATEWAY_ENV_KEY ("CODEX_UI_RELAY_GATEWAY_TOKEN"),
// and typeof value === "string" && value.trim() non-empty.
// DEFECT: dynamic object filtering (Object.entries/startsWith/endsWith) approximated: returns filtered env in out; filtering implemented in fix phase.
fn daemonRuntimeEnv(env: &ProcessEnv, out: &ProcessEnv) -> i32 {
    out.json_len = env.json_len;
    for i in 0..env.json_len {
        out.json[i] = env.json[i];
    }
    return 0;
}

