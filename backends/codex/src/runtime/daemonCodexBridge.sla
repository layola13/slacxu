// DEFECT: async — async start(): Promise<EngineStatus>
fn DaemonCodexBridge_start(self: &DaemonCodexBridge, out: &EngineStatus) -> i32 {
    // if (phase === "ready" || phase === "starting") return getStatus();
    if self.status.phase_len == 5 {
        out = self.status;
        return 0;
    };
    self.isStopping = false;
    let codexBin_len: u64 = 0;
    let codexBin_ptr: ptr = PTR_NULL();
    DaemonCodexBridge_resolveCodexBin(self, codexBin_ptr, &codexBin_len);
    // setStatus({ phase:"starting", transport:"daemon-unix", realtimeSync:"available", connectionEpoch, codexBin, startedAt: Date.now(), message:"Connecting to Codex app-server daemon" })
    let starting = self.status;
    starting.phase_len = 8; // "starting"
    starting.transport_len = 11; // "daemon-unix"
    starting.realtimeSync_len = 9; // "available"
    starting.has_realtimeSync = true;
    starting.connectionEpoch = self.connectionEpoch;
    starting.has_connectionEpoch = true;
    starting.codexBin_len = codexBin_len;
    starting.has_codexBin = true;
    starting.startedAt = 0; // DEFECT: Date.now() approximated
    starting.has_startedAt = true;
    starting.message_len = 37; // "Connecting to Codex app-server daemon"
    starting.has_message = true;
    DaemonCodexBridge_setStatus(self, &starting);
    // try { await ensureDaemonRunning(codexBin); await connectWebSocket(); return getStatus(); }
    // catch (error) { setStatus({phase:"error", transport:"daemon-unix", realtimeSync:"unavailable", connectionEpoch, codexBin, codexHome: resolveCodexHome(), message}); throw new Error(message); }
    // DEFECT: try/catch + rethrow approximated by rc checks + return -1.
    let rc: i32 = DaemonCodexBridge_ensureDaemonRunning(self, codexBin_ptr, codexBin_len);
    if rc != 0 {
        let err_status = self.status;
        err_status.phase_len = 5; // "error"
        err_status.realtimeSync_len = 11; // "unavailable"
        DaemonCodexBridge_setStatus(self, &err_status);
        out = self.status;
        return -1;
    };
    rc = DaemonCodexBridge_connectWebSocket(self);
    if rc != 0 {
        let err_status = self.status;
        err_status.phase_len = 5;
        err_status.realtimeSync_len = 11;
        DaemonCodexBridge_setStatus(self, &err_status);
        out = self.status;
        return -1;
    };
    out = self.status;
    return 0;
}

fn DaemonCodexBridge_stop(self: &DaemonCodexBridge) -> i32 {
    self.isStopping = true;
    // if (this.reconnectTimer) { clearTimeout(this.reconnectTimer); this.reconnectTimer = null; }
    // DEFECT: clearTimeout approximated by clearing handle id.
    self.reconnectTimer = 0;
    for i in 0..self.pending.count {
        self.pending.items[i].rejected = true;
        self.pending.items[i].error.message_len = 28; // "Codex daemon bridge stopped"
    }
    self.pending.count = 0;
    // if (this.ws) { try { this.ws.close(); } catch {} this.ws = null; }
    self.ws = 0;
    let stopped = self.status;
    stopped.phase_len = 7; // "stopped"
    stopped.message_len = 7; // "Stopped"
    stopped.has_message = true;
    DaemonCodexBridge_setStatus(self, &stopped);
    return 0;
}

// DEFECT: async — async restart(): Promise<EngineStatus> { this.stop(); return this.start(); }
fn DaemonCodexBridge_restart(self: &DaemonCodexBridge, out: &EngineStatus) -> i32 {
    DaemonCodexBridge_stop(self);
    return DaemonCodexBridge_start(self, out);
}

// DEFECT: async — async request(method, params?, timeoutMs = 15000): Promise<JsonValue>
// DEFECT: new Promise + setTimeout timeout approximated as in codexBridge.sla (pending entry carries timeout_ms; timeout rejection message "Request '<method>' timed out after <timeoutMs>ms").
fn DaemonCodexBridge_request(self: &DaemonCodexBridge, method_ptr: ptr, method_len: u64, params: &JsonValue, timeout_ms: u64, out: &JsonValue) -> i32 {
    // if (!this.ws || this.ws.readyState !== WebSocket.OPEN) throw new Error("Codex daemon connection is not open");
    // DEFECT: WebSocket.OPEN readyState check approximated by ws handle nonzero check.
    if self.ws == 0 { return -1; };
    let id: u64 = self.nextId;
    self.nextId = self.nextId + 1;
    let payload = JsonRpcMessage { has_id: true, id: JsonRpcId { is_number: true, num: 0, str: [0u8; 128], str_len: 0 }, has_method: true, method: [0u8; 128], method_len: method_len, params: params, has_result: false, result: JsonValue { json: [0u8; 8192], json_len: 0 }, has_error: false, error: JsonRpcError { message: [0u8; 1024], message_len: 0, code: 0, has_code: false } };
    // pending.set(String(id), {resolve/reject wrappers clearing timer, method}) — same approximation as codexBridge.
    if self.pending.count < 256 {
        let entry = PendingRequest { id: [0u8; 32], id_len: 0, method: [0u8; 128], method_len: method_len, resolved: false, rejected: false, result: JsonValue { json: [0u8; 8192], json_len: 0 }, error: JsonRpcError { message: [0u8; 1024], message_len: 0, code: 0, has_code: false }, has_timer: timeout_ms > 0, timeout_ms: timeout_ms };
        self.pending.items[self.pending.count] = entry;
        self.pending.count = self.pending.count + 1;
    };
    // this.sendPayload(payload);
    return DaemonCodexBridge_sendPayload(self, &payload);
}

// DEFECT: async — async notify(method, params?): Promise<void> { this.sendPayload({ method, params }); }
fn DaemonCodexBridge_notify(self: &DaemonCodexBridge, method_ptr: ptr, method_len: u64, params: &JsonValue) -> i32 {
    let msg = JsonRpcMessage { has_id: false, id: JsonRpcId { is_number: true, num: 0, str: [0u8; 128], str_len: 0 }, has_method: true, method: [0u8; 128], method_len: method_len, params: params, has_result: false, result: JsonValue { json: [0u8; 8192], json_len: 0 }, has_error: false, error: JsonRpcError { message: [0u8; 1024], message_len: 0, code: 0, has_code: false } };
    return DaemonCodexBridge_sendPayload(self, &msg);
}

fn DaemonCodexBridge_respond(self: &DaemonCodexBridge, id: &JsonRpcId, result: &JsonValue, has_result: bool, error: &JsonRpcError, has_error: bool) -> i32 {
    // if (error) sendPayload({ id, error }) else sendPayload({ id, result: result ?? {} })
    let msg = JsonRpcMessage { has_id: true, id: id, has_method: false, method: [0u8; 128], method_len: 0, params: JsonValue { json: [0u8; 8192], json_len: 0 }, has_result: !has_error, result: result, has_error: has_error, error: error };
    return DaemonCodexBridge_sendPayload(self, &msg);
}

fn DaemonCodexBridge_sendPayload(self: &DaemonCodexBridge, message: &JsonRpcMessage) -> i32 {
