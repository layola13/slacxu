// DEFECT: async — private async connectWebSocket(): Promise<void>
// Source: closes existing ws; new Promise((resolve,reject) => { ws = new WebSocket(`ws+unix://${socketPath}:/`, {perMessageDeflate:false}); ws.on("open", async () => { ws stored; connectionEpoch+=1; initialize request; notify initialized; readCodexVersion; setStatus(ready...); resolve(); }); ws.on("message", data => handleMessageLine(data.toString("utf8"))); ws.on("error", err => !resolved ? reject(err) : emit stderr `WebSocket error: ...`); ws.on("close", () => { ws=null; reject all pending "Daemon WebSocket connection closed"; if (!isStopping) { setStatus(reconnecting/degraded); scheduleReconnect(); } }); })
// DEFECT: WebSocket class + event handlers + async open handler + resolved-flag Promise pattern approximated sequentially; handlers split into the *_on* fns below invoked by host WS pump.
fn DaemonCodexBridge_connectWebSocket(self: &DaemonCodexBridge) -> i32 {
    self.ws = 0; // close previous (try/catch in source)
    // host creates WebSocket ws+unix://<socketPath>:/ — handle id assigned here as placeholder 1.
    self.ws = 1;
    return DaemonCodexBridge_connectWebSocket_onOpen(self);
}

fn DaemonCodexBridge_connectWebSocket_onOpen(self: &DaemonCodexBridge) -> i32 {
    self.connectionEpoch = self.connectionEpoch + 1;
    let init_params = JsonValue { json: [0u8; 8192], json_len: 0 };
    let init_result = JsonValue { json: [0u8; 8192], json_len: 0 };
    // initialize params 1:1: { clientInfo: { name: "codex-tui", title: "Codex TUI", version: "0.1.0" }, capabilities: { experimentalApi: true, mcpServerOpenaiFormElicitation: true } }
    let rc: i32 = DaemonCodexBridge_request(self, STR_PTR("initialize"), STR_LEN("initialize"), &init_params, 15000, &init_result);
    if rc != 0 { return rc; };
    DaemonCodexBridge_notify(self, STR_PTR("initialized"), STR_LEN("initialized"), &init_params);
    // const init = initialize as Record<...>; codexBin = resolveCodexBin(); codexVersion = await readCodexVersion(codexBin);
    let codexBin_len: u64 = 0;
    let codexBin_ptr: ptr = PTR_NULL();
    DaemonCodexBridge_resolveCodexBin(self, codexBin_ptr, &codexBin_len);
    let ver_len: u64 = 0;
    let ver_ptr: ptr = PTR_NULL();
    DaemonCodexBridge_readCodexVersion(self, codexBin_ptr, codexBin_len, ver_ptr, &ver_len);
    // setStatus({ phase:"ready", transport:"daemon-unix", realtimeSync:"available", connectionEpoch, codexBin, codexVersion, appServerUserAgent: typeof init.userAgent==="string" ? ... : undefined, codexHome: typeof init.codexHome==="string" ? ... : resolveCodexHome(), startedAt: Date.now() })
    // DEFECT: dynamic init field extraction + Date.now() approximated as in start().
    let ready = self.status;
    ready.phase_len = 5; // "ready"
    ready.realtimeSync_len = 9; // "available"
    ready.has_realtimeSync = true;
    ready.connectionEpoch = self.connectionEpoch;
    ready.has_connectionEpoch = true;
    ready.codexBin_len = codexBin_len;
    ready.has_codexBin = true;
    ready.codexVersion_len = ver_len;
    ready.has_codexVersion = ver_len > 0;
    ready.startedAt = 0;
    ready.has_startedAt = true;
    DaemonCodexBridge_setStatus(self, &ready);
    return 0;
}

fn DaemonCodexBridge_connectWebSocket_onMessage(self: &DaemonCodexBridge, data_ptr: ptr, data_len: u64) -> i32 {
    // const text = data.toString("utf8"); this.handleMessageLine(text);
    return DaemonCodexBridge_handleMessageLine(self, data_ptr, data_len);
}

fn DaemonCodexBridge_connectWebSocket_onError(self: &DaemonCodexBridge, err_ptr: ptr, err_len: u64, resolved: bool) -> i32 {
    // if (!resolved) reject(err) else emit("stderr", `WebSocket error: ${stringifyError(err)}`)
    if !resolved { return -1; };
    return DaemonCodexBridge_emit_stderr(self, err_ptr, err_len);
}

fn DaemonCodexBridge_connectWebSocket_onClose(self: &DaemonCodexBridge) -> i32 {
    self.ws = 0;
    for i in 0..self.pending.count {
        self.pending.items[i].rejected = true;
        self.pending.items[i].error.message_len = 34; // "Daemon WebSocket connection closed"
    }
    self.pending.count = 0;
    if !self.isStopping {
        let st = self.status;
        st.phase_len = 12; // "reconnecting"
        st.realtimeSync_len = 8; // "degraded"
        st.has_realtimeSync = true;
        st.message_len = 39; // "Connection to daemon lost, reconnecting..."
        st.has_message = true;
        DaemonCodexBridge_setStatus(self, &st);
        DaemonCodexBridge_scheduleReconnect(self);
    };
    return 0;
}

fn DaemonCodexBridge_scheduleReconnect(self: &DaemonCodexBridge) -> i32 {
    // if (this.reconnectTimer || this.isStopping) return;
    // this.reconnectTimer = setTimeout(async () => { this.reconnectTimer = null; if (isStopping) return; try { await this.start(); } catch { this.scheduleReconnect(); } }, 2000);
    // DEFECT: setTimeout with async closure approximated: timer id stored; host fires DaemonCodexBridge_reconnectTimerFire.
    if self.reconnectTimer != 0 { return 0; };
    if self.isStopping { return 0; };
    self.reconnectTimer = 1;
    return 0;
}

fn DaemonCodexBridge_reconnectTimerFire(self: &DaemonCodexBridge) -> i32 {
    self.reconnectTimer = 0;
    if self.isStopping { return 0; };
    let out = EngineStatus { phase: [0u8; 32], phase_len: 0, transport: [0u8; 32], transport_len: 0, realtimeSync: [0u8; 32], realtimeSync_len: 0, has_realtimeSync: false, connectionEpoch: 0, has_connectionEpoch: false, codexBin: [0u8; 512], codexBin_len: 0, has_codexBin: false, codexVersion: [0u8; 128], codexVersion_len: 0, has_codexVersion: false, appServerUserAgent: [0u8; 512], appServerUserAgent_len: 0, has_appServerUserAgent: false, codexHome: [0u8; 512], codexHome_len: 0, has_codexHome: false, startedAt: 0, has_startedAt: false, message: [0u8; 1024], message_len: 0, has_message: false };
    let rc: i32 = DaemonCodexBridge_start(self, &out);
    if rc != 0 {
        DaemonCodexBridge_scheduleReconnect(self);
    };
    return 0;
}

fn DaemonCodexBridge_handleMessageLine(self: &DaemonCodexBridge, text_ptr: ptr, text_len: u64) -> i32 {
    if text_len == 0 { return 0; }; // if (!text.trim()) return;
    // try { message = JSON.parse(text) } catch { emit("stderr", `Unparseable WebSocket frame: ${redactSecrets(text)}`); return; }
    // DEFECT: JSON.parse/try-catch approximated as in codexBridge handleLine.
    let msg = JsonRpcMessage { has_id: false, id: JsonRpcId { is_number: true, num: 0, str: [0u8; 128], str_len: 0 }, has_method: false, method: [0u8; 128], method_len: 0, params: JsonValue { json: [0u8; 8192], json_len: 0 }, has_result: false, result: JsonValue { json: [0u8; 8192], json_len: 0 }, has_error: false, error: JsonRpcError { message: [0u8; 1024], message_len: 0, code: 0, has_code: false } };
    let parsed: bool = true;
    if !parsed {
        DaemonCodexBridge_emit_stderr(self, text_ptr, text_len);
        return 0;
    };
    // if ("id" in message && pending.has(String(message.id))) { ... resolve/reject ... return; }
    if msg.has_id {
        for i in 0..self.pending.count {
            if self.pending.items[i].id_len == msg.id.str_len {
                if msg.has_error {
                    self.pending.items[i].rejected = true;
                    self.pending.items[i].error = msg.error;
                } else {
                    self.pending.items[i].resolved = true;
                    if msg.has_result {
                        self.pending.items[i].result = msg.result;
                    };
                };
                return 0;
            };
        }
    };
    DaemonCodexBridge_emit_message(self, &msg);
    return 0;
}

// DEFECT: async — private async readCodexVersion(codexBin): Promise<string|undefined> — same Promise+setTimeout(3000) pattern as codexBridge.sla.
fn DaemonCodexBridge_readCodexVersion(self: &DaemonCodexBridge, codexBin_ptr: ptr, codexBin_len: u64, out_ptr: ptr, out_len: &u64) -> i32 {
    out_len = 0;
    return 0;
}

