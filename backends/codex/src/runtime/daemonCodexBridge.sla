    if has_env_sock {
        out_len = env_sock_len;
        return 0;
    };
    out_len = codex_home_len + 40; // + "/app-server-control/app-server-control.sock"
    return 0;
}

// ---- export class DaemonCodexBridge extends EventEmitter implements CodexRuntimeClient ----
// DEFECT: extends EventEmitter / implements interface approximated as struct + &self fns; WebSocket (ws package) handle as opaque id (0 = null).
struct DaemonCodexBridge {
    ws: u64,
    nextId: u64,
    pending: PendingTable,
    status: EngineStatus,
    connectionEpoch: u64,
    // private reconnectTimer: ReturnType<typeof setTimeout> | null — timer handle (0 = null).
    // DEFECT: setTimeout handle type approximated by u64 id.
    reconnectTimer: u64,
    isStopping: bool,
    socketPath: [u8; 1024],
    socketPath_len: u64,
    runtimeEnv: ProcessEnv,
    listeners_status: u64,
    listeners_message: u64,
    listeners_stderr: u64,
}

fn DaemonCodexBridge_new(socket_path_ptr: ptr, socket_path_len: u64, runtimeEnv: &ProcessEnv) -> DaemonCodexBridge {
    let bridge = DaemonCodexBridge {
        ws: 0,
        nextId: 1,
        pending: PendingTable { items: [PendingRequest { id: [0u8; 32], id_len: 0, method: [0u8; 128], method_len: 0, resolved: false, rejected: false, result: JsonValue { json: [0u8; 8192], json_len: 0 }, error: JsonRpcError { message: [0u8; 1024], message_len: 0, code: 0, has_code: false }, has_timer: false, timeout_ms: 0 }; 256], count: 0 },
        status: EngineStatus { phase: [0u8; 32], phase_len: 4, transport: [0u8; 32], transport_len: 11, realtimeSync: [0u8; 32], realtimeSync_len: 0, has_realtimeSync: false, connectionEpoch: 0, has_connectionEpoch: false, codexBin: [0u8; 512], codexBin_len: 0, has_codexBin: false, codexVersion: [0u8; 128], codexVersion_len: 0, has_codexVersion: false, appServerUserAgent: [0u8; 512], appServerUserAgent_len: 0, has_appServerUserAgent: false, codexHome: [0u8; 512], codexHome_len: 0, has_codexHome: false, startedAt: 0, has_startedAt: false, message: [0u8; 1024], message_len: 0, has_message: false },
        connectionEpoch: 0,
        reconnectTimer: 0,
        isStopping: false,
        socketPath: [0u8; 1024],
        socketPath_len: socket_path_len,
        runtimeEnv: ProcessEnv { json: [0u8; 8192], json_len: 0 },
        listeners_status: 0,
        listeners_message: 0,
        listeners_stderr: 0,
    };
    // status = { phase: "idle", transport: "daemon-unix" } (lens set above)
    bridge.runtimeEnv.json_len = runtimeEnv.json_len;
    for i in 0..runtimeEnv.json_len {
        bridge.runtimeEnv.json[i] = runtimeEnv.json[i];
    }
    return bridge;
}

fn DaemonCodexBridge_getStatus(self: &DaemonCodexBridge) -> EngineStatus {
    return self.status; // { ...this.status }
}

fn DaemonCodexBridge_emit_status(self: &DaemonCodexBridge) -> i32 { return 0; }
fn DaemonCodexBridge_emit_message(self: &DaemonCodexBridge, msg: &JsonRpcMessage) -> i32 { return 0; }
fn DaemonCodexBridge_emit_stderr(self: &DaemonCodexBridge, msg_ptr: ptr, msg_len: u64) -> i32 { return 0; }

fn DaemonCodexBridge_setStatus(self: &DaemonCodexBridge, status: &EngineStatus) -> i32 {
    self.status = status;
    DaemonCodexBridge_emit_status(self);
    return 0;
}

fn DaemonCodexBridge_resolveCodexBin(self: &DaemonCodexBridge, out_ptr: ptr, out_len: &u64) -> i32 {
    // return pluginHostServices().codex.findCodexBinary();
    // DEFECT: host service call approximated; host fills out buffer.
