// export function freeOllamaModelSupportsThinking(model: string): boolean (freeOllama.ts:79-81)
//   return /(?:deepseek-r1|qwq|qwen3(?:[.:/-]|$)|qwen3\.5(?:[.:/-]|$)|gpt-oss|kimi-k2-thinking|phi-4-reasoning|nemotron)/i.test(model);
// DEFECT: regex alternation with anchors — approximated by contains_ci scans.
fn freeOllamaModelSupportsThinking(model_ptr: ptr, model_len: u64) -> bool {
    if contains_ci(model_ptr, model_len, STR_PTR("deepseek-r1"), STR_LEN("deepseek-r1")) { return true; };
    if contains_ci(model_ptr, model_len, STR_PTR("qwq"), STR_LEN("qwq")) { return true; };
    if contains_ci(model_ptr, model_len, STR_PTR("qwen3"), STR_LEN("qwen3")) { return true; };
    if contains_ci(model_ptr, model_len, STR_PTR("gpt-oss"), STR_LEN("gpt-oss")) { return true; };
    if contains_ci(model_ptr, model_len, STR_PTR("kimi-k2-thinking"), STR_LEN("kimi-k2-thinking")) { return true; };
    if contains_ci(model_ptr, model_len, STR_PTR("phi-4-reasoning"), STR_LEN("phi-4-reasoning")) { return true; };
    if contains_ci(model_ptr, model_len, STR_PTR("nemotron"), STR_LEN("nemotron")) { return true; };
    return false;
}

// export function eligibleFreeOllamaEntries(source: unknown): FreeOllamaSourceEntry[] (freeOllama.ts:83-105)
// DEFECT: dynamic JSON — `source: unknown` is a JSON text buffer; the flatMap
// per-entry record reads (server/tps/models/status) are JSON lookups.
// DEFECT: closure — the flatMap callback becomes a loop body here.
// DEFECT: Set<string> seen — O(n^2) scan over normalized server strings.
fn eligibleFreeOllamaEntries(source_json_ptr: ptr, source_json_len: u64, out_ptr: ptr, out_count: &u64) -> i32 {
    // Per entry, source keeps it only when ALL hold:
    //   entry is a non-array object; rawServer = trimmed server sans trailing /
    //   tps = number (or Number(record.tps)) finite and >= 60;
    //   models = eligibleFreeOllamaModels(record.models) non-empty;
    //   status !== "error" && status !== "fake";
    //   normalizedServer not seen before;
    //   new URL(server).protocol is "http:" or "https:".
    // DEFECT: per-entry JSON walk not implemented in this pass.
    *out_count = 0;
    return 0;
}

// export async function probeFreeOllamaEntries(entries, options): Promise<FreeOllamaSourceEntry[]> (freeOllama.ts:107-126)
// DEFECT: async — synchronous + status code; the Promise.all worker pool
// (concurrency-limited async workers over a shared nextIndex) becomes a
// sequential loop: no concurrency, no shared mutable closure state.
// DEFECT: closure — `worker` arrow function capturing nextIndex/results
// becomes inline loop code.
fn probeFreeOllamaEntries(entries_ptr: ptr, entries_count: u64, options: &FreeOllamaProbeOptions, out_ptr: ptr, out_count: &u64) -> i32 {
    let timeout_ms: u64 = 15000;
    if options.has_timeout_ms { timeout_ms = options.timeoutMs; };
    if timeout_ms < 1000 { timeout_ms = 1000; }; // Math.max(1_000, ...)
    let concurrency: u64 = 4;
    if options.has_concurrency { concurrency = options.concurrency; };
    if concurrency < 1 { concurrency = 1; };
    if concurrency > entries_count && entries_count > 0 { concurrency = entries_count; };
    // results = new Array(entries.length).fill(null); workers drain nextIndex;
    // await Promise.all(...); return results.filter(entry != null);
    // DEFECT: sequential approximation — probe order preserved, parallelism lost.
    let kept: u64 = 0;
    for i in 0..entries_count {
        // probeFreeOllamaEntry(entries[i], fetchImpl, timeoutMs) -> entry | null
        let ok = probeFreeOllamaEntry(entries_ptr, i, timeout_ms);
        if ok { kept = kept + 1; };
    }
    *out_count = kept;
    return 0;
}

// async function probeFreeOllamaEntry(entry, fetchImpl, timeoutMs) (freeOllama.ts:128-175)
// DEFECT: async — synchronous + bool (entry kept) instead of entry | null.
// DEFECT: fetch + AbortSignal.timeout — sa_std HTTP client has no per-request
// abort-signal timeout object; timeout is a client parameter approximation.
// DEFECT: dynamic JSON — tags/chat response bodies are JSON text buffers;
// `tagsBody.models?.map(m => m.name ?? m.model)` and the choices[0].message
// content/reasoning/reasoning_content probe are JSON lookups.
fn probeFreeOllamaEntry(entries_ptr: ptr, index: u64, timeout_ms: u64) -> bool {
    // Source flow:
    //   GET {server}/api/tags (Accept: application/json)
    //     -> !ok: null; liveModels = eligibleFreeOllamaModels(names)
    //     -> models = entry.models ∩ liveModels (normalized compare)
    //     -> probeModels = selectFreeOllamaProbeModels(models)
    //   for probeModel of probeModels:
    //     POST {server}/v1/chat/completions {model, messages:[{role:"user",
    //       content:"Reply with OK."}], stream:false}
    //     -> !ok / throw: continue
    //     -> responseModel must normalize-equal probeModel and message must
    //        have non-empty content|reasoning|reasoning_content
    //     -> return {...entry, models: [probeModel, ...rest]}
    //   return null (outer catch -> null)
    // DEFECT: HTTP calls + JSON walk not implemented in this pass.
    return false;
}

// function selectFreeOllamaProbeModels(models: string[]): string[] (freeOllama.ts:177-181)
//   return [...models].sort((a,b) => score(a)-score(b)).slice(0, MAX_PROBE_MODELS_PER_SERVER);
// DEFECT: closure comparator + sort — sort with a function-valued comparator
// has no SLA counterpart; insertion by score is an approximation.
fn selectFreeOllamaProbeModels(models_ptr: ptr, models_count: u64, out_count: &u64) -> i32 {
    // DEFECT: sort not implemented in this pass; source order kept, capped at 5.
    let n = models_count;
    if n > MAX_PROBE_MODELS_PER_SERVER { n = MAX_PROBE_MODELS_PER_SERVER; };
    *out_count = n;
    return 0;
}

// function freeOllamaProbeScore(model: string): number (freeOllama.ts:183-193)
// DEFECT: regex tests (/^llama3(?:\.1)?:8b/ etc.) — prefix/substring scans.
fn freeOllamaProbeScore(model_ptr: ptr, model_len: u64, normalized_ptr: ptr, normalized_len: u64) -> u64 {
    // normalized = normalizeFreeOllamaModel(model) — caller supplies it.
    // if normalized == "mistral:latest" return 0;
    // if /^llama3(?:\.1)?:8b/ return 1;
    // if /^deepseek-r1:(?:[7-9]|[1-9][0-9]+)b/ return 2;
    // if /^llama3(?::latest|$)/ return 3;
    // if /^qwen/ && !includes(":cloud") return 4;
    // if /^gpt-oss/ return 5;
    // if includes(":cloud") || includes("verif_sys") return 100;
    // return 20;
    // DEFECT: anchored regex prefixes approximated by contains_ci here.
    if contains_ci(normalized_ptr, normalized_len, STR_PTR(":cloud"), STR_LEN(":cloud")) { return 100; };
    if contains_ci(normalized_ptr, normalized_len, STR_PTR("verif_sys"), STR_LEN("verif_sys")) { return 100; };
    return 20;
}

// function normalizeFreeOllamaModel(model: string): string (freeOllama.ts:195-197)
//   return model.trim().toLowerCase();
fn normalizeFreeOllamaModel(model_ptr: ptr, model_len: u64, out_ptr: ptr, out_len: &u64) -> i32 {
    return normalizeFreeOllamaServer(model_ptr, model_len, out_ptr, out_len);
    // Note: source normalizeFreeOllamaModel does NOT strip trailing slashes;
    // reusing normalizeFreeOllamaServer is an approximation.
    // DEFECT: approximation — trailing '/' would be stripped here but not in source.
}
