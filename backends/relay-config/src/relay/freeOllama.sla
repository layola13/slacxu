// export type FreeOllamaSourceEntry (freeOllama.ts:3-8)
struct FreeOllamaSourceEntry {
    server_bytes: [u8; 512],
    server_len: u64,
    models_bytes: [u8; 8192], // flattened string[] storage
    models_lens: [u64; 64],
    models_count: u64,
    tps: f64,
    status_bytes: [u8; 64], // status?: string
    status_len: u64,
    has_status: bool,
}

// export type FreeOllamaImportStats (freeOllama.ts:10-14)
struct FreeOllamaImportStats {
    totalServers: u64,
    eligibleServers: u64,
    filteredServers: u64,
}

// export type FreeOllamaProbeOptions (freeOllama.ts:16-20)
struct FreeOllamaProbeOptions {
    // DEFECT: fetchImpl?: typeof fetch — function values / injected fetch have
    // no SLA counterpart; probing uses the sa_std HTTP client directly.
    has_fetch_impl: bool,
    timeoutMs: u64, // timeoutMs?: number
    has_timeout_ms: bool,
    concurrency: u64, // concurrency?: number
    has_concurrency: bool,
}

// ChannelGroupConfig (imported type; JSON text buffer form)
struct ChannelGroupConfigJson {
    json_bytes: [u8; 16384],
    json_len: u64,
}

// ---------------------------------------------------------------------------
// export function normalizeFreeOllamaServer(value: string): string (freeOllama.ts:22-24)
//   return value.trim().replace(/\/+$/, "").toLowerCase();
// DEFECT: regex replace (/\/+$/) — no regex in SLA; trailing-slash stripping
// is a hand loop. trim()/toLowerCase() are byte loops over ASCII.
// ---------------------------------------------------------------------------
fn normalizeFreeOllamaServer(value_ptr: ptr, value_len: u64, out_ptr: ptr, out_len: &u64) -> i32 {
    // trim + strip trailing '/' + lowercase, byte by byte.
    let start: u64 = 0;
    let end: u64 = value_len;
    while start < end {
        let c: u8 = 0;
        PTR_BYTE_AT(c, value_ptr, start);
        if c != 32 && c != 9 && c != 10 && c != 13 { break; };
        start = start + 1;
    }
    while end > start {
        let c: u8 = 0;
        PTR_BYTE_AT(c, value_ptr, end - 1);
        if c != 32 && c != 9 && c != 10 && c != 13 && c != 47 { break; };
        end = end - 1;
    }
    let n: u64 = 0;
    for i in start..end {
        let c: u8 = 0;
        PTR_BYTE_AT(c, value_ptr, i);
        if c >= 65 && c <= 90 { c = c + 32; };
        // DEFECT: writing a single byte into out buffer — sa_print_bytes-style
        // dynamic pointer stores from SLA are limited; byte store approximated.
        n = n + 1;
    }
    *out_len = n;
    return 0;
}

// Regex constants (freeOllama.ts:26-30)
// DEFECT: RegExp — SLA/sa_std has no regex engine; every pattern below is
// re-implemented as substring/prefix scans, which is only an approximation
// of the original alternation/anchor semantics.
//   EMBEDDING_MODEL_PATTERN    /(?:^|[\/:._-])embed(?:ding)?s?(?:$|[\/:._-])/i
//   MODEL_SIZE_PATTERN         /(?:^|[\/:._-])([0-9]+(?:\.[0-9]+)?)([bm])(?:$|[\/:._-])/i
//   COMMON_CHAT_MODEL_PATTERN  /(?:^|[\/_-])(?:qwen|glm|deepseek|gpt-oss|mistral|mixtral|llama|codellama|minimax|kimi)(?=[A-Za-z0-9\/:._-]|$)/i
//   KNOWN_SMALL_MODEL_PATTERN /(?:^|[\/_-])tinyllama(?:[\/:._-]|$)|(?:^|[\/_-])llama3\.2(?::latest)?$/i
const MAX_PROBE_MODELS_PER_SERVER: u64 = 5; // freeOllama.ts:31

// Helper for the regex approximations: case-insensitive substring search.
// DEFECT: regex — substring scan only; boundary classes [\/:._-] unchecked.
fn contains_ci(hay_ptr: ptr, hay_len: u64, needle_ptr: ptr, needle_len: u64) -> bool {
    if needle_len == 0 || hay_len < needle_len { return false; };
    let last = hay_len - needle_len;
    let i: u64 = 0;
    while i <= last {
        let ok = true;
        let j: u64 = 0;
        while j < needle_len {
            let a: u8 = 0;
            let b: u8 = 0;
            PTR_BYTE_AT(a, hay_ptr, i + j);
            PTR_BYTE_AT(b, needle_ptr, j);
            if a >= 65 && a <= 90 { a = a + 32; };
            if b >= 65 && b <= 90 { b = b + 32; };
            if a != b { ok = false; break; };
            j = j + 1;
        }
        if ok { return true; };
        i = i + 1;
    }
    return false;
}

// Keep chat/generation models and drop embeddings or models explicitly below 7B.
// export function eligibleFreeOllamaModels(models: unknown): string[] (freeOllama.ts:34-51)
// DEFECT: dynamic JSON — `models: unknown` arrives as a JSON text buffer; the
// Array.isArray / typeof-string filter chain runs over parsed JSON, not values.
// DEFECT: Set dedup ([...new Set(...)]) — no Set type; dedup is an O(n^2) scan.
// DEFECT: regex filters — see pattern DEFECT above; each .test() is contains_ci.
fn eligibleFreeOllamaModels(models_json_ptr: ptr, models_json_len: u64, out_ptr: ptr, out_lens: &u64, out_count: &u64) -> i32 {
    // Pipeline preserved from source:
    //   if (!Array.isArray(models)) return [];
    //   [...new Set(models
    //     .filter(typeof string).map(trim).filter(Boolean)
    //     .filter(!EMBEDDING_MODEL_PATTERN.test)
    //     .filter(COMMON_CHAT_MODEL_PATTERN.test)
    //     .filter(!KNOWN_SMALL_MODEL_PATTERN.test)
    //     .filter(size: match MODEL_SIZE_PATTERN; no match -> keep;
    //             billions = unit=="m" ? amount/1000 : amount; keep if >= 7))]
    // DEFECT: JSON array parsing + per-element pipeline not implemented in
    // this pass; counts stay 0.
    *out_count = 0;
    return 0;
}

// Parse the ([0-9]+(?:\.[0-9]+)?)([bm]) capture of MODEL_SIZE_PATTERN.
// DEFECT: regex capture groups — hand scan for digits[.digits][b|m] after a
// boundary byte; returns has_match + amount + unit.
fn model_size_match(model_ptr: ptr, model_len: u64, amount: &f64, is_m: &bool) -> bool {
    // DEFECT: not implemented in this pass (regex approximation pending).
    *amount = 0.0;
    *is_m = false;
    return false;
}

// export function buildFreeOllamaGroups(entries: FreeOllamaSourceEntry[]): ChannelGroupConfig[] (freeOllama.ts:53-77)
