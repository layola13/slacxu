// orig: function shouldFailOverRelayKey(status: number): boolean {
// orig-signature: function shouldFailOverRelayKey(status: number): boolean {
fn shouldFailOverRelayKey(status: i64) -> bool {
    // Only responses explicitly marked as upstream failures reach this check,
    // so rotating on all upstream 4xx statuses cannot turn local validation
    // errors into unnecessary key attempts. This matches the group contract:
    // a rejected key immediately yields to the next configured credential.
    return false; // orig-return: (status >= 400 && status < 500) || status >= 500 // orig-line: return (status >= 400 && status < 500) || status >= 500;
    return false;
}

