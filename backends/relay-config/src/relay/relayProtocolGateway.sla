                    let args_in = RpgStr { bytes: [0u8; 8192], len: 0 };
                    let okai: bool = jg_str(item, STR_PTR("arguments"), STR_LEN("arguments"), &args_in);
                    let args = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
                    normalizedFunctionArguments(rpg_rs_ptr(&args_in), args_in.len, &args);
                    if args.len > 0 {
                        let delta_ev: u64 = rpg_new_obj();
                        rc = js_str(delta_ev, STR_PTR("type"), STR_LEN("type"), STR_PTR("response.function_call_arguments.delta"), STR_LEN("response.function_call_arguments.delta"));
                        rc = js_i64(delta_ev, STR_PTR("sequence_number"), STR_LEN("sequence_number"), sequence);
                        sequence = sequence + 1;
                        rc = js_str(delta_ev, STR_PTR("item_id"), STR_LEN("item_id"), rpg_rs_ptr(&item_id), item_id.len);
                        rc = js_i64(delta_ev, STR_PTR("output_index"), STR_LEN("output_index"), oi as i64);
                        rc = js_str(delta_ev, STR_PTR("delta"), STR_LEN("delta"), rpg_jb_ptr(&args), args.len);
                        let delta_text = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
                        st = rpg_doc_to_jb(delta_ev, &delta_text);
                        rpg_free_doc(delta_ev);
                        rpg_sse_enqueue(&body, STR_PTR("response.function_call_arguments.delta"), STR_LEN("response.function_call_arguments.delta"), true, rpg_jb_ptr(&delta_text), delta_text.len);
                    };
                    let done_ev: u64 = rpg_new_obj();
                    rc = js_str(done_ev, STR_PTR("type"), STR_LEN("type"), STR_PTR("response.function_call_arguments.done"), STR_LEN("response.function_call_arguments.done"));
                    rc = js_i64(done_ev, STR_PTR("sequence_number"), STR_LEN("sequence_number"), sequence);
                    sequence = sequence + 1;
                    rc = js_str(done_ev, STR_PTR("item_id"), STR_LEN("item_id"), rpg_rs_ptr(&item_id), item_id.len);
                    rc = js_i64(done_ev, STR_PTR("output_index"), STR_LEN("output_index"), oi as i64);
                    rc = js_str(done_ev, STR_PTR("arguments"), STR_LEN("arguments"), rpg_jb_ptr(&args), args.len);
                    let done_text = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
                    st = rpg_doc_to_jb(done_ev, &done_text);
                    rpg_free_doc(done_ev);
                    rpg_sse_enqueue(&body, STR_PTR("response.function_call_arguments.done"), STR_LEN("response.function_call_arguments.done"), true, rpg_jb_ptr(&done_text), done_text.len);
                } else if has_item_type && rpg_rs_eq(&item_type, STR_PTR("custom_tool_call"), STR_LEN("custom_tool_call")) {
                    let content_in = RpgStr { bytes: [0u8; 8192], len: 0 };
                    let okci: bool = jg_str(item, STR_PTR("input"), STR_LEN("input"), &content_in);
                    if content_in.len > 0 {
                        let delta_ev: u64 = rpg_new_obj();
                        rc = js_str(delta_ev, STR_PTR("type"), STR_LEN("type"), STR_PTR("response.custom_tool_call_input.delta"), STR_LEN("response.custom_tool_call_input.delta"));
                        rc = js_i64(delta_ev, STR_PTR("sequence_number"), STR_LEN("sequence_number"), sequence);
                        sequence = sequence + 1;
                        rc = js_str(delta_ev, STR_PTR("item_id"), STR_LEN("item_id"), rpg_rs_ptr(&item_id), item_id.len);
                        rc = js_i64(delta_ev, STR_PTR("output_index"), STR_LEN("output_index"), oi as i64);
                        rc = js_str(delta_ev, STR_PTR("delta"), STR_LEN("delta"), rpg_rs_ptr(&content_in), content_in.len);
                        let delta_text = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
                        st = rpg_doc_to_jb(delta_ev, &delta_text);
                        rpg_free_doc(delta_ev);
                        rpg_sse_enqueue(&body, STR_PTR("response.custom_tool_call_input.delta"), STR_LEN("response.custom_tool_call_input.delta"), true, rpg_jb_ptr(&delta_text), delta_text.len);
                    };
                    let done_ev: u64 = rpg_new_obj();
                    rc = js_str(done_ev, STR_PTR("type"), STR_LEN("type"), STR_PTR("response.custom_tool_call_input.done"), STR_LEN("response.custom_tool_call_input.done"));
                    rc = js_i64(done_ev, STR_PTR("sequence_number"), STR_LEN("sequence_number"), sequence);
                    sequence = sequence + 1;
                    rc = js_str(done_ev, STR_PTR("item_id"), STR_LEN("item_id"), rpg_rs_ptr(&item_id), item_id.len);
                    rc = js_i64(done_ev, STR_PTR("output_index"), STR_LEN("output_index"), oi as i64);
                    rc = js_str(done_ev, STR_PTR("input"), STR_LEN("input"), rpg_rs_ptr(&content_in), content_in.len);
                    let done_text = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
                    st = rpg_doc_to_jb(done_ev, &done_text);
                    rpg_free_doc(done_ev);
                    rpg_sse_enqueue(&body, STR_PTR("response.custom_tool_call_input.done"), STR_LEN("response.custom_tool_call_input.done"), true, rpg_jb_ptr(&done_text), done_text.len);
                };
                // output_item.done with the original item
                let done_item_ev: u64 = rpg_new_obj();
                rc = js_str(done_item_ev, STR_PTR("type"), STR_LEN("type"), STR_PTR("response.output_item.done"), STR_LEN("response.output_item.done"));
                rc = js_i64(done_item_ev, STR_PTR("sequence_number"), STR_LEN("sequence_number"), sequence);
                sequence = sequence + 1;
                rc = js_i64(done_item_ev, STR_PTR("output_index"), STR_LEN("output_index"), oi as i64);
                rc = js_node(done_item_ev, STR_PTR("item"), STR_LEN("item"), rpg_clone_node(item));
                let done_item_text = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
                st = rpg_doc_to_jb(done_item_ev, &done_item_text);
                rpg_free_doc(done_item_ev);
                rpg_sse_enqueue(&body, STR_PTR("response.output_item.done"), STR_LEN("response.output_item.done"), true, rpg_jb_ptr(&done_item_text), done_item_text.len);
            };
            oi = oi + 1;
        }
    };
    // terminal event with the full original response
    let terminal: u64 = rpg_new_obj();
    let terminal_type: ptr = STR_PTR("response.completed");
    let terminal_type_n: u64 = STR_LEN("response.completed");
    if is_incomplete { terminal_type = STR_PTR("response.incomplete"); terminal_type_n = STR_LEN("response.incomplete"); };
    rc = js_str(terminal, STR_PTR("type"), STR_LEN("type"), terminal_type, terminal_type_n);
    rc = js_i64(terminal, STR_PTR("sequence_number"), STR_LEN("sequence_number"), sequence);
    if doc != 0 { rc = js_node(terminal, STR_PTR("response"), STR_LEN("response"), rpg_clone_node(doc)); };
    let terminal_text = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
    st = rpg_doc_to_jb(terminal, &terminal_text);
    rpg_free_doc(terminal);
    rpg_sse_enqueue(&body, terminal_type, terminal_type_n, true, rpg_jb_ptr(&terminal_text), terminal_text.len);
    rpg_sse_enqueue(&body, PTR_NULL(), 0, false, STR_PTR("[DONE]"), STR_LEN("[DONE]"));
    rpg_free_doc(doc);
    let headers = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
    rpg_jb_assign(&headers, STR_PTR("{\"content-type\":\"text/event-stream; charset=utf-8\",\"cache-control\":\"no-cache\",\"connection\":\"keep-alive\"}"), STR_LEN("{\"content-type\":\"text/event-stream; charset=utf-8\",\"cache-control\":\"no-cache\",\"connection\":\"keep-alive\"}"));
    rpg_make_response(200, &headers, &body, out);
    return 0;
}
// translateNativeEventStream (TS 2798): drive the ResponsesStreamWriter
// over a materialized upstream SSE body.
fn translateNativeEventStream(response: &rpg_JsonBuf, protocol_p: ptr, protocol_n: u64, request: &CanonicalRequest, out: &rpg_JsonBuf) -> i32 {
    let model = RpgStr { bytes: [0u8; 8192], len: 0 };
    rpg_canonical_model(&request.json, &model);
    let tools = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
    rpg_canonical_tools(&request.json, &tools);
    let writer = ResponsesStreamWriter { state: rpg_JsonBuf { bytes: [0u8; 262144], len: 0 } };
    let crc: i32 = ResponsesStreamWriter_constructor(&writer, rpg_rs_ptr(&model), model.len, &tools);
    ResponsesStreamWriter_start(&writer);
    let body_text = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
    rpg_response_body(response, &body_text);
    let failed: bool = false;
    let pos: u64 = 0;
    let more: bool = true;
    while more && !failed {
        let data = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
        let name = RpgStr { bytes: [0u8; 8192], len: 0 };
        let has_name: bool = false;
        if !rpg_sse_next(&body_text, &pos, &data, &name, &has_name) { more = false; break; };
        if rpg_jb_eq_lit(&data, STR_PTR("[DONE]"), STR_LEN("[DONE]")) { continue; };
        let parsed: u64 = rpg_jb_doc(&data);
        if parsed == 0 {
            let message = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
            rpg_jb_append_lit(&message, STR_PTR("Upstream "), STR_LEN("Upstream "));
            rpg_jb_append(&message, protocol_p, protocol_n);
            rpg_jb_append_lit(&message, STR_PTR(" emitted invalid SSE JSON"), STR_LEN(" emitted invalid SSE JSON"));
            ResponsesStreamWriter_fail(&writer, rpg_jb_ptr(&message), message.len);
            failed = true;
            break;
        };
        rpg_free_doc(parsed);
        let events = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
        if rpg_bytes_eq(protocol_p, protocol_n, STR_PTR("openai"), STR_LEN("openai")) {
            let erc: i32 = chatChunkToCanonicalEvents(&data, &tools, &events);
        } else if rpg_bytes_eq(protocol_p, protocol_n, STR_PTR("anthropic"), STR_LEN("anthropic")) {
            let erc: i32 = anthropicChunkToCanonicalEvents(&data, rpg_rs_ptr(&name), name.len, has_name, &events);
        } else {
            let erc: i32 = geminiChunkToCanonicalEvents(&data, &events);
        };
        let events_doc: u64 = rpg_jb_doc(&events);
        if events_doc != 0 && jn_kind(events_doc) == JK_ARRAY {
            let count: u64 = jn_count(events_doc);
            let i: u64 = 0;
            while i < count && !failed {
                let node: u64 = ja_at(events_doc, i);
                if node != 0 {
                    let event = CanonicalStreamEvent { json: rpg_JsonBuf { bytes: [0u8; 262144], len: 0 } };
                    let st: i32 = rpg_node_to_jb(node, &event.json);
                    let etype = RpgStr { bytes: [0u8; 8192], len: 0 };
                    let edoc: u64 = rpg_jb_doc(&event.json);
                    let is_error: bool = false;
                    let emessage = RpgStr { bytes: [0u8; 8192], len: 0 };
                    if edoc != 0 && jg_str(edoc, STR_PTR("type"), STR_LEN("type"), &etype) && rpg_rs_eq(&etype, STR_PTR("error"), STR_LEN("error")) {
                        is_error = true;
                        let okm: bool = jg_str(edoc, STR_PTR("message"), STR_LEN("message"), &emessage);
                    };
                    rpg_free_doc(edoc);
                    if is_error {
                        ResponsesStreamWriter_fail(&writer, rpg_rs_ptr(&emessage), emessage.len);
                        failed = true;
                    } else {
                        let arc: i32 = ResponsesStreamWriter_accept(&writer, &event);
                    };
                };
                i = i + 1;
            }
        };
        rpg_free_doc(events_doc);
    }
    if !failed { ResponsesStreamWriter_complete(&writer); };
    let body = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
    rpg_writer_body(&writer, &body);
    let headers = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
    rpg_jb_assign(&headers, STR_PTR("{\"content-type\":\"text/event-stream; charset=utf-8\",\"cache-control\":\"no-cache\",\"connection\":\"keep-alive\"}"), STR_LEN("{\"content-type\":\"text/event-stream; charset=utf-8\",\"cache-control\":\"no-cache\",\"connection\":\"keep-alive\"}"));
    rpg_make_response(200, &headers, &body, out);
    return 0;
}

// ================= Z3: embedded opencode-local (TS 454-777) =================
// The runner itself is injected by the server entrypoint as a host function
// (setEmbeddedOpencodeRunner stores its descriptor in the rpg.opencodeRunner
// cell, Z2). There is no SLA-callable bridge surface in this import graph
// (the FIX_BACKENDS §4 hostServices seam), so execution fails closed:
// unconfigured -> the TS message verbatim; configured -> an explicit seam
// error. canonicalToPlainPrompt is pure and fully ported.

fn rpg_trimmed_jb(value_p: ptr, value_n: u64, out: &rpg_JsonBuf) -> void {
    out.len = 0;
    let lo: u64 = 0;
    let hi: u64 = 0;
    rpg_trim_range(value_p, value_n, &lo, &hi);
    if hi > lo {
        let p: ptr = PTR_NULL();
        PTR_BYTE_ADD(p, value_p, lo);
        rpg_jb_append(out, p, hi - lo);
    };
}
// canonicalToPlainPrompt (TS 748): full-retention flattening to plain text.
fn canonicalToPlainPrompt(request: &CanonicalRequest, out: &rpg_JsonBuf) -> i32 {
    out.len = 0;
    let blocks = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
    let block_count: u64 = 0;
    let doc: u64 = rpg_jb_doc(&request.json);
    if doc == 0 || jn_kind(doc) != JK_OBJECT {
        out.len = 0;
        return 0;
    };
    // instructions
    let instructions = RpgStr { bytes: [0u8; 8192], len: 0 };
    if jg_str(doc, STR_PTR("instructions"), STR_LEN("instructions"), &instructions) {
        let trimmed = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
        rpg_trimmed_jb(rpg_rs_ptr(&instructions), instructions.len, &trimmed);
        if trimmed.len > 0 {
            if block_count > 0 { rpg_jb_append_lit(&blocks, STR_PTR("\n\n"), STR_LEN("\n\n")); };
            rpg_jb_append_lit(&blocks, STR_PTR("[Instructions]\n"), STR_LEN("[Instructions]\n"));
            rpg_jb_append(&blocks, rpg_jb_ptr(&trimmed), trimmed.len);
            block_count = block_count + 1;
        };
    };
    // tools
    let tools: u64 = jg_node(doc, STR_PTR("tools"), STR_LEN("tools"));
    if tools != 0 && jn_kind(tools) == JK_ARRAY {
        let count: u64 = jn_count(tools);
        let i: u64 = 0;
        while i < count {
            let tool: u64 = ja_at(tools, i);
            if tool != 0 && jn_kind(tool) == JK_OBJECT {
                let name = RpgStr { bytes: [0u8; 8192], len: 0 };
                let has_name: bool = jg_str(tool, STR_PTR("responseName"), STR_LEN("responseName"), &name) && name.len > 0;
                if !has_name { has_name = jg_str(tool, STR_PTR("name"), STR_LEN("name"), &name); };
                let desc = RpgStr { bytes: [0u8; 8192], len: 0 };
                let has_desc: bool = jg_str(tool, STR_PTR("description"), STR_LEN("description"), &desc);
                let desc_trimmed = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
                if has_desc { rpg_trimmed_jb(rpg_rs_ptr(&desc), desc.len, &desc_trimmed); };
                let schema_text = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
                let schema: u64 = jg_node(tool, STR_PTR("inputSchema"), STR_LEN("inputSchema"));
                if schema != 0 && jn_kind(schema) != JK_NULL { let st: i32 = rpg_node_to_jb(schema, &schema_text); } else { rpg_jb_assign(&schema_text, STR_PTR("{}"), STR_LEN("{}")); };
                if block_count > 0 { rpg_jb_append_lit(&blocks, STR_PTR("\n\n"), STR_LEN("\n\n")); };
                rpg_jb_append_lit(&blocks, STR_PTR("[Function "), STR_LEN("[Function "));
                rpg_jb_append(&blocks, rpg_rs_ptr(&name), name.len);
                rpg_jb_append_lit(&blocks, STR_PTR("]"), STR_LEN("]"));
                if desc_trimmed.len > 0 {
                    rpg_jb_push(&blocks, 10);
                    rpg_jb_append(&blocks, rpg_jb_ptr(&desc_trimmed), desc_trimmed.len);
                };
                rpg_jb_append_lit(&blocks, STR_PTR("\nArguments schema: "), STR_LEN("\nArguments schema: "));
                rpg_jb_append(&blocks, rpg_jb_ptr(&schema_text), schema_text.len);
                block_count = block_count + 1;
            };
            i = i + 1;
        }
    };
    // messages
    let messages: u64 = jg_node(doc, STR_PTR("messages"), STR_LEN("messages"));
    if messages != 0 && jn_kind(messages) == JK_ARRAY {
        let count: u64 = jn_count(messages);
        let mi: u64 = 0;
        while mi < count {
            let message: u64 = ja_at(messages, mi);
            if message != 0 && jn_kind(message) == JK_OBJECT {
                let role = RpgStr { bytes: [0u8; 8192], len: 0 };
                let has_role: bool = jg_str(message, STR_PTR("role"), STR_LEN("role"), &role);
                // texts from content parts
                let texts = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
                let text_count: u64 = 0;
                let content: u64 = jg_node(message, STR_PTR("content"), STR_LEN("content"));
                if content != 0 && jn_kind(content) == JK_ARRAY {
                    let cc: u64 = jn_count(content);
                    let ci: u64 = 0;
                    while ci < cc {
                        let part: u64 = ja_at(content, ci);
                        if part != 0 && jn_kind(part) == JK_OBJECT {
                            let part_type = RpgStr { bytes: [0u8; 8192], len: 0 };
                            let has_pt: bool = jg_str(part, STR_PTR("type"), STR_LEN("type"), &part_type);
                            if has_pt && rpg_rs_eq(&part_type, STR_PTR("text"), STR_LEN("text")) {
                                let raw = RpgStr { bytes: [0u8; 8192], len: 0 };
                                if jg_str(part, STR_PTR("text"), STR_LEN("text"), &raw) {
                                    let trimmed = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
                                    rpg_trimmed_jb(rpg_rs_ptr(&raw), raw.len, &trimmed);
                                    if trimmed.len > 0 {
                                        if text_count > 0 { rpg_jb_push(&texts, 10); };
                                        rpg_jb_append(&texts, rpg_jb_ptr(&trimmed), trimmed.len);
                                        text_count = text_count + 1;
                                    };
                                };
                            } else if has_pt && rpg_rs_eq(&part_type, STR_PTR("image"), STR_LEN("image")) {
                                if text_count > 0 { rpg_jb_push(&texts, 10); };
                                rpg_jb_append_lit(&texts, STR_PTR("[image omitted: relay gateway image input is not forwarded to the local turn]"), STR_LEN("[image omitted: relay gateway image input is not forwarded to the local turn]"));
                                text_count = text_count + 1;
                            };
                        };
                        ci = ci + 1;
                    }
                };
                // rendered tool calls
                let calls = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
                let call_count: u64 = 0;
                let tool_calls: u64 = jg_node(message, STR_PTR("toolCalls"), STR_LEN("toolCalls"));
                if tool_calls != 0 && jn_kind(tool_calls) == JK_ARRAY {
                    let tc: u64 = jn_count(tool_calls);
                    let ti: u64 = 0;
                    while ti < tc {
                        let call: u64 = ja_at(tool_calls, ti);
                        if call != 0 && jn_kind(call) == JK_OBJECT {
                            let cid = RpgStr { bytes: [0u8; 8192], len: 0 };
                            let cname = RpgStr { bytes: [0u8; 8192], len: 0 };
                            let cargs = RpgStr { bytes: [0u8; 8192], len: 0 };
                            let ok1: bool = jg_str(call, STR_PTR("id"), STR_LEN("id"), &cid);
                            let ok2: bool = jg_str(call, STR_PTR("name"), STR_LEN("name"), &cname);
                            let ok3: bool = jg_str(call, STR_PTR("arguments"), STR_LEN("arguments"), &cargs);
                            if call_count > 0 { rpg_jb_push(&calls, 10); };
                            rpg_jb_append_lit(&calls, STR_PTR("[Tool call id="), STR_LEN("[Tool call id="));
                            rpg_jb_append(&calls, rpg_rs_ptr(&cid), cid.len);
                            rpg_jb_append_lit(&calls, STR_PTR(" name="), STR_LEN(" name="));
                            rpg_jb_append(&calls, rpg_rs_ptr(&cname), cname.len);
                            rpg_jb_append_lit(&calls, STR_PTR("]\n"), STR_LEN("]\n"));
                            let trimmed = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
                            rpg_trimmed_jb(rpg_rs_ptr(&cargs), cargs.len, &trimmed);
                            rpg_jb_append(&calls, rpg_jb_ptr(&trimmed), trimmed.len);
                            call_count = call_count + 1;
                        };
                        ti = ti + 1;
                    }
                };
                if rpg_rs_eq(&role, STR_PTR("system"), STR_LEN("system")) {
                    if text_count > 0 {
                        if block_count > 0 { rpg_jb_append_lit(&blocks, STR_PTR("\n\n"), STR_LEN("\n\n")); };
                        rpg_jb_append_lit(&blocks, STR_PTR("[System]\n"), STR_LEN("[System]\n"));
                        rpg_jb_append(&blocks, rpg_jb_ptr(&texts), texts.len);
                        block_count = block_count + 1;
                    };
                    if call_count > 0 {
                        // each call is its own block; calls jb holds them \n-joined,
                        // TS pushes them as separate blocks joined by \n\n
                        if block_count > 0 { rpg_jb_append_lit(&blocks, STR_PTR("\n\n"), STR_LEN("\n\n")); };
                        rpg_jb_append(&blocks, rpg_jb_ptr(&calls), calls.len);
                        block_count = block_count + 1;
                    };
                } else if rpg_rs_eq(&role, STR_PTR("tool"), STR_LEN("tool")) {
                    if text_count > 0 {
                        let tool_call_id = RpgStr { bytes: [0u8; 8192], len: 0 };
                        let has_tcid: bool = jg_str(message, STR_PTR("toolCallId"), STR_LEN("toolCallId"), &tool_call_id) && tool_call_id.len > 0;
                        if block_count > 0 { rpg_jb_append_lit(&blocks, STR_PTR("\n\n"), STR_LEN("\n\n")); };
                        rpg_jb_append_lit(&blocks, STR_PTR("[Tool result"), STR_LEN("[Tool result"));
                        if has_tcid {
                            rpg_jb_append_lit(&blocks, STR_PTR(" (for "), STR_LEN(" (for "));
                            rpg_jb_append(&blocks, rpg_rs_ptr(&tool_call_id), tool_call_id.len);
                            rpg_jb_append_lit(&blocks, STR_PTR(")"), STR_LEN(")"));
                        };
                        rpg_jb_append_lit(&blocks, STR_PTR("]\n"), STR_LEN("]\n"));
                        rpg_jb_append(&blocks, rpg_jb_ptr(&texts), texts.len);
                        block_count = block_count + 1;
                    };
                    if call_count > 0 {
                        if block_count > 0 { rpg_jb_append_lit(&blocks, STR_PTR("\n\n"), STR_LEN("\n\n")); };
                        rpg_jb_append(&blocks, rpg_jb_ptr(&calls), calls.len);
                        block_count = block_count + 1;
                    };
                } else {
                    if text_count > 0 || call_count > 0 {
                        if block_count > 0 { rpg_jb_append_lit(&blocks, STR_PTR("\n\n"), STR_LEN("\n\n")); };
                        if rpg_rs_eq(&role, STR_PTR("user"), STR_LEN("user")) { rpg_jb_append_lit(&blocks, STR_PTR("User: "), STR_LEN("User: ")); } else { rpg_jb_append_lit(&blocks, STR_PTR("Assistant: "), STR_LEN("Assistant: ")); };
                        if text_count > 0 {
                            rpg_jb_append(&blocks, rpg_jb_ptr(&texts), texts.len);
                            if call_count > 0 { rpg_jb_push(&blocks, 10); };
                        };
                        if call_count > 0 { rpg_jb_append(&blocks, rpg_jb_ptr(&calls), calls.len); };
                        block_count = block_count + 1;
                    };
                };
            };
            mi = mi + 1;
        }
    };
    rpg_free_doc(doc);
    // final trim of the joined prompt
    rpg_trimmed_jb(rpg_jb_ptr(&blocks), blocks.len, out);
    return 0;
}
// Shared fail-closed core for the embedded runner entries.
fn rpg_embedded_unavailable(err: &rpg_JsonBuf) -> i32 {
    let descriptor = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
    if !rpg_runner_load(&descriptor) {
        rpg_jb_assign(err, STR_PTR("opencode-local bridge is not configured on this server"), STR_LEN("opencode-local bridge is not configured on this server"));
        return 1;
    };
    rpg_jb_assign(err, STR_PTR("opencode-local runner cannot be invoked from the SLA gateway build (host seam)"), STR_LEN("opencode-local runner cannot be invoked from the SLA gateway build (host seam)"));
    return 1;
}
fn runEmbeddedOpencodeLocalResult(request: &CanonicalRequest, source_req: &rpg_JsonBuf, out_result: &CanonicalResult, err: &rpg_JsonBuf) -> i32 {
    return rpg_embedded_unavailable(err);
}
fn runEmbeddedOpencodeLocalLive(request: &CanonicalRequest, source_req: &rpg_JsonBuf, out_text: &rpg_JsonBuf, out_call: &rpg_JsonBuf, err: &rpg_JsonBuf) -> i32 {
    out_text.len = 0;
    out_call.len = 0;
    return rpg_embedded_unavailable(err);
}
fn rpg_embedded_stream_fail(out: &rpg_JsonBuf) -> i32 {
    let err = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
    let rc: i32 = rpg_embedded_unavailable(&err);
    let empty = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
    let err_resp = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
    let status: i64 = embeddedOpencodeErrorStatus(rpg_jb_ptr(&err), err.len);
    let erc: i32 = errorResponse(status, rpg_jb_ptr(&err), err.len, &empty, &err_resp);
    let mrc: i32 = markUpstreamFailure(&err_resp, status, true, out);
    return 0;
}
fn streamEmbeddedOpencodeResponsesTurn(request: &CanonicalRequest, source_req: &rpg_JsonBuf, out: &rpg_JsonBuf) -> i32 {
    return rpg_embedded_stream_fail(out);
}
fn streamEmbeddedOpencodeChatTurn(request: &CanonicalRequest, source_req: &rpg_JsonBuf, out: &rpg_JsonBuf) -> i32 {
    return rpg_embedded_stream_fail(out);
}

// ================= Z4: embedded duck2api (TS 778-834) =================
// The app is created by pluginHostServices().relay.createDuck2ApiApp() —
// a host seam with no SLA surface in this import graph (FIX_BACKENDS §4).
// TS caches only successful creations and rethrows failures per call; the
// port mirrors that: the rpg.duck2apiApp cell holds a descriptor only when
// the host wiring stage stores one, and dispatch (in-process app.request)
// is likewise host-side, so requests fail with the TS-wrapped error text.

fn getDuck2ApiApp(out: &rpg_JsonBuf, err: &rpg_JsonBuf) -> i32 {
    out.len = 0;
    if rpg_d2api_load(out) { return 0; };
    rpg_jb_assign(err, STR_PTR("Embedded duck2api app creation is unavailable in the SLA gateway (host seam)"), STR_LEN("Embedded duck2api app creation is unavailable in the SLA gateway (host seam)"));
    return 1;
}
fn duck2apiCompletionsPath(out: &RpgStr) -> void {
    out.len = 0;
    let prefix = RpgStr { bytes: [0u8; 8192], len: 0 };
    let has_prefix: bool = rpg_env_get(STR_PTR("PREFIX"), STR_LEN("PREFIX"), &prefix);
    let trimmed = RpgStr { bytes: [0u8; 8192], len: 0 };
    if has_prefix {
        let lo: u64 = 0;
        let hi: u64 = 0;
        rpg_trim_range(rpg_rs_ptr(&prefix), prefix.len, &lo, &hi);
        if hi > lo {
            let p: ptr = PTR_NULL();
            PTR_BYTE_ADD(p, rpg_rs_ptr(&prefix), lo);
            rpg_rs_assign(&trimmed, p, hi - lo);
        };
    };
    if trimmed.len == 0 {
        rpg_rs_assign(out, STR_PTR("/v1/chat/completions"), STR_LEN("/v1/chat/completions"));
        return;
    };
    // clean = (prefix starts with "/" ? prefix : "/" + prefix) minus trailing "/"s
    let clean = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
    if !rpg_starts_with(rpg_rs_ptr(&trimmed), trimmed.len, STR_PTR("/"), STR_LEN("/")) { rpg_jb_append_lit(&clean, STR_PTR("/"), STR_LEN("/")); };
    rpg_jb_append(&clean, rpg_rs_ptr(&trimmed), trimmed.len);
    while clean.len > 0 && rpg_byte_at(rpg_jb_ptr(&clean), clean.len - 1) == 47 { clean.len = clean.len - 1; }
    rpg_jb_append_lit(&clean, STR_PTR("/v1/chat/completions"), STR_LEN("/v1/chat/completions"));
    rpg_rs_assign(out, rpg_jb_ptr(&clean), clean.len);
}
fn requestEmbeddedD2ApiCompletions(payload: &rpg_JsonBuf, api_key_p: ptr, api_key_n: u64, out_response: &rpg_JsonBuf, err: &rpg_JsonBuf) -> i32 {
    let app = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
    let creation_err = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
    if getDuck2ApiApp(&app, &creation_err) != 0 {
        rpg_jb_assign(err, STR_PTR("Embedded duck2api request failed: "), STR_LEN("Embedded duck2api request failed: "));
        rpg_jb_append(err, rpg_jb_ptr(&creation_err), creation_err.len);
        return 1;
    };
    // app.request(...) is an in-process host dispatch — no SLA surface.
    rpg_jb_assign(err, STR_PTR("Embedded duck2api request failed: duck2api app dispatch is unavailable in the SLA gateway (host seam)"), STR_LEN("Embedded duck2api request failed: duck2api app dispatch is unavailable in the SLA gateway (host seam)"));
    return 1;
}
fn fetchEmbeddedD2ApiCompletions(request: &CanonicalRequest, api_key_p: ptr, api_key_n: u64, stream: bool, out_response: &rpg_JsonBuf, err: &rpg_JsonBuf) -> i32 {
    let payload = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
    let options = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
    rpg_jb_assign(&options, STR_PTR("{}"), STR_LEN("{}"));
    let crc: i32 = canonicalToChat(request, &options, &payload);
    if stream {
        let doc: u64 = rpg_jb_doc(&payload);
        if doc != 0 && jn_kind(doc) == JK_OBJECT {
            let rc: i32 = js_bool(doc, STR_PTR("stream"), STR_LEN("stream"), true);
            let merged: u64 = rpg_new_obj();
            let existing: u64 = jg_node(doc, STR_PTR("stream_options"), STR_LEN("stream_options"));
            if existing != 0 && jn_kind(existing) == JK_OBJECT {
                let count: u64 = jn_count(existing);
                let i: u64 = 0;
                while i < count {
                    let kp: ptr = PTR_NULL();
                    let kn: u64 = 0;
                    if jg_key_at(existing, i, &kp, &kn) {
                        let node: u64 = jg_node(existing, kp, kn);
                        if node != 0 { rc = js_node(merged, kp, kn, rpg_clone_node(node)); };
                    };
                    i = i + 1;
                }
            };
            rc = js_bool(merged, STR_PTR("include_usage"), STR_LEN("include_usage"), true);
            rc = js_node(doc, STR_PTR("stream_options"), STR_LEN("stream_options"), merged);
            let st: i32 = rpg_doc_to_jb(doc, &payload);
        };
        rpg_free_doc(doc);
    };
    return requestEmbeddedD2ApiCompletions(&payload, api_key_p, api_key_n, out_response, err);
}
