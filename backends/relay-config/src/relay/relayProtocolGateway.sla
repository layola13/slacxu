    let has_version: bool = jg_str(record, STR_PTR("modelVersion"), STR_LEN("modelVersion"), &version) && version.len > 0;
    let finish = RpgStr { bytes: [0u8; 8192], len: 0 };
    let has_finish: bool = false;
    if candidate != 0 { has_finish = jg_str(candidate, STR_PTR("finishReason"), STR_LEN("finishReason"), &finish) && finish.len > 0; };
