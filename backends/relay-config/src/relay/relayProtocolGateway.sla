        if response != 0 && jn_kind(response) == JK_OBJECT {
            let output: u64 = jg_node(response, STR_PTR("output"), STR_LEN("output"));
            if output != 0 && jn_kind(output) == JK_ARRAY {
                let count: u64 = jn_count(output);
                let i: u64 = 0;
                while i < count {
                    let item: u64 = ja_at(output, i);
                    if item != 0 && jn_kind(item) == JK_OBJECT {
                        let item_type = RpgStr { bytes: [0u8; 8192], len: 0 };
                        let has_item_type: bool = jg_str(item, STR_PTR("type"), STR_LEN("type"), &item_type);
                        if has_item_type && (rpg_rs_eq(&item_type, STR_PTR("function_call"), STR_LEN("function_call")) || rpg_rs_eq(&item_type, STR_PTR("custom_tool_call"), STR_LEN("custom_tool_call"))) {
                            let item_jb = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
                            let st0: i32 = rpg_node_to_jb(item, &item_jb);
                            let event: u64 = rpg_new_obj();
                            let rc: i32 = js_str(event, STR_PTR("type"), STR_LEN("type"), STR_PTR("tool_start"), STR_LEN("tool_start"));
                            rc = js_i64(event, STR_PTR("index"), STR_LEN("index"), i as i64);
                            let id = RpgStr { bytes: [0u8; 8192], len: 0 };
                            let has_id: bool = nonEmptyStringValue(jg_node(item, STR_PTR("call_id"), STR_LEN("call_id")), &id);
                            if !has_id { has_id = nonEmptyStringValue(jg_node(item, STR_PTR("id"), STR_LEN("id")), &id); };
                            if has_id { rc = js_str(event, STR_PTR("id"), STR_LEN("id"), rpg_rs_ptr(&id), id.len); };
                            let name = RpgStr { bytes: [0u8; 8192], len: 0 };
                            let has_name: bool = responseFunctionCallName(&item_jb, &name);
                            if !has_name { has_name = rpg_tools_single_name(tools, &name); };
                            if has_name { rc = js_str(event, STR_PTR("name"), STR_LEN("name"), rpg_rs_ptr(&name), name.len); };
                            rpg_ev_metadata(events, event);
                        };
                    };
                    i = i + 1;
                }
            };
            let usage: u64 = jg_node(response, STR_PTR("usage"), STR_LEN("usage"));
            let event: u64 = rpg_new_obj();
            let rc: i32 = js_str(event, STR_PTR("type"), STR_LEN("type"), STR_PTR("metadata"), STR_LEN("metadata"));
            let model = RpgStr { bytes: [0u8; 8192], len: 0 };
            if jg_str(response, STR_PTR("model"), STR_LEN("model"), &model) && model.len > 0 { rc = js_str(event, STR_PTR("model"), STR_LEN("model"), rpg_rs_ptr(&model), model.len); };
            if usage != 0 {
                rpg_ev_set_num(event, STR_PTR("inputTokens"), STR_LEN("inputTokens"), jg_node(usage, STR_PTR("input_tokens"), STR_LEN("input_tokens")));
                rpg_ev_set_num(event, STR_PTR("outputTokens"), STR_LEN("outputTokens"), jg_node(usage, STR_PTR("output_tokens"), STR_LEN("output_tokens")));
                let details: u64 = jg_node(usage, STR_PTR("input_tokens_details"), STR_LEN("input_tokens_details"));
                if details != 0 {
                    rpg_ev_set_num(event, STR_PTR("cachedInputTokens"), STR_LEN("cachedInputTokens"), jg_node(details, STR_PTR("cached_tokens"), STR_LEN("cached_tokens")));
                    rpg_ev_set_num(event, STR_PTR("cacheWriteInputTokens"), STR_LEN("cacheWriteInputTokens"), jg_node(details, STR_PTR("cache_write_tokens"), STR_LEN("cache_write_tokens")));
                };
            };
            let status_text = RpgStr { bytes: [0u8; 8192], len: 0 };
            if jg_str(response, STR_PTR("status"), STR_LEN("status"), &status_text) && status_text.len > 0 { rc = js_str(event, STR_PTR("finishReason"), STR_LEN("finishReason"), rpg_rs_ptr(&status_text), status_text.len); };
            rpg_ev_metadata(events, event);
        };
        let st: i32 = rpg_doc_to_jb(events, out);
        rpg_free_doc(events);
        return 0;
    };
    if rpg_rs_eq(&type_text, STR_PTR("response.failed"), STR_LEN("response.failed")) {
        let response: u64 = jg_node(record, STR_PTR("response"), STR_LEN("response"));
        let message = RpgStr { bytes: [0u8; 8192], len: 0 };
        let has_message: bool = false;
        if response != 0 {
            let error: u64 = jg_node(response, STR_PTR("error"), STR_LEN("error"));
            if error != 0 { has_message = jg_str(error, STR_PTR("message"), STR_LEN("message"), &message) && message.len > 0; };
        };
        if !has_message { rpg_rs_assign(&message, STR_PTR("Responses upstream failed"), STR_LEN("Responses upstream failed")); };
        rpg_ev_error(events, rpg_rs_ptr(&message), message.len);
        let st: i32 = rpg_doc_to_jb(events, out);
        rpg_free_doc(events);
        return 0;
    };
    let st: i32 = rpg_doc_to_jb(events, out);
    rpg_free_doc(events);
    return 0;
}

// ================= Z14: ResponsesStreamWriter + responsesEventStream (TS 4394-4726) =================
// Writer state is a JSON object in the ResponsesStreamWriter.state carrier:
// {responseId, createdAt, model, tools, body, sequence, inputTokens,
//  outputTokens, cachedInputTokens, cacheWriteInputTokens, finishReason?,
//  closed, messageIndex, reasoningIndex,
//  outputs: [{index, eventIndex, id, kind, text, callId?, name?, namespace?}]}
// Emitted SSE text accumulates in state.body (materialized-stream port).

fn responsesToolName(value: u64, out: &RpgStr) -> bool {
    out.len = 0;
    if value == 0 || jn_kind(value) != JK_OBJECT { return false; };
    if jg_str(value, STR_PTR("name"), STR_LEN("name"), out) && out.len > 0 { return true; };
    let f: u64 = jg_node(value, STR_PTR("function"), STR_LEN("function"));
    if f != 0 && jn_kind(f) == JK_OBJECT && jg_str(f, STR_PTR("name"), STR_LEN("name"), out) && out.len > 0 { return true; };
    out.len = 0;
    return false;
}
fn rpg_w_doc(writer: &ResponsesStreamWriter) -> u64 {
    return rpg_jb_doc(&writer.state);
}
fn rpg_w_save(writer: &ResponsesStreamWriter, doc: u64) -> void {
    let st: i32 = rpg_doc_to_jb(doc, &writer.state);
    rpg_free_doc(doc);
}
fn rpg_writer_body(writer: &ResponsesStreamWriter, out: &rpg_JsonBuf) -> void {
    out.len = 0;
    let doc: u64 = rpg_w_doc(writer);
    if doc != 0 {
        let ok: bool = jg_str_jb(doc, STR_PTR("body"), STR_LEN("body"), out);
    };
    rpg_free_doc(doc);
}
fn ResponsesStreamWriter_constructor(writer: &ResponsesStreamWriter, model_p: ptr, model_n: u64, tools: &rpg_JsonBuf) -> i32 {
    let doc: u64 = rpg_new_obj();
    let uuid = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
    rpg_uuid_nodash(&uuid);
    let rid = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
    rpg_jb_append_lit(&rid, STR_PTR("resp_"), STR_LEN("resp_"));
    rpg_jb_append(&rid, rpg_jb_ptr(&uuid), uuid.len);
    let rc: i32 = js_str(doc, STR_PTR("responseId"), STR_LEN("responseId"), rpg_jb_ptr(&rid), rid.len);
    rc = js_i64(doc, STR_PTR("createdAt"), STR_LEN("createdAt"), rpg_now_ms() / 1000);
    rc = js_str(doc, STR_PTR("model"), STR_LEN("model"), model_p, model_n);
    let tools_doc: u64 = rpg_jb_doc(tools);
    if tools_doc != 0 && jn_kind(tools_doc) == JK_ARRAY {
        rc = js_node(doc, STR_PTR("tools"), STR_LEN("tools"), tools_doc);
    } else {
        let empty_arr: u64 = rpg_new_arr();
        rc = js_node(doc, STR_PTR("tools"), STR_LEN("tools"), empty_arr);
        rpg_free_doc(tools_doc);
    };
    rc = js_str(doc, STR_PTR("body"), STR_LEN("body"), STR_PTR(""), STR_LEN(""));
    rc = js_i64(doc, STR_PTR("sequence"), STR_LEN("sequence"), 0);
    rc = js_i64(doc, STR_PTR("inputTokens"), STR_LEN("inputTokens"), 0);
    rc = js_i64(doc, STR_PTR("outputTokens"), STR_LEN("outputTokens"), 0);
    rc = js_i64(doc, STR_PTR("cachedInputTokens"), STR_LEN("cachedInputTokens"), 0);
    rc = js_i64(doc, STR_PTR("cacheWriteInputTokens"), STR_LEN("cacheWriteInputTokens"), 0);
    rc = js_bool(doc, STR_PTR("closed"), STR_LEN("closed"), false);
    rc = js_i64(doc, STR_PTR("messageIndex"), STR_LEN("messageIndex"), 0 - 1);
    rc = js_i64(doc, STR_PTR("reasoningIndex"), STR_LEN("reasoningIndex"), 0 - 1);
    let outputs: u64 = rpg_new_arr();
    rc = js_node(doc, STR_PTR("outputs"), STR_LEN("outputs"), outputs);
    rpg_w_save(writer, doc);
    return 0;
}
fn ResponsesStreamWriter_enqueue(writer: &ResponsesStreamWriter, text_p: ptr, text_n: u64) -> void {
    let doc: u64 = rpg_w_doc(writer);
    if doc == 0 { return; };
    let closed: bool = false;
    let okb: bool = jg_bool(doc, STR_PTR("closed"), STR_LEN("closed"), &closed);
    if !closed {
        let body = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
        let ok: bool = jg_str_jb(doc, STR_PTR("body"), STR_LEN("body"), &body);
        rpg_jb_append(&body, text_p, text_n);
        let rc: i32 = js_str(doc, STR_PTR("body"), STR_LEN("body"), rpg_jb_ptr(&body), body.len);
    };
    rpg_w_save(writer, doc);
}
fn ResponsesStreamWriter_emit(writer: &ResponsesStreamWriter, type_p: ptr, type_n: u64, payload: u64) -> void {
    let doc: u64 = rpg_w_doc(writer);
    if doc == 0 { return; };
    let closed: bool = false;
    let okb: bool = jg_bool(doc, STR_PTR("closed"), STR_LEN("closed"), &closed);
    if closed { rpg_w_save(writer, doc); return; };
    let sequence: i64 = 0;
    let oki: bool = jg_i64(doc, STR_PTR("sequence"), STR_LEN("sequence"), &sequence);
    let event: u64 = rpg_new_obj();
    let rc: i32 = js_str(event, STR_PTR("type"), STR_LEN("type"), type_p, type_n);
    rc = js_i64(event, STR_PTR("sequence_number"), STR_LEN("sequence_number"), sequence);
    if payload != 0 && jn_kind(payload) == JK_OBJECT {
        let count: u64 = jn_count(payload);
        let i: u64 = 0;
        while i < count {
            let kp: ptr = PTR_NULL();
            let kn: u64 = 0;
            if jg_key_at(payload, i, &kp, &kn) {
                let node: u64 = jg_node(payload, kp, kn);
                if node != 0 { rc = js_node(event, kp, kn, rpg_clone_node(node)); };
            };
            i = i + 1;
        }
    };
    rc = js_i64(doc, STR_PTR("sequence"), STR_LEN("sequence"), sequence + 1);
    let event_text = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
    let st: i32 = rpg_doc_to_jb(event, &event_text);
    rpg_free_doc(event);
    let frame = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
    rpg_jb_append_lit(&frame, STR_PTR("event: "), STR_LEN("event: "));
    rpg_jb_append(&frame, type_p, type_n);
    rpg_jb_push(&frame, 10);
    rpg_jb_append_lit(&frame, STR_PTR("data: "), STR_LEN("data: "));
    rpg_jb_append(&frame, rpg_jb_ptr(&event_text), event_text.len);
    rpg_jb_push(&frame, 10);
    rpg_jb_push(&frame, 10);
    let body = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
    let ok: bool = jg_str_jb(doc, STR_PTR("body"), STR_LEN("body"), &body);
    rpg_jb_append(&body, rpg_jb_ptr(&frame), frame.len);
    rc = js_str(doc, STR_PTR("body"), STR_LEN("body"), rpg_jb_ptr(&body), body.len);
    rpg_w_save(writer, doc);
}
fn ResponsesStreamWriter_response(writer: &ResponsesStreamWriter, status_p: ptr, status_n: u64, items: u64) -> u64 {
    let doc: u64 = rpg_w_doc(writer);
    let resp: u64 = rpg_new_obj();
    let rid = RpgStr { bytes: [0u8; 8192], len: 0 };
    let model = RpgStr { bytes: [0u8; 8192], len: 0 };
    let created: i64 = 0;
    let input_tokens: i64 = 0;
    let output_tokens: i64 = 0;
    let cached: i64 = 0;
    let write_tokens: i64 = 0;
    let finish = RpgStr { bytes: [0u8; 8192], len: 0 };
    let has_finish: bool = false;
    if doc != 0 {
        let ok1: bool = jg_str(doc, STR_PTR("responseId"), STR_LEN("responseId"), &rid);
        let ok2: bool = jg_str(doc, STR_PTR("model"), STR_LEN("model"), &model);
        let ok3: bool = jg_i64(doc, STR_PTR("createdAt"), STR_LEN("createdAt"), &created);
        let ok4: bool = jg_i64(doc, STR_PTR("inputTokens"), STR_LEN("inputTokens"), &input_tokens);
        let ok5: bool = jg_i64(doc, STR_PTR("outputTokens"), STR_LEN("outputTokens"), &output_tokens);
        let ok6: bool = jg_i64(doc, STR_PTR("cachedInputTokens"), STR_LEN("cachedInputTokens"), &cached);
        let ok7: bool = jg_i64(doc, STR_PTR("cacheWriteInputTokens"), STR_LEN("cacheWriteInputTokens"), &write_tokens);
        has_finish = jg_str(doc, STR_PTR("finishReason"), STR_LEN("finishReason"), &finish) && finish.len > 0;
    };
    let rc: i32 = js_str(resp, STR_PTR("id"), STR_LEN("id"), rpg_rs_ptr(&rid), rid.len);
    rc = js_str(resp, STR_PTR("object"), STR_LEN("object"), STR_PTR("response"), STR_LEN("response"));
    rc = js_i64(resp, STR_PTR("created_at"), STR_LEN("created_at"), created);
    rc = js_str(resp, STR_PTR("status"), STR_LEN("status"), status_p, status_n);
    rc = js_str(resp, STR_PTR("model"), STR_LEN("model"), rpg_rs_ptr(&model), model.len);
    rc = js_node(resp, STR_PTR("output"), STR_LEN("output"), items);
    rc = js_bool(resp, STR_PTR("parallel_tool_calls"), STR_LEN("parallel_tool_calls"), true);
    let metadata: u64 = rpg_new_obj();
    if has_finish { rc = js_str(metadata, STR_PTR("finish_reason"), STR_LEN("finish_reason"), rpg_rs_ptr(&finish), finish.len); };
    rc = js_node(resp, STR_PTR("metadata"), STR_LEN("metadata"), metadata);
    if rpg_bytes_eq(status_p, status_n, STR_PTR("in_progress"), STR_LEN("in_progress")) {
        rc = js_null(resp, STR_PTR("usage"), STR_LEN("usage"));
    } else {
        let usage: u64 = rpg_new_obj();
        let complete_input: i64 = input_tokens + cached + write_tokens;
        rc = js_i64(usage, STR_PTR("input_tokens"), STR_LEN("input_tokens"), complete_input);
        let details: u64 = rpg_new_obj();
        rc = js_i64(details, STR_PTR("cached_tokens"), STR_LEN("cached_tokens"), cached);
        rc = js_i64(details, STR_PTR("cache_write_tokens"), STR_LEN("cache_write_tokens"), write_tokens);
        rc = js_node(usage, STR_PTR("input_tokens_details"), STR_LEN("input_tokens_details"), details);
        rc = js_i64(usage, STR_PTR("output_tokens"), STR_LEN("output_tokens"), output_tokens);
        let odetails: u64 = rpg_new_obj();
        rc = js_i64(odetails, STR_PTR("reasoning_tokens"), STR_LEN("reasoning_tokens"), 0);
        rc = js_node(usage, STR_PTR("output_tokens_details"), STR_LEN("output_tokens_details"), odetails);
        rc = js_i64(usage, STR_PTR("total_tokens"), STR_LEN("total_tokens"), complete_input + output_tokens);
        rc = js_node(resp, STR_PTR("usage"), STR_LEN("usage"), usage);
    };
    rpg_w_save(writer, doc);
    return resp;
}
fn ResponsesStreamWriter_outputItem(writer: &ResponsesStreamWriter, output: u64, status_p: ptr, status_n: u64) -> u64 {
    let item: u64 = rpg_new_obj();
    let kind = RpgStr { bytes: [0u8; 8192], len: 0 };
    let id = RpgStr { bytes: [0u8; 8192], len: 0 };
    let ok1: bool = jg_str(output, STR_PTR("kind"), STR_LEN("kind"), &kind);
    let ok2: bool = jg_str(output, STR_PTR("id"), STR_LEN("id"), &id);
    let rc: i32 = js_str(item, STR_PTR("id"), STR_LEN("id"), rpg_rs_ptr(&id), id.len);
    let completed: bool = rpg_bytes_eq(status_p, status_n, STR_PTR("completed"), STR_LEN("completed"));
    if rpg_rs_eq(&kind, STR_PTR("message"), STR_LEN("message")) {
        rc = js_str(item, STR_PTR("type"), STR_LEN("type"), STR_PTR("message"), STR_LEN("message"));
        rc = js_str(item, STR_PTR("status"), STR_LEN("status"), status_p, status_n);
        rc = js_str(item, STR_PTR("role"), STR_LEN("role"), STR_PTR("assistant"), STR_LEN("assistant"));
        let content: u64 = rpg_new_arr();
        if completed {
            let part: u64 = rpg_new_obj();
            rc = js_str(part, STR_PTR("type"), STR_LEN("type"), STR_PTR("output_text"), STR_LEN("output_text"));
            let text = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
            let okt: bool = jg_str_jb(output, STR_PTR("text"), STR_LEN("text"), &text);
            rc = js_str(part, STR_PTR("text"), STR_LEN("text"), rpg_jb_ptr(&text), text.len);
            let annotations: u64 = rpg_new_arr();
            rc = js_node(part, STR_PTR("annotations"), STR_LEN("annotations"), annotations);
            rc = ja_push_node(content, part);
        };
        rc = js_node(item, STR_PTR("content"), STR_LEN("content"), content);
        return item;
    };
    if rpg_rs_eq(&kind, STR_PTR("reasoning"), STR_LEN("reasoning")) {
        rc = js_str(item, STR_PTR("type"), STR_LEN("type"), STR_PTR("reasoning"), STR_LEN("reasoning"));
        let summary: u64 = rpg_new_arr();
        if completed {
            let part: u64 = rpg_new_obj();
            rc = js_str(part, STR_PTR("type"), STR_LEN("type"), STR_PTR("summary_text"), STR_LEN("summary_text"));
            let text = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
            let okt: bool = jg_str_jb(output, STR_PTR("text"), STR_LEN("text"), &text);
            rc = js_str(part, STR_PTR("text"), STR_LEN("text"), rpg_jb_ptr(&text), text.len);
            rc = ja_push_node(summary, part);
        };
        rc = js_node(item, STR_PTR("summary"), STR_LEN("summary"), summary);
        return item;
    };
    rc = js_str(item, STR_PTR("type"), STR_LEN("type"), rpg_rs_ptr(&kind), kind.len);
    rc = js_str(item, STR_PTR("status"), STR_LEN("status"), status_p, status_n);
    let call_id = RpgStr { bytes: [0u8; 8192], len: 0 };
    let has_call: bool = jg_str(output, STR_PTR("callId"), STR_LEN("callId"), &call_id);
    if has_call { rc = js_str(item, STR_PTR("call_id"), STR_LEN("call_id"), rpg_rs_ptr(&call_id), call_id.len); };
    let name = RpgStr { bytes: [0u8; 8192], len: 0 };
    let has_name: bool = jg_str(output, STR_PTR("name"), STR_LEN("name"), &name);
    if has_name { rc = js_str(item, STR_PTR("name"), STR_LEN("name"), rpg_rs_ptr(&name), name.len); };
    let text = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
    let okt: bool = jg_str_jb(output, STR_PTR("text"), STR_LEN("text"), &text);
    if rpg_rs_eq(&kind, STR_PTR("custom_tool_call"), STR_LEN("custom_tool_call")) {
        rc = js_str(item, STR_PTR("input"), STR_LEN("input"), rpg_jb_ptr(&text), text.len);
    } else {
        let normalized = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
        normalizedFunctionArguments(rpg_jb_ptr(&text), text.len, &normalized);
        rc = js_str(item, STR_PTR("arguments"), STR_LEN("arguments"), rpg_jb_ptr(&normalized), normalized.len);
    };
    let namespace = RpgStr { bytes: [0u8; 8192], len: 0 };
    if jg_str(output, STR_PTR("namespace"), STR_LEN("namespace"), &namespace) && namespace.len > 0 {
        rc = js_str(item, STR_PTR("namespace"), STR_LEN("namespace"), rpg_rs_ptr(&namespace), namespace.len);
    };
    return item;
}
fn ResponsesStreamWriter_addOutput(writer: &ResponsesStreamWriter, kind_p: ptr, kind_n: u64, id_p: ptr, id_n: u64, out_pos: &i64) -> i32 {
    let doc: u64 = rpg_w_doc(writer);
    *out_pos = 0;
    if doc == 0 { return 1; };
    let outputs: u64 = jg_node(doc, STR_PTR("outputs"), STR_LEN("outputs"));
    let pos: i64 = 0;
    if outputs != 0 { pos = jn_count(outputs) as i64; };
    let entry: u64 = rpg_new_obj();
    let rc: i32 = js_i64(entry, STR_PTR("index"), STR_LEN("index"), pos);
    rc = js_i64(entry, STR_PTR("eventIndex"), STR_LEN("eventIndex"), 0 - 1);
    rc = js_str(entry, STR_PTR("id"), STR_LEN("id"), id_p, id_n);
    rc = js_str(entry, STR_PTR("kind"), STR_LEN("kind"), kind_p, kind_n);
    rc = js_str(entry, STR_PTR("text"), STR_LEN("text"), STR_PTR(""), STR_LEN(""));
    if outputs != 0 { rc = ja_push_node(outputs, entry); };
    *out_pos = pos;
    rpg_w_save(writer, doc);
    return 0;
}
fn rpg_w_outputs(writer: &ResponsesStreamWriter, doc: u64) -> u64 {
    return jg_node(doc, STR_PTR("outputs"), STR_LEN("outputs"));
}
fn rpg_w_append_text(writer: &ResponsesStreamWriter, output: u64, delta_p: ptr, delta_n: u64) -> void {
    let text = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
    let ok: bool = jg_str_jb(output, STR_PTR("text"), STR_LEN("text"), &text);
    rpg_jb_append(&text, delta_p, delta_n);
    let rc: i32 = js_str(output, STR_PTR("text"), STR_LEN("text"), rpg_jb_ptr(&text), text.len);
}
fn ResponsesStreamWriter_ensureMessage(writer: &ResponsesStreamWriter, out_pos: &i64) -> i32 {
    let doc: u64 = rpg_w_doc(writer);
    let existing: i64 = 0 - 1;
    if doc != 0 { let ok: bool = jg_i64(doc, STR_PTR("messageIndex"), STR_LEN("messageIndex"), &existing); };
    rpg_w_save(writer, doc);
    if existing >= 0 { *out_pos = existing; return 0; };
    let uuid = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
    rpg_uuid_nodash(&uuid);
    let id = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
    rpg_jb_append_lit(&id, STR_PTR("msg_"), STR_LEN("msg_"));
    rpg_jb_append(&id, rpg_jb_ptr(&uuid), uuid.len);
    let pos: i64 = 0;
    let arc: i32 = ResponsesStreamWriter_addOutput(writer, STR_PTR("message"), STR_LEN("message"), rpg_jb_ptr(&id), id.len, &pos);
    let doc2: u64 = rpg_w_doc(writer);
    if doc2 != 0 { let rc: i32 = js_i64(doc2, STR_PTR("messageIndex"), STR_LEN("messageIndex"), pos); };
    let outputs: u64 = rpg_w_outputs(writer, doc2);
    let output: u64 = 0;
    if outputs != 0 { output = ja_at(outputs, pos as u64); };
    let item: u64 = 0;
    if output != 0 { item = ResponsesStreamWriter_outputItem(writer, output, STR_PTR("in_progress"), STR_LEN("in_progress")); };
    rpg_w_save(writer, doc2);
    if item != 0 {
        let payload: u64 = rpg_new_obj();
        let rc: i32 = js_i64(payload, STR_PTR("output_index"), STR_LEN("output_index"), pos);
        rc = js_node(payload, STR_PTR("item"), STR_LEN("item"), item);
        ResponsesStreamWriter_emit(writer, STR_PTR("response.output_item.added"), STR_LEN("response.output_item.added"), payload);
        rpg_free_doc(payload);
        let payload2: u64 = rpg_new_obj();
        rc = js_str(payload2, STR_PTR("item_id"), STR_LEN("item_id"), rpg_jb_ptr(&id), id.len);
        rc = js_i64(payload2, STR_PTR("output_index"), STR_LEN("output_index"), pos);
        rc = js_i64(payload2, STR_PTR("content_index"), STR_LEN("content_index"), 0);
        let part: u64 = rpg_new_obj();
        rc = js_str(part, STR_PTR("type"), STR_LEN("type"), STR_PTR("output_text"), STR_LEN("output_text"));
        rc = js_str(part, STR_PTR("text"), STR_LEN("text"), STR_PTR(""), STR_LEN(""));
        let annotations: u64 = rpg_new_arr();
        rc = js_node(part, STR_PTR("annotations"), STR_LEN("annotations"), annotations);
        rc = js_node(payload2, STR_PTR("part"), STR_LEN("part"), part);
        ResponsesStreamWriter_emit(writer, STR_PTR("response.content_part.added"), STR_LEN("response.content_part.added"), payload2);
        rpg_free_doc(payload2);
    };
    *out_pos = pos;
    return 0;
}
fn ResponsesStreamWriter_ensureReasoning(writer: &ResponsesStreamWriter, out_pos: &i64) -> i32 {
    let doc: u64 = rpg_w_doc(writer);
    let existing: i64 = 0 - 1;
    if doc != 0 { let ok: bool = jg_i64(doc, STR_PTR("reasoningIndex"), STR_LEN("reasoningIndex"), &existing); };
    rpg_w_save(writer, doc);
    if existing >= 0 { *out_pos = existing; return 0; };
    let uuid = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
    rpg_uuid_nodash(&uuid);
    let id = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
    rpg_jb_append_lit(&id, STR_PTR("rs_"), STR_LEN("rs_"));
    rpg_jb_append(&id, rpg_jb_ptr(&uuid), uuid.len);
    let pos: i64 = 0;
    let arc: i32 = ResponsesStreamWriter_addOutput(writer, STR_PTR("reasoning"), STR_LEN("reasoning"), rpg_jb_ptr(&id), id.len, &pos);
    let doc2: u64 = rpg_w_doc(writer);
    if doc2 != 0 { let rc: i32 = js_i64(doc2, STR_PTR("reasoningIndex"), STR_LEN("reasoningIndex"), pos); };
    let outputs: u64 = rpg_w_outputs(writer, doc2);
    let output: u64 = 0;
    if outputs != 0 { output = ja_at(outputs, pos as u64); };
    let item: u64 = 0;
    if output != 0 { item = ResponsesStreamWriter_outputItem(writer, output, STR_PTR("in_progress"), STR_LEN("in_progress")); };
    rpg_w_save(writer, doc2);
    if item != 0 {
        let payload: u64 = rpg_new_obj();
        let rc: i32 = js_i64(payload, STR_PTR("output_index"), STR_LEN("output_index"), pos);
        rc = js_node(payload, STR_PTR("item"), STR_LEN("item"), item);
        ResponsesStreamWriter_emit(writer, STR_PTR("response.output_item.added"), STR_LEN("response.output_item.added"), payload);
        rpg_free_doc(payload);
        let payload2: u64 = rpg_new_obj();
        rc = js_str(payload2, STR_PTR("item_id"), STR_LEN("item_id"), rpg_jb_ptr(&id), id.len);
        rc = js_i64(payload2, STR_PTR("output_index"), STR_LEN("output_index"), pos);
        rc = js_i64(payload2, STR_PTR("summary_index"), STR_LEN("summary_index"), 0);
        let part: u64 = rpg_new_obj();
        rc = js_str(part, STR_PTR("type"), STR_LEN("type"), STR_PTR("summary_text"), STR_LEN("summary_text"));
        rc = js_str(part, STR_PTR("text"), STR_LEN("text"), STR_PTR(""), STR_LEN(""));
        rc = js_node(payload2, STR_PTR("part"), STR_LEN("part"), part);
        ResponsesStreamWriter_emit(writer, STR_PTR("response.reasoning_summary_part.added"), STR_LEN("response.reasoning_summary_part.added"), payload2);
        rpg_free_doc(payload2);
    };
    *out_pos = pos;
    return 0;
}
// resolve a canonical tool by name from the writer's tools; fills the
// responseName/namespace/responseType views. Returns true when found.
fn rpg_w_resolve_tool(writer: &ResponsesStreamWriter, name_p: ptr, name_n: u64, has_name: bool, resp_name: &RpgStr, has_resp: &bool, namespace: &RpgStr, has_ns: &bool, is_custom: &bool) -> bool {
    *has_resp = false;
    *has_ns = false;
    *is_custom = false;
    resp_name.len = 0;
    namespace.len = 0;
    if !has_name { return false; };
    let doc: u64 = rpg_w_doc(writer);
    let tools_node: u64 = 0;
    if doc != 0 { tools_node = jg_node(doc, STR_PTR("tools"), STR_LEN("tools")); };
    let tools_jb = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
    if tools_node != 0 { let st: i32 = rpg_node_to_jb(tools_node, &tools_jb); } else { rpg_jb_assign(&tools_jb, STR_PTR("[]"), STR_LEN("[]")); };
    rpg_w_save(writer, doc);
    let tool = CanonicalTool { json: rpg_JsonBuf { bytes: [0u8; 262144], len: 0 } };
    let frc: i32 = findCanonicalTool(&tools_jb, name_p, name_n, has_name, &tool);
    if frc != 0 { return false; };
    let tdoc: u64 = rpg_jb_doc(&tool.json);
    if tdoc != 0 {
        *has_resp = jg_str(tdoc, STR_PTR("responseName"), STR_LEN("responseName"), resp_name) && resp_name.len > 0;
        *has_ns = jg_str(tdoc, STR_PTR("namespace"), STR_LEN("namespace"), namespace) && namespace.len > 0;
        let rtype = RpgStr { bytes: [0u8; 8192], len: 0 };
        if jg_str(tdoc, STR_PTR("responseType"), STR_LEN("responseType"), &rtype) && rpg_rs_eq(&rtype, STR_PTR("custom_tool_call"), STR_LEN("custom_tool_call")) { *is_custom = true; };
    };
    rpg_free_doc(tdoc);
    return true;
}
fn ResponsesStreamWriter_ensureTool(writer: &ResponsesStreamWriter, event_index: i64, id_p: ptr, id_n: u64, has_id: bool, name_p: ptr, name_n: u64, has_name: bool, out_pos: &i64) -> i32 {
    // existing tool output for this event index?
    let doc: u64 = rpg_w_doc(writer);
    let outputs: u64 = 0;
    if doc != 0 { outputs = rpg_w_outputs(writer, doc); };
    let found_pos: i64 = 0 - 1;
    if outputs != 0 {
        let count: u64 = jn_count(outputs);
        let i: u64 = 0;
        while i < count {
            let entry: u64 = ja_at(outputs, i);
            if entry != 0 {
                let kind = RpgStr { bytes: [0u8; 8192], len: 0 };
                let okk: bool = jg_str(entry, STR_PTR("kind"), STR_LEN("kind"), &kind);
                let ev: i64 = 0 - 1;
                let oke: bool = jg_i64(entry, STR_PTR("eventIndex"), STR_LEN("eventIndex"), &ev);
                if ev == event_index && (rpg_rs_eq(&kind, STR_PTR("function_call"), STR_LEN("function_call")) || rpg_rs_eq(&kind, STR_PTR("custom_tool_call"), STR_LEN("custom_tool_call"))) { found_pos = i as i64; };
            };
            i = i + 1;
        }
    };
    if found_pos >= 0 {
        let entry: u64 = ja_at(outputs, found_pos as u64);
        if entry != 0 {
            if has_id { let rc: i32 = js_str(entry, STR_PTR("callId"), STR_LEN("callId"), id_p, id_n); };
            rpg_w_save(writer, doc);
            if has_name {
                let resp_name = RpgStr { bytes: [0u8; 8192], len: 0 };
                let has_resp: bool = false;
                let namespace = RpgStr { bytes: [0u8; 8192], len: 0 };
                let has_ns: bool = false;
                let is_custom: bool = false;
                let resolved: bool = rpg_w_resolve_tool(writer, name_p, name_n, has_name, &resp_name, &has_resp, &namespace, &has_ns, &is_custom);
                let doc3: u64 = rpg_w_doc(writer);
                let outputs3: u64 = 0;
                if doc3 != 0 { outputs3 = rpg_w_outputs(writer, doc3); };
                if outputs3 != 0 {
                    let entry3: u64 = ja_at(outputs3, found_pos as u64);
                    if entry3 != 0 {
                        if has_resp { let rc: i32 = js_str(entry3, STR_PTR("name"), STR_LEN("name"), rpg_rs_ptr(&resp_name), resp_name.len); } else { let rc: i32 = js_str(entry3, STR_PTR("name"), STR_LEN("name"), name_p, name_n); };
                        if has_ns { let rc: i32 = js_str(entry3, STR_PTR("namespace"), STR_LEN("namespace"), rpg_rs_ptr(&namespace), namespace.len); } else { let rc: i32 = js_remove(entry3, STR_PTR("namespace"), STR_LEN("namespace")); };
                    };
                };
                rpg_w_save(writer, doc3);
            };
            *out_pos = found_pos;
            return 0;
        };
    };
    rpg_w_save(writer, doc);
    // create a new tool output
    let resp_name = RpgStr { bytes: [0u8; 8192], len: 0 };
    let has_resp: bool = false;
    let namespace = RpgStr { bytes: [0u8; 8192], len: 0 };
    let has_ns: bool = false;
    let is_custom: bool = false;
    let resolved: bool = rpg_w_resolve_tool(writer, name_p, name_n, has_name, &resp_name, &has_resp, &namespace, &has_ns, &is_custom);
    let uuid = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
    rpg_uuid_nodash(&uuid);
    let id = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
    if is_custom { rpg_jb_append_lit(&id, STR_PTR("ctc_"), STR_LEN("ctc_")); } else { rpg_jb_append_lit(&id, STR_PTR("fc_"), STR_LEN("fc_")); };
    rpg_jb_append(&id, rpg_jb_ptr(&uuid), uuid.len);
    let pos: i64 = 0;
    let kind_p: ptr = STR_PTR("function_call");
    let kind_n: u64 = STR_LEN("function_call");
    if is_custom { kind_p = STR_PTR("custom_tool_call"); kind_n = STR_LEN("custom_tool_call"); };
    let arc: i32 = ResponsesStreamWriter_addOutput(writer, kind_p, kind_n, rpg_jb_ptr(&id), id.len, &pos);
    let doc2: u64 = rpg_w_doc(writer);
    let outputs2: u64 = 0;
    if doc2 != 0 { outputs2 = rpg_w_outputs(writer, doc2); };
    let entry: u64 = 0;
    if outputs2 != 0 { entry = ja_at(outputs2, pos as u64); };
    if entry != 0 {
        let rc: i32 = js_i64(entry, STR_PTR("eventIndex"), STR_LEN("eventIndex"), event_index);
        if has_id { rc = js_str(entry, STR_PTR("callId"), STR_LEN("callId"), id_p, id_n); } else {
            let call = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
            let uuid2 = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
            rpg_uuid_nodash(&uuid2);
            rpg_jb_append_lit(&call, STR_PTR("call_"), STR_LEN("call_"));
            rpg_jb_append(&call, rpg_jb_ptr(&uuid2), uuid2.len);
            rc = js_str(entry, STR_PTR("callId"), STR_LEN("callId"), rpg_jb_ptr(&call), call.len);
        };
        if has_resp { rc = js_str(entry, STR_PTR("name"), STR_LEN("name"), rpg_rs_ptr(&resp_name), resp_name.len); } else if has_name { rc = js_str(entry, STR_PTR("name"), STR_LEN("name"), name_p, name_n); } else { rc = js_str(entry, STR_PTR("name"), STR_LEN("name"), STR_PTR("tool"), STR_LEN("tool")); };
        if has_ns { rc = js_str(entry, STR_PTR("namespace"), STR_LEN("namespace"), rpg_rs_ptr(&namespace), namespace.len); };
    };
    let item: u64 = 0;
    if entry != 0 { item = ResponsesStreamWriter_outputItem(writer, entry, STR_PTR("in_progress"), STR_LEN("in_progress")); };
    rpg_w_save(writer, doc2);
    if item != 0 {
        let payload: u64 = rpg_new_obj();
        let rc: i32 = js_i64(payload, STR_PTR("output_index"), STR_LEN("output_index"), pos);
        rc = js_node(payload, STR_PTR("item"), STR_LEN("item"), item);
        ResponsesStreamWriter_emit(writer, STR_PTR("response.output_item.added"), STR_LEN("response.output_item.added"), payload);
        rpg_free_doc(payload);
    };
    *out_pos = pos;
    return 0;
}
fn ResponsesStreamWriter_start(writer: &ResponsesStreamWriter) -> void {
    let empty_items: u64 = rpg_new_arr();
    let resp: u64 = ResponsesStreamWriter_response(writer, STR_PTR("in_progress"), STR_LEN("in_progress"), empty_items);
    let payload: u64 = rpg_new_obj();
    let rc: i32 = js_node(payload, STR_PTR("response"), STR_LEN("response"), resp);
    ResponsesStreamWriter_emit(writer, STR_PTR("response.created"), STR_LEN("response.created"), payload);
    ResponsesStreamWriter_emit(writer, STR_PTR("response.in_progress"), STR_LEN("response.in_progress"), payload);
    rpg_free_doc(payload);
}
// accept one canonical event. Returns 1 when the event is an error event
// (the TS throw site; the caller fails the writer with the event message).
fn ResponsesStreamWriter_accept(writer: &ResponsesStreamWriter, event: &CanonicalStreamEvent) -> i32 {
    let doc: u64 = rpg_jb_doc(&event.json);
    if doc == 0 { return 0; };
    let type_text = RpgStr { bytes: [0u8; 8192], len: 0 };
    let has_type: bool = jg_str(doc, STR_PTR("type"), STR_LEN("type"), &type_text);
    if !has_type { rpg_free_doc(doc); return 0; };
    if rpg_rs_eq(&type_text, STR_PTR("error"), STR_LEN("error")) { rpg_free_doc(doc); return 1; };
    if rpg_rs_eq(&type_text, STR_PTR("metadata"), STR_LEN("metadata")) {
        let state: u64 = rpg_w_doc(writer);
        if state != 0 {
            let model = RpgStr { bytes: [0u8; 8192], len: 0 };
            if jg_str(doc, STR_PTR("model"), STR_LEN("model"), &model) && model.len > 0 { let rc: i32 = js_str(state, STR_PTR("model"), STR_LEN("model"), rpg_rs_ptr(&model), model.len); };
            let value: i64 = 0;
            if jg_i64(doc, STR_PTR("inputTokens"), STR_LEN("inputTokens"), &value) { let rc: i32 = js_i64(state, STR_PTR("inputTokens"), STR_LEN("inputTokens"), value); };
            if jg_i64(doc, STR_PTR("outputTokens"), STR_LEN("outputTokens"), &value) { let rc: i32 = js_i64(state, STR_PTR("outputTokens"), STR_LEN("outputTokens"), value); };
            if jg_i64(doc, STR_PTR("cachedInputTokens"), STR_LEN("cachedInputTokens"), &value) { let rc: i32 = js_i64(state, STR_PTR("cachedInputTokens"), STR_LEN("cachedInputTokens"), value); };
            if jg_i64(doc, STR_PTR("cacheWriteInputTokens"), STR_LEN("cacheWriteInputTokens"), &value) { let rc: i32 = js_i64(state, STR_PTR("cacheWriteInputTokens"), STR_LEN("cacheWriteInputTokens"), value); };
            let finish = RpgStr { bytes: [0u8; 8192], len: 0 };
            if jg_str(doc, STR_PTR("finishReason"), STR_LEN("finishReason"), &finish) && finish.len > 0 { let rc: i32 = js_str(state, STR_PTR("finishReason"), STR_LEN("finishReason"), rpg_rs_ptr(&finish), finish.len); };
        };
        rpg_w_save(writer, state);
        rpg_free_doc(doc);
        return 0;
    };
    if rpg_rs_eq(&type_text, STR_PTR("text_delta"), STR_LEN("text_delta")) || rpg_rs_eq(&type_text, STR_PTR("reasoning_delta"), STR_LEN("reasoning_delta")) {
        let is_text: bool = rpg_rs_eq(&type_text, STR_PTR("text_delta"), STR_LEN("text_delta"));
        let delta = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
        let okd: bool = jg_str_jb(doc, STR_PTR("delta"), STR_LEN("delta"), &delta);
        rpg_free_doc(doc);
        let pos: i64 = 0;
        if is_text { let erc: i32 = ResponsesStreamWriter_ensureMessage(writer, &pos); } else { let erc: i32 = ResponsesStreamWriter_ensureReasoning(writer, &pos); };
        let state: u64 = rpg_w_doc(writer);
        let outputs: u64 = 0;
        if state != 0 { outputs = rpg_w_outputs(writer, state); };
        let entry: u64 = 0;
        if outputs != 0 { entry = ja_at(outputs, pos as u64); };
        let id = RpgStr { bytes: [0u8; 8192], len: 0 };
        if entry != 0 {
            rpg_w_append_text(writer, entry, rpg_jb_ptr(&delta), delta.len);
            let okid: bool = jg_str(entry, STR_PTR("id"), STR_LEN("id"), &id);
        };
        rpg_w_save(writer, state);
        let payload: u64 = rpg_new_obj();
        let rc: i32 = js_str(payload, STR_PTR("item_id"), STR_LEN("item_id"), rpg_rs_ptr(&id), id.len);
        rc = js_i64(payload, STR_PTR("output_index"), STR_LEN("output_index"), pos);
        if is_text {
            rc = js_i64(payload, STR_PTR("content_index"), STR_LEN("content_index"), 0);
            rc = js_str(payload, STR_PTR("delta"), STR_LEN("delta"), rpg_jb_ptr(&delta), delta.len);
            let logprobs: u64 = rpg_new_arr();
            rc = js_node(payload, STR_PTR("logprobs"), STR_LEN("logprobs"), logprobs);
            ResponsesStreamWriter_emit(writer, STR_PTR("response.output_text.delta"), STR_LEN("response.output_text.delta"), payload);
        } else {
            rc = js_i64(payload, STR_PTR("summary_index"), STR_LEN("summary_index"), 0);
            rc = js_str(payload, STR_PTR("delta"), STR_LEN("delta"), rpg_jb_ptr(&delta), delta.len);
            ResponsesStreamWriter_emit(writer, STR_PTR("response.reasoning_summary_text.delta"), STR_LEN("response.reasoning_summary_text.delta"), payload);
        };
        rpg_free_doc(payload);
        return 0;
    };
    // tool_start / tool_arguments_delta
    let index: i64 = 0;
    let oki: bool = jg_i64(doc, STR_PTR("index"), STR_LEN("index"), &index);
    let id = RpgStr { bytes: [0u8; 8192], len: 0 };
    let has_id: bool = jg_str(doc, STR_PTR("id"), STR_LEN("id"), &id) && id.len > 0;
    let name = RpgStr { bytes: [0u8; 8192], len: 0 };
    let has_name: bool = jg_str(doc, STR_PTR("name"), STR_LEN("name"), &name) && name.len > 0;
    let is_start: bool = rpg_rs_eq(&type_text, STR_PTR("tool_start"), STR_LEN("tool_start"));
    let delta = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
    let okd: bool = jg_str_jb(doc, STR_PTR("delta"), STR_LEN("delta"), &delta);
    rpg_free_doc(doc);
    let pos: i64 = 0;
    let erc: i32 = ResponsesStreamWriter_ensureTool(writer, index, rpg_rs_ptr(&id), id.len, has_id, rpg_rs_ptr(&name), name.len, has_name, &pos);
    if is_start { return 0; };
    let state: u64 = rpg_w_doc(writer);
    let outputs: u64 = 0;
    if state != 0 { outputs = rpg_w_outputs(writer, state); };
    let entry: u64 = 0;
    if outputs != 0 { entry = ja_at(outputs, pos as u64); };
    let entry_id = RpgStr { bytes: [0u8; 8192], len: 0 };
    let kind = RpgStr { bytes: [0u8; 8192], len: 0 };
    if entry != 0 {
        rpg_w_append_text(writer, entry, rpg_jb_ptr(&delta), delta.len);
        let ok1: bool = jg_str(entry, STR_PTR("id"), STR_LEN("id"), &entry_id);
        let ok2: bool = jg_str(entry, STR_PTR("kind"), STR_LEN("kind"), &kind);
    };
    rpg_w_save(writer, state);
    if rpg_rs_eq(&kind, STR_PTR("custom_tool_call"), STR_LEN("custom_tool_call")) { return 0; };
    let payload: u64 = rpg_new_obj();
    let rc: i32 = js_str(payload, STR_PTR("item_id"), STR_LEN("item_id"), rpg_rs_ptr(&entry_id), entry_id.len);
    rc = js_i64(payload, STR_PTR("output_index"), STR_LEN("output_index"), pos);
    rc = js_str(payload, STR_PTR("delta"), STR_LEN("delta"), rpg_jb_ptr(&delta), delta.len);
    ResponsesStreamWriter_emit(writer, STR_PTR("response.function_call_arguments.delta"), STR_LEN("response.function_call_arguments.delta"), payload);
    rpg_free_doc(payload);
    return 0;
}
fn ResponsesStreamWriter_fail(writer: &ResponsesStreamWriter, message_p: ptr, message_n: u64) -> void {
    let doc: u64 = rpg_w_doc(writer);
    let closed: bool = false;
    if doc != 0 { let ok: bool = jg_bool(doc, STR_PTR("closed"), STR_LEN("closed"), &closed); };
    if closed { rpg_w_save(writer, doc); return; };
    let outputs: u64 = 0;
    if doc != 0 { outputs = rpg_w_outputs(writer, doc); };
    let items: u64 = rpg_new_arr();
    if outputs != 0 {
        let count: u64 = jn_count(outputs);
        let i: u64 = 0;
        while i < count {
            let entry: u64 = ja_at(outputs, i);
            if entry != 0 {
                let item: u64 = ResponsesStreamWriter_outputItem(writer, entry, STR_PTR("in_progress"), STR_LEN("in_progress"));
                let rc: i32 = ja_push_node(items, item);
            };
            i = i + 1;
        }
    };
    rpg_w_save(writer, doc);
    let resp: u64 = ResponsesStreamWriter_response(writer, STR_PTR("failed"), STR_LEN("failed"), items);
    let error: u64 = rpg_new_obj();
    let rc: i32 = js_str(error, STR_PTR("code"), STR_LEN("code"), STR_PTR("upstream_stream_error"), STR_LEN("upstream_stream_error"));
    rc = js_str(error, STR_PTR("message"), STR_LEN("message"), message_p, message_n);
    rc = js_node(resp, STR_PTR("error"), STR_LEN("error"), error);
    let payload: u64 = rpg_new_obj();
    rc = js_node(payload, STR_PTR("response"), STR_LEN("response"), resp);
    ResponsesStreamWriter_emit(writer, STR_PTR("response.failed"), STR_LEN("response.failed"), payload);
    rpg_free_doc(payload);
    ResponsesStreamWriter_enqueue(writer, STR_PTR("data: [DONE]\n\n"), STR_LEN("data: [DONE]\n\n"));
    let doc2: u64 = rpg_w_doc(writer);
    if doc2 != 0 { let rc2: i32 = js_bool(doc2, STR_PTR("closed"), STR_LEN("closed"), true); };
    rpg_w_save(writer, doc2);
}
fn ResponsesStreamWriter_complete(writer: &ResponsesStreamWriter) -> void {
    let doc: u64 = rpg_w_doc(writer);
    let closed: bool = false;
    if doc != 0 { let ok: bool = jg_bool(doc, STR_PTR("closed"), STR_LEN("closed"), &closed); };
    if closed { rpg_w_save(writer, doc); return; };
    let outputs: u64 = 0;
    if doc != 0 { outputs = rpg_w_outputs(writer, doc); };
    // incomplete function-call pre-check
    if outputs != 0 {
        let count: u64 = jn_count(outputs);
        let i: u64 = 0;
        while i < count {
            let entry: u64 = ja_at(outputs, i);
            if entry != 0 {
                let kind = RpgStr { bytes: [0u8; 8192], len: 0 };
                let okk: bool = jg_str(entry, STR_PTR("kind"), STR_LEN("kind"), &kind);
                if rpg_rs_eq(&kind, STR_PTR("function_call"), STR_LEN("function_call")) {
                    let text = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
                    let okt: bool = jg_str_jb(entry, STR_PTR("text"), STR_LEN("text"), &text);
                    let normalized = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
                    normalizedFunctionArguments(rpg_jb_ptr(&text), text.len, &normalized);
                    if !isCompleteFunctionArguments(rpg_jb_ptr(&normalized), normalized.len) {
                        let call = RpgStr { bytes: [0u8; 8192], len: 0 };
                        let has_call: bool = jg_str(entry, STR_PTR("callId"), STR_LEN("callId"), &call) && call.len > 0;
                        if !has_call { has_call = jg_str(entry, STR_PTR("id"), STR_LEN("id"), &call); };
                        let message = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
                        incompleteFunctionArgumentsMessage(rpg_jb_ptr(&text), text.len, rpg_rs_ptr(&call), call.len, &message);
                        rpg_w_save(writer, doc);
                        ResponsesStreamWriter_fail(writer, rpg_jb_ptr(&message), message.len);
                        return;
                    };
                };
            };
            i = i + 1;
        }
    };
    rpg_w_save(writer, doc);
    // per-output done events
    let doc2: u64 = rpg_w_doc(writer);
    let outputs2: u64 = 0;
    if doc2 != 0 { outputs2 = rpg_w_outputs(writer, doc2); };
    let count2: u64 = 0;
    if outputs2 != 0 { count2 = jn_count(outputs2); };
    rpg_w_save(writer, doc2);
    let i2: u64 = 0;
    while i2 < count2 {
        let state: u64 = rpg_w_doc(writer);
        let outs: u64 = 0;
        if state != 0 { outs = rpg_w_outputs(writer, state); };
        let entry: u64 = 0;
        if outs != 0 { entry = ja_at(outs, i2); };
        let kind = RpgStr { bytes: [0u8; 8192], len: 0 };
        let id = RpgStr { bytes: [0u8; 8192], len: 0 };
        let text = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
        if entry != 0 {
            let ok1: bool = jg_str(entry, STR_PTR("kind"), STR_LEN("kind"), &kind);
            let ok2: bool = jg_str(entry, STR_PTR("id"), STR_LEN("id"), &id);
            let ok3: bool = jg_str_jb(entry, STR_PTR("text"), STR_LEN("text"), &text);
        };
        let is_custom: bool = rpg_rs_eq(&kind, STR_PTR("custom_tool_call"), STR_LEN("custom_tool_call"));
        let is_tool: bool = is_custom || rpg_rs_eq(&kind, STR_PTR("function_call"), STR_LEN("function_call"));
        if is_tool {
            // normalize the buffered text back into the entry first
            let final_text = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
            if is_custom { unwrapCustomToolInput(rpg_jb_ptr(&text), text.len, &final_text); } else { normalizedFunctionArguments(rpg_jb_ptr(&text), text.len, &final_text); };
            if entry != 0 { let rc: i32 = js_str(entry, STR_PTR("text"), STR_LEN("text"), rpg_jb_ptr(&final_text), final_text.len); };
            rpg_jb_assign_jb(&text, &final_text);
        };
        let item: u64 = 0;
        if entry != 0 { item = ResponsesStreamWriter_outputItem(writer, entry, STR_PTR("completed"), STR_LEN("completed")); };
        rpg_w_save(writer, state);
        if rpg_rs_eq(&kind, STR_PTR("message"), STR_LEN("message")) {
            let payload: u64 = rpg_new_obj();
            let rc: i32 = js_str(payload, STR_PTR("item_id"), STR_LEN("item_id"), rpg_rs_ptr(&id), id.len);
            rc = js_i64(payload, STR_PTR("output_index"), STR_LEN("output_index"), i2 as i64);
            rc = js_i64(payload, STR_PTR("content_index"), STR_LEN("content_index"), 0);
            rc = js_str(payload, STR_PTR("text"), STR_LEN("text"), rpg_jb_ptr(&text), text.len);
            let logprobs: u64 = rpg_new_arr();
            rc = js_node(payload, STR_PTR("logprobs"), STR_LEN("logprobs"), logprobs);
            ResponsesStreamWriter_emit(writer, STR_PTR("response.output_text.done"), STR_LEN("response.output_text.done"), payload);
            rpg_free_doc(payload);
            let payload2: u64 = rpg_new_obj();
            rc = js_str(payload2, STR_PTR("item_id"), STR_LEN("item_id"), rpg_rs_ptr(&id), id.len);
            rc = js_i64(payload2, STR_PTR("output_index"), STR_LEN("output_index"), i2 as i64);
            rc = js_i64(payload2, STR_PTR("content_index"), STR_LEN("content_index"), 0);
            let part: u64 = rpg_new_obj();
            rc = js_str(part, STR_PTR("type"), STR_LEN("type"), STR_PTR("output_text"), STR_LEN("output_text"));
            rc = js_str(part, STR_PTR("text"), STR_LEN("text"), rpg_jb_ptr(&text), text.len);
            let annotations: u64 = rpg_new_arr();
            rc = js_node(part, STR_PTR("annotations"), STR_LEN("annotations"), annotations);
            rc = js_node(payload2, STR_PTR("part"), STR_LEN("part"), part);
            ResponsesStreamWriter_emit(writer, STR_PTR("response.content_part.done"), STR_LEN("response.content_part.done"), payload2);
            rpg_free_doc(payload2);
        } else if rpg_rs_eq(&kind, STR_PTR("reasoning"), STR_LEN("reasoning")) {
            let payload: u64 = rpg_new_obj();
            let rc: i32 = js_str(payload, STR_PTR("item_id"), STR_LEN("item_id"), rpg_rs_ptr(&id), id.len);
            rc = js_i64(payload, STR_PTR("output_index"), STR_LEN("output_index"), i2 as i64);
            rc = js_i64(payload, STR_PTR("summary_index"), STR_LEN("summary_index"), 0);
            rc = js_str(payload, STR_PTR("text"), STR_LEN("text"), rpg_jb_ptr(&text), text.len);
            ResponsesStreamWriter_emit(writer, STR_PTR("response.reasoning_summary_text.done"), STR_LEN("response.reasoning_summary_text.done"), payload);
            rpg_free_doc(payload);
            let payload2: u64 = rpg_new_obj();
            rc = js_str(payload2, STR_PTR("item_id"), STR_LEN("item_id"), rpg_rs_ptr(&id), id.len);
            rc = js_i64(payload2, STR_PTR("output_index"), STR_LEN("output_index"), i2 as i64);
            rc = js_i64(payload2, STR_PTR("summary_index"), STR_LEN("summary_index"), 0);
            let part: u64 = rpg_new_obj();
            rc = js_str(part, STR_PTR("type"), STR_LEN("type"), STR_PTR("summary_text"), STR_LEN("summary_text"));
            rc = js_str(part, STR_PTR("text"), STR_LEN("text"), rpg_jb_ptr(&text), text.len);
            rc = js_node(payload2, STR_PTR("part"), STR_LEN("part"), part);
            ResponsesStreamWriter_emit(writer, STR_PTR("response.reasoning_summary_part.done"), STR_LEN("response.reasoning_summary_part.done"), payload2);
            rpg_free_doc(payload2);
        } else if is_tool {
            if is_custom && text.len > 0 {
                let payload: u64 = rpg_new_obj();
                let rc: i32 = js_str(payload, STR_PTR("item_id"), STR_LEN("item_id"), rpg_rs_ptr(&id), id.len);
                rc = js_i64(payload, STR_PTR("output_index"), STR_LEN("output_index"), i2 as i64);
                rc = js_str(payload, STR_PTR("delta"), STR_LEN("delta"), rpg_jb_ptr(&text), text.len);
                ResponsesStreamWriter_emit(writer, STR_PTR("response.custom_tool_call_input.delta"), STR_LEN("response.custom_tool_call_input.delta"), payload);
                rpg_free_doc(payload);
            };
            let payload3: u64 = rpg_new_obj();
            let rc: i32 = js_str(payload3, STR_PTR("item_id"), STR_LEN("item_id"), rpg_rs_ptr(&id), id.len);
            rc = js_i64(payload3, STR_PTR("output_index"), STR_LEN("output_index"), i2 as i64);
            if is_custom { rc = js_str(payload3, STR_PTR("input"), STR_LEN("input"), rpg_jb_ptr(&text), text.len); } else { rc = js_str(payload3, STR_PTR("arguments"), STR_LEN("arguments"), rpg_jb_ptr(&text), text.len); };
            if is_custom { ResponsesStreamWriter_emit(writer, STR_PTR("response.custom_tool_call_input.done"), STR_LEN("response.custom_tool_call_input.done"), payload3); } else { ResponsesStreamWriter_emit(writer, STR_PTR("response.function_call_arguments.done"), STR_LEN("response.function_call_arguments.done"), payload3); };
            rpg_free_doc(payload3);
        };
        if item != 0 {
            let payload4: u64 = rpg_new_obj();
            let rc: i32 = js_i64(payload4, STR_PTR("output_index"), STR_LEN("output_index"), i2 as i64);
            rc = js_node(payload4, STR_PTR("item"), STR_LEN("item"), item);
            ResponsesStreamWriter_emit(writer, STR_PTR("response.output_item.done"), STR_LEN("response.output_item.done"), payload4);
            rpg_free_doc(payload4);
        };
        i2 = i2 + 1;
    }
    // terminal response
    let doc3: u64 = rpg_w_doc(writer);
    let finish = RpgStr { bytes: [0u8; 8192], len: 0 };
    let has_finish: bool = false;
    if doc3 != 0 { has_finish = jg_str(doc3, STR_PTR("finishReason"), STR_LEN("finishReason"), &finish) && finish.len > 0; };
    let outputs3: u64 = 0;
    if doc3 != 0 { outputs3 = rpg_w_outputs(writer, doc3); };
    let items: u64 = rpg_new_arr();
    if outputs3 != 0 {
        let count3: u64 = jn_count(outputs3);
        let i3: u64 = 0;
        while i3 < count3 {
            let entry: u64 = ja_at(outputs3, i3);
            if entry != 0 {
                let item: u64 = ResponsesStreamWriter_outputItem(writer, entry, STR_PTR("completed"), STR_LEN("completed"));
                let rc: i32 = ja_push_node(items, item);
            };
            i3 = i3 + 1;
        }
    };
    rpg_w_save(writer, doc3);
    let reason = RpgStr { bytes: [0u8; 8192], len: 0 };
    let has_reason: bool = responsesIncompleteReason(rpg_rs_ptr(&finish), finish.len, has_finish, &reason);
    let status_p: ptr = STR_PTR("completed");
    let status_n: u64 = STR_LEN("completed");
    if has_reason { status_p = STR_PTR("incomplete"); status_n = STR_LEN("incomplete"); };
    let resp: u64 = ResponsesStreamWriter_response(writer, status_p, status_n, items);
    if has_reason {
        let details: u64 = rpg_new_obj();
        let rc: i32 = js_str(details, STR_PTR("reason"), STR_LEN("reason"), rpg_rs_ptr(&reason), reason.len);
        rc = js_node(resp, STR_PTR("incomplete_details"), STR_LEN("incomplete_details"), details);
    };
    let payload: u64 = rpg_new_obj();
    let rc: i32 = js_node(payload, STR_PTR("response"), STR_LEN("response"), resp);
    if has_reason { ResponsesStreamWriter_emit(writer, STR_PTR("response.incomplete"), STR_LEN("response.incomplete"), payload); } else { ResponsesStreamWriter_emit(writer, STR_PTR("response.completed"), STR_LEN("response.completed"), payload); };
    rpg_free_doc(payload);
    ResponsesStreamWriter_enqueue(writer, STR_PTR("data: [DONE]\n\n"), STR_LEN("data: [DONE]\n\n"));
    let doc4: u64 = rpg_w_doc(writer);
    if doc4 != 0 { let rc2: i32 = js_bool(doc4, STR_PTR("closed"), STR_LEN("closed"), true); };
    rpg_w_save(writer, doc4);
}
// responsesEventStream (TS 4676): materialize a completed canonical
// Responses body as an SSE event stream.
fn responsesEventStream(result_body: &rpg_JsonBuf, tools: &rpg_JsonBuf, out: &rpg_JsonBuf) -> i32 {
    let body = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
    let doc: u64 = rpg_jb_doc(result_body);
    let status_text = RpgStr { bytes: [0u8; 8192], len: 0 };
    let is_incomplete: bool = false;
    if doc != 0 && jg_str(doc, STR_PTR("status"), STR_LEN("status"), &status_text) { is_incomplete = rpg_rs_eq(&status_text, STR_PTR("incomplete"), STR_LEN("incomplete")); };
    // pending = {...response, status: "in_progress", output: []}
    let pending: u64 = rpg_new_obj();
    if doc != 0 && jn_kind(doc) == JK_OBJECT {
        let count: u64 = jn_count(doc);
        let i: u64 = 0;
        while i < count {
            let kp: ptr = PTR_NULL();
            let kn: u64 = 0;
            if jg_key_at(doc, i, &kp, &kn) {
                if rpg_bytes_eq(kp, kn, STR_PTR("status"), STR_LEN("status")) {
                    let rc: i32 = js_str(pending, kp, kn, STR_PTR("in_progress"), STR_LEN("in_progress"));
                } else if rpg_bytes_eq(kp, kn, STR_PTR("output"), STR_LEN("output")) {
                    let empty_arr: u64 = rpg_new_arr();
                    let rc: i32 = js_node(pending, kp, kn, empty_arr);
                } else {
                    let node: u64 = jg_node(doc, kp, kn);
                    if node != 0 { let rc: i32 = js_node(pending, kp, kn, rpg_clone_node(node)); };
                };
            };
            i = i + 1;
        }
    };
    let sequence: i64 = 0;
    let created_event: u64 = rpg_new_obj();
    let rc: i32 = js_str(created_event, STR_PTR("type"), STR_LEN("type"), STR_PTR("response.created"), STR_LEN("response.created"));
    rc = js_i64(created_event, STR_PTR("sequence_number"), STR_LEN("sequence_number"), sequence);
    sequence = sequence + 1;
    rc = js_node(created_event, STR_PTR("response"), STR_LEN("response"), rpg_clone_node(pending));
    let created_text = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
    let st: i32 = rpg_doc_to_jb(created_event, &created_text);
    rpg_free_doc(created_event);
    rpg_sse_enqueue(&body, STR_PTR("response.created"), STR_LEN("response.created"), true, rpg_jb_ptr(&created_text), created_text.len);
    let progress_event: u64 = rpg_new_obj();
    rc = js_str(progress_event, STR_PTR("type"), STR_LEN("type"), STR_PTR("response.in_progress"), STR_LEN("response.in_progress"));
    rc = js_i64(progress_event, STR_PTR("sequence_number"), STR_LEN("sequence_number"), sequence);
    sequence = sequence + 1;
    rc = js_node(progress_event, STR_PTR("response"), STR_LEN("response"), pending);
    let progress_text = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
    st = rpg_doc_to_jb(progress_event, &progress_text);
    rpg_free_doc(progress_event);
    rpg_sse_enqueue(&body, STR_PTR("response.in_progress"), STR_LEN("response.in_progress"), true, rpg_jb_ptr(&progress_text), progress_text.len);
    // per-item events
    let output: u64 = 0;
    if doc != 0 { output = jg_node(doc, STR_PTR("output"), STR_LEN("output")); };
    if output != 0 && jn_kind(output) == JK_ARRAY {
        let count: u64 = jn_count(output);
        let oi: u64 = 0;
        while oi < count {
            let item: u64 = ja_at(output, oi);
            if item != 0 && jn_kind(item) == JK_OBJECT {
                let item_id = RpgStr { bytes: [0u8; 8192], len: 0 };
                let has_item_id: bool = jg_str(item, STR_PTR("id"), STR_LEN("id"), &item_id) && item_id.len > 0;
                if !has_item_id {
                    let prefix = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
                    rpg_jb_append_lit(&prefix, STR_PTR("item_"), STR_LEN("item_"));
                    let num = RpgStr { bytes: [0u8; 8192], len: 0 };
                    rpg_i64_to_rs(oi as i64, &num);
                    rpg_jb_append(&prefix, rpg_rs_ptr(&num), num.len);
                    rpg_rs_assign(&item_id, rpg_jb_ptr(&prefix), prefix.len);
                };
                let item_type = RpgStr { bytes: [0u8; 8192], len: 0 };
                let has_item_type: bool = jg_str(item, STR_PTR("type"), STR_LEN("type"), &item_type);
                // output_item.added with status in_progress
                let added_item: u64 = rpg_clone_node(item);
                let arc: i32 = js_str(added_item, STR_PTR("status"), STR_LEN("status"), STR_PTR("in_progress"), STR_LEN("in_progress"));
                let added: u64 = rpg_new_obj();
                rc = js_str(added, STR_PTR("type"), STR_LEN("type"), STR_PTR("response.output_item.added"), STR_LEN("response.output_item.added"));
                rc = js_i64(added, STR_PTR("sequence_number"), STR_LEN("sequence_number"), sequence);
                sequence = sequence + 1;
                rc = js_i64(added, STR_PTR("output_index"), STR_LEN("output_index"), oi as i64);
                rc = js_node(added, STR_PTR("item"), STR_LEN("item"), added_item);
                let added_text = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
                st = rpg_doc_to_jb(added, &added_text);
                rpg_free_doc(added);
                rpg_sse_enqueue(&body, STR_PTR("response.output_item.added"), STR_LEN("response.output_item.added"), true, rpg_jb_ptr(&added_text), added_text.len);
                if has_item_type && rpg_rs_eq(&item_type, STR_PTR("message"), STR_LEN("message")) {
                    let content: u64 = jg_node(item, STR_PTR("content"), STR_LEN("content"));
                    let text = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
                    if content != 0 && jn_kind(content) == JK_ARRAY {
                        let cc: u64 = jn_count(content);
                        let ci: u64 = 0;
                        while ci < cc {
                            let part_node: u64 = ja_at(content, ci);
                            if part_node != 0 {
                                let part_text = RpgStr { bytes: [0u8; 8192], len: 0 };
                                if jg_str(part_node, STR_PTR("text"), STR_LEN("text"), &part_text) { rpg_jb_append(&text, rpg_rs_ptr(&part_text), part_text.len); };
                            };
                            ci = ci + 1;
                        }
                    };
                    let part: u64 = rpg_new_obj();
                    rc = js_str(part, STR_PTR("type"), STR_LEN("type"), STR_PTR("output_text"), STR_LEN("output_text"));
                    rc = js_str(part, STR_PTR("text"), STR_LEN("text"), STR_PTR(""), STR_LEN(""));
                    let annotations: u64 = rpg_new_arr();
                    rc = js_node(part, STR_PTR("annotations"), STR_LEN("annotations"), annotations);
                    let added_ev: u64 = rpg_new_obj();
                    rc = js_str(added_ev, STR_PTR("type"), STR_LEN("type"), STR_PTR("response.content_part.added"), STR_LEN("response.content_part.added"));
                    rc = js_i64(added_ev, STR_PTR("sequence_number"), STR_LEN("sequence_number"), sequence);
                    sequence = sequence + 1;
                    rc = js_str(added_ev, STR_PTR("item_id"), STR_LEN("item_id"), rpg_rs_ptr(&item_id), item_id.len);
                    rc = js_i64(added_ev, STR_PTR("output_index"), STR_LEN("output_index"), oi as i64);
                    rc = js_i64(added_ev, STR_PTR("content_index"), STR_LEN("content_index"), 0);
                    rc = js_node(added_ev, STR_PTR("part"), STR_LEN("part"), rpg_clone_node(part));
                    let added_text2 = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
                    st = rpg_doc_to_jb(added_ev, &added_text2);
                    rpg_free_doc(added_ev);
                    rpg_sse_enqueue(&body, STR_PTR("response.content_part.added"), STR_LEN("response.content_part.added"), true, rpg_jb_ptr(&added_text2), added_text2.len);
                    if text.len > 0 {
                        let delta_ev: u64 = rpg_new_obj();
                        rc = js_str(delta_ev, STR_PTR("type"), STR_LEN("type"), STR_PTR("response.output_text.delta"), STR_LEN("response.output_text.delta"));
                        rc = js_i64(delta_ev, STR_PTR("sequence_number"), STR_LEN("sequence_number"), sequence);
                        sequence = sequence + 1;
                        rc = js_str(delta_ev, STR_PTR("item_id"), STR_LEN("item_id"), rpg_rs_ptr(&item_id), item_id.len);
                        rc = js_i64(delta_ev, STR_PTR("output_index"), STR_LEN("output_index"), oi as i64);
                        rc = js_i64(delta_ev, STR_PTR("content_index"), STR_LEN("content_index"), 0);
                        rc = js_str(delta_ev, STR_PTR("delta"), STR_LEN("delta"), rpg_jb_ptr(&text), text.len);
                        let logprobs: u64 = rpg_new_arr();
                        rc = js_node(delta_ev, STR_PTR("logprobs"), STR_LEN("logprobs"), logprobs);
                        let delta_text = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
                        st = rpg_doc_to_jb(delta_ev, &delta_text);
                        rpg_free_doc(delta_ev);
                        rpg_sse_enqueue(&body, STR_PTR("response.output_text.delta"), STR_LEN("response.output_text.delta"), true, rpg_jb_ptr(&delta_text), delta_text.len);
                    };
                    let done_ev: u64 = rpg_new_obj();
                    rc = js_str(done_ev, STR_PTR("type"), STR_LEN("type"), STR_PTR("response.output_text.done"), STR_LEN("response.output_text.done"));
                    rc = js_i64(done_ev, STR_PTR("sequence_number"), STR_LEN("sequence_number"), sequence);
                    sequence = sequence + 1;
                    rc = js_str(done_ev, STR_PTR("item_id"), STR_LEN("item_id"), rpg_rs_ptr(&item_id), item_id.len);
                    rc = js_i64(done_ev, STR_PTR("output_index"), STR_LEN("output_index"), oi as i64);
                    rc = js_i64(done_ev, STR_PTR("content_index"), STR_LEN("content_index"), 0);
                    rc = js_str(done_ev, STR_PTR("text"), STR_LEN("text"), rpg_jb_ptr(&text), text.len);
                    let logprobs2: u64 = rpg_new_arr();
                    rc = js_node(done_ev, STR_PTR("logprobs"), STR_LEN("logprobs"), logprobs2);
                    let done_text = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
                    st = rpg_doc_to_jb(done_ev, &done_text);
                    rpg_free_doc(done_ev);
                    rpg_sse_enqueue(&body, STR_PTR("response.output_text.done"), STR_LEN("response.output_text.done"), true, rpg_jb_ptr(&done_text), done_text.len);
                    let part_done: u64 = rpg_new_obj();
                    rc = js_str(part_done, STR_PTR("type"), STR_LEN("type"), STR_PTR("response.content_part.done"), STR_LEN("response.content_part.done"));
                    rc = js_i64(part_done, STR_PTR("sequence_number"), STR_LEN("sequence_number"), sequence);
                    sequence = sequence + 1;
                    rc = js_str(part_done, STR_PTR("item_id"), STR_LEN("item_id"), rpg_rs_ptr(&item_id), item_id.len);
                    rc = js_i64(part_done, STR_PTR("output_index"), STR_LEN("output_index"), oi as i64);
                    rc = js_i64(part_done, STR_PTR("content_index"), STR_LEN("content_index"), 0);
                    let part2: u64 = rpg_clone_node(part);
                    rc = js_str(part2, STR_PTR("text"), STR_LEN("text"), rpg_jb_ptr(&text), text.len);
                    rc = js_node(part_done, STR_PTR("part"), STR_LEN("part"), part2);
                    rpg_free_doc(part);
                    let part_done_text = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
                    st = rpg_doc_to_jb(part_done, &part_done_text);
                    rpg_free_doc(part_done);
                    rpg_sse_enqueue(&body, STR_PTR("response.content_part.done"), STR_LEN("response.content_part.done"), true, rpg_jb_ptr(&part_done_text), part_done_text.len);
