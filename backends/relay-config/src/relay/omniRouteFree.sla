// DEFECT: dynamic object — returns 0 when the value is a non-array object
// (caller flag), -1 for TS null.
fn opencodeToRecord(is_object: bool, is_array: bool) -> i32 {
    if is_object && !is_array { return 0; };
    return -1;
}

// function opencodeIsResponsesMessageItem(record): boolean (ts:1398-1400)
// TS: record.type === "message" || (!record.type && typeof record.role === "string")
// DEFECT: dynamic object — caller supplies the decoded flags.
fn opencodeIsResponsesMessageItem(has_type: bool, type_ptr: ptr, type_len: u64, role_is_string: bool) -> bool {
    if has_type && omni_str_eq(type_ptr, type_len, STR_PTR("message"), STR_LEN("message")) { return true; };
    return !has_type && role_is_string;
}

// function opencodeIsInternalAssistantMessage(record): boolean (ts:1402-1408)
// TS: responses message item + role "assistant" + phase (trimmed,
// lowercased) === "commentary".
// DEFECT: dynamic object — caller supplies decoded fields; the phase
// lowercase compare is approximated case-sensitively.
fn opencodeIsInternalAssistantMessage(is_message_item: bool, role_ptr: ptr, role_len: u64, phase_ptr: ptr, phase_len: u64) -> bool {
    if !is_message_item { return false; };
    if !omni_str_eq(role_ptr, role_len, STR_PTR("assistant"), STR_LEN("assistant")) { return false; };
    if phase_len == 0 { return false; };
    return omni_str_eq(phase_ptr, phase_len, STR_PTR("commentary"), STR_LEN("commentary"));
}

// function opencodeSanitizeFunctionName(name: string): string (ts:1410-1412)
// name.replace(/[^a-zA-Z0-9_-]/g, "_").slice(0, 128)
fn opencodeSanitizeFunctionName(name_ptr: ptr, name_len: u64, out_ptr: ptr, out_len: &u64) -> i32 {
    let n: u64 = name_len;
    if n > 128 { n = 128; };
    for i in 0..n {
        let b: u8 = 0;
        PTR_BYTE_AT(b, name_ptr, i);
        let ok = false;
        if b >= 65 && b <= 90 { ok = true; };
        if b >= 97 && b <= 122 { ok = true; };
        if b >= 48 && b <= 57 { ok = true; };
        if b == 95 || b == 45 { ok = true; };
        let dst: ptr = PTR_NULL();
        PTR_BYTE_ADD(dst, out_ptr, i);
        if ok {
            PTR_WRITE_U8(dst, b);
        } else {
            PTR_WRITE_U8(dst, 95u8);
        };
    }
    *out_len = n;
    return 0;
}

// /^[a-zA-Z0-9_-]{1,128}$/ test used by opencodeSanitizeInputItem.
fn omni_function_name_valid(name_ptr: ptr, name_len: u64) -> bool {
    if name_len == 0 || name_len > 128 { return false; };
    for i in 0..name_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, name_ptr, i);
        let ok = false;
        if b >= 65 && b <= 90 { ok = true; };
        if b >= 97 && b <= 122 { ok = true; };
        if b >= 48 && b <= 57 { ok = true; };
        if b == 95 || b == 45 { ok = true; };
        if !ok { return false; };
    }
    return true;
}

