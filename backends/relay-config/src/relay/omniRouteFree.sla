fn resolveKernelDefaultMaxTokens() -> u64 {
    return 128000;
}

// export function isKernelSendEnabled(): boolean (ts:679-681)
// TS: !/^(0|false|no|off)$/i.test((process.env.OPENCODE_KERNEL_SEND ?? "").trim())
// DEFECT: Node API + regex — env unavailable, so the flag reads as unset
// and this returns true (the unset default).
fn isKernelSendEnabled() -> bool {
    return true;
}

// export function kernelBaseUrl(): string (ts:683-686)
// TS: env OPENCODE_KERNEL_BASE_URL trimmed, one trailing "/" stripped,
// empty -> OPENCODE_KERNEL_BASE_URL.
// DEFECT: Node API — env override unavailable; always the default.
fn kernelBaseUrl(out_ptr: ptr, out_len: &u64) -> i32 {
    let d = "https://opencode.ai/inference/v1";
    for i in 0..STR_LEN(d) {
        let b: u8 = 0;
        let src: ptr = PTR_NULL();
        PTR_BYTE_ADD(src, STR_PTR(d), i);
        PTR_BYTE_AT(b, src, 0);
        let dst: ptr = PTR_NULL();
        PTR_BYTE_ADD(dst, out_ptr, i);
        PTR_WRITE_U8(dst, b);
    }
    *out_len = STR_LEN(d);
    return 0;
}

// export function kernelUserAgent(surface: OpencodeKernelSurface): string (ts:688-692)
// TS: env OPENCODE_KERNEL_USER_AGENT override wins; else the per-surface
// constant.
