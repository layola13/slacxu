fn omni_headers_get(headers: &HeaderMap, name_ptr: ptr, name_len: u64, out_ptr: ptr, out_len: &u64) -> bool {
    *out_len = 0;
    return false;
}

fn omni_headers_set(headers: &HeaderMap, name_ptr: ptr, name_len: u64, value_ptr: ptr, value_len: u64) -> i32 {
    return 0;
}

fn omni_headers_delete(headers: &HeaderMap, name_ptr: ptr, name_len: u64) -> i32 {
    return 0;
}

