    // (none of the explicit ids carry the prefix, so they pass through).
    let fallback = "big-pickle\nbeam-free\nmimo-v2.6-flash-free\nnemotron-3.5-super-vl-free\nnemotron-3.5-lightning-free\nlongcat-2.5-preview-free\ndeepseek-v4.1-flash-free\nglm-5.3-flash-free\nminimax-m3.1-flash-free";
    let base: ptr = PTR_NULL();
    PTR_BYTE_ADD(base, &out.models.bytes, 0);
