// export async function fetchOmniRouteFreeModels(options: OmniRouteFreeFetchOptions = {}): Promise<{ models, fetchedModels }> (ts:3279-3331)
// TS flow: timeoutMs = max(1000, options.timeoutMs ?? 10000);
