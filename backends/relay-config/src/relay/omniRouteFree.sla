// Copy the preserved fields from an existing group over a freshly built
// one (TS spread: name fallback, modelMapping, and for cline/freebuff/
// d2api also keys), exactly as each merge block does in the source.
fn omni_apply_existing_group(dst: &ChannelGroupConfig, src: &ChannelGroupConfig, default_name: ptr, keep_keys: bool) -> i32 {
    // name: existing.name || "<default>"
    if src.name_len > 0 {
        let f: ptr = PTR_NULL();
        PTR_BYTE_ADD(f, &dst.name_bytes, 0);
        let s: ptr = PTR_NULL();
        PTR_BYTE_ADD(s, &src.name_bytes, 0);
        dst.name_len = omni_fill_field(f, s, src.name_len);
    } else {
        let f: ptr = PTR_NULL();
        PTR_BYTE_ADD(f, &dst.name_bytes, 0);
        dst.name_len = omni_fill_field(f, default_name, STR_LEN(default_name));
    };
    dst.has_modelMapping = src.has_modelMapping;
    dst.modelMapping_json.len = src.modelMapping_json.len;
    let mf: ptr = PTR_NULL();
    PTR_BYTE_ADD(mf, &dst.modelMapping_json.bytes, 0);
    let ms: ptr = PTR_NULL();
    PTR_BYTE_ADD(ms, &src.modelMapping_json.bytes, 0);
    for i in 0..src.modelMapping_json.len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, ms, i);
        let d: ptr = PTR_NULL();
        PTR_BYTE_ADD(d, mf, i);
        PTR_WRITE_U8(d, b);
    }
    if keep_keys {
        if src.keys.count > 0 {let _ifd7 = 
            omni_strlist_copy(&src.keys, &dst.keys);
        } else {
            dst.keys.len = 0;
            dst.keys.count = 0;
        };
    };
    return 0;
}

// export function buildAllFreeGroups(_opencodeModels, kiloModels,
//   clineModelsOrExisting?, freebuffModelsOrExisting?, existingGroupsArg?,
//   optionsArg?): ChannelGroupConfig[] (ts:3107-3263)
// The TS overload-resolution prologue (isOptions / isGroupConfigArray
// probing of the three ambiguous positions) is folded into the caller's
// kind tags in BuildAllFreeGroupsArgs (see DEFECT above); the merge logic
// below follows the source 1:1 from "existingKilo = ..." onward.
fn buildAllFreeGroups(opencodeModels: &StrList, kiloModels: &StrList, args: &BuildAllFreeGroupsArgs, out: &BuiltFreeGroups) -> i32 {
    out.count = 0;
    out.has_cline = false;
    out.has_freebuff = false;
    out.has_d2api = false;
    let existing = &args.existing;
    let has_options = args.has_options;
    let options = &args.options;
    // cline/freebuff model lists only count when the position carried a
    // string[] that is not a group-config array (kind 1).
    let has_cline_models = args.cline_kind == 1;
    let has_freebuff_models = args.freebuff_kind == 1;
    // 新抓取优先！仅抓取失败或结果为空时回退沿用旧模型
    // const kiloModelsMerged = kiloModels.length > 0 ? dedupe(kiloModels) : existingKilo?.models ?? [];
    if kiloModels.count > 0 {let _ifd8 = 
        omni_strlist_dedupe(kiloModels, &out.kilo.models);
    } else {
        if existing.has_kilo {let _ifd9 = 
            omni_strlist_copy(&existing.kilo.models, &out.kilo.models);
        } else {
            out.kilo.models.len = 0;
            out.kilo.models.count = 0;
        };
    };
    // Build the kilo group around the merged models, then re-apply the
    // preserved fields (TS spreads buildKiloCodeGroup(merged) first).
    let merged_kilo = StrList { bytes: [0u8; 65536], len: 0, count: 0 };
    omni_strlist_copy(&out.kilo.models, &merged_kilo);
    buildKiloCodeGroup(&merged_kilo, &out.kilo);
    if existing.has_kilo {
        omni_apply_existing_group(&out.kilo, &existing.kilo, STR_PTR("KiloCode"), false);
    };
    omni_strlist_copy(&merged_kilo, &out.kilo.models);
    // TS forces these after the spread:
    let f: ptr = PTR_NULL();
    PTR_BYTE_ADD(f, &out.kilo.responseProtocol_bytes, 0);
    out.kilo.responseProtocol_len = omni_fill_field(f, STR_PTR("openai-response"), STR_LEN("openai-response"));
    PTR_BYTE_ADD(f, &out.kilo.responseProtocolMode_bytes, 0);
    out.kilo.responseProtocolMode_len = omni_fill_field(f, STR_PTR("fixed"), STR_LEN("fixed"));
    out.count = 1;
    // OpenCode 免费渠道已下线，仅保留 KiloCode 及其它显式启用的免费渠道。
    // 彩蛋机制：未安装或未配置凭据时静默隐藏；一旦检测到凭据或已配置 keys，自动点亮
    let include_cline = false;
    if has_options && options.has_hasClineCredentials {
        include_cline = options.hasClineCredentials || (existing.has_cline && existing.cline.keys.count > 0);
    } else {
        include_cline = has_cline_models || existing.has_cline;
    };
    let include_freebuff = false;
    if has_options && options.has_hasFreebuffCredentials {
        include_freebuff = options.hasFreebuffCredentials || (existing.has_freebuff && existing.freebuff.keys.count > 0);
    } else {
        include_freebuff = has_freebuff_models || existing.has_freebuff;
    };
    if include_cline {
        out.has_cline = true;
        let merged = StrList { bytes: [0u8; 65536], len: 0, count: 0 };
        if has_cline_models && args.cline_models.count > 0 {let _ifd10 = 
            omni_strlist_dedupe(&args.cline_models, &merged);
        } else {
            if existing.has_cline {
                omni_strlist_copy(&existing.cline.models, &merged);
            };
        };
        buildClineFreeGroup(&merged, STR_PTR(""), 0, &out.cline);
        if existing.has_cline {
            omni_apply_existing_group(&out.cline, &existing.cline, STR_PTR("ClineFree"), true);
        };
        omni_strlist_copy(&merged, &out.cline.models);
        PTR_BYTE_ADD(f, &out.cline.responseProtocol_bytes, 0);
        out.cline.responseProtocol_len = omni_fill_field(f, STR_PTR("openai"), STR_LEN("openai"));
        PTR_BYTE_ADD(f, &out.cline.responseProtocolMode_bytes, 0);
        out.cline.responseProtocolMode_len = omni_fill_field(f, STR_PTR("fixed"), STR_LEN("fixed"));
        out.count = out.count + 1;
    };
    if include_freebuff {
        out.has_freebuff = true;
        let merged = StrList { bytes: [0u8; 65536], len: 0, count: 0 };
        if has_freebuff_models && args.freebuff_models.count > 0 {let _ifd11 = 
            omni_strlist_dedupe(&args.freebuff_models, &merged);
        } else {
            if existing.has_freebuff {let _ifd12 = 
                omni_strlist_copy(&existing.freebuff.models, &merged);
            } else {
                // existingFreebuff?.models ?? [...DEFAULT_FREEBUFF_MODELS]
                let defaults = "z-ai/glm-5.3-flash\nmimo/mimo-v2.5\ndeepseek/deepseek-v4-flash\nopenai/gpt-5.6-luna\nopenai/gpt-5.6-luna-es\nminimax/minimax-m3\nupstage/solar-pro-4";
                let base: ptr = PTR_NULL();
                PTR_BYTE_ADD(base, &merged.bytes, 0);
                merged.len = omni_fill_field(base, STR_PTR(defaults), STR_LEN(defaults));
                merged.count = 7;
            };
        };
        buildFreebuffGroup(&merged, STR_PTR(""), 0, &out.freebuff);
        if existing.has_freebuff {
            omni_apply_existing_group(&out.freebuff, &existing.freebuff, STR_PTR("Freebuff"), true);
        };
        omni_strlist_copy(&merged, &out.freebuff.models);
        PTR_BYTE_ADD(f, &out.freebuff.responseProtocol_bytes, 0);
        out.freebuff.responseProtocol_len = omni_fill_field(f, STR_PTR("openai"), STR_LEN("openai"));
        PTR_BYTE_ADD(f, &out.freebuff.responseProtocolMode_bytes, 0);
        out.freebuff.responseProtocolMode_len = omni_fill_field(f, STR_PTR("fixed"), STR_LEN("fixed"));
        out.count = out.count + 1;
    };
    // d2api 自托管免费组：显式传入模型（import 探测）即纳入；否则沿用已入库的组。
    let include_d2api = (has_options && options.has_d2apiModels) || existing.has_d2api;
    if include_d2api {
        out.has_d2api = true;
        let raw = StrList { bytes: [0u8; 65536], len: 0, count: 0 };
        if has_options && options.has_d2apiModels && options.d2apiModels.count > 0 {let _ifd13 = 
            omni_strlist_dedupe(&options.d2apiModels, &raw);
        } else {
            if existing.has_d2api {
                omni_strlist_copy(&existing.d2api.models, &raw);
            } else {
                omni_d2api_default_models(&raw);
            };
        };
        // Migrate delisted flagship in persisted groups.
        let migrated = StrList { bytes: [0u8; 65536], len: 0, count: 0 };
        omni_d2api_migrate_models(&raw, &migrated);
        let merged = StrList { bytes: [0u8; 65536], len: 0, count: 0 };
        omni_strlist_dedupe(&migrated, &merged);
        // const d2apiKey = options?.d2apiApiKey?.trim() || existingD2Api?.keys?.[0]?.trim() ?? "";
        let key_ptr: ptr = STR_PTR("");
        let key_len: u64 = 0;
        if has_options && options.has_d2apiApiKey && options.d2apiApiKey_len > 0 {
            PTR_BYTE_ADD(key_ptr, &options.d2apiApiKey_bytes, 0);
            key_len = options.d2apiApiKey_len;
        } else {
            if existing.has_d2api && existing.d2api.keys.count > 0 {
                // First key only: bytes up to the first newline.
                let keys_base: ptr = PTR_NULL();
                PTR_BYTE_ADD(keys_base, &existing.d2api.keys.bytes, 0);
                key_ptr = keys_base;
                key_len = existing.d2api.keys.len;
                for i in 0..existing.d2api.keys.len {
                    let b: u8 = 0;
                    PTR_BYTE_AT(b, keys_base, i);
                    if b == 10 {
                        key_len = i;
                        break;
                    };
                }
            };
        };
        // const d2apiBase = options?.d2apiBaseUrl?.trim() || existingD2Api?.baseUrl?.trim() || D2API_BASE_URL;
        let base_ptr: ptr = STR_PTR("http://127.0.0.1:44090");
        let base_len: u64 = STR_LEN("http://127.0.0.1:44090");
        if has_options && options.has_d2apiBaseUrl && options.d2apiBaseUrl_len > 0 {
            PTR_BYTE_ADD(base_ptr, &options.d2apiBaseUrl_bytes, 0);
            base_len = options.d2apiBaseUrl_len;
        } else {
            if existing.has_d2api && existing.d2api.baseUrl_len > 0 {
                PTR_BYTE_ADD(base_ptr, &existing.d2api.baseUrl_bytes, 0);
                base_len = existing.d2api.baseUrl_len;
            };
        };
        buildD2ApiFreeGroup(&merged, key_ptr, key_len, base_ptr, base_len, &out.d2api);
        if existing.has_d2api {
            omni_apply_existing_group(&out.d2api, &existing.d2api, STR_PTR("D2API"), false);
            // TS then overrides keys with d2apiKey ? [d2apiKey] : [].
            out.d2api.keys.len = 0;
            out.d2api.keys.count = 0;
            if key_len > 0 {
                let keys_base: ptr = PTR_NULL();
                PTR_BYTE_ADD(keys_base, &out.d2api.keys.bytes, 0);
                out.d2api.keys.len = omni_fill_field(keys_base, key_ptr, key_len);
                out.d2api.keys.count = 1;
            };
        };
        omni_strlist_copy(&merged, &out.d2api.models);
        PTR_BYTE_ADD(f, &out.d2api.baseUrl_bytes, 0);
        out.d2api.baseUrl_len = omni_fill_field(f, base_ptr, base_len);
        out.d2api.has_contextWindow = true;
        out.d2api.contextWindow = 20000;
        PTR_BYTE_ADD(f, &out.d2api.responseProtocol_bytes, 0);
        out.d2api.responseProtocol_len = omni_fill_field(f, STR_PTR("openai"), STR_LEN("openai"));
        PTR_BYTE_ADD(f, &out.d2api.responseProtocolMode_bytes, 0);
        out.d2api.responseProtocolMode_len = omni_fill_field(f, STR_PTR("fixed"), STR_LEN("fixed"));
        out.count = out.count + 1;
    };
    return 0;
}

