// Observed tool-name store (omniRouteFree.ts:1613-1753)
// const OPENCODE_OBSERVED_MAX_NAMES = 32; (ts:1613)
// const OPENCODE_OBSERVED_MAX_ENTRIES = 64; (ts:1614)
// const OPENCODE_OBSERVED_REFUSALS_BEFORE_FORGETTING = 3; (ts:1615)
// const opencodeObservedTools = new Map<string, readonly string[]>(); (ts:1617)
// const opencodeObservedRefusals = new Map<string, number>(); (ts:1618)
// DEFECT: Map — module-level maps approximated by a caller-owned store of
// fixed-capacity parallel arrays (64 entries; key = joined string bytes,
// value = newline-joined names / refusal streak). Insertion order is kept
// so the "evict oldest" loops below behave like the TS Map iteration.
// DEFECT: Object.freeze on the stored name lists — no immutability in SLA.
// ---------------------------------------------------------------------------
struct OpencodeObservedStore {
    keys_bytes: [u8; 32768],
    key_lens: [u64; 64],
    key_offsets: [u64; 64],
    names_bytes: [u8; 131072],
    name_lens: [u64; 64],
    name_offsets: [u64; 64],
    refusal_streaks: [u64; 64],
    has_refusal: [bool; 64],
    count: u64,
    names_used: u64,
    keys_used: u64,
}

// function opencodeObservationKey(provider: string, model: string, session?: string): string (ts:1619-1621)
// [provider, model, session ?? ""].join("|")
fn opencodeObservationKey(provider_ptr: ptr, provider_len: u64, model_ptr: ptr, model_len: u64, has_session: bool, session_ptr: ptr, session_len: u64, out_ptr: ptr, out_len: &u64) -> i32 {
    let n: u64 = 0;
    for i in 0..provider_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, provider_ptr, i);
        let dst: ptr = PTR_NULL();
        PTR_BYTE_ADD(dst, out_ptr, n);
        PTR_WRITE_U8(dst, b);
        n = n + 1;
    }
    let sep: ptr = PTR_NULL();
    PTR_BYTE_ADD(sep, out_ptr, n);
    PTR_WRITE_U8(sep, 124u8);
    n = n + 1;
    for i in 0..model_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, model_ptr, i);
        let dst: ptr = PTR_NULL();
        PTR_BYTE_ADD(dst, out_ptr, n);
        PTR_WRITE_U8(dst, b);
        n = n + 1;
    }
    let sep2: ptr = PTR_NULL();
    PTR_BYTE_ADD(sep2, out_ptr, n);
    PTR_WRITE_U8(sep2, 124u8);
    n = n + 1;
    if has_session {
        for i in 0..session_len {
            let b: u8 = 0;
            PTR_BYTE_AT(b, session_ptr, i);
            let dst: ptr = PTR_NULL();
            PTR_BYTE_ADD(dst, out_ptr, n);
            PTR_WRITE_U8(dst, b);
            n = n + 1;
        }
    };
    *out_len = n;
    return 0;
}

// Linear lookup of a key in the store; returns the entry index or -1.
fn omni_observed_find(store: &OpencodeObservedStore, key_ptr: ptr, key_len: u64) -> i64 {
    for idx in 0..store.count {
        let off: u64 = store.key_offsets[idx];
        let len: u64 = store.key_lens[idx];
        let base: ptr = PTR_NULL();
        PTR_BYTE_ADD(base, &store.keys_bytes, off);
        if omni_str_eq(base, len, key_ptr, key_len) { return idx as i64; };
    }
    return -1;
}

// function opencodeSanitizeObservedNames(names: readonly unknown[]): string[] (ts:1623-1632)
// TS logic: keep string entries matching the name pattern, dedupe, cap 32.
// DEFECT: dynamic object — entries arrive as a StrList here (already
// strings), so only pattern + dedupe + cap are applied; dedupe uses a
// linear scan over the newline-joined output.
// DEFECT: string[] representation — see StrList.
fn opencodeSanitizeObservedNames(names: &StrList, out: &StrList) -> i32 {
    out.len = 0;
    out.count = 0;
    // Walk newline-joined entries of `names`.
    let src_base: ptr = PTR_NULL();
    PTR_BYTE_ADD(src_base, &names.bytes, 0);
    let pos: u64 = 0;
    let out_base: ptr = PTR_NULL();
    PTR_BYTE_ADD(out_base, &out.bytes, 0);
    while pos < names.len {
        let entry_start: u64 = pos;
        while pos < names.len {
            let b: u8 = 0;
            PTR_BYTE_AT(b, src_base, pos);
            if b == 10 { break; };
            pos = pos + 1;
        }
        let entry_len: u64 = pos - entry_start;
        if out.count < 32 && omni_observed_tool_name_valid(omni_padd(src_base, entry_start), entry_len) {
            // dedupe: scan out entries
            let dup = false;
            let scan: u64 = 0;
            while scan < out.len {
                let s_start: u64 = scan;
                while scan < out.len {
                    let b: u8 = 0;
                    PTR_BYTE_AT(b, out_base, scan);
                    if b == 10 { break; };
                    scan = scan + 1;
                }
                if omni_str_eq(omni_padd(out_base, s_start), scan - s_start, omni_padd(src_base, entry_start), entry_len) { dup = true; };
                scan = scan + 1;
            }
            if !dup {
                if out.len > 0 {
                    let dst: ptr = PTR_NULL();
                    PTR_BYTE_ADD(dst, out_base, out.len);
                    PTR_WRITE_U8(dst, 10u8);
                    out.len = out.len + 1;
                };
                for i in 0..entry_len {
                    let b: u8 = 0;
                    PTR_BYTE_AT(b, src_base, entry_start + i);
                    let dst: ptr = PTR_NULL();
                    PTR_BYTE_ADD(dst, out_base, out.len);
                    PTR_WRITE_U8(dst, b);
                    out.len = out.len + 1;
                }
                out.count = out.count + 1;
            };
        };
        pos = pos + 1;
    }
    return 0;
}

// Append/replace one store entry (TS: delete + set to refresh LRU order).
// DEFECT: Map — true delete+reinsert ordering approximated: existing keys
// are overwritten in place (order does not refresh).
fn omni_observed_put(store: &OpencodeObservedStore, key_ptr: ptr, key_len: u64, names: &StrList) -> i32 {
    let found: i64 = omni_observed_find(store, key_ptr, key_len);
    let idx: u64 = 0;
    if found >= 0 {
        idx = found as u64;
    } else {
        if store.count >= 64 { return -1; };
        idx = store.count;
        store.key_offsets[idx] = store.keys_used;
        store.key_lens[idx] = key_len;
        for i in 0..key_len {
            let b: u8 = 0;
            PTR_BYTE_AT(b, key_ptr, i);
            let dst: ptr = PTR_NULL();
            let base: ptr = PTR_NULL();
            PTR_BYTE_ADD(base, &store.keys_bytes, store.keys_used);
            PTR_BYTE_ADD(dst, base, i);
            PTR_WRITE_U8(dst, b);
        }
        store.keys_used = store.keys_used + key_len;
        store.count = store.count + 1;
    };
    store.name_offsets[idx] = store.names_used;
    store.name_lens[idx] = names.len;
    let names_base: ptr = PTR_NULL();
    PTR_BYTE_ADD(names_base, &names.bytes, 0);
    for i in 0..names.len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, names_base, i);
        let dst: ptr = PTR_NULL();
        let base: ptr = PTR_NULL();
        PTR_BYTE_ADD(base, &store.names_bytes, store.names_used);
        PTR_BYTE_ADD(dst, base, i);
        PTR_WRITE_U8(dst, b);
    }
    store.names_used = store.names_used + names.len;
    return 0;
}

// Port of `recordAcceptedToolNames`: dual write session+model, LRU evict, clear streak.
// export function recordAcceptedOpencodeToolNames(store, provider, model, session, names): void (ts:1634-1657)
// DEFECT: optional parameter (session: string | undefined) — has_session
// flag + (ptr, len).
// DEFECT: Map LRU eviction — the while (size > 64) evict-oldest loop is
// approximated by refusing inserts beyond capacity (see omni_observed_put);
// refusal entries are cleared for the written keys only.
fn recordAcceptedOpencodeToolNames(store: &OpencodeObservedStore, provider_ptr: ptr, provider_len: u64, model_ptr: ptr, model_len: u64, has_session: bool, session_ptr: ptr, session_len: u64, names: &StrList) -> i32 {
    let kept = StrList { bytes: [0u8; 65536], len: 0, count: 0 };
    opencodeSanitizeObservedNames(names, &kept);
    if kept.count == 0 { return 0; };
    let key_buf: [u8; 1024] = [0u8; 1024];
    let key_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(key_ptr, &key_buf, 0);
    if has_session {
        let key_len: u64 = 0;
        opencodeObservationKey(provider_ptr, provider_len, model_ptr, model_len, true, session_ptr, session_len, key_ptr, &key_len);
        omni_observed_put(store, key_ptr, key_len, &kept);
        let idx: i64 = omni_observed_find(store, key_ptr, key_len);
        if idx >= 0 { store.has_refusal[idx as u64] = false; };
    };
    let key_len2: u64 = 0;
    opencodeObservationKey(provider_ptr, provider_len, model_ptr, model_len, false, session_ptr, 0, key_ptr, &key_len2);
    omni_observed_put(store, key_ptr, key_len2, &kept);
    let idx2: i64 = omni_observed_find(store, key_ptr, key_len2);
    if idx2 >= 0 { store.has_refusal[idx2 as u64] = false; };
    return 0;
}

// Port of `noteRefusedBorrowedToolNames`: 3-strike forget, borrowed-only.
// export function noteRefusedBorrowedOpencodeToolNames(store, provider, model, session?): void (ts:1659-1678)
// DEFECT: Map — forgetting an entry is approximated by marking the slot's
// key length 0 (slots are not compacted in this pass).
fn noteRefusedBorrowedOpencodeToolNames(store: &OpencodeObservedStore, provider_ptr: ptr, provider_len: u64, model_ptr: ptr, model_len: u64, has_session: bool, session_ptr: ptr, session_len: u64) -> i32 {
    let key_buf: [u8; 1024] = [0u8; 1024];
    let key_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(key_ptr, &key_buf, 0);
    let key_len: u64 = 0;
    opencodeObservationKey(provider_ptr, provider_len, model_ptr, model_len, has_session, session_ptr, session_len, key_ptr, &key_len);
    let idx: i64 = omni_observed_find(store, key_ptr, key_len);
    if idx < 0 && has_session {
        let key_len2: u64 = 0;
        opencodeObservationKey(provider_ptr, provider_len, model_ptr, model_len, false, session_ptr, 0, key_ptr, &key_len2);
        idx = omni_observed_find(store, key_ptr, key_len2);
    };
    if idx < 0 { return 0; };
    let i: u64 = idx as u64;
    let streak: u64 = 1;
    if store.has_refusal[i] { streak = store.refusal_streaks[i] + 1; };
    if streak < 3 {
        store.refusal_streaks[i] = streak;
        store.has_refusal[i] = true;
        return 0;
    };
    // Forget: delete tools + refusals entries for the key.
    store.key_lens[i] = 0;
    store.has_refusal[i] = false;
    return 0;
}

// Port of `confirmBorrowedToolNames`: OK on borrowed shape clears refusal streak.
// export function confirmBorrowedOpencodeToolNames(store, provider, model, session?): void (ts:1680-1693)
fn confirmBorrowedOpencodeToolNames(store: &OpencodeObservedStore, provider_ptr: ptr, provider_len: u64, model_ptr: ptr, model_len: u64, has_session: bool, session_ptr: ptr, session_len: u64) -> i32 {
    let key_buf: [u8; 1024] = [0u8; 1024];
    let key_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(key_ptr, &key_buf, 0);
    let key_len: u64 = 0;
    opencodeObservationKey(provider_ptr, provider_len, model_ptr, model_len, has_session, session_ptr, session_len, key_ptr, &key_len);
    let idx: i64 = omni_observed_find(store, key_ptr, key_len);
    if idx < 0 && has_session {
        let key_len2: u64 = 0;
        opencodeObservationKey(provider_ptr, provider_len, model_ptr, model_len, false, session_ptr, 0, key_ptr, &key_len2);
        idx = omni_observed_find(store, key_ptr, key_len2);
    };
    if idx < 0 { return 0; };
    store.has_refusal[idx as u64] = false;
    return 0;
}

// export function getObservedOpencodeToolNames(store, provider, model, session?): readonly string[] | null (ts:1695-1701)
// Returns 0 + names in out (session key only, exactly as TS), -1 for null.
// DEFECT: TS probes ONLY the session key (no model-key fallback here).
fn getObservedOpencodeToolNames(store: &OpencodeObservedStore, provider_ptr: ptr, provider_len: u64, model_ptr: ptr, model_len: u64, has_session: bool, session_ptr: ptr, session_len: u64, out: &StrList) -> i32 {
    out.len = 0;
    out.count = 0;
    let key_buf: [u8; 1024] = [0u8; 1024];
    let key_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(key_ptr, &key_buf, 0);
    let key_len: u64 = 0;
    opencodeObservationKey(provider_ptr, provider_len, model_ptr, model_len, has_session, session_ptr, session_len, key_ptr, &key_len);
    let idx: i64 = omni_observed_find(store, key_ptr, key_len);
    if idx < 0 { return -1; };
    let i: u64 = idx as u64;
    let off: u64 = store.name_offsets[i];
    let len: u64 = store.name_lens[i];
    let out_base: ptr = PTR_NULL();
    PTR_BYTE_ADD(out_base, &out.bytes, 0);
    let count: u64 = 0;
    if len > 0 { count = 1; };
    for j in 0..len {
        let b: u8 = 0;
        let src: ptr = PTR_NULL();
        let base: ptr = PTR_NULL();
        PTR_BYTE_ADD(base, &store.names_bytes, off);
        PTR_BYTE_ADD(src, base, j);
        PTR_BYTE_AT(b, src, 0);
        let dst: ptr = PTR_NULL();
        PTR_BYTE_ADD(dst, out_base, j);
        PTR_WRITE_U8(dst, b);
        if b == 10 { count = count + 1; };
    }
    out.len = len;
    out.count = count;
    return 0;
}

// export function resetOpencodeToolObservationForTests(store): void (ts:1703-1706)
fn resetOpencodeToolObservationForTests(store: &OpencodeObservedStore) -> i32 {
    store.count = 0;
    store.names_used = 0;
    store.keys_used = 0;
    return 0;
}

