    error_len: u64,
}

// let cachedClineBalance: { data: ClineBalanceInfo; expiresAt: number } | null = null; (ts:3385)
// DEFECT: module-level mutable state — caller-owned struct.
struct ClineBalanceCache {
    has_entry: bool,
    data: ClineBalanceInfo,
    expiresAt: u64,
}

// export async function fetchClineBalance(cache, tokenCache, options: { forceRefresh?: boolean; fetchImpl? } = {}): Promise<ClineBalanceInfo> (ts:3387-3452)
// DEFECT: async — synchronous; the result is written to `out` (TS returns
// the info object on every path, including failures).
// TS flow: fresh cache (expiresAt > now, 45_000 ms TTL set on success)
// wins unless forceRefresh; token = await resolveLocalClineToken(...);
// no token -> { configured: false, error: "No Cline token found" };
// GET `${CLINE_FREE_BASE_URL}/users/me` (Bearer workos: token, Cline
// client headers); non-ok -> { configured: true, error: `Failed to fetch
// Cline user (<status>)` }; missing user id -> configured + email/
// displayName + "User ID not found in Cline response"; GET
// `.../users/<id>/balance`; non-ok -> `Failed to fetch balance
// (<status>)`; credits = round(balance / 10000 * 100) / 100,
// formattedBalance = `$${credits.toFixed(2)}`; thrown errors ->
// { configured: true, error: message }.
// DEFECT: fetch — neither request is performed in this pass; with no
// token resolvable (resolveLocalClineToken only reaches env/cache), the
// reachable outcomes are the cache hit and the no-token result.
fn fetchClineBalance(cache: &ClineBalanceCache, tokenCache: &ClineTokenCache, forceRefresh: bool, has_fetchImpl: bool, out: &ClineBalanceInfo) -> i32 {
    let now: u64 = omni_now_ms();
    if cache.has_entry && !forceRefresh && cache.expiresAt > now {
        out.configured = cache.data.configured;
        out.has_userId = cache.data.has_userId;
        out.userId_len = cache.data.userId_len;
        out.has_email = cache.data.has_email;
        out.email_len = cache.data.email_len;
        out.has_displayName = cache.data.has_displayName;
        out.displayName_len = cache.data.displayName_len;
        out.has_credits = cache.data.has_credits;
        out.credits = cache.data.credits;
        out.has_rawBalance = cache.data.has_rawBalance;
        out.rawBalance = cache.data.rawBalance;
        out.has_formattedBalance = cache.data.has_formattedBalance;
        out.formattedBalance_len = cache.data.formattedBalance_len;
        out.has_error = cache.data.has_error;
        out.error_len = cache.data.error_len;
        // Byte copies of the string fields accompany the lengths above.
        // DEFECT: field-by-field struct copy — the byte arrays are copied
        // for the id/email/name/balance/error fields in the fix phase;
        // lengths and scalars are carried here.
        return 0;
    };
    let token_options = ResolveClineTokenOptions { has_forceRefresh: false, forceRefresh: false, has_fetchImpl: has_fetchImpl, has_settingsPath: false, settingsPath_bytes: [0u8; 1024], settingsPath_len: 0 };
    let token_buf: [u8; 4096] = [0u8; 4096];
    let token_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(token_ptr, &token_buf, 0);
    let token_len: u64 = 0;
    if resolveLocalClineToken(tokenCache, &token_options, token_ptr, &token_len) != 0 {
        out.configured = false;
        out.has_userId = false;
        out.has_email = false;
        out.has_displayName = false;
        out.has_credits = false;
        out.has_rawBalance = false;
        out.has_formattedBalance = false;
        out.has_error = true;
        let f: ptr = PTR_NULL();
        PTR_BYTE_ADD(f, &out.error_bytes, 0);
        out.error_len = omni_fill_field(f, STR_PTR("No Cline token found"), STR_LEN("No Cline token found"));
        return 0;
    };
    // DEFECT: fetch — /users/me and /users/<id>/balance not performed;
    // TS would continue from here with the token in hand.
    out.configured = true;
    out.has_userId = false;
    out.has_email = false;
    out.has_displayName = false;
    out.has_credits = false;
    out.has_rawBalance = false;
    out.has_formattedBalance = false;
    out.has_error = false;
    return 0;
}
