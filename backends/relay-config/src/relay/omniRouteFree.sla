// const OPENCODE_THINKING_MODEL_PATTERNS: RegExp[] = [/deepseek/i, /\bkimi\b/i, /\bk2\b/i, /\bminimax\b/i, /\bmimo\b/i]; (ts:387)
// DEFECT: regex — word-boundary patterns approximated by substring
// contains (case-sensitive here; TS uses /i).
// ---------------------------------------------------------------------------

// Thinking-mode families that require `reasoning_content` echo (else upstream 400).
// export function isOpencodeThinkingMessageModel(model: string | undefined | null): boolean (ts:389-392)
fn isOpencodeThinkingMessageModel(has_model: bool, model_ptr: ptr, model_len: u64) -> bool {
    if !has_model { return false; };
    if omni_str_contains(model_ptr, model_len, STR_PTR("deepseek"), STR_LEN("deepseek")) { return true; };
    if omni_str_contains(model_ptr, model_len, STR_PTR("kimi"), STR_LEN("kimi")) { return true; };
    if omni_str_contains(model_ptr, model_len, STR_PTR("k2"), STR_LEN("k2")) { return true; };
    if omni_str_contains(model_ptr, model_len, STR_PTR("minimax"), STR_LEN("minimax")) { return true; };
    if omni_str_contains(model_ptr, model_len, STR_PTR("mimo"), STR_LEN("mimo")) { return true; };
    return false;
}

// function opencodeHasNonEmptyReasoningContent(message: Record<string, unknown>): boolean (ts:394-396)
// DEFECT: dynamic object — message.reasoning_content lookup inside JSON
// text is not implemented in this pass; the caller supplies the decoded
// flag instead.
fn opencodeHasNonEmptyReasoningContent(reasoning_is_string: bool, reasoning_ptr: ptr, reasoning_len: u64) -> bool {
    if !reasoning_is_string { return false; };
    // (message.reasoning_content as string).trim().length > 0 — trim
    // approximated by "any non-space byte".
    for i in 0..reasoning_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, reasoning_ptr, i);
        if b != 32 { return true; };
    }
    return false;
}

// Inject a placeholder `reasoning_content` on assistant messages lacking one. Idempotent.
// export function injectOpencodeReasoningContentForThinkingModel<T>(body: T): T (ts:398-422)
// DEFECT: generic <T> — no generics; the body is a JsonText mutated in
// place and the status code replaces the returned body identity.
// DEFECT: dynamic object — mapping record.messages, spreading entries and
// setting reasoning_content: " " requires JSON object manipulation not
// implemented in this pass; the body is left unchanged.
fn injectOpencodeReasoningContentForThinkingModel(body: &JsonText) -> i32 {
    return 0;
}

