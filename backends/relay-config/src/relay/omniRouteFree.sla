fn mergeOpencodeClientToolsWithObserved(store: &OpencodeObservedStore, body: &JsonText, body_is_object: bool, body_tools_count: u64, has_format: bool, format_ptr: ptr, format_len: u64, provider_ptr: ptr, provider_len: u64, model_ptr: ptr, model_len: u64, has_session: bool, session_ptr: ptr, session_len: u64, configured: &StrList) -> i32 {
