// function kernelIsRecord(value: unknown): value is Record<string, unknown> (ts:816-818)
// DEFECT: type predicate — boolean only.
fn kernelIsRecord(is_object: bool, is_null: bool, is_array: bool) -> bool {
    return is_object && !is_null && !is_array;
}

// function kernelAsArray(value: unknown): unknown[] (ts:820-822)
// TS: Array.isArray(value) ? value : [] — `out` receives the array JSON or
// an empty array text.
fn kernelAsArray(is_array: bool, value_json: &JsonText, out: &JsonText) -> i32 {
    if is_array {
        out.len = value_json.len;
        for i in 0..value_json.len {
            let b: u8 = 0;
            let src: ptr = PTR_NULL();
            PTR_BYTE_ADD(src, &value_json.bytes, i);
            PTR_BYTE_AT(b, src, 0);
            let dst: ptr = PTR_NULL();
            let base: ptr = PTR_NULL();
            PTR_BYTE_ADD(base, &out.bytes, 0);
            PTR_BYTE_ADD(dst, base, i);
            PTR_WRITE_U8(dst, b);
        }
    } else {
        let empty = "[]";
        for i in 0..STR_LEN(empty) {
            let b: u8 = 0;
            let src: ptr = PTR_NULL();
            PTR_BYTE_ADD(src, STR_PTR(empty), i);
            PTR_BYTE_AT(b, src, 0);
            let dst: ptr = PTR_NULL();
            let base: ptr = PTR_NULL();
            PTR_BYTE_ADD(base, &out.bytes, 0);
            PTR_BYTE_ADD(dst, base, i);
            PTR_WRITE_U8(dst, b);
        }
        out.len = 2;
    };
    return 0;
}

// function kernelFiniteNumber(value: unknown): number | undefined (ts:824-826)
// Returns 0 + value, -1 for TS undefined.
// DEFECT: dynamic object — the caller supplies the decoded number.
fn kernelFiniteNumber(is_number: bool, is_finite: bool, value: f64, out: &f64) -> i32 {
    if is_number && is_finite {
