// function opencodeWithStreaming<T>(body: T): T (ts:2225-2228)
// TS: non-object -> body; else { ...body, stream: true }.
// DEFECT: generic + dynamic object — setting stream:true inside the JSON
// text is not implemented; body left unchanged.
fn opencodeWithStreaming(body: &JsonText, body_is_object: bool) -> i32 {
    return 0;
}

// Result of prepareOpencodeFreeTierRequest (TS { body, attempt }).
struct PrepareFreeTierResult {
    has_attempt: bool,
    attempt: OpencodeFreeTierAttempt,
}

// Port of `prepareFreeTierRequest` (opencodeFreeTierContract.ts:361-407).
// export function prepareOpencodeFreeTierRequest<T>(...): { body: T; attempt: OpencodeFreeTierAttempt | null } (ts:2230-2273)
// DEFECT: generic <T> — body is JsonText mutated in place; the attempt is
// returned via `out` (has_attempt=false mirrors TS attempt: null).
// DEFECT: closure — the recorded injection context's replayNote
// ((verdict) => noteOpencodeFreeTierOutcome({ ...attempt, probe: false },
// verdict)) cannot be stored; has_replayNote is set and the fix phase
// must call noteOpencodeFreeTierOutcome directly.
fn prepareOpencodeFreeTierRequest(state: &OpencodeShapeState, store: &OpencodeObservedStore, body: &JsonText, body_is_object: bool, has_format: bool, format_ptr: ptr, format_len: u64, surface_ptr: ptr, surface_len: u64, provider_ptr: ptr, provider_len: u64, model_ptr: ptr, model_len: u64, has_session: bool, session_ptr: ptr, session_len: u64, has_origin: bool, origin_handle: u64, out: &PrepareFreeTierResult) -> i32 {
    out.has_attempt = false;
    // const clientToolNames = opencodeClientToolNamesOf(body);
    let client_names = StrList { bytes: [0u8; 65536], len: 0, count: 0 };
    opencodeClientToolNamesOf(body, body_is_object, &client_names);
    let gated = isGatedOpencodeFreeTierRequest(model_ptr, model_len, true, provider_ptr, provider_len, true, surface_ptr, surface_len) && isOpencodeFreeTierBodyContractEnabled();
    if !gated {
        if has_origin { opencodeForgetAttempt(state, origin_handle); };
        return 0;
    };
    let eligible = has_origin && client_names.count == 0;
    // const key = eligible ? opencodeShapeKeyOf(provider, model, body) : "";
    let key_buf: [u8; 1024] = [0u8; 1024];
    let key_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(key_ptr, &key_buf, 0);
    let key_len: u64 = 0;
    if eligible {
        opencodeShapeKeyOf(provider_ptr, provider_len, model_ptr, model_len, body, key_ptr, &key_len);
    };
    let plan = OpencodeShapePlan { shape_is_bare: false, probe: false };
    if has_origin && eligible {let _ifd2 = 
        opencodePlanShape(state, key_ptr, key_len, true, origin_handle, &plan);
    } else {
        plan.shape_is_bare = false;
        plan.probe = false;
    };
    // const names = resolveOpencodePlaceholderNames(provider, model, session, configuredOpencodePlaceholderToolNames());
    let configured = StrList { bytes: [0u8; 65536], len: 0, count: 0 };
    configuredOpencodePlaceholderToolNames(&configured);
    let names = StrList { bytes: [0u8; 65536], len: 0, count: 0 };
    resolveOpencodePlaceholderNames(store, provider_ptr, provider_len, model_ptr, model_len, has_session, session_ptr, session_len, &configured, &names);
    // const borrowed = clientToolNames.length === 0 && names.length > 0 && chosen === "tools";
    let borrowed = client_names.count == 0 && names.count > 0 && !plan.shape_is_bare;
    out.has_attempt = true;
    out.attempt.provider_len = provider_len;
    out.attempt.model_len = model_len;
    out.attempt.has_session = has_session;
    out.attempt.session_len = session_len;
    out.attempt.borrowed = borrowed;
    out.attempt.has_probe = true;
    out.attempt.probe = plan.probe;
    out.attempt.clientToolNames.len = client_names.len;
    out.attempt.clientToolNames.count = client_names.count;
    let ap_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(ap_ptr, &out.attempt.provider_bytes, 0);
    for i in 0..provider_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, provider_ptr, i);
        let dst: ptr = PTR_NULL();
        PTR_BYTE_ADD(dst, ap_ptr, i);
        PTR_WRITE_U8(dst, b);
    }
    let am_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(am_ptr, &out.attempt.model_bytes, 0);
    for i in 0..model_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, model_ptr, i);
        let dst: ptr = PTR_NULL();
        PTR_BYTE_ADD(dst, am_ptr, i);
        PTR_WRITE_U8(dst, b);
    }
    let as_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(as_ptr, &out.attempt.session_bytes, 0);
    if has_session {
        for i in 0..session_len {
            let b: u8 = 0;
            PTR_BYTE_AT(b, session_ptr, i);
            let dst: ptr = PTR_NULL();
            PTR_BYTE_ADD(dst, as_ptr, i);
            PTR_WRITE_U8(dst, b);
        }
    };
    let an_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(an_ptr, &out.attempt.clientToolNames.bytes, 0);
    let cn_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(cn_ptr, &client_names.bytes, 0);
    for i in 0..client_names.len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, cn_ptr, i);
        let dst: ptr = PTR_NULL();
        PTR_BYTE_ADD(dst, an_ptr, i);
        PTR_WRITE_U8(dst, b);
    }
    if has_origin { opencodeRememberAttempt(state, origin_handle, &out.attempt); };
    if has_origin && eligible {
        let ctx = OpencodeInjectionContext { shape_is_bare: plan.shape_is_bare, key_bytes: [0u8; 1024], key_len: key_len, probe: plan.probe, has_replayNote: true };
        let ck_ptr: ptr = PTR_NULL();
        PTR_BYTE_ADD(ck_ptr, &ctx.key_bytes, 0);
        for i in 0..key_len {
            let b: u8 = 0;
            PTR_BYTE_AT(b, key_ptr, i);
            let dst: ptr = PTR_NULL();
            PTR_BYTE_ADD(dst, ck_ptr, i);
            PTR_WRITE_U8(dst, b);
        }
        opencodeRecordInjection(state, origin_handle, &ctx);
    };
    // return { body: chosen === "bare" ? opencodeWithStreaming(body)
    //              : applyOpencodeFreeTierRequestContract(body, requestFormat, names), attempt };
    if plan.shape_is_bare {
        opencodeWithStreaming(body, body_is_object);
    } else {
        applyOpencodeFreeTierRequestContract(body, body_is_object, has_format, format_ptr, format_len, &names);
    };
    return 0;
}

// Port of `requiresFreeTierRequestContract`.
// export function requiresOpencodeFreeTierRequestContract(surface, provider, model): boolean (ts:2275-2282)
fn requiresOpencodeFreeTierRequestContract(surface_ptr: ptr, surface_len: u64, provider_ptr: ptr, provider_len: u64, model_ptr: ptr, model_len: u64) -> bool {
    return isGatedOpencodeFreeTierRequest(model_ptr, model_len, true, provider_ptr, provider_len, true, surface_ptr, surface_len) && isOpencodeFreeTierBodyContractEnabled();
}

// Port of `isShapeRefusal` + `learnFromReplay` decision core (opencodeRequestShape.ts).
// export function opencodeReplayShapeForRefusal(ctx, verdict): "tools" | "bare" | null (ts:1916-1929)
// Returns 0 + shape_is_bare out flag, -1 for TS null.
// DEFECT: ctx.probe is `boolean | undefined` in the port's usage; the
// has_probe distinction is kept via ctx.has_probe (unused: TS checks
// `ctx.probe === false` and later `if (!ctx.probe)`, both folded here).
fn opencodeReplayShapeForRefusal(ctx: &OpencodeInjectionContext, verdict: &OpencodeFreeTierOutcome, out_shape_is_bare: &bool) -> i32 {
    // if (ctx.probe === false && opencodeForcedShapeNote(ctx) === false) return null;
    // opencodeForcedShapeNote always returns true in the source port, so
    // this guard never fires.
    if !verdict.has_status { return -1; };
    if verdict.status != 403 && verdict.status != 451 { return -1; };
    if !verdict.has_bodyText { return -1; };
    let text_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(text_ptr, &verdict.bodyText_bytes, 0);
    let shape_refusal = isOpencodeFreeTierRefusal(verdict.status, true, text_ptr, verdict.bodyText_len) || isOpencodeQuotaShapeRefusal(verdict.status, true, text_ptr, verdict.bodyText_len);
    if !shape_refusal { return -1; };
    if !ctx.probe { return -1; };
    *out_shape_is_bare = !ctx.shape_is_bare;
    return 0;
}

// function opencodeForcedShapeNote(_ctx: OpencodeInjectionContext): boolean (ts:1930-1932)
// Source port body is `return true;`.
fn opencodeForcedShapeNote(ctx: &OpencodeInjectionContext) -> bool {
    return true;
}

// Port of `learnFromReplay`: accepted teaches bare, double-refusal pauses the class.
// export function opencodeLearnFromReplay(state, store, ctx, accepted, verdict): void (ts:1934-1942)
// DEFECT: closure — ctx.replayNote(verdict) is invoked in TS inside a
// try/catch that swallows observer errors; here the note is applied
// through noteOpencodeFreeTierOutcome with the state's attempt slot when
// present (see OpencodeInjectionContext DEFECT).
fn opencodeLearnFromReplay(state: &OpencodeShapeState, store: &OpencodeObservedStore, ctx: &OpencodeInjectionContext, accepted: bool, verdict: &OpencodeFreeTierOutcome) -> i32 {
    let key_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(key_ptr, &ctx.key_bytes, 0);
    if !accepted {
        opencodePauseShape(state, key_ptr, ctx.key_len);
        // try { ctx.replayNote(verdict); } catch { /* ignore observer errors */ }
        // DEFECT: closure — replayNote itself cannot be invoked (see
        // OpencodeInjectionContext); in TS it notes the outcome with
        // { ...attempt, probe: false }.
        return 0;
    };
    if !ctx.shape_is_bare {let _ifd3 = 
        // ctx.shape === "tools" -> opencodeRememberBare(ctx.key)
        opencodeRememberBare(state, key_ptr, ctx.key_len);
    } else {
        // opencodeBareShapeClasses.delete(ctx.key) — approximated by
        // zeroing the key length (slots are not compacted).
        let idx: i64 = omni_bare_index(state, key_ptr, ctx.key_len);
        if idx >= 0 { state.bare_key_lens[idx as u64] = 0; };
    };
    return 0;
}

// Port of `forwardOpencodeClientHeaders` background path (`buildOpencodeBackgroundHeaders`).
// export function buildOpencodeBackgroundHeaders(cache, options?: { seed?: string | null; userAgent?: string }): Record<string, string> (ts:2284-2313)
// DEFECT: dynamic object — HeaderMap writes are stubs in this pass.
fn buildOpencodeBackgroundHeaders(cache: &OpencodeCliVersionCache, has_seed: bool, seed_ptr: ptr, seed_len: u64, has_userAgent_opt: bool, userAgent_opt_ptr: ptr, userAgent_opt_len: u64, out: &HeaderMap) -> i32 {
    // const seed = options?.seed?.trim(); if (seed) headers["x-opencode-session"] = seed;
    // DEFECT: trim approximated by raw bytes.
    if has_seed && seed_len > 0 {
        omni_headers_set(out, STR_PTR("x-opencode-session"), STR_LEN("x-opencode-session"), seed_ptr, seed_len);
    };
    // const ua = options?.userAgent?.trim() || cli.userAgent (env OPENCODE_USER_AGENT or bare "opencode")
    let ua_ptr: ptr = userAgent_opt_ptr;
    let ua_len: u64 = userAgent_opt_len;
    if !has_userAgent_opt || ua_len == 0 {
        ua_ptr = STR_PTR("opencode");
        ua_len = STR_LEN("opencode");
    };
    omni_headers_set(out, STR_PTR("User-Agent"), STR_LEN("User-Agent"), ua_ptr, ua_len);
    // x-opencode-client: env OPENCODE_CLIENT or "desktop"; project likewise "global".
    // DEFECT: Node API — env unavailable; defaults used.
    omni_headers_set(out, STR_PTR("x-opencode-client"), STR_LEN("x-opencode-client"), STR_PTR("desktop"), STR_LEN("desktop"));
    omni_headers_set(out, STR_PTR("x-opencode-project"), STR_LEN("x-opencode-project"), STR_PTR("global"), STR_LEN("global"));
    // x-opencode-request: kept when it matches OPENCODE_REQUEST_PATTERN,
    // else canonicalOpencodeId("msg_", req || undefined). The headers map
    // has no pre-set request id on this path, so a fresh canonical id is
    // generated (seeded by nothing).
    let req_buf: [u8; 64] = [0u8; 64];
    let req_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(req_ptr, &req_buf, 0);
    let req_len: u64 = 0;
    canonicalOpencodeId(STR_PTR("msg_"), STR_LEN("msg_"), false, STR_PTR(""), 0, req_ptr, &req_len);
    omni_headers_set(out, STR_PTR("x-opencode-request"), STR_LEN("x-opencode-request"), req_ptr, req_len);
    // x-opencode-session: pattern-shaped kept as-is, else canonicalized
    // from the seed, else a fresh canonical id.
    let ses_buf: [u8; 64] = [0u8; 64];
    let ses_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(ses_ptr, &ses_buf, 0);
    let ses_len: u64 = 0;
    let current_len: u64 = 0;
    let current_buf: [u8; 512] = [0u8; 512];
    let current_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(current_ptr, &current_buf, 0);
    if omni_headers_get(out, STR_PTR("x-opencode-session"), STR_LEN("x-opencode-session"), current_ptr, &current_len) && current_len > 0 {
        if omni_id_pattern_test(current_ptr, current_len, STR_PTR("ses_"), STR_LEN("ses_")) {
            omni_headers_set(out, STR_PTR("x-opencode-session"), STR_LEN("x-opencode-session"), current_ptr, current_len);
        } else {
            canonicalOpencodeId(STR_PTR("ses_"), STR_LEN("ses_"), true, current_ptr, current_len, ses_ptr, &ses_len);
            omni_headers_set(out, STR_PTR("x-opencode-session"), STR_LEN("x-opencode-session"), ses_ptr, ses_len);
        };
    } else {
        canonicalOpencodeId(STR_PTR("ses_"), STR_LEN("ses_"), false, STR_PTR(""), 0, ses_ptr, &ses_len);let _ifd4 = 
        omni_headers_set(out, STR_PTR("x-opencode-session"), STR_LEN("x-opencode-session"), ses_ptr, ses_len);
    };
    return 0;
}

// Test-only reset, mirrors `_resetShapeMemoForTests`.
// export function resetOpencodeShapeMemoForTests(state): void (ts:2315-2319)
fn resetOpencodeShapeMemoForTests(state: &OpencodeShapeState) -> i32 {
    state.bare_count = 0;
    state.bare_used = 0;
    state.paused_count = 0;
    state.paused_used = 0;
    if state.forced_map != 0 { sa_idmap_clear(state.forced_map); };
    if state.injection_map != 0 { sa_idmap_clear(state.injection_map); };
    if state.attempt_map != 0 { sa_idmap_clear(state.attempt_map); };
    return 0;
}

// Port of `isBodyContractEnabled`: headers stay, body half is switchable.
// export function isOpencodeFreeTierBodyContractEnabled(): boolean (ts:2321-2324)
// TS: (process.env.OPENCODE_FREE_TIER_REQUEST_CONTRACT || "").trim().toLowerCase() !== "off"
// DEFECT: Node API — env unavailable, so the value reads as unset and
// this returns true.
fn isOpencodeFreeTierBodyContractEnabled() -> bool {
    return true;
}

// Full upstream message assembly for an OpenCode request body.
// export function buildOpencodeUpstreamBody<T>(body: T, model: string, stream: boolean, provider = "opencode", surface: OpencodeSurface = "zen", session?: string): T (ts:2326-2403)
// DEFECT: generic <T> — body is JsonText mutated in place.
// TS pipeline (order mirrors OpencodeExecutor.transformRequest):
//   0. sanitizeOpencodeBaseBody
//   1. applyOpencodeDeepSeekJsonSchemaFallback(model, next, provider)
//   2. responses-format input dedupe (dedupeKernelResponsesItems)
//   3. prepareOpencodeFreeTierRequest(next, format, surface, provider,
//      model, session, origin = the ORIGINAL body object)
//   4. trimOpencodeOversizedToolEnums + repairHollowKernelTools on tools
//   5. drop client_metadata (rest-spread copy)
//   6. strip model prefix
//   7. stream_options kept only for streaming openai chat format
//   8. effort split: deepseek families set model = baseModel and
//      reasoning_effort = effort when unset
//   9. thinking models: reasoning_content injection
// DEFECT: dynamic object — steps 2, 4 (field access), 5, 6 (model field),
// 7 and 8 (model/reasoning_effort fields) need JSON field manipulation
// not implemented in this pass; the steps that map to whole-body
// functions are invoked in order.
// DEFECT: WeakMap identity — the `origin` for step 3 is the original body
// object; here the caller supplies origin_handle for it.
// Note: `stream` is voided in TS (the parameter is unused there too).
fn buildOpencodeUpstreamBody(state: &OpencodeShapeState, store: &OpencodeObservedStore, body: &JsonText, body_is_object: bool, model_ptr: ptr, model_len: u64, stream: bool, provider_ptr: ptr, provider_len: u64, surface_ptr: ptr, surface_len: u64, has_session: bool, session_ptr: ptr, session_len: u64, origin_handle: u64) -> i32 {
    if !body_is_object { return 0; };
    // 0.
    sanitizeOpencodeBaseBody(body, body_is_object);
    // 1.
    applyOpencodeDeepSeekJsonSchemaFallback(model_ptr, model_len, body, body_is_object, provider_ptr, provider_len);
    // const format = resolveOpencodeTargetFormat(provider, model);
    let format_buf: [u8; 32] = [0u8; 32];
    let format_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(format_ptr, &format_buf, 0);
    let format_len: u64 = 0;
    resolveOpencodeTargetFormat(provider_ptr, provider_len, model_ptr, model_len, format_ptr, &format_len);
    let is_responses = omni_str_eq(format_ptr, format_len, STR_PTR("openai-responses"), STR_LEN("openai-responses"));
    // 2. DEFECT: dynamic object — record.input dedupe skipped (field access).
    // 3.
    let prepared = PrepareFreeTierResult { has_attempt: false, attempt: OpencodeFreeTierAttempt { provider_bytes: [0u8; 128], provider_len: 0, model_bytes: [0u8; 256], model_len: 0, has_session: false, session_bytes: [0u8; 256], session_len: 0, borrowed: false, clientToolNames: StrList { bytes: [0u8; 65536], len: 0, count: 0 }, has_probe: false, probe: false } };
    prepareOpencodeFreeTierRequest(state, store, body, body_is_object, true, format_ptr, format_len, surface_ptr, surface_len, provider_ptr, provider_len, model_ptr, model_len, has_session, session_ptr, session_len, true, origin_handle, &prepared);
    // 4. DEFECT: dynamic object — tools field access skipped.
    // 5-8. DEFECT: dynamic object — field-level edits skipped (see header).
    // 9.
    if isOpencodeThinkingMessageModel(true, model_ptr, model_len) {
        injectOpencodeReasoningContentForThinkingModel(body);
    };
    return 0;
}

// ---------------------------------------------------------------------------
// SDK session-protocol re-exports (omniRouteFree.ts:2405-2428)
// The OpenCode session protocol helpers live in the SDK (every backend
// consumes them); they are re-exported here so this module's existing
// importers keep their surface:
//   OPENCODE_BACKEND_USER_AGENTS, OPENCODE_CLI_BACKEND_HEADER,
//   clearOpenCodeSession, deriveOpenCodeSessionId, generateOpenCodeUlid,
//   getOpenCodeProjectId, getOpenCodeSessionId, openCodeThreadHeaders,
//   rotateOpenCodeSession, type OpenCodeBackendKind  (from "@cxu/sdk-backend")
// DEFECT: barrel re-export — SLA @import has no re-export semantics; the
// SDK module (sdk-backend) is the canonical home and importers should
// reference it directly in the fix phase. getOpenCodeProjectId is used by
// applyOpenCodeHeaders below; approximated there by an env/default stub.
// ---------------------------------------------------------------------------

// export function isOpenCodeGroup(group?: ChannelGroupConfig | null): boolean (ts:2430-2436)
fn isOpenCodeGroup(has_group: bool, group: &ChannelGroupConfig) -> bool {
    if !has_group { return false; };
    let id_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(id_ptr, &group.id_bytes, 0);
    if omni_str_eq(id_ptr, group.id_len, STR_PTR("opencode-free"), STR_LEN("opencode-free")) { return true; };
    if omni_str_eq(id_ptr, group.id_len, STR_PTR("opencode"), STR_LEN("opencode")) { return true; };
    let url_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(url_ptr, &group.baseUrl_bytes, 0);
    return group.baseUrl_len > 0 && omni_str_contains(url_ptr, group.baseUrl_len, STR_PTR("opencode.ai"), STR_LEN("opencode.ai"));
}

