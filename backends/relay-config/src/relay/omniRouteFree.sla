// Cap oversized enums (upstream 400 past 250 values / 15000 chars). Schema-shape agnostic.
// export function trimOpencodeOversizedToolEnums(tools: unknown): number (ts:480-487)
// DEFECT: dynamic object — see opencodeTrimSchemaNode; returns 0 when the
// tools value is not an array (caller flag) and 0 otherwise in this pass.
fn trimOpencodeOversizedToolEnums(tools_is_array: bool, tools_json: &JsonText) -> u64 {
    if !tools_is_array { return 0; };
    return opencodeTrimSchemaNode(tools_json);
}

