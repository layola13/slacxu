//   "gpt-5.4-nano", "gpt-5.4-mini", "tinfoil/gemma4-31b"]; (ts:3026-3034)
fn omni_d2api_default_models(out: &StrList) -> i32 {
    let text = "claude-haiku-4-5\nmistral-small-2603\ntinfoil/gpt-oss-120b\ngpt-6-luna\ngpt-5.4-nano\ngpt-5.4-mini\ntinfoil/gemma4-31b";
    let base: ptr = PTR_NULL();
    PTR_BYTE_ADD(base, &out.bytes, 0);
    out.len = omni_fill_field(base, STR_PTR(text), STR_LEN(text));
    out.count = 7;
    return 0;
}

// Migrate the delisted flagship id (shared by buildD2ApiFreeGroup and
// buildAllFreeGroups): "gpt-5.6-luna" / "gpt-5.6-luna-thinking"
// (case-insensitive, trimmed in TS) -> "gpt-6-luna".
// DEFECT: toLowerCase/trim on each entry — approximated by exact compares
// against the lowercase forms.
fn omni_d2api_migrate_models(input: &StrList, out: &StrList) -> i32 {
    out.len = 0;
    out.count = 0;
    let src_base: ptr = PTR_NULL();
    PTR_BYTE_ADD(src_base, &input.bytes, 0);
    let out_base: ptr = PTR_NULL();
    PTR_BYTE_ADD(out_base, &out.bytes, 0);
    let pos: u64 = 0;
    while pos < input.len {
        let start: u64 = pos;
        while pos < input.len {
            let b: u8 = 0;
            PTR_BYTE_AT(b, src_base, pos);
            if b == 10 { break; };
            pos = pos + 1;
        }
        let entry_len: u64 = pos - start;
        let write_ptr: ptr = omni_padd(src_base, start);
        let write_len: u64 = entry_len;
        if omni_str_eq(write_ptr, write_len, STR_PTR("gpt-5.6-luna"), STR_LEN("gpt-5.6-luna")) || omni_str_eq(write_ptr, write_len, STR_PTR("gpt-5.6-luna-thinking"), STR_LEN("gpt-5.6-luna-thinking")) {
            write_ptr = STR_PTR("gpt-6-luna");
            write_len = STR_LEN("gpt-6-luna");
        };
        if write_len > 0 {
            if out.len > 0 {
                let dst: ptr = PTR_NULL();
                PTR_BYTE_ADD(dst, out_base, out.len);
                PTR_WRITE_U8(dst, 10u8);
                out.len = out.len + 1;
            };
            for i in 0..write_len {
                let b: u8 = 0;
                PTR_BYTE_AT(b, write_ptr, i);
                let dst: ptr = PTR_NULL();
                PTR_BYTE_ADD(dst, out_base, out.len);
                PTR_WRITE_U8(dst, b);
                out.len = out.len + 1;
            }
            out.count = out.count + 1;
        };
        pos = pos + 1;
    }
    return 0;
}

// export function buildD2ApiFreeGroup(models: string[], apiKey = "", baseUrl = ""): ChannelGroupConfig (ts:3038-3067)
fn buildD2ApiFreeGroup(models: &StrList, apiKey_ptr: ptr, apiKey_len: u64, baseUrl_ptr: ptr, baseUrl_len: u64, out: &ChannelGroupConfig) -> i32 {
    // const availableModels = [...new Set(models.map(migrate))];
    let migrated = StrList { bytes: [0u8; 65536], len: 0, count: 0 };
    omni_d2api_migrate_models(models, &migrated);
    let deduped = StrList { bytes: [0u8; 65536], len: 0, count: 0 };
    omni_strlist_dedupe(&migrated, &deduped);
    // const key = apiKey.trim(); — trim approximated by raw bytes.
    // baseUrl: baseUrl.trim() || D2API_BASE_URL
    let base_ptr: ptr = baseUrl_ptr;
    let base_len: u64 = baseUrl_len;
    if base_len == 0 {
        base_ptr = STR_PTR("http://127.0.0.1:44090");
        base_len = STR_LEN("http://127.0.0.1:44090");
    };
    let auth = "none";
    if apiKey_len > 0 { auth = "bearer"; };
    omni_fill_group_common(out, STR_PTR("d2api"), STR_PTR("D2API"), STR_PTR("http://127.0.0.1:44090"), STR_PTR("D2API managed free models (DuckDuckGo backend)"), STR_PTR(auth), STR_PTR("openai"));
    // Override baseUrl with the resolved value (fill_group_common used a
    // placeholder-shaped literal of the same default).
    let f: ptr = PTR_NULL();
    PTR_BYTE_ADD(f, &out.baseUrl_bytes, 0);
    out.baseUrl_len = omni_fill_field(f, base_ptr, base_len);
    if deduped.count > 0 {
        omni_strlist_copy(&deduped, &out.models);
    } else {
        omni_d2api_default_models(&out.models);
    };
    out.has_contextWindow = true;
    out.contextWindow = 20000;
    out.keys.len = 0;
    out.keys.count = 0;
    if apiKey_len > 0 {
        let keys_base: ptr = PTR_NULL();
        PTR_BYTE_ADD(keys_base, &out.keys.bytes, 0);
        out.keys.len = omni_fill_field(keys_base, apiKey_ptr, apiKey_len);
        out.keys.count = 1;
    };
    return 0;
}

