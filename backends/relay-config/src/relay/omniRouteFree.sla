// ---------------------------------------------------------------------------
// Free-tier outcome noting (omniRouteFree.ts:1998-2038)
// export interface OpencodeFreeTierOutcome (ts:1998-2002)
// ---------------------------------------------------------------------------
struct OpencodeFreeTierOutcome {
    ok: bool,
    has_status: bool,
    status: u64,
    has_bodyText: bool,
    bodyText_bytes: [u8; 65536],
    bodyText_len: u64,
}

// export interface OpencodeFreeTierAttempt (ts:2004-2011)
struct OpencodeFreeTierAttempt {
    provider_bytes: [u8; 128],
    provider_len: u64,
    model_bytes: [u8; 256],
    model_len: u64,
    has_session: bool,
    session_bytes: [u8; 256],
    session_len: u64,
    borrowed: bool,
    clientToolNames: StrList,
    has_probe: bool,
    probe: bool,
}

// Port of `noteFreeTierOutcome`: OK teaches names, borrowed refusal counts 3-strike.
// export function noteOpencodeFreeTierOutcome(store, attempt, outcome: boolean | OpencodeFreeTierOutcome): void (ts:2013-2038)
// DEFECT: union parameter (boolean | outcome object) — the caller passes
// outcome_is_bool; a boolean is normalized to
// { ok: outcome, status: null, bodyText: null } exactly as in TS.
fn noteOpencodeFreeTierOutcome(store: &OpencodeObservedStore, has_attempt: bool, attempt: &OpencodeFreeTierAttempt, outcome_is_bool: bool, outcome_bool: bool, outcome: &OpencodeFreeTierOutcome) -> i32 {
    if !has_attempt { return 0; };
    let ok = outcome.ok;
    let has_status = outcome.has_status;
    let status: u64 = outcome.status;
    let has_bodyText = outcome.has_bodyText;
    if outcome_is_bool {
        ok = outcome_bool;
        has_status = false;
        has_bodyText = false;
    };
    let provider_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(provider_ptr, &attempt.provider_bytes, 0);
    let model_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(model_ptr, &attempt.model_bytes, 0);
    let session_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(session_ptr, &attempt.session_bytes, 0);
    if ok {
        if attempt.clientToolNames.count > 0 {let _ifd1 = 
            recordAcceptedOpencodeToolNames(store, provider_ptr, attempt.provider_len, model_ptr, attempt.model_len, attempt.has_session, session_ptr, attempt.session_len, &attempt.clientToolNames);
        } else {
            if attempt.borrowed && !attempt.probe {
                confirmBorrowedOpencodeToolNames(store, provider_ptr, attempt.provider_len, model_ptr, attempt.model_len, attempt.has_session, session_ptr, attempt.session_len);
            };
        };
        return 0;
    };
    if attempt.probe { return 0; };
    if !attempt.borrowed { return 0; };
    if !has_status { return 0; };
    let text_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(text_ptr, &outcome.bodyText_bytes, 0);
    if isOpencodeFreeTierRefusal(status, has_bodyText, text_ptr, outcome.bodyText_len) {
        noteRefusedBorrowedOpencodeToolNames(store, provider_ptr, attempt.provider_len, model_ptr, attempt.model_len, attempt.has_session, session_ptr, attempt.session_len);
    };
    return 0;
}

// ---------------------------------------------------------------------------
// Authentic reasoning guards (omniRouteFree.ts:2040-2079)
// Port of reasoningContentInjector.ts authentic-reasoning guards (K3 / native K2.7).
// const OPENCODE_K3_AUTHENTIC_RE = /(?:^|\/)(?:kimi-)?k3(?:$|-)/i; (ts:2040)
// const OPENCODE_NATIVE_K27_AUTHENTIC_RE = /(?:^|\/)kimi-k2\.7-code(?:$|-)/i; (ts:2041)
// DEFECT: regex — segment tests approximated: a match is a path segment
// (start or after '/') equal to / starting with "k3-", "kimi-k3-" resp.
// "kimi-k2.7-code" followed by end or '-'.
// ---------------------------------------------------------------------------
fn omni_segment_match(text_ptr: ptr, text_len: u64, seg1_ptr: ptr, seg1_len: u64, seg2_ptr: ptr, seg2_len: u64, use_seg2: bool) -> bool {
    // Try each segment start: 0 and every index after '/'.
    let start: u64 = 0;
    let scanning = true;
    while scanning {
        let remaining: u64 = text_len - start;
        let matched = false;
        if omni_str_starts_with(omni_padd(text_ptr, start), remaining, seg1_ptr, seg1_len) {
            let rest: u64 = remaining - seg1_len;
            if rest == 0 { matched = true; };
            if rest > 0 {
                let b: u8 = 0;
                PTR_BYTE_AT(b, text_ptr, start + seg1_len);
                if b == 45 { matched = true; };
            };
        };
        if !matched && use_seg2 && omni_str_starts_with(omni_padd(text_ptr, start), remaining, seg2_ptr, seg2_len) {
            let rest: u64 = remaining - seg2_len;
            if rest == 0 { matched = true; };
            if rest > 0 {
                let b: u8 = 0;
                PTR_BYTE_AT(b, text_ptr, start + seg2_len);
                if b == 45 { matched = true; };
            };
        };
        if matched { return true; };
        // Advance to the next segment start.
        let next: u64 = text_len;
        for i in start..text_len {
            let b: u8 = 0;
            PTR_BYTE_AT(b, text_ptr, i);
            if b == 47 {
                next = i + 1;
                break;
            };
        }
        if next == text_len && start != 0 { scanning = false; };
        if next == text_len && start == 0 { scanning = false; };
        start = next;
        if start >= text_len { scanning = false; };
    }
    return false;
}

// export function requiresAuthenticOpencodeReasoningContent(provider: unknown, model: unknown): boolean (ts:2043-2054)
// DEFECT: String(model ?? "").trim() / provider trim+lowercase —
// approximated by raw bytes.
fn requiresAuthenticOpencodeReasoningContent(provider_ptr: ptr, provider_len: u64, model_ptr: ptr, model_len: u64) -> bool {
    if omni_segment_match(model_ptr, model_len, STR_PTR("k3"), STR_LEN("k3"), STR_PTR("kimi-k3"), STR_LEN("kimi-k3"), true) { return true; };
    let provider_ok = false;
    if omni_str_eq(provider_ptr, provider_len, STR_PTR("moonshot"), STR_LEN("moonshot")) { provider_ok = true; };
    if omni_str_eq(provider_ptr, provider_len, STR_PTR("kimi"), STR_LEN("kimi")) { provider_ok = true; };
    if !provider_ok { return false; };
    return omni_segment_match(model_ptr, model_len, STR_PTR("kimi-k2.7-code"), STR_LEN("kimi-k2.7-code"), STR_PTR(""), 0, false);
}

// export function shouldInjectOpencodeReasoningContentPlaceholder(providerRequiresEcho: boolean, provider: unknown, model: string | undefined | null): boolean (ts:2056-2066)
fn shouldInjectOpencodeReasoningContentPlaceholder(providerRequiresEcho: bool, provider_ptr: ptr, provider_len: u64, has_model: bool, model_ptr: ptr, model_len: u64) -> bool {
    if !providerRequiresEcho { return false; };
    if requiresAuthenticOpencodeReasoningContent(provider_ptr, provider_len, model_ptr, model_len) { return false; };
    return isOpencodeThinkingMessageModel(has_model, model_ptr, model_len);
}

// Port of `resolvePlaceholderNames`: session own -> configured -> model-wide.
// export function resolveOpencodePlaceholderNames(store, provider, model, session, configured): readonly string[] (ts:2068-2079)
// Returns 0 + names in out (TS always returns a list, possibly configured).
fn resolveOpencodePlaceholderNames(store: &OpencodeObservedStore, provider_ptr: ptr, provider_len: u64, model_ptr: ptr, model_len: u64, has_session: bool, session_ptr: ptr, session_len: u64, configured: &StrList, out: &StrList) -> i32 {
    if has_session {
        if getObservedOpencodeToolNames(store, provider_ptr, provider_len, model_ptr, model_len, true, session_ptr, session_len, out) == 0 && out.count > 0 { return 0; };
    };
    if configured.count > 0 {
        out.len = configured.len;
        out.count = configured.count;
        let src_base: ptr = PTR_NULL();
        PTR_BYTE_ADD(src_base, &configured.bytes, 0);
        let out_base: ptr = PTR_NULL();
        PTR_BYTE_ADD(out_base, &out.bytes, 0);
        for i in 0..configured.len {
            let b: u8 = 0;
            PTR_BYTE_AT(b, src_base, i);
            let dst: ptr = PTR_NULL();
            PTR_BYTE_ADD(dst, out_base, i);
            PTR_WRITE_U8(dst, b);
        }
        return 0;
    };
    if getObservedOpencodeToolNames(store, provider_ptr, provider_len, model_ptr, model_len, false, session_ptr, 0, out) == 0 { return 0; };
    // return ... ?? configured
    out.len = configured.len;
    out.count = configured.count;
    let src_base2: ptr = PTR_NULL();
    PTR_BYTE_ADD(src_base2, &configured.bytes, 0);
    let out_base2: ptr = PTR_NULL();
    PTR_BYTE_ADD(out_base2, &out.bytes, 0);
    for i in 0..configured.len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, src_base2, i);
        let dst: ptr = PTR_NULL();
        PTR_BYTE_ADD(dst, out_base2, i);
        PTR_WRITE_U8(dst, b);
    }
    return 0;
}

// OpenCode's free DeepSeek V4 Flash endpoint accepts json_object but rejects
// json_schema response_format with HTTP 400. Preserve the schema as an
// instruction and downgrade only this route to json_object.
// export function applyOpencodeDeepSeekJsonSchemaFallback<T>(model: string, body: T, provider = "opencode"): T (ts:2081-2118)
// DEFECT: generic <T> — body is JsonText mutated in place.
// DEFECT: dynamic object — the response_format inspection, schema
// JSON.stringify(..., null, 2), system-message prompt append/insert and
// response_format replacement require JSON manipulation not implemented
// in this pass; gate conditions on model/provider are checked and the
// body is left unchanged otherwise.
fn applyOpencodeDeepSeekJsonSchemaFallback(model_ptr: ptr, model_len: u64, body: &JsonText, body_is_object: bool, provider_ptr: ptr, provider_len: u64) -> i32 {
    if !omni_str_eq(model_ptr, model_len, STR_PTR("deepseek-v4-flash-free"), STR_LEN("deepseek-v4-flash-free")) { return 0; };
    if !omni_str_eq(provider_ptr, provider_len, STR_PTR("opencode"), STR_LEN("opencode")) && !omni_str_eq(provider_ptr, provider_len, STR_PTR("opencode-zen"), STR_LEN("opencode-zen")) { return 0; };
    if !body_is_object { return 0; };
    return 0;
}

// ---------------------------------------------------------------------------
// Request-shape memo (omniRouteFree.ts:2120-2324)
// const OPENCODE_SHAPE_BARE_CLASSES_MAX = 64; (ts:2120)
// const opencodeBareShapeClasses = new Set<string>(); (ts:2121)
// const opencodeShapePausedUntil = new Map<string, number>(); (ts:2122)
// DEFECT: Set/Map module state — caller-owned struct with fixed-capacity
// parallel arrays (64 classes), insertion order preserved for the
// evict-oldest loops.
// DEFECT: WeakMap — opencodeForcedShape / opencodeInjectionContexts /
// opencodeContractAttempts are identity-keyed WeakMaps (ts:2174-2176);
// each is approximated by a single slot keyed by a caller-supplied u64
// origin handle.
// ---------------------------------------------------------------------------
struct OpencodeInjectionContext {
    // readonly shape: "tools" | "bare"
    shape_is_bare: bool,
    key_bytes: [u8; 1024],
    key_len: u64,
    // readonly probe: boolean
    probe: bool,
    // readonly replayNote: (verdict: OpencodeFreeTierOutcome) => void
    // DEFECT: closure — the callback cannot be stored; callers invoke
    // noteOpencodeFreeTierOutcome with the attempt captured in the
    // attempt slot (TS closes over { ...attempt, probe: false }).
    has_replayNote: bool,
}

struct OpencodeShapeState {
    bare_keys_bytes: [u8; 65536],
    bare_key_lens: [u64; 64],
    bare_key_offsets: [u64; 64],
    bare_count: u64,
    bare_used: u64,
    paused_keys_bytes: [u8; 65536],
    paused_key_lens: [u64; 64],
    paused_key_offsets: [u64; 64],
    paused_until: [u64; 64],
    paused_count: u64,
    paused_used: u64,
    // FIX: the three TS WeakMaps (opencodeForcedShape /
    // opencodeInjectionContexts / opencodeContractAttempts) are
    // sa_idmap handles now (0 = not yet created) — true
    // multi-entry identity tables, not single slots.
    forced_map: u64,
    injection_map: u64,
    attempt_map: u64,
    // _setOpencodeShapeClockForTests override (ts:1874-1877).
    has_clock_override: bool,
    clock_override_ms: u64,
}

// The shape-memo clock: opencodeShapeNow (ts:1874).
fn omni_shape_now(state: &OpencodeShapeState) -> u64 {
    if state.has_clock_override { return state.clock_override_ms; };
    return omni_now_ms();
}

fn omni_bare_index(state: &OpencodeShapeState, key_ptr: ptr, key_len: u64) -> i64 {
    for idx in 0..state.bare_count {
        let base: ptr = PTR_NULL();
        PTR_BYTE_ADD(base, &state.bare_keys_bytes, state.bare_key_offsets[idx]);
        if omni_str_eq(base, state.bare_key_lens[idx], key_ptr, key_len) { return idx as i64; };
    }
    return -1;
}

fn omni_paused_index(state: &OpencodeShapeState, key_ptr: ptr, key_len: u64) -> i64 {
    for idx in 0..state.paused_count {
        let base: ptr = PTR_NULL();
        PTR_BYTE_ADD(base, &state.paused_keys_bytes, state.paused_key_offsets[idx]);
        if omni_str_eq(base, state.paused_key_lens[idx], key_ptr, key_len) { return idx as i64; };
    }
    return -1;
}

// function opencodeShapeTextOf(content: unknown): string (ts:2124-2142)
// TS: string as-is; null/undefined -> ""; array -> join of string .text
// parts (when non-empty); else JSON.stringify(content) with String()
// fallback.
// DEFECT: dynamic object — array-part extraction and JSON.stringify are
// not implemented; only the string form is returned.
fn opencodeShapeTextOf(kind: u64, text_ptr: ptr, text_len: u64, out_ptr: ptr, out_len: &u64) -> i32 {
    if kind == 1 {
        for i in 0..text_len {
            let b: u8 = 0;
            PTR_BYTE_AT(b, text_ptr, i);
            let dst: ptr = PTR_NULL();
            PTR_BYTE_ADD(dst, out_ptr, i);
            PTR_WRITE_U8(dst, b);
        }
        *out_len = text_len;
        return 0;
    };
    *out_len = 0;
    return 0;
}

// Port of `shapeKeyOf`: provider|model|sha1(prompt).
// export function opencodeShapeKeyOf(provider: string, model: string, body: unknown): string (ts:2144-2157)
// TS prompt source: record.instructions, else the first system/developer
// message's content via opencodeShapeTextOf; digest = sha1 hex (full).
// DEFECT: dynamic object — instructions/messages extraction from the JSON
// body is not implemented; the prompt is taken as empty, so the digest is
// the sha1 of "" for every body in this pass.
// DEFECT: node:crypto — sha1 approximated (omni_hash_hex writes "0"*40).
fn opencodeShapeKeyOf(provider_ptr: ptr, provider_len: u64, model_ptr: ptr, model_len: u64, body: &JsonText, out_ptr: ptr, out_len: &u64) -> i32 {
    let n: u64 = 0;
    for i in 0..provider_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, provider_ptr, i);
        let dst: ptr = PTR_NULL();
        PTR_BYTE_ADD(dst, out_ptr, n);
        PTR_WRITE_U8(dst, b);
        n = n + 1;
    }
    let sep: ptr = PTR_NULL();
    PTR_BYTE_ADD(sep, out_ptr, n);
    PTR_WRITE_U8(sep, 124u8);
    n = n + 1;
    for i in 0..model_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, model_ptr, i);
        let dst: ptr = PTR_NULL();
        PTR_BYTE_ADD(dst, out_ptr, n);
        PTR_WRITE_U8(dst, b);
        n = n + 1;
    }
    let sep2: ptr = PTR_NULL();
    PTR_BYTE_ADD(sep2, out_ptr, n);
    PTR_WRITE_U8(sep2, 124u8);
    n = n + 1;
    let digest_len: u64 = 0;
    omni_hash_hex(STR_PTR("sha1"), STR_LEN("sha1"), STR_PTR(""), 0, omni_padd(out_ptr, n), &digest_len, 40);
    *out_len = n + digest_len;
    return 0;
}

// function opencodeIsShapePaused(state, key: string): boolean (ts:2159-2165)
// DEFECT: Map — expired entries are marked by zeroing the key length
// instead of Map.delete (slots are not compacted).
fn opencodeIsShapePaused(state: &OpencodeShapeState, key_ptr: ptr, key_len: u64) -> bool {
    let idx: i64 = omni_paused_index(state, key_ptr, key_len);
    if idx < 0 { return false; };
    let i: u64 = idx as u64;
    if state.paused_until[i] > omni_shape_now(state) { return true; };
    state.paused_key_lens[i] = 0;
    return false;
}

// function opencodeIsTrackable(value: unknown): value is object (ts:2177-2179)
// DEFECT: type predicate — boolean only.
fn opencodeIsTrackable(is_object: bool, is_null: bool) -> bool {
    return is_object && !is_null;
}

// function opencodePauseShape(state, key: string): void (ts:2180-2189)
// TS: delete + set(key, now + 60_000), evict oldest while size > 64.
// DEFECT: Map — eviction approximated by refusing new keys at capacity.
fn opencodePauseShape(state: &OpencodeShapeState, key_ptr: ptr, key_len: u64) -> i32 {
    let idx: i64 = omni_paused_index(state, key_ptr, key_len);
    let i: u64 = 0;
    if idx >= 0 {
        i = idx as u64;
    } else {
        if state.paused_count >= 64 { return 0; };
        i = state.paused_count;
        state.paused_key_offsets[i] = state.paused_used;
        state.paused_key_lens[i] = key_len;
        for j in 0..key_len {
            let b: u8 = 0;
            PTR_BYTE_AT(b, key_ptr, j);
            let dst: ptr = PTR_NULL();
            let base: ptr = PTR_NULL();
            PTR_BYTE_ADD(base, &state.paused_keys_bytes, state.paused_used);
            PTR_BYTE_ADD(dst, base, j);
            PTR_WRITE_U8(dst, b);
        }
        state.paused_used = state.paused_used + key_len;
        state.paused_count = state.paused_count + 1;
    };
    state.paused_until[i] = omni_shape_now(state) + 60000;
    return 0;
}

// function opencodeRememberBare(state, key: string): void (ts:2190-2198)
// TS: delete + add(key), evict oldest while size > 64.
// DEFECT: Set — eviction approximated by refusing new keys at capacity.
fn opencodeRememberBare(state: &OpencodeShapeState, key_ptr: ptr, key_len: u64) -> i32 {
    if omni_bare_index(state, key_ptr, key_len) >= 0 { return 0; };
    if state.bare_count >= 64 { return 0; };
    let i: u64 = state.bare_count;
    state.bare_key_offsets[i] = state.bare_used;
    state.bare_key_lens[i] = key_len;
    for j in 0..key_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, key_ptr, j);
        let dst: ptr = PTR_NULL();
        let base: ptr = PTR_NULL();
        PTR_BYTE_ADD(base, &state.bare_keys_bytes, state.bare_used);
        PTR_BYTE_ADD(dst, base, j);
        PTR_WRITE_U8(dst, b);
    }
    state.bare_used = state.bare_used + key_len;
    state.bare_count = state.bare_count + 1;
    return 0;
}

// Result of opencodePlanShape / prepareOpencodeFreeTierRequest planning.
struct OpencodeShapePlan {
    shape_is_bare: bool,
    probe: bool,
}

// Port of `planShape(origin,key)`: forced wins, else remembered bare (unless paused).
// export function opencodePlanShape(state, key: string, origin?): { shape: "tools" | "bare"; probe: boolean } (ts:2200-2208)
fn opencodePlanShape(state: &OpencodeShapeState, key_ptr: ptr, key_len: u64, has_origin: bool, origin_handle: u64, out: &OpencodeShapePlan) -> i32 {
    if has_origin && state.forced_map != 0 {
        let fv: u64 = 0;
        if sa_idmap_get_u64(state.forced_map, origin_handle, &fv) == 0 {
            out.shape_is_bare = fv != 0;
            out.probe = false;
            return 0;
        };
    };
    if omni_bare_index(state, key_ptr, key_len) >= 0 && !opencodeIsShapePaused(state, key_ptr, key_len) {
        out.shape_is_bare = true;
        out.probe = true;
        return 0;
    };
    out.shape_is_bare = false;
    out.probe = !opencodeIsShapePaused(state, key_ptr, key_len);
    return 0;
}

// Port of requestShape attempt store (WeakMap single slot, see header).
// export function opencodeRememberAttempt(state, origin: object, attempt: object): void (ts:2210-2212)
// DEFECT: WeakMap — single slot; storing a second origin evicts the first.
// DEFECT: generic attempt object — stored as OpencodeFreeTierAttempt.
fn opencodeRememberAttempt(state: &OpencodeShapeState, origin_handle: u64, attempt: &OpencodeFreeTierAttempt) -> i32 {
    state.attempt_map = omni_ensure_map(state.attempt_map);
    // blob: [plen u64][provider][mlen u64][model][has_session u8]
    // [slen u64][session][borrowed u8][has_probe u8][probe u8]
    // [names_len u64][names_count u64][names bytes]
    let blob: [u8; 66304] = [0u8; 66304];
    let bp: ptr = PTR_NULL();
    PTR_BYTE_ADD(bp, &blob, 0);
    let cur: u64 = 0;
    omni_put_u64(bp, cur, attempt.provider_len);
    cur = cur + 8;
    let pp: ptr = PTR_NULL();
    PTR_BYTE_ADD(pp, &attempt.provider_bytes, 0);
    omni_copy(bp, cur, pp, attempt.provider_len);
    cur = cur + attempt.provider_len;
    omni_put_u64(bp, cur, attempt.model_len);
    cur = cur + 8;
    let mp: ptr = PTR_NULL();
    PTR_BYTE_ADD(mp, &attempt.model_bytes, 0);
    omni_copy(bp, cur, mp, attempt.model_len);
    cur = cur + attempt.model_len;
    omni_put_u8(bp, cur, attempt.has_session);
    cur = cur + 1;
    omni_put_u64(bp, cur, attempt.session_len);
    cur = cur + 8;
    let sp: ptr = PTR_NULL();
    PTR_BYTE_ADD(sp, &attempt.session_bytes, 0);
    omni_copy(bp, cur, sp, attempt.session_len);
    cur = cur + attempt.session_len;
    omni_put_u8(bp, cur, attempt.borrowed);
    cur = cur + 1;
    omni_put_u8(bp, cur, attempt.has_probe);
    cur = cur + 1;
    omni_put_u8(bp, cur, attempt.probe);
    cur = cur + 1;
    omni_put_u64(bp, cur, attempt.clientToolNames.len);
    cur = cur + 8;
    omni_put_u64(bp, cur, attempt.clientToolNames.count);
    cur = cur + 8;
    let np: ptr = PTR_NULL();
    PTR_BYTE_ADD(np, &attempt.clientToolNames.bytes, 0);
    omni_copy(bp, cur, np, attempt.clientToolNames.len);
    cur = cur + attempt.clientToolNames.len;
    if state.attempt_map != 0 { sa_idmap_set(state.attempt_map, origin_handle, bp, cur); };
    return 0;
}

// export function opencodeRecallAttempt<T extends object>(state, origin: unknown): T | null (ts:2213-2215)
// DEFECT: generic <T> — returns the stored OpencodeFreeTierAttempt;
// 0 = found, -1 = TS null.
fn opencodeRecallAttempt(state: &OpencodeShapeState, origin_is_trackable: bool, origin_handle: u64, out: &OpencodeFreeTierAttempt) -> i32 {
    if !origin_is_trackable { return -1; };
    if state.attempt_map == 0 { return -1; };
    let blob: [u8; 66304] = [0u8; 66304];
    let bp: ptr = PTR_NULL();
    PTR_BYTE_ADD(bp, &blob, 0);
    let blen: u64 = 0;
    if sa_idmap_get(state.attempt_map, origin_handle, bp, 66304, &blen) != 0 { return -1; };
    let cur: u64 = 0;
    out.provider_len = omni_get_u64(bp, cur);
    cur = cur + 8;
    let pp: ptr = PTR_NULL();
    PTR_BYTE_ADD(pp, &out.provider_bytes, 0);
    let seg: ptr = PTR_NULL();
    PTR_BYTE_ADD(seg, bp, cur);
    omni_copy(pp, 0, seg, out.provider_len);
    cur = cur + out.provider_len;
    out.model_len = omni_get_u64(bp, cur);
    cur = cur + 8;
    let mp: ptr = PTR_NULL();
    PTR_BYTE_ADD(mp, &out.model_bytes, 0);
    PTR_BYTE_ADD(seg, bp, cur);
    omni_copy(mp, 0, seg, out.model_len);
    cur = cur + out.model_len;
    out.has_session = omni_get_u8(bp, cur);
    cur = cur + 1;
    out.session_len = omni_get_u64(bp, cur);
    cur = cur + 8;
    let sp: ptr = PTR_NULL();
    PTR_BYTE_ADD(sp, &out.session_bytes, 0);
    PTR_BYTE_ADD(seg, bp, cur);
    omni_copy(sp, 0, seg, out.session_len);
    cur = cur + out.session_len;
    out.borrowed = omni_get_u8(bp, cur);
    cur = cur + 1;
    out.has_probe = omni_get_u8(bp, cur);
    cur = cur + 1;
    out.probe = omni_get_u8(bp, cur);
    cur = cur + 1;
    out.clientToolNames.len = omni_get_u64(bp, cur);
    cur = cur + 8;
    out.clientToolNames.count = omni_get_u64(bp, cur);
    cur = cur + 8;
    let np: ptr = PTR_NULL();
    PTR_BYTE_ADD(np, &out.clientToolNames.bytes, 0);
    PTR_BYTE_ADD(seg, bp, cur);
    omni_copy(np, 0, seg, out.clientToolNames.len);
    return 0;
}

// export function opencodeForgetAttempt(state, origin: object): void (ts:2216-2218)
fn opencodeForgetAttempt(state: &OpencodeShapeState, origin_handle: u64) -> i32 {
    if state.attempt_map != 0 { sa_idmap_remove(state.attempt_map, origin_handle); };
    return 0;
}

// export function opencodeRecordInjection(state, origin: object, ctx: OpencodeInjectionContext): void (ts:2219-2221)
// DEFECT: WeakMap — single slot.
fn opencodeRecordInjection(state: &OpencodeShapeState, origin_handle: u64, ctx: &OpencodeInjectionContext) -> i32 {
    state.injection_map = omni_ensure_map(state.injection_map);
    // blob: [shape_is_bare u8][key_len u64][key bytes][probe u8][has_replayNote u8]
    let blob: [u8; 1040] = [0u8; 1040];
    let bp: ptr = PTR_NULL();
    PTR_BYTE_ADD(bp, &blob, 0);
    omni_put_u8(bp, 0, ctx.shape_is_bare);
    omni_put_u64(bp, 1, ctx.key_len);
    let kp: ptr = PTR_NULL();
    PTR_BYTE_ADD(kp, &ctx.key_bytes, 0);
    omni_copy(bp, 9, kp, ctx.key_len);
    let tail = 9 + ctx.key_len;
    omni_put_u8(bp, tail, ctx.probe);
    omni_put_u8(bp, tail + 1, ctx.has_replayNote);
    if state.injection_map != 0 { sa_idmap_set(state.injection_map, origin_handle, bp, tail + 2); };
    return 0;
}

// export function opencodeAttemptFor(state, origin: unknown): OpencodeFreeTierAttempt | null (ts:2222-2224)
// (Also re-exported as attemptForOpencode, ts:1866-1868.)
fn opencodeAttemptFor(state: &OpencodeShapeState, origin_is_trackable: bool, origin_handle: u64, out: &OpencodeFreeTierAttempt) -> i32 {
    return opencodeRecallAttempt(state, origin_is_trackable, origin_handle, out);
}

// export function attemptForOpencode(state, origin: unknown): OpencodeFreeTierAttempt | null (ts:1866-1868)
fn attemptForOpencode(state: &OpencodeShapeState, origin_is_trackable: bool, origin_handle: u64, out: &OpencodeFreeTierAttempt) -> i32 {
    return opencodeAttemptFor(state, origin_is_trackable, origin_handle, out);
}

