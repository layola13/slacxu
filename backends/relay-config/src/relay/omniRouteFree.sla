// export const EXPLICIT_FREE_MODELS = new Set([...]) (ts:2676-2686)
// DEFECT: Set<string> — membership as compares.
fn omni_explicit_free_models_contains(model_ptr: ptr, model_len: u64) -> bool {
    if omni_str_eq(model_ptr, model_len, STR_PTR("big-pickle"), STR_LEN("big-pickle")) { return true; };
    if omni_str_eq(model_ptr, model_len, STR_PTR("beam-free"), STR_LEN("beam-free")) { return true; };
    if omni_str_eq(model_ptr, model_len, STR_PTR("mimo-v2.6-flash-free"), STR_LEN("mimo-v2.6-flash-free")) { return true; };
    if omni_str_eq(model_ptr, model_len, STR_PTR("nemotron-3.5-super-vl-free"), STR_LEN("nemotron-3.5-super-vl-free")) { return true; };
    if omni_str_eq(model_ptr, model_len, STR_PTR("nemotron-3.5-lightning-free"), STR_LEN("nemotron-3.5-lightning-free")) { return true; };
    if omni_str_eq(model_ptr, model_len, STR_PTR("longcat-2.5-preview-free"), STR_LEN("longcat-2.5-preview-free")) { return true; };
    if omni_str_eq(model_ptr, model_len, STR_PTR("deepseek-v4.1-flash-free"), STR_LEN("deepseek-v4.1-flash-free")) { return true; };
    if omni_str_eq(model_ptr, model_len, STR_PTR("glm-5.3-flash-free"), STR_LEN("glm-5.3-flash-free")) { return true; };
    if omni_str_eq(model_ptr, model_len, STR_PTR("minimax-m3.1-flash-free"), STR_LEN("minimax-m3.1-flash-free")) { return true; };
    return false;
}

