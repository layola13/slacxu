// export function buildKernelBody(caller: unknown, model: string, identity: KernelIdentity, requestFormat?: string | null): Record<string, unknown> (ts:1333-1343)
fn buildKernelBody(caller: &JsonText, model_ptr: ptr, model_len: u64, identity: &KernelIdentity, has_format: bool, format_ptr: ptr, format_len: u64, out: &JsonText) -> i32 {
    let surface_buf: [u8; 16] = [0u8; 16];
    let surface_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(surface_ptr, &surface_buf, 0);
    let surface_len: u64 = 0;
    kernelSurfaceForRequest(model_ptr, model_len, has_format, format_ptr, format_len, surface_ptr, &surface_len);
    if omni_str_eq(surface_ptr, surface_len, STR_PTR("responses"), STR_LEN("responses")) {
        return buildKernelResponsesBody(caller, model_ptr, model_len, identity, out);
    };
    return buildKernelChatBody(caller, model_ptr, model_len, out);
}

// ---------------------------------------------------------------------------
// Effort tiers (omniRouteFree.ts:1345-1381)
// const OPENCODE_EFFORT_LEVELS = ["none", "low", "high", "max"] as const; (ts:1345)
// const OPENCODE_EFFORT_TIERS: Record<string, readonly string[]> = {...}; (ts:1352-1364)
// DEFECT: dynamic object — the tier table is a string-keyed record;
// approximated by a lookup function over the literal rows.
// ---------------------------------------------------------------------------
fn omni_effort_tier_contains(base_ptr: ptr, base_len: u64, level_ptr: ptr, level_len: u64) -> bool {
    // "deepseek-v4-pro" / "deepseek-v4-flash": none, low, high, max
    if omni_str_eq(base_ptr, base_len, STR_PTR("deepseek-v4-pro"), STR_LEN("deepseek-v4-pro")) || omni_str_eq(base_ptr, base_len, STR_PTR("deepseek-v4-flash"), STR_LEN("deepseek-v4-flash")) {
        if omni_str_eq(level_ptr, level_len, STR_PTR("none"), STR_LEN("none")) { return true; };
        if omni_str_eq(level_ptr, level_len, STR_PTR("low"), STR_LEN("low")) { return true; };
        if omni_str_eq(level_ptr, level_len, STR_PTR("high"), STR_LEN("high")) { return true; };
        if omni_str_eq(level_ptr, level_len, STR_PTR("max"), STR_LEN("max")) { return true; };
        return false;
    };
    // "glm-5.2" / "mimo-v2.5" / "qwen3.6-plus" / "qwen3.7-max" / "qwen3.7-plus": high, max
    if omni_str_eq(base_ptr, base_len, STR_PTR("glm-5.2"), STR_LEN("glm-5.2")) || omni_str_eq(base_ptr, base_len, STR_PTR("mimo-v2.5"), STR_LEN("mimo-v2.5")) || omni_str_eq(base_ptr, base_len, STR_PTR("qwen3.6-plus"), STR_LEN("qwen3.6-plus")) || omni_str_eq(base_ptr, base_len, STR_PTR("qwen3.7-max"), STR_LEN("qwen3.7-max")) || omni_str_eq(base_ptr, base_len, STR_PTR("qwen3.7-plus"), STR_LEN("qwen3.7-plus")) {
        if omni_str_eq(level_ptr, level_len, STR_PTR("high"), STR_LEN("high")) { return true; };
        if omni_str_eq(level_ptr, level_len, STR_PTR("max"), STR_LEN("max")) { return true; };
        return false;
    };
    // "grok-4.5": low, medium, high
    if omni_str_eq(base_ptr, base_len, STR_PTR("grok-4.5"), STR_LEN("grok-4.5")) {
        if omni_str_eq(level_ptr, level_len, STR_PTR("low"), STR_LEN("low")) { return true; };
        if omni_str_eq(level_ptr, level_len, STR_PTR("medium"), STR_LEN("medium")) { return true; };
        if omni_str_eq(level_ptr, level_len, STR_PTR("high"), STR_LEN("high")) { return true; };
        return false;
    };
    // "hy3": none, low, high
    if omni_str_eq(base_ptr, base_len, STR_PTR("hy3"), STR_LEN("hy3")) {
        if omni_str_eq(level_ptr, level_len, STR_PTR("none"), STR_LEN("none")) { return true; };
        if omni_str_eq(level_ptr, level_len, STR_PTR("low"), STR_LEN("low")) { return true; };
        if omni_str_eq(level_ptr, level_len, STR_PTR("high"), STR_LEN("high")) { return true; };
        return false;
    };
    // "kimi-k3": max
    if omni_str_eq(base_ptr, base_len, STR_PTR("kimi-k3"), STR_LEN("kimi-k3")) {
        return omni_str_eq(level_ptr, level_len, STR_PTR("max"), STR_LEN("max"));
    };
    // "muse-spark-1.2-contributor" / "muse-spark-1.3-contributor":
    // minimal, low, medium, high, xhigh
    if omni_str_eq(base_ptr, base_len, STR_PTR("muse-spark-1.2-contributor"), STR_LEN("muse-spark-1.2-contributor")) || omni_str_eq(base_ptr, base_len, STR_PTR("muse-spark-1.3-contributor"), STR_LEN("muse-spark-1.3-contributor")) {
        if omni_str_eq(level_ptr, level_len, STR_PTR("minimal"), STR_LEN("minimal")) { return true; };
        if omni_str_eq(level_ptr, level_len, STR_PTR("low"), STR_LEN("low")) { return true; };
        if omni_str_eq(level_ptr, level_len, STR_PTR("medium"), STR_LEN("medium")) { return true; };
        if omni_str_eq(level_ptr, level_len, STR_PTR("high"), STR_LEN("high")) { return true; };
        if omni_str_eq(level_ptr, level_len, STR_PTR("xhigh"), STR_LEN("xhigh")) { return true; };
        return false;
    };
    return false;
}

fn omni_effort_tier_base_known(base_ptr: ptr, base_len: u64) -> bool {
    if omni_str_eq(base_ptr, base_len, STR_PTR("deepseek-v4-pro"), STR_LEN("deepseek-v4-pro")) { return true; };
    if omni_str_eq(base_ptr, base_len, STR_PTR("deepseek-v4-flash"), STR_LEN("deepseek-v4-flash")) { return true; };
    if omni_str_eq(base_ptr, base_len, STR_PTR("glm-5.2"), STR_LEN("glm-5.2")) { return true; };
    if omni_str_eq(base_ptr, base_len, STR_PTR("mimo-v2.5"), STR_LEN("mimo-v2.5")) { return true; };
    if omni_str_eq(base_ptr, base_len, STR_PTR("grok-4.5"), STR_LEN("grok-4.5")) { return true; };
    if omni_str_eq(base_ptr, base_len, STR_PTR("hy3"), STR_LEN("hy3")) { return true; };
    if omni_str_eq(base_ptr, base_len, STR_PTR("kimi-k3"), STR_LEN("kimi-k3")) { return true; };
    if omni_str_eq(base_ptr, base_len, STR_PTR("qwen3.6-plus"), STR_LEN("qwen3.6-plus")) { return true; };
    if omni_str_eq(base_ptr, base_len, STR_PTR("qwen3.7-max"), STR_LEN("qwen3.7-max")) { return true; };
    if omni_str_eq(base_ptr, base_len, STR_PTR("qwen3.7-plus"), STR_LEN("qwen3.7-plus")) { return true; };
    if omni_str_eq(base_ptr, base_len, STR_PTR("muse-spark-1.2-contributor"), STR_LEN("muse-spark-1.2-contributor")) { return true; };
    if omni_str_eq(base_ptr, base_len, STR_PTR("muse-spark-1.3-contributor"), STR_LEN("muse-spark-1.3-contributor")) { return true; };
    return false;
}

// Parse a model string with an effort-level suffix.
// export function parseOpencodeEffortLevel(model: string): { baseModel: string; effort: string } | null (ts:1366-1381)
// Returns 0 + base/effort outs, -1 for TS null.
// TS iterates Object.entries(OPENCODE_EFFORT_TIERS) in insertion order and
// exact-matches `${baseModel}-${level}`; approximated by trying every
// '-' split point (longest base first approximates the table order for
// these rows, whose bases never end in a level word).
fn parseOpencodeEffortLevel(model_ptr: ptr, model_len: u64, base_out_ptr: ptr, base_out_len: &u64, effort_out_ptr: ptr, effort_out_len: &u64) -> i32 {
    *base_out_len = 0;
    *effort_out_len = 0;
    if model_len == 0 { return -1; };
    // Walk split points from the last '-' backwards is wrong for bases
    // containing '-' (all of them do); instead try each '-' position and
    // accept the first whose base is a known tier base and whose suffix
    // is one of that base's levels. TS checks whole-string equality per
    // (base, level) pair, which this reproduces.
    for split in 0..model_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, model_ptr, split);
        if b == 45 {
            let base_len: u64 = split;
            let level_ptr: ptr = omni_padd(model_ptr, split + 1);
            let level_len: u64 = model_len - split - 1;
            if level_len > 0 && omni_effort_tier_base_known(model_ptr, base_len) && omni_effort_tier_contains(model_ptr, base_len, level_ptr, level_len) {
                for i in 0..base_len {
                    let c: u8 = 0;
                    PTR_BYTE_AT(c, model_ptr, i);
                    let dst: ptr = PTR_NULL();
                    PTR_BYTE_ADD(dst, base_out_ptr, i);
                    PTR_WRITE_U8(dst, c);
                }
                *base_out_len = base_len;
                for i in 0..level_len {
                    let c: u8 = 0;
                    PTR_BYTE_AT(c, level_ptr, i);
                    let dst: ptr = PTR_NULL();
                    PTR_BYTE_ADD(dst, effort_out_ptr, i);
                    PTR_WRITE_U8(dst, c);
                }
                *effort_out_len = level_len;
                return 0;
            };
        };
    }
    return -1;
}

// ---------------------------------------------------------------------------
// Responses input sanitizing (omniRouteFree.ts:1383-1611)
// const OPENCODE_RESP_ITEM_ID_PREFIX_BY_TYPE: Record<string, string> =
//   { function_call: "fc_", message: "msg_", reasoning: "rs_" }; (ts:1383-1387)
// const OPENCODE_SERVER_ITEM_ID_PATTERN = /^(fc|msg|rs|resp)_/; (ts:1388)
// const OPENCODE_FUNCTION_NAME_VALID_RE = /^[a-zA-Z0-9_-]{1,128}$/; (ts:1389)
// const OPENCODE_FUNCTION_NAME_SANITIZE_RE = /[^a-zA-Z0-9_-]/g; (ts:1390)
// DEFECT: dynamic object — the prefix table is a string-keyed record;
// approximated by the lookup function below.
// DEFECT: regex — patterns kept as text; the sanitize/valid helpers below
// implement the character classes manually.
// ---------------------------------------------------------------------------
fn omni_resp_item_id_prefix_for_type(type_ptr: ptr, type_len: u64, out_ptr: ptr, out_len: &u64) -> bool {
    let p = "";
    if omni_str_eq(type_ptr, type_len, STR_PTR("function_call"), STR_LEN("function_call")) {
        p = "fc_";
    } else {
        if omni_str_eq(type_ptr, type_len, STR_PTR("message"), STR_LEN("message")) {
            p = "msg_";
        } else {
            if omni_str_eq(type_ptr, type_len, STR_PTR("reasoning"), STR_LEN("reasoning")) {
                p = "rs_";
            } else {
                *out_len = 0;
                return false;
            };
        };
    };
    for i in 0..STR_LEN(p) {
        let b: u8 = 0;
        let src: ptr = PTR_NULL();
        PTR_BYTE_ADD(src, STR_PTR(p), i);
        PTR_BYTE_AT(b, src, 0);
        let dst: ptr = PTR_NULL();
        PTR_BYTE_ADD(dst, out_ptr, i);
        PTR_WRITE_U8(dst, b);
    }
    *out_len = STR_LEN(p);
    return true;
}

