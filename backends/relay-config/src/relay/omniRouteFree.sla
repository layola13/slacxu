// DEFECT: overloads — the TS signature overloads three positional
// parameters (string[] | ChannelGroupConfig[] | options object |
// undefined); SLA has no union parameters, so the caller passes a kind
// tag per argument (0 = undefined, 1 = models, 2 = groups, 3 = options)
// plus the corresponding value slots in BuildAllFreeGroupsArgs.
// DEFECT: dynamic object — ChannelGroupConfig[] (existing groups and the
// return value) is approximated by per-id slots: this function only ever
// looks up "kilocode" / "cline-free" / "freebuff" / "d2api" and returns
// groups in the fixed build order kilo -> cline -> freebuff -> d2api.
// ---------------------------------------------------------------------------
struct BuildAllFreeGroupsOptions {
    has_hasClineCredentials: bool,
    hasClineCredentials: bool,
    has_hasFreebuffCredentials: bool,
    hasFreebuffCredentials: bool,
    has_d2apiModels: bool,
