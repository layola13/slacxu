// export function kernelModelId(model: string): string (ts:699-702)
fn kernelModelId(model_ptr: ptr, model_len: u64, out_ptr: ptr, out_len: &u64) -> i32 {
    return stripOpencodeModelPrefix(true, model_ptr, model_len, out_ptr, out_len);
}

// export function kernelSurfaceFor(model: string): OpencodeKernelSurface (ts:704-706)
fn kernelSurfaceFor(model_ptr: ptr, model_len: u64, out_ptr: ptr, out_len: &u64) -> i32 {
    let id_buf: [u8; 512] = [0u8; 512];
    let id_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(id_ptr, &id_buf, 0);
    let id_len: u64 = 0;
    kernelModelId(model_ptr, model_len, id_ptr, &id_len);
    let result = "chat";
    if omni_muse_spark_pattern_test(id_ptr, id_len) { result = "responses"; };
    for i in 0..STR_LEN(result) {
        let b: u8 = 0;
        let src: ptr = PTR_NULL();
        PTR_BYTE_ADD(src, STR_PTR(result), i);
        PTR_BYTE_AT(b, src, 0);
        let dst: ptr = PTR_NULL();
        PTR_BYTE_ADD(dst, out_ptr, i);
        PTR_WRITE_U8(dst, b);
    }
    *out_len = STR_LEN(result);
    return 0;
}

// export function kernelSurfaceForRequest(model: string, requestFormat?: string | null): OpencodeKernelSurface (ts:708-722)
fn kernelSurfaceForRequest(model_ptr: ptr, model_len: u64, has_format: bool, format_ptr: ptr, format_len: u64, out_ptr: ptr, out_len: &u64) -> i32 {
    if has_format {
        if omni_str_eq(format_ptr, format_len, STR_PTR("openai-responses"), STR_LEN("openai-responses")) || omni_str_eq(format_ptr, format_len, STR_PTR("openai-response"), STR_LEN("openai-response")) {
            let result = "responses";
            for i in 0..STR_LEN(result) {
                let b: u8 = 0;
                let src: ptr = PTR_NULL();
                PTR_BYTE_ADD(src, STR_PTR(result), i);
                PTR_BYTE_AT(b, src, 0);
                let dst: ptr = PTR_NULL();
                PTR_BYTE_ADD(dst, out_ptr, i);
                PTR_WRITE_U8(dst, b);
            }
            *out_len = STR_LEN(result);
            return 0;
        };
    };
    return kernelSurfaceFor(model_ptr, model_len, out_ptr, out_len);
}

// export function kernelUrlForSurface(surface: OpencodeKernelSurface): string (ts:724-727)
// `${kernelBaseUrl()}${surface === "responses" ? "/responses" : "/chat/completions"}`
fn kernelUrlForSurface(surface_ptr: ptr, surface_len: u64, out_ptr: ptr, out_len: &u64) -> i32 {
    let n: u64 = 0;
    kernelBaseUrl(out_ptr, &n);
    let suffix = "/chat/completions";
    if omni_str_eq(surface_ptr, surface_len, STR_PTR("responses"), STR_LEN("responses")) {
        suffix = "/responses";
    };
    for i in 0..STR_LEN(suffix) {
        let b: u8 = 0;
        let src: ptr = PTR_NULL();
        PTR_BYTE_ADD(src, STR_PTR(suffix), i);
        PTR_BYTE_AT(b, src, 0);
        let dst: ptr = PTR_NULL();
        PTR_BYTE_ADD(dst, out_ptr, n);
        PTR_WRITE_U8(dst, b);
        n = n + 1;
    }
    *out_len = n;
    return 0;
}

// export function kernelUrlFor(model: string): string (ts:729-731)
fn kernelUrlFor(model_ptr: ptr, model_len: u64, out_ptr: ptr, out_len: &u64) -> i32 {
    let surface_buf: [u8; 16] = [0u8; 16];
    let surface_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(surface_ptr, &surface_buf, 0);
    let surface_len: u64 = 0;
    kernelSurfaceFor(model_ptr, model_len, surface_ptr, &surface_len);
    return kernelUrlForSurface(surface_ptr, surface_len, out_ptr, out_len);
}

// export function shouldUseKernelSend(provider: string | null | undefined, model: string | null | undefined): boolean (ts:733-738)
// DEFECT: provider.toLowerCase() — case folding not applied in this pass;
// the set compare is case-sensitive (TS lowercases first).
fn shouldUseKernelSend(has_provider: bool, provider_ptr: ptr, provider_len: u64, has_model: bool, model_ptr: ptr, model_len: u64) -> bool {
    if !isKernelSendEnabled() { return false; };
    if !has_provider { return false; };
    if !omni_kernel_providers_contains(provider_ptr, provider_len) { return false; };
    if !has_model { return false; };
    if model_len == 0 { return false; };
    return !isPremiumOpencodeModel(model_ptr, model_len, provider_ptr, provider_len);
}

// ---------------------------------------------------------------------------
// Kernel id generation (omniRouteFree.ts:740-793)
// const OPENCODE_KERNEL_BASE62 = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"; (ts:740)
// const OPENCODE_KERNEL_ID_SUFFIX_LENGTH = 14; (ts:741)
// let kernelLastTimestamp = 0; let kernelIdCounter = 0; (ts:742-743)
// DEFECT: module-level mutable state — kept in a caller-owned struct.
// ---------------------------------------------------------------------------
struct KernelIdState {
    last_timestamp: u64,
    counter: u64,
}

// function kernelCreateIdentifier(state, descending: boolean, timestamp: number = Date.now()): string (ts:746-762)
// TS: current = BigInt(timestamp) * 0x1000n + BigInt(counter);
// value = descending ? ~current : current; 6 bytes big-endian hex of
// (value >> (40 - 8*i)) & 0xff, then 14 base62 chars from randomBytes(14).
// DEFECT: BigInt — 64-bit arithmetic used; the descending ~current makes
// the top bytes 0xff-heavy exactly as in TS, but shifts/masks are done on
// u64 instead of bigint (equivalent for the 48-bit window extracted).
// DEFECT: node:crypto — randomBytes approximated (omni_random_bytes).
fn kernelCreateIdentifier(state: &KernelIdState, descending: bool, timestamp: u64, out_ptr: ptr, out_len: &u64) -> i32 {
    if timestamp != state.last_timestamp {
        state.last_timestamp = timestamp;
        state.counter = 0;
    };
    state.counter = state.counter + 1;
    let current: u64 = timestamp * 4096 + state.counter;
    let value: u64 = current;
    if descending { value = 0 - current - 1; };
    // ~current on u64 == -current-1; matches BigInt ~x for the low 48 bits read below.
    let hexdigits = "0123456789abcdef";
    let pos: u64 = 0;
    for index in 0..6 {
        let shift: u64 = 40 - 8 * index;
        let byte_val: u64 = (value >> shift) & 255;
        let hi: u8 = 0;
        let lo: u8 = 0;
        let hp: ptr = PTR_NULL();
        let lp: ptr = PTR_NULL();
        PTR_BYTE_ADD(hp, STR_PTR(hexdigits), byte_val >> 4);
        PTR_BYTE_ADD(lp, STR_PTR(hexdigits), byte_val & 15);
        PTR_BYTE_AT(hi, hp, 0);
        PTR_BYTE_AT(lo, lp, 0);
        let d1: ptr = PTR_NULL();
        let d2: ptr = PTR_NULL();
        PTR_BYTE_ADD(d1, out_ptr, pos);
        PTR_BYTE_ADD(d2, out_ptr, pos + 1);
        PTR_WRITE_U8(d1, hi);
        PTR_WRITE_U8(d2, lo);
        pos = pos + 2;
    }
    let rand: [u8; 14] = [0u8; 14];
    let rand_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(rand_ptr, &rand, 0);
    omni_random_bytes(rand_ptr, 14);
    let suffix_len: u64 = 0;
    base62FromBytes(rand_ptr, 14, 14, omni_padd(out_ptr, pos), &suffix_len);
    *out_len = pos + suffix_len;
    return 0;
}

// export function kernelSessionId(state): string (ts:764-766)
// TS: `ses_${kernelCreateIdentifier(true)}` with Date.now() default.
// DEFECT: Date.now() — timestamp comes from omni_now_ms() (always 0 here).
fn kernelSessionId(state: &KernelIdState, out_ptr: ptr, out_len: &u64) -> i32 {
    let n: u64 = 0;
    let prefix = "ses_";
    for i in 0..STR_LEN(prefix) {
        let b: u8 = 0;
        let src: ptr = PTR_NULL();
        PTR_BYTE_ADD(src, STR_PTR(prefix), i);
        PTR_BYTE_AT(b, src, 0);
        let dst: ptr = PTR_NULL();
        PTR_BYTE_ADD(dst, out_ptr, n);
        PTR_WRITE_U8(dst, b);
        n = n + 1;
    }
    let id_len: u64 = 0;
    kernelCreateIdentifier(state, true, omni_now_ms(), omni_padd(out_ptr, n), &id_len);
    *out_len = n + id_len;
    return 0;
}

// export function kernelRequestId(state): string (ts:768-770)
fn kernelRequestId(state: &KernelIdState, out_ptr: ptr, out_len: &u64) -> i32 {
    let n: u64 = 0;
    let prefix = "msg_";
    for i in 0..STR_LEN(prefix) {
        let b: u8 = 0;
        let src: ptr = PTR_NULL();
        PTR_BYTE_ADD(src, STR_PTR(prefix), i);
        PTR_BYTE_AT(b, src, 0);
        let dst: ptr = PTR_NULL();
        PTR_BYTE_ADD(dst, out_ptr, n);
        PTR_WRITE_U8(dst, b);
        n = n + 1;
    }
    let id_len: u64 = 0;
    kernelCreateIdentifier(state, false, omni_now_ms(), omni_padd(out_ptr, n), &id_len);
    *out_len = n + id_len;
    return 0;
}

// export interface KernelIdentity { readonly session: string; readonly request: string; } (ts:772-775)
struct KernelIdentity {
    session_bytes: [u8; 64],
    session_len: u64,
    request_bytes: [u8; 64],
    request_len: u64,
}

// export function kernelIdentity(state, session?: string): KernelIdentity (ts:777-779)
fn kernelIdentity(state: &KernelIdState, has_session: bool, session_ptr: ptr, session_len: u64, out: &KernelIdentity) -> i32 {
    let s_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(s_ptr, &out.session_bytes, 0);
    if has_session {
        for i in 0..session_len {
            let b: u8 = 0;
            PTR_BYTE_AT(b, session_ptr, i);
            let dst: ptr = PTR_NULL();
            PTR_BYTE_ADD(dst, s_ptr, i);
            PTR_WRITE_U8(dst, b);
        }
        out.session_len = session_len;
    } else {
        let n: u64 = 0;
        kernelSessionId(state, s_ptr, &n);
        out.session_len = n;
    };
    let r_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(r_ptr, &out.request_bytes, 0);
    let rn: u64 = 0;
    kernelRequestId(state, r_ptr, &rn);
    out.request_len = rn;
    return 0;
}

// const kernelIdentityByOrigin = new WeakMap<object, KernelIdentity>(); (ts:781)
// FIX: backed by sa_idmap (identity.sai) — true multi-entry
// identity table; the single-slot memo degradation is removed.
struct KernelIdentityMemo {
    // FIX: sa_idmap handle (0 = not yet created); values are
    // 144-byte KernelIdentity blobs (see kernelIdentityFor).
    idmap: u64,
}

// export function kernelIdentityFor(state, memo, origin: unknown, sessionHint?: string): KernelIdentity (ts:783-793)
// DEFECT: WeakMap — with the single-slot memo, alternating origins thrash
// the slot and regenerate identities (TS keeps one per origin object).
// DEFECT: object identity — the origin is passed as an opaque u64 handle
// supplied by the caller.
fn kernelIdentityFor(state: &KernelIdState, memo: &KernelIdentityMemo, origin_is_object: bool, origin_handle: u64, has_hint: bool, hint_ptr: ptr, hint_len: u64, out: &KernelIdentity) -> i32 {
    if origin_is_object {
        memo.idmap = omni_ensure_map(memo.idmap);
        // blob layout: [session_len u64][session 64][request_len u64][request 64]
        let blob: [u8; 144] = [0u8; 144];
        let bp: ptr = PTR_NULL();
        PTR_BYTE_ADD(bp, &blob, 0);
        let blen: u64 = 0;
        if memo.idmap != 0 && sa_idmap_get(memo.idmap, origin_handle, bp, 144, &blen) == 0 && blen == 144 {
            out.session_len = omni_get_u64(bp, 0);
            let sp: ptr = PTR_NULL();
            PTR_BYTE_ADD(sp, &out.session_bytes, 0);
            let srcp: ptr = PTR_NULL();
            PTR_BYTE_ADD(srcp, bp, 8);
            omni_copy(sp, 0, srcp, out.session_len);
            out.request_len = omni_get_u64(bp, 72);
            let rp: ptr = PTR_NULL();
            PTR_BYTE_ADD(rp, &out.request_bytes, 0);
            let rsrc: ptr = PTR_NULL();
            PTR_BYTE_ADD(rsrc, bp, 80);
            omni_copy(rp, 0, rsrc, out.request_len);
            return 0;
        };
        kernelIdentity(state, has_hint, hint_ptr, hint_len, out);
        omni_put_u64(bp, 0, out.session_len);
        let sp2: ptr = PTR_NULL();
        PTR_BYTE_ADD(sp2, &out.session_bytes, 0);
        omni_copy(bp, 8, sp2, out.session_len);
        omni_put_u64(bp, 72, out.request_len);
        let rp2: ptr = PTR_NULL();
        PTR_BYTE_ADD(rp2, &out.request_bytes, 0);
        omni_copy(bp, 80, rp2, out.request_len);
        if memo.idmap != 0 { sa_idmap_set(memo.idmap, origin_handle, bp, 144); };
        return 0;
    };
    return kernelIdentity(state, has_hint, hint_ptr, hint_len, out);
}

// export function buildKernelHeaders(surface: OpencodeKernelSurface, identity: KernelIdentity): Record<string, string> (ts:795-814)
// TS builds Authorization/Content-Type/User-Agent/x-opencode-client/
// x-opencode-project/x-opencode-request/x-opencode-session/
// x-opencode-session-id, then deletes any header whose key or value
// contains "omniroute" (zenStripTraceHeaders).
// DEFECT: dynamic object — HeaderMap writes are stubs in this pass
// (omni_headers_set), so the resulting map stays empty; the header set and
// the omniroute strip rule are recorded here for the fix phase.
fn buildKernelHeaders(surface_ptr: ptr, surface_len: u64, identity: &KernelIdentity, out: &HeaderMap) -> i32 {
    let key_buf: [u8; 512] = [0u8; 512];
    let key_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(key_ptr, &key_buf, 0);
    let key_len: u64 = 0;
    kernelApiKey(key_ptr, &key_len);
    // Authorization: `Bearer ${kernelApiKey()}`
    let auth_buf: [u8; 576] = [0u8; 576];
    let auth_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(auth_ptr, &auth_buf, 0);
    let auth_len: u64 = 0;
    let bearer = "Bearer ";
    for i in 0..STR_LEN(bearer) {
        let b: u8 = 0;
        let src: ptr = PTR_NULL();
        PTR_BYTE_ADD(src, STR_PTR(bearer), i);
        PTR_BYTE_AT(b, src, 0);
        let dst: ptr = PTR_NULL();
        PTR_BYTE_ADD(dst, auth_ptr, auth_len);
        PTR_WRITE_U8(dst, b);
        auth_len = auth_len + 1;
    }
    for i in 0..key_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, key_ptr, i);
        let dst: ptr = PTR_NULL();
        PTR_BYTE_ADD(dst, auth_ptr, auth_len);
        PTR_WRITE_U8(dst, b);
        auth_len = auth_len + 1;
    }
    omni_headers_set(out, STR_PTR("Authorization"), STR_LEN("Authorization"), auth_ptr, auth_len);
    omni_headers_set(out, STR_PTR("Content-Type"), STR_LEN("Content-Type"), STR_PTR("application/json"), STR_LEN("application/json"));
    let ua_buf: [u8; 256] = [0u8; 256];
    let ua_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(ua_ptr, &ua_buf, 0);
    let ua_len: u64 = 0;
    kernelUserAgent(surface_ptr, surface_len, ua_ptr, &ua_len);
    omni_headers_set(out, STR_PTR("User-Agent"), STR_LEN("User-Agent"), ua_ptr, ua_len);
    omni_headers_set(out, STR_PTR("x-opencode-client"), STR_LEN("x-opencode-client"), STR_PTR("cli"), STR_LEN("cli"));
    omni_headers_set(out, STR_PTR("x-opencode-project"), STR_LEN("x-opencode-project"), STR_PTR("global"), STR_LEN("global"));
    let req_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(req_ptr, &identity.request_bytes, 0);
    omni_headers_set(out, STR_PTR("x-opencode-request"), STR_LEN("x-opencode-request"), req_ptr, identity.request_len);
    let ses_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(ses_ptr, &identity.session_bytes, 0);
    omni_headers_set(out, STR_PTR("x-opencode-session"), STR_LEN("x-opencode-session"), ses_ptr, identity.session_len);
    omni_headers_set(out, STR_PTR("x-opencode-session-id"), STR_LEN("x-opencode-session-id"), ses_ptr, identity.session_len);
    // Strip rule: no relay-identifying header/value may reach upstream —
    // none of the keys/values above contain "omniroute", so no deletions.
    return 0;
}

