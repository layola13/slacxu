fn omni_observed_tool_name_valid(name_ptr: ptr, name_len: u64) -> bool {
    if name_len == 0 || name_len > 64 { return false; };
    let first: u8 = 0;
    PTR_BYTE_AT(first, name_ptr, 0);
    let first_ok = false;
    if first >= 65 && first <= 90 { first_ok = true; };
    if first >= 97 && first <= 122 { first_ok = true; };
    if first == 95 { first_ok = true; };
    if !first_ok { return false; };
    for i in 1..name_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, name_ptr, i);
        let ok = false;
        if b >= 65 && b <= 90 { ok = true; };
        if b >= 97 && b <= 122 { ok = true; };
        if b >= 48 && b <= 57 { ok = true; };
        if b == 95 || b == 45 { ok = true; };
        if !ok { return false; };
    }
    return true;
}

