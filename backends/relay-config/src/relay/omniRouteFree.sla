// export function buildKiloCodeGroup(models: string[]): ChannelGroupConfig (ts:2961-2979)
fn buildKiloCodeGroup(models: &StrList, out: &ChannelGroupConfig) -> i32 {
    omni_fill_group_common(out, STR_PTR("kilocode"), STR_PTR("KiloCode"), STR_PTR("https://api.kilo.ai/api/openrouter"), STR_PTR("KiloCode managed free models"), STR_PTR("none"), STR_PTR("openai-response"));
    omni_strlist_dedupe(models, &out.models);
    out.keys.len = 0;
    out.keys.count = 0;
    return 0;
}

// 4. 新增 cline-free 分组 (Cline 独立分组，使用 openai 协议 + Bearer Token)
// export function buildClineFreeGroup(models: string[], apiKey = ""): ChannelGroupConfig (ts:2981-3000)
fn buildClineFreeGroup(models: &StrList, apiKey_ptr: ptr, apiKey_len: u64, out: &ChannelGroupConfig) -> i32 {
    omni_fill_group_common(out, STR_PTR("cline-free"), STR_PTR("ClineFree"), STR_PTR("https://api.cline.bot/api/v1"), STR_PTR("Cline managed promotional free models"), STR_PTR("bearer"), STR_PTR("openai"));
    omni_strlist_dedupe(models, &out.models);
    out.keys.len = 0;
    out.keys.count = 0;
    if apiKey_len > 0 {
        let keys_base: ptr = PTR_NULL();
        PTR_BYTE_ADD(keys_base, &out.keys.bytes, 0);
        out.keys.len = omni_fill_field(keys_base, apiKey_ptr, apiKey_len);
        out.keys.count = 1;
    };
    return 0;
}

// 5. 新增 freebuff 分组 (Freebuff 独立分组，使用 openai 协议 + Bearer Token)
// export function buildFreebuffGroup(models: string[], apiKey = ""): ChannelGroupConfig (ts:3002-3020)
// TS: baseUrl = FREEBUFF_BASE_URL (imported from freebuffSession; the
// literal below is its value, also exposed as the FREEBUFF_BASE_URL const
// in freebuffSession.sla); models falls back to
// [...DEFAULT_FREEBUFF_MODELS] when the deduped list is empty.
fn buildFreebuffGroup(models: &StrList, apiKey_ptr: ptr, apiKey_len: u64, out: &ChannelGroupConfig) -> i32 {
    omni_fill_group_common(out, STR_PTR("freebuff"), STR_PTR("Freebuff"), STR_PTR("https://www.codebuff.com/api/v1"), STR_PTR("Freebuff managed promotional free models"), STR_PTR("bearer"), STR_PTR("openai"));
    omni_strlist_dedupe(models, &out.models);
    if out.models.count == 0 {
        // [...DEFAULT_FREEBUFF_MODELS] (freebuffSession.ts:35-43)
        let defaults = "z-ai/glm-5.3-flash\nmimo/mimo-v2.5\ndeepseek/deepseek-v4-flash\nopenai/gpt-5.6-luna\nopenai/gpt-5.6-luna-es\nminimax/minimax-m3\nupstage/solar-pro-4";
        let base: ptr = PTR_NULL();
        PTR_BYTE_ADD(base, &out.models.bytes, 0);
        out.models.len = omni_fill_field(base, STR_PTR(defaults), STR_LEN(defaults));
        out.models.count = 7;
    };
    out.keys.len = 0;
    out.keys.count = 0;
    if apiKey_len > 0 {
        let keys_base: ptr = PTR_NULL();
        PTR_BYTE_ADD(keys_base, &out.keys.bytes, 0);
        out.keys.len = omni_fill_field(keys_base, apiKey_ptr, apiKey_len);
        out.keys.count = 1;
    };
    return 0;
}

// 6. 新增 d2api 分组 (自托管 DuckDuckGo 免费后端，OpenAI 兼容协议)
// export const D2API_BASE_URL = "http://127.0.0.1:44090"; (ts:3024)
