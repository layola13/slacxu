// DEFECT: dynamic object — walking the tools JSON array is not
// implemented in this pass; `out` is left empty.
fn opencodeClientToolNamesOf(body: &JsonText, body_is_object: bool, out: &StrList) -> i32 {
    out.len = 0;
    out.count = 0;
    if !body_is_object { return 0; };
    return 0;
}

// const OPENCODE_PLACEHOLDER_TOOL_DESCRIPTION =
