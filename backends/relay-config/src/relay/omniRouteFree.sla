// function kernelOutputEmpty(output: unknown): boolean (ts:959-965)
// TS: null/undefined -> true; string -> trim() === ""; array -> length 0;
// else false. Caller supplies the decoded kind.
// DEFECT: dynamic object — kind dispatch done by the caller.
fn kernelOutputEmpty(kind: u64, text_ptr: ptr, text_len: u64, array_len: u64) -> bool {
    if kind == 0 { return true; };
    if kind == 1 {
        for i in 0..text_len {
            let b: u8 = 0;
            PTR_BYTE_AT(b, text_ptr, i);
            if b != 32 { return false; };
        }
        return true;
    };
    if kind == 2 { return array_len == 0; };
    return false;
}

// Result of repairKernelChatToolPairing (TS returns
// { messages, synthesized, orphaned, strippedEmptyCalls }).
struct KernelPairingResult {
    messages_json: JsonText,
    synthesized: u64,
    orphaned: u64,
    strippedEmptyCalls: u64,
}

// Last-mile repair for strict chat upstreams: dangling assistant
// tool_calls get a neutral synthetic `tool` result per missing id, orphan
// `tool` results are demoted to `user` messages, empty tool_calls arrays
// are stripped.
// export function repairKernelChatToolPairing(messages: unknown[]): {...} (ts:967-1045)
// DEFECT: dynamic object — the algorithm walks message records with a
// Map<string, number> of pending call ids; JSON array/record manipulation
// is not implemented in this pass, so the input is copied through with
// zero counters (TS returns the input unchanged when it is not an array;
// here that is the behavior for every input).
fn repairKernelChatToolPairing(messages_json: &JsonText, messages_is_array: bool, out: &KernelPairingResult) -> i32 {
    out.synthesized = 0;
    out.orphaned = 0;
    out.strippedEmptyCalls = 0;
    out.messages_json.len = messages_json.len;
    for i in 0..messages_json.len {
        let b: u8 = 0;
        let src: ptr = PTR_NULL();
        PTR_BYTE_ADD(src, &messages_json.bytes, i);
        PTR_BYTE_AT(b, src, 0);
        let dst: ptr = PTR_NULL();
        let base: ptr = PTR_NULL();
        PTR_BYTE_ADD(base, &out.messages_json.bytes, 0);
        PTR_BYTE_ADD(dst, base, i);
        PTR_WRITE_U8(dst, b);
    }
    return 0;
}

// function kernelOutputKey(output: unknown): string (ts:1047-1055)
// TS: string -> `s:${output}`; else `j:${JSON.stringify(output)}`, on
// throw "u:unknown".
// DEFECT: dynamic object — JSON.stringify not available; writes the "s:"
// form for strings and "u:unknown" otherwise.
fn kernelOutputKey(is_string: bool, output_ptr: ptr, output_len: u64, out_ptr: ptr, out_len: &u64) -> i32 {
    if is_string {
        let dst0: ptr = PTR_NULL();
        PTR_BYTE_ADD(dst0, out_ptr, 0);
        PTR_WRITE_U8(dst0, 115u8);
        let dst1: ptr = PTR_NULL();
        PTR_BYTE_ADD(dst1, out_ptr, 1);
        PTR_WRITE_U8(dst1, 58u8);
        for i in 0..output_len {
            let b: u8 = 0;
            PTR_BYTE_AT(b, output_ptr, i);
            let dst: ptr = PTR_NULL();
            PTR_BYTE_ADD(dst, out_ptr, 2 + i);
            PTR_WRITE_U8(dst, b);
        }
        *out_len = 2 + output_len;
        return 0;
    };
    let unknown = "u:unknown";
    for i in 0..STR_LEN(unknown) {
        let b: u8 = 0;
        let src: ptr = PTR_NULL();
        PTR_BYTE_ADD(src, STR_PTR(unknown), i);
        PTR_BYTE_AT(b, src, 0);
        let dst: ptr = PTR_NULL();
        PTR_BYTE_ADD(dst, out_ptr, i);
        PTR_WRITE_U8(dst, b);
    }
    *out_len = STR_LEN(unknown);
    return 0;
}

