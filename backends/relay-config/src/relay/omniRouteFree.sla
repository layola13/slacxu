// export function resolveClineProvidersJsonPath(): string (ts:2768-2773)
// TS: env CLINE_SETTINGS_PATH trimmed wins; else
// join(homedir(), ".cline", "data", "settings", "providers.json").
// DEFECT: Node API — homedir()/join() and env access unavailable; the
// path is written with a literal "~" home placeholder for the fix phase.
fn resolveClineProvidersJsonPath(out_ptr: ptr, out_len: &u64) -> i32 {
    let env_len: u64 = 0;
    if omni_env_get(STR_PTR("CLINE_SETTINGS_PATH"), STR_LEN("CLINE_SETTINGS_PATH"), out_ptr, &env_len) && env_len > 0 {
        *out_len = env_len;
        return 0;
    };
    let path = "~/.cline/data/settings/providers.json";
    for i in 0..STR_LEN(path) {
        let b: u8 = 0;
        let src: ptr = PTR_NULL();
        PTR_BYTE_ADD(src, STR_PTR(path), i);
        PTR_BYTE_AT(b, src, 0);
        let dst: ptr = PTR_NULL();
        PTR_BYTE_ADD(dst, out_ptr, i);
        PTR_WRITE_U8(dst, b);
    }
    *out_len = STR_LEN(path);
    return 0;
}

// export type ResolveClineTokenOptions = { forceRefresh?: boolean;
//   fetchImpl?: typeof fetch; settingsPath?: string }; (ts:2775-2779)
// DEFECT: fetchImpl — see OmniRouteFreeFetchOptions.
struct ResolveClineTokenOptions {
    has_forceRefresh: bool,
    forceRefresh: bool,
    has_fetchImpl: bool,
    has_settingsPath: bool,
    settingsPath_bytes: [u8; 1024],
    settingsPath_len: u64,
}

// let cachedClineToken: { accessToken: string; refreshToken?: string;
//   expiresAt: number } | null = null; (ts:2781-2785)
// DEFECT: module-level mutable state — caller-owned struct.
struct ClineTokenCache {
    has_token: bool,
    accessToken_bytes: [u8; 4096],
    accessToken_len: u64,
    has_refreshToken: bool,
    refreshToken_bytes: [u8; 4096],
    refreshToken_len: u64,
    expiresAt: u64,
}

// export function clearClineTokenCache(cache): void (ts:2787-2789)
fn clearClineTokenCache(cache: &ClineTokenCache) -> i32 {
    cache.has_token = false;
    return 0;
}

// export function formatClineToken(token: string): string (ts:2791-2795)
// TS: trim; empty -> ""; already "workos:"-prefixed kept; else prefix.
fn formatClineToken(token_ptr: ptr, token_len: u64, out_ptr: ptr, out_len: &u64) -> i32 {
    // trim approximated by space trimming.
    let start: u64 = 0;
    let end: u64 = token_len;
    while start < end {
        let b: u8 = 0;
        PTR_BYTE_AT(b, token_ptr, start);
        if b != 32 { break; };
        start = start + 1;
    }
    while end > start {
        let b: u8 = 0;
        PTR_BYTE_AT(b, token_ptr, end - 1);
        if b != 32 { break; };
        end = end - 1;
    }
    if end == start {
        *out_len = 0;
        return 0;
    };
    let n: u64 = 0;
    if !omni_str_starts_with(omni_padd(token_ptr, start), end - start, STR_PTR("workos:"), STR_LEN("workos:")) {
        let prefix = "workos:";
        for i in 0..STR_LEN(prefix) {
            let b: u8 = 0;
            let src: ptr = PTR_NULL();
            PTR_BYTE_ADD(src, STR_PTR(prefix), i);
            PTR_BYTE_AT(b, src, 0);
            let dst: ptr = PTR_NULL();
            PTR_BYTE_ADD(dst, out_ptr, n);
            PTR_WRITE_U8(dst, b);
            n = n + 1;
        }
    };
    for i in 0..end - start {
        let b: u8 = 0;
        PTR_BYTE_AT(b, token_ptr, start + i);
        let dst: ptr = PTR_NULL();
        PTR_BYTE_ADD(dst, out_ptr, n);
        PTR_WRITE_U8(dst, b);
        n = n + 1;
    }
    *out_len = n;
    return 0;
}

// export async function resolveLocalClineToken(cache, options): Promise<string | null> (ts:2797-2918)
// DEFECT: async — synchronous; returns 0 + token in out, -1 for TS null.
// TS flow: env CLINE_API_KEY wins (formatted). Fresh cache (expiresAt
// more than 300_000 ms out) wins unless forceRefresh. Otherwise read the
// providers.json settings file (existsSync/readFileSync/JSON.parse),
// extract providers.cline.settings.auth { accessToken, refreshToken,
// expiresAt (number or Date-parsed string) }; when a refresh is needed
// (forceRefresh or expiring within 300_000 ms) POST
// `${CLINE_FREE_BASE_URL}/auth/refresh` with Cline client headers and
// { refreshToken, grantType: "refresh_token" }, adopt the returned
// tokens and persist the file (writeFileSync, errors ignored); finally
// cache and return formatClineToken(accessToken), falling back to the
// stale cached token on every failure path.
// DEFECT: Node API — fs read/write, JSON.parse and fetch are not
// implemented in this pass; only the env and cache branches run, so the
// result is env token / cached token / null.
fn resolveLocalClineToken(cache: &ClineTokenCache, options: &ResolveClineTokenOptions, out_ptr: ptr, out_len: &u64) -> i32 {
    *out_len = 0;
    let env_buf: [u8; 4096] = [0u8; 4096];
    let env_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(env_ptr, &env_buf, 0);
    let env_len: u64 = 0;
    if omni_env_get(STR_PTR("CLINE_API_KEY"), STR_LEN("CLINE_API_KEY"), env_ptr, &env_len) {
        // TS checks .trim() non-empty via `?.trim()` truthiness; the raw
        // value is passed to formatClineToken which trims.
        return formatClineToken(env_ptr, env_len, out_ptr, out_len);
    };
    let now: u64 = omni_now_ms();
    if cache.has_token && !options.forceRefresh {
        if cache.expiresAt > 0 && cache.expiresAt - now > 300000 {
            let src: ptr = PTR_NULL();
            PTR_BYTE_ADD(src, &cache.accessToken_bytes, 0);
            for i in 0..cache.accessToken_len {
                let b: u8 = 0;
                PTR_BYTE_AT(b, src, i);
                let dst: ptr = PTR_NULL();
                PTR_BYTE_ADD(dst, out_ptr, i);
                PTR_WRITE_U8(dst, b);
            }
            *out_len = cache.accessToken_len;
            return 0;
        };
    };
    // DEFECT: file + refresh flow not implemented (see header note);
    // TS falls back to cachedClineToken?.accessToken || null here too.
    if cache.has_token {
        let src: ptr = PTR_NULL();
        PTR_BYTE_ADD(src, &cache.accessToken_bytes, 0);
        for i in 0..cache.accessToken_len {
            let b: u8 = 0;
            PTR_BYTE_AT(b, src, i);
            let dst: ptr = PTR_NULL();
            PTR_BYTE_ADD(dst, out_ptr, i);
            PTR_WRITE_U8(dst, b);
        }
        *out_len = cache.accessToken_len;
        return 0;
    };
    return -1;
}

// ---------------------------------------------------------------------------
// Free group builders (omniRouteFree.ts:2920-3071)
// TS returns a fresh ChannelGroupConfig object literal per builder;
// here the caller passes `out` and the fields are filled 1:1.
// ---------------------------------------------------------------------------

// Copy a string into a fixed field / buffer; returns the length written.
fn omni_fill_field(field_ptr: ptr, text_ptr: ptr, text_len: u64) -> u64 {
    for i in 0..text_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, text_ptr, i);
        let dst: ptr = PTR_NULL();
        PTR_BYTE_ADD(dst, field_ptr, i);
        PTR_WRITE_U8(dst, b);
    }
    return text_len;
}

// Set<string> dedupe over the newline-joined StrList form, order kept
// (TS: [...new Set(models)]).
fn omni_strlist_dedupe(input: &StrList, out: &StrList) -> i32 {
    out.len = 0;
    out.count = 0;
    let src_base: ptr = PTR_NULL();
    PTR_BYTE_ADD(src_base, &input.bytes, 0);
    let out_base: ptr = PTR_NULL();
    PTR_BYTE_ADD(out_base, &out.bytes, 0);
    let pos: u64 = 0;
    while pos < input.len {
        let start: u64 = pos;
        while pos < input.len {
            let b: u8 = 0;
            PTR_BYTE_AT(b, src_base, pos);
            if b == 10 { break; };
            pos = pos + 1;
        }
        let entry_len: u64 = pos - start;
        // already present?
        let dup = false;
        let scan: u64 = 0;
        while scan < out.len {
            let s_start: u64 = scan;
            while scan < out.len {
                let b: u8 = 0;
                PTR_BYTE_AT(b, out_base, scan);
                if b == 10 { break; };
                scan = scan + 1;
            }
            if omni_str_eq(omni_padd(out_base, s_start), scan - s_start, omni_padd(src_base, start), entry_len) { dup = true; };
            scan = scan + 1;
        }
        if !dup && entry_len > 0 {
            if out.len > 0 {
                let dst: ptr = PTR_NULL();
                PTR_BYTE_ADD(dst, out_base, out.len);
                PTR_WRITE_U8(dst, 10u8);
                out.len = out.len + 1;
            };
            for i in 0..entry_len {
                let b: u8 = 0;
                PTR_BYTE_AT(b, src_base, start + i);
                let dst: ptr = PTR_NULL();
                PTR_BYTE_ADD(dst, out_base, out.len);
                PTR_WRITE_U8(dst, b);
                out.len = out.len + 1;
            }
            out.count = out.count + 1;
        };
        pos = pos + 1;
    }
    return 0;
}

fn omni_strlist_copy(input: &StrList, out: &StrList) -> i32 {
    let src_base: ptr = PTR_NULL();
    PTR_BYTE_ADD(src_base, &input.bytes, 0);
    let out_base: ptr = PTR_NULL();
    PTR_BYTE_ADD(out_base, &out.bytes, 0);
    for i in 0..input.len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, src_base, i);
        let dst: ptr = PTR_NULL();
        PTR_BYTE_ADD(dst, out_base, i);
        PTR_WRITE_U8(dst, b);
    }
    out.len = input.len;
    out.count = input.count;
    return 0;
}

// Fill the common group fields shared by all six builders.
fn omni_fill_group_common(group: &ChannelGroupConfig, id: ptr, name: ptr, baseUrl: ptr, remark: ptr, authType: ptr, responseProtocol: ptr) -> i32 {
    let f: ptr = PTR_NULL();
    PTR_BYTE_ADD(f, &group.id_bytes, 0);
    group.id_len = omni_fill_field(f, id, STR_LEN(id));
    PTR_BYTE_ADD(f, &group.name_bytes, 0);
    group.name_len = omni_fill_field(f, name, STR_LEN(name));
    PTR_BYTE_ADD(f, &group.baseUrl_bytes, 0);
    group.baseUrl_len = omni_fill_field(f, baseUrl, STR_LEN(baseUrl));
    PTR_BYTE_ADD(f, &group.kind_bytes, 0);
    group.kind_len = omni_fill_field(f, STR_PTR("text"), STR_LEN("text"));
    PTR_BYTE_ADD(f, &group.status_bytes, 0);
    group.status_len = omni_fill_field(f, STR_PTR("enabled"), STR_LEN("enabled"));
    group.groupRatio = 0.0;
    group.has_contextWindow = false;
    group.contextWindow = 0;
    PTR_BYTE_ADD(f, &group.responseProtocol_bytes, 0);
    group.responseProtocol_len = omni_fill_field(f, responseProtocol, STR_LEN(responseProtocol));
    PTR_BYTE_ADD(f, &group.responseProtocolMode_bytes, 0);
    group.responseProtocolMode_len = omni_fill_field(f, STR_PTR("fixed"), STR_LEN("fixed"));
    PTR_BYTE_ADD(f, &group.remark_bytes, 0);
    group.remark_len = omni_fill_field(f, remark, STR_LEN(remark));
    PTR_BYTE_ADD(f, &group.authType_bytes, 0);
    group.authType_len = omni_fill_field(f, authType, STR_LEN(authType));
    PTR_BYTE_ADD(f, &group.credentialMode_bytes, 0);
    group.credentialMode_len = omni_fill_field(f, STR_PTR("group"), STR_LEN("group"));
    PTR_BYTE_ADD(f, &group.keyMode_bytes, 0);
    group.keyMode_len = omni_fill_field(f, STR_PTR("single"), STR_LEN("single"));
    group.has_modelMapping = false;
    group.modelMapping_json.len = 0;
    group.json_tail.len = 0;
    return 0;
}

// 1. 原来的 free 分组 (CodexUltraFree，zen 免费模型目前只支持 chat/completions)
// export function buildOmniRouteFreeGroup(models: string[]): ChannelGroupConfig (ts:2920-2939)
fn buildOmniRouteFreeGroup(models: &StrList, out: &ChannelGroupConfig) -> i32 {
    omni_fill_group_common(out, STR_PTR("opencode-free"), STR_PTR("CodexUltraFree"), STR_PTR("https://opencode.ai/zen/v1"), STR_PTR("CodexUltraFree managed free models"), STR_PTR("none"), STR_PTR("openai"));
    omni_strlist_dedupe(models, &out.models);
    out.keys.len = 0;
    out.keys.count = 0;
    return 0;
}

// 2. 新增 opencode 分组 (OpenCode 独立分组，协议使用 chat/completions)
// export function buildOpenCodeGroup(models: string[]): ChannelGroupConfig (ts:2941-2959)
fn buildOpenCodeGroup(models: &StrList, out: &ChannelGroupConfig) -> i32 {
    omni_fill_group_common(out, STR_PTR("opencode"), STR_PTR("OpenCode"), STR_PTR("https://opencode.ai/zen/v1"), STR_PTR("OpenCode managed free models"), STR_PTR("none"), STR_PTR("openai"));
    omni_strlist_dedupe(models, &out.models);
    out.keys.len = 0;
    out.keys.count = 0;
