// Canonical OpenCode session id shape: `ses_` + 12 hex + 14 base62 (ts:29).
// export const OPENCODE_SESSION_PATTERN = /^ses_[0-9a-f]{12}[0-9A-Za-z]{14}$/; (ts:30)
// DEFECT: regex — SLA has no regex engine; the pattern is kept as text and
// matching is approximated by omni_opencode_session_pattern_test below.
fn omni_opencode_session_pattern_text(out_len: &u64) -> ptr {
    *out_len = 30;
    return STR_PTR("^ses_[0-9a-f]{12}[0-9A-Za-z]{14}$");
}

// Same shape for the request id (ts:31).
// export const OPENCODE_REQUEST_PATTERN = /^msg_[0-9a-f]{12}[0-9A-Za-z]{14}$/; (ts:32)
// DEFECT: regex — see above.
fn omni_opencode_request_pattern_text(out_len: &u64) -> ptr {
    *out_len = 30;
    return STR_PTR("^msg_[0-9a-f]{12}[0-9A-Za-z]{14}$");
}

// DEFECT: regex — shape check approximated: prefix + total length 30 + the
// hex/base62 character classes are not verified per position.
fn omni_id_pattern_test(value_ptr: ptr, value_len: u64, prefix_ptr: ptr, prefix_len: u64) -> bool {
    if value_len != 30 { return false; };
    return omni_str_starts_with(value_ptr, value_len, prefix_ptr, prefix_len);
}

// const OPENCODE_MIN_USER_AGENT_MINOR = 17; (ts:33)
fn omni_opencode_min_user_agent_minor() -> u64 {
    return 17;
}

// const OPENCODE_USER_AGENT_VERSION_RE = /opencode\/(?:[a-z]+\/)?v?(\d+)\.(\d+)/i; (ts:34)
// const OPENCODE_GENERIC_CLIENT_UA_RE = /^(?:curl|wget|libcurl|python-requests|...)(?:[/\s]|$)/i; (ts:35-36)
// DEFECT: regex — both patterns kept as text constants only; the match
// functions below approximate them.

// export function satisfiesOpencodeUserAgentContract(userAgent: string | null | undefined): boolean (ts:37-44)
// Parses `opencode/<major>.<minor>` out of the UA and requires
// major > 1 || (major === 1 && minor >= 17).
// DEFECT: regex — the version extraction is approximated by scanning for
// the "opencode/" prefix and reading decimal digits; the optional
// `[a-z]+/` segment and `v` prefix of the real pattern are not handled.
fn satisfiesOpencodeUserAgentContract(userAgent_ptr: ptr, userAgent_len: u64, has_userAgent: bool) -> bool {
    if !has_userAgent { return false; };
    // Locate "opencode/" then parse "<digits>.<digits>".
    // DEFECT: regex — digit-run parsing approximates (\d+)\.(\d+) only when
    // the version immediately follows the prefix.
    let pos: u64 = 0;
    let found = false;
    if userAgent_len >= 9 {
        let last: u64 = userAgent_len - 9;
        for i in 0..last + 1 {
            if omni_str_starts_with(omni_padd(userAgent_ptr, i), userAgent_len - i, STR_PTR("opencode/"), STR_LEN("opencode/")) {
                pos = i + 9;
                found = true;
                break;
            };
        }
    };
    if !found { return false; };
    let major: u64 = 0;
    let minor: u64 = 0;
    let saw_major = false;
    let saw_dot = false;
    let saw_minor = false;
    for i in pos..userAgent_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, userAgent_ptr, i);
        if b >= 48 && b <= 57 {
            if !saw_dot {
                major = major * 10 + (b - 48) as u64;
                saw_major = true;
            } else {
                minor = minor * 10 + (b - 48) as u64;
                saw_minor = true;
            };
        } else {
            if b == 46 && saw_major && !saw_dot {
                saw_dot = true;
            } else {
                break;
            };
        };
    }
    if !saw_major || !saw_minor { return false; };
    // Number.isFinite checks are vacuous for the digit-parse approximation.
    return major > 1 || (major == 1 && minor >= omni_opencode_min_user_agent_minor());
}

// export function isGenericOpencodeClientUserAgent(userAgent: string | null | undefined): boolean (ts:45-48)
// DEFECT: regex — approximated by prefix tests against the alternation list
// (curl|wget|libcurl|python-requests|python-httpx|python-urllib|aiohttp|
// httpie|node-fetch|node|undici|axios|got|ky|bun|deno|go-http-client|
// okhttp|java|apache-httpclient|postmanruntime|insomnia|openai|anthropic|
// async openai|openai-python), case-insensitively in TS; byte compare here
// is case-sensitive and the trailing (?:[/\s]|$) anchor is not enforced.
fn isGenericOpencodeClientUserAgent(userAgent_ptr: ptr, userAgent_len: u64, has_userAgent: bool) -> bool {
    // String(userAgent || "").trim() — trim approximated by skipping
    // leading/trailing spaces only.
    let start: u64 = 0;
    let end: u64 = userAgent_len;
    if !has_userAgent { end = 0; };
    while start < end {
        let b: u8 = 0;
        PTR_BYTE_AT(b, userAgent_ptr, start);
        if b != 32 { break; };
        start = start + 1;
    }
    while end > start {
        let b: u8 = 0;
        PTR_BYTE_AT(b, userAgent_ptr, end - 1);
        if b != 32 { break; };
        end = end - 1;
    }
    let v_ptr: ptr = omni_padd(userAgent_ptr, start);
    let v_len: u64 = end - start;
    if v_len == 0 { return true; };
    if omni_str_starts_with(v_ptr, v_len, STR_PTR("curl"), STR_LEN("curl")) { return true; };
    if omni_str_starts_with(v_ptr, v_len, STR_PTR("wget"), STR_LEN("wget")) { return true; };
    if omni_str_starts_with(v_ptr, v_len, STR_PTR("libcurl"), STR_LEN("libcurl")) { return true; };
    if omni_str_starts_with(v_ptr, v_len, STR_PTR("python-requests"), STR_LEN("python-requests")) { return true; };
    if omni_str_starts_with(v_ptr, v_len, STR_PTR("python-httpx"), STR_LEN("python-httpx")) { return true; };
    if omni_str_starts_with(v_ptr, v_len, STR_PTR("python-urllib"), STR_LEN("python-urllib")) { return true; };
    if omni_str_starts_with(v_ptr, v_len, STR_PTR("aiohttp"), STR_LEN("aiohttp")) { return true; };
    if omni_str_starts_with(v_ptr, v_len, STR_PTR("httpie"), STR_LEN("httpie")) { return true; };
    if omni_str_starts_with(v_ptr, v_len, STR_PTR("node-fetch"), STR_LEN("node-fetch")) { return true; };
    if omni_str_starts_with(v_ptr, v_len, STR_PTR("node"), STR_LEN("node")) { return true; };
    if omni_str_starts_with(v_ptr, v_len, STR_PTR("undici"), STR_LEN("undici")) { return true; };
    if omni_str_starts_with(v_ptr, v_len, STR_PTR("axios"), STR_LEN("axios")) { return true; };
    if omni_str_starts_with(v_ptr, v_len, STR_PTR("got"), STR_LEN("got")) { return true; };
    if omni_str_starts_with(v_ptr, v_len, STR_PTR("ky"), STR_LEN("ky")) { return true; };
    if omni_str_starts_with(v_ptr, v_len, STR_PTR("bun"), STR_LEN("bun")) { return true; };
    if omni_str_starts_with(v_ptr, v_len, STR_PTR("deno"), STR_LEN("deno")) { return true; };
    if omni_str_starts_with(v_ptr, v_len, STR_PTR("go-http-client"), STR_LEN("go-http-client")) { return true; };
    if omni_str_starts_with(v_ptr, v_len, STR_PTR("okhttp"), STR_LEN("okhttp")) { return true; };
    if omni_str_starts_with(v_ptr, v_len, STR_PTR("java"), STR_LEN("java")) { return true; };
    if omni_str_starts_with(v_ptr, v_len, STR_PTR("apache-httpclient"), STR_LEN("apache-httpclient")) { return true; };
    if omni_str_starts_with(v_ptr, v_len, STR_PTR("postmanruntime"), STR_LEN("postmanruntime")) { return true; };
    if omni_str_starts_with(v_ptr, v_len, STR_PTR("insomnia"), STR_LEN("insomnia")) { return true; };
    if omni_str_starts_with(v_ptr, v_len, STR_PTR("openai"), STR_LEN("openai")) { return true; };
    if omni_str_starts_with(v_ptr, v_len, STR_PTR("anthropic"), STR_LEN("anthropic")) { return true; };
    if omni_str_starts_with(v_ptr, v_len, STR_PTR("openai-python"), STR_LEN("openai-python")) { return true; };
    return false;
}

// const OPENCODE_BASE62 = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"; (ts:49)
fn omni_opencode_base62_char(index: u64) -> u8 {
    let table = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz";
    let p: ptr = PTR_NULL();
    PTR_BYTE_ADD(p, STR_PTR(table), index);
    let b: u8 = 0;
    PTR_BYTE_AT(b, p, 0);
    return b;
}

// function base62FromBytes(bytes: Buffer, length: number): string (ts:50-52)
//   Array.from(bytes.subarray(0, length), (byte) => OPENCODE_BASE62[byte % 62]).join("")
// DEFECT: Node API — Buffer has no SLA counterpart; bytes are a raw pointer.
fn base62FromBytes(bytes_ptr: ptr, bytes_len: u64, length: u64, out_ptr: ptr, out_len: &u64) -> i32 {
    let n: u64 = length;
    if bytes_len < n { n = bytes_len; };
    for i in 0..n {
        let b: u8 = 0;
        PTR_BYTE_AT(b, bytes_ptr, i);
        let ch: u8 = omni_opencode_base62_char((b as u64) % 62);
        let dst: ptr = PTR_NULL();
        PTR_BYTE_ADD(dst, out_ptr, i);
        PTR_WRITE_U8(dst, ch);
    }
    *out_len = n;
    return 0;
}

// Render an id in the canonical OpenCode shape (`prefix` + 12 hex + 14 base62).
// export function canonicalOpencodeId(prefix: "ses_" | "msg_", seed?: string): string (ts:54-59)
// DEFECT: string-literal union parameter type ("ses_" | "msg_") — approximated
// by passing the prefix as (ptr, len).
// DEFECT: node:crypto — createHash("sha256") seed derivation and
// randomBytes(32) both approximated (see omni_hash_hex / omni_random_bytes).
fn canonicalOpencodeId(prefix_ptr: ptr, prefix_len: u64, has_seed: bool, seed_ptr: ptr, seed_len: u64, out_ptr: ptr, out_len: &u64) -> i32 {
    // bytes = seed !== undefined
    //   ? createHash("sha256").update("opencode\0" + prefix + "\0" + seed).digest()
    //   : randomBytes(32)
    // DEFECT: dynamic string concatenation for the hash input is not built;
    // the digest is taken over the seed bytes only.
    let digest: [u8; 32] = [0u8; 32];
    let digest_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(digest_ptr, &digest, 0);
    if has_seed {
        let ignored: u64 = 0;
        omni_hash_hex(STR_PTR("sha256"), STR_LEN("sha256"), seed_ptr, seed_len, digest_ptr, &ignored, 32);
    } else {
        omni_random_bytes(digest_ptr, 32);
    };
    // return prefix + bytes.subarray(0, 6).toString("hex") + base62FromBytes(bytes.subarray(6), 14)
    let pos: u64 = 0;
    for i in 0..prefix_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, prefix_ptr, i);
        let dst: ptr = PTR_NULL();
        PTR_BYTE_ADD(dst, out_ptr, pos);
        PTR_WRITE_U8(dst, b);
        pos = pos + 1;
    }
    // 6 bytes -> 12 lowercase hex chars.
    let hexdigits = "0123456789abcdef";
    for i in 0..6 {
        let b: u8 = 0;
        PTR_BYTE_AT(b, digest_ptr, i);
        let hi: u8 = 0;
        let lo: u8 = 0;
        let hp: ptr = PTR_NULL();
        let lp: ptr = PTR_NULL();
        PTR_BYTE_ADD(hp, STR_PTR(hexdigits), (b >> 4) as u64);
        PTR_BYTE_ADD(lp, STR_PTR(hexdigits), (b & 15) as u64);
        PTR_BYTE_AT(hi, hp, 0);
        PTR_BYTE_AT(lo, lp, 0);
        let d1: ptr = PTR_NULL();
        let d2: ptr = PTR_NULL();
        PTR_BYTE_ADD(d1, out_ptr, pos);
        PTR_BYTE_ADD(d2, out_ptr, pos + 1);
        PTR_WRITE_U8(d1, hi);
        PTR_WRITE_U8(d2, lo);
        pos = pos + 2;
    }
    let tail_len: u64 = 0;
    base62FromBytes(omni_padd(digest_ptr, 6), 26, 14, omni_padd(out_ptr, pos), &tail_len);
    pos = pos + tail_len;
    *out_len = pos;
    return 0;
}

// ---------------------------------------------------------------------------
// OpenCode CLI version cache (omniRouteFree.ts:60-107)
// export const OPENCODE_CLI_VERSION_FALLBACK = OPENCODE_CLIENT_VERSION; (ts:60)
// const OPENCODE_NPM_LATEST_URL = "https://registry.npmjs.org/opencode-ai/latest"; (ts:61)
// const OPENCODE_CLI_VERSION_TTL_MS = 6 * 60 * 60 * 1000; (ts:62)
// const OPENCODE_CLI_FETCH_TIMEOUT_MS = 5_000; (ts:63)
// DEFECT: module-level mutable state (let cachedOpencodeCliVersion /
// cachedOpencodeCliVersionAt / opencodeCliVersionInFlight) — SLA has no
// module globals in this dialect; the cache lives in a caller-owned struct
// threaded through the functions below.
// DEFECT: Promise<string> | null in-flight handle — no Promise type; the
// in-flight flag is a plain bool and de-duplication is best-effort.
// ---------------------------------------------------------------------------
struct OpencodeCliVersionCache {
    has_version: bool,
    version_bytes: [u8; 64],
    version_len: u64,
    cached_at_ms: u64,
    in_flight: bool,
}

fn omni_opencode_cli_version_ttl_ms() -> u64 {
    return 21600000;
}

fn omni_opencode_cli_fetch_timeout_ms() -> u64 {
    return 5000;
}

// function isOpencodeCliVersion(value: unknown): value is string (ts:65-67)
// DEFECT: type predicate (`value is string`) — no SLA counterpart; returns
// the boolean only. The /^\d+\.\d+\.\d+$/ test is approximated by a manual
// three-component digit scan.
// DEFECT: regex — see above.
fn isOpencodeCliVersion(is_string: bool, value_ptr: ptr, value_len: u64) -> bool {
    if !is_string { return false; };
    let parts: u64 = 0;
    let digits: u64 = 0;
    for i in 0..value_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, value_ptr, i);
        if b >= 48 && b <= 57 {
            digits = digits + 1;
        } else {
            if b == 46 && digits > 0 {
                parts = parts + 1;
                digits = 0;
            } else {
                return false;
            };
        };
    }
    return parts == 2 && digits > 0;
}

// export function getCachedOpencodeCliVersion(): string (ts:68-71)
fn getCachedOpencodeCliVersion(cache: &OpencodeCliVersionCache, out_ptr: ptr, out_len: &u64) -> i32 {
    if cache.has_version && omni_now_ms() - cache.cached_at_ms < omni_opencode_cli_version_ttl_ms() {
        for i in 0..cache.version_len {
            let b: u8 = 0;
            let src: ptr = PTR_NULL();
            PTR_BYTE_ADD(src, &cache.version_bytes, i);
            PTR_BYTE_AT(b, src, 0);
            let dst: ptr = PTR_NULL();
            PTR_BYTE_ADD(dst, out_ptr, i);
            PTR_WRITE_U8(dst, b);
        }
        *out_len = cache.version_len;
        return 0;
    };
    // return cachedOpencodeCliVersion ?? OPENCODE_CLI_VERSION_FALLBACK
    if cache.has_version {
        for i in 0..cache.version_len {
            let b: u8 = 0;
            let src: ptr = PTR_NULL();
            PTR_BYTE_ADD(src, &cache.version_bytes, i);
            PTR_BYTE_AT(b, src, 0);
            let dst: ptr = PTR_NULL();
            PTR_BYTE_ADD(dst, out_ptr, i);
            PTR_WRITE_U8(dst, b);
        }
        *out_len = cache.version_len;
        return 0;
    };
    let fallback = "1.18.31";
    for i in 0..STR_LEN(fallback) {
        let b: u8 = 0;
        let src: ptr = PTR_NULL();
        PTR_BYTE_ADD(src, STR_PTR(fallback), i);
        PTR_BYTE_AT(b, src, 0);
        let dst: ptr = PTR_NULL();
        PTR_BYTE_ADD(dst, out_ptr, i);
        PTR_WRITE_U8(dst, b);
    }
    *out_len = STR_LEN(fallback);
    return 0;
}

// export function refreshOpencodeCliVersion(): Promise<string> (ts:72-96)
// DEFECT: async — TS returns a shared in-flight Promise that fetches
// OPENCODE_NPM_LATEST_URL with AbortSignal.timeout(5000), parses
// { version?: unknown } JSON and updates the cache; converted to a
// synchronous status-code function. The network fetch + JSON parse are not
// implemented in this pass, so the cache is left untouched and the current
// cached/fallback version is written to out (mirroring the catch branch:
// "Registry unreachable — stale cache / pin stay valid.").
// DEFECT: Promise — the `.finally()` de-registration of the in-flight
// promise has no counterpart; in_flight is cleared immediately.
fn refreshOpencodeCliVersion(cache: &OpencodeCliVersionCache, out_ptr: ptr, out_len: &u64) -> i32 {
    if cache.has_version && omni_now_ms() - cache.cached_at_ms < omni_opencode_cli_version_ttl_ms() {
        return getCachedOpencodeCliVersion(cache, out_ptr, out_len);
    };
    if cache.in_flight {
        // return opencodeCliVersionInFlight (join the existing request)
        return getCachedOpencodeCliVersion(cache, out_ptr, out_len);
    };
    cache.in_flight = true;
    // DEFECT: fetch/await not implemented (see header note).
    cache.in_flight = false;
    return getCachedOpencodeCliVersion(cache, out_ptr, out_len);
}

// function keepsOpencodeClientUserAgent(userAgent: string | undefined, keepAgentUserAgent: boolean): boolean (ts:98-101)
fn keepsOpencodeClientUserAgent(has_userAgent: bool, userAgent_ptr: ptr, userAgent_len: u64, keepAgentUserAgent: bool) -> bool {
    if satisfiesOpencodeUserAgentContract(userAgent_ptr, userAgent_len, has_userAgent) { return true; };
    return keepAgentUserAgent && !isGenericOpencodeClientUserAgent(userAgent_ptr, userAgent_len, has_userAgent);
}

// Result of resolveOpencodeCliDefaults: TS returns
// { userAgent: string; client: string; project: string } | undefined.
struct OpencodeCliDefaults {
    userAgent_bytes: [u8; 512],
    userAgent_len: u64,
    client_bytes: [u8; 128],
    client_len: u64,
    project_bytes: [u8; 128],
    project_len: u64,
}

// CLI identity defaults the upstream expects; `gated` = free-tier request under contract.
// export function resolveOpencodeCliDefaults(providerId: string, gated: boolean): {...} | undefined (ts:103-125)
// Returns 0 and fills `out` when defaults apply, -1 for the TS `undefined`
// (OPENCODE_SYNTHESIZE_CLI_HEADERS matching /^(0|false|no|off)$/i).
// DEFECT: regex — the disable-flag test is approximated by exact compares
// against "0"/"false"/"no"/"off" (case-sensitive here).
// DEFECT: Node API — process.env[...] dynamic key
// `${providerId.toUpperCase().replace(/[^A-Z0-9]/g, "_")}_USER_AGENT` cannot
// be built/looked up in this pass; configuredUA is therefore always unset.
// DEFECT: fire-and-forget `void refreshOpencodeCliVersion()` side effect —
// the background refresh is invoked synchronously here instead.
fn resolveOpencodeCliDefaults(cache: &OpencodeCliVersionCache, providerId_ptr: ptr, providerId_len: u64, gated: bool, out: &OpencodeCliDefaults) -> i32 {
    let flag_len: u64 = 0;
    let flag_buf: [u8; 16] = [0u8; 16];
    let flag_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(flag_ptr, &flag_buf, 0);
    if omni_env_get(STR_PTR("OPENCODE_SYNTHESIZE_CLI_HEADERS"), STR_LEN("OPENCODE_SYNTHESIZE_CLI_HEADERS"), flag_ptr, &flag_len) {
        if omni_str_eq(flag_ptr, flag_len, STR_PTR("0"), STR_LEN("0")) { return -1; };
        if omni_str_eq(flag_ptr, flag_len, STR_PTR("false"), STR_LEN("false")) { return -1; };
        if omni_str_eq(flag_ptr, flag_len, STR_PTR("no"), STR_LEN("no")) { return -1; };
        if omni_str_eq(flag_ptr, flag_len, STR_PTR("off"), STR_LEN("off")) { return -1; };
    };
    // configuredUA lookup skipped (see DEFECT above); also the test guard
    // (NODE_TEST_CONTEXT / VITEST / NODE_ENV === "test") that suppresses the
    // registry refresh cannot be evaluated without env access.
    let scratch_len: u64 = 0;
    let scratch: [u8; 64] = [0u8; 64];
    let scratch_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(scratch_ptr, &scratch, 0);
    refreshOpencodeCliVersion(cache, scratch_ptr, &scratch_len);
    // userAgent: configuredUA && (!gated || satisfies...(configuredUA))
    //   ? configuredUA : `opencode/${getCachedOpencodeCliVersion()}`
    let ua_len: u64 = 0;
    let ua_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(ua_ptr, &out.userAgent_bytes, 0);
    let prefix = "opencode/";
    for i in 0..STR_LEN(prefix) {
        let b: u8 = 0;
        let src: ptr = PTR_NULL();
        PTR_BYTE_ADD(src, STR_PTR(prefix), i);
        PTR_BYTE_AT(b, src, 0);
        let dst: ptr = PTR_NULL();
        PTR_BYTE_ADD(dst, ua_ptr, ua_len);
        PTR_WRITE_U8(dst, b);
        ua_len = ua_len + 1;
    }
    let ver_len: u64 = 0;
    getCachedOpencodeCliVersion(cache, omni_padd(ua_ptr, ua_len), &ver_len);
    out.userAgent_len = ua_len + ver_len;
    // client: process.env.OPENCODE_CLIENT?.trim() || "desktop"
    out.client_len = 0;
    let client_buf: [u8; 128] = [0u8; 128];
    let client_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(client_ptr, &client_buf, 0);
    let client_env_len: u64 = 0;
    if omni_env_get(STR_PTR("OPENCODE_CLIENT"), STR_LEN("OPENCODE_CLIENT"), client_ptr, &client_env_len) && client_env_len > 0 {
        for i in 0..client_env_len {
            let b: u8 = 0;
            PTR_BYTE_AT(b, client_ptr, i);
            let dst: ptr = PTR_NULL();
            let base: ptr = PTR_NULL();
            PTR_BYTE_ADD(base, &out.client_bytes, 0);
            PTR_BYTE_ADD(dst, base, i);
            PTR_WRITE_U8(dst, b);
        }
        out.client_len = client_env_len;
    } else {
        let d = "desktop";
        for i in 0..STR_LEN(d) {
            let b: u8 = 0;
            let src: ptr = PTR_NULL();
            PTR_BYTE_ADD(src, STR_PTR(d), i);
            PTR_BYTE_AT(b, src, 0);
            let dst: ptr = PTR_NULL();
            let base: ptr = PTR_NULL();
            PTR_BYTE_ADD(base, &out.client_bytes, 0);
            PTR_BYTE_ADD(dst, base, i);
            PTR_WRITE_U8(dst, b);
        }
        out.client_len = STR_LEN(d);
    };
    // project: process.env.OPENCODE_PROJECT?.trim() || "global"
    out.project_len = 0;
    let project_buf: [u8; 128] = [0u8; 128];
    let project_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(project_ptr, &project_buf, 0);
    let project_env_len: u64 = 0;
    if omni_env_get(STR_PTR("OPENCODE_PROJECT"), STR_LEN("OPENCODE_PROJECT"), project_ptr, &project_env_len) && project_env_len > 0 {
        for i in 0..project_env_len {
            let b: u8 = 0;
            PTR_BYTE_AT(b, project_ptr, i);
            let dst: ptr = PTR_NULL();
            let base: ptr = PTR_NULL();
            PTR_BYTE_ADD(base, &out.project_bytes, 0);
            PTR_BYTE_ADD(dst, base, i);
            PTR_WRITE_U8(dst, b);
        }
        out.project_len = project_env_len;
    } else {
        let g = "global";
        for i in 0..STR_LEN(g) {
            let b: u8 = 0;
            let src: ptr = PTR_NULL();
            PTR_BYTE_ADD(src, STR_PTR(g), i);
            PTR_BYTE_AT(b, src, 0);
            let dst: ptr = PTR_NULL();
            let base: ptr = PTR_NULL();
            PTR_BYTE_ADD(base, &out.project_bytes, 0);
            PTR_BYTE_ADD(dst, base, i);
            PTR_WRITE_U8(dst, b);
        }
        out.project_len = STR_LEN(g);
    };
    return 0;
}

// ---------------------------------------------------------------------------
// Free-model catalog + gating (omniRouteFree.ts:127-153)
// `OPENCODE_FREE_MODELS` (zen.go:106): models usable keyless.
// const OPENCODE_FREE_MODELS = new Set([...]) (ts:132-139)
// DEFECT: Set<string> — approximated by a membership function over the
// literal list (no set type).
// ---------------------------------------------------------------------------
fn omni_opencode_free_models_contains(model_ptr: ptr, model_len: u64) -> bool {
    if omni_str_eq(model_ptr, model_len, STR_PTR("big-pickle"), STR_LEN("big-pickle")) { return true; };
    if omni_str_eq(model_ptr, model_len, STR_PTR("deepseek-v4-flash-free"), STR_LEN("deepseek-v4-flash-free")) { return true; };
    if omni_str_eq(model_ptr, model_len, STR_PTR("mimo-v2.5-free"), STR_LEN("mimo-v2.5-free")) { return true; };
    if omni_str_eq(model_ptr, model_len, STR_PTR("hy3-free"), STR_LEN("hy3-free")) { return true; };
    if omni_str_eq(model_ptr, model_len, STR_PTR("nemotron-3-ultra-free"), STR_LEN("nemotron-3-ultra-free")) { return true; };
    if omni_str_eq(model_ptr, model_len, STR_PTR("north-mini-code-free"), STR_LEN("north-mini-code-free")) { return true; };
    return false;
}

// export function isPremiumOpencodeModel(model: string, provider: string): boolean (ts:140-148)
fn isPremiumOpencodeModel(model_ptr: ptr, model_len: u64, provider_ptr: ptr, provider_len: u64) -> bool {
    // opencode-go has no free tier — every model requires a key.
    if omni_str_eq(provider_ptr, provider_len, STR_PTR("opencode-go"), STR_LEN("opencode-go")) { return true; };
    // Models ending in `-free` are always free on the noauth/zen tier.
    if omni_str_ends_with(model_ptr, model_len, STR_PTR("-free"), STR_LEN("-free")) { return false; };
    // Check the known free model catalog.
    return !omni_opencode_free_models_contains(model_ptr, model_len);
}

// export function isGatedOpencodeFreeTierRequest(model: string, provider?: string, surface?: string): boolean (ts:150-153)
fn isGatedOpencodeFreeTierRequest(model_ptr: ptr, model_len: u64, has_provider: bool, provider_ptr: ptr, provider_len: u64, has_surface: bool, surface_ptr: ptr, surface_len: u64) -> bool {
    // if (!model.trim()) return false; — trim approximated by length only.
    if model_len == 0 { return false; };
    // const resolvedSurface = surface ?? "zen";
    let s_ptr: ptr = surface_ptr;
    let s_len: u64 = surface_len;
    if !has_surface {
        s_ptr = STR_PTR("zen");
        s_len = STR_LEN("zen");
    };
    if !omni_str_eq(s_ptr, s_len, STR_PTR("zen"), STR_LEN("zen")) { return false; };
    // return !isPremiumOpencodeModel(model, provider ?? "opencode");
    if has_provider {
        return !isPremiumOpencodeModel(model_ptr, model_len, provider_ptr, provider_len);
    };
    return !isPremiumOpencodeModel(model_ptr, model_len, STR_PTR("opencode"), STR_LEN("opencode"));
}

// ---------------------------------------------------------------------------
// Upstream surface from registry baseUrl (omniRouteFree.ts:155-163)
// export type OpencodeSurface = "zen" | "go" | "other"; (ts:156)
// DEFECT: string-literal union type — represented as a (ptr, len) string
// holding "zen" / "go" / "other".
// const OPENCODE_ZEN_SURFACE_BASE_URL = "https://opencode.ai/zen/v1"; (ts:157)
// const OPENCODE_GO_SURFACE_BASE_URL = "https://opencode.ai/zen/go/v1"; (ts:158)
// ---------------------------------------------------------------------------

// export function surfaceFromBaseUrl(baseUrl: string | null | undefined): OpencodeSurface (ts:159-163)
fn surfaceFromBaseUrl(has_baseUrl: bool, baseUrl_ptr: ptr, baseUrl_len: u64, out_ptr: ptr, out_len: &u64) -> i32 {
    let result = "other";
    if has_baseUrl {
        if omni_str_eq(baseUrl_ptr, baseUrl_len, STR_PTR("https://opencode.ai/zen/v1"), STR_LEN("https://opencode.ai/zen/v1")) {
            result = "zen";
        } else {
            if omni_str_eq(baseUrl_ptr, baseUrl_len, STR_PTR("https://opencode.ai/zen/go/v1"), STR_LEN("https://opencode.ai/zen/go/v1")) {
                result = "go";
            };
        };
    };
    for i in 0..STR_LEN(result) {
        let b: u8 = 0;
        let src: ptr = PTR_NULL();
        PTR_BYTE_ADD(src, STR_PTR(result), i);
        PTR_BYTE_AT(b, src, 0);
        let dst: ptr = PTR_NULL();
        PTR_BYTE_ADD(dst, out_ptr, i);
        PTR_WRITE_U8(dst, b);
    }
    *out_len = STR_LEN(result);
    return 0;
}

// ---------------------------------------------------------------------------
// Session fingerprint projection (omniRouteFree.ts:165-238)
// Request body fields used for the conversation-stable session fingerprint.
// export interface OpencodeSessionBody (ts:166-176)
// DEFECT: dynamic object — the interface mixes optional strings with
// `unknown` fields and nested message/tool arrays; approximated as presence
// flags + raw JSON text buffers per field.
// ---------------------------------------------------------------------------
struct OpencodeSessionBody {
    has_model: bool,
    model_bytes: [u8; 256],
    model_len: u64,
    // system?: unknown — raw JSON text.
    has_system: bool,
    system_json: JsonText,
    // messages?: Array<{ role?: string; content?: unknown }> — raw JSON text.
    has_messages: bool,
    messages_json: JsonText,
    // input?: Array<{ role?: string; content?: unknown }> — raw JSON text.
    has_input: bool,
    input_json: JsonText,
    // tools?: Array<{ name?: string; function?: { name?: string } }> — raw JSON text.
    has_tools: bool,
    tools_json: JsonText,
    // metadata?: unknown — raw JSON text.
    has_metadata: bool,
    metadata_json: JsonText,
    // session_id?: unknown / thread_id?: unknown — raw JSON text.
    has_session_id: bool,
    session_id_json: JsonText,
    has_thread_id: bool,
    thread_id_json: JsonText,
}

// Keep only fingerprint/identity inputs; never add this projection to an upstream body.
// export function projectOpencodeSessionBody(body: unknown): OpencodeSessionBody | undefined (ts:178-191)
// Returns 0 and fills `out`, -1 for the TS `undefined` (non-object body).
// DEFECT: dynamic object — field extraction from the JSON text body
// (typeof input.model === "string", Array.isArray checks, pass-through of
// unknown fields) requires a JSON walk not implemented in this pass; the
// body is reported as projectable and all fields are left unset.
fn projectOpencodeSessionBody(body: &JsonText, body_is_object: bool, out: &OpencodeSessionBody) -> i32 {
    if !body_is_object { return -1; };
    out.has_model = false;
    out.has_system = false;
    out.has_messages = false;
    out.has_input = false;
    out.has_tools = false;
    out.has_metadata = false;
    out.has_session_id = false;
    out.has_thread_id = false;
    return 0;
}

// function opencodeHashShort(text: string): string (ts:193-195)
//   createHash("sha256").update(text).digest("hex").slice(0, 8)
// DEFECT: node:crypto — digest approximated (see omni_hash_hex).
fn opencodeHashShort(text_ptr: ptr, text_len: u64, out_ptr: ptr, out_len: &u64) -> i32 {
    return omni_hash_hex(STR_PTR("sha256"), STR_LEN("sha256"), text_ptr, text_len, out_ptr, out_len, 8);
}

// function extractOpencodeSystemPrompt(body: OpencodeSessionBody | null | undefined): string | null (ts:197-207)
// Returns 0 + out text, -1 for TS null.
// TS logic: body.system (string as-is, else JSON.stringify) wins; else the
// first messages[] entry with role "system"/"developer" (content string
// as-is, else JSON.stringify).
// DEFECT: dynamic object — searching the messages JSON array and
// JSON.stringify of non-string content are not implemented in this pass;
// only a string `system` field carried directly on the struct is returned.
fn extractOpencodeSystemPrompt(has_body: bool, body: &OpencodeSessionBody, out_ptr: ptr, out_len: &u64) -> i32 {
    *out_len = 0;
    if !has_body { return -1; };
    // DEFECT: body.system / messages are JSON text fields on the struct;
    // their decoded values are unavailable in this pass.
    return -1;
}

// function extractOpencodeFirstUserMessage(body: OpencodeSessionBody | null | undefined): string | null (ts:209-218)
// TS logic: first entry of (body.messages || body.input || []) with
// role === "user"; content string as-is else JSON.stringify.
// DEFECT: dynamic object — same JSON-array limitation as above.
fn extractOpencodeFirstUserMessage(has_body: bool, body: &OpencodeSessionBody, out_ptr: ptr, out_len: &u64) -> i32 {
    *out_len = 0;
    if !has_body { return -1; };
    return -1;
}

// Stable session fingerprint from request characteristics (sessionManager.ts verbatim).
// export function generateOpencodeSessionId(body, options: { provider?: string; connectionId?: string } = {}): string | null (ts:220-238)
// Returns 0 + 16 hex chars in out, -1 for TS null (no parts).
// TS logic: parts = [model:.., provider:.., sys:<hash8>, user0:<hash8>,
// tools:<hash8 of sorted names>, conn:..]; sha256(parts.join("|"))[0..16].
// DEFECT: dynamic object — sys/user0/tools parts depend on the JSON
// extractors above and are skipped in this pass; only model/provider/conn
// parts are assembled, so fingerprints differ from TS whenever a system
// prompt, first user message or tools are present.
// DEFECT: node:crypto — digest approximated (see omni_hash_hex).
fn generateOpencodeSessionId(has_body: bool, body: &OpencodeSessionBody, has_provider: bool, provider_ptr: ptr, provider_len: u64, has_connectionId: bool, connectionId_ptr: ptr, connectionId_len: u64, out_ptr: ptr, out_len: &u64) -> i32 {
    *out_len = 0;
    if !has_body { return -1; };
    // Assemble "parts.join(\"|\")" into a scratch buffer.
    let scratch: [u8; 1024] = [0u8; 1024];
    let scratch_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(scratch_ptr, &scratch, 0);
    let n: u64 = 0;
    let parts: u64 = 0;
    if body.has_model {
        if parts > 0 {
            let dst: ptr = PTR_NULL();
            PTR_BYTE_ADD(dst, scratch_ptr, n);
            PTR_WRITE_U8(dst, 124u8);
            n = n + 1;
        };
        let label = "model:";
        for i in 0..STR_LEN(label) {
            let b: u8 = 0;
            let src: ptr = PTR_NULL();
            PTR_BYTE_ADD(src, STR_PTR(label), i);
            PTR_BYTE_AT(b, src, 0);
            let dst: ptr = PTR_NULL();
            PTR_BYTE_ADD(dst, scratch_ptr, n);
            PTR_WRITE_U8(dst, b);
            n = n + 1;
        }
        for i in 0..body.model_len {
            let b: u8 = 0;
            let src: ptr = PTR_NULL();
            PTR_BYTE_ADD(src, &body.model_bytes, i);
            PTR_BYTE_AT(b, src, 0);
            let dst: ptr = PTR_NULL();
            PTR_BYTE_ADD(dst, scratch_ptr, n);
            PTR_WRITE_U8(dst, b);
            n = n + 1;
        }
        parts = parts + 1;
    };
    if has_provider {
        if parts > 0 {
            let dst: ptr = PTR_NULL();
            PTR_BYTE_ADD(dst, scratch_ptr, n);
            PTR_WRITE_U8(dst, 124u8);
            n = n + 1;
        };
        let label = "provider:";
        for i in 0..STR_LEN(label) {
            let b: u8 = 0;
            let src: ptr = PTR_NULL();
            PTR_BYTE_ADD(src, STR_PTR(label), i);
            PTR_BYTE_AT(b, src, 0);
            let dst: ptr = PTR_NULL();
            PTR_BYTE_ADD(dst, scratch_ptr, n);
            PTR_WRITE_U8(dst, b);
            n = n + 1;
        }
        for i in 0..provider_len {
            let b: u8 = 0;
            PTR_BYTE_AT(b, provider_ptr, i);
            let dst: ptr = PTR_NULL();
            PTR_BYTE_ADD(dst, scratch_ptr, n);
            PTR_WRITE_U8(dst, b);
            n = n + 1;
        }
        parts = parts + 1;
    };
    // DEFECT: sys:/user0:/tools: parts skipped (see header note).
    if has_connectionId {
        if parts > 0 {
            let dst: ptr = PTR_NULL();
            PTR_BYTE_ADD(dst, scratch_ptr, n);
            PTR_WRITE_U8(dst, 124u8);
            n = n + 1;
        };
        let label = "conn:";
        for i in 0..STR_LEN(label) {
            let b: u8 = 0;
            let src: ptr = PTR_NULL();
            PTR_BYTE_ADD(src, STR_PTR(label), i);
            PTR_BYTE_AT(b, src, 0);
            let dst: ptr = PTR_NULL();
            PTR_BYTE_ADD(dst, scratch_ptr, n);
            PTR_WRITE_U8(dst, b);
            n = n + 1;
        }
        for i in 0..connectionId_len {
            let b: u8 = 0;
            PTR_BYTE_AT(b, connectionId_ptr, i);
            let dst: ptr = PTR_NULL();
            PTR_BYTE_ADD(dst, scratch_ptr, n);
            PTR_WRITE_U8(dst, b);
            n = n + 1;
        }
        parts = parts + 1;
    };
    if parts == 0 { return -1; };
    return omni_hash_hex(STR_PTR("sha256"), STR_LEN("sha256"), scratch_ptr, n, out_ptr, out_len, 16);
}

// ---------------------------------------------------------------------------
// Session identity resolution (omniRouteFree.ts:240-326)
// const OPENCODE_IDENTITY_HEADER_NAMES = [...] as const; (ts:240-253)
// const OPENCODE_IDENTITY_BODY_NAMES = [...] as const; (ts:254-261)
// DEFECT: readonly string tuple constants — kept as lookup functions over
// the literal lists.
// ---------------------------------------------------------------------------
fn omni_identity_header_name_at(index: u64, out_len: &u64) -> ptr {
    // "x-opencode-session", "x-ultra-thread-id", "x-codex-thread-id",
    // "x-session-affinity", "x-session-id", "x-claude-code-session-id",
    // "session_id", "session-id", "x-session_id", "thread_id",
    // "thread-id", "x-thread-id"
    if index == 0 { *out_len = 18; return STR_PTR("x-opencode-session"); };
    if index == 1 { *out_len = 17; return STR_PTR("x-ultra-thread-id"); };
    if index == 2 { *out_len = 17; return STR_PTR("x-codex-thread-id"); };
    if index == 3 { *out_len = 18; return STR_PTR("x-session-affinity"); };
    if index == 4 { *out_len = 12; return STR_PTR("x-session-id"); };
    if index == 5 { *out_len = 22; return STR_PTR("x-claude-code-session-id"); };
    if index == 6 { *out_len = 10; return STR_PTR("session_id"); };
    if index == 7 { *out_len = 10; return STR_PTR("session-id"); };
    if index == 8 { *out_len = 12; return STR_PTR("x-session_id"); };
    if index == 9 { *out_len = 9; return STR_PTR("thread_id"); };
    if index == 10 { *out_len = 9; return STR_PTR("thread-id"); };
    *out_len = 11;
    return STR_PTR("x-thread-id");
}

fn omni_identity_body_name_at(index: u64, out_len: &u64) -> ptr {
    // "session_id", "sessionId", "thread_id", "threadId",
    // "conversation_id", "conversationId"
    if index == 0 { *out_len = 10; return STR_PTR("session_id"); };
    if index == 1 { *out_len = 9; return STR_PTR("sessionId"); };
    if index == 2 { *out_len = 9; return STR_PTR("thread_id"); };
    if index == 3 { *out_len = 8; return STR_PTR("threadId"); };
    if index == 4 { *out_len = 15; return STR_PTR("conversation_id"); };
    *out_len = 14;
    return STR_PTR("conversationId");
}

// function opencodeIdentityRecord(value: unknown): Record<string, unknown> | undefined (ts:264-266)
// DEFECT: dynamic object — "is a non-array object" test on a JSON text
// value is approximated by the caller-supplied is_object flag; returns 0
// when the value is a record, -1 for TS undefined.
fn opencodeIdentityRecord(is_object: bool, is_array: bool) -> i32 {
    if is_object && !is_array { return 0; };
    return -1;
}

// function opencodeIdentityValue(value: unknown): string | undefined (ts:268-276)
// Returns 0 + trimmed value in out, -1 for TS undefined: value must be a
// string of length <= 256 with no control chars (code <= 31 or === 127),
// and non-empty after trim.
fn opencodeIdentityValue(is_string: bool, value_ptr: ptr, value_len: u64, out_ptr: ptr, out_len: &u64) -> i32 {
    *out_len = 0;
    if !is_string { return -1; };
    if value_len > 256 { return -1; };
    for i in 0..value_len {
        let code: u8 = 0;
        PTR_BYTE_AT(code, value_ptr, i);
        if code <= 31 || code == 127 { return -1; };
    }
    // trim — approximated by trimming spaces only (TS String.trim also
    // removes other whitespace; control whitespace is already rejected).
    let start: u64 = 0;
    let end: u64 = value_len;
    while start < end {
        let b: u8 = 0;
        PTR_BYTE_AT(b, value_ptr, start);
        if b != 32 { break; };
        start = start + 1;
    }
    while end > start {
        let b: u8 = 0;
        PTR_BYTE_AT(b, value_ptr, end - 1);
        if b != 32 { break; };
        end = end - 1;
    }
    if end == start { return -1; };
    for i in 0..end - start {
        let b: u8 = 0;
        PTR_BYTE_AT(b, value_ptr, start + i);
        let dst: ptr = PTR_NULL();
        PTR_BYTE_ADD(dst, out_ptr, i);
        PTR_WRITE_U8(dst, b);
    }
    *out_len = end - start;
    return 0;
}

// function opencodeBodyIdentity(value: unknown): string | undefined (ts:278-286)
// TS logic: for key of OPENCODE_IDENTITY_BODY_NAMES: first
// opencodeIdentityValue(record[key]) that is defined wins.
// DEFECT: dynamic object — key lookup inside the JSON text record is not
// implemented in this pass; always reports TS undefined.
fn opencodeBodyIdentity(record: &JsonText, record_is_object: bool, out_ptr: ptr, out_len: &u64) -> i32 {
    *out_len = 0;
    if opencodeIdentityRecord(record_is_object, false) != 0 { return -1; };
    return -1;
}

// function opencodeClaudeIdentity(value: unknown): string | undefined (ts:288-295)
// TS logic: string of length <= 4096 -> opencodeBodyIdentity(JSON.parse(value)),
// parse errors -> undefined.
// DEFECT: dynamic object — JSON.parse over the string is not implemented
// in this pass; always reports TS undefined.
fn opencodeClaudeIdentity(is_string: bool, value_ptr: ptr, value_len: u64, out_ptr: ptr, out_len: &u64) -> i32 {
    *out_len = 0;
    if !is_string { return -1; };
    if value_len > 4096 { return -1; };
    return -1;
}

// Headers win over metadata; an opaque user/account ID is never a session ID.
// export function resolveOpencodeSessionIdentity(headers, body?): string | undefined (ts:297-318)
// Returns 0 + identity in out, -1 for TS undefined.
// TS logic: normalize headers into a lowercase-keyed Map (Headers.forEach
// or Object.entries), try OPENCODE_IDENTITY_HEADER_NAMES in order, then
// body metadata record, then Claude user_id JSON, then the body itself.
// DEFECT: dynamic object — HeaderMap reads and body/metadata JSON lookups
// are not implemented in this pass (see omni_headers_get /
// opencodeBodyIdentity), so only the header-name loop is expressed and it
// finds nothing until the header store lands.
fn resolveOpencodeSessionIdentity(has_headers: bool, headers: &HeaderMap, has_body: bool, body: &JsonText, out_ptr: ptr, out_len: &u64) -> i32 {
    *out_len = 0;
    if has_headers {
        for i in 0..12 {
            let name_len: u64 = 0;
            let name_ptr: ptr = omni_identity_header_name_at(i, &name_len);
            let value_len: u64 = 0;
            let value_buf: [u8; 512] = [0u8; 512];
            let value_ptr: ptr = PTR_NULL();
            PTR_BYTE_ADD(value_ptr, &value_buf, 0);
            if omni_headers_get(headers, name_ptr, name_len, value_ptr, &value_len) {
                if opencodeIdentityValue(true, value_ptr, value_len, out_ptr, out_len) == 0 { return 0; };
            };
        }
    };
    if has_body {
        // opencodeBodyIdentity(metadata) || opencodeClaudeIdentity(metadata?.user_id) || opencodeBodyIdentity(input)
        // DEFECT: dynamic object — metadata extraction not implemented.
        if opencodeBodyIdentity(body, true, out_ptr, out_len) == 0 { return 0; };
    };
    return -1;
}

// The session id the caller supplied, if any.
// export function clientSuppliedOpencodeSession(clientHeaders, body?): string | undefined (ts:320-326)
fn clientSuppliedOpencodeSession(has_headers: bool, headers: &HeaderMap, has_body: bool, body: &JsonText, out_ptr: ptr, out_len: &u64) -> i32 {
    return resolveOpencodeSessionIdentity(has_headers, headers, has_body, body, out_ptr, out_len);
}

// ---------------------------------------------------------------------------
// Model prefix strip (omniRouteFree.ts:327-337)
// const OPENCODE_MODEL_PREFIXES = ["opencode/", "oc/", "opencode-zen/", "opencode-go/"] as const; (ts:327)
// ---------------------------------------------------------------------------

// Strip `opencode/`-family prefixes: Responses endpoint only accepts the bare upstream id.
// export function stripOpencodeModelPrefix(model: unknown): unknown (ts:330-337)
// DEFECT: unknown in/out type — non-string input is returned unchanged in
// TS; here the caller passes is_string and a byte buffer, and the stripped
// view is written to out (same buffer content when no prefix matches).
fn stripOpencodeModelPrefix(is_string: bool, model_ptr: ptr, model_len: u64, out_ptr: ptr, out_len: &u64) -> i32 {
    if !is_string {
        *out_len = 0;
        return 0;
    };
    let start: u64 = 0;
    if omni_str_starts_with(model_ptr, model_len, STR_PTR("opencode/"), STR_LEN("opencode/")) {
        start = STR_LEN("opencode/");
    } else {
        if omni_str_starts_with(model_ptr, model_len, STR_PTR("oc/"), STR_LEN("oc/")) {
            start = STR_LEN("oc/");
        } else {
            if omni_str_starts_with(model_ptr, model_len, STR_PTR("opencode-zen/"), STR_LEN("opencode-zen/")) {
                start = STR_LEN("opencode-zen/");
            } else {
                if omni_str_starts_with(model_ptr, model_len, STR_PTR("opencode-go/"), STR_LEN("opencode-go/")) {
                    start = STR_LEN("opencode-go/");
                };
            };
        };
    };
    for i in 0..model_len - start {
        let b: u8 = 0;
        PTR_BYTE_AT(b, model_ptr, start + i);
        let dst: ptr = PTR_NULL();
        PTR_BYTE_ADD(dst, out_ptr, i);
        PTR_WRITE_U8(dst, b);
    }
    *out_len = model_len - start;
    return 0;
}

// ---------------------------------------------------------------------------
// muse-spark minimum output budget (omniRouteFree.ts:339-356)
// muse-spark (opencode-go) burns its entire output budget on invisible
// server-side reasoning before emitting any content. Floor raised budgets
// only — explicit large budgets and non-muse-spark models are untouched,
// and no budget is synthesized when the caller set none.
// export const MUSE_SPARK_MIN_OUTPUT_TOKENS = 512; (ts:347)
// ---------------------------------------------------------------------------
fn omni_muse_spark_min_output_tokens() -> u64 {
    return 512;
}

// export function applyMuseSparkMinOutputTokens(model: string, body: Record<string, unknown>): void (ts:349-356)
// Mutates body.max_tokens / body.max_output_tokens up to the floor when
// they are finite numbers below it.
// DEFECT: dynamic object — the body is JSON text; reading/writing numeric
// fields max_tokens / max_output_tokens inside it is not implemented in
// this pass, so the mutation is a no-op here.
fn applyMuseSparkMinOutputTokens(model_ptr: ptr, model_len: u64, body: &JsonText) -> i32 {
    if !omni_str_starts_with(model_ptr, model_len, STR_PTR("muse-spark"), STR_LEN("muse-spark")) { return 0; };
    return 0;
}

// ---------------------------------------------------------------------------
// Target format resolution (omniRouteFree.ts:358-385)
// const OPENCODE_MUSE_SPARK_ALIASES = new Set(["oc", "opencode", "opencode-zen", "opencode-go"]); (ts:358)
// const OPENCODE_MUSE_SPARK_PATTERN = /^muse-spark(?:-|$)/i; (ts:359)
// const OPENCODE_GENERIC_EFFORT_SUFFIX_RE = /-(?:ultra|max|xhigh|high|medium|low|none)$/i; (ts:360)
// DEFECT: Set<string> — membership expressed as compares (see below).
// DEFECT: regex — pattern tests approximated by prefix/suffix compares.
// ---------------------------------------------------------------------------
fn omni_muse_spark_alias_contains(value_ptr: ptr, value_len: u64) -> bool {
    if omni_str_eq(value_ptr, value_len, STR_PTR("oc"), STR_LEN("oc")) { return true; };
    if omni_str_eq(value_ptr, value_len, STR_PTR("opencode"), STR_LEN("opencode")) { return true; };
    if omni_str_eq(value_ptr, value_len, STR_PTR("opencode-zen"), STR_LEN("opencode-zen")) { return true; };
    if omni_str_eq(value_ptr, value_len, STR_PTR("opencode-go"), STR_LEN("opencode-go")) { return true; };
    return false;
}

// /^muse-spark(?:-|$)/i approximated: equal to "muse-spark" or prefixed
// by "muse-spark-".
fn omni_muse_spark_pattern_test(value_ptr: ptr, value_len: u64) -> bool {
    if omni_str_eq(value_ptr, value_len, STR_PTR("muse-spark"), STR_LEN("muse-spark")) { return true; };
    return omni_str_starts_with(value_ptr, value_len, STR_PTR("muse-spark-"), STR_LEN("muse-spark-"));
}

// Registry targetFormat: muse-spark family is Responses-only, everything else is Chat Completions.
// export function resolveOpencodeTargetFormat(provider: string, model: string): string (ts:368-385)
// Writes "openai-responses" or "openai" to out.
// DEFECT: String(provider ?? "").trim() — trim approximated by raw bytes.
// DEFECT: bare.split("/").pop() — last path segment taken by scanning for
// the final '/'; equivalent for the inputs used here.
fn resolveOpencodeTargetFormat(provider_ptr: ptr, provider_len: u64, model_ptr: ptr, model_len: u64, out_ptr: ptr, out_len: &u64) -> i32 {
    // const rawProvider = String(provider ?? "").trim() || "opencode";
    let p_ptr: ptr = provider_ptr;
    let p_len: u64 = provider_len;
    if p_len == 0 {
        p_ptr = STR_PTR("opencode");
        p_len = STR_LEN("opencode");
    };
    // const aliased = rawProvider === "opencode" ? "oc" : rawProvider;
    let a_ptr: ptr = p_ptr;
    let a_len: u64 = p_len;
    if omni_str_eq(p_ptr, p_len, STR_PTR("opencode"), STR_LEN("opencode")) {
        a_ptr = STR_PTR("oc");
        a_len = STR_LEN("oc");
    };
    // const stripped = String(stripOpencodeModelPrefix(model) ?? "");
    let stripped_buf: [u8; 512] = [0u8; 512];
    let stripped_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(stripped_ptr, &stripped_buf, 0);
    let stripped_len: u64 = 0;
    stripOpencodeModelPrefix(true, model_ptr, model_len, stripped_ptr, &stripped_len);
    // const parsed = parseOpencodeEffortLevel(stripped) ?? parseOpencodeEffortLevel(String(model ?? ""));
    // const bare = parsed ? parsed.baseModel : stripped;
    let bare_buf: [u8; 512] = [0u8; 512];
    let bare_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(bare_ptr, &bare_buf, 0);
    let bare_len: u64 = 0;
    let effort_buf: [u8; 64] = [0u8; 64];
    let effort_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(effort_ptr, &effort_buf, 0);
    let effort_len: u64 = 0;
    if parseOpencodeEffortLevel(stripped_ptr, stripped_len, bare_ptr, &bare_len, effort_ptr, &effort_len) == 0 {
        // parsed from stripped
    } else {
        if parseOpencodeEffortLevel(model_ptr, model_len, bare_ptr, &bare_len, effort_ptr, &effort_len) == 0 {
            // parsed from raw model
        } else {
            for i in 0..stripped_len {
                let b: u8 = 0;
                PTR_BYTE_AT(b, stripped_ptr, i);
                let dst: ptr = PTR_NULL();
                PTR_BYTE_ADD(dst, bare_ptr, i);
                PTR_WRITE_U8(dst, b);
            }
            bare_len = stripped_len;
        };
    };
    // const familyId = bare.split("/").pop() || bare;
    let fam_off: u64 = 0;
    for i in 0..bare_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, bare_ptr, i);
        if b == 47 { fam_off = i + 1; };
    }
    let fam_ptr: ptr = omni_padd(bare_ptr, fam_off);
    let fam_len: u64 = bare_len - fam_off;
    if fam_len == 0 {
        fam_ptr = bare_ptr;
        fam_len = bare_len;
    };
    let result = "openai";
    if omni_muse_spark_alias_contains(a_ptr, a_len) && omni_muse_spark_pattern_test(fam_ptr, fam_len) {
        result = "openai-responses";
    } else {
        // Generic effort-suffix fallback: strip
        // /-(?:ultra|max|xhigh|high|medium|low|none)$/i and re-test.
        // DEFECT: regex — suffix alternation approximated by explicit
        // suffix compares (longest first not required: suffixes are
        // mutually exclusive at the end anchor except none/low etc.,
        // which do not overlap).
        let es_ptr: ptr = fam_ptr;
        let es_len: u64 = fam_len;
        if omni_str_ends_with(fam_ptr, fam_len, STR_PTR("-ultra"), STR_LEN("-ultra")) {
            es_len = fam_len - STR_LEN("-ultra");
        } else {
            if omni_str_ends_with(fam_ptr, fam_len, STR_PTR("-xhigh"), STR_LEN("-xhigh")) {
                es_len = fam_len - STR_LEN("-xhigh");
            } else {
                if omni_str_ends_with(fam_ptr, fam_len, STR_PTR("-high"), STR_LEN("-high")) {
                    es_len = fam_len - STR_LEN("-high");
                } else {
                    if omni_str_ends_with(fam_ptr, fam_len, STR_PTR("-medium"), STR_LEN("-medium")) {
                        es_len = fam_len - STR_LEN("-medium");
                    } else {
                        if omni_str_ends_with(fam_ptr, fam_len, STR_PTR("-max"), STR_LEN("-max")) {
                            es_len = fam_len - STR_LEN("-max");
                        } else {
                            if omni_str_ends_with(fam_ptr, fam_len, STR_PTR("-low"), STR_LEN("-low")) {
                                es_len = fam_len - STR_LEN("-low");
                            } else {
                                if omni_str_ends_with(fam_ptr, fam_len, STR_PTR("-none"), STR_LEN("-none")) {
                                    es_len = fam_len - STR_LEN("-none");
                                };
                            };
                        };
                    };
                };
            };
        };
        if es_len != fam_len && omni_muse_spark_alias_contains(a_ptr, a_len) && omni_muse_spark_pattern_test(es_ptr, es_len) {
            result = "openai-responses";
        };
    };
    for i in 0..STR_LEN(result) {
        let b: u8 = 0;
        let src: ptr = PTR_NULL();
        PTR_BYTE_ADD(src, STR_PTR(result), i);
        PTR_BYTE_AT(b, src, 0);
        let dst: ptr = PTR_NULL();
        PTR_BYTE_ADD(dst, out_ptr, i);
        PTR_WRITE_U8(dst, b);
    }
    *out_len = STR_LEN(result);
    return 0;
}

