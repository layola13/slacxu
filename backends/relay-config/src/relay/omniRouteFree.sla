// export function isBodyContractEnabled(): boolean (ts:1863-1865)
// (forwards to isOpencodeFreeTierBodyContractEnabled, defined below)
fn isBodyContractEnabled() -> bool {
    return isOpencodeFreeTierBodyContractEnabled();
}

// Test clock for the shape memo (ts:1874-1877):
// let opencodeShapeNow: () => number = () => Date.now();
