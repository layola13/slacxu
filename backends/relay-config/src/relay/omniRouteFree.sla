// eligible free chat models".
// DEFECT: async + fetch — not performed; the EXPLICIT_FREE_MODELS
// fallback path is what remains reachable, and it is what runs here.
fn fetchOmniRouteFreeModels(cache: &OpencodeCliVersionCache, options: &OmniRouteFreeFetchOptions, out: &FetchModelsResult) -> i32 {
    out.models.len = 0;
