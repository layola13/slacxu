// DEFECT: dynamic object — the parameters constant is kept as JSON text.
fn omni_placeholder_tool_parameters_json(out_len: &u64) -> ptr {
    *out_len = 31;
    return STR_PTR("{\"type\":\"object\",\"properties\":{}}");
}

// Genuine `read` tool captured from the official CLI (opencodeKernel.ts).
// The upstream free-tier gate refuses third-party tool vocabularies; a
// synthetic placeholder no longer passes.
// const OPENCODE_READ_TOOL_NAME = "read"; (ts:512)
// const OPENCODE_READ_TOOL_PARAMETERS = { properties: { filePath: {...},
//   offset: {...}, limit: {...} }, required: ["filePath"], type: "object" } as const; (ts:513-531)
// DEFECT: dynamic object — parameters constant kept as JSON text.
fn omni_read_tool_parameters_json(out_len: &u64) -> ptr {
    let text = "{\"properties\":{\"filePath\":{\"description\":\"The absolute path to the file or directory to read\",\"type\":\"string\"},\"offset\":{\"description\":\"The line number to start reading from (1-indexed)\",\"type\":\"integer\"},\"limit\":{\"description\":\"The maximum number of lines to read (defaults to 2000)\",\"type\":\"integer\"}},\"required\":[\"filePath\"],\"type\":\"object\"}";
    *out_len = STR_LEN(text);
    return STR_PTR(text);
}

// function opencodeToolEntryName(tool: unknown): string | null (ts:533-539)
// Returns 0 + name in out, -1 for TS null.
// DEFECT: dynamic object — name/function.name lookup inside the tool JSON
// entry is not implemented in this pass; always reports TS null.
fn opencodeToolEntryName(tool_json: &JsonText, tool_is_object: bool, out_ptr: ptr, out_len: &u64) -> i32 {
    *out_len = 0;
    return -1;
}

// Bring a free-tier request up to the upstream contract: stream + genuine native tool. Idempotent.
// export function applyOpencodeFreeTierRequestContract<T>(body: T, requestFormat: string | null = "openai-responses", placeholderNames: readonly string[] = []): T (ts:541-596)
// DEFECT: generic <T> — no generics; body is a JsonText mutated in place,
// status code replaces the returned (possibly new) body object.
// DEFECT: dynamic object — the TS body rebuild ({ ...record, stream: true },
// tools array append of the genuine `read` tool in flat (responses) or
// nested function (chat) shape plus placeholder tools for namesToAdd)
// requires JSON object manipulation not implemented in this pass; the
// decision logic is recorded below and the body is left unchanged.
// TS decision logic:
//   if body is not a non-array object -> return body unchanged.
//   existingNames = set of opencodeToolEntryName over record.tools.
//   namesToAdd = placeholderNames not in existingNames.
//   needsReadTool = !existingNames.has("read").
//   if namesToAdd empty && !needsReadTool -> return { ...record, stream: true }.
//   requestFormat "openai-responses" -> flat tool entries appended.
//   requestFormat "openai" | null -> nested { type:"function", function:{...} }.
//   other formats -> stream:true only.
fn applyOpencodeFreeTierRequestContract(body: &JsonText, body_is_object: bool, has_format: bool, format_ptr: ptr, format_len: u64, placeholderNames: &StrList) -> i32 {
    if !body_is_object { return 0; };
    return 0;
}

// ---------------------------------------------------------------------------
// True-client kernel (omniRouteFree.ts:598-814)
// Port of open-sse/executors/opencodeKernel.ts. Keyless free-tier models on
// `opencode`/`opencode-zen` go out on the real client surface
// `https://opencode.ai/inference/v1` with the real client request shape,
// instead of the zen surface + synthesized contract.
// export const OPENCODE_KERNEL_BASE_URL = "https://opencode.ai/inference/v1"; (ts:605)
// export const OPENCODE_KERNEL_CHAT_USER_AGENT = "opencode/1.19.0 ai-sdk/provider-utils/4.0.23 runtime/bun/1.3.14"; (ts:606)
// export const OPENCODE_KERNEL_RESPONSES_USER_AGENT = "opencode/1.19.0 ai-sdk/provider-utils/4.0.40 runtime/bun/1.3.14"; (ts:607)
// export const OPENCODE_KERNEL_PUBLIC_KEY = "public"; (ts:608)
// export type OpencodeKernelSurface = "chat" | "responses"; (ts:609)
// DEFECT: string-literal union type — (ptr, len) string "chat"/"responses".
// const OPENCODE_KERNEL_PROVIDERS = new Set(["opencode", "opencode-zen"]); (ts:610)
// const OPENCODE_KERNEL_RESPONSES_PATTERN = /^muse-spark(?:-|$)/i; (ts:611)
// DEFECT: Set — membership as compares. DEFECT: regex — see pattern test.
// ---------------------------------------------------------------------------
fn omni_kernel_providers_contains(value_ptr: ptr, value_len: u64) -> bool {
    if omni_str_eq(value_ptr, value_len, STR_PTR("opencode"), STR_LEN("opencode")) { return true; };
    if omni_str_eq(value_ptr, value_len, STR_PTR("opencode-zen"), STR_LEN("opencode-zen")) { return true; };
    return false;
}

// Kernel `read` tool parameters (zen.go `zenKernelReadParams`).
// const OPENCODE_KERNEL_READ_PARAMETERS = { type: "object", properties: { path: { type: "string" } }, required: ["path"] } as const; (ts:614-621)
// DEFECT: dynamic object — kept as JSON text.
fn omni_kernel_read_parameters_json(out_len: &u64) -> ptr {
    let text = "{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"}},\"required\":[\"path\"]}";
    *out_len = STR_LEN(text);
    return STR_PTR(text);
}

// Upstream's own title-generation prompt (zen.go `zenTitleTemplate`).
// const OPENCODE_KERNEL_TITLE_TEMPLATE = `You are a title generator. ...`; (ts:623-667)
// DEFECT: multi-line template literal — kept as one string constant with
// \n escapes; the full text is reproduced in the defect log note and used
// via STR_PTR at the single call site (buildKernelResponsesBody).
fn omni_kernel_title_template(out_len: &u64) -> ptr {
    let text = "You are a title generator. You output ONLY a thread title. Nothing else.\n\n<task>\nGenerate a brief title that would help the user find this conversation later.\n\nFollow all rules in <rules>\nUse the <examples> so you know what a good title looks like.\nYour output must be:\n- A single line\n- \xe2\x89\xa450 characters\n- No explanations\n</task>";
    *out_len = STR_LEN(text);
    return STR_PTR(text);
}

// function resolveKernelDefaultMaxTokens(): number (ts:669-677)
