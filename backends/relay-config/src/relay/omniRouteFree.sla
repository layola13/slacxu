// ---------------------------------------------------------------------------
// Geo-block / refusal predicates (omniRouteFree.ts:1755-1860)
// Port of opencodeGeoBlock.ts refusal predicates (fail-closed exact substrings).
// const OPENCODE_FINGERPRINT_1010_RE =
//   /(?<![A-Za-z0-9_-])error[\s_-]?code["':=\s]{0,12}1010(?!\w)|.../i; (ts:1756-1757)
// const OPENCODE_REGION_ERROR_RE = /(?<![A-Za-z0-9_-])regionerror(?![A-Za-z0-9_-])/i; (ts:1758)
// const OPENCODE_FREE_TIER_SIGNALS = ["freetiererror", "free tier can only be used"]; (ts:1759)
// const OPENCODE_GEO_SIGNALS = ["not available in your country",
//   "not available in your region", "unsupported_country",
//   "unsupported country"]; (ts:1760-1765)
// const OPENCODE_QUOTA_SHAPE_SIGNAL = "insufficient_quota"; (ts:1766)
// DEFECT: regex — the 1010 fingerprint and regionerror lookaround
// patterns cannot be expressed; approximated by substring searches for
// "1010" / "regionerror" (broader than TS: boundary classes unchecked).
// DEFECT: case handling — TS lowercases the text before includes();
// SLA compares against the caller-supplied bytes as-is.
// ---------------------------------------------------------------------------

// function opencodeIsFingerprintRejection(bodyText: string): boolean (ts:1768-1776)
fn opencodeIsFingerprintRejection(text_ptr: ptr, text_len: u64) -> bool {
    if omni_str_contains(text_ptr, text_len, STR_PTR("1010"), STR_LEN("1010")) { return true; };
    if omni_str_contains(text_ptr, text_len, STR_PTR("browser_signature_banned"), STR_LEN("browser_signature_banned")) { return true; };
    if omni_str_contains(text_ptr, text_len, STR_PTR("fingerprint_rejection"), STR_LEN("fingerprint_rejection")) { return true; };
    return false;
}

// export function isOpencodeGeoBlocked(status: number, bodyText: string | null): boolean (ts:1778-1784)
fn isOpencodeGeoBlocked(status: u64, has_text: bool, text_ptr: ptr, text_len: u64) -> bool {
    if status != 403 && status != 451 { return false; };
    if !has_text {
        text_len = 0;
    };
    if opencodeIsFingerprintRejection(text_ptr, text_len) { return false; };
    if omni_str_contains(text_ptr, text_len, STR_PTR("regionerror"), STR_LEN("regionerror")) { return true; };
    if omni_str_contains(text_ptr, text_len, STR_PTR("not available in your country"), STR_LEN("not available in your country")) { return true; };
    if omni_str_contains(text_ptr, text_len, STR_PTR("not available in your region"), STR_LEN("not available in your region")) { return true; };
    if omni_str_contains(text_ptr, text_len, STR_PTR("unsupported_country"), STR_LEN("unsupported_country")) { return true; };
    if omni_str_contains(text_ptr, text_len, STR_PTR("unsupported country"), STR_LEN("unsupported country")) { return true; };
    return false;
}

// export function isOpencodeUserBlocked(status: number, bodyText: string | null): boolean (ts:1786-1790)
fn isOpencodeUserBlocked(status: u64, has_text: bool, text_ptr: ptr, text_len: u64) -> bool {
    if status != 403 && status != 451 { return false; };
    if !has_text {
        text_len = 0;
    };
    if opencodeIsFingerprintRejection(text_ptr, text_len) { return false; };
    if isOpencodeGeoBlocked(status, true, text_ptr, text_len) { return false; };
    return omni_str_contains(text_ptr, text_len, STR_PTR("user_blocked"), STR_LEN("user_blocked"));
}

// export function isOpencodeFreeTierRefusal(status: number, bodyText: string | null): boolean (ts:1792-1803)
fn isOpencodeFreeTierRefusal(status: u64, has_text: bool, text_ptr: ptr, text_len: u64) -> bool {
    if status != 403 && status != 451 { return false; };
    if !has_text {
        text_len = 0;
    };
    if opencodeIsFingerprintRejection(text_ptr, text_len) { return false; };
    if isOpencodeGeoBlocked(status, true, text_ptr, text_len) { return false; };
    if isOpencodeUserBlocked(status, true, text_ptr, text_len) { return false; };
    if omni_str_contains(text_ptr, text_len, STR_PTR("freetiererror"), STR_LEN("freetiererror")) { return true; };
    if omni_str_contains(text_ptr, text_len, STR_PTR("free tier can only be used"), STR_LEN("free tier can only be used")) { return true; };
    return false;
}

// export function isOpencodeQuotaShapeRefusal(status: number, bodyText: string | null): boolean (ts:1805-1816)
fn isOpencodeQuotaShapeRefusal(status: u64, has_text: bool, text_ptr: ptr, text_len: u64) -> bool {
    if status != 403 && status != 451 { return false; };
    if !has_text {
        text_len = 0;
    };
    if opencodeIsFingerprintRejection(text_ptr, text_len) { return false; };
    if isOpencodeGeoBlocked(status, true, text_ptr, text_len) { return false; };
    if isOpencodeUserBlocked(status, true, text_ptr, text_len) { return false; };
    return omni_str_contains(text_ptr, text_len, STR_PTR("insufficient_quota"), STR_LEN("insufficient_quota"));
}

// export function isOwnOpencodeToolsRetryableRefusal(status: number, bodyText: string | null): boolean (ts:1818-1823)
fn isOwnOpencodeToolsRetryableRefusal(status: u64, has_text: bool, text_ptr: ptr, text_len: u64) -> bool {
    return isOpencodeFreeTierRefusal(status, has_text, text_ptr, text_len) || isOpencodeQuotaShapeRefusal(status, has_text, text_ptr, text_len);
}

// Port of `isOpencodeFreeTierRefusalForProvider`: scope free-tier verdict to opencode family.
// export function isOpencodeFreeTierRefusalForProvider(provider, status, bodyText): boolean (ts:1825-1842)
// DEFECT: provider.trim().toLowerCase() — trim/case-fold approximated by
// raw compares plus the prefix tests below.
fn isOpencodeFreeTierRefusalForProvider(has_provider: bool, provider_ptr: ptr, provider_len: u64, status: u64, has_text: bool, text_ptr: ptr, text_len: u64) -> bool {
    if !has_provider { return false; };
    let family = false;
    if omni_str_eq(provider_ptr, provider_len, STR_PTR("opencode"), STR_LEN("opencode")) { family = true; };
    if omni_str_eq(provider_ptr, provider_len, STR_PTR("opencode-zen"), STR_LEN("opencode-zen")) { family = true; };
    if omni_str_eq(provider_ptr, provider_len, STR_PTR("opencode-go"), STR_LEN("opencode-go")) { family = true; };
    if omni_str_eq(provider_ptr, provider_len, STR_PTR("oc"), STR_LEN("oc")) { family = true; };
    if omni_str_starts_with(provider_ptr, provider_len, STR_PTR("opencode/"), STR_LEN("opencode/")) { family = true; };
    if omni_str_starts_with(provider_ptr, provider_len, STR_PTR("opencode-"), STR_LEN("opencode-")) { family = true; };
    if omni_str_starts_with(provider_ptr, provider_len, STR_PTR("oc/"), STR_LEN("oc/")) { family = true; };
    if !family { return false; };
    return isOpencodeFreeTierRefusal(status, has_text, text_ptr, text_len);
}

// Port of `proxyKeyOf` / `poolReselectKeyOf` (opencodeGeoBlock.ts).
// export function opencodeProxyKeyOf(proxy: { host: string; port: number } | null): string | null (ts:1844-1847)
// Returns 0 + `${host}:${port}` in out, -1 for TS null.
fn opencodeProxyKeyOf(has_proxy: bool, host_ptr: ptr, host_len: u64, port: u64, out_ptr: ptr, out_len: &u64) -> i32 {
    if !has_proxy { return -1; };
    let n: u64 = 0;
    for i in 0..host_len {
        let b: u8 = 0;
        PTR_BYTE_AT(b, host_ptr, i);
        let dst: ptr = PTR_NULL();
        PTR_BYTE_ADD(dst, out_ptr, n);
        PTR_WRITE_U8(dst, b);
        n = n + 1;
    }
    let colon: ptr = PTR_NULL();
    PTR_BYTE_ADD(colon, out_ptr, n);
    PTR_WRITE_U8(colon, 58u8);
    n = n + 1;
    // Decimal render of port (TS template literal on a number).
    let digits: [u8; 20] = [0u8; 20];
    let digits_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(digits_ptr, &digits, 0);
    let dcount: u64 = 0;
    let v: u64 = port;
    if v == 0 {
        let dst: ptr = PTR_NULL();
        PTR_BYTE_ADD(dst, digits_ptr, 0);
        PTR_WRITE_U8(dst, 48u8);
        dcount = 1;
    } else {
        let rev: [u8; 20] = [0u8; 20];
        let rev_ptr: ptr = PTR_NULL();
        PTR_BYTE_ADD(rev_ptr, &rev, 0);
        let rc: u64 = 0;
        while v > 0 {
            let dst: ptr = PTR_NULL();
            PTR_BYTE_ADD(dst, rev_ptr, rc);
            PTR_WRITE_U8(dst, (48 + (v % 10)) as u8);
            rc = rc + 1;
            v = v / 10;
        }
        for i in 0..rc {
            let b: u8 = 0;
            PTR_BYTE_AT(b, rev_ptr, rc - 1 - i);
            let dst: ptr = PTR_NULL();
            PTR_BYTE_ADD(dst, digits_ptr, i);
            PTR_WRITE_U8(dst, b);
        }
        dcount = rc;
    };
    for i in 0..dcount {
        let b: u8 = 0;
        PTR_BYTE_AT(b, digits_ptr, i);
        let dst: ptr = PTR_NULL();
        PTR_BYTE_ADD(dst, out_ptr, n);
        PTR_WRITE_U8(dst, b);
        n = n + 1;
    }
    *out_len = n;
    return 0;
}

// export function opencodePoolReselectKeyOf(candidate: unknown): string | null (ts:1848-1852)
// DEFECT: dynamic object — host/port extraction from the candidate JSON
// is not implemented in this pass; the caller supplies decoded fields and
// this forwards to opencodeProxyKeyOf.
fn opencodePoolReselectKeyOf(candidate_is_object: bool, host_is_string: bool, host_ptr: ptr, host_len: u64, port_is_number: bool, port: u64, out_ptr: ptr, out_len: &u64) -> i32 {
    if !candidate_is_object { return -1; };
    if !host_is_string || !port_is_number { return -1; };
    return opencodeProxyKeyOf(true, host_ptr, host_len, port, out_ptr, out_len);
}

// Port of `preserveOpencodeSessionIdentity`: keep explicit conversation identity.
// export function preserveOpencodeSessionIdentity(headers, body?): string | undefined (ts:1854-1860)
fn preserveOpencodeSessionIdentity(has_headers: bool, headers: &HeaderMap, has_body: bool, body: &JsonText, out_ptr: ptr, out_len: &u64) -> i32 {
    return resolveOpencodeSessionIdentity(has_headers, headers, has_body, body, out_ptr, out_len);
}

