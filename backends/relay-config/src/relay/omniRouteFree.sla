// Converted 1:1 from backends/relay-config/src/relay/omniRouteFree.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
//
// OmniRoute free-tier surface: OpenCode zen/go free models, the true-client
// kernel send shape, KiloCode / Cline / Freebuff / D2API free groups, and the
// request-shape learning machinery ported from the upstream executors.
//
// Conversion conventions for this file (see CONVERSION_BRIEF.md):
// - TS string -> (ptr, len) parameter pairs / fixed byte-array fields + len.
// - TS Record<string, unknown> / unknown JSON bodies -> JsonText buffer
//   (raw JSON text) with `// DEFECT: dynamic object` at each use site.
// - TS Headers / Record<string, string> header maps -> HeaderMap (JSON text
//   of a flat string->string object) with get/set helper stubs.
// - async functions -> synchronous functions returning a status code
//   (0 = ok), with `// DEFECT: async` at the signature.
// - RegExp literals -> pattern text constants + `// DEFECT: regex`.
// - Set/Map/WeakMap module state -> fixed-capacity arrays / single slots
//   with `// DEFECT:` at each declaration.
@import "sa_std/io/print.sai"
@import "sa_std/ptr.sa"
@import "sa_std/string.sa"
@import "freebuffSession.sla"
@import "sa_std/identity.sai"

fn omni_padd(p: ptr, off: u64) -> ptr {
    let q: ptr = PTR_NULL();
    PTR_BYTE_ADD(q, p, off);
    return q;
}


// ---------------------------------------------------------------------------
// FIX (WeakMap rebind, sci 17323ae4): the TS WeakMaps in this file
// (kernelIdentityByOrigin, opencodeForcedShape,
// opencodeInjectionContexts, opencodeContractAttempts) are
// identity-keyed side tables with no GC-reclamation dependence;
// they are now backed by sa_idmap (sa_std/identity.sai) — strong
// references, u64 identity tokens, true multi-entry storage. The
// previous conversion degraded them to single slots (a second
// origin evicted the first); that degradation is removed.
// Blob helpers: values are packed little-endian byte blobs.
// ---------------------------------------------------------------------------

fn omni_put_u64(p: ptr, off: u64, v: u64) -> void {
    let x = v;
    let k: u64 = 0;
    while k < 8 {
        let dst: ptr = PTR_NULL();
        PTR_BYTE_ADD(dst, p, off + k);
        PTR_WRITE_U8(dst, (x % 256) as u8);
        x = x / 256;
        k = k + 1;
    }
}

fn omni_get_u64(p: ptr, off: u64) -> u64 {
    let acc: u64 = 0;
    let mult: u64 = 1;
    let k: u64 = 0;
    while k < 8 {
        let b: u8 = 0;
        let src: ptr = PTR_NULL();
        PTR_BYTE_ADD(src, p, off + k);
        PTR_BYTE_AT(b, src, 0);
        acc = acc + (b as u64) * mult;
        mult = mult * 256;
        k = k + 1;
    }
    return acc;
}

fn omni_put_u8(p: ptr, off: u64, v: bool) -> void {
    let dst: ptr = PTR_NULL();
    PTR_BYTE_ADD(dst, p, off);
    if v { PTR_WRITE_U8(dst, 1); } else { PTR_WRITE_U8(dst, 0); };
}

fn omni_get_u8(p: ptr, off: u64) -> bool {
    let b: u8 = 0;
    let src: ptr = PTR_NULL();
    PTR_BYTE_ADD(src, p, off);
    PTR_BYTE_AT(b, src, 0);
    return b != 0;
}

fn omni_copy(dst_base: ptr, dst_off: u64, src_base: ptr, n: u64) -> void {
    for i in 0..n {
        let b: u8 = 0;
        let src: ptr = PTR_NULL();
        PTR_BYTE_ADD(src, src_base, i);
        PTR_BYTE_AT(b, src, 0);
        let dst: ptr = PTR_NULL();
        PTR_BYTE_ADD(dst, dst_base, dst_off + i);
        PTR_WRITE_U8(dst, b);
    }
}

fn omni_ensure_map(existing: u64) -> u64 {
    if existing != 0 { return existing; };
    let h: u64 = 0;
    sa_idmap_new(&h);
    return h;
}


// ---------------------------------------------------------------------------
// Shared approximation types (this file only)
// ---------------------------------------------------------------------------

// DEFECT: dynamic object — a TS JSON value (Record<string, unknown> /
// unknown) has no SLA counterpart; carried as raw JSON text.
struct JsonText {
    bytes: [u8; 262144],
    len: u64,
}

// DEFECT: dynamic object — fetch Headers / Record<string, string> header map
// approximated as JSON text of a flat string->string object.
struct HeaderMap {
    bytes: [u8; 16384],
    len: u64,
}

// DEFECT: string[] / readonly string[] — approximated as newline-joined
// buffer + count (no owned array-of-strings type).
struct StrList {
    bytes: [u8; 65536],
    len: u64,
    count: u64,
}

// Result of the async model-fetch functions: models list + fetched count.
// DEFECT: TS returns Promise<{ models: string[]; fetchedModels: number }>;
// here the caller passes an out struct and the function returns a status code.
struct FetchModelsResult {
    models: StrList,
    fetchedModels: u64,
}

// ChannelGroupConfig comes from "@codex-ui/shared" (omniRouteFree.ts:5).
// DEFECT: dynamic object — the full config shape lives in the shared package;
// approximated here as the fields this file reads/writes plus a JSON tail.
struct ChannelGroupConfig {
    id_bytes: [u8; 128],
    id_len: u64,
    name_bytes: [u8; 256],
    name_len: u64,
    baseUrl_bytes: [u8; 512],
    baseUrl_len: u64,
    kind_bytes: [u8; 32],
    kind_len: u64,
    status_bytes: [u8; 32],
    status_len: u64,
    groupRatio: f64,
    models: StrList,
    has_contextWindow: bool,
    contextWindow: u64,
    responseProtocol_bytes: [u8; 64],
    responseProtocol_len: u64,
    responseProtocolMode_bytes: [u8; 32],
    responseProtocolMode_len: u64,
    remark_bytes: [u8; 512],
    remark_len: u64,
    authType_bytes: [u8; 32],
    authType_len: u64,
    credentialMode_bytes: [u8; 32],
    credentialMode_len: u64,
    keyMode_bytes: [u8; 32],
    keyMode_len: u64,
    keys: StrList,
    has_modelMapping: bool,
    // DEFECT: dynamic object — modelMapping is Record<string, string>.
    modelMapping_json: JsonText,
    // DEFECT: dynamic object — any remaining fields kept as JSON text.
    json_tail: JsonText,
}

// ---------------------------------------------------------------------------
// Small string helpers used by the approximations below.
// (TS used native string methods: startsWith / endsWith / includes / trim /
// toLowerCase / charCodeAt; SLA works on (ptr, len) byte strings.)
// ---------------------------------------------------------------------------

fn omni_str_eq(a_ptr: ptr, a_len: u64, b_ptr: ptr, b_len: u64) -> bool {
    if a_len != b_len { return false; };
    for i in 0..a_len {
        let x: u8 = 0;
        let y: u8 = 0;
        PTR_BYTE_AT(x, a_ptr, i);
        PTR_BYTE_AT(y, b_ptr, i);
        if x != y { return false; };
    }
    return true;
}

fn omni_str_starts_with(s_ptr: ptr, s_len: u64, prefix_ptr: ptr, prefix_len: u64) -> bool {
    if s_len < prefix_len { return false; };
    for i in 0..prefix_len {
        let x: u8 = 0;
        let y: u8 = 0;
        PTR_BYTE_AT(x, s_ptr, i);
        PTR_BYTE_AT(y, prefix_ptr, i);
        if x != y { return false; };
    }
    return true;
}

fn omni_str_ends_with(s_ptr: ptr, s_len: u64, suffix_ptr: ptr, suffix_len: u64) -> bool {
    if s_len < suffix_len { return false; };
    let off: u64 = s_len - suffix_len;
    for i in 0..suffix_len {
        let x: u8 = 0;
        let y: u8 = 0;
        PTR_BYTE_AT(x, s_ptr, off + i);
        PTR_BYTE_AT(y, suffix_ptr, i);
        if x != y { return false; };
    }
    return true;
}

fn omni_str_contains(s_ptr: ptr, s_len: u64, needle_ptr: ptr, needle_len: u64) -> bool {
    if needle_len == 0 { return true; };
    if s_len < needle_len { return false; };
    let last: u64 = s_len - needle_len;
    for i in 0..last + 1 {
        if omni_str_starts_with(omni_padd(s_ptr, i), s_len - i, needle_ptr, needle_len) { return true; };
    }
    return false;
}

// DEFECT: Node API — process.env has no direct sa_std counterpart in this
// pass; env lookups return "unset" so callers take their default branches.
// Returns true and fills out_len when the variable is considered set.
fn omni_env_get(name_ptr: ptr, name_len: u64, out_ptr: ptr, out_len: &u64) -> bool {
    *out_len = 0;
    return false;
}

// DEFECT: Date.now() — no wall-clock extern wired in this pass; returns 0,
// which makes TTL/pause windows behave as "always stale / never paused".
fn omni_now_ms() -> u64 {
    return 0;
}

// DEFECT: node:crypto createHash("sha256"|"sha1") — no hash extern wired in
// this pass; writes a zeroed hex digest of the requested length.
fn omni_hash_hex(algo_ptr: ptr, algo_len: u64, text_ptr: ptr, text_len: u64, out_ptr: ptr, out_len: &u64, want_hex_len: u64) -> i32 {
    for i in 0..want_hex_len {
        let dst: ptr = PTR_NULL();
        PTR_BYTE_ADD(dst, out_ptr, i);
        // '0'
        PTR_WRITE_U8(dst, 48u8);
    }
    *out_len = want_hex_len;
    return 0;
}

// DEFECT: node:crypto randomBytes — no RNG extern wired in this pass;
// fills zeros (ids become deterministic, uniqueness is lost).
fn omni_random_bytes(out_ptr: ptr, n: u64) -> i32 {
    for i in 0..n {
        let dst: ptr = PTR_NULL();
        PTR_BYTE_ADD(dst, out_ptr, i);
        PTR_WRITE_U8(dst, 0u8);
    }
    return 0;
}

// DEFECT: node:crypto randomUUID — approximated by writing the all-zero
// UUID text; no RNG extern wired in this pass.
fn omni_random_uuid(out_ptr: ptr, out_len: &u64) -> i32 {
    let text = "00000000-0000-0000-0000-000000000000";
    for i in 0..36 {
        let dst: ptr = PTR_NULL();
        let src: ptr = PTR_NULL();
        PTR_BYTE_ADD(dst, out_ptr, i);
        PTR_BYTE_ADD(src, STR_PTR(text), i);
        let b: u8 = 0;
        PTR_BYTE_AT(b, src, 0);
        PTR_WRITE_U8(dst, b);
    }
    *out_len = 36;
    return 0;
}

// HeaderMap helpers (TS: Headers.get/set/delete/forEach, case-insensitive).
