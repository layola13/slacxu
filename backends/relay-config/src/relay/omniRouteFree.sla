// DEFECT: dynamic object — the trailing `!!body && typeof body ===
// "object" && !Array.isArray(body)` check is a caller flag.
fn opencodeRetryScopeApplies(surface_ptr: ptr, surface_len: u64, provider_ptr: ptr, provider_len: u64, borrowed: bool, model_ptr: ptr, model_len: u64, status: u64, body_is_object: bool) -> bool {
    if status != 403 && status != 451 { return false; };
    if !isGatedOpencodeFreeTierRequest(model_ptr, model_len, true, provider_ptr, provider_len, true, surface_ptr, surface_len) { return false; };
    if borrowed { return false; };
    return body_is_object;
}

