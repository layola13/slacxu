// function findOpencodeHeaderCaseInsensitive(source: Headers | null | undefined, name: string): string | undefined (ts:2438-2451)
// Returns 0 + value in out, -1 for TS undefined.
// TS logic: source.get(name)?.trim() first; fallback iterates forEach for
// a case-insensitive key match with a non-empty trimmed value.
// DEFECT: Headers — HeaderMap reads are stubs (omni_headers_get), so this
// reports undefined in this pass.
fn findOpencodeHeaderCaseInsensitive(has_source: bool, source: &HeaderMap, name_ptr: ptr, name_len: u64, out_ptr: ptr, out_len: &u64) -> i32 {
    *out_len = 0;
    if !has_source { return -1; };
    let value_len: u64 = 0;
    if omni_headers_get(source, name_ptr, name_len, out_ptr, &value_len) && value_len > 0 {
        *out_len = value_len;
        return 0;
    };
    return -1;
}

// const OPENCODE_FORWARD_HEADER_KEYS = ["x-opencode-session",
//   "x-opencode-request", "x-opencode-project", "x-opencode-client"] as const; (ts:2453-2458)
// const OPENCODE_AGENT_METADATA_KEYS = ["x-session-id", "x-title"] as const; (ts:2460)
// const OPENCODE_SESSION_FALLBACK_KEYS = ["x-opencode-session",
//   "x-session-affinity", "x-session-id", "x-claude-code-session-id",
//   "session_id", "session-id", "x-session_id", "thread_id", "thread-id",
//   "x-thread-id"] as const; (ts:2462-2475)
// DEFECT: readonly string tuple constants — kept as lookup functions.
fn omni_forward_header_key_at(index: u64, out_len: &u64) -> ptr {
    if index == 0 { *out_len = 18; return STR_PTR("x-opencode-session"); };
    if index == 1 { *out_len = 18; return STR_PTR("x-opencode-request"); };
    if index == 2 { *out_len = 18; return STR_PTR("x-opencode-project"); };
    *out_len = 17;
    return STR_PTR("x-opencode-client");
}

fn omni_agent_metadata_key_at(index: u64, out_len: &u64) -> ptr {
    if index == 0 { *out_len = 12; return STR_PTR("x-session-id"); };
    *out_len = 7;
    return STR_PTR("x-title");
}

fn omni_session_fallback_key_at(index: u64, out_len: &u64) -> ptr {
    if index == 0 { *out_len = 18; return STR_PTR("x-opencode-session"); };
    if index == 1 { *out_len = 18; return STR_PTR("x-session-affinity"); };
    if index == 2 { *out_len = 12; return STR_PTR("x-session-id"); };
    if index == 3 { *out_len = 22; return STR_PTR("x-claude-code-session-id"); };
    if index == 4 { *out_len = 10; return STR_PTR("session_id"); };
    if index == 5 { *out_len = 10; return STR_PTR("session-id"); };
    if index == 6 { *out_len = 12; return STR_PTR("x-session_id"); };
    if index == 7 { *out_len = 9; return STR_PTR("thread_id"); };
    if index == 8 { *out_len = 9; return STR_PTR("thread-id"); };
    *out_len = 11;
    return STR_PTR("x-thread-id");
}

// function resolveOpencodeFallbackSessionId(source: Headers | null | undefined): string | undefined (ts:2477-2485)
// TS logic: first fallback key whose value is non-empty, length <= 256
// and free of control chars (/[\u0000-\u001f\u007f]/).
fn resolveOpencodeFallbackSessionId(has_source: bool, source: &HeaderMap, out_ptr: ptr, out_len: &u64) -> i32 {
    *out_len = 0;
    if !has_source { return -1; };
    for i in 0..10 {
        let name_len: u64 = 0;
        let name_ptr: ptr = omni_session_fallback_key_at(i, &name_len);
        let value_len: u64 = 0;
        if findOpencodeHeaderCaseInsensitive(true, source, name_ptr, name_len, out_ptr, &value_len) == 0 && value_len > 0 && value_len <= 256 {
            let clean = true;
            for j in 0..value_len {
                let b: u8 = 0;
                PTR_BYTE_AT(b, out_ptr, j);
                if b <= 31 || b == 127 { clean = false; };
            }
            if clean {
                *out_len = value_len;
                return 0;
            };
        };
    }
    return -1;
}

// function applyOpencodeSessionFallback(headers: Headers, source, sessionBody?: OpencodeSessionBody): void (ts:2487-2511)
// TS logic: no-op when x-opencode-session already set; affinity =
// resolveOpencodeSessionIdentity(source-as-record, sessionBody) ??
// resolveOpencodeFallbackSessionId(source); sets x-opencode-session and,
// when missing, x-opencode-request = randomUUID().
// DEFECT: Headers — reads/writes are stubs; the flow is expressed but
// inert in this pass.
// DEFECT: node:crypto — randomUUID approximated (omni_random_uuid).
fn applyOpencodeSessionFallback(headers: &HeaderMap, has_source: bool, source: &HeaderMap, has_sessionBody: bool, sessionBody: &OpencodeSessionBody) -> i32 {
    let existing_len: u64 = 0;
    let scratch: [u8; 512] = [0u8; 512];
    let scratch_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(scratch_ptr, &scratch, 0);
    if omni_headers_get(headers, STR_PTR("x-opencode-session"), STR_LEN("x-opencode-session"), scratch_ptr, &existing_len) && existing_len > 0 { return 0; };
    // The TS converts the Headers object into a Record<string, string>
    // via forEach before resolving; HeaderMap already is that record.
    let affinity_len: u64 = 0;
    let affinity_buf: [u8; 512] = [0u8; 512];
    let affinity_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(affinity_ptr, &affinity_buf, 0);
    let body_json = JsonText { bytes: [0u8; 262144], len: 0 };
    // DEFECT: dynamic object — the OpencodeSessionBody struct is passed
    // to resolveOpencodeSessionIdentity as `body` in TS (an object, not
    // JSON text); the resolver's body path is unimplemented regardless.
    let resolved = false;
    if resolveOpencodeSessionIdentity(has_source, source, has_sessionBody, &body_json, affinity_ptr, &affinity_len) == 0 {
        resolved = true;
    } else {
        if resolveOpencodeFallbackSessionId(has_source, source, affinity_ptr, &affinity_len) == 0 {
            resolved = true;
        };
    };
    if !resolved { return 0; };
    omni_headers_set(headers, STR_PTR("x-opencode-session"), STR_LEN("x-opencode-session"), affinity_ptr, affinity_len);
    let req_len: u64 = 0;
    if !omni_headers_get(headers, STR_PTR("x-opencode-request"), STR_LEN("x-opencode-request"), scratch_ptr, &req_len) || req_len == 0 {
        let uuid_len: u64 = 0;
        omni_random_uuid(scratch_ptr, &uuid_len);
        omni_headers_set(headers, STR_PTR("x-opencode-request"), STR_LEN("x-opencode-request"), scratch_ptr, uuid_len);
    };
    return 0;
}

// function applyOpencodeCliDefaults(headers: Headers, cliDefaults, keepAgentUserAgent = false, sessionBody?): void (ts:2513-2570)
// TS logic: replace User-Agent unless keepsOpencodeClientUserAgent;
// fill x-opencode-client / x-opencode-project when missing; canonicalize
// x-opencode-request (pattern kept, else canonicalOpencodeId("msg_",
// current || undefined)) and x-opencode-session (pattern kept, else
// canonical from the current value, else canonical seeded by
// generateOpencodeSessionId(sessionBody)).
// DEFECT: Headers — reads/writes are stubs; flow expressed but inert.
fn applyOpencodeCliDefaults(cache: &OpencodeCliVersionCache, headers: &HeaderMap, cliDefaults: &OpencodeCliDefaults, keepAgentUserAgent: bool, has_sessionBody: bool, sessionBody: &OpencodeSessionBody) -> i32 {
    let ua_buf: [u8; 512] = [0u8; 512];
    let ua_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(ua_ptr, &ua_buf, 0);
    let ua_len: u64 = 0;
    let has_ua = omni_headers_get(headers, STR_PTR("User-Agent"), STR_LEN("User-Agent"), ua_ptr, &ua_len);
    if !keepsOpencodeClientUserAgent(has_ua, ua_ptr, ua_len, keepAgentUserAgent) {
        let dua_ptr: ptr = PTR_NULL();
        PTR_BYTE_ADD(dua_ptr, &cliDefaults.userAgent_bytes, 0);
        omni_headers_set(headers, STR_PTR("User-Agent"), STR_LEN("User-Agent"), dua_ptr, cliDefaults.userAgent_len);
    };
    let scratch: [u8; 512] = [0u8; 512];
    let scratch_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(scratch_ptr, &scratch, 0);
    let n: u64 = 0;
    if !omni_headers_get(headers, STR_PTR("x-opencode-client"), STR_LEN("x-opencode-client"), scratch_ptr, &n) || n == 0 {
        let c_ptr: ptr = PTR_NULL();
        PTR_BYTE_ADD(c_ptr, &cliDefaults.client_bytes, 0);
        omni_headers_set(headers, STR_PTR("x-opencode-client"), STR_LEN("x-opencode-client"), c_ptr, cliDefaults.client_len);
    };
    n = 0;
    if !omni_headers_get(headers, STR_PTR("x-opencode-project"), STR_LEN("x-opencode-project"), scratch_ptr, &n) || n == 0 {
        let p_ptr: ptr = PTR_NULL();
        PTR_BYTE_ADD(p_ptr, &cliDefaults.project_bytes, 0);
        omni_headers_set(headers, STR_PTR("x-opencode-project"), STR_LEN("x-opencode-project"), p_ptr, cliDefaults.project_len);
    };
    // Canonical request id.
    let req_buf: [u8; 512] = [0u8; 512];
    let req_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(req_ptr, &req_buf, 0);
    let req_len: u64 = 0;
    omni_headers_get(headers, STR_PTR("x-opencode-request"), STR_LEN("x-opencode-request"), req_ptr, &req_len);
    let new_req: [u8; 64] = [0u8; 64];
    let new_req_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(new_req_ptr, &new_req, 0);
    let new_req_len: u64 = 0;
    if req_len > 0 && omni_id_pattern_test(req_ptr, req_len, STR_PTR("msg_"), STR_LEN("msg_")) {
        omni_headers_set(headers, STR_PTR("x-opencode-request"), STR_LEN("x-opencode-request"), req_ptr, req_len);
    } else {
        canonicalOpencodeId(STR_PTR("msg_"), STR_LEN("msg_"), req_len > 0, req_ptr, req_len, new_req_ptr, &new_req_len);
        omni_headers_set(headers, STR_PTR("x-opencode-request"), STR_LEN("x-opencode-request"), new_req_ptr, new_req_len);
    };
    // Canonical session id.
    let ses_buf: [u8; 512] = [0u8; 512];
    let ses_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(ses_ptr, &ses_buf, 0);
    let ses_len: u64 = 0;
    omni_headers_get(headers, STR_PTR("x-opencode-session"), STR_LEN("x-opencode-session"), ses_ptr, &ses_len);
    let new_ses: [u8; 64] = [0u8; 64];
    let new_ses_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(new_ses_ptr, &new_ses, 0);
    let new_ses_len: u64 = 0;
    if ses_len > 0 && omni_id_pattern_test(ses_ptr, ses_len, STR_PTR("ses_"), STR_LEN("ses_")) {
        omni_headers_set(headers, STR_PTR("x-opencode-session"), STR_LEN("x-opencode-session"), ses_ptr, ses_len);
    } else {
        if ses_len > 0 {
            canonicalOpencodeId(STR_PTR("ses_"), STR_LEN("ses_"), true, ses_ptr, ses_len, new_ses_ptr, &new_ses_len);
        } else {
            // canonicalOpencodeId("ses_", generateOpencodeSessionId(sessionBody ?? null) ?? undefined)
            let gen_buf: [u8; 64] = [0u8; 64];
            let gen_ptr: ptr = PTR_NULL();
            PTR_BYTE_ADD(gen_ptr, &gen_buf, 0);
            let gen_len: u64 = 0;
            let has_gen = false;
            if has_sessionBody {
                if generateOpencodeSessionId(true, sessionBody, false, STR_PTR(""), 0, false, STR_PTR(""), 0, gen_ptr, &gen_len) == 0 { has_gen = true; };
            };
            canonicalOpencodeId(STR_PTR("ses_"), STR_LEN("ses_"), has_gen, gen_ptr, gen_len, new_ses_ptr, &new_ses_len);
        };
        omni_headers_set(headers, STR_PTR("x-opencode-session"), STR_LEN("x-opencode-session"), new_ses_ptr, new_ses_len);
    };
    return 0;
}

// export function forwardOpencodeClientHeaders(headers: Headers, source, options?): void (ts:2572-2603)
// TS steps: 1. forward User-Agent (unless forwardUserAgent === false);
// 2. forward OPENCODE_FORWARD_HEADER_KEYS; 2b. forward
// OPENCODE_AGENT_METADATA_KEYS; 3. when synthesizeRequestId or
// cliDefaults: applyOpencodeSessionFallback; 4. when cliDefaults:
// applyOpencodeCliDefaults.
// DEFECT: Headers — reads/writes are stubs; flow expressed but inert.
fn forwardOpencodeClientHeaders(cache: &OpencodeCliVersionCache, headers: &HeaderMap, has_source: bool, source: &HeaderMap, synthesizeRequestId: bool, has_cliDefaults: bool, cliDefaults: &OpencodeCliDefaults, keepAgentUserAgent: bool, forwardUserAgent: bool, has_sessionBody: bool, sessionBody: &OpencodeSessionBody) -> i32 {
    let value_buf: [u8; 1024] = [0u8; 1024];
    let value_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(value_ptr, &value_buf, 0);
    let value_len: u64 = 0;
    if findOpencodeHeaderCaseInsensitive(has_source, source, STR_PTR("User-Agent"), STR_LEN("User-Agent"), value_ptr, &value_len) == 0 && forwardUserAgent {
        omni_headers_set(headers, STR_PTR("User-Agent"), STR_LEN("User-Agent"), value_ptr, value_len);
    };
    for i in 0..4 {
        let name_len: u64 = 0;
        let name_ptr: ptr = omni_forward_header_key_at(i, &name_len);
        value_len = 0;
        if findOpencodeHeaderCaseInsensitive(has_source, source, name_ptr, name_len, value_ptr, &value_len) == 0 {
            omni_headers_set(headers, name_ptr, name_len, value_ptr, value_len);
        };
    }
    for i in 0..2 {
        let name_len: u64 = 0;
        let name_ptr: ptr = omni_agent_metadata_key_at(i, &name_len);
        value_len = 0;
        if findOpencodeHeaderCaseInsensitive(has_source, source, name_ptr, name_len, value_ptr, &value_len) == 0 {
            omni_headers_set(headers, name_ptr, name_len, value_ptr, value_len);
        };
    }
    if synthesizeRequestId || has_cliDefaults {
        applyOpencodeSessionFallback(headers, has_source, source, has_sessionBody, sessionBody);
    };
    if has_cliDefaults {
        applyOpencodeCliDefaults(cache, headers, cliDefaults, keepAgentUserAgent, has_sessionBody, sessionBody);
    };
    return 0;
}

// export function applyOpenCodeHeaders(headers: Headers, apiKey?, sourceHeaders?, options?): void (ts:2605-2658)
// TS logic: normalizedFormat = options.requestFormat ?? "openai-responses"
// (trimmed, fallback same); normalizedBase = options.baseUrl ??
// OMNIROUTE_FREE_BASE_URL; useZenApiKeyAuth = format "claude" or
// (responses + zen base); cliDefaults resolved with gated ?? true;
// forwardOpencodeClientHeaders(synthesizeRequestId: true, ...); when
// synthesis disabled (!cliDefaults) fill UA/client/project/session/request
// from env + SDK getOpenCodeProjectId + canonical ids; apiKey: x-api-key
// for zen-auth/claude else Authorization Bearer; claude also sets
// anthropic-version 2023-06-01; no apiKey deletes Authorization.
// DEFECT: Headers — reads/writes are stubs; flow expressed but inert.
// DEFECT: SDK — getOpenCodeProjectId() approximated by env OPENCODE_PROJECT
// or "global" via the fallback branch values.
fn applyOpenCodeHeaders(cache: &OpencodeCliVersionCache, headers: &HeaderMap, has_apiKey: bool, apiKey_ptr: ptr, apiKey_len: u64, has_source: bool, source: &HeaderMap, keepAgentUserAgent: bool, has_providerId: bool, providerId_ptr: ptr, providerId_len: u64, has_gated: bool, gated: bool, has_format: bool, format_ptr: ptr, format_len: u64, has_baseUrl: bool, baseUrl_ptr: ptr, baseUrl_len: u64, has_sessionBody: bool, sessionBody: &OpencodeSessionBody) -> i32 {
    let fmt_ptr: ptr = format_ptr;
    let fmt_len: u64 = format_len;
    if !has_format || fmt_len == 0 {
        fmt_ptr = STR_PTR("openai-responses");
        fmt_len = STR_LEN("openai-responses");
    };
    let base_ptr: ptr = baseUrl_ptr;
    let base_len: u64 = baseUrl_len;
    if !has_baseUrl {
        base_ptr = STR_PTR("https://opencode.ai/zen/v1");
        base_len = STR_LEN("https://opencode.ai/zen/v1");
    };
    let is_claude = omni_str_eq(fmt_ptr, fmt_len, STR_PTR("claude"), STR_LEN("claude"));
    let use_zen_key_auth = is_claude || (omni_str_eq(fmt_ptr, fmt_len, STR_PTR("openai-responses"), STR_LEN("openai-responses")) && omni_str_eq(base_ptr, base_len, STR_PTR("https://opencode.ai/zen/v1"), STR_LEN("https://opencode.ai/zen/v1")));
    let gated_value = true;
    if has_gated { gated_value = gated; };
    let pid_ptr: ptr = providerId_ptr;
    let pid_len: u64 = providerId_len;
    if !has_providerId {
        pid_ptr = STR_PTR("opencode");
        pid_len = STR_LEN("opencode");
    };
    let defaults = OpencodeCliDefaults { userAgent_bytes: [0u8; 512], userAgent_len: 0, client_bytes: [0u8; 128], client_len: 0, project_bytes: [0u8; 128], project_len: 0 };
    let has_defaults = resolveOpencodeCliDefaults(cache, pid_ptr, pid_len, gated_value, &defaults) == 0;
    forwardOpencodeClientHeaders(cache, headers, has_source, source, true, has_defaults, &defaults, keepAgentUserAgent, true, has_sessionBody, sessionBody);
    if !has_defaults {
        // Fallback when synthesis is disabled.
        let scratch: [u8; 512] = [0u8; 512];
        let scratch_ptr: ptr = PTR_NULL();
        PTR_BYTE_ADD(scratch_ptr, &scratch, 0);
        let n: u64 = 0;
        if !omni_headers_get(headers, STR_PTR("User-Agent"), STR_LEN("User-Agent"), scratch_ptr, &n) || n == 0 {
            omni_headers_set(headers, STR_PTR("User-Agent"), STR_LEN("User-Agent"), STR_PTR("opencode/1.18.31"), STR_LEN("opencode/1.18.31"));
        };
        n = 0;
        if !omni_headers_get(headers, STR_PTR("x-opencode-client"), STR_LEN("x-opencode-client"), scratch_ptr, &n) || n == 0 {
            omni_headers_set(headers, STR_PTR("x-opencode-client"), STR_LEN("x-opencode-client"), STR_PTR("desktop"), STR_LEN("desktop"));
        };
        n = 0;
        if !omni_headers_get(headers, STR_PTR("x-opencode-project"), STR_LEN("x-opencode-project"), scratch_ptr, &n) || n == 0 {
            // TS: getOpenCodeProjectId() from the SDK.
            omni_headers_set(headers, STR_PTR("x-opencode-project"), STR_LEN("x-opencode-project"), STR_PTR("global"), STR_LEN("global"));
        };
        n = 0;
        if !omni_headers_get(headers, STR_PTR("x-opencode-session"), STR_LEN("x-opencode-session"), scratch_ptr, &n) || n == 0 {
            let id_len: u64 = 0;
            canonicalOpencodeId(STR_PTR("ses_"), STR_LEN("ses_"), false, STR_PTR(""), 0, scratch_ptr, &id_len);
            omni_headers_set(headers, STR_PTR("x-opencode-session"), STR_LEN("x-opencode-session"), scratch_ptr, id_len);
        };
        n = 0;
        if !omni_headers_get(headers, STR_PTR("x-opencode-request"), STR_LEN("x-opencode-request"), scratch_ptr, &n) || n == 0 {
            let id_len: u64 = 0;
            canonicalOpencodeId(STR_PTR("msg_"), STR_LEN("msg_"), false, STR_PTR(""), 0, scratch_ptr, &id_len);
            omni_headers_set(headers, STR_PTR("x-opencode-request"), STR_LEN("x-opencode-request"), scratch_ptr, id_len);
        };
    };
    // apiKey handling (TS trims the key first).
    if has_apiKey && apiKey_len > 0 {
        if use_zen_key_auth || is_claude {let _ifd6 = 
            omni_headers_set(headers, STR_PTR("x-api-key"), STR_LEN("x-api-key"), apiKey_ptr, apiKey_len);
        } else {
            let auth_buf: [u8; 1024] = [0u8; 1024];
            let auth_ptr: ptr = PTR_NULL();
            PTR_BYTE_ADD(auth_ptr, &auth_buf, 0);
            let auth_len: u64 = 0;
            let bearer = "Bearer ";
            for i in 0..STR_LEN(bearer) {
                let b: u8 = 0;
                let src: ptr = PTR_NULL();
                PTR_BYTE_ADD(src, STR_PTR(bearer), i);
                PTR_BYTE_AT(b, src, 0);
                let dst: ptr = PTR_NULL();
                PTR_BYTE_ADD(dst, auth_ptr, auth_len);
                PTR_WRITE_U8(dst, b);
                auth_len = auth_len + 1;
            }
            for i in 0..apiKey_len {
                let b: u8 = 0;
                PTR_BYTE_AT(b, apiKey_ptr, i);
                let dst: ptr = PTR_NULL();
                PTR_BYTE_ADD(dst, auth_ptr, auth_len);
                PTR_WRITE_U8(dst, b);
                auth_len = auth_len + 1;
            }
            omni_headers_set(headers, STR_PTR("Authorization"), STR_LEN("Authorization"), auth_ptr, auth_len);
        };
        if is_claude {
            omni_headers_set(headers, STR_PTR("anthropic-version"), STR_LEN("anthropic-version"), STR_PTR("2023-06-01"), STR_LEN("2023-06-01"));
        };
    } else {let _ifd5 = 
        omni_headers_delete(headers, STR_PTR("Authorization"), STR_LEN("Authorization"));
    };
    return 0;
}

