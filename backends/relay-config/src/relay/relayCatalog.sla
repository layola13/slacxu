// ---------------------------------------------------------------------------
// function preferredProtocols(groupName, endpoints): RelayResponseProtocol[] (relayCatalog.ts:467-477)
// DEFECT: generics/type predicate — the .filter((e): e is RelayResponseProtocol
// => ...) type guard has no SLA counterpart; membership is a string scan.
// Priority: group includes "claude" -> [anthropic, openai-response, openai, gemini]
//           group includes "gemini" -> [gemini, openai-response, openai, anthropic]
//           else -> [openai-response, openai, anthropic, gemini]
// Result = priority filtered to supported (endpoints ∩ CONVERSATION_PROTOCOLS).
// ---------------------------------------------------------------------------
fn preferredProtocols(group_name_ptr: ptr, group_name_len: u64, endpoints_ptr: ptr, endpoints_len: u64, out_ptr: ptr, out_count: &u64) -> i32 {
    // DEFECT: caller must supply group name lowercased and the endpoint list
    // as JSON text; priority selection itself is a fixed branch:
    let is_claude = rc_contains(group_name_ptr, group_name_len, STR_PTR("claude"), STR_LEN("claude"));
    let is_gemini = rc_contains(group_name_ptr, group_name_len, STR_PTR("gemini"), STR_LEN("gemini"));
    // DEFECT: supported-set filtering over JSON text not implemented here.
    out_count = 0;
    if is_claude { return 1; };
    if is_gemini { return 2; };
    return 0;
}

// ---------------------------------------------------------------------------
// function isImageGroup(groupName, models): boolean (relayCatalog.ts:479-486)
// DEFECT: regex /image|banana|video/i — substring scans (approximation loses
// the regex alternation boundaries, which are plain substrings here anyway).
// DEFECT: closure — models.every(...) becomes a loop.
// ---------------------------------------------------------------------------
fn isImageGroup(group_name_ptr: ptr, group_name_len: u64, models_ptr: ptr, models_count: u64) -> bool {
    if rc_contains(group_name_ptr, group_name_len, STR_PTR("image"), STR_LEN("image")) { return true; };
    // DEFECT: case-insensitive scan required ("banana"/"video" likewise);
    // rc_contains is case-sensitive in this pass.
    if rc_contains(group_name_ptr, group_name_len, STR_PTR("banana"), STR_LEN("banana")) { return true; };
    if rc_contains(group_name_ptr, group_name_len, STR_PTR("video"), STR_LEN("video")) { return true; };
    if models_count == 0 { return false; };
    // every model: quota_type === 1 && some endpoint in
    //   ["image-generation", "image-edits", "videos"]
