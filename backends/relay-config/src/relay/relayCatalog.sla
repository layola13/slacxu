// Converted 1:1 from backends/relay-config/src/relay/relayCatalog.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "sa_std/io/print.sai"
@import "sa_std/ptr.sa"
@import "sa_std/crypto.sa" // DEFECT: node:crypto createHash — sa_std hash extern assumed; see sourceHash.

// Types imported from "@codex-ui/shared" (relayCatalog.ts:2-12):
// ChannelGroupConfig, ImageGenerationProtocol, JsonValue,
// RelayCapabilityCatalog, RelayCatalogEndpoint, RelayCatalogImportPreview,
// RelayCatalogModel, RelayCatalogVendor, RelayResponseProtocol.
// DEFECT: dynamic object — every one of these is a dynamic JSON-shaped TS
// type; in SLA they are JSON text buffers (JsonBuf) plus the few scalar
// fields actually branched on. Field-for-field structs are a later fix pass.

// Generic JSON text buffer used for all catalog-shaped values.
struct JsonBuf {
    bytes: [0u8; 2097152], // MAX_CATALOG_BYTES (2 MB) upper bound, see below
    len: u64,
}

// RelayCatalogModel — scalar view (full record stays in JsonBuf form).
struct RelayCatalogModel {
    model_name_bytes: [0u8; 512],
    model_name_len: u64,
    quota_type: u64, // 0 | 1
    enable_groups_bytes: [0u8; 8192], // flattened string[]
    enable_groups_lens: [0u64; 64],
    enable_groups_count: u64,
    supported_endpoint_types_bytes: [0u8; 8192], // flattened string[]
    supported_endpoint_types_lens: [0u64; 64],
    supported_endpoint_types_count: u64,
    json_bytes: [0u8; 16384], // DEFECT: dynamic object — full model record
    json_len: u64,
}

// ChannelGroupConfig — JSON text buffer form (built/returned by several fns).
struct ChannelGroupConfigJson {
    json_bytes: [0u8; 32768],
    json_len: u64,
}

// Warnings list: flattened string[].
struct Warnings {
    bytes: [0u8; 65536],
    lens: [0u64; 256],
    count: u64,
}

fn warnings_push(warnings: &Warnings, msg_ptr: ptr, msg_len: u64) {
    // DEFECT: byte copy of the message into flattened storage not implemented
    // in this pass; only the count/length bookkeeping is kept.
    if warnings.count < 256 {
        warnings.lens[warnings.count] = msg_len;
        warnings.count = warnings.count + 1;
    };
}

// ---------------------------------------------------------------------------
// Field-name sets (relayCatalog.ts:14-46)
// DEFECT: Set<string> — no Set type; membership is a linear scan over the
// literal lists kept in the comments below.
// MODEL_FIELDS: model_name, icon, vendor_id, quota_type, model_ratio,
//   model_price, completion_ratio, cache_ratio, create_cache_ratio, owner_by,
//   enable_groups, supported_endpoint_types, extensions
// VENDOR_FIELDS: id, name, icon, extensions
// ENDPOINT_FIELDS: path, method, aliases, extensions
// CATALOG_FIELDS: schema, success, auto_groups, data, group_ratio,
//   usable_group, supported_endpoint, vendors, imported_at, source_hash,
//   warnings, extensions
// ---------------------------------------------------------------------------
const MODEL_FIELDS_COUNT: u64 = 13;
const VENDOR_FIELDS_COUNT: u64 = 4;
const ENDPOINT_FIELDS_COUNT: u64 = 4;
const CATALOG_FIELDS_COUNT: u64 = 12;

// CONVERSATION_PROTOCOLS: RelayResponseProtocol[] (relayCatalog.ts:47)
//   ["openai-response", "openai", "anthropic", "gemini"]
const CONVERSATION_PROTOCOLS_COUNT: u64 = 4;

const MAX_CATALOG_BYTES: u64 = 2097152; // 2 * 1024 * 1024 (relayCatalog.ts:48)
const CATALOG_FETCH_TIMEOUT_MS: u64 = 15000; // 15_000 (relayCatalog.ts:49)

// String helpers over (ptr,len).
fn rc_streq(a_ptr: ptr, a_len: u64, b_ptr: ptr, b_len: u64) -> bool {
    if a_len != b_len { return false; };
    let i: u64 = 0;
    while i < a_len {
        let a: u8 = 0;
        let b: u8 = 0;
        PTR_BYTE_AT(a, a_ptr, i);
        PTR_BYTE_AT(b, b_ptr, i);
        if a != b { return false; };
        i = i + 1;
    }
    return true;
}

fn rc_contains(hay_ptr: ptr, hay_len: u64, needle_ptr: ptr, needle_len: u64) -> bool {
    if needle_len == 0 || hay_len < needle_len { return false; };
    let last = hay_len - needle_len;
    let i: u64 = 0;
    while i <= last {
        let ok = true;
        let j: u64 = 0;
        while j < needle_len {
            let a: u8 = 0;
            let b: u8 = 0;
            PTR_BYTE_AT(a, hay_ptr, i + j);
            PTR_BYTE_AT(b, needle_ptr, j);
            if a != b { ok = false; break; };
            j = j + 1;
        }
        if ok { return true; };
        i = i + 1;
    }
    return false;
}

