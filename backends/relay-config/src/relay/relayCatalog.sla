// ---------------------------------------------------------------------------
// export function canonicalEndpointType(value: string): string (relayCatalog.ts:97-110)
//   switch (value.trim().toLowerCase()) {
//     case "vidoes": return "videos";
//     case "openai-responses-compact": return "openai-response-compact";
//     case "openai-responses-compaction-v2": return "openai-response-compaction-v2";
//     default: return value.trim().toLowerCase();
//   }
// DEFECT: string return — out (ptr,len); the default branch returns the
// normalized input, which the caller must materialize (pending byte copy).
// ---------------------------------------------------------------------------
fn canonicalEndpointType(value_ptr: ptr, value_len: u64, out_len: &u64) -> i32 {
    // Caller supplies value already trimmed + lowercased.
    if rc_streq(value_ptr, value_len, STR_PTR("vidoes"), STR_LEN("vidoes")) { out_len = STR_LEN("videos"); return 0; };
    if rc_streq(value_ptr, value_len, STR_PTR("openai-responses-compact"), STR_LEN("openai-responses-compact")) { out_len = STR_LEN("openai-response-compact"); return 0; };
    if rc_streq(value_ptr, value_len, STR_PTR("openai-responses-compaction-v2"), STR_LEN("openai-responses-compaction-v2")) { out_len = STR_LEN("openai-response-compaction-v2"); return 0; };
    out_len = value_len;
    return 0;
}

