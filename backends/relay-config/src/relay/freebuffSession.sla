    out.has_message = false;
    return 0;
}

// ---------------------------------------------------------------------------
// export async function getOrEnsureFreebuffSession(targetModel, explicitToken?, options = {}): Promise<FreebuffSessionInfo> (freebuffSession.ts:355-527)
// DEFECT: async — synchronous + status code; failure (throw) is a nonzero code:
//   1 = no token ("Freebuff requires an authentication token. ...")
//   2 = FREEBUFF_MODEL_LOCKED (external session for another model; source
//       attaches code/currentModel/targetModel/remainingSeconds/instanceId
//       to the Error object via Object.assign — DEFECT: dynamic object error
//       properties have no counterpart; fields are dropped)
//   3 = admission failed (409 locked by external session, or non-active body)
// DEFECT: Promise dedup — the activeAdmissionPromises.get/set + IIFE pattern
// ((async () => { ... })()) has no counterpart; concurrent callers are NOT
// deduplicated here, each call runs the admission flow sequentially.
// DEFECT: closure — the admission IIFE capturing token/userId/agentId becomes
// this function body directly.
// DEFECT: fetch injection + AbortSignal.timeout + dynamic JSON bodies —
// sa_std HTTP + JSON text lookups, as above.
// DEFECT: throw/rethrow discrimination (`error.message.includes("Freebuff
// active session is currently owned")`) — status-code branch instead.
// ---------------------------------------------------------------------------
fn getOrEnsureFreebuffSession(state: &FreebuffState, target_model_ptr: ptr, target_model_len: u64, explicit_token_ptr: ptr, explicit_token_len: u64, has_explicit_token: bool, credentials_path_ptr: ptr, credentials_path_len: u64, has_path: bool, timeout_ms: u64, has_timeout: bool, force_switch: bool, out: &FreebuffSessionInfo) -> i32 {
    // timeoutMs = options.timeoutMs ?? 15_000
    // token = explicitToken?.trim() || creds?.token; !token -> code 1
    // userId = creds?.userId || "freebuff-user"
    // agentId = getFreebuffAgentId(targetModel); now = Date.now()
    // cached = activeSessions.get(targetModel)
    // if (cached && cached.token === token && cached.expiresAt - now > 60_000)
    //   return cached;
    // existingPromise -> (dropped, see DEFECT above)
    // Admission flow:
    //   1. GET session: if active with instanceId:
    //        currentModel == targetModel && serverExpiresAt > now
    //          -> adopt (instanceId, expiresAt, isOwned)
    //        currentModel != targetModel:
    //          owned || forceSwitch -> DELETE, forget owned, drop cached
    //          else if not expired -> code 2 (FREEBUFF_MODEL_LOCKED)
    //          else fall through to admission
    //      (GET errors fall through, except the locked error rethrows)
    //   2. If no instanceId: POST session with x-freebuff-model header.
    //        409: if conflict instance owned || forceSwitch -> DELETE + POST again
    //             else -> code 3
    //        body must be ok + status "active" + string instanceId else code 3
    //        instanceId set; isOwned = true; ownedInstanceIds.add(instanceId)
    //        expiresAt from body.expiresAt when valid and > now
    //   sessionInfo = { instanceId, model: targetModel, expiresAt, token,
    //                   userId, agentId, isOwned }
    //   activeSessions.set(targetModel, sessionInfo); return sessionInfo
    //   finally: activeAdmissionPromises.delete(targetModel) — no-op here.
    // DEFECT: HTTP + JSON + cache steps not implemented in this pass.
    return 3;
}

