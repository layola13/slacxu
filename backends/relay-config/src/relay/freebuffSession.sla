fn releaseFreebuffSession(state: &FreebuffState, credentials_path_ptr: ptr, credentials_path_len: u64, has_path: bool, timeout_ms: u64, has_timeout: bool, explicit_token_ptr: ptr, explicit_token_len: u64, has_explicit_token: bool, out: &FreebuffReleaseResult) -> i32 {
