// Case-insensitive substring helper (same approximation style as freeOllama).
fn fb_contains_ci(hay_ptr: ptr, hay_len: u64, needle_ptr: ptr, needle_len: u64) -> bool {
    if needle_len == 0 || hay_len < needle_len { return false; };
    let last = hay_len - needle_len;
    let i: u64 = 0;
    while i <= last {
        let ok = true;
        let j: u64 = 0;
        while j < needle_len {
            let a: u8 = 0;
            let b: u8 = 0;
            PTR_BYTE_AT(a, hay_ptr, i + j);
            PTR_BYTE_AT(b, needle_ptr, j);
            if a >= 65 && a <= 90 { a = a + 32; };
            if b >= 65 && b <= 90 { b = b + 32; };
            if a != b { ok = false; break; };
            j = j + 1;
        }
        if ok { return true; };
        i = i + 1;
    }
    return false;
}

fn fb_streq_ci(a_ptr: ptr, a_len: u64, b_ptr: ptr, b_len: u64) -> bool {
    if a_len != b_len { return false; };
    let i: u64 = 0;
    while i < a_len {
        let a: u8 = 0;
        let b: u8 = 0;
        PTR_BYTE_AT(a, a_ptr, i);
        PTR_BYTE_AT(b, b_ptr, i);
        if a >= 65 && a <= 90 { a = a + 32; };
        if b >= 65 && b <= 90 { b = b + 32; };
        if a != b { return false; };
        i = i + 1;
    }
    return true;
}

// ---------------------------------------------------------------------------
// export function getFreebuffAgentId(model: string): string (freebuffSession.ts:45-61)
// DEFECT: Object.entries iteration over the Record — the map walk is a fixed
// 9-branch chain in source insertion order (see map comment above).
// DEFECT: string -> (ptr,len) out-param instead of a returned string.
// ---------------------------------------------------------------------------
fn getFreebuffAgentId(model_ptr: ptr, model_len: u64, out_ptr: ptr, out_len: &u64) -> i32 {
    // normalized = model.trim().toLowerCase() — caller supplies normalized text.
    // Exact map hits first (case-insensitive key compare):
    if fb_streq_ci(model_ptr, model_len, STR_PTR("z-ai/glm-5.3-flash"), STR_LEN("z-ai/glm-5.3-flash")) { out_len = STR_LEN("base3-free-glm-5-3-flash"); return 0; };
    if fb_streq_ci(model_ptr, model_len, STR_PTR("mimo/mimo-v2.5"), STR_LEN("mimo/mimo-v2.5")) { out_len = STR_LEN("base3-free-mimo"); return 0; };
    if fb_streq_ci(model_ptr, model_len, STR_PTR("deepseek/deepseek-v4-flash"), STR_LEN("deepseek/deepseek-v4-flash")) { out_len = STR_LEN("base3-free-deepseek-flash"); return 0; };
    if fb_streq_ci(model_ptr, model_len, STR_PTR("openai/gpt-5.6-luna"), STR_LEN("openai/gpt-5.6-luna")) { out_len = STR_LEN("base3-free-luna"); return 0; };
    if fb_streq_ci(model_ptr, model_len, STR_PTR("openai/gpt-5.6-luna-es"), STR_LEN("openai/gpt-5.6-luna-es")) { out_len = STR_LEN("base3-free-luna-es"); return 0; };
    if fb_streq_ci(model_ptr, model_len, STR_PTR("minimax/minimax-m3"), STR_LEN("minimax/minimax-m3")) { out_len = STR_LEN("base3-free-minimax-m3"); return 0; };
    if fb_streq_ci(model_ptr, model_len, STR_PTR("upstage/solar-pro-4"), STR_LEN("upstage/solar-pro-4")) { out_len = STR_LEN("base3-free-solar-pro4"); return 0; };
    if fb_streq_ci(model_ptr, model_len, STR_PTR("meta/muse-spark-1.3"), STR_LEN("meta/muse-spark-1.3")) { out_len = STR_LEN("base3-free-muse-spark-1-3"); return 0; };
    if fb_streq_ci(model_ptr, model_len, STR_PTR("anthropic/claude-fable-5"), STR_LEN("anthropic/claude-fable-5")) { out_len = STR_LEN("base3-free-fable"); return 0; };
    // DEFECT: out_ptr is not written — the caller maps the returned length's
    // known literal; pointer materialization of the chosen literal is pending.
    // Substring fallbacks, in source order:
    if fb_contains_ci(model_ptr, model_len, STR_PTR("glm"), STR_LEN("glm")) { out_len = STR_LEN("base3-free-glm-5-3-flash"); return 0; };
    if fb_contains_ci(model_ptr, model_len, STR_PTR("mimo"), STR_LEN("mimo")) { out_len = STR_LEN("base3-free-mimo"); return 0; };
    if fb_contains_ci(model_ptr, model_len, STR_PTR("deepseek"), STR_LEN("deepseek")) { out_len = STR_LEN("base3-free-deepseek-flash"); return 0; };
    if fb_contains_ci(model_ptr, model_len, STR_PTR("luna-es"), STR_LEN("luna-es")) { out_len = STR_LEN("base3-free-luna-es"); return 0; };
    if fb_contains_ci(model_ptr, model_len, STR_PTR("luna"), STR_LEN("luna")) { out_len = STR_LEN("base3-free-luna"); return 0; };
    if fb_contains_ci(model_ptr, model_len, STR_PTR("minimax"), STR_LEN("minimax")) { out_len = STR_LEN("base3-free-minimax-m3"); return 0; };
    if fb_contains_ci(model_ptr, model_len, STR_PTR("solar"), STR_LEN("solar")) { out_len = STR_LEN("base3-free-solar-pro4"); return 0; };
    if fb_contains_ci(model_ptr, model_len, STR_PTR("fable"), STR_LEN("fable")) { out_len = STR_LEN("base3-free-fable"); return 0; };
    if fb_contains_ci(model_ptr, model_len, STR_PTR("muse-spark"), STR_LEN("muse-spark")) { out_len = STR_LEN("base3-free-muse-spark-1-3"); return 0; };
    out_len = STR_LEN("base3-free-glm-5-3-flash");
    return 0;
}

