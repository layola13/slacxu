fn resolveFreebuffCredentialsPath(out_ptr: ptr, out_len: &u64) -> i32 {
    // DEFECT: env reads + homedir + join not implemented in this pass;
    // out receives the default suffix ".config/manicode/credentials.json".
    out_len = STR_LEN(".config/manicode/credentials.json");
    return 0;
}

