// ---------------------------------------------------------------------------
// Module state (freebuffSession.ts:118-157)
//   const ownedInstanceIds = new Set<string>();
//   const activeSessions = new Map<string, FreebuffSessionInfo>();
//   const activeAdmissionPromises = new Map<string, Promise<FreebuffSessionInfo>>();
// DEFECT: module-level mutable Set/Map — SLA has no module globals in this
// dialect; all three live in one state struct passed by &FreebuffState.
// DEFECT: Promise-valued map — in-flight admissions cannot be represented;
// the promise map is dropped and admission is sequential (see below).
// ---------------------------------------------------------------------------
struct FreebuffState {
    owned_ids_bytes: [0u8; 16384],
    owned_id_lens: [0u64; 64],
    owned_count: u64,
    session_models_bytes: [0u8; 16384],
    session_model_lens: [0u64; 64],
    sessions_bytes: [0u8; 262144], // flattened FreebuffSessionInfo storage
    session_count: u64,
    // activeAdmissionPromises intentionally absent — DEFECT: Promise map.
    admission_count: u64,
}

// Track instances created by Codex Ultra to avoid deleting external sessions (P0 protection)
// export function isOwnedFreebuffInstance(instanceId: string): boolean (freebuffSession.ts:121-123)
fn isOwnedFreebuffInstance(state: &FreebuffState, instance_id_ptr: ptr, instance_id_len: u64) -> bool {
    for i in 0..state.owned_count {
        // DEFECT: per-entry (ptr,len) recovery from flattened storage +
        // byte compare not implemented in this pass.
        if state.owned_id_lens[i] == instance_id_len { return true; };
    }
    return false;
}

// export function recordOwnedFreebuffInstance(instanceId: string): void (freebuffSession.ts:125-127)
fn recordOwnedFreebuffInstance(state: &FreebuffState, instance_id_ptr: ptr, instance_id_len: u64) {
    // ownedInstanceIds.add(instanceId)
    // DEFECT: byte copy into flattened storage not implemented in this pass.
    if state.owned_count < 64 {
        state.owned_id_lens[state.owned_count] = instance_id_len;
        state.owned_count = state.owned_count + 1;
    };
}

// export function forgetOwnedFreebuffInstance(instanceId: string): void (freebuffSession.ts:129-131)
fn forgetOwnedFreebuffInstance(state: &FreebuffState, instance_id_ptr: ptr, instance_id_len: u64) {
    // ownedInstanceIds.delete(instanceId)
    // DEFECT: removal from flattened storage not implemented in this pass.
}

// export function clearOwnedFreebuffInstances(): void (freebuffSession.ts:133-135)
fn clearOwnedFreebuffInstances(state: &FreebuffState) {
    state.owned_count = 0;
}

// export function clearFreebuffSession(model?: string): void (freebuffSession.ts:140-148)
// Per-model session cache clear; no argument clears both maps entirely.
fn clearFreebuffSession(state: &FreebuffState, model_ptr: ptr, model_len: u64, has_model: bool) {
    if has_model {
        // activeSessions.delete(model); activeAdmissionPromises.delete(model);
        // DEFECT: keyed delete from flattened storage not implemented here.
    } else {
        state.session_count = 0;
        state.admission_count = 0;
    };
}

// export function getCachedFreebuffSession(model?: string): FreebuffSessionInfo | null (freebuffSession.ts:150-157)
// DEFECT: Map.values().next() iterator — first-entry access is an index-0
// read of the flattened storage; null represented by status 1.
fn getCachedFreebuffSession(state: &FreebuffState, model_ptr: ptr, model_len: u64, has_model: bool, out: &FreebuffSessionInfo) -> i32 {
    // model given: activeSessions.get(model) || null
    // else: first value of activeSessions, or null when empty
    // DEFECT: keyed/first lookup over flattened storage not implemented here.
    if state.session_count == 0 { return 1; };
    return 1;
}

