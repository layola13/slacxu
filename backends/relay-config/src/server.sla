// RelayStation (SDK type; fields accessed in source: id, enabled)
struct RelayStation {
    id_bytes: [0u8; 256],
    id_len: u64,
    enabled: bool,
    // DEFECT: dynamic object — remaining RelayStation fields kept as JSON text.
    json_bytes: [0u8; 8192],
    json_len: u64,
}

// ServiceHost (SDK type; opaque to this service — start() ignores it)
struct ServiceHost {
    handle: u64,
}

// ---------------------------------------------------------------------------
// class RelayConfigService implements RelayConfigPlugin (server.ts:18-56)
// TS class -> struct + function family with &RelayConfigService first param.
// ---------------------------------------------------------------------------
struct RelayConfigService {
    // readonly manifest = RELAY_CONFIG_MANIFEST (server.ts:19)
    manifest: RelayConfigManifest,
    // readonly #relays = new Map<string, RelayStation>() (server.ts:33)
    // DEFECT: Map<string, RelayStation> — no SLA map type; fixed-capacity
    // parallel arrays used (capacity 256 stations, estimated from registry use).
    relay_ids_bytes: [0u8; 65536],
    relay_id_lens: [0u64; 256],
    relays: [0u8; 2097152], // DEFECT: struct array of RelayStation flattened to bytes
    relay_count: u64,
    // DEFECT: class private field `#relays` — SLA structs have no access
    // control; privacy is by convention only.
}

// rpcNamespaces.relay (server.ts:20-32): async (method, params) => switch dispatch
// DEFECT: async — converted to a synchronous function returning a status code.
// DEFECT: dynamic object — params: Record<string, unknown> kept as JSON text buffer.
// DEFECT: closure — the arrow function capturing `this` becomes a plain
// function taking &RelayConfigService as its first parameter.
fn relay_config_rpc_relay(service: &RelayConfigService, method_ptr: ptr, method_len: u64, params_json_ptr: ptr, params_json_len: u64, out_json_ptr: ptr, out_json_len: &u64) -> i32 {
    // switch (method) {
    //   case "list":   return this.listRelays();
    //   case "upsert": return this.upsertRelay(params.relay as RelayStation);
    //   case "remove": return this.removeRelay(String(params.id ?? ""));
    //   default: throw new Error(`unknown relay method "${method}"`);
    // }
    // DEFECT: throw — SLA has no exceptions; unknown method returns -1 and the
    // caller must surface `unknown relay method "<method>"`.
    // DEFECT: dynamic JSON field access (params.relay / params.id) — requires a
    // JSON lookup over params_json that is not implemented in this pass.
    if method_len == 4 {
        // "list"
        return relay_config_list_relays(service, out_json_ptr, out_json_len);
    };
    if method_len == 6 {
        // "upsert" / "remove" share length 6; byte compare required.
        // DEFECT: string equality on (ptr,len) needs a byte-compare helper;
        // dispatch by first byte is an approximation in this pass.
        return -2;
    };
    return -1;
}

