// Converted 1:1 from backends/auggie/src/server.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
//
// Auggie (Augment Code) — server side (kind "backend"). Independent
// plugin. Reopened 2026-10-24: the ACP runtime cluster lives under
// src/runtime (ported from the pre-refactor host implementation); the
// host constructs the bridge from there via staging imports.
//
// SDK types (EngineHandle, EngineStatus, PluginInstallation,
// ServerHost, ServerPlugin) come from @cxu/sdk-backend/server —
// see the sdk-backend unit. Re-export of AUGGIE_MANIFEST mirrors
// `export { AUGGIE_MANIFEST }` from ./manifest.sla.
@import "./manifest.sla"
@import "sa_std/string.sa"

// class AuggieEngine implements EngineHandle.
// #status: EngineStatus = { phase: "stopped", transport: "stdio" } —
// string fields kept as (ptr, len) into string literals.
struct AuggieEngine {
    pluginId_ptr: ptr,
    pluginId_len: u64,
    status_phase_ptr: ptr,
    status_phase_len: u64,
    status_transport_ptr: ptr,
    status_transport_len: u64,
}

fn AuggieEngine_new(self: &AuggieEngine) -> void {
    self.pluginId_ptr = STR_PTR("auggie");
    self.pluginId_len = STR_LEN("auggie");
    self.status_phase_ptr = STR_PTR("stopped");
    self.status_phase_len = STR_LEN("stopped");
    self.status_transport_ptr = STR_PTR("stdio");
    self.status_transport_len = STR_LEN("stdio");
}

// DEFECT: async — TS `async start(): Promise<EngineStatus>`;
// converted to a synchronous fn returning a status code; the
// resulting EngineStatus is self.status_*.
fn AuggieEngine_start(self: &AuggieEngine) -> i32 {
    self.status_phase_ptr = STR_PTR("ready");
    self.status_phase_len = STR_LEN("ready");
    self.status_transport_ptr = STR_PTR("stdio");
    self.status_transport_len = STR_LEN("stdio");
    return 0;
}

// DEFECT: async — TS `async stop(): Promise<void>`.
fn AuggieEngine_stop(self: &AuggieEngine) -> i32 {
    self.status_phase_ptr = STR_PTR("stopped");
    self.status_phase_len = STR_LEN("stopped");
    self.status_transport_ptr = STR_PTR("stdio");
    self.status_transport_len = STR_LEN("stdio");
    return 0;
}

// status(): EngineStatus — TS returns this.#status; here the
// caller reads self.status_phase_* / self.status_transport_*.
fn AuggieEngine_status(self: &AuggieEngine) -> void {
}

// DEFECT: async + throw + unknown return — TS
// `async handleRpc(): Promise<unknown>` throws
// Error("auggie plugin engine is not wired to the host yet (phase 1 declaration)").
// SLA has no exceptions; returns error code 1.
fn AuggieEngine_handleRpc(self: &AuggieEngine, out_ptr: ptr, out_len: &u64) -> i32 {
    return 1;
}

// export const auggieServerPlugin: ServerPlugin — an object
// literal with function properties. SLA struct literals cannot
// hold closures; descriptor data is kept as fields and each
// function property becomes a free fn below.
// DEFECT: dynamic object / closures in ServerPlugin literal.
struct AuggieServerPlugin {
    manifest_doc: u64,
    cliSettings_slug_ptr: ptr,
    cliSettings_slug_len: u64,
    cliSettings_enabledEnvVar_ptr: ptr,
    cliSettings_enabledEnvVar_len: u64,
    discovery_preferredPathPrefKey_ptr: ptr,
    discovery_preferredPathPrefKey_len: u64,
}

fn auggieServerPlugin_new(self: &AuggieServerPlugin, manifest_doc: u64) -> void {
    self.manifest_doc = manifest_doc;
    self.cliSettings_slug_ptr = STR_PTR("auggie-cli");
    self.cliSettings_slug_len = STR_LEN("auggie-cli");
    self.cliSettings_enabledEnvVar_ptr = STR_PTR("CODEX_UI_AUGGIE_COMPATIBLE_CLI_ENABLED");
    self.cliSettings_enabledEnvVar_len = STR_LEN("CODEX_UI_AUGGIE_COMPATIBLE_CLI_ENABLED");
    self.discovery_preferredPathPrefKey_ptr = STR_PTR("cliPreferredAuggiePath");
    self.discovery_preferredPathPrefKey_len = STR_LEN("cliPreferredAuggiePath");
}

// discovery.binaryNames: ["auggie"]
fn auggieServerPlugin_discovery_binaryNames(idx: u64, out: &ptr, out_len: &u64) -> bool {
    if idx != 0 { return false; };
    *out = STR_PTR("auggie");
    *out_len = STR_LEN("auggie");
    return true;
}

// discovery.envBinVars: ["AUGGIE_BIN", "CODEX_UI_AUGGIE_BIN"]
fn auggieServerPlugin_discovery_envBinVars(idx: u64, out: &ptr, out_len: &u64) -> bool {
    if idx == 0 {
        *out = STR_PTR("AUGGIE_BIN");
        *out_len = STR_LEN("AUGGIE_BIN");
        return true;
    };
    if idx == 1 {
        *out = STR_PTR("CODEX_UI_AUGGIE_BIN");
        *out_len = STR_LEN("CODEX_UI_AUGGIE_BIN");
        return true;
    };
    return false;
}

// discovery.matchesKind: () => true
fn auggieServerPlugin_discovery_matchesKind() -> bool {
    return true;
}

// createEngine(_host: ServerHost): EngineHandle — returns a new engine.
fn auggieServerPlugin_createEngine(host: u64, out: &AuggieEngine) -> void {
    AuggieEngine_new(out);
}

// DEFECT: async — TS `async findInstallations(): Promise<PluginInstallation[]>` returns [].
fn auggieServerPlugin_findInstallations(out_count: &u64) -> i32 {
    *out_count = 0;
    return 0;
}

// skillRoots(): string[] — returns [".augment/skills"].
fn auggieServerPlugin_skillRoots(idx: u64, out: &ptr, out_len: &u64) -> bool {
    if idx != 0 { return false; };
    *out = STR_PTR(".augment/skills");
    *out_len = STR_LEN(".augment/skills");
    return true;
}
