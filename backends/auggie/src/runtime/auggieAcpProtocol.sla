// Converted 1:1 from backends/auggie/src/runtime/auggieAcpProtocol.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
//
// For learning and research only. Other uses are at your own risk.
//
// ACP (Agent Client Protocol) NDJSON framing for the auggie
// (Augment Code) stdio backend (`auggie --acp`). Auggie speaks
// JSON-RPC 2.0 over newline-delimited JSON on stdio, the same
// envelope shape grok uses, but the method set, approval
// direction, and interrupt method are different (see
// docs/auggie-embedded-backend-plan.md §6.1). This module borrows
// ONLY the envelope interface and `parseLine` splitter from
// grokAcpProtocol; every builder and auggie-specific event shape
// is new because reusing grok's `buildControlResponse` /
// `buildInterrupt` / `AcpControlRequestEvent` would emit
// `session/control`, which auggie answers with `MethodNotFound`.
//
// The live-confirmed envelopes at §6.2 (probe script
// `scripts/probe-auggie-acp.mjs`, 2026-08-18) are the ground
// truth for the shapes below. Pure functions only; no runtime /
// IO.
//
// DEFECT: dynamic JSON envelopes — messages are carried as
// sa_json doc handles (parsed) or assembled JSON text
// (builders). DEFECT: JSON string escaping in builders
// (JSON.stringify in TS) — raw append, noted per builder.
// DEFECT: union types + type guards — bool fns over doc fields.

// AcpMessage (interface): the shared JSON-RPC 2.0 envelope.
//   jsonrpc: "2.0", id?: number | string, method?: string,
//   params?: Record<string, unknown>, result?: unknown,
//   error?: { code?: number, message: string, data?: unknown }
// AcpEvent = AcpMessage | AcpSessionUpdateEvent |
//   AcpRequestPermissionEvent (all doc handles here).
// AcpSessionUpdateEvent: method "session/update", params
//   { sessionId, update: { sessionUpdate, content?, availableCommands? } }.
// AcpRequestPermissionEvent: method "session/request_permission",
//   id, params { sessionId, toolCall { toolCallId, title? },
//   options [{ optionId, name?, kind? }] }.
// Field access goes through sa_json_object_get* on the doc.

// AUGGIE_SESSION_UPDATE_AGENT_MESSAGE_CHUNK = "agent_message_chunk"
@import "sa_std/ts_string.sa"

fn AUGGIE_SESSION_UPDATE_AGENT_MESSAGE_CHUNK_ptr() -> ptr { return STR_PTR("agent_message_chunk"); }
fn AUGGIE_SESSION_UPDATE_AGENT_MESSAGE_CHUNK_len() -> u64 { return STR_LEN("agent_message_chunk"); }

// AUGGIE_SESSION_UPDATE_AVAILABLE_COMMANDS = "available_commands_update"
fn AUGGIE_SESSION_UPDATE_AVAILABLE_COMMANDS_ptr() -> ptr { return STR_PTR("available_commands_update"); }
fn AUGGIE_SESSION_UPDATE_AVAILABLE_COMMANDS_len() -> u64 { return STR_LEN("available_commands_update"); }

// AUGGIE_METHOD — the method-string table (§6.1). One getter per
// key: initialize, sessionNew -> "session/new", sessionPrompt,
// sessionCancel, sessionRequestPermission, sessionUpdate,
// sessionSetMode, sessionSetModel, sessionList, sessionLoad,
// sessionFork, sessionResume, fsReadTextFile ->
// "fs/read_text_file", fsWriteTextFile, terminalCreate.
fn AUGGIE_METHOD_initialize() -> ptr { return STR_PTR("initialize"); }
fn AUGGIE_METHOD_sessionNew() -> ptr { return STR_PTR("session/new"); }
fn AUGGIE_METHOD_sessionPrompt() -> ptr { return STR_PTR("session/prompt"); }
fn AUGGIE_METHOD_sessionCancel() -> ptr { return STR_PTR("session/cancel"); }
fn AUGGIE_METHOD_sessionRequestPermission() -> ptr { return STR_PTR("session/request_permission"); }
fn AUGGIE_METHOD_sessionUpdate() -> ptr { return STR_PTR("session/update"); }
fn AUGGIE_METHOD_sessionSetMode() -> ptr { return STR_PTR("session/set_mode"); }
fn AUGGIE_METHOD_sessionSetModel() -> ptr { return STR_PTR("session/set_model"); }
fn AUGGIE_METHOD_sessionList() -> ptr { return STR_PTR("session/list"); }
fn AUGGIE_METHOD_sessionLoad() -> ptr { return STR_PTR("session/load"); }
fn AUGGIE_METHOD_sessionFork() -> ptr { return STR_PTR("session/fork"); }
fn AUGGIE_METHOD_sessionResume() -> ptr { return STR_PTR("session/resume"); }
fn AUGGIE_METHOD_fsReadTextFile() -> ptr { return STR_PTR("fs/read_text_file"); }
fn AUGGIE_METHOD_fsWriteTextFile() -> ptr { return STR_PTR("fs/write_text_file"); }
fn AUGGIE_METHOD_terminalCreate() -> ptr { return STR_PTR("terminal/create"); }

// AuggiePermissionOutcome (union type):
//   { outcome: "selected", optionId: string } | { outcome: "cancelled" }
struct AuggiePermissionOutcome {
    selected: bool,
    optionId_ptr: ptr,
    optionId_len: u64,
}

// auggieProtocol.parseLine(line): parse one NDJSON line into an
// AcpEvent (doc handle), or null for blank/unparseable lines.
// DEFECT: JSON.parse try/catch -> sa_json_parse 0-check; the
// typeof obj === "object" check is inherent to the doc surface.
fn auggieProtocol_parseLine(line_ptr: ptr, line_len: u64, out_doc: &u64, out_ok: &bool) -> void {
    out_ok = false;
    out_doc = 0;
    let tp: ptr = PTR_NULL();
    let tl: u64 = 0;
    trim_span(line_ptr, line_len, &tp, &tl);
    if tl == 0 { return; };
    let doc = sa_json_parse(tp, tl);
    if doc == 0 { return; };
    out_doc = doc;
    out_ok = true;
}

// auggieProtocol.buildAuggieInitialize(): `initialize` request
// (§6.2b). Auggie reports back { protocolVersion: 1,
// agentCapabilities, agentInfo, authMethods: [] }.
fn auggieProtocol_buildAuggieInitialize(out: ptr, out_cap: u64, out_len: &u64) -> void {
    out_len = append_str(out, out_cap, 0, STR_PTR("{\"jsonrpc\":\"2.0\",\"method\":\"initialize\",\"params\":{\"protocolVersion\":1,\"clientInfo\":{\"name\":\"codex-react-ui\",\"version\":\"0.1.0\"},\"clientCapabilities\":{}}}"), STR_LEN("{\"jsonrpc\":\"2.0\",\"method\":\"initialize\",\"params\":{\"protocolVersion\":1,\"clientInfo\":{\"name\":\"codex-react-ui\",\"version\":\"0.1.0\"},\"clientCapabilities\":{}}}"));
}

// auggieProtocol.buildAuggieSessionNew(cwd): `session/new`
// request. Result carries { sessionId, modes, models } (§6.2b).
// We pass an empty mcpServers list — MCP servers are wired by
// the routing layer / redirector, not by this bridge.
fn auggieProtocol_buildAuggieSessionNew(cwd_ptr: ptr, cwd_len: u64, out: ptr, out_cap: u64, out_len: &u64) -> void {
    let n: u64 = 0;
    n = n + append_str(out, out_cap, n, STR_PTR("{\"jsonrpc\":\"2.0\",\"method\":\"session/new\",\"params\":{\"cwd\":\""), STR_LEN("{\"jsonrpc\":\"2.0\",\"method\":\"session/new\",\"params\":{\"cwd\":\""));
    n = n + append_str(out, out_cap, n, cwd_ptr, cwd_len);
    n = n + append_str(out, out_cap, n, STR_PTR("\",\"mcpServers\":[]}}"), STR_LEN("\",\"mcpServers\":[]}}"));
    out_len = n;
}

// auggieProtocol.buildAuggieSessionPrompt(sessionId, promptText):
// `session/prompt` request. prompt is an array of content
// blocks matching the live envelope {type:"text",text}; we
// accept a single string for simplicity (multi-block
// composition belongs to the routing layer).
fn auggieProtocol_buildAuggieSessionPrompt(sessionId_ptr: ptr, sessionId_len: u64, prompt_ptr: ptr, prompt_len: u64, out: ptr, out_cap: u64, out_len: &u64) -> void {
    let n: u64 = 0;
    n = n + append_str(out, out_cap, n, STR_PTR("{\"jsonrpc\":\"2.0\",\"method\":\"session/prompt\",\"params\":{\"sessionId\":\""), STR_LEN("{\"jsonrpc\":\"2.0\",\"method\":\"session/prompt\",\"params\":{\"sessionId\":\""));
    n = n + append_str(out, out_cap, n, sessionId_ptr, sessionId_len);
    n = n + append_str(out, out_cap, n, STR_PTR("\",\"prompt\":[{\"type\":\"text\",\"text\":\""), STR_LEN("\",\"prompt\":[{\"type\":\"text\",\"text\":\""));
    n = n + append_str(out, out_cap, n, prompt_ptr, prompt_len);
    n = n + append_str(out, out_cap, n, STR_PTR("\"}]}}"), STR_LEN("\"}]}}"));
    out_len = n;
}

// auggieProtocol.buildAuggieInterrupt(sessionId): interrupt
// envelope. Auggie's interrupt is the dedicated method
// `session/cancel` — NOT grok's `session/control
// {subtype:"interrupt"}` (§6.1). Emitting `session/control`
// here would raise `MethodNotFound`.
fn auggieProtocol_buildAuggieInterrupt(sessionId_ptr: ptr, sessionId_len: u64, out: ptr, out_cap: u64, out_len: &u64) -> void {
    let n: u64 = 0;
    n = n + append_str(out, out_cap, n, STR_PTR("{\"jsonrpc\":\"2.0\",\"method\":\"session/cancel\",\"params\":{\"sessionId\":\""), STR_LEN("{\"jsonrpc\":\"2.0\",\"method\":\"session/cancel\",\"params\":{\"sessionId\":\""));
    n = n + append_str(out, out_cap, n, sessionId_ptr, sessionId_len);
    n = n + append_str(out, out_cap, n, STR_PTR("\"}}"), STR_LEN("\"}}"));
    out_len = n;
}

// auggieProtocol.buildAuggiePermissionResult(id, outcome): reply
// to a `session/request_permission` request. The id must match
// the request id the agent sent. outcome "selected" carries the
// chosen optionId; "cancelled" denies (§6.2b).
// DEFECT: id is number|string in TS — carried as raw JSON text
// (id_json) here.
fn auggieProtocol_buildAuggiePermissionResult(id_json_ptr: ptr, id_json_len: u64, outcome: &AuggiePermissionOutcome, out: ptr, out_cap: u64, out_len: &u64) -> void {
    let n: u64 = 0;
    n = n + append_str(out, out_cap, n, STR_PTR("{\"jsonrpc\":\"2.0\",\"id\":"), STR_LEN("{\"jsonrpc\":\"2.0\",\"id\":"));
    n = n + append_str(out, out_cap, n, id_json_ptr, id_json_len);
    n = n + append_str(out, out_cap, n, STR_PTR(",\"result\":{\"outcome\":"), STR_LEN(",\"result\":{\"outcome\":"));
    if outcome.selected {
        n = n + append_str(out, out_cap, n, STR_PTR("{\"outcome\":\"selected\",\"optionId\":\""), STR_LEN("{\"outcome\":\"selected\",\"optionId\":\""));
        n = n + append_str(out, out_cap, n, outcome.optionId_ptr, outcome.optionId_len);
        n = n + append_str(out, out_cap, n, STR_PTR("\"}"), STR_LEN("\"}"));
    } else {
        n = n + append_str(out, out_cap, n, STR_PTR("{\"outcome\":\"cancelled\"}"), STR_LEN("{\"outcome\":\"cancelled\"}"));
    };
    n = n + append_str(out, out_cap, n, STR_PTR("}}"), STR_LEN("}}"));
    out_len = n;
}

// Named builder re-exports (same frames as the auggieProtocol
// methods): buildAuggieInitialize / buildAuggieSessionNew /
// buildAuggieSessionPrompt / buildAuggieInterrupt /
// buildAuggiePermissionResult — in SLA these ARE the fns above
// (no object indirection to re-export through).

// isAgentMessageChunk(event): type guard — is this
// session/update an agent_message_chunk carrying streaming
// assistant text? Used by the bridge to route the delta to
// item/agentMessage/delta.
fn isAgentMessageChunk(doc: u64) -> bool {
    let su_ptr: ptr = PTR_NULL();
    let su_len: u64 = 0;
    if !sessionUpdate_kind(doc, &su_ptr, &su_len) { return false; };
    return su_len == STR_LEN("agent_message_chunk") && bytes_eq(su_ptr, AUGGIE_SESSION_UPDATE_AGENT_MESSAGE_CHUNK_ptr(), su_len);
}

// isAvailableCommandsUpdate(event): type guard — the bridge
// currently logs these; future work may surface them in the
// composer.
fn isAvailableCommandsUpdate(doc: u64) -> bool {
    let su_ptr: ptr = PTR_NULL();
    let su_len: u64 = 0;
    if !sessionUpdate_kind(doc, &su_ptr, &su_len) { return false; };
    return su_len == STR_LEN("available_commands_update") && bytes_eq(su_ptr, AUGGIE_SESSION_UPDATE_AVAILABLE_COMMANDS_ptr(), su_len);
}

// asSessionUpdate(event): narrow an AcpEvent to a
// session/update event (method check), or null.
fn asSessionUpdate(doc: u64, has_doc: bool, out_ok: &bool) -> void {
    out_ok = false;
    if !has_doc { return; };
    let m_ptr: ptr = PTR_NULL();
    let m_len: u64 = 0;
    if sa_json_object_get_string(doc, STR_PTR("method"), STR_LEN("method"), &m_ptr, &m_len) != 0 { return; };
    if m_len == STR_LEN("session/update") && bytes_eq(m_ptr, AUGGIE_METHOD_sessionUpdate(), m_len) { out_ok = true; };
}

// asRequestPermission(event): narrow to a
// session/request_permission event, or null. The presence of id
// (a JSON-RPC request, not a notification) is what
// distinguishes this from a notification.
fn asRequestPermission(doc: u64, has_doc: bool, out_ok: &bool) -> void {
    out_ok = false;
    if !has_doc { return; };
    let m_ptr: ptr = PTR_NULL();
    let m_len: u64 = 0;
    if sa_json_object_get_string(doc, STR_PTR("method"), STR_LEN("method"), &m_ptr, &m_len) != 0 { return; };
    if !(m_len == STR_LEN("session/request_permission") && bytes_eq(m_ptr, AUGGIE_METHOD_sessionRequestPermission(), m_len)) { return; };
    let probe: u64 = 0;
    if sa_json_object_get(doc, STR_PTR("id"), STR_LEN("id"), &probe) != 0 { return; };
    out_ok = true;
}

// sessionUpdate_kind: params.update.sessionUpdate string.
fn sessionUpdate_kind(doc: u64, out_ptr: &ptr, out_len: &u64) -> bool {
    let params: u64 = 0;
    if sa_json_object_get(doc, STR_PTR("params"), STR_LEN("params"), &params) != 0 { return false; };
    let update: u64 = 0;
    if sa_json_object_get(params, STR_PTR("update"), STR_LEN("update"), &update) != 0 { return false; };
    return sa_json_object_get_string(update, STR_PTR("sessionUpdate"), STR_LEN("sessionUpdate"), out_ptr, out_len) == 0;
}

// ---- local helpers ----

fn byte_at(p: ptr, i: u64) -> u8 {
    let b: u8 = 0;
    PTR_BYTE_AT(b, p, i);
    return b;
}

fn bytes_eq(a: ptr, b: ptr, n: u64) -> bool {
    for i in 0..n {
        if byte_at(a, i) != byte_at(b, i) { return false; };
    }
    return true;
}

fn append_str(dst: ptr, cap: u64, at: u64, src: ptr, n: u64) -> u64 {
    let w: u64 = 0;
    for i in 0..n {
        if at + w < cap {
            PTR_BYTE_SET(dst, at + w, byte_at(src, i));
            w = w + 1;
        };
    }
    return w;
}

fn trim_span(p: ptr, n: u64, out_ptr: &ptr, out_len: &u64) -> void {
    // 已绑 sa_std ts 面 (@ts_str_trim) — wrap-up rebind.
    @ts_str_trim(out_ptr, out_len, p, n);
}

fn is_ws(b: u8) -> bool {
    return b == 32 || b == 9 || b == 10 || b == 13;
}
