    seg_turn: [u8; 16384],
    seg_turn_off: [u64; 64],
    seg_turn_len: [u64; 64],
    seg_value: [u64; 64],
    seg_count: u64,
    seg_turn_used: u64,
    // conversation: (role, text) rows
    conv_role: [u8; 512],
