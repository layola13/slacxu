}

// ---- message-log helpers ----

fn session_msg_push(s: &AuggieSession, text_ptr: ptr, text_len: u64) -> void {
    if s.msg_count >= 2048 { return; };
    s.msg_off[s.msg_count] = s.msg_used;
    s.msg_len[s.msg_count] = text_len;
    let cap_ab1: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ab1, &s.msg_arena, 0);
    s.msg_used = s.msg_used + aab_append_bytes(cap_ab1, 1048576, s.msg_used, text_ptr, text_len);
    s.msg_count = s.msg_count + 1;
}

// upsertSessionItem(session, item doc): insert-or-
// replace by the item's `id`.
fn upsertSessionItem(s: &AuggieSession, item: u64) -> void {
    let id_ptr: ptr = PTR_NULL();
    let id_len: u64 = 0;
    if item == 0 || sa_json_object_get_string(item, STR_PTR("id"), STR_LEN("id"), &id_ptr, &id_len) != 0 { return; };
    let text = [0u8; 262144];
    let text_p: ptr = PTR_NULL(); PTR_BYTE_ADD(text_p, &text, 0);
    let text_len = aab_stringify_into(item, text_p, 262144);
    for i in 0..s.msg_count {
        let cap_aab26162: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26162, &s.msg_arena, 0);
        let entry = sa_json_parse(aab_byte_off( cap_aab26162, s.msg_off[i]), s.msg_len[i]);
        let e_ptr: ptr = PTR_NULL();
        let e_len: u64 = 0;
        if entry != 0 && sa_json_object_get_string(entry, STR_PTR("id"), STR_LEN("id"), &e_ptr, &e_len) == 0 && e_len == id_len && aab_bytes_eq(e_ptr, id_ptr, e_len) {
            // replace: append the new text, repoint slot
            s.msg_off[i] = s.msg_used;
            s.msg_len[i] = text_len;
            let cap_ab2: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ab2, &s.msg_arena, 0);
            s.msg_used = s.msg_used + aab_append_bytes(cap_ab2, 1048576, s.msg_used, text_p, text_len);
            return;
        };
    }
    session_msg_push(s, text_p, text_len);
}

fn session_find(s: &AuggieSession, threadId_ptr: ptr, threadId_len: u64) -> bool {
    let cap_aab26192: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26192, &s.threadId, 0);
    return s.threadId_len == threadId_len && aab_bytes_eq( cap_aab26192, threadId_ptr, threadId_len);
}

// auggieTurnHasUnsettledTools(session, turnId)
fn auggieTurnHasUnsettledTools(s: &AuggieSession, turnId_ptr: ptr, turnId_len: u64) -> bool {
    for i in 0..s.tc_count {
        let cap_aab26163: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26163, &s.tc_item, 0);
        let item = sa_json_parse(aab_byte_off( cap_aab26163, s.tc_item_off[i]), s.tc_item_len[i]);
        if item == 0 { continue; };
        let t_ptr: ptr = PTR_NULL();
        let t_len: u64 = 0;
        if sa_json_object_get_string(item, STR_PTR("turnId"), STR_LEN("turnId"), &t_ptr, &t_len) != 0 { continue; };
        if t_len != turnId_len || !aab_bytes_eq(t_ptr, turnId_ptr, t_len) { continue; };
        let st_ptr: ptr = PTR_NULL();
        let st_len: u64 = 0;
        if sa_json_object_get_string(item, STR_PTR("status"), STR_LEN("status"), &st_ptr, &st_len) == 0 && aab_str_is(st_ptr, st_len, STR_PTR("inProgress"), STR_LEN("inProgress")) {
            return true;
        };
    }
    return false;
}

// toolCallsByAcpId set/get over the session table.
fn session_tc_set(s: &AuggieSession, acpId_ptr: ptr, acpId_len: u64, item: u64) -> void {
    let text = [0u8; 262144];
    let text_p: ptr = PTR_NULL(); PTR_BYTE_ADD(text_p, &text, 0);
    let text_len = aab_stringify_into(item, text_p, 262144);
    for i in 0..s.tc_count {
        let cap_aab26164: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26164, &s.tc_id, 0);
        if s.tc_id_len[i] == acpId_len && aab_bytes_eq(aab_byte_off( cap_aab26164, s.tc_id_off[i]), acpId_ptr, acpId_len) {
            s.tc_item_off[i] = s.tc_item_used;
            s.tc_item_len[i] = text_len;
            let cap_ab3: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ab3, &s.tc_item, 0);
            s.tc_item_used = s.tc_item_used + aab_append_bytes(cap_ab3, 1048576, s.tc_item_used, text_p, text_len);
            return;
        };
    }
    if s.tc_count >= 512 { return; };
    let i = s.tc_count;
    s.tc_id_off[i] = s.tc_id_used;
    s.tc_id_len[i] = acpId_len;
    let cap_ab4: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ab4, &s.tc_id, 0);
    s.tc_id_used = s.tc_id_used + aab_append_bytes(cap_ab4, 65536, s.tc_id_used, acpId_ptr, acpId_len);
    s.tc_item_off[i] = s.tc_item_used;
    s.tc_item_len[i] = text_len;
    let cap_ab5: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ab5, &s.tc_item, 0);
    s.tc_item_used = s.tc_item_used + aab_append_bytes(cap_ab5, 1048576, s.tc_item_used, text_p, text_len);
    s.tc_count = s.tc_count + 1;
}

fn session_tc_get(s: &AuggieSession, acpId_ptr: ptr, acpId_len: u64, out_doc: &u64) -> bool {
    *out_doc = 0;
    for i in 0..s.tc_count {
        let cap_aab26165: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26165, &s.tc_id, 0);
        if s.tc_id_len[i] == acpId_len && aab_bytes_eq(aab_byte_off( cap_aab26165, s.tc_id_off[i]), acpId_ptr, acpId_len) {
            let cap_aab26166: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26166, &s.tc_item, 0);
            *out_doc = sa_json_parse(aab_byte_off( cap_aab26166, s.tc_item_off[i]), s.tc_item_len[i]);
            return *out_doc != 0;
        };
    }
    return false;
}

// ---- agents fleet (rollout todolist F2) ----

// resolveAuggieCacheDir(env): AUGGIE_CACHE_DIR ??
// AUGMENT_CACHE_DIR (trimmed; trim 已绑 ts 面), else
// ~/.augment.
fn resolveAuggieCacheDir(env_ptr: ptr, env_len: u64, out: ptr, out_cap: u64) -> u64 {
    let v_ptr: ptr = PTR_NULL();
    let v_len: u64 = 0;
    let has = env_get(env_ptr, env_len, STR_PTR("AUGGIE_CACHE_DIR"), STR_LEN("AUGGIE_CACHE_DIR"), &v_ptr, &v_len);
    if !has { has = env_get(env_ptr, env_len, STR_PTR("AUGMENT_CACHE_DIR"), STR_LEN("AUGMENT_CACHE_DIR"), &v_ptr, &v_len); };
    if has {
        let tp: ptr = PTR_NULL();
        let tl: u64 = 0;
        aab_ts_trim_span(v_ptr, v_len, &tp, &tl);
        if tl > 0 { return aab_buf_copy(out, out_cap, v_ptr, v_len); };
    };
    let home_ptr: ptr = PTR_NULL();
    let home_len: u64 = 0;
    env_get(env_ptr, env_len, STR_PTR("HOME"), STR_LEN("HOME"), &home_ptr, &home_len);
    return join2(out, out_cap, home_ptr, home_len, STR_PTR(".augment"), STR_LEN(".augment"));
}

// nodeExecutableForAuggie(env): AUGGIE_NODE_BIN override;
// non-Bun -> process exec path (host shim); Bun -> first
// node.exe/node on PATH that exists; else exec path.
// DEFECT: the Bun-runtime detection (globalThis.Bun) has
// no SLA counterpart; the host shim reports it.
fn nodeExecutableForAuggie(env_ptr: ptr, env_len: u64, out: ptr, out_cap: u64) -> u64 {
    let v_ptr: ptr = PTR_NULL();
    let v_len: u64 = 0;
    if env_get(env_ptr, env_len, STR_PTR("AUGGIE_NODE_BIN"), STR_LEN("AUGGIE_NODE_BIN"), &v_ptr, &v_len) {
        let tp: ptr = PTR_NULL();
        let tl: u64 = 0;
        aab_ts_trim_span(v_ptr, v_len, &tp, &tl);
        if tl > 0 { return aab_buf_copy(out, out_cap, tp, tl); };
    };
    if !host_is_bun() {
        return host_exec_path(out, out_cap);
    };
    let path_ptr: ptr = PTR_NULL();
    let path_len: u64 = 0;
    let has_path = env_get(env_ptr, env_len, STR_PTR("PATH"), STR_LEN("PATH"), &path_ptr, &path_len);
    if !has_path { has_path = env_get(env_ptr, env_len, STR_PTR("Path"), STR_LEN("Path"), &path_ptr, &path_len); };
    if !has_path { has_path = env_get(env_ptr, env_len, STR_PTR("path"), STR_LEN("path"), &path_ptr, &path_len); };
    if has_path {
        // split on the platform path delimiter
        let delim: u8 = 58; // ':'
        if host_is_windows() { delim = 59; }; // ';'
        let pos: u64 = 0;
        while pos <= path_len {
            let end = aab_find_byte(path_ptr, path_len, pos, delim);
            if end == 4294967295 { end = path_len; };
            let dlen = end - pos;
            if dlen > 0 {
                let cand = [0u8; 1024];
                let cand_p: ptr = PTR_NULL(); PTR_BYTE_ADD(cand_p, &cand, 0);
                let cand_len = join2(cand_p, 1024, aab_byte_off(path_ptr, pos), dlen, STR_PTR("node.exe"), STR_LEN("node.exe"));
                if aab_fs_exists(cand_p, cand_len) { return aab_buf_copy(out, out_cap, cand_p, cand_len); };
                cand_len = join2(cand_p, 1024, aab_byte_off(path_ptr, pos), dlen, STR_PTR("node"), STR_LEN("node"));
                if aab_fs_exists(cand_p, cand_len) { return aab_buf_copy(out, out_cap, cand_p, cand_len); };
            };
            if end == path_len { break; };
            pos = end + 1;
        }
    };
    return host_exec_path(out, out_cap);
}

// ensureAuggieOnboardingComplete(denyIndexingDir?,
// homeDir): merge onboardingVersion/anonId/
// indexingDenyDirs into ~/.augment/.auggie.json; write
// only when changed. Returns 0 ok, 1 error (non-fatal
// at the call site).
fn ensureAuggieOnboardingComplete(deny_ptr: ptr, deny_len: u64, has_deny: bool, home_ptr: ptr, home_len: u64, out_err: ptr, out_err_cap: u64, out_err_len: &u64) -> i32 {
    *out_err_len = 0;
    let state_path = [0u8; 1024];
    let state_path_p: ptr = PTR_NULL(); PTR_BYTE_ADD(state_path_p, &state_path, 0);
    let state_path_len = join3(state_path_p, 1024, home_ptr, home_len, STR_PTR(".augment"), STR_LEN(".augment"), STR_PTR(".auggie.json"), STR_LEN(".auggie.json"));
    let state = aab_json_object_new();
    let raw = [0u8; 262144];
    let raw_p: ptr = PTR_NULL(); PTR_BYTE_ADD(raw_p, &raw, 0);
    let raw_len: u64 = 0;
    let has_raw = false;
    if fs_read_file(state_path_p, state_path_len, raw_p, 262144, &raw_len) == 0 {
        has_raw = true;
        let parsed = sa_json_parse(raw_p, raw_len);
        let is_obj = false;
        if parsed != 0 { aab_json_node_is_object(parsed, &is_obj); };
        if is_obj { state = parsed; };
    };
    let changed = false;
    let ov_ptr: ptr = PTR_NULL();
    let ov_len: u64 = 0;
    if sa_json_object_get_string(state, STR_PTR("onboardingVersion"), STR_LEN("onboardingVersion"), &ov_ptr, &ov_len) != 0 || ov_len == 0 {
        aab_sa_json_object_set_string(state, STR_PTR("onboardingVersion"), STR_LEN("onboardingVersion"), STR_PTR("1.0.0"), STR_LEN("1.0.0"));
        changed = true;
    };
    let anon_ptr: ptr = PTR_NULL();
    let anon_len: u64 = 0;
    if sa_json_object_get_string(state, STR_PTR("anonId"), STR_LEN("anonId"), &anon_ptr, &anon_len) != 0 || anon_len == 0 {
        let uid = [0u8; 64];
        let uid_p: ptr = PTR_NULL(); PTR_BYTE_ADD(uid_p, &uid, 0);
        let uid_len = aab_uuid_new(uid_p, 64);
        aab_sa_json_object_set_string(state, STR_PTR("anonId"), STR_LEN("anonId"), uid_p, uid_len);
        changed = true;
    };
    if has_deny {
        let tp: ptr = PTR_NULL();
        let tl: u64 = 0;
        aab_ts_trim_span(deny_ptr, deny_len, &tp, &tl);
        if tl > 0 {
            let existing: u64 = 0;
            let arr = aab_json_array_new();
            if sa_json_object_get(state, STR_PTR("indexingDenyDirs"), STR_LEN("indexingDenyDirs"), &existing) == 0 && existing != 0 {
                let is_arr = false;
                aab_json_node_is_array(existing, &is_arr);
                if is_arr { arr = existing; };
            };
            let count: u64 = 0;
            sa_json_value_count(arr, &count);
            let present = false;
            for i in 0..count {
                let e: u64 = 0;
                sa_json_array_get(arr, i, &e);
                let ep: ptr = PTR_NULL();
                let el: u64 = 0;
                if e != 0 {
                    let is_str = false;
                    aab_json_node_is_string(e, &is_str);
                    if is_str {
                        aab_json_node_string(e, &ep, &el);
                        if el == tl && aab_bytes_eq(ep, tp, el) { present = true; };
                    };
                };
            }
            if !present {
                let dir_doc = sa_json_parse(STR_PTR("\"x\""), 3);
                aab_sa_json_object_set_string(dir_doc, STR_PTR(""), 0, tp, tl);
                sa_json_array_push_node(arr, dir_doc);
                sa_json_object_set_node(state, STR_PTR("indexingDenyDirs"), STR_LEN("indexingDenyDirs"), arr);
                changed = true;
            };
        };
    };
    if !changed { return 0; };
    let dir = [0u8; 1024];
    let dir_p: ptr = PTR_NULL(); PTR_BYTE_ADD(dir_p, &dir, 0);
    let dir_len = join2(dir_p, 1024, home_ptr, home_len, STR_PTR(".augment"), STR_LEN(".augment"));
    fs_mkdir_recursive(dir_p, dir_len);
    let text = [0u8; 262144];
    let text_p: ptr = PTR_NULL(); PTR_BYTE_ADD(text_p, &text, 0);
    let text_len = sa_json_stringify_pretty(state, text_p, 262144);
    text_len = text_len + aab_append_bytes(text_p, 262144, text_len, STR_PTR("\n"), 1);
    if fs_write_file(state_path_p, state_path_len, text_p, text_len) != 0 {
        *out_err_len = aab_buf_copy(out_err, out_err_cap, STR_PTR("write failed"), STR_LEN("write failed"));
        return 1;
    };
    return 0;
}

// AuggieAgentFleetEntry: one fleet definition (fields
// mirror the TS type; optionals via has_ flags). Entries
// travel as JSON text in this conversion.
struct AuggieAgentFleetEntry {
    name: [u8; 256],
    name_len: u64,
    prompt: [u8; 16384],
    prompt_len: u64,
    description: [u8; 1024],
    description_len: u64,
    has_description: bool,
    model: [u8; 256],
    model_len: u64,
    has_model: bool,
    color: [u8; 64],
    color_len: u64,
    has_color: bool,
    tools: [u8; 4096],
    tools_len: u64,
    tool_count: u64,
    disabledTools: [u8; 4096],
    disabledTools_len: u64,
    disabled_count: u64,
    finishTool: [u8; 256],
    finishTool_len: u64,
    has_finishTool: bool,
}

// buildAuggieAgentMarkdown(entry): frontmatter + body.
// Pure.
fn buildAuggieAgentMarkdown(entry: &AuggieAgentFleetEntry, out: ptr, out_cap: u64) -> u64 {
    let n: u64 = 0;
    n = n + aab_append_bytes(out, out_cap, n, STR_PTR("---\n"), 4);
    // each line: "<key>: <trimmed value>\n" when non-blank
    if entry.has_description { let cap_aabF1: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aabF1, &entry.description, 0); n = fleet_line(out, out_cap, n, STR_PTR("description"), STR_LEN("description"), cap_aabF1, entry.description_len); };
    if entry.has_model { let cap_aabF2: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aabF2, &entry.model, 0); n = fleet_line(out, out_cap, n, STR_PTR("model"), STR_LEN("model"), cap_aabF2, entry.model_len); };
    if entry.has_color { let cap_aabF3: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aabF3, &entry.color, 0); n = fleet_line(out, out_cap, n, STR_PTR("color"), STR_LEN("color"), cap_aabF3, entry.color_len); };
    if entry.tool_count > 0 {
        n = n + aab_append_bytes(out, out_cap, n, STR_PTR("tools: "), STR_LEN("tools: "));
        let cap_ab6: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ab6, &entry.tools, 0);
        n = n + aab_append_bytes(out, out_cap, n, cap_ab6, entry.tools_len);
        n = n + aab_append_bytes(out, out_cap, n, STR_PTR("\n"), 1);
    } else if entry.disabled_count > 0 {
        n = n + aab_append_bytes(out, out_cap, n, STR_PTR("disabledTools: "), STR_LEN("disabledTools: "));
        let cap_ab7: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ab7, &entry.disabledTools, 0);
        n = n + aab_append_bytes(out, out_cap, n, cap_ab7, entry.disabledTools_len);
        n = n + aab_append_bytes(out, out_cap, n, STR_PTR("\n"), 1);
    };
    if entry.has_finishTool { let cap_aabF4: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aabF4, &entry.finishTool, 0); n = fleet_line(out, out_cap, n, STR_PTR("finishTool"), STR_LEN("finishTool"), cap_aabF4, entry.finishTool_len); };
    n = n + aab_append_bytes(out, out_cap, n, STR_PTR("---\n\n"), 5);
    let cap_ab8: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ab8, &entry.prompt, 0);
    n = n + aab_append_bytes(out, out_cap, n, cap_ab8, entry.prompt_len);
    let cap_aab26466: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26466, &entry.prompt, 0);
    if entry.prompt_len == 0 || aab_byte_at( cap_aab26466, entry.prompt_len - 1) != 10 {
        n = n + aab_append_bytes(out, out_cap, n, STR_PTR("\n"), 1);
    };
    return n;
}

fn fleet_line(out: ptr, out_cap: u64, used: u64, key_ptr: ptr, key_len: u64, value: ptr, value_len: u64) -> u64 {
    let tp: ptr = PTR_NULL();
    let tl: u64 = 0;
    aab_ts_trim_span(value, value_len, &tp, &tl);
    if tl == 0 { return used; };
    let n = used;
    n = n + aab_append_bytes(out, out_cap, n, key_ptr, key_len);
    n = n + aab_append_bytes(out, out_cap, n, STR_PTR(": "), 2);
    n = n + aab_append_bytes(out, out_cap, n, tp, tl);
    n = n + aab_append_bytes(out, out_cap, n, STR_PTR("\n"), 1);
    return n;
}

// auggieAgentFileName(name): slug via hand scan
// replacing /[^a-z0-9_-]+/ runs with "-" and trimming
// edge dashes (source RegExp -> hand scan).
fn auggieAgentFileName(name_ptr: ptr, name_len: u64, out: ptr, out_cap: u64) -> u64 {
    let tp: ptr = PTR_NULL();
    let tl: u64 = 0;
    aab_ts_trim_span(name_ptr, name_len, &tp, &tl);
    let slug = [0u8; 512];
    let slug_p: ptr = PTR_NULL(); PTR_BYTE_ADD(slug_p, &slug, 0);
    let slug_len: u64 = 0;
    let in_bad_run = false;
    for i in 0..tl {
        let b = aab_byte_at(tp, i);
        let lb = if b >= 65 && b <= 90 { b + 32 } else { b };
        let ok = (lb >= 97 && lb <= 122) || (lb >= 48 && lb <= 57) || lb == 95 || lb == 45;
        if ok {
            slug_len = slug_len + aab_append_bytes(slug_p, 512, slug_len, aab_byte_off(tp, i), 1);
            // lowercase the byte just written
            PTR_WRITE_U8(aab_byte_off(slug_p, slug_len - 1), lb);
            in_bad_run = false;
        } else if !in_bad_run {
            slug_len = slug_len + aab_append_bytes(slug_p, 512, slug_len, STR_PTR("-"), 1);
            in_bad_run = true;
        };
    }
    // strip leading/trailing dashes
    let start: u64 = 0;
    while start < slug_len && slug[start] == 45 { start = start + 1; }
    let end = slug_len;
    while end > start && slug[end - 1] == 45 { end = end - 1; }
    let n: u64 = 0;
    if end > start {
        n = n + aab_append_bytes(out, out_cap, n, aab_byte_off(slug_p, start), end - start);
    } else {
        n = n + aab_append_bytes(out, out_cap, n, STR_PTR("agent"), STR_LEN("agent"));
    };
    n = n + aab_append_bytes(out, out_cap, n, STR_PTR(".md"), 3);
    return n;
}

// writeAuggieAgentFleet(cacheDir, agents) -> agentsDir
// text or error.
fn writeAuggieAgentFleet(cacheDir_ptr: ptr, cacheDir_len: u64, entries: ptr, entries_len: u64, out: ptr, out_cap: u64, out_err: &i32) -> u64 {
    *out_err = 0;
    let agents_dir = [0u8; 1024];
    let agents_dir_p: ptr = PTR_NULL(); PTR_BYTE_ADD(agents_dir_p, &agents_dir, 0);
    let agents_dir_len = join2(agents_dir_p, 1024, cacheDir_ptr, cacheDir_len, STR_PTR("agents"), STR_LEN("agents"));
    fs_mkdir_recursive(agents_dir_p, agents_dir_len);
    let doc = sa_json_parse(entries, entries_len);
    let count: u64 = 0;
    if doc != 0 { sa_json_value_count(doc, &count); };
    for i in 0..count {
        let entry_doc: u64 = 0;
        sa_json_array_get(doc, i, &entry_doc);
        if entry_doc == 0 { continue; };
        let entry = AuggieAgentFleetEntry{ name: [0u8; 256], name_len: 0, prompt: [0u8; 16384], prompt_len: 0, description: [0u8; 1024], description_len: 0, has_description: false, model: [0u8; 256], model_len: 0, has_model: false, color: [0u8; 64], color_len: 0, has_color: false, tools: [0u8; 4096], tools_len: 0, tool_count: 0, disabledTools: [0u8; 4096], disabledTools_len: 0, disabled_count: 0, finishTool: [0u8; 256], finishTool_len: 0, has_finishTool: false };
        fleet_entry_from_doc(entry_doc, &entry);
        let md = [0u8; 32768];
        let md_p: ptr = PTR_NULL(); PTR_BYTE_ADD(md_p, &md, 0);
        let md_len = buildAuggieAgentMarkdown(&entry, md_p, 32768);
        let fname = [0u8; 512];
        let fname_p: ptr = PTR_NULL(); PTR_BYTE_ADD(fname_p, &fname, 0);
        let cap_aab26467: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26467, &entry.name, 0);
        let fname_len = auggieAgentFileName( cap_aab26467, entry.name_len, fname_p, 512);
        let fpath = [0u8; 1536];
        let fpath_p: ptr = PTR_NULL(); PTR_BYTE_ADD(fpath_p, &fpath, 0);
        let fpath_len = join2(fpath_p, 1536, agents_dir_p, agents_dir_len, fname_p, fname_len);
        fs_write_file(fpath_p, fpath_len, md_p, md_len);
    }
    return aab_buf_copy(out, out_cap, agents_dir_p, agents_dir_len);
}

// fleet_entry_from_doc: project a fleet-entry JSON doc
// into the struct (string lists joined ", " after
// trim+filter, mirroring buildAuggieAgentMarkdown's
// per-tool trims).
fn fleet_entry_from_doc(doc: u64, entry: &AuggieAgentFleetEntry) -> void {
    let p: ptr = PTR_NULL();
    let l: u64 = 0;
    let cap_aab26468: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26468, &entry.name, 0);
    if sa_json_object_get_string(doc, STR_PTR("name"), STR_LEN("name"), &p, &l) == 0 { entry.name_len = aab_buf_copy( cap_aab26468, 256, p, l); };
    let cap_aab26469: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26469, &entry.prompt, 0);
    if sa_json_object_get_string(doc, STR_PTR("prompt"), STR_LEN("prompt"), &p, &l) == 0 { entry.prompt_len = aab_buf_copy( cap_aab26469, 16384, p, l); };
    let cap_aab26470: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26470, &entry.description, 0);
    if sa_json_object_get_string(doc, STR_PTR("description"), STR_LEN("description"), &p, &l) == 0 { entry.description_len = aab_buf_copy( cap_aab26470, 1024, p, l); entry.has_description = true; };
    let cap_aab26471: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26471, &entry.model, 0);
    if sa_json_object_get_string(doc, STR_PTR("model"), STR_LEN("model"), &p, &l) == 0 { entry.model_len = aab_buf_copy( cap_aab26471, 256, p, l); entry.has_model = true; };
    let cap_aab26472: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26472, &entry.color, 0);
    if sa_json_object_get_string(doc, STR_PTR("color"), STR_LEN("color"), &p, &l) == 0 { entry.color_len = aab_buf_copy( cap_aab26472, 64, p, l); entry.has_color = true; };
    let cap_aab26473: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26473, &entry.finishTool, 0);
    if sa_json_object_get_string(doc, STR_PTR("finishTool"), STR_LEN("finishTool"), &p, &l) == 0 { entry.finishTool_len = aab_buf_copy( cap_aab26473, 256, p, l); entry.has_finishTool = true; };
    let cap_aab26522: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26522, &entry.tools, 0);
    entry.tool_count = fleet_join_tools(doc, STR_PTR("tools"), STR_LEN("tools"), cap_aab26522, 4096, &entry.tools_len);
    let cap_aab26523: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26523, &entry.disabledTools, 0);
    entry.disabled_count = fleet_join_tools(doc, STR_PTR("disabledTools"), STR_LEN("disabledTools"), cap_aab26523, 4096, &entry.disabledTools_len);
}

fn fleet_join_tools(doc: u64, key_ptr: ptr, key_len: u64, out: ptr, out_cap: u64, out_len: &u64) -> u64 {
    *out_len = 0;
    let arr: u64 = 0;
    if sa_json_object_get(doc, key_ptr, key_len, &arr) != 0 || arr == 0 { return 0; };
    let count: u64 = 0;
    sa_json_value_count(arr, &count);
    let kept: u64 = 0;
    let n: u64 = 0;
    for i in 0..count {
        let e: u64 = 0;
        sa_json_array_get(arr, i, &e);
        if e == 0 { continue; };
        let is_str = false;
        aab_json_node_is_string(e, &is_str);
        if !is_str { continue; };
        let ep: ptr = PTR_NULL();
        let el: u64 = 0;
        aab_json_node_string(e, &ep, &el);
        let tp: ptr = PTR_NULL();
        let tl: u64 = 0;
        aab_ts_trim_span(ep, el, &tp, &tl);
        if tl == 0 { continue; };
        if kept > 0 { n = n + aab_append_bytes(out, out_cap, n, STR_PTR(", "), 2); };
        n = n + aab_append_bytes(out, out_cap, n, tp, tl);
        kept = kept + 1;
    }
    *out_len = n;
    return kept;
}

// parseAuggieAgentFleetEnv(env) -> entries JSON text
// ("[]" on any malformation — the child still starts
// with auggie's built-ins).
fn parseAuggieAgentFleetEnv(env_ptr: ptr, env_len: u64, out: ptr, out_cap: u64) -> u64 {
    let raw_ptr: ptr = PTR_NULL();
    let raw_len: u64 = 0;
    if !env_get(env_ptr, env_len, STR_PTR("AUGGIE_AGENT_FLEET"), STR_LEN("AUGGIE_AGENT_FLEET"), &raw_ptr, &raw_len) {
        return aab_buf_copy(out, out_cap, STR_PTR("[]"), 2);
    };
    let tp: ptr = PTR_NULL();
    let tl: u64 = 0;
    aab_ts_trim_span(raw_ptr, raw_len, &tp, &tl);
    if tl == 0 { return aab_buf_copy(out, out_cap, STR_PTR("[]"), 2); };
    let doc = sa_json_parse(tp, tl);
    if doc == 0 { return aab_buf_copy(out, out_cap, STR_PTR("[]"), 2); };
    let is_arr = false;
    aab_json_node_is_array(doc, &is_arr);
    if !is_arr { return aab_buf_copy(out, out_cap, STR_PTR("[]"), 2); };
    // filter: keep objects with string name + prompt
    let kept = aab_json_array_new();
    let count: u64 = 0;
    sa_json_value_count(doc, &count);
    for i in 0..count {
        let e: u64 = 0;
        sa_json_array_get(doc, i, &e);
        if e == 0 { continue; };
        let is_obj = false;
        aab_json_node_is_object(e, &is_obj);
        if !is_obj { continue; };
        let np: ptr = PTR_NULL();
        let nl: u64 = 0;
        let pp: ptr = PTR_NULL();
        let pl: u64 = 0;
        if sa_json_object_get_string(e, STR_PTR("name"), STR_LEN("name"), &np, &nl) != 0 { continue; };
        if sa_json_object_get_string(e, STR_PTR("prompt"), STR_LEN("prompt"), &pp, &pl) != 0 { continue; };
        sa_json_array_push_node(kept, e);
    }
    return aab_stringify_into(kept, out, out_cap);
}

// ---- bridge core ----

// AuggieAgentBridge_new(self, env snapshot): the
// runtimeEnv closure of the source collapses to the
// caller-supplied env snapshot; AUGMENT_DISABLE_AUTO_UPDATE=1
// is forced into it (the registry's env provider in
// auggieRuntime.ts sets it for every auggie spawn).
fn AuggieAgentBridge_new(self: &AuggieAgentBridge, env_ptr: ptr, env_len: u64) -> void {
    self.has_child = false;
    self.child_exited = false;
    self.line_len = 0;
    self.next_request_id = 1;
    self.pending_count = 0;
    self.pending_used = 0;
    self.pending_prompt_count = 0;
    self.pending_perm_count = 0;
    let cap_aab26474: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26474, &self.status_phase, 0);
    self.status_phase_len = aab_buf_copy( cap_aab26474, 32, STR_PTR("idle"), STR_LEN("idle"));
    self.status_message_len = 0;
    self.status_started_at = 0;
    self.has_configuredModel = false;
    self.configuredModel_len = 0;
    self.has_configuredCwd = false;
    self.configuredCwd_len = 0;
    self.has_configuredThreadId = false;
    self.configuredThreadId_len = 0;
    self.session_count = 0;
    self.map_count = 0;
    self.map_session_used = 0;
    self.map_thread_used = 0;
    self.has_redirector = false;
    self.event_queue_len = 0;
    let cap_aab26475: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26475, &self.env_snapshot, 0);
    self.env_snapshot_len = aab_buf_copy( cap_aab26475, 32768, env_ptr, env_len);
    let cap_aab26524: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26524, &self.env_snapshot, 0);
    env_set( cap_aab26524, 32768, &self.env_snapshot_len, STR_PTR("AUGMENT_DISABLE_AUTO_UPDATE"), STR_LEN("AUGMENT_DISABLE_AUTO_UPDATE"), STR_PTR("1"), 1);
}

// bridge_emit: append one event record to the queue
// (kind\tpayload\n) — the EventEmitter surface.
fn bridge_emit(self: &AuggieAgentBridge, kind_ptr: ptr, kind_len: u64, payload_ptr: ptr, payload_len: u64) -> void {
    let cap_ab9: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ab9, &self.event_queue, 0);
    self.event_queue_len = self.event_queue_len + aab_append_bytes(cap_ab9, 1048576, self.event_queue_len, kind_ptr, kind_len);
    let cap_ab10: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ab10, &self.event_queue, 0);
    self.event_queue_len = self.event_queue_len + aab_append_bytes(cap_ab10, 1048576, self.event_queue_len, STR_PTR("\t"), 1);
    let cap_ab11: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ab11, &self.event_queue, 0);
    self.event_queue_len = self.event_queue_len + aab_append_bytes(cap_ab11, 1048576, self.event_queue_len, payload_ptr, payload_len);
    let cap_ab12: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ab12, &self.event_queue, 0);
    self.event_queue_len = self.event_queue_len + aab_append_bytes(cap_ab12, 1048576, self.event_queue_len, STR_PTR("\n"), 1);
}

fn bridge_emit_message(self: &AuggieAgentBridge, doc: u64) -> void {
    let text = [0u8; 262144];
    let text_p: ptr = PTR_NULL(); PTR_BYTE_ADD(text_p, &text, 0);
    let text_len = aab_stringify_into(doc, text_p, 262144);
    bridge_emit(self, STR_PTR("message"), STR_LEN("message"), text_p, text_len);
}

fn bridge_emit_stderr(self: &AuggieAgentBridge, text_ptr: ptr, text_len: u64) -> void {
    bridge_emit(self, STR_PTR("stderr"), STR_LEN("stderr"), text_ptr, text_len);
}

// eventLogger(): lazily-created diagnostic event log —
// DEFECT: the sdk's createBridgeEventLogger is a host
// shim here; appends are best-effort and never break
// turns (the source wraps them in try/catch throughout).
fn event_log_append(self: &AuggieAgentBridge, doc: u64) -> void {
    let text = [0u8; 262144];
    let text_p: ptr = PTR_NULL(); PTR_BYTE_ADD(text_p, &text, 0);
    let text_len = aab_stringify_into(doc, text_p, 262144);
    host_event_log_frame(STR_PTR("auggie"), STR_LEN("auggie"), text_p, text_len);
}

// getStatus(): {phase, transport: "stdio", message?,
// startedAt?} as JSON text.
fn AuggieAgentBridge_getStatus(self: &AuggieAgentBridge, out: ptr, out_cap: u64) -> u64 {
    let n: u64 = 0;
    n = n + aab_append_bytes(out, out_cap, n, STR_PTR("{\"phase\":\""), STR_LEN("{\"phase\":\""));
    let cap_ab13: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ab13, &self.status_phase, 0);
    n = n + aab_append_bytes(out, out_cap, n, cap_ab13, self.status_phase_len);
    n = n + aab_append_bytes(out, out_cap, n, STR_PTR("\",\"transport\":\"stdio\""), STR_LEN("\",\"transport\":\"stdio\""));
    if self.status_message_len > 0 {
        n = n + aab_append_bytes(out, out_cap, n, STR_PTR(",\"message\":\""), STR_LEN(",\"message\":\""));
        let cap_ab14: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ab14, &self.status_message, 0);
        n = n + aab_append_bytes(out, out_cap, n, cap_ab14, self.status_message_len);
        n = n + aab_append_bytes(out, out_cap, n, STR_PTR("\""), 1);
    };
    if self.status_started_at > 0 {
        n = n + aab_append_bytes(out, out_cap, n, STR_PTR(",\"startedAt\":"), STR_LEN(",\"startedAt\":"));
        n = n + aab_append_i64(out, out_cap, n, self.status_started_at);
    };
    n = n + aab_append_bytes(out, out_cap, n, STR_PTR("}"), 1);
    return n;
}

fn set_status(self: &AuggieAgentBridge, phase_ptr: ptr, phase_len: u64, message_ptr: ptr, message_len: u64, has_message: bool, started_at: i64, has_started_at: bool) -> void {
    let cap_aab26476: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26476, &self.status_phase, 0);
    self.status_phase_len = aab_buf_copy( cap_aab26476, 32, phase_ptr, phase_len);
    if has_message {
        let cap_aab26477: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26477, &self.status_message, 0);
        self.status_message_len = aab_buf_copy( cap_aab26477, 1024, message_ptr, message_len);
    };
    if has_started_at { self.status_started_at = started_at; };
    let text = [0u8; 2048];
    let text_p: ptr = PTR_NULL(); PTR_BYTE_ADD(text_p, &text, 0);
    let text_len = AuggieAgentBridge_getStatus(self, text_p, 2048);
    bridge_emit(self, STR_PTR("status"), STR_LEN("status"), text_p, text_len);
}

// probedVersionLabel()
fn probedVersionLabel(self: &AuggieAgentBridge, out: ptr, out_cap: u64) -> u64 {
    let bin = [0u8; 1024];
    let bin_p: ptr = PTR_NULL(); PTR_BYTE_ADD(bin_p, &bin, 0);
    let bin_len: u64 = 0;
    let found = false;
    findAuggieBin(false, bin_p, 1024, &bin_len, &found);
    if found {
        let v_len: u64 = 0;
        let has_v = false;
        probeAuggieVersion(&self.version_cache, bin_p, bin_len, out, out_cap, &v_len, &has_v);
        if has_v { return v_len; };
    };
    return aab_buf_copy(out, out_cap, STR_PTR("external"), STR_LEN("external"));
}

// applyStartConfig(params?)
fn applyStartConfig(self: &AuggieAgentBridge, params: u64) -> void {
    let p = jsonRecord(params);
    let v_ptr: ptr = PTR_NULL();
    let v_len: u64 = 0;
    if sa_json_object_get_string(p, STR_PTR("threadId"), STR_LEN("threadId"), &v_ptr, &v_len) == 0 && v_len > 0 {
        let cap_aab26478: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26478, &self.configuredThreadId, 0);
        self.configuredThreadId_len = aab_buf_copy( cap_aab26478, 128, v_ptr, v_len);
        self.has_configuredThreadId = true;
    };
    if sa_json_object_get_string(p, STR_PTR("model"), STR_LEN("model"), &v_ptr, &v_len) == 0 && v_len > 0 {
        let cap_aab26479: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26479, &self.configuredModel, 0);
        self.configuredModel_len = aab_buf_copy( cap_aab26479, 256, v_ptr, v_len);
        self.has_configuredModel = true;
    };
    if sa_json_object_get_string(p, STR_PTR("cwd"), STR_LEN("cwd"), &v_ptr, &v_len) == 0 && v_len > 0 {
        let cap_aab26480: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26480, &self.configuredCwd, 0);
        self.configuredCwd_len = aab_buf_copy( cap_aab26480, 1024, v_ptr, v_len);
        self.has_configuredCwd = true;
    };
}

// configure(params?): keep thread-relay / model
// identity current without touching the child.
fn AuggieAgentBridge_configure(self: &AuggieAgentBridge, params: u64) -> void {
    applyStartConfig(self, params);
}

// terminateAuggieProcessTree(child): Windows taskkill
// via the host shim, else SIGTERM.
fn terminate_process_tree(self: &AuggieAgentBridge) -> void {
    if !self.has_child { return; };
    if host_is_windows() {
        if host_taskkill_tree(self.proc) { return; };
    };
    process_kill(self.proc, 15);
}

// AuggieAgentBridge_start(self, out_err) -> status JSON
// length; out_err 0 ok / 1 error (message in scratch
// status fields, mirroring the source's throw).
// FIX(be2): spawn_bidi_env was called but defined nowhere. Bound to
// the real sa_std faces: argv text is framed as cmd LF args (argv[0]
// is the command), cwd goes through sa_std_process_spawn_bidi_cwd.
// DEFECT(B-class, std gap): sa_std has NO env-carrying spawn face
// (checked process.sai in full, sa_std.h, sdk cliSpawn) — TS passes
// { cwd, env } with AUGMENT_* injected into env; the env text is
// therefore NOT applied and the child inherits the parent
// environment. Registered for the std/host-wiring phase.
fn spawn_bidi_env(cmd_ptr: ptr, cmd_len: u64, args_ptr: ptr, args_len: u64, cwd_ptr: ptr, cwd_len: u64, env_ptr: ptr, env_len: u64, out_proc: &u64, out_hin: &u64, out_hout: &u64, out_herr: &u64, out_err: &i32) -> void {
    let full = [0u8; 9216];
    let full_p: ptr = PTR_NULL(); PTR_BYTE_ADD(full_p, &full, 0);
    let full_len: u64 = 0;
    full_len = full_len + aab_append_bytes(full_p, 9216, full_len, cmd_ptr, cmd_len);
    if args_len > 0 {
        full_len = full_len + aab_append_bytes(full_p, 9216, full_len, STR_PTR("\n"), 1);
        full_len = full_len + aab_append_bytes(full_p, 9216, full_len, args_ptr, args_len);
    };
    let rc: i32 = 0;
    if cwd_len > 0 {
        rc = sa_std_process_spawn_bidi_cwd(full_p, full_len, cwd_ptr, cwd_len, out_proc, out_hin, out_hout, out_herr);
    } else {
        rc = sa_std_process_spawn_bidi(full_p, full_len, out_proc, out_hin, out_hout, out_herr);
    };
    *out_err = rc;
    return;
}

fn AuggieAgentBridge_start(self: &AuggieAgentBridge, out: ptr, out_cap: u64, out_err: &i32) -> u64 {
    *out_err = 0;
    let cap_aab26525: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26525, &self.status_phase, 0);
    if aab_str_is( cap_aab26525, self.status_phase_len, STR_PTR("ready"), STR_LEN("ready")) || aab_str_is(cap_aab26525, self.status_phase_len, STR_PTR("starting"), STR_LEN("starting")) {
        return AuggieAgentBridge_getStatus(self, out, out_cap);
    };
    let bin = [0u8; 1024];
    let bin_p: ptr = PTR_NULL(); PTR_BYTE_ADD(bin_p, &bin, 0);
    let bin_len: u64 = 0;
    let bin_found = false;
    findAuggieBin(host_is_windows(), bin_p, 1024, &bin_len, &bin_found);
    if !bin_found {
        let message = STR_PTR("Auggie backend could not resolve an auggie binary (install @augmentcode/auggie or set AUGGIE_BIN).");
        let message_len = STR_LEN("Auggie backend could not resolve an auggie binary (install @augmentcode/auggie or set AUGGIE_BIN).");
        set_status(self, STR_PTR("error"), STR_LEN("error"), message, message_len, true, 0, false);
        *out_err = 1;
        return AuggieAgentBridge_getStatus(self, out, out_cap);
    };
    // The redirector must be up before we spawn.
    if !self.has_redirector {
        // zero-init the embedded state on first use
        self.redirector.has_config = false;
        self.redirector.has_server = false;
        self.redirector.ledger_count = 0;
        self.redirector.url_len = 0;
        self.has_redirector = true;
    };
    if ensureAuggieRedirector(&self.redirector) != 0 {
        set_status(self, STR_PTR("error"), STR_LEN("error"), STR_PTR("auggie redirector failed to start"), STR_LEN("auggie redirector failed to start"), true, 0, false);
        *out_err = 1;
        return AuggieAgentBridge_getStatus(self, out, out_cap);
    };
    let spawn_env = [0u8; 65536];
    let spawn_env_p: ptr = PTR_NULL(); PTR_BYTE_ADD(spawn_env_p, &spawn_env, 0);
    let cap_aab26531: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26531, &self.env_snapshot, 0);
    let spawn_env_len = inject_env_for(&self.redirector, cap_aab26531, self.env_snapshot_len, spawn_env_p, 65536);
    // Fleet definitions must be on disk before spawn.
    let fleet = [0u8; 262144];
    let fleet_p: ptr = PTR_NULL(); PTR_BYTE_ADD(fleet_p, &fleet, 0);
    let fleet_len = parseAuggieAgentFleetEnv(spawn_env_p, spawn_env_len, fleet_p, 262144);
    let fleet_count: u64 = 0;
    let fleet_doc = sa_json_parse(fleet_p, fleet_len);
    if fleet_doc != 0 { sa_json_value_count(fleet_doc, &fleet_count); };
    if fleet_count > 0 {
        let cache_dir = [0u8; 1024];
        let cache_dir_p: ptr = PTR_NULL(); PTR_BYTE_ADD(cache_dir_p, &cache_dir, 0);
        let cache_dir_len = resolveAuggieCacheDir(spawn_env_p, spawn_env_len, cache_dir_p, 1024);
        let agents_dir = [0u8; 1024];
        let agents_dir_p: ptr = PTR_NULL(); PTR_BYTE_ADD(agents_dir_p, &agents_dir, 0);
        let wf_err: i32 = 0;
        let agents_dir_len = writeAuggieAgentFleet(cache_dir_p, cache_dir_len, fleet_p, fleet_len, agents_dir_p, 1024, &wf_err);
        if wf_err == 0 {
            let note = [0u8; 2048];
            let note_p: ptr = PTR_NULL(); PTR_BYTE_ADD(note_p, &note, 0);
            let note_len: u64 = 0;
            note_len = note_len + aab_append_bytes(note_p, 2048, note_len, STR_PTR("auggie agents fleet written to "), STR_LEN("auggie agents fleet written to "));
            note_len = note_len + aab_append_bytes(note_p, 2048, note_len, agents_dir_p, agents_dir_len);
            note_len = note_len + aab_append_bytes(note_p, 2048, note_len, STR_PTR(" ("), 2);
            note_len = note_len + aab_append_u64(note_p, 2048, note_len, fleet_count);
            note_len = note_len + aab_append_bytes(note_p, 2048, note_len, STR_PTR(" entries)\n"), STR_LEN(" entries)\n"));
            bridge_emit_stderr(self, note_p, note_len);
        } else {
            bridge_emit_stderr(self, STR_PTR("auggie agents fleet sync failed\n"), STR_LEN("auggie agents fleet sync failed\n"));
        };
    };
    // Mark onboarding complete before the child spawns
    // (non-fatal on failure).
    let deny_ptr: ptr = PTR_NULL();
    let deny_len: u64 = 0;
    let has_deny = self.has_configuredCwd;
    if has_deny { let cap_aabD: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aabD, &self.configuredCwd, 0); deny_ptr = cap_aabD; deny_len = self.configuredCwd_len; };
    let home = [0u8; 1024];
    let home_p: ptr = PTR_NULL(); PTR_BYTE_ADD(home_p, &home, 0);
    let home_len: u64 = 0;
    let hp: ptr = PTR_NULL();
    let hl: u64 = 0;
    if env_get(spawn_env_p, spawn_env_len, STR_PTR("HOME"), STR_LEN("HOME"), &hp, &hl) { home_len = aab_buf_copy(home_p, 1024, hp, hl); };
    let ob_err = [0u8; 512];
    let ob_err_p: ptr = PTR_NULL(); PTR_BYTE_ADD(ob_err_p, &ob_err, 0);
    let ob_err_len: u64 = 0;
    if ensureAuggieOnboardingComplete(deny_ptr, deny_len, has_deny, home_p, home_len, ob_err_p, 512, &ob_err_len) != 0 {
        bridge_emit_stderr(self, STR_PTR("auggie onboarding pre-write failed\n"), STR_LEN("auggie onboarding pre-write failed\n"));
    };
    let spawn_cwd = [0u8; 1024];
    let spawn_cwd_p: ptr = PTR_NULL(); PTR_BYTE_ADD(spawn_cwd_p, &spawn_cwd, 0);
    let spawn_cwd_len: u64 = 0;
    if self.has_configuredCwd {
        let cap_aab26553: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26553, &self.configuredCwd, 0);
        spawn_cwd_len = aab_buf_copy(spawn_cwd_p, 1024, cap_aab26553, self.configuredCwd_len);
    } else {
        spawn_cwd_len = process_cwd(spawn_cwd_p, 1024);
    };
    set_status(self, STR_PTR("starting"), STR_LEN("starting"), STR_PTR("Starting auggie --acp"), STR_LEN("Starting auggie --acp"), true, aab_now_ms(), true);
    // argv: [--acp, --model, <model>, --augment-cache-dir,
    // <cacheDir>]; a JS entry runs under Node directly,
    // anything else goes through spawnCli.
    let model_arg = [0u8; 256];
    let model_arg_p: ptr = PTR_NULL(); PTR_BYTE_ADD(model_arg_p, &model_arg, 0);
    let model_arg_len: u64 = 0;
    if self.has_configuredModel {
        let tp: ptr = PTR_NULL();
        let tl: u64 = 0;
        let cap_aab26584: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26584, &self.configuredModel, 0);
        aab_ts_trim_span( cap_aab26584, self.configuredModel_len, &tp, &tl);
        let cap_aab26554: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26554, &self.configuredModel, 0);
        if tl > 0 { model_arg_len = aab_buf_copy(model_arg_p, 256, cap_aab26554, self.configuredModel_len); };
    };
    if model_arg_len == 0 {
        let mp: ptr = PTR_NULL();
        let ml: u64 = 0;
        upstreamModel(&self.redirector, &mp, &ml);
        model_arg_len = aab_buf_copy(model_arg_p, 256, mp, ml);
    };
    let cache_dir2 = [0u8; 1024];
    let cache_dir2_p: ptr = PTR_NULL(); PTR_BYTE_ADD(cache_dir2_p, &cache_dir2, 0);
    let cache_dir2_len = resolveAuggieCacheDir(spawn_env_p, spawn_env_len, cache_dir2_p, 1024);
    let argv = [0u8; 8192];
    let argv_p: ptr = PTR_NULL(); PTR_BYTE_ADD(argv_p, &argv, 0);
    let argv_len: u64 = 0;
    argv_len = argv_len + aab_append_bytes(argv_p, 8192, argv_len, STR_PTR("--acp"), STR_LEN("--acp"));
    argv_len = argv_len + aab_append_bytes(argv_p, 8192, argv_len, STR_PTR("\n--model\n"), STR_LEN("\n--model\n"));
    argv_len = argv_len + aab_append_bytes(argv_p, 8192, argv_len, model_arg_p, model_arg_len);
    argv_len = argv_len + aab_append_bytes(argv_p, 8192, argv_len, STR_PTR("\n--augment-cache-dir\n"), STR_LEN("\n--augment-cache-dir\n"));
    argv_len = argv_len + aab_append_bytes(argv_p, 8192, argv_len, cache_dir2_p, cache_dir2_len);
    let is_js_entry = ends_with_ci(bin_p, bin_len, STR_PTR(".js"), 3) || ends_with_ci(bin_p, bin_len, STR_PTR(".cjs"), 4) || ends_with_ci(bin_p, bin_len, STR_PTR(".mjs"), 4);
    let spawn_err: i32 = 0;
    if is_js_entry {
        let node = [0u8; 1024];
        let node_p: ptr = PTR_NULL(); PTR_BYTE_ADD(node_p, &node, 0);
        let node_len = nodeExecutableForAuggie(spawn_env_p, spawn_env_len, node_p, 1024);
        // argv becomes [bin, --acp, ...]
        let argv2 = [0u8; 9216];
        let argv2_p: ptr = PTR_NULL(); PTR_BYTE_ADD(argv2_p, &argv2, 0);
        let argv2_len: u64 = 0;
        argv2_len = argv2_len + aab_append_bytes(argv2_p, 9216, argv2_len, bin_p, bin_len);
        argv2_len = argv2_len + aab_append_bytes(argv2_p, 9216, argv2_len, STR_PTR("\n"), 1);
        argv2_len = argv2_len + aab_append_bytes(argv2_p, 9216, argv2_len, argv_p, argv_len);
        spawn_bidi_env(node_p, node_len, argv2_p, argv2_len, spawn_cwd_p, spawn_cwd_len, spawn_env_p, spawn_env_len, &self.proc, &self.hin, &self.hout, &self.herr, &spawn_err);
    } else {
        spawn_bidi_env(bin_p, bin_len, argv_p, argv_len, spawn_cwd_p, spawn_cwd_len, spawn_env_p, spawn_env_len, &self.proc, &self.hin, &self.hout, &self.herr, &spawn_err);
    };
    if spawn_err != 0 {
        set_status(self, STR_PTR("error"), STR_LEN("error"), STR_PTR("auggie spawn failed"), STR_LEN("auggie spawn failed"), true, 0, false);
        *out_err = 1;
        return AuggieAgentBridge_getStatus(self, out, out_cap);
    };
    self.has_child = true;
    self.child_exited = false;
    self.line_len = 0;
    // handshake: initialize + protocolVersion check
    let init_text = [0u8; 4096];
    let init_text_p: ptr = PTR_NULL(); PTR_BYTE_ADD(init_text_p, &init_text, 0);
    let init_len: u64 = 0;
    auggieProtocol_buildAuggieInitialize(init_text_p, 4096, &init_len);
    let init_doc = sa_json_parse(init_text_p, init_len);
    let result = [0u8; 262144];
    let result_p: ptr = PTR_NULL(); PTR_BYTE_ADD(result_p, &result, 0);
    let result_len: u64 = 0;
    let req_err = [0u8; 1024];
    let req_err_p: ptr = PTR_NULL(); PTR_BYTE_ADD(req_err_p, &req_err, 0);
    let req_err_len: u64 = 0;
    send_request_sync(self, init_doc, 60000, result_p, 262144, &result_len, req_err_p, 1024, &req_err_len);
    let hs_failed = req_err_len > 0;
    if !hs_failed {
        let result_doc = sa_json_parse(result_p, result_len);
        let record = jsonRecord(result_doc);
        let pv: i64 = 0;
        let pv_ptr: ptr = PTR_NULL();
        let pv_len: u64 = 0;
        let pv_ok = false;
        if aab_json_node_number(record, STR_PTR("protocolVersion"), STR_LEN("protocolVersion"), &pv) { pv_ok = pv == 1; };
        if !pv_ok && sa_json_object_get_string(record, STR_PTR("protocolVersion"), STR_LEN("protocolVersion"), &pv_ptr, &pv_len) == 0 {
            pv_ok = aab_str_is(pv_ptr, pv_len, STR_PTR("1"), 1);
        };
        if !pv_ok { hs_failed = true; };
    };
    if hs_failed {
        set_status(self, STR_PTR("error"), STR_LEN("error"), STR_PTR("auggie handshake failed"), STR_LEN("auggie handshake failed"), true, 0, false);
        terminate_process_tree(self);
        self.has_child = false;
        *out_err = 1;
        return AuggieAgentBridge_getStatus(self, out, out_cap);
    };
    set_status(self, STR_PTR("ready"), STR_LEN("ready"), STR_PTR("auggie --acp ready"), STR_LEN("auggie --acp ready"), true, 0, false);
    return AuggieAgentBridge_getStatus(self, out, out_cap);
}

// AuggieAgentBridge_stop(self)
fn AuggieAgentBridge_stop(self: &AuggieAgentBridge) -> void {
    for i in 0..self.pending_count {
        if self.pending[i].status == 0 {
            self.pending[i].status = 2;
            let cap_aab26481: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26481, &self.pending[i].err, 0);
            self.pending[i].err_len = aab_buf_copy( cap_aab26481, 1024, STR_PTR("auggie backend stopped"), STR_LEN("auggie backend stopped"));
        };
    }
    self.pending_count = 0;
    self.pending_perm_count = 0;
    set_status(self, STR_PTR("stopped"), STR_LEN("stopped"), STR_PTR("Stopped"), STR_LEN("Stopped"), true, 0, false);
    if self.has_child {
        terminate_process_tree(self);
    };
    self.has_child = false;
}

// waitForExit(timeoutMs): poll form — true when the
// child exit has been observed by the pump.
fn AuggieAgentBridge_waitForExit(self: &AuggieAgentBridge, timeout_ms: i64) -> bool {
    let budget = timeout_ms / 50;
    if budget < 1 { budget = 1; };
    let spins: i64 = 0;
    while spins < budget {
        AuggieAgentBridge_pump(self);
        if self.child_exited || !self.has_child { return true; };
        spins = spins + 1;
    }
    return self.child_exited || !self.has_child;
}

// restart()
fn AuggieAgentBridge_restart(self: &AuggieAgentBridge, out: ptr, out_cap: u64, out_err: &i32) -> u64 {
    AuggieAgentBridge_stop(self);
    AuggieAgentBridge_waitForExit(self, 5000);
    return AuggieAgentBridge_start(self, out, out_cap, out_err);
}

// writeStdin(message doc): JSON + "\n" to the child.
// Returns 0 ok / 1 not running / write error.
fn writeStdin(self: &AuggieAgentBridge, doc: u64) -> i32 {
    if !self.has_child { return 1; };
    let text = [0u8; 524288];
    let text_p: ptr = PTR_NULL(); PTR_BYTE_ADD(text_p, &text, 0);
    let text_len = aab_stringify_into(doc, text_p, 524288);
    text_len = text_len + aab_append_bytes(text_p, 524288, text_len, STR_PTR("\n"), 1);
    if sa_io_write_all(self.hin, text_p, text_len) != 0 { return 1; };
    return 0;
}

fn writeStdinText(self: &AuggieAgentBridge, text_ptr: ptr, text_len: u64) -> i32 {
    if !self.has_child { return 1; };
    let buf = [0u8; 524288];
    let buf_p: ptr = PTR_NULL(); PTR_BYTE_ADD(buf_p, &buf, 0);
    let n = aab_buf_copy(buf_p, 524288, text_ptr, text_len);
    n = n + aab_append_bytes(buf_p, 524288, n, STR_PTR("\n"), 1);
    if sa_io_write_all(self.hin, buf_p, n) != 0 { return 1; };
    return 0;
}

// sendRequest(message doc without id): register a
// pending slot and write the frame {jsonrpc, id, ...}.
// Returns the numeric id (0 = not running).
fn send_request_register(self: &AuggieAgentBridge, message: u64, timeout_ms: i64) -> u64 {
    if !self.has_child { return 0; };
    if self.pending_count >= 64 { return 0; };
    let id = self.next_request_id;
    self.next_request_id = self.next_request_id + 1;
    // frame = message fields + jsonrpc/id
    let frame = aab_json_object_new();
    let method_ptr: ptr = PTR_NULL();
    let method_len: u64 = 0;
    sa_json_object_get_string(message, STR_PTR("method"), STR_LEN("method"), &method_ptr, &method_len);
    if method_len > 0 { aab_sa_json_object_set_string(frame, STR_PTR("method"), STR_LEN("method"), method_ptr, method_len); };
    let params: u64 = 0;
    if sa_json_object_get(message, STR_PTR("params"), STR_LEN("params"), &params) == 0 && params != 0 {
        sa_json_object_set_node(frame, STR_PTR("params"), STR_LEN("params"), params);
    };
    aab_sa_json_object_set_string(frame, STR_PTR("jsonrpc"), STR_LEN("jsonrpc"), STR_PTR("2.0"), STR_LEN("2.0"));
    aab_sa_json_object_set_number(frame, STR_PTR("id"), STR_LEN("id"), id as i64);
    let slot = self.pending_count;
    let cap_aab26643: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26643, &self.pending[slot].id_str, 0);
    self.pending[slot].id_str_len = aab_append_u64( cap_aab26643, 32, 0, id);
    let cap_aab26482: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26482, &self.pending[slot].method, 0);
    self.pending[slot].method_len = aab_buf_copy( cap_aab26482, 128, method_ptr, method_len);
    self.pending[slot].status = 0;
    self.pending[slot].result_len = 0;
    self.pending[slot].err_len = 0;
    self.pending[slot].deadline_ms = if timeout_ms > 0 { aab_now_ms() + timeout_ms } else { 0 };
    self.pending_count = self.pending_count + 1;
    if writeStdin(self, frame) != 0 {
        self.pending[slot].status = 2;
        let cap_aab26483: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26483, &self.pending[slot].err, 0);
        self.pending[slot].err_len = aab_buf_copy( cap_aab26483, 1024, STR_PTR("auggie backend is not running"), STR_LEN("auggie backend is not running"));
        return 0;
    };
    return id;
}

// send_request_sync: register + pump until the slot
// resolves/rejects or the iteration budget (derived
// from timeoutMs) expires — the conversion form of the
// source's awaited sendRequest.
fn send_request_sync(self: &AuggieAgentBridge, message: u64, timeout_ms: i64, out_result: ptr, out_cap: u64, out_result_len: &u64, out_err: ptr, out_err_cap: u64, out_err_len: &u64) -> void {
    *out_result_len = 0;
    *out_err_len = 0;
    if !self.has_child {
        *out_err_len = aab_buf_copy(out_err, out_err_cap, STR_PTR("auggie backend is not running"), STR_LEN("auggie backend is not running"));
        return;
    };
    let id = send_request_register(self, message, timeout_ms);
    if id == 0 {
        *out_err_len = aab_buf_copy(out_err, out_err_cap, STR_PTR("auggie request could not be sent"), STR_LEN("auggie request could not be sent"));
        return;
    };
    let budget = timeout_ms / 10;
    if budget < 100 { budget = 100; };
    let spins: i64 = 0;
    while spins < budget {
        AuggieAgentBridge_pump(self);
        // locate the slot by id string
        let id_str = [0u8; 32];
        let id_str_p: ptr = PTR_NULL(); PTR_BYTE_ADD(id_str_p, &id_str, 0);
        let id_str_len = aab_append_u64(id_str_p, 32, 0, id);
        let found = false;
        for i in 0..self.pending_count {
            let cap_aab26193: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26193, &self.pending[i].id_str, 0);
            if self.pending[i].id_str_len == id_str_len && aab_bytes_eq( cap_aab26193, id_str_p, id_str_len) {
                found = true;
                if self.pending[i].status == 1 {
                    let cap_aab26167: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26167, &self.pending_arena, 0);
                    *out_result_len = aab_buf_copy(out_result, out_cap, aab_byte_off( cap_aab26167, self.pending[i].result_off), self.pending[i].result_len);
                    pending_remove(self, i);
                    return;
                };
                if self.pending[i].status == 2 {
                    let cap_aab26555: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26555, &self.pending[i].err, 0);
                    *out_err_len = aab_buf_copy(out_err, out_err_cap, cap_aab26555, self.pending[i].err_len);
                    pending_remove(self, i);
                    return;
                };
                break;
            };
        }
        if !found {
            *out_err_len = aab_buf_copy(out_err, out_err_cap, STR_PTR("auggie request settled elsewhere"), STR_LEN("auggie request settled elsewhere"));
            return;
        };
        spins = spins + 1;
    }
    // timeout: drop the slot, report like the source
    let id_str2 = [0u8; 32];
    let id_str2_p: ptr = PTR_NULL(); PTR_BYTE_ADD(id_str2_p, &id_str2, 0);
    let id_str2_len = aab_append_u64(id_str2_p, 32, 0, id);
    for i in 0..self.pending_count {
        let cap_aab26194: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26194, &self.pending[i].id_str, 0);
        if self.pending[i].id_str_len == id_str2_len && aab_bytes_eq( cap_aab26194, id_str2_p, id_str2_len) {
            let method = [0u8; 128];
            let method_p: ptr = PTR_NULL(); PTR_BYTE_ADD(method_p, &method, 0);
            let cap_aab26556: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26556, &self.pending[i].method, 0);
            let method_len = aab_buf_copy(method_p, 128, cap_aab26556, self.pending[i].method_len);
            pending_remove(self, i);
            let msg = [0u8; 512];
            let msg_p: ptr = PTR_NULL(); PTR_BYTE_ADD(msg_p, &msg, 0);
            let msg_len: u64 = 0;
            msg_len = msg_len + aab_append_bytes(msg_p, 512, msg_len, STR_PTR("auggie request '"), STR_LEN("auggie request '"));
            msg_len = msg_len + aab_append_bytes(msg_p, 512, msg_len, method_p, method_len);
            msg_len = msg_len + aab_append_bytes(msg_p, 512, msg_len, STR_PTR("' timed out"), STR_LEN("' timed out"));
            *out_err_len = aab_buf_copy(out_err, out_err_cap, msg_p, msg_len);
            return;
        };
    }
}

fn pending_remove(self: &AuggieAgentBridge, idx: u64) -> void {
    for i in idx + 1..self.pending_count {
        self.pending[i - 1] = self.pending[i];
    }
    if self.pending_count > 0 { self.pending_count = self.pending_count - 1; };
}

// AuggieAgentBridge_pump: drain child stdout into
// lines -> handleLine; drain stderr (redacted) into
// the queue; observe exit -> invalidateChild.
fn AuggieAgentBridge_pump(self: &AuggieAgentBridge) -> void {
    if self.has_child {
        let chunk = [0u8; 65536];
        let chunk_p: ptr = PTR_NULL(); PTR_BYTE_ADD(chunk_p, &chunk, 0);
        let n: u64 = 0;
        if sa_io_read(self.hout, chunk_p, 65536, &n) == 0 && n > 0 {
            let pos: u64 = 0;
            while pos < n {
                let nl = aab_find_byte(chunk_p, n, pos, 10);
                let take_end = if nl == 4294967295 { n } else { nl };
                let cap_ab15: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ab15, &self.line_buf, 0);
                self.line_len = self.line_len + aab_append_bytes(cap_ab15, 262144, self.line_len, aab_byte_off(chunk_p, pos), take_end - pos);
                if nl == 4294967295 {
                    pos = n;
                } else {
                    let cap_aab26645: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26645, &self.line_buf, 0);
                    handleLine(self, cap_aab26645, self.line_len);
                    self.line_len = 0;
                    pos = nl + 1;
                };
            }
        };
        let e_chunk = [0u8; 16384];
        let e_chunk_p: ptr = PTR_NULL(); PTR_BYTE_ADD(e_chunk_p, &e_chunk, 0);
        let e_n: u64 = 0;
        if sa_io_read(self.herr, e_chunk_p, 16384, &e_n) == 0 && e_n > 0 {
            let tp: ptr = PTR_NULL();
            let tl: u64 = 0;
            aab_ts_trim_span(e_chunk_p, e_n, &tp, &tl);
            if tl > 0 {
                let redacted = [0u8; 16384];
                let redacted_p: ptr = PTR_NULL(); PTR_BYTE_ADD(redacted_p, &redacted, 0);
                let redacted_len = redactSecrets(tp, tl, redacted_p, 16384);
                bridge_emit_stderr(self, redacted_p, redacted_len);
            };
        };
        let code: i32 = 0;
        if process_poll_exit(self.proc, &code) {
            self.child_exited = true;
            let msg = [0u8; 256];
            let msg_p: ptr = PTR_NULL(); PTR_BYTE_ADD(msg_p, &msg, 0);
            let msg_len: u64 = 0;
            msg_len = msg_len + aab_append_bytes(msg_p, 256, msg_len, STR_PTR("auggie exited with code "), STR_LEN("auggie exited with code "));
            msg_len = msg_len + aab_append_i64(msg_p, 256, msg_len, code as i64);
            invalidateChild(self, msg_p, msg_len);
        };
    };
    // silence/stall deadlines across sessions
    for si in 0..self.session_count {
        poll_session_silence(self, si);
    }
}

// handleLine(line): inbound NDJSON frame dispatch.
fn handleLine(self: &AuggieAgentBridge, line_ptr: ptr, line_len: u64) -> void {
    let tp: ptr = PTR_NULL();
    let tl: u64 = 0;
    aab_ts_trim_span(line_ptr, line_len, &tp, &tl);
    if tl == 0 { return; };
    let event = sa_json_parse(tp, tl);
    if event == 0 {
        let note = [0u8; 262144];
        let note_p: ptr = PTR_NULL(); PTR_BYTE_ADD(note_p, &note, 0);
        let note_len: u64 = 0;
        note_len = note_len + aab_append_bytes(note_p, 262144, note_len, STR_PTR("Unparseable auggie stdout: "), STR_LEN("Unparseable auggie stdout: "));
        let redacted = [0u8; 262144];
        let redacted_p: ptr = PTR_NULL(); PTR_BYTE_ADD(redacted_p, &redacted, 0);
        let redacted_len = redactSecrets(line_ptr, line_len, redacted_p, 262144);
        note_len = note_len + aab_append_bytes(note_p, 262144, note_len, redacted_p, redacted_len);
        bridge_emit_stderr(self, note_p, note_len);
        return;
    };
    let raw_text = [0u8; 262144];
    let raw_text_p: ptr = PTR_NULL(); PTR_BYTE_ADD(raw_text_p, &raw_text, 0);
    let raw_len = aab_stringify_into(event, raw_text_p, 262144);
    bridge_emit(self, STR_PTR("auggie:raw"), STR_LEN("auggie:raw"), raw_text_p, raw_len);
    // diagnostic frame log
    let update_ok = false;
    asSessionUpdate(event, true, &update_ok);
    if update_ok {
        let kind_ptr: ptr = PTR_NULL();
        let kind_len: u64 = 0;
        sessionUpdate_kind(event, &kind_ptr, &kind_len);
        let log_doc = aab_json_object_new();
        aab_sa_json_object_set_string(log_doc, STR_PTR("kind"), STR_LEN("kind"), STR_PTR("frame"), STR_LEN("frame"));
        aab_sa_json_object_set_string(log_doc, STR_PTR("frame"), STR_LEN("frame"), kind_ptr, kind_len);
        let sid_ptr: ptr = PTR_NULL();
        let sid_len: u64 = 0;
        let params: u64 = 0;
        sa_json_object_get(event, STR_PTR("params"), STR_LEN("params"), &params);
        if params != 0 { sa_json_object_get_string(params, STR_PTR("sessionId"), STR_LEN("sessionId"), &sid_ptr, &sid_len); };
        aab_sa_json_object_set_string(log_doc, STR_PTR("sessionId"), STR_LEN("sessionId"), sid_ptr, sid_len);
        if aab_str_is(kind_ptr, kind_len, AUGGIE_SESSION_UPDATE_AGENT_MESSAGE_CHUNK_ptr(), AUGGIE_SESSION_UPDATE_AGENT_MESSAGE_CHUNK_len()) {let _ifd1 = 
            aab_sa_json_object_set_number(log_doc, STR_PTR("textLen"), STR_LEN("textLen"), update_content_text_len(event));
        } else {
            let upd: u64 = 0;
            if params != 0 { sa_json_object_get(params, STR_PTR("update"), STR_LEN("update"), &upd); };
            if upd != 0 { sa_json_object_set_node(log_doc, STR_PTR("update"), STR_LEN("update"), upd); };
        };
        event_log_append(self, log_doc);
    } else {
        let log_doc = aab_json_object_new();
        aab_sa_json_object_set_string(log_doc, STR_PTR("kind"), STR_LEN("kind"), STR_PTR("frame"), STR_LEN("frame"));
        let m_ptr: ptr = PTR_NULL();
        let m_len: u64 = 0;
        if sa_json_object_get_string(event, STR_PTR("method"), STR_LEN("method"), &m_ptr, &m_len) == 0 && m_len > 0 {
            aab_sa_json_object_set_string(log_doc, STR_PTR("frame"), STR_LEN("frame"), m_ptr, m_len);
        } else if has_field(event, STR_PTR("id"), STR_LEN("id")) {
            aab_sa_json_object_set_string(log_doc, STR_PTR("frame"), STR_LEN("frame"), STR_PTR("result"), STR_LEN("result"));
        } else {
            aab_sa_json_object_set_string(log_doc, STR_PTR("frame"), STR_LEN("frame"), STR_PTR("unknown"), STR_LEN("unknown"));
        };
        event_log_append(self, log_doc);
    };
    // JSON-RPC result for a request we sent
    let has_id = has_field(event, STR_PTR("id"), STR_LEN("id"));
    let has_method = has_field(event, STR_PTR("method"), STR_LEN("method"));
    if has_id && !has_method {
        let id_json = [0u8; 64];
        let id_json_p: ptr = PTR_NULL(); PTR_BYTE_ADD(id_json_p, &id_json, 0);
        let id_json_len = event_id_json(event, id_json_p, 64);
        for i in 0..self.pending_count {
            let cap_aab26195: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26195, &self.pending[i].id_str, 0);
            if self.pending[i].id_str_len == id_json_len && aab_bytes_eq( cap_aab26195, id_json_p, id_json_len) && self.pending[i].status == 0 {
                let err: u64 = 0;
                if sa_json_object_get(event, STR_PTR("error"), STR_LEN("error"), &err) == 0 && err != 0 {
                    let em_ptr: ptr = PTR_NULL();
                    let em_len: u64 = 0;
                    if sa_json_object_get_string(err, STR_PTR("message"), STR_LEN("message"), &em_ptr, &em_len) != 0 {
                        em_ptr = STR_PTR("auggie request error");
                        em_len = STR_LEN("auggie request error");
                    };
                    self.pending[i].status = 2;
                    let cap_aab26484: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26484, &self.pending[i].err, 0);
                    self.pending[i].err_len = aab_buf_copy( cap_aab26484, 1024, em_ptr, em_len);
                    // a rejected session/prompt fails its
                    // turn (the source's .catch route)
                    for pi in 0..self.pending_prompt_count {
                        let cap_aab26196: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26196, &self.pending_prompts[pi].id_str, 0);
                        if self.pending_prompts[pi].id_str_len == id_json_len && aab_bytes_eq( cap_aab26196, id_json_p, id_json_len) {
                            let tid = [0u8; 128];
                            let tid_p: ptr = PTR_NULL(); PTR_BYTE_ADD(tid_p, &tid, 0);
                            let cap_aab26557: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26557, &self.pending_prompts[pi].threadId, 0);
                            let tid_len = aab_buf_copy(tid_p, 128, cap_aab26557, self.pending_prompts[pi].threadId_len);
                            let tuid = [0u8; 128];
                            let tuid_p: ptr = PTR_NULL(); PTR_BYTE_ADD(tuid_p, &tuid, 0);
                            let cap_aab26558: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26558, &self.pending_prompts[pi].turnId, 0);
                            let tuid_len = aab_buf_copy(tuid_p, 128, cap_aab26558, self.pending_prompts[pi].turnId_len);
                            let emsg = [0u8; 1024];
                            let emsg_p: ptr = PTR_NULL(); PTR_BYTE_ADD(emsg_p, &emsg, 0);
                            let emsg_len = aab_buf_copy(emsg_p, 1024, em_ptr, em_len);
                            pending_prompt_remove(self, pi);
                            handleAuggiePromptError(self, tid_p, tid_len, tuid_p, tuid_len, emsg_p, emsg_len);
                            break;
                        };
                    }
                } else {
                    let result_doc: u64 = 0;
                    if sa_json_object_get(event, STR_PTR("result"), STR_LEN("result"), &result_doc) != 0 || result_doc == 0 {
                        result_doc = aab_json_object_new();
                    };
                    let rtext = [0u8; 262144];
                    let rtext_p: ptr = PTR_NULL(); PTR_BYTE_ADD(rtext_p, &rtext, 0);
                    let rtext_len = aab_stringify_into(result_doc, rtext_p, 262144);
                    self.pending[i].status = 1;
                    self.pending[i].result_off = self.pending_used;
                    self.pending[i].result_len = rtext_len;
                    let cap_ab16: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ab16, &self.pending_arena, 0);
                    self.pending_used = self.pending_used + aab_append_bytes(cap_ab16, 524288, self.pending_used, rtext_p, rtext_len);
                    // deferred session/prompt completion
                    for pi in 0..self.pending_prompt_count {
                        let cap_aab26197: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26197, &self.pending_prompts[pi].id_str, 0);
                        if self.pending_prompts[pi].id_str_len == id_json_len && aab_bytes_eq( cap_aab26197, id_json_p, id_json_len) {
                            let tid = [0u8; 128];
                            let tid_p: ptr = PTR_NULL(); PTR_BYTE_ADD(tid_p, &tid, 0);
                            let cap_aab26559: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26559, &self.pending_prompts[pi].threadId, 0);
                            let tid_len = aab_buf_copy(tid_p, 128, cap_aab26559, self.pending_prompts[pi].threadId_len);
                            let tuid = [0u8; 128];
                            let tuid_p: ptr = PTR_NULL(); PTR_BYTE_ADD(tuid_p, &tuid, 0);
                            let cap_aab26560: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26560, &self.pending_prompts[pi].turnId, 0);
                            let tuid_len = aab_buf_copy(tuid_p, 128, cap_aab26560, self.pending_prompts[pi].turnId_len);
                            pending_prompt_remove(self, pi);
                            handleAuggiePromptResult(self, tid_p, tid_len, tuid_p, tuid_len, result_doc);
                            break;
                        };
                    }
                };
                return;
            };
        }
        return;
    };
    if update_ok {
        handleSessionUpdate(self, event);
        return;
    };
    let perm_ok = false;
    asRequestPermission(event, true, &perm_ok);
    if perm_ok {
        handleRequestPermission(self, event);
        return;
    };
    // host-capability requests: log-only / reject
    if has_method && has_id {
        let m_ptr: ptr = PTR_NULL();
        let m_len: u64 = 0;
        sa_json_object_get_string(event, STR_PTR("method"), STR_LEN("method"), &m_ptr, &m_len);
        if !aab_str_is(m_ptr, m_len, AUGGIE_METHOD_sessionRequestPermission(), STR_LEN("session/request_permission")) {
            let note = [0u8; 1024];
            let note_p: ptr = PTR_NULL(); PTR_BYTE_ADD(note_p, &note, 0);
            let note_len: u64 = 0;
            note_len = note_len + aab_append_bytes(note_p, 1024, note_len, STR_PTR("auggie host-capability request '"), STR_LEN("auggie host-capability request '"));
            note_len = note_len + aab_append_bytes(note_p, 1024, note_len, m_ptr, m_len);
            note_len = note_len + aab_append_bytes(note_p, 1024, note_len, STR_PTR("' received; rejecting (not implemented in this task)\n"), STR_LEN("' received; rejecting (not implemented in this task)\n"));
            bridge_emit_stderr(self, note_p, note_len);
            let id_json = [0u8; 64];
            let id_json_p: ptr = PTR_NULL(); PTR_BYTE_ADD(id_json_p, &id_json, 0);
            let id_json_len = event_id_json(event, id_json_p, 64);
            let reply = [0u8; 1024];
            let reply_p: ptr = PTR_NULL(); PTR_BYTE_ADD(reply_p, &reply, 0);
            let reply_len: u64 = 0;
            reply_len = reply_len + aab_append_bytes(reply_p, 1024, reply_len, STR_PTR("{\"jsonrpc\":\"2.0\",\"id\":"), STR_LEN("{\"jsonrpc\":\"2.0\",\"id\":"));
            reply_len = reply_len + aab_append_bytes(reply_p, 1024, reply_len, id_json_p, id_json_len);
            reply_len = reply_len + aab_append_bytes(reply_p, 1024, reply_len, STR_PTR(",\"error\":{\"code\":-32601,\"message\":\"host capability '"), STR_LEN(",\"error\":{\"code\":-32601,\"message\":\"host capability '"));
            reply_len = reply_len + aab_append_bytes(reply_p, 1024, reply_len, m_ptr, m_len);
            reply_len = reply_len + aab_append_bytes(reply_p, 1024, reply_len, STR_PTR("' not implemented\"}}"), STR_LEN("' not implemented\"}}"));
            writeStdinText(self, reply_p, reply_len);
        };
    };
}

fn pending_prompt_remove(self: &AuggieAgentBridge, idx: u64) -> void {
    for i in idx + 1..self.pending_prompt_count {
        self.pending_prompts[i - 1] = self.pending_prompts[i];
    }
    if self.pending_prompt_count > 0 { self.pending_prompt_count = self.pending_prompt_count - 1; };
}

// event_id_json: the frame's id as canonical JSON text
// (numbers bare, strings quoted) for pending matching.
fn event_id_json(event: u64, out: ptr, out_cap: u64) -> u64 {
    let id_node: u64 = 0;
    if sa_json_object_get(event, STR_PTR("id"), STR_LEN("id"), &id_node) != 0 || id_node == 0 { return 0; };
    return aab_stringify_into(id_node, out, out_cap);
}

fn has_field(doc: u64, key_ptr: ptr, key_len: u64) -> bool {
    let v: u64 = 0;
    return doc != 0 && sa_json_object_get(doc, key_ptr, key_len, &v) == 0;
}

// update_content_text_len: content.text length of a
// session/update event (diagnostic log only).
fn update_content_text_len(event: u64) -> i64 {
    let params: u64 = 0;
    let update: u64 = 0;
    let content: u64 = 0;
    if sa_json_object_get(event, STR_PTR("params"), STR_LEN("params"), &params) != 0 { return 0; };
    if sa_json_object_get(params, STR_PTR("update"), STR_LEN("update"), &update) != 0 { return 0; };
    if sa_json_object_get(update, STR_PTR("content"), STR_LEN("content"), &content) != 0 || content == 0 { return 0; };
    let t_ptr: ptr = PTR_NULL();
    let t_len: u64 = 0;
    if sa_json_object_get_string(content, STR_PTR("text"), STR_LEN("text"), &t_ptr, &t_len) == 0 { return t_len as i64; };
    return 0;
}

// respond(id, result?, error?): reply to an
// item/*requestApproval the frontend answered.
fn AuggieAgentBridge_respond(self: &AuggieAgentBridge, routed_id_ptr: ptr, routed_id_len: u64, result: u64, has_error: bool) -> void {
    let idx: u64 = 4294967295;
    for i in 0..self.pending_perm_count {
        let cap_aab26198: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26198, &self.pending_perms[i].routedId, 0);
        if self.pending_perms[i].routedId_len == routed_id_len && aab_bytes_eq( cap_aab26198, routed_id_ptr, routed_id_len) {
            idx = i;
            break;
        };
    }
    if idx == 4294967295 { return; };
    let acp_id = [0u8; 64];
    let acp_id_p: ptr = PTR_NULL(); PTR_BYTE_ADD(acp_id_p, &acp_id, 0);
    let cap_aab26561: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26561, &self.pending_perms[idx].acpId_json, 0);
    let acp_id_len = aab_buf_copy(acp_id_p, 64, cap_aab26561, self.pending_perms[idx].acpId_json_len);
    // remove the entry
    for i in idx + 1..self.pending_perm_count {
        self.pending_perms[i - 1] = self.pending_perms[i];
    }
    self.pending_perm_count = self.pending_perm_count - 1;
    let frame = [0u8; 1024];
    let frame_p: ptr = PTR_NULL(); PTR_BYTE_ADD(frame_p, &frame, 0);
    let frame_len: u64 = 0;
    if has_error {
        let outcome = AuggiePermissionOutcome { selected: false, optionId_ptr: PTR_NULL(), optionId_len: 0 };
        auggieProtocol_buildAuggiePermissionResult(acp_id_p, acp_id_len, &outcome, frame_p, 1024, &frame_len);
        writeStdinText(self, frame_p, frame_len);
        return;
    };
    let record = jsonRecord(result);
    let outcome_rec = jsonRecord(field_or_zero(record, STR_PTR("outcome"), STR_LEN("outcome")));
    let option_ptr: ptr = PTR_NULL();
    let option_len: u64 = 0;
    let has_option = false;
    if sa_json_object_get_string(record, STR_PTR("optionId"), STR_LEN("optionId"), &option_ptr, &option_len) == 0 && option_len > 0 {
        has_option = true;
    } else if sa_json_object_get_string(outcome_rec, STR_PTR("optionId"), STR_LEN("optionId"), &option_ptr, &option_len) == 0 && option_len > 0 {
        has_option = true;
    };
    if has_option {
        let outcome = AuggiePermissionOutcome { selected: true, optionId_ptr: option_ptr, optionId_len: option_len };
        auggieProtocol_buildAuggiePermissionResult(acp_id_p, acp_id_len, &outcome, frame_p, 1024, &frame_len);
    } else {
        let outcome = AuggiePermissionOutcome { selected: false, optionId_ptr: PTR_NULL(), optionId_len: 0 };
        auggieProtocol_buildAuggiePermissionResult(acp_id_p, acp_id_len, &outcome, frame_p, 1024, &frame_len);
    };
    writeStdinText(self, frame_p, frame_len);
}

fn field_or_zero(doc: u64, key_ptr: ptr, key_len: u64) -> u64 {
    let v: u64 = 0;
    if doc != 0 && sa_json_object_get(doc, key_ptr, key_len, &v) == 0 { return v; };
    return 0;
}

// request(method, params, timeoutMs): the routing
// entry. Returns result JSON text; out_err != 0 on
// throw (message in the error out-params).
fn AuggieAgentBridge_request(self: &AuggieAgentBridge, method_ptr: ptr, method_len: u64, params: u64, timeout_ms: i64, out: ptr, out_cap: u64, out_len: &u64, out_err: ptr, out_err_cap: u64, out_err_len: &u64) -> void {
    *out_len = 0;
    *out_err_len = 0;
    if aab_str_is(method_ptr, method_len, STR_PTR("thread/fork"), STR_LEN("thread/fork")) {
        *out_err_len = aab_buf_copy(out_err, out_err_cap, STR_PTR("Auggie backend does not support thread/fork"), STR_LEN("Auggie backend does not support thread/fork"));
        return;
    };
    if !self.has_child {
        if aab_str_is(method_ptr, method_len, STR_PTR("turn/interrupt"), STR_LEN("turn/interrupt")) {
            handle_method(self, method_ptr, method_len, params, out, out_cap, out_len, out_err, out_err_cap, out_err_len);
            return;
        };
        if !augNeedsRunningProcess(method_ptr, method_len) {
            handle_method(self, method_ptr, method_len, params, out, out_cap, out_len, out_err, out_err_cap, out_err_len);
            return;
        };
        if aab_str_is(method_ptr, method_len, STR_PTR("thread/start"), STR_LEN("thread/start")) {
            applyStartConfig(self, params);
        };
        let status_buf = [0u8; 2048];
        let status_buf_p: ptr = PTR_NULL(); PTR_BYTE_ADD(status_buf_p, &status_buf, 0);
        let start_err: i32 = 0;
        AuggieAgentBridge_start(self, status_buf_p, 2048, &start_err);
        if start_err != 0 {
            *out_err_len = aab_buf_copy(out_err, out_err_cap, STR_PTR("auggie backend failed to start"), STR_LEN("auggie backend failed to start"));
            return;
        };
    };
    if !self.has_child && augNeedsRunningProcess(method_ptr, method_len) {
        *out_err_len = aab_buf_copy(out_err, out_err_cap, STR_PTR("auggie backend is not running"), STR_LEN("auggie backend is not running"));
        return;
    };
    handle_method(self, method_ptr, method_len, params, out, out_cap, out_len, out_err, out_err_cap, out_err_len);
}

// notify(method, params)
fn AuggieAgentBridge_notify(self: &AuggieAgentBridge, method_ptr: ptr, method_len: u64, params: u64) -> void {
    let out = [0u8; 4096];
    let out_p: ptr = PTR_NULL(); PTR_BYTE_ADD(out_p, &out, 0);
    let out_len: u64 = 0;
    let err = [0u8; 1024];
    let err_p: ptr = PTR_NULL(); PTR_BYTE_ADD(err_p, &err, 0);
    let err_len: u64 = 0;
    handle_method(self, method_ptr, method_len, params, out_p, 4096, &out_len, err_p, 1024, &err_len);
}

// applyRuntimeConfig(params?)
fn AuggieAgentBridge_applyRuntimeConfig(self: &AuggieAgentBridge, params: u64) -> void {
    let prev_model = [0u8; 256];
    let prev_model_p: ptr = PTR_NULL(); PTR_BYTE_ADD(prev_model_p, &prev_model, 0);
    let prev_model_len: u64 = 0;
    let had_prev = self.has_configuredModel;
    let cap_aab26562: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26562, &self.configuredModel, 0);
    if had_prev { prev_model_len = aab_buf_copy(prev_model_p, 256, cap_aab26562, self.configuredModel_len); };
    applyStartConfig(self, params);
    if !self.has_configuredThreadId || !self.has_configuredModel { return; };
    let cap_aab26730: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26730, &self.configuredModel, 0);
    if had_prev && prev_model_len == self.configuredModel_len && aab_bytes_eq(prev_model_p, cap_aab26730, prev_model_len) { return; };
    let cap_aab26732: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26732, &self.configuredThreadId, 0);
    let si = find_session(self, cap_aab26732, self.configuredThreadId_len);
    if si == 4294967295 { return; };
    let cap_aab26733: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26733, &self.configuredModel, 0);
    set_session_model(self, si, cap_aab26733, self.configuredModel_len);
}

// setSessionModel(session, modelId): best-effort
// session/set_model; failures are logged, never fail
// the turn.
fn set_session_model(self: &AuggieAgentBridge, si: u64, model_ptr: ptr, model_len: u64) -> void {
    let cap_aab26485: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26485, &self.sessions[si].model, 0);
    self.sessions[si].model_len = aab_buf_copy( cap_aab26485, 256, model_ptr, model_len);
    self.sessions[si].has_model = true;
    if !self.sessions[si].has_externalSessionId || !self.has_child { return; };
    let message = aab_json_object_new();
    aab_sa_json_object_set_string(message, STR_PTR("method"), STR_LEN("method"), AUGGIE_METHOD_sessionSetModel(), STR_LEN("session/set_model"));
    let params = aab_json_object_new();
    let cap_aab26734: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26734, &self.sessions[si].externalSessionId, 0);
    aab_sa_json_object_set_string(params, STR_PTR("sessionId"), STR_LEN("sessionId"), cap_aab26734, self.sessions[si].externalSessionId_len);
    aab_sa_json_object_set_string(params, STR_PTR("modelId"), STR_LEN("modelId"), model_ptr, model_len);
    sa_json_object_set_node(message, STR_PTR("params"), STR_LEN("params"), params);
    let result = [0u8; 4096];
    let result_p: ptr = PTR_NULL(); PTR_BYTE_ADD(result_p, &result, 0);
    let result_len: u64 = 0;
    let err = [0u8; 1024];
    let err_p: ptr = PTR_NULL(); PTR_BYTE_ADD(err_p, &err, 0);
    let err_len: u64 = 0;
    send_request_sync(self, message, 60000, result_p, 4096, &result_len, err_p, 1024, &err_len);
    if err_len > 0 {
        let note = [0u8; 2048];
        let note_p: ptr = PTR_NULL(); PTR_BYTE_ADD(note_p, &note, 0);
        let note_len: u64 = 0;
        note_len = note_len + aab_append_bytes(note_p, 2048, note_len, STR_PTR("auggie session/set_model '"), STR_LEN("auggie session/set_model '"));
        note_len = note_len + aab_append_bytes(note_p, 2048, note_len, model_ptr, model_len);
        note_len = note_len + aab_append_bytes(note_p, 2048, note_len, STR_PTR("' failed: "), STR_LEN("' failed: "));
        note_len = note_len + aab_append_bytes(note_p, 2048, note_len, err_p, err_len);
        note_len = note_len + aab_append_bytes(note_p, 2048, note_len, STR_PTR("\n"), 1);
        bridge_emit_stderr(self, note_p, note_len);
    };
}

fn find_session(self: &AuggieAgentBridge, threadId_ptr: ptr, threadId_len: u64) -> u64 {
    for i in 0..self.session_count {
        if session_find(&self.sessions[i], threadId_ptr, threadId_len) { return i; };
    }
    return 4294967295;
}

fn find_session_by_acp(self: &AuggieAgentBridge, sessionId_ptr: ptr, sessionId_len: u64, out_thread: ptr, out_thread_len: &u64) -> u64 {
    *out_thread_len = 0;
    for i in 0..self.map_count {
        let cap_aab26168: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26168, &self.map_session, 0);
        if self.map_session_len[i] == sessionId_len && aab_bytes_eq(aab_byte_off( cap_aab26168, self.map_session_off[i]), sessionId_ptr, sessionId_len) {
            let cap_aab26169: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26169, &self.map_thread, 0);
            *out_thread_len = aab_buf_copy(out_thread, 128, aab_byte_off( cap_aab26169, self.map_thread_off[i]), self.map_thread_len[i]);
            return find_session(self, out_thread, *out_thread_len);
        };
    }
    return 4294967295;
}

fn map_session(self: &AuggieAgentBridge, sessionId_ptr: ptr, sessionId_len: u64, threadId_ptr: ptr, threadId_len: u64) -> void {
    for i in 0..self.map_count {
        let cap_aab26170: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26170, &self.map_session, 0);
        if self.map_session_len[i] == sessionId_len && aab_bytes_eq(aab_byte_off( cap_aab26170, self.map_session_off[i]), sessionId_ptr, sessionId_len) {
            self.map_thread_off[i] = self.map_thread_used;
            self.map_thread_len[i] = threadId_len;
            let cap_ab17: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ab17, &self.map_thread, 0);
            self.map_thread_used = self.map_thread_used + aab_append_bytes(cap_ab17, 4096, self.map_thread_used, threadId_ptr, threadId_len);
            return;
        };
    }
    if self.map_count >= 32 { return; };
    let i = self.map_count;
    self.map_session_off[i] = self.map_session_used;
    self.map_session_len[i] = sessionId_len;
    let cap_ab18: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ab18, &self.map_session, 0);
    self.map_session_used = self.map_session_used + aab_append_bytes(cap_ab18, 4096, self.map_session_used, sessionId_ptr, sessionId_len);
    self.map_thread_off[i] = self.map_thread_used;
    self.map_thread_len[i] = threadId_len;
    let cap_ab19: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ab19, &self.map_thread, 0);
    self.map_thread_used = self.map_thread_used + aab_append_bytes(cap_ab19, 4096, self.map_thread_used, threadId_ptr, threadId_len);
    self.map_count = self.map_count + 1;
}

fn unmap_thread(self: &AuggieAgentBridge, threadId_ptr: ptr, threadId_len: u64) -> void {
    let kept: u64 = 0;
    for i in 0..self.map_count {
        let cap_aab26171: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26171, &self.map_thread, 0);
        if self.map_thread_len[i] == threadId_len && aab_bytes_eq(aab_byte_off( cap_aab26171, self.map_thread_off[i]), threadId_ptr, threadId_len) {
            continue;
        };
        if kept != i {
            self.map_session_off[kept] = self.map_session_off[i];
            self.map_session_len[kept] = self.map_session_len[i];
            self.map_thread_off[kept] = self.map_thread_off[i];
            self.map_thread_len[kept] = self.map_thread_len[i];
        };
        kept = kept + 1;
    }
    self.map_count = kept;
}

// ---- session/update handling ----

fn handleSessionUpdate(self: &AuggieAgentBridge, event: u64) -> void {
    let params: u64 = 0;
    sa_json_object_get(event, STR_PTR("params"), STR_LEN("params"), &params);
    if params == 0 { return; };
    let sessionId_ptr: ptr = PTR_NULL();
    let sessionId_len: u64 = 0;
    sa_json_object_get_string(params, STR_PTR("sessionId"), STR_LEN("sessionId"), &sessionId_ptr, &sessionId_len);
    let thread_buf = [0u8; 128];
    let thread_buf_p: ptr = PTR_NULL(); PTR_BYTE_ADD(thread_buf_p, &thread_buf, 0);
    let thread_len: u64 = 0;
    let si = find_session_by_acp(self, sessionId_ptr, sessionId_len, thread_buf_p, &thread_len);
    if si == 4294967295 { return; };
    let update: u64 = 0;
    sa_json_object_get(params, STR_PTR("update"), STR_LEN("update"), &update);
    if update == 0 { return; };
    let kind_ptr: ptr = PTR_NULL();
    let kind_len: u64 = 0;
    sa_json_object_get_string(update, STR_PTR("sessionUpdate"), STR_LEN("sessionUpdate"), &kind_ptr, &kind_len);
    // restore replay collection
    if self.sessions[si].has_restoreCollector {
        let content: u64 = 0;
        sa_json_object_get(update, STR_PTR("content"), STR_LEN("content"), &content);
        let text_ptr: ptr = PTR_NULL();
        let text_len: u64 = 0;
        if content != 0 { sa_json_object_get_string(content, STR_PTR("text"), STR_LEN("text"), &text_ptr, &text_len); };
        if text_len > 0 {
            let role: u8 = 255;
            if aab_str_is(kind_ptr, kind_len, AUGGIE_SESSION_UPDATE_AGENT_MESSAGE_CHUNK_ptr(), AUGGIE_SESSION_UPDATE_AGENT_MESSAGE_CHUNK_len()) { role = 1; };
            if aab_str_is(kind_ptr, kind_len, AUGGIE_SESSION_UPDATE_USER_MESSAGE_CHUNK_ptr(), AUGGIE_SESSION_UPDATE_USER_MESSAGE_CHUNK_len()) { role = 0; };
            if role != 255 && self.sessions[si].rc_count < 512 {
                let i = self.sessions[si].rc_count;
                self.sessions[si].rc_role[i] = role;
                self.sessions[si].rc_text_off[i] = self.sessions[si].rc_text_used;
                self.sessions[si].rc_text_len[i] = text_len;
                let cap_ab20: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ab20, &self.sessions[si].rc_text, 0);
                self.sessions[si].rc_text_used = self.sessions[si].rc_text_used + aab_append_bytes(cap_ab20, 524288, self.sessions[si].rc_text_used, text_ptr, text_len);
                self.sessions[si].rc_count = self.sessions[si].rc_count + 1;
            };
        };
        return;
    };
    if aab_str_is(kind_ptr, kind_len, AUGGIE_SESSION_UPDATE_TOOL_CALL_ptr(), AUGGIE_SESSION_UPDATE_TOOL_CALL_len()) {
        handleAuggieToolCall(self, si, update);
        return;
    };
    if aab_str_is(kind_ptr, kind_len, AUGGIE_SESSION_UPDATE_TOOL_CALL_UPDATE_ptr(), AUGGIE_SESSION_UPDATE_TOOL_CALL_UPDATE_len()) {
        handleAuggieToolCallUpdate(self, si, update);
        return;
    };
    if isAgentMessageChunk(event) {
        let content: u64 = 0;
        sa_json_object_get(update, STR_PTR("content"), STR_LEN("content"), &content);
        let text_ptr: ptr = PTR_NULL();
        let text_len: u64 = 0;
        if content != 0 { sa_json_object_get_string(content, STR_PTR("text"), STR_LEN("text"), &text_ptr, &text_len); };
        if text_len == 0 { return; };
        // suppressed housekeeping / indexing-consent text
        if is_indexing_housekeeping(text_ptr, text_len) { return; };
        if aab_contains_ci(text_ptr, text_len, STR_PTR("would like to index your workspace"), STR_LEN("would like to index your workspace")) { return; };
        if aab_contains_ci(text_ptr, text_len, STR_PTR("indexing your workspace"), STR_LEN("indexing your workspace")) { return; };
        if !self.sessions[si].has_activeTurnId { return; };
        let turnId = [0u8; 128];
        let turnId_p: ptr = PTR_NULL(); PTR_BYTE_ADD(turnId_p, &turnId, 0);
        let cap_aab26563: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26563, &self.sessions[si].activeTurnId, 0);
        let turnId_len = aab_buf_copy(turnId_p, 128, cap_aab26563, self.sessions[si].activeTurnId_len);
        // open segment or start a new one
        let itemId = [0u8; 160];
        let itemId_p: ptr = PTR_NULL(); PTR_BYTE_ADD(itemId_p, &itemId, 0);
        let itemId_len: u64 = 0;
        let has_open = open_text_get(&self.sessions[si], turnId_p, turnId_len, itemId_p, &itemId_len);
        let is_first = false;
        if !has_open {
            let seg = seg_next(&self.sessions[si], turnId_p, turnId_len);
            itemId_len = 0;
            itemId_len = itemId_len + aab_append_bytes(itemId_p, 160, itemId_len, STR_PTR("auggie-"), STR_LEN("auggie-"));
            itemId_len = itemId_len + aab_append_bytes(itemId_p, 160, itemId_len, turnId_p, turnId_len);
            itemId_len = itemId_len + aab_append_bytes(itemId_p, 160, itemId_len, STR_PTR("-text-"), STR_LEN("-text-"));
            itemId_len = itemId_len + aab_append_u64(itemId_p, 160, itemId_len, seg);
            open_text_set(&self.sessions[si], turnId_p, turnId_len, itemId_p, itemId_len, true);
            is_first = !stream_has(&self.sessions[si], turnId_p, turnId_len, itemId_p, itemId_len);
        };
        stream_append(&self.sessions[si], turnId_p, turnId_len, itemId_p, itemId_len, text_ptr, text_len);
        self.sessions[si].lastActivityMs = aab_now_ms();
        self.sessions[si].has_lastActivityMs = true;
        if is_first {
            let item = aab_json_object_new();
            aab_sa_json_object_set_string(item, STR_PTR("type"), STR_LEN("type"), STR_PTR("agentMessage"), STR_LEN("agentMessage"));
            aab_sa_json_object_set_string(item, STR_PTR("id"), STR_LEN("id"), itemId_p, itemId_len);
            aab_sa_json_object_set_string(item, STR_PTR("turnId"), STR_LEN("turnId"), turnId_p, turnId_len);
            aab_sa_json_object_set_string(item, STR_PTR("threadId"), STR_LEN("threadId"), thread_buf_p, thread_len);
            aab_sa_json_object_set_string(item, STR_PTR("content"), STR_LEN("content"), STR_PTR(""), 0);
            aab_sa_json_object_set_string(item, STR_PTR("role"), STR_LEN("role"), STR_PTR("assistant"), STR_LEN("assistant"));
            aab_sa_json_object_set_string(item, STR_PTR("status"), STR_LEN("status"), STR_PTR("inProgress"), STR_LEN("inProgress"));
            upsertSessionItem(&self.sessions[si], item);
            let frame = aab_json_object_new();
            aab_sa_json_object_set_string(frame, STR_PTR("method"), STR_LEN("method"), STR_PTR("item/started"), STR_LEN("item/started"));
            let fp = aab_json_object_new();
            aab_sa_json_object_set_string(fp, STR_PTR("threadId"), STR_LEN("threadId"), thread_buf_p, thread_len);
            aab_sa_json_object_set_string(fp, STR_PTR("turnId"), STR_LEN("turnId"), turnId_p, turnId_len);
            sa_json_object_set_node(fp, STR_PTR("item"), STR_LEN("item"), item);
            sa_json_object_set_node(frame, STR_PTR("params"), STR_LEN("params"), fp);
            bridge_emit_message(self, frame);
        };
        let frame = aab_json_object_new();
        aab_sa_json_object_set_string(frame, STR_PTR("method"), STR_LEN("method"), STR_PTR("item/agentMessage/delta"), STR_LEN("item/agentMessage/delta"));
        let fp = aab_json_object_new();
        aab_sa_json_object_set_string(fp, STR_PTR("threadId"), STR_LEN("threadId"), thread_buf_p, thread_len);
        aab_sa_json_object_set_string(fp, STR_PTR("turnId"), STR_LEN("turnId"), turnId_p, turnId_len);
        aab_sa_json_object_set_string(fp, STR_PTR("itemId"), STR_LEN("itemId"), itemId_p, itemId_len);
        aab_sa_json_object_set_string(fp, STR_PTR("delta"), STR_LEN("delta"), text_ptr, text_len);
        sa_json_object_set_node(frame, STR_PTR("params"), STR_LEN("params"), fp);
        bridge_emit_message(self, frame);
        arm_turn_silence(&self.sessions[si], turnId_p, turnId_len);
        return;
    };
    if isAvailableCommandsUpdate(event) {
        // logged only; no Codex notification equivalent
        return;
    };
}

// is_indexing_housekeeping: the source's
// /^Indexing (disabled|enabled) for current workspace
// .*? for this session\.\s*$/s as a hand scan.
fn is_indexing_housekeeping(text_ptr: ptr, text_len: u64) -> bool {
    if !aab_starts_with(text_ptr, text_len, STR_PTR("Indexing "), STR_LEN("Indexing ")) { return false; };
    let rest = aab_byte_off(text_ptr, STR_LEN("Indexing "));
    let rest_len = text_len - STR_LEN("Indexing ");
    let word_len: u64 = 0;
    if aab_starts_with(rest, rest_len, STR_PTR("disabled"), STR_LEN("disabled")) { word_len = STR_LEN("disabled"); } else if aab_starts_with(rest, rest_len, STR_PTR("enabled"), STR_LEN("enabled")) { word_len = STR_LEN("enabled"); } else { return false; };
    let mid = aab_byte_off(rest, word_len);
    let mid_len = rest_len - word_len;
    if !aab_starts_with(mid, mid_len, STR_PTR(" for current workspace "), STR_LEN(" for current workspace ")) { return false; };
    // must end with " for this session." + optional ws
    let tp: ptr = PTR_NULL();
    let tl: u64 = 0;
    aab_ts_trim_span(text_ptr, text_len, &tp, &tl);
    return ends_with(tp, tl, STR_PTR(" for this session."), STR_LEN(" for this session."));
}

// per-turn table helpers (openText / textSeg / stream)
fn open_text_get(s: &AuggieSession, turnId_ptr: ptr, turnId_len: u64, out_item: ptr, out_item_len: &u64) -> bool {
    *out_item_len = 0;
    for i in 0..s.ot_count {
        let cap_aab26172: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26172, &s.ot_turn, 0);
        if s.ot_turn_len[i] == turnId_len && aab_bytes_eq(aab_byte_off( cap_aab26172, s.ot_turn_off[i]), turnId_ptr, turnId_len) {
            if !s.ot_has[i] { return false; };
            let cap_aab26173: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26173, &s.ot_item, 0);
            *out_item_len = aab_buf_copy(out_item, 160, aab_byte_off( cap_aab26173, s.ot_item_off[i]), s.ot_item_len[i]);
            return true;
        };
    }
    return false;
}

fn open_text_set(s: &AuggieSession, turnId_ptr: ptr, turnId_len: u64, item_ptr: ptr, item_len: u64, has: bool) -> void {
    for i in 0..s.ot_count {
        let cap_aab26174: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26174, &s.ot_turn, 0);
        if s.ot_turn_len[i] == turnId_len && aab_bytes_eq(aab_byte_off( cap_aab26174, s.ot_turn_off[i]), turnId_ptr, turnId_len) {
            s.ot_has[i] = has;
            if has {
                s.ot_item_off[i] = s.ot_item_used;
                s.ot_item_len[i] = item_len;
                let cap_ab21: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ab21, &s.ot_item, 0);
                s.ot_item_used = s.ot_item_used + aab_append_bytes(cap_ab21, 16384, s.ot_item_used, item_ptr, item_len);
            };
            return;
        };
    }
    if s.ot_count >= 64 { return; };
    let i = s.ot_count;
    s.ot_turn_off[i] = s.ot_turn_used;
    s.ot_turn_len[i] = turnId_len;
    let cap_ab22: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ab22, &s.ot_turn, 0);
    s.ot_turn_used = s.ot_turn_used + aab_append_bytes(cap_ab22, 16384, s.ot_turn_used, turnId_ptr, turnId_len);
    s.ot_has[i] = has;
    s.ot_item_off[i] = s.ot_item_used;
    s.ot_item_len[i] = if has { item_len } else { 0 };
    let cap_ab23: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ab23, &s.ot_item, 0);
    if has { s.ot_item_used = s.ot_item_used + aab_append_bytes(cap_ab23, 16384, s.ot_item_used, item_ptr, item_len); };
    s.ot_count = s.ot_count + 1;
}

fn open_text_delete(s: &AuggieSession, turnId_ptr: ptr, turnId_len: u64) -> void {
    for i in 0..s.ot_count {
        let cap_aab26175: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26175, &s.ot_turn, 0);
        if s.ot_turn_len[i] == turnId_len && aab_bytes_eq(aab_byte_off( cap_aab26175, s.ot_turn_off[i]), turnId_ptr, turnId_len) {
            s.ot_has[i] = false;
            return;
        };
    }
}

fn seg_next(s: &AuggieSession, turnId_ptr: ptr, turnId_len: u64) -> u64 {
    for i in 0..s.seg_count {
        let cap_aab26176: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26176, &s.seg_turn, 0);
        if s.seg_turn_len[i] == turnId_len && aab_bytes_eq(aab_byte_off( cap_aab26176, s.seg_turn_off[i]), turnId_ptr, turnId_len) {
            s.seg_value[i] = s.seg_value[i] + 1;
            return s.seg_value[i];
        };
    }
    if s.seg_count >= 64 { return 1; };
    let i = s.seg_count;
    s.seg_turn_off[i] = s.seg_turn_used;
    s.seg_turn_len[i] = turnId_len;
    let cap_ab24: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ab24, &s.seg_turn, 0);
    s.seg_turn_used = s.seg_turn_used + aab_append_bytes(cap_ab24, 16384, s.seg_turn_used, turnId_ptr, turnId_len);
    s.seg_value[i] = 1;
    s.seg_count = s.seg_count + 1;
    return 1;
}

fn stream_has(s: &AuggieSession, turnId_ptr: ptr, turnId_len: u64, itemId_ptr: ptr, itemId_len: u64) -> bool {
    for i in 0..s.stm_count {
        let cap_aab26177: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26177, &s.stm_turn, 0);
        let cap_aab26277: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26277, &s.stm_item, 0);
        if s.stm_turn_len[i] == turnId_len && aab_bytes_eq(aab_byte_off( cap_aab26177, s.stm_turn_off[i]), turnId_ptr, turnId_len) && s.stm_item_len[i] == itemId_len && aab_bytes_eq(aab_byte_off( cap_aab26277, s.stm_item_off[i]), itemId_ptr, itemId_len) {
            return true;
        };
    }
    return false;
}

fn stream_append(s: &AuggieSession, turnId_ptr: ptr, turnId_len: u64, itemId_ptr: ptr, itemId_len: u64, text_ptr: ptr, text_len: u64) -> void {
    for i in 0..s.stm_count {
        let cap_aab26178: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26178, &s.stm_turn, 0);
        let cap_aab26278: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26278, &s.stm_item, 0);
        if s.stm_turn_len[i] == turnId_len && aab_bytes_eq(aab_byte_off( cap_aab26178, s.stm_turn_off[i]), turnId_ptr, turnId_len) && s.stm_item_len[i] == itemId_len && aab_bytes_eq(aab_byte_off( cap_aab26278, s.stm_item_off[i]), itemId_ptr, itemId_len) {
            // append into a fresh arena slot, repoint
            let old_off = s.stm_text_off[i];
            let old_len = s.stm_text_len[i];
            let new_off = s.stm_text_used;
            let cap_ab25: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ab25, &s.stm_text, 0);
            let cap_ab26: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ab26, &s.stm_text, 0);
            s.stm_text_used = s.stm_text_used + aab_append_bytes(cap_ab25, 1048576, s.stm_text_used, aab_byte_off(cap_ab26, old_off), old_len);
            let cap_ab27: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ab27, &s.stm_text, 0);
            s.stm_text_used = s.stm_text_used + aab_append_bytes(cap_ab27, 1048576, s.stm_text_used, text_ptr, text_len);
            s.stm_text_off[i] = new_off;
            s.stm_text_len[i] = old_len + text_len;
            return;
        };
    }
    if s.stm_count >= 256 { return; };
    let i = s.stm_count;
    s.stm_turn_off[i] = s.stm_turn_used;
    s.stm_turn_len[i] = turnId_len;
    let cap_ab28: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ab28, &s.stm_turn, 0);
    s.stm_turn_used = s.stm_turn_used + aab_append_bytes(cap_ab28, 65536, s.stm_turn_used, turnId_ptr, turnId_len);
    s.stm_item_off[i] = s.stm_item_used;
    s.stm_item_len[i] = itemId_len;
    let cap_ab29: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ab29, &s.stm_item, 0);
    s.stm_item_used = s.stm_item_used + aab_append_bytes(cap_ab29, 65536, s.stm_item_used, itemId_ptr, itemId_len);
    s.stm_text_off[i] = s.stm_text_used;
    s.stm_text_len[i] = text_len;
    let cap_ab30: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ab30, &s.stm_text, 0);
    s.stm_text_used = s.stm_text_used + aab_append_bytes(cap_ab30, 1048576, s.stm_text_used, text_ptr, text_len);
    s.stm_count = s.stm_count + 1;
}

fn stream_get(s: &AuggieSession, turnId_ptr: ptr, turnId_len: u64, itemId_ptr: ptr, itemId_len: u64, out: ptr, out_cap: u64) -> u64 {
    for i in 0..s.stm_count {
        let cap_aab26179: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26179, &s.stm_turn, 0);
        let cap_aab26279: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26279, &s.stm_item, 0);
        if s.stm_turn_len[i] == turnId_len && aab_bytes_eq(aab_byte_off( cap_aab26179, s.stm_turn_off[i]), turnId_ptr, turnId_len) && s.stm_item_len[i] == itemId_len && aab_bytes_eq(aab_byte_off( cap_aab26279, s.stm_item_off[i]), itemId_ptr, itemId_len) {
            let cap_aab26180: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26180, &s.stm_text, 0);
            return aab_buf_copy(out, out_cap, aab_byte_off( cap_aab26180, s.stm_text_off[i]), s.stm_text_len[i]);
        };
    }
    return 0;
}

fn stream_delete(s: &AuggieSession, turnId_ptr: ptr, turnId_len: u64, itemId_ptr: ptr, itemId_len: u64) -> void {
    for i in 0..s.stm_count {
        let cap_aab26181: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26181, &s.stm_turn, 0);
        let cap_aab26281: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26281, &s.stm_item, 0);
        if s.stm_turn_len[i] == turnId_len && aab_bytes_eq(aab_byte_off( cap_aab26181, s.stm_turn_off[i]), turnId_ptr, turnId_len) && s.stm_item_len[i] == itemId_len && aab_bytes_eq(aab_byte_off( cap_aab26281, s.stm_item_off[i]), itemId_ptr, itemId_len) {
            s.stm_text_len[i] = 0;
            return;
        };
    }
}

// conversation + assistantTextByTurn appends with the
// source's duplicate suppression.
fn conversation_push_assistant(s: &AuggieSession, text_ptr: ptr, text_len: u64) -> void {
    let normalized = [0u8; 262144];
    let normalized_p: ptr = PTR_NULL(); PTR_BYTE_ADD(normalized_p, &normalized, 0);
    let normalized_len = normalizeAssistantText(text_ptr, text_len, normalized_p, 262144);
    if normalized_len == 0 { return; };
    if s.conv_count > 0 {
        let last = s.conv_count - 1;
        if s.conv_role[last] == 1 {
            let prev = [0u8; 262144];
            let prev_p: ptr = PTR_NULL(); PTR_BYTE_ADD(prev_p, &prev, 0);
            let cap_aab26182: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26182, &s.conv_text, 0);
            let prev_len = normalizeAssistantText(aab_byte_off( cap_aab26182, s.conv_text_off[last]), s.conv_text_len[last], prev_p, 262144);
            if prev_len == normalized_len && aab_bytes_eq(prev_p, normalized_p, prev_len) { return; };
        };
    };
    if s.conv_count >= 512 { return; };
    let i = s.conv_count;
    s.conv_role[i] = 1;
    s.conv_text_off[i] = s.conv_text_used;
    s.conv_text_len[i] = normalized_len;
    let cap_ab31: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ab31, &s.conv_text, 0);
    s.conv_text_used = s.conv_text_used + aab_append_bytes(cap_ab31, 524288, s.conv_text_used, normalized_p, normalized_len);
    s.conv_count = s.conv_count + 1;
}

fn conversation_push_user(s: &AuggieSession, text_ptr: ptr, text_len: u64) -> void {
    if s.conv_count >= 512 { return; };
    let i = s.conv_count;
    s.conv_role[i] = 0;
    s.conv_text_off[i] = s.conv_text_used;
    s.conv_text_len[i] = text_len;
    let cap_ab32: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ab32, &s.conv_text, 0);
    s.conv_text_used = s.conv_text_used + aab_append_bytes(cap_ab32, 524288, s.conv_text_used, text_ptr, text_len);
    s.conv_count = s.conv_count + 1;
}

fn assistant_text_push(s: &AuggieSession, turnId_ptr: ptr, turnId_len: u64, text_ptr: ptr, text_len: u64) -> void {
    // blocks.includes(text) check first
    for i in 0..s.abt_count {
        let cap_aab26183: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26183, &s.abt_turn, 0);
        let cap_aab26184: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26184, &s.abt_text, 0);
        if s.abt_turn_len[i] == turnId_len && aab_bytes_eq(aab_byte_off( cap_aab26183, s.abt_turn_off[i]), turnId_ptr, turnId_len) && s.abt_text_len[i] == text_len && aab_bytes_eq(aab_byte_off( cap_aab26184, s.abt_text_off[i]), text_ptr, text_len) {
            return;
        };
    }
    if s.abt_count >= 512 { return; };
    let i = s.abt_count;
    s.abt_turn_off[i] = s.abt_turn_used;
    s.abt_turn_len[i] = turnId_len;
    let cap_ab33: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ab33, &s.abt_turn, 0);
    s.abt_turn_used = s.abt_turn_used + aab_append_bytes(cap_ab33, 65536, s.abt_turn_used, turnId_ptr, turnId_len);
    s.abt_text_off[i] = s.abt_text_used;
    s.abt_text_len[i] = text_len;
    let cap_ab34: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ab34, &s.abt_text, 0);
    s.abt_text_used = s.abt_text_used + aab_append_bytes(cap_ab34, 524288, s.abt_text_used, text_ptr, text_len);
    s.abt_count = s.abt_count + 1;
}

// closeOpenTextSegment(session, threadId)
fn closeOpenTextSegment(self: &AuggieAgentBridge, si: u64) -> void {
    if !self.sessions[si].has_activeTurnId { return; };
    let turnId = [0u8; 128];
    let turnId_p: ptr = PTR_NULL(); PTR_BYTE_ADD(turnId_p, &turnId, 0);
    let cap_aab26564: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26564, &self.sessions[si].activeTurnId, 0);
    let turnId_len = aab_buf_copy(turnId_p, 128, cap_aab26564, self.sessions[si].activeTurnId_len);
    let itemId = [0u8; 160];
    let itemId_p: ptr = PTR_NULL(); PTR_BYTE_ADD(itemId_p, &itemId, 0);
    let itemId_len: u64 = 0;
    if !open_text_get(&self.sessions[si], turnId_p, turnId_len, itemId_p, &itemId_len) { return; };
    open_text_set(&self.sessions[si], turnId_p, turnId_len, itemId_p, itemId_len, false);
    let text = [0u8; 262144];
    let cap_aab27057: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab27057, &text, 0);
    let text_len = stream_get(&self.sessions[si], turnId_p, turnId_len, itemId_p, itemId_len, cap_aab27057, 262144);
    stream_delete(&self.sessions[si], turnId_p, turnId_len, itemId_p, itemId_len);
    if text_len == 0 { return; };
    let item = aab_json_object_new();
    aab_sa_json_object_set_string(item, STR_PTR("type"), STR_LEN("type"), STR_PTR("agentMessage"), STR_LEN("agentMessage"));
    aab_sa_json_object_set_string(item, STR_PTR("id"), STR_LEN("id"), itemId_p, itemId_len);
    aab_sa_json_object_set_string(item, STR_PTR("turnId"), STR_LEN("turnId"), turnId_p, turnId_len);
    let cap_aab26735: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26735, &self.sessions[si].threadId, 0);
    aab_sa_json_object_set_string(item, STR_PTR("threadId"), STR_LEN("threadId"), cap_aab26735, self.sessions[si].threadId_len);
    let cap_aab26736: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26736, &text, 0);
    aab_sa_json_object_set_string(item, STR_PTR("content"), STR_LEN("content"), cap_aab26736, text_len);
    aab_sa_json_object_set_string(item, STR_PTR("role"), STR_LEN("role"), STR_PTR("assistant"), STR_LEN("assistant"));
    aab_sa_json_object_set_string(item, STR_PTR("status"), STR_LEN("status"), STR_PTR("completed"), STR_LEN("completed"));
    upsertSessionItem(&self.sessions[si], item);
    let frame = aab_json_object_new();
    aab_sa_json_object_set_string(frame, STR_PTR("method"), STR_LEN("method"), STR_PTR("item/completed"), STR_LEN("item/completed"));
    let fp = aab_json_object_new();
    let cap_aab26737: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26737, &self.sessions[si].threadId, 0);
    aab_sa_json_object_set_string(fp, STR_PTR("threadId"), STR_LEN("threadId"), cap_aab26737, self.sessions[si].threadId_len);
    aab_sa_json_object_set_string(fp, STR_PTR("turnId"), STR_LEN("turnId"), turnId_p, turnId_len);
    sa_json_object_set_node(fp, STR_PTR("item"), STR_LEN("item"), item);
    sa_json_object_set_node(frame, STR_PTR("params"), STR_LEN("params"), fp);
    bridge_emit_message(self, frame);
    let cap_aab27058: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab27058, &text, 0);
    conversation_push_assistant(&self.sessions[si], cap_aab27058, text_len);
    let cap_aab27060: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab27060, &text, 0);
    assistant_text_push(&self.sessions[si], turnId_p, turnId_len, cap_aab27060, text_len);
}

// ---- tool calls + subagents ----

// mapAuggieToolStatus(status) -> status text slot
fn mapAuggieToolStatus(status_ptr: ptr, status_len: u64, out_len: &u64) -> ptr {
    if aab_str_is(status_ptr, status_len, STR_PTR("completed"), STR_LEN("completed")) { *out_len = STR_LEN("completed"); return STR_PTR("completed"); };
    if aab_str_is(status_ptr, status_len, STR_PTR("failed"), STR_LEN("failed")) { *out_len = STR_LEN("failed"); return STR_PTR("failed"); };
    *out_len = STR_LEN("inProgress");
    return STR_PTR("inProgress");
}

// extractAuggieResultText(value): recursive text pull
// (string | array join "\n" | record.text/output/
// content).
fn extractAuggieResultText(value: u64, out: ptr, out_cap: u64) -> u64 {
    if value == 0 { return 0; };
    let is_str = false;
    aab_json_node_is_string(value, &is_str);
    if is_str {
        let p: ptr = PTR_NULL();
        let l: u64 = 0;
        aab_json_node_string(value, &p, &l);
        return aab_buf_copy(out, out_cap, p, l);
    };
    let is_arr = false;
    aab_json_node_is_array(value, &is_arr);
    if is_arr {
        let n: u64 = 0;
        let count: u64 = 0;
        let parts: u64 = 0;
        sa_json_value_count(value, &count);
        for i in 0..count {
            let e: u64 = 0;
            sa_json_array_get(value, i, &e);
            let part = [0u8; 65536];
            let part_p: ptr = PTR_NULL(); PTR_BYTE_ADD(part_p, &part, 0);
            let part_len = extractAuggieResultText(e, part_p, 65536);
            if part_len == 0 { continue; };
            if parts > 0 { n = n + aab_append_bytes(out, out_cap, n, STR_PTR("\n"), 1); };
            n = n + aab_append_bytes(out, out_cap, n, part_p, part_len);
            parts = parts + 1;
        }
        return n;
    };
    let is_obj = false;
    aab_json_node_is_object(value, &is_obj);
    if is_obj {
        let p: ptr = PTR_NULL();
        let l: u64 = 0;
        if sa_json_object_get_string(value, STR_PTR("text"), STR_LEN("text"), &p, &l) == 0 { return aab_buf_copy(out, out_cap, p, l); };
        if sa_json_object_get_string(value, STR_PTR("output"), STR_LEN("output"), &p, &l) == 0 { return aab_buf_copy(out, out_cap, p, l); };
        let content: u64 = 0;
        if sa_json_object_get(value, STR_PTR("content"), STR_LEN("content"), &content) == 0 && content != 0 {
            return extractAuggieResultText(content, out, out_cap);
        };
    };
    return 0;
}

// isAuggieSubagentUpdate(update): kind "other"
// (case-insensitive) and rawInput absent/null.
fn isAuggieSubagentUpdate(update: u64) -> bool {
    let kind_ptr: ptr = PTR_NULL();
    let kind_len: u64 = 0;
    if update == 0 || sa_json_object_get_string(update, STR_PTR("kind"), STR_LEN("kind"), &kind_ptr, &kind_len) != 0 { return false; };
    let lowered = [0u8; 64];
    let lowered_p: ptr = PTR_NULL(); PTR_BYTE_ADD(lowered_p, &lowered, 0);
    let lowered_len = aab_to_lower(lowered_p, 64, kind_ptr, kind_len);
    if !aab_str_is(lowered_p, lowered_len, STR_PTR("other"), STR_LEN("other")) { return false; };
    let raw: u64 = 0;
    if sa_json_object_get(update, STR_PTR("rawInput"), STR_LEN("rawInput"), &raw) != 0 { return true; };
    if raw == 0 { return true; };
    let is_null = false;
    aab_json_node_is_null(raw, &is_null);
    return is_null;
}

// splitAuggieSubagentTitle(title)
fn splitAuggieSubagentTitle(title_ptr: ptr, title_len: u64, agent_out: ptr, agent_cap: u64, agent_len: &u64, instr_out: ptr, instr_cap: u64, instr_len: &u64) -> void {
    let sep = aab_find_byte(title_ptr, title_len, 0, 58);
    if sep == 4294967295 || sep == 0 {
        let tp: ptr = PTR_NULL();
        let tl: u64 = 0;
        aab_ts_trim_span(title_ptr, title_len, &tp, &tl);
        if tl == 0 { tp = STR_PTR("subagent"); tl = STR_LEN("subagent"); };
        *agent_len = aab_buf_copy(agent_out, agent_cap, tp, tl);
        *instr_len = 0;
        return;
    };
    let ap: ptr = PTR_NULL();
    let al: u64 = 0;
    aab_ts_trim_span(title_ptr, sep, &ap, &al);
    if al == 0 { ap = STR_PTR("subagent"); al = STR_LEN("subagent"); };
    *agent_len = aab_buf_copy(agent_out, agent_cap, ap, al);
    let ip: ptr = PTR_NULL();
    let il: u64 = 0;
    aab_ts_trim_span(aab_byte_off(title_ptr, sep + 1), title_len - sep - 1, &ip, &il);
    *instr_len = aab_buf_copy(instr_out, instr_cap, ip, il);
}

// buildAuggieCollabItem(threadId, turnId?, toolCallId,
// title, update, existing?) -> item doc.
fn buildAuggieCollabItem(threadId_ptr: ptr, threadId_len: u64, turnId_ptr: ptr, turnId_len: u64, has_turnId: bool, toolCallId_ptr: ptr, toolCallId_len: u64, title_ptr: ptr, title_len: u64, update: u64, existing: u64) -> u64 {
    let agent = [0u8; 512];
    let agent_p: ptr = PTR_NULL(); PTR_BYTE_ADD(agent_p, &agent, 0);
    let agent_len: u64 = 0;
    let instr = [0u8; 4096];
    let instr_p: ptr = PTR_NULL(); PTR_BYTE_ADD(instr_p, &instr, 0);
    let instr_len: u64 = 0;
    splitAuggieSubagentTitle(title_ptr, title_len, agent_p, 512, &agent_len, instr_p, 4096, &instr_len);
    if agent_len == 0 && existing != 0 {
        let p: ptr = PTR_NULL();
        let l: u64 = 0;
        if sa_json_object_get_string(existing, STR_PTR("agentName"), STR_LEN("agentName"), &p, &l) == 0 && l > 0 {
            agent_len = aab_buf_copy(agent_p, 512, p, l);
        } else if sa_json_object_get_string(existing, STR_PTR("agentRole"), STR_LEN("agentRole"), &p, &l) == 0 && l > 0 {
            agent_len = aab_buf_copy(agent_p, 512, p, l);
        };
    };
    if agent_len == 0 { agent_len = aab_buf_copy(agent_p, 512, STR_PTR("subagent"), STR_LEN("subagent")); };
    if instr_len == 0 && existing != 0 {
        let p: ptr = PTR_NULL();
        let l: u64 = 0;
        if sa_json_object_get_string(existing, STR_PTR("prompt"), STR_LEN("prompt"), &p, &l) == 0 && l > 0 {
            instr_len = aab_buf_copy(instr_p, 4096, p, l);
        };
    };
    let name_ptr = title_ptr;
    let name_len = title_len;
    if name_len == 0 { name_ptr = agent_p; name_len = agent_len; };
    let item = aab_json_object_new();
    aab_sa_json_object_set_string(item, STR_PTR("type"), STR_LEN("type"), STR_PTR("collabAgentToolCall"), STR_LEN("collabAgentToolCall"));
    aab_sa_json_object_set_string(item, STR_PTR("id"), STR_LEN("id"), toolCallId_ptr, toolCallId_len);
    if has_turnId { aab_sa_json_object_set_string(item, STR_PTR("turnId"), STR_LEN("turnId"), turnId_ptr, turnId_len); };
    aab_sa_json_object_set_string(item, STR_PTR("threadId"), STR_LEN("threadId"), threadId_ptr, threadId_len);
    aab_sa_json_object_set_string(item, STR_PTR("name"), STR_LEN("name"), name_ptr, name_len);
    aab_sa_json_object_set_string(item, STR_PTR("tool"), STR_LEN("tool"), STR_PTR("task"), STR_LEN("task"));
    aab_sa_json_object_set_string(item, STR_PTR("toolName"), STR_LEN("toolName"), name_ptr, name_len);
    aab_sa_json_object_set_string(item, STR_PTR("agentId"), STR_LEN("agentId"), toolCallId_ptr, toolCallId_len);
    aab_sa_json_object_set_string(item, STR_PTR("agentName"), STR_LEN("agentName"), agent_p, agent_len);
    aab_sa_json_object_set_string(item, STR_PTR("agentRole"), STR_LEN("agentRole"), agent_p, agent_len);
    aab_sa_json_object_set_string(item, STR_PTR("taskName"), STR_LEN("taskName"), agent_p, agent_len);
    if instr_len > 0 {
        aab_sa_json_object_set_string(item, STR_PTR("prompt"), STR_LEN("prompt"), instr_p, instr_len);
        aab_sa_json_object_set_string(item, STR_PTR("message"), STR_LEN("message"), instr_p, instr_len);
    };
    aab_sa_json_object_set_string(item, STR_PTR("senderThreadId"), STR_LEN("senderThreadId"), threadId_ptr, threadId_len);
    sa_json_object_set_node(item, STR_PTR("receiverThreadIds"), STR_LEN("receiverThreadIds"), aab_json_array_new());
    aab_sa_json_object_set_string(item, STR_PTR("agentStatus"), STR_LEN("agentStatus"), STR_PTR("running"), STR_LEN("running"));
    aab_sa_json_object_set_string(item, STR_PTR("status"), STR_LEN("status"), STR_PTR("inProgress"), STR_LEN("inProgress"));
    let raw: u64 = 0;
    if update != 0 && sa_json_object_get(update, STR_PTR("rawInput"), STR_LEN("rawInput"), &raw) == 0 && raw != 0 {
        let is_null = false;
        aab_json_node_is_null(raw, &is_null);
        if !is_null { sa_json_object_set_node(item, STR_PTR("arguments"), STR_LEN("arguments"), jsonRecord(raw)); };
    };
    return item;
}

// handleAuggieToolCall(session, threadId, update)
fn handleAuggieToolCall(self: &AuggieAgentBridge, si: u64, update: u64) -> void {
    let toolCallId_ptr: ptr = PTR_NULL();
    let toolCallId_len: u64 = 0;
    if sa_json_object_get_string(update, STR_PTR("toolCallId"), STR_LEN("toolCallId"), &toolCallId_ptr, &toolCallId_len) != 0 || toolCallId_len == 0 { return; };
    closeOpenTextSegment(self, si);
    let turnId = [0u8; 128];
    let turnId_p: ptr = PTR_NULL(); PTR_BYTE_ADD(turnId_p, &turnId, 0);
    let turnId_len: u64 = 0;
    let has_turn = self.sessions[si].has_activeTurnId;
    let cap_aab26565: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26565, &self.sessions[si].activeTurnId, 0);
    if has_turn { turnId_len = aab_buf_copy(turnId_p, 128, cap_aab26565, self.sessions[si].activeTurnId_len); };
    let existing: u64 = 0;
    let has_existing = session_tc_get(&self.sessions[si], toolCallId_ptr, toolCallId_len, &existing);
    if !has_existing { existing = 0; };
    let title_ptr: ptr = PTR_NULL();
    let title_len: u64 = 0;
    if sa_json_object_get_string(update, STR_PTR("title"), STR_LEN("title"), &title_ptr, &title_len) != 0 || title_len == 0 {
        title_ptr = STR_PTR("Tool");
        title_len = STR_LEN("Tool");
    };
    let subagent = isAuggieSubagentUpdate(update);
    let item: u64 = 0;
    let done = false;
    if subagent {
        let cap_aab27062: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab27062, &self.sessions[si].threadId, 0);
        item = buildAuggieCollabItem( cap_aab27062, self.sessions[si].threadId_len, turnId_p, turnId_len, has_turn, toolCallId_ptr, toolCallId_len, title_ptr, title_len, update, existing);
        if has_existing {
            let content: u64 = 0;
            let payload: u64 = 0;
            if sa_json_object_get(update, STR_PTR("content"), STR_LEN("content"), &content) == 0 && content != 0 { payload = content; } else if sa_json_object_get(update, STR_PTR("rawOutput"), STR_LEN("rawOutput"), &payload) != 0 { payload = 0; };
            let result_text = [0u8; 262144];
            let result_text_p: ptr = PTR_NULL(); PTR_BYTE_ADD(result_text_p, &result_text, 0);
            let result_text_len = extractAuggieResultText(payload, result_text_p, 262144);
            if result_text_len > 0 {
                aab_sa_json_object_set_string(item, STR_PTR("status"), STR_LEN("status"), STR_PTR("completed"), STR_LEN("completed"));
                aab_sa_json_object_set_string(item, STR_PTR("agentStatus"), STR_LEN("agentStatus"), STR_PTR("completed"), STR_LEN("completed"));
                aab_sa_json_object_set_string(item, STR_PTR("output"), STR_LEN("output"), result_text_p, result_text_len);
                let result = aab_json_object_new();
                aab_sa_json_object_set_string(result, STR_PTR("content"), STR_LEN("content"), result_text_p, result_text_len);
                sa_json_object_set_node(item, STR_PTR("result"), STR_LEN("result"), result);
                done = true;
            };
        };
    } else {
        item = aab_json_object_new();
        aab_sa_json_object_set_string(item, STR_PTR("type"), STR_LEN("type"), STR_PTR("toolCall"), STR_LEN("toolCall"));
        aab_sa_json_object_set_string(item, STR_PTR("id"), STR_LEN("id"), toolCallId_ptr, toolCallId_len);
        if has_turn { aab_sa_json_object_set_string(item, STR_PTR("turnId"), STR_LEN("turnId"), turnId_p, turnId_len); };
        let cap_aab26738: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26738, &self.sessions[si].threadId, 0);
        aab_sa_json_object_set_string(item, STR_PTR("threadId"), STR_LEN("threadId"), cap_aab26738, self.sessions[si].threadId_len);
        aab_sa_json_object_set_string(item, STR_PTR("toolName"), STR_LEN("toolName"), title_ptr, title_len);
        let raw: u64 = 0;
        sa_json_object_get(update, STR_PTR("rawInput"), STR_LEN("rawInput"), &raw);
        sa_json_object_set_node(item, STR_PTR("arguments"), STR_LEN("arguments"), jsonRecord(raw));let _ifd2 = 
        aab_sa_json_object_set_string(item, STR_PTR("status"), STR_LEN("status"), STR_PTR("inProgress"), STR_LEN("inProgress"));
    };
    session_tc_set(&self.sessions[si], toolCallId_ptr, toolCallId_len, item);
    upsertSessionItem(&self.sessions[si], item);
    self.sessions[si].lastActivityMs = aab_now_ms();
    self.sessions[si].has_lastActivityMs = true;
    if has_turn { arm_turn_silence(&self.sessions[si], turnId_p, turnId_len); };
    let status_ptr: ptr = PTR_NULL();
    let status_len: u64 = 0;
    sa_json_object_get_string(item, STR_PTR("status"), STR_LEN("status"), &status_ptr, &status_len);
    if aab_str_is(status_ptr, status_len, STR_PTR("completed"), STR_LEN("completed")) || aab_str_is(status_ptr, status_len, STR_PTR("failed"), STR_LEN("failed")) { done = true; };
    let frame = aab_json_object_new();
    aab_sa_json_object_set_string(frame, STR_PTR("method"), STR_LEN("method"), if done { STR_PTR("item/completed") } else { STR_PTR("item/started") }, if done { STR_LEN("item/completed") } else { STR_LEN("item/started") });
    let fp = aab_json_object_new();
    let cap_aab26739: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26739, &self.sessions[si].threadId, 0);
    aab_sa_json_object_set_string(fp, STR_PTR("threadId"), STR_LEN("threadId"), cap_aab26739, self.sessions[si].threadId_len);
    if has_turn { aab_sa_json_object_set_string(fp, STR_PTR("turnId"), STR_LEN("turnId"), turnId_p, turnId_len); };
    sa_json_object_set_node(fp, STR_PTR("item"), STR_LEN("item"), item);
    sa_json_object_set_node(frame, STR_PTR("params"), STR_LEN("params"), fp);
    bridge_emit_message(self, frame);
}

// handleAuggieToolCallUpdate(session, threadId, update)
fn handleAuggieToolCallUpdate(self: &AuggieAgentBridge, si: u64, update: u64) -> void {
    let toolCallId_ptr: ptr = PTR_NULL();
    let toolCallId_len: u64 = 0;
    if sa_json_object_get_string(update, STR_PTR("toolCallId"), STR_LEN("toolCallId"), &toolCallId_ptr, &toolCallId_len) != 0 || toolCallId_len == 0 { return; };
    let existing: u64 = 0;
    let has_existing = session_tc_get(&self.sessions[si], toolCallId_ptr, toolCallId_len, &existing);
    if !has_existing {
        // fall back to the message log
        for i in 0..self.sessions[si].msg_count {
            let cap_aab26184: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26184, &self.sessions[si].msg_arena, 0);
            let entry = sa_json_parse(aab_byte_off( cap_aab26184, self.sessions[si].msg_off[i]), self.sessions[si].msg_len[i]);
            if entry == 0 { continue; };
            let id_ptr: ptr = PTR_NULL();
            let id_len: u64 = 0;
            let type_ptr: ptr = PTR_NULL();
            let type_len: u64 = 0;
            if sa_json_object_get_string(entry, STR_PTR("id"), STR_LEN("id"), &id_ptr, &id_len) == 0 && id_len == toolCallId_len && aab_bytes_eq(id_ptr, toolCallId_ptr, id_len) && sa_json_object_get_string(entry, STR_PTR("type"), STR_LEN("type"), &type_ptr, &type_len) == 0 && (aab_str_is(type_ptr, type_len, STR_PTR("toolCall"), STR_LEN("toolCall")) || aab_str_is(type_ptr, type_len, STR_PTR("collabAgentToolCall"), STR_LEN("collabAgentToolCall"))) {
                existing = entry;
                has_existing = true;
                break;
            };
        }
    };
    if !has_existing { existing = 0; };
    let turnId = [0u8; 128];
    let turnId_p: ptr = PTR_NULL(); PTR_BYTE_ADD(turnId_p, &turnId, 0);
    let turnId_len: u64 = 0;
    let has_turn = false;
    if existing != 0 {
        let t_ptr: ptr = PTR_NULL();
        let t_len: u64 = 0;
        if sa_json_object_get_string(existing, STR_PTR("turnId"), STR_LEN("turnId"), &t_ptr, &t_len) == 0 && t_len > 0 {
            turnId_len = aab_buf_copy(turnId_p, 128, t_ptr, t_len);
            has_turn = true;
        };
    };
    if !has_turn && self.sessions[si].has_activeTurnId {
        let cap_aab26566: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26566, &self.sessions[si].activeTurnId, 0);
        turnId_len = aab_buf_copy(turnId_p, 128, cap_aab26566, self.sessions[si].activeTurnId_len);
        has_turn = true;
    };
    let raw_status_ptr: ptr = PTR_NULL();
    let raw_status_len: u64 = 0;
    sa_json_object_get_string(update, STR_PTR("status"), STR_LEN("status"), &raw_status_ptr, &raw_status_len);
    let status_len: u64 = 0;
    let status_ptr = mapAuggieToolStatus(raw_status_ptr, raw_status_len, &status_len);
    let payload: u64 = 0;
    if sa_json_object_get(update, STR_PTR("content"), STR_LEN("content"), &payload) != 0 || payload == 0 {
        sa_json_object_get(update, STR_PTR("rawOutput"), STR_LEN("rawOutput"), &payload);
    };
    let result_text = [0u8; 262144];
    let result_text_p: ptr = PTR_NULL(); PTR_BYTE_ADD(result_text_p, &result_text, 0);
    let result_text_len = extractAuggieResultText(payload, result_text_p, 262144);
    let was_collab = false;
    if existing != 0 {
        let type_ptr: ptr = PTR_NULL();
        let type_len: u64 = 0;
        if sa_json_object_get_string(existing, STR_PTR("type"), STR_LEN("type"), &type_ptr, &type_len) == 0 {
            was_collab = aab_str_is(type_ptr, type_len, STR_PTR("collabAgentToolCall"), STR_LEN("collabAgentToolCall"));
        };
    };
    let now_collab = was_collab || isAuggieSubagentUpdate(update);
    let title_ptr: ptr = PTR_NULL();
    let title_len: u64 = 0;
    if sa_json_object_get_string(update, STR_PTR("title"), STR_LEN("title"), &title_ptr, &title_len) != 0 || title_len == 0 {
        if existing != 0 && sa_json_object_get_string(existing, STR_PTR("toolName"), STR_LEN("toolName"), &title_ptr, &title_len) == 0 && title_len > 0 {
            // keep existing toolName
        } else {
            title_ptr = STR_PTR("Tool");
            title_len = STR_LEN("Tool");
        };
    };
    // item = {...existing, ...base, overrides}
    let item = aab_json_object_new();
    if existing != 0 {
        let text = [0u8; 262144];
        let text_p: ptr = PTR_NULL(); PTR_BYTE_ADD(text_p, &text, 0);
        let text_len = aab_stringify_into(existing, text_p, 262144);
        item = sa_json_parse(text_p, text_len);
    };
    if now_collab {
        let cap_aab27063: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab27063, &self.sessions[si].threadId, 0);
        let base = buildAuggieCollabItem( cap_aab27063, self.sessions[si].threadId_len, turnId_p, turnId_len, has_turn, toolCallId_ptr, toolCallId_len, title_ptr, title_len, update, if was_collab { existing } else { 0 });
        // spread base over the copy
        let keys = [0u8; 16384];
        let keys_p: ptr = PTR_NULL(); PTR_BYTE_ADD(keys_p, &keys, 0);
        let keys_len = aab_json_object_keys(base, keys_p, 16384);
        let pos: u64 = 0;
        while pos < keys_len {
            let kend = aab_find_byte(keys_p, keys_len, pos, 10);
            if kend == 4294967295 { kend = keys_len; };
            let v: u64 = 0;
            if sa_json_object_get(base, aab_byte_off(keys_p, pos), kend - pos, &v) == 0 {
                sa_json_object_set_node(item, aab_byte_off(keys_p, pos), kend - pos, v);
            };
            pos = kend + 1;
        }
    };
    aab_sa_json_object_set_string(item, STR_PTR("type"), STR_LEN("type"), if now_collab { STR_PTR("collabAgentToolCall") } else { STR_PTR("toolCall") }, if now_collab { STR_LEN("collabAgentToolCall") } else { STR_LEN("toolCall") });
    aab_sa_json_object_set_string(item, STR_PTR("id"), STR_LEN("id"), toolCallId_ptr, toolCallId_len);
    if has_turn { aab_sa_json_object_set_string(item, STR_PTR("turnId"), STR_LEN("turnId"), turnId_p, turnId_len); };
    let cap_aab26740: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26740, &self.sessions[si].threadId, 0);
    aab_sa_json_object_set_string(item, STR_PTR("threadId"), STR_LEN("threadId"), cap_aab26740, self.sessions[si].threadId_len);
    aab_sa_json_object_set_string(item, STR_PTR("toolName"), STR_LEN("toolName"), title_ptr, title_len);
    if existing == 0 || !has_field(existing, STR_PTR("arguments"), STR_LEN("arguments")) {
        let raw: u64 = 0;
        sa_json_object_get(update, STR_PTR("rawInput"), STR_LEN("rawInput"), &raw);
        sa_json_object_set_node(item, STR_PTR("arguments"), STR_LEN("arguments"), jsonRecord(raw));
    };
    if result_text_len > 0 {
        let result = aab_json_object_new();
        aab_sa_json_object_set_string(result, STR_PTR("content"), STR_LEN("content"), result_text_p, result_text_len);
        sa_json_object_set_node(item, STR_PTR("result"), STR_LEN("result"), result);
    };
    aab_sa_json_object_set_string(item, STR_PTR("status"), STR_LEN("status"), status_ptr, status_len);
    if now_collab && result_text_len > 0 && (aab_str_is(status_ptr, status_len, STR_PTR("completed"), STR_LEN("completed")) || aab_str_is(status_ptr, status_len, STR_PTR("failed"), STR_LEN("failed"))) {
        aab_sa_json_object_set_string(item, STR_PTR("output"), STR_LEN("output"), result_text_p, result_text_len);
        aab_sa_json_object_set_string(item, STR_PTR("agentStatus"), STR_LEN("agentStatus"), status_ptr, status_len);
    };
    session_tc_set(&self.sessions[si], toolCallId_ptr, toolCallId_len, item);
    upsertSessionItem(&self.sessions[si], item);
    self.sessions[si].lastActivityMs = aab_now_ms();
    self.sessions[si].has_lastActivityMs = true;
    if has_turn { arm_turn_silence(&self.sessions[si], turnId_p, turnId_len); };
    let frame = aab_json_object_new();
    aab_sa_json_object_set_string(frame, STR_PTR("method"), STR_LEN("method"), if aab_str_is(status_ptr, status_len, STR_PTR("inProgress"), STR_LEN("inProgress")) { STR_PTR("item/started") } else { STR_PTR("item/completed") }, if aab_str_is(status_ptr, status_len, STR_PTR("inProgress"), STR_LEN("inProgress")) { STR_LEN("item/started") } else { STR_LEN("item/completed") });
    let fp = aab_json_object_new();
    let cap_aab26741: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26741, &self.sessions[si].threadId, 0);
    aab_sa_json_object_set_string(fp, STR_PTR("threadId"), STR_LEN("threadId"), cap_aab26741, self.sessions[si].threadId_len);
    if has_turn { aab_sa_json_object_set_string(fp, STR_PTR("turnId"), STR_LEN("turnId"), turnId_p, turnId_len); };
    sa_json_object_set_node(fp, STR_PTR("item"), STR_LEN("item"), item);
    sa_json_object_set_node(frame, STR_PTR("params"), STR_LEN("params"), fp);
    bridge_emit_message(self, frame);
}

// ---- permissions ----

// approvalMethodForTool(title, toolCallId): keyword
// match over the lowercased title (the source's two
// regexes as substring scans).
fn approvalMethodForTool(title_ptr: ptr, title_len: u64, out_len: &u64) -> ptr {
    let lowered = [0u8; 1024];
    let lowered_p: ptr = PTR_NULL(); PTR_BYTE_ADD(lowered_p, &lowered, 0);
    let lowered_len = aab_to_lower(lowered_p, 1024, title_ptr, title_len);
    let exec_words = [STR_PTR("launch"), STR_PTR("process"), STR_PTR("bash"), STR_PTR("shell"), STR_PTR("terminal"), STR_PTR("exec"), STR_PTR("run")];
    let exec_words_p: ptr = PTR_NULL(); PTR_BYTE_ADD(exec_words_p, &exec_words, 0);
    let exec_lens = [STR_LEN("launch"), STR_LEN("process"), STR_LEN("bash"), STR_LEN("shell"), STR_LEN("terminal"), STR_LEN("exec"), STR_LEN("run")];
    let exec_lens_p: ptr = PTR_NULL(); PTR_BYTE_ADD(exec_lens_p, &exec_lens, 0);
    for i in 0..7 {
        if aab_find_substr(lowered_p, lowered_len, exec_words[i], exec_lens[i]) != 4294967295 {
            *out_len = STR_LEN("item/commandExecution/requestApproval");
            return STR_PTR("item/commandExecution/requestApproval");
        };
    }
    let file_words = [STR_PTR("save"), STR_PTR("write"), STR_PTR("edit"), STR_PTR("apply"), STR_PTR("patch"), STR_PTR("str-replace"), STR_PTR("file"), STR_PTR("create"), STR_PTR("delete"), STR_PTR("move"), STR_PTR("rename")];
    let file_words_p: ptr = PTR_NULL(); PTR_BYTE_ADD(file_words_p, &file_words, 0);
    let file_lens = [STR_LEN("save"), STR_LEN("write"), STR_LEN("edit"), STR_LEN("apply"), STR_LEN("patch"), STR_LEN("str-replace"), STR_LEN("file"), STR_LEN("create"), STR_LEN("delete"), STR_LEN("move"), STR_LEN("rename")];
    let file_lens_p: ptr = PTR_NULL(); PTR_BYTE_ADD(file_lens_p, &file_lens, 0);
    for i in 0..11 {
        if aab_find_substr(lowered_p, lowered_len, file_words[i], file_lens[i]) != 4294967295 {
            *out_len = STR_LEN("item/fileChange/requestApproval");
            return STR_PTR("item/fileChange/requestApproval");
        };
    }
    *out_len = STR_LEN("item/permissions/requestApproval");
    return STR_PTR("item/permissions/requestApproval");
}

// handleRequestPermission(event)
fn handleRequestPermission(self: &AuggieAgentBridge, event: u64) -> void {
    let params: u64 = 0;
    sa_json_object_get(event, STR_PTR("params"), STR_LEN("params"), &params);
    let id_json = [0u8; 64];
    let id_json_p: ptr = PTR_NULL(); PTR_BYTE_ADD(id_json_p, &id_json, 0);
    let id_json_len = event_id_json(event, id_json_p, 64);
    let sessionId_ptr: ptr = PTR_NULL();
    let sessionId_len: u64 = 0;
    if params != 0 { sa_json_object_get_string(params, STR_PTR("sessionId"), STR_LEN("sessionId"), &sessionId_ptr, &sessionId_len); };
    let thread_buf = [0u8; 128];
    let thread_buf_p: ptr = PTR_NULL(); PTR_BYTE_ADD(thread_buf_p, &thread_buf, 0);
    let thread_len: u64 = 0;
    let si = find_session_by_acp(self, sessionId_ptr, sessionId_len, thread_buf_p, &thread_len);
    if si == 4294967295 {
        let outcome = AuggiePermissionOutcome { selected: false, optionId_ptr: PTR_NULL(), optionId_len: 0 };
        let frame = [0u8; 1024];
        let frame_p: ptr = PTR_NULL(); PTR_BYTE_ADD(frame_p, &frame, 0);
        let frame_len: u64 = 0;
        auggieProtocol_buildAuggiePermissionResult(id_json_p, id_json_len, &outcome, frame_p, 1024, &frame_len);
        writeStdinText(self, frame_p, frame_len);
        return;
    };
    let toolCall: u64 = 0;
    if params != 0 { sa_json_object_get(params, STR_PTR("toolCall"), STR_LEN("toolCall"), &toolCall); };
    let title_ptr: ptr = PTR_NULL();
    let title_len: u64 = 0;
    let tc_id_ptr: ptr = PTR_NULL();
    let tc_id_len: u64 = 0;
    if toolCall != 0 {
        sa_json_object_get_string(toolCall, STR_PTR("title"), STR_LEN("title"), &title_ptr, &title_len);
        sa_json_object_get_string(toolCall, STR_PTR("toolCallId"), STR_LEN("toolCallId"), &tc_id_ptr, &tc_id_len);
    };
    let options: u64 = 0;
    if params != 0 { sa_json_object_get(params, STR_PTR("options"), STR_LEN("options"), &options); };
    // workspace-indexing consent: auto-decline
    let is_indexing = (tc_id_len == STR_LEN("workspace-indexing-permission") && aab_bytes_eq(tc_id_ptr, STR_PTR("workspace-indexing-permission"), tc_id_len)) || aab_contains_ci(title_ptr, title_len, STR_PTR("indexing permission"), STR_LEN("indexing permission"));
    if is_indexing {
        let chosen_ptr: ptr = PTR_NULL();
        let chosen_len: u64 = 0;
        let has_chosen = false;
        let oc: u64 = 0;
        if options != 0 { sa_json_value_count(options, &oc); };
        for i in 0..oc {
            let o: u64 = 0;
            sa_json_array_get(options, i, &o);
            let oid_ptr: ptr = PTR_NULL();
            let oid_len: u64 = 0;
            if o != 0 && sa_json_object_get_string(o, STR_PTR("optionId"), STR_LEN("optionId"), &oid_ptr, &oid_len) == 0 && aab_str_is(oid_ptr, oid_len, STR_PTR("always-disable"), STR_LEN("always-disable")) {
                chosen_ptr = oid_ptr;
                chosen_len = oid_len;
                has_chosen = true;
                break;
            };
        }
        if !has_chosen {
            for i in 0..oc {
                let o: u64 = 0;
                sa_json_array_get(options, i, &o);
                if o == 0 { continue; };
                let kind_ptr: ptr = PTR_NULL();
                let kind_len: u64 = 0;
                if sa_json_object_get_string(o, STR_PTR("kind"), STR_LEN("kind"), &kind_ptr, &kind_len) == 0 && aab_starts_with(kind_ptr, kind_len, STR_PTR("reject"), STR_LEN("reject")) {
                    sa_json_object_get_string(o, STR_PTR("optionId"), STR_LEN("optionId"), &chosen_ptr, &chosen_len);
                    has_chosen = chosen_len > 0;
                    break;
                };
            }
        };
        let frame = [0u8; 1024];
        let frame_p: ptr = PTR_NULL(); PTR_BYTE_ADD(frame_p, &frame, 0);
        let frame_len: u64 = 0;
        if has_chosen {
            let outcome = AuggiePermissionOutcome { selected: true, optionId_ptr: chosen_ptr, optionId_len: chosen_len };
            auggieProtocol_buildAuggiePermissionResult(id_json_p, id_json_len, &outcome, frame_p, 1024, &frame_len);
        } else {
            let outcome = AuggiePermissionOutcome { selected: false, optionId_ptr: PTR_NULL(), optionId_len: 0 };
            auggieProtocol_buildAuggiePermissionResult(id_json_p, id_json_len, &outcome, frame_p, 1024, &frame_len);
        };
        writeStdinText(self, frame_p, frame_len);
        bridge_emit_stderr(self, STR_PTR("auggie workspace-indexing permission auto-declined (indexing is disabled by design)\n"), STR_LEN("auggie workspace-indexing permission auto-declined (indexing is disabled by design)\n"));
        return;
    };
    let method_len: u64 = 0;
    let method_ptr = approvalMethodForTool(title_ptr, title_len, &method_len);
    let routed = [0u8; 160];
    let routed_p: ptr = PTR_NULL(); PTR_BYTE_ADD(routed_p, &routed, 0);
    let routed_len: u64 = 0;
    routed_len = routed_len + aab_append_bytes(routed_p, 160, routed_len, STR_PTR("auggie-perm-"), STR_LEN("auggie-perm-"));
    routed_len = routed_len + aab_append_bytes(routed_p, 160, routed_len, id_json_p, id_json_len);
    if self.pending_perm_count < 64 {
        let i = self.pending_perm_count;
        let cap_aab26486: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26486, &self.pending_perms[i].routedId, 0);
        self.pending_perms[i].routedId_len = aab_buf_copy( cap_aab26486, 160, routed_p, routed_len);
        let cap_aab26487: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26487, &self.pending_perms[i].acpId_json, 0);
        self.pending_perms[i].acpId_json_len = aab_buf_copy( cap_aab26487, 64, id_json_p, id_json_len);
        let cap_aab26488: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26488, &self.pending_perms[i].threadId, 0);
        self.pending_perms[i].threadId_len = aab_buf_copy( cap_aab26488, 128, thread_buf_p, thread_len);
        self.pending_perm_count = self.pending_perm_count + 1;
    };
    let log_doc = aab_json_object_new();
    aab_sa_json_object_set_string(log_doc, STR_PTR("kind"), STR_LEN("kind"), STR_PTR("permission-asked"), STR_LEN("permission-asked"));
    aab_sa_json_object_set_string(log_doc, STR_PTR("threadId"), STR_LEN("threadId"), thread_buf_p, thread_len);
    aab_sa_json_object_set_string(log_doc, STR_PTR("requestId"), STR_LEN("requestId"), routed_p, routed_len);
    aab_sa_json_object_set_string(log_doc, STR_PTR("title"), STR_LEN("title"), title_ptr, title_len);
    aab_sa_json_object_set_string(log_doc, STR_PTR("toolCallId"), STR_LEN("toolCallId"), tc_id_ptr, tc_id_len);
    if options != 0 { sa_json_object_set_node(log_doc, STR_PTR("options"), STR_LEN("options"), options); };
    event_log_append(self, log_doc);
    self.sessions[si].lastActivityMs = aab_now_ms();
    self.sessions[si].has_lastActivityMs = true;
    let frame = aab_json_object_new();
    aab_sa_json_object_set_string(frame, STR_PTR("id"), STR_LEN("id"), routed_p, routed_len);
    aab_sa_json_object_set_string(frame, STR_PTR("method"), STR_LEN("method"), method_ptr, method_len);
    let fp = aab_json_object_new();
    aab_sa_json_object_set_string(fp, STR_PTR("threadId"), STR_LEN("threadId"), thread_buf_p, thread_len);
    aab_sa_json_object_set_string(fp, STR_PTR("toolCallId"), STR_LEN("toolCallId"), tc_id_ptr, tc_id_len);
    aab_sa_json_object_set_string(fp, STR_PTR("title"), STR_LEN("title"), title_ptr, title_len);
    if options != 0 { sa_json_object_set_node(fp, STR_PTR("options"), STR_LEN("options"), options); };
    sa_json_object_set_node(frame, STR_PTR("params"), STR_LEN("params"), fp);
    bridge_emit_message(self, frame);
}

// ---- silence / stall finalization ----
// TURN_SILENCE_FINALIZE_MS = 10_000;
// TURN_STALL_FAIL_MS = 5 * 60_000.

fn arm_turn_silence(s: &AuggieSession, turnId_ptr: ptr, turnId_len: u64) -> void {
    s.silence_deadline = aab_now_ms() + 10000;
    let cap_aab26489: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26489, &s.silence_turn, 0);
    s.silence_turn_len = aab_buf_copy( cap_aab26489, 128, turnId_ptr, turnId_len);
    s.has_silence = true;
}

fn clear_turn_silence(s: &AuggieSession) -> void {
    s.has_silence = false;
}

fn poll_session_silence(self: &AuggieAgentBridge, si: u64) -> void {
    if !self.sessions[si].has_silence { return; };
    if aab_now_ms() < self.sessions[si].silence_deadline { return; };
    self.sessions[si].has_silence = false;
    let turnId = [0u8; 128];
    let turnId_p: ptr = PTR_NULL(); PTR_BYTE_ADD(turnId_p, &turnId, 0);
    let cap_aab26567: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26567, &self.sessions[si].silence_turn, 0);
    let turnId_len = aab_buf_copy(turnId_p, 128, cap_aab26567, self.sessions[si].silence_turn_len);
    if !self.sessions[si].has_activeTurnId { return; };
    let cap_aab26199: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26199, &self.sessions[si].activeTurnId, 0);
    if self.sessions[si].activeTurnId_len != turnId_len || !aab_bytes_eq( cap_aab26199, turnId_p, turnId_len) { return; };
    let threadId = [0u8; 128];
    let threadId_p: ptr = PTR_NULL(); PTR_BYTE_ADD(threadId_p, &threadId, 0);
    let cap_aab26568: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26568, &self.sessions[si].threadId, 0);
    let threadId_len = aab_buf_copy(threadId_p, 128, cap_aab26568, self.sessions[si].threadId_len);
    if auggieTurnHasUnsettledTools(&self.sessions[si], turnId_p, turnId_len) {
        let last = aab_now_ms(); if self.sessions[si].has_lastActivityMs { last = self.sessions[si].lastActivityMs; };
        let silent = aab_now_ms() - last;
        if silent > 300000 {
            cancel_thread_permissions(self, threadId_p, threadId_len);
            handleAuggiePromptError(self, threadId_p, threadId_len, turnId_p, turnId_len, STR_PTR("auggie turn stalled with tools still running and no activity for 5 minutes (a permission request may be waiting for an approval dialog that was never shown)"), STR_LEN("auggie turn stalled with tools still running and no activity for 5 minutes (a permission request may be waiting for an approval dialog that was never shown)"));
            return;
        };
        arm_turn_silence(&self.sessions[si], turnId_p, turnId_len);
        return;
    };
    handleAuggiePromptResult(self, threadId_p, threadId_len, turnId_p, turnId_len, aab_json_object_new());
}

// cancelThreadPermissions(threadId)
fn cancel_thread_permissions(self: &AuggieAgentBridge, threadId_ptr: ptr, threadId_len: u64) -> void {
    let i: u64 = 0;
    while i < self.pending_perm_count {
        let cap_aab26200: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26200, &self.pending_perms[i].threadId, 0);
        if self.pending_perms[i].threadId_len == threadId_len && aab_bytes_eq( cap_aab26200, threadId_ptr, threadId_len) {
            let acp_id = [0u8; 64];
            let acp_id_p: ptr = PTR_NULL(); PTR_BYTE_ADD(acp_id_p, &acp_id, 0);
            let cap_aab26569: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26569, &self.pending_perms[i].acpId_json, 0);
            let acp_id_len = aab_buf_copy(acp_id_p, 64, cap_aab26569, self.pending_perms[i].acpId_json_len);
            let outcome = AuggiePermissionOutcome { selected: false, optionId_ptr: PTR_NULL(), optionId_len: 0 };
            let frame = [0u8; 1024];
            let frame_p: ptr = PTR_NULL(); PTR_BYTE_ADD(frame_p, &frame, 0);
            let frame_len: u64 = 0;
            auggieProtocol_buildAuggiePermissionResult(acp_id_p, acp_id_len, &outcome, frame_p, 1024, &frame_len);
            writeStdinText(self, frame_p, frame_len);
            for j in i + 1..self.pending_perm_count {
                self.pending_perms[j - 1] = self.pending_perms[j];
            }
            self.pending_perm_count = self.pending_perm_count - 1;
        } else {
            i = i + 1;
        };
    }
}

// flushStreamedAssistant(session, threadId, turnId)
fn flushStreamedAssistant(self: &AuggieAgentBridge, si: u64, turnId_ptr: ptr, turnId_len: u64) -> void {
    open_text_delete(&self.sessions[si], turnId_ptr, turnId_len);
    // iterate the turn's stream rows in insertion order
    let i: u64 = 0;
    while i < self.sessions[si].stm_count {
        let cap_aab26185: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26185, &self.sessions[si].stm_turn, 0);
        if self.sessions[si].stm_turn_len[i] == turnId_len && aab_bytes_eq(aab_byte_off( cap_aab26185, self.sessions[si].stm_turn_off[i]), turnId_ptr, turnId_len) && self.sessions[si].stm_text_len[i] > 0 {
            let itemId = [0u8; 160];
            let itemId_p: ptr = PTR_NULL(); PTR_BYTE_ADD(itemId_p, &itemId, 0);
            let cap_aab26186: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26186, &self.sessions[si].stm_item, 0);
            let itemId_len = aab_buf_copy(itemId_p, 160, aab_byte_off( cap_aab26186, self.sessions[si].stm_item_off[i]), self.sessions[si].stm_item_len[i]);
            let text = [0u8; 262144];
            let cap_aab26187: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26187, &self.sessions[si].stm_text, 0);
            let cap_aab26490: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26490, &text, 0);
            let text_len = aab_buf_copy( cap_aab26490, 262144, aab_byte_off( cap_aab26187, self.sessions[si].stm_text_off[i]), self.sessions[si].stm_text_len[i]);
            self.sessions[si].stm_text_len[i] = 0;
            let item = aab_json_object_new();
            aab_sa_json_object_set_string(item, STR_PTR("type"), STR_LEN("type"), STR_PTR("agentMessage"), STR_LEN("agentMessage"));
            aab_sa_json_object_set_string(item, STR_PTR("id"), STR_LEN("id"), itemId_p, itemId_len);
            aab_sa_json_object_set_string(item, STR_PTR("turnId"), STR_LEN("turnId"), turnId_ptr, turnId_len);
            let cap_aab26742: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26742, &self.sessions[si].threadId, 0);
            aab_sa_json_object_set_string(item, STR_PTR("threadId"), STR_LEN("threadId"), cap_aab26742, self.sessions[si].threadId_len);
            let cap_aab26743: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26743, &text, 0);
            aab_sa_json_object_set_string(item, STR_PTR("content"), STR_LEN("content"), cap_aab26743, text_len);
            aab_sa_json_object_set_string(item, STR_PTR("role"), STR_LEN("role"), STR_PTR("assistant"), STR_LEN("assistant"));
            aab_sa_json_object_set_string(item, STR_PTR("status"), STR_LEN("status"), STR_PTR("completed"), STR_LEN("completed"));
            let frame = aab_json_object_new();
            aab_sa_json_object_set_string(frame, STR_PTR("method"), STR_LEN("method"), STR_PTR("item/completed"), STR_LEN("item/completed"));
            let fp = aab_json_object_new();
            let cap_aab26744: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26744, &self.sessions[si].threadId, 0);
            aab_sa_json_object_set_string(fp, STR_PTR("threadId"), STR_LEN("threadId"), cap_aab26744, self.sessions[si].threadId_len);
            aab_sa_json_object_set_string(fp, STR_PTR("turnId"), STR_LEN("turnId"), turnId_ptr, turnId_len);
            sa_json_object_set_node(fp, STR_PTR("item"), STR_LEN("item"), item);
            sa_json_object_set_node(frame, STR_PTR("params"), STR_LEN("params"), fp);
            bridge_emit_message(self, frame);
            upsertSessionItem(&self.sessions[si], item);
            let cap_aab27059: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab27059, &text, 0);
            conversation_push_assistant(&self.sessions[si], cap_aab27059, text_len);
            let cap_aab27061: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab27061, &text, 0);
            assistant_text_push(&self.sessions[si], turnId_ptr, turnId_len, cap_aab27061, text_len);
        };
        i = i + 1;
    }
}

// emitTurnUsageNotification(session, threadId, turnId)
fn emitTurnUsageNotification(self: &AuggieAgentBridge, si: u64, turnId_ptr: ptr, turnId_len: u64) -> void {
    if !self.has_redirector { return; };
    let since: i64 = 0;
    if self.sessions[si].has_turnStartedAtMs { since = self.sessions[si].turnStartedAtMs; };
    self.sessions[si].has_turnStartedAtMs = false;
    let records = [0u8; 262144];
    let records_p: ptr = PTR_NULL(); PTR_BYTE_ADD(records_p, &records, 0);
    let records_len: u64 = 0;
    let taken = takeAuggieUpstreamUsage(&self.redirector, since, records_p, 262144, &records_len);
    if taken == 0 { return; };
    let aggregate = [0u8; 1024];
    let aggregate_p: ptr = PTR_NULL(); PTR_BYTE_ADD(aggregate_p, &aggregate, 0);
    let is_null = true;
    let aggregate_len = aggregateAuggieUsageRecords(records_p, records_len, aggregate_p, 1024, &is_null);
    if is_null { return; };
    let agg_doc = sa_json_parse(aggregate_p, aggregate_len);
    if agg_doc == 0 { return; };
    let usage = aab_json_object_new();
    let v: i64 = 0;
    if aab_json_node_number(agg_doc, STR_PTR("promptTokens"), STR_LEN("promptTokens"), &v) { aab_sa_json_object_set_number(usage, STR_PTR("prompt_tokens"), STR_LEN("prompt_tokens"), v); };
    if aab_json_node_number(agg_doc, STR_PTR("completionTokens"), STR_LEN("completionTokens"), &v) { aab_sa_json_object_set_number(usage, STR_PTR("completion_tokens"), STR_LEN("completion_tokens"), v); };
    if aab_json_node_number(agg_doc, STR_PTR("totalTokens"), STR_LEN("totalTokens"), &v) { aab_sa_json_object_set_number(usage, STR_PTR("total_tokens"), STR_LEN("total_tokens"), v); };
    if aab_json_node_number(agg_doc, STR_PTR("cachedInputTokens"), STR_LEN("cachedInputTokens"), &v) {
        let details = aab_json_object_new();
        aab_sa_json_object_set_number(details, STR_PTR("cached_tokens"), STR_LEN("cached_tokens"), v);
        sa_json_object_set_node(usage, STR_PTR("prompt_tokens_details"), STR_LEN("prompt_tokens_details"), details);
    };
    if aab_json_node_number(agg_doc, STR_PTR("reasoningOutputTokens"), STR_LEN("reasoningOutputTokens"), &v) {
        let details = aab_json_object_new();
        aab_sa_json_object_set_number(details, STR_PTR("reasoning_tokens"), STR_LEN("reasoning_tokens"), v);
        sa_json_object_set_node(usage, STR_PTR("completion_tokens_details"), STR_LEN("completion_tokens_details"), details);
    };
    let frame = aab_json_object_new();
    aab_sa_json_object_set_string(frame, STR_PTR("method"), STR_LEN("method"), STR_PTR("thread/tokenUsage/requestUpdated"), STR_LEN("thread/tokenUsage/requestUpdated"));
    let fp = aab_json_object_new();
    let cap_aab26745: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26745, &self.sessions[si].threadId, 0);
    aab_sa_json_object_set_string(fp, STR_PTR("threadId"), STR_LEN("threadId"), cap_aab26745, self.sessions[si].threadId_len);
    aab_sa_json_object_set_string(fp, STR_PTR("turnId"), STR_LEN("turnId"), turnId_ptr, turnId_len);
    let request_id = [0u8; 256];
    let request_id_p: ptr = PTR_NULL(); PTR_BYTE_ADD(request_id_p, &request_id, 0);
    let request_id_len: u64 = 0;
    request_id_len = request_id_len + aab_append_bytes(request_id_p, 256, request_id_len, STR_PTR("auggie-turn-"), STR_LEN("auggie-turn-"));
    request_id_len = request_id_len + aab_append_bytes(request_id_p, 256, request_id_len, turnId_ptr, turnId_len);
    aab_sa_json_object_set_string(fp, STR_PTR("requestId"), STR_LEN("requestId"), request_id_p, request_id_len);
    sa_json_object_set_node(fp, STR_PTR("usage"), STR_LEN("usage"), usage);
    sa_json_object_set_node(frame, STR_PTR("params"), STR_LEN("params"), fp);
    bridge_emit_message(self, frame);
}

// handleAuggiePromptResult(threadId, turnId, result)
fn handleAuggiePromptResult(self: &AuggieAgentBridge, threadId_ptr: ptr, threadId_len: u64, turnId_ptr: ptr, turnId_len: u64, result: u64) -> void {
    let si = find_session(self, threadId_ptr, threadId_len);
    if si == 4294967295 { return; };
    if !self.sessions[si].has_activeTurnId { return; };
    let cap_aab26201: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26201, &self.sessions[si].activeTurnId, 0);
    if self.sessions[si].activeTurnId_len != turnId_len || !aab_bytes_eq( cap_aab26201, turnId_ptr, turnId_len) { return; };
    clear_turn_silence(&self.sessions[si]);
    flushStreamedAssistant(self, si, turnId_ptr, turnId_len);
    self.sessions[si].has_activeTurnId = false;
    for i in 0..self.sessions[si].turn_count {
        let cap_aab26202: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26202, &self.sessions[si].turns[i].id, 0);
        if self.sessions[si].turns[i].id_len == turnId_len && aab_bytes_eq( cap_aab26202, turnId_ptr, turnId_len) {
            let cap_aab26491: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26491, &self.sessions[si].turns[i].status, 0);
            self.sessions[si].turns[i].status_len = aab_buf_copy( cap_aab26491, 32, STR_PTR("completed"), STR_LEN("completed"));
            break;
        };
    }
    emitTurnUsageNotification(self, si, turnId_ptr, turnId_len);
    let frame = aab_json_object_new();
    aab_sa_json_object_set_string(frame, STR_PTR("method"), STR_LEN("method"), STR_PTR("turn/completed"), STR_LEN("turn/completed"));
    let fp = aab_json_object_new();
    aab_sa_json_object_set_string(fp, STR_PTR("threadId"), STR_LEN("threadId"), threadId_ptr, threadId_len);
    aab_sa_json_object_set_string(fp, STR_PTR("turnId"), STR_LEN("turnId"), turnId_ptr, turnId_len);
    let turn = aab_json_object_new();
    aab_sa_json_object_set_string(turn, STR_PTR("id"), STR_LEN("id"), turnId_ptr, turnId_len);
    aab_sa_json_object_set_string(turn, STR_PTR("threadId"), STR_LEN("threadId"), threadId_ptr, threadId_len);
    aab_sa_json_object_set_string(turn, STR_PTR("status"), STR_LEN("status"), STR_PTR("completed"), STR_LEN("completed"));
    aab_sa_json_object_set_number(turn, STR_PTR("completedAt"), STR_LEN("completedAt"), aab_now_ms() / 1000);
    sa_json_object_set_node(fp, STR_PTR("turn"), STR_LEN("turn"), turn);
    sa_json_object_set_node(frame, STR_PTR("params"), STR_LEN("params"), fp);
    bridge_emit_message(self, frame);
}

// handleAuggiePromptError(threadId, turnId, error text)
fn handleAuggiePromptError(self: &AuggieAgentBridge, threadId_ptr: ptr, threadId_len: u64, turnId_ptr: ptr, turnId_len: u64, err_ptr: ptr, err_len: u64) -> void {
    let log_doc = aab_json_object_new();
    aab_sa_json_object_set_string(log_doc, STR_PTR("kind"), STR_LEN("kind"), STR_PTR("turn-failed"), STR_LEN("turn-failed"));
    aab_sa_json_object_set_string(log_doc, STR_PTR("threadId"), STR_LEN("threadId"), threadId_ptr, threadId_len);
    aab_sa_json_object_set_string(log_doc, STR_PTR("turnId"), STR_LEN("turnId"), turnId_ptr, turnId_len);
    let clipped = err_len;
    if clipped > 500 { clipped = 500; };
    aab_sa_json_object_set_string(log_doc, STR_PTR("error"), STR_LEN("error"), err_ptr, clipped);
    event_log_append(self, log_doc);
    let si = find_session(self, threadId_ptr, threadId_len);
    if si == 4294967295 { return; };
    let cap_aab26203: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26203, &self.sessions[si].activeTurnId, 0);
    if self.sessions[si].has_activeTurnId && self.sessions[si].activeTurnId_len == turnId_len && aab_bytes_eq( cap_aab26203, turnId_ptr, turnId_len) {
        flushStreamedAssistant(self, si, turnId_ptr, turnId_len);
        emitTurnUsageNotification(self, si, turnId_ptr, turnId_len);
        self.sessions[si].has_activeTurnId = false;
    };
    for i in 0..self.sessions[si].turn_count {
        let cap_aab26204: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26204, &self.sessions[si].turns[i].id, 0);
        if self.sessions[si].turns[i].id_len == turnId_len && aab_bytes_eq( cap_aab26204, turnId_ptr, turnId_len) {
            let cap_aab26492: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26492, &self.sessions[si].turns[i].status, 0);
            self.sessions[si].turns[i].status_len = aab_buf_copy( cap_aab26492, 32, STR_PTR("failed"), STR_LEN("failed"));
            break;
        };
    }
    let frame = aab_json_object_new();
    aab_sa_json_object_set_string(frame, STR_PTR("method"), STR_LEN("method"), STR_PTR("turn/failed"), STR_LEN("turn/failed"));
    let fp = aab_json_object_new();
    aab_sa_json_object_set_string(fp, STR_PTR("threadId"), STR_LEN("threadId"), threadId_ptr, threadId_len);
    aab_sa_json_object_set_string(fp, STR_PTR("turnId"), STR_LEN("turnId"), turnId_ptr, turnId_len);
    let turn = aab_json_object_new();
    aab_sa_json_object_set_string(turn, STR_PTR("id"), STR_LEN("id"), turnId_ptr, turnId_len);
    aab_sa_json_object_set_string(turn, STR_PTR("threadId"), STR_LEN("threadId"), threadId_ptr, threadId_len);
    aab_sa_json_object_set_string(turn, STR_PTR("status"), STR_LEN("status"), STR_PTR("failed"), STR_LEN("failed"));
    sa_json_object_set_node(fp, STR_PTR("turn"), STR_LEN("turn"), turn);
    aab_sa_json_object_set_string(fp, STR_PTR("error"), STR_LEN("error"), err_ptr, err_len);
    sa_json_object_set_node(frame, STR_PTR("params"), STR_LEN("params"), fp);
    bridge_emit_message(self, frame);
}

// invalidateChild(message)
fn invalidateChild(self: &AuggieAgentBridge, msg_ptr: ptr, msg_len: u64) -> void {
    if !self.has_child && !(self.child_exited) { return; };
    for i in 0..self.pending_count {
        if self.pending[i].status == 0 {
            self.pending[i].status = 2;
            let cap_aab26493: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26493, &self.pending[i].err, 0);
            self.pending[i].err_len = aab_buf_copy( cap_aab26493, 1024, msg_ptr, msg_len);
        };
    }
    self.pending_perm_count = 0;
    for si in 0..self.session_count {
        if self.sessions[si].has_activeTurnId {
            let turnId = [0u8; 128];
            let turnId_p: ptr = PTR_NULL(); PTR_BYTE_ADD(turnId_p, &turnId, 0);
            let cap_aab26570: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26570, &self.sessions[si].activeTurnId, 0);
            let turnId_len = aab_buf_copy(turnId_p, 128, cap_aab26570, self.sessions[si].activeTurnId_len);
            let threadId = [0u8; 128];
            let threadId_p: ptr = PTR_NULL(); PTR_BYTE_ADD(threadId_p, &threadId, 0);
            let cap_aab26571: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26571, &self.sessions[si].threadId, 0);
            let threadId_len = aab_buf_copy(threadId_p, 128, cap_aab26571, self.sessions[si].threadId_len);
            self.sessions[si].has_activeTurnId = false;
            for i in 0..self.sessions[si].turn_count {
                let cap_aab26205: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26205, &self.sessions[si].turns[i].id, 0);
                if self.sessions[si].turns[i].id_len == turnId_len && aab_bytes_eq( cap_aab26205, turnId_p, turnId_len) {
                    let cap_aab26494: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26494, &self.sessions[si].turns[i].status, 0);
                    self.sessions[si].turns[i].status_len = aab_buf_copy( cap_aab26494, 32, STR_PTR("failed"), STR_LEN("failed"));
                    break;
                };
            }
            emitTurnUsageNotification(self, si, turnId_p, turnId_len);
            let frame = aab_json_object_new();
            aab_sa_json_object_set_string(frame, STR_PTR("method"), STR_LEN("method"), STR_PTR("turn/failed"), STR_LEN("turn/failed"));
            let fp = aab_json_object_new();
            aab_sa_json_object_set_string(fp, STR_PTR("threadId"), STR_LEN("threadId"), threadId_p, threadId_len);
            aab_sa_json_object_set_string(fp, STR_PTR("turnId"), STR_LEN("turnId"), turnId_p, turnId_len);
            let turn = aab_json_object_new();
            aab_sa_json_object_set_string(turn, STR_PTR("id"), STR_LEN("id"), turnId_p, turnId_len);
            aab_sa_json_object_set_string(turn, STR_PTR("threadId"), STR_LEN("threadId"), threadId_p, threadId_len);
            aab_sa_json_object_set_string(turn, STR_PTR("status"), STR_LEN("status"), STR_PTR("failed"), STR_LEN("failed"));
            sa_json_object_set_node(fp, STR_PTR("turn"), STR_LEN("turn"), turn);
            aab_sa_json_object_set_string(fp, STR_PTR("error"), STR_LEN("error"), msg_ptr, msg_len);
            sa_json_object_set_node(frame, STR_PTR("params"), STR_LEN("params"), fp);
            bridge_emit_message(self, frame);
        };
    }
    self.has_child = false;
    let cap_aab26526: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26526, &self.status_phase, 0);
    if !aab_str_is( cap_aab26526, self.status_phase_len, STR_PTR("stopped"), STR_LEN("stopped")) {
        set_status(self, STR_PTR("error"), STR_LEN("error"), msg_ptr, msg_len, true, 0, false);
    };
}

// ---- restore-on-reconnect ----

// AuggieStoredSessionSummary rows travel as JSON text:
// [{sessionId, cwd?}].
fn extractAuggieStoredSessions(result: u64, out: ptr, out_cap: u64) -> u64 {
    let record = jsonRecord(result);
    let raw_list: u64 = 0;
    let is_arr = false;
    if result != 0 { aab_json_node_is_array(result, &is_arr); };
    if is_arr {
        raw_list = result;
    } else if sa_json_object_get(record, STR_PTR("sessions"), STR_LEN("sessions"), &raw_list) != 0 || raw_list == 0 {
        sa_json_object_get(record, STR_PTR("data"), STR_LEN("data"), &raw_list);
    };
    let out_arr = aab_json_array_new();
    let count: u64 = 0;
    if raw_list != 0 { sa_json_value_count(raw_list, &count); };
    for i in 0..count {
        let entry: u64 = 0;
        sa_json_array_get(raw_list, i, &entry);
        if entry == 0 { continue; };
        let is_obj = false;
        aab_json_node_is_object(entry, &is_obj);
        if !is_obj { continue; };
        let sid_ptr: ptr = PTR_NULL();
        let sid_len: u64 = 0;
        let has_sid = false;
        if sa_json_object_get_string(entry, STR_PTR("sessionId"), STR_LEN("sessionId"), &sid_ptr, &sid_len) == 0 && sid_len > 0 { has_sid = true; } else if sa_json_object_get_string(entry, STR_PTR("id"), STR_LEN("id"), &sid_ptr, &sid_len) == 0 && sid_len > 0 { has_sid = true; } else if sa_json_object_get_string(entry, STR_PTR("conversationId"), STR_LEN("conversationId"), &sid_ptr, &sid_len) == 0 && sid_len > 0 { has_sid = true; };
        if !has_sid { continue; };
        let summary = aab_json_object_new();
        aab_sa_json_object_set_string(summary, STR_PTR("sessionId"), STR_LEN("sessionId"), sid_ptr, sid_len);
        let cwd_ptr: ptr = PTR_NULL();
        let cwd_len: u64 = 0;
        if sa_json_object_get_string(entry, STR_PTR("cwd"), STR_LEN("cwd"), &cwd_ptr, &cwd_len) == 0 && cwd_len > 0 {
            aab_sa_json_object_set_string(summary, STR_PTR("cwd"), STR_LEN("cwd"), cwd_ptr, cwd_len);
        };
        sa_json_array_push_node(out_arr, summary);
    }
    return aab_stringify_into(out_arr, out, out_cap);
}

// pickAuggieRestoreCandidate(candidates text,
// requestedExternalId?, cwd?) -> candidate index or
// none (out_found).
fn pickAuggieRestoreCandidate(candidates_ptr: ptr, candidates_len: u64, requested_ptr: ptr, requested_len: u64, has_requested: bool, cwd_ptr: ptr, cwd_len: u64, has_cwd: bool, out_idx: &u64) -> bool {
    let doc = sa_json_parse(candidates_ptr, candidates_len);
    let count: u64 = 0;
    if doc != 0 { sa_json_value_count(doc, &count); };
    if has_requested {
        for i in 0..count {
            let e: u64 = 0;
            sa_json_array_get(doc, i, &e);
            let p: ptr = PTR_NULL();
            let l: u64 = 0;
            if e != 0 && sa_json_object_get_string(e, STR_PTR("sessionId"), STR_LEN("sessionId"), &p, &l) == 0 && l == requested_len && aab_bytes_eq(p, requested_ptr, l) {
                *out_idx = i;
                return true;
            };
        }
    };
    if has_cwd {
        for i in 0..count {
            let e: u64 = 0;
            sa_json_array_get(doc, i, &e);
            let p: ptr = PTR_NULL();
            let l: u64 = 0;
            if e != 0 && sa_json_object_get_string(e, STR_PTR("cwd"), STR_LEN("cwd"), &p, &l) == 0 && l == cwd_len && aab_bytes_eq(p, cwd_ptr, l) {
                *out_idx = i;
                return true;
            };
        }
    };
    if count == 1 {
        *out_idx = 0;
        return true;
    };
    return false;
}

// restoreAuggieThreadFromDisk(threadId, params) ->
// session index or none. Errors are logged and yield
// none (the caller keeps the "Unknown thread" failure).
fn restoreAuggieThreadFromDisk(self: &AuggieAgentBridge, threadId_ptr: ptr, threadId_len: u64, params: u64, out_si: &u64) -> bool {
    *out_si = 4294967295;
    let status_buf = [0u8; 2048];
    let status_buf_p: ptr = PTR_NULL(); PTR_BYTE_ADD(status_buf_p, &status_buf, 0);
    let start_err: i32 = 0;
    AuggieAgentBridge_start(self, status_buf_p, 2048, &start_err);
    if start_err != 0 { return false; };
    let message = aab_json_object_new();
    aab_sa_json_object_set_string(message, STR_PTR("method"), STR_LEN("method"), AUGGIE_METHOD_sessionList(), STR_LEN("session/list"));
    let result = [0u8; 262144];
    let result_p: ptr = PTR_NULL(); PTR_BYTE_ADD(result_p, &result, 0);
    let result_len: u64 = 0;
    let err = [0u8; 1024];
    let err_p: ptr = PTR_NULL(); PTR_BYTE_ADD(err_p, &err, 0);
    let err_len: u64 = 0;
    send_request_sync(self, message, 30000, result_p, 262144, &result_len, err_p, 1024, &err_len);
    if err_len > 0 {
        restore_fail(self, err_p, err_len);
        return false;
    };
    let result_doc = sa_json_parse(result_p, result_len);
    let candidates = [0u8; 262144];
    let candidates_p: ptr = PTR_NULL(); PTR_BYTE_ADD(candidates_p, &candidates, 0);
    let candidates_len = extractAuggieStoredSessions(result_doc, candidates_p, 262144);
    let candidates_doc = sa_json_parse(candidates_p, candidates_len);
    let count: u64 = 0;
    if candidates_doc != 0 { sa_json_value_count(candidates_doc, &count); };
    if count == 0 { return false; };
    let requested_ptr: ptr = PTR_NULL();
    let requested_len: u64 = 0;
    let has_requested = false;
    let p = jsonRecord(params);
    if sa_json_object_get_string(p, STR_PTR("externalSessionId"), STR_LEN("externalSessionId"), &requested_ptr, &requested_len) == 0 && requested_len > 0 { has_requested = true; } else if sa_json_object_get_string(p, STR_PTR("sessionId"), STR_LEN("sessionId"), &requested_ptr, &requested_len) == 0 && requested_len > 0 { has_requested = true; };
    let cwd_ptr: ptr = PTR_NULL();
    let cwd_len: u64 = 0;
    let has_cwd = false;
    if sa_json_object_get_string(p, STR_PTR("cwd"), STR_LEN("cwd"), &cwd_ptr, &cwd_len) == 0 && cwd_len > 0 { has_cwd = true; } else if self.has_configuredCwd { let cap_aabC: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aabC, &self.configuredCwd, 0); cwd_ptr = cap_aabC; cwd_len = self.configuredCwd_len; has_cwd = true; };
    let cand_idx: u64 = 0;
    if !pickAuggieRestoreCandidate(candidates_p, candidates_len, requested_ptr, requested_len, has_requested, cwd_ptr, cwd_len, has_cwd, &cand_idx) {
        return false;
    };
    let cand: u64 = 0;
    sa_json_array_get(candidates_doc, cand_idx, &cand);
    let cand_sid_ptr: ptr = PTR_NULL();
    let cand_sid_len: u64 = 0;
    sa_json_object_get_string(cand, STR_PTR("sessionId"), STR_LEN("sessionId"), &cand_sid_ptr, &cand_sid_len);
    let cand_cwd_ptr: ptr = PTR_NULL();
    let cand_cwd_len: u64 = 0;
    let has_cand_cwd = sa_json_object_get_string(cand, STR_PTR("cwd"), STR_LEN("cwd"), &cand_cwd_ptr, &cand_cwd_len) == 0 && cand_cwd_len > 0;
    // pre-create the session record + mapping
    if self.session_count >= 16 { return false; };
    let si = self.session_count;
    session_init(&self.sessions[si], threadId_ptr, threadId_len);
    self.session_count = self.session_count + 1;
    if self.has_configuredModel {
        let cap_aab26495: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26495, &self.sessions[si].model, 0);
        let cap_aab26572: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26572, &self.configuredModel, 0);
        self.sessions[si].model_len = aab_buf_copy( cap_aab26495, 256, cap_aab26572, self.configuredModel_len);
        self.sessions[si].has_model = true;
    };
    let cap_aab26496: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26496, &self.sessions[si].permissionMode, 0);
    self.sessions[si].permissionMode_len = aab_buf_copy( cap_aab26496, 64, STR_PTR("on-request"), STR_LEN("on-request"));
    if has_cand_cwd {
        let cap_aab26497: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26497, &self.sessions[si].cwd, 0);
        self.sessions[si].cwd_len = aab_buf_copy( cap_aab26497, 1024, cand_cwd_ptr, cand_cwd_len);
        self.sessions[si].has_cwd = true;
    } else if has_cwd {
        let cap_aab26498: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26498, &self.sessions[si].cwd, 0);
        self.sessions[si].cwd_len = aab_buf_copy( cap_aab26498, 1024, cwd_ptr, cwd_len);
        self.sessions[si].has_cwd = true;
    };
    self.sessions[si].created_at = aab_now_ms();
    let cap_aab26499: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26499, &self.sessions[si].externalSessionId, 0);
    self.sessions[si].externalSessionId_len = aab_buf_copy( cap_aab26499, 128, cand_sid_ptr, cand_sid_len);
    self.sessions[si].has_externalSessionId = true;
    self.sessions[si].has_restoreCollector = true;
    self.sessions[si].rc_count = 0;
    map_session(self, cand_sid_ptr, cand_sid_len, threadId_ptr, threadId_len);
    // session/load
    let load = aab_json_object_new();
    aab_sa_json_object_set_string(load, STR_PTR("method"), STR_LEN("method"), AUGGIE_METHOD_sessionLoad(), STR_LEN("session/load"));
    let lp = aab_json_object_new();
    aab_sa_json_object_set_string(lp, STR_PTR("sessionId"), STR_LEN("sessionId"), cand_sid_ptr, cand_sid_len);
    let load_cwd = [0u8; 1024];
    let load_cwd_p: ptr = PTR_NULL(); PTR_BYTE_ADD(load_cwd_p, &load_cwd, 0);
    let load_cwd_len: u64 = 0;
    if has_cand_cwd { load_cwd_len = aab_buf_copy(load_cwd_p, 1024, cand_cwd_ptr, cand_cwd_len); } else if has_cwd { load_cwd_len = aab_buf_copy(load_cwd_p, 1024, cwd_ptr, cwd_len); } else { load_cwd_len = process_cwd(load_cwd_p, 1024); };
    aab_sa_json_object_set_string(lp, STR_PTR("cwd"), STR_LEN("cwd"), load_cwd_p, load_cwd_len);
    sa_json_object_set_node(load, STR_PTR("params"), STR_LEN("params"), lp);
    let lresult = [0u8; 4096];
    let lresult_p: ptr = PTR_NULL(); PTR_BYTE_ADD(lresult_p, &lresult, 0);
    let lresult_len: u64 = 0;
    let lerr = [0u8; 1024];
    let lerr_p: ptr = PTR_NULL(); PTR_BYTE_ADD(lerr_p, &lerr, 0);
    let lerr_len: u64 = 0;
    send_request_sync(self, load, 120000, lresult_p, 4096, &lresult_len, lerr_p, 1024, &lerr_len);
    if lerr_len > 0 {
        // roll back the pre-created record
        for i in si + 1..self.session_count {
            self.sessions[i - 1] = self.sessions[i];
        }
        self.session_count = self.session_count - 1;
        unmap_thread(self, threadId_ptr, threadId_len);
        restore_fail(self, lerr_p, lerr_len);
        return false;
    };
    finalizeRestoredSession(self, si);
    *out_si = si;
    return true;
}

fn restore_fail(self: &AuggieAgentBridge, err_ptr: ptr, err_len: u64) -> void {
    let note = [0u8; 2048];
    let note_p: ptr = PTR_NULL(); PTR_BYTE_ADD(note_p, &note, 0);
    let note_len: u64 = 0;
    note_len = note_len + aab_append_bytes(note_p, 2048, note_len, STR_PTR("auggie restart recovery failed: "), STR_LEN("auggie restart recovery failed: "));
    note_len = note_len + aab_append_bytes(note_p, 2048, note_len, err_ptr, err_len);
    note_len = note_len + aab_append_bytes(note_p, 2048, note_len, STR_PTR("\n"), 1);
    bridge_emit_stderr(self, note_p, note_len);
}

// session_init: zero a session slot and set threadId.
fn session_init(s: &AuggieSession, threadId_ptr: ptr, threadId_len: u64) -> void {
    let cap_aab26500: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26500, &s.threadId, 0);
    s.threadId_len = aab_buf_copy( cap_aab26500, 128, threadId_ptr, threadId_len);
    s.has_parentThreadId = false;
    s.parentThreadId_len = 0;
    s.has_agentNickname = false;
    s.agentNickname_len = 0;
    s.has_agentRole = false;
    s.agentRole_len = 0;
    s.has_preview = false;
    s.preview_len = 0;
    s.has_model = false;
    s.model_len = 0;
    s.permissionMode_len = 0;
    s.has_cwd = false;
    s.cwd_len = 0;
    s.created_at = 0;
    s.has_externalSessionId = false;
    s.externalSessionId_len = 0;
    s.turn_count = 0;
    s.has_turnStartedAtMs = false;
    s.has_activeTurnId = false;
    s.activeTurnId_len = 0;
    s.msg_count = 0;
    s.msg_used = 0;
    s.abt_count = 0;
    s.abt_text_used = 0;
    s.abt_turn_used = 0;
    s.stm_count = 0;
    s.stm_turn_used = 0;
    s.stm_item_used = 0;
    s.stm_text_used = 0;
    s.ot_count = 0;
    s.ot_turn_used = 0;
    s.ot_item_used = 0;
    s.seg_count = 0;
    s.seg_turn_used = 0;
    s.conv_count = 0;
    s.conv_text_used = 0;
    s.tc_count = 0;
    s.tc_id_used = 0;
    s.tc_item_used = 0;
    s.rc_count = 0;
    s.rc_text_used = 0;
    s.has_restoreCollector = false;
    s.has_silence = false;
    s.has_lastActivityMs = false;
    s.lastActivityMs = 0;
}

// finalizeRestoredSession(session, threadId)
fn finalizeRestoredSession(self: &AuggieAgentBridge, si: u64) -> void {
    self.sessions[si].has_restoreCollector = false;
    let turnId = [0u8; 192];
    let turnId_p: ptr = PTR_NULL(); PTR_BYTE_ADD(turnId_p, &turnId, 0);
    let turnId_len: u64 = 0;
    turnId_len = turnId_len + aab_append_bytes(turnId_p, 192, turnId_len, STR_PTR("auggie-restored-"), STR_LEN("auggie-restored-"));
    let uid = [0u8; 64];
    let uid_p: ptr = PTR_NULL(); PTR_BYTE_ADD(uid_p, &uid, 0);
    let uid_len = aab_uuid_new(uid_p, 64);
    turnId_len = turnId_len + aab_append_bytes(turnId_p, 192, turnId_len, uid_p, uid_len);
    let started_at = self.sessions[si].created_at / 1000;
    if self.sessions[si].turn_count < 128 {
        let ti = self.sessions[si].turn_count;
        let cap_aab26501: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26501, &self.sessions[si].turns[ti].id, 0);
        self.sessions[si].turns[ti].id_len = aab_buf_copy( cap_aab26501, 128, turnId_p, turnId_len);
        let cap_aab26502: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26502, &self.sessions[si].turns[ti].status, 0);
        self.sessions[si].turns[ti].status_len = aab_buf_copy( cap_aab26502, 32, STR_PTR("completed"), STR_LEN("completed"));
        self.sessions[si].turns[ti].created_at = self.sessions[si].created_at;
        self.sessions[si].turn_count = self.sessions[si].turn_count + 1;
    };
    let first_user_text = [0u8; 262144];
    let first_user_text_p: ptr = PTR_NULL(); PTR_BYTE_ADD(first_user_text_p, &first_user_text, 0);
    let first_user_len: u64 = 0;
    let has_first_user = false;
    for i in 0..self.sessions[si].rc_count {
        let role = self.sessions[si].rc_role[i];
        let cap_aab26188: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26188, &self.sessions[si].rc_text, 0);
        let text_ptr = aab_byte_off( cap_aab26188, self.sessions[si].rc_text_off[i]);
        let text_len = self.sessions[si].rc_text_len[i];
        let normalized = [0u8; 262144];
        let normalized_p: ptr = PTR_NULL(); PTR_BYTE_ADD(normalized_p, &normalized, 0);
        let normalized_len = normalizeAssistantText(text_ptr, text_len, normalized_p, 262144);
        if normalized_len == 0 { continue; };
        let item = aab_json_object_new();
        let id_prefix = if role == 0 { STR_PTR("auggie-user-") } else { STR_PTR("auggie-assistant-") };
        let id_prefix_len = if role == 0 { STR_LEN("auggie-user-") } else { STR_LEN("auggie-assistant-") };
        let item_id = [0u8; 192];
        let item_id_p: ptr = PTR_NULL(); PTR_BYTE_ADD(item_id_p, &item_id, 0);
        let item_id_len: u64 = 0;
        item_id_len = item_id_len + aab_append_bytes(item_id_p, 192, item_id_len, id_prefix, id_prefix_len);
        let uid2 = [0u8; 64];
        let uid2_p: ptr = PTR_NULL(); PTR_BYTE_ADD(uid2_p, &uid2, 0);
        let uid2_len = aab_uuid_new(uid2_p, 64);
        item_id_len = item_id_len + aab_append_bytes(item_id_p, 192, item_id_len, uid2_p, uid2_len);
        aab_sa_json_object_set_string(item, STR_PTR("type"), STR_LEN("type"), if role == 0 { STR_PTR("userMessage") } else { STR_PTR("agentMessage") }, if role == 0 { STR_LEN("userMessage") } else { STR_LEN("agentMessage") });
        aab_sa_json_object_set_string(item, STR_PTR("id"), STR_LEN("id"), item_id_p, item_id_len);
        aab_sa_json_object_set_string(item, STR_PTR("turnId"), STR_LEN("turnId"), turnId_p, turnId_len);
        let cap_aab26746: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26746, &self.sessions[si].threadId, 0);
        aab_sa_json_object_set_string(item, STR_PTR("threadId"), STR_LEN("threadId"), cap_aab26746, self.sessions[si].threadId_len);
        if role == 0 {
            let content = aab_json_array_new();
            let block = aab_json_object_new();
            aab_sa_json_object_set_string(block, STR_PTR("type"), STR_LEN("type"), STR_PTR("text"), STR_LEN("text"));
            aab_sa_json_object_set_string(block, STR_PTR("text"), STR_LEN("text"), text_ptr, text_len);
            sa_json_object_set_node(block, STR_PTR("text_elements"), STR_LEN("text_elements"), aab_json_array_new());
            sa_json_array_push_node(content, block);
            sa_json_object_set_node(item, STR_PTR("content"), STR_LEN("content"), content);
            aab_sa_json_object_set_number(item, STR_PTR("startedAt"), STR_LEN("startedAt"), started_at);
            if !has_first_user {
                first_user_len = aab_buf_copy(first_user_text_p, 262144, text_ptr, text_len);
                has_first_user = true;
            };
        } else {let _ifd4 = 
            aab_sa_json_object_set_string(item, STR_PTR("content"), STR_LEN("content"), normalized_p, normalized_len);
        };
        aab_sa_json_object_set_string(item, STR_PTR("role"), STR_LEN("role"), if role == 0 { STR_PTR("user") } else { STR_PTR("assistant") }, if role == 0 { STR_LEN("user") } else { STR_LEN("assistant") });
        aab_sa_json_object_set_string(item, STR_PTR("status"), STR_LEN("status"), STR_PTR("completed"), STR_LEN("completed"));
        let item_text = [0u8; 262144];
        let item_text_p: ptr = PTR_NULL(); PTR_BYTE_ADD(item_text_p, &item_text, 0);
        let item_text_len = aab_stringify_into(item, item_text_p, 262144);
        session_msg_push(&self.sessions[si], item_text_p, item_text_len);
        if role == 0 {
            conversation_push_user(&self.sessions[si], normalized_p, normalized_len);
        } else {
            // conversation.push with normalized text —
            // the dedupe in conversation_push_assistant
            // applies to live segments; replay appends
            // directly (source pushes unconditionally).
            if self.sessions[si].conv_count < 512 {
                let ci = self.sessions[si].conv_count;
                self.sessions[si].conv_role[ci] = 1;
                self.sessions[si].conv_text_off[ci] = self.sessions[si].conv_text_used;
                self.sessions[si].conv_text_len[ci] = normalized_len;
                let cap_ab35: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ab35, &self.sessions[si].conv_text, 0);
                self.sessions[si].conv_text_used = self.sessions[si].conv_text_used + aab_append_bytes(cap_ab35, 524288, self.sessions[si].conv_text_used, normalized_p, normalized_len);
                self.sessions[si].conv_count = self.sessions[si].conv_count + 1;
            };
        };
    }
    if has_first_user && !self.sessions[si].has_preview {
        let normalized = [0u8; 262144];
        let normalized_p: ptr = PTR_NULL(); PTR_BYTE_ADD(normalized_p, &normalized, 0);
        let normalized_len = normalizeAssistantText(first_user_text_p, first_user_len, normalized_p, 262144);
        let take = normalized_len;
        if take > 120 { take = 120; };
        let cap_aab26503: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26503, &self.sessions[si].preview, 0);
        self.sessions[si].preview_len = aab_buf_copy( cap_aab26503, 1024, normalized_p, take);
        self.sessions[si].has_preview = true;
    };
}

// ---- turn input extraction ----

// AuggieTurnInput travels as: text slot + images JSON
// text + warnings/errors string lists (JSON arrays of
// strings).
struct AuggieTurnInput {
    text: [u8; 262144],
    text_len: u64,
    images: [u8; 262144],
    images_len: u64,
    warnings: [u8; 16384],
    warnings_len: u64,
    errors: [u8; 16384],
    errors_len: u64,
    error_count: u64,
}

fn turn_input_push_error(input: &AuggieTurnInput, msg_ptr: ptr, msg_len: u64) -> void {
    let cap_ab36: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ab36, &input.errors, 0);
    if input.error_count > 0 { input.errors_len = input.errors_len + aab_append_bytes(cap_ab36, 16384, input.errors_len, STR_PTR("; "), 2); };
    let cap_ab37: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ab37, &input.errors, 0);
    input.errors_len = input.errors_len + aab_append_bytes(cap_ab37, 16384, input.errors_len, msg_ptr, msg_len);
    input.error_count = input.error_count + 1;
}

// coerceAuggieImageBlock(b, errors) -> image block doc
// or 0.
fn coerceAuggieImageBlock(b: u64, input: &AuggieTurnInput) -> u64 {
    let mime_ptr: ptr = PTR_NULL();
    let mime_len: u64 = 0;
    let has_mime = false;
    if sa_json_object_get_string(b, STR_PTR("mimeType"), STR_LEN("mimeType"), &mime_ptr, &mime_len) == 0 && mime_len > 0 { has_mime = true; } else if sa_json_object_get_string(b, STR_PTR("mediaType"), STR_LEN("mediaType"), &mime_ptr, &mime_len) == 0 && mime_len > 0 { has_mime = true; };
    let data_ptr: ptr = PTR_NULL();
    let data_len: u64 = 0;
    let has_data = false;
    if sa_json_object_get_string(b, STR_PTR("data"), STR_LEN("data"), &data_ptr, &data_len) == 0 && data_len > 0 { has_data = true; } else if sa_json_object_get_string(b, STR_PTR("base64"), STR_LEN("base64"), &data_ptr, &data_len) == 0 && data_len > 0 { has_data = true; };
    if (!has_data || !has_mime) {
        let url_ptr: ptr = PTR_NULL();
        let url_len: u64 = 0;
        if sa_json_object_get_string(b, STR_PTR("url"), STR_LEN("url"), &url_ptr, &url_len) == 0 && url_len > 0 {
            // data:([^;,]+);base64,(.*) — hand scan
            if aab_starts_with(url_ptr, url_len, STR_PTR("data:"), STR_LEN("data:")) {
                let semi = aab_find_byte(url_ptr, url_len, 5, 59);
                if semi != 4294967295 && aab_starts_with(aab_byte_off(url_ptr, semi), url_len - semi, STR_PTR(";base64,"), STR_LEN(";base64,")) {
                    if !has_mime {
                        mime_ptr = aab_byte_off(url_ptr, 5);
                        mime_len = semi - 5;
                        has_mime = mime_len > 0;
                    };
                    if !has_data {
                        data_ptr = aab_byte_off(url_ptr, semi + STR_LEN(";base64,"));
                        data_len = url_len - (semi + STR_LEN(";base64,"));
                        has_data = data_len > 0;
                    };
                };
            };
        };
    };
    if !has_mime {
        turn_input_push_error(input, STR_PTR("image attachment is missing its required mimeType"), STR_LEN("image attachment is missing its required mimeType"));
        return 0;
    };
    let supported = false;
    for i in 0..4 {
        let l: u64 = 0;
        let p = auggie_supported_image_mime(i, &l);
        if l == mime_len && aab_bytes_eq(p, mime_ptr, l) { supported = true; break; };
    }
    if !supported {
        let msg = [0u8; 512];
        let msg_p: ptr = PTR_NULL(); PTR_BYTE_ADD(msg_p, &msg, 0);
        let msg_len: u64 = 0;
        msg_len = msg_len + aab_append_bytes(msg_p, 512, msg_len, STR_PTR("unsupported image mimeType '"), STR_LEN("unsupported image mimeType '"));
        msg_len = msg_len + aab_append_bytes(msg_p, 512, msg_len, mime_ptr, mime_len);
        msg_len = msg_len + aab_append_bytes(msg_p, 512, msg_len, STR_PTR("' (auggie supports jpeg/png/gif/webp)"), STR_LEN("' (auggie supports jpeg/png/gif/webp)"));
        turn_input_push_error(input, msg_p, msg_len);
        return 0;
    };
    if !has_data || data_len == 0 {
        turn_input_push_error(input, STR_PTR("image attachment carries no base64 data"), STR_LEN("image attachment carries no base64 data"));
        return 0;
    };
    if data_len > 5242880 {
        let msg = [0u8; 512];
        let msg_p: ptr = PTR_NULL(); PTR_BYTE_ADD(msg_p, &msg, 0);
        let msg_len: u64 = 0;
        msg_len = msg_len + aab_append_bytes(msg_p, 512, msg_len, STR_PTR("image exceeds auggie's 5MB base64 limit ("), STR_LEN("image exceeds auggie's 5MB base64 limit ("));
        msg_len = msg_len + aab_append_u64(msg_p, 512, msg_len, data_len);
        msg_len = msg_len + aab_append_bytes(msg_p, 512, msg_len, STR_PTR(" chars)"), STR_LEN(" chars)"));
        turn_input_push_error(input, msg_p, msg_len);
        return 0;
    };
    let image = aab_json_object_new();
    aab_sa_json_object_set_string(image, STR_PTR("type"), STR_LEN("type"), STR_PTR("image"), STR_LEN("image"));
    aab_sa_json_object_set_string(image, STR_PTR("data"), STR_LEN("data"), data_ptr, data_len);
    aab_sa_json_object_set_string(image, STR_PTR("mimeType"), STR_LEN("mimeType"), mime_ptr, mime_len);
    return image;
}

// extractAuggieTurnInput(p)
fn extractAuggieTurnInput(p: u64, input: &AuggieTurnInput) -> void {
    input.text_len = 0;
    let cap_aab26504: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26504, &input.images, 0);
    input.images_len = aab_buf_copy( cap_aab26504, 262144, STR_PTR("[]"), 2);
    input.warnings_len = 0;
    input.errors_len = 0;
    input.error_count = 0;
    let record = jsonRecord(p);
    let blocks: u64 = 0;
    let has_blocks = false;
    let prompt_node: u64 = 0;
    sa_json_object_get(record, STR_PTR("prompt"), STR_LEN("prompt"), &prompt_node);
    let input_node: u64 = 0;
    sa_json_object_get(record, STR_PTR("input"), STR_LEN("input"), &input_node);
    let prompt_is_arr = false;
    if prompt_node != 0 { aab_json_node_is_array(prompt_node, &prompt_is_arr); };
    let input_is_arr = false;
    if input_node != 0 { aab_json_node_is_array(input_node, &input_is_arr); };
    if prompt_is_arr { blocks = prompt_node; has_blocks = true; } else if input_is_arr { blocks = input_node; has_blocks = true; };
    let text_ptr: ptr = PTR_NULL();
    let text_len: u64 = 0;
    let has_text = false;
    if sa_json_object_get_string(record, STR_PTR("prompt"), STR_LEN("prompt"), &text_ptr, &text_len) == 0 { has_text = true; } else if sa_json_object_get_string(record, STR_PTR("input"), STR_LEN("input"), &text_ptr, &text_len) == 0 { has_text = true; } else if sa_json_object_get_string(record, STR_PTR("text"), STR_LEN("text"), &text_ptr, &text_len) == 0 { has_text = true; };
    if has_text {
        let cap_aab26505: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26505, &input.text, 0);
        input.text_len = aab_buf_copy( cap_aab26505, 262144, text_ptr, text_len);
    } else if has_blocks {
        let images = aab_json_array_new();
        let parts = [0u8; 262144];
        let parts_p: ptr = PTR_NULL(); PTR_BYTE_ADD(parts_p, &parts, 0);
        let parts_len: u64 = 0;
        let part_count: u64 = 0;
        let count: u64 = 0;
        sa_json_value_count(blocks, &count);
        for i in 0..count {
            let block: u64 = 0;
            sa_json_array_get(blocks, i, &block);
            if block == 0 { continue; };
            let is_obj = false;
            aab_json_node_is_object(block, &is_obj);
            if !is_obj { continue; };
            let type_ptr: ptr = PTR_NULL();
            let type_len: u64 = 0;
            sa_json_object_get_string(block, STR_PTR("type"), STR_LEN("type"), &type_ptr, &type_len);
            let bt_ptr: ptr = PTR_NULL();
            let bt_len: u64 = 0;
            if aab_str_is(type_ptr, type_len, STR_PTR("text"), STR_LEN("text")) && sa_json_object_get_string(block, STR_PTR("text"), STR_LEN("text"), &bt_ptr, &bt_len) == 0 {
                if part_count > 0 { parts_len = parts_len + aab_append_bytes(parts_p, 262144, parts_len, STR_PTR("\n"), 1); };
                parts_len = parts_len + aab_append_bytes(parts_p, 262144, parts_len, bt_ptr, bt_len);
                part_count = part_count + 1;
            } else if aab_str_is(type_ptr, type_len, STR_PTR("image"), STR_LEN("image")) {
                let image = coerceAuggieImageBlock(block, input);
                if image != 0 { sa_json_array_push_node(images, image); };
            } else {
                let msg = [0u8; 512];
                let msg_p: ptr = PTR_NULL(); PTR_BYTE_ADD(msg_p, &msg, 0);
                let msg_len: u64 = 0;
                msg_len = msg_len + aab_append_bytes(msg_p, 512, msg_len, STR_PTR("Unsupported prompt block type '"), STR_LEN("Unsupported prompt block type '"));
                let type_text = [0u8; 256];
                let type_text_p: ptr = PTR_NULL(); PTR_BYTE_ADD(type_text_p, &type_text, 0);
                let type_text_len = aab_stringify_into(field_or_zero(block, STR_PTR("type"), STR_LEN("type")), type_text_p, 256);
                msg_len = msg_len + aab_append_bytes(msg_p, 512, msg_len, type_text_p, type_text_len);
                msg_len = msg_len + aab_append_bytes(msg_p, 512, msg_len, STR_PTR("' ignored for auggie."), STR_LEN("' ignored for auggie."));
                let cap_ab38: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ab38, &input.warnings, 0);
                if input.warnings_len > 0 { input.warnings_len = input.warnings_len + aab_append_bytes(cap_ab38, 16384, input.warnings_len, STR_PTR("\n"), 1); };
                let cap_ab39: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ab39, &input.warnings, 0);
                input.warnings_len = input.warnings_len + aab_append_bytes(cap_ab39, 16384, input.warnings_len, msg_p, msg_len);
            };
        }
        let cap_aab26506: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26506, &input.text, 0);
        input.text_len = aab_buf_copy( cap_aab26506, 262144, parts_p, parts_len);
        let cap_aab27164: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab27164, &input.images, 0);
        input.images_len = aab_stringify_into(images, cap_aab27164, 262144);
    } else if prompt_node != 0 {
        let is_obj = false;
        aab_json_node_is_object(prompt_node, &is_obj);
        if is_obj {
            let bt_ptr: ptr = PTR_NULL();
            let bt_len: u64 = 0;
            if sa_json_object_get_string(prompt_node, STR_PTR("type"), STR_LEN("type"), &bt_ptr, &bt_len) == 0 && aab_str_is(bt_ptr, bt_len, STR_PTR("text"), STR_LEN("text")) && sa_json_object_get_string(prompt_node, STR_PTR("text"), STR_LEN("text"), &bt_ptr, &bt_len) == 0 {
                let cap_aab26507: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26507, &input.text, 0);
                input.text_len = aab_buf_copy( cap_aab26507, 262144, bt_ptr, bt_len);
            };
        };
    };
    // aggregate image limits
    let images_doc = sa_json_parse(&input.images, input.images_len);
    let image_count: u64 = 0;
    if images_doc != 0 { sa_json_value_count(images_doc, &image_count); };
    if image_count > 10 {
        let msg = [0u8; 512];
        let msg_p: ptr = PTR_NULL(); PTR_BYTE_ADD(msg_p, &msg, 0);
        let msg_len: u64 = 0;
        msg_len = msg_len + aab_append_bytes(msg_p, 512, msg_len, STR_PTR("auggie accepts at most 10 images per message (got "), STR_LEN("auggie accepts at most 10 images per message (got "));
        msg_len = msg_len + aab_append_u64(msg_p, 512, msg_len, image_count);
        msg_len = msg_len + aab_append_bytes(msg_p, 512, msg_len, STR_PTR(")"), 1);
        turn_input_push_error(input, msg_p, msg_len);
    };
    let total_b64: u64 = 0;
    for i in 0..image_count {
        let image: u64 = 0;
        sa_json_array_get(images_doc, i, &image);
        let d_ptr: ptr = PTR_NULL();
        let d_len: u64 = 0;
        if image != 0 && sa_json_object_get_string(image, STR_PTR("data"), STR_LEN("data"), &d_ptr, &d_len) == 0 { total_b64 = total_b64 + d_len; };
    }
    if total_b64 > 5242880 {
        let msg = [0u8; 512];
        let msg_p: ptr = PTR_NULL(); PTR_BYTE_ADD(msg_p, &msg, 0);
        let msg_len: u64 = 0;
        msg_len = msg_len + aab_append_bytes(msg_p, 512, msg_len, STR_PTR("auggie accepts at most 5MB of base64 image data per message (got "), STR_LEN("auggie accepts at most 5MB of base64 image data per message (got "));
        msg_len = msg_len + aab_append_u64(msg_p, 512, msg_len, total_b64);
        msg_len = msg_len + aab_append_bytes(msg_p, 512, msg_len, STR_PTR(" chars)"), STR_LEN(" chars)"));
        turn_input_push_error(input, msg_p, msg_len);
    };
}

// buildAuggiePromptBlocks(text, images) -> blocks
// JSON text.
fn buildAuggiePromptBlocks(text_ptr: ptr, text_len: u64, images_ptr: ptr, images_len: u64, out: ptr, out_cap: u64) -> u64 {
    let blocks = aab_json_array_new();
    if text_len > 0 {
        let block = aab_json_object_new();
        aab_sa_json_object_set_string(block, STR_PTR("type"), STR_LEN("type"), STR_PTR("text"), STR_LEN("text"));
        aab_sa_json_object_set_string(block, STR_PTR("text"), STR_LEN("text"), text_ptr, text_len);
        sa_json_array_push_node(blocks, block);
    };
    let images_doc = sa_json_parse(images_ptr, images_len);
    let count: u64 = 0;
    if images_doc != 0 { sa_json_value_count(images_doc, &count); };
    for i in 0..count {
        let image: u64 = 0;
        sa_json_array_get(images_doc, i, &image);
        if image != 0 { sa_json_array_push_node(blocks, image); };
    }
    return aab_stringify_into(blocks, out, out_cap);
}

// fire_prompt: send session/prompt deferred — the
// result routes through the pending-prompt table in
// handleLine (600s timeout in the source).
fn fire_prompt(self: &AuggieAgentBridge, si: u64, turnId_ptr: ptr, turnId_len: u64, blocks_ptr: ptr, blocks_len: u64) -> void {
    if !self.sessions[si].has_externalSessionId { return; };
    let blocks_doc = sa_json_parse(blocks_ptr, blocks_len);
    let count: u64 = 0;
    if blocks_doc != 0 { sa_json_value_count(blocks_doc, &count); };
    if count == 0 { return; };
    let message = aab_json_object_new();
    aab_sa_json_object_set_string(message, STR_PTR("method"), STR_LEN("method"), AUGGIE_METHOD_sessionPrompt(), STR_LEN("session/prompt"));
    let params = aab_json_object_new();
    let cap_aab26747: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26747, &self.sessions[si].externalSessionId, 0);
    aab_sa_json_object_set_string(params, STR_PTR("sessionId"), STR_LEN("sessionId"), cap_aab26747, self.sessions[si].externalSessionId_len);
    sa_json_object_set_node(params, STR_PTR("prompt"), STR_LEN("prompt"), blocks_doc);
    sa_json_object_set_node(message, STR_PTR("params"), STR_LEN("params"), params);
    let id = send_request_register(self, message, 600000);
    if id == 0 { return; };
    if self.pending_prompt_count < 16 {
        let i = self.pending_prompt_count;
        let cap_aab26644: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26644, &self.pending_prompts[i].id_str, 0);
        self.pending_prompts[i].id_str_len = aab_append_u64( cap_aab26644, 32, 0, id);
        let cap_aab26508: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26508, &self.pending_prompts[i].threadId, 0);
        let cap_aab26573: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26573, &self.sessions[si].threadId, 0);
        self.pending_prompts[i].threadId_len = aab_buf_copy( cap_aab26508, 128, cap_aab26573, self.sessions[si].threadId_len);
        let cap_aab26509: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26509, &self.pending_prompts[i].turnId, 0);
        self.pending_prompts[i].turnId_len = aab_buf_copy( cap_aab26509, 128, turnId_ptr, turnId_len);
        self.pending_prompt_count = self.pending_prompt_count + 1;
    };
}

// ---- handleMethod dispatch ----

fn handle_method(self: &AuggieAgentBridge, method_ptr: ptr, method_len: u64, params: u64, out: ptr, out_cap: u64, out_len: &u64, out_err: ptr, out_err_cap: u64, out_err_len: &u64) -> void {
    *out_len = 0;
    *out_err_len = 0;
    let p = jsonRecord(params);
    // initialize / config/read
    if aab_str_is(method_ptr, method_len, STR_PTR("initialize"), STR_LEN("initialize")) || aab_str_is(method_ptr, method_len, STR_PTR("config/read"), STR_LEN("config/read")) {
        let version = [0u8; 256];
        let version_p: ptr = PTR_NULL(); PTR_BYTE_ADD(version_p, &version, 0);
        let version_len = probedVersionLabel(self, version_p, 256);
        let doc = aab_json_object_new();
        let ua = [0u8; 512];
        let ua_p: ptr = PTR_NULL(); PTR_BYTE_ADD(ua_p, &ua, 0);
        let ua_len: u64 = 0;
        ua_len = ua_len + aab_append_bytes(ua_p, 512, ua_len, STR_PTR("auggie/"), STR_LEN("auggie/"));
        ua_len = ua_len + aab_append_bytes(ua_p, 512, ua_len, version_p, version_len);
        ua_len = ua_len + aab_append_bytes(ua_p, 512, ua_len, STR_PTR(" codex-react-ui/0.1.0"), STR_LEN(" codex-react-ui/0.1.0"));
        aab_sa_json_object_set_string(doc, STR_PTR("userAgent"), STR_LEN("userAgent"), ua_p, ua_len);
        let home_ptr: ptr = PTR_NULL();
        let home_len: u64 = 0;
        let cap_aab27202: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab27202, &self.env_snapshot, 0);
        env_get( cap_aab27202, self.env_snapshot_len, STR_PTR("CODEX_HOME"), STR_LEN("CODEX_HOME"), &home_ptr, &home_len);
        aab_sa_json_object_set_string(doc, STR_PTR("codexHome"), STR_LEN("codexHome"), home_ptr, home_len);
        let caps = aab_json_object_new();
        aab_sa_json_object_set_bool(caps, STR_PTR("experimentalApi"), STR_LEN("experimentalApi"), true);
        sa_json_object_set_node(doc, STR_PTR("capabilities"), STR_LEN("capabilities"), caps);
        *out_len = aab_stringify_into(doc, out, out_cap);
        return;
    };
    // thread/start
    if aab_str_is(method_ptr, method_len, STR_PTR("thread/start"), STR_LEN("thread/start")) {
        let threadId = [0u8; 128];
        let threadId_len: u64 = 0;
        let tp: ptr = PTR_NULL();
        let tl: u64 = 0;
        if sa_json_object_get_string(p, STR_PTR("threadId"), STR_LEN("threadId"), &tp, &tl) == 0 && tl > 0 {
            let cap_aab26510: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26510, &threadId, 0);
            threadId_len = aab_buf_copy( cap_aab26510, 128, tp, tl);
        } else {
            let cap_aab27203: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab27203, &threadId, 0);
            threadId_len = aab_uuid_new( cap_aab27203, 128);
        };
        let model_ptr: ptr = PTR_NULL();
        let model_len: u64 = 0;
        let has_model = sa_json_object_get_string(p, STR_PTR("model"), STR_LEN("model"), &model_ptr, &model_len) == 0 && model_len > 0;
        if has_model && !self.has_configuredModel {
            let cap_aab26511: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26511, &self.configuredModel, 0);
            self.configuredModel_len = aab_buf_copy( cap_aab26511, 256, model_ptr, model_len);
            self.has_configuredModel = true;
        };
        let cwd_ptr: ptr = PTR_NULL();
        let cwd_len: u64 = 0;
        let has_cwd = sa_json_object_get_string(p, STR_PTR("cwd"), STR_LEN("cwd"), &cwd_ptr, &cwd_len) == 0 && cwd_len > 0;
        if has_cwd && !self.has_configuredCwd {
            let cap_aab26512: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26512, &self.configuredCwd, 0);
            self.configuredCwd_len = aab_buf_copy( cap_aab26512, 1024, cwd_ptr, cwd_len);
            self.has_configuredCwd = true;
        };
        let policy_ptr: ptr = PTR_NULL();
        let policy_len: u64 = 0;
        if sa_json_object_get_string(p, STR_PTR("approvalPolicy"), STR_LEN("approvalPolicy"), &policy_ptr, &policy_len) != 0 || policy_len == 0 {
            policy_ptr = STR_PTR("on-request");
            policy_len = STR_LEN("on-request");
        };
        if self.session_count >= 16 {
            *out_err_len = aab_buf_copy(out_err, out_err_cap, STR_PTR("auggie session table full"), STR_LEN("auggie session table full"));
            return;
        };
        let si = self.session_count;
        let cap_aab27204: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab27204, &threadId, 0);
        session_init(&self.sessions[si], cap_aab27204, threadId_len);
        self.session_count = self.session_count + 1;
        if has_model {
            let cap_aab26513: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26513, &self.sessions[si].model, 0);
            self.sessions[si].model_len = aab_buf_copy( cap_aab26513, 256, model_ptr, model_len);
            self.sessions[si].has_model = true;
        };
        let cap_aab26514: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26514, &self.sessions[si].permissionMode, 0);
        self.sessions[si].permissionMode_len = aab_buf_copy( cap_aab26514, 64, policy_ptr, policy_len);
        if has_cwd {
            let cap_aab26515: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26515, &self.sessions[si].cwd, 0);
            self.sessions[si].cwd_len = aab_buf_copy( cap_aab26515, 1024, cwd_ptr, cwd_len);
            self.sessions[si].has_cwd = true;
        };
        self.sessions[si].created_at = aab_now_ms();
        // session/new (awaited; failures roll back)
        let new_cwd = [0u8; 1024];
        let new_cwd_p: ptr = PTR_NULL(); PTR_BYTE_ADD(new_cwd_p, &new_cwd, 0);
        let new_cwd_len: u64 = 0;
        if has_cwd { new_cwd_len = aab_buf_copy(new_cwd_p, 1024, cwd_ptr, cwd_len); } else { new_cwd_len = process_cwd(new_cwd_p, 1024); };
        let frame_text = [0u8; 4096];
        let frame_text_p: ptr = PTR_NULL(); PTR_BYTE_ADD(frame_text_p, &frame_text, 0);
        let frame_len: u64 = 0;
        auggieProtocol_buildAuggieSessionNew(new_cwd_p, new_cwd_len, frame_text_p, 4096, &frame_len);
        let frame_doc = sa_json_parse(frame_text_p, frame_len);
        let result = [0u8; 4096];
        let result_p: ptr = PTR_NULL(); PTR_BYTE_ADD(result_p, &result, 0);
        let result_len: u64 = 0;
        let err = [0u8; 1024];
        let err_p: ptr = PTR_NULL(); PTR_BYTE_ADD(err_p, &err, 0);
        let err_len: u64 = 0;
        send_request_sync(self, frame_doc, 60000, result_p, 4096, &result_len, err_p, 1024, &err_len);
        if err_len > 0 {
            for i in si + 1..self.session_count {
                self.sessions[i - 1] = self.sessions[i];
            }
            self.session_count = self.session_count - 1;
            *out_err_len = aab_buf_copy(out_err, out_err_cap, err_p, err_len);
            return;
        };
        let result_doc = sa_json_parse(result_p, result_len);
        let record = jsonRecord(result_doc);
        let sid_ptr: ptr = PTR_NULL();
        let sid_len: u64 = 0;
        if sa_json_object_get_string(record, STR_PTR("sessionId"), STR_LEN("sessionId"), &sid_ptr, &sid_len) == 0 && sid_len > 0 {
            let cap_aab26516: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26516, &self.sessions[si].externalSessionId, 0);
            self.sessions[si].externalSessionId_len = aab_buf_copy( cap_aab26516, 128, sid_ptr, sid_len);
            self.sessions[si].has_externalSessionId = true;
            let cap_aab27223: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab27223, &threadId, 0);
            map_session(self, sid_ptr, sid_len, cap_aab27223, threadId_len);
        };
        let frame = aab_json_object_new();
        aab_sa_json_object_set_string(frame, STR_PTR("method"), STR_LEN("method"), STR_PTR("thread/started"), STR_LEN("thread/started"));
        let fp = aab_json_object_new();
        let thread = aab_json_object_new();
        let cap_aab26748: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26748, &threadId, 0);
        aab_sa_json_object_set_string(thread, STR_PTR("id"), STR_LEN("id"), cap_aab26748, threadId_len);
        if has_model { aab_sa_json_object_set_string(thread, STR_PTR("model"), STR_LEN("model"), model_ptr, model_len); };
        aab_sa_json_object_set_string(thread, STR_PTR("cliBackend"), STR_LEN("cliBackend"), STR_PTR("auggie"), STR_LEN("auggie"));
        let status = aab_json_object_new();
        aab_sa_json_object_set_string(status, STR_PTR("type"), STR_LEN("type"), STR_PTR("idle"), STR_LEN("idle"));
        sa_json_object_set_node(thread, STR_PTR("status"), STR_LEN("status"), status);
        if has_cwd { aab_sa_json_object_set_string(thread, STR_PTR("cwd"), STR_LEN("cwd"), cwd_ptr, cwd_len); };
        sa_json_object_set_node(fp, STR_PTR("thread"), STR_LEN("thread"), thread);
        sa_json_object_set_node(frame, STR_PTR("params"), STR_LEN("params"), fp);
        bridge_emit_message(self, frame);
        let doc = aab_json_object_new();
        let thread2 = aab_json_object_new();
        let cap_aab26749: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26749, &threadId, 0);
        aab_sa_json_object_set_string(thread2, STR_PTR("id"), STR_LEN("id"), cap_aab26749, threadId_len);
        if has_model { aab_sa_json_object_set_string(thread2, STR_PTR("model"), STR_LEN("model"), model_ptr, model_len); };
        aab_sa_json_object_set_string(thread2, STR_PTR("cliBackend"), STR_LEN("cliBackend"), STR_PTR("auggie"), STR_LEN("auggie"));
        let status2 = aab_json_object_new();
        aab_sa_json_object_set_string(status2, STR_PTR("type"), STR_LEN("type"), STR_PTR("idle"), STR_LEN("idle"));
        sa_json_object_set_node(thread2, STR_PTR("status"), STR_LEN("status"), status2);
        sa_json_object_set_node(doc, STR_PTR("thread"), STR_LEN("thread"), thread2);
        *out_len = aab_stringify_into(doc, out, out_cap);
        return;
    };
    // turn/start | turn/steer
    if aab_str_is(method_ptr, method_len, STR_PTR("turn/start"), STR_LEN("turn/start")) || aab_str_is(method_ptr, method_len, STR_PTR("turn/steer"), STR_LEN("turn/steer")) {
        let is_steer = aab_str_is(method_ptr, method_len, STR_PTR("turn/steer"), STR_LEN("turn/steer"));
        let threadId_ptr: ptr = PTR_NULL();
        let threadId_len: u64 = 0;
        sa_json_object_get_string(p, STR_PTR("threadId"), STR_LEN("threadId"), &threadId_ptr, &threadId_len);
        let si = find_session(self, threadId_ptr, threadId_len);
        if si == 4294967295 {
            let msg = [0u8; 512];
            let msg_len: u64 = 0;
            let cap_ab40: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ab40, &msg, 0);
            msg_len = msg_len + aab_append_bytes(cap_ab40, 512, msg_len, STR_PTR("Unknown thread: "), STR_LEN("Unknown thread: "));
            let cap_ab41: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ab41, &msg, 0);
            msg_len = msg_len + aab_append_bytes(cap_ab41, 512, msg_len, threadId_ptr, threadId_len);
            let cap_aab26574: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26574, &msg, 0);
            *out_err_len = aab_buf_copy(out_err, out_err_cap, cap_aab26574, msg_len);
            return;
        };
        let turnId = [0u8; 128];
        let turnId_p: ptr = PTR_NULL(); PTR_BYTE_ADD(turnId_p, &turnId, 0);
        let turnId_len: u64 = 0;
        if is_steer {
            if !self.sessions[si].has_activeTurnId {
                *out_err_len = aab_buf_copy(out_err, out_err_cap, STR_PTR("No active turn"), STR_LEN("No active turn"));
                return;
            };
            let cap_aab26575: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26575, &self.sessions[si].activeTurnId, 0);
            turnId_len = aab_buf_copy(turnId_p, 128, cap_aab26575, self.sessions[si].activeTurnId_len);
            let expected_ptr: ptr = PTR_NULL();
            let expected_len: u64 = 0;
            if sa_json_object_get_string(p, STR_PTR("expectedTurnId"), STR_LEN("expectedTurnId"), &expected_ptr, &expected_len) == 0 && expected_len > 0 && (expected_len != turnId_len || !aab_bytes_eq(expected_ptr, turnId_p, expected_len)) {
                let msg = [0u8; 512];
                let msg_len: u64 = 0;
                let cap_ab42: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ab42, &msg, 0);
                msg_len = msg_len + aab_append_bytes(cap_ab42, 512, msg_len, STR_PTR("Expected active turn id '"), STR_LEN("Expected active turn id '"));
                let cap_ab43: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ab43, &msg, 0);
                msg_len = msg_len + aab_append_bytes(cap_ab43, 512, msg_len, expected_ptr, expected_len);
                let cap_ab44: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ab44, &msg, 0);
                msg_len = msg_len + aab_append_bytes(cap_ab44, 512, msg_len, STR_PTR("' but found '"), STR_LEN("' but found '"));
                let cap_ab45: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ab45, &msg, 0);
                msg_len = msg_len + aab_append_bytes(cap_ab45, 512, msg_len, turnId_p, turnId_len);
                let cap_ab46: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ab46, &msg, 0);
                msg_len = msg_len + aab_append_bytes(cap_ab46, 512, msg_len, STR_PTR("'"), 1);
                let cap_aab26576: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26576, &msg, 0);
                *out_err_len = aab_buf_copy(out_err, out_err_cap, cap_aab26576, msg_len);
                return;
            };
        } else {
            let tp: ptr = PTR_NULL();
            let tl: u64 = 0;
            if sa_json_object_get_string(p, STR_PTR("turnId"), STR_LEN("turnId"), &tp, &tl) == 0 && tl > 0 {
                turnId_len = aab_buf_copy(turnId_p, 128, tp, tl);
            } else {
                turnId_len = aab_uuid_new(turnId_p, 128);
            };
            if self.sessions[si].has_activeTurnId {
                let msg = [0u8; 512];
                let msg_len: u64 = 0;
                let cap_ab47: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ab47, &msg, 0);
                msg_len = msg_len + aab_append_bytes(cap_ab47, 512, msg_len, STR_PTR("Turn is already active: "), STR_LEN("Turn is already active: "));
                let cap_ab48: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ab48, &msg, 0);
                let cap_ab49: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ab49, &self.sessions[si].activeTurnId, 0);
                msg_len = msg_len + aab_append_bytes(cap_ab48, 512, msg_len, cap_ab49, self.sessions[si].activeTurnId_len);
                let cap_aab26577: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26577, &msg, 0);
                *out_err_len = aab_buf_copy(out_err, out_err_cap, cap_aab26577, msg_len);
                return;
            };
        };
        let input = AuggieTurnInput{ text: [0u8; 262144], text_len: 0, images: [0u8; 262144], images_len: 0, warnings: [0u8; 16384], warnings_len: 0, errors: [0u8; 16384], errors_len: 0, error_count: 0 };
        extractAuggieTurnInput(p, &input);
        if input.warnings_len > 0 {
            // warnings are emitted line by line in the
            // source; the joined text goes out as one
            // stderr event per warning line in the queue
            // consumer — here a single emit.
            let w = [0u8; 16384];
            let w_p: ptr = PTR_NULL(); PTR_BYTE_ADD(w_p, &w, 0);
            let cap_aab26578: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26578, &input.warnings, 0);
            let w_len = aab_buf_copy(w_p, 16384, cap_aab26578, input.warnings_len);
            w_len = w_len + aab_append_bytes(w_p, 16384, w_len, STR_PTR("\n"), 1);
            bridge_emit_stderr(self, w_p, w_len);
        };
        if input.error_count > 0 {
            let msg = [0u8; 17408];
            let msg_len: u64 = 0;
            let cap_ab50: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ab50, &msg, 0);
            msg_len = msg_len + aab_append_bytes(cap_ab50, 17408, msg_len, STR_PTR("auggie rejected the message: "), STR_LEN("auggie rejected the message: "));
            let cap_ab51: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ab51, &msg, 0);
            let cap_ab52: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ab52, &input.errors, 0);
            msg_len = msg_len + aab_append_bytes(cap_ab51, 17408, msg_len, cap_ab52, input.errors_len);
            let cap_aab26579: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26579, &msg, 0);
            *out_err_len = aab_buf_copy(out_err, out_err_cap, cap_aab26579, msg_len);
            return;
        };
        // model switch before the prompt fires
        let requested_ptr: ptr = PTR_NULL();
        let requested_len: u64 = 0;
        let has_requested = false;
        if sa_json_object_get_string(p, STR_PTR("model"), STR_LEN("model"), &requested_ptr, &requested_len) == 0 && requested_len > 0 { has_requested = true; } else if self.has_configuredModel { let cap_aabR: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aabR, &self.configuredModel, 0); requested_ptr = cap_aabR; requested_len = self.configuredModel_len; has_requested = true; };
        let cap_aab26206: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26206, &self.sessions[si].model, 0);
        if has_requested && (!self.sessions[si].has_model || self.sessions[si].model_len != requested_len || !aab_bytes_eq( cap_aab26206, requested_ptr, requested_len)) {
            set_session_model(self, si, requested_ptr, requested_len);
        };
        if !is_steer {
            if self.sessions[si].turn_count < 128 {
                let ti = self.sessions[si].turn_count;
                let cap_aab26517: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26517, &self.sessions[si].turns[ti].id, 0);
                self.sessions[si].turns[ti].id_len = aab_buf_copy( cap_aab26517, 128, turnId_p, turnId_len);
                let cap_aab26518: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26518, &self.sessions[si].turns[ti].status, 0);
                self.sessions[si].turns[ti].status_len = aab_buf_copy( cap_aab26518, 32, STR_PTR("running"), STR_LEN("running"));
                self.sessions[si].turns[ti].created_at = aab_now_ms();
                self.sessions[si].turn_count = self.sessions[si].turn_count + 1;
            };
            let cap_aab26519: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26519, &self.sessions[si].activeTurnId, 0);
            self.sessions[si].activeTurnId_len = aab_buf_copy( cap_aab26519, 128, turnId_p, turnId_len);
            self.sessions[si].has_activeTurnId = true;
            self.sessions[si].turnStartedAtMs = aab_now_ms();
            self.sessions[si].has_turnStartedAtMs = true;
            self.sessions[si].lastActivityMs = aab_now_ms();
            self.sessions[si].has_lastActivityMs = true;
            let frame = aab_json_object_new();
            aab_sa_json_object_set_string(frame, STR_PTR("method"), STR_LEN("method"), STR_PTR("turn/started"), STR_LEN("turn/started"));
            let fp = aab_json_object_new();
            aab_sa_json_object_set_string(fp, STR_PTR("threadId"), STR_LEN("threadId"), threadId_ptr, threadId_len);
            let turn = aab_json_object_new();
            aab_sa_json_object_set_string(turn, STR_PTR("id"), STR_LEN("id"), turnId_p, turnId_len);
            aab_sa_json_object_set_string(turn, STR_PTR("threadId"), STR_LEN("threadId"), threadId_ptr, threadId_len);
            aab_sa_json_object_set_string(turn, STR_PTR("status"), STR_LEN("status"), STR_PTR("running"), STR_LEN("running"));
            sa_json_object_set_node(fp, STR_PTR("turn"), STR_LEN("turn"), turn);
            sa_json_object_set_node(frame, STR_PTR("params"), STR_LEN("params"), fp);
            bridge_emit_message(self, frame);
        };
        if input.text_len > 0 {
            let item = aab_json_object_new();
            aab_sa_json_object_set_string(item, STR_PTR("type"), STR_LEN("type"), STR_PTR("userMessage"), STR_LEN("userMessage"));
            let item_id = [0u8; 256];
            let item_id_p: ptr = PTR_NULL(); PTR_BYTE_ADD(item_id_p, &item_id, 0);
            let item_id_len: u64 = 0;
            item_id_len = item_id_len + aab_append_bytes(item_id_p, 256, item_id_len, STR_PTR("auggie-user-"), STR_LEN("auggie-user-"));
            item_id_len = item_id_len + aab_append_bytes(item_id_p, 256, item_id_len, turnId_p, turnId_len);
            if is_steer {
                item_id_len = item_id_len + aab_append_bytes(item_id_p, 256, item_id_len, STR_PTR("-"), 1);
                let uid = [0u8; 64];
                let uid_p: ptr = PTR_NULL(); PTR_BYTE_ADD(uid_p, &uid, 0);
                let uid_len = aab_uuid_new(uid_p, 64);
                item_id_len = item_id_len + aab_append_bytes(item_id_p, 256, item_id_len, uid_p, uid_len);
            };
            aab_sa_json_object_set_string(item, STR_PTR("id"), STR_LEN("id"), item_id_p, item_id_len);
            aab_sa_json_object_set_string(item, STR_PTR("turnId"), STR_LEN("turnId"), turnId_p, turnId_len);
            aab_sa_json_object_set_string(item, STR_PTR("threadId"), STR_LEN("threadId"), threadId_ptr, threadId_len);
            let content = aab_json_array_new();
            let block = aab_json_object_new();
            aab_sa_json_object_set_string(block, STR_PTR("type"), STR_LEN("type"), STR_PTR("text"), STR_LEN("text"));
            let cap_aab26750: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26750, &input.text, 0);
            aab_sa_json_object_set_string(block, STR_PTR("text"), STR_LEN("text"), cap_aab26750, input.text_len);
            sa_json_object_set_node(block, STR_PTR("text_elements"), STR_LEN("text_elements"), aab_json_array_new());
            sa_json_array_push_node(content, block);
            sa_json_object_set_node(item, STR_PTR("content"), STR_LEN("content"), content);
            aab_sa_json_object_set_string(item, STR_PTR("role"), STR_LEN("role"), STR_PTR("user"), STR_LEN("user"));
            aab_sa_json_object_set_string(item, STR_PTR("status"), STR_LEN("status"), STR_PTR("completed"), STR_LEN("completed"));
            aab_sa_json_object_set_number(item, STR_PTR("startedAt"), STR_LEN("startedAt"), aab_now_ms() / 1000);
            let item_text = [0u8; 262144];
            let item_text_p: ptr = PTR_NULL(); PTR_BYTE_ADD(item_text_p, &item_text, 0);
            let item_text_len = aab_stringify_into(item, item_text_p, 262144);
            session_msg_push(&self.sessions[si], item_text_p, item_text_len);
            let cap_aab27283: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab27283, &input.text, 0);
            conversation_push_user(&self.sessions[si], cap_aab27283, input.text_len);
            let frame = aab_json_object_new();
            aab_sa_json_object_set_string(frame, STR_PTR("method"), STR_LEN("method"), STR_PTR("item/completed"), STR_LEN("item/completed"));
            let fp = aab_json_object_new();
            aab_sa_json_object_set_string(fp, STR_PTR("threadId"), STR_LEN("threadId"), threadId_ptr, threadId_len);
            aab_sa_json_object_set_string(fp, STR_PTR("turnId"), STR_LEN("turnId"), turnId_p, turnId_len);
            sa_json_object_set_node(fp, STR_PTR("item"), STR_LEN("item"), item);
            sa_json_object_set_node(frame, STR_PTR("params"), STR_LEN("params"), fp);
            bridge_emit_message(self, frame);
        };
        if !self.sessions[si].has_externalSessionId {
            *out_err_len = aab_buf_copy(out_err, out_err_cap, STR_PTR("auggie session has no externalSessionId"), STR_LEN("auggie session has no externalSessionId"));
            return;
        };
        let blocks = [0u8; 524288];
        let blocks_p: ptr = PTR_NULL(); PTR_BYTE_ADD(blocks_p, &blocks, 0);
        let cap_aab27284: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab27284, &input.text, 0);
        let cap_aab27286: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab27286, &input.images, 0);
        let blocks_len = buildAuggiePromptBlocks( cap_aab27284, input.text_len, cap_aab27286, input.images_len, blocks_p, 524288);
        fire_prompt(self, si, turnId_p, turnId_len, blocks_p, blocks_len);
        let doc = aab_json_object_new();
        let turn = aab_json_object_new();
        aab_sa_json_object_set_string(turn, STR_PTR("id"), STR_LEN("id"), turnId_p, turnId_len);
        aab_sa_json_object_set_string(turn, STR_PTR("threadId"), STR_LEN("threadId"), threadId_ptr, threadId_len);
        aab_sa_json_object_set_string(turn, STR_PTR("status"), STR_LEN("status"), STR_PTR("running"), STR_LEN("running"));
        sa_json_object_set_node(doc, STR_PTR("turn"), STR_LEN("turn"), turn);
        *out_len = aab_stringify_into(doc, out, out_cap);
        return;
    };
    // turn/steer/end | thread/steer: follow-up prompt on
    // the active turn
    if aab_str_is(method_ptr, method_len, STR_PTR("turn/steer/end"), STR_LEN("turn/steer/end")) || aab_str_is(method_ptr, method_len, STR_PTR("thread/steer"), STR_LEN("thread/steer")) {
        let threadId_ptr: ptr = PTR_NULL();
        let threadId_len: u64 = 0;
        sa_json_object_get_string(p, STR_PTR("threadId"), STR_LEN("threadId"), &threadId_ptr, &threadId_len);
        let si = find_session(self, threadId_ptr, threadId_len);
        if si == 4294967295 {
            let msg = [0u8; 512];
            let msg_len: u64 = 0;
            let cap_ab53: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ab53, &msg, 0);
            msg_len = msg_len + aab_append_bytes(cap_ab53, 512, msg_len, STR_PTR("Unknown thread: "), STR_LEN("Unknown thread: "));
            let cap_ab54: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ab54, &msg, 0);
            msg_len = msg_len + aab_append_bytes(cap_ab54, 512, msg_len, threadId_ptr, threadId_len);
            let cap_aab26580: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26580, &msg, 0);
            *out_err_len = aab_buf_copy(out_err, out_err_cap, cap_aab26580, msg_len);
            return;
        };
        *out_len = aab_buf_copy(out, out_cap, STR_PTR("{}"), 2);
        if !self.sessions[si].has_activeTurnId || !self.sessions[si].has_externalSessionId { return; };
        let input = AuggieTurnInput{ text: [0u8; 262144], text_len: 0, images: [0u8; 262144], images_len: 0, warnings: [0u8; 16384], warnings_len: 0, errors: [0u8; 16384], errors_len: 0, error_count: 0 };
        extractAuggieTurnInput(p, &input);
        if input.error_count > 0 {
            let msg = [0u8; 17408];
            let msg_len: u64 = 0;
            let cap_ab55: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ab55, &msg, 0);
            msg_len = msg_len + aab_append_bytes(cap_ab55, 17408, msg_len, STR_PTR("auggie rejected the message: "), STR_LEN("auggie rejected the message: "));
            let cap_ab56: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ab56, &msg, 0);
            let cap_ab57: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ab57, &input.errors, 0);
            msg_len = msg_len + aab_append_bytes(cap_ab56, 17408, msg_len, cap_ab57, input.errors_len);
            *out_len = 0;
            let cap_aab26581: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26581, &msg, 0);
            *out_err_len = aab_buf_copy(out_err, out_err_cap, cap_aab26581, msg_len);
            return;
        };
        let blocks = [0u8; 524288];
        let blocks_p: ptr = PTR_NULL(); PTR_BYTE_ADD(blocks_p, &blocks, 0);
        let cap_aab27285: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab27285, &input.text, 0);
        let cap_aab27287: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab27287, &input.images, 0);
        let blocks_len = buildAuggiePromptBlocks( cap_aab27285, input.text_len, cap_aab27287, input.images_len, blocks_p, 524288);
        let cap_aab27300: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab27300, &self.sessions[si].activeTurnId, 0);
        fire_prompt(self, si, cap_aab27300, self.sessions[si].activeTurnId_len, blocks_p, blocks_len);
        *out_len = aab_buf_copy(out, out_cap, STR_PTR("{}"), 2);
        return;
    };
    // turn/interrupt
    if aab_str_is(method_ptr, method_len, STR_PTR("turn/interrupt"), STR_LEN("turn/interrupt")) {
        let threadId_ptr: ptr = PTR_NULL();
        let threadId_len: u64 = 0;
        sa_json_object_get_string(p, STR_PTR("threadId"), STR_LEN("threadId"), &threadId_ptr, &threadId_len);
        let si = find_session(self, threadId_ptr, threadId_len);
        if si != 4294967295 && self.has_child && self.sessions[si].has_externalSessionId {
            let frame_text = [0u8; 1024];
            let frame_text_p: ptr = PTR_NULL(); PTR_BYTE_ADD(frame_text_p, &frame_text, 0);
            let frame_len: u64 = 0;
            let cap_aab27301: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab27301, &self.sessions[si].externalSessionId, 0);
            auggieProtocol_buildAuggieInterrupt( cap_aab27301, self.sessions[si].externalSessionId_len, frame_text_p, 1024, &frame_len);
            writeStdinText(self, frame_text_p, frame_len);
        };
        if si != 4294967295 && self.sessions[si].has_activeTurnId {
            let turnId = [0u8; 128];
            let turnId_p: ptr = PTR_NULL(); PTR_BYTE_ADD(turnId_p, &turnId, 0);
            let cap_aab26582: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26582, &self.sessions[si].activeTurnId, 0);
            let turnId_len = aab_buf_copy(turnId_p, 128, cap_aab26582, self.sessions[si].activeTurnId_len);
            flushStreamedAssistant(self, si, turnId_p, turnId_len);
            emitTurnUsageNotification(self, si, turnId_p, turnId_len);
            self.sessions[si].has_activeTurnId = false;
            for i in 0..self.sessions[si].turn_count {
                let cap_aab26207: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26207, &self.sessions[si].turns[i].id, 0);
                if self.sessions[si].turns[i].id_len == turnId_len && aab_bytes_eq( cap_aab26207, turnId_p, turnId_len) {
                    let cap_aab26520: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26520, &self.sessions[si].turns[i].status, 0);
                    self.sessions[si].turns[i].status_len = aab_buf_copy( cap_aab26520, 32, STR_PTR("interrupted"), STR_LEN("interrupted"));
                    break;
                };
            }
            let frame = aab_json_object_new();
            aab_sa_json_object_set_string(frame, STR_PTR("method"), STR_LEN("method"), STR_PTR("turn/interrupted"), STR_LEN("turn/interrupted"));
            let fp = aab_json_object_new();
            aab_sa_json_object_set_string(fp, STR_PTR("threadId"), STR_LEN("threadId"), threadId_ptr, threadId_len);
            aab_sa_json_object_set_string(fp, STR_PTR("turnId"), STR_LEN("turnId"), turnId_p, turnId_len);
            let turn = aab_json_object_new();
            aab_sa_json_object_set_string(turn, STR_PTR("id"), STR_LEN("id"), turnId_p, turnId_len);
            aab_sa_json_object_set_string(turn, STR_PTR("threadId"), STR_LEN("threadId"), threadId_ptr, threadId_len);
            aab_sa_json_object_set_string(turn, STR_PTR("status"), STR_LEN("status"), STR_PTR("interrupted"), STR_LEN("interrupted"));
            aab_sa_json_object_set_number(turn, STR_PTR("completedAt"), STR_LEN("completedAt"), aab_now_ms() / 1000);
            sa_json_object_set_node(fp, STR_PTR("turn"), STR_LEN("turn"), turn);
            sa_json_object_set_node(frame, STR_PTR("params"), STR_LEN("params"), fp);
            bridge_emit_message(self, frame);
        };
        *out_len = aab_buf_copy(out, out_cap, STR_PTR("{}"), 2);
        return;
    };
    handle_method_reads(self, method_ptr, method_len, p, out, out_cap, out_len, out_err, out_err_cap, out_err_len);
}

// handle_method_reads: thread/read|resume, thread/list,
// turns/items lists, close family, name/goal/inject,
// history stubs, config writes, compact, approval
// echoes, default {}.
fn handle_method_reads(self: &AuggieAgentBridge, method_ptr: ptr, method_len: u64, p: u64, out: ptr, out_cap: u64, out_len: &u64, out_err: ptr, out_err_cap: u64, out_err_len: &u64) -> void {
    if aab_str_is(method_ptr, method_len, STR_PTR("thread/read"), STR_LEN("thread/read")) || aab_str_is(method_ptr, method_len, STR_PTR("thread/resume"), STR_LEN("thread/resume")) {
        let is_resume = aab_str_is(method_ptr, method_len, STR_PTR("thread/resume"), STR_LEN("thread/resume"));
        let threadId_ptr: ptr = PTR_NULL();
        let threadId_len: u64 = 0;
        sa_json_object_get_string(p, STR_PTR("threadId"), STR_LEN("threadId"), &threadId_ptr, &threadId_len);
        let si = find_session(self, threadId_ptr, threadId_len);
        if si == 4294967295 && is_resume {
            let restored_si: u64 = 0;
            if restoreAuggieThreadFromDisk(self, threadId_ptr, threadId_len, p, &restored_si) {
                si = restored_si;
            };
        };
        if si == 4294967295 {
            let msg = [0u8; 512];
            let msg_len: u64 = 0;
            let cap_ab58: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ab58, &msg, 0);
            msg_len = msg_len + aab_append_bytes(cap_ab58, 512, msg_len, STR_PTR("Unknown thread: "), STR_LEN("Unknown thread: "));
            let cap_ab59: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_ab59, &msg, 0);
            msg_len = msg_len + aab_append_bytes(cap_ab59, 512, msg_len, threadId_ptr, threadId_len);
            let cap_aab26583: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26583, &msg, 0);
            *out_err_len = aab_buf_copy(out_err, out_err_cap, cap_aab26583, msg_len);
            return;
        };
        let include_turns = true;
        let it_node: u64 = 0;
        if sa_json_object_get(p, STR_PTR("includeTurns"), STR_LEN("includeTurns"), &it_node) == 0 && it_node != 0 {
            let is_bool = false;
            aab_json_node_is_bool(it_node, &is_bool);
            if is_bool {
                let bv = false;
                aab_json_node_bool_value(it_node, &bv);
                include_turns = bv;
            };
        };
        let doc = aab_json_object_new();
        let thread = aab_json_object_new();
        aab_sa_json_object_set_string(thread, STR_PTR("id"), STR_LEN("id"), threadId_ptr, threadId_len);
        let cap_aab26751: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26751, &self.sessions[si].parentThreadId, 0);
        if self.sessions[si].has_parentThreadId { aab_sa_json_object_set_string(thread, STR_PTR("parentThreadId"), STR_LEN("parentThreadId"), cap_aab26751, self.sessions[si].parentThreadId_len); };
        let cap_aab26752: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26752, &self.sessions[si].preview, 0);
        if self.sessions[si].has_preview { aab_sa_json_object_set_string(thread, STR_PTR("preview"), STR_LEN("preview"), cap_aab26752, self.sessions[si].preview_len); };
        let cap_aab26753: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26753, &self.sessions[si].agentNickname, 0);
        if self.sessions[si].has_agentNickname { aab_sa_json_object_set_string(thread, STR_PTR("agentNickname"), STR_LEN("agentNickname"), cap_aab26753, self.sessions[si].agentNickname_len); };
        let cap_aab26754: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26754, &self.sessions[si].agentRole, 0);
        if self.sessions[si].has_agentRole { aab_sa_json_object_set_string(thread, STR_PTR("agentRole"), STR_LEN("agentRole"), cap_aab26754, self.sessions[si].agentRole_len); };
        let cap_aab26755: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26755, &self.sessions[si].model, 0);
        if self.sessions[si].has_model { aab_sa_json_object_set_string(thread, STR_PTR("model"), STR_LEN("model"), cap_aab26755, self.sessions[si].model_len); };
        aab_sa_json_object_set_string(thread, STR_PTR("cliBackend"), STR_LEN("cliBackend"), STR_PTR("auggie"), STR_LEN("auggie"));
        let status = aab_json_object_new();
        aab_sa_json_object_set_string(status, STR_PTR("type"), STR_LEN("type"), STR_PTR("idle"), STR_LEN("idle"));
        sa_json_object_set_node(thread, STR_PTR("status"), STR_LEN("status"), status);
        let cap_aab26756: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26756, &self.sessions[si].cwd, 0);
        if self.sessions[si].has_cwd { aab_sa_json_object_set_string(thread, STR_PTR("cwd"), STR_LEN("cwd"), cap_aab26756, self.sessions[si].cwd_len); };
        let turns = aab_json_array_new();
        if include_turns {
            for ti in 0..self.sessions[si].turn_count {
                let turn = aab_json_object_new();
                let cap_aab26757: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26757, &self.sessions[si].turns[ti].id, 0);
                aab_sa_json_object_set_string(turn, STR_PTR("id"), STR_LEN("id"), cap_aab26757, self.sessions[si].turns[ti].id_len);
                aab_sa_json_object_set_string(turn, STR_PTR("threadId"), STR_LEN("threadId"), threadId_ptr, threadId_len);
                let cap_aab26758: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26758, &self.sessions[si].turns[ti].status, 0);
                aab_sa_json_object_set_string(turn, STR_PTR("status"), STR_LEN("status"), cap_aab26758, self.sessions[si].turns[ti].status_len);
                aab_sa_json_object_set_number(turn, STR_PTR("startedAt"), STR_LEN("startedAt"), self.sessions[si].turns[ti].created_at / 1000);
                let items = aab_json_array_new();
                for mi in 0..self.sessions[si].msg_count {
                    let cap_aab26189: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26189, &self.sessions[si].msg_arena, 0);
                    let entry = sa_json_parse(aab_byte_off( cap_aab26189, self.sessions[si].msg_off[mi]), self.sessions[si].msg_len[mi]);
                    if entry == 0 { continue; };
                    let t_ptr: ptr = PTR_NULL();
                    let t_len: u64 = 0;
                    let cap_aab26731: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26731, &self.sessions[si].turns[ti].id, 0);
                    if sa_json_object_get_string(entry, STR_PTR("turnId"), STR_LEN("turnId"), &t_ptr, &t_len) == 0 && t_len == self.sessions[si].turns[ti].id_len && aab_bytes_eq(t_ptr, cap_aab26731, t_len) {
                        sa_json_array_push_node(items, entry);
                    };
                }
                sa_json_object_set_node(turn, STR_PTR("items"), STR_LEN("items"), items);
                sa_json_array_push_node(turns, turn);
            }
        };
        sa_json_object_set_node(thread, STR_PTR("turns"), STR_LEN("turns"), turns);
        sa_json_object_set_node(doc, STR_PTR("thread"), STR_LEN("thread"), thread);
        let items = aab_json_array_new();
        for mi in 0..self.sessions[si].msg_count {
            let cap_aab26190: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26190, &self.sessions[si].msg_arena, 0);
            let entry = sa_json_parse(aab_byte_off( cap_aab26190, self.sessions[si].msg_off[mi]), self.sessions[si].msg_len[mi]);
            if entry != 0 { sa_json_array_push_node(items, entry); };
        }
        sa_json_object_set_node(doc, STR_PTR("items"), STR_LEN("items"), items);
        *out_len = aab_stringify_into(doc, out, out_cap);
        return;
    };
    if aab_str_is(method_ptr, method_len, STR_PTR("thread/list"), STR_LEN("thread/list")) {
        let doc = aab_json_object_new();
        let data = aab_json_array_new();
        for si in 0..self.session_count {
            let thread = aab_json_object_new();
            let cap_aab26759: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26759, &self.sessions[si].threadId, 0);
            aab_sa_json_object_set_string(thread, STR_PTR("id"), STR_LEN("id"), cap_aab26759, self.sessions[si].threadId_len);
            let cap_aab26760: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26760, &self.sessions[si].parentThreadId, 0);
            if self.sessions[si].has_parentThreadId { aab_sa_json_object_set_string(thread, STR_PTR("parentThreadId"), STR_LEN("parentThreadId"), cap_aab26760, self.sessions[si].parentThreadId_len); };
            let cap_aab26761: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26761, &self.sessions[si].preview, 0);
            if self.sessions[si].has_preview { aab_sa_json_object_set_string(thread, STR_PTR("preview"), STR_LEN("preview"), cap_aab26761, self.sessions[si].preview_len); };
            let cap_aab26762: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26762, &self.sessions[si].agentNickname, 0);
            if self.sessions[si].has_agentNickname { aab_sa_json_object_set_string(thread, STR_PTR("agentNickname"), STR_LEN("agentNickname"), cap_aab26762, self.sessions[si].agentNickname_len); };
            let cap_aab26763: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26763, &self.sessions[si].agentRole, 0);
            if self.sessions[si].has_agentRole { aab_sa_json_object_set_string(thread, STR_PTR("agentRole"), STR_LEN("agentRole"), cap_aab26763, self.sessions[si].agentRole_len); };
            let cap_aab26764: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26764, &self.sessions[si].model, 0);
            if self.sessions[si].has_model { aab_sa_json_object_set_string(thread, STR_PTR("model"), STR_LEN("model"), cap_aab26764, self.sessions[si].model_len); };
            aab_sa_json_object_set_string(thread, STR_PTR("cliBackend"), STR_LEN("cliBackend"), STR_PTR("auggie"), STR_LEN("auggie"));
            let status = aab_json_object_new();
            aab_sa_json_object_set_string(status, STR_PTR("type"), STR_LEN("type"), STR_PTR("idle"), STR_LEN("idle"));
            sa_json_object_set_node(thread, STR_PTR("status"), STR_LEN("status"), status);
            let cap_aab26765: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26765, &self.sessions[si].cwd, 0);
            if self.sessions[si].has_cwd { aab_sa_json_object_set_string(thread, STR_PTR("cwd"), STR_LEN("cwd"), cap_aab26765, self.sessions[si].cwd_len); };
            let secs = self.sessions[si].created_at / 1000;
            aab_sa_json_object_set_number(thread, STR_PTR("createdAt"), STR_LEN("createdAt"), secs);
            aab_sa_json_object_set_number(thread, STR_PTR("updatedAt"), STR_LEN("updatedAt"), secs);
            aab_sa_json_object_set_number(thread, STR_PTR("recencyAt"), STR_LEN("recencyAt"), secs);
            aab_sa_json_object_set_string(thread, STR_PTR("source"), STR_LEN("source"), STR_PTR("appServer"), STR_LEN("appServer"));
            sa_json_object_set_node(thread, STR_PTR("turns"), STR_LEN("turns"), aab_json_array_new());
            sa_json_array_push_node(data, thread);
        }
        sa_json_object_set_node(doc, STR_PTR("data"), STR_LEN("data"), data);
        *out_len = aab_stringify_into(doc, out, out_cap);
        return;
    };
    if aab_str_is(method_ptr, method_len, STR_PTR("thread/turns/list"), STR_LEN("thread/turns/list")) {
        let threadId_ptr: ptr = PTR_NULL();
        let threadId_len: u64 = 0;
        sa_json_object_get_string(p, STR_PTR("threadId"), STR_LEN("threadId"), &threadId_ptr, &threadId_len);
        let si = find_session(self, threadId_ptr, threadId_len);
        let doc = aab_json_object_new();
        let turns = aab_json_array_new();
        if si != 4294967295 {
            for ti in 0..self.sessions[si].turn_count {
                let turn = aab_json_object_new();
                let cap_aab26766: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26766, &self.sessions[si].turns[ti].id, 0);
                aab_sa_json_object_set_string(turn, STR_PTR("id"), STR_LEN("id"), cap_aab26766, self.sessions[si].turns[ti].id_len);
                let cap_aab26767: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26767, &self.sessions[si].turns[ti].status, 0);
                aab_sa_json_object_set_string(turn, STR_PTR("status"), STR_LEN("status"), cap_aab26767, self.sessions[si].turns[ti].status_len);
                aab_sa_json_object_set_number(turn, STR_PTR("createdAt"), STR_LEN("createdAt"), self.sessions[si].turns[ti].created_at);
                sa_json_array_push_node(turns, turn);
            }
        };
        sa_json_object_set_node(doc, STR_PTR("turns"), STR_LEN("turns"), turns);
        *out_len = aab_stringify_into(doc, out, out_cap);
        return;
    };
    if aab_str_is(method_ptr, method_len, STR_PTR("thread/items/list"), STR_LEN("thread/items/list")) {
        let threadId_ptr: ptr = PTR_NULL();
        let threadId_len: u64 = 0;
        sa_json_object_get_string(p, STR_PTR("threadId"), STR_LEN("threadId"), &threadId_ptr, &threadId_len);
        let si = find_session(self, threadId_ptr, threadId_len);
        let doc = aab_json_object_new();
        let items = aab_json_array_new();
        if si != 4294967295 {
            for mi in 0..self.sessions[si].msg_count {
                let cap_aab26191: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26191, &self.sessions[si].msg_arena, 0);
                let entry = sa_json_parse(aab_byte_off( cap_aab26191, self.sessions[si].msg_off[mi]), self.sessions[si].msg_len[mi]);
                if entry != 0 { sa_json_array_push_node(items, entry); };
            }
        };
        sa_json_object_set_node(doc, STR_PTR("items"), STR_LEN("items"), items);
        *out_len = aab_stringify_into(doc, out, out_cap);
        return;
    };
    if aab_str_is(method_ptr, method_len, STR_PTR("thread/fork"), STR_LEN("thread/fork")) {
        *out_err_len = aab_buf_copy(out_err, out_err_cap, STR_PTR("Auggie backend does not support thread/fork"), STR_LEN("Auggie backend does not support thread/fork"));
        return;
    };
    if aab_str_is(method_ptr, method_len, STR_PTR("thread/archive"), STR_LEN("thread/archive")) || aab_str_is(method_ptr, method_len, STR_PTR("thread/delete"), STR_LEN("thread/delete")) || aab_str_is(method_ptr, method_len, STR_PTR("thread/unsubscribe"), STR_LEN("thread/unsubscribe")) || aab_str_is(method_ptr, method_len, STR_PTR("thread/closed"), STR_LEN("thread/closed")) {
        let threadId_ptr: ptr = PTR_NULL();
        let threadId_len: u64 = 0;
        sa_json_object_get_string(p, STR_PTR("threadId"), STR_LEN("threadId"), &threadId_ptr, &threadId_len);
        if threadId_len > 0 {
            let si = find_session(self, threadId_ptr, threadId_len);
            if si != 4294967295 {
                for i in si + 1..self.session_count {
                    self.sessions[i - 1] = self.sessions[i];
                }
                self.session_count = self.session_count - 1;
            };
            unmap_thread(self, threadId_ptr, threadId_len);
            let notify_ptr: ptr = PTR_NULL();
            let notify_len: u64 = 0;
            if aab_str_is(method_ptr, method_len, STR_PTR("thread/archive"), STR_LEN("thread/archive")) { notify_ptr = STR_PTR("thread/archived"); notify_len = STR_LEN("thread/archived"); } else if aab_str_is(method_ptr, method_len, STR_PTR("thread/delete"), STR_LEN("thread/delete")) { notify_ptr = STR_PTR("thread/deleted"); notify_len = STR_LEN("thread/deleted"); } else if aab_str_is(method_ptr, method_len, STR_PTR("thread/closed"), STR_LEN("thread/closed")) { notify_ptr = STR_PTR("thread/closed"); notify_len = STR_LEN("thread/closed"); };
            if notify_len > 0 {
                let frame = aab_json_object_new();
                aab_sa_json_object_set_string(frame, STR_PTR("method"), STR_LEN("method"), notify_ptr, notify_len);
                let fp = aab_json_object_new();
                aab_sa_json_object_set_string(fp, STR_PTR("threadId"), STR_LEN("threadId"), threadId_ptr, threadId_len);
                sa_json_object_set_node(frame, STR_PTR("params"), STR_LEN("params"), fp);
                bridge_emit_message(self, frame);
            };
        };
        *out_len = aab_buf_copy(out, out_cap, STR_PTR("{}"), 2);
        return;
    };
    if aab_str_is(method_ptr, method_len, STR_PTR("thread/name/set"), STR_LEN("thread/name/set")) {
        let threadId_ptr: ptr = PTR_NULL();
        let threadId_len: u64 = 0;
        sa_json_object_get_string(p, STR_PTR("threadId"), STR_LEN("threadId"), &threadId_ptr, &threadId_len);
        let name_ptr: ptr = PTR_NULL();
        let name_len: u64 = 0;
        sa_json_object_get_string(p, STR_PTR("name"), STR_LEN("name"), &name_ptr, &name_len);
        let si = find_session(self, threadId_ptr, threadId_len);
        if si != 4294967295 {
            let cap_aab26521: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_aab26521, &self.sessions[si].preview, 0);
            self.sessions[si].preview_len = aab_buf_copy( cap_aab26521, 1024, name_ptr, name_len);
            self.sessions[si].has_preview = true;
        };
        let doc = aab_json_object_new();
        aab_sa_json_object_set_string(doc, STR_PTR("threadId"), STR_LEN("threadId"), threadId_ptr, threadId_len);
        aab_sa_json_object_set_string(doc, STR_PTR("name"), STR_LEN("name"), name_ptr, name_len);
        *out_len = aab_stringify_into(doc, out, out_cap);
        return;
    };
    if aab_str_is(method_ptr, method_len, STR_PTR("thread/goal/set"), STR_LEN("thread/goal/set")) {
        let threadId_ptr: ptr = PTR_NULL();
        let threadId_len: u64 = 0;
        sa_json_object_get_string(p, STR_PTR("threadId"), STR_LEN("threadId"), &threadId_ptr, &threadId_len);
        let doc = aab_json_object_new();
        aab_sa_json_object_set_string(doc, STR_PTR("threadId"), STR_LEN("threadId"), threadId_ptr, threadId_len);
        aab_sa_json_object_set_string(doc, STR_PTR("status"), STR_LEN("status"), STR_PTR("active"), STR_LEN("active"));
        *out_len = aab_stringify_into(doc, out, out_cap);
        return;
    };
    if aab_str_is(method_ptr, method_len, STR_PTR("thread/goal/get"), STR_LEN("thread/goal/get")) {
        let threadId_ptr: ptr = PTR_NULL();
        let threadId_len: u64 = 0;
        sa_json_object_get_string(p, STR_PTR("threadId"), STR_LEN("threadId"), &threadId_ptr, &threadId_len);
        let doc = aab_json_object_new();
        // status: null — assembled as raw JSON text
        let text = [0u8; 512];
        let text_p: ptr = PTR_NULL(); PTR_BYTE_ADD(text_p, &text, 0);
        let text_len: u64 = 0;
        text_len = text_len + aab_append_bytes(text_p, 512, text_len, STR_PTR("{\"threadId\":\""), STR_LEN("{\"threadId\":\""));
        text_len = text_len + aab_append_bytes(text_p, 512, text_len, threadId_ptr, threadId_len);
        text_len = text_len + aab_append_bytes(text_p, 512, text_len, STR_PTR("\",\"status\":null}"), STR_LEN("\",\"status\":null}"));
        *out_len = aab_buf_copy(out, out_cap, text_p, text_len);
        return;
    };
    if aab_str_is(method_ptr, method_len, STR_PTR("thread/inject_items"), STR_LEN("thread/inject_items")) {
        let threadId_ptr: ptr = PTR_NULL();
        let threadId_len: u64 = 0;
        sa_json_object_get_string(p, STR_PTR("threadId"), STR_LEN("threadId"), &threadId_ptr, &threadId_len);
        let si = find_session(self, threadId_ptr, threadId_len);
        let items: u64 = 0;
        if si != 4294967295 && sa_json_object_get(p, STR_PTR("items"), STR_LEN("items"), &items) == 0 && items != 0 {
            let count: u64 = 0;
            sa_json_value_count(items, &count);
            for i in 0..count {
                let entry: u64 = 0;
                sa_json_array_get(items, i, &entry);
                if entry != 0 {
                    let text = [0u8; 262144];
                    let text_p: ptr = PTR_NULL(); PTR_BYTE_ADD(text_p, &text, 0);
                    let text_len = aab_stringify_into(entry, text_p, 262144);
                    session_msg_push(&self.sessions[si], text_p, text_len);
                };
            }
        };
        *out_len = aab_buf_copy(out, out_cap, STR_PTR("{}"), 2);
        return;
    };
    if aab_str_is(method_ptr, method_len, STR_PTR("thread/history/fileInfo"), STR_LEN("thread/history/fileInfo")) {
        *out_len = aab_buf_copy(out, out_cap, STR_PTR("{\"exists\":false}"), STR_LEN("{\"exists\":false}"));
        return;
    };
    if aab_str_is(method_ptr, method_len, STR_PTR("thread/history/tail"), STR_LEN("thread/history/tail")) {
        *out_len = aab_buf_copy(out, out_cap, STR_PTR("{\"lines\":[]}"), STR_LEN("{\"lines\":[]}"));
        return;
    };
    if aab_str_is(method_ptr, method_len, STR_PTR("config/value/write"), STR_LEN("config/value/write")) || aab_str_is(method_ptr, method_len, STR_PTR("config/batchWrite"), STR_LEN("config/batchWrite")) {
        *out_err_len = aab_buf_copy(out_err, out_err_cap, STR_PTR("Codex config writes are not supported in auggie backend mode"), STR_LEN("Codex config writes are not supported in auggie backend mode"));
        return;
    };
    // thread/goal/clear, thread/tokenUsage/updated,
    // thread/compact/start, approval echoes, default
    *out_len = aab_buf_copy(out, out_cap, STR_PTR("{}"), 2);
}

// ---- declared-by-use shims + local helpers ----
// Same shim set (and signatures) as the unit's other
// files; canonical homes are sdk-backend json/process
// and sa_std. ts_trim_span 已绑 sa_std ts 面
// (@ts_str_trim).

fn aab_byte_at(p: ptr, i: u64) -> u8 {
    // FIX(be2): fabricated `as [u8]` byte view replaced by the real macro.
    return PTR_BYTE_AT(p, i);
}

fn aab_byte_off(p: ptr, i: u64) -> ptr {
    return PTR_ADD(p, i);
}

fn aab_bytes_eq(a: ptr, b: ptr, n: u64) -> bool {
    for i in 0..n {
        if aab_byte_at(a, i) != aab_byte_at(b, i) { return false; };
    }
    return true;
}

fn aab_starts_with(p: ptr, n: u64, prefix: ptr, prefix_len: u64) -> bool {
    if prefix_len > n { return false; };
    return aab_bytes_eq(p, prefix, prefix_len);
}

fn ends_with(p: ptr, n: u64, suffix: ptr, suffix_len: u64) -> bool {
    if suffix_len > n { return false; };
    return aab_bytes_eq(aab_byte_off(p, n - suffix_len), suffix, suffix_len);
}

fn ends_with_ci(p: ptr, n: u64, suffix: ptr, suffix_len: u64) -> bool {
    if suffix_len > n { return false; };
    let lowered = [0u8; 64];
    let lowered_p: ptr = PTR_NULL(); PTR_BYTE_ADD(lowered_p, &lowered, 0);
    let lowered_len = aab_to_lower(lowered_p, 64, aab_byte_off(p, n - suffix_len), suffix_len);
    return aab_bytes_eq(lowered_p, suffix, lowered_len);
}

fn aab_str_is(p: ptr, n: u64, lit_ptr: ptr, lit_len: u64) -> bool {
    return n == lit_len && aab_bytes_eq(p, lit_ptr, n);
}

fn aab_is_ascii_ws(b: u8) -> bool {
    return b == 32 || b == 9 || b == 10 || b == 13;
}

fn aab_buf_copy(out: ptr, out_cap: u64, src: ptr, src_len: u64) -> u64 {
    let n = src_len;
    if n > out_cap { n = out_cap; };
    for i in 0..n {
        PTR_WRITE_U8(aab_byte_off(out, i), aab_byte_at(src, i));
    }
    return n;
}

fn aab_append_bytes(out: ptr, out_cap: u64, used: u64, src: ptr, src_len: u64) -> u64 {
    let n: u64 = 0;
    while n < src_len && used + n < out_cap {
        PTR_WRITE_U8(aab_byte_off(out, used + n), aab_byte_at(src, n));
        n = n + 1;
    }
    return n;
}

fn aab_append_u64(out: ptr, out_cap: u64, used: u64, v: u64) -> u64 {
    let digits = [0u8; 20];
    let digits_p: ptr = PTR_NULL(); PTR_BYTE_ADD(digits_p, &digits, 0);
    let count: u64 = 0;
    let x = v;
    if x == 0 {
        digits[0] = 48;
        count = 1;
    } else {
        let rev = [0u8; 20];
        let rev_p: ptr = PTR_NULL(); PTR_BYTE_ADD(rev_p, &rev, 0);
        let rc: u64 = 0;
        while x > 0 {
            rev[rc] = 48 + (x % 10) as u8;
            rc = rc + 1;
            x = x / 10;
        }
        while rc > 0 {
            rc = rc - 1;
            digits[count] = rev[rc];
            count = count + 1;
        }
    };
    return aab_append_bytes(out, out_cap, used, digits_p, count);
}

fn aab_append_i64(out: ptr, out_cap: u64, used: u64, v: i64) -> u64 {
    let n: u64 = 0;
    if v < 0 {
        n = n + aab_append_bytes(out, out_cap, used + n, STR_PTR("-"), 1);
        return n + aab_append_u64(out, out_cap, used + n, (0 - v) as u64);
    };
    return aab_append_u64(out, out_cap, used, v as u64);
}

fn aab_find_byte(p: ptr, n: u64, start: u64, target: u8) -> u64 {
    let i = start;
    while i < n {
        if aab_byte_at(p, i) == target { return i; };
        i = i + 1;
    }
    return 4294967295;
}

fn aab_find_substr(p: ptr, n: u64, needle: ptr, needle_len: u64) -> u64 {
    if needle_len == 0 || needle_len > n { return 4294967295; };
    let i: u64 = 0;
    while i + needle_len <= n {
        if aab_bytes_eq(aab_byte_off(p, i), needle, needle_len) { return i; };
        i = i + 1;
    }
    return 4294967295;
}

fn aab_contains_ci(p: ptr, n: u64, needle: ptr, needle_len: u64) -> bool {
    if needle_len == 0 || needle_len > n { return false; };
    let lowered = [0u8; 128];
    let lowered_p: ptr = PTR_NULL(); PTR_BYTE_ADD(lowered_p, &lowered, 0);
    let lowered_len = aab_to_lower(lowered_p, 128, needle, needle_len);
    let i: u64 = 0;
    while i + lowered_len <= n {
        let is_match = true;
        for j in 0..lowered_len {
            let b = aab_byte_at(p, i + j);
            let lb = if b >= 65 && b <= 90 { b + 32 } else { b };
            if lb != lowered[j] { is_match = false; break; };
        }
        if is_match { return true; };
        i = i + 1;
    }
    return false;
}

fn aab_to_lower(out: ptr, out_cap: u64, p: ptr, n: u64) -> u64 {
    let count = aab_buf_copy(out, out_cap, p, n);
    for i in 0..count {
        // FIX(be2): the bulk pass wrote a fabricated `as [u8]` byte view over
        // the ptr returned by aab_byte_off; use the real ptr byte macros.
        let v: u8 = PTR_BYTE_AT(out, i);
        if v >= 65 && v <= 90 {
            let wp: ptr = PTR_NULL();
            PTR_BYTE_ADD(wp, out, i);
            PTR_WRITE_U8(wp, v + 32);
        };
    }
    return count;
}

// ts_trim_span — 已绑 sa_std ts 面 (@ts_str_trim).
fn aab_ts_trim_span(p: ptr, n: u64, out_ptr: &ptr, out_len: &u64) -> void {
    aab_ts_str_trim(out_ptr, out_len, p, n);
}

fn aab_stringify_into(node: u64, out: ptr, out_cap: u64) -> u64 {
    if node == 0 { return 0; };
    // FIX(be2): sa_json_stringify takes (node, &out_handle); the 3-arg direct
    // buffer form was fabricated. Stringify to a handle, copy out clamped.
    let hb: u64 = 0;
    if sa_json_stringify(node, &hb) != 0 { return 0; };
    let dp: ptr = sa_json_buffer_data(hb);
    let dl: u64 = sa_json_buffer_len(hb);
    let n = dl;
    if n > out_cap { n = out_cap; };
    let i: u64 = 0;
    while i < n {
        let v: u8 = 0;
        PTR_BYTE_AT(v, dp, i);
        let wp: ptr = PTR_NULL();
        PTR_BYTE_ADD(wp, out, i);
        PTR_WRITE_U8(wp, v);
        i = i + 1;
    }
    return n;
}

fn join2(out: ptr, out_cap: u64, a: ptr, a_len: u64, b: ptr, b_len: u64) -> u64 {
    let n: u64 = 0;
    n = n + aab_append_bytes(out, out_cap, n, a, a_len);
    if a_len > 0 && aab_byte_at(a, a_len - 1) != 47 { n = n + aab_append_bytes(out, out_cap, n, STR_PTR("/"), 1); };
    n = n + aab_append_bytes(out, out_cap, n, b, b_len);
    return n;
}

fn join3(out: ptr, out_cap: u64, a: ptr, a_len: u64, b: ptr, b_len: u64, c: ptr, c_len: u64) -> u64 {
    let tmp = [0u8; 2048];
    let tmp_p: ptr = PTR_NULL(); PTR_BYTE_ADD(tmp_p, &tmp, 0);
    let tmp_len = join2(tmp_p, 2048, a, a_len, b, b_len);
    return join2(out, out_cap, tmp_p, tmp_len, c, c_len);
}

// env snapshot access (newline-joined KEY=VALUE text)
fn env_get(env_ptr: ptr, env_len: u64, key_ptr: ptr, key_len: u64, out_ptr: &ptr, out_len: &u64) -> bool {
    *out_len = 0;
    let pos: u64 = 0;
    while pos < env_len {
        let end = aab_find_byte(env_ptr, env_len, pos, 10);
        if end == 4294967295 { end = env_len; };
        let eq = aab_find_byte(env_ptr, end, pos, 61);
        if eq != 4294967295 && eq - pos == key_len && aab_bytes_eq(aab_byte_off(env_ptr, pos), key_ptr, key_len) {
            *out_ptr = aab_byte_off(env_ptr, eq + 1);
            *out_len = end - eq - 1;
            return true;
        };
        pos = end + 1;
    }
    return false;
}

fn env_set(env: ptr, env_cap: u64, env_len: &u64, key_ptr: ptr, key_len: u64, value_ptr: ptr, value_len: u64) -> void {
    // overwrite: rebuild without the old key, then append
    let kept = [0u8; 32768];
    let kept_p: ptr = PTR_NULL(); PTR_BYTE_ADD(kept_p, &kept, 0);
    let kept_len: u64 = 0;
    let pos: u64 = 0;
    let total = *env_len;
    while pos < total {
        let end = aab_find_byte(env, total, pos, 10);
        if end == 4294967295 { end = total; };
        let eq = aab_find_byte(env, end, pos, 61);
        let is_key = eq != 4294967295 && eq - pos == key_len && aab_bytes_eq(aab_byte_off(env, pos), key_ptr, key_len);
        if !is_key && end > pos {
            kept_len = kept_len + aab_append_bytes(kept_p, 32768, kept_len, aab_byte_off(env, pos), end - pos);
            kept_len = kept_len + aab_append_bytes(kept_p, 32768, kept_len, STR_PTR("\n"), 1);
        };
        pos = end + 1;
    }
    kept_len = kept_len + aab_append_bytes(kept_p, 32768, kept_len, key_ptr, key_len);
    kept_len = kept_len + aab_append_bytes(kept_p, 32768, kept_len, STR_PTR("="), 1);
    kept_len = kept_len + aab_append_bytes(kept_p, 32768, kept_len, value_ptr, value_len);
    kept_len = kept_len + aab_append_bytes(kept_p, 32768, kept_len, STR_PTR("\n"), 1);
    *env_len = aab_buf_copy(env, env_cap, kept_p, kept_len);
}

// JSON node-kind accessors (declared by use).
















// fs / process / host shims (declared by use).













// DEFECT: randomUUID has no std surface in this pass —
// the zero-UUID shim keeps generated ids deterministic.
fn aab_uuid_new(out: ptr, out_cap: u64) -> u64 {
    return aab_buf_copy(out, out_cap, STR_PTR("00000000-0000-0000-0000-000000000000"), STR_LEN("00000000-0000-0000-0000-000000000000"));
}

// DEFECT: Date.now() has no verified std clock surface
// in this pass; timestamps collapse to 0 (deadline-based
// watchdogs degenerate accordingly).
fn aab_now_ms() -> i64 {
    return 0;
}

// ---------------------------------------------------------------------------
// FIX (declaration block binding): the bodyless declarations that
// trailed this file were converter inventions for TS runtime
// queries. They are now definitions over the real sa_std faces:
// JSON via encoding/json.sai (kind numbers 0 null, 1 bool,
// 2 int, 3 float, 4 number-string, 5 string, 6 array, 7 object);
// object/array construction via sa_json_parse of "{}" / "[]"
// (json.sai has no constructor externs); fs via fs.sai; process
// via process.sai; platform via the OS env probe.
// ---------------------------------------------------------------------------

fn aab_json_node_is_string(node: u64, out: &bool) -> void { *out = sa_json_kind(node) == 5; }
fn aab_json_node_is_array(node: u64, out: &bool) -> void { *out = sa_json_kind(node) == 6; }
fn aab_json_node_is_object(node: u64, out: &bool) -> void { *out = sa_json_kind(node) == 7; }
fn aab_json_node_is_bool(node: u64, out: &bool) -> void { *out = sa_json_kind(node) == 1; }
fn aab_json_node_is_null(node: u64, out: &bool) -> void { *out = sa_json_kind(node) == 0; }

fn aab_json_node_string(node: u64, out_ptr: &ptr, out_len: &u64) -> void {
    if sa_json_kind(node) != 5 { *out_len = 0; return; };
    let p: ptr = sa_json_string_ptr(node);
    *out_ptr = p;
    *out_len = sa_json_string_len(node);
}

fn aab_json_node_bool_value(node: u64, out: &bool) -> void {
    let bv: u8 = 0;
    if sa_json_as_bool(node, &bv) != 0 { *out = false; return; };
    *out = bv != 0;
}

fn aab_json_node_number(node: u64, key_ptr: ptr, key_len: u64, out: &i64) -> bool {
    let child: u64 = 0;
    if sa_json_object_get(node, key_ptr, key_len, &child) != 0 { return false; };
    return sa_json_as_i64(child, out) == 0;
}

fn aab_json_object_new() -> u64 {
    return sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
}

fn aab_json_array_new() -> u64 {
    return sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
}

// Keys serialized newline-joined (the consumer splits on byte 10).
fn aab_json_object_keys(node: u64, out: ptr, out_cap: u64) -> u64 {
    let n: u64 = 0;
    let idx: u64 = 0;
    let kp: ptr = PTR_NULL();
    let kl: u64 = 0;
    while sa_json_object_key_at(node, idx, &kp, &kl) == 0 {
        if idx > 0 {
            if n < out_cap {
                let wp: ptr = PTR_NULL();
                PTR_BYTE_ADD(wp, out, n);
                PTR_WRITE_U8(wp, 10);
            };
            n = n + 1;
        };
        for i in 0..kl {
            if n < out_cap {
                let b: u8 = 0;
                PTR_BYTE_AT(b, kp, i);
                let wp: ptr = PTR_NULL();
                PTR_BYTE_ADD(wp, out, n);
                PTR_WRITE_U8(wp, b);
            };
            n = n + 1;
        }
        idx = idx + 1;
    }
    return n;
}

fn aab_sa_json_object_set_number(node: u64, key_ptr: ptr, key_len: u64, value: i64) -> void {
    sa_json_object_set_i64(node, key_ptr, key_len, value);
}

fn aab_sa_json_object_set_string(node: u64, key_ptr: ptr, key_len: u64, value_ptr: ptr, value_len: u64) -> void {
    sa_json_object_set_string(node, key_ptr, key_len, value_ptr, value_len);
}

fn aab_sa_json_object_set_bool(node: u64, key_ptr: ptr, key_len: u64, value: bool) -> void {
    let bv: u8 = 0;
    if value { bv = 1; };
    sa_json_object_set_bool(node, key_ptr, key_len, bv);
}

// FIX: std stringify has no pretty variant; the plain form is
// used (documented approximation — log/debug payloads only).
fn sa_json_stringify_pretty(node: u64, out: ptr, out_cap: u64) -> u64 {
    let h: u64 = 0;
    if sa_json_stringify(node, &h) != 0 { return 0; };
    let dp: ptr = sa_json_buffer_data(h);
    let dl: u64 = sa_json_buffer_len(h);
    let n = dl;
    if n > out_cap { n = out_cap; };
    for i in 0..n {
        let b: u8 = 0;
        PTR_BYTE_AT(b, dp, i);
        let wp: ptr = PTR_NULL();
        PTR_BYTE_ADD(wp, out, i);
        PTR_WRITE_U8(wp, b);
    }
    return n;
}

// FIX: sa_std_fs_exists returns a STATUS CODE (0 = exists,
// 3 = missing), not a boolean — the == 0 form is the correct
// polarity (named sweep, _defects/FIX_BACKENDS.md).
fn aab_fs_exists(path_ptr: ptr, path_len: u64) -> bool {
    return sa_std_fs_exists(path_ptr, path_len) == 0;
}

fn fs_read_file(path_ptr: ptr, path_len: u64, out: ptr, out_cap: u64, out_len: &u64) -> i32 {
    *out_len = 0;
    let h = sa_fs_read_file(path_ptr, path_len, out_cap);
    if h == 0 { return 1; };
    let dp: ptr = sa_fs_read_buffer_data(h);
    let dl: u64 = sa_fs_read_buffer_len(h);
    let n = dl;
    if n > out_cap { n = out_cap; };
    for i in 0..n {
        let b: u8 = 0;
        PTR_BYTE_AT(b, dp, i);
        let wp: ptr = PTR_NULL();
        PTR_BYTE_ADD(wp, out, i);
        PTR_WRITE_U8(wp, b);
    }
    *out_len = n;
    return 0;
}

fn fs_write_file(path_ptr: ptr, path_len: u64, data_ptr: ptr, data_len: u64) -> i32 {
    return sa_fs_write_file(path_ptr, path_len, data_ptr, data_len);
}

fn fs_mkdir_recursive(path_ptr: ptr, path_len: u64) -> i32 {
    return sa_fs_mkdir_p(path_ptr, path_len);
}

fn aab_env_handle_copy(h: u64, out: ptr, out_cap: u64) -> u64 {
    if h == 0 { return 0; };
    let dp: ptr = sa_env_buffer_data(h);
    let dl: u64 = sa_env_buffer_len(h);
    let n = dl;
    if n > out_cap { n = out_cap; };
    for i in 0..n {
        let b: u8 = 0;
        PTR_BYTE_AT(b, dp, i);
        let wp: ptr = PTR_NULL();
        PTR_BYTE_ADD(wp, out, i);
        PTR_WRITE_U8(wp, b);
    }
    return n;
}

fn process_cwd(out: ptr, out_cap: u64) -> u64 {
    return aab_env_handle_copy(sa_env_current_dir(), out, out_cap);
}

fn host_exec_path(out: ptr, out_cap: u64) -> u64 {
    return aab_env_handle_copy(sa_env_current_exe(), out, out_cap);
}

// FIX: the signal argument has no process.sai counterpart; the
// TS call sites pass SIGTERM-class signals whose SLA equivalent
// is the plain kill (documented approximation).
fn process_kill(proc: u64, signal: i32) -> i32 {
    return sa_std_process_kill(proc);
}

fn process_poll_exit(proc: u64, out_code: &i32) -> bool {
    let ready: u8 = 0;
    let code: u32 = 0;
    if sa_std_process_try_wait(proc, &ready, &code) != 0 { return false; };
    if ready == 0 { return false; };
    *out_code = code as i32;
    return true;
}

// FIX: process.platform probed via the OS env var (Windows_NT).
fn host_is_windows() -> bool {
    let h = sa_env_get(STR_PTR("OS"), STR_LEN("OS"));
    if h == 0 { return false; };
    let dp: ptr = sa_env_buffer_data(h);
    let dl: u64 = sa_env_buffer_len(h);
    if dl != STR_LEN("Windows_NT") { return false; };
    for i in 0..dl {
        let b: u8 = 0;
        PTR_BYTE_AT(b, dp, i);
        let e: u8 = 0;
        let ep: ptr = PTR_NULL();
        PTR_BYTE_ADD(ep, STR_PTR("Windows_NT"), i);
        PTR_BYTE_AT(e, ep, 0);
        if b != e { return false; };
    }
    return true;
}

// FIX: the SLA host is not Bun (documented host fact).
fn host_is_bun() -> bool {
    return false;
}

// FIX: TS taskkill /T /F on win32; the SLA counterpart is the
// process-group kill (call sites are is_windows-guarded).
fn host_taskkill_tree(proc: u64) -> bool {
    return sa_std_process_kill_process_group(proc) == 0;
}

// FIX: event logging binds the converted sdk-backend
// bridgeEventLog unit: the logger is a pure derivation from
// (backend, log dir), so it is recreated per call; the dir
// comes from CODEX_UI_DATA_DIR exactly as in the TS/sdk unit
// (absent -> the sdk unit resolves its own default).
fn host_event_log_frame(backend_ptr: ptr, backend_len: u64, payload_ptr: ptr, payload_len: u64) -> void {
    let dir: [u8; 1024] = [0u8; 1024];
    let dp: ptr = PTR_NULL();
    PTR_BYTE_ADD(dp, &dir, 0);
    let dl: u64 = 0;
    let dh = sa_env_get(STR_PTR("CODEX_UI_DATA_DIR"), STR_LEN("CODEX_UI_DATA_DIR"));
    if dh != 0 {
        let sp: ptr = sa_env_buffer_data(dh);
        let sl: u64 = sa_env_buffer_len(dh);
        let n = sl;
        if n > 1024 { n = 1024; };
        for i in 0..n {
            let b: u8 = 0;
            PTR_BYTE_AT(b, sp, i);
            let wp: ptr = PTR_NULL();
            PTR_BYTE_ADD(wp, dp, i);
            PTR_WRITE_U8(wp, b);
        }
        dl = n;
    };
    let logger = BridgeEventLogger { file: [0u8; 4096], file_len: 0, logDir: [0u8; 4096], logDir_len: 0, safeBackend: [0u8; 128], safeBackend_len: 0, ready: false };
    createBridgeEventLogger(backend_ptr, backend_len, dp, dl, dl > 0, &logger);
    append(&logger, payload_ptr, payload_len);
}
