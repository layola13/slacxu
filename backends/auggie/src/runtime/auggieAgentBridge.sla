    abt_text_used: u64,
    abt_turn_used: u64,
    // streamedAssistantByTurn: (turnId, itemId) -> text
    stm_turn: [u8; 65536],
    stm_turn_off: [u64; 256],
    stm_turn_len: [u64; 256],
    stm_item: [u8; 65536],
    stm_item_off: [u64; 256],
