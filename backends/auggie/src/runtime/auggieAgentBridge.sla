// Converted 1:1 from backends/auggie/src/runtime/auggieAgentBridge.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
// For learning and research only. Other uses are at your own risk.
//
// AuggieAgentBridge — bridges `auggie --acp` (Augment Code
// stdio ACP) to the Codex app-server JSON-RPC wire surface.
// ACP has no thread/turn abstraction — only initialize /
// session/new / session/prompt / session/cancel /
// session/request_permission / session/update. This
// bridge synthesises Codex notifications (thread/started,
// turn/started, item/agentMessage/delta, item/completed,
// item/*requestApproval, turn/completed, ...) from those
// ACP events.
//
// APPROVAL DIRECTION: auggie sends
// session/request_permission as a JSON-RPC request (with
// id) TO the host; the host replies with a
// result.outcome. We forward it to the UI as a Codex
// item/*requestApproval server request; when the UI
// answers, respond() writes buildAuggiePermissionResult
// back to auggie's stdin.
//
// Shape notes: the TS class + EventEmitter become a
// struct + fn family with an owner-pumped event queue
// ("message"/"stderr"/"status"/"auggie:raw" kinds);
// Promises become pending-request slots resolved by the
// pump (send_request_sync pumps until resolution for the
// call sites the source awaits inline); Maps become
// fixed-capacity slot tables; the redirector module
// singleton becomes an embedded AuggieRedirectorState.
// Timers (turn silence/stall) become deadlines fired by
// AuggieAgentBridge_poll.

@import "sa_std/fs.sai"
@import "sa_std/encoding/json.sai"
@import "sa_std/process.sai"
@import "sa_std/io.sai"
// FIX: bulk pass imported sdk-backend/src/json.sla, which does not exist in the sdk-backend unit (vestigial import removed; faces come from sa_std .sai imports).// FIX: bulk pass imported sdk-backend/src/process.sla, which does not exist in the sdk-backend unit (vestigial import removed; faces come from sa_std .sai imports).
@import "auggieCommand.sla"
@import "auggieRedirector.sla"
@import "auggieAcpProtocol.sla"
@import "sa_std/string.sai"
@import "sa_std/ptr.sa"
@import "sa_std/string.sa"
@import "sa_std/env.sai"
@import "../../../../sdk-backend/src/bridgeEventLog.sla"

fn aab_ts_str_trim(out_ptr: &ptr, out_len: &u64, p: ptr, n: u64) -> void {
    // Local replica of the SA-layer @ts_str_trim view semantics
    // (sci sa_std/ts_string.sa): ASCII trim of both ends over the
    // (p, n) view, built on the real string.sai externs.
    let start: u64 = sa_str_trim_ascii_start_index(p, n);
    let rest: ptr = PTR_NULL();
    PTR_BYTE_ADD(rest, p, start);
    let elen: u64 = sa_str_trim_ascii_end_len(rest, n - start);
    *out_ptr = rest;
    *out_len = elen;
}

// session/update discriminators the protocol module
// does not export guards for.
fn AUGGIE_SESSION_UPDATE_USER_MESSAGE_CHUNK_ptr() -> ptr { return STR_PTR("user_message_chunk"); }
fn AUGGIE_SESSION_UPDATE_USER_MESSAGE_CHUNK_len() -> u64 { return STR_LEN("user_message_chunk"); }
fn AUGGIE_SESSION_UPDATE_TOOL_CALL_ptr() -> ptr { return STR_PTR("tool_call"); }
fn AUGGIE_SESSION_UPDATE_TOOL_CALL_len() -> u64 { return STR_LEN("tool_call"); }
fn AUGGIE_SESSION_UPDATE_TOOL_CALL_UPDATE_ptr() -> ptr { return STR_PTR("tool_call_update"); }
fn AUGGIE_SESSION_UPDATE_TOOL_CALL_UPDATE_len() -> u64 { return STR_LEN("tool_call_update"); }

// AUGGIE_SUPPORTED_IMAGE_MIME_TYPES (audit §3)
fn auggie_supported_image_mime(i: u64, out_len: &u64) -> ptr {
    if i == 0 { *out_len = STR_LEN("image/jpeg"); return STR_PTR("image/jpeg"); };
    if i == 1 { *out_len = STR_LEN("image/png"); return STR_PTR("image/png"); };
    if i == 2 { *out_len = STR_LEN("image/gif"); return STR_PTR("image/gif"); };
    *out_len = STR_LEN("image/webp");
    return STR_PTR("image/webp");
}

// AUGGIE_MAX_IMAGES_PER_MESSAGE = 10;
// AUGGIE_MAX_IMAGE_BASE64_CHARS = 5 * 1024 * 1024.

// AUGGIE_PROCESS_FREE_METHODS — methods that must not
// require a running auggie child.
fn auggie_process_free_method(i: u64, out_len: &u64) -> ptr {
    if i == 0 { *out_len = STR_LEN("initialize"); return STR_PTR("initialize"); };
    if i == 1 { *out_len = STR_LEN("config/read"); return STR_PTR("config/read"); };
    if i == 2 { *out_len = STR_LEN("thread/fork"); return STR_PTR("thread/fork"); };
    if i == 3 { *out_len = STR_LEN("thread/read"); return STR_PTR("thread/read"); };
    if i == 4 { *out_len = STR_LEN("thread/resume"); return STR_PTR("thread/resume"); };
    if i == 5 { *out_len = STR_LEN("thread/list"); return STR_PTR("thread/list"); };
    if i == 6 { *out_len = STR_LEN("thread/turns/list"); return STR_PTR("thread/turns/list"); };
    if i == 7 { *out_len = STR_LEN("thread/items/list"); return STR_PTR("thread/items/list"); };
    if i == 8 { *out_len = STR_LEN("thread/name/set"); return STR_PTR("thread/name/set"); };
    if i == 9 { *out_len = STR_LEN("thread/goal/set"); return STR_PTR("thread/goal/set"); };
    if i == 10 { *out_len = STR_LEN("thread/goal/get"); return STR_PTR("thread/goal/get"); };
    if i == 11 { *out_len = STR_LEN("thread/goal/clear"); return STR_PTR("thread/goal/clear"); };
    if i == 12 { *out_len = STR_LEN("thread/inject_items"); return STR_PTR("thread/inject_items"); };
    if i == 13 { *out_len = STR_LEN("thread/history/fileInfo"); return STR_PTR("thread/history/fileInfo"); };
    if i == 14 { *out_len = STR_LEN("thread/history/tail"); return STR_PTR("thread/history/tail"); };
    if i == 15 { *out_len = STR_LEN("thread/tokenUsage/updated"); return STR_PTR("thread/tokenUsage/updated"); };
    if i == 16 { *out_len = STR_LEN("turn/interrupt"); return STR_PTR("turn/interrupt"); };
    if i == 17 { *out_len = STR_LEN("thread/archive"); return STR_PTR("thread/archive"); };
    if i == 18 { *out_len = STR_LEN("thread/delete"); return STR_PTR("thread/delete"); };
    if i == 19 { *out_len = STR_LEN("thread/unsubscribe"); return STR_PTR("thread/unsubscribe"); };
    *out_len = STR_LEN("thread/closed");
    return STR_PTR("thread/closed");
}

fn augNeedsRunningProcess(method_ptr: ptr, method_len: u64) -> bool {
    for i in 0..21 {
        let l: u64 = 0;
        let p = auggie_process_free_method(i, &l);
        if l == method_len && aab_bytes_eq(p, method_ptr, l) { return false; };
    }
    return true;
}

// stringifyError(error): the error text travels as a
// (ptr, len) pair in this conversion; passthrough.
fn stringifyError(err_ptr: ptr, err_len: u64, out: ptr, out_cap: u64) -> u64 {
    return aab_buf_copy(out, out_cap, err_ptr, err_len);
}

// redactSecrets(value): the source's three regex
// substitutions (sk-…, Bearer …, api_key=…) as hand
// scans. DEFECT: replacement is span-based here (the
// matched span is replaced by the literal mask); regex
// character classes are approximated by the token scans
// below.
fn redactSecrets(text_ptr: ptr, text_len: u64, out: ptr, out_cap: u64) -> u64 {
    let n: u64 = 0;
    let i: u64 = 0;
    while i < text_len {
        // sk-[A-Za-z0-9_-]{12,}
        if i + 3 <= text_len && aab_byte_at(text_ptr, i) == 115 && aab_byte_at(text_ptr, i + 1) == 107 && aab_byte_at(text_ptr, i + 2) == 45 {
            let j = i + 3;
            while j < text_len && is_secret_char(aab_byte_at(text_ptr, j)) { j = j + 1; }
            if j - (i + 3) >= 12 {
                n = n + aab_append_bytes(out, out_cap, n, STR_PTR("sk-***"), STR_LEN("sk-***"));
                i = j;
                continue;
            };
        };
        // Bearer\s+<token>{12,}
        if i + 6 <= text_len && aab_bytes_eq(aab_byte_off(text_ptr, i), STR_PTR("Bearer"), 6) {
            let j = i + 6;
            while j < text_len && aab_is_ascii_ws(aab_byte_at(text_ptr, j)) { j = j + 1; }
            let k = j;
            while k < text_len && is_bearer_char(aab_byte_at(text_ptr, k)) { k = k + 1; }
            if k - j >= 12 {
                n = n + aab_append_bytes(out, out_cap, n, STR_PTR("Bearer ***"), STR_LEN("Bearer ***"));
                i = k;
                continue;
            };
        };
        // api[_-]?key["'=:\s]+<token>{8,} — approximated:
        // the literal "api_key=" / "api-key" prefix forms.
        if i + 7 <= text_len && (aab_bytes_eq(aab_byte_off(text_ptr, i), STR_PTR("api_key"), 7) || aab_bytes_eq(aab_byte_off(text_ptr, i), STR_PTR("api-key"), 7) || aab_bytes_eq(aab_byte_off(text_ptr, i), STR_PTR("apikey"), 6)) {
            let plen: u64 = 7;
            if aab_bytes_eq(aab_byte_off(text_ptr, i), STR_PTR("apikey"), 6) && !aab_bytes_eq(aab_byte_off(text_ptr, i), STR_PTR("api_key"), 7) && !aab_bytes_eq(aab_byte_off(text_ptr, i), STR_PTR("api-key"), 7) { plen = 6; };
            let j = i + plen;
            while j < text_len && is_api_sep(aab_byte_at(text_ptr, j)) { j = j + 1; }
            let k = j;
            while k < text_len && is_bearer_char(aab_byte_at(text_ptr, k)) { k = k + 1; }
            if k - j >= 8 {
                n = n + aab_append_bytes(out, out_cap, n, STR_PTR("api_key=***"), STR_LEN("api_key=***"));
                i = k;
                continue;
            };
        };
        n = n + aab_append_bytes(out, out_cap, n, aab_byte_off(text_ptr, i), 1);
        i = i + 1;
    }
    return n;
}

fn is_secret_char(b: u8) -> bool {
    return (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || (b >= 48 && b <= 57) || b == 95 || b == 45;
}

fn is_bearer_char(b: u8) -> bool {
    return is_secret_char(b) || b == 46 || b == 126 || b == 43 || b == 47 || b == 61;
}

fn is_api_sep(b: u8) -> bool {
    return b == 34 || b == 39 || b == 61 || b == 58 || aab_is_ascii_ws(b);
}

// jsonRecord(value): object node or a fresh {}.
fn jsonRecord(value: u64) -> u64 {
    if value == 0 { return aab_json_object_new(); };
    let is_obj = false;
    aab_json_node_is_object(value, &is_obj);
    let is_arr = false;
    aab_json_node_is_array(value, &is_arr);
    if is_obj && !is_arr { return value; };
    return aab_json_object_new();
}

// normalizeAssistantText(value): \r\n -> \n, trim
// (trim 已绑 sa_std ts 面).
fn normalizeAssistantText(text_ptr: ptr, text_len: u64, out: ptr, out_cap: u64) -> u64 {
    let flat = [0u8; 262144];
    let flat_p: ptr = PTR_NULL(); PTR_BYTE_ADD(flat_p, &flat, 0);
    let flat_len: u64 = 0;
    let i: u64 = 0;
    while i < text_len {
        if i + 1 < text_len && aab_byte_at(text_ptr, i) == 13 && aab_byte_at(text_ptr, i + 1) == 10 {
            flat_len = flat_len + aab_append_bytes(flat_p, 262144, flat_len, STR_PTR("\n"), 1);
            i = i + 2;
        } else {
            flat_len = flat_len + aab_append_bytes(flat_p, 262144, flat_len, aab_byte_off(text_ptr, i), 1);
            i = i + 1;
        };
    }
    let tp: ptr = PTR_NULL();
    let tl: u64 = 0;
    aab_ts_trim_span(flat_p, flat_len, &tp, &tl);
    return aab_buf_copy(out, out_cap, tp, tl);
}

