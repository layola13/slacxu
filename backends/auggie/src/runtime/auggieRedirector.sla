// DEFECT: randomUUID has no std surface in this pass —
// the zero-UUID shim keeps request ids deterministic.
fn uuid_new(out: ptr, out_cap: u64) -> u64 {
    return ar_buf_copy(out, out_cap, STR_PTR("00000000-0000-0000-0000-000000000000"), STR_LEN("00000000-0000-0000-0000-000000000000"));
}

// DEFECT: Date.now() has no verified std clock surface
// in this pass; ledger timestamps collapse to 0.
fn now_ms() -> i64 {
    return 0;
}

