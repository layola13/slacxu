fn json_node_is_string(node: u64, out: &bool) -> void { *out = sa_json_kind(node) == 5; }
fn json_node_is_array(node: u64, out: &bool) -> void { *out = sa_json_kind(node) == 6; }
fn json_node_is_object(node: u64, out: &bool) -> void { *out = sa_json_kind(node) == 7; }
fn json_node_is_number(node: u64, out: &bool) -> void { let k = sa_json_kind(node); *out = k == 2 || k == 3 || k == 4; }
fn json_node_is_bool(node: u64, out: &bool) -> void { *out = sa_json_kind(node) == 1; }
fn json_node_is_null(node: u64, out: &bool) -> void { *out = sa_json_kind(node) == 0; }

fn json_node_string(node: u64, out_ptr: &ptr, out_len: &u64) -> void {
    if sa_json_kind(node) != 5 { *out_len = 0; return; };
    let p: ptr = sa_json_string_ptr(node);
    *out_ptr = p;
    *out_len = sa_json_string_len(node);
}

fn json_node_number_value(node: u64, out: &f64) -> void {
    if sa_json_as_f64(node, out) != 0 { *out = 0.0; };
}

fn json_node_bool_value(node: u64, out: &bool) -> void {
    let bv: u8 = 0;
    if sa_json_as_bool(node, &bv) != 0 { *out = false; return; };
    *out = bv != 0;
}

fn json_node_number(node: u64, key_ptr: ptr, key_len: u64, out: &i64) -> bool {
    let child: u64 = 0;
    if sa_json_object_get(node, key_ptr, key_len, &child) != 0 { return false; };
    return sa_json_as_i64(child, out) == 0;
}

fn json_node_number_f64(node: u64, key_ptr: ptr, key_len: u64, out: &f64, out_found: &bool) -> void {
    *out_found = false;
    let child: u64 = 0;
    if sa_json_object_get(node, key_ptr, key_len, &child) != 0 { return; };
    if sa_json_as_f64(child, out) != 0 { return; };
    *out_found = true;
}

fn json_object_new() -> u64 {
    return sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
}

fn json_array_new() -> u64 {
    return sa_json_parse(STR_PTR("[]"), STR_LEN("[]"));
}

// Keys serialized newline-joined (the consumer splits on byte 10).
fn json_object_keys(node: u64, out: ptr, out_cap: u64) -> u64 {
    let n: u64 = 0;
    let idx: u64 = 0;
    let kp: ptr = PTR_NULL();
    let kl: u64 = 0;
    while sa_json_object_key_at(node, idx, &kp, &kl) == 0 {
        if idx > 0 {
            if n < out_cap {
                let wp: ptr = PTR_NULL();
                PTR_BYTE_ADD(wp, out, n);
                PTR_WRITE_U8(wp, 10);
            };
            n = n + 1;
        };
        for i in 0..kl {
            if n < out_cap {
                let b: u8 = 0;
                PTR_BYTE_AT(b, kp, i);
                let wp: ptr = PTR_NULL();
                PTR_BYTE_ADD(wp, out, n);
                PTR_WRITE_U8(wp, b);
            };
            n = n + 1;
        }
        idx = idx + 1;
    }
    return n;
}

fn json_object_set_bool_local(node: u64, key_ptr: ptr, key_len: u64, value: bool) -> void {
    let bv: u8 = 0;
    if value { bv = 1; };
    sa_json_object_set_bool(node, key_ptr, key_len, bv);
}

// FIX: bound to sa_http_server_new + sa_http_server_start
// (http_server.sai). out_port reports the requested port; an
// ephemeral bound port is not exposed by the std face
// (documented approximation).
fn http_server_bind(host_ptr: ptr, host_len: u64, port_req: u32, out_server: &u64, out_port: &u64) -> i32 {
    let srv: u64 = 0;
    if sa_http_server_new(&srv) != 0 { return 1; };
    if sa_http_server_start(srv, host_ptr, host_len, port_req as u16) != 0 { return 1; };
    *out_server = srv;
    *out_port = port_req as u64;
    return 0;
}

fn host_stderr_line(prefix_ptr: ptr, prefix_len: u64, text_ptr: ptr, text_len: u64) -> void {
    let h = sa_io_stderr();
    sa_io_write_all(h, prefix_ptr, prefix_len);
    sa_io_write_all(h, text_ptr, text_len);
    let nl: [u8; 1] = [10u8; 1];
    let np: ptr = PTR_NULL();
    PTR_BYTE_ADD(np, &nl, 0);
    sa_io_write_all(h, np, 1);
}

// FIX / BLOCKER (host face): host_relay_chat is the host
// process's relay entry (the redirector forwards the chat
// request to the embedding host). No SLA-callable surface
// exists for it — the same class as the sdk-backend
// hostServices untyped fn-ptr table (see FIX_BACKENDS.md).
// Explicit disposition: report an error to the caller
// (out_err = -1, empty body) rather than fabricate a relay.
fn host_relay_chat(provider: u64, group: u64, keys_ptr: ptr, keys_len: u64, request_ptr: ptr, request_len: u64, out_status: &i64, out_body: ptr, out_body_cap: u64, out_body_len: &u64, out_err: &i32) -> void {
    *out_status = 0;
    *out_body_len = 0;
    *out_err = -1;
}

fn http_server_close(server: u64) -> void {
    sa_http_server_free(server);
}
