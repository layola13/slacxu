// Converted 1:1 from backends/opencode/src/manifest.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "sa_std/ptr.sa"

// OpenCode manifest — the single source is ../plugin.json; both sides
// import it from here so the web side never pulls in server code.
//
// TS: import type { PluginManifest } from "@cxu/sdk-backend";
// TS: import manifestJson from "../plugin.json" with { type: "json" };
// DEFECT: JSON module import (import attributes `with { type: "json" }`)
// has no SLA counterpart; the plugin.json contents are approximated as a
// JSON text buffer loaded from the sibling file at runtime.
// DEFECT: PluginManifest is an SDK type with no SLA struct yet; represented
// as a JSON text buffer (dynamic object) instead of a typed struct.

// TS: export const OPENCODE_MANIFEST: PluginManifest = manifestJson as PluginManifest;
// The manifest JSON text buffer (capacity 8192 bytes, sized for plugin.json).
struct OpencodeManifest {
    json_bytes: [u8; 8192],
    json_len: u64,
}

// TS: manifestJson as PluginManifest — the cast is a no-op at runtime; here
// the caller fills json_bytes/json_len from ../plugin.json and passes the
// struct by reference wherever OPENCODE_MANIFEST was read.
fn opencode_manifest_json_path(out_ptr: ptr, out_len: &u64) -> void {
    // DEFECT: relative path resolution against the module URL has no SLA
    // counterpart; the literal sibling path "../plugin.json" is returned.
    let p = STR_PTR("../plugin.json");
    let n = STR_LEN("../plugin.json");
    *out_len = n;
    // Caller copies n bytes from p into its own buffer.
    let _p = p;
}
