// Lightweight metadata read for history-restore metadata RPCs. Selects
// only small columns and NEVER touches `state_json`, so a tens-of-MB
// snapshot can't block the Bun event loop on the 18% metadata stage.
// TS: getMetadata(ownerId, threadId): Pick<...> | null
fn OpencodeSessionStore_getMetadata(self_s: &OpencodeSessionStore, owner_ptr: ptr, owner_len: u64, thread_ptr: ptr, thread_len: u64, out: &OpencodeSessionMetadata) -> bool {
    let stmt = sa_sqlite_prepare(self_s.db.handle, STR_PTR("SELECT thread_id, owner_id, session_id, model, cwd FROM opencode_sessions WHERE thread_id = ? AND owner_id = ? LIMIT 1"), STR_LEN("SELECT thread_id, owner_id, session_id, model, cwd FROM opencode_sessions WHERE thread_id = ? AND owner_id = ? LIMIT 1"));
    sa_sqlite_bind_text(stmt, 1, thread_ptr, thread_len);
    sa_sqlite_bind_text(stmt, 2, owner_ptr, owner_len);
    let found = false;
    if sa_sqlite_step(stmt) {
        metadata_from_stmt(stmt, out);
        found = true;
    };
    sa_sqlite_finalize(stmt);
    return found;
}

