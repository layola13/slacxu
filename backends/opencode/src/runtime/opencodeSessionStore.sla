// TS: listByOwner(ownerId: string): OpencodeSessionRecord[]
fn OpencodeSessionStore_listByOwner(self_s: &OpencodeSessionStore, owner_ptr: ptr, owner_len: u64, out: &OpencodeSessionRecordList) -> void {
    out.len = 0;
    let stmt = sa_sqlite_prepare(self_s.db.handle, STR_PTR("SELECT * FROM opencode_sessions WHERE owner_id = ? ORDER BY updated_at DESC"), STR_LEN("SELECT * FROM opencode_sessions WHERE owner_id = ? ORDER BY updated_at DESC"));
    sa_sqlite_bind_text(stmt, 1, owner_ptr, owner_len);
    // .all(ownerId) — iterate steps until exhausted or capacity 256.
    while sa_sqlite_step(stmt) {
        if out.len >= 256 { break; };
        let row = OpencodeSessionRow { thread_id: [0u8; 128], thread_id_len: 0, owner_id: [0u8; 128], owner_id_len: 0, session_id: [0u8; 256], session_id_len: 0, has_session_id: false, cli_version: [0u8; 64], cli_version_len: 0, has_cli_version: false, model: [0u8; 256], model_len: 0, has_model: false, cwd: [0u8; 1024], cwd_len: 0, has_cwd: false, permission_mode: [0u8; 64], permission_mode_len: 0, has_permission_mode: false, state_json: [0u8; 1048576], state_json_len: 0, has_state_json: false, created_at: 0, updated_at: 0 };
        row_from_stmt(stmt, &row);
        let rec = &out.items[out.len];
        OpencodeSessionStore_mapRow(self_s, &row, rec);
        out.len = out.len + 1;
    }
    sa_sqlite_finalize(stmt);
}

// Include legacy shared-local sessions when a member opens history.
// TS: listForOwner(ownerId: string): OpencodeSessionRecord[]
//   if (ownerId === "local") return this.listByOwner("local");
//   const records = [...listByOwner(ownerId), ...listByOwner("local")];
//   dedupe by threadId via Set, first wins.
fn OpencodeSessionStore_listForOwner(self_s: &OpencodeSessionStore, owner_ptr: ptr, owner_len: u64, out: &OpencodeSessionRecordList) -> void {
    if bytes_equal(owner_ptr, owner_len, STR_PTR("local"), STR_LEN("local")) {
        OpencodeSessionStore_listByOwner(self_s, owner_ptr, owner_len, out);
        return;
    };
    let mine = OpencodeSessionRecordList { items: [OpencodeSessionRecord; 256], len: 0 };
    // DEFECT: allocating two 256-record lists (each record carries a 1MB
    // state_json buffer) is a bulk-pass approximation; fix phase should
    // stream. Kept structurally 1:1 with the TS spread+dedupe.
    OpencodeSessionStore_listByOwner(self_s, owner_ptr, owner_len, &mine);
    let legacy = OpencodeSessionRecordList { items: [OpencodeSessionRecord; 256], len: 0 };
    OpencodeSessionStore_listByOwner(self_s, STR_PTR("local"), STR_LEN("local"), &legacy);
    out.len = 0;
    // records.filter with seen Set<threadId> -> linear scan dedupe.
    let i: u64 = 0;
    while i < mine.len {
        let cand = &mine.items[i];
        let cp: ptr = PTR_NULL();
        PTR_BYTE_ADD(cp, &cand.thread_id, 0);
        let dup = false;
        let j: u64 = 0;
        while j < out.len {
            let ep: ptr = PTR_NULL();
            PTR_BYTE_ADD(ep, &out.items[j].thread_id, 0);
            if bytes_equal(ep, out.items[j].thread_id_len, cp, cand.thread_id_len) { dup = true; break; };
            j = j + 1;
        }
        if !dup && out.len < 256 {
            out.items[out.len] = mine.items[i];
            out.len = out.len + 1;
        };
        i = i + 1;
    }
    let k: u64 = 0;
    while k < legacy.len {
        let cand2 = &legacy.items[k];
        let cp2: ptr = PTR_NULL();
        PTR_BYTE_ADD(cp2, &cand2.thread_id, 0);
        let dup2 = false;
        let j2: u64 = 0;
        while j2 < out.len {
            let ep2: ptr = PTR_NULL();
            PTR_BYTE_ADD(ep2, &out.items[j2].thread_id, 0);
            if bytes_equal(ep2, out.items[j2].thread_id_len, cp2, cand2.thread_id_len) { dup2 = true; break; };
            j2 = j2 + 1;
        }
        if !dup2 && out.len < 256 {
            out.items[out.len] = legacy.items[k];
            out.len = out.len + 1;
        };
        k = k + 1;
    }
}

// TS: delete(ownerId: string, threadId: string): boolean
fn OpencodeSessionStore_delete(self_s: &OpencodeSessionStore, owner_ptr: ptr, owner_len: u64, thread_ptr: ptr, thread_len: u64) -> bool {
    let stmt = sa_sqlite_prepare(self_s.db.handle, STR_PTR("DELETE FROM opencode_sessions WHERE thread_id = ? AND owner_id = ?"), STR_LEN("DELETE FROM opencode_sessions WHERE thread_id = ? AND owner_id = ?"));
    sa_sqlite_bind_text(stmt, 1, thread_ptr, thread_len);
    sa_sqlite_bind_text(stmt, 2, owner_ptr, owner_len);
    sa_sqlite_step(stmt);
    // const res = ....run(threadId, ownerId); return res.changes > 0;
    let changes: u64 = 0;
    sa_sqlite_changes(self_s.db.handle, &changes);
    sa_sqlite_finalize(stmt);
    return changes > 0;
}

// TS: deleteByThreadId(threadId: string): boolean
fn OpencodeSessionStore_deleteByThreadId(self_s: &OpencodeSessionStore, thread_ptr: ptr, thread_len: u64) -> bool {
    let stmt = sa_sqlite_prepare(self_s.db.handle, STR_PTR("DELETE FROM opencode_sessions WHERE thread_id = ?"), STR_LEN("DELETE FROM opencode_sessions WHERE thread_id = ?"));
    sa_sqlite_bind_text(stmt, 1, thread_ptr, thread_len);
    sa_sqlite_step(stmt);
    let changes: u64 = 0;
    sa_sqlite_changes(self_s.db.handle, &changes);
    sa_sqlite_finalize(stmt);
    return changes > 0;
}

// TS: private mapRow(row: OpencodeSessionRow): OpencodeSessionRecord
// DEFECT: private method -> plain function in the family (no access control).
fn OpencodeSessionStore_mapRow(self_s: &OpencodeSessionStore, row: &OpencodeSessionRow, out: &OpencodeSessionRecord) -> void {
    let d: ptr = PTR_NULL();
    let s: ptr = PTR_NULL();
    PTR_BYTE_ADD(d, &out.thread_id, 0);
    PTR_BYTE_ADD(s, &row.thread_id, 0);
    out.thread_id_len = copy_field(d, 128, s, row.thread_id_len);
    PTR_BYTE_ADD(d, &out.owner_id, 0);
    PTR_BYTE_ADD(s, &row.owner_id, 0);
    out.owner_id_len = copy_field(d, 128, s, row.owner_id_len);
    PTR_BYTE_ADD(d, &out.session_id, 0);
    PTR_BYTE_ADD(s, &row.session_id, 0);
    out.session_id_len = copy_field(d, 256, s, row.session_id_len);
    out.has_session_id = row.has_session_id;
    PTR_BYTE_ADD(d, &out.cli_version, 0);
    PTR_BYTE_ADD(s, &row.cli_version, 0);
    out.cli_version_len = copy_field(d, 64, s, row.cli_version_len);
    out.has_cli_version = row.has_cli_version;
    PTR_BYTE_ADD(d, &out.model, 0);
    PTR_BYTE_ADD(s, &row.model, 0);
    out.model_len = copy_field(d, 256, s, row.model_len);
    out.has_model = row.has_model;
    PTR_BYTE_ADD(d, &out.cwd, 0);
    PTR_BYTE_ADD(s, &row.cwd, 0);
    out.cwd_len = copy_field(d, 1024, s, row.cwd_len);
    out.has_cwd = row.has_cwd;
    PTR_BYTE_ADD(d, &out.permission_mode, 0);
    PTR_BYTE_ADD(s, &row.permission_mode, 0);
    out.permission_mode_len = copy_field(d, 64, s, row.permission_mode_len);
    out.has_permission_mode = row.has_permission_mode;
    PTR_BYTE_ADD(d, &out.state_json, 0);
    PTR_BYTE_ADD(s, &row.state_json, 0);
    out.state_json_len = copy_field(d, 1048576, s, row.state_json_len);
    out.has_state_json = row.has_state_json;
    out.created_at = row.created_at;
    out.updated_at = row.updated_at;
}
