// case thread/resume extras: resolveSession ?? materializeNativeSession; none -> same empty stub; messages always included in items.
fn case_threadRead(self: &OpencodeBridge, rec_json: ptr, rec_len: u64, now_ms: u64, is_resume: bool, out_json: ptr, out_len: &u64) -> i32 { *out_len = 0; return 0; }

// case thread/turns/list (TS 1387-1454): no session -> native page via listNativeOpencodeTurns(threadId, {limit ?? 32, cursor, sortDirection ?? "desc", itemsView ?? "summary"}) or {turns:[], data:[], nextCursor:null};
// live: limit clamp(1,100) default 32; single-pass byTurn index over messages (skip non-string turnId); sort turns by createdAt (desc default, id tiebreak); cursor = index after cursor id; window limit+1 -> page + nextCursor;
// summary view (itemsView != "full"): items reduced to first userMessage + last agentMessage; status normalization as thread/read; return {turns, data: turns, nextCursor}
fn case_threadTurnsList(self: &OpencodeBridge, rec_json: ptr, rec_len: u64, now_ms: u64, out_json: ptr, out_len: &u64) -> i32 { *out_len = 0; return 0; }

// case thread/compact/start (TS 1456-1510): resolve ?? materialize or throw `Unknown thread: ${threadId}`; activeTurnId -> throw "Cannot compact while an opencode turn is running";
// turnId = randomUUID(); push turn + set active; compactionItem {type:"contextCompaction", id:`opencode-compact-${turnId}`, threadId, turnId, title:"Context compaction", status:"inProgress", cliBackend} pushed; persist; emit turn/started + item/started; void runCompaction(...) (background in source — sequential call here, DEFECT: async); return {turn:{id, threadId, status:"inProgress"}, turnId}
fn case_threadCompactStart(self: &OpencodeBridge, rec_json: ptr, rec_len: u64, now_ms: u64, out_json: ptr, out_len: &u64) -> i32 { *out_len = 0; return 0; }

// case thread/history/fileInfo (TS 1512-1519): native id -> nativeOpencodeFileInfo or fallthrough; else {exists:false}
fn case_threadHistoryFileInfo(self: &OpencodeBridge, rec_json: ptr, rec_len: u64, now_ms: u64, out_json: ptr, out_len: &u64) -> i32 { *out_len = 0; return 0; }

// case thread/history/tail (TS 1521-1575): native id -> readNativeOpencodeTail(threadId, {maxMessages: record.maxMessages}) when hit;
// else resolveSession (none -> readNativeThread(threadId, true) or throw `OpenCode session not found for thread ${threadId}`);
// return {thread:{id, sessionId, preview, model, cliBackend, status, cwd, turns mapped with items, messages}, items: messages, tail:{truncated:false, backend:"opencode-memory"}}
fn case_threadHistoryTail(self: &OpencodeBridge, rec_json: ptr, rec_len: u64, now_ms: u64, out_json: ptr, out_len: &u64) -> i32 { *out_len = 0; return 0; }
