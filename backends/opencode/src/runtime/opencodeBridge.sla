// OpencodeSessionSnapshot (TS 173-196) / OpencodeSession (TS 214-236): one struct, session adds activeTurnId + runtime handle
struct OpencodeSession {
    threadId: [u8; 128], threadId_len: u64,
    ownerId: [u8; 128], ownerId_len: u64, has_ownerId: bool,
    sessionId: [u8; 128], sessionId_len: u64, has_sessionId: bool,
    name: [u8; 1024], name_len: u64, has_name: bool,
    parentThreadId: [u8; 128], parentThreadId_len: u64, has_parentThreadId: bool,
    agentType: [u8; 256], agentType_len: u64, has_agentType: bool,
    taskName: [u8; 256], taskName_len: u64, has_taskName: bool,
    additionalRoots_json: [u8; 8192], additionalRoots_len: u64, has_additionalRoots: bool,
    preview: [u8; 1024], preview_len: u64, has_preview: bool,
    model: [u8; 256], model_len: u64, has_model: bool,
    providerId: [u8; 256], providerId_len: u64, has_providerId: bool,
    groupId: [u8; 128], groupId_len: u64, has_groupId: bool,
    relay: OpencodeRelayConfig, has_relay: bool,
    developerInstructions: [u8; 65536], developerInstructions_len: u64, has_developerInstructions: bool,
    cwd: [u8; 2048], cwd_len: u64, has_cwd: bool,
    dangerous: bool, has_dangerous: bool,
    apiVersion: u32, has_apiVersion: bool, // snapshot only: 1 | 2
    turns_json: [u8; 1048576], turns_len: u64, n_turns: u64, // OpencodeTurnRef arena serialized
    messages_json: [u8; 4194304], messages_len: u64, n_messages: u64, // JsonValue[]
    activeTurnId: [u8; 128], activeTurnId_len: u64, has_activeTurnId: bool, // session only
    runtime: u64, // OpencodeCompatibleRuntime handle, 0 = none — session only
}

