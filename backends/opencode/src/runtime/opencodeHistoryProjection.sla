// projectMessagesToTurns (TS 613-897)
// State: turns[] (JSON arena), current turn, itemCount, usedChildSessionIds set.
// Helpers in source (closures — DEFECT: closures capturing mutable state; here explicit state struct fields):
//   nextAvailableChildSessionId: first childSessionIds entry not in used set (marks used)
//   pushItem: false when itemCount >= maxItems
//   startTurn(userMsg): turn {id:`opencode-native-${userMsg.id}`, status:"completed", startedAt: floor(createdAtMs/1000), items:[]}
//   ensureTurn(msg): recovered turn `opencode-native-recovered-${msg.id}` when no current
// Per user message: startTurn; text parts joined "\n" clipped to NATIVE_HISTORY_TEXT_LIMIT; userMessage item when text or files (content = text block + files.map(nativeFileToImageBlock)); subtask parts -> collabAgentToolCall items (child id via opencodeSubtaskChildId(part, threadId) else nextAvailableChildSessionId; agent = subtask.agent || input.subagent_type || "subagent").
// Per assistant message: ensureTurn; text parts -> one agentMessage (clipped); reasoning parts with text -> reasoning item `${msg.id}-reasoning`; per part:
//   subtask -> collabAgentToolCall as above;
//   tool + toolName=="task" -> collabAgentToolCall (agentRole from input.subagent_type|input.agent|part.subagent_type|part.agent; status failed when state.status=="error"; callId = part.callID || part.id);
//   other tool -> toolCall item {input: state.input ?? {}, output: string clipped to TOOL_OUTPUT_LIMIT else raw JSON, status: completed|error->failed|completed};
// compaction part present -> contextCompaction item `${msg.id}-compaction`; completedAtMs -> turn.completedAt.
// Returns turns with items.length > 0.
struct ProjectTurnsState {
    turns_json: [u8; 4194304], turns_len: u64, n_turns: u64,
    has_current: bool,
    current_json: [u8; 1048576], current_len: u64,
    itemCount: u64,
    usedChild_keys: [u8; 65536], usedChild_len: u64, n_usedChild: u64,
}
fn projectMessagesToTurns(threadId_ptr: ptr, threadId_len: u64, messages_json: ptr, messages_len: u64, maxItems: u64, childIds_json: ptr, childIds_len: u64, out_json: ptr, out_len: &u64) -> i32 {
    *out_len = 0;
    return 0;
}

