fn readMessages(self: &OpencodeCompatibleRuntime, out_json: ptr, out_len: &u64) -> i32 { *out_len = 0; return 0; }

// stop (TS 1641-1663): rejectAllPendingQuestions(false); clear timers; pendingPermissions.clear(); abort SSE + clear state; running ctx -> forceTerminateOpencode(ctx, "interrupted") (events discarded in source); isTurnRunning/awaiting=false; detachPooledServer()
fn runtime_stop(self: &OpencodeCompatibleRuntime) -> i32 {
    self.isTurnRunning = false;
    self.awaitingTurnActivity = false;
    return detachPooledServer(self, false, false);
}
