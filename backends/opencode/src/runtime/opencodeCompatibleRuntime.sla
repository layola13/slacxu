// v2: v2TurnAbort.abort() only (no /abort endpoint; pooled server untouched), return.
// v1: POST /session/:id/abort (interruptTimeoutMs ?? 2500); when turn was active && !acknowledged && processManager: abort SSE, clear SSE state, detachPooledServer({stopWhenLast:true}).
fn interruptTurn(self: &OpencodeCompatibleRuntime) -> i32 { return 0; }

