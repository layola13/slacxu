// Finally: upstream issue ? scheduleUpstreamRetryCheck : clearUpstreamRetryTimer; deferredIdle pending && (idle || no projections) -> scheduleIdleConfirm; hadDeferredIdle && streaming event && deferredIdle cleared by activity -> restore deferredIdle=now + scheduleIdleConfirm.
