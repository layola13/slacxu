}

// resolveModelPayload (TS 1008-1014): relay with non-empty targetModel -> {providerID: relay.providerID, modelID: targetModel.trim()}; else resolveOpencodeModelPayload(config.model)
fn resolveModelPayload(self: &OpencodeCompatibleRuntime, prov_out: ptr, prov_len: &u64, model_out: ptr, model_len: &u64, found: &bool) -> i32 {
    *found = false;
    *prov_len = 0;
    *model_len = 0;
    if self.config.has_relay && self.config.relay.targetModel_len > 0 {
        *found = true;
        return 0;
    };
    let cap_model: ptr = PTR_NULL(); PTR_BYTE_ADD(cap_model, &self.config.model, 0);
    return resolveOpencodeModelPayload(cap_model, self.config.model_len, self.config.has_model, prov_out, prov_len, model_out, model_len, found);
}

