// ---- TS: export function parseOpencodeSseChunk(chunk: string): OpencodeSseEvent[] ----
// Parse an SSE data buffer into OpencodeSseEvent objects.
// Source logic: split lines on /\r?\n/; accumulate `data:` payloads
// (line.slice(5).trim(), concatenated with NO separator); on a blank line
// (or at end of input) JSON.parse the accumulation and push when
// `parsed.type` is a string; parse errors are swallowed (try/catch).
// DEFECT: try/catch -> sa_json_parse status code; JSON.parse dynamic
// object -> intent externs sa_json_parse / sa_json_object_get /
// sa_json_node_string (MISSING surface check). The pushed event keeps the
// raw JSON text; id/type are extracted when present.
fn parseOpencodeSseChunk(chunk_ptr: ptr, chunk_len: u64, out: &OpencodeSseEventList) -> void {
    out.len = 0;
    // currentData accumulation buffer
    let current = ProtoBuf { bytes: [0u8; 16384], len: 0 };
    let cur_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(cur_ptr, &current.bytes, 0);
    let i: u64 = 0;
    // Line iteration with \r?\n splitting: iterate byte positions, a line
    // ends at '\n'; a trailing '\r' is part of the line content handling
    // below (TS split removes the \r of \r\n pairs).
    let line_start: u64 = 0;
    let flushed_at_end = false;
    while i <= chunk_len {
        let at_end = i == chunk_len;
        let b: u8 = 10;
        if !at_end {
            PTR_BYTE_AT(b, chunk_ptr, i);
        };
        if at_end || b == 10 {
            // line = chunk[line_start..i], minus a trailing '\r'
            let line_len = i - line_start;
            if line_len > 0 {
                let last: u8 = 0;
                PTR_BYTE_AT(last, chunk_ptr, i - 1);
                if last == 13 { line_len = line_len - 1; };
            };
            let line_ptr: ptr = PTR_NULL();
            PTR_BYTE_ADD(line_ptr, chunk_ptr, line_start);
            // if (line.startsWith("data:"))
            if line_len >= 5 && proto_bytes_equal(line_ptr, 5, STR_PTR("data:"), STR_LEN("data:")) {
                // currentData += line.slice(5).trim();
                let payload: ptr = PTR_NULL();
                PTR_BYTE_ADD(payload, line_ptr, 5);
                let pay_len = line_len - 5;
                // trim
                let ts: u64 = 0;
                while ts < pay_len {
                    let c: u8 = 0;
                    PTR_BYTE_AT(c, payload, ts);
                    if c != 32 && c != 9 && c != 13 { break; };
                    ts = ts + 1;
                }
                let te = pay_len;
                while te > ts {
                    let c: u8 = 0;
                    PTR_BYTE_AT(c, payload, te - 1);
                    if c != 32 && c != 9 && c != 13 { break; };
                    te = te - 1;
                }
                let tp: ptr = PTR_NULL();
                PTR_BYTE_ADD(tp, payload, ts);
                let n = te - ts;
                if current.len + n <= 16384 {
                    let dst: ptr = PTR_NULL();
                    PTR_BYTE_ADD(dst, cur_ptr, current.len);
                    proto_copy(dst, 16384 - current.len, tp, n);
                    current.len = current.len + n;
                };
            } else if line_len == 0 && current.len > 0 {
                // } else if (line.trim() === "" && currentData) {
                // (line_len==0 after \r strip is exactly trim()==="" for
                // whitespace-only lines of spaces/tabs too — DEFECT: a
                // spaces-only line is treated as content-less here; TS
                // would flush as well since trim()==="". Equivalent.)
                sse_flush_current(&current, out);
            };
            line_start = i + 1;
            if at_end { flushed_at_end = true; };
        };
        i = i + 1;
    }
    let _f = flushed_at_end;
    // if (currentData) { ...same parse/push... }
    if current.len > 0 {
        sse_flush_current(&current, out);
    };
}

// The try { parsed = JSON.parse(currentData); if (parsed && typeof
// parsed.type === "string") events.push(parsed) } catch {} block, shared
// by the blank-line and end-of-input paths; also resets currentData = "".
fn sse_flush_current(current: &ProtoBuf, out: &OpencodeSseEventList) -> void {
    let cur_ptr: ptr = PTR_NULL();
    PTR_BYTE_ADD(cur_ptr, &current.bytes, 0);
    let node: u64 = 0;
    if sa_json_parse(cur_ptr, current.len, &node) == 0 {
        let type_child: u64 = 0;
        if sa_json_object_get(node, STR_PTR("type"), STR_LEN("type"), &type_child) == 0 {
            let t_ptr: ptr = PTR_NULL();
            let t_len: u64 = 0;
            if sa_json_node_string(type_child, &t_ptr, &t_len) == 0 {
                if out.len < 128 {
                    let ev = &out.items[out.len];
                    // id (may be absent on some events; TS type allows it
                    // structurally — kept optional here via has implied len)
                    let id_child: u64 = 0;
                    ev.id_len = 0;
                    if sa_json_object_get(node, STR_PTR("id"), STR_LEN("id"), &id_child) == 0 {
                        let ip: ptr = PTR_NULL();
                        let il: u64 = 0;
                        if sa_json_node_string(id_child, &ip, &il) == 0 {
                            let dst: ptr = PTR_NULL();
                            PTR_BYTE_ADD(dst, &ev.id, 0);
                            ev.id_len = proto_copy(dst, 128, ip, il);
                        };
                    };
                    let td: ptr = PTR_NULL();
                    PTR_BYTE_ADD(td, &ev.type_str, 0);
                    ev.type_str_len = proto_copy(td, 64, t_ptr, t_len);
                    let jd: ptr = PTR_NULL();
                    PTR_BYTE_ADD(jd, &ev.json, 0);
                    ev.json_len = proto_copy(jd, 32768, cur_ptr, current.len);
                    out.len = out.len + 1;
                };
            };
        };
    };
    current.len = 0;
}

// ---- TS: export function splitOpencodeSseRecords(buffer: string) ----
// Split complete SSE records while retaining an incomplete trailing record.
// DEFECT: RegExpMatchArray loop on /\r?\n\r?\n/ -> hand scan for the two
// boundary shapes "\n\n", "\n\r\n", "\r\n\n", "\r\n\r\n".
struct OpencodeSseRecord {
    bytes: [u8; 16384],
    len: u64,
}

struct OpencodeSseSplit {
    // records: string[] — fixed capacity 64
    records: [OpencodeSseRecord; 64],
    records_len: u64,
    remainder: [u8; 16384],
    remainder_len: u64,
}

// Length of the record boundary starting at pos, or 0 when none.
fn sse_boundary_len(s_ptr: ptr, s_len: u64, pos: u64) -> u64 {
    if pos >= s_len { return 0; };
    let b0: u8 = 0;
    PTR_BYTE_AT(b0, s_ptr, pos);
    if b0 == 10 {
        if pos + 1 < s_len {
            let b1: u8 = 0;
            PTR_BYTE_AT(b1, s_ptr, pos + 1);
            if b1 == 10 { return 2; };
            if b1 == 13 && pos + 2 < s_len {
                let b2: u8 = 0;
                PTR_BYTE_AT(b2, s_ptr, pos + 2);
                if b2 == 10 { return 3; };
            };
        };
        return 0;
    };
    if b0 == 13 {
        if pos + 3 < s_len + 1 && pos + 1 < s_len {
            let b1: u8 = 0;
            PTR_BYTE_AT(b1, s_ptr, pos + 1);
            if b1 != 10 { return 0; };
            if pos + 2 < s_len {
                let b2: u8 = 0;
                PTR_BYTE_AT(b2, s_ptr, pos + 2);
                if b2 == 10 { return 3; };
                if b2 == 13 && pos + 3 < s_len {
                    let b3: u8 = 0;
                    PTR_BYTE_AT(b3, s_ptr, pos + 3);
                    if b3 == 10 { return 4; };
                };
            };
        };
        return 0;
    };
    return 0;
}

fn splitOpencodeSseRecords(buf_ptr: ptr, buf_len: u64, out: &OpencodeSseSplit) -> void {
    out.records_len = 0;
    // remainder starts as the whole buffer; consumed from the front.
    let start: u64 = 0;
    // while ((boundary = /\r?\n\r?\n/.exec(remainder)) !== null) { ... }
    while start < buf_len {
        // find the first boundary at or after start
        let pos = start;
        let blen: u64 = 0;
        let found = false;
        while pos < buf_len {
            blen = sse_boundary_len(buf_ptr, buf_len, pos);
            if blen > 0 { found = true; break; };
            pos = pos + 1;
        }
        if !found { break; };
        // records.push(remainder.slice(0, index))
        if out.records_len < 64 {
            let rec = &out.records[out.records_len];
            let dst: ptr = PTR_NULL();
            PTR_BYTE_ADD(dst, &rec.bytes, 0);
            let src: ptr = PTR_NULL();
            PTR_BYTE_ADD(src, buf_ptr, start);
            rec.len = proto_copy(dst, 16384, src, pos - start);
            out.records_len = out.records_len + 1;
        };
        // remainder = remainder.slice(index + boundary[0].length)
        start = pos + blen;
    }
    // return { records, remainder }
    let rd: ptr = PTR_NULL();
    PTR_BYTE_ADD(rd, &out.remainder, 0);
    let rs: ptr = PTR_NULL();
    PTR_BYTE_ADD(rs, buf_ptr, start);
    out.remainder_len = proto_copy(rd, 16384, rs, buf_len - start);
}
