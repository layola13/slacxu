    id: [u8; 128],
    id_len: u64,
    type_str: [u8; 64],
    type_str_len: u64,
    // properties?: unknown — raw JSON text of the whole event
    json: [u8; 32768],
    json_len: u64,
}

// TS: OpencodeSseEvent[] — fixed capacity 128 events per chunk.
struct OpencodeSseEventList {
    items: [OpencodeSseEvent; 128],
    len: u64,
}

