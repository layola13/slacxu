// Converted 1:1 from backends/opencode/src/runtime/opencodeCompatibleProtocol.ts (CXU plugins @ f2cb649d). Bulk conversion pass — defects logged, not yet fixed.
@import "sa_std/ptr.sa"

// Pure type/protocol module: TS interfaces and discriminated unions become
// structs with fixed byte buffers for strings; union types become a kind
// tag plus the flattened field set. Dynamic JSON payloads (`unknown`,
// Record<string, unknown>, metadata) become JSON text buffers.
// DEFECT: dynamic object — every `unknown`/Record field below is a JSON
// text buffer (capacity noted per field), not a typed value.

// ---- shared helpers ----
struct ProtoBuf {
    bytes: [u8; 16384],
    len: u64,
}

fn proto_copy(dst: ptr, cap: u64, src: ptr, src_len: u64) -> u64 {
    let n = src_len;
    if n > cap { n = cap; };
    let i: u64 = 0;
    while i < n {
        let c: u8 = 0;
        PTR_BYTE_AT(c, src, i);
        PTR_BYTE_SET(dst, i, c);
        i = i + 1;
    }
    return n;
}

fn proto_bytes_equal(a_ptr: ptr, a_len: u64, b_ptr: ptr, b_len: u64) -> bool {
    if a_len != b_len { return false; };
    let i: u64 = 0;
    while i < a_len {
        let x: u8 = 0;
        let y: u8 = 0;
        PTR_BYTE_AT(x, a_ptr, i);
        PTR_BYTE_AT(y, b_ptr, i);
        if x != y { return false; };
        i = i + 1;
    }
    return true;
}

