fn buildOpencodePlanItem(threadId_ptr: ptr, threadId_len: u64, turnId_ptr: ptr, turnId_len: u64, steps: &OpencodePlanStepList, status_ptr: ptr, status_len: u64, has_status: bool, out_json: ptr, out_len: &u64) -> i32 {
