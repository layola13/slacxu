// OpencodeProjectedEvent (TS lines 18-53, discriminated union flattened)
struct OpencodeProjectedEvent {
    kind: u32,
    threadId: [0u8; 128], threadId_len: u64,
    turnId: [0u8; 128], turnId_len: u64,
    error: [0u8; 1024], error_len: u64, has_error: bool,
    tokenUsage_json: [0u8; 2048], tokenUsage_len: u64,
    requestId: [0u8; 256], requestId_len: u64, has_requestId: bool,
    itemId: [0u8; 256], itemId_len: u64,
    delta: [0u8; 8192], delta_len: u64,
    item_json: [0u8; 32768], item_len: u64,
    permission: [0u8; 256], permission_len: u64,
    patterns_json: [0u8; 4096], patterns_len: u64,
    always_json: [0u8; 4096], always_len: u64, has_always: bool,
    metadata_json: [0u8; 8192], metadata_len: u64, has_metadata: bool,
    tool_messageID: [0u8; 128], tool_messageID_len: u64, has_tool: bool,
    tool_callID: [0u8; 128], tool_callID_len: u64,
    questions: [0u8; 16384], questions_len: u64, n_questions: u64,
    sessionId: [0u8; 128], sessionId_len: u64,
}

// Projected event list (TS returns OpencodeProjectedEvent[]; capacity estimated: one SSE event projects to at most a handful of events, buffer 64)
struct ProjectedEventList {
    items: [0u8; 4194304], // DEFECT: array of structs not expressible; events serialized back-to-back as JSON text in this buffer
    len: u64,
    count: u64,
}

// OpencodeProjectorContext (TS lines 55-97)
struct OpencodeProjectorContext {
    threadId: [0u8; 128], threadId_len: u64,
