    currentReasoningText: [0u8; 262144], currentReasoningText_len: u64,
    assistantItemId: [0u8; 256], assistantItemId_len: u64,
    reasoningItemId: [0u8; 256], reasoningItemId_len: u64,
    assistantText: [0u8; 524288], assistantText_len: u64,
    reasoningText: [0u8; 524288], reasoningText_len: u64,
    hasStartedTurn: bool,
    hasStartedAgentMessage: bool,
    // activeToolItems: Map<string, Record> -> parallel key/json arrays, cap 256 tools per turn
    tool_keys: [0u8; 65536], tool_keys_len: u64, n_tools: u64,
    tool_items_json: [0u8; 1048576], tool_items_len: u64,
    // partTypes: Map<string, "text"|"reasoning"|"tool"> -> key array + tag array, cap 1024 parts
    partType_keys: [0u8; 262144], partType_keys_len: u64, n_partTypes: u64,
    partType_vals: [0u8; 1024],
    // partTexts: Map<string, string> -> keys + one text arena, cap 1024 parts
    partText_keys: [0u8; 262144], partText_keys_len: u64, n_partTexts: u64,
    partText_arena: [0u8; 1048576], partText_arena_len: u64,
    // messageRoles: Map<string, string> cap 1024
    role_keys: [0u8; 262144], role_keys_len: u64, n_roles: u64,
    role_vals: [0u8; 16384], role_vals_len: u64,
    // pendingPlanCandidates: Set<string> cap 256
    planCand_keys: [0u8; 65536], planCand_keys_len: u64, n_planCand: u64,
    planStarted: bool,
    lastPlanStepsJson: [0u8; 32768], lastPlanStepsJson_len: u64,
    contextWindow: u64, has_contextWindow: bool,
    lastActivityMs: u64,
    deferredIdleAtMs: u64, has_deferredIdle: bool,
