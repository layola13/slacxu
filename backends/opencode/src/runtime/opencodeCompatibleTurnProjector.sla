// extractOpencodePlanSteps (TS 390-409)
fn extractOpencodePlanSteps(input_json: ptr, input_len: u64, output_ptr: ptr, output_len: u64, has_output: bool, out: &OpencodePlanStepList) -> i32 {
    // 1) direct array input
    opencodePlanStepsFromValue(input_json, input_len, true, out);
    if !out.is_null { return 0; };
    // 2) input.todos ?? input.tasks ?? input.plan ?? input.steps
    opencodePlanStepsFromValue(input_json, input_len, false, out);
    if !out.is_null { return 0; };
    // 3) output string: JSON.parse then direct/record paths
    // DEFECT: try/catch JSON.parse — parse failure leaves out.is_null (caller falls back to plain tool row).
    if has_output && output_len > 0 {
        opencodePlanStepsFromValue(output_ptr, output_len, true, out);
    };
    return 0;
}

