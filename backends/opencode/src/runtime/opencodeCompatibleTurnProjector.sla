// createOpencodeProjectorContext (TS 99-141)
fn createOpencodeProjectorContext(threadId_ptr: ptr, threadId_len: u64, turnId_ptr: ptr, turnId_len: u64, contextWindow: u64, has_contextWindow: bool, out: &OpencodeProjectorContext) -> i32 {
    // initialAssistantItemId = `opencode-msg-${turnId}-0`; initialReasoningItemId = `opencode-thought-${turnId}-0`
    // DEFECT: template string interpolation — approximated by byte concatenation into the id fields.
    out.threadId_len = threadId_len;
    out.turnId_len = turnId_len;
    out.status = 0;
    out.startedAtMs = 0; // DEFECT: Date.now() — no wall-clock extern bound in this pass; caller supplies now via markOpencodeActivity.
    out.textSegmentSeq = 0;
    out.hasStartedCurrentAssistantMessage = false;
    out.hasCompletedCurrentAssistantMessage = false;
    out.hasStartedCurrentReasoning = false;
    out.hasCompletedCurrentReasoning = false;
    out.hasStartedTurn = false;
    out.hasStartedAgentMessage = false;
    out.n_tools = 0;
    out.n_partTypes = 0;
    out.n_partTexts = 0;
    out.n_roles = 0;
    out.n_planCand = 0;
    out.planStarted = false;
    out.lastPlanStepsJson_len = 0;
    out.contextWindow = contextWindow;
    out.has_contextWindow = has_contextWindow;
    out.has_deferredIdle = false;
    out.has_upstreamIssue = false;
    out.upstreamIssueMsg_len = 0;
    out.upstreamRetryAttempts = 0;
    return 0;
}

// buildOpencodeTokenUsage (TS 154-190) -> tokenUsage JSON buffer on out_json
fn buildOpencodeTokenUsage(tokens: &OpencodeRawTokens, contextWindow: u64, has_contextWindow: bool, out_json: ptr, out_len: &u64) -> i32 {
    let inputTokens: u64 = 0;
    if tokens.has_input { inputTokens = tokens.input; };
    let outputTokens: u64 = 0;
    if tokens.has_output { outputTokens = tokens.output; };
    let reasoningTokens: u64 = 0;
    if tokens.has_reasoning { reasoningTokens = tokens.reasoning; };
    let cachedTokens: u64 = 0;
    if tokens.has_cache_read { cachedTokens = tokens.cache_read; };
    let cacheWriteTokens: u64 = 0;
    if tokens.has_cache_write { cacheWriteTokens = tokens.cache_write; };
    let totalTokens: u64 = inputTokens + outputTokens + reasoningTokens + cachedTokens + cacheWriteTokens;
    if tokens.has_total { totalTokens = tokens.total; };
    // last = { totalTokens, inputTokens, cachedInputTokens, cacheWriteInputTokens, outputTokens, reasoningOutputTokens }
    // total = { ...last }; contextUsage = { ...last, totalTokens: inputTokens + cachedTokens, outputTokens: 0, reasoningOutputTokens: 0 }
    // DEFECT: dynamic object spread — the three sub-objects are serialized into out_json by field name; modelContextWindow appended only when has_contextWindow && contextWindow > 0.
    out_len = 0;
    return 0;
}

// startNewOpencodeSegment (TS 192-204)
fn startNewOpencodeSegment(ctx: &OpencodeProjectorContext) -> i32 {
    ctx.textSegmentSeq = ctx.textSegmentSeq + 1;
    // currentAssistantItemId = `opencode-msg-${turnId}-${seq}`; currentReasoningItemId = `opencode-thought-${turnId}-${seq}` (concat approximation, see create DEFECT)
    ctx.currentAssistantText_len = 0;
    ctx.currentReasoningText_len = 0;
    // assistantItemId = currentAssistantItemId; reasoningItemId = currentReasoningItemId
    ctx.hasStartedCurrentAssistantMessage = false;
    ctx.hasCompletedCurrentAssistantMessage = false;
    ctx.hasStartedCurrentReasoning = false;
    ctx.hasCompletedCurrentReasoning = false;
    return 0;
}

// completeActiveReasoning (TS 206-229): pushes item/completed reasoning event when started && !completed
fn completeActiveReasoning(ctx: &OpencodeProjectorContext, events: &ProjectedEventList, status: u32) -> i32 {
    if ctx.hasStartedCurrentReasoning && !ctx.hasCompletedCurrentReasoning {
        ctx.hasCompletedCurrentReasoning = true;
        // push { kind: item/completed, item: { type:"reasoning", id: currentReasoningItemId, title:"Reasoning", text: currentReasoningText, status, completedAt: now/1000 } } into events JSON arena
        events.count = events.count + 1;
    };
    return 0;
}

// completeActiveAssistantMessage (TS 231-258): pushes item/completed agentMessage event when started && !completed
fn completeActiveAssistantMessage(ctx: &OpencodeProjectorContext, events: &ProjectedEventList, status: u32) -> i32 {
    if ctx.hasStartedCurrentAssistantMessage && !ctx.hasCompletedCurrentAssistantMessage {
        ctx.hasCompletedCurrentAssistantMessage = true;
        // push { kind: item/completed, item: { type:"agentMessage", id: currentAssistantItemId, content:[{type:"text",text:currentAssistantText,text_elements:[]}], text, role:"assistant", status, completedAt } }
        events.count = events.count + 1;
    };
    return 0;
}

// opencodeIdleIsStale (TS 260-268)
fn opencodeIdleIsStale(ctx: &OpencodeProjectorContext, now_ms: u64) -> bool {
    let hasActivity = ctx.hasStartedAgentMessage || ctx.hasStartedCurrentReasoning || ctx.n_tools > 0 || ctx.assistantText_len > 0 || ctx.reasoningText_len > 0;
    if hasActivity { return false; };
    return now_ms - ctx.startedAtMs < 1500;
}

const OPENCODE_IDLE_QUIESCE_MS: u64 = 2500;
// DEFECT: re-export of SDK constants — STORM_STALLED_AFTER_MS / STORM_STALLED_AFTER_ATTEMPTS come from @cxu/sdk-backend; bound as extern constants in the fix phase.
const OPENCODE_UPSTREAM_RETRY_GRACE_MS: u64 = 0; // = STORM_STALLED_AFTER_MS
const OPENCODE_UPSTREAM_RETRY_MAX_ATTEMPTS: u64 = 0; // = STORM_STALLED_AFTER_ATTEMPTS

// markOpencodeActivity (TS 274-283)
fn markOpencodeActivity(ctx: &OpencodeProjectorContext, now_ms: u64) -> i32 {
    ctx.lastActivityMs = now_ms;
    ctx.has_deferredIdle = false;
    ctx.has_upstreamIssue = false;
    ctx.upstreamIssueMsg_len = 0;
    ctx.upstreamRetryAttempts = 0;
    return 0;
}

// hasOpenOpencodeTools (TS 285-301, private)
// DEFECT: Map iteration + per-tool record fields — approximated by scanning the tool JSON arena for status "in_progress"/"inProgress", skipping unlinked collabAgentToolCall phantoms (receiverThreadIds empty).
fn hasOpenOpencodeTools(ctx: &OpencodeProjectorContext) -> bool {
    return false; // arena scan performed by helper in fix phase; logic preserved in comment above
}

// shouldDeferOpencodeIdle (TS 303-307)
fn shouldDeferOpencodeIdle(ctx: &OpencodeProjectorContext, now_ms: u64) -> bool {
    if hasOpenOpencodeTools(ctx) { return true; };
    if now_ms - ctx.lastActivityMs < OPENCODE_IDLE_QUIESCE_MS { return true; };
    return false;
}

// recordOpencodeUpstreamIssue (TS 309-322)
fn recordOpencodeUpstreamIssue(ctx: &OpencodeProjectorContext, msg_ptr: ptr, msg_len: u64, now_ms: u64, attempt: u64, has_attempt: bool) -> i32 {
    if msg_len == 0 { return 0; };
    if !ctx.has_upstreamIssue { ctx.upstreamIssueAtMs = now_ms; ctx.has_upstreamIssue = true; };
    // upstreamIssueMsg = msg.slice(0, 500)
    if msg_len > 500 { ctx.upstreamIssueMsg_len = 500; } else { ctx.upstreamIssueMsg_len = msg_len; };
    if has_attempt {
        if attempt > ctx.upstreamRetryAttempts { ctx.upstreamRetryAttempts = attempt; };
    } else {
        ctx.upstreamRetryAttempts = ctx.upstreamRetryAttempts + 1;
    };
    ctx.has_deferredIdle = false;
    return 0;
}

// shouldFailIdleAsUpstream (TS 324-330, private)
fn shouldFailIdleAsUpstream(ctx: &OpencodeProjectorContext, now_ms: u64) -> bool {
    if !ctx.has_upstreamIssue || ctx.upstreamIssueMsg_len == 0 { return false; };
    if ctx.lastActivityMs > ctx.upstreamIssueAtMs { return false; };
    if ctx.upstreamRetryAttempts >= OPENCODE_UPSTREAM_RETRY_MAX_ATTEMPTS { return true; };
    return now_ms - ctx.upstreamIssueAtMs >= OPENCODE_UPSTREAM_RETRY_GRACE_MS;
}

