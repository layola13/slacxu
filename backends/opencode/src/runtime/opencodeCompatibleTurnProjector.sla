// forceTerminateOpencode (TS 1396-1429)
fn forceTerminateOpencode(ctx: &OpencodeProjectorContext, reason: u32, error_ptr: ptr, error_len: u64, has_error: bool, events: &ProjectedEventList) -> i32 {
    events.count = 0;
    if ctx.status != 0 { return 0; };
    // finalStatus = reason; completeActiveReasoning(finalStatus); completeActiveAssistantMessage(finalStatus) when started && !completed
    completeActiveReasoning(ctx, events, reason);
    completeActiveAssistantMessage(ctx, events, reason);
    // for each in-progress tool item: close via closeActiveToolItem(closeReasonForOpenToolItem(tool, reason)); push item/completed
    // flushOpencodePlanCandidates(events, failed|interrupted|completed per reason)
    flushOpencodePlanCandidates(ctx, events, reason);
    ctx.status = reason;
    events.count = events.count + 1; // push turn/interrupted | turn/failed{error} | turn/completed
    return 0;
}

// toOpencodeNotification (TS 1431-1539): projected event -> JsonRpcNotification JSON in out_json; has_notif=false for question/asked, system/init, default
// turn/started -> {method:"turn/started", params:{threadId, turnId, turn:{id, threadId, status:"inProgress", startedAt: now/1000}}}
// turn/completed -> turn/completed with completedAt + turn{status:"completed"}
// turn/failed -> turn/failed with turn{status:"failed", error: error ?? null} + top-level error
// turn/interrupted -> turn/interrupted with turn{status:"interrupted"}
// item/agentMessage/delta, item/reasoning/textDelta -> same method, params {threadId, turnId, itemId, delta}
// item/started, item/completed -> params {threadId, turnId, item}
// permission/asked -> item/commandExecution/requestApproval {id: requestId, threadId, turnId, toolName: permission, command: patterns, input:{permission, patterns, metadata}}
// thread/tokenUsage/updated -> params {threadId, turnId, tokenUsage, requestId?}
fn toOpencodeNotification(event: &OpencodeProjectedEvent, out_json: ptr, out_len: &u64, has_notif: &bool) -> i32 {
    has_notif = true;
    out_len = 0;
    if event.kind == KIND_QUESTION_ASKED || event.kind == KIND_SYSTEM_INIT {
        has_notif = false;
        return 0;
    };
    return 0;
}
