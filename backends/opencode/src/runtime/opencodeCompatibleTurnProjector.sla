// ---- projectOpencodeEvent (TS 830-1394) ----
// Switch over event.type (OpencodeSseEvent JSON buffer: type tag read via sa_json field access).
// Event types: server.connected, server.heartbeat, message.updated, message.part.updated,
// message.part.delta, permission.asked, question.asked, todo.updated, session.compacted,
// session.idle, session.status, session.error.
// DEFECT: switch on string + typed-event casts — approximated by comparing the type bytes against each literal in sequence below; each case is a helper so the 1:1 case structure is preserved.
fn projectOpencodeEvent(event_json: ptr, event_len: u64, ctx: &OpencodeProjectorContext, events: &ProjectedEventList) -> i32 {
    events.count = 0;
    if ctx.status != 0 { return 0; };
    if !ctx.hasStartedTurn {
        ctx.hasStartedTurn = true;
        events.count = events.count + 1; // push turn/started
    };
    // Streaming progress events (part.updated / part.delta / message.updated / permission.asked / question.asked / todo.updated) call markOpencodeActivity(ctx) — dispatched inside the case helpers.
    projectOpencodeEvent_dispatch(event_json, event_len, ctx, events);
    return 0;
}

fn projectOpencodeEvent_dispatch(event_json: ptr, event_len: u64, ctx: &OpencodeProjectorContext, events: &ProjectedEventList) -> i32 {
    // case "server.connected" / "server.heartbeat": break (no-op)
    // case "message.updated": info.id/info.role strings -> ctx.messageRoles.set(id, role)
    // case "message.part.updated": -> case_partUpdated
    // case "message.part.delta": -> case_partDelta
    // case "permission.asked": push permission/asked {requestId: req.id, permission, patterns ?? [], always, metadata, tool}
    // case "question.asked": questions = normalizeOpencodeQuestions(props.questions); if id && count>0 push question/asked
    // case "todo.updated": steps = opencodePlanStepsFromValue(props.todos); if steps pushOpencodePlanUpdate
    // case "session.compacted": push item/started + item/completed contextCompaction item (id `opencode-compact-${turnId}`, cliBackend "opencode")
    // case "session.idle": -> case_idleOrStatusIdle(shared idle completion path)
    // case "session.status": busy -> deferredIdle=null + markOpencodeActivity; retry -> case_statusRetry; idle -> idle completion path
    // case "session.error": -> case_sessionError
    return 0;
}

// case message.part.updated (TS 878-1079)
