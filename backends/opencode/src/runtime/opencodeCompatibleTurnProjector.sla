// DEFECT: discriminated union OpencodeProjectedEvent — approximated by a kind tag (u32) + one flat struct holding every variant's fields.

const KIND_TURN_STARTED: u32 = 1;
const KIND_TURN_COMPLETED: u32 = 2;
const KIND_TURN_FAILED: u32 = 3;
