// flushOpencodePlanCandidates (TS 503-534, private): for each pending candidate callId emit started+completed plain todowrite toolCall rows, then clear the set
fn flushOpencodePlanCandidates(ctx: &OpencodeProjectorContext, events: &ProjectedEventList, status: u32) -> i32 {
    let i: u64 = 0;
    while i < ctx.n_planCand {
        events.count = events.count + 2;
        i = i + 1;
    }
    ctx.n_planCand = 0;
    ctx.planCand_keys_len = 0;
    return 0;
}

