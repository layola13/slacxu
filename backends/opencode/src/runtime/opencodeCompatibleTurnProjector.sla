// completeOpencodePlan (TS 483-501, private): emit item/completed plan item (status override only for failed/interrupted)
fn completeOpencodePlan(ctx: &OpencodeProjectorContext, events: &ProjectedEventList, steps: &OpencodePlanStepList, status: u32) -> i32 {
