// opencodePlanStepsFromValue (TS 411-429, private): array of strings/records -> steps; null when empty
fn opencodePlanStepsFromValue(value_json: ptr, value_len: u64, is_array: bool, out: &OpencodePlanStepList) -> i32 {
    out.is_null = true;
    if !is_array { return 0; };
    // for each entry: string -> {step: trim, status: pending}; record -> step = content ?? subject ?? step ?? title ?? task, status = normalizeOpencodePlanStatus(record.status)
    // DEFECT: dynamic JSON array traversal — sa_json array iteration externs in fix phase; steps serialized to out.steps_json.
