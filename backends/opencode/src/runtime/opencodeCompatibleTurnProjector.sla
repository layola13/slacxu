// part.type == "tool": completeActiveReasoning; partTypes.set(id,"tool"); complete active assistant message; handleOpencodePlanToolPart -> break; handleOpencodeTaskToolPart -> break; generic row: create toolCall item {input: incomingInput ?? {}} or refresh input on change (empty-object input does not count); on state completed|error push item/completed with authoritative input, status failed|completed, output = error|output, title when completed
// part.type == "step-finish": if tokens, buildOpencodeTokenUsage(tokens, ctx.contextWindow) and push thread/tokenUsage/updated with requestId `opencode-${turnId}-${stepId}` when stepFinish.id non-empty
