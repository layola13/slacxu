// Probe: isolate miniDeclaresTurnComplete behavior under sa test (wave-2b).
@import "sa_std/string.sa"
@import "sa_std/io/print.sai"
@import "../../backends/mini/src/runtime/miniBridge.sla"

@test "probe single true"() {
    let got: bool = miniDeclaresTurnComplete(STR_PTR("DONE: fixed the login redirect"), STR_LEN("DONE: fixed the login redirect"));
    if got { println("PROBE single DONE -> true"); } else { println("PROBE single DONE -> false"); };
    if !got { panic(11); };
}

@test "probe two calls"() {
    let a: bool = miniDeclaresTurnComplete(STR_PTR("DONE: fixed the login redirect"), STR_LEN("DONE: fixed the login redirect"));
    if !a { panic(21); };
    let b: bool = miniDeclaresTurnComplete(STR_PTR("Summary of changes...\nDONE: all requested edits applied"), STR_LEN("Summary of changes...\nDONE: all requested edits applied"));
    if !b { panic(22); };
    let c: bool = miniDeclaresTurnComplete(STR_PTR("  DONE: done  "), STR_LEN("  DONE: done  "));
    if !c { panic(23); };
}
