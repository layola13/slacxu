// li_probe.sla — FULL runtime probe for apps/server/src/launchInstall.sla
// (steps 1-7 in one binary). NOTE: building it currently traps in the
// SAB flattener at createInstallJob's thread::spawn closure emission
// (compiler defect, FIX_SERVER_LAUNCH.md). Until that is fixed, the
// same assertions run split: run_li_probe.sh (steps 1-6, jobs family
// stubbed) and run_li_job_probe.sh (step 7, middle stubbed).
// Run with HOME=/tmp/li_home and PATH prefixed by /tmp/li_bin (fake
// `agy` executable) and the li stub server on 127.0.0.1:18778.
// Exit code = number of failed assertions; prints LI_PROBE_OK on success.
@import "sa_std/io/print.sai"
@import "li_lib_probe.sla"

fn fail(code: i32) -> i32 {
    println("LI_ASSERT_FAIL");
    return code;
}

fn main() -> i32 {
    let arena = LiText { bytes: [0u8; 262144], len: 0 };
    // ---- 1. spec table ----
    let spec = LaunchAdapterSpec { id_ptr: STR_PTR(""), id_len: 0, repo_ptr: STR_PTR(""), repo_len: 0, hasCloneUrl: false, cloneUrl_ptr: STR_PTR(""), cloneUrl_len: 0, wrapperBins_ptr: STR_PTR(""), wrapperBins_len: 0, wrapperBinsCount: 0, productBins_ptr: STR_PTR(""), productBins_len: 0, productBinsCount: 0, envPrefix_ptr: STR_PTR(""), envPrefix_len: 0, configDirName_ptr: STR_PTR(""), configDirName_len: 0 };
    if !getSpec(STR_PTR("claude-launch"), STR_LEN("claude-launch"), &spec) { return fail(101); };
    if !li_eq(spec.repo_ptr, spec.repo_len, STR_PTR("claude-launch"), STR_LEN("claude-launch")) { return fail(102); };
    if !li_eq(spec.envPrefix_ptr, spec.envPrefix_len, STR_PTR("CLAUDE_LAUNCH_"), STR_LEN("CLAUDE_LAUNCH_")) { return fail(103); };
    if !spec.hasCloneUrl { return fail(104); };
    if !getSpec(STR_PTR("pi-launch"), STR_LEN("pi-launch"), &spec) { return fail(105); };
    if spec.hasCloneUrl { return fail(106); };
    if getSpec(STR_PTR("bogus"), STR_LEN("bogus"), &spec) { return fail(107); };
    if !launchSpecAt(10, &spec) { return fail(108); };
    if !li_eq(spec.id_ptr, spec.id_len, STR_PTR("pi-launch"), STR_LEN("pi-launch")) { return fail(109); };
    if launchSpecAt(11, &spec) { return fail(110); };
    // agent-launch shares grok's env prefix
    if !getSpec(STR_PTR("agent-launch"), STR_LEN("agent-launch"), &spec) { return fail(111); };
    if !li_eq(spec.envPrefix_ptr, spec.envPrefix_len, STR_PTR("GROK_LAUNCH_"), STR_LEN("GROK_LAUNCH_")) { return fail(112); };

    // ---- 2. parseEnvFile / isPlaceholder ----
    let env_json = LiText { bytes: [0u8; 262144], len: 0 };
    let env_text = STR_PTR("# comment\nA=1\nB=\"two words\"\nC='x'\nBAD LINE\nD = spaced \n");
    sa_fs_write_file(STR_PTR("/tmp/li_env_probe.txt"), STR_LEN("/tmp/li_env_probe.txt"), env_text, STR_LEN("# comment\nA=1\nB=\"two words\"\nC='x'\nBAD LINE\nD = spaced \n"));
    parseEnvFile(STR_PTR("/tmp/li_env_probe.txt"), STR_LEN("/tmp/li_env_probe.txt"), &env_json);
    let edoc = li_parse(li_text_ptr(&env_json), env_json.len);
    if edoc == 0 { return fail(120); };
    let vs = LiStr { bytes: [0u8; 8192], len: 0 };
    if !li_node_string(edoc, STR_PTR("A"), STR_LEN("A"), &vs) { return fail(121); };
    if !li_eq(li_str_ptr(&vs), vs.len, STR_PTR("1"), STR_LEN("1")) { return fail(122); };
    if !li_node_string(edoc, STR_PTR("B"), STR_LEN("B"), &vs) { return fail(123); };
    if !li_eq(li_str_ptr(&vs), vs.len, STR_PTR("two words"), STR_LEN("two words")) { return fail(124); };
    if !li_node_string(edoc, STR_PTR("D"), STR_LEN("D"), &vs) { return fail(125); };
    if !li_eq(li_str_ptr(&vs), vs.len, STR_PTR("spaced"), STR_LEN("spaced")) { return fail(126); };
    li_free_doc(edoc);
    if !isPlaceholder(STR_PTR("your-api-key-here"), STR_LEN("your-api-key-here"), true) { return fail(127); };
    if isPlaceholder(STR_PTR("sk-live-123456"), STR_LEN("sk-live-123456"), true) { return fail(128); };

    // ---- 3. detectAll against the fake HOME ----
    // $HOME/.config/claude-launch/.env planted by the runner with
    // CLAUDE_LAUNCH_API_KEY=sk-probe; fake `agy` on PATH.
    let all = LiText { bytes: [0u8; 262144], len: 0 };
    let acnt: u64 = 0;
    detectAll(STR_PTR(""), 0, false, &all, &acnt);
    if acnt != 11 { return fail(130); };
    let adoc = li_parse(li_text_ptr(&all), all.len);
    if adoc == 0 { return fail(131); };
    let adapters = li_get(adoc, STR_PTR("adapters"), STR_LEN("adapters"));
    if adapters == 0 { return fail(132); };
    let n: u64 = 0;
    sa_json_value_count(adapters, &n);
    if n != 11 { return fail(133); };
    let ci: u64 = 0;
    let found_claude = false;
    let found_agy = false;
    while ci < n {
        let item: u64 = 0;
        if sa_json_array_get(adapters, ci, &item) == 0 {
            if item != 0 {
                let ids = LiStr { bytes: [0u8; 8192], len: 0 };
                if li_node_string(item, STR_PTR("id"), STR_LEN("id"), &ids) {
                    if li_eq(li_str_ptr(&ids), ids.len, STR_PTR("claude-launch"), STR_LEN("claude-launch")) {
                        found_claude = true;
                        let bv: bool = false;
                        let ep = li_get(item, STR_PTR("envPreview"), STR_LEN("envPreview"));
                        if ep == 0 { return fail(134); };
                        let hk = li_get(ep, STR_PTR("hasApiKey"), STR_LEN("hasApiKey"));
                        if hk == 0 { return fail(135); };
                        if sa_json_as_bool(hk, &bv) != 0 { return fail(136); };
                        if !bv { return fail(137); };
                    };
                    if li_eq(li_str_ptr(&ids), ids.len, STR_PTR("agy-launch"), STR_LEN("agy-launch")) {
                        found_agy = true;
                        let bv2: bool = false;
                        let inst = li_get(item, STR_PTR("installed"), STR_LEN("installed"));
                        if inst == 0 { return fail(138); };
                        if sa_json_as_bool(inst, &bv2) != 0 { return fail(139); };
                        if !bv2 { return fail(140); };
                    };
                };
            };
        };
        ci = ci + 1;
    }
    if !found_claude { return fail(141); };
    if !found_agy { return fail(142); };
    li_free_doc(adoc);

    // ---- 4. writeAdapterEnv (TS L435-471 semantics) ----
    if !getSpec(STR_PTR("claude-launch"), STR_LEN("claude-launch"), &spec) { return fail(150); };
    // remove the detect fixture so the create path is exercised fresh
    let fixture_path = LiStr { bytes: [0u8; 8192], len: 0 };
    configEnvPath(&spec, &fixture_path);
    sa_fs_remove_file(li_str_ptr(&fixture_path), fixture_path.len);
    let vals = LaunchEnvValues { hasBaseUrl: true, baseUrl_ptr: STR_PTR("https://api.example.com"), baseUrl_len: 23, hasModel: true, model_ptr: STR_PTR("gpt-x"), model_len: 5, hasApiKey: true, apiKey_ptr: STR_PTR("sk-first"), apiKey_len: 8 };
    let env_path = LiStr { bytes: [0u8; 8192], len: 0 };
    let wrote = false;
    let skipped = false;
    // no file + non-empty values -> upsert creates the file (no header)
    writeAdapterEnv(&spec, &vals, false, &env_path, &wrote, &skipped);
    if !wrote { return fail(151); };
    if skipped { return fail(152); };
    let content = LiText { bytes: [0u8; 262144], len: 0 };
    li_read_file(li_str_ptr(&env_path), env_path.len, &content);
    if !li_contains(li_text_ptr(&content), content.len, STR_PTR("CLAUDE_LAUNCH_API_KEY=sk-first"), STR_LEN("CLAUDE_LAUNCH_API_KEY=sk-first")) { return fail(153); };
    if li_contains(li_text_ptr(&content), content.len, STR_PTR("created by Codex React UI"), STR_LEN("created by Codex React UI")) { return fail(154); };
    // file exists + empty values + no force -> skipped
    let empty_vals = LaunchEnvValues { hasBaseUrl: false, baseUrl_ptr: STR_PTR(""), baseUrl_len: 0, hasModel: false, model_ptr: STR_PTR(""), model_len: 0, hasApiKey: false, apiKey_ptr: STR_PTR(""), apiKey_len: 0 };
    wrote = false;
    skipped = false;
    writeAdapterEnv(&spec, &empty_vals, false, &env_path, &wrote, &skipped);
    if wrote { return fail(155); };
    if !skipped { return fail(156); };
    // force with a new key -> upsert replaces the value, keeps the rest
    let vals2 = LaunchEnvValues { hasBaseUrl: true, baseUrl_ptr: STR_PTR("https://api.example.com"), baseUrl_len: 23, hasModel: true, model_ptr: STR_PTR("gpt-x"), model_len: 5, hasApiKey: true, apiKey_ptr: STR_PTR("sk-second"), apiKey_len: 9 };
    wrote = false;
    writeAdapterEnv(&spec, &vals2, true, &env_path, &wrote, &skipped);
    if !wrote { return fail(157); };
    content.len = 0;
    li_read_file(li_str_ptr(&env_path), env_path.len, &content);
    if !li_contains(li_text_ptr(&content), content.len, STR_PTR("CLAUDE_LAUNCH_API_KEY=sk-second"), STR_LEN("CLAUDE_LAUNCH_API_KEY=sk-second")) { return fail(158); };
    if li_contains(li_text_ptr(&content), content.len, STR_PTR("sk-first"), STR_LEN("sk-first")) { return fail(159); };
    // no file + empty values -> template file created, wrote=true
    sa_fs_remove_file(li_str_ptr(&env_path), env_path.len);
    wrote = false;
    skipped = false;
    writeAdapterEnv(&spec, &empty_vals, false, &env_path, &wrote, &skipped);
    if !wrote { return fail(165); };
    if skipped { return fail(166); };
    content.len = 0;
    li_read_file(li_str_ptr(&env_path), env_path.len, &content);
    if !li_contains(li_text_ptr(&content), content.len, STR_PTR("created by Codex React UI"), STR_LEN("created by Codex React UI")) { return fail(167); };

    let rc2 = probe_rest();
    if rc2 != 0 { return rc2; };

    println("LI_PROBE_OK");
    return 0;
}

fn probe_rest() -> i32 {
    let arena = LiText { bytes: [0u8; 262144], len: 0 };
    let spec = LaunchAdapterSpec { id_ptr: STR_PTR(""), id_len: 0, repo_ptr: STR_PTR(""), repo_len: 0, hasCloneUrl: false, cloneUrl_ptr: STR_PTR(""), cloneUrl_len: 0, wrapperBins_ptr: STR_PTR(""), wrapperBins_len: 0, wrapperBinsCount: 0, productBins_ptr: STR_PTR(""), productBins_len: 0, productBinsCount: 0, envPrefix_ptr: STR_PTR(""), envPrefix_len: 0, configDirName_ptr: STR_PTR(""), configDirName_len: 0 };
    // ---- 5. testOpenAiApi against the stub ----
    let req = TestOpenAiApiRequest { hasBaseUrl: true, baseUrl_ptr: STR_PTR("http://127.0.0.1:18778"), baseUrl_len: 22, hasModel: true, model_ptr: STR_PTR("gpt-probe"), model_len: 9, hasApiKey: true, apiKey_ptr: STR_PTR("sk-probe"), apiKey_len: 8 };
    let tres = TestOpenAiApiResult { ok: false, step1Ok: false, step2Ok: false, message_ptr: STR_PTR(""), message_len: 0, hasStatusCode: false, statusCode: 0 };
    testOpenAiApi(&req, &arena, &tres);
    if !tres.ok { return fail(160); };
    if tres.statusCode != 200 { return fail(161); };
    if !li_contains(tres.message_ptr, tres.message_len, STR_PTR("【测试通过】"), STR_LEN("【测试通过】")) { return fail(162); };
    // wrong key -> stub returns 401 for models
    let req2 = TestOpenAiApiRequest { hasBaseUrl: true, baseUrl_ptr: STR_PTR("http://127.0.0.1:18778"), baseUrl_len: 22, hasModel: true, model_ptr: STR_PTR("gpt-probe"), model_len: 9, hasApiKey: true, apiKey_ptr: STR_PTR("bad"), apiKey_len: 3 };
    testOpenAiApi(&req2, &arena, &tres);
    if tres.ok { return fail(163); };
    if tres.statusCode != 401 { return fail(164); };

    // ---- 6. installLaunchAdapters end-to-end (claude, prepared src) ----
    let sink = li_parse(STR_PTR("[]"), STR_LEN("[]"));
    let opts = InstallLaunchRequest { ids_ptr: STR_PTR("[\"claude-launch\"]"), ids_len: 17, idsCount: 1, hasIds: true, missingOnly: false, hasMissingOnly: false, skipCli: false, hasSkipCli: true, envMode: 2, hasEnvMode: true, sharedEnv: LaunchEnvValues { hasBaseUrl: false, baseUrl_ptr: STR_PTR(""), baseUrl_len: 0, hasModel: false, model_ptr: STR_PTR(""), model_len: 0, hasApiKey: false, apiKey_ptr: STR_PTR(""), apiKey_len: 0 }, hasSharedEnv: false, separateEnv_ptr: STR_PTR(""), separateEnv_len: 0, hasSeparateEnv: false, forceEnv: false, hasForceEnv: false, sourceRoot_ptr: STR_PTR("/tmp/li_src"), sourceRoot_len: 11, hasSourceRoot: true, skipModelTest: false, hasSkipModelTest: false };
    let state = LaunchInstallState { installLockHeld: false, jobs_ptr: STR_PTR(""), jobs_len: 0, jobsCount: 0 };
    let outcome = InstallLaunchOutcome { results: LiText { bytes: [0u8; 262144], len: 0 }, resultsCount: 0, adapters: LiText { bytes: [0u8; 262144], len: 0 }, adaptersCount: 0 };
    let irc = installLaunchAdapters(&state, &opts, sink, &outcome);
    if irc != 0 { return fail(170); };
    if outcome.resultsCount != 1 { return fail(171); };
    let rdoc = li_parse(li_text_ptr(&outcome.results), outcome.results.len);
    if rdoc == 0 { return fail(172); };
    let r0: u64 = 0;
    if sa_json_array_get(rdoc, 0, &r0) != 0 { return fail(173); };
    let ok_node = li_get(r0, STR_PTR("ok"), STR_LEN("ok"));
    if ok_node == 0 { return fail(174); };
    let okv: bool = false;
    sa_json_as_bool(ok_node, &okv);
    if !okv { return fail(175); };
    li_free_doc(rdoc);
    let sink_text = LiText { bytes: [0u8; 262144], len: 0 };
    li_stringify_into(sink, &sink_text);
    if !li_contains(li_text_ptr(&sink_text), sink_text.len, STR_PTR("成功 1 个"), STR_LEN("成功 1 个")) { return fail(176); };
    li_free_doc(sink);
    if installLockHeldNow() { return fail(177); };

    // ---- 7. createInstallJob -> poll to completion ----
    let job_opts = InstallLaunchRequest { ids_ptr: STR_PTR("[\"bogus\"]"), ids_len: 9, idsCount: 1, hasIds: true, missingOnly: false, hasMissingOnly: false, skipCli: false, hasSkipCli: false, envMode: 2, hasEnvMode: true, sharedEnv: LaunchEnvValues { hasBaseUrl: false, baseUrl_ptr: STR_PTR(""), baseUrl_len: 0, hasModel: false, model_ptr: STR_PTR(""), model_len: 0, hasApiKey: false, apiKey_ptr: STR_PTR(""), apiKey_len: 0 }, hasSharedEnv: false, separateEnv_ptr: STR_PTR(""), separateEnv_len: 0, hasSeparateEnv: false, forceEnv: false, hasForceEnv: false, sourceRoot_ptr: STR_PTR(""), sourceRoot_len: 0, hasSourceRoot: false, skipModelTest: false, hasSkipModelTest: false };
    let job_id = LiStr { bytes: [0u8; 8192], len: 0 };
    createInstallJob(&state, &job_opts, &job_id);
    if job_id.len != 36 { return fail(180); };
    let jdoc = li_jobsdoc();
    let done = false;
    let tries: u64 = 0;
    let status_s = LiStr { bytes: [0u8; 8192], len: 0 };
    let step_s = LiStr { bytes: [0u8; 8192], len: 0 };
    let results_s = LiText { bytes: [0u8; 262144], len: 0 };
    while tries < 100 && !done {
        let rec = li_get(jdoc, li_str_ptr(&job_id), job_id.len);
        if rec != 0 {
            if li_node_string(rec, STR_PTR("status"), STR_LEN("status"), &status_s) {
                if li_eq(li_str_ptr(&status_s), status_s.len, STR_PTR("completed"), STR_LEN("completed")) { done = true; };
            };
        };
        if !done { sa_time_sleep_ms(100); };
        tries = tries + 1;
    }
    if !done { return fail(181); };
    let rec2 = li_get(jdoc, li_str_ptr(&job_id), job_id.len);
    if rec2 == 0 { return fail(182); };
    if !li_node_string(rec2, STR_PTR("progressStep"), STR_LEN("progressStep"), &step_s) { return fail(183); };
    if !li_contains(li_str_ptr(&step_s), step_s.len, STR_PTR("Completed 0/1"), STR_LEN("Completed 0/1")) { return fail(184); };
    if !li_node_text(rec2, STR_PTR("resultsText"), STR_LEN("resultsText"), &results_s) { return fail(185); };
    if !li_contains(li_text_ptr(&results_s), results_s.len, STR_PTR("bogus"), STR_LEN("bogus")) { return fail(186); };

    return 0;
}
