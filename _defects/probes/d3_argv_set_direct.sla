@import "sa_std/process.sai";
@import "sa_std/process.sa";
@import "sa_std/string.sa";
@import "sa_std/io.sai";
@import "sa_std/time.sai";

// D3 minimal repro -- CONTROL (working form). See _defects/FIX_TOOL_D1D2.md.
// PROCESS_ARGV_SET_PTR expanded in the function that OWNS the argv slots
// array (here: a struct-wrapped [u64; 40] local in main) works: the pair
// is written, and sa_std_process_run_cwd consumes it (git --version runs).
// Contrast with d3_argv_set_via_ref.sla (same macro one helper away ->
// segfault under sa_plugin_sla 969d8535).
// Run (from the bulk tree root):
//   sa build-exe _defects/probes/d3_argv_set_direct.sla && ./_defects/probes/d3_argv_set_direct
// Expected: prints R0_OK, exit 0. Requires git on PATH and /tmp writable.
struct ArrWrap {
    slots: [u64; 40],
}

fn out_lit(p: ptr, n: u64) -> void {
    let rc: i32 = sa_io_write_all(sa_io_stdout(), p, n);
}

fn main() -> i32 {
    let a = ArrWrap { slots: [0u64; 40] };
    PROCESS_ARGV_SET_PTR(&a.slots, 0, STR_PTR("git"), STR_LEN("git"));
    PROCESS_ARGV_SET_PTR(&a.slots, 1, STR_PTR("--version"), STR_LEN("--version"));
    if a.slots[1] != 3 || a.slots[3] != 9 { out_lit(STR_PTR("R0_BAD slots\n"), STR_LEN("R0_BAD slots\n")); return 3; };
    let ap: ptr = PTR_NULL();
    PTR_BYTE_ADD(ap, &a.slots, 0);
    let proc: u64 = 0;
    let rc: i32 = sa_std_process_run_cwd(ap, 2, STR_PTR("/tmp"), STR_LEN("/tmp"), &proc);
    if rc != 0 || proc == 0 { out_lit(STR_PTR("R0_BAD spawn\n"), STR_LEN("R0_BAD spawn\n")); return 4; };
    let ready: u64 = 0;
    let code: u64 = 0;
    let spins: u64 = 0;
    while spins < 2000 {
        let trc: i32 = sa_std_process_try_wait(proc, &ready, &code);
        if ready == 1 { break; };
        let src: i32 = sa_time_sleep_ms(5);
        spins = spins + 1;
    }
    let chunk = [0u8; 8192];
    let cp: ptr = PTR_NULL();
    PTR_BYTE_ADD(cp, &chunk, 0);
    let total: u64 = 0;
    while true {
        let n: u64 = 0;
        let rrc: i32 = sa_std_process_read_stdout(proc, cp, 8192, &n);
        if n == 0 { break; };
        total = total + n;
    }
    let crc: i32 = sa_std_process_close(proc);
    if total >= 11 && chunk[0] == 103 && chunk[1] == 105 && chunk[2] == 116 {
        out_lit(STR_PTR("R0_OK\n"), STR_LEN("R0_OK\n"));
        return 0;
    };
    out_lit(STR_PTR("R0_BAD output\n"), STR_LEN("R0_BAD output\n"));
    return 5;
}
