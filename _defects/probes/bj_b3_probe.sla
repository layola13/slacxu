// bj_b3_probe — index.sla isCliPluginEnabled cache-miss wiring probe
// (BJ line; FIX_INDEX B3 closure evidence). Mode via env BJ_B3_MODE:
//   unset — no CLI env flags set: codex/mini/unknown all default false
//           (entry env unset / no entry / no entry), miss path exercised.
//   set   — CODEX_UI_CODEX_COMPATIBLE_CLI_ENABLED=1 (runner exports it):
//           codex true via the real entries+env path; cline false (its
//           own flag unset); setCliPluginEnabled(codex, false) then wins
//           over the env (state cache consulted first, as in TS).
//   yes   — CODEX_UI_AGY_COMPATIBLE_CLI_ENABLED=yes: agy true.
// Prints BJ_B3_PROBE_OK on success; BJ_B3_PROBE_FAIL <code> else.

@import "../../apps/server/src/index.sla"

fn b3_fail(code: i32) -> i32 {
    println("BJ_B3_PROBE_FAIL {}", code);
    return code;
}

fn b3_eq(a_ptr: ptr, a_len: u64, b_ptr: ptr, b_len: u64) -> bool {
    if a_len != b_len { return false; };
    let i: u64 = 0;
    while i < a_len {
        let x: u8 = 0;
        PTR_BYTE_AT(x, a_ptr, i);
        let y: u8 = 0;
        PTR_BYTE_AT(y, b_ptr, i);
        if x != y { return false; };
        i = i + 1;
    }
    return true;
}

fn b3_globals() -> ServerGlobals {
    return ServerGlobals {
        activeTurnsByUser: 0,
        codexChildParentByThread: 0,
        codexActiveChildrenByParent: 0,
        codexDeferredTerminalByTurn: 0,
        cliPluginEnabledState: 0,
        agySettingsSnapshotted: false,
        nextSshForwardPort: 0,
    };
}

fn main() -> i32 {
    let mh = sa_env_get(STR_PTR("BJ_B3_MODE"), STR_LEN("BJ_B3_MODE"));
    if mh == 0 { return b3_fail(1); };
    let mp: ptr = sa_env_buffer_data(mh);
    let ml = sa_env_buffer_len(mh);

    if b3_eq(mp, ml, STR_PTR("unset"), STR_LEN("unset")) {
        let g = b3_globals();
        if isCliPluginEnabled(&g, STR_PTR("codex"), STR_LEN("codex")) { return b3_fail(2); };
        if isCliPluginEnabled(&g, STR_PTR("mini"), STR_LEN("mini")) { return b3_fail(3); };
        if isCliPluginEnabled(&g, STR_PTR("nope"), STR_LEN("nope")) { return b3_fail(4); };
        // second call hits the state cache written by the miss path
        if isCliPluginEnabled(&g, STR_PTR("codex"), STR_LEN("codex")) { return b3_fail(5); };
        println("mode_unset_ok=1");
        println("BJ_B3_PROBE_OK");
        return 0;
    };

    if b3_eq(mp, ml, STR_PTR("set"), STR_LEN("set")) {
        let g = b3_globals();
        if !isCliPluginEnabled(&g, STR_PTR("codex"), STR_LEN("codex")) { return b3_fail(6); };
        if isCliPluginEnabled(&g, STR_PTR("cline"), STR_LEN("cline")) { return b3_fail(7); };
        setCliPluginEnabled(&g, STR_PTR("codex"), STR_LEN("codex"), false);
        if isCliPluginEnabled(&g, STR_PTR("codex"), STR_LEN("codex")) { return b3_fail(8); };
        println("mode_set_ok=1");
        println("BJ_B3_PROBE_OK");
        return 0;
    };

    if b3_eq(mp, ml, STR_PTR("yes"), STR_LEN("yes")) {
        let g = b3_globals();
        if !isCliPluginEnabled(&g, STR_PTR("agy"), STR_LEN("agy")) { return b3_fail(9); };
        if isCliPluginEnabled(&g, STR_PTR("grok"), STR_LEN("grok")) { return b3_fail(10); };
        println("mode_yes_ok=1");
        println("BJ_B3_PROBE_OK");
        return 0;
    };

    return b3_fail(11);
}
