@import "sa_std/process.sai";
@import "sa_std/process.sa";
@import "sa_std/string.sa";
@import "sa_std/io.sai";
@import "sa_std/fmt.sai";

// D3 minimal repro -- FAILING form (compiler-shape defect).
// See _defects/FIX_TOOL_D1D2.md for the full bisect chain.
// PROCESS_ARGV_SET_PTR expanded inside a helper function whose slots array
// arrives via a &Struct parameter segfaults under sa_plugin_sla 969d8535:
// the macro's slot stores (ptr_add %argv, idx*16, then store) fault when
// %argv is not an array local of the expanding function. The same holds
// when the base arrives as a plain ptr parameter, and when the base is
// first computed with PTR_BYTE_ADD inside the helper (arr_base returns
// fine; the store faults). The direct form (d3_argv_set_direct.sla) and
// git_argv_ptr's address computation through a reference both work, so
// the defect is specific to this macro's STORE expansion in this shape.
// This is the shape the original saVmTool git_argv_set helper used;
// execGitSync / spawnHostProcess / spawnScriptRunner all routed through
// it and segfaulted at their first argv write.
// Run (from the bulk tree root):
//   sa build-exe _defects/probes/d3_argv_set_via_ref.sla && ./_defects/probes/d3_argv_set_via_ref
// Expected on 969d8535: prints the "pre" line, then SIGSEGV (exit 139)
//   inside set_via_ref; sentinel slots are never updated.
// Expected once the compiler defect is fixed: prints post slots0=<ptr>
//   slots1=3 and E_OK, exit 0.
struct ArrWrap {
    slots: [u64; 40],
}

fn out_lit(p: ptr, n: u64) -> void {
    let rc: i32 = sa_io_write_all(sa_io_stdout(), p, n);
}

fn out_u64(v: u64) -> void {
    let buf = [0u8; 32];
    let bp: ptr = PTR_NULL();
    PTR_BYTE_ADD(bp, &buf, 0);
    let n: u64 = 0;
    let rc: i32 = sa_fmt_u64_into(v, 10, bp, 32, &n);
    let rc2: i32 = sa_io_write_all(sa_io_stdout(), bp, n);
}

fn set_via_ref(a: &ArrWrap, idx: u64, p: ptr, n: u64) -> void {
    PROCESS_ARGV_SET_PTR(&a.slots, idx, p, n);
}

fn main() -> i32 {
    let a = ArrWrap { slots: [0u64; 40] };
    a.slots[0] = 111;
    a.slots[1] = 222;
    let canary: u64 = 12345678;
    out_lit(STR_PTR("pre slots0="), STR_LEN("pre slots0="));
    out_u64(a.slots[0]);
    out_lit(STR_PTR(" slots1="), STR_LEN(" slots1="));
    out_u64(a.slots[1]);
    out_lit(STR_PTR("\n"), STR_LEN("\n"));
    set_via_ref(&a, 0, STR_PTR("git"), STR_LEN("git"));
    out_lit(STR_PTR("post slots0="), STR_LEN("post slots0="));
    out_u64(a.slots[0]);
    out_lit(STR_PTR(" slots1="), STR_LEN(" slots1="));
    out_u64(a.slots[1]);
    out_lit(STR_PTR(" canary="), STR_LEN(" canary="));
    out_u64(canary);
    out_lit(STR_PTR("\n"), STR_LEN("\n"));
    if a.slots[1] == 3 && a.slots[0] != 0 && a.slots[0] != 111 {
        out_lit(STR_PTR("E_OK\n"), STR_LEN("E_OK\n"));
        return 0;
    };
    out_lit(STR_PTR("E_MISDIRECTED\n"), STR_LEN("E_MISDIRECTED\n"));
    return 3;
}
