@import "../../apps/server/src/saVmTool.sla";
@import "sa_std/string.sa";
@import "sa_std/io.sai";

fn out_lit(p: ptr, n: u64) -> void {
    let rc: i32 = sa_io_write_all(sa_io_stdout(), p, n);
}

// Regression probe: saVmTool D1 + D2 (see _defects/FIX_TOOL_D1D2.md).
// D1: isSaVmBlockedToolName -- TS saVmTool.ts L12035 regex separator class
//     is [._:/-]: underscore IS a segment boundary, and the alternatives
//     apply_patch / write_file / edit_file are whole boundary-delimited
//     tokens that contain an underscore themselves.
// D2: parseGitBranchHeader -- TS L7308-7316 uses /ahead (\d+)/ and
//     /behind (\d+)/ prefix captures on the flags text; neither value may
//     swallow the ", behind N" tail.
// Run (from the bulk tree root):
//   export PATH=/content/sa_all/sci/zig-out/bin:/content/sa_all/sa_plugin_sla/zig-out/bin:$PATH
//   export SA_PLUGIN_DEV=1 SLA_NO_FRESHNESS_CACHE=1 SA_STD_DIR=/content/sa_all/sci/sa_std
//   sa build-exe _defects/probes/tool_d1d2_regression.sla && ./_defects/probes/tool_d1d2_regression
// Expected: prints D1D2_OK, exit 0. On the pre-fix tree: PANIC 1201 (D1)
// or PANIC 504 (D2). Requires a git repo at /tmp/vrepo? No (that is the
// D3 probe); this probe is pure.
fn expect_blocked(s: &StrBuf, p: ptr, n: u64, code: u64) -> void {
    sb_assign(s, p, n);
    if !isSaVmBlockedToolName(s) { panic(code); };
}

fn expect_free(s: &StrBuf, p: ptr, n: u64, code: u64) -> void {
    sb_assign(s, p, n);
    if isSaVmBlockedToolName(s) { panic(code); };
}

fn expect_header(h: &StrBuf, br: &StrBuf, up: &StrBuf, has_up: &bool, ah: &u64, be: &u64, hp: ptr, hn: u64, want_br: ptr, want_brn: u64, want_up: ptr, want_upn: u64, want_has: bool, want_ah: u64, want_be: u64, code: u64) -> void {
    sb_assign(h, hp, hn);
    parseGitBranchHeader(h, br, up, has_up, ah, be);
    if !sb_eq(br, want_br, want_brn) { panic(code); };
    if want_has {
        if !*has_up { panic(code + 1); };
        if !sb_eq(up, want_up, want_upn) { panic(code + 2); };
    } else {
        if *has_up { panic(code + 1); };
    };
    if *ah != want_ah { panic(code + 3); };
    if *be != want_be { panic(code + 4); };
}

fn main() -> i32 {
    let s: StrBuf = StrBuf { bytes: [0u8; 65536], len: 0 };
    // D1 core (G12): underscore-compound names are blocked.
    expect_blocked(&s, STR_PTR("my_bash"), STR_LEN("my_bash"), 1201);
    expect_blocked(&s, STR_PTR("bash_tool"), STR_LEN("bash_tool"), 1202);
    // D1 true mask (G10) must not regress.
    expect_blocked(&s, STR_PTR("bash"), STR_LEN("bash"), 1001);
    expect_blocked(&s, STR_PTR("BASH"), STR_LEN("BASH"), 1002);
    expect_blocked(&s, STR_PTR("foo.bash"), STR_LEN("foo.bash"), 1003);
    expect_blocked(&s, STR_PTR("x/shell"), STR_LEN("x/shell"), 1004);
    expect_blocked(&s, STR_PTR("python3"), STR_LEN("python3"), 1005);
    expect_blocked(&s, STR_PTR("python3.11"), STR_LEN("python3.11"), 1006);
    expect_blocked(&s, STR_PTR("node"), STR_LEN("node"), 1007);
    expect_blocked(&s, STR_PTR("apply_patch"), STR_LEN("apply_patch"), 1008);
    expect_blocked(&s, STR_PTR("write_file"), STR_LEN("write_file"), 1009);
    expect_blocked(&s, STR_PTR("ts-node"), STR_LEN("ts-node"), 1010);
    // D1 underscore-token preservation (TS whole-token alternatives).
    expect_blocked(&s, STR_PTR("edit_file"), STR_LEN("edit_file"), 1011);
    expect_blocked(&s, STR_PTR("foo.apply_patch"), STR_LEN("foo.apply_patch"), 1012);
    expect_blocked(&s, STR_PTR("foo_apply_patch"), STR_LEN("foo_apply_patch"), 1013);
    expect_blocked(&s, STR_PTR("my_python"), STR_LEN("my_python"), 1014);
    // D1 false mask (G11) must not regress.
    expect_free(&s, STR_PTR("read_file"), STR_LEN("read_file"), 1101);
    expect_free(&s, STR_PTR("list_dir"), STR_LEN("list_dir"), 1102);
    expect_free(&s, STR_PTR("shellcheck"), STR_LEN("shellcheck"), 1103);
    expect_free(&s, STR_PTR("pythonista"), STR_LEN("pythonista"), 1104);
    expect_free(&s, STR_PTR("nodes"), STR_LEN("nodes"), 1105);
    expect_free(&s, STR_PTR("execute"), STR_LEN("execute"), 1106);
    expect_free(&s, STR_PTR(""), STR_LEN(""), 1107);
    expect_free(&s, STR_PTR("xapply_patch"), STR_LEN("xapply_patch"), 1108);
    expect_free(&s, STR_PTR("apply_patchx"), STR_LEN("apply_patchx"), 1109);
    // D2 header forms (G5/G6 + ahead-only/behind-only/two-digit).
    let h: StrBuf = StrBuf { bytes: [0u8; 65536], len: 0 };
    let br: StrBuf = StrBuf { bytes: [0u8; 65536], len: 0 };
    let up: StrBuf = StrBuf { bytes: [0u8; 65536], len: 0 };
    let has_up: bool = false;
    let ah: u64 = 0;
    let be: u64 = 0;
    expect_header(&h, &br, &up, &has_up, &ah, &be, STR_PTR("main...origin/main [ahead 2, behind 1]"), STR_LEN("main...origin/main [ahead 2, behind 1]"), STR_PTR("main"), STR_LEN("main"), STR_PTR("origin/main"), STR_LEN("origin/main"), true, 2, 1, 500);
    expect_header(&h, &br, &up, &has_up, &ah, &be, STR_PTR("dev...origin/dev"), STR_LEN("dev...origin/dev"), STR_PTR("dev"), STR_LEN("dev"), STR_PTR("origin/dev"), STR_LEN("origin/dev"), true, 0, 0, 510);
    expect_header(&h, &br, &up, &has_up, &ah, &be, STR_PTR("main...origin/main [ahead 3]"), STR_LEN("main...origin/main [ahead 3]"), STR_PTR("main"), STR_LEN("main"), STR_PTR("origin/main"), STR_LEN("origin/main"), true, 3, 0, 520);
    expect_header(&h, &br, &up, &has_up, &ah, &be, STR_PTR("main...origin/main [behind 4]"), STR_LEN("main...origin/main [behind 4]"), STR_PTR("main"), STR_LEN("main"), STR_PTR("origin/main"), STR_LEN("origin/main"), true, 0, 4, 530);
    expect_header(&h, &br, &up, &has_up, &ah, &be, STR_PTR("feat...o/feat [ahead 12, behind 30]"), STR_LEN("feat...o/feat [ahead 12, behind 30]"), STR_PTR("feat"), STR_LEN("feat"), STR_PTR("o/feat"), STR_LEN("o/feat"), true, 12, 30, 540);
    expect_header(&h, &br, &up, &has_up, &ah, &be, STR_PTR("No commits yet on feat-x"), STR_LEN("No commits yet on feat-x"), STR_PTR("feat-x"), STR_LEN("feat-x"), STR_PTR(""), STR_LEN(""), false, 0, 0, 550);
    expect_header(&h, &br, &up, &has_up, &ah, &be, STR_PTR("plain-branch"), STR_LEN("plain-branch"), STR_PTR("plain-branch"), STR_LEN("plain-branch"), STR_PTR(""), STR_LEN(""), false, 0, 0, 560);
    out_lit(STR_PTR("D1D2_OK\n"), STR_LEN("D1D2_OK\n"));
    return 0;
}
