// Micro-probe: dump resolveSaVmMcpSourceCandidates count + item lengths
// (DEFECT #18 verification, Agent AD3 step 2).
@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/ptr.sa"
@import "../../sdk-backend/src/saVmPaths.sla"

fn main() -> i32 {
    let c = SaVmCandidates { items: [PathBuf { bytes: [0u8; 4096], len: 0 }, PathBuf { bytes: [0u8; 4096], len: 0 }, PathBuf { bytes: [0u8; 4096], len: 0 }, PathBuf { bytes: [0u8; 4096], len: 0 }, PathBuf { bytes: [0u8; 4096], len: 0 }, PathBuf { bytes: [0u8; 4096], len: 0 }, PathBuf { bytes: [0u8; 4096], len: 0 }, PathBuf { bytes: [0u8; 4096], len: 0 }], count: 0 };
    resolveSaVmMcpSourceCandidates(STR_PTR("/tmp/bu_probe_ws"), STR_LEN("/tmp/bu_probe_ws"), true, &c);
    println("count={}", c.count);
    let i: u64 = 0;
    while i < c.count {
        let item = c.items[i];
        println("item_len={}", item.len);
        i = i + 1;
    }
    return 0;
}
