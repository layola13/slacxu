// bj_dbg2 — COMPILER DEFECT repro (BJ line, for the BG fix line):
// indexing an array of structs collapses every index to one element in
// the sa (SAB) backend at runtime. ph_fill_settings(slot 1, "AAAA")
// makes ALL slots read slug_len=4 "AAAA"; filling slot 3 then overwrites
// every slot again. A plain local [T; 4] shows the same collapse
// (arr[2].slug_len = 77 -> arr[0]/arr[1] also read 77). sa check passes;
// the failure is runtime-only. Expected correct output: per-slot values
// (tag=1: only slot 1 has len 4; tag=2: slot 1 len 4, slot 3 len 6;
// local arr: only [2] has slug_len 77). Primitive arrays ([u64; N],
// [bool; N], [u8; N]) index correctly — see bj_dbg3.sla.

@import "../../apps/server/src/pluginHost.sla"

fn dump(r: &PluginHostRegistry, slot: u64, tag: u64) -> void {
    println("tag={} slot={} slug_len={} b0={} b1={} b2={} b3={}", tag, slot, r.cliSettings[slot].slug_len, r.cliSettings[slot].slug[0], r.cliSettings[slot].slug[1], r.cliSettings[slot].slug[2], r.cliSettings[slot].slug[3]);
}

fn main() -> i32 {
    let host = pluginHost_alloc();
    ph_fill_settings(&host, 1, STR_PTR("AAAA"), 4, STR_PTR("E1"), 2, false, STR_PTR(""), 0);
    dump(&host, 0, 1);
    dump(&host, 1, 1);
    dump(&host, 2, 1);
    dump(&host, 3, 1);
    ph_fill_settings(&host, 3, STR_PTR("BBBBBB"), 6, STR_PTR("E2"), 2, false, STR_PTR(""), 0);
    dump(&host, 1, 2);
    dump(&host, 3, 2);
    // local array of structs, variable index
    let arr = [ph_empty_cli_settings(); 4];
    arr[2].slug_len = 77;
    arr[2].slug[0] = 90;
    println("local arr: [0].slug_len={} [2].slug_len={} [2].slug0={} [1].slug_len={}", arr[0].slug_len, arr[2].slug_len, arr[2].slug[0], arr[1].slug_len);
    println("BJ_DBG2_DONE");
    return 0;
}
