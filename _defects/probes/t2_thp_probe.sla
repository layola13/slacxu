// Probe (wave-2 tests line): isolates the sa test SAB-direct block for
// tests/server/threadHistoryPaging.test.sla. Import-only closure passes
// (empty @test variant ran green); adding the pageThreadHistory call below
// fails fast with: SAB Error: direct SLA-to-SAB lowering failed:
// error.UnsupportedSabDirectFeature. sa check passes on both variants.
@import "sa_std/encoding/json.sai"
@import "sa_std/string.sa"
@import "sa_std/ptr.sa"
@import "../../apps/server/src/threadHistoryPaging.sla"

@test "probe call"() {
    let opts = PageOptions { has_cursor: false, cursor: [0u8; 128], cursor_len: 0, has_limit: true, limit: 1, ascending: false };
    let out = PageResult { page_json: [0u8; 262144], page_len: 0, has_nextCursor: false, nextCursor: [0u8; 128], nextCursor_len: 0 };
    let rc: i32 = pageThreadHistory(STR_PTR("thread"), STR_LEN("thread"), STR_PTR("[]"), STR_LEN("[]"), STR_PTR("[]"), STR_LEN("[]"), &opts, &out);
    if rc != 0 { panic(1); };
    if out.page_len == 0 { panic(2); };
}
