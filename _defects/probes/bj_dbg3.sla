// bj_dbg3 — companion repro: nested byte arrays [[u8; 8]; 4] collapse
// the same way (bytes2d[x][0] reads the last-written row's byte for
// every x), while the sibling primitive arrays in the same struct
// (lens: [u64; 4], flags: [bool; 4]) index CORRECTLY. This pins the
// defect to composite element types (struct / array elements), not to
// arrays in general. Expected correct output: slot0 b0=0, slot1 b0=65,
// slot3 b0=67. Actual (defective): b0=67 for every slot.

@import "sa_std/io/print.sai"
@import "sa_std/ptr.sa"
@import "sa_std/string.sa"

struct Nest {
    bytes2d: [[u8; 8]; 4],
    lens: [u64; 4],
    flags: [bool; 4],
}

fn nest_alloc() -> Nest {
    return Nest { bytes2d: [[0u8; 8]; 4], lens: [0u64; 4], flags: [false; 4] };
}

fn main() -> i32 {
    let n = nest_alloc();
    n.bytes2d[1][0] = 65;
    n.bytes2d[1][1] = 66;
    n.lens[1] = 2;
    n.bytes2d[3][0] = 67;
    n.lens[3] = 1;
    n.flags[3] = true;
    println("slot0: len={} b0={} flag={}", n.lens[0], n.bytes2d[0][0], n.flags[0]);
    println("slot1: len={} b0={} b1={} flag={}", n.lens[1], n.bytes2d[1][0], n.bytes2d[1][1], n.flags[1]);
    println("slot2: len={} b0={} flag={}", n.lens[2], n.bytes2d[2][0], n.flags[2]);
    println("slot3: len={} b0={} flag={}", n.lens[3], n.bytes2d[3][0], n.flags[3]);
    // variable index through &param
    let s: u64 = 3;
    println("var slot3: len={} b0={} flag={}", n.lens[s], n.bytes2d[s][0], n.flags[s]);
    println("BJ_DBG3_DONE");
    return 0;
}
