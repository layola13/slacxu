// sw_probe.sla — runtime probe for apps/server/src/saVmSplitWorkflow.sla.
// Drives runSplitWorkflowAction(action="split_plan") end-to-end against a
// scratch workspace (created by run_sw_probe.sh; cwd = workspace) with a
// policy doc granting read on "." — the plan path must complete with the
// registered BLOCKED coupling text in place of the crashing provider call.
// Prints SW_PROBE_OK on success.
@import "sa_std/io/print.sai"
@import "sa_std/ptr.sa"
@import "sa_std/string.sa"
@import "sa_std/encoding/json.sai"
@import "sa_std/fs.sai"
@import "../../apps/server/src/saVmSplitWorkflow.sla"

fn swprobe_has(p: ptr, n: u64, q: ptr, qn: u64) -> bool {
    if qn == 0 { return true; };
    if n < qn { return false; };
    let i: u64 = 0;
    while i + qn <= n {
        let sub: ptr = PTR_NULL();
        PTR_BYTE_ADD(sub, p, i);
        if sw_eq(sub, qn, q, qn) { return true; };
        i = i + 1;
    }
    return false;
}

fn main() -> i32 {
    let fails: i64 = 0;
    let input = SplitInput {
        action: [0u8; 64], action_len: 0,
        has_path: false, path: [0u8; 1024], path_len: 0,
        has_session_id: false, session_id: [0u8; 64], session_id_len: 0,
        has_task: false, task: [0u8; 4096], task_len: 0,
        has_phase: false, phase: [0u8; 64], phase_len: 0,
        has_module_name: false, module_name: [0u8; 512], module_name_len: 0,
        op_paths: [0u8; 20480], op_path_lens: [0u64; 20],
        op_has_content: [false; 20], op_has_patch: [false; 20],
        op_contents: [0u8; 4194304], op_content_lens: [0u64; 20],
        op_patches: [0u8; 1048576], op_patch_lens: [0u64; 20],
        ops_len: 0, has_ops: false,
        has_confirm: false, confirm: false,
        has_policy: false, policy_id: 0,
        roots: [0u8; 16384], root_lens: [0u64; 16], roots_len: 0, has_roots: false
    };
    let ai: u64 = 0;
    while ai < STR_LEN("split_plan") { input.action[ai] = sw_byte(STR_PTR("split_plan"), ai); ai = ai + 1; }
    input.action_len = STR_LEN("split_plan");
    let pi: u64 = 0;
    while pi < STR_LEN("src/a.ts") { input.path[pi] = sw_byte(STR_PTR("src/a.ts"), pi); pi = pi + 1; }
    input.path_len = STR_LEN("src/a.ts");
    input.has_path = true;
    let out = SplitResult {
        ok: false, kind: [0u8; 64], kind_len: 0, exit_code: 0,
        stdout_buf: [0u8; 262144], stdout_len: 0,
        stderr_buf: [0u8; 65536], stderr_len: 0,
        events_json: [0u8; 65536], events_json_len: 0,
        has_violation: false, violation_reason: [0u8; 1024], violation_reason_len: 0,
        duration_ms: 0
    };
    let pol = sa_json_parse(STR_PTR("{\"fs\":{\"entries\":[{\"path\":\".\",\"access\":\"read\"},{\"path\":\".\",\"access\":\"write\"}]}}"), STR_LEN("{\"fs\":{\"entries\":[{\"path\":\".\",\"access\":\"read\"},{\"path\":\".\",\"access\":\"write\"}]}}"));
    if pol == 0 { println("SW_FAIL 300"); return 1; };
    runSplitWorkflowAction(&input, pol, true, STR_PTR("/tmp/sw_ws"), STR_LEN("/tmp/sw_ws"), 0, &out);
    if !out.ok { println("SW_FAIL 301"); fails = fails + 1; };
    println("SW_DEBUG kind_len {} exit {} stdout_len {} stderr_len {}", out.kind_len, out.exit_code, out.stdout_len, out.stderr_len);
    let ep: ptr = PTR_NULL();
    PTR_BYTE_ADD(ep, &out.stderr_buf, 0);
    let wf = sa_fs_write_file(STR_PTR("/tmp/sw_stderr.txt"), STR_LEN("/tmp/sw_stderr.txt"), ep, out.stderr_len);
    let op2: ptr = PTR_NULL();
    PTR_BYTE_ADD(op2, &out.stdout_buf, 0);
    let wf2 = sa_fs_write_file(STR_PTR("/tmp/sw_stdout.txt"), STR_LEN("/tmp/sw_stdout.txt"), op2, out.stdout_len);
    let op: ptr = PTR_NULL();
    PTR_BYTE_ADD(op, &out.stdout_buf, 0);
    if !swprobe_has(op, out.stdout_len, STR_PTR("AST outline"), STR_LEN("AST outline")) { println("SW_FAIL 302"); fails = fails + 1; };
    if !swprobe_has(op, out.stdout_len, STR_PTR("[BLOCKED: analyzeFileCoupling"), STR_LEN("[BLOCKED: analyzeFileCoupling")) { println("SW_FAIL 303"); fails = fails + 1; };
    if fails == 0 {
        println("SW_PROBE_OK");
        return 0;
    };
    return 1;
}
