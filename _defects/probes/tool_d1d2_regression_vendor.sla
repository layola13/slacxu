@import "../../packages/cxu/src/vendor/saVmTool.sla";
@import "sa_std/string.sa";
@import "sa_std/io.sai";

fn out_lit(p: ptr, n: u64) -> void {
    let rc: i32 = sa_io_write_all(sa_io_stdout(), p, n);
}

// Regression probe (vendor copy): saVmTool D1 + D2 core cases.
// See _defects/FIX_TOOL_D1D2.md and tool_d1d2_regression.sla (apps copy,
// full masks). The two copies must not fork: same fixes, same verdicts.
// Run (from the bulk tree root):
//   sa build-exe _defects/probes/tool_d1d2_regression_vendor.sla && ./_defects/probes/tool_d1d2_regression_vendor
// Expected: prints D1D2_VENDOR_OK, exit 0. On the pre-fix tree: PANIC 1201 (D1) or PANIC 504 (D2).
fn main() -> i32 {
    let s: StrBuf = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_assign(&s, STR_PTR("my_bash"), STR_LEN("my_bash"));
    if !isSaVmBlockedToolName(&s) { panic(1201); };
    sb_assign(&s, STR_PTR("bash_tool"), STR_LEN("bash_tool"));
    if !isSaVmBlockedToolName(&s) { panic(1202); };
    sb_assign(&s, STR_PTR("apply_patch"), STR_LEN("apply_patch"));
    if !isSaVmBlockedToolName(&s) { panic(1008); };
    sb_assign(&s, STR_PTR("write_file"), STR_LEN("write_file"));
    if !isSaVmBlockedToolName(&s) { panic(1009); };
    sb_assign(&s, STR_PTR("edit_file"), STR_LEN("edit_file"));
    if !isSaVmBlockedToolName(&s) { panic(1011); };
    sb_assign(&s, STR_PTR("xapply_patch"), STR_LEN("xapply_patch"));
    if isSaVmBlockedToolName(&s) { panic(1108); };
    sb_assign(&s, STR_PTR("read_file"), STR_LEN("read_file"));
    if isSaVmBlockedToolName(&s) { panic(1101); };
    let h: StrBuf = StrBuf { bytes: [0u8; 65536], len: 0 };
    let br: StrBuf = StrBuf { bytes: [0u8; 65536], len: 0 };
    let up: StrBuf = StrBuf { bytes: [0u8; 65536], len: 0 };
    let has_up: bool = false;
    let ah: u64 = 0;
    let be: u64 = 0;
    sb_assign(&h, STR_PTR("main...origin/main [ahead 2, behind 1]"), STR_LEN("main...origin/main [ahead 2, behind 1]"));
    parseGitBranchHeader(&h, &br, &up, &has_up, &ah, &be);
    if !sb_eq(&br, STR_PTR("main"), STR_LEN("main")) { panic(501); };
    if !sb_eq(&up, STR_PTR("origin/main"), STR_LEN("origin/main")) { panic(502); };
    if !has_up { panic(503); };
    if ah != 2 { panic(504); };
    if be != 1 { panic(505); };
    sb_assign(&h, STR_PTR("main...origin/main [ahead 3]"), STR_LEN("main...origin/main [ahead 3]"));
    parseGitBranchHeader(&h, &br, &up, &has_up, &ah, &be);
    if ah != 3 || be != 0 { panic(506); };
    sb_assign(&h, STR_PTR("main...origin/main [behind 4]"), STR_LEN("main...origin/main [behind 4]"));
    parseGitBranchHeader(&h, &br, &up, &has_up, &ah, &be);
    if ah != 0 || be != 4 { panic(507); };
    out_lit(STR_PTR("D1D2_VENDOR_OK\n"), STR_LEN("D1D2_VENDOR_OK\n"));
    return 0;
}
