// fma_probe — freeModelAccess retranslation probe (Agent AD3 rebuild).
// Mode via env FMA_PROBE_MODE: hash | nosvc | svc | down.
// Machine-hash expectations arrive via env EXPECTED_HASH (computed by the
// runner with python hashlib from the same inputs the TS code hashes).
// Prints FMA_PROBE_OK on success; FMA_PROBE_FAIL <code> + nonzero exit else.

@import "../../apps/server/src/freeModelAccess.sla"

fn p_fail(code: i32) -> i32 {
    println("FMA_PROBE_FAIL {}", code);
    return code;
}

fn p_mode_is(mode: &FmaStr, lit_p: ptr, lit_n: u64) -> bool {
    return fm_eq(fm_str_ptr(mode), mode.len, lit_p, lit_n);
}

fn p_hash_of(mgr: &FreeModelAccessManager) -> bool {
    let exp: FmaStr = FmaStr { bytes: [0u8; 2048], len: 0 };
    if !fm_env_read(STR_PTR("EXPECTED_HASH"), STR_LEN("EXPECTED_HASH"), &exp) { return false; };
    return fm_eq(fm_mgr_field(mgr, 4), mgr.machine_hash_len, fm_str_ptr(&exp), exp.len);
}

fn main() -> i32 {
    let mode: FmaStr = FmaStr { bytes: [0u8; 2048], len: 0 };
    if !fm_env_read(STR_PTR("FMA_PROBE_MODE"), STR_LEN("FMA_PROBE_MODE"), &mode) {
        return p_fail(1);
    };

    if p_mode_is(&mode, STR_PTR("hash"), STR_LEN("hash")) {
        // (a) env-guid machine hash vs python hashlib expectation
        let mgr = freeModelAccessManager_alloc();
        if freeModelAccessManager_new(&mgr, 0, false, PTR_NULL(), 0) != 0 { return p_fail(2); };
        if freeModelAccessManager_machineHash(&mgr) != 0 { return p_fail(3); };
        if !p_hash_of(&mgr) { return p_fail(4); };
        println("hash_env_guid_ok=1");
        // (b) bad override -> -2
        let mgr2 = freeModelAccessManager_alloc();
        if freeModelAccessManager_new(&mgr2, 0, true, STR_PTR("xyz"), STR_LEN("xyz")) != -2 { return p_fail(5); };
        println("bad_override_neg2=1");
        // (c) dev-machine override -> developmentStatus
        let mgr3 = freeModelAccessManager_alloc();
        let dev = "260da01345ac81b7afd81db88267fd8f65363357c5499c433517c83a77f6a146";
        if freeModelAccessManager_new(&mgr3, 0, true, STR_PTR("260DA01345AC81B7AFD81DB88267FD8F65363357C5499C433517C83A77F6A146"), STR_LEN("260DA01345AC81B7AFD81DB88267FD8F65363357C5499C433517C83A77F6A146")) != 0 { return p_fail(6); };
        if freeModelAccessManager_status(&mgr3) != 0 { return p_fail(7); };
        if !mgr3.out_status.development_machine { return p_fail(8); };
        if !mgr3.out_status.license_valid { return p_fail(9); };
        if !fm_eq(fm_status_field(&mgr3.out_status, 0), mgr3.out_status.machine_code_len, STR_PTR("260DA01345AC"), STR_LEN("260DA01345AC")) { return p_fail(10); };
        if mgr3.out_status.storage != 3 { return p_fail(11); };
        println("dev_status_ok=1 hash={}", dev);
        println("FMA_PROBE_OK");
        return 0;
    };

    if p_mode_is(&mode, STR_PTR("nosvc"), STR_LEN("nosvc")) {
        let mgr = freeModelAccessManager_alloc();
        if freeModelAccessManager_new(&mgr, 0, false, PTR_NULL(), 0) != 0 { return p_fail(20); };
        if freeModelAccessManager_status(&mgr) != 0 { return p_fail(21); };
        if mgr.out_status.configured { return p_fail(22); };
        if mgr.out_status.license_reason != 1 { return p_fail(23); };
        if !mgr.out_status.refresh_required { return p_fail(24); };
        if !mgr.out_status.has_service_error { return p_fail(25); };
        if !fm_eq(fm_status_field(&mgr.out_status, 5), mgr.out_status.service_error_len, STR_PTR("CODEX_ULTRA_FREE_KEY_SERVICE_URL is not configured"), STR_LEN("CODEX_ULTRA_FREE_KEY_SERVICE_URL is not configured")) { return p_fail(26); };
        // saveKey: bad format -> -3; good format but unconfigured -> -4
        if freeModelAccessManager_saveKey(&mgr, STR_PTR("nope"), STR_LEN("nope")) != -3 { return p_fail(27); };
        let good = "cxu-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA";
        if freeModelAccessManager_saveKey(&mgr, STR_PTR("cxu-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"), STR_LEN("cxu-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA")) != -4 { return p_fail(28); };
        println("nosvc_ok=1 goodkey={}", good);
        println("FMA_PROBE_OK");
        return 0;
    };

    if p_mode_is(&mode, STR_PTR("svc"), STR_LEN("svc")) {
        let mgr = freeModelAccessManager_alloc();
        if freeModelAccessManager_new(&mgr, 0, false, PTR_NULL(), 0) != 0 { return p_fail(40); };
        if !mgr.has_service_url { return p_fail(41); };
        if freeModelAccessManager_status(&mgr) != 0 { return p_fail(42); };
        if !mgr.out_status.configured { return p_fail(43); };
        if !mgr.out_status.license_valid { return p_fail(44); };
        if mgr.out_status.license_reason != 0 { return p_fail(45); };
        if mgr.out_status.has_last_refreshed_at { return p_fail(46); };
        if !mgr.out_status.has_next_required_refresh_at { return p_fail(47); };
        if mgr.out_status.next_required_refresh_at != 123.0 { return p_fail(48); };
        if !fm_eq(fm_status_field(&mgr.out_status, 2), mgr.out_status.discord_invite_url_len, STR_PTR("https://discord.gg/test"), STR_LEN("https://discord.gg/test")) { return p_fail(49); };
        // status cache: second call must not change the value (stub is stateless)
        if freeModelAccessManager_status(&mgr) != 0 { return p_fail(50); };
        if !mgr.out_status.license_valid { return p_fail(51); };
        // saveKey good -> 0 (storage keyring 0 or memory 1 depending on host)
        if freeModelAccessManager_saveKey(&mgr, STR_PTR("cxu-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"), STR_LEN("cxu-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA")) != 0 { return p_fail(52); };
        println("savekey_storage={}", mgr.out_status.storage);
        if mgr.out_status.storage > 1 { return p_fail(53); };
        // saveKey with expired license -> -5 + TS licenseError message
        if freeModelAccessManager_saveKey(&mgr, STR_PTR("cxu-BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB"), STR_LEN("cxu-BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB")) != -5 { return p_fail(54); };
        if !fm_eq(fm_mgr_field(&mgr, 5), mgr.err_len, STR_PTR("该密钥已经过期，请重新获取"), STR_LEN("该密钥已经过期，请重新获取")) { return p_fail(55); };
        // createRequirement -> requirement fields
        if freeModelAccessManager_createRequirement(&mgr) != 0 { return p_fail(56); };
        if !mgr.out_status.has_requirement { return p_fail(57); };
        if !fm_eq(fm_status_field(&mgr.out_status, 4), mgr.out_status.requirement_code_len, STR_PTR("REQ-42"), STR_LEN("REQ-42")) { return p_fail(58); };
        if mgr.out_status.requirement_expires_at != 999.0 { return p_fail(59); };
        // prepareRefresh -> allowed + authorizationId
        if freeModelAccessManager_prepareRefresh(&mgr) != 0 { return p_fail(60); };
        if !mgr.out_auth.allowed { return p_fail(61); };
        if !mgr.out_auth.has_authorization_id { return p_fail(62); };
        if mgr.out_auth.authorization_expires_at != 555.0 { return p_fail(63); };
        // completeRefresh -> 0
        if freeModelAccessManager_completeRefresh(&mgr, true, STR_PTR("auth-1"), STR_LEN("auth-1"), true, 3.0) != 0 { return p_fail(64); };
        // completeRefresh with development-machine id is a no-op -> 0
        if freeModelAccessManager_completeRefresh(&mgr, true, STR_PTR("development-machine"), STR_LEN("development-machine"), true, 0.0) != 0 { return p_fail(65); };
        println("svc_ok=1");
        println("FMA_PROBE_OK");
        return 0;
    };

    if p_mode_is(&mode, STR_PTR("down"), STR_LEN("down")) {
        let mgr = freeModelAccessManager_alloc();
        if freeModelAccessManager_new(&mgr, 0, false, PTR_NULL(), 0) != 0 { return p_fail(80); };
        // status(): TS catch path -> value with configured=true + serviceError
        if freeModelAccessManager_status(&mgr) != 0 { return p_fail(81); };
        if !mgr.out_status.configured { return p_fail(82); };
        if !mgr.out_status.has_service_error { return p_fail(83); };
        // createRequirement(): no catch in TS -> -1
        if freeModelAccessManager_createRequirement(&mgr) != -1 { return p_fail(84); };
        // prepareRefresh(): catch -> allowed=false value
        if freeModelAccessManager_prepareRefresh(&mgr) != 0 { return p_fail(85); };
        if mgr.out_auth.allowed { return p_fail(86); };
        if !mgr.out_auth.status.configured { return p_fail(87); };
        println("down_ok=1");
        println("FMA_PROBE_OK");
        return 0;
    };

    return p_fail(99);
}
