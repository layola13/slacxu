@import "../../apps/server/src/saVmTool.sla";
@import "sa_std/string.sa";
@import "sa_std/io.sai";

// Regression probe: saVmTool D3 -- execGitSync runtime (see
// _defects/FIX_TOOL_D1D2.md). Pre-fix this segfaulted on the first
// execGitSync call (argv slot writes routed through the git_argv_set
// helper; compiler-shape defect, minimal repro in d3_argv_set_via_ref.sla).
// Run (from the bulk tree root):
//   git init /tmp/vrepo && git -C /tmp/vrepo commit --allow-empty -m x  # any git repo works
//   sa build-exe _defects/probes/tool_d3_execgit_regression.sla && ./_defects/probes/tool_d3_execgit_regression
// Expected: M0/M1/M2 lines then G17CORE_OK, exit 0. Pre-fix: M0 only,
// SIGSEGV (exit 139). G17b (nativeGitStatus) is excluded: its build-exe
// closure separately traps in the compiler (C1 FallthroughForbidden in
// pol_item_copy_from), unrelated to D3.
fn out_lit(p: ptr, n: u64) -> void {
    let rc: i32 = sa_io_write_all(sa_io_stdout(), p, n);
}

// G17 core (V): execGitSync on /tmp/vrepo — git --version, then
// git rev-parse --is-inside-work-tree. G17b (nativeGitStatus) is not in
// this probe: its build-exe closure currently traps in the compiler
// (C1, pol_item_copy_from FallthroughForbidden), unrelated to D3.
fn main() -> i32 {
    out_lit(STR_PTR("M0 driver\n"), STR_LEN("M0 driver\n"));
    let repo: StrBuf = StrBuf { bytes: [0u8; 65536], len: 0 };
    sb_assign(&repo, STR_PTR("/tmp/vrepo"), STR_LEN("/tmp/vrepo"));
    let argv = ByteList { items: [0u8; 4096], len: 0 };
    bl_push(&argv, STR_PTR("--version"), STR_LEN("--version"));
    let r = GitSpawnResult { status: 0, has_status: false, stdout: GitBigBuf { bytes: [0u8; 524288], len: 0 }, stderr: StrBuf { bytes: [0u8; 65536], len: 0 }, unavailable: false, timedOut: false };
    execGitSync(&repo, &argv, 15000.0, &r);
    out_lit(STR_PTR("M1 first-returned\n"), STR_LEN("M1 first-returned\n"));
    if r.unavailable || r.timedOut { panic(1701); };
    if !r.has_status || r.status != 0 { panic(1702); };
    if r.stdout.len < 11 || r.stdout.bytes[0] != 103 || r.stdout.bytes[1] != 105 || r.stdout.bytes[2] != 116 || r.stdout.bytes[3] != 32 || r.stdout.bytes[4] != 118 { panic(1703); };
    let argv2 = ByteList { items: [0u8; 4096], len: 0 };
    bl_push(&argv2, STR_PTR("rev-parse"), STR_LEN("rev-parse"));
    bl_push(&argv2, STR_PTR("--is-inside-work-tree"), STR_LEN("--is-inside-work-tree"));
    let r2 = GitSpawnResult { status: 0, has_status: false, stdout: GitBigBuf { bytes: [0u8; 524288], len: 0 }, stderr: StrBuf { bytes: [0u8; 65536], len: 0 }, unavailable: false, timedOut: false };
    execGitSync(&repo, &argv2, 15000.0, &r2);
    out_lit(STR_PTR("M2 second-returned\n"), STR_LEN("M2 second-returned\n"));
    if !r2.has_status || r2.status != 0 { panic(1704); };
    if r2.stdout.len < 4 || r2.stdout.bytes[0] != 116 || r2.stdout.bytes[1] != 114 || r2.stdout.bytes[2] != 117 || r2.stdout.bytes[3] != 101 { panic(1705); };
    out_lit(STR_PTR("G17CORE_OK\n"), STR_LEN("G17CORE_OK\n"));
    return 0;
}
