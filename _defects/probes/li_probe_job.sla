// li_probe_job.sla — jobs-family runtime probe for launchInstall.sla.
// The full build-exe of launchInstall.sla traps in the SAB flattener
// (see FIX_SERVER_LAUNCH.md), so this probe links li_lib_job.sla — a
// copy of the CURRENT launchInstall.sla with the install/detect/http
// middle stubbed and installLaunchAdapters replaced by a fake that
// returns one failed result. Everything in the jobs path itself is
// REAL: li_opts_json/li_opts_from_json round-trip, the R11 lock cells,
// li_uuid, the jobsdoc/stash record format, li_job_drive settle, and
// getInstallJob reification. createInstallJob itself is stubbed in the
// lib (its thread::spawn closure emission traps the SAB flattener);
// the probe replicates its record+stash writes verbatim and calls
// li_job_drive synchronously.
@import "sa_std/io/print.sai"
@import "li_lib_job.sla"

fn fail(code: i32) -> i32 {
    println("LI_JOB_ASSERT_FAIL");
    return code;
}

fn main() -> i32 {
    let arena = LiText { bytes: [0u8; 262144], len: 0 };
    // ---- opts JSON round-trip ----
    let opts = InstallLaunchRequest { ids_ptr: STR_PTR("[\"bogus\"]"), ids_len: 9, idsCount: 1, hasIds: true, missingOnly: true, hasMissingOnly: true, skipCli: true, hasSkipCli: true, envMode: 2, hasEnvMode: true, sharedEnv: LaunchEnvValues { hasBaseUrl: true, baseUrl_ptr: STR_PTR("https://rt.example"), baseUrl_len: 18, hasModel: false, model_ptr: STR_PTR(""), model_len: 0, hasApiKey: true, apiKey_ptr: STR_PTR("sk-rt"), apiKey_len: 5 }, hasSharedEnv: true, separateEnv_ptr: STR_PTR("{}"), separateEnv_len: 2, hasSeparateEnv: true, forceEnv: true, hasForceEnv: true, sourceRoot_ptr: STR_PTR("/tmp/rt"), sourceRoot_len: 7, hasSourceRoot: true, skipModelTest: true, hasSkipModelTest: true };
    let text = LiText { bytes: [0u8; 262144], len: 0 };
    li_opts_json(&opts, &text);
    let back = InstallLaunchRequest { ids_ptr: STR_PTR(""), ids_len: 0, idsCount: 0, hasIds: false, missingOnly: false, hasMissingOnly: false, skipCli: false, hasSkipCli: false, envMode: 0, hasEnvMode: false, sharedEnv: LaunchEnvValues { hasBaseUrl: false, baseUrl_ptr: STR_PTR(""), baseUrl_len: 0, hasModel: false, model_ptr: STR_PTR(""), model_len: 0, hasApiKey: false, apiKey_ptr: STR_PTR(""), apiKey_len: 0 }, hasSharedEnv: false, separateEnv_ptr: STR_PTR(""), separateEnv_len: 0, hasSeparateEnv: false, forceEnv: false, hasForceEnv: false, sourceRoot_ptr: STR_PTR(""), sourceRoot_len: 0, hasSourceRoot: false, skipModelTest: false, hasSkipModelTest: false };
    li_opts_from_json(li_text_ptr(&text), text.len, &arena, &back);
    if !back.hasIds { return fail(201); };
    if back.idsCount != 1 { return fail(202); };
    if !back.hasEnvMode { return fail(203); };
    if back.envMode != 2 { return fail(204); };
    if !back.hasSourceRoot { return fail(205); };
    if !li_eq(back.sourceRoot_ptr, back.sourceRoot_len, STR_PTR("/tmp/rt"), STR_LEN("/tmp/rt")) { return fail(206); };
    if !back.hasSharedEnv { return fail(207); };
    if !li_eq(back.sharedEnv.apiKey_ptr, back.sharedEnv.apiKey_len, STR_PTR("sk-rt"), STR_LEN("sk-rt")) { return fail(208); };
    if !back.skipModelTest { return fail(209); };
    if !back.forceEnv { return fail(210); };

    // ---- job lifecycle (createInstallJob's spawn site is stubbed in
    // li_lib_job: its thread::spawn closure emission traps the SAB
    // flattener — compiler defect, see FIX_SERVER_LAUNCH.md. The steps
    // below replicate createInstallJob's record+stash writes verbatim,
    // then call the REAL li_job_drive synchronously.) ----
    let state = LaunchInstallState { installLockHeld: false, jobs_ptr: STR_PTR(""), jobs_len: 0, jobsCount: 0 };
    let job_id = LiStr { bytes: [0u8; 8192], len: 0 };
    li_uuid(&job_id);
    if job_id.len != 36 { return fail(220); };
    let opts_text = LiText { bytes: [0u8; 262144], len: 0 };
    li_opts_json(&opts, &opts_text);
    let jdoc = li_jobsdoc();
    let rec = li_parse(STR_PTR("{}"), STR_LEN("{}"));
    if rec == 0 { return fail(221); };
    sa_json_object_set_string(rec, STR_PTR("id"), STR_LEN("id"), li_str_ptr(&job_id), job_id.len);
    sa_json_object_set_string(rec, STR_PTR("status"), STR_LEN("status"), STR_PTR("running"), STR_LEN("running"));
    sa_json_object_set_string(rec, STR_PTR("progressStep"), STR_LEN("progressStep"), STR_PTR("Starting installation job..."), STR_LEN("Starting installation job..."));
    sa_json_object_set_string(rec, STR_PTR("logsText"), STR_LEN("logsText"), STR_PTR("[]"), STR_LEN("[]"));
    sa_json_object_set_i64(rec, STR_PTR("createdAt"), STR_LEN("createdAt"), sa_time_unix_ms());
    sa_json_object_set_node(jdoc, li_str_ptr(&job_id), job_id.len, rec);
    li_free_doc(rec);
    let sdoc2 = li_stashdoc();
    let sentry = li_parse(STR_PTR("{}"), STR_LEN("{}"));
    if sentry == 0 { return fail(221); };
    sa_json_object_set_string(sentry, STR_PTR("job"), STR_LEN("job"), li_str_ptr(&job_id), job_id.len);
    sa_json_object_set_string(sentry, STR_PTR("opts"), STR_LEN("opts"), li_text_ptr(&opts_text), opts_text.len);
    sa_json_object_set_node(sdoc2, STR_PTR("1"), STR_LEN("1"), sentry);
    li_free_doc(sentry);
    // before drive: status is running (0)
    let job = InstallJob { id_ptr: STR_PTR(""), id_len: 0, status: 0, progressStep_ptr: STR_PTR(""), progressStep_len: 0, logs_ptr: STR_PTR(""), logs_len: 0, logsCount: 0, hasResults: false, results_ptr: STR_PTR(""), results_len: 0, resultsCount: 0, hasAdapters: false, adapters_ptr: STR_PTR(""), adapters_len: 0, adaptersCount: 0, hasError: false, error_ptr: STR_PTR(""), error_len: 0, createdAt: 0 };
    if !getInstallJob(&state, li_str_ptr(&job_id), job_id.len, &arena, &job) { return fail(229); };
    if job.status != 0 { return fail(230); };
    // drive synchronously (the R9 thread body)
    let drc = li_job_drive(1);
    if drc != 0 { return fail(231); };
    if !getInstallJob(&state, li_str_ptr(&job_id), job_id.len, &arena, &job) { return fail(222); };
    if job.status != 1 { return fail(223); };
    if !job.hasResults { return fail(224); };
    if job.resultsCount != 1 { return fail(225); };
    if !li_contains(job.results_ptr, job.results_len, STR_PTR("bogus"), STR_LEN("bogus")) { return fail(226); };
    if !li_contains(job.progressStep_ptr, job.progressStep_len, STR_PTR("Completed 0/1"), STR_LEN("Completed 0/1")) { return fail(227); };
    if !job.hasAdapters { return fail(228); };
    if job.createdAt == 0 { return fail(232); };
    if getInstallJob(&state, STR_PTR("no-such-job"), STR_LEN("no-such-job"), &arena, &job) { return fail(233); };
    if installLockHeldNow() { return fail(234); };

    println("LI_JOB_PROBE_OK");
    return 0;
}
