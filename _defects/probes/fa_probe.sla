// fa_probe.sla — runtime probe for apps/server/src/forwardApi.sla.
// Covers the pure surfaces (loopback set, sharing gate, credential check,
// relay provider builder, prompt transforms, response assembly, usage
// restore, slot accounting) and the three handlers' gate ladder
// (405/403/401/400/429-path/500-via-seam/502-null-bridge) plus the
// sequential-SSE envelope via the skeleton turn provider (neutral result).
// Assertions encode the TS contract; numeric codes map to sites below.
@import "sa_std/io/print.sai"
@import "sa_std/ptr.sa"
@import "sa_std/string.sa"
@import "../../apps/server/src/forwardApi.sla"


fn probe_has(p: ptr, n: u64, q: ptr, qn: u64) -> bool {
    if qn == 0 { return true; };
    if n < qn { return false; };
    let i: u64 = 0;
    while i + qn <= n {
        let sub: ptr = PTR_NULL();
        PTR_BYTE_ADD(sub, p, i);
        if fa_eq(sub, qn, q, qn) { return true; };
        i = i + 1;
    }
    return false;
}

fn pfail(code: i64) -> void {
    println("FA_FAIL {}", code);
}

fn set_req_method(req: &Request, p: ptr, l: u64) -> void {
    let i: u64 = 0;
    while i < l { req.method[i] = fa_byte(p, i); i = i + 1; }
    req.method_len = l;
}

fn set_req_body(req: &Request, p: ptr, l: u64) -> void {
    let i: u64 = 0;
    while i < l { req.body_json[i] = fa_byte(p, i); i = i + 1; }
    req.body_len = l;
}

fn add_req_header(req: &Request, p: ptr, l: u64) -> void {
    let i: u64 = 0;
    while i < l { req.headers.buf[req.headers.len] = fa_byte(p, i); req.headers.len = req.headers.len + 1; i = i + 1; }
}

fn set_url(url: &Url, p: ptr, l: u64) -> void {
    let i: u64 = 0;
    while i < l { url.buf[i] = fa_byte(p, i); i = i + 1; }
    url.len = l;
}

fn body_has(resp: &Response, p: ptr, l: u64) -> bool {
    return probe_has(fa_resp_body_ptr(resp), resp.body_len, p, l);
}

fn main() -> i32 {
    let fails: i64 = 0;

    // ---- A. loopback set -------------------------------------------------
    if !isForwardLoopbackAddress(STR_PTR(""), STR_LEN(""), false) { pfail(101); fails = fails + 1; };
    if !isForwardLoopbackAddress(STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"), true) { pfail(102); fails = fails + 1; };
    if !isForwardLoopbackAddress(STR_PTR("::1"), STR_LEN("::1"), true) { pfail(103); fails = fails + 1; };
    if !isForwardLoopbackAddress(STR_PTR("::ffff:127.0.0.1"), STR_LEN("::ffff:127.0.0.1"), true) { pfail(104); fails = fails + 1; };
    if isForwardLoopbackAddress(STR_PTR("10.0.0.9"), STR_LEN("10.0.0.9"), true) { pfail(105); fails = fails + 1; };

    // ---- B. sharing gate (prefs JSON surface) ----------------------------
    if isForwardSharingEnabled(STR_PTR(""), STR_LEN(""), false) { pfail(111); fails = fails + 1; };
    if !isForwardSharingEnabled(STR_PTR("{\"forwardSharingEnabled\":true}"), STR_LEN("{\"forwardSharingEnabled\":true}"), true) { pfail(112); fails = fails + 1; };
    if isForwardSharingEnabled(STR_PTR("{\"forwardSharingEnabled\":false}"), STR_LEN("{\"forwardSharingEnabled\":false}"), true) { pfail(113); fails = fails + 1; };
    if isForwardSharingEnabled(STR_PTR("{}"), STR_LEN("{}"), true) { pfail(114); fails = fails + 1; };

    // ---- C. credential resolution ----------------------------------------
    let req = Request { method: [0u8; 16], method_len: 0, headers: Headers { buf: [0u8; 8192], len: 0 }, body_json: [0u8; 262144], body_len: 0, signal_aborted: false };
    if resolveForwardCredential(&req, STR_PTR("10.0.0.9"), STR_LEN("10.0.0.9"), true, STR_PTR("tok123"), STR_LEN("tok123")) { pfail(121); fails = fails + 1; };
    add_req_header(&req, STR_PTR("Authorization: Bearer tok123\n"), STR_LEN("Authorization: Bearer tok123\n"));
    if !resolveForwardCredential(&req, STR_PTR("10.0.0.9"), STR_LEN("10.0.0.9"), true, STR_PTR("tok123"), STR_LEN("tok123")) { pfail(122); fails = fails + 1; };
    let req2 = Request { method: [0u8; 16], method_len: 0, headers: Headers { buf: [0u8; 8192], len: 0 }, body_json: [0u8; 262144], body_len: 0, signal_aborted: false };
    add_req_header(&req2, STR_PTR("Authorization: Bearer nope\n"), STR_LEN("Authorization: Bearer nope\n"));
    if resolveForwardCredential(&req2, STR_PTR("10.0.0.9"), STR_LEN("10.0.0.9"), true, STR_PTR("tok123"), STR_LEN("tok123")) { pfail(123); fails = fails + 1; };
    let req3 = Request { method: [0u8; 16], method_len: 0, headers: Headers { buf: [0u8; 8192], len: 0 }, body_json: [0u8; 262144], body_len: 0, signal_aborted: false };
    add_req_header(&req3, STR_PTR("x-api-key: tok123\n"), STR_LEN("x-api-key: tok123\n"));
    if !resolveForwardCredential(&req3, STR_PTR("10.0.0.9"), STR_LEN("10.0.0.9"), true, STR_PTR("tok123"), STR_LEN("tok123")) { pfail(124); fails = fails + 1; };
    if !resolveForwardCredential(&req2, STR_PTR("127.0.0.1"), STR_LEN("127.0.0.1"), true, STR_PTR("tok123"), STR_LEN("tok123")) { pfail(125); fails = fails + 1; };
    if resolveForwardCredential(&req, STR_PTR("10.0.0.9"), STR_LEN("10.0.0.9"), true, STR_PTR(""), STR_LEN("")) { pfail(126); fails = fails + 1; };

    // ---- D. relay provider builder ---------------------------------------
    let prov = ForwardRelayProvider {
        id: [0u8; 128], id_len: 0, name: [0u8; 256], name_len: 0, kind_openai: false,
        serviceProvider_id: [0u8; 128], serviceProvider_id_len: 0, serviceProvider_name: [0u8; 256], serviceProvider_name_len: 0,
        baseUrl: [0u8; 2048], baseUrl_len: 0, defaultModel: [0u8; 512], defaultModel_len: 0,
        nativeModels_json: [0u8; 16384], nativeModels_json_len: 0, modelAliases_json: [0u8; 1024], modelAliases_json_len: 0,
        stationType_official: false, channelMode_fast: false, remark: [0u8; 1024], remark_len: 0,
        groups: [ForwardRelayGroup { id: [0u8; 128], id_len: 0, name: [0u8; 128], name_len: 0, baseUrl: [0u8; 2048], baseUrl_len: 0, kind_text: false, status_enabled: false, groupRatio: 0.0, models_json: [0u8; 16384], models_json_len: 0, keys_json: [0u8; 4096], keys_json_len: 0 }; 1],
        groups_len: 0, createdAt: 0, updatedAt: 0
    };
    let prc = buildForwardRelayProvider(STR_PTR("https://relay.example"), STR_LEN("https://relay.example"), STR_PTR("K"), STR_LEN("K"), STR_PTR("[\"m1\",\"m2\",\"m1\"]"), STR_LEN("[\"m1\",\"m2\",\"m1\"]"), 42, true, &prov);
    if prc != 0 { pfail(131); fails = fails + 1; };
    let dmp: ptr = PTR_NULL();
    PTR_BYTE_ADD(dmp, &prov.defaultModel, 0);
    if !fa_eq(dmp, prov.defaultModel_len, STR_PTR("m1"), STR_LEN("m1")) { pfail(132); fails = fails + 1; };
    let nmp: ptr = PTR_NULL();
    PTR_BYTE_ADD(nmp, &prov.nativeModels_json, 0);
    if !probe_has(nmp, prov.nativeModels_json_len, STR_PTR("\"m2\""), STR_LEN("\"m2\"")) { pfail(133); fails = fails + 1; };
    if prov.createdAt != 42 { pfail(134); fails = fails + 1; };

    // ---- E. chat messages -> prompt --------------------------------------
    let pout = FaText { bytes: [0u8; 262144], len: 0 };
    chatMessagesToPrompt(STR_PTR("[{\"role\":\"system\",\"content\":\"sys\"},{\"role\":\"user\",\"content\":\"hello\"},{\"role\":\"tool\",\"content\":\"world\"},{\"role\":\"assistant\",\"content\":\"prior\"},{\"role\":\"developer\",\"content\":\"dev\"}]"), STR_LEN("[{\"role\":\"system\",\"content\":\"sys\"},{\"role\":\"user\",\"content\":\"hello\"},{\"role\":\"tool\",\"content\":\"world\"},{\"role\":\"assistant\",\"content\":\"prior\"},{\"role\":\"developer\",\"content\":\"dev\"}]"), &pout);
    if !fa_eq(fa_text_ptr(&pout), pout.len, STR_PTR("hello"), STR_LEN("hello")) { pfail(141); fails = fails + 1; };

    // ---- F. responses input -> prompt ------------------------------------
    let rout = FaText { bytes: [0u8; 262144], len: 0 };
    responsesInputToPrompt(STR_PTR("\" hi there \""), STR_LEN("\" hi there \""), STR_PTR("\"sys\""), STR_LEN("\"sys\""), &rout);
    if !fa_eq(fa_text_ptr(&rout), rout.len, STR_PTR("hi there"), STR_LEN("hi there")) { pfail(151); fails = fails + 1; };
    let rout2 = FaText { bytes: [0u8; 262144], len: 0 };
    responsesInputToPrompt(STR_PTR("[{\"type\":\"message\",\"role\":\"user\",\"content\":\"q1\"},{\"type\":\"function_call_output\",\"output\":\"o1\"},\"s1\"]"), STR_LEN("[{\"type\":\"message\",\"role\":\"user\",\"content\":\"q1\"},{\"type\":\"function_call_output\",\"output\":\"o1\"},\"s1\"]"), STR_PTR(""), STR_LEN(""), &rout2);
    if !fa_eq(fa_text_ptr(&rout2), rout2.len, STR_PTR("q1\n\ns1"), STR_LEN("q1\n\ns1")) { pfail(152); fails = fails + 1; };

    // ---- G. token estimate ------------------------------------------------
    if estimateForwardTokens(STR_PTR(""), STR_LEN("")) != 0 { pfail(161); fails = fails + 1; };
    if estimateForwardTokens(STR_PTR("abcd"), STR_LEN("abcd")) != 1 { pfail(162); fails = fails + 1; };
    if estimateForwardTokens(STR_PTR("abcde"), STR_LEN("abcde")) != 2 { pfail(163); fails = fails + 1; };

    // ---- H. response object assembly --------------------------------------
    let restore0 = ForwardResponseRestore { instructions_json: [0u8; 65536], instructions_json_len: 0, has_instructions: false, tools_json: [0u8; 65536], tools_json_len: 0, tool_choice_json: [0u8; 4096], tool_choice_json_len: 0, parallel_tool_calls: false, has_parallel: false };
    let oout = FaText { bytes: [0u8; 262144], len: 0 };
    forwardResponseObject(STR_PTR("local-relay-b1"), STR_LEN("local-relay-b1"), STR_PTR("done"), STR_LEN("done"), true, STR_PTR(""), STR_LEN(""), false, &restore0, false, STR_PTR(""), STR_LEN(""), false, &oout);
    if !probe_has(fa_text_ptr(&oout), oout.len, STR_PTR("\"status\":\"completed\""), STR_LEN("\"status\":\"completed\"")) { pfail(171); fails = fails + 1; };
    if !probe_has(fa_text_ptr(&oout), oout.len, STR_PTR("\"id\":\"resp-fwd-"), STR_LEN("\"id\":\"resp-fwd-")) { pfail(172); fails = fails + 1; };
    if !probe_has(fa_text_ptr(&oout), oout.len, STR_PTR("\"text\":\"done\""), STR_LEN("\"text\":\"done\"")) { pfail(173); fails = fails + 1; };
    let oout2 = FaText { bytes: [0u8; 262144], len: 0 };
    forwardResponseObject(STR_PTR("local-relay-b1"), STR_LEN("local-relay-b1"), STR_PTR("boom"), STR_LEN("boom"), false, STR_PTR(""), STR_LEN(""), false, &restore0, false, STR_PTR(""), STR_LEN(""), false, &oout2);
    if !probe_has(fa_text_ptr(&oout2), oout2.len, STR_PTR("\"status\":\"failed\""), STR_LEN("\"status\":\"failed\"")) { pfail(174); fails = fails + 1; };

    // ---- I. chat completion assembly + usage restore ----------------------
    let cout = FaText { bytes: [0u8; 262144], len: 0 };
    buildChatCompletionResponse(STR_PTR("local-relay-b1"), STR_LEN("local-relay-b1"), STR_PTR("hey"), STR_LEN("hey"), STR_PTR("[{\"role\":\"user\",\"content\":\"hello\"}]"), STR_LEN("[{\"role\":\"user\",\"content\":\"hello\"}]"), &cout);
    if !probe_has(fa_text_ptr(&cout), cout.len, STR_PTR("\"prompt_tokens\":9"), STR_LEN("\"prompt_tokens\":9")) { pfail(181); fails = fails + 1; };
    if !probe_has(fa_text_ptr(&cout), cout.len, STR_PTR("\"content\":\"hey\""), STR_LEN("\"content\":\"hey\"")) { pfail(182); fails = fails + 1; };
    if !probe_has(fa_text_ptr(&cout), cout.len, STR_PTR("\"object\":\"chat.completion\""), STR_LEN("\"object\":\"chat.completion\"")) { pfail(183); fails = fails + 1; };

    // ---- J. slot accounting (state-param form) ----------------------------
    let slots = ForwardSlotState { forwardInFlight: 0 };
    if !acquireForwardSlot(&slots, 2) { pfail(191); fails = fails + 1; };
    if !acquireForwardSlot(&slots, 2) { pfail(192); fails = fails + 1; };
    if acquireForwardSlot(&slots, 2) { pfail(193); fails = fails + 1; };
    releaseForwardSlot(&slots);
    if !acquireForwardSlot(&slots, 2) { pfail(194); fails = fails + 1; };
    if forwardSlotStatus(&slots) != 2 { pfail(195); fails = fails + 1; };

    // ---- shared handler fixtures ------------------------------------------
    fa_install_inventory_json(STR_PTR("{\"bridges\":[{\"id\":\"b1\",\"label\":\"Fake CLI\"}]}"), STR_LEN("{\"bridges\":[{\"id\":\"b1\",\"label\":\"Fake CLI\"}]}"));
    fa_install_bridge(0, 0, STR_PTR(""), STR_LEN(""));
    let security = Headers { buf: [0u8; 8192], len: 0 };
    let mdeps = ForwardModelsDeps { remoteAddress_ptr: STR_PTR("127.0.0.1"), remoteAddress_len: STR_LEN("127.0.0.1"), has_remote: true, forwardToken: [0u8; 1024], forwardToken_len: 0, sharingEnabled: true, listInventory_fn: 1 };
    let mreq = Request { method: [0u8; 16], method_len: 0, headers: Headers { buf: [0u8; 8192], len: 0 }, body_json: [0u8; 262144], body_len: 0, signal_aborted: false };
    set_req_method(&mreq, STR_PTR("GET"), STR_LEN("GET"));
    let murl = Url { buf: [0u8; 4096], len: 0 };
    set_url(&murl, STR_PTR("/v1/models"), STR_LEN("/v1/models"));
    let mresp = Response { status: 0, headers: Headers { buf: [0u8; 8192], len: 0 }, body_json: [0u8; 262144], body_len: 0, is_stream: false };
    handleForwardModelsRequest(&mreq, &murl, &security, &mdeps, &mresp);
    if mresp.status != 200 { pfail(201); fails = fails + 1; };
    if !body_has(&mresp, STR_PTR("\"object\":\"list\""), STR_LEN("\"object\":\"list\"")) { pfail(202); fails = fails + 1; };
    let mreq2 = Request { method: [0u8; 16], method_len: 0, headers: Headers { buf: [0u8; 8192], len: 0 }, body_json: [0u8; 262144], body_len: 0, signal_aborted: false };
    set_req_method(&mreq2, STR_PTR("POST"), STR_LEN("POST"));
    let mresp2 = Response { status: 0, headers: Headers { buf: [0u8; 8192], len: 0 }, body_json: [0u8; 262144], body_len: 0, is_stream: false };
    handleForwardModelsRequest(&mreq2, &murl, &security, &mdeps, &mresp2);
    if mresp2.status != 405 { pfail(203); fails = fails + 1; };
    let mdeps2 = ForwardModelsDeps { remoteAddress_ptr: STR_PTR("10.0.0.9"), remoteAddress_len: STR_LEN("10.0.0.9"), has_remote: true, forwardToken: [0u8; 1024], forwardToken_len: 0, sharingEnabled: false, listInventory_fn: 1 };
    let mresp3 = Response { status: 0, headers: Headers { buf: [0u8; 8192], len: 0 }, body_json: [0u8; 262144], body_len: 0, is_stream: false };
    handleForwardModelsRequest(&mreq, &murl, &security, &mdeps2, &mresp3);
    if mresp3.status != 403 { pfail(204); fails = fails + 1; };
    let mdeps3 = ForwardModelsDeps { remoteAddress_ptr: STR_PTR("10.0.0.9"), remoteAddress_len: STR_LEN("10.0.0.9"), has_remote: true, forwardToken: [0u8; 1024], forwardToken_len: 0, sharingEnabled: true, listInventory_fn: 1 };
    let ti: u64 = 0;
    while ti < STR_LEN("tok123") { mdeps3.forwardToken[ti] = fa_byte(STR_PTR("tok123"), ti); ti = ti + 1; }
    mdeps3.forwardToken_len = STR_LEN("tok123");
    let mresp4 = Response { status: 0, headers: Headers { buf: [0u8; 8192], len: 0 }, body_json: [0u8; 262144], body_len: 0, is_stream: false };
    handleForwardModelsRequest(&mreq, &murl, &security, &mdeps3, &mresp4);
    if mresp4.status != 401 { pfail(205); fails = fails + 1; };
    let mreq3 = Request { method: [0u8; 16], method_len: 0, headers: Headers { buf: [0u8; 8192], len: 0 }, body_json: [0u8; 262144], body_len: 0, signal_aborted: false };
    set_req_method(&mreq3, STR_PTR("GET"), STR_LEN("GET"));
    add_req_header(&mreq3, STR_PTR("Authorization: Bearer tok123\n"), STR_LEN("Authorization: Bearer tok123\n"));
    let mresp5 = Response { status: 0, headers: Headers { buf: [0u8; 8192], len: 0 }, body_json: [0u8; 262144], body_len: 0, is_stream: false };
    handleForwardModelsRequest(&mreq3, &murl, &security, &mdeps3, &mresp5);
    if mresp5.status != 200 { pfail(206); fails = fails + 1; };

    // ---- L. chat handler gates --------------------------------------------
    let cdeps = ForwardChatDeps { remoteAddress_ptr: STR_PTR("127.0.0.1"), remoteAddress_len: STR_LEN("127.0.0.1"), has_remote: true, forwardToken: [0u8; 1024], forwardToken_len: 0, sharingEnabled: true, listInventory_fn: 1, getBridge_fn: 1, cwd: [0u8; 4096], cwd_len: 0, turnTimeoutMs: 0, maxConcurrent: 0, sseKeepaliveMs: 0 };
    let curl = Url { buf: [0u8; 4096], len: 0 };
    set_url(&curl, STR_PTR("/v1/chat/completions"), STR_LEN("/v1/chat/completions"));
    let creq = Request { method: [0u8; 16], method_len: 0, headers: Headers { buf: [0u8; 8192], len: 0 }, body_json: [0u8; 262144], body_len: 0, signal_aborted: false };
    set_req_method(&creq, STR_PTR("POST"), STR_LEN("POST"));
    set_req_body(&creq, STR_PTR("{\"model\":\"local-relay-b1\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}]}"), STR_LEN("{\"model\":\"local-relay-b1\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}]}"));
    let cresp = Response { status: 0, headers: Headers { buf: [0u8; 8192], len: 0 }, body_json: [0u8; 262144], body_len: 0, is_stream: false };
    handleForwardChatRequest(&creq, &curl, &security, &cdeps, &cresp);
    if cresp.status != 502 { pfail(211); fails = fails + 1; };
    let creq2 = Request { method: [0u8; 16], method_len: 0, headers: Headers { buf: [0u8; 8192], len: 0 }, body_json: [0u8; 262144], body_len: 0, signal_aborted: false };
    set_req_method(&creq2, STR_PTR("POST"), STR_LEN("POST"));
    set_req_body(&creq2, STR_PTR("{\"model\":\"local-relay-b1\",\"messages\":[]}"), STR_LEN("{\"model\":\"local-relay-b1\",\"messages\":[]}"));
    let cresp2 = Response { status: 0, headers: Headers { buf: [0u8; 8192], len: 0 }, body_json: [0u8; 262144], body_len: 0, is_stream: false };
    handleForwardChatRequest(&creq2, &curl, &security, &cdeps, &cresp2);
    if cresp2.status != 400 { pfail(212); fails = fails + 1; };

    // ---- M. responses handler gates ---------------------------------------
    let rurl = Url { buf: [0u8; 4096], len: 0 };
    set_url(&rurl, STR_PTR("/v1/responses"), STR_LEN("/v1/responses"));
    let rreq = Request { method: [0u8; 16], method_len: 0, headers: Headers { buf: [0u8; 8192], len: 0 }, body_json: [0u8; 262144], body_len: 0, signal_aborted: false };
    set_req_method(&rreq, STR_PTR("POST"), STR_LEN("POST"));
    set_req_body(&rreq, STR_PTR("{\"model\":\"local-relay-b1\",\"input\":\"hi\",\"previous_response_id\":\"r1\"}"), STR_LEN("{\"model\":\"local-relay-b1\",\"input\":\"hi\",\"previous_response_id\":\"r1\"}"));
    let rresp = Response { status: 0, headers: Headers { buf: [0u8; 8192], len: 0 }, body_json: [0u8; 262144], body_len: 0, is_stream: false };
    handleForwardResponsesRequest(&rreq, &rurl, &security, &cdeps, &rresp);
    if rresp.status != 400 { pfail(221); fails = fails + 1; };
    let rreq2 = Request { method: [0u8; 16], method_len: 0, headers: Headers { buf: [0u8; 8192], len: 0 }, body_json: [0u8; 262144], body_len: 0, signal_aborted: false };
    set_req_method(&rreq2, STR_PTR("POST"), STR_LEN("POST"));
    set_req_body(&rreq2, STR_PTR("{\"model\":\"local-relay-b1\",\"input\":\"hi\"}"), STR_LEN("{\"model\":\"local-relay-b1\",\"input\":\"hi\"}"));
    let rresp2 = Response { status: 0, headers: Headers { buf: [0u8; 8192], len: 0 }, body_json: [0u8; 262144], body_len: 0, is_stream: false };
    handleForwardResponsesRequest(&rreq2, &rurl, &security, &cdeps, &rresp2);
    if rresp2.status != 502 { pfail(222); fails = fails + 1; };

    // ---- N. skeleton-turn end-to-end (bridge installed) --------------------
    fa_install_bridge(1, 7, STR_PTR(""), STR_LEN(""));
    let rresp3 = Response { status: 0, headers: Headers { buf: [0u8; 8192], len: 0 }, body_json: [0u8; 262144], body_len: 0, is_stream: false };
    handleForwardResponsesRequest(&rreq2, &rurl, &security, &cdeps, &rresp3);
    if rresp3.status != 200 { pfail(231); fails = fails + 1; };
    if !body_has(&rresp3, STR_PTR("\"status\":\"completed\""), STR_LEN("\"status\":\"completed\"")) { pfail(232); fails = fails + 1; };
    let rreq3 = Request { method: [0u8; 16], method_len: 0, headers: Headers { buf: [0u8; 8192], len: 0 }, body_json: [0u8; 262144], body_len: 0, signal_aborted: false };
    set_req_method(&rreq3, STR_PTR("POST"), STR_LEN("POST"));
    set_req_body(&rreq3, STR_PTR("{\"model\":\"local-relay-b1\",\"input\":\"hello\",\"stream\":true}"), STR_LEN("{\"model\":\"local-relay-b1\",\"input\":\"hello\",\"stream\":true}"));
    let rresp4 = Response { status: 0, headers: Headers { buf: [0u8; 8192], len: 0 }, body_json: [0u8; 262144], body_len: 0, is_stream: false };
    handleForwardResponsesRequest(&rreq3, &rurl, &security, &cdeps, &rresp4);
    if rresp4.status != 200 { pfail(233); fails = fails + 1; };
    if !rresp4.is_stream { pfail(234); fails = fails + 1; };
    if !body_has(&rresp4, STR_PTR("response.created"), STR_LEN("response.created")) { pfail(235); fails = fails + 1; };
    if !body_has(&rresp4, STR_PTR("[DONE]"), STR_LEN("[DONE]")) { pfail(236); fails = fails + 1; };
    let creq3 = Request { method: [0u8; 16], method_len: 0, headers: Headers { buf: [0u8; 8192], len: 0 }, body_json: [0u8; 262144], body_len: 0, signal_aborted: false };
    set_req_method(&creq3, STR_PTR("POST"), STR_LEN("POST"));
    set_req_body(&creq3, STR_PTR("{\"model\":\"local-relay-b1\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}],\"stream\":true}"), STR_LEN("{\"model\":\"local-relay-b1\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}],\"stream\":true}"));
    let cresp3 = Response { status: 0, headers: Headers { buf: [0u8; 8192], len: 0 }, body_json: [0u8; 262144], body_len: 0, is_stream: false };
    handleForwardChatRequest(&creq3, &curl, &security, &cdeps, &cresp3);
    if cresp3.status != 200 { pfail(237); fails = fails + 1; };
    if !body_has(&cresp3, STR_PTR("chat.completion.chunk"), STR_LEN("chat.completion.chunk")) { pfail(238); fails = fails + 1; };
    if !body_has(&cresp3, STR_PTR("[DONE]"), STR_LEN("[DONE]")) { pfail(239); fails = fails + 1; };

    // ---- Z. global slot balance --------------------------------------------
    if forwardSlotStatusGlobal() != 0 { pfail(241); fails = fails + 1; };

    if fails == 0 {
        println("FA_PROBE_OK");
        return 0;
    };
    println("FA_PROBE_FAILS {}", fails);
    return 1;
}
