// bj_probe — pluginHost / ServerPluginRegistry wiring probe (BJ line).
// Verifies the registry wiring end to end at runtime: registration order,
// manifest catalog, CLI settings entries/links, discovery data, the
// default-installed set, and pluginCatalog / setPluginInstalled against a
// scratch data dir (env BJ_SCRATCH, set by run_bj_probes.sh).
// Prints BJ_PROBE_OK on success; BJ_PROBE_FAIL <code> + nonzero exit else.

@import "../../apps/server/src/pluginHost.sla"

fn bj_fail(code: i32) -> i32 {
    println("BJ_PROBE_FAIL {}", code);
    return code;
}

fn bj_eq(a_ptr: ptr, a_len: u64, b_ptr: ptr, b_len: u64) -> bool {
    if a_len != b_len { return false; };
    let i: u64 = 0;
    while i < a_len {
        let x: u8 = 0;
        PTR_BYTE_AT(x, a_ptr, i);
        let y: u8 = 0;
        PTR_BYTE_AT(y, b_ptr, i);
        if x != y { return false; };
        i = i + 1;
    }
    return true;
}

fn bj_arr_str(arr: u64, idx: u64, out_ptr: &ptr, out_len: &u64) -> bool {
    *out_len = 0;
    let n: u64 = 0;
    let st = sa_json_array_get(arr, idx, &n);
    if st != 0 || n == 0 || sa_json_kind(n) != 5 { return false; };
    let p: ptr = sa_json_string_ptr(n);
    *out_ptr = p;
    *out_len = sa_json_string_len(n);
    return true;
}

fn bj_obj_str(obj: u64, key_ptr: ptr, key_len: u64, out_ptr: &ptr, out_len: &u64) -> bool {
    *out_len = 0;
    let n: u64 = 0;
    let st = sa_json_object_get(obj, key_ptr, key_len, &n);
    if st != 0 || n == 0 || sa_json_kind(n) != 5 { return false; };
    let p: ptr = sa_json_string_ptr(n);
    *out_ptr = p;
    *out_len = sa_json_string_len(n);
    return true;
}

fn bj_obj_bool(obj: u64, key_ptr: ptr, key_len: u64, out: &bool) -> bool {
    *out = false;
    let v: u8 = 0;
    let st = sa_json_object_get_bool(obj, key_ptr, key_len, &v);
    if st != 0 { return false; };
    *out = v != 0;
    return true;
}

// Finds a catalog/manifest entry object by its "id" field.
fn bj_find_by_id(arr: u64, id_ptr: ptr, id_len: u64, out: &u64) -> bool {
    *out = 0;
    let cnt: u64 = 0;
    sa_json_value_count(arr, &cnt);
    let i: u64 = 0;
    while i < cnt {
        let e: u64 = 0;
        let st = sa_json_array_get(arr, i, &e);
        if st == 0 && e != 0 {
            let p: ptr = STR_PTR("");
            let l: u64 = 0;
            if bj_obj_str(e, STR_PTR("id"), STR_LEN("id"), &p, &l) {
                if bj_eq(p, l, id_ptr, id_len) { *out = e; return true; };
            };
            // catalog entries carry pluginId in cliSettingsEntries docs
            if bj_obj_str(e, STR_PTR("pluginId"), STR_LEN("pluginId"), &p, &l) {
                if bj_eq(p, l, id_ptr, id_len) { *out = e; return true; };
            };
        };
        i = i + 1;
    }
    return false;
}

fn main() -> i32 {
    let host = pluginHost_alloc();
    pluginHost_init(&host);

    // (1) registry ids in pluginHost.ts registration order
    let idbuf: [u8; 8192] = [0u8; 8192];
    let idlen: u64 = 0;
    serverPluginRegistry_ids(&host.registry, &idbuf, &idlen);
    let idp: ptr = PTR_NULL();
    PTR_BYTE_ADD(idp, &idbuf, 0);
    let expect_ids = "mini\ncodex\nclaude\nagy\nauggie\ncline\ncommand-code\ngrok\npi\nopencode\nopencode-v2\nmuse";
    if !bj_eq(idp, idlen, STR_PTR("mini\ncodex\nclaude\nagy\nauggie\ncline\ncommand-code\ngrok\npi\nopencode\nopencode-v2\nmuse"), STR_LEN("mini\ncodex\nclaude\nagy\nauggie\ncline\ncommand-code\ngrok\npi\nopencode\nopencode-v2\nmuse")) { return bj_fail(1); };
    println("registry_ids_ok=1 expect={}", expect_ids);

    // (2) allPluginManifests: 17, registry order then the five extras
    let manifests: u64 = 0;
    let mcnt: u64 = 0;
    allPluginManifests(&host, &manifests, &mcnt);
    if mcnt != 17 { return bj_fail(2); };
    let p: ptr = STR_PTR("");
    let l: u64 = 0;
    let m0: u64 = 0;
    sa_json_array_get(manifests, 0, &m0);
    if !bj_obj_str(m0, STR_PTR("id"), STR_LEN("id"), &p, &l) || !bj_eq(p, l, STR_PTR("mini"), STR_LEN("mini")) { return bj_fail(3); };
    let m12: u64 = 0;
    sa_json_array_get(manifests, 12, &m12);
    if !bj_obj_str(m12, STR_PTR("id"), STR_LEN("id"), &p, &l) || !bj_eq(p, l, STR_PTR("relay-config"), STR_LEN("relay-config")) { return bj_fail(4); };
    let m16: u64 = 0;
    sa_json_array_get(manifests, 16, &m16);
    if !bj_obj_str(m16, STR_PTR("id"), STR_LEN("id"), &p, &l) || !bj_eq(p, l, STR_PTR("enhance"), STR_LEN("enhance")) { return bj_fail(5); };
    println("manifests_ok=1");

    // (3) cliSettingsEntries: 11 entries, codex first with linkKey,
    // auggie without linkKey
    let entries: u64 = 0;
    let ecnt: u64 = 0;
    cliSettingsEntries(&host, &entries, &ecnt);
    if ecnt != 11 { return bj_fail(6); };
    let codex_e: u64 = 0;
    if !bj_find_by_id(entries, STR_PTR("codex"), STR_LEN("codex"), &codex_e) { return bj_fail(7); };
    if !bj_obj_str(codex_e, STR_PTR("slug"), STR_LEN("slug"), &p, &l) || !bj_eq(p, l, STR_PTR("codex-cli"), STR_LEN("codex-cli")) { return bj_fail(8); };
    if !bj_obj_str(codex_e, STR_PTR("enabledEnvVar"), STR_LEN("enabledEnvVar"), &p, &l) || !bj_eq(p, l, STR_PTR("CODEX_UI_CODEX_COMPATIBLE_CLI_ENABLED"), STR_LEN("CODEX_UI_CODEX_COMPATIBLE_CLI_ENABLED")) { return bj_fail(9); };
    if !bj_obj_str(codex_e, STR_PTR("linkKey"), STR_LEN("linkKey"), &p, &l) || !bj_eq(p, l, STR_PTR("codexCompatibleCliSettings"), STR_LEN("codexCompatibleCliSettings")) { return bj_fail(10); };
    let auggie_e: u64 = 0;
    if !bj_find_by_id(entries, STR_PTR("auggie"), STR_LEN("auggie"), &auggie_e) { return bj_fail(11); };
    let dummy: u64 = 0;
    if sa_json_object_get(auggie_e, STR_PTR("linkKey"), STR_LEN("linkKey"), &dummy) == 0 { return bj_fail(12); };
    println("settings_entries_ok=1");

    // (4) slug -> pluginId lookup
    let fp: ptr = STR_PTR("");
    let fl: u64 = 0;
    let found = false;
    cliPluginIdForSettingsSlug(&host, STR_PTR("claude-compatible-cli"), STR_LEN("claude-compatible-cli"), &fp, &fl, &found);
    if !found || !bj_eq(fp, fl, STR_PTR("claude"), STR_LEN("claude")) { return bj_fail(13); };
    cliPluginIdForSettingsSlug(&host, STR_PTR("no-such-slug"), STR_LEN("no-such-slug"), &fp, &fl, &found);
    if found { return bj_fail(14); };
    println("slug_lookup_ok=1");

    // (5) cliSettingsLinks: exactly 6 records, codex link path exact
    let links: u64 = 0;
    cliSettingsLinks(&host, &links);
    let lcnt: u64 = 0;
    sa_json_value_count(links, &lcnt);
    if lcnt != 6 { return bj_fail(15); };
    if !bj_obj_str(links, STR_PTR("codexCompatibleCliSettings"), STR_LEN("codexCompatibleCliSettings"), &p, &l) || !bj_eq(p, l, STR_PTR("/api/codex/settings/codex-cli"), STR_LEN("/api/codex/settings/codex-cli")) { return bj_fail(16); };
    println("settings_links_ok=1");

    // (6) defaultInstalledPluginIds: the six defaults in catalog order
    let defs: u64 = 0;
    let dcnt: u64 = 0;
    defaultInstalledPluginIds(&host, &defs, &dcnt);
    if dcnt != 6 { return bj_fail(17); };
    if !bj_arr_str(defs, 0, &p, &l) || !bj_eq(p, l, STR_PTR("mini"), STR_LEN("mini")) { return bj_fail(18); };
    if !bj_arr_str(defs, 1, &p, &l) || !bj_eq(p, l, STR_PTR("relay-config"), STR_LEN("relay-config")) { return bj_fail(19); };
    if !bj_arr_str(defs, 5, &p, &l) || !bj_eq(p, l, STR_PTR("enhance"), STR_LEN("enhance")) { return bj_fail(20); };
    println("defaults_ok=1");

    // (7) cliDiscoveryForKind: kind 0 = codex, kind 9 = opencode-v2,
    // unknown kind -> status 1
    let spec: u64 = 0;
    if cliDiscoveryForKind(&host, 0, &spec) != 0 { return bj_fail(21); };
    let names: u64 = 0;
    sa_json_object_get(spec, STR_PTR("binaryNames"), STR_LEN("binaryNames"), &names);
    let ncnt: u64 = 0;
    sa_json_value_count(names, &ncnt);
    if ncnt != 1 { return bj_fail(22); };
    if !bj_arr_str(names, 0, &p, &l) || !bj_eq(p, l, STR_PTR("codex"), STR_LEN("codex")) { return bj_fail(23); };
    if !bj_obj_str(spec, STR_PTR("preferredPathPrefKey"), STR_LEN("preferredPathPrefKey"), &p, &l) || !bj_eq(p, l, STR_PTR("cliPreferredCodexPath"), STR_LEN("cliPreferredCodexPath")) { return bj_fail(24); };
    if cliDiscoveryForKind(&host, 9, &spec) != 0 { return bj_fail(25); };
    sa_json_object_get(spec, STR_PTR("binaryNames"), STR_LEN("binaryNames"), &names);
    sa_json_value_count(names, &ncnt);
    if ncnt != 2 { return bj_fail(26); };
    if !bj_arr_str(names, 0, &p, &l) || !bj_eq(p, l, STR_PTR("opencode2"), STR_LEN("opencode2")) { return bj_fail(27); };
    if !bj_arr_str(names, 1, &p, &l) || !bj_eq(p, l, STR_PTR("opencode"), STR_LEN("opencode")) { return bj_fail(28); };
    if cliDiscoveryForKind(&host, 42, &spec) != 1 { return bj_fail(29); };
    println("discovery_ok=1");

    // (8) catalog against a fresh scratch data dir (defaults apply)
    let sh = sa_env_get(STR_PTR("BJ_SCRATCH"), STR_LEN("BJ_SCRATCH"));
    if sh == 0 { return bj_fail(30); };
    let sp: ptr = sa_env_buffer_data(sh);
    let sl = sa_env_buffer_len(sh);
    let envdoc = sa_json_parse(STR_PTR("{}"), STR_LEN("{}"));
    sa_json_object_set_string(envdoc, STR_PTR("CODEX_UI_DATA_DIR"), STR_LEN("CODEX_UI_DATA_DIR"), sp, sl);
    let cat: u64 = 0;
    let ccnt: u64 = 0;
    pluginCatalog(&host, envdoc, &cat, &ccnt);
    if ccnt != 17 { return bj_fail(31); };
    let mini_c: u64 = 0;
    if !bj_find_by_id(cat, STR_PTR("mini"), STR_LEN("mini"), &mini_c) { return bj_fail(32); };
    let bv = false;
    if !bj_obj_bool(mini_c, STR_PTR("installed"), STR_LEN("installed"), &bv) || !bv { return bj_fail(33); };
    if !bj_obj_bool(mini_c, STR_PTR("locked"), STR_LEN("locked"), &bv) || !bv { return bj_fail(34); };
    let codex_c: u64 = 0;
    if !bj_find_by_id(cat, STR_PTR("codex"), STR_LEN("codex"), &codex_c) { return bj_fail(35); };
    if !bj_obj_bool(codex_c, STR_PTR("installed"), STR_LEN("installed"), &bv) || bv { return bj_fail(36); };
    println("catalog_defaults_ok=1");

    // (9) install codex -> catalog reflects it; persists across a fresh
    // host (real store file round-trip)
    let out_e: u64 = 0;
    let out_c: u64 = 0;
    if setPluginInstalled(&host, STR_PTR("codex"), STR_LEN("codex"), true, envdoc, &out_e, &out_c) != 0 { return bj_fail(37); };
    let codex_c2: u64 = 0;
    if !bj_find_by_id(out_e, STR_PTR("codex"), STR_LEN("codex"), &codex_c2) { return bj_fail(38); };
    if !bj_obj_bool(codex_c2, STR_PTR("installed"), STR_LEN("installed"), &bv) || !bv { return bj_fail(39); };
    let host2 = pluginHost_alloc();
    pluginHost_init(&host2);
    let cat2: u64 = 0;
    let ccnt2: u64 = 0;
    pluginCatalog(&host2, envdoc, &cat2, &ccnt2);
    let codex_c3: u64 = 0;
    if !bj_find_by_id(cat2, STR_PTR("codex"), STR_LEN("codex"), &codex_c3) { return bj_fail(40); };
    if !bj_obj_bool(codex_c3, STR_PTR("installed"), STR_LEN("installed"), &bv) || !bv { return bj_fail(41); };
    println("install_persist_ok=1");

    // (10) error paths: locked uninstall -> 2, unknown id -> 1
    if setPluginInstalled(&host, STR_PTR("mini"), STR_LEN("mini"), false, envdoc, &out_e, &out_c) != 2 { return bj_fail(42); };
    if setPluginInstalled(&host, STR_PTR("nope"), STR_LEN("nope"), true, envdoc, &out_e, &out_c) != 1 { return bj_fail(43); };
    println("install_errors_ok=1");

    // (11) the store file bytes are exactly JSON.stringify(..., 2) + "\n"
    // of the sorted installed set (defaults + codex)
    let pathbuf = PhBuf { bytes: [0u8; 8192], len: 0 };
    ph_buf_push(&pathbuf, sp, sl);
    ph_buf_push(&pathbuf, STR_PTR("/plugins-installed.json"), STR_LEN("/plugins-installed.json"));
    let pp: ptr = PTR_NULL();
    PTR_BYTE_ADD(pp, &pathbuf.bytes, 0);
    let fh: u64 = 0;
    if sa_std_fs_read_to_string(pp, pathbuf.len, 1048576, &fh) != 0 || fh == 0 { return bj_fail(44); };
    let fp2: ptr = sa_fs_read_buffer_data(fh);
    let fl2 = sa_fs_read_buffer_len(fh);
    let expect_file = "{\n  \"installed\": [\n    \"codex\",\n    \"enhance\",\n    \"free-mode\",\n    \"jev\",\n    \"mini\",\n    \"relay-config\",\n    \"vmtool-security\"\n  ]\n}\n";
    if !bj_eq(fp2, fl2, STR_PTR("{\n  \"installed\": [\n    \"codex\",\n    \"enhance\",\n    \"free-mode\",\n    \"jev\",\n    \"mini\",\n    \"relay-config\",\n    \"vmtool-security\"\n  ]\n}\n"), STR_LEN("{\n  \"installed\": [\n    \"codex\",\n    \"enhance\",\n    \"free-mode\",\n    \"jev\",\n    \"mini\",\n    \"relay-config\",\n    \"vmtool-security\"\n  ]\n}\n")) { return bj_fail(45); };
    println("store_file_ok=1 expect={}", expect_file);

    println("BJ_PROBE_OK");
    return 0;
}
