// Probe: isolate rpg_free_doc behavior under sa test (wave-2b, gate for effectiveGroupBaseUrl).
// rpg_free_doc (relayProtocolGateway.sla:300) is the same one-line conditional-release shape
// as mb_free_doc: fn rpg_free_doc(doc: u64) -> void { if doc != 0 { sa_json_free(doc); } }
// AF registered a PhiStateConflict trap in rpg_free_doc for anthropicBudgetEffort.test.sla.
@import "sa_std/encoding/json.sai"
@import "sa_std/string.sa"
@import "sa_std/ptr.sa"
@import "sa_std/io/print.sai"
@import "../../backends/relay-config/src/relay/relayProtocolGateway.sla"

@test "probe rpg_free_doc once"() {
    let jb = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
    rpg_jb_assign(&jb, STR_PTR("{\"id\":\"go\",\"baseUrl\":null}"), STR_LEN("{\"id\":\"go\",\"baseUrl\":null}"));
    let doc: u64 = rpg_jb_doc(&jb);
    if doc == 0 { panic(11); };
    rpg_free_doc(doc);
    println("PROBE rpg_free_doc once -> ok");
}

@test "probe withEffectiveGroupBaseUrl once"() {
    let group = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
    rpg_jb_assign(&group, STR_PTR("{\"id\":\"go\",\"baseUrl\":null}"), STR_LEN("{\"id\":\"go\",\"baseUrl\":null}"));
    let filled = rpg_JsonBuf { bytes: [0u8; 262144], len: 0 };
    withEffectiveGroupBaseUrl(&group, STR_PTR("https://opencode.ai/zen/go/v1"), STR_LEN("https://opencode.ai/zen/go/v1"), true, &filled);
    if filled.len == 0 { panic(21); };
    println("PROBE withEffectiveGroupBaseUrl once -> ok");
}
